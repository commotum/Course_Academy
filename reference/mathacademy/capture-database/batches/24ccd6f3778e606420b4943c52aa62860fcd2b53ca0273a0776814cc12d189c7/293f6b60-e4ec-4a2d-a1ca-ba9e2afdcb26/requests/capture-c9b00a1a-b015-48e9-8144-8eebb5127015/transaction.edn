wer-fields ["answer-field-3b9fc6f8-b371-50fb-914d-71a4829c2da7"] :db/ensure [:question/validate]} {:db/id "answer-field-3b9fc6f8-b371-50fb-914d-71a4829c2da7" :answer-field/id #uuid "3b9fc6f8-b371-50fb-914d-71a4829c2da7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer-field/choices ["answer-a2cd87da-b89d-562c-81bd-4756e6c1e055" "answer-b9de8e18-f770-596b-8f87-37d29419a8d9" "answer-6117f495-7121-52e2-8094-cb58ab6a31c4" "answer-7872b3f6-c2d7-5cae-9ed4-21e7de27441c" "answer-3845d877-6bd4-5d91-90a1-af898b1484f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2cd87da-b89d-562c-81bd-4756e6c1e055" :answer/id #uuid "a2cd87da-b89d-562c-81bd-4756e6c1e055" :answer/type :answer.type/math :answer/value "\\frac{1}{{z}^{12}}" :db/ensure [:answer/validate]} {:db/id "answer-b9de8e18-f770-596b-8f87-37d29419a8d9" :answer/id #uuid "b9de8e18-f770-596b-8f87-37d29419a8d9" :answer/type :answer.type/math :answer/value "\\frac{1}{{z}^{7}}" :db/ensure [:answer/validate]} {:db/id "answer-6117f495-7121-52e2-8094-cb58ab6a31c4" :answer/id #uuid "6117f495-7121-52e2-8094-cb58ab6a31c4" :answer/type :answer.type/math :answer/value "{z}^{12}" :db/ensure [:answer/validate]} {:db/id "answer-7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/id #uuid "7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/type :answer.type/math :answer/value "{z}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-3845d877-6bd4-5d91-90a1-af898b1484f2" :answer/id #uuid "3845d877-6bd4-5d91-90a1-af898b1484f2" :answer/type :answer.type/math :answer/value "{z}^{8}" :db/ensure [:answer/validate]} {:db/id 17592186133964 :knowledge-point/questions ["question-3d20e092-7a52-54cf-904a-8aa79d562ce0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3d20e092-7a52-54cf-904a-8aa79d562ce0" :question/id #uuid "3d20e092-7a52-54cf-904a-8aa79d562ce0" :question/math-academy-id "q-175877" :question/problem "If $r=1,$ then $\\frac{7r}{15}+\\frac{6}{5r}=${{field-1}}." :question/worked-solution "We replace $r$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{7r}{15}+\\frac{6}{5r} & = \\\\ \\frac{7\\cdot 1}{15}+\\frac{6}{5\\cdot 1} & = \\\\ \\frac{7}{15}+\\frac{6}{5} & = \\\\ \\frac{7}{15}+\\frac{18}{15} & = \\\\ \\frac{7+18}{15} & = \\\\ \\frac{25}{15} & = \\\\ \\frac{5}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97a23528-f8a8-5a73-9c66-2133c045b42e"] :db/ensure [:question/validate]} {:db/id "answer-field-97a23528-f8a8-5a73-9c66-2133c045b42e" :answer-field/id #uuid "97a23528-f8a8-5a73-9c66-2133c045b42e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer-field/choices ["answer-768779f2-cfcd-52c5-945b-acc0d08b63b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/id #uuid "768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186179819 :knowledge-point/questions ["question-aa408be7-da1f-5fc4-a78a-e723f9d79c8a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aa408be7-da1f-5fc4-a78a-e723f9d79c8a" :question/id #uuid "aa408be7-da1f-5fc4-a78a-e723f9d79c8a" :question/math-academy-id "q-147015" :question/problem "On a field trip to a theme park, $150$ students out of $500$ rode a roller coaster. What percentage of students rode a roller coaster?" :question/worked-solution "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the number of students who rode a roller coaster, which is $150,$ and\n\n- the whole is the total number of students, which is $500.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=150÷500=\\frac{150}{500}.\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{150}{500}=\\frac{150÷5}{500÷5}=\\frac{30}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{30}{100}=30%\n$$\n\nTherefore, $30%$ of the students rode a roller coaster." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41e9ad24-438d-57bd-ba9c-a67eeb3fb7b3"] :db/ensure [:question/validate]} {:db/id "answer-field-41e9ad24-438d-57bd-ba9c-a67eeb3fb7b3" :answer-field/id #uuid "41e9ad24-438d-57bd-ba9c-a67eeb3fb7b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8bba908b-7b88-591d-9f27-10a6d6474d41" :answer-field/choices ["answer-a4fdf384-ba3c-5858-811d-9e8ebbd7a9d0" "answer-636f630e-1585-5d67-9b3a-b428c2059647" "answer-8bba908b-7b88-591d-9f27-10a6d6474d41" "answer-b9bd8e18-0ed8-549b-baca-f19c0ee012e3" "answer-d4c09eab-8139-5090-a8f7-d565e4fcf770"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4fdf384-ba3c-5858-811d-9e8ebbd7a9d0" :answer/id #uuid "a4fdf384-ba3c-5858-811d-9e8ebbd7a9d0" :answer/type :answer.type/math :answer/value "15%" :db/ensure [:answer/validate]} {:db/id "answer-636f630e-1585-5d67-9b3a-b428c2059647" :answer/id #uuid "636f630e-1585-5d67-9b3a-b428c2059647" :answer/type :answer.type/math :answer/value "3%" :db/ensure [:answer/validate]} {:db/id "answer-8bba908b-7b88-591d-9f27-10a6d6474d41" :answer/id #uuid "8bba908b-7b88-591d-9f27-10a6d6474d41" :answer/type :answer.type/math :answer/value "30%" :db/ensure [:answer/validate]} {:db/id "answer-b9bd8e18-0ed8-549b-baca-f19c0ee012e3" :answer/id #uuid "b9bd8e18-0ed8-549b-baca-f19c0ee012e3" :answer/type :answer.type/math :answer/value "5%" :db/ensure [:answer/validate]} {:db/id "answer-d4c09eab-8139-5090-a8f7-d565e4fcf770" :answer/id #uuid "d4c09eab-8139-5090-a8f7-d565e4fcf770" :answer/type :answer.type/math :answer/value "50%" :db/ensure [:answer/validate]} {:db/id 17592186055465 :question/problem "Evaluate $(-\\frac{1}{3})÷((-4)^{3}÷8).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-4)^{3}÷8\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-4)^{3}÷8 & = \\\\ (-64)÷8 & = \\\\ \\frac{(-64)}{8} & = \\\\ -8\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-\\frac{1}{3})÷((-4)^{3}÷8) & = \\\\ (-\\frac{1}{3})÷(-8) & = \\\\ (-\\frac{1}{3})\\times (-\\frac{1}{8}) & = \\\\ \\frac{1\\times 1}{3\\times 8} & = \\\\ \\frac{1}{24}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186054027 :answer-field/correct 17592186054031 :db/ensure [:answer-field/validate]} {:db/id 17592186188374 :knowledge-point/questions ["question-2eb696c5-dbcf-5ba0-8d82-82e64e6ac266"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2eb696c5-dbcf-5ba0-8d82-82e64e6ac266" :question/id #uuid "2eb696c5-dbcf-5ba0-8d82-82e64e6ac266" :question/math-academy-id "q-144246" :question/problem "Simplify the expression $-6q-(q-9).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-6q-q+9\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-6q-q+9 & = \\\\ (-6q-q)+9 & = \\\\ -7q+9 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ac226765-7bac-59c7-b218-c5a2ec7022c8"] :db/ensure [:question/validate]} {:db/id "answer-field-ac226765-7bac-59c7-b218-c5a2ec7022c8" :answer-field/id #uuid "ac226765-7bac-59c7-b218-c5a2ec7022c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer-field/choices ["answer-fc2542d6-6523-51ba-a6d9-3c06637ea467" "answer-e6f8dd87-eed3-5563-a9b9-ebac8afe85be" "answer-06a93b05-ba04-5b12-b9af-ad0b8b110e94" "answer-b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" "answer-adf2da43-a52a-5c4e-a6cc-d107314f80ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc2542d6-6523-51ba-a6d9-3c06637ea467" :answer/id #uuid "fc2542d6-6523-51ba-a6d9-3c06637ea467" :answer/type :answer.type/math :answer/value "-5q+9" :db/ensure [:answer/validate]} {:db/id "answer-e6f8dd87-eed3-5563-a9b9-ebac8afe85be" :answer/id #uuid "e6f8dd87-eed3-5563-a9b9-ebac8afe85be" :answer/type :answer.type/math :answer/value "-5q-9" :db/ensure [:answer/validate]} {:db/id "answer-06a93b05-ba04-5b12-b9af-ad0b8b110e94" :answer/id #uuid "06a93b05-ba04-5b12-b9af-ad0b8b110e94" :answer/type :answer.type/math :answer/value "-6q-9" :db/ensure [:answer/validate]} {:db/id "answer-b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/id #uuid "b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/type :answer.type/math :answer/value "-7q+9" :db/ensure [:answer/validate]} {:db/id "answer-adf2da43-a52a-5c4e-a6cc-d107314f80ec" :answer/id #uuid "adf2da43-a52a-5c4e-a6cc-d107314f80ec" :answer/type :answer.type/math :answer/value "-7q-9" :db/ensure [:answer/validate]} {:db/id 17592186073895 :knowledge-point/questions ["question-321e819d-21c6-5c8d-a9d3-36abfa3818e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-321e819d-21c6-5c8d-a9d3-36abfa3818e4" :question/id #uuid "321e819d-21c6-5c8d-a9d3-36abfa3818e4" :question/math-academy-id "q-186859" :question/problem "Complete the ratio table below.\n\n| $7$ | $2$ |\n| --- | --- |\n| {{field-1}} | $6$ |\n| {{field-2}} | $20$ |" :question/worked-solution "We start with the ratio $7:2$ and write it as a fraction:\n\n$$\n\\frac{7}{2}\n$$\n\nSo the numerator represents the left-hand entry ($7$), and the denominator represents the right-hand entry ($2$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $6,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{7\\times 3}{2\\times 3}=\\frac{21}{6}\n$$\n\n- To create a denominator of $20,$ we multiply the numerator and denominator of our fraction by $10:$\n\n$$\n\\frac{7\\times 10}{2\\times 10}=\\frac{70}{20}\n$$\n\nFinally, we fill in the ratio table:\n\n| $7$ | $2$ |\n| --- | --- |\n| $21$ | $6$ |\n| $70$ | $20$ |\n\n$$\n\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9dd4ab96-7951-5e84-ab6e-c18317468cbb" "answer-field-66177e54-eef7-56db-8506-df97e08453b7"] :db/ensure [:question/validate]} {:db/id "answer-field-9dd4ab96-7951-5e84-ab6e-c18317468cbb" :answer-field/id #uuid "9dd4ab96-7951-5e84-ab6e-c18317468cbb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-96ef42ad-1530-5d58-820a-ff5c2f14ae67" :answer-field/choices ["answer-96ef42ad-1530-5d58-820a-ff5c2f14ae67"] :db/ensure [:answer-field/validate]} {:db/id "answer-96ef42ad-1530-5d58-820a-ff5c2f14ae67" :answer/id #uuid "96ef42ad-1530-5d58-820a-ff5c2f14ae67" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-field-66177e54-eef7-56db-8506-df97e08453b7" :answer-field/id #uuid "66177e54-eef7-56db-8506-df97e08453b7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-463db585-bf6f-5e0d-931b-df42f52effc1" :answer-field/choices ["answer-463db585-bf6f-5e0d-931b-df42f52effc1"] :db/ensure [:answer-field/validate]} {:db/id "answer-463db585-bf6f-5e0d-931b-df42f52effc1" :answer/id #uuid "463db585-bf6f-5e0d-931b-df42f52effc1" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id 17592186138389 :knowledge-point/questions ["question-559e7325-1f2d-5d6d-99bc-9f9ffa4b9d3b" "question-cc1f868e-acd2-53b5-a61f-6b065116ee9a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-559e7325-1f2d-5d6d-99bc-9f9ffa4b9d3b" :question/id #uuid "559e7325-1f2d-5d6d-99bc-9f9ffa4b9d3b" :question/math-academy-id "q-218724" :question/problem "The dimensions of a package in the shape of a rectangular solid are $0.9\\,\\text{m}\\times 0.9\\,\\text{m}\\times 1.2\\,\\text{m},$ where each dimension was measured to the nearest $0.1\\,\\text{m}.$ Rounded to the nearest tenth of a cubic meter, what is the upper bound for the volume of the package?\n\nTo the nearest tenth of a cubic meter, the upper bound for the volume of the package is\n{{field-1}}${\\text{m}}^{3}.$" :question/worked-solution "Each dimension is given to the nearest $0.1\\,\\text{m}.$ So, the greatest possible error of these measurements is\n\n$$\n\\frac{0.1\\,\\text{m}}{2}=0.05\\,\\text{m}.\n$$\n\nWe wish to find the *upper bound* for the volume of the package. Therefore, we require the *upper bound* of each dimension.\n\nThe upper bounds for each dimension are as follows:\n\n$$\n\\begin{aligned} & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 1.2\\,\\text{m}+0.05\\,\\text{m}=1.25\\,\\text{m}\\end{aligned}\n$$\n\nSo, the upper bound for the volume of the package is\n\n$$\n\\begin{aligned}V & =0.95\\,\\text{m}\\times 0.95\\,\\text{m}\\times 1.25\\,\\text{m} \\\\  & =1.128\\,125\\,{\\text{m}}^{3} \\\\  & ≈1.1\\,{\\text{m}}^{3},\\end{aligned}\n$$\n\nrounded to the nearest tenth of a cubic meter." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2db24a1f-2dcc-5861-b3c8-b74405c19baa"] :db/ensure [:question/validate]} {:db/id "answer-field-2db24a1f-2dcc-5861-b3c8-b74405c19baa" :answer-field/id #uuid "2db24a1f-2dcc-5861-b3c8-b74405c19baa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3e8198dd-99e8-5974-9e10-f4ef8ff6411d" :answer-field/choices ["answer-3e8198dd-99e8-5974-9e10-f4ef8ff6411d"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e8198dd-99e8-5974-9e10-f4ef8ff6411d" :answer/id #uuid "3e8198dd-99e8-5974-9e10-f4ef8ff6411d" :answer/type :answer.type/math :answer/value "1.1" :db/ensure [:answer/validate]} {:db/id 17592186096678 :knowledge-point/questions ["question-65afe218-5b40-51ad-8f32-78468d52b1c6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-65afe218-5b40-51ad-8f32-78468d52b1c6" :question/id #uuid "65afe218-5b40-51ad-8f32-78468d52b1c6" :question/math-academy-id "q-68483" :question/problem "Sophia and Charlie decide to go to the sea to study some marine species. While Charlie dives $14.2$ meters below sea level, Sophia waits for him in the boat, $2.5$ meters above sea level. How many meters above Charlie is Sophia?" :question/worked-solution "To determine the distance between Charlie and Sophia, we must calculate the difference between Sophia's location and Charlie's location. This gives\n\n$$\n2.5-(-14.2)=2.5+14.2=16.7\\,\\text{m}.\n$$\n\nThus, Sophia is located $16.7\\,\\text{m}$ above Charlie." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-17ceb33e-7e12-5ea8-88a3-31715bc9a70f"] :db/ensure [:question/validate]} {:db/id "answer-field-17ceb33e-7e12-5ea8-88a3-31715bc9a70f" :answer-field/id #uuid "17ceb33e-7e12-5ea8-88a3-31715bc9a70f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-005a8c2d-2986-5382-a9a7-8d0925088970" :answer-field/choices ["answer-4ed3f262-549e-5f94-906f-e38321fcff36" "answer-ed677ee1-ade4-5373-be60-21612e095897" "answer-59591069-9f03-5eff-82cf-fc8067fe4232" "answer-005a8c2d-2986-5382-a9a7-8d0925088970" "answer-4938059d-e5e9-5e0a-bafb-c6bde99e4272"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ed3f262-549e-5f94-906f-e38321fcff36" :answer/id #uuid "4ed3f262-549e-5f94-906f-e38321fcff36" :answer/type :answer.type/math :answer/value "11.7\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-ed677ee1-ade4-5373-be60-21612e095897" :answer/id #uuid "ed677ee1-ade4-5373-be60-21612e095897" :answer/type :answer.type/math :answer/value "13.3\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-59591069-9f03-5eff-82cf-fc8067fe4232" :answer/id #uuid "59591069-9f03-5eff-82cf-fc8067fe4232" :answer/type :answer.type/math :answer/value "14.5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-005a8c2d-2986-5382-a9a7-8d0925088970" :answer/id #uuid "005a8c2d-2986-5382-a9a7-8d0925088970" :answer/type :answer.type/math :answer/value "16.7\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-4938059d-e5e9-5e0a-bafb-c6bde99e4272" :answer/id #uuid "4938059d-e5e9-5e0a-bafb-c6bde99e4272" :answer/type :answer.type/math :answer/value "17.3\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186068805 :knowledge-point/questions ["question-1a5f882d-4cbf-515d-b127-b49f03d6e601"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1a5f882d-4cbf-515d-b127-b49f03d6e601" :question/id #uuid "1a5f882d-4cbf-515d-b127-b49f03d6e601" :question/math-academy-id "q-100082" :question/problem "$\\frac{ab+3b}{5a+15}=$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{ab+3b}{5a+15} & =\\frac{b(a+3)}{5(a+3)} \\\\  & =\\frac{b\\cancel{(a+3)}}{5\\cancel{(a+3)}} \\\\  & =\\frac{b}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d3e29b2d-1ff0-5f42-aa69-6c73bafc3de3"] :db/ensure [:question/validate]} {:db/id "answer-field-d3e29b2d-1ff0-5f42-aa69-6c73bafc3de3" :answer-field/id #uuid "d3e29b2d-1ff0-5f42-aa69-6c73bafc3de3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f68b0f15-04cc-531c-b14c-bf199686b9c7" :answer-field/choices ["answer-619ad907-0a2a-5821-9c37-e4029921ecaa" "answer-2ce13ca6-d5e6-5b02-ab83-62b67c2cdc93" "answer-c9e73284-4757-5b87-9887-ae2ae7a64acb" "answer-f68b0f15-04cc-531c-b14c-bf199686b9c7" "answer-8dd81113-32ec-576c-9e41-04155f79e7cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-619ad907-0a2a-5821-9c37-e4029921ecaa" :answer/id #uuid "619ad907-0a2a-5821-9c37-e4029921ecaa" :answer/type :answer.type/math :answer/value "5b" :db/ensure [:answer/validate]} {:db/id "answer-2ce13ca6-d5e6-5b02-ab83-62b67c2cdc93" :answer/id #uuid "2ce13ca6-d5e6-5b02-ab83-62b67c2cdc93" :answer/type :answer.type/math :answer/value "\\frac{b+1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c9e73284-4757-5b87-9887-ae2ae7a64acb" :answer/id #uuid "c9e73284-4757-5b87-9887-ae2ae7a64acb" :answer/type :answer.type/math :answer/value "\\frac{b}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f68b0f15-04cc-531c-b14c-bf199686b9c7" :answer/id #uuid "f68b0f15-04cc-531c-b14c-bf199686b9c7" :answer/type :answer.type/math :answer/value "\\frac{b}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8dd81113-32ec-576c-9e41-04155f79e7cc" :answer/id #uuid "8dd81113-32ec-576c-9e41-04155f79e7cc" :answer/type :answer.type/math :answer/value "b" :db/ensure [:answer/validate]} {:db/id 17592186110777 :knowledge-point/questions ["question-ee602985-c91d-54be-9eef-bda0850e7e34"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ee602985-c91d-54be-9eef-bda0850e7e34" :question/id #uuid "ee602985-c91d-54be-9eef-bda0850e7e34" :question/math-academy-id "q-74588" :question/problem "![](images/cb/cb0fa52f4f74145ee88e73f3f4c62d96d6b8261533844b4c8021d30cae8e41d0.png)\n\nWhich of the figures above is a rectangle?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rectangle is a quadrilateral where all angles are right and has two pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is an isosceles trapezoid. It has only one pair of parallel sides, not two, therefore, it is not a rectangle.\n\n- The shape $Q$ is a parallelogram. It has no right angles, therefore, it is not a rectangle.\n\n- The shape $R$ is a rhombus. Since it has no right angles, it is not a rectangle.\n\n- The shape $S$ is a rectangle since all its angles are right.\n\nTherefore, shape $S$ is a rectangle. The shapes $P,$ $Q,$ and $R$ are not rectangles." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c19895f8-96a3-5287-94da-9de297a507c5"] :db/ensure [:question/validate]} {:db/id "answer-field-c19895f8-96a3-5287-94da-9de297a507c5" :answer-field/id #uuid "c19895f8-96a3-5287-94da-9de297a507c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8806f6ae-2cc6-53d6-ac93-06345cc19aaa" :answer-field/choices ["answer-7def0cb6-38af-5e1c-b013-868d0d71acb7" "answer-3c8a3747-978e-5a04-88f7-efa162deb1c0" "answer-2787cafa-a6f3-58c4-b71c-39cfde6628a1" "answer-a5c84333-4a31-51e6-83f2-46286a208fb8" "answer-8806f6ae-2cc6-53d6-ac93-06345cc19aaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-7def0cb6-38af-5e1c-b013-868d0d71acb7" :answer/id #uuid "7def0cb6-38af-5e1c-b013-868d0d71acb7" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-3c8a3747-978e-5a04-88f7-efa162deb1c0" :answer/id #uuid "3c8a3747-978e-5a04-88f7-efa162deb1c0" :answer/type :answer.type/text :answer/value "$P$ and $S$ only" :db/ensure [:answer/validate]} {:db/id "answer-2787cafa-a6f3-58c4-b71c-39cfde6628a1" :answer/id #uuid "2787cafa-a6f3-58c4-b71c-39cfde6628a1" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-a5c84333-4a31-51e6-83f2-46286a208fb8" :answer/id #uuid "a5c84333-4a31-51e6-83f2-46286a208fb8" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-8806f6ae-2cc6-53d6-ac93-06345cc19aaa" :answer/id #uuid "8806f6ae-2cc6-53d6-ac93-06345cc19aaa" :answer/type :answer.type/text :answer/value "$S$ only" :db/ensure [:answer/validate]} {:db/id 17592186138395 :knowledge-point/questions ["question-d1265e4c-79e5-5207-9e53-54ea1660d1ab"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d1265e4c-79e5-5207-9e53-54ea1660d1ab" :question/id #uuid "d1265e4c-79e5-5207-9e53-54ea1660d1ab" :question/math-academy-id "q-152350" :question/problem "Evaluate $\\frac{\\sqrt{20}}{\\sqrt{5}}.$" :question/worked-solution "A quotient of square roots of two positive numbers is equal to the square root of the quotient of the numbers. Therefore,\n\n$$\n\\frac{\\sqrt{20}}{\\sqrt{5}}=\\sqrt{\\frac{20}{5}}=\\sqrt{4}=2\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ba64d127-ec18-5cc5-bddf-f9699c0c0733"] :db/ensure [:question/validate]} {:db/id "answer-field-ba64d127-ec18-5cc5-bddf-f9699c0c0733" :answer-field/id #uuid "ba64d127-ec18-5cc5-bddf-f9699c0c0733" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-214f06c9-269c-5297-8072-2fc4c14d1161" :answer-field/choices ["answer-214f06c9-269c-5297-8072-2fc4c14d1161" "answer-92f7dcf3-bce8-5e12-9d2d-664d1ee3e079" "answer-dc5cd460-758d-5cb8-9c18-0dd8dd19996a" "answer-c5935f44-9284-5e50-ad97-9e76e3d58d51" "answer-bb25796f-9522-5605-a975-c954e0e74db7"] :db/ensure [:answer-field/validate]} {:db/id "answer-214f06c9-269c-5297-8072-2fc4c14d1161" :answer/id #uuid "214f06c9-269c-5297-8072-2fc4c14d1161" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-92f7dcf3-bce8-5e12-9d2d-664d1ee3e079" :answer/id #uuid "92f7dcf3-bce8-5e12-9d2d-664d1ee3e079" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-dc5cd460-758d-5cb8-9c18-0dd8dd19996a" :answer/id #uuid "dc5cd460-758d-5cb8-9c18-0dd8dd19996a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-c5935f44-9284-5e50-ad97-9e76e3d58d51" :answer/id #uuid "c5935f44-9284-5e50-ad97-9e76e3d58d51" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bb25796f-9522-5605-a975-c954e0e74db7" :answer/id #uuid "bb25796f-9522-5605-a975-c954e0e74db7" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id 17592186129111 :knowledge-point/questions ["question-c32986e7-9010-5588-b701-72ad7388c062"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c32986e7-9010-5588-b701-72ad7388c062" :question/id #uuid "c32986e7-9010-5588-b701-72ad7388c062" :question/math-academy-id "q-68615" :question/problem "${(\\frac{4}{7}\\times \\frac{1}{5})}^{5}=$" :question/worked-solution "To raise the product of two numbers to the power of $5$, we can raise each number to the power of $5,$ and then multiply:\n\n$$\n{(\\frac{4}{7}\\times \\frac{1}{5})}^{4}={(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-544faafb-45af-51f7-9886-1c44cb2fbaea"] :db/ensure [:question/validate]} {:db/id "answer-field-544faafb-45af-51f7-9886-1c44cb2fbaea" :answer-field/id #uuid "544faafb-45af-51f7-9886-1c44cb2fbaea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0058a23-5040-59e0-a92d-9b29b1549ea3" :answer-field/choices ["answer-46ee4abf-f8a1-5118-9471-a54db96f45a7" "answer-d6feceb1-2fa4-5151-ba55-921a2c546541" "answer-69e93b7b-b1d1-5cb1-973f-7ccaf1e39a29" "answer-cb92c9ab-11a4-5e5d-bb15-e3eb6dedabbf" "answer-d0058a23-5040-59e0-a92d-9b29b1549ea3"] :db/ensure [:answer-field/validate]} {:db/id "answer-46ee4abf-f8a1-5118-9471-a54db96f45a7" :answer/id #uuid "46ee4abf-f8a1-5118-9471-a54db96f45a7" :answer/type :answer.type/math :answer/value "\\frac{4}{7}\\times {(\\frac{1}{5})}^{5}" :db/ensure [:answer/validate]} {:db/id "answer-d6feceb1-2fa4-5151-ba55-921a2c546541" :answer/id #uuid "d6feceb1-2fa4-5151-ba55-921a2c546541" :answer/type :answer.type/math :answer/value "\\frac{4}{{7}^{5}\\times {5}^{5}}" :db/ensure [:answer/validate]} {:db/id "answer-69e93b7b-b1d1-5cb1-973f-7ccaf1e39a29" :answer/id #uuid "69e93b7b-b1d1-5cb1-973f-7ccaf1e39a29" :answer/type :answer.type/math :answer/value "\\frac{{4}^{5}}{7\\times 5}" :db/ensure [:answer/validate]} {:db/id "answer-cb92c9ab-11a4-5e5d-bb15-e3eb6dedabbf" :answer/id #uuid "cb92c9ab-11a4-5e5d-bb15-e3eb6dedabbf" :answer/type :answer.type/math :answer/value "{(\\frac{4}{7})}^{5}\\times \\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d0058a23-5040-59e0-a92d-9b29b1549ea3" :answer/id #uuid "d0058a23-5040-59e0-a92d-9b29b1549ea3" :answer/type :answer.type/math :answer/value "{(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}" :db/ensure [:answer/validate]} {:db/id 17592186073898 :knowledge-point/questions ["question-a94dc93f-684c-5299-b244-16888ab7a25a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a94dc93f-684c-5299-b244-16888ab7a25a" :question/id #uuid "a94dc93f-684c-5299-b244-16888ab7a25a" :question/math-academy-id "q-160305" :question/problem "What is the distance between the points $(1,-3)$  and $(5,-3)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/b3/b3a34b10cf329cea0e80959562484c07316a582d55395f8bf7aa951d2aca8567.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/15/15afca52169a74eb433654bc992cc3d19e191a92704d7d845d0c49071800052e.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/72/7298280773fb08b221742571e76ba5f422a77a2e70abd4b94085d602a196e8a7.png)\n\nThe point $(1,-3)$ is at a distance of $1$ from the $y$-axis, and the point $(5,-3)$ is at a distance of $5$ from the $y$-axis. Therefore, the distance between the two points is $5-1=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ff2eb55-30cd-5edc-8e06-8e29569ebd8e"] :db/ensure [:question/validate]} {:db/id "answer-field-9ff2eb55-30cd-5edc-8e06-8e29569ebd8e" :answer-field/id #uuid "9ff2eb55-30cd-5edc-8e06-8e29569ebd8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c893fd0-6f85-52b1-b076-b8fc122a706c" :answer-field/choices ["answer-bbccc7c4-2626-5ed7-bf9f-6d5b1ca3e586" "answer-79fbcb7d-ca45-560f-bbc1-ad45a7ac1165" "answer-0c893fd0-6f85-52b1-b076-b8fc122a706c" "answer-061081df-b561-5c2b-a708-36f7986d4b73" "answer-d9b8ad62-7088-5547-8eb6-36cbe9e7385c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bbccc7c4-2626-5ed7-bf9f-6d5b1ca3e586" :answer/id #uuid "bbccc7c4-2626-5ed7-bf9f-6d5b1ca3e586" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-79fbcb7d-ca45-560f-bbc1-ad45a7ac1165" :answer/id #uuid "79fbcb7d-ca45-560f-bbc1-ad45a7ac1165" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-0c893fd0-6f85-52b1-b076-b8fc122a706c" :answer/id #uuid "0c893fd0-6f85-52b1-b076-b8fc122a706c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-061081df-b561-5c2b-a708-36f7986d4b73" :answer/id #uuid "061081df-b561-5c2b-a708-36f7986d4b73" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-d9b8ad62-7088-5547-8eb6-36cbe9e7385c" :answer/id #uuid "d9b8ad62-7088-5547-8eb6-36cbe9e7385c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-5a47de09-d478-5894-9e9c-adff92bd99f7" :activity/id #uuid "5a47de09-d478-5894-9e9c-adff92bd99f7" :activity/title "Quiz 10" :activity/type :activity.type/assessment :activity/course 17592186046647 :activity/steps ["step-7fe744c9-914a-50bd-89e6-1c6245817ed5" "step-e8dffbae-aa18-538f-acb6-bd3d65a6168f" "step-09947836-eee9-565c-a198-41a647f0a018" "step-586baaca-a4dc-5d4a-8f3a-1c5b34f5bf50" "step-1e73ebc7-0fa1-587f-be9f-119e22444470