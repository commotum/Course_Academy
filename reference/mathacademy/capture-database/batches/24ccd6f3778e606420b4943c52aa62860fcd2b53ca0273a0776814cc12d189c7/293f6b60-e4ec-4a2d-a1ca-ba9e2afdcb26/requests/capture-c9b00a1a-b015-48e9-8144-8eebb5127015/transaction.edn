1192-5c41-bdd3-5c80d61ad30d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186060314 :question/problem "Owen enrolled in an online course that has $12$ topics. He completed $\\frac{1}{6}$ of the remaining topics every week. Which expression gives approximately  the number of topics that were incomplete after $3$ weeks?" :question/worked-solution "If the number of incomplete topics decreased by $\\frac{1}{6}$ every week, then every week $\\frac{5}{6}$ of the topics remained incomplete.\n\nTherefore:\n\n- After $1$ week, $12\\cdot (\\frac{5}{6})$ topics were incomplete.\n\n- After $2$ weeks, approximately  $12\\cdot {(\\frac{5}{6})}^{2}$ topics were incomplete.\n\n- After $3$ weeks, approximately $12\\cdot {(\\frac{5}{6})}^{3}$ topics were incomplete." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186058506 :answer-field/correct "answer-295b4554-e6e4-5572-8988-a41fbe42755b" :answer-field/choices ["answer-b9d2273f-c214-550e-bdff-c833b0e8605d" "answer-295b4554-e6e4-5572-8988-a41fbe42755b" "answer-f34187bf-602c-5b72-80aa-ab6dacc13343" "answer-dc51588c-9b81-533c-b74d-397e014ebe49" "answer-88b25360-062c-5962-ab67-7d166e829582"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9d2273f-c214-550e-bdff-c833b0e8605d" :answer/id #uuid "b9d2273f-c214-550e-bdff-c833b0e8605d" :answer/type :answer.type/math :answer/value "12\\cdot {(\\frac{1}{6})}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-295b4554-e6e4-5572-8988-a41fbe42755b" :answer/id #uuid "295b4554-e6e4-5572-8988-a41fbe42755b" :answer/type :answer.type/math :answer/value "12\\cdot {(\\frac{5}{6})}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-f34187bf-602c-5b72-80aa-ab6dacc13343" :answer/id #uuid "f34187bf-602c-5b72-80aa-ab6dacc13343" :answer/type :answer.type/math :answer/value "12\\cdot {(\\frac{7}{6})}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-dc51588c-9b81-533c-b74d-397e014ebe49" :answer/id #uuid "dc51588c-9b81-533c-b74d-397e014ebe49" :answer/type :answer.type/math :answer/value "{12}^{3}\\cdot (\\frac{1}{6})" :db/ensure [:answer/validate]} {:db/id "answer-88b25360-062c-5962-ab67-7d166e829582" :answer/id #uuid "88b25360-062c-5962-ab67-7d166e829582" :answer/type :answer.type/math :answer/value "{12}^{3}\\cdot (\\frac{5}{6})" :db/ensure [:answer/validate]} {:db/id 17592186059869 :knowledge-point/questions ["question-85541785-a1f8-5b45-843e-637ba62e4e83" "question-3f3966bd-9f89-5978-a943-b86356ea0f72"] :db/ensure [:knowledge-point/validate]} {:db/id "question-85541785-a1f8-5b45-843e-637ba62e4e83" :question/id #uuid "85541785-a1f8-5b45-843e-637ba62e4e83" :question/math-academy-id "q-61871" :question/problem "Elena has $400$ TVs in her store. She expects that the number of TVs will decrease by $2%$ daily due to sales. Approximately how many TVs will be in her store after $3$ days?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $0.02%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ day, there will be $400\\cdot (0.98)$ TVs remaining.\n\n- After $2$ days, there will be approximately $400\\cdot (0.98)^{2}$ TVs remaining.\n\n- After $3$ days, there will be approximately $400\\cdot (0.98)^{3}$ TVs remaining." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5c3df3d-549f-5a8b-98e2-1cf655414971"] :db/ensure [:question/validate]} {:db/id "answer-field-a5c3df3d-549f-5a8b-98e2-1cf655414971" :answer-field/id #uuid "a5c3df3d-549f-5a8b-98e2-1cf655414971" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-619431ae-e9db-5a4b-a7fd-782b989a642c" :answer-field/choices ["answer-8473525f-1815-5c36-af56-1eb153bd55e1" "answer-710e9657-f231-554c-92fe-ec46ef48fb0b" "answer-619431ae-e9db-5a4b-a7fd-782b989a642c" "answer-59df4646-b50a-5d4b-ae72-4abb4bbc5af9" "answer-c59cd770-bed2-5f0d-a3f9-575cb42f709d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8473525f-1815-5c36-af56-1eb153bd55e1" :answer/id #uuid "8473525f-1815-5c36-af56-1eb153bd55e1" :answer/type :answer.type/math :answer/value "400\\cdot (0.02)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-710e9657-f231-554c-92fe-ec46ef48fb0b" :answer/id #uuid "710e9657-f231-554c-92fe-ec46ef48fb0b" :answer/type :answer.type/math :answer/value "400\\cdot (0.8)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-619431ae-e9db-5a4b-a7fd-782b989a642c" :answer/id #uuid "619431ae-e9db-5a4b-a7fd-782b989a642c" :answer/type :answer.type/math :answer/value "400\\cdot (0.98)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-59df4646-b50a-5d4b-ae72-4abb4bbc5af9" :answer/id #uuid "59df4646-b50a-5d4b-ae72-4abb4bbc5af9" :answer/type :answer.type/math :answer/value "400\\cdot (1.02)^{3}" :db/ensure [:answer/validate]} {:db/id "answer-c59cd770-bed2-5f0d-a3f9-575cb42f709d" :answer/id #uuid "c59cd770-bed2-5f0d-a3f9-575cb42f709d" :answer/type :answer.type/math :answer/value "{400}^{3}\\cdot (0.98)" :db/ensure [:answer/validate]} {:db/id "question-11af995c-4c5e-50de-8182-ca4e90fd1ecf" :question/id #uuid "11af995c-4c5e-50de-8182-ca4e90fd1ecf" :question/math-academy-id "q-61965" :question/problem "A soccer tournament began with $64$ teams. The number of teams reduced by $\\frac{1}{2}$ after every round. How many teams remained after $6$ rounds?" :question/worked-solution "There were $64$ initially, and this number decreased by $\\frac{1}{2}$ every round. \n\nTherefore:\n\n- After $1$ round, there were $64\\cdot (\\frac{1}{2})$ teams remaining.\n\n- After $2$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{2}$ teams remaining.\n\n- After $3$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{3}$ teams  remaining.\n\n- $…$\n\nRepeating this pattern, we see that there were $64\\cdot {(\\frac{1}{2})}^{6}$ teams remaining after $6$ rounds." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b0410c69-ce09-548b-ba42-743ef4a478a9"] :db/ensure [:question/validate]} {:db/id "answer-field-b0410c69-ce09-548b-ba42-743ef4a478a9" :answer-field/id #uuid "b0410c69-ce09-548b-ba42-743ef4a478a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer-field/choices ["answer-ef88dff2-c156-5cd2-98da-be865d390a62" "answer-03ad4804-5d67-5f61-a2ef-fb8a13a792b1" "answer-3957d0a7-b17e-59fa-ba9f-5a550a649663" "answer-b41a5b18-1ac7-5ab7-a7f0-296fa3f34e5c" "answer-775ad280-4252-584a-9cd3-1acf0234c161"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef88dff2-c156-5cd2-98da-be865d390a62" :answer/id #uuid "ef88dff2-c156-5cd2-98da-be865d390a62" :answer/type :answer.type/math :answer/value "64\\cdot {(2)}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer/id #uuid "03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer/type :answer.type/math :answer/value "64\\cdot {(\\frac{1}{2})}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-3957d0a7-b17e-59fa-ba9f-5a550a649663" :answer/id #uuid "3957d0a7-b17e-59fa-ba9f-5a550a649663" :answer/type :answer.type/math :answer/value "64\\cdot {(\\frac{3}{2})}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-b41a5b18-1ac7-5ab7-a7f0-296fa3f34e5c" :answer/id #uuid "b41a5b18-1ac7-5ab7-a7f0-296fa3f34e5c" :answer/type :answer.type/math :answer/value "{64}^{6}\\cdot (\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-775ad280-4252-584a-9cd3-1acf0234c161" :answer/id #uuid "775ad280-4252-584a-9cd3-1acf0234c161" :answer/type :answer.type/math :answer/value "{64}^{6}\\cdot (\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "question-3f3966bd-9f89-5978-a943-b86356ea0f72" :question/id #uuid "3f3966bd-9f89-5978-a943-b86356ea0f72" :question/math-academy-id "q-63873" :question/problem "A park is estimated to have $11\\,000$ rabbits. If their population decreases by $2%$ every year, what will the population of rabbits be approximately in ten years?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $2%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ year, there will be $11\\,000\\cdot (0.98)$ rabbits.\n\n- After $2$ years, there will be approximately $11\\,000\\cdot (0.98)^{2}$ rabbits.\n\n- After $3$ years, there will be approximately $11\\,000\\cdot (0.98)^{3}$ rabbits.\n\n- $…$\n\nRepeating this pattern, we see that there will be approximately $11\\,000\\cdot (0.98)^{10}$ rabbits in $10$ years." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7b4efd19-31d2-5e38-bf06-a602e93463a8"] :db/ensure [:question/validate]} {:db/id "answer-field-7b4efd19-31d2-5e38-bf06-a602e93463a8" :answer-field/id #uuid "7b4efd19-31d2-5e38-bf06-a602e93463a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer-field/choices ["answer-ef4db2b8-73eb-5c7d-a88b-f43140375b3b" "answer-7270ac70-c515-5aab-a7ed-575aca39f8d6" "answer-f4ca33f2-3d2b-5209-a730-c75645d73f9e" "answer-c506aa54-db09-523c-a6d5-40e5d1db4949" "answer-0c04ac1a-82ca-5e7d-960c-ce0d5428e163"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef4db2b8-73eb-5c7d-a88b-f43140375b3b" :answer/id #uuid "ef4db2b8-73eb-5c7d-a88b-f43140375b3b" :answer/type :answer.type/math :answer/value "11\\,000+{0.98}^{10}" :db/ensure [:answer/validate]} {:db/id "answer-7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer/id #uuid "7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer/type :answer.type/math :answer/value "11\\,000\\cdot (0.98)^{10}" :db/ensure [:answer/validate]} {:db/id "answer-f4ca33f2-3d2b-5209-a730-c75645d73f9e" :answer/id #uuid "f4ca33f2-3d2b-5209-a730-c75645d73f9e" :answer/type :answer.type/math :answer/value "11\\,{000}^{10}+{0.98}^{10}" :db/ensure [:answer/validate]} {:db/id "answer-c506aa54-db09-523c-a6d5-40e5d1db4949" :answer/id #uuid "c506aa54-db09-523c-a6d5-40e5d1db4949" :answer/type :answer.type/math :answer/value "11\\,{000}^{10}\\cdot 0.98" :db/ensure [:answer/validate]} {:db/id "answer-0c04ac1a-82ca-5e7d-960c-ce0d5428e163" :answer/id #uuid "0c04ac1a-82ca-5e7d-960c-ce0d5428e163" :answer/type :answer.type/math :answer/value "{(11\\,000\\cdot 0.98)}^{10}" :db/ensure [:answer/validate]} {:db/id "question-5e4151ac-1192-5c41-bdd3-5c80d61ad30d" :question/id #uuid "5e4151ac-1192-5c41-bdd3-5c80d61ad30d" :question/math-academy-id "q-103124" :question/problem "A company initially had $40\\,320$ followers on a social media platform. If the number of followers declines by $\\frac{1}{8}$ every month after some bad publicity, which expression gives approximately the number of followers after $4$ months?" :question/worked-solution "If the number of followers reduces by $\\frac{1}{8}$ every month, then $\\frac{7}{8}$ of the followers remains every month.\n\nTherefore:\n\n- After $1$ month, there will be $40\\,320\\cdot (\\frac{7}{8})$ followers.\n\n- After $2$ months, there will be $40\\,320\\cdot {(\\frac{7}{8})}^{2}$ followers.\n\n- After $3$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{3}$ followers.\n\n- After $4$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{4}$ followers." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8b2bdf66-4c59-5fc0-809b-1e1cdae74143"] :db/ensure [:question/validate]} {:db/id "answer-field-8b2bdf66-4c59-5fc0-809b-1e1cdae74143" :answer-field/id #uuid "8b2bdf66-4c59-5fc0-809b-1e1cdae74143" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-826be51e-5684-5c67-9bdc-d422871db60d" :answer-field/choices ["answer-365ac6de-5bc0-530c-8769-ab950b8fa19c" "answer-826be51e-5684-5c67-9bdc-d422871db60d" "answer-458c751d-9727-57bd-b649-b6e3f795e9f4" "answer-f33312dc-e9ad-50f7-8e70-313a65c252c4" "answer-d64d65fc-c9e4-5437-a07d-855621ae3d4e"] :db/ensure [:answer-field/validate]} {:db/id "answer-365ac6de-5bc0-530c-8769-ab950b8fa19c" :answer/id #uuid "365ac6de-5bc0-530c-8769-ab950b8fa19c" :answer/type :answer.type/math :answer/value "40\\,320\\cdot {(\\frac{1}{8})}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-826be51e-5684-5c67-9bdc-d422871db60d" :answer/id #uuid "826be51e-5684-5c67-9bdc-d422871db60d" :answer/type :answer.type/math :answer/value "40\\,320\\cdot {(\\frac{7}{8})}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-458c751d-9727-57bd-b649-b6e3f795e9f4" :answer/id #uuid "458c751d-9727-57bd-b649-b6e3f795e9f4" :answer/type :answer.type/math :answer/value "40\\,320\\cdot {(\\frac{9}{8})}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-f33312dc-e9ad-50f7-8e70-313a65c252c4" :answer/id #uuid "f33312dc-e9ad-50f7-8e70-313a65c252c4" :answer/type :answer.type/math :answer/value "40\\,{320}^{4}\\cdot (\\frac{1}{8})" :db/ensure [:answer/validate]} {:db/id "answer-d64d65fc-c9e4-5437-a07d-855621ae3d4e" :answer/id #uuid "d64d65fc-c9e4-5437-a07d-855621ae3d4e" :answer/type :answer.type/math :answer/value "40\\,{320}^{4}\\cdot (\\frac{7}{8})" :db/ensure [:answer/validate]} {:db/id "activity-d3db944e-9fd5-5b8c-9599-004bc0044d98" :activity/id #uuid "d3db944e-9fd5-5b8c-9599-004bc0044d98" :activity/title "Creating Exponential Decay Expressions" :activity/type :activity.type/review :activity/scope 17592186050339 :activity/course 17592186046647 :activity/steps ["step-78998f12-8872-552e-a5a5-da0ba51e3a78" "step-cac69b8e-8bc9-5431-8acd-2441edfca029" "step-effcf191-f1d7-5563-bf4f-8d03c6d7af58" "step-b04cce73-b728-5431-915f-d9612cfbf878" "step-b2551a52-3625-5e2d-81c6-6aeec20a969c"] :activity/first-step "step-78998f12-8872-552e-a5a5-da0ba51e3a78" :db/ensure [:activity/validate]} {:db/id "step-78998f12-8872-552e-a5a5-da0ba51e3a78" :step/id #uuid "78998f12-8872-552e-a5a5-da0ba51e3a78" :step/content 17592186060314 :step/next "step-cac69b8e-8bc9-5431-8acd-2441edfca029" :db/ensure [:step/validate]} {:db/id "step-cac69b8e-8bc9-5431-8acd-2441edfca029" :step/id #uuid "cac69b8e-8bc9-5431-8acd-2441edfca029" :step/content "question-85541785-a1f8-5b45-843e-637ba62e4e83" :step/next "step-effcf191-f1d7-5563-bf4f-8d03c6d7af58" :db/ensure [:step/validate]} {:db/id "step-effcf191-f1d7-5563-bf4f-8d03c6d7af58" :step/id #uuid "effcf191-f1d7-5563-bf4f-8d03c6d7af58" :step/content "question-11af995c-4c5e-50de-8182-ca4e90fd1ecf" :step/next "step-b04cce73-b728-5431-915f-d9612cfbf878" :db/ensure [:step/validate]} {:db/id "step-b04cce73-b728-5431-915f-d9612cfbf878" :step/id #uuid "b04cce73-b728-5431-915f-d9612cfbf878" :step/content "question-3f3966bd-9f89-5978-a943-b86356ea0f72" :step/next "step-b2551a52-3625-5e2d-81c6-6aeec20a969c" :db/ensure [:step/validate]} {:db/id "step-b2551a52-3625-5e2d-81c6-6aeec20a969c" :step/id #uuid "b2551a52-3625-5e2d-81c6-6aeec20a969c" :step/content "question-5e4151ac-1192-5c41-bdd3-5c80d61ad30d" :db/ensure [:step/validate]} [:db/retract 17592186112884 :answer-field/choices 17592186112885] [:db/retract 17592186112884 :answer-field/choices 17592186112887] [:db/retract 17592186112890 :answer-field/choices 17592186112891] [:db/retract 17592186112890 :answer-field/choices 17592186112892] [:db/retract 17592186112890 :answer-field/choices 17592186112894] [:db/retract 17592186112890 :answer-field/choices 17592186112895] {:db/id 17592186115213 :knowledge-point/questions ["question-9b0b21ed-9399-541e-870b-dc048c3a5954" "question-c6d686ab-e99a-50e7-9f05-fa963ea40c5a" "question-5004d37a-89b2-53f7-9b0b-a8e11a406464"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115040 :question/problem "If $\\log_2(x^2-6)=\\log_2(10),$ then what is the value of $x?$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{2}-6) & ={log}_{2}⁡(10) \\\\ {x}^{2}-6 & =10 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=4$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{2}-6) & ={log}_{2}⁡({4}^{2}-6) \\\\  & ={log}_{2}⁡(16-6) \\\\  & ={log}_{2}⁡(10).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=4$ is a valid solution.\n\n- Substituting $x=-4$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{2}-6) & ={log}_{2}⁡((-4)^{2}-6) \\\\  & ={log}_{2}⁡(16-6) \\\\  & ={log}_{2}⁡(10).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-4$ is a valid solution.\n\nSo, we conclude that the solutions are $x = \\pm 4.$" :db/ensure [:question/validate]} {:db/id 17592186115215 :knowledge-point/questions ["question-41f4ba90-bf6f-5f13-ae98-77405268cba9" "question-1e549fe4-3be0-5aa2-9b34-f060b6793b1c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115043 :question/problem "Solve $\\log (x-1)=\\log (2x+1)$ for $x.$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x-1) & =\\operatorname{log}⁡(2x+1) \\\\ x-1 & =2x+1 \\\\ x & =-2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=-2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x-1) & \\overset{?}{=}\\operatorname{log}⁡(2x+1) \\\\ \\operatorname{log}⁡(-2-1) & \\overset{?}{=}\\operatorname{log}⁡(2(-2)+1) \\\\ \\operatorname{log}⁡(-3) & \\overset{?}{=}\\operatorname{log}⁡(-3)\\end{aligned}\n$$\n\nHowever, $\\log (-3)$ is not a real number.\n\nTherefore, we conclude that the equation has no real solutions." :db/ensure [:question/validate]} {:db/id 17592186115214 :knowledge-point/questions ["question-325f155d-1090-569d-9381-79bbdc699aa8" "question-b409a03d-9253-56f1-9515-c6248febada5" "question-98df2a56-4669-5921-84a6-4e54451b6791" "question-ecdce78b-6ad1-5fcc-9999-f701ae74931a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115042 :question/problem "Solve the equation $\\ln (2x^2)=\\ln (3x).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & =\\operatorname{ln}⁡(3x) \\\\ 2{x}^{2} & =3x \\\\ 2{x}^{2}-3x & =0 \\\\ x(2x-3) & =0 \\\\ x & =0,\\,\\frac{3}{2}.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=0$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2(0)^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3(0)) \\\\ \\operatorname{ln}⁡(0) & \\overset{?}{=}\\operatorname{ln}⁡(0)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because $\\ln \\left(0\\right)$ is undefined. Therefore, $x=0$ is not a valid solution.\n\n- Substituting $x=\\dfrac{3}{2}$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2{(\\frac{3}{2})}^{2}) & \\overset{?}{=}\\operatorname{ln}⁡(3(\\frac{3}{2})) \\\\ \\operatorname{ln}⁡(\\frac{9}{2}) & =\\operatorname{ln}⁡(\\frac{9}{2}).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=\\dfrac{3}{2}$ is a valid solution.\n\nTherefore, the only solution is $x =\\dfrac{3}{2}.$" :db/ensure [:question/validate]} {:db/id "question-9b0b21ed-9399-541e-870b-dc048c3a5954" :question/id #uuid "9b0b21ed-9399-541e-870b-dc048c3a5954" :question/math-academy-id "q-79867" :question/problem "Solve the equation ${log}_{3}⁡(x+4)=\\frac{1}{2}{log}_{3}⁡(25).$" :question/worked-solution "First, we use the power rule to simplify the right-hand side. This gives\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & =\\frac{1}{2}{log}_{3}⁡(25) \\\\ {log}_{3}⁡(x+4) & ={log}_{3}⁡({25}^{1/2}) \\\\ {log}_{3}⁡(x+4) & ={log}_{3}⁡(5).\\end{aligned}\n$$\n\nSince the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & ={log}_{3}⁡(5) \\\\ x+4 & =5 \\\\ x & =1.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=1$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{3}⁡(x+4) & ={log}_{3}⁡(1+4) \\\\  & ={log}_{3}⁡(5) \\\\  & =\\frac{1}{2}{log}_{3}⁡(25).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=1$ is a valid solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e1b6915c-b642-5726-bac9-d65678766025"] :db/ensure [:question/validate]} {:db/id "answer-field-e1b6915c-b642-5726-bac9-d65678766025" :answer-field/id #uuid "e1b6915c-b642-5726-bac9-d65678766025" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75580bdf-e42f-542a-b4aa-5db9e8a21d38" :answer-field/choices ["answer-75580bdf-e42f-542a-b4aa-5db9e8a21d38" "answer-53fe331b-623c-552e-9c20-0255b34584e3" "answer-910dd9c5-7c4a-5d17-a062-a66f81d657dd" "answer-85689f35-93ad-5798-b798-e9f1e7536146" "answer-d303cba2-df7f-5aef-a154-da6afc090924"] :db/ensure [:answer-field/validate]} {:db/id "answer-75580bdf-e42f-542a-b4aa-5db9e8a21d38" :answer/id #uuid "75580bdf-e42f-542a-b4aa-5db9e8a21d38" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-53fe331b-623c-552e-9c20-0255b34584e3" :answer/id #uuid "53fe331b-623c-552e-9c20-0255b34584e3" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-910dd9c5-7c4a-5d17-a062-a66f81d657dd" :answer/id #uuid "910dd9c5-7c4a-5d17-a062-a66f81d657dd" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-85689f35-93ad-5798-b798-e9f1e7536146" :answer/id #uuid "85689f35-93ad-5798-b798-e9f1e7536146" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-d303cba2-df7f-5aef-a154-da6afc090924" :answer/id #uuid "d303cba2-df7f-5aef-a154-da6afc090924" :answer/type :answer.type/math :answer/value "x=9" :db/ensure [:answer/validate]} {:db/id "question-c6d686ab-e99a-50e7-9f05-fa963ea40c5a" :question/id #uuid "c6d686ab-e99a-50e7-9f05-fa963ea40c5a" :question/math-academy-id "q-100713" :question/problem "If $\\operatorname{ln}⁡({x}^{2}-56)=\\operatorname{ln}⁡(65),$ then what is the value of $x?$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡(65) \\\\ {x}^{2}-56 & =65 \\\\ {x}^{2} & =121 \\\\ x & =\\pm 11\\end{aligned}\n$$\n\n \n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=11$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡({11}^{2}-56) \\\\  & =\\operatorname{ln}⁡(121-56) \\\\  & =\\operatorname{ln}⁡(65).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=11$ is a valid solution.\n\n- Substituting $x=-11$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-56) & =\\operatorname{ln}⁡((-11)^{2}-56) \\\\  & =\\operatorname{ln}⁡(121-56) \\\\  & =\\operatorname{ln}⁡(65).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-11$ is a valid solution.\n\nFinally, the correct answer is \"$x=\\pm 11.$\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b2dd1e83-f10a-5da1-a48f-8f170a51b0ad"] :db/ensure [:question/validate]} {:db/id "answer-field-b2dd1e83-f10a-5da1-a48f-8f170a51b0ad" :answer-field/id #uuid "b2dd1e83-f10a-5da1-a48f-8f170a51b0ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4063b761-cd24-5cca-b104-08fd4033a09a" :answer-field/choices ["answer-4063b761-cd24-5cca-b104-08fd4033a09