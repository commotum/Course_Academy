:tutorial/validate]} {:db/id 17592186147684 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-129a1854-2f4b-567e-bfbe-6c1b7fe4b689" :activity/id #uuid "129a1854-2f4b-567e-bfbe-6c1b7fe4b689" :activity/title "Calculating the Eigenvectors of a 3x3 Matrix With Distinct Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186050820 :activity/course 17592186046660 :activity/steps ["step-79acdebf-dccc-5a6c-84a3-c4482c1dbcac" "step-9de96552-9aff-59f8-bf73-97a5a9a29e02" "step-e095c51e-c500-590a-8101-841f07aafbc2" "step-be19b29e-d4c3-5ad8-ba5e-8d63063a62a1" "step-54a37441-fb97-5482-8800-e7be9eb1f718"] :activity/first-step "step-79acdebf-dccc-5a6c-84a3-c4482c1dbcac" :db/ensure [:activity/validate]} {:db/id "step-79acdebf-dccc-5a6c-84a3-c4482c1dbcac" :step/id #uuid "79acdebf-dccc-5a6c-84a3-c4482c1dbcac" :step/content 17592186392038 :step/next "step-9de96552-9aff-59f8-bf73-97a5a9a29e02" :db/ensure [:step/validate]} {:db/id "step-9de96552-9aff-59f8-bf73-97a5a9a29e02" :step/id #uuid "9de96552-9aff-59f8-bf73-97a5a9a29e02" :step/content 17592186323913 :step/next "step-e095c51e-c500-590a-8101-841f07aafbc2" :db/ensure [:step/validate]} {:db/id "step-e095c51e-c500-590a-8101-841f07aafbc2" :step/id #uuid "e095c51e-c500-590a-8101-841f07aafbc2" :step/content 17592186399187 :step/next "step-be19b29e-d4c3-5ad8-ba5e-8d63063a62a1" :db/ensure [:step/validate]} {:db/id "step-be19b29e-d4c3-5ad8-ba5e-8d63063a62a1" :step/id #uuid "be19b29e-d4c3-5ad8-ba5e-8d63063a62a1" :step/content 17592186272147 :step/next "step-54a37441-fb97-5482-8800-e7be9eb1f718" :db/ensure [:step/validate]} {:db/id "step-54a37441-fb97-5482-8800-e7be9eb1f718" :step/id #uuid "54a37441-fb97-5482-8800-e7be9eb1f718" :step/content 17592186381111 :db/ensure [:step/validate]} [:db/retract 17592186165812 :answer-field/choices 17592186165813] [:db/retract 17592186165812 :answer-field/choices 17592186165814] [:db/retract 17592186165812 :answer-field/choices 17592186165815] [:db/retract 17592186165812 :answer-field/choices 17592186165816] [:db/retract 17592186165812 :answer-field/choices 17592186165817] [:db/retract 17592186165806 :answer-field/choices 17592186165808] [:db/retract 17592186165806 :answer-field/choices 17592186165809] [:db/retract 17592186165806 :answer-field/choices 17592186165810] [:db/retract 17592186165806 :answer-field/choices 17592186165811] [:db/retract 17592186165806 :answer-field/choices 17592186165807] [:db/retract 17592186166316 :answer-field/choices 17592186166320] [:db/retract 17592186166316 :answer-field/choices 17592186166321] [:db/retract 17592186166316 :answer-field/choices 17592186166317] [:db/retract 17592186166316 :answer-field/choices 17592186166318] [:db/retract 17592186166316 :answer-field/choices 17592186166319] [:db/retract 17592186165818 :answer-field/choices 17592186165819] [:db/retract 17592186165818 :answer-field/choices 17592186165820] [:db/retract 17592186165818 :answer-field/choices 17592186165821] [:db/retract 17592186165818 :answer-field/choices 17592186165822] [:db/retract 17592186165818 :answer-field/choices 17592186165823] [:db/retract 17592186166322 :answer-field/choices 17592186166323] [:db/retract 17592186166322 :answer-field/choices 17592186166324] [:db/retract 17592186166322 :answer-field/choices 17592186166325] [:db/retract 17592186166322 :answer-field/choices 17592186166326] [:db/retract 17592186166322 :answer-field/choices 17592186166327] [:db/retract 17592186165824 :answer-field/choices 17592186165825] [:db/retract 17592186165824 :answer-field/choices 17592186165826] [:db/retract 17592186165824 :answer-field/choices 17592186165827] [:db/retract 17592186165824 :answer-field/choices 17592186165828] [:db/retract 17592186165824 :answer-field/choices 17592186165829] [:db/retract 17592186165836 :answer-field/choices 17592186165840] [:db/retract 17592186165836 :answer-field/choices 17592186165841] [:db/retract 17592186165836 :answer-field/choices 17592186165837] [:db/retract 17592186165836 :answer-field/choices 17592186165838] [:db/retract 17592186165836 :answer-field/choices 17592186165839] [:db/retract 17592186165830 :answer-field/choices 17592186165831] [:db/retract 17592186165830 :answer-field/choices 17592186165832] [:db/retract 17592186165830 :answer-field/choices 17592186165833] [:db/retract 17592186165830 :answer-field/choices 17592186165834] [:db/retract 17592186165830 :answer-field/choices 17592186165835] {:db/id 17592186166807 :knowledge-point/questions ["question-46c80522-dca7-526c-a225-6cc3d9755240" "question-dbcc5371-79bd-5123-b706-5a10821a5d21" "question-02d58382-8176-5a03-b109-135b67345884"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166645 :question/problem "Calculate $\\displaystyle \\int \\dfrac{1}{4-(2x-2)^2} \\textrm{d}x.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\dfrac{1}{4-(2x-2)^2}\\textrm{d}x = \n\\int \\dfrac{1}{4-4(x-1)^2}\\textrm{d}x = \n\\dfrac{1}{4} {\\int}\\dfrac{1}{ 1 - (x-1)^2 }\\textrm{d}x.\n$$\n\nLet $u = x-1.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(x-1)}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arcoth}⁡(x-1)+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $\\left|{x-1} \\right| >   1.$" :db/ensure [:question/validate]} {:db/id 17592186166806 :knowledge-point/questions ["question-726516a6-793d-5373-8298-c27b8c843f27" "question-6858ad14-b7bc-531f-aa86-afb1603436a5" "question-e0181c3f-486e-569d-aaa1-064715b86f7e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166644 :question/problem "${\\displaystyle \\int \\dfrac{1}{(x-1)\\sqrt{2x-x^2}} \\textrm{d}x= }$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\eqalign{\n2x-x^2 & = -(x^2 - 2x)\\[5pt]\n& = -(x^2 - 2\\cdot x + 1^2-1^2)\\[5pt]\n& = -((x-1)^2 - 1) \\[5pt]\n&= 1 - (x-1)^2\n}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{1}{(x-1)\\sqrt{2x-x^2}} \\textrm{d}x  = \\int  \\dfrac{1}{(x-1)\\sqrt { 1-(x-1)^2 } }\t\\, \\textrm{d}x.\n$$\n\nLet $u = x-1.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x-1)\\sqrt{2x-{x}^{2}}}\\text{d}x & =\\int \\frac{1}{(x-1)\\sqrt{1-(x-1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(x-1)+C.\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166808 :knowledge-point/questions ["question-87c6c320-8ad0-5a7a-8ea7-78e763a7875c" "question-69f3a20c-d1a0-5eb2-90e0-cb5356408eda" "question-fa581feb-4c4c-5d1e-ad5b-763e0315938f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166646 :question/problem "${\\displaystyle \\int \\dfrac{6}{|3x+9|\\sqrt{x^2+6x+10}} \\textrm{d}x= }$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+10 & ={x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}+10 \\\\  & =(x+3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{6}{|3x\\!+\\!9|\\sqrt{x^2\\!+\\!6x\\!+\\!10}} \\,\\textrm{d}x  = \\int  \\dfrac{6}{3|x\\!+\\!3|\\sqrt {1\\!+\\!(x\\!+\\!3)^2} }\t\\, \\textrm{d}x = {2} \\int \\dfrac{1}{|x\\!+\\!3|\\sqrt{1\\!+\\!(x\\!+\\!3)^2}} \\, \\textrm{d}x.\n$$\n\nLet $u = x+3.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}2\\int \\frac{1}{|x+3|\\sqrt{1+(x+3)^{2}}}\\text{d}x & =2\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-2\\operatorname{arcsch}⁡u+C \\\\  & =-2\\operatorname{arcsch}⁡(x+3)+C.\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166809 :knowledge-point/questions ["question-42211531-3fd4-52dd-adb0-73d677948d1f" "question-dc07885c-59ca-5761-a1b0-43a8e8cb6e2b" "question-8dc0f52e-b98b-54ec-bcf4-1fa4702113db"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166647 :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\eqalign{\n3-2x-x^2 & = -(x^2 + 2x - 3)\\[5pt]\n& = -(x^2 + 2\\cdot x +1^2 - 1^2 - 3)\\[5pt]\n& = -((x+1)^2 - 4) \\[5pt]\n&= 4 - (x+1)^2\n}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\dfrac{1}{3-2x-x^2}\\textrm{d}x =\n\\int \\dfrac{1}{4-(x+1)^2}\\textrm{d}x = \n\\dfrac{1}{4} {\\int}\\dfrac{1}{ 1 - \\left( \\frac{1}{2}(x+1)\\right)^2 }\\textrm{d}x.\n$$\n\nLet $u = \\dfrac{1}{2}(x+1).$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{2}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 2\\,\\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x+1))}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{2}(x+1))+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+1}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $\\left|\\dfrac {x+1} {2} \\right| >   1.$" :db/ensure [:question/validate]} {:db/id 17592186167434 :question/problem "Calculate $\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}=\\int \\frac{\\text{d}x}{6|x-\\frac{1}{3}|\\sqrt{9+9{(x-\\frac{1}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{1}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡(x-\\frac{1}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡(\\frac{3x-1}{3})+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186165812 :answer-field/correct "answer-29890455-6ae9-5148-b652-040930f8a666" :answer-field/choices ["answer-29890455-6ae9-5148-b652-040930f8a666" "answer-adc66bf6-9610-5424-b2cc-2f08ea59b274" "answer-a93b94ff-8a35-57fb-9c5d-28f6c673d961" "answer-7d57b259-4c0c-5d0c-aafc-42e8ea0a1ab3" "answer-11c72aed-2f1d-591b-bc3b-b752ede408b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-29890455-6ae9-5148-b652-040930f8a666" :answer/id #uuid "29890455-6ae9-5148-b652-040930f8a666" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}\\operatorname{arcsch}⁡(\\frac{3x-1}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-adc66bf6-9610-5424-b2cc-2f08ea59b274" :answer/id #uuid "adc66bf6-9610-5424-b2cc-2f08ea59b274" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-1}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-a93b94ff-8a35-57fb-9c5d-28f6c673d961" :answer/id #uuid "a93b94ff-8a35-57fb-9c5d-28f6c673d961" :answer/type :answer.type/math :answer/value "-\\frac{1}{9}\\operatorname{arcsch}⁡(3x-1)+C" :db/ensure [:answer/validate]} {:db/id "answer-7d57b259-4c0c-5d0c-aafc-42e8ea0a1ab3" :answer/id #uuid "7d57b259-4c0c-5d0c-aafc-42e8ea0a1ab3" :answer/type :answer.type/math :answer/value "\\frac{1}{18}\\operatorname{arcsch}⁡(3x-1)+C" :db/ensure [:answer/validate]} {:db/id "answer-11c72aed-2f1d-591b-bc3b-b752ede408b0" :answer/id #uuid "11c72aed-2f1d-591b-bc3b-b752ede408b0" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arsech}⁡(\\frac{3x-1}{3})+C" :db/ensure [:answer/validate]} {:db/id "question-46c80522-dca7-526c-a225-6cc3d9755240" :question/id #uuid "46c80522-dca7-526c-a225-6cc3d9755240" :question/math-academy-id "q-97313" :question/problem "Calculate $\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}=\\int \\frac{\\text{d}x}{6(x-\\frac{2}{3})\\sqrt{9-9{(x-\\frac{2}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{2}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(x-\\frac{2}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fe2698ca-7e20-5c2e-95df-9f69c77c58a2"] :db/ensure [:question/validate]} {:db/id "answer-field-fe2698ca-7e20-5c2e-95df-9f69c77c58a2" :answer-field/id #uuid "fe2698ca-7e20-5c2e-95df-9f69c77c58a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c0f32036-6948-5f43-a566-222721d70200" :answer-field/choices ["answer-d37f6b69-2bf6-5e33-a159-45bc4b373ce2" "answer-c0f32036-6948-5f43-a566-222721d70200" "answer-2d7c4290-9353-557a-a78e-c9968ff65543" "answer-88bb5d4b-0ce6-53d9-8497-039fb7fe2e2b" "answer-5ce2b7d3-6d59-59f5-8ebe-05b2e387253e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d37f6b69-2bf6-5e33-a159-45bc4b373ce2" :answer/id #uuid "d37f6b69-2bf6-5e33-a159-45bc4b373ce2" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}\\operatorname{arcsch}⁡(3x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-c0f32036-6948-5f43-a566-222721d70200" :answer/id #uuid "c0f32036-6948-5f43-a566-222721d70200" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-2d7c4290-9353-557a-a78e-c9968ff65543" :answer/id #uuid "2d7c4290-9353-557a-a78e-c9968ff65543" :answer/type :answer.type/math :answer/value "-\\frac{1}{9}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-88bb5d4b-0ce6-53d9-8497-039fb7fe2e2b" :answer/id #uuid "88bb5d4b-0ce6-53d9-8497-039fb7fe2e2b" :answer/type :answer.type/math :answer/value "\\frac{1}{18}\\operatorname{arcsch}⁡(\\frac{3x-2}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-5ce2b7d3-6d59-59f5-8ebe-05b2e387253e" :answer/id #uuid "5ce2b7d3-6d59-59f5-8ebe-05b2e387253e" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arsech}⁡(3x-2)+C" :db/ensure [:answer/validate]} {:db/id "question-dbcc5371-79bd-5123-b706-5a10821a5d21" :question/id #uuid "dbcc5371-79bd-5123-b706-5a10821a5d21" :question/math-academy-id "q-97758" :question/problem "Calculate $\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x=\\int \\frac{1}{4-4{(\\frac{x+3}{2})}^{2}}\\text{d}x=\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{x+3}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+3}{2}|>1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8f32ba7e-ec4d-5979-a816-0eff8d932fa9"] :db/ensure [:question/validate]} {:db/id "answer-field-8f32ba7e-ec4d-5979-a816-0eff8d932fa9" :answer-field/id #uuid "8f32ba7e-ec4d-5979-a816-0eff8d932fa9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ede2391-c2b2-5c77-84a5-0c2d651d0c65" :answer-field/choices ["answer-7ecac083-f3f6-50fd-85bd-f274abf8632b" "answer-5ede2391-c2b2-5c77-84a5-0c2d651d0c65" "answer-0e2a94b3-44dd-52b7-9ec8-57361cc9534d" "answer-8f9a2895-a913-526c-a6b5-9b164f01bfb0" "answer-c0b5fe7e-e088-5647-ad7c-cb6d53c10815"] :db/ensure [:answer-field/validate]} {:db/id "answer-7ecac083-f3f6-50fd-85bd-f274abf8632b" :answer/id #uuid "7ecac083-f3f6-50fd-85bd-f274abf8632b" :answer/type :answer.type/math :answer/value "2\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-5ede2391-c2b2-5c77-84a5-0c2d651d0c65" :answer/id #uuid "5ede2391-c2b2-5c77-84a5-0c2d651d0c65" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-0e2a94b3-44dd-52b7-9ec8-57361cc9534d" :answer/id #uuid "0e2a94b3-44dd-52b7-9ec8-57361cc9534d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-8f9a2895-a913-526c-a6b5-9b164f01bfb0" :answer/id #uuid "8f9a2895-a913-526c-a6b5-9b164f01bfb0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-c0b5fe7e-e088-5647-ad7c-cb6d53c10815" :answer/id #uuid "c0b5fe7e-e088-5647-ad7c-cb6d53c10815" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x+3}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "question-02d58382-8176-5a03-b109-135b67345884" :question/id #uuid "02d58382-8176-5a03-b109-135b67345884" :question/math-academy-id "q-97750" :question/problem "Calculate $\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-(3x+3)^{2}}}.$" :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-(3x+3)^{2}}} & =\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-9{(x+1)}^{2}}}=\\frac{1}{3}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+1.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(x+1)+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5b435c31-7ad5-5fce-a19f-e0cb3a0a30ed"] :db/ensure [:question/validate]} {:db/id "answer-field-5b435c31-7ad5-5fce-a19f-e0cb3a0a30ed" :answer-field/id #uuid "5b435c31-7ad5-5fce-a19f-e0cb3a0a30ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e9f6082e-4214-5c75-b4b6-a0e478cad0f2" :answer-field/choices ["answer-846a8a5f-917a-52ee-8aed-571fe7baf73b" "answer-e9f6082e-4214-5c75-b4b6-a0e478cad0f2" "answer-c7b139d4-d0e6-5a0b-bd46-0a812e6fd8c3" "answer-95b988d9-0f78-5bd1-a98b-93f47ac0eec2" "answer-b74520f3-a453-5525-9973-50557d9b81f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-846a8a5f-917a-52ee-8aed-571fe7baf73b" :answer/id #uuid "846a8a5f-917a-52ee-8aed-571fe7baf73b" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡(3x+1)+C" :db/ensure [:answer/validate]} {:db/id "answer-e9f6082e-4214-5c75-b4b6-a0e478cad0f2" :answer/id #uuid "e9f6082e-4214-5