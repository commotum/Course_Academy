c{1}{|x+\\frac{1}{2}|\\sqrt{4[1+{(x+\\frac{1}{2})}^{2}]}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+\\frac{1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186166322 :answer-field/correct "answer-ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer-field/choices ["answer-5a53a977-08c6-5df9-a860-2371d7ca93a8" "answer-f5fa1e27-e6e7-5ee2-8cfd-06752c595b70" "answer-ac30b210-151b-52ec-9f43-9946b5b6bd5d" "answer-e5e11cb3-9047-5ff4-947e-2cd0cb49d427" "answer-a541d1ea-9725-5c0d-81a6-8717209ba023"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a53a977-08c6-5df9-a860-2371d7ca93a8" :answer/id #uuid "5a53a977-08c6-5df9-a860-2371d7ca93a8" :answer/type :answer.type/math :answer/value "-2\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-f5fa1e27-e6e7-5ee2-8cfd-06752c595b70" :answer/id #uuid "f5fa1e27-e6e7-5ee2-8cfd-06752c595b70" :answer/type :answer.type/math :answer/value "-2\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/id #uuid "ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-e5e11cb3-9047-5ff4-947e-2cd0cb49d427" :answer/id #uuid "e5e11cb3-9047-5ff4-947e-2cd0cb49d427" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-a541d1ea-9725-5c0d-81a6-8717209ba023" :answer/id #uuid "a541d1ea-9725-5c0d-81a6-8717209ba023" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/ensure [:answer/validate]} {:db/id "question-69f3a20c-d1a0-5eb2-90e0-cb5356408eda" :question/id #uuid "69f3a20c-d1a0-5eb2-90e0-cb5356408eda" :question/math-academy-id "q-97901" :question/problem "$\\int -\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+13}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+13 & ={x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}+13 \\\\  & =(x+3)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int -\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+13}}\\,\\text{d}x & =-\\int \\frac{6}{|x+3|\\sqrt{4+(x+3)^{2}}}\\,\\text{d}x \\\\  & =-\\int \\frac{6}{2|\\frac{x+3}{2}|\\sqrt{4+4{(\\frac{x+3}{2})}^{2}}}\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\int \\frac{1}{|\\frac{x+3}{2}|\\sqrt{1+{(\\frac{x+3}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+3}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-\\frac{3}{2}\\int \\frac{1}{|\\frac{x+3}{2}|\\sqrt{1+{(\\frac{x+3}{2})}^{2}}}\\text{d}x & =-\\frac{3}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =-3\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =3\\operatorname{arcsch}⁡u+C \\\\  & =3\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2e1629ae-ab1a-568d-929f-d60dc925bde5"] :db/ensure [:question/validate]} {:db/id "answer-field-2e1629ae-ab1a-568d-929f-d60dc925bde5" :answer-field/id #uuid "2e1629ae-ab1a-568d-929f-d60dc925bde5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-453056a6-3a29-558e-96a3-8e72fe77debe" :answer-field/choices ["answer-82eda7e3-a9bb-5caf-8d13-aa3068ab29d6" "answer-a5174d35-1a1b-5a59-a41a-cfbded8edbe3" "answer-453056a6-3a29-558e-96a3-8e72fe77debe" "answer-d47c671f-daea-5c22-a4cd-9f6d91df90f6" "answer-19c51b78-104c-5cc3-aee1-4e68441c9623"] :db/ensure [:answer-field/validate]} {:db/id "answer-82eda7e3-a9bb-5caf-8d13-aa3068ab29d6" :answer/id #uuid "82eda7e3-a9bb-5caf-8d13-aa3068ab29d6" :answer/type :answer.type/math :answer/value "-3\\operatorname{arsech}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-a5174d35-1a1b-5a59-a41a-cfbded8edbe3" :answer/id #uuid "a5174d35-1a1b-5a59-a41a-cfbded8edbe3" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}\\operatorname{arsech}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-453056a6-3a29-558e-96a3-8e72fe77debe" :answer/id #uuid "453056a6-3a29-558e-96a3-8e72fe77debe" :answer/type :answer.type/math :answer/value "3\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-d47c671f-daea-5c22-a4cd-9f6d91df90f6" :answer/id #uuid "d47c671f-daea-5c22-a4cd-9f6d91df90f6" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-19c51b78-104c-5cc3-aee1-4e68441c9623" :answer/id #uuid "19c51b78-104c-5cc3-aee1-4e68441c9623" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C" :db/ensure [:answer/validate]} {:db/id 17592186167436 :question/problem "$\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+5 & ={x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}+5 \\\\  & =(x-2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\,\\text{d}x=\\int \\frac{2}{4|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186165824 :answer-field/correct "answer-eb1b61ae-1e87-535f-8fc0-68cde71649a4" :answer-field/choices ["answer-cfc1ea2f-a52f-5330-a42a-047633957a3a" "answer-eb1b61ae-1e87-535f-8fc0-68cde71649a4" "answer-7757ac70-ef61-5e8f-a5b3-02b102e498d4" "answer-0d84557a-483b-5d86-b94d-d4c4b8aaecf2" "answer-9c33e5eb-9dde-5c7c-b414-ba30f3308878"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfc1ea2f-a52f-5330-a42a-047633957a3a" :answer/id #uuid "cfc1ea2f-a52f-5330-a42a-047633957a3a" :answer/type :answer.type/math :answer/value "-2\\operatorname{arcsch}⁡(x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-eb1b61ae-1e87-535f-8fc0-68cde71649a4" :answer/id #uuid "eb1b61ae-1e87-535f-8fc0-68cde71649a4" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-7757ac70-ef61-5e8f-a5b3-02b102e498d4" :answer/id #uuid "7757ac70-ef61-5e8f-a5b3-02b102e498d4" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-0d84557a-483b-5d86-b94d-d4c4b8aaecf2" :answer/id #uuid "0d84557a-483b-5d86-b94d-d4c4b8aaecf2" :answer/type :answer.type/math :answer/value "2\\operatorname{arsech}⁡(x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-9c33e5eb-9dde-5c7c-b414-ba30f3308878" :answer/id #uuid "9c33e5eb-9dde-5c7c-b414-ba30f3308878" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(x-2)+C" :db/ensure [:answer/validate]} {:db/id "question-fa581feb-4c4c-5d1e-ad5b-763e0315938f" :question/id #uuid "fa581feb-4c4c-5d1e-ad5b-763e0315938f" :question/math-academy-id "q-97780" :question/problem "$\\int \\frac{4}{|x+1|\\sqrt{{x}^{2}+2x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+2x+5 & ={x}^{2}+2\\cdot x+{1}^{2}-{1}^{2}+5 \\\\  & =(x+1)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{4}{|x+1|\\sqrt{{x}^{2}+2x+5}}\\,\\text{d}x & =\\int \\frac{4}{|x+1|\\sqrt{4+(x+1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{2}{|\\frac{x+1}{2}|\\sqrt{4+4{(\\frac{x+1}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|\\frac{x+1}{2}|\\sqrt{1+{(\\frac{x+1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|\\frac{x+1}{2}|\\sqrt{1+{(\\frac{x+1}{2})}^{2}}}\\text{d}x & =\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =2\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-2\\operatorname{arcsch}⁡u+C \\\\  & =-2\\operatorname{arcsch}⁡(\\frac{x+1}{2})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-59703bd9-6018-583d-92ce-e008586da72f"] :db/ensure [:question/validate]} {:db/id "answer-field-59703bd9-6018-583d-92ce-e008586da72f" :answer-field/id #uuid "59703bd9-6018-583d-92ce-e008586da72f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dabd251e-fae7-5698-83c0-507011d42bdf" :answer-field/choices ["answer-dabd251e-fae7-5698-83c0-507011d42bdf" "answer-45abf4a2-106d-55be-98fe-a203ed7f3489" "answer-650fbbcf-b967-5e75-a0a8-d383d4231cca" "answer-8a07f14a-602d-5dd1-aeec-f618cd8ac959" "answer-b64538dd-a81f-5c56-9eaa-8ba0ac2c899d"] :db/ensure [:answer-field/validate]} {:db/id "answer-dabd251e-fae7-5698-83c0-507011d42bdf" :answer/id #uuid "dabd251e-fae7-5698-83c0-507011d42bdf" :answer/type :answer.type/math :answer/value "-2\\operatorname{arcsch}⁡(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-45abf4a2-106d-55be-98fe-a203ed7f3489" :answer/id #uuid "45abf4a2-106d-55be-98fe-a203ed7f3489" :answer/type :answer.type/math :answer/value "-4\\operatorname{arcsch}⁡(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-650fbbcf-b967-5e75-a0a8-d383d4231cca" :answer/id #uuid "650fbbcf-b967-5e75-a0a8-d383d4231cca" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-8a07f14a-602d-5dd1-aeec-f618cd8ac959" :answer/id #uuid "8a07f14a-602d-5dd1-aeec-f618cd8ac959" :answer/type :answer.type/math :answer/value "2\\operatorname{arsech}⁡(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-b64538dd-a81f-5c56-9eaa-8ba0ac2c899d" :answer/id #uuid "b64538dd-a81f-5c56-9eaa-8ba0ac2c899d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id 17592186167438 :question/problem "$\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}1-4x-{x}^{2} & =-({x}^{2}+4x-1) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}-1) \\\\  & =-((x+2)^{2}-5) \\\\  & =5-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=\\int \\frac{1}{5-(x+2)^{2}}\\text{d}x=\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{\\sqrt{5}}(x+2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x & =\\frac{1}{5}\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{\\sqrt{5}}(x+2))+C \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{\\sqrt{5}})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+2}{\\sqrt{5}}|>1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186165836 :answer-field/correct "answer-808b6e4f-b16c-570c-99c7-b1e3de33c4a1" :answer-field/choices ["answer-bbf230ca-7c00-5a91-b46e-ec016a126ff3" "answer-c50775eb-d6ce-5b1a-9822-5f69ba8712d7" "answer-b51af6ea-46da-5bba-a5c9-65a857bf09c5" "answer-0fbf49c6-7dc7-5262-b85d-d6fa879d4450" "answer-808b6e4f-b16c-570c-99c7-b1e3de33c4a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-bbf230ca-7c00-5a91-b46e-ec016a126ff3" :answer/id #uuid "bbf230ca-7c00-5a91-b46e-ec016a126ff3" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{5})+C" :db/ensure [:answer/validate]} {:db/id "answer-c50775eb-d6ce-5b1a-9822-5f69ba8712d7" :answer/id #uuid "c50775eb-d6ce-5b1a-9822-5f69ba8712d7" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{5})+C" :db/ensure [:answer/validate]} {:db/id "answer-b51af6ea-46da-5bba-a5c9-65a857bf09c5" :answer/id #uuid "b51af6ea-46da-5bba-a5c9-65a857bf09c5" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{5})+C" :db/ensure [:answer/validate]} {:db/id "answer-0fbf49c6-7dc7-5262-b85d-d6fa879d4450" :answer/id #uuid "0fbf49c6-7dc7-5262-b85d-d6fa879d4450" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{\\sqrt{5}})+C" :db/ensure [:answer/validate]} {:db/id "answer-808b6e4f-b16c-570c-99c7-b1e3de33c4a1" :answer/id #uuid "808b6e4f-b16c-570c-99c7-b1e3de33c4a1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{\\sqrt{5}})+C" :db/ensure [:answer/validate]} {:db/id 17592186167437 :question/problem "Calculate $\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=\\int \\frac{1}{9-9(\\frac{1}{9}(x+4)^{2})}\\,\\text{d}x=\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x.\n$$\n\nLet $u=\\frac{1}{3}(x+4).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1-{u}^{2}}\\,\\cdot 3\\,\\text{d}u \\\\  & =\\frac{3}{9}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+4}{3}|>1.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165830 :answer-field/correct "answer-1700c4a5-52d0-5037-8796-caf2ee62ae0c" :answer-field/choices ["answer-65595378-37db-5a80-bfa3-54226b604247" "answer-588606f2-b50e-582f-b36f-92ef91f044f8" "answer-7b2b86f9-de8e-5b00-a2c6-4eb089bfc6de" "answer-1700c4a5-52d0-5037-8796-caf2ee62ae0c" "answer-3611fbe1-57c9-53e2-8603-e04f4f8be16d"] :db/ensure [:answer-field/validate]} {:db/id "answer-65595378-37db-5a80-bfa3-54226b604247" :answer/id #uuid "65595378-37db-5a80-bfa3-54226b604247" :answer/type :answer.type/math :answer/value "-\\frac{1}{9}\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-588606f2-b50e-582f-b36f-92ef91f044f8" :answer/id #uuid "588606f2-b50e-582f-b36f-92ef91f044f8" :answer/type :answer.type/math :answer/value "-\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-7b2b86f9-de8e-5b00-a2c6-4eb089bfc6de" :answer/id #uuid "7b2b86f9-de8e-5b00-a2c6-4eb089bfc6de" :answer/type :answer.type/math :answer/value "3\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-1700c4a5-52d0-5037-8796-caf2ee62ae0c" :answer/id #uuid "1700c4a5-52d0-5037-8796-caf2ee62ae0c" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-3611fbe1-57c9-53e2-8603-e04f4f8be16d" :answer/id #uuid "3611fbe1-57c9-53e2-8603-e04f4f8be16d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡(x+4)+C" :db/ensure [:answer/validate]} {:db/id "question-42211531-3fd4-52dd-adb0-73d677948d1f" :question/id #uuid "42211531-3fd4-52dd-adb0-73d677948d1f" :question/math-academy-id "q-97907" :question/problem "$\\int \\frac{1}{6x-{x}^{2}-5}\\text{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}6x-{x}^{2}-5 & =-({x}^{2}-6x+5) \\\\  & =-({x}^{2}-2\\cdot 3x+{3}^{2}-{3}^{2}+5) \\\\  & =-((x-3)^{2}-4) \\\\  & =4-(x-3)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{6x-{x}^{2}-5}\\text{d}x=\\int \\frac{1}{4-(x-3)^{2}}\\text{d}x=\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x-3))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{2}(x-3).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x-3))}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{2}(x-3))+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-3}{2}|>1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d8996f52-0a1f-58ab-9d5b-d752f553fcb0"] :db/ensure [:question/validate]} {:db/id "answer-field-d8996f52-0a1f-58ab-9d5b-d752f553fcb0" :answer-field/id #uuid "d8996f52-0a1f-58ab-9d5b-d752f553fcb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a53549e9-4d6a-5b8a-9f0f-45fd33da51c3" :answer-field/choices ["answer-a36db184-0ba8-51a6-a6e1-f3d0031f8eaf" "answer-1855bada-2725-59d8-a436-9eabac0d269a" "answer-a53549e9-4d6a-5b8a-9f0f-45fd33da51c3" "answer-cd63ed22-de30-53b6-8fe7-0ebc4520cbe9" "answer-d187b48a-c1be-5c6a-8137-357a4d0e0d91"] :db/ensure [:answer-field/validate]} {:db/id "answer-a36db184-0ba8-51a6-a6e1-f3d0031f8eaf" :answer/id #uuid "a36db184-0ba8-51a6-a6e1-f3d0031f8eaf" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-1855bada-2725-59d8-a436-9eabac0d269a" :answer/id #uuid "1855bada-2725-59d8-a436-9eabac0d269a" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-a53549e9-4d6a-5b8a-9f0f-45fd33da51c3" :answer/id #uuid "a53549e9-4d6a-5b8a-9f0f-45fd33da51c3" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-cd63ed22-de30-53b6-8fe7-0ebc4520cbe9" :answer/id #uuid "cd63ed22-de30-53b6-8fe7-0ebc4520cbe9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-d187b48a-c1be-5c6a-8137-357a4d0e0d91" :answer/id #uuid "d187b48a-c1be-5c6a-8137-357a4d0e0d91" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "question-dc07885c-59ca-5761-a1b0-43a8e8cb6e2b" :question/id #uuid "dc07885c-59ca-5761-a1b0-43a8e8cb6e2b" :question/math-academy-id "q-98008" :question/problem "$\\int \\frac{1}{12x-{x}^{2}-33}\\text{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}12x-{x}^{2}-33 & =-({x}^{2}-12x+33) \\\\  & =-({x}^{2}-2\\cdot 6x+{6}^{2}-{6}^{2}+33) \\\\  & =-((x-6)^{2}-3) \\\\  & =3-(x-6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{12x-{x}^{2}-33}\\text{d}x=\\int \\frac{1}{3-(x-6)^{2}}\\text{d}x=\\frac{1}{3}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{3}}(x-6))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{\\sqrt{3}}(x-6).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{3}}(x-6))}^{2}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{3}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{\\sqrt{3}}(x-6))+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{\\sqrt{3}})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-6}{\\sqrt{3}}|>1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0edb72e4-359e-521e-a337-ecd9f317a1a6"] :db/ensure [:question/validate]} {:db/id "answer-field-0edb72e4-359e-521e-a337-ecd9f317a1a6" :answer-field/id #uuid "0edb72e4-359e-521e-a337-ecd9f317a1a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d701ac5e-f7fc-59a7-8172-9671e49711d1" :answer-field/choices ["answer-a267b645-2e3e-5684-b73a-ee1553ef4a64" "answer-6cb6bcbe-491f-5c80-b732-790eda522c86" "answer-477b4b85-509c-50c5-94e2-30b9c718e7a5" "answer-97f3f503-2f88-57dd-99bb-2fd2911f3dea" "answer-d701ac5e-f7fc-59a7-8172-9671e49711d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-a267b645-2e3e-5684-b73a-ee1553ef4a64" :answer/id #uuid "a267b645-2e3e-5684-b73a-ee1553ef4a64" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{\\sqrt{3}})+C" :db/ensure [:answer/validate]} {:db/id "answer-6cb6bcbe-491f-5c80-b732-790eda522c86" :answer/id #uuid "6cb6bcbe-491f-5c80-b732-790eda522c86" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-477b4b85-509c-50c5-94e2-30b9c718e7a5" :answer/id #uuid "477b4b85-509c-50c5-94e2-30b9c718e7a5" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-97f3f503-2f88-57dd-99bb-2fd2911f3dea" :answer/id #uuid "97f3f503-2f88-57dd-99bb-2fd2911f3dea" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{\\sqrt{3}})+C" :db/ensure [:answer/validate]} {:db/id "answer-d701ac5e-f7fc-59a7-8172-9671e49711d1" :answer/id #uuid "d701ac5e-f7fc-59a7-8172-9671e49711d1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{\\sqrt{3}})+C" :db/ensure [:answer/validate]} {:db/id "question-8dc0f52e-b98b-54ec-bcf4-1fa4702113db" :question/id #uuid "8dc0f52e-b98b-54ec-bcf4-1fa4702113db" :question/math-academy-id "q-98005" :question/problem "$\\int \\frac{1}{12+4x-{x}^{2}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}12+4x-{x}^{2} & =-({x}^{2}-4x-12) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}-12) \\\\  & =-((x-2)^{2}-16) \\\\  & =16-(x-2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{12+4x-{x}^{2}}\\text{d}x=\\int \\frac{1}{16-(x-2)^{2}}\\text{d}x=\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(x-2))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{4}(x-2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(x-2))}^{2}}\\text{d}x & =\\frac{1}{16}\\int \\frac{1}{1-{u}^{2}}\\cdot 4\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{4}(x-2))+C \\\\  & =\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x-2}{4})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-2}{4}|>1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5ba0e725-7b1f-5872-b603-123fc8faa2d8"] :db/ensure [:question/validate]} {:db/id "answer-field-5ba0e725-7b1f-5872-b603-123fc8faa2d8" :answer-field/id #uuid "5ba0e725-7b1f-5872-b603-123fc8faa2d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-50e631f8-7a68-5ed6-948d-c6cd8d569be1" :answer-field/choices ["answer-b6d77791-2d19-57bb-83b2-1fc061951977" "answer-4bbc5aca-b66b-5326-80f6-72047f13c7d8" "answer-babf514f-5d4d-5f68-a29b-d4e542505f1b" "answer-50e631f8-7a68-5ed6-948d-c6cd8d569be1" "answer-4fd91ee3-171f-5ecd-a04d-ece67ed21978"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6d77791-2d19-57bb-83b2-1fc061951977" :answer/id #uuid "b6d77791-2d19-57bb-83b2-1fc061951977" :answer/type :answer.type/math :answer/value "-\\frac{1}{16}\\operatorname{arcoth}⁡(\\frac{x-2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-4bbc5aca-b66b-5326-80f6-72047f13c7d8" :answer/id #uuid "4bbc5aca-b66b-5326-80f6-72047f13c7d8" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{arcoth}⁡(\\frac{x-2}{4})+C" :db/ensure [:answer/validate]} {:db/id "answer-babf514f-5d4d-5f68-a29b-d4e542505f1b" :answer/id #uuid "babf514f-5d4d-5f68-a29b-d4e542505f1b" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x-2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-50e631f8-7a68-5ed6-948d-c6cd8d569be1" :answer/id #uuid "50e631f8-7a68-5ed6-948d-c6cd8d569be1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x-2}{4})+C" :db/ensure [:answer/validate]} {:db/id "answer-4fd91ee3-171f-5ecd-a04d-ece67ed21978" :answer/id #uuid "4fd91ee3-171f-5ecd-a04d-ece67ed21978" :answer/type :answer.type/math :answer/value "\\frac{1}{8}\\operatorname{arcoth}⁡(\\frac{x-2}{4})+C" :db/ensure [:answer/validate]} {:db/id 17592186168099 :tutorial/content "We can also complete the square to integrate hyperbolic *arcsecant*, *arccosecant*, and *arccotangent*.\n\nFor example, let's consider the integral\n\n$$\n\\int \\dfrac{1}{\\left(x+3\\right)\\sqrt{-x^2-6x}} \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can complete the square for the argument of the square root in the denominator, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of $9$ under the square root, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{1}{(x+3)\\sqrt{9-(x+3)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{3(x+3)\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis now looks more familiar! Let $u = \\dfrac {x+3}{3}.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 3\\,\\textrm{d}u.\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is a basic integral for an inverse reciprocal hyperbolic function, and we can solve it in one step:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(\\frac{x+3}{3})+C.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186167030 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} [:db/retract 17592186203389 :answer-field/choices 17592186203392] [:db/retract 17592186203389 :answer-field/choices 17592186203393] [:db/retract 17592186203389 :answer-field/choices 17592186203391] [:db/retract 17592186203407 :answer-field/choices 17592186203408] [:db/retract 17592186203407 :answer-field/choices 17592186203410] [:db/retract 17592186203407 :answer-field/choices 17592186203411] [:db/retract 17592186203407 :answer-field/choices 17592186203412] {:db/id 17592186204077 :knowledge-point/questions ["question-ee17a4e4-1d8d-5373-a5f7-48bfde731f73" "question-67046761-6838-5e5c-bd1f-8e1ae02d3dbf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186204576 :question/problem "Consider the function $f:{R}^{3}\\to R$ defined by $f(x)={x}^{T}x.$ What is the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a scalar-valued function $f:{R}^{n}\\to R$ with respect to a vector $x\\in {R}^{n}$ is the row vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]\\in {R}^{1\\times n}.\n$$\n\nIn our case, the function \n\n- acts on a vector $x\\in {R}^{3},$ and\n\n- outputs a scalar $f({x}_{1},{x}_{2},{x}_{3})\\in R$ defined by \n\n$$\nf(x)={x}^{T}x=[\\begin{aligned}{x}_{1} & {x}_{2} & {x}_{3}\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & \\frac{∂f}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{3}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1} & 2{x}_{2} & 2{x}_{3}\\end{aligned}]\\in {R}^{1\\times 3}.\\end{aligned}\n$$\n\nWe can also write this as\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=2{x}^{T}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203389 :answer-field/correct "answer-ff6fd27f-675e-55fe-8e51-a1443e1cde27" :answer-field/choices ["answer-ff6fd27f-675e-55fe-8e51-a1443e1cde27" "answer-28fad7c5-7710-53c9-96dc-3a22b189fd28" "answer-36ecfad0-45a6-5a26-931b-31fd7b5c023f"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff6fd27f-675e-55fe-8e51-a1443e1cde27" :answer/id #uuid "ff6fd27f-675e-55fe-8e51-a1443e1cde27" :answer/type :answer.type/math :answer/value "2{x}^{T}" :db/ensure [:answer/validate]} {:db/id "answer-28fad7c5-7710-53c9-96dc-3a22b189fd28" :answer/id #uuid "28fad7c5-7710-53c9-96dc-3a22b189fd28" :answer/type :answer.type/math :answer/value "x{x}^{T}" :db/ensure [:answer/validate]} {:db/id "answer-36ecfad0-45a6-5a26-931b-31fd7b5c023f" :answer/id #uuid "36ecfad0-45a6-5a26-931b-31fd7b5c023f" :answer/type :answer.type/math :answer/value "{x}^{T}x" :db/ensure [:answer/validate]} {:db/id 17592186204579 :question/problem "Consider the function $f,$ defined as \n\n$$\nf(x)=[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}].\n$$\n\nWhat is the shape of the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a vector-valued function $f:R\\to {R}^{m}$ with respect to a scalar $x$ is the column vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ ⋮ \\\\ \\frac{∂{f}_{m}}{∂x}\\end{aligned}]\\in {R}^{m\\times 1}.\n$$\n\nIn our case, the function \n\n- acts on a scalar $x\\in R,$ and\n\n- outputs a vector $f(x)\\in {R}^{2}.$\n\nTherefore, the total derivative will be a column vector of shape $2\\times 1.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203407 :answer-field/correct "answer-7fc4f1f8-61e0-5902-87da-4c880d27639d" :answer-field/choices ["answer-7fc4f1f8-61e0-5902-87da-4c880d27639d" "answer-886bd58a-d2a1-58c4-85bb-21bcd3179800" "answer-89f6a51d-2ad5-50de-abf7-2ae76d9a88e1" "answer-ec5950a8-970d-5df3-b935-f039ec4c769a"] :db/ensure [:answer-field/validate]} {:db/id "answer-7fc4f1f8-61e0-5902-87da-4c880d27639d" :answer/id #uuid "7fc4f1f8-61e0-5902-87da-4c880d27639d" :answer/type :answer.type/text :answer/value "a column vector of shape $2\\times 1$" :db/ensure [:answer/validate]} {:db/id "answer-886bd58a-d2a1-58c4-85bb-21bcd3179800" :answer/id #uuid "886bd58a-d2a1-58c4-85bb-21bcd3179800" :answer/type :answer.type/text :answer/value "a matrix of shape $1\\times 1$" :db/ensure [:answer/validate]} {:db/id "answer-89f6a51d-2ad5-50de-abf7-2ae76d9a88e1" :answer/id #uuid "89f6a51d-2ad5-50de-abf7-2ae76d9a88e1" :answer/type :answer.type/text :answer/value "a matrix of shape $2\\times 2$" :db/ensure [:answer/validate]} {:db/id "answer-ec5950a8-970d-5df3-b935-f039ec4c769a" :answer/id #uuid "ec5950a8-970d-5df3-b935-f039ec4c769a" :answer/type :answer.type/text :answer/value "a row vector of shape $1\\times 2$" :db/ensure [:answer/validate]} {:db/id "question-ee17a4e4-1d8d-5373-a5f7-48bfde731f73" :question/id #uuid "ee17a4e4-1d8d-5373-a5f7-48bfde731f73" :question/math-academy-id "q-269516" :question/problem "Consider the function $f:R\\to {R}^{4},$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & 1 \\\\ 3 & 0 \\\\ 4 & -5 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ 2\\end{aligned}].\n$$\n\nWhat is the total derivative of $f$ with respect to $x?$" :question/worked-solution "The total derivative of a vector-valued function $f:R\\to {R}^{m}$ with respect to a scalar $x$ is the column vector\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ ⋮ \\\\ \\frac{∂{f}_{m}}{∂x}\\end{aligned}]\\in {R}^{m\\times 1}.\n$$\n\nIn our case, the function \n\n- acts on a scalar $x\\in R,$ and\n\n- outputs a vector $f(x)\\in {R}^{4}$ defined by \n\n$$\n\\begin{aligned}f(x)=[\\begin{aligned}1 & 1 \\\\ 3 & 0 \\\\ 4 & -5 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ 2\\end{aligned}] & =[\\begin{aligned}x+2 \\\\ 3x \\\\ 4x-10 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} \\\\ \\frac{∂{f}_{2}}{∂x} \\\\ \\frac{∂{f}_{3}}{∂x} \\\\ \\frac{∂{f}_{4}}{∂x}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(x+2) \\\\ \\frac{∂}{∂x}(3x) \\\\ \\frac{∂}{∂x}(4x-10) \\\\ \\frac{∂}{∂x}(6)\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]\\in {R}^{4\\times 1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c80c0f77-3e67-5a7e-8ad6-7ef450e73970"] :db/ensure [:question/validate]} {:db/id "answer-field-c80c0f77-3e67-5a7e-8ad6-7ef450e73970" :answer-field/id #uuid "c80c0f77-3e67-5a7e-8ad6-7ef450e73970" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-014d9c3e-1663-5259-9277-a7bbddf6e2fb" :answer-field/choices ["answer-def4b6c6-b6f4-5d5a-8261-aa0965a945ee" "answer-e11583b8-4e30-5e78-b665-3691a908779c" "answer-34bbe26e-bcba-5583-9c68-b3f83a035eb2" "answer-014d9c3e-1663-5259-9277-a7bbddf6e2fb" "answer-e681a790-14d2-5d84-85a8-796a2c566dbb"] :db/ensure [:answer-field/validate]} {:db/id "answer-def4b6c6-b6f4-5d5a-8261-aa0965a945ee" :answer/id #uuid "def4b6c6-b6f4-5d5a-8261-aa0965a945ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & -5 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-e11583b8-4e30-5e78-b665-3691a908779c" :answer/id #uuid "e11583b8-4e30-5e78-b665-3691a908779c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 4 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-34bbe26e-bcba-5583-9c68-b3f83a035eb2" :answer/id #uuid "34bbe26e-bcba-5583-9c68-b3f83a035eb2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ -5 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-014d9c3e-1663-5259-9277-a7bbddf6e2fb" :answer/id #uuid "014d9c3e-1663-5259-9277-a7bbddf6e2fb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-e681a790-14d2-5d84-85a8-796a2c566dbb" :answer/id #uuid "e681a790-14d2-5d84-85a8-796a2c566dbb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ 3x \\\\ -5x \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-67046761-6838-5e5c-bd1f-8e1ae02d3dbf" :question/id #uuid "67046761-6838-5e5c-bd1f-8e1ae02d3dbf" :question/math-academy-id "q-269555" :question/problem "Consider the vector-valued function $f:{R}^{3}\\to {R}^{3}$ defined by\n\n$$\nf(x)=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]x.\n$$\n\n \n\nWhat is $\\frac{\\text{d}f}{\\text{d}x},$ the total derivative of $f$ with respect to $x$ at ${x}_{0}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]?$" :question/worked-solution "The total derivative of a vector-valued function $f:{R}^{n}\\to {R}^{m}$ with respect to a vector $x\\in {R}^{n}$ is the $m\\times n$ matrix\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}]\\in {R}^{m\\times n}.\n$$\n\nIn our case, writing out the function $f(x)$ where $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\in {R}^{3}$, we get\n\n$$\nf(x)=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {x}_{1}+{x}_{3} \\\\ {x}_{2}+{x}_{3}\\end{aligned}].\n$$\n\nSo, the total derivative is\n\n$$\n\\begin{aligned}\\,\\,\\,\\frac{\\text{d}f}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & \\frac{∂{f}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & \\frac{∂{f}_{2}}{∂{x}_{3}} \\\\ \\frac{∂{f}_{3}}{∂{x}_{1}} & \\frac{∂{f}_{3}}{∂{x}_{2}} & \\frac{∂{f}_{3}}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{3}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{2}+{x}_{3})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSince the total derivative is a constant matrix, evaluating it at ${x}_{0}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]$ gives the same matrix." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-11c166e6-1f28-5e02-9955-3d8f3525359c"] :db/ensure [:question/validate]} {:db/id "answer-field-11c166e6-1f28-5e02-9955-3d8f3525359c" :answer-field/id #uuid "11c166e6-1f28-5e02-9955-3d8f3525359c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-52208163-567f-5131-b309-cfa086f0b55e" :answer-field/choices ["answer-4ea1e5d3-2f94-5af0-9b2b-dbe977709a27" "answer-ffe8c4b7-c3a3-5549-b3d0-a5b9714b08d3" "answer-17f51f1a-4d67-51a2-a688-b61e6a787b32" "answer-52208163-567f-5131-b309-cfa086f0b55e" "answer-2e584046-9915-5986-8dd3-f1cf10ec80b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ea1e5d3-2f94-5af0-9b2b-dbe977709a27" :answer/id #uuid "4ea1e5d3-2f94-5af0-9b2b-dbe977709a27" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ffe8c4b7-c3a3-5549-b3d0-a5b9714b08d3" :answer/id #uuid "ffe8c4b7-c3a3-5549-b3d0-a5b9714b08d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-17f51f1a-4d67-51a2-a688-b61e6a787b32" :answer/id #uuid "17f51f1a-4d67-51a2-a688-b61e6a787b32" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-52208163-567f-5131-b309-cfa086f0b55e" :answer/id #uuid "52208163-567f-5131-b309-cfa086f0b55e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2e584046-9915-5986-8dd3-f1cf10ec80b4" :answer/id #uuid "2e584046-9915-5986-8dd3-f1cf10ec80b4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186204078 :knowledge-point/questions ["question-20f2946c-2b05-548e-8d4f-c195e7f5a6e5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-20f2946c-2b05-548e-8d4f-c195e7f5a6e5" :question/id #uuid "20f2946c-2b05-548e-8d4f-c195e7f5a6e5" :question/math-academy-id "q-269858" :question/problem "Consider a function $f:{R}^{3\\times 3}\\to {R}^{3}$ defined by\n\n$$\nf(A)=A[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}].\n$$\n\nGiven that ${a}_{ij}$ denotes the entry of $A$ in the intersection of the $i$th row and $j$th column, we have\n\n$\\frac{∂{f}_{3}}{∂{a}_{31}}=${{field-1}}." :question/worked-solution "We can write the function $f$ as\n\n$$\nf(A)=[\\begin{aligned}{a}_{11} & {a}_{12} & {a}_{13} \\\\ {a}_{21} & {a}_{22} & {a}_{23} \\\\ {a}_{31} & {a}_{32} & {a}_{33}\\end{aligned}][\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]=[\\begin{aligned}2{a}_{11}+3{a}_{12}-{a}_{13} \\\\ 2{a}_{21}+3{a}_{22}-{a}_{23} \\\\ 2{a}_{31}+3{a}_{32}-{a}_{33}\\end{aligned}].\n$$\n\nThus,\n\n$$\n\\frac{∂{f}_{3}}{∂{a}_{31}}=\\frac{∂}{∂{a}_{31}}(2{a}_{31}+3{a}_{32}-{a}_{33})=2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-496c72b0-90f2-51f5-a462-e8c20d943af2"] :db/ensure [:question/validate]} {:db/id "answer-field-496c72b0-90f2-51f5-a462-e8c20d943af2" :answer-field/id #uuid "496c72b0-90f2-51f5-a462-e8c20d943af2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f6cf4237-3068-5ef2-966f-556a26a2b8cb" :answer-field/choices ["answer-f6cf4237-3068-5ef2-966f-556a26a2b8cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6cf4237-3068-5ef2-966f-556a26a2b8cb" :answer/id #uuid "f6cf4237-3068-5ef2-966f-556a26a2b8cb" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "activity-c90a6945-859b-55ba-8539-f8f5fc69e031" :activity/id #uuid "c90a6945-859b-55ba-8539-f8f5fc69e031" :activity/title "Total and Tensor Derivatives" :activity/type :activity.type/review :activity/scope 17592186050940 :activity/course 17592186046658 :activity/steps ["step-77f86be7-dd12-584e-b354-ecf9e0375cee" "step-ceaf80b9-2e1d-5b78-946c-a77a528f9445" "step-54f4cfdc-4e79-588a-b324-d92edafe0a57" "step-af19e67d-7aed-57c3-8603-6dcf4cb7a6aa" "step-62c410ab-c0af-598a-a7a3-56564b714e17"] :activity/first-step "step-77f86be7-dd12-584e-b354-ecf9e0375cee" :db/ensure [:activity/validate]} {:db/id "step-77f86be7-dd12-584e-b354-ecf9e0375cee" :step/id #uuid "77f86be7-dd12-584e-b354-ecf9e0375cee" :step/content 17592186204576 :step/next "step-ceaf80b9-2e1d-5b78-946c-a77a528f9445" :db/ensure [:step/validate]} {:db/id "step-ceaf80b9-2e1d-5b78-946c-a77a528f9445" :step/id #uuid "ceaf80b9-2e1d-5b78-946c-a77a528f9445" :step/content 17592186204579 :step/next "step-54f4cfdc-4e79-588a-b324-d92edafe0a57" :db/ensure [:step/validate]} {:db/id "step-54f4cfdc-4e79-588a-b324-d92edafe0a57" :step/id #uuid "54f4cfdc-4e79-588a-b324-d92edafe0a57" :step/content "question-ee17a4e4-1d8d-5373-a5f7-48bfde731f73" :step/next "step-af19e67d-7aed-57c3-8603-6dcf4cb7a6aa" :db/ensure [:step/validate]} {:db/id "step-af19e67d-7aed-57c3-8603-6dcf4cb7a6aa" :step/id #uuid "af19e67d-7aed-57c3-8603-6dcf4cb7a6aa" :step/content "question-67046761-6838-5e5c-bd1f-8e1ae02d3dbf" :step/next "step-62c410ab-c0af-598a-a7a3-56564b714e17" :db/ensure [:step/validate]} {:db/id "step-62c410ab-c0af-598a-a7a3-56564b714e17" :step/id #uuid "62c410ab-c0af-598a-a7a3-56564b714e17" :step/content "question-20f2946c-2b05-548e-8d4f-c195e7f5a6e5" :db/ensure [:step/validate]} {:db/id "activity-343fca05-ef20-5032-a174-293eb482d135" :activity/id #uuid "343fca05-ef20-5032-a174-293eb482d135" :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type :activity.type/review :activity/scope 17592186048694 :activity/course 17592186046645 :activity/steps ["step-cff504a2-c9ea-54e0-9986-3bc79b8ba652" "step-56b6eb2f-f882-5b90-8451-f36f99d1a425" "step-03a6d759-775d-52bf-9cdd-3d6f87176b4d" "step-e6a58846-3aca-5935-a953-b68daf8654c7" "step-8db4ff3c-fb25-5ac9-a56d-8b7415b7e2ed"] :activity/first-step "step-cff504a2-c9ea-54e0-9986-3bc79b8ba652" :db/ensure [:activity/validate]} {:db/id "step-cff504a2-c9ea-54e0-9986-3bc79b8ba652" :step/id #uuid "cff504a2-c9ea-54e0-9986-3bc79b8ba652" :step/content 17592186152740 :step/next "step-56b6eb2f-f882-5b90-8451-f36f99d1a425" :db/ensure [:step/validate]} {:db/id "step-56b6eb2f-f882-5b90-8451-f36f99d1a425" :step/id #uuid "56b6eb2f-f882-5b90-8451-f36f99d1a425" :step/content 17592186152743 :step/next "step-03a6d759-775d-52bf-9cdd-3d6f87176b4d" :db/ensure [:step/validate]} {:db/id "step-03a6d759-775d-52bf-9cdd-3d6f87176b4d" :step/id #uuid "03a6d759-775d-52bf-9cdd-3d6f87176b4d" :step/content 17592186483379 :step/next "step-e6a58846-3aca-5935-a953-b68daf8654c7" :db/ensure [:step/validate]} {:db/id "step-e6a58846-3aca-5935-a953-b68daf8654c7" :step/id #uuid "e6a58846-3aca-5935-a953-b68daf8654c7" :step/content 17592186497344 :step/next "step-8db4ff3c-fb25-5ac9-a56d-8b7415b7e2ed" :db/ensure [:step/validate]} {:db/id "step-8db4ff3c-fb25-5ac9-a56d-8b7415b7e2ed" :step/id #uuid "8db4ff3c-fb25-5ac9-a56d-8b7415b7e2ed" :step/content 17592186284545 :db/ensure [:step/validate]} [:db/retract 17592186203395 :answer-field/choices 17592186203396] [:db/retract 17592186203395 :answer-field/choices 17592186203397] [:db/retract 17592186203395 :answer-field/choices 17592186203398] [:db/retract 17592186203395 :answer-field/choices 17592186203399] [:db/retract 17592186203395 :answer-field/choices 17592186203400] [:db/retract 17592186203461 :answer-field/choices 17592186203462] [:db/retract 17592186203461 :answer-field/choices 17592186203463] [:db/retract 17592186203461 :answer-field/choices 17592186203464] [:db/retract 17592186203461 :answer-field/choices 17592186203465] [:db/retract 17592186203461 :answer-field/choices 17592186203466] {:db/id 17592186204577 :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}^{2} \\\\ {y}_{2}^{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}5 & 1 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}2{y}_{1} & 0 \\\\ 0 & 2{y}_{2}\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 3\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}2(1) & 0 \\\\ 0 & 2(3)\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & 6\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}5 & 1 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 \\\\ 0 & 6\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 6 \\\\ 0 & 6\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}28 & 44 \\\\ 18 & 24\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203395 :answer-field/correct "answer-4197df66-afcb-5d6f-962d-7c1c812afe7f" :answer-field/choices ["answer-e95f7afe-3c38-53ed-8952-94c6506a6fd0" "answer-42677020-e248-53b0-b94f-e0ebc6c2437f" "answer-2788ba22-a227-53f4-90dd-d5c352334ed1" "answer-4197df66-afcb-5d6f-962d-7c1c812afe7f" "answer-5dfb5629-98bc-54e5-b45f-e48d0667cc5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e95f7afe-3c38-53ed-8952-94c6506a6fd0" :answer/id #uuid "e95f7afe-3c38-53ed-8952-94c6506a6fd0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 & 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-42677020-e248-53b0-b94f-e0ebc6c2437f" :answer/id #uuid "42677020-e248-53b0-b94f-e0ebc6c2437f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 \\\\ 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2788ba22-a227-53f4-90dd-d5c352334ed1" :answer/id #uuid "2788ba22-a227-53f4-90dd-d5c352334ed1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 18 \\\\ 44 & 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4197df66-afcb-5d6f-962d-7c1c812afe7f" :answer/id #uuid "4197df66-afcb-5d6f-962d-7c1c812afe7f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}28 & 44 \\\\ 18 & 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5dfb5629-98bc-54e5-b45f-e48d0667cc5f" :answer/id #uuid "5dfb5629-98bc-54e5-b45f-e48d0667cc5f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 18 \\\\ 44 & 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186204099 :knowledge-point/questions ["question-5cda63cf-1401-57bf-8fcd-cd3ff96bbaac" "question-fcdd0ff0-12c7-557b-8715-01260bbcae30"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5cda63cf-1401-57bf-8fcd-cd3ff96bbaac" :question/id #uuid "5cda63cf-1401-57bf-8fcd-cd3ff96bbaac" :question/math-academy-id "q-269771" :question/problem "Consider the functions $y:{R}^{3}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{2},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{1}{x}_{2}+{x}_{3} \\\\ {x}_{1}+{x}_{2}{x}_{3}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}-{y}_{2} \\\\ {y}_{1}^{2}+{y}_{2}^{2}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$38$</td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\">$34$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}-{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}-{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 2{y}_{1} & 2{y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}3\\cdot 2+1 \\\\ 3+2\\cdot 1\\end{aligned}]=[\\begin{aligned}7 \\\\ 5\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & -1 \\\\ 14 & 10\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 3$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} & \\frac{∂{y}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}} & \\frac{∂{y}_{2}}{∂{x}_{3}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{1}{x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}{x}_{2}+{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}{x}_{2}+{x}_{3}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}{x}_{3}) & \\frac{∂}{∂{x}_{3}}({x}_{1}+{x}_{2}{x}_{3})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{2} & {x}_{1} & 1 \\\\ 1 & {x}_{3} & {x}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}2 & 3 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}1 & -1 \\\\ 14 & 10\\end{aligned}]\\cdot [\\begin{aligned}2 & 3 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 & -1 \\\\ 38 & 52 & 34\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5d9e42c8-0cba-572d-9f30-e6b7d5256db3" "answer-field-471955d2-cf1e-544f-a5b9-3b7a749224a4" "answer-field-257b8b19-6314-524b-8139-d750cd288bc1" "answer-field-191b1726-7502-57e5-8681-508d29bd4ba6"] :db/ensure [:question/validate]} {:db/id "answer-field-5d9e42c8-0cba-572d-9f30-e6b7d5256db3" :answer-field/id #uuid "5d9e42c8-0cba-572d-9f30-e6b7d5256db3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0da613c8-85a1-597d-9c8a-132534b88588" :answer-field/choices ["answer-0da613c8-85a1-597d-9c8a-132534b88588"] :db/ensure [:answer-field/validate]} {:db/id "answer-0da613c8-85a1-597d-9c8a-132534b88588" :answer/id #uuid "0da613c8-85a1-597d-9c8a-132534b88588" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-471955d2-cf1e-544f-a5b9-3b7a749224a4" :answer-field/id #uuid "471955d2-cf1e-544f-a5b9-3b7a749224a4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5d05f48b-5b8f-51bc-a0be-e159bb5f3fe4" :answer-field/choices ["answer-5d05f48b-5b8f-51bc-a0be-e159bb5f3fe4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d05f48b-5b8f-51bc-a0be-e159bb5f3fe4" :answer/id #uuid "5d05f48b-5b8f-51bc-a0be-e159bb5f3fe4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-257b8b19-6314-524b-8139-d750cd288bc1" :answer-field/id #uuid "257b8b19-6314-524b-8139-d750cd288bc1" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c1b1d727-65f5-5ca5-a7ee-9b549c4b6edb" :answer-field/choices ["answer-c1b1d727-65f5-5ca5-a7ee-9b549c4b6edb"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1b1d727-65f5-5ca5-a7ee-9b549c4b6edb" :answer/id #uuid "c1b1d727-65f5-5ca5-a7ee-9b549c4b6edb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-191b1726-7502-57e5-8681-508d29bd4ba6" :answer-field/id #uuid "191b1726-7502-57e5-8681-508d29bd4ba6" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c87d8c03-c654-5fd1-a126-474ec7651a64" :answer-field/choices ["answer-c87d8c03-c654-5fd1-a126-474ec7651a64"] :db/ensure [:answer-field/validate]} {:db/id "answer-c87d8c03-c654-5fd1-a126-474ec7651a64" :answer/id #uuid "c87d8c03-c654-5fd1-a126-474ec7651a64" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id 17592186204100 :knowledge-point/questions ["question-3c639ae0-88c7-55de-8084-a7f89ff7f5c1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3c639ae0-88c7-55de-8084-a7f89ff7f5c1" :question/id #uuid "3c639ae0-88c7-55de-8084-a7f89ff7f5c1" :question/math-academy-id "q-269808" :question/problem "Consider the functions $y(x)=Ax$ and $f(y)=By,$ where $x\\in {R}^{2},y\\in {R}^{3},$ and the matrices $A$ and $B$ are given by\n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ 3 & 1 \\\\ 2 & -1\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 & -1 \\\\ 4 & 1 & 2\\end{aligned}].\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at ${x}_{0}=[0,\\,1]^{T}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$11$</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{3}$ by multiplying it by $B$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}=B.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{3}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)) & =\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =BA \\\\  & =[\\begin{aligned}3 & 2 & -1 \\\\ 4 & 1 & 2\\end{aligned}][\\begin{aligned}1 & 4 \\\\ 3 & 1 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 15 \\\\ 11 & 15\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ec10a1ed-d3eb-56d7-9ce6-53b27fda1bff" "answer-field-4ad3fdf8-4870-5a95-9eb9-08034d7f4484" "answer-field-1c4bf129-bdba-5c6e-bbb7-519f5f0734c7"] :db/ensure [:question/validate]} {:db/id "answer-field-ec10a1ed-d3eb-56d7-9ce6-53b27fda1bff" :answer-field/id #uuid "ec10a1ed-d3eb-56d7-9ce6-53b27fda1bff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-152e565a-1b64-57b8-9102-58174f36409c" :answer-field/choices ["answer-152e565a-1b64-57b8-9102-58174f36409c"] :db/ensure [:answer-field/validate]} {:db/id "answer-152e565a-1b64-57b8-9102-58174f36409c" :answer/id #uuid "152e565a-1b64-57b8-9102-58174f36409c" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-4ad3fdf8-4870-5a95-9eb9-08034d7f4484" :answer-field/id #uuid "4ad3fdf8-4870-5a95-9eb9-08034d7f4484" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ab33217-b058-5d85-ae73-223d6b5d2494" :answer-field/choices ["answer-9ab33217-b058-5d85-ae73-223d6b5d2494"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ab33217-b058-5d85-ae73-223d6b5d2494" :answer/id #uuid "9ab33217-b058-5d85-ae73-223d6b5d2494" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-field-1c4bf129-bdba-5c6e-bbb7-519f5f0734c7" :answer-field/id #uuid "1c4bf129-bdba-5c6e-bbb7-519f5f0734c7" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-45db1775-d75f-5a32-bf4e-5588c6baa812" :answer-field/choices ["answer-45db1775-d75f-5a32-bf4e-5588c6baa812"] :db/ensure [:answer-field/validate]} {:db/id "answer-45db1775-d75f-5a32-bf4e-5588c6baa812" :answer/id #uuid "45db1775-d75f-5a32-bf4e-5588c6baa812" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id 17592186204591 :question/problem "For $x,y,z\\in {R}^{2},$ consider the following functions: \n\n$$\n\\begin{aligned} & y(x)=Ax\\,\\text{where}\\,A=[\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}] \\\\  & z(y)=[\\begin{aligned}{y}_{1}{y}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] \\\\  & f(z)=Cz\\,\\text{where}\\,C=[\\begin{aligned}4 & 2 \\\\ 1 & 5\\end{aligned}]\\end{aligned}\n$$\n\nWhat is $\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))$ evaluated at ${x}_{0}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]?$" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=[\\begin{aligned}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{aligned}]=[\\begin{aligned}{y}_{2} & {y}_{1} \\\\ 1 & 1\\end{aligned}].\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=[\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}0 & -1 \\\\ 1 & 1\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}4 & 2 \\\\ 1 & 5\\end{aligned}]\\cdot [\\begin{aligned}0 & -1 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 5 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ 13 & -5\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203461 :answer-field/correct "answer-9dad7b7a-24bc-54dd-bf88-cecd2bf2af0f" :answer-field/choices ["answer-9dad7b7a-24bc-54dd-bf88-cecd2bf2af0f" "answer-fbee7505-987c-5333-93f7-661169d5017b" "answer-75e16740-fbdd-57ed-b571-10c98418d67b" "answer-a5f5e832-398a-584d-84e2-7d3d4ee0dd04" "answer-81877da1-dbe1-5138-92b4-f3362fecddd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dad7b7a-24bc-54dd-bf88-cecd2bf2af0f" :answer/id #uuid "9dad7b7a-24bc-54dd-bf88-cecd2bf2af0f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -2 \\\\ 13 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fbee7505-987c-5333-93f7-661169d5017b" :answer/id #uuid "fbee7505-987c-5333-93f7-661169d5017b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & 3 \\\\ 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-75e16740-fbdd-57ed-b571-10c98418d67b" :answer/id #uuid "75e16740-fbdd-57ed-b571-10c98418d67b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 \\\\ -2 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a5f5e832-398a-584d-84e2-7d3d4ee0dd04" :answer/id #uuid "a5f5e832-398a-584d-84e2-7d3d4ee0dd04" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -2 \\\\ -13 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-81877da1-dbe1-5138-92b4-f3362fecddd9" :answer/id #uuid "81877da1-dbe1-5138-92b4-f3362fecddd9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & -2 \\\\ 0 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-fcdd0ff0-12c7-557b-8715-01260bbcae30" :question/id #uuid "fcdd0ff0-12c7-557b-8715-01260bbcae30" :question/math-academy-id "q-270275" :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{3},$ defined by\n\n$$\ny(x)=[\\begin{aligned}{x}_{2}-{x}_{1}^{3} \\\\ -{x}_{1}{x}_{2}\\end{aligned}],\\,f(y)=[\\begin{aligned}{y}_{1}-{y}_{2} \\\\ {y}_{2}^{2} \\\\ 2{y}_{1}+{y}_{2}^{3}\\end{aligned}].\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$-3$</td>\n<td align=\"center\" width=\"30px\">$2$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus, the total derivative of $f$ with respect to $y$ is a $3\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =[\\begin{aligned}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{y}_{1}} & \\frac{∂{f}_{3}}{∂{y}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{y}_{1}}({y}_{1}-{y}_{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}-{y}_{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{2}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}(2{y}_{1}+{y}_{2}^{3}) & \\frac{∂}{∂{y}_{2}}(2{y}_{1}+{y}_{2}^{3})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 0 & 2{y}_{2} \\\\ 2 & 3{y}_{2}^{2}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=[\\begin{aligned}0-{1}^{3} \\\\ -1\\cdot 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=[\\begin{aligned}1 & -1 \\\\ 0 & 0 \\\\ 2 & 0\\end{aligned}].\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =[\\begin{aligned}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{1}}({x}_{2}-{x}_{1}^{3}) & \\frac{∂}{∂{x}_{2}}({x}_{2}-{x}_{1}^{3}) \\\\ \\frac{∂}{∂{x}_{1}}(-{x}_{1}{x}_{2}) & \\frac{∂}{∂{x}_{2}}(-{x}_{1}{x}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}-3{x}_{1}^{2} & 1 \\\\ -{x}_{2} & -{x}_{1}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=[\\begin{aligned}-3 & 1 \\\\ 0 & -1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =[\\begin{aligned}1 & -1 \\\\ 0 & 0 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}-3 & 1 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ 0 & 0 \\\\ -6 & 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94b31743-dd24-58bd-b3c9-5a2a72dc5d7a" "answer-field-27e2998c-fb66-52e1-9a0e-14ecb29db474" "answer-field-313f45b7-958c-576f-a02c-e52604f20117"] :db/ensure [:question/validate]} {:db/id "answer-field-94b31743-dd24-58bd-b3c9-5a2a72dc5d7a" :answer-field/id #uuid "94b31743-dd24-58bd-b3c9-5a2a72dc5d7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0e307f5d-2cf8-5149-96d9-4060f3630971" :answer-field/choices ["answer-0e307f5d-2cf8-5149-96d9-4060f3630971"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e307f5d-2cf8-5149-96d9-4060f3630971" :answer/id #uuid "0e307f5d-2cf8-5149-96d9-4060f3630971" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-27e2998c-fb66-52e1-9a0e-14ecb29db474" :answer-field/id #uuid "27e2998c-fb66-52e1-9a0e-14ecb29db474" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8229e779-8e8f-5d38-beed-cefe14383fd0" :answer-field/choices ["answer-8229e779-8e8f-5d38-beed-cefe14383fd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8229e779-8e8f-5d38-beed-cefe14383fd0" :answer/id #uuid "8229e779-8e8f-5d38-beed-cefe14383fd0" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-field-313f45b7-958c-576f-a02c-e52604f20117" :answer-field/id #uuid "313f45b7-958c-576f-a02c-e52604f20117" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b8687a41-891a-5b41-bcf8-26c4e1b21954" :answer-field/choices ["answer-b8687a41-891a-5b41-bcf8-26c4e1b21954"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8687a41-891a-5b41-bcf8-26c4e1b21954" :answer/id #uuid "b8687a41-891a-5b41-bcf8-26c4e1b21954" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "activity-ba72ab32-5851-5ec7-a38d-15b4a3c478f7" :activity/id #uuid "ba72ab32-5851-5ec7-a38d-15b4a3c478f7" :activity/title "The Chain Rule for Total Derivatives" :activity/type :activity.type/review :activity/scope 17592186048367 :activity/course 17592186046658 :activity/steps ["step-f6ca4762-0e9d-50ee-91d0-ecc6cd70edcf" "step-dc89e4d6-0c97-5036-ace4-2cc37cf12dbf" "step-8ad6dc1a-aade-5e56-ba97-f40b26cefb30" "step-1336e42a-6ba6-5fb3-a04f-47a6e4dce174" "step-dd4c11e8-e668-5046-aa77-606d9f41c236"] :activity/first-step "step-f6ca4762-0e9d-50ee-91d0-ecc6cd70edcf" :db/ensure [:activity/validate]} {:db/id "step-f6ca4762-0e9d-50ee-91d0-ecc6cd70edcf" :step/id #uuid "f6ca4762-0e9d-50ee-91d0-ecc6cd70edcf" :step/content 17592186204577 :step/next "step-dc89e4d6-0c97-5036-ace4-2cc37cf12dbf" :db/ensure [:step/validate]} {:db/id "step-dc89e4d6-0c97-5036-ace4-2cc37cf12dbf" :step/id #uuid "dc89e4d6-0c97-5036-ace4-2cc37cf12dbf" :step/content "question-5cda63cf-1401-57bf-8fcd-cd3ff96bbaac" :step/next "step-8ad6dc1a-aade-5e56-ba97-f40b26cefb30" :db/ensure [:step/validate]} {:db/id "step-8ad6dc1a-aade-5e56-ba97-f40b26cefb30" :step/id #uuid "8ad6dc1a-aade-5e56-ba97-f40b26cefb30" :step/content "question-3c639ae0-88c7-55de-8084-a7f89ff7f5c1" :step/next "step-1336e42a-6ba6-5fb3-a04f-47a6e4dce174" :db/ensure [:step/validate]} {:db/id "step-1336e42a-6ba6-5fb3-a04f-47a6e4dce174" :step/id #uuid "1336e42a-6ba6-5fb3-a04f-47a6e4dce174" :step/content 17592186204591 :step/next "step-dd4c11e8-e668-5046-aa77-606d9f41c236" :db/ensure [:step/validate]} {:db/id "step-dd4c11e8-e668-5046-aa77-606d9f41c236" :step/id #uuid "dd4c11e8-e668-5046-aa77-606d9f41c236" :step/content "question-fcdd0ff0-12c7-557b-8715-01260bbcae30" :db/ensure [:step/validate]} {:db/id 17592186373965 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,2u-4v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-2\\le u\\le 0,\\,-1\\le v\\le 5\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(2u-4v)⟩ \\\\  & =⟨1,\\,0,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2u-4v)⟩ \\\\  & =⟨0,\\,1,\\,-4⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2 \\\\ 0 & 1 & -4\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 2 \\\\ 1 & -4\\end{aligned}|,\\,-|\\begin{aligned}1 & 2 \\\\ 0 & -4\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-2,\\,4,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨z+x,\\,y+2z,\\,x-4y⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=2u-4v} \\\\  & =⟨2u-4v+u,\\,v+2(2u-4v),\\,u-4v⟩ \\\\  & =⟨3u-4v,\\,4u-7v,\\,u-4v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3u-4v,\\,4u-7v,\\,u-4v⟩\\cdot ⟨-2,\\,4,\\,1⟩ \\\\  & =(3u-4v)\\cdot (-2)+(4u-7v)\\cdot 4+(u-4v)\\cdot 1 \\\\  & =-6u+8v+16u-28v+u-4v \\\\  & =11u-24v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z+x,\\,y+2z,\\,x-4y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(11u-24v)\\,\\text{d}A \\\\  & ={\\int }_{-2}^{0}{\\int }_{-1}^{5}(11u-24v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-d9e396d1-f035-59a2-b432-277f6bd182ba" :activity/id #uuid "d9e396d1-f035-59a2-b432-277f6bd182ba" :activity/title "Calculating Flux Through Cartesian Surfaces" :activity/type :activity.type/review :activity/scope 17592186048253 :activity/course 17592186046645 :activity/steps ["step-8b341075-9f21-55e2-b6de-970ecf70e05a" "step-a0272ec3-38ba-593f-af8c-885657467439" "step-bfcd2b83-a5f2-52eb-abff-126d7bb1b47b" "step-89beea92-c19b-5b20-850a-a15dc788a7e6" "step-21fd5169-82c4-5c10-9744-f8ffea0e029a"] :activity/first-step "step-8b341075-9f21-55e2-b6de-970ecf70e05a" :db/ensure [:activity/validate]} {:db/id "step-8b341075-9f21-55e2-b6de-970ecf70e05a" :step/id #uuid "8b341075-9f21-55e2-b6de-970ecf70e05a" :step/content 17592186198593 :step/next "step-a0272ec3-38ba-593f-af8c-885657467439" :db/ensure [:step/validate]} {:db/id "step-a0272ec3-38ba-593f-af8c-885657467439" :step/id #uuid "a0272ec3-38ba-593f-af8c-885657467439" :step/content 17592186423123 :step/next "step-bfcd2b83-a5f2-52eb-abff-126d7bb1b47b" :db/ensure [:step/validate]} {:db/id "step-bfcd2b83-a5f2-52eb-abff-126d7bb1b47b" :step/id #uuid "bfcd2b83-a5f2-52eb-abff-126d7bb1b47b" :step/content 17592186373965 :step/next "step-89beea92-c19b-5b20-850a-a15dc788a7e6" :db/ensure [:step/validate]} {:db/id "step-89beea92-c19b-5b20-850a-a15dc788a7e6" :step/id #uuid "89beea92-c19b-5b20-850a-a15dc788a7e6" :step/content 17592186423124 :step/next "step-21fd5169-82c4-5c10-9744-f8ffea0e029a" :db/ensure [:step/validate]} {:db/id "step-21fd5169-82c4-5c10-9744-f8ffea0e029a" :step/id #uuid "21fd5169-82c4-5c10-9744-f8ffea0e029a" :step/content 17592186423122 :db/ensure [:step/validate]} {:db/id 17592186129178 :knowledge-point/questions ["question-278532bd-d5b2-5391-ac62-5dd37f8bae10"] :db/ensure [:knowledge-point/validate]} {:db/id "question-278532bd-d5b2-5391-ac62-5dd37f8bae10" :question/id #uuid "278532bd-d5b2-5391-ac62-5dd37f8bae10" :question/math-academy-id "q-129553" :question/problem "At which points on the surface $z=8{x}^{3}-12xy+{y}^{3}+1$ is the tangent plane horizontal?" :question/worked-solution "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(8{x}^{3}-12xy+{y}^{3}+1) \\\\  & =24{x}^{2}-12y \\\\  & =12(2{x}^{2}-y) \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(8{x}^{3}-12xy+{y}^{3}+1) \\\\  & =-12x+3{y}^{2} \\\\  & =3({y}^{2}-4x)\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨12(2{x}^{2}-y),\\,3({y}^{2}-4x),\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n\\{\\begin{aligned}\\frac{∂f}{∂x}=0 \\\\ \\frac{∂f}{∂y}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}12(2{x}^{2}-y)=0 \\\\ 3({y}^{2}-4x)=0\\end{aligned}\n$$\n\n \n\nFrom the first equation, we get $y=2{x}^{2}.$ Substituting this into the second equation, we obtain\n\n$$\n\\begin{aligned}3({(2{x}^{2})}^{2}-4x) & =0 \\\\ 4{x}^{4}-4x & =0 \\\\ 4x({x}^{3}-1) & =0.\\end{aligned}\n$$\n\nThe solutions of the last equation are $x=0,1.$ So, we have two cases.\n\n- For $x=0,$ we have \n\n$$\ny=2({0}^{2})=0.\n$$\n\nNow, substituting $x=0$ and $y=0$ into our function, we get\n\n$$\nz=8({0}^{3})-12(0)(0)+{0}^{3}+1=1.\n$$\n\nSo, our first point is $(0,0,1).$\n\n- For $x=1,$ we have \n\n$$\ny=2({1}^{2})=2.\n$$\n\nNow, substituting $x=1$ and $y=2$ into our function, we get\n\n$$\nz=8({1}^{3})-12(1)(2)+{2}^{3}+1=-7.\n$$\n\nSo, our second point is $(1,2,-7).$\n\nTherefore, the points where the tangent plane is horizontal are $(0,0,1)$ and $(1,2,-7).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-560ffd1b-5a84-5953-b5a7-cc2f4832a155"] :db/ensure [:question/validate]} {:db/id "answer-field-560ffd1b-5a84-5953-b5a7-cc2f4832a155" :answer-field/id #uuid "560ffd1b-5a84-5953-b5a7-cc2f4832a155" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28af7c9a-9d9e-5376-9c5b-6d7fa5e689d4" :answer-field/choices ["answer-28af7c9a-9d9e-5376-9c5b-6d7fa5e689d4" "answer-84475504-c2ca-5622-a840-6d61ac41fdbd" "answer-9f7c6f53-ab06-5a01-be5d-aa83ddab04f5" "answer-9d9f2d3f-0ff9-53c5-b3cd-a63b7c043f47" "answer-16da06c8-5818-5d83-b103-468e96d457f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-28af7c9a-9d9e-5376-9c5b-6d7fa5e689d4" :answer/id #uuid "28af7c9a-9d9e-5376-9c5b-6d7fa5e689d4" :answer/type :answer.type/text :answer/value "$(0,0,1)$ and $(1,2,-7)$" :db/ensure [:answer/validate]} {:db/id "answer-84475504-c2ca-5622-a840-6d61ac41fdbd" :answer/id #uuid "84475504-c2ca-5622-a840-6d61ac41fdbd" :answer/type :answer.type/text :answer/value "$(0,0,1)$ only" :db/ensure [:answer/validate]} {:db/id "answer-9f7c6f53-ab06-5a01-be5d-aa83ddab04f5" :answer/id #uuid "9f7c6f53-ab06-5a01-be5d-aa83ddab04f5" :answer/type :answer.type/text :answer/value "$(0,2,9)$ and $(1,1,-2)$" :db/ensure [:answer/validate]} {:db/id "answer-9d9f2d3f-0ff9-53c5-b3cd-a63b7c043f47" :answer/id #uuid "9d9f2d3f-0ff9-53c5-b3cd-a63b7c043f47" :answer/type :answer.type/text :answer/value "$(0,2,9)$ only" :db/ensure [:answer/validate]} {:db/id "answer-16da06c8-5818-5d83-b103-468e96d457f3" :answer/id #uuid "16da06c8-5818-5d83-b103-468e96d457f3" :answer/type :answer.type/text :answer/value "$(1,1,-2)$ only" :db/ensure [:answer/validate]} {:db/id "activity-54d27f54-889d-5c5d-83de-87ccc0d716e1" :activity/id #uuid "54d27f54-889d-5c5d-83de-87ccc0d716e1" :activity/title "Tangent Planes to Surfaces" :activity/type :activity.type/review :activity/scope 17592186050293 :activity/course 17592186046658 :activity/steps ["step-f1913391-3335-5bf3-ba14-e044d24b9294" "step-4ceff0c8-08e1-5f7b-8d92-4c7255be7291" "step-3a247dce-1016-5a74-8aa3-baeeb529100f" "step-9423629b-5335-5a54-8c35-42763251427c" "step-2b5d0276-eb2f-5df6-bfcf-46f02d9b5cdd"] :activity/first-step "step-f1913391-3335-5bf3-ba14-e044d24b9294" :db/ensure [:activity/validate]} {:db/id "step-f1913391-3335-5bf3-ba14-e044d24b9294" :step/id #uuid "f1913391-3335-5bf3-ba14-e044d24b9294" :step/content 17592186385585 :step/next "step-4ceff0c8-08e1-5f7b-8d92-4c7255be7291" :db/ensure [:step/validate]} {:db/id "step-4ceff0c8-08e1-5f7b-8d92-4c7255be7291" :step/id #uuid "4ceff0c8-08e1-5f7b-8d92-4c7255be7291" :step/content 17592186403724 :step/next "step-3a247dce-1016-5a74-8aa3-baeeb529100f" :db/ensure [:step/validate]} {:db/id "step-3a247dce-1016-5a74-8aa3-baeeb529100f" :step/id #uuid "3a247dce-1016-5a74-8aa3-baeeb529100f" :step/content 17592186265736 :step/next "step-9423629b-5335-5a54-8c35-42763251427c" :db/ensure [:step/validate]} {:db/id "step-9423629b-5335-5a54-8c35-42763251427c" :step/id #uuid "9423629b-5335-5a54-8c35-42763251427c" :step/content "question-278532bd-d5b2-5391-ac62-5dd37f8bae10" :step/next "step-2b5d0276-eb2f-5df6-bfcf-46f02d9b5cdd" :db/ensure [:step/validate]} {:db/id "step-2b5d0276-eb2f-5df6-bfcf-46f02d9b5cdd" :step/id #uuid "2b5d0276-eb2f-5df6-bfcf-46f02d9b5cdd" :step/content 17592186435553 :db/ensure [:step/validate]} [:db/retract 17592186167126 :question/answer-fields 17592186163834] {:db/id 17592186100884 :knowledge-point/questions ["question-6ff4ab80-f137-5311-afce-bd7745588b1f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ff4ab80-f137-5311-afce-bd7745588b1f" :question/id #uuid "6ff4ab80-f137-5311-afce-bd7745588b1f" :question/math-academy-id "q-100380" :question/problem "${({5}^{2})}^{8}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({5}^{2})}^{8}={5}^{2\\cdot 8}={5}^{16}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-484bbd2f-f0f3-595b-80b3-5e018f4704f6"] :db/ensure [:question/validate]} {:db/id "answer-field-484bbd2f-f0f3-595b-80b3-5e018f4704f6" :answer-field/id #uuid "484bbd2f-f0f3-595b-80b3-5e018f4704f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7ea689a6-5d05-5a18-970a-aa6ffffe514a" :answer-field/choices ["answer-66d0e1b8-9de0-50bc-8350-6ec16a899b0d" "answer-88a4255a-384a-5ba3-a4d1-abf9e134d73c" "answer-7ea689a6-5d05-5a18-970a-aa6ffffe514a" "answer-4f022127-d74b-55a7-8f4c-f8623a061707" "answer-f21b257e-8b46-5f90-97c2-a38980068b7a"] :db/ensure [:answer-field/validate]} {:db/id "answer-66d0e1b8-9de0-50bc-8350-6ec16a899b0d" :answer/id #uuid "66d0e1b8-9de0-50bc-8350-6ec16a899b0d" :answer/type :answer.type/math :answer/value "{5}^{-6}" :db/ensure [:answer/validate]} {:db/id "answer-88a4255a-384a-5ba3-a4d1-abf9e134d73c" :answer/id #uuid "88a4255a-384a-5ba3-a4d1-abf9e134d73c" :answer/type :answer.type/math :answer/value "{5}^{1/4}" :db/ensure [:answer/validate]} {:db/id "answer-7ea689a6-5d05-5a18-970a-aa6ffffe514a" :answer/id #uuid "7ea689a6-5d05-5a18-970a-aa6ffffe514a" :answer/type :answer.type/math :answer/value "{5}^{16}" :db/ensure [:answer/validate]} {:db/id "answer-4f022127-d74b-55a7-8f4c-f8623a061707" :answer/id #uuid "4f022127-d74b-55a7-8f4c-f8623a061707" :answer/type :answer.type/math :answer/value "{5}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-f21b257e-8b46-5f90-97c2-a38980068b7a" :answer/id #uuid "f21b257e-8b46-5f90-97c2-a38980068b7a" :answer/type :answer.type/math :answer/value "{5}^{6}" :db/ensure [:answer/validate]} {:db/id 17592186054836 :knowledge-point/questions ["question-2c9f2909-7e69-5612-95f1-1f03b540b4de"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2c9f2909-7e69-5612-95f1-1f03b540b4de" :question/id #uuid "2c9f2909-7e69-5612-95f1-1f03b540b4de" :question/math-academy-id "q-175591" :question/problem "If $-\\frac{x}{12}=-\\frac{1}{6},$ then $x=${{field-1}}." :question/worked-solution "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{x}{12} & =-\\frac{1}{6} \\\\ (-1)\\cdot (-\\frac{x}{12}) & =(-1)\\cdot (-\\frac{1}{6}) \\\\ \\frac{x}{12} & =\\frac{1}{6}\\end{aligned}\n$$\n\nIn the equation above, $x$ is being divided by $12.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $12.$ So, we multiply both sides of the equation by $12$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{12} & =\\frac{1}{6} \\\\ 12\\cdot \\frac{x}{12} & =12\\cdot \\frac{1}{6} \\\\ \\frac{12x}{12} & =\\frac{12}{6} \\\\ \\frac{\\cancel{12}x}{\\cancel{12}} & =2 \\\\ x & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ffbb06e8-1787-59c8-b541-824a6fbe128b"] :db/ensure [:question/validate]} {:db/id "answer-field-ffbb06e8-1787-59c8-b541-824a6fbe128b" :answer-field/id #uuid "ffbb06e8-1787-59c8-b541-824a6fbe128b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e08ccbd4-8902-537c-bf90-b675fffaa98d" :answer-field/choices ["answer-e08ccbd4-8902-537c-bf90-b675fffaa98d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e08ccbd4-8902-537c-bf90-b675fffaa98d" :answer/id #uuid "e08ccbd4-8902-537c-bf90-b675fffaa98d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186180196 :question/problem "Find the value of $\\sqrt{6}\\cdot \\sqrt{6}.$" :question/worked-solution "First, we re-write the expression as a square:\n\n$$\n\\sqrt{6}\\cdot \\sqrt{6}={(\\sqrt{6})}^{2}.\n$$\n\nThe square and the square root cancel each other out. So, we have\n\n$$\n{(\\sqrt{6})}^{2}=6.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186178720 :answer-field/correct 17592186178724 :db/ensure [:answer-field/validate]} {:db/id 17592186054626 :knowledge-point/questions ["question-00b7055c-6f6b-518a-86a9-ac2dadfdf918" "question-3e848dbc-438d-5d9d-8de6-41c96328b31b" "question-b8991b67-f1ef-53f9-975f-0551777dc4d1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-00b7055c-6f6b-518a-86a9-ac2dadfdf918" :question/id #uuid "00b7055c-6f6b-518a-86a9-ac2dadfdf918" :question/math-academy-id "q-52025" :question/problem "Evaluate $|4y+6{|}^{3}$ for $y=-2.$" :question/worked-solution "We substitute $y=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|4y+6{|}^{3} & = \\\\ |4(-2)+6{|}^{3} & = \\\\ |-8+6{|}^{3} & = \\\\ |-2{|}^{3} & = \\\\ {2}^{3} & = \\\\ 8\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b02a4e9f-a6b5-5fbf-a084-8bd7198a24e8"] :db/ensure [:question/validate]} {:db/id "answer-field-b02a4e9f-a6b5-5fbf-a084-8bd7198a24e8" :a