y/easy :question/answer-fields ["answer-field-757499ed-7641-5b16-b0bb-95a0bd9e7b95"] :db/ensure [:question/validate]} {:db/id "answer-field-757499ed-7641-5b16-b0bb-95a0bd9e7b95" :answer-field/id #uuid "757499ed-7641-5b16-b0bb-95a0bd9e7b95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e47810c3-4772-5842-a46b-a852fe7cbcae" :answer-field/choices ["answer-6ca94c7e-8c18-523a-a529-a59111071887" "answer-5462a3aa-9f86-54d4-a352-bd6bd6a53f4a" "answer-e47810c3-4772-5842-a46b-a852fe7cbcae" "answer-f62fef4f-0550-5c7e-a11f-4215b6ba7721" "answer-b2dd94fc-f52b-5a46-8d85-41edcdfcc5aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ca94c7e-8c18-523a-a529-a59111071887" :answer/id #uuid "6ca94c7e-8c18-523a-a529-a59111071887" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-5462a3aa-9f86-54d4-a352-bd6bd6a53f4a" :answer/id #uuid "5462a3aa-9f86-54d4-a352-bd6bd6a53f4a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-e47810c3-4772-5842-a46b-a852fe7cbcae" :answer/id #uuid "e47810c3-4772-5842-a46b-a852fe7cbcae" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f62fef4f-0550-5c7e-a11f-4215b6ba7721" :answer/id #uuid "f62fef4f-0550-5c7e-a11f-4215b6ba7721" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-b2dd94fc-f52b-5a46-8d85-41edcdfcc5aa" :answer/id #uuid "b2dd94fc-f52b-5a46-8d85-41edcdfcc5aa" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id 17592186115640 :question/problem "Given that $\\operatorname{log}⁡(3x-2)=\\operatorname{log}⁡(8-2x),$ what is the value of $x?$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3x-2) & =\\operatorname{log}⁡(8-2x) \\\\ 3x-2 & =8-2x \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3(2)-2) & \\overset{?}{=}\\operatorname{log}⁡(8-2(2)) \\\\ \\operatorname{log}⁡(4) & =\\operatorname{log}⁡(4)\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186112806 :answer-field/correct 17592186112808 :db/ensure [:answer-field/validate]} {:db/id "question-325f155d-1090-569d-9381-79bbdc699aa8" :question/id #uuid "325f155d-1090-569d-9381-79bbdc699aa8" :question/math-academy-id "q-79872" :question/problem "Solve the equation $\\operatorname{ln}⁡({x}^{2}-2)=\\operatorname{ln}⁡(-x+4).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & =\\operatorname{ln}⁡(-x+4) \\\\ {x}^{2}-2 & =-x+4 \\\\ {x}^{2}+x-6 & =0 \\\\ (x+3)(x-2) & =0 \\\\ x & =-3,2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $x=-3$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-x+4) \\\\ \\operatorname{ln}⁡((-3)^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-(-3)+4) \\\\ \\operatorname{ln}⁡(7) & =\\operatorname{ln}⁡(7).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-3$ is a valid solution.\n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-x+4) \\\\ \\operatorname{ln}⁡((2)^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(-(2)+4) \\\\ \\operatorname{ln}⁡(2) & =\\operatorname{ln}⁡(2).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution.\n\nTherefore, the correct answer is $x=-3,2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fc51f3bc-520a-5e97-9ed8-5e68d0470efe"] :db/ensure [:question/validate]} {:db/id "answer-field-fc51f3bc-520a-5e97-9ed8-5e68d0470efe" :answer-field/id #uuid "fc51f3bc-520a-5e97-9ed8-5e68d0470efe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c88bdaf-a69f-5acf-8c06-2c2f997d3c61" :answer-field/choices ["answer-8e785bed-bb8c-53b7-b495-b0a5fd57b676" "answer-3bc5ead2-d9c3-5f69-9e58-d7c2e6b55c21" "answer-6c88bdaf-a69f-5acf-8c06-2c2f997d3c61" "answer-8610c77a-9a30-5662-bc9a-eb87a713ad40" "answer-00761d95-a4d4-5ce4-8a7e-5d35175bb892"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e785bed-bb8c-53b7-b495-b0a5fd57b676" :answer/id #uuid "8e785bed-bb8c-53b7-b495-b0a5fd57b676" :answer/type :answer.type/text :answer/value "$x=-2$ only" :db/ensure [:answer/validate]} {:db/id "answer-3bc5ead2-d9c3-5f69-9e58-d7c2e6b55c21" :answer/id #uuid "3bc5ead2-d9c3-5f69-9e58-d7c2e6b55c21" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=-2$" :db/ensure [:answer/validate]} {:db/id "answer-6c88bdaf-a69f-5acf-8c06-2c2f997d3c61" :answer/id #uuid "6c88bdaf-a69f-5acf-8c06-2c2f997d3c61" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-8610c77a-9a30-5662-bc9a-eb87a713ad40" :answer/id #uuid "8610c77a-9a30-5662-bc9a-eb87a713ad40" :answer/type :answer.type/text :answer/value "$x=-3$ only" :db/ensure [:answer/validate]} {:db/id "answer-00761d95-a4d4-5ce4-8a7e-5d35175bb892" :answer/id #uuid "00761d95-a4d4-5ce4-8a7e-5d35175bb892" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id 17592186115654 :question/problem "Solve the equation $\\operatorname{ln}⁡(2{x}^{2}-2)=\\operatorname{ln}⁡(3x).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & =\\operatorname{ln}⁡(3x) \\\\ 2{x}^{2}-2 & =3x \\\\ 2{x}^{2}-3x-2 & =0 \\\\ (2x+1)(x-2) & =0 \\\\ x & =-\\frac{1}{2},2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=\\frac{1}{2}$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2\\cdot {(\\frac{1}{2})}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3\\cdot (\\frac{1}{2})) \\\\ \\operatorname{ln}⁡(-\\frac{3}{2}) & \\overset{?}{=}\\operatorname{ln}⁡(\\frac{3}{2})\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because $\\operatorname{ln}⁡(-\\frac{3}{2})$ is undefined. Therefore, $x=-\\frac{1}{2}$ is not a valid solution.\n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2{x}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3x) \\\\ \\operatorname{ln}⁡(2\\cdot {(2)}^{2}-2) & \\overset{?}{=}\\operatorname{ln}⁡(3\\cdot (2)) \\\\ \\operatorname{ln}⁡(6) & =\\operatorname{ln}⁡(6).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution.\n\nTherefore, the correct answer is \"$x=2$ only.\"" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186112890 :answer-field/correct "answer-5fab78db-230a-5484-967e-c80656989093" :answer-field/choices ["answer-ca5402e8-2482-5ba6-ac79-a9aec1cbc11c" "answer-72363bff-e917-5f5a-8dae-8c8430b26d26" "answer-e972a2a6-8440-546c-a253-3f8622a430a0" "answer-5fab78db-230a-5484-967e-c80656989093"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca5402e8-2482-5ba6-ac79-a9aec1cbc11c" :answer/id #uuid "ca5402e8-2482-5ba6-ac79-a9aec1cbc11c" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "answer-72363bff-e917-5f5a-8dae-8c8430b26d26" :answer/id #uuid "72363bff-e917-5f5a-8dae-8c8430b26d26" :answer/type :answer.type/text :answer/value "$x=-\\frac{1}{2}$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-e972a2a6-8440-546c-a253-3f8622a430a0" :answer/id #uuid "e972a2a6-8440-546c-a253-3f8622a430a0" :answer/type :answer.type/text :answer/value "$x=-\\frac{1}{2}$ only" :db/ensure [:answer/validate]} {:db/id "answer-5fab78db-230a-5484-967e-c80656989093" :answer/id #uuid "5fab78db-230a-5484-967e-c80656989093" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "question-b409a03d-9253-56f1-9515-c6248febada5" :question/id #uuid "b409a03d-9253-56f1-9515-c6248febada5" :question/math-academy-id "q-27729" :question/problem "Solve the equation ${log}_{8}⁡({x}^{2}+19x)={log}_{8}⁡(10x-8).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & ={log}_{8}⁡(10x-8) \\\\ {x}^{2}+19x & =10x-8 \\\\ {x}^{2}+9x+8 & =0 \\\\ (x+1)(x+8) & =0 \\\\ x & =-1,-8.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=-1$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & \\overset{?}{=}{log}_{8}⁡(10x-8) \\\\ {log}_{8}⁡((-1)^{2}+19(-1)) & \\overset{?}{=}{log}_{8}⁡(10(-1)-8) \\\\ {log}_{8}⁡(-18) & \\overset{?}{=}{log}_{8}⁡(-18)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because ${log}_{8}⁡(-18)$ is undefined. Therefore, $x=-1$ is not a valid solution.\n\n- Substituting $x=-8$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({x}^{2}+19x) & \\overset{?}{=}{log}_{8}⁡(10x-8) \\\\ {log}_{8}⁡((-8)^{2}+19(-8)) & \\overset{?}{=}{log}_{8}⁡(10(-8)-8) \\\\ {log}_{8}⁡(-88) & \\overset{?}{=}{log}_{8}⁡(-88)\\,\\times \\end{aligned}\n$$\n\nwhich is not valid because ${log}_{8}⁡(-88)$ is undefined. Therefore, $x=-8$ is not a valid solution.\n\nTherefore, the correct answer is \"No solutions.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-54ab10ac-4174-5934-8818-7632587d49cb"] :db/ensure [:question/validate]} {:db/id "answer-field-54ab10ac-4174-5934-8818-7632587d49cb" :answer-field/id #uuid "54ab10ac-4174-5934-8818-7632587d49cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5a947b84-8ada-55d3-ad03-49d9532b991f" :answer-field/choices ["answer-52306a77-dde4-5acb-b5ef-6d1b99a085ff" "answer-c1987a3b-528f-539a-be0c-b67b5536db72" "answer-91b13347-8026-55f4-a9cb-9cb2fff7d699" "answer-0c346939-819e-56f9-9e9d-bad5be5003b0" "answer-5a947b84-8ada-55d3-ad03-49d9532b991f"] :db/ensure [:answer-field/validate]} {:db/id "answer-52306a77-dde4-5acb-b5ef-6d1b99a085ff" :answer/id #uuid "52306a77-dde4-5acb-b5ef-6d1b99a085ff" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=-8$" :db/ensure [:answer/validate]} {:db/id "answer-c1987a3b-528f-539a-be0c-b67b5536db72" :answer/id #uuid "c1987a3b-528f-539a-be0c-b67b5536db72" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=8$" :db/ensure [:answer/validate]} {:db/id "answer-91b13347-8026-55f4-a9cb-9cb2fff7d699" :answer/id #uuid "91b13347-8026-55f4-a9cb-9cb2fff7d699" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-0c346939-819e-56f9-9e9d-bad5be5003b0" :answer/id #uuid "0c346939-819e-56f9-9e9d-bad5be5003b0" :answer/type :answer.type/text :answer/value "$x=-8$ only" :db/ensure [:answer/validate]} {:db/id "answer-5a947b84-8ada-55d3-ad03-49d9532b991f" :answer/id #uuid "5a947b84-8ada-55d3-ad03-49d9532b991f" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id "question-98df2a56-4669-5921-84a6-4e54451b6791" :question/id #uuid "98df2a56-4669-5921-84a6-4e54451b6791" :question/math-academy-id "q-1131" :question/problem "Solve the equation ${log}_{12}⁡({v}^{2}+35)={log}_{12}⁡(-12v-1).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{12}⁡({v}^{2}+35) & ={log}_{12}⁡(-12v-1) \\\\ {v}^{2}+35 & =-12v-1 \\\\ {v}^{2}+12v+36 & =0 \\\\ (v+6)^{2} & =0 \\\\ v & =-6.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $v=-6$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{12}⁡({v}^{2}+35) & \\overset{?}{=}{log}_{12}⁡(-12v-1) \\\\ {log}_{12}⁡((-6)^{2}+35) & \\overset{?}{=}{log}_{12}⁡(-12(-6)-1) \\\\ {log}_{12}⁡(71) & ={log}_{12}⁡(71).\\,✓\\end{aligned}\n$$\n\nTherefore, $v=-6$ is a valid solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b87ce471-30f2-56c2-afaf-a050300cb9c5"] :db/ensure [:question/validate]} {:db/id "answer-field-b87ce471-30f2-56c2-afaf-a050300cb9c5" :answer-field/id #uuid "b87ce471-30f2-56c2-afaf-a050300cb9c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27ac4eb7-866d-591b-99fd-4e95d4aa9bc3" :answer-field/choices ["answer-6f849d03-4388-5222-bb73-a0d236018103" "answer-27ac4eb7-866d-591b-99fd-4e95d4aa9bc3" "answer-1007ddbe-c62c-5841-8280-8935b703fe12" "answer-0a641869-5b2a-5c93-8fec-70c216419ece" "answer-abc230ef-4240-534b-bd00-d63ca4cdb3ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f849d03-4388-5222-bb73-a0d236018103" :answer/id #uuid "6f849d03-4388-5222-bb73-a0d236018103" :answer/type :answer.type/math :answer/value "v=-12" :db/ensure [:answer/validate]} {:db/id "answer-27ac4eb7-866d-591b-99fd-4e95d4aa9bc3" :answer/id #uuid "27ac4eb7-866d-591b-99fd-4e95d4aa9bc3" :answer/type :answer.type/math :answer/value "v=-6" :db/ensure [:answer/validate]} {:db/id "answer-1007ddbe-c62c-5841-8280-8935b703fe12" :answer/id #uuid "1007ddbe-c62c-5841-8280-8935b703fe12" :answer/type :answer.type/math :answer/value "v=12" :db/ensure [:answer/validate]} {:db/id "answer-0a641869-5b2a-5c93-8fec-70c216419ece" :answer/id #uuid "0a641869-5b2a-5c93-8fec-70c216419ece" :answer/type :answer.type/math :answer/value "v=3" :db/ensure [:answer/validate]} {:db/id "answer-abc230ef-4240-534b-bd00-d63ca4cdb3ee" :answer/id #uuid "abc230ef-4240-534b-bd00-d63ca4cdb3ee" :answer/type :answer.type/math :answer/value "v=6" :db/ensure [:answer/validate]} {:db/id "question-ecdce78b-6ad1-5fcc-9999-f701ae74931a" :question/id #uuid "ecdce78b-6ad1-5fcc-9999-f701ae74931a" :question/math-academy-id "q-100773" :question/problem "Solve the equation ${log}_{2}⁡({x}^{2}+7)={log}_{2}⁡(2{x}^{2}+8).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{2}+7) & ={log}_{2}⁡(2{x}^{2}+8) \\\\ {x}^{2}+7 & =2{x}^{2}+8 \\\\ {x}^{2} & =-1.\\end{aligned}\n$$\n\nThe equation ${x}^{2}=-1$ has no real solutions. Therefore, our original logarithmic equation has no solutions either." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c0a61e66-3aca-536b-aa8a-9b7a2020142b"] :db/ensure [:question/validate]} {:db/id "answer-field-c0a61e66-3aca-536b-aa8a-9b7a2020142b" :answer-field/id #uuid "c0a61e66-3aca-536b-aa8a-9b7a2020142b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a1508db0-4863-5e06-8a60-94207ae22916" :answer-field/choices ["answer-b7237201-cb21-5414-84de-7f2cfcb1a828" "answer-79de5745-5bf0-555e-a601-3b494c6bd938" "answer-8be64e16-04ad-51d8-827e-a16e9b00296b" "answer-add9a8e9-c820-5de7-a37b-45ae258e7857" "answer-a1508db0-4863-5e06-8a60-94207ae22916"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7237201-cb21-5414-84de-7f2cfcb1a828" :answer/id #uuid "b7237201-cb21-5414-84de-7f2cfcb1a828" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-79de5745-5bf0-555e-a601-3b494c6bd938" :answer/id #uuid "79de5745-5bf0-555e-a601-3b494c6bd938" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "answer-8be64e16-04ad-51d8-827e-a16e9b00296b" :answer/id #uuid "8be64e16-04ad-51d8-827e-a16e9b00296b" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-add9a8e9-c820-5de7-a37b-45ae258e7857" :answer/id #uuid "add9a8e9-c820-5de7-a37b-45ae258e7857" :answer/type :answer.type/math :answer/value "x=\\pm 1" :db/ensure [:answer/validate]} {:db/id "answer-a1508db0-4863-5e06-8a60-94207ae22916" :answer/id #uuid "a1508db0-4863-5e06-8a60-94207ae22916" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id 17592186116482 :tutorial/content "To solve an equation that has logarithms with the same base on both sides, we can exponentiate both sides of the equation by the base. For example, consider the equation\n\n$$\n\\log_3(2x-4)=\\log_3(x+3).\n$$\n\nSince both sides of the equation are represented as logarithms of the same base ($3$), we can exponentiate both sides of the equation by $3.$ This gives \n\n$$\n\\begin{aligned}{3}^{{log}_{3}⁡(2x-4)} & ={3}^{{log}_{3}⁡(x+3)} \\\\ 2x-4 & =x+3.\\end{aligned}\n$$\n\nNow, we solve for $x\\mathbin{:}$ \n\n$$\n\\begin{aligned}2x-4 & =x+3 \\\\ x & =7\\end{aligned}\n$$\n\nTherefore, $x=7$ is the solution.\n\n**Caution:** Remember that, when solving logarithmic equations, it is sometimes possible to get *extraneous* solutions that don't actually satisfy the original equation. We can't take a logarithm of zero or a negative number.\n\nSo, once we've found the solutions, we need to substitute them back into the original equation and check that the arguments of the logarithms are positive. Substituting $x=7$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{3}⁡(2x-4) & \\overset{?}{=}{log}_{3}⁡(x+3) \\\\ {log}_{3}⁡(2\\cdot 7-4) & \\overset{?}{=}{log}_{3}⁡(7+3) \\\\ {log}_{3}⁡(10) & ={log}_{3}⁡(10).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=7$ is a valid solution." :db/ensure [:tutorial/validate]} {:db/id 17592186116523 :tutorial/content "In the previous example, you may have noticed that for the logarithmic equation\n\n$$\n\\log_3 (2x-4) = \\log_3 (x+3),\n$$\n\nwe were able to \"cancel out\" the logarithms and equate the arguments:\n\n$$\n2x-4 = x+3\n$$\n\nThis result holds in general. Whenever the logarithms on both sides of the equation have the same base, we can equate the arguments.\n\n**Caution:** This trick only works when the logarithms have the same base. The equation must take the form\n\n$$\n\\log_n f(x) = \\log_n g(x)\n$$\n\nwhere $n$ is the base of *both* logarithms and $f(x)$ and $g(x)$ are the arguments of the logarithms." :db/ensure [:tutorial/validate]} {:db/id 17592186115443 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} [:db/retract 17592186104428 :answer-field/choices 17592186104432] [:db/retract 17592186104428 :answer-field/choices 17592186104433] [:db/retract 17592186104428 :answer-field/choices 17592186104429] [:db/retract 17592186104428 :answer-field/choices 17592186104430] [:db/retract 17592186104428 :answer-field/choices 17592186104431] {:db/id 17592186106449 :question/problem "Find the $31$st term of an arithmetic sequence given that the $22$nd term is $76$ and the $6$th term is $-4.$" :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$\n\nTo find the common difference, we can find the total difference between the terms ${a}_{22}=76$ and ${a}_{6}=-4$ and divide it by the number of jumps, as follows:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{22}-{a}_{6}}{22-6} \\\\  & =\\frac{76-(-4)}{22-6} \\\\  & =\\frac{80}{16} \\\\  & =5\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{6}=-4,$ to determine the first term of the sequence. Since ${a}_{6}$ is $5$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{6} & ={a}_{1}+5d \\\\ -4 & ={a}_{1}+5\\cdot 5 \\\\ -4 & ={a}_{1}+25 \\\\ {a}_{1} & =-29\\end{aligned}\n$$\n\nSo the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & =-29+(n-1)\\cdot 5 \\\\  & =-34+5n\\end{aligned}\n$$\n\nFinally, we can find the $31$st term by substituting $n=31$ into the above:\n\n$$\n\\begin{aligned}{a}_{31} & =-34+5(31) \\\\  & =-34+155 \\\\  & =121\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186104842 :answer-field/correct 17592186104845 :db/ensure [:answer-field/validate]} {:db/id 17592186105920 :knowledge-point/questions ["question-e16d4c55-4032-51af-b361-3c91c642bb36"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186106380 :question/problem "The $10$th and $11$th terms of an arithmetic sequence are $30$ and $33,$ respectively. Determine the formula for the $n$th term of the sequence." :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$\n\nSince the terms ${a}_{10}=30$ and ${a}_{11}=33$ are consecutive, we can subtract them to find the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{11}-{a}_{10} \\\\  & =33-30 \\\\  & =3\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{10}=30,$ to determine the first term of the sequence. Since ${a}_{10}$ is $9$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{10} & ={a}_{1}+9d \\\\ 30 & ={a}_{1}+9(3) \\\\ 30 & ={a}_{1}+27 \\\\ 30-27 & ={a}_{1} \\\\ {a}_{1} & =3\\end{aligned}\n$$\n\nSo, the formula for the $n$th term of this arithmetic sequence is:  \n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =3+(n-1)(3) \\\\  & =3+3n-3 \\\\  & =3n\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186104428 :answer-field/correct "answer-db6886dc-8144-544f-ac7e-3797991967e7" :answer-field/choices ["answer-e396d923-9038-578c-9cec-ab4160014ddc" "answer-9efb8e4c-4b94-56cc-a616-72f436715fb2" "answer-db6886dc-8144-544f-ac7e-3797991967e7" "answer-4fdd2eb5-c98d-546b-8571-a3499b2907ec" "answer-0dea6f66-3bbd-5b42-8dca-11fd28f5185c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e396d923-9038-578c-9cec-ab4160014ddc" :answer/id #uuid "e396d923-9038-578c-9cec-ab4160014ddc" :answer/type :answer.type/math :answer/value "{a}_{n}=2n+5" :db/ensure [:answer/validate]} {:db/id "answer-9efb8e4c-4b94-56cc-a616-72f436715fb2" :answer/id #uuid "9efb8e4c-4b94-56cc-a616-72f436715fb2" :answer/type :answer.type/math :answer/value "{a}_{n}=2n-4" :db/ensure [:answer/validate]} {:db/id "answer-db6886dc-8144-544f-ac7e-3797991967e7" :answer/id #uuid "db6886dc-8144-544f-ac7e-3797991967e7" :answer/type :answer.type/math :answer/value "{a}_{n}=3n" :db/ensure [:answer/validate]} {:db/id "answer-4fdd2eb5-c98d-546b-8571-a3499b2907ec" :answer/id #uuid "4fdd2eb5-c98d-546b-8571-a3499b2907ec" :answer/type :answer.type/math :answer/value "{a}_{n}=3n+3" :db/ensure [:answer/validate]} {:db/id "answer-0dea6f66-3bbd-5b42-8dca-11fd28f5185c" :answer/id #uuid "0dea6f66-3bbd-5b42-8dca-11fd28f5185c" :answer/type :answer.type/math :answer/value "{a}_{n}=4n+2" :db/ensure [:answer/validate]} {:db/id "question-e16d4c55-4032-51af-b361-3c91c642bb36" :question/id #uuid "e16d4c55-4032-51af-b361-3c91c642bb36" :question/math-academy-id "q-51559" :question/problem "The $8$th and $9$th terms of an arithmetic sequence are $17$ and $21,$ respectively. Determine the formula for the $n$th term of the sequence." :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$ \n\nSince the terms ${a}_{8}=17$ and ${a}_{9}=21$ are consecutive, we can subtract them to find the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{9}-{a}_{8} \\\\  & =21-17 \\\\  & =4\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{8}=17,$ to determine the first term of the sequence. Since ${a}_{8}$ is $7$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{8} & ={a}_{1}+7d \\\\ 17 & ={a}_{1}+7(4) \\\\ 17 & ={a}_{1}+28 \\\\ 17-28 & ={a}_{1} \\\\ {a}_{1} & =-11\\end{aligned}\n$$\n\nSo, the formula for the $n$th term of this arithmetic sequence is:  \n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-11+(n-1)(4) \\\\  & =-11+4n-4 \\\\  & =4n-15\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aa1e5362-5987-509c-a24c-44644e0e29bc"] :db/ensure [:question/validate]} {:db/id "answer-field-aa1e5362-5987-509c-a24c-44644e0e29bc" :answer-field/id #uuid "aa1e5362-5987-509c-a24c-44644e0e29bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94a2410d-cad5-53c3-8faf-cf633aeba7d0" :answer-field/choices ["answer-809e7a62-ae33-582b-8668-82433fc6dda6" "answer-d67c9c6d-7661-524e-8b60-4eeb9d1f1a9b" "answer-757055cf-e772-58da-a703-f43ec9a3c7e3" "answer-94a2410d-cad5-53c3-8faf-cf633aeba7d0" "answer-5d577714-df32-50d4-a3a7-992d2e6e61f7"] :db/ensure [:answer-field/validate]} {:db/id "answer-809e7a62-ae33-582b-8668-82433fc6dda6" :answer/id #uuid "809e7a62-ae33-582b-8668-82433fc6dda6" :answer/type :answer.type/math :answer/value "{a}_{n}=2n-17" :db/ensure [:answer/validate]} {:db/id "answer-d67c9c6d-7661-524e-8b60-4eeb9d1f1a9b" :answer/id #uuid "d67c9c6d-7661-524e-8b60-4eeb9d1f1a9b" :answer/type :answer.type/math :answer/value "{a}_{n}=4n+8" :db/ensure [:answer/validate]} {:db/id "answer-757055cf-e772-58da-a703-f43ec9a3c7e3" :answer/id #uuid "757055cf-e772-58da-a703-f43ec9a3c7e3" :answer/type :answer.type/math :answer/value "{a}_{n}=4n-12" :db/ensure [:answer/validate]} {:db/id "answer-94a2410d-cad5-53c3-8faf-cf633aeba7d0" :answer/id #uuid "94a2410d-cad5-53c3-8faf-cf633aeba7d0" :answer/type :answer.type/math :answer/value "{a}_{n}=4n-15" :db/ensure [:answer/validate]} {:db/id "answer-5d577714-df32-50d4-a3a7-992d2e6e61f7" :answer/id #uuid "5d577714-df32-50d4-a3a7-992d2e6e61f7" :answer/type :answer.type/math :answer/value "{a}_{n}=8n-5" :db/ensure [:answer/validate]} {:db/id "activity-060d4036-0ed8-5c85-a941-438a79e46360" :activity/id #uuid "060d4036-0ed8-5c85-a941-438a79e46360" :activity/title "Finding the Nth Term of an Arithmetic Sequence Given Two Terms" :activity/type :activity.type/review :activity/scope 17592186049504 :activity/course 17592186046647 :activity/steps ["step-7a31efa5-d4c7-5882-8e55-b1f919330c88" "step-4d6aeb91-9c91-562e-a421-ded7cae525a0" "step-e7692710-4fdb-558d-9af2-f742b0d553e5"] :activity/first-step "step-7a31efa5-d4c7-5882-8e55-b1f919330c88" :db/ensure [:activity/validate]} {:db/id "step-7a31efa5-d4c7-5882-8e55-b1f919330c88" :step/id #uuid "7a31efa5-d4c7-5882-8e55-b1f919330c88" :step/content 17592186106449 :step/next "step-4d6aeb91-9c91-562e-a421-ded7cae525a0" :db/ensure [:step/validate]} {:db/id "step-4d6aeb91-9c91-562e-a421-ded7cae525a0" :step/id #uuid "4d6aeb91-9c91-562e-a421-ded7cae525a0" :step/content 17592186106380 :step/next "step-e7692710-4fdb-558d-9af2-f742b0d553e5" :db/ensure [:step/validate]} {:db/id "step-e7692710-4fdb-558d-9af2-f742b0d553e5" :step/id #uuid "e7692710-4fdb-558d-9af2-f742b0d553e5" :step/content "question-e16d4c55-4032-51af-b361-3c91c642bb36" :db/ensure [:step/validate]} {:db/id 17592186129129 :knowledge-point/questions ["question-9820b99c-2acb-5f80-b231-9670a302c372"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9820b99c-2acb-5f80-b231-9670a302c372" :question/id #uuid "9820b99c-2acb-5f80-b231-9670a302c372" :question/math-academy-id "q-37402" :question/problem "$$\nA=[\\begin{aligned}1 & 2 & 4 \\\\ 2 & 1 & -4 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{2}$ are eigenvectors that correspond to the eigenvalues ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3$ of the matrix $A,$ given above. Find the third eigenvector ${v}_{3}=[a,\\,b,\\,c]^{T}$ such that the set $\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is linearly independent. What is the value of $\\frac{a}{b}?$" :question/worked-solution "First, we find all the eigenvalues of $A$ by solving the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 2 & 4 \\\\ 2 & 1-\\lambda  & -4 \\\\ 0 & 0 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}1-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )((1-\\lambda )(1-\\lambda )-(2)(2)) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}-2\\lambda -3) & =0 \\\\ -(\\lambda -2)(\\lambda +1)(\\lambda -3) & =0\\end{aligned}\n$$\n\nHence, ${\\lambda }_{1}=2,$ ${\\lambda }_{2}=3,$ and ${\\lambda }_{3}=-1.$ Since we obtained three distinct eigenvalues, the set of eigenvectors $\\{{v}_{1},{v}_{2},{v}_{3}\\},$ where each vector corresponds to different eigenvalue, will be linearly independent.\n\nNow, recall that ${v}_{1}$ and ${v}_{2}$ correspond to the eigenvalues ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3.$ Thus, the third eigenvector ${v}_{3}$ must correspond to ${\\lambda }_{3}=-1.$ \n\nTo compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\lambda =-1.$ So, we obtain\n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}1 & 2 & 4 \\\\ 2 & 1 & -4 \\\\ 0 & 0 & 2\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 & 4 \\\\ 2 & 2 & -4 \\\\ 0 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the system of linear equations \n\n$$\n\\{\\begin{aligned}2{x}_{1}+2{x}_{2}+4{x}_{3}=0 \\\\ 2{x}_{1}+2{x}_{2}-4{x}_{3}=0 \\\\ 3{x}_{3}=0\\end{aligned}\n$$\n\nTo find the eigenvectors corresponding to this eigenvalue, we have to solve the corresponding homogeneous system of linear equations:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 2 & 4 & 0 \\\\ 2 & 2 & -4 & 0 \\\\ 0 & 0 & 3 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 2 & 4 & 0 \\\\ 0 & 0 & -8 & 0 \\\\ 0 & 0 & 3 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+\\frac{3}{8}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 2 & 4 & 0 \\\\ 0 & 0 & -8 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there are two pivot columns (the $1$st and the $3$rd). Thus, ${x}_{2}$ is a free variable. From the second equation, we obtain ${x}_{3}=0.$ Substituting this into the first equation, we get ${x}_{1}=-{x}_{2}.$ Therefore, the general solution is\n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ 0\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSetting, for instance, ${x}_{2}=1,$ we get the following eigenvector:\n\n$$\nv=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\n$$\n\nFinally, $\\frac{a}{b}=\\frac{-1}{1}=-1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5ce54675-4c82-511c-b17c-ef8ba86365cd"] :db/ensure [:question/validate]} {:db/id "answer-field-5ce54675-4c82-511c-b17c-ef8ba86365cd" :answer-field/id #uuid "5ce54675-4c82-511c-b17c-ef8ba86365cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-623914d6-e6b8-5dc3-8327-81f1d2919a84" :answer-field/choices ["answer-623914d6-e6b8-5dc3-8327-81f1d2919a84" "answer-0174e176-0cb7-5b47-a8ba-9fe3b08757a5" "answer-4f2d612f-1d4f-54a0-829f-81ec557baecc" "answer-53c58a6b-8263-5f64-84ba-2acd0232972e" "answer-fce51717-00cf-5470-b72d-97e68246b052"] :db/ensure [:answer-field/validate]} {:db/id "answer-623914d6-e6b8-5dc3-8327-81f1d2919a84" :answer/id #uuid "623914d6-e6b8-5dc3-8327-81f1d2919a84" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-0174e176-0cb7-5b47-a8ba-9fe3b08757a5" :answer/id #uuid "0174e176-0cb7-5b47-a8ba-9fe3b08757a5" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-4f2d612f-1d4f-54a0-829f-81ec557baecc" :answer/id #uuid "4f2d612f-1d4f-54a0-829f-81ec557baecc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-53c58a6b-8263-5f64-84ba-2acd0232972e" :answer/id #uuid "53c58a6b-8263-5f64-84ba-2acd0232972e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-fce51717-00cf-5470-b72d-97e68246b052" :answer/id #uuid "fce51717-00cf-5470-b72d-97e68246b052" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186105901 :knowledge-point/questions ["question-629a07aa-1bdb-505b-9cdf-8118c6579d3f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-629a07aa-1bdb-505b-9cdf-8118c6579d3f" :question/id #uuid "629a07aa-1bdb-505b-9cdf-8118c6579d3f" :question/math-academy-id "q-136955" :question/problem "Find $\\text{E}[{X}^{2}],$ given that the continuous random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{x+2}{8},\\,-2\\le x\\le 2.\n$$" :question/worked-solution "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)={x}^{2}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}{x}^{2}\\cdot \\frac{x+2}{8}\\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}(\\frac{{x}^{3}}{8}+\\frac{{x}^{2}}{4})\\text{d}x \\\\  & ={[\\frac{{x}^{4}}{32}+\\frac{{x}^{3}}{12}]}_{-2}^{2} \\\\  & =[\\frac{16}{32}+\\frac{8}{12}]-[\\frac{16}{32}-\\frac{8}{12}] \\\\  & =\\frac{16}{12} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f81fd95e-548c-5041-a689-fc8dd1a4f6b1"] :db/ensure [:question/validate]} {:db/id "answer-field-f81fd95e-548c-5041-a689-fc8dd1a4f6b1" :answer-field/id #uuid "f81fd95e-548c-5041-a689-fc8dd1a4f6b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb3ee915-a0f5-5e10-b5c6-cadf0c09fd1e" :answer-field/choices ["answer-6e14df0f-9ce2-5965-bb91-1fbe22d21aa7" "answer-4659c64c-5190-52e8-8db5-eb121e204831" "answer-965fd1e1-14aa-51e2-add1-57ed1e1880f0" "answer-bb3ee915-a0f5-5e10-b5c6-cadf0c09fd1e" "answer-47e6eaaf-0488-5e0a-b6b7-4666b416074b"] :db/ensure [:answer-field/validate]} {:db/id "answer-6e14df0f-9ce2-5965-bb91-1fbe22d21aa7" :answer/id #uuid "6e14df0f-9ce2-5965-bb91-1fbe22d21aa7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4659c64c-5190-52e8-8db5-eb121e204831" :answer/id #uuid "4659c64c-5190-52e8-8db5-eb121e204831" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-965fd1e1-14aa-51e2-add1-57ed1e1880f0" :answer/id #uuid "965fd1e1-14aa-51e2-add1-57ed1e1880f0" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-bb3ee915-a0f5-5e10-b5c6-cadf0c09fd1e" :answer/id #uuid "bb3ee915-a0f5-5e10-b5c6-cadf0c09fd1e" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-47e6eaaf-0488-5e0a-b6b7-4666b416074b" :answer/id #uuid "47e6eaaf-0488-5e0a-b6b7-4666b416074b" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id 17592186166856 :knowledge-point/questions ["question-224b72f4-7dda-5cd7-89ac-9950a44cc628"] :db/ensure [:knowledge-point/validate]} {:db/id "question-224b72f4-7dda-5cd7-89ac-9950a44cc628" :question/id #uuid "224b72f4-7dda-5cd7-89ac-9950a44cc628" :question/math-academy-id "q-132437" :question/problem "Given that $X∼\\text{Exp}(\\frac{\\sqrt{3}}{2}),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{\\sqrt{3}}{2}),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(\\frac{\\sqrt{3}}{2})}^{2}} \\\\  & =\\frac{1}{(\\frac{3}{4})} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30f439c6-850c-556a-a1db-f9a9d3a4a19c"] :db/ensure [:question/validate]} {:db/id "answer-field-30f439c6-850c-556a-a1db-f9a9d3a4a19c" :answer-field/id #uuid "30f439c6-850c-556a-a1db-f9a9d3a4a19c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf97a1ce-c65c-5f65-82ac-6f5c300dc9ea" :answer-field/choices ["answer-6ce9db67-a4d8-528a-ab5f-3678c39d003b" "answer-8f9bda09-f1d7-582f-8b9e-ab2ac1effc46" "answer-582dfc2f-ec43-56ae-b0da-a85459f5f647" "answer-cf97a1ce-c65c-5f65-82ac-6f5c300dc9ea" "answer-440832e3-ec7e-581c-830b-fa0617454e21"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ce9db67-a4d8-528a-ab5f-3678c39d003b" :answer/id #uuid "6ce9db67-a4d8-528a-ab5f-3678c39d003b" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8f9bda09-f1d7-582f-8b9e-ab2ac1effc46" :answer/id #uuid "8f9bda09-f1d7-582f-8b9e-ab2ac1effc46" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-582dfc2f-ec43-56ae-b0da-a85459f5f647" :answer/id #uuid "582dfc2f-ec43-56ae-b0da-a85459f5f647" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-cf97a1ce-c65c-5f65-82ac-6f5c300dc9ea" :answer/id #uuid "cf97a1ce-c65c-5f65-82ac-6f5c300dc9ea" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-440832e3-ec7e-581c-