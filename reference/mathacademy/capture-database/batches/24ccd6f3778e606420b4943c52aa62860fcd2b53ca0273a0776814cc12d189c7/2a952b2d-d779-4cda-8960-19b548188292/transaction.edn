 With Distinct Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186048195 :activity/course 17592186046658 :activity/steps ["step-fd8a2dc1-a49f-506a-b33d-718ebbbd9ef6" "step-34f68300-3a0e-58fc-a8aa-f305c97cd3d5" "step-6560dcab-2e47-5dba-b0c5-673ac9d7244e" "step-499ba589-4e0b-58b1-a900-499f4b84e7a5" "step-64139f10-9043-5873-85bc-4ba08c345ac7"] :activity/first-step "step-fd8a2dc1-a49f-506a-b33d-718ebbbd9ef6" :db/ensure [:activity/validate]} {:db/id "step-fd8a2dc1-a49f-506a-b33d-718ebbbd9ef6" :step/id #uuid "fd8a2dc1-a49f-506a-b33d-718ebbbd9ef6" :step/content 17592186323891 :step/next "step-34f68300-3a0e-58fc-a8aa-f305c97cd3d5" :db/ensure [:step/validate]} {:db/id "step-34f68300-3a0e-58fc-a8aa-f305c97cd3d5" :step/id #uuid "34f68300-3a0e-58fc-a8aa-f305c97cd3d5" :step/content 17592186382072 :step/next "step-6560dcab-2e47-5dba-b0c5-673ac9d7244e" :db/ensure [:step/validate]} {:db/id "step-6560dcab-2e47-5dba-b0c5-673ac9d7244e" :step/id #uuid "6560dcab-2e47-5dba-b0c5-673ac9d7244e" :step/content 17592186402575 :step/next "step-499ba589-4e0b-58b1-a900-499f4b84e7a5" :db/ensure [:step/validate]} {:db/id "step-499ba589-4e0b-58b1-a900-499f4b84e7a5" :step/id #uuid "499ba589-4e0b-58b1-a900-499f4b84e7a5" :step/content 17592186432170 :step/next "step-64139f10-9043-5873-85bc-4ba08c345ac7" :db/ensure [:step/validate]} {:db/id "step-64139f10-9043-5873-85bc-4ba08c345ac7" :step/id #uuid "64139f10-9043-5873-85bc-4ba08c345ac7" :step/content 17592186272036 :db/ensure [:step/validate]} {:db/id 17592186078577 :knowledge-point/questions ["question-a03551ce-a9e0-5803-b72e-ac5c9487b91c" "question-20bfc5d7-9144-5859-b1f0-27af1f1cfa84"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078164 :question/problem "Solve the equation $13 = \\dfrac{6y+8}{2}.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $2\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\t13 &= \\dfrac{6y+8}{2} \\\n\t\t2 \\cdot 13 &= 2 \\cdot \\left(\\dfrac{6y+8}{2}\\right)  \\   \n\t\t2 \\cdot 13 &= \\cancel{2} \\cdot \\left(\\dfrac{6y+8}{\\cancel{2}}\\right) \\   \n\t\t26 &= 6y+8\n\t}\n$$\n\nNext, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\eqalign{\n\t\t26 &= 6y+8 \\\n\t\t26-8 &= 6y+8-8 \\\n\t\t18 &= 6y \\\n\t\t\\dfrac{18}{6} &= \\dfrac{6y}{6} \\\n\t\t3 &= y\n\t}\n$$\n\nThus, $y=3.$" :db/ensure [:question/validate]} {:db/id 17592186078578 :knowledge-point/questions ["question-31ff821e-8692-536f-977f-3df1a10cce49" "question-7153151e-24e5-5164-807d-f6b5a1d383b9" "question-8fa20dc6-b138-59bb-9538-21dc8c6a5944"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078165 :question/problem "Solve the equation $\\dfrac{a+2}{3} =a.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $3\\mathbin{:}$\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\\dfrac{a+2}{3} &=a \\\n3 \\cdot \\left( \\dfrac{a+2}{3} \\right) &= 3 \\cdot a \\\n\\cancel{3} \\cdot \\left( \\dfrac{a+2}{ \\cancel{3} } \\right) &= 3a \\\na+2 &= 3a\n\t}\n$$\n\nNext, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\require{cancel}\n\t\\eqalign{\na+2 &= 3a \\\na + 2 - a &= 3a - a \\\n2 &= 2a \\\n\\dfrac{2}{2} &= \\dfrac{2a}{2} \\\n1 &= a\n\t}\n$$\n\nThus, $a=1.$" :db/ensure [:question/validate]} {:db/id 17592186078579 :knowledge-point/questions ["question-2de1d7cb-6ad2-5a64-8b22-82ed6e525706" "question-595c6cf3-442f-5ee5-b303-59b7320fc44a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078166 :question/problem "Solve the equation $\\dfrac{2n+6}{3} = 4n+1.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $3.$ We must make sure that *all* of the terms on the right-hand side are multiplied by $3.$\n\n$$\n\\begin{aligned}\\frac{2n+6}{3} & =4n+1 \\\\ 3\\cdot (\\frac{2n+6}{3}) & =3\\cdot (4n+1) \\\\ \\cancel{3}\\cdot (\\frac{2n+6}{\\cancel{3}}) & =3\\cdot 4n+3\\cdot 1 \\\\ 2n+6 & =12n+3\\end{aligned}\n$$\n\nNext, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}2n+6 & =12n+3 \\\\ 2n+6-2n & =12n+3-2n \\\\ 6 & =10n+3 \\\\ 6-3 & =10n+3-3 \\\\ 3 & =10n \\\\ \\frac{3}{10} & =\\frac{10n}{10} \\\\ \\frac{3}{10} & =n\\end{aligned}\n$$\n\nThus, $n = \\dfrac{3}{10}.$" :db/ensure [:question/validate]} {:db/id 17592186078580 :knowledge-point/questions ["question-ba37a28b-262f-5934-93da-824b60873e74" "question-6dc17e55-1c4a-5a93-b3b8-937d5766223d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078167 :question/problem "Solve $\\dfrac{5p+10}{6} =2(p-5).$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $6\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\t\\dfrac{5p+10}{6} &=2(p-5)\\\n\t\t6 \\cdot \\left(\\dfrac{5p+10}{6}\\right) &=6\\cdot 2 (p-5) \\   \n\t\t\\cancel{6} \\cdot \\left(\\dfrac{5p+10}{\\cancel{6}}\\right) &=12(p-5) \\   \n\t\t5p+10 &=12p-60\n\t}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\eqalign{\n\t\t5p+10 &=12p-60 \\\n\t\t5p+10-5p &=12p-60-5p \\\n\t\t10 &=7p-60 \\\n\t\t10+60 &=7p-60+60 \\\n\t\t70 &=7p \\\n\t\t\\dfrac{70}{7} &=\\dfrac{7p}{7} \\\n\t\t10 &= p\n\t}\n$$\n\nThus, $p=10.$" :db/ensure [:question/validate]} {:db/id "question-a03551ce-a9e0-5803-b72e-ac5c9487b91c" :question/id #uuid "a03551ce-a9e0-5803-b72e-ac5c9487b91c" :question/math-academy-id "q-516" :question/problem "If $\\frac{3x-4}{5}=4$, then $x=$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $5$:\n\n$$\n\\begin{aligned}\\frac{3x-4}{5} & =4 \\\\ 5(\\frac{3x-4}{5}) & =5\\cdot 4 \\\\ \\cancel{5}(\\frac{3x-4}{\\cancel{5}}) & =20 \\\\ 3x-4 & =20\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3x-4 & =20 \\\\ 3x-4+4 & =20+4 \\\\ 3x & =24 \\\\ \\frac{3x}{3} & =\\frac{24}{3} \\\\ \\frac{\\cancel{3}x}{\\cancel{3}} & =\\frac{24}{3} \\\\ x & =8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-69080ef7-9645-5832-a070-cafaabea87b4"] :db/ensure [:question/validate]} {:db/id "answer-field-69080ef7-9645-5832-a070-cafaabea87b4" :answer-field/id #uuid "69080ef7-9645-5832-a070-cafaabea87b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37d15691-b3ad-5364-a583-ab8f35061ef7" :answer-field/choices ["answer-11cda6f2-fa4c-533f-a5fb-5ae6d008a750" "answer-b4e20d5c-83e8-599c-b953-71a78f2d26e4" "answer-57ab5f7d-1a96-50a7-80d5-df0915422b13" "answer-37d15691-b3ad-5364-a583-ab8f35061ef7" "answer-2059fb78-a1d2-516b-b757-c8200d097afd"] :db/ensure [:answer-field/validate]} {:db/id "answer-11cda6f2-fa4c-533f-a5fb-5ae6d008a750" :answer/id #uuid "11cda6f2-fa4c-533f-a5fb-5ae6d008a750" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-b4e20d5c-83e8-599c-b953-71a78f2d26e4" :answer/id #uuid "b4e20d5c-83e8-599c-b953-71a78f2d26e4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-57ab5f7d-1a96-50a7-80d5-df0915422b13" :answer/id #uuid "57ab5f7d-1a96-50a7-80d5-df0915422b13" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "answer-37d15691-b3ad-5364-a583-ab8f35061ef7" :answer/id #uuid "37d15691-b3ad-5364-a583-ab8f35061ef7" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-2059fb78-a1d2-516b-b757-c8200d097afd" :answer/id #uuid "2059fb78-a1d2-516b-b757-c8200d097afd" :answer/type :answer.type/math :answer/value "\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "question-20bfc5d7-9144-5859-b1f0-27af1f1cfa84" :question/id #uuid "20bfc5d7-9144-5859-b1f0-27af1f1cfa84" :question/math-academy-id "q-175605" :question/problem "If $\\frac{10-3x}{4}=1$, then $x=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}\\frac{10-3x}{4} & =1 \\\\ 4(\\frac{10-3x}{4}) & =4\\cdot 1 \\\\ \\cancel{4}(\\frac{10-3x}{\\cancel{4}}) & =4 \\\\ 10-3x & =4\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}10-3x & =4 \\\\ 10-3x-10 & =4-10 \\\\ -3x & =-6 \\\\ \\frac{-3x}{-3} & =\\frac{-6}{-3} \\\\ \\frac{\\cancel{-3}x}{\\cancel{-3}} & =\\frac{6}{3} \\\\ x & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dc5230bd-3f16-51ef-835b-4c76d199cbd9"] :db/ensure [:question/validate]} {:db/id "answer-field-dc5230bd-3f16-51ef-835b-4c76d199cbd9" :answer-field/id #uuid "dc5230bd-3f16-51ef-835b-4c76d199cbd9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f8c42ec6-c44c-5681-baf3-b34d487a5c25" :answer-field/choices ["answer-f8c42ec6-c44c-5681-baf3-b34d487a5c25"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8c42ec6-c44c-5681-baf3-b34d487a5c25" :answer/id #uuid "f8c42ec6-c44c-5681-baf3-b34d487a5c25" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-31ff821e-8692-536f-977f-3df1a10cce49" :question/id #uuid "31ff821e-8692-536f-977f-3df1a10cce49" :question/math-academy-id "q-101638" :question/problem "Solve the equation $\\frac{7w+10}{3}=4w.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $3$:\n\n$$\n\\begin{aligned}\\frac{7w+10}{3} & =4w \\\\ 3(\\frac{7w+10}{3}) & =3\\cdot (4w) \\\\ \\cancel{3}\\cdot (\\frac{7w+10}{\\cancel{3}}) & =12w \\\\ 7w+10 & =12w\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}7w+10 & =12w \\\\ 7w+10-7w & =12w-7w \\\\ 10 & =5w \\\\ \\frac{10}{5} & =\\frac{5w}{5} \\\\ 2 & =w\\end{aligned}\n$$\n\nThus, $w=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8d661ec7-ecd8-5468-bb3e-4657cb6057cc"] :db/ensure [:question/validate]} {:db/id "answer-field-8d661ec7-ecd8-5468-bb3e-4657cb6057cc" :answer-field/id #uuid "8d661ec7-ecd8-5468-bb3e-4657cb6057cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-11d6e9c3-191d-5438-b906-5d1d3cc45e81" :answer-field/choices ["answer-edfd9eaf-6828-5668-b6aa-9b9fd0b739b6" "answer-5a76661f-dbc7-54d2-a811-7f13e3306e5c" "answer-faf764a5-4476-5534-af8f-d57d52fd0ca9" "answer-11d6e9c3-191d-5438-b906-5d1d3cc45e81" "answer-c7c72bd5-cce7-5120-98f8-83a5c9c7dd55"] :db/ensure [:answer-field/validate]} {:db/id "answer-edfd9eaf-6828-5668-b6aa-9b9fd0b739b6" :answer/id #uuid "edfd9eaf-6828-5668-b6aa-9b9fd0b739b6" :answer/type :answer.type/math :answer/value "w=-1" :db/ensure [:answer/validate]} {:db/id "answer-5a76661f-dbc7-54d2-a811-7f13e3306e5c" :answer/id #uuid "5a76661f-dbc7-54d2-a811-7f13e3306e5c" :answer/type :answer.type/math :answer/value "w=-2" :db/ensure [:answer/validate]} {:db/id "answer-faf764a5-4476-5534-af8f-d57d52fd0ca9" :answer/id #uuid "faf764a5-4476-5534-af8f-d57d52fd0ca9" :answer/type :answer.type/math :answer/value "w=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-11d6e9c3-191d-5438-b906-5d1d3cc45e81" :answer/id #uuid "11d6e9c3-191d-5438-b906-5d1d3cc45e81" :answer/type :answer.type/math :answer/value "w=2" :db/ensure [:answer/validate]} {:db/id "answer-c7c72bd5-cce7-5120-98f8-83a5c9c7dd55" :answer/id #uuid "c7c72bd5-cce7-5120-98f8-83a5c9c7dd55" :answer/type :answer.type/math :answer/value "w=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-7153151e-24e5-5164-807d-f6b5a1d383b9" :question/id #uuid "7153151e-24e5-5164-807d-f6b5a1d383b9" :question/math-academy-id "q-44323" :question/problem "Solve the equation $\\frac{7-2x}{4}=3x.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}\\frac{7-2x}{4} & =3x \\\\ 4(\\frac{7-2x}{4}) & =4\\cdot 3x \\\\ \\cancel{4}(\\frac{7-2x}{\\cancel{4}}) & =12x \\\\ 7-2x & =12x\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}7-2x & =12x \\\\ 7-2x+2x & =12x+2x \\\\ 7 & =14x \\\\ 14x & =7 \\\\ \\frac{14x}{14} & =\\frac{7}{14} \\\\ \\frac{\\cancel{14}x}{\\cancel{14}} & =\\frac{1}{2} \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0eceed43-a057-57c7-a5cc-ec7c35a76f3f"] :db/ensure [:question/validate]} {:db/id "answer-field-0eceed43-a057-57c7-a5cc-ec7c35a76f3f" :answer-field/id #uuid "0eceed43-a057-57c7-a5cc-ec7c35a76f3f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e36fe2e-5214-58a6-807e-df8388085127" :answer-field/choices ["answer-6a0678ad-9d14-5601-9ad6-f383f1e0d72e" "answer-3d0777cc-8ae6-5c2c-8a03-e9d38bb1e364" "answer-8e36fe2e-5214-58a6-807e-df8388085127" "answer-8484234b-9c0f-591e-8d32-0f6677cb4358" "answer-c55d9c2d-f5f8-5ed0-b0ba-277a3e43aca9"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a0678ad-9d14-5601-9ad6-f383f1e0d72e" :answer/id #uuid "6a0678ad-9d14-5601-9ad6-f383f1e0d72e" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-3d0777cc-8ae6-5c2c-8a03-e9d38bb1e364" :answer/id #uuid "3d0777cc-8ae6-5c2c-8a03-e9d38bb1e364" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-8e36fe2e-5214-58a6-807e-df8388085127" :answer/id #uuid "8e36fe2e-5214-58a6-807e-df8388085127" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8484234b-9c0f-591e-8d32-0f6677cb4358" :answer/id #uuid "8484234b-9c0f-591e-8d32-0f6677cb4358" :answer/type :answer.type/math :answer/value "x=\\frac{7}{10}" :db/ensure [:answer/validate]} {:db/id "answer-c55d9c2d-f5f8-5ed0-b0ba-277a3e43aca9" :answer/id #uuid "c55d9c2d-f5f8-5ed0-b0ba-277a3e43aca9" :answer/type :answer.type/math :answer/value "x=\\frac{7}{24}" :db/ensure [:answer/validate]} {:db/id "question-8fa20dc6-b138-59bb-9538-21dc8c6a5944" :question/id #uuid "8fa20dc6-b138-59bb-9538-21dc8c6a5944" :question/math-academy-id "q-44322" :question/problem "Solve the equation $\\frac{5y+12}{4}=2y.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}\\frac{5y+12}{4} & =2y \\\\ 4(\\frac{5y+12}{4}) & =4\\cdot 2y \\\\ \\cancel{4}(\\frac{5y+12}{\\cancel{4}}) & =8y \\\\ 5y+12 & =8y\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}5y+12 & =8y \\\\ 5y+12-5y & =8y-5y \\\\ 12 & =3y \\\\ \\frac{12}{3} & =\\frac{3y}{3} \\\\ 4 & =\\frac{\\cancel{3}y}{\\cancel{3}} \\\\ 4 & =y \\\\ y & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-43e4aa17-831a-5ff0-a5f2-ab1d81f89e1b"] :db/ensure [:question/validate]} {:db/id "answer-field-43e4aa17-831a-5ff0-a5f2-ab1d81f89e1b" :answer-field/id #uuid "43e4aa17-831a-5ff0-a5f2-ab1d81f89e1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f14f0398-d411-5c4d-9c85-b0819ec4b38c" :answer-field/choices ["answer-bde50a7e-ece4-5c06-8140-e186ffa30b0d" "answer-f14f0398-d411-5c4d-9c85-b0819ec4b38c" "answer-11a5337e-2e38-5339-a515-cdcc91c5a4ca" "answer-9db708cf-c16f-5448-be3f-8b07d17e63e2" "answer-ff176dd3-9361-5d03-9bb8-d3677c057f4c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bde50a7e-ece4-5c06-8140-e186ffa30b0d" :answer/id #uuid "bde50a7e-ece4-5c06-8140-e186ffa30b0d" :answer/type :answer.type/math :answer/value "y=3" :db/ensure [:answer/validate]} {:db/id "answer-f14f0398-d411-5c4d-9c85-b0819ec4b38c" :answer/id #uuid "f14f0398-d411-5c4d-9c85-b0819ec4b38c" :answer/type :answer.type/math :answer/value "y=4" :db/ensure [:answer/validate]} {:db/id "answer-11a5337e-2e38-5339-a515-cdcc91c5a4ca" :answer/id #uuid "11a5337e-2e38-5339-a515-cdcc91c5a4ca" :answer/type :answer.type/math :answer/value "y=\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "answer-9db708cf-c16f-5448-be3f-8b07d17e63e2" :answer/id #uuid "9db708cf-c16f-5448-be3f-8b07d17e63e2" :answer/type :answer.type/math :answer/value "y=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ff176dd3-9361-5d03-9bb8-d3677c057f4c" :answer/id #uuid "ff176dd3-9361-5d03-9bb8-d3677c057f4c" :answer/type :answer.type/math :answer/value "y=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-2de1d7cb-6ad2-5a64-8b22-82ed6e525706" :question/id #uuid "2de1d7cb-6ad2-5a64-8b22-82ed6e525706" :question/math-academy-id "q-178530" :question/problem "If $5y-7=\\frac{16-5y}{2},$ then $y=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying both sides by $2.$ \nWe must make sure that all of the terms on the left-hand side are multiplied by $2:$\n\n$$\n\\begin{aligned}5y-7 & =\\frac{16-5y}{2} \\\\ 2(5y-7) & =2(\\frac{16-5y}{2}) \\\\ 2\\cdot 5y+2\\cdot (-7) & =\\cancel{2}(\\frac{16-5y}{\\cancel{2}}) \\\\ 10y-14 & =16-5y\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}10y-14 & =16-5y \\\\ 10y-14+5y & =16-5y+5y \\\\ 15y-14 & =16 \\\\ 15y-14+14 & =16+14 \\\\ 15y & =30 \\\\ \\frac{15y}{15} & =\\frac{30}{15} \\\\ \\frac{\\cancel{15}y}{\\cancel{15}} & =\\frac{30}{15} \\\\ y & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9bb77437-7bcb-5f22-a30d-4200f3ac2fa2"] :db/ensure [:question/validate]} {:db/id "answer-field-9bb77437-7bcb-5f22-a30d-4200f3ac2fa2" :answer-field/id #uuid "9bb77437-7bcb-5f22-a30d-4200f3ac2fa2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-35af7295-abe0-53a4-901b-385d93918397" :answer-field/choices ["answer-35af7295-abe0-53a4-901b-385d93918397"] :db/ensure [:answer-field/validate]} {:db/id "answer-35af7295-abe0-53a4-901b-385d93918397" :answer/id #uuid "35af7295-abe0-53a4-901b-385d93918397" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-595c6cf3-442f-5ee5-b303-59b7320fc44a" :question/id #uuid "595c6cf3-442f-5ee5-b303-59b7320fc44a" :question/math-academy-id "q-171596" :question/problem "If $\\frac{3+m}{7}=2m-7,$ then $m=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $7$:\n\n$$\n\\begin{aligned}\\frac{3+m}{7} & =2m-7 \\\\ 7(\\frac{3+m}{7}) & =7(2m-7) \\\\ \\cancel{7}(\\frac{3+m}{\\cancel{7}}) & =14m-49 \\\\ 3+m & =14m-49\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3+m & =14m-49 \\\\ 3+m-m & =14m-49-m \\\\ 3 & =13m-49 \\\\ 3+49 & =13m-49+49 \\\\ 52 & =13m \\\\ \\frac{52}{13} & =\\frac{13m}{13} \\\\ 4 & =\\frac{\\cancel{13}m}{\\cancel{13}} \\\\ 4 & =m \\\\ m & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9161d309-95b3-56aa-8ea9-ac7e501ed385"] :db/ensure [:question/validate]} {:db/id "answer-field-9161d309-95b3-56aa-8ea9-ac7e501ed385" :answer-field/id #uuid "9161d309-95b3-56aa-8ea9-ac7e501ed385" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2a9ceb97-7185-5891-985c-632bd2b70a6d" :answer-field/choices ["answer-2a9ceb97-7185-5891-985c-632bd2b70a6d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a9ceb97-7185-5891-985c-632bd2b70a6d" :answer/id #uuid "2a9ceb97-7185-5891-985c-632bd2b70a6d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-ba37a28b-262f-5934-93da-824b60873e74" :question/id #uuid "ba37a28b-262f-5934-93da-824b60873e74" :question/math-academy-id "q-101642" :question/problem "Solve for $t$ where $3(2t-1)=\\frac{4t-3}{2}.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $2$:\n\n$$\n\\begin{aligned}3(2t-1) & =\\frac{4t-3}{2} \\\\ 2\\cdot (3(2t-1)) & =2(\\frac{4t-3}{2}) \\\\ 6(2t-1) & =\\cancel{2}(\\frac{4t-3}{\\cancel{2}}) \\\\ 12t-6 & =4t-3\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}12t-6 & =4t-3 \\\\ 12t-6-4t & =-3+4t-4t \\\\ 8t-6 & =-3 \\\\ 8t-6+6 & =-3+6 \\\\ 8t & =3 \\\\ \\frac{8t}{8} & =\\frac{3}{8} \\\\ t & =\\frac{3}{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-87558509-bc3d-5cff-8d80-67471b464e32"] :db/ensure [:question/validate]} {:db/id "answer-field-87558509-bc3d-5cff-8d80-67471b464e32" :answer-field/id #uuid "87558509-bc3d-5cff-8d80-67471b464e32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-371b284e-75fc-5ae0-805b-4dfcf7fe1204" :answer-field/choices ["answer-dbf9705c-c47b-5a06-8ca9-7a40b09a14b7" "answer-32deff54-cf1b-51d8-98a8-17edf2755d74" "answer-bc0f1775-39be-5d30-a765-a264293338f4" "answer-371b284e-75fc-5ae0-805b-4dfcf7fe1204" "answer-34a63bf2-dc91-5faa-acd3-2a97efc245c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbf9705c-c47b-5a06-8ca9-7a40b09a14b7" :answer/id #uuid "dbf9705c-c47b-5a06-8ca9-7a40b09a14b7" :answer/type :answer.type/math :answer/value "t=-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-32deff54-cf1b-51d8-98a8-17edf2755d74" :answer/id #uuid "32deff54-cf1b-51d8-98a8-17edf2755d74" :answer/type :answer.type/math :answer/value "t=-\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "answer-bc0f1775-39be-5d30-a765-a264293338f4" :answer/id #uuid "bc0f1775-39be-5d30-a765-a264293338f4" :answer/type :answer.type/math :answer/value "t=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-371b284e-75fc-5ae0-805b-4dfcf7fe1204" :answer/id #uuid "371b284e-75fc-5ae0-805b-4dfcf7fe1204" :answer/type :answer.type/math :answer/value "t=\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "answer-34a63bf2-dc91-5faa-acd3-2a97efc245c3" :answer/id #uuid "34a63bf2-dc91-5faa-acd3-2a97efc245c3" :answer/type :answer.type/math :answer/value "t=\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "question-6dc17e55-1c4a-5a93-b3b8-937d5766223d" :question/id #uuid "6dc17e55-1c4a-5a93-b3b8-937d5766223d" :question/math-academy-id "q-101643" :question/problem "Solve for $n$ where $\\frac{2n-8}{3}=-6(n+1).$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $3$:\n\n$$\n\\begin{aligned}\\frac{2n-8}{3} & =-6(n+1) \\\\ 3\\cdot (\\frac{2n-8}{3}) & =3\\cdot (-6(n+1)) \\\\ \\cancel{3}\\cdot (\\frac{2n-8}{\\cancel{3}}) & =-18(n+1) \\\\ 2n-8 & =-18n-18\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}2n-8 & =-18n-18 \\\\ 2n-8+18n & =-18n-18+18n \\\\ 20n-8 & =-18 \\\\ 20n-8+8 & =-18+8 \\\\ 20n & =-10 \\\\ \\frac{20n}{20} & =\\frac{-10}{20} \\\\ n & =-\\frac{10}{20} \\\\ n & =-\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3118df3e-2303-5bed-8677-887ac749f191"] :db/ensure [:question/validate]} {:db/id "answer-field-3118df3e-2303-5bed-8677-887ac749f191" :answer-field/id #uuid "3118df3e-2303-5bed-8677-887ac749f191" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7cb66b61-f470-55f4-ae65-74b5aa5faafb" :answer-field/choices ["answer-7cb66b61-f470-55f4-ae65-74b5aa5faafb" "answer-c231de60-ae32-5e60-a3aa-6f1d31329ab0" "answer-3e6d0390-6f5d-5ea3-8acf-4e61f32f370c" "answer-4c811b7c-2599-5f3e-996d-248cb7234111" "answer-6c6b7565-5ec4-5c69-b184-92b242a17920"] :db/ensure [:answer-field/validate]} {:db/id "answer-7cb66b61-f470-55f4-ae65-74b5aa5faafb" :answer/id #uuid "7cb66b61-f470-55f4-ae65-74b5aa5faafb" :answer/type :answer.type/math :answer/value "n=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c231de60-ae32-5e60-a3aa-6f1d31329ab0" :answer/id #uuid "c231de60-ae32-5e60-a3aa-6f1d31329ab0" :answer/type :answer.type/math :answer/value "n=-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3e6d0390-6f5d-5ea3-8acf-4e61f32f370c" :answer/id #uuid "3e6d0390-6f5d-5ea3-8acf-4e61f32f370c" :answer/type :answer.type/math :answer/value "n=-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4c811b7c-2599-5f3e-996d-248cb7234111" :answer/id #uuid "4c811b7c-2599-5f3e-996d-248cb7234111" :answer/type :answer.type/math :answer/value "n=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6c6b7565-5ec4-5c69-b184-92b242a17920" :answer/id #uuid "6c6b7565-5ec4-5c69-b184-92b242a17920" :answer/type :answer.type/math :answer/value "n=\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id 17592186079717 :tutorial/content "Whenever we have a fraction in an equation, we apply the multiplication principle to get rid of it. For example, consider the equation below:\n\n$$\n\\dfrac{2x+12}{3} =6\n$$\n\nSince the opposite of dividing by $3$ is multiplying by $3$, we apply the multiplication principle and multiply both sides of the equation by $3$:\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\t\t\\dfrac{2x+12}{3} &=6\\\n\t\t3 \\cdot \\left(\\dfrac{2x+12}{3}\\right) &= 3 \\cdot 6\\\t\n\t\t\\cancel{3} \\cdot \\left(\\dfrac{2x+12}{\\cancel{3}}\\right) &= 18 \\\t\n\t\t2x+12 &= 18\n\t}\n$$\n\nThe process of removing the fraction is called **clearing the rational expression**. We now have an equation that we can solve using the usual methods:\n\n$$\n\\eqalign{\n\t\t2x+12 &= 18\\\n\t\t2x+12-12 &=18-12 \\   \n\t\t2x &=6 \\   \n\t\t\\dfrac{2x}{2} &=\\dfrac{6}{2} \\\n\t\tx &=3\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186078673 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} [:db/retract 17592186155973 :answer-field/choices 17592186155974] [:db/retract 17592186155973 :answer-field/choices 17592186155975] [:db/retract 17592186155973 :answer-field/choices 17592186155976] [:db/retract 17592186155973 :answer-field/choices 17592186155977] [:db/retract 17592186155973 :answer-field/choices 17592186155978] [:db/retract 17592186155985 :answer-field/choices 17592186155986] [:db/retract 17592186155985 :answer-field/choices 17592186155987] [:db/retract 17592186155985 :answer-field/choices 17592186155988] [:db/retract 17592186155985 :answer-field/choices 17592186155989] [:db/retract 17592186155985 :answer-field/choices 17592186155990] {:db/id 17592186157303 :knowledge-point/questions ["question-2f7086f8-f36f-50c7-ad0c-2ef637d5cf6f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157107 :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(-4,5),$ and passes through the point $(-2,3).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx - h = 2pt, \\qquad y - k = pt^2,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k) = (-4,5),$ and so we have\n\n$$\nx + 4 = 2pt, \\qquad y - 5 = pt^2.\n$$\n\nSince the parabola passes through $(-2, 3),$ we can substitute $x=-2$ and $y=3$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}2=2pt \\\\ -2=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}2 & =2pt \\\\ 1 & =pt \\\\ t & =\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-2 & =p{(\\frac{1}{p})}^{2} \\\\ -2 & =\\frac{1}{p} \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx + 4 = 2\\left(-\\dfrac12\\right)t, \\qquad y - 5 = \\left(-\\dfrac12\\right)t^2 ,\n$$\n\nwhich simplify to\n\n$$\nx + 4 = -t, \\qquad y - 5 = -\\dfrac12t^2 .\n$$" :db/ensure [:question/validate]} {:db/id 17592186157304 :knowledge-point/questions ["question-0668c7c6-b240-56da-94fb-07d6ea371e42" "question-da2c9d27-2db1-52e6-a2e3-b28e1798b755"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157108 :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(-3,2),$ and passes through the point $(1,0).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(h,k)$ are\n\n$$\nx - h = pt^2, \\qquad y - k = 2pt,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k) = (-3,2),$ and so we have\n\n$$\nx+3 = pt^2, \\qquad y-2 = 2pt.\n$$\n\nSince the parabola passes through $(1,0),$ we can substitute $x=1$ and $y=0$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}4=p{t}^{2} \\\\ -2=2pt.\\end{aligned}\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}-2 & =2pt \\\\ t & =-\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}4 & =p{(-\\frac{1}{p})}^{2} \\\\ 4 & =p\\cdot \\frac{1}{{p}^{2}} \\\\ 4 & =\\frac{1}{p} \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+3 = \\left(\\dfrac{1}{4}\\right)t^2, \\qquad y -2 = 2\\left(\\dfrac{1}{4}\\right)t ,\n$$\n\nwhich simplify to\n\n$$\nx+3 = \\dfrac{1}{4}t^2, \\qquad y -2= \\dfrac{1}{2}t .\n$$" :db/ensure [:question/validate]} {:db/id 17592186157305 :knowledge-point/questions ["question-2210e304-f1be-5ab9-a627-e9a4a8410a48" "question-c4ed1fe6-d320-5a32-bfb8-73846e898159" "question-c50b5890-601e-5b61-a526-2b2221f83863"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157842 :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate a vertical parabola that has its vertex at $(1,-2)$ and which passes through the point $(-3,6)?$" :question/worked-solution "The parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(1,-2),$ and so we have\n\n$$\nx-1=2pt,\\,y+2=p{t}^{2}.\n$$\n\nSince the parabola passes through $(-3,6),$ we can substitute $x=-3$ and $y=6$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-4=2pt \\\\ 8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-4 & =2pt \\\\ t & =-\\frac{2}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}8 & =p{(-\\frac{2}{p})}^{2} \\\\ 8 & =p\\cdot \\frac{4}{{p}^{2}} \\\\ 8 & =\\frac{4}{p} \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-1=2(\\frac{1}{2})t,\\,y-(-2)=(\\frac{1}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx-1=t,\\,y+2=\\frac{1}{2}{t}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186155973 :answer-field/correct "answer-54fff804-525b-5500-af11-d8004b02fdf3" :answer-field/choices ["answer-50ed4773-3ed9-5b89-9333-b39bf928515e" "answer-1e9ab5f9-e0df-5f65-a021-59f32c7c7165" "answer-bdb30a1c-48e6-50f2-b4fa-5876780a57ae" "answer-54fff804-525b-5500-af11-d8004b02fdf3" "answer-f03d06b8-4245-5331-81e6-9913e1da8421"] :db/ensure [:answer-field/validate]} {:db/id "answer-50ed4773-3ed9-5b89-9333-b39bf928515e" :answer/id #uuid "50ed4773-3ed9-5b89-9333-b39bf928515e" :answer/type :answer.type/math :answer/value "x+1={t}^{2},\\,y-2=\\frac{1}{2}t" :db/ensure [:answer/validate]} {:db/id "answer-1e9ab5f9-e0df-5f65-a021-59f32c7c7165" :answer/id #uuid "1e9ab5f9-e0df-5f65-a021-59f32c7c7165" :answer/type :answer.type/math :answer/value "x+3=2t,\\,y-6={t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bdb30a1c-48e6-50f2-b4fa-5876780a57ae" :answer/id #uuid "bdb30a1c-48e6-50f2-b4fa-5876780a57ae" :answer/type :answer.type/math :answer/value "x-1=\\frac{1}{2}{t}^{2},\\,y+2=t" :db/ensure [:answer/validate]} {:db/id "answer-54fff804-525b-5500-af11-d8004b02fdf3" :answer/id #uuid "54fff804-525b-5500-af11-d8004b02fdf3" :answer/type :answer.type/math :answer/value "x-1=t,\\,y+2=\\frac{1}{2}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f03d06b8-4245-5331-81e6-9913e1da8421" :answer/id #uuid "f03d06b8-4245-5331-81e6-9913e1da8421" :answer/type :answer.type/math :answer/value "x-3=-t,\\,y+6=-2{t}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186354344 :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(2,-2),$ and passes through the point $(4,2).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(2,-2),$ and so we have\n\n$$\nx-2=2pt,\\,y+2=p{t}^{2}.\n$$\n\nSince the parabola passes through $(4,2),$ we can substitute $x=4$ and $y=2$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}2=2pt \\\\ 4=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}2 & =2pt \\\\ 1 & =pt \\\\ t & =\\frac{1}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}4 & =p{(\\frac{1}{p})}^{2} \\\\ 4 & =p\\cdot \\frac{1}{{p}^{2}} \\\\ 4 & =\\frac{1}{p} \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-2=2(\\frac{1}{4})t,\\,y+2=(\\frac{1}{4}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx-2=\\frac{1}{2}t,\\,y+2=\\frac{1}{4}{t}^{2}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186354345 :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(1,2),$ and passes through the point $(7,-4).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(1,2),$ and so we have\n\n$$\nx-1=2pt,\\,y-2=p{t}^{2}.\n$$\n\nSince the parabola passes through $(7,-4),$ we can substitute $x=7$ and $y=-4$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}6=2pt \\\\ -6=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}6 & =2pt \\\\ t & =\\frac{3}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-6 & =p{(\\frac{3}{p})}^{2} \\\\ -6 & =p\\cdot \\frac{9}{{p}^{2}} \\\\ -6 & =\\frac{9}{p} \\\\ p & =-\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-1=2(-\\frac{3}{2})t,\\,y-2=(-\\frac{3}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx-1=-3t,\\,y-2=-\\frac{3}{2}{t}^{2}.\n$$" :db/ensure [:question/validate]} {:db/id "question-2f7086f8-f36f-50c7-ad0c-2ef637d5cf6f" :question/id #uuid "2f7086f8-f36f-50c7-ad0c-2ef637d5cf6f" :question/math-academy-id "q-106454" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate a vertical parabola that has its vertex at $(-2,3)$ and which passes through the point $(-10,-5)?$" :question/worked-solution "The parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(-2,3),$ and so we have\n\n$$\nx+2=2pt,\\,y-3=p{t}^{2}.\n$$\n\nSince the parabola passes through $(-10,-5),$ we can substitute $x=-10$ and $y=-5$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-8=2pt \\\\ -8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-8 & =2pt \\\\ t & =-\\frac{4}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-8 & =p{(-\\frac{4}{p})}^{2} \\\\ -8 & =p\\cdot \\frac{16}{{p}^{2}} \\\\ -1 & =\\frac{2}{p} \\\\ p & =-2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+2=2(-2)t,\\,y-3=(-2){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx+2=-4t,\\,y-3=-2{t}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bf911a04-5f91-5fae-b9c3-9dfaff9a03ec"] :db/ensure [:question/validate]} {:db/id "answer-field-bf911a04-5f91-5fae-b9c3-9dfaff9a03ec" :answer-field/id #uuid "bf911a04-5f91-5fae-b9c3-9dfaff9a03ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a0f9e45c-7062-5f28-bc03-f34206a84654" :answer-field/choices ["answer-923d4e3a-5bcb-5052-8780-5da21cc38f2b" "answer-ba7bd60d-4e3f-5c71-ba73-a9b888732f80" "answer-a0f9e45c-7062-5f28-bc03-f34206a84654" "answer-db34ee1a-a069-58c3-b395-c6c0f3a56659" "answer-0303266d-f1ac-53c8-9223-9776f8286eb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-923d4e3a-5bcb-5052-8780-5da21cc38f2b" :answer/id #uuid "923d4e3a-5bcb-5052-8780-5da21cc38f2b" :answer/type :answer.type/math :answer/value "x+2=-2t,\\,\\,y-3=-{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ba7bd60d-4e3f-5c71-ba73-a9b888732f80" :answer/id #uuid "ba7bd60d-4e3f-5c71-ba73-a9b888732f80" :answer/type :answer.type/math :answer/value "x+2=-4t,\\,\\,y+3=-2{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a0f9e45c-7062-5f28-bc03-f34206a84654" :answer/id #uuid "a0f9e45c-7062-5f28-bc03-f34206a84654" :answer/type :answer.type/math :answer/value "x+2=-4t,\\,\\,y-3=-2{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-db34ee1a-a069-58c3-b395-c6c0f3a56659" :answer/id #uuid "db34ee1a-a069-58c3-b395-c6c0f3a56659" :answer/type :answer.type/math :answer/value "x+2=-t,\\,\\,y-3=-\\frac{1}{2}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0303266d-f1ac-53c8-9223-9776f8286eb1" :answer/id #uuid "0303266d-f1ac-53c8-9223-9776f8286eb1" :answer/type :answer.type/math :answer/value "x-2=-4t,\\,\\,y-3=-2{t}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186157844 :question/problem "![](images/34/34e9beebbecc3eff77faa9b01f4684e334ec7cbdcbd9b00e328f95f7be88c1d4.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(-2,4),$ and passes through the point $(2,2).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=2pt,\\,y-k=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(-2,4),$ and so we have\n\n$$\nx+2=2pt,\\,y-4=p{t}^{2}.\n$$\n\nSince the parabola passes through $(2,2),$ we can substitute $x=2$ and $y=2$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}4=2pt \\\\ -2=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}4 & =2pt \\\\ 2 & =pt \\\\ t & =\\frac{2}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-2 & =p{(\\frac{2}{p})}^{2} \\\\ -2 & =p\\cdot \\frac{4}{{p}^{2}} \\\\ -2 & =\\frac{4}{p} \\\\ p & =-2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+2=2(-2)t,\\,y-4=(-2){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx+2=-4t,\\,y-4=-2{t}^{2}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186155985 :answer-field/correct "answer-7e7a6075-a431-53ee-bc18-5eceb959098b" :answer-field/choices ["answer-7e7a6075-a431-53ee-bc18-5eceb959098b" "answer-b8700ae7-73f0-5f02-8801-a5a0722e1c12" "answer-e149d119-0167-5e62-a13f-d6a2d2aeb067" "answer-39529e1e-2088-505f-9e34-bbc1c3be2f24" "answer-471851da-2777-566c-aca4-80a6129293ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e7a6075-a431-53ee-bc18-5eceb959098b" :answer/id #uuid "7e7a6075-a431-53ee-bc18-5eceb959098b" :answer/type :answer.type/math :answer/value "x+2=-4t,\\,y-4=-2{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-b8700ae7-73f0-5f02-8801-a5a0722e1c12" :answer/id #uuid "b8700ae7-73f0-5f02-8801-a5a0722e1c12" :answer/type :answer.type/math :answer/value "x+2=4t,\\,y-4=2{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e149d119-0167-5e62-a13f-d6a2d2aeb067" :answer/id #uuid "e149d119-0167-5e62-a13f-d6a2d2aeb067" :answer/type :answer.type/math :answer/value "x+4=-2{t}^{2},\\,y-2=-t" :db/ensure [:answer/validate]} {:db/id "answer-39529e1e-2088-505f-9e34-bbc1c3be2f24" :answer/id #uuid "39529e1e-2088-505f-9e34-bbc1c3be2f24" :answer/type :answer.type/math :answer/value "x+4=2t,\\,y-2=-{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-471851da-2777-566c-aca4-80a6129293ed" :answer/id #uuid "471851da-2777-566c-aca4-80a6129293ed" :answer/type :answer.type/math :answer/value "x-2=-4{t}^{2},\\,y+4=-2t" :db/ensure [:answer/validate]} {:db/id "question-0668c7c6-b240-56da-94fb-07d6ea371e42" :question/id #uuid "0668c7c6-b240-56da-94fb-07d6ea371e42" :question/math-academy-id "q-84845" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation $(y+4)^{2}=-3(x-3)?$" :question/worked-solution "The parametric equations of a horizontal parabola $(y-k)^{2}=4p(x-h)$ that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case $(y-k)^{2}=4p(x-h),$ we see that the parabola has its vertex at $(h,k)=(3,-4).$ So we have\n\n$$\nx-3=p{t}^{2},\\,y+4=2pt.\n$$\n\nNow, comparing the right-hand sides of the given Cartesian equation and the general case, then solving for $p,$ we get\n\n$$\n\\begin{aligned}4p(x-h) & =-3(x-3) \\\\ 4p(x-3) & =-3(x-3) \\\\ 4p & =-3 \\\\ p & =-\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-3=(-\\frac{3}{4}){t}^{2},\\,y+4=2(-\\frac{3}{4})t,\n$$\n\nwhich simplify to\n\n$$\nx-3=-\\frac{3}{4}{t}^{2},\\,y+4=-\\frac{3}{2}t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a437a535-c718-5028-9485-0dd9f5d01fb0"] :db/ensure [:question/validate]} {:db/id "answer-field-a437a535-c718-5028-9485-0dd9f5d01fb0" :answer-field/id #uuid "a437a535-c718-5028-9485-0dd9f5d01fb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6bca42c9-1e9a-518c-a98e-83ca02ecb23d" :answer-field/choices ["answer-2eb9df3b-ad51-5fd3-a5d7-0378bb8e50f6" "answer-746886be-acda-5c82-9239-d30a7dc5ecc5" "answer-57c02f6e-98c1-5975-8d55-a608122a6888" "answer-50351eff-4bc5-5559-b109-6e998a84a90f" "answer-6bca42c9-1e9a-518c-a98e-83ca02ecb23d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2eb9df3b-ad51-5fd3-a5d7-0378bb8e50f6" :answer/id #uuid "2eb9df3b-ad51-5fd3-a5d7-0378bb8e50f6" :answer/type :answer.type/math :answer/value "x+4=-6{t}^{2},\\,y-3=-t" :db/ensure [:answer/validate]} {:db/id "answer-746886be-acda-5c82-9239-d30a7dc5ecc5" :answer/id #uuid "746886be-acda-5c82-9239-d30a7dc5ecc5" :answer/type :answer.type/math :answer/value "x+4=-{t}^{2},\\,y-3=-6t" :db/ensure [:answer/validate]} {:db/id "answer-57c02f6e-98c1-5975-8d55-a608122a6888" :answer/id #uuid "57c02f6e-98c1-5975-8d55-a608122a6888" :answer/type :answer.type/math :answer/value "x-3=-3{t}^{2},\\,y+4=-6t" :db/ensure [:answer/validate]} {:db/id "answer-50351eff-4bc5-5559-b109-6e998a84a90f" :answer/id #uuid "50351eff-4bc5-5559-b109-6e998a84a90f" :answer/type :answer.type/math :answer/value "x-3=-\\frac{3}{2}{t}^{2},\\,y+4=-3t" :db/ensure [:answer/validate]} {:db/id "answer-6bca42c9-1e9a-518c-a98e-83ca02ecb23d" :answer/id #uuid "6bca42c9-1e9a-518c-a98e-83ca02ecb23d" :answer/type :answer.type/math :answer/value "x-3=-\\frac{3}{4}{t}^{2},\\,y+4=-\\frac{3}{2}t" :db/ensure [:answer/validate]} {:db/id "question-da2c9d27-2db1-52e6-a2e3-b28e1798b755" :question/id #uuid "da2c9d27-2db1-52e6-a2e3-b28e1798b755" :question/math-academy-id "q-84846" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation $(y+2)^{2}=\\frac{1}{2}(x+5)?$" :question/worked-solution "The parametric equations of a horizontal parabola $(y-k)^{2}=4p(x-h)$ that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case $(y-k)^{2}=4p(x-h),$ we see that the parabola has its vertex at $(h,k)=(-5,-2).$ So we have\n\n$$\nx+5=p{t}^{2},\\,y+2=2pt.\n$$\n\nNow, comparing the right-hand sides of the given Cartesian equation and the general case, then solving for $p,$ we get\n\n$$\n\\begin{aligned}4p(x-h) & =\\frac{1}{2}(x+5) \\\\ 4p(x+5) & =\\frac{1}{2}(x+5) \\\\ 4p & =\\frac{1}{2} \\\\ p & =\\frac{1}{8}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx+5=(\\frac{1}{8}){t}^{2},\\,y+2=2(\\frac{1}{8})t,\n$$\n\nwhich simplify to\n\n$$\nx+5=\\frac{1}{8}{t}^{2},\\,y+2=\\frac{1}{4}t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d889d998-6d7a-58b2-a490-fd41b8228c67"] :db/ensure [:question/validate]} {:db/id "answer-field-d889d998-6d7a-58b2-a490-fd41b8228c67" :answer-field/id #uuid "d889d998-6d7a-58b2-a490-fd41b8228c67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e4a770e-5b76-5688-9d7d-d367b29628f6" :answer-field/choices ["answer-30ebd37e-c666-5413-8dba-6706d27b3ffb" "answer-6e4a770e-5b76-5688-9d7d-d367b29628f6" "answer-5471d6a5-d5f1-5e64-b0d4-d247884f4266" "answer-68408a08-0e06-57f9-927a-8ec79117001a" "answer-956916df-320e-5b5e-b828-825e40cf6ee5"] :db/ensure [:answer-field/validate]} {:db/id "answer-30ebd37e-c666-5413-8dba-6706d27b3ffb" :answer/id #uuid "30ebd37e-c666-5413-8dba-6706d27b3ffb" :answer/type :answer.type/math :answer/value "x+5=\\frac{1}{2}{t}^{2},\\,y+2=t" :db/ensure [:answer/validate]} {:db/id "answer-6e4a770e-5b76-5688-9d7d-d367b29628f6" :answer/id #uuid "6e4a770e-5b76-5688-9d7d-d367b29628f6" :answer/type :answer.type/math :answer/value "x+5=\\frac{1}{8}{t}^{2},\\,y+2=\\frac{1}{4}t" :db/ensure [:answer/validate]} {:db/id "answer-5471d6a5-d5f1-5e64-b0d4-d247884f4266" :answer/id #uuid "5471d6a5-d5f1-5e64-b0d4-d247884f4266" :answer/type :answer.type/math :answer/value "x+5={t}^{2},\\,y+2=2t" :db/ensure [:answer/validate]} {:db/id "answer-68408a08-0e06-57f9-927a-8ec79117001a" :answer/id #uuid "68408a08-0e06-57f9-927a-8ec79117001a" :answer/type :answer.type/math :answer/value "x-5=2{t}^{2},\\,y-2=t" :db/ensure [:answer/validate]} {:db/id "answer-956916df-320e-5b5e-b828-825e40cf6ee5" :answer/id #uuid "956916df-320e-5b5e-b828-825e40cf6ee5" :answer/type :answer.type/math :answer/value "x-5=\\frac{1}{4}{t}^{2},\\,y-2=\\frac{1}{8}t" :db/ensure [:answer/validate]} {:db/id 17592186157845 :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(5,-1),$ and passes through the point $(17,11).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(h,k)$ are\n\n$$\nx-h=p{t}^{2},\\,y-k=2pt,\n$$\n\nwhere $p$ is constant.\n\nIn our case, $(h,k)=(5,-1),$ and so we have\n\n$$\nx-5=p{t}^{2},\\,y+1=2pt.\n$$\n\nSince the parabola passes through $(17,11),$ we can substitute $x=17$ and $y=11$ into the parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}12=p{t}^{2} \\\\ 12=2pt.\\end{aligned}\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}12 & =2pt \\\\ 6 & =pt \\\\ t & =\\frac{6}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}12 & =p{(\\frac{6}{p})}^{2} \\\\ 12 & =p\\cdot \\frac{36}{{p}^{2}} \\\\ 12 & =\\frac{36}{p} \\\\ p & =\\frac{36}{12} \\\\ p & =3.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx-5=(3){t}^{2},\\,y+1=2(3)t,\n$$\n\nwhich simplify to\n\n$$\nx-5=3{t}^{2},\\,y+1=6t.\n$$" :db/ensure [:question/validate]} {:db/id "question-2210e304-f1be-5ab9-a627-e9a4a8410a48" :question/id #uuid "2210e304-f1be-5ab9-a627-e9a4a8410a48" :question/math-academy-id "q-323132" :question/problem "Consider the following parametric equation of the parabola \n\n$$\nx-1=3t,\\,y+4={t}^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this parabola is\n\n$(x\\,-$\n{{field-1}}$)^{2}=$\n{{field-2}}." :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =\\frac{x-1}{3},\\,{t}^{2}=y+4.\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{x-1}{3})}^{2} \\\\  & =\\frac{(x-1)^{2}}{9}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=y+4$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{9} & =y+4 \\\\ {(x-1)}^{2} & =9(y+4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5dc01537-89dc-53d0-b0f7-16752ad38f83" "answer-field-5ad4200b-af15-5126-a1e0-17c3d7a4e5d0"] :db/ensure [:question/validate]} {:db/id "answer-field-5dc01537-89dc-53d0-b0f7-16752ad38f83" :answer-field/id #uuid "5dc01537-89dc-53d0-b0f7-16752ad38f83" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-900f227c-0435-5540-af63-e96714d948bb" :answer-field/choices ["answer-900f227c-0435-5540-af63-e96714d948bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-900f227c-0435-5540-af63-e96714d948bb" :answer/id #uuid "900f227c-0435-5540-af63-e96714d948bb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-5ad4200b-af15-5126-a1e0-17c3d7a4e5d0" :answer-field/id #uuid "5ad4200b-af15-5126-a1e0-17c3d7a4e5d0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6342237f-0750-5d97-83a5-6340dfaa32e1" :answer-field/choices ["answer-6342237f-0750-5d97-83a5-6340dfaa32e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6342237f-0750-5d97-83a5-6340dfaa32e1" :answer/id #uuid "6342237f-0750-5d97-83a5-6340dfaa32e1" :answer/type :answer.type/math :answer/value "9(y+4)" :db/ensure [:answer/validate]} {:db/id "question-c4ed1fe6-d320-5a32-bfb8-73846e898159" :question/id #uuid "c4ed1fe6-d320-5a32-bfb8-73846e898159" :question/math-academy-id "q-323212" :question/problem "Consider the following parametric equation of the parabola \n\n$$\nx-4=3{t}^{2},\\,y+2=6t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this parabola is\n\n$(y\\,+$\n{{field-1}}$)^{2}=$\n{{field-2}}." :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{x-4}{3},\\,t=\\frac{y+2}{6}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{y+2}{6})}^{2} \\\\  & =\\frac{(y+2)^{2}}{36}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=\\frac{x-4}{3}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{(y+2)^{2}}{36} & =\\frac{x-4}{3} \\\\ (y+2)^{2} & =36\\cdot (\\frac{x-4}{3}) \\\\ (y+2)^{2} & =12(x-4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-987f26a7-d980-5f3c-aef7-b7ef1d95d1d4" "answer-field-60677215-48aa-5d3e-81b4-2fe26b9d5615"] :db/ensure [:question/validate]} {:db/id "answer-field-987f26a7-d980-5f3c-aef7-b7ef1d95d1d4" :answer-field/id #uuid "987f26a7-d980-5f3c-aef7-b7ef1d95d1d4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-df2fba26-5f67-5068-9b55-1835d94b0f66" :answer-field/choices ["answer-df2fba26-5f67-5068-9b55-1835d94b0f66"] :db/ensure [:answer-field/validate]} {:db/id "answer-df2fba26-5f67-5068-9b55-1835d94b0f66" :answer/id #uuid "df2fba26-5f67-5068-9b55-1835d94b0f66" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-60677215-48aa-5d3e-81b4-2fe26b9d5615" :answer-field/id #uuid "60677215-48aa-5d3e-81b4-2fe26b9d5615" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-239c0bea-6ec4-55a9-ba55-06444b1b6005" :answer-field/choices ["answer-239c0bea-6ec4-55a9-ba55-06444b1b6005"] :db/ensure [:answer-field/validate]} {:db/id "answer-239c0bea-6ec4-55a9-ba55-06444b1b6005" :answer/id #uuid "239c0bea-6ec4-55a9-ba55-06444b1b6005" :answer/type :answer.type/math :answer/value "12(x-4)" :db/ensure [:answer/validate]} {:db/id "question-c50b5890-601e-5b61-a526-2b2221f83863" :question/id #uuid "c50b5890-601e-5b61-a526-2b2221f83863" :question/math-academy-id "q-84852" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx+1=\\frac{3}{4}{t}^{2},\\,y+2=\\frac{3}{2}t,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{4(x+1)}{3},\\,t=\\frac{2(y+2)}{3}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{2(y+2)}{3})}^{2} \\\\  & =\\frac{4(y+2)^{2}}{9}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=\\frac{4(x+1)}{3}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{4(y+2)^{2}}{9} & =\\frac{4(x+1)}{3} \\\\ (y+2)^{2} & =\\frac{9}{4}\\cdot (\\frac{4(x+1)}{3}) \\\\ (y+2)^{2} & =3(x+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8297d34d-1705-5fb7-8698-40fca163d6e7"] :db/ensure [:question/validate]} {:db/id "answer-field-8297d34d-1705-5fb7-8698-40fca163d6e7" :answer-field/id #uuid "8297d34d-1705-5fb7-8698-40fca163d6e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99cd9563-54d3-5b7d-8b1c-d33708f1a679" :answer-field/choices ["answer-99cd9563-54d3-5b7d-8b1c-d33708f1a679" "answer-c80b48be-9145-50c4-a5a3-de75c6e5b2a4" "answer-b168e266-4a99-588e-9178-cf1013be9d00" "answer-ed78aad1-fdf7-515b-89c3-467256a0cee5" "answer-dab38c33-dab6-5256-8c24-9c5a85a4e93b"] :db/ensure [:answer-field/validate]} {:db/id "answer-99cd9563-54d3-5b7d-8b1c-d33708f1a679" :answer/id #uuid "99cd9563-54d3-5b7d-8b1c-d33708f1a679" :answer/type :answer.type/math :answer/value "(y+2)^{2}=3(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-c80b48be-9145-50c4-a5a3-de75c6e5b2a4" :answer/id #uuid "c80b48be-9145-50c4-a5a3-de75c6e5b2a4" :answer/type :answer.type/math :answer/value "(y+2)^{2}=\\frac{1}{3}(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-b168e266-4a99-588e-9178-cf1013be9d00" :answer/id #uuid "b168e266-4a99-588e-9178-cf1013be9d00" :answer/type :answer.type/math :answer/value "(y+2)^{2}=\\frac{3}{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-ed78aad1-fdf7-515b-89c3-467256a0cee5" :answer/id #uuid "ed78aad1-fdf7-515b-89c3-467256a0cee5" :answer/type :answer.type/math :answer/value "(y-2)^{2}=3(x-1)" :db/ensure [:answer/validate]} {:db/id "answer-dab38c33-dab6-5256-8c24-9c5a85a4e93b" :answer/id #uuid "dab38c33-dab6-5256-8c24-9c5a85a4e93b" :answer/type :answer.type/math :answer/value "(y-2)^{2}=\\frac{3}{2}(x-1)" :db/ensure [:answer/validate]} {:db/id 17592186157492 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]} [:db/retract 17592186174840 :answer-field/choices 17592186174841] [:db/retract 17592186174840 :answer-field/choices 17592186174842] [:db/retract 17592186174840 :answer-field/choices 17592186174843] [:db/retract 17592186174840 :answer-field/choices 17592186174844] [:db/retract 17592186174840 :answer-field/choices 17592186174845] {:db/id 17592186176097 :knowledge-point/questions ["question-fbfe98b2-d913-5b5f-9244-1e7d8b4485eb" "question-5707b071-c7c6-5712-89ca-e66cbdfb1c32"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175761 :question/problem "From the information given below, find all of the angles that are congruent.\n\n$$\n\\begin{aligned}m∠A & ={10}^{∘}, \\\\ m∠B & ={40}^{∘}, \\\\ m∠C & ={80}^{∘}, \\\\ m∠D & ={90}^{∘}-m∠C, \\\\ m∠E & =m∠B.\\end{aligned}\n$$" :question/worked-solution "First, let's find the measures of $\\angle D$ and $\\angle E\\mathbin{:}$\n\n$$\n\\begin{aligned}m∠D & ={90}^{∘}-m∠C \\\\  & ={90}^{∘}-{80}^{∘} \\\\  & ={10}^{∘} \\\\  \\\\ m∠E & =m∠B \\\\  & ={40}^{∘}\\end{aligned}\n$$\n\nSo, we have:\n\n$$\n\\begin{aligned}m∠A & ={10}^{∘} \\\\ m∠B & ={40}^{∘} \\\\ m∠C & ={80}^{∘} \\\\ m∠D & ={10}^{∘} \\\\ m∠E & ={40}^{∘}\\end{aligned}\n$$\n\nWe have that $m \\angle A = m \\angle D$ and $m \\angle B = m \\angle E.$\n\nTherefore, $\\angle A \\cong \\angle D$ and $\\angle B \\cong \\angle E.$" :db/ensure [:question/validate]} {:db/id 17592186176098 :knowledge-point/questions ["question-e51f05e0-1186-559b-935a-5d0ce775e04e" "question-432febe7-1220-5082-90e3-bf3d1c64fe2c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175762 :question/problem "Which of the following statements are true regarding the angles shown below?\n\nI. $\\angle AOB\t\\cong \\angle COD$\n\nII. $\\angle COD \\cong \\angle BOC$\n\nIII. $m\\angle BOC = m\\angle DOE$\n\n![](images/7d/7d0729a38dd775d0f049656b23755ace3b42d07a4040004e14942c789544c30b.png)" :question/worked-solution "From the diagram, we see that \n\n- $\\angle AOB$ and $\\angle COD$ are each marked with a single hash mark \"$|$,\" while\n\n- $\\angle BOC$ and $\\angle DOE$ are each marked with a double hash mark \"$||.$\"\n\nTherefore,\n\n$$\n\\begin{aligned}∠AOB & ≅∠COD \\\\ ∠BOC & ≅∠DOE.\\end{aligned}\n$$\n\nConsequently, we have\n\n$$\n\\begin{aligned}m∠AOB & =m∠COD \\\\ m∠BOC & =m∠DOE.\\end{aligned}\n$$\n\nSo statements I and III are true, while statement II is false." :db/ensure [:question/validate]} {:db/id 17592186176044 :knowledge-point/questions ["question-38145db5-f11d-5939-a57b-880dc1abb8bc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175692 :question/problem "![](images/bd/bdaee2dee98e41505c8a35c617a8f4fc035125ea8d504efecbe58afc9f7fd06c.png)\n\nIn the figure above,  $m \\angle CBD = 5x - 5^\\circ$ and $m \\angle ABD =2x + 10^\\circ .$ If $\\angle CBD \\cong \\angle ABD$, find $m \\angle ABC.$" :question/worked-solution "Since $\\angle CBD \\cong \\angle ABD$, we have\n\n$$\n\\begin{aligned}m∠CBD & =m∠ABD \\\\ 5x-{5}^{∘} & =2x+{10}^{∘} \\\\ 5x & =2x+{15}^{∘} \\\\ 3x & ={15}^{∘} \\\\ x & ={5}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of $\\angle CBD$ is\n\n$$\nm \\angle CBD = 5x - 5^\\circ = 5 \\cdot 5^\\circ - 5^\\circ = 20^\\circ.\n$$\n\nSo, by the angle addition postulate,\n\n$$\n\\begin{aligned}m∠ABC & =m∠CBD+m∠ABD \\\\  & =m∠CBD+m∠CBD \\\\  & =2\\cdot m∠CBD \\\\  & =2\\cdot {20}^{∘} \\\\  & ={40}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-fbfe98b2-d913-5b5f-9244-1e7d8b4485eb" :question/id #uuid "fbfe98b2-d913-5b5f-9244-1e7d8b4485eb" :question/math-academy-id "q-103249" :question/problem "![](images/cb/cb2cda27c9ca2744c059279e853969858a7b3d1882cde343177badc7aa33145d.png)\n\nWhich of the angles shown above are congruent?" :question/worked-solution "From the diagram, we see that:\n\n$$\n\\begin{aligned}m∠1 & ={25}^{∘} \\\\ m∠2 & ={75}^{∘} \\\\ m∠3 & ={75}^{∘}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∠2 & ≅∠3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-484e629d-dc7d-5e0c-9c4a-71a204024442"] :db/ensure [:question/validate]} {:db/id "answer-field-484e629d-dc7d-5e0c-9c4a-71a204024442" :answer-field/id #uuid "484e629d-dc7d-5e0c-9c4a-71a204024442" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8de4318a-2906-55e9-931e-cf86dcec431d" :answer-field/choices ["answer-a01a68fa-e4f2-5768-b6b5-568cf27a978c" "answer-32063bf7-a5cd-521d-bf15-5b3735786623" "answer-1412c4fc-e940-5a13-938f-f42ffc7bae38" "answer-8de4318a-2906-55e9-931e-cf86dcec431d" "answer-8a329f63-ac1e-52f9-9b8e-7b2a3fb444e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a01a68fa-e4f2-5768-b6b5-568cf27a978c" :answer/id #uuid "a01a68fa-e4f2-5768-b6b5-568cf27a978c" :answer/type :answer.type/math :answer/value "∠1≅∠2" :db/ensure [:answer/validate]} {:db/id "answer-32063bf7-a5cd-521d-bf15-5b3735786623" :answer/id #uuid "32063bf7-a5cd-521d-bf15-5b3735786623" :answer/type :answer.type/math :answer/value "∠1≅∠2≅∠3" :db/ensure [:answer/validate]} {:db/id "answer-1412c4fc-e940-5a13-938f-f42ffc7bae38" :answer/id #uuid "1412c4fc-e940-5a13-938f-f42ffc7bae38" :answer/type :answer.type/math :answer/value "∠1≅∠3" :db/ensure [:answer/validate]} {:db/id "answer-8de4318a-2906-55e9-931e-cf86dcec431d" :answer/id #uuid "8de4318a-2906-55e9-931e-cf86dcec431d" :answer/type :answer.type/math :answer/value "∠2≅∠3" :db/ensure [:answer/validate]} {:db/id "answer-8a329f63-ac1e-52f9-9b8e-7b2a3fb444e4" :answer/id #uuid "8a329f63-ac1e-52f9-9b8e-7b2a3fb444e4" :answer/type :answer.type/text :answer/value "No congruent angles" :db/ensure [:answer/validate]} {:db/id "question-5707b071-c7c6-5712-89ca-e66cbdfb1c32" :question/id #uuid "5707b071-c7c6-5712-89ca-e66cbdfb1c32" :question/math-academy-id "q-52667" :question/problem "From the information given below, find all of the angles that are congruent.\n\n$$\n\\begin{aligned}m∠A & ={30}^{∘}, \\\\ m∠B & ={150}^{∘}, \\\\ m∠C & ={180}^{∘}, \\\\ m∠D & ={180}^{∘}-m∠C, \\\\ m∠E & ={120}^{∘}+m∠A, \\\\ m∠F & =m∠E.\\end{aligned}\n$$" :question/worked-solution "First, let's find the measures of $∠D$, $∠E$ and $∠F:$\n\n$$\n\\begin{aligned}m∠D & ={180}^{∘}-m∠C \\\\  & ={180}^{∘}-{180}^{∘} \\\\  & ={0}^{∘} \\\\  \\\\ m∠E & ={120}^{∘}+m∠A \\\\  & ={120}^{∘}+{30}^{∘} \\\\  & ={150}^{∘} \\\\  \\\\ m∠F & =m∠E={150}^{∘}\\end{aligned}\n$$\n\nHence, we have:\n\n$$\n\\begin{aligned}m∠A & ={30}^{∘} \\\\ m∠B & ={150}^{∘} \\\\ m∠C & ={180}^{∘} \\\\ m∠D & ={0}^{∘} \\\\ m∠E & ={150}^{∘} \\\\ m∠F & ={150}^{∘}\\end{aligned}\n$$\n\nWe have that $m∠B=m∠E=m∠F.$ Therefore, $∠B≅∠E≅∠F.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41f591ce-644c-5a99-a40d-e21beea341a9"] :db/ensure [:question/validate]} {:db/id "answer-field-41f591ce-644c-5a99-a40d-e21beea341a9" :answer-field/id #uuid "41f591ce-644c-5a99-a40d-e21beea341a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21a47e6e-e748-5170-9990-f8983df2d694" :answer-field/choices ["answer-21a47e6e-e748-5170-9990-f8983df2d694" "answer-ee75afad-a73a-54b9-8841-0058f005d40d" "answer-d00dc0e1-0d96-523c-8246-5417065296bd" "answer-fa1625a5-d851-5bd9-bd6b-206acbfabb98" "answer-d4013e73-3d15-5194-8998-adb9155a3713"] :db/ensure [:answer-field/validate]} {:db/id "answer-21a47e6e-e748-5170-9990-f8983df2d694" :answer/id #uuid "21a47e6e-e748-5170-9990-f8983df2d694" :answer/type :answer.type/math :answer/value "∠B≅∠E≅∠F" :db/ensure [:answer/validate]} {:db/id "answer-ee75afad-a73a-54b9-8841-0058f005d40d" :answer/id #uuid "ee75afad-a73a-54b9-8841-0058f005d40d" :answer/type :answer.type/math :answer/value "∠E≅∠F" :db/ensure [:answer/validate]} {:db/id "answer-d00dc0e1-0d96-523c-8246-5417065296bd" :answer/id #uuid "d00dc0e1-0d96-523c-8246-5417065296bd" :answer/type :answer.type/text :answer/value "$∠A≅∠D$ and $∠E≅∠F$" :db/ensure [:answer/validate]} {:db/id "answer-fa1625a5-d851-5bd9-bd6b-206acbfabb98" :answer/id #uuid "fa1625a5-d851-5bd9-bd6b-206acbfabb98" :answer/type :answer.type/text :answer/value "$∠B≅∠D$ and $∠E≅∠F$" :db/ensure [:answer/validate]} {:db/id "answer-d4013e73-3d15-5194-8998-adb9155a3713" :answer/id #uuid "d4013e73-3d15-5194-8998-adb9155a3713" :answer/type :answer.type/text :answer/value "$∠B≅∠E≅∠F$ and $∠C≅∠D$" :db/ensure [:answer/validate]} {:db/id "question-e51f05e0-1186-559b-935a-5d0ce775e04e" :question/id #uuid "e51f05e0-1186-559b-935a-5d0ce775e04e" :question/math-academy-id "q-103278" :question/problem "![](images/62/62412006e358dd798b602547e22eb63c9c274b0d740df885e9c69a1af06bcb97.png)\n\nWhich of the following statements are true regarding the angles shown above?\n\nI. $m∠AOB=m∠COD$\n\nII. $m∠BOC=m∠EOF$\n\nIII. $m∠COD=m∠DOE$" :question/worked-solution "From the diagram, we see that \n\n- $∠AOB$ and $∠EOF$ are marked with $|$,\n\n- $∠BOC$ and $∠DOE$ are marked with $||$, and\n\n- $∠COD$ is marked with $|||.$\n\nTherefore,\n\n$$\n\\begin{aligned}∠AOB & ≅∠EOF \\\\ ∠BOC & ≅∠DOE.\\end{aligned}\n$$\n\nConsequently, we have\n\n$$\n\\begin{aligned}m∠AOB & =m∠EOF \\\\ m∠BOC & =m∠DOE.\\end{aligned}\n$$\n\nTherefore, none of the statements listed is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6ee27135-1d65-5365-a4fe-10d624dd4bf0"] :db/ensure [:question/validate]} {:db/id "answer-field-6ee27135-1d65-5365-a4fe-10d624dd4bf0" :answer-field/id #uuid "6ee27135-1d65-5365-a4fe-10d624dd4bf0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-768b7745-c32f-54c2-a220-8d70a241d0a6" :answer-field/choices ["answer-c329693a-b5a2-5193-bff3-fcc7570fce63" "answer-d57dd289-7ae8-5e70-8539-2d1dccad2ded" "answer-eed18f17-23d5-5bb5-8850-a0adb39c430e" "answer-9a0bec5f-4c14-5c93-a7d6-f8f9e52686fd" "answer-768b7745-c32f-54c2-a220-8d70a241d0a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-c329693a-b5a2-5193-bff3-fcc7570fce63" :answer/id #uuid "c329693a-b5a2-5193-bff3-fcc7570fce63" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d57dd289-7ae8-5e70-8539-2d1dccad2ded" :answer/id #uuid "d57dd289-7ae8-5e70-8539-2d1dccad2ded" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-eed18f17-23d5-5bb5-8850-a0adb39c430e" :answer/id #uuid "eed18f17-23d5-5bb5-8850-a0adb39c430e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9a0bec5f-4c14-5c93-a7d6-f8f9e52686fd" :answer/id #uuid "9a0bec5f-4c14-5c93-a7d6-f8f9e52686fd" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-768b7745-c32f-54c2-a220-8d70a241d0a6" :answer/id #uuid "768b7745-c32f-54c2-a220-8d70a241d0a6" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "question-432febe7-1220-5082-90e3-bf3d1c64fe2c" :question/id #uuid "432febe7-1220-5082-90e3-bf3d1c64fe2c" :question/math-academy-id "q-103282" :question/problem "![](images/6f/6fe8fc042cc8d5645e9cf0df2fd297e018504c4248a45d348e4778a14caea9ca.png)\n\nWhich of the following statements are true regarding the angles shown above?\n\nI. $m∠AOB=m∠DOE$\n\nII. $m∠BOC=m∠COD$\n\nIII. $m∠BOC=m∠EOF$" :question/worked-solution "From the diagram, we see that \n\n- $∠AOB$ and $∠DOE$ are marked with $|$,\n\n- $∠BOC$ and $∠COD$ are marked with $||$, and\n\n- $∠EOF$ is marked with $|||.$\n\nTherefore,\n\n$$\n\\begin{aligned}∠AOB & ≅∠DOE \\\\ ∠BOC & ≅∠COD.\\end{aligned}\n$$\n\nConsequently, we have\n\n$$\n\\begin{aligned}m∠AOB & =m∠DOE \\\\ m∠BOC & =m∠COD.\\end{aligned}\n$$\n\nSo statements I and II are true, while statement III is false." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-82dbe361-354a-56ad-a1e1-311213fab97b"] :db/ensure [:question/validate]} {:db/id "answer-field-82dbe361-354a-56ad-a1e1-311213fab97b" :answer-field/id #uuid "82dbe361-354a-56ad-a1e1-311213fab97b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-025b4786-1822-54f6-8a89-545a9e29ce30" :answer-field/choices ["answer-025b4786-1822-54f6-8a89-545a9e29ce30" "answer-93044a10-b554-519e-b7bf-4828f2f237be" "answer-08ed29c2-738e-5064-8c1e-443c10c88854" "answer-3f59c7f0-25cf-5e54-909e-17e1f69d588c" "answer-2e930325-1a99-5839-9271-dfd501f317a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-025b4786-1822-54f6-8a89-545a9e29ce30" :answer/id #uuid "025b4786-1822-54f6-8a89-545a9e29ce30" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-93044a10-b554-519e-b7bf-4828f2f237be" :answer/id #uuid "93044a10-b554-519e-b7bf-4828f2f237be" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-08ed29c2-738e-5064-8c1e-443c10c88854" :answer/id #uuid "08ed29c2-738e-5064-8c1e-443c10c88854" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3f59c7f0-25cf-5e54-909e-17e1f69d588c" :answer/id #uuid "3f59c7f0-25cf-5e54-909e-17e1f69d588c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-2e930325-1a99-5839-9271-dfd501f317a0" :answer/id #uuid "2e930325-1a99-5839-9271-dfd501f317a0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-38145db5-f11d-5939-a57b-880dc1abb8bc" :question/id #uuid "38145db5-f11d-5939-a57b-880dc1abb8bc" :question/math-academy-id "q-27340" :question/problem "![](images/9c/9c14d7a4f9a460c3219cb457ff9f8ba8fb32a22101dfba3e0925aa8077b011cf.png)\n\nIn the figure above, $∠ABC$ is an angle and $D$ is a point in the interior of $∠ABC$ such that $m∠CBD=5x+{3}^{∘}.$ If $m∠ABC={106}^{∘}$ and $∠CBD≅∠ABD$, find the value of $x.$" :question/worked-solution "By the angle addition postulate,\n\n$$\nm∠ABC=m∠ABD+m∠CBD.\n$$\n\nSince $∠CBD≅∠ABD$, then we have $m∠CBD=m∠ABD.$  Therefore,\n\n$$\n\\begin{aligned}m∠ABC & =m∠ABD+m∠CBD \\\\  & =m∠CBD+m∠CBD \\\\  & =2m∠CBD.\\end{aligned}\n$$\n\nNow, using the fact that $m∠CBD=5x+{3}^{∘}$ and $m∠ABC={106}^{∘},$ we can solve for $x$ as follows: \n\n$$\n\\begin{aligned}{106}^{∘} & =2(5x+3) \\\\ {106}^{∘} & =10x+{6}^{∘} \\\\ {100}^{∘} & =10x \\\\ {10}^{∘} & =x \\\\ x & ={10}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c61077a2-9a63-5c31-b3bc-86812d3d0fa7"] :db/ensure [:question/validate]} {:db/id "answer-field-c61077a2-9a63-5c31-b3bc-86812d3d0fa7" :answer-field/id #uuid "c61077a2-9a63-5c31-b3bc-86812d3d0fa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e3ddfe8-4646-5343-8f78-2cd78244074d" :answer-field/choices ["answer-3e3ddfe8-4646-5343-8f78-2cd78244074d" "answer-6bcabfca-0ad4-576f-b497-06484a7f0b32" "answer-8ad629dd-bda2-5cd2-80aa-e44785aca0d1" "answer-7c4292d3-7a67-5551-be24-06795728e304" "answer-f2b932ed-41fa-51ec-b39a-7c8a73e83033"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e3ddfe8-4646-5343-8f78-2cd78244074d" :answer/id #uuid "3e3ddfe8-4646-5343-8f78-2cd78244074d" :answer/type :answer.type/math :answer/value "{10}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-6bcabfca-0ad4-576f-b497-06484a7f0b32" :answer/id #uuid "6bcabfca-0ad4-576f-b497-06484a7f0b32" :answer/type :answer.type/math :answer/value "{11}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-8ad629dd-bda2-5cd2-80aa-e44785aca0d1" :answer/id #uuid "8ad629dd-bda2-5cd2-80aa-e44785aca0d1" :answer/type :answer.type/math :answer/value "{13}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-7c4292d3-7a67-5551-be24-06795728e304" :answer/id #uuid "7c4292d3-7a67-5551-be24-06795728e304" :answer/type :answer.type/math :answer/value "{14}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-f2b932ed-41fa-51ec-b39a-7c8a73e83033" :answer/id #uuid "f2b932ed-41fa-51ec-b39a-7c8a73e83033" :answer/type :answer.type/math :answer/value "{9}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186176450 :question/problem "![](images/bd/bdaee2dee98e41505c8a35c617a8f4fc035125ea8d504efecbe58afc9f7fd06c.png)\n\nIn the figure above,  $m∠CBD=3x+{5}^{∘}$ and $m∠ABD=6x-{19}^{∘}.$ If $∠CBD≅∠ABD$, find $m∠ABC.$" :question/worked-solution "Since $∠CBD≅∠ABD$, then we have\n\n$$\n\\begin{aligned}m∠CBD & =m∠ABD \\\\ 3x+{5}^{∘} & =6x-{19}^{∘} \\\\ 3x+{24}^{∘} & =6x \\\\ {24}^{∘} & =3x \\\\ {8}^{∘} & =x \\\\ x & ={8}^{∘}.\\end{aligned}\n$$\n\nThus, by the angle addition postulate,\n\n$$\n\\begin{aligned}m∠ABC & =m∠CBD+m∠ABD \\\\  & =2(m∠CBD) \\\\  & =2(3({8}^{∘})+{5}^{∘}) \\\\  & ={58}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186174840 :answer-field/correct "answer-581ed73c-cf1d-5c9e-8d9e-c9ed3dfd8693" :answer-field/choices ["answer-a5899c01-ec5c-5efc-9fa4-246ca1a7e83d" "answer-581ed73c-cf1d-5c9e-8d9e-c9ed3dfd8693" "answer-c52c2501-6ddb-5f4c-9b08-d41101f8b031" "answer-a11247dd-8891-5b3a-b652-55fe89488a6a" "answer-2f459c6b-e100-5735-b45e-47924f091ea7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5899c01-ec5c-5efc-9fa4-246ca1a7e83d" :answer/id #uuid "a5899c01-ec5c-5efc-9fa4-246ca1a7e83d" :answer/type :answer.type/math :answer/value "{54}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-581ed73c-cf1d-5c9e-8d9e-c9ed3dfd8693" :answer/id #uuid "581ed73c-cf1d-5c9e-8d9e-c9ed3dfd8693" :answer/type :answer.type/math :answer/value "{58}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c52c2501-6ddb-5f4c-9b08-d41101f8b031" :answer/id #uuid "c52c2501-6ddb-5f4c-9b08-d41101f8b031" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a11247dd-8891-5b3a-b652-55fe89488a6a" :answer/id #uuid "a11247dd-8891-5b3a-b652-55fe89488a6a" :answer/type :answer.type/math :answer/value "{61}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-2f459c6b-e100-5735-b45e-47924f091ea7" :answer/id #uuid "2f459c6b-e100-5735-b45e-47924f091ea7" :answer/type :answer.type/math :answer/value "{62}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186176966 :tutorial/content "Two angles are **congruent** if their measures are equal.\n\nFor example, if\n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Y=50^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Y$ are congruent. We can express this as \n\n$$\n\\angle X \\cong \\angle Y.\n$$\n\nHowever, if \n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Z = 110^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Z$ are *not* congruent, and we write \n\n$$\n\\angle X \\ncong \\angle Z.\n$$\n\nWe represent congruent angles by marking the arcs with the same symbol. For example, three pairs of congruent angles are shown below:\n\n![](images/99/997e53a399f06c3aad8391ace4172b7249890a31abeff4e72605bce607fd3bdb.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176105 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}]
