nswer-field-bec4ef46-c3c9-5b5f-b667-e3c769648f01" :answer-field/id #uuid "bec4ef46-c3c9-5b5f-b667-e3c769648f01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e5867d94-88cf-53e1-8290-f2df95ac10c1" :answer-field/choices ["answer-c0002cc8-289d-5260-80cb-a81a46bb58b5" "answer-1320e23e-adb4-5b08-998c-94e38cda3275" "answer-15d9b284-c74a-58f9-b7b8-47d504faf3ec" "answer-504ca40a-75a2-55af-8c3d-3557a719d902" "answer-e5867d94-88cf-53e1-8290-f2df95ac10c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0002cc8-289d-5260-80cb-a81a46bb58b5" :answer/id #uuid "c0002cc8-289d-5260-80cb-a81a46bb58b5" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1320e23e-adb4-5b08-998c-94e38cda3275" :answer/id #uuid "1320e23e-adb4-5b08-998c-94e38cda3275" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-15d9b284-c74a-58f9-b7b8-47d504faf3ec" :answer/id #uuid "15d9b284-c74a-58f9-b7b8-47d504faf3ec" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-504ca40a-75a2-55af-8c3d-3557a719d902" :answer/id #uuid "504ca40a-75a2-55af-8c3d-3557a719d902" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-e5867d94-88cf-53e1-8290-f2df95ac10c1" :answer/id #uuid "e5867d94-88cf-53e1-8290-f2df95ac10c1" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "activity-305b1754-459f-5e23-bbf5-c6aeddd3beff" :activity/id #uuid "305b1754-459f-5e23-bbf5-c6aeddd3beff" :activity/title "Limits of Logarithmic Functions" :activity/type :activity.type/review :activity/scope 17592186050490 :activity/course 17592186046647 :activity/steps ["step-f568387c-f695-56ad-a2dc-4c74c8af2e96" "step-d8cd7ccd-d160-50f1-b1f0-3764b14a4f54" "step-b9688c8c-f696-5a99-9e0f-4cedd962c3d3"] :activity/first-step "step-f568387c-f695-56ad-a2dc-4c74c8af2e96" :d