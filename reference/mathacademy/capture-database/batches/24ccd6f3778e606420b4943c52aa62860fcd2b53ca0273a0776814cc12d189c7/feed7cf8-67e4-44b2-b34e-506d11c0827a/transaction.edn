p-5cb51352-36a7-5451-aa46-d3ee99b83611" :db/ensure [:activity/validate]} {:db/id "step-5cb51352-36a7-5451-aa46-d3ee99b83611" :step/id #uuid "5cb51352-36a7-5451-aa46-d3ee99b83611" :step/content 17592186407316 :step/next "step-f1a9160f-87bd-505a-a2a1-0157e9d7dd46" :db/ensure [:step/validate]} {:db/id "step-f1a9160f-87bd-505a-a2a1-0157e9d7dd46" :step/id #uuid "f1a9160f-87bd-505a-a2a1-0157e9d7dd46" :step/content 17592186406798 :step/next "step-3b1c7167-cdc6-57e2-a131-51fa45bc430d" :db/ensure [:step/validate]} {:db/id "step-3b1c7167-cdc6-57e2-a131-51fa45bc430d" :step/id #uuid "3b1c7167-cdc6-57e2-a131-51fa45bc430d" :step/content 17592186268888 :step/next "step-3f73b412-2419-5b76-8ea4-608373bc04e3" :db/ensure [:step/validate]} {:db/id "step-3f73b412-2419-5b76-8ea4-608373bc04e3" :step/id #uuid "3f73b412-2419-5b76-8ea4-608373bc04e3" :step/content "question-4cb48e08-10b0-5815-97ab-c688f0460cd6" :step/next "step-80f9b444-9cfd-5f24-8e33-f6319036fdd0" :db/ensure [:step/validate]} {:db/id "step-80f9b444-9cfd-5f24-8e33-f6319036fdd0" :step/id #uuid "80f9b444-9cfd-5f24-8e33-f6319036fdd0" :step/content 17592186383314 :db/ensure [:step/validate]} {:db/id 17592186068812 :knowledge-point/questions ["question-461aef2d-ef91-5bc9-a05c-59153c1a3f67"] :db/ensure [:knowledge-point/validate]} {:db/id "question-461aef2d-ef91-5bc9-a05c-59153c1a3f67" :question/id #uuid "461aef2d-ef91-5bc9-a05c-59153c1a3f67" :question/math-academy-id "q-102118" :question/problem "Express $(-\\infty ,\\sqrt{3})\\cup (3,\\infty )$ as an inequality." :question/worked-solution "First, we graph the two intervals on a number line:\n\n![](images/73/73f3c747217e98926510918c395eb644eb143ba07446a863b3f038aafb3fd19a.png)\n\nThe interval $(-\\infty ,\\sqrt{3})$ can be expressed as the inequality $x<\\sqrt{3}.$\n\nLikewise, the interval $(3,\\infty )$ can be expressed as the inequality $x>3.$\n\nSo, the union of these intervals represents the compound inequality\n\n$$\nx<\\sqrt{3}\\text{ or }x>3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50b72217-0f5e-5d03-bce9-0d904f17a8e6"] :db/ensure [:question/validate]} {:db/id "answer-field-50b72217-0f5e-5d03-bce9-0d904f17a8e6" :answer-field/id #uuid "50b72217-0f5e-5d03-bce9-0d904f17a8e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e7509d63-8072-59fc-8112-5bc30af162dc" :answer-field/choices ["answer-827893a9-b95b-55f0-915b-1c8e00888102" "answer-cf0a2046-3b5e-5e61-a994-9e5fdfe11611" "answer-6d13874f-d67d-5517-93e4-99c7f8c4271a" "answer-ead74f6f-5760-5690-b9af-a1e8a8d7a384" "answer-e7509d63-8072-59fc-8112-5bc30af162dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-827893a9-b95b-55f0-915b-1c8e00888102" :answer/id #uuid "827893a9-b95b-55f0-915b-1c8e00888102" :answer/type :answer.type/math :answer/value "\\sqrt{3}<x<3" :db/ensure [:answer/validate]} {:db/id "answer-cf0a2046-3b5e-5e61-a994-9e5fdfe11611" :answer/id #uuid "cf0a2046-3b5e-5e61-a994-9e5fdfe11611" :answer/type :answer.type/math :answer/value "\\sqrt{3}\\le x<3" :db/ensure [:answer/validate]} {:db/id "answer-6d13874f-d67d-5517-93e4-99c7f8c4271a" :answer/id #uuid "6d13874f-d67d-5517-93e4-99c7f8c4271a" :answer/type :answer.type/text :answer/value "$\\sqrt{3}<x$ or $x\\ge 3$" :db/ensure [:answer/validate]} {:db/id "answer-ead74f6f-5760-5690-b9af-a1e8a8d7a384" :answer/id #uuid "ead74f6f-5760-5690-b9af-a1e8a8d7a384" :answer/type :answer.type/text :answer/value "$x<\\sqrt{3}$ or $3>x$" :db/ensure [:answer/validate]} {:db/id "answer-e7509d63-8072-59fc-8112-5bc30af162dc" :answer/id #uuid "e7509d63-8072-59fc-8112-5bc30af162dc" :answer/type :answer.type/text :answer/value "$x<\\sqrt{3}$ or $x>3$" :db/ensure [:answer/validate]} {:db/id 17592186068836 :knowledge-point/questions ["question-2a409742-71a6-54c6-bd19-7151d386a675"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2a409742-71a6-54c6-bd19-7151d386a675" :question/id #uuid "2a409742-71a6-54c6-bd19-7151d386a675" :question/math-academy-id "q-162918" :question/problem "$\\sqrt{\\frac{36{t}^{2}}{25}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{36{t}^{2}}{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{{5}^{2}}}=\\frac{\\sqrt{36{t}^{2}}}{5}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{36{t}^{2}}}{5} & = \\\\ \\frac{\\sqrt{(6t)^{2}}}{5} & = \\\\ \\frac{|6t|}{5} & = \\\\ \\frac{|6|\\cdot |t|}{5} & = \\\\ \\frac{6\\cdot |t|}{5} & = \\\\ \\frac{6|t|}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fc9a310b-5a8f-5f99-b66d-f83152a549f6"] :db/ensure [:question/validate]} {:db/id "answer-field-fc9a310b-5a8f-5f99-b66d-f83152a549f6" :answer-field/id #uuid "fc9a310b-5a8f-5f99-b66d-f83152a549f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer-field/choices ["answer-de74d234-a125-5b01-bbcf-59800aca3ef1" "answer-4631f84e-d5a6-5799-b347-9ad541471ba1" "answer-8977733d-92ba-5dd8-ade8-abf7ee937741" "answer-126f825b-54f7-557c-902d-f23f70ba9df9" "answer-4c75ccdd-f6c5-5e94-a601-725a713a3f5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-de74d234-a125-5b01-bbcf-59800aca3ef1" :answer/id #uuid "de74d234-a125-5b01-bbcf-59800aca3ef1" :answer/type :answer.type/math :answer/value "30\\sqrt{t}" :db/ensure [:answer/validate]} {:db/id "answer-4631f84e-d5a6-5799-b347-9ad541471ba1" :answer/id #uuid "4631f84e-d5a6-5799-b347-9ad541471ba1" :answer/type :answer.type/math :answer/value "30t" :db/ensure [:answer/validate]} {:db/id "answer-8977733d-92ba-5dd8-ade8-abf7ee937741" :answer/id #uuid "8977733d-92ba-5dd8-ade8-abf7ee937741" :answer/type :answer.type/math :answer/value "5t" :db/ensure [:answer/validate]} {:db/id "answer-126f825b-54f7-557c-902d-f23f70ba9df9" :answer/id #uuid "126f825b-54f7-557c-902d-f23f70ba9df9" :answer/type :answer.type/math :answer/value "6|t|" :db/ensure [:answer/validate]} {:db/id "answer-4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/id #uuid "4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/type :answer.type/math :answer/value "\\frac{6|t|}{5}" :db/ensure [:answer/validate]} {:db/id 17592186502068 :knowledge-point/questions ["question-1692e268-919b-5ead-b3e6-7be50cf4ba12"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1692e268-919b-5ead-b3e6-7be50cf4ba12" :question/id #uuid "1692e268-919b-5ead-b3e6-7be50cf4ba12" :question/math-academy-id "q-357229" :question/problem "The temperature of a cold room decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute for $\\frac{10}{3}$ minutes. What is the total change in temperature?" :question/worked-solution "The temperature decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute.\n\nSince the temperature decreases, the change each minute is $-\\frac{3}{8}.$\n\nThe change occurs for $\\frac{10}{3}$ minutes, so the total change is\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8}).\n$$\n\nEvaluating the product, we get\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8})=-\\frac{10\\times 3}{3\\times 8}=-\\frac{10}{8}=-\\frac{5}{4}.\n$$\n\nTherefore, the total change in temperature is $-\\frac{5}{4}{\\,}^{∘}\\text{C}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-765eabd7-3f07-54c5-b885-44c2b986b924"] :db/ensure [:question/validate]} {:db/id "answer-field-765eabd7-3f07-54c5-b885-44c2b986b924" :answer-field/id #uuid "765eabd7-3f07-54c5-b885-44c2b986b924" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-68ece16d-ee10-5137-902b-6a2b5c84b877" :answer-field/choices ["answer-4000bf26-e332-5326-962b-83435ec584c3" "answer-441f4327-e461-55f6-a208-71db35e05411" "answer-405df5c1-8de4-558b-9aaf-0