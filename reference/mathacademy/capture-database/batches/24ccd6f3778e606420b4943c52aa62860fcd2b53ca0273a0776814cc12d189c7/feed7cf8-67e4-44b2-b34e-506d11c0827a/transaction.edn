x}{5}-3?$" :question/worked-solution "The roots are the solutions to the equation $f(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ \\frac{2x}{5}-3 & =0 \\\\ \\frac{2x}{5} & =3 \\\\ 2x & =15 \\\\ x & =\\frac{15}{2}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\frac{15}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2add5a83-e07a-5273-8ef3-d682bebc9cc1"] :db/ensure [:question/validate]} {:db/id "answer-field-2add5a83-e07a-5273-8ef3-d682bebc9cc1" :answer-field/id #uuid "2add5a83-e07a-5273-8ef3-d682bebc9cc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a65a3e3e-fb88-58f8-bbd3-ba97f77e6b9b" :answer-field/choices ["answer-ed5bc282-4f39-5640-8eff-7065cfd84e70" "answer-2c7d709a-e4ad-5793-be80-5592d1c6b69c" "answer-f07c0ec9-664a-551b-8555-328ef64c429c" "answer-a65a3e3e-fb88-58f8-bbd3-ba97f77e6b9b" "answer-d6c6fba4-5c9b-57de-b842-54760231e736"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed5bc282-4f39-5640-8eff-7065cfd84e70" :answer/id #uuid "ed5bc282-4f39-5640-8eff-7065cfd84e70" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2c7d709a-e4ad-5793-be80-5592d1c6b69c" :answer/id #uuid "2c7d709a-e4ad-5793-be80-5592d1c6b69c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f07c0ec9-664a-551b-8555-328ef64c429c" :answer/id #uuid "f07c0ec9-664a-551b-8555-328ef64c429c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-a65a3e3e-fb88-58f8-bbd3-ba97f77e6b9b" :answer/id #uuid "a65a3e3e-fb88-58f8-bbd3-ba97f77e6b9b" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d6c6fba4-5c9b-57de-b842-54760231e736" :answer/id #uuid "d6c6fba4-5c9b-57de-b842-54760231e736" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/