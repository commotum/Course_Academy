ad-5f2e-997d-59a47e64e7c7" "answer-189651b0-54f3-5292-acb1-78996d20c50d"] :db/ensure [:answer-field/validate]} {:db/id "answer-933e034e-403a-57ae-b3fe-587b30e14b03" :answer/id #uuid "933e034e-403a-57ae-b3fe-587b30e14b03" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-dc88590b-2d68-5698-b5ee-ad190de36855" :answer/id #uuid "dc88590b-2d68-5698-b5ee-ad190de36855" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-80b350c2-d6af-593a-8af1-2ec69b5c8cad" :answer/id #uuid "80b350c2-d6af-593a-8af1-2ec69b5c8cad" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-aa9212d0-88ad-5f2e-997d-59a47e64e7c7" :answer/id #uuid "aa9212d0-88ad-5f2e-997d-59a47e64e7c7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-189651b0-54f3-5292-acb1-78996d20c50d" :answer/id #uuid "189651b0-54f3-5292-acb1-78996d20c50d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186083190 :knowledge-point/questions ["question-7432d94a-3593-5858-b61c-052181b6a281" "question-bc3a1a0d-0a47-5924-a45a-6ae72b37f737"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7432d94a-3593-5858-b61c-052181b6a281" :question/id #uuid "7432d94a-3593-5858-b61c-052181b6a281" :question/math-academy-id "q-15826" :question/problem "If $y=|x-5|$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x-5|$ has $a=5.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $5$ units right.\n\n![](images/ca/ca70d305bb0da32441611d879ca2a4a2453b38e951b448964b5d48f01fa33e28.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(5,0).$" :question/difficulty :question.dif