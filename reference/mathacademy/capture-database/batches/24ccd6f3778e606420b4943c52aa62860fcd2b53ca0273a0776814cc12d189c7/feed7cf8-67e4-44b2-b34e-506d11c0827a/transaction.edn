:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,B∧A\\,$ | $\\,B∨A\\,$ | $\\,(B∧A)∨(B∨A)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a019ee0a-e736-5bcb-92c2-90a3c352279f" "answer-field-edb06e43-c06e-5b90-b51e-7cdae61fe54e" "answer-field-6e01db9c-968f-5148-9877-cccfc7ce4b84" "answer-field-a2a62400-4f0a-56c8-aa4c-098c5c3d23e9"] :db/ensure [:question/validate]} {:db/id "answer-field-a019ee0a-e736-5bcb-92c2-90a3c352279f" :answer-field/id #uuid "a019ee0a-e736-5bcb-92c2-90a3c352279f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-61fad660-6791-572e-a5be-753bd0bdcf7d" :answer-field/choices ["answer-7687ca1f-b276-5a24-a6cc-8534d9967358" "answer-61fad660-6791-572e-a5be-753bd0bdcf7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-7687ca1f-b276-5a24-a6cc-8534d9967358" :answer/id #uuid "7687ca1f-b276-5a24-a6cc-8534d9967358" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-61fad660-6791-572e-a5be-753bd0bdcf7d" :answer/id #uuid "61fad660-6791-572e-a5be-753bd0bdcf7d" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-edb06e43-c06e-5b90-b51e-7cdae61fe54e" :answer-field/id #uuid "edb06e43-c06e-5b90-b51e-7cdae61fe54e" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-bc9e082c-dedd-5bc4-981f-25922067385c" :answer-field/choices ["answer-5d8b7df2-434c-54f1-b9a8-96b0dacf28cd" "answer-bc9e082c-dedd-5bc4-981f-25922067385c"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d8b7df2-434c-54f1-b9a8-96b0dacf28c