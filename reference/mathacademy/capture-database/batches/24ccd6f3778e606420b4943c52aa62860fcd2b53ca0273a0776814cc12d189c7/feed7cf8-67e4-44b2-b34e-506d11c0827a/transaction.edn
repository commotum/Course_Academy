5-a6ab-076ed90d5359" "answer-b062e970-b597-5f2d-9ea2-1cb272c3ae68" "answer-f1a64e58-305e-5436-b531-8fa978d44736"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0f83d2e-4fda-530c-bc0b-3fc197b6e9e3" :answer/id #uuid "a0f83d2e-4fda-530c-bc0b-3fc197b6e9e3" :answer/type :answer.type/text :answer/value "$5$ belongs to the set of integer numbers." :db/ensure [:answer/validate]} {:db/id "answer-c86f63a3-53c8-5588-8c96-c80888a795ed" :answer/id #uuid "c86f63a3-53c8-5588-8c96-c80888a795ed" :answer/type :answer.type/text :answer/value "$5$ belongs to the set of natural numbers." :db/ensure [:answer/validate]} {:db/id "answer-b62f3fa3-82f7-5705-a6ab-076ed90d5359" :answer/id #uuid "b62f3fa3-82f7-5705-a6ab-076ed90d5359" :answer/type :answer.type/text :answer/value "$5$ belongs to the set of real numbers." :db/ensure [:answer/validate]} {:db/id "answer-b062e970-b597-5f2d-9ea2-1cb272c3ae68" :answer/id #uuid "b062e970-b597-5f2d-9ea2-1cb272c3ae68" :answer/type :answer.type/text :answer/value "$5$ does not belong to the set of integer numbers." :db/ensure [:answer/validate]} {:db/id "answer-f1a64e58-305e-5436-b531-8fa978d44736" :answer/id #uuid "f1a64e58-305e-5436-b531-8fa978d44736" :answer/type :answer.type/text :answer/value "$5$ does not belong to the set of real numbers." :db/ensure [:answer/validate]} {:db/id "question-32db5c7a-ebc7-5981-a2ce-a4afccfedb03" :question/id #uuid "32db5c7a-ebc7-5981-a2ce-a4afccfedb03" :question/math-academy-id "q-176857" :question/problem "Consider the following statement.\n\n$0.75$ does **not** belong to the set of rational numbers.\n\nWhat is the negation of this statement?" :question/worked-solution "Let's denote the given statement as $P.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\nIt is **not** true that $0.75$ does **not** belong to the set of rational numbers.\n\nIn other words, $0.75$ belongs to the set of rational numbers. Therefore, $¬P$ means the following:\n\n$0.75$ belongs to the set of rational numbers.\n\nNote that $P$ is **false,** while $¬P$ is **true.**" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-522716aa-b013-56ac-9682-3c4f1235059c"] :db/ensure [:question/validate]} {:db/id "answer-field-522716aa-b013-56ac-9682-3c4f1235059c" :answer-field/id #uuid "522716aa-b013-56ac-9682-3c4f1235059c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05bf2d6f-5175-53ff-9053-2c1ced6b2262" :answer-field/choices ["answer-a356e9e1-1a39-5ac7-a858-418ad0ce302c" "answer-05bf2d6f-5175-53ff-9053-2c1ced6b2262" "answer-354af9d2-1125-500a-b5bd-0863a1344b47" "answer-d88400d3-4298-5734-96e2-da31e2bf5bcb" "answer-ee0939ad-c944-541e-8ce8-faa4bba0afcf"] :db/ensure [:answer-field/validate]} {:db/id "answer-a356e9e1-1a39-5ac7-a858-418ad0ce302c" :answer/id #uuid "a356e9e1-1a39-5ac7-a858-418ad0ce302c" :answer/type :answer.type/text :answer/value "$0.75$ belongs to the set of integer numbers." :db/ensure [:answer/validate]} {:db/id "answer-05bf2d6f-5175-53ff-9053-2c1ced6b2262" :answer/id #uuid "05bf2d6f-5175-53ff-9053-2c1ced6b2262" :answer/type :answer.type/text :answer/value "$0.75$ belongs to the set of rational numbers." :db/ensure [:answer/validate]} {:db/id "answer-354af9d2-1125-500a-b5bd-0863a1344b47" :answer/id #uuid "354af9d2-1125-500a-b5bd-0863a1344b47" :answer/type :answer.type/text :answer/value "$0.75$ belongs to the set of real numbers." :db/ensure [:answer/validate]} {:db/id "answer-d88400d3-4298-5734-96e2-da31e2bf5bcb" :answer/id #uuid "d88400d3-4298-5734-96e2-da31e2bf5bcb" :answer/type :answer.type/text :answer/value "$0.75$ does not belong to the set of integer numbers." :db/ensure [:answer/validate]} {:db/id "answer-ee0939ad-c944-541e-8ce8-faa4bba0afcf" :answer/id #uuid "ee0939ad-c944-541e-8ce8-faa4bba0afcf" :answer/type :answer.type/text :answer/value "$0.75$ does not belong to the set of rational numbers." :db/ensure [:answer/validate]} {:db/id 17592186152052 :knowledge-point/questions ["question-846f1209-a84b-5c13-a0c8-7374d18fc658" "question-97de13ba-d851-57a8-a13f-4fcc5cdc4d81"] :db/ensure [:knowledge-point/validate]} {:db/id "question-846f1209-a84b-5c13-a0c8-7374d18fc658" :question/id #uuid "846f1209-a84b-5c13-a0c8-7374d18fc658" :question/math-academy-id "q-176866" :question/problem "$9$ is divisible by $4$, or $8$ is **not** divisible by $3.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:9\\text{ is divisible by }4$\n\n- $Q:8\\text{ is divisible by }3$" :question/worked-solution "The sentence\n\n$9$ is divisible by $4$ \n\ncan be expressed symbolically as $P.$ \n\nThe sentence\n\n$8$ is **not** divisible by $3$\n\ncan be expressed symbolically as $¬Q.$\n\nTherefore, the sentence\n\n$9$ is divisible by $4$, or $8$ is **not** divisible by $3$\n\ncan be expressed symbolically as $P∨¬Q.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d1054d29-077f-5163-ac93-fb66f447c9b8"] :db/ensure [:question/validate]} {:db/id "answer-field-d1054d29-077f-5163-ac93-fb66f447c9b8" :answer-field/id #uuid "d1054d29-077f-5163-ac93-fb66f447c9b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ad501c17-03fd-53ff-b60a-18b182a89e50" :answer-field/choices ["answer-feccd406-14d2-548c-ae56-655fb981b594" "answer-ad501c17-03fd-53ff-b60a-18b182a89e50" "answer-4e091526-5ffd-5591-8887-aa1b671775f2" "answer-bd87453b-82a3-54e7-9a9b-2a8aa6569d24" "answer-7ab01873-1aba-5e67-8f54-84e85bbe60c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-feccd406-14d2-548c-ae56-655fb981b594" :answer/id #uuid "feccd406-14d2-548c-ae56-655fb981b594" :answer/type :answer.type/math :answer/value "P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-ad501c17-03fd-53ff-b60a-18b182a89e50" :answer/id #uuid "ad501c17-03fd-53ff-b60a-18b182a89e50" :answer/type :answer.type/math :answer/value "P∨¬Q" :db/ensure [:answer/validate]} {:db/id "answer-4e091526-5ffd-5591-8887-aa1b671775f2" :answer/id #uuid "4e091526-5ffd-5591-8887-aa1b671775f2" :answer/type :answer.type/math :answer/value "¬P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-bd87453b-82a3-54e7-9a9b-2a8aa6569d24" :answer/id #uuid "bd87453b-82a3-54e7-9a9b-2a8aa6569d24" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id "answer-7ab01873-1aba-5e67-8f54-84e85bbe60c3" :answer/id #uuid "7ab01873-1aba-5e67-8f54-84e85bbe60c3" :answer/type :answer.type/math :answer/value "¬P∨¬Q" :db/ensure [:answer/validate]} {:db/id "question-97de13ba-d851-57a8-a13f-4fcc5cdc4d81" :question/id #uuid "97de13ba-d851-57a8-a13f-4fcc5cdc4d81" :question/math-academy-id "q-81399" :question/problem "$9$ is **not** both even and prime.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:9\\text{ is even}$\n\n- $Q:9\\text{ is prime}$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$9$ is both even and prime,  \n\nwhich can be expressed symbolically as $P∧Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∧Q).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e82818b-e8e3-57c6-8cc0-0afcc9436eba"] :db/ensure [:question/validate]} {:db/id "answer-field-5e82818b-e8e3-57c6-8cc0-0afcc9436eba" :answer-field/id #uuid "5e82818b-e8e3-57c6-8cc0-0afcc9436eba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a6b0cfe-b34d-5115-8b06-9fc8596974f9" :answer-field/choices ["answer-4a6b0cfe-b34d-5115-8b06-9fc8596974f9" "answer-faca373d-2b19-5030-9287-1f3be81c16c0" "answer-14fdd6a0-d067-504e-ab97-8e2960202186" "answer-6e3ced2b-ad25-5561-9ea5-cbbc912a4510" "answer-a0bbe353-9eb2-56ae-b264-0d3be1496704"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a6b0cfe-b34d-5115-8b06-9fc8596974f9" :answer/id #uuid "4a6b0cfe-b34d-5115-8b06-9fc8596974f9" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-faca373d-2b19-5030-9287-1f3be81c16c0" :answer/id #uuid "faca373d-2b19-5030-9287-1f3be81c16c0" :answer/type :answer.type/math :answer/value "¬(P∧¬Q)" :db/ensure [:answer/validate]} {:db/id "answer-14fdd6a0-d067-504e-ab97-8e2960202186" :answer/id #uuid "14fdd6a0-d067-504e-ab97-8e2960202186" :answer/type :answer.type/math :answer/value "¬P∧Q" :db/ensure [:answer/validate]} {:db/id "answer-6e3ced2b-ad25-5561-9ea5-cbbc912a4510" :answer/id #uuid "6e3ced2b-ad25-5561-9ea5-cbbc912a4510" :answer/type :answer.type/math :answer/value "¬P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-a0bbe353-9eb2-56ae-b264-0d3be1496704" :answer/id #uuid "a0bbe353-9eb2-56ae-b264-0d3be1496704" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id 17592186152054 :knowledge-point/questions ["question-91ef8c77-f388-589e-b268-cf2103e707d0" "question-5c770e58-f7f7-5bfc-9f03-f5a78e6b4cee" "question-928cf87e-e0b7-5063-acab-2224d29c8984"] :db/ensure [:knowledge-point/validate]} {:db/id "question-91ef8c77-f388-589e-b268-cf2103e707d0" :question/id #uuid "91ef8c77-f388-589e-b268-cf2103e707d0" :question/math-academy-id "q-176871" :question/problem "Simplify the statement $¬(¬P)∨¬(¬(P∧Q)).$" :question/worked-solution "Two negations in a row cancel each other out. So: \n\n- we can simplify $¬(¬P)$ to $P,$ and\n\n- we can also simplify $¬(¬(P∧Q))$ to $P∧Q.$\n\nTherefore, the given statement can be simplified to \n\n$$\nP∨(P∧Q).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-05fa9516-97d5-54de-8ad6-321a63ebc418"] :db/ensure [:question/validate]} {:db/id "answer-field-05fa9516-97d5-54de-8ad6-321a63ebc418" :answer-field/id #uuid "05fa9516-97d5-54de-8ad6-321a63ebc418" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0a1b0d9-0cc8-5b3a-b649-f994a316954f" :answer-field/choices ["answer-f0a1b0d9-0cc8-5b3a-b649-f994a316954f" "answer-ec53a8a7-f295-556c-9a28-b5baa9cca522" "answer-1122f251-d67c-55a2-8e23-d6d95e0c558f" "answer-ae4635c9-f9d0-51bd-b53c-847253ef09a5" "answer-118c6ce4-f01f-5145-8949-7ebe99fdc863"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0a1b0d9-0cc8-5b3a-b649-f994a316954f" :answer/id #uuid "f0a1b0d9-0cc8-5b3a-b649-f994a316954f" :answer/type :answer.type/math :answer/value "P∨(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-ec53a8a7-f295-556c-9a28-b5baa9cca522" :answer/id #uuid "ec53a8a7-f295-556c-9a28-b5baa9cca522" :answer/type :answer.type/math :answer/value "P∨(P∧¬Q)" :db/ensure [:answer/validate]} {:db/id "answer-1122f251-d67c-55a2-8e23-d6d95e0c558f" :answer/id #uuid "1122f251-d67c-55a2-8e23-d6d95e0c558f" :answer/type :answer.type/math :answer/value "P∨¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-ae4635c9-f9d0-51bd-b53c-847253ef09a5" :answer/id #uuid "ae4635c9-f9d0-51bd-b53c-847253ef09a5" :answer/type :answer.type/math :answer/value "¬P∨(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-118c6ce4-f01f-5145-8949-7ebe99fdc863" :answer/id #uuid "118c6ce4-f01f-5145-8949-7ebe99fdc863" :answer/type :answer.type/math :answer/value "¬P∨(¬P∧Q)" :db/ensure [:answer/validate]} {:db/id "question-5c770e58-f7f7-5bfc-9f03-f5a78e6b4cee" :question/id #uuid "5c770e58-f7f7-5bfc-9f03-f5a78e6b4cee" :question/math-academy-id "q-81368" :question/problem "Simplify the statement $¬[¬(¬B∨¬(¬A))].$" :question/worked-solution "Two negations in a row cancel each other out. So, we can simplify  $¬(¬A)$ to $A.$ \n\nAs a result of this, the statement simplifes to \n\n$$\n¬[¬(¬B∨A)]\n$$\n\nThen, we can simplify $¬(¬(¬B∨A))$ to $¬B∨A.$\n\nTherefore, the given statement can be simplified to \n\n$$\n¬B∨A.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a302b553-724d-50e9-bf7e-092df5c570fc"] :db/ensure [:question/validate]} {:db/id "answer-field-a302b553-724d-50e9-bf7e-092df5c570fc" :answer-field/id #uuid "a302b553-724d-50e9-bf7e-092df5c570fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d672804c-55ef-5e9f-b8df-dc93e32d4189" :answer-field/choices ["answer-d7fc3eb7-3a29-5c8c-a1d9-a5f47acc06f1" "answer-016b09dd-2dee-5bbc-9185-5ea6373f72c6" "answer-2e5e63f5-ce36-5427-8d72-7c7c4598a4d4" "answer-d672804c-55ef-5e9f-b8df-dc93e32d4189" "answer-7368e9d4-1a29-5297-b177-1eebb02097a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7fc3eb7-3a29-5c8c-a1d9-a5f47acc06f1" :answer/id #uuid "d7fc3eb7-3a29-5c8c-a1d9-a5f47acc06f1" :answer/type :answer.type/math :answer/value "B∨A" :db/ensure [:answer/validate]} {:db/id "answer-016b09dd-2dee-5bbc-9185-5ea6373f72c6" :answer/id #uuid "016b09dd-2dee-5bbc-9185-5ea6373f72c6" :answer/type :answer.type/math :answer/value "B∨¬A" :db/ensure [:answer/validate]} {:db/id "answer-2e5e63f5-ce36-5427-8d72-7c7c4598a4d4" :answer/id #uuid "2e5e63f5-ce36-5427-8d72-7c7c4598a4d4" :answer/type :answer.type/math :answer/value "¬(¬B∨A)" :db/ensure [:answer/validate]} {:db/id "answer-d672804c-55ef-5e9f-b8df-dc93e32d4189" :answer/id #uuid "d672804c-55ef-5e9f-b8df-dc93e32d4189" :answer/type :answer.type/math :answer/value "¬B∨A" :db/ensure [:answer/validate]} {:db/id "answer-7368e9d4-1a29-5297-b177-1eebb02097a0" :answer/id #uuid "7368e9d4-1a29-5297-b177-1eebb02097a0" :answer/type :answer.type/math :answer/value "¬B∨¬A" :db/ensure [:answer/validate]} {:db/id "question-928cf87e-e0b7-5063-acab-2224d29c8984" :question/id #uuid "928cf87e-e0b7-5063-acab-2224d29c8984" :question/math-academy-id "q-81357" :question/problem "Simplify the statement $¬(¬A)∧¬(¬B).$" :question/worked-solution "Two negations in a row cancel each other out. So:\n\n- we can simplify $¬(¬A)$ to $A,$ and\n\n- we can also simplify  $¬(¬B)$ to $B.$\n\nTherefore, the given statement can be simplified to \n\n$$\nA∧B.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e24bf6e9-63fc-5389-a07c-31a47adb1c69"] :db/ensure [:question/validate]} {:db/id "answer-field-e24bf6e9-63fc-5389-a07c-31a47adb1c69" :answer-field/id #uuid "e24bf6e9-63fc-5389-a07c-31a47adb1c69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e83f1abb-ac36-5329-80d9-b49d69b028b9" :answer-field/choices ["answer-e83f1abb-ac36-5329-80d9-b49d69b028b9" "answer-d9e7e3d4-7924-574c-986a-faac6726ed40" "answer-84cb76a1-f260-5149-ace6-05d679bff267" "answer-8d7cbbdf-5616-5de2-b313-b7b0600f3848" "answer-63e6489e-ffd1-5779-a7ce-e64a31c6d086"] :db/ensure [:answer-field/validate]} {:db/id "answer-e83f1abb-ac36-5329-80d9-b49d69b028b9" :answer/id #uuid "e83f1abb-ac36-5329-80d9-b49d69b028b9" :answer/type :answer.type/math :answer/value "A∧B" :db/ensure [:answer/validate]} {:db/id "answer-d9e7e3d4-7924-574c-986a-faac6726ed40" :answer/id #uuid "d9e7e3d4-7924-574c-986a-faac6726ed40" :answer/type :answer.type/math :answer/value "A∧¬B" :db/ensure [:answer/validate]} {:db/id "answer-84cb76a1-f260-5149-ace6-05d679bff267" :answer/id #uuid "84cb76a1-f260-5149-ace6-05d679bff267" :answer/type :answer.type/math :answer/value "A∨B" :db/ensure [:answer/validate]} {:db/id "answer-8d7cbbdf-5616-5de2-b313-b7b0600f3848" :answer/id #uuid "8d7cbbdf-5616-5de2-b313-b7b0600f3848" :answer/type :answer.type/math :answer/value "¬A∧¬B" :db/ensure [:answer/validate]} {:db/id "answer-63e6489e-ffd1-5779-a7ce-e64a31c6d086" :answer/id #uuid "63e6489e-ffd1-5779-a7ce-e64a31c6d086" :answer/type :answer.type/math :answer/value "¬A∨B" :db/ensure [:answer/validate]} {:db/id 17592186153426 :tutorial/content "The **negation** of a mathematical statement is its *opposite* statement. A mathematical statement and its negation have opposite truth values. \n\nFor example: \n\n- The negation of the *true* statement \"$4$ is divisible by $2$\" is the *false* statement \"$4$ is **not** divisible by $2.$\"\n\n- The negation of the *false* statement \"$5$ is even\" is the *true* statement \"$5$ is odd.\"\n\nWe can express negations using the symbol \"$\\neg$\". The negation of $A$ is denoted $\\neg A,$ and has the opposite truth values as $A{:}$\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ |\n| --- | --- |\n| $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ |\n\nWe can negate compound statements as well. For example, the statement $\\neg (A \\land B)$ has the opposite truth values as the statement $A \\land B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land B \\,$ | $\\, \\neg (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |" :db/ensure [:tutorial/validate]} {:db/id 17592186153427 :tutorial/content "When we have two negations in a row, we can cancel them out.\n\n- For example, $\\neg (\\neg A)$ can be simplified to $A.$\n\n- Likewise, $\\neg (\\neg (A \\land B))$ can be simplified to $A \\land B.$\n\nTo understand why negations cancel with each other, consider the following statement: \n\n$4$ is divisible by $2.$\n\nThe negation of this statement is \n\n$4$ is **not** divisible by $2.$\n\nIf we negate again, we get back the original sentence: \n\n$4$ divisible by $2.$\n\nSo, if we negate a statement twice, we end up with the original statement.\n\nMore formally, we can prove that $\\neg (\\neg A) \\equiv A$ using a truth table.\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ | $\\,\\neg(\\neg A)\\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n\nSince $A$ and $\\neg(\\neg A)$ have the same truth values, they are logically equivalent." :db/ensure [:tutorial/validate]} {:db/id 17592186152374 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186119775 :knowledge-point/questions ["question-0f13da88-9214-5888-9868-a4b7f8edacdd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0f13da88-9214-5888-9868-a4b7f8edacdd" :question/id #uuid "0f13da88-9214-5888-9868-a4b7f8edacdd" :question/math-academy-id "q-72721" :question/problem "Suppose $B$ is a $4\\times 4$ matrix and $det(B)=-21.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{1}↔{R}_{4}$ (switching the first and the fourth rows). What is the value of $det(C)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(-21) \\\\  & =21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1a456560-f86f-5faa-9eec-30adf9653504"] :db/ensure [:question/validate]} {:db/id "answer-field-1a456560-f86f-5faa-9eec-30adf9653504" :answer-field/id #uuid "1a456560-f86f-5faa-9eec-30adf9653504" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-985861dc-7105-595a-8796-0675f996a2cd" :answer-field/choices ["answer-03965f7f-aad0-5609-b9a0-c3fff1316755" "answer-9993679c-0ae4-5178-a0c0-8b95af338510" "answer-985861dc-7105-595a-8796-0675f996a2cd" "answer-3c8f4efd-35b9-50e5-ae9a-53500e003509" "answer-549efc17-626b-5081-9f88-fae5e1e79be3"] :db/ensure [:answer-field/validate]} {:db/id "answer-03965f7f-aad0-5609-b9a0-c3fff1316755" :answer/id #uuid "03965f7f-aad0-5609-b9a0-c3fff1316755" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "answer-9993679c-0ae4-5178-a0c0-8b95af338510" :answer/id #uuid "9993679c-0ae4-5178-a0c0-8b95af338510" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-985861dc-7105-595a-8796-0675f996a2cd" :answer/id #uuid "985861dc-7105-595a-8796-0675f996a2cd" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-3c8f4efd-35b9-50e5-ae9a-53500e003509" :answer/id #uuid "3c8f4efd-35b9-50e5-ae9a-53500e003509" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "answer-549efc17-626b-5081-9f88-fae5e1e79be3" :answer/id #uuid "549efc17-626b-5081-9f88-fae5e1e79be3" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id 17592186119776 :knowledge-point/questions ["question-687e18db-1843-51e7-a8a0-475f4a6d1676"] :db/ensure [:knowledge-point/validate]} {:db/id "question-687e18db-1843-51e7-a8a0-475f4a6d1676" :question/id #uuid "687e18db-1843-51e7-a8a0-475f4a6d1676" :question/math-academy-id "q-72735" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=80.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{4}:=\\frac{3}{10}{R}_{4}.$ What is the value of $det(C)?$" :question/worked-solution "The row operation applied to $B$ consists of multiplying a row by the number $\\frac{3}{10}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(C) & =\\frac{3}{10}det(B) \\\\  & =\\frac{3}{10}\\cdot 80 \\\\  & =24.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5ac821f-77cc-50ee-b292-5973c2a64068"] :db/ensure [:question/validate]} {:db/id "answer-field-a5ac821f-77cc-50ee-b292-5973c2a64068" :answer-field/id #uuid "a5ac821f-77cc-50ee-b292-5973c2a64068" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3a9117e-d65e-5311-b07f-9d4ca375db48" :answer-field/choices ["answer-3f798de3-28d5-5ba3-8763-15a3b3141a30" "answer-1019053e-6412-5f44-9e4f-1fe6bb45791a" "answer-b3a9117e-d65e-5311-b07f-9d4ca375db48" "answer-cee50cf1-f6c1-5637-a07f-621c8bbfa6d0" "answer-aa538522-a7b3-5bdf-8c80-5b7f518cd7f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-3f798de3-28d5-5ba3-8763-15a3b3141a30" :answer/id #uuid "3f798de3-28d5-5ba3-8763-15a3b3141a30" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-1019053e-6412-5f44-9e4f-1fe6bb45791a" :answer/id #uuid "1019053e-6412-5f44-9e4f-1fe6bb45791a" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-b3a9117e-d65e-5311-b07f-9d4ca375db48" :answer/id #uuid "b3a9117e-d65e-5311-b07f-9d4ca375db48" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-cee50cf1-f6c1-5637-a07f-621c8bbfa6d0" :answer/id #uuid "cee50cf1-f6c1-5637-a07f-621c8bbfa6d0" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-aa538522-a7b3-5bdf-8c80-5b7f518cd7f6" :answer/id #uuid "aa538522-a7b3-5bdf-8c80-5b7f518cd7f6" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id 17592186119851 :knowledge-point/questions ["question-f9fbd8ca-7a83-50db-a6d3-a36d5d6ceb97" "question-620b0d62-bee7-51dc-8bf7-49326cfad693"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f9fbd8ca-7a83-50db-a6d3-a36d5d6ceb97" :question/id #uuid "f9fbd8ca-7a83-50db-a6d3-a36d5d6ceb97" :question/math-academy-id "q-72746" :question/problem "Suppose $C$ is a $3\\times 3$ matrix and $det(C)=-5.$ What is the value of $det(-4C)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot C) &={k}^{n}\\cdot det(C).\\end{aligned}\n$$\n\nIn our case, we have $k=-4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(-4C) & =(-4)^{3}\\cdot det(C) \\\\  & =(-64)\\cdot (-5) \\\\  & =320.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-db33a278-5e86-591a-8a62-14279c3317f5"] :db/ensure [:question/validate]} {:db/id "answer-field-db33a278-5e86-591a-8a62-14279c3317f5" :answer-field/id #uuid "db33a278-5e86-591a-8a62-14279c3317f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd773a2d-7538-5011-95fc-7be41b06dcde" :answer-field/choices ["answer-a334f1d1-81fc-5956-9a40-05a3431dd1e2" "answer-745baa5f-b719-5189-ac4b-4648fef6b3c6" "answer-4243c7f8-2743-5826-8ea3-6ef8e115624e" "answer-fd773a2d-7538-5011-95fc-7be41b06dcde" "answer-51f3b4fe-201b-5333-b047-b7f366028135"] :db/ensure [:answer-field/validate]} {:db/id "answer-a334f1d1-81fc-5956-9a40-05a3431dd1e2" :answer/id #uuid "a334f1d1-81fc-5956-9a40-05a3431dd1e2" :answer/type :answer.type/math :answer/value "-320" :db/ensure [:answer/validate]} {:db/id "answer-745baa5f-b719-5189-ac4b-4648fef6b3c6" :answer/id #uuid "745baa5f-b719-5189-ac4b-4648fef6b3c6" :answer/type :answer.type/math :answer/value "-405" :db/ensure [:answer/validate]} {:db/id "answer-4243c7f8-2743-5826-8ea3-6ef8e115624e" :answer/id #uuid "4243c7f8-2743-5826-8ea3-6ef8e115624e" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-fd773a2d-7538-5011-95fc-7be41b06dcde" :answer/id #uuid "fd773a2d-7538-5011-95fc-7be41b06dcde" :answer/type :answer.type/math :answer/value "320" :db/ensure [:answer/validate]} {:db/id "answer-51f3b4fe-201b-5333-b047-b7f366028135" :answer/id #uuid "51f3b4fe-201b-5333-b047-b7f366028135" :answer/type :answer.type/math :answer/value "405" :db/ensure [:answer/validate]} {:db/id 17592186120512 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "question-620b0d62-bee7-51dc-8bf7-49326cfad693" :question/id #uuid "620b0d62-bee7-51dc-8bf7-49326cfad693" :question/math-academy-id "q-130735" :question/problem "Suppose $B$ is a $2\\times 2$ matrix and $det(B)=-5.$ What is the value of $det(3B)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot B) &={k}^{n}\\cdot det(B).\\end{aligned}\n$$\n\nIn our case, we have $k=3$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(3B) & ={3}^{2}\\cdot det(B) \\\\  & =9\\cdot (-5) \\\\  & =-45.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2198884a-3958-5d29-bb71-9b17ea66099a"] :db/ensure [:question/validate]} {:db/id "answer-field-2198884a-3958-5d29-bb71-9b17ea66099a" :answer-field/id #uuid "2198884a-3958-5d29-bb71-9b17ea66099a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0ac30f51-6622-5c58-93f3-50a3b53c8c93" :answer-field/choices ["answer-6704cf6c-18b2-5a39-a197-97fa19920324" "answer-0ac30f51-6622-5c58-93f3-50a3b53c8c93" "answer-fca72fdf-e0ad-5c57-a47b-0e08014cd557" "answer-c2f7f56b-8fbf-56ae-91f8-59f7c3e1a778" "answer-2f953ef4-f453-5c93-9447-a0748ed46ce3"] :db/ensure [:answer-field/validate]} {:db/id "answer-6704cf6c-18b2-5a39-a197-97fa19920324" :answer/id #uuid "6704cf6c-18b2-5a39-a197-97fa19920324" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "answer-0ac30f51-6622-5c58-93f3-50a3b53c8c93" :answer/id #uuid "0ac30f51-6622-5c58-93f3-50a3b53c8c93" :answer/type :answer.type/math :answer/value "-45" :db/ensure [:answer/validate]} {:db/id "answer-fca72fdf-e0ad-5c57-a47b-0e08014cd557" :answer/id #uuid "fca72fdf-e0ad-5c57-a47b-0e08014cd557" :answer/type :answer.type/math :answer/value "-75" :db/ensure [:answer/validate]} {:db/id "answer-c2f7f56b-8fbf-56ae-91f8-59f7c3e1a778" :answer/id #uuid "c2f7f56b-8fbf-56ae-91f8-59f7c3e1a778" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-2f953ef4-f453-5c93-9447-a0748ed46ce3" :answer/id #uuid "2f953ef4-f453-5c93-9447-a0748ed46ce3" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id 17592186119777 :knowledge-point/questions ["question-a1f0bc2a-d097-538a-b002-360896d3c91f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a1f0bc2a-d097-538a-b002-360896d3c91f" :question/id #uuid "a1f0bc2a-d097-538a-b002-360896d3c91f" :question/math-academy-id "q-130769" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=11.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{4}:=3{R}_{4}$ and ${R}_{2}:={R}_{2}+(-5){R}_{1}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}:={R}_{2}+(-5){R}_{1}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{4}:=3{R}_{4}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we only have to multiply the determinant by $3.$ Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3det(A) \\\\  & =3\\cdot 11 \\\\  & =33.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-711af9c2-1d4a-5a9f-9a30-ae443b985da0"] :db/ensure [:question/validate]} {:db/id "answer-field-711af9c2-1d4a-5a9f-9a30-ae443b985da0" :answer-field/id #uuid "711af9c2-1d4a-5a9f-9a30-ae443b985da0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45da5c6a-1bde-5117-8afe-03d361230714" :answer-field/choices ["answer-90deae41-5fa1-5e16-8e84-6b13e063a540" "answer-68fa8711-c3f3-5012-9d1a-fb731bd236f7" "answer-8f6393fe-d927-53da-81a2-0f66da9f7288" "answer-c6b642dc-e552-5c4b-8e91-0e291d1d1b44" "answer-45da5c6a-1bde-5117-8afe-03d361230714"] :db/ensure [:answer-field/validate]} {:db/id "answer-90deae41-5fa1-5e16-8e84-6b13e063a540" :answer/id #uuid "90deae41-5fa1-5e16-8e84-6b13e063a540" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "answer-68fa8711-c3f3-5012-9d1a-fb731bd236f7" :answer/id #uuid "68fa8711-c3f3-5012-9d1a-fb731bd236f7" :answer/type :answer.type/math :answer/value "-33" :db/ensure [:answer/validate]} {:db/id "answer-8f6393fe-d927-53da-81a2-0f66da9f7288" :answer/id #uuid "8f6393fe-d927-53da-81a2-0f66da9f7288" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "answer-c6b642dc-e552-5c4b-8e91-0e291d1d1b44" :answer/id #uuid "c6b642dc-e552-5c4b-8e91-0e291d1d1b44" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-45da5c6a-1bde-5117-8afe-03d361230714" :answer/id #uuid "45da5c6a-1bde-5117-8afe-03d361230714" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id 17592186119850 :knowledge-point/questions ["question-d7915d65-a649-5e77-8661-8aa533c4bd16"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d7915d65-a649-5e77-8661-8aa533c4bd16" :question/id #uuid "d7915d65-a649-5e77-8661-8aa533c4bd16" :question/math-academy-id "q-43045" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=3$, find $det(Y).$\n\n$$\nX=\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 0 & -1 \\\\ 4 & 3 & 2\\end{bmatrix},\\,Y=\\begin{bmatrix}4 & 3 & 2 \\\\ 1 & 0 & -1 \\\\ 3 & 0 & -2\\end{bmatrix}?\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $1$st and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(3) \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-931b45ae-bf74-5d0e-9144-dd8d9e9c7b50"] :db/ensure [:question/validate]} {:db/id "answer-field-931b45ae-bf74-5d0e-9144-dd8d9e9c7b50" :answer-field/id #uuid "931b45ae-bf74-5d0e-9144-dd8d9e9c7b50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1c95cd97-d991-586e-9d48-4aceab408e83" :answer-field/choices ["answer-fac8b0ff-2e76-500f-9b69-1448d6083a6d" "answer-1c95cd97-d991-586e-9d48-4aceab408e83" "answer-9747a53a-fd06-5bad-9209-5355bca6ff7c" "answer-804d6b51-a8c2-5553-b8eb-99abf73a0c50" "answer-ac341626-a276-5402-9622-674048295496"] :db/ensure [:answer-field/validate]} {:db/id "answer-fac8b0ff-2e76-500f-9b69-1448d6083a6d" :answer/id #uuid "fac8b0ff-2e76-500f-9b69-1448d6083a6d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1c95cd97-d991-586e-9d48-4aceab408e83" :answer/id #uuid "1c95cd97-d991-586e-9d48-4aceab408e83" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-9747a53a-fd06-5bad-9209-5355bca6ff7c" :answer/id #uuid "9747a53a-fd06-5bad-9209-5355bca6ff7c" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-804d6b51-a8c2-5553-b8eb-99abf73a0c50" :answer/id #uuid "804d6b51-a8c2-5553-b8eb-99abf73a0c50" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ac341626-a276-5402-9622-674048295496" :answer/id #uuid "ac341626-a276-5402-9622-674048295496" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186121020 :tutorial/content "Remember the following three standard elementary row operations: \n\n  I. Swapping two rows\n\n  II. Multiplying a row by a non-zero number\n\n  III. Adding a multiple of one row to another row\n\nOf these three elementary row operations, only III (adding a multiple of one row to another row) *preserves* the determinant. The other two operations, switching two rows or multiplying a row by a non-zero number, *change* the determinant.\n\nTo demonstrate, let's consider the matrix ![](images/fa/fa51d7c585db408c47e8640ae839c1a3bbf94e2b0097e1ade511e5773461f1e8.svg) Taking the determinant, we have\n![](images/bc/bcf5c5dc9f5b7ed3849e719665f802040cf51e3334ae99e25ea7648cbb0f6134.svg)\n\nIf we swap the two rows, we get a different determinant:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 4 \\\\ 1 & 2\\end{vmatrix} & =3\\cdot 2-1\\cdot 4 \\\\  & =2 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nLikewise, if we multiply top row by ${\\color{red}2},$ then we get a different determinant:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{vmatrix} & =\\begin{vmatrix}2 & 4 \\\\ 3 & 4\\end{vmatrix} \\\\  & =2\\cdot 4-3\\cdot 4 \\\\  & =-4 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nHowever, if we add twice the top row to the bottom row, then we get the same determinant:\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 \\\\ 3+2\\cdot 1 & 4+2\\cdot 2\\end{vmatrix} & =\\begin{vmatrix}1 & 2 \\\\ 5 & 8\\end{vmatrix} \\\\  & =1\\cdot 8-2\\cdot 5 \\\\  & =-2\\,✓\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186121061 :tutorial/content "Let's check what happens if we multiply the entire matrix (not only one row) by a number. For example,\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 \\\\ 3 & 4\\end{vmatrix} & =1\\cdot 4-2\\cdot 3=-2 \\\\ \\begin{vmatrix}3\\cdot 1 & 3\\cdot 2 \\\\ 3\\cdot 3 & 3\\cdot 4\\end{vmatrix}=\\begin{vmatrix}3 & 6 \\\\ 9 & 12\\end{vmatrix} & =3\\cdot 12-6\\cdot 9=-18\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n![](images/fe/fe02091dde43a8a2405f6b588f619bc9fa3f54b31ac8a1ac39d318761f00cc3e.svg)\n\nThe above is equivalent to multiplying both rows of the matrix by $3$. Multiplying the first row scales the determinant by $3$, and then multiplying the second row scales it by $3$ once more.\n\nIn general, multiplying an entire $n \\times n$ matrix by a number multiplies the determinant by that number to the power of $n$. That is to say, we can factor out the common multiplier from the entire matrix, as follows:\n\n$$\n\\begin{aligned}det(k\\cdot A) &={k}^{n}\\cdot det(A),\\end{aligned}\n$$\n\nwhere $A$ is an $n \\times n$ matrix." :db/ensure [:tutorial/validate]} {:db/id "activity-6e245c04-c2d0-5852-8dd2-a60dcd6eacc6" :activity/id #uuid "6e245c04-c2d0-5852-8dd2-a60dcd6eacc6" :activity/title "The Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186050205 :activity/course 17592186046673 :activity/steps ["step-025b43f4-b967-5253-bd0e-79c0a7e61eb7" "step-bae43cd4-2894-5748-af7f-58bb84a78460" "step-f0b21a73-a136-59a6-b7ba-ff9eb528fdea" "step-2a23e0e8-1c08-5797-a82e-444164856bab" "step-87464141-2ebf-5e8e-893b-bce2c468aee9"] :activity/first-step "step-025b43f4-b967-5253-bd0e-79c0a7e61eb7" :db/ensure [:activity/validate]} {:db/id "step-025b43f4-b967-5253-bd0e-79c0a7e61eb7" :step/id #uuid "025b43f4-b967-5253-bd0e-79c0a7e61eb7" :step/content 17592186269236 :step/next "step-bae43cd4-2894-5748-af7f-58bb84a78460" :db/ensure [:step/validate]} {:db/id "step-bae43cd4-2894-5748-af7f-58bb84a78460" :step/id #uuid "bae43cd4-2894-5748-af7f-58bb84a78460" :step/content 17592186383417 :step/next "step-f0b21a73-a136-59a6-b7ba-ff9eb528fdea" :db/ensure [:step/validate]} {:db/id "step-f0b21a73-a136-59a6-b7ba-ff9eb528fdea" :step/id #uuid "f0b21a73-a136-59a6-b7ba-ff9eb528fdea" :step/content 17592186383424 :step/next "step-2a23e0e8-1c08-5797-a82e-444164856bab" :db/ensure [:step/validate]} {:db/id "step-2a23e0e8-1c08-5797-a82e-444164856bab" :step/id #uuid "2a23e0e8-1c08-5797-a82e-444164856bab" :step/content 17592186400770 :step/next "step-87464141-2ebf-5e8e-893b-bce2c468aee9" :db/ensure [:step/validate]} {:db/id "step-87464141-2ebf-5e8e-893b-bce2c468aee9" :step/id #uuid "87464141-2ebf-5e8e-893b-bce2c468aee9" :step/content 17592186383431 :db/ensure [:step/validate]}]
