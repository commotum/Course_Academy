culty/moderate :question/answer-fields ["answer-field-bb3e3723-e2fb-5d7d-804d-fb8906580c7f"] :db/ensure [:question/validate]} {:db/id "answer-field-bb3e3723-e2fb-5d7d-804d-fb8906580c7f" :answer-field/id #uuid "bb3e3723-e2fb-5d7d-804d-fb8906580c7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" :answer-field/choices ["answer-9b44e64a-ef11-5643-bba7-4edf2771b18c" "answer-860b304b-fdef-50c1-a8f9-1d4f7d6c80f0" "answer-f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" "answer-927cf730-faf8-54b2-8fed-fd747b35d27b" "answer-aface0d3-28ef-5767-b68a-4f300ce0b8e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b44e64a-ef11-5643-bba7-4edf2771b18c" :answer/id #uuid "9b44e64a-ef11-5643-bba7-4edf2771b18c" :answer/type :answer.type/text :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-1$ | $0$ | $2$ | $3$ | $5$ | $2$ | $1$ |" :db/ensure [:answer/validate]} {:db/id "answer-860b304b-fdef-50c1-a8f9-1d4f7d6c80f0" :answer/id #uuid "860b304b-fdef-50c1-a8f9-1d4f7d6c80f0" :answer/type :answer.type/text :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-5$ | $-5$ | $-5$ | $5$ | $5$ | $5$ | $5$ |" :db/ensure [:answer/validate]} {:db/id "answer-f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" :answer/id #uuid "f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" :answer/type :answer.type/text :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $0$ | $1$ | $4$ | $9$ | $5$ | $2$ | $0$ |" :db/ensure [:answer/validate]} {:db/id "answer-927cf730-faf8-54b2-8fed-fd747b35d27b" :answer/id #uuid "927cf730-faf8-54b2-8fed-fd747b35d27b" :answer/type :answer.type/text :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $2$ | $3$ | $1$ | $0$ | $-3$ | $0$ | $2$ |" :db/ensure [:answer/validate]} {:db/id "answer-aface0d3-28ef-5767-b68a-4f300ce0b8e2" :answer/id #uuid "aface0d3-28ef-5767-b68a-4f300ce0b8e2" :answer/type :answer.type/text :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $5$ | $4$ | $2$ | $1$ | $0$ | $3$ | $-5$ |" :db/ensure [:answer/validate]} {:db/id 17592186179680 :knowledge-point/questions ["question-2640409b-d45b-5385-980a-142f0264d172"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2640409b-d45b-5385-980a-142f0264d172" :question/id #uuid "2640409b-d45b-5385-980a-142f0264d172" :question/math-academy-id "q-91377" :question/problem "Find the real solution to the equation $7(x+8)^{3}=448.$" :question/worked-solution "We can solve this equation by isolating the $(x+8)^{3}$ term and then taking the $3$rd root of each side.\n\nFirst, let's isolate the $(x+8)^{3}$ term on the left-hand side:\n\n$$\n\\begin{aligned}7(x+8)^{3} & =448 \\\\ (x+8)^{3} & =64\\end{aligned}\n$$\n\nNow, we take the $3$rd root of each side and solve for $x.$ Since $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x+8)^{3} & =64 \\\\ \\sqrt[3]{(x+8)^{3}} & =\\sqrt[3]{64} \\\\ x+8 & =\\sqrt[3]{{4}^{3}} \\\\ x+8 & =4 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the solution is $x=-4.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5fb51e4b-a7de-5bfc-88df-e0414848a022"] :db/ensure [:question/validate]} {:db/id "answer-field-5fb51e4b-a7de-5bfc-88df-e0414848a022" :answer-field/id #uuid "5fb51e4b-a7de-5bfc-88df-e0414848a022" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21bfb5c8-f1b5-5037-ac95-35350afae358" :answer-field/choices ["answer-e4da1d39-17a3-5794-884b-8132e2024b79" "answer-21bfb5c8-f1b5-5037-ac95-35350afae358" "answer-f62b1c4e-5723-5c47-8d07-8833ef1bf8b6" "answer-8e348a7d-563f-55ea-8112-8e81e97af76f" "answer-db9bf25d-437b-5c50-b346-6e6a6df8cdff"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4da1d39-17a3-5794-884b-8132e2024b79" :answer/id #uuid "e4da1d39-17a3-5794-884b-8132e2024b79" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-21bfb5c8-f1b5-5037-ac95-35350afae358" :answer/id #uuid "21bfb5c8-f1b5-5037-ac95-35350afae358" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-f62b1c4e-5723-5c47-8d07-8833ef1bf8b6" :answer/id #uuid "f62b1c4e-5723-5c47-8d07-8833ef1bf8b6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-8e348a7d-563f-55ea-8112-8e81e97af76f" :answer/id #uuid "8e348a7d-563f-55ea-8112-8e81e97af76f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-db9bf25d-437b-5c50-b346-6e6a6df8cdff" :answer/id #uuid "db9bf25d-437b-5c50-b346-6e6a6df8cdff" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186105699 :knowledge-point/questions ["question-e8619f65-a151-5133-8a41-d7413e4c5c11"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e8619f65-a151-5133-8a41-d7413e4c5c11" :question/id #uuid "e8619f65-a151-5133-8a41-d7413e4c5c11" :question/math-academy-id "q-53020" :question/problem "![](images/d4/d4c1c22e521c157ee7e8d00e4ca545b98d04f56721c58c0b6ec46c2126e4f2ff.png)\n\nThe diagram shows a regular nonagon and a regular hexagon. Find the measure of the shaded angle." :question/worked-solution "The shaded angle is the sum of the measures of exterior angles of a regular nonagon and a regular hexagon.\n\n![](images/a6/a64e0e57966f7b99b6d0f0af843dff25b7a87ed77347643212e04b0f5b8f5cd7.png)\n\nFor any polygon, the exterior angles sum to ${360}^{∘}.$ In a regular nonagon, there are $9$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{9}={40}^{∘}.\n$$\n\nLikewise, in a regular hexagon, there are $6$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{6}={60}^{∘}.\n$$\n\nTherefore, the given angle has the following measure:\n\n$$\n{40}^{∘}+{60}^{∘}={100}^{∘}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5339208d-786c-5398-99e5-c80478b4a3f9"] :db/ensure [:question/validate]} {:db/id "answer-field-5339208d-786c-5398-99e5-c80478b4a3f9" :answer-field/id #uuid "5339208d-786c-5398-99e5-c80478b4a3f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e66bb389-c035-5fd8-8777-f783cd56f28b" :answer-field/choices ["answer-e66bb389-c035-5fd8-8777-f783cd56f28b" "answer-a19382a0-cf6f-5da6-94fe-6b417af2e686" "answer-2c299815-f6ac-5d78-aa46-c51ec1f84214" "answer-78db8668-72cc-5dfd-9eea-dd112e17a29b" "answer-138638a6-770e-57c5-8a80-cbf00d10a6a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-e66bb389-c035-5fd8-8777-f783cd56f28b" :answer/id #uuid "e66bb389-c035-5fd8-8777-f783cd56f28b" :answer/type :answer.type/math :answer/value "{100}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a19382a0-cf6f-5da6-94fe-6b417af2e686" :answer/id #uuid "a19382a0-cf6f-5da6-94fe-6b417af2e686" :answer/type :answer.type/math :answer/value "{105}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-2c299815-f6ac-5d78-aa46-c51ec1f84214" :answer/id #uuid "2c299815-f6ac-5d78-aa46-c51ec1f84214" :answer/type :answer.type/math :answer/value "{110}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-78db8668-72cc-5dfd-9eea-dd112e17a29b" :answer/id #uuid "78db8668-72cc-5dfd-9eea-dd112e17a29b" :answer/type :answer.type/math :answer/value "{120}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-138638a6-770e-57c5-8a80-cbf00d10a6a9" :answer/id #uuid "138638a6-770e-57c5-8a80-cbf00d10a6a9" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186204090 :knowledge-point/questions ["question-db12ae2f-b0be-5f71-b38b-bd9f3742126a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-db12ae2f-b0be-5f71-b38b-bd9f3742126a" :question/id #uuid "db12ae2f-b0be-5f71-b38b-bd9f3742126a" :question/math-academy-id "q-287666" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n2(p-1)x=5\n$$\n\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ax=b.$ In this case, \n\n$$\na=2(p-1),\\,b=5.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n2(p-1)=0.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}2(p-1) & =0 \\\\ \\frac{2(p-1)}{2} & =\\frac{0}{2} \\\\ p-1 & =0 \\\\ p & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-591c8064-4806-5fc4-b702-61324eb39f7a"] :db/ensure [:question/validate]} {:db/id "answer-field-591c8064-4806-5fc4-b702-61324eb39f7a" :answer-field/id #uuid "591c8064-4806-5fc4-b702-61324eb39f7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3ee14911-7081-554f-b8d8-c2399f3e2fea" :answer-field/choices ["answer-ae6cdbb0-8b45-5733-9a25-c1b2d3d49dab" "answer-7f989685-a501-52c8-91ad-94b0ba9a226e" "answer-5103d28e-3250-582a-a1d3-aaef1d053eb2" "answer-3ee14911-7081-554f-b8d8-c2399f3e2fea" "answer-8b54626f-a13a-5186-8fed-3f876265809b"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae6cdbb0-8b45-5733-9a25-c1b2d3d49dab" :answer/id #uuid "ae6cdbb0-8b45-5733-9a25-c1b2d3d49dab" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-7f989685-a501-52c8-91ad-94b0ba9a226e" :answer/id #uuid "7f989685-a501-52c8-91ad-94b0ba9a226e" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-5103d2