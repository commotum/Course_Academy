e right, the function $f(x)$ again approaches $\\infty .$ So, the right-hand limit is\n\n$$\n{lim}_{x\\to {6}^{+}}f(x)=\\infty \\,.\n$$\n\nConsequently,\n\n$$\n{lim}_{x\\to 6}f(x)=\\infty \\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6f9558dc-c88c-5f2c-b94c-48629251ff71"] :db/ensure [:question/validate]} {:db/id "answer-field-6f9558dc-c88c-5f2c-b94c-48629251ff71" :answer-field/id #uuid "6f9558dc-c88c-5f2c-b94c-48629251ff71" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-df1eac84-5cbe-5960-af4e-3fe21f5a9174" :answer-field/choices ["answer-df1eac84-5cbe-5960-af4e-3fe21f5a9174"] :db/ensure [:answer-field/validate]} {:db/id "answer-df1eac84-5cbe-5960-af4e-3fe21f5a9174" :answer/id #uuid "df1eac84-5cbe-5960-af4e-3fe21f5a9174" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "activity-7d547591-39b0-5426-ba80-73a612b8f3b7" :activity/id #uuid "7d547591-39b0-5426-ba80-73a612b8f3b7" :activity/title "Infinite Limits from Graphs" :activity/type :activity.type/review :activity/scope 17592186051049 :activity/course 17592186046647 :activity/steps ["step-1c87e3a0-0132-57e9-9e94-d890526a21d4" "step-3ede1871-f5b8-5de6-b960-f025a0d82481" "step-51ae2c5a-962e-5d21-8c31-b89b3b4db781" "step-df01aa43-5f29-55b3-96cc-9f5e0a72a50a"] :activity/first-step "step-1c87e3a0-0132-57e9-9e94-d890526a21d4" :db/ensure [:activity/validate]} {:db/id "step-1c87e3a0-0132-57e9-9e94-d890526a21d4" :step/id #uuid "1c87e3a0-0132-57e9-9e94-d890526a21d4" :step/content "question-b8283679-623f-5e9d-b3dc-5a2b30321fdc" :step/next "step-3ede1871-f5b8-5de6-b960-f025a0d82481" :db/ensure [:step/validate]} {:db/id "step-3ede1871-f5b8-5de6-b960-f025a0d82481" :step/id #uuid "3ede1871-f5b8-5de6-b960-f025a0d82481" :step/content "question-b2b0f174-efe7-5216-b895-6e427b351bde" :step/next "step-51ae2c5a-962e-5d21-8c31-b89b3b4db781" :db/ensure [:step/validate]} {:db/id "step-51ae2c5a-