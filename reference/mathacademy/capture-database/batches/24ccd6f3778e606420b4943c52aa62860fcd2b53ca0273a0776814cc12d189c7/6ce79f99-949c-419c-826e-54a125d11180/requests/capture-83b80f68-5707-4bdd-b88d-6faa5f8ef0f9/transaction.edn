1f8bf3483" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer-field/choices ["answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27"] :db/ensure [:answer-field/validate]} {:db/id "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/id #uuid "57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186129260 :knowledge-point/questions ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" "question-e2036c5e-2390-5572-8e7b-4c6870ad7092"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/id #uuid "6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/math-academy-id "q-337883" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -3}\\sqrt[3]{7x-6}=$\n{{field-1}}" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to -3}\\sqrt[3]{7x-6} & =\\sqrt[3]{7(-3)-6} \\\\  & =\\sqrt[3]{-27} \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35"] :db/ensure [:question/validate]} {:db/id "answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/id #uuid "a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer-field/choices ["answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/id #uuid "a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/id #uuid "e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/math-academy-id "q-47030" :question/problem "Calculate ${lim}_{x\\to (-3)}\\sqrt[3]{3x+9}.$" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)}\\sqrt[3]{3x+9} & =\\sqrt[3]{3(-3)+9} \\\\  & =\\sqrt[3]{0} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ffd166d5-4d21-5931-892a-8c7a62e2391f"] :db/ensure [:question/validate]} {:db/id "answer-field-ffd166d5-4d21-5931-892a-8c7a62e2391f" :answer-field/id #uuid "ffd166d5-4d21-5931-892a-8c7a62e2391f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer-field/choices ["answer-afeeae55-0de4-520e-8a33-1a73f89436a3" "answer-ed910bcb-c45c-590f-96de-77266658fafe" "answer-f5718a2a-5072-5b1f-968f-fb515cabbbec" "answer-5ea5e906-b90b-5b73-ba18-97c53de970e5" "answer-03491c58-45d4-593a-8833-c523eef6f713"] :db/ensure [:answer-field/validate]} {:db/id "answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/id #uuid "afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ed910bcb-c45c-590f-96de-77266658fafe" :answer/id #uuid "ed910bcb-c45c-590f-96de-77266658fafe" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f5718a2a-5072-5b1f-968f-fb515cabbbec" :answer/id #uuid "f5718a2a-5072-5b1f-968f-fb515cabbbec" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-5ea5e906-b90b-5b73-ba18-97c53de970e5" :answer/id #uuid "5ea5e906-b90b-5b73-ba18-97c53de970e5" :answer/type :answer.type/math :answer/value "\\sqrt[3]{9}" :db/ensure [:answer/validate]} {:db/id "answer-03491c58-45d4-593a-8833-c523eef6f713" :answer/id #uuid "03491c58-45d4-593a-8833-c523eef6f713" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186129195 :knowledge-point/questions ["question-887153cd-9896-52b0-b927-cb3be4108046" "question-fc34fb90-8995-5075-866b-ef20040dee62"] :db/ensure [:knowledge-point/validate]} {:db/id "question-887153cd-9896-52b0-b927-cb3be4108046" :question/id #uuid "887153cd-9896-52b0-b927-cb3be4108046" :question/math-academy-id "q-337904" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\,\\sqrt[3]{-6-3x}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\sqrt[3]{-6-3x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/48/481fd6651401a37e221648026506b508f3ba9984a0637c2f2219c52a5f561b23.png)\n\nFrom the graph, we see that the function decreases without bound as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }f(x)=-\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2188212-e382-544c-835c-9192c8bf0f9a"] :db/ensure [:question/validate]} {:db/id "answer-field-c2188212-e382-544c-835c-9192c8bf0f9a" :answer-field/id #uuid "c2188212-e382-544c-835c-9192c8bf0f9a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-61606271-882c-55fa-afae-9c47c12185ca" :answer-field/choices ["answer-61606271-882c-55fa-afae-9c47c12185ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-61606271-882c-55fa-afae-9c47c12185ca" :answer/id #uuid "61606271-882c-55fa-afae-9c47c12185ca" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "question-fc34fb90-8995-5075-866b-ef20040dee62" :question/id #uuid "fc34fb90-8995-5075-866b-ef20040dee62" :question/math-academy-id "q-99792" :question/problem "${lim}_{x\\to -\\infty }\\,\\sqrt[3]{7-3x}=$" :question/worked-solution "Let $f(x)=\\sqrt[3]{7-3x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/5e/5e1d8114757e72cefa7c861cef054545a4adf4868bbb9e602683dc4b960bb428.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4909d287-3318-53e5-9ea2-409a7c8fe123"] :db/ensure [:question/validate]} {:db/id "answer-field-4909d287-3318-53e5-9ea2-409a7c8fe123" :answer-field/id #uuid "4909d287-3318-53e5-9ea2-409a7c8fe123" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer-field/choices ["answer-d5db5f04-aa9c-58d3-9a00-7c4085e976a3" "answer-306bbf6d-7b89-5eb8-ab32-f4ee513fe024" "answer-6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" "answer-047ce78e-011e-5d8d-880e-3f85520cc9e0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5db5f04-aa9c-58d3-9a00-7c4085e976a3" :answer/id #uuid "d5db5f04-aa9c-58d3-9a00-7c4085e976a3" :answer/type :answer.type/math :answer/value "-\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "answer-306bbf6d-7b89-5eb8-ab32-f4ee513fe024" :answer/id #uuid "306bbf6d-7b89-5eb8-ab32-f4ee513fe024" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" :answer/id #uuid "6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer/id #uuid "9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-047ce78e-011e-5d8d-880e-3f85520cc9e0" :answer/id #uuid "047ce78e-011e-5d8d-880e-3f85520cc9e0" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186130324 :tutorial/content "Consider the graph of $y=\\sqrt{x}$ below. We will use this graph to compute $\\lim\\limits_{x \\to \\, 4} \\sqrt{x} \\, .$\n\n![](images/e6/e6423b96ce60348e780ffd437207bdbeb456e3aae2888d7525f8c4e680f4ee43.png)\n\nFrom the graph, we see that as $x$ approaches $4,$ the value of $y$ approaches $\\sqrt{4}.$ Therefore,\n\n$$\n\\lim\\limits_{x\\to 4} \\sqrt{x} = \\sqrt{4} = 2.\n$$\n\nThe limit of the square root function at a point is equal to the value of the square root function at that point, and this is true for any point *that is greater than $0.$* However, for points that are less than or equal to $0,$ the limit does not exist:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,c}\\sqrt{x}=\\{\\begin{aligned}\\sqrt{c} & \\text{ if }c>0 \\\\ \\text{DNE} & \\text{ if }c\\le 0\\end{aligned}\\end{aligned}\n$$\n\nWhy doesn't the limit exist for $c \\leq 0$?\n\n- For $c < 0,$ the limit $\\lim\\limits_{x \\to \\, c} \\sqrt{x}$ does not exist because the square root function $f(x) = \\sqrt{x}$ is not defined for negative inputs.\n\n- Although $\\sqrt{x}$ is defined at $x=0,$ the left limit $\\lim\\limits_{x \\to \\, 0^-} \\sqrt{x}$ does not exist because $\\sqrt{x}$ is undefined left of $x=0.$ Consequently, the overall limit $\\lim\\limits_{x \\to \\, 0} \\sqrt{x}$ does not exist either." :db/ensure [:tutorial/validate]} {:db/id 17592186130325 :tutorial/content "Let's go back to our plot of $y=\\sqrt x$ and work out its limits at infinity.\n\n![](images/a0/a04b7cbc735c20a866b1d22287e2f3a1ffc247931c2de08c545cbd2fe922397b.png)\n\nAs $x \\to \\infty,$ the square root function increases without bound. So, we have\n\n$$\n\\lim_{x\\to \\infty}\\sqrt{x} = \\infty.\n$$\n\nOn the other hand, when computing the limit as $x \\to -\\infty,$ remember that the square root function isn't defined for $x<0.$ Therefore,\n\n$$\n\\lim_{x\\to -\\infty}\\sqrt{x} = \\textrm{DNE}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186130326 :tutorial/content "Consider the graph of the cube root function $y=\\sqrt[3]{x}$ below.\n\n![](images/20/20deb13b6bce6608c84db84472e19ade1d073c9562f4c414ebee36f4f9e9aebc.png)\n\nUnlike the square root function, the cube root is defined for all real $x.$ As $x$ approaches any finite number $a,$ the limit of the cube root function can be obtained by simply substituting $x=a$ into the cube root:\n\n$$\n\\lim_{x\\to a} \\sqrt[3]{x} = \\sqrt[3]{a}\n$$\n\nAdditionally, we can see from the graph that the limits at infinity are\n\n$$\n\\lim_{x\\to \\infty} \\sqrt[3]{x} = \\infty \\qquad \\textrm{and}\\qquad \\lim_{x\\to -\\infty} \\sqrt[3]{x} = -\\infty.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186129334 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124606 :knowledge-point/questions ["question-551372ab-8536-5d27-a0f1-42bcde72d2ee" "question-4d8fdbb6-cc34-5cc1-be22-82ba675a440f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-551372ab-8536-5d27-a0f1-42bcde72d2ee" :question/id #uuid "551372ab-8536-5d27-a0f1-42bcde72d2ee" :question/math-academy-id "q-106067" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)={x}^{2}+{y}^{2}+1$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-1,1⟩$ and $b=⟨2,-2⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)={x}^{2}+{y}^{2}+1$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-1,1⟩$ and $b=⟨2,-2⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(2,-2)-f(-1,1) & =∇f(c)\\cdot (⟨2,-2⟩-⟨-1,1⟩) \\\\ ((-2)^{2}+{2}^{2}+1)-({1}^{2}+(-1)^{2}+1) & =∇f(c)\\cdot ⟨3,-3⟩ \\\\ 9-3 & =∇f(c)\\cdot ⟨3,-3⟩ \\\\ 6 & =∇f(c)\\cdot ⟨3,-3⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨2x,2y⟩, \\\\ ∇f(c) & =⟨2{c}_{1},2{c}_{2}⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}6 & =∇f⟨c⟩\\cdot ⟨3,-3⟩ \\\\ 6 & =⟨2{c}_{1},2{c}_{2}⟩\\cdot ⟨3,-3⟩ \\\\ 6 & =6{c}_{1}-6{c}_{2} \\\\ 1 & ={c}_{1}-{c}_{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-1}{-2-1} & =\\frac{x-(-1)}{2-(-1)} \\\\ \\frac{y-1}{(-3)} & =\\frac{x+1}{3} \\\\ y-1 & =-(x+1) \\\\ y & =-x.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =-{c}_{1}.\\end{aligned}\n$$\n\nSubstituting the above into the equation ${c}_{1}-{c}_{2}=1,$ we get \n\n$$\n\\begin{aligned}{c}_{1}-(-{c}_{1}) & =1 \\\\ 2{c}_{1} & =1 \\\\ {c}_{1} & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally, we find ${c}_{2}=-{c}_{1}=-\\frac{1}{2}.$ So, the point $C$ that satisfies the mean value theorem is $(\\frac{1}{2},-\\frac{1}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1e0aed6d-6aa4-591d-a07c-58e38ed2d1dd"] :db/ensure [:question/validate]} {:db/id "answer-field-1e0aed6d-6aa4-591d-a07c-58e38ed2d1dd" :answer-field/id #uuid "1e0aed6d-6aa4-591d-a07c-58e38ed2d1dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9171ed9d-70aa-51df-aeed-e5ec02c4a3a3" :answer-field/choices ["answer-b7377674-4129-5146-89ba-a65a50896132" "answer-a34be0b0-f3d4-5dba-9880-eceaf7d7e3bf" "answer-d2584164-f33e-5a05-87c7-b1c5385ed371" "answer-9171ed9d-70aa-51df-aeed-e5ec02c4a3a3" "answer-dc33850d-9b75-50ba-b0d0-a512650bf018"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7377674-4129-5146-89ba-a65a50896132" :answer/id #uuid "b7377674-4129-5146-89ba-a65a50896132" :answer/type :answer.type/math :answer/value "(-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-a34be0b0-f3d4-5dba-9880-eceaf7d7e3bf" :answer/id #uuid "a34be0b0-f3d4-5dba-9880-eceaf7d7e3bf" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-d2584164-f33e-5a05-87c7-b1c5385ed371" :answer/id #uuid "d2584164-f33e-5a05-87c7-b1c5385ed371" :answer/type :answer.type/math :answer/value "(1,-1)" :db/ensure [:answer/validate]} {:db/id "answer-9171ed9d-70aa-51df-aeed-e5ec02c4a3a3" :answer/id #uuid "9171ed9d-70aa-51df-aeed-e5ec02c4a3a3" :answer/type :answer.type/math :answer/value "(\\frac{1}{2},-\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-dc33850d-9b75-50ba-b0d0-a512650bf018" :answer/id #uuid "dc33850d-9b75-50ba-b0d0-a512650bf018" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},-\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "question-4d8fdbb6-cc34-5cc1-be22-82ba675a440f" :question/id #uuid "4d8fdbb6-cc34-5cc1-be22-82ba675a440f" :question/math-academy-id "q-106091" :question/problem "Determine the points that satisfy the mean value theorem for $f(x,y)=y-{x}^{3}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-2,-8⟩$ and $b=⟨1,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)=y-{x}^{3}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-2,-8⟩$ and $b=⟨1,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(1,0)-f(-2,-8) & =∇f(c)\\cdot (⟨1,0⟩-⟨-2,-8⟩) \\\\ (0-{1}^{3})-(-8-(-2)^{3}) & =∇f(c)\\cdot ⟨3,8⟩ \\\\ -1 & =∇f(c)\\cdot ⟨3,8⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨-3{x}^{2},1⟩, \\\\ ∇f(c) & =⟨-3{c}_{1}^{2},1⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}-1 & =∇f⟨c⟩\\cdot ⟨3,8⟩ \\\\ -1 & =⟨-3{c}_{1}^{2},1⟩\\cdot ⟨3,8⟩ \\\\ -1 & =-9{c}_{1}^{2}+8 \\\\ 9{c}_{1}^{2} & =9 \\\\ {c}_{1}^{2} & =1 \\\\ {c}_{1} & =\\pm 1.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-(-8)}{0-(-8)} & =\\frac{x-(-2)}{1-(-2)} \\\\ \\frac{y+8}{8} & =\\frac{x+2}{3} \\\\ y+8 & =\\frac{8(x+2)}{3} \\\\ y & =\\frac{8(x-1)}{3}.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =\\frac{8({c}_{1}-1)}{3}.\\end{aligned}\n$$\n\nNow we proceed to find the coordinates of the points that satisfy the mean value theorem.\n\n- For ${c}_{1}=-1,$ we obtain\n\n$$\n{c}_{2}=\\frac{8(-1-1)}{3}=-\\frac{16}{3}.\n$$\n\nTherefore, the coordinates of the first point are $(-1,-\\frac{16}{3}).$\n\n- For ${c}_{1}=1,$ we obtain\n\n$$\n{c}_{2}=\\frac{8(1-1)}{3}=0.\n$$\n\nTherefore, the coordinates of the second point are $(1,0).$\n\nFinally we can conclude that the coordinates of the points that satisfy the mean value theorem are $(-1,-\\frac{16}{3})$ and $(1,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-656518d1-a3d5-5c0a-b159-52a12f937780"] :db/ensure [:question/validate]} {:db/id "answer-field-656518d1-a3d5-5c0a-b159-52a12f937780" :answer-field/id #uuid "656518d1-a3d5-5c0a-b159-52a12f937780" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5167de5-1b72-575f-8c14-8ac0426c389b" :answer-field/choices ["answer-f5167de5-1b72-575f-8c14-8ac0426c389b" "answer-4ecbea3d-3768-526f-8f06-5921414062ef" "answer-ae7b1906-bd98-5dd9-9960-0ccd94df2fc0" "answer-7344b7b9-f641-5fed-b0e8-3e2ad93004d5" "answer-099e07ff-2aa2-51ce-8ec5-e580916dce57"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5167de5-1b72-575f-8c14-8ac0426c389b" :answer/id #uuid "f5167de5-1b72-575f-8c14-8ac0426c389b" :answer/type :answer.type/text :answer/value "$(-1,-\\frac{16}{3})$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-4ecbea3d-3768-526f-8f06-5921414062ef" :answer/id #uuid "4ecbea3d-3768-526f-8f06-5921414062ef" :answer/type :answer.type/text :answer/value "$(-2,-8)$ and $(0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-ae7b1906-bd98-5dd9-9960-0ccd94df2fc0" :answer/id #uuid "ae7b1906-bd98-5dd9-9960-0ccd94df2fc0" :answer/type :answer.type/text :answer/value "$(-\\frac{1}{2},-3)$ and $(\\frac{1}{3},\\frac{1}{2})$" :db/ensure [:answer/validate]} {:db/id "answer-7344b7b9-f641-5fed-b0e8-3e2ad93004d5" :answer/id #uuid "7344b7b9-f641-5fed-b0e8-3e2ad93004d5" :answer/type :answer.type/text :answer/value "$(-\\frac{1}{2},1)$ and $(\\frac{1}{2},\\frac{3}{2})$" :db/ensure [:answer/validate]} {:db/id "answer-099e07ff-2aa2-51ce-8ec5-e580916dce57" :answer/id #uuid "099e07ff-2aa2-51ce-8ec5-e580916dce57" :answer/type :answer.type/text :answer/value "$(0,\\frac{1}{2})$ and $(\\frac{1}{2},-\\frac{1}{3})$" :db/ensure [:answer/validate]} {:db/id 17592186124607 :knowledge-point/questions ["question-aab55964-3387-5606-94f7-4fdb235f672a" "question-6269cc62-3112-546a-8502-b50893c81d78"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aab55964-3387-5606-94f7-4fdb235f672a" :question/id #uuid "aab55964-3387-5606-94f7-4fdb235f672a" :question/math-academy-id "q-106586" :question/problem "Find the points that satisfy the mean value theorem for $f(x,y,z)={y}^{2}-{z}^{3}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,0,1⟩$ and $b=⟨1,-1,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={y}^{2}-{z}^{3}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,0,1⟩$ and $b=⟨1,-1,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(1,-1,0)-f(0,0,1) & =∇f(c)\\cdot (⟨1,-1,0⟩-⟨0,0,1⟩) \\\\ 1-(-1) & =∇f(c)\\cdot ⟨1,-1,-1⟩ \\\\ 2 & =∇f(c)\\cdot ⟨1,-1,-1⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨0,2y,-3{z}^{2}⟩ \\\\ ∇f(c) & =⟨0,2{c}_{2},-3{c}_{3}^{2}⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}2 & =∇f(c)\\cdot ⟨1,-1,-1⟩ \\\\ 2 & =⟨0,2{c}_{2},-3{c}_{3}^{2}⟩\\cdot ⟨1,-1,-1⟩ \\\\ 2 & =-2{c}_{2}+3{c}_{3}^{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-0}{1} & =\\frac{y-0}{(-1)}=\\frac{z-1}{(-1)} \\\\ x & =-y=1-z\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=t\\,\\,y=-t,\\,z=1-t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=t\\,\\,{c}_{2}=-t,\\,{c}_{3}=1-t.\n$$\n\nSubstituting the above in the equation $-2{c}_{2}+3{c}_{3}^{2}=2,$ we get\n\n$$\n\\begin{aligned}-2(-t)+3(1-t)^{2} & =2 \\\\ 2t+3{t}^{2}-6t+3 & =2 \\\\ 3{t}^{2}-4t+1 & =0 \\\\ (3t-1)(t-1) & =0 \\\\ t & =\\frac{1}{3},\\,1.\\end{aligned}\n$$\n\nNow we proceed to find the coordinates of the points that satisfy the mean value theorem.\n\n- For $t=\\frac{1}{3},$ we get\n\n$$\n\\begin{aligned}{c}_{1} & =\\frac{1}{3}, \\\\ {c}_{2} & =-\\frac{1}{3}, \\\\ {c}_{3} & =1-\\frac{1}{3}=\\frac{2}{3}.\\end{aligned}\n$$\n\nThus, the coordinates of the first point $C$ are $(\\frac{1}{3},-\\frac{1}{3},\\frac{2}{3}).$\n\n- For $t=1,$ we get\n\n$$\n\\begin{aligned}{c}_{1} & =1, \\\\ {c}_{2} & =-1, \\\\ {c}_{3} & =1-1=0.\\end{aligned}\n$$\n\nThus, the coordinates of the second point $C$ are $(1,-1,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-29f40bfe-790d-5cc9-8bed-56827e2c9958"] :db/ensure [:question/validate]} {:db/id "answer-field-29f40bfe-790d-5cc9-8bed-56827e2c9958" :answer-field/id #uuid "29f40bfe-790d-5cc9-8bed-56827e2c9958" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2bc38ae2-b8b1-599a-9f26-312cb01336da" :answer-field/choices ["answer-fb36eb9a-d973-59d4-9f42-30b5098b0e71" "answer-d011184c-1551-5de6-9144-2a3823d1eda3" "answer-2bc38ae2-b8b1-599a-9f26-312cb01336da" "answer-00c83848-790a-57b8-8602-083229057a71" "answer-61eccc28-259a-5f54-8bb4-fe001dda7b49"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb36eb9a-d973-59d4-9f42-30b5098b0e71" :answer/id #uuid "fb36eb9a-d973-59d4-9f42-30b5098b0e71" :answer/type :answer.type/text :answer/value "$(0,0,1)$  and $(\\frac{1}{4},-\\frac{1}{4},\\frac{3}{4})$" :db/ensure [:answer/validate]} {:db/id "answer-d011184c-1551-5de6-9144-2a3823d1eda3" :answer/id #uuid "d011184c-1551-5de6-9144-2a3823d1eda3" :answer/type :answer.type/text :answer/value "$(0,0,1)$ and $(\\frac{1}{3},-\\frac{1}{3},\\frac{2}{3})$" :db/ensure [:answer/validate]} {:db/id "answer-2bc38ae2-b8b1-599a-9f26-312cb01336da" :answer/id #uuid "2bc38ae2-b8b1-599a-9f26-312cb01336da" :answer/type :answer.type/text :answer/value "$(\\frac{1}{3},-\\frac{1}{3},\\frac{2}{3})$ and $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-00c83848-790a-57b8-8602-083229057a71" :answer/id #uuid "00c83848-790a-57b8-8602-083229057a71" :answer/type :answer.type/text :answer/value "$(\\frac{1}{4},-\\frac{1}{4},\\frac{3}{4})$ and $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-61eccc28-259a-5f54-8bb4-fe001dda7b49" :answer/id #uuid "61eccc28-259a-5f54-8bb4-fe001dda7b49" :answer/type :answer.type/text :answer/value "$(\\frac{2}{3},-\\frac{2}{3},\\frac{1}{3})$ and $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "question-6269cc62-3112-546a-8502-b50893c81d78" :question/id #uuid "6269cc62-3112-546a-8502-b50893c81d78" :question/math-academy-id "q-106587" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y,z)={z}^{2}-{y}^{2}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-2,0,1⟩$ and $b=⟨0,-2,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={z}^{2}-{y}^{2}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-2,0,1⟩$ and $b=⟨0,-2,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(0,-2,0)-f(-2,0,1) & =∇f(c)\\cdot (⟨0,-2,0⟩-⟨-2,0,1⟩) \\\\ -4-1 & =∇f(c)\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =∇f(c)\\cdot ⟨2,-2,-1⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨0,-2y,2z⟩ \\\\ ∇f(c) & =⟨0,-2{c}_{2},2{c}_{3}⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}-5 & =∇f(c)\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =⟨0,-2{c}_{2},2{c}_{3}⟩\\cdot ⟨2,-2,-1⟩ \\\\ -5 & =4{c}_{2}-2{c}_{3}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-(-2)}{2} & =\\frac{y-0}{(-2)}=\\frac{z-1}{(-1)} \\\\ \\frac{x+2}{2} & =-\\frac{y}{2}=1-z\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=2t-2,\\,y=-2t,\\,z=1-t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=2t-2,\\,{c}_{2}=-2t,\\,{c}_{3}=1-t.\n$$\n\nSubstituting the above in the equation $4{c}_{2}-2{c}_{3}=-5,$ we get\n\n$$\n\\begin{aligned}4(-2t)-2(1-t) & =-5 \\\\ -8t-2+2t & =-5 \\\\ -6t & =-3 \\\\ t & =\\frac{1}{2}.\\end{aligned}\n$$\n\nWe can now find the values of ${c}_{1},$ ${c}_{2},$ and ${c}_{3}.$ This gives\n\n$$\n\\begin{aligned}{c}_{1} & =2(\\frac{1}{2})-2=-1, \\\\ {c}_{2} & =-2(\\frac{1}{2})=-1, \\\\ {c}_{3} & =1-(\\frac{1}{2})=\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally, the coordinates of $C$ are $(-1,-1,\\frac{1}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1589433d-cfd2-5a34-998a-3aeb17064001"] :db/ensure [:question/validate]} {:db/id "answer-field-1589433d-cfd2-5a34-998a-3aeb17064001" :answer-field/id #uuid "1589433d-cfd2-5a34-998a-3aeb17064001" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-140b554f-cda0-547b-9903-50ee55410862" :answer-field/choices ["answer-140b554f-cda0-547b-9903-50ee55410862" "answer-6ae0a243-805e-5331-aeaf-9970f13c6bc8" "answer-b219bccd-abfe-5f1e-9522-0fceb1758979" "answer-909b3046-2008-57b1-b5df-b71974be8bd3" "answer-bad99448-6cc8-5829-8b73-b4d8c01e4ab7"] :db/ensure [:answer-field/validate]} {:db/id "answer-140b554f-cda0-547b-9903-50ee55410862" :answer/id #uuid "140b554f-cda0-547b-9903-50ee55410862" :answer/type :answer.type/math :answer/value "(-1,-1,\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-6ae0a243-805e-5331-aeaf-9970f13c6bc8" :answer/id #uuid "6ae0a243-805e-5331-aeaf-9970f13c6bc8" :answer/type :answer.type/math :answer/value "(-1,-\\frac{1}{2},1)" :db/ensure [:answer/validate]} {:db/id "answer-b219bccd-abfe-5f1e-9522-0fceb1758979" :answer/id #uuid "b219bccd-abfe-5f1e-9522-0fceb1758979" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},-\\frac{1}{2},\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-909b3046-2008-57b1-b5df-b71974be8bd3" :answer/id #uuid "909b3046-2008-57b1-b5df-b71974be8bd3" :answer/type :answer.type/math :answer/value "(-\\frac{2}{3},-1,\\frac{1}{4})" :db/ensure [:answer/validate]} {:db/id "answer-bad99448-6cc8-5829-8b73-b4d8c01e4ab7" :answer/id #uuid "bad99448-6cc8-5829-8b73-b4d8c01e4ab7" :answer/type :answer.type/math :answer/value "(0,-2,0)" :db/ensure [:answer/validate]} {:db/id "activity-2919bf66-4175-573b-8a63-c19cdbbc6283" :activity/id #uuid "2919bf66-41