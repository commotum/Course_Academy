96d.png)\n\nThe function $y=f(x)$ is shown above. Which of the following gives the plot of \n$y=f(-x)?$" :question/worked-solution "To obtain the graph of $y=f(-x)$ from $y=f(x)$, we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/22/2244cea90543cc32cb2c5822b5293c7bf8dfadd3d0b55793680152ef0ad04233.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fccc932f-9f6c-5543-9b71-468df31006ca"] :db/ensure [:question/validate]} {:db/id "answer-field-fccc932f-9f6c-5543-9b71-468df31006ca" :answer-field/id #uuid "fccc932f-9f6c-5543-9b71-468df31006ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-123a28e5-2596-5414-b107-e737a6c9809e" :answer-field/choices ["answer-f2d3fcac-273e-5fed-a8fb-af5c0dd0a822" "answer-123a28e5-2596-5414-b107-e737a6c9809e" "answer-81d34127-327b-5935-b521-8e7cbdfc81ac" "answer-df3a02bf-a38f-51f2-afbe-92469956aaef" "answer-282b3e8e-b2ea-5612-81d3-66d069d00206"] :db/ensure [:answer-field/validate]} {:db/id "answer-f2d3fcac-273e-5fed-a8fb-af5c0dd0a822" :answer/id #uuid "f2d3fcac-273e-5fed-a8fb-af5c0dd0a822" :answer/type :answer.type/image :answer/value "images/0a/0aa1f641242fbeea8323672fe04d573681283f50ea200a42f55cc8a6cdc5d605.png" :db/ensure [:answer/validate]} {:db/id "answer-123a28e5-2596-5414-b107-e737a6c9809e" :answer/id #uuid "123a28e5-2596-5414-b107-e737a6c9809e" :answer/type :answer.type/image :answer/value "images/12/1231e74f71e3bf8172629eaae42d529f2a9acda1135745f42a069bfbe16240c5.png" :db/ensure [:answer/validate]} {:db/id "answer-81d34127-327b-5935-b521-8e7cbdfc81ac" :answer/id #uuid "81d34127-327b-5935-b521-8e7cbdfc81ac" :answer/type :answer.type/image :answer/value "images/35/352b02aa03514ee0d5fc5a988ad78efeac32bd850be61bacc6ee7991b5ecae5a.png" :db/ensure [:answer/validate]} {:db/id "answer-df3a02bf-a38f-51f2-afbe-92469956aaef" :answer/id #uuid "df3a02bf-a38f-51f2-afbe-92469956aaef" :answer/type :answer.type/image :answer/value "images/76/76c556f6f364169491ce1caaf3b4a9400ecaa2f5905c6f3feaf12e7ee0e5a1db.png" :db/ensure [:answer/validate]} {:db/id "answer-282b3e8e-b2ea-5612-81d3-66d069d00206" :answer/id #uuid "282b3e8e-b2ea-5612-81d3-66d069d00206" :answer/type :answer.type/image :answer/value "images/83/83ee04eb14ca3ab7e62f12dcc3fffdb7713ad9807476f6c5dd9fa3f5555dfb86.png" :db/ensure [:answer/validate]} {:db/id 17592186115263 :knowledge-point/questions ["question-05fcb668-c7a9-5251-bb06-4685eeabb241"] :db/ensure [:knowledge-point/validate]} {:db/id "question-05fcb668-c7a9-5251-bb06-4685eeabb241" :question/id #uuid "05fcb668-c7a9-5251-bb06-4685eeabb241" :question/math-academy-id "q-26412" :question/problem "The point $Q$ with coordinates $(1,1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" :question/worked-solution "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(1,1)$ lies $1$ unit to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $1$ unit to the *left* from the $y$-axis.\n\n![](images/e3/e39b804eef0617e89d43808793c844f1223a427493e8b6554cc7ad25477f7ddc.png)\n\nWe conclude that the point $(-1,1)$ must lie on the graph of $y=f(-x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-70884a80-03f4-56de-8e4c-1d5cee316b31"] :db/ensure [:question/validate]} {:db/id "answer-field-70884a80-03f4-56de-8e4c-1d5cee316b31" :answer-field/id #uuid "70884a80-03f4-56de-8e4c-1d5cee316b31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f6cb8d7-7aae-5539-8ff7-d15820c1d709" :answer-field/choices ["answer-446f5e6f-db8f-5475-8726-ca18e6b7a9b2" "answer-8f6cb8d7-7aae-5539-8ff7-d15820c1d709" "answer-bbe4a972-90eb-5f47-b61f-d94a3c696e0d" "answer-4f20dcdd-e642-5844-8b02-166600b6c2e1" "answer-493f0ae7-cc01-57fc-91ef-cb782b6b7670"] :db/ensure [:answer-field/validate]} {:db/id "answer-446f5e6f-db8f-5475-8726-ca18e6b7a9b2" :answer/id #uuid "446f5e6f-db8f-5475-8726-ca18e6b7a9b2" :answer/type :answer.type/math :answer/value "(-1,-1)" :db/ensure [:answer/validate]} {:db/id "answer-8f6cb8d7-7aae-5539-8ff7-d15820c1d709" :answer/id #uuid "8f6cb8d7-7aae-5539-8ff7-d15820c1d709" :answer/type :answer.type/math :answer/value "(-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-bbe4a972-90eb-5f47-b61f-d94a3c696e0d" :answer/id #uuid "bbe4a972-90eb-5f47-b61f-d94a3c696e0d" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "answer-4f20dcdd-e642-5844-8b02-166600b6c2e1" :answer/id #uuid "4f20dcdd-e642-5844-8b02-166600b6c2e1" :answer/type :answer.type/math :answer/value "(1,-1)" :db/ensure [:answer/validate]} {:db/id "answer-493f0ae7-cc01-57fc-91ef-cb782b6b7670" :answer/id #uuid "493f0ae7-cc01-57fc-91ef-cb782b6b7670" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "activity-01a2564a-f932-5a36-9d89-4ac6479831eb" :activity/id #uuid "01a2564a-f932-5a36-9d89-4ac6479831eb" :activity/title "Horizontal Reflections of Functions" :activity/type :activity.type/review :activity/scope 17592186050962 :activity/course 17592186046647 :activity/steps ["step-6014bf00-07df-5354-80e9-91c551852bff" "step-94af425b-308d-557b-8c6a-3d7f9c20fed6" "step-1ff7f28d-3d91-572a-a913-cca7dbe41b38"] :activity/first-step "step-6014bf00-07df-5354-80e9-91c551852bff" :db/ensure [:activity/validate]} {:db/id "step-6014bf00-07df-5354-80e9-91c551852bff" :step/id #uuid "6014bf00-07df-5354-80e9-91c551852bff" :step/content "question-96a48954-07a7-579b-872e-b1d2125e9254" :step/next "step-94af425b-308d-557b-8c6a-3d7f9c20fed6" :db/ensure [:step/validate]} {:db/id "step-94af425b-308d-557b-8c6a-3d7f9c20fed6" :step/id #uuid "94af425b-308d-557b-8c6a-3d7f9c20fed6" :step/content "question-ba83d0b6-1647-529e-aacc-1339b989f887" :step/next "step-1ff7f28d-3d91-572a-a913-cca7dbe41b38" :db/ensure [:step/validate]} {:db/id "step-1ff7f28d-3d91-572a-a913-cca7dbe41b38" :step/id #uuid "1ff7f28d-3d91-572a-a913-cca7dbe41b38" :step/content "question-05fcb668-c7a9-5251-bb06-4685eeabb241" :db/ensure [:step/validate]} {:db/id 17592186129145 :knowledge-point/questions ["question-8f422c3e-86d1-54ac-8460-f66bdadcbf77"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8f422c3e-86d1-54ac-8460-f66bdadcbf77" :question/id #uuid "8f422c3e-86d1-54ac-8460-f66bdadcbf77" :question/math-academy-id "q-38766" :question/problem "![](images/92/9263d7e8f4e23d1713234db1fb92d0ba48aeeb723b3085e72c5932aff7239790.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely two distinct roots, $x=-1,$ and $x=3.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph just touches the $x$-axis and reverses direction at $x=-1,$ this root has even multiplicity.\n\n- Since the graph passes through $x=3,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=3,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y=\\frac{1}{9}(x+1)^{2}(x-3)^{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2ba9f72b-e89c-5805-b07f-6b4475a07e83"] :db/ensure [:question/validate]} {:db/id "answer-field-2ba9f72b-e89c-5805-b07f-6b4475a07e83" :answer-field/id #uuid "2ba9f72b-e89c-5805-b07f-6b4475a07e83" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc7e7c1b-a02d-5475-921c-16202d65baa5" :answer-field/choices ["answer-bb97bf22-330e-53ac-a29c-edfed6b0497b" "answer-8fce1628-d8e0-5281-b8ed-e11ff1078647" "answer-76bf41af-9ab4-574b-8dd0-f707aa39bbcf" "answer-71387c0f-e6a7-5b6e-9830-dfc20f995ae8" "answer-bc7e7c1b-a02d-5475-921c-16202d65baa5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb97bf22-330e-53ac-a29c-edfed6b0497b" :answer/id #uuid "bb97bf22-330e-53ac-a29c-edfed6b0497b" :answer/type :answer.type/math :answer/value "y=(x+1)(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8fce1628-d8e0-5281-b8ed-e11ff1078647" :answer/id #uuid "8fce1628-d8e0-5281-b8ed-e11ff1078647" :answer/type :answer.type/math :answer/value "y=(x+1)^{3}(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-76bf41af-9ab4-574b-8dd0-f707aa39bbcf" :answer/id #uuid "76bf41af-9ab4-574b-8dd0-f707aa39bbcf" :answer/type :answer.type/math :answer/value "y=(x+1)^{4}(x-3)" :db/ensure [:answer/validate]} {:db/id "answer-71387c0f-e6a7-5b6e-9830-dfc20f995ae8" :answer/id #uuid "71387c0f-e6a7-5b6e-9830-dfc20f995ae8" :answer/type :answer.type/math :answer/value "y=\\frac{1}{3}(x+1)^{2}(x-3)" :db/ensure [:answer/validate]} {:db/id "answer-bc7e7c1b-a02d-5475-921c-16202d65baa5" :answer/id #uuid "bc7e7c1b-a02d-5475-921c-16202d65baa5" :answer/type :answer.type/math :answer/value "y=\\frac{1}{9}(x+1)^{2}(x-3)^{3}" :db/ensure [:answer/validate]} {:db/id "activity-a1366fcc-47d7-51a2-a862-4ff17c7553b7" :activity/id #uuid "a1366fcc-47d7-51a2-a862-4ff17c7553b7" :activity/title "Graphing General Polynomials" :activity/type :activity.type/review :activity/scope 17592186050601 :activity/course 17592186046647 :activity/steps ["step-93468536-e912-5d59-af9e-1d96c93b2485" "step-673d9b83-3ff3-5843-9dcb-506dafb7b36d" "step-60068a08-fa3f-50ca-8965-30a471415f04"] :activity/first-step "step-93468536-e912-5d59-af9e-1d96c93b2485" :db/ensure [:activity/validate]} {:db/id "step-93468536-e912-5d59-af9e-1d96c93b2485" :step/id #uuid "93468536-e912-5d59-af9e-1d96c93b2485" :step/content 17592186326705 :step/next "step-673d9b83-3ff3-5843-9dcb-506dafb7b36d" :db/ensure [:step/validate]} {:db/id "step-673d9b83-3ff3-5843-9dcb-506dafb7b36d" :step/id #uuid "673d9b83-3ff3-5843-9dcb-506dafb7b36d" :step/content 17592186326706 :step/next "step-60068a08-fa3f-50ca-8965-30a471415f04" :db/ensure [:step/validate]} {:db/id "step-60068a08-fa3f-50ca-8965-30a471415f04" :step/id #uuid "60068a08-fa3f-50ca-8965-30a471415f04" :step/content "question-8f422c3e-86d1-54ac-8460-f66bdadcbf77" :db/ensure [:step/validate]} {:db/id 17592186133813 :knowledge-point/questions ["question-955d6eb2-9fbf-5873-9d9e-5edc1cabeb28" "question-61c2f333-f089-53c4-9125-104e2258d303"] :db/ensure [:knowledge-point/validate]} {:db/id "question-955d6eb2-9fbf-5873-9d9e-5edc1cabeb28" :question/id #uuid "955d6eb2-9fbf-5873-9d9e-5edc1cabeb28" :question/math-academy-id "q-39201" :question/problem "If $u=\\begin{bmatrix}2 \\\\ -1 \\\\ -3 \\\\ 5\\end{bmatrix}\\,,$ $v=\\begin{bmatrix}2 \\\\ -4 \\\\ -3 \\\\ 1\\end{bmatrix}\\,,$ and $u\\cdot v=22,$ then $\\frac{(3u)\\cdot v}{u\\cdot (2u)}=$" :question/worked-solution "We will use the fact that the dot product is linear.\n\nTo quickly compute the numerator $3u\\cdot v,$ we multiply $u\\cdot v$ by $3.$ Doing this, we get\n\n$$\n\\begin{aligned}(3u)\\cdot v & =3(u\\cdot v) \\\\  & =3\\cdot 22 \\\\  & =66.\\end{aligned}\n$$\n\nTo quickly compute the denominator $u\\cdot (2u),$ we compute $u\\cdot u$ first and then multiply the result by $2.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot (2u) & =2(u\\cdot u) \\\\  & =2({u}_{1}^{2}+{u}_{2}^{2}+{u}_{3}^{2}+{u}_{4}^{2}) \\\\  & =2({2}^{2}+(-1)^{2}+(-3)^{2}+{5}^{2}) \\\\  & =2(4+1+9+25) \\\\  & =2\\cdot 39 \\\\  & =78.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{(3u)\\cdot v}{u\\cdot (2u)}=\\frac{66}{78}=\\frac{11}{13}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5bf3387a-a036-5d98-81f1-318396ac1845"] :db/ensure [:question/validate]} {:db/id "answer-field-5bf3387a-a036-5d98-81f1-318396ac1845" :answer-field/id #uuid "5bf3387a-a036-5d98-81f1-318396ac1845" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7c0fb46-4c53-5f39-8235-7070192b77ff" :answer-field/choices ["answer-a7c0fb46-4c53-5f39-8235-7070192b77ff" "answer-cac76ba4-017f-5e57-8edb-6869b8b020aa" "answer-bb1c0734-9ff2-5360-9a7c-45a81e9c5de1" "answer-2c1e4807-a090-51b6-b8a5-0ed1a73a6532" "answer-9ba6f34d-ea9c-55cd-ac5e-4ff8b3862bad"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7c0fb46-4c53-5f39-8235-7070192b77ff" :answer/id #uuid "a7c0fb46-4c53-5f39-8235-7070192b77ff" :answer/type :answer.type/math :answer/value "\\frac{11}{13}" :db/ensure [:answer/validate]} {:db/id "answer-cac76ba4-017f-5e57-8edb-6869b8b020aa" :answer/id #uuid "cac76ba4-017f-5e57-8edb-6869b8b020aa" :answer/type :answer.type/math :answer/value "\\frac{13}{38}" :db/ensure [:answer/validate]} {:db/id "answer-bb1c0734-9ff2-5360-9a7c-45a81e9c5de1" :answer/id #uuid "bb1c0734-9ff2-5360-9a7c-45a81e9c5de1" :answer/type :answer.type/math :answer/value "\\frac{19}{21}" :db/ensure [:answer/validate]} {:db/id "answer-2c1e4807-a090-51b6-b8a5-0ed1a73a6532" :answer/id #uuid "2c1e4807-a090-51b6-b8a5-0ed1a73a6532" :answer/type :answer.type/math :answer/value "\\frac{20}{17}" :db/ensure [:answer/validate]} {:db/id "answer-9ba6f34d-ea9c-55cd-ac5e-4ff8b3862bad" :answer/id #uuid "9ba6f34d-ea9c-55cd-ac5e-4ff8b3862bad" :answer/type :answer.type/math :answer/value "\\frac{39}{23}" :db/ensure [:answer/validate]} {:db/id "question-61c2f333-f089-53c4-9125-104e2258d303" :question/id #uuid "61c2f333-f089-53c4-9125-104e2258d303" :question/math-academy-id "q-74038" :question/problem "If $u=\\begin{bmatrix}-1 \\\\ 2 \\\\ 1 \\\\ -2 \\\\ -1\\end{bmatrix}\\,,$ $v=\\begin{bmatrix}2 \\\\ -3 \\\\ 2 \\\\ -3 \\\\ 2\\end{bmatrix}\\,,$ and $u\\cdot v=-2,$ then $\\frac{u\\cdot (10v)}{u\\cdot (4u)}=$" :question/worked-solution "We will use the fact that the dot product is linear.\n\nTo quickly compute the numerator $u\\cdot (10v),$ we multiply $u\\cdot v$ by $10.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot (10v) & =10(u\\cdot v) \\\\  & =10\\cdot (-2) \\\\  & =-20.\\end{aligned}\n$$\n\nTo quickly compute the denominator $u\\cdot (4u),$ we compute $u\\cdot u$ first and then multiply the result by $4.$ Doing this, we get\n\n$$\n\\begin{aligned}u\\cdot (4u) & =4(u\\cdot u) \\\\  & =4({u}_{1}^{2}+{u}_{2}^{2}+{u}_{3}^{2}+{u}_{4}^{2}) \\\\  & =4((-1)^{2}+{2}^{2}+{1}^{2}+(-2)^{2}+(-1)^{2}) \\\\  & =4(1+4+1+4+1) \\\\  & =4\\cdot 11 \\\\  & =44.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{u\\cdot (10v)}{u\\cdot (4u)}=\\frac{-20}{44}=-\\frac{5}{11}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ea8e249e-3dee-5215-9e54-0f6bd4c6007a"] :db/ensure [:question/validate]} {:db/id "answer-field-ea8e249e-3dee-5215-9e54-0f6bd4c6007a" :answer-field/id #uuid "ea8e249e-3dee-5215-9e54-0f6bd4c6007a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-380840fb-2296-517d-ad92-c6d825c59d64" :answer-field/choices ["answer-54efae19-05c8-5b57-963e-300afde1484a" "answer-71ea6c44-df5f-5252-9451-daec1e4b3af2" "answer-380840fb-2296-517d-ad92-c6d825c59d64" "answer-83f122af-a146-53a7-835c-5b286f8e1460" "answer-e938bc27-9cfe-54d8-86d0-a5645cd5bfdb"] :db/ensure [:answer-field/validate]} {:db/id "answer-54efae19-05c8-5b57-963e-300afde1484a" :answer/id #uuid "54efae19-05c8-5b57-963e-300afde1484a" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-71ea6c44-df5f-5252-9451-daec1e4b3af2" :answer/id #uuid "71ea6c44-df5f-5252-9451-daec1e4b3af2" :answer/type :answer.type/math :answer/value "-\\frac{10}{11}" :db/ensure [:answer/validate]} {:db/id "answer-380840fb-2296-517d-ad92-c6d825c59d64" :answer/id #uuid "380840fb-2296-517d-ad92-c6d825c59d64" :answer/type :answer.type/math :answer/value "-\\frac{5}{11}" :db/ensure [:answer/validate]} {:db/id "answer-83f122af-a146-53a7-835c-5b286f8e1460" :answer/id #uuid "83f122af-a146-53a7-835c-5b286f8e1460" :answer/type :answer.type/math :answer/value "-\\frac{5}{22}" :db/ensure [:answer/validate]} {:db/id "answer-e938bc27-9cfe-54d8-86d0-a5645cd5bfdb" :answer/id #uuid "e938bc27-9cfe-54d8-86d0-a5645cd5bfdb" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id 17592186134197 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186133757 :knowledge-point/questions ["question-64386ab8-01dd-5ca3-af09-05de11ca4efa" "question-5a4c9f12-f1ec-53fb-81d9-ded6a93d72ba" "question-ebc01d60-f520-5118-a5cd-4a61bccfbcb3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-64386ab8-01dd-5ca3-af09-05de11ca4efa" :question/id #uuid "64386ab8-01dd-5ca3-af09-05de11ca4efa" :question/math-academy-id "q-40114" :question/problem "If $\\alpha \\beta =12$ and $a\\cdot b=4$, then what is $(\\alpha b)\\cdot (\\beta a)-21?$" :question/worked-solution "Using the fact that the dot product is linear in both variables, we get\n\n$$\n\\begin{aligned}(\\alpha b)\\cdot (\\beta a)-21 & =\\alpha (b\\cdot \\beta a)-21 \\\\  & =\\alpha \\beta (b\\cdot a)-21.\\end{aligned}\n$$\n\nNext, using that the dot product is symmetric, we obtain\n\n$$\n\\begin{aligned}\\alpha \\beta (b\\cdot a)-21 & =\\alpha \\beta (a\\cdot b)-21.\\end{aligned}\n$$\n\nFinally, we substitute the values for $\\alpha \\beta$ and $a\\cdot b:$\n\n$$\n\\begin{aligned}\\alpha \\beta (a\\cdot b)-21 & =12\\cdot (4)-21 \\\\  & =48-21 \\\\  & =27\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c86deb60-271b-56a0-b579-07d9a6af8966"] :db/ensure [:question/validate]} {:db/id "answer-field-c86deb60-271b-56a0-b579-07d9a6af8966" :answer-field/id #uuid "c86deb60-271b-56a0-b579-07d9a6af8966" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7be4d76-3b4f-5c13-acc0-14a057882597" :answer-field/choices ["answer-7e617142-bdf7-5c0b-95cf-0477f897470a" "answer-fe9bc857-346c-500f-b144-1a055df9866b" "answer-03c5dd2d-fff5-5991-b111-3e6faa486a85" "answer-a7be4d76-3b4f-5c13-acc0-14a057882597" "answer-7cadc3ff-14b7-5d0c-a857-04adb0277a4d"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e617142-bdf7-5c0b-95cf-0477f897470a" :answer/id #uuid "7e617142-bdf7-5c0b-95cf-0477f897470a" :answer/type :answer.type/math :answer/value "-123" :db/ensure [:answer/validate]} {:db/id "answer-fe9bc857-346c-500f-b144-1a055df9866b" :answer/id #uuid "fe9bc857-346c-500f-b144-1a055df9866b" :answer/type :answer.type/math :answer/value "-26" :db/ensure [:answer/validate]} {:db/id "answer-03c5dd2d-fff5-5991-b111-3e6faa486a85" :answer/id #uuid "03c5dd2d-fff5-5991-b111-3e6faa486a85" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-a7be4d76-3b4f-5c13-acc0-14a057882597" :answer/id #uuid "a7be4d76-3b4f-5c13-acc0-14a057882597" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-7cadc3ff-14b7-5d0c-a857-04adb0277a4d" :answer/id #uuid "7cadc3ff-14b7-5d0c-a857-04adb0277a4d" :answer/type :answer.type/math :answer/value "69" :db/ensure [:answer/validate]} {:db/id "question-5a4c9f12-f1ec-53fb-81d9-ded6a93d72ba" :question/id #uuid "5a4c9f12-f1ec-53fb-81d9-ded6a93d72ba" :question/math-academy-id "q-40121" :question/problem "Suppose ${b}_{2}=k{b}_{1}-a$ and ${b}_{1}\\cdot {b}_{2}=0.$ If $a=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ and ${b}_{1}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}$, find the value of $k.$ \n\n*Hint: You might wish to take the equation ${b}_{2}=k{b}_{1}-a$ and find the dot product of both sides with ${b}_{1}.$*" :question/worked-solution "First, we take the equation ${b}_{2}=k{b}_{1}-a$ and find the dot product of both sides with ${b}_{1}$, as follows:\n\n$$\n\\begin{aligned}{b}_{2} & =k{b}_{1}-a \\\\ {b}_{1}\\cdot {b}_{2} & ={b}_{1}\\cdot (k{b}_{1}-a) \\\\ {b}_{1}\\cdot {b}_{2} & ={b}_{1}\\cdot (k{b}_{1})-({b}_{1}\\cdot a) \\\\ {b}_{1}\\cdot {b}_{2} & =k({b}_{1}\\cdot {b}_{1})-({b}_{1}\\cdot a)\\end{aligned}\n$$\n\nThen, we use the formula for the dot product to compute the values of ${b}_{1}\\cdot {b}_{1}$ and ${b}_{1}\\cdot a:$\n\n$$\n\\begin{aligned}{b}_{1}\\cdot {b}_{1} & ={b}_{1}^{2}+{b}_{2}^{2} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4 \\\\ {b}_{1}\\cdot a & ={b}_{1}{a}_{1}+{b}_{2}{a}_{2} \\\\  & =2\\cdot 1+0\\cdot (-1) \\\\  & =2.\\end{aligned}\n$$\n\nFinally, substituting the values for ${b}_{1}\\cdot {b}_{1},$ ${b}_{1}\\cdot a,$ and ${b}_{1}\\cdot {b}_{2},$ we get\n\n$$\n\\begin{aligned}{b}_{1}\\cdot {b}_{2} & =k({b}_{1}\\cdot {b}_{1})-({b}_{1}\\cdot a) \\\\ 0 & =k\\cdot 4-2 \\\\ -4k & =-2 \\\\ k & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-05042bcd-7408-5162-a150-fc8ad84cb0bf"] :db/ensure [:question/validate]} {:db/id "answer-field-05042bcd-7408-5162-a150-fc8ad84cb0bf" :answer-field/id #uuid "05042bcd-7408-5162-a150-fc8ad84cb0bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01b2add6-2c67-53b2-8c90-f94f33352bd2" :answer-field/choices ["answer-588d46c7-6540-5faa-af52-4cc4aba10d7e" "answer-fac7fb28-675a-5240-a386-a6c076509e51" "answer-5b99a9cb-3ede-545e-b81d-553fa9eb7060" "answer-2e0d5123-afe9-526f-8c30-e9359cc8929b" "answer-01b2add6-2c67-53b2-8c90-f94f33352bd2"] :db/ensure [:answer-field/validate]} {:db/id "answer-588d46c7-6540-5faa-af52-4cc4aba10d7e" :answer/id #uuid "588d46c7-6540-5faa-af52-4cc4aba10d7e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-fac7fb28-675a-5240-a386-a6c076509e51" :answer/id #uuid "fac7fb28-675a-5240-a386-a6c076509e51" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-5b99a9cb-3ede-545e-b81d-553fa9eb7060" :answer/id #uuid "5b99a9cb-3ede-545e-b81d-553fa9eb7060" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2e0d5123-afe9-526f-8c30-e9359cc8929b" :answer/id #uuid "2e0d5123-afe9-526f-8c30-e9359cc8929b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-01b2add6-2c67-53b2-8c90-f94f33352bd2" :answer/id #uuid "01b2add6-2c67-53b2-8c90-f94f33352bd2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-ebc01d60-f520-5118-a5cd-4a61bccfbcb3" :question/id #uuid "ebc01d60-f520-5118-a5cd-4a61bccfbcb3" :question/math-academy-id "q-40051" :question/problem "Suppose ${b}_{2}=p{b}_{1}+a$ and ${b}_{1}\\cdot {b}_{2}=0.$ If $a=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$ and ${b}_{1}=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}$, find the value of $p.$ \n\n*Hint: You might wish to take the equation ${b}_{2}=p{b}_{1}+a$ and find the dot product of both sides with ${b}_{1}.$*" :question/worked-solution "First, we take the equation ${b}_{2}=p{b}_{1}+a$ and find the dot product of both sides with ${b}_{1}$, as follows:\n\n$$\n\\begin{aligned}{b}_{2} & =p{b}_{1}+a \\\\ {b}_{1}\\cdot {b}_{2} & ={b}_{1}\\cdot (p{b}_{1}+a) \\\\ {b}_{1}\\cdot {b}_{2} & ={b}_{1}\\cdot (p{b}_{1})+({b}_{1}\\cdot a) \\\\ {b}_{1}\\cdot {b}_{2} & =p({b}_{1}\\cdot {b}_{1})+({b}_{1}\\cdot a)\\end{aligned}\n$$\n\nThen, we use the formula for the dot product to compute the values of ${b}_{1}\\cdot {b}_{1}$ and ${b}_{1}\\cdot a:$\n\n$$\n\\begin{aligned}{b}_{1}\\cdot {b}_{1} & ={b}_{1}^{2}+{b}_{2}^{2} \\\\  & ={2}^{2}+(-3)^{2} \\\\  & =4+9 \\\\  & =13 \\\\ {b}_{1}\\cdot a & ={b}_{1}{a}_{1}+{b}_{2}{a}_{2} \\\\  & =2\\cdot 2+(-3)\\cdot (-1) \\\\  & =4+3 \\\\  & =7\\end{aligned}\n$$\n\nFinally, substituting the values for ${b}_{1}\\cdot {b}_{1},$ ${b}_{1}\\cdot a,$ and ${b}_{1}\\cdot {b}_{2},$ we get\n\n$$\n\\begin{aligned}{b}_{1}\\cdot {b}_{2} & =p({b}_{1}\\cdot {b}_{1})+({b}_{1}\\cdot a) \\\\ 0 & =p\\cdot 13+7 \\\\ -13p & =7 \\\\ p & =-\\frac{7}{13}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-442c71b0-f1e1-596b-a7c5-af88038d1f0b"] :db/ensure [:question/validate]} {:db/id "answer-field-442c71b0-f1e1-596b-a7c5-af88038d1f0b" :answer-field/id #uuid "442c71b0-f1e1-596b-a7c5-af88038d1f0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a3b1762-1f3b-5c50-bdd6-fd9a76ca82e5" :answer-field/choices ["answer-2bc45b67-7aab-542f-93de-d964f0d1ff29" "answer-9a3b1762-1f3b-5c50-bdd6-fd9a76ca82e5" "answer-20e89a4c-5fb7-5f90-9b49-1d353949f7db" "answer-8677ef66-ef3c-5e2c-a8ae-ea47b6b8232d" "answer-52f9c109-ae8a-59e7-8c53-96071e29be14"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bc45b67-7aab-542f-93de-d964f0d1ff29" :answer/id #uuid "2bc45b67-7aab-542f-93de-d964f0d1ff29" :answer/type :answer.type/math :answer/value "-\\frac{13}{7}" :db/ensure [:answer/validate]} {:db/id "answer-9a3b1762-1f3b-5c50-bdd6-fd9a76ca82e5" :answer/id #uuid "9a3b1762-1f3b-5c50-bdd6-fd9a76ca82e5" :answer/type :answer.type/math :answer/value "-\\frac{7}{13}" :db/ensure [:answer/validate]} {:db/id "answer-20e89a4c-5fb7-5f90-9b49-1d353949f7db" :answer/id #uuid "20e89a4c-5fb7-5f90-9b49-1d353949f7db" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8677ef66-ef3c-5e2c-a8ae-ea47b6b8232d" :answer/id #uuid "8677ef66-ef3c-5e2c-a8ae-ea47b6b8232d" :answer/type :answer.type/math :answer/value "\\frac{13}{7}" :db/ensure [:answer/validate]} {:db/id "answer-52f9c109-ae8a-59e7-8c53-96071e29be14" :answer/id #uuid "52f9c109-ae8a-59e7-8c53-96071e29be14" :answer/type :answer.type/math :answer/value "\\frac{5}{13}" :db/ensure [:answer/validate]} {:db/id 17592186133758 :knowledge-point/questions ["question-02eb1a38-d05c-54e9-9813-73779e1c0487" "question-d0f13f7c-58e9-5582-87a9-733c8480e4b2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-02eb1a38-d05c-54e9-9813-73779e1c0487" :question/id #uuid "02eb1a38-d05c-54e9-9813-73779e1c0487" :question/math-academy-id "q-40050" :question/problem "Suppose $(8a+2b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true?\n\nI. $b\\cdot a=4(a\\cdot a)$\n\nII. $-a\\cdot a<0$\n\nIII. $b\\cdot a=4$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. Simplifying the expression $(8a+2b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(8a+2b)\\cdot a & =0 \\\\ (8a)\\cdot a+(2b)\\cdot a & =0 \\\\ 8(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 2(b\\cdot a) & =-8(a\\cdot a) \\\\ b\\cdot a & =-4(a\\cdot a)\\end{aligned}\n$$\n\n- Statement II is true. Since $a\\ne 0,$ we must have $a\\cdot a>0$, which implies $-a\\cdot a<0.$\n\n- Statement III is false since it leads to a contradiction. If $b\\cdot a=4$, we get\n\n$$\n\\begin{aligned}(8a+2b)\\cdot a & =0 \\\\ 8(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 8(a\\cdot a)+2(4) & =0 \\\\ a\\cdot a & =-1,\\end{aligned}\n$$\n\nbut this is a contradiction since $a\\ne 0$ implies that $a\\cdot a>0.$\n\nTherefore, we conclude that the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9b8314bc-1ca0-55b2-b63e-52c99907cd1e"] :db/ensure [:question/validate]} {:db/id "answer-field-9b8314bc-1ca0-55b2-b63e-52c99907cd1e" :answer-field/id #uuid "9b8314bc-1ca0-55b2-b63e-52c99907cd1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a1584f84-f877-5de9-9302-da994b87ba25" :answer-field/choices ["answer-1f7cb973-f85c-5e6b-8dae-6a8ad95726f6" "answer-31e67c9f-c8c0-5b64-be70-6a0f3503ae5f" "answer-f67b9fe9-2313-58df-9ac7-22477599208d" "answer-a1584f84-f877-5de9-9302-da994b87ba25" "answer-d73bfa84-e3d5-5e2c-8d3f-8a839c69c8b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f7cb973-f85c-5e6b-8dae-6a8ad95726f6" :answer/id #uuid "1f7cb973-f85c-5e6b-8dae-6a8ad95726f6" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-31e67c9f-c8c0-5b64-be70-6a0f3503ae5f" :answer/id #uuid "31e67c9f-c8c0-5b64-be70-6a0f3503ae5f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f67b9fe9-2313-58df-9ac7-22477599208d" :answer/id #uuid "f67b9fe9-2313-58df-9ac7-22477599208d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-a1584f84-f877-5de9-9302-da994b87ba25" :answer/id #uuid "a1584f84-f877-5de9-9302-da994b87ba25" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-d73bfa84-e3d5-5e2c-8d3f-8a839c69c8b2" :answer/id #uuid "d73bfa84-e3d5-5e2c-8d3f-8a839c69c8b2" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-d0f13f7c-58e9-5582-87a9-733c8480e4b2" :question/id #uuid "d0f13f7c-58e9-5582-87a9-733c8480e4b2" :question/math-academy-id "q-74050" :question/problem "Suppose $(a+b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nI. $b\\cdot a<0$\n\nII. $b\\cdot a=3$\n\nIII. $a\\cdot a=-3$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true while statement II is false. Simplifying the expression $(a+b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(a+b)\\cdot a & =0 \\\\ a\\cdot a+b\\cdot a & =0 \\\\ b\\cdot a & =-a\\cdot a\\end{aligned}\n$$\n\n \nSince $a\\ne 0$ implies that $a\\cdot a>0$, we obtain that $-a\\cdot a<0.$\n\n- Statement III is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\nTherefore, we conclude that the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-415ea050-0cd5-5d54-b8f3-6177bceb1f0d"] :db/ensure [:question/validate]} {:db/id "answer-field-415ea050-0cd5-5d54-b8f3-6177bceb1f0d" :answer-field/id #uuid "415ea050-0cd5-5d54-b8f3-6177bceb1f0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-66cc3909-10ef-593c-8821-e7238b004d27" :answer-field/choices ["answer-7699f0ee-def5-536a-a004-b4578f68883e" "answer-9d62eb9a-b60d-5fcb-8454-b577309849b7" "answer-66cc3909-10ef-593c-8821-e7238b004d27" "answer-43183136-6c70-5fb6-9cb4-2acf917b14f4" "answer-b16177cb-e181-5c27-9326-