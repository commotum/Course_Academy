ges/a0/a051a9158e8147415b605fee37aef3ef4862281da1c2a0387fd40aa99bddee49.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=20\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{20}^{2}+{25}^{2}} \\\\  & =\\sqrt{1\\,025} \\\\  & =5\\sqrt{41}\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c48d75c9-8417-5647-a9f6-2a5523919321"] :db/ensure [:question/validate]} {:db/id "answer-field-c48d75c9-8417-5647-a9f6-2a5523919321" :answer-field/id #uuid "c48d75c9-8417-5647-a9f6-2a5523919321" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1206f0b9-be3a-5159-98e0-da77b6c0445a" :answer-field/choices ["answer-432d23e6-e40e-5e8a-a566-7d880e136d59" "answer-e3afd05d-c063-5ddb-abee-56e9a09c27ed" "answer-5d0fa895-1079-53e7-945b-0a3924af1dff" "answer-2ecb5427-5ac5-59b1-94a2-f82f393f874e" "answer-1206f0b9-be3a-5159-98e0-da77b6c0445a"] :db/ensure [:answer-field/validate]} {:db/id "answer-432d23e6-e40e-5e8a-a566-7d880e136d59" :answer/id #uuid "432d23e6-e40e-5e8a-a566-7d880e136d59" :answer/type :answer.type/math :answer/value "20\\sqrt{2}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-e3afd05d-c063-5ddb-abee-56e9a09c27ed" :answer/id #uuid "e3afd05d-c063-5ddb-abee-56e9a09c27ed" :answer/type :answer.type/math :answer/value "25\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-5d0fa895-1079-53e7-945b-0a3924af1dff" :answer/id #uuid "5d0fa895-1079-53e7-945b-0a3924af1dff" :answer/type :answer.type/math :answer/value "40\\sqrt{2}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-2ecb5427-5ac5-59b1-94a2-f82f393f874e" :answer/id #uuid "2ecb5427-5ac5-59b1-94a2-f82f393f874e" :answer/type :answer.type/math :answer/value "4\\sqrt{13}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-1206f0b9-be3a-5159-98e0-da77b6c0445a" :answer/id #uuid "1206f0b9-be3a-5159-98e0-da77b6c0445a" :answer/type :answer.type/math :answer/value "5\\sqrt{41}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "question-6aaad334-a3c0-5643-a528-243af5b47439" :question/id #uuid "6aaad334-a3c0-5643-a528-243af5b47439" :question/math-academy-id "q-118915" :question/problem "![](images/de/de4864b00e5b51431ef019a930c3980e33c0f47812c9ee09743934128a72644b.png)\n\nConsider the picture shown above. Find $|a|.$" :question/worked-solution "![](images/ab/ab521b7fc8b594fa7a8a97cf1b2dc57884d50d7941f0e6f7f6d56d3179d3c7a3.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=25\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{25}^{2}+{25}^{2}} \\\\  & =\\sqrt{2\\cdot {25}^{2}} \\\\  & =25\\sqrt{2}\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-87ff2314-8fb7-54d5-87c5-d6b7e1e45b40"] :db/ensure [:question/validate]} {:db/id "answer-field-87ff2314-8fb7-54d5-87c5-d6b7e1e45b40" :answer-field/id #uuid "87ff2314-8fb7-54d5-87c5-d6b7e1e45b40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b095cbfc-1472-52b1-804b-05c032bb0e53" :answer-field/choices ["answer-bcd0818b-9462-55a1-9ed5-46fc015e79ca" "answer-b095cbfc-1472-52b1-804b-05c032bb0e53" "answer-ba28057b-647d-5124-b1a6-35e530999312" "answer-6bcce013-cdbc-58c4-a357-a196757423be" "answer-04492ea7-d25b-56ea-ae0e-47957b737f4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-bcd0818b-9462-55a1-9ed5-46fc015e79ca" :answer/id #uuid "bcd0818b-9462-55a1-9ed5-46fc015e79ca" :answer/type :answer.type/math :answer/value "25\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-b095cbfc-1472-52b1-804b-05c032bb0e53" :answer/id #uuid "b095cbfc-1472-52b1-804b-05c032bb0e53" :answer/type :answer.type/math :answer/value "25\\sqrt{2}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-ba28057b-647d-5124-b1a6-35e530999312" :answer/id #uuid "ba28057b-647d-5124-b1a6-35e530999312" :answer/type :answer.type/math :answer/value "2\\sqrt{25}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-6bcce013-cdbc-58c4-a357-a196757423be" :answer/id #uuid "6bcce013-cdbc-58c4-a357-a196757423be" :answer/type :answer.type/math :answer/value "5\\sqrt{10}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-04492ea7-d25b-56ea-ae0e-47957b737f4b" :answer/id #uuid "04492ea7-d25b-56ea-ae0e-47957b737f4b" :answer/type :answer.type/math :answer/value "5\\sqrt{2}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "question-009a4381-6aca-5a6f-b010-2dbc7da60371" :question/id #uuid "009a4381-6aca-5a6f-b010-2dbc7da60371" :question/math-academy-id "q-118921" :question/problem "![](images/7b/7b676396ae24fe47c832e4442b67a9ba66128eff11a8c08f7570704c0a16eeb7.png)\n\nConsider the picture shown above. Find $|a+b|.$" :question/worked-solution "We use the triangle law of addition for $a$ and $b.$ We can start $a$ from an arbitrary point on the plane. The resultant goes from the start of $a$ to the head of $b.$\n\n![](images/87/87a40729c97eddcba2820dc083002aad9ee4d05d7e9e654bcf51d8410a2e4861.png)\n\nNow, in $△AHB$ we have $∠AHB={90}^{∘}$, $AH=30\\,\\text{mm}$ and $BH=20\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|a+b| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{30}^{2}+{20}^{2}} \\\\  & =\\sqrt{1\\,300} \\\\  & =10\\sqrt{13}\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-17441dbe-6903-5e53-bc8a-41e64fe4b46d"] :db/ensure [:question/validate]} {:db/id "answer-field-17441dbe-6903-5e53-bc8a-41e64fe4b46d" :answer-field/id #uuid "17441dbe-6903-5e53-bc8a-41e64fe4b46d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1b371911-bbad-59a4-a192-de4fbe2c032e" :answer-field/choices ["answer-1b371911-bbad-59a4-a192-de4fbe2