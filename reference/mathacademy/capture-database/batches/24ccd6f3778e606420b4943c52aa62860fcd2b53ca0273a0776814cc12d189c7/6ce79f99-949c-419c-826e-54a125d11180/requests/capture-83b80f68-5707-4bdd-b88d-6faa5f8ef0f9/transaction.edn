ction" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d57718a7-a405-56e2-8a94-d7b92e42a9a5" :answer-field/choices ["answer-6e0fb945-2b6d-5670-bf09-282863aceef8" "answer-d1bf8e07-ae72-521a-a571-3fe55a9a0d1c" "answer-d57718a7-a405-56e2-8a94-d7b92e42a9a5" "answer-3edef9f9-afa0-5aa8-9333-37081eff6eb0" "answer-40ca07d0-a6c8-58fb-a430-c08d8ecf00b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6e0fb945-2b6d-5670-bf09-282863aceef8" :answer/id #uuid "6e0fb945-2b6d-5670-bf09-282863aceef8" :answer/type :answer.type/text :answer/value "$x$ is positive and rational." :db/ensure [:answer/validate]} {:db/id "answer-d1bf8e07-ae72-521a-a571-3fe55a9a0d1c" :answer/id #uuid "d1bf8e07-ae72-521a-a571-3fe55a9a0d1c" :answer/type :answer.type/text :answer/value "$x$ is positive but not rational." :db/ensure [:answer/validate]} {:db/id "answer-d57718a7-a405-56e2-8a94-d7b92e42a9a5" :answer/id #uuid "d57718a7-a405-56e2-8a94-d7b92e42a9a5" :answer/type :answer.type/text :answer/value "$x$ is positive or rational." :db/ensure [:answer/validate]} {:db/id "answer-3edef9f9-afa0-5aa8-9333-37081eff6eb0" :answer/id #uuid "3edef9f9-afa0-5aa8-9333-37081eff6eb0" :answer/type :answer.type/text :answer/value "$x$ is positive." :db/ensure [:answer/validate]} {:db/id "answer-40ca07d0-a6c8-58fb-a430-c08d8ecf00b1" :answer/id #uuid "40ca07d0-a6c8-58fb-a430-c08d8ecf00b1" :answer/type :answer.type/text :answer/value "$x$ is rational." :db/ensure [:answer/validate]} {:db/id "question-854da8a8-8c51-5c3e-9326-1631f3f01481" :question/id #uuid "854da8a8-8c51-5c3e-9326-1631f3f01481" :question/math-academy-id "q-177751" :question/problem "Identify the sentence that is equivalent to the following: \"$x$ is prime and it is less than $15.$\"" :question/worked-solution "First, let's write the sentence more concisely:\n\n\"$x$ is prime and less than $15.$\"\n\nUsing the commutative law, we can swap the order of the words \"prime\" and \"less than $15.$\" The sentence now reads\n\n\"$x$ is less than $15$ and prime.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-197c73ef-f334-57b8-882c-9c62d1bda4f3"] :db/ensure [:question/validate]} {:db/id "answer-field-197c73ef-f334-57b8-882c-9c62d1bda4f3" :answer-field/id #uuid "197c73ef-f334-57b8-882c-9c62d1bda4f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b2c9523-75db-52ad-90b6-743920cb0e1c" :answer-field/choices ["answer-11169113-a322-5390-92d2-e55c2092ca35" "answer-3b2c9523-75db-52ad-90b6-743920cb0e1c" "answer-dd2986ba-55fb-57d4-b1d0-435188ed0220" "answer-7048aca4-33da-5880-90f9-ae988a9e0030" "answer-583a84b9-8448-52dc-a72a-8c7b32c6a6fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-11169113-a322-5390-92d2-e55c2092ca35" :answer/id #uuid "11169113-a322-5390-92d2-e55c2092ca35" :answer/type :answer.type/text :answer/value "$x$ is less than $15$" :db/ensure [:answer/validate]} {:db/id "answer-3b2c9523-75db-52ad-90b6-743920cb0e1c" :answer/id #uuid "3b2c9523-75db-52ad-90b6-743920cb0e1c" :answer/type :answer.type/text :answer/value "$x$ is less than $15$ and prime" :db/ensure [:answer/validate]} {:db/id "answer-dd2986ba-55fb-57d4-b1d0-435188ed0220" :answer/id #uuid "dd2986ba-55fb-57d4-b1d0-435188ed0220" :answer/type :answer.type/text :answer/value "$x$ is less than $15$ but not prime" :db/ensure [:answer/validate]} {:db/id "answer-7048aca4-33da-5880-90f9-ae988a9e0030" :answer/id #uuid "7048aca4-33da-5880-90f9-ae988a9e0030" :answer/type :answer.type/text :answer/value "$x$ is less than $15$ or prime" :db/ensure [:answer/validate]} {:db/id "answer-583a84b9-8448-52dc-a72a-8c7b32c6a6fc" :answer/id #uuid "583a84b9-8448-52dc-a72a-8c7b32c6a6fc" :answer/type :answer.type/text :answer/value "$x$ is prime but less than or equal to $15$" :db/ensure [:answer/validate]} {:db/id "question-d73b303c-fe1b-5cc3-a3a9-7f56e22b2a41" :question/id #uuid "d73b303c-fe1b-5cc3-a3a9-7f56e22b2a41" :question/math-academy-id "q-177757" :question/problem "Simplify the sentence \"$n$ is a multiple of $2,$ and it is a multiple of $2$ and $5.$\"" :question/worked-solution "First, let's rewrite the phrase \"it is a multiple of $2$ and $5$\" as the equivalent phrase \"it is a multiple of $2$ and it is a multiple of $5.$\" The sentence now reads\n\n\"$n$ is a multiple of $2,$ and it is a multiple of $2$ and  it is a multiple of $5.$\"\n\nThen, using the associative law, we can move the comma:\n\n\"$n$ is a multiple of $2$ and it is a multiple of $2,$ and  it is a multiple of $5.$\"\n\nNow, we can simplify the phrase \"$n$ is a multiple of $2$ and it is a multiple of $2$\" to just \"$n$ is a multiple of $2.$\" The sentence now reads\n\n\"$n$ is a multiple of $2,$ and it is multiple of $5.$\"\n\nFinally, we can write the sentence more concisely as\n\n\"$n$ is a multiple of $2$ and $5.$\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ba699cb5-d057-5881-915e-b2613dd7bf26"] :db/ensure [:question/validate]} {:db/id "answer-field-ba699cb5-d057-5881-915e-b2613dd7bf26" :answer-field/id #uuid "ba699cb5-d057-5881-915e-b2613dd7bf26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbfc3ce3-bec9-5e81-b379-d1901d0d3656" :answer-field/choices ["answer-4fcdb60a-6737-5c31-b2cc-9b0bf3d3647d" "answer-fbfc3ce3-bec9-5e81-b379-d1901d0d3656" "answer-e2c62c9e-e868-552c-bee2-daaaa9d8f334" "answer-60ef2f2e-f946-5bac-aca1-7cca6746051e" "answer-e9a31472-1e8f-52f4-95fb-74a95d810ac2"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fcdb60a-6737-5c31-b2cc-9b0bf3d3647d" :answer/id #uuid "4fcdb60a-6737-5c31-b2cc-9b0bf3d3647d" :answer/type :answer.type/text :answer/value "$n$ is a multiple of $2$" :db/ensure [:answer/validate]} {:db/id "answer-fbfc3ce3-bec9-5e81-b379-d1901d0d3656" :answer/id #uuid "fbfc3ce3-bec9-5e81-b379-d1901d0d3656" :answer/type :answer.type/text :answer/value "$n$ is a multiple of $2$ and $5$" :db/ensure [:answer/validate]} {:db/id "answer-e2c62c9e-e868-552c-bee2-daaaa9d8f334" :answer/id #uuid "e2c62c9e-e868-552c-bee2-daaaa9d8f334" :answer/type :answer.type/text :answer/value "$n$ is a multiple of $2$ or $5$" :db/ensure [:answer/validate]} {:db/id "answer-60ef2f2e-f946-5bac-aca1-7cca6746051e" :answer/id #uuid "60ef2f2e-f946-5bac-aca1-7cca6746051e" :answer/type :answer.type/text :answer/value "$n$ is a multiple of $5$" :db/ensure [:answer/validate]} {:db/id "answer-e9a31472-1e8f-52f4-95fb-74a95d810ac2" :answer/id #uuid "e9a31472-1e8f-52f4-95fb-74a95d810ac2" :answer/type :answer.type/text :answer/value "$n$ is a multiple of $5$ but not a multiple of $2$" :db/ensure [:answer/validate]}]
