[{:db/id 17592186221933 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186222002 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186221411 :knowledge-point/questions ["question-5f681488-76a6-582b-8440-bda618691a45"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5f681488-76a6-582b-8440-bda618691a45" :question/id #uuid "5f681488-76a6-582b-8440-bda618691a45" :question/math-academy-id "q-335091" :question/problem "$$\nA=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix},\\,{e}^{At}=\\begin{bmatrix}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{bmatrix}\n$$\n\nGiven the matrices $A$ and ${e}^{At}$ above, compute $\\frac{\\text{d}}{\\text{d}t}({e}^{At}).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\frac{\\text{d}}{\\text{d}t}({e}^{At})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr></tbody></table>" :question/worked-solution "Recall that \n\n$$\n\\frac{\\text{d}}{\\text{d}t}({e}^{At})=A\\,{e}^{At}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{At}) & =A\\,{e}^{At} \\\\  & =\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3{e}^{-3t} & (1-3t){e}^{-3t} \\\\ 0 & -3{e}^{-3t}\\end{bmatrix}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a0d67750-f402-5452-9530-c1f22787272d" "answer-field-6a85e532-8708-5354-86f1-6ed86ff86ac4" "answer-field-25fcf268-273b-59de-a67a-190bf168f7df" 