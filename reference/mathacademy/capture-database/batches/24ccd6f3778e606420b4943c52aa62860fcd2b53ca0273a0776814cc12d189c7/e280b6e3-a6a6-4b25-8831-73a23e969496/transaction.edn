\\\\ 0 & 1 & 2\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}-1 & 0 \\\\ 0 & 1 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}-5 & -4 & 2 \\\\ 4 & 5 & 2\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}5 & 4 & -2 \\\\ 4 & 5 & 2 \\\\ -2 & 2 & 8\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-626db706-0c71-502f-b60c-7278dc1c0430" :question/id #uuid "626db706-0c71-502f-b60c-7278dc1c0430" :question/math-academy-id "q-95203" :question/problem "Find a matrix that defines the orthogonal projection of ${R}^{3}$ onto the plane whose parametric equation is $r=sv+tw$, where\n\n$$\nv=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $r=sv+tw$ is actually the subspace $\\text{Span}\\{v,w\\}.$ \nHence, we have \n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}]{([\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}])}^{-1}[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}]{[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}]}^{-1}[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 0 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}2 & -2 & 2 \\\\ 0 & 3 & 3\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligne