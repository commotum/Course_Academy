 \\\\ -3\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}]\\cdot (14)^{-1}[\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}1 & 2 & -3 \\\\ 2 & 4 & -6 \\\\ -3 & -6 & 9\\end{aligned}].\\end{aligned}\n$$" 13194139535160 17592186045417 true] [17592186133599 1074 "Recall that the matrix $P_S = A(A^T\\!A)^{-1}\\!A^T$ maps any vector $\\mathbf x\\in \\mathbb{R}^n$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nIn our case, ![](images/fd/fde70db50cff408347bdebc086fbfa3ae87020bb0300b32dad67168d617ed607.png) Therefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}]{([\\begin{aligned}1 & 2 & -3\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}]\\cdot (14)^{-1}[\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{14}[\\begin{aligned}1 & 2 & -3 \\\\ 2 & 4 & -6 \\\\ -3 & -6 & 9\\end{aligned}].\\end{aligned}\n$$" 13194139535160 17592186045417 false] [17592186133600 1071 "Which of the following are orthogonal projection matrices?\n\n![](images/13/13213fe5fbeaaa288ba5dadeadf50e24d8b285f4641c3291c90b45352249f8ec.svg)" 13194139535160 17592186045417 true] [17592186133600 1071 "Which of the following are orthogonal projection matrices?\n\n![](images/5b/5b3093e1c65624c862d949706ed5922ab8078beac752d4e7347c71be993580d8.png)" 13194139535160 17592186045417 false] [17592186133601 1071 "![](images/21/21268cd488766dc03da672cb931f1678644d2ada5629c90a591058d6f5954347.png)\nGiven that the vector $\\mathbf{a}$ above spans $S^\\perp,$ and that $P$ is the orthogonal projection matrix of $\\mathbb{R}^3$ onto the subspace $S$, what is the value of $p_{13} + p_{32}?$" 13194139535160 17592186045417 false] [17592186133601 1071 "![](images/66/662db584d066906126cb4e247ccd39e286a46bad59a383931dca8a35cdbcb53d.svg)\nGiven that the vector $\\mathbf{a}$ above spans $S^\\perp,$ and that $P$ is the orthogonal projection matrix of $\\mathbb{R}^3$ onto the subspace $S$, what is the value of $p_{13} + p_{32}?$" 13194139535160 17592186045417 true] [17592186133676 1071 "Find a matrix that defines the orthogonal projection of $\\mathbb{R}^3$ onto the plane whose parametric equation is $\\mathbf{r}=s\\mathbf{v} + t\\mathbf{w}$, where\n![](images/79/79765ab48a76c8f3d5ed1f4c35be519cf0f928c0622e3b7a0319b522395ccb86.svg)" 13194139535160 17592186045417 true] [17592186133676 1071 "Find a matrix that defines the orthogonal projection of $\\mathbb{R}^3$ onto the plane whose parametric equation is $\\mathbf{r}=s\\mathbf{v} + t\\mathbf{w}$, where\n![](images/bd/bd8680b251ca871c0912f7aa85826bc705f022d12155fa1ddc73e2d01c30d2ca.png)" 13194139535160 17592186045417 false] [17592186133676 1074 "Recall that the matrix $P_S = A(A^T\\!A)^{-1}\\!A^T$ maps any vector $\\mathbf x\\in \\mathbb{R}^n$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $\\mathbf{r}=s\\mathbf{v}+t\\mathbf{w}$ is actually the subspace $\\text{Span}\\{\\mathbf{v}, \\mathbf{w}\\}.$ \nHence, we have \n![](images/7d/7d7d41e02a65634517225adc2736cef6ebce4056bb6feca1ac3b9e9e865c7927.svg)\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]{([\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]{[\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}]}^{-1}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 2 & -2 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" 13194139535160 17592186045417 true] [17592186133676 1074 "Recall that the matrix $P_S = A(A^T\\!A)^{-1}\\!A^T$ maps any vector $\\mathbf x\\in \\mathbb{R}^n$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $\\mathbf{r}=s\\mathbf{v}+t\\mathbf{w}$ is actually the subspace $\\text{Span}\\{\\mathbf{v}, \\mathbf{w}\\}.$ \nHence, we have \n![](images/af/af442d03acdc13db51c3ae53fcf250074e9adc2d4ed4bd2f52e6e76b5d4c2fe8.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]{([\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]{[\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}]}^{-1}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 2 & -2 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" 13194139535160 17592186045417 false] [17592186133701 1071 "Which of the following subspaces must be orthogonal to $\\text{Col}(A^T)$ for every matrix $A?$\n\n- $\\text{Null}(A)$\n\n- $\\text{Col}(A)$\n\n- $\\text{Null}(A^T)$" 13194139535160 17592186045417 false] [17592186133701 1071 "Which of the following subspaces must be orthogonal to $\\text{Col}(A^T)$ for every matrix $A?$\n\nI. $\\text{Null}(A)$\n\nII. $\\text{Col}(A)$\n\nIII. $\\text{Null}(A^T)$" 13194139535160 17592186045417 true] [17592186133704 1074 "Pre-multiplying a vector $\\mathbf{x} \\in \\mathbb{R}^n$ by $A$ gives a linear combination of the columns of $A{:}$\n\n![](images/4c/4c69fb7131661c59cec0d5ffc843fe8c89df497c5adb3ed804e0650917dafe1c.png)\n\nTherefore, the image of $\\mathbb{R}^n$ under the action of $A$ must be $\\text{Col}(A),$ the column space of $A.$\n\nFurthermore, since $\\text{Null}(A)$ is mapped to the zero vector $\\mathbf{0}$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(A^T)$ must be $\\text{Col}(A).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8b/8b08bdf79d53f312cabd665bcd4669795bd8851dfb33d5e5db6178bd80b24398.png)" 13194139535160 17592186045417 false] [17592186133704 1074 "Pre-multiplying a vector $\\mathbf{x} \\in \\mathbb{R}^n$ by $A$ gives a linear combination of the columns of $A{:}$\n\n![](images/dc/dc853850b03dd2cf8fcf0168392e3490423725120b6acb55f88028a702d30fa5.svg)\n\nTherefore, the image of $\\mathbb{R}^n$ under the action of $A$ must be $\\text{Col}(A),$ the column space of $A.$\n\nFurthermore, since $\\text{Null}(A)$ is mapped to the zero vector $\\mathbf{0}$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(A^T)$ must be $\\text{Col}(A).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8b/8b08bdf79d53f312cabd665bcd4669795bd8851dfb33d5e5db6178bd80b24398.png)" 13194139535160 17592186045417 true] [17592186133722 1038 #edb/ref 17