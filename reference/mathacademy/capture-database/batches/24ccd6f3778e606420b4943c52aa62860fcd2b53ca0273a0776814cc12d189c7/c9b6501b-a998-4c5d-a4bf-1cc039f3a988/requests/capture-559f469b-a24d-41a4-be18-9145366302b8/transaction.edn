25f-3e3d-5bae-b981-0ca3ee733a60" :answer-field/choices ["answer-91615e7f-cda7-5d9d-9390-062a4757db2c" "answer-e7f2a46b-0ced-5614-ab22-ddbc819f0321" "answer-53f3725f-3e3d-5bae-b981-0ca3ee733a60" "answer-6d6ff737-46c7-53ae-a062-3f69d9c466f1" "answer-ce361e63-d668-575b-846b-05f01eaf6dd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-91615e7f-cda7-5d9d-9390-062a4757db2c" :answer/id #uuid "91615e7f-cda7-5d9d-9390-062a4757db2c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-e7f2a46b-0ced-5614-ab22-ddbc819f0321" :answer/id #uuid "e7f2a46b-0ced-5614-ab22-ddbc819f0321" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-53f3725f-3e3d-5bae-b981-0ca3ee733a60" :answer/id #uuid "53f3725f-3e3d-5bae-b981-0ca3ee733a60" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6d6ff737-46c7-53ae-a062-3f69d9c466f1" :answer/id #uuid "6d6ff737-46c7-53ae-a062-3f69d9c466f1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ce361e63-d668-575b-846b-05f01eaf6dd0" :answer/id #uuid "ce361e63-d668-575b-846b-05f01eaf6dd0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-77a3c45c-df66-5438-9ce6-8791cf4f16da" :question/id #uuid "77a3c45c-df66-5438-9ce6-8791cf4f16da" :question/math-academy-id "q-346656" :question/problem "Evaluate the indicator function\n$1[3\\in \\{1,3,6,8\\}].$" :question/worked-solution "The indicator function $1[P]$ equals $1$ if the predicate $P$ is true and $0$ if $P$ is false.\n\n$$\n1[P]=\\{\\begin{aligned}1, & \\text{if }P\\text{ is true}, \\\\ 0, & \\text{if }P\\text{ is false}.\\end{aligned}\n$$\n\nHere, the predicate is $3\\in \\{1,3,6,8\\}.$ Since $3$ is an element of the set $\\{1,3,6,8\\},$ the predicate is true. Therefore,\n\n$$\n1[3\\in \\{1,3,6,8\\}]=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["an