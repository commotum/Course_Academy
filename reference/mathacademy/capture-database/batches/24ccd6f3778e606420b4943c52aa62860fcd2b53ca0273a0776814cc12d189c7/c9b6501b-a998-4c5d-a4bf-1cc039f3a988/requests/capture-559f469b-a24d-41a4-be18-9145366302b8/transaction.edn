:step/content "question-1b44bc96-863e-5a73-a2ed-628d5188e295" :step/next "step-11ddce49-fc64-55d5-b99d-ac3a1e4e7463" :db/ensure [:step/validate]} {:db/id "step-11ddce49-fc64-55d5-b99d-ac3a1e4e7463" :step/id #uuid "11ddce49-fc64-55d5-b99d-ac3a1e4e7463" :step/content "question-b1cfb6c9-bb07-5ff5-8e41-4388a89b7e12" :db/ensure [:step/validate]} [:db/retract 17592186159278 :answer-field/choices 17592186159280] [:db/retract 17592186159278 :answer-field/choices 17592186159281] [:db/retract 17592186159278 :answer-field/choices 17592186159282] [:db/retract 17592186159278 :answer-field/choices 17592186159283] [:db/retract 17592186159278 :answer-field/choices 17592186159279] {:db/id 17592186162090 :knowledge-point/questions ["question-92a0ecc9-adbd-5716-8a7f-f658ffcbaf41" "question-7eff1b38-24fd-5e4c-adf3-ec6e1162e257"] :db/ensure [:knowledge-point/validate]} {:db/id "question-92a0ecc9-adbd-5716-8a7f-f658ffcbaf41" :question/id #uuid "92a0ecc9-adbd-5716-8a7f-f658ffcbaf41" :question/math-academy-id "q-138486" :question/problem "For the matrix \n$A=[\\begin{aligned}8 & 0 \\\\ 0 & 0\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}8 & 0 \\\\ 0 & 0\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}{8}^{-1} & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1b0c82a-9a7e-5567-921e-646b3756d6d7"] :db/ensure [:question/validate]} {:db/id "answer-field-d1b0c82a-9a7e-5567-921e-646b3756d6d7" :answer-field/id #uuid "d1b0c82a-9a7e-5567-921e-646b3756d6d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7695fdb-ee31-5096-a213-f3e9e5fbfec7" :answer-field/choices ["answer-7644a604-cf73-5442-8725-be22ba80a563" "answer-8ca0e0bb-8a82-5517-b771-f93850f54c4b" "answer-607fba4b-a3c5-53ce-9054-c4e5df896d07" "answer-a7695fdb-ee31-5096-a213-f3e9e5fbfec7" "answer-bb902678-e8ab-5d83-8667-d11bab43ee55"] :db/ensure [:answer-field/validate]} {:db/id "answer-7644a604-cf73-5442-8725-be22ba80a563" :answer/id #uuid "7644a604-cf73-5442-8725-be22ba80a563" :answer/type :answer.type/math :answer/value "\\frac{1}{8}[\\begin{aligned}0 & -1 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8ca0e0bb-8a82-5517-b771-f93850f54c4b" :answer/id #uuid "8ca0e0bb-8a82-5517-b771-f93850f54c4b" :answer/type :answer.type/math :answer/value "\\frac{1}{8}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-607fba4b-a3c5-53ce-9054-c4e5df896d07" :answer/id #uuid "607fba4b-a3c5-53ce-9054-c4e5df896d07" :answer/type :answer.type/math :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a7695fdb-ee31-5096-a213-f3e9e5fbfec7" :answer/id #uuid "a7695fdb-ee31-5096-a213-f3e9e5fbfec7" :answer/type :answer.type/math :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bb902678-e8ab-5d83-8667-d11bab43ee55" :answer/id #uuid "bb902678-e8ab-5d83-8667-d11bab43ee55" :answer/type :answer.type/math :answer/value "\\frac{1}{8}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-7eff1b38-24fd-5e4c-adf3-ec6e1162e257" :question/id #uuid "7eff1b38-24fd-5e4c-adf3-ec6e1162e257" :question/math-academy-id "q-138484" :question/problem "For the matrix \n$A=[\\begin{aligned}0 & 0 \\\\ 0 & 4\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}0 & 0 \\\\ 0 & 4\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & {4}^{-1}\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4ea4243f-e8bc-5238-a430-24274b725da6"] :db/ensure [:question/validate]} {:db/id "answer-field-4ea4243f-e8bc-5238-a430-24274b725da6" :answer-field/id #uuid "4ea4243f-e8bc-5238-a430-24274b725da6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25e92a54-1b79-51b0-9145-95bb94f1dc21" :answer-field/choices ["answer-82dd3bce-a901-539c-9a60-4a9bc7a451d4" "answer-3c19642d-0d29-5db8-8698-690e13c0ca93" "answer-25e92a54-1b79-51b0-9145-95bb94f1dc21" "answer-5ee1a542-97ea-57ea-832a-117266a654c0" "answer-0e59c3e9-3153-55ad-a3a5-92e642d0788c"] :db/ensure [:answer-field/validate]} {:db/id "answer-82dd3bce-a901-539c-9a60-4a9bc7a451d4" :answer/id #uuid "82dd3bce-a901-539c-9a60-4a9bc7a451d4" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3c19642d-0d29-5db8-8698-690e13c0ca93" :answer/id #uuid "3c19642d-0d29-5db8-8698-690e13c0ca93" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-25e92a54-1b79-51b0-9145-95bb94f1dc21" :answer/id #uuid "25e92a54-1b79-51b0-9145-95bb94f1dc21" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5ee1a542-97ea-57ea-832a-117266a654c0" :answer/id #uuid "5ee1a542-97ea-57ea-832a-117266a654c0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0e59c3e9-3153-55ad-a3a5-92e642d0788c" :answer/id #uuid "0e59c3e9-3153-55ad-a3a5-92e642d0788c" :answer/type :answer.type/math :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186162346 :question/problem "For the matrix \n$A=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}],$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}{2}^{-1} & 0 \\\\ 0 & {5}^{-1} \\\\ 0 & 0\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}5 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159278 :answer-field/correct "answer-bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd" :answer-field/choices ["answer-b78213b1-1bfd-5637-bcbc-943dcbd0d99c" "answer-7cd17152-3983-5db3-8252-60325d77c72c" "answer-3c2319a4-1c0c-55d6-a9a4-cedc2a35cda6" "answer-1ae7f487-e4cb-5a2c-9236-037edd4464c6" "answer-bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-b78213b1-1bfd-5637-bcbc-943dcbd0d99c" :answer/id #uuid "b78213b1-1bfd-5637-bcbc-943dcbd0d99c" :answer/type :answer.type/math :answer/value "\\frac{1}{10}[\\begin{aligned}-5 & 0 \\\\ 0 & -2 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7cd17152-3983-5db3-8252-60325d77c72c" :answer/id #uuid "7cd17152-3983-5db3-8252-60325d77c72c" :answer/type :answer.type/math :answer/value "\\frac{1}{10}[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3c2319a4-1c0c-55d6-a9a4-cedc2a35cda6" :answer/id #uuid "3c2319a4-1c0c-55d6-a9a4-cedc2a35cda6" :answer/type :answer.type/math :answer/value "\\frac{1}{10}[\\begin{aligned}2 & 0 \\\\ 0 & 5 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1ae7f487-e4cb-5a2c-9236-037edd4464c6" :answer/id #uuid "1ae7f487-e4cb-5a2c-9236-037edd4464c6" :answer/type :answer.type/math :answer/value "\\frac{1}{10}[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd" :answer/id #uuid "bdbedc83-febf-5b2d-ab4e-2f262fbdb8dd" :answer/type :answer.type/math :answer/value "\\frac{1}{10}[\\begin{aligned}5 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186163306 :tutorial/content "The invertible matrix theorem tells us that if $A$ is an $n \\times n$ matrix with full rank (i.e., $\\mathrm{rank}(A)=n$), then there exists a unique inverse matrix $A^{-1}$ such that \n\n$$\nAA^{-1}=A^{-1}\\!A=I_n,\n$$\n\nwhere $I_n$ denotes the $n \\times n$ identity matrix.\n\nThere are two questions that we can ask:\n\n- Can we extend the notion of an inverse matrix to one that works for $n\\times n$ matrices $A$ where $\\mathrm{rank}(A) < n?$\n\n- Is it possible to generalize the concept of an inverse to non-square matrices?\n\nThe answer to both questions is yes! This generalization of the inverse of $A$ is called the **pseudoinverse** of $A,$ and is denoted $A^+.$ The dimensions of $A^+$ are the same as $A^T.$\n\nAs an example, let's consider the ${\\color{red}{3}}\\times {\\color{blue}{2}}$ matrix $A$ and its corresponding pseudoinverse, given below:\n\n![](images/87/87581a69d3d76dbf3b0ebca8941c9a82b5b9443b00e86f32e4e9e4a42ef5e18b.svg)\n\n- Computing $A^{+}\\!A,$ we have\n\n$$\n\\begin{aligned}{A}^{+}\\,A & =\\frac{1}{5}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}]\\cdot [\\begin{aligned}5 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nwhich is the identity matrix $I_{\\color{blue}{2}}.$\n\n- Computing $A\\!A^{+},$ we have\n\n$$\n\\begin{aligned}A{A}^{+} & =[\\begin{aligned}5 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 5 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is *almost* the identity matrix $I_{\\color{red}{3}}.$\n\nWe can explain this result using the following properties of the pseudoinverse:\n\n- *If the columns of an $m\\times {\\color{blue}{n}}$ matrix $A$ are linearly independent, then $A^+A = I_{\\color{blue}{n}}.$*\n\n- *If the rows of an ${\\color{red}{m}}\\times n$ matrix $A$ are linearly independent, then $AA^+ = I_{\\color{red}{m}}.$*\n\nIn the example above, the columns of $A$ are linearly independent, but the rows are not.\n\nMoreover, the notion of a pseudoinverse is consistent with inverse matrices. In particular,\n\n*If $A$ is an invertible square matrix, then $A^{+} = A^{-1}.$*\n\nThis lesson will discuss how to compute the pseudoinverse for any matrix, starting with an important special case." :db/ensure [:tutorial/validate]} {:db/id 17592186163314 :tutorial/content "For an *almost* zero ${\\color{red}{m}}\\times {\\color{blue}{n}}$ matrix with non-zero entries \n\n$$\n\\sigma_1, \\: \\sigma_2, \\: \\ldots, \\: \\sigma_r\n$$\n\non the main diagonal only, the corresponding pseudoinverse is the *almost* zero ${\\color{blue}{n}}\\times {\\color{red}{m}}$ matrix with non-zero entries \n\n$$\n{\\sigma_1^{-1}}, \\, {\\sigma_2^{-1}}, \\, \\ldots, \\, {\\sigma_r^{-1}}\n$$\n\non the main diagonal only.\n\nFor example, for the matrix $A,$ given by\n\n![](images/d6/d6d6a167747f99c5a48be59ae3e11ca7b5a9188e80ddeb63b8c0f193d991b18c.svg)\n\nwe calculate its pseudoinverse as follows:\n\n- **Step 1:** Replace the non-zero elements on the main diagonal with their multiplicative inverses.\n\n- **Step 2:** Transpose the resulting matrix.\n\n$$\n\\begin{aligned}{A}^{+} & ={[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 4 & 0\\end{aligned}]}^{+} \\\\  & =[\\begin{aligned}{3}^{-1} & 0 \\\\ 0 & {4}^{-1} \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1/3 & 0 \\\\ 0 & 1/4 \\\\ 0 & 0\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}4 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} [:db/retract 17592186212724 :answer-field/choices 17592186212725] [:db/retract 17592186212724 :answer-field/choices 17592186212726] [:db/retract 17592186212724 :answer-field/choices 17592186212727] [:db/retract 17592186212724 :answer-field/choices 17592186212728] [:db/retract 17592186212724 :answer-field/choices 17592186212729] {:db/id 17592186213823 :question/problem "Rationalize the denominator of $\\frac{x}{\\sqrt{x+2}+4}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+2}-4.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+2}-4,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{\\sqrt{x+2}+4} & = \\\\ \\frac{x}{\\sqrt{x+2}+4}\\cdot \\frac{\\sqrt{x+2}-4}{\\sqrt{x+2}-4} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2}+4)(\\sqrt{x+2}-4)} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{(\\sqrt{x+2})^{2}-{4}^{2}} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x+2-16} & = \\\\ \\frac{x(\\sqrt{x+2}-4)}{x-14}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186212724 :answer-field/correct "answer-c775aed0-24c4-56d0-8bf0-fec61f178576" :answer-field/choices ["answer-2cb8232e-74ec-5125-9023-35f18e70215d" "answer-c775aed0-24c4-56d0-8bf0-fec61f178576" "answer-2fd21317-9259-5e13-8f0c-addab41d0918" "answer-fa7bc214-ee6d-5abf-966b-772d87f7e378" "answer-6bed1864-1f50-54e3-8cde-8a57d07fe2d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cb8232e-74ec-5125-9023-35f18e70215d" :answer/id #uuid "2cb8232e-74ec-5125-9023-35f18e70215d" :answer/type :answer.type/math :answer/value "\\frac{x(\\sqrt{x+2}+4)}{x+18}" :db/ensure [:answer/validate]} {:db/id "answer-c775aed0-24c4-56d0-8bf0-fec61f178576" :answer/id #uuid "c775aed0-24c4-56d0-8bf0-fec61f178576" :answer/type :answer.type/math :answer/value "\\frac{x(\\sqrt{x+2}-4)}{x-14}" :db/ensure [:answer/validate]} {:db/id "answer-2fd21317-9259-5e13-8f0c-addab41d0918" :answer/id #uuid "2fd21317-9259-5e13-8f0c-addab41d0918" :answer/type :answer.type/math :answer/value "\\frac{x(\\sqrt{x-2}-4)}{x-18}" :db/ensure [:answer/validate]} {:db/id "answer-fa7bc214-ee6d-5abf-966b-772d87f7e378" :answer/id #uuid "fa7bc214-ee6d-5abf-966b-772d87f7e378" :answer/type :answer.type/math :answer/value "\\frac{x\\sqrt{x-2}+4}{x-14}" :db/ensure [:answer/validate]} {:db/id "answer-6bed1864-1f50-54e3-8cde-8a57d07fe2d0" :answer/id #uuid "6bed1864-1f50-54e3-8cde-8a57d07fe2d0" :answer/type :answer.type/math :answer/value "\\frac{x}{x-14}" :db/ensure [:answer/validate]} {:db/id 17592186213019 :knowledge-point/questions ["question-992f7e69-958f-50e1-a735-f09f05b61b6f" "question-3a9fdb79-91cf-5159-aced-4b759a444970" "question-39e0f80f-2c55-5d22-8bb4-e3a1b6fcdd0a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-992f7e69-958f-50e1-a735-f09f05b61b6f" :question/id #uuid "992f7e69-958f-50e1-a735-f09f05b61b6f" :question/math-academy-id "q-111099" :question/problem "Rationalize the denominator of $\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{r+2}+\\sqrt{r+4}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{r+2}+\\sqrt{r+4},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}} & = \\\\ \\frac{10}{\\sqrt{r+2}-\\sqrt{r+4}}\\cdot \\frac{\\sqrt{r+2}+\\sqrt{r+4}}{\\sqrt{r+2}+\\sqrt{r+4}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2}-\\sqrt{r+4})(\\sqrt{r+2}+\\sqrt{r+4})} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(\\sqrt{r+2})^{2}-(\\sqrt{r+4})^{2}} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(r+2)-(r+4)} & = \\\\ \\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{(-2)} & = \\\\ -5(\\sqrt{r+2}+\\sqrt{r+4})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b36b37fd-6651-507b-9910-0f73d22b7862"] :db/ensure [:question/validate]} {:db/id "answer-field-b36b37fd-6651-507b-9910-0f73d22b7862" :answer-field/id #uuid "b36b37fd-6651-507b-9910-0f73d22b7862" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5e09eb6-db36-531d-9813-9dc0cf25461d" :answer-field/choices ["answer-fcdb5dd9-42a5-5cbf-ba24-229151615522" "answer-f5e09eb6-db36-531d-9813-9dc0cf25461d" "answer-d56d8f89-912d-53cd-a553-2efdf5e9d6c8" "answer-7ce9dcd7-1369-5100-b33d-5f23930931b4" "answer-b53f8a4f-b03c-5aea-a6f2-83a77fe9b67f"] :db/ensure [:answer-field/validate]} {:db/id "answer-fcdb5dd9-42a5-5cbf-ba24-229151615522" :answer/id #uuid "fcdb5dd9-42a5-5cbf-ba24-229151615522" :answer/type :answer.type/math :answer/value "-10(\\sqrt{r+2}+\\sqrt{r+4})" :db/ensure [:answer/validate]} {:db/id "answer-f5e09eb6-db36-531d-9813-9dc0cf25461d" :answer/id #uuid "f5e09eb6-db36-531d-9813-9dc0cf25461d" :answer/type :answer.type/math :answer/value "-5(\\sqrt{r+2}+\\sqrt{r+4})" :db/ensure [:answer/validate]} {:db/id "answer-d56d8f89-912d-53cd-a553-2efdf5e9d6c8" :answer/id #uuid "d56d8f89-912d-53cd-a553-2efdf5e9d6c8" :answer/type :answer.type/math :answer/value "-\\frac{5(\\sqrt{r+2}+\\sqrt{r+4})}{r}" :db/ensure [:answer/validate]} {:db/id "answer-7ce9dcd7-1369-5100-b33d-5f23930931b4" :answer/id #uuid "7ce9dcd7-1369-5100-b33d-5f23930931b4" :answer/type :answer.type/math :answer/value "5(\\sqrt{r+2}+\\sqrt{r+4})" :db/ensure [:answer/validate]} {:db/id "answer-b53f8a4f-b03c-5aea-a6f2-83a77fe9b67f" :answer/id #uuid "b53f8a4f-b03c-5aea-a6f2-83a77fe9b67f" :answer/type :answer.type/math :answer/value "\\frac{10(\\sqrt{r+2}+\\sqrt{r+4})}{r}" :db/ensure [:answer/validate]} {:db/id "question-3a9fdb79-91cf-5159-aced-4b759a444970" :question/id #uuid "3a9fdb79-91cf-5159-aced-4b759a444970" :question/math-academy-id "q-296007" :question/problem "Rationalize the denominator of $\\frac{5z}{\\sqrt{2}+\\sqrt{10z}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}-\\sqrt{10z}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}-\\sqrt{10z},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5z}{\\sqrt{2}+\\sqrt{10z}} & = \\\\ \\frac{5z}{\\sqrt{2}+\\sqrt{10z}}\\cdot \\frac{\\sqrt{2}-\\sqrt{10z}}{\\sqrt{2}-\\sqrt{10z}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2}+\\sqrt{10z})(\\sqrt{2}-\\sqrt{10z})} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{(\\sqrt{2})^{2}-(\\sqrt{10z})^{2}} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-10z} & = \\\\ \\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5ef8731e-9af3-5ebb-ac94-c0117d6e5d8f"] :db/ensure [:question/validate]} {:db/id "answer-field-5ef8731e-9af3-5ebb-ac94-c0117d6e5d8f" :answer-field/id #uuid "5ef8731e-9af3-5ebb-ac94-c0117d6e5d8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9535b9e0-b46d-506d-a7b8-72740283f836" :answer-field/choices ["answer-c2dbbb0d-019b-5038-acdd-928bb643e139" "answer-9535b9e0-b46d-506d-a7b8-72740283f836" "answer-3209607c-4fd0-5f69-8dbb-841fd6d6a93f" "answer-e61a03b8-2399-5b96-83df-cc93cbd78137" "answer-92311420-2889-54e9-a9dd-2d80f687d0f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2dbbb0d-019b-5038-acdd-928bb643e139" :answer/id #uuid "c2dbbb0d-019b-5038-acdd-928bb643e139" :answer/type :answer.type/math :answer/value "\\frac{5z(\\sqrt{2}+\\sqrt{10z})}{2-5z}" :db/ensure [:answer/validate]} {:db/id "answer-9535b9e0-b46d-506d-a7b8-72740283f836" :answer/id #uuid "9535b9e0-b46d-506d-a7b8-72740283f836" :answer/type :answer.type/math :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2(1-5z)}" :db/ensure [:answer/validate]} {:db/id "answer-3209607c-4fd0-5f69-8dbb-841fd6d6a93f" :answer/id #uuid "3209607c-4fd0-5f69-8dbb-841fd6d6a93f" :answer/type :answer.type/math :answer/value "\\frac{5z(\\sqrt{2}-\\sqrt{10z})}{2-5z}" :db/ensure [:answer/validate]} {:db/id "answer-e61a03b8-2399-5b96-83df-cc93cbd78137" :answer/id #uuid "e61a03b8-2399-5b96-83df-cc93cbd78137" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}z+\\sqrt{10z}}{1-5z}" :db/ensure [:answer/validate]} {:db/id "answer-92311420-2889-54e9-a9dd-2d80f687d0f3" :answer/id #uuid "92311420-2889-54e9-a9dd-2d80f687d0f3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}z-\\sqrt{10z}}{1+5z}" :db/ensure [:answer/validate]} {:db/id "question-39e0f80f-2c55-5d22-8bb4-e3a1b6fcdd0a" :question/id #uuid "39e0f80f-2c55-5d22-8bb4-e3a1b6fcdd0a" :question/math-academy-id "q-296017" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{3x}-\\sqrt{5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3x}+\\sqrt{5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3x}+\\sqrt{5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{3x}-\\sqrt{5}} & = \\\\ \\frac{3}{\\sqrt{3x}-\\sqrt{5}}\\cdot \\frac{\\sqrt{3x}+\\sqrt{5}}{\\sqrt{3x}+\\sqrt{5}} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{(\\sqrt{3x}-\\sqrt{5})(\\sqrt{3x}+\\sqrt{5})} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{(\\sqrt{3x})^{2}-(\\sqrt{5})^{2}} & = \\\\ \\frac{3(\\sqrt{3x}+\\sqrt{5})}{3x-5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d44c3d89-d15d-50e0-8f58-33af07aca530"] :db/ensure [:question/validate]} {:db/id "answer-field-d44c3d89-d15d-50e0-8f58-33af07aca530" :answer-field/id #uuid "d44c3d89-d15d-50e0-8f58-33af07aca530" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7c65232-c686-59ec-910b-ca36f2dc66e2" :answer-field/choices ["answer-d7c65232-c686-59ec-910b-ca36f2dc66e2" "answer-db7835db-46f2-5180-b58e-a639e5d2d792" "answer-7c2a016e-ad1a-5c19-8891-77f26cce6fc3" "answer-ca31bd2f-56b5-56fd-a0c5-eed7fb8fb9e5" "answer-bd4d8cde-eff6-5e7c-a368-c0664c614edd"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7c65232-c686-59ec-910b-ca36f2dc66e2" :answer/id #uuid "d7c65232-c686-59ec-910b-ca36f2dc66e2" :answer/type :answer.type/math :answer/value "\\frac{3(\\sqrt{3x}+\\sqrt{5})}{3x-5}" :db/ensure [:answer/validate]} {:db/id "answer-db7835db-46f2-5180-b58e-a639e5d2d792" :answer/id #uuid "db7835db-46f2-5180-b58e-a639e5d2d792" :answer/type :answer.type/math :answer/value "\\frac{3(\\sqrt{3x}-\\sqrt{5})}{3x-5}" :db/ensure [:answer/validate]} {:db/id "answer-7c2a016e-ad1a-5c19-8891-77f26cce6fc3" :answer/id #uuid "7c2a016e-ad1a-5c19-8891-77f26cce6fc3" :answer/type :answer.type/math :answer/value "\\frac{3(\\sqrt{5}+\\sqrt{3x})}{5-3x}" :db/ensure [:answer/validate]} {:db/id "answer-ca31bd2f-56b5-56fd-a0c5-eed7fb8fb9e5" :answer/id #uuid "ca31bd2f-56b5-56fd-a0c5-eed7fb8fb9e5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3x}+\\sqrt{5}}{x-5}" :db/ensure [:answer/validate]} {:db/id "answer-bd4d8cde-eff6-5e7c-a368-c0664c614edd" :answer/id #uuid "bd4d8cde-eff6-5e7c-a368-c0664c614edd" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3x}-\\sqrt{5}}{3x+5}" :db/ensure [:answer/validate]} {:db/id "activity-2f467153-cd5d-58bd-9dd1-773651735caf" :activity/id #uuid "2f467153-cd5d-58bd-9dd1-773651735caf" :activity/title "Further Rationalizing Denominators of Algebraic Expressions" :activity/type :activity.type/review :activity/scope 17592186048758 :activity/course 17592186046658 :activity/steps ["step-62818f69-eeae-50e0-81e1-c5bff1a5b643" "step-ded7d104-608d-5295-b9d2-dc886b061230" "step-07d130dd-3700-52b3-9d3d-940cb9caaef0" "step-a2bfbd34-58b2-5080-ba93-ed039d0f0805" "step-b58fd579-cb36-5e2e-9125-29e07e71058a"] :activity/first-step "step-62818f69-eeae-50e0-81e1-c5bff1a5b643" :db/ensure [:activity/validate]} {:db/id "step-62818f69-eeae-50e0-81e1-c5bff1a5b643" :step/id #uuid "62818f69-eeae-50e0-81e1-c5bff1a5b643" :step/content 17592186213823 :step/next "step-ded7d104-608d-5295-b9d2-dc886b061230" :db/ensure [:step/validate]} {:db/id "step-ded7d104-608d-5295-b9d2-dc886b061230" :step/id #uuid "ded7d104-608d-5295-b9d2-dc886b061230" :step/content 17592186233966 :step/next "step-07d130dd-3700-52b3-9d3d-940cb9caaef0" :db/ensure [:step/validate]} {:db/id "step-07d130dd-3700-52b3-9d3d-940cb9caaef0" :step/id #uuid "07d130dd-3700-52b3-9d3d-940cb9caaef0" :step/content "question-992f7e69-958f-50e1-a735-f09f05b61b6f" :step/next "step-a2bfbd34-58b2-5080-ba93-ed039d0f0805" :db/ensure [:step/validate]} {:db/id "step-a2bfbd34-58b2-5080-ba93-ed039d0f0805" :step/id #uuid "a2bfbd34-58b2-5080-ba93-ed039d0f0805" :step/content "question-3a9fdb79-91cf-5159-aced-4b759a444970" :step/next "step-b58fd579-cb36-5e2e-9125-29e07e71058a" :db/ensure [:step/validate]} {:db/id "step-b58fd579-cb36-5e2e-9125-29e07e71058a" :step/id #uuid "b58fd579-cb36-5e2e-9125-29e07e71058a" :step/content "question-39e0f80f-2c55-5d22-8bb4-e3a1b6fcdd0a" :db/ensure [:step/validate]} {:db/id 17592186078395 :knowledge-point/questions ["question-07caf841-c23b-5d01-856b-51dc74025403" "question-7d8ea2fc-3731-5b48-8288-39aacc74f9f4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078259 :question/worked-solution "Using a calculator, we find \n\n$$\n\\begin{aligned}\\operatorname{arcsin}⁡(0.2) & =(11.536...)^{∘} \\\\  & ≈{12}^{∘}\\end{aligned}\n$$\n\nrounded to the nearest integer." :db/ensure [:question/validate]} {:db/id 17592186078396 :knowledge-point/questions ["question-c9e6b263-d73b-5513-9574-32caadf21e21" "question-3d28482b-a0c8-53e6-a980-b5acf56e83ea"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078260 :question/worked-solution "To find $\\theta$ and $\\alpha$ we use $\\arccos$ and $\\arctan$ respectively. We get\n\n$$\n\\eqalign{\n\\cos\\theta \t\t\t& = 0.64\\\n\\arccos(\\cos\\theta)\t& = \\arccos(0.64) \\\n\\theta&=\\arccos(0.64)\n}\n$$\n\nand\n\n$$\n\\eqalign{\n\\tan\\alpha \t\t\t& = 1.25 \\\n\\arctan(\\tan\\alpha)\t\t& =\\arctan(1.25) \\\n\\alpha&=\\arctan(1.25).\n}\n$$\n\nThen, using a calculator, we find\n\n$$\n\\eqalign{\n\\theta + \\alpha\t\t\t\t\t& =\\arccos(0.64)+\\arctan(1.25)\\\n&=(50.208...)^{\\circ} +  (51.340...)^{\\circ} \\\n\t& = (101.548...)^{\\circ}\t\\\n\t& \\approx 102^{\\circ}\n}\n$$\n\nrounded to the nearest integer.\n\n**Watch out!** If we round $\\theta$ and $\\alpha$ to the nearest integer, we get $\\theta \\approx 50^\\circ$ and $\\alpha \\approx 51^\\circ.$ After we sum  up the angles we get an incorrect result:\n\n$$\n\\begin{aligned}\\theta +\\alpha  & ≈{50}^{∘}+{51}^{∘}={101}^{∘}\\end{aligned}\n$$\n\nThe correct answer is $102^\\circ,$ not $101^\\circ.$ This is a rounding error! To avoid this kind of error we have to round *after* we take the sum, not before." :db/ensure [:question/validate]} {:db/id 17592186078397 :knowledge-point/questions ["question-63ad50c7-f590-525f-9856-7ab603587d0d" "question-a9231519-804c-5398-8af6-73a4e2d373bf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078261 :question/problem "In a right triangle $\\triangle ABC,$ we have $AC = 9,$ $BC=13,$ and $m\\angle A = \\alpha.$ Given that $\\overline{AB}$ is the hypotenuse of the triangle, find the value of $\\alpha$ (rounded to one decimal place)." :question/worked-solution "Let's sketch the triangle that's described.\n\n \n\n![](images/29/29ab71a468b9a57842e07ef74b8d8d770c7ebfacabb3735694c0dd40303ad220.png)\n\nSince we are given the lengths of the adjacent and opposite sides, we can use tangent to find the angle measurement. We have\n\n$$\n\\tan \\alpha=  \\dfrac{\\textrm{opposite}}{\\textrm{adjacent}}  = \\dfrac{13}{9}.\n$$\n\nWe now calculate $\\alpha$ using the inverse tangent:\n\n$$\n\\eqalign{\n\t\t\\tan \\alpha &= \\dfrac{13}{9}\\[5pt]\n\t\t\\arctan( \\tan \\alpha) &= \\arctan\\left(\\dfrac{13}{9} \\right)\\[5pt]\n\t\t\\alpha &= \\arctan\\left(\\dfrac{13}{9} \\right)\\[5pt]\n&=(55.304\\,8...)^\\circ\\[5pt]\t\n\t\t &\\approx 55.3^\\circ\n\t}\n$$\n\nrounded to one decimal place." :db/ensure [:question/validate]} {:db/id "question-07caf841-c23b-5d01-856b-51dc74025403" :question/id #uuid "07caf841-c23b-5d01-856b-51dc74025403" :question/math-academy-id "q-76576" :question/problem "Using a calculator, find the value of $\\operatorname{arcsin}⁡(\\frac{2}{3})+\\operatorname{arctan}⁡(\\frac{1}{2})$ in degrees to the nearest degree." :question/worked-solution "Using a calculator, we find \n\n$$\n\\begin{aligned}\\operatorname{arcsin}⁡(\\frac{2}{3})+\\operatorname{arctan}⁡(\\frac{1}{2}) & =(41.810…)^{∘}+(26.565…)^{∘} \\\\  & =(68.375…)^{∘} \\\\  & ≈{68}^{∘}\\end{aligned}\n$$\n\nrounded to the nearest degree." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-86a8665b-bde3-52c7-b1d3-5fddd8560e4c"] :db/ensure [:question/validate]} {:db/id "answer-field-86a8665b-bde3-52c7-b1d3-5fddd8560e4c" :answer-field/id #uuid "86a8665b-bde3-52c7-b1d3-5fddd8560e4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0a6e61cd-d186-5792-84d0-8d7d67600c66" :answer-field/choices ["answer-c6e2bbae-35c1-5d0c-a925-bfeae261bad9" "answer-e5e3e47c-bd55-5a69-9a47-9986d09220c5" "answer-2a8bc0df-5aa9-5ce3-bcbf-a8928812b638" "answer-0a6e61cd-d186-5792-84d0-8d7d67600c66" "answer-9bfcee41-0fad-566f-9af6-d545060b165d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6e2bbae-35c1-5d0c-a925-bfeae261bad9" :answer/id #uuid "c6e2bbae-35c1-5d0c-a925-bfeae261bad9" :answer/type :answer.type/math :answer/value "{59}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-e5e3e47c-bd55-5a69-9a47-9986d09220c5" :answer/id #uuid "e5e3e47c-bd55-5a69-9a47-9986d09220c5" :answer/type :answer.type/math :answer/value "{63}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-2a8bc0df-5aa9-5ce3-bcbf-a8928812b638" :answer/id #uuid "2a8bc0df-5aa9-5ce3-bcbf-a8928812b638" :answer/type :answer.type/math :answer/value "{66}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-0a6e61cd-d186-5792-84d0-8d7d67600c66" :answer/id #uuid "0a6e61cd-d186-5792-84d0-8d7d67600c66" :answer/type :answer.type/math :answer/value "{68}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-9bfcee41-0fad-566f-9af6-d545060b165d" :answer/id #uuid "9bfcee41-0fad-566f-9af6-d545060b165d" :answer/type :answer.type/math :answer/value "{71}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-7d8ea2fc-3731-5b48-8288-39aacc74f9f4" :question/id #uuid "7d8ea2fc-3731-5b48-8288-39aacc74f9f4" :question/math-academy-id "q-122419" :question/problem "Find the value of  $\\operatorname{arctan}⁡(\\frac{3}{2})$ in degrees to the nearest degree." :question/worked-solution "Using a calculator, we find\n\n$$\n\\begin{aligned}\\operatorname{arctan}⁡(\\frac{3}{2}) & =(56.309…)^{∘} \\\\  & ≈{56}^{∘}\\end{aligned}\n$$\n\nrounded to the nearest degree." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e7bf571-3da0-5ba9-9c54-e3a915fafd86"] :db/ensure [:question/validate]} {:db/id "answer-field-5e7bf571-3da0-5ba9-9c54-e3a915fafd86" :answer-field/id #uuid "5e7bf571-3da0-5ba9-9c54-e3a915fafd86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5294be99-f335-5f00-9dc1-33495c1ddccf" :answer-field/choices ["answer-592dd33b-32ce-5762-b91a-04fda1691cab" "answer-5294be99-f335-5f00-9dc1-33495c1ddccf" "answer-392938b3-fafd-5d04-96a2-6f65b79f2214" "answer-12e5b434-b339-517f-8e76-65e3a8e74c55" "answer-936b2fb6-abb5-5942-9464-f53912a834de"] :db/ensure [:answer-field/validate]} {:db/id "answer-592dd33b-32ce-5762-b91a-04fda1691cab" :answer/id #uuid "592dd33b-32ce-5762-b91a-04fda1691cab" :answer/type :answer.type/math :answer/value "{49}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-5294be99-f335-5f00-9dc1-33495c1ddccf" :answer/id #uuid "5294be99-f335-5f00-9dc1-33495c1ddccf" :answer/type :answer.type/math :answer/value "{56}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-392938b3-fafd-5d04-96a2-6f65b79f2214" :answer/id #uuid "392938b3-fafd-5d04-96a2-6f65b79f2214" :answer/type :answer.type/math :answer/value "{59}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-12e5b434-b339-517f-8e76-65e3a8e74c55" :answer/id #uuid "12e5b434-b339-517f-8e76-65e3a8e74c55" :answer/type :answer.type/math :answer/value "{63}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-936b2fb6-abb5-5942-9464-f53912a834de" :answer/id #uuid "936b2fb6-abb5-5942-9464-f53912a834de" :answer/type :answer.type/math :answer/value "{67}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-c9e6b263-d73b-5513-9574-32caadf21e21" :question/id #uuid "c9e6b263-d73b-5513-9574-32caadf21e21" :question/math-academy-id "q-27912" :question/problem "If $\\operatorname{tan}⁡\\theta =0.25$ and $\\theta $ is acute, then the value of $\\theta $ in degrees to one decimal place is" :question/worked-solution "To find $\\theta $ we use $arctan.$ We get\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =0.25 \\\\ \\operatorname{arctan}⁡(\\operatorname{tan}⁡\\theta ) & =\\operatorname{arctan}⁡(0.25) \\\\ \\theta  & =\\operatorname{arctan}⁡(0.25).\\end{aligned}\n$$\n\nUsing a calculator, we find\n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡(0.25). \\\\  & =(14.036\\,2…)^{∘} \\\\  & ≈{14.0}^{∘}\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ff543ef-f7c1-5af4-b11c-da6db40af722"] :db/ensure [:question/validate]} {:db/id "answer-field-1ff543ef-f7c1-5af4-b11c-da6db40af722" :answer-field/id #uuid "1ff543ef-f7c1-5af4-b11c-da6db40af722" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb24e06f-b9b1-5d89-ba4f-db1817a41a97" :answer-field/choices ["answer-8f2f93c0-6c57-56f3-a190-9a0cdd301723" "answer-bb24e06f-b9b1-5d89-ba4f-db1817a41a97" "answer-92def250-4bc5-5dc3-912c-b81178106d72" "answer-26830c29-2764-58cb-a64e-6ccf68e9b5b2" "answer-dfc5c902-1cf7-59f6-aff0-0fc57a3b65db"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f2f93c0-6c57-56f3-a190-9a0cdd301723" :answer/id #uuid "8f2f93c0-6c57-56f3-a190-9a0cdd301723" :answer/type :answer.type/math :answer/value "{13.2}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-bb24e06f-b9b1-5d89-ba4f-db1817a41a97" :answer/id #uuid "bb24e06f-b9b1-5d89-ba4f-db1817a41a97" :answer/type :answer.type/math :answer/value "{14.0}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-92def250-4bc5-5dc3-912c-b81178106d72" :answer/id #uuid "92def250-4bc5-5dc3-912c-b81178106d72" :answer/type :answer.type/math :answer/value "{14.6}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-26830c29-2764-58cb-a64e-6ccf68e9b5b2" :answer/id #uuid "26830c29-2764-58cb-a64e-6ccf68e9b5b2" :answer/type :answer.type/math :answer/value "{15.2}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-dfc5c902-1cf7-59f6-aff0-0fc57a3b65db" :answer/id #uuid "dfc5c902-1cf7-59f6-aff0-0fc57a3b65db" :answer/type :answer.type/math :answer/value "{17.0}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-3d28482b-a0c8-53e6-a980-b5acf56e83ea" :question/id #uuid "3d28482b-a0c8-53e6-a980-b5acf56e83ea" :question/math-academy-id "q-241885" :question/problem "If $\\operatorname{cos}⁡\\theta =0.64$ and $\\operatorname{tan}⁡\\alpha =1.25$, where $\\theta $ and $\\alpha $ are acute angles measured in degrees, then $\\theta +\\alpha $ in degrees to one decimal place is{{field-1}}${}^{∘}.$" :question/worked-solution "To find $\\theta $ and $\\alpha $ we use $arccos$ and $arctan$ respectively. We get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =0.64 \\\\ \\operatorname{arccos}⁡(\\operatorname{cos}⁡\\theta ) & =\\operatorname{arccos}⁡(0.64) \\\\ \\theta  & =\\operatorname{arccos}⁡(0.64)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\alpha  & =1.25 \\\\ \\operatorname{arctan}⁡(\\operatorname{tan}⁡\\alpha ) & =\\operatorname{arctan}⁡(1.25) \\\\ \\alpha  & =\\operatorname{arctan}⁡(1.25).\\end{aligned}\n$$\n\nThen, using a calculator, we find\n\n$$\n\\begin{aligned}\\theta +\\alpha  & =\\operatorname{arccos}⁡(0.64)+\\operatorname{arctan}⁡(1.25) \\\\  & =(50.208\\,1…)^{∘}+(51.340\\,1…)^{∘} \\\\  & =(101.548\\,2…)^{∘} \\\\  & ≈{101.5}^{∘}\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7e6971a9-86cf-535c-854c-c7408df6402f"] :db/ensure [:question/validate]} {:db/id "answer-field-7e6971a9-86cf-535c-854c-c7408df6402f" :answer-field/id #uuid "7e6971a9-86cf-535c-854c-c7408df6402f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-170b7b59-9320-58fb-b101-0feb53b6825e" :answer-field/choices ["answer-170b7b59-9320-58fb-b101-0feb53b6825e"] :db/ensure [:answer-field/validate]} {:db/id "answer-170b7b59-9320-58fb-b101-0feb53b6825e" :answer/id #uuid "170b7b59-9320-58fb-b101-0feb53b6825e" :answer/type :answer.type/math :answer/value "101.5" :db/ensure [:answer/validate]} {:db/id "question-63ad50c7-f590-525f-9856-7ab603587d0d" :question/id #uuid "63ad50c7-f590-525f-9856-7ab603587d0d" :question/math-academy-id "q-4546" :question/problem "![](images/40/404e9d30d45485251a19cdb2ccfef4ea53509a66437c99908eda065ad99e5e82.png)\n\nRounded to one decimal place, $x≈$" :question/worked-solution "Since we are given the lengths of the opposite side and the hypotenuse, we can use sine to find the angle measurement. We have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{6}{13}.\\end{aligned}\n$$\n\nWe now calculate $x$ using inverse sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =\\frac{6}{13} \\\\ \\operatorname{arcsin}⁡(\\operatorname{sin}⁡x) & =\\operatorname{arcsin}⁡(\\frac{6}{13}) \\\\ x & =\\operatorname{arcsin}⁡(\\frac{6}{13}) \\\\ x & =(27.486\\,4…)^{∘} \\\\ x & ≈{27.5}^{∘}\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-03c2a9e1-24c8-5afe-a713-5a7daad4ef0f"] :db/ensure [:question/validate]} {:db/id "answer-field-03c2a9e1-24c8-5afe-a713-5a7daad4ef0f" :answer-field/id #uuid "03c2a9e1-24c8-5afe-a713-5a7daad4ef0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5d891148-a3a7-5819-a73c-eeda3eab70c5" :answer-field/choices ["answer-351eb816-1272-52d2-90b9-bfc766cd81a4" "answer-5d891148-a3a7-5819-a73c-eeda3eab70c5" "answer-d7b32859-f535-52b8-b810-054604e1f38b" "answer-d1176aad-386c-5cb7-8300-8d79fa09268e" "answer-12483b7c-75aa-5d6b-b9c2-3a38b6a59e7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-351eb816-1272-52d2-90b9-bfc766cd81a4" :answer/id #uuid "351eb816-1272-52d2-90b9-bfc766cd81a4" :answer/type :answer.type/math :answer/value "{24.6}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-5d891148-a3a7-5819-a73c-eeda3eab70c5" :answer/id #uuid "5d891148-a3a7-5819-a73c-eeda3eab70c5" :answer/type :answer.type/math :answer/value "{27.5}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d7b32859-f535-52b8-b810-054604e1f38b" :answer/id #uuid "d7b32859-f535-52b8-b810-054604e1f38b" :answer/type :answer.type/math :answer/value "{30.2}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d1176aad-386c-5cb7-8300-8d79fa09268e" :answer/id #uuid "d1176aad-386c-5cb7-8300-8d79fa09268e" :answer/type :answer.type/math :answer/value "{30.5}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-12483b7c-75aa-5d6b-b9c2-3a38b6a59e7e" :answer/id #uuid "12483b7c-75aa-5d6b-b9c2-3a38b6a59e7e" :answer/type :answer.type/math :answer/value "{32.8}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-a9231519-804c-5398-8af6-73a4e2d373bf" :question/id #uuid "a9231519-804c-5398-8af6-73a4e2d373bf" :question/math-academy-id "q-4743" :question/problem "![](images/61/61dc032461e469146f11eacac4f917e86d40b3078dc2d33ac89e8e0b31eefd48.png)\n\nRounded to one decimal place, $x≈$" :question/worked-solution "Since we are given the lengths of the adjacent side and the hypotenuse, we can use cosine to find the angle measurement. We have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{10}{27}.\\end{aligned}\n$$\n\nWe now calculate $x$ using inverse cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =\\frac{10}{27} \\\\ \\operatorname{arccos}⁡(\\operatorname{cos}⁡x) & =\\operatorname{arccos}⁡(\\frac{10}{27}) \\\\ x & =\\operatorname{arccos}⁡(\\frac{10}{27}) \\\\ x & =(68.261\\,5…)^{∘} \\\\ x & ≈{68.3}^{∘}\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-183e2a0a-fbdb-53c6-baa6-7dc46eb5ab7e"] :db/ensure [:question/validate]} {:db/id "answer-field-183e2a0a-fbdb-53c6-baa6-7dc46eb5ab7e" :answer-field/id #uuid "183e2a0a-fbdb-53c6-baa6-7dc46eb5ab7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6081e871-d742-538d-8c66-3f9650b689ce" :answer-field/choices ["answer-ce0335af-9d97-523b-9116-2d597fe88f70" "answer-ee4c62da-63ab-593f-8dfe-728e7ea4a176" "answer-74962891-b2f9-59ae-a10f-151fcb5564ed" "answer-6081e871-d742-538d-8c66-3f9650b689ce" "answer-d954596e-a926-5218-a588-5616b9c7a0fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce0335af-9d97-523b-9116-2d597fe88f70" :answer/id #uuid "ce0335af-9d97-523b-9116-2d597fe88f70" :answer/type :answer.type/math :answer/value "{37.4}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-ee4c62da-63ab-593f-8dfe-728e7ea4a176" :answer/id #uuid "ee4c62da-63ab-593f-8dfe-728e7ea4a176" :answer/type :answer.type/math :answer/value "{46.3}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-74962891-b2f9-59ae-a10f-151fcb5564ed" :answer/id #uuid "74962891-b2f9-59ae-a10f-151fcb5564ed" :answer/type :answer.type/math :answer/value "{59.1}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-6081e871-d742-538d-8c66-3f9650b689ce" :answer/id #uuid "6081e871-d742-538d-8c66-3f9650b689ce" :answer/type :answer.type/math :answer/value "{68.3}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d954596e-a926-5218-a588-5616b9c7a0fb" :answer/id #uuid "d954596e-a926-5218-a588-5616b9c7a0fb" :answer/type :answer.type/math :answer/value "{88.1}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186079640 :tutorial/content "Using a calculator, we can evaluate the sine of the angle ![](images/17/17aa8e3ab57c18aa2d1a6d04653701085d3beec29c4805e9d6e18c22d586e466.svg) and get \n![](images/5c/5c5e85144e6e1aab226ee174adbb30a7edbe80bb9f8a5770d6205e81a4f6cc77.svg)\n\nBut what if we are given the value ![](images/6a/6a2e70809b6bc7130f042930e4e9a611ffafbf828c38d967ee5cf48d04d3ba72.svg) and we want to find the angle whose sine is this value? To do this, we can use the **inverse trigonometric functions**.\n\nIn the case of the sine, its inverse is **arcsine** (written as ![](images/19/1938ea6d9f1fa40ed0d039861e7c701e9ba3127c806c5a8eb7c1000b8ec5f941.svg) or ![](images/12/12f3b6602187e07917c7d4a7824afcd5a426c276a0065a780e6bc3bc84dd7411.svg)). If we apply arcsine to a sine value, it gives the corresponding angle:\n![](images/a5/a531b557f0d9668cbd2c5a55fdfcca2173e29faf4c7ed4a96bcc8ce76d8f23ce.svg)\n\nThe inverses of the other trigonometric functions work in the same way.\n\n- The inverse of sine is ![](images/39/39a3c758b61a3886b6945c0f29328934ad207c74ba713ef10770352ebbe69f32.svg)\n\n- The inverse of cosine is ![](images/9b/9b8a569b724129728610b4bd7ba28966ea13c064d08000075312f294724f4e45.svg)\n\n- The inverse of tangent is ![](images/a1/a111203310c10fdfa70deb7b5e7a2b1f6658310e4d13140ad84369beeaf46b19.svg)\n\nTry it for yourself. But make sure that your calculator is in \"degrees\" mode!\n\n**Note:** In this topic, we only deal with acute angles. Things get a little more complicated for non-acute angles, but you'll learn about that later!" :db/ensure [:tutorial/validate]} {:db/id 17592186079648 :tutorial/content "If we have a trigonometric equation like\n\n$$\n\\cos \\theta = \\dfrac{1}{2}\n$$\n\nand we want to solve for $\\theta,$ we can apply the corresponding inverse trigonometric function to both sides of the equation to \"cancel\" out the trigonometric function.\n\nHere, the trigonometric function is $\\cos,$ so the inverse trigonometric function is $\\arccos,$ and we have\n\n$$\n\\begin{aligned}\\operatorname{arccos}⁡(\\operatorname{cos}⁡\\theta ) & =\\operatorname{arccos}⁡(\\frac{1}{2}) \\\\ \\theta  & ={60}^{∘}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186079641 :tutorial/content "The inverse trigonometric functions are particularly useful when we need to find the measure of an angle in a right triangle.\n\nTo demonstrate, let's find the measure of the angle $\\theta$ indicated in the triangle below.\n\n \n\n![](images/85/85c384f5cbfc9d9bfa4ffebeafc3dbe66eb756e71f4790b0d9566ebdab559f9c.png)\n\nSince we are given the length of the hypotenuse and opposite sides to $\\theta,$ we can use sine to find the angle measurement. We have\n\n$$\n\\eqalign{\n\t\t\\sin (\\theta) =  \\dfrac{\\textrm{opposite}}{\\textrm{hypotenuse}}  &= \\dfrac{5}{7}.\n\t}\n$$\n\nWe now calculate $\\theta$ using the inverse sine:\n\n$$\n\\eqalign{\n\t\t\\sin (\\theta)   &= \\dfrac{5}{7}\\[5pt]\n\t\t\\arcsin( \\sin (\\theta)) &= \\arcsin\\left(\\dfrac{5}{7} \\right)\\[5pt]\n\t\t\\theta &= \\arcsin\\left(\\dfrac{5}{7} \\right)\\[5pt]\n&=(45.584\\,6...)^\\circ \\[5pt]\n\t\t&\\approx 46^\\circ\n\t}\n$$\n\nrounded to the nearest integer." :db/ensure [:tutorial/validate]} {:db/id 17592186078640 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186062419 :answer-field/choices 17592186062420] [:db/retract 17592186062419 :answer-field/choices 17592186062421] [:db/retract 17592186062419 :answer-field/choices 17592186062422] [:db/retract 17592186062419 :answer-field/choices 17592186062423] [:db/retract 17592186062419 :answer-field/choices 17592186062424] {:db/id 17592186064384 :knowledge-point/questions ["question-28170d6f-d1bf-54a6-9dab-69ada5f8b07e" "question-8cb404ed-6af7-5b0d-8507-6193eb5d4f21" "question-0f5cbdde-4826-5bb5-88c4-7a602876e76a" "question-2f7c2967-af65-5004-9025-62af739a76dd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064028 :question/problem "An $8\\,\\text{m}$ tall lamppost is casting a shadow of a $2\\,\\text{m}$ man onto the ground. The man walks away from the lamppost with a speed of $2.4\\,\\text{m/s}.$ How fast is the length of the man's shadow changing?" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/29/29ef832326fff9e5b274c92ae51f2f32a88d463980fd4c109773086c344a76bb.png)\n\nIn the figure, $x$ is the man's distance from the lamp, while $y$ is the length of his shadow. Both $x$ and $y$ change with time. In particular, we know that the man's velocity is\n\n$$\n\\dfrac{\\textrm{d}x}{\\textrm{d}t} = 2.4\\,\\textrm{m/s}.\n$$\n\nNotice that the man's velocity is *positive* because he is walking away from the lamp, and therefore, the distance between him and the lamp *increases* with time.\n\nSince we want to calculate $\\dfrac{\\textrm{d}y}{\\textrm{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{8} & =\\frac{y}{2} \\\\ 2x+2y & =8y \\\\ 2x & =6y \\\\ y & =\\frac{1}{3}x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}x) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\dfrac{\\textrm{d}x}{\\textrm{d}t} =2.4\\,\\textrm{m/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{1}{3}\\cdot (2.4) \\\\  & =\\frac{2.4}{3} \\\\  & =0.8\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, the length of the man's shadow increases at a rate of $0.8\\,\\textrm{m/s}.$" :db/ensure [:question/validate]} {:db/id 17592186064292 :knowledge-point/questions ["question-21055998-26d2-5a03-b3c0-e38582a8d839" "question-53b5eaef-0c6b-5313-b037-03a8dbcbc92d" "question-91d63402-0442-54f2-9dc3-353df5f34caa" "question-02ba8f64-b770-56fd-871d-5b790d9828ac" "question-98780b5d-6c50-5c2a-867a-a1e2a96de8f6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064135 :question/problem "A $6\\,\\text{m}$ tall street lamp is casting a shadow of a $1.5\\,\\text{m}$ woman onto the ground. The woman is walking towards the lamppost with a speed of $1.5\\,\\text{m/s}.$ How fast is the length of the woman's shadow decreasing?" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/0b/0bdd4280035b896f113e8d7a27599e488958dae40235faad1658e85710465211.png)\n\nIn the figure, $x$ is the woman's distance from the lamp, while $y$ is the length of her shadow. Both $x$ and $y$ change with time. In particular, we know that the woman's velocity is\n\n$$\n\\dfrac{\\textrm{d}x}{\\textrm{d}t} = -1.5\\,\\textrm{m/s}.\n$$\n\nNotice that the woman's velocity is *negative* because she is walking *toward* the lamp, and therefore the distance between her and the lamp *decreases* with time.\n\nSince we want to calculate $\\dfrac{\\textrm{d}y}{\\textrm{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{6} & =\\frac{y}{1.5} \\\\ 1.5x+1.5y & =6y \\\\ 1.5x & =4.5y \\\\ y & =\\frac{1}{3}x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}x) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{1}{3}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\dfrac{\\textrm{d}x}{\\textrm{d}t} = -1.5\\,\\textrm{m/s}$ into the above gives\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}t} = \\dfrac13 \\cdot (-1.5) = -0.5\\,\\textrm{m/s}.\n$$\n\nTherefore, the length of the woman's shadow is decreasing at $0.5\\,\\textrm{m/s}.$" :db/ensure [:question/validate]} {:db/id 17592186064727 :question/problem "A $60\\,\\text{in}$ tall runner is training at night in a park. While running past a lamppost that is $100\\,\\text{in}$ tall, she notices her shadow is growing. Her watch tells her that she is travelling at $50\\,\\text{in/s}.$ How fast is the length of her shadow changing while she runs away from the lamppost?" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/4e/4ef1ba4975846a5375a18dee6cb4a55ba84d22d7c98b19eeaeebbb6b0017b623.png)\n\nIn the figure, $x$ is the runner's distance from the lamp, while $y$ is the length of her shadow. Both $x$ and $y$ change with time. In particular, we know that the person's velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=50\\,\\text{in/s}.\n$$\n\nNotice that the runner's velocity is positive because she is running away from the lamppost, and therefore, the distance between the runner and the lamp increases with time.\n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{100} & =\\frac{y}{60} \\\\ 60x+60y & =100y \\\\ 60x & =40y \\\\ y & =\\frac{3}{2}x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{2}x) \\\\  & =\\frac{3}{2}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}x}{\\text{d}t}=50\\,\\text{in/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{3}{2}\\cdot (50) \\\\  & =\\frac{150}{2} \\\\  & =75\\,\\text{in/s}.\\end{aligned}\n$$\n\nTherefore, the length of the runner's shadow increases at $75\\,\\text{in/s}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186062419 :answer-field/correct "answer-fecd5d50-1fec-5772-8841-508e263e498f" :answer-field/choices ["answer-2681d8a2-6bbd-5d1d-af53-63f3d9de1132" "answer-9378057a-2722-5968-9412-eb4384b8c99f" "answer-814887dc-bf0f-5579-9b42-073ee2d25f55" "answer-cc4e2a3a-3385-517d-aab2-26922f27d1a7" "answer-fecd5d50-1fec-5772-8841-508e263e498f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2681d8a2-6bbd-5d1d-af53-63f3d9de1132" :answer/id #uuid "2681d8a2-6bbd-5d1d-af53-63f3d9de1132" :answer/type :answer.type/math :answer/value "125\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-9378057a-2722-5968-9412-eb4384b8c99f" :answer/id #uuid "9378057a-2722-5968-9412-eb4384b8c99f" :answer/type :answer.type/math :answer/value "150\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-814887dc-bf0f-5579-9b42-073ee2d25f55" :answer/id #uuid "814887dc-bf0f-5579-9b42-073ee2d25f55" :answer/type :answer.type/math :answer/value "50\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-cc4e2a3a-3385-517d-aab2-26922f27d1a7" :answer/id #uuid "cc4e2a3a-3385-517d-aab2-26922f27d1a7" :answer/type :answer.type/math :answer/value "60\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-fecd5d50-1fec-5772-8841-508e263e498f" :answer/id #uuid "fecd5d50-1fec-5772-8841-508e263e498f" :answer/type :answer.type/math :answer/value "75\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "question-28170d6f-d1bf-54a6-9dab-69ada5f8b07e" :question/id #uuid "28170d6f-d1bf-54a6-9dab-69ada5f8b07e" :question/math-academy-id "q-118674" :question/problem "A bus is traveling at night at $50\\,\\text{km/h}.$  After running past a $6.25\\,\\text{m}$ tall lamppost, the bus driver notices that the shadow of the bus is growing. \nIf the height of the bus is $3.75\\,m,$ how fast is the length of the shadow growing while it travels away from the lamp?" :question/worked-solution "Let's draw a figure according to the given data. \n\n![](images/10/1094154aa39b3d9f1206d23ca920d5717a7f344c4a9486e9c4604752cf0ce623.png)\n\nIn the figure, $x$ is the bus' distance from the lamp, while $y$ is the length of the shadow. Both $x$ and $y$ change with time. In particular, we know that the runner's velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=50\\,\\text{km/h}.\n$$\n\nNotice that the bus's velocity is *positive* because it is moving *away* from the lamppost, and therefore, the distance between the bus and the lamp *increases* with time.\n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{6.25} & =\\frac{y}{3.75} \\\\ 3.75x+3.75y & =6.25y \\\\ 3.75x & =2.5y \\\\ y & =1.5x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =1.5\\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}x}{\\text{d}t}=50\\,\\text{km/h}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =75\\,\\text{km/h}.\\end{aligned}\n$$\n\nTherefore, the length of the bus' shadow increases at $75\\,\\text{km/h}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a7359e1c-94ec-5bfa-8fe5-9267e633fd0c"] :db/ensure [:question/validate]} {:db/id "answer-field-a7359e1c-94ec-5bfa-8fe5-9267e633fd0c" :answer-field/id #uuid "a7359e1c-94ec-5bfa-8fe5-9267e633fd0c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d4b36bf1-06bf-576b-bb3f-12c4605e9e47" :answer-field/choices ["answer-79e79f28-e54f-5568-95d8-b58e116ac263" "answer-3dd2dc90-cad4-5638-8a72-65fe17c4461f" "answer-e39d3a69-30b3-5410-b26b-3b296c69af9f" "answer-2ed3bf0f-a01b-541c-b8ee-63a118a81984" "answer-d4b36bf1-06bf-576b-bb3f-12c4605e9e47"] :db/ensure [:answer-field/validate]} {:db/id "answer-79e79f28-e54f-5568-95d8-b58e116ac263" :answer/id #uuid "79e79f28-e54f-5568-95d8-b58e116ac263" :answer/type :answer.type/math :answer/value "25\\,\\text{km/h}" :db/ensure [:answer/validate]} {:db/id "answer-3dd2dc90-cad4-5638-8a72-65fe17c4461f" :answer/id #uuid "3dd2dc90-cad4-5638-8a72-65fe17c4461f" :answer/type :answer.type/math :answer/value "33\\,\\text{km/h}" :db/ensure [:answer/validate]} {:db/id "answer-e39d3a69-30b3-5410-b26b-3b296c69af9f" :answer/id #uuid "e39d3a69-30b3-5410-b26b-3b296c69af9f" :answer/type :answer.type/math :answer/value "65\\,\\text{km/h}" :db/ensure [:answer/validate]} {:db/id "answer-2ed3bf0f-a01b-541c-b8ee-63a118a81984" :answer/id #uuid "2ed3bf0f-a01b-541c-b8ee-63a118a81984" :answer/type :answer.type/math :answer/value "72\\,\\text{km/h}" :db/ensure [:answer/validate]} {:db/id "answer-d4b36bf1-06bf-576b-bb3f-12c4605e9e47" :answer/id #uuid "d4b36bf1-06bf-576b-bb3f-12c4605e9e47" :answer/type :answer.type/math :answer/value "75\\,\\text{km/h}" :db/ensure [:answer/validate]} {:db/id "question-8cb404ed-6af7-5b0d-8507-6193eb5d4f21" :question/id #uuid "8cb404ed-6af7-5b0d-8507-6193eb5d4f21" :question/math-academy-id "q-115973" :question/problem "A child on a scooter is running away from a $345\\,\\text{cm}$ tall lamppost at $4.5\\,\\text{m/s}.$ The height of the child on the scooter is $96.6\\,cm.$\nHow fast is the length of the child's shadow changing?" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/fe/fefe072c51da577b504d81ccd1bb3546e77bca9bf9885950ca0c0c2091f9d335.png)\n\nIn the figure, $x$ is the child's distance from the lamppost, while $y$ is the length of his shadow. Both $x$ and $y$ change with time. In particular, we know that the child's velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=4.5\\,\\text{m/s}.\n$$\n\nNotice that the child's velocity is *positive* because he is running *away* from the lamppost, and therefore, the distance between the child and the lamppost *increases* with time.\n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{345} & =\\frac{y}{96.6} \\\\ 96.6x+96.6y & =345y \\\\ 96.6x & =248.4y \\\\ y & =\\frac{966}{2484}x \\\\ y & =\\frac{7}{18}x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{7}{18}x) \\\\  & =\\frac{7}{18}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}x}{\\text{d}t}=4.5\\,\\text{m/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{7}{18}\\cdot (4.5) \\\\  & =1.75\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, the length of the child's shadow increases at approximately $1.75\\,\\text{m/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5ac48d99-1070-55c4-a6a8-9b39da55141b"] :db/ensure [:question/validate]} {:db/id "answer-field-5ac48d99-1070-55c4-a6a8-9b39da55141b" :answer-field/id #uuid "5ac48d99-1070-55c4-a6a8-9b39da55141b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0870faae-d3eb-5155-8021-e531dbbd3c2b" :answer-field/choices ["answer-86ac4c6a-129c-59b0-85ac-975897dfd995" "answer-57ad84bd-7f76-5f14-a371-5fcb1e34b4a9" "answer-0870faae-d3eb-5155-8021-e531dbbd3c2b" "answer-0757798a-d35e-53fe-88b3-ace0b231d134" "answer-e0f3f234-42e4-5382-ac86-4b1e4fa9e6cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-86ac4c6a-129c-59b0-85ac-975897dfd995" :answer/id #uuid "86ac4c6a-129c-59b0-85ac-975897dfd995" :answer/type :answer.type/math :answer/value "1.25\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-57ad84bd-7f76-5f14-a371-5fcb1e34b4a9" :answer/id #uuid "57ad84bd-7f76-5f14-a371-5fcb1e34b4a9" :answer/type :answer.type/math :answer/value "1.5\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-0870faae-d3eb-5155-8021-e531dbbd3c2b" :answer/id #uuid "0870faae-d3eb-5155-8021-e531dbbd3c2b" :answer/type :answer.type/math :answer/value "1.75\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-0757798a-d35e-53fe-88b3-ace0b231d134" :answer/id #uuid "0757798a-d35e-53fe-88b3-ace0b231d134" :answer/type :answer.type/math :answer/value "2.2\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-e0f3f234-42e4-5382-ac86-4b1e4fa9e6cd" :answer/id #uuid "e0f3f234-42e4-5382-ac86-4b1e4fa9e6cd" :answer/type :answer.type/math :answer/value "2.5\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "question-0f5cbdde-4826-5bb5-88c4-7a602876e76a" :question/id #uuid "0f5cbdde-4826-5bb5-88c4-7a602876e76a" :question/math-academy-id "q-344484" :question/problem "The members of a robotics club are testing a small robot in a courtyard lit by only one large lamp post.  Sam, a $1.4\\,\\text{m}$ student, is walking away from the post, and his shadow is increasing at a rate of $0.8\\,\\text{m/s}.$ If the lamp post is $7\\,\\text{m}$ taller than  Sam, how fast is  Sam walking away from the post?\n\nSam's velocity is\n{{field-1}} $\\text{m/s}.$" :question/worked-solution "Since we are given that the lamp post is $7\\,\\text{m}$ taller than Sam, the height of the post is $7+1.4=8.4\\,\\text{m}.$\n\nLet's draw a figure according to the given data.\n\n![](images/1c/1c17902179842d470f95519599235a9998e4cfbe538a44c201e34c3627c493af.png)\n\nIn the figure, $x$ is Sam's distance from the lamp post, while $y$ is the length of his shadow. Both $x$ and $y$ change with time. In particular, we know that the length of Sam's shadow changes at the rate\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}=0.8\\,\\text{m/s}.\n$$\n\nNotice that the rate of change of the length of Sam's shadow is *positive* because he is walking away from the lamp post, and therefore, the length of the shadow *increases* with time.\n\nSince we want to calculate $\\frac{\\text{d}x}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{8.4} & =\\frac{y}{1.4} \\\\ 1.4x+1.4y & =8.4y \\\\ 1.4x & =7y \\\\ x & =5y.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(5y) \\\\  & =5\\cdot \\frac{\\text{d}y}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}y}{\\text{d}t}=0.8\\,\\text{m/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =5\\cdot (0.8) \\\\  & =4\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, Sam's velocity is $4\\,\\text{m/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d6c7671a-533d-5202-b5e2-063b234bf23e"] :db/ensure [:question/validate]} {:db/id "answer-field-d6c7671a-533d-5202-b5e2-063b234bf23e" :answer-field/id #uuid "d6c7671a-533d-5202-b5e2-063b234bf23e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2484da21-5755-5bab-8027-716d1b529937" :answer-field/choices ["answer-2484da21-5755-5bab-8027-716d1b529937"] :db/ensure [:answer-field/validate]} {:db/id "answer-2484da21-5755-5bab-8027-716d1b529937" :answer/id #uuid "2484da21-5755-5bab-8027-716d1b529937" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-2f7c2967-af65-5004-9025-62af739a76dd" :question/id #uuid "2f7c2967-af65-5004-9025-62af739a76dd" :question/math-academy-id "q-344428" :question/problem "A $1.5\\,\\text{m}$ tall student is jogging away from a $4.0\\,\\text{m}$ parking lot light at $2.4\\,\\text{m/s}.$ To **one decimal place**, how fast is the length of the student’s shadow changing?\n\nThe length of the student’s shadow increases at approximately\n{{field-1}} $\\text{m/s}.$" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/e5/e500e84e039b0f8bef6afc7e636d6142309d65f13017c1f817fdf159b3f4d77c.png)\n\nIn the figure, $x$ is the student’s distance from the parking lot light, while $y$ is the length of their shadow. Both $x$ and $y$ change with time. In particular, we know that the student’s velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=2.4\\,\\text{m/s}.\n$$\n\nNotice that the student’s velocity is *positive* because they are jogging *away* from the parking lot light, and therefore, the distance between the student and the light *increases* with time. \n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{4.0} & =\\frac{y}{1.5} \\\\ 1.5x+1.5y & =4.0y \\\\ 1.5x & =2.5y \\\\ y & =\\frac{1.5}{2.5}x \\\\ y & =\\frac{15}{25}\\,x \\\\ y & =\\frac{3}{5}\\,x.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{5}x) \\\\  & =\\frac{3}{5}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}x}{\\text{d}t}=2.4\\,\\text{m/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{3}{5}\\cdot (2.4) \\\\  & ≈1.4\\,\\text{m/s}\\end{aligned}\n$$\n\nrounded to one decimal place.\n\nTherefore, the length of the student’s shadow increases at approximately $1.4\\,\\text{m/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a51abb1a-dee0-5315-ba3a-f76763530a44"] :db/ensure [:question/validate]} {:db/id "answer-field-a51abb1a-dee0-5315-ba3a-f76763530a44" :answer-field/id #uuid "a51abb1a-dee0-5315-ba3a-f76763530a44" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e467d058-53f5-502f-93d5-68a99ee8bddf" :answer-field/choices ["answer-e467d058-53f5-502f-93d5-68a99ee8bddf"] :db/ensure [:answer-field/validate]} {:db/id "answer-e467d058-53f5-502f-93d5-68a99ee8bddf" :answer/id #uuid "e467d058-53f5-502f-93d5-68a99ee8bddf" :answer/type :answer.type/math :answer/value "1.4" :db/ensure [:answer/validate]} {:db/id "question-21055998-26d2-5a03-b3c0-e38582a8d839" :question/id #uuid "21055998-26d2-5a03-b3c0-e38582a8d839" :question/math-academy-id "q-30330" :question/problem "Harry shines a flashlight on a $10\\,\\text{in}$ tall cat approaching him. If he is holding the flashlight $30\\,\\text{in}$ above the ground and the animal's shadow is changing at a rate of $11\\,\\text{in/s},$ how fast is the cat approaching Harry?" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/02/021a84ea0ad36014569028c0ffb39ab9b30f9225cf4bfcccba2d60050754a6f9.png)\n\nIn the figure, $x$ is the distance between Harry and the cat, while $y$ is the length of the cat's shadow. Both $x$ and $y$ change with time. In particular, we know that the velocity of the cat's shadow\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}=-11\\,\\text{in/s}.\n$$\n\nNotice that the velocity of the cat's shadow is *negative* because the cat is walking *toward* Harry, and therefore the distance between Harry and the cat *decreases* with time.\n\nSince we want to calculate $\\frac{\\text{d}x}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{30} & =\\frac{y}{10} \\\\ 10x+10y & =30y \\\\ 10x & =20y \\\\ x & =2y.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(2y) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =2\\cdot \\frac{\\text{d}y}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}y}{\\text{d}t}=-11\\,\\text{in/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =2(-11)=-22\\,\\text{in/s}.\\end{aligned}\n$$\n\nTherefore, the speed of the cat is $22\\,\\text{in/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-240120c2-1821-54c3-9f09-fa9019bdaf10"] :db/ensure [:question/validate]} {:db/id "answer-field-240120c2-1821-54c3-9f09-fa9019bdaf10" :answer-field/id #uuid "240120c2-1821-54c3-9f09-fa9019bdaf10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f7997f4a-8d5d-54c8-9130-3c024f1af16f" :answer-field/choices ["answer-49d53056-7e04-552a-97a2-f96f42bb83e9" "answer-7a3e823b-91e3-51e8-a0cb-926a35e57614" "answer-bb75f8de-5e82-53f3-8bbc-2a15c7126525" "answer-f7997f4a-8d5d-54c8-9130-3c024f1af16f" "answer-e4c78d28-2aa8-591d-95ff-19750406894f"] :db/ensure [:answer-field/validate]} {:db/id "answer-49d53056-7e04-552a-97a2-f96f42bb83e9" :answer/id #uuid "49d53056-7e04-552a-97a2-f96f42bb83e9" :answer/type :answer.type/math :answer/value "15\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-7a3e823b-91e3-51e8-a0cb-926a35e57614" :answer/id #uuid "7a3e823b-91e3-51e8-a0cb-926a35e57614" :answer/type :answer.type/math :answer/value "17\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-bb75f8de-5e82-53f3-8bbc-2a15c7126525" :answer/id #uuid "bb75f8de-5e82-53f3-8bbc-2a15c7126525" :answer/type :answer.type/math :answer/value "18\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-f7997f4a-8d5d-54c8-9130-3c024f1af16f" :answer/id #uuid "f7997f4a-8d5d-54c8-9130-3c024f1af16f" :answer/type :answer.type/math :answer/value "22\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-e4c78d28-2aa8-591d-95ff-19750406894f" :answer/id #uuid "e4c78d28-2aa8-591d-95ff-19750406894f" :answer/type :answer.type/math :answer/value "25\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "question-53b5eaef-0c6b-5313-b037-03a8dbcbc92d" :question/id #uuid "53b5eaef-0c6b-5313-b037-03a8dbcbc92d" :question/math-academy-id "q-313985" :question/problem "A spotlight $S$ is on the ground $6\\,\\text{m}$ away from a wall and a $1.5\\,\\text{m}$ tall robot is moving towards the wall at a rate of $0.6\\,\\text{m/s}.$ To **one decimal place**, how fast is the height of the shadow on the wall decreasing when the robot is $2.5\\,\\text{m}$ from the spotlight?\n\nThe shadow decreases at a speed of approximately \n\n{{field-1}} $\\text{m/s}.$" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/e9/e91c4e08aa785de1fe500c2f43e0981501ee597bb7bb042827154842ec06ad0c.png)\n\nIn the figure, $x$ is the robot’s distance from the wall, while $y$ is the length of the shadow. Both $x$ and $y$ change with time. In particular, we know that the robot’s velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=-0.6\\,\\text{m/s}.\n$$\n\nNotice that the robot’s velocity is *negative* because it is moving *toward* the wall, and therefore the distance between it and the wall *decreases* with time.\n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{y}{(6-x)+x} & =\\frac{1.5}{6-x} \\\\ \\frac{y}{6} & =\\frac{1.5}{6-x} \\\\ y & =\\frac{9}{6-x}.\\end{aligned}\n$$\n\nWe differentiate both sides with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{9}{6-x}) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{9}{(6-x)^{2}}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $x=6-2.5=3.5\\,\\text{m}$ and $\\frac{\\text{d}x}{\\text{d}t}=-0.6\\,\\text{m/s}$ into the above expression gives, to one decimal place\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{9}{{2.5}^{2}}\\cdot (-0.6) \\\\ \\frac{\\text{d}y}{\\text{d}t} & ≈-0.9\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, the shadow decreases at a speed of approximately  $0.9\\,\\text{m/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7afa75a5-ca2e-53b7-86f8-9f195e705814"] :db/ensure [:question/validate]} {:db/id "answer-field-7afa75a5-ca2e-53b7-86f8-9f195e705814" :answer-field/id #uuid "7afa75a5-ca2e-53b7-86f8-9f195e705814" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2b772459-363c-5a44-a11a-d79c4d0978f3" :answer-field/choices ["answer-2b772459-363c-5a44-a11a-d79c4d0978f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b772459-363c-5a44-a11a-d79c4d0978f3" :answer/id #uuid "2b772459-363c-5a44-a11a-d79c4d0978f3" :answer/type :answer.type/math :answer/value "0.9" :db/ensure [:answer/validate]} {:db/id "question-91d63402-0442-54f2-9dc3-353df5f34caa" :question/id #uuid "91d63402-0442-54f2-9dc3-353df5f34caa" :question/math-academy-id "q-344508" :question/problem "Ethan is walking toward a $360\\,\\text{in}$ light pole, which has a lamp on top. If Ethan's height is $72\\,\\text{in}$ and his shadow is changing at a rate of $6\\,\\text{in/s},$ how fast is he walking toward the light pole?\n\nEthan is moving at a speed of \n\n{{field-1}} $\\text{in/s}.$" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/4e/4e82a1365099bcf76ae91b75d0d1ad276e4c35f8b172fc60b4d22e9156128d7e.png)\n\nIn the figure, $x$ is the distance from Ethan to the light pole, while $y$ is the length of his shadow. Both $x$ and $y$ change with time. In particular, we know that Ethan's shadow's velocity is\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}=-6\\,\\text{in/s}.\n$$\n\nNotice that Ethan's shadow's velocity is *negative* because he is walking *toward* the light pole, and therefore the distance between him and the light pole *decreases* with time.\n\nSince we want to calculate $\\frac{\\text{d}x}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{360} & =\\frac{y}{72} \\\\ 72x+72y & =360y \\\\ 72x & =288y \\\\ x & =4y.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(4y) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =4\\cdot \\frac{\\text{d}y}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}y}{\\text{d}t}=-6\\,\\text{in/s}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =4(-6)=-24\\,\\text{in/s}.\\end{aligned}\n$$\n\nTherefore, Ethan's speed is  $24\\,\\text{in/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e4acc90d-32b0-5012-bd13-3bc586d538d5"] :db/ensure [:question/validate]} {:db/id "answer-field-e4acc90d-32b0-5012-bd13-3bc586d538d5" :answer-field/id #uuid "e4acc90d-32b0-5012-bd13-3bc586d538d5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-57960f1a-d541-53c1-b51f-0014873ffbb7" :answer-field/choices ["answer-57960f1a-d541-53c1-b51f-0014873ffbb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-57960f1a-d541-53c1-b51f-0014873ffbb7" :answer/id #uuid "57960f1a-d541-53c1-b51f-0014873ffbb7" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "question-02ba8f64-b770-56fd-871d-5b790d9828ac" :question/id #uuid "02ba8f64-b770-56fd-871d-5b790d9828ac" :question/math-academy-id "q-121321" :question/problem "A man on a boat is sailing towards a $247\\,\\text{ft}$ high lighthouse. If the height of the man above the sea is $10\\,\\text{ft},$ how fast is the man approaching the lighthouse if his shadow is shrinking at a rate of $0.25\\,\\text{mi/h}?$ Round your answer to one decimal place." :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/6c/6c85e0c34b34dd9dcb384bb601b9b87a1a6b7174888c9ad49d8c2cd37abc13de.png)\n\nIn the figure, $x$ is the distance from the man to the lighthouse, while $y$ is the length of his shadow. Both $x$ and $y$ change with time. In particular, we know that the man's shadow's velocity is\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}=-0.25\\,\\text{mi/h}.\n$$\n\nNotice that the man's shadow's velocity is *negative* because he is walking *toward* the lighthouse, and therefore the distance between him and the lighthouse *decreases* with time.\n\nSince we want to calculate $\\frac{\\text{d}x}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{x+y}{247} & =\\frac{y}{10} \\\\ 10x+10y & =247y \\\\ 10x & =237y \\\\ x & =23.7y.\\end{aligned}\n$$\n\nWe differentiate both sides of the above equation with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(23.7y) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =23.7\\cdot \\frac{\\text{d}y}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $\\frac{\\text{d}y}{\\text{d}t}=-0.25\\,\\text{mi/h}$ into the above gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =23.7(-0.25)≈-5.9\\,\\text{mi/h}\\end{aligned}\n$$\n\nto one decimal place.\n\nTherefore, the man's speed is approximately $5.9\\,\\text{mi/h}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7519ca12-0941-5f99-b046-39f8b4d54045"] :db/ensure [:question/validate]} {:db/id "answer-field-7519ca12-0941-5f99-b046-39f8b4d54045" :answer-field/id #uuid "7519ca12-0941-5f99-b046-39f8b4d54045" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b89a01a1-4797-5637-a4bc-f3f9761f223c" :answer-field/choices ["answer-11afe4da-eb76-532c-a5bf-992c42de281f" "answer-b89a01a1-4797-5637-a4bc-f3f9761f223c" "answer-3151adac-c8e6-5f77-89a0-dd3d2a1beeba" "answer-6c7a9d7a-9961-5fa1-8ab5-6bd292fc7647" "answer-65e05d29-0bf5-5ebe-b6df-85f73f9e8f66"] :db/ensure [:answer-field/validate]} {:db/id "answer-11afe4da-eb76-532c-a5bf-992c42de281f" :answer/id #uuid "11afe4da-eb76-532c-a5bf-992c42de281f" :answer/type :answer.type/math :answer/value "5.7\\,\\text{mi/h}" :db/ensure [:answer/validate]} {:db/id "answer-b89a01a1-4797-5637-a4bc-f3f9761f223c" :answer/id #uuid "b89a01a1-4797-5637-a4bc-f3f9761f223c" :answer/type :answer.type/math :answer/value "5.9\\,\\text{mi/h}" :db/ensure [:answer/validate]} {:db/id "answer-3151adac-c8e6-5f77-89a0-dd3d2a1beeba" :answer/id #uuid "3151adac-c8e6-5f77-89a0-dd3d2a1beeba" :answer/type :answer.type/math :answer/value "6.1\\,\\text{mi/h}" :db/ensure [:answer/validate]} {:db/id "answer-6c7a9d7a-9961-5fa1-8ab5-6bd292fc7647" :answer/id #uuid "6c7a9d7a-9961-5fa1-8ab5-6bd292fc7647" :answer/type :answer.type/math :answer/value "6.3\\,\\text{mi/h}" :db/ensure [:answer/validate]} {:db/id "answer-65e05d29-0bf5-5ebe-b6df-85f73f9e8f66" :answer/id #uuid "65e05d29-0bf5-5ebe-b6df-85f73f9e8f66" :answer/type :answer.type/math :answer/value "6.5\\,\\text{mi/h}" :db/ensure [:answer/validate]} {:db/id "question-98780b5d-6c50-5c2a-867a-a1e2a96de8f6" :question/id #uuid "98780b5d-6c50-5c2a-867a-a1e2a96de8f6" :question/math-academy-id "q-344494" :question/problem "A bright lantern $L$ is on the ground $18\\,\\text{ft}$ away from a wall and a $6\\,\\text{ft}$ tall actor is moving towards the wall at a rate of $3\\,\\text{ft/s}.$ To **one decimal place**, how fast is the height of the shadow on the wall decreasing when the actor is $8\\,\\text{ft}$ from the lantern?\n\nThe shadow decreases at a speed of approximately \n\n{{field-1}} $\\text{ft/s}.$" :question/worked-solution "Let's draw a figure according to the given data.\n\n![](images/0a/0a47e801db651c027415a7943e5327bd378c1a08e533dc69673ab4304c8cc7b4.png)\n\nIn the figure, $x$ is the actor’s distance from the wall, while $y$ is the length of the shadow. Both $x$ and $y$ change with time. In particular, we know that the actor’s velocity is\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=-3\\,\\text{ft/s}.\n$$\n\nNotice that the actor’s velocity is *negative* because it is moving *toward* the wall, and therefore the distance between it and the wall *decreases* with time.\n\nSince we want to calculate $\\frac{\\text{d}y}{\\text{d}t},$ we need to find a relation between $x$ and $y.$ Since the two triangles are similar, the ratios between the corresponding sides are equal, and we have\n\n$$\n\\begin{aligned}\\frac{y}{(18-x)+x} & =\\frac{6}{18-x} \\\\ \\frac{y}{18} & =\\frac{6}{18-x} \\\\ y & =\\frac{108}{18-x}.\\end{aligned}\n$$\n\nWe differentiate both sides with respect to $t$ using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{108}{18-x}) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{108}{(18-x)^{2}}\\cdot \\frac{\\text{d}x}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting $x=18-8=10\\,\\text{ft}$ and $\\frac{\\text{d}x}{\\text{d}t}=-3\\,\\text{ft/s}$ into the above expression gives, to one decimal place\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{108}{{8}^{2}}\\cdot (-3) \\\\ \\frac{\\text{d}y}{\\text{d}t} & ≈-5.1\\,\\text{ft/s}.\\end{aligned}\n$$\n\nTherefore, the shadow decreases at a speed of approximately  $5.1\\,\\text{ft/s}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d49bd1c4-d01f-5541-8a31-35843fff408d"] :db/ensure [:question/validate]} {:db/id "answer-field-d49bd1c4-d01f-5541-8a31-35843fff408d" :answer-field/id #uuid "d49bd1c4-d01f-5541-8a31-35843fff408d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7218284d-fc0a-5fae-8251-9a209394cdcd" :answer-field/choices ["answer-7218284d-fc0a-5fae-8251-9a209394cdcd"] :db/ensure [:answer-field/validate]} {:db/id "answer-7218284d-fc0a-5fae-8251-9a209394cdcd" :answer/id #uuid "7218284d-fc0a-5fae-8251-9a209394cdcd" :answer/type :answer.type/math :answer/value "5.1" :db/ensure [:answer/validate]} {:db/id 17592186065386 :tutorial/content "Suppose that Bob, who is ![](images/ae/ae1e193fbd577e9009d2601d3f65608af0827a16092c4046543cdb1ccddb9f74.svg) tall, stands in front of a ![](images/a7/a78087a5302fc6677b6ef30a50cfb0b170e3f51b10c25027c0427b938ad21148.svg) street light. How fast does the length of Bob's shadow change if he walks *away* from the street light with a speed of ![](images/0c/0cfc62307d856dbbed71500139ffd3427d49977f140a921ec2f53adb8804b61c.svg)\n\n![](images/0b/0b1f84cc2e31c1a7bdcf2663d8d82f4fecab7dfd12990041b2ba7fd0fe4174bf.png)\n\nWe can solve problems like this using three simple steps.\n\n**Step 1:** Draw a diagram and identify the variables that change with time.\n\n![](images/8d/8d80efb54f0c0f025eaec3cf02f4a1a40cb5a47f1dec4d40e1af63c8e4ac047f.png)\n\nIn the above diagram, we have denoted the following:\n\n- ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) is the distance between Bob and the street light\n\n- ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) is the length of Bob's shadow\n\nBoth ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) change with time as Bob walks away from the light. In particular, we're told that Bob's velocity is given by\n\n![](images/16/1608be1f575a84b2c86188a18b6a1eec623a97e1d4bf5534e092b8518ba5f837.svg)\n\nNotice that ![](images/63/632daac2c47092ffbca309417f73fd9d1a3385167c025ca07ca5a19c5632b294.svg) is positive. This is because the distance between Bob and the street light increases as Bob walks away from the light.\n\nOur goal is to calculate ![](images/89/89989044f19d9ed88641aeb7c0c0d0ce32aff15a2088eedbcc8944c9631ba3df.svg) \n\n** Step 2:** Write down an equation that relates ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/33/3337bbda5af4a3203ef0f6135b36de4f06c1915c4a3ff1bd5358326627c1eecd.svg)\n\nFrom our simplified diagram, we see that we have two right triangles that share a common angle. Therefore, they are similar by the AA (angle-angle) criterion for similar triangles. \n\nSince the two triangles are similar, the ratios between the corresponding sides are equal. So, we have\n\n![](images/0c/0c73e5832167c46e7cbe124decb8968c19212f433bdc307e7653af2298f88446.svg)\n\n** Step 3:** Differentiate with respect to time and plug in the known values.\n\nWe use the chain rule to differentiate the above equation with respect to time. This gives\n\n![](images/21/219666475eed9f3f69895ef00a6c843c54c5b40a16b04060b6e4f988373bf694.svg) \n\nFinally, substituting the known value of ![](images/63/632daac2c47092ffbca309417f73fd9d1a3385167c025ca07ca5a19c5632b294.svg) gives\n\n![](images/85/858a9792dd0056bec55459ba9071aee83964102be336cc2fe797ab59f08253be.svg)\n\nTherefore, the length of Bob's shadow increases at a rate of ![](images/94/94cc677a1f2f2b5f1ee25d1290d932b6404e2b840e536c603eb373cc509857c1.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186064453 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id "activity-35359baf-e17b-5fa9-b523-ce56f1275bdd" :activity/id #uuid "35359baf-e17b-5fa9-b523-ce56f1275bdd" :activity/title "The Derivative of a Multivariable Function" :activity/type :activity.type/review :activity/scope 17592186049962 :activity/course 17592186046658 :activity/steps ["step-f1c2b0c6-b9fc-5150-94db-ebfecaf8e168" "step-0a2c83e4-ab25-57ae-8fa0-093c7c02ee67" "step-92478ad8-e0b4-5b4f-870d-84971f3368a2" "step-10ea3773-466b-5163-9e1a-1748572301f1" "step-3a0a2e73-b200-5b81-a51b-23a65df802a3"] :activity/first-step "step-f1c2b0c6-b9fc-5150-94db-ebfecaf8e168" :db/ensure [:activity/validate]} {:db/id "step-f1c2b0c6-b9fc-5150-94db-ebfecaf8e168" :step/id #uuid "f1c2b0c6-b9fc-5150-94db-ebfecaf8e168" :step/content 17592186281584 :step/next "step-0a2c83e4-ab25-57ae-8fa0-093c7c02ee67" :db/ensure [:step/validate]} {:db/id "step-0a2c83e4-ab25-57ae-8fa0-093c7c02ee67" :step/id #uuid "0a2c83e4-ab25-57ae-8fa0-093c7c02ee67" :step/content 17592186281589 :step/next "step-92478ad8-e0b4-5b4f-870d-84971f3368a2" :db/ensure [:step/validate]} {:db/id "step-92478ad8-e0b4-5b4f-870d-84971f3368a2" :step/id #uuid "92478ad8-e0b4-5b4f-870d-84971f3368a2" :step/content 17592186281600 :step/next "step-10ea3773-466b-5163-9e1a-1748572301f1" :db/ensure [:step/validate]} {:db/id "step-10ea3773-466b-5163-9e1a-1748572301f1" :step/id #uuid "10ea3773-466b-5163-9e1a-1748572301f1" :step/content 17592186281605 :step/next "step-3a0a2e73-b200-5b81-a51b-23a65df802a3" :db/ensure [:step/validate]} {:db/id "step-3a0a2e73-b200-5b81-a51b-23a65df802a3" :step/id #uuid "3a0a2e73-b200-5b81-a51b-23a65df802a3" :step/content 17592186281617 :db/ensure [:step/validate]} {:db/id 17592186129205 :knowledge-point/questions ["question-b01530fa-080b-571d-ad1e-cd03aad8ce73"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186281285 :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 4,\\,2\\le z\\le 3y+x\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186412201 :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,1-x\\le y\\le 1+x,\\,0\\le z\\le xy\\}.\n$$" :db/ensure [:question/validate]} {:db/id "question-b01530fa-080b-571d-ad1e-cd03aad8ce73" :question/id #uuid "b01530fa-080b-571d-ad1e-cd03aad8ce73" :question/math-academy-id "q-161660" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,-1\\le x\\le 1,\\,0\\le z\\le 2-{x}^{2},\\,-1\\le y\\le x\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}{\\int }_{-1}^{x}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}[y]_{y=-1}^{y=x}\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}(x-(-1))\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}x+1\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1){[z]}_{z=0}^{z=2-{x}^{2}}\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1)(2-{x}^{2}-0)\\,dx \\\\  & ={\\int }_{-1}^{1}-{x}^{3}-{x}^{2}+2x+2\\,dx \\\\  & ={[-\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}+{x}^{2}+2x]}_{x=-1}^{x=1} \\\\  & =(-\\frac{1}{4}-\\frac{1}{3}+1+2)-(-\\frac{1}{4}+\\frac{1}{3}+1-2) \\\\  & =2(2-\\frac{1}{3}) \\\\  & =\\frac{10}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8a20ef1d-6ee3-5383-abac-10a8cde3ea7a"] :db/ensure [:question/validate]} {:db/id "answer-field-8a20ef1d-6ee3-5383-abac-10a8cde3ea7a" :answer-field/id #uuid "8a20ef1d-6ee3-5383-abac-10a8cde3ea7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-343954e9-c53f-5136-9342-da031d631171" :answer-field/choices ["answer-a0a41433-b3e1-5c92-a9c4-ccd8e0742151" "answer-5f8618f2-a4c1-5463-ab9a-c3032c367b51" "answer-343954e9-c53f-5136-9342-da031d631171" "answer-ff83ce28-20eb-50da-bedd-918638dace6d" "answer-9cfbf36d-43f4-55af-88f8-c9911c1d33e5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0a41433-b3e1-5c92-a9c4-ccd8e0742151" :answer/id #uuid "a0a41433-b3e1-5c92-a9c4-ccd8e0742151" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-5f8618f2-a4c1-5463-ab9a-c3032c367b51" :answer/id #uuid "5f8618f2-a4c1-5463-ab9a-c3032c367b51" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-343954e9-c53f-5136-9342-da031d631171" :answer/id #uuid "343954e9-c53f-5136-9342-da031d631171" :answer/type :answer.type/math :answer/value "\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ff83ce28-20eb-50da-bedd-918638dace6d" :answer/id #uuid "ff83ce28-20eb-50da-bedd-918638dace6d" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9cfbf36d-43f4-55af-88f8-c9911c1d33e5" :answer/id #uuid "9cfbf36d-43f4-55af-88f8-c9911c1d33e5" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186129206 :knowledge-point/questions ["question-1f0b5299-7a35-5c1a-9b72-d6af14bd952f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1f0b5299-7a35-5c1a-9b72-d6af14bd952f" :question/id #uuid "1f0b5299-7a35-5c1a-9b72-d6af14bd952f" :question/math-academy-id "q-161694" :question/problem "![](images/43/4315e0e20d37935d3f5454063475fdfa5ed7a1915f82ae96194e83880ba02e76.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/0b/0ba756dacf72b89b06c3c214e1582a74fa803f567082f57538e7a78c84d4591f.png)\n\n \n\nNotice that our solid can be written as the type I region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 2+x-y\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](images/65/65c61ad7dc2964cd0de9a6bbdf259fcf3388e25da4eaabf155d58ff0c05c8d55.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le 2+x-y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{2+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[z]_{z=0}^{z=2+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(2+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}2+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(2+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=1}\\,dx \\\\  & ={\\int }_{0}^{2}2+x-\\frac{1}{2}\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{3}{2}+x\\,dx \\\\  & ={[\\frac{3}{2}x+\\frac{1}{2}{x}^{2}]}_{x=0}^{x=2} \\\\  & =(3+2)-0 \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb4d67ee-c5f9-5907-9389-cb8d07771ac8"] :db/ensure [:question/validate]} {:db/id "answer-field-bb4d67ee-c5f9-5907-9389-cb8d07771ac8" :answer-field/id #uuid "bb4d67ee-c5f9-5907-9389-cb8d07771ac8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b297e7c-d769-53ea-8c65-407ff3d71965" :answer-field/choices ["answer-b1bd0eaf-67d3-50f4-afcf-748a5d55eeac" "answer-0b297e7c-d769-53ea-8c65-407ff3d71965" "answer-365194f6-bbdb-5806-b6cb-a366405227b7" "answer-ad5c1fce-95e2-5a1d-b0c8-18244b6208ff" "answer-7bd533fa-b6df-5f0a-82f8-f039d177607d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1bd0eaf-67d3-50f4-afcf-748a5d55eeac" :answer/id #uuid "b1bd0eaf-67d3-50f4-afcf-748a5d55eeac" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0b297e7c-d769-53ea-8c65-407ff3d71965" :answer/id #uuid "0b297e7c-d769-53ea-8c65-407ff3d71965" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-365194f6-bbdb-5806-b6cb-a366405227b7" :answer/id #uuid "365194f6-bbdb-5806-b6cb-a366405227b7" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ad5c1fce-95e2-5a1d-b0c8-18244b6208ff" :answer/id #uuid "ad5c1fce-95e2-5a1d-b0c8-18244b6208ff" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-7bd533fa-b6df-5f0a-82f8-f039d177607d" :answer/id #uuid "7bd533fa-b6df-5f0a-82f8-f039d177607d" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id 17592186281299 :question/worked-solution "![](images/bf/bf9c4790a8e31e000d2aeb7f7e557661683d3f52d737ba1b99abd407c15d6e99.png)\n\n  \n\nNotice that our solid can be written as the type I region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 3+x-y\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](images/74/74954715928551ebb271cdfd461d783778b02b7944cbfd5502d6d06011408ad8.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2,\\,\\,0\\le z\\le 3+x-y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{3+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[z]_{z=0}^{z=3+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(3+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}3+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(3+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{2}((3+x)(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}4+2x\\,dx \\\\  & =[4x+{x}^{2}]_{x=0}^{x=2} \\\\  & =(8+4)-0 \\\\  & =12.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-f971a949-3d29-572a-8147-5fc1f2847887" :activity/id #uuid "f971a949-3d29-572a-8147-5fc1f2847887" :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type :activity.type/review :activity/scope 17592186048997 :activity/course 17592186046644 :activity/steps ["step-5faef48e-5cda-55d7-a57a-164d8871091d" "step-68eda359-115c-504f-bacc-ef7faead6b39" "step-9f523ef4-394e-50e4-9b0c-e0ef1659a991" "step-dd20223b-26e1-5350-99dc-f7563663a33f" "step-3af25230-3314-5d99-92ec-e984f7db309b"] :activity/first-step "step-5faef48e-5cda-55d7-a57a-164d8871091d" :db/ensure [:activity/validate]} {:db/id "step-5faef48e-5cda-55d7-a57a-164d8871091d" :step/id #uuid "5faef48e-5cda-55d7-a57a-164d8871091d" :step/content 17592186281285 :step/next "step-68eda359-115c-504f-bacc-ef7faead6b39" :db/ensure [:step/validate]} {:db/id "step-68eda359-115c-504f-bacc-ef7faead6b39" :step/id #uuid "68eda359-115c-504f-bacc-ef7faead6b39" :step/content 17592186412201 :step/next "step-9f523ef4-394e-50e4-9b0c-e0ef1659a991" :db/ensure [:step/validate]} {:db/id "step-9f523ef4-394e-50e4-9b0c-e0ef1659a991" :step/id #uuid "9f523ef4-394e-50e4-9b0c-e0ef1659a991" :step/content "question-b01530fa-080b-571d-ad1e-cd03aad8ce73" :step/next "step-dd20223b-26e1-5350-99dc-f7563663a33f" :db/ensure [:step/validate]} {:db/id "step-dd20223b-26e1-5350-99dc-f7563663a33f" :step/id #uuid "dd20223b-26e1-5350-99dc-f7563663a33f" :step/content "question-1f0b5299-7a35-5c1a-9b72-d6af14bd952f" :step/next "step-3af25230-3314-5d99-92ec-e984f7db309b" :db/ensure [:step/validate]} {:db/id "step-3af25230-3314-5d99-92ec-e984f7db309b" :step/id #uuid "3af25230-3314-5d99-92ec-e984f7db309b" :step/content 17592186281299 :db/ensure [:step/validate]} {:db/id 17592186184212 :knowledge-point/questions ["question-db65568c-c0a4-5de2-8240-a716b187636f" "question-20662b40-9142-5228-b622-edf8a16af72c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-db65568c-c0a4-5de2-8240-a716b187636f" :question/id #uuid "db65568c-c0a4-5de2-8240-a716b187636f" :question/math-academy-id "q-25250" :question/problem "Rewrite $-2{x}^{2}-6x+4$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-2.$ So, we take out a factor of $-2$ from the entire expression:\n\n$$\n-2({x}^{2}+3x-2)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+3x-2\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{3}{2}x-2\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $2$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2}}_{⏟}-{(\\frac{3}{2})}^{2}-2\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}-2\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{3}{2})}^{2}-\\frac{17}{4}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-2({x}^{2}+3x-2) & =-2({(x+\\frac{3}{2})}^{2}-\\frac{17}{4}) \\\\  & =-2{(x+\\frac{3}{2})}^{2}+(-2)\\cdot (-\\frac{17}{4}) \\\\  & =-2{(x+\\frac{3}{2})}^{2}+\\frac{17}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ece1c1a9-e6aa-5e0f-8f5d-a9fac0d03848"] :db/ensure [:question/validate]} {:db/id "answer-field-ece1c1a9-e6aa-5e0f-8f5d-a9fac0d03848" :answer-field/id #uuid "ece1c1a9-e6aa-5e0f-8f5d-a9fac0d03848" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c027f5d-f2be-54c0-ba10-816c2c3c2421" :answer-field/choices ["answer-14b2d8e5-9b5c-5216-aeff-851b31557845" "answer-7c027f5d-f2be-54c0-ba10-816c2c3c2421" "answer-8cc48979-59bf-5cf0-ab38-814855efe50d" "answer-f242b273-5aa7-5a27-95c1-4f47737537b4" "answer-d260d6cd-2693-5fac-b2ee-6098a1ef0f98"] :db/ensure [:answer-field/validate]} {:db/id "answer-14b2d8e5-9b5c-5216-aeff-851b31557845" :answer/id #uuid "14b2d8e5-9b5c-5216-aeff-851b31557845" :answer/type :answer.type/math :answer/value "-2{(x+3)}^{2}+\\frac{17}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7c027f5d-f2be-54c0-ba10-816c2c3c2421" :answer/id #uuid "7c027f5d-f2be-54c0-ba10-816c2c3c2421" :answer/type :answer.type/math :answer/value "-2{(x+\\frac{3}{2})}^{2}+\\frac{17}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8cc48979-59bf-5cf0-ab38-814855efe50d" :answer/id #uuid "8cc48979-59bf-5cf0-ab38-814855efe50d" :answer/type :answer.type/math :answer/value "-2{(x+\\frac{3}{2})}^{2}+\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f242b273-5aa7-5a27-95c1-4f47737537b4" :answer/id #uuid "f242b273-5aa7-5a27-95c1-4f47737537b4" :answer/type :answer.type/math :answer/value "-2{(x+\\frac{3}{2})}^{2}-\\frac{15}{4}" :db/ensure [:answer/validate]} {:db/id "answer-d260d6cd-2693-5fac-b2ee-6098a1ef0f98" :answer/id #uuid "d260d6cd-2693-5fac-b2ee-6098a1ef0f98" :answer/type :answer.type/math :answer/value "-{(2x+3)}^{2}+17" :db/ensure [:answer/validate]} {:db/id 17592186184322 :knowledge-point/questions ["question-edbc0b13-6a6e-5c66-aaa8-e675f3a4a51e" "question-8c5fa084-327e-5d66-96c0-960c479aa7b9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-edbc0b13-6a6e-5c66-aaa8-e675f3a4a51e" :question/id #uuid "edbc0b13-6a6e-5c66-aaa8-e675f3a4a51e" :question/math-academy-id "q-140409" :question/problem "Rewrite $-{y}^{2}-3y-5$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}+3y+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+3y+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{3}{2}y+5\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $5$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}}_{⏟}-{(\\frac{3}{2})}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{3}{2})}^{2}+\\frac{11}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}-3y-5 & =-({(y+\\frac{3}{2})}^{2}+\\frac{11}{4}) \\\\  & =-\\frac{11}{4}-{(y+\\frac{3}{2})}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2878baeb-9a33-5803-8177-df4c02bc48c2"] :db/ensure [:question/validate]} {:db/id "answer-field-2878baeb-9a33-5803-8177-df4c02bc48c2" :answer-field/id #uuid "2878baeb-9a33-5803-8177-df4c02bc48c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e13d59b2-3319-54ab-bbb7-cf745495f661" :answer-field/choices ["answer-e13d59b2-3319-54ab-bbb7-cf745495f661" "answer-5111c904-bf94-52bf-b690-08709ab8e4c9" "answer-0eaa7604-4ed0-50fc-bc63-54add54bc183" "answer-76a0b804-79e8-5a39-9b18-44d9503bab79" "answer-72adf21a-5264-5a28-871d-6fe472489501"] :db/ensure [:answer-field/validate]} {:db/id "answer-e13d59b2-3319-54ab-bbb7-cf745495f661" :answer/id #uuid "e13d59b2-3319-54ab-bbb7-cf745495f661" :answer/type :answer.type/math :answer/value "-\\frac{11}{4}-{(y+\\frac{3}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5111c904-bf94-52bf-b690-08709ab8e4c9" :answer/id #uuid "5111c904-bf94-52bf-b690-08709ab8e4c9" :answer/type :answer.type/math :answer/value "76-{(y+9)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0eaa7604-4ed0-50fc-bc63-54add54bc183" :answer/id #uuid "0eaa7604-4ed0-50fc-bc63-54add54bc183" :answer/type :answer.type/math :answer/value "\\frac{11}{2}+{(y+\\frac{3}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-76a0b804-79e8-5a39-9b18-44d9503bab79" :answer/id #uuid "76a0b804-79e8-5a39-9b18-44d9503bab79" :answer/type :answer.type/math :answer/value "\\frac{29}{4}-{(y-\\frac{3}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-72adf21a-5264-5a28-871d-6fe472489501" :answer/id #uuid "72adf21a-5264-5a28-871d-6fe472489501" :answer/type :answer.type/math :answer/value "\\frac{9}{4}-{(y+\\frac{3}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "question-20662b40-9142-5228-b622-edf8a16af72c" :question/id #uuid "20662b40-9142-5228-b622-edf8a16af72c" :question/math-academy-id "q-140476" :question/problem "Rewrite $-8{z}^{2}-12z-\\frac{7}{2}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-8.$ So, we take out a factor of $-8$ from the entire expression:\n\n$$\n-8({z}^{2}+\\frac{3}{2}z+\\frac{7}{16})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{3}{2}z+\\frac{7}{16}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{3}{4}\\cdot z+\\frac{7}{16}\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{4})}^{2},$ writing the constant term $\\frac{7}{16}$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{3}{4}\\cdot z+{(\\frac{3}{4})}^{2}}_{⏟}-{(\\frac{3}{4})}^{2}+\\frac{7}{16}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}+\\frac{7}{16}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{3}{4})}^{2}-\\frac{1}{8}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-8({z}^{2}+\\frac{3}{2}z+\\frac{7}{16}) & =-8({(z+\\frac{3}{4})}^{2}-\\frac{1}{8}) \\\\  & =-8{(z+\\frac{3}{4})}^{2}+(-8)\\cdot (-\\frac{1}{8}) \\\\  & =-8{(z+\\frac{3}{4})}^{2}+1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b57e8dee-3a1b-5eb0-a0a9-8388e98ff9a1"] :db/ensure [:question/validate]} {:db/id "answer-field-b57e8dee-3a1b-5eb0-a0a9-8388e98ff9a1" :answer-field/id #uuid "b57e8dee-3a1b-5eb0-a0a9-8388e98ff9a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c85bb9fd-5526-511a-8a6a-c2514cf0251b" :answer-field/choices ["answer-c85bb9fd-5526-511a-8a6a-c2514cf0251b" "answer-7fd828f8-42ce-5777-935d-cf7d0ddd6df5" "answer-468992e9-ad98-5e6d-b726-dd3130a61cee" "answer-9b6a8bed-d21d-52be-9870-71f5031347b4" "answer-d5002f69-b154-569c-9f75-ac522a011347"] :db/ensure [:answer-field/validate]} {:db/id "answer-c85bb9fd-5526-511a-8a6a-c2514cf0251b" :answer/id #uuid "c85bb9fd-5526-511a-8a6a-c2514cf0251b" :answer/type :answer.type/math :answer/value "-8{(z+\\frac{3}{4})}^{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-7fd828f8-42ce-5777-935d-cf7d0ddd6df5" :answer/id #uuid "7fd828f8-42ce-5777-935d-cf7d0ddd6df5" :answer/type :answer.type/math :answer/value "-8{(z+\\frac{3}{4})}^{2}+4" :db/ensure [:answer/validate]} {:db/id "answer-468992e9-ad98-5e6d-b726-dd3130a61cee" :answer/id #uuid "468992e9-ad98-5e6d-b726-dd3130a61cee" :answer/type :answer.type/math :answer/value "-8{(z+\\frac{3}{4})}^{2}+\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-9b6a8bed-d21d-52be-9870-71f5031347b4" :answer/id #uuid "9b6a8bed-d21d-52be-9870-71f5031347b4" :answer/type :answer.type/math :answer/value "-8{(z-\\frac{3}{2})}^{2}+2" :db/ensure [:answer/validate]} {:db/id "answer-d5002f69-b154-569c-9f75-ac522a011347" :answer/id #uuid "d5002f69-b154-569c-9f75-ac522a011347" :answer/type :answer.type/math :answer/value "-8{(z-\\frac{3}{2})}^{2}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-8c5fa084-327e-5d66-96c0-960c479aa7b9" :question/id #uuid "8c5fa084-327e-5d66-96c0-960c479aa7b9" :question/math-academy-id "q-218663" :question/problem "Rewrite $-({z}^{2}+z+2)$ by completing the square.\n\n$-({z}^{2}+z+2)=-(z\\,+$\n{{field-1}}\n$)^{2}\\,-$\n{{field-2}}" :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+z+2\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{2}z+2\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{2})}^{2},$ writing the constant term $2$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{1}{2}z+{(\\frac{1}{2})}^{2}}_{⏟}-{(\\frac{1}{2})}^{2}+2\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+2\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{2})}^{2}+\\frac{7}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({z}^{2}+z+2) & =-({(z+\\frac{1}{2})}^{2}+\\frac{7}{4}) \\\\  & =-{(z+\\frac{1}{2})}^{2}-\\frac{7}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90dc3305-1623-5c23-9c54-7ae3dcbc7551" "answer-field-7eb427c0-14cf-57c4-87a9-e84597ae69e6"] :db/ensure [:question/validate]} {:db/id "answer-field-90dc3305-1623-5c23-9c54-7ae3dcbc7551" :answer-field/id #uuid "90dc3305-1623-5c23-9c54-7ae3dcbc7551" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d75106f5-9234-558c-a391-c36bbf650407" :answer-field/choices ["answer-d75106f5-9234-558c-a391-c36bbf650407"] :db/ensure [:answer-field/validate]} {:db/id "answer-d75106f5-9234-558c-a391-c36bbf650407" :answer/id #uuid "d75106f5-9234-558c-a391-c36bbf650407" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-7eb427c0-14cf-57c4-87a9-e84597ae69e6" :answer-field/id #uuid "7eb427c0-14cf-57c4-87a9-e84597ae69e6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f8b64d1a-7608-5a86-ab17-d145feb343f1" :answer-field/choices ["answer-f8b64d1a-7608-5a86-ab17-d145feb343f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8b64d1a-7608-5a86-ab17-d145feb343f1" :answer/id #uuid "f8b64d1a-7608-5a86-ab17-d145feb343f1" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "activity-f3c5106b-1a6d-5d34-af65-e38657e850bd" :activity/id #uuid "f3c5106b-1a6d-5d34-af65-e38657e850bd" :activity/title "Completing the Square With Leading Coefficients" :activity/type :activity.type/review :activity/scope 17592186051078 :activity/course 17592186046658 :activity/steps ["step-b3967518-0bad-5cdd-9b75-d8a8601a6bc0" "step-4fb9a972-5aea-56bd-8dad-8a30a3a80135" "step-54dee566-8f7e-5519-b9c6-82c2023d296e" "step-dd10bb8f-e803-518a-a42c-a0370da41168" "step-a91cb3d6-ea2b-53df-80df-cd12ce5b249c"] :activity/first-step "step-b3967518-0bad-5cdd-9b75-d8a8601a6bc0" :db/ensure [:activity/validate]} {:db/id "step-b3967518-0bad-5cdd-9b75-d8a8601a6bc0" :step/id #uuid "b3967518-0bad-5cdd-9b75-d8a8601a6bc0" :step/content "question-db65568c-c0a4-5de2-8240-a716b187636f" :step/next "step-4fb9a972-5aea-56bd-8dad-8a30a3a80135" :db/ensure [:step/validate]} {:db/id "step-4fb9a972-5aea-56bd-8dad-8a30a3a80135" :step/id #uuid "4fb9a972-5aea-56bd-8dad-8a30a3a80135" :step/content "question-edbc0b13-6a6e-5c66-aaa8-e675f3a4a51e" :step/next "step-54dee566-8f7e-5519-b9c6-82c2023d296e" :db/ensure [:step/validate]} {:db/id "step-54dee566-8f7e-5519-b9c6-82c2023d296e" :step/id #uuid "54dee566-8f7e-5519-b9c6-82c2023d296e" :step/content "question-20662b40-9142-5228-b622-edf8a16af72c" :step/next "step-dd10bb8f-e803-518a-a42c-a0370da41168" :db/ensure [:step/validate]} {:db/id "step-dd10bb8f-e803-518a-a42c-a0370da41168" :step/id #uuid "dd10bb8f-e803-518a-a42c-a0370da41168" :step/content "question-8c5fa084-327e-5d66-96c0-960c479aa7b9" :step/next "step-a91cb3d6-ea2b-53df-80df-cd12ce5b249c" :db/ensure [:step/validate]} {:db/id "step-a91cb3d6-ea2b-53df-80df-cd12ce5b249c" :step/id #uuid "a91cb3d6-ea2b-53df-80df-cd12ce5b249c" :step/content 17592186290358 :db/ensure [:step/validate]} [:db/retract 17592186130936 :answer-field/choices 17592186130937] [:db/retract 17592186130936 :answer-field/choices 17592186130938] [:db/retract 17592186130936 :answer-field/choices 17592186130940] [:db/retract 17592186130936 :answer-field/choices 17592186130941] [:db/retract 17592186130960 :answer-field/choices 17592186130962] [:db/retract 17592186130960 :answer-field/choices 17592186130963] [:db/retract 17592186130960 :answer-field/choices 17592186130964] {:db/id 17592186133927 :knowledge-point/questions ["question-22c4166d-7812-5cc0-89d7-bc30157982f0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186134130 :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨0,\\,0,\\,-2y⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=4-x-2y.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=4-x-2y.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4-x-2y.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4-x-2y)=-1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4-x-2y)=-2\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨0,\\,0,\\,-2y⟩{|}_{z=4-x-2y} \\\\  & =⟨{{0}_{⏟}}_{P},\\,{{0}_{⏟}}_{Q},\\,{{-2y}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-1)-0\\cdot (-2)+(-2y))\\,\\text{d}A \\\\  & ={∬}_{D}-2y\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-palne is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}-2y\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}-2r\\operatorname{sin}⁡\\theta \\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta \\cdot {\\int }_{0}^{1}2r\\cdot r\\,\\text{d}r \\\\  & =[\\operatorname{cos}⁡\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot [{r}^{2}]_{r=0}^{r=1} \\\\  & =(1-1)\\cdot (1-0) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186130936 :answer-field/correct 17592186130939 :answer-field/choices ["answer-7903ed28-5d25-5da8-85e5-0a207c57c64f" "answer-6cfe55e2-32b3-566f-a4fb-ac15bcefa97e" "answer-685918e6-ec50-5f06-acad-83ff00e3c712" "answer-c351ba7c-4c6f-5399-9980-cd006f2d48fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-7903ed28-5d25-5da8-85e5-0a207c57c64f" :answer/id #uuid "7903ed28-5d25-5da8-85e5-0a207c57c64f" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-6cfe55e2-32b3-566f-a4fb-ac15bcefa97e" :answer/id #uuid "6cfe55e2-32b3-566f-a4fb-ac15bcefa97e" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-685918e6-ec50-5f06-acad-83ff00e3c712" :answer/id #uuid "685918e6-ec50-5f06-acad-83ff00e3c712" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-c351ba7c-4c6f-5399-9980-cd006f2d48fe" :answer/id #uuid "c351ba7c-4c6f-5399-9980-cd006f2d48fe" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id 17592186133926 :knowledge-point/questions ["question-19360ab0-63c4-5cd8-9a4a-b29910944cd3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-19360ab0-63c4-5cd8-9a4a-b29910944cd3" :question/id #uuid "19360ab0-63c4-5cd8-9a4a-b29910944cd3" :question/math-academy-id "q-162232" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=x\\,i-z\\,k$ along the closed curve $C$ given by $r(t)=({t}^{2}-t)\\,i+({t}^{3}-{t}^{2})\\,j+k$ for $t\\in [0,1).$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}-t,\\,y={t}^{3}-{t}^{2},\\,z=1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i-z\\,k \\\\  & =({t}^{2}-t)\\,i-1\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(1)\\,k \\\\  & =(2t-1)\\,i+(3{t}^{2}-2t)\\,j+0\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{2}-t)\\,i-\\,k)\\cdot ((2t-1)\\,i+(3{t}^{2}-2t)\\,j) \\\\  & =({t}^{2}-t)\\cdot (2t-1)+0\\cdot (3{t}^{2}-2t)+(-1)\\cdot 0 \\\\  & =({t}^{2}-t)(2t-1).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}-t)(2t-1)\\,\\text{d}t \\\\  & ={[\\frac{({t}^{2}-t)^{2}}{2}]}_{0}^{1} \\\\  & =(0-0) \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-81425c09-b875-5245-8a44-a234fc04ecfd"] :db/ensure [:question/validate]} {:db/id "answer-field-81425c09-b875-5245-8a44-a234fc04ecfd" :answer-field/id #uuid "81425c09-b875-5245-8a44-a234fc04ecfd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c81bffa8-6d28-5db1-a4e4-943e85fac37c" :answer-field/choices ["answer-1348fc00-336c-53bb-be7c-916496ef5d88" "answer-c81bffa8-6d28-5db1-a4e4-943e85fac37c" "answer-55053be1-77fb-5c4b-806e-49e7c1fc512f" "answer-662c897b-ead7-5be2-af3c-4e8c4cf7d102" "answer-b48883a2-477f-5af5-a0a1-a15c7ffa7d19"] :db/ensure [:answer-field/validate]} {:db/id "answer-1348fc00-336c-53bb-be7c-916496ef5d88" :answer/id #uuid "1348fc00-336c-53bb-be7c-916496ef5d88" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-c81bffa8-6d28-5db1-a4e4-943e85fac37c" :answer/id #uuid "c81bffa8-6d28-5db1-a4e4-943e85fac37c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-55053be1-77fb-5c4b-806e-49e7c1fc512f" :answer/id #uuid "55053be1-77fb-5c4b-806e-49e7c1fc512f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-662c897b-ead7-5be2-af3c-4e8c4cf7d102" :answer/id #uuid "662c897b-ead7-5be2-af3c-4e8c4cf7d102" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b48883a2-477f-5af5-a0a1-a15c7ffa7d19" :answer/id #uuid "b48883a2-477f-5af5-a0a1-a15c7ffa7d19" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-22c4166d-7812-5cc0-89d7-bc30157982f0" :question/id #uuid "22c4166d-7812-5cc0-89d7-bc30157982f0" :question/math-academy-id "q-162363" :question/problem "Let $C$ be the intersection of the hyperbolic paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x=\\pm 1,$ $y=\\pm 2.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨y,\\,x,\\,2⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)={x}^{2}-{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({x}^{2}-{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,x,\\,2⟩{|}_{z={x}^{2}-{y}^{2}} \\\\  & =⟨y,\\,x,\\,2⟩ \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{x}_{⏟}}_{Q},\\,{{2}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-x\\cdot (-2y)+2)\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/5f/5f2f4cb03b3b0232c9debd1f4ed64bd683fe788ccba16cfbe395d9c3b629972d.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}2\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bce8cadb-6f17-5458-a146-66e868571308"] :db/ensure [:question/validate]} {:db/id "answer-field-bce8cadb-6f17-5458-a146-66e868571308" :answer-field/id #uuid "bce8cadb-6f17-5458-a146-66e868571308" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-735bc584-a512-58b1-8842-88d84b62c851" :answer-field/choices ["answer-580a54b0-7193-5059-b069-221fd5506992" "answer-735bc584-a512-58b1-8842-88d84b62c851" "answer-3598a050-8338-5881-8c7e-00b829e53f3f" "answer-531bef77-5bda-58b0-b731-a0a09745931d" "answer-0c4b66cf-ec3e-5130-bf78-dab2acbc861c"] :db/ensure [:answer-field/validate]} {:db/id "answer-580a54b0-7193-5059-b069-221fd5506992" :answer/id #uuid "580a54b0-7193-5059-b069-221fd5506992" :answer/type :answer.type/text :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-735bc584-a512-58b1-8842-88d84b62c851" :answer/id #uuid "735bc584-a512-58b1-8842-88d84b62c851" :answer/type :answer.type/text :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-3598a050-8338-5881-8c7e-00b829e53f3f" :answer/id #uuid "3598a050-8338-5881-8c7e-00b829e53f3f" :answer/type :answer.type/text :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-531bef77-5bda-58b0-b731-a0a09745931d" :answer/id #uuid "531bef77-5bda-58b0-b731-a0a09745931d" :answer/type :answer.type/text :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,4+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-0c4b66cf-ec3e-5130-bf78-dab2acbc861c" :answer/id #uuid "0c4b66cf-ec3e-5130-bf78-dab2acbc861c" :answer/type :answer.type/text :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,{x}^{2}-{y}^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186133928 :knowledge-point/questions ["question-2bdcc65b-8401-5044-8aa5-c9a7e37ffa6b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186134134 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,j+\\operatorname{sin}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=x\\,i+y\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡(\\pi t),\\,y=\\operatorname{cos}⁡(\\pi t),\\,z=\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+y\\,k \\\\  & =\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,k \\\\  & =\\pi \\operatorname{cos}⁡(\\pi t)\\,i-\\pi \\operatorname{sin}⁡(\\pi t)\\,j+\\pi \\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k)\\cdot (\\pi \\operatorname{cos}⁡(\\pi t)\\,i-\\pi \\operatorname{sin}⁡(\\pi t)\\,j+\\pi \\operatorname{cos}⁡(\\pi t)\\,k) \\\\  & =\\operatorname{sin}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t)-0\\cdot \\pi \\operatorname{sin}⁡(\\pi t)+\\operatorname{cos}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)+\\pi {cos}^{2}⁡(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)+\\pi {cos}^{2}⁡(\\pi t))\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)+\\frac{\\pi }{2}(1+\\operatorname{cos}⁡(2\\pi t)))\\,\\text{d}t \\\\  & ={[\\frac{{sin}^{2}⁡(\\pi t)}{2}+\\frac{\\pi t}{2}+\\frac{\\operatorname{sin}⁡(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =0+\\frac{\\pi }{2}+0-(0-\\frac{\\pi }{2}+0) \\\\  & =\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186130960 :answer-field/correct "answer-81f2f5fe-c2fa-5a14-a755-d561c640ccb1" :answer-field/choices ["answer-6eea3a9c-148b-5bbc-b698-c42d3d976666" "answer-9ce79bec-631d-5e6e-9ada-b94ec4a0d8f0" "answer-81f2f5fe-c2fa-5a14-a755-d561c640ccb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6eea3a9c-148b-5bbc-b698-c42d3d976666" :answer/id #uuid "6eea3a9c-148b-5bbc-b698-c42d3d976666" :answer/type :answer.type/math :answer/value "-2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-9ce79bec-631d-5e6e-9ada-b94ec4a0d8f0" :answer/id #uuid "9ce79bec-631d-5e6e-9ada-b94ec4a0d8f0" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-81f2f5fe-c2fa-5a14-a755-d561c640ccb1" :answer/id #uuid "81f2f5fe-c2fa-5a14-a755-d561c640ccb1" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "question-2bdcc65b-8401-5044-8aa5-c9a7e37ffa6b" :question/id #uuid "2bdcc65b-8401-5044-8aa5-c9a7e37ffa6b" :question/math-academy-id "q-162890" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j+2\\operatorname{cos}⁡t\\,k$ for $t\\in [0,2\\pi ).$\nGiven that $F(x,y,z)=2z\\,i+x\\,j+3y\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t,\\,z=2\\operatorname{cos}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =2z\\,i+x\\,j+3y\\,k \\\\  & =4\\operatorname{cos}⁡t\\,i+\\operatorname{cos}⁡t\\,j+6\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j-2\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(4\\operatorname{cos}⁡t\\,i+\\operatorname{cos}⁡t\\,j+6\\operatorname{sin}⁡t\\,k)\\cdot (-\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j-2\\operatorname{sin}⁡t\\,k) \\\\  & =4\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot 2\\operatorname{cos}⁡t+6\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t) \\\\  & =-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2{cos}^{2}⁡t-12{sin}^{2}⁡t \\\\  & =-2\\operatorname{sin}⁡(2t)+2{cos}^{2}⁡t+2{sin}^{2}⁡t-14{sin}^{2}⁡t \\\\  & =-2\\operatorname{sin}⁡2t-14{sin}^{2}⁡t+2.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-14{sin}^{2}⁡t+2)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-7(1-\\operatorname{cos}⁡2t)+2)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-2\\operatorname{sin}⁡2t-5+7\\operatorname{cos}⁡2t)\\,\\text{d}t \\\\  & ={[\\operatorname{cos}⁡2t-5t+\\frac{7}{2}\\operatorname{sin}⁡2t]}_{0}^{2\\pi } \\\\  & =(1-5(2\\pi )+0)-(1-5(0)+0) \\\\  & =-10\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fd517342-4196-5078-a01c-54f228cf9d0a"] :db/ensure [:question/validate]} {:db/id "answer-field-fd517342-4196-5078-a01c-54f228cf9d0a" :answer-field/id #uuid "fd517342-4196-5078-a01c-54f228cf9d0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac7ed5de-3dc1-5a83-a649-aaf890348062" :answer-field/choices ["answer-ac7ed5de-3dc1-5a83-a649-aaf890348062" "answer-96cf3b15-d8b8-5670-bef5-bd091199fa39" "answer-a99d6b81-4b37-544d-99ea-7af055e746a2" "answer-83f896a5-bf32-5e5d-9cc6-f790b29f490e" "answer-49efc351-4e26-566c-99c2-fe234a1dd84a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac7ed5de-3dc1-