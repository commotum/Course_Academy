ensure [:step/validate]} {:db/id "step-7448047a-c9c1-58cc-8181-6b27db0e6a80" :step/id #uuid "7448047a-c9c1-58cc-8181-6b27db0e6a80" :step/content "question-22c4166d-7812-5cc0-89d7-bc30157982f0" :step/next "step-cb01237b-4d73-5b10-94f4-c0c4f3fdada5" :db/ensure [:step/validate]} {:db/id "step-cb01237b-4d73-5b10-94f4-c0c4f3fdada5" :step/id #uuid "cb01237b-4d73-5b10-94f4-c0c4f3fdada5" :step/content 17592186134134 :step/next "step-241fd184-8019-52bd-8c7e-c4c658c038e8" :db/ensure [:step/validate]} {:db/id "step-241fd184-8019-52bd-8c7e-c4c658c038e8" :step/id #uuid "241fd184-8019-52bd-8c7e-c4c658c038e8" :step/content "question-2bdcc65b-8401-5044-8aa5-c9a7e37ffa6b" :db/ensure [:step/validate]} {:db/id 17592186073680 :knowledge-point/questions ["question-5f0cef98-4d6e-5f8f-803e-692ed6a93d90" "question-840c078c-4570-5c8b-92a3-92eaaeeaa79e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073682 :knowledge-point/questions ["question-5ebed1ea-4030-56bb-a75b-85ec95570cad" "question-39cecc3d-6cf0-5c7c-a0ca-fadfcdb5000c" "question-9b89dfe3-da21-530c-903d-947ec6af3854"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073681 :knowledge-point/questions ["question-934b60d8-f889-5c91-8ad2-ede254ef4d64"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073621 :question/worked-solution "First, we convert $\\dfrac{\\pi}{6}$ radians to an equivalent measure in degrees. This gives\n\n$$\n\\left(\\dfrac{\\pi} 6\\right) \\left(\\dfrac {180^\\circ} {\\pi}\\right) = \\dfrac {180^\\circ} {6} = 30^\\circ.\n$$\n\nTherefore, \n\n$$\n\\sin \\left(\\dfrac{\\pi}{6}\\right) = \\sin 30^\\circ.\n$$\n\nFinally, since we know that $\\sin 30^\\circ = \\dfrac{1}{2},$ we obtain\n\n$$\n\\sin\\left( \\dfrac{\\pi}{6}\\right)  = \\dfrac{1}{2}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186073683 :knowledge-point/questions ["question-4cd34dd2-403c-55c2-9000-3c54447738a1" "question-f7892f8a-0a7a-5c55-9033-6382c732bb3a" "question-da03fb8c-a7ca-5696-a1f6-3635e0d03dad" "question-299f3633-d5e0-546a-8fb6-eacb46c1b2dd" "question-5168a992-4557-5020-911a-67c9df9985ed"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073623 :question/problem "Is the following statement  true or false?\n\n$$\n\\sin30^\\circ \\:\\overset{\\large\\color{red}?}{=}\\: \\sin \\left(  \\dfrac16 \\right).\n$$" :question/worked-solution "The statement is false. Converting $30^\\circ$ from degrees to radians, we get \n\n$$\n30^\\circ= 30\\cdot \\dfrac{\\pi}{180} = \\dfrac{\\pi}{6} \\, \\textrm{radians}.\n$$\n\nThe statement is false because $\\dfrac{\\pi}{6} \\neq \\dfrac{1}6.$" :db/ensure [:question/validate]} {:db/id "question-5f0cef98-4d6e-5f8f-803e-692ed6a93d90" :question/id #uuid "5f0cef98-4d6e-5f8f-803e-692ed6a93d90" :question/math-academy-id "q-54420" :question/problem "Rounded to $3$ decimal places, $\\operatorname{sec}⁡(1)=$" :question/worked-solution "Note that we need the answer in radians. Using a calculator in \"radians\" mode, we obtain\n\n$$\n\\operatorname{sec}⁡(1)=\\frac{1}{\\operatorname{cos}⁡(1)}≈1.850\\,815…≈1.851\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7b4090a0-7a08-51d1-b5a5-110eef823f48"] :db/ensure [:question/validate]} {:db/id "answer-field-7b4090a0-7a08-51d1-b5a5-110eef823f48" :answer-field/id #uuid "7b4090a0-7a08-51d1-b5a5-110eef823f48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-66c48990-e29d-5593-b0be-dcf7bafc7d96" :answer-field/choices ["answer-c564d4e6-6829-5a1d-bab0-a8e3e707ce1e" "answer-88726f67-eb92-5029-aadc-62da88e17614" "answer-84c87610-af2e-5130-bef1-8d066bc35df1" "answer-84e539ac-90b0-54ca-bd6a-bd4374e65694" "answer-66c48990-e29d-5593-b0be-dcf7bafc7d96"] :db/ensure [:answer-field/validate]} {:db/id "answer-c564d4e6-6829-5a1d-bab0-a8e3e707ce1e" :answer/id #uuid "c564d4e6-6829-5a1d-bab0-a8e3e707ce1e" :answer/type :answer.type/math :answer/value "0.540" :db/ensure [:answer/validate]} {:db/id "