b31a160" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c389682d-42f9-5b36-aecf-84b5b45dee1a" :answer-field/choices ["answer-f7618fca-86a2-53d3-84b0-51f4f3d7c765" "answer-ae3cb97f-a300-598b-bfe6-6bf8f1278132" "answer-c0fd5d3a-7d0f-5ea4-914a-871484720da7" "answer-54a8b7db-79fa-58b5-96a6-e82a42bcb1cc" "answer-c389682d-42f9-5b36-aecf-84b5b45dee1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7618fca-86a2-53d3-84b0-51f4f3d7c765" :answer/id #uuid "f7618fca-86a2-53d3-84b0-51f4f3d7c765" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-ae3cb97f-a300-598b-bfe6-6bf8f1278132" :answer/id #uuid "ae3cb97f-a300-598b-bfe6-6bf8f1278132" :answer/type :answer.type/math :answer/value "\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-c0fd5d3a-7d0f-5ea4-914a-871484720da7" :answer/id #uuid "c0fd5d3a-7d0f-5ea4-914a-871484720da7" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-54a8b7db-79fa-58b5-96a6-e82a42bcb1cc" :answer/id #uuid "54a8b7db-79fa-58b5-96a6-e82a42bcb1cc" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c389682d-42f9-5b36-aecf-84b5b45dee1a" :answer/id #uuid "c389682d-42f9-5b36-aecf-84b5b45dee1a" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id 17592186064364 :knowledge-point/questions ["question-3e520184-edf6-56d7-ae3f-333c3748146f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e520184-edf6-56d7-ae3f-333c3748146f" :question/id #uuid "3e520184-edf6-56d7-ae3f-333c3748146f" :question/math-academy-id "q-171123" :question/problem "$(5.2)\\cdot (-3)=${{field-1}}" :question/worked-solution "We have a product of a positive number $(5.2)$ and a negative number $(-3).$ So the product will be negative:\n\n$$\n5.2\\cdot (-3)=-\\,\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $5.2$ by $3$ without any signs: $5.2\\cdot 3=15.6.$ So, we get\n\n$$\n5.2\\cdot (-3)=-15.6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7a7ea3b9-535a-5e77-b9a4-dea5e94f45e7"] :db/ensure [:question/validate]} {:db/id "answer-field-7a7ea3b9-535a-5e77-b9a4-dea5e94f45e7" :answer-field/id #uuid "7a7ea3b9-535a-5e77-b9a4-dea5e94f45e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4d94c53c-2afd-517b-8b96-6142e6db784f" :answer-field/choices ["answer-4d94c53c-2afd-517b-8b96-6142e6db784f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d94c53c-2afd-517b-8b96-6142e6db784f" :answer/id #uuid "4d94c53c-2afd-517b-8b96-6142e6db784f" :answer/type :answer.type/math :answer/value "-15.6" :db/ensure [:answer/validate]} {:db/id 17592186073740 :knowledge-point/questions ["question-162ad66e-4fa5-5917-937f-4dfd0e95e3fd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-162ad66e-4fa5-5917-937f-4dfd0e95e3fd" :question/id #uuid "162ad66e-4fa5-5917-937f-4dfd0e95e3fd" :question/math-academy-id "q-59899" :question/problem "![](images/6e/6e12ca457954f93778b772f2d0bd5a1e63e7e8e7eaf626d309300e97b23ab525.png)\n\nWhat number is missing from the boxes in the statement below?\n\nThe ratio of hexagons to rhombuses is $\\boxed{}:1$ because there are $\\boxed{}$ hexagons for every $1$ rhombus." :question/worked-solution "First, we count the number of hexagons. We see that there are $4$ hexagons.\n\nThen, we count the number of rhombuses. We see that there are $2$ rhombuses.\n\nSo the ratio of hexagons to rhombuses is $4:2.$\n\nWe can simplify this ratio by dividing both numbers by $2$:\n\n$$\n\\begin{aligned}\\,\\,4 &  & : & \\,\\,\\,\\, & \\,\\,\\,2 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nThis means that $2:1$ is equivalent to $4:2.$ \n\nSo, the complete statement is\n\"The ratio of hexagons to rhombuses is $2:1$ because there are $2$ hexagons for every $1$ rhombus.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ee707a5-cdba-5ace-9f13-9f6ca1c803ef"] :db/ensure [:question/validate]} {:db/id "answer-field-9ee707a5-cdba-5ace-9f13-9f6ca1c803ef" :answer-field/id #uuid "9ee707a5-cdba-5ace-9f13-9f6ca1c803ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca64ca36-f6af-5be2-9a76-2b7cbc85698b" :answer-field/choices ["answer-8a9f26e9-6756-5716-989d-00c536e7041c" "answer-ca64ca36-f6af-5be2-9a76-2b7cbc85698b" "answer-db276d64-70bd-58c9-a75a-18687f8c8c7c" "answer-4878cfa1-846f-5e65-8d90-c04276138057" "answer-ec72d0d4-5419-525b-9012-042c143b9e36"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a9f26e9-6756-5716-989d-00c536e7041c" :answer/id #uuid "8a9f26e9-6756-5716-989d-00c536e7041c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ca64ca36-f6af-5be2-9a76-2b7cbc85698b" :answer/id #uuid "ca64ca36-f6af-5be2-9a76-2b7cbc85698b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-db276d64-70bd-58c9-a75a-18687f8c8c7c" :answer/id #uuid "db276d64-70bd-58c9-a75a-18687f8c8c7c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-4878cfa1-846f-5e65-8d90-c04276138057" :answer/id #uuid "4878cfa1-846f-5e65-8d90-c04276138057" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ec72d0d4-5419-525b-9012-042c143b9e36" :answer/id #uuid "ec72d0d4-5419-525b-9012-042c143b9e36" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-aac1cdb9-97ef-511b-a4fe-36b98cea93fd" :activity/id #uuid "aac1cdb9-97ef-511b-a4fe-36b98cea93fd" :activity/title "Quiz 3" :activity/type :activity.type/assessment :activity/course 17592186046647 :activity/steps ["step-7d6546f6-180f