x}^{2}+\\frac{7x}{2}$ is a parabola. It has the following factored form:\n\n$$\ny=-x(x-\\frac{7}{2})\n$$\n\nFrom the factored form above, we get the following graph:\n\n![](images/ab/ab305b89891508770d709b4913fef0f06360ed6aed05cdd32de6f41eba527207.png)\n\nNow, to get the curve $x=-{y}^{2}+\\frac{7y}{2},$ we just have to reflect the curve $y=-{x}^{2}+\\frac{7x}{2}$ over the line $y=x,$ as follows:\n\n![](images/63/63c6861e06dfaf818e6b6a30f2ca995c69dd6a7bdecc1b305c5c2b098712a64f.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6d1f4387-642d-500d-964b-626af2511a1a"] :db/ensure [:question/validate]} {:db/id "answer-field-6d1f4387-642d-500d-964b-626af2511a1a" :answer-field/id #uuid "6d1f4387-642d-500d-964b-626af2511a1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31ed5b57-7d3a-53aa-bf54-d8eb0cf2cb49" :answer-field/choices ["answer-d0713804-9119-5d0d-8f0f-eeb95e3b9ab5" "answer-31ed5b57-7d3a-53aa-bf54-d8eb0cf2cb49" "answer-58b1983c-18f3-5542-9076-1c78882e1f8f" "answer-9ff3976b-79cd-5180-bdcb-9121641cbc7e" "answer-ca03cca9-183a-5dc9-9a67-05b176a0db7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0713804-9119-5d0d-8f0f-eeb95e3b9ab5" :answer/id #uuid "d0713804-9119-5d0d-8f0f-eeb95e3b9ab5" :answer/type :answer.type/image :answer/value "images/04/049189d09eef52abfeff3c442efa16753e98752c5f34102170befe4018994036.png" :db/ensure [:answer/validate]} {:db/id "answer-31ed5b57-7d3a-53aa-bf54-d8eb0cf2cb49" :answer/id #uuid "31ed5b57-7d3a-53aa-bf54-d8eb0cf2cb49" :answer/type :answer.type/image :answer/value "images/5c/5c627d1c7c8fab8b73e97a975d37b56be387339adfcef7073807963c19b26f2d.png" :db/ensure [:answer/validate]} {:db/id "answer-58b1983c-18f3-5542-9076-1c78882e1f8f" :answer/id #uuid "58b1983c-18f3-5542-9076-1c78882e1f8f" :answer/type :answer.type/image :answer/value "images/66/668786e30fc7ece2a3f873e86834550855e07fc0fbf418c224dc669e7ab23c18.png" :db/ensure [:answer/validate]} {:db/id "answer-9ff3976b-79cd-5180-bdcb-9121641cbc7e" :answer/id #uuid "9ff3976b-79cd-5180-bdcb-9121641cbc7e" :answer/type :answer.type/image :answer/value "images/a0/a065759d37f8f6f96c83959b91eb3a758e74823ad9adaa47ace40bc03e7257cd.png" :db/ensure [:answer/validate]} {:db/id "answer-ca03cca9-183a-5dc9-9a67-05b176a0db7e" :answer/id #uuid "ca03cca9-183a-5dc9-9a67-05b176a0db7e" :answer/type :answer.type/image :answer/value "images/e9/e96b63cb44319651e4347943f6545028016be0091c33c57300f3fae17aebe6e3.png" :db/ensure [:answer/validate]} {:db/id 17592186157961 :question/problem "Plot the graph of $x=-{y}^{2}-3y.$" :question/worked-solution "To plot $x=-{y}^{2}-3y,$ we will first plot the function $y=-{x}^{2}-3x$ and then reflect it over the line $y=x.$\n\nThe curve $y=-{x}^{2}-3x$ is a parabola. It has the following factored form:\n\n$$\ny=-x(x+3)\n$$\n\nFrom the factored form above, we get the following graph:\n\n![](images/ba/bad18b9ff4c0dc985adcaf29cdbe0a8f41a141527060eca6c7ade5f6c05b87ea.png)\n\nNow, to get the curve $x=-{y}^{2}-3y,$ we just have to reflect the curve $y=-{x}^{2}-3x$ over the line $y=x,$ as follows:\n\n![](images/e4/e44da9125a68d85916bdab3f9b7a6cd10a4d812c5fb12cb9825f6e229b1655b4.png)" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186156687 :answer-field/correct 17592186156690 :db/ensure [:answer-field/validate]} {:db/id "question-a12fcacc-90b5-5cdd-9ea9-725215f67451" :question/id #uuid "a12fcacc-90b5-5cdd-9ea9-725215f67451" :question/math-academy-id "q-88505" :question/problem "Plot the graph of $x=2{y}^{2}+3y.$" :question/worked-solution "To plot $x=2{y}^{2}+3y,$ we will first plot the function $y=2{x}^{2}+3x$ and then reflect it over the line $y=x.$\n\nThe curve $y=2{x}^{2}+3x$ is a parabola. It has the following factored form:\n\n$$\ny=x(2x+3)\n$$\n\nFrom the factored form above, we get the following graph:\n\n![](images/c1/c1b824ff56cc67a930cc5777aed40f913371154631b7caa2a288b5ce7a64a60b.png)\n\nNow, to get the curve $x=2{y}^{2}+3y,$ we just have to reflect the curve $y=2{x}^{2}+3x$ over the line $y=x,$ as follows:\n\n![](images/65/658ed684c36124ca72a172050f5587e51f8eb9c7395bc6aa2fbe1eea09aa7c63.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a41b9489-8239-5721-abc1-f17183e71134"] :db/ensure [:question/validate]} {:db/id "answer-field-a41b9489-8239-5721-abc1-f17183e71134" :answer-field/id #uuid "a41b9489-8239-5721-abc1-f17183e71134" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54d9d7fd-9e5a-5c64-8c19-8b856d6fd9de" :answer-field/choices ["answer-5a2a069d-d668-51f1-b97a-4baeb71cfe8b" "answer-6d5ff9e2-e689-53bc-96de-390fab538d4c" "answer-54d9d7fd-9e5a-5c64-8c19-8b856d6fd9de" "answer-e93be0fe-eaf6-5b2c-a90e-7f6b26a76e53" "answer-232f4778-6f65-5e2c-b37b-3359f57ef8c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a2a069d-d668-51f1-b97a-4baeb71cfe8b" :answer/id #uuid "5a2a069d-d668-51f1-b97a-4baeb71cfe8b" :answer/type :answer.type/image :answer/value "images/01/01accdd0c9eac8355893c2f8c337de1268ec1c30e847621141b2e13f78570b57.png" :db/ensure [:answer/validate]} {:db/id "answer-6d5ff9e2-e689-53bc-96de-390fab538d4c" :answer/id #uuid "6d5ff9e2-e689-53bc-96de-390fab538d4c" :answer/type :answer.type/image :answer/value "images/13/13e02124437d4e3d4ab34e435a05081652ba379422f3a0c25cf30db74690043f.png" :db/ensure [:answer/validate]} {:db/id "answer-54d9d7fd-9e5a-5c64-8c19-8b856d6fd9de" :answer/id #uuid "54d9d7fd-9e5a-5c64-8c19-8b856d6fd9de" :answer/type :answer.type/image :answer/value "images/93/93322b2a4dc35910cec938918258385cd34401092deb8da11dc27241ecbbcdbb.png" :db/ensure [:answer/validate]} {:db/id "answer-e93be0fe-eaf6-5b2c-a90e-7f6b26a76e53" :answer/id #uuid "e93be0fe-eaf6-5b2c-a90e-7f6b26a76e53" :answer/type :answer.type/image :answer/value "images/c2/c24a03e35ab026270e85abca10666b1be70da1ec75f87f8beffc08d2cadc5711.png" :db/ensure [:answer/validate]} {:db/id "answer-232f4778-6f65-5e2c-b37b-3359f57ef8c3" :answer/id #uuid "232f4778-6f65-5e2c-b37b-3359f57ef8c3" :answer/type :answer.type/image :answer/value "images/ca/ca9ec14867ac40daa432e2a225a189bb3f3dcd0179f074702c83405a5db9436d.png" :db/ensure [:answer/validate]} {:db/id "question-580eb058-5204-5604-8964-e7eb4b3f475e" :question/id #uuid "580eb058-5204-5604-8964-e7eb4b3f475e" :question/math-academy-id "q-88514" :question/problem "Plot the graph of $x=-9{y}^{2}+7y.$" :question/worked-solution "To plot $x=-9{y}^{2}+7y,$ we will first plot the function $y=-9{x}^{2}+7x$ and then reflect it over the line $y=x.$\n\nThe curve $y=-9{x}^{2}+7x$ is a parabola. It has the following factored form:\n\n$$\ny=-x(9x-7)\n$$\n\nFrom the factored form above, we get the following graph:\n\n![](images/a8/a8781c2736aeb53a49c4f7627fb5262f1c3ef90162edf4e52251f86323e2e611.png)\n\nNow, to get the curve $x=-9{y}^{2}+7y,$ we just have to reflect the curve $y=-9{x}^{2}+7x$ over the line $y=x,$ as follows:\n\n![](images/34/344f13842043f5eb5e0db0db694cbc5801373fe36cfc81e9324e8d02fcba5ebb.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fff2716f-8830-5ed6-8055-dd7a0224120e"] :db/ensure [:question/validate]} {:db/id "answer-field-fff2716f-8830-5ed6-8055-dd7a0224120e" :answer-field/id #uuid "fff2716f-8830-5ed6-8055-dd7a0224120e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb9e9fda-b16c-53fc-bffa-253ac6fdebd7" :answer-field/choices ["answer-c082488b-a008-5ccc-8e8f-e651022b0346" "answer-de76302d-4e8b-505e-8f11-b6ec4de9cfd8" "answer-c4dc5bb2-7cbc-5699-b585-01266ed83a2a" "answer-0e349bb8-82c4-5c16-84b1-2a7e44855b98" "answer-bb9e9fda-b16c-53fc-bffa-253ac6fdebd7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c082488b-a008-5ccc-8e8f-e651022b0346" :answer/id #uuid "c082488b-a008-5ccc-8e8f-e651022b0346" :answer/type :answer.type/image :answer/value "images/2f/2f7cc326da3af49dcef56557ea683bd70437eb120a97d8c29f29954d7d10a49e.png" :db/ensure [:answer/validate]} {:db/id "answer-de76302d-4e8b-505e-8f11-b6ec4de9cfd8" :answer/id #uuid "de76302d-4e8b-505e-8f11-b6ec4de9cfd8" :answer/type :answer.type/image :answer/value "images/56/569cdb838ae22ba861b3c378e8348486f724110cba8e150ef14ff19a91969890.png" :db/ensure [:answer/validate]} {:db/id "answer-c4dc5bb2-7cbc-5699-b585-01266ed83a2a" :answer/id #uuid "c4dc5bb2-7cbc-5699-b585-01266ed83a2a" :answer/type :answer.type/image :answer/value "images/75/75bf1eeba8d144d4412bc00344598b4dd12f2739a75dc8e203e20b01453e9bef.png" :db/ensure [:answer/validate]} {:db/id "answer-0e349bb8-82c4-5c16-84b1-2a7e44855b98" :answer/id #uuid "0e349bb8-82c4-5c16-84b1-2a7e44855b98" :answer/type :answer.type/image :answer/value "images/c7/c7d48010a5b162d0ae3a7eb0bac2e0fcb3e13076be3f0fd400c3160e4edf46a8.png" :db/ensure [:answer/validate]} {:db/id "answer-bb9e9fda-b16c-53fc-bffa-253ac6fdebd7" :answer/id #uuid "bb9e9fda-b16c-53fc-bffa-253ac6fdebd7" :answer/type :answer.type/image :answer/value "images/f4/f4f97651e5e80a3c101c29b4ed089f4134e14cc7e8dc1e50ae2a56dfa4e51281.png" :db/ensure [:answer/validate]} {:db/id 17592186158528 :tutorial/content "We're used to plotting curves where $y$ is a function of $x.$ However, we can also plot curves where $x$ is a function of $y.$\n\nFor example, consider the curve $x = y^2.$ To graph this curve, we can start by calculating the values of $x$ for some values of $y{:}$\n\n$$\n\\begin{aligned}y=-3 & \\,⟶\\,x=(-3)^{2}=9 \\\\ y=-2 & \\,⟶\\,x=(-2)^{2}=4 \\\\ y=-1 & \\,⟶\\,x=(-1)^{2}=1 \\\\ y=0 & \\,⟶\\,x={0}^{2}=0 \\\\ y=1 & \\,⟶\\,x={1}^{2}=1 \\\\ y=2 & \\,⟶\\,x={2}^{2}=4 \\\\ y=3 & \\,⟶\\,x={3}^{2}=9\\end{aligned}\n$$\n\nWe can summarize these results in the following table:\n\n| **$y$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $9$ | $4$ | $1$ | $0$ | $1$ | $4$ | $9$ |\n\nSo, we have the following points:\n\n$$\n(9,-3), \\quad (4,-2), \\quad (1,-1), \\quad (0,0), \\quad (1,1), \\quad (4,2), \\quad (9,3).\n$$\n\nIf we plot these points and connect them with a smooth curve, we get the following graph:\n\n![](images/ae/aec45789560229c23f0c86069bad46593a7d00a637f6f8da33d36634ae504e52.png)\n\nWe say that the equation of the curve is defined **implicitly**, because instead of the usual $y = f(x),$ we have $x = f(y).$ \n\n**Watch out!** Here, we are viewing $x=y^2$ not as a function but rather as an equation. A point belongs to the curve if and only if its coordinates satisfy the equation. The curve does not represent a function since it fails the vertical line test." :db/ensure [:tutorial/validate]} {:db/id 17592186158529 :tutorial/content "Another way to plot $x = f(y)$ is to first plot the corresponding function $y = f(x)$ and then reflect it over the line $y=x.$\n\nTo illustrate, let's use this technique to plot the curve $x=y^2.$ To get the corresponding function, we swap $x$ and $y$ and get $y=x^2.$ This curve is familiar and much easier to graph:\n\n![](images/af/afca2357f9d26876cedc7fb1d059c95c8906d9144f2fdb17dd2f61eec878a196.png)\n\nNow, to get the curve $x=y^2,$ we just have to reflect the curve $y=x^2$ over the line $y=x,$ as follows:\n\n![](images/5b/5b91959bd83265ed0b606072b26029bd995f51a8128c14367af9013688db148c.png)\n\nYou may notice that this process is very similar to plotting the inverse of a function. In fact, if $y=f(x)$ is a one-to-one function, then the corresponding function $x = f(y)$ will always give the inverse function." :db/ensure [:tutorial/validate]} {:db/id 17592186157526 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id 17592186129140 :knowledge-point/questions ["question-1114090a-5268-5e5c-ab01-061822ccfb1c" "question-f891d27b-7abc-5935-b2a7-003a7da88708"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128955 :question/problem "Sketch the curve $f(x) = \\dfrac{1}{5}(x-4)(x^2 + 5).$" :question/worked-solution "The equation is already fully factored. Note that the discriminant of $x^2 + 5 = 0$ is \n\n$$\n\\mathcal{D}= 0^2 - 4(1)(5) = -20 < 0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=4.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{5}(0-4)({0}^{2}+5) \\\\  & =\\frac{1}{5}(-4)(5) \\\\  & =-4\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,-4),$\n\n- passes through the $x$-axis at the single root $x=4,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted ${\\textsf{S}}$-shape. Therefore, the graph looks as follows:\n\n![](images/1b/1b8d12adf0f04b7c1d9d05271c9378b941cf107d713932055a1fc48371952a1c.png)" :db/ensure [:question/validate]} {:db/id 17592186129141 :knowledge-point/questions ["question-8e99018d-106a-536c-a32e-4bcfd5c27a01"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128956 :question/problem "Given that $(x-3)$ is a factor of $f(x) = x^3 + x^2 - 4x - 24,$ sketch the curve $y = f(x).$" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x-3)$ is a factor of $f(x),$ so $(x-3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x-3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 3 & 1 & 1 & -4 & -24 \\\\  &  & 3 & 12 & 24 \\\\  & 1 & 4 & 8 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{f(x)}{x-3} = x^2 + 4x + 8,\n$$\n\nwhich means that\n\n$$\nf(x) = (x-3)(x^2 + 4x + 8).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $x^2 + 4x + 8 = 0$ is \n\n$$\n\\mathcal{D}= 4^2 - 4(1)(8) = -16 <                    0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=3.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & ={0}^{3}+{0}^{2}-4(0)-24=-24.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,-24),$\n\n- passes through the $x$-axis at the single root $x=3,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted ${\\textsf{S}}$-shape. Therefore, the graph looks as follows (figure not to scale):\n\n![](images/fa/fa1af56b5acbb196567d5943db53cf34405ab59cdb5e73a8a9fc8021d2864373.png)" :db/ensure [:question/validate]} {:db/id 17592186129143 :knowledge-point/questions ["question-99119256-67b3-5344-8812-e11eceeb5da0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128957 :question/problem "Sketch the curve $f(x) = -(x-2)(x^2 + 2x + 2).$" :question/worked-solution "The equation is already fully factored. Note that the discriminant of $x^2 + 2x + 2 = 0$ is \n\n$$\n\\mathcal{D}= 2^2 - 4(1)(2) = -4 <  0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=2.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-(0-2)({0}^{2}+2(0)+2) \\\\  & =-(-2)(2) \\\\  & =4\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,4),$\n\n- passes through the $x$-axis at the single root $x=2,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an ${\\textsf{S}}$-shape. Therefore, the graph looks as follows (figure not to scale):\n\n![](images/1b/1bbbfefc0260959a5008b5b4597293e0d4acdeb390601cfdb53a8d700ffbbf54.png)" :db/ensure [:question/validate]} {:db/id 17592186129146 :knowledge-point/questions ["question-07788a4c-c93b-51a6-bd5f-2540eb30230f" "question-b580f52d-26f6-5405-9c2b-c27d4700d6b2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128959 :question/problem "Given that $(x-4)$ is a factor of $f(x) = -x^3 + 4x^2 - 4x + 16,$ sketch the curve $y=f(x).$" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x-4)$ is a factor of $f(x),$ so $(x-4)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x-4)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 4 & -1 & 4 & -4 & 16 \\\\  &  & -4 & 0 & -16 \\\\  & -1 & 0 & -4 & 0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{f(x)}{x-4} & =-{x}^{2}-4 \\\\  & =-({x}^{2}+4),\\end{aligned}\n$$\n\nwhich means that\n\n$$\nf(x) = -(x-4)(x^2 + 4).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $x^2 + 4 = 0$ is \n\n$$\n\\mathcal{D} = 0^2 - 4(1)(4) = - 16  <     0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=4.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\ny = -(0)^3 + 4(0)^2 - 4(0) + 16 = 16\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,16),$\n\n- passes through the $x$-axis at the single root $x=4,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an ${\\textsf{S}}$-shape. Therefore, the graph looks as follows (figure not to scale):\n\n![](images/aa/aa0418567de10fa6bd229a3d1bfbff2a71f242232f8af8dd001b096ecc9c8038.png)" :db/ensure [:question/validate]} {:db/id "question-1114090a-5268-5e5c-ab01-061822ccfb1c" :question/id #uuid "1114090a-5268-5e5c-ab01-061822ccfb1c" :question/math-academy-id "q-75187" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=(x-4)({x}^{2}+3)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "The equation is already fully factored. Note that the discriminant of ${x}^{2}+3=0$ is \n\n$$\nD=(0)^{2}-4(1)(3)=-12<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=4.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =(0-4)({0}^{2}+3) \\\\  & =(-4)(3) \\\\  & =-12\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,-12),$\n\n- passes through the $x$-axis at the single root $x=4,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/31/310ba3049a0a91f23259a67eb3c0606749f6a83a75151d6b0d41dfc4e98706d1.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3f04ac0d-7b8b-5f4e-b670-ef5a0deac443"] :db/ensure [:question/validate]} {:db/id "answer-field-3f04ac0d-7b8b-5f4e-b670-ef5a0deac443" :answer-field/id #uuid "3f04ac0d-7b8b-5f4e-b670-ef5a0deac443" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2894aa1d-09bb-5dce-af9d-4f6e14c812e3" :answer-field/choices ["answer-c11b8b6b-1872-5d17-b8bb-6611bdc0f4e3" "answer-2894aa1d-09bb-5dce-af9d-4f6e14c812e3" "answer-399801ab-4891-5a95-8c97-e166e87d8821" "answer-2a037655-9b65-5ebf-b832-c87bb6130feb" "answer-8e8f63d2-617a-5b48-a0bf-425f5f16c222"] :db/ensure [:answer-field/validate]} {:db/id "answer-c11b8b6b-1872-5d17-b8bb-6611bdc0f4e3" :answer/id #uuid "c11b8b6b-1872-5d17-b8bb-6611bdc0f4e3" :answer/type :answer.type/image :answer/value "images/08/0852c1dbab24e5d176c9982e9c5d46f829cae9428022cc9c3b934206747b1cc7.png" :db/ensure [:answer/validate]} {:db/id "answer-2894aa1d-09bb-5dce-af9d-4f6e14c812e3" :answer/id #uuid "2894aa1d-09bb-5dce-af9d-4f6e14c812e3" :answer/type :answer.type/image :answer/value "images/31/310ba3049a0a91f23259a67eb3c0606749f6a83a75151d6b0d41dfc4e98706d1.png" :db/ensure [:answer/validate]} {:db/id "answer-399801ab-4891-5a95-8c97-e166e87d8821" :answer/id #uuid "399801ab-4891-5a95-8c97-e166e87d8821" :answer/type :answer.type/image :answer/value "images/3a/3a37d7d9d81585f7fbe688d746d42974c4331f6468150761d0f2ef9333a37554.png" :db/ensure [:answer/validate]} {:db/id "answer-2a037655-9b65-5ebf-b832-c87bb6130feb" :answer/id #uuid "2a037655-9b65-5ebf-b832-c87bb6130feb" :answer/type :answer.type/image :answer/value "images/90/90bbdf52bb7854ec9746993c9ceca5e2d27b98262b3c6ddf2d194cfeeaeb4ee3.png" :db/ensure [:answer/validate]} {:db/id "answer-8e8f63d2-617a-5b48-a0bf-425f5f16c222" :answer/id #uuid "8e8f63d2-617a-5b48-a0bf-425f5f16c222" :answer/type :answer.type/image :answer/value "images/bf/bf9765f57a5519c3d021251483cd3a97babe83d49712052d4e881ff9ecdb5f74.png" :db/ensure [:answer/validate]} {:db/id "question-f891d27b-7abc-5935-b2a7-003a7da88708" :question/id #uuid "f891d27b-7abc-5935-b2a7-003a7da88708" :question/math-academy-id "q-112427" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=(x+4)(3{x}^{2}+1)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "The equation is already fully factored. Note that the discriminant of $3{x}^{2}+1=0$ is \n\n$$\nD=(0)^{2}-4(3)(1)=-12<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=-4.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =(0+4)(3(0)^{2}+1) \\\\  & =(4)(1) \\\\  & =4\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,4),$\n\n- passes through the $x$-axis at the single root $x=-4,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/fa/fa8a5e889a374aae31d7cf7dd82581b00c4d74abfc08b14721f1da3ea19b2e95.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9b83f475-f63f-50c5-aa47-1f832d4a1605"] :db/ensure [:question/validate]} {:db/id "answer-field-9b83f475-f63f-50c5-aa47-1f832d4a1605" :answer-field/id #uuid "9b83f475-f63f-50c5-aa47-1f832d4a1605" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2abd7b01-78b3-5242-a601-d2ef07b80ad9" :answer-field/choices ["answer-b6cb9a87-d708-50b6-a39e-33a416ff452a" "answer-77dcd354-9b84-55c2-af06-8f1ec192e3b7" "answer-8acebe57-509e-5cb0-ae9e-c8309c5783f0" "answer-6a731023-f149-5d7e-8f43-28d7661afe31" "answer-2abd7b01-78b3-5242-a601-d2ef07b80ad9"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6cb9a87-d708-50b6-a39e-33a416ff452a" :answer/id #uuid "b6cb9a87-d708-50b6-a39e-33a416ff452a" :answer/type :answer.type/image :answer/value "images/8c/8cf40e338097e3686a17b553aa225e791fdb2257dd1a479885139dec6d3a9fd6.png" :db/ensure [:answer/validate]} {:db/id "answer-77dcd354-9b84-55c2-af06-8f1ec192e3b7" :answer/id #uuid "77dcd354-9b84-55c2-af06-8f1ec192e3b7" :answer/type :answer.type/image :answer/value "images/a5/a5fbc1a0714085042ca131d298f86a064aec35657e0fead5c67b6029d90b3cc7.png" :db/ensure [:answer/validate]} {:db/id "answer-8acebe57-509e-5cb0-ae9e-c8309c5783f0" :answer/id #uuid "8acebe57-509e-5cb0-ae9e-c8309c5783f0" :answer/type :answer.type/image :answer/value "images/b0/b084ee964d74c0c57e9ae91d3feacf80f19529b811f802ef2a3e724e6abbe092.png" :db/ensure [:answer/validate]} {:db/id "answer-6a731023-f149-5d7e-8f43-28d7661afe31" :answer/id #uuid "6a731023-f149-5d7e-8f43-28d7661afe31" :answer/type :answer.type/image :answer/value "images/d3/d322525e8872269fae28165bfacd7babc83a19fda176fd9940a852466d79fb04.png" :db/ensure [:answer/validate]} {:db/id "answer-2abd7b01-78b3-5242-a601-d2ef07b80ad9" :answer/id #uuid "2abd7b01-78b3-5242-a601-d2ef07b80ad9" :answer/type :answer.type/image :answer/value "images/fa/fa8a5e889a374aae31d7cf7dd82581b00c4d74abfc08b14721f1da3ea19b2e95.png" :db/ensure [:answer/validate]} {:db/id "question-8e99018d-106a-536c-a32e-4bcfd5c27a01" :question/id #uuid "8e99018d-106a-536c-a32e-4bcfd5c27a01" :question/math-academy-id "q-112435" :question/problem "Given that $(x-3)$ is a factor of $f(x)=3{x}^{3}-9{x}^{2}+x-3,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x-3)$ is a factor of $f(x),$ so $(x-3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x-3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 3 & 3 & -9 & 1 & -3 \\\\  &  & 9 & 0 & 3 \\\\  & 3 & 0 & 1 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{f(x)}{x-3}=3{x}^{2}+1\n$$\n\nwhich means that\n\n$$\nf(x)=(x-3)(3{x}^{2}+1).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $3{x}^{2}+1=0$ is \n\n$$\nD=(0)^{2}-4(3)(1)=-12<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=3.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =3(0)^{3}-9(0)^{2}+0-3=-3.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,-3),$\n\n- passes through the $x$-axis at the single root $x=3,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/7a/7a04ed5e26758551d7eca9949a274884f28f43a001439b58e393470721d96e5d.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5fab39b0-c0b6-5581-852e-d6af4250c9fe"] :db/ensure [:question/validate]} {:db/id "answer-field-5fab39b0-c0b6-5581-852e-d6af4250c9fe" :answer-field/id #uuid "5fab39b0-c0b6-5581-852e-d6af4250c9fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd885a19-30b9-5fa7-8234-2b884c2e081c" :answer-field/choices ["answer-66fa054a-3434-5832-a6d3-05c9bf94cabd" "answer-dd885a19-30b9-5fa7-8234-2b884c2e081c" "answer-df1fc0a1-3c75-5121-a158-2789988b928d" "answer-bcfd3779-a56b-5dc0-bbd4-92df91a639ac" "answer-c14e9c27-ee53-58ac-bc1f-538c1b3160ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-66fa054a-3434-5832-a6d3-05c9bf94cabd" :answer/id #uuid "66fa054a-3434-5832-a6d3-05c9bf94cabd" :answer/type :answer.type/image :answer/value "images/63/633941510daf5f1edb6566ee416767d303e53e7aa15325087929b91cdefb94f1.png" :db/ensure [:answer/validate]} {:db/id "answer-dd885a19-30b9-5fa7-8234-2b884c2e081c" :answer/id #uuid "dd885a19-30b9-5fa7-8234-2b884c2e081c" :answer/type :answer.type/image :answer/value "images/7a/7a04ed5e26758551d7eca9949a274884f28f43a001439b58e393470721d96e5d.png" :db/ensure [:answer/validate]} {:db/id "answer-df1fc0a1-3c75-5121-a158-2789988b928d" :answer/id #uuid "df1fc0a1-3c75-5121-a158-2789988b928d" :answer/type :answer.type/image :answer/value "images/9b/9bd03d441a7c5acfef36d8d8534da911c27f8c78387eddb7717371ae90d01d16.png" :db/ensure [:answer/validate]} {:db/id "answer-bcfd3779-a56b-5dc0-bbd4-92df91a639ac" :answer/id #uuid "bcfd3779-a56b-5dc0-bbd4-92df91a639ac" :answer/type :answer.type/image :answer/value "images/b0/b066c8462d80e759850baf1ac4b4011073f5a866e9d5eff47e06c4a3ec8b63ff.png" :db/ensure [:answer/validate]} {:db/id "answer-c14e9c27-ee53-58ac-bc1f-538c1b3160ec" :answer/id #uuid "c14e9c27-ee53-58ac-bc1f-538c1b3160ec" :answer/type :answer.type/image :answer/value "images/f9/f9bcde0b753f45a491cbf378128d1523c0a40c7fafd2d6a182b28d0d55aced91.png" :db/ensure [:answer/validate]} {:db/id "question-99119256-67b3-5344-8812-e11eceeb5da0" :question/id #uuid "99119256-67b3-5344-8812-e11eceeb5da0" :question/math-academy-id "q-28197" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=\\frac{1}{8}(4-x)({x}^{2}+6)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "The equation is already fully factored. Note that the discriminant of ${x}^{2}+6=0$ is \n\n$$\nD={0}^{2}-4(1)(6)=-24<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=4.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{8}(4-0)({0}^{2}+6) \\\\  & =\\frac{(4)(6)}{8} \\\\  & =3.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,3),$\n\n- passes through the $x$-axis at the single root $x=4,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/79/795ec06d95058de55d870db3a7559f44277003afdfd5ce1231493abd520404e2.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-533637cd-4954-5318-b1fb-8100971c8607"] :db/ensure [:question/validate]} {:db/id "answer-field-533637cd-4954-5318-b1fb-8100971c8607" :answer-field/id #uuid "533637cd-4954-5318-b1fb-8100971c8607" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-800ff475-823f-520a-bb9a-7ed63df0be1b" :answer-field/choices ["answer-5cf4e2a9-4940-50d9-ae18-6efd87d160a4" "answer-b70256e0-11d0-59c2-83f5-acf63d9cbb81" "answer-9a7ac8e1-e340-5006-a03e-b80b3ee17727" "answer-800ff475-823f-520a-bb9a-7ed63df0be1b" "answer-0c8ab678-e96f-5ebb-9983-b70a82dda722"] :db/ensure [:answer-field/validate]} {:db/id "answer-5cf4e2a9-4940-50d9-ae18-6efd87d160a4" :answer/id #uuid "5cf4e2a9-4940-50d9-ae18-6efd87d160a4" :answer/type :answer.type/image :answer/value "images/46/46ebde8dcd681cd48ff30dfc839bab3c5176496632398e5c3e530be61389603e.png" :db/ensure [:answer/validate]} {:db/id "answer-b70256e0-11d0-59c2-83f5-acf63d9cbb81" :answer/id #uuid "b70256e0-11d0-59c2-83f5-acf63d9cbb81" :answer/type :answer.type/image :answer/value "images/5a/5ac8512632c0609e6fe19a3bba8d17d3b665c7d3fd1b96135c9f0dc23c170526.png" :db/ensure [:answer/validate]} {:db/id "answer-9a7ac8e1-e340-5006-a03e-b80b3ee17727" :answer/id #uuid "9a7ac8e1-e340-5006-a03e-b80b3ee17727" :answer/type :answer.type/image :answer/value "images/76/76e55d2573b66e07b0b8f927bb5dc1a4e7210f71cd979ebedc9b13e044311d21.png" :db/ensure [:answer/validate]} {:db/id "answer-800ff475-823f-520a-bb9a-7ed63df0be1b" :answer/id #uuid "800ff475-823f-520a-bb9a-7ed63df0be1b" :answer/type :answer.type/image :answer/value "images/79/795ec06d95058de55d870db3a7559f44277003afdfd5ce1231493abd520404e2.png" :db/ensure [:answer/validate]} {:db/id "answer-0c8ab678-e96f-5ebb-9983-b70a82dda722" :answer/id #uuid "0c8ab678-e96f-5ebb-9983-b70a82dda722" :answer/type :answer.type/image :answer/value "images/ed/ed54bc47e32b1bd7cef59653a3c37b3d4fac0dc3e806b8a8aab07087b19e5890.png" :db/ensure [:answer/validate]} {:db/id 17592186129572 :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=\\frac{1}{3}(2-x)({x}^{2}+3x+3)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "The equation is already fully factored. Note that the discriminant of ${x}^{2}+3x+3=0$ is \n\n$$\nD=(3)^{2}-4(1)(3)=-3<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that the function $f(x)$ has a single root at $x=2.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{3}(2-0)({0}^{2}+3(0)+3) \\\\  & =\\frac{(2)(3)}{3} \\\\  & =2.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at the point $(0,2),$\n\n- passes through the $x$-axis at the single root $x=2,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/da/dac93a6d36f27b7c9eeb6640370d3736fa8353ee12697721a8ab1b416915dbef.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186126917 :answer-field/correct 17592186126921 :db/ensure [:answer-field/validate]} {:db/id "question-07788a4c-c93b-51a6-bd5f-2540eb30230f" :question/id #uuid "07788a4c-c93b-51a6-bd5f-2540eb30230f" :question/math-academy-id "q-112498" :question/problem "Given that $(x+3)$ is a factor of $f(x)=-4{x}^{3}-12{x}^{2}-3x-9,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+3)$ is a factor of $f(x),$ so $(x+3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & -4 & -12 & -3 & -9 \\\\  &  & 12 & 0 & 9 \\\\  & -4 & 0 & -3 & 0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{f(x)}{x+3} & =-4{x}^{2}-3 \\\\  & =-(4{x}^{2}+3),\\end{aligned}\n$$\n\nwhich means that\n\n$$\nf(x)=-(x+3)(4{x}^{2}+3).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $4{x}^{2}+3=0$ is \n\n$$\nD=(0)^{2}-4(4)(3)=-48<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=-3.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\ny=-4(0)^{3}-12(0)^{2}-3(0)-9=-9\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,-9),$\n\n- passes through the $x$-axis at the single root $x=-3,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/1d/1d05449fcf2c39749736b58099a32f59ff85566d5ea56d0e4ec61e88da8ce7aa.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d704154a-6d5d-5adf-9ea8-05adad19a091"] :db/ensure [:question/validate]} {:db/id "answer-field-d704154a-6d5d-5adf-9ea8-05adad19a091" :answer-field/id #uuid "d704154a-6d5d-5adf-9ea8-05adad19a091" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e79d2ae1-97a4-550d-9639-0b5d74bc2af2" :answer-field/choices ["answer-83bbbbb6-eb3f-52b8-b9ce-ba99291b2891" "answer-e79d2ae1-97a4-550d-9639-0b5d74bc2af2" "answer-c114a863-3a02-52d0-9af8-557179f1db73" "answer-1f7285b2-42c9-5a72-b2d5-5c262ae4ea3b" "answer-1e1851c0-2e94-5cbb-9238-911d535aad6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-83bbbbb6-eb3f-52b8-b9ce-ba99291b2891" :answer/id #uuid "83bbbbb6-eb3f-52b8-b9ce-ba99291b2891" :answer/type :answer.type/image :answer/value "images/13/13f9151db533e2ec997a5b2eef5ee49eaa8dea9d1b37f7f0cc853434f1360ca3.png" :db/ensure [:answer/validate]} {:db/id "answer-e79d2ae1-97a4-550d-9639-0b5d74bc2af2" :answer/id #uuid "e79d2ae1-97a4-550d-9639-0b5d74bc2af2" :answer/type :answer.type/image :answer/value "images/1d/1d05449fcf2c39749736b58099a32f59ff85566d5ea56d0e4ec61e88da8ce7aa.png" :db/ensure [:answer/validate]} {:db/id "answer-c114a863-3a02-52d0-9af8-557179f1db73" :answer/id #uuid "c114a863-3a02-52d0-9af8-557179f1db73" :answer/type :answer.type/image :answer/value "images/5e/5eebba3872aa018aa6a2058d84e3a3ea90837b670ac15fd49f1d083496efe2ec.png" :db/ensure [:answer/validate]} {:db/id "answer-1f7285b2-42c9-5a72-b2d5-5c262ae4ea3b" :answer/id #uuid "1f7285b2-42c9-5a72-b2d5-5c262ae4ea3b" :answer/type :answer.type/image :answer/value "images/88/883cb4c02844df9c8ae0db49aa2db235d1e71da262420ccf570ca9acdcfbf2e5.png" :db/ensure [:answer/validate]} {:db/id "answer-1e1851c0-2e94-5cbb-9238-911d535aad6a" :answer/id #uuid "1e1851c0-2e94-5cbb-9238-911d535aad6a" :answer/type :answer.type/image :answer/value "images/b5/b5555c7c291b522600a2afd422fd5ba79d9ede51c2392057d7ed79977386e040.png" :db/ensure [:answer/validate]} {:db/id "question-b580f52d-26f6-5405-9c2b-c27d4700d6b2" :question/id #uuid "b580f52d-26f6-5405-9c2b-c27d4700d6b2" :question/math-academy-id "q-39094" :question/problem "Given that $(x+1)$ is a factor of $f(x)=-2{x}^{3}-4{x}^{2}-5x-3,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+1)$ is a factor of $f(x),$ so $(x+1)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+1)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -1 & -2 & -4 & -5 & -3 \\\\  &  & 2 & 2 & 3 \\\\  & -2 & -2 & -3 & 0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{f(x)}{x+1} & =-2{x}^{2}-2x-3 \\\\  & =-(2{x}^{2}+2x+3),\\end{aligned}\n$$\n\nwhich means that\n\n$$\nf(x)=-(x+1)(2{x}^{2}+2x+3).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $2{x}^{2}+2x+3=0$ is \n\n$$\nD=(2)^{2}-4(2)(3)=-20<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=-1.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\ny=-2(0)^{3}-4(0)^{2}-5(0)-3=-3\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,-3),$\n\n- passes through the $x$-axis at the single root $x=-1,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is negative, the graph has an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/d3/d391911307bc35f7481fe8b3a0b3871d1c4b75cc44d4459018fe00b14133f4f9.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-abe85277-a616-5cbf-990b-1747df437c1a"] :db/ensure [:question/validate]} {:db/id "answer-field-abe85277-a616-5cbf-990b-1747df437c1a" :answer-field/id #uuid "abe85277-a616-5cbf-990b-1747df437c1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9e2affa-0916-50f7-a8bb-a628a95d474e" :answer-field/choices ["answer-41324b3f-3759-54c1-9d02-556c07fe636b" "answer-11e100e5-9655-5afe-9d8d-3f3667556e68" "answer-3bc5ea52-a79c-59fd-9c64-5b4e4acf2345" "answer-955b475b-a661-58ae-a357-e025ab522fd2" "answer-c9e2affa-0916-50f7-a8bb-a628a95d474e"] :db/ensure [:answer-field/validate]} {:db/id "answer-41324b3f-3759-54c1-9d02-556c07fe636b" :answer/id #uuid "41324b3f-3759-54c1-9d02-556c07fe636b" :answer/type :answer.type/image :answer/value "images/00/00a7820952a0c243ce3f3c03915a1cdc17c02fa0f49e52d3acf6885cae2c4d12.png" :db/ensure [:answer/validate]} {:db/id "answer-11e100e5-9655-5afe-9d8d-3f3667556e68" :answer/id #uuid "11e100e5-9655-5afe-9d8d-3f3667556e68" :answer/type :answer.type/image :answer/value "images/19/19a62466d622c23d874043f565efa9a1339b8c3c1e8ccd9b10e1816c02bbd1f7.png" :db/ensure [:answer/validate]} {:db/id "answer-3bc5ea52-a79c-59fd-9c64-5b4e4acf2345" :answer/id #uuid "3bc5ea52-a79c-59fd-9c64-5b4e4acf2345" :answer/type :answer.type/image :answer/value "images/3e/3e030ee4d5762ea111005d7adda728938fbdee59b2c95540ed3122042b40f9b4.png" :db/ensure [:answer/validate]} {:db/id "answer-955b475b-a661-58ae-a357-e025ab522fd2" :answer/id #uuid "955b475b-a661-58ae-a357-e025ab522fd2" :answer/type :answer.type/image :answer/value "images/83/83b4e298dce636116b0eae382640af0802f7632865092c52495eb5921e13e273.png" :db/ensure [:answer/validate]} {:db/id "answer-c9e2affa-0916-50f7-a8bb-a628a95d474e" :answer/id #uuid "c9e2affa-0916-50f7-a8bb-a628a95d474e" :answer/type :answer.type/image :answer/value "images/d3/d391911307bc35f7481fe8b3a0b3871d1c4b75cc44d4459018fe00b14133f4f9.png" :db/ensure [:answer/validate]} {:db/id 17592186130361 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d,$ where $a >0,$ has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty.$ This means that every such function has at least one real root and at most three distinct roots. \n\nFor instance, suppose that we want to plot the graph of $y = x^3-3x^2 +3x-1.$ First, we need to find the roots, so we set $y=0$ and solve. Noting that the polynomial is a perfect cube, we find\n\n$$\n\\begin{aligned}{x}^{3}-3{x}^{2}+3x-1 & =0 \\\\ (x-1)^{3} & =0.\\end{aligned}\n$$\n\nSo we get one real root $x=1,$ which has multiplicity $3.$ \n\nAt a root of multiplicity $3,$ the graph becomes **tangent** (i.e., lies parallel) to the $x$-axis and crosses the $x$-axis. \n\nTherefore, the graph looks as follows:\n\n![](images/d8/d87834ef3f7225b00d92e6051a67735cf6695c5a2eff9635c4de416d0be1577f.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186130364 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d,$ where $a <0,$ has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty.$\n\nFor instance, suppose that we want to plot the graph of $y = -x^3+3x^2 -3x+1.$ First, we need to find the roots, so we set $y=0$ and solve. Noting that the polynomial is a perfect cube, we find\n\n$$\n\\begin{aligned}-{x}^{3}+3{x}^{2}-3x+1 & =0 \\\\ (-x+1)^{3} & =0 \\\\ -(x-1)^{3} & =0.\\end{aligned}\n$$\n\nSo we get one real root $x=1,$ which has multiplicity $3.$ \n\nAt a root of multiplicity $3,$ the graph becomes tangent to the $x$-axis and crosses the $x$-axis. Therefore, the graph looks as follows:\n\n![](images/5c/5cd99c1f2a3a596002edc222e0d9b13969286a49361fc804fe7db8818017980b.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186129396 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} [:db/retract 17592186132385 :answer-field/choices 17592186132386] [:db/retract 17592186132385 :answer-field/choices 17592186132387] [:db/retract 17592186132385 :answer-field/choices 17592186132388] [:db/retract 17592186132385 :answer-field/choices 17592186132389] [:db/retract 17592186132385 :answer-field/choices 17592186132390] {:db/id 17592186133807 :knowledge-point/questions ["question-00de20be-fb8b-5429-9f53-91cef5d33e1f" "question-d4ec7326-5bae-578c-95b2-63886efafa8e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-00de20be-fb8b-5429-9f53-91cef5d33e1f" :question/id #uuid "00de20be-fb8b-5429-9f53-91cef5d33e1f" :question/math-academy-id "q-139602" :question/problem "| $x$ | **$0$** | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-4$ | $-5$ | $2$ | $-1$ | $-3$ |\n\nConsider the data above and the matrices below. Find an expression for the vector of coefficients of the curve $y={\\beta }_{0}+{\\beta }_{1}x+{\\beta }_{2}{x}^{2}+{\\beta }_{3}{x}^{3}$ that best fits the data. \n\n$$\nX=[\\begin{aligned}1 & 0 & {0}^{2} & {0}^{3} \\\\ 1 & 1 & {1}^{2} & {1}^{3} \\\\ 1 & 2 & {2}^{2} & {2}^{3} \\\\ 1 & 3 & {3}^{2} & {3}^{3} \\\\ 1 & 4 & {4}^{2} & {4}^{3}\\end{aligned}],\\,\\beta =[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2} \\\\ {\\beta }_{3}\\end{aligned}],\\,y=[\\begin{aligned}-4 \\\\ -5 \\\\ 2 \\\\ -1 \\\\ -3\\end{aligned}]\n$$" :question/worked-solution "The coefficients of the curve \n\n$$\ny={\\beta }_{0}+{\\beta }_{1}x+{\\beta }_{2}{x}^{2}+{\\beta }_{3}{x}^{3}\n$$\n\nthat best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\nX\\beta =y,\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ad1b0b7c-6e3e-51ee-a44a-6fd53fc22808"] :db/ensure [:question/validate]} {:db/id "answer-field-ad1b0b7c-6e3e-51ee-a44a-6fd53fc22808" :answer-field/id #uuid "ad1b0b7c-6e3e-51ee-a44a-6fd53fc22808" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer