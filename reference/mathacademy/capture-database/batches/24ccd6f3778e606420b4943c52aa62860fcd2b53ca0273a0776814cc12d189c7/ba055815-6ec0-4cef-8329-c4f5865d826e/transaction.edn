ge :answer/value "images/66/66247bc06e12fbb378427dae64c9dd6f6c2898c4069709223a18e9073928d209.png" :db/ensure [:answer/validate]} {:db/id "answer-54ede07e-edf1-5974-92ae-ec92ea7eafac" :answer/id #uuid "54ede07e-edf1-5974-92ae-ec92ea7eafac" :answer/type :answer.type/image :answer/value "images/86/8662eb22e4eefaed4676121979961cdaaf6c277e3bea7a4bf3801da14247bde3.png" :db/ensure [:answer/validate]} {:db/id "answer-9d9bdb69-12c0-5f12-9b2f-844d069f9531" :answer/id #uuid "9d9bdb69-12c0-5f12-9b2f-844d069f9531" :answer/type :answer.type/image :answer/value "images/e6/e6081e37624ab73cd46fe82df53e9c0a478c3fabe26ec3c98d7e79b4d75ecc18.png" :db/ensure [:answer/validate]} {:db/id "question-d0398ee6-00a7-50a0-8e21-d6ea37fa1ef7" :question/id #uuid "d0398ee6-00a7-50a0-8e21-d6ea37fa1ef7" :question/math-academy-id "q-88512" :question/problem "Plot the graph of $x=-{y}^{2}-\\frac{8y}{5}.$" :question/worked-solution "To plot $x=-{y}^{2}-\\frac{8y}{5},$ we will first plot the function $y=-{x}^{2}-\\frac{8x}{5}$ and then reflect it over the line $y=x.$\n\nThe curve $y=-{x}^{2}-\\frac{8x}{5}$ is a parabola. It has the following factored form:\n\n$$\ny=-x(x+\\frac{8}{5})\n$$\n\nFrom the factored form above, we get the following graph:\n\n![](images/26/26a35ba2e93c08af12f916f16ad40f46a8ea0242e23bc516d279a015094db872.png)\n\nNow, to get the curve $x=-{y}^{2}-\\frac{8y}{5},$ we just have to reflect the curve $y=-{x}^{2}-\\frac{8x}{5}$ over the line $y=x,$ as follows:\n\n![](images/04/049683350600f401aa18feb6d5ea5662965ba0740f4b23a524e93e40f61f0bc4.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8a4fecf1-a72a-591a-b4b8-4840c5d99df7"] :db/ensure [:question/validate]} {:db/id "answer-field-8a4fecf1-a72a-591a-b4b8-4840c5d99df7" :answer-field/id #uuid "8a4fecf1-a72a-591a-b4b8-4840c5d99df7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-730e017e-d80a-517b-91f2-c8bc65209137" :answer-field/choices ["answ