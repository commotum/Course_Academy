5-8966-efc4693d635c" :db/ensure [:step/validate]} {:db/id "step-9b0e4e07-3c1a-5e15-8966-efc4693d635c" :step/id #uuid "9b0e4e07-3c1a-5e15-8966-efc4693d635c" :step/content "question-a83f3a56-7f37-59d6-8ed6-dd0cc81608ee" :step/next "step-20da1ed7-1f0c-5835-8b4d-dcc25234e0b0" :db/ensure [:step/validate]} {:db/id "step-20da1ed7-1f0c-5835-8b4d-dcc25234e0b0" :step/id #uuid "20da1ed7-1f0c-5835-8b4d-dcc25234e0b0" :step/content "question-e2ad2fef-a91c-56d1-9362-f2fbd4a52e56" :step/next "step-28175361-001a-5814-a2f8-5b17cada3b66" :db/ensure [:step/validate]} {:db/id "step-28175361-001a-5814-a2f8-5b17cada3b66" :step/id #uuid "28175361-001a-5814-a2f8-5b17cada3b66" :step/content "question-4c0f5df5-2d8b-5cef-a048-d87044456178" :step/next "step-711a72fe-d404-510a-8960-ed2ab6a98eaa" :db/ensure [:step/validate]} {:db/id "step-711a72fe-d404-510a-8960-ed2ab6a98eaa" :step/id #uuid "711a72fe-d404-510a-8960-ed2ab6a98eaa" :step/content 17592186308634 :db/ensure [:step/validate]} [:db/retract 17592186080093 :answer-field/choices 17592186080096] [:db/retract 17592186080093 :answer-field/choices 17592186080097] [:db/retract 17592186080093 :answer-field/choices 17592186080098] [:db/retract 17592186080093 :answer-field/choices 17592186080094] [:db/retract 17592186080093 :answer-field/choices 17592186080095] {:db/id 17592186083246 :knowledge-point/questions ["question-36a20ff4-bc02-5ebc-9459-ae85a99d7c37"] :db/ensure [:knowledge-point/validate]} {:db/id "question-36a20ff4-bc02-5ebc-9459-ae85a99d7c37" :question/id #uuid "36a20ff4-bc02-5ebc-9459-ae85a99d7c37" :question/math-academy-id "q-14116" :question/problem "Find all the real solutions to the equation $5{b}^{3}+12{b}^{2}+20b+48=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}5{b}^{3}+12{b}^{2}+20b+48 & = \\\\ (5{b}^{3}+12{b}^{2})+(20b+48) & = \\\\ {b}^{2}(5b+12)+4(5b+12) & = \\\\ (5b+12)\\cdot {b}^{2}+(5b+12)\\cdot 4 & = \\\\ (5b+12)({b}^{2}+4) & .\\end{aligned}\n$$\n\nThen, we solve $(5b+12)({b}^{2}+4)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(5b+12)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}5b+12 & =0 \\\\ 5b & =-12 \\\\ b & =-\\frac{12}{5}.\\end{aligned}\n$$\n\n- Setting the factor $({b}^{2}+4)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{b}^{2}+4 & =0 \\\\ {b}^{2} & =-4.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${b}^{2}+4=0$ has no real solutions.\n\nTherefore,  $b=-\\frac{12}{5}$ is the only real solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-81b1231e-91d3-5a68-9071-c04003144caf"] :db/ensure [:question/validate]} {:db/id "answer-field-81b1231e-91d3-5a68-9071-c04003144caf" :answer-field/id #uuid "81b1231e-91d3-5a68-9071-c04003144caf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer-field/choices ["answer-9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" "answer-8934827e-e1a4-57aa-b9c6-f41a1c0f56fc" "answer-f6db3fe8-7692-5d66-b32a-4fca3ee9ca87" "answer-f26e943a-7ae3-5e4c-8e3a-b37f9af30ceb" "answer-aaca70d2-4202-5062-ab16-0babf7140c48"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer/id #uuid "9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer/type :answer.type/math :answer/value "b=-\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8934827e-e1a4-57aa-b9c6-f41a1c0f56fc" :answer/id #uuid "8934827e-e1a4-57aa-b9c6-f41a1c0f56fc" :answer/type :answer.type/math :answer/value "b=-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f6db3fe8-7692-5d66-b32a-4fca3ee9ca87" :answer/id #uuid "f6db3fe8-7692-5d66-b32a-4fca3ee9ca87" :answer/type :answer.type/math :answer/value "b=\\frac{12}{5},\\,\\pm \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-f26e943a-7ae3-5e4c-8e3a-b37f9af30ceb" :answer/id #uuid "f26e943a-7ae3-5e4c-8e3a-b37f9af30ceb" :answer/type :answer.type/math :answer/value "b=\\pm 2" :db/ensure [:answer/validate]} {:db/id "answer-aaca70d2-4202-5062-ab16-0babf7140c48" :answer/id #uuid "aaca70d2-4202-5062-ab16-0babf7140c48" :answer/type :answer.type/math :answer/value "b=\\pm \\sqrt{\\frac{12}{5}}" :db/ensure [:answer/validate]} {:db/id 17592186083533 :question/problem "Find all of the real solutions to the equation $8{z}^{3}-{z}^{2}+40z-5=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}8{z}^{3}-{z}^{2}+40z-5 & = \\\\ (8{z}^{3}-{z}^{2})+(40z-5) & = \\\\ {z}^{2}(8z-1)+5(8z-1) & = \\\\ (8z-1)\\cdot {z}^{2}+(8z-1)\\cdot 5 & = \\\\ (8z-1)({z}^{2}+5) & .\\end{aligned}\n$$\n\nThen, we solve $(8z-1)({z}^{2}+5)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(8z-1)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}8z-1 & =0 \\\\ 8z & =1 \\\\ z & =\\frac{1}{8}.\\end{aligned}\n$$\n\n- Setting the factor $({z}^{2}+5)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{z}^{2}+5 & =0 \\\\ {z}^{2} & =-5.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${z}^{2}+5=0$ has no real solutions.\n\nTherefore,  $z=\\frac{1}{8}$ is the only real solution." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186080093 :answer-field/correct "answer-930004be-d1b4-5e3b-893e-3a1546cc1415" :answer-field/choices ["answer-8c6dad2e-76cd-5eb2-9262-987f295943fb" "answer-930004be-d1b4-5e3b-893e-3a1546cc1415" "answer-c3c85e04-d71d-5e43-9091-e3ca1a560f38" "answer-c9f37bc2-6b85-584e-b346-e0758e8750b9" "answer-99ad43d7-bf48-53af-850a-7eaa1d489b83"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c6dad2e-76cd-5eb2-9262-987f295943fb" :answer/id #uuid "8c6dad2e-76cd-5eb2-9262-987f295943fb" :answer/type :answer.type/math :answer/value "z=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-930004be-d1b4-5e3b-893e-3a1546cc1415" :answer/id #uuid "930004be-d1b4-5e3b-893e-3a1546cc1415" :answer/type :answer.type/math :answer/value "z=\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-c3c85e04-d71d-5e43-9091-e3ca1a560f38" :answer/id #uuid "c3c85e04-d71d-5e43-9091-e3ca1a560f38" :answer/type :answer.type/math :answer/value "z=\\frac{1}{8},\\,\\pm \\sqrt{\\frac{1}{2}}" :db/ensure [:answer/validate]} {:db/id "answer-c9f37bc2-6b85-584e-b346-e0758e8750b9" :answer/id #uuid "c9f37bc2-6b85-584e-b346-e0758e8750b9" :answer/type :answer.type/math :answer/value "z=\\pm 5" :db/ensure [:answer/validate]} {:db/id "answer-99ad43d7-bf48-53af-850a-7eaa1d489b83" :answer/id #uuid "99ad43d7-bf48-53af-850a-7eaa1d489b83" :answer/type :answer.type/math :answer/value "z=\\pm \\sqrt{\\frac{1}{8}}" :db/ensure [:answer/validate]} {:db/id 17592186083275 :knowledge-point/questions ["question-a043cae8-5322-50e0-9c25-76e939ce12b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a043cae8-5322-50e0-9c25-76e939ce12b0" :question/id #uuid "a043cae8-5322-50e0-9c25-76e939ce12b0" :question/math-academy-id "q-72032" :question/problem "Solve $-{y}^{3}+3{y}^{2}+2y-6=0.$" :question/worked-solution "First, we multiply the equation by $-1$ to make the coefficient of the cubic term positive. This gives\n\n$$\n{y}^{3}-3{y}^{2}-2y+6=0.\n$$\n\nWe then proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}{y}^{3}-3{y}^{2}-2y+6 & = \\\\ ({y}^{3}-3{y}^{2})+(-2y+6) & = \\\\ {y}^{2}(y-3)-2(y-3) & = \\\\ ({y}^{2}-2)(y-3) & \\end{aligned}\n$$\n\nThen, we solve $({y}^{2}-2)(y-3)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $({y}^{2}-2)$ equal to $0,$ we get $y=\\pm \\sqrt{2}.$\n\n- Setting the factor $(y-3)$ equal to $0,$ we get $y=3.$\n\nTherefore, the solutions are $y=3,\\,\\pm \\sqrt{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-543735e3-a26c-5ffd-9ec2-86ffb989af36"] :db/ensure [:question/validate]} {:db/id "answer-field-543735e3-a26c-5ffd-9ec2-86ffb989af36" :answer-field/id #uuid "543735e3-a26c-5ffd-9ec2-86ffb989af36" :answer-field/key