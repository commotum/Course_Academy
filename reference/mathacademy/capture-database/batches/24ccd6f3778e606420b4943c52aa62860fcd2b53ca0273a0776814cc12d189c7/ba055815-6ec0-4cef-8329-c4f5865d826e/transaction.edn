 :db/ensure [:answer/validate]} {:db/id "activity-10f6eef1-5078-55a6-b949-5b4bf786db94" :activity/id #uuid "10f6eef1-5078-55a6-b949-5b4bf786db94" :activity/title "Solving Inhomogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186050707 :activity/course 17592186046669 :activity/steps ["step-a7f36150-a323-543f-a05f-ad14ac2a2c6c" "step-3cf553b5-a0c0-5e03-adcb-b5e28abcb810" "step-8b6c1363-f2b6-518d-a59c-19b0d9f1d213"] :activity/first-step "step-a7f36150-a323-543f-a05f-ad14ac2a2c6c" :db/ensure [:activity/validate]} {:db/id "step-a7f36150-a323-543f-a05f-ad14ac2a2c6c" :step/id #uuid "a7f36150-a323-543f-a05f-ad14ac2a2c6c" :step/content "question-9a3f4d85-0623-5fd9-9cc9-8c8eac44c1ca" :step/next "step-3cf553b5-a0c0-5e03-adcb-b5e28abcb810" :db/ensure [:step/validate]} {:db/id "step-3cf553b5-a0c0-5e03-adcb-b5e28abcb810" :step/id #uuid "3cf553b5-a0c0-5e03-adcb-b5e28abcb810" :step/content 17592186308695 :step/next "step-8b6c1363-f2b6-518d-a59c-19b0d9f1d213" :db/ensure [:step/validate]} {:db/id "step-8b6c1363-f2b6-518d-a59c-19b0d9f1d213" :step/id #uuid "8b6c1363-f2b6-518d-a59c-19b0d9f1d213" :step/content "question-cb2daa37-d9b1-570d-9a42-38ab64cc0e59" :db/ensure [:step/validate]} {:db/id 17592186179637 :knowledge-point/questions ["question-400da920-5753-5f4c-8f7e-782c1d5a4a17" "question-713cc6c3-9177-55d5-83bc-303e3a63514e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179480 :question/problem "Calculate the fourth term of the sequence\n\n$$\nf(n+1) = f(n) -6, \\quad f(1) = 1, \\quad n\\geq 1.\n$$" :question/worked-solution "Starting with the first term $f(1)=1,$ we compute the next terms using the recursive rule until we reach the fourth term $f(4).$\n\n$$\n\\begin{aligned}f(1) & =1 \\\\ f(2) & =f(1)-6=1-6=-5 \\\\ f(3) & =f(2)-6=-5-6=-11 \\\\ f(4) & =f(3)-6=-11-6=-17\\end{aligned}\n$$\n\nTherefore, the fourth term is $f(4)=-17.$" :db/ensure [:question/validate]} {:db/id 17592186179638 :knowledge-point/questions ["question-654db483-a24c-50a6-ad12-4b6cce747a3d" "question-d05d25db-b298-5134-b608-67b85d063ed0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179481 :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n4,\\: 9,\\: 14,\\: \\ldots\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\na_{n+1} =a_n+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =9-4 \\\\  & =5.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\na_{n+1}= a_n + 5, \\quad a_1=4, \\quad n\\geq 1\\,.\n$$" :db/ensure [:question/validate]} {:db/id "question-400da920-5753-5f4c-8f7e-782c1d5a4a17" :question/id #uuid "400da920-5753-5f4c-8f7e-782c1d5a4a17" :question/math-academy-id "q-44935" :question/problem "An arithmetic sequence $f(n)$ is defined by \n\n$$\nf(n+1)=f(n)-7,\\,f(1)=4,\\,n\\ge 1.\n$$\n\nWhat is the $4$th term of the sequence?" :question/worked-solution "Starting with the first term $f(1)=4,$ we compute the next terms using the recursive rule until we reach the $4$th term $f(4).$\n\n$$\n\\begin{aligned}f(1) & =4 \\\\ f(2) & =f(1)-7=4-7=-3 \\\\ f(3) & =f(2)-7=-3-7=-10 \\\\ f(4) & =f(3)-7=-10-7=-17\\end{aligned}\n$$\n\nTherefore, the $4$th term is $f(4)=-17.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4a0881a6-c4d5-5f55-bec9-94814f675ab0"] :db/ensure [:question/validate]} {:db/id "answer-field-4a0881a6-c4d5-5f55-bec9-94814f675ab0" :answer-field/id #uuid "4a0881a6-c4d5-5f55-bec9-94814f675ab0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f60d69c-3bea-5850-a3ed-f0ba3361b76b" :answer-field/choices ["answer-e165171f-eef7-5192-9c8c-1bfc9dd4cf11" "answer-59c48053-5d37-5682-ad49-b1549faa800e" "answer-1f60d69c-3bea-5850-a3ed-f0ba3361b76b" "answer-f54fda74-1ca3-5d2f-9b3d-4f0c7845d39e" "answer-f74086ea-f300-5c51-b2d2-332a102e6389"] :db/ensure [:answer-field/validate]} {:db/id "answer-e165171f-eef7-5192-9c8c-1bfc9dd4cf11" :answer/id #uuid "e165171f-eef7-5192-9c8c-1bfc9dd4cf11" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-59c48053-5d37-5682-ad49-b1549faa800e" :answer/id #uuid "59c48053-5d37-5682-ad49-b1549faa800e" :answer/type :answer.type/math :answer/value "-14" :db/ensure [:answer/validate]} {:db/id "answer-1f60d69c-3bea-5850-a3ed-f0ba3361b76b" :answer/id #uuid "1f60d69c-3bea-5850-a3ed-f0ba3361b76b" :answer/type :answer.type/math :answer/value "-17" :db/ensure [:answer/validate]} {:db/id "answer-f54fda74-1ca3-5d2f-9b3d-4f0c7845d39e" :answer/id #uuid "f54fda74-1ca3-5d2f-9b3d-4f0c7845d39e" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-f74086ea-f300-5c51-b2d2-332a102e6389" :answer/id #uuid "f74086ea-f300-5c51-b2d2-332a102e6389" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "question-713cc6c3-9177-55d5-83bc-303e3a63514e" :question/id #uuid "713cc6c3-9177-55d5-83bc-303e3a63514e" :question/math-academy-id "q-215884" :question/problem "An arithmetic sequence ${a}_{n}$ is defined by \n\n$$\n{a}_{n+1}={a}_{n}+15,\\,{a}_{1}=0,\\,n\\ge 1?\n$$\n\nThe $6$th term of this sequence is{{field-1}}." :question/worked-solution "Starting with the first term ${a}_{1}=0,$ we compute the next terms using the recursive rule until we reach the $6$th term ${a}_{6}.$\n\n$$\n\\begin{aligned}{a}_{1} & =0 \\\\ {a}_{2} & ={a}_{1}+15=0+15=15 \\\\ {a}_{3} & ={a}_{2}+15=15+15=30 \\\\ {a}_{4} & ={a}_{3}+15=30+15=45 \\\\ {a}_{5} & ={a}_{4}+15=45+15=60 \\\\ {a}_{6} & ={a}_{5}+15=60+15=75\\end{aligned}\n$$\n\nTherefore, the $6$th term is ${a}_{6}=75.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6186c912-af2d-54e8-92ba-7fac27611398"] :db/ensure [:question/validate]} {:db/id "answer-field-6186c912-af2d-54e8-92ba-7fac27611398" :answer-field/id #uuid "6186c912-af2d-54e8-92ba-7fac27611398" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2b2e8c26-530e-5fd0-8666-be7602cf3004" :answer-field/choices ["answer-2b2e8c26-530e-5fd0-8666-be7602cf3004"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b2e8c26-530e-5fd0-8666-be7602cf3004" :answer/id #uuid "2b2e8c26-530e-5fd0-8666-be7602cf3004" :answer/type :answer.type/math :answer/value "75" :db/ensure [:answer/validate]} {:db/id "question-654db483-a24c-50a6-ad12-4b6cce747a3d" :question/id #uuid "654db483-a24c-50a6-ad12-4b6cce747a3d" :question/math-academy-id "q-67194" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n-5,\\,-2,\\,1,\\,…\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-2-(-5) \\\\  & =-2+5 \\\\  & =3.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=-5,\\,n\\ge 1\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9a17c515-6f9b-5a26-a5e6-f9910bba6da3"] :db/ensure [:question/validate]} {:db/id "answer-field-9a17c515-6f9b-5a26-a5e6-f9910bba6da3" :answer-field/id #uuid "9a17c515-6f9b-5a26-a5e6-f9910bba6da3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3e79203-77ff-5caa-a098-561da14a7eb1" :answer-field/choices ["answer-1601f3f6-e399-58a2-b3f0-101b44da3d32" "answer-f3e79203-77ff-5caa-a098-561da14a7eb1" "answer-d9933595-6a03-5f07-9b00-2d6c9dd6730b" "answer-7faf38a6-4e4d-5d9f-b986-f57d02a359db" "answer-221427d8-6165-50b5-a8ad-0471fc16351f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1601f3f6-e399-58a2-b3f0-101b44da3d32" :answer/id #uuid "1601f3f6-e399-58a2-b3f0-101b44da3d32" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+2,\\,{a}_{1}=1,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-f3e79203-77ff-5caa-a098-561da14a7eb1" :answer/id #uuid "f3e79203-77ff-5caa-a098-561da14a7eb1" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=-5,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-d9933595-6a03-5f07-9b00-2d6c9dd6730b" :answer/id #uuid "d9933595-6a03-5f07-9b00-2d6c9dd6730b" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=-2,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-7faf38a6-4e4d-5d9f-b986-f57d02a359db" :answer/id #uuid "7faf38a6-4e4d-5d9f-b986-f57d02a359db" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}-3,\\,{a}_{1}=-5,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-221427d8-6165-50b5-a8ad-0471fc16351f" :answer/id #uuid "221427d8-6165-50b5-a8ad-0471fc16351f" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=-5,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "question-d05d25db-b298-5134-b608-67b85d063ed0" :question/id #uuid "d05d25db-b298-5134-b608-67b85d063ed0" :question/math-academy-id "q-44928" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n11,\\,7,\\,3,\\,…\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =7-11 \\\\  & =-4.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=11,\\,n\\ge 1\\,.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-61159f57-cb89-5224-b75e-6fdcfcb823ce"] :db/ensure [:question/validate]} {:db/id "answer-field-61159f57-cb89-5224-b75e-6fdcfcb823ce" :answer-field/id #uuid "61159f57-cb89-5224-b75e-6fdcfcb823ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4" :answer-field/choices ["answer-b3bd82c0-fa16-56a1-871c-2a6987c72e6d" "answer-7b0465f0-f748-5d29-b169-88cac2ac08bc" "answer-298258b3-c8ea-519a-a66b-435f9d2cc9e2" "answer-4fef15fa-652b-5363-9930-fabb374ecaac" "answer-6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3bd82c0-fa16-56a1-871c-2a6987c72e6d" :answer/id #uuid "b3bd82c0-fa16-56a1-871c-2a6987c72e6d" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+11,\\,{a}_{1}=1,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-7b0465f0-f748-5d29-b169-88cac2ac08bc" :answer/id #uuid "7b0465f0-f748-5d29-b169-88cac2ac08bc" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=1,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-298258b3-c8ea-519a-a66b-435f9d2cc9e2" :answer/id #uuid "298258b3-c8ea-519a-a66b-435f9d2cc9e2" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=11,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-4fef15fa-652b-5363-9930-fabb374ecaac" :answer/id #uuid "4fef15fa-652b-5363-9930-fabb374ecaac" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=1,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4" :answer/id #uuid "6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4" :answer/type :answer.type/math :answer/value "{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=11,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id 17592186180786 :tutorial/content "Suppose we have the following arithmetic sequence with first term $a_1 = {\\color{red}4}$ and common difference  $d={\\color{blue}{3}}\\mathbin{:}$\n\n$$\n{\\color{red}{4}},7,10,13,16,\\ldots\n$$\n\nEach term is ${\\color{blue}{3}}$ more than the previous, starting with ${\\color{red}{4}}.$ Therefore, we can express this sequence recursively:\n\n$$\na_{n+1} = a_n + {\\color{blue}{3}}, \\quad a_1 = {\\color{red}{4}}, \\quad n\\geq 1\n$$\n\nWe can also express the sequence using function notation:\n\n$$\nf(n+1) = f(n) + {\\color{blue}{3}}, \\quad f(1) = {\\color{red}{4}}, \\quad n\\geq 1\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186179849 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-1f5b5ee6-5c93-5583-8a77-4e19809e5b60" :activity/id #uuid "1f5b5ee6-5c93-5583-8a77-4e19809e5b60" :activity/title "Flux in Three-Dimensional Vector Fields" :activity/type :activity.type/review :activity/scope 17592186050188 :activity/course 17592186046669 :activity/steps ["step-5b1d7089-518b-5bf2-a713-56c74b158b05" "step-a0223373-40dc-5730-9574-e973c1a0101a" "step-5a02bcde-e908-5ae8-b24b-ee1eec6de693" "step-e765afec-be28-5cb3-8faf-4a2bb31eff6d" "step-a1583ef8-105a-5d1c-9fe3-9eb7d8b51c39"] :activity/first-step "step-5b1d7089-518b-5bf2-a713-56c74b158b05" :db/ensure [:activity/validate]} {:db/id "step-5b1d7089-518b-5bf2-a713-56c74b158b05" :step/id #uuid "5b1d7089-518b-5bf2-a713-56c74b158b05" :step/content 17592186167128 :step/next "step-a0223373-40dc-5730-9574-e973c1a0101a" :db/ensure [:step/validate]} {:db/id "step-a0223373-40dc-5730-9574-e973c1a0101a" :step/id #uuid "a0223373-40dc-5730-9574-e973c1a0101a" :step/content 17592186421244 :step/next "step-5a02bcde-e908-5ae8-b24b-ee1eec6de693" :db/ensure [:step/validate]} {:db/id "step-5a02bcde-e908-5ae8-b24b-ee1eec6de693" :step/id #uuid "5a02bcde-e908-5ae8-b24b-ee1eec6de693" :step/content 17592186369880 :step/next "step-e765afec-be28-5cb3-8faf-4a2bb31eff6d" :db/ensure [:step/validate]} {:db/id "step-e765afec-be28-5cb3-8faf-4a2bb31eff6d" :step/id #uuid "e765afec-be28-5cb3-8faf-4a2bb31eff6d" :step/content 17592186167131 :step/next "step-a1583ef8-105a-5d1c-9fe3-9eb7d8b51c39" :db/ensure [:step/validate]} {:db/id "step-a1583ef8-105a-5d1c-9fe3-9eb7d8b51c39" :step/id #uuid "a1583ef8-105a-5d1c-9fe3-9eb7d8b51c39" :step/content 17592186323828 :db/ensure [:step/validate]}