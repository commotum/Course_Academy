e95-8228-9284578a6374" :step/content 17592186354382 :db/ensure [:step/validate]} {:db/id "step-d0beba43-a2a6-5d49-b6b0-7dac37ad9070" :step/id #uuid "d0beba43-a2a6-5d49-b6b0-7dac37ad9070" :step/content 17592186237955 :db/ensure [:step/validate]} {:db/id "step-a859a1b7-8bab-51f6-8ab5-a7f41440c4d0" :step/id #uuid "a859a1b7-8bab-51f6-8ab5-a7f41440c4d0" :step/content 17592186234327 :db/ensure [:step/validate]} {:db/id "step-b4f2996d-27c9-54bf-9b33-8258147b9126" :step/id #uuid "b4f2996d-27c9-54bf-9b33-8258147b9126" :step/content 17592186233616 :db/ensure [:step/validate]} {:db/id "step-5ae72436-9ff7-5f36-b717-02ac3084780a" :step/id #uuid "5ae72436-9ff7-5f36-b717-02ac3084780a" :step/content 17592186233094 :db/ensure [:step/validate]} {:db/id 17592186157330 :knowledge-point/questions ["question-3f9ace25-75d4-5ca3-b668-b9724a364c80" "question-3f28ef1d-28c8-56a3-9458-640f77d37f8b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157144 :question/problem "Write $\\dfrac{5x^2}{5x^2-2}$ in the form $a + \\dfrac{b}{5x^2-2},$ where $a \\neq 0.$ What is the value of $a+b?$" :question/worked-solution "First, we subtract and add $2$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}}{5{x}^{2}-2}=\\frac{5{x}^{2}-2+2}{5{x}^{2}-2}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}-2+2}{5{x}^{2}-2} & =\\frac{5{x}^{2}-2}{5{x}^{2}-2}+\\frac{2}{5{x}^{2}-2} \\\\  & =1+\\frac{2}{5{x}^{2}-2}\\end{aligned}\n$$\n\nTherefore, we have $a=1$ and $b=2,$ and we get\n\n$$\na + b = 1 + 2 = 3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186157331 :knowledge-point/questions ["question-5302353a-429f-5452-b2c3-3eb347800cb3" "question-31144732-cb63-5daa-92f1-95264dc5b28a" "question-17e676f6-405b-542f-93f8-e4914767ef36" "question-1acab4f4-f111-5afa-891d-e5bad6726d0e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157145 :question/problem "Write $\\dfrac{3x^2+5}{3x^2-2x}$ in the form $a + \\dfrac{bx+c}{3x^2-2x},$ where $a \\neq 0.$ What is the value of $a+b+c?$" :question/worked-solution "First, we subtract and add $2x$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}+5}{3{x}^{2}-2x}=\\frac{3{x}^{2}-2x+2x+5}{3{x}^{2}-2x}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}-2x+2x+5}{3{x}^{2}-2x} & =\\frac{3{x}^{2}-2x}{3{x}^{2}-2x}+\\frac{2x+5}{3{x}^{2}-2x} \\\\  & =1+\\frac{2x+5}{3{x}^{2}-2x}\\end{aligned}\n$$\n\nTherefore, we have $a=1,$ $b=2,$ and $c=5,$ and we get\n\n$$\na + b + c = 1 + 2 + 5 = 8.\n$$" :db/ensure [:question/validate]} {:db/id 17592186157332 :knowledge-point/questions ["question-07ef510c-76b5-598c-aa32-333fcc3beed7" "question-a3598bce-4582-5b46-b7ba-24890d62ca14" "question-b155ae79-db25-5713-9df8-dcb032b3bfcb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157146 :question/problem "Write $\\dfrac{3x^3}{x^3+4}$ in the form $a + \\dfrac{b}{x^3+4},$ where $a \\neq 0.$ What is the value of $a+b?$" :question/worked-solution "First, we add and subtract $4$ in parentheses in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{3{x}^{3}}{{x}^{3}+4} & =\\frac{3({x}^{3}+4-4)}{{x}^{3}+4} \\\\  & =\\frac{3({x}^{3}+4)+3(-4)}{{x}^{3}+4} \\\\  & =\\frac{3({x}^{3}+4)-12}{{x}^{3}+4}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{3({x}^{3}+4)-12}{{x}^{3}+4} & =\\frac{3({x}^{3}+4)}{{x}^{3}+4}+\\frac{-12}{{x}^{3}+4} \\\\  & =3+\\frac{-12}{{x}^{3}+4}\\end{aligned}\n$$\n\nTherefore, we have $a=3$ and $b=-12,$ and we get\n\n$$\na + b = 3 + (-12) = -9.\n$$" :db/ensure [:question/validate]} {:db/id "question-3f9ace25-75d4-5ca3-b668-b9724a364c80" :question/id #uuid "3f9ace25-75d4-5ca3-b668-b9724a364c80" :question/math-academy-id "q-114356" :question/problem "Write $\\frac{7x}{7x+2}$ in the form $a+\\frac{b}{7x+2},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we add and subtract $2$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{7x}{7x+2}=\\frac{7x+2-2}{7x+2}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{7x+2-2}{7x+2} & =\\frac{7x+2}{7x+2}+\\frac{-2}{7x+2} \\\\  & =1+\\frac{-2}{7x+2}\\end{aligned}\n$$\n\nTherefore, we have $a=1$ and $b=-2,$ and we get \n\n$$\na+b=1+(-2)=-1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a21f80bd-1234-5b6e-9af6-8219c8c7671b"] :db/ensure [:question/validate]} {:db/id "answer-field-a21f80bd-1234-5b6e-9af6-8219c8c7671b" :answer-field/id #uuid "a21f80bd-1234-5b6e-9af6-8219c8c7671b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7699e614-4cbe-5307-b8f1-fa86c2ef10eb" :answer-field/choices ["answer-7699e614-4cbe-5307-b8f1-fa86c2ef10eb" "answer-e2211cf9-6317-5d96-8040-6c17a8eb9968" "answer-82694113-6ad6-55be-af8a-1beb32f07fb4" "answer-5fe3bafd-6ad9-5915-b88d-cc104efef4c4" "answer-f13ff96a-8947-53cb-a1dc-0d02a813cafb"] :db/ensure [:answer-field/validate]} {:db/id "answer-7699e614-4cbe-5307-b8f1-fa86c2ef10eb" :answer/id #uuid "7699e614-4cbe-5307-b8f1-fa86c2ef10eb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-e2211cf9-6317-5d96-8040-6c17a8eb9968" :answer/id #uuid "e2211cf9-6317-5d96-8040-6c17a8eb9968" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-82694113-6ad6-55be-af8a-1beb32f07fb4" :answer/id #uuid "82694113-6ad6-55be-af8a-1beb32f07fb4" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-5fe3bafd-6ad9-5915-b88d-cc104efef4c4" :answer/id #uuid "5fe3bafd-6ad9-5915-b88d-cc104efef4c4" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-f13ff96a-8947-53cb-a1dc-0d02a813cafb" :answer/id #uuid "f13ff96a-8947-53cb-a1dc-0d02a813cafb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-3f28ef1d-28c8-56a3-9458-640f77d37f8b" :question/id #uuid "3f28ef1d-28c8-56a3-9458-640f77d37f8b" :question/math-academy-id "q-114357" :question/problem "Write $\\frac{x}{x+9}$ in the form $a+\\frac{b}{x+9},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we add and subtract $9$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{x}{x+9}=\\frac{x+9-9}{x+9}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{x+9-9}{x+9} & =\\frac{x+9}{x+9}+\\frac{-9}{x+9} \\\\  & =1+\\frac{-9}{x+9}\\end{aligned}\n$$\n\nTherefore, we have $a=1$ and $b=-9,$ and we get \n\n$$\na+b=1+(-9)=-8.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7172de9a-aa7b-5081-8f8c-f0a055aa448c"] :db/ensure [:question/validate]} {:db/id "answer-field-7172de9a-aa7b-5081-8f8c-f0a055aa448c" :answer-field/id #uuid "7172de9a-aa7b-5081-8f8c-f0a055aa448c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c27ded4-366d-5a15-aca7-3f32e856713d" :answer-field/choices ["answer-01706a26-78ad-5b87-97f5-5e1d65d2013b" "answer-90c540ea-a7a4-514d-b263-62d9f7211812" "answer-3c27ded4-366d-5a15-aca7-3f32e856713d" "answer-bf259c16-84c7-525f-aac3-8b6d08912634" "answer-e987d972-9c9e-57ba-89af-0089a7bb3853"] :db/ensure [:answer-field/validate]} {:db/id "answer-01706a26-78ad-5b87-97f5-5e1d65d2013b" :answer/id #uuid "01706a26-78ad-5b87-97f5-5e1d65d2013b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-90c540ea-a7a4-514d-b263-62d9f7211812" :answer/id #uuid "90c540ea-a7a4-514d-b263-62d9f7211812" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-3c27ded4-366d-5a15-aca7-3f32e856713d" :answer/id #uuid "3c27ded4-366d-5a15-aca7-3f32e856713d" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-bf259c16-84c7-525f-aac3-8b6d08912634" :answer/id #uuid "bf259c16-84c7-525f-aac3-8b6d08912634" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-e987d972-9c9e-57ba-89af-0089a7bb3853" :answer/id #uuid "e987d972-9c9e-57ba-89af-0089a7bb3853" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-5302353a-429f-5452-b2c3-3eb347800cb3" :question/id #uuid "5302353a-429f-5452-b2c3-3eb347800cb3" :question/math-academy-id "q-88259" :question/problem "Write $\\frac{2{x}^{2}+1}{2{x}^{2}-3}$ in the form $a+\\frac{b}{2{x}^{2}-3},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we subtract and add $3$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+1}{2{x}^{2}-3}=\\frac{2{x}^{2}-3+3+1}{2{x}^{2}-3}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}-3+3+1}{2{x}^{2}-3} & =\\frac{2{x}^{2}-3}{2{x}^{2}-3}+\\frac{3+1}{2{x}^{2}-3} \\\\  & =1+\\frac{4}{2{x}^{2}-3}\\end{aligned}\n$$\n\nTherefore, we have $a=1$ and $b=4,$ and we get\n\n$$\na+b=1+4=5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eba6a572-2385-5d57-b06f-21037d2d14fc"] :db/ensure [:question/validate]} {:db/id "answer-field-eba6a572-2385-5d57-b06f-21037d2d14fc" :answer-field/id #uuid "eba6a572-2385-5d57-b06f-21037d2d14fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d8ffe278-2425-59b8-bf23-a730757506c9" :answer-field/choices ["answer-0019261d-e016-5c70-b42a-4b7ca8e30db4" "answer-77a4321f-cfd3-5456-9203-89c805823405" "answer-141b0751-ebe1-57c9-a4fa-6d832b567f99" "answer-438876c4-3834-5725-98a6-440a583de4ae" "answer-d8ffe278-2425-59b8-bf23-a730757506c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-0019261d-e016-5c70-b42a-4b7ca8e30db4" :answer/id #uuid "0019261d-e016-5c70-b42a-4b7ca8e30db4" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-77a4321f-cfd3-5456-9203-89c805823405" :answer/id #uuid "77a4321f-cfd3-5456-9203-89c805823405" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-141b0751-ebe1-57c9-a4fa-6d832b567f99" :answer/id #uuid "141b0751-ebe1-57c9-a4fa-6d832b567f99" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-438876c4-3834-5725-98a6-440a583de4ae" :answer/id #uuid "438876c4-3834-5725-98a6-440a583de4ae" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d8ffe278-2425-59b8-bf23-a730757506c9" :answer/id #uuid "d8ffe278-2425-59b8-bf23-a730757506c9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-31144732-cb63-5daa-92f1-95264dc5b28a" :question/id #uuid "31144732-cb63-5daa-92f1-95264dc5b28a" :question/math-academy-id "q-88262" :question/problem "Write $\\frac{4{x}^{3}-1}{4{x}^{3}+x}$ in the form $a+\\frac{bx+c}{4{x}^{3}+x},$ where $a\\ne 0.$ What is the value of $a+b+c?$" :question/worked-solution "First, we add and subtract $x$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{4{x}^{3}-1}{4{x}^{3}+x}=\\frac{4{x}^{3}+x-x-1}{4{x}^{3}+x}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{4{x}^{3}+x-x-1}{4{x}^{3}+x} & =\\frac{4{x}^{3}+x}{4{x}^{3}+x}+\\frac{-x-1}{4{x}^{3}+x} \\\\  & =1+\\frac{-x-1}{4{x}^{3}+x}\\end{aligned}\n$$\n\nTherefore, we have $a=1,$ $b=-1,$ and $c=-1,$ and we get\n\n$$\na+b+c=1+(-1)+(-1)=-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e9cea2a-f648-53e6-920a-6b2b123f56c0"] :db/ensure [:question/validate]} {:db/id "answer-field-6e9cea2a-f648-53e6-920a-6b2b123f56c0" :answer-field/id #uuid "6e9cea2a-f648-53e6-920a-6b2b123f56c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2fdf79a-af79-5d84-8b5a-5418b7dc1fb5" :answer-field/choices ["answer-a2fdf79a-af79-5d84-8b5a-5418b7dc1fb5" "answer-432eac45-0632-51c2-9d7b-ee1dd3ef9d76" "answer-d2fdccc0-856f-51a7-a011-3e60a985cacd" "answer-1ffde74b-3302-50c9-b81d-0948d05221d6" "answer-b8f95f45-01f0-50c7-9671-6e8a11ba2370"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2fdf79a-af79-5d84-8b5a-5418b7dc1fb5" :answer/id #uuid "a2fdf79a-af79-5d84-8b5a-5418b7dc1fb5" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-432eac45-0632-51c2-9d7b-ee1dd3ef9d76" :answer/id #uuid "432eac45-0632-51c2-9d7b-ee1dd3ef9d76" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-d2fdccc0-856f-51a7-a011-3e60a985cacd" :answer/id #uuid "d2fdccc0-856f-51a7-a011-3e60a985cacd" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-1ffde74b-3302-50c9-b81d-0948d05221d6" :answer/id #uuid "1ffde74b-3302-50c9-b81d-0948d05221d6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b8f95f45-01f0-50c7-9671-6e8a11ba2370" :answer/id #uuid "b8f95f45-01f0-50c7-9671-6e8a11ba2370" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-17e676f6-405b-542f-93f8-e4914767ef36" :question/id #uuid "17e676f6-405b-542f-93f8-e4914767ef36" :question/math-academy-id "q-320743" :question/problem "Write $\\frac{8{x}^{5}-9}{8{x}^{5}+4}$ in the form $a+\\frac{b}{8{x}^{5}+4},$ where $a\\ne 0.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"25\">$8{x}^{5}-9$</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$=$</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$+$</td>\n<td align=\"center\" height=\"25\" width=\"50\">\n{{field-2}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">$8{x}^{5}+4$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$8{x}^{5}+4$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we add and subtract $4$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{8{x}^{5}-9}{8{x}^{5}+4}\\,=\\,\\frac{8{x}^{5}+4-4-9}{8{x}^{5}+4}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{8{x}^{5}+4-4-9}{8{x}^{5}+4} & =\\frac{8{x}^{5}+4}{8{x}^{5}+4}+\\frac{-4-9}{8{x}^{5}+4} \\\\  & =1+\\frac{-13}{8{x}^{5}+4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-19a807f2-fc7c-57ce-91b1-e2110887ac9b" "answer-field-7f59d890-8ce5-5936-9ce2-13b82c854112"] :db/ensure [:question/validate]} {:db/id "answer-field-19a807f2-fc7c-57ce-91b1-e2110887ac9b" :answer-field/id #uuid "19a807f2-fc7c-57ce-91b1-e2110887ac9b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a4a0dda5-3965-51eb-a064-e125c2a6dbdd" :answer-field/choices ["answer-a4a0dda5-3965-51eb-a064-e125c2a6dbdd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4a0dda5-3965-51eb-a064-e125c2a6dbdd" :answer/id #uuid "a4a0dda5-3965-51eb-a064-e125c2a6dbdd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-7f59d890-8ce5-5936-9ce2-13b82c854112" :answer-field/id #uuid "7f59d890-8ce5-5936-9ce2-13b82c854112" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d5d463ab-1161-57c6-8111-a4680bc5d096" :answer-field/choices ["answer-d5d463ab-1161-57c6-8111-a4680bc5d096"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5d463ab-1161-57c6-8111-a4680bc5d096" :answer/id #uuid "d5d463ab-1161-57c6-8111-a4680bc5d096" :answer/type :answer.type/math :answer/value "-13" :db/ensure [:answer/validate]} {:db/id "question-1acab4f4-f111-5afa-891d-e5bad6726d0e" :question/id #uuid "1acab4f4-f111-5afa-891d-e5bad6726d0e" :question/math-academy-id "q-114371" :question/problem "Write $\\frac{{x}^{2}+10}{{x}^{2}+x}$ in the form $a+\\frac{bx+c}{{x}^{2}+x},$ where $a\\ne 0.$ What is the value of $a+b+c?$" :question/worked-solution "First, we add and subtract $x$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+10}{{x}^{2}+x}=\\frac{{x}^{2}+x-x+10}{{x}^{2}+x}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+x-x+10}{{x}^{2}+x} & =\\frac{{x}^{2}+x}{{x}^{2}+x}+\\frac{-x+10}{{x}^{2}+x} \\\\  & =1+\\frac{-x+10}{{x}^{2}+x}\\end{aligned}\n$$\n\nTherefore, we have $a=1,$ $b=-1,$ and $c=10,$ and we get\n\n$$\na+b+c=1+(-1)+10=10.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7a82e49b-c98e-58c7-8353-c48b2437d03c"] :db/ensure [:question/validate]} {:db/id "answer-field-7a82e49b-c98e-58c7-8353-c48b2437d03c" :answer-field/id #uuid "7a82e49b-c98e-58c7-8353-c48b2437d03c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4b4c0a8-1b78-5b5b-b328-5c29daf86013" :answer-field/choices ["answer-b4b4c0a8-1b78-5b5b-b328-5c29daf86013" "answer-e7d6bfc7-1fde-54ca-bd06-1538cf414895" "answer-86c55400-24a4-55be-8cc8-42e48433c0cd" "answer-d976c08b-dabc-5fdc-b8d6-2b548ff7dddd" "answer-12c101dc-d9c3-56e5-9afa-d7377f0d034d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4b4c0a8-1b78-5b5b-b328-5c29daf86013" :answer/id #uuid "b4b4c0a8-1b78-5b5b-b328-5c29daf86013" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-e7d6bfc7-1fde-54ca-bd06-1538cf414895" :answer/id #uuid "e7d6bfc7-1fde-54ca-bd06-1538cf414895" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-86c55400-24a4-55be-8cc8-42e48433c0cd" :answer/id #uuid "86c55400-24a4-55be-8cc8-42e48433c0cd" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-d976c08b-dabc-5fdc-b8d6-2b548ff7dddd" :answer/id #uuid "d976c08b-dabc-5fdc-b8d6-2b548ff7dddd" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-12c101dc-d9c3-56e5-9afa-d7377f0d034d" :answer/id #uuid "12c101dc-d9c3-56e5-9afa-d7377f0d034d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-07ef510c-76b5-598c-aa32-333fcc3beed7" :question/id #uuid "07ef510c-76b5-598c-aa32-333fcc3beed7" :question/math-academy-id "q-114380" :question/problem "Write $\\frac{9x}{x+2}$ in the form $a+\\frac{b}{x+2},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we add and subtract $2$ in parentheses in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{9x}{x+2} & =\\frac{9(x+2-2)}{x+2} \\\\  & =\\frac{9(x+2)+9(-2)}{x+2} \\\\  & =\\frac{9(x+2)-18}{x+2}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{9(x+2)-18}{x+2} & =\\frac{9(x+2)}{x+2}+\\frac{-18}{x+2} \\\\  & =9+\\frac{-18}{x+2}\\end{aligned}\n$$\n\nTherefore, we have $a=9$ and $b=-18,$ and we get\n\n$$\na+b=9+(-18)=-9.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1fdfc8ac-e680-5bff-b738-9a37de20e578"] :db/ensure [:question/validate]} {:db/id "answer-field-1fdfc8ac-e680-5bff-b738-9a37de20e578" :answer-field/id #uuid "1fdfc8ac-e680-5bff-b738-9a37de20e578" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6d1c5079-398e-55dc-aa2f-d1b31b3e4d92" :answer-field/choices ["answer-78b7d98b-486b-5166-8ccc-4aa05e0d2c83" "answer-cbd7214b-4cc1-5256-9637-dbf607eef23b" "answer-18661dc1-9e3e-5141-806d-50b4ce8fa902" "answer-faffeaba-fc3e-5c99-a4ca-fb83efda4bb9" "answer-6d1c5079-398e-55dc-aa2f-d1b31b3e4d92"] :db/ensure [:answer-field/validate]} {:db/id "answer-78b7d98b-486b-5166-8ccc-4aa05e0d2c83" :answer/id #uuid "78b7d98b-486b-5166-8ccc-4aa05e0d2c83" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-cbd7214b-4cc1-5256-9637-dbf607eef23b" :answer/id #uuid "cbd7214b-4cc1-5256-9637-dbf607eef23b" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-18661dc1-9e3e-5141-806d-50b4ce8fa902" :answer/id #uuid "18661dc1-9e3e-5141-806d-50b4ce8fa902" :answer/type :answer.type/math :answer/value "-14" :db/ensure [:answer/validate]} {:db/id "answer-faffeaba-fc3e-5c99-a4ca-fb83efda4bb9" :answer/id #uuid "faffeaba-fc3e-5c99-a4ca-fb83efda4bb9" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-6d1c5079-398e-55dc-aa2f-d1b31b3e4d92" :answer/id #uuid "6d1c5079-398e-55dc-aa2f-d1b31b3e4d92" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "question-a3598bce-4582-5b46-b7ba-24890d62ca14" :question/id #uuid "a3598bce-4582-5b46-b7ba-24890d62ca14" :question/math-academy-id "q-114378" :question/problem "Write $\\frac{35{x}^{4}}{7{x}^{3}+2}$ in the form $ax+\\frac{bx}{7{x}^{3}+2},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we factor the numerator to put $7{x}^{3}$ in parentheses. Then, we add and subtract $2$ in the parentheses. This reveals a copy of the denominator without changing the value of the expression. \n\n$$\n\\begin{aligned}\\frac{35{x}^{4}}{7{x}^{3}+2} & =\\frac{5x(7{x}^{3})}{7{x}^{3}+2} \\\\  & =\\frac{5x(7{x}^{3}+2-2)}{7{x}^{3}+2} \\\\  & =\\frac{5x(7{x}^{3}+2)+5x(-2)}{7{x}^{3}+2} \\\\  & =\\frac{5x(7{x}^{3}+2)-10x}{7{x}^{3}+2}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{5x(7{x}^{3}+2)-10x}{7{x}^{3}+2} & =\\frac{5x(7{x}^{3}+2)}{7{x}^{3}+2}+\\frac{-10x}{7{x}^{3}+2} \\\\  & =5x+\\frac{-10x}{7{x}^{3}+2}\\end{aligned}\n$$\n\nTherefore, we have $a=5$ and $b=-10,$ and we get\n\n$$\na+b=5+(-10)=-5.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-10a1e417-0ed2-5696-a763-022509e026bf"] :db/ensure [:question/validate]} {:db/id "answer-field-10a1e417-0ed2-5696-a763-022509e026bf" :answer-field/id #uuid "10a1e417-0ed2-5696-a763-022509e026bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1b2b194-3ff7-52a1-83d3-6b70fbcdeebf" :answer-field/choices ["answer-aaf2e9af-604e-5bcc-83a5-288f2ddce279" "answer-e1b2b194-3ff7-52a1-83d3-6b70fbcdeebf" "answer-6951a564-cf83-5085-a483-595121cdb640" "answer-509f63d0-9e90-5989-8960-74a322826bb6" "answer-fc4bd510-ca56-54f0-b9d1-66d799f1f856"] :db/ensure [:answer-field/validate]} {:db/id "answer-aaf2e9af-604e-5bcc-83a5-288f2ddce279" :answer/id #uuid "aaf2e9af-604e-5bcc-83a5-288f2ddce279" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-e1b2b194-3ff7-52a1-83d3-6b70fbcdeebf" :answer/id #uuid "e1b2b194-3ff7-52a1-83d3-6b70fbcdeebf" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-6951a564-cf83-5085-a483-595121cdb640" :answer/id #uuid "6951a564-cf83-5085-a483-595121cdb640" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-509f63d0-9e90-5989-8960-74a322826bb6" :answer/id #uuid "509f63d0-9e90-5989-8960-74a322826bb6" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-fc4bd510-ca56-54f0-b9d1-66d799f1f856" :answer/id #uuid "fc4bd510-ca56-54f0-b9d1-66d799f1f856" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "question-b155ae79-db25-5713-9df8-dcb032b3bfcb" :question/id #uuid "b155ae79-db25-5713-9df8-dcb032b3bfcb" :question/math-academy-id "q-270234" :question/problem "Write $\\frac{8{x}^{2}}{4x-5}$ in the form $ax+\\frac{bx}{4x-5},$ where $a\\ne 0.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"25\">$8{x}^{2}$</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$=$</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$x\\,+\\,$</td>\n<td align=\"center\" height=\"25\" width=\"50\">\n{{field-2}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">$4x-5$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$4x-5$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we factor the numerator to put $4x$ in parentheses. Then, we subtract and add $5$ in the parentheses. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{8{x}^{2}}{4x-5} & =\\frac{2x(4x)}{4x-5} \\\\  & =\\frac{2x(4x-5+5)}{4x-5} \\\\  & =\\frac{2x[(4x-5)+(5)]}{4x-5} \\\\  & =\\frac{2x(4x-5)+2x(5)}{4x-5} \\\\  & =\\frac{2x(4x-5)+10x}{4x-5}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{2x(4x-5)+10x}{4x-5} & =\\frac{2x(4x-5)}{4x-5}+\\frac{10x}{4x-5} \\\\  & =2x+\\frac{10x}{4x-5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e5891570-1568-5839-bb2a-008b6e2999e1" "answer-field-5c08733b-1d4b-5d7f-a806-6c56e003ca4b"] :db/ensure [:question/validate]} {:db/id "answer-field-e5891570-1568-5839-bb2a-008b6e2999e1" :answer-field/id #uuid "e5891570-1568-5839-bb2a-008b6e2999e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fb087daf-4497-5358-8425-d16006c4479e" :answer-field/choices ["answer-fb087daf-4497-5358-8425-d16006c4479e"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb087daf-4497-5358-8425-d16006c4479e" :answer/id #uuid "fb087daf-4497-5358-8425-d16006c4479e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-5c08733b-1d4b-5d7f-a806-6c56e003ca4b" :answer-field/id #uuid "5c08733b-1d4b-5d7f-a806-6c56e003ca4b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-801d4e3f-6db0-5039-b36e-e65b87771edb" :answer-field/choices ["answer-801d4e3f-6db0-5039-b36e-e65b87771edb"] :db/ensure [:answer-field/validate]} {:db/id "answer-801d4e3f-6db0-5039-b36e-e65b87771edb" :answer/id #uuid "801d4e3f-6db0-5039-b36e-e65b87771edb" :answer/type :answer.type/math :answer/value "10x" :db/ensure [:answer/validate]} {:db/id 17592186158513 :tutorial/content "Sometimes, we can divide polynomials quickly by cleverly manipulating a rational function.\n\nFor example, suppose we wish to divide $x$ by $x+2.$ Then we have the following rational expression:\n\n$$\n\\dfrac{x}{x+2}\n$$\n\nThe goal is to write this rational expression in the form\n\n$$\n\\dfrac{x}{x+2} = a + \\dfrac{b}{x+2}\n$$\n\nwhere $a$ and $b$ are both constants. Here, $a$ is the quotient of the division, and $b$ is the remainder.\n\nTo manipulate the rational function into this form, we can add and subtract $2$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{x}{x+2}=\\frac{x+2-2}{x+2}\\end{aligned}\n$$\n\nThen, we expand and simplify the fraction:\n\n$$\n\\begin{aligned}\\frac{x+2-2}{x+2} & =\\frac{x+2}{x+2}+\\frac{-2}{x+2} \\\\  & =1+\\frac{-2}{x+2}\\end{aligned}\n$$\n\nSo we have $a=1$ and $b=-2,$ and we've reached the desired result:\n\n$$\n\\dfrac{x}{x+2} = 1 + \\dfrac{-2}{x+2}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186158517 :tutorial/content "We can use the same method to manipulate rational expressions with two terms in the numerator. For example, consider the following rational expression:\n\n$$\n\\dfrac{x+5}{x+2}\n$$\n\nIn order to write this rational expression in the form\n\n$$\n\\dfrac{x+5}{x+2} = a + \\dfrac{b}{x+2}\n$$\n\nwhere $a$ and $b$ are constants, we can apply the same trick: add and subtract $2$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{x+5}{x+2}=\\frac{x+2-2+5}{x+2}\\end{aligned}\n$$\n\nThen, we expand and simplify the fraction:\n\n$$\n\\begin{aligned}\\frac{x+2-2+5}{x+2} & =\\frac{x+2}{x+2}+\\frac{-2+5}{x+2} \\\\  & =1+\\frac{3}{x+2}\\end{aligned}\n$$\n\nSo we have $a=1$ and $b=3,$ and we've reached the desired result:\n\n$$\n\\dfrac{x+5}{x+2} = 1 + \\dfrac{3}{x+2}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186158514 :tutorial/content "Sometimes, we have to factor the numerator of a rational expression in order to reveal a copy of the denominator. For example, consider the following rational expression:\n\n$$\n\\dfrac{2x}{x+1}\n$$\n\nIn order to write this rational expression in the form\n\n$$\n\\dfrac{2x}{x+1} = a + \\dfrac{b}{x+1},\n$$\n\nwhere $a$ and $b$ are constants, we can add and subtract $1$ in parentheses in the numerator. This will reveal a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{2x}{x+1} & =\\frac{2(x+1-1)}{x+1} \\\\  & =\\frac{2(x+1)+2(-1)}{x+1} \\\\  & =\\frac{2(x+1)-2}{x+1}\\end{aligned}\n$$\n\nThen, we expand and simplify the fraction:\n\n$$\n\\begin{aligned}\\frac{2(x+1)-2}{x+1} & =\\frac{2(x+1)}{x+1}+\\frac{-2}{x+1} \\\\  & =2+\\frac{-2}{x+1}\\end{aligned}\n$$\n\nSo we have $a=2$ and $b=-2,$ and we've reached the desired result:\n\n$$\n\\dfrac{2x}{x+1} = 2 + \\dfrac{-2}{x+1}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186157507 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186130840 :answer-field/choices 17592186130841] [:db/retract 17592186130840 :answer-field/choices 17592186130842] [:db/retract 17592186130840 :answer-field/choices 17592186130843] [:db/retract 17592186130840 :answer-field/choices 17592186130844] [:db/retract 17592186130840 :answer-field/choices 17592186130845] {:db/id 17592186133808 :knowledge-point/questions ["question-fe25ae24-c60e-57ec-8c52-078b3a7606de" "question-637f51dc-9306-5135-a973-8a82796a3f19"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fe25ae24-c60e-57ec-8c52-078b3a7606de" :question/id #uuid "fe25ae24-c60e-57ec-8c52-078b3a7606de" :question/math-academy-id "q-139864" :question/problem "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$50$** | **$58$** | **$62$** | **$65$** | **$70$** |\n| $y$ | $10$ | $12$ | $15$ | $20$ | $17$ |\n\nThe vector of coefficients of the plane $y={\\beta }_{0}+{\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}$ that best fits the data above can be found using multiple linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" :question/worked-solution "| ${x}_{1}$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| ${x}_{2}$ | **$50$** | **$58$** | **$62$** | **$65$** | **$70$** |\n| $y$ | $10$ | $12$ | $15$ | $20$ | $17$ |\n\nThe coefficients of the plane \n\n$$\ny={\\beta }_{0}+{\\beta }_{1}{x}_{1}+{\\beta }_{2}{x}_{2}\n$$\n\nthat best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 1 & 50 \\\\ 1 & 2 & 58 \\\\ 1 & 3 & 62 \\\\ 1 & 4 & 65 \\\\ 1 & 5 & 70\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}10 \\\\ 12 \\\\ 15 \\\\ 20 \\\\ 17\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d12fb1e1-1778-564e-b514-5a394648ba52"] :db/ensure [:question/validate]} {:db/id "answer-field-d12fb1e1-1778-564e-b514-5a394648ba52" :answer-field/id #uuid "d12fb1e1-1778-564e-b514-5a394648ba52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f98a11a-a9f4-5967-826b-9561bcb1c4a3" :answer-field/choices ["answer-86e0a1d5-1b21-502e-9724-c39fe8bedec2" "answer-8f98a11a-a9f4-5967-826b-9561bcb1c4a3" "answer-4eea679e-1d00-5848-aa6b-11d4e2a5e9c7" "answer-a34dfa2c-d0f7-5cbc-becb-9f788df746d8" "answer-a9ffd8b7-b5cd-5adc-9457-bfa1bef7fd01"] :db/ensure [:answer-field/validate]} {:db/id "answer-86e0a1d5-1b21-502e-9724-c39fe8bedec2" :answer/id #uuid "86e0a1d5-1b21-502e-9724-c39fe8bedec2" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 1 & 10 \\\\ 1 & 2 & 12 \\\\ 1 & 3 & 15 \\\\ 1 & 4 & 20 \\\\ 1 & 5 & 17\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "answer-8f98a11a-a9f4-5967-826b-9561bcb1c4a3" :answer/id #uuid "8f98a11a-a9f4-5967-826b-9561bcb1c4a3" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 1 & 50 \\\\ 1 & 2 & 58 \\\\ 1 & 3 & 62 \\\\ 1 & 4 & 65 \\\\ 1 & 5 & 70\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "answer-4eea679e-1d00-5848-aa6b-11d4e2a5e9c7" :answer/id #uuid "4eea679e-