-51fcc759f2e3" "answer-6e77e88c-151b-511e-ba46-7e88b0ad53cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a274b0c-6c62-5d46-b00f-51fcc759f2e3" :answer/id #uuid "1a274b0c-6c62-5d46-b00f-51fcc759f2e3" :answer/type :answer.type/text :answer/value "phase portrait" :db/ensure [:answer/validate]} {:db/id "answer-6e77e88c-151b-511e-ba46-7e88b0ad53cc" :answer/id #uuid "6e77e88c-151b-511e-ba46-7e88b0ad53cc" :answer/type :answer.type/text :answer/value "vector field" :db/ensure [:answer/validate]} {:db/id "question-22670f3b-ee2e-505b-bc5c-db0616554dee" :question/id #uuid "22670f3b-ee2e-505b-bc5c-db0616554dee" :question/math-academy-id "q-333345" :question/problem "![](images/51/51ffadb1da41e6a1fe06fdc9c14a6967d3a80b4d26c6a830a401105e0f18bbf5.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two real, distinct eigenvalues is shown above. The eigenvalues of the system's matrix are ${\\lambda }_{1}$ and ${\\lambda }_{2},$ for which the corresponding eigenvectors are ${v}_{1}=[-1,2]^{T}$ and ${v}_{2}=[1,2]^{T},$ respectively. Select the correct options in the reasoning below.\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$ has the equation\n\n$$\ny={{field-1}}.\n$$\n\nThe tangents along this line are pointing \n{{field-2}},\nmeaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$\nmust approach \n{{field-3}} \nas $t\\to \\infty .$ So, we must have \n{{field-4}}.\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation\n\n$$\ny={{field-5}}.\n$$\n\nThe tangents along this line are pointing \n{{field-6}},\nmeaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nmust approach \n{{field-7}} \nas $t\\to \\infty .$ So, we must have \n{{field-8}}.\n\nFinally, since the solutions become parallel to the straight-line solution containing the vector {{field-9}} as they move towards the origin, the eigenvalue that determines the long-term behavior (dominant eigenvalue) is \n{{field-10}}.\n\nTherefore,\n{{field-11}} \n$<0.$" :question/worked-solution "The straight-line solutions of the system have the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$ has the equation\n\n$$\ny=-2x,\n$$\n\nas shown below.\n\n![](images/6e/6ea2d64a390187a28cfcd1c2692e97e5dc2ca5cb37649ba12cf71864e36958ea.png)\n\nThe tangents along this line are pointing $\\text{toward the origin},$ meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$\nmust approach $\\text{the origin}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}<0.$\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation\n\n$$\ny=2x,\n$$\n\nas shown below.\n\n![](images/2f/2f2340cbff80765a5d3b551e87eb4207eebad05970e366ceeccd7bb142c0b677.png)\n\nThe tangents along this line are pointing $\\text{toward the origin},$ meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nmust approach $\\text{the origin}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}<0.$\n\nSo, for this particular system, both eigenvalues are negative. The eigenvalue that determines the long-term behavior (dominant eigenvalue) is the one closest to $0.$\n\nNow, since the solutions become parallel to the straight-line solution containing the vector ${v}_{1}$ as they move towards the origin, the eigenvalue that determines the long-term behavior is ${\\lambda }_{1}.$\n\nTherefore, ${\\lambda }_{2}<{\\lambda }_{1}<0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-070804c8-3b5d-555e-994a-50be2a1aa3e2" "answer-field-6070a721-9ee3-5c8b-894d-0b895fbbe8fd" "answer-field-c9ce54c2-58ca-563f-a943-2b87144d054f" "answer-field-05e61a3b-bbaf-5bab-b901-9321031c732c" "answer-field-2386abe6-5161-5ee9-89a4-1e9b1ab427ee" "answer-field-196124cc-fc57-564f-9c80-e3c703afc3b9" "answer-field-c57c0f33-d9b1-5dc9-8b98-ee2e345de9ec" "answer-field-ddb27815-0b88-5fe1-9bd9-3f33b06ca48a" "answer-field-c5801f6a-9756-5a5a-8061-21b3d880aef0" "answer-field-2c1e5846-37d8-5648-b77a-f4a2e3eab43b" "answer-field-69dfd36e-099b-5e13-844d-d42bb774d292"] :db/ensure [:question/validate]} {:db/id "answer-field-070804c8-3b5d-555e-994a-50be2a1aa3e2" :answer-field/id #uuid "070804c8-3b5d-555e-994a-50be2a1aa3e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-af5ae64a-6665-5281-a276-9023eb63b26d" :answer-field/choices ["answer-af5ae64a-6665-5281-a276-9023eb63b26d" "answer-521cc0d6-9128-5cdb-8865-fa00b45f6b36" "answer-e0b91c76-5c7e-5fc7-813a-a33ad8c8a4db" "answer-47a4601c-9108-57e2-9ba0-39e7fea9913b"] :db/ensure [:answer-field/validate]} {:db/id "answer-af5ae64a-6665-5281-a276-9023eb63b26d" :answer/id #uuid "af5ae64a-6665-5281-a276-9023eb63b26d" :answer/type :answer.type/math :answer/value "-2x" :db/ensure [:answer/validate]} {:db/id "answer-521cc0d6-9128-5cdb-8865-fa00b45f6b36" :answer/id #uuid "521cc0d6-9128-5cdb-8865-fa00b45f6b36" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}x" :db/ensure [:answer/validate]} {:db/id "answer-e0b91c76-5c7e-5fc7-813a-a33ad8c8a4db" :answer/id #uuid "e0b91c76-5c7e-5fc7-813a-a33ad8c8a4db" :answer/type :answer.type/math :answer/value "-x" :db/ensure [:answer/validate]} {:db/id "answer-47a4601c-9108-57e2-9ba0-39e7fea9913b" :answer/id #uuid "47a4601c-9108-57e2-9ba0-39e7fea9913b" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "answer-field-6070a721-9ee3-