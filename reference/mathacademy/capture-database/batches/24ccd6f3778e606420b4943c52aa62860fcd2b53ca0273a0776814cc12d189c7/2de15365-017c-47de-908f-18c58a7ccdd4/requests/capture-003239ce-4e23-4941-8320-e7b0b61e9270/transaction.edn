7" "answer-53308e85-0ea9-5376-ba91-1d38df29c1c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0130011a-855a-504c-8ed9-de640a85cf65" :answer/id #uuid "0130011a-855a-504c-8ed9-de640a85cf65" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}<0" :db/ensure [:answer/validate]} {:db/id "answer-5bb0e05e-e814-59a0-b300-e445fc5ab637" :answer/id #uuid "5bb0e05e-e814-59a0-b300-e445fc5ab637" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}=0" :db/ensure [:answer/validate]} {:db/id "answer-53308e85-0ea9-5376-ba91-1d38df29c1c6" :answer/id #uuid "53308e85-0ea9-5376-ba91-1d38df29c1c6" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}>0" :db/ensure [:answer/validate]} {:db/id "answer-field-c5801f6a-9756-5a5a-8061-21b3d880aef0" :answer-field/id #uuid "c5801f6a-9756-5a5a-8061-21b3d880aef0" :answer-field/key "field-9" :answer-field/type :answer-field.type/select :answer-field/correct "answer-64bac435-ca66-5d14-9536-e149843494ff" :answer-field/choices ["answer-64bac435-ca66-5d14-9536-e149843494ff" "answer-06c71fdc-ed83-5969-8583-60828a4fa22f"] :db/ensure [:answer-field/validate]} {:db/id "answer-64bac435-ca66-5d14-9536-e149843494ff" :answer/id #uuid "64bac435-ca66-5d14-9536-e149843494ff" :answer/type :answer.type/math :answer/value "{v}_{1}" :db/ensure [:answer/validate]} {:db/id "answer-06c71fdc-ed83-5969-8583-60828a4fa22f" :answer/id #uuid "06c71fdc-ed83-5969-8583-60828a4fa22f" :answer/type :answer.type/math :answer/value "{v}_{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-2c1e5846-37d8-5648-b77a-f4a2e3eab43b" :answer-field/id #uuid "2c1e5846-37d8-5648-b77a-f4a2e3eab43b" :answer-field/key "field-10" :answer-field/type :answer-field.type/select :answer-field/correct "answer-01673aea-0949-56b5-9d9e-4f7946a9541f" :answer-field/choices ["answer-01673aea-0949-56b5-9d9e-4f7946a9541f" "answer-f0ddc0bf-c05e-5298-a951-9331ce53b510"] :db/ensure [:answer-field/validate]} {:db/id "answer-01673aea-0949-56b5-9d9e-4f7946a9541f" :answer/id #uuid "01673aea-0949-56b5-9d9e-4f7946a9541f" :answer/type :answer.type/math :answer/value "{\\lambda }_{1}" :db/ensure [:answer/validate]} {:db/id "answer-f0ddc0bf-c05e-5298-a951-9331ce53b510" :answer/id #uuid "f0ddc0bf-c05e-5298-a951-9331ce53b510" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-69dfd36e-099b-5e13-844d-d42bb774d292" :answer-field/id #uuid "69dfd36e-099b-5e13-844d-d42bb774d292" :answer-field/key "field-11" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4414e4f8-4b78-5dac-be68-c13c5a2ab7e2" :answer-field/choices ["answer-61150e61-5783-52d2-b0be-68064bda6be0" "answer-4414e4f8-4b78-5dac-be68-c13c5a2ab7e2" "answer-1d9c150d-8c23-5a1a-96bd-cd5b7e6c6037"] :db/ensure [:answer-field/validate]} {:db/id "answer-61150e61-5783-52d2-b0be-68064bda6be0" :answer/id #uuid "61150e61-5783-52d2-b0be-68064bda6be0" :answer/type :answer.type/math :answer/value "{\\lambda }_{1}<{\\lambda }_{2}" :db/ensure [:answer/validate]} {:db/id "answer-4414e4f8-4b78-5dac-be68-c13c5a2ab7e2" :answer/id #uuid "4414e4f8-4b78-5dac-be68-c13c5a2ab7e2" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}<{\\lambda }_{1}" :db/ensure [:answer/validate]} {:db/id "answer-1d9c150d-8c23-5a1a-96bd-cd5b7e6c6037" :answer/id #uuid "1d9c150d-8c23-5a1a-96bd-cd5b7e6c6037" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}={\\lambda }_{1}" :db/ensure [:answer/validate]} {:db/id 17592186166918 :knowledge-point/questions ["question-21116522-1e68-5aeb-8229-3d0039b396bc" "question-d325e43f-35f1-5542-8db8-397925f79316"] :db/ensure [:knowledge-point/validate]} {:db/id "question-21116522-1e68-5aeb-8229-3d0039b396bc" :question/id #uuid "21116522-1e68-5aeb-8229-3d0039b396bc" :question/math-academy-id "q-333649" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-8x(t)+3y(t) \\\\ {y}^{′}(t)=-6x(t)+y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-5$ and ${\\lambda }_{2}=-2$ for which the corresponding eigenvectors are ${v}_{1}=[1,\\text{ }1]^{T}$ and ${v}_{2}=[1,\\text{ }2]^{T},$ respectively. Select the correct options below regarding the given system.\n\n$\\,$\n$y=x$ is {{field-1}} line.\n\n$\\,$\n{{field-2}} is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{-5t}[\\begin{aligned}1 \\\\ 1\\end{aligned}]+{c}_{2}{e}^{-2t}[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-5t}[\\begin{aligned}1 \\\\ 1\\end{aligned}]$\nlie on that line and approach the origin as as $t\\to \\infty .$ So, $y=x$ is $\\text{a stable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny=2x.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{-2t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nlie on that line and approach the origin as as $t\\to \\infty .$ So, $y=2x$ is $\\text{a stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/33/330e2a1dd9f7d2cbcadb61fe49e767d95ee76a2cb669a9917ef3f6333719b98f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52e5d219-347a-59f7-9240-fa2c72d0c7a8" "answer-field-a5a10a52-6833-53cc-ba9f-c7f4b8bbeab2" "answer-field-d09acdef-394b-56b7-aede-21eb94c695dd" "answer-field-6382c6a6-f666-5da1-8304-c0b7d94b708d"] :db/ensure [:question/validate]} {:db/id "answer-field-52e5d219-347a-59f7-9240-fa2c72d0c7a8" :answer-field/id #uuid "52e5d21