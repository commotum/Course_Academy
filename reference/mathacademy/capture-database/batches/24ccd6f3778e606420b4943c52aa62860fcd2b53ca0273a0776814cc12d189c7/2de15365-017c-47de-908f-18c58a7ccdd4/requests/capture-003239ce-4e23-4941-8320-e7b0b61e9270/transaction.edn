frac{1}{10})}^{n-1} \\\\  & =3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-62d66ce1-cb4b-511c-ad96-64a90b9a6b51"] :db/ensure [:question/validate]} {:db/id "answer-field-62d66ce1-cb4b-511c-ad96-64a90b9a6b51" :answer-field/id #uuid "62d66ce1-cb4b-511c-ad96-64a90b9a6b51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de6e0b19-b1eb-5a46-af3b-45dea8fca98f" :answer-field/choices ["answer-4f633459-3d49-5dae-91c2-c677b7f99e15" "answer-2f341c83-40a1-51c8-a948-eca000c145ce" "answer-de6e0b19-b1eb-5a46-af3b-45dea8fca98f" "answer-d35c6ff9-930c-5ef8-91d5-af70c973c0a4" "answer-d4d421d5-51de-5a32-811b-45d752d21a36"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f633459-3d49-5dae-91c2-c677b7f99e15" :answer/id #uuid "4f633459-3d49-5dae-91c2-c677b7f99e15" :answer/type :answer.type/math :answer/value "1+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{100})}^{n}" :db/ensure [:answer/validate]} {:db/id "answer-2f341c83-40a1-51c8-a948-eca000c145ce" :answer/id #uuid "2f341c83-40a1-51c8-a948-eca000c145ce" :answer/type :answer.type/math :answer/value "3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{100})}^{n}" :db/ensure [:answer/validate]} {:db/id "answer-de6e0b19-b1eb-5a46-af3b-45dea8fca98f" :answer/id #uuid "de6e0b19-b1eb-5a46-af3b-45dea8fca98f" :answer/type :answer.type/math :answer/value "3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{10})}^{n}" :db/ensure [:answer/validate]} {:db/id "answer-d35c6ff9-930c-5ef8-91d5-af70c973c0a4" :answer/id #uuid "d35c6ff9-930c-5ef8-91d5-af70c973c0a4" :answer/type :answer.type/math :answer/value "3+{\\sum }_{n=1}^{\\infty }\\frac{1}{7}{(\\frac{1}{10})}^{n}" :db/ensure [:answer/validate]} {:db/id "answer-d4d421d5-51de-5a32-811b-45d752d21a36" :answer/id #uuid "d4d421d5-51de-5a32-811b-45d752d21a36" :answer/type :answer.type/math :answer/value "7+{\\sum }_{n=1}^{\\infty }\\frac{1}{3}{(\\frac{1}{10})}^{n}" :db/ensure [:answer/validate]} {:db/id 17592186084397 :tutorial/content "A repeating decimal can be expressed as a geometric series whose common ratio is a power of $\\dfrac 1 {10}.$\n\nFor example, the number $0.\\overline{8}$ can be expressed as \n![](images/03/03acd5b86ea1c8f214f08482c17a8631bd8d55754d4e5ddd974fa17a9ac9cb02.svg)\nWe have $a_1 = \\dfrac{8}{10}$ and $r = \\dfrac {0.08}{0.8} = \\dfrac 1 {10}.$ Therefore,\n\n$$\n\\begin{aligned}0.\\overset{―}{8} & ={\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{8}{10}{(\\frac{1}{10})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot {(\\frac{1}{10})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot {(\\frac{1}{10})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot 10 \\\\  & ={\\sum }_{n=1}^{\\infty }8{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186083401 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186126428 :answer-field/choices 17592186126432] [:db/retract 17592186126428 :answer-field/choices 17592186126433] [:db/retract 17592186126428 :answer-field/choices 17592186126429] [:db/retract 17592186126428 :answer-field/choices 17592186126430] [:db/retract 17592186126428 :answer-field/choices 17592186126431] {:db/id 17592186129319 :knowledge-point/questions ["question-5349d9de-8c6d-5416-a022-6878977b6004"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129488 :question/problem "Consider the curve defined parametrically as \n\n$$\nx=3t,\\,y=4t,\\,t\\in [0,1].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t)=3 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4t)=4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3t\\sqrt{{(3)}^{2}+{(4)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3t\\sqrt{25}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3t\\cdot 5\\,\\text{d}t \\\\  & =30\\pi {\\int }_{0}^{1}t\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186126428 :answer-field/correct "answer-a53f81c5-8ba3-5b6b-9818-2872dc69946f" :answer-field/choices ["answer-276f10df-f807-54a9-b01f-7cf1b357ec66" "answer-8f170c4b-c5f7-5356-8a5a-6fd851ea13ce" "answer-e9f6ac1e-5d34-5fa1-a3ce-c20f5afa43d8" "answer-a53f81c5-8ba3-5b6b-9818-2872dc69946f" "answer-b86bdc8d-5bf9-5ea7-8414-b3dab58e55bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-276f10df-f807-54a9-b01f-7cf1b357ec66" :answer/id #uuid "276f10df-f807-54a9-b01f-7cf1b357ec66" :answer/type :answer.type/math :answer/value "15\\pi {\\int }_{0}^{1}t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-8f170c4b-c5f7-5356-8a5a-6fd851ea13ce" :answer/id #uuid "8f170c4b-c5f7-5356-8a5a-6fd851ea13ce" :answer/type :answer.type/math :answer/value "15\\pi {\\int }_{0}^{1}{t}^{2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-e9f6ac1e-5d34-5fa1-a3ce-c20f5afa43d8" :answer/id #uuid "e9f6ac1e-5d34-5fa1-a3ce-c20f5afa43d8" :answer/type :answer.type/math :answer/value "20\\pi {\\int }_{0}^{1}{t}^{2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-a53f81c5-8ba3-5b6b-9818-2872dc69946f" :answer/id #uuid "a53f81c5-8ba3-5b6b-9818-2872dc69946f" :answer/type :answer.type/math :answer/value "30\\pi {\\int }_{0}^{1}t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-b86bdc8d-5bf9-5ea7-8414-b3dab58e55bd" :answer/id #uuid "b86bdc8d-5bf9-5ea7-8414-b3dab58e55bd" :answer/type :answer.type/math :answer/value "30\\pi {\\int }_{0}^{1}{t}^{2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "question-5349d9de-8c6d-5416-a022-6878977b6004" :question/id #uuid "5349d9de-8c6d-5416-a022-6878977b6004" :question/math-academy-id "q-139057" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={t}^{2},\\,y={2}^{t},\\,t\\in [0,3].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=3.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({2}^{t})={2}^{t}\\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{3}{t}^{2}\\sqrt{{(2t)}^{2}+{({2}^{t}\\operatorname{ln}⁡2)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{3}{t}^{2}\\sqrt{4{t}^{2}+{2}^{2t}{ln}^{2}⁡2}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{3}{t}^{2}\\sqrt{4{t}^{2}+{4}^{t}{ln}^{2}⁡2}\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b4a256d7-74ef-5f59-aa17-d233ba137369"] :db/ensure [:question/validate]} {:db/id "answer-field-b4a256d7-74ef-5f59-aa17-d233ba137369" :answer-field/id #uuid "b4a256d7-74ef-5f59-aa17-d233ba137369" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-735f35d2-93c2-528a-acc9-d6a1cf48503f" :answer-field/choices ["answer-8f18c374-0ec5-5b5a-8aa2-bf73f6a415be" "answer-6878ad2d-c3f6-5472-b932-d7a4364f9bc8" "answer-cb3c2df3-9d88-53e0-973d-199d14e0ed36" "answer-b4866bd0-791b-5423-befb-168b1ad8cf39" "answer-735f35d2-93c2-528a-acc9-d6a1cf48503f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f18c374-0ec5-5b5a-8aa2-bf73f6a415be" :answer/id #uuid "8f18c374-0ec5-5b5a-8aa2-bf73f6a415be" :answer/type :answer.type/math :answer/value "2\\pi \\operatorname{ln}⁡2{\\int }_{0}^{3}{2}^{t}\\sqrt{{2}^{t}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-6878ad2d-c3f6-5472-b932-d7a4364f9bc8" :answer/id #uuid "6878ad2d-c3f6-5472-b932-d7a4364f9bc8" :answer/type :answer.type/math :answer/value "2\\pi \\operatorname{ln}⁡2{\\int }_{0}^{3}{4}^{t}\\sqrt{{t}^{3}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-cb3c2df3-9d88-53e0-973d-199d14e0ed36" :answer/id #uuid "cb3c2df3-9d88-53e0-973d-199d14e0ed36" :answer/type :answer.type/math :answer/value "2\\pi \\operatorname{ln}⁡2{\\int }_{0}^{3}{t}^{4}{2}^{t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-b4866bd0-791b-5423-befb-168b1ad8cf39" :answer/id #uuid "b4866bd0-791b-5423-befb-168b1ad8cf39" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{3}{2}^{t}\\sqrt{{t}^{2}+{2}^{t}\\operatorname{ln}⁡2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-735f35d2-93c2-528a-acc9-d6a1cf48503f" :answer/id #uuid "735f35d2-93c2-528a-acc9-d6a1cf48503f" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{3}{t}^{2}\\sqrt{4{t}^{2}+{4}^{t}{ln}^{2}⁡2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id 17592186129320 :knowledge-point/questions ["question-6528b016-7e7a-5f42-bb80-0fc7063586be" "question-4f72f786-eb31-5b03-9051-ae70858e9f5f" "question-95891d65-20e2-5732-9bd4-e52bbf49b5d2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6528b016-7e7a-5f42-bb80-0fc7063586be" :question/id #uuid "6528b016-7e7a-5f42-bb80-0fc7063586be" :question/math-academy-id "q-352031" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=\\frac{1}{2}t,\\,y=\\frac{1}{4}{t}^{2},\\,t\\in [0,\\sqrt{3}].\n$$\n\nDetermine the surface area $S$ generated when this curve is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\sqrt{3}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}t)=\\frac{1}{2}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{4}{t}^{2})=\\frac{1}{2}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\sqrt{3}}\\frac{1}{2}t\\sqrt{{(\\frac{1}{2})}^{2}+{(\\frac{1}{2}t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}\\frac{1}{2}t\\sqrt{\\frac{1}{4}+\\frac{1}{4}{t}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}\\frac{1}{2}t\\sqrt{\\frac{1}{4}(1+{t}^{2})}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{3}}\\frac{1}{2}t\\cdot \\frac{1}{2}\\sqrt{1+{t}^{2}}\\,\\text{d}t \\\\  & =\\frac{\\pi }{4}{\\int }_{0}^{\\sqrt{3}}\\sqrt{1+{t}^{2}}\\cdot 2t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=1+{t}^{2}.$ Then, $\\text{d}u=2t\\,\\text{d}t.$ We also update the limits of integration for $u:$\n\n| **$t$** | $0$ | $\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =\\frac{\\pi }{4}{\\int }_{0}^{\\sqrt{3}}\\sqrt{1+{t}^{2}}\\cdot 2t\\,\\text{d}t \\\\  & =\\frac{\\pi }{4}{\\int }_{1}^{4}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{\\pi }{4}{\\int }_{1}^{4}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{\\pi }{4}\\cdot {[\\frac{2}{3}{u}^{3/2}]}_{1}^{4} \\\\  & =\\frac{\\pi }{6}[(4)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{\\pi }{6}(8-1) \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a3f06b1d-08c6-50bc-8914-e903872c2d7d"] :db/ensure [:question/validate]} {:db/id "answer-field-a3f06b1d-08c6-50bc-8914-e903872c2d7d" :answer-field/id #uuid "a3f06b1d-08c6-50bc-8914-e903872c2d7d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-961eb0d5-8253-50e6-a961-755f2db89486" :answer-field/choices ["answer-961eb0d5-8253-50e6-a961-755f2db89486"] :db/ensure [:answer-field/validate]} {:db/id "answer-961eb0d5-8253-50e6-a961-755f2db89486" :answer/id #uuid "961eb0d5-8253-50e6-a961-755f2db89486" :answer/type :answer.type/math :answer/value "\\frac{7\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "question-4f72f786-eb31-5b03-9051-ae70858e9f5f" :question/id #uuid "4f72f786-eb31-5b03-9051-ae70858e9f5f" :question/math-academy-id "q-352035" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={t}^{2},\\,y=\\frac{1}{\\sqrt{3}}{t}^{4},\\,t\\in [0,\\sqrt[4]{6}].\n$$\n\nDetermine the surface area $S$ generated when this curve is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\sqrt[4]{6}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{3}}{t}^{4})=\\frac{4}{\\sqrt{3}}{t}^{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\sqrt[4]{6}}{t}^{2}\\sqrt{(2t)^{2}+{(\\frac{4}{\\sqrt{3}}{t}^{3})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt[4]{6}}{t}^{2}\\sqrt{4{t}^{2}+\\frac{16}{3}{t}^{6}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt[4]{6}}{t}^{2}\\sqrt{4{t}^{2}(1+\\frac{4}{3}{t}^{4})}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\sqrt[4]{6}}{t}^{2}\\cdot 2|t|\\sqrt{1+\\frac{4}{3}{t}^{4}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{\\sqrt[4]{6}}\\sqrt{1+\\frac{4}{3}{t}^{4}}\\cdot {t}^{3}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=1+\\frac{4}{3}{t}^{4}.$ Then, $\\text{d}u=\\frac{16}{3}{t}^{3}\\,\\text{d}t⟹{t}^{3}\\,\\text{d}t=\\frac{3}{16}\\text{d}u.$ We also update the limits of integration for $u:$\n\n| **$t$** | $0$ | $\\sqrt[4]{6}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =4\\pi {\\int }_{0}^{\\sqrt[4]{6}}\\sqrt{1+\\frac{4}{3}{t}^{4}}\\cdot {t}^{3}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{1}^{9}\\sqrt{u}\\cdot \\frac{3}{16}\\,\\text{d}u \\\\  & =\\frac{3\\pi }{4}{\\int }_{1}^{9}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{3\\pi }{4}\\cdot {[\\frac{2}{3}{u}^{3/2}]}_{1}^{9} \\\\  & =\\frac{\\pi }{2}[(9)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{\\pi }{2}(27-1) \\\\  & =13\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-12fa28de-d131-50b4-b0e1-7dd696b0e54f"] :db/ensure [:question/validate]} {:db/id "answer-field-12fa28de-d131-50b4-b0e1-7dd696b0e54f" :answer-field/id #uuid "12fa28de-d131-50b4-b0e1-7dd696b0e54f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f3256b67-7e99-5826-a95a-b55a197e4d06" :answer-field/choices ["answer-f3256b67-7e99-5826-a95a-b55a197e4d06"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3256b67-7e99-5826-a95a-b55a197e4d06" :answer/id #uuid "f3256b67-7e99-5826-a95a-b55a197e4d06" :answer/type :answer.type/math :answer/value "13\\pi" :db/ensure [:answer/validate]} {:db/id "question-95891d65-20e2-5732-9bd4-e52bbf49b5d2" :question/id #uuid "95891d65-20e2-5732-9bd4-e52bbf49b5d2" :question/math-academy-id "q-352088" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=\\operatorname{cos}⁡t+\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{t}{2})),\\,y=\\operatorname{sin}⁡t,\\,t\\in [\\frac{\\pi }{3},\\frac{\\pi }{2}].\n$$\n\nDetermine the surface area $S$ generated when this curve is rotated $2\\pi $ radians about the $x$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=\\frac{\\pi }{3}$ to ${t}_{2}=\\frac{\\pi }{2}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{ln}⁡(\\operatorname{tan}⁡(\\frac{t}{2}))) \\\\  & =-\\operatorname{sin}⁡t+\\frac{1}{\\operatorname{tan}⁡(t/2)}\\cdot {sec}^{2}⁡(\\frac{t}{2})\\cdot \\frac{1}{2} \\\\  & =-\\operatorname{sin}⁡t+\\operatorname{csc}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t) \\\\  & =\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\sqrt{{(\\operatorname{csc}⁡t-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\sqrt{{csc}^{2}⁡t-2+{sin}^{2}⁡t+{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\sqrt{{csc}^{2}⁡t-2+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\sqrt{{csc}^{2}⁡t-1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\sqrt{{cot}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cot}⁡t\\,\\text{d}t \\\\  & =2\\pi {\\int }_{\\pi /3}^{\\pi /2}\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=\\operatorname{sin}⁡t.$ Then, $\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t.$ We also update the limits of integration for $u:$\n\n| **$t$** | $\\frac{\\pi }{3}$ | $\\frac{\\pi }{2}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\sqrt{3}}{2}$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & ={\\int }_{\\pi /3}^{\\pi /2}2\\pi \\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{3}/2}^{1}2\\pi \\,\\text{d}u \\\\  & =2\\pi {[u]}_{\\sqrt{3}/2}^{1} \\\\  & =2\\pi (1-\\frac{\\sqrt{3}}{2}) \\\\  & =\\pi (2-\\sqrt{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6b596d95-5abf-5a25-8619-bd46ab687c7e"] :db/ensure [:question/validate]} {:db/id "answer-field-6b596d95-5abf-5a25-8619-bd46ab687c7e" :answer-field/id #uuid "6b596d95-5abf-5a25-8619-bd46ab687c7e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c15a0040-721e-5583-80c4-6b4b6d161036" :answer-field/choices ["answer-c15a0040-721e-5583-80c4-6b4b6d161036"] :db/ensure [:answer-field/validate]} {:db/id "answer-c15a0040-721e-5583-80c4-6b4b6d161036" :answer/id #uuid "c15a0040-721e-5583-80c4-6b4b6d161036" :answer/type :answer.type/math :answer/value "\\pi(2-\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "activity-f6065dfd-4199-50b0-9334-da4b9f494b0d" :activity/id #uuid "f6065dfd-4199-50b0-9334-da4b9f494b0d" :activity/title "Surface Areas of Revolution for Parametric Curves" :activity/type :activity.type/review :activity/scope 17592186049265 :activity/course 17592186046645 :activity/steps ["step-50c04e39-0863-56d5-a574-6b3bc23fdf01" "step-032c215a-e883-53c2-bdc0-c14d20b9401e" "step-8d943a17-8038-5310-ba12-619cf9e0f21c" "step-08362200-3b6f-52bb-9fff-49cbac1aba34" "step-3a2cc474-bbd9-524c-88cd-2cfdbe4a121b"] :activity/first-step "step-50c04e39-0863-56d5-a574-6b3bc23fdf01" :db/ensure [:activity/validate]} {:db/id "step-50c04e39-0863-56d5-a574-6b3bc23fdf01" :step/id #uuid "50c04e39-0863-56d5-a574-6b3bc23fdf01" :step/content 17592186129488 :step/next "step-032c215a-e883-53c2-bdc0-c14d20b9401e" :db/ensure [:step/validate]} {:db/id "step-032c215a-e883-53c2-bdc0-c14d20b9401e" :step/id #uuid "032c215a-e883-53c2-bdc0-c14d20b9401e" :step/content "question-5349d9de-8c6d-5416-a022-6878977b6004" :step/next "step-8d943a17-8038-5310-ba12-619cf9e0f21c" :db/ensure [:step/validate]} {:db/id "step-8d943a17-8038-5310-ba12-619cf9e0f21c" :step/id #uuid "8d943a17-8038-5310-ba12-619cf9e0f21c" :step/content "question-6528b016-7e7a-5f42-bb80-0fc7063586be" :step/next "step-08362200-3b6f-52bb-9fff-49cbac1aba34" :db/ensure [:step/validate]} {:db/id "step-08362200-3b6f-52bb-9fff-49cbac1aba34" :step/id #uuid "08362200-3b6f-52bb-9fff-49cbac1aba34" :step/content "question-4f72f786-eb31-5b03-9051-ae70858e9f5f" :step/next "step-3a2cc474-bbd9-524c-88cd-2cfdbe4a121b" :db/ensure [:step/validate]} {:db/id "step-3a2cc474-bbd9-524c-88cd-2cfdbe4a121b" :step/id #uuid "3a2cc474-bbd9-524c-88cd-2cfdbe4a121b" :step/content "question-95891d65-20e2-5732-9bd4-e52bbf49b5d2" :db/ensure [:step/validate]} {:db/id 17592186188336 :knowledge-point/questions ["question-a618ef53-1eb4-5d7e-994a-cd43bde62157" "question-8cb1a10c-eb8d-5503-81eb-a44381451337" "question-59aca6d9-1752-57b6-a727-2d8a95f6602b" "question-3b4c1a29-e4bc-58eb-ae8a-170f49cecb2b" "question-2866f3dd-6eaf-53a1-aed5-f4ad68a3ab1f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188043 :question/problem "![](images/d4/d405cc4f96436baa6a90b8b8632a105efe7875f296e800db9ae846c1ee9eb805.svg)\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\textrm{Var}\\big[X \\,|\\, Y=-2\\big]$ given that the conditional probability density function $f_{X|Y}(x \\,|\\, -2)$ is shown above and the corresponding expected value is $\\mu_{X|-2}=\\dfrac{3}{4}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\textrm{E}\\big[X^2 \\,| \\, Y=y \\big] = \\int_{-\\infty}^{\\infty} x^2 \\, f_{X|Y}(x \\,|\\, y) \\: \\textrm{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-2] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-2)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{4}\\,\\text{d}x \\\\  & ={[\\frac{3{x}^{5}}{5}]}_{0}^{1} \\\\  & =\\frac{3}{5}-0 \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-2] & =\\text{E}[{X}^{2}\\,|\\,Y=-2]-{\\mu }_{X|-2}^{2} \\\\  & =\\frac{3}{5}-{(\\frac{3}{4})}^{2} \\\\  & =\\frac{3}{5}-\\frac{9}{16} \\\\  & =\\frac{3}{80}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186188337 :knowledge-point/questions ["question-6104314b-b213-5403-b96a-2e0ddf20d4ca" "question-988b2bee-8b04-51ca-a9c5-c53fb0470471" "question-aa39286d-2046-5d16-b60c-2e22bf1173b7" "question-04b02bf9-cae6-594f-ac96-340afba92b08"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188044 :question/problem "![](images/bf/bf8474d75d3d2dd57797d05266e055ca830e4b3e42532d167f358140906a3b4d.svg)\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\textrm{Var}\\big[Y \\,|\\, X=3\\big]$ given that the conditional probability density function $f_{Y|X}(y \\,|\\, 3)$ is shown above and the corresponding expected value is $\\mu_{Y|3}=\\dfrac{3}{2}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\textrm{E}\\big[Y^2 \\,| \\, X=x \\big] = \\int_{-\\infty}^{\\infty} y^2 \\, f_{Y|X}(y \\,|\\, x) \\: \\textrm{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=3] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,3)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{3}{{y}^{4}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }\\frac{3}{{y}^{2}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }3{y}^{-2}\\,\\text{d}y \\\\  & ={[3\\cdot \\frac{{y}^{-1}}{(-1)}]}_{1}^{\\infty } \\\\  & ={[-\\frac{3}{y}]}_{1}^{\\infty } \\\\  & =0-(-3) \\\\  & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=3] & =\\text{E}[{Y}^{2}\\,|\\,X=3]-{\\mu }_{Y|3}^{2} \\\\  & =3-{(\\frac{3}{2})}^{2} \\\\  & =3-\\frac{9}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186188338 :knowledge-point/questions ["question-e74c735c-6d68-5fb5-ad5e-520e538fc830" "question-37a3fb25-8245-5c86-91e5-a1e534022eb1" "question-48276d5d-5662-5546-a559-258dff238b59" "question-25e1f7ba-cab0-5f7d-b69c-953924c5cba0" "question-febad6f8-061f-513c-bf3e-fbe38a2e6b2e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188045 :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}2y\\operatorname{ln}⁡(x), & 1\\le x\\le e,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\operatorname{ln}⁡(x), & 1\\le x\\le e, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\textrm{Var}\\big[Y \\,\\big|\\, X=1 \\big]$ given that the corresponding expected value is $\\mu_{Y|1}=\\dfrac{2}{3}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\textrm{E}\\big[Y^2 \\,| \\, X=x \\big] = \\int_{-\\infty}^{\\infty} y^2 \\, f_{Y|X}(y \\,|\\, x) \\: \\textrm{d}y.\n$$\n\nNote that $\\textrm E\\big[ Y \\,|\\, X = x \\big]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{2y\\operatorname{ln}⁡(x)}{\\operatorname{ln}⁡(x)} \\\\  & =2y,\\end{aligned}\n$$\n\nwhere $1 \\leq x \\leq e, \\: 0 \\leq y \\leq 1.$ Outside this domain, we have $f_{Y|X} (y \\,|\\, x) = 0.$\n\nNotice that $f_{Y|X} (y \\,|\\, x)$ does not depend on $x.$ Therefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot 2y\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2{y}^{3}\\text{d}y \\\\  & ={[\\frac{{y}^{4}}{2}]}_{0}^{1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{2}-\\frac{4}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-a618ef53-1eb4-5d7e-994a-cd43bde62157" :question/id #uuid "a618ef53-1eb4-5d7e-994a-cd43bde62157" :question/math-academy-id "q-146771" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,-1)=\\{\\begin{aligned}\\frac{24}{7{x}^{4}}, & \\,1\\le x\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=-1]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,-1)$ is shown above and the corresponding expected value is ${\\mu }_{X|-1}=\\frac{9}{7}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-1)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{x}^{2}\\cdot \\frac{24}{7{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{24}{7{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{24}{7}{[-\\frac{1}{x}]}_{1}^{2} \\\\  & =\\frac{24}{7}[(-\\frac{1}{2})-(-1)] \\\\  & =\\frac{12}{7}\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-1] & =\\text{E}[{X}^{2}\\,|\\,Y=-1]-{\\mu }_{X|-1}^{2} \\\\  & =\\frac{12}{7}-{(\\frac{9}{7})}^{2} \\\\  & =\\frac{12}{7}-\\frac{81}{49} \\\\  & =\\frac{3}{49}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c39ce385-0fcd-519a-a701-e719a952cd46"] :db/ensure [:question/validate]} {:db/id "answer-field-c39ce385-0fcd-519a-a701-e719a952cd46" :answer-field/id #uuid "c39ce385-0fcd-519a-a701-e719a952cd46" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc42e7b8-acd5-5885-b965-56dae0313424" :answer-field/choices ["answer-bc42e7b8-acd5-5885-b965-56dae0313424" "answer-4b1fdd49-b96a-5691-8015-a399cf64cdd3" "answer-1dd913af-0d4d-584f-bb88-dda0c4ba49dd" "answer-e09649d9-9ba1-578c-809b-de4e41e98be6" "answer-491be78e-8f5c-5fda-ad13-feacd90c83d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc42e7b8-acd5-5885-b965-56dae0313424" :answer/id #uuid "bc42e7b8-acd5-5885-b965-56dae0313424" :answer/type :answer.type/math :answer/value "\\frac{3}{49}" :db/ensure [:answer/validate]} {:db/id "answer-4b1fdd49-b96a-5691-8015-a399cf64cdd3" :answer/id #uuid "4b1fdd49-b96a-5691-8015-a399cf64cdd3" :answer/type :answer.type/math :answer/value "\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1dd913af-0d4d-584f-bb88-dda0c4ba49dd" :answer/id #uuid "1dd913af-0d4d-584f-bb88-dda0c4ba49dd" :answer/type :answer.type/math :answer/value "\\frac{63}{49}" :db/ensure [:answer/validate]} {:db/id "answer-e09649d9-9ba1-578c-809b-de4e41e98be6" :answer/id #uuid "e09649d9-9ba1-578c-809b-de4e41e98be6" :answer/type :answer.type/math :answer/value "\\frac{9}{49}" :db/ensure [:answer/validate]} {:db/id "answer-491be78e-8f5c-5fda-ad13-feacd90c83d5" :answer/id #uuid "491be78e-8f5c-5fda-ad13-feacd90c83d5" :answer/type :answer.type/math :answer/value "\\frac{9}{7}" :db/ensure [:answer/validate]} {:db/id "question-8cb1a10c-eb8d-5503-81eb-a44381451337" :question/id #uuid "8cb1a10c-eb8d-5503-81eb-a44381451337" :question/math-academy-id "q-146807" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,4)=\\{\\begin{aligned}\\frac{3}{{x}^{3/2}}, & \\,4\\le x\\le 9 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=4]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,4)$ is shown above and the corresponding expected value is ${\\mu }_{X|4}=6.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=4] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,4)\\,\\text{d}x \\\\  & ={\\int }_{4}^{9}{x}^{2}\\cdot \\frac{3}{{x}^{3/2}}\\,\\text{d}x \\\\  & ={\\int }_{4}^{9}3\\sqrt{x}\\,\\text{d}x \\\\  & ={[2{x}^{3/2}]}_{4}^{9} \\\\  & =2(27-8) \\\\  & =38.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=4] & =\\text{E}[{X}^{2}\\,|\\,Y=4]-{\\mu }_{X|4}^{2} \\\\  & =38-{6}^{2} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-78d192f2-fd61-50da-beb1-1728d446e7ae"] :db/ensure [:question/validate]} {:db/id "answer-field-78d192f2-fd61-50da-beb1-1728d446e7ae" :answer-field/id #uuid "78d192f2-fd61-50da-beb1-1728d446e7ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6a364ff-fd0c-5130-ba2f-e616cd755bc8" :answer-field/choices ["answer-f6a364ff-fd0c-5130-ba2f-e616cd755bc8" "answer-1489093e-e3a3-55f2-b8ea-f74432755e95" "answer-15dde4cf-3e00-5078-bcf3-4598e3e2c37b" "answer-a86c312b-7c26-5fa7-90ee-febf5e5c1ac4" "answer-b64ece9b-7dd8-5d15-a949-4a704a08d316"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6a364ff-fd0c-5130-ba2f-e616cd755bc8" :answer/id #uuid "f6a364ff-fd0c-5130-ba2f-e616cd755bc8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-1489093e-e3a3-55f2-b8ea-f74432755e95" :answer/id #uuid "1489093e-e3a3-55f2-b8ea-f74432755e95" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-15dde4cf-3e00-5078-bcf3-4598e3e2c37b" :answer/id #uuid "15dde4cf-3e00-5078-bcf3-4598e3e2c37b" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "answer-a86c312b-7c26-5fa7-90ee-febf5e5c1ac4" :answer/id #uuid "a86c312b-7c26-5fa7-90ee-febf5e5c1ac4" :answer/type :answer.type/math :answer/value "44" :db/ensure [:answer/validate]} {:db/id "answer-b64ece9b-7dd8-5d15-a949-4a704a08d316" :answer/id #uuid "b64ece9b-7dd8-5d15-a949-4a704a08d316" :answer/type :answer.type/math :answer/value "74" :db/ensure [:answer/validate]} {:db/id "question-59aca6d9-1752-57b6-a727-2d8a95f6602b" :question/id #uuid "59aca6d9-1752-57b6-a727-2d8a95f6602b" :question/math-academy-id "q-149357" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,0)=\\{\\begin{aligned}\\frac{12}{7{x}^{5/2}}, & \\,1\\le x\\le 4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=0]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{X|0}=\\frac{12}{7}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=0] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,0)\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}{x}^{2}\\cdot \\frac{12}{7{x}^{5/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{12}{7\\sqrt{x}}\\,\\text{d}x \\\\  & ={[\\frac{24\\sqrt{x}}{7}]}_{1}^{4} \\\\  & =\\frac{48}{7}-\\frac{24}{7} \\\\  & =\\frac{24}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=0] & =\\text{E}[{X}^{2}\\,|\\,Y=0]-{\\mu }_{X|0}^{2} \\\\  & =\\frac{24}{7}-{(\\frac{12}{7})}^{2} \\\\  & =\\frac{24}{7}-\\frac{144}{49} \\\\  & =\\frac{24}{49}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dccf4473-8ce6-5a7b-9170-9d177e05cbfd"] :db/ensure [:question/validate]} {:db/id "answer-field-dccf4473-8ce6-5a7b-9170-9d177e05cbfd" :answer-field/id #uuid "dccf4473-8ce6-5a7b-9170-9d177e05cbfd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-694824b2-68f4-5131-a788-8727d4006841" :answer-field/choices ["answer-a16fd62d-5444-5e85-96f9-c5d6c7412063" "answer-23beb7dd-cb27-516a-87c2-22187aecddb4" "answer-694824b2-68f4-5131-a788-8727d4006841" "answer-98abe252-a017-5e77-b742-868d2adf14cb" "answer-b3d991b4-30f6-52a1-afce-0bb0222c6615"] :db/ensure [:answer-field/validate]} {:db/id "answer-a16fd62d-5444-5e85-96f9-c5d6c7412063" :answer/id #uuid "a16fd62d-5444-5e85-96f9-c5d6c7412063" :answer/type :answer.type/math :answer/value "\\frac{12}{49}" :db/ensure [:answer/validate]} {:db/id "answer-23beb7dd-cb27-516a-87c2-22187aecddb4" :answer/id #uuid "23beb7dd-cb27-516a-87c2-22187aecddb4" :answer/type :answer.type/math :answer/value "\\frac{12}{7}" :db/ensure [:answer/validate]} {:db/id "answer-694824b2-68f4-5131-a788-8727d4006841" :answer/id #uuid "694824b2-68f4-5131-a788-8727d4006841" :answer/type :answer.type/math :answer/value "\\frac{24}{49}" :db/ensure [:answer/validate]} {:db/id "answer-98abe252-a017-5e77-b742-868d2adf14cb" :answer/id #uuid "98abe252-a017-5e77-b742-868d2adf14cb" :answer/type :answer.type/math :answer/value "\\frac{24}{7}" :db/ensure [:answer/validate]} {:db/id "answer-b3d991b4-30f6-52a1-afce-0bb0222c6615" :answer/id #uuid "b3d991b4-30f6-52a1-afce-0bb0222c6615" :answer/type :answer.type/math :answer/value "\\frac{48}{49}" :db/ensure [:answer/validate]} {:db/id "question-3b4c1a29-e4bc-58eb-ae8a-170f49cecb2b" :question/id #uuid "3b4c1a29-e4bc-58eb-ae8a-170f49cecb2b" :question/math-academy-id "q-146761" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,0)=\\{\\begin{aligned}\\frac{3}{14}\\sqrt{x}, & \\,1\\le x\\le 4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=0]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,0)$ is shown above and the corresponding expected value is ${\\mu }_{X|0}=\\frac{\\sqrt{3}}{7}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=0] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,0)\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}{x}^{2}\\cdot \\frac{3}{14}\\sqrt{x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{3}{14}{x}^{5/2}\\,\\text{d}x \\\\  & ={[\\frac{3}{49}{x}^{7/2}]}_{1}^{4} \\\\  & =\\frac{3}{49}(128-1) \\\\  & =\\frac{381}{49}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=0] & =\\text{E}[{X}^{2}\\,|\\,Y=0]-{\\mu }_{X|0}^{2} \\\\  & =\\frac{381}{49}-{(\\frac{\\sqrt{3}}{7})}^{2} \\\\  & =\\frac{381}{49}-\\frac{3}{49} \\\\  & =\\frac{378}{49} \\\\  & =\\frac{54}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-de48ce71-ed4e-5a50-80fd-461f4a5c82ff"] :db/ensure [:question/validate]} {:db/id "answer-field-de48ce71-ed4e-5a50-80fd-461f4a5c82ff" :answer-field/id #uuid "de48ce71-ed4e-5a50-80fd-461f4a5c82ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a56625c4-5e98-548c-bea6-5d94c2fb908e" :answer-field/choices ["answer-e6cbeb1a-1375-5455-b8f6-f5ce904eaab8" "answer-88e834ca-6b87-553a-a237-a4681d65ed06" "answer-7382e9bb-66e3-536f-bf47-96a851f09b48" "answer-cb89ee2c-2a49-5be9-9e3b-ad09f4a34f3c" "answer-a56625c4-5e98-548c-bea6-5d94c2fb908e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6cbeb1a-1375-5455-b8f6-f5ce904eaab8" :answer/id #uuid "e6cbeb1a-1375-5455-b8f6-f5ce904eaab8" :answer/type :answer.type/math :answer/value "\\frac{360}{49}" :db/ensure [:answer/validate]} {:db/id "answer-88e834ca-6b87-553a-a237-a4681d65ed06" :answer/id #uuid "88e834ca-6b87-553a-a237-a4681d65ed06" :answer/type :answer.type/math :answer/value "\\frac{381}{49}" :db/ensure [:answer/validate]} {:db/id "answer-7382e9bb-66e3-536f-bf47-96a851f09b48" :answer/id #uuid "7382e9bb-66e3-536f-bf47-96a851f09b48" :answer/type :answer.type/math :answer/value "\\frac{384}{49}" :db/ensure [:answer/validate]} {:db/id "answer-cb89ee2c-2a49-5be9-9e3b-ad09f4a34f3c" :answer/id #uuid "cb89ee2c-2a49-5be9-9e3b-ad09f4a34f3c" :answer/type :answer.type/math :answer/value "\\frac{51}{7}" :db/ensure [:answer/validate]} {:db/id "answer-a56625c4-5e98-548c-bea6-5d94c2fb908e" :answer/id #uuid "a56625c4-5e98-548c-bea6-5d94c2fb908e" :answer/type :answer.type/math :answer/value "\\frac{54}{7}" :db/ensure [:answer/validate]} {:db/id "question-2866f3dd-6eaf-53a1-aed5-f4ad68a3ab1f" :question/id #uuid "2866f3dd-6eaf-53a1-aed5-f4ad68a3ab1f" :question/math-academy-id "q-146395" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,1)=\\{\\begin{aligned}2y, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|1}=\\frac{2}{3}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot 2y\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1}{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{2{y}^{4}}{4}]}_{0}^{1} \\\\  & =\\frac{1}{2}-0 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{2}-\\frac{4}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7186124f-248a-5608-b06b-90a979a094ca"] :db/ensure [:question/validate]} {:db/id "answer-field-7186124f-248a-5608-b06b-90a979a094ca" :answer-field/id #uuid "7186124f-248a-5608-b06b-90a979a094ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6716a6d3-11e8-5185-8a14-c81cf63f513b" :answer-field/choices ["answer-6716a6d3-11e8-5185-8a14-c81cf63f513b" "answer-cde47949-e5a4-500e-82a8-40c11888b0e0" "answer-d6596022-5d1b-577f-a508-e5cb0a327c6f" "answer-a5022d84-3876-5770-bcec-f22b051278c9" "answer-5db52af3-2d00-57fe-83ac-e1e4cabb425b"] :db/ensure [:answer-field/validate]} {:db/id "answer-6716a6d3-11e8-5185-8a14-c81cf63f513b" :answer/id #uuid "6716a6d3-11e8-5185-8a14-c81cf63f513b" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-cde47949-e5a4-500e-82a8-40c11888b0e0" :answer/id #uuid "cde47949-e5a4-500e-82a8-40c11888b0e0" :answer/type :answer.type/math :answer/value "\\frac{1}{36}" :db/ensure [:answer/validate]} {:db/id "answer-d6596022-5d1b-577f-a508-e5cb0a327c6f" :answer/id #uuid "d6596022-5d1b-577f-a508-e5cb0a327c6f" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-a5022d84-3876-5770-bcec-f22b051278c9" :answer/id #uuid "a5022d84-3876-5770-bcec-f22b051278c9" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-5db52af3-2d00-57fe-83ac-e1e4cabb425b" :answer/id #uuid "5db52af3-2d00-57fe-83ac-e1e4cabb425b" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id 17592186188724 :question/problem "$$\n{f}_{X|Y}(x\\,|\\,-2)=\\{\\begin{aligned}\\frac{4}{{x}^{5}}, & \\,x\\ge 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=-2]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,-2)$ is shown above and the corresponding expected value is ${\\mu }_{X|-2}=\\frac{4}{3}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-2] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-2)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }4{x}^{-3}\\,\\text{d}x \\\\  & ={[4\\cdot \\frac{{x}^{-2}}{(-2)}]}_{1}^{\\infty } \\\\  & ={[-\\frac{2}{{x}^{2}}]}_{1}^{\\infty } \\\\  & =0-(-2) \\\\  & =2.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-2] & =\\text{E}[{X}^{2}\\,|\\,Y=-2]-{\\mu }_{X|-2}^{2} \\\\  & =2-{(\\frac{4}{3})}^{2} \\\\  & =2-\\frac{16}{9} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186186624 :answer-field/correct 17592186186627 :db/ensure [:answer-field/validate]} {:db/id "question-6104314b-b213-5403-b96a-2e0ddf20d4ca" :question/id #uuid "6104314b-b213-5403-b96a-2e0ddf20d4ca" :question/math-academy-id "q-149399" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,5)=\\{\\begin{aligned}\\frac{3}{{x}^{4}}, & \\,x\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=5]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,5)$ is shown above and the corresponding expected value is ${\\mu }_{X|5}=-\\frac{3}{2}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=5] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,5)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}{x}^{2}\\cdot \\frac{3}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}3{x}^{-2}\\,\\text{d}x \\\\  & ={[-3\\cdot {x}^{-1}]}_{-\\infty }^{-1} \\\\  & ={[-\\frac{3}{x}]}_{-\\infty }^{-1} \\\\  & =3-0 \\\\  & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=5] & =\\text{E}[{X}^{2}\\,|\\,Y=5]-{\\mu }_{X|5}^{2} \\\\  & =3-{(-\\frac{3}{2})}^{2} \\\\  & =3-\\frac{9}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-06e3e1ec-1b29-5e88-912e-1d47aa3d4d7d"] :db/ensure [:question/validate]} {:db/id "answer-field-06e3e1ec-1b29-5e88-912e-1d47aa3d4d7d" :answer-field/id #uuid "06e3e1ec-1b29-5e88-912e-1d47aa3d4d7d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dda5e757-29ae-51d9-ac4e-1c47bef47985" :answer-field/choices ["answer-34cc357a-5d15-5858-a9da-1fbed5a44025" "answer-78434c08-58fd-5864-98a8-e08d7e0b4b36" "answer-dda5e757-29ae-51d9-ac4e-1c47bef47985" "answer-5e7acdc3-b79c-540c-8876-d8d4ab0dc5e4" "answer-6726955f-fcbe-51ef-81c8-c5b97a0a797b"] :db/ensure [:answer-field/validate]} {:db/id "answer-34cc357a-5d15-5858-a9da-1fbed5a44025" :answer/id #uuid "34cc357a-5d15-5858-a9da-1fbed5a44025" :answer/type :answer.type/math :answer/value "\\frac{21}{4}" :db/ensure [:answer/validate]} {:db/id "answer-78434c08-58fd-5864-98a8-e08d7e0b4b36" :answer/id #uuid "78434c08-58fd-5864-98a8-e08d7e0b4b36" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-dda5e757-29ae-51d9-ac4e-1c47bef47985" :answer/id #uuid "dda5e757-29ae-51d9-ac4e-1c47bef47985" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-5e7acdc3-b79c-540c-8876-d8d4ab0dc5e4" :answer/id #uuid "5e7acdc3-b79c-540c-8876-d8d4ab0dc5e4" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6726955f-fcbe-51ef-81c8-c5b97a0a797b" :answer/id #uuid "6726955f-fcbe-51ef-81c8-c5b97a0a797b" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "question-988b2bee-8b04-51ca-a9c5-c53fb0470471" :question/id #uuid "988b2bee-8b04-51ca-a9c5-c53fb0470471" :question/math-academy-id "q-149406" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,-4)=\\{\\begin{aligned}\\frac{7}{2{x}^{9/2}}, & \\,x\\ge 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=-4]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,-4)$ is shown above and the corresponding expected value is ${\\mu }_{X|-4}=\\frac{7}{5}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=-4] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,-4)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{7}{2{x}^{9/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{2{x}^{5/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{7}{2}{x}^{-5/2}\\,\\text{d}x \\\\  & ={[\\frac{7}{2}\\cdot (-\\frac{2}{3})\\cdot {x}^{-3/2}]}_{1}^{\\infty } \\\\  & ={[-\\frac{7}{3{x}^{3/2}}]}_{1}^{\\infty } \\\\  & =0-(-\\frac{7}{3}) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=-4] & =\\text{E}[{X}^{2}\\,|\\,Y=-4]-{\\mu }_{X|-4}^{2} \\\\  & =\\frac{7}{3}-{(\\frac{7}{5})}^{2} \\\\  & =\\frac{7}{3}-\\frac{49}{25} \\\\  & =\\frac{28}{75}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c24a3477-bac3-594c-9727-d90bcb135154"] :db/ensure [:question/validate]} {:db/id "answer-field-c24a3477-bac3-594c-9727-d90bcb135154" :answer-field/id #uuid "c24a3477-bac3-594c-9727-d90bcb135154" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d83f26db-9776-52f9-ae64-5454e381d5e6" :answer-field/choices ["answer-4afaae21-7107-5bfd-ad67-092f29f09b24" "answer-89f5dd1b-92ab-5512-a96e-3f46933c72fd" "answer-d83f26db-9776-52f9-ae64-5454e381d5e6" "answer-9ea6f873-9f56-50db-b46b-34cc9aa92655" "answer-37ac5a0b-682d-58ce-8d19-548dbcc7f74d"] :db/ensure [:answer-field/validate]} {:db/id "answer-4afaae21-7107-5bfd-ad67-092f29f09b24" :answer/id #uuid "4afaae21-7107-5bfd-ad67-092f29f09b24" :answer/type :answer.type/math :answer/value "\\frac{14}{15}" :db/ensure [:answer/validate]} {:db/id "answer-89f5dd1b-92ab-5512-a96e-3f46933c72fd" :answer/id #uuid "89f5dd1b-92ab-5512-a96e-3f46933c72fd" :answer/type :answer.type/math :answer/value "\\frac{14}{75}" :db/ensure [:answer/validate]} {:db/id "answer-d83f26db-9776-52f9-ae64-5454e381d5e6" :answer/id #uuid "d83f26db-9776-52f9-ae64-5454e381d5e6" :answer/type :answer.type/math :answer/value "\\frac{28}{75}" :db/ensure [:answer/validate]} {:db/id "answer-9ea6f873-9f56-50db-b46b-34cc9aa92655" :answer/id #uuid "9ea6f873-9f56-50db-b46b-34cc9aa92655" :answer/type :answer.type/math :answer/value "\\frac{56}{75}" :db/ensure [:answer/validate]} {:db/id "answer-37ac5a0b-682d-58ce-8d19-548dbcc7f74d" :answer/id #uuid "37ac5a0b-682d-58ce-8d19-548dbcc7f74d" :answer/type :answer.type/math :answer/value "\\frac{7}{15}" :db/ensure [:answer/validate]} {:db/id "question-aa39286d-2046-5d16-b60c-2e22bf1173b7" :question/id #uuid "aa39286d-2046-5d16-b60c-2e22bf1173b7" :question/math-academy-id "q-149407" :question/problem "$$\n{f}_{X|Y}(x\\,|\\,6)=\\{\\begin{aligned}-\\frac{6}{{x}^{7}}, & \\,x\\le -1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[X\\,|\\,Y=6]$ given that the conditional probability density function ${f}_{X|Y}(x\\,|\\,6)$ is shown above and the corresponding expected value is ${\\mu }_{X|6}=-\\frac{6}{5}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=6] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,6)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}{x}^{2}\\cdot (-\\frac{6}{{x}^{7}})\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}-\\frac{6}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-1}-6{x}^{-5}\\,\\text{d}x \\\\  & ={[\\frac{(-6)}{(-4)}\\cdot {x}^{-4}]}_{-\\infty }^{-1} \\\\  & ={[\\frac{3}{2{x}^{4}}]}_{-\\infty }^{-1} \\\\  & =\\frac{3}{2}-0 \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=6] & =\\text{E}[{X}^{2}\\,|\\,Y=6]-{\\mu }_{X|6}^{2} \\\\  & =\\frac{3}{2}-{(-\\frac{6}{5})}^{2} \\\\  & =\\frac{3}{2}-\\frac{36}{25} \\\\  & =\\frac{3}{50}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-649ea598-2503-50e9-9e7d-932e638f034c"] :db/ensure [:question/validate]} {:db/id "answer-field-649ea598-2503-50e9-9e7d-932e638f034c" :answer-field/id #uuid "649ea598-2503-50e9-9e7d-932e638f034c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77877244-7515-5435-983f-d36e7965ce08" :answer-field/choices ["answer-2fb0d6fb-00d5-5de1-a313-8844185c3c29" "answer-3451d803-efd4-5f81-986a-440c80249e19" "answer-eafb00d8-0e70-5b61-9556-8adc6cb3395b" "answer-33418197-c818-5634-8bea-8cd2f392480a" "answer-77877244-7515-5435-983f-d36e7965ce08"] :db/ensure [:answer-field/validate]} {:db/id "answer-2fb0d6fb-00d5-5de1-a313-8844185c3c29" :answer/id #uuid "2fb0d6fb-00d5-5de1-a313-8844185c3c29" :answer/type :answer.type/math :answer/value "\\frac{27}{10}" :db/ensure [:answer/validate]} {:db/id "answer-3451d803-efd4-5f81-986a-440c80249e19" :answer/id #uuid "3451d803-efd4-5f81-986a-440c80249e19" :answer/type :answer.type/math :answer/value "\\frac{27}{50}" :db/ensure [:answer/validate]} {:db/id "answer-eafb00d8-0e70-5b61-9556-8adc6cb3395b" :answer/id #uuid "eafb00d8-0e70-5b61-9556-8adc6cb3395b" :answer/type :answer.type/math :answer/value "\\frac{36}{25}" :db/ensure [:answer/validate]} {:db/id "answer-33418197-c818-5634-8bea-8cd2f392480a" :answer/id #uuid "33418197-c818-5634-8bea-8cd2f392480a" :answer/type :answer.type/math :answer/value "\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-77877244-7515-5435-983f-d36e7965ce08" :answer/id #uuid "77877244-7515-5435-983f-d36e7965ce08" :answer/type :answer.type/math :answer/value "\\frac{3}{50}" :db/ensure [:answer/validate]} {:db/id "question-04b02bf9-cae6-594f-ac96-340afba92b08" :question/id #uuid "04b02bf9-cae6-594f-ac96-340afba92b08" :question/math-academy-id "q-149411" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,-1)=\\{\\begin{aligned}\\frac{9}{4{y}^{13/4}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=-1]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,-1)$ is shown above and the corresponding expected value is ${\\mu }_{Y|-1}=\\frac{9}{5}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=-1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,-1)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{9}{4{y}^{13/4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{9}{4{y}^{5/4}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }\\frac{9}{4}{y}^{-5/4}\\,\\text{d}y \\\\  & ={[\\frac{9}{4}\\cdot (-4)\\cdot {y}^{-1/4}]}_{1}^{\\infty } \\\\  & ={[-\\frac{9}{\\sqrt[4]{y}}]}_{1}^{\\infty } \\\\  & =0-(-9) \\\\  & =9.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=-2] & =\\text{E}[{Y}^{2}\\,|\\,X=-2]-{\\mu }_{Y|-2}^{2} \\\\  & =9-{(\\frac{9}{5})}^{2} \\\\  & =9-\\frac{81}{25} \\\\  & =\\frac{144}{25}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-72b99b6c-e8bf-5475-94ee-9d603ea83a76"] :db/ensure [:question/validate]} {:db/id "answer-field-72b99b6c-e8bf-5475-94ee-9d603ea83a76" :answer-field/id #uuid "72b99b6c-e8bf-5475-94ee-9d603ea83a76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd7eacc8-0ca8-5f80-8673-05ce828c5aa5" :answer-field/choices ["answer-dd7eacc8-0ca8-5f80-8673-05ce828c5aa5" "answer-cd39717a-740f-51a4-af35-8d0e263f4e78" "answer-7a9c8d26-f55d-57d5-82b3-aed3370cefe8" "answer-c72df470-55dc-5ffb-9294-61de19e9549f" "answer-0aa63b29-0409-5b18-83ab-8b4023056556"] :db/ensure [:answer-field/validate]} {:db/id "answer-dd7eacc8-0ca8-5f80-8673-05ce828c5aa5" :answer/id #uuid "dd7eacc8-0ca8-5f80-8673-05ce828c5aa5" :answer/type :answer.type/math :answer/value "\\frac{144}{25}" :db/ensure [:answer/validate]} {:db/id "answer-cd39717a-740f-51a4-af35-8d0e263f4e78" :answer/id #uuid "cd39717a-740f-51a4-af35-8d0e263f4e78" :answer/type :answer.type/math :answer/value "\\frac{36}{25}" :db/ensure [:answer/validate]} {:db/id "answer-7a9c8d26-f55d-57d5-82b3-aed3370cefe8" :answer/id #uuid "7a9c8d26-f55d-57d5-82b3-aed3370cefe8" :answer/type :answer.type/math :answer/value "\\frac{36}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c72df470-55dc-5ffb-9294-61de19e9549f" :answer/id #uuid "c72df470-55dc-5ffb-9294-61de19e9549f" :answer/type :answer.type/math :answer/value "\\frac{54}{5}" :db/ensure [:answer/validate]} {:db/id "answer-0aa63b29-0409-5b18-83ab-8b4023056556" :answer/id #uuid "0aa63b29-0409-5b18-83ab-8b4023056556" :answer/type :answer.type/math :answer/value "\\frac{81}{25}" :db/ensure [:answer/validate]} {:db/id "question-e74c735c-6d68-5fb5-ad5e-520e538fc830" :question/id #uuid "e74c735c-6d68-5fb5-ad5e-520e538fc830" :question/math-academy-id "q-146981" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3({x}^{2}y+y)}{2}, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{3(1+{x}^{2})}{4}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the corresponding expected value is ${\\mu }_{Y|1}=\\frac{2}{3}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{\\frac{3({x}^{2}y+y)}{2}}{\\frac{3(1+{x}^{2})}{4}} \\\\  & =\\frac{2({x}^{2}y+y)}{(1+{x}^{2})},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNow, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{2({1}^{2}\\cdot y+y)}{(1+{1}^{2})}=2y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}(2y)\\text{d}y \\\\  & =2{\\int }_{0}^{1}{y}^{3}\\text{d}y \\\\  & =2[\\frac{{y}^{4}}{4}]_{0}^{1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{2}-\\frac{4}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fe95487d-a357-5109-9ec1-41b889997c44"] :db/ensure [:question/validate]} {:db/id "answer-field-fe95487d-a357-5109-9ec1-41b889997c44" :answer-field/id #uuid "fe95487d-a357-5109-9ec1-41b889997c44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a4a8876-64da-599a-b333-8da10c7aac94" :answer-field/choices ["answer-9a4a8876-64da-599a-b333-8da10c7aac94" "answer-6a5f285e-8dc0-5c5d-9205-5077e2524a29" "answer-d3a515b3-38b4-574d-ab70-b455f36a3a65" "answer-3817ce70-a3ff-5d76-a92e-d07723b9ee70" "answer-f91da311-0343-5a45-b221-265ed560e0d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a4a8876-64da-599a-b333-8da10c7aac94" :answer/id #uuid "9a4a8876-64da-599a-b333-8da10c7aac94" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-6a5f285e-8dc0-5c5d-9205-5077e2524a29" :answer/id #uuid "6a5f285e-8dc0-5c5d-9205-5077e2524a29" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d3a515b3-38b4-574d-ab70-b455f36a3a65" :answer/id #uuid "d3a515b3-38b4-574d-ab70-b455f36a3a65" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-3817ce70-a3ff-5d76-a92e-d07723b9ee70" :answer/id #uuid "3817ce70-a3ff-5d76-a92e-d07723b9ee70" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-f91da311-0343-5a45-b221-265ed560e0d4" :answer/id #uuid "f91da311-0343-5a45-b221-265ed560e0d4" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "question-37a3fb25-8245-5c86-91e5-a1e534022eb1" :question/id #uuid "37a3fb25-8245-5c86-91e5-a1e534022eb1" :question/math-academy-id "q-146976" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}3x(1-{y}^{2}), & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}2x, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=1]$ given that the corresponding expected value is ${\\mu }_{Y|1}=\\frac{3}{8}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{3x(1-{y}^{2})}{2x} \\\\  & =\\frac{3(1-{y}^{2})}{2}\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNotice that the factor of $x$ cancels out, leaving an expression that does not depend on $x.$ Therefore, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x)$ has no effect:\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{3(1-{y}^{2})}{2}\n$$\n\nThen, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\cdot \\frac{3(1-{y}^{2})}{2}\\text{d}y \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}({y}^{2}-{y}^{4})\\text{d}y \\\\  & =\\frac{3}{2}[\\frac{{y}^{3}}{3}-\\frac{{y}^{5}}{5}]_{0}^{1} \\\\  & =\\frac{3}{2}[(\\frac{1}{3}-\\frac{1}{5})-0] \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=1] & =\\text{E}[{Y}^{2}\\,|\\,X=1]-{\\mu }_{Y|1}^{2} \\\\  & =\\frac{1}{5}-{(\\frac{3}{8})}^{2} \\\\  & =\\frac{1}{5}-\\frac{9}{64} \\\\  & =\\frac{19}{320}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-61c27587-c036-5512-931c-7ba163299613"] :db/ensure [:question/validate]} {:db/id "answer-field-61c27587-c036-5512-931c-7ba163299613" :answer-field/id #uuid "61c27587-c036-5512-931c-7ba163299613" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbf07cfd-45b2-51de-9143-b4f7db4de0be" :answer-field/choices ["answer-48b37456-2b35-5ad7-b4cb-c1cd5bcf7bc9" "answer-3bd874c7-e528-5b1f-9ca7-6d9dd97ff023" "answer-fbf07cfd-45b2-51de-9143-b4f7db4de0be" "answer-1f185006-9954-5514-b577-4d8238b5f3a0" "answer-eda5a28b-0e86-5d28-8ea2-d7a1062c5778"] :db/ensure [:answer-field/validate]} {:db/id "answer-48b37456-2b35-5ad7-b4cb-c1cd5bcf7bc9" :answer/id #uuid "48b37456-2b35-5ad7-b4cb-c1cd5bcf7bc9" :answer/type :answer.type/math :answer/value "\\frac{11}{160}" :db/ensure [:answer/validate]} {:db/id "answer-3bd874c7-e528-5b1f-9ca7-6d9dd97ff023" :answer/id #uuid "3bd874c7-e528-5b1f-9ca7-6d9dd97ff023" :answer/type :answer.type/math :answer/value "\\frac{13}{160}" :db/ensure [:answer/validate]} {:db/id "answer-fbf07cfd-45b2-51de-9143-b4f7db4de0be" :answer/id #uuid "fbf07cfd-45b2-51de-9143-b4f7db4de0be" :answer/type :answer.type/math :answer/value "\\frac{19}{320}" :db/ensure [:answer/validate]} {:db/id "answer-1f185006-9954-5514-b577-4d8238b5f3a0" :answer/id #uuid "1f185006-9954-5514-b577-4d8238b5f3a0" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]} {:db/id "answer-eda5a28b-0e86-5d28-8ea2-d7a1062c5778" :answer/id #uuid "eda5a28b-0e86-5d28-8ea2-d7a1062c5778" :answer/type :answer.type/math :answer/value "\\frac{3}{40}" :db/ensure [:answer/validate]} {:db/id "question-48276d5d-5662-5546-a559-258dff238b59" :question/id #uuid "48276d5d-5662-5546-a559-258dff238b59" :question/math-academy-id "q-147052" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}x-y, & 0\\le x\\le 1,\\,-1\\le y\\le 0, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}x+\\frac{1}{2}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional variance $\\text{Var}[Y\\,|\\,X=\\frac{1}{2}]$ given that the corresponding expected value is ${\\mu }_{Y|\\frac{1}{2}}=-\\frac{7}{12}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{x-y}{(x+\\frac{1}{2})},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,-1\\le y\\le 0.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNow, substituting $x=\\frac{1}{2}$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|\\,\\frac{1}{2})=\\frac{(\\frac{1}{2}-y)}{(\\frac{1}{2}+\\frac{1}{2})}=\\frac{1}{2}-y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=\\frac{1}{2}] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,\\frac{1}{2})\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}{y}^{2}(\\frac{1}{2}-y)\\text{d}y \\\\  & ={\\int }_{-1}^{0}\\frac{{y}^{2}}{2}-{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{3}}{6}-\\frac{{y}^{4}}{4}]}_{-1}^{0} \\\\  & =\\frac{1}{6}+\\frac{1}{4} \\\\  & =\\frac{5}{12}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=\\frac{1}{2}] & =\\text{E}[{Y}^{2}\\,|\\,X=\\frac{1}{2}]-{\\mu }_{Y|\\frac{1}{2}}^{2} \\\\  & =\\frac{5}{12}-{(-\\frac{7}{12})}^{2} \\\\  & =\\frac{5}{12}-\\frac{49}{144} \\\\  & =\\frac{11}{144}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f6856b8d-546d-52e0-bed7-386f3bdb5d0b"] :db/ensure [:question/validate]} {:db/id "answer-field-f6856b8d-546d-52e0-bed7-386f3bdb5d0b" :answer-field/id #uuid "f6856b8d-546d-52e0-bed7-386f3bdb5d0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f5d62b3-e68e-5f3b-a602-8ee58debbe22" :answer-field/choices ["answer-c6bcefcf-5fab-5be9-97ba-7dd8b81b7c3b" "answer-83567d3e-a18e-59f5-8de5-33ca7b6f14ad" "answer-8f5d62b3-e68e-5f3b-a602-8ee58debbe22" "answer-1e1b3266-8abd-5a10-871e-4abc1fdc45fe" "answer-70cf3fbb-1f23-5477-a624-77b52dc5dfa8"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6bcefcf-5fab-5be9-97ba-7dd8b81b7c3b" :answer/id #uuid "c6bcefcf-5fab-5be9-97ba-7dd8b81b7c3b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-83567d3e-a18e-59f5-8de5-33ca7b6f14ad" :answer/id #uuid "83567d3e-a18e-59f5-8de5-33ca7b6f14ad" :answer/type :answer.type/math :answer/value "\\frac{11}{12}" :db/ensure [:answer/validate]} {:db/id "answer-8f5d62b3-e68e-5f3b-a602-8ee58debbe22" :answer/id #uuid "8f5d62b3-e68e-5f3b-a602-8ee58debbe22" :answer/type :answer.type/math :answer/value "\\frac{11}{144}" :db/ensure [:answer/validate]} {:db/id "answer-1e1b3266-8abd-5a10-871e-4abc1fdc45fe" :answer/id #uuid "1e1b3266-8abd-5a10-871e-4abc1fdc45fe" :answer/type :answer.type/math :answer/value "\\frac{13}{144}" :db/ensure [:answer/validate]} {:db/id "answer-70cf3fbb-1f23-5477-a624-77b52dc5dfa8" :answer/id #uuid "70cf3fbb-1f23-5477-a624-77b52dc5dfa8" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-25e1f7ba-cab0-5f7d-b69c-953924c5cba0" :question/id #uuid "25e1f7ba-cab0-5f7d-b69c-953924c5cba0" :question/math-academy-id "q-146760" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3(x+y)}{4}, & 0<x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the corresponding expected value is ${\\mu }_{X|1}=\\frac{7}{6}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3(x+y)}{4})}{3{y}^{2}} \\\\  & =\\frac{x+y}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $0<x\\le 2y,\\,0<y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{x+1}{4}.\n$$\n\n \n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1]{\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{(x+1)}{4}\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({x}^{3}+{x}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{4}}{4}+\\frac{{x}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{1}{4}(4+\\frac{8}{3})-0 \\\\  & =\\frac{1}{4}(\\frac{20}{3}) \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\n \n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =\\frac{5}{3}-{(\\frac{7}{6})}^{2} \\\\  & =\\frac{5}{3}-\\frac{49}{36} \\\\  & =\\frac{11}{36}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fa2b95c2-4b35-5103-a6f9-67b22f583604"] :db/ensure [:question/validate]} {:db/id "answer-field-fa2b95c2-4b35-5103-a6f9-67b22f583604" :answer-field/id #uuid "fa2b95c2-4b35-5103-a6f9-67b22f583604" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bdcd9ab7-cb20-58e2-8fc7-ff6db6d9d900" :answer-field/choices ["answer-bdcd9ab7-cb20-58e2-8fc7-ff6db6d9d900" "answer-29e9f2a9-81ff-5bf2-8e64-c7bc991f3484" "answer-bd62a3ac-b098-5d99-ad5f-adfcc32787b3" "answer-2ceee17a-2287-5109-a8d8-f493be416a9c" "answer-de9d1ae1-ead5-520e-9b15-48bcf7370d81"] :db/ensure [:answer-field/validate]} {:db/id "answer-bdcd9ab7-cb20-58e2-8fc7-ff6db6d9d900" :answer/id #uuid "bdcd9ab7-cb20-58e2-8fc7-ff6db6d9d900" :answer/type :answer.type/math :answer/value "\\frac{11}{36}" :db/ensure [:answer/validate]} {:db/id "answer-29e9f2a9-81ff-5bf2-8e64-c7bc991f3484" :answer/id #uuid "29e9f2a9-81ff-5bf2-8e64-c7bc991f3484" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-bd62a3ac-b098-5d99-ad5f-adfcc32787b3" :answer/id #uuid "bd62a3ac-b098-5d99-ad5f-adfcc32787b3" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-2ceee17a-2287-5109-a8d8-f493be416a9c" :answer/id #uuid "2ceee17a-2287-5109-a8d8-f493be416a9c" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-de9d1ae1-ead5-520e-9b15-48bcf7370d81" :answer/id #uuid "de9d1ae1-ead5-520e-9b15-48bcf7370d81" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "question-febad6f8-061f-513c-bf3e-fbe38a2e6b2e" :question/id #uuid "febad6f8-061f-513c-bf3e-fbe38a2e6b2e" :question/math-academy-id "q-146867" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}2-x-y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}-y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the corresponding expected value is ${\\mu }_{X|1}=\\frac{1}{3}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(2-x-y)}{(\\frac{3}{2}-y)} \\\\  & =\\frac{4-2x-2y}{3-2y},\\end{aligned}\n$$\n\n \n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{4-2x-2\\cdot 1}{3-2\\cdot 1}=\\frac{4-2x-2}{3-2}=2-2x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}(2-2x)\\text{d}x \\\\  & ={\\int }_{0}^{1}(2{x}^{2}-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{2}]}_{0}^{1} \\\\  & =(\\frac{2}{3}-\\frac{1}{2}-0) \\\\  & =\\frac{4-3}{6} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$\n\n \n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =\\frac{1}{6}-{(\\frac{1}{3})}^{2} \\\\  & =\\frac{1}{6}-\\frac{1}{9} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1cacacfd-fd44-50c7-9618-968db11d920d"] :db/ensure [:question/validate]} {:db/id "answer-field-1cacacfd-fd44-50c7-9618-968db11d920d" :answer-field/id #uuid "1cacacfd-fd44-50c7-9618-968db11d920d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-abd5352c-5d54-5e3c-8b55-15e577a50730" :answer-field/choices ["answer-abd5352c-5d54-5e3c-8b55-15e577a50730" "answer-11a70864-faa5-54be-a449-99d26ac3090c" "answer-421cf42f-466d-5bf8-b694-47753f0f385e" "answer-4016d54d-03ed-5d80-9023-2a222b021197" "answer-db75dada-7b81-542d-bf6b-9186ddf533e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-abd5352c-5d54-5e3c-8b55-15e577a50730" :answer/id #uuid "abd5352c-5d54-5e3c-8b55-15e577a50730" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-11a70864-faa5-54be-a449-99d26ac3090c" :answer/id #uuid "11a70864-faa5-54be-a449-99d26ac3090c" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-421cf42f-466d-5bf8-b694-47753f0f385e" :answer/id #uuid "421cf42f-466d-5bf8-b694-47753f0f385e" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-4016d54d-03ed-5d80-9023-2a222b021197" :answer/id #uuid "4016d54d-03ed-5d80-9023-2a222b021197" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-db75dada-7b81-542d-bf6b-9186ddf533e4" :answer/id #uuid "db75dada-7b81-542d-bf6b-9186ddf533e4" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id 17592186189404 :tutorial/content "Suppose $X$ and $Y$ are continuous random variables, where the conditional expected value of $X$ given $Y=y$ is given by $\\mu_{X|y}.$ In other words,\n\n$$\n\\textrm{E}[X\\,|\\,Y=y] = \\mu_{X|y}.\n$$\n\nThe **conditional variance of $X$ given $Y=y$** is defined as\n\n$$\n\\textrm{Var}[X\\,|\\,Y] = \\textrm{E}\\big[(X - \\mu_{X|y} \\big)^2 \\,|\\, Y=y].\n$$\n\nAs with the discrete case, this definition can be written as\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2}\\end{aligned}\n$$\n\nwhere \n\n$$\n\\displaystyle \\textrm{E}\\big[X^2 \\,| \\, Y=y \\big] = \\int_{-\\infty}^{\\infty} x^2 \\, f_{X|Y}(x \\,|\\, y) \\: \\textrm{d}x,\n$$\n\n \n\nand $f_{X|Y}(x \\,|\\, y)$ is the conditional probability density function of $X$ given $Y=y.$ Note that these formulas are analogous to those for $\\textrm{Var}[X]$ for continuous $X.$\n\nWhen we select a particular value of $y,$ the conditional variance of $X$ given $Y=y$ returns a real number. However, if $y$ is not specified, then $\\textrm {Var}[X | Y = y]$ gives us a *function* of $y.$\n\nWe have an analogous definition for the **conditional variance of $Y$ given  $X=x{:}$**\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2}\\end{aligned}\n$$\n\nwhere \n\n- $\\mu_{Y|x} = \\textrm{E}\\big[Y \\,| \\, X=x \\big]$ is the conditional expected value of $Y$ given  $X=x,$\n\n- $\\displaystyle \\textrm{E}\\big[Y^2 \\,| \\, X=x \\big] = \\int_{-\\infty}^{\\infty} y^2 \\, f_{Y|X}(y \\,|\\, x) \\: \\textrm{d}y,$ and\n\n- $f_{Y|X}(y \\,|\\, x)$ is the conditional probability density function of $Y$ given $X=x.$" :db/ensure [:tutorial/validate]} {:db/id 17592186189410 :tutorial/content "Suppose that ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) and ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg) are continuous random variables. It is known that the conditional probability density function ![](images/93/939d0476e164e1f946f2c1f56829e1d23d0f14cf794d59ed194139e9ca0c6633.svg) is given by\n\n![](images/01/01cc971ff9be09d98f7b82c17dcb437308e0db1bb748bfad31f76a1f5be54828.svg)\nand that\n![](images/26/267e370c58b7350ddf932adcbe95f9b51a895c4d970f2d5ed8313bfd050a215c.svg)\nWhat is the conditional variance ![](images/fc/fc8d9d3eba8e082c14369171fd86c8786ec9efbb70b3d6a840f4cec11740be79.svg)\n\nThe conditional variance of ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg) given ![](images/2c/2cc57b1c8b00862c078193ea1774f4012e1513ab1a26a6d5bb806e046220a812.svg) is defined by\n\n![](images/82/82fb648d48cfe25c760b67838480f3b464ae25f5107a13fbecea46b1d47f543c.svg)\n\nwhere \n\n![](images/b1/b1ba1db07783ff23a06aff81a65993cc776777cdb471c20074d3ceac8db820a1.svg)\n\nTherefore, we obtain \n\n![](images/da/daf6a9ae8a295a2120e9720260b9c62d984774107bc2fc2308d60f027ac5f0d4.svg)\n\nFinally,\n\n![](images/97/97c0423f3c9f02779731969b447d9fa6040eb7637e541d7cdcdb9e68037477d7.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186188512 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]}]
