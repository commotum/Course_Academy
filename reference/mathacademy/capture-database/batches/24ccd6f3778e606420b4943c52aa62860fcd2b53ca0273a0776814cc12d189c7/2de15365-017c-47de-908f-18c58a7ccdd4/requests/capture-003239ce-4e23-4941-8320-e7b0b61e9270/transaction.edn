answer/type :answer.type/math :answer/value "7.8+{\\sum }_{n=1}^{\\infty }\\frac{8}{10}{(\\frac{1}{10})}^{n}" :db/ensure [:answer/validate]} {:db/id "question-8baa6b32-f89a-5746-b5a9-ab0eb10fe7f1" :question/id #uuid "8baa6b32-f89a-5746-b5a9-ab0eb10fe7f1" :question/math-academy-id "q-351733" :question/problem "Express $0.15\\overset{―}{3}$ using a geometric series.\n\n$0.15\\overset{―}{3}=$\n{{field-1}}\n$+{\\sum }_{n=1}^{\\infty }$\n{{field-2}}$(${{field-3}}$)^{n}$" :question/worked-solution "The given repeating decimal can be expressed as\n\n$$\n\\begin{aligned}0.15\\overset{―}{3} & =0.153\\,33… \\\\  & =0.15+0.003+0.000\\,3+0.000\\,03+… \\\\  & =0.15+(\\frac{3}{1\\,000}+\\frac{3}{10\\,000}+\\frac{3}{100\\,000}+…).\\end{aligned}\n$$\n\nThe series in the parentheses is a geometric series with first term ${a}_{1}=\\frac{3}{1\\,000}$ and common ratio $r=\\frac{1}{10}.$ Therefore,\n\n$$\n\\begin{aligned}0.15\\overset{―}{3} & =0.15+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =0.15+{\\sum }_{n=1}^{\\infty }\\frac{3}{1\\,000}{(\\frac{1}{10})}^{n-1} \\\\  & =0.15+{\\sum }_{n=1}^{\\infty }\\frac{3}{100}(\\frac{1}{10}){(\\frac{1}{10})}^{n-1} \\\\  & =0.15+{\\sum }_{n=1}^{\\infty }0.03{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5d6ccca8-7041-5559-b4d9-4b699776cb82" "answer-field-c369e53d-bf0c-5e32-8b0f-d142eed515fe" "answer-field-9e0533ae-8c9b-5d88-9a3d-332c6cbc30b3"] :db/ensure [:question/validate]} {:db/id "answer-field-5d6ccca8-7041-5559-b4d9-4b699776cb82" :answer-field/id #uuid "5d6ccca8-7041-5559-b4d9-4b699776cb82" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1e8812a9-a564-5e8d-b9fd-aab9756a2ced" :answer-field/choices ["answer-1e8812a9-a564-5e8d-b9fd-aab9756a2ced"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e8812a9-a564-5e8d-b9fd-aab9756a2ced" :answer/id #uuid "1e8812a9-a564-5e8d-b9fd-aab9756a2ced" :answer/type 