d>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})={x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})={x}_{2}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}5,\\,3\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ab3a18a8-5afa-5001-aa0c-08837edbdc8d" "answer-field-89d07e27-825f-5844-a32e-35d45b0efa18"] :db/ensure [:question/validate]} {:db/id "answer-field-ab3a18a8-5afa-5001-aa0c-08837edbdc8d" :answer-field/id #uuid "ab3a18a8-5afa-5001-aa0c-08837edbdc8d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-752b31f2-bd75-5062-ba66-58bc8bba04e9" :answer-field/choices ["answer-752b31f2-bd75-5062-ba66-58bc8bba04e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-752b31f2-bd75-5062-ba66-58bc8bba04e9" :answer/id #uuid "752b31f2-bd75-5062-ba66-58bc8bba04e9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-89d07e27-825f-5844-a32e-35d45b0efa18" :answer-field/id #uuid "89d07e27-825f-5844-a32e-35d45b0efa18" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bb1a9b4e-ebfa-5ed4-96c8-1aefb9bf398c" :answer-field/choices ["answer-bb1a9b4e-ebfa-5ed4-96c8-1aefb9bf398c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb1a9b4e-ebfa-5ed4-96c8-1aefb9bf398c" :answer/id #uuid "bb1a9b4e-ebfa-5ed4-96c8-1aefb9bf398c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-5ab6642a-36f8-590a-a631-0cf8a7d2875f" :question/id #uuid "5ab6642a-36f8-590a-a631-0cf8a7d2875f" :question/math-academy-id "q-264894" :question/problem "Given the function $f(x;w)=({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"40px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">$2$</td>\n<td align=\"center\" width=\"50px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=2({w}_{1}-{w}_{2}{x}_{1}{x}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})^{2}=-2{x}_{1}{x}_{2}({w}_{1}-{w}_{2}{x}_{1}{x}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2{x}_{1}^{2}{x}_{2}^{2}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ccec45eb-e36c-58f6-8fd2-058caac8f5c0" "answer-field-55bfc75f-a93f-5dfe-96f2-3fb987481cc6"] :db/ensure [:question/validate]} {:db/id "answer-field-ccec45eb-e36c-58f6-8fd2-058caac8f5c0" :answer-field/id #uuid "ccec45eb-e36c-58f6-8fd2-058caac8f5c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-739a1a33-00b9-5a65-8501-5416e50ad146" :answer-field/choices ["answer-739a1a33-00b9-5a65-8501-5416e50ad146"] :db/ensure [:answer-field/validate]} {:db/id "answer-739a1a33-00b9-5a65-8501-5416e50ad146" :answer/id #uuid "739a1a33-00b9-5a65-8501-5416e50ad146" :answer/type :answer.type/math :answer/value "-2{x}_{1}{x}_{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-55bfc75f-a93f-5dfe-96f2-3fb987481cc6" :answer-field/id #uuid "55bfc75f-a93f-5dfe-96f2-3fb987481cc6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c17d935-f775-5590-88e7-edcdebf8bd8e" :answer-field/choices ["answer-4c17d935-f775-5590-88e7-edcdebf8bd8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c17d935-f775-5590-88e7-edcdebf8bd8e" :answer/id #uuid "4c17d935-f775-5590-88e7-edcdebf8bd8e" :answer/type :answer.type/math :answer/value "2{x}_{1}^{2}{x}_{2}^{2}" :db/ensure [:answer/validate]} {:db/id "question-b3c9497c-975d-55aa-bb92-1acbe4b3e0fa" :question/id #uuid "b3c9497c-975d-55aa-bb92-1acbe4b3e0fa" :question/math-academy-id "q-264898" :question/problem "Given the function $f(x;w)=({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$2{x}_{1}^{2}{x}_{2}^{2}$</td>\n<td align=\"center\" width=\"30px\">$-2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=2{x}_{1}{x}_{2}({w}_{1}{x}_{1}{x}_{2}-{w}_{2}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}{x}_{2}-{w}_{2})^{2}=-2({w}_{1}{x}_{1}{x}_{2}-{w}_{2})\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{x}_{1}^{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=-2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=-2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1}^{2}{x}_{2}^{2} & -2{x}_{1}{x}_{2} \\\\ -2{x}_{1}{x}_{2} & 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4cae36c3-55f0-5e58-bd81-7c16e62cd866" "answer-field-719abbb9-5ca4-5379-92e1-d05725f856bc"] :db/ensure [:question/validate]} {:db/id "answer-field-4cae36c3-55f0-5e58-bd81-7c16e62cd866" :answer-field/id #uuid "4cae36c3-55f0-5e58-bd81-7c16e62cd866" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-313b6c49-910b-52c6-8051-61e7626042a1" :answer-field/choices ["answer-313b6c49-910b-52c6-8051-61e7626042a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-313b6c49-910b-52c6-8051-61e7626042a1" :answer/id #uuid "313b6c49-910b-52c6-8051-61e7626042a1" :answer/type :answer.type/math :answer/value "-2x_1x_2" :db/ensure [:answer/validate]} {:db/id "answer-field-719abbb9-5ca4-5379-92e1-d05725f856bc" :answer-field/id #uuid "719abbb9-5ca4-5379-92e1-d05725f856bc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9557a7d-9551-5e98-ae9a-30fb415b45e1" :answer-field/choices ["answer-a9557a7d-9551-5e98-ae9a-30fb415b45e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9557a7d-9551-5e98-ae9a-30fb415b45e1" :answer/id #uuid "a9557a7d-9551-5e98-ae9a-30fb415b45e1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-d8078445-7f57-54e9-9fc5-bfc3757a9189" :question/id #uuid "d8078445-7f57-54e9-9fc5-bfc3757a9189" :question/math-academy-id "q-264884" :question/problem "Given the function $f(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}$, compute ${∇}_{x,z}({∇}_{x,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}({∇}_{x,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2}) \\\\ \\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2})\\end{aligned}]=[\\begin{aligned}2x \\\\ 2z\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(2x)=2\\,\\, &  & \\frac{∂}{∂z}(2x)=0 \\\\  & \\frac{∂}{∂x}(2z)=0\\,\\, &  & \\frac{∂}{∂z}(2z)=2\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-09e13d1e-7edd-5b89-b514-be2cd80a2204" "answer-field-705f2112-10e1-564e-83ef-e8c05d30afd4" "answer-field-5550c2be-5d3c-58be-bc8e-d1a2e37820e9" "answer-field-a52a652f-b9e1-519a-bfb0-ecb9365c4180"] :db/ensure [:question/validate]} {:db/id "answer-field-09e13d1e-7edd-5b89-b514-be2cd80a2204" :answer-field/id #uuid "09e13d1e-7edd-5b89-b514-be2cd80a2204" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5c7f2ad9-b172-524e-b52c-42588397217d" :answer-field/choices ["answer-5c7f2ad9-b172-524e-b52c-42588397217d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c7f2ad9-b172-524e-b52c-42588397217d" :answer/id #uuid "5c7f2ad9-b172-524e-b52c-42588397217d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-705f2112-10e1-564e-83ef-e8c05d30afd4" :answer-field/id #uuid "705f2112-10e1-564e-83ef-e8c05d30afd4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2e8c2151-d1f7-5e77-984d-977058948cf5" :answer-field/choices ["answer-2e8c2151-d1f7-5e77-984d-977058948cf5"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e8c2151-d1f7-5e77-984d-977058948cf5" :answer/id #uuid "2e8c2151-d1f7-5e77-984d-977058948cf5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-5550c2be-5d3c-58be-bc8e-d1a2e37820e9" :answer-field/id #uuid "5550c2be-5d3c-58be-bc8e-d1a2e37820e9" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-25294040-285c-52b6-9de8-d0c78213a3df" :answer-field/choices ["answer-25294040-285c-52b6-9de8-d0c78213a3df"] :db/ensure [:answer-field/validate]} {:db/id "answer-25294040-285c-52b6-9de8-d0c78213a3df" :answer/id #uuid "25294040-285c-52b6-9de8-d0c78213a3df" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-a52a652f-b9e1-519a-bfb0-ecb9365c4180" :answer-field/id #uuid "a52a652f-b9e1-519a-bfb0-ecb9365c4180" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-39569a1f-2e66-5384-ace7-da0664c4510c" :answer-field/choices ["answer-39569a1f-2e66-5384-ace7-da0664c4510c"] :db/ensure [:answer-field/validate]} {:db/id "answer-39569a1f-2e66-5384-ace7-da0664c4510c" :answer/id #uuid "39569a1f-2e66-5384-ace7-da0664c4510c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-ef911a6f-8eaa-541f-ada4-10af4c9994c6" :question/id #uuid "ef911a6f-8eaa-541f-ada4-10af4c9994c6" :question/math-academy-id "q-264888" :question/problem "Given the function $f(x,y,z)=x{e}^{yz}$, compute ${∇}_{x,y}({∇}_{x,y}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,y}({∇}_{x,y}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,y}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}(x{e}^{yz}) \\\\ \\frac{∂}{∂y}(x{e}^{yz})\\end{aligned}]=[\\begin{aligned}{e}^{yz} \\\\ xz{e}^{yz}\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $y$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}({e}^{yz})=0\\,\\, &  & \\frac{∂}{∂y}({e}^{yz})=z{e}^{yz} \\\\  & \\frac{∂}{∂x}(xz{e}^{yz})=z{e}^{yz}\\,\\, &  & \\frac{∂}{∂y}(xz{e}^{yz})=x{z}^{2}{e}^{yz}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,y}({∇}_{x,y}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 & z{e}^{yz} \\\\ z{e}^{yz} & x{z}^{2}{e}^{yz}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-54132b05-6b53-5a59-a55a-32250c5ba899" "answer-field-c27b4e5d-55a0-5453-9ef5-40b4c02e0023" "answer-field-44a70234-afbd-5b95-b6d0-57f5d9b17da8" "answer-field-7075f514-a4aa-5bcc-8c11-8e3071322458"] :db/ensure [:question/validate]} {:db/id "answer-field-54132b05-6b53-5a59-a55a-32250c5ba899" :answer-field/id #uuid "54132b05-6b53-5a59-a55a-32250c5ba899" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer-field/choices ["answer-b9887375-d8c7-5b8f-8932-603f171ad7b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/id #uuid "b9887375-d8c7-5b8f-8932-603f171ad7b5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-c27b4e5d-55a0-5453-9ef5-40b4c02e0023" :answer-field/id #uuid "c27b4e5d-55a0-5453-9ef5-40b4c02e0023" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer-field/choices ["answer-c3559be5-9ddd-5be3-86e4-201b8acfad49"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/id #uuid "c3559be5-9ddd-5be3-86e4-201b8acfad49" :answer/type :answer.type/math :answer/value "ze^{yz}" :db/ensure [:answer/validate]} {:db/id "answer-field-44a70234-afbd-5b95-b6d0-57f5d9b17da8" :answer-field/id #uuid "44a70234-afbd-5b95-b6d0-57f5d9b17da8" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer-field/choices ["answer-a961726f-d2e5-5c4e-aa58-b8b021e50fd5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/id #uuid "a961726f-d2e5-5c4e-aa58-b8b021e50fd5" :answer/type :answer.type/math :answer/value "ze^{yz}" :db/ensure [:answer/validate]} {:db/id "answer-field-7075f514-a4aa-5bcc-8c11-8e3071322458" :answer-field/id #uuid "7075f514-a4aa-5bcc-8c11-8e3071322458" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer-field/choices ["answer-0e1601a7-b20b-5f51-9f9a-5b71e91349ba"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/id #uuid "0e1601a7-b20b-5f51-9f9a-5b71e91349ba" :answer/type :answer.type/math :answer/value "xz^2e^{yz}" :db/ensure [:answer/validate]} {:db/id 17592186204563 :question/problem "Given the function $f(x;w)=({w}_{1}{x}_{1}+{w}_{2}{x}_{2})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$2{x}_{1}^{2}$</td>\n<td align=\"center\" width=\"30px\">$2{x}_{1}{x}_{2}$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})^{2}=2({w}_{1}{x}_{1}+{w}_{2}{x}_{2}){x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2})^{2}=2({w}_{1}{x}_{1}+{w}_{2}{x}_{2}){x}_{2}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{x}_{1}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=2{x}_{1}{x}_{2} \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=2{x}_{1}{x}_{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=2{x}_{2}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{1}^{2} & 2{x}_{1}{x}_{2} \\\\ 2{x}_{1}{x}_{2} & 2{x}_{2}^{2}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186203331 :answer-field/correct "answer-ee3b433a-8aac-53f7-9d1b-048009d1ca9d" :answer-field/choices ["answer-ee3b433a-8aac-53f7-9d1b-048009d1ca9d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee3b433a-8aac-53f7-9d1b-048009d1ca9d" :answer/id #uuid "ee3b433a-8aac-53f7-9d1b-048009d1ca9d" :answer/type :answer.type/math :answer/value "2x_1x_2" :db/ensure [:answer/validate]} {:db/id 17592186203332 :answer-field/correct "answer-b210a9de-3fb8-5d18-b918-2389d8cea160" :answer-field/choices ["answer-b210a9de-3fb8-5d18-b918-2389d8cea160"] :db/ensure [:answer-field/validate]} {:db/id "answer-b210a9de-3fb8-5d18-b918-2389d8cea160" :answer/id #uuid "b210a9de-3fb8-5d18-b918-2389d8cea160" :answer/type :answer.type/math :answer/value "2x_2^2" :db/ensure [:answer/validate]} {:db/id 17592186205181 :tutorial/content "Recall that the gradient of a function \n\n$$\nf : \\mathbb{R}^n \\to \\mathbb{R}\n$$\n\ntells us how the function changes with respect to each of its input variables. It collects all the partial derivatives into a single vector:\n\n![](images/fe/fe9b4aa3c2e46dceeb10f63c021232f88ff1d3bd71f40fbd464b2ddb1cabef4a.svg) \n\nThis vector points in the direction of the *steepest increase* of the function, and its components describe how sensitive $f$ is to changes in each variable $x_1, x_2, \\dots, x_n.$\n\nIn other words, $\\nabla f$ gives us a complete picture of how $f$ behaves locally around a point, not just in one direction, but in every direction.\n\nBut sometimes, we’re not interested in how the function behaves in every direction. Maybe some variables are being held fixed, or we just care about how the function responds to changes in a few specific inputs. In that case, we don’t need the full gradient. We only need the derivatives with respect to the variables we care about.\n\nThis idea leads us to the concept of the **subset gradient**, which captures how a function changes with respect to only a chosen group of variables while treating the others as constant.\n\nIn this lesson, we will learn what subset gradients are, and how to compute them. Let's look at a concrete example in the next slide." :db/ensure [:tutorial/validate]} {:db/id 17592186205182 :tutorial/content "A **subset gradient** is the vector formed by taking only the partial derivatives of a function with respect to a chosen subset of variables.\n\nLet’s look at an example to understand how a subset gradient works in practice.\n\nSuppose we have the function\n\n$$\nf(x, y, z) = x^2 y + y z^2.\n$$\n\nThis function depends on three variables, and its full gradient is\n\n![](images/82/823f3ea4fad73ab43a55bfc21aaacdfaf5a2c27cf69f77ce6d1fdac22af38175.svg)\n\nThe full gradient tells us how $f$ responds to changes in all three directions. But in some situations, we may only care about how $f$ changes when we vary a few of the variables, for example, just $x$ and $y.$\n\nIf that’s the case, we compute a subset gradient, which focuses only on the variables of interest. In this case, we compute\n\n![](images/33/3354ae8715103231292a40a2d042fb96ae29148c267f6960dad14e55fc2590f6.svg)\n\nHere, we are treating $z$ as a constant, as if it were fixed and not changing, while taking partial derivatives with respect to $x$ and $y$ only. This is the same idea that underlies partial derivatives more generally: we hold all other variables constant except the ones we are differentiating with respect to.\n\nSubset gradients are especially useful in problems where only some variables are being updated. They allow us to focus on the directions that matter for a particular step or subproblem, without being distracted by variables we are not actively changing." :db/ensure [:tutorial/validate]} {:db/id 17592186205183 :tutorial/content "So far, we have looked at functions with a few individual variables like $x$, $y$, and $z$. But in many real-world problems, we work with vectors of inputs and parameters rather than just a few named variables.\n\nLet’s return to a familiar example where we fit a straight line to some data.\n\nSuppose our *linear model* is given by \n\n$$\nf(x; m, b) = mx + b,\n$$\n\nwhere \n\n- $x$ is the input, and\n\n- $m$ and $b$ are the *parameters* we are trying to learn.\n\nIf we want to understand how the output changes when we adjust $m$ and $b$, we compute the gradient with respect to these parameters, denoted $\\nabla_{m,b} \\, f$. This tells us how sensitive the function is to changes in the slope and intercept, assuming $x$ is held fixed.\n\nThe same idea applies in higher dimensions.\n\nNow, suppose we have multiple input variables and define a model  \n\n$$\nf(\\mathbf{x}; \\mathbf{w}) = w_1 x_1 + w_2 x_2 + \\cdots + w_n x_n,\n$$\n\n  \n\nwhere \n\n- $\\mathbf{x} = (x_1, x_2, \\dots, x_n)$ is the **input vector**, and\n\n- $\\mathbf{w} = (w_1, w_2, \\dots, w_n)$ is the **vector of parameters** (or weights).\n\nTo understand how $f$ depends on the parameters, we compute the *gradient* with respect to $\\mathbf{w}{:}$\n\n![](images/63/6334e1e6f6aa114a24cfaa586fe603f4bdfda8e0bffd118c7278b858bce527f7.svg)\n\nEach $x_j$ is treated as constant during this computation. Just like in the scalar case, we are asking how the output depends on each parameter while keeping the input fixed. This gradient gives exactly the information we need when updating model weights during training.\n\nNext, we will apply this result to a specific numerical example." :db/ensure [:tutorial/validate]} {:db/id 17592186205184 :tutorial/content "Just as we can compute gradients with respect to a subset of variables, we can also take second derivatives while focusing on just the variables that matter for our problem. \n\nWhen we write $\\nabla_{\\mathbf{w}}(\\nabla_{\\mathbf{w}} f)$, we are computing all second-order partial derivatives of the function $f$ with respect to the variables in $\\mathbf{w}.$ The result is a square matrix where each entry describes how one component of the gradient changes when we vary one of the selected variables. This matrix is the **Hessian with respect to** $\\mathbf{w}.$\n\nTo make this concrete, suppose we have a function $f(x, y, z)$ that depends on three variables. If we only care about second derivatives with respect to $x$ and $y$, we write $\\nabla_{x,y}(\\nabla_{x,y} f).$\n\nThis gives us a $2 \\times 2$ matrix that contains the following second-order partial derivatives\n\n![](images/89/895686eb22d040a761ca4edfb8d5b65ca23c23cb06aadc63ce05be06a66d193c.svg)\n\nEven though $f$ depends on three variables, this matrix isolates the second-derivative behavior of $f$ in just the $x$ and $y$ directions. This allows us to analyze or optimize over part of the input space without involving every variable.\n\nLet’s go through a concrete example.  \n\nConsider the function\n\n$$\nf(\\mathbf{x}; \\mathbf{w}) = w_1^2 x_2^2 - w_2 x_1,\n$$\n\nand suppose we want to compute the Hessian with respect to $\\mathbf{w} = [w_1, \\, w_2]^T.$\n\nFirst, we compute the gradient:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}^{2}{x}_{2}^{2}-{w}_{2}{x}_{1})=2{w}_{1}{x}_{2}^{2} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}^{2}{x}_{2}^{2}-{w}_{2}{x}_{1})=-{x}_{1}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & =2{x}_{2}^{2}, & \\,\\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} & =0 \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & =0 & \\,\\frac{{∂}^{2}f}{∂{w}_{2}^{2}} & =0\\end{aligned}\n$$\n\nPutting everything into matrix form, we get the Hessian\n\n![](images/52/52bd7d2b21c9d884017376168f82fe4612157f0d92802d78e98d72b90f6f1658.svg)\n\nThis is the Hessian with respect to the parameter vector $\\mathbf{w}.$ It tells us how the gradient of the function (with respect to parameters) changes when we vary each parameter and reveals the local shape of the function near any given point." :db/ensure [:tutorial/validate]} {:db/id 17592186204174 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186205027 :step/math-academy-id 655778 :db/ensure [:step/validate]} {:db/id 17592186205028 :step/math-academy-id 655779 :db/ensure [:step/validate]} {:db/id 17592186205029 :step/math-academy-id 655780 :db/ensure [:step/validate]} {:db/id 17592186205030 :step/math-academy-id 655783 :db/ensure [:step/validate]} {:db/id 17592186205031 :step/math-academy-id 655784 :db/ensure [:step/validate]} {:db/id 17592186205032 :step/math-academy-id 655787 :db/ensure [:step/validate]} {:db/id 17592186205033 :step/math-academy-id 655790 :db/ensure [:step/validate]} {:db/id 17592186205034 :step/math-academy-id 655791 :db/ensure [:step/validate]} [:db/retract 17592186137956 :answer-field/choices 17592186137957] [:db/retract 17592186137956 :answer-field/choices 17592186137958] [:db/retract 17592186137956 :answer-field/choices 17592186137959] [:db/retract 17592186137956 :answer-field/choices 17592186137960] [:db/retract 17592186137956 :answer-field/choices 17592186137961] {:db/id 17592186138385 :knowledge-point/questions ["question-0d4bd56d-7b08-5f8e-b2ed-febfd28cc8c1" "question-a747aa94-8aba-509b-9a98-0e8364a093c6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138297 :question/problem "Factor $x^4-4x^2+4.$" :question/worked-solution "We can introduce a new variable $z=x^2$ and then rewrite the trinomial as a quadratic in terms of $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{4}-4{x}^{2}+4 & = \\\\ {({x}^{2})}^{2}-4({x}^{2})+4 & = \\\\ {z}^{2}-4z+4\\end{aligned}\n$$\n\nNow, we can factor the quadratic as the square of a difference, and then rewrite the final expression in terms of $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{z}^{2}-4z+4 & = \\\\ (z-2)^{2} & = \\\\ ({x}^{2}-2)^{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186138411 :knowledge-point/questions ["question-f5f083b4-b367-5860-85b0-5fcb8d4ca77e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138304 :question/problem "Factor $t^4 - t^2 - 2.$" :question/worked-solution "We can introduce a new variable $z = t^2$ and then rewrite the trinomial as a quadratic in terms of $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{t}^{4}-{t}^{2}-2 & = \\\\ {({t}^{2})}^{2}-{t}^{2}-2 & = \\\\ {z}^{2}-z-2\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $t\\mathbin{:}$\n\n$$\n\\begin{aligned}{z}^{2}-z-2 & = \\\\ (z+1)(z-2) & = \\\\ ({t}^{2}+1)({t}^{2}-2)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186138412 :knowledge-point/questions ["question-23501fe5-1e29-539b-8b6b-710ef75dc73c" "question-c6189075-18fd-52b9-841f-2ea36a5b419a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138305 :question/problem "Factor $2p^4 + 5p^2 + 3.$" :question/worked-solution "We can introduce a new variable $t = p^2$ and then rewrite the trinomial as a quadratic in terms of $t\\mathbin{:}$\n\n$$\n\\begin{aligned}2{p}^{4}+5{p}^{2}+3 & = \\\\ 2{({p}^{2})}^{2}+5{p}^{2}+3 & = \\\\ 2{t}^{2}+5t+3\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $p\\mathbin{:}$\n\n$$\n\\begin{aligned}2{t}^{2}+5t+3 & = \\\\ (t+1)(2t+3) & = \\\\ ({p}^{2}+1)(2{p}^{2}+3)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-0d4bd56d-7b08-5f8e-b2ed-febfd28cc8c1" :question/id #uuid "0d4bd56d-7b08-5f8e-b2ed-febfd28cc8c1" :question/math-academy-id "q-112342" :question/problem "Factor $9{n}^{6}+6{n}^{3}+1.$" :question/worked-solution "We can introduce a new variable $z={n}^{3}$ and then rewrite the trinomial as a quadratic in terms of $n:$\n\n$$\n\\begin{aligned}9{n}^{6}+6{n}^{3}+1 & =9{({n}^{3})}^{2}+6{n}^{3}+1 \\\\  & =9{z}^{2}+6z+1\\end{aligned}\n$$\n\nNow, we can factor the quadratic as the square of a sum, and then rewrite the final expression in terms of $n:$\n\n$$\n\\begin{aligned}9{z}^{2}+6z+1 & =(3z)^{2}+6z+1 \\\\  & ={(3z+1)}^{2} \\\\  & ={(3{n}^{3}+1)}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bde1ba43-dc2d-5c05-8188-cd0e65719e0c"] :db/ensure [:question/validate]} {:db/id "answer-field-bde1ba43-dc2d-5c05-8188-cd0e65719e0c" :answer-field/id #uuid "bde1ba43-dc2d-5c05-8188-cd0e65719e0c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a5692942-1c9e-5f6c-bb84-c68b63ab5f9f" :answer-field/choices ["answer-6de00090-452f-5c68-a401-1ce8368de21b" "answer-de4678b8-89cd-5555-b31b-be4c3eb63ad1" "answer-a5692942-1c9e-5f6c-bb84-c68b63ab5f9f" "answer-21b4eb38-5df9-518f-b667-e5cd965edc07" "answer-64854096-937f-5bd4-ba50-4fbad5511099"] :db/ensure [:answer-field/validate]} {:db/id "answer-6de00090-452f-5c68-a401-1ce8368de21b" :answer/id #uuid "6de00090-452f-5c68-a401-1ce8368de21b" :answer/type :answer.type/math :answer/value "{(3n+1)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-de4678b8-89cd-5555-b31b-be4c3eb63ad1" :answer/id #uuid "de4678b8-89cd-5555-b31b-be4c3eb63ad1" :answer/type :answer.type/math :answer/value "{(3{n}^{2}+1)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a5692942-1c9e-5f6c-bb84-c68b63ab5f9f" :answer/id #uuid "a5692942-1c9e-5f6c-bb84-c68b63ab5f9f" :answer/type :answer.type/math :answer/value "{(3{n}^{3}+1)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-21b4eb38-5df9-518f-b667-e5cd965edc07" :answer/id #uuid "21b4eb38-5df9-518f-b667-e5cd965edc07" :answer/type :answer.type/math :answer/value "{(9{n}^{2}+6n)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-64854096-937f-5bd4-ba50-4fbad5511099" :answer/id #uuid "64854096-937f-5bd4-ba50-4fbad5511099" :answer/type :answer.type/math :answer/value "{(9{n}^{3}+1)}^{2}" :db/ensure [:answer/validate]} {:db/id "question-a747aa94-8aba-509b-9a98-0e8364a093c6" :question/id #uuid "a747aa94-8aba-509b-9a98-0e8364a093c6" :question/math-academy-id "q-112339" :question/problem "Factor ${h}^{4}-10{h}^{2}+25.$" :question/worked-solution "We can introduce a new variable $z={h}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}{h}^{4}-10{h}^{2}+25 & ={({h}^{2})}^{2}-10({h}^{2})+25 \\\\  & ={z}^{2}-10z+25\\end{aligned}\n$$\n\nNow, we can factor the quadratic as the square of a sum, and then rewrite the final expression in terms of $h:$\n\n$$\n\\begin{aligned}{z}^{2}-10z+25 & ={(z-5)}^{2} \\\\  & ={({h}^{2}-5)}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-edff1060-10e1-5ab4-841b-25b2bf6e7869"] :db/ensure [:question/validate]} {:db/id "answer-field-edff1060-10e1-5ab4-841b-25b2bf6e7869" :answer-field/id #uuid "edff1060-10e1-5ab4-841b-25b2bf6e7869" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4396c708-a95e-5406-a956-0aecbef4f251" :answer-field/choices ["answer-68b56254-a46c-57aa-931f-ced0cf55c182" "answer-ce748f9b-bd03-5e52-a315-b3139f1d9ea8" "answer-edc93743-8de4-57bd-95d7-e621f4ff912e" "answer-4396c708-a95e-5406-a956-0aecbef4f251" "answer-f005ef11-2c85-5e11-a5c8-08759fad9a90"] :db/ensure [:answer-field/validate]} {:db/id "answer-68b56254-a46c-57aa-931f-ced0cf55c182" :answer/id #uuid "68b56254-a46c-57aa-931f-ced0cf55c182" :answer/type :answer.type/math :answer/value "{(h+5)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ce748f9b-bd03-5e52-a315-b3139f1d9ea8" :answer/id #uuid "ce748f9b-bd03-5e52-a315-b3139f1d9ea8" :answer/type :answer.type/math :answer/value "{(h-5)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-edc93743-8de4-57bd-95d7-e621f4ff912e" :answer/id #uuid "edc93743-8de4-57bd-95d7-e621f4ff912e" :answer/type :answer.type/math :answer/value "{({h}^{2}-10)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-4396c708-a95e-5406-a956-0aecbef4f251" :answer/id #uuid "4396c708-a95e-5406-a956-0aecbef4f251" :answer/type :answer.type/math :answer/value "{({h}^{2}-5)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f005ef11-2c85-5e11-a5c8-08759fad9a90" :answer/id #uuid "f005ef11-2c85-5e11-a5c8-08759fad9a90" :answer/type :answer.type/math :answer/value "{({h}^{2}-5h)}^{2}" :db/ensure [:answer/validate]} {:db/id "question-f5f083b4-b367-5860-85b0-5fcb8d4ca77e" :question/id #uuid "f5f083b4-b367-5860-85b0-5fcb8d4ca77e" :question/math-academy-id "q-112355" :question/problem "Factor ${u}^{4}+2{u}^{2}-3.$" :question/worked-solution "We can introduce a new variable $z={u}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}{u}^{4}+2{u}^{2}-3 & ={({u}^{2})}^{2}+2({u}^{2})-3 \\\\  & ={z}^{2}+2z-3\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $u:$\n\n$$\n\\begin{aligned}{z}^{2}+2z-3 & =(z-1)(z+3) \\\\  & =({u}^{2}-1)({u}^{2}+3)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-33eef2fd-db6e-51f6-b81e-da93cfd6d41c"] :db/ensure [:question/validate]} {:db/id "answer-field-33eef2fd-db6e-51f6-b81e-da93cfd6d41c" :answer-field/id #uuid "33eef2fd-db6e-51f6-b81e-da93cfd6d41c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91693b6b-ea25-518e-b8a4-0338776447b0" :answer-field/choices ["answer-a4d5fbfd-fb40-50cc-8d0e-ef356c231bda" "answer-9014e24b-1578-58c7-99da-627991a10966" "answer-3489541a-5dd0-5979-bdf2-1a87860a11bc" "answer-91693b6b-ea25-518e-b8a4-0338776447b0" "answer-7b975eb6-2874-5592-a970-4dcaaa98a265"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4d5fbfd-fb40-50cc-8d0e-ef356c231bda" :answer/id #uuid "a4d5fbfd-fb40-50cc-8d0e-ef356c231bda" :answer/type :answer.type/math :answer/value "(u-1)({u}^{2}+2)" :db/ensure [:answer/validate]} {:db/id "answer-9014e24b-1578-58c7-99da-627991a10966" :answer/id #uuid "9014e24b-1578-58c7-99da-627991a10966" :answer/type :answer.type/math :answer/value "({u}^{2}+1)(u-2)" :db/ensure [:answer/validate]} {:db/id "answer-3489541a-5dd0-5979-bdf2-1a87860a11bc" :answer/id #uuid "3489541a-5dd0-5979-bdf2-1a87860a11bc" :answer/type :answer.type/math :answer/value "({u}^{2}+1)(u-3)" :db/ensure [:answer/validate]} {:db/id "answer-91693b6b-ea25-518e-b8a4-0338776447b0" :answer/id #uuid "91693b6b-ea25-518e-b8a4-0338776447b0" :answer/type :answer.type/math :answer/value "({u}^{2}-1)({u}^{2}+3)" :db/ensure [:answer/validate]} {:db/id "answer-7b975eb6-2874-5592-a970-4dcaaa98a265" :answer/id #uuid "7b975eb6-2874-5592-a970-4dcaaa98a265" :answer/type :answer.type/math :answer/value "({u}^{2}-1)({u}^{2}-3)" :db/ensure [:answer/validate]} {:db/id 17592186139168 :question/problem "Factor ${x}^{4}-{x}^{2}-6.$" :question/worked-solution "We can introduce a new variable $z={x}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}{x}^{4}-{x}^{2}-6 & ={({x}^{2})}^{2}-({x}^{2})-6 \\\\  & ={z}^{2}-z-6\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $x:$\n\n$$\n\\begin{aligned}{z}^{2}-z-6 & =(z+2)(z-3) \\\\  & =({x}^{2}+2)({x}^{2}-3)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186137956 :answer-field/correct "answer-ad02374c-1354-54d4-a18a-d7b8afa0efb4" :answer-field/choices ["answer-018634a6-bf8e-568d-9ec7-bdb401ca7882" "answer-ddb6c984-beb6-5454-9c03-bd70037a0818" "answer-ad02374c-1354-54d4-a18a-d7b8afa0efb4" "answer-94e03ce7-ad1e-5028-b7bc-006a214b7686" "answer-8a31c737-fbb4-5d7d-bc4d-f9d4aa969ef5"] :db/ensure [:answer-field/validate]} {:db/id "answer-018634a6-bf8e-568d-9ec7-bdb401ca7882" :answer/id #uuid "018634a6-bf8e-568d-9ec7-bdb401ca7882" :answer/type :answer.type/math :answer/value "(x+2)(x-3)" :db/ensure [:answer/validate]} {:db/id "answer-ddb6c984-beb6-5454-9c03-bd70037a0818" :answer/id #uuid "ddb6c984-beb6-5454-9c03-bd70037a0818" :answer/type :answer.type/math :answer/value "(x-2)(x+3)" :db/ensure [:answer/validate]} {:db/id "answer-ad02374c-1354-54d4-a18a-d7b8afa0efb4" :answer/id #uuid "ad02374c-1354-54d4-a18a-d7b8afa0efb4" :answer/type :answer.type/math :answer/value "({x}^{2}+2)({x}^{2}-3)" :db/ensure [:answer/validate]} {:db/id "answer-94e03ce7-ad1e-5028-b7bc-006a214b7686" :answer/id #uuid "94e03ce7-ad1e-5028-b7bc-006a214b7686" :answer/type :answer.type/math :answer/value "({x}^{2}-2)({x}^{2}+3)" :db/ensure [:answer/validate]} {:db/id "answer-8a31c737-fbb4-5d7d-bc4d-f9d4aa969ef5" :answer/id #uuid "8a31c737-fbb4-5d7d-bc4d-f9d4aa969ef5" :answer/type :answer.type/math :answer/value "({x}^{2}-2)({x}^{2}-3)" :db/ensure [:answer/validate]} {:db/id "question-23501fe5-1e29-539b-8b6b-710ef75dc73c" :question/id #uuid "23501fe5-1e29-539b-8b6b-710ef75dc73c" :question/math-academy-id "q-112368" :question/problem "Factor $3{h}^{4}-13{h}^{2}-10.$" :question/worked-solution "We can introduce a new variable $z={h}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}3{h}^{4}-13{h}^{2}-10 & =3{({h}^{2})}^{2}-13({h}^{2})-10 \\\\  & =3{z}^{2}-13z-10\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $h:$\n\n$$\n\\begin{aligned}3{z}^{2}-13z-10 & =(3z+2)(z-5) \\\\  & =(3{h}^{2}+2)({h}^{2}-5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-339e8817-6619-5b0c-a131-7ab68a02f3a3"] :db/ensure [:question/validate]} {:db/id "answer-field-339e8817-6619-5b0c-a131-7ab68a02f3a3" :answer-field/id #uuid "339e8817-6619-5b0c-a131-7ab68a02f3a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7d143340-5ed9-5215-a4b7-0d3abb3d495f" :answer-field/choices ["answer-69539f7c-1177-56a1-8dfd-b85eef22e6c4" "answer-d63d1e4f-5f61-5df5-8fac-02c6b52874fd" "answer-7d143340-5ed9-5215-a4b7-0d3abb3d495f" "answer-0cfc2107-cc92-5d72-89a4-f31d501a40f5" "answer-fd98310d-5700-5e62-93e0-1154f892edda"] :db/ensure [:answer-field/validate]} {:db/id "answer-69539f7c-1177-56a1-8dfd-b85eef22e6c4" :answer/id #uuid "69539f7c-1177-56a1-8dfd-b85eef22e6c4" :answer/type :answer.type/math :answer/value "(3h+2)({h}^{2}-5)" :db/ensure [:answer/validate]} {:db/id "answer-d63d1e4f-5f61-5df5-8fac-02c6b52874fd" :answer/id #uuid "d63d1e4f-5f61-5df5-8fac-02c6b52874fd" :answer/type :answer.type/math :answer/value "(3{h}^{2}+1)(h-5)" :db/ensure [:answer/validate]} {:db/id "answer-7d143340-5ed9-5215-a4b7-0d3abb3d495f" :answer/id #uuid "7d143340-5ed9-5215-a4b7-0d3abb3d495f" :answer/type :answer.type/math :answer/value "(3{h}^{2}+2)({h}^{2}-5)" :db/ensure [:answer/validate]} {:db/id "answer-0cfc2107-cc92-5d72-89a4-f31d501a40f5" :answer/id #uuid "0cfc2107-cc92-5d72-89a4-f31d501a40f5" :answer/type :answer.type/math :answer/value "(3{h}^{2}-1)({h}^{2}+5)" :db/ensure [:answer/validate]} {:db/id "answer-fd98310d-5700-5e62-93e0-1154f892edda" :answer/id #uuid "fd98310d-5700-5e62-93e0-1154f892edda" :answer/type :answer.type/math :answer/value "3({h}^{2}+2)({h}^{2}-5)" :db/ensure [:answer/validate]} {:db/id "question-c6189075-18fd-52b9-841f-2ea36a5b419a" :question/id #uuid "c6189075-18fd-52b9-841f-2ea36a5b419a" :question/math-academy-id "q-112367" :question/problem "Factor $6{c}^{4}-19{c}^{2}-7.$" :question/worked-solution "We can introduce a new variable $z={c}^{2}$ and then rewrite the trinomial as a quadratic in terms of $s:$\n\n$$\n\\begin{aligned}6{c}^{4}-19{c}^{2}-7 & =6{({c}^{2})}^{2}-19{c}^{2}-7 \\\\  & =6{z}^{2}-19z-7\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $c:$\n\n$$\n\\begin{aligned}6{z}^{2}-19z-7 & =(3z+1)(2z-7) \\\\  & =(3{c}^{2}+1)(2{c}^{2}-7)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-377a132b-cc52-5797-8037-368dceb7998e"] :db/ensure [:question/validate]} {:db/id "answer-field-377a132b-cc52-5797-8037-368dceb7998e" :answer-field/id #uuid "377a132b-cc52-5797-8037-368dceb7998e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8b9177d4-dcb2-577b-aee1-1d2edf92acbd" :answer-field/choices ["answer-68d9f5d3-b617-537c-a801-6430da0c5591" "answer-b8e185f0-b288-55c9-83e7-3db2582cd935" "answer-8b9177d4-dcb2-577b-aee1-1d2edf92acbd" "answer-42ec5fde-6690-54f0-bf6e-e0acb2be1160" "answer-1a1fcec3-1b77-56b9-977e-6b6d845933e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-68d9f5d3-b617-537c-a801-6430da0c5591" :answer/id #uuid "68d9f5d3-b617-537c-a801-6430da0c5591" :answer/type :answer.type/math :answer/value "(2{c}^{2}+1)(3{c}^{2}-7)" :db/ensure [:answer/validate]} {:db/id "answer-b8e185f0-b288-55c9-83e7-3db2582cd935" :answer/id #uuid "b8e185f0-b288-55c9-83e7-3db2582cd935" :answer/type :answer.type/math :answer/value "(3c+1)(2c-7)" :db/ensure [:answer/validate]} {:db/id "answer-8b9177d4-dcb2-577b-aee1-1d2edf92acbd" :answer/id #uuid "8b9177d4-dcb2-577b-aee1-1d2edf92acbd" :answer/type :answer.type/math :answer/value "(3{c}^{2}+1)(2{c}^{2}-7)" :db/ensure [:answer/validate]} {:db/id "answer-42ec5fde-6690-54f0-bf6e-e0acb2be1160" :answer/id #uuid "42ec5fde-6690-54f0-bf6e-e0acb2be1160" :answer/type :answer.type/math :answer/value "(3{c}^{2}-1)(2{c}^{2}+7)" :db/ensure [:answer/validate]} {:db/id "answer-1a1fcec3-1b77-56b9-977e-6b6d845933e2" :answer/id #uuid "1a1fcec3-1b77-56b9-977e-6b6d845933e2" :answer/type :answer.type/math :answer/value "({c}^{2}+1)({c}^{2}-7)" :db/ensure [:answer/validate]} {:db/id 17592186139643 :tutorial/content "Suppose that we want to factor the following trinomial:\n\n$$\nt^4+4t^2+3.\n$$\n\nThis trinomial is a quartic, but it can also be viewed as a quadratic \"in disguise.\" To see this, notice that if we introduce a new variable $z=t^2,$ then we can rewrite the trinomial as a quadratic in terms of $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{t}^{4}+4{t}^{2}+3 & = \\\\ ({t}^{2})^{2}+4({t}^{2})+3 & = \\\\ {z}^{2}+4z+3\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $t\\mathbin{:}$\n\n$$\n\\begin{aligned}{z}^{2}+4z+3 & = \\\\ (z+1)(z+3) & = \\\\ ({t}^{2}+1)({t}^{2}+3)\\end{aligned}\n$$\n\nTherefore, $t^4+4t^2+3$ factors into $(t^2+1)(t^2+3).$ We can double-check this result by multiplying it out:\n\n$$\n\\begin{aligned}({t}^{2}+1)({t}^{2}+3) & = \\\\ {t}^{2}({t}^{2}+3)+1({t}^{2}+3) & = \\\\ {t}^{4}+3{t}^{2}+{t}^{2}+3 & = \\\\ {t}^{4}+4{t}^{2}+3 & \\,✓\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186138637 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186096708 :knowledge-point/questions ["question-99019613-302f-550e-842d-827f9008365f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-99019613-302f-550e-842d-827f9008365f" :question/id #uuid "99019613-302f-550e-842d-827f9008365f" :question/math-academy-id "q-251821" :question/problem "![](images/72/72fdce3ebf5cbdb9e0b06e88e9fd5a519afdd79faedefd0ec24d003a8bc6e557.png)\n\n**From top to bottom**, the **exact** values of the $y$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-4,3)$ and passes through the point $(-3,2).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(-4,3)$ into the above gives\n\n$$\n(y-3)^{2}=4p(x+4).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-3,2),$ we substitute $x=-3$ and $y=2$ into the equation and get\n\n$$\n\\begin{aligned}(2-3)^{2} & =4p(-3+4) \\\\ 1 & =4p(1) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-3)^{2} & =x+4.\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y-3)^{2} & =0+4 \\\\ (y-3)^{2} & =4 \\\\ y-3 & =\\pm 2 \\\\ y & =\\pm 2+3 \\\\ y & =1,5\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are $5$ and  $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e607ce28-3784-5cd7-a847-51fef16dd3b0" "answer-field-316c9be3-2f1d-573d-ad2e-1f7c5d034777"] :db/ensure [:question/validate]} {:db/id "answer-field-e607ce28-3784-5cd7-a847-51fef16dd3b0" :answer-field/id #uuid "e607ce28-3784-5cd7-a847-51fef16dd3b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fd34fb19-51be-53a6-9439-14ce74d4d526" :answer-field/choices ["answer-fd34fb19-51be-53a6-9439-14ce74d4d526"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd34fb19-51be-53a6-9439-14ce74d4d526" :answer/id #uuid "fd34fb19-51be-53a6-9439-14ce74d4d526" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-316c9be3-2f1d-573d-ad2e-1f7c5d034777" :answer-field/id #uuid "316c9be3-2f1d-573d-ad2e-1f7c5d034777" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-52486476-6056-55af-9404-0c1d6b9322c8" :answer-field/choices ["answer-52486476-6056-55af-9404-0c1d6b9322c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-52486476-6056-55af-9404-0c1d6b9322c8" :answer/id #uuid "52486476-6056-55af-9404-0c1d6b9322c8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "activity-14b1d77b-c4f0-577e-851c-b7d85c894d0e" :activity/id #uuid "14b1d77b-c4f0-577e-851c-b7d85c894d0e" :activity/title "Calculating Intercepts of Parabolas" :activity/type :activity.type/review :activity/scope 17592186048350 :activity/course 17592186046658 :activity/steps ["step-bade0e6b-46e5-5ab3-8969-32133842f549" "step-bd16cec3-8893-56c4-81c8-5d657349f57f" "step-c5cebdcf-3800-5d31-894a-16ebc8531079" "step-e28d06f6-c9ee-5b42-a0e7-44cf06dc693f" "step-7447a9f9-5dea-5ae2-a9c8-6ff307945fcb"] :activity/first-step "step-bade0e6b-46e5-5ab3-8969-32133842f549" :db/ensure [:activity/validate]} {:db/id "step-bade0e6b-46e5-5ab3-8969-32133842f549" :step/id #uuid "bade0e6b-46e5-5ab3-8969-32133842f549" :step/content 17592186403703 :step/next "step-bd16cec3-8893-56c4-81c8-5d657349f57f" :db/ensure [:step/validate]} {:db/id "step-bd16cec3-8893-56c4-81c8-5d657349f57f" :step/id #uuid "bd16cec3-8893-56c4-81c8-5d657349f57f" :step/content 17592186348183 :step/next "step-c5cebdcf-3800-5d31-894a-16ebc8531079" :db/ensure [:step/validate]} {:db/id "step-c5cebdcf-3800-5d31-894a-16ebc8531079" :step/id #uuid "c5cebdcf-3800-5d31-894a-16ebc8531079" :step/content 17592186284548 :step/next "step-e28d06f6-c9ee-5b42-a0e7-44cf06dc693f" :db/ensure [:step/validate]} {:db/id "step-e28d06f6-c9ee-5b42-a0e7-44cf06dc693f" :step/id #uuid "e28d06f6-c9ee-5b42-a0e7-44cf06dc693f" :step/content 17592186292535 :step/next "step-7447a9f9-5dea-5ae2-a9c8-6ff307945fcb" :db/ensure [:step/validate]} {:db/id "step-7447a9f9-5dea-5ae2-a9c8-6ff307945fcb" :step/id #uuid "7447a9f9-5dea-5ae2-a9c8-6ff307945fcb" :step/content "question-99019613-302f-550e-842d-827f9008365f" :db/ensure [:step/validate]} [:db/retract 17592186164287 :answer-field/choices 17592186164288] [:db/retract 17592186164287 :answer-field/choices 17592186164289] [:db/retract 17592186164287 :answer-field/choices 17592186164290] [:db/retract 17592186164287 :answer-field/choices 17592186164291] [:db/retract 17592186164292 :answer-field/choices 17592186164296] [:db/retract 17592186164292 :answer-field/choices 17592186164293] [:db/retract 17592186164292 :answer-field/choices 17592186164294] [:db/retract 17592186164292 :answer-field/choices 17592186164295] {:db/id 17592186166917 :knowledge-point/questions ["question-22670f3b-ee2e-505b-bc5c-db0616554dee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167211 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t)-2y(t) \\\\ {y}^{′}(t)=2x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=1,$ for which the corresponding eigenvectors are ${v}_{1}=[1,\\text{ }2]^{T}$ and ${v}_{2}=[2,\\text{ }1]^{T},$ respectively. Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}\\cdot {{field-1}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]+{c}_{2}\\cdot {{field-2}}[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-2t}\\to $ \n{{field-4}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-5}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/e0/e0446b7851fe0f0612d3db67de05188c0ed63af41ff1dfe2773158b2382fe722.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny={{field-6}}\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]$\nlie on that line\n\nSince ${e}^{t}\\to $ \n{{field-7}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-8}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/ff/ffa12152c9882d0953667f26e888d0fbac375f4cc0c348f3710799e1a6e22349.png)\n\nThe {{field-9}} of our system looks as follows:\n\n![](images/83/83885d091455a8f9b9a1c33556d9deeaee550d50dd665e016c2e8072c926f41a.png)" :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny=2x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-2t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/e0/e0446b7851fe0f0612d3db67de05188c0ed63af41ff1dfe2773158b2382fe722.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=\\frac{1}{2}x\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach $\\text{infinity}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/ff/ffa12152c9882d0953667f26e888d0fbac375f4cc0c348f3710799e1a6e22349.png)\n\nThe $\\text{phase portrait}$ of our system looks as follows:\n\n![](images/83/83885d091455a8f9b9a1c33556d9deeaee550d50dd665e016c2e8072c926f41a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5c1d99ed-7ae8-5b15-8a08-bbeeb0e40298" "answer-field-4a712708-03e5-549d-88f5-a3d44ba1b851" "answer-field-085be3fb-43ea-521a-ae11-f04caea87ceb" "answer-field-26a829d6-541e-50ce-89fc-17392dbe6c88" "answer-field-79f3c88c-fd69-59e2-8a96-4be51318ef16" "answer-field-48d80817-e8f9-5ddc-96e4-707d7e885c6b" "answer-field-a950cdfa-506c-5334-8ecd-ea28ae6589d6"] :db/ensure [:question/validate]} {:db/id 17592186164287 :answer-field/correct "answer-3a9f3520-6f09-551d-9fa5-9f2f50c2e18d" :answer-field/choices ["answer-3a9f3520-6f09-551d-9fa5-9f2f50c2e18d" "answer-5afae28a-aff8-529b-8210-6a46b6913d02" "answer-82f38ffa-d783-5749-96c3-dba5177e6ad8" "answer-ff09af8e-c840-58af-a731-12d11ef5b69f"] :db/ensure [:answer-field/validate]} {:db/id "answer-3a9f3520-6f09-551d-9fa5-9f2f50c2e18d" :answer/id #uuid "3a9f3520-6f09-551d-9fa5-9f2f50c2e18d" :answer/type :answer.type/math :answer/value "{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "answer-5afae28a-aff8-529b-8210-6a46b6913d02" :answer/id #uuid "5afae28a-aff8-529b-8210-6a46b6913d02" :answer/type :answer.type/math :answer/value "{e}^{-t}" :db/ensure [:answer/validate]} {:db/id "answer-82f38ffa-d783-5749-96c3-dba5177e6ad8" :answer/id #uuid "82f38ffa-d783-5749-96c3-dba5177e6ad8" :answer/type :answer.type/math :answer/value "{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "answer-ff09af8e-c840-58af-a731-12d11ef5b69f" :answer/id #uuid "ff09af8e-c840-58af-a731-12d11ef5b69f" :answer/type :answer.type/math :answer/value "{e}^{t}" :db/ensure [:answer/validate]} {:db/id 17592186164292 :answer-field/correct "answer-74789ab0-b68a-5281-9f9e-0ea34a5a2451" :answer-field/choices ["answer-2278409f-2918-5b5c-b25f-87796949067b" "answer-03ebfbed-47b8-5b99-a11f-237d4b0fa3c7" "answer-cc3d8df8-9a7b