end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-78baa92d-3782-54fb-a6f4-d5375a795c7a" "answer-field-bb79ef1b-cafc-51a7-bd37-11f3defb6b4d"] :db/ensure [:question/validate]} {:db/id "answer-field-78baa92d-3782-54fb-a6f4-d5375a795c7a" :answer-field/id #uuid "78baa92d-3782-54fb-a6f4-d5375a795c7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-68a47565-7a07-5770-b79a-e9901e8b356f" :answer-field/choices ["answer-68a47565-7a07-5770-b79a-e9901e8b356f"] :db/ensure [:answer-field/validate]} {:db/id "answer-68a47565-7a07-5770-b79a-e9901e8b356f" :answer/id #uuid "68a47565-7a07-5770-b79a-e9901e8b356f" :answer/type :answer.type/math :answer/value "x^2" :db/ensure [:answer/validate]} {:db/id "answer-field-bb79ef1b-cafc-51a7-bd37-11f3defb6b4d" :answer-field/id #uuid "bb79ef1b-cafc-51a7-bd37-11f3defb6b4d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a445d600-c2d2-5d28-9695-2d17e0ba7ba8" :answer-field/choices ["answer-a445d600-c2d2-5d28-9695-2d17e0ba7ba8"] :db/ensure [:answer-field/validate]} {:db/id "answer-a445d600-c2d2-5d28-9695-2d17e0ba7ba8" :answer/id #uuid "a445d600-c2d2-5d28-9695-2d17e0ba7ba8" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-9a84fcca-bb7c-52d6-bb54-0e47f9a1105b" :question/id #uuid "9a84fcca-bb7c-52d6-bb54-0e47f9a1105b" :question/math-academy-id "q-264850" :question/problem "Given the cubic function $f(x;a,b,c)=a{x}^{3}+b{x}^{2}+cx,$ compute ${∇}_{a,c}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,c}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,c}\\,f$, we take partial derivatives with respect to $a$ and $c.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{3}+b{x}^{2}+cx)={x}^{3} \\\\ \\frac{∂f}{∂c} & =\\frac{∂}{∂c}(a{x}^{3}+b{x}^{2}+cx)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,c}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂c}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{3} \\\\ x\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f439e6a0-d4de-55aa-9133-55a14ef4190c" "answer-field-e623b32f-ee75-5b9f-809d-6c6129aabbba"] :db/ensure [:question/validate]} {:db/id "answer-field-f439e6a0-d4de-55aa-9133-55a14ef4190c" :answer-field/id #uuid "f439e6a0-d4de-55aa-9133-55a14ef4190c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c2a76f01-03ac-5c67-a67f-e4ce2fd942d1" :answer-field/choices ["answer-c2a76f01-03ac-5c67-a67f-e4ce2fd942d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2a76f01-03ac-5c67-a67f-e4ce2fd942d1" :answer/id #uuid "c2a76f01-03ac-5c67-a67f-e4ce2fd942d1" :answer/type :answer.type/math :answer/value "{x}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-e623b32f-ee75-5b9f-809d-6c6129aabbba" :answer-field/id #uuid "e623b32f-ee75-5b9f-809d-6c6129aabbba" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2ceab98f-831e-547a-97fa-8a706519b6cd" :answer-field/choices ["answer-2ceab98f-831e-547a-97fa-8a706519b6cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ceab98f-831e-547a-97fa-8a706519b6cd" :answer/id #uuid "2ceab98f-831e-547a-97fa-8a706519b6cd" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-c47abb70-6a87-5cce-aa76-b45ab7529754" :question/id #uuid "c47abb70-6a87-5cce-aa76-b45ab7529754" :question/math-academy-id "q-264856" :question/problem "Given the function $f(x,y;a,b)=a{x}^{2}+bxy,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bxy)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bxy)=xy\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ xy\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4fac3cbf-66df-59f1-93c0-4405f1388c1a" "answer-field-b47dfd25-7b57-5db0-b411-d637fc7ea949"] :db/ensure [:question/validate]} {:db/id "answer-field-4fac3cbf-66df-59f1-93c0-4405f1388c1a" :answer-field/id #uuid "4fac3cbf-66df-59f1-93c0-4405f1388c1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-475dce79-7262-5f64-8ef3-8e93f9bcf29c" :answer-field/choices ["answer-475dce79-7262-5f64-8ef3-8e93f9bcf29c"] :db/ensure [:answer-field/validate]} {:db/id "answer-475dce79-7262-5f64-8ef3-8e93f9bcf29c" :answer/id #uuid "475dce79-7262-5f64-8ef3-8e93f9bcf29c" :answer/type :answer.type/math :answer/value "x^2" :db/ensure [:answer/validate]} {:db/id "answer-field-b47dfd25-7b57-5db0-b411-d637fc7ea949" :answer-field/id #uuid "b47dfd25-7b57-5db0-b411-d637fc7ea949" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-77332d3b-023b-5435-9522-56df4057f0b9" :answer-field/choices ["answer-77332d3b-023b-5435-9522-56df4057f0b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-77332d3b-023b-5435-9522-56df4057f0b9" :answer/id #uuid "77332d3b-023b-5435-9522-56df4057f0b9" :answer/type :answer.type/math :answer/value "xy" :db/ensure [:answer/validate]} {:db/id "question-15f52165-8151-599f-bfe3-492fccf77d4a" :question/id #uuid "15f52165-8151-599f-bfe3-492fccf77d4a" :question/math-academy-id "q-264843" :question/problem "Given the quadratic function $f(x;a,b)=a{x}^{2}+bx,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(a{x}^{2}+bx)={x}^{2} \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{2}+bx)=x\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{2} \\\\ x\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-044cf6f0-86a5-5828-8057-974cbc3f803e" "answer-field-3259ba75-6612-58b0-8781-9f978e6e6efc"] :db/ensure [:question/validate]} {:db/id "answer-field-044cf6f0-86a5-5828-8057-974cbc3f803e" :answer-field/id #uuid "044cf6f0-86a5-5828-8057-974cbc3f803e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-972d1eaf-0176-5ff0-8dc5-13be7f9f609f" :answer-field/choices ["answer-972d1eaf-0176-5ff0-8dc5-13be7f9f609f"] :db/ensure [:answer-field/validate]} {:db/id "answer-972d1eaf-0176-5ff0-8dc5-13be7f9f609f" :answer/id #uuid "972d1eaf-0176-5ff0-8dc5-13be7f9f609f" :answer/type :answer.type/math :answer/value "{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-3259ba75-6612-58b0-8781-9f978e6e6efc" :answer-field/id #uuid "3259ba75-6612-58b0-8781-9f978e6e6efc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c2871d26-b3e7-5641-b8d2-3a52bc0b14bb" :answer-field/choices ["answer-c2871d26-b3e7-5641-b8d2-3a52bc0b14bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2871d26-b3e7-5641-b8d2-3a52bc0b14bb" :answer/id #uuid "c2871d26-b3e7-5641-b8d2-3a52bc0b14bb" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-5cdbbb1b-f40a-59c6-9f85-65d64306e66f" :question/id #uuid "5cdbbb1b-f40a-59c6-9f85-65d64306e66f" :question/math-academy-id "q-264857" :question/problem "Given the function $f(x,y;a,b)=axy+b,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(axy+b)=xy \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(axy+b)=1\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}xy \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c342fc37-2395-58ad-a2da-743789071819" "answer-field-bd1fbb7b-a7c4-5bd5-b548-d2067e768875"] :db/ensure [:question/validate]} {:db/id "answer-field-c342fc37-2395-58ad-a2da-743789071819" :answer-field/id #uuid "c342fc37-2395-58ad-a2da-743789071819" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c01a522f-1682-539a-bef6-be335b8183a9" :answer-field/choices ["answer-c01a522f-1682-539a-bef6-be335b8183a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-c01a522f-1682-539a-bef6-be335b8183a9" :answer/id #uuid "c01a522f-1682-539a-bef6-be335b8183a9" :answer/type :answer.type/math :answer/value "xy" :db/ensure [:answer/validate]} {:db/id "answer-field-bd1fbb7b-a7c4-5bd5-b548-d2067e768875" :answer-field/id #uuid "bd1fbb7b-a7c4-5bd5-b548-d2067e768875" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d5d3dbbf-c74a-5302-a34c-11e26c0c9270" :answer-field/choices ["answer-d5d3dbbf-c74a-5302-a34c-11e26c0c9270"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5d3dbbf-c74a-5302-a34c-11e26c0c9270" :answer/id #uuid "d5d3dbbf-c74a-5302-a34c-11e26c0c9270" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186204567 :question/problem "Given the function \n$f(x;w)={w}_{1}{x}_{1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}1,\\,2,\\,3\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"3\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{2} \\\\ \\frac{∂f}{∂{w}_{3}} & =\\frac{∂}{∂{w}_{3}}({w}_{1}{x}_{1}+{w}_{2}{x}_{2}+{w}_{3}{x}_{3})={x}_{3}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}1,\\,2,\\,3\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186203345 :answer-field/correct "answer-5fc61265-4181-5ff2-81c5-1824d1f2c6fb" :answer-field/choices ["answer-5fc61265-4181-5ff2-81c5-1824d1f2c6fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-5fc61265-4181-5ff2-81c5-1824d1f2c6fb" :answer/id #uuid "5fc61265-4181-5ff2-81c5-1824d1f2c6fb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186203344 :answer-field/correct "answer-d29a4acb-372e-539a-9040-43df7967652c" :answer-field/choices ["answer-d29a4acb-372e-539a-9040-43df7967652c"] :db/ensure [:answer-field/validate]} {:db/id "answer-d29a4acb-372e-539a-9040-43df7967652c" :answer/id #uuid "d29a4acb