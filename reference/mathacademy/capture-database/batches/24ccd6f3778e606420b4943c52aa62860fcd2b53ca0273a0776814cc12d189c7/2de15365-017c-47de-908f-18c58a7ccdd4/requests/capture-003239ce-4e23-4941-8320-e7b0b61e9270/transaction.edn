 }_{n=1}^{\\infty }3{(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }300(\\frac{1}{100}){(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }300{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-042655a5-af48-5ad5-8a8e-790078669a6e" "answer-field-34435d1f-0b9d-51d1-a200-90903e9fb178"] :db/ensure [:question/validate]} {:db/id "answer-field-042655a5-af48-5ad5-8a8e-790078669a6e" :answer-field/id #uuid "042655a5-af48-5ad5-8a8e-790078669a6e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a" :answer-field/choices ["answer-5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a" :answer/id #uuid "5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a" :answer/type :answer.type/math :answer/value "300" :db/ensure [:answer/validate]} {:db/id "answer-field-34435d1f-0b9d-51d1-a200-90903e9fb178" :answer-field/id #uuid "34435d1f-0b9d-51d1-a200-90903e9fb178" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85" :answer-field/choices ["answer-9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85" :answer/id #uuid "9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85" :answer/type :answer.type/math :answer/value "\\frac{1}{100}" :db/ensure [:answer/validate]} {:db/id "question-6baf96f3-d002-5d3c-bd1a-08275622d74d" :question/id #uuid "6baf96f3-d002-5d3c-bd1a-08275622d74d" :question/math-academy-id "q-351736" :question/problem "Express $0.4\\overset{―}{25}$ using a geometric series.\n\n$0.4\\overset{―}{25}=$\n{{field-1}}\n$+{\\sum }_{n=1}^{\\infty }$\n{{field-2}}$(${{field-3}}$)^{n}$" :question/worked-solution "The given repeating decimal can be expressed as\n\n$$\n\\begin{aligned}0.4\\overset{―}{25} & 