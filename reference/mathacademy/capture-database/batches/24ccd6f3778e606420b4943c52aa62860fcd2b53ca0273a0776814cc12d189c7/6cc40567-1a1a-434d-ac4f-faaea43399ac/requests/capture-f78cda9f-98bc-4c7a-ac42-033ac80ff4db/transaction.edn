eda9-4472-53ff-8909-b4853e9b27b3" "answer-81a75cde-a679-509f-9195-cf178aeeb372" "answer-b9179029-3ffc-5187-a746-3312e1093839"] :db/ensure [:answer-field/validate]} {:db/id "answer-660212cb-c2c3-5b21-af6c-8a379432dede" :answer/id #uuid "660212cb-c2c3-5b21-af6c-8a379432dede" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "answer-8eb4f77a-dd07-5c58-93c9-049f9d325d7a" :answer/id #uuid "8eb4f77a-dd07-5c58-93c9-049f9d325d7a" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-e7a0eda9-4472-53ff-8909-b4853e9b27b3" :answer/id #uuid "e7a0eda9-4472-53ff-8909-b4853e9b27b3" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "answer-81a75cde-a679-509f-9195-cf178aeeb372" :answer/id #uuid "81a75cde-a679-509f-9195-cf178aeeb372" :answer/type :answer.type/text :answer/value "$x=0$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-b9179029-3ffc-5187-a746-3312e1093839" :answer/id #uuid "b9179029-3ffc-5187-a746-3312e1093839" :answer/type :answer.type/text :answer/value "$x=0$ and $x=3$" :db/ensure [:answer/validate]} {:db/id "question-c899081f-aaf3-5d73-a009-6354d1a2e255" :question/id #uuid "c899081f-aaf3-5d73-a009-6354d1a2e255" :question/math-academy-id "q-104715" :question/problem "Find all of the points where the function $f(x)=\\frac{1}{{x}^{2}-5x}$ has infinite discontinuities." :question/worked-solution "Infinite discontinuities coincide with the vertical asymptotes of $y=f(x).$ \n\nTo find the vertical asymptotes, let's start by factoring the expression in the denominator. This gives\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}-5x} \\\\  & =\\frac{1}{x(x-5)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we can find the vertical asymptotes by setting the denominator to zero:\n\n$$\nx(x-5)=0\\,⟹\\,x=0,5.\n$$\n\nTherefore, the function has infinite discontinuities at $x=0$ and $x=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f32805e9-8f0e-5643-b8cd-67061494f218"] :db/ensure [:question/validate]} {:db/id "answer-field-f32805e9-8f0e-5643-b8cd-67061494f218" :answer-field/id #uuid "f32805e9-8f0e-5643-b8cd-67061494f218" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a02085f-873a-59de-9f9b-1c36d3550875" :answer-field/choices ["answer-054fd615-fb40-56d5-a49f-a713a52995ca" "answer-d27fdc38-8f8f-5091-a646-100f38c0d44a" "answer-77d7a421-a902-5096-bf06-f339d78193d2" "answer-2a02085f-873a-59de-9f9b-1c36d3550875" "answer-ede999ac-c321-5a94-ad9b-3718fd482490"] :db/ensure [:answer-field/validate]} {:db/id "answer-054fd615-fb40-56d5-a49f-a713a52995ca" :answer/id #uuid "054fd615-fb40-56d5-a49f-a713a52995ca" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-d27fdc38-8f8f-5091-a646-100f38c0d44a" :answer/id #uuid "d27fdc38-8f8f-5091-a646-100f38c0d44a" :answer/type :answer.type/text :answer/value "$x=0$ and $x=-5$" :db/ensure [:answer/validate]} {:db/id "answer-77d7a421-a902-5096-bf06-f339d78193d2" :answer/id #uuid "77d7a421-a902-5096-bf06-f339d78193d2" :answer/type :answer.type/text :answer/value "$x=0$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-2a02085f-873a-59de-9f9b-1c36d3550875" :answer/id #uuid "2a02085f-873a-59de-9f9b-1c36d3550875" :answer/type :answer.type/text :answer/value "$x=0$ and $x=5$" :db/ensure [:answer/validate]} {:db/id "answer-ede999ac-c321-5a94-ad9b-3718fd482490" :answer/id #uuid "ede999ac-c321-5a94-ad9b-3718fd482490" :answer/type :answer.type/text :answer/value "$x=1$ and $x=4$" :db/ensure [:answer/validate]} {:db/id "question-e2b2de31-2e08-55fe-906d-b2e8d713411d" :question/id #uuid "e2b2de31-2e08-55fe-906d-b2e8d713411d" :question/math-academy-id "q-38828" :question/problem "Find all of the points where the function $f(x)=\\frac{{x}^{2}-1}{2{x}^{2}-3x-2}$ has discontinuities due to vertical asymptotes." :question/worked-solution "To find the vertical asymptotes, let's start by factoring the expressions in the numerator and denominator. This gives\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{2{x}^{2}-3x-2} \\\\  & =\\frac{(x-1)(x+1)}{(2x+1)(x-2)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we can find the vertical asymptotes by setting the denominator to zero:\n\n$$\n(2x+1)(x-2)=0\\,⟹\\,x=-\\frac{1}{2},2.\n$$\n\nTherefore, the function has discontinuities due to vertical asymptotes at $x=-\\frac{1}{2}$ and $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f8975b1d-a5d0-5edc-93b1-10d5e6b649c0"] :db/ensure [:question/validate]} {:db/id "answer-field-f8975b1d-a5d0-5edc-93b1-10d5e6b649c0" :answer-field/id #uuid "f8975b1d-a5d0-5edc-93b1-10d5e6b649c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-49ab0a29-3de9-5cef-ac37-2d8a93fc3a08" :answer-field/choices ["answer-baf07184-04cb-593e-895d-6a53654e7745" "answer-9bcab203-19ca-5b4b-a3bd-a649dcac95cf" "answer-49ab0a29-3de9-5cef-ac37-2d8a93fc3a08" "answer-d4847fa0-fbf8-5d78-baae-1162e5806daa" "answer-2a657555-84bd-55c1-9848-f324c65b7490"] :db/ensure [:answer-field/validate]} {:db/id "answer-baf07184-04cb-593e-895d-6a53654e7745" :answer/id #uuid "baf07184-04cb-593e-895d-6a53654e7745" :answer/type :answer.type/text :answer/value "$x=-1,$ $x=-\\frac{1}{2},$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-9bcab203-19ca-5b4b-a3bd-a649dcac95cf" :answer/id #uuid "9bcab203-19ca-5b4b-a3bd-a649dcac95cf" :answer/type :answer.type/text :answer/value "$x=-\\frac{1}{2}$ and $x=-2$" :db/ensure [:answer/validate]} {:db/id "answer-49ab0a29-3de9-5cef-ac37-2d8a93fc3a08" :answer/id #uuid "49ab0a29-3de9-5cef-ac37-2d8a93fc3a08" :answer/type :answer.type/text :answer/value "$x=-\\frac{1}{2}$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-d4847fa0-fbf8-5d78-baae-1162e5806daa" :answer/id #uuid "d4847fa0-fbf8-5d78-baae-1162e5806daa" :answer/type :answer.type/text :answer/value "$x=\\frac{1}{2},$ $x=-2,$ and $x=-1$" :db/ensure [:answer/validate]} {:db/id "answer-2a657555-84bd-55c1-9848-f324c65b7490" :answer/id #uuid "2a657555-84bd-55c1-9848-f324c65b7490" :answer/type :answer.type/text :answer/value "$x=\\frac{1}{2},$ $x=2,$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "question-51bf4893-7d23-5880-bdd4-7c570a118b95" :question/id #uuid "51bf4893-7d23-5880-bdd4-7c570a118b95" :question/math-academy-id "q-48242" :question/problem "Find all of the points where the function $f(x)=\\frac{1}{{x}^{2}-3x-4}$ has discontinuities due to vertical asymptotes." :question/worked-solution "To find the vertical asymptotes, let's start by factoring the expression in the denominator. This gives\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}-3x-4} \\\\  & =\\frac{1}{(x-4)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we can find the vertical asymptotes by setting the denominator to zero:\n\n$$\n(x-4)(x+1)=0\\,⟹\\,x=-1,4.\n$$\n\nTherefore, the function has discontinuities due to vertical asymptotes at $x=-1$ and $x=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b61093a5-492e-512c-8ebb-70f24dbe1a53"] :db/ensure [:question/validate]} {:db/id "answer-field-b61093a5-492e-512c-8ebb-70f24dbe1a53" :answer-field/id #uuid "b61093a5-492e-512c-8ebb-70f24dbe1a53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5e4ccdd1-460e-5e41-b519-09b6141451af" :answer-field/choices ["answer-5e4ccdd1-460e-5e41-b519-09b6141451af" "answer-1ecd5c78-1e1d-5836-9ee3-844fb1660c46" "answer-0b46ada9-1c7a-5f43-8971-8d180ff44d81" "answer-34ff683c-d029-54f5-adfc-023dc5d8362d" "answer-140e96dd-2459-59c5-bcaf-4fd8eead4254"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e4ccdd1-460e-5e41-b519-09b6141451af" :answer/id #uuid "5e4ccdd1-460e-