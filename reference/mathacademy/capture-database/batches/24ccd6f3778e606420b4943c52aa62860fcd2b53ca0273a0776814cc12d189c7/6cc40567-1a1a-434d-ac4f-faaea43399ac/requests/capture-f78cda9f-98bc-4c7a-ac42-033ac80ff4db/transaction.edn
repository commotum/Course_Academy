lidate]} {:db/id "answer-field-1fc90c65-a21a-5b64-98e0-57d3a49e45bb" :answer-field/id #uuid "1fc90c65-a21a-5b64-98e0-57d3a49e45bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0b406c4-a406-5db4-b387-69b7378a24ec" :answer-field/choices ["answer-d731faec-e77b-53d8-a3de-ea6d54a26534" "answer-d0b406c4-a406-5db4-b387-69b7378a24ec" "answer-d2510ac9-9ed4-5e30-9064-f40cddb3f292" "answer-8ef8e188-7649-5fc9-a35b-5dbd23ec1f3b" "answer-eaa2db69-bf7c-5800-9eda-c91d8ba24118"] :db/ensure [:answer-field/validate]} {:db/id "answer-d731faec-e77b-53d8-a3de-ea6d54a26534" :answer/id #uuid "d731faec-e77b-53d8-a3de-ea6d54a26534" :answer/type :answer.type/math :answer/value "x<-14" :db/ensure [:answer/validate]} {:db/id "answer-d0b406c4-a406-5db4-b387-69b7378a24ec" :answer/id #uuid "d0b406c4-a406-5db4-b387-69b7378a24ec" :answer/type :answer.type/math :answer/value "x>-14" :db/ensure [:answer/validate]} {:db/id "answer-d2510ac9-9ed4-5e30-9064-f40cddb3f292" :answer/id #uuid "d2510ac9-9ed4-5e30-9064-f40cddb3f292" :answer/type :answer.type/math :answer/value "x>14" :db/ensure [:answer/validate]} {:db/id "answer-8ef8e188-7649-5fc9-a35b-5dbd23ec1f3b" :answer/id #uuid "8ef8e188-7649-5fc9-a35b-5dbd23ec1f3b" :answer/type :answer.type/math :answer/value "x\\ge 14" :db/ensure [:answer/validate]} {:db/id "answer-eaa2db69-bf7c-5800-9eda-c91d8ba24118" :answer/id #uuid "eaa2db69-bf7c-5800-9eda-c91d8ba24118" :answer/type :answer.type/math :answer/value "x\\le -14" :db/ensure [:answer/validate]} {:db/id "question-7495bbc7-a548-574a-82ac-70b0b5806589" :question/id #uuid "7495bbc7-a548-574a-82ac-70b0b5806589" :question/math-academy-id "q-28812" :question/problem "The inequality $x<-2$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<-2$ corresponds to all numbers less than $-2.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/d1/d142ec418d86ccfce8f701ca19384d599ed2b5f7072d5ae84dcb3796baa73261.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $-2$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<-2$ as\n\n$$\nx\\in (-\\infty ,-2).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-252ca47e-4dc4-5484-9ba0-c98ceb6b632d"] :db/ensure [:question/validate]} {:db/id "answer-field-252ca47e-4dc4-5484-9ba0-c98ceb6b632d" :answer-field/id #uuid "252ca47e-4dc4-5484-9ba0-c98ceb6b632d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" :answer-field/choices ["answer-c7678492-a4db-5293-886a-50ed4f45f6ac" "answer-4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" "answer-cbb807c9-e753-5fae-b9a9-3d16aa42052e" "answer-2dc81733-1724-5007-93d8-73e6a4d641d6" "answer-f342d5e9-ad9c-5011-89b1-b3f78efba918"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7678492-a4db-5293-886a-50ed4f45f6ac" :answer/id #uuid "c7678492-a4db-5293-886a-50ed4f45f6ac" :answer/type :answer.type/math :answer/value "x\\in (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" :answer/id #uuid "4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2)" :db/ensure [:answer/validate]} {:db/id "answer-cbb807c9-e753-5fae-b9a9-3d16aa42052e" :answer/id #uuid "cbb807c9-e753-5fae-b9a9-3d16aa42052e" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2]" :db/ensure [:answer/validate]} {:db/id "answer-2dc81733-1724-5007-93d8-73e6a4d641d6" :answer/id #uuid "2dc81733-1724-5007-93d8-73e6a4d641d6" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,2)" :db/ensure [:answer/validate]} {:db/id "answer-f342d5e9-ad9c-5011-89b1-b3f78efba918" :answer/id #uuid "f342d5e9-ad9c-5011-89b1-b3f78efba918" :answer/type :answer.type/math :answer/value "x\\in [-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0b34c9dd-15c6-517b-a545-622b3797f82a" :question/id #uuid "0b34c9dd-15c6-517b-a545-622b3797f82a" :question/math-academy-id "q-1240" :question/problem "The inequality $x<5$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<5$ corresponds to all numbers less than $5.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/61/61a3fcdcc19f822c0d94b806441ea2888dab3bb9ac0b846c965a8fe23ad078ae.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $5$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<5$ as\n\n$$\nx\\in (-\\infty ,5).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-89e0b9d8-8cbb-552b-9d87-a0cb5ffd887a"] :db/ensure [:question/validate]} {:db/id "answer-field-89e0b9d8-8cbb-552b-9d87-a0cb5ffd887a" :answer-field/id #uuid "89e0b9d8-8cbb-552b-9d87-a0cb5ffd887a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-51cd4b43-3511-5e00-816b-32a834a207e7" :answer-field/choices ["answer-fd249a90-649d-5cc0-a33c-217f34c342d3" "answer-51cd4b43-3511-5e00-816b-32a834a207e7" "answer-f3196173-b085-58b4-b56d-8f7b7b30e72a" "answer-7cb73b16-271e-54c3-bcdf-c7e3667c51c5" "answer-b5263679-8ad7-594f-bf49-0f3557b68c74"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd249a90-649d-5cc0-a33c-217f34c342d3" :answer/id #uuid "fd249a90-649d-5cc0-a33c-217f34c342d3" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-5)" :db/ensure [:answer/validate]} {:db/id "answer-51cd4b43-3511-5e00-816b-32a834a207e7" :answer/id #uuid "51cd4b43-3511-5e00-816b-32a834a207e7" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,5)" :db/ensure [:answer/validate]} {:db/id "answer-f3196173-b085-58b4-b56d-8f7b7b30e72a" :answer/id #uuid "f3196173-b085-58b4-b56d-8f7b7b30e72a" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,5]" :db/ensure [:answer/validate]} {:db/id "answer-7cb73b16-271e-54c3-bcdf-c7e3667c51c5" :answer/id #uuid "7cb73b16-271e-54c3-bcdf-c7e3667c51c5" :answer/type :answer.type/math :answer/value "x\\in [4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-b5263679-8ad7-594f-bf49-0f3557b68c74" :answer/id #uuid "b5263679-8ad7-594f-bf49-0f3557b68c74" :answer/type :answer.type/math :answer/value "x\\in [5,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186192953 :question/problem "The inequality $x<-7$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<-7$ corresponds to all numbers less than $-7.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/30/309a19968d017e575543f8165405dea2fe102a2d9a10d575ecf1cead17d36e07.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $-7$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<-7$ as\n\n$$\nx\\in (-\\infty ,-7).\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186189604 :answer-field/correct "answer-0b0af212-881a-5cd1-b5a5-a5f841e92e0c" :answer-field/choices ["answer-b01ef1d0-b5dd-5247-a394-7b27a327315e" "answer-0b0af212-881a-5cd1-b5a5-a5f841e92e0c" "answer-eaee6b7d-9e88-5cdb-94e6-4ed8e320fb7b" "answer-09698758-15fa-5097-b3c4-eadafb6bb51e" "answer-10c327ba-b932-5721-924f-a6edf38cc480"] :db/ensure [:answer-field/validate]} {:db/id "answer-b01ef1d0-b5dd-5247-a394-7b27a327315e" :answer/id #uuid "b01ef1d0-b5dd-5247-a394-7b27a327315e" :answer/type :answer.type/math :answer/value "x\\in (-7,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0b0af212-881a-5cd1-b5a5-a5f841e92e0c" :answer/id #uuid "0b0af212-881a-5cd1-b5a5-a5f841e92e0c" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-7)" :db/ensure [:answer/validate]} {:db/id "answer-eaee6b7d-9e88-5cdb-94e6-4ed8e320fb7b" :answer/id #uuid "eaee6b7d-9e88-5cdb-94e6-4ed8e320fb7b" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-7]" :db/ensure [:answer/validate]} {:db/id "answer-09698758-15fa-5097-b3c4-eadafb6bb51e" :answer/id #uuid "09698758-15fa-5097-b3c4-eadafb6bb51e" :answer/type :answer.type/math :answer/value "x\\in [-7,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-10c327ba-b932-5721-924f-a6edf38cc480" :answer/id #uuid "10c327ba-b932-5721-924f-a6edf38cc480" :answer/type :answer.type/math :answer/value "x\\in [7,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-ca3bed50-c15f-520c-b7d3-e53cd1fcae8f" :question/id #uuid "ca3bed50-c15f-520c-b7d3-e53cd1fcae8f" :question/math-academy-id "q-154838" :question/problem "The interval notation $z\\in (-\\infty ,26]$ corresponds to the inequality" :question/worked-solution "The statement $z\\in (-\\infty ,26]$ means that $z$ lies between $-\\infty $ and $26,$ where \n\n- the left endpoint $-\\infty $ is *not* included, and\n\n- the right endpoint $26$ *is* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-\\infty <z\\le 26.\n$$\n\nHowever, since all numbers are greater than negative infinity, it suffices to write \n\n$$\nz\\le 26.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c61d95f8-ddcc-5e61-a389-2bf5488d153d"] :db/ensure [:question/validate]} {:db/id "answer-field-c61d95f8-ddcc-5e61-a389-2bf5488d153d" :answer-field/id #uuid "c61d95f8-ddcc-5e61-a389-2bf5488d153d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f22378b9-da0d-5ab4-b419-9b37bf967204" :answer-field/choices ["answer-656ea7f7-3c61-5faa-93ad-46692819ed68" "answer-1888e81b-f614-5546-8c11-7635a8224be9" "answer-7864bf86-223e-51f0-80d1-c81f8bd370c3" "answer-b9196218-43f4-5c68-896d-8447f41b509b" "answer-f22378b9-da0d-5ab4-b419-9b37bf967204"] :db/ensure [:answer-field/validate]} {:db/id "answer-656ea7f7-3c61-5faa-93ad-46692819ed68" :answer/id #uuid "656ea7f7-3c61-5faa-93ad-46692819ed68" :answer/type :answer.type/math :answer/value "z<26" :db/ensure [:answer/validate]} {:db/id "answer-1888e81b-f614-5546-8c11-7635a8224be9" :answer/id #uuid "1888e81b-f614-5546-8c11-7635a8224be9" :answer/type :answer.type/math :answer/value "z>-26" :db/ensure [:answer/validate]} {:db/id "answer-7864bf86-223e-51f0-80d1-c81f8bd370c3" :answer/id #uuid "7864bf86-223e-51f0-80d1-c81f8bd370c3" :answer/type :answer.type/math :answer/value "z\\ge 26" :db/ensure [:answer/validate]} {:db/id "answer-b9196218-43f4-5c68-896d-8447f41b509b" :answer/id #uuid "b9196218-43f4-5c68-896d-8447f41b509b" :answer/type :answer.type/math :answer/value "z\\le -26" :db/ensure [:answer/validate]} {:db/id "answer-f22378b9-da0d-5ab4-b419-9b37bf967204" :answer/id #uuid "f22378b9-da0d-5ab4-b419-9b37bf967204" :answer/type :answer.type/math :answer/value "z\\le 26" :db/ensure [:answer/validate]} {:db/id "question-6d843358-b3f1-509e-8689-eba95475d008" :question/id #uuid "6d843358-b3f1-509e-8689-eba95475d008" :question/math-academy-id "q-154786" :question/problem "The interval notation  $x\\in (-\\infty ,-7)$ corresponds to the inequality" :question/worked-solution "The statement $x\\in (-\\infty ,-7)$ means that $x$ lies between $-\\infty $ and $-7,$ where \n\n- the left endpoint $-\\infty $ is *not* included, and\n\n- the right endpoint $-7$ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-\\infty <x<-7.\n$$\n\nHowever, since all numbers are greater than negative infinity, it suffices to write \n\n$$\nx<-7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-17aef558-2ba7-5da3-b0f3-5fde99d8b14a"] :db/ensure [:question/validate]} {:db/id "answer-field-17aef558-2ba7-5da3-b0f3-5fde99d8b14a" :answer-field/id #uuid "17aef558-2ba7-5da3-b0f3-5fde99d8b14a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba6abd59-760c-5139-8f9d-3e2306642a11" :answer-field/choices ["answer-ba6abd59-760c-5139-8f9d-3e2306642a11" "answer-cf64deaf-eb4c-5e28-a5cb-c0d8a5ca27d3" "answer-7bb20d81-b551-56ae-b425-39c6bd43e715" "answer-50cdcef6-9c18-58ca-95d8-1aabfed4067b" "answer-912382eb-e86d-53d1-a4f9-37de67d559dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba6abd59-760c-5139-8f9d-3e2306642a11" :answer/id #uuid "ba6abd59-760c-5139-8f9d-3e2306642a11" :answer/type :answer.type/math :answer/value "x<-7" :db/ensure [:answer/validate]} {:db/id "answer-cf64deaf-eb4c-5e28-a5cb-c0d8a5ca27d3" :answer/id #uuid "cf64deaf-eb4c-5e28-a5cb-c0d8a5ca27d3" :answer/type :answer.type/math :answer/value "x<7" :db/ensure [:answer/validate]} {:db/id "answer-7bb20d81-b551-56ae-b425-39c6bd43e715" :answer/id #uuid "7bb20d81-b551-56ae-b425-39c6bd43e715" :answer/type :answer.type/math :answer/value "x>-7" :db/ensure [:answer/validate]} {:db/id "answer-50cdcef6-9c18-58ca-95d8-1aabfed4067b" :answer/id #uuid "50cdcef6-9c18-58ca-95d8-1aabfed4067b" :answer/type :answer.type/math :answer/value "x\\ge 7" :db/ensure [:answer/validate]} {:db/id "answer-912382eb-e86d-53d1-a4f9-37de67d559dd" :answer/id #uuid "912382eb-e86d-53d1-a4f9-37de67d559dd" :answer/type :answer.type/math :answer/value "x\\le -7" :db/ensure [:answer/validate]} {:db/id 17592186193939 :tutorial/content "Consider the following inequality: \n\n$$\nx > 0\n$$\n\nWe can represent this inequality using a number line as follows:\n\n![](images/79/79664d125db14d5b8534d592d232839659a6d0efbd527379207b50d71f9e7454.png)\n\nHow do we represent this inequality using interval notation?\n\nNote the following:\n\n- The left endpoint $x=0$ is *not* included. Therefore, we use a parenthesis $($ for this endpoint.\n\n- The interval continues forever in the positive direction. To denote this, we must introduce the **infinity** symbol $\\infty.$ Infinity is not a number but a concept that means *larger than any number*.\n\n- We use a right parenthesis $)$ in conjunction with the $\\infty$ symbol.\n\nTherefore, we can express the inequality $x > 0$ in interval notation as follows:\n\n$$\nx \\in (0, \\infty)\n$$\n\n**Watch Out!** Whenever $\\infty$ appears in an interval, it is *always* associated with a right parenthesis. Infinity is *never* associated with a bracket, even if the other endpoint is." :db/ensure [:tutorial/validate]} {:db/id 17592186193940 :tutorial/content "Now, consider the following inequality: \n\n$$\nx \\lt 0\n$$\n\nWe can represent this inequality using a number line as follows:\n\n![](images/52/52be4b1ae3d32f2d3bb1dbf9f4faa1f288cff5736870064533b958ac89a76dad.png)\n\nTo represent this inequality using interval notation, we note the following:\n\n- The right endpoint $x=0$ is *not* included. Therefore, we use a parenthesis $)$ for this endpoint.\n\n- The interval continues forever in the negative direction. To denote this, we use the **negative infinity** symbol $-\\infty.$ We use a left parenthesis $($ in conjunction with the negative infinity symbol.\n\nTherefore, we can express the inequality $x < 0$ in interval notation as follows:\n\n$$\nx \\in (-\\infty, 0)\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186192906 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124608 :knowledge-point/questions ["question-dfe98e1c-3b93-5422-932b-6229fbfa5965"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124610 :knowledge-point/questions ["question-adb4921d-df66-5c35-baf2-cc613e0cb3d4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124451 :knowledge-point/questions ["question-d66b6ff3-5c30-5d09-a1a7-0b4d573341bb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186125256 :question/problem "Let $f(x,y)$ be a differentiable function such that\n\n$$\nf(1,1)=1,\\,{f}_{x}(x,y)=3{x}^{2}{y}^{4},\\,{f}_{y}(x,y)=4{x}^{3}{y}^{3}.\n$$\n\nUsing a linear approximation of $f$ at the point $(1,1),$ estimate the value of $f(1.02,0.97).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,1)$ is:\n\n$$\n\\begin{aligned}f(x,y) & ≈f(1,1)+∇f(1,1)\\cdot ⟨x-1,y-1⟩ \\\\  & ≈f(1,1)+⟨{f}_{x}(1,1),{f}_{y}(1,1)⟩\\cdot ⟨x-1,y-1⟩ \\\\  & ≈1+⟨{f}_{x}(1,1),{f}_{y}(1,1)⟩\\cdot ⟨x-1,y-1⟩\\end{aligned}\n$$\n\nNow, we find ${f}_{x}(1,1)$ and ${f}_{y}(1,1)$ using the given partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(1,1) & =3(1)^{2}(1)^{4}=3 \\\\ {f}_{y}(1,1) & =4(1)^{3}(1)^{3}=4\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nf(x,y)≈1+⟨3,4⟩\\cdot ⟨x-1,y-1⟩\n$$\n\nFinally, we can estimate $f(1.02,0.97)$ by evaluating the linear approximation at $x=1.02$ and $y=0.97,$ as follows:\n\n$$\n\\begin{aligned}f(1.02,0.97) & ≈1+⟨3,4⟩\\cdot ⟨1.02-1,0.97-1⟩ \\\\  & =1+⟨3,4⟩\\cdot ⟨0.02,-0.03⟩ \\\\  & =1+0.06-0.12 \\\\  & =0.94\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186124136 :answer-field/correct 17592186124139 :db/ensure [:answer-field/validate]} {:db/id "question-dfe98e1c-3b93-5422-932b-6229fbfa5965" :question/id #uuid "dfe98e1c-3b93-5422-932b-6229fbfa5965" :question/math-academy-id "q-129635" :question/problem "Let $f(x,y)$ be a differentiable function such that\n\n$$\nf(-1,0)=2,\\,{f}_{x}(x,y)=4x,\\,{f}_{y}(x,y)=6y.\n$$\n\nUsing a linear approximation of $f$ at the point $(-1,0),$ estimate the value of $f(-1.01,0.01).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-1,0)$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-1,0)+∇f(-1,0)\\cdot ⟨x-(-1),y-0⟩ \\\\  & ≈f(-1,0)+⟨{f}_{x}(-1,0),{f}_{y}(-1,0)⟩\\cdot ⟨x+1,y⟩ \\\\  & ≈2+⟨{f}_{x}(-1,0),{f}_{y}(-1,0)⟩\\cdot ⟨x+1,y⟩.\\end{aligned}\n$$\n\nNow, we find ${f}_{x}(-1,0)$ and ${f}_{y}(-1,0)$ using the given partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(-1,0) & =4(-1)=-4 \\\\ {f}_{y}(-1,0) & =6(0)=0\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nf(x,y)≈2+⟨-4,0⟩\\cdot ⟨x+1,y⟩.\n$$\n\nFinally, we can estimate $f(-1.01,0.01)$ by evaluating the linear approximation at $x=-1.01$ and $y=0.01,$ as follows:\n\n$$\n\\begin{aligned}f(-1.01,0.01) & ≈2+⟨-4,0⟩\\cdot ⟨-1.01+1,0.01⟩ \\\\  & =2+⟨-4,0⟩\\cdot ⟨-0.01,0.01⟩ \\\\  & =2-4(-0.01)+0(0.01) \\\\  & =2+0.04+0 \\\\  & =2.04\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-668268b9-6681-52bb-9c91-25df63005244"] :db/ensure [:question/validate]} {:db/id "answer-field-668268b9-6681-52bb-9c91-25df63005244" :answer-field/id #uuid "668268b9-6681-52bb-9c91-25df63005244" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-85f1f3d8-db96-5275-8e07-2c90cff21efb" :answer-field/choices ["answer-dfeb2cf6-4561-587e-8a37-967f5082634f" "answer-6f236c61-9ea2-5adb-8fa9-d16d1df7ed78" "answer-147497f8-477a-5c9c-9f25-9681d0be79d3" "answer-85f1f3d8-db96-5275-8e07-2c90cff21efb" "answer-23cf49ce-832f-57a1-9d20-ff6549700eab"] :db/ensure [:answer-field/validate]} {:db/id "answer-dfeb2cf6-4561-587e-8a37-967f5082634f" :answer/id #uuid "dfeb2cf6-4561-587e-8a37-967f5082634f" :answer/type :answer.type/math :answer/value "1.96" :db/ensure [:answer/validate]} {:db/id "answer-6f236c61-9ea2-5adb-8fa9-d16d1df7ed78" :answer/id #uuid "6f236c61-9ea2-5adb-8fa9-d16d1df7ed78" :answer/type :answer.type/math :answer/value "1.98" :db/ensure [:answer/validate]} {:db/id "answer-147497f8-477a-5c9c-9f25-9681d0be79d3" :answer/id #uuid "147497f8-477a-5c9c-9f25-9681d0be79d3" :answer/type :answer.type/math :answer/value "2.02" :db/ensure [:answer/validate]} {:db/id "answer-85f1f3d8-db96-5275-8e07-2c90cff21efb" :answer/id #uuid "85f1f3d8-db96-5275-8e07-2c90cff21efb" :answer/type :answer.type/math :answer/value "2.04" :db/ensure [:answer/validate]} {:db/id "answer-23cf49ce-832f-57a1-9d20-ff6549700eab" :answer/id #uuid "23cf49ce-832f-57a1-9d20-ff6549700eab" :answer/type :answer.type/math :answer/value "2.07" :db/ensure [:answer/validate]} {:db/id "question-adb4921d-df66-5c35-baf2-cc613e0cb3d4" :question/id #uuid "adb4921d-df66-5c35-baf2-cc613e0cb3d4" :question/math-academy-id "q-98350" :question/problem "Let be $f(x,y,z)$ a differentiable function such that\n\n$$\n\\begin{aligned} & f(0,2,1)=8, & \\, & {f}_{x}(x,y,z)=\\frac{2{e}^{x}}{\\sqrt{{e}^{x}+y+z}}, \\\\  & {f}_{y}(x,y,z)=\\frac{2}{\\sqrt{{e}^{x}+y+z}}, & \\, & {f}_{z}(x,y,z)=\\frac{2}{\\sqrt{{e}^{x}+y+z}}.\\end{aligned}\n$$\n\nUsing a linear approximation of $f$ at the point $(0,2,1),$ estimate the value of $f(-0.01,1.98,1.05).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(0,2,1)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(0,2,1)+∇f(0,2,1)\\cdot ⟨x-0,y-2,z-1⟩ \\\\  & =8+⟨{f}_{x}(0,2,1),{f}_{y}(0,2,1),{f}_{z}(0,2,1)⟩\\cdot ⟨x,y-2,z-1⟩.\\end{aligned}\n$$\n\nNow, we find ${f}_{x}(0,2,1)$, ${f}_{y}(0,2,1)$ and ${f}_{z}(0,2,1),$ using the given partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(0,2,1) & =\\frac{2{e}^{0}}{\\sqrt{{e}^{0}+2+1}}=1 \\\\ {f}_{y}(0,2,1) & =\\frac{2}{\\sqrt{{e}^{0}+2+1}}=1 \\\\ {f}_{z}(0,2,1) & =\\frac{2}{\\sqrt{{e}^{0}+2+1}}=1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nf(x,y,z)≈8+⟨1,1,1⟩\\cdot ⟨x,y-2,z-1⟩.\n$$\n\nFinally, we can estimate $f(-0.01,1.98,1.05)$ by evaluating the linear approximation at $x=-0.01,y=1.98$ and $z=1.05,$ as follows:\n\n$$\n\\begin{aligned}f(-0.01,1.98,1.05) & ≈8+⟨1,1,1⟩\\cdot ⟨-0.01,1.98-2,1.05-1⟩ \\\\  & =8+⟨1,1,1⟩\\cdot ⟨-0.01,-0.02,0.05⟩ \\\\  & =8-0.01-0.02+0.05 \\\\  & =8.02\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e18cb7ab-d012-533c-946a-99ec38759650"] :db/ensure [:question/validate]} {:db/id "answer-field-e18cb7ab-d012-533c-946a-99ec38759650" :answer-field/id #uuid "e18cb7ab-d012-533c-946a-99ec38759650" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-046fc72e-76bd-5d90-a9ca-48b2dd53d8f5" :answer-field/choices ["answer-581d699c-c227-536b-a3f7-63a4e9b6a546" "answer-0b833676-b579-5869-93ea-e7ec22b643ce" "answer-046fc72e-76bd-5d90-a9ca-48b2dd53d8f5" "answer-e66b7fc6-de8a-5d87-b748-02d2197e8975" "answer-9015c6fa-1662-594e-8970-8e6b7aa0d7ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-581d699c-c227-536b-a3f7-63a4e9b6a546" :answer/id #uuid "581d699c-c227-536b-a3f7-63a4e9b6a546" :answer/type :answer.type/math :answer/value "7.89" :db/ensure [:answer/validate]} {:db/id "answer-0b833676-b579-5869-93ea-e7ec22b643ce" :answer/id #uuid "0b833676-b579-5869-93ea-e7ec22b643ce" :answer/type :answer.type/math :answer/value "7.95" :db/ensure [:answer/validate]} {:db/id "answer-046fc72e-76bd-5d90-a9ca-48b2dd53d8f5" :answer/id #uuid "046fc72e-76bd-5d90-a9ca-48b2dd53d8f5" :answer/type :answer.type/math :answer/value "8.02" :db/ensure [:answer/validate]} {:db/id "answer-e66b7fc6-de8a-5d87-b748-02d2197e8975" :answer/id #uuid "e66b7fc6-de8a-5d87-b748-02d2197e8975" :answer/type :answer.type/math :answer/value "8.06" :db/ensure [:answer/validate]} {:db/id "answer-9015c6fa-1662-594e-8970-8e6b7aa0d7ae" :answer/id #uuid "9015c6fa-1662-594e-8970-8e6b7aa0d7ae" :answer/type :answer.type/math :answer/value "8.11" :db/ensure [:answer/validate]} {:db/id "question-d66b6ff3-5c30-5d09-a1a7-0b4d573341bb" :question/id #uuid "d66b6ff3-5c30-5d09-a1a7-0b4d573341bb" :question/math-academy-id "q-129750" :question/problem "Let $f(x,y,z)={x}^{2}z-{y}^{2}.$ Find the linear approximation of $f$ at the point $(1,0,2).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,0,2)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,0,2)+∇f(1,0,2)\\cdot ⟨x-1,y,z-2⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(1,0,2)=2.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =2xz\\,⇒\\,{f}_{x}(1,0,2)=4, \\\\ {f}_{y} & =-2y\\,⇒\\,{f}_{y}(1,0,2)=0, \\\\ {f}_{z} & ={x}^{2}\\,⇒\\,{f}_{z}(1,0,2)=1.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(1,0,2)$ is given by\n\n$$\n\\begin{aligned}∇f(1,0,2) & =⟨{f}_{x}(1,0,2),{f}_{y}(1,0,2),{f}_{z}(1,0,2)⟩ \\\\  & =⟨4,0,1⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,0,2)+∇f(1,0,2)\\cdot ⟨x-1,y,z-2⟩ \\\\  & ≈2+⟨4,0,1⟩\\cdot ⟨x-1,y,z-2⟩ \\\\  & ≈2+4(x-1)+0(y)+(z-2) \\\\  & ≈-4+4x+z.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-531515dc-d792-550d-b5bf-9db7ffa81bdf"] :db/ensure [:question/validate]} {:db/id "answer-field-531515dc-d792-550d-b5bf-9db7ffa81bdf" :answer-field/id #uuid "531515dc-d792-550d-b5bf-9db7ffa81bdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47f1f736-9ce9-5cac-950e-771e037ad90b" :answer-field/choices ["answer-9d9e6cd4-918b-5fdf-8fab-439839fcb9fa" "answer-3b911150-117d-5354-83c0-6cdaf5fb85a2" "answer-47f1f736-9ce9-5cac-950e-771e037ad90b" "answer-6f0da771-d211-5e7f-9eb1-b6339fde5443" "answer-1205b66d-2ea8-57c6-8f6d-0b9c7514c512"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d9e6cd4-918b-5fdf-8fab-439839fcb9fa" :answer/id #uuid "9d9e6cd4-918b-5fdf-8fab-439839fcb9fa" :answer/type :answer.type/math :answer/value "f(x,y,z)≈-1+x-y+z" :db/ensure [:answer/validate]} {:db/id "answer-3b911150-117d-5354-83c0-6cdaf5fb85a2" :answer/id #uuid "3b911150-117d-5354-83c0-6cdaf5fb85a2" :answer/type :answer.type/math :answer/value "f(x,y,z)≈-2+4x-y" :db/ensure [:answer/validate]} {:db/id "answer-47f1f736-9ce9-5cac-950e-771e037ad90b" :answer/id #uuid "47f1f736-9ce9-5cac-950e-771e037ad90b" :answer/type :answer.type/math :answer/value "f(x,y,z)≈-4+4x+z" :db/ensure [:answer/validate]} {:db/id "answer-6f0da771-d211-5e7f-9eb1-b6339fde5443" :answer/id #uuid "6f0da771-d211-5e7f-9eb1-b6339fde5443" :answer/type :answer.type/math :answer/value "f(x,y,z)≈3+x+2y-z" :db/ensure [:answer/validate]} {:db/id "answer-1205b66d-2ea8-57c6-8f6d-0b9c7514c512" :answer/id #uuid "1205b66d-2ea8-57c6-8f6d-0b9c7514c512" :answer/type :answer.type/math :answer/value "f(x,y,z)≈4+2y-z" :db/ensure [:answer/validate]}]
