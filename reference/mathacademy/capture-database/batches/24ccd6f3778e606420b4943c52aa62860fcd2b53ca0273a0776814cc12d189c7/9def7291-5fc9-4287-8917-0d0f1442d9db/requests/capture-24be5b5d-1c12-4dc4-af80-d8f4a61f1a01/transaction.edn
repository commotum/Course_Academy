a0e-0d78-5eb4-a373-2c5fe073b03a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8320ca0e-0d78-5eb4-a373-2c5fe073b03a" :answer/id #uuid "8320ca0e-0d78-5eb4-a373-2c5fe073b03a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-920b4acd-ce70-5a81-a42c-cb01e9f965fb" :answer-field/id #uuid "920b4acd-ce70-5a81-a42c-cb01e9f965fb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-049ea557-4d92-5f5b-878c-bb4d41b99074" :answer-field/choices ["answer-049ea557-4d92-5f5b-878c-bb4d41b99074"] :db/ensure [:answer-field/validate]} {:db/id "answer-049ea557-4d92-5f5b-878c-bb4d41b99074" :answer/id #uuid "049ea557-4d92-5f5b-878c-bb4d41b99074" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-0dc700b9-f0a4-5b59-9c19-77a6b7c1362c" :answer-field/id #uuid "0dc700b9-f0a4-5b59-9c19-77a6b7c1362c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4d9a0b69-2551-510b-a191-6777480f7929" :answer-field/choices ["answer-4d9a0b69-2551-510b-a191-6777480f7929"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d9a0b69-2551-510b-a191-6777480f7929" :answer/id #uuid "4d9a0b69-2551-510b-a191-6777480f7929" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "activity-4dc16135-b9af-5c1e-ab88-b2de2e7d8742" :activity/id #uuid "4dc16135-b9af-5c1e-ab88-b2de2e7d8742" :activity/title "The Range of a Function" :activity/type :activity.type/review :activity/scope 17592186049707 :activity/course 17592186046658 :activity/steps ["step-983f5a45-1a23-5889-ac93-0368d4110505" "step-062e6706-d792-58b5-acc0-8902fc891e0b" "step-0320c674-391c-525d-a5c4-9c442fc33f7e" "step-b04d87be-0779-5826-b838-ff3afa3d8d4c" "step-f351f74d-f785-540b-b5d7-7d1c984c411b"] :activity/first-step "step-983f5a45-1a23-5889-ac93-0368d4110505" :db/ensure [:activity/validate]} {:db/id "step-983f5a45-1a23-5889-ac93-0368d4110505" :step/id #uuid "983f5a45-1a23-5889-ac93-0368d4110505" :step/content 17592186083526 :step/next "step-062e6706-d792-58b5-acc0-8902fc891e0b" :db/ensure [:step/validate]} {:db/id "step-062e6706-d792-58b5-acc0-8902fc891e0b" :step/id #uuid "062e6706-d792-58b5-acc0-8902fc891e0b" :step/content "question-c17be40c-81be-54ae-93a6-293eae7f05d7" :step/next "step-0320c674-391c-525d-a5c4-9c442fc33f7e" :db/ensure [:step/validate]} {:db/id "step-0320c674-391c-525d-a5c4-9c442fc33f7e" :step/id #uuid "0320c674-391c-525d-a5c4-9c442fc33f7e" :step/content "question-f6271452-0c9d-5cbb-808a-a03630c0e389" :step/next "step-b04d87be-0779-5826-b838-ff3afa3d8d4c" :db/ensure [:step/validate]} {:db/id "step-b04d87be-0779-5826-b838-ff3afa3d8d4c" :step/id #uuid "b04d87be-0779-5826-b838-ff3afa3d8d4c" :step/content "question-f18ce5af-43bd-5993-814d-ed1e89769ace" :step/next "step-f351f74d-f785-540b-b5d7-7d1c984c411b" :db/ensure [:step/validate]} {:db/id "step-f351f74d-f785-540b-b5d7-7d1c984c411b" :step/id #uuid "f351f74d-f785-540b-b5d7-7d1c984c411b" :step/content "question-0794aaff-8257-5ff5-95bd-c8b72d62b6ae" :db/ensure [:step/validate]} {:db/id 17592186088394 :question/worked-solution "First, we need to find the complementary function ${y}_{c}(x),$ which is the solution to the homogeneous equation\n\n$$\n{y}^{″}+2{y}^{′}+y=0.\n$$\n\nWriting down and solving the auxiliary equation gives:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +1 & =0 \\\\ {(\\lambda +1)}^{2} & =0\\end{aligned}\n$$\n\nSo $\\lambda =-1$ is a repeated root, and therefore the complementary function ${y}_{c}(x)$ is\n\n$$\n{y}_{c}=A{e}^{-x}+Bx{e}^{-x}\n$$\n\nWe now need to find the particular solution${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is $-25\\operatorname{sin}⁡2x.$ Therefore, we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha \\operatorname{cos}⁡2x+\\beta \\operatorname{sin}⁡2x,\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}{y}_{p}}{\\text{d}x} & =-2\\alpha \\operatorname{sin}⁡2x+2\\beta \\operatorname{cos}⁡2x \\\\ \\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{x}^{2}} & =-4\\alpha \\operatorname{cos}⁡2x-4\\beta \\operatorname{sin}⁡2x\\end{aligned}\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n(-4\\alpha \\operatorname{cos}⁡2x-4\\beta \\operatorname{sin}⁡2x)+2(-2\\alpha \\operatorname{sin}⁡2x+2\\beta \\operatorname{cos}⁡2x)+(\\alpha \\operatorname{cos}⁡2x+\\beta \\operatorname{sin}⁡2x)=-25\\operatorname{sin}⁡2x\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(-3\\alpha +4\\beta )\\operatorname{cos}⁡2x+(-4\\alpha -3\\beta )\\operatorname{sin}⁡2x=-25\\operatorname{sin}⁡2x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-3\\alpha +4\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡2x) \\\\ -4\\alpha -3\\beta =-25\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡2x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =4$ and $\\beta =3.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=4\\operatorname{cos}⁡2x+3\\operatorname{sin}⁡2x.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{-x}+Bx{e}^{-x}+4\\operatorname{cos}⁡2x+3\\operatorname{sin}⁡2x.\n$$\n\nNow let us find constants $A$ and $B.$ \n\nSubstituting $y(0)=4$ into the general solution gives:\n\n$$\n\\begin{aligned}A+4 & =4 \\\\ A & =0\\end{aligned}\n$$\n\nWe now need to apply the condition ${y}^{′}(0)=0.$ First, we differentiate $y$ to find ${y}^{′}:$\n\n$$\n{y}^{′}=-A{e}^{-x}+B{e}^{-x}-Bx{e}^{-x}-8\\operatorname{sin}⁡2x+6\\operatorname{cos}⁡2x\n$$\n\nSubstituting ${y}^{′}(0)=0$ into the above gives:\n\n$$\n\\begin{aligned}-A+B+6 & =0 \\\\ B & =-6\\end{aligned}\n$$\n\nTherefore, $A=0,B=-6.$\n\nSo, the solution to the initial value problem is\n\n$$\ny=-6x{e}^{-x}+4\\operatorname{cos}⁡2x+3\\operatorname{sin}⁡2x.\n$$" :db/ensure [:question/validate]} {:db/id 17592186087780 :knowledge-point/questions ["question-b54ddcc0-5401-5d92-820d-ec32389dd88e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186404440 :question/worked-solution "First, we need to find the complementary function ${y}_{c}(x),$ which is the solution to the homogeneous equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+16y=0.\n$$\n\nWriting down and solving the auxiliary equation gives:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2} & =-16\\end{aligned}\n$$\n\nSo $\\lambda =\\pm 4\\text{i}$, and therefore the complementary function ${y}_{c}(x)$ is\n\n$$\n{y}_{c}(x)=P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x.\n$$\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe particular solution of the inhomogeneous equation cannot be of the form $\\alpha \\operatorname{cos}⁡4x+\\beta \\operatorname{sin}⁡4x$ because this is already included in the complementary function. Therefore, we assume a particular solution of the form \n\n$$\n{y}_{p}=x(\\alpha \\operatorname{cos}⁡4x+\\beta \\operatorname{sin}⁡4x),\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}{y}_{p}}{\\text{d}x} & =(\\alpha \\operatorname{cos}⁡4x+\\beta \\operatorname{sin}⁡4x)+4x(-\\alpha \\operatorname{sin}⁡4x+\\beta \\operatorname{cos}⁡4x) \\\\ \\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{x}^{2}} & =8(-\\alpha \\operatorname{sin}⁡4x+\\beta \\operatorname{cos}⁡4x)+16x(-\\alpha \\operatorname{cos}⁡4x-\\beta \\operatorname{sin}⁡4x).\\end{aligned}\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n8(-\\alpha \\operatorname{sin}⁡4x+\\beta \\operatorname{cos}⁡4x)+16x(-\\alpha \\operatorname{cos}⁡4x-\\beta \\operatorname{sin}⁡4x)+16x(\\alpha \\operatorname{cos}⁡4x+\\beta \\operatorname{sin}⁡4x)\\,=4\\operatorname{sin}⁡4x.\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-8\\alpha \\operatorname{sin}⁡4x+8\\beta \\operatorname{cos}⁡4x=4\\operatorname{sin}⁡4x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}\\beta =0\\, & (\\text{equating the coefficients of}\\,\\,\\operatorname{cos}⁡4x) \\\\ -8\\alpha =4\\, & (\\text{equating the coefficients of}\\,\\,\\operatorname{sin}⁡4x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{1}{2}$, $\\beta =0.$\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{1}{2}x\\operatorname{cos}⁡4x.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny={y}_{c}+{y}_{p}=P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x-\\frac{1}{2}x\\operatorname{cos}⁡4x.\n$$" :db/ensure [:question/validate]} {:db/id 17592186088225 :question/worked-solution "First, we need to find the complementary function ${y}_{c}(x),$ which is the solution to the homogeneous equation\n\n$$\n{y}^{″}+9y=0.\n$$\n\nWriting down and solving the auxiliary equation gives:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+9 & =0 \\\\ {\\lambda }^{2} & =-9\\end{aligned}\n$$\n\nSo $\\lambda =\\pm 3\\text{i},$ and therefore the complementary function ${y}_{c}(x)$ is\n\n$$\n{y}_{c}(x)=P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x.\n$$\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe particular solution of the inhomogeneous equation cannot be of the form $\\alpha \\operatorname{cos}⁡3x+\\beta \\operatorname{sin}⁡3x$ because this is already included in the complementary function. Therefore, we assume a particular solution of the form\n\n$$\n{y}_{p}=x(\\alpha \\operatorname{cos}⁡3x+\\beta \\operatorname{sin}⁡3x),\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\begin{aligned}{y}^{′} & =(\\alpha \\operatorname{cos}⁡3x+\\beta \\operatorname{sin}⁡3x)+3x(-\\alpha \\operatorname{sin}⁡3x+\\beta \\operatorname{cos}⁡3x) \\\\ {y}^{″} & =6(-\\alpha \\operatorname{sin}⁡3x+\\beta \\operatorname{cos}⁡3x)+9x(-\\alpha \\operatorname{cos}⁡3x-\\beta \\operatorname{sin}⁡3x).\\end{aligned}\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n6(-\\alpha \\operatorname{sin}⁡3x+\\beta \\operatorname{cos}⁡3x)+9x(-\\alpha \\operatorname{cos}⁡3x-\\beta \\operatorname{sin}⁡3x)+9x(\\alpha \\operatorname{cos}⁡3x+\\beta \\operatorname{sin}⁡3x)=6\\operatorname{cos}⁡3x-12\\operatorname{sin}⁡3x\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-6\\alpha \\operatorname{sin}⁡3x+6\\beta \\operatorname{cos}⁡3x=6\\operatorname{cos}⁡3x-12\\operatorname{sin}⁡3x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}6\\beta =6\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡3x) \\\\ -6\\alpha =-12\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡3x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =2,\\beta =1.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=x(2\\operatorname{cos}⁡3x+\\operatorname{sin}⁡3x).\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x+x(2\\operatorname{cos}⁡3x+\\operatorname{sin}⁡3x).\n$$\n\nNow let us find constants $P$ and $Q.$ \n\nSubstituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\nWe now need to apply the condition ${y}^{′}(0)=5.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n{y}^{′}=-3P\\operatorname{sin}⁡3x+3Q\\operatorname{cos}⁡3x+(2\\operatorname{cos}⁡3x+\\operatorname{sin}⁡3x)+x(-6\\operatorname{sin}⁡3x+3\\operatorname{cos}⁡3x)\n$$\n\nSubstituting ${y}^{′}(0)=5$ into the above gives\n\n$$\n3Q+2=5.\n$$\n\nTherefore, $P=2,Q=1.$\n\nSo, the solution to the initial value problem is\n\n$$\ny=2\\operatorname{cos}⁡3x+\\operatorname{sin}⁡3x+2x\\operatorname{cos}⁡3x+x\\operatorname{sin}⁡3x.\n$$" :db/ensure [:question/validate]} {:db/id "question-b54ddcc0-5401-5d92-820d-ec32389dd88e" :question/id #uuid "b54ddcc0-5401-5d92-820d-ec32389dd88e" :question/math-academy-id "q-93821" :question/problem "Given that the differential equation \n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y=-4\\operatorname{cos}⁡x\n$$\n\nhas the complementary function ${y}_{c}(x)=A\\operatorname{cos}⁡x+B\\operatorname{sin}⁡x,$ find the particular solution ${y}_{p}(x)$ to this equation." :question/worked-solution "The particular solution of the inhomogeneous equation cannot be of the form $\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x$ because this is already included in the complementary function. Therefore, we assume a particular solution of the form\n\n$$\n{y}_{p}=x(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x),\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x)+x(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x) \\\\ {y}_{p}^{″} & =2(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x)+x(-\\alpha \\operatorname{cos}⁡x-\\beta \\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n2(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x)+x(-\\alpha \\operatorname{cos}⁡x-\\beta \\operatorname{sin}⁡x)+x(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡x\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n-2\\alpha \\operatorname{sin}⁡x+2\\beta \\operatorname{cos}⁡x=-4\\operatorname{cos}⁡x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2\\beta =-4\\, & (\\text{equating the coefficients of}\\,\\,\\operatorname{cos}⁡x) \\\\ -2\\alpha =0\\, & (\\text{equating the coefficients of}\\,\\,\\operatorname{sin}⁡x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =0$ and $\\beta =-2.$ Therefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-2x\\operatorname{sin}⁡x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1132dd4f-2625-5c46-a672-de1c19731cae"] :db/ensure [:question/validate]} {:db/id "answer-field-1132dd4f-2625-5c46-a672-de1c19731cae" :answer-field/id #uuid "1132dd4f-2625-5c46-a672-de1c19731cae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-300772cd-f5ba-520d-8474-76518d72ebc3" :answer-field/choices ["answer-1558b0b5-c4b1-5e89-a0e8-d7774ed107d7" "answer-300772cd-f5ba-520d-8474-76518d72ebc3" "answer-05ff3d06-b078-5717-9490-3faff9c71641" "answer-ec1ead3d-19b8-5d1a-aaf4-197e07495f04" "answer-db054387-992a-574d-a0fb-723173337d03"] :db/ensure [:answer-field/validate]} {:db/id "answer-1558b0b5-c4b1-5e89-a0e8-d7774ed107d7" :answer/id #uuid "1558b0b5-c4b1-5e89-a0e8-d7774ed107d7" :answer/type :answer.type/math :answer/value "{y}_{p}=-2x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-300772cd-f5ba-520d-8474-76518d72ebc3" :answer/id #uuid "300772cd-f5ba-520d-8474-76518d72ebc3" :answer/type :answer.type/math :answer/value "{y}_{p}=-2x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-05ff3d06-b078-5717-9490-3faff9c71641" :answer/id #uuid "05ff3d06-b078-5717-9490-3faff9c71641" :answer/type :answer.type/math :answer/value "{y}_{p}=2x\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-ec1ead3d-19b8-5d1a-aaf4-197e07495f04" :answer/id #uuid "ec1ead3d-19b8-5d1a-aaf4-197e07495f04" :answer/type :answer.type/math :answer/value "{y}_{p}=x\\operatorname{cos}⁡x+2x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-db054387-992a-574d-a0fb-723173337d03" :answer/id #uuid "db054387-992a-574d-a0fb-723173337d03" :answer/type :answer.type/math :answer/value "{y}_{p}=x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "activity-ecfa8a6f-6f7d-5927-a067-1510a6b299f6" :activity/id #uuid "ecfa8a6f-6f7d-5927-a067-1510a6b299f6" :activity/title "Second-Order Inhomogeneous ODEs With Sinusoidal Forcing" :activity/type :activity.type/review :activity/scope 17592186050378 :activity/course 17592186046659 :activity/steps ["step-a9c3d001-ce3b-5bba-8aeb-9e82dce0245f" "step-258fe0ea-8ee7-50b1-a345-c7cc0446d78e" "step-2a4b63ff-1a1d-52b2-8764-7aa4930a5a52" "step-c24cbb9e-036c-5310-abfa-e2fe0d1bf510" "step-17bdec16-3bbd-59b2-9828-09e0f7e28f95"] :activity/first-step "step-a9c3d001-ce3b-5bba-8aeb-9e82dce0245f" :db/ensure [:activity/validate]} {:db/id "step-a9c3d001-ce3b-5bba-8aeb-9e82dce0245f" :step/id #uuid "a9c3d001-ce3b-5bba-8aeb-9e82dce0245f" :step/content 17592186088394 :step/next "step-258fe0ea-8ee7-50b1-a345-c7cc0446d78e" :db/ensure [:step/validate]} {:db/id "step-258fe0ea-8ee7-50b1-a345-c7cc0446d78e" :step/id #uuid "258fe0ea-8ee7-50b1-a345-c7cc0446d78e" :step/content 17592186404440 :step/next "step-2a4b63ff-1a1d-52b2-8764-7aa4930a5a52" :db/ensure [:step/validate]} {:db/id "step-2a4b63ff-1a1d-52b2-8764-7aa4930a5a52" :step/id #uuid "2a4b63ff-1a1d-52b2-8764-7aa4930a5a52" :step/content 17592186088225 :step/next "step-c24cbb9e-036c-5310-abfa-e2fe0d1bf510" :db/ensure [:step/validate]} {:db/id "step-c24cbb9e-036c-5310-abfa-e2fe0d1bf510" :step/id #uuid "c24cbb9e-036c-5310-abfa-e2fe0d1bf510" :step/content "question-b54ddcc0-5401-5d92-820d-ec32389dd88e" :step/next "step-17bdec16-3bbd-59b2-9828-09e0f7e28f95" :db/ensure [:step/validate]} {:db/id "step-17bdec16-3bbd-59b2-9828-09e0f7e28f95" :step/id #uuid "17bdec16-3bbd-59b2-9828-09e0f7e28f95" :step/content 17592186357578 :db/ensure [:step/validate]} {:db/id 17592186179639 :knowledge-point/questions ["question-6b9f4cd9-9a85-5f2d-9eac-f617eac7ba39" "question-a7db436d-ecf4-5342-922a-617ed93580d3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179467 :question/problem "Solve the equation $2 = wz - 2w +1$ for the variable $w.$" :question/worked-solution "We need to isolate all terms with $w$ on one side of the equation. To do this, we subtract $1$ from both sides:\n\n$$\n\\begin{aligned}2 & =wz-2w+1 \\\\ 2-1 & =wz-2w+1-1 \\\\ 1 & =wz-2w\\end{aligned}\n$$\n\nNext, we factor out $w$ in the expression on the right-hand side.\n\n$$\n\\begin{aligned}1 & =wz-2w \\\\ 1 & =w(z-2)\\end{aligned}\n$$\n\nThen, we divide both sides by $(z-2)$ to isolate $w\\mathbin{:}$\n\n$$\n\\begin{aligned}1 & =w(z-2) \\\\ \\frac{1}{z-2} & =\\frac{w(z-2)}{z-2} \\\\ \\frac{1}{z-2} & =\\frac{w\\cancel{(z-2)}}{\\cancel{z-2}} \\\\ \\frac{1}{z-2} & =w \\\\ w & =\\frac{1}{z-2}\\end{aligned}\n$$\n\n**Note:** This result assumes that $z-2\\neq 0.$" :db/ensure [:question/validate]} {:db/id 17592186179640 :knowledge-point/questions ["question-03f30d76-6e4b-58e9-917f-05e941931839" "question-d1bde4eb-16c8-5f7c-8125-caf4a9cb1949"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179469 :question/problem "Solve the equation $4ky=5y + 1$ for the variable $y.$" :question/worked-solution "We need to isolate all terms with $y$ on one side of the equation. To do this, we subtract $5y$ from both sides:\n\n$$\n\\begin{aligned}4ky & =5y+1 \\\\ 4ky-5y & =5y+1-5y \\\\ 4ky-5y & =1\\end{aligned}\n$$\n\nNotice that all terms containing $y$ are on the left-hand side, and all terms independent of $y$ are on the right-hand side.\n\nNext, we factor out $y$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}4ky-5y & =1 \\\\ y(4k-5) & =1\\end{aligned}\n$$\n\nFinally, we divide both sides by $(4k -5)$ to isolate $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y(4k-5) & =1 \\\\ \\frac{y(4k-5)}{(4k-5)} & =\\frac{1}{(4k-5)} \\\\ \\frac{y\\cancel{(4k-5)}}{\\cancel{(4k-5)}} & =\\frac{1}{4k-5} \\\\ y & =\\frac{1}{4k-5}\\end{aligned}\n$$\n\n**Note:** This result assumes that $4k-5\\neq 0.$" :db/ensure [:question/validate]} {:db/id 17592186179641 :knowledge-point/questions ["question-77fe19c1-2d2e-5ba1-9d49-d82b50f369df" "question-5eedbb0b-2f52-5239-8343-cadc5e74eba1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179471 :question/problem "Solve the equation $\\dfrac{xy}{3} = \\dfrac{y - 1}{2}$ for the variable $y.$" :question/worked-solution "We need to isolate all terms with $y$ on one side of the equation. To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{xy}{3} & =\\frac{y-1}{2} \\\\ 2\\cdot xy & =3\\cdot (y-1) \\\\ 2xy & =3y-3\\end{aligned}\n$$\n\nNext, we subtract $3y$ from both sides of the equation:\n\n$$\n\\begin{aligned}2xy & =3y-3 \\\\ 2xy-3y & =3y-3-3y \\\\ 2xy-3y & =-3\\end{aligned}\n$$\n\nNotice that all terms containing $y$ are on the left-hand side, and all terms independent of $y$ are on the right-hand side.\n\nThen, we factor out $y$ from the left-hand side:\n\n$$\n\\begin{aligned}2xy-3y & =-3 \\\\ y(2x-3) & =-3\\end{aligned}\n$$\n\nFinally, we divide both sides by $(2x - 3)$ to isolate $y\\mathbin{:}$\n\n$$\n\\begin{aligned}y(2x-3) & =-3 \\\\ \\frac{y(2x-3)}{2x-3} & =\\frac{-3}{2x-3} \\\\ \\frac{y\\cancel{(2x-3)}}{\\cancel{2x-3}} & =\\frac{-3}{2x-3} \\\\ y & =-\\frac{3}{2x-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2x-3\\neq 0.$" :db/ensure [:question/validate]} {:db/id "question-6b9f4cd9-9a85-5f2d-9eac-f617eac7ba39" :question/id #uuid "6b9f4cd9-9a85-5f2d-9eac-f617eac7ba39" :question/math-academy-id "q-133790" :question/problem "If $10=3rs+2s-2,$ then $s=$" :question/worked-solution "We need to isolate all terms with $s$ on one side of the equation. To do this, we add $2$ to both sides:\n\n$$\n\\begin{aligned}10 & =3rs+2s-2 \\\\ 10+2 & =3rs+2s-2+2 \\\\ 12 & =3rs+2s\\end{aligned}\n$$\n\nNext, we factor out $s$ in the expression on the right-hand side.\n\n$$\n\\begin{aligned}12 & =3rs+2s \\\\ 12 & =s(3r+2)\\end{aligned}\n$$\n\nThen, we divide both sides by $(3r+2)$ to isolate $s:$\n\n$$\n\\begin{aligned}12 & =s(3r+2) \\\\ \\frac{12}{3r+2} & =\\frac{s(3r+2)}{3r+2} \\\\ \\frac{12}{3r+2} & =\\frac{s\\cancel{(3r+2)}}{\\cancel{3r+2}} \\\\ \\frac{12}{3r+2} & =s \\\\ s & =\\frac{12}{3r+2}\\end{aligned}\n$$\n\n**Note:** This result assumes that $3r+2\\ne 0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-52edd805-e394-51e3-8580-2a03d9a5fe75"] :db/ensure [:question/validate]} {:db/id "answer-field-52edd805-e394-51e3-8580-2a03d9a5fe75" :answer-field/id #uuid "52edd805-e394-51e3-8580-2a03d9a5fe75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7412419a-05ad-52be-9689-89ea3aab3fb9" :answer-field/choices ["answer-579b61a3-ba63-5017-b291-f78398e84c73" "answer-ffdc22e1-d675-57fc-806e-440860880dd1" "answer-7412419a-05ad-52be-9689-89ea3aab3fb9" "answer-e114a012-2dc5-5b44-bba0-e3352f234714" "answer-b2f846ca-788b-528a-bec5-570a58cab209"] :db/ensure [:answer-field/validate]} {:db/id "answer-579b61a3-ba63-5017-b291-f78398e84c73" :answer/id #uuid "579b61a3-ba63-5017-b291-f78398e84c73" :answer/type :answer.type/math :answer/value "3r+2" :db/ensure [:answer/validate]} {:db/id "answer-ffdc22e1-d675-57fc-806e-440860880dd1" :answer/id #uuid "ffdc22e1-d675-57fc-806e-440860880dd1" :answer/type :answer.type/math :answer/value "3r-2" :db/ensure [:answer/validate]} {:db/id "answer-7412419a-05ad-52be-9689-89ea3aab3fb9" :answer/id #uuid "7412419a-05ad-52be-9689-89ea3aab3fb9" :answer/type :answer.type/math :answer/value "\\frac{12}{3r+2}" :db/ensure [:answer/validate]} {:db/id "answer-e114a012-2dc5-5b44-bba0-e3352f234714" :answer/id #uuid "e114a012-2dc5-5b44-bba0-e3352f234714" :answer/type :answer.type/math :answer/value "\\frac{2}{3r+12}" :db/ensure [:answer/validate]} {:db/id "answer-b2f846ca-788b-528a-bec5-570a58cab209" :answer/id #uuid "b2f846ca-788b-528a-bec5-570a58cab209" :answer/type :answer.type/math :answer/value "\\frac{2}{3r-12}" :db/ensure [:answer/validate]} {:db/id "question-a7db436d-ecf4-5342-922a-617ed93580d3" :question/id #uuid "a7db436d-ecf4-5342-922a-617ed93580d3" :question/math-academy-id "q-133775" :question/problem "If $5tx-3x=2,$ then $x=$" :question/worked-solution "First, we factor out $x$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}5tx-3x & =2 \\\\ x(5t-3) & =2\\end{aligned}\n$$\n\nThen, we divide both sides by $(5t-3)$ to isolate $x:$\n\n$$\n\\begin{aligned}x(5t-3) & =2 \\\\ \\frac{x(5t-3)}{5t-3} & =\\frac{2}{5t-3} \\\\ \\frac{x\\cancel{(5t-3)}}{\\cancel{5t-3}} & =\\frac{2}{5t-3} \\\\ x & =\\frac{2}{5t-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $5t-3\\ne 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bebe6369-58e1-5cc9-8adf-5a7af1f55142"] :db/ensure [:question/validate]} {:db/id "answer-field-bebe6369-58e1-5cc9-8adf-5a7af1f55142" :answer-field/id #uuid "bebe6369-58e1-5cc9-8adf-5a7af1f55142" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d963bb82-5c56-53d6-9bd9-cfbfe08eda09" :answer-field/choices ["answer-e44bf7f2-164c-5379-ba4a-d9cc8c94aca0" "answer-9710bc14-6ad4-56a3-9aef-e0f30c762acf" "answer-786a511d-e212-586c-b3f2-d3847309dfa7" "answer-9a8b49ad-93a5-5255-a9f4-e73e912aa53d" "answer-d963bb82-5c56-53d6-9bd9-cfbfe08eda09"] :db/ensure [:answer-field/validate]} {:db/id "answer-e44bf7f2-164c-5379-ba4a-d9cc8c94aca0" :answer/id #uuid "e44bf7f2-164c-5379-ba4a-d9cc8c94aca0" :answer/type :answer.type/math :answer/value "10t+6" :db/ensure [:answer/validate]} {:db/id "answer-9710bc14-6ad4-56a3-9aef-e0f30c762acf" :answer/id #uuid "9710bc14-6ad4-56a3-9aef-e0f30c762acf" :answer/type :answer.type/math :answer/value "10t-6" :db/ensure [:answer/validate]} {:db/id "answer-786a511d-e212-586c-b3f2-d3847309dfa7" :answer/id #uuid "786a511d-e212-586c-b3f2-d3847309dfa7" :answer/type :answer.type/math :answer/value "\\frac{1}{10t-6}" :db/ensure [:answer/validate]} {:db/id "answer-9a8b49ad-93a5-5255-a9f4-e73e912aa53d" :answer/id #uuid "9a8b49ad-93a5-5255-a9f4-e73e912aa53d" :answer/type :answer.type/math :answer/value "\\frac{2}{5t+3}" :db/ensure [:answer/validate]} {:db/id "answer-d963bb82-5c56-53d6-9bd9-cfbfe08eda09" :answer/id #uuid "d963bb82-5c56-53d6-9bd9-cfbfe08eda09" :answer/type :answer.type/math :answer/value "\\frac{2}{5t-3}" :db/ensure [:answer/validate]} {:db/id "question-03f30d76-6e4b-58e9-917f-05e941931839" :question/id #uuid "03f30d76-6e4b-58e9-917f-05e941931839" :question/math-academy-id "q-215778" :question/problem "If $7pq+1=3q+8,$ then $q=${{field-1}}." :question/worked-solution "We need to isolate all terms with $q$ on one side of the equation. To do this, we start by subtracting $1$ from both sides: \n\n$$\n\\begin{aligned}7pq+1 & =3q+8 \\\\ 7pq+1-1 & =3q+8-1 \\\\ 7pq & =3q+7\\end{aligned}\n$$\n\nNext, we subtract $3q$ from both sides of the equation:\n\n$$\n\\begin{aligned}7pq & =3q+7 \\\\ 7pq-3q & =3q+7-3q \\\\ 7pq-3q & =7\\end{aligned}\n$$\n\nNotice that all terms containing $q$ are on the left-hand side, and all terms independent of $q$ are on the right-hand side.\n\nNext, we factor out $q$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}7pq-3q & =7 \\\\ (7p-3)q & =7\\end{aligned}\n$$\n\nFinally, we divide both sides by $(7p-3)$ to isolate $q:$\n\n$$\n\\begin{aligned}(7p-3)q & =7 \\\\ \\frac{(7p-3)q}{7p-3} & =\\frac{7}{7p-3} \\\\ \\frac{\\cancel{(7p-3)}q}{\\cancel{7p-3}} & =\\frac{7}{7p-3} \\\\ q & =\\frac{7}{7p-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $7p-3\\ne 0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5be6f4c4-2cc2-5d19-b848-3c7a94a8c33e"] :db/ensure [:question/validate]} {:db/id "answer-field-5be6f4c4-2cc2-5d19-b848-3c7a94a8c33e" :answer-field/id #uuid "5be6f4c4-2cc2-5d19-b848-3c7a94a8c33e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6422d58b-a6aa-55ce-9272-f106d09fe53e" :answer-field/choices ["answer-6422d58b-a6aa-55ce-9272-f106d09fe53e"] :db/ensure [:answer-field/validate]} {:db/id "answer-6422d58b-a6aa-55ce-9272-f106d09fe53e" :answer/id #uuid "6422d58b-a6aa-55ce-9272-f106d09fe53e" :answer/type :answer.type/math :answer/value "\\frac{7}{7p-3}" :db/ensure [:answer/validate]} {:db/id "question-d1bde4eb-16c8-5f7c-8125-caf4a9cb1949" :question/id #uuid "d1bde4eb-16c8-5f7c-8125-caf4a9cb1949" :question/math-academy-id "q-45310" :question/problem "If $4c+5=3yc-2,$ then $c=$" :question/worked-solution "We need to isolate all terms with $c$ on one side of the equation. To do this, we start by subtracting $5$ from both sides: \n\n$$\n\\begin{aligned}4c+5 & =3yc-2 \\\\ 4c+5-5 & =3yc-2-5 \\\\ 4c & =3yc-7\\end{aligned}\n$$\n\nNext, we subtract $3yc$ from both sides of the equation:\n\n$$\n\\begin{aligned}4c & =3yc-7 \\\\ 4c-3yc & =3yc-7-3yc \\\\ 4c-3yc & =-7\\end{aligned}\n$$\n\nNotice that all terms containing $c$ are on the left-hand side, and all terms independent of $c$ are on the right-hand side.\n\nNext, we factor out $c$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}4c-3yc & =-7 \\\\ c(4-3y) & =-7\\end{aligned}\n$$\n\nFinally, we divide both sides by $(4-3y)$ to isolate $c:$\n\n$$\n\\begin{aligned}c(4-3y) & =-7 \\\\ \\frac{c(4-3y)}{4-3y} & =\\frac{-7}{4-3y} \\\\ \\frac{c\\cancel{(4-3y)}}{\\cancel{4-3y}} & =-\\frac{7}{4-3y} \\\\ c & =\\frac{7}{3y-4}\\end{aligned}\n$$\n\n**Note:** This result assumes that $3y-4\\ne 0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e8b6c1d8-6172-501d-a590-456ba1e9c20b"] :db/ensure [:question/validate]} {:db/id "answer-field-e8b6c1d8-6172-501d-a590-456ba1e9c20b" :answer-field/id #uuid "e8b6c1d8-6172-501d-a590-456ba1e9c20b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8533b29d-b9b1-511a-bb70-36d3cde5a702" :answer-field/choices ["answer-a95c467d-832e-5741-85a4-f555b8d510a5" "answer-d4c1466d-dc5c-58aa-b40b-07f2ca19557f" "answer-ddc8db81-fc20-5f94-9811-aaafccb7fb1e" "answer-35a8fe3c-1990-50e9-8694-e77e9c13624b" "answer-8533b29d-b9b1-511a-bb70-36d3cde5a702"] :db/ensure [:answer-field/validate]} {:db/id "answer-a95c467d-832e-5741-85a4-f555b8d510a5" :answer/id #uuid "a95c467d-832e-5741-85a4-f555b8d510a5" :answer/type :answer.type/math :answer/value "-\\frac{5}{4y+3}" :db/ensure [:answer/validate]} {:db/id "answer-d4c1466d-dc5c-58aa-b40b-07f2ca19557f" :answer/id #uuid "d4c1466d-dc5c-58aa-b40b-07f2ca19557f" :answer/type :answer.type/math :answer/value "\\frac{5}{4y-3}" :db/ensure [:answer/validate]} {:db/id "answer-ddc8db81-fc20-5f94-9811-aaafccb7fb1e" :answer/id #uuid "ddc8db81-fc20-5f94-9811-aaafccb7fb1e" :answer/type :answer.type/math :answer/value "\\frac{7}{2y-3}" :db/ensure [:answer/validate]} {:db/id "answer-35a8fe3c-1990-50e9-8694-e77e9c13624b" :answer/id #uuid "35a8fe3c-1990-50e9-8694-e77e9c13624b" :answer/type :answer.type/math :answer/value "\\frac{7}{3y+4}" :db/ensure [:answer/validate]} {:db/id "answer-8533b29d-b9b1-511a-bb70-36d3cde5a702" :answer/id #uuid "8533b29d-b9b1-511a-bb70-36d3cde5a702" :answer/type :answer.type/math :answer/value "\\frac{7}{3y-4}" :db/ensure [:answer/validate]} {:db/id "question-77fe19c1-2d2e-5ba1-9d49-d82b50f369df" :question/id #uuid "77fe19c1-2d2e-5ba1-9d49-d82b50f369df" :question/math-academy-id "q-215810" :question/problem "If $\\frac{7mn+2n}{4}=\\frac{3m}{7},$ then $m=${{field-1}}." :question/worked-solution "We need to isolate all terms with $m$ on one side of the equation. To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{7mn+2n}{4} & =\\frac{3m}{7} \\\\ 7\\cdot (7mn+2n) & =4\\cdot 3m \\\\ 49mn+14n & =12m\\end{aligned}\n$$\n\nNext, we subtract $49mn$ from both sides of the equation:\n\n$$\n\\begin{aligned}49mn+14n & =12m \\\\ 49mn+14n-49mn & =12m-49mn \\\\ 14n & =12m-49mn\\end{aligned}\n$$\n\nNotice that all terms containing $m$ are on the right-hand side, and all terms independent of $m$ are on the left-hand side.\n\nThen, we factor out $m$ from the right-hand side:\n\n$$\n\\begin{aligned}14n & =12m-49mn \\\\ 14n & =(12-49n)m\\end{aligned}\n$$\n\nFinally, we divide both sides by $(12-49n)$ to isolate $m:$\n\n$$\n\\begin{aligned}14n & =(12-49n)m \\\\ \\frac{14n}{12-49n} & =\\frac{\\cancel{(12-49n)}m}{\\cancel{12-49n}} \\\\ \\frac{14n}{12-49n} & =m \\\\ m & =\\frac{14n}{12-49n}\\end{aligned}\n$$\n\n**Note:** This result assumes that $12-49n\\ne 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4f33662-8742-5543-9baf-920fd7c6b4a9"] :db/ensure [:question/validate]} {:db/id "answer-field-f4f33662-8742-5543-9baf-920fd7c6b4a9" :answer-field/id #uuid "f4f33662-8742-5543-9baf-920fd7c6b4a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5a03a7cf-903f-54d3-b7e5-bf17f2b1ce2c" :answer-field/choices ["answer-5a03a7cf-903f-54d3-b7e5-bf17f2b1ce2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a03a7cf-903f-54d3-b7e5-bf17f2b1ce2c" :answer/id #uuid "5a03a7cf-903f-54d3-b7e5-bf17f2b1ce2c" :answer/type :answer.type/math :answer/value "\\frac{14n}{12-49n}" :db/ensure [:answer/validate]} {:db/id "question-5eedbb0b-2f52-5239-8343-cadc5e74eba1" :question/id #uuid "5eedbb0b-2f52-5239-8343-cadc5e74eba1" :question/math-academy-id "q-133899" :question/problem "If $\\frac{2km}{3}=\\frac{k+m}{5},$ then $k=$" :question/worked-solution "We need to isolate all terms with $k$ on one side of the equation. To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{2km}{3} & =\\frac{k+m}{5} \\\\ 5\\cdot 2km & =3\\cdot (k+m) \\\\ 10km & =3k+3m\\end{aligned}\n$$\n\nNext, we subtract $3k$ from both sides of the equation:\n\n$$\n\\begin{aligned}10km & =3k+3m \\\\ 10km-3k & =3k+3m-3k \\\\ 10km-3k & =3m\\end{aligned}\n$$\n\nNotice that all terms containing $k$ are on the left-hand side, and all terms independent of $k$ are on the right-hand side.\n\nThen, we factor out $k$ from the left-hand side:\n\n$$\n\\begin{aligned}10km-3k & =3m \\\\ k(10m-3) & =3m\\end{aligned}\n$$\n\nFinally, we divide both sides by $(10m-3)$ to isolate $k:$\n\n$$\n\\begin{aligned}k(10m-3) & =3m \\\\ \\frac{k\\cancel{(10m-3)}}{\\cancel{10m-3}} & =\\frac{3m}{10m-3} \\\\ k & =\\frac{3m}{10m-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $10m-3\\ne 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e91e9fc2-d906-5396-a41f-f01e1ee236be"] :db/ensure [:question/validate]} {:db/id "answer-field-e91e9fc2-d906-5396-a41f-f01e1ee236be" :answer-field/id #uuid "e91e9fc2-d906-5396-a41f-f01e1ee236be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ce32e74-d9b3-58fa-998a-893bfc6268a9" :answer-field/choices ["answer-24e0251b-e7d9-5216-b40b-a0569fb7444b" "answer-86b91cce-eb4e-5100-836e-cdaa979bba83" "answer-feb11450-ea29-5663-bed0-4e4bfd0d07bb" "answer-d8884393-a5fe-5722-81d1-f68055378b9d" "answer-8ce32e74-d9b3-58fa-998a-893bfc6268a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-24e0251b-e7d9-5216-b40b-a0569fb7444b" :answer/id #uuid "24e0251b-e7d9-5216-b40b-a0569fb7444b" :answer/type :answer.type/math :answer/value "\\frac{10m}{3m+3}" :db/ensure [:answer/validate]} {:db/id "answer-86b91cce-eb4e-5100-836e-cdaa979bba83" :answer/id #uuid "86b91cce-eb4e-5100-836e-cdaa979bba83" :answer/type :answer.type/math :answer/value "\\frac{10m}{3m-3}" :db/ensure [:answer/validate]} {:db/id "answer-feb11450-ea29-5663-bed0-4e4bfd0d07bb" :answer/id #uuid "feb11450-ea29-5663-bed0-4e4bfd0d07bb" :answer/type :answer.type/math :answer/value "\\frac{3m-3}{10m}" :db/ensure [:answer/validate]} {:db/id "answer-d8884393-a5fe-5722-81d1-f68055378b9d" :answer/id #uuid "d8884393-a5fe-5722-81d1-f68055378b9d" :answer/type :answer.type/math :answer/value "\\frac{3m}{10m+3}" :db/ensure [:answer/validate]} {:db/id "answer-8ce32e74-d9b3-58fa-998a-893bfc6268a9" :answer/id #uuid "8ce32e74-d9b3-58fa-998a-893bfc6268a9" :answer/type :answer.type/math :answer/value "\\frac{3m}{10m-3}" :db/ensure [:answer/validate]} {:db/id 17592186180781 :tutorial/content "When solving a multivariable equation for a particular variable, we sometimes have to factor some terms in the equation to reach the solution.\n\nFor example, let's solve the following equation for the variable $d\\mathbin{:}$\n\n$$\n2cd - 3d = 5\n$$\n\nFirst, we factor out $d$ in the expression on the left-hand side. This gives\n\n$$\nd(2c-3) = 5.\n$$\n\nThen, we divide both sides of the equation by $(2c-3)$ to isolate $d\\mathbin{:}$\n\n$$\n\\begin{aligned}d(2c-3) & =5 \\\\ \\frac{d(2c-3)}{2c-3} & =\\frac{5}{2c-3} \\\\ \\frac{d\\cancel{(2c-3)}}{\\cancel{2c-3}} & =\\frac{5}{2c-3} \\\\ d & =\\frac{5}{2c-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2c-3\\neq 0.$" :db/ensure [:tutorial/validate]} {:db/id 17592186179895 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186180332 :step/math-academy-id 952850 :db/ensure [:step/validate]} {:db/id 17592186180333 :step/math-academy-id 952851 :db/ensure [:step/validate]} {:db/id 17592186180334 :step/math-academy-id 952855 :db/ensure [:step/validate]} {:db/id 17592186180335 :step/math-academy-id 952859 :db/ensure [:step/validate]} {:db/id 17592186175983 :knowledge-point/questions ["question-6beef5a1-8cca-5685-897f-0ef5f4dc810f" "question-19e48035-430d-58ef-92e6-a92cd0b0c10e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6beef5a1-8cca-5685-897f-0ef5f4dc810f" :question/id #uuid "6beef5a1-8cca-5685-897f-0ef5f4dc810f" :question/math-academy-id "q-108772" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4{x}^{2}+8xy+4{y}^{2}.\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\n\\operatorname{arctan}⁡(g(x,y))=2x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =4(x+y)^{2}\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =4{z}^{2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=4{z}^{2}+1.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{4{z}^{2}+1}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{4{z}^{2}+1}\\,\\text{d}z & =\\int \\text{d}x \\\\ \\frac{1}{2}\\operatorname{arctan}⁡(2z) & =x+K \\\\ \\operatorname{arctan}⁡(2z) & =2x+C\\end{aligned}\n$$\n\nwhere $C=2K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\operatorname{arctan}⁡(2x+2y)=2x+C\n$$\n\nTherefore, \n\n$$\ng(x,y)=2x+2y.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8cb194d-0fce-5c7b-940d-dfeca915097d"] :db/ensure [:question/validate]} {:db/id "answer-field-f8cb194d-0fce-5c7b-940d-dfeca915097d" :answer-field/id #uuid "f8cb194d-0fce-5c7b-940d-dfeca915097d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3af72acc-2cce-56f5-a188-7b04a5c4baf2" :answer-field/choices ["answer-9e863a95-75ab-5ef2-aebc-4a8458b41bc5" "answer-3af72acc-2cce-56f5-a188-7b04a5c4baf2" "answer-ae7221cb-a28f-522d-9d91-fb383af72303" "answer-a88b2b80-6e46-5b0b-bddf-c37607e4063f" "answer-cd388935-c865-52d2-8792-a4453053f05c"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e863a95-75ab-5ef2-aebc-4a8458b41bc5" :answer/id #uuid "9e863a95-75ab-5ef2-aebc-4a8458b41bc5" :answer/type :answer.type/math :answer/value "1-2x-2y" :db/ensure [:answer/validate]} {:db/id "answer-3af72acc-2cce-56f5-a188-7b04a5c4baf2" :answer/id #uuid "3af72acc-2cce-56f5-a188-7b04a5c4baf2" :answer/type :answer.type/math :answer/value "2x+2y" :db/ensure [:answer/validate]} {:db/id "answer-ae7221cb-a28f-522d-9d91-fb383af72303" :answer/id #uuid "ae7221cb-a28f-522d-9d91-fb383af72303" :answer/type :answer.type/math :answer/value "2x+2y-1" :db/ensure [:answer/validate]} {:db/id "answer-a88b2b80-6e46-5b0b-bddf-c37607e4063f" :answer/id #uuid "a88b2b80-6e46-5b0b-bddf-c37607e4063f" :answer/type :answer.type/math :answer/value "x+y" :db/ensure [:answer/validate]} {:db/id "answer-cd388935-c865-52d2-8792-a4453053f05c" :answer/id #uuid "cd388935-c865-52d2-8792-a4453053f05c" :answer/type :answer.type/math :answer/value "x+y-1" :db/ensure [:answer/validate]} {:db/id "question-19e48035-430d-58ef-92e6-a92cd0b0c10e" :question/id #uuid "19e48035-430d-58ef-92e6-a92cd0b0c10e" :question/math-academy-id "q-149760" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=2+4{x}^{2}-4xy+{y}^{2}.\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2+(2x-y)^{2}\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=2x-y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=2-\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}2-\\,\\frac{\\text{d}z}{\\text{d}x} & =2+{z}^{2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n-\\frac{\\text{d}z}{\\text{d}x}={z}^{2}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}-\\frac{1}{{z}^{2}}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ -\\int \\frac{1}{{z}^{2}}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ \\frac{1}{z} & =x+C\\end{aligned}\n$$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\frac{1}{2x-y}=x+C\n$$\n\nTherefore, \n\n$$\ng(x,y)=\\frac{1}{2x-y}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bc2debc3-d327-56e2-a61e-77f8bfd4b277"] :db/ensure [:question/validate]} {:db/id "answer-field-bc2debc3-d327-56e2-a61e-77f8bfd4b277" :answer-field/id #uuid "bc2debc3-d327-56e2-a61e-77f8bfd4b277" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f23b489-a7f5-50dd-bb19-7df5255ff600" :answer-field/choices ["answer-79433229-f545-56b5-886f-fc91ab9ed976" "answer-32b7eb7e-d784-51cc-a6f7-a2687a072eb0" "answer-41220c31-7cbf-5328-9208-6b8aa44a20f9" "answer-4f23b489-a7f5-50dd-bb19-7df5255ff600" "answer-066638b5-b947-5188-95a4-7fb8fa301ba9"] :db/ensure [:answer-field/validate]} {:db/id "answer-79433229-f545-56b5-886f-fc91ab9ed976" :answer/id #uuid "79433229-f545-56b5-886f-fc91ab9ed976" :answer/type :answer.type/math :answer/value "2x-y+1" :db/ensure [:answer/validate]} {:db/id "answer-32b7eb7e-d784-51cc-a6f7-a2687a072eb0" :answer/id #uuid "32b7eb7e-d784-51cc-a6f7-a2687a072eb0" :answer/type :answer.type/math :answer/value "\\frac{1}{(2x-y)^{2}-1}" :db/ensure [:answer/validate]} {:db/id "answer-41220c31-7cbf-5328-9208-6b8aa44a20f9" :answer/id #uuid "41220c31-7cbf-5328-9208-6b8aa44a20f9" :answer/type :answer.type/math :answer/value "\\frac{1}{(2x-y)^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-4f23b489-a7f5-50dd-bb19-7df5255ff600" :answer/id #uuid "4f23b489-a7f5-50dd-bb19-7df5255ff600" :answer/type :answer.type/math :answer/value "\\frac{1}{2x-y}" :db/ensure [:answer/validate]} {:db/id "answer-066638b5-b947-5188-95a4-7fb8fa301ba9" :answer/id #uuid "066638b5-b947-5188-95a4-7fb8fa301ba9" :answer/type :answer.type/math :answer/value "\\frac{2}{x-y}" :db/ensure [:answer/validate]} {:db/id 17592186177006 :tutorial/content "Suppose that we're given a differential equation of the form\n\n$$\ny' = F(x,y).\n$$\n\nBy factoring the function $F(x,y),$ we can often convert this differential equation to one that is of the form \n\n$$\ny' = f ( a x + b y ),\n$$\n\nwhere $a$ and $b$ are real constants. Then, using the substitution $z= ax+by,$ we can convert the equation to a separable differential equation. \n\nTo illustrate, let's consider the differential equation\n\n$$\ny'  = 9x^2 - 6xy + y^2.\n$$\n\nNotice that the right-hand side is a perfect square. So, we factor it as follows:\n\n$$\n\\begin{aligned}{y}^{′}=(3x-y)^{2}\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz = 3x - y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x} = 3 - \\,\\dfrac{\\textrm{d}y}{\\textrm{d}x} \n\\quad \\Rightarrow\\quad \n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = 3 - \\,\\dfrac{\\textrm{d}z}{\\textrm{d}x}\n$$\n\nTherefore, we can write our equation in terms of $z$ as\n\n$$\n3 - \\,\\dfrac{\\textrm{d}z}{\\textrm{d}x} = z^2,\n$$\n\nwhich simplifies to\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x}   = 3-z^2.\n$$\n\nWe now have a separable differential equation." :db/ensure [:tutorial/validate]} {:db/id 17592186176146 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186096657 :knowledge-point/questions ["question-20bd28d6-3021-5539-a5f9-9ec2d307a221"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096390 :question/problem "If $f(x) = 12 \\cdot 2^{x},$ then $f(-4)=$" :question/worked-solution "To calculate $f(-4),$ we substitute $x=-4$ into the expression for $f(x).$ This gives\n\n$$\n\\begin{aligned}f(-4) & =12\\cdot {2}^{-4} \\\\  & =12\\cdot \\frac{1}{{2}^{4}} \\\\  & =12\\cdot \\frac{1}{16} \\\\  & =\\frac{12}{16} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096658 :knowledge-point/questions ["question-169115e9-c4da-5b2d-98db-fdbf90bfcfbf" "question-b0a1af6d-481b-5cb9-88d9-fa115158484b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096391 :question/worked-solution "To get the mass of the isotope after $3$ years, we evaluate the function at $t=3.$ Substituting $t=3$ into the function $M(t)$ gives\n\n$$\n\\begin{aligned}M & =128{(\\frac{1}{4})}^{t} \\\\  & =128{(\\frac{1}{4})}^{3} \\\\  & =128\\cdot \\frac{{1}^{3}}{{4}^{3}} \\\\  & =128\\cdot \\frac{1}{64} \\\\  & =\\frac{128}{64} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, after $3$ years, there will be $2$ grams of isotope remaining." :db/ensure [:question/validate]} {:db/id 17592186096659 :knowledge-point/questions ["question-d094ad0f-c26b-57d4-8a3d-3a131e61b0c8" "question-c97061a8-e888-5c8e-ae09-c8d25cf5d2a1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096392 :question/problem "Solve for $C$ given that $y(t) = C \\cdot \\left(\\dfrac{1}{2}\\right)^{t}$ and $y(5)=1.$" :question/worked-solution "We substitute $t=5$ and $y(t)=1$ into the expression for $y(t),$ and get\n\n$$\n\\begin{aligned}1 & =C\\cdot {(\\frac{1}{2})}^{5} \\\\ 1 & =C\\cdot \\frac{{1}^{5}}{{2}^{5}} \\\\ 1 & =C\\cdot \\frac{1}{32} \\\\ 1\\cdot 32 & =C \\\\ 32 & =C.\\end{aligned}\n$$\n\nTherefore, $C=32.$" :db/ensure [:question/validate]} {:db/id 17592186096660 :knowledge-point/questions ["question-a6431deb-d4ee-50b8-b78e-d09da4574bf6" "question-f6033ad1-0d99-515b-be18-2f73585eb731"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096393 :question/problem "Given that $P(x) = 2 \\cdot 5^{3x},$ find $x$ such that $P(x)=250.$" :question/worked-solution "First we substitute $P(x)=250$ into the equation:\n\n$$\n2 \\cdot 5^{3x}= 250\n$$\n\nWe can divide both sides of the equation by the constant factor of $2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{2\\cdot {5}^{3x}}{2} & =\\frac{250}{2} \\\\ \\frac{\\cancel{2}\\cdot {5}^{3x}}{\\cancel{2}} & =125 \\\\ {5}^{3x} & =125\\end{aligned}\n$$\n\nFinally, we solve for $x,$ using the fact that $125$ is a power of $5\\mathbin{:}$\n\n$$\n\\begin{aligned}{5}^{3x} & ={5}^{3} \\\\ 3x & =3 \\\\ x & =1\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-20bd28d6-3021-5539-a5f9-9ec2d307a221" :question/id #uuid "20bd28d6-3021-5539-a5f9-9ec2d307a221" :question/math-academy-id "q-61716" :question/problem "If $h(t)=128\\cdot {(\\frac{1}{4})}^{t},$ then $h(3)=$" :question/worked-solution "To calculate $h(3),$ we substitute $t=3$ into the expression for $h(t).$ This gives\n\n$$\n\\begin{aligned}h(3) & =128\\cdot {(\\frac{1}{4})}^{3} \\\\  & =128\\cdot (\\frac{{1}^{3}}{{4}^{3}}) \\\\  & =128\\cdot \\frac{1}{64} \\\\  & =\\frac{128}{64} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d5a7042c-7e1e-5fcb-b886-9667e5b24c65"] :db/ensure [:question/validate]} {:db/id "answer-field-d5a7042c-7e1e-5fcb-b886-9667e5b24c65" :answer-field/id #uuid "d5a7042c-7e1e-5fcb-b886-9667e5b24c65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69d9183c-bdff-521b-b708-8cb79202331f" :answer-field/choices ["answer-4664d354-13a3-5b8f-8c42-976b3bfeddab" "answer-42a21799-c311-5f42-890e-d2bbef261f3d" "answer-69d9183c-bdff-521b-b708-8cb79202331f" "answer-a9f051b2-54c1-5939-9ae0-73a9731038be" "answer-9d12f52e-2750-5d73-b590-8503