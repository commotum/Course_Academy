nswer/value "images/a2/a213dd6561609a4f9e91ea6f0a45f7ce63686acd74e58727c027dada5bb3ba66.png" :db/ensure [:answer/validate]} {:db/id "answer-69cb04c6-efca-5548-a928-c26fd1180f2d" :answer/id #uuid "69cb04c6-efca-5548-a928-c26fd1180f2d" :answer/type :answer.type/image :answer/value "images/aa/aa7c75e476c336fe687d703351b8a0c5becb0dce9d296f9ad3858178175f0983.png" :db/ensure [:answer/validate]} {:db/id "answer-9f66844d-7df7-5ada-9c5b-08980ffc827e" :answer/id #uuid "9f66844d-7df7-5ada-9c5b-08980ffc827e" :answer/type :answer.type/image :answer/value "images/dd/dd767429c321d02dc6edf559127ff8ecc733bd5ecdf243b79f7b671fd78085c4.png" :db/ensure [:answer/validate]} {:db/id "question-244776d4-c112-511f-a089-aa2567ad8e69" :question/id #uuid "244776d4-c112-511f-a089-aa2567ad8e69" :question/math-academy-id "q-123880" :question/problem "Which of the following regions is connected?" :question/worked-solution "A region $D$ is connected if every pair of points in $D$ can be joined by a smooth curve or a path in $D.$\n\nAmong the given options, the only one that satisfies this definition is the following:\n\n![](images/4d/4d7d916e62541ad8d41f6043c0d0e2f511f0b79d036f6fce6b4ce4500a357023.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cd48dad3-3dbe-579f-a0a5-0256757f62c2"] :db/ensure [:question/validate]} {:db/id "answer-field-cd48dad3-3dbe-579f-a0a5-0256757f62c2" :answer-field/id #uuid "cd48dad3-3dbe-579f-a0a5-0256757f62c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aac1dbad-2a8f-5c29-9358-0a80b2c2688f" :answer-field/choices ["answer-aac1dbad-2a8f-5c29-9358-0a80b2c2688f" "answer-fdf54361-0177-516c-b53c-a71ef9d79220" "answer-2bce539c-19ae-54e9-9199-a573ddfc5136" "answer-fdbc8357-c53c-5b1e-8b1c-081514832abc" "answer-42652284-7f15-59fe-b549-1dd2fe492f74"] :db/ensure [:answer-field/validate]} {:db/id "answer-aac1dbad-2a8f-5c29-9358-0a80b2c2688f" :answer/id #uuid "aac1dbad-2a8f-5c29-9358-0a80b2c2688f" :answer/type :answer.type/image :answer/value "images/4d/4d7d916e62541ad8d41f6043c0d0e2f511f0b79d036f6fce6b4ce4500a357023.png" :db/ensure [:answer/validate]} {:db/id "answer-fdf54361-0177-516c-b53c-a71ef9d79220" :answer/id #uuid "fdf54361-0177-516c-b53c-a71ef9d79220" :answer/type :answer.type/image :answer/value "images/61/6116e0dbea0e25ca27ea3ebd23356b0dd3d4ded0c2baf1ad4410f786f7b7bc6f.png" :db/ensure [:answer/validate]} {:db/id "answer-2bce539c-19ae-54e9-9199-a573ddfc5136" :answer/id #uuid "2bce539c-19ae-54e9-9199-a573ddfc5136" :answer/type :answer.type/image :answer/value "images/6f/6f459a98398e9327b232f734b2e819798d3dcc6d66354edcd7d350aea8443a57.png" :db/ensure [:answer/validate]} {:db/id "answer-fdbc8357-c53c-5b1e-8b1c-081514832abc" :answer/id #uuid "fdbc8357-c53c-5b1e-8b1c-081514832abc" :answer/type :answer.type/image :answer/value "images/c4/c43091934c162f690449769be8fa381b1ce5bcab3502883e56e4814fd4ace65a.png" :db/ensure [:answer/validate]} {:db/id "answer-42652284-7f15-59fe-b549-1dd2fe492f74" :answer/id #uuid "42652284-7f15-59fe-b549-1dd2fe492f74" :answer/type :answer.type/image :answer/value "images/cb/cb0e50751bed01a413a8417758c82a64aea7c5bf3a9a508347945bcb9681b01f.png" :db/ensure [:answer/validate]} {:db/id "question-353c7243-8109-54a9-8124-e25ba2a61d98" :question/id #uuid "353c7243-8109-54a9-8124-e25ba2a61d98" :question/math-academy-id "q-98680" :question/problem "Which of the following is *not* a simply connected region?" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/46/46305c070e2563b4dacf8b31c88c46b860f003b20ffdff608a5485c09a91bd11.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/a0/a0459ddbabbd810e43db084f5dd174437340914b53ed227f6ef7ce2e3a0fc383.png)\n\nAmong the given options, the only one that does not satisfy this definition is the following:  \n\n![](images/37/37597a2cecae00cca3eacec7265913070de9343be6afb9108644d6c8d0c1d93b.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4384a499-6a6b-50cc-85bd-25bcfa32de9f"] :db/ensure [:question/validate]} {:db/id "answer-field-4384a499-6a6b-50cc-85bd-25bcfa32de9f" :answer-field/id #uuid "4384a499-6a6b-50cc-85bd-25bcfa32de9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6730525b-4a51-5711-a506-cd2706e73be4" :answer-field/choices ["answer-cecc3d11-f1e4-50e7-9dee-b9454f776c20" "answer-6730525b-4a51-5711-a506-cd2706e73be4" "answer-01d973c4-bea4-5243-9ff2-5613c21e23a1" "answer-830b2441-7bb1-5d59-9a62-feb78c7e6ef1" "answer-578615f1-2180-5a2b-9d97-63ce953958dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-cecc3d11-f1e4-50e7-9dee-b9454f776c20" :answer/id #uuid "cecc3d11-f1e4-50e7-9dee-b9454f776c20" :answer/type :answer.type/image :answer/value "images/2b/2bf599bb1c6bb72971ce9aa76caad4499396d5ebd50d694b3deec2e63b5cc1df.png" :db/ensure [:answer/validate]} {:db/id "answer-6730525b-4a51-5711-a506-cd2706e73be4" :answer/id #uuid "6730525b-4a51-5711-a506-cd2706e73be4" :answer/type :answer.type/image :answer/value "images/37/37597a2cecae00cca3eacec7265913070de9343be6afb9108644d6c8d0c1d93b.png" :db/ensure [:answer/validate]} {:db/id "answer-01d973c4-bea4-5243-9ff2-5613c21e23a1" :answer/id #uuid "01d973c4-bea4-5243-9ff2-5613c21e23a1" :answer/type :answer.type/image :answer/value "images/52/52bc6978455d7ad3ea0b996fc86490265d0e66adcdc7a80b417d543a28c39891.png" :db/ensure [:answer/validate]} {:db/id "answer-830b2441-7bb1-5d59-9a62-feb78c7e6ef1" :answer/id #uuid "830b2441-7bb1-5d59-9a62-feb78c7e6ef1" :answer/type :answer.type/image :answer/value "images/61/61121fd2f10227f127984cfa0ca6954fb97d0e70bf677244b83e2f0f536ab551.png" :db/ensure [:answer/validate]} {:db/id "answer-578615f1-2180-5a2b-9d97-63ce953958dc" :answer/id #uuid "578615f1-2180-5a2b-9d97-63ce953958dc" :answer/type :answer.type/image :answer/value "images/e4/e40f9a1f3c3060ccaf063728e39b117753e128fbbd6a3c06cac9439ed47b222a.png" :db/ensure [:answer/validate]} {:db/id "question-db6c8509-7f18-5c65-821d-f6d09e6d4e13" :question/id #uuid "db6c8509-7f18-5c65-821d-f6d09e6d4e13" :question/math-academy-id "q-98695" :question/problem "![](images/23/2304f9b9080a8b3ec4ff10284cee8e01ec8dff54fb879f7ed55dd7a3f80e2b23.png)\n\nWhich of the regions shown above are simply connected?" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nWith that in mind, let's examine each of the regions:  \n\n- Region I is not simply connected. Instead, this is a region that consists of two pieces (it's not connected).\n\n- Region II is not simply connected. Instead, this is a connected region that contains a hole.\n\n- Region III is simply connected. This is a connected region that does not contain holes.\n\n- Region IV is simply connected. This is a connected region that does not contain holes.\n\nTherefore, the correct answer is \"III and IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4a7b56f9-4f69-5483-8998-cc50c72ca12a"] :db/ensure [:question/validate]} {:db/id "answer-field-4a7b56f9-4f69-5483-8998-cc50c72ca12a" :answer-field/id #uuid "4a7b56f9-4f69-5483-8998-cc50c72ca12a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5e040eb6-7f07-520b-9885-f2312cee4b7c" :answer-field/choices ["answer-bd604b74-ca77-53a0-8727-e78e594cc6cd" "answer-00693d44-168a-59ae-81ba-7237813361a7" "answer-a7780b16-691d-528d-a79d-418312672210" "answer-5e040eb6-7f07-520b-9885-f2312cee4b7c" "answer-8f2829aa-b1bc-5d42-a9ba-b1777c71d30e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd604b74-ca77-53a0-8727-e78e594cc6cd" :answer/id #uuid "bd604b74-ca77-53a0-8727-e78e594cc6cd" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-00693d44-168a-59ae-81ba-7237813361a7" :answer/id #uuid "00693d44-168a-59ae-81ba-7237813361a7" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-a7780b16-691d-528d-a79d-418312672210" :answer/id #uuid "a7780b16-691d-528d-a79d-418312672210" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-5e040eb6-7f07-520b-9885-f2312cee4b7c" :answer/id #uuid "5e040eb6-7f07-520b-9885-f2312cee4b7c" :answer/type :answer.type/text :answer/value "III and IV only" :db/ensure [:answer/validate]} {:db/id "answer-8f2829aa-b1bc-5d42-a9ba-b1777c71d30e" :answer/id #uuid "8f2829aa-b1bc-5d42-a9ba-b1777c71d30e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-6a1d02fe-8171-5afa-b624-bbcbed75b5b0" :question/id #uuid "6a1d02fe-8171-5afa-b624-bbcbed75b5b0" :question/math-academy-id "q-98687" :question/problem "Which of the following is *not* a simply connected region?" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/46/46305c070e2563b4dacf8b31c88c46b860f003b20ffdff608a5485c09a91bd11.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/a0/a0459ddbabbd810e43db084f5dd174437340914b53ed227f6ef7ce2e3a0fc383.png)\n\nAmong the given options, the only one that does not satisfy this definition is the following: \n\n![](images/65/65e1c034f836802bb8127e754f0e1cb303144468b041d51da2ee1b8a89de1132.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1313a534-7913-5042-9bc0-6c44d0135939"] :db/ensure [:question/validate]} {:db/id "answer-field-1313a534-7913-5042-9bc0-6c44d0135939" :answer-field/id #uuid "1313a534-7913-5042-9bc0-6c44d0135939" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7d6e9b6f-a94b-5109-8c6a-97935704bcdf" :answer-field/choices ["answer-5a9928f1-71c1-540b-85e1-01ff04dab2b7" "answer-fdfd2f97-0aa0-539a-be6f-7097c1940aee" "answer-7d6e9b6f-a94b-5109-8c6a-97935704bcdf" "answer-9f7781f5-0705-541a-a940-98edef386fd6" "answer-4b8a5532-5c40-544b-a662-5333cce8382a"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a9928f1-71c1-540b-85e1-01ff04dab2b7" :answer/id #uuid "5a9928f1-71c1-540b-85e1-01ff04dab2b7" :answer/type :answer.type/image :answer/value "images/54/54a73ee1a01be78d548a7e609a05538754e488f57b0a755e7e5f6e2264e14a74.png" :db/ensure [:answer/validate]} {:db/id "answer-fdfd2f97-0aa0-539a-be6f-7097c1940aee" :answer/id #uuid "fdfd2f97-0aa0-539a-be6f-7097c1940aee" :answer/type :answer.type/image :answer/value "images/5f/5fce5e6fb02581d530afa04ae596290eebeb84265131b397a11621160170f20b.png" :db/ensure [:answer/validate]} {:db/id "answer-7d6e9b6f-a94b-5109-8c6a-97935704bcdf" :answer/id #uuid "7d6e9b6f-a94b-5109-8c6a-97935704bcdf" :answer/type :answer.type/image :answer/value "images/65/65e1c034f836802bb8127e754f0e1cb303144468b041d51da2ee1b8a89de1132.png" :db/ensure [:answer/validate]} {:db/id "answer-9f7781f5-0705-541a-a940-98edef386fd6" :answer/id #uuid "9f7781f5-0705-541a-a940-98edef386fd6" :answer/type :answer.type/image :answer/value "images/94/94e4f7d31dddfd2b960b027848328d1223899ae3172ec2192bc3bd3fc3c0411d.png" :db/ensure [:answer/validate]} {:db/id "answer-4b8a5532-5c40-544b-a662-5333cce8382a" :answer/id #uuid "4b8a5532-5c40-544b-a662-5333cce8382a" :answer/type :answer.type/image :answer/value "images/c0/c0add6c5feca5255760a8bcbd84f68cb425263c857379cb4f1415e8b4e199753.png" :db/ensure [:answer/validate]} {:db/id 17592186172291 :question/problem "Which of the following regions are simply connected?\n\nI. $\\{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (1,1)\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,|\\,2x-y\\ne 0\\}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is simply connected. It's a plane region without holes.\n\n- Region II is *not* simply connected since it's a plane region with a hole at $(1,1).$\n\n- Region III is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the straight line $y=2x.$ Thus, the region is formed by two disjoint half-planes and, therefore, is not even a connected region.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186168609 :answer-field/correct 17592186168613 :db/ensure [:answer-field/validate]} {:db/id "question-7361f82f-c91c-52b9-80ec-852a74fe03bc" :question/id #uuid "7361f82f-c91c-52b9-80ec-852a74fe03bc" :question/math-academy-id "q-124773" :question/problem "Which of the following regions are simply connected?\n\nI. $\\{(x,y)\\in {R}^{2}\\,|\\,y+2x\\ge 1\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,|\\,y-2x\\ne 1\\}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is simply connected. Indeed, it is the half-plane $y\\ge -2x+1.$ So,   it's a plane region without holes,\n\n- Region II is simply connected.  It's a plane region (a circle) without holes.\n\n- Region III is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the straight line $y=2x+1.$ Thus, the region is formed by two disjoint half-planes and, therefore, is not even a connected region.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bbd56075-39b7-59a8-b93d-bcfc68b83760"] :db/ensure [:question/validate]} {:db/id "answer-field-bbd56075-39b7-59a8-b93d-bcfc68b83760" :answer-field/id #uuid "bbd56075-39b7-59a8-b93d-bcfc68b83760" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45122bac-b3b8-5e27-afee-d630a49ce537" :answer-field/choices ["answer-45122bac-b3b8-5e27-afee-d630a49ce537" "answer-f7489938-f03a-5f2b-b530-6e9e1bed624b" "answer-ce3274e2-524f-5cf1-9465-3aafe1e0f1a1" "answer-f527e70a-5ed7-53da-91f5-358e6a505020" "answer-19c71b83-4367-5691-97de-b0703bcb7dd3"] :db/ensure [:answer-field/validate]} {:db/id "answer-45122bac-b3b8-5e27-afee-d630a49ce537" :answer/id #uuid "45122bac-b3b8-5e27-afee-d630a49ce537" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f7489938-f03a-5f2b-b530-6e9e1bed624b" :answer/id #uuid "f7489938-f03a-5f2b-b530-6e9e1bed624b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-ce3274e2-524f-5cf1-9465-3aafe1e0f1a1" :answer/id #uuid "ce3274e2-524f-5cf1-9465-3aafe1e0f1a1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f527e70a-5ed7-53da-91f5-358e6a505020" :answer/id #uuid "f527e70a-5ed7-53da-91f5-358e6a505020" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-19c71b83-4367-5691-97de-b0703bcb7dd3" :answer/id #uuid "19c71b83-4367-5691-97de-b0703bcb7dd3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186172179 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186133786 :knowledge-point/questions ["question-f89a34e2-edc3-5894-bae7-80f53ccb3dc4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186326795 :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 4 \\\\ 3\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set \n$\\{{a}_{1},{a}_{2}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 2+4\\cdot 1+3\\cdot 2}{{2}^{2}+{1}^{2}+{2}^{2}}{a}_{1}=\\frac{4}{3}[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 1+4\\cdot (-4)+3\\cdot 1}{{1}^{2}+(-4)^{2}+{1}^{2}}{a}_{2}=-\\frac{2}{3}[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{4}{3}[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-\\frac{2}{3}[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{3}(4[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-2[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186326864 :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}4 \\\\ 5 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}5 \\\\ -4 \\\\ 0\\end{aligned}],\\,\\,x=[\\begin{aligned}20 \\\\ -20 \\\\ 0\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{20\\cdot 4+(-20)\\cdot 5+0\\cdot 0}{{4}^{2}+{5}^{2}+{0}^{2}}{a}_{1}=-\\frac{20}{41}[\\begin{aligned}4 \\\\ 5 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{20\\cdot 5+(-20)\\cdot (-4)+0\\cdot 0}{{5}^{2}+(-4)^{2}+{0}^{2}}{a}_{2}=\\frac{180}{41}[\\begin{aligned}5 \\\\ -4 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =-\\frac{20}{41}[\\begin{aligned}4 \\\\ 5 \\\\ 0\\end{aligned}]+\\frac{180}{41}[\\begin{aligned}5 \\\\ -4 \\\\ 0\\end{aligned}] \\\\  & =\\frac{20}{41}(-[\\begin{aligned}4 \\\\ 5 \\\\ 0\\end{aligned}]+9[\\begin{aligned}5 \\\\ -4 \\\\ 0\\end{aligned}]) \\\\  & =[\\begin{aligned}20 \\\\ -20 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n**Note:** The projection is the vector $x$ itself. This means that $x$ can be written as a linear combination of $\\{{a}_{1},{a}_{2}\\}.$ In other words, $x$ lies in the subspace spanned by $\\{{a}_{1},{a}_{2}\\}.$" :db/ensure [:question/validate]} {:db/id 17592186394181 :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ -5 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}],\\,\\,x=[\\begin{aligned}4 \\\\ 6 \\\\ 3 \\\\ -17\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\},$ $\\text{Span}\\{{a}_{2}\\},$ and $\\text{Span}\\{{a}_{3}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{4\\cdot 1+6\\cdot 1+3\\cdot 0+(-17)\\cdot 2}{{1}^{2}+{1}^{2}+{0}^{2}+(-2)^{2}}{a}_{1}=-\\frac{24}{6}[\\begin{aligned}1 \\\\ 1 \\\\ 0 \\\\ 2\\end{aligned}]=[\\begin{aligned}-4 \\\\ -4 \\\\ 0 \\\\ -8\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{4\\cdot 3+6\\cdot (-5)+3\\cdot 0+(-17)\\cdot 1}{{3}^{2}+(-5)^{2}+{0}^{2}+{1}^{2}}{a}_{2}=-\\frac{35}{35}[\\begin{aligned}3 \\\\ -5 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-3 \\\\ 5 \\\\ 0 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{4\\cdot 11+6\\cdot 5+3\\cdot 0+(-17)\\cdot (-8)}{{11}^{2}+{5}^{2}+{0}^{2}+(-8)^{2}}{a}_{2}=\\frac{210}{210}[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}]=[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}-4 \\\\ -4 \\\\ 0 \\\\ -8\\end{aligned}]+[\\begin{aligned}-3 \\\\ 5 \\\\ 0 \\\\ -1\\end{aligned}]+[\\begin{aligned}11 \\\\ 5 \\\\ 0 \\\\ -8\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 6 \\\\ 0 \\\\ -17\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186351338 :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{v,w\\}$ in ${R}^{3}.$ \nAnd, since the set $\\{v,w\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-9)\\cdot 4+2\\cdot (-4)+31\\cdot 2}{{4}^{2}+(-4)^{2}+{2}^{2}}v=\\frac{1}{2}[\\begin{aligned}4 \\\\ -4 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-9)\\cdot 3+2\\cdot 2+31\\cdot (-2)}{{3}^{2}+{2}^{2}+(-2)^{2}}w=-5[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}4 \\\\ -4 \\\\ 2\\end{aligned}]-5[\\begin{aligned}3 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]+[\\begin{aligned}-15 \\\\ -10 \\\\ 10\\end{aligned}] \\\\  & =[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-f89a34e2-edc3-5894-bae7-80f53ccb3dc4" :question/id #uuid "f89a34e2-edc3-5894-bae7-80f53ccb3dc4" :question/math-academy-id "q-140358" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ -2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}3 \\\\ 5 \\\\ 5\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set $\\{{a}_{1},{a}_{2}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{{a}_{1},{a}_{2}\\}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}\\{{a}_{1}\\}$ and $\\text{Span}\\{{a}_{2}\\}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{3\\cdot (-1)+5\\cdot 1+5\\cdot (-1)}{(-1)^{2}+{1}^{2}+(-1)^{2}}{a}_{1}=-[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{3\\cdot (-3)+5\\cdot (-2)+5\\cdot 1}{(-3)^{2}+(-2)^{2}+{1}^{2}}{a}_{2}=-[\\begin{aligned}-3 \\\\ -2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =-[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}-3 \\\\ -2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]+[\\begin{aligned}3 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3d54e8d7-80fd-5ba0-9aa1-3d3b5a19b628"] :db/ensure [:question/validate]} {:db/id "answer-field-3d54e8d7-80fd-5ba0-9aa1-3d3b5a19b628" :answer-field/id #uuid "3d54e8d7-80fd-5ba0-9aa1-3d3b5a19b628" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d59c73e-d224-5351-a08f-52f78cacb39d" :answer-field/choices ["answer-f226fba2-029a-5fa4-9d8e-99c484c6060d" "answer-3370feb1-25a8-5eb8-998f-be63238ef832" "answer-5e7d0310-d3df-5241-be69-d1e2294cca30" "answer-47d5bef5-7be7-5c78-9379-5b4b569a0775" "answer-2d59c73e-d224-5351-a08f-52f78cacb39d"] :db/ensure [:answer-field/validate]} {:db/id "answer-f226fba2-029a-5fa4-9d8e-99c484c6060d" :answer/id #uuid "f226fba2-029a-5fa4-9d8e-99c484c6060d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ -3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3370feb1-25a8-5eb8-998f-be63238ef832" :answer/id #uuid "3370feb1-25a8-5eb8-998f-be63238ef832" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5e7d0310-d3df-5241-be69-d1e2294cca30" :answer/id #uuid "5e7d0310-d3df-5241-be69-d1e2294cca30" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-47d5bef5-7be7-5c78-9379-5b4b569a0775" :answer/id #uuid "47d5bef5-7be7-5c78-9379-5b4b569a0775" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2d59c73e-d224-5351-a08f-52f78cacb39d" :answer/id #uuid "2d59c73e-d224-5351-a08f-52f78cacb39d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "activity-6ef06c9d-d12a-5037-973e-b9195cf2afa0" :activity/id #uuid "6ef06c9d-d12a-5037-973e-b9195cf2afa0" :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Orthogonal Bases)" :activity/type :activity.type/review :activity/scope 17592186050009 :activity/course 17592186046658 :activity/steps ["step-de60a247-dd06-59b9-90c3-60ecb2981814" "step-81655d18-e7d9-5b1a-ac12-3615ca9b80de" "step-9da9d475-df53-52af-86b4-ac0c78059fca" "step-07f5fb55-5a96-560a-81bc-2ee4ef08eb3a" "step-b5a742f9-e91b-50dd-b068-71c2aa9c6666"] :activity/first-step "step-de60a247-dd06-59b9-90c3-60ecb2981814" :db/ensure [:activity/validate]} {:db/id "step-de60a247-dd06-59b9-90c3-60ecb2981814" :step/id #uuid "de60a247-dd06-59b9-90c3-60ecb2981814" :step/content 17592186326795 :step/next "step-81655d18-e7d9-5b1a-ac12-3615ca9b80de" :db/ensure [:step/validate]} {:db/id "step-81655d18-e7d9-5b1a-ac12-3615ca9b80de" :step/id #uuid "81655d18-e7d9-5b1a-ac12-3615ca9b80de" :step/content 17592186326864 :step/next "step-9da9d475-df53-52af-86b4-ac0c78059fca" :db/ensure [:step/validate]} {:db/id "step-9da9d475-df53-52af-86b4-ac0c78059fca" :step/id #uuid "9da9d475-df53-52af-86b4-ac0c78059fca" :step/content 17592186394181 :step/next "step-07f5fb55-5a96-560a-81bc-2ee4ef08eb3a" :db/ensure [:step/validate]} {:db/id "step-07f5fb55-5a96-560a-81bc-2ee4ef08eb3a" :step/id #uuid "07f5fb55-5a96-560a-81bc-2ee4ef08eb3a" :step/content 17592186351338 :step/next "step-b5a742f9-e91b-50dd-b068-71c2aa9c6666" :db/ensure [:step/validate]} {:db/id "step-b5a742f9-e91b-50dd-b068-71c2aa9c6666" :step/id #uuid "b5a742f9-e91b-50dd-b068-71c2aa9c6666" :step/content "question-f89a34e2-edc3-5894-bae7-80f53ccb3dc4" :db/ensure [:step/validate]} {:db/id 17592186179626 :knowledge-point/questions ["question-8bf4f7f2-b45d-5aef-8d47-16e8d1e1f900" "question-0b499b93-e0d8-519c-9fd8-51ac13674a1f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179465 :question/problem "Solve the equation $5ky-13=7$ for the variable $y.$" :question/worked-solution "We need to isolate $y.$ To do this, we first add $13$ to both sides of the equation:\n\n$$\n\\begin{aligned}5ky-13 & =7 \\\\ 5ky-13+13 & =7+13 \\\\ 5ky & =20\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $5k\\mathbin{:}$\n\n$$\n\\begin{aligned}5ky & =20 \\\\ \\frac{5ky}{5k} & =\\frac{20}{5k} \\\\ \\frac{\\cancel{5k}y}{\\cancel{5k}} & =\\frac{20}{5k} \\\\ y & =\\frac{20}{5k}\\end{aligned}\n$$\n\nFinally, we can further simplify the right-hand side:\n\n$$\n\\begin{aligned}y & =\\frac{5\\cdot 4}{5k} \\\\ y & =\\frac{\\cancel{5}\\cdot 4}{\\cancel{5}k} \\\\ y & =\\frac{4}{k}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186179627 :knowledge-point/questions ["question-76378346-6bd7-5f90-bb11-bc03bf523eef" "question-06c556aa-e44d-528e-81fb-0f187fd8faf9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179466 :question/problem "Solve the equation $\\dfrac 34 kx + 9 = 2$ for the variable $x.$" :question/worked-solution "First, we multiply both sides of the equation by $4$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\\frac{3}{4}kx+9 & =2 \\\\ 4\\cdot (\\frac{3}{4}kx+9) & =4\\cdot 2 \\\\ 3kx+36 & =8\\end{aligned}\n$$\n\nNow, we need to isolate $x.$ To do this, we first subtract $36$ from both sides of the equation:\n\n$$\n\\begin{aligned}3kx+36 & =8 \\\\ 3kx+36-36 & =8-36 \\\\ 3kx & =-28\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $3k\\mathbin{:}$\n\n$$\n\\begin{aligned}3kx & =-28 \\\\ \\frac{3kx}{3k} & =\\frac{-28}{3k} \\\\ \\frac{\\cancel{3k}x}{\\cancel{3k}} & =\\frac{-28}{3k} \\\\ x & =-\\frac{28}{3k}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186179628 :knowledge-point/questions ["question-3c956651-7831-59be-948a-98c8e15c7d28" "question-821390a9-15de-5be4-b110-42ad4543a1a6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179468 :question/problem "Solve the equation $\\dfrac{1}{3} = -\\dfrac{ax}{5}$ for the variable $x.$" :question/worked-solution "We need to isolate $x.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{1}{3} & =-\\frac{ax}{5} \\\\ \\frac{1}{3} & =\\frac{-ax}{5} \\\\ 5\\cdot 1 & =3\\cdot (-ax) \\\\ 5 & =-3ax\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $-3a\\mathbin{:}$\n\n$$\n\\begin{aligned}5 & =-3ax \\\\ \\frac{5}{-3a} & =\\frac{-3ax}{-3a} \\\\ \\frac{5}{-3a} & =\\frac{\\cancel{-3a}x}{\\cancel{-3a}} \\\\ -\\frac{5}{3a} & =x \\\\ x & =-\\frac{5}{3a}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-8bf4f7f2-b45d-5aef-8d47-16e8d1e1f900" :question/id #uuid "8bf4f7f2-b45d-5aef-8d47-16e8d1e1f900" :question/math-academy-id "q-214561" :question/problem "If $5=-14ab-2,$ then $a=${{field-1}}." :question/worked-solution "We need to isolate $a.$ To do this, we first add $2$ to both sides of the equation:\n\n$$\n\\begin{aligned}5 & =-14ab-2 \\\\ 5+2 & =-14ab-2+2 \\\\ 7 & =-14ab\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $-14b:$\n\n$$\n\\begin{aligned}7 & =-14ab \\\\ \\frac{7}{-14b} & =\\frac{-14ab}{-14b} \\\\ \\frac{7}{-14b} & =\\frac{\\cancel{-14b}a}{\\cancel{-14b}} \\\\ -\\frac{7}{14b} & =a\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}-\\frac{7}{7\\cdot 2b} & =a \\\\ -\\frac{\\cancel{7}}{\\cancel{7}\\cdot 2b} & =a \\\\ -\\frac{1}{2b} & =a \\\\ a & =-\\frac{1}{2b}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-33e39e61-5c33-5c26-af08-85223061bd41"] :db/ensure [:question/validate]} {:db/id "answer-field-33e39e61-5c33-5c26-af08-85223061bd41" :answer-field/id #uuid "33e39e61-5c33-5c26-af08-85223061bd41" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c3618254-a807-5bc1-b852-b2d8982c3e9b" :answer-field/choices ["answer-c3618254-a807-5bc1-b852-b2d8982c3e9b"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3618254-a807-5bc1-b852-b2d8982c3e9b" :answer/id #uuid "c3618254-a807-5bc1-b852-b2d8982c3e9b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2b}" :db/ensure [:answer/validate]} {:db/id "question-0b499b93-e0d8-519c-9fd8-51ac13674a1f" :question/id #uuid "0b499b93-e0d8-519c-9fd8-51ac13674a1f" :question/math-academy-id "q-214556" :question/problem "If $2=-5ab,$ then $a=${{field-1}}." :question/worked-solution "We need to isolate $a.$ To do this, we divide both sides of the equation by $-5b:$\n\n$$\n\\begin{aligned}2 & =-5ab \\\\ \\frac{2}{-5b} & =\\frac{-5ab}{-5b} \\\\ \\frac{2}{-5b} & =\\frac{\\cancel{-5b}a}{\\cancel{-5b}} \\\\ -\\frac{2}{5b} & =a \\\\ a & =-\\frac{2}{5b}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-83214493-8a7a-53b4-a9de-c3bd71553689"] :db/ensure [:question/validate]} {:db/id "answer-field-83214493-8a7a-53b4-a9de-c3bd71553689" :answer-field/id #uuid "83214493-8a7a-53b4-a9de-c3bd71553689" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a64d3f47-43af-5127-9e4b-ae2e4dd35f66" :answer-field/choices ["answer-a64d3f47-43af-5127-9e4b-ae2e4dd35f66"] :db/ensure [:answer-field/validate]} {:db/id "answer-a64d3f47-43af-5127-9e4b-ae2e4dd35f66" :answer/id #uuid "a64d3f47-43af-5127-9e4b-ae2e4dd35f66" :answer/type :answer.type/math :answer/value "-\\frac{2}{5b}" :db/ensure [:answer/validate]} {:db/id "question-76378346-6bd7-5f90-bb11-bc03bf523eef" :question/id #uuid "76378346-6bd7-5f90-bb11-bc03bf523eef" :question/math-academy-id "q-133665" :question/problem "If $2=\\frac{3}{10}hk,$ then $k=$" :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the fraction:\n\n$$\n\\begin{aligned}2 & =\\frac{3}{10}hk \\\\ 10\\cdot 2 & =10\\cdot \\frac{3}{10}hk \\\\ 20 & =3hk\\end{aligned}\n$$\n\nNow, we need to isolate $k.$ To do this, we divide both sides of the equation by $3h:$\n\n$$\n\\begin{aligned}20 & =3hk \\\\ \\frac{20}{3h} & =\\frac{3hk}{3h} \\\\ \\frac{20}{3h} & =\\frac{\\cancel{3h}k}{\\cancel{3h}} \\\\ \\frac{20}{3h} & =k \\\\ k & =\\frac{20}{3h}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bcffec60-3308-5f80-a86e-fd4c6b6cad44"] :db/ensure [:question/validate]} {:db/id "answer-field-bcffec60-3308-5f80-a86e-fd4c6b6cad44" :answer-field/id #uuid "bcffec60-3308-5f80-a86e-fd4c6b6cad44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-529c00d6-be9f-50e8-9c09-cf89e11a460b" :answer-field/choices ["answer-cc20d3f7-f8d2-5d41-9c68-291c2aed5e3f" "answer-1a54108e-6019-5a03-8ce0-8ab6c1fec0a3" "answer-529c00d6-be9f-50e8-9c09-cf89e11a460b" "answer-4ae38b6d-4985-5481-8121-af9f93f5ab4c" "answer-414b5a4c-65d0-557e-abcd-8e3a2ff2db10"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc20d3f7-f8d2-5d41-9c68-291c2aed5e3f" :answer/id #uuid "cc20d3f7-f8d2-5d41-9c68-291c2aed5e3f" :answer/type :answer.type/math :answer/value "\\frac{10}{3h}" :db/ensure [:answer/validate]} {:db/id "answer-1a54108e-6019-5a03-8ce0-8ab6c1fec0a3" :answer/id #uuid "1a54108e-6019-5a03-8ce0-8ab6c1fec0a3" :answer/type :answer.type/math :answer/value "\\frac{15}{h}" :db/ensure [:answer/validate]} {:db/id "answer-529c00d6-be9f-50e8-9c09-cf89e11a460b" :answer/id #uuid "529c00d6-be9f-50e8-9c09-cf89e11a460b" :answer/type :answer.type/math :answer/value "\\frac{20}{3h}" :db/ensure [:answer/validate]} {:db/id "answer-4ae38b6d-4985-5481-8121-af9f93f5ab4c" :answer/id #uuid "4ae38b6d-4985-5481-8121-af9f93f5ab4c" :answer/type :answer.type/math :answer/value "\\frac{3}{10h}" :db/ensure [:answer/validate]} {:db/id "answer-414b5a4c-65d0-557e-abcd-8e3a2ff2db10" :answer/id #uuid "414b5a4c-65d0-557e-abcd-8e3a2ff2db10" :answer/type :answer.type/math :answer/value "\\frac{5}{3h}" :db/ensure [:answer/validate]} {:db/id "question-06c556aa-e44d-528e-81fb-0f187fd8faf9" :question/id #uuid "06c556aa-e44d-528e-81fb-0f187fd8faf9" :question/math-academy-id "q-133663" :question/problem "If $\\frac{4}{3}=5vs,$ then $s=$" :question/worked-solution "First, we multiply both sides of the equation by $3$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\\frac{4}{3} & =5vs \\\\ 3\\cdot \\frac{4}{3} & =3\\cdot 5vs \\\\ 4 & =15vs\\end{aligned}\n$$\n\nNow, we need to isolate $s.$ To do this, we divide both sides of the equation by $15v:$\n\n$$\n\\begin{aligned}4 & =15vs \\\\ \\frac{4}{15v} & =\\frac{15vs}{15v} \\\\ \\frac{4}{15v} & =\\frac{\\cancel{15v}s}{\\cancel{15v}} \\\\ \\frac{4}{15v} & =s \\\\ s & =\\frac{4}{15v}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e9795343-ebe1-5a6d-9824-2c6e0c43c343"] :db/ensure [:question/validate]} {:db/id "answer-field-e9795343-ebe1-5a6d-9824-2c6e0c43c343" :answer-field/id #uuid "e9795343-ebe1-5a6d-9824-2c6e0c43c343" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c1cb5b5d-1ea4-56fd-90f9-edec6664d770" :answer-field/choices ["answer-a56f5029-2998-5dff-b344-76ca8498ecf9" "answer-c1cb5b5d-1ea4-56fd-90f9-edec6664d770" "answer-d50d6314-2704-57cc-8acc-f790eb7800e6" "answer-a20f6bb1-91fe-5f05-a0cd-c6a731b3cf24" "answer-db283fef-611c-5d11-9408-b9d041b4f5d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-a56f5029-2998-5dff-b344-76ca8498ecf9" :answer/id #uuid "a56f5029-2998-5dff-b344-76ca8498ecf9" :answer/type :answer.type/math :answer/value "\\frac{2}{5v}" :db/ensure [:answer/validate]} {:db/id "answer-c1cb5b5d-1ea4-56fd-90f9-edec6664d770" :answer/id #uuid "c1cb5b5d-1ea4-56fd-90f9-edec6664d770" :answer/type :answer.type/math :answer/value "\\frac{4}{15v}" :db/ensure [:answer/validate]} {:db/id "answer-d50d6314-2704-57cc-8acc-f790eb7800e6" :answer/id #uuid "d50d6314-2704-57cc-8acc-f790eb7800e6" :answer/type :answer.type/math :answer/value "\\frac{5v}{4v}" :db/ensure [:answer/validate]} {:db/id "answer-a20f6bb1-91fe-5f05-a0cd-c6a731b3cf24" :answer/id #uuid "a20f6bb1-91fe-5f05-a0cd-c6a731b3cf24" :answer/type :answer.type/math :answer/value "\\frac{5}{12v}" :db/ensure [:answer/validate]} {:db/id "answer-db283fef-611c-5d11-9408-b9d041b4f5d6" :answer/id #uuid "db283fef-611c-5d11-9408-b9d041b4f5d6" :answer/type :answer.type/math :answer/value "\\frac{5}{3v}" :db/ensure [:answer/validate]} {:db/id "question-3c956651-7831-59be-948a-98c8e15c7d28" :question/id #uuid "3c956651-7831-59be-948a-98c8e15c7d28" :question/math-academy-id "q-214615" :question/problem "If $-\\frac{3xy}{10}=\\frac{1}{2},$ then $y=${{field-1}}." :question/worked-solution "We need to isolate $y.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}-\\frac{3xy}{10} & =\\frac{1}{2} \\\\ \\frac{-3xy}{10} & =\\frac{1}{2} \\\\ 2\\cdot (-3xy) & =10\\cdot 1 \\\\ -6xy & =10\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $-6x:$\n\n$$\n\\begin{aligned}-6xy & =10 \\\\ \\frac{-6xy}{-6x} & =\\frac{10}{-6x} \\\\ \\frac{\\cancel{-6x}\\,y}{\\cancel{-6x}} & =\\frac{10}{-6x} \\\\ y & =-\\frac{10}{6x}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}y & =-\\frac{2\\cdot 5}{2\\cdot 3x} \\\\ y & =-\\frac{\\cancel{2}\\cdot 5}{\\cancel{2}\\cdot 3x} \\\\ y & =-\\frac{5}{3x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4145a264-18fa-5615-9a7b-19eca3f91555"] :db/ensure [:question/validate]} {:db/id "answer-field-4145a264-18fa-5615-9a7b-19eca3f91555" :answer-field/id #uuid "4145a264-18fa-5615-9a7b-19eca3f91555" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-148fb1e1-6469-5e9f-8607-d19a1b547d4d" :answer-field/choices ["answer-148fb1e1-6469-5e9f-8607-d19a1b547d4d"] :db/ensure [:answer-field/validate]} {:db/id "answer-148fb1e1-6469-5e9f-8607-d19a1b547d4d" :answer/id #uuid "148fb1e1-6469-5e9f-8607-d19a1b547d4d" :answer/type :answer.type/math :answer/value "-\\frac{5}{3x}" :db/ensure [:answer/validate]} {:db/id "question-821390a9-15de-5be4-b110-42ad4543a1a6" :question/id #uuid "821390a9-15de-5be4-b110-42ad4543a1a6" :question/math-academy-id "q-75488" :question/problem "If $\\frac{12nx}{2}=\\frac{4}{7},$ then $x=$" :question/worked-solution "We need to isolate $x.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{12nx}{2} & =\\frac{4}{7} \\\\ 7\\cdot 12nx & =2\\cdot 4 \\\\ 84nx & =8\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $84n:$\n\n$$\n\\begin{aligned}84nx & =8 \\\\ \\frac{84nx}{84n} & =\\frac{8}{84n} \\\\ \\frac{\\cancel{84n}x}{\\cancel{84n}} & =\\frac{8}{84n} \\\\ x & =\\frac{8}{84n}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}x & =\\frac{4\\cdot 2}{4\\cdot 21n} \\\\ x & =\\frac{\\cancel{4}\\cdot 2}{\\cancel{4}\\cdot 21n} \\\\ x & =\\frac{2}{21n}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-74722e8c-447b-54a8-a4b0-54e7b6f9a748"] :db/ensure [:question/validate]} {:db/id "answer-field-74722e8c-447b-54a8-a4b0-54e7b6f9a748" :answer-field/id #uuid "74722e8c-447b-54a8-a4b0-54e7b6f9a748" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aa5f1033-a8e2-5f84-88cd-f03d888abc9a" :answer-field/choices ["answer-fb43d269-818b-501a-95d5-50e37b024951" "answer-6e381f39-c03c-5574-915d-4a343cc4cb78" "answer-aa5f1033-a8e2-5f84-88cd-f03d888abc9a" "answer-c6610624-2863-5638-a438-3678da72f23c" "answer-e227ad4b-5b07-5ce7-a465-4950eeef78da"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb43d269-818b-501a-95d5-50e37b024951" :answer/id #uuid "fb43d269-818b-501a-95d5-50e37b024951" :answer/type :answer.type/math :answer/value "\\frac{1}{21n}" :db/ensure [:answer/validate]} {:db/id "answer-6e381f39-c03c-5574-915d-4a343cc4cb78" :answer/id #uuid "6e381f39-c03c-5574-915d-4a343cc4cb78" :answer/type :answer.type/math :answer/value "\\frac{1}{42n}" :db/ensure [:answer/validate]} {:db/id "answer-aa5f1033-a8e2-5f84-88cd-f03d888abc9a" :answer/id #uuid "aa5f1033-a8e2-5f84-88cd-f03d888abc9a" :answer/type :answer.type/math :answer/value "\\frac{2}{21n}" :db/ensure [:answer/validate]} {:db/id "answer-c6610624-2863-5638-a438-3678da72f23c" :answer/id #uuid "c6610624-2863-5638-a438-3678da72f23c" :answer/type :answer.type/math :answer/value "\\frac{3}{42n}" :db/ensure [:answer/validate]} {:db/id "answer-e227ad4b-5b07-5ce7-a465-4950eeef78da" :answer/id #uuid "e227ad4b-5b07-5ce7-a465-4950eeef78da" :answer/type :answer.type/math :answer/value "\\frac{8}{21n}" :db/ensure [:answer/validate]} {:db/id 17592186180780 :tutorial/content "Consider the following equation:\n\n$$\n2{\\color{red}m}{\\color{blue}t} = 1\n$$\n\nNotice that this equation has two variables, ${\\color{red}m}$ and ${\\color{blue}t}.$ Suppose we want to solve the equation for the variable ${\\color{blue}t}.$\n\nTo isolate ${\\color{blue}t},$ we apply the multiplication principle and divide both sides of the equation by $2{\\color{red}m},$ treating ${\\color{red}m}$ as though it were a constant:\n\n$$\n\\begin{aligned}2mt & =1 \\\\ \\frac{2mt}{2m} & =\\frac{1}{2m} \\\\ \\frac{\\cancel{2m}t}{\\cancel{2m}} & =\\frac{1}{2m} \\\\ t & =\\frac{1}{2m}\\end{aligned}\n$$\n\nNext, we'll take a look at an example where we need to apply both the addition and multiplication principles." :db/ensure [:tutorial/validate]} {:db/id 17592186179890 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186124605 :knowledge-point/questions ["question-a57f1e60-3a1f-5809-920d-a2e3527a6835"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a57f1e60-3a1f-5809-920d-a2e3527a6835" :question/id #uuid "a57f1e60-3a1f-5809-920d-a2e3527a6835" :question/math-academy-id "q-140839" :question/problem "If $C$ is a $4\\times 4$ matrix and $\\lambda =5$ is an eigenvalue of $C,$ which of the following statements are true?\n\nI. $(C-5I)x=0$ has only zero solution\n\nII. $\\text{Col}(C-5I)\\ne {R}^{4}$\n\nIII. $\\text{Null}(C-5I)\\ne \\{0\\}$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)=\\{0\\} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=C-5I.$\n\n- Statement I is false. Notice that if $\\lambda =5$ is an eigenvalue of $C,$ then the nonzero solutions of $(C-5I)x=0$ are eigenvectors of $C.$ As a result, the matrix $M=C-5I$ must be singular.\n\n- Statements II and III are true. Since $M=C-5I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{Col}(C-5I)\\ne {R}^{4},\n$$\n\nand\n\n$$\n\\text{Null}(C-5I)\\ne \\{0\\}.\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-93a75aae-536a-560a-b748-38762d5ef8b7"] :db/ensure [:question/validate]} {:db/id "answer-field-93a75aae-536a-560a-b748-38762d5ef8b7" :answer-field/id #uuid "93a75aae-536a-560a-b748-38762d5ef8b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e87bc2e-1fa6-5dfe-a12d-f3281ca37a48" :answer-field/choices ["answer-ff51444c-16eb-5add-9d3a-db4575d4b382" "answer-0dd0d4fb-280a-550e-a592-ead821179211" "answer-79c00a2a-a33d-50c2-9a06-fe7d080d7095" "answer-1e87bc2e-1fa6-5dfe-a12d-f3281ca37a48" "answer-89763caf-f10d-5fe3-91a2-c8336bf4bcdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff51444c-16eb-5add-9d3a-db4575d4b382" :answer/id #uuid "ff51444c-16eb-5add-9d3a-db4575d4b382" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-0dd0d4fb-280a-550e-a592-ead821179211" :answer/id #uuid "0dd0d4fb-280a-550e-a592-ead821179211" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-79c00a2a-a33d-50c2-9a06-fe7d080d7095" :answer/id #uuid "79c00a2a-a33d-50c2-9a06-fe7d080d7095" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-1e87bc2e-1fa6-5dfe-a12d-f3281ca37a48" :answer/id #uuid "1e87bc2e-1fa6-5dfe-a12d-f3281ca37a48" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-89763caf-f10d-5fe3-91a2-c8336bf4bcdf" :answer/id #uuid "89763caf-f10d-5fe3-91a2-c8336bf4bcdf" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-382bc946-87c1-5af9-a714-bd8312897100" :activity/id #uuid "382bc946-87c1-5af9-a714-bd8312897100" :activity/title "The Invertible Matrix Theorem in Terms of Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186050470 :activity/course 17592186046659 :activity/steps ["step-6a18fb35-57db-5780-914c-83b1dbef88e1" "step-901bfe44-d04a-5966-874a-7a238c9dc1ba" "step-f5e9d767-80a5-5062-a420-ab68984dcbd8" "step-0a855166-560a-5030-8b45-18d477914230" "step-44b1d683-1553-59db-aadd-0a5e6069911a"] :activity/first-step "step-6a18fb35-57db-5780-914c-83b1dbef88e1" :db/ensure [:activity/validate]} {:db/id "step-6a18fb35-57db-5780-914c-83b1dbef88e1" :step/id #uuid "6a18fb35-57db-5780-914c-83b1dbef88e1" :step/content 17592186362248 :step/next "step-901bfe44-d04a-5966-874a-7a238c9dc1ba" :db/ensure [:step/validate]} {:db/id "step-901bfe44-d04a-5966-874a-7a238c9dc1ba" :step/id #uuid "901bfe44-d04a-5966-874a-7a238c9dc1ba" :step/content 17592186362252 :step/next "step-f5e9d767-80a5-5062-a420-ab68984dcbd8" :db/ensure [:step/validate]} {:db/id "step-f5e9d767-80a5-5062-a420-ab68984dcbd8" :step/id #uuid "f5e9d767-80a5-5062-a420-ab68984dcbd8" :step/content 17592186362254 :step/next "step-0a855166-560a-5030-8b45-18d477914230" :db/ensure [:step/validate]} {:db/id "step-0a855166-560a-5030-8b45-18d477914230" :step/id #uuid "0a855166-560a-5030-8b45-18d477914230" :step/content 17592186362257 :step/next "step-44b1d683-1553-59db-aadd-0a5e6069911a" :db/ensure [:step/validate]} {:db/id "step-44b1d683-1553-59db-aadd-0a5e6069911a" :step/id #uuid "44b1d683-1553-59db-aadd-0a5e6069911a" :step/content "question-a57f1e60-3a1f-5809-920d-a2e3527a6835" :db/ensure [:step/validate]} {:db/id 17592186179652 :knowledge-point/questions ["question-d9cb8bb3-9f8a-56a1-975b-7665fdd7f9a0" "question-117f6ecc-4203-5323-8f20-261b6a681a27"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d9cb8bb3-9f8a-56a1-975b-7665fdd7f9a0" :question/id #uuid "d9cb8bb3-9f8a-56a1-975b-7665fdd7f9a0" :question/math-academy-id "q-129499" :question/problem "![](images/38/3812ff158f2268f78bbc22cc0fa11f86fd8506a78ce05104df04fef1fe39d037.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "We find the ranges of the individual pieces, and then calculate their union:\n\n- The range of the branch defined on $x\\in (-4,-2)$ is $(-2,1)$\n\n- The range of the branch defined on $x\\in [2,4)$ is $[2,4)$\n\nTherefore, the range of $f(x)$ is $(-2,1)\\cup [2,4).$\n\n**Note:** From the graph, we see that the values $y=-2,$ $y=1$ and $y=4$ are NOT valid outputs of the function $y=f(x).$ Therefore, we use parentheses $(…)$ instead of brackets $[…]$ at these endpoints." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d6134758-b46e-5c42-a114-442ec1a2403f"] :db/ensure [:question/validate]} {:db/id "answer-field-d6134758-b46e-5c42-a114-442ec1a2403f" :answer-field/id #uuid "d6134758-b46e-5c42-a114-442ec1a2403f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c054f2cd-383f-5029-9555-38cd2116b746" :answer-field/choices ["answer-c054f2cd-383f-5029-9555-38cd2116b746" "answer-10ea4a4a-6af7-53e3-a2da-4e9270ae9e01" "answer-6fd394ee-b057-5379-9a1b-d34d572d1ec8" "answer-26f9270d-7428-5041-b676-2ee3659c97b9" "answer-e1002e66-6e75-53b6-9e3d-dc25f3c7a1fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c054f2cd-383f-5029-9555-38cd2116b746" :answer/id #uuid "c054f2cd-383f-5029-9555-38cd2116b746" :answer/type :answer.type/math :answer/value "(-2,1)\\cup [2,4)" :db/ensure [:answer/validate]} {:db/id "answer-10ea4a4a-6af7-53e3-a2da-4e9270ae9e01" :answer/id #uuid "10ea4a4a-6af7-53e3-a2da-4e9270ae9e01" :answer/type :answer.type/math :answer/value "(-2,1]\\cup [2,4)" :db/ensure [:answer/validate]} {:db/id "answer-6fd394ee-b057-5379-9a1b-d34d572d1ec8" :answer/id #uuid "6fd394ee-b057-5379-9a1b-d34d572d1ec8" :answer/type :answer.type/math :answer/value "(-2,4)" :db/ensure [:answer/validate]} {:db/id "answer-26f9270d-7428-5041-b676-2ee3659c97b9" :answer/id #uuid "26f9270d-7428-5041-b676-2ee3659c97b9" :answer/type :answer.type/math :answer/value "[-2,4)" :db/ensure [:answer/validate]} {:db/id "answer-e1002e66-6e75-53b6-9e3d-dc25f3c7a1fc" :answer/id #uuid "e1002e66-6e75-53b6-9e3d-dc25f3c7a1fc" :answer/type :answer.type/math :answer/value "[-2,4]" :db/ensure [:answer/validate]} {:db/id 17592186179651 :knowledge-point/questions ["question-5fec27c7-ab59-5059-80aa-0971460daa74" "question-68f16f52-3b3f-54c0-8129-b8dd5925efc4" "question-e22474d8-8407-520c-b16d-2ce97d2431d2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5fec27c7-ab59-5059-80aa-0971460daa74" :question/id #uuid "5fec27c7-ab59-5059-80aa-0971460daa74" :question/math-academy-id "q-236066" :question/problem "![](images/96/9676726ee0d5b979eb326d262856e37618f09e505093d4997d168826a173c05b.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$\\le f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-6.$ This occurs when $x=-2.$\n\n- The largest $y$-value is $2.$ This occurs when $x=2.$\n\nThe function covers all the $y$-values between $-6$ and $2,$ including $-6$ and $2.$\n\nTherefore, the range is $-6\\le y\\le 2,$ which can also be written as $-6\\le f(x)\\le 2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e1f1192c-1c38-5ec4-8df7-4a6fedfd31b3" "answer-field-ffd90f0b-c8e3-5151-a11b-5c88bd560c16" "answer-field-0ba72bcb-e982-5c1c-9f10-85453cab11f8"] :db/ensure [:question/validate]} {:db/id "answer-field-e1f1192c-1c38-5ec4-8df7-4a6fedfd31b3" :answer-field/id #uuid "e1f1192c-1c38-5ec4-8df7-4a6fedfd31b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ccb21548-5407-5ed8-b63c-4bfe7ec61b37" :answer-field/choices ["answer-ccb21548-5407-5ed8-b63c-4bfe7ec61b37"] :db/ensure [:answer-field/validate]} {:db/id "answer-ccb21548-5407-5ed8-b63c-4bfe7ec61b37" :answer/id #uuid "ccb21548-5407-5ed8-b63c-4bfe7ec61b37" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-field-ffd90f0b-c8e3-5151-a11b-5c88bd560c16" :answer-field/id #uuid "ffd90f0b-c8e3-5151-a11b-5c88bd560c16" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-213e7e39-0eb2-5e96-939c-19a53bf9b4e8" :answer-field/choices ["answer-213e7e39-0eb2-5e96-939c-19a53bf9b4e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-213e7e39-0eb2-5e96-939c-19a53bf9b4e8" :answer/id #uuid "213e7e39-0eb2-5e96-939c-19a53bf9b4e8" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-0ba72bcb-e982-5c1c-9f10-85453cab11f8" :answer-field/id #uuid "0ba72bcb-e982-5c1c-9f10-85453cab11f8" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c81f06b3-793d-5bee-a0df-270cca11e13d" :answer-field/choices ["answer-c81f06b3-793d-5bee-a0df-270cca11e13d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c81f06b3-793d-5bee-a0df-270cca11e13d" :answer/id #uuid "c81f06b3-793d-5bee-a0df-270cca11e13d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-68f16f52-3b3f-54c0-8129-b8dd5925efc4" :question/id #uuid "68f16f52-3b3f-54c0-8129-b8dd5925efc4" :question/math-academy-id "q-236385" :question/problem "![](images/a4/a4b653263aa47cfeecceeda20adfe5851b81d0a7c4fc6457ef87f45ea65ca27d.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $0.$ This occurs when $x\\to \\infty .$ However, note  that this point is not included in the graph.\n\n- There is no largest $y$-value.\n\nThe function covers all the $y$-values between $0$ and $\\infty ,$ but not including $0.$\n\nTherefore, the range is $0<y<\\infty ,$ which can also be written as \n$0<f(x)<\\infty .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4f7c168b-0c23-5b91-84ac-a2b54ac765c3" "answer-field-a842b6b2-34f6-55fe-9267-080b75e9b770" "answer-field-071a882c-1715-5b85-843f-a8a7f6c4e013"] :db/ensure [:question/validate]} {:db/id "answer-field-4f7c168b-0c23-5b91-84ac-a2b54ac765c3" :answer-field/id #uuid "4f7c168b-0c23-5b91-84ac-a2b54ac765c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-953aa3c7-d4a2-555a-8836-e8d648a99b6f" :answer-field/choices ["answer-953aa3c7-d4a2-555a-8836-e8d648a99b6f"] :db/ensure [:answer-field/validate]} {:db/id "answer-953aa3c7-d4a2-555a-8836-e8d648a99b6f" :answer/id #uuid "953aa3c7-d4a2-555a-8836-e8d648a99b6f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-a842b6b2-34f6-55fe-9267-080b75e9b770" :answer-field/id #uuid "a842b6b2-34f6-55fe-9267-080b75e9b770" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fa7c657d-fa96-531c-9c31-c9baeb8c5149" :answer-field/choices ["answer-fa7c657d-fa96-531c-9c31-c9baeb8c5149"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa7c657d-fa96-531c-9c31-c9baeb8c5149" :answer/id #uuid "fa7c657d-fa96-531c-9c31-c9baeb8c5149" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-071a882c-1715-5b85-843f-a8a7f6c4e013" :answer-field/id #uuid "071a882c-1715-5b85-843f-a8a7f6c4e013" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-21dd6e14-5383-55cc-8778-fcb55c7e3f15" :answer-field/choices ["answer-21dd6e14-5383-55cc-8778-fcb55c7e3f15"] :db/ensure [:answer-field/validate]} {:db/id "answer-21dd6e14-5383-55cc-8778-fcb55c7e3f15" :answer/id #uuid "21dd6e14-5383-55cc-8778-fcb55c7e3f15" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-e22474d8-8407-520c-b16d-2ce97d2431d2" :question/id #uuid "e22474d8-8407-520c-b16d-2ce97d2431d2" :question/math-academy-id "q-236460" :question/problem "![](images/6a/6a3822492b4d8fda25ad48a7edd44cf82209857f7a1d67997ff691a770264afb.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- There is no smallest $y$-value.\n\n- The largest $y$-value is $3.$ This occurs when $x=0.$\n\nThe function covers all the $y$-values between $-\\infty $ and $3,$ including $3.$\n\nTherefore, the range is $-\\infty <y\\le 3,$ which can also be written as  $-\\infty <f(x)\\le 3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1538a00e-7bb6-5483-bce6-eb783fbd88b4" "answer-field-0310b7f7-fce3-5481-b2a1-2c3a2be1c6d9" "answer-field-0d5af0e8-6f2f-52d3-9829-6e69a00a9674"] :db/ensure [:question/validate]} {:db/id "answer-field-1538a00e-7bb6-5483-bce6-eb783fbd88b4" :answer-field/id #uuid "1538a00e-7bb6-5483-bce6-eb783fbd88b4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a8229625-57aa-55e5-82a8-9b3cff6b9ed2" :answer-field/choices ["answer-a8229625-57aa-55e5-82a8-9b3cff6b9ed2"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8229625-57aa-55e5-82a8-9b3cff6b9ed2" :answer/id #uuid "a8229625-57aa-55e5-82a8-9b3cff6b9ed2" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-field-0310b7f7-fce3-5481-b2a1-2c3a2be1c6d9" :answer-field/id #uuid "0310b7f7-fce3-5481-b2a1-2c3a2be1c6d9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d2ecbaae-0b74-5f3e-ba28-4c9b99e7ab6a" :answer-field/choices ["answer-d2ecbaae-0b74-5f3e-ba28-4c9b99e7ab6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2ecbaae-0b74-5f3e-ba28-4c9b99e7ab6a" :answer/id #uuid "d2ecbaae-0b74-5f3e-ba28-4c9b99e7ab6a" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-0d5af0e8-6f2f-52d3-9829-6e69a00a9674" :answer-field/id #uuid "0d5af0e8-6f2f-52d3-9829-6e69a00a9674" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-706fe481-c6a1-51cd-a428-f0aab0b63636" :answer-field/choices ["answer-706fe481-c6a1-51cd-a428-f0aab0b63636"] :db/ensure [:answer-field/validate]} {:db/id "answer-706fe481-c6a1-51cd-a428-f0aab0b63636" :answer/id #uuid "706fe481-c6a1-51cd-a428-f0aab0b63636" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-117f6ecc-4203-5323-8f20-261b6a681a27" :question/id #uuid "117f6ecc-4203-5323-8f20-261b6a681a27" :question/math-academy-id "q-236721" :question/problem "![](images/df/dff5e6055378143e81d4771d8beeb21e2b9b287b6fb630779885a1bce288d77d.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}." :question/worked-solution "We find the ranges of the individual pieces and then calculate their union:\n\n- The range of the branch defined on $x\\in (-3,-1)$ is $(-3,-1)$\n\n- The range of the branch defined on $x\\in [-1,3)$ is $[-2,2)$\n\nTherefore, the range of $f(x)$ is $(-3,-1)\\cup [-2,2)=(-3,2),$ which can also be written as \n\n$$\n-3<f(x)<2.\n$$\n\n**Note:** From the graph, we see that the values $y=-3$ and $y=2$ are NOT valid outputs of the function $y=f(x).$ Therefore, we use \"less than\" $(<)$ instead of \"less than or equal to\" $(\\le )$ at these endpoints." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-694c12d7-35b7-50b7-a57a-c8771900c109" "answer-field-f3182c8f-3c10-5274-b0bc-3a0bd8c926f3" "answer-field-9398e924-c066-58e8-b0dd-14445e79a0b1"] :db/ensure [:question/validate]} {:db/id "answer-field-694c12d7-35b7-50b7-a57a-c8771900c109" :answer-field/id #uuid "694c12d7-35b7-50b7-a57a-c8771900c109" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-17813372-0022-5522-af1c-fab6020b80fa" :answer-field/choices ["answer-17813372-0022-5522-af1c-fab6020b80fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-17813372-0022-5522-af1c-fab6020b80fa" :answer/id #uuid "17813372-0022-5522-af1c-fab6020b80fa" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-field-f3182c8f-3c10-5274-b0bc-3a0bd8c926f3" :answer-field/id #uuid "f3182c8f-3c10-5274-b0bc-3a0bd8c926f3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-88549f65-3136-52ea-9c3a-7cc1ab54d8ea" :answer-field/choices ["answer-88549f65-3136-52ea-9c3a-7cc1ab54d8ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-88549f65-3136-52ea-9c3a-7cc1ab54d8ea" :answer/id #uuid "88549f65-3136-52ea-9c3a-7cc1ab54d8ea" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-9398e924-c066-58e8-b0dd-14445e79a0b1" :answer-field/id #uuid "9398e924-c066-58e8-b0dd-14445e79a0b1" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fdf40489-c386-5ad4-99e1-9b5fa7eb9d8f" :answer-field/choices ["answer-fdf40489-c386-5ad4-99e1-9b5fa7eb9d8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdf40489-c386-5ad4-99e1-9b5fa7eb9d8f" :answer/id #uuid "fdf40489-c386-5ad4-99e1-9b5fa7eb9d8f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "activity-8306db39-3e98-5063-b2e6-7356607f65e1" :activity/id #uuid "8306db39-3e98-5063-b2e6-7356607f65e1" :activity/title "The Range of a Function: Advanced Cases" :activity/type :activity.type/review :activity/scope 17592186050580 :activity/course 17592186046658 :activity/steps ["step-40697110-9e45-55db-9be6-4b07b907e38a" "step-e4a5889a-97a0-5805-9b0a-b6ea2e3928d1" "step-6611bc85-d953-563e-85e8-d62dff8c725c" "step-b83b940c-4e3f-57f0-9f7e-eb02d0534548" "step-4ef4868a-bee6-5ee8-af14-3583672658a7"] :activity/first-step "step-40697110-9e45-55db-9be6-4b07b907e38a" :db/ensure [:activity/validate]} {:db/id "step-40697110-9e45-55db-9be6-4b07b907e38a" :step/id #uuid "40697110-9e45-55db-9be6-4b07b907e38a" :step/content "question-d9cb8bb3-9f8a-56a1-975b-7665fdd7f9a0" :step/next "step-e4a5889a-97a0-5805-9b0a-b6ea2e3928d1" :db/ensure [:step/validate]} {:db/id "step-e4a5889a-97a0-5805-9b0a-b6ea2e3928d1" :step/id #uuid "e4a5889a-97a0-5805-9b0a-b6ea2e3928d1" :step/content "question-5fec27c7-ab59-5059-80aa-0971460daa74" :step/next "step-6611bc85-d953-563e-85e8-d62dff8c725c" :db/ensure [:step/validate]} {:db/id "step-6611bc85-d953-563e-85e8-d62dff8c725c" :step/id #uuid "6611bc85-d953-563e-85e8-d62dff8c725c" :step/content "question-68f16f52-3b3f-54c0-8129-b8dd5925efc4" :step/next "step-b83b940c-4e3f-57f0-9f7e-eb02d0534548" :db/ensure [:step/validate]} {:db/id "step-b83b940c-4e3f-57f0-9f7e-eb02d0534548" :step/id #uuid "b83b940c-4e3f-57f0-9f7e-eb02d0534548" :step/content "question-e22474d8-8407-520c-b16d-2ce97d2431d2" :step/next "step-4ef4868a-bee6-5ee8-af14-3583672658a7" :db/ensure [:step/validate]} {:db/id "step-4ef4868a-bee6-5ee8-af14-3583672658a7" :step/id #uuid "4ef4868a-bee6-5ee8-af14-3583672658a7" :step/content "question-117f6ecc-4203-5323-8f20-261b6a681a27" :db/ensure [:step/validate]} {:db/id 17592186129190 :knowledge-point/questions ["question-291bba76-b18a-519c-8c81-930cc19f299e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129674 :question/worked-solution "![](images/ea/ea36f1ec1ddeb03dd8d133fb8d65b5d50b3fa07ba34495978d87f95742dee042.png)\n\nThe diagram above shows the region of integration. It consists of two type I regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le x\\}\\,\\cup \\,\\{(x,y)\\,:\\,2\\le x\\le 4,\\,0\\le y\\le 4-x\\}.\\end{aligned}\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=x\\,⟹\\,x=y\n$$\n\nand the right boundary of the region is\n\n$$\ny=4-x\\,⟹\\,x=4-y.\n$$\n\nTo change the order of integration we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,y\\le x\\le 4-y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/e8/e82098a4bb63f1d709a06b6a24da078594716d6a3cc0fa2e069af9dcd9154955.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{x}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{2}^{4}{\\int }_{0}^{4-x}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{2}{\\int }_{y}^{4-y}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129189 :knowledge-point/questions ["question-18010b03-c75c-5a16-8ddc-495cf577e016" "question-1781d10d-4447-567d-8dfd-9f16c098a159"] :db/ensure [:knowledge-point/validate]} {:db/id "question-18010b03-c75c-5a16-8ddc-495cf577e016" :question/id #uuid "18010b03-c75c-5a16-8ddc-495cf577e016" :question/math-academy-id "q-38799" :question/problem "${\\int }_{0}^{1}{\\int }_{x}^{1}{x}^{2}{e}^{{y}^{4}}\\text{d}y\\,\\text{d}x=$" :question/worked-solution "![](images/54/54727a51e88b3543726b61606a0f41b9a8cf5ec46ef4c69d7233fd54a4b50242.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,x\\le y\\le 1\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x)$ is\n\n$$\nx=0,\n$$\n\nand the right boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=x\\,⟹\\,x=y.\n$$\n\nTo change the order of integration, we write $D$ as type II region. Its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/95/956aaf81973d9a2b3e56082ecae8e654eee55d6f99c42dd433d126632d7c7262.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x}^{1}{x}^{2}{e}^{{y}^{4}}\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1}{\\int }_{0}^{y}{x}^{2}{e}^{{y}^{4}}\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{e}^{{y}^{4}}[{\\int }_{0}^{y}{x}^{2}\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{{y}^{4}}}{3}[{x}^{3}]_{0}^{y}\\,\\text{d}y \\\\  & =\\frac{1}{3}{\\int }_{0}^{1}{y}^{3}\\,{e}^{{y}^{4}}\\,\\text{d}y \\\\  & =\\frac{1}{12}{[{e}^{{y}^{4}}]}_{0}^{1} \\\\  & =\\frac{1}{12}(e-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7eba9098-a15f-5710-a728-b6dfa4ffcdb7"] :db/ensure [:question/validate]} {:db/id "answer-field-7eba9098-a15f-5710-a728-b6dfa4ffcdb7" :answer-field/id #uuid "7eba9098-a15f-5710-a728-b6dfa4ffcdb7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-295507dd-328a-5bb3-964f-3c0f304a9d67" :answer-field/choices ["answer-295507dd-328a-5bb3-964f-3c0f304a9d67" "answer-1ab8fcd9-4602-5070-8690-3160b7afea7d" "answer-6465b0aa-6d02-553e-acdc-7035e0eb70ad" "answer-c2f6c3ee-d01c-5d14-87c0-fce9876c9b87" "answer-335927a5-38d1-5363-b0b7-58dbc7940dea"] :db/ensure [:answer-field/validate]} {:db/id "answer-295507dd-328a-5bb3-964f-3c0f304a9d67" :answer/id #uuid "295507dd-328a-5bb3-964f-3c0f304a9d67" :answer/type :answer.type/math :answer/value "\\frac{1}{12}(e-1)" :db/ensure [:answer/validate]} {:db/id "answer-1ab8fcd9-4602-5070-8690-3160b7afea7d" :answer/id #uuid "1ab8fcd9-4602-5070-8690-3160b7afea7d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}(e-1)" :db/ensure [:answer/validate]} {:db/id "answer-6465b0aa-6d02-553e-acdc-7035e0eb70ad" :answer/id #uuid "6465b0aa-6d02-553e-acdc-7035e0eb70ad" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(e-1)" :db/ensure [:answer/validate]} {:db/id "answer-c2f6c3ee-d01c-5d14-87c0-fce9876c9b87" :answer/id #uuid "c2f6c3ee-d01c-5d14-87c0-fce9876c9b87" :answer/type :answer.type/math :answer/value "\\frac{3}{4}(e-1)" :db/ensure [:answer/validate]} {:db/id "answer-335927a5-38d1-5363-b0b7-58dbc7940dea" :answer/id #uuid "335927a5-38d1-5363-b0b7-58dbc7940dea" :answer/type :answer.type/math :answer/value "\\frac{4}{3}(1-e)" :db/ensure [:answer/validate]} {:db/id "question-291bba76-b18a-519c-8c81-930cc19f299e" :question/id #uuid "291bba76-b18a-519c-8c81-930cc19f299e" :question/math-academy-id "q-82253" :question/problem "By changing the order of integration in the following double integrals, express the following sum as a single double integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2{x}^{2}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{4-2x}f(x,y)\\,\\text{d}y\\,\\text{d}x\n$$" :question/worked-solution "![](images/83/8359a189981b238d0851324a896ed0a3a9aa0620e8cf4d38228752ff484b4cd0.png)\n\nThe diagram above shows the region of integration. It consists of two type I regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 2{x}^{2}\\}\\,\\cup \\,\\{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 2(x-2)^{2}\\}.\\end{aligned}\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=2{x}^{2}\\,⟹\\,x=\\sqrt{\\frac{y}{2}}\n$$\n\nand the right boundary of the region is\n\n$$\ny=4-2x\\,⟹\\,x=\\frac{4-y}{2}.\n$$\n\nTo change the order of integration we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\sqrt{\\frac{y}{2}}\\le x\\le \\frac{4-y}{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/be/bee5de8ca9011672a159686d1547a909e5288097b15241f5004e5c788459ee70.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{2{x}^{2}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{2(x-2)^{2}}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{2}{\\int }_{\\sqrt{y/2}}^{(4-y)/2}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7dc9b43e-629a-5bba-b51a-3bf554da7329"] :db/ensure [:question/validate]} {:db/id "answer-field-7dc9b43e-629a-5bba-b51a-3bf554da7329" :answer-field/id #uuid "7dc9b43e-629a-5bba-b51a-3bf554da7329" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1291e1c1-cc7f-5dab-8331-0c5c3605b71f" :answer-field/choices ["answer-6ce71b5a-ae72-56f3-907b-b226cfb92e95" "answer-1291e1c1-cc7f-5dab-8331-0c5c3605b71f" "answer-1215436d-cf83-5f92-b39e-a9bec379f2fa" "answer-a838ae42-337e-55e8-9ec4-76976d1219db" "answer-a34f841b-c478-5350-b05a-4956614fb33c"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ce71b5a-ae72-56f3-907b-b226cfb92e95" :answer/id #uuid "6ce71b5a-ae72-56f3-907b-b226cfb92e95" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{(4-y)/2}{\\int }_{\\sqrt{y/2}}^{2}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1291e1c1-cc7f-5dab-8331-0c5c3605b71f" :answer/id #uuid "1291e1c1-cc7f-5dab-8331-0c5c3605b71f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{\\sqrt{y/2}}^{(4-y)/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1215436d-cf83-5f92-b39e-a9bec379f2fa" :answer/id #uuid "1215436d-cf83-5f92-b39e-a9bec379f2fa" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt{y/2}}{\\int }_{(4-y)/2}^{2}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-a838ae42-337e-55e8-9ec4-76976d1219db" :answer/id #uuid "a838ae42-337e-55e8-9ec4-76976d1219db" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{y/2}}^{(4-y)/2}{\\int }_{0}^{2}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-a34f841b-c478-5350-b05a-4956614fb33c" :answer/id #uuid "a34f841b-c478-5350-b05a-4956614fb33c" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{y/2}}^{2}{\\int }_{0}^{(4-y)/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186388293 :question/worked-solution "![](images/34/3426e7bdd134bc9af5a3665f8c9c55a65514afa9dca5be112eabb37479c4c9ec.png)\n\nThe diagram above shows the region of integration. It consists of two type II regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,1-e\\le y\\le 0,\\,\\operatorname{ln}⁡(1-y)\\le x\\le 1\\}\\,\\cup \\,\\{(x,y)\\,:\\,0\\le y\\le e-1,\\,\\operatorname{ln}⁡(y+1)\\le x\\le 1\\}.\\end{aligned}\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=\\operatorname{ln}⁡(y+1)\\,⟹\\,y={e}^{x}-1,\n$$\n\nand the bottom boundary of the region is\n\n$$\nx=\\operatorname{ln}⁡(1-y)\\,⟹\\,y=1-{e}^{x}.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,1-{e}^{x}\\le y\\le {e}^{x}-1\\},\n$$\n\nas shown in the diagram below.\n\n![](images/7d/7d88d351b481859ec3e77350d3679387836d2e7f67325caca50e2f61cce9dcce.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1-e}^{0}{\\int }_{\\operatorname{ln}⁡(1-y)}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{e-1}{\\int }_{\\operatorname{ln}⁡(y+1)}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{0}^{1}{\\int }_{1-{e}^{x}}^{{e}^{x}-1}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-1781d10d-4447-567d-8dfd-9f16c098a159" :question/id #uuid "1781d10d-4447-567d-8dfd-9f16c098a159" :question/math-academy-id "q-132647" :question/problem "${\\int }_{-4}^{-1}{\\int }_{1}^{-4/y}\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}\\,\\text{d}x\\,\\text{d}y=$" :question/worked-solution "![](images/d2/d2ef7f656cf706636c82e1ef41ae338a596fff5142962a74875f762301937932.png)\n\nThe diagram above shows the region of integration. It is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,-4\\le y\\le -1,\\,1\\le x\\le -\\frac{4}{y}\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\ny=-1,\n$$\n\nand the bottom boundary of the region is\n\n$$\nx=-\\frac{4}{y}\\,⟹\\,y=-\\frac{4}{x},\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,-\\frac{4}{x}\\le y\\le -1\\},\n$$\n\nas shown in the diagram below.\n\n![](images/33/3338ee0f8bdc6f18bb5a56b12a36d31d79c87db6c39686adc7ae7c00efb9d526.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-1}{\\int }_{1}^{-4/y}\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}\\,\\text{d}x\\,\\text{d}y & ={\\int }_{1}^{4}{\\int }_{-4/x}^{-1}\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}[{\\int }_{-4/x}^{-1}\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}\\cdot y\\,{|}_{-4/x}^{-1}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}(\\frac{4}{x}-1)\\frac{1}{\\sqrt{4\\operatorname{ln}⁡x-x+2}}\\,\\text{d}x \\\\  & =2\\sqrt{4\\operatorname{ln}⁡x-x+2}\\,{|}_{1}^{4} \\\\  & =2\\sqrt{4\\operatorname{ln}⁡4-4+2}-2\\sqrt{4\\operatorname{ln}⁡1-1+2} \\\\  & =2\\sqrt{4\\operatorname{ln}⁡4-2}-2 \\\\  & =2(\\sqrt{8\\operatorname{ln}⁡2-2}-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-acad3c64-a048-5588-ba2a-180649362504"] :db/ensure [:question/validate]} {:db/id "answer-field-acad3c64-a048-5588-ba2a-180649362504" :answer-field/id #uuid "acad3c64-a048-5588-ba2a-180649362504" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-469a96e1-ead2-518e-bb41-99b1ce5ab6cd" :answer-field/choices ["answer-469a96e1-ead2-518e-bb41-99b1ce5ab6cd" "answer-3cfe33b9-51d1-5788-8662-58bc8ab68510" "answer-7dfda9e5-2b1f-5351-b880-190a9511ab54" "answer-ff35cb83-3ce5-547e-a2d3-554a83f4034a" "answer-12862e2a-8176-5480-9c3a-b73349d4eada"] :db/ensure [:answer-field/validate]} {:db/id "answer-469a96e1-ead2-518e-bb41-99b1ce5ab6cd" :answer/id #uuid "469a96e1-ead2-518e-bb41-99b1ce5ab6cd" :answer/type :answer.type/math :answer/value "2(\\sqrt{8\\operatorname{ln}⁡2-2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-3cfe33b9-51d1-5788-8662-58bc8ab68510" :answer/id #uuid "3cfe33b9-51d1-5788-8662-58bc8ab68510" :answer/type :answer.type/math :answer/value "4(\\sqrt{4\\operatorname{ln}⁡2-2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-7dfda9e5-2b1f-5351-b880-190a9511ab54" :answer/id #uuid "7dfda9e5-2b1f-5351-b880-190a9511ab54" :answer/type :answer.type/math :answer/value "\\sqrt{4\\operatorname{ln}⁡2-2}-1" :db/ensure [:answer/validate]} {:db/id "answer-ff35cb83-3ce5-547e-a2d3-554a83f4034a" :answer/id #uuid "ff35cb83-3ce5-547e-a2d3-554a83f4034a" :answer/type :answer.type/math :answer/value "\\sqrt{8\\operatorname{ln}⁡2-2}-1" :db/ensure [:answer/validate]} {:db/id "answer-12862e2a-8176-5480-9c3a-b73349d4eada" :answer/id #uuid "12862e2a-8176-5480-9c3a-b73349d4eada" :answer/type :answer.type/math :answer/value "\\sqrt{8\\operatorname{ln}⁡2-2}-4" :db/ensure [:answer/validate]} {:db/id "activity-bf5c1cdc-1231-5945-ae88-c7df3fc76214" :activity/id #uuid "bf5c1cdc-1231-5945-ae88-c7df3fc76214" :activity/title "Changing the Order of Integration in Double Integrals" :activity/type :activity.type/review :activity/scope 17592186048986 :activity/course 17592186046659 :activity/steps ["step-32fd6dca-607a-5214-a4a3-fbde7a7bf2c4" "step-1e312c9f-cb74-5f7f-9c13-ab33fcd2a8b6" "step-48d26477-5711-5c8c-9f6f-58692fb49ba5" "step-a31ece2d-f9c7-54ca-957f-b6feaf1a1054" "step-66d3bee5-2c83-50d6-baeb-1f27e2bd6de0"] :activity/first-step "step-32fd6dca-607a-5214-a4a3-fbde7a7bf2c4" :db/ensure [:activity/validate]} {:db/id "step-32fd6dca-607a-5214-a4a3-fbde7a7bf2c4" :step/id #uuid "32fd6dca-607a-5214-a4a3-fbde7a7bf2c4" :step/content 17592186129674 :step/next "step-1e312c9f-cb74-5f7f-9c13-ab33fcd2a8b6" :db/ensure [:step/validate]} {:db/id "step-1e312c9f-cb74-5f7f-9c13-ab33fcd2a8b6" :step/id #uuid "1e312c9f-cb74-5f7f-9c13-ab33fcd2a8b6" :step/content "question-18010b03-c75c-5a16-8ddc-495cf577e016" :step/next "step-48d26477-5711-5c8c-9f6f-58692fb49ba5" :db/ensure [:step/validate]} {:db/id "step-48d26477-5711-5c8c-9f6f-58692fb49ba5" :step/id #uuid "48d26477-5711-5c8c-9f6f-58692fb49ba5" :step/content "question-291bba76-b18a-519c-8c81-930cc19f299e" :step/next "step-a31ece2d-f9c7-54ca-957f-b6feaf1a1054" :db/ensure [:step/validate]} {:db/id "step-a31ece2d-f9c7-54ca-957f-b6feaf1a1054" :step/id #uuid "a31ece2d-f9c7-54ca-957f-b6feaf1a1054" :step/content 17592186388293 :step/next "step-66d3bee5-2c83-50d6-baeb-1f27e2bd6de0" :db/ensure [:step/validate]} {:db/id "step-66d3bee5-2c83-50d6-baeb-1f27e2bd6de0" :step/id #uuid "66d3bee5-2c83-50d6-baeb-1f27e2bd6de0" :step/content "question-1781d10d-4447-567d-8dfd-9f16c098a159" :db/ensure [:step/validate]} {:db/id 17592186068731 :knowledge-point/questions ["question-61bdcaea-72dd-5dae-b8e1-c1f54914fb34" "question-f1e12ec8-496f-581a-aa45-273ef2ee6953" "question-9744b183-f539-5606-a140-f9ad45bfd0fe" "question-6757a4c2-eb31-57ff-8c26-afeb2acc7f66"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068495 :question/problem "What is the solution to the equation $6^x - 6^5= 0?$" :question/worked-solution "First, we isolate the term with the variable exponent by adding $6^5$ to both sides:\n\n$$\n\\begin{aligned}{6}^{x}-{6}^{5} & =0 \\\\ {6}^{x}-{6}^{5}+{6}^{5} & =0+{6}^{5} \\\\ {6}^{x}-\\cancel{{6}^{5}}+\\cancel{{6}^{5}} & =0+{6}^{5} \\\\ {6}^{x} & ={6}^{5}\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(6),$ we can equate the exponents. \n\n$$\n\\begin{aligned}{6}^{x} & ={6}^{5} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the solution is ${\\color{blue}x} = {\\color{blue}5}.$" :db/ensure [:question/validate]} {:db/id 17592186068732 :knowledge-point/questions ["question-c5891ca3-f381-532b-913f-b6dc3bcab055" "question-fa2ae142-bf31-5242-a307-d8faa66809d6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068496 :question/problem "What is the solution to $3^x = \\dfrac{1}{9}?$" :question/worked-solution "First, we rewrite $9$ as $3^2$ and then proceed as before:\n\n$$\n\\begin{aligned}{3}^{x} & =\\frac{1}{9} \\\\ {3}^{x} & =\\frac{1}{{3}^{2}} \\\\ {3}^{x} & ={3}^{-2}\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(3),$ we equate the exponents and get $x=-2.$" :db/ensure [:question/validate]} {:db/id 17592186068733 :knowledge-point/questions ["question-936aa682-294b-52d5-96a5-a38d57d9bb85"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068497 :question/problem "Solve the equation $2\\cdot 3^x=54.$" :question/worked-solution "First, we divide both sides of the equation by $2\\mathbin{:}$\n\n$$\n\\begin{aligned}2\\cdot {3}^{x} & =54 \\\\ \\frac{2\\cdot {3}^{x}}{2} & =\\frac{54}{2} \\\\ \\frac{\\cancel{2}\\cdot {3}^{x}}{\\cancel{2}} & =27 \\\\ {3}^{x} & =27\\end{aligned}\n$$\n\nNow, we can rewrite $27$ as $3^3$ so that both sides have the same base:\n\n$$\n\\begin{aligned}{3}^{x}={3}^{3}\\end{aligned}\n$$\n\nEquating the exponents, we get ${\\color{blue}x}={\\color{blue}3}.$" :db/ensure [:question/validate]} {:db/id "question-61bdcaea-72dd-5dae-b8e1-c1f54914fb34" :question/id #uuid "61bdcaea-72dd-5dae-b8e1-c1f54914fb34" :question/math-academy-id "q-69816" :question/problem "Solve the equation ${4}^{x}-{4}^{5}=0.$" :question/worked-solution "First, we isolate the term with the variable exponent by adding ${4}^{5}$ to both sides:\n\n$$\n\\begin{aligned}{4}^{x}-{4}^{5} & =0 \\\\ {4}^{x}-\\cancel{{4}^{5}}+\\cancel{{4}^{5}} & =0+{4}^{5} \\\\ {4}^{x} & ={4}^{5}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(4)$, we can equate the exponents:\n\n$$\n\\begin{aligned}{4}^{x} & ={4}^{5} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the solution is $x=5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fdf5b574-2c56-5040-ad79-05467a068e0b"] :db/ensure [:question/validate]} {:db/id "answer-field-fdf5b574-2c56-5040-ad79-05467a068e0b" :answer-field/id #uuid "fdf5b574-2c56-5040-ad79-05467a068e0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4810e6de-00c2-58a4-b292-33b27495778a" :answer-field/choices ["answer-1c905a9a-15d4-590b-b106-bf7966bb52c4" "answer-7b65fa7