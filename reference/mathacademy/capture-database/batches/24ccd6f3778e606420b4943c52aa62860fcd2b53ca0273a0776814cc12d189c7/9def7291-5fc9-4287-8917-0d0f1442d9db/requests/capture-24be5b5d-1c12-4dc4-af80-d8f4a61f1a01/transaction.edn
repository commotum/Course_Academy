nswer-field-bd1245c8-33c3-58b9-a2e6-9bc9ff66867d" :answer-field/id #uuid "bd1245c8-33c3-58b9-a2e6-9bc9ff66867d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03338e67-3a5f-50b1-9e2b-348d85e8b90f" :answer-field/choices ["answer-c4ae25d6-edc0-50f2-9e62-f7145a4fa070" "answer-6e2ee15b-215a-5257-a4e4-14b6ee854a86" "answer-3e43b2e4-49f3-5882-8f62-2a13517060dd" "answer-e2ea7bef-4f71-579c-a632-4c7089fcda72" "answer-03338e67-3a5f-50b1-9e2b-348d85e8b90f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4ae25d6-edc0-50f2-9e62-f7145a4fa070" :answer/id #uuid "c4ae25d6-edc0-50f2-9e62-f7145a4fa070" :answer/type :answer.type/math :answer/value "w=-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6e2ee15b-215a-5257-a4e4-14b6ee854a86" :answer/id #uuid "6e2ee15b-215a-5257-a4e4-14b6ee854a86" :answer/type :answer.type/math :answer/value "w=-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3e43b2e4-49f3-5882-8f62-2a13517060dd" :answer/id #uuid "3e43b2e4-49f3-5882-8f62-2a13517060dd" :answer/type :answer.type/math :answer/value "w=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e2ea7bef-4f71-579c-a632-4c7089fcda72" :answer/id #uuid "e2ea7bef-4f71-579c-a632-4c7089fcda72" :answer/type :answer.type/math :answer/value "w=\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-03338e67-3a5f-50b1-9e2b-348d85e8b90f" :answer/id #uuid "03338e67-3a5f-50b1-9e2b-348d85e8b90f" :answer/type :answer.type/math :answer/value "w=\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-80d602e5-e159-5437-af51-932d09f28858" :question/id #uuid "80d602e5-e159-5437-af51-932d09f28858" :question/math-academy-id "q-27874" :question/problem "Solve for $j$ where $\\frac{j-4}{5}=\\frac{8+j}{4}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{j-4}{5} & =\\frac{8+j}{4} \\\\ (j-4)\\cdot 4 & =5\\cdot (8+j)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(j-4)\\cdot 4 & =5\\cdot (8+j) \\\\ 4j-16 & =40+5j \\\\ 4j-16-4j & =40+5j-4j \\\\ -16 & =40+j \\\\ -16-40 & =40+j-40 \\\\ -56 & =j\\end{aligned}\n$$\n\nThus, $j=-56.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4c9eab71-bfb0-5eaf-bc3d-28f6d85e461b"] :db/ensure [:question/validate]} {:db/id "answer-field-4c9eab71-bfb0-5eaf-bc3d-28f6d85e461b" :answer-field/id #uuid "4c9eab71-bfb0-5eaf-bc3d-28f6d85e461b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-915f50a1-efdd-572e-b98e-5b9389a72f9f" :answer-field/choices ["answer-66442b7b-dbe0-5cd4-9364-3b3b982ebedf" "answer-915f50a1-efdd-572e-b98e-5b9389a72f9f" "answer-953a511c-1edb-5adb-ad2a-33410e4e47c4" "answer-10a7bd0b-b598-5e1a-b84b-fcaf6a4042be" "answer-bc29baad-d175-5a61-938f-7d573c0d54ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-66442b7b-dbe0-5cd4-9364-3b3b982ebedf" :answer/id #uuid "66442b7b-dbe0-5cd4-9364-3b3b982ebedf" :answer/type :answer.type/math :answer/value "j=-36" :db/ensure [:answer/validate]} {:db/id "answer-915f50a1-efdd-572e-b98e-5b9389a72f9f" :answer/id #uuid "915f50a1-efdd-572e-b98e-5b9389a72f9f" :answer/type :answer.type/math :answer/value "j=-56" :db/ensure [:answer/validate]} {:db/id "answer-953a511c-1edb-5adb-ad2a-33410e4e47c4" :answer/id #uuid "953a511c-1edb-5adb-ad2a-33410e4e47c4" :answer/type :answer.type/math :answer/value "j=-\\frac{56}{5}" :db/ensure [:answer/validate]} {:db/id "answer-10a7bd0b-b598-5e1a-b84b-fcaf6a4042be" :answer/id #uuid "10a7bd0b-b598-5e1a-b84b-fcaf6a4042be" :answer/type :answer.type/math :answer/value "j=38" :db/ensure [:answer/validate]} {:db/id "answer-bc29baad-d175-5a61-938f-7d573c0d54ca" :answer/id #uuid "bc29baad-d175-5a61-938f-7d573c0d54ca" :answer/type :answer.type/math :answer/value "j=65" :db/ensure [:answer/validate]} {:db/id "question-c11f4c73-9d61-5e53-addf-f63464a71f44" :question/id #uuid "c11f4c73-9d61-5e53-addf-f63464a71f44" :question/math-academy-id "q-101686" :question/problem "Solve for $q$ where $\\frac{3-2q}{3}=-\\frac{1}{5}.$" :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{3-2q}{3} & =-\\frac{1}{5} \\\\ (3-2q)\\cdot 5 & =3\\cdot (-1)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(3-2q)\\cdot 5 & =3\\cdot (-1) \\\\ 15-10q & =-3 \\\\ 15-10q-15 & =-3-15 \\\\ -10q & =-18 \\\\ \\frac{-10q}{-10} & =\\frac{-18}{-10} \\\\ q & =\\frac{18}{10} \\\\ q & =\\frac{9}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-960915dd-4a4b-5d1c-93e4-ea54146411f7"] :db/ensure [:question/validate]} {:db/id "answer-field-960915dd-4a4b-5d1c-93e4-ea54146411f7" :answer-field/id #uuid "960915dd-4a4b-5d1c-93e4-ea54146411f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e93faed2-033d-5169-8048-997a878ad719" :answer-field/choices ["answer-39497024-14bb-5050-895b-27fb6f5f066f" "answer-d83e7926-8582-5c97-b830-6e4a6e2d1b6a" "answer-48278a40-4f5d-5c0a-a5e7-ed2ecfeb6701" "answer-df433e95-3bf7-5989-ba4b-f32798e0e17e" "answer-e93faed2-033d-5169-8048-997a878ad719"] :db/ensure [:answer-field/validate]} {:db/id "answer-39497024-14bb-5050-895b-27fb6f5f066f" :answer/id #uuid "39497024-14bb-5050-895b-27fb6f5f066f" :answer/type :answer.type/math :answer/value "q=-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d83e7926-8582-5c97-b830-6e4a6e2d1b6a" :answer/id #uuid "d83e7926-8582-5c97-b830-6e4a6e2d1b6a" :answer/type :answer.type/math :answer/value "q=\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-48278a40-4f5d-5c0a-a5e7-ed2ecfeb6701" :answer/id #uuid "48278a40-4f5d-5c0a-a5e7-ed2ecfeb6701" :answer/type :answer.type/math :answer/value "q=\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "answer-df433e95-3bf7-5989-ba4b-f32798e0e17e" :answer/id #uuid "df433e95-3bf7-5989-ba4b-f32798e0e17e" :answer/type :answer.type/math :answer/value "q=\\frac{9}{10}" :db/ensure [:answer/validate]} {:db/id "answer-e93faed2-033d-5169-8048-997a878ad719" :answer/id #uuid "e93faed2-033d-5169-8048-997a878ad719" :answer/type :answer.type/math :answer/value "q=\\frac{9}{5}" :db/ensure [:answer/validate]} {:db/id "question-bb61cd26-be58-5f6a-a7c8-fd462a5c81f3" :question/id #uuid "bb61cd26-be58-5f6a-a7c8-fd462a5c81f3" :question/math-academy-id "q-171603" :question/problem "If $-\\frac{y+5}{3}=\\frac{4y+3}{5},$ then $y=${{field-1}}." :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}-\\frac{y+5}{3} & =\\frac{4y+3}{5} \\\\ \\frac{-(y+5)}{3} & =\\frac{4y+3}{5} \\\\ \\frac{-y-5}{3} & =\\frac{4y+3}{5} \\\\ (-y-5)\\cdot 5 & =3\\cdot (4y+3)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(-y-5)\\cdot 5 & =3\\cdot (4y+3) \\\\ -5y-25 & =12y+9 \\\\ -5y-25+5y & =12y+9+5y \\\\ -25 & =17y+9 \\\\ -25-9 & =17y+9-9 \\\\ -34 & =17y \\\\ \\frac{-34}{17} & =\\frac{17y}{17} \\\\ -2 & =y\\end{aligned}\n$$\n\nThus, $y=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ec24edad-e55c-5bf9-bba7-969d534095d9"] :db/ensure [:question/validate]} {:db/id "answer-field-ec24edad-e55c-5bf9-bba7-969d534095d9" :answer-field/id #uuid "ec24edad-e55c-5bf9-bba7-969d534095d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-707bf8da-80d9-5773-82eb-bc5fc318d16a" :answer-field/choices ["answer-707bf8da-80d9-5773-82eb-bc5fc318d16a"] :db/ensure [:answer-field/validate]} {:db/id "answer-707bf8da-80d9-5773-82eb-bc5fc318d16a" :answer/id #uuid "707bf8da-80d9-5773-82eb-bc5fc318d16a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186111911 :tutorial/content "If we have rational expressions on both sides of an equation, say,\n\n$$\n\\dfrac{{\\color{red}x-1}}{{\\color{blue}2}} = \\dfrac{{\\color{blue}2x-1}}{{\\color{red}5}},\n$$\n\nthen we can eliminate the rational expressions by applying **cross-multiplication**:\n\n- we cross-multiply the left-hand side numerator $({\\color{red}x-1})$ with the right-hand side denominator $({\\color{red}5}),$ and\n\n- we cross-multiply the left-hand side denominator $({\\color{blue}2})$ with the right-hand side numerator $({\\color{blue}2x-1}).$\n\nDoing this, we get the following equation:\n\n$$\n({\\color{red}x-1}) \\cdot ({\\color{red}5}) = ({\\color{blue}2}) \\cdot ({\\color{blue}2x - 1})\n$$\n\nAfter we've cross-multiplied, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x-1)\\cdot 5 & =2\\cdot (2x-1) \\\\ 5x-5 & =4x-2 \\\\ 5x-5+5 & =4x-2+5 \\\\ 5x & =4x+3 \\\\ 5x-4x & =4x+3-4x \\\\ x & =3\\end{aligned}\n$$\n\n**Note:** Cross-multiplication might seem magical, but it is really just a shortcut for multiplying both sides of the equation by each denominator:\n\n$$\n\\begin{aligned}\\frac{x-1}{2} & =\\frac{2x-1}{5} \\\\ 2\\cdot \\frac{x-1}{2} & =2\\cdot \\frac{2x-1}{5} \\\\ \\cancel{2}\\cdot \\frac{x-1}{\\cancel{2}} & =2\\cdot \\frac{2x-1}{5} \\\\ x-1 & =2\\cdot \\frac{2x-1}{5} \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{5}\\cdot 5 \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{\\cancel{5}}\\cdot \\cancel{5} \\\\ (x-1)\\cdot (5) & =(2)\\cdot (2x-1)\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186111912 :tutorial/content "Consider the following equation:\n\n$$\n\\dfrac{x+1}{2} = -\\dfrac{x}{3}\n$$\n\nEven though one of the fractions is negative, we can still use cross-multiplication. All we have to do is transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{x+1}{2} & =-\\frac{x}{3} \\\\ \\frac{x+1}{2} & =\\frac{-x}{3} \\\\ (x+1)\\cdot 3 & =2\\cdot (-x)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x+1)\\cdot 3 & =2\\cdot (-x) \\\\ 3x+3 & =-2x \\\\ 3x+3-3x & =-2x-3x \\\\ 3 & =-5x \\\\ \\frac{3}{-5} & =\\frac{-5x}{-5} \\\\ -\\frac{3}{5} & =x\\end{aligned}\n$$\n\nTherefore, $x = -\\dfrac{3}{5}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186110809 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} [:db/retract 17592186125048 :question/answer-fields 17592186122888] {:db/id 17592186124572 :knowledge-point/questions ["question-deae4223-84c9-5248-9dcf-afbc4aa0a08d" "question-11fac3f6-18af-5205-bfbf-77c7cc7c000b" "question-e138229b-152f-5c0e-9e47-2d76a5b09b43" "question-cc5327fa-e153-5237-b670-7841684eaae5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-deae4223-84c9-5248-9dcf-afbc4aa0a08d" :question/id #uuid "deae4223-84c9-5248-9dcf-afbc4aa0a08d" :question/math-academy-id "q-37623" :question/problem "Find a $2\\times 2$ matrix $G$ that has eigenvalue ${\\lambda }_{1}=6$ and ${\\lambda }_{2}=8,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}2 \\\\ 3\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$" :question/worked-solution "Since $B=\\{{v}_{1},{v}_{2}\\}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $G,$ then $G$ must be diagonalizable.\n\nSo, we can write $G=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $G,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nG={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}].$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}].\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}G & =[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}][\\begin{aligned}6 & 0 \\\\ 0 & 8\\end{aligned}][\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}12 & 24 \\\\ 18 & 40\\end{aligned}][\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & 12 \\\\ -30 & 26\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d9d99442-fd68-5c6b-a534-caad6d1d2c1d"] :db/ensure [:question/validate]} {:db/id "answer-field-d9d99442-fd68-5c6b-a534-caad6d1d2c1d" :answer-field/id #uuid "d9d99442-fd68-5c6b-a534-caad6d1d2c1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c689ce95-133d-55c0-9ab7-8f7fcb3be04d" :answer-field/choices ["answer-c689ce95-133d-55c0-9ab7-8f7fcb3be04d" "answer-fb917ad6-d3d5-590e-b43c-bf793f4df7ae" "answer-a6de871b-6bde-5f4b-84f9-b6d3cc4d1298" "answer-1308c66e-451d-5de7-9708-faebf7ad18d2" "answer-97e9238d-faff-5840-bb3c-d9b59bc98c68"] :db/ensure [:answer-field/validate]} {:db/id "answer-c689ce95-133d-55c0-9ab7-8f7fcb3be04d" :answer/id #uuid "c689ce95-133d-55c0-9ab7-8f7fcb3be04d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-12 & 12 \\\\ -30 & 26\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fb917ad6-d3d5-590e-b43c-bf793f4df7ae" :answer/id #uuid "fb917ad6-d3d5-590e-b43c-bf793f4df7ae" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & -12 \\\\ -30 & -26\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a6de871b-6bde-5f4b-84f9-b6d3cc4d1298" :answer/id #uuid "a6de871b-6bde-5f4b-84f9-b6d3cc4d1298" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 12 \\\\ 30 & 26\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1308c66e-451d-5de7-9708-faebf7ad18d2" :answer/id #uuid "1308c66e-451d-5de7-9708-faebf7ad18d2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 24 \\\\ 18 & 40\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-97e9238d-faff-5840-bb3c-d9b59bc98c68" :answer/id #uuid "97e9238d-faff-5840-bb3c-d9b59bc98c68" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-11fac3f6-18af-5205-bfbf-77c7cc7c000b" :question/id #uuid "11fac3f6-18af-5205-bfbf-77c7cc7c000b" :question/math-academy-id "q-140129" :question/problem "Find a $2\\times 2$ matrix $C$ that has eigenvalues ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=1,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}4 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Since $B=\\{{v}_{1},{v}_{2}\\}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $C,$ then $C$ must be diagonalizable.\n\nSo, we can write $C=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $C,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nC={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}].$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-2 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 12 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fa3d1395-4451-583c-ab82-a35d131d2416"] :db/ensure [:question/validate]} {:db/id "answer-field-fa3d1395-4451-583c-ab82-a35d131d2416" :answer-field/id #uuid "fa3d1395-4451-583c-ab82-a35d131d2416" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-270ce863-fbe7-5c33-a666-b3f67ca41c13" :answer-field/choices ["answer-e5fe7ace-fda9-51ce-8e39-10efff3a05df" "answer-270ce863-fbe7-5c33-a666-b3f67ca41c13" "answer-a86f3b8b-d239-5334-86f9-ac773c0104db" "answer-49d9d9a6-36c5-5844-a7e2-9ab72fd10336" "answer-cac37090-eba4-5d8f-8620-ada8f0124892"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5fe7ace-fda9-51ce-8e39-10efff3a05df" :answer/id #uuid "e5fe7ace-fda9-51ce-8e39-10efff3a05df" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 \\\\ 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-270ce863-fbe7-5c33-a666-b3f67ca41c13" :answer/id #uuid "270ce863-fbe7-5c33-a666-b3f67ca41c13" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 12 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a86f3b8b-d239-5334-86f9-ac773c0104db" :answer/id #uuid "a86f3b8b-d239-5334-86f9-ac773c0104db" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 2 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-49d9d9a6-36c5-5844-a7e2-9ab72fd10336" :answer/id #uuid "49d9d9a6-36c5-5844-a7e2-9ab72fd10336" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cac37090-eba4-5d8f-8620-ada8f0124892" :answer/id #uuid "cac37090-eba4-5d8f-8620-ada8f0124892" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 \\\\ 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-e138229b-152f-5c0e-9e47-2d76a5b09b43" :question/id #uuid "e138229b-152f-5c0e-9e47-2d76a5b09b43" :question/math-academy-id "q-140130" :question/problem "Find a $2\\times 2$ matrix $A$ that has eigenvalues ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=3,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Since $B=\\{{v}_{1},{v}_{2}\\}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $A$, then  $A$ must be diagonalizable. \n\nSo, we can write $A=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $A$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nA={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}-2 & 1 \\\\ 1 & 1\\end{aligned}].$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}-2 & 1 \\\\ 1 & 1\\end{aligned}]}^{-1}=-\\frac{1}{3}[\\begin{aligned}1 & -1 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain,\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-3 & 0 \\\\ 0 & 3\\end{aligned}](-\\frac{1}{3}[\\begin{aligned}1 & -1 \\\\ -1 & -2\\end{aligned}]) \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ -3 & 3\\end{aligned}][\\begin{aligned}1 & -1 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9f83fb07-7636-5638-848b-073472f388c2"] :db/ensure [:question/validate]} {:db/id "answer-field-9f83fb07-7636-5638-848b-073472f388c2" :answer-field/id #uuid "9f83fb07-7636-5638-848b-073472f388c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-355d0cf5-0e21-5469-ba66-35bad7819086" :answer-field/choices ["answer-576e07b7-0fb2-5793-abac-ace0c9367092" "answer-355d0cf5-0e21-5469-ba66-35bad7819086" "answer-11613836-dbb4-5662-a981-48ed81805197" "answer-4e6dd37f-b440-589a-b70e-3b2462fa691a" "answer-b77c8c33-838e-5a30-8ab4-532fbce97db1"] :db/ensure [:answer-field/validate]} {:db/id "answer-576e07b7-0fb2-5793-abac-ace0c9367092" :answer/id #uuid "576e07b7-0fb2-5793-abac-ace0c9367092" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 2 \\\\ 4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-355d0cf5-0e21-5469-ba66-35bad7819086" :answer/id #uuid "355d0cf5-0e21-5469-ba66-35bad7819086" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 4 \\\\ 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-11613836-dbb4-5662-a981-48ed81805197" :answer/id #uuid "11613836-dbb4-5662-a981-48ed81805197" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 6 \\\\ 2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4e6dd37f-b440-589a-b70e-3b2462fa691a" :answer/id #uuid "4e6dd37f-b440-589a-b70e-3b2462fa691a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & 4 \\\\ 2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b77c8c33-838e-5a30-8ab4-532fbce97db1" :answer/id #uuid "b77c8c33-838e-5a30-8ab4-532fbce97db1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 1 \\\\ -2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-cc5327fa-e153-5237-b670-7841684eaae5" :question/id #uuid "cc5327fa-e153-5237-b670-7841684eaae5" :question/math-academy-id "q-81214" :question/problem "Find a $2\\times 2$ matrix $H$ that has eigenvalues ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=7,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}3 \\\\ -2\\end{aligned}].\n$$" :question/worked-solution "Since $B=\\{{v}_{1},{v}_{2}\\}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $H,$ then $H$ must be diagonalizable.\n\nSo, we can write $H=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $H,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nH={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}-2 & 3 \\\\ 2 & -2\\end{aligned}].$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}-2 & 3 \\\\ 2 & -2\\end{aligned}]}^{-1}=-\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ -2 & -2\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}2 & 3 \\\\ 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}H & =[\\begin{aligned}-2 & 3 \\\\ 2 & -2\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 7\\end{aligned}](\\frac{1}{2}[\\begin{aligned}2 & 3 \\\\ 2 & 2\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}-4 & 21 \\\\ 4 & -14\\end{aligned}][\\begin{aligned}2 & 3 \\\\ 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}17 & 15 \\\\ -10 & -8\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d81e4060-2609-58b6-b5bb-f912fcfd0e40"] :db/ensure [:question/validate]} {:db/id "answer-field-d81e4060-2609-58b6-b5bb-f912fcfd0e40" :answer-field/id #uuid "d81e4060-2609-58b6-b5bb-f912fcfd0e40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-057aa010-a2f3-5746-b90b-2f137e1f8b6c" :answer-field/choices ["answer-b80fd8b2-acfa-59aa-9fc1-c5b51d6b8e92" "answer-63e8d66b-1e0b-5f7d-b802-0676964edc58" "answer-509646ef-2897-5ca4-89bc-3378e2e54d17" "answer-057aa010-a2f3-5746-b90b-2f137e1f8b6c" "answer-87b0027d-9cbb-5571-bb76-84b6d1b610e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-b80fd8b2-acfa-59aa-9fc1-c5b51d6b8e92" :answer/id #uuid "b80fd8b2-acfa-59aa-9fc1-c5b51d6b8e92" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 2 \\\\ -3 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-63e8d66b-1e0b-5f7d-b802-0676964edc58" :answer/id #uuid "63e8d66b-1e0b-5f7d-b802-0676964edc58" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 3 \\\\ 2 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-509646ef-2897-5ca4-89bc-3378e2e54d17" :answer/id #uuid "509646ef-2897-5ca4-89bc-3378e2e54d17" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 21 \\\\ 4 & -14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-057aa010-a2f3-5746-b90b-2f137e1f8b6c" :answer/id #uuid "057aa010-a2f3-5746-b90b-2f137e1f8b6c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}17 & 15 \\\\ -10 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-87b0027d-9cbb-5571-bb76-84b6d1b610e7" :answer/id #uuid "87b0027d-9cbb-5571-bb76-84b6d1b610e7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}34 & 30 \\\\ -20 & -16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186435686 :question/problem "![](images/65/6559dfed58b9456d6eebfd660f7a0d59a60db9db1159561f010f6b7e13e90e5b.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A=\\{(x,y)\\in {R}^{2}\\,:\\,\\bbox[5px,border:1px solid black]{\\phantom{AAAAA}}\\,\\}.\n$$\n\nWhat is the missing expression?" :db/ensure [:question/validate]} {:db/id 17592186262576 :question/problem "Compute $P(X\\ge 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}{e}^{-\\frac{1}{3}x},\\, & x\\ge 0, \\\\ 0,\\, & x<0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186162105 :knowledge-point/questions ["question-654ece2b-abda-569c-8738-da98c426c46e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-654ece2b-abda-569c-8738-da98c426c46e" :question/id #uuid "654ece2b-abda-569c-8738-da98c426c46e" :question/math-academy-id "q-142891" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{3}{20}$ | $\\frac{7}{20}$ |\n| $X=3$ | $\\frac{9}{20}$ | $\\frac{1}{20}$ |\n\nCompute ${f}_{Y|X}(2\\,|\\,3)$ given that the discrete random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "The conditional probability mass function ${f}_{Y|X}(y\\,|\\,x)$ is defined as\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=P(Y=y\\,|\\,X=x).\n$$\n\nTherefore, we're required to compute the conditional probability\n\n$$\n{f}_{Y|X}(2\\,|\\,3)=P(Y=2\\,|\\,X=3).\n$$\n\nBy the multiplication law for conditional probability, we have\n\n$$\nP(Y=2\\,|\\,X=3)=\\frac{P(X=3,Y=2)}{P(X=3)}=\\frac{f(3,2)}{{f}_{X}(3)}\n$$\n\nwhere $f(x,y)$ is the joint probability mass function of $X$ and $Y,$ and ${f}_{X}(x)$ is the marginal distribution of $X.$\n\nRecall that the marginal distribution for $X$ corresponds to the row totals. Thus, \n\n$$\n\\begin{aligned}{f}_{X}(3) & =f(3,2)+f(3,4) \\\\  & =\\frac{9}{20}+\\frac{1}{20} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nFrom the given table, $f(3,2)=\\frac{9}{20}.$ \n\nFinally, substituting  ${f}_{X}(3)=\\frac{1}{2}$ and $f(3,2)=\\frac{9}{20}$ in our formula above, we obtain \n\n$$\n\\begin{aligned}{f}_{Y|X}(2\\,|\\,3) & =P(Y=2\\,|\\,X=3) \\\\  & =\\frac{f(3,2)}{{f}_{X}(3)} \\\\  & =\\frac{(\\frac{9}{20})}{(\\frac{1}{2})} \\\\  & =\\frac{9}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d5318616-df05-5cb7-9c1a-585554d2944f"] :db/ensure [:question/validate]} {:db/id "answer-field-d5318616-df05-5cb7-9c1a-585554d2944f" :answer-field/id #uuid "d5318616-df05-5cb7-9c1a-585554d2944f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1b05117-82ad-54b2-b2bb-0dd42a0b1a3a" :answer-field/choices ["answer-00e65e89-b6a1-56e9-bd5e-da67acd6079c" "answer-1f6777e1-b57b-5667-bba3-1a26c27e63e3" "answer-c5842798-b8d9-5edc-85f3-9c23e26a0409" "answer-59872684-ab61-548c-a315-d38040730c82" "answer-f1b05117-82ad-54b2-b2bb-0dd42a0b1a3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-00e65e89-b6a1-56e9-bd5e-da67acd6079c" :answer/id #uuid "00e65e89-b6a1-56e9-bd5e-da67acd6079c" :answer/type :answer.type/math :answer/value "\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "answer-1f6777e1-b57b-5667-bba3-1a26c27e63e3" :answer/id #uuid "1f6777e1-b57b-5667-bba3-1a26c27e63e3" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c5842798-b8d9-5edc-85f3-9c23e26a0409" :answer/id #uuid "c5842798-b8d9-5edc-85f3-9c23e26a0409" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-59872684-ab61-548c-a315-d38040730c82" :answer/id #uuid "59872684-ab61-548c-a315-d38040730c82" :answer/type :answer.type/math :answer/value "\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-f1b05117-82ad-54b2-b2bb-0dd42a0b1a3a" :answer/id #uuid "f1b05117-82ad-54b2-b2bb-0dd42a0b1a3a" :answer/type :answer.type/math :answer/value "\\frac{9}{10}" :db/ensure [:answer/validate]} {:db/id 17592186244002 :question/problem "Consider the set of matrices $\\{A,B,C\\},$ where \n\n$$\nA=[\\begin{aligned}1 & 1 \\\\ 0 & -2\\end{aligned}],\\,B=[\\begin{aligned}-3 & -1 \\\\ 2 & 4\\end{aligned}],\\,C=[\\begin{aligned}4 & -4 \\\\ -8 & 0\\end{aligned}].\n$$\n\n \nIf the set is linearly dependent, find the value of $\\frac{{x}_{1}}{{x}_{2}}$ from a non-zero solution of ${x}_{1}A+{x}_{2}B+{x}_{3}C=O,$ where $O$ is the $2\\times 2$ zero-matrix." :question/worked-solution "If the set is linearly dependent, then there exist ${x}_{1},{x}_{2},{x}_{3}$ not all zero such that \n\n$$\n{x}_{1}A+{x}_{2}B+{x}_{3}C=O.\n$$\n\nOtherwise, if ${x}_{1}={x}_{2}={x}_{3}=0,$ the set is linearly independent.\n\nSubstituting the matrices $A,$ $B,$ and $C$ into the above equation, we obtain\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & 1 \\\\ 0 & -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 & -1 \\\\ 2 & 4\\end{aligned}]+{x}_{3}[\\begin{aligned}4 & -4 \\\\ -8 & 0\\end{aligned}] & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} & {x}_{1} \\\\ 0 & -2{x}_{1}\\end{aligned}]+[\\begin{aligned}-3{x}_{2} & -{x}_{2} \\\\ 2{x}_{2} & 4{x}_{2}\\end{aligned}]+[\\begin{aligned}4{x}_{3} & -4{x}_{3} \\\\ -8{x}_{3} & 0\\end{aligned}] & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-3{x}_{2}+4{x}_{3} & {x}_{1}-{x}_{2}-4{x}_{3} \\\\ 2{x}_{2}-8{x}_{3} & -2{x}_{1}+4{x}_{2}\\end{aligned}] & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+4{x}_{3}=0 \\\\ {x}_{1}-{x}_{2}-4{x}_{3}=0 \\\\ 2{x}_{2}-8{x}_{3}=0 \\\\ -2{x}_{1}+4{x}_{2}=0.\\end{aligned}\n$$\n\nNow, we consider the corresponding augmented matrix and reduce it to row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 4 & 0 \\\\ 1 & -1 & -4 & 0 \\\\ 0 & 2 & -8 & 0 \\\\ -2 & 4 & 0 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{4}:={R}_{4}+2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 & 0 \\\\ 0 & 2 & -8 & 0 \\\\ 0 & 2 & -8 & 0 \\\\ 0 & -2 & 8 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-1){R}_{2} \\\\ {R}_{4}:={R}_{4}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 & 0 \\\\ 0 & 2 & -8 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe pivot columns are the $1$st and $2$nd.\nHence, ${x}_{3}$ is a free variable.\n\nThe system is now\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+4{x}_{3}=0 \\\\ 2{x}_{2}-8{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the $2$nd equation, we get ${x}_{2}=4{x}_{3}.$ Substitute it into the first equation to get\n\n$$\n{x}_{1}-3(4{x}_{3})+4{x}_{3}=0\\,⟹\\,{x}_{1}=8{x}_{3}.\n$$\n\nTherefore, the general solution is \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}8{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nFinally, for any ${x}_{3}\\ne 0,$ we obtain\n\n$$\n\\frac{{x}_{1}}{{x}_{2}}=\\frac{8{x}_{3}}{4{x}_{3}}=2.\n$$" :db/ensure [:question/validate]} {:db/id 17592186247185 :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(C),$ we need to check if the equation $Cx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[C\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[C\\,|\\,b] & =[\\begin{aligned}-1 & 1 & 9 \\\\ 3 & -3 & -15\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 9 \\\\ 0 & 0 & 12\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}-{x}_{1}+{x}_{2}=9 \\\\ 0=12.\\end{aligned}\n$$\n\nFrom the second equation, we get the false statement $0=12.$  \n\nTherefore, the system is inconsistent, which implies that $b\\notin \\text{Col}(C).$" :db/ensure [:question/validate]} {:db/id "activity-bb01d4c0-3f68-5297-9f60-c8adea4b1367" :activity/id #uuid "bb01d4c0-3f68-5297-9f60-c8adea4b1367" :activity/title "Quiz 13" :activity/type :activity.type/assessment :activity/course 17592186046659 :activity/steps ["step-c020aac7-1d38-5f8f-b075-932e7e1bd2f4" "step-5f82d4c3-6ad0-5437-a241-aa312d21db9a" "step-f4443014-39ed-506a-8948-cdb1d1bbd3dc" "step-9e1807a1-8b23-5dd3-a9e7-c95b3dc3240c" "step-677d728d-bb6f-5792-9c71-0a5fd4ba06a6" "step-d01dd3dd-5bce-53ef-8116-9c3068e78cf0" "step-ee6d079f-b993-59ba-ae60-9055f587a19a"] :activity/first-step "step-c020aac7-1d38-5f8f-b075-932e7e1bd2f4" :db/ensure [:activity/validate]} {:db/id "step-c020aac7-1d38-5f8f-b075-932e7e1bd2f4" :step/id #uuid "c020aac7-1d38-5f8f-b075-932e7e1bd2f4" :step/content 17592186435686 :step/next "step-5f82d4c3-6ad0-5437-a241-aa312d21db9a" :db/ensure [:step/validate]} {:db/id "step-5f82d4c3-6ad0-5437-a241-aa312d21db9a" :step/id #uuid "5f82d4c3-6ad0-5437-a241-aa312d21db9a" :step/content 17592186262576 :step/next "step-f4443014-39ed-506a-8948-cdb1d1bbd3dc" :db/ensure [:step/validate]} {:db/id "step-f4443014-39ed-506a-8948-cdb1d1bbd3dc" :step/id #uuid "f4443014-39ed-506a-8948-cdb1d1bbd3dc" :step/content 17592186148197 :step/next "step-9e1807a1-8b23-5dd3-a9e7-c95b3dc3240c" :db/ensure [:step/validate]} {:db/id "step-9e1807a1-8b23-5dd3-a9e7-c95b3dc3240c" :step/id #uuid "9e1807a1-8b23-5dd3-a9e7-c95b3dc3240c" :step/content "question-654ece2b-abda-569c-8738-da98c426c46e" :step/next "step-677d728d-bb6f-5792-9c71-0a5fd4ba06a6" :db/ensure [:step/validate]} {:db/id "step-677d728d-bb6f-5792-9c71-0a5fd4ba06a6" :step/id #uuid "677d728d-bb6f-5792-9c71-0a5fd4ba06a6" :step/content 17592186244002 :step/next "step-d01dd3dd-5bce-53ef-8116-9c3068e78cf0" :db/ensure [:step/validate]} {:db/id "step-d01dd3dd-5bce-53ef-8116-9c3068e78cf0" :step/id #uuid "d01dd3dd-5bce-53ef-8116-9c3068e78cf0" :step/content 17592186247185 :step/next "step-ee6d079f-b993-59ba-ae60-9055f587a19a" :db/ensure [:step/validate]} {:db/id "step-ee6d079f-b993-59ba-ae60-9055f587a19a" :step/id #uuid "ee6d079f-b993-59ba-ae60-9055f587a19a" :step/content 17592186398375 :db/ensure [:step/validate]} {:db/id 17592186134312 :question/problem "$$\nA=[\\begin{aligned}3 & 2 \\\\ -1 & 1 \\\\ 0 & 2\\end{aligned}],\\,B=\\{[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{a}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 3+1\\cdot (-1)+2\\cdot 0}{{3}^{2}+(-1)^{2}+{0}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-\\frac{1}{2}[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 2\\end{aligned}]\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{1}{2},$ $b=\\frac{3}{2},$ and  \n\n$$\n\\frac{b}{a}=\\frac{(\\frac{3}{2})}{(\\frac{1}{2})}=3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186414750 :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}2 \\\\ 1 \\\\ 3\\end{aligned}],[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}2 \\\\ 1 \\\\ 3\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ 1 \\\\ 3\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 2+4\\cdot 1+2\\cdot 3}{{2}^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}]-[\\begin{aligned}2 \\\\ 1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis.\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{2}^{2}+{1}^{2}+{3}^{2}}}[\\begin{aligned}2 \\\\ 1 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}}[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}]=[\\begin{aligned}0 \\\\ \\frac{3\\sqrt{10}}{10} \\\\ -\\frac{\\sqrt{10}}{10}\\end{aligned}].$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{[\\begin{aligned}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{aligned}],[\\begin{aligned}0 \\\\ \\frac{3\\sqrt{10}}{10} \\\\ -\\frac{\\sqrt{10}}{10}\\end{aligned}]\\}$ is an orthonormal basis for $V.$\n\nFinally, $a=0,$ $b=\\frac{3\\sqrt{10}}{10},$ $c=-\\frac{\\sqrt{10}}{10}$ and  \n\n$$\n|a|+|b|+|c|=|\\,0\\,|+|\\frac{3\\sqrt{10}}{10}|+|-\\frac{\\sqrt{10}}{10}|=\\frac{2\\sqrt{10}}{5}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186351263 :question/problem "$$\nA=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ 1 & 6\\end{aligned}],\\,B=\\{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{c}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+5\\cdot (-1)+6\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 5 \\\\ 6\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 6 \\\\ 5\\end{aligned}]\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=6,$ $c=5,$ and  \n\n$$\n\\frac{b}{c}=\\frac{6}{5}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186366525 :question/problem "$$\nA=[\\begin{aligned}1 & 2 \\\\ 2 & 1 \\\\ -1 & 2\\end{aligned}],\\,B=\\{[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{a}{b}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+1\\cdot 2+2\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-\\frac{1}{3}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{aligned}]\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{5}{3},$ $b=\\frac{1}{3},$ and  \n\n$$\n\\frac{a}{b}=\\frac{(\\frac{5}{3})}{(\\frac{1}{3})}=5.\n$$" :db/ensure [:question/validate]} {:db/id 17592186272129 :question/problem "$$\nV=\\text{Span}\\{[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]\\},\\,B=\\{[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}],[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\\,$ and $\\,{a}_{2}=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+2\\cdot 0+0\\cdot 1}{{1}^{2}+{0}^{2}+{1}^{2}}{v}_{1} \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}].$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{2}^{2}+{(-1)}^{2}}}[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}].$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}],[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{aligned}]\\}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{6}}{6},$ $b=\\frac{\\sqrt{6}}{3},$ $c=-\\frac{\\sqrt{6}}{6}$ and   \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{6}}{6}|+|\\,\\frac{\\sqrt{6}}{3}\\,|+|-\\frac{\\sqrt{6}}{6}|=\\frac{2\\sqrt{6}}{3}.\n$$" :db/ensure [:question/validate]} {:db/id "activity-b5c39511-7dca-5f46-9bd0-18a600b280c7" :activity/id #uuid "b5c39511-7dca-5f46-9bd0-18a600b280c7" :activity/title "The Gram-Schmidt Process for Two Vectors" :activity/type :activity.type/review :activity/scope 17592186050578 :activity/course 17592186046658 :activity/steps ["step-6d9cca53-b8e7-5866-80ca-e525fd9507fe" "step-4ef5a9e1-a6f9-549c-8de0-627265244a96" "step-b145ad9e-f7c2-5436-b124-365beca417e7" "step-515565f3-dbe0-5771-aba6-dfe3cfe75b5d" "step-32bcfa5a-91f6-5b5e-bb38-21b8b56078c2"] :activity/first-step "step-6d9cca53-b8e7-5866-80ca-e525fd9507fe" :db/ensure [:activity/validate]} {:db/id "step-6d9cca53-b8e7-5866-80ca-e525fd9507fe" :step/id #uuid "6d9cca53-b8e7-5866-80ca-e525fd9507fe" :step/content 17592186134312 :step/next "step-4ef5a9e1-a6f9-549c-8de0-627265244a96" :db/ensure [:step/validate]} {:db/id "step-4ef5a9e1-a6f9-549c-8de0-627265244a96" :step/id #uuid "4ef5a9e1-a6f9-549c-8de0-627265244a96" :step/content 17592186414750 :step/next "step-b145ad9e-f7c2-5436-b124-365beca417e7" :db/ensure [:step/validate]} {:db/id "step-b145ad9e-f7c2-5436-b124-365beca417e7" :step/id #uuid "b145ad9e-f7c2-5436-b124-365beca417e7" :step/content 17592186351263 :step/next "step-515565f3-dbe0-5771-aba6-dfe3cfe75b5d" :db/ensure [:step/validate]} {:db/id "step-515565f3-dbe0-5771-aba6-dfe3cfe75b5d" :step/id #uuid "515565f3-dbe0-5771-aba6-dfe3cfe75b5d" :step/content 17592186366525 :step/next "step-32bcfa5a-91f6-5b5e-bb38-21b8b56078c2" :db/ensure [:step/validate]} {:db/id "step-32bcfa5a-91f6-5b5e-bb38-21b8b56078c2" :step/id #uuid "32bcfa5a-91f6-5b5e-bb38-21b8b56078c2" :step/content 17592186272129 :db/ensure [:step/validate]} [:db/retract 17592186129697 :question/answer-fields 17592186127663] {:db/id 17592186129697 :question/problem "$$\nB=\\{[\\begin{aligned}11 \\\\ -5\\end{aligned}],[\\begin{aligned}6 \\\\ -3\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ -1\\end{aligned}],[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}1 & 2 \\\\ -2 & -3\\end{aligned}]\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 11 & 6 \\\\ -1 & 1 & -5 & -3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 11 & 6 \\\\ 0 & 3 & 6 & 3\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 11 & 6 \\\\ 0 & 1 & 2 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & 4 \\\\ 0 & 1 & 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}7 & 4 \\\\ 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}7 & 4 \\\\ 2 & 1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{1\\cdot 7-2\\cdot 4}[\\begin{aligned}1 & -4 \\\\ -2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 \\\\ 2 & -7\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}7 & 4 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -2 & -3\\end{aligned}][\\begin{aligned}-1 & 4 \\\\ 2 & -7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 4 \\\\ 2 & -7\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -18 \\\\ 2 & -7\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186360754 :question/problem "$$\nB=\\{[\\begin{aligned}-3 \\\\ -1\\end{aligned}],[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}2 & 2 \\\\ 2 & 3\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" :db/ensure [:question/validate]} {:db/id 17592186395263 :question/problem "$$\nB=\\{[\\begin{aligned}-2 \\\\ -1\\end{aligned}],[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}-2 \\\\ -3\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}]\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & -2 & 1 \\\\ 2 & -3 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -2 & 1 \\\\ 0 & 1 & 3 & -2\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & -3 \\\\ 0 & 1 & 3 & -2\\end{aligned}]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}4 & -3 \\\\ 3 & -2\\end{aligned}].\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}4 & -3 \\\\ 3 & -2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot (-2)-(-3)\\cdot 3}[\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}4 & -3 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 \\\\ -3 & 4\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186272105 :question/problem "$$\nB=\\{[\\begin{aligned}4 \\\\ -1\\end{aligned}],[\\begin{aligned}5 \\\\ -1\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" :db/ensure [:question/validate]} {:db/id "activity-66f1714e-7bb9-59f0-b954-2026d5c8080b" :activity/id #uuid "66f1714e-7bb9-59f0-b954-2026d5c8080b" :activity/title "Connections Between Matrix Representations of a Linear Transformation" :activity/type :activity.type/review :activity/scope 17592186050324 :activity/course 17592186046659 :activity/steps ["step-511ccafa-e28b-5ce5-8ce9-e4025e74a362" "step-5cef157a-71ae-54ad-924f-79f27027d30c" "step-be618910-dbda-5153-91ac-000b728f4deb" "step-cb8b79c9-9224-5432-a419-5e30ce55873d" "step-2d7e0158-2616-5cb3-ae9b-81b04c5bccd8"] :activity/first-step "step-511ccafa-e28b-5ce5-8ce9-e4025e74a362" :db/ensure [:activity/validate]} {:db/id "step-511ccafa-e28b-5ce5-8ce9-e4025e74a362" :step/id #uuid "511ccafa-e28b-5ce5-8ce9-e4025e74a362" :step/content 17592186129697 :step/next "step-5cef157a-71ae-54ad-924f-79f27027d30c" :db/ensure [:step/validate]} {:db/id "step-5cef157a-71ae-54ad-924f-79f27027d30c" :step/id #uuid "5cef157a-71ae-54ad-924f-79f27027d30c" :step/content 17592186395229 :step/next "step-be618910-dbda-5153-91ac-000b728f4deb" :db/ensure [:step/validate]} {:db/id "step-be618910-dbda-5153-91ac-000b728f4deb" :step/id #uuid "be618910-dbda-5153-91ac-000b728f4deb" :step/content 17592186360754 :step/next "step-cb8b79c9-9224-5432-a419-5e30ce55873d" :db/ensure [:step/validate]} {:db/id "step-cb8b79c9-9224-5432-a419-5e30ce55873d" :step/id #uuid "cb8b79c9-9224-5432-a419-5e30ce55873d" :step/content 17592186395263 :step/next "step-2d7e0158-2616-5cb3-ae9b-81b04c5bccd8" :db/ensure [:step/validate]} {:db/id "step-2d7e0158-2616-5cb3-ae9b-81b04c5bccd8" :step/id #uuid "2d7e0158-2616-5cb3-ae9b-81b04c5bccd8" :step/content 17592186272105 :db/ensure [:step/validate]} [:db/retract 17592186392052 :answer-field/choices 17592186392053] [:db/retract 17592186392052 :answer-field/choices 17592186392054] [:db/retract 17592186392052 :answer-field/choices 17592186392055] [:db/retract 17592186392052 :answer-field/choices 17592186392056] [:db/retract 17592186392052 :answer-field/choices 17592186392057] [:db/retract 17592186125026 :question/answer-fields 17592186122756] {:db/id 17592186125026 :question/worked-solution "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\lambda =3.$ So, we get \n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}1 & 2 & 4 \\\\ 2 & 1 & -4 \\\\ 0 & 0 & 3\\end{aligned}]-3[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & 2 & 4 \\\\ 2 & -2 & -4 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nTo find the eigenvectors, we have to solve the corresponding homogeneous system of linear equations:\n\n$$\n\\{\\begin{aligned}-2{x}_{1}+2{x}_{2}+4{x}_{3}=0 \\\\ 2{x}_{1}-2{x}_{2}-4{x}_{3}=0 \\\\ 0=0\\end{aligned}\n$$\n\nSo, we row-reduce the augmented matrix $M$ to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-2 & 2 & 4 & 0 \\\\ 2 & -2 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 2 & 4 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ and ${x}_{3}$ are free variables. From the first equation, we obtain ${x}_{1}={x}_{2}+2{x}_{3}.$ So, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2}+2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},{x}_{3}\\in R.\n$$\n\nTherefore, the required basis is\n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186392052 :answer-field/correct "answer-74b0e7f5-2b62-5fc6-aedb-9e89d49734ff" :answer-field/choices ["answer-2509f728-ac88-5bed-b4bc-f65ab44a09f7" "answer-cc737dfa-d79a-5691-830c-1dd76a950b83" "answer-74b0e7f5-2b62-5fc6-aedb-9e89d49734ff" "answer-3135f463-b0a3-501e-8b97-a96f0c5dd206" "answer-6d5a7fa3-33d4-5918-8e1a-47402e58086f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2509f728-ac88-5bed-b4bc-f65ab44a09f7" :answer/id #uuid "2509f728-ac88-5bed-b4bc-f65ab44a09f7" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-1 \\\\ -1 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-cc737dfa-d79a-5691-830c-1dd76a950b83" :answer/id #uuid "cc737dfa-d79a-5691-830c-1dd76a950b83" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-74b0e7f5-2b62-5fc6-aedb-9e89d49734ff" :answer/id #uuid "74b0e7f5-2b62-5fc6-aedb-9e89d49734ff" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-3135f463-b0a3-501e-8b97-a96f0c5dd206" :answer/id #uuid "3135f463-b0a3-501e-8b97-a96f0c5dd206" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-6d5a7fa3-33d4-5918-8e1a-47402e58086f" :answer/id #uuid "6d5a7fa3-33d4-5918-8e1a-47402e58086f" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id 17592186124526 :knowledge-point/questions ["question-3be1ddbd-2595-5ba8-8ba6-f7f8cb00a8ea"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3be1ddbd-2595-5ba8-8ba6-f7f8cb00a8ea" :question/id #uuid "3be1ddbd-2595-5ba8-8ba6-f7f8cb00a8ea" :question/math-academy-id "q-36989" :question/problem "$$\nA=[\\begin{aligned}1 & 5 & 1 \\\\ 0 & -3 & 0 \\\\ -8 & -10 & -5\\end{aligned}]\n$$\n\nConsider the matrix $A$ shown above. What are the dimensions of the eigenspaces ${V}_{-3}$ and ${V}_{-1}$ corresponding to eigenvalues $\\lambda =-3$ and $\\lambda =-1$ of $A$, respectively?" :question/worked-solution "First, we write down the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I)=0 \\\\ |\\begin{aligned}1-\\lambda  & 5 & 1 \\\\ 0 & -3-\\lambda  & 0 \\\\ -8 & -10 & -5-\\lambda \\end{aligned}|=0 \\\\ (-3-\\lambda )|\\begin{aligned}1-\\lambda  & 1 \\\\ -8 & -5-\\lambda \\end{aligned}|=0 \\\\ (-3-\\lambda )((1-\\lambda )(-5-\\lambda )+8)=0 \\\\ -(\\lambda +3)({\\lambda }^{2}+4\\lambda +3)=0 \\\\ (\\lambda +3)(\\lambda +3)(\\lambda +1)=0 \\\\ (\\lambda +3)^{2}(\\lambda +1)=0.\\end{aligned}\n$$\n\nHence, ${\\lambda }_{1}={\\lambda }_{2}=-3$ (double root) and ${\\lambda }_{3}=-1$ (simple root).\n\nLet's now consider the eigenspaces corresponding to each eigenvector:\n\n- First, we consider $\\lambda =-1.$ Since ${V}_{-1}$ corresponds to a simple root, we obtain \n\n$$\n\\text{dim}({V}_{-1})=1.\n$$\n\n- Then, we consider $\\lambda =-3,$ which is a repeated root of the characteristic equation. To find the dimension of ${V}_{-3},$ we row-reduce the matrix $(A-(-3)I)\\text{x}=0:$ \n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}1 & 5 & 1 \\\\ 0 & -3 & 0 \\\\ -8 & -10 & -5\\end{aligned}]-(-3)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 5 & 1 \\\\ 0 & 0 & 0 \\\\ -8 & -10 & -2\\end{aligned}] &  & {R}_{3}:={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}4 & 5 & 1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). This implies that we will have $3-1=2$ linearly independent eigenvectors corresponding to the eigenvalue $\\lambda =-3.$ Therefore, \n\n$$\n\\text{dim}({V}_{-3})=2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5c1f5525-34b9-510b-9cff-55fc25573d40"] :db/ensure [:question/validate]} {:db/id "answer-field-5c1f5525-34b9-510b-9cff-55fc25573d40" :answer-field/id #uuid "5c1f5525-34b9-510b-9cff-55fc25573d40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c35cd5d-47c0-50b0-a8bd-511652da4e2b" :answer-field/choices ["answer-50b38021-75c4-5508-bab4-848c4e9ba21b" "answer-6ff84b2c-d2ec-5a30-93db-ee03d608ec09" "answer-6c35cd5d-47c0-50b0-a8bd-511652da4e2b" "answer-f73994c3-ca97-5f8d-a150-404ff255dfa6" "answer-f7e829c3-1d72-5b02-918e-017cff2d8b7c"] :db/ensure [:answer-field/validate]} {:db/id "answer-50b38021-75c4-5508-bab4-848c4e9ba21b" :answer/id #uuid "50b38021-75c4-5508-bab4-848c4e9ba21b" :answer/type :answer.type/text :answer/value "$\\text{dim}({V}_{-3})=1$ and $\\text{dim}({V}_{-1})=1$" :db/ensure [:answer/validate]} {:db/id "answer-6ff84b2c-d2ec-5a30-93db-ee03d608ec09" :answer/id #uuid "6ff84b2c-d2ec-5a30-93db-ee03d608ec09" :answer/type :answer.type/text :answer/value "$\\text{dim}({V}_{-3})=1$ and $\\text{dim}({V}_{-1})=2$" :db/ensure [:answer/validate]} {:db/id "answer-6c35cd5d-47c0-50b0-a8bd-511652da4e2b" :answer/id #uuid "6c35cd5d-47c0-50b0-a8bd-511652da4e2b" :answer/type :answer.type/text :answer/value "$\\text{dim}({V}_{-3})=2$ and $\\text{dim}({V}_{-1})=1$" :db/ensure [:answer/validate]} {:db/id "answer-f73994c3-ca97-5f8d-a150-404ff255dfa6" :answer/id #uuid "f73994c3-ca97-5f8d-a150-404ff255dfa6" :answer/type :answer.type/text :answer/value "$\\text{dim}({V}_{-3})=2$ and $\\text{dim}({V}_{-1})=2$" :db/ensure [:answer/validate]} {:db/id "answer-f7e829c3-1d72-5b02-918e-017cff2d8b7c" :answer/id #uuid "f7e829c3-1d72-5b02-918e-017cff2d8b7c" :answer/type :answer.type/text :answer/value "$\\text{dim}({V}_{-3})=3$ and $\\text{dim}({V}_{-1})=0$" :db/ensure [:answer/validate]} {:db/id "activity-f6dcea7e-30b4-5053-8609-92078e523ce5" :activity/id #uuid "f6dcea7e-30b4-5053-8609-92078e523ce5" :activity/title "Calculating the Eigenvectors of a 3x3 Matrix in the General Case" :activity/type :activity.type/review :activity/scope 17592186050857 :activity/course 17592186046658 :activity/steps ["step-f5cc6ef7-88e0-5121-8a25-266950648356" "step-a573b5ad-12de-5838-9555-2e6712ed23a1" "step-96ba342a-7051-5aec-bb1e-1e67c17f68b4" "step-d87f46bf-d206-5ca2-8006-fb7a70a4a107" "step-ae50cb87-f735-5ee6-b501-f9b2bf5f7df3"] :activity/first-step "step-f5cc6ef7-88e0-5121-8a25-266950648356" :db/ensure [:activity/validate]} {:db/id "step-f5cc6ef7-88e0-5121-8a25-266950648356" :step/id #uuid "f5cc6ef7-88e0-5121-8a25-266950648356" :step/content 17592186125026 :step/next "step-a573b5ad-12de-5838-9555-2e6712ed23a1" :db/ensure [:step/validate]} {:db/id "step-a573b5ad-12de-5838-9555-2e6712ed23a1" :step/id #uuid "a573b5ad-12de-5838-9555-2e6712ed23a1" :step/content "question-3be1ddbd-2595-5ba8-8ba6-f7f8cb00a8ea" :step/next "step-96ba342a-7051-5aec-bb1e-1e67c17f68b4" :db/ensure [:step/validate]} {:db/id "step-96ba342a-7051-5aec-bb1e-1e67c17f68b4" :step/id #uuid "96ba342a-7051-5aec-bb1e-1e67c17f68b4" :step/content 17592186125070 :step/next "step-d87f46bf-d206-5ca2-8006-fb7a70a4a107" :db/ensure [:step/validate]} {:db/id "step-d87f46bf-d206-5ca2-8006-fb7a70a4a107" :step/id #uuid "d87f46bf-d206-5ca2-8006-fb7a70a4a107" :step/content 17592186323921 :step/next "step-ae50cb87-f735-5ee6-b501-f9b2bf5f7df3" :db/ensure [:step/validate]} {:db/id "step-ae50cb87-f735-5ee6-b501-f9b2bf5f7df3" :step/id #uuid "ae50cb87-f735-5ee6-b501-f9b2bf5f7df3" :step/content 17592186395174 :db/ensure [:step/validate]} [:db/retract 17592186071276 :answer-field/choices 17592186071280] [:db/retract 17592186071276 :answer-field/choices 17592186071281] [:db/retract 17592186071276 :answer-field/choices 17592186071277] [:db/retract 17592186071276 :answer-field/choices 17592186071278] [:db/retract 17592186071276 :answer-field/choices 17592186071279] {:db/id 17592186073741 :knowledge-point/questions ["question-de5674f7-089c-5512-bf55-3b781441e00f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073507 :question/problem "![](images/1a/1afba9a36c6fd04fecfd50877181380776e13a83422697de4a39d71381f09aff.png)\n\n \n\nFind the value of $x$ in the triangle above." :question/worked-solution "Since the sum of the measures of the interior angles in any triangle is equal to $180^\\circ$, we have \n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ {36}^{∘}+{112}^{∘}+x & ={180}^{∘} \\\\ {148}^{∘}+x & ={180}^{∘} \\\\ x & ={32}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073742 :knowledge-point/questions ["question-25ca3a8d-acc3-599f-b660-f34015483f42" "question-8267e27a-d7e7-55df-b9b5-74944df1c40e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073508 :question/problem "![](images/e4/e43daa39b169c8ba29c21dd33e7a7fab1e92c7c78eafbd1021971e1883f6c9f8.png)\n\n \n\nFind the measure of $\\angle C.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is $180^\\circ$, we have\n\n$$\n\\begin{aligned}3z+4z+{40}^{∘} & ={180}^{∘} \\\\ 7z+{40}^{∘} & ={180}^{∘} \\\\ 7z & ={140}^{∘} \\\\ z & ={20}^{∘}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}m∠C & =4z \\\\  & =4({20}^{∘}) \\\\  & ={80}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073743 :knowledge-point/questions ["question-627791d7-dc7c-50b5-b4d8-fdfd901f4303" "question-08ae86f4-7baa-5fd1-bf6d-dfc10d8069d6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073509 :question/problem "Consider a triangle $\\triangle ABC$, where $m\\angle{A} = 55^\\circ$, $m\\angle B = x + 10^\\circ$, and $m\\angle C = 3x - 5^\\circ.$ Find the value of $x.$" :question/worked-solution "The sum of the measures of the interior angles must be $180^\\circ.$ Therefore,\n\n$$\n\\begin{aligned}{55}^{∘}+(x+{10}^{∘})+(3x-{5}^{∘}) & ={180}^{∘} \\\\ {60}^{∘}+4x & ={180}^{∘} \\\\ 4x & ={120}^{∘} \\\\ x & ={30}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073744 :knowledge-point/questions ["question-a74d4f60-688d-582a-8efa-ef124e45e804" "question-b302caff-8016-5932-bece-17fa5667969f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073510 :question/problem "![](images/1a/1a24187f280eb99640c3d1bfae3b7fe873383f04c2c492e7873a40de16a9560b.png)\n\nFind the measure of angle $C$ given that $m\\angle{A} = m\\angle{B}.$" :question/worked-solution "Using $m\\angle{A} = m\\angle{B},$ we get\n\n$$\n\\begin{aligned}m∠A & =m∠B \\\\ 3x-{27}^{∘} & =2x \\\\ x & ={27}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $x=27^\\circ$ in the expression for $m\\angle B,$ we get\n\n$$\nm\\angle{B}=2(27^\\circ)=54^\\circ.\n$$\n\nNow, we can find $m\\angle C$ using the fact that the internal angles of any triangle sum to $180^\\circ$:\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ 2m∠B+m∠C & ={180}^{∘} \\\\ 2\\cdot {54}^{∘}+m∠C & ={180}^{∘} \\\\ {108}^{∘}+m∠C & ={180}^{∘} \\\\ m∠C & ={72}^{∘}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-de5674f7-089c-5512-bf55-3b781441e00f" :question/id #uuid "de5674f7-089c-5512-bf55-3b781441e00f" :question/math-academy-id "q-235484" :question/problem "![](images/59/5948fac552a311cfac7023171d07b41261fade92d026a747f87d3865d22e9307.png)\n\nIn the figure above, $x=${{field-1}}${}^{∘}.$" :question/worked-solution "Since the sum of the measures of the interior angles in any triangle is equal to ${180}^{∘}$, we have \n\n$$\n\\begin{aligned}{47}^{∘}+{58}^{∘}+x & ={180}^{∘} \\\\ {105}^{∘}+x & ={180}^{∘} \\\\ x & ={75}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c00b6c87-f0b2-52e4-893d-66fe637fc6c1"] :db/ensure [:question/validate]} {:db/id "answer-field-c00b6c87-f0b2-52e4-893d-66fe637fc6c1" :answer-field/id #uuid "c00b6c87-f0b2-52e4-893d-66fe637fc6c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-87d8a051-5f02-51fd-9928-bdea3b9de44d" :answer-field/choices ["answer-87d8a051-5f02-51fd-9928-bdea3b9de44d"] :db/ensure [:answer-field/validate]} {:db/id "answer-87d8a051-5f02-51fd-9928-bdea3b9de44d" :answer/id #uuid "87d8a051-5f02-51fd-9928-bdea3b9de44d" :answer/type :answer.type/math :answer/value "75" :db/ensure [:answer/validate]} {:db/id 17592186074173 :question/problem "![](images/72/7210d4af96bf9c4c6c347b9dd91712b14aa9cd8cc21ed5f8535e0546db03068e.png)\n\nDetermine the value of $x.$" :question/worked-solution "Since the sum of the measures of the interior angles in any triangle is equal to ${180}^{∘}$, we have \n\n$$\n\\begin{aligned}{107}^{∘}+{41}^{∘}+x & ={180}^{∘} \\\\ {148}^{∘}+x & ={180}^{∘} \\\\ x & ={32}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186071276 :answer-field/correct "answer-c6ed0507-243d-5635-bf43-6ed307ba7acc" :answer-field/choices ["answer-39519a65-41fa-58d3-a9ab-af15c15632f2" "answer-de713acd-b8a8-581b-8169-02492745c3da" "answer-c6ed0507-243d-5635-bf43-6ed307ba7acc" "answer-51d79d3e-ffef-54c3-b160-38d95fa8a3f1" "answer-cddeecfe-39d9-5a7e-b481-f79efa573fa1"] :db/ensure [:answer-field/validate]} {:db/id "answer-39519a65-41fa-58d3-a9ab-af15c15632f2" :answer/id #uuid "39519a65-41fa-58d3-a9ab-af15c15632f2" :answer/type :answer.type/math :answer/value "{29}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-de713acd-b8a8-581b-8169-02492745c3da" :answer/id #uuid "de713acd-b8a8-581b-8169-02492745c3da" :answer/type :answer.type/math :answer/value "{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c6ed0507-243d-5635-bf43-6ed307ba7acc" :answer/id #uuid "c6ed0507-243d-5635-bf43-6ed307ba7acc" :answer/type :answer.type/math :answer/value "{32}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-51d79d3e-ffef-54c3-b160-38d95fa8a3f1" :answer/id #uuid "51d79d3e-ffef-54c3-b160-38d95fa8a3f1" :answer/type :answer.type/math :answer/value "{33}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-cddeecfe-39d9-5a7e-b481-f79efa573fa1" :answer/id #uuid "cddeecfe-39d9-5a7e-b481-f79efa573fa1" :answer/type :answer.type/math :answer/value "{34}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-25ca3a8d-acc3-599f-b660-f34015483f42" :question/id #uuid "25ca3a8d-acc3-599f-b660-f34015483f42" :question/math-academy-id "q-235771" :question/problem "![](images/4f/4f01fa959d7370cecc91a7c54575b8d1022cbbb73d422f381e1766de03801822.png)\n\nIn the figure above, $z=${{field-1}}${}^{∘}.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{40}^{∘}+z+3z & ={180}^{∘} \\\\ {40}^{∘}+4z & ={180}^{∘} \\\\ 4z & ={140}^{∘} \\\\ z & ={35}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-638e8bb3-8293-5757-a197-ed8d4b35c801"] :db/ensure [:question/validate]} {:db/id "answer-field-638e8bb3-8293-5757-a197-ed8d4b35c801" :answer-field/id #uuid "638e8bb3-8293-5757-a197-ed8d4b35c801" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-95953537-bb26-5133-a073-10cfe30ce372" :answer-field/choices ["answer-95953537-bb26-5133-a073-10cfe30ce372"] :db/ensure [:answer-field/validate]} {:db/id "answer-95953537-bb26-5133-a073-10cfe30ce372" :answer/id #uuid "95953537-bb26-5133-a073-10cfe30ce372" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "question-8267e27a-d7e7-55df-b9b5-74944df1c40e" :question/id #uuid "8267e27a-d7e7-55df-b9b5-74944df1c40e" :question/math-academy-id "q-116736" :question/problem "![](images/ad/adcb81c2fd7553c458ce24b8668f383f9b54024225a0e88b548140cb19d3e28a.png)\n\nCalculate the value of $x.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{60}^{∘}+x+(x+{10}^{∘}) & ={180}^{∘} \\\\ {70}^{∘}+2x & ={180}^{∘} \\\\ 2x & ={110}^{∘} \\\\ x & ={55}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-905c4b8e-ca2d-5007-a994-36c7632f0c77"] :db/ensure [:question/validate]} {:db/id "answer-field-905c4b8e-ca2d-5007-a994-36c7632f0c77" :answer-field/id #uuid "905c4b8e-ca2d-5007-a994-36c7632f0c77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be9ab1c1-9561-58e8-8126-57e36fa310a9" :answer-field/choices ["answer-bc064fe0-32c2-5d25-9649-f46fb8ab8970" "answer-2d803c04-105c-51d2-a746-10efb22d5569" "answer-be9ab1c1-9561-58e8-8126-57e36fa310a9" "answer-31fab04f-4282-55ee-9b17-8e52efeb4b03" "answer-79661e7e-8c05-56e7-960f-348eaa5f9f6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc064fe0-32c2-5d25-9649-f46fb8ab8970" :answer/id #uuid "bc064fe0-32c2-5d25-9649-f46fb8ab8970" :answer/type :answer.type/math :answer/value "{50}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-2d803c04-105c-51d2-a746-10efb22d5569" :answer/id #uuid "2d803c04-105c-51d2-a746-10efb22d5569" :answer/type :answer.type/math :answer/value "{53}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-be9ab1c1-9561-58e8-8126-57e36fa310a9" :answer/id #uuid "be9ab1c1-9561-58e8-8126-57e36fa310a9" :answer/type :answer.type/math :answer/value "{55}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-31fab04f-4282-55ee-9b17-8e52efeb4b03" :answer/id #uuid "31fab04f-4282-55ee-9b17-8e52efeb4b03" :answer/type :answer.type/math :answer/value "{57}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-79661e7e-8c05-56e7-960f-348eaa5f9f6c" :answer/id #uuid "79661e7e-8c05-56e7-960f-348eaa5f9f6c" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-627791d7-dc7c-50b5-b4d8-fdfd901f4303" :question/id #uuid "627791d7-dc7c-50b5-b4d8-fdfd901f4303" :question/math-academy-id "q-77542" :question/problem "The measure of one angle in a triangle is four times the measure of another angle, and the measure of the third angle is ${85}^{∘}.$ What is the measure of the smallest angle?" :question/worked-solution "Let $x$ be the measure of the first angle. Then the measure of the second angle is $4x.$\n\nThe sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}x+4x+{85}^{∘} & ={180}^{∘} \\\\ 5x+{85}^{∘} & ={180}^{∘} \\\\ 5x & ={95}^{∘} \\\\ x & ={19}^{∘}.\\end{aligned}\n$$\n\n \nHence, the measure of the smallest angle is ${19}^{∘}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d0c343ab-d7ef-53e7-9c87-b563a8763928"] :db/ensure [:question/validate]} {:db/id "answer-field-d0c343ab-d7ef-53e7-9c87-b563a8763928" :answer-field/id #uuid "d0c343ab-d7ef-53e7-9c87-b563a8763928" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dba84abf-d50e-5e5b-b957-0ffb364f7f92" :answer-field/choices ["answer-dba84abf-d50e-5e5b-b957-0ffb364f7f92" "answer-a10dc0b6-a9c0-5cc0-ae3e-5ca8637ff298" "answer-1582d363-43e3-557f-b64f-4cb4121664b3" "answer-426a2765-d590-5cc1-9700-1a5f35a52d52" "answer-a14d0a99-5e6f-5312-91d4-a0d9671db4c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-dba84abf-d50e-5e5b-b957-0ffb364f7f92" :answer/id #uuid "dba84abf-d50e-5e5b-b957-0ffb364f7f92" :answer/type :answer.type/math :answer/value "{19}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a10dc0b6-a9c0-5cc0-ae3e-5ca8637ff298" :answer/id #uuid "a10dc0b6-a9c0-5cc0-ae3e-5ca8637ff298" :answer/type :answer.type/math :answer/value "{24}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1582d363-43e3-557f-b64f-4cb4121664b3" :answer/id #uuid "1582d363-43e3-557f-b64f-4cb4121664b3" :answer/type :answer.type/math :answer/value "{28}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-426a2765-d590-5cc1-9700-1a5f35a52d52" :answer/id #uuid "426a2765-d590-5cc1-9700-1a5f35a52d52" :answer/type :answer.type/math :answer/value "{32}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a14d0a99-5e6f-5312-91d4-a0d9671db4c1" :answer/id #uuid "a14d0a99-5e6f-5312-91d4-a0d9671db4c1" :answer/type :answer.type/math :answer/value "{38}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-08ae86f4-7baa-5fd1-bf6d-dfc10d8069d6" :question/id #uuid "08ae86f4-7baa-5fd1-bf6d-dfc10d8069d6" :question/math-academy-id "q-171876" :question/problem "Consider a triangle $△RST,$ where $m∠R=2x+{3}^{∘},$ $m∠S=4x$ and $m∠T=x+{2}^{∘}.$ Find the value of $x.$\n\n$x=$\n{{field-1}}${}^{∘}$" :question/worked-solution "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}(2x+{3}^{∘})+(4x)+(x+{2}^{∘}) & ={180}^{∘} \\\\ 7x+{5}^{∘} & ={180}^{∘} \\\\ 7x & ={175}^{∘} \\\\ x & ={25}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b018b8b0-8050-5346-9228-9d30a066ed6e"] :db/ensure [:question/validate]} {:db/id "answer-field-b018b8b0-8050-5346-9228-9d30a066ed6e" :answer-field/id #uuid "b018b8b0-8050-5346-9228-9d30a066ed6e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625" :answer-field/choices ["answer-facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625"] :db/ensure [:answer-field/validate]} {:db/id "answer-facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625" :answer/id #uuid "facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-a74d4f60-688d-582a-8efa-ef124e45e804" :question/id #uuid "a74d4f60-688d-582a-8efa-ef124e45e804" :question/math-academy-id "q-77535" :question/problem "![](images/00/0086a1608c554544cdfc3337e5df136ada8986743ebc2329f262ffc90dbe28e7.png)\n\nFind the measure of angle $A$ given that $m∠B=m∠C.$" :question/worked-solution "Using $m∠B=m∠C,$ we get\n\n$$\n\\begin{aligned}m∠B & =m∠C \\\\ z+{10}^{∘} & =2z \\\\ z & ={10}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $z={10}^{∘}$ in the expression for $m∠C,$ we get\n\n$$\nm∠C=2({10}^{∘})={20}^{∘}.\n$$\n\nNow, we can find $m∠A$ using the fact that the internal angles of any triangle sum to ${180}^{∘}$:\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ m∠A+2m∠C & ={180}^{∘} \\\\ m∠A+2\\cdot {20}^{∘} & ={180}^{∘} \\\\ m∠A+{40}^{∘} & ={180}^{∘} \\\\ m∠A & ={140}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-428e655b-e554-55ca-bcdc-4ce5b455e62e"] :db/ensure [:question/validate]} {:db/id "answer-field-428e655b-e554-55ca-bcdc-4ce5b455e62e" :answer-field/id #uuid "428e655b-e554-55ca-bcdc-4ce5b455e62e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7198c182-7e69-556f-8828-1be934a1bff0" :answer-field/choices ["answer-eaa8bbd2-1732-5a88-94b6-937ec4e24956" "answer-ecca6518-9e4e-54fd-940e-9f0c7f5081ed" "answer-7198c182-7e69-556f-8828-1be934a1bff0" "answer-4a140f24-1574-536e-a402-9186f0265c6c" "answer-b98068a7-539d-5a8e-bff3-4725f2627d6b"] :db/ensure [:answer-field/validate]} {:db/id "answer-eaa8bbd2-1732-5a88-94b6-937ec4e24956" :answer/id #uuid "eaa8bbd2-1732-5a88-94b6-937ec4e24956" :answer/type :answer.type/math :answer/value "{135}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-ecca6518-9e4e-54fd-940e-9f0c7f5081ed" :answer/id #uuid "ecca6518-9e4e-54fd-940e-9f0c7f5081ed" :answer/type :answer.type/math :answer/value "{137}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-7198c182-7e69-556f-8828-1be934a1bff0" :answer/id #uuid "7198c182-7e69-556f-8828-1be934a1bff0" :answer/type :answer.type/math :answer/value "{140}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-4a140f24-1574-536e-a402-9186f0265c6c" :answer/id #uuid "4a140f24-1574-536e-a402-9186f0265c6c" :answer/type :answer.type/math :answer/value "{142}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-b98068a7-539d-5a8e-bff3-4725f2627d6b" :answer/id #uuid "b98068a7-539d-5a8e-bff3-4725f2627d6b" :answer/type :answer.type/math :answer/value "{145}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-b302caff-8016-5932-bece-17fa5667969f" :question/id #uuid "b302caff-8016-5932-bece-17fa5667969f" :question/math-academy-id "q-235974" :question/problem "![](images/d2/d24c4077069b1de16c64e3179b8e60094e0440ed0a95ac3525297af85899bec2.png)\n\nFind the measure of angle $C$ given that $m∠A=m∠B.$\n\n$m∠C=$\n{{field-1}}${}^{∘}$" :question/worked-solution "Using $m∠A=m∠B,$ we get\n\n$$\n\\begin{aligned}m∠A & =m∠B \\\\ 8w-{2}^{∘} & =9w-{10}^{∘} \\\\ w & ={8}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $w={8}^{∘}$ in the expression for $m∠A,$ we get\n\n$$\nm∠A=8({8}^{∘})-{2}^{∘}={62}^{∘}.\n$$\n\nNow, we can find $m∠C$ using the fact that the internal angles of any triangle sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ 2m∠A+m∠C & ={180}^{∘} \\\\ 2\\cdot {62}^{∘}+m∠C & ={180}^{∘} \\\\ {124}^{∘}+m∠C & ={180}^{∘} \\\\ m∠C & ={56}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-73cfc52c-c046-5801-a5f6-acb23fafd4cd"] :db/ensure [:question/validate]} {:db/id "answer-field-73cfc52c-c046-5801-a5f6-acb23fafd4cd" :answer-field/id #uuid "73cfc52c-c046-5801-a5f6-acb23fafd4cd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-56016c12-a1ed-578a-a2c8-65eb76af2295" :answer-field/choices ["answer-56016c12-a1ed-578a-a2c8-65eb76af2295"] :db/ensure [:answer-field/validate]} {:db/id "answer-56016c12-a1ed-578a-a2c8-65eb76af2295" :answer/id #uuid "56016c12-a1ed-578a-a2c8-65eb76af2295" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id 17592186075060 :tutorial/content "A **triangle** is a geometric shape that consists of three points connected by three line segments, as shown below.\n\n![](images/06/0668279b79482db2fd78116a244bba8e28d3771f88d2e28fb4b6a62387f9d8fd.png)\n\nFor this triangle,\n\n- the line segments $\\overline{AB}$, $\\overline{BC}$ and $\\overline{CA}$ are the **sides** of the triangle,\n\n- the points $\\color{red}A$, $\\color{red}B$ and $\\color{red}C$ are the **vertices** of the triangle,\n\n- the angles $\\angle{A}$, $\\angle{B}$ and $\\angle{C}$ formed by the sides are called the **interior angles** of the triangle.\n\nTo denote a triangle, we use the symbol $\\boldsymbol{\\triangle}$ and list its vertices (in any order). So, the above diagram shows us \n\n$$\n\\triangle ABC.\n$$\n\nIt can be shown that all triangles have the following property:\n\n*The sum of the measures of the interior angles of any triangle is always equal to $180^\\circ.$*\n\nFor example, in $\\triangle ABC$ shown above, the interior angle theorem tells us that\n\n$$\nm\\angle{A} + m\\angle{B} + m\\angle{C} = 180^\\circ .\n$$\n\nTherefore, if we know the measures of two angles in a triangle, we can calculate the value of the other." :db/ensure [:tutorial/validate]} {:db/id 17592186073929 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id "activity-dc5832ec-13e1-537f-b642-b5b42fb1c889" :activity/id #uuid "dc5832ec-13e1-537f-b642-b5b42fb1c889" :activity/title "The Jacobian of a Three-Dimensional Transformation" :activity/type :activity.type/review :activity/scope 17592186049530 :activity/course 17592186046659 :activity/steps ["step-a9dc9075-d2e1-5d44-af9c-c5a92178e242" "step-ce86c9dd-b527-5f1d-96bb-d695b6d536b3" "step-363a88a5-6e96-5462-af6d-738ef0ce316a" "step-6813ac53-6f7a-5d70-9814-a4b88b024080" "step-f60d8ef1-6b2a-5dbe-9e22-142cc6c61acf"] :activity/first-step "step-a9dc9075-d2e1-5d44-af9c-c5a92178e242" :db/ensure [:activity/validate]} {:db/id "step-a9dc9075-d2e1-5d44-af9c-c5a92178e242" :step/id #uuid "a9dc9075-d2e1-5d44-af9c-c5a92178e242" :step/content 17592186129751 :step/next "step-ce86c9dd-b527-5f1d-96bb-d695b6d536b3" :db/ensure [:step/validate]} {:db/id "step-ce86c9dd-b527-5f1d-96bb-d695b6d536b3" :step/id #uuid "ce86c9dd-b527-5f1d-96bb-d695b6d536b3" :step/content 17592186424182 :step/next "step-363a88a5-6e96-5462-af6d-738ef0ce316a" :db/ensure [:step/validate]} {:db/id "step-363a88a5-6e96-5462-af6d-738ef0ce316a" :step/id #uuid "363a88a5-6e96-5462-af6d-738ef0ce316a" :step/content 17592186281336 :step/next "step-6813ac53-6f7a-5d70-9814-a4b88b024080" :db/ensure [:step/validate]} {:db/id "step-6813ac53-6f7a-5d70-9814-a4b88b024080" :step/id #uuid "6813ac53-6f7a-5d70-9814-a4b88b024080" :step/content 17592186424180 :step/next "step-f60d8ef1-6b2a-5dbe-9e22-142cc6c61acf" :db/ensure [:step/validate]} {:db/id "step-f60d8ef1-6b2a-5dbe-9e22-142cc6c61acf" :step/id #uuid "f60d8ef1-6b2a-5dbe-9e22-142cc6c61acf" :step/content 17592186281339 :db/ensure [:step/validate]} {:db/id 17592186064347 :knowledge-point/questions ["question-1f182666-9412-501e-b641-7f7f9b2222ad" "question-b63796bb-cd51-5db1-b65b-8d15ce564d53"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063937 :question/problem "Solve the equation $4x = y$ for the variable $x.$" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nIn this case, we simply divide both sides of the equation by $4\\mathbin{:}$\n\n$$\n\\eqalign{\n\\require{cancel}\n\t\t4x &= y \\[5pt]\n\t\t\\dfrac {4x} {4} &= \\dfrac y 4 \\[5pt]\n\t\t\\dfrac {{\\cancel{4}}x} {\\cancel{4}} &= \\dfrac y 4 \\[5pt]\n\t\tx &= \\dfrac y4\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064348 :knowledge-point/questions ["question-2257e81b-6df1-53bd-bf2f-94399c3d9e90" "question-8cb21341-1ec0-588f-b6f2-da7ac9131ac4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063950 :question/problem "Given that $\\dfrac{x}{3} + 2y = 1,$ express $x$ in terms of $y.$" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we subtract $2y$ from both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{x}{3}+2y & =1 \\\\ \\frac{x}{3}+2y-2y & =1-2y \\\\ \\frac{x}{3}+0 & =1-2y \\\\ \\frac{x}{3} & =1-2y\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $3\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{x}{3} & =1-2y \\\\ 3\\cdot \\frac{x}{3} & =3\\cdot (1-2y) \\\\ \\cancel{3}\\cdot \\frac{x}{\\cancel{3}} & =3\\cdot (1-2y) \\\\ x & =3\\cdot (1-2y) \\\\ x & =3\\cdot 1-3\\cdot 2y \\\\ x & =3-6y\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064349 :knowledge-point/questions ["question-a062c0fa-ba5c-540d-bad1-e5dc2b1fdc72" "question-a390d02a-3ecf-5fc0-8eb1-0f04dc4eff6f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063938 :question/problem "Solve the following equation for the variable $x\\mathbin{:}$\n\n$$\n\\dfrac{3x-2y}{3}=\\dfrac{1+2y}{4}\n$$" :question/worked-solution "We need to isolate the variable $x.$ First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{3x-2y}{3} & =\\frac{1+2y}{4} \\\\ 4\\cdot (3x-2y) & =3\\cdot (1+2y) \\\\ 12x-8y & =3+6y\\end{aligned}\n$$\n\nNext, we add $8y$ to both sides of the equation:\n\n$$\n\\begin{aligned}12x-8y & =3+6y \\\\ 12x-8y+8y & =3+6y+8y \\\\ 12x & =3+14y\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $12\\mathbin{:}$\n\n$$\n\\begin{aligned}12x & =3+14y \\\\ \\frac{12x}{12} & =\\frac{3+14y}{12} \\\\ \\frac{\\cancel{12}x}{\\cancel{12}} & =\\frac{3+14y}{12} \\\\ x & =\\frac{3+14y}{12}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-1f182666-9412-501e-b641-7f7f9b2222ad" :question/id #uuid "1f182666-9412-501e-b641-7f7f9b2222ad" :question/math-academy-id "q-135478" :question/problem "If $u+\\frac{v}{2}=1,$ then $u=$" :question/worked-solution "We need to isolate the variable $u.$ To do this, we treat $v$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nIn this case, we simply subtract $\\frac{v}{2}$ from both sides of the equation: \n\n$$\n\\begin{aligned}u+\\frac{v}{2} & =1 \\\\ u+\\frac{v}{2}-\\frac{v}{2} & =1-\\frac{v}{2} \\\\ u+0 & =1-\\frac{v}{2} \\\\ u & =1-\\frac{v}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-18653a7d-dd36-525c-82ee-2649adb843b8"] :db/ensure [:question/validate]} {:db/id "answer-field-18653a7d-dd36-525c-82ee-2649adb843b8" :answer-field/id #uuid "18653a7d-dd36-525c-82ee-2649adb843b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b1cab5ab-fbec-575c-bd0f-8a8613314644" :answer-field/choices ["answer-961ed85d-7443-58b0-880a-f94e2896754b" "answer-adf07b29-c7b3-52bc-9a49-baeac9d1d4db" "answer-b1cab5ab-fbec-575c-bd0f-8a8613314644" "answer-0af86761-a9fa-5095-b46e-f4192d60519c" "answer-ec287634-588f-5b16-b335-d55640aec956"] :db/ensure [:answer-field/validate]} {:db/id "answer-961ed85d-7443-58b0-880a-f94e2896754b" :answer/id #uuid "961ed85d-7443-58b0-880a-f94e2896754b" :answer/type :answer.type/math :answer/value "-\\frac{2}{v}" :db/ensure [:answer/validate]} {:db/id "answer-adf07b29-c7b3-52bc-9a49-baeac9d1d4db" :answer/id #uuid "adf07b29-c7b3-52bc-9a49-baeac9d1d4db" :answer/type :answer.type/math :answer/value "1+\\frac{v}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b1cab5ab-fbec-575c-bd0f-8a8613314644" :answer/id #uuid "b1cab5ab-fbec-575c-bd0f-8a8613314644" :answer/type :answer.type/math :answer/value "1-\\frac{v}{2}" :db/ensure [:answer/validate]} {:db/id "answer-0af86761-a9fa-5095-b46e-f4192d60519c" :answer/id #uuid "0af86761-a9fa-5095-b46e-f4192d60519c" :answer/type :answer.type/math :answer/value "2v" :db/ensure [:answer/validate]} {:db/id "answer-ec287634-588f-5b16-b335-d55640aec956" :answer/id #uuid "ec287634-588f-5b16-b335-d55640aec956" :answer/type :answer.type/math :answer/value "\\frac{v}{2}-1" :db/ensure [:answer/validate]} {:db/id "question-b63796bb-cd51-5db1-b65b-8d15ce564d53" :question/id #uuid "b63796bb-cd51-5db1-b65b-8d15ce564d53" :question/math-academy-id "q-178560" :question/problem "Given that $\\frac{h}{8}=k,$ express $h$ in terms of $k.$\n\n$h=${{field-1}}" :question/worked-solution "We need to isolate the variable $h.$ To do this, we treat $k$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nIn this case, we simply multiply both sides of the equation by $8:$\n\n$$\n\\begin{aligned}\\frac{h}{8} & =k \\\\ 8\\cdot \\frac{h}{8} & =8\\cdot k \\\\ \\cancel{8}\\cdot \\frac{h}{\\cancel{8}} & =8k \\\\ h & =8k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c4d897ea-bb5f-5d9d-a846-ffc2b250e5d3"] :db/ensure [:question/validate]} {:db/id "answer-field-c4d897ea-bb5f-5d9d-a846-ffc2b250e5d3" :answer-field/id #uuid "c4d897ea-bb5f-5d9d-a846-ffc2b250e5d3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-56fc4b27-f7c3-5872-8859-927fb33cd902" :answer-field/choices ["answer-56fc4b27-f7c3-5872-8859-927fb33cd902"] :db/ensure [:answer-field/validate]} {:db/id "answer-56fc4b27-f7c3-5872-8859-927fb33cd902" :answer/id #uuid "56fc4b27-f7c3-5872-8859-927fb33cd902" :answer/type :answer.type/math :answer/value "8k" :db/ensure [:answer/validate]} {:db/id "question-2257e81b-6df1-53bd-bf2f-94399c3d9e90" :question/id #uuid "2257e81b-6df1-53bd-bf2f-94399c3d9e90" :question/math-academy-id "q-135010" :question/problem "If $\\frac{x}{2}-5y=2y$ then $x=$" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $5y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{x}{2}-5y & =2y \\\\ \\frac{x}{2}-5y+5y & =2y+5y \\\\ \\frac{x}{2} & =2y+5y \\\\ \\frac{x}{2} & =7y\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}\\frac{x}{2} & =7y \\\\ 2\\cdot \\frac{x}{2} & =2\\cdot 7y \\\\ \\cancel{2}\\cdot \\frac{x}{\\cancel{2}} & =2\\cdot 7y \\\\ x & =2\\cdot 7y \\\\ x & =14y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-85896fbd-038e-5e22-b120-6db4ab42220d"] :db/ensure [:question/validate]} {:db/id "answer-field-85896fbd-038e-5e22-b120-6db4ab42220d" :answer-field/id #uuid "85896fbd-038e-5e22-b120-6db4ab42220d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5af203fd-56ef-5bec-8966-1f9e7b63b08e" :answer-field/choices ["answer-4923f559-c0e3-50d9-a454-99a67e6b45d0" "answer-5af203fd-56ef-5bec-8966-1f9e7b63b08e" "answer-09fc2719-481a-56be-83d9-d2f80fde45e7" "answer-6f01e7f1-4738-56d5-b28e-ede5ffadc778" "answer-bdf24c2b-71c1-564b-befe-52b1f3fee82b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4923f559-c0e3-50d9-a454-99a67e6b45d0" :answer/id #uuid "4923f559-c0e3-50d9-a454-99a67e6b45d0" :answer/type :answer.type/math :answer/value "-14y" :db/ensure [:answer/validate]} {:db/id "answer-5af203fd-56ef-5bec-8966-1f9e7b63b08e" :answer/id #uuid "5af203fd-56ef-5bec-8966-1f9e7b63b08e" :answer/type :answer.type/math :answer/value "14y" :db/ensure [:answer/validate]} {:db/id "answer-09fc2719-481a-56be-83d9-d2f80fde45e7" :answer/id #uuid "09fc2719-481a-56be-83d9-d2f80fde45e7" :answer/type :answer.type/math :answer/value "\\frac{2y}{7}" :db/ensure [:answer/validate]} {:db/id "answer-6f01e7f1-4738-56d5-b28e-ede5ffadc778" :answer/id #uuid "6f01e7f1-4738-56d5-b28e-ede5ffadc778" :answer/type :answer.type/math :answer/value "\\frac{7y}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bdf24c2b-71c1-564b-befe-52b1f3fee82b" :answer/id #uuid "bdf24c2b-71c1-564b-befe-52b1f3fee82b" :answer/type :answer.type/math :answer/value "\\frac{y}{14}" :db/ensure [:answer/validate]} {:db/id "question-8cb21341-1ec0-588f-b6f2-da7ac9131ac4" :question/id #uuid "8cb21341-1ec0-588f-b6f2-da7ac9131ac4" :question/math-academy-id "q-2611" :question/problem "If $6x+3y=3$ then $y=$" :question/worked-solution "We need to isolate the variable $y.$ To do this, we treat $x$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we subtract $6x$ from both sides of the equation:\n\n$$\n\\begin{aligned}6x+3y & =3 \\\\ 6x+3y-6x & =3-6x \\\\ 6x-6x+3y & =3-6x \\\\ 3y & =3-6x\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3y & =3-6x \\\\ 3y & =3(1-2x) \\\\ \\frac{3y}{3} & =\\frac{3(1-2x)}{3} \\\\ \\frac{\\cancel{3}y}{\\cancel{3}} & =\\frac{\\cancel{3}(1-2x)}{\\cancel{3}} \\\\ y & =1-2x\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e91bb9a3-ffd8-5aa1-b8a8-a7e51a400fa2"] :db/ensure [:question/validate]} {:db/id "answer-field-e91bb9a3-ffd8-5aa1-b8a8-a7e51a400fa2" :answer-field/id #uuid "e91bb9a3-ffd8-5aa1-b8a8-a7e51a400fa2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de9e3631-aa7b-50c9-834a-9fdd000bc4f1" :answer-field/choices ["answer-98b0d511-17df-5228-b13c-11db536cb6fb" "answer-de9e3631-aa7b-50c9-834a-9fdd000bc4f1" "answer-c9cacec0-819c-5ea4-bb89-0d22d5e3708d" "answer-369c4ab5-25fe-5787-9d2a-b79cf9f1a13f" "answer-26d15348-de8a-535f-9e64-8f40de85b7b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-98b0d511-17df-5228-b13c-11db536cb6fb" :answer/id #uuid "98b0d511-17df-5228-b13c-11db536cb6fb" :answer/type :answer.type/math :answer/value "1+3x" :db/ensure [:answer/validate]} {:db/id "answer-de9e3631-aa7b-50c9-834a-9fdd000bc4f1" :answer/id #uuid "de9e3631-aa7b-50c9-834a-9fdd000bc4f1" :answer/type :answer.type/math :answer/value "1-2x" :db/ensure [:answer/validate]} {:db/id "answer-c9cacec0-819c-5ea4-bb89-0d22d5e3708d" :answer/id #uuid "c9cacec0-819c-5ea4-bb89-0d22d5e3708d" :answer/type :answer.type/math :answer/value "1-3x" :db/ensure [:answer/validate]} {:db/id "answer-369c4ab5-25fe-5787-9d2a-b79cf9f1a13f" :answer/id #uuid "369c4ab5-25fe-5787-9d2a-b79cf9f1a13f" :answer/type :answer.type/math :answer/value "2-3x" :db/ensure [:answer/validate]} {:db/id "answer-26d15348-de8a-535f-9e64-8f40de85b7b9" :answer/id #uuid "26d15348-de8a-535f-9e64-8f40de85b7b9" :answer/type :answer.type/math :answer/value "3-2x" :db/ensure [:answer/validate]} {:db/id "question-a062c0fa-ba5c-540d-bad1-e5dc2b1fdc72" :question/id #uuid "a062c0fa-ba5c-540d-bad1-e5dc2b1fdc72" :question/math-academy-id "q-176623" :question/problem "Given that $\\frac{2x+1}{3}=\\frac{y-x}{2},$ express $x$ in terms of $y.$\n\n$x=$\n{{field-1}}" :question/worked-solution "We need to isolate the variable $x.$ First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{2x+1}{3} & =\\frac{y-x}{2} \\\\ 2\\cdot (2x+1) & =3\\cdot (y-x) \\\\ 4x+2 & =3y-3x\\end{aligned}\n$$\n\nNext, we subtract $2$ to both sides of the equation:\n\n$$\n\\begin{aligned}4x+2 & =3y-3x \\\\ 4x+2-2 & =3y-3x-2 \\\\ 4x & =3y-3x-2\\end{aligned}\n$$\n\nNext, we add $3x$ to both sides of the equation:\n\n$$\n\\begin{aligned}4x & =3y-3x-2 \\\\ 4x+3x & =3y-3x-2+3x \\\\ 7x & =3y-2\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $7:$\n\n$$\n\\begin{aligned}7x & =3y-2 \\\\ \\frac{7x}{7} & =\\frac{3y-2}{7} \\\\ \\frac{\\cancel{7}x}{\\cancel{7}} & =\\frac{3y-2}{7} \\\\ x & =\\frac{3y-2}{7}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c3558bc4-d6aa-5a60-9e85-1a7a6d4326f5"] :db/ensure [:question/validate]} {:db/id "answer-field-c3558bc4-d6aa-5a60-9e85-1a7a6d4326f5" :answer-field/id #uuid "c3558bc4-d6aa-5a60-9e85-1a7a6d4326f5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-541438b0-3d68-5da1-8797-bf586ce1dc59" :answer-field/choices ["answer-541438b0-3d68-5da1-8797-bf586ce1dc59"] :db/ensure [:answer-field/validate]} {:db/id "answer-541438b0-3d68-5da1-8797-bf586ce1dc59" :answer/id #uuid "541438b0-3d68-5da1-8797-bf586ce1dc59" :answer/type :answer.type/math :answer/value "\\frac{3y-2}{7}" :db/ensure [:answer/validate]} {:db/id "question-a390d02a-3ecf-5fc0-8eb1-0f04dc4eff6f" :question/id #uuid "a390d02a-3ecf-5fc0-8eb1-0f04dc4eff6f" :question/math-academy-id "q-178606" :question/problem "Given that $4x-y=7-5y,$ express $y$ in terms of $x.$\n\n$y=$\n{{field-1}}" :question/worked-solution "We need to isolate the variable $y.$ To do this, we treat $x$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $5y$ to both sides of the equation:\n\n$$\n\\begin{aligned}4x-y & =7-5y \\\\ 4x-y+5y & =7-5y+5y \\\\ 4x+4y & =7\\end{aligned}\n$$\n\nThen, we subtract $4x$ from both sides of the equation:\n\n$$\n\\begin{aligned}4x+4y & =7 \\\\ 4x+4y-4x & =7-4x \\\\ 4y & =7-4x\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $4:$\n\n$$\n\\begin{aligned}4y & =7-4x \\\\ \\frac{4y}{4} & =\\frac{7-4x}{4} \\\\ \\frac{\\cancel{4}y}{\\cancel{4}} & =\\frac{7-4x}{4} \\\\ y & =\\frac{7-4x}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb6684c5-888a-5cbe-9a9a-85f61f6107dd"] :db/ensure [:question/validate]} {:db/id "answer-field-cb6684c5-888a-5cbe-9a9a-85f61f6107dd" :answer-field/id #uuid "cb6684c5-888a-5cbe-9a9a-85f61f6107dd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0a84c382-4383-56de-89ba-57cf705ab259" :answer-field/choices ["answer-0a84c382-4383-56de-89ba-57cf705ab259"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a84c382-4383-56de-89ba-57cf705ab259" :answer/id #uuid "0a84c382-4383-56de-89ba-57cf705ab259" :answer/type :answer.type/math :answer/value "\\frac{7-4x}{4}" :db/ensure [:answer/validate]} {:db/id 17592186065414 :tutorial/content "Equations can contain more than one variable. For example, the following equation has two variables, $\\color{blue}x$ and ${\\color{red}y}{:}$\n\n$$\n{\\color{blue}x} - 7{\\color{red}y} = 1\n$$\n\nTo **solve the equation for the variable ** ${\\color{blue}{x}},$ we need to isolate $\\color{blue}x$ on one side of the equation:  \n\nIn this case, we apply the addition principle and add $7{\\color{red}y}$ to both sides:\n\n$$\n\\begin{aligned}x-7y & =1 \\\\ x-7y+7y & =1+7y \\\\ x+0 & =1+7y \\\\ x & =1+7y\\end{aligned}\n$$\n\nAnd that's it! We have successfully isolated the variable ${\\color{blue}{x}}.$\n\nLet's now look at an example where we must apply the multiplication principle." :db/ensure [:tutorial/validate]} {:db/id 17592186064445 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186160502 :answer-field/choices 17592186160504] [:db/retract 17592186160502 :answer-field/choices 17592186160505] [:db/retract 17592186160502 :answer-field/choices 17592186160506] [:db/retract 17592186160502 :answer-field/choices 17592186160507] {:db/id 17592186162156 :knowledge-point/questions ["question-8b620bc4-f772-542c-8902-9f29e69330eb" "question-73aef377-5ed1-5df9-8acf-ea492a3b5fe7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162157 :knowledge-point/questions ["question-506b27d0-9ecb-54b1-8cb0-ba21f98fbff3" "question-d48b0cc5-05e8-55c3-b441-64611554a8ed"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162158 :knowledge-point/questions ["question-d021d0f6-fbf3-5eed-804d-eee551071be6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162159 :knowledge-point/questions ["question-75529c50-5084-5200-a1d5-34d0fbf018a7" "question-56f49ac3-e6b5-56aa-af36-053b89a652ef" "question-28cb24da-7ead-51cb-82fe-c700e5c2c25f" "question-ddf4ec2c-4f4d-56c1-bc14-78cfd2f52940"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8b620bc4-f772-542c-8902-9f29e69330eb" :question/id #uuid "8b620bc4-f772-542c-8902-9f29e69330eb" :question/math-academy-id "q-253546" :question/problem "What is the supremum of the set $C=\\{-4,\\,3,\\,-2,\\,1\\}?$\n\n$sup(C)=$\n{{field-1}}" :question/worked-solution "The supremum of a set $C$ is the smallest upper bound of $C.$\n\nIf $C$ is a finite set, the supremum of $C$ equals its maximum. Therefore,\n\n$$\n\\begin{aligned}sup(C) & =max\\{-4,\\,3,\\,-2,\\,1\\}=3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fe90978e-57e2-5d2c-a9e0-a9c95c24e6df"] :db/ensure [:question/validate]} {:db/id "answer-field-fe90978e-57e2-5d2c-a9e0-a9c95c24e6df" :answer-field/id #uuid "fe90978e-57e2-5d2c-a9e0-a9c95c24e6df" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d245cd70-93bb-5fe0-8b39-c61cbd52e2d3" :answer-field/choices ["answer-d245cd70-93bb-5fe0-8b39-c61cbd52e2d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-d245cd70-93bb-5fe0-8b39-c61cbd52e2d3" :answer/id #uuid "d245cd70-93bb-5fe0-8b39-c61cbd52e2d3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-73aef377-5ed1-5df9-8acf-ea492a3b5fe7" :question/id #uuid "73aef377-5ed1-5df9-8acf-ea492a3b5fe7" :question/math-academy-id "q-253548" :question/problem "Consider the set $D,$ defined as\n\n$$\nD=\\{n-{n}^{2}:n\\in \\{1,2,3,4\\}\\}.\n$$\n\nWhat is the infimum of $D?$\n\n$inf(D)=$\n{{field-1}}" :question/worked-solution "The infimum of a set $D$ is the greatest lower bound of $D.$\n\nIf $D$ is a finite set, the infimum of $D$ equals its minimum.\n\nFirst, let's write down all the terms of our set by substituting $n=1,2,3,4$ into the expression for the elements of $D:$\n\n$$\n\\begin{aligned}1-{1}^{2} & =0 \\\\ 2-{2}^{2} & =-2 \\\\ 3-{3}^{2} & =-6 \\\\ 4-{4}^{2} & =-12\\end{aligned}\n$$\n\nSo, we have\n\n$$\nD=\\{0,\\,-2,\\,-6,\\,-12\\}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}inf(D) & =min\\{0,\\,-2,\\,-6,\\,-12\\}=-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2b06594-fe7b-5644-beb7-982cb8ef3010"] :db/ensure [:question/validate]} {:db/id "answer-field-c2b06594-fe7b-5644-beb7-982cb8ef3010" :answer-field/id #uuid "c2b06594-fe7b-5644-beb7-982cb8ef3010" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dc6ad13d-df94-5509-9f6e-43f2e945d4dd" :answer-field/choices ["answer-dc6ad13d-df94-5509-9f6e-43f2e945d4dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc6ad13d-df94-5509-9f6e-43f2e945d4dd" :answer/id #uuid "dc6ad13d-df94-5509-9f6e-43f2e945d4dd" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "question-506b27d0-9ecb-54b1-8cb0-ba21f98fbff3" :question/id #uuid "506b27d0-9ecb-54b1-8cb0-ba21f98fbff3" :question/math-academy-id "q-343939" :question/problem "Consider the set $B=(-\\infty ,\\sqrt{2}\\,].$ Complete the following reasoning to determine $inf(B)$ and $sup(B).$\n\nThe infimum of $B$ is the {{field-1}} of $B,$ and the supremum is the {{field-2}} of $B.$\n\nSince $B$ is {{field-3}}, we have $inf(B)$ {{field-4}}.\n\nSince $B$ is {{field-5}}, we have $sup(B)$ {{field-6}}." :question/worked-solution "The infimum of $B$ is the greatest lower bound of $B,$ and the supremum is the smallest upper bound of $B.$\n\nTo find the infimum of this set, we must find the set containing **all** lower bounds of $B$ (i.e., the set of lower bounds) and take the maximum of this set.\n\nSince $B$ is unbounded below, $B$ has no lower bounds, so $inf(B)=-\\infty .$\n\nNext, to find the supremum of this set, we must find the set containing **all** upper bounds of $B$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nIn our case, we have the following:\n\n- Any number in the set $x\\ge \\sqrt{2}$ is greater than or equal to the elements of $B.$ Thus, the set $[\\sqrt{2},\\infty )$ contains only upper bounds of $B.$\n\n- Any number in the set $x<\\sqrt{2}$ is **not** an upper bound of $B.$ In other words, we can always find an element of $B$ that is greater than $x$ for any $x<\\sqrt{2}.$\n\nTherefore, $[\\sqrt{2},\\infty )$ is the set of upper bounds of $B,$ and\n\n$$\nsup(B)=min\\,[\\sqrt{2},\\infty )=\\sqrt{2}.\n$$\n\nThe completed reasoning is given below.\n\nThe infimum of a set $B$ is the $\\text{greatest lower bound}$ of $B,$ and the supremum is the $\\text{smallest upper bound}$ of $B.$\n\nSince $B$ is $\\text{unbounded below},$ we have $inf(B)=-\\infty .$\n\nSince $B$ is $\\text{bounded above},$ we have $sup(B)=\\sqrt{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ab3dfb93-e643-5797-b69e-1906a0e59ba5" "answer-field-66bec3a4-c26b-5903-ae8a-7b9df8fa409f" "answer-field-f0db6243-3349-5558-9574-70fe3060bd88" "answer-field-bc20f825-6c6e-54ea-a9f9-75910082951a" "answer-field-7a882c35-7798-545d-a462-09fa9cfdb2af" "answer-field-ec61e723-576f-5d4c-9b8c-8c68fc8a3aaf"] :db/ensure [:question/validate]} {:db/id "answer-field-ab3dfb93-e643-5797-b69e-1906a0e59ba5" :answer-field/id #uuid "ab3dfb93-e643-5797-b69e-1906a0e59ba5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-3ee4c3c0-3c58-5c26-8000-25caf901b032" :answer-field/choices ["answer-3ee4c3c0-3c58-5c26-8000-25caf901b032" "answer-4f446771-719a-5c42-bf85-457ddc959ad2" "answer-84c479ec-e675-5008-9ccd-2bdca6f9b889" "answer-1b8f167c-86f0-5b69-b6c4-2de261391c0e"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ee4c3c0-3c58-5c26-8000-25caf901b032" :answer/id #uuid "3ee4c3c0-3c58-5c26-8000-25caf901b032" :answer/type :answer.type/text :answer/value "greatest lower bound" :db/ensure [:answer/validate]} {:db/id "answer-4f446771-719a-5c42-bf85-457ddc959ad2" :answer/id #uuid "4f446771-719a-5c42-bf85-457ddc959ad2" :answer/type :answer.t