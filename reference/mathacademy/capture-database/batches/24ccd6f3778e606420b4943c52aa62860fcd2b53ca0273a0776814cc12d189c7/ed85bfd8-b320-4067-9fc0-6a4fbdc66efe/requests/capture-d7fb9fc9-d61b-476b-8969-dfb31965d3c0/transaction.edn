-514b-8267-3bcda471dd63" :step/id #uuid "b0ee0554-72db-514b-8267-3bcda471dd63" :step/content "question-c1e71946-3589-5a14-87c2-2599e8aef444" :step/next "step-ed05f966-1db5-5d79-b616-775fcdf355c1" :db/ensure [:step/validate]} {:db/id "step-ed05f966-1db5-5d79-b616-775fcdf355c1" :step/id #uuid "ed05f966-1db5-5d79-b616-775fcdf355c1" :step/content "question-7aab1343-37d9-52dc-ba1f-d0f44020bf1c" :db/ensure [:step/validate]} [:db/retract 17592186094609 :answer-field/choices 17592186094610] [:db/retract 17592186094609 :answer-field/choices 17592186094611] [:db/retract 17592186094609 :answer-field/choices 17592186094612] [:db/retract 17592186094609 :answer-field/choices 17592186094613] [:db/retract 17592186094609 :answer-field/choices 17592186094614] {:db/id 17592186096828 :knowledge-point/questions ["question-0dfc8af8-b45c-5404-a021-aa0515c46816" "question-ce012b33-e22a-528a-bd43-8ae57ebb53bf" "question-845bcab8-f4ff-59be-a2f2-b0d273cf58d7" "question-6674be9e-fa9a-51c5-9fa3-be41c5ad9ead" "question-a0beb016-ee67-53e9-a1ae-c396296738c8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096583 :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}2{x}^{3}-8{x}^{2}+8x & =0 \\\\ 2x({x}^{2}-4x+4) & =0 \\\\ 2x(x-2)^{2} & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2{x}^{3}-8{x}^{2}+8x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}2{x}^{4}-8{x}^{3}+8{x}^{2}\\,\\text{d}x \\\\  & =4\\pi {\\int }_{0}^{2}{x}^{4}-4{x}^{3}+4{x}^{2}\\,\\text{d}x \\\\  & =4\\pi {(\\frac{{x}^{5}}{5}-{x}^{4}+\\frac{4{x}^{3}}{3})|}_{0}^{2} \\\\  & =4\\pi [(\\frac{{2}^{5}}{5}-{2}^{4}+\\frac{4\\cdot {2}^{3}}{3})-0] \\\\  & =4\\pi [(\\frac{{2}^{5}}{5}-\\frac{{2}^{5}}{2}+\\frac{{2}^{5}}{3})-0] \\\\  & =4\\pi \\cdot {2}^{5}(\\frac{1}{5}-\\frac{1}{2}+\\frac{1}{3}) \\\\  & =4\\pi \\cdot 32(\\frac{1}{5}-\\frac{1}{2}+\\frac{1}{3}) \\\\  & =\\frac{64\\pi }{15}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096829 :knowledge-point/questions ["question-1d5c9e76-b23d-5f4b-b9c9-3236b501399a" "question-dc6488b4-82a0-5ac0-9b15-2d4fb9f9b1f5" "question-4022977e-c101-551c-847a-d892e1fa6f2e" "question-4ae3570d-9f53-5028-8c3b-4778adbb6463"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096584 :question/problem "Consider the finite region bounded between the curves $y=3x-x^2$ and $y=\\dfrac{1}{2}x^2.$ Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=3x-x^2$ and $g(x)=\\dfrac{1}{2}x^2.$ \n\nWe start by determining the points where the curves intersect by solving the following equation for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 3x-{x}^{2} & =\\frac{1}{2}{x}^{2} \\\\ 3x-\\frac{3}{2}{x}^{2} & =0 \\\\ x-\\frac{1}{2}{x}^{2} & =0 \\\\ 2x-{x}^{2} & =0 \\\\ x(2-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/5a/5a9fd40682646575ada14297ef7e1de766852f99dbdab986d5baa1fb5c2feb94.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=\\dfrac12 x^2,$ and\n\n- *leaves* through the upper function $y=f(x)=3x-x^2.$\n\nTherefore, using the shell method, the volume of the solid can be calculated as follows: \n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([3x-{x}^{2}]-[\\frac{1}{2}{x}^{2}])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(3x-\\frac{3}{2}{x}^{2})\\text{d}x \\\\  & =6\\pi {\\int }_{0}^{2}x(x-\\frac{1}{2}{x}^{2})\\text{d}x \\\\  & =6\\pi {\\int }_{0}^{2}x(\\frac{2x}{2}-\\frac{1}{2}{x}^{2})\\text{d}x \\\\  & =3\\pi {\\int }_{0}^{2}x(2x-{x}^{2})\\text{d}x \\\\  & =3\\pi {\\int }_{0}^{2}(2{x}^{2}-{x}^{3})\\text{d}x \\\\  & =3\\pi {(\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{4})|}_{0}^{2} \\\\  & =3\\pi [(\\frac{16}{3}-\\frac{16}{4})-0] \\\\  & =4\\pi \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-0dfc8af8-b45c-5404-a021-aa0515c46816" :question/id #uuid "0dfc8af8-b45c-5404-a021-aa0515c46816" :question/math-academy-id "q-352254" :question/problem "Consider the finite region bounded by the curve $y=-4+5x-{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}-4+5x-{x}^{2} & =0 \\\\ (x-1)(x-4) & =0\\end{aligned}\n$$\n\nThe solutions are $x=1$ and $x=4.$ So, we need to integrate from $x=1$ to $x=4.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{4}x(-4+5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{4}(-4x+5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(-2{x}^{2}+\\frac{5}{3}{x}^{3}-\\frac{1}{4}{x}^{4})|}_{1}^{4} \\\\  & =2\\pi ((-2({4}^{2})+\\frac{5}{3}({4}^{3})-\\frac{1}{4}({4}^{4}))-(-2+\\frac{5}{3}-\\frac{1}{4})) \\\\  & =2\\pi (\\frac{45}{4}) \\\\  & =\\frac{45\\pi }{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2a634dcb-2ecf-54f4-96f1-be7f5d63e9a4"] :db/ensure [:question/validate]} {:db/id "answer-field-2a634dcb-2ecf-54f4-96f1-be7f5d63e9a4" :answer-field/id #uuid "2a634dcb-2ecf-54f4-96f1-be7f5d63e9a4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a2bfa8ff-2170-5808-88ce-f923ae4b22b1" :answer-field/choices ["answer-a2bfa8ff-2170-5808-88ce-f923ae4b22b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2bfa8ff-2170-5808-88ce-f923ae4b22b1" :answer/id #uuid "a2bfa8ff-2170-5808-88ce-f923ae4b22b1" :answer/type :answer.type/math :answer/value "\\frac{45\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "question-ce012b33-e22a-528a-bd43-8ae57ebb53bf" :question/id #uuid "ce012b33-e22a-528a-bd43-8ae57ebb53bf" :question/math-academy-id "q-139184" :question/problem "![](images/51/51143fcae2b39d210e9274fd26363dfdc5cc72e289aea9f524f34f0e92b82b09.png)\n\nConsider the finite region bounded by the curve $y=2{x}^{3}-{x}^{4}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}2{x}^{3}-{x}^{4} & =0 \\\\ {x}^{4}-2{x}^{3} & =0 \\\\ {x}^{3}(2-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2{x}^{3}-{x}^{4})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{4}-{x}^{5})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f590a07e-b055-5cd3-bfa4-36805a56228e"] :db/ensure [:question/validate]} {:db/id "answer-field-f590a07e-b055-5cd3-bfa4-36805a56228e" :answer-field/id #uuid "f590a07e-b055-5cd3-bfa4-36805a56228e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-52879a9f-1bc1-5320-8ad2-85852b163ac3" :answer-field/choices ["answer-38029232-7759-563f-8848-6bd142a2cee8" "answer-04c497e8-eb24-5f03-a516-20786f265c87" "answer-52879a9f-1bc1-5320-8ad2-85852b163ac3" "answer-39b0f50f-1e37-54c3-b540-0f1c1859c060" "answer-18637853-4229-5999-8b4d-c1dd1a465baa"] :db/ensure [:answer-field/validate]} {:db/id "answer-38029232-7759-563f-8848-6bd142a2cee8" :answer/id #uuid "38029232-7759-563f-8848-6bd142a2cee8" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-04c497e8-eb24-5f03-a516-20786f265c87" :answer/id #uuid "04c497e8-eb24-5f03-a516-20786f265c87" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{5})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-52879a9f-1bc1-5320-8ad2-85852b163ac3" :answer/id #uuid "52879a9f-1bc1-5320-8ad2-85852b163ac3" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{4}-{x}^{5})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-39b0f50f-1e37-54c3-b540-0f1c1859c060" :answer/id #uuid "39b0f50f-1e37-54c3-b540-0f1c1859c060" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(2{x}^{4}-{x}^{5})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-18637853-4229-5999-8b4d-c1dd1a465baa" :answer/id #uuid "18637853-4229-5999-8b4d-c1dd1a465baa" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({x}^{4}-2{x}^{5})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-845bcab8-f4ff-59be-a2f2-b0d273cf58d7" :question/id #uuid "845bcab8-f4ff-59be-a2f2-b0d273cf58d7" :question/math-academy-id "q-352264" :question/problem "Consider the finite region bounded by the curve $y=4{x}^{2}-{x}^{3}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}4{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(4-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=4.$ So, we need to integrate from $x=0$ to $x=4.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}x(4{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}(4{x}^{3}-{x}^{4})\\text{d}x \\\\  & =2\\pi {({x}^{4}-\\frac{{x}^{5}}{5})|}_{0}^{4} \\\\  & =2\\pi [({4}^{4}-\\frac{{4}^{5}}{5})-0] \\\\  & =2\\pi (256-\\frac{1024}{5}) \\\\  & =\\frac{512\\pi }{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ba5b4fa0-79f8-593b-a77f-39924f98f32a"] :db/ensure [:question/validate]} {:db/id "answer-field-ba5b4fa0-79f8-593b-a77f-39924f98f32a" :answer-field/id #uuid "ba5b4fa0-79f8-593b-a77f-39924f98f32a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8aed6510-bb09-5e6b-ae25-17e7bdfaba11" :answer-field/choices ["answer-8aed6510-bb09-5e6b-ae25-17e7bdfaba11"] :db/ensure [:answer-field/validate]} {:db/id "answer-8aed6510-bb09-5e6b-ae25-17e7bdfaba11" :answer/id #uuid "8aed6510-bb09-5e6b-ae25-17e7bdfaba11" :answer/type :answer.type/math :answer/value "\\frac{512\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "question-6674be9e-fa9a-51c5-9fa3-be41c5ad9ead" :question/id #uuid "6674be9e-fa9a-51c5-9fa3-be41c5ad9ead" :question/math-academy-id "q-139183" :question/problem "![](images/17/179894a17a2aadf5ba9f463ae3faf2e5836f7b268066f8f56de0f3cf3ff2d8fa.png)\n\nConsider the finite region bounded by the curve $y=2{x}^{2}-{x}^{3}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}2{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(2-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-554543f4-45d4-5a55-baae-0ae37bd43f01"] :db/ensure [:question/validate]} {:db/id "answer-field-554543f4-45d4-5a55-baae-0ae37bd43f01" :answer-field/id #uuid "554543f4-45d4-5a55-baae-0ae37bd43f01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c60ba7d1-1858-5df8-80f7-64228bd8df41" :answer-field/choices ["answer-41244e00-b150-5b4c-8638-702096045e29" "answer-c60ba7d1-1858-5df8-80f7-64228bd8df41" "answer-64b14c65-c2b8-50cd-bfff-c9542b88a423" "answer-b8d2a100-054d-5a3c-9a3f-d0f54096b329" "answer-452c66bd-c08b-56d2-9072-2aeb65eb8298"] :db/ensure [:answer-field/validate]} {:db/id "answer-41244e00-b150-5b4c-8638-702096045e29" :answer/id #uuid "41244e00-b150-5b4c-8638-702096045e29" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-c60ba7d1-1858-5df8-80f7-64228bd8df41" :answer/id #uuid "c60ba7d1-1858-5df8-80f7-64228bd8df41" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-64b14c65-c2b8-50cd-bfff-c9542b88a423" :answer/id #uuid "64b14c65-c2b8-50cd-bfff-c9542b88a423" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}({x}^{3}-2{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b8d2a100-054d-5a3c-9a3f-d0f54096b329" :answer/id #uuid "b8d2a100-054d-5a3c-9a3f-d0f54096b329" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}{(-2{x}^{3}+{x}^{4})}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-452c66bd-c08b-56d2-9072-2aeb65eb8298" :answer/id #uuid "452c66bd-c08b-56d2-9072-2aeb65eb8298" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-a0beb016-ee67-53e9-a1ae-c396296738c8" :question/id #uuid "a0beb016-ee67-53e9-a1ae-c396296738c8" :question/math-academy-id "q-352258" :question/problem "Consider the finite region bounded by the curve $y=-6+5x-{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}-6+5x-{x}^{2} & =0 \\\\ (x-2)(x-3) & =0\\end{aligned}\n$$\n\nThe solutions are $x=2$ and $x=3.$ So, we need to integrate from $x=2$ to $x=3.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{2}^{3}x(-6+5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{2}^{3}(-6x+5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(-3{x}^{2}+\\frac{5}{3}{x}^{3}-\\frac{1}{4}{x}^{4})|}_{2}^{3} \\\\  & =2\\pi [(-3(3)^{2}+\\frac{5(3)^{3}}{3}-\\frac{{3}^{4}}{4})-(-3(2)^{2}+\\frac{5(2)^{3}}{3}-\\frac{{2}^{4}}{4})] \\\\  & =2\\pi (\\frac{5}{12}) \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-16743b63-9c0b-507f-81e5-a93679be7ea0"] :db/ensure [:question/validate]} {:db/id "answer-field-16743b63-9c0b-507f-81e5-a93679be7ea0" :answer-field/id #uuid "16743b63-9c0b-507f-81e5-a93679be7ea0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ac7ed820-a9a3-5250-8205-8b2479f31381" :answer-field/choices ["answer-ac7ed820-a9a3-5250-8205-8b2479f31381"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac7ed820-a9a3-5250-8205-8b2479f31381" :answer/id #uuid "ac7ed820-a9a3-5250-8205-8b2479f31381" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "question-1d5c9e76-b23d-5f4b-b9c9-3236b501399a" :question/id #uuid "1d5c9e76-b23d-5f4b-b9c9-3236b501399a" :question/math-academy-id "q-139295" :question/problem "Consider the finite region bounded between the curves $y=2x$ and $y={x}^{2}-3x.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=2x$ and $g(x)={x}^{2}-3x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2x & ={x}^{2}-3x \\\\ {x}^{2}-5x & =0 \\\\ x(x-5) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=5.$ So, we need to integrate from $x=0$ to $x=5.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/d8/d8833c0c6f1becdbe2841f11fae25bb8e558edd06abee6668b2593c4e37c747b.png)\n\n  \n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)={x}^{2}-3x,$ and\n\n- *leaves* through the upper function $y=f(x)=2x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}x([2x]-[{x}^{2}-3x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}x(5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}(5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(\\frac{5{x}^{3}}{3}-\\frac{{x}^{4}}{4})|}_{0}^{5} \\\\  & =2\\pi [(\\frac{{5}^{4}}{3}-\\frac{{5}^{4}}{4})-0] \\\\  & =\\frac{625\\pi }{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ece1f034-27d4-5b04-b263-6e6fc7866f2c"] :db/ensure [:question/validate]} {:db/id "answer-field-ece1f034-27d4-5b04-b263-6e6fc7866f2c" :answer-field/id #uuid "ece1f034-27d4-5b04-b263-6e6fc7866f2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a9ea190-4206-5d9f-aa9e-7a3d7f4efd85" :answer-field/choices ["answer-1e7fe586-ba60-562a-b399-5620cba64770" "answer-07f0467a-b008-57da-a9a3-fe734f1b4c9c" "answer-3d299622-ea68-58f5-af2a-d8dd193d6a97" "answer-2805feae-de51-573f-a529-44b89f3883c3" "answer-9a9ea190-4206-5d9f-aa9e-7a3d7f4efd85"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e7fe586-ba60-562a-b399-5620cba64770" :answer/id #uuid "1e7fe586-ba60-562a-b399-5620cba64770" :answer/type :answer.type/math :answer/value "\\frac{125\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-07f0467a-b008-57da-a9a3-fe734f1b4c9c" :answer/id #uuid "07f0467a-b008-57da-a9a3-fe734f1b4c9c" :answer/type :answer.type/math :answer/value "\\frac{125\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "answer-3d299622-ea68-58f5-af2a-d8dd193d6a97" :answer/id #uuid "3d299622-ea68-58f5-af2a-d8dd193d6a97" :answer/type :answer.type/math :answer/value "\\frac{225\\pi }{18}" :db/ensure [:answer/validate]} {:db/id "answer-2805feae-de51-573f-a529-44b89f3883c3" :answer/id #uuid "2805feae-de51-573f-a529-44b89f3883c3" :answer/type :answer.type/math :answer/value "\\frac{25\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-9a9ea190-4206-5d9f-aa9e-7a3d7f4efd85" :answer/id #uuid "9a9ea190-4206-5d9f-aa9e-7a3d7f4efd85" :answer/type :answer.type/math :answer/value "\\frac{625\\pi }{6}" :db/ensure [:answer/validate]} {:db/id 17592186097106 :question/problem "Consider the finite region bounded between the curves $y=2x-\\frac{{x}^{2}}{2}$ and $y=-x+\\frac{5}{2}.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=2x-\\frac{{x}^{2}}{2}$ and $g(x)=-x+\\frac{5}{2}.$ \n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2x-\\frac{{x}^{2}}{2} & =-x+\\frac{5}{2} \\\\ {x}^{2}-6x+5 & =0 \\\\ (x-1)(x-5) & =0\\end{aligned}\n$$\n\nThe solutions are $x=1$ and $x=5.$ So, we need to integrate from $x=1$ to $x=5.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/27/27919b5cbe7c0d8b7f7c58a9378f5aa3d30e5466c63b1b17d8a1b6af028ecf66.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=-x+\\frac{5}{2},$ and\n\n- *leaves* through the upper function $y=f(x)=2x-\\frac{{x}^{2}}{2}.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{5}x([2x-\\frac{{x}^{2}}{2}]-[-x+\\frac{5}{2}])\\text{d}x \\\\  & =\\pi {\\int }_{1}^{5}x(-{x}^{2}+6x-5)\\text{d}x \\\\  & =\\pi {\\int }_{1}^{5}(-{x}^{3}+6{x}^{2}-5x)\\text{d}x \\\\  & =\\pi {(-\\frac{{x}^{4}}{4}+2{x}^{3}-\\frac{5{x}^{2}}{2})|}_{1}^{5} \\\\  & =\\pi [(-\\frac{625}{4}+250-\\frac{125}{2})-(-\\frac{1}{4}+2-\\frac{5}{2})] \\\\  & =\\pi [\\frac{125}{4}-(-\\frac{3}{4})] \\\\  & =32\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186094609 :answer-field/correct "answer-5fa3aea5-a4b1-58bb-afec-e41b2aa01602" :answer-field/choices ["answer-b6506ccf-88db-5615-8143-2e08863adf68" "answer-5fa3aea5-a4b1-58bb-afec-e41b2aa01602" "answer-4b01f3af-a426-5893-b342-d89aa273edf4" "answer-2392997a-9561-5830-b7b7-5b120afb733d" "answer-0bb55645-fb6e-544b-b276-80013b78e710"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6506ccf-88db-5615-8143-2e08863adf68" :answer/id #uuid "b6506ccf-88db-5615-8143-2e08863adf68" :answer/type :answer.type/math :answer/value "23\\pi " :db/ensure [:answer/validate]} {:db/id "answer-5fa3aea5-a4b1-58bb-afec-e41b2aa01602" :answer/id #uuid "5fa3aea5-a4b1-58bb-afec-e41b2aa01602" :answer/type :answer.type/math :answer/value "32\\pi " :db/ensure [:answer/validate]} {:db/id "answer-4b01f3af-a426-5893-b342-d89aa273edf4" :answer/id #uuid "4b01f3af-a426-5893-b342-d89aa273edf4" :answer/type :answer.type/math :answer/value "34\\pi " :db/ensure [:answer/validate]} {:db/id "answer-2392997a-9561-5830-b7b7-5b120afb733d" :answer/id #uuid "2392997a-9561-5830-b7b7-5b120afb733d" :answer/type :answer.type/math :answer/value "43\\pi " :db/ensure [:answer/validate]} {:db/id "answer-0bb55645-fb6e-544b-b276-80013b78e710" :answer/id #uuid "0bb55645-fb6e-544b-b276-80013b78e710" :answer/type :answer.type/math :answer/value "44\\pi " :db/ensure [:answer/validate]} {:db/id "question-dc6488b4-82a0-5ac0-9b15-2d4fb9f9b1f5" :question/id #uuid "dc6488b4-82a0-5ac0-9b15-2d4fb9f9b1f5" :question/math-academy-id "q-139211" :question/problem "![](images/f5/f5b69213924ffd4f7aef6acf1837fd05fbf6b0fd684de12a19f067e452fe42ea.png)\n\nConsider the finite region bounded by the curves $y=x$ and $y=\\frac{{x}^{3}}{4},$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=x$ and $g(x)=\\frac{{x}^{3}}{4}.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ x & =\\frac{{x}^{3}}{4} \\\\ 4x-{x}^{3} & =0 \\\\ x(4-{x}^{2}) & =0 \\\\ x(2-x)(2+x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0,$ $x=-2,$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2$ because we are only concerned about $x\\ge 0.$ \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/cc/ccbaa663f6f108322f7bafd4a192a5b9acdf913b61b8319048e92b7885458a91.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=\\frac{{x}^{3}}{4},$ and\n\n- *leaves* through the upper function $y=f(x)=x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([x]-[\\frac{{x}^{3}}{4}])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(x-\\frac{{x}^{3}}{4})\\text{d}x \\\\  & =\\frac{\\pi }{2}{\\int }_{0}^{2}(4{x}^{2}-{x}^{4})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-59f2f9fb-5153-5952-bf13-386d35bef9ea"] :db/ensure [:question/validate]} {:db/id "answer-field-59f2f9fb-5153-5952-bf13-386d35bef9ea" :answer-field/id #uuid "59f2f9fb-5153-5952-bf13-386d35bef9ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e7684e8-8b8b-5398-bdb0-2e5e5a3dc1b9" :answer-field/choices ["answer-cec76fe3-d4f9-5320-849b-0dfb2d9982c6" "answer-702bdb29-aee6-59b6-969c-a02baad1c793" "answer-9e7684e8-8b8b-5398-bdb0-2e5e5a3dc1b9" "answer-e47089a9-82ba-5d9c-ae70-534d9d331831" "answer-23626433-e7c8-5f34-b75a-b0a3c5d7ac80"] :db/ensure [:answer-field/validate]} {:db/id "answer-cec76fe3-d4f9-5320-849b-0dfb2d9982c6" :answer/id #uuid "cec76fe3-d4f9-5320-849b-0dfb2d9982c6" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}({x}^{4}-4{x}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-702bdb29-aee6-59b6-969c-a02baad1c793" :answer/id #uuid "702bdb29-aee6-59b6-969c-a02baad1c793" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}({x}^{4}-{x}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-9e7684e8-8b8b-5398-bdb0-2e5e5a3dc1b9" :answer/id #uuid "9e7684e8-8b8b-5398-bdb0-2e5e5a3dc1b9" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}{\\int }_{0}^{2}(4{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-e47089a9-82ba-5d9c-ae70-534d9d331831" :answer/id #uuid "e47089a9-82ba-5d9c-ae70-534d9d331831" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}{\\int }_{0}^{2}(4{x}^{4}-{x}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-23626433-e7c8-5f34-b75a-b0a3c5d7ac80" :answer/id #uuid "23626433-e7c8-5f34-b75a-b0a3c5d7ac80" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({x}^{4}-{x}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-4022977e-c101-551c-847a-d892e1fa6f2e" :question/id #uuid "4022977e-c101-551c-847a-d892e1fa6f2e" :question/math-academy-id "q-139260" :question/problem "![](images/11/11b85e35604a0350a9fd7754dfda481000debb20397d9aa593a1b887409a97c7.png)\n\nConsider the finite region bounded by the curves $y=4x-\\frac{{x}^{3}}{2}$ and $y=2x,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=4x-\\frac{{x}^{3}}{2}$ and $g(x)=2x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 4x-\\frac{{x}^{3}}{2} & =2x \\\\ 8x-{x}^{3}-2x & =0 \\\\ 4x-{x}^{3} & =0 \\\\ x(4-{x}^{2}) & =0 \\\\ x(2-x)(2+x)\\end{aligned}\n$$\n\nThe solutions are $x=-2,$ $x=0,$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2$ because we are only concerned about $x\\ge 0.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/e0/e03c88c1d24116cc9f68c69150eba39cb6593b4bf6fd4ca9640987ce4ba62299.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=2x,$ and\n\n- *leaves* through the upper function $y=f(x)=4x-\\frac{{x}^{3}}{2}.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([4x-\\frac{{x}^{3}}{2}]-[2x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2x-\\frac{{x}^{3}}{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{2}-\\frac{{x}^{4}}{2})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-43ca6906-7838-5f5e-b687-6a0de5308bd3"] :db/ensure [:question/validate]} {:db/id "answer-field-43ca6906-7838-5f5e-b687-6a0de5308bd3" :answer-field/id #uuid "43ca6906-7838-5f5e-b687-6a0de5308bd3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45835387-0c1c-5d4b-8457-ff714a80c9d7" :answer-field/choices ["answer-45835387-0c1c-5d4b-8457-ff714a80c9d7" "answer-a1f04dfc-2a73-5512-bd3a-e55c9fef4431" "answer-e80076d7-c03b-5639-b30a-dfb3cf2ac755" "answer-a4049b8a-8825-5669-9caa-a14e90d86938" "answer-66549397-7ffc-5509-bf4a-c170eda19f6e"] :db/ensure [:answer-field/validate]} {:db/id "answer-45835387-0c1c-5d4b-8457-ff714a80c9d7" :answer/id #uuid "45835387-0c1c-5d4b-8457-ff714a80c9d7" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{2}-\\frac{{x}^{4}}{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-a1f04dfc-2a73-5512-bd3a-e55c9fef4431" :answer/id #uuid "a1f04dfc-2a73-5512-bd3a-e55c9fef4431" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(2{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-e80076d7-c03b-5639-b30a-dfb3cf2ac755" :answer/id #uuid "e80076d7-c03b-5639-b30a-dfb3cf2ac755" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}{(2x-{x}^{4})}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-a4049b8a-8825-5669-9caa-a14e90d86938" :answer/id #uuid "a4049b8a-8825-5669-9caa-a14e90d86938" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}{\\int }_{0}^{2}(2{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-66549397-7ffc-5509-bf4a-c170eda19f6e" :answer/id #uuid "66549397-7ffc-5509-bf4a-c170eda19f6e" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}{\\int }_{0}^{2}({x}^{2}-\\frac{{x}^{4}}{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-4ae3570d-9f53-5028-8c3b-4778adbb6463" :question/id #uuid "4ae3570d-9f53-5028-8c3b-4778adbb6463" :question/math-academy-id "q-352642" :question/problem "Consider the finite region bounded between the curves $y=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x$ and $y=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$ Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, let $f(x)=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x$ and $g(x)=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ \\frac{3}{2}{x}^{2}+\\frac{5}{2}x & =-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x \\\\ 3{x}^{2}+5x & =-2{x}^{3}+7{x}^{2}+5x \\\\ 2{x}^{3}-4{x}^{2} & =0 \\\\ 2{x}^{2}(x-2) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/d1/d19b70836b7b377c498fa505868563115706b588b0a2216d09c6ec738f746bbd.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=f(x)=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x,$ and\n\n- *leaves* through the upper function $y=g(x)=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x]-[\\frac{3}{2}{x}^{2}+\\frac{5}{2}x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(-{x}^{3}+2{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(-{x}^{4}+2{x}^{3})\\text{d}x \\\\  & =2\\pi {(-\\frac{{x}^{5}}{5}+\\frac{{x}^{4}}{2})|}_{0}^{2} \\\\  & =2\\pi [(-\\frac{{2}^{5}}{5}+\\frac{{2}^{4}}{2})-0] \\\\  & =2\\pi (-\\frac{32}{5}+8) \\\\  & =2\\pi \\cdot \\frac{8}{5} \\\\  & =\\frac{16\\pi }{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2c67a319-c85c-5918-8f19-cbfe5ceda96a"] :db/ensure [:question/validate]} {:db/id "answer-field-2c67a319-c85c-5918-8f19-cbfe5ceda96a" :answer-field/id #uuid "2c67a319-c85c-5918-8f19-cbfe5ceda96a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-820ac9df-49d1-590e-bc4c-409a7349c4d7" :answer-field/choices ["answer-820ac9df-49d1-590e-bc4c-409a7349c4d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-820ac9df-49d1-590e-bc4c-409a7349c4d7" :answer/id #uuid "820ac9df-49d1-590e-bc4c-409a7349c4d7" :answer/type :answer.type/math :answer/value "\\frac{16\\pi}{5}" :db/ensure [:answer/validate]} {:db/id 17592186097882 :tutorial/content "Consider the plane region enclosed by the curve $y=f(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b,$ as shown below. If we rotate this region $2\\pi$ radians about the $y$-axis, we get a solid of revolution.\n\n![](images/e9/e9902ba13717e576f07a15396e6a78fd823a3ad92762688d7802cc7ac95849c0.png)\n\nWe can compute the volume of the solid using the shell method. We divide the interval from $x=a$ to $x=b$ on the $x$-axis to get vertical slices. Consider one such slice of width $\\Delta{x},$ as shown in the picture below (on the left). When this rectangle is rotated about the $y$-axis, it forms a solid shell (i.e., the skin of a cylinder).\n\n![](images/c7/c7be68342d347b8ef48e3cf2b8e20b88bedca594fc3d4846f03b5391ae8dbfc2.png)\n\nSince we assume that $\\Delta{x}$ is very small, the outer radius of the shell approximately equals the inner radius $x.$ The thickness of the shell is $\\Delta{x}$ and its height is $y=f(x)$.\n\nImagine we cut this shell and unfold it to obtain a rectangular solid, as shown below. Its height is $y=f(x)$, its thickness is $\\Delta{x},$ and its length is $2\\pi x$ (the circumference of the shell).\n\n![](images/a4/a40f23b110ab24c55665784219b7013e587487f88d8d7857260458b9c7a20d2d.png)\n\n \n\nThe volume of the shell approximately equals the volume of the rectangular solid:\n\n$$\n\\begin{aligned}{V}_{\\text{shell}} & ≈{V}_{\\text{rec}} \\\\  & =2\\pi x\\cdot y\\cdot Δx \\\\  & =2\\pi xf(x)Δx\\end{aligned}\n$$\n\nThe sum of all the shells will approximate the total volume we want. This approximation becomes more accurate as $\\Delta{x} \\to 0$. Therefore, the volume $V$ of the solid is given by\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}xy\\,\\text{d}x \\\\  & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186097883 :tutorial/content "Consider the region enclosed by the curves $y=f(x)$ on the top, $y=g(x)$ on the bottom, and the vertical lines $x=a$ and $x=b,$ as shown below. We assume that $f(x) \\geq g(x)$ for all $x \\in [a,b].$     \n\n![](images/37/372ece19360ca4f48a5ef48637e49d8f401ee2f1fd562f13c481c767a536bf6c.png)\n\nTo find the volume of the solid generated when this region is rotated $2\\pi$ radians about the $y$-axis, we use the shell method as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{a}^{b}x([f(x)]-[g(x)])\\text{d}x\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186097884 :tutorial/content "One of the advantages of using the shell method versus other methods is that the resulting integral can be much simpler to evaluate. This is often true when we want to rotate a curve of the form $y = f(x)$ about the $y$-axis.\n\nFor example, suppose we want to compute the volume generated when the region below is rotated about the $y$-axis:\n\n![](images/ad/ad563abd1e7f4a413337dc9527d2c3703d4851e756f385a75797c6f5962cf51f.png)\n\nAccording to the shell method, the volume $V$ is given by the following straightforward integral: \n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{0}^{1}xf(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x(2x-2{x}^{2})\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}2{x}^{2}-2{x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nLet's now compare this to the disc method.\n\nTo determine the volume using the disc method, we would first have to express our curve as two functions of $y,$ one for the right-hand side and one for the left-hand side, as follows: \n\n![](images/a8/a841ed797699e8f20b494baa6ff888eb42ccd4715e17733e495405df5ca8c5dc.svg)\n\n![](images/ee/ee7ef70a2a280c42ceea9dc6b8bdb3e3bafbfec0256350cbabde287d33d9884b.png)\n\nThe required volume equals the difference between the volumes generated when the right and left curves are rotated about the $y$-axis. Thus, according to the disc method, the required volume is given by\n\n$$\nV = \\pi \\int_{0}^{1/2} \\left( \\left[ \\dfrac{1}{2}+\\dfrac{1}{2}\\sqrt{1-2y} \\right]^2 - \\left[ \\dfrac{1}{2}-\\dfrac{1}{2}\\sqrt{1-2y} \\right]^2 \\right) \\textrm{d}y.\n$$\n\nAs we can see, this integral is a lot more complicated than the one we obtained using the shell method!" :db/ensure [:tutorial/validate]} {:db/id 17592186096873 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]} {:db/id 17592186073810 :knowledge-point/questions ["question-52deb492-2c28-55be-ad12-3e097a96cc24"] :db/ensure [:knowledge-point/validate]} {:db/id "question-52deb492-2c28-55be-ad12-3e097a96cc24" :question/id #uuid "52deb492-2c28-55be-ad12-3e097a96cc24" :question/math-academy-id "q-114324" :question/problem "Find the shortest distance between the point $(4,-1)$ and the line $x=-2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/ae/ae9c7b44a3e246fb6e0e9f90c1288ef42814c22d705c944e46fe0eb890a5a998.png)\n\nSince the line $x=-2$ is a vertical line, the shortest distance between this line and the point $(4,-1)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $-2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-(-2)|=6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7072da0e-d425-5fcf-b3a1-d1e9e664e903"] :db/ensure [:question/validate]} {:db/id "answer-field-7072da0e-d425-5fcf-b3a1-d1e9e664e903" :answer-field/id #uuid "7072da0e-d425-5fcf-b3a1-d1e9e664e903" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-95f90cf7-7763-5c6f-9b1d-0fd3a0e23ad8" :answer-field/choices ["answer-d595c3ee-db9c-5f39-9662-0ad2912a3dc7" "answer-a38f5ac6-c994-5a87-8126-2a4823f37432" "answer-b52b2dcd-c345-543d-9c13-8bddd315750b" "answer-95f90cf7-7763-5c6f-9b1d-0fd3a0e23ad8" "answer-91964766-092f-5fad-99d5-a15bc5d93379"] :db/ensure [:answer-field/validate]} {:db/id "answer-d595c3ee-db9c-5f39-9662-0ad2912a3dc7" :answer/id #uuid "d595c3ee-db9c-5f39-9662-0ad2912a3dc7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-a38f5ac6-c994-5a87-8126-2a4823f37432" :answer/id #uuid "a38f5ac6-c994-5a87-8126-2a4823f37432" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b52b2dcd-c345-543d-9c13-8bddd315750b" :answer/id #uuid "b52b2dcd-c345-543d-9c13-8bddd315750b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-95f90cf7-7763-5c6f-9b1d-0fd3a0e23ad8" :answer/id #uuid "95f90cf7-7763-5c6f-9b1d-0fd3a0e23ad8" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-91964766-092f-5fad-99d5-a15bc5d93379" :answer/id #uuid "91964766-092f-5fad-99d5-a15bc5d93379" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186073815 :knowledge-point/questions ["question-683e7ef8-4750-58e2-a136-8e19dd7482de"] :db/ensure [:knowledge-point/validate]} {:db/id "question-683e7ef8-4750-58e2-a136-8e19dd7482de" :question/id #uuid "683e7ef8-4750-58e2-a136-8e19dd7482de" :question/math-academy-id "q-74423" :question/problem "![](images/bc/bc1432b521a372c9a7e264700cc58eef96c34b347e0300f5b7c323066ed0cc7b.png)\n\nFind the point on the line $y=\\frac{4}{3}x$ that is closest to the point $(-1,7).$" :question/worked-solution "First, we find the equation of the line that's perpendicular to $y=\\frac{4}{3}x$ and passes through the point $(-1,7).$\n\n The given line has a slope of $\\frac{4}{3},$ so our perpendicular line must have a slope of $-\\frac{3}{4}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-7 & =-\\frac{3}{4}(x+1) \\\\ y-7 & =-\\frac{3}{4}x-\\frac{3}{4} \\\\ y & =-\\frac{3}{4}x+\\frac{25}{4}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=\\frac{4}{3}x \\\\ y=-\\frac{3}{4}x+\\frac{25}{4}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}\\frac{4}{3}x & =-\\frac{3}{4}x+\\frac{25}{4} \\\\ \\frac{4}{3}x+\\frac{3}{4}x & =\\frac{25}{4} \\\\ \\frac{25}{12}x & =\\frac{25}{4} \\\\ x & =\\frac{25}{4}\\cdot \\frac{12}{25} \\\\ x & =3.\\end{aligned}\n$$\n\nSubstituting $x=3$ into either of the two equations gives $y=4.$ So, our solution is $x=3$ and $y=4.$ Therefore, the lines intersect at the point $(3,4).$\n\nTherefore, we conclude that the point on the line $y=\\frac{4}{3}x$ that is closest to the point $(-1,7)$ is $(3,4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b5a7caf1-f1b3-50b7-8338-9e475499f496"] :db/ensure [:question/validate]} {:db/id "answer-field-b5a7caf1-f1b3-50b7-8338-9e475499f496" :answer-field/id #uuid "b5a7caf1-f1b3-50b7-8338-9e475499f496" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e8f4f8f6-66d2-56a3-a1e0-b35ad6aa0fe3" :answer-field/choices ["answer-b544aa9a-5b87-55cf-b2e4-1e042d4dc7a3" "answer-e847e91b-a66b-5b3c-a257-23c792bc4fc8" "answer-937d33d5-a8a7-5da9-bb11-1ede9ac95d6f" "answer-e8f4f8f6-66d2-56a3-a1e0-b35ad6aa0fe3" "answer-22f7cf30-3ed7-5793-9002-3529283cccb9"] :db/ensure [:answer-field/validate]} {:db/id "answer-b544aa9a-5b87-55cf-b2e4-1e042d4dc7a3" :answer/id #uuid "b544aa9a-5b87-55cf-b2e4-1e042d4dc7a3" :answer/type :answer.type/math :answer/value "(-3,-4)" :db/ensure [:answer/validate]} {:db/id "answer-e847e91b-a66b-5b3c-a257-23c792bc4fc8" :answer/id #uuid "e847e91b-a66b-5b3c-a257-23c792bc4fc8" :answer/type :answer.type/math :answer/value "(1,\\frac{4}{3})" :db/ensure [:answer/validate]} {:db/id "answer-937d33d5-a8a7-5da9-bb11-1ede9ac95d6f" :answer/id #uuid "937d33d5-a8a7-5da9-bb11-1ede9ac95d6f" :answer/type :answer.type/math :answer/value "(2,\\frac{8}{3})" :db/ensure [:answer/validate]} {:db/id "answer-e8f4f8f6-66d2-56a3-a1e0-b35ad6aa0fe3" :answer/id #uuid "e8f4f8f6-66d2-56a3-a1e0-b35ad6aa0fe3" :answer/type :answer.type/math :answer/value "(3,4)" :db/ensure [:answer/validate]} {:db/id "answer-22f7cf30-3ed7-5793-9002-3529283cccb9" :answer/id #uuid "22f7cf30-3ed7-5793-9002-3529283cccb9" :answer/type :answer.type/math :answer/value "(6,8)" :db/ensure [:answer/validate]} {:db/id 17592186073811 :knowledge-point/questions ["question-3115c643-189e-5d0d-96c2-b1b8ae304036" "question-777e8b7e-3aad-5700-9be0-3920699b2b4c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3115c643-189e-5d0d-96c2-b1b8ae304036" :question/id #uuid "3115c643-189e-5d0d-96c2-b1b8ae304036" :question/math-academy-id "q-74419" :question/problem "Find the shortest distance between the point $(3,2)$ and the line $y=x+1.$" :question/worked-solution "Let's draw a diagram describing our situation. \n\n![](images/80/80f3e7d79f84a3894e563c78747e22ccf11c889783c39ed6fb688a4242160d60.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=x+1$ and passes through the point $(3,2).$\n\n The given line has a slope of $1,$ so our perpendicular line must have a slope of $-1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-1(x-3) \\\\ y-2 & =-x+3 \\\\ y & =-x+5\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=x+1 \\\\ y=-x+5\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x+1 & =-x+5 \\\\ x+x & =-1+5 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$\n\nSubstituting $x=2$ into either of the two equations gives $y=3.$ So, our solution is $x=2$ and $y=3.$ Therefore, the lines intersect at the point $(2,3).$\n\nFinally, we find the distance $d$ between the points $(3,2)$ and $(2,3):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-3)^{2}+(3-2)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(3,2)$ and the line $y=x+1$ is $\\sqrt{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e9538eb7-9f5e-5704-8c29-873db219be68"] :db/ensure [:question/validate]} {:db/id "answer-field-e9538eb7-9f5e-5704-8c29-873db219be68" :answer-field/id #uuid "e9538eb7-9f5e-5704-8c29-873db219be68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afc25060-6cdc-5f7a-b06c-abd717564cfa" :answer-field/choices ["answer-d25821c3-b2f1-5f34-b7c8-4715d5113d16" "answer-8ff278d4-c3af-52d0-a261-2ce96bee14a4" "answer-706ad2cc-287a-563f-aecf-c4e029c86155" "answer-afc25060-6cdc-5f7a-b06c-abd717564cfa" "answer-1d2f5dd4-e22e-536b-8ce7-2a9b4757513e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d25821c3-b2f1-5f34-b7c8-4715d5113d16" :answer/id #uuid "d25821c3-b2f1-5f34-b7c8-4715d5113d16" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8ff278d4-c3af-52d0-a261-2ce96bee14a4" :answer/id #uuid "8ff278d4-c3af-52d0-a261-2ce96bee14a4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-706ad2cc-287a-563f-aecf-c4e029c86155" :answer/id #uuid "706ad2cc-287a-563f-aecf-c4e029c86155" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-afc25060-6cdc-5f7a-b06c-abd717564cfa" :answer/id #uuid "afc25060-6cdc-5f7a-b06c-abd717564cfa" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-1d2f5dd4-e22e-536b-8ce7-2a9b4757513e" :answer/id #uuid "1d2f5dd4-e22e-536b-8ce7-2a9b4757513e" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-777e8b7e-3aad-5700-9be0-3920699b2b4c" :question/id #uuid "777e8b7e-3aad-5700-9be0-3920699b2b4c" :question/math-academy-id "q-114342" :question/problem "Find the shortest distance between the point $(8,1)$ and the line $y=-\\frac{2}{3}x+2.$" :question/worked-solution "Let's draw a diagram describing our situation. \n\n![](images/52/52bfc27007c57351cdf90d88d444676266edc5d2704314db0d99fd9dca8e367f.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=-\\frac{2}{3}x+2$ and passes through the point $(8,1).$\n\n The given line has a slope of $-\\frac{2}{3},$ so our perpendicular line must have a slope of $\\frac{3}{2}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{3}{2}(x-8) \\\\ y & =\\frac{3}{2}x-12+1 \\\\ y & =\\frac{3}{2}x-11\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=-\\frac{2}{3}x+2 \\\\ y=\\frac{3}{2}x-11\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}x+2 & =\\frac{3}{2}x-11 \\\\ -\\frac{2}{3}x-\\frac{3}{2}x & =-11-2 \\\\ -\\frac{13}{6}x & =-13 \\\\ x & =6.\\end{aligned}\n$$\n\nSubstituting $x=6$ into either of the two equations gives $y=-2.$ So, our solution is $x=6$ and $y=-2.$ Therefore, the lines intersect at the point $(6,-2).$\n\nFinally, we find the distance $d$ between the points $(8,1)$ and $(6,-2):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(6-8)^{2}+(-2-1)^{2}} \\\\  & =\\sqrt{(-2)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(8,1)$ and the line $y=-\\frac{2}{3}x+2$ is $\\sqrt{13}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1932c306-3c23-58d3-a967-76e055fcd6ec"] :db/ensure [:question/validate]} {:db/id "answer-field-1932c306-3c23-58d3-a967-76e055fcd6ec" :answer-field/id #uuid "1932c306-3c23-58d3-a967-76e055fcd6ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3be87dbe-29dc-5043-9a79-a86b2fd5a880" :answer-field/choices ["answer-781f5f51-a2bb-5ef5-9600-e203136f5055" "answer-635a77b6-fd8f-5cf2-8d7f-1598dc609b88" "answer-6e1c0892-2c18-5576-a828-53b1cfdefbaf" "answer-4c39f4de-1a6a-52cf-8624-125d851fe285" "answer-3be87dbe-29dc-5043-9a79-a86b2fd5a880"] :db/ensure [:answer-field/validate]} {:db/id "answer-781f5f51-a2bb-5ef5-9600-e203136f5055" :answer/id #uuid "781f5f51-a2bb-5ef5-9600-e203136f5055" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-635a77b6-fd8f-5cf2-8d7f-1598dc609b88" :answer/id #uuid "635a77b6-fd8f-5cf2-8d7f-1598dc609b88" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-6e1c0892-2c18-5576-a828-53b1cfdefbaf" :answer/id #uuid "6e1c0892-2c18-5576-a828-53b1cfdefbaf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-4c39f4de-1a6a-52cf-8624-125d851fe285" :answer/id #uuid "4c39f4de-1a6a-52cf-8624-125d851fe285" :answer/type :answer.type/math :answer/value "5\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-3be87dbe-29dc-5043-9a79-a86b2fd5a880" :answer/id #uuid "3be87dbe-29dc-5043-9a79-a86b2fd5a880" :answer/type :answer.type/math :answer/value "\\sqrt{13}" :db/ensure [:answer/validate]} {:db/id 17592186075027 :tutorial/content "Consider the line $l$ with the equation $y=-x + 6$ and the point $Q(2,1)$ that does not lie on $l.$\n\n![](images/83/8353825890413432e74d30512219cb95edc76fe8c24e7a824d6893c745c48bd1.png)\n\nSuppose we wish to find the point $P$ that lies on $l$ that's closest to the point $(2,1).$ \n\n![](images/f8/f880cfde6bdfe07c6804609f9b052189632afcde4907207de5245298aea9ea6e.png)\n\nNow, here's the key idea: $P$ is the point that lies on $l$ *and* lies on the line *perpendicular* to $l$ that passes through $Q.$\n\nSo, to find $P,$ we proceed as follows:\n\n- First, we find the line perpendicular to $l$ that passes through $Q.$\n\n- Then, we find the intersection of the two lines.\n\nThe line $y=-x + 6$ has a slope of $-1,$ so our perpendicular line must have a slope of $1$ (the negative reciprocal). It also must pass through the point $(2,1).$ So, using point-slope form, we find that the equation of the perpendicular line is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =1\\cdot (x-2) \\\\ y-1 & =x-2 \\\\ y & =x-1.\\end{aligned}\n$$\n\nNow, to find where the lines $y=-x+6$ and $y=x-1$ intersect, we set the equations equal to each other and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}-x+6 & =x-1 \\\\ 6+1 & =x+x \\\\ 7 & =2x \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nSubstituting $x=\\dfrac{7}{2}$ into either of the two equations gives $y=\\dfrac{5}{2}.$ So, the coordinates of $P$ are $\\left( \\dfrac{7}{2}, \\dfrac{5}{2} \\right).$" :db/ensure [:tutorial/validate]} {:db/id 17592186073946 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186229131 :knowledge-point/questions ["question-b6b0c13d-ace9-58a0-a5ae-835939f481e0" "question-ed2f4962-bfe0-5321-8b55-e0e1d5307252"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186229663 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]x+[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}],\\,x(0)=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}],$ where $A=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$2t{e}^{2t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{2t} \\\\ 2{e}^{2t}\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}][\\begin{aligned}{e}^{s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2t-s} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2t{e}^{2t} \\\\ 2{e}^{2t}\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}{e}^{2t-s} \\\\ 0\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186228180 :answer-field/correct "answer-a71f00de-08de-5313-af96-a181750eb6ae" :answer-field/choices ["answer-a71f00de-08de-5313-af96-a181750eb6ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-a71f00de-08de-5313-af96-a181750eb6ae" :answer/id #uuid "a71f00de-08de-5313-af96-a181750eb6ae" :answer/type :answer.type/math :answer/value "e^{2t-s}" :db/ensure [:answer/validate]} {:db/id 17592186228181 :answer-field/correct "answer-ba920ad2-32c3-5075-8ddb-cb1965fbe9d9" :answer-field/choices ["answer-ba920ad2-32c3-5075-8ddb-cb1965fbe9d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba920ad2-32c3-5075-8ddb-cb1965fbe9d9" :answer/id #uuid "ba920ad2-32c3-5075-8ddb-cb1965fbe9d9" :answer/type :answer.type/math :answer/value "2e^{2t}" :db/ensure [:answer/validate]} {:db/id "question-b6b0c13d-ace9-58a0-a5ae-835939f481e0" :question/id #uuid "b6b0c13d-ace9-58a0-a5ae-835939f481e0" :question/math-academy-id "q-334926" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">$3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-{e}^{2s}\\operatorname{sin}⁡(2(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-1)) & \\operatorname{sin}⁡(2(t-1)) \\\\ -\\operatorname{sin}⁡(2(t-1)) & \\operatorname{cos}⁡(2(t-1))\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1)) \\\\ -3\\operatorname{sin}⁡(2(t-1))+\\operatorname{cos}⁡(2(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}][\\begin{aligned}{e}^{2s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2s}\\operatorname{cos}⁡(2(t-s)) \\\\ -{e}^{2s}\\operatorname{sin}⁡(2(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1)) \\\\ -3\\operatorname{sin}⁡(2(t-1))+\\operatorname{cos}⁡(2(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{2s}\\operatorname{cos}⁡(2(t-s)) \\\\ -{e}^{2s}\\operatorname{sin}⁡(2(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5681283e-4465-523e-8b0e-208f5dbcb496" "answer-field-c5f719c4-a5bf-542d-85f1-a0d87e09bdf0"] :db/ensure [:question/validate]} {:db/id "answer-field-5681283e-4465-523e-8b0e-208f5dbcb496" :answer-field/id #uuid "5681283e-4465-523e-8b0e-208f5dbcb496" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-37a88885-e7e0-5479-b8d2-d85e774bbf74" :answer-field/choices ["answer-37a88885-e7e0-5479-b8d2-d85e774bbf74"] :db/ensure [:answer-field/validate]} {:db/id "answer-37a88885-e7e0-5479-b8d2-d85e774bbf74" :answer/id #uuid "37a88885-e7e0-5479-b8d2-d85e774bbf74" :answer/type :answer.type/math :answer/value "e^{2s}\\cos(2(t-s))" :db/ensure [:answer/validate]} {:db/id "answer-field-c5f719c4-a5bf-542d-85f1-a0d87e09bdf0" :answer-field/id #uuid "c5f719c4-a5bf-542d-85f1-a0d87e09bdf0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-814c0838-d0d0-5c60-bb5d-d662eb334c3a" :answer-field/choices ["answer-814c0838-d0d0-5c60-bb5d-d662eb334c3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-814c0838-d0d0-5c60-bb5d-d662eb334c3a" :answer/id #uuid "814c0838-d0d0-5c60-bb5d-d662eb334c3a" :answer/type :answer.type/math :answer/value "-3\\sin(2(t-1))+\\cos(2(t-1))" :db/ensure [:answer/validate]} {:db/id "question-ed2f4962-bfe0-5321-8b55-e0e1d5307252" :question/id #uuid "ed2f4962-bfe0-5321-8b55-e0e1d5307252" :question/math-academy-id "q-334928" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}2 \\\\ 3\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"190px\">$2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-{e}^{s}\\operatorname{sin}⁡(t-s)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(t-1) & \\operatorname{sin}⁡(t-1) \\\\ -\\operatorname{sin}⁡(t-1) & \\operatorname{cos}⁡(t-1)\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}][\\begin{aligned}{e}^{s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3eb19d6e-883e-50f6-b7d5-7815f100a541" "answer-field-4a78e8e2-e93a-5656-bb35-a08702392163"] :db/ensure [:question/validate]} {:db/id "answer-field-3eb19d6e-883e-50f6-b7d5-7815f100a541" :answer-field/id #uuid "3eb19d6e-883e-50f6-b7d5-7815f100a541" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ca048f2-d590-539c-b053-4530bc08dac8" :answer-field/choices ["answer-9ca048f2-d590-539c-b053-4530bc08dac8"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ca048f2-d590-539c-b053-4530bc08dac8" :answer/id #uuid "9ca048f2-d590-539c-b053-4530bc08dac8" :answer/type :answer.type/math :answer/value "e^s\\cos(t-s)" :db/ensure [:answer/validate]} {:db/id "answer-field-4a78e8e2-e93a-5656-bb35-a08702392163" :answer-field/id #uuid "4a78e8e2-e93a-5656-bb35-a08702392163" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-91956acd-af3c-5284-88d0-d96e76f54ec9" :answer-field/choices ["answer-91956acd-af3c-5284-88d0-d96e76f54ec9"] :db/ensure [:answer-field/validate]} {:db/id "answer-91956acd-af3c-5284-88d0-d96e76f54ec9" :answer/id #uuid "91956acd-af3c-5284-88d0-d96e76f54ec9" :answer/type :answer.type/math :answer/value "-2\\sin(t-1)+3\\cos(t-1)" :db/ensure [:answer/validate]} {:db/id "activity-4fb2a71d-ec16-5dd1-821f-b34bcd691b85" :activity/id #uuid "4fb2a71d-ec16-5dd1-821f-b34bcd691b85" :activity/title "Solving Inhomogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186050707 :activity/course 17592186046645 :activity/steps ["step-738edf14-084a-5ae7-b9a0-e0b01debf2b2" "step-12e96f84-4ccc-56d9-9840-fa21debf2897" "step-4e8a613a-20ab-5651-b333-3b8eba88b3c5" "step-b57b6103-080d-5085-b5f9-fa41b8d0bc4e" "step-572e3d09-d0c2-5407-860f-33864b8a2c66"] :activity/first-step "step-738edf14-084a-5ae7-b9a0-e0b01debf2b2" :db/ensure [:activity/validate]} {:db/id "step-738edf14-084a-5ae7-b9a0-e0b01debf2b2" :step/id #uuid "738edf14-084a-5ae7-b9a0-e0b01debf2b2" :step/content 17592186229663 :step/next "step-12e96f84-4ccc-56d9-9840-fa21debf2897" :db/ensure [:step/validate]} {:db/id "step-12e96f84-4ccc-56d9-9840-fa21debf2897" :step/id #uuid "12e96f84-4ccc-56d9-9840-fa21debf2897" :step/content 17592186308692 :step/next "step-4e8a613a-20ab-5651-b333-3b8eba88b3c5" :db/ensure [:step/validate]} {:db/id "step-4e8a613a-20ab-5651-b333-3b8eba88b3c5" :step/id #uuid "4e8a613a-20ab-5651-b333-3b8eba88b3c5" :step/content "question-b6b0c13d-ace9-58a0-a5ae-835939f481e0" :step/next "step-b57b6103-080d-5085-b5f9-fa41b8d0bc4e" :db/ensure [:step/validate]} {:db/id "step-b57b6103-080d-5085-b5f9-fa41b8d0bc4e" :step/id #uuid "b57b6103-080d-5085-b5f9-fa41b8d0bc4e" :step/content "question-ed2f4962-bfe0-5321-8b55-e0e1d5307252" :step/next "step-572e3d09-d0c2-5407-860f-33864b8a2c66" :db/ensure [:step/validate]} {:db/id "step-572e3d09-d0c2-5407-860f-33864b8a2c66" :step/id #uuid "572e3d09-d0c2-5407-860f-33864b8a2c66" :step/content 17592186308723 :db/ensure [:step/validate]} {:db/id 17592186172101 :knowledge-point/questions ["question-512baac6-6af2-5983-be4f-040d5e0743f6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186262737 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/54/5497f23e51d1e745fef1cf39d6c1a8ada22b25e8c9c7b87f5d5338e85a941739.png)\n\nWe have that $P(x,y)=y{x}^{2}+{y}^{3}x$ and $Q(x,y)=-{y}^{2}x+{y}^{4}.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2yx+{y}^{3},\\,\\frac{∂Q}{∂y} & =-2yx+4{y}^{3}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):-3\\le x\\le -1,\\,-1\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2yx+{y}^{3})+(-2yx+4{y}^{3})\\,\\text{d}A \\\\  & ={\\int }_{-3}^{-1}{\\int }_{-1}^{1}5{y}^{3}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-512baac6-6af2-5983-be4f-040d5e0743f6" :question/id #uuid "512baac6-6af2-5983-be4f-040d5e0743f6" :question/math-academy-id "q-127327" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨y\\operatorname{cos}⁡y+y{x}^{3},\\,\\sqrt[3]{x}+y⟩\n$$\n\nthrough the boundary of the square with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2).$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=y\\operatorname{cos}⁡y+y{x}^{3}$ and $Q(x,y)=\\sqrt[3]{x}+y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}y+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}(3{x}^{2}y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}({x}^{3}y+x)\\,{|}_{-1}^{1}\\,dy \\\\  & ={\\int }_{0}^{2}[((1)^{3}y+1)-((-1)^{3}y+(-1))]\\,dy \\\\  & ={\\int }_{0}^{2}(2y+2)\\,dy \\\\  & =[{y}^{2}+2y]_{0}^{2} \\\\  & =((2)^{2}+2(2))-0 \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dcc96fea-c51a-5b5e-9f54-45e9c86734fe"] :db/ensure [:question/validate]} {:db/id "answer-field-dcc96fea-c51a-5b5e-9f54-45e9c86734fe" :answer-field/id #uuid "dcc96fea-c51a-5b5e-9f54-45e9c86734fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer-field/choices ["answer-44289665-fb34-50eb-942c-684dbafac462" "answer-675393a7-a22d-52c0-8122-89d84461848c" "answer-5d52696f-f66a-5483-9d31-ad3010ca9bf6" "answer-42f7866a-874a-59e8-98df-e82497daf28c" "answer-7b1a18cf-57e7-594a-bab2-ece7b5646c56"] :db/ensure [:answer-field/validate]} {:db/id "answer-44289665-fb34-50eb-942c-684dbafac462" :answer/id #uuid "44289665-fb34-50eb-942c-684dbafac462" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-675393a7-a22d-52c0-8122-89d84461848c" :answer/id #uuid "675393a7-a22d-52c0-8122-89d84461848c" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-5d52696f-f66a-5483-9d31-ad3010ca9bf6" :answer/id #uuid "5d52696f-f66a-5483-9d31-ad3010ca9bf6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-42f7866a-874a-59e8-98df-e82497daf28c" :answer/id #uuid "42f7866a-874a-59e8-98df-e82497daf28c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/id #uuid "7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186262759 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/34/3497b3bbc834879026235f97468f5feb26e91a2b73a4de3da87597bf422ecd33.png)\n\nWe have that $P(x,y)=\\operatorname{sin}⁡(2y)-y{x}^{2}$ and $Q(x,y)=\\operatorname{cos}⁡(2x)+2xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-2xy,\\,\\frac{∂Q}{∂y} & =2x.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 1,\\,-1\\le y\\le 0\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-2xy+2x)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}(2x-2xy)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({x}^{2}-{x}^{2}y)\\,{|}_{0}^{1}\\,dy \\\\  & ={\\int }_{-1}^{0}[(1-y)-0]\\,dy \\\\  & ={\\int }_{-1}^{0}(1-y)\\,dy \\\\  & =[y-\\frac{{y}^{2}}{2}]_{-1}^{0} \\\\  & =0-((-1)-\\frac{(-1)^{2}}{2}) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186262757 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/ea/ea6c25e40b6683d9ff4a4884dbbda708fd79dbd79d0b50730f9ad6e165d2eb58.png)\n\nWe have that $P(x,y)=\\sqrt[3]{y}+x$ and $Q(x,y)=\\operatorname{sin}⁡x-3{x}^{2}{y}^{2}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =-6{x}^{2}y.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 2,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1-6{x}^{2}y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(1-6{x}^{2}y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(x-2{x}^{3}y)\\,{|}_{0}^{2}\\,dy \\\\  & ={\\int }_{0}^{1}[(2-2(2)^{3}y)-0]\\,dy \\\\  & ={\\int }_{0}^{1}(2-16y)\\,dy \\\\  & =[2y-8{y}^{2}]_{0}^{1} \\\\  & =(2(1)-8(1)^{2})-0 \\\\  & =-6.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186262754 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/f6/f6e80e3010ec7c40d3f59dbb1da4e77c985c889a720b6f954177d8ad83a01351.png)\n\nWe have that $P(x,y)=6y{x}^{2}+{e}^{y}$ and $Q(x,y)=3{y}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=12yx,\\,\\frac{∂Q}{∂y} & =6y.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 2,\\,0\\le y\\le \\sqrt{x}\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(12yx+6y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{x}}(12yx+6y)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(6{y}^{2}x+3{y}^{2})\\,{|}_{0}^{\\sqrt{x}}\\,dx \\\\  & ={\\int }_{0}^{2}(6{x}^{2}+3x)\\,dx \\\\  & =(2{x}^{3}+\\frac{3{x}^{2}}{2})\\,{|}_{0}^{2} \\\\  & =22-0 \\\\  & =22.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186262758 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/3a/3ad0a876fe801980a2c3724a639fc6c379db750635c0278a10a5094e2d64c34a.png)\n\nWe have that $P(x,y)=6{x}^{2}+2y$ and $Q(x,y)=-10y-\\operatorname{arctan}⁡x.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=12x,\\,\\frac{∂Q}{∂y} & =-10.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):-2y\\le x\\le 2y,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(12x-10)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-2y}^{2y}(12x-10)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[6{x}^{2}-10x]_{-2y}^{2y}\\,dy \\\\  & ={\\int }_{0}^{1}(24{y}^{2}-20y)-(24{y}^{2}+20y)\\,dy \\\\  & ={\\int }_{0}^{1}(-40y)\\,dy \\\\  & =-40{[\\frac{{y}^{2}}{2}]}_{0}^{1} \\\\  & =-40(\\frac{1}{2}-0) \\\\  & =-20.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186262755 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/c4/c4dd4d03bdfcf6c3d597e2fdef8681e4f3316b3f276cb9967933b61b0dc90976.png)\n\nWe have that $P(x,y)=x-\\sqrt{y}$ and $Q(x,y)=y-\\sqrt{x}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{sin}⁡x\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1+1)\\,\\text{d}A \\\\  & =2{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}\\,\\text{d}y\\,\\text{d}x \\\\  & =2{\\int }_{0}^{\\pi /2}y\\,{|}_{0}^{\\operatorname{sin}⁡x}\\,dx \\\\  & =2{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,dx \\\\  & =2(-\\operatorname{cos}⁡x)\\,{|}_{0}^{\\pi /2} \\\\  & =2(0-(-1)) \\\\  & =2.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186262760 :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/00/006d80a7dbe4d03b78cc5fb1a642405e3fdfdd69ec9d80014ee8e0355ad1ae73.png)\n\nWe have that $P(x,y)=xy-\\sqrt{{y}^{2}+1}$ and $Q(x,y)={x}^{3}+y.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):-\\frac{y}{2}\\le x\\le \\frac{y}{2},\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(y+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-y/2}^{y/2}(y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}(y+1)[x]_{-y/2}^{y/2}\\,dy \\\\  & ={\\int }_{0}^{2}(y+1)[\\frac{y}{2}-(-\\frac{y}{2})]\\,dy \\\\  & ={\\int }_{0}^{2}({y}^{2}+y)\\,dy \\\\  & ={[\\frac{{y}^{3}}{3}+\\frac{{y}^{2}}{2}]}_{0}^{2} \\\\  & =(\\frac{8}{3}+\\frac{4}{2})-0 \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186083387 :knowledge-point/questions ["question-761ee71b-75fd-5326-b76e-466bf3a8a311"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082953 :question/problem "Consider the quadratic equation\n\n$$\n8x^2 + 5x - 12 = 0.\n$$\n\n**Without** solving the equation, determine the sum of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\nax^2 + bx + c = 0\n$$\n\nhas the solutions $x = x_1$ and $x = x_2,$ where $a\\neq 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\nx_1 + x_2 = -\\dfrac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\nx_1 \\cdot x_2 = \\dfrac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na = 8, \\qquad b = 5, \\qquad c = -12.\n$$\n\nTherefore, the sum of the solutions is\n\n$$\n\\begin{aligned}-\\frac{b}{a} & =-\\frac{5}{8}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186082954 :question/problem "Consider the quadratic equation\n\n$$\nx^2 - 37x + 247 = 0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\nax^2 + bx + c = 0\n$$\n\nhas the solutions $x = x_1$ and $x = x_2,$ where $a\\neq 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\nx_1 + x_2 = -\\dfrac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\nx_1 \\cdot x_2 = \\dfrac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na = 1, \\qquad b = -37, \\qquad c = 247.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{247}{1}=247.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186083389 :knowledge-point/questions ["question-94608b8e-9dc6-5162-993f-c6b1291dcd79"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082955 :question/problem "The quadratic coefficient of a particular quadratic equation equals $8.$ The sum of the solutions equals $-11,$ and the product of the solutions equals $24.$ Find the equation." :question/worked-solution "Suppose the quadratic equation\n\n$$\nax^2 + bx + c = 0\n$$\n\nhas the solutions $x = x_1$ and $x = x_2,$ where $a\\neq 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\nx_1 + x_2 = -\\dfrac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\nx_1 \\cdot x_2 = \\dfrac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a, b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $8.$ Therefore, we have\n\n$$\na = 8.\n$$\n\n- We're told that the sum of the roots equals $-11.$ Therefore, we have\n\n$$\n\\begin{aligned}-11 & =-\\frac{b}{a} \\\\ -11 & =-\\frac{b}{8} \\\\ 88 & =b \\\\ b & =88.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $24.$ Therefore, we have\n\n$$\n\\begin{aligned}24 & =\\frac{c}{a} \\\\ 24 & =\\frac{c}{8} \\\\ 192 & =c \\\\ c & =192.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na = 8, \\qquad b = 88, \\qquad c = 192\n$$\n\nand the equation is\n\n$$\n8x^2 +88x + 192 = 0.\n$$" :db/ensure [:question/validate]} {:db/id "question-761ee71b-75fd-5326-b76e-466bf3a8a311" :question/id #uuid "761ee71b-75fd-5326-b76e-466bf3a8a311" :question/math-academy-id "q-288806" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+97x-4\\,580=0.\n$$\n\n**Without** solving the equation, determine the sum of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=97,\\,c=-4\\,580.\n$$\n\nTherefore, the sum of the solutions is\n\n$$\n\\begin{aligned}-\\frac{b}{a} & =-\\frac{97}{1}=-97.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ef4c25bc-fac5-53b8-9c81-4164dcf4df38"] :db/ensure [:question/validate]} {:db/id "answer-field-ef4c25bc-fac5-53b8-9c81-4164dcf4df38" :answer-field/id #uuid "ef4c25bc-fac5-53b8-9c81-4164dcf4df38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bdff68e3-7310-5a3b-bfd3-acbdc1013154" :answer-field/choices ["answer-bdff68e3-7310-5a3b-bfd3-acbdc1013154" "answer-79726a98-0842-5dc8-b6aa-6b6a26cc1320" "answer-96fa485a-27e3-5e60-afd6-ddde4521ef00" "answer-21c6e9b6-cd29-5e3d-aa1e-5b21d61f4918" "answer-41626527-1f7e-54dd-bc40-1c29f5231169"] :db/ensure [:answer-field/validate]} {:db/id "answer-bdff68e3-7310-5a3b-bfd3-acbdc1013154" :answer/id #uuid "bdff68e3-7310-5a3b-bfd3-acbdc1013154" :answer/type :answer.type/math :answer/value "-97" :db/ensure [:answer/validate]} {:db/id "answer-79726a98-0842-5dc8-b6aa-6b6a26cc1320" :answer/id #uuid "79726a98-0842-5dc8-b6aa-6b6a26cc1320" :answer/type :answer.type/math :answer/value "-\\frac{97}{2}" :db/ensure [:answer/validate]} {:db/id "answer-96fa485a-27e3-5e60-afd6-ddde4521ef00" :answer/id #uuid "96fa485a-27e3-5e60-afd6-ddde4521ef00" :answer/type :answer.type/math :answer/value "2\\cdot 97" :db/ensure [:answer/validate]} {:db/id "answer-21c6e9b6-cd29-5e3d-aa1e-5b21d61f4918" :answer/id #uuid "21c6e9b6-cd29-5e3d-aa1e-5b21d61f4918" :answer/type :answer.type/math :answer/value "97" :db/ensure [:answer/validate]} {:db/id "answer-41626527-1f7e-54dd-bc40-1c29f5231169" :answer/id #uuid "41626527-1f7e-54dd-bc40-1c29f5231169" :answer/type :answer.type/math :answer/value "\\frac{-4\\,580}{97}" :db/ensure [:answer/validate]} {:db/id 17592186233742 :question/answer-fields ["answer-field-4370a938-f07b-5593-8fa5-0048cf7abd52"] :db/ensure [:question/validate]} {:db/id "answer-field-4370a938-f07b-5593-8fa5-0048cf7abd52" :answer-field/id #uuid "4370a938-f07b-5593-8fa5-0048cf7abd52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b39e6dd6-694d-5293-be0c-5842ad17577b" :answer-field/choices ["answer-b39e6dd6-694d-5293-be0c-5842ad17577b" "answer-4d470c98-0d7c-56ad-bf57-6075900cb8f5" "answer-d14a0235-7f29-54ca-ae1f-e708421aa4d7" "answer-3b94826d-f26f-5e92-92c8-85ac74b66314" "answer-7fee16f7-9da0-5b19-9900-5b77fb8bec45"] :db/ensure [:answer-field/validate]} {:db/id "answer-b39e6dd6-694d-5293-be0c-5842ad17577b" :answer/id #uuid "b39e6dd6-694d-5293-be0c-5842ad17577b" :answer/type :answer.type/math :answer/value "-172" :db/ensure [:answer/validate]} {:db/id "answer-4d470c98-0d7c-56ad-bf57-6075900cb8f5" :answer/id #uuid "4d470c98-0d7c-56ad-bf57-6075900cb8f5" :answer/type :answer.type/math :answer/value "-\\frac{172}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d14a0235-7f29-54ca-ae1f-e708421aa4d7" :answer/id #uuid "d14a0235-7f29-54ca-ae1f-e708421aa4d7" :answer/type :answer.type/math :answer/value "172" :db/ensure [:answer/validate]} {:db/id "answer-3b94826d-f26f-5e92-92c8-85ac74b66314" :answer/id #uuid "3b94826d-f26f-5e92-92c8-85ac74b66314" :answer/type :answer.type/math :answer/value "2\\cdot 172" :db/ensure [:answer/validate]} {:db/id "answer-7fee16f7-9da0-5b19-9900-5b77fb8bec45" :answer/id #uuid "7fee16f7-9da0-5b19-9900-5b77fb8bec45" :answer/type :answer.type/math :answer/value "\\frac{-15\\,300}{172}" :db/ensure [:answer/validate]} {:db/id 17592186296929 :answer-field/correct "answer-8e884b8c-8f42-52c5-874e-ded4294c2c4a" :answer-field/choices ["answer-8e884b8c-8f42-52c5-874e-ded4294c2c4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e884b8c-8f42-52c5-874e-ded4294c2c4a" :answer/id #uuid "8e884b8c-8f42-52c5-874e-ded4294c2c4a" :answer/type :answer.type/math :answer/value "3x^2-12x-15" :db/ensure [:answer/validate]} {:db/id "question-94608b8e-9dc6-5162-993f-c6b1291dcd79" :question/id #uuid "94608b8e-9dc6-5162-993f-c6b1291dcd79" :question/math-academy-id "q-288852" :question/problem "The quadratic coefficient of a particular quadratic equation equals $1.$ The sum of the solutions equals $4,$ and the product of the solutions equals $-45.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $1.$ Therefore, we have\n\n$$\na=1.\n$$\n\n- We're told that the sum of the roots equals $4.$ Therefore, we have\n\n$$\n\\begin{aligned}4 & =-\\frac{b}{a} \\\\ 4 & =-\\frac{b}{1} \\\\ -4 & =b \\\\ b & =-4.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $-45.$ Therefore, we have\n\n$$\n\\begin{aligned}-45 & =\\frac{c}{a} \\\\ -45 & =\\frac{c}{1} \\\\ c & =-45.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=1,\\,b=-4,\\,c=-45\n$$\n\nand the equation is\n\n$$\n{x}^{2}-4x-45=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9a9e0ce5-acf2-5904-8c29-8541f7ebb7d6"] :db/ensure [:question/validate]} {:db/id "answer-field-9a9e0ce5-acf2-5904-8c29-8541f7ebb7d6" :answer-field/id #uuid "9a9e0ce5-acf2-5904-8c29-8541f7ebb7d6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-56ac2974-c463-588f-8d30-1dff0622193c" :answer-field/choices ["answer-56ac2974-c463-588f-8d30-1dff0622193c"] :db/ensure [:answer-field/validate]} {:db/id "answer-56ac2974-c463-588f-8d30-1dff0622193c" :answer/id #uuid "56ac2974-c463-588f-8d30-1dff0622193c" :answer/type :answer.type/math :answer/value "x^2-4x-45" :db/ensure [:answer/validate]} {:db/id 17592186084468 :tutorial/content "Suppose we want to find the sum and the product of the solutions of the following quadratic equation:\n\n$$\n2x^2 - 160x - 6\\,882 = 0\n$$\n\nOne way is to find the roots and then compute their sum and product. However, this method might be cumbersome because some of the coefficients of our quadratic equation are large.\n\nAn alternative method is to use **Vieta's formulas.** Vieta's formulas state that, for a quadratic equation of the form\n\n$$\nax^2+bx+c=0\n$$\n\nwith $a \\neq 0$ and two solutions $x=x_1$ and $x=x_2,$ the sum of these solutions is\n\n$$\nx_1 + x_2 = -\\dfrac{b}{a},\n$$\n\nand the product of these solutions is\n\n$$\nx_1\\cdot x_2 = \\dfrac{c}{a}.\n$$\n\nWe'll explain how these formulas are derived at the end of the lesson." :db/ensure [:tutorial/validate]} {:db/id 17592186084408 :tutorial/content "Let's find the sum and product of the solutions of our equation \n\n$$\n2x^2 - 160x - 6\\,882 = 0.\n$$\n\nIn this case, we have \n\n$$\na=2,\\qquad b=-160,\\qquad c=-6\\,882.\n$$\n\nApplying Vieta's formulas, we get the following:\n\n- The sum of the solutions is given by\n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2} & =-\\frac{b}{a} \\\\  & =-\\frac{(-160)}{2} \\\\  & =80.\\end{aligned}\n$$\n\n- The product of the solutions is given by\n\n$$\n\\begin{aligned}{x}_{1}\\cdot {x}_{2} & =\\frac{c}{a} \\\\  & =\\frac{(-6\\,882)}{2} \\\\  & =-3\\,441.\\end{aligned}\n$$\n\nFinally, let's check our results. First, note that the equation can be factored as\n\n$$\n2(x+31)(x-111) = 0.\n$$\n\nTherefore, by the zero-product rule, the solutions to this equation are\n\n$$\nx_1 = -31, \\qquad x_2 = 111.\n$$\n\n \n\nThe sum of the solutions is\n\n$$\nx_1 + x_2 = -31 + 111 = 80\\quad{\\color{green}\\checkmark}\n$$\n\nand the product of the solutions is\n\n$$\nx_1\\cdot x_2 = -31 \\cdot 111 = -3\\,441. \\quad{\\color{green}\\checkmark}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186084469 :tutorial/content "We'll now derive Vieta's formulas for the sum and product of the solutions of a quadratic equation.\n\nConsider the quadratic equation \n\n$$\nax^2+bx+c=0\n$$\n\nwith solutions $x_1$ and $x_2.$ \n\nAccording to a mathematical theorem known as the fundamental theorem of algebra, the left-hand side of our quadratic equation can *always* be factored as \n\n$$\nax^2+bx+c = a(x-x_1)(x-x_2).\n$$\n\n \n\nYou'll learn more about the fundamental theorem of algebra in future lessons.\n\nExpanding the parentheses on the right-hand side, we have\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2}) & =a({x}^{2}-{x}_{1}x-{x}_{2}x+{x}_{1}{x}_{2}) \\\\  & =a({x}^{2}-({x}_{1}+{x}_{2})x+{x}_{1}{x}_{2}) \\\\  & =a{x}^{2}-a({x}_{1}+{x}_{2})x+a{x}_{1}{x}_{2}.\\end{aligned}\n$$\n\nSince this is identical to the original equation, we have\n\n$$\nax^2+bx+c = ax^2 - a(x_1 + x_2) x + ax_1x_2\n$$\n\nwhich is true for all values of $x.$\n\nSince $a\\neq 0,$ dividing both sides by $a,$ we obtain \n\n$$\nx^2+{\\color{blue}\\dfrac{b}{a}}x+{\\color{red}\\dfrac{c}{a}} = x^2 \\:{\\color{blue}- \\:(x_1+x_2)}x + {\\color{red}x_1 x_2}.\n$$\n\nSince this equation is true for all values of $x,$ we can extract Vieta's formulas by equating the coefficients of the linear and constant terms on both sides of the equation, as follows:\n\n- Equating the linear coefficients, we have\n\n$$\n{\\color{blue}{\\dfrac{b}{a}}} = \\color{blue}-(x_1+x_2)\n$$\n\nwhich we can write as\n\n$$\nx_1 + x_2 = -\\dfrac{b}{a}.\n$$\n\n- Equating the constants, we have\n\n$$\nx_1 x_2 = \\dfrac{c}{a}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186083424 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186172139 :knowledge-point/questions ["question-061b72e1-6299-5d12-b681-2985a53463e0" "question-52fe2e63-f4cc-5045-bc08-fddd99b9edf2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-061b72e1-6299-5d12-b681-2985a53463e0" :question/id #uuid "061b72e1-6299-5d12-b681-2985a53463e0" :question/math-academy-id "q-26032" :question/problem "![](images/12/120d58ea1e9174a4304007c89b5de1c2f12b1312b89091d30a8b7929d6288092.png)\n\nThe polygon shown above is reflected across the line ${l}_{1}$ and then this resulting polygon is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final polygon?" :question/worked-solution "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/0b/0b45d1a40068be7ed1e24c79308560d5c2d19f609eec5dedcae6665046b61991.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/75/75a215a1e852b5fa536cd305d917d2a1e6da1f7569872b9638474111a2691dd9.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-09fc3b39-efb0-53a1-bb0e-857f974017ae"] :db/ensure [:question/validate]} {:db/id "answer-field-09fc3b39-efb0-53a1-bb0e-857f974017ae" :answer-field/id #uuid "09fc3b39-efb0-53a1-bb0e-857f974017ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fbf4ea6-7b7c-56ee-8b91-d9a728dbb38e" :answer-field/choices ["answer-1ac8e9ee-64aa-5b81-b8eb-078aca376e50" "answer-8cbd92a4-8c9f-52ec-9f50-ec331d1fd11b" "answer-984b8830-feb4-5870-bdee-15b734bb5c6b" "answer-1fbf4ea6-7b7c-56ee-8b91-d9a728dbb38e" "answer-a17bbd11-8729-5f07-add3-083b1f1e3878"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ac8e9ee-64aa-5b81-b8eb-078aca376e50" :answer/id #uuid "1ac8e9ee-64aa-5b81-b8eb-078aca376e50" :answer/type :answer.type/image :answer/value "images/0d/0d7d9b6f6805a5b142558d56def88d5a4088cd44b4ba59e51075a5ff683a5ba0.png" :db/ensure [:answer/validate]} {:db/id "answer-8cbd92a4-8c9f-52ec-9f50-ec331d1fd11b" :answer/id #uuid "8cbd92a4-8c9f-52ec-9f50-ec331d1fd11b" :answer/type :answer.type/image :answer/value "images/18/18533d1ad8ac88b20e55afde40b3d2b68be881db04d05e42bfea197261ae9d08.png" :db/ensure [:answer/validate]} {:db/id "answer-984b8830-feb4-5870-bdee-15b734bb5c6b" :answer/id #uuid "984b8830-feb4-5870-bdee-15b734bb5c6b" :answer/type :answer.type/image :answer/value "images/62/622e7efa69a06f9e6b07d0caf4e5d58db74ce88722b91c08a424fe27b7c5c7df.png" :db/ensure [:answer/validate]} {:db/id "answer-1fbf4ea6-7b7c-56ee-8b91-d9a728dbb38e" :answer/id #uuid "1fbf4ea6-7b7c-56ee-8b91-d9a728dbb38e" :answer/type :answer.type/image :answer/value "images/cd/cd054f702f32e9f7885c23e8ce0286ed516a3e7075df6d01f0378c1b31f0297b.png" :db/ensure [:answer/validate]} {:db/id "answer-a17bbd11-8729-5f07-add3-083b1f1e3878" :answer/id #uuid "a17bbd11-8729-5f07-add3-083b1f1e3878" :answer/type :answer.type/image :answer/value "images/e9/e93c9e642ed6542382fb6a7563b92d26c7727530cfb4033aafe46bd85ee8d303.png" :db/ensure [:answer/validate]} {:db/id 17592186172140 :knowledge-point/questions ["question-982b9ee4-2f8e-53f9-befc-0859353e9231"] :db/ensure [:knowledge-point/validate]} {:db/id "question-982b9ee4-2f8e-53f9-befc-0859353e9231" :question/id #uuid "982b9ee4-2f8e-53f9-befc-0859353e9231" :question/math-academy-id "q-53354" :question/problem "![](images/e3/e3093210c2f9523999c06ffe4e03606531e81707b798bbc7278d7b28cdfe4e25.png)\n\nThe triangle $T$ is mapped to the triangle ${T}^{′}$ under the action of a reflection. What is the equation of the line of reflection?" :question/worked-solution "The line of reflection is the perpendicular bisector of the segments joining each point to its image. \n\nTherefore, the line of reflection is $y=-2,$ as shown below.\n\n![](images/7b/7b77cd63f7a93a62576846ad92b5ce2bcc1853137c5f582de42c2ebce4001892.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6734fd2e-39f9-552d-b8bc-67599b80a250"] :db/ensure [:question/validate]} {:db/id "answer-field-6734fd2e-39f9-552d-b8bc-67599b80a250" :answer-field/id #uuid "6734fd2e-39f9-552d-b8bc-67599b80a250" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1bf7527a-b093-5d38-9467-08fb1b5df1ef" :answer-field/choices ["answer-5bb4489d-2025-5f3f-a357-820f825f9107" "answer-e09b947d-c299-5b63-b2ba-fb273eabb3fd" "answer-b6828352-5dfe-55be-be40-b8e268d17505" "answer-1bf7527a-b093-5d38-9467-08fb1b5df1ef" "answer-218f93f1-166b-5755-ab5d-94825b6beeaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bb4489d-2025-5f3f-a357-820f825f9107" :answer/id #uuid "5bb4489d-2025-5f3f-a357-820f825f9107" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-e09b947d-c299-5b63-b2ba-fb273eabb3fd" :answer/id #uuid "e09b947d-c299-5b63-b2ba-fb273eabb3fd" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-b6828352-5dfe-55be-be40-b8e268d17505" :answer/id #uuid "b6828352-5dfe-55be-be40-b8e268d17505" :answer/type :answer.type/math :answer/value "y=-1" :db/ensure [:answer/validate]} {:db/id "answer-1bf7527a-b093-5d38-9467-08fb1b5df1ef" :answer/id #uuid "1bf7527a-b093-5d38-9467-08fb1b5df1ef" :answer/type :answer.type/math :answer/value "y=-2" :db/ensure [:answer/validate]} {:db/id "answer-218f93f1-166b-5755-ab5d-94825b6beeaa" :answer/id #uuid "218f93f1-166b-5755-ab5d-94825b6beeaa" :answer/type :answer.type/math :answer/value "y=-x" :db/ensure [:answer/validate]} {:db/id "question-52fe2e63-f4cc-5045-bc08-fddd99b9edf2" :question/id #uuid "52fe2e63-f4cc-5045-bc08-fddd99b9edf2" :question/math-academy-id "q-102564" :question/problem "![](images/72/721572d7cbc2f760e74eadc4cec8e8bbd6f730a6a12eb56efd112de85bee0d30.png)\n\nThe figure shown above is reflected across the line ${l}_{1}$ and then this resulting figure is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final figure?" :question/worked-solution "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/3b/3b9947ebf3ebf9d6cbd2aa14ab889eb378a3bf5a78ad78d084e2662faab4d733.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/af/afe4c717eb216e75e950cce573d87f6f34f83cfe99f9b2e60c5e75f9dee7fafa.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-74dbd89a-8408-584d-925a-1b223241e4c2"] :db/ensure [:question/validate]} {:db/id "answer-field-74dbd89a-8408-584d-925a-1b223241e4c2" :answer-field/id #uuid "74dbd89a-8408-584d-925a-1b223241e4c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6cf926ba-c2a8-5171-b61a-049dd08e3c0d" :answer-field/choices ["answer-b86bd5a0-b307-5a26-8cdf-ebc3f93fa2f7" "answer-661b2201-2014-5c94-b435-738003b09a25" "answer-35212aa4-fbcc-5f1d-8bbf-338782dd4f5d" "answer-6cf926ba-c2a8-5171-b61a-049dd08e3c0d" "answer-48f38126-07d6-5070-8231-460ca9d7c9d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-b86bd5a0-b307-5a26-8cdf-ebc3f93fa2f7" :answer/id #uuid "b86bd5a0-b307-5a26-8cdf-ebc3f93fa2f7" :answer/type :answer.type/image :answer/value "images/39/391e765390f873d84818d6f82dba248667311a616884734a43e176f016d244c2.png" :db/ensure [:answer/validate]} {:db/id "answer-661b2201-2014-5c94-b435-738003b09a25" :answer/id #uuid "661b2201-2014-5c94-b435-738003b09a25" :answer/type :answer.type/image :answer/value "images/7d/7dd9a14cbeb4b086df32eb78a7f5136b06581f6550d193efae5d573c74213c8e.png" :db/ensure [:answer/validate]} {:db/id "answer-35212aa4-fbcc-5f1d-8bbf-338782dd4f5d" :answer/id #uuid "35212aa4-fbcc-5f1d-8bbf-338782dd4f5d" :answer/type :answer.type/image :answer/value "images/a6/a60e17143ecee9f53fcf593af7e8c588213dcdcdc8491004bb171930dd81ab04.png" :db/ensure [:answer/validate]} {:db/id "answer-6cf926ba-c2a8-5171-b61a-049dd08e3c0d" :answer/id #uuid "6cf926ba-c2a8-5171-b61a-049dd08e3c0d" :answer/type :answer.type/image :answer/value "images/b2/b2710773950acced66580bcfa16b42379d6ec1d4c55889212d3157f1b44bf8b2.png" :db/ensure [:answer/validate]} {:db/id "answer-48f38126-07d6-5070-8231-460ca9d7c9d2" :answer/id #uuid "48f38126-07d6-5070-8231-460ca9d7c9d2" :answer/type :answer.type/image :answer/value "images/cb/cb0d8ab59ca232703150442f54b190d2fbe0078965e06f7b64a9ae6615706d55.png" :db/ensure [:answer/validate]} {:db/id "activity-ce12ad27-8b43-5e90-aadb-9f6033164639" :activity/id #uuid "ce12ad27-8b43-5e90-aadb-9f6033164639" :activity/title "Reflections of Figures Across Arbitrary Lines" :activity/type :activity.type/review :activity/scope 17592186050070 :activity/course 17592186046647 :activity/steps ["step-5b357e8b-8c64-56fa-a528-57e470966cd6" "step-219d0137-8f2f-5553-85c0-382a2e2af841" "step-ddc01fe6-3422-5b30-91a7-0070ab16975a"] :activity/first-step "step-5b357e8b-8c64-56fa-a528-57e470966cd6" :db/ensure [:activity/validate]} {:db/id "step-5b357e8b-8c64-56fa-a528-57e470966cd6" :step/id #uuid "5b357e8b-8c64-56fa-a528-57e470966cd6" :step/content "question-061b72e1-6299-5d12-b681-2985a53463e0" :step/next "step-219d0137-8f2f-5553-85c0-382a2e2af841" :db/ensure [:step/validate]} {:db/id "step-219d0137-8f2f-5553-85c0-382a2e2af841" :step/id #uuid "219d0137-8f2f-5553-85c0-382a2e2af841" :step/content "question-982b9ee4-2f8e-53f9-befc-0859353e9231" :step/next "step-ddc01fe6-3422-5b30-91a7-0070ab16975a" :db/ensure [:step/validate]} {:db/id "step-ddc01fe6-3422-5b30-91a7-0070ab16975a" :step/id #uuid "ddc01fe6-3422-5b30-91a7-0070ab16975a" :step/content "question-52fe2e63-f4cc-5045-bc08-fddd99b9edf2" :db/ensure [:step/validate]} {:db/id 17592186229183 :knowledge-point/questions ["question-36a65a87-c8d0-5bbf-adbe-0789f4e08164" "question-6c55e9d5-5244-5391-84ab-9850b2ba8152"] :db/ensure [:knowledge-point/validate]} {:db/id "question-36a65a87-c8d0-5bbf-adbe-0789f4e08164" :question/id #uuid "36a65a87-c8d0-5bbf-adbe-0789f4e08164" :question/math-academy-id "q-336500" :question/problem "A syrup mixing tank at a bottling plant can hold up to $220\\,\\text{gal}$ of liquid. Initially, it contains $120\\,\\text{gal}$ of syrup solution with $24\\,\\text{lb}$ of dissolved sugar. A more concentrated sugar solution with concentration $0.7\\,\\text{lb/gal}$ flows into the tank at a rate of $12\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $8\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of sugar in the tank at the moment it begins to overflow." :question/worked-solution "Since $Q$ is the amount of sugar in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which sugar enters the tank minus the rate at which sugar leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the tank.\n\nFirst, note that a solution containing $0.7\\,\\text{lb/gal}$ of sugar enters the tank at a rate of $12\\,\\text{gal/min}.$ So, the rate at which the *sugar* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.7\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (12\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.7\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =8.4\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the tank.\n\nTo find the rate at which sugar leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $120\\,\\text{gal}$ of liquid; solution enters at $12\\,\\text{gal/min}$ and mixed solution leaves at $8\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=120+12t-8t=4(30+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of sugar in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{4(30+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $8\\,\\text{gal/min},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(8\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(8\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{8Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{30+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =8.4-\\frac{2Q}{30+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q=8.4.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(30+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|30+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(30+t)^{2}} \\\\  & =(30+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(30+t)^{2}$ yields\n\n$$\n\\begin{aligned}(30+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q) & =(30+t)^{2}\\cdot 8.4 \\\\ (30+t)^{2}\\frac{dQ}{dt}+2(30+t)Q & =8.4(30+t)^{2} \\\\ \\frac{d}{dt}(Q(30+t)^{2}) & =8.4(30+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(30+t)^{2})\\,dt & =\\int 8.4(30+t)^{2}\\,dt \\\\ Q(30+t)^{2} & =8.4\\cdot \\frac{1}{3}(30+t)^{3}+C \\\\ Q(t) & =2.8(30+t)+\\frac{C}{(30+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $24\\,\\text{lb}$ of sugar. So, we can apply the initial condition $Q(0)=24,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =24 \\\\ 2.8(30+0)+\\frac{C}{(30+0)^{2}} & =24 \\\\ 84+\\frac{C}{(30)^{2}} & =24 \\\\ \\frac{C}{(30)^{2}} & =-60 \\\\ C & =-60(30)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =2.8(30+t)-\\frac{60(30)^{2}}{(30+t)^{2}} \\\\  & =2.8(30+t)-60{(\\frac{30}{30+t})}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $220\\,\\text{gal},$ so we can use the condition $V({t}_{o})=220$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =220 \\\\ 120+12{t}_{o}-8{t}_{o} & =220 \\\\ 120+4{t}_{o} & =220 \\\\ 4{t}_{o} & =100 \\\\ {t}_{o} & =25\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of sugar in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(25) & =2.8(30+25)-60{(\\frac{30}{30+25})}^{2} \\\\  & =154-60{(\\frac{30}{55})}^{2} \\\\  & ≈136.1\\,\\text{lb}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-464a658d-9140-58a9-ae22-53b8f7f33f64"] :db/ensure [:question/validate]} {:db/id "answer-field-464a658d-9140-58a9-ae22-53b8f7f33f64" :answer-field/id #uuid "464a658d-9140-58a9-ae22-53b8f7f33f64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-141b96db-d2b7-5c1e-ba1e-d4cec0dff378" :answer-field/choices ["answer-c0463d14-2b9e-5fba-b2c4-9802c27cf249" "answer-bba99957-7e8d-5791-b9fd-9c58160a4cde" "answer-56903a87-08bb-5210-b21a-15bdc9bdba3b" "answer-141b96db-d2b7-5c1e-ba1e-d4cec0dff378" "answer-6eb90bb5-f5d6-5864-b41d-7da56b21a5e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0463d14-2b9e-5fba-b2c4-9802c27cf249" :answer/id #uuid "c0463d14-2b9e-5fba-b2c4-9802c27cf249" :answer/type :answer.type/math :answer/value "135.2\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-bba99957-7e8d-5791-b9fd-9c58160a4cde" :answer/id #uuid "bba99957-7e8d-5791-b9fd-9c58160a4cde" :answer/type :answer.type/math :answer/value "135.7\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-56903a87-08bb-5210-b21a-15bdc9bdba3b" :answer/id #uuid "56903a87-08bb-5210-b21a-15bdc9bdba3b" :answer/type :answer.type/math :answer/value "135.9\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-141b96db-d2b7-5c1e-ba1e-d4cec0dff378" :answer/id #uuid "141b96db-d2b7-5c1e-ba1e-d4cec0dff378" :answer/type :answer.type/math :answer/value "136.1\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-6eb90bb5-f5d6-5864-b41d-7da56b21a5e6" :answer/id #uuid "6eb90bb5-f5d6-5864-b41d-7da56b21a5e6" :answer/type :answer.type/math :answer/value "136.4\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "question-6c55e9d5-5244-5391-84ab-9850b2ba8152" :question/id #uuid "6c55e9d5-5244-5391-84ab-9850b2ba8152" :question/math-academy-id "q-336508" :question/problem "A wastewater treatment tank at a chemical plant can hold up to $180\\,\\text{gal}$ of liquid. Initially, it contains $120\\,\\text{gal}$ of wastewater with $40\\,\\text{lb}$ of dissolved contaminant. A more concentrated wastewater stream with concentration $1.25\\,\\text{lb/gal}$ flows into the tank at a rate of $12\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $8\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of contaminant in the tank at the moment it begins to overflow." :question/worked-solution "Since $Q$ is the amount of contaminant in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminant enters the tank minus the rate at which contaminant leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminant enters the tank.\n\nFirst, note that a solution containing $1.25\\,\\text{lb/gal}$ of contaminant enters the tank at a rate of $12\\,\\text{gal/min}.$ So, the rate at which the *contaminant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(1.25\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (12\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(1.25\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =15\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminant exits the tank.\n\nTo find the rate at which contaminant leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $120\\,\\text{gal}$ of liquid; solution enters at $12\\,\\text{gal/min}$ and mixed solution leaves at $8\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=120+12t-8t=4(30+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of contaminant in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{4(30+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $8\\,\\text{gal/min},$ *contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(8\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(8\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{8Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{30+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =15-\\frac{2Q}{30+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q=15.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(30+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|30+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(30+t)^{2}} \\\\  & =(30+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(30+t)^{2}$ yields\n\n$$\n\\begin{aligned}(30+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q) & =(30+t)^{2}\\cdot 15 \\\\ (30+t)^{2}\\frac{dQ}{dt}+2(30+t)Q & =15(30+t)^{2} \\\\ \\frac{d}{dt}(Q(30+t)^{2}) & =15(30+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(30+t)^{2})\\,dt & =\\int 15(30+t)^{2}\\,dt \\\\ Q(30+t)^{2} & =15\\cdot \\frac{1}{3}(30+t)^{3}+C \\\\ Q(t) & =5(30+t)+\\frac{C}{(30+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $40\\,\\text{lb}$ of contaminant. So, we can apply the initial condition $Q(0)=40,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =40 \\\\ 5(30+0)+\\frac{C}{(30+0)^{2}} & =40 \\\\ 150+\\frac{C}{(30)^{2}} & =40 \\\\ \\frac{C}{{30}^{2}} & =-110 \\\\ C & =-110(30)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =5(30+t)-\\frac{110(30)^{2}}{(30+t)^{2}} \\\\  & =5(30+t)-110{(\\frac{30}{30+t})}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $180\\,\\text{gal},$ so we can use the condition $V({t}_{o})=180$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =180 \\\\ 120+12{t}_{o}-8{t}_{o} & =180 \\\\ 120+4{t}_{o} & =180 \\\\ 4{t}_{o} & =60 \\\\ {t}_{o} & =15\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of contaminant in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(15) & =5(30+15)-110{(\\frac{30}{30+15})}^{2} \\\\  & =225-110{(\\frac{30}{45})}^{2} \\\\  & ≈176.1\\,\\text{lb}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f2e476d3-efaf-5ec7-9cea-2c3e7d2d49f0"] :db/ensure [:question/validate]} {:db/id "answer-field-f2e476d3-efaf-5ec7-9cea-2c3e7d2d49f0" :answer-field/id #uuid "f2e476d3-efaf-5ec7-9cea-2c3e7d2d49f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41a9bbe8-dcee-5623-9122-ba87f8a7d390" :answer-field/choices ["answer-aca174a9-712f-5452-958f-e15b38456d2c" "answer-52c67f33-11db-51b1-9650-af1cf2900407" "answer-41a9bbe8-dcee-5623-9122-ba87f8a7d390" "answer-a20928a6-6ffa-5ddc-9782-9f840a1c74b4" "answer-d7682d19-2baf-59af-84e2-dbac5b3c49b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-aca174a9-712f-5452-958f-e15b38456d2c" :answer/id #uuid "aca174a9-712f-5452-958f-e15b38456d2c" :answer/type :answer.type/math :answer/value "175.2\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-52c67f33-11db-51b1-9650-af1cf2900407" :answer/id #uuid "52c67f33-11db-51b1-9650-af1cf2900407" :answer/type :answer.type/math :answer/value "175.8\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-41a9bbe8-dcee-5623-9122-ba87f8a7d390" :answer/id #uuid "41a9bbe8-dcee-5623-9122-ba87f8a7d390" :answer/type :answer.type/math :answer/value "176.1\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-a20928a6-6ffa-5ddc-9782-9f840a1c74b4" :answer/id #uuid "a20928a6-6ffa-5ddc-9782-9f840a1c74b4" :answer/type :answer.type/math :answer/value "176.5\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id "answer-d7682d19-2baf-59af-84e2-dbac5b3c49b4" :answer/id #uuid "d7682d19-2baf-59af-84e2-dbac5b3c49b4" :answer/type :answer.type/math :answer/value "176.9\\,\\text{lb}" :db/ensure [:answer/validate]} {:db/id 17592186229182 :knowledge-point/questions ["question-b6915e10-1543-50b0-a358-2c56a1366444"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b6915e10-1543-50b0-a358-2c56a1366444" :question/id #uuid "b6915e10-1543-50b0-a358-2c56a1366444" :question/math-academy-id "q-336744" :question/problem "A fermentation tank initially holds $180\\,\\text{L}$ of liquid containing $5\\,\\text{kg}$ of dissolved nutrient.\nA solution containing $0.04\\,\\text{kg/L}$ of dissolved nutrient is pumped into the tank at a rate of $20\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $30\\,\\text{L/min}.$ If the amount of nutrient $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins is given by\n\n$$\nQ(t)=\\alpha \\,(1-\\frac{t}{18})+\\beta {(1-\\frac{t}{18})}^{3}\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants, what is the value of $\\alpha -\\beta ?$" :question/worked-solution "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which minerals enter the tank minus the rate at which minerals leave the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which minerals enter the tank.\n\nFirst, note that a water solution containing $0.04\\,\\text{kg/L}$ of minerals enters the tank at a rate of $20\\,\\text{L/min}.$ So, the rate at which the *minerals* enter the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (20\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.8\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which minerals exit the tank.\n\nTo find the rate at which minerals leave the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $180\\,\\text{L}$ of liquid; a solution enters at $20\\,\\text{L/min}$ and leaves at $30\\,\\text{L/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\n180+20t-30t=(180-10t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of minerals in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{180-10t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $30\\,\\text{L/min},$ *minerals* leave at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(30\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{180-10t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(30\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{180-10t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{30Q}{180-10t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{3Q}{18-t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.8-\\frac{3Q}{18-t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{3}{18-t}Q=0.8.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 3/(18-t)\\,dt} \\\\  & ={e}^{-3\\operatorname{ln}⁡|18-t|} \\\\  & ={e}^{\\operatorname{ln}⁡(18-t)^{-3}} \\\\  & =(18-t)^{-3}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(18-t)^{-3}$ yields\n\n$$\n\\begin{aligned}(18-t)^{-3}\\cdot (\\frac{dQ}{dt}+\\frac{3}{18-t}Q) & =(18-t)^{-3}\\cdot 0.8 \\\\ (18-t)^{-3}\\frac{dQ}{dt}+3(18-t)^{-4}Q & =0.8(18-t)^{-3} \\\\ \\frac{d}{dt}(Q(18-t)^{-3}) & =0.8(18-t)^{-3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(18-t)^{-3})\\,dt & =\\int 0.8(18-t)^{-3}\\,dt \\\\ Q(18-t)^{-3} & =0.8\\cdot \\frac{1}{2}(18-t)^{-2}+C \\\\ Q(t) & =0.4(18-t)+C(18-t)^{3}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $5\\,\\text{kg}$ of minerals. So, we can apply the initial condition $Q(0)=5,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =5 \\\\ C(18-0)^{3}+0.4(18-0) & =5 \\\\ C(18)^{3}+7.2 & =5 \\\\ C & =-\\frac{2.2}{{18}^{3}}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.4(18-t)-\\frac{2.2}{{18}^{3}}(18-t)^{3} \\\\  & =0.4\\cdot 18\\,(\\frac{18-t}{18})-2.2{(\\frac{18-t}{18})}^{3} \\\\  & =7.2\\,(1-\\frac{t}{18})-2.2{(1-\\frac{t}{18})}^{3}.\\end{aligned}\n$$\n\nFinally, we have $\\alpha =7.2,\\beta =-2.2,$ and\n\n$$\n\\alpha -\\beta =7.2-(-2.2)=9.4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-889a0978-0193-5e72-b84c-66f0c08de47a"] :db/ensure [:question/validate]} {:db/id "answer-field-889a0978-0193-5e72-b84c-66f0c08de47a" :answer-field/id #uuid "889a0978-0193-5e72-b84c-66f0c08de47a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc5946b6-1628-5af6-a597-d8bfff766bd5" :answer-field/choices ["answer-576b7268-d013-5459-8484-febaf9a3d59d" "answer-36064afd-4624-50aa-b9f7-869ddad593ba" "answer-fcd73e85-3ada-52db-9939-f4f819c081ae" "answer-3e30535b-824e-5d84-96a9-2fa046e67302" "answer-dc5946b6-1628-5af6-a597-d8bfff766bd5"] :db/ensure [:answer-field/validate]} {:db/id "answer-576b7268-d013-5459-8484-febaf9a3d59d" :answer/id #uuid "576b7268-d013-5459-8484-febaf9a3d59d" :answer/type :answer.type/math :answer/value "10.2" :db/ensure [:answer/validate]} {:db/id "answer-36064afd-4624-50aa-b9f7-869ddad593ba" :answer/id #uuid "36064afd-4624-50aa-b9f7-869ddad593ba" :answer/type :answer.type/math :answer/value "7.8" :db/ensure [:answer/validate]} {:db/id "answer-fcd73e85-3ada-52db-9939-f4f819c081ae" :answer/id #uuid "fcd73e85-3ada-52db-9939-f4f819c081ae" :answer/type :answer.type/math :answer/value "8.4" :db/ensure [:answer/validate]} {:db/id "answer-3e30535b-824e-5d84-96a9-2fa046e67302" :answer/id #uuid "3e30535b-824e-5d84-96a9-2fa046e67302" :answer/type :answer.type/math :answer/value "8.6" :db/ensure [:answer/validate]} {:db/id "answer-dc5946b6-1628-5af6-a597-d8bfff766bd5" :answer/id #uuid "dc5946b6-1628-5af6-a597-d8bfff766bd5" :answer/type :answer.type/math :answer/value "9.4" :db/ensure [:answer/validate]} {:db/id "activity-94f14c66-ed26-5f37-af33-2767c838df73" :activity/id #uuid "94f14c66-ed26-5f37-af33-2767c838df73" :activity/title "Modeling Mixture Problems With First-Order Linear ODEs" :activity/type :activity.type/review :activity/scope 17592186049774 :activity/course 17592186046660 :activity/steps ["step-a4e0d6d2-b6a6-5fbb-b258-3b0361f5791b" "step-26f140b0-ecb2-541c-a3e2-a942c1e9e51d" "step-9d4027fb-8774-5863-a3bf-da5a07838876" "step-ee40a1ea-a4e8-555a-bdaf-e978762e3880" "step-f973a58e-ae0d-57d7-9deb-27732dfa0736"] :activity/first-step "step-a4e0d6d2-b6a6-5fbb-b258-3b0361f5791b" :db/ensure [:activity/validate]} {:db/id "step-a4e0d6d2-b6a6-5fbb-b258-3b0361f5791b" :step/id #uuid "a4e0d6d2-b6a6-5fbb-b258-3b0361f5791b" :step/content "question-36a65a87-c8d0-5bbf-adbe-0789f4e08164" :step/next "step-26f140b0-ecb2-541c-a3e2-a942c1e9e51d" :db/ensure [:step/validate]} {:db/id "step-26f140b0-ecb2-541c-a3e2-a942c1e9e51d" :step/id #uuid "26f140b0-ecb2-541c-a3e2-a942c1e9e51d" :step/content 17592186385208 :step/next "step-9d4027fb-8774-5863-a3bf-da5a07838876" :db/ensure [:step/validate]} {:db/id "step-9d4027fb-8774-5863-a3bf-da5a07838876" :step/id #uuid "9d4027fb-8774-5863-a3bf-da5a07838876" :step/content "question-6c55e9d5-5244-5391-84ab-9850b2ba8152" :step/next "step-ee40a1ea-a4e8-555a-bdaf-e978762e3880" :db/ensure [:step/validate]} {:db/id "step-ee40a1ea-a4e8-555a-bdaf-e978762e3880" :step/id #uuid "ee40a1ea-a4e8-555a-bdaf-e978762e3880" :step/content 17592186377249 :step/next "step-f973a58e-ae0d-57d7-9deb-27732dfa0736" :db/ensure [:step/validate]} {:db/id "step-f973a58e-ae0d-57d7-9deb-27732dfa0736" :step/id #uuid "f973a58e-ae0d-57d7-9deb-27732dfa0736" :step/content "question-b6915e10-1543-50b0-a358-2c56a1366444" :db/ensure [:step/validate]} {:db/id 17592186087843 :knowledge-point/questions ["question-b35c6507-ab8b-56e8-83d7-4c48d4acc5bc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b35c6507-ab8b-56e8-83d7-4c48d4acc5bc" :question/id #uuid "b35c6507-ab8b-56e8-83d7-4c48d4acc5bc" :question/math-academy-id "q-39806" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{2{x}^{3}}{x(x-3)^{3}}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{3}}{x(x-3)^{3}} \\\\  & =\\frac{2x\\cdot {x}^{2}}{x(x-3)^{3}} \\\\  & =\\frac{2\\cancel{x}\\cdot {x}^{2}}{\\cancel{x}(x-3)^{3}} \\\\  & =\\frac{2{x}^{2}}{(x-3)^{3}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x-3)^{3}=0\n$$\n\nThis gives the solution $x=3.$ Therefore, $x=3$ is the only vertical asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f2c35c17-55da-5b77-8910-3e001dd2509d"] :db/ensure [:question/validate]} {:db/id "answer-field-f2c35c17-55da-5b77-8910-3e001dd2509d" :answer-field/id #uuid "f2c35c17-55da-5b77-8910-3e001dd2509d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-473c7038-e652-54d5-ab9a-ae67ae6333ef" :answer-field/choices ["answer-84c9e974-4825-5131-be89-35779e2c4e6d" "answer-418eab50-c9be-5bde-a643-625b2f0266a9" "answer-32cce2c2-d815-5331-a11b-0d19441db9b9" "answer-cde31b8d-253e-5ef3-ab47-05524cfc02e5" "answer-473c7038-e652-54d5-ab9a-ae67ae6333ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-84c9e974-4825-5131-be89-35779e2c4e6d" :answer/id #uuid "84c9e974-4825-5131-be89-35779e2c4e6d" :answer/type :answer.type/math :answer/value "x=-3,\\,x=0,\\,x=3" :db/ensure [:answer/validate]} {:db/id "answer-418eab50-c9be-5bde-a643-625b2f0266a9" :answer/id #uuid "418eab50-c9be-5bde-a643-625b2f0266a9" :answer/type :answer.type/math :answer/value "x=-3,\\,x=3" :db/ensure [:answer/validate]} {:db/id "answer-32cce2c2-d815-5331-a11b-0d19441db9b9" :answer/id #uuid "32cce2c2-d815-5331-a11b-0d19441db9b9" :answer/type :answer.type/math :answer/value "x=0,\\,x=3" :db/ensure [:answer/validate]} {:db/id "answer-cde31b8d-253e-5ef3-ab47-05524cfc02e5" :answer/id #uuid "cde31b8d-253e-5ef3-ab47-05524cfc02e5" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-473c7038-e652-54d5-ab9a-ae67ae6333ef" :answer/id #uuid "473c7038-e652-54d5-ab9a-ae67ae6333ef" :answer/type :answer.type/text :answer/value "$x=3$ only" :db/ensure [:answer/validate]} {:db/id 17592186087845 :knowledge-point/questions ["question-781bab37-c587-565a-bce8-f5952a2abc55"] :db/ensure [:knowledge-point/validate]} {:db/id "question-781bab37-c587-565a-bce8-f5952a2abc55" :question/id #uuid "781bab37-c587-565a-bce8-f5952a2abc55" :question/math-academy-id "q-80695" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{x-1}{(x-1)({x}^{2}-x+1)}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-1}{(x-1)({x}^{2}-x+1)} \\\\  & =\\frac{\\cancel{x-1}}{\\cancel{(x-1)}({x}^{2}-x+1)} \\\\  & =\\frac{1}{{x}^{2}-x+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}-x+1=0\n$$\n\nThe last equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-1)^{2}-4(1)(1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8422c58a-bb72-5552-8ac2-10a4a7678ba9"] :db/ensure [:question/validate]} {:db/id "answer-field-8422c58a-bb72-5552-8ac2-10a4a7678ba9" :answer-field/id #uuid "8422c58a-bb72-5552-8ac2-10a4a7678ba9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08a7bfaf-f352-5f83-9833-9f14be0ae9bd" :answer-field/choices ["answer-dc1b2574-36d1-5554-90f6-4d4b1edb1776" "answer-ad9d5860-e760-5700-9aff-e93115166a53" "answer-73c848ac-5929-5be7-a1f7-bc2d63b16268" "answer-51293c2d-b318-5b99-9ae4-5ebf29413921" "answer-08a7bfaf-f352-5f83-9833-9f14be0ae9bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc1b2574-36d1-5554-90f6-4d4b1edb1776" :answer/id #uuid "dc1b2574-36d1-5554-90f6-4d4b1edb1776" :answer/type :answer.type/math :answer/value "x=-1,\\,x=1" :db/ensure [:answer/validate]} {:db/id "answer-ad9d5860-e760-5700-9aff-e93115166a53" :answer/id #uuid "ad9d5860-e760-5700-9aff-e93115166a53" :answer/type :answer.type/math :answer/value "x=0,\\,x=1" :db/ensure [:answer/validate]} {:db/id "answer-73c848ac-5929-5be7-a1f7-bc2d63b16268" :answer/id #uuid "73c848ac-5929-5be7-a1f7-bc2d63b16268" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-51293c2d-b318-5b99-9ae4-5ebf29413921" :answer/id #uuid "51293c2d-b318-5b99-9ae4-5ebf29413921" :answer/type :answer.type/text :answer/value "$x=1$ only" :db/ensure [:answer/validate]} {:db/id "answer-08a7bfaf-f352-5f83-9833-9f14be0ae9bd" :answer/id #uuid "08a7bfaf-f352-5f83-9833-9f14be0ae9bd" :answer/type :answer.type/text :answer/value "The function has no vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "activity-fc490cb4-41f1-58ce-80a7-4802442a64c4" :activity/id #uuid "fc490cb4-41f1-58ce-80a7-4802442a64c4" :activity/title "Vertical Asymptotes of Rational Functions" :activity/type :activity.type/review :activity/scope 17592186049363 :activity/course 17592186046647 :activity/steps ["step-53a224c7-b29b-56f8-9951-a3cb256ba6c1" "step-ec1ae9bd-a8a1-5c93-817d-6fbe07478581" "step-166e71ed-29ee-50dc-b54b-0613a103566b"] :activity/first-step "step-53a224c7-b29b-56f8-9951-a3cb256ba6c1" :db/ensure [:activity/validate]} {:db/id "step-53a224c7-b29b-56f8-9951-a3cb256ba6c1" :step/id #uuid "53a224c7-b29b-56f8-9951-a3cb256ba6c1" :step/content 17592186088187 :step/next "step-ec1ae9bd-a8a1-5c93-817d-6fbe07478581" :db/ensure [:step/validate]} {:db/id "step-ec1ae9bd-a8a1-5c93-817d-6fbe07478581" :step/id #uuid "ec1ae9bd-a8a1-5c93-817d-6fbe07478581" :step/content "question-b35c6507-ab8b-56e8-83d7-4c48d4acc5bc" :step/next "step-166e71ed-29ee-50dc-b54b-0613a103566b" :db/ensure [:step/validate]} {:db/id "step-166e71ed-29ee-50dc-b54b-0613a103566b" :step/id #uuid "166e71ed-29ee-50dc-b54b-0613a103566b" :step/content "question-781bab37-c587-565a-bce8-f5952a2abc55" :db/ensure [:step/validate]} [:db/retract 17592186381049 :answer-field/choices 17592186381050] [:db/retract 17592186381049 :answer-field/choices 17592186381051] [:db/retract 17592186381049 :answer-field/choices 17592186381052] [:db/retract 17592186381049 :answer-field/choices 17592186381053] [:db/retract 17592186381049 :answer-field/choices 17592186381054] {:db/id 17592186157605 :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{3}{4}(2x-{x}^{2}),\\,0\\le x\\le 2.\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{0}^{2}{x}^{3}\\cdot \\frac{3}{4}(2x-{x}^{2})\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(\\frac{3}{2}{x}^{4}-\\frac{3}{4}{x}^{5})\\,\\text{d}x \\\\  & ={(\\frac{3}{10}{x}^{5}-\\frac{1}{8}{x}^{6})|}_{0}^{2} \\\\  & =(\\frac{3\\cdot {2}^{5}}{10}-\\frac{{2}^{6}}{8})-0 \\\\  & =\\frac{48}{5}-8 \\\\  & =\\frac{8}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186153874 :answer-field/correct 17592186153879 :db/ensure [:answer-field/validate]} {:db/id 17592186129188 :knowledge-point/questions ["question-7534ff45-14c3-5354-a5be-41324d6a8d58" "question-1d37bcc4-0c9f-508d-8122-95d6a1703d93"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7534ff45-14c3-5354-a5be-41324d6a8d58" :question/id #uuid "7534ff45-14c3-5354-a5be-41324d6a8d58" :question/math-academy-id "q-81246" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-7,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=19,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-7+19) \\\\  & =24\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5f5a94fb-044e-5125-bc1a-367ebc8a739b"] :db/ensure [:question/validate]} {:db/id "answer-field-5f5a94fb-044e-5125-bc1a-367ebc8a739b" :answer-field/id #uuid "5f5a94fb-044e-5125-bc1a-367ebc8a739b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08859865-52fe-5dbb-8f26-32959c6acbd7" :answer-field/choices ["answer-128be196-9e1b-5546-be5b-900e9b7b4df5" "answer-08859865-52fe-5dbb-8f26-32959c6acbd7" "answer-a86dd52e-3027-5c20-8506-094ac20452c7" "answer-adc94108-5e06-511a-9533-0be105c23e85" "answer-2862b1c1-f759-5410-aa00-ccf9a4520165"] :db/ensure [:answer-field/validate]} {:db/id "answer-128be196-9e1b-5546-be5b-900e9b7b4df5" :answer/id #uuid "128be196-9e1b-5546-be5b-900e9b7b4df5" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-08859865-52fe-5dbb-8f26-32959c6acbd7" :answer/id #uuid "08859865-52fe-5dbb-8f26-32959c6acbd7" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-a86dd52e-3027-5c20-8506-094ac20452c7" :answer/id #uuid "a86dd52e-3027-5c20-8506-094ac20452c7" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-adc94108-5e06-511a-9533-0be105c23e85" :answer/id #uuid "adc94108-5e06-511a-9533-0be105c23e85" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "answer-2862b1c1-f759-5410-aa00-ccf9a4520165" :answer/id #uuid "2862b1c1-f759-5410-aa00-ccf9a4520165" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id 17592186162062 :knowledge-point/questions ["question-59606949-3c87-521e-a2c2-60c040472354"] :db/ensure [:knowledge-point/validate]} {:db/id "question-59606949-3c87-521e-a2c2-60c040472354" :question/id #uuid "59606949-3c87-521e-a2c2-60c040472354" :question/math-academy-id "q-109956" :question/problem "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=16$ and $\\text{Var}[Y]=6.$ Find $\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are independent variables, and $a$ and $b$ are constants, then \n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y]={(\\frac{3}{8})}^{2}\\cdot 16+{(\\frac{1}{2})}^{2}\\cdot 6=\\frac{15}{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3a192929-90b9-5ade-b716-7719dbfc5bbf"] :db/ensure [:question/validate]} {:db/id "answer-field-3a192929-90b9-5ade-b716-7719dbfc5bbf" :answer-field/id #uuid "3a192929-90b9-5ade-b716-7719dbfc5bbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-074012c5-6ca1-5495-8009-0d0c255d3ee8" :answer-field/choices ["answer-1bc800b9-5ce9-51df-9646-ad28b4b5f5dd" "answer-d18a0d10-9bd4-5e8e-9023-0b2590d9b92f" "answer-81f7e7be-4c3c-5db4-9e89-a897730e6bd7" "answer-074012c5-6ca1-5495-8009-0d0c255d3ee8" "answer-afc9329d-23eb-511f-aef5-7c8e3284646b"] :db/ensure [:answer-field/validate]} {:db/id "answer-1bc800b9-5ce9-51df-9646-ad28b4b5f5dd" :answer/id #uuid "1bc800b9-5ce9-51df-9646-ad28b4b5f5dd" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-d18a0d10-9bd4-5e8e-9023-0b2590d9b92f" :answer/id #uuid "d18a0d10-9bd4-5e8e-9023-0b2590d9b92f" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-81f7e7be-4c3c-5db4-9e89-a897730e6bd7" :answer/id #uuid "81f7e7be-4c3c-5db4-9e89-a897730e6bd7" :answer/type :answer.type/math :answer/value "\\frac{155}{32}" :db/ensure [:answer/validate]} {:db/id "answer-074012c5-6ca1-5495-8009-0d0c255d3ee8" :answer/id #uuid "074012c5-6ca1-5495-8009-0d0c255d3ee8" :answer/type :answer.type/math :answer/value "\\frac{15}{4}" :db/ensure [:answer/validate]} {:db/id "answer-afc9329d-23eb-511f-aef5-7c8e3284646b" :answer/id #uuid "afc9329d-23eb-511f-aef5-7c8e3284646b" :answer/type :answer.type/math :answer/value "\\frac{41}{4}" :db/ensure [:answer/validate]} {:db/id 17592186381048 :question/worked-solution "First, notice that $f(x,y)=\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,y\\ne 0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}(x,y)=-\\frac{{e}^{-x}}{y}$ is defined only when $y\\ne 0.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,y\\ne 0\\}.\n$$\n\n- Similarly, the domain of ${f}_{y}$ is the same: \n\n$$\n{D}_{{f}_{y}}=\\{(x,y)\\,:\\,y\\ne 0\\}\n$$\n\nFinally, we conclude that the partials of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}} & =\\{(x,y)\\,:\\,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,y\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,y\\ne 0\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186381049 :answer-field/correct "answer-d41c428c-d04e-5f2e-a433-2206f490a862" :answer-field/choices ["answer-f0bf3fe3-986e-545e-b34a-605fe91bb5de" "answer-646b7d0d-81dc-553a-84a0-b0fc791fa343" "answer-3f1523c2-f133-58a1-bbf8-fd7a6928b953" "answer-0c87158e-2c98-5786-92c3-7401ac9880a4" "answer-d41c428c-d04e-5f2e-a433-2206f490a862"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0bf3fe3-986e-545e-b34a-605fe91bb5de" :answer/id #uuid "f0bf3fe3-986e-545e-b34a-605fe91bb5de" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y>0\\,\\text{and}\\,x>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-646b7d0d-81dc-553a-84a0-b0fc791fa343" :answer/id #uuid "646b7d0d-81dc-553a-84a0-b0fc791fa343" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3f1523c2-f133-58a1-bbf8-fd7a6928b953" :answer/id #uuid "3f1523c2-f133-58a1-bbf8-fd7a6928b953" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-0c87158e-2c98-5786-92c3-7401ac9880a4" :answer/id #uuid "0c87158e-2c98-5786-92c3-7401ac9880a4" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-d41c428c-d04e-5f2e-a433-2206f490a862" :answer/id #uuid "d41c428c-d04e-5f2e-a433-2206f490a862" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id 17592186162588 :question/problem "Consider the bilinear form $B(x,y),$ given by \n\n$$\nB(x,y)={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}-{x}_{2}{y}_{3}+{x}_{3}{y}_{3}.\n$$\n\n \n\nEvaluate $B(x,y)$ when $x=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]$ and $y=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$" :question/worked-solution "We are given that \n\n$\\,$ $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]\\,$ and $\\,y=[\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$\n\nSubstituting these into the bilinear expression, we obtain\n\n$$\n\\begin{aligned}B(x,y) & ={x}_{1}{y}_{1}-3{x}_{1}{y}_{3}-{x}_{2}{y}_{3}+{x}_{3}{y}_{3} \\\\  & =1\\cdot 2-3\\cdot 1\\cdot 1-0\\cdot 1+(-4)\\cdot 1 \\\\  & =2-3+0-4 \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186160820 :answer-field/correct 17592186160825 :db/ensure [:answer-field/validate]} {:db/id 17592186162240 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X∼{χ}^{2}(k).$  Given that the random variable $X∼{χ}^{2}(10),$ find the value of $x$ such that $P(X>x)=0.950.$\n\n| $k∖p$ | $0.995$ | $0.990$ | $0.975$ | $0.950$ | $0.900$ |\n| --- | --- | --- | --- | --- | --- |\n| $8$ | $\\,1.344\\,$ | $\\,1.646\\,$ | $\\,2.180\\,$ | $\\,2.733\\,$ | $\\,3.490\\,$ |\n| $9$ | $\\,1.735\\,$ | $\\,2.088\\,$ | $\\,2.700\\,$ | $\\,3.325\\,$ | $\\,4.168\\,$ |\n| $10$ | $\\,2.156\\,$ | $\\,2.558\\,$ | $\\,3.247\\,$ | $\\,3.940\\,$ | $\\,4.865\\,$ |" :question/worked-solution "Since $X∼{χ}^{2}(10),$ we focus on the row of the table that corresponds to $k=10.$\n\n| $k∖p$ | $0.995$ | $0.990$ | $0.975$ | $0.950$ | $0.900$ |\n| --- | --- | --- | --- | --- | --- |\n| $10$ | $\\,2.156\\,$ | $\\,2.558\\,$ | $\\,3.247\\,$ | $\\,3.940\\,$ | $\\,4.865\\,$ |\n\nFrom this row, we see that\n\n$$\nP(X>3.940)=0.950.\n$$\n\nTherefore, our answer is $x=3.940.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186158642 :answer-field/correct 17592186158644 :db/ensure [:answer-field/validate]} {:db/id "activity-b555139b-2962-5dd6-b346-b8e6df95cc7b" :activity/id #uuid "b555139b-2962-5dd6-b346-b8e6df95cc7b" :activity/title "Quiz 10" :activity/type :activity.type/assessment :activity/course 17592186046658 :activity/steps ["step-0227aae6-d172-57f4-83e8-b1350d2428e9" "step-e89dc435-8fab-54ad-b411-67e8259e3a52" "step-35856cad-af45-592b-875b-efaabf6558c1" "step-377d1b56-e249-5637-8fc7-52e7cdfb6112" "step-baf61fcf-e594-5cc6-83eb-990554bce235" "step-b888148b-c958-5b54-a1f1-35cce9975a68" "step-818eca0c-b233-5882-9188-be81b881f643" "step-8a77be89-756b-53de-80cd-2a432d18bca3"] :activity/first-step "step-0227aae6-d172-57f4-83e8-b1350d2428e9" :db/ensure [:activity/validate]} {:db/id "step-0227aae6-d172-57f4-83e8-b1350d2428e9" :step/id #uuid "0227aae6-d172-57f4-83e8-b1350d2428e9" :step/content 17592186157605 :step/next "step-e89dc435-8fab-54ad-b411-67e8259e3a52" :db/ensure [:step/validate]} {:db/id "step-e89dc435-8fab-54ad-b411-67e8259e3a52" :step/id #uuid "e89dc435-8fab-54ad-b411-67e8259e3a52" :step/content "question-7534ff45-14c3-5354-a5be-41324d6a8d58" :step/next "step-35856cad-af45-592b-875b-efaabf6558c1" :db/ensure [:step/validate]} {:db/id "step-35856cad-af45-592b-875b-efaabf6558c1" :step/id #uuid "35856cad-af45-592b-875b-efaabf6558c1" :step/content "question-59606949-3c87-521e-a2c2-60c040472354" :step/next "step-377d1b56-e249-5637-8fc7-52e7cdfb6112" :db/ensure [:step/validate]} {:db/id "step-377d1b56-e249-5637-8fc7-52e7cdfb6112" :step/id #uuid "377d1b56-e249-5637-8fc7-52e7cdfb6112" :step/content 17592186272239 :step/next "step-baf61fcf-e594-5cc6-83eb-990554bce235" :db/ensure [:step/validate]} {:db/id "step-baf61fcf-e594-5cc6-83eb-990554bce235" :step/id #uuid "baf61fcf-e594-5cc6-83eb-990554bce235" :step/content 17592186326849 :step/next "step-b888148b-c958-5b54-a1f1-35cce9975a68" :db/ensure [:step/validate]} {:db/id "step-b888148b-c958-5b54-a1f1-35cce9975a68" :step/id #uuid "b888148b-c958-5b54-a1f1-35cce9975a68" :step/content 17592186381048 :step/next "step-818eca0c-b233-5882-9188-be81b881f643" :db/ensure [:step/validate]} {:db/id "step-818eca0c-b233-5882-9188-be81b881f643" :step/id #uuid "818eca0c-b233-5882-9188-be81b881f643" :step/content 17592186162588 :step/next "step-8a77be89-756b-53de-80cd-2a432d18bca3" :db/ensure [:step/validate]} {:db/id "step-8a77be89-756b-53de-80cd-2a432d18bca3" :step/id #uuid "8a77be89-756b-53de-80cd-2a432d18bca3" :step/content 17592186162240 :db/ensure [:step/validate]} {:db/id 17592186064169 :knowledge-point/questions ["question-daa61eb1-b03b-51c0-8270-14c708ae1e5c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-daa61eb1-b03b-51c0-8270-14c708ae1e5c" :question/id #uuid "daa61eb1-b03b-51c0-8270-14c708ae1e5c" :question/math-academy-id "q-29643" :question/problem "$\\int \\frac{1}{{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Note that $\\frac{1}{{x}^{5}}={x}^{-5}.$ So, we can use the power rule with $n=-5$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{5}}\\,\\text{d}x & =\\int {x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}+C \\\\  & =\\frac{{x}^{-4}}{-4}+C \\\\  & =-\\frac{1}{4{x}^{4}}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-df1e8bd8-c60e-5022-8cc3-6497fe7a88f5"] :db/ensure [:question/validate]} {:db/id "answer-field-df1e8bd8-c60e-5022-8cc3-6497fe7a88f5" :answer-field/id #uuid "df1e8bd8-c60e-5022-8cc3-6497fe7a88f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer-field/choices ["answer-0c33caad-bb2f-5503-bf90-b0887fffc7de" "answer-58bcf515-bc8d-5c7f-a87c-e1d6836d3944" "answer-720da65f-7b8d-5025-8be5-6124aff10c66" "answer-395b2c98-0606-52cd-ad1e-4a590c5bc289" "answer-9358fcee-68fe-5474-97b4-702d3a35e3e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/id #uuid "0c33caad-bb2f-5503-bf90-b0887fffc7de" :answer/type :answer.type/math :answer/value "-\\frac{1}{4{x}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "answer-58bcf515-bc8d-5c7f-a87c-e1d6836d3944" :answer/id #uuid "58bcf515-bc8d-5c7f-a87c-e1d6836d3944" :answer/type :answer.type/math :answer/value "-\\frac{1}{4{x}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "answer-720da65f-7b8d-5025-8be5-6124aff10c66" :answer/id #uuid "720da65f-7b8d-5025-8be5-6124aff10c66" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{4}}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-395b2c98-0606-52cd-ad1e-4a590c5bc289" :answer/id #uuid "395b2c98-0606-52cd-ad1e-4a590c5bc289" :answer/type :answer.type/math :answer/value "\\frac{1}{4{x}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "answer-9358fcee-68fe-5474-97b4-702d3a35e3e1" :answer/id #uuid "9358fcee-68fe-5474-97b4-702d3a35e3e1" :answer/type :answer.type/math :answer/value "\\frac{4}{{x}^{4}}+C" :db/ensure [:answer/validate]} {:db/id 17592186064168 :knowledge-point/questions ["question-31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" "question-9e0b25f6-0e44-56a6-a167-f47173302a18"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" :question/id #uuid "31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" :question/math-academy-id "q-29652" :question/problem "What is the antiderivative of $\\sqrt[5]{{x}^{7}}?$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{7}}={x}^{7/5}.$ So, we can apply the power rule with $n=\\frac{7}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{7}}\\,\\text{d}x & =\\int {x}^{7/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{7/5+1}}{(\\frac{7}{5}+1)}+C \\\\  & =\\frac{{x}^{12/5}}{(\\frac{12}{5})}+C \\\\  & =\\frac{5{x}^{12/5}}{12}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{12}\\frac{\\text{d}}{\\text{d}x}({x}^{12/5})+0 & = \\\\ \\frac{5}{12}\\cdot \\frac{12}{5}{x}^{12/5-1} & = \\\\ {x}^{7/5}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-05367c1f-7c48-5001-bd7f-8cd94f9a1ee7"] :db/ensure [:question/validate]} {:db/id "answer-field-05367c1f-7c48-5001-bd7f-8cd94f9a1ee7" :answer-field/id #uuid "05367c1f-7c48-5001-bd7f-8cd94f9a1ee7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer-field/choices ["answer-63c2faca-0edb-5ef8-8326-5900825078b1" "answer-73e207b9-91a9-5b1a-8a15-f29313c6b433" "answer-da7a61db-d353-5a53-b318-1be353f60fe6" "answer-fbfa7707-765d-5937-8a04-fb11b50efc05" "answer-ed9e9b62-8e00-5346-a13f-699ec44a7450"] :db/ensure [:answer-field/validate]} {:db/id "answer-63c2faca-0edb-5ef8-8326-5900825078b1" :answer/id #uuid "63c2faca-0edb-5ef8-8326-5900825078b1" :answer/type :answer.type/math :answer/value "\\frac{3\\cdot {6}^{3/5}}{2}{x}^{11/5}+C" :db/ensure [:answer/validate]} {:db/id "answer-73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/id #uuid "73e207b9-91a9-5b1a-8a15-f29313c6b433" :answer/type :answer.type/math :answer/value "\\frac{5{x}^{12/5}}{12}+C" :db/ensure [:answer/validate]} {:db/id "answer-da7a61db-d353-5a53-b318-1be353f60fe6" :answer/id #uuid "da7a61db-d353-5a53-b318-1be353f60fe6" :answer/type :answer.type/math :answer/value "\\frac{{31}^{2/5}}{32}{x}^{7/5}+C" :db/ensure [:answer/validate]} {:db/id "answer-fbfa7707-765d-5937-8a04-fb11b50efc05" :answer/id #uuid "fbfa7707-765d-5937-8a04-fb11b50efc05" :answer/type :answer.type/math :answer/value "\\frac{{36}^{2/5}}{72}{x}^{12/5}+C" :db/ensure [:answer/validate]} {:db/id "answer-ed9e9b62-8e00-5346-a13f-699ec44a7450" :answer/id #uuid "ed9e9b62-8e00-5346-a13f-699ec44a7450" :answer/type :answer.type/math :answer/value "\\frac{{7}^{2/5}}{2}{x}^{7/5}+C" :db/ensure [:answer/validate]} {:db/id "question-9e0b25f6-0e44-56a6-a167-f47173302a18" :question/id #uuid "9e0b25f6-0e44-56a6-a167-f47173302a18" :question/math-academy-id "q-113672" :question/problem "Find the antiderivative of ${x}^{4/5}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{4/5}\\,\\text{d}x & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{(\\frac{9}{5})}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 & = \\\\ \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} & = \\\\ {x}^{4/5}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fa476148-4520-535e-8de8-c555998b437f"] :db/ensure [:question/validate]} {:db/id "answer-field-fa476148-4520-535e-8de8-c555998b437f" :answer-field/id #uuid "fa476148-4520-535e-8de8-c555998b437f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer-field/choices ["answer-f746d0ee-4d45-5138-a444-dd8fb7c426b1" "answer-da8619fc-53ce-586e-8d07-73efa17d3b93" "answer-de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" "answer-a6d02e90-1b24-51db-a87e-21fe5d5fa85e" "answer-29b5785c-9c86-58fa-8702-7b20eaf94717"] :db/ensure [:answer-field/validate]} {:db/id "answer-f746d0ee-4d45-5138-a444-dd8fb7c426b1" :answer/id #uuid "f746d0ee-4d45-5138-a444-dd8fb7c426b1" :answer/type :answer.type/math :answer/value "\\frac{4{x}^{9/5}}{9}+C" :db/ensure [:answer/validate]} {:db/id "answer-da8619fc-53ce-586e-8d07-73efa17d3b93" :answer/id #uuid "da8619fc-53ce-586e-8d07-73efa17d3b93" :answer/type :answer.type/math :answer/value "\\frac{5{x}^{7/5}}{7}+C" :db/ensure [:answer/validate]} {:db/id "answer-de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/id #uuid "de3f6a49-2e44-56e2-9f7d-ad3b02678d8f" :answer/type :answer.type/math :answer/value "\\frac{5{x}^{9/5}}{9}+C" :db/ensure [:answer/validate]} {:db/id "answer-a6d02e90-1b24-51db-a87e-21fe5d5fa85e" :answer/id #uuid "a6d02e90-1b24-51db-a87e-21fe5d5fa85e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{7/5}}{7}+C" :db/ensure [:answer/validate]} {:db/id "answer-29b5785c-9c86-58fa-8702-7b20eaf94717" :answer/id #uuid "29b5785c-9c86-58fa-8702-7b20eaf94717" :answer/type :answer.type/math :answer/value "\\frac{{x}^{9/5}}{5}+C" :db/ensure [:answer/validate]} {:db/id "activity-914f9819-f327-5e6a-85cc-1bd162c1bdb7" :activity/id #uuid "914f9819-f327-5e6a-85cc-1bd162c1bdb7" :activity/title "The Antiderivative" :activity/type :activity.type/review :activity/scope 17592186049481 :activity/course 17592186046647 :activity/steps ["step-8710f1ed-7ac6-5f59-9036-f5fd5d25704b" "step-d31b98f2-92d7-5a95-b4b5-20b07dc55a06" 