fcbf-aa91-5aa1-9258-47bfadefbc7d" :step/id #uuid "7d9afcbf-aa91-5aa1-9258-47bfadefbc7d" :step/content 17592186281374 :step/next "step-4db3fcce-be9d-5f42-a907-5f887c87d7cd" :db/ensure [:step/validate]} {:db/id "step-4db3fcce-be9d-5f42-a907-5f887c87d7cd" :step/id #uuid "4db3fcce-be9d-5f42-a907-5f887c87d7cd" :step/content 17592186405076 :step/next "step-91e8a20b-e6de-543d-ae33-ca160809893a" :db/ensure [:step/validate]} {:db/id "step-91e8a20b-e6de-543d-ae33-ca160809893a" :step/id #uuid "91e8a20b-e6de-543d-ae33-ca160809893a" :step/content 17592186281375 :step/next "step-59d7191b-c0b7-517e-bf2f-a21f70175ce1" :db/ensure [:step/validate]} {:db/id "step-59d7191b-c0b7-517e-bf2f-a21f70175ce1" :step/id #uuid "59d7191b-c0b7-517e-bf2f-a21f70175ce1" :step/content 17592186281376 :db/ensure [:step/validate]} [:db/retract 17592186128713 :answer-field/choices 17592186128714] [:db/retract 17592186128713 :answer-field/choices 17592186128715] [:db/retract 17592186128713 :answer-field/choices 17592186128716] [:db/retract 17592186128713 :answer-field/choices 17592186128717] [:db/retract 17592186128713 :answer-field/choices 17592186128718] {:db/id 17592186129172 :knowledge-point/questions ["question-66ff7371-5323-5876-b071-49b4ca2a6463"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129872 :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y,\\, & \\text{if}\\,0<x<2,\\,-1<y<0, \\\\ \\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<2,\\,0<y<1.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,2)\\times (-1,1)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,2)\\times ((-1,0)\\cup (0,1)) \\\\  & =((0,2)\\times (-1,0))\\cup ((0,2)\\times (0,1)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,2)\\times (-1,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186128713 :answer-field/correct "answer-c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" :answer-field/choices ["answer-5ba92148-b911-57fa-bcc8-d6592d9da4b9" "answer-48d84918-aaf4-5e48-802a-eb621ffae666" "answer-c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" "answer-822a278f-47f8-5535-9796-535bd9d05cea" "answer-34b43744-10b8-5bdd-86b0-6a7b66637027"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ba92148-b911-57fa-bcc8-d6592d9da4b9" :answer/id #uuid "5ba92148-b911-57fa-bcc8-d6592d9da4b9" :answer/type :answer.type/math :answer/value "{∬}_{(-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-48d84918-aaf4-5e48-802a-eb621ffae666" :answer/id #uuid "48d84918-aaf4-5e48-802a-eb621ffae666" :answer/type :answer.type/math :answer/value "{∬}_{(0,1)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(1,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" :answer/id #uuid "c5b9d0b8-9a3f-5bdc-b4d0-bb4eb57acfcf" :answer/type :answer.type/math :answer/value "{∬}_{(0,2)\\times (-1,0)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (0,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-822a278f-47f8-5535-9796-535bd9d05cea" :answer/id #uuid "822a278f-47f8-5535-9796-535bd9d05cea" :answer/type :answer.type/math :answer/value "{∬}_{(0,2)\\times (-1,1)}(x+y)\\,\\text{d}A+{∬}_{(0,2)\\times (-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-34b43744-10b8-5bdd-86b0-6a7b66637027" :answer/id #uuid "34b43744-10b8-5bdd-86b0-6a7b66637027" :answer/type :answer.type/math :answer/value "{∬}_{(0,2)}(x+y)\\,\\text{d}A+{∬}_{(-1,1)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "question-66ff7371-5323-5876-b071-49b4ca2a6463" :question/id #uuid "66ff7371-5323-5876-b071-49b4ca2a6463" :question/math-academy-id "q-80674" :question/problem "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<\\pi ,\\,-\\frac{\\pi }{2}<y<0, \\\\ \\operatorname{cos}⁡(x-y),\\, & \\text{if}\\,0<x<\\pi ,\\,0<y<\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,\\pi )\\times ((-\\frac{\\pi }{2},0)\\cup (0,\\frac{\\pi }{2})) \\\\  & =((0,\\pi )\\times (-\\frac{\\pi }{2},0))\\cup ((0,\\pi )\\times (0,\\frac{\\pi }{2})).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c22f973c-4187-5d34-928b-a206bc95c78a"] :db/ensure [:question/validate]} {:db/id "answer-field-c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/id #uuid "c22f973c-4187-5d34-928b-a206bc95c78a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer-field/choices ["answer-27dab55e-2a07-5559-adf9-474a787ae042" "answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" "answer-db274e58-8e5f-5077-88fc-c9024b1f6057" "answer-4a503419-3b03-55f7-a026-c71a3cdf1fda" "answer-cf8aa907-71bd-57bd-b9b0-a791585844c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-27dab55e-2a07-5559-adf9-474a787ae042" :answer/id #uuid "27dab55e-2a07-5559-adf9-474a787ae042" :answer/type :answer.type/math :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/id #uuid "ff3ec6df-aa0b-5131-ba4c-022b02da3f60" :answer/type :answer.type/math :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/id #uuid "db274e58-8e5f-5077-88fc-c9024b1f6057" :answer/type :answer.type/math :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\operatorname{cos}⁡(x-y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/id #uuid "4a503419-3b03-55f7-a026-c71a3cdf1fda" :answer/type :answer.type/math :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x-y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x+y)\\,\\text{d}A" :db/ensure [:answer/validate]} {:db/id "answer-cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/id #uuid "cf8aa907-71bd-57bd-b9b0-a791585844c8" :answer/type :answer.type/math :answer/value "{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}(\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x-y))\\text{ }\\text{d}A" :db/ensure [:answer/validate]} {:db/id "question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/id #uuid "1d37bcc4-0c9f-508d-8122-95d6a1703d93" :question/math-academy-id "q-130018" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=-10,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-5-10) \\\\  & =-30\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd"] :db/ensure [:question/validate]} {:db/id "answer-field-f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/id #uuid "f08a4b5c-ff94-5bb7-9fc3-45c47e3170dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-46d7da2f-b178-5341-932f-188c6b740b71" :answer-field/choices ["answer-408ff810-6b9d-5b26-be6c-01ffe1516381" "answer-983a9eb5-d569-52ad-9779-68218cfae321" "answer-46d7da2f-b178-5341-932f-188c6b740b71" "answer-66769113-8309-511d-b9f9-0e68f7f4b5a4" "answer-744ab5e2-ab3a-5799-8335-66148f7759ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/id #uuid "408ff810-6b9d-5b26-be6c-01ffe1516381" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-983a9eb5-d569-52ad-9779-68218cfae321" :answer/id #uuid "983a9eb5-d569-52ad-9779-68218cfae321" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-46d7da2f-b178-5341-932f-188c6b740b71" :answer/id #uuid "46d7da2f-b178-5341-932f-188c6b740b71" :answer/type :answer.type/math :answer/value "-30" :db/ensure [:answer/validate]} {:db/id "answer-66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/id #uuid "66769113-8309-511d-b9f9-0e68f7f4b5a4" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/id #uuid "744ab5e2-ab3a-5799-8335-66148f7759ef" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id 17592186380894 :question/problem "![](images/e5/e50797d61a59cf8533e86695c03da168bff7e59ce363e0ee42bb700de515385f.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{x}{y}, & (x,y)\\in S, \\\\ {x}^{2}-x{y}^{3}, & (x,y)\\in T, \\\\ 0, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :db/ensure [:question/validate]} {:db/id "activity-d5e426ab-ae67-5398-8c45-a2967a7a35dc" :activity/id #uuid "d5e426ab-ae67-5398-8c45-a2967a7a35dc" :activity/title "Properties of Double Integrals" :activity/type :activity.type/review :activity/scope 17592186050546 :activity/course 17592186046658 :activity/steps ["step-cd03560a-f875-5516-bfa6-d69e8b5f5aca" "step-ca77b050-7163-5e44-bed7-5cbfe6365a13" "step-893db046-3a6d-56c7-8f63-bc9d855915b3" "step-76b49b70-28b4-5fb8-b154-916347e649e4" "step-2a278359-e48b-574c-8558-aec54e3db4bf"] :activity/first-step "step-cd03560a-f875-5516-bfa6-d69e8b5f5aca" :db/ensure [:activity/validate]} {:db/id "step-cd03560a-f875-5516-bfa6-d69e8b5f5aca" :step/id #uuid "cd03560a-f875-5516-bfa6-d69e8b5f5aca" :step/content 17592186129872 :step/next "step-ca77b050-7163-5e44-bed7-5cbfe6365a13" :db/ensure [:step/validate]} {:db/id "step-ca77b050-7163-5e44-bed7-5cbfe6365a13" :step/id #uuid "ca77b050-7163-5e44-bed7-5cbfe6365a13" :step/content "question-66ff7371-5323-5876-b071-49b4ca2a6463" :step/next "step-893db046-3a6d-56c7-8f63-bc9d855915b3" :db/ensure [:step/validate]} {:db/id "step-893db046-3a6d-56c7-8f63-bc9d855915b3" :step/id #uuid "893db046-3a6d-56c7-8f63-bc9d855915b3" :step/content 17592186380873 :step/next "step-76b49b70-28b4-5fb8-b154-916347e649e4" :db/ensure [:step/validate]} {:db/id "step-76b49b70-28b4-5fb8-b154-916347e649e4" :step/id #uuid "76b49b70-28b4-5fb8-b154-916347e649e4" :step/content "question-1d37bcc4-0c9f-508d-8122-95d6a1703d93" :step/next "step-2a278359-e48b-574c-8558-aec54e3db4bf" :db/ensure [:step/validate]} {:db/id "step-2a278359-e48b-574c-8558-aec54e3db4bf" :step/id #uuid "2a278359-e48b-574c-8558-aec54e3db4bf" :step/content 17592186380894 :db/ensure [:step/validate]} {:db/id 17592186166934 :knowledge-point/questions ["question-9ca91093-1f1e-55da-a457-e3e1666bf899" "question-24075bbd-fad1-5e70-847c-3b96960e39c5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9ca91093-1f1e-55da-a457-e3e1666bf899" :question/id #uuid "9ca91093-1f1e-55da-a457-e3e1666bf899" :question/math-academy-id "q-333069" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t)+4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{2}(t)+1,\\end{aligned}\\,x(0)=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}} $,\\,$\n${X}_{2}(s)=\\frac{3s+1}{s(s+2)}$ ." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{-{x}_{1}(t)+4{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{2}(t)+1\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=-L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{2}(t)\\}+L\\{1\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+1=-{X}_{1}(s)+4{X}_{2}(s) \\\\ s{X}_{2}(s)-3=-2{X}_{2}(s)+\\frac{1}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the second equation for ${X}_{2}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{2}(s)-3 & =-2{X}_{2}(s)+\\frac{1}{s} \\\\ (s+2){X}_{2}(s) & =3+\\frac{1}{s} \\\\ (s+2){X}_{2}(s) & =\\frac{3s+1}{s} \\\\ {X}_{2}(s) & =\\frac{3s+1}{s(s+2)}.\\end{aligned}\n$$\n\nSubstituting this in the first equation and solving for ${X}_{1}(s)$, we have\n\n$$\n\\begin{aligned}s{X}_{1}(s)+1 & =-{X}_{1}(s)+4{X}_{2}(s) \\\\ (s+1){X}_{1}(s) & =4{X}_{2}(s)-1 \\\\ (s+1){X}_{1}(s) & =4(\\frac{3s+1}{s(s+2)})-1 \\\\ (s+1){X}_{1}(s) & =\\frac{4(3s+1)-s(s+2)}{s(s+2)} \\\\ (s+1){X}_{1}(s) & =\\frac{12s+4-({s}^{2}+2s)}{s(s+2)} \\\\ (s+1){X}_{1}(s) & =\\frac{-{s}^{2}+10s+4}{s(s+2)} \\\\ {X}_{1}(s) & =\\frac{-{s}^{2}+10s+4}{s(s+2)(s+1)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{-{s}^{2}+10s+4}{s(s+1)(s+2)},\\,{X}_{2}(s)=\\frac{3s+1}{s(s+2)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b8de0228-5ef5-53a6-b77b-949275d4025a"] :db/ensure [:question/validate]} {:db/id "answer-field-b8de0228-5ef5-53a6-b77b-949275d4025a" :answer-field/id #uuid "b8de0228-5ef5-53a6-b77b-949275d4025a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-69712d4c-92b7-5f9d-abcd-ca7ad46c6567" :answer-field/choices ["answer-69712d4c-92b7-5f9d-abcd-ca7ad46c6567"] :db/ensure [:answer-field/validate]} {:db/id "answer-69712d4c-92b7-5f9d-abcd-ca7ad46c6567" :answer/id #uuid "69712d4c-92b7-5f9d-abcd-ca7ad46c6567" :answer/type :answer.type/math :answer/value "\\frac{-s^2+10s+4}{s(s+1)(s+2)}" :db/ensure [:answer/validate]} {:db/id "question-24075bbd-fad1-5e70-847c-3b96960e39c5" :question/id #uuid "24075bbd-fad1-5e70-847c-3b96960e39c5" :question/math-academy-id "q-333072" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{2}(t)+3,\\end{aligned}\\,x(0)=[\\begin{aligned}-2 \\\\ 0\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},$\\,$\n${X}_{2}(s)=\\frac{3}{s(s+1)}.$" :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)-2{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-{x}_{2}(t)+3\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}-2L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-L\\{{x}_{2}(t)\\}+3L\\{1\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+2={X}_{1}(s)-2{X}_{2}(s) \\\\ s{X}_{2}(s)-0=-{X}_{2}(s)+\\frac{3}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the second equation for ${X}_{2}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{2}(s) & =-{X}_{2}(s)+\\frac{3}{s} \\\\ (s+1){X}_{2}(s) & =\\frac{3}{s} \\\\ {X}_{2}(s) & =\\frac{3}{s(s+1)}.\\end{aligned}\n$$\n\nSubstituting this in the first equation and solving for ${X}_{1}(s)$, we have\n\n$$\n\\begin{aligned}s{X}_{1}(s)+2 & ={X}_{1}(s)-2{X}_{2}(s) \\\\ (s-1){X}_{1}(s) & =-2-2{X}_{2}(s) \\\\ (s-1){X}_{1}(s) & =-2-2(\\frac{3}{s(s+1)}) \\\\ (s-1){X}_{1}(s) & =\\frac{-2s(s+1)-6}{s(s+1)} \\\\ (s-1){X}_{1}(s) & =\\frac{-2({s}^{2}+s)-6}{s(s+1)} \\\\ (s-1){X}_{1}(s) & =\\frac{-2{s}^{2}-2s-6}{s(s+1)} \\\\ {X}_{1}(s) & =\\frac{-2{s}^{2}-2s-6}{s(s+1)(s-1)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{-2{s}^{2}-2s-6}{s(s-1)(s+1)},\\,{X}_{2}(s)=\\frac{3}{s(s+1)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1abf10fb-79e5-50b9-8eca-b49f881c098e"] :db/ensure [:question/validate]} {:db/id "answer-field-1abf10fb-79e5-50b9-8eca-b49f881c098e" :answer-field/id #uuid "1abf10fb-79e5-50b9-8eca-b49f881c098e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7f4b480b-46bc-5ad0-b2dc-179d612978aa" :answer-field/choices ["answer-7f4b480b-46bc-5ad0-b2dc-179d612978aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f4b480b-46bc-5ad0-b2dc-179d612978aa" :answer/id #uuid "7f4b480b-46bc-5ad0-b2dc-179d612978aa" :answer/type :answer.type/math :answer/value "\\frac{-2s^2-2s-6}{s(s-1)(s+1)}" :db/ensure [:answer/validate]} {:db/id 17592186166935 :knowledge-point/questions ["question-0823a96b-ef1d-57d5-85ea-8ef149bb4b9a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0823a96b-ef1d-57d5-85ea-8ef149bb4b9a" :question/id #uuid "0823a96b-ef1d-57d5-85ea-8ef149bb4b9a" :question/math-academy-id "q-333132" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{2}(t)-4,\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ 2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{2}{s-2}-\\frac{1}{s-4}+\\frac{1}{s},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1}{s-4}+\\frac{1}{s}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"40px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-2}-\\frac{1}{s-4}+\\frac{1}{s}\\} \\\\  & =2\\,{L}^{-1}\\{\\frac{1}{s-2}\\}-{L}^{-1}\\{\\frac{1}{s-4}\\}+{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =2{e}^{2\\cdot t}-{e}^{4\\cdot t}+1 \\\\  & =-{e}^{4t}+2{e}^{2t}+1 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-4}+\\frac{1}{s}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-4}\\}+{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & ={e}^{4\\cdot t}+1 \\\\  & ={e}^{4t}+1\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}-{e}^{4t}+2{e}^{2t}+1 \\\\ {e}^{4t}+1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dbe9fab9-0798-54e1-b0d4-366304913f18" "answer-field-428707b6-8d94-52b6-9362-47c3559ec433"] :db/ensure [:question/validate]} {:db/id "answer-field-dbe9fab9-0798-54e1-b0d4-366304913f18" :answer-field/id #uuid "dbe9fab9-0798-54e1-b0d4-366304913f18" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8e2e4b8f-9b19-50ef-87e0-50189c923190" :answer-field/choices ["answer-8e2e4b8f-9b19-50ef-87e0-50189c923190"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e2e4b8f-9b19-50ef-87e0-50189c923190" :answer/id #uuid "8e2e4b8f-9b19-50ef-87e0-50189c923190" :answer/type :answer.type/math :answer/value "-e^{4t}+2e^{2t}+1" :db/ensure [:answer/validate]} {:db/id "answer-field-428707b6-8d94-52b6-9362-47c3559ec433" :answer-field/id #uuid "428707b6-8d94-52b6-9362-47c3559ec433" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ff5d65f0-c6de-5048-a2be-21f61c684329" :answer-field/choices ["answer-ff5d65f0-c6de-5048-a2be-21f61c684329"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff5d65f0-c6de-5048-a2be-21f61c684329" :answer/id #uuid "ff5d65f0-c6de-5048-a2be-21f61c684329" :answer/type :answer.type/math :answer/value "e^{4t}+1" :db/ensure [:answer/validate]} {:db/id "activity-1c502b04-0dbc-5aaf-8310-fcd6c3d6666b" :activity/id #uuid "1c502b04-0dbc-5aaf-8310-fcd6c3d6666b" :activity/title "Solving Inhomogeneous Systems of ODEs Using Laplace Transforms" :activity/type :activity.type/review :activity/scope 17592186049381 :activity/course 17592186046645 :activity/steps ["step-0a4167d3-037b-58b6-800c-244d0969444d" "step-b3ebab29-58fc-5cd2-84ec-badccce2d7de" "step-5041f9a9-f510-5aec-bad1-e8465c5eb3d3" "step-5e1e7d53-66b8-5374-8f9a-6d0631bdf0c2" "step-b4c6ca5d-8694-58ba-aa0b-48d53dd8e80c"] :activity/first-step "step-0a4167d3-037b-58b6-800c-244d0969444d" :db/ensure [:activity/validate]} {:db/id "step-0a4167d3-037b-58b6-800c-244d0969444d" :step/id #uuid "0a4167d3-037b-58b6-800c-244d0969444d" :step/content "question-9ca91093-1f1e-55da-a457-e3e1666bf899" :step/next "step-b3ebab29-58fc-5cd2-84ec-badccce2d7de" :db/ensure [:step/validate]} {:db/id "step-b3ebab29-58fc-5cd2-84ec-badccce2d7de" :step/id #uuid "b3ebab29-58fc-5cd2-84ec-badccce2d7de" :step/content "question-24075bbd-fad1-5e70-847c-3b96960e39c5" :step/next "step-5041f9a9-f510-5aec-bad1-e8465c5eb3d3" :db/ensure [:step/validate]} {:db/id "step-5041f9a9-f510-5aec-bad1-e8465c5eb3d3" :step/id #uuid "5041f9a9-f510-5aec-bad1-e8465c5eb3d3" :step/content 17592186308371 :step/next "step-5e1e7d53-66b8-5374-8f9a-6d0631bdf0c2" :db/ensure [:step/validate]} {:db/id "step-5e1e7d53-66b8-5374-8f9a-6d0631bdf0c2" :step/id #uuid "5e1e7d53-66b8-5374-8f9a-6d0631bdf0c2" :step/content "question-0823a96b-ef1d-57d5-85ea-8ef149bb4b9a" :step/next "step-b4c6ca5d-8694-58ba-aa0b-48d53dd8e80c" :db/ensure [:step/validate]} {:db/id "step-b4c6ca5d-8694-58ba-aa0b-48d53dd8e80c" :step/id #uuid "b4c6ca5d-8694-58ba-aa0b-48d53dd8e80c" :step/content 17592186308391 :db/ensure [:step/validate]} {:db/id 17592186110725 :knowledge-point/questions ["question-094a6192-1567-5375-9e5c-b0ab7210d2c7" "question-158e2594-5618-53de-811b-cce07b6dc3b7" "question-9fc55d0a-3a99-52a9-a6f3-6f933c42885c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110351 :question/worked-solution "From the graph, we deduce that the roots are $x_1=-3$ and $x_2=2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-3+2}{2}=-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\dfrac{1}{2}.$" :db/ensure [:question/validate]} {:db/id 17592186110726 :knowledge-point/questions ["question-bfbab0dc-48e0-5fe1-b79b-211af0a386b9" "question-b506000a-3cca-5384-98ce-1df2cd5d8561"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110352 :question/problem "Find the axis of symmetry of the parabola $y=-(x-1)(x-5).$" :question/worked-solution "From the equation $y=-(x-1)(x-5),$ we find that the roots of the parabola are $x_1=1$ and $x_2=5.$\n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\nx = \\dfrac{x_1+x_2}{2} = \\dfrac{1+5}{2} = 3\n$$\n\nTherefore, the axis of symmetry is $x=3.$" :db/ensure [:question/validate]} {:db/id 17592186110727 :knowledge-point/questions ["question-65741bd8-a817-5dbe-b425-cf51f2c41352" "question-7cce9f3f-dd06-554c-bd43-11f02acc9108"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110353 :question/problem "The axis of symmetry of the parabola $y=\\dfrac14(x-k)(x+2)$ is $x=6.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=6,$ we will set our result equal to $6.$ \n\nFrom the equation $y=\\dfrac14(x-k)(x+2),$ we find that the roots of the parabola are $x_1=k$ and $x_2=-2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{k-2}{2}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=6.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{k-2}{2} & =6 \\\\ k-2 & =12 \\\\ k & =14.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186110728 :knowledge-point/questions ["question-27fc5b3b-5534-585e-84e3-7a7fff1acf0d" "question-269ed7f0-271d-546c-901b-64ac9bc840b6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110373 :question/problem "| **$x$** | $4$ | $12$ | $20$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $9$ | $25$ | $9$ |\n\nThe graph of a parabola $y = f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?" :question/worked-solution "Notice that the values of $f(x)$ at the points $x=4$ and $x=20$ are equal.\n\n$$\nf(4) = f(20) = 9\n$$\n\nTherefore, the parabola's axis of symmetry must be equidistant from the lines $x=4$ and $x=20.$ We can find this by taking the average of these two values.\n\nIf the parabolas vertex is $(h,k),$ then we must have\n\n$$\n\\begin{aligned}h & =\\frac{4+20}{2} \\\\  & =\\frac{24}{2} \\\\  & =12.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-094a6192-1567-5375-9e5c-b0ab7210d2c7" :question/id #uuid "094a6192-1567-5375-9e5c-b0ab7210d2c7" :question/math-academy-id "q-106137" :question/problem "![](images/e1/e1fdcc8a8ed9dd9936ade0b088a672eadea1ca9ae7b12de7ce1b1dead2c3014a.png)\n\nFind the axis of symmetry for the parabola sketched above." :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-4$ and ${x}_{2}=2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-4)+2}{2}=-1.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aba3ac59-9466-58f5-9b5b-efe7c90f5528"] :db/ensure [:question/validate]} {:db/id "answer-field-aba3ac59-9466-58f5-9b5b-efe7c90f5528" :answer-field/id #uuid "aba3ac59-9466-58f5-9b5b-efe7c90f5528" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e9f3df9-da61-5f4a-b3ab-8a1a1cda444a" :answer-field/choices ["answer-2e9f3df9-da61-5f4a-b3ab-8a1a1cda444a" "answer-e784cab5-862c-5407-ae59-9868332a3944" "answer-cac0d315-ce7f-5d80-9e6a-46b1ae01e841" "answer-dc0cfaa1-d45c-5039-a04f-63b0fdededc7" "answer-62de6123-6a95-5dae-88e9-843c5a0c968d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e9f3df9-da61-5f4a-b3ab-8a1a1cda444a" :answer/id #uuid "2e9f3df9-da61-5f4a-b3ab-8a1a1cda444a" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-e784cab5-862c-5407-ae59-9868332a3944" :answer/id #uuid "e784cab5-862c-5407-ae59-9868332a3944" :answer/type :answer.type/math :answer/value "x=-1.5" :db/ensure [:answer/validate]} {:db/id "answer-cac0d315-ce7f-5d80-9e6a-46b1ae01e841" :answer/id #uuid "cac0d315-ce7f-5d80-9e6a-46b1ae01e841" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-dc0cfaa1-d45c-5039-a04f-63b0fdededc7" :answer/id #uuid "dc0cfaa1-d45c-5039-a04f-63b0fdededc7" :answer/type :answer.type/math :answer/value "x=-2.5" :db/ensure [:answer/validate]} {:db/id "answer-62de6123-6a95-5dae-88e9-843c5a0c968d" :answer/id #uuid "62de6123-6a95-5dae-88e9-843c5a0c968d" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "question-158e2594-5618-53de-811b-cce07b6dc3b7" :question/id #uuid "158e2594-5618-53de-811b-cce07b6dc3b7" :question/math-academy-id "q-84897" :question/problem "![](images/ee/eeedf268b501345408b8192573072cbe21e9568c54f2abeead3d9f707748706d.png)\n\nFind the axis of symmetry for the parabola sketched above." :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=1$ and ${x}_{2}=11.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{1+11}{2}=\\frac{12}{2}=6.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5497823-9601-508c-ab4e-5a578803285a"] :db/ensure [:question/validate]} {:db/id "answer-field-a5497823-9601-508c-ab4e-5a578803285a" :answer-field/id #uuid "a5497823-9601-508c-ab4e-5a578803285a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9087f1ff-3d38-5918-b9d7-4e44b4ce85f6" :answer-field/choices ["answer-99faed74-37b1-5272-8443-c6661f8de266" "answer-9087f1ff-3d38-5918-b9d7-4e44b4ce85f6" "answer-1b79b736-b329-566b-84ac-371cad2d3936" "answer-f013a429-97bb-57bb-97ef-0165023ca02f" "answer-d276353a-b094-5edd-b49c-9bae1e03a9b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-99faed74-37b1-5272-8443-c6661f8de266" :answer/id #uuid "99faed74-37b1-5272-8443-c6661f8de266" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-9087f1ff-3d38-5918-b9d7-4e44b4ce85f6" :answer/id #uuid "9087f1ff-3d38-5918-b9d7-4e44b4ce85f6" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "answer-1b79b736-b329-566b-84ac-371cad2d3936" :answer/id #uuid "1b79b736-b329-566b-84ac-371cad2d3936" :answer/type :answer.type/math :answer/value "x=7" :db/ensure [:answer/validate]} {:db/id "answer-f013a429-97bb-57bb-97ef-0165023ca02f" :answer/id #uuid "f013a429-97bb-57bb-97ef-0165023ca02f" :answer/type :answer.type/math :answer/value "x=\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d276353a-b094-5edd-b49c-9bae1e03a9b2" :answer/id #uuid "d276353a-b094-5edd-b49c-9bae1e03a9b2" :answer/type :answer.type/math :answer/value "x=\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id 17592186110976 :question/problem "![](images/3b/3b0ebd3a9a282fca4dc4302549c22efe674ada772eb00ed5e8aa0abbe275074b.png)\n\nThe graph above shows a parabola. The $x$-coordinates of $A$ and $B$ are $-\\frac{8}{3}$ and $\\frac{11}{5},$ respectively.  Find the axis of symmetry of the parabola.\n\nThe axis of symmetry is $x=$\n{{field-1}}." :question/worked-solution "We're given that the roots of the parabola are \n ${x}_{1}=-\\frac{8}{3}$ and ${x}_{2}=\\frac{11}{5}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{8}{3}+\\frac{11}{5})}{2} \\\\  & =\\frac{(-\\frac{40}{15}+\\frac{33}{15})}{2} \\\\  & =\\frac{(-\\frac{7}{15})}{2} \\\\  & =-\\frac{7}{30}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{7}{30}.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186107604 :answer-field/correct "answer-47acc35f-5b61-5d14-8bcc-66ac1ea76bee" :answer-field/choices ["answer-47acc35f-5b61-5d14-8bcc-66ac1ea76bee"] :db/ensure [:answer-field/validate]} {:db/id "answer-47acc35f-5b61-5d14-8bcc-66ac1ea76bee" :answer/id #uuid "47acc35f-5b61-5d14-8bcc-66ac1ea76bee" :answer/type :answer.type/math :answer/value "-\\frac{7}{30}" :db/ensure [:answer/validate]} {:db/id "question-9fc55d0a-3a99-52a9-a6f3-6f933c42885c" :question/id #uuid "9fc55d0a-3a99-52a9-a6f3-6f933c42885c" :question/math-academy-id "q-24855" :question/problem "![](images/a8/a8b1d42dd086ff74623c24989fd993c2946857e1744988135c6cdb18d9985b7f.png)\n\nFind the axis of symmetry for the parabola sketched above." :question/worked-solution "From the graph, we deduce that the roots are ${x}_{1}=-2$ and ${x}_{2}=3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-2)+3}{2}=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-41ffaac3-97a2-553d-9dc8-0e075e369f32"] :db/ensure [:question/validate]} {:db/id "answer-field-41ffaac3-97a2-553d-9dc8-0e075e369f32" :answer-field/id #uuid "41ffaac3-97a2-553d-9dc8-0e075e369f32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc78e255-475f-5616-99f4-98aaca4b83e4" :answer-field/choices ["answer-c5df1532-58f6-563b-be59-6d00c4c805e8" "answer-19f76139-8842-5f35-b9ad-0c15135ffd28" "answer-cc78e255-475f-5616-99f4-98aaca4b83e4" "answer-e222922a-273a-5cd0-8575-d106bef3f640" "answer-dad67dc5-057e-5f8e-85b6-70b06ecc7c28"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5df1532-58f6-563b-be59-6d00c4c805e8" :answer/id #uuid "c5df1532-58f6-563b-be59-6d00c4c805e8" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-19f76139-8842-5f35-b9ad-0c15135ffd28" :answer/id #uuid "19f76139-8842-5f35-b9ad-0c15135ffd28" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cc78e255-475f-5616-99f4-98aaca4b83e4" :answer/id #uuid "cc78e255-475f-5616-99f4-98aaca4b83e4" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e222922a-273a-5cd0-8575-d106bef3f640" :answer/id #uuid "e222922a-273a-5cd0-8575-d106bef3f640" :answer/type :answer.type/math :answer/value "x=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-dad67dc5-057e-5f8e-85b6-70b06ecc7c28" :answer/id #uuid "dad67dc5-057e-5f8e-85b6-70b06ecc7c28" :answer/type :answer.type/math :answer/value "x=\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-bfbab0dc-48e0-5fe1-b79b-211af0a386b9" :question/id #uuid "bfbab0dc-48e0-5fe1-b79b-211af0a386b9" :question/math-academy-id "q-30456" :question/problem "Find the axis of symmetry for the parabola $y=(x-6)(x+3).$" :question/worked-solution "From the equation $y=(x-6)(x+3),$ we find that the roots of the parabola are ${x}_{1}=6$ and ${x}_{2}=-3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{6+(-3)}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{3}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-93603e77-7010-5a96-87c7-8028b120d8c6"] :db/ensure [:question/validate]} {:db/id "answer-field-93603e77-7010-5a96-87c7-8028b120d8c6" :answer-field/id #uuid "93603e77-7010-5a96-87c7-8028b120d8c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2eaa4b0-92d4-5639-9707-9998e5dc82bb" :answer-field/choices ["answer-9021c496-ac44-55c7-8663-3a91757d6bb9" "answer-962ed523-4733-592e-b803-53eb8cc91d38" "answer-b49faf21-ada8-5826-855e-4c177c412bdf" "answer-a2eaa4b0-92d4-5639-9707-9998e5dc82bb" "answer-06f6803f-552b-5156-8e55-974ff7420778"] :db/ensure [:answer-field/validate]} {:db/id "answer-9021c496-ac44-55c7-8663-3a91757d6bb9" :answer/id #uuid "9021c496-ac44-55c7-8663-3a91757d6bb9" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-962ed523-4733-592e-b803-53eb8cc91d38" :answer/id #uuid "962ed523-4733-592e-b803-53eb8cc91d38" :answer/type :answer.type/math :answer/value "x=-\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b49faf21-ada8-5826-855e-4c177c412bdf" :answer/id #uuid "b49faf21-ada8-5826-855e-4c177c412bdf" :answer/type :answer.type/math :answer/value "x=\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a2eaa4b0-92d4-5639-9707-9998e5dc82bb" :answer/id #uuid "a2eaa4b0-92d4-5639-9707-9998e5dc82bb" :answer/type :answer.type/math :answer/value "x=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-06f6803f-552b-5156-8e55-974ff7420778" :answer/id #uuid "06f6803f-552b-5156-8e55-974ff7420778" :answer/type :answer.type/math :answer/value "x=\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "question-b506000a-3cca-5384-98ce-1df2cd5d8561" :question/id #uuid "b506000a-3cca-5384-98ce-1df2cd5d8561" :question/math-academy-id "q-223671" :question/problem "The axis of symmetry of the parabola $y=-(x+7)(2x-5)$ is $x=${{field-1}}." :question/worked-solution "From the equation $y=-(x+7)(2x-5),$ we find that the roots of the parabola are ${x}_{1}=-7$ and ${x}_{2}=\\frac{5}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-7+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{14}{2}+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{9}{2})}{2} \\\\  & =-\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{9}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9da18180-5a36-5125-8324-5c1b0c6c8774"] :db/ensure [:question/validate]} {:db/id "answer-field-9da18180-5a36-5125-8324-5c1b0c6c8774" :answer-field/id #uuid "9da18180-5a36-5125-8324-5c1b0c6c8774" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8241bb7f-109e-55f9-be72-8316a22c2b01" :answer-field/choices ["answer-8241bb7f-109e-55f9-be72-8316a22c2b01"] :db/ensure [:answer-field/validate]} {:db/id "answer-8241bb7f-109e-55f9-be72-8316a22c2b01" :answer/id #uuid "8241bb7f-109e-55f9-be72-8316a22c2b01" :answer/type :answer.type/math :answer/value "-\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "question-65741bd8-a817-5dbe-b425-cf51f2c41352" :question/id #uuid "65741bd8-a817-5dbe-b425-cf51f2c41352" :question/math-academy-id "q-223688" :question/problem "The axis of symmetry of the parabola $y=(2x+5)(2x+k)$ is $x=-\\frac{9}{4}.$ Find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{9}{4},$ we will set our result equal to $-\\frac{9}{4}.$ \n\nFrom the equation $y=(2x+5)(2x+k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{5}{2}$ and ${x}_{2}=-\\frac{k}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{5}{2}-\\frac{k}{2})}{2} \\\\  & =\\frac{(-\\frac{5+k}{2})}{2} \\\\  & =-\\frac{5+k}{4}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{9}{4}.$ Therefore, we have\n\n$$\n\\begin{aligned}-\\frac{5+k}{4} & =-\\frac{9}{4} \\\\ 5+k & =9 \\\\ k & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d1265d9c-4abc-5c77-ab0f-534e48c095b2"] :db/ensure [:question/validate]} {:db/id "answer-field-d1265d9c-4abc-5c77-ab0f-534e48c095b2" :answer-field/id #uuid "d1265d9c-4abc-5c77-ab0f-534e48c095b2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1053c1f5-d753-5d4f-9ed6-23685e190240" :answer-field/choices ["answer-1053c1f5-d753-5d4f-9ed6-23685e190240"] :db/ensure [:answer-field/validate]} {:db/id "answer-1053c1f5-d753-5d4f-9ed6-23685e190240" :answer/id #uuid "1053c1f5-d753-5d4f-9ed6-23685e190240" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-7cce9f3f-dd06-554c-bd43-11f02acc9108" :question/id #uuid "7cce9f3f-dd06-554c-bd43-11f02acc9108" :question/math-academy-id "q-223687" :question/problem "The axis of symmetry of the parabola $y=(3x+7)(2x-k)$ is $x=-\\frac{5}{12}.$ Find the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{5}{12},$ we will set our result equal to $-\\frac{5}{12}.$ \n\nFrom the equation $y=(3x+7)(2x-k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{7}{3}$ and ${x}_{2}=\\frac{k}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{7}{3}+\\frac{k}{2})}{2} \\\\  & =\\frac{(-\\frac{14}{6}+\\frac{3k}{6})}{2} \\\\  & =\\frac{3k-14}{12}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{5}{12}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{3k-14}{12} & =-\\frac{5}{12} \\\\ 3k-14 & =-5 \\\\ 3k & =9 \\\\ k & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b9a70c7f-9ea3-5d5d-821e-91e51ecf66e3"] :db/ensure [:question/validate]} {:db/id "answer-field-b9a70c7f-9ea3-5d5d-821e-91e51ecf66e3" :answer-field/id #uuid "b9a70c7f-9ea3-5d5d-821e-91e51ecf66e3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6e1b4578-4b0f-5dff-8326-16f7e58f56a9" :answer-field/choices ["answer-6e1b4578-4b0f-5dff-8326-16f7e58f56a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-6e1b4578-4b0f-5dff-8326-16f7e58f56a9" :answer/id #uuid "6e1b4578-4b0f-5dff-8326-16f7e58f56a9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-27fc5b3b-5534-585e-84e3-7a7fff1acf0d" :question/id #uuid "27fc5b3b-5534-585e-84e3-7a7fff1acf0d" :question/math-academy-id "q-311953" :question/problem "| **$x$** | $0$ | $2$ | $10$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $0$ | $80$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the roots of the parabola are given. They are \n\n$$\nx=0\\,\\text{and}\\,x=2.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{0+2}{2} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8173af61-504f-51e6-827f-522fb24ab912"] :db/ensure [:question/validate]} {:db/id "answer-field-8173af61-504f-51e6-827f-522fb24ab912" :answer-field/id #uuid "8173af61-504f-51e6-827f-522fb24ab912" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b5fc8d9c-e7fa-5efa-90c8-3d5291bec1ea" :answer-field/choices ["answer-b5fc8d9c-e7fa-5efa-90c8-3d5291bec1ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5fc8d9c-e7fa-5efa-90c8-3d5291bec1ea" :answer/id #uuid "b5fc8d9c-e7fa-5efa-90c8-3d5291bec1ea" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-269ed7f0-271d-546c-901b-64ac9bc840b6" :question/id #uuid "269ed7f0-271d-546c-901b-64ac9bc840b6" :question/math-academy-id "q-311957" :question/problem "| **$x$** | $0$ | $14$ | $21$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $0$ | $-20$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. The parabola opens downward. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." :question/worked-solution "Notice that the roots of the parabola are given. They are \n\n$$\nx=0\\,\\text{and}\\,x=14.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{0+14}{2} \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-95bc64fc-fb2d-51a1-a46d-5a131f211674"] :db/ensure [:question/validate]} {:db/id "answer-field-95bc64fc-fb2d-51a1-a46d-5a131f211674" :answer-field/id #uuid "95bc64fc-fb2d-51a1-a46d-5a131f211674" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7e30ba9a-32b2-58e5-8851-f26d83233a8e" :answer-field/choices ["answer-7e30ba9a-32b2-58e5-8851-f26d83233a8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e30ba9a-32b2-58e5-8851-f26d83233a8e" :answer/id #uuid "7e30ba9a-32b2-58e5-8851-f26d83233a8e" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186111921 :tutorial/content "If a parabola has two roots, the axis of symmetry occurs precisely halfway between the roots of the parabola. Therefore, we can find the axis of symmetry of a parabola by finding the roots and then taking their average value. \n\nSo, if the roots are $x_1$ and $x_2,$ the **average of the roots formula** tells us that the axis of symmetry of the parabola is\n\n$$\nx = \\dfrac{x_1+x_2}{2}.\n$$\n\nFor example, let's consider the parabola \n\n$$\ny=(x+2)(x-4).\n$$\n\nWe have the roots $x_1=-2$ and $x_2=4.$ Therefore, the equation of the axis of symmetry is\n\n$$\n\\begin{aligned}x=\\frac{-2+4}{2}=1\\end{aligned}\n$$\n\nSo, the axis of symmetry of the parabola $y=(x+2)(x-4)$ is $x=1,$ as shown below.\n\n![](images/ec/ec08bc1ba75082ac98bb6559b6c0ef8119fbf245f3c266710ce8c6a569fa8a02.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186111821 :tutorial/content "![](images/b2/b27906f92121928be444d3b7f616becbcc7a849e1313ef50accd8c8bfd718bfb.png)\n\nIf we know two points on a parabola with *identical* $y$-values, we can find the $x$-coordinate of the vertex by taking an average of the two $x$-values. \n\nFor example, consider the parabola $y=f(x)$ above. Notice that the values of $f(x)$ at the points $x=-3$ and $x=5$ are equal.\n\n$$\nf(-3) = f(5) = 3\n$$\n\nTherefore, the parabola's axis of symmetry must be equidistant from the lines $x=-3$ and $x=5.$ We can find this by taking the average of these two values.\n\nIf the parabola's vertex is $(h,k),$ then we must have\n\n$$\n\\begin{aligned}h & =\\frac{-3+5}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, $h=1$ is the $x$-coordinate of the vertex, and the axis of symmetry of the parabola is $x=1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186110824 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186171309 :answer-field/choices 17592186171312] [:db/retract 17592186171309 :answer-field/choices 17592186171313] [:db/retract 17592186171309 :answer-field/choices 17592186171314] [:db/retract 17592186171309 :answer-field/choices 17592186171310] [:db/retract 17592186171309 :answer-field/choices 17592186171311] {:db/id 17592186172614 :question/problem "$$\nP=[\\begin{aligned}\\,∗\\, & \\frac{3}{5} \\\\ \\,∗\\, & -\\frac{4}{5}\\end{aligned}]\n$$\n\nConsider the matrix $P$ shown above. Given that $A=PD{P}^{T}$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the first column of the matrix $P?$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix.\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nSince  $A=PD{P}^{T}$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A,$ the matrix $P$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the first column must be equal to $1.$\n\nAmong the given options, only the vector $[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]$ has both properties." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186171309 :answer-field/correct "answer-69d71126-9044-53dc-ac17-82d6b0ae4420" :answer-field/choices ["answer-0d552401-7df8-5f99-a836-4969de7073d2" "answer-456d1178-57b7-5b0c-943b-835fd8bfb7ac" "answer-c3445e30-2b43-549c-8a2b-9e83ae6551c9" "answer-6e543dd2-637e-5897-999c-1a3bee825439" "answer-69d71126-9044-53dc-ac17-82d6b0ae4420"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d552401-7df8-5f99-a836-4969de7073d2" :answer/id #uuid "0d552401-7df8-5f99-a836-4969de7073d2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-456d1178-57b7-5b0c-943b-835fd8bfb7ac" :answer/id #uuid "456d1178-57b7-5b0c-943b-835fd8bfb7ac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c3445e30-2b43-549c-8a2b-9e83ae6551c9" :answer/id #uuid "c3445e30-2b43-549c-8a2b-9e83ae6551c9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 \\\\ 15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6e543dd2-637e-5897-999c-1a3bee825439" :answer/id #uuid "6e543dd2-637e-5897-999c-1a3bee825439" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-69d71126-9044-53dc-ac17-82d6b0ae4420" :answer/id #uuid "69d71126-9044-53dc-ac17-82d6b0ae4420" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186172027 :knowledge-point/questions ["question-6ce9a2b1-181d-53a4-9a85-7b3316309f0d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ce9a2b1-181d-53a4-9a85-7b3316309f0d" :question/id #uuid "6ce9a2b1-181d-53a4-9a85-7b3316309f0d" :question/math-academy-id "q-140823" :question/problem "$$\nA=[\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}],\\,D=[\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first column of the matrix $P.$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-1.$ So, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=5.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{1}=5.$ Computing $A-5I,$ we get\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 3 & -3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 3 & 0 \\\\ 3 & -3 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],\n$$\n\nwhere $‖{v}_{1}‖=\\sqrt{2}.$ Dividing ${v}_{1}$ by its norm, we obtain the first column of $P:$ \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d6527b4b-120d-5aff-a1f0-c36c16a9c694"] :db/ensure [:question/validate]} {:db/id "answer-field-d6527b4b-120d-5aff-a1f0-c36c16a9c694" :answer-field/id #uuid "d6527b4b-120d-5aff-a1f0-c36c16a9c694" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd4de4cf-7e82-5f05-9f5b-966287d3a5af" :answer-field/choices ["answer-4abf62fc-86eb-5564-b600-98ba0a148dab" "answer-23c48aa5-451f-5b58-9fdf-d8472558f09b" "answer-7dc39615-cf6d-548a-a9c6-d33a2dc2a0ef" "answer-cd4de4cf-7e82-5f05-9f5b-966287d3a5af" "answer-5e8a67c4-b331-5d37-8678-fa4fd7b2a874"] :db/ensure [:answer-field/validate]} {:db/id "answer-4abf62fc-86eb-5564-b600-98ba0a148dab" :answer/id #uuid "4abf62fc-86eb-5564-b600-98ba0a148dab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-23c48aa5-451f-5b58-9fdf-d8472558f09b" :answer/id #uuid "23c48aa5-451f-5b58-9fdf-d8472558f09b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7dc39615-cf6d-548a-a9c6-d33a2dc2a0ef" :answer/id #uuid "7dc39615-cf6d-548a-a9c6-d33a2dc2a0ef" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cd4de4cf-7e82-5f05-9f5b-966287d3a5af" :answer/id #uuid "cd4de4cf-7e82-5f05-9f5b-966287d3a5af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5e8a67c4-b331-5d37-8678-fa4fd7b2a874" :answer/id #uuid "5e8a67c4-b331-5d37-8678-fa4fd7b2a874" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\sqrt{2} \\\\ -\\sqrt{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186173154 :tutorial/content "A square matrix $A$ is **orthogonally diagonalizable** if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PDP^T,\n$$\n\nwhere $D$ is a diagonal matrix. Note that this is equivalent to the equation\n\n$$\nD = P^TAP.\n$$\n\nSo, to orthogonally diagonalize a matrix $A,$ we need to find a diagonal matrix $D$ and an orthogonal matrix $P$ that satisfies the above equations.\n\nA helpful theorem allows us to determine whether a real matrix is orthogonally diagonalizable. It states the following:\n\n*A matrix $A$ with real entries is orthogonally diagonalizable if and only if it is symmetric.*\n\nConsequently, *every* symmetric matrix is orthogonally diagonalizable!\n\nFor example, the symmetric matrix \n\n![](images/b3/b3970eb885720ce2aa4394918c6c5f9f343e26aa60039df219abf56398f096db.svg)\n\nhas the orthogonal diagonalization\n\n$$\n\\begin{aligned}A & ={{[\\begin{aligned}\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}4 & 0 \\\\ 0 & -6\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]}^{T}}_{⏟}}_{{P}^{T}},\\end{aligned}\n$$\n\nwhere $P$ is orthogonal, and $D$ is diagonal. As usual, the entries on the main diagonal of $D$ are the eigenvalues of $A.$ Also, the columns of $P$ are *orthonormal* eigenvectors corresponding to the eigenvalues of $A.$\n\nThe procedure of the orthogonal diagonalization of a $2 \\times 2$ real symmetric matrix $A$ is almost the same as the diagonalization of a matrix:\n\n- **Step 1**: Find the eigenvalues of the matrix $A$.\n\n- **Step 2**: Find a basis of  $\\mathbb{R}^2$ consisting of *unit orthogonal* eigenvectors of $A.$\n\n- **Step 3**: Construct the matrices $D$ and $P.$\n\nIn the case of symmetric matrices, the two eigenvectors we compute in step 2 will always be orthogonal, provided that they correspond to different eigenvalues. However, we must also ensure that we *normalize* those eigenvectors." :db/ensure [:tutorial/validate]} {:db/id 17592186064239 :knowledge-point/questions ["question-6ef129d9-0a92-5a3f-b637-51eadd473818" "question-e3894629-c728-5b78-885d-1ca88944c278"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ef129d9-0a92-5a3f-b637-51eadd473818" :question/id #uuid "6ef129d9-0a92-5a3f-b637-51eadd473818" :question/math-academy-id "q-156055" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}x+3<4 \\\\ 3-2x\\le 9\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $x+3<4$ and $3-2x\\le 9$ simultaneously.\n\n- First, we solve $x+3<4\\,:$ \n\n$$\n\\begin{aligned}x+3 & <4 \\\\ x+3-3 & <4-3 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/c2/c20ffc0279a42a429797f42fcd929fb4dfb499e311dd3ed7b6b61fd95729953c.png)\n\n$$\n\n$$\n\n- Then, we solve $3-2x\\le 9\\,:$\n\n$$\n\\begin{aligned}3-2x & \\le 9 \\\\ 3-2x-3 & \\le 9-3 \\\\ -2x & \\le 6 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 6 \\\\ 2x & \\ge -6 \\\\ \\frac{2x}{2} & \\ge \\frac{-6}{2} \\\\ x & \\ge -3\\end{aligned}\n$$\n\n![](images/ae/ae72342a32ea8a952a3d00aec7a8ccc381804ae4b593ba58113911c4bc4b2c09.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/b7/b7d4814919a8c0b2a2ed8e130c8af2bdce5e7fd2d23d10e50e4e293d88170c2f.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in [-3,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-36a01c9a-6a75-5d02-8751-2d076edf1a6a"] :db/ensure [:question/validate]} {:db/id "answer-field-36a01c9a-6a75-5d02-8751-2d076edf1a6a" :answer-field/id #uuid "36a01c9a-6a75-5d02-8751-2d076edf1a6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-360b3e1c-48bd-528c-9d5d-938043d6c2b2" :answer-field/choices ["answer-d71fd4ba-85b7-5c46-8cbc-f5708e1bd047" "answer-3f31d9f9-5c07-5bf0-9421-ad3c02ba0764" "answer-360b3e1c-48bd-528c-9d5d-938043d6c2b2" "answer-88eadd3f-76f1-5d70-87a5-4c7bc2dd9b57" "answer-582fa1a5-35f2-55f1-ba22-a7eb59f9b896"] :db/ensure [:answer-field/validate]} {:db/id "answer-d71fd4ba-85b7-5c46-8cbc-f5708e1bd047" :answer/id #uuid "d71fd4ba-85b7-5c46-8cbc-f5708e1bd047" :answer/type :answer.type/math :answer/value "x\\in (-1,3]" :db/ensure [:answer/validate]} {:db/id "answer-3f31d9f9-5c07-5bf0-9421-ad3c02ba0764" :answer/id #uuid "3f31d9f9-5c07-5bf0-9421-ad3c02ba0764" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,1)" :db/ensure [:answer/validate]} {:db/id "answer-360b3e1c-48bd-528c-9d5d-938043d6c2b2" :answer/id #uuid "360b3e1c-48bd-528c-9d5d-938043d6c2b2" :answer/type :answer.type/math :answer/value "x\\in [-3,1)" :db/ensure [:answer/validate]} {:db/id "answer-88eadd3f-76f1-5d70-87a5-4c7bc2dd9b57" :answer/id #uuid "88eadd3f-76f1-5d70-87a5-4c7bc2dd9b57" :answer/type :answer.type/math :answer/value "x\\in [-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-582fa1a5-35f2-55f1-ba22-a7eb59f9b896" :answer/id #uuid "582fa1a5-35f2-55f1-ba22-a7eb59f9b896" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id "question-e3894629-c728-5b78-885d-1ca88944c278" :question/id #uuid "e3894629-c728-5b78-885d-1ca88944c278" :question/math-academy-id "q-156096" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}2x+4>6 \\\\ 4-x\\ge 2\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $k$ that satisfy both $2x+4>6$ and $4-x\\ge 2$ simultaneously.\n\n- First, we solve $2x+4>6:$ \n\n$$\n\\begin{aligned}2x+4 & >6 \\\\ 2x+4-4 & >6-4 \\\\ 2x & >2 \\\\ \\frac{2x}{2} & >\\frac{2}{2} \\\\ x & >1\\end{aligned}\n$$\n\n![](images/6d/6d3b61147527a632ccb46629a356e9f5c92a1ddfc8a52f3d0890cd46eb56f564.png)\n\n- Then, we solve $4-x\\ge 2:$ \n\n$$\n\\begin{aligned}4-x & \\ge 2 \\\\ 4-x-4 & \\ge 2-4 \\\\ -x & \\ge -2 \\\\ (-1)\\cdot (-x) & \\le (-1)\\cdot (-2) \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/14/1452391c950b051c4cf454723498e6fa657f6d5f1315f78e50f3450bf7fbc1eb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/a2/a22a207cc64d33470e27d0b1f45ad0b87106fafd67b88c2163524a44951639bf.png)\n\n    \n\nThus, the final solution is $x\\in (1,2].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3b901c12-2a57-5d11-9bb4-941a5ba8e6d5"] :db/ensure [:question/validate]} {:db/id "answer-field-3b901c12-2a57-5d11-9bb4-941a5ba8e6d5" :answer-field/id #uuid "3b901c12-2a57-5d11-9bb4-941a5ba8e6d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58c4a563-279d-570a-a388-2ff52a0b29f5" :answer-field/choices ["answer-dedbb23f-f487-5d15-9528-e264d7f421c2" "answer-3bf162e4-cd7b-54b0-8466-f4b821b2abe0" "answer-58c4a563-279d-570a-a388-2ff52a0b29f5" "answer-5b4c177a-706d-56c0-a404-7bc45e333979" "answer-b8c8fe3f-912f-5186-af72-dca875ba83b7"] :db/ensure [:answer-field/validate]} {:db/id "answer-dedbb23f-f487-5d15-9528-e264d7f421c2" :answer/id #uuid "dedbb23f-f487-5d15-9528-e264d7f421c2" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,2)" :db/ensure [:answer/validate]} {:db/id "answer-3bf162e4-cd7b-54b0-8466-f4b821b2abe0" :answer/id #uuid "3bf162e4-cd7b-54b0-8466-f4b821b2abe0" :answer/type :answer.type/math :answer/value "x\\in (1,2)" :db/ensure [:answer/validate]} {:db/id "answer-58c4a563-279d-570a-a388-2ff52a0b29f5" :answer/id #uuid "58c4a563-279d-570a-a388-2ff52a0b29f5" :answer/type :answer.type/math :answer/value "x\\in (1,2]" :db/ensure [:answer/validate]} {:db/id "answer-5b4c177a-706d-56c0-a404-7bc45e333979" :answer/id #uuid "5b4c177a-706d-56c0-a404-7bc45e333979" :answer/type :answer.type/math :answer/value "x\\in (1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-b8c8fe3f-912f-5186-af72-dca875ba83b7" :answer/id #uuid "b8c8fe3f-912f-5186-af72-dca875ba83b7" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id 17592186064240 :knowledge-point/questions ["question-3cd6f974-c65a-5148-8d00-27906b9e797b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3cd6f974-c65a-5148-8d00-27906b9e797b" :question/id #uuid "3cd6f974-c65a-5148-8d00-27906b9e797b" :question/math-academy-id "q-156129" :question/problem "Find the set of values of $x$ that satisfy $2<2x+4\\le 6$ and $4x>12.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $2<2x+4\\le 6\\,:$ \n\n$$\n\\begin{aligned}2 & <2x+4\\le 6 \\\\ 2-4 & <2x+4-4\\le 6-4 \\\\ -2 & <2x\\le 2 \\\\ \\frac{-2}{2} & <\\frac{2x}{2}\\le \\frac{2}{2} \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/48/485e77fe84f5745120d5f450c3e1043ee61463a83f7c12bfc6d1ae0e4124a38b.png)\n\n   \n\n- Then, we solve  $4x>12\\,:$\n\n$$\n\\begin{aligned}4x & >12 \\\\ \\frac{4x}{4} & >\\frac{12}{4} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/65/654f97a64ec1a13b4a94860dfa07d05f7c119a5fe2084ba23aa994a97f0bea70.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/d2/d2d0f41792356b6c250612b033413f66bfd7a35440e1b84da660fccd5c1285b0.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-db98ca20-fac1-5cbb-9acf-371f7dfc8910"] :db/ensure [:question/validate]} {:db/id "answer-field-db98ca20-fac1-5cbb-9acf-371f7dfc8910" :answer-field/id #uuid "db98ca20-fac1-5cbb-9acf-371f7dfc8910" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-384fd572-a66f-5128-a6b3-44005974b90d" :answer-field/choices ["answer-a7208089-38df-5278-b199-6279ab8f6251" "answer-9852c2c1-fa2d-5d40-ab08-ac566524df45" "answer-a5a74e4a-4c8d-5255-a204-4cf5d72033a6" "answer-3b432c6d-0781-5270-b3f1-15ea3f1af7fc" "answer-384fd572-a66f-5128-a6b3-44005974b90d"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7208089-38df-5278-b199-6279ab8f6251" :answer/id #uuid "a7208089-38df-5278-b199-6279ab8f6251" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-1)" :db/ensure [:answer/validate]} {:db/id "answer-9852c2c1-fa2d-5d40-ab08-ac566524df45" :answer/id #uuid "9852c2c1-fa2d-5d40-ab08-ac566524df45" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-1)\\cup [-2,3]" :db/ensure [:answer/validate]} {:db/id "answer-a5a74e4a-4c8d-5255-a204-4cf5d72033a6" :answer/id #uuid "a5a74e4a-4c8d-5255-a204-4cf5d72033a6" :answer/type :answer.type/math :answer/value "x\\in (2,3]" :db/ensure [:answer/validate]} {:db/id "answer-3b432c6d-0781-5270-b3f1-15ea3f1af7fc" :answer/id #uuid "3b432c6d-0781-5270-b3f1-15ea3f1af7fc" :answer/type :answer.type/math :answer/value "x\\in [1,3)" :db/ensure [:answer/validate]} {:db/id "answer-384fd572-a66f-5128-a6b3-44005974b90d" :answer/id #uuid "384fd572-a66f-5128-a6b3-44005974b90d" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id "activity-c90a0db0-b9be-51c5-9118-106956e6ede9" :activity/id #uuid "c90a0db0-b9be-51c5-9118-106956e6ede9" :activity/title "Compound AND Inequalities" :activity/type :activity.type/review :activity/scope 17592186049597 :activity/course 17592186046647 :activity/steps ["step-a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" "step-39304ff2-c632-5bfe-be88-8e807d05822b" "step-83ea5dfe-2530-5a49-b45b-ff45d9eb5966"] :activity/first-step "step-a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" :db/ensure [:activity/validate]} {:db/id "step-a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" :step/id #uuid "a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" :step/content "question-6ef129d9-0a92-5a3f-b637-51eadd473818" :step/next "step-39304ff2-c632-5bfe-be88-8e807d05822b" :db/ensure [:step/validate]} {:db/id "step-39304ff2-c632-5bfe-be88-8e807d05822b" :step/id #uuid "39304ff2-c632-5bfe-be88-8e807d05822b" :step/content "question-e3894629-c728-5b78-885d-1ca88944c278" :step/next "step-83ea5dfe-2530-5a49-b45b-ff45d9eb5966" :db/ensure [:step/validate]} {:db/id "step-83ea5dfe-2530-5a49-b45b-ff45d9eb5966" :step/id #uuid "83ea5dfe-2530-5a49-b45b-ff45d9eb5966" :step/content "question-3cd6f974-c65a-5148-8d00-27906b9e797b" :db/ensure [:step/validate]} {:db/id 17592186064365 :knowledge-point/questions ["question-6e20ee7e-741b-5069-a51c-7de25cc32da7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6e20ee7e-741b-5069-a51c-7de25cc32da7" :question/id #uuid "6e20ee7e-741b-5069-a51c-7de25cc32da7" :question/math-academy-id "q-133285" :question/problem "Calculate the horizontal velocity of the eagle as a function of time.\n\nThe horizontal velocity of the bird is$\\,$ \n{{field-1}}$\\,\\text{m/s}.$" :question/worked-solution "The horizontal velocity of the eagle is given by ${x}^{′}(t),$ where \n\n$$\nx(t)=\\operatorname{arctan}⁡(\\frac{t}{5}).\n$$\n\nThe formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡t)=\\frac{1}{1+{t}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡(\\frac{t}{5})) \\\\  & =\\frac{1}{1+(t/5)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}t}(\\frac{t}{5}) \\\\  & =\\frac{1}{1+{t}^{2}/25}\\cdot \\frac{1}{5} \\\\  & =\\frac{5}{25+{t}^{2}}.\\end{aligned}\n$$\n\nTherefore, the horizontal velocity of the eagle is given by the function ${x}^{′}(t)=\\frac{5}{25+{t}^{2}}\\,\\text{m/s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a16e017f-d9d9-54ce-97a3-a549b27da1ca"] :db/ensure [:question/validate]} {:db/id "answer-field-a16e017f-d9d9-54ce-97a3-a549b27da1ca" :answer-field/id #uuid "a16e017f-d9d9-54ce-97a3-a549b27da1ca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-beda0c51-788b-57b5-9c1d-b837a9961c32" :answer-field/choices ["answer-beda0c51-788b-57b5-9c1d-b837a9961c32"] :db/ensure [:answer-field/validate]} {:db/id "answer-beda0c51-788b-57b5-9c1d-b837a9961c32" :answer/id #uuid "beda0c51-788b-57b5-9c1d-b837a9961c32" :answer/type :answer.type/math :answer/value "\\frac{5}{t^2+25}" :db/ensure [:answer/validate]} {:db/id 17592186138430 :knowledge-point/questions ["question-95631ad4-7573-5741-9c54-4f854208188c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-95631ad4-7573-5741-9c54-4f854208188c" :question/id #uuid "95631ad4-7573-5741-9c54-4f854208188c" :question/math-academy-id "q-133286" :question/problem "The vertical velocity of the eagle increases at a rate proportional to the square of the time $t.$ In addition, the eagle loses $2\\,\\text{m/s}$ in the positive $y$-direction due to wind resistance. It is known that the eagle's vertical velocity equals $2\\,\\text{m}/\\text{s}$ when $t=2\\,\\text{s}.$\n\nThe differential equation that describes the eagle's vertical velocity is ${y}^{′}(t)=$\n{{field-1}}." :question/worked-solution "The vertical velocity increases proportionally with ${t}^{2}$ and decreases by $2.$ The differential equation that describes this is\n\n$$\n{y}^{′}(t)=k{t}^{2}-2,\n$$\n\nwhere $k$ is a (positive) constant of proportionality.\n\nSince ${y}^{′}(2)=2,$ we can solve for $k:$\n\n$$\n\\begin{aligned}{y}^{′}(2) & =2 \\\\ k(2)^{2}-2 & =2 \\\\ 4k & =4 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the differential equation is\n\n$$\n{y}^{′}(t)={t}^{2}-2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26a95aab-3ec7-5d58-8faa-efd0ff8b9e68"] :db/ensure [:question/validate]} {:db/id "answer-field-26a95aab-3ec7-5d58-8faa-efd0ff8b9e68" :answer-field/id #uuid "26a95aab-3ec7-5d58-8faa-efd0ff8b9e68" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c18a0d99-6ac2-55bc-b565-e5db3275b58f" :answer-field/choices ["answer-c18a0d99-6ac2-55bc-b565-e5db3275b58f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c18a0d99-6ac2-55bc-b565-e5db3275b58f" :answer/id #uuid "c18a0d99-6ac2-55bc-b565-e5db3275b58f" :answer/type :answer.type/math :answer/value "t^2-2" :db/ensure [:answer/validate]} {:db/id 17592186083240 :knowledge-point/questions ["question-08e75bed-6305-557a-ac6f-4a738a0fec12"] :db/ensure [:knowledge-point/validate]} {:db/id "question-08e75bed-6305-557a-ac6f-4a738a0fec12" :question/id #uuid "08e75bed-6305-557a-ac6f-4a738a0fec12" :question/math-academy-id "q-133287" :question/problem "The eagle's path traces a curve $C$ in the $xy$-plane. Suppose that the eagle is at the point $P$ on $C$ at time $t.$ Expressed in terms of $t,$ what function gives the slope of the tangent to $C$ at $P?$\n\nThe slope of the tangent to $C$ at time $t$ equals$\\,$\n{{field-1}}." :question/worked-solution "The slope of the tangent to $C$ equals $\\frac{\\text{d}y}{\\text{d}x}.$ To calculate this, we use the formula\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nTherefore,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{t}^{2}-2}{(\\frac{5}{25+{t}^{2}})}=\\frac{1}{5}({t}^{2}-2)({t}^{2}+25).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-796d2edf-72cd-5edb-a250-8f0040849fed"] :db/ensure [:question/validate]} {:db/id "answer-field-796d2edf-72cd-5edb-a250-8f0040849fed" :answer-field/id #uuid "796d2edf-72cd-5edb-a250-8f0040849fed" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-72d5bd5e-7472-57dd-bbfd-f86c424a9071" :answer-field/choices ["answer-72d5bd5e-7472-57dd-bbfd-f86c424a9071"] :db/ensure [:answer-field/validate]} {:db/id "answer-72d5bd5e-7472-57dd-bbfd-f86c424a9071" :answer/id #uuid "72d5bd5e-7472-57dd-bbfd-f86c424a9071" :answer/type :answer.type/math :answer/value "\\frac{(t^2-2)(t^2+25)}{5}" :db/ensure [:answer/validate]} {:db/id 17592186083278 :knowledge-point/questions ["question-4086d61d-9c18-5ba7-b425-e5509f913d48"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4086d61d-9c18-5ba7-b425-e5509f913d48" :question/id #uuid "4086d61d-9c18-5ba7-b425-e5509f913d48" :question/math-academy-id "q-133288" :question/problem "The tangent line to the eagle's flight path is horizontal at $t=${{field-1}}$\\,\\text{s}.$" :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is horizontal if ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n{t}^{2}-2=0\\,⟹\\,t=\\pm \\sqrt{2}.\n$$\n\nNote that $-\\sqrt{2}\\notin (0,\\infty ),$ so we only consider the value $t=\\sqrt{2}.$\n\nNow, we note that\n\n$$\n{x}^{′}(\\sqrt{2})=\\frac{5}{27}\\ne 0,\n$$\n\nwhich confirms that the curve's tangent is horizontal when $t=\\sqrt{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d12141e2-6a38-52ff-846b-6b7417e1ae0f"] :db/ensure [:question/validate]} {:db/id "answer-field-d12141e2-6a38-52ff-846b-6b7417e1ae0f" :answer-field/id #uuid "d12141e2-6a38-52ff-846b-6b7417e1ae0f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b291071b-8c33-51cd-93d8-3d6f97e2bee1" :answer-field/choices ["answer-b291071b-8c33-51cd-93d8-3d6f97e2bee1"] :db/ensure [:answer-field/validate]} {:db/id "answer-b291071b-8c33-51cd-93d8-3d6f97e2bee1" :answer/id #uuid "b291071b-8c33-51cd-93d8-3d6f97e2bee1" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id 17592186175939 :knowledge-point/questions ["question-eb009f1b-54cb-513a-ae27-a2c22d910e4d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eb009f1b-54cb-513a-ae27-a2c22d910e4d" :question/id #uuid "eb009f1b-54cb-513a-ae27-a2c22d910e4d" :question/math-academy-id "q-133289" :question/problem "The eagle is descending for all $t$ in the interval$\\,t\\in ($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "If the eagle is descending, then its vertical velocity is negative.\n\nWe know that the eagle's vertical velocity is given by ${y}^{′}(t)={t}^{2}-2.$\n\nTo calculate the time interval in which the eagle's vertical velocity is decreasing, we solve the inequality ${y}^{′}(t)<0:$\n\n$$\n\\begin{aligned}{y}^{′}(t) & <0 \\\\ {t}^{2}-2 & <0 \\\\ {t}^{2} & <2 \\\\ |t| & <\\sqrt{2}\\end{aligned}\n$$\n\nHowever, we know that $t>0.$ Therefore, the eagle is descending for $t\\in (0,\\sqrt{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c5bc5e64-6160-5d46-8ae4-099d090712d6" "answer-field-7164cda6-7d07-5c84-a4dc-5817c12576d3"] :db/ensure [:question/validate]} {:db/id "answer-field-c5bc5e64-6160-5d46-8ae4-099d090712d6" :answer-field/id #uuid "c5bc5e64-6160-5d46-8ae4-099d090712d6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c2e2f173-a72c-520b-adec-a73efbc497dc" :answer-field/choices ["answer-c2e2f173-a72c-520b-adec-a73efbc497dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2e2f173-a72c-520b-adec-a73efbc497dc" :answer/id #uuid "c2e2f173-a72c-520b-adec-a73efbc497dc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-7164cda6-7d07-5c84-a4dc-5817c12576d3" :answer-field/id #uuid "7164cda6-7d07-5c84-a4dc-5817c12576d3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7bfa30b5-acb3-5f10-b07c-946951bce63e" :answer-field/choices ["answer-7bfa30b5-acb3-5f10-b07c-946951bce63e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7bfa30b5-acb3-5f10-b07c-946951bce63e" :answer/id #uuid "7bfa30b5-acb3-5f10-b07c-946951bce63e" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id 17592186078566 :knowledge-point/questions ["question-742d438b-e3dc-52b0-a068-888e70c6be15"] :db/ensure [:knowledge-point/validate]} {:db/id "question-742d438b-e3dc-52b0-a068-888e70c6be15" :question/id #uuid "742d438b-e3dc-52b0-a068-888e70c6be15" :question/math-academy-id "q-133290" :question/problem "At time $t=5\\,\\text{s}$ the eagle is located at a point on $C$ with $y$-coordinate equal to $\\frac{95}{3}\\,\\text{m}.$ Use the tangent line approximation to approximate the $y$-coordinate of the eagle's location when $t=\\frac{110}{23}\\,\\text{s}.$\n\n$y(\\frac{110}{23})≈$\n{{field-1}}$\\,\\text{m}$" :question/worked-solution "The tangent line approximation to $y(t)$ at the point $a=5$ is\n\n$$\n\\begin{aligned}L(t) & =y(a)+{y}^{′}(a)(t-a) \\\\  & =y(5)+{y}^{′}(5)(t-5).\\end{aligned}\n$$\n\nWe're told that $y(5)=\\frac{95}{3},$ and since ${y}^{′}(t)={t}^{2}-2,$ then ${y}^{′}(5)=25-2=23.$ \n\nSo, the tangent line approximation is given by\n\n$$\n\\begin{aligned}L(t) & =\\frac{95}{3}+23(t-5).\\end{aligned}\n$$\n\nNow, we can approximate $y(\\frac{110}{23})$ by evaluating the tangent line approximation at $x=\\frac{110}{23}.$ We get\n\n$$\n\\begin{aligned}y(\\frac{110}{23}) & ≈L(\\frac{110}{23}) \\\\  & =\\frac{95}{3}+23(\\frac{110}{23}-5) \\\\  & =\\frac{95}{3}+23(-\\frac{5}{23}) \\\\  & =\\frac{95}{3}-5 \\\\  & =\\frac{80}{3}\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5800f9f-a331-5cd2-b8d9-dac2799c0d71"] :db/ensure [:question/validate]} {:db/id "answer-field-a5800f9f-a331-5cd2-b8d9-dac2799c0d71" :answer-field/id #uuid "a5800f9f-a331-5cd2-b8d9-dac2799c0d71" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9cc6edc-3d58-5b7d-be26-011da007a10e" :answer-field/choices ["answer-a9cc6edc-3d58-5b7d-be26-011da007a10e"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9cc6edc-3d58-5b7d-be26-011da007a10e" :answer/id #uuid "a9cc6edc-3d58-5b7d-be26-011da007a10e" :answer/type :answer.type/math :answer/value "\\frac{80}{3}" :db/ensure [:answer/validate]} {:db/id 17592186184153 :knowledge-point/questions ["question-836e24be-b58e-500b-bb05-e9b2030ce5e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-836e24be-b58e-500b-bb05-e9b2030ce5e6" :question/id #uuid "836e24be-b58e-500b-bb05-e9b2030ce5e6" :question/math-academy-id "q-133291" :question/problem "Find $y(t),$ the antiderivative of ${y}^{′}(t).$\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" :question/worked-solution "We know that ${y}^{′}(t)={t}^{2}-2.$\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {t}^{2}-2\\,\\text{d}t & =\\int {t}^{2}\\,\\text{d}t-\\int 2\\,\\text{d}t \\\\  & =\\int {t}^{2}\\,\\text{d}t-2\\int {t}^{0}\\,\\text{d}t \\\\  & =(\\frac{{t}^{2+1}}{2+1})-2t+C \\\\  & =\\frac{1}{3}{t}^{3}-2t+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1f591a2-abaf-568b-95d2-b28ddb7d4b0c"] :db/ensure [:question/validate]} {:db/id "answer-field-b1f591a2-abaf-568b-95d2-b28ddb7d4b0c" :answer-field/id #uuid "b1f591a2-abaf-568b-95d2-b28ddb7d4b0c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c412eada-9cf7-59a5-905e-0f6c0063eb13" :answer-field/choices ["answer-c412eada-9cf7-59a5-905e-0f6c0063eb13"] :db/ensure [:answer-field/validate]} {:db/id "answer-c412eada-9cf7-59a5-905e-0f6c0063eb13" :answer/id #uuid "c412eada-9cf7-59a5-905e-0f6c0063eb13" :answer/type :answer.type/math :answer/value "\\frac{t^3}{3}-2t" :db/ensure [:answer/validate]} {:db/id 17592186064196 :knowledge-point/questions ["question-143c70c1-44db-5544-97bc-c449974fa03d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-143c70c1-44db-5544-97bc-c449974fa03d" :question/id #uuid "143c70c1-44db-5544-97bc-c449974fa03d" :question/math-academy-id "q-133292" :question/problem "The eagle's total displacement in the $y$-direction over the first $6$ seconds is given by ${\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t.$ Calculate this displacement.\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is$\\,$\n{{field-1}}\n$\\,\\text{m}.$" :question/worked-solution "In part 7, we found that the antiderivative of ${y}^{′}(t)$ is\n\n$$\ny(t)=\\frac{1}{3}{t}^{3}-2t+C.\n$$\n\nBy the fundamental theorem of calculus, we take the antiderivative and evaluate the difference at the bounds:\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t & =y(t){|}_{0}^{6} \\\\  & ={(\\frac{1}{3}{t}^{3}-2t)|}_{0}^{6} \\\\  & =(\\frac{1}{3}(6)^{3}-2(6))-(\\frac{1}{3}(0)^{3}-2(0)) \\\\  & =60-0 \\\\  & =60.\\end{aligned}\n$$\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is $60\\,\\text{m}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-70887428-4f7c-590f-a390-58a8f2bf8ee3"] :db/ensure [:question/validate]} {:db/id "answer-field-70887428-4f7c-590f-a390-58a8f2bf8ee3" :answer-field/id #uuid "70887428-4f7c-590f-a390-58a8f2bf8ee3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-88892d02-3412-5492-af0a-49ebe61d9b7e" :answer-field/choices ["answer-88892d02-3412-5492-af0a-49ebe61d9b7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-88892d02-3412-5492-af0a-49ebe61d9b7e" :answer/id #uuid "88892d02-3412-5492-af0a-49ebe61d9b7e" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id 17592186068858 :knowledge-point/questions ["question-f4a5e43e-e7a6-55b0-a709-f89ec3a86933"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f4a5e43e-e7a6-55b0-a709-f89ec3a86933" :question/id #uuid "f4a5e43e-e7a6-55b0-a709-f89ec3a86933" :question/math-academy-id "q-133293" :question/problem "Let $r(t)=⟨x(t),y(t)⟩$ be the position vector of the eagle. Find the distance between the eagle and its nest at time $t=5\\,\\text{s},$ rounded to two decimal places.\n\nThe eagle is approximately$\\,$\n{{field-1}}\n$\\text{m}$ away from its nest after $t=5$ seconds." :question/worked-solution "Since the nest is at the origin, the distance between the bird and its nest at time $t=5$ is $|r(5)|.$\n\nWe know that $y(5)=\\frac{95}{3}.$ Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\operatorname{arctan}⁡(\\frac{5}{5}),\\frac{95}{3}⟩ \\\\  & =⟨\\frac{\\pi }{4},\\frac{95}{3}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{(\\frac{\\pi }{4})}^{2}+{(\\frac{95}{3})}^{2}} \\\\  & =\\sqrt{\\frac{{\\pi }^{2}}{16}+\\frac{9\\,025}{9}} \\\\  & ≈31.68\\,\\text{m}\\end{aligned}\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f220aba-10fa-5140-91ce-bb3c746dbdc3"] :db/ensure [:question/validate]} {:db/id "answer-field-8f220aba-10fa-5140-91ce-bb3c746dbdc3" :answer-field/id #uuid "8f220aba-10fa-5140-91ce-bb3c746dbdc3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d4c60dd5-4f2f-5247-b508-e4412be02a72" :answer-field/choices ["answer-d4c60dd5-4f2f-5247-b508-e4412be02a72"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4c60dd5-4f2f-5247-b508-e4412be02a72" :answer/id #uuid "d4c60dd5-4f2f-5247-b508-e4412be02a72" :answer/type :answer.type/math :answer/value "31.68" :db/ensure [:answer/validate]} {:db/id 17592186198355 :knowledge-point/questions ["question-c1baae25-37ff-504a-9b40-31c45e15f352"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c1baae25-37ff-504a-9b40-31c45e15f352" :question/id #uuid "c1baae25-37ff-504a-9b40-31c45e15f352" :question/math-academy-id "q-133294" :question/problem "${r}^{′}(\\sqrt{5})=\\,$$⟨$\n{{field-1}}\n$,$\n{{field-2}}\n$⟩$" :question/worked-solution "We differentiate each component separately.\n\n* For the $x$-component, we have\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\n$$\n\nand therefore,\n\n$$\n{x}^{′}(\\sqrt{5})=\\frac{5}{25+(\\sqrt{5})^{2}}=\\frac{1}{6}.\n$$\n\n* For the $y$-component, we have\n\n$$\n{y}^{′}(t)={t}^{2}-2,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(\\sqrt{5})=(\\sqrt{5})^{2}-2=3.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(\\sqrt{5}) & =⟨{x}^{′}(\\sqrt{5}),{y}^{′}(\\sqrt{5})⟩ \\\\  & =⟨\\frac{1}{6},3⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-280a3379-43b0-5e7e-835c-37f28ffa4d1a" "answer-field-4d783132-2979-54b3-9fd1-5a7588deaa6d"] :db/ensure [:question/validate]} {:db/id "answer-field-280a3379-43b0-5e7e-835c-37f28ffa4d1a" :answer-field/id #uuid "280a3379-43b0-5e7e-835c-37f28ffa4d1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c621d975-7e42-532e-8cd1-a5a95ff3741c" :answer-field/choices ["answer-c621d975-7e42-532e-8cd1-a5a95ff3741c"] :db/ensure [:answer-field/validate]} {:db/id "answer-c621d975-7e42-532e-8cd1-a5a95ff3741c" :answer/id #uuid "c621d975-7e42-532e-8cd1-a5a95ff3741c" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-field-4d783132-2979-54b3-9fd1-5a7588deaa6d" :answer-field/id #uuid "4d783132-2979-54b3-9fd1-5a7588deaa6d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cdc34de8-c927-5f9c-8dbf-b5874f7e2681" :answer-field/choices ["answer-cdc34de8-c927-5f9c-8dbf-b5874f7e2681"] :db/ensure [:answer-field/validate]} {:db/id "answer-cdc34de8-c927-5f9c-8dbf-b5874f7e2681" :answer/id #uuid "cdc34de8-c927-5f9c-8dbf-b5874f7e2681" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "multistep-b3bf487d-f311-547b-902e-6194ab2bcbfe" :multistep/id #uuid "b3bf487d-f311-547b-902e-6194ab2bcbfe" :multistep/context "An eagle flies along the parametric curve\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{t}{5}),\\,y=y(t),\\,t>0,\n$$\n\nwhere $x$ and $y$ are measured in meters relative to its nest at the origin, and $t$ is measured in seconds. The functions ${x}^{′}(t)$ and ${y}^{′}(t)$ give the eagle's horizontal and vertical velocity, respectively." :multistep/steps ["step-9e4e6674-5e6f-501b-bec3-9bdb487d5059" "step-5cd9358c-320d-5663-953d-407f8219b7ce" "step-0e869152-61a2-5f4c-b677-eb10be0bff89" "step-eb5ce766-c910-5578-addb-d9c3fe513f7c" "step-e6e7506e-0ef6-58fd-a0a5-b890fb1061ce" "step-25ed461a-1ae1-5bcc-a645-a1adcac020ee" "step-780c444c-203b-507b-affb-974182c4ecb1" "step-0b6a8ccd-d70c-5f07-bd06-c1a67bb8c918" "step-39c190e2-19cb-57ce-9a89-1a038703f741" "step-c41b1b6f-713f-5c06-8fe9-5de055592653"] :multistep/first-step "step-9e4e6674-5e6f-501b-bec3-9bdb487d5059" :db/ensure [:multistep/validate]} {:db/id "step-9e4e6674-5e6f-501b-bec3-9bdb487d5059" :step/id #uuid "9e4e6674-5e6f-501b-bec3-9bdb487d5059" :step/content "question-6e20ee7e-741b-5069-a51c-7de25cc32da7" :step/next "step-5cd9358c-320d-5663-953d-407f8219b7ce" :db/ensure [:step/validate]} {:db/id "step-5cd9358c-320d-5663-953d-407f8219b7ce" :step/id #uuid "5cd9358c-320d-5663-953d-407f8219b7ce" :step/content "question-95631ad4-7573-5741-9c54-4f854208188c" :step/next "step-0e869152-61a2-5f4c-b677-eb10be0bff89" :db/ensure [:step/validate]} {:db/id "step-0e869152-61a2-5f4c-b677-eb10be0bff89" :step/id #uuid "0e869152-61a2-5f4c-b677-eb10be0bff89" :step/content "question-08e75bed-6305-557a-ac6f-4a738a0fec12" :step/next "step-eb5ce766-c910-5578-addb-d9c3fe513f7c" :db/ensure [:step/validate]} {:db/id "step-eb5ce766-c910-5578-addb-d9c3fe513f7c" :step/id #uuid "eb5ce766-c910-5578-addb-d9c3fe513f7c" :step/content "question-4086d61d-9c18-5ba7-b425-e5509f913d48" :step/next "step-e6e7506e-0ef6-58fd-a0a5-b890fb1061ce" :db/ensure [:step/validate]} {:db/id "step-e6e7506e-0ef6-58fd-a0a5-b890fb1061ce" :step/id #uuid "e6e7506e-0ef6-58fd-a0a5-b890fb1061ce" :step/content "question-eb009f1b-5