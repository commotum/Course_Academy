ep-539bd2dd-3cda-521c-a46e-f9eef18ef15e"] :activity/first-step "step-539bd2dd-3cda-521c-a46e-f9eef18ef15e" :db/ensure [:activity/validate]} {:db/id "step-539bd2dd-3cda-521c-a46e-f9eef18ef15e" :step/id #uuid "539bd2dd-3cda-521c-a46e-f9eef18ef15e" :step/content "assigned-problem-741855b8-7746-5955-83c0-2e8c5d2341f9" :db/ensure [:step/validate]} {:db/id 17592186172024 :knowledge-point/questions ["question-daa14d13-b22a-5855-ae0b-e89337d6a6c3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-daa14d13-b22a-5855-ae0b-e89337d6a6c3" :question/id #uuid "daa14d13-b22a-5855-ae0b-e89337d6a6c3" :question/math-academy-id "q-102547" :question/problem "Find the root of $f(x)=\\sqrt[4]{-7-2x}+1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{-7-2x}+1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{-7-2x}+1 & =0 \\\\ \\sqrt[4]{-7-2x} & =-1\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f92cfc9a-845f-5eba-bf0a-56370e4c5744"] :db/ensure [:question/validate]} {:db/id "answer-field-f92cfc9a-845f-5eba-bf0a-56370e4c5744" :answer-field/id #uuid "f92cfc9a-845f-5eba-bf0a-56370e4c5744" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14084539-11f9-57a7-bca4-b41548842563" :answer-field/choices ["answer-e11e0448-3e5c-5bd7-8da6-0d9adf39655e" "answer-7cc13ad9-fa80-5007-ad61-79095af56b5e" "answer-bf30ec0c-ff50-5289-b435-f7fa72992683" "answer-5e32c774-4665-53a3-a335-e276947bd8e9" "answer-14084539-11f9-57a7-bca4-b41548842563"] :db/ensure [:answer-field/validate]} {:db/id "answer-e11e0448-3e5c-5bd7-8da6-0d9adf39655e" :answer/id #uuid "e11e0448-3e5c-5bd7-8da6-0d9adf39655e" :answer/type :answer.type/math :answ