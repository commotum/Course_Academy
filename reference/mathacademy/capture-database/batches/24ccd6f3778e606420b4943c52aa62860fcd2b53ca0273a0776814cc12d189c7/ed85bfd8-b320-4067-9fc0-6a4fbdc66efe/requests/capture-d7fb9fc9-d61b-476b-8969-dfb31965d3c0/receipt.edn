9535913 17592186045417 true] [17592186541053 1084 #edb/ref 17592186541225 13194139535913 17592186045417 true] [17592186541053 1085 "An eagle flies along the parametric curve\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{t}{5}),\\,y=y(t),\\,t>0,\n$$\n\nwhere $x$ and $y$ are measured in meters relative to its nest at the origin, and $t$ is measured in seconds. The functions ${x}^{′}(t)$ and ${y}^{′}(t)$ give the eagle's horizontal and vertical velocity, respectively." 13194139535913 17592186045417 true] [17592186541053 1086 #uuid "b3bf487d-f311-547b-902e-6194ab2bcbfe" 13194139535913 17592186045417 true] [17592186541053 1087 #edb/ref 17592186541207 13194139535913 17592186045417 true] [17592186541054 1068 #edb/ref 17592186541034 13194139535913 17592186045417 true] [17592186541054 1069 "q-101157" 13194139535913 17592186045417 true] [17592186541054 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541054 1071 "Evaluate ${lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t}.$" 13194139535913 17592186045417 true] [17592186541054 1072 #uuid "000ec056-1962-5b34-98db-f72ea83a397c" 13194139535913 17592186045417 true] [17592186541054 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(-4)^{2}-16}{(-4)^{2}+4(-4)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(t+4)(t-4)}{t(t+4)} \\\\  & =\\frac{t-4}{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & ={lim}_{t\\to -4}\\frac{t-4}{t} \\\\  & =\\frac{-4-4}{(-4)} \\\\  & =\\frac{(-8)}{(-4)} \\\\  & =2.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541055 1068 #edb/ref 17592186540962 13194139535913 17592186045417 true] [17592186541055 1068 #edb/ref 17592186541015 13194139535913 17592186045417 true] [17592186541055 1069 "q-326264" 13194139535913 17592186045417 true] [17592186541055 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541055 1071 "![](images/7c/7c5e30b2851a8268c5193c2f87e3c6ab77645db4d165d83150fb504ba06ef5c2.png)\n\nConsider the ellipse centered at the origin with horizontal radius $6$ and vertical radius $5,$ as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the ellipse once in the counterclockwise direction starting at the point $H(6,0).$\n\n$x=$ \n{{field-1}}$,\\,y=$ \n{{field-2}}$,\\,\\theta \\in [0,2\\pi ).$" 13194139535913 17592186045417 true] [17592186541055 1072 #uuid "01d2d95e-a1f1-5169-b942-8df45709b352" 13194139535913 17592186045417 true] [17592186541055 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(a,0).$\n\nIn our case, $a=6$ and $b=5.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541056 1068 #edb/ref 17592186540948 13194139535913 17592186045417 true] [17592186541056 1069 "q-26032" 13194139535913 17592186045417 true] [17592186541056 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541056 1071 "![](images/12/120d58ea1e9174a4304007c89b5de1c2f12b1312b89091d30a8b7929d6288092.png)\n\nThe polygon shown above is reflected across the line ${l}_{1}$ and then this resulting polygon is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final polygon?" 13194139535913 17592186045417 true] [17592186541056 1072 #uuid "061b72e1-6299-5d12-b681-2985a53463e0" 13194139535913 17592186045417 true] [17592186541056 1074 "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/0b/0b45d1a40068be7ed1e24c79308560d5c2d19f609eec5dedcae6665046b61991.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/75/75a215a1e852b5fa536cd305d917d2a1e6da1f7569872b9638474111a2691dd9.png)" 13194139535913 17592186045417 true] [17592186541057 1068 #edb/ref 17592186540972 13194139535913 17592186045417 true] [17592186541057 1068 #edb/ref 17592186541038 13194139535913 17592186045417 true] [17592186541057 1069 "q-333132" 13194139535913 17592186045417 true] [17592186541057 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541057 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{2}(t)-4,\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ 2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{2}{s-2}-\\frac{1}{s-4}+\\frac{1}{s},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1}{s-4}+\\frac{1}{s}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"40px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" 13194139535913 17592186045417 true] [17592186541057 1072 #uuid "0823a96b-ef1d-57d5-85ea-8ef149bb4b9a" 13194139535913 17592186045417 true] [17592186541057 1074 "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-2}-\\frac{1}{s-4}+\\frac{1}{s}\\} \\\\  & =2\\,{L}^{-1}\\{\\frac{1}{s-2}\\}-{L}^{-1}\\{\\frac{1}{s-4}\\}+{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =2{e}^{2\\cdot t}-{e}^{4\\cdot t}+1 \\\\  & =-{e}^{4t}+2{e}^{2t}+1 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-4}+\\frac{1}{s}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-4}\\}+{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & ={e}^{4\\cdot t}+1 \\\\  & ={e}^{4t}+1\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}-{e}^{4t}+2{e}^{2t}+1 \\\\ {e}^{4t}+1\\end{aligned}]\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541058 1068 #edb/ref 17592186540991 13194139535913 17592186045417 true] [17592186541058 1069 "q-133287" 13194139535913 17592186045417 true] [17592186541058 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541058 1071 "The eagle's path traces a curve $C$ in the $xy$-plane. Suppose that the eagle is at the point $P$ on $C$ at time $t.$ Expressed in terms of $t,$ what function gives the slope of the tangent to $C$ at $P?$\n\nThe slope of the tangent to $C$ at time $t$ equals$\\,$\n{{field-1}}." 13194139535913 17592186045417 true] [17592186541058 1072 #uuid "08e75bed-6305-557a-ac6f-4a738a0fec12" 13194139535913 17592186045417 true] [17592186541058 1074 "The slope of the tangent to $C$ equals $\\frac{\\text{d}y}{\\text{d}x}.$ To calculate this, we use the formula\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nTherefore,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{t}^{2}-2}{(\\frac{5}{25+{t}^{2}})}=\\frac{1}{5}({t}^{2}-2)({t}^{2}+25).\n$$" 13194139535913 17592186045417 true] [17592186541059 1068 #edb/ref 17592186541014 13194139535913 17592186045417 true] [17592186541059 1069 "q-106137" 13194139535913 17592186045417 true] [17592186541059 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541059 1071 "![](images/e1/e1fdcc8a8ed9dd9936ade0b088a672eadea1ca9ae7b12de7ce1b1dead2c3014a.png)\n\nFind the axis of symmetry for the parabola sketched above." 13194139535913 17592186045417 true] [17592186541059 1072 #uuid "094a6192-1567-5375-9e5c-b0ab7210d2c7" 13194139535913 17592186045417 true] [17592186541059 1074 "From the graph, we deduce that the roots are ${x}_{1}=-4$ and ${x}_{2}=2.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-4)+2}{2}=-1.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-1.$" 13194139535913 17592186045417 true] [17592186541060 1068 #edb/ref 17592186541018 13194139535913 17592186045417 true] [17592186541060 1069 "q-327800" 13194139535913 17592186045417 true] [17592186541060 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541060 1071 "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\operatorname{cos}⁡\\theta -4,\\,y=3\\sqrt{3}\\,\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" 13194139535913 17592186045417 true] [17592186541060 1072 #uuid "0d95a82d-3596-5013-a69c-59119b644955" 13194139535913 17592186045417 true] [17592186541060 1074 "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\operatorname{cos}⁡\\theta -4 \\\\ \\frac{x+4}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{3}\\operatorname{sin}⁡\\theta +2 \\\\ \\frac{y-2}{3\\sqrt{3}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{(3\\sqrt{3})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{27} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27}=1.\n$$" 13194139535913 17592186045417 true] [17592186541061 1068 #edb/ref 17592186540963 13194139535913 17592186045417 true] [17592186541061 1069 "q-352254" 13194139535913 17592186045417 true] [17592186541061 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541061 1071 "Consider the finite region bounded by the curve $y=-4+5x-{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541061 1072 #uuid "0dfc8af8-b45c-5404-a021-aa0515c46816" 13194139535913 17592186045417 true] [17592186541061 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}-4+5x-{x}^{2} & =0 \\\\ (x-1)(x-4) & =0\\end{aligned}\n$$\n\nThe solutions are $x=1$ and $x=4.$ So, we need to integrate from $x=1$ to $x=4.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{4}x(-4+5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{4}(-4x+5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(-2{x}^{2}+\\frac{5}{3}{x}^{3}-\\frac{1}{4}{x}^{4})|}_{1}^{4} \\\\  & =2\\pi ((-2({4}^{2})+\\frac{5}{3}({4}^{3})-\\frac{1}{4}({4}^{4}))-(-2+\\frac{5}{3}-\\frac{1}{4})) \\\\  & =2\\pi (\\frac{45}{4}) \\\\  & =\\frac{45\\pi }{2}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541062 1068 #edb/ref 17592186540959 13194139535913 17592186045417 true] [17592186541062 1069 "q-79288" 13194139535913 17592186045417 true] [17592186541062 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541062 1071 "![](images/13/13036c467cbe4fdd245b12c481de08ac1eb14bbfcc50653309a913ab1e9d8463.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" 13194139535913 17592186045417 true] [17592186541062 1072 #uuid "11028c29-bebb-5855-afbb-0a0cead7b8d3" 13194139535913 17592186045417 true] [17592186541062 1074 "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(4,-2),$ $a=7$ and $b=4.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=7\\operatorname{cos}⁡\\theta +4,\\,y=4\\operatorname{sin}⁡\\theta -2,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541063 1068 #edb/ref 17592186540987 13194139535913 17592186045417 true] [17592186541063 1069 "q-133292" 13194139535913 17592186045417 true] [17592186541063 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541063 1071 "The eagle's total displacement in the $y$-direction over the first $6$ seconds is given by ${\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t.$ Calculate this displacement.\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is$\\,$\n{{field-1}}\n$\\,\\text{m}.$" 13194139535913 17592186045417 true] [17592186541063 1072 #uuid "143c70c1-44db-5544-97bc-c449974fa03d" 13194139535913 17592186045417 true] [17592186541063 1074 "In part 7, we found that the antiderivative of ${y}^{′}(t)$ is\n\n$$\ny(t)=\\frac{1}{3}{t}^{3}-2t+C.\n$$\n\nBy the fundamental theorem of calculus, we take the antiderivative and evaluate the difference at the bounds:\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}{y}^{′}(t)\\,\\text{d}t & =y(t){|}_{0}^{6} \\\\  & ={(\\frac{1}{3}{t}^{3}-2t)|}_{0}^{6} \\\\  & =(\\frac{1}{3}(6)^{3}-2(6))-(\\frac{1}{3}(0)^{3}-2(0)) \\\\  & =60-0 \\\\  & =60.\\end{aligned}\n$$\n\nThe eagle's total displacement in the $y$-direction over the first $6$ seconds is $60\\,\\text{m}.$" 13194139535913 17592186045417 true] [17592186541064 1068 #edb/ref 17592186541012 13194139535913 17592186045417 true] [17592186541064 1069 "q-84897" 13194139535913 17592186045417 true] [17592186541064 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541064 1071 "![](images/ee/eeedf268b501345408b8192573072cbe21e9568c54f2abeead3d9f707748706d.png)\n\nFind the axis of symmetry for the parabola sketched above." 13194139535913 17592186045417 true] [17592186541064 1072 #uuid "158e2594-5618-53de-811b-cce07b6dc3b7" 13194139535913 17592186045417 true] [17592186541064 1074 "From the graph, we deduce that the roots are ${x}_{1}=1$ and ${x}_{2}=11.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{1+11}{2}=\\frac{12}{2}=6.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=6.$" 13194139535913 17592186045417 true] [17592186541065 1068 #edb/ref 17592186541009 13194139535913 17592186045417 true] [17592186541065 1069 "q-14553" 13194139535913 17592186045417 true] [17592186541065 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541065 1071 "Evaluate ${lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20}.$" 13194139535913 17592186045417 true] [17592186541065 1072 #uuid "1889a049-4ef8-5003-97ad-4734948ea194" 13194139535913 17592186045417 true] [17592186541065 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{{4}^{2}-2(4)-8}{{4}^{2}+4-20}=\\frac{0}{0},\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{(x+2)(x-4)}{(x+5)(x-4)} \\\\  & =\\frac{x+2}{x+5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & ={lim}_{x\\to 4}\\frac{x+2}{x+5} \\\\  & =\\frac{4+2}{4+5} \\\\  & =\\frac{6}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541066 1068 #edb/ref 17592186541046 13194139535913 17592186045417 true] [17592186541066 1069 "q-130018" 13194139535913 17592186045417 true] [17592186541066 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541066 1071 "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=-10,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" 13194139535913 17592186045417 true] [17592186541066 1072 #uuid "1d37bcc4-0c9f-508d-8122-95d6a1703d93" 13194139535913 17592186045417 true] [17592186541066 1074 "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-5-10) \\\\  & =-30\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541067 1068 #edb/ref 17592186541044 13194139535913 17592186045417 true] [17592186541067 1069 "q-139295" 13194139535913 17592186045417 true] [17592186541067 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541067 1071 "Consider the finite region bounded between the curves $y=2x$ and $y={x}^{2}-3x.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." 13194139535913 17592186045417 true] [17592186541067 1072 #uuid "1d5c9e76-b23d-5f4b-b9c9-3236b501399a" 13194139535913 17592186045417 true] [17592186541067 1074 "First, let $f(x)=2x$ and $g(x)={x}^{2}-3x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2x & ={x}^{2}-3x \\\\ {x}^{2}-5x & =0 \\\\ x(x-5) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=5.$ So, we need to integrate from $x=0$ to $x=5.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/d8/d8833c0c6f1becdbe2841f11fae25bb8e558edd06abee6668b2593c4e37c747b.png)\n\n  \n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)={x}^{2}-3x,$ and\n\n- *leaves* through the upper function $y=f(x)=2x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}x([2x]-[{x}^{2}-3x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}x(5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{5}(5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(\\frac{5{x}^{3}}{3}-\\frac{{x}^{4}}{4})|}_{0}^{5} \\\\  & =2\\pi [(\\frac{{5}^{4}}{3}-\\frac{{5}^{4}}{4})-0] \\\\  & =\\frac{625\\pi }{6}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541068 1068 #edb/ref 17592186540990 13194139535913 17592186045417 true] [17592186541068 1069 "q-279711" 13194139535913 17592186045417 true] [17592186541068 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541068 1071 "If $X∼B(7,0.6),$ then, **rounded to $3$ decimal places**, $P(3<X<6)≈${{field-1}}." 13194139535913 17592186045417 true] [17592186541068 1072 #uuid "1fdbae63-27df-5bf8-9dcb-6eda19028b94" 13194139535913 17592186045417 true] [17592186541068 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x}){(0.6)}^{x}{(0.4)}^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3<X<6) & =P(X\\in \\{4,5\\}) \\\\  & =f(4)+f(5) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{4}){(0.6)}^{4}{(0.4)}^{7-4}+(\\genfrac{}{}{0pt}{}{7}{5}){(0.6)}^{5}{(0.4)}^{7-5} \\\\  & =35{(0.6)}^{4}{(0.4)}^{3}+21{(0.6)}^{5}{(0.4)}^{2} \\\\  & ≈0.552\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139535913 17592186045417 true] [17592186541069 1068 #edb/ref 17592186540955 13194139535913 17592186045417 true] [17592186541069 1069 "q-333072" 13194139535913 17592186045417 true] [17592186541069 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541069 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{2}(t)+3,\\end{aligned}\\,x(0)=[\\begin{aligned}-2 \\\\ 0\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},$\\,$\n${X}_{2}(s)=\\frac{3}{s(s+1)}.$" 13194139535913 17592186045417 true] [17592186541069 1072 #uuid "24075bbd-fad1-5e70-847c-3b96960e39c5" 13194139535913 17592186045417 true] [17592186541069 1074 "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)-2{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-{x}_{2}(t)+3\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}-2L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-L\\{{x}_{2}(t)\\}+3L\\{1\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+2={X}_{1}(s)-2{X}_{2}(s) \\\\ s{X}_{2}(s)-0=-{X}_{2}(s)+\\frac{3}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the second equation for ${X}_{2}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{2}(s) & =-{X}_{2}(s)+\\frac{3}{s} \\\\ (s+1){X}_{2}(s) & =\\frac{3}{s} \\\\ {X}_{2}(s) & =\\frac{3}{s(s+1)}.\\end{aligned}\n$$\n\nSubstituting this in the first equation and solving for ${X}_{1}(s)$, we have\n\n$$\n\\begin{aligned}s{X}_{1}(s)+2 & ={X}_{1}(s)-2{X}_{2}(s) \\\\ (s-1){X}_{1}(s) & =-2-2{X}_{2}(s) \\\\ (s-1){X}_{1}(s) & =-2-2(\\frac{3}{s(s+1)}) \\\\ (s-1){X}_{1}(s) & =\\frac{-2s(s+1)-6}{s(s+1)} \\\\ (s-1){X}_{1}(s) & =\\frac{-2({s}^{2}+s)-6}{s(s+1)} \\\\ (s-1){X}_{1}(s) & =\\frac{-2{s}^{2}-2s-6}{s(s+1)} \\\\ {X}_{1}(s) & =\\frac{-2{s}^{2}-2s-6}{s(s+1)(s-1)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{-2{s}^{2}-2s-6}{s(s-1)(s+1)},\\,{X}_{2}(s)=\\frac{3}{s(s+1)}.\n$$" 13194139535913 17592186045417 true] [17592186541070 1068 #edb/ref 17592186541005 13194139535913 17592186045417 true] [17592186541070 1069 "q-311957" 13194139535913 17592186045417 true] [17592186541070 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541070 1071 "| **$x$** | $0$ | $14$ | $21$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $0$ | $-20$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. The parabola opens downward. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." 13194139535913 17592186045417 true] [17592186541070 1072 #uuid "269ed7f0-271d-546c-901b-64ac9bc840b6" 13194139535913 17592186045417 true] [17592186541070 1074 "Notice that the roots of the parabola are given. They are \n\n$$\nx=0\\,\\text{and}\\,x=14.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{0+14}{2} \\\\  & =7.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541071 1068 #edb/ref 17592186540995 13194139535913 17592186045417 true] [17592186541071 1069 "q-311953" 13194139535913 17592186045417 true] [17592186541071 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541071 1071 "| **$x$** | $0$ | $2$ | $10$ |\n| --- | --- | --- | --- |\n| **$f(x)$** | $0$ | $0$ | $80$ |\n\nThe graph of a parabola $y=f(x)$ passes through the points given by their $(x,y)$-coordinates in the table above. What is the $x$-coordinate of the parabola's vertex?\n\nThe $x$-coordinate of the vertex is\n{{field-1}}." 13194139535913 17592186045417 true] [17592186541071 1072 #uuid "27fc5b3b-5534-585e-84e3-7a7fff1acf0d" 13194139535913 17592186045417 true] [17592186541071 1074 "Notice that the roots of the parabola are given. They are \n\n$$\nx=0\\,\\text{and}\\,x=2.\n$$\n\nIf the coordinates of the vertex are $(h,k),$ then by the average of the roots formula, $h$ is simply the average of the two roots. Therefore, we have\n\n$$\n\\begin{aligned}h & =\\frac{0+2}{2} \\\\  & =1.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541072 1068 #edb/ref 17592186541043 13194139535913 17592186045417 true] [17592186541072 1069 "q-74419" 13194139535913 17592186045417 true] [17592186541072 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541072 1071 "Find the shortest distance between the point $(3,2)$ and the line $y=x+1.$" 13194139535913 17592186045417 true] [17592186541072 1072 #uuid "3115c643-189e-5d0d-96c2-b1b8ae304036" 13194139535913 17592186045417 true] [17592186541072 1074 "Let's draw a diagram describing our situation. \n\n![](images/80/80f3e7d79f84a3894e563c78747e22ccf11c889783c39ed6fb688a4242160d60.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=x+1$ and passes through the point $(3,2).$\n\n The given line has a slope of $1,$ so our perpendicular line must have a slope of $-1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-1(x-3) \\\\ y-2 & =-x+3 \\\\ y & =-x+5\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=x+1 \\\\ y=-x+5\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x+1 & =-x+5 \\\\ x+x & =-1+5 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$\n\nSubstituting $x=2$ into either of the two equations gives $y=3.$ So, our solution is $x=2$ and $y=3.$ Therefore, the lines intersect at the point $(2,3).$\n\nFinally, we find the distance $d$ between the points $(3,2)$ and $(2,3):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-3)^{2}+(3-2)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(3,2)$ and the line $y=x+1$ is $\\sqrt{2}.$" 13194139535913 17592186045417 true] [17592186541073 1068 #edb/ref 17592186540944 13194139535913 17592186045417 true] [17592186541073 1069 "q-29652" 13194139535913 17592186045417 true] [17592186541073 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541073 1071 "What is the antiderivative of $\\sqrt[5]{{x}^{7}}?$" 13194139535913 17592186045417 true] [17592186541073 1072 #uuid "31f8bbd7-44e6-58a8-9f8d-def7c80fe8a8" 13194139535913 17592186045417 true] [17592186541073 1074 "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{7}}={x}^{7/5}.$ So, we can apply the power rule with $n=\\frac{7}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{7}}\\,\\text{d}x & =\\int {x}^{7/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{7/5+1}}{(\\frac{7}{5}+1)}+C \\\\  & =\\frac{{x}^{12/5}}{(\\frac{12}{5})}+C \\\\  & =\\frac{5{x}^{12/5}}{12}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{12/5}}{12})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{12}\\frac{\\text{d}}{\\text{d}x}({x}^{12/5})+0 & = \\\\ \\frac{5}{12}\\cdot \\frac{12}{5}{x}^{12/5-1} & = \\\\ {x}^{7/5}\\,✓\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541074 1068 #edb/ref 17592186540976 13194139535913 17592186045417 true] [17592186541074 1069 "q-336500" 13194139535913 17592186045417 true] [17592186541074 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541074 1071 "A syrup mixing tank at a bottling plant can hold up to $220\\,\\text{gal}$ of liquid. Initially, it contains $120\\,\\text{gal}$ of syrup solution with $24\\,\\text{lb}$ of dissolved sugar. A more concentrated sugar solution with concentration $0.7\\,\\text{lb/gal}$ flows into the tank at a rate of $12\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $8\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of sugar in the tank at the moment it begins to overflow." 13194139535913 17592186045417 true] [17592186541074 1072 #uuid "36a65a87-c8d0-5bbf-adbe-0789f4e08164" 13194139535913 17592186045417 true] [17592186541074 1074 "Since $Q$ is the amount of sugar in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which sugar enters the tank minus the rate at which sugar leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the tank.\n\nFirst, note that a solution containing $0.7\\,\\text{lb/gal}$ of sugar enters the tank at a rate of $12\\,\\text{gal/min}.$ So, the rate at which the *sugar* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.7\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (12\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.7\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =8.4\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the tank.\n\nTo find the rate at which sugar leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $120\\,\\text{gal}$ of liquid; solution enters at $12\\,\\text{gal/min}$ and mixed solution leaves at $8\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=120+12t-8t=4(30+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of sugar in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{4(30+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $8\\,\\text{gal/min},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(8\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(8\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{8Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{30+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =8.4-\\frac{2Q}{30+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q=8.4.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(30+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|30+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(30+t)^{2}} \\\\  & =(30+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(30+t)^{2}$ yields\n\n$$\n\\begin{aligned}(30+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q) & =(30+t)^{2}\\cdot 8.4 \\\\ (30+t)^{2}\\frac{dQ}{dt}+2(30+t)Q & =8.4(30+t)^{2} \\\\ \\frac{d}{dt}(Q(30+t)^{2}) & =8.4(30+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(30+t)^{2})\\,dt & =\\int 8.4(30+t)^{2}\\,dt \\\\ Q(30+t)^{2} & =8.4\\cdot \\frac{1}{3}(30+t)^{3}+C \\\\ Q(t) & =2.8(30+t)+\\frac{C}{(30+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $24\\,\\text{lb}$ of sugar. So, we can apply the initial condition $Q(0)=24,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =24 \\\\ 2.8(30+0)+\\frac{C}{(30+0)^{2}} & =24 \\\\ 84+\\frac{C}{(30)^{2}} & =24 \\\\ \\frac{C}{(30)^{2}} & =-60 \\\\ C & =-60(30)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =2.8(30+t)-\\frac{60(30)^{2}}{(30+t)^{2}} \\\\  & =2.8(30+t)-60{(\\frac{30}{30+t})}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $220\\,\\text{gal},$ so we can use the condition $V({t}_{o})=220$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =220 \\\\ 120+12{t}_{o}-8{t}_{o} & =220 \\\\ 120+4{t}_{o} & =220 \\\\ 4{t}_{o} & =100 \\\\ {t}_{o} & =25\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of sugar in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(25) & =2.8(30+25)-60{(\\frac{30}{30+25})}^{2} \\\\  & =154-60{(\\frac{30}{55})}^{2} \\\\  & ≈136.1\\,\\text{lb}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541075 1068 #edb/ref 17592186541037 13194139535913 17592186045417 true] [17592186541075 1069 "q-156129" 13194139535913 17592186045417 true] [17592186541075 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541075 1071 "Find the set of values of $x$ that satisfy $2<2x+4\\le 6$ and $4x>12.$" 13194139535913 17592186045417 true] [17592186541075 1072 #uuid "3cd6f974-c65a-5148-8d00-27906b9e797b" 13194139535913 17592186045417 true] [17592186541075 1074 "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $2<2x+4\\le 6\\,:$ \n\n$$\n\\begin{aligned}2 & <2x+4\\le 6 \\\\ 2-4 & <2x+4-4\\le 6-4 \\\\ -2 & <2x\\le 2 \\\\ \\frac{-2}{2} & <\\frac{2x}{2}\\le \\frac{2}{2} \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/48/485e77fe84f5745120d5f450c3e1043ee61463a83f7c12bfc6d1ae0e4124a38b.png)\n\n   \n\n- Then, we solve  $4x>12\\,:$\n\n$$\n\\begin{aligned}4x & >12 \\\\ \\frac{4x}{4} & >\\frac{12}{4} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/65/654f97a64ec1a13b4a94860dfa07d05f7c119a5fe2084ba23aa994a97f0bea70.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/d2/d2d0f41792356b6c250612b033413f66bfd7a35440e1b84da660fccd5c1285b0.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution." 13194139535913 17592186045417 true] [17592186541076 1068 #edb/ref 17592186540943 13194139535913 17592186045417 true] [17592186541076 1069 "q-85235" 13194139535913 17592186045417 true] [17592186541076 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541076 1071 "![](images/fd/fd812d1d33801a3ce8368feca0e7d6b87e02bcfab5d904d9b59172d95d0204e5.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{11}}{6},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" 13194139535913 17592186045417 true] [17592186541076 1072 #uuid "40216ba0-427a-539f-9353-a0236ab249d0" 13194139535913 17592186045417 true] [17592186541076 1074 "![](images/e0/e087efb9eb18158005722dd6628cc8f19b22a2b33cad8f67205b8ea398e62c54.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{11}}{6}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{11}}{6}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{11}}{6}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{11}}{6})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{11}{36}} \\\\  & =\\pm \\sqrt{\\frac{25}{36}} \\\\  & =\\pm \\frac{5}{6}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{5}{6}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{5}{6})}=\\frac{6}{5}.\n$$" 13194139535913 17592186045417 true] [17592186541077 1068 #edb/ref 17592186540975 13194139535913 17592186045417 true] [17592186541077 1069 "q-139260" 13194139535913 17592186045417 true] [17592186541077 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541077 1071 "![](images/11/11b85e35604a0350a9fd7754dfda481000debb20397d9aa593a1b887409a97c7.png)\n\nConsider the finite region bounded by the curves $y=4x-\\frac{{x}^{3}}{2}$ and $y=2x,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." 13194139535913 17592186045417 true] [17592186541077 1072 #uuid "4022977e-c101-551c-847a-d892e1fa6f2e" 13194139535913 17592186045417 true] [17592186541077 1074 "First, let $f(x)=4x-\\frac{{x}^{3}}{2}$ and $g(x)=2x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 4x-\\frac{{x}^{3}}{2} & =2x \\\\ 8x-{x}^{3}-2x & =0 \\\\ 4x-{x}^{3} & =0 \\\\ x(4-{x}^{2}) & =0 \\\\ x(2-x)(2+x)\\end{aligned}\n$$\n\nThe solutions are $x=-2,$ $x=0,$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2$ because we are only concerned about $x\\ge 0.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/e0/e03c88c1d24116cc9f68c69150eba39cb6593b4bf6fd4ca9640987ce4ba62299.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=2x,$ and\n\n- *leaves* through the upper function $y=f(x)=4x-\\frac{{x}^{3}}{2}.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([4x-\\frac{{x}^{3}}{2}]-[2x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2x-\\frac{{x}^{3}}{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{2}-\\frac{{x}^{4}}{2})\\text{d}x\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541078 1068 #edb/ref 17592186541032 13194139535913 17592186045417 true] [17592186541078 1069 "q-133288" 13194139535913 17592186045417 true] [17592186541078 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541078 1071 "The tangent line to the eagle's flight path is horizontal at $t=${{field-1}}$\\,\\text{s}.$" 13194139535913 17592186045417 true] [17592186541078 1072 #uuid "4086d61d-9c18-5ba7-b425-e5509f913d48" 13194139535913 17592186045417 true] [17592186541078 1074 "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is horizontal if ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nIn parts 1 and 2, we found\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\\,{y}^{′}(t)={t}^{2}-2.\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n{t}^{2}-2=0\\,⟹\\,t=\\pm \\sqrt{2}.\n$$\n\nNote that $-\\sqrt{2}\\notin (0,\\infty ),$ so we only consider the value $t=\\sqrt{2}.$\n\nNow, we note that\n\n$$\n{x}^{′}(\\sqrt{2})=\\frac{5}{27}\\ne 0,\n$$\n\nwhich confirms that the curve's tangent is horizontal when $t=\\sqrt{2}.$" 13194139535913 17592186045417 true] [17592186541079 1068 #edb/ref 17592186541025 13194139535913 17592186045417 true] [17592186541079 1069 "q-94348" 13194139535913 17592186045417 true] [17592186541079 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541079 1071 "$$\nA=[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first and second columns of the matrix $P?$" 13194139535913 17592186045417 true] [17592186541079 1072 #uuid "4abf3f5b-ec82-5ed8-874d-b7cd0f7cd357" 13194139535913 17592186045417 true] [17592186541079 1074 "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=1,$ and ${\\lambda }_{3}=3.$ So, the first and second columns of $P$ correspond to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2}.$ \n\nNow, we need to find eigenvectors that correspond to ${\\lambda }_{1}={\\lambda }_{2}=1.$ Computing $A-1I,$ we get\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives two eigenvectors: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]$\n\nNotice that eigenvectors ${v}_{1}$ and ${v}_{2}$ are  orthogonal. So, we divide ${v}_{1}$ and ${v}_{2}$ by their respective norms to obtain the first and second columns of $P:$\n\n$$\n\\begin{aligned}\\frac{{v}_{1}}{‖{v}_{1}‖} & =[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}] \\\\ \\frac{{v}_{2}}{‖{v}_{2}‖} & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541080 1068 #edb/ref 17592186540964 13194139535913 17592186045417 true] [17592186541080 1069 "q-352642" 13194139535913 17592186045417 true] [17592186541080 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541080 1071 "Consider the finite region bounded between the curves $y=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x$ and $y=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$ Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541080 1072 #uuid "4ae3570d-9f53-5028-8c3b-4778adbb6463" 13194139535913 17592186045417 true] [17592186541080 1074 "First, let $f(x)=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x$ and $g(x)=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ \\frac{3}{2}{x}^{2}+\\frac{5}{2}x & =-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x \\\\ 3{x}^{2}+5x & =-2{x}^{3}+7{x}^{2}+5x \\\\ 2{x}^{3}-4{x}^{2} & =0 \\\\ 2{x}^{2}(x-2) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$\n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/d1/d19b70836b7b377c498fa505868563115706b588b0a2216d09c6ec738f746bbd.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=f(x)=\\frac{3}{2}{x}^{2}+\\frac{5}{2}x,$ and\n\n- *leaves* through the upper function $y=g(x)=-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([-{x}^{3}+\\frac{7}{2}{x}^{2}+\\frac{5}{2}x]-[\\frac{3}{2}{x}^{2}+\\frac{5}{2}x])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(-{x}^{3}+2{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(-{x}^{4}+2{x}^{3})\\text{d}x \\\\  & =2\\pi {(-\\frac{{x}^{5}}{5}+\\frac{{x}^{4}}{2})|}_{0}^{2} \\\\  & =2\\pi [(-\\frac{{2}^{5}}{5}+\\frac{{2}^{4}}{2})-0] \\\\  & =2\\pi (-\\frac{32}{5}+8) \\\\  & =2\\pi \\cdot \\frac{8}{5} \\\\  & =\\frac{16\\pi }{5}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541081 1068 #edb/ref 17592186541040 13194139535913 17592186045417 true] [17592186541081 1069 "q-127327" 13194139535913 17592186045417 true] [17592186541081 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541081 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨y\\operatorname{cos}⁡y+y{x}^{3},\\,\\sqrt[3]{x}+y⟩\n$$\n\nthrough the boundary of the square with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2).$" 13194139535913 17592186045417 true] [17592186541081 1072 #uuid "512baac6-6af2-5983-be4f-040d5e0743f6" 13194139535913 17592186045417 true] [17592186541081 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=y\\operatorname{cos}⁡y+y{x}^{3}$ and $Q(x,y)=\\sqrt[3]{x}+y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}y+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}(3{x}^{2}y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}({x}^{3}y+x)\\,{|}_{-1}^{1}\\,dy \\\\  & ={\\int }_{0}^{2}[((1)^{3}y+1)-((-1)^{3}y+(-1))]\\,dy \\\\  & ={\\int }_{0}^{2}(2y+2)\\,dy \\\\  & =[{y}^{2}+2y]_{0}^{2} \\\\  & =((2)^{2}+2(2))-0 \\\\  & =8.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541082 1068 #edb/ref 17592186540986 13194139535913 17592186045417 true] [17592186541082 1069 "q-114324" 13194139535913 17592186045417 true] [17592186541082 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541082 1071 "Find the shortest distance between the point $(4,-1)$ and the line $x=-2.$" 13194139535913 17592186045417 true] [17592186541082 1072 #uuid "52deb492-2c28-55be-ad12-3e097a96cc24" 13194139535913 17592186045417 true] [17592186541082 1074 "Let's sketch the given situation.\n\n![](images/ae/ae9c7b44a3e246fb6e0e9f90c1288ef42814c22d705c944e46fe0eb890a5a998.png)\n\nSince the line $x=-2$ is a vertical line, the shortest distance between this line and the point $(4,-1)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $-2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-(-2)|=6.\n$$" 13194139535913 17592186045417 true] [17592186541083 1068 #edb/ref 17592186540989 13194139535913 17592186045417 true] [17592186541083 1069 "q-102564" 13194139535913 17592186045417 true] [17592186541083 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541083 1071 "![](images/72/721572d7cbc2f760e74eadc4cec8e8bbd6f730a6a12eb56efd112de85bee0d30.png)\n\nThe figure shown above is reflected across the line ${l}_{1}$ and then this resulting figure is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final figure?" 13194139535913 17592186045417 true] [17592186541083 1072 #uuid "52fe2e63-f4cc-5045-bc08-fddd99b9edf2" 13194139535913 17592186045417 true] [17592186541083 1074 "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/3b/3b9947ebf3ebf9d6cbd2aa14ab889eb378a3bf5a78ad78d084e2662faab4d733.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/af/afe4c717eb216e75e950cce573d87f6f34f83cfe99f9b2e60c5e75f9dee7fafa.png)" 13194139535913 17592186045417 true] [17592186541084 1068 #edb/ref 17592186540967 13194139535913 17592186045417 true] [17592186541084 1069 "q-109956" 13194139535913 17592186045417 true] [17592186541084 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541084 1071 "For two independent random variables $X$ and $Y,$ we have $\\text{Var}[X]=16$ and $\\text{Var}[Y]=6.$ Find $\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y].$" 13194139535913 17592186045417 true] [17592186541084 1072 #uuid "59606949-3c87-521e-a2c2-60c040472354" 13194139535913 17592186045417 true] [17592186541084 1074 "Recall that if $X$ and $Y$ are independent variables, and $a$ and $b$ are constants, then \n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y].\n$$\n\nSubstituting the given data into the formula above, we obtain \n\n$$\n\\text{Var}[\\frac{3}{8}X+\\frac{1}{2}Y]={(\\frac{3}{8})}^{2}\\cdot 16+{(\\frac{1}{2})}^{2}\\cdot 6=\\frac{15}{4}.\n$$" 13194139535913 17592186045417 true] [17592186541085 1068 #edb/ref 17592186540946 13194139535913 17592186045417 true] [17592186541085 1069 "q-138966" 13194139535913 17592186045417 true] [17592186541085 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541085 1071 "Consider the curve defined parametrically as \n\n$$\nx={e}^{t},\\,y=2{e}^{t/2},\\,t\\in [0,4].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" 13194139535913 17592186045417 true] [17592186541085 1072 #uuid "5b66c4d7-d9b1-5cb6-840d-18a9a3471ea0" 13194139535913 17592186045417 true] [17592186541085 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=4.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{t/2})={e}^{t/2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{4}2{e}^{t/2}\\sqrt{{({e}^{t})}^{2}+{({e}^{t/2})}^{2}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{4}{e}^{t/2}\\sqrt{{e}^{2t}+{e}^{t}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{4}{e}^{t/2}\\sqrt{{e}^{t}({e}^{t}+1)}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{4}{e}^{t/2}\\cdot {e}^{t/2}\\cdot \\sqrt{{e}^{t}+1}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{0}^{4}{e}^{t}\\sqrt{{e}^{t}+1}\\,\\text{d}t.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541086 1068 #edb/ref 17592186541003 13194139535913 17592186045417 true] [17592186541086 1068 #edb/ref 17592186541019 13194139535913 17592186045417 true] [17592186541086 1069 "q-327167" 13194139535913 17592186045417 true] [17592186541086 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541086 1071 "![](images/a4/a41c728f9a82b563203fa0eb6944617948cf12c048be2553b803b06820d0b896.png)\n\nConsider the ellipse centered at $(-3,4)$ with horizontal radius $2$ and vertical radius $6,$ as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the ellipse once in the counterclockwise direction starting at the point $A(-1,4).$\n\n$x=$ \n{{field-1}}$,\\,y=$ \n{{field-2}}$,\\,\\theta \\in [0,2\\pi ).$" 13194139535913 17592186045417 true] [17592186541086 1072 #uuid "5bd0d286-b955-5de9-a7f0-4b2c20b02f7e" 13194139535913 17592186045417 true] [17592186541086 1074 "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(h+a,k).$\n\nIn our case, the ellipse is centered at the point $(-3,4),$ $a=2$ and $b=6.$ Therefore, the parametric equations of the ellipse are \n\n$$\nx=2\\operatorname{cos}⁡\\theta -3,\\,y=6\\operatorname{sin}⁡\\theta +4,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541087 1068 #edb/ref 17592186541000 13194139535913 17592186045417 true] [17592186541087 1069 "q-79277" 13194139535913 17592186045417 true] [17592186541087 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541087 1071 "![](images/cc/cc9e723494b5d592b97ff1b4795eb1bc0ca7be0c4608591792eb2ac5515a9811.png)\n\nThe quarter-ellipse above is defined by the parametric equations \n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" 13194139535913 17592186045417 true] [17592186541087 1072 #uuid "5bd7c7cd-dbab-5060-9d8d-5c720fc231fd" 13194139535913 17592186045417 true] [17592186541087 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=1$ and $b=3.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the elipse and the $x$-axis. \n\n![](images/6e/6eeff954ea6f159a3bdc781361da094319bcf06a5365d12e894228bb172a16e6.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},\\pi ]$, we get the quarter-ellipse.\n\nTherefore, the parametric equations of the quarter-ellipse are \n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{\\pi }{2},\\pi ].\n$$" 13194139535913 17592186045417 true] [17592186541088 1068 #edb/ref 17592186541033 13194139535913 17592186045417 true] [17592186541088 1069 "q-223688" 13194139535913 17592186045417 true] [17592186541088 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541088 1071 "The axis of symmetry of the parabola $y=(2x+5)(2x+k)$ is $x=-\\frac{9}{4}.$ Find the value of $k.$\n\n$k=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541088 1072 #uuid "65741bd8-a817-5dbe-b425-cf51f2c41352" 13194139535913 17592186045417 true] [17592186541088 1074 "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{9}{4},$ we will set our result equal to $-\\frac{9}{4}.$ \n\nFrom the equation $y=(2x+5)(2x+k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{5}{2}$ and ${x}_{2}=-\\frac{k}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{5}{2}-\\frac{k}{2})}{2} \\\\  & =\\frac{(-\\frac{5+k}{2})}{2} \\\\  & =-\\frac{5+k}{4}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{9}{4}.$ Therefore, we have\n\n$$\n\\begin{aligned}-\\frac{5+k}{4} & =-\\frac{9}{4} \\\\ 5+k & =9 \\\\ k & =4.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541089 1068 #edb/ref 17592186540979 13194139535913 17592186045417 true] [17592186541089 1069 "q-139183" 13194139535913 17592186045417 true] [17592186541089 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541089 1071 "![](images/17/179894a17a2aadf5ba9f463ae3faf2e5836f7b268066f8f56de0f3cf3ff2d8fa.png)\n\nConsider the finite region bounded by the curve $y=2{x}^{2}-{x}^{3}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" 13194139535913 17592186045417 true] [17592186541089 1072 #uuid "6674be9e-fa9a-51c5-9fa3-be41c5ad9ead" 13194139535913 17592186045417 true] [17592186541089 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}2{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(2-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541090 1068 #edb/ref 17592186541027 13194139535913 17592186045417 true] [17592186541090 1069 "q-80674" 13194139535913 17592186045417 true] [17592186541090 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541090 1071 "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y),\\, & \\text{if}\\,0<x<\\pi ,\\,-\\frac{\\pi }{2}<y<0, \\\\ \\operatorname{cos}⁡(x-y),\\, & \\text{if}\\,0<x<\\pi ,\\,0<y<\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,\\pi )\\times (-\\pi /2,\\pi /2)}f(x,y)\\text{ }\\text{d}A=\n$$" 13194139535913 17592186045417 true] [17592186541090 1072 #uuid "66ff7371-5323-5876-b071-49b4ca2a6463" 13194139535913 17592186045417 true] [17592186541090 1074 "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,\\pi )\\times ((-\\frac{\\pi }{2},0)\\cup (0,\\frac{\\pi }{2})) \\\\  & =((0,\\pi )\\times (-\\frac{\\pi }{2},0))\\cup ((0,\\pi )\\times (0,\\frac{\\pi }{2})).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}f(x,y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,\\pi )\\times (-\\pi /2,0)}\\operatorname{sin}⁡(x+y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (0,\\pi /2)}\\operatorname{cos}⁡(x-y)\\,\\text{d}A.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541091 1068 #edb/ref 17592186540949 13194139535913 17592186045417 true] [17592186541091 1069 "q-37897" 13194139535913 17592186045417 true] [17592186541091 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541091 1071 "![](images/1b/1b084e0ad229e935d70d751f0e0ddaacf5832017951a7ef8e334f27834662d5c.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{5}}{3},$ use the Pythagorean identity to find $\\operatorname{tan}⁡\\theta .$" 13194139535913 17592186045417 true] [17592186541091 1072 #uuid "67eb7841-2530-5536-9fe7-7fe1cd1941b8" 13194139535913 17592186045417 true] [17592186541091 1074 "![](images/57/5778175613309c2b4b8007291ad122b879de1cd409ad3513f3f786c8f4885927.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{5}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{5}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{5}}{3}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{5}}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{5}{9}} \\\\  & =\\pm \\sqrt{\\frac{4}{9}} \\\\  & =\\pm \\frac{2}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{2}{3}.$\n\nKnowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{2}{3})}{(\\frac{\\sqrt{5}}{3})}=\\frac{2}{\\sqrt{5}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{2}{\\sqrt{5}} \\\\  & =\\frac{2}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} \\\\  & =\\frac{2\\sqrt{5}}{5}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541092 1068 #edb/ref 17592186541020 13194139535913 17592186045417 true] [17592186541092 1069 "q-74423" 13194139535913 17592186045417 true] [17592186541092 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541092 1071 "![](images/bc/bc1432b521a372c9a7e264700cc58eef96c34b347e0300f5b7c323066ed0cc7b.png)\n\nFind the point on the line $y=\\frac{4}{3}x$ that is closest to the point $(-1,7).$" 13194139535913 17592186045417 true] [17592186541092 1072 #uuid "683e7ef8-4750-58e2-a136-8e19dd7482de" 13194139535913 17592186045417 true] [17592186541092 1074 "First, we find the equation of the line that's perpendicular to $y=\\frac{4}{3}x$ and passes through the point $(-1,7).$\n\n The given line has a slope of $\\frac{4}{3},$ so our perpendicular line must have a slope of $-\\frac{3}{4}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-7 & =-\\frac{3}{4}(x+1) \\\\ y-7 & =-\\frac{3}{4}x-\\frac{3}{4} \\\\ y & =-\\frac{3}{4}x+\\frac{25}{4}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=\\frac{4}{3}x \\\\ y=-\\frac{3}{4}x+\\frac{25}{4}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}\\frac{4}{3}x & =-\\frac{3}{4}x+\\frac{25}{4} \\\\ \\frac{4}{3}x+\\frac{3}{4}x & =\\frac{25}{4} \\\\ \\frac{25}{12}x & =\\frac{25}{4} \\\\ x & =\\frac{25}{4}\\cdot \\frac{12}{25} \\\\ x & =3.\\end{aligned}\n$$\n\nSubstituting $x=3$ into either of the two equations gives $y=4.$ So, our solution is $x=3$ and $y=4.$ Therefore, the lines intersect at the point $(3,4).$\n\nTherefore, we conclude that the point on the line $y=\\frac{4}{3}x$ that is closest to the point $(-1,7)$ is $(3,4).$" 13194139535913 17592186045417 true] [17592186541093 1068 #edb/ref 17592186540998 13194139535913 17592186045417 true] [17592186541093 1069 "q-75253" 13194139535913 17592186045417 true] [17592186541093 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541093 1071 "Let $R=[0,4]\\times [0,4]$ be a region in the $xy$-plane, and let $f(x,y)=20-2x-3y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,2,4\\},\\,{P}_{2}=\\{0,2,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139535913 17592186045417 true] [17592186541093 1072 #uuid "68f740c4-3eaf-53af-86af-a7b05d82500b" 13194139535913 17592186045417 true] [17592186541093 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/29/293e79685a3f4da205d986bcf4331e4b4f43c0a48fe183d27f93aaee6bb17b99.png)\n\nThe lower Riemann sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the minimum value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=4$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)=4{m}_{11}+4{m}_{21}+4{m}_{12}+4{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=20-2x-3y$ decreases as $x$ increases, and\n\n- $f(x,y)=20-2x-3y$ decreases as $y$ increases.\n\n![](images/cc/cc6e04660f00d04307715159c25aa2860ca08af74ed36fc9b0be15d10ee94a27.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/74/744aeb24bb4fd4487b35ffd789d957879cb0c3ee92e40519f71b65ee5ee76dcf.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(2,2)=10 \\\\ {m}_{21} & =f(4,2)=6 \\\\ {m}_{12} & =f(2,4)=4 \\\\ {m}_{22} & =f(4,4)=0\\end{aligned}\n$$\n\nFinally,\n\n$$\nL(f,P)=4\\cdot 10+4\\cdot 6+4\\cdot 4+4\\cdot 0=80.\n$$" 13194139535913 17592186045417 true] [17592186541094 1068 #edb/ref 17592186541048 13194139535913 17592186045417 true] [17592186541094 1069 "q-336508" 13194139535913 17592186045417 true] [17592186541094 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541094 1071 "A wastewater treatment tank at a chemical plant can hold up to $180\\,\\text{gal}$ of liquid. Initially, it contains $120\\,\\text{gal}$ of wastewater with $40\\,\\text{lb}$ of dissolved contaminant. A more concentrated wastewater stream with concentration $1.25\\,\\text{lb/gal}$ flows into the tank at a rate of $12\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $8\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of contaminant in the tank at the moment it begins to overflow." 13194139535913 17592186045417 true] [17592186541094 1072 #uuid "6c55e9d5-5244-5391-84ab-9850b2ba8152" 13194139535913 17592186045417 true] [17592186541094 1074 "Since $Q$ is the amount of contaminant in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminant enters the tank minus the rate at which contaminant leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminant enters the tank.\n\nFirst, note that a solution containing $1.25\\,\\text{lb/gal}$ of contaminant enters the tank at a rate of $12\\,\\text{gal/min}.$ So, the rate at which the *contaminant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(1.25\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (12\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(1.25\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =15\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminant exits the tank.\n\nTo find the rate at which contaminant leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $120\\,\\text{gal}$ of liquid; solution enters at $12\\,\\text{gal/min}$ and mixed solution leaves at $8\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=120+12t-8t=4(30+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of contaminant in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{4(30+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $8\\,\\text{gal/min},$ *contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(8\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(8\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{8Q}{4(30+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{30+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =15-\\frac{2Q}{30+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q=15.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(30+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|30+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(30+t)^{2}} \\\\  & =(30+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(30+t)^{2}$ yields\n\n$$\n\\begin{aligned}(30+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{30+t}\\,Q) & =(30+t)^{2}\\cdot 15 \\\\ (30+t)^{2}\\frac{dQ}{dt}+2(30+t)Q & =15(30+t)^{2} \\\\ \\frac{d}{dt}(Q(30+t)^{2}) & =15(30+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(30+t)^{2})\\,dt & =\\int 15(30+t)^{2}\\,dt \\\\ Q(30+t)^{2} & =15\\cdot \\frac{1}{3}(30+t)^{3}+C \\\\ Q(t) & =5(30+t)+\\frac{C}{(30+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $40\\,\\text{lb}$ of contaminant. So, we can apply the initial condition $Q(0)=40,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =40 \\\\ 5(30+0)+\\frac{C}{(30+0)^{2}} & =40 \\\\ 150+\\frac{C}{(30)^{2}} & =40 \\\\ \\frac{C}{{30}^{2}} & =-110 \\\\ C & =-110(30)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =5(30+t)-\\frac{110(30)^{2}}{(30+t)^{2}} \\\\  & =5(30+t)-110{(\\frac{30}{30+t})}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $180\\,\\text{gal},$ so we can use the condition $V({t}_{o})=180$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =180 \\\\ 120+12{t}_{o}-8{t}_{o} & =180 \\\\ 120+4{t}_{o} & =180 \\\\ 4{t}_{o} & =60 \\\\ {t}_{o} & =15\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of contaminant in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(15) & =5(30+15)-110{(\\frac{30}{30+15})}^{2} \\\\  & =225-110{(\\frac{30}{45})}^{2} \\\\  & ≈176.1\\,\\text{lb}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541095 1068 #edb/ref 17592186541035 13194139535913 17592186045417 true] [17592186541095 1069 "q-140823" 13194139535913 17592186045417 true] [17592186541095 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541095 1071 "$$\nA=[\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}],\\,D=[\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first column of the matrix $P.$" 13194139535913 17592186045417 true] [17592186541095 1072 #uuid "6ce9a2b1-181d-53a4-9a85-7b3316309f0d" 13194139535913 17592186045417 true] [17592186541095 1074 "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-1.$ So, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=5.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{1}=5.$ Computing $A-5I,$ we get\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}2 & 3 \\\\ 3 & 2\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 3 \\\\ 3 & -3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 3 & 0 \\\\ 3 & -3 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 3 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],\n$$\n\nwhere $‖{v}_{1}‖=\\sqrt{2}.$ Dividing ${v}_{1}$ by its norm, we obtain the first column of $P:$ \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}]\n$$" 13194139535913 17592186045417 true] [17592186541096 1068 #edb/ref 17592186541011 13194139535913 17592186045417 true] [17592186541096 1069 "q-133285" 13194139535913 17592186045417 true] [17592186541096 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541096 1071 "Calculate the horizontal velocity of the eagle as a function of time.\n\nThe horizontal velocity of the bird is$\\,$ \n{{field-1}}$\\,\\text{m/s}.$" 13194139535913 17592186045417 true] [17592186541096 1072 #uuid "6e20ee7e-741b-5069-a51c-7de25cc32da7" 13194139535913 17592186045417 true] [17592186541096 1074 "The horizontal velocity of the eagle is given by ${x}^{′}(t),$ where \n\n$$\nx(t)=\\operatorname{arctan}⁡(\\frac{t}{5}).\n$$\n\nThe formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡t)=\\frac{1}{1+{t}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡(\\frac{t}{5})) \\\\  & =\\frac{1}{1+(t/5)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}t}(\\frac{t}{5}) \\\\  & =\\frac{1}{1+{t}^{2}/25}\\cdot \\frac{1}{5} \\\\  & =\\frac{5}{25+{t}^{2}}.\\end{aligned}\n$$\n\nTherefore, the horizontal velocity of the eagle is given by the function ${x}^{′}(t)=\\frac{5}{25+{t}^{2}}\\,\\text{m/s}.$" 13194139535913 17592186045417 true] [17592186541097 1068 #edb/ref 17592186540966 13194139535913 17592186045417 true] [17592186541097 1069 "q-156055" 13194139535913 17592186045417 true] [17592186541097 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541097 1071 "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}x+3<4 \\\\ 3-2x\\le 9\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541097 1072 #uuid "6ef129d9-0a92-5a3f-b637-51eadd473818" 13194139535913 17592186045417 true] [17592186541097 1074 "To solve the system, we need to find the values of $x$ that satisfy both $x+3<4$ and $3-2x\\le 9$ simultaneously.\n\n- First, we solve $x+3<4\\,:$ \n\n$$\n\\begin{aligned}x+3 & <4 \\\\ x+3-3 & <4-3 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/c2/c20ffc0279a42a429797f42fcd929fb4dfb499e311dd3ed7b6b61fd95729953c.png)\n\n$$\n\n$$\n\n- Then, we solve $3-2x\\le 9\\,:$\n\n$$\n\\begin{aligned}3-2x & \\le 9 \\\\ 3-2x-3 & \\le 9-3 \\\\ -2x & \\le 6 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 6 \\\\ 2x & \\ge -6 \\\\ \\frac{2x}{2} & \\ge \\frac{-6}{2} \\\\ x & \\ge -3\\end{aligned}\n$$\n\n![](images/ae/ae72342a32ea8a952a3d00aec7a8ccc381804ae4b593ba58113911c4bc4b2c09.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/b7/b7d4814919a8c0b2a2ed8e130c8af2bdce5e7fd2d23d10e50e4e293d88170c2f.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in [-3,1).$" 13194139535913 17592186045417 true] [17592186541098 1068 #edb/ref 17592186541016 13194139535913 17592186045417 true] [17592186541098 1069 "q-353478" 13194139535913 17592186045417 true] [17592186541098 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541098 1071 "The number $y(t)$ of people who have adopted electric vehicles in a town follows the logistic growth model\n\n$$\n{y}^{′}=4200y-7{y}^{2},\\,y(0)=55,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible number of people who will adopt electric vehicles?\n\nThe maximum possible number of people who will adopt electric vehicles is\n{{field-1}}." 13194139535913 17592186045417 true] [17592186541098 1072 #uuid "70edaacc-f97d-53a0-9bf0-62992d59dc46" 13194139535913 17592186045417 true] [17592186541098 1074 "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible number of people who will adopt electric vehicles. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/d8/d8133f1c4203903bac606bbae61c73717e2ba2dc15a97a77f48eaaeaf4736d06.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =4200y-7{y}^{2} \\\\  & =7y(600-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=600.$ Hence, the carrying capacity is $600,$ and we conclude that the maximum possible number of people who will adopt electric vehicles is $600.$" 13194139535913 17592186045417 true] [17592186541099 1068 #edb/ref 17592186540945 13194139535913 17592186045417 true] [17592186541099 1069 "q-75039" 13194139535913 17592186045417 true] [17592186541099 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541099 1071 "Let $R=[2,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)={x}^{2}+{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{2,3,4\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139535913 17592186045417 true] [17592186541099 1072 #uuid "73bd1c38-9ed6-5451-94fd-2aa984462a1e" 13194139535913 17592186045417 true] [17592186541099 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/a3/a30d43569026cdf8f4ce960016620a725248726523abd005dbad5bc903123b9f.png)\n\nThe lower sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{21}+{m}_{12}+{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)={x}^{2}+{y}^{2}$ increases as $x$ increases, and\n\n- $f(x,y)={x}^{2}+{y}^{2}$ increases as $y$ increases.\n\n![](images/a8/a81396ee6d33b1ac10a44b6b8db2ded2612e86274e017ebe95c55420b7f73265.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/c9/c90a6e6d4c9e9a92bfd1c42b8350941b7d45f96d422e2a1988a4c003df6457e1.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(2,2)=8 \\\\ {m}_{21} & =f(3,2)=13 \\\\ {m}_{12} & =f(2,3)=13 \\\\ {m}_{22} & =f(3,3)=18\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}L(f,P) & =8+13+13+18 \\\\  & =52.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541100 1068 #edb/ref 17592186541013 13194139535913 17592186045417 true] [17592186541100 1069 "q-133290" 13194139535913 17592186045417 true] [17592186541100 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541100 1071 "At time $t=5\\,\\text{s}$ the eagle is located at a point on $C$ with $y$-coordinate equal to $\\frac{95}{3}\\,\\text{m}.$ Use the tangent line approximation to approximate the $y$-coordinate of the eagle's location when $t=\\frac{110}{23}\\,\\text{s}.$\n\n$y(\\frac{110}{23})≈$\n{{field-1}}$\\,\\text{m}$" 13194139535913 17592186045417 true] [17592186541100 1072 #uuid "742d438b-e3dc-52b0-a068-888e70c6be15" 13194139535913 17592186045417 true] [17592186541100 1074 "The tangent line approximation to $y(t)$ at the point $a=5$ is\n\n$$\n\\begin{aligned}L(t) & =y(a)+{y}^{′}(a)(t-a) \\\\  & =y(5)+{y}^{′}(5)(t-5).\\end{aligned}\n$$\n\nWe're told that $y(5)=\\frac{95}{3},$ and since ${y}^{′}(t)={t}^{2}-2,$ then ${y}^{′}(5)=25-2=23.$ \n\nSo, the tangent line approximation is given by\n\n$$\n\\begin{aligned}L(t) & =\\frac{95}{3}+23(t-5).\\end{aligned}\n$$\n\nNow, we can approximate $y(\\frac{110}{23})$ by evaluating the tangent line approximation at $x=\\frac{110}{23}.$ We get\n\n$$\n\\begin{aligned}y(\\frac{110}{23}) & ≈L(\\frac{110}{23}) \\\\  & =\\frac{95}{3}+23(\\frac{110}{23}-5) \\\\  & =\\frac{95}{3}+23(-\\frac{5}{23}) \\\\  & =\\frac{95}{3}-5 \\\\  & =\\frac{80}{3}\\,\\text{m}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541101 1068 #edb/ref 17592186540983 13194139535913 17592186045417 true] [17592186541101 1069 "q-81246" 13194139535913 17592186045417 true] [17592186541101 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541101 1071 "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-7,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=19,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A.\n$$" 13194139535913 17592186045417 true] [17592186541101 1072 #uuid "7534ff45-14c3-5354-a5be-41324d6a8d58" 13194139535913 17592186045417 true] [17592186541101 1074 "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}2f(x,y)\\text{ }\\text{d}A & =2{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =2({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =2(-7+19) \\\\  & =24\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541102 1068 #edb/ref 17592186541045 13194139535913 17592186045417 true] [17592186541102 1069 "q-288806" 13194139535913 17592186045417 true] [17592186541102 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541102 1071 "Consider the quadratic equation\n\n$$\n{x}^{2}+97x-4\\,580=0.\n$$\n\n**Without** solving the equation, determine the sum of its solutions." 13194139535913 17592186045417 true] [17592186541102 1072 #uuid "761ee71b-75fd-5326-b76e-466bf3a8a311" 13194139535913 17592186045417 true] [17592186541102 1074 "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=97,\\,c=-4\\,580.\n$$\n\nTherefore, the sum of the solutions is\n\n$$\n\\begin{aligned}-\\frac{b}{a} & =-\\frac{97}{1}=-97.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541103 1068 #edb/ref 17592186540954 13194139535913 17592186045417 true] [17592186541103 1069 "q-114342" 13194139535913 17592186045417 true] [17592186541103 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541103 1071 "Find the shortest distance between the point $(8,1)$ and the line $y=-\\frac{2}{3}x+2.$" 13194139535913 17592186045417 true] [17592186541103 1072 #uuid "777e8b7e-3aad-5700-9be0-3920699b2b4c" 13194139535913 17592186045417 true] [17592186541103 1074 "Let's draw a diagram describing our situation. \n\n![](images/52/52bfc27007c57351cdf90d88d444676266edc5d2704314db0d99fd9dca8e367f.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=-\\frac{2}{3}x+2$ and passes through the point $(8,1).$\n\n The given line has a slope of $-\\frac{2}{3},$ so our perpendicular line must have a slope of $\\frac{3}{2}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{3}{2}(x-8) \\\\ y & =\\frac{3}{2}x-12+1 \\\\ y & =\\frac{3}{2}x-11\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=-\\frac{2}{3}x+2 \\\\ y=\\frac{3}{2}x-11\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}x+2 & =\\frac{3}{2}x-11 \\\\ -\\frac{2}{3}x-\\frac{3}{2}x & =-11-2 \\\\ -\\frac{13}{6}x & =-13 \\\\ x & =6.\\end{aligned}\n$$\n\nSubstituting $x=6$ into either of the two equations gives $y=-2.$ So, our solution is $x=6$ and $y=-2.$ Therefore, the lines intersect at the point $(6,-2).$\n\nFinally, we find the distance $d$ between the points $(8,1)$ and $(6,-2):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(6-8)^{2}+(-2-1)^{2}} \\\\  & =\\sqrt{(-2)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(8,1)$ and the line $y=-\\frac{2}{3}x+2$ is $\\sqrt{13}.$" 13194139535913 17592186045417 true] [17592186541104 1068 #edb/ref 17592186540997 13194139535913 17592186045417 true] [17592186541104 1069 "q-80695" 13194139535913 17592186045417 true] [17592186541104 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541104 1071 "Determine the vertical asymptotes of $f(x)=\\frac{x-1}{(x-1)({x}^{2}-x+1)}.$" 13194139535913 17592186045417 true] [17592186541104 1072 #uuid "781bab37-c587-565a-bce8-f5952a2abc55" 13194139535913 17592186045417 true] [17592186541104 1074 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-1}{(x-1)({x}^{2}-x+1)} \\\\  & =\\frac{\\cancel{x-1}}{\\cancel{(x-1)}({x}^{2}-x+1)} \\\\  & =\\frac{1}{{x}^{2}-x+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}-x+1=0\n$$\n\nThe last equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-1)^{2}-4(1)(1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes." 13194139535913 17592186045417 true] [17592186541105 1068 #edb/ref 17592186540996 13194139535913 17592186045417 true] [17592186541105 1069 "q-140416" 13194139535913 17592186045417 true] [17592186541105 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541105 1071 "Evaluate ${lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6}.$" 13194139535913 17592186045417 true] [17592186541105 1072 #uuid "7aab1343-37d9-52dc-ba1f-d0f44020bf1c" 13194139535913 17592186045417 true] [17592186541105 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{3}^{3}-27}{2(3)-6}=\\frac{27-27}{6-6}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the numerator is a difference of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{x}^{3}-{3}^{3}}{2(x-3)} \\\\  & =\\frac{(x-3)({x}^{2}+3x+{3}^{2})}{2(x-3)} \\\\  & =\\frac{{x}^{2}+3x+9}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & ={lim}_{x\\to 3}\\frac{{x}^{2}+3x+9}{2} \\\\  & =\\frac{{3}^{2}+3(3)+9}{2} \\\\  & =\\frac{9+9+9}{2} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541106 1068 #edb/ref 17592186541023 13194139535913 17592186045417 true] [17592186541106 1069 "q-223687" 13194139535913 17592186045417 true] [17592186541106 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541106 1071 "The axis of symmetry of the parabola $y=(3x+7)(2x-k)$ is $x=-\\frac{5}{12}.$ Find the value of $k.$\n\n$k=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541106 1072 #uuid "7cce9f3f-dd06-554c-bd43-11f02acc9108" 13194139535913 17592186045417 true] [17592186541106 1074 "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=-\\frac{5}{12},$ we will set our result equal to $-\\frac{5}{12}.$ \n\nFrom the equation $y=(3x+7)(2x-k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{7}{3}$ and ${x}_{2}=\\frac{k}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{7}{3}+\\frac{k}{2})}{2} \\\\  & =\\frac{(-\\frac{14}{6}+\\frac{3k}{6})}{2} \\\\  & =\\frac{3k-14}{12}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=-\\frac{5}{12}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{3k-14}{12} & =-\\frac{5}{12} \\\\ 3k-14 & =-5 \\\\ 3k & =9 \\\\ k & =3.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541107 1068 #edb/ref 17592186540947 13194139535913 17592186045417 true] [17592186541107 1069 "q-94255" 13194139535913 17592186045417 true] [17592186541107 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541107 1071 "$$\nP=[\\begin{aligned}\\frac{3}{7} & \\,∗\\, & -\\frac{2}{7} \\\\ \\frac{6}{7} & \\,∗\\, & \\frac{3}{7} \\\\ \\frac{2}{7} & \\,∗\\, & -\\frac{6}{7}\\end{aligned}]\n$$\n\nConsider the matrix $P$ shown above. Given that $A=PD{P}^{T}$ is an orthogonal diagonalization of a $3\\times 3$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the second column of the matrix $P?$" 13194139535913 17592186045417 true] [17592186541107 1072 #uuid "8014f4b5-d696-5a4e-9a7f-b8b8bdffa3fa" 13194139535913 17592186045417 true] [17592186541107 1074 "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix.\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nSince  $A=PD{P}^{T}$ is an orthogonal diagonalization of a $3\\times 3$ symmetric matrix $A,$ the matrix $P$ must be a $3\\times 3$ orthogonal matrix. This means that \n\n- the second column must be orthogonal to the first and third columns, and\n\n- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $[\\begin{aligned}-\\frac{6}{7} \\\\ \\frac{2}{7} \\\\ \\frac{3}{7}\\end{aligned}]$ has both properties." 13194139535913 17592186045417 true] [17592186541108 1068 #edb/ref 17592186541017 13194139535913 17592186045417 true] [17592186541108 1069 "q-133291" 13194139535913 17592186045417 true] [17592186541108 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541108 1071 "Find $y(t),$ the antiderivative of ${y}^{′}(t).$\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" 13194139535913 17592186045417 true] [17592186541108 1072 #uuid "836e24be-b58e-500b-bb05-e9b2030ce5e6" 13194139535913 17592186045417 true] [17592186541108 1074 "We know that ${y}^{′}(t)={t}^{2}-2.$\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {t}^{2}-2\\,\\text{d}t & =\\int {t}^{2}\\,\\text{d}t-\\int 2\\,\\text{d}t \\\\  & =\\int {t}^{2}\\,\\text{d}t-2\\int {t}^{0}\\,\\text{d}t \\\\  & =(\\frac{{t}^{2+1}}{2+1})-2t+C \\\\  & =\\frac{1}{3}{t}^{3}-2t+C.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541109 1068 #edb/ref 17592186541024 13194139535913 17592186045417 true] [17592186541109 1069 "q-352264" 13194139535913 17592186045417 true] [17592186541109 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541109 1071 "Consider the finite region bounded by the curve $y=4{x}^{2}-{x}^{3}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541109 1072 #uuid "845bcab8-f4ff-59be-a2f2-b0d273cf58d7" 13194139535913 17592186045417 true] [17592186541109 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}4{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(4-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=4.$ So, we need to integrate from $x=0$ to $x=4.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}x(4{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}(4{x}^{3}-{x}^{4})\\text{d}x \\\\  & =2\\pi {({x}^{4}-\\frac{{x}^{5}}{5})|}_{0}^{4} \\\\  & =2\\pi [({4}^{4}-\\frac{{4}^{5}}{5})-0] \\\\  & =2\\pi (256-\\frac{1024}{5}) \\\\  & =\\frac{512\\pi }{5}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541110 1068 #edb/ref 17592186540951 13194139535913 17592186045417 true] [17592186541110 1069 "q-122966" 13194139535913 17592186045417 true] [17592186541110 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541110 1071 "Let $R=[1,3]\\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y)=11-{x}^{2}-y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3\\},\\,{P}_{2}=\\{0,1,2\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139535913 17592186045417 true] [17592186541110 1072 #uuid "8ad4ccbd-e338-5550-8a1d-a1b82832243e" 13194139535913 17592186045417 true] [17592186541110 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/3b/3be0ba3fa44ba61e0b55500e588387cd087b8d2f2687c5636c9b053f1f8dc5d6.png)\n\nThe lower Riemann sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the minimum value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{21}+{m}_{12}+{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=11-{x}^{2}-y$ decreases as $x$ increases, and\n\n- $f(x,y)=11-{x}^{2}-y$ decreases as $y$ increases.\n\n![](images/9f/9fa44875a37e8c7b7bc69b175ac1f30fe73af936565e68ecaa82e02b7617b330.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/59/595d13ca8ec18056038a855e96ca4a3d8cc967182dae5c54b9746c731238413b.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(2,1)=6 \\\\ {m}_{21} & =f(3,1)=1 \\\\ {m}_{12} & =f(2,2)=5 \\\\ {m}_{22} & =f(3,2)=0\\end{aligned}\n$$\n\nFinally,\n\n$$\nL(f,P)=6+1+5+0=12.\n$$" 13194139535913 17592186045417 true] [17592186541111 1068 #edb/ref 17592186541006 13194139535913 17592186045417 true] [17592186541111 1069 "q-288852" 13194139535913 17592186045417 true] [17592186541111 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541111 1071 "The quadratic coefficient of a particular quadratic equation equals $1.$ The sum of the solutions equals $4,$ and the product of the solutions equals $-45.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" 13194139535913 17592186045417 true] [17592186541111 1072 #uuid "94608b8e-9dc6-5162-993f-c6b1291dcd79" 13194139535913 17592186045417 true] [17592186541111 1074 "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $1.$ Therefore, we have\n\n$$\na=1.\n$$\n\n- We're told that the sum of the roots equals $4.$ Therefore, we have\n\n$$\n\\begin{aligned}4 & =-\\frac{b}{a} \\\\ 4 & =-\\frac{b}{1} \\\\ -4 & =b \\\\ b & =-4.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $-45.$ Therefore, we have\n\n$$\n\\begin{aligned}-45 & =\\frac{c}{a} \\\\ -45 & =\\frac{c}{1} \\\\ c & =-45.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=1,\\,b=-4,\\,c=-45\n$$\n\nand the equation is\n\n$$\n{x}^{2}-4x-45=0.\n$$" 13194139535913 17592186045417 true] [17592186541112 1068 #edb/ref 17592186540960 13194139535913 17592186045417 true] [17592186541112 1069 "q-133286" 13194139535913 17592186045417 true] [17592186541112 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541112 1071 "The vertical velocity of the eagle increases at a rate proportional to the square of the time $t.$ In addition, the eagle loses $2\\,\\text{m/s}$ in the positive $y$-direction due to wind resistance. It is known that the eagle's vertical velocity equals $2\\,\\text{m}/\\text{s}$ when $t=2\\,\\text{s}.$\n\nThe differential equation that describes the eagle's vertical velocity is ${y}^{′}(t)=$\n{{field-1}}." 13194139535913 17592186045417 true] [17592186541112 1072 #uuid "95631ad4-7573-5741-9c54-4f854208188c" 13194139535913 17592186045417 true] [17592186541112 1074 "The vertical velocity increases proportionally with ${t}^{2}$ and decreases by $2.$ The differential equation that describes this is\n\n$$\n{y}^{′}(t)=k{t}^{2}-2,\n$$\n\nwhere $k$ is a (positive) constant of proportionality.\n\nSince ${y}^{′}(2)=2,$ we can solve for $k:$\n\n$$\n\\begin{aligned}{y}^{′}(2) & =2 \\\\ k(2)^{2}-2 & =2 \\\\ 4k & =4 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the differential equation is\n\n$$\n{y}^{′}(t)={t}^{2}-2.\n$$" 13194139535913 17592186045417 true] [17592186541113 1068 #edb/ref 17592186540985 13194139535913 17592186045417 true] [17592186541113 1069 "q-53354" 13194139535913 17592186045417 true] [17592186541113 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541113 1071 "![](images/e3/e3093210c2f9523999c06ffe4e03606531e81707b798bbc7278d7b28cdfe4e25.png)\n\nThe triangle $T$ is mapped to the triangle ${T}^{′}$ under the action of a reflection. What is the equation of the line of reflection?" 13194139535913 17592186045417 true] [17592186541113 1072 #uuid "982b9ee4-2f8e-53f9-befc-0859353e9231" 13194139535913 17592186045417 true] [17592186541113 1074 "The line of reflection is the perpendicular bisector of the segments joining each point to its image. \n\nTherefore, the line of reflection is $y=-2,$ as shown below.\n\n![](images/7b/7b77cd63f7a93a62576846ad92b5ce2bcc1853137c5f582de42c2ebce4001892.png)" 13194139535913 17592186045417 true] [17592186541114 1068 #edb/ref 17592186541022 13194139535913 17592186045417 true] [17592186541114 1069 "q-333069" 13194139535913 17592186045417 true] [17592186541114 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541114 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t)+4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{2}(t)+1,\\end{aligned}\\,x(0)=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}} $,\\,$\n${X}_{2}(s)=\\frac{3s+1}{s(s+2)}$ ." 13194139535913 17592186045417 true] [17592186541114 1072 #uuid "9ca91093-1f1e-55da-a457-e3e1666bf899" 13194139535913 17592186045417 true] [17592186541114 1074 "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{-{x}_{1}(t)+4{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{2}(t)+1\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=-L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{2}(t)\\}+L\\{1\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+1=-{X}_{1}(s)+4{X}_{2}(s) \\\\ s{X}_{2}(s)-3=-2{X}_{2}(s)+\\frac{1}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the second equation for ${X}_{2}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{2}(s)-3 & =-2{X}_{2}(s)+\\frac{1}{s} \\\\ (s+2){X}_{2}(s) & =3+\\frac{1}{s} \\\\ (s+2){X}_{2}(s) & =\\frac{3s+1}{s} \\\\ {X}_{2}(s) & =\\frac{3s+1}{s(s+2)}.\\end{aligned}\n$$\n\nSubstituting this in the first equation and solving for ${X}_{1}(s)$, we have\n\n$$\n\\begin{aligned}s{X}_{1}(s)+1 & =-{X}_{1}(s)+4{X}_{2}(s) \\\\ (s+1){X}_{1}(s) & =4{X}_{2}(s)-1 \\\\ (s+1){X}_{1}(s) & =4(\\frac{3s+1}{s(s+2)})-1 \\\\ (s+1){X}_{1}(s) & =\\frac{4(3s+1)-s(s+2)}{s(s+2)} \\\\ (s+1){X}_{1}(s) & =\\frac{12s+4-({s}^{2}+2s)}{s(s+2)} \\\\ (s+1){X}_{1}(s) & =\\frac{-{s}^{2}+10s+4}{s(s+2)} \\\\ {X}_{1}(s) & =\\frac{-{s}^{2}+10s+4}{s(s+2)(s+1)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{-{s}^{2}+10s+4}{s(s+1)(s+2)},\\,{X}_{2}(s)=\\frac{3s+1}{s(s+2)}.\n$$" 13194139535913 17592186045417 true] [17592186541115 1068 #edb/ref 17592186541051 13194139535913 17592186045417 true] [17592186541115 1069 "q-113672" 13194139535913 17592186045417 true] [17592186541115 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541115 1071 "Find the antiderivative of ${x}^{4/5}.$" 13194139535913 17592186045417 true] [17592186541115 1072 #uuid "9e0b25f6-0e44-56a6-a167-f47173302a18" 13194139535913 17592186045417 true] [17592186541115 1074 "We can apply the power rule with $n=\\frac{4}{5}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{4/5}\\,\\text{d}x & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}+C \\\\  & =\\frac{{x}^{9/5}}{(\\frac{9}{5})}+C \\\\  & =\\frac{5{x}^{9/5}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{9/5}}{9})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 & = \\\\ \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} & = \\\\ {x}^{4/5}\\,✓\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541116 1068 #edb/ref 17592186540971 13194139535913 17592186045417 true] [17592186541116 1069 "q-24855" 13194139535913 17592186045417 true] [17592186541116 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541116 1071 "![](images/a8/a8b1d42dd086ff74623c24989fd993c2946857e1744988135c6cdb18d9985b7f.png)\n\nFind the axis of symmetry for the parabola sketched above." 13194139535913 17592186045417 true] [17592186541116 1072 #uuid "9fc55d0a-3a99-52a9-a6f3-6f933c42885c" 13194139535913 17592186045417 true] [17592186541116 1074 "From the graph, we deduce that the roots are ${x}_{1}=-2$ and ${x}_{2}=3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{(-2)+3}{2}=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{2}.$" 13194139535913 17592186045417 true] [17592186541117 1068 #edb/ref 17592186540952 13194139535913 17592186045417 true] [17592186541117 1069 "q-352258" 13194139535913 17592186045417 true] [17592186541117 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541117 1071 "Consider the finite region bounded by the curve $y=-6+5x-{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541117 1072 #uuid "a0beb016-ee67-53e9-a1ae-c396296738c8" 13194139535913 17592186045417 true] [17592186541117 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}-6+5x-{x}^{2} & =0 \\\\ (x-2)(x-3) & =0\\end{aligned}\n$$\n\nThe solutions are $x=2$ and $x=3.$ So, we need to integrate from $x=2$ to $x=3.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{2}^{3}x(-6+5x-{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{2}^{3}(-6x+5{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {(-3{x}^{2}+\\frac{5}{3}{x}^{3}-\\frac{1}{4}{x}^{4})|}_{2}^{3} \\\\  & =2\\pi [(-3(3)^{2}+\\frac{5(3)^{3}}{3}-\\frac{{3}^{4}}{4})-(-3(2)^{2}+\\frac{5(2)^{3}}{3}-\\frac{{2}^{4}}{4})] \\\\  & =2\\pi (\\frac{5}{12}) \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541118 1068 #edb/ref 17592186540950 13194139535913 17592186045417 true] [17592186541118 1069 "q-327807" 13194139535913 17592186045417 true] [17592186541118 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541118 1071 "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\sqrt{2}\\operatorname{cos}⁡\\theta ,\\,y=3\\sqrt{7}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" 13194139535913 17592186045417 true] [17592186541118 1072 #uuid "b0a23b4a-b8a9-57f6-be01-ea66f5dec94e" 13194139535913 17592186045417 true] [17592186541118 1074 "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\sqrt{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{5\\sqrt{2}} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{(5\\sqrt{2})^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{50} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{7}\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{3\\sqrt{7}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{(3\\sqrt{7})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{63} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}=1.\n$$" 13194139535913 17592186045417 true] [17592186541119 1068 #edb/ref 17592186541047 13194139535913 17592186045417 true] [17592186541119 1069 "q-39806" 13194139535913 17592186045417 true] [17592186541119 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541119 1071 "Calculate the vertical asymptotes of $f(x)=\\frac{2{x}^{3}}{x(x-3)^{3}}.$" 13194139535913 17592186045417 true] [17592186541119 1072 #uuid "b35c6507-ab8b-56e8-83d7-4c48d4acc5bc" 13194139535913 17592186045417 true] [17592186541119 1074 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{3}}{x(x-3)^{3}} \\\\  & =\\frac{2x\\cdot {x}^{2}}{x(x-3)^{3}} \\\\  & =\\frac{2\\cancel{x}\\cdot {x}^{2}}{\\cancel{x}(x-3)^{3}} \\\\  & =\\frac{2{x}^{2}}{(x-3)^{3}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x-3)^{3}=0\n$$\n\nThis gives the solution $x=3.$ Therefore, $x=3$ is the only vertical asymptote." 13194139535913 17592186045417 true] [17592186541120 1068 #edb/ref 17592186540994 13194139535913 17592186045417 true] [17592186541120 1069 "q-279714" 13194139535913 17592186045417 true] [17592186541120 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541120 1071 "If $X∼B(5,\\frac{2}{3}),$  then, **rounded to $3$ decimal places**, $P(3\\le X<5)≈${{field-1}}." 13194139535913 17592186045417 true] [17592186541120 1072 #uuid "b40e7c83-4aaa-5842-b161-090408598820" 13194139535913 17592186045417 true] [17592186541120 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{3})}^{x}{(\\frac{1}{3})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3\\le X<5) & =P(X\\in \\{3,4\\}) \\\\  & =f(3)+f(4) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{3}){(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{5-3}+(\\genfrac{}{}{0pt}{}{5}{4}){(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{5-4} \\\\  & =10{(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{2}+5{(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{1} \\\\  & ≈0.658\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139535913 17592186045417 true] [17592186541121 1068 #edb/ref 17592186541002 13194139535913 17592186045417 true] [17592186541121 1069 "q-72662" 13194139535913 17592186045417 true] [17592186541121 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541121 1071 "Simplify $\\frac{{n}^{8}}{{n}^{-5}}.$" 13194139535913 17592186045417 true] [17592186541121 1072 #uuid "b49d548d-fbc0-53b0-baae-b58e91b84e6d" 13194139535913 17592186045417 true] [17592186541121 1074 "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{n}^{8}}{{n}^{-5}} & = \\\\ {n}^{8-(-5)} & = \\\\ {n}^{8+5} & = \\\\ {n}^{13}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541122 1068 #edb/ref 17592186541008 13194139535913 17592186045417 true] [17592186541122 1069 "q-223671" 13194139535913 17592186045417 true] [17592186541122 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541122 1071 "The axis of symmetry of the parabola $y=-(x+7)(2x-5)$ is $x=${{field-1}}." 13194139535913 17592186045417 true] [17592186541122 1072 #uuid "b506000a-3cca-5384-98ce-1df2cd5d8561" 13194139535913 17592186045417 true] [17592186541122 1074 "From the equation $y=-(x+7)(2x-5),$ we find that the roots of the parabola are ${x}_{1}=-7$ and ${x}_{2}=\\frac{5}{2}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-7+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{14}{2}+\\frac{5}{2})}{2} \\\\  & =\\frac{(-\\frac{9}{2})}{2} \\\\  & =-\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=-\\frac{9}{4}.$" 13194139535913 17592186045417 true] [17592186541123 1068 #edb/ref 17592186540999 13194139535913 17592186045417 true] [17592186541123 1069 "q-336744" 13194139535913 17592186045417 true] [17592186541123 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541123 1071 "A fermentation tank initially holds $180\\,\\text{L}$ of liquid containing $5\\,\\text{kg}$ of dissolved nutrient.\nA solution containing $0.04\\,\\text{kg/L}$ of dissolved nutrient is pumped into the tank at a rate of $20\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $30\\,\\text{L/min}.$ If the amount of nutrient $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins is given by\n\n$$\nQ(t)=\\alpha \\,(1-\\frac{t}{18})+\\beta {(1-\\frac{t}{18})}^{3}\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants, what is the value of $\\alpha -\\beta ?$" 13194139535913 17592186045417 true] [17592186541123 1072 #uuid "b6915e10-1543-50b0-a358-2c56a1366444" 13194139535913 17592186045417 true] [17592186541123 1074 "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which minerals enter the tank minus the rate at which minerals leave the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which minerals enter the tank.\n\nFirst, note that a water solution containing $0.04\\,\\text{kg/L}$ of minerals enters the tank at a rate of $20\\,\\text{L/min}.$ So, the rate at which the *minerals* enter the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (20\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.8\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which minerals exit the tank.\n\nTo find the rate at which minerals leave the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $180\\,\\text{L}$ of liquid; a solution enters at $20\\,\\text{L/min}$ and leaves at $30\\,\\text{L/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\n180+20t-30t=(180-10t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of minerals in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{180-10t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $30\\,\\text{L/min},$ *minerals* leave at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(30\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{180-10t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(30\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{180-10t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{30Q}{180-10t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{3Q}{18-t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.8-\\frac{3Q}{18-t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{3}{18-t}Q=0.8.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 3/(18-t)\\,dt} \\\\  & ={e}^{-3\\operatorname{ln}⁡|18-t|} \\\\  & ={e}^{\\operatorname{ln}⁡(18-t)^{-3}} \\\\  & =(18-t)^{-3}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(18-t)^{-3}$ yields\n\n$$\n\\begin{aligned}(18-t)^{-3}\\cdot (\\frac{dQ}{dt}+\\frac{3}{18-t}Q) & =(18-t)^{-3}\\cdot 0.8 \\\\ (18-t)^{-3}\\frac{dQ}{dt}+3(18-t)^{-4}Q & =0.8(18-t)^{-3} \\\\ \\frac{d}{dt}(Q(18-t)^{-3}) & =0.8(18-t)^{-3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(18-t)^{-3})\\,dt & =\\int 0.8(18-t)^{-3}\\,dt \\\\ Q(18-t)^{-3} & =0.8\\cdot \\frac{1}{2}(18-t)^{-2}+C \\\\ Q(t) & =0.4(18-t)+C(18-t)^{3}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $5\\,\\text{kg}$ of minerals. So, we can apply the initial condition $Q(0)=5,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =5 \\\\ C(18-0)^{3}+0.4(18-0) & =5 \\\\ C(18)^{3}+7.2 & =5 \\\\ C & =-\\frac{2.2}{{18}^{3}}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.4(18-t)-\\frac{2.2}{{18}^{3}}(18-t)^{3} \\\\  & =0.4\\cdot 18\\,(\\frac{18-t}{18})-2.2{(\\frac{18-t}{18})}^{3} \\\\  & =7.2\\,(1-\\frac{t}{18})-2.2{(1-\\frac{t}{18})}^{3}.\\end{aligned}\n$$\n\nFinally, we have $\\alpha =7.2,\\beta =-2.2,$ and\n\n$$\n\\alpha -\\beta =7.2-(-2.2)=9.4.\n$$" 13194139535913 17592186045417 true] [17592186541124 1068 #edb/ref 17592186540980 13194139535913 17592186045417 true] [17592186541124 1068 #edb/ref 17592186541029 13194139535913 17592186045417 true] [17592186541124 1069 "q-334926" 13194139535913 17592186045417 true] [17592186541124 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541124 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">$3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-{e}^{2s}\\operatorname{sin}⁡(2(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" 13194139535913 17592186045417 true] [17592186541124 1072 #uuid "b6b0c13d-ace9-58a0-a5ae-835939f481e0" 13194139535913 17592186045417 true] [17592186541124 1074 "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-1)) & \\operatorname{sin}⁡(2(t-1)) \\\\ -\\operatorname{sin}⁡(2(t-1)) & \\operatorname{cos}⁡(2(t-1))\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1)) \\\\ -3\\operatorname{sin}⁡(2(t-1))+\\operatorname{cos}⁡(2(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}][\\begin{aligned}{e}^{2s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2s}\\operatorname{cos}⁡(2(t-s)) \\\\ -{e}^{2s}\\operatorname{sin}⁡(2(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}3\\operatorname{cos}⁡(2(t-1))+\\operatorname{sin}⁡(2(t-1)) \\\\ -3\\operatorname{sin}⁡(2(t-1))+\\operatorname{cos}⁡(2(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{2s}\\operatorname{cos}⁡(2(t-s)) \\\\ -{e}^{2s}\\operatorname{sin}⁡(2(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541125 1068 #edb/ref 17592186540958 13194139535913 17592186045417 true] [17592186541125 1068 #edb/ref 17592186541036 13194139535913 17592186045417 true] [17592186541125 1069 "q-326265" 13194139535913 17592186045417 true] [17592186541125 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541125 1071 "![](images/bb/bbfc3c75c4dfeb96b6c17e8b3991238bfedde590297bbb551a0386b0a9508d00.png)\n\nConsider the ellipse centered at the origin with horizontal radius $10$ and vertical radius $4,$ as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the ellipse once in the counterclockwise direction starting at the point $I(10,0).$\n\n$x=$ \n{{field-1}}$,\\,y=$ \n{{field-2}}$,\\,\\theta \\in [0,2\\pi ).$" 13194139535913 17592186045417 true] [17592186541125 1072 #uuid "bb1128f6-3c64-5af7-8173-a16416a853a8" 13194139535913 17592186045417 true] [17592186541125 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(a,0).$\n\nIn our case, $a=10$ and $b=4.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=10\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541126 1068 #edb/ref 17592186540984 13194139535913 17592186045417 true] [17592186541126 1069 "q-279683" 13194139535913 17592186045417 true] [17592186541126 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541126 1071 "If $X∼B(5,\\frac{2}{5}),$ then, **rounded to $3$ decimal places**, $P(X\\le 1)≈${{field-1}}." 13194139535913 17592186045417 true] [17592186541126 1072 #uuid "bf9b3381-1894-58e7-8430-4bb3204c16fe" 13194139535913 17592186045417 true] [17592186541126 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{5}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{5})}^{x}{(\\frac{3}{5})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{5-1} \\\\  & =1{(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5}+5{(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{4} \\\\  & =0.337\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139535913 17592186045417 true] [17592186541127 1068 #edb/ref 17592186541004 13194139535913 17592186045417 true] [17592186541127 1069 "q-30456" 13194139535913 17592186045417 true] [17592186541127 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541127 1071 "Find the axis of symmetry for the parabola $y=(x-6)(x+3).$" 13194139535913 17592186045417 true] [17592186541127 1072 #uuid "bfbab0dc-48e0-5fe1-b79b-211af0a386b9" 13194139535913 17592186045417 true] [17592186541127 1074 "From the equation $y=(x-6)(x+3),$ we find that the roots of the parabola are ${x}_{1}=6$ and ${x}_{2}=-3.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{6+(-3)}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{3}{2}.$" 13194139535913 17592186045417 true] [17592186541128 1068 #edb/ref 17592186540961 13194139535913 17592186045417 true] [17592186541128 1068 #edb/ref 17592186540978 13194139535913 17592186045417 true] [17592186541128 1069 "q-133294" 13194139535913 17592186045417 true] [17592186541128 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541128 1071 "${r}^{′}(\\sqrt{5})=\\,$$⟨$\n{{field-1}}\n$,$\n{{field-2}}\n$⟩$" 13194139535913 17592186045417 true] [17592186541128 1072 #uuid "c1baae25-37ff-504a-9b40-31c45e15f352" 13194139535913 17592186045417 true] [17592186541128 1074 "We differentiate each component separately.\n\n* For the $x$-component, we have\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\n$$\n\nand therefore,\n\n$$\n{x}^{′}(\\sqrt{5})=\\frac{5}{25+(\\sqrt{5})^{2}}=\\frac{1}{6}.\n$$\n\n* For the $y$-component, we have\n\n$$\n{y}^{′}(t)={t}^{2}-2,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(\\sqrt{5})=(\\sqrt{5})^{2}-2=3.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(\\sqrt{5}) & =⟨{x}^{′}(\\sqrt{5}),{y}^{′}(\\sqrt{5})⟩ \\\\  & =⟨\\frac{1}{6},3⟩.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541129 1068 #edb/ref 17592186540942 13194139535913 17592186045417 true] [17592186541129 1069 "q-107041" 13194139535913 17592186045417 true] [17592186541129 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541129 1071 "Evaluate ${lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15}.$" 13194139535913 17592186045417 true] [17592186541129 1072 #uuid "c1e71946-3589-5a14-87c2-2599e8aef444" 13194139535913 17592186045417 true] [17592186541129 1074 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{{5}^{2}-5(5)}{{5}^{2}-8(5)+15}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{x(x-5)}{(x-5)(x-3)} \\\\  & =\\frac{x}{x-3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & ={lim}_{x\\to 5}\\frac{x}{x-3} \\\\  & =\\frac{5}{5-3} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541130 1068 #edb/ref 17592186540992 13194139535913 17592186045417 true] [17592186541130 1069 "q-97507" 13194139535913 17592186045417 true] [17592186541130 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541130 1071 "Given that $X∼B(7,0.3),$ compute $P(X>5).$ Round your final answer to $4$ decimal places." 13194139535913 17592186045417 true] [17592186541130 1072 #uuid "ca88d8b7-77e6-50f5-9c7d-7baae6691eb5" 13194139535913 17592186045417 true] [17592186541130 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.3)^{x}(0.7)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>5) & =P(X\\in \\{6,7\\}) \\\\  & =f(6)+f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{6})(0.3)^{6}(0.7)^{7-6}+(\\genfrac{}{}{0pt}{}{7}{7})(0.3)^{7}(0.7)^{7-7} \\\\  & =7(0.3)^{6}(0.7)+1(0.3)^{7}(0.7)^{0} \\\\  & ≈0.0038\\end{aligned}\n$$\n\nto $4$ decimal places." 13194139535913 17592186045417 true] [17592186541131 1068 #edb/ref 17592186541010 13194139535913 17592186045417 true] [17592186541131 1069 "q-281207" 13194139535913 17592186045417 true] [17592186541131 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541131 1071 "If $X∼B(8,0.7),$ then, **rounded to $3$ decimal places**, $P(X\\le 6)≈${{field-1}}." 13194139535913 17592186045417 true] [17592186541131 1072 #uuid "ca99c1c6-d952-5e5e-a558-22163d61daf7" 13194139535913 17592186045417 true] [17592186541131 1074 "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(8,0.7),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{8}{x}){(0.7)}^{x}{(0.3)}^{8-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,8,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in \\{7,8\\}) \\\\  & =f(7)+f(8) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{7}){(0.7)}^{7}{(0.3)}^{8-7}+(\\genfrac{}{}{0pt}{}{8}{8}){(0.7)}^{8}{(0.3)}^{8-8} \\\\  & =8{(0.7)}^{7}{(0.3)}^{1}+1{(0.7)}^{8}{(0.3)}^{0} \\\\  & ≈0.255\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.255 \\\\  & =0.745\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139535913 17592186045417 true] [17592186541132 1068 #edb/ref 17592186540982 13194139535913 17592186045417 true] [17592186541132 1069 "q-72663" 13194139535913 17592186045417 true] [17592186541132 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541132 1071 "Simplify $\\frac{{s}^{9}}{{s}^{-1}}.$" 13194139535913 17592186045417 true] [17592186541132 1072 #uuid "cd8ebbf6-3c12-5a7b-94b3-133315a02160" 13194139535913 17592186045417 true] [17592186541132 1074 "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{s}^{9}}{{s}^{-1}} & = \\\\ {s}^{9-(-1)} & = \\\\ {s}^{9+1} & = \\\\ {s}^{10}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541133 1068 #edb/ref 17592186541039 13194139535913 17592186045417 true] [17592186541133 1069 "q-122886" 13194139535913 17592186045417 true] [17592186541133 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541133 1071 "![](images/c9/c9544b511212f20620d516a6f14fcfa1d812a0119cc14f8741d113c6cb663961.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" 13194139535913 17592186045417 true] [17592186541133 1072 #uuid "cde06bdc-b497-5379-91e5-90582a7fb14e" 13194139535913 17592186045417 true] [17592186541133 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=1,\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=2.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =1\\cdot {m}_{11}+1\\cdot {m}_{21}+2\\cdot {m}_{12}+2\\cdot {m}_{22} \\\\  & ={m}_{11}+{m}_{21}+2{m}_{12}+2{m}_{22}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541134 1068 #edb/ref 17592186541049 13194139535913 17592186045417 true] [17592186541134 1069 "q-139184" 13194139535913 17592186045417 true] [17592186541134 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541134 1071 "![](images/51/51143fcae2b39d210e9274fd26363dfdc5cc72e289aea9f524f34f0e92b82b09.png)\n\nConsider the finite region bounded by the curve $y=2{x}^{3}-{x}^{4}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" 13194139535913 17592186045417 true] [17592186541134 1072 #uuid "ce012b33-e22a-528a-bd43-8ae57ebb53bf" 13194139535913 17592186045417 true] [17592186541134 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}2{x}^{3}-{x}^{4} & =0 \\\\ {x}^{4}-2{x}^{3} & =0 \\\\ {x}^{3}(2-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(2{x}^{3}-{x}^{4})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}(2{x}^{4}-{x}^{5})\\text{d}x\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541135 1068 #edb/ref 17592186540965 13194139535913 17592186045417 true] [17592186541135 1069 "q-122885" 13194139535913 17592186045417 true] [17592186541135 1070 #edb/ref 17592186045486 13194139535913 17592186045417 true] [17592186541135 1071 "![](images/b0/b00e13fc7b827b9c3960073679ee651f6bce5a6193e0b0af1907738691a287ed.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" 13194139535913 17592186045417 true] [17592186541135 1072 #uuid "cfbdcb48-ce24-5aa4-b673-ed006db801e9" 13194139535913 17592186045417 true] [17592186541135 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $3$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=1,\n$$\n\n$$\n\\text{Area}({R}_{21})=3,\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=2.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =1\\cdot {m}_{11}+3\\cdot {m}_{21}+2\\cdot {m}_{12} \\\\  & ={m}_{11}+3{m}_{21}+2{m}_{12}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541136 1068 #edb/ref 17592186540953 13194139535913 17592186045417 true] [17592186541136 1069 "q-94343" 13194139535913 17592186045417 true] [17592186541136 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541136 1071 "$$\nA=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 2 & -2\\end{aligned}],\\,D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -3\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first and second columns of the matrix $P?$" 13194139535913 17592186045417 true] [17592186541136 1072 #uuid "d509446a-8a97-556c-a812-ab4e4c09b27f" 13194139535913 17592186045417 true] [17592186541136 1074 "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=2,$ ${\\lambda }_{2}=2,$ and ${\\lambda }_{3}=-3.$ So, the first and second columns of $P$ correspond to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2}.$ \n\nNow, we need to find  eigenvectors that correspond to ${\\lambda }_{1}={\\lambda }_{2}=2.$ Computing $A-2I,$ we get\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 2 & -2\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives two eigenvectors: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]$\n\nNotice that eigenvectors ${v}_{1}$ and ${v}_{2}$ are  orthogonal. So, we divide ${v}_{1}$ and ${v}_{2}$ by their respective norms, to obtain the first and second columns of $P:$  \n\n$$\n\\begin{aligned}\\frac{{v}_{1}}{‖{v}_{1}‖} & =[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ \\frac{{v}_{2}}{‖{v}_{2}‖} & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ \\frac{2\\sqrt{5}}{5} \\\\ \\frac{\\sqrt{5}}{5}\\end{aligned}]\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541137 1068 #edb/ref 17592186541042 13194139535913 17592186045417 true] [17592186541137 1069 "q-124785" 13194139535913 17592186045417 true] [17592186541137 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541137 1071 "![](images/ca/ca003331d04113119019996f15296ec2ab16fa0c14227a12f5f421c4c4103746.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{3},$ use the Pythagorean identity to find $\\operatorname{cot}⁡\\theta .$" 13194139535913 17592186045417 true] [17592186541137 1072 #uuid "d952daa8-27a5-56d3-8d17-8e3ce2fc3807" 13194139535913 17592186045417 true] [17592186541137 1074 "![](images/f0/f0c1c9df42fc2ed772353baec0f81e796485d8bf3c1cd9dde234e74e39a04c56.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{3}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{2}}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{9}} \\\\  & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{7}}{3}$\n\nKnowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{cot}⁡\\theta =\\frac{(\\frac{\\sqrt{7}}{3})}{(\\frac{\\sqrt{2}}{3})}=\\frac{\\sqrt{7}}{\\sqrt{2}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡\\theta  & =\\frac{\\sqrt{7}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7}}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{7\\cdot 2}}{2} \\\\  & =\\frac{\\sqrt{14}}{2}\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541138 1068 #edb/ref 17592186540956 13194139535913 17592186045417 true] [17592186541138 1069 "q-6890" 13194139535913 17592186045417 true] [17592186541138 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541138 1071 "![](images/ba/baa8ce8fbfb4ed3acb3a9de52901b80e6acf81613e0c98ed04082fec3f653c0f.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" 13194139535913 17592186045417 true] [17592186541138 1072 #uuid "d9617ffa-95a5-5cf0-b858-c34d537f0472" 13194139535913 17592186045417 true] [17592186541138 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=2$ and $b=3.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541139 1068 #edb/ref 17592186541050 13194139535913 17592186045417 true] [17592186541139 1069 "q-102547" 13194139535913 17592186045417 true] [17592186541139 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541139 1071 "Find the root of $f(x)=\\sqrt[4]{-7-2x}+1.$" 13194139535913 17592186045417 true] [17592186541139 1072 #uuid "daa14d13-b22a-5855-ae0b-e89337d6a6c3" 13194139535913 17592186045417 true] [17592186541139 1074 "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{-7-2x}+1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{-7-2x}+1 & =0 \\\\ \\sqrt[4]{-7-2x} & =-1\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root." 13194139535913 17592186045417 true] [17592186541140 1068 #edb/ref 17592186541041 13194139535913 17592186045417 true] [17592186541140 1069 "q-29643" 13194139535913 17592186045417 true] [17592186541140 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541140 1071 "$\\int \\frac{1}{{x}^{5}}\\,\\text{d}x=$" 13194139535913 17592186045417 true] [17592186541140 1072 #uuid "daa61eb1-b03b-51c0-8270-14c708ae1e5c" 13194139535913 17592186045417 true] [17592186541140 1074 "Note that $\\frac{1}{{x}^{5}}={x}^{-5}.$ So, we can use the power rule with $n=-5$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{5}}\\,\\text{d}x & =\\int {x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}+C \\\\  & =\\frac{{x}^{-4}}{-4}+C \\\\  & =-\\frac{1}{4{x}^{4}}+C.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541141 1068 #edb/ref 17592186541021 13194139535913 17592186045417 true] [17592186541141 1069 "q-79283" 13194139535913 17592186045417 true] [17592186541141 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541141 1071 "![](images/ea/ea74c15f3d02478a7486f967b7d2eebc780d1b5bd53ac21a81934b6438531f6d.png)\n\nConsider the ellipse centered at the origin with horizontal radius $3$ and vertical radius $5,$ as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the ellipse once in the counterclockwise direction starting at the point $A(3,0)?$" 13194139535913 17592186045417 true] [17592186541141 1072 #uuid "db10a605-9f1c-5d1d-923c-41dc3d49c705" 13194139535913 17592186045417 true] [17592186541141 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(a,0).$\n\nIn our case, $a=3$ and $b=5.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541142 1068 #edb/ref 17592186540981 13194139535913 17592186045417 true] [17592186541142 1069 "q-139211" 13194139535913 17592186045417 true] [17592186541142 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541142 1071 "![](images/f5/f5b69213924ffd4f7aef6acf1837fd05fbf6b0fd684de12a19f067e452fe42ea.png)\n\nConsider the finite region bounded by the curves $y=x$ and $y=\\frac{{x}^{3}}{4},$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." 13194139535913 17592186045417 true] [17592186541142 1072 #uuid "dc6488b4-82a0-5ac0-9b15-2d4fb9f9b1f5" 13194139535913 17592186045417 true] [17592186541142 1074 "First, let $f(x)=x$ and $g(x)=\\frac{{x}^{3}}{4}.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ x & =\\frac{{x}^{3}}{4} \\\\ 4x-{x}^{3} & =0 \\\\ x(4-{x}^{2}) & =0 \\\\ x(2-x)(2+x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0,$ $x=-2,$ and $x=2.$ So, we need to integrate from $x=0$ to $x=2$ because we are only concerned about $x\\ge 0.$ \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/cc/ccbaa663f6f108322f7bafd4a192a5b9acdf913b61b8319048e92b7885458a91.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=\\frac{{x}^{3}}{4},$ and\n\n- *leaves* through the upper function $y=f(x)=x.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x([x]-[\\frac{{x}^{3}}{4}])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{2}x(x-\\frac{{x}^{3}}{4})\\text{d}x \\\\  & =\\frac{\\pi }{2}{\\int }_{0}^{2}(4{x}^{2}-{x}^{4})\\text{d}x\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541143 1068 #edb/ref 17592186541026 13194139535913 17592186045417 true] [17592186541143 1069 "q-109259" 13194139535913 17592186045417 true] [17592186541143 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541143 1071 "![](images/d9/d9ad43f4bddaeab8327e5405193471c005962013355ec84c4a6f858640216dd7.png)\n\nConsider the arc of the curve $x=-{y}^{2}-5y-4$ that lies in the fourth quadrant between its $y$-intercepts. What integral gives the surface area generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" 13194139535913 17592186045417 true] [17592186541143 1072 #uuid "dd63787d-4bed-5aec-9b0b-525bc4b676f9" 13194139535913 17592186045417 true] [17592186541143 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nFirst, we need to determine the limits of integration. To do this, we find where the curve intersects the $y$-axis by solving the following equation:\n\n$$\n\\begin{aligned}-{y}^{2}-5y-4 & =0 \\\\ {y}^{2}+5y+4 & =0 \\\\ (y+1)(y+4) & =0 \\\\ y & =-4,-1\\end{aligned}\n$$\n\nHence, we need to integrate from $y=-4$ to $y=-1.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-{y}^{2}-5y-4)=-2y-5.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-4}^{-1}(-{y}^{2}-5y-4)\\sqrt{1+{(-2y-5)}^{2}}\\,\\text{d}y \\\\  & =-2\\pi {\\int }_{-4}^{-1}({y}^{2}+5y+4)\\sqrt{26+20y+4{y}^{2}}\\,\\text{d}y \\\\  & =-2\\pi \\sqrt{2}{\\int }_{-4}^{-1}({y}^{2}+5y+4)\\sqrt{2{y}^{2}+10y+13}\\,\\text{d}y.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541144 1068 #edb/ref 17592186540970 13194139535913 17592186045417 true] [17592186541144 1069 "q-106396" 13194139535913 17592186045417 true] [17592186541144 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541144 1071 "![](images/4b/4bccea09ccf18444f5b9505a8a753a9065ea97a5dc622208c281926c17cd5de1.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" 13194139535913 17592186045417 true] [17592186541144 1072 #uuid "de318b1b-b80f-58da-a7ea-29f3d4789691" 13194139535913 17592186045417 true] [17592186541144 1074 "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(-2,3),$ $a=3$ and $b=6.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta -2,\\,y=6\\operatorname{sin}⁡\\theta +3,\\,\\theta \\in [0,2\\pi ).\n$$" 13194139535913 17592186045417 true] [17592186541145 1068 #edb/ref 17592186540993 13194139535913 17592186045417 true] [17592186541145 1069 "q-79274" 13194139535913 17592186045417 true] [17592186541145 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541145 1071 "![](images/00/008a79d8328b5b58cdc68a39a921125a1efa7e0b46a663b1ede9dc6773fb48e8.png)\n\nThe quarter-ellipse above is defined by the parametric equations \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" 13194139535913 17592186045417 true] [17592186541145 1072 #uuid "df871080-1b98-5262-9947-842390c2ab3d" 13194139535913 17592186045417 true] [17592186541145 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=3$ and $b=1.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the elipse and the $x$-axis. \n\n![](images/82/82436a7f248ed63683a3164d8c372433abb6f919567defa05700ebf88c50308f.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the quarter-ellipse.\n\nTherefore, the parametric equations of the quarter-ellipse are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$" 13194139535913 17592186045417 true] [17592186541146 1068 #edb/ref 17592186540968 13194139535913 17592186045417 true] [17592186541146 1069 "q-156096" 13194139535913 17592186045417 true] [17592186541146 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541146 1071 "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}2x+4>6 \\\\ 4-x\\ge 2\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541146 1072 #uuid "e3894629-c728-5b78-885d-1ca88944c278" 13194139535913 17592186045417 true] [17592186541146 1074 "To solve the system, we need to find the values of $k$ that satisfy both $2x+4>6$ and $4-x\\ge 2$ simultaneously.\n\n- First, we solve $2x+4>6:$ \n\n$$\n\\begin{aligned}2x+4 & >6 \\\\ 2x+4-4 & >6-4 \\\\ 2x & >2 \\\\ \\frac{2x}{2} & >\\frac{2}{2} \\\\ x & >1\\end{aligned}\n$$\n\n![](images/6d/6d3b61147527a632ccb46629a356e9f5c92a1ddfc8a52f3d0890cd46eb56f564.png)\n\n- Then, we solve $4-x\\ge 2:$ \n\n$$\n\\begin{aligned}4-x & \\ge 2 \\\\ 4-x-4 & \\ge 2-4 \\\\ -x & \\ge -2 \\\\ (-1)\\cdot (-x) & \\le (-1)\\cdot (-2) \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/14/1452391c950b051c4cf454723498e6fa657f6d5f1315f78e50f3450bf7fbc1eb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/a2/a22a207cc64d33470e27d0b1f45ad0b87106fafd67b88c2163524a44951639bf.png)\n\n    \n\nThus, the final solution is $x\\in (1,2].$" 13194139535913 17592186045417 true] [17592186541147 1068 #edb/ref 17592186540973 13194139535913 17592186045417 true] [17592186541147 1069 "q-15801" 13194139535913 17592186045417 true] [17592186541147 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541147 1071 "Determine the Cartesian equation of the ellipse\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" 13194139535913 17592186045417 true] [17592186541147 1072 #uuid "e7435811-f6b1-5cc6-8105-467790c4f32b" 13194139535913 17592186045417 true] [17592186541147 1074 "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =4\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{4} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{4}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{16} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =7\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{7} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{7}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{49} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1.\n$$" 13194139535913 17592186045417 true] [17592186541148 1068 #edb/ref 17592186540988 13194139535913 17592186045417 true] [17592186541148 1068 #edb/ref 17592186541028 13194139535913 17592186045417 true] [17592186541148 1069 "q-133289" 13194139535913 17592186045417 true] [17592186541148 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541148 1071 "The eagle is descending for all $t$ in the interval$\\,t\\in ($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" 13194139535913 17592186045417 true] [17592186541148 1072 #uuid "eb009f1b-54cb-513a-ae27-a2c22d910e4d" 13194139535913 17592186045417 true] [17592186541148 1074 "If the eagle is descending, then its vertical velocity is negative.\n\nWe know that the eagle's vertical velocity is given by ${y}^{′}(t)={t}^{2}-2.$\n\nTo calculate the time interval in which the eagle's vertical velocity is decreasing, we solve the inequality ${y}^{′}(t)<0:$\n\n$$\n\\begin{aligned}{y}^{′}(t) & <0 \\\\ {t}^{2}-2 & <0 \\\\ {t}^{2} & <2 \\\\ |t| & <\\sqrt{2}\\end{aligned}\n$$\n\nHowever, we know that $t>0.$ Therefore, the eagle is descending for $t\\in (0,\\sqrt{2}).$" 13194139535913 17592186045417 true] [17592186541149 1068 #edb/ref 17592186540969 13194139535913 17592186045417 true] [17592186541149 1068 #edb/ref 17592186540977 13194139535913 17592186045417 true] [17592186541149 1069 "q-334928" 13194139535913 17592186045417 true] [17592186541149 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541149 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}2 \\\\ 3\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"190px\">$2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-{e}^{s}\\operatorname{sin}⁡(t-s)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" 13194139535913 17592186045417 true] [17592186541149 1072 #uuid "ed2f4962-bfe0-5321-8b55-e0e1d5307252" 13194139535913 17592186045417 true] [17592186541149 1074 "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(t-1) & \\operatorname{sin}⁡(t-1) \\\\ -\\operatorname{sin}⁡(t-1) & \\operatorname{cos}⁡(t-1)\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}][\\begin{aligned}{e}^{s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541150 1068 #edb/ref 17592186540957 13194139535913 17592186045417 true] [17592186541150 1069 "q-344647" 13194139535913 17592186045417 true] [17592186541150 1070 #edb/ref 17592186045487 13194139535913 17592186045417 true] [17592186541150 1071 "Find the average value ${g}_{\\text{avg}}$ of the function $g(x)=6\\operatorname{cos}⁡3x-4\\operatorname{cos}⁡x$ on the interval $[-\\frac{\\pi }{4},\\frac{\\pi }{4}].$ Do not round the answer.\n\n${g}_{\\text{avg}}=$\n{{field-1}}" 13194139535913 17592186045417 true] [17592186541150 1072 #uuid "f3134f95-ccde-508a-8ade-bbcbdfc93226" 13194139535913 17592186045417 true] [17592186541150 1074 "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\pi /4-(-\\pi /4))}{\\int }_{-\\pi /4}^{\\pi /4}(6\\operatorname{cos}⁡3x-4\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{-\\pi /4}^{\\pi /4}(6\\operatorname{cos}⁡3x-4\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & ={\\frac{2}{\\pi }(2\\operatorname{sin}⁡3x-4\\operatorname{sin}⁡x)|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{2}{\\pi }[(2\\operatorname{sin}⁡(\\frac{3\\pi }{4})-4\\operatorname{sin}⁡(\\frac{\\pi }{4}))-(2\\operatorname{sin}⁡(-\\frac{3\\pi }{4})-4\\operatorname{sin}⁡(-\\frac{\\pi }{4}))] \\\\  & =\\frac{2}{\\pi }[(2\\cdot \\frac{\\sqrt{2}}{2}-4\\cdot \\frac{\\sqrt{2}}{2})-(2\\cdot (-\\frac{\\sqrt{2}}{2})-4\\cdot (-\\frac{\\sqrt{2}}{2}))] \\\\  & =\\frac{2}{\\pi }[(-\\sqrt{2})-(\\sqrt{2})] \\\\  & =\\frac{2}{\\pi }\\cdot (-2\\sqrt{2}) \\\\  & =\\frac{-4\\sqrt{2}}{\\pi }.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541151 1068 #edb/ref 17592186541001 13194139535913 17592186045417 true] [17592186541151 1069 "q-133293" 13194139535913 17592186045417 true] [17592186541151 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541151 1071 "Let $r(t)=⟨x(t),y(t)⟩$ be the position vector of the eagle. Find the distance between the eagle and its nest at time $t=5\\,\\text{s},$ rounded to two decimal places.\n\nThe eagle is approximately$\\,$\n{{field-1}}\n$\\text{m}$ away from its nest after $t=5$ seconds." 13194139535913 17592186045417 true] [17592186541151 1072 #uuid "f4a5e43e-e7a6-55b0-a709-f89ec3a86933" 13194139535913 17592186045417 true] [17592186541151 1074 "Since the nest is at the origin, the distance between the bird and its nest at time $t=5$ is $|r(5)|.$\n\nWe know that $y(5)=\\frac{95}{3}.$ Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\operatorname{arctan}⁡(\\frac{5}{5}),\\frac{95}{3}⟩ \\\\  & =⟨\\frac{\\pi }{4},\\frac{95}{3}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{(\\frac{\\pi }{4})}^{2}+{(\\frac{95}{3})}^{2}} \\\\  & =\\sqrt{\\frac{{\\pi }^{2}}{16}+\\frac{9\\,025}{9}} \\\\  & ≈31.68\\,\\text{m}\\end{aligned}\n$$\n\nrounded to two decimal places." 13194139535913 17592186045417 true] [17592186541152 1068 #edb/ref 17592186541030 13194139535913 17592186045417 true] [17592186541152 1069 "q-106401" 13194139535913 17592186045417 true] [17592186541152 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541152 1071 "![](images/41/410d6ec438e066487cd6de9d4bcbf429362a5a86d5893e7820a832d2fffb9bbd.png)\n\nThe quarter-ellipse above is defined by the parametric equations \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" 13194139535913 17592186045417 true] [17592186541152 1072 #uuid "f6c896d6-3993-5114-bd3a-88e176c55230" 13194139535913 17592186045417 true] [17592186541152 1074 "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=2$ and $b=3.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the elipse and the $x$-axis. \n\n![](images/06/06e4a1a4d50943deff0b50eb510ca7ad4676ad6015a9503f7ce279f249078858.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the quarter-ellipse.\n\nTherefore, the parametric equations of the quarter-ellipse are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$" 13194139535913 17592186045417 true] [17592186541153 1068 #edb/ref 17592186541031 13194139535913 17592186045417 true] [17592186541153 1069 "q-122874" 13194139535913 17592186045417 true] [17592186541153 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541153 1071 "![](images/03/03935d4a02a1a42a106e148fa120132a246818684f88a441f63de46bc01dcbdc.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" 13194139535913 17592186045417 true] [17592186541153 1072 #uuid "f89ca459-c179-53fe-83c0-45ad6670695a" 13194139535913 17592186045417 true] [17592186541153 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =1\\cdot {m}_{11}+1\\cdot {m}_{21}+1\\cdot {m}_{12}+1\\cdot {m}_{22} \\\\  & ={m}_{11}+{m}_{21}+{m}_{12}+{m}_{22}.\\end{aligned}\n$$" 13194139535913 17592186045417 true] [17592186541154 1068 #edb/ref 17592186541007 13194139535913 17592186045417 true] [17592186541154 1069 "q-85233" 13194139535913 17592186045417 true] [17592186541154 1070 #edb/ref 17592186045485 13194139535913 17592186045417 true] [17592186541154 1071 "![](images/75/751d38a1a37afd277cbd54850abf61db898a231b49ad0d4bcaa5964bbab601e1.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{4}{5},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" 13194139535913 17592186045417 true] [17592186541154 1072 #uuid "fb5c025a-0d14-591c-9102-8c187483f1d5" 13194139535913 17592186045417 true] [17592186541154 1074 "![](images/05/0534847b2363ff75e053b9d05736ff367f2ad6da527b7100de0018d003c4c9df.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{4}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{4}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{4}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{4}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{3}{5}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{3}{5})}=\\frac{5}{3}.\n$$" 13194139535913 17592186045417 true] [17592186541155 1058 #edb/ref 17592186541224 13194139535913 17592186045417 true] [17592186541155 1062 #uuid "0227aae6-d172-57f4-83e8-b1350d2428e9" 13194139535913 17592186045417 true] [17592186541155 1063 #edb/ref 17592186157605 13194139535913 17592186045417 true] [17592186541156 1058 #edb/ref 17592186541189 13194139535913 17592186045417 true] [17592186541156 1062 #uuid "06b90397-7e54-5498-8b04-22ca8c09726a" 13194139535913 17592186045417 true] [17592186541156 1063 #edb/ref 17592186360827 13194139535913 17592186045417 true] [17592186541157 1058 #edb/ref 17592186541211 13194139535913 17592186045417 true] [17592186541157 1062 #uuid "0a4167d3-037b-58b6-800c-244d0969444d" 13194139535913 17592186045417 true] [17592186541157 1063 #edb/ref 17592186541114 13194139535913 175921