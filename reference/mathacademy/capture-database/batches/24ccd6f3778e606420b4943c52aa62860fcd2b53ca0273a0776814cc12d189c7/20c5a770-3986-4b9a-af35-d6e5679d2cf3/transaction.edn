/id #uuid "59287204-348a-50de-a654-4c533b517979" :answer/type :answer.type/image :answer/value "images/b7/b71061d18f93259329b422ebd707694aeb55a927743403b93570d1d6374c14a9.png" :db/ensure [:answer/validate]} {:db/id "answer-798c70bc-6741-5ad5-a130-7df97d91e3c3" :answer/id #uuid "798c70bc-6741-5ad5-a130-7df97d91e3c3" :answer/type :answer.type/image :answer/value "images/d8/d8579523b133b169b65d483b2bfd44cec529abffd147f3fe9c16fcbaee7a69ac.png" :db/ensure [:answer/validate]} {:db/id "question-6a7fd6db-b3ef-597a-8e12-d89a63fe1013" :question/id #uuid "6a7fd6db-b3ef-597a-8e12-d89a63fe1013" :question/math-academy-id "q-24089" :question/problem "![](images/66/66d61dadbaed0bb64bebc27286d2b574e63ce71c5c359a2da6b4f3f1a29ee6a9.png)\n\nThe graph above is a translation of $y=\\sqrt{x}.$ Identify the equation that generated the graph." :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the right by $1$ unit to get the graph of $y=\\sqrt{x-1}.$\n\n- Translate the result up by $2$ units to get the graph of $y=\\sqrt{x-1}+2.$\n\nThe result is the solid blue curve shown below.\n\n![](images/ea/ea0e33e6af15954c3a58b873c82d7877bd3d82595feea8e51b273345309f3241.png)\n\nTherefore, the correct answer is $y=\\sqrt{x-1}+2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e236862f-0a43-5394-a246-a343aae46e34"] :db/ensure [:question/validate]} {:db/id "answer-field-e236862f-0a43-5394-a246-a343aae46e34" :answer-field/id #uuid "e236862f-0a43-5394-a246-a343aae46e34" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f997366-ef31-5f99-a11f-c1519e2ce8ca" :answer-field/choices ["answer-5f6789ed-43fb-5ee5-972c-3073b78cda82" "answer-a6d0b0ed-6f8f-5574-bd53-59667a48aaf0" "answer-22d2e73f-09f1-5048-97c5-82f1287642c8" "answer-3f997366-ef31-5f99-a11f-c1519e2ce8ca" "answer-b34e0e20-0478-53c9-9213-6494