c-49e9d96f294b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9fdef16c-4571-5793-a652-d0ba873fbfa7" :answer/id #uuid "9fdef16c-4571-5793-a652-d0ba873fbfa7" :answer/type :answer.type/text :answer/value "center" :db/ensure [:answer/validate]} {:db/id "answer-16ab56e4-e2eb-5bf9-9537-27b52e4fea63" :answer/id #uuid "16ab56e4-e2eb-5bf9-9537-27b52e4fea63" :answer/type :answer.type/text :answer/value "saddle" :db/ensure [:answer/validate]} {:db/id "answer-a67bd7a3-bed8-52ac-9850-f7b4ed8b4ece" :answer/id #uuid "a67bd7a3-bed8-52ac-9850-f7b4ed8b4ece" :answer/type :answer.type/text :answer/value "spiral sink" :db/ensure [:answer/validate]} {:db/id "answer-2ef6eec8-69b9-5a4d-bffc-49e9d96f294b" :answer/id #uuid "2ef6eec8-69b9-5a4d-bffc-49e9d96f294b" :answer/type :answer.type/text :answer/value "spiral source" :db/ensure [:answer/validate]} {:db/id 17592186166923 :knowledge-point/questions ["question-257d204a-c14e-5aa5-8045-bec1e0148274"] :db/ensure [:knowledge-point/validate]} {:db/id "question-257d204a-c14e-5aa5-8045-bec1e0148274" :question/id #uuid "257d204a-c14e-5aa5-8045-bec1e0148274" :question/math-academy-id "q-334995" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=-3x+5xy \\\\ {y}^{′}=5y-3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the predators and $y=y(t)$ represents the prey. Find the nonzero equilibrium of the model.\n\n$(${{field-1}}\n$,$\n{{field-2}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}-3x+5xy=0 \\\\ 5y-3xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}-3x+5xy & =0 \\\\ x(-3+5y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{3}{5}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{3}{5},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3xy & =0 \\\\ y(5-3x) & =0 \\\\ \\frac{3}{5}(5-3x) & =0 \\\\ 5-3x & =0 \\\\ x & =\\frac{5}{3}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{5}{3},\\frac{3}{5}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{5}{3},\\frac{3}{5}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0efa0061-db88-505a-8abf-cea16f7858a3" "answer-field-7995027e-8581-593c-8043-53ee8d796378"] :db/ensure [:question/validate]} {:db/id "answer-field-0efa0061-db88-505a-8abf-cea16f7858a3" :answer-field/id #uuid "0efa0061-db88-505a-8abf-cea16f7858a3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer-field/choices ["answer-f7c23440-5c3b-5c48-baf9-2c8cb1453e1c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer/id #uuid "f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-7995027e-8581-593c-8043-53ee8d796378" :answer-field/id #uuid "7995027e-8581-593c-8043-53ee8d796378" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ae33a651-5fef-5a40-83d2-8951babac325" :answer-field/choices ["answer-ae33a651-5fef-5a40-83d2-8951babac325"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae33a651-5fef-5a40-83d2-8951babac325" :answer/id #uuid "ae33a651-5fef-5a40-83d2-8951babac325" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "question-79cf6220-8640-5993-92c2-8195fa289578" :question/id #uuid "79cf6220-8640-5993-92c2-8195fa289578" :question/math-academy-id "q-335009" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=-2x+3xy \\\\ {y}^{′}=4y-5xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the predators and $y=y(t)$ represents the prey. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=-2x+3xy$ and ${f}_{2}(x,y)=4y-5xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(-2x+3xy)=-2+3y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-2x+3xy)=3x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(4y-5xy)=-5y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(4y-5xy)=4-5x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}-2+3y & 3x \\\\ -5y & 4-5x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}-2+3(0) & 3(0) \\\\ -5(0) & 4-5(0)\\end{aligned}]=[\\begin{aligned}-2 & 0 \\\\ 0 & 4\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=-2\\text{ and }{\\lambda }_{2}=4.$ Since eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26f0d02b-2e4f-52af-b5fb-c59e5813e8f8" "answer-field-44bf6a00-c31a-5863-9515-5a099a7571ef" "answer-field-d735f931-6366-5aec-9f2f-070c16532ce5" "answer-field-18af244f-5b99-5c52-b321-7c2760b8516a" "answer-field-5f9fb980-62e1-5aa4-aa0a-00cf62c744c1" "answer-field-bdc48711-9294-5620-8821-e5c664e49e7f" "answer-field-93863fe0-dee2-51a1-bd5c-fa4d21ba0ca4"] :db/ensure [:question/validate]} {:db/id "answer-field-26f0d02b-2e4f-52af-b5fb-c59e5813e8f8" :answer-field/id #uuid "26f0d02b-2e4f-52af-b5fb-c59e5813e8f8" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-a7745325-afa5-500b-9d87-197710b467a3" :answer-field/choices ["answer-a7745325-afa5-500b-9d87-197710b467a3" "answer-f8a21cb3-acd8-557e-87c5-c6a2761a6696" "answer-9f67151e-0582-5405-9bc2-7f4abe819c39" "answer-9c65a080-7fa5-5c62-b0c2-2496ec2251aa" "answer-05374a86-e6cd-507f-a0b1-5c00e099616f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7745325-afa5-500b-9d87-197710b467a3" :answer/id #uuid "a7745325-afa5-500b-9d87-197710b467a3" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-f8a21cb3-acd8-557e-87c5-c6a2761a6696" :answer/id #uuid "f8a21cb3-acd8-557e-87c5-c6a2761a6696" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-9f67151e-0582-5405-9bc2-7f4abe819c39" :answer/id #uuid "9f67151e-0582-5405-9bc2-7f4abe819c39" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-9c65a080-7fa5-5c62-b0c2-2496ec2251aa" :answer/id #uuid "9c65a080-7fa5-5c62-b0c2-2496ec2251aa" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-05374a86-e6cd-507f-a0b1-5c00e099616f" :answer/id #uuid "05374a86-e6cd-507f-a0b1-5c00e099616f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-44bf6a00-c31a-5863-9515-5a099a7571ef" :a