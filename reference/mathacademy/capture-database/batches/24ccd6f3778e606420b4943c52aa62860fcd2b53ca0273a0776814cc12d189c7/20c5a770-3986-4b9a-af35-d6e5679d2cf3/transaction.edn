nswer/value "spiral sink" :db/ensure [:answer/validate]} {:db/id "answer-738df2c1-b8cc-5cf9-a7fe-5a31e97f576f" :answer/id #uuid "738df2c1-b8cc-5cf9-a7fe-5a31e97f576f" :answer/type :answer.type/text :answer/value "spiral source" :db/ensure [:answer/validate]} {:db/id "activity-d5b22701-9dd6-5ef7-882c-f8fe414e74e9" :activity/id #uuid "d5b22701-9dd6-5ef7-882c-f8fe414e74e9" :activity/title "The Lotka-Volterra Predator-Prey Model" :activity/type :activity.type/review :activity/scope 17592186050600 :activity/course 17592186046669 :activity/steps ["step-0398fe30-8e44-5ba6-8fd1-a43e6091f841" "step-840e4163-cfbd-5a7e-8f5f-200b5e5bc9bc" "step-0bd04562-8813-5c77-9599-36a65de31f18" "step-f5c129fa-a782-5dfd-8c7f-1026592e7785"] :activity/first-step "step-0398fe30-8e44-5ba6-8fd1-a43e6091f841" :db/ensure [:activity/validate]} {:db/id "step-0398fe30-8e44-5ba6-8fd1-a43e6091f841" :step/id #uuid "0398fe30-8e44-5ba6-8fd1-a43e6091f841" :step/content 17592186167246 :step/next "step-840e4163-cfbd-5a7e-8f5f-200b5e5bc9bc" :db/ensure [:step/validate]} {:db/id "step-840e4163-cfbd-5a7e-8f5f-200b5e5bc9bc" :step/id #uuid "840e4163-cfbd-5a7e-8f5f-200b5e5bc9bc" :step/content "question-257d204a-c14e-5aa5-8045-bec1e0148274" :step/next "step-0bd04562-8813-5c77-9599-36a65de31f18" :db/ensure [:step/validate]} {:db/id "step-0bd04562-8813-5c77-9599-36a65de31f18" :step/id #uuid "0bd04562-8813-5c77-9599-36a65de31f18" :step/content "question-79cf6220-8640-5993-92c2-8195fa289578" :step/next "step-f5c129fa-a782-5dfd-8c7f-1026592e7785" :db/ensure [:step/validate]} {:db/id "step-f5c129fa-a782-5dfd-8c7f-1026592e7785" :step/id #uuid "f5c129fa-a782-5dfd-8c7f-1026592e7785" :step/content 17592186370293 :db/ensure [:step/validate]} {:db/id 17592186110708 :knowledge-point/questions ["question-41c06b75-0eb3-5c66-92c4-5d80f2f59bde"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110531 :question/problem "Find the equation that generates the graph shown below. \n\n![](images/10/10f082165ef5b901e0ec43139fac54317395e1b349b31dd491dc36980981a622.png)" :question/worked-solution "To obtain the given graph, we perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the left by $1$ unit to get the graph of $y=\\sqrt{x+1}.$\n\nThe result is the solid blue curve shown below. \n\n![](images/35/3561b98dcf8113dcb644b1f3c738821f74d9f453e268fb2d47f6379d41f31951.png)\n\nTherefore, the answer is $y=\\sqrt{x+1}.$" :db/ensure [:question/validate]} {:db/id 17592186110709 :knowledge-point/questions ["question-65e9f7af-d6cc-5457-8d42-df8e93d622fa" "question-eb053305-3f48-5a05-bfa6-336398fa92e3" "question-c029c003-43fa-5232-9220-57dfcb421802" "question-6a7fd6db-b3ef-597a-8e12-d89a63fe1013"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110532 :question/problem "The graph below is a translation of $y=\\sqrt{x}.$ Find the equation that generated the graph.    \n\n![](images/d7/d7705be833455f266e892f78ec29f0dee88a7e3e803a00f85dfdfd15ff5f6f92.png)" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the  left by $2$ units to get the graph of $y=\\sqrt{x+2}.$\n\n- Translate the result  down by $1$ unit to get the graph of $y=\\sqrt{x+2}-1.$\n\nThe result is the solid blue curve shown below.\n\n![](images/9a/9af181a909b6ed88cee9ab8d331a09378ed75cc85a33d0f156a5b89ac91796cf.png)\n\nTherefore, the answer is $y=\\sqrt{x+2}-1.$" :db/ensure [:question/validate]} {:db/id 17592186110710 :knowledge-point/questions ["question-78215167-343c-5511-b0e2-4a5f5a4ce03b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110533 :question/problem "Sketch the graph of the function $f(x) =\\sqrt{2-x}.$" :question/worked-solution "First, let's re-write the expression as follows:\n\n$$\ny=\\sqrt{2-x}=\\sqrt{-(x-2)}\n$$\n\nTo obtain the graph of $y=\\sqrt{-(x-2)},$ we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/08/0848b7ecf37824cfb1eabe5b9b100cd3daf545887535e691eea62686bc99d973.png)\n\n- Translate the result to the right by $2$ units to get the graph of $y=\\sqrt{-(x-2)}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/22/227210ee73219614d94bff78ddf7e0a8539dabfa2bc3b8f4778fa9292359c5f6.png)" :db/ensure [:question/validate]} {:db/id 17592186110711 :knowledge-point/questions ["question-3a8011cb-eb86-5ec9-8024-d1a5101b449a" "question-2cdfaece-91e9-59d5-8fba-ab96089ab7a5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110534 :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $x$-axis to get the graph of $y=-\\sqrt{x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/78/78b19415feaf4e648e0d49a7aa3a130db5a57cf23b4aeafbdc34e5a968a3bf0e.png)\n\n- Translate the result to the left by $1$ unit to get the graph of $y=-\\sqrt{x+1}.$\n\n- Translate the result up by $2$ units to get the graph of $y=-\\sqrt{x+1}+2.$\n\nThe result is the solid blue curve shown below.\n\n![](images/4f/4ffbc7f9dd9ec50830a671f4ce688f51f6a7a11663f0c93af567ee8cc9a4a4f4.png)\n\nTherefore, the correct answer is $y = -\\sqrt{x+1}+2.$" :db/ensure [:question/validate]} {:db/id "question-41c06b75-0eb3-5c66-92c4-5d80f2f59bde" :question/id #uuid "41c06b75-0eb3-5c66-92c4-5d80f2f59bde" :question/math-academy-id "q-115158" :question/problem "![](images/a9/a9c9324b8b15e38c1037d39a744a9e1d28796ea70a5d300563f9eaaaef966522.png)\n\nIdentify the equation that generated the graph shown above." :question/worked-solution "To obtain the given graph, we perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph down by $5$ units to get the graph of $y=\\sqrt{x}-5.$\n\nThe result is the solid blue curve shown below.\n\n![](images/f0/f005ef005ce79b953aa61c01266ab4b9ba39c215169faf833bd91529f0e99c77.png)\n\nTherefore, the correct answer is $y=\\sqrt{x}-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce9e8219-1157-56ea-bd3e-e4c614b1910f"] :db/ensure [:question/validate]} {:db/id "answer-field-ce9e8219-1157-56ea-bd3e-e4c614b1910f" :answer-field/id #uuid "ce9e8219-1157-56ea-bd3e-e4c614b1910f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1be93c4f-121e-539a-b9ba-12e7993eed42" :answer-field/choices ["answer-09cf528c-8252-5a22-8998-109c93d6204b" "answer-f503fe8a-d68c-52cd-a6a9-ff882dd0efc7" "answer-1830591e-8d7e-5b2f-b13a-73be57a52b29" "answer-801c7b34-bf18-5a46-8b9f-14a132e0191f" "answer-1be93c4f-121e-539a-b9ba-12e7993eed42"] :db/ensure [:answer-field/validate]} {:db/id "answer-09cf528c-8252-5a22-8998-109c93d6204b" :answer/id #uuid "09cf528c-8252-5a22-8998-109c93d6204b" :answer/type :answer.type/math :answer/value "y=\\sqrt{\\frac{x}{5}}" :db/ensure [:answer/validate]} {:db/id "answer-f503fe8a-d68c-52cd-a6a9-ff882dd0efc7" :answer/id #uuid "f503fe8a-d68c-52cd-a6a9-ff882dd0efc7" :answer/type :answer.type/math :answer/value "y=\\sqrt{x+5}" :db/ensure [:answer/validate]} {:db/id "answer-1830591e-8d7e-5b2f-b13a-73be57a52b29" :answer/id #uuid "1830591e-8d7e-5b2f-b13a-73be57a52b29" :answer/type :answer.type/math :answer/value "y=\\sqrt{x-5}" :db/ensure [:answer/validate]} {:db/id "answer-801c7b34-bf18-5a46-8b9f-14a132e0191f" :answer/id #uuid "801c7b34-bf18-5a46-8b9f-14a132e0191f" :answer/type :answer.type/math :answer/value "y=\\sqrt{x}+5" :db/ensure [:answer/validate]} {:db/id "answer-1be93c4f-121e-539a-b9ba-12e7993eed42" :answer/id #uuid "1be93c4f-121e-539a-b9ba-12e7993eed42" :answer/type :answer.type/math :answer/value "y=\\sqrt{x}-5" :db/ensure [:answer/validate]} {:db/id 17592186111013 :question/problem "Which of the following is the graph of $y=\\sqrt{x}-2?$" :questio