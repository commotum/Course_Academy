878-a54b-0e06f4704881" "answer-4dd185bc-1d53-5d06-af55-d197af516931" "answer-791d18e1-4093-5dab-80b1-2cdeeec278b1" "answer-d14f5c60-8845-5e03-9980-e5ba4292d37b"] :db/ensure [:answer-field/validate]} {:db/id "answer-24c31280-ecb5-58d8-bd23-e18274f8038d" :answer/id #uuid "24c31280-ecb5-58d8-bd23-e18274f8038d" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-23801a00-f920-5878-a54b-0e06f4704881" :answer/id #uuid "23801a00-f920-5878-a54b-0e06f4704881" :answer/type :answer.type/math :answer/value "3\\,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4dd185bc-1d53-5d06-af55-d197af516931" :answer/id #uuid "4dd185bc-1d53-5d06-af55-d197af516931" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-791d18e1-4093-5dab-80b1-2cdeeec278b1" :answer/id #uuid "791d18e1-4093-5dab-80b1-2cdeeec278b1" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-d14f5c60-8845-5e03-9980-e5ba4292d37b" :answer/id #uuid "d14f5c60-8845-5e03-9980-e5ba4292d37b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-2fa5b801-b137-5833-adf3-4b3d17f99da2" :question/id #uuid "2fa5b801-b137-5833-adf3-4b3d17f99da2" :question/math-academy-id "q-169441" :question/problem "Owen takes $\\frac{4}{5}$ hours to do $24$ math exercises. How many exercises can he do in $1$ hour?" :question/worked-solution "To find the number of exercises Owen can do in $1$ hour, we compute the unit rate of exercises per hour. We do this by dividing the number of exercises Owen does, $24,$ by the number of hours, $\\frac{4}{5},$ as follows:\n\n$$\n24÷\\frac{4}{5}\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}24÷\\frac{4}{5} & =24\\times \\frac{5}{4} \\\\  & =\\frac{24}{1}\\times \\frac{5}{4} \\\\  & =\\frac{24\\times 5}{1\\times 4} \\\\  & =\\frac{120}{4} \\\\  & =30\\end{aligned}\n$$\n\nTherefore, Owen can do $30$ exercises in $1$ hour." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c50e92a2-cf53-5b22-b046-a98e26f50b91"] :db/ensure [:question/validate]} {:db/id "answer-field-c50e92a2-cf53-5b22-b046-a98e26f50b91" :answer-field/id #uuid "c50e92a2-cf53-5b22-b046-a98e26f50b91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-670bc25b-0858-5ec5-b504-a4960a721849" :answer-field/choices ["answer-3d67f7b2-d4a3-5793-a2e5-0a9c8f9fd22e" "answer-670bc25b-0858-5ec5-b504-a4960a721849" "answer-9a470ff6-451e-5701-ab44-7dc1b2916a7c" "answer-8e517433-966a-5535-be1e-691cffcfef43" "answer-0d089f51-d83a-525c-987a-61fa02546ef1"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d67f7b2-d4a3-5793-a2e5-0a9c8f9fd22e" :answer/id #uuid "3d67f7b2-d4a3-5793-a2e5-0a9c8f9fd22e" :answer/type :answer.type/text :answer/value "$27$ exercises" :db/ensure [:answer/validate]} {:db/id "answer-670bc25b-0858-5ec5-b504-a4960a721849" :answer/id #uuid "670bc25b-0858-5ec5-b504-a4960a721849" :answer/type :answer.type/text :answer/value "$30$ exercises" :db/ensure [:answer/validate]} {:db/id "answer-9a470ff6-451e-5701-ab44-7dc1b2916a7c" :answer/id #uuid "9a470ff6-451e-5701-ab44-7dc1b2916a7c" :answer/type :answer.type/text :answer/value "$36$ exercises" :db/ensure [:answer/validate]} {:db/id "answer-8e517433-966a-5535-be1e-691cffcfef43" :answer/id #uuid "8e517433-966a-5535-be1e-691cffcfef43" :answer/type :answer.type/text :answer/value "$\\frac{48}{5}$ exercises" :db/ensure [:answer/validate]} {:db/id "answer-0d089f51-d83a-525c-987a-61fa02546ef1" :answer/id #uuid "0d089f51-d83a-525c-987a-61fa02546ef1" :answer/type :answer.type/text :answer/value "$\\frac{96}{5}$ exercises" :db/ensure [:answer/validate]} {:db/id "question-8c31a83a-d0fb-50d8-8958-8a93c295b8d7" :question/id #uuid "8c31a83a-d0fb-50d8-8958-8a93c295b8d7" :question/math-academy-id "q-67843" :question/problem "A plane can travel $\\frac{3}{5}$ of a mile in $6$ seconds.  What is the unit rate of miles traveled per second?" :question/worked-solution "To compute the unit rate of miles per second, we divide the number of miles, $\\frac{3}{5},$ by the number of seconds, $6$, as follows:    \n\n$$\n\\frac{3}{5}÷6\n$$\n\nDividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number:\n\n$$\n\\begin{aligned}\\frac{3}{5}÷6 & =\\frac{3}{5}÷\\frac{6}{1} \\\\  & =\\frac{3}{5}\\times \\frac{1}{6} \\\\  & =\\frac{3\\times 1}{5\\times 6} \\\\  & =\\frac{3\\times 1}{5\\times 2\\times 3} \\\\  & =\\frac{\\cancel{3}\\times 1}{5\\times 2\\times \\cancel{3}} \\\\  & =\\frac{1}{10}\\end{aligned}\n$$\n\n \n\nTherefore, the unit rate in this situation is $\\frac{1}{10}$ miles per second." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cde096b2-00d6-5b15-9126-741eaff0be29"] :db/ensure [:question/validate]} {:db/id "answer-field-cde096b2-00d6-5b15-9126-741eaff0be29" :answer-field/id #uuid "cde096b2-00d6-5b15-9126-741eaff0be29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4fe3b194-43a2-5bcb-be96-d93b17b67cb8" :answer-field/choices ["answer-4fe3b194-43a2-5bcb-be96-d93b17b67cb8" "answer-56c3a097-3da8-592f-839d-534722217b99" "answer-74859d4c-493a-53d5-b8ba-de3078dd8c92" "answer-e4b5b4be-4671-5f9e-9df6-8769608166bc" "answer-3ac93665-3485-5b87-afe8-8a6c218d990f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fe3b194-43a2-5bcb-be96-d93b17b67cb8" :answer/id #uuid "4fe3b194-43a2-5bcb-be96-d93b17b67cb8" :answer/type :answer.type/text :answer/value "$\\frac{1}{10}$ miles per second" :db/ensure [:answer/validate]} {:db/id "answer-56c3a097-3da8-592f-839d-534722217b99" :answer/id #uuid "56c3a097-3da8-592f-839d-534722217b99" :answer/type :answer.type/text :answer/value "$\\frac{1}{12}$ miles per second" :db/ensure [:answer/val