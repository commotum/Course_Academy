3-502e03cb4eba" :step/next "step-6e940ef1-cb74-5ed5-96e9-fd160e8a8602" :db/ensure [:step/validate]} {:db/id "step-6e940ef1-cb74-5ed5-96e9-fd160e8a8602" :step/id #uuid "6e940ef1-cb74-5ed5-96e9-fd160e8a8602" :step/content "question-487e5162-7f53-555d-bd23-288509fce232" :db/ensure [:step/validate]} {:db/id 17592186096828 :knowledge-point/questions ["question-1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" "question-cc5e2afa-3b34-5a5a-87d2-86576b259f97" "question-64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" :question/id #uuid "1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" :question/math-academy-id "q-11480" :question/problem "Consider the finite region bounded by the curve $y={x}^{2}-{x}^{3}$ and the $x$-axis. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(1-x) & =0\\end{aligned}\n$$\n\nThe solutions are  $x=0$ and  $x=1.$ So, we need to integrate from $x=0$ to $x=1.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x({x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}({x}^{3}-{x}^{4})\\text{d}x \\\\  & ={2\\pi (\\frac{{x}^{4}}{4}\\text{ }-\\frac{{x}^{5}}{5})|}_{0}^{1} \\\\  & =2\\pi [(\\frac{1}{4}-\\frac{1}{5})-0] \\\\  & =2\\pi (\\frac{1}{20}) \\\\  & =\\frac{\\pi }{10}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3b8240cb-eb83-5b67-93ee-5d39ead36d05"] :db/ensure [:question/validate]} {:db/id "answer-field-3b8240cb-eb83-5b67-93ee-5d39ead36d05" :answer-field/id #uuid "3b8240cb-eb83-5b67-93ee-5d39ead36d05" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a4c00d2-5098-54c4-bfb3-fb1e4e39a687" :answer-field/choices ["answer-1a8b33db-e437-5653-925f-1fa9cfe52297" "answer-d3da23ec-8498-546a-b90f-b15aaef5d70d" "answer-991cbc71-8163-5cad-9451-b64c49988e86" "answer-c1b5b62d-cb0a-5d58-aa38-44da5f8d23e2" "answer-6a4c00d2-5098-54c4-bfb3-fb1e4e39a687"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a8b33db-e437-5653-925f-1fa9cfe52297" :answer/id #uuid "1a8b33db-e437-5653-925f-1fa9cfe52297" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-d3da23ec-8498-546a-b90f-b15aaef5d70d" :answer/id #uuid "d3da23ec-8498-546a-b90f-b15aaef5d70d" :answer/type :answer.type/math :answer/value "\\frac{17\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-991cbc71-8163-5cad-9451-b64c49988e86" :answer/id #uuid "991cbc71-8163-5cad-9451-b64c49988e86" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-c1b5b62d-cb0a-5d58-aa38-44da5f8d23e2" :answer/id #uuid "c1b5b62d-cb0a-5d58-aa38-44da5f8d23e2" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{30}" :db/ensure [:answer/validate]} {:db/id "answer-6a4c00d2-5098-54c4-bfb3-fb1e4e39a687" :answer/id #uuid "6a4c00d2-5098-54c4-bfb3-fb1e4e39a687" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{10}" :db/ensure [:answer/validate]} {:db/id "question-cc5e2afa-3b34-5a5a-87d2-86576b259f97" :question/id #uuid "cc5e2afa-3b34-5a5a-87d2-86576b259f97" :question/math-academy-id "q-11481" :question/problem "![](images/63/63bc2b3795556cd1f1b3b5b63c8d92816f64edcad364664db25acc0a7cc59b9e.png)\n\nConsider the finite region bounded by the curve $y=3{x}^{2}-{x}^{3}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}3{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(3-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=3.$ So, we need to integrate from $x=0$ to $x=3.$  \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}x(3{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}(3{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-becc477c-1df6-5756-8837-a73d10338340"] :db/ensure [:question/validate]} {:db/id "answer-field-becc477c-1df6-5756-8837-a73d10338340" :answer-field/id #uuid "becc477c-1df6-5756-8837-a73d10338340" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bee7d01a-2656-5a41-aea3-236070d2cc02" :answer-field/choices ["answer-bee7d01a-2656-5a41-aea3-236070d2cc02" "answer-b2741a70-01bb-517c-9324-b10de8cb8cba" "answer-53c6ef0e-1bb2-5ef7-9f88-d4cd6bc3f805" "answer-d808c625-55b1-5cc5-86d8-f55b3ec150ad" "answer-017b1a76-531b-5999-856a-c2856cf6e3f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bee7d01a-2656-5a41-aea3-236070d2cc02" :answer/id #uuid "bee7d01a-2656-5a41-aea3-236070d2cc02" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{3}(3{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b2741a70-01bb-517c-9324-b10de8cb8cba" :answer/id #uuid "b2741a70-01bb-517c-9324-b10de8cb8cba" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{3}({x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-53c6ef0e-1bb2-5ef7-9f88-d4cd6bc3f805" :answer/id #uuid "53c6ef0e-1bb2-5ef7-9f88-d4cd6bc3f805" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{3}(3{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-d808c625-55b1-5cc5-86d8-f55b3ec150ad" :answer/id #uuid "d808c625-55b1-5cc5-86d8-f55b3ec150ad" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{3}({x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-017b1a76-531b-5999-856a-c2856cf6e3f5" :answer/id #uuid "017b1a76-531b-5999-856a-c2856cf6e3f5" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{3}(3{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186096829 :knowledge-point/questions ["question-6fc2e8c7-fc0f-5be7-9a14-96326d528b23" "question-c1c69fb5-f0aa-5c39-a555-57a6bac7db2e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6fc2e8c7-fc0f-5be7-9a14-96326d528b23" :question/id #uuid "6fc2e8c7-fc0f-5be7-9a14-96326d528b23" :question/math-academy-id "q-139201" :question/problem "![](images/78/780120c106065874c04d97b8b6ef10e3e81e1cf9fd7c7b19bc633963cbadafe4.png)\n\nConsider the finite region bounded by the curves $y=4x-2{x}^{2}$ and $y=2{x}^{3},$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=4x-2{x}^{2}$ and $g(x)=2{x}^{3}.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 4x-2{x}^{2} & =2{x}^{3} \\\\ 4x-2{x}^{2}-2{x}^{3} & =0 \\\\ -2x(-2+x+{x}^{2}) & =0 \\\\ x(x-1)(x+2) & =0\\end{aligned}\n$$\n\nThe solutions are $x=-2,$ $x=0,$  and $x=1.$ So, we need to integrate from $x=0$ to $x=1$ because we are only concerned about $x\\ge 0.$ \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/e6/e695cfd83116df98b1530e2d53186de0ebcd03c6056c2b8d7c2272a76fbd790c.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=2{x}^{3},$ and\n\n- *leaves* through the upper function $y=f(x)=4x-2{x}^{2}.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x([4x-2{x}^{2}]-[2{x}^{3}])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x(4x-2{x}^{2}-2{x}^{3})\\text{d}x \\\\  & =4\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f640bd4e-d214-5668-a628-34c871dc6526"] :db/ensure [:question/validate]} {:db/id "answer-field-f640bd4e-d214-5668-a628-34c871dc6526" :answer-field/id #uuid "f640bd4e-d214-5668-a628-34c871dc6526" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-34cc3695-fd2f-5e9c-9272-a1e292466b11" :answer-field/choices ["answer-580870d0-e193-59a3-9434-1a8a76cd2f6b" "answer-bca077a5-a543-519f-ae1e-c7640a8d2417" "answer-34cc3695-fd2f-5e9c-9272-a1e292466b11" "answer-769e4575-3ec0-5595-98e8-16bc2c2e7733" "answer-f98e642e-bbd1-51ea-8415-467094f109fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-580870d0-e193-59a3-9434-1a8a76cd2f6b" :answer/id #uuid "580870d0-e193-59a3-9434-1a8a76cd2f6b" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{3})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-bca077a5-a543-519f-ae1e-c7640a8d2417" :answer/id #uuid "bca077a5-a543-519f-ae1e-c7640a8d2417" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-34cc3695-fd2f-5e9c-9272-a1e292466b11" :answer/id #uuid "34cc3695-fd2f-5e9c-9272-a1e292466b11" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-769e4575-3ec0-5595-98e8-16bc2c2e7733" :answer/id #uuid "769e4575-3ec0-5595-98e8-16bc2c2e7733" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{1}(2{x}^{3}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-f98e642e-bbd1-51ea-8415-467094f109fc" :answer/id #uuid "f98e642e-bbd1-51ea-8415-467094f109fc" :answer/type :answer.type/math :answer/value "8\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{3}-2{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-c1c69fb5-f0aa-5c39-a555-57a6bac7db2e" :question/id #uuid "c1c69fb5-f0aa-5c39-a555-57a6bac7db2e" :question/math-academy-id "q-139276" :question/problem "![](images/a9/a9db1a85c150c0bd6a8913a19387c7c717103cff1faf5266c7e21e774ab193ab.png)\n\nConsider the finite region bounded by the curves $y=-{x}^{2}+2x+1$ and $y={x}^{2}+1,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "First, let $f(x)=-{x}^{2}+2x+1$ and $g(x)={x}^{2}+1.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ -{x}^{2}+2x+1 & ={x}^{2}+1 \\\\ -2{x}^{2}+2x & =0 \\\\ -2x(x-1) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0,$ and $x=1.$ So, we need to integrate from $x=0$ to $x=1.$  \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/87/8790ae667c9a2741e2a732ff69d9afe5633dc26df7b02eee52fb51478524282b.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)={x}^{2}+1,$ and\n\n- *leaves* through the upper function $y=f(x)=-{x}^{2}+2x+1.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x([-{x}^{2}+2x+1]-[{x}^{2}+1])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x(2x-2{x}^{2})\\text{d}x \\\\  & =4\\pi {\\int }_{0}^{1}({x}^{2}-{x}^{3})\\text{d}x\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-22867a70-1477-5193-a844-d0f5f136791c"] :db/ensure [:question/validate]} {:db/id "answer-field-22867a70-1477-5193-a844-d0f5f136791c" :answer-field/id #uuid "22867a70-1477-5193-a844-d0f5f136791c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d36f336-7f12-5ce4-89b8-7a8176903c35" :answer-field/choices ["answer-defa663b-3dc9-5a1c-ade3-ded5b3e7a26f" "answer-f975fea1-88d6-5827-9969-fe173a2fbbee" "answer-2d36f336-7f12-5ce4-89b8-7a8176903c35" "answer-eddea9b1-2c9d-555c-8db2-5118e8221975" "answer-1b0c36c9-1238-5db2-9bf3-adf86360a2b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-defa663b-3dc9-5a1c-ade3-ded5b3e7a26f" :answer/id #uuid "defa663b-3dc9-5a1c-ade3-ded5b3e7a26f" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}(-x+{x}^{3})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-f975fea1-88d6-5827-9969-fe173a2fbbee" :answer/id #uuid "f975fea1-88d6-5827-9969-fe173a2fbbee" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}(-{x}^{2}+{x}^{3})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-2d36f336-7f12-5ce4-89b8-7a8176903c35" :answer/id #uuid "2d36f336-7f12-5ce4-89b8-7a8176903c35" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{1}({x}^{2}-{x}^{3})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-eddea9b1-2c9d-555c-8db2-5118e8221975" :answer/id #uuid "eddea9b1-2c9d-555c-8db2-5118e8221975" :answer/type :answer.type/math :answer/value "\\frac{4}{\\pi }{\\int }_{0}^{1}({x}^{2}-{x}^{4})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-1b0c36c9-1238-5db2-9bf3-adf86360a2b5" :answer/id #uuid "1b0c36c9-1238-5db2-9bf3-adf86360a2b5" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}{\\int }_{0}^{1}(-x+{x}^{3})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf" :question/id #uuid "64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf" :question/math-academy-id "q-352256" :question/problem "Consider the finite region bounded by the curve $y=x-3{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}x-3{x}^{2} & =0 \\\\ x(1-3x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=\\frac{1}{3}.$ So, we need to integrate from $x=0$ to $x=\\frac{1}{3}.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}x(x-3{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}({x}^{2}-3{x}^{3})\\text{d}x \\\\  & =2\\pi {(\\frac{{x}^{3}}{3}-\\frac{3{x}^{4}}{4})|}_{0}^{1/3} \\\\  & =2\\pi [(\\frac{1}{3\\cdot {3}^{3}}-\\frac{3}{4\\cdot {3}^{4}})-0] \\\\  & =2\\pi (\\frac{1}{324}) \\\\  & =\\frac{\\pi }{162}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3835d0c7-1e03-5584-bbd2-249f76f9390e"] :db/ensure [:question/validate]} {:db/id "answer-field-3835d0c7-1e03-5584-bbd2-249f76f9390e" :answer-field/id #uuid "3835d0c7-1e03-5584-bbd2-249f76f9390e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-16a51d10-6bf8-56cf-a684-b246769cc4f1" :answer-field/choices ["answer-16a51d10-6bf8-56cf-a684-b246769cc4f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-16a51d10-6bf8-56cf-a684-b246769cc4f1" :answer/id #uuid "16a51d10-6bf8-56cf-a684-b246769cc4f1" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{162}" :db/ensure [:answer/validate]} {:db/id "activity-9fc4ad01-5949-512d-b592-7603738c5b3b" :activity/id #uuid "9fc4ad01-5949-512d-b592-7603738c5b3b" :activity/title "The Shell Method: Rotation About the Y-Axis" :activity/type :activity.type/review :activity/scope 17592186051054 :activity/course 17592186046669 :activity/steps ["step-3fabfb31-ba4d-5286-ae69-a7ab6909a969" "step-6edba391-8597-52e1-b1c5-ab751b3434bc" "step-8e1f6b4c-2b0c-5f76-b13b-1f43a0ca1120" "step-33505734-d9d3-5b43-ae80-e3a496f5ae08" "step-4178bcb0-dd69-588c-bb6e-e7bbae7e2e7c"] :activity/first-step "step-3fabfb31-ba4d-5286-ae69-a7ab6909a969" :db/ensure [:activity/validate]} {:db/id "step-3fabfb31-ba4d-5286-ae69-a7ab6909a969" :step/id #uuid "3fabfb31-ba4d-5286-ae69-a7ab6909a969" :step/content "question-1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" :step/next "step-6edba391-8597-52e1-b1c5-ab751b3434bc" :db/ensure [:step/validate]} {:db/id "step-6edba391-8597-52e1-b1c5-ab751b3434bc" :step/id #uuid "6edba391-8597-52e1-b1c5-ab751b3434bc" :step/content "question-cc5e2afa-3b34-5a5a-87d2-86576b259f97" :step/next "step-8e1f6b4c-2b0c-5f76-b13b-1f43a0ca1120" :db/ensure [:step/validate]} {:db/id "step-8e1f6b4c-2b0c-5f76-b13b-1f43a0ca1120" :step/id #uuid "8e1f6b4c-2b0c-5f76-b13b-1f43a0ca1120" :step/content "question-6fc2e8c7-fc0f-5be7-9a14-96326d528b23" :step/next "step-33505734-d9d3-5b43-ae80-e3a496f5ae08" :db/ensure [:step/validate]} {:db/id "step-33505734-d9d3-5b43-ae80-e3a496f5ae08" :step/id #uuid "33505734-d9d3-5b43-ae80-e3a496f5ae08" :step/content "question-c1c69fb5-f0aa-5c39-a555-57a6bac7db2e" :step/next "step-4178bcb0-dd69-588c-bb6e-e7bbae7e2e7c" :db/ensure [:step/validate]} {:db/id "step-4178bcb0-dd69-588c-bb6e-e7bbae7e2e7c" :step/id #uuid "4178bcb0-dd69-588c-bb6e-e7bbae7e2e7c" :step/content "question-64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf" :db/ensure [:step/validate]} {:db/id 17592186124548 :knowledge-point/questions ["question-363ec8e4-c2ba-5e32-b1d7-37d1b114d1fa" "question-9e99c86a-1348-545b-9c9f-3a1428e5141e" "question-ddedbc01-5d9e-5e7a-be28-fa7766a765e4" "question-acd7fcaf-37e0-5893-ba70-06ebe65a32f1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124357 :question/problem "What is the domain of $f(x) = \\sqrt{3x+5}-2?$" :question/worked-solution "The domain of $y = \\sqrt{x}$ is\n\n$$\nx \\ge 0.\n$$\n\nTo find the domain of $g(x) = \\sqrt{3x+5} -2,$ we replace $x$ with $3x+5$ in the above inequality. This gives\n\n$$\n{3x+5} \\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}3x+5 & \\ge 0 \\\\ 3x & \\ge -5 \\\\ x & \\ge -\\frac{5}{3}.\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)$ is $x\\in \\left[-\\dfrac{5}{3}, \\infty\\right).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/6f/6f94991ce01ad98ec5bdffbb0673182dc40bc264803b6eea5154241985359c0b.png)" :db/ensure [:question/validate]} {:db/id 17592186124549 :knowledge-point/questions ["question-4cbeb52a-0392-5f34-918d-f2e44920e406" "question-24750a35-9998-5176-94af-1ab0c0c1ac7c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124358 :question/problem "Which of the following values are possible outputs of $f(x) = 2 \\sqrt{x- 2} + 2?$\n\nI. $1$\n\nII. $2$\n\nIII. $6$" :question/worked-solution "The range of $\\sqrt x$ is\n\n$$\n\\sqrt x \\ge 0.\n$$\n\nHorizontal shifts do not affect the range. So, we have\n\n$$\n\\sqrt{x-2} \\ge 0.\n$$\n\nMultiplying the above inequality by $2$ and then adding $2,$ we get\n\n$$\n\\begin{aligned}\\sqrt{x-2} & \\ge 0 \\\\ 2\\sqrt{x-2} & \\ge 0 \\\\ 2\\sqrt{x-2}+2 & \\ge 2.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x) \\in [2,\\infty).$\n\nAmong the given values, only $f(x)=2$ and $f(x)=6$ lie in the range. So, the correct answer is \"II and III only.\"\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/10/10d9a611e2fbf8ebf6ae3c12b57e51ea100bf13663586379c42293d4ee45d183.png)" :db/ensure [:question/validate]} {:db/id 17592186124581 :knowledge-point/questions ["question-3b5454cb-d7d1-50b2-8aa5-cfa1e1b3686a" "question-c6dd5656-22b2-5e5b-b391-f41ec70a470b" "question-be201399-7461-56d1-865b-23d766571416" "question-821416d3-f1f2-5d6c-b79b-722f962867ca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124389 :question/problem "Find the root of $f(x) = \\sqrt{6x+7} - 5.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0\\mathbin{:}$\n\n$$\n\\sqrt{6x+7} - 5 = 0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt{6x+7}-5 & =0 \\\\ \\sqrt{6x+7} & =5 \\\\ (\\sqrt{6x+7})^{2} & ={5}^{2} \\\\ 6x+7 & =25 \\\\ 6x & =18 \\\\ x & =3\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt{6\\cdot 3+7}-5 & =0 \\\\ \\sqrt{25} & =5 \\\\ 5 & =5\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=3.$" :db/ensure [:question/validate]} {:db/id 17592186124550 :knowledge-point/questions ["question-0bb9e173-3e0e-5cad-b727-d2df13c7ef82" "question-31d9f406-b6d6-5a07-bd60-36de4e4c1d5a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124359 :question/problem "Let $f(x)=a\\sqrt{b-x}+c.$ Now consider the following properties of $f(x)\\mathbin{:}$\n\n- The domain of $f(x)$ is $x \\in (-\\infty, 2].$\n\n- The range  is $f(x) \\in [2, \\infty).$\n\n- The point $(1,4)$ lies on the graph of $y=f(x).$\n\nFind the value of $a+b+c.$" :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{b-x}+c\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}b-x & \\ge 0 \\\\ x & \\le b\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in \\left(-\\infty, 2\\right],$ which is equivalent to $x\\le 2.$ Hence, we obtain\n\n$$\nb=2.\n$$\n\n- Since the range is unbounded on the right-hand side, we know that $a>0.$ Furthermore, since we are given that the lowest point in the range is $2,$ we must have\n\n$$\n\\begin{aligned}{{a\\sqrt{2-x}}_{⏟}}_{\\ge 0}+c\\ge 2.\\end{aligned}\n$$\n\nThis means that $c=2.$\n\n- Finally, since the point $(1,4)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(1) & =a\\sqrt{2-1}+2 \\\\ 4 & =a+2 \\\\ a & =2.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=2\\sqrt{2-x}+2,$ and \n\n$$\na+b+c = 2 + 2 + 2 = 6.\n$$" :db/ensure [:question/validate]} {:db/id "question-363ec8e4-c2ba-5e32-b1d7-37d1b114d1fa" :question/id #uuid "363ec8e4-c2ba-5e32-b1d7-37d1b114d1fa" :question/math-academy-id "q-277276" :question/problem "Determine the domain of $f(x)=4\\sqrt{7+x}+1.$\n\nThe domain is $x\\in [${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "The domain of $y=\\sqrt{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $f(x)=4\\sqrt{7+x}+1,$ we replace $x$ with $7+x$ in the above inequality. This gives\n\n$$\n7+x\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}7+x & \\ge 0 \\\\ x & \\ge -7.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in [-7,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/1b/1b5b24146a009936bb2fab85afa4f40b888881e4d6978fb76e76e7180b2cd83d.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2a429198-aa6a-503b-8694-c555670b935b" "answer-field-9f52f454-d984-5e42-98ea-448aa919b6ed"] :db/ensure [:question/validate]} {:db/id "answer-field-2a429198-aa6a-503b-8694-c555670b935b" :answer-field/id #uuid "2a429198-aa6a-503b-8694-c555670b935b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5e30c897-3ba0-5fe2-b2fb-4154efb87814" :answer-field/choices ["answer-5e30c897-3ba0-5fe2-b2fb-4154efb87814"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e30c897-3ba0-5fe2-b2fb-4154efb87814" :answer/id #uuid "5e30c897-3ba0-5fe2-b2fb-4154efb87814" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-field-9f52f454-d984-5e42-98ea-448aa919b6ed" :answer-field/id #uuid "9f52f454-d984-5e42-98ea-448aa919b6ed" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ceeba4da-f0c2-5be1-9c89-f0c0346bd63b" :answer-field/choices ["answer-ceeba4da-f0c2-5be1-9c89-f0c0346bd63b"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceeba4da-f0c2-5be1-9c89-f0c0346bd63b" :answer/id #uuid "ceeba4da-f0c2-5be1-9c89-f0c0346bd63b" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-9e99c86a-1348-545b-9c9f-3a1428e5141e" :question/id #uuid "9e99c86a-1348-545b-9c9f-3a1428e5141e" :question/math-academy-id "q-115372" :question/problem "What is the domain of $f(x)=5\\sqrt{4x-3}?$" :question/worked-solution "The domain of $y=\\sqrt{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $f(x)=5\\sqrt{4x-3},$ we replace $x$ with $4x-3$ in the above inequality. This gives\n\n$$\n4x-3\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}4x-3 & \\ge 0 \\\\ 4x & \\ge 3 \\\\ x & \\ge \\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in [\\frac{3}{4},\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/f7/f71e9e717ab5c217d91528de89540de9013eadd31b1907c89d43d589fb6929af.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ec4a6373-b04b-55f6-92d5-cafe236a4c92"] :db/ensure [:question/validate]} {:db/id "answer-field-ec4a6373-b04b-55f6-92d5-cafe236a4c92" :answer-field/id #uuid "ec4a6373-b04b-55f6-92d5-cafe236a4c92" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1cf67c77-91be-5eab-8ec1-78a1c10468d6" :answer-field/choices ["answer-2989486c-c7fa-5cdc-bb39-cb0786fa5299" "answer-e9575243-29dc-5258-82da-6a73e79a5aab" "answer-a555140a-4b9d-55d9-add9-863f5e16350e" "answer-ca80941b-902e-523a-b089-d3daa893d689" "answer-1cf67c77-91be-5eab-8ec1-78a1c10468d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-2989486c-c7fa-5cdc-bb39-cb0786fa5299" :answer/id #uuid "2989486c-c7fa-5cdc-bb39-cb0786fa5299" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-3]" :db/ensure [:answer/validate]} {:db/id "answer-e9575243-29dc-5258-82da-6a73e79a5aab" :answer/id #uuid "e9575243-29dc-5258-82da-6a73e79a5aab" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-a555140a-4b9d-55d9-add9-863f5e16350e" :answer/id #uuid "a555140a-4b9d-55d9-add9-863f5e16350e" :answer/type :answer.type/math :answer/value "x\\in (3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-ca80941b-902e-523a-b089-d3daa893d689" :answer/id #uuid "ca80941b-902e-523a-b089-d3daa893d689" :answer/type :answer.type/math :answer/value "x\\in [-\\frac{3}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-1cf67c77-91be-5eab-8ec1-78a1c10468d6" :answer/id #uuid "1cf67c77-91be-5eab-8ec1-78a1c10468d6" :answer/type :answer.type/math :answer/value "x\\in [\\frac{3}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-ddedbc01-5d9e-5e7a-be28-fa7766a765e4" :question/id #uuid "ddedbc01-5d9e-5e7a-be28-fa7766a765e4" :question/math-academy-id "q-277275" :question/problem "Determine the domain of $f(x)=\\sqrt{6x-5}.$\n\nThe domain is $x\\in [${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "The domain of $y=\\sqrt{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $f(x)=\\sqrt{6x-5},$ we replace $x$ with $6x-5$ in the above inequality. This gives\n\n$$\n6x-5\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}6x-5 & \\ge 0 \\\\ 6x & \\ge 5 \\\\ x & \\ge \\frac{5}{6}.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in [\\frac{5}{6},\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/4d/4d0a6205a61aa0625a082d6d3bc1941ab00e0536c85844f28af873798bf6db64.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-af617755-880c-5549-a29f-1cfbdcfef121" "answer-field-0938b589-eeeb-5c28-b350-d0d6ca254011"] :db/ensure [:question/validate]} {:db/id "answer-field-af617755-880c-5549-a29f-1cfbdcfef121" :answer-field/id #uuid "af617755-880c-5549-a29f-1cfbdcfef121" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-17c6ccb6-e4f8-51ea-8ba5-2b34ab064602" :answer-field/choices ["answer-17c6ccb6-e4f8-51ea-8ba5-2b34ab064602"] :db/ensure [:answer-field/validate]} {:db/id "answer-17c6ccb6-e4f8-51ea-8ba5-2b34ab064602" :answer/id #uuid "17c6ccb6-e4f8-51ea-8ba5-2b34ab064602" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-field-0938b589-eeeb-5c28-b350-d0d6ca254011" :answer-field/id #uuid "0938b589-eeeb-5c28-b350-d0d6ca254011" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-34ea3ac2-bb33-5310-9978-d13df8149805" :answer-field/choices ["answer-34ea3ac2-bb33-5310-9978-d13df8149805"] :db/ensure [:answer-field/validate]} {:db/id "answer-34ea3ac2-bb33-5310-9978-d13df8149805" :answer/id #uuid "34ea3ac2-bb33-5310-9978-d13df8149805" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-acd7fcaf-37e0-5893-ba70-06ebe65a32f1" :question/id #uuid "acd7fcaf-37e0-5893-ba70-06ebe65a32f1" :question/math-academy-id "q-115377" :question/problem "What is the domain of $f(x)=3\\sqrt{8x}-2?$" :question/worked-solution "The domain of $y=\\sqrt{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $f(x)=3\\sqrt{8x}-2,$ we replace $x$ with $8x$ in the above inequality. This gives\n\n$$\n8x\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}8x & \\ge 0 \\\\ x & \\ge 0.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in [0,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/ef/efbc925cd1aca7f476d6cfc11f3c668c4f3bde78acf359eb0a65696ce2a12852.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94127993-da95-546e-8e26-790d927d8bcd"] :db/ensure [:question/validate]} {:db/id "answer-field-94127993-da95-546e-8e26-790d927d8bcd" :answer-field/id #uuid "94127993-da95-546e-8e26-790d927d8bcd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-daa71957-017a-5538-a1a5-204f82a67c1c" :answer-field/choices ["answer-7de831af-f1a9-5f3e-99cf-e02ebbbe0a7e" "answer-abd2a011-9345-5dac-9bfe-0db3bac72332" "answer-daa71957-017a-5538-a1a5-204f82a67c1c" "answer-ec31db76-c5fd-5689-a0f5-26cde5e7f348" "answer-a5687a27-5a30-5f0c-9a00-6c27a6816f37"] :db/ensure [:answer-field/validate]} {:db/id "answer-7de831af-f1a9-5f3e-99cf-e02ebbbe0a7e" :answer/id #uuid "7de831af-f1a9-5f3e-99cf-e02ebbbe0a7e" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,0]" :db/ensure [:answer/validate]} {:db/id "answer-abd2a011-9345-5dac-9bfe-0db3bac72332" :answer/id #uuid "abd2a011-9345-5dac-9bfe-0db3bac72332" :answer/type :answer.type/math :answer/value "x\\in [-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-daa71957-017a-5538-a1a5-204f82a67c1c" :answer/id #uuid "daa71957-017a-5538-a1a5-204f82a67c1c" :answer/type :answer.type/math :answer/value "x\\in [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-ec31db76-c5fd-5689-a0f5-26cde5e7f348" :answer/id #uuid "ec31db76-c5fd-5689-a0f5-26cde5e7f348" :answer/type :answer.type/math :answer/value "x\\in [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a5687a27-5a30-5f0c-9a00-6c27a6816f37" :answer/id #uuid "a5687a27-5a30-5f0c-9a00-6c27a6816f37" :answer/type :answer.type/text :answer/value "$f$ is not defined for any value of $x$" :db/ensure [:answer/validate]} {:db/id "question-4cbeb52a-0392-5f34-918d-f2e44920e406" :question/id #uuid "4cbeb52a-0392-5f34-918d-f2e44920e406" :question/math-academy-id "q-115385" :question/problem "What is the range of $f(x)=3\\sqrt{5x+9}?$" :question/worked-solution "The range of $\\sqrt{x}$ is\n\n$$\n\\sqrt{x}\\ge 0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Hence,\n\n$$\n\\sqrt{5x+9}\\ge 0.\n$$\n\nMultiplying the above inequality by $3,$ we get\n\n$$\n\\begin{aligned}\\sqrt{5x+9} & \\ge 0 \\\\ 3\\sqrt{5x+9} & \\ge 0.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x)\\in [0,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/8e/8ece70a3c8855e00a0232248cb922a40c8c9756ef67ea12b012eb719c8ee3bd1.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-844a1e28-73b3-57bb-9963-fbd57ccb007b"] :db/ensure [:question/validate]} {:db/id "answer-field-844a1e28-73b3-57bb-9963-fbd57ccb007b" :answer-field/id #uuid "844a1e28-73b3-57bb-9963-fbd57ccb007b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d54b5fee-97ea-5670-9b88-ecf5c742bd92" :answer-field/choices ["answer-b5c19164-5b86-5641-a5ff-8f0edcd2b282" "answer-5dfb396d-19bb-50d9-9137-780c44346eb7" "answer-d54b5fee-97ea-5670-9b88-ecf5c742bd92" "answer-7904ba0f-9797-5697-8431-88692532adb2" "answer-b14d19e8-60b0-529d-84f5-d4d38745c586"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5c19164-5b86-5641-a5ff-8f0edcd2b282" :answer/id #uuid "b5c19164-5b86-5641-a5ff-8f0edcd2b282" :answer/type :answer.type/math :answer/value "y\\in (-\\infty ,0]" :db/ensure [:answer/validate]} {:db/id "answer-5dfb396d-19bb-50d9-9137-780c44346eb7" :answer/id #uuid "5dfb396d-19bb-50d9-9137-780c44346eb7" :answer/type :answer.type/math :answer/value "y\\in (-\\infty ,\\frac{9}{5}]" :db/ensure [:answer/validate]} {:db/id "answer-d54b5fee-97ea-5670-9b88-ecf5c742bd92" :answer/id #uuid "d54b5fee-97ea-5670-9b88-ecf5c742bd92" :answer/type :answer.type/math :answer/value "y\\in [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-7904ba0f-9797-5697-8431-88692532adb2" :answer/id #uuid "7904ba0f-9797-5697-8431-88692532adb2" :answer/type :answer.type/math :answer/value "y\\in [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-b14d19e8-60b0-529d-84f5-d4d38745c586" :answer/id #uuid "b14d19e8-60b0-529d-84f5-d4d38745c586" :answer/type :answer.type/math :answer/value "y\\in [\\frac{9}{5},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-24750a35-9998-5176-94af-1ab0c0c1ac7c" :question/id #uuid "24750a35-9998-5176-94af-1ab0c0c1ac7c" :question/math-academy-id "q-274961" :question/problem "Determine the range of $f(x)=\\frac{3}{5}\\sqrt{x-3}+3.$\n\nThe range is $f(x)$\n{{field-1}}{{field-2}}." :question/worked-solution "The range of $\\sqrt{x}$ is\n\n$$\n\\sqrt{x}\\ge 0.\n$$\n\nHorizontal shifts do not affect the range. Hence,\n\n$$\n\\sqrt{x-3}\\ge 0.\n$$\n\nMultiplying the above inequality by $\\frac{3}{5}$ and then adding $3,$ we get\n\n$$\n\\begin{aligned}\\sqrt{x-3} & \\ge 0 \\\\ \\frac{3}{5}\\sqrt{x-3} & \\ge 0 \\\\ \\frac{3}{5}\\sqrt{x-3}+3 & \\ge 3 \\\\ f(x) & \\ge 3.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x)\\in [3,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/c2/c27b96134ab2d7004262d14163db2cd3714fd0c18fb6bb84444252d5bdac2ef7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-69cb606f-66c9-5c21-b497-a4aa6183e686" "answer-field-db6d0703-93cf-564b-a9f8-5d2287a0d22d"] :db/ensure [:question/validate]} {:db/id "answer-field-69cb606f-66c9-5c21-b497-a4aa6183e686" :answer-field/id #uuid "69cb606f-66c9-5c21-b497-a4aa6183e686" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fe7df7b8-dd76-588d-bf96-d1a367df5b03" :answer-field/choices ["answer-fe7df7b8-dd76-588d-bf96-d1a367df5b03"] :db/ensure [:answer-field/validate]} {:db/id "answer-fe7df7b8-dd76-588d-bf96-d1a367df5b03" :answer/id #uuid "fe7df7b8-dd76-588d-bf96-d1a367df5b03" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "answer-field-db6d0703-93cf-564b-a9f8-5d2287a0d22d" :answer-field/id #uuid "db6d0703-93cf-564b-a9f8-5d2287a0d22d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cfd9fad1-7e48-533a-9de4-6d8341265adb" :answer-field/choices ["answer-cfd9fad1-7e48-533a-9de4-6d8341265adb"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfd9fad1-7e48-533a-9de4-6d8341265adb" :answer/id #uuid "cfd9fad1-7e48-533a-9de4-6d8341265adb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-3b5454cb-d7d1-50b2-8aa5-cfa1e1b3686a" :question/id #uuid "3b5454cb-d7d1-50b2-8aa5-cfa1e1b3686a" :question/math-academy-id "q-89991" :question/problem "Find the root of $f(x)=\\sqrt{3x+1}+4.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt{3x+1}+4=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt{3x+1}+4 & =0 \\\\ \\sqrt{3x+1} & =-4\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-df9ae1bc-cf9c-58da-99a8-99c8f9f9fe90"] :db/ensure [:question/validate]} {:db/id "answer-field-df9ae1bc-cf9c-58da-99a8-99c8f9f9fe90" :answer-field/id #uuid "df9ae1bc-cf9c-58da-99a8-99c8f9f9fe90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e88954f-957b-57f5-9bbc-ba8c17ee7bed" :answer-field/choices ["answer-97378096-9630-55ac-b7bc-b4e0bef588b5" "answer-4466e510-4cb0-5e44-a6d4-09673d1ccf0f" "answer-54903bff-703a-5f3d-a66b-a7747bb332e6" "answer-9962bede-e69b-568e-b720-68ae9609dfd4" "answer-3e88954f-957b-57f5-9bbc-ba8c17ee7bed"] :db/ensure [:answer-field/validate]} {:db/id "answer-97378096-9630-55ac-b7bc-b4e0bef588b5" :answer/id #uuid "97378096-9630-55ac-b7bc-b4e0bef588b5" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "answer-4466e510-4cb0-5e44-a6d4-09673d1ccf0f" :answer/id #uuid "4466e510-4cb0-5e44-a6d4-09673d1ccf0f" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-54903bff-703a-5f3d-a66b-a7747bb332e6" :answer/id #uuid "54903bff-703a-5f3d-a66b-a7747bb332e6" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-9962bede-e69b-568e-b720-68ae9609dfd4" :answer/id #uuid "9962bede-e69b-568e-b720-68ae9609dfd4" :answer/type :answer.type/math :answer/value "x=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3e88954f-957b-57f5-9bbc-ba8c17ee7bed" :answer/id #uuid "3e88954f-957b-57f5-9bbc-ba8c17ee7bed" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "question-c6dd5656-22b2-5e5b-b391-f41ec70a470b" :question/id #uuid "c6dd5656-22b2-5e5b-b391-f41ec70a470b" :question/math-academy-id "q-89992" :question/problem "Find the root of $f(x)=\\sqrt{4-5x}+10.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt{4-5x}+10=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt{4-5x}+10 & =0 \\\\ \\sqrt{4-5x} & =-10\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-74bb54bf-b891-5fc6-b056-efc04e739628"] :db/ensure [:question/validate]} {:db/id "answer-field-74bb54bf-b891-5fc6-b056-efc04e739628" :answer-field/id #uuid "74bb54bf-b891-5fc6-b056-efc04e739628" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cb2ebb7e-eb95-5bb7-84aa-bc1a83877f04" :answer-field/choices ["answer-ef9e175e-3cbb-5dda-8735-b54de7fb4cb1" "answer-82d1ab47-c4b7-5eac-a183-d992bc2821aa" "answer-ef923bb4-26d8-57af-bda9-9f8afcaf5ade" "answer-ac6fc057-f8d1-5fda-ade0-1932cd94d9a1" "answer-cb2ebb7e-eb95-5bb7-84aa-bc1a83877f04"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef9e175e-3cbb-5dda-8735-b54de7fb4cb1" :answer/id #uuid "ef9e175e-3cbb-5dda-8735-b54de7fb4cb1" :answer/type :answer.type/math :answer/value "x=-10" :db/ensure [:answer/validate]} {:db/id "answer-82d1ab47-c4b7-5eac-a183-d992bc2821aa" :answer/id #uuid "82d1ab47-c4b7-5eac-a183-d992bc2821aa" :answer/type :answer.type/math :answer/value "x=-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-ef923bb4-26d8-57af-bda9-9f8afcaf5ade" :answer/id #uuid "ef923bb4-26d8-57af-bda9-9f8afcaf5ade" :answer/type :answer.type/math :answer/value "x=10" :db/ensure [:answer/validate]} {:db/id "answer-ac6fc057-f8d1-5fda-ade0-1932cd94d9a1" :answer/id #uuid "ac6fc057-f8d1-5fda-ade0-1932cd94d9a1" :answer/type :answer.type/math :answer/value "x=\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-cb2ebb7e-eb95-5bb7-84aa-bc1a83877f04" :answer/id #uuid "cb2ebb7e-eb95-5bb7-84aa-bc1a83877f04" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "question-be201399-7461-56d1-865b-23d766571416" :question/id #uuid "be201399-7461-56d1-865b-23d766571416" :question/math-academy-id "q-277380" :question/problem "The root of the function $f(x)=-\\sqrt{8-2x}+4$ is $x=${{field-1}}." :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-\\sqrt{8-2x}+4=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-\\sqrt{8-2x}+4 & =0 \\\\ -\\sqrt{8-2x} & =-4 \\\\ \\sqrt{8-2x} & =4 \\\\ (\\sqrt{8-2x})^{2} & ={4}^{2} \\\\ 8-2x & =16 \\\\ -2x & =8 \\\\ x & =-4\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}-\\sqrt{8-2(-4)}+4 & =0 \\\\ -\\sqrt{8+8}+4 & =0 \\\\ -\\sqrt{16}+4 & =0 \\\\ -4+4 & =0 \\\\ -4+4 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-90fcae54-4761-5bbd-a196-a62c3cc597fc"] :db/ensure [:question/validate]} {:db/id "answer-field-90fcae54-4761-5bbd-a196-a62c3cc597fc" :answer-field/id #uuid "90fcae54-4761-5bbd-a196-a62c3cc597fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-122464dc-3073-5ef0-91f2-6ff298d4d6e3" :answer-field/choices ["answer-122464dc-3073-5ef0-91f2-6ff298d4d6e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-122464dc-3073-5ef0-91f2-6ff298d4d6e3" :answer/id #uuid "122464dc-3073-5ef0-91f2-6ff298d4d6e3" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "question-821416d3-f1f2-5d6c-b79b-722f962867ca" :question/id #uuid "821416d3-f1f2-5d6c-b79b-722f962867ca" :question/math-academy-id "q-115388" :question/problem "Find the root of $f(x)=2\\sqrt{5x+10}+3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n2\\sqrt{5x+10}+3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{5x+10}+3 & =0 \\\\ 2\\sqrt{5x+10} & =-3 \\\\ \\sqrt{5x+10} & =-\\frac{3}{2}\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b07284bb-0da9-5e96-a0b2-03339339ef3c"] :db/ensure [:question/validate]} {:db/id "answer-field-b07284bb-0da9-5e96-a0b2-03339339ef3c" :answer-field/id #uuid "b07284bb-0da9-5e96-a0b2-03339339ef3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-340fd56f-9ed8-59f8-b237-f9fd54e9e9e9" :answer-field/choices ["answer-edf4dfe7-2aae-50c7-b758-39a68bace86c" "answer-a1244121-62dc-5583-9fd2-3bd580b02f25" "answer-b075542e-07c0-57e6-bb78-c2cf0fac2d08" "answer-0165f473-4337-566d-9694-678006847e88" "answer-340fd56f-9ed8-59f8-b237-f9fd54e9e9e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-edf4dfe7-2aae-50c7-b758-39a68bace86c" :answer/id #uuid "edf4dfe7-2aae-50c7-b758-39a68bace86c" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-a1244121-62dc-5583-9fd2-3bd580b02f25" :answer/id #uuid "a1244121-62dc-5583-9fd2-3bd580b02f25" :answer/type :answer.type/math :answer/value "x=-8" :db/ensure [:answer/validate]} {:db/id "answer-b075542e-07c0-57e6-bb78-c2cf0fac2d08" :answer/id #uuid "b075542e-07c0-57e6-bb78-c2cf0fac2d08" :answer/type :answer.type/math :answer/value "x=-\\frac{31}{20}" :db/ensure [:answer/validate]} {:db/id "answer-0165f473-4337-566d-9694-678006847e88" :answer/id #uuid "0165f473-4337-566d-9694-678006847e88" :answer/type :answer.type/math :answer/value "x=-\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "answer-340fd56f-9ed8-59f8-b237-f9fd54e9e9e9" :answer/id #uuid "340fd56f-9ed8-59f8-b237-f9fd54e9e9e9" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "question-0bb9e173-3e0e-5cad-b727-d2df13c7ef82" :question/id #uuid "0bb9e173-3e0e-5cad-b727-d2df13c7ef82" :question/math-academy-id "q-277438" :question/problem "Let $f(x)=a\\sqrt{2x+b}+c.$ Now consider the following properties of$f(x):$\n\n- The domain of $f(x)$ is $x\\in [4,\\infty ).$\n\n- The range is $f(x)\\in [-1,\\infty ).$\n\n- The point $(6,3)$ lies on the graph of $y=f(x).$\n\nTherefore, our function is\n$f(x)=$\n{{field-1}}." :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{2x+b}+c\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}2x+b & \\ge 0 \\\\ 2x & \\ge -b \\\\ x & \\ge -\\frac{b}{2}\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in [4,\\infty ),$ which is equivalent to $x\\ge 4.$ Hence, we obtain\n\n$$\n-\\frac{b}{2}=4\\,⟹\\,b=-8.\n$$\n\n- Since the range is unbounded on the right-hand side, we know that $a>0.$ Furthermore, since we are given that the lowest point in the range is $-1,$ we must have\n\n$$\n\\begin{aligned}{{a\\sqrt{2x-8}}_{⏟}}_{\\ge 0}+c\\ge -1.\\end{aligned}\n$$\n\nThis means that $c=-1.$\n\n- Finally, since the point $(6,3)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(6) & =3 \\\\ a\\sqrt{2(6)-8}-1 & =3 \\\\ 2a-1 & =3 \\\\ a & =2.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=2\\sqrt{2x-8}-1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a5ff4797-7c2a-514d-aa3d-bf7bbb62b553"] :db/ensure [:question/validate]} {:db/id "answer-field-a5ff4797-7c2a-514d-aa3d-bf7bbb62b553" :answer-field/id #uuid "a5ff4797-7c2a-514d-aa3d-bf7bbb62b553" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-813db01e-cf21-5292-addd-723299c9c19b" :answer-field/choices ["answer-813db01e-cf21-5292-addd-723299c9c19b"] :db/ensure [:answer-field/validate]} {:db/id "answer-813db01e-cf21-5292-addd-723299c9c19b" :answer/id #uuid "813db01e-cf21-5292-addd-723299c9c19b" :answer/type :answer.type/math :answer/value "2\\sqrt{2x-8}-1" :db/ensure [:answer/validate]} {:db/id "question-31d9f406-b6d6-5a07-bd60-36de4e4c1d5a" :question/id #uuid "31d9f406-b6d6-5a07-bd60-36de4e4c1d5a" :question/math-academy-id "q-115542" :question/problem "Let $f(x)=a\\sqrt{b-3x}.$ Now consider the following properties of $f(x):$\n\n- The domain of $f(x)$ is $x\\in (-\\infty ,1].$\n\n- The point $(-11,-24)$ lies on the graph of $y=f(x).$\n\nFind the value of $a+b.$" :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{b-3x}\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}b-3x & \\ge 0 \\\\ -3x & \\ge -b \\\\ x & \\le \\frac{b}{3}\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in (-\\infty ,1],$ which is equivalent to $x\\le 1.$ Hence, we obtain\n\n$$\n\\frac{b}{3}=1\\,⟹\\,b=3.\n$$\n\n- Since the point $(-11,-24)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(-11) & =a\\sqrt{3-3\\cdot (-11)} \\\\ -24 & =6a \\\\ a & =-4.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=-4\\sqrt{3-3x}$ and\n\n$$\na+b=-4+3=-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1df867aa-158a-5470-96c7-2a305d7a3650"] :db/ensure [:question/validate]} {:db/id "answer-field-1df867aa-158a-5470-96c7-2a305d7a3650" :answer-field/id #uuid "1df867aa-158a-5470-96c7-2a305d7a3650" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c761f43f-536d-5834-b501-01b7c6317e12" :answer-field/choices ["answer-c761f43f-536d-5834-b501-01b7c6317e12" "answer-3246c862-4dad-537f-bda3-2329a7720373" "answer-a80e8513-ebe8-5049-adf1-1a72124229f6" "answer-081ed565-5d0f-501c-9498-afa689f056b7" "answer-1b39913b-30d3-5924-9a1a-74b2bcaffb27"] :db/ensure [:answer-field/validate]} {:db/id "answer-c761f43f-536d-5834-b501-01b7c6317e12" :answer/id #uuid "c761f43f-536d-5834-b501-01b7c6317e12" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-3246c862-4dad-537f-bda3-2329a7720373" :answer/id #uuid "3246c862-4dad-537f-bda3-2329a7720373" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-a80e8513-ebe8-5049-adf1-1a72124229f6" :answer/id #uuid "a80e8513-ebe8-5049-adf1-1a72124229f6" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-081ed565-5d0f-501c-9498-afa689f056b7" :answer/id #uuid "081ed565-5d0f-501c-9498-afa689f056b7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-1b39913b-30d3-5924-9a1a-74b2bcaffb27" :answer/id #uuid "1b39913b-30d3-5924-9a1a-74b2bcaffb27" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186125802 :tutorial/content "The domain of a radical function is limited to the set of $x$-values that make the expression under the square root positive or zero. \n\nFor example, the domain of $\\sqrt{x}$ is $x \\geq 0,$ or $x \\in [0,\\infty)$ in interval notation.\n\nOn the other hand, the domain of $\\sqrt{-x}$ is given by\n\n$$\n-x \\geq 0\n$$\n\nwhich simplifies to\n\n$$\nx \\leq 0.\n$$\n\nThus, the domain of $\\sqrt{-x}$ is $x \\in (-\\infty, 0].$\n\nAs another example, the domain of $\\sqrt{x-1}$ is given by\n\n$$\nx -1 \\geq 0\n$$\n\nwhich simplifies to\n\n$$\nx \\geq 1,\n$$\n\nor $x \\in [1, \\infty)$ in interval notation. \n\nWe can also see that this is true from the graph of the function. The graph of $y=\\sqrt{x-1}$ is shown below.\n\n![](images/cb/cbae5f645d7774e114c483df27c8493c7e6a7f4fcf807ac7a14c54e4afa62105.png)\n\nIn general, to find the domain of a radical function of the form $y = \\sqrt{g(x)},$ we need to solve the inequality $g(x) \\geq 0.$" :db/ensure [:tutorial/validate]} {:db/id 17592186125803 :tutorial/content "Now, let's examine the range of a transformed radical function. For example, what is the range of \n\n$$\nf(x) = -3\\sqrt{5x-2}+7?\n$$\n\nThe range of $\\sqrt x$ is\n\n$$\n\\sqrt x \\ge 0.\n$$\n\nHorizontal shifts and stretches do not affect the range. So, we have\n\n$$\n\\sqrt{5x-2} \\ge 0.\n$$\n\nMultiplying the above inequality by $-3$ and then adding $7,$ we get\n\n$$\n\\begin{aligned}\\sqrt{5x-2} & \\ge 0 \\\\ -3\\sqrt{5x-2} & \\le 0 \\\\ -3\\sqrt{5x-2}+7 & \\le 7.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x) \\in (-\\infty,7].$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/26/2651dbfeff426df9973c56c60e1d947a069b5b8c7a12281b095a878ba3de0f42.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186125827 :tutorial/content "To find the roots of a transformed radical function, we must set the function expression equal to zero and solve for $x.$ \n\nFor instance, what are the roots of $f(x) = \\sqrt{2x+1} + 5?$\n\nIn this case, we set\n\n$$\n\\sqrt{2x+1} + 5 = 0.\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt{2x+1}+5 & =0 \\\\ \\sqrt{2x+1} & =-5\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots." :db/ensure [:tutorial/validate]} {:db/id 17592186124687 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]}]
