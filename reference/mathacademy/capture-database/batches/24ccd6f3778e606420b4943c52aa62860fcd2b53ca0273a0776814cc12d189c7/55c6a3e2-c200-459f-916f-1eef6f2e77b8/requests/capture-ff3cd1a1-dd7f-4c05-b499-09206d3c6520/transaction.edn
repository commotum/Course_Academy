2962aa-1f8a-5106-8afe-8f1d72596893" :db/ensure [:activity/validate]} {:db/id "step-712962aa-1f8a-5106-8afe-8f1d72596893" :step/id #uuid "712962aa-1f8a-5106-8afe-8f1d72596893" :step/content 17592186323940 :step/next "step-4d30d155-c0af-5612-bddd-5c0adca752a1" :db/ensure [:step/validate]} {:db/id "step-4d30d155-c0af-5612-bddd-5c0adca752a1" :step/id #uuid "4d30d155-c0af-5612-bddd-5c0adca752a1" :step/content 17592186125140 :step/next "step-aa57e7bc-ae6a-50ca-b096-5a8dfd3e3450" :db/ensure [:step/validate]} {:db/id "step-aa57e7bc-ae6a-50ca-b096-5a8dfd3e3450" :step/id #uuid "aa57e7bc-ae6a-50ca-b096-5a8dfd3e3450" :step/content 17592186392225 :step/next "step-29abcc68-95f8-5957-a518-0a35c26f28c7" :db/ensure [:step/validate]} {:db/id "step-29abcc68-95f8-5957-a518-0a35c26f28c7" :step/id #uuid "29abcc68-95f8-5957-a518-0a35c26f28c7" :step/content 17592186326811 :step/next "step-f73f0739-b0b6-5a0b-9fac-ab5fdff3e3e1" :db/ensure [:step/validate]} {:db/id "step-f73f0739-b0b6-5a0b-9fac-ab5fdff3e3e1" :step/id #uuid "f73f0739-b0b6-5a0b-9fac-ab5fdff3e3e1" :step/content "question-c746a2db-cfe0-519b-a0f3-936f85b88bb1" :db/ensure [:step/validate]} [:db/retract 17592186109999 :answer-field/choices 17592186110000] [:db/retract 17592186109999 :answer-field/choices 17592186110001] [:db/retract 17592186109999 :answer-field/choices 17592186110002] [:db/retract 17592186109999 :answer-field/choices 17592186110003] [:db/retract 17592186109999 :answer-field/choices 17592186110004] {:db/id 17592186110618 :knowledge-point/questions ["question-1c3254bb-eb8f-59e1-a128-72e91c02e801" "question-d5189edd-f130-58fd-8d29-2cbc5d8ac007"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110616 :knowledge-point/questions ["question-36a9c58b-16ed-5e45-8d2f-0e6e4f6d6155" "question-b69e62da-cda1-5fdc-b265-282dc6bf87a3" "question-28a7fe0c-c381-5328-b14b-f7e94addebec"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110506 :question/worked-solution "First, we rewrite the second factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{4}^{8}\\cdot {(\\frac{7}{4})}^{5}={4}^{8}\\cdot \\frac{{7}^{5}}{{4}^{5}}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n4^{8} \\cdot  \\dfrac{7^5}{4^5} =  \\dfrac{4^8}{4^5} \\cdot 7^5\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n\\dfrac{4^8}{4^5} \\cdot 7^5 =4^{8-5}\\cdot 7^5=4^{3}\\cdot 7^5\n$$" :db/ensure [:question/validate]} {:db/id 17592186110617 :knowledge-point/questions ["question-fc6b5400-6a2c-5728-9ed9-612fe98f6796"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c3254bb-eb8f-59e1-a128-72e91c02e801" :question/id #uuid "1c3254bb-eb8f-59e1-a128-72e91c02e801" :question/math-academy-id "q-100753" :question/problem "$\\frac{(-5)^{7}\\cdot (-5)^{5}}{(-5)^{8}}=$" :question/worked-solution "First, we rewrite the numerator using the product rule for exponents:\n\n$$\n\\frac{(-5)^{7}\\cdot (-5)^{5}}{(-5)^{8}}=\\frac{(-5)^{7+5}}{(-5)^{8}}=\\frac{(-5)^{12}}{(-5)^{8}}\n$$\n\nThen, we use the quotient rule for exponents:\n\n$$\n\\frac{(-5)^{12}}{(-5)^{8}}=(-5)^{12-8}=(-5)^{4}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e85d9c7b-abee-51e3-954a-2ca7b108dff4"] :db/ensure [:question/validate]} {:db/id "answer-field-e85d9c7b-abee-51e3-954a-2ca7b108dff4" :answer-field/id #uuid "e85d9c7b-abee-51e3-954a-2ca7b108dff4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-883ecb23-a3ed-5339-abf5-72e6c3f0dc59" :answer-field/choices ["answer-fcbcd7d7-1a08-5ac7-8d28-9ca7d64f86be" "answer-883ecb23-a3ed-5339-abf5-72e6c3f0dc59" "answer-1c83d900-d2dd-5e86-b9eb-84fb851c17ba" "answer-08da2468-e440-59f8-9406-34205264ad2f" "answer-1103329e-ce21-53e1-9e9b-c1dd66995c8b"] :db/ensure [:answer-field/validate]} {:db/id "answer-fcbcd7d7-1a08-5ac7-8d28-9ca7d64f86be" :answer/id #uuid "fcbcd7d7-1a08-5ac7-8d28-9ca7d64f86be" :answer/type :answer.type/math :answer/value "(-5)^{3}" 