align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\">\n{{field-4}}\n</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$11$</td>\n<td align=\"center\">$-3$</td>\n<td align=\"center\">\n{{field-5}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${B}^{2},$ we multiply $B$ by itself:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -1 & 4 \\\\ 3 & 1 & 1 \\\\ 11 & -3 & 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-459b0486-2cc5-556f-b20a-9563f4ecc1a7" "answer-field-e3382c5a-5ae4-5f97-b1d5-55746ea662a4" "answer-field-04fc8c65-5979-5818-b2df-b511ed097117" "answer-field-076ad971-056c-5b6d-b1e5-ec23e7e52bbf" "answer-field-39d457ca-d914-502e-ad23-85724a0daabc"] :db/ensure [:question/validate]} {:db/id "answer-field-459b0486-2cc5-556f-b20a-9563f4ecc1a7" :answer-field/id #uuid "459b0486-2cc5-556f-b20a-9563f4ecc1a7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-67d10dd3-0c20-55f4-80c5-c44e7f2d8ec1" :answer-field/choices ["answer-67d10dd3-0c20-55f4-80c5-c44e7f2d8ec1"] :db/ensure [:answer-field/validate]} {:db/id "answer-67d10dd3-0c20-55f4-80c5-c44e7f2d8ec1" :answer/id #uuid "67d10dd3-0c20-55f4-80c5-c44e7f2d8ec1" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-e3382c5a-5ae4-5f97-b1d5-55746ea662a4" :answer-field/id #uuid "e3382c5a-5ae4-5f97-b1d5-55746ea662a4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answe