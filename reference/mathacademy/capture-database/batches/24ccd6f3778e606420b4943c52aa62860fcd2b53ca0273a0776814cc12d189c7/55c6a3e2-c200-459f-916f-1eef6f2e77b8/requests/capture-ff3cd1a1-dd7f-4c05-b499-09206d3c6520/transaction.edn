bcd3-5b782affce54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84cfb290-8ccd-590d-aa27-4683d7aaed7e" :answer-field/choices ["answer-84cfb290-8ccd-590d-aa27-4683d7aaed7e" "answer-b037c639-2022-5ee4-afbe-0e75ebb6c03a" "answer-d1f63688-9724-5079-be15-ff720f739366" "answer-9c413feb-3e7c-58c3-ad79-38bc3137398f" "answer-c0acb70e-83fd-51d9-983c-cbded421e64c"] :db/ensure [:answer-field/validate]} {:db/id "answer-84cfb290-8ccd-590d-aa27-4683d7aaed7e" :answer/id #uuid "84cfb290-8ccd-590d-aa27-4683d7aaed7e" :answer/type :answer.type/text :answer/value "$$0$" :db/ensure [:answer/validate]} {:db/id "answer-b037c639-2022-5ee4-afbe-0e75ebb6c03a" :answer/id #uuid "b037c639-2022-5ee4-afbe-0e75ebb6c03a" :answer/type :answer.type/text :answer/value "$$20$" :db/ensure [:answer/validate]} {:db/id "answer-d1f63688-9724-5079-be15-ff720f739366" :answer/id #uuid "d1f63688-9724-5079-be15-ff720f739366" :answer/type :answer.type/text :answer/value "$$40$" :db/ensure [:answer/validate]} {:db/id "answer-9c413feb-3e7c-58c3-ad79-38bc3137398f" :answer/id #uuid "9c413feb-3e7c-58c3-ad79-38bc3137398f" :answer/type :answer.type/text :answer/value "$-$20$" :db/ensure [:answer/validate]} {:db/id "answer-c0acb70e-83fd-51d9-983c-cbded421e64c" :answer/id #uuid "c0acb70e-83fd-51d9-983c-cbded421e64c" :answer/type :answer.type/text :answer/value "$-$40$" :db/ensure [:answer/validate]} {:db/id "question-caba3d37-19c8-51f8-9627-60834d1806c5" :question/id #uuid "caba3d37-19c8-51f8-9627-60834d1806c5" :question/math-academy-id "q-357097" :question/problem "The temperature inside an oven **dropped by** ${25}^{∘}\\,\\text{C}$ when the door was opened. Then it **rose by** ${25}^{∘}\\,\\text{C}$ when the door was closed.\n\nWhich of the following statements are true?\n\nI. The temperature is now lower than the initial value.\n\nII. The temperature returned to the initial value.\n\nIII. The temperature is now larger than the initial value." :question/worked-solution "In our situation:\n\n- When the door was opened, the temperature *dropped by* ${25}^{∘}\\,\\text{C}$, which is a change of $-{25}^{∘}\\,\\text{C}.$\n\n- When the door was closed, the temperature *rose by* ${25}^{∘}\\,\\text{C},$ which is a change of $+{25}^{∘}\\,\\text{C}.$\n\nThese two changes are *opposite quantities*. When opposite quantities combine, they make $0:$\n\n$$\n-25+25=0\n$$\n\nThis means the *total temperature change* is ${0}^{∘}\\,\\text{C},$ so the temperature returns to its original value.\n\nSo, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b10fe7e3-ee29-5950-b544-d1a41e9a2d44"] :db/ensure [:question/validate]} {:db/id "answer-field-b10fe7e3-ee29-5950-b544-d1a41e9a2d44" :answer-field/id #uuid "b10fe7e3-ee29-5950-b544-d1a41e9a2d44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b6641b91-f000-597b-96aa-8b3e773ca1d3" :answer-field/choices ["answer-09d05043-ffb9-54b3-b4cb-eadb56501804" "answer-75746c38-5356-5b1d-a3d3-cc7b4ea5c6f1" "answer-b6641b91-f000-597b-96aa-8b3e773ca1d3" "answer-17f35cba-c71a-5ad7-833b-9439eb84c575" "answer-9407b62d-ffa5-58a3-8579-5716cb7de206"] :db/ensure [:answer-field/validate]} {:db/id "answer-09d05043-ffb9-54b3-b4cb-eadb56501804" :answer/id #uuid "09d05043-ffb9-54b3-b4cb-eadb56501804" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-75746c38-5356-5b1d-a3d3-cc7b4ea5c6f1" :answer/id #uuid "75746c38-5356-5b1d-a3d3-cc7b4ea5c6f1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-b6641b91-f000-597b-96aa-8b3e773ca1d3" :answer/id #uuid "b6641b91-f000-597b-96aa-8b3e773ca1d3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-17f35cba-c71a-5ad7-833b-9439eb84c575" :answer/id #uuid "17f35cba-c71a-5ad7-833b-9439eb84c575" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-9407b62d-ffa5-58a3-8579-5716cb7de206" :answer/id #uuid "9407b62d-ffa5-58a3-8579-5716cb7de206" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-ef66e122-a2b4-5616-86af-6621c724508e" :question/id #uuid "ef66e122-a2b4-5616-86af-6621c724508e" :question/math-academy-id "q-356997" :question/problem "A drone’s elevation **rose by** $85\\text{ m}$ while flying up to a roof. Then it **dropped by** $85\\text{ m}$ while descending back to the pilot.\nWhich of the following statements are true?\n\nI. The drone's elevation is now higher than the initial elevation.\n\nII. The drone returned to the initial elevation.\n\nIII. The drone's elevation is now lower than the initial elevation." :question/worked-solution "In our situation:\n\n- While flying up to a roof, the drone’s elevation *rose by* $85\\text{ m}$, which is a change of $+85\\text{ m}.$\n\n- While descending back to the pilot, the drone’s elevation *dropped by* $85\\text{ m},$ which is a change of $-85\\text{ m}.$\n\nThese two changes are *opposite quantities*. When opposite quantities combine, they make $0:$\n\n$$\n85+(-85)=0\n$$\n\nThis means the *total elevation change* is $0\\text{ m},$ so the drone returns to the original elevation.\n\nSo, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f4683f9-9c21-5e8a-bbee-d3ba5dd3dafe"] :db/ensure [:question/validate]} {:db/id "answer-field-8f4683f9-9c21-5e8a-bbee-d3ba5dd3dafe" :answer-field/id #uuid "8f4683f9-9c21-5e8a-bbee-d3ba5dd3dafe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc60c973-4861-5ee3-96d6-e6ef18377082" :answer-field/choices ["answer-8925d033-ba54-59a9-9aca-dcf29388620c" "answer-3faeae4d-7a22-58a6-9532-93cf78868277" "answer-cc60c973-4861-5ee3-96d6-e6ef18377082" "answer-dcdef934-a585-5434-8be6-9e95072f0b15" "answer-2a240731-37c3-544a-8985-4c388b8dd124"] :db/ensure [:answer-field/validate]} {:db/id "answer-8925d033-ba54-59a9-9aca-dcf29388620c" :answer/id #uuid "8925d033-ba54-59a9-9aca-dcf29388620c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-3faeae4d-7a22-58a6-9532-93cf78868277" :answer/id #uuid "3faeae4d-7a22-58a6-9532-93cf78868277" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-cc60c973-4861-5ee3-96d6-e6ef18377082" :answer/id #uuid "cc60c973-4861-5ee3-96d6-e6ef18377082" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-dcdef934-a585-5434-8be6-9e95072f0b15" :answer/id #uuid "dcdef934-a585-5434-8be6-9e95072f0b15" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-2a240731-37c3-544a-8985-4c388b8dd124" :answer/id #uuid "2a240731-37c3-544a-8985-4c388b8dd124" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-fe75ee40-dd66-5b6a-be0b-41d26c4e980f" :question/id #uuid "fe75ee40-dd66-5b6a-be0b-41d26c4e980f" :question/math-academy-id "q-356982" :question/problem "Let $x=-5$ and $y=8.$ What point on the number line corresponds to $x+y?$" :question/worked-solution "The value of $x+y$ is the number located a distance $|y|$ from $x$ on the number line, \n\n- moving to the *right* if $y$ is *positive*, and\n\n- moving to the *left* if $y$ is *negative*.\n\nIn our situation:\n\n- We start at $x=-5$ on the number line.\n\n- Here, $y=8$, so the distance we move is $|y|=8.$\n\n- Because $y$ is *positive*, we move $8$ units to the *right* from $-5.$\n\n![](images/6f/6f3852a3695e81aa36441b6e579cce31c337aa81aa5af8ee2944bdcce7fb76d3.png)\n\nThis point corresponds to the number\n\n$$\n-5+8=3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9b678d2a-3f69-50d5-841e-afd7ff418930"] :db/ensure [:question/validate]} {:db/id "answer-field-9b678d2a-3f69-50d5-841e-afd7ff418930" :answer-field/id #uuid "9b678d2a-3f69-50d5-841e-afd7ff418930" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-122f3eb5-2bd7-59a3-826b-79b8d14830c4" :answer-field/choices ["answer-ca24ff1b-a0e4-5917-85b7-7f99552c72ff" "answer-db7931af-c972-55c9-92aa-6d922aa80776" "answer-afc28c25-c38a-52de-999c-9758ec38dd31" "answer-b3f015b4-a229-5c1c-8fb0-f5f7cea2c939" "answer-122f3eb5-2bd7-59a3-826b-79b8d14830c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca24ff1b-a0e4-5917-85b7-7f99552c72ff" :answer/id #uuid "ca24ff1b-a0e4-5917-85b7-7f99552c72ff" :answer/type :answer.type/text :answer/value "It's the number $-3$ located $8$ units to the left of $-5.$" :db/ensure [:answer/validate]} {:db/id "answer-db7931af-c972-55c9-92aa-6d922aa80776" :answer/id #uuid "db7931af-c972-55c9-92aa-6d922aa80776" :answer/type :answer.type/text :answer/value "It's the number $-3$ located $8$ units to the right of $-5.$" :db/ensure [:answer/validate]} {:db/id "answer-afc28c25-c38a-52de-999c-9758ec38dd31" :answer/id #uuid "afc28c25-c38a-52de-999c-9758ec38dd31" :answer/type :answer.type/text :answer/value "It's the number $3$ located $5$ units to the right of $8.$" :db/ensure [:answer/validate]} {:db/id "answer-b3f015b4-a229-5c1c-8fb0-f5f7cea2c939" :answer/id #uuid "b3f015b4-a229-5c1c-8fb0-f5f7cea2c939" :answer/type :answer.type/text :answer/value "It's the number $3$ located $8$ units to the left of $-5.$" :db/ensure [:answer/validate]} {:db/id "answer-122f3eb5-2bd7-59a3-826b-79b8d14830c4" :answer/id #uuid "122f3eb5-2bd7-59a3-826b-79b8d14830c4" :answer/type :answer.type/text :answer/value "It's the number $3$ located $8$ units to the right of $-5.$" :db/ensure [:answer/validate]} {:db/id "question-b2201c29-9c53-5378-91b2-19915c1b3e60" :question/id #uuid "b2201c29-9c53-5378-91b2-19915c1b3e60" :question/math-academy-id "q-357009" :question/problem "Let $p=1$ and $q=-6.$ What point on the number line corresponds to $p+q?$" :question/worked-solution "The value of $p+q$ is the number located a distance $|q|$ from $p$ on the number line, \n\n- moving to the *right* if $q$ is *positive*, and\n\n- moving to the *left* if $q$ is *negative*.\n\nIn our situation:\n\n- We start at $p=1$ on the number line.\n\n- Here, $q=-6$, so the distance we move is $|q|=6.$\n\n- Because $q$ is *negative*, we move $6$ units to the *left* from $1.$\n\n![](images/f4/f488d1dc3787fefc588e143e7808fee7e4473a9918986b49bc36344e6a153b25.png)\n\nThis point corresponds to the number\n\n$$\n1+(-6)=-5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fe3dc164-1594-57e4-92cf-6547e4c7625a"] :db/ensure [:question/validate]} {:db/id "answer-field-fe3dc164-1594-57e4-92cf-6547e4c7625a" :answer-field/id #uuid "fe3dc164-1594-57e4-92cf-6547e4c7625a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-49c8390b-831a-5e22-9a5a-aa8232f54972" :answer-field/choices ["answer-08e9e8c9-31a0-5e60-b977-a4bce4aacf19" "answer-49c8390b-831a-5e22-9a5a-aa8232f54972" "answer-5acd367d-d857-54b8-af86-04191b89d45c" "answer-79bc2c29-b9c8-50a5-b4eb-12efd2b0d95f" "answer-d0e280b8-2b2c-5df9-a631-0adc13f36f3c"] :db/ensure [:answer-field/validate]} {:db/id "answer-08e9e8c9-31a0-5e60-b977-a4bce4aacf19" :answer/id #uuid "08e9e8c9-31a0-5e60-b977-a4bce4aacf19" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $1$ unit to the right of $6.$" :db/ensure [:answer/validate]} {:db/id "answer-49c8390b-831a-5e22-9a5a-aa8232f54972" :answer/id #uuid "49c8390b-831a-5e22-9a5a-aa8232f54972" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $6$ units to the left of $1.$" :db/ensure [:answer/validate]} {:db/id "answer-5acd367d-d857-54b8-af86-04191b89d45c" :answer/id #uuid "5acd367d-d857-54b8-af86-04191b89d45c" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $6$ units to the right of $1.$" :db/ensure [:answer/validate]} {:db/id "answer-79bc2c29-b9c8-50a5-b4eb-12efd2b0d95f" :answer/id #uuid "79bc2c29-b9c8-50a5-b4eb-12efd2b0d95f" :answer/type :answer.type/text :answer/value "It's the number $5$ located $6$ units to the left of $1.$" :db/ensure [:answer/validate]} {:db/id "answer-d0e280b8-2b2c-5df9-a631-0adc13f36f3c" :answer/id #uuid "d0e280b8-2b2c-5df9-a631-0adc13f36f3c" :answer/type :answer.type/text :answer/value "It's the number $5$ located $6$ units to the right of $1$" :db/ensure [:answer/validate]} {:db/id "question-3e975e85-092f-5a1a-be8e-b7301eb722e2" :question/id #uuid "3e975e85-092f-5a1a-be8e-b7301eb722e2" :question/math-academy-id "q-357007" :question/problem "Let $p=-6$ and $q=9.$ What point on the number line corresponds to $p+q?$" :question/worked-solution "The value of $p+q$ is the number located a distance $|q|$ from $p$ on the number line, \n\n- moving to the *right* if $q$ is *positive*, and\n\n- moving to the *left* if $q$ is *negative*.\n\nIn our situation:\n\n- We start at $p=-6$ on the number line.\n\n- Here, $q=9$, so the distance we move is $|q|=9.$\n\n- Because $q$ is *positive*, we move $9$ units to the *right* from $-6.$\n\n![](images/17/17c56561e34f16a80df8ee8872401f7a3df4930c28c38ce70c1dcf202269f3d0.png)\n\nThis point corresponds to the number\n\n$$\n-6+9=3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bfc83496-ab8e-51f7-b8d9-81dec906fb5a"] :db/ensure [:question/validate]} {:db/id "answer-field-bfc83496-ab8e-51f7-b8d9-81dec906fb5a" :answer-field/id #uuid "bfc83496-ab8e-51f7-b8d9-81dec906fb5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37e293ca-fd34-56bb-a2d5-33687c3d5855" :answer-field/choices ["answer-7a03d7b9-f033-5945-a9a4-7e8b1c0ae329" "answer-07472916-38b0-59bb-a457-2a4fc33c51b8" "answer-f4f51ac5-69d4-5a8a-9881-b8eba317c491" "answer-92a6ef2e-c855-5d1e-a6f6-b70161e7c037" "answer-37e293ca-fd34-56bb-a2d5-33687c3d5855"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a03d7b9-f033-5945-a9a4-7e8b1c0ae329" :answer/id #uuid "7a03d7b9-f033-5945-a9a4-7e8b1c0ae329" :answer/type :answer.type/text :answer/value "It's the number $-3$ located $9$ units to the left of $-6.$" :db/ensure [:answer/validate]} {:db/id "answer-07472916-38b0-59bb-a457-2a4fc33c51b8" :answer/id #uuid "07472916-38b0-59bb-a457-2a4fc33c51b8" :answer/type :answer.type/text :answer/value "It's the number $-3$ located $9$ units to the right of $-6.$" :db/ensure [:answer/validate]} {:db/id "answer-f4f51ac5-69d4-5a8a-9881-b8eba317c491" :answer/id #uuid "f4f51ac5-69d4-5a8a-9881-b8eba317c491" :answer/type :answer.type/text :answer/value "It's the number $3$ located $6$ units to the right of $9.$" :db/ensure [:answer/validate]} {:db/id "answer-92a6ef2e-c855-5d1e-a6f6-b70161e7c037" :answer/id #uuid "92a6ef2e-c855-5d1e-a6f6-b70161e7c037" :answer/type :answer.type/text :answer/value "It's the number $3$ located $9$ units to the left of $-6.$" :db/ensure [:answer/validate]} {:db/id "answer-37e293ca-fd34-56bb-a2d5-33687c3d5855" :answer/id #uuid "37e293ca-fd34-56bb-a2d5-33687c3d5855" :answer/type :answer.type/text :answer/value "It's the number $3$ located $9$ units to the right of $-6.$" :db/ensure [:answer/validate]} {:db/id "question-5daaab8a-c401-527b-849d-4cd75e79ca94" :question/id #uuid "5daaab8a-c401-527b-849d-4cd75e79ca94" :question/math-academy-id "q-356985" :question/problem "Let $u=4$ and $v=-9.$ What point on the number line corresponds to $u+v?$" :question/worked-solution "The value of $u+v$ is the number located a distance $|v|$ from $u$ on the number line, \n\n- moving to the *right* if $v$ is *positive*, and\n\n- moving to the *left* if $v$ is *negative*.\n\nIn our situation:\n\n- We start at $u=4$ on the number line.\n\n- Here, $v=-9$, so the distance we move is $|v|=9.$\n\n- Because $v$ is *negative*, we move $9$ units to the *left* from $4.$\n\n![](images/79/79c5200c6f0089f7b6cf6be0eec8b97de3ff3a3daa270bfa6e7ae0c480b134f5.png)\n\nThis point corresponds to the number\n\n$$\n4+(-9)=-5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-06e00fbc-e98b-51ea-9bd5-55bb5ceb760f"] :db/ensure [:question/validate]} {:db/id "answer-field-06e00fbc-e98b-51ea-9bd5-55bb5ceb760f" :answer-field/id #uuid "06e00fbc-e98b-51ea-9bd5-55bb5ceb760f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe39958e-4d16-547a-b78d-9abaafc84aa9" :answer-field/choices ["answer-7878abb2-a11b-59c9-9bae-7e232650f3ea" "answer-fe39958e-4d16-547a-b78d-9abaafc84aa9" "answer-3a49ffd0-69f7-5e09-bdfb-755e2f1ce19d" "answer-1618c5c4-03ee-55c3-8b45-973252793ff7" "answer-3a7ef876-0c99-59d3-ab8b-3570c64020e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-7878abb2-a11b-59c9-9bae-7e232650f3ea" :answer/id #uuid "7878abb2-a11b-59c9-9bae-7e232650f3ea" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $4$ units to the right of $9.$" :db/ensure [:answer/validate]} {:db/id "answer-fe39958e-4d16-547a-b78d-9abaafc84aa9" :answer/id #uuid "fe39958e-4d16-547a-b78d-9abaafc84aa9" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $9$ units to the left of $4.$" :db/ensure [:answer/validate]} {:db/id "answer-3a49ffd0-69f7-5e09-bdfb-755e2f1ce19d" :answer/id #uuid "3a49ffd0-69f7-5e09-bdfb-755e2f1ce19d" :answer/type :answer.type/text :answer/value "It's the number $-5$ located $9$ units to the right of $4.$" :db/ensure [:answer/validate]} {:db/id "answer-1618c5c4-03ee-55c3-8b45-973252793ff7" :answer/id #uuid "1618c5c4-03ee-55c3-8b45-973252793ff7" :answer/type :answer.type/text :answer/value "It's the number $5$ located $9$ units to the left of $4.$" :db/ensure [:answer/validate]} {:db/id "answer-3a7ef876-0c99-59d3-ab8b-3570c64020e6" :answer/id #uuid "3a7ef876-0c99-59d3-ab8b-3570c64020e6" :answer/type :answer.type/text :answer/value "It's the number $5$ located $9$ units to the right of $4.$" :db/ensure [:answer/validate]} {:db/id "tutorial-d29afdb4-83a8-5d44-85aa-588cb62c58d8" :tutorial/id #uuid "d29afdb4-83a8-5d44-85aa-588cb62c58d8" :tutorial/math-academy-id 15163 :tutorial/title "Introduction" :tutorial/content "On a number line, a number and its *additive inverse* are at the same distance from zero but on opposite sides. Remember that the distance of a number from zero is given by its *absolute value*.\n\nFor instance, the only two numbers that are at a distance of $4$ from zero are $4$ and $-4.$ So, $-4$ is the additive inverse of $4$ (and vice versa).\n\n![](images/c0/c0ac86b7f6b42079f164e07e9c0f7c8e35589c1eb8b1fe8762094ff1a59d0d5c.png)" :db/ensure [:tutorial/validate]} {:db/id "tutorial-f0d64651-a1e2-53b0-889b-8b5a7d8cddd6" :tutorial/id #uuid "f0d64651-a1e2-53b0-889b-8b5a7d8cddd6" :tutorial/math-academy-id 15172 :tutorial/title "Opposite Quantities Combine to Zero" :tutorial/content "Suppose that a bank account had an *initial balance* of $\\[math]0.$ During the day, there was a *withdrawal* of $\\[/math]80.$ Then there was a *deposit* of $\\[math]80$ later.  \n\nWhat is the resulting amount in the account?\n\nIn our situation:\n\n- During the day, the account had a *withdrawal of* $\\[/math]80,$ which is a change of $-\\[math]80.$\n\n- Later, the account had a *deposit of* $\\[/math]80,$ which is a change of $+\\[math]80.$\n\nThese two changes are *opposite quantities*. When opposite quantities combine, they make $0{:}$\n\n$$\n-80 + 80 = 0\n$$\n\nTherefore, the balance returns to its original value of $\\[/math]0.$" :db/ensure [:tutorial/validate]} {:db/id "tutorial-e93c19c4-c6b0-531d-b9a0-f2a16df8a410" :tutorial/id #uuid "e93c19c4-c6b0-531d-b9a0-f2a16df8a410" :tutorial/math-academy-id 15173 :tutorial/title "Addition and Absolute Values on the Number Line" :tutorial/content "Now, let $p=6$ and $q=-9.$ What point on the number line corresponds to $p+q?$\n\nThe value of $p+q$ is the number located a distance $|q|$ from $p$ on the number line, \n\n- moving to the *right* if $q$ is *positive*, and\n\n- moving to the *left* if $q$ is *negative*.\n\nIn our situation:\n\n- We start at $p = 6$ on the number line.\n\n- Here, $q = -9$, so the distance we move is $|q| = 9.$\n\n- Because $q$ is *negative*, we move $9$ units to the *left* from $6.$\n\n![](images/26/265469a65efa2ae63d794ee2ad0eeb79c6754ab18a7bec3791b8ba05007a744e.png)\n\nThis point corresponds to the number\n\n$$\n6 + (-9) = -3.\n$$" :db/ensure [:tutorial/validate]} {:db/id "activity-7e4b88a3-5d2d-5fd8-b226-94be09e3ceb9" :activity/id #uuid "7e4b88a3-5d2d-5fd8-b226-94be09e3ceb9" :activity/title "Interpreting Additive Opposites and Addition Using Absolute Value" :activity/type :activity.type/lesson :activity/scope 17592186408186 :activity/expected-seconds 420.0 :activity/steps ["step-31b8f5ad-d1ac-5b65-a264-059708293d82" "step-160c60e9-5ab9-50b5-945e-8198d95f11e8" "step-9f48a277-1ef5-5804-98e6-8970d7e2ee30" "step-93b60de0-a7f7-5e60-b050-2b523dabb82e" "step-903b1e70-5068-5da3-8e39-2277b886461a" "step-44f3d1e3-06b3-5448-ac19-3aaeecc7c475"] :activity/first-step "step-31b8f5ad-d1ac-5b65-a264-059708293d82" :db/ensure [:activity/validate]} {:db/id "step-31b8f5ad-d1ac-5b65-a264-059708293d82" :step/id #uuid "31b8f5ad-d1ac-5b65-a264-059708293d82" :step/content "tutorial-d29afdb4-83a8-5d44-85aa-588cb62c58d8" :step/math-academy-id 621964 :step/next "step-160c60e9-5ab9-50b5-945e-8198d95f11e8" :db/ensure [:step/validate]} {:db/id "step-160c60e9-5ab9-50b5-945e-8198d95f11e8" :step/id #uuid "160c60e9-5ab9-50b5-945e-8198d95f11e8" :step/content "knowledge-point-fdab7649-2d4d-5516-bf04-cfe674bbd3f8" :step/math-academy-id 621965 :step/next "step-9f48a277-1ef5-5804-98e6-8970d7e2ee30" :db/ensure [:step/validate]} {:db/id "step-9f48a277-1ef5-5804-98e6-8970d7e2ee30" :step/id #uuid "9f48a277-1ef5-5804-98e6-8970d7e2ee30" :step/content "tutorial-f0d64651-a1e2-53b0-889b-8b5a7d8cddd6" :step/math-academy-id 621969 :step/next "step-93b60de0-a7f7-5e60-b050-2b523dabb82e" :db/ensure [:step/validate]} {:db/id "step-93b60de0-a7f7-5e60-b050-2b523dabb82e" :step/id #uuid "93b60de0-a7f7-5e60-b050-2b523dabb82e" :step/content "knowledge-point-056c4886-b3e9-575a-b584-1840a577d04e" :step/math-academy-id 621970 :step/next "step-903b1e70-5068-5da3-8e39-2277b886461a" :db/ensure [:step/validate]} {:db/id "step-903b1e70-5068-5da3-8e39-2277b886461a" :step/id #uuid "903b1e70-5068-5da3-8e39-2277b886461a" :step/content "tutorial-e93c19c4-c6b0-531d-b9a0-f2a16df8a410" :step/math-academy-id 621974 :step/next "step-44f3d1e3-06b3-5448-ac19-3aaeecc7c475" :db/ensure [:step/validate]} {:db/id "step-44f3d1e3-06b3-5448-ac19-3aaeecc7c475" :step/id #uuid "44f3d1e3-06b3-5448-ac19-3aaeecc7c475" :step/content "knowledge-point-dcbb661f-40e5-5926-8387-8720b43e57de" :step/math-academy-id 621975 :db/ensure [:step/validate]} [:db/retract 17592186166466 :answer-field/choices 17592186166467] [:db/retract 17592186166466 :answer-field/choices 17592186166468] [:db/retract 17592186166466 :answer-field/choices 17592186166469] [:db/retract 17592186166466 :answer-field/choices 17592186166470] [:db/retract 17592186166466 :answer-field/choices 17592186166471] {:db/id 17592186166835 :knowledge-point/questions ["question-c2c660e0-cf11-56d9-9d4f-3449a41167f3" "question-8febc0ce-a013-5227-b117-55a62f849158" "question-da6d9860-f69d-5d57-89ed-5b37be24ddaf" "question-8bfa2936-0cfa-5b9c-b815-96a80b635940"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166836 :knowledge-point/questions ["question-818ba628-d4d7-5ed9-973b-a4ac0ea776b4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166837 :knowledge-point/questions ["question-c8e555e8-b363-57e5-af62-374122f991ee" "question-bb6bca21-eef1-511a-9545-14146c32b845" "question-b10a522e-2ca7-50dc-98ce-c79fed01cd4f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c2c660e0-cf11-56d9-9d4f-3449a41167f3" :question/id #uuid "c2c660e0-cf11-56d9-9d4f-3449a41167f3" :question/math-academy-id "q-127612" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{2}⟨\\sqrt{3},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩, \\\\ N(t) & =⟨0,-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{2}⟨\\sqrt{3},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{2}\\left|\\begin{aligned}i & j & k \\\\ \\sqrt{3} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{2}[\\text{ }\\left|\\begin{aligned}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\sqrt{3} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\sqrt{3} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{2}⟨({sin}^{2}⁡t-(-{cos}^{2}⁡t)),-(-\\sqrt{3}\\operatorname{sin}⁡t-0),(-\\sqrt{3}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{2}⟨1,\\sqrt{3}\\operatorname{sin}⁡t,-\\sqrt{3}\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-42dd43f0-f4c7-5c5f-9fd8-9efa733dad89"] :db/ensure [:question/validate]} {:db/id "answer-field-42dd43f0-f4c7-5c5f-9fd8-9efa733dad89" :answer-field/id #uuid "42dd43f0-f4c7-5c5f-9fd8-9efa733dad89" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76c40781-b607-5cd9-9d60-36ce71e2a7ed" :answer-field/choices ["answer-a5c0152b-83d2-5b8d-9343-96df53ed9b40" "answer-76c40781-b607-5cd9-9d60-36ce71e2a7ed" "answer-cf43edcf-7e65-57a5-b57e-f9bee6b95852" "answer-2e6684f7-7607-5c50-8a99-f0423b0f6cff" "answer-3993447f-c94c-5806-9658-5a3fd2138263"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5c0152b-83d2-5b8d-9343-96df53ed9b40" :answer/id #uuid "a5c0152b-83d2-5b8d-9343-96df53ed9b40" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨-\\sqrt{3}\\operatorname{sin}⁡t,1,-\\sqrt{3}\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "answer-76c40781-b607-5cd9-9d60-36ce71e2a7ed" :answer/id #uuid "76c40781-b607-5cd9-9d60-36ce71e2a7ed" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨1,\\sqrt{3}\\operatorname{sin}⁡t,-\\sqrt{3}\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "answer-cf43edcf-7e65-57a5-b57e-f9bee6b95852" :answer/id #uuid "cf43edcf-7e65-57a5-b57e-f9bee6b95852" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "answer-2e6684f7-7607-5c50-8a99-f0423b0f6cff" :answer/id #uuid "2e6684f7-7607-5c50-8a99-f0423b0f6cff" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨0,\\sqrt{3}\\operatorname{sin}⁡t,\\sqrt{3}\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "answer-3993447f-c94c-5806-9658-5a3fd2138263" :answer/id #uuid "3993447f-c94c-5806-9658-5a3fd2138263" :answer/type :answer.type/math :answer/value "⟨0,\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "question-8febc0ce-a013-5227-b117-55a62f849158" :question/id #uuid "8febc0ce-a013-5227-b117-55a62f849158" :question/math-academy-id "q-98807" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{10}}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,1⟩, \\\\ N(t) & =⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{10}}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,1⟩\\times ⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩ \\\\  & =\\frac{1}{\\sqrt{10}}\\,\\left|\\begin{aligned}i & j & k \\\\ -3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t & 1 \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{10}}[\\text{ }\\left|\\begin{aligned}3\\operatorname{cos}⁡t & 1 \\\\ -\\operatorname{sin}⁡t & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 1 \\\\ -\\operatorname{cos}⁡t & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{10}}⟨(0+\\operatorname{sin}⁡t),-(0+\\operatorname{cos}⁡t),(3{sin}^{2}⁡t+3{cos}^{2}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t,3⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ada9aa39-633e-53ef-a441-e0ab2035bd78"] :db/ensure [:question/validate]} {:db/id "answer-field-ada9aa39-633e-53ef-a441-e0ab2035bd78" :answer-field/id #uuid "ada9aa39-633e-53ef-a441-e0ab2035bd78" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fe83c22-72da-50e6-834c-b9c00e4e385f" :answer-field/choices ["answer-efccc9a7-cb24-5d0b-bfc7-6c5800ec814c" "answer-1fe83c22-72da-50e6-834c-b9c00e4e385f" "answer-a47da2ab-eb87-5c1e-a609-65ef7d35cb5e" "answer-371ce1fd-1b49-5044-b188-c4be07437ea3" "answer-2f22d5a5-4012-55e2-9f31-a82a58b92e37"] :db/ensure [:answer-field/validate]} {:db/id "answer-efccc9a7-cb24-5d0b-bfc7-6c5800ec814c" :answer/id #uuid "efccc9a7-cb24-5d0b-bfc7-6c5800ec814c" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}⟨-3\\operatorname{cos}⁡t,-3\\operatorname{sin}⁡t,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-1fe83c22-72da-50e6-834c-b9c00e4e385f" :answer/id #uuid "1fe83c22-72da-50e6-834c-b9c00e4e385f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}⟨\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-a47da2ab-eb87-5c1e-a609-65ef7d35cb5e" :answer/id #uuid "a47da2ab-eb87-5c1e-a609-65ef7d35cb5e" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-371ce1fd-1b49-5044-b188-c4be07437ea3" :answer/id #uuid "371ce1fd-1b49-5044-b188-c4be07437ea3" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-2f22d5a5-4012-55e2-9f31-a82a58b92e37" :answer/id #uuid "2f22d5a5-4012-55e2-9f31-a82a58b92e37" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨2\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t,1⟩" :db/ensure [:answer/validate]} {:db/id "question-da6d9860-f69d-5d57-89ed-5b37be24ddaf" :question/id #uuid "da6d9860-f69d-5d57-89ed-5b37be24ddaf" :question/math-academy-id "q-99266" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{{t}^{2}+1}⟨{t}^{2},\\sqrt{2}t,1⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{2}({t}^{2}+1)}⟨2t,\\sqrt{2}(1-{t}^{2}),-2t⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{{t}^{2}+1}⟨{t}^{2},\\sqrt{2}t,1⟩\\times \\frac{1}{\\sqrt{2}({t}^{2}+1)}⟨2t,\\sqrt{2}(1-{t}^{2}),-2t⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ {t}^{2} & \\sqrt{2}t & 1 \\\\ 2t & \\sqrt{2}(1-{t}^{2}) & -2t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}[\\text{ }\\left|\\begin{aligned}\\sqrt{2}t & 1 \\\\ \\sqrt{2}(1-{t}^{2}) & -2t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}{t}^{2} & 1 \\\\ 2t & -2t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}{t}^{2} & \\sqrt{2}t \\\\ 2t & \\sqrt{2}(1-{t}^{2})\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-2\\sqrt{2}{t}^{2}-\\sqrt{2}(1-{t}^{2}),-(-2{t}^{3}-2t),(\\sqrt{2}{t}^{2}(1-{t}^{2})-2\\sqrt{2}{t}^{2})⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-\\sqrt{2}{t}^{2}-\\sqrt{2},2{t}^{3}+2t,-\\sqrt{2}{t}^{4}-\\sqrt{2}{t}^{2}⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-\\sqrt{2}({t}^{2}+1),2t({t}^{2}+1),-\\sqrt{2}{t}^{2}({t}^{2}+1)⟩ \\\\  & =\\frac{1}{{t}^{2}+1}⟨-1,\\sqrt{2}t,-{t}^{2}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e52497f-8d9b-52ce-bfb4-48b101f7c960"] :db/ensure [:question/validate]} {:db/id "answer-field-9e52497f-8d9b-52ce-bfb4-48b101f7c960" :answer-field/id #uuid "9e52497f-8d9b-52ce-bfb4-48b101f7c960" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a5292bc0-d977-5fa7-82c1-38d21ef084f6" :answer-field/choices ["answer-ddc45ba8-ce95-5a23-96e3-f677341d0df3" "answer-e1e23196-82c2-5f2e-b1d2-46dccbfbb184" "answer-0f67ace8-933a-5f11-8580-3c0b81595031" "answer-a5292bc0-d977-5fa7-82c1-38d21ef084f6" "answer-77ea2de2-1ab9-50aa-b4b0-a02fcc5138ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-ddc45ba8-ce95-5a23-96e3-f677341d0df3" :answer/id #uuid "ddc45ba8-ce95-5a23-96e3-f677341d0df3" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2{t}^{2}+1}}⟨-\\sqrt{2}t,1,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-e1e23196-82c2-5f2e-b1d2-46dccbfbb184" :answer/id #uuid "e1e23196-82c2-5f2e-b1d2-46dccbfbb184" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{{t}^{2}+1}}⟨{t}^{2},0,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-0f67ace8-933a-5f11-8580-3c0b81595031" :answer/id #uuid "0f67ace8-933a-5f11-8580-3c0b81595031" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{{t}^{2}+2}}⟨0,\\sqrt{2},t⟩" :db/ensure [:answer/validate]} {:db/id "answer-a5292bc0-d977-5fa7-82c1-38d21ef084f6" :answer/id #uuid "a5292bc0-d977-5fa7-82c1-38d21ef084f6" :answer/type :answer.type/math :answer/value "\\frac{1}{{t}^{2}+1}⟨-1,\\sqrt{2}t,-{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "answer-77ea2de2-1ab9-50aa-b4b0-a02fcc5138ac" :answer/id #uuid "77ea2de2-1ab9-50aa-b4b0-a02fcc5138ac" :answer/type :answer.type/math :answer/value "\\frac{1}{{t}^{2}+1}⟨-\\sqrt{2}t,{t}^{2},1⟩" :db/ensure [:answer/validate]} {:db/id "question-8bfa2936-0cfa-5b9c-b815-96a80b635940" :question/id #uuid "8bfa2936-0cfa-5b9c-b815-96a80b635940" :question/math-academy-id "q-127617" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,2t,0⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,1,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,2t,0⟩\\times \\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,1,0⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ 1 & 2t & 0 \\\\ -2t & 1 & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{1+4{t}^{2}}[\\text{ }\\left|\\begin{aligned}2t & 0 \\\\ 1 & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}1 & 0 \\\\ -2t & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}1 & 2t \\\\ -2t & 1\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0-0,-(0-0),1+4{t}^{2}⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0,0,1+4{t}^{2}⟩ \\\\  & =⟨0,0,1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f62014e6-f54a-5a90-8d80-ae64d3c76c60"] :db/ensure [:question/validate]} {:db/id "answer-field-f62014e6-f54a-5a90-8d80-ae64d3c76c60" :answer-field/id #uuid "f62014e6-f54a-5a90-8d80-ae64d3c76c60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91113aca-733a-5218-9d14-5cb37e780f38" :answer-field/choices ["answer-93563b9d-d97b-5267-b9af-758059d9f304" "answer-d0e3cfdb-3f14-5b5a-9247-7b0c6d95ad5c" "answer-f655a3a7-5b64-5157-b793-c1097fd17f9a" "answer-4c4f14ca-3d48-5056-9fc5-f1bd5f40bc3e" "answer-91113aca-733a-5218-9d14-5cb37e780f38"] :db/ensure [:answer-field/validate]} {:db/id "answer-93563b9d-d97b-5267-b9af-758059d9f304" :answer/id #uuid "93563b9d-d97b-5267-b9af-758059d9f304" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨\\sqrt{2},1,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-d0e3cfdb-3f14-5b5a-9247-7b0c6d95ad5c" :answer/id #uuid "d0e3cfdb-3f14-5b5a-9247-7b0c6d95ad5c" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-1,0,2t⟩" :db/ensure [:answer/validate]} {:db/id "answer-f655a3a7-5b64-5157-b793-c1097fd17f9a" :answer/id #uuid "f655a3a7-5b64-5157-b793-c1097fd17f9a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨0,0,t⟩" :db/ensure [:answer/validate]} {:db/id "answer-4c4f14ca-3d48-5056-9fc5-f1bd5f40bc3e" :answer/id #uuid "4c4f14ca-3d48-5056-9fc5-f1bd5f40bc3e" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,0,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-91113aca-733a-5218-9d14-5cb37e780f38" :answer/id #uuid "91113aca-733a-5218-9d14-5cb37e780f38" :answer/type :answer.type/math :answer/value "⟨0,0,1⟩" :db/ensure [:answer/validate]} {:db/id 17592186167543 :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=0,$ given that\n\n$$\n\\begin{aligned}T(0) & =\\frac{1}{\\sqrt{3}}⟨1,1,1⟩, \\\\ N(0) & =\\frac{1}{\\sqrt{2}}⟨-1,1,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(0) & =T(0)\\times N(0) \\\\  & =\\frac{1}{\\sqrt{3}}⟨1,1,1⟩\\times \\frac{1}{\\sqrt{2}}⟨-1,1,0⟩ \\\\  & =\\frac{1}{\\sqrt{6}}\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 1 \\\\ -1 & 1 & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{6}}[\\text{ }\\left|\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}1 & 1 \\\\ -1 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{6}}⟨(0-1),-(0-(-1)),(1-(-1))⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨-1,-1,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186166466 :answer-field/correct "answer-28828bd8-ec03-59b4-8d26-8b3e464c2850" :answer-field/choices ["answer-d14bae15-857b-5c9b-9d59-85235b09badf" "answer-b6de3b5d-312f-5e9a-a40a-688e667d53b5" "answer-f1913509-00f4-5dea-ba75-f27bf7624bc2" "answer-28828bd8-ec03-59b4-8d26-8b3e464c2850" "answer-58f62199-efbb-5003-b38f-1311c44d694c"] :db/ensure [:answer-field/validate]} {:db/id "answer-d14bae15-857b-5c9b-9d59-85235b09badf" :answer/id #uuid "d14bae15-857b-5c9b-9d59-85235b09badf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨-1,1,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-b6de3b5d-312f-5e9a-a40a-688e667d53b5" :answer/id #uuid "b6de3b5d-312f-5e9a-a40a-688e667d53b5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨-1,-1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-f1913509-00f4-5dea-ba75-f27bf7624bc2" :answer/id #uuid "f1913509-00f4-5dea-ba75-f27bf7624bc2" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨2,1,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-28828bd8-ec03-59b4-8d26-8b3e464c2850" :answer/id #uuid "28828bd8-ec03-59b4-8d26-8b3e464c2850" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{6}}⟨-1,-1,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-58f62199-efbb-5003-b38f-1311c44d694c" :answer/id #uuid "58f62199-efbb-5003-b38f-1311c44d694c" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{6}}⟨1,2,1⟩" :db/ensure [:answer/validate]} {:db/id "question-818ba628-d4d7-5ed9-973b-a4ac0ea776b4" :question/id #uuid "818ba628-d4d7-5ed9-973b-a4ac0ea776b4" :question/math-academy-id "q-99421" :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=3,$ given that\n\n$$\n\\begin{aligned}T(3) & =\\frac{1}{5}⟨0,3,4⟩, \\\\ N(3) & =\\frac{1}{5}⟨0,4,-3⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(3) & =T(3)\\times N(3) \\\\  & =\\frac{1}{5}⟨0,3,4⟩\\times \\frac{1}{5}⟨0,4,-3⟩ \\\\  & =\\frac{1}{25}\\left|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ 0 & 4 & -3\\end{aligned}\\right| \\\\  & =\\frac{1}{25}[\\text{ }\\left|\\begin{aligned}3 & 4 \\\\ 4 & -3\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & 4 \\\\ 0 & -3\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & 3 \\\\ 0 & 4\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{25}⟨(-9-16),-(0-0),(0-0)⟩ \\\\  & =\\frac{1}{25}⟨-25,0,0⟩ \\\\  & =⟨-1,0,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f53e6153-04c5-5452-83ee-5ea082519b93"] :db/ensure [:question/validate]} {:db/id "answer-field-f53e6153-04c5-5452-83ee-5ea082519b93" :answer-field/id #uuid "f53e6153-04c5-5452-83ee-5ea082519b93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5f563ca2-f1b5-5f1c-aa20-5091de5462a4" :answer-field/choices ["answer-b94e2c73-6ffa-542f-8611-55cad68b45b6" "answer-fc46879a-b942-5518-b342-3988b4e15f5f" "answer-a3256280-d56a-5ea5-880f-3efd5245d92b" "answer-5f563ca2-f1b5-5f1c-aa20-5091de5462a4" "answer-0150dbdf-d44e-557e-8e40-9d9fdd3e0fe0"] :db/ensure [:answer-field/validate]} {:db/id "answer-b94e2c73-6ffa-542f-8611-55cad68b45b6" :answer/id #uuid "b94e2c73-6ffa-542f-8611-55cad68b45b6" :answer/type :answer.type/math :answer/value "\\frac{1}{5}⟨3,0,4⟩" :db/ensure [:answer/validate]} {:db/id "answer-fc46879a-b942-5518-b342-3988b4e15f5f" :answer/id #uuid "fc46879a-b942-5518-b342-3988b4e15f5f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-a3256280-d56a-5ea5-880f-3efd5245d92b" :answer/id #uuid "a3256280-d56a-5ea5-880f-3efd5245d92b" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨-2,0,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-5f563ca2-f1b5-5f1c-aa20-5091de5462a4" :answer/id #uuid "5f563ca2-f1b5-5f1c-aa20-5091de5462a4" :answer/type :answer.type/math :answer/value "⟨-1,0,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-0150dbdf-d44e-557e-8e40-9d9fdd3e0fe0" :answer/id #uuid "0150dbdf-d44e-557e-8e40-9d9fdd3e0fe0" :answer/type :answer.type/math :answer/value "⟨0,1,0⟩" :db/ensure [:answer/validate]} {:db/id "question-c8e555e8-b363-57e5-af62-374122f991ee" :question/id #uuid "c8e555e8-b363-57e5-af62-374122f991ee" :question/math-academy-id "q-127694" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡5t,\\,-1,\\,\\operatorname{sin}⁡5t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{2}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡5t),\\,\\frac{\\text{d}}{\\text{d}t}(-1),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡5t)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-5\\operatorname{sin}⁡5t,\\,0,\\,5\\operatorname{cos}⁡5t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{2}}\\sqrt{(-5\\operatorname{sin}⁡5t)^{2}+{(0)}^{2}+{(5\\operatorname{cos}⁡5t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{2}}\\sqrt{25{sin}^{2}⁡5t+25{cos}^{2}⁡5t} \\\\  & =\\frac{5}{\\sqrt{2}}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{\\sqrt{2}}⟨-5\\operatorname{sin}⁡5t,\\,0,\\,5\\operatorname{cos}⁡5t⟩}{(\\frac{5}{\\sqrt{2}})}=⟨-\\operatorname{sin}⁡5t,\\,0,\\,\\operatorname{cos}⁡5t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡5t,\\,-1,\\,\\operatorname{sin}⁡5t⟩\\times ⟨-\\operatorname{sin}⁡5t,\\,0,\\,\\operatorname{cos}⁡5t⟩ \\\\  & =\\frac{1}{\\sqrt{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{cos}⁡5t & -1 & \\operatorname{sin}⁡5t \\\\ -\\operatorname{sin}⁡5t & 0 & \\operatorname{cos}⁡5t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{2}}[\\text{ }\\left|\\begin{aligned}-1 & \\operatorname{sin}⁡5t \\\\ 0 & \\operatorname{cos}⁡5t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{cos}⁡5t & \\operatorname{sin}⁡5t \\\\ -\\operatorname{sin}⁡5t & \\operatorname{cos}⁡5t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{cos}⁡5t & -1 \\\\ -\\operatorname{sin}⁡5t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡5t-0,-({cos}^{2}⁡5t+{sin}^{2}⁡5t),0-\\operatorname{sin}⁡5t⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡5t,\\,-1,\\,-\\operatorname{sin}⁡5t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-411e5861-73e4-579c-a78f-046093d8a6ef"] :db/ensure [:question/validate]} {:db/id "answer-field-411e5861-73e4-579c-a78f-046093d8a6ef" :answer-field/id #uuid "411e5861-73e4-579c-a78f-046093d8a6ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fcc2311a-157a-542b-a6f7-94dbd06a477a" :answer-field/choices ["answer-076372f8-106e-57e0-804d-a269c2fc2d45" "answer-757938d5-ce6f-5416-961c-6ffe6161c32a" "answer-fcc2311a-157a-542b-a6f7-94dbd06a477a" "answer-c54c8b06-a439-54ca-a60f-361ab446e91d" "answer-febb6e78-dc07-54ef-851d-b1fd5014d597"] :db/ensure [:answer-field/validate]} {:db/id "answer-076372f8-106e-57e0-804d-a269c2fc2d45" :answer/id #uuid "076372f8-106e-57e0-804d-a269c2fc2d45" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨-\\operatorname{cos}⁡5t,\\,-\\sqrt{2},\\,-\\operatorname{sin}⁡5t⟩" :db/ensure [:answer/validate]} {:db/id "answer-757938d5-ce6f-5416-961c-6ffe6161c32a" :answer/id #uuid "757938d5-ce6f-5416-961c-6ffe6161c32a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨\\operatorname{cos}⁡5t,\\,-\\sqrt{2},\\,\\operatorname{sin}⁡5t⟩" :db/ensure [:answer/validate]} {:db/id "answer-fcc2311a-157a-542b-a6f7-94dbd06a477a" :answer/id #uuid "fcc2311a-157a-542b-a6f7-94dbd06a477a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡5t,\\,-1,\\,-\\operatorname{sin}⁡5t⟩" :db/ensure [:answer/validate]} {:db/id "answer-c54c8b06-a439-54ca-a60f-361ab446e91d" :answer/id #uuid "c54c8b06-a439-54ca-a60f-361ab446e91d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡5t,\\,-\\operatorname{sin}⁡5t,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-febb6e78-dc07-54ef-851d-b1fd5014d597" :answer/id #uuid "febb6e78-dc07-54ef-851d-b1fd5014d597" :answer/type :answer.type/math :answer/value "⟨\\operatorname{sin}⁡5t,\\,0,\\,-\\operatorname{cos}⁡5t⟩" :db/ensure [:answer/validate]} {:db/id "question-bb6bca21-eef1-511a-9545-14146c32b845" :question/id #uuid "bb6bca21-eef1-511a-9545-14146c32b845" :question/math-academy-id "q-99652" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{3}⟨\\operatorname{sin}⁡(t+1),2\\sqrt{2},\\operatorname{cos}⁡(t+1)⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t+1)),\\,\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(t+1))⟩ \\\\  & =\\frac{1}{3}⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(\\operatorname{cos}⁡(t+1))^{2}+{(0)}^{2}+{(-\\operatorname{sin}⁡(t+1))}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{cos}^{2}⁡(t+1)+{sin}^{2}⁡(t+1)} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩}{(\\frac{1}{3})}=⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨\\operatorname{sin}⁡(t+1),2\\sqrt{2},\\operatorname{cos}⁡(t+1)⟩\\times ⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩ \\\\  & =\\frac{1}{3}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{sin}⁡(t+1) & 2\\sqrt{2} & \\operatorname{cos}⁡(t+1) \\\\ \\operatorname{cos}⁡(t+1) & 0 & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right| \\\\  & =\\frac{1}{3}[\\text{ }\\left|\\begin{aligned}2\\sqrt{2} & \\operatorname{cos}⁡(t+1) \\\\ 0 & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{sin}⁡(t+1) & \\operatorname{cos}⁡(t+1) \\\\ \\operatorname{cos}⁡(t+1) & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{sin}⁡(t+1) & 2\\sqrt{2} \\\\ \\operatorname{cos}⁡(t+1) & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1)-0,-(-{sin}^{2}⁡(t+1)-{cos}^{2}⁡(t+1)),0-2\\sqrt{2}\\operatorname{cos}⁡(t+1)⟩ \\\\  & =\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1),\\,1,\\,-2\\sqrt{2}\\operatorname{cos}⁡(t+1)⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0dfc3adb-1e75-5b3f-be5e-d82fddc905b5"] :db/ensure [:question/validate]} {:db/id "answer-field-0dfc3adb-1e75-5b3f-be5e-d82fddc905b5" :answer-field/id #uuid "0dfc3adb-1e75-5b3f-be5e-d82fddc905b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bebd21ce-52e7-5d1e-9493-b2bc0f6b6c02" :answer-field/choices ["answer-477f2e8f-f5d1-50d8-aa98-26b5ffbf9d75" "answer-36129af3-9d71-53a7-ab78-a9f6e3fc98d2" "answer-bebd21ce-52e7-5d1e-9493-b2bc0f6b6c02" "answer-7074b204-75cd-52eb-8138-272ab4f76fd3" "answer-2c824f8b-b12d-596a-b458-0b38eb6a5d3e"] :db/ensure [:answer-field/validate]} {:db/id "answer-477f2e8f-f5d1-50d8-aa98-26b5ffbf9d75" :answer/id #uuid "477f2e8f-f5d1-50d8-aa98-26b5ffbf9d75" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨-\\sqrt{3}\\operatorname{sin}⁡(t+1),\\,1,\\,\\sqrt{3}\\operatorname{cos}⁡(t+1)⟩" :db/ensure [:answer/validate]} {:db/id "answer-36129af3-9d71-53a7-ab78-a9f6e3fc98d2" :answer/id #uuid "36129af3-9d71-53a7-ab78-a9f6e3fc98d2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨\\sqrt{3}\\operatorname{sin}⁡(t+1),\\,\\sqrt{3}\\operatorname{cos}⁡(t+1),\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-bebd21ce-52e7-5d1e-9493-b2bc0f6b6c02" :answer/id #uuid "bebd21ce-52e7-5d1e-9493-b2bc0f6b6c02" :answer/type :answer.type/math :answer/value "\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1),\\,1,\\,-2\\sqrt{2}\\operatorname{cos}⁡(t+1)⟩" :db/ensure [:answer/validate]} {:db/id "answer-7074b204-75cd-52eb-8138-272ab4f76fd3" :answer/id #uuid "7074b204-75cd-52eb-8138-272ab4f76fd3" :answer/type :answer.type/math :answer/value "\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1),\\,2\\sqrt{2}\\operatorname{cos}⁡(t+1),\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-2c824f8b-b12d-596a-b458-0b38eb6a5d3e" :answer/id #uuid "2c824f8b-b12d-596a-b458-0b38eb6a5d3e" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨-\\operatorname{sin}⁡(t+1),\\,1,\\,-\\operatorname{cos}⁡(t+1)⟩" :db/ensure [:answer/validate]} {:db/id "question-b10a522e-2ca7-50dc-98ce-c79fed01cd4f" :question/id #uuid "b10a522e-2ca7-50dc-98ce-c79fed01cd4f" :question/math-academy-id "q-99651" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{4{t}^{2}+5}}⟨2t,\\,2,\\,-1⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{4{t}^{2}+5}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{4{t}^{2}+5}}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{1}{\\sqrt{4{t}^{2}+5}})⟩ \\\\  & =⟨\\frac{10}{(4{t}^{2}+5)^{3/2}},\\,-\\frac{8t}{(4{t}^{2}+5)^{3/2}},\\,\\frac{4t}{(4{t}^{2}+5)^{3/2}}⟩ \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}⟨5,\\,-4t,\\,2t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{(5)^{2}+(-4t)^{2}+(2t)^{2}} \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{25+16{t}^{2}+4{t}^{2}} \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{20{t}^{2}+25} \\\\  & =\\frac{2\\sqrt{5}}{(4{t}^{2}+5)^{3/2}}\\sqrt{4{t}^{2}+5} \\\\  & =\\frac{2\\sqrt{5}}{4{t}^{2}+5}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{2}{(4{t}^{2}+5)^{3/2}}⟨5,\\,-4t,\\,2t⟩}{(\\frac{2\\sqrt{5}}{4{t}^{2}+5})}=\\frac{1}{\\sqrt{5}\\sqrt{4{t}^{2}+5}}⟨5,\\,-4t,\\,2t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{4{t}^{2}+5}}⟨2t,2,-1⟩\\times \\frac{1}{\\sqrt{5}\\sqrt{4{t}^{2}+5}}⟨5,\\,-4t,\\,2t⟩ \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}\\,\\left|\\begin{aligned}i & j & k \\\\ 2t & 2 & -1 \\\\ 5 & -4t & 2t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}[\\text{ }\\left|\\begin{aligned}2 & -1 \\\\ -4t & 2t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2t & -1 \\\\ 5 & 2t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2t & 2 \\\\ 5 & -4t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}⟨4t-4t,-(4{t}^{2}+5),-8{t}^{2}-10⟩ \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}⟨0,\\,-(4{t}^{2}+5),\\,-2(4{t}^{2}+5)⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨0,\\,-1,\\,-2⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e34d722-fc15-5dc1-942d-021554bfeb73"] :db/ensure [:question/validate]} {:db/id "answer-field-6e34d722-fc15-5dc1-942d-021554bfeb73" :answer-field/id #uuid "6e34d722-fc15-5dc1-942d-021554bfeb73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a373f55a-2df3-5bbb-8e0f-b55932c7ea43" :answer-field/choices ["answer-8b4c6ec2-89e0-57c5-8b8e-fa24254fc8c1" "answer-a373f55a-2df3-5bbb-8e0f-b55932c7ea43" "answer-f9cf3825-effd-5b80-8c14-53fcf72aeb11" "answer-34c9fe98-8103-5607-8dea-cf6c6d0a463f" "answer-ab9e0421-550e-504a-b085-e1304399d534"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b4c6ec2-89e0-57c5-8b8e-fa24254fc8c1" :answer/id #uuid "8b4c6ec2-89e0-57c5-8b8e-fa24254fc8c1" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨0,\\,-1,\\,\\sqrt{2}⟩" :db/ensure [:answer/validate]} {:db/id "answer-a373f55a-2df3-5bbb-8e0f-b55932c7ea43" :answer/id #uuid "a373f55a-2df3-5bbb-8e0f-b55932c7ea43" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨0,\\,-1,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-f9cf3825-effd-5b80-8c14-53fcf72aeb11" :answer/id #uuid "f9cf3825-effd-5b80-8c14-53fcf72aeb11" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨0,\\,-2,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-34c9fe98-8103-5607-8dea-cf6c6d0a463f" :answer/id #uuid "34c9fe98-8103-5607-8dea-cf6c6d0a463f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨1,\\,0,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-ab9e0421-550e-504a-b085-e1304399d534" :answer/id #uuid "ab9e0421-550e-504a-b085-e1304399d534" :answer/type :answer.type/math :answer/value "⟨0,\\,-1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id 17592186168115 :tutorial/content "The **binormal vector** to a curve $C$ defined by the vector-valued function $\\mathbf{r}(t)$ is defined as\n\n$$\n\\mathbf{B}(t) = \\mathbf{T}(t) \\times \\mathbf{N}(t),\n$$\n\nwhere $\\mathbf{T}$ and $\\mathbf{N}$ denote the unit tangent and principal normal vectors, respectively.\n\nThe diagram below shows the binormal vector to a curve at some point $P$ on the curve. \n\n![](images/95/95a892eb30b26d1255d29dcaaac552663443c00b2db6fe1e9168a77be061f2c0.png)\n\nSince $\\mathbf B = \\mathbf T\\times \\mathbf N,$ we can conclude that $\\mathbf B$ is perpendicular to both $\\mathbf T$ and $\\mathbf N,$ and it's pointing downward.\n\nAlso, since $\\mathbf T$ and $\\mathbf N$ are perpendicular *unit* vectors, it follows that $\\mathbf B$ is also a unit vector." :db/ensure [:tutorial/validate]} {:db/id 17592186166979 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186152297 :knowledge-point/questions ["question-62ed2686-5fd2-570f-9e2c-651f1d63d801" "question-aa7ba5f1-091b-5461-b064-b9a572c0acc9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-62ed2686-5fd2-570f-9e2c-651f1d63d801" :question/id #uuid "62ed2686-5fd2-570f-9e2c-651f1d63d801" :question/math-academy-id "q-318127" :question/problem "What number is $125%$ greater than $64?$" :question/worked-solution "To find a number $125%$ *greater than* $64,$ we apply a new percentage of\n\n$$\n100%+125%=225%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n225%=\\frac{225}{100}=2.25\n$$\n\nSo, to find a number that is $125%$ greater than $64,$ we multiply $64$ by $2.25:$\n\n$$\n2.25\\cdot 64=144\n$$\n\nTherefore, the number that is $125%$ greater than $64$ is $144.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a94424b9-97e6-5016-9825-443b370a2c58"] :db/ensure [:question/validate]} {:db/id "answer-field-a94424b9-97e6-5016-9825-443b370a2c58" :answer-field/id #uuid "a94424b9-97e6-5016-9825-443b370a2c58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a7cc659-73e4-532b-99a7-3c634766ec34" :answer-field/choices ["answer-b58bfefd-ae8c-59b0-b73a-de23da9e8c2a" "answer-c94777e7-dc40-5649-ab0e-9b864344dabb" "answer-6a7cc659-73e4-532b-99a7-3c634766ec34" "answer-7b9ddf9b-1b91-530e-8514-164da8ccae4b" "answer-dc4ed7cc-6a7f-517f-944e-d4397979f27d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b58bfefd-ae8c-59b0-b73a-de23da9e8c2a" :answer/id #uuid "