er/validate]} {:db/id "question-49538b11-2cc9-55ec-b3f4-d0592d2d086e" :question/id #uuid "49538b11-2cc9-55ec-b3f4-d0592d2d086e" :question/math-academy-id "q-279420" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & 1 \\\\ 0 & 2\\end{aligned}].$ Find ${A}^{2}.$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${A}^{2}=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${A}^{2},$ we multiply $A$ by itself:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}3 & 1 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 5 \\\\ 0 & 4\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-31f4d8b9-e30e-520d-992d-2a8544c96979" "answer-field-2de7108d-1937-5f66-a0ce-5c7e1df2120c" "answer-field-3d355a8c-a0ca-5b41-b06d-4a6e039eb6aa" "answer-field-73c8128b-f911-5021-b1d9-9ae46f4a8b79"] :db/ensure [:question/validate]} {:db/id "answer-field-31f4d8b9-e30e-520d-992d-2a8544c96979" :answer-field/id #uuid "31f4d8b9-e30e-520d-992d-2a8544c96979" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a224f8c2-4f85-59ae-a7db-91e27402de03" :answer-field/choices ["answer-a224f8c2-4f85-59ae-a7db-91e27402de03"] :db/ensure [:answer-field/validate]} {:db/id "answer-a224f8c2-4f85-59ae-a7db-91e27402de03" :answer/id #uuid "a224f8c2-4f85-59ae-a7db-91e27402de03" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-field-2de7108d-1937-5f66-a0ce-5c7e1df2120c" :answer-field/id #uuid "2de7108d-1937-5f66-a0ce-5c7e1df2120c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7dea584a-3f5a-5191-8098-616b92f4a3d3" :answer-field/choices ["answer-7dea584a-3f5a-5191-8098-616b92f4a3d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7dea584a-3f5a-5191-8098-616b92f4a3d3" :answer/id #uuid "7dea584a-3f5a-5191-8098-616b92f4a3d3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-3d355a8c-a0ca-5b41-b06d-4a6e039eb6aa" :answer-field/id #uuid "3d355a8c-a0ca-5b41-b06d-4a6e039eb6aa" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-895d6a55-dd36-5e5c-9ee0-a64283d81408" :answer-field/choices ["answer-895d6a55-dd36-5e5c-9ee0-a64283d81408"] :db/ensure [:answer-field/validate]} {:db/id "answer-895d6a55-dd36-5e5c-9ee0-a64283d81408" :answer/id #uuid "895d6a55-dd36-5e5c-9ee0-a64283d81408" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-73c8128b-f911-5021-b1d9-9ae46f4a8b79" :answer-field/id #uuid "73c8128b-f911-5021-b1d9-9ae46f4a8b79" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-90201770-fd02-5279-b8bb-9324921c810f" :answer-field/choices ["answer-90201770-fd02-5279-b8bb-9324921c810f"] :db/ensure [:answer-field/validate]} {:db/id "answer-90201770-fd02-5279-b8bb-9324921c810f" :answer/id #uuid "90201770-fd02-5279-b8bb-9324921c810f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-4d7d778d-4fa7-5799-8edf-5efbc5ed3cdb" :question/id #uuid "4d7d778d-4fa7-5799-8edf-5efbc5ed3cdb" :question/math-academy-id "q-78338" :question/problem "If $B=[\\begin{aligned}0 & 4 & 0 \\\\ 2 & 1 & 1 \\\\ -1 & -2 & 1\\end{aligned}]$, then ${B}^{2}=$" :question/worked-solution "To find ${B}^{2},$ we multiply $B$ by itself:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}0 & 4 & 0 \\\\ 2 & 1 & 1 \\\\ -1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 4 & 0 \\\\ 2 & 1 & 1 \\\\ -1 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 4 & 4 \\\\ 1 & 7 & 2 \\\\ -5 & -8 & -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6b44805d-a7db-55e3-b6fc-1db5a2caa201"] :db/ensure [:question/validate]} {:db/id "answer-field-6b44805d-a7db-55e3-b6fc-1db5a2caa201" :answer-field/id #uuid "6b44805d-a7db-55e3-b6fc-1db5a2caa201" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-00639e5d-a047-5c92-8177-1b62b18b37af" :answer-field/choices ["answer-79025b5f-169e-55c7-8c85-1f92d2b5e384" "answer-00639e5d-a047-5c92-8177-1b62b18b37af" "answer-df4fa3d1-4faf-5991-a265-52d8e2c8f159" "answer-146da2e2-3156-517a-9936-11546e182e77" "answer-ff9dcdd7-1252-50d5-a9e7-dd3507043c68"] :db/ensure [:answer-field/validate]} {:db/id "answer-79025b5f-169e-55c7-8c85-1f92d2b5e384" :answer/id #uuid "79025b5f-169e-55c7-8c85-1f92d2b5e384" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 4 & 3 \\\\ 1 & 0 & 2 \\\\ 1 & -8 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-00639e5d-a047-5c92-8177-1b62b18b37af" :answer/id #uuid "00639e5d-a047-5c92-8177-1b62b18b37af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 4 & 4 \\\\ 1 & 7 & 2 \\\\ -5 & -8 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-df4fa3d1-4faf-5991-a265-52d8e2c8f159" :answer/id #uuid "df4fa3d1-4faf-5991-a265-52d8e2c8f159" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 4 & 4 \\\\ 1 & 7 & 2 \\\\ 0 & 4 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-146da2e2-3156-517a-9936-11546e182e77" :answer/id #uuid "146da2e2-3156-517a-9936-11546e182e77" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 4 & 4 \\\\ 1 & 7 & 2 \\\\ 5 & 4 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ff9dcdd7-1252-50d5-a9e7-dd3507043c68" :answer/id #uuid "ff9dcdd7-1252-50d5-a9e7-dd3507043c68" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 4 & 8 \\\\ 1 & 7 & 6 \\\\ -5 & -4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186295080 :question/problem "Consider the matrix $A=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].$ If $f(X)={X}^{2}+1$, find $f(A).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$f(A)=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id "question-2224e8b1-e5b3-5120-9cd4-8c63afa14c71" :question/id #uuid "2224e8b1-e5b3-5120-9cd4-8c63afa14c71" :question/math-academy-id "q-78583" :question/problem "Consider the matrix $D=[\\begin{aligned}1 & -3 \\\\ -1 & 0\\end{aligned}].$  Find $f(D)$ if $f(X)={X}^{2}-3X+5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+5 \\\\  & ={X}^{2}-3X+5I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-3D+5I.$\n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =[\\begin{aligned}1 & -3 \\\\ -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & -3 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-3D+5I \\\\  & =[\\begin{aligned}4 & -3 \\\\ -1 & 3\\end{aligned}]-3[\\begin{aligned}1 & -3 \\\\ -1 & 0\\end{aligned}]+5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -1 & 3\\end{aligned}]+[\\begin{aligned}-3 & 9 \\\\ 3 & 0\\end{aligned}]+[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}4-3+5 & -3+9+0 \\\\ -1+3+0 & 3+0+5\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 \\\\ 2 & 8\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1c461903-1b4b-5b26-ad15-a19492090b76"] :db/ensure [:question/validate]} {:db/id "answer-field-1c461903-1b4b-5b26-ad15-a19492090b76" :answer-field/id #uuid "1c461903-1b4b-5b26-ad15-a19492090b76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c787cd72-628c-5183-a122-bb1328cc72f4" :answer-field/choices ["answer-22af9faf-479c-5211-b924-d2a2ed0ab1ae" "answer-dd037009-e252-5c9b-a802-118a15252803" "answer-c787cd72-628c-5183-a122-bb1328cc72f4" "answer-4a573fe0-ecf3-566c-990e-bc2091d59ff5" "answer-f294d9c4-87c6-5c05-8909-273b2ed447a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-22af9faf-479c-5211-b924-d2a2ed0ab1ae" :answer/id #uuid "22af9faf-479c-5211-b924-d2a2ed0ab1ae" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 6 \\\\ 6 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dd037009-e252-5c9b-a802-118a15252803" :answer/id #uuid "dd037009-e252-5c9b-a802-118a15252803" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 2 \\\\ 6 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c787cd72-628c-5183-a122-bb1328cc72f4" :answer/id #uuid "c787cd72-628c-5183-a122-bb1328cc72f4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 \\\\ 2 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4a573fe0-ecf3-566c-990e-bc2091d59ff5" :answer/id #uuid "4a573fe0-ecf3-566c-990e-bc2091d59ff5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 \\\\ 8 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f294d9c4-87c6-5c05-8909-273b2ed447a5" :answer/id #uuid "f294d9c4-87c6-5c05-8909-273b2ed447a5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 8 \\\\ 2 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-ebea1a9b-d1dc-56a2-8933-0092e4727688" :question/id #uuid "ebea1a9b-d1dc-56a2-8933-0092e4727688" :question/math-academy-id "q-130673" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}].$  Find $f(A)$ if $f(X)={X}^{2}+X-1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X-1 \\\\  & ={X}^{2}+X-I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+A-I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]\\cdot [\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+A-I \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]+[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]+[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]+[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1+3-1 & 0-2+0 \\\\ 0+4+0 & 1-3-1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ab274d63-ed23-5349-8036-9b61afae1797"] :db/ensure [:question/validate]} {:db/id "answer-field-ab274d63-ed23-5349-8036-9b61afae1797" :answer-field/id #uuid "ab274d63-ed23-5349-8036-9b61afae1797" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" :answer-field/choices ["answer-caf9fadd-4204-560a-bbdd-f5a3d57450f4" "answer-e0dd670b-075f-5794-a254-3720ba484dbc" "answer-5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" "answer-8b991cf9-c833-51b6-a70c-6462ead85a65" "answer-25168437-2aa4-5977-952c-2051730ceff6"] :db/ensure [:answer-field/validate]} {:db/id "answer-caf9fadd-4204-560a-bbdd-f5a3d57450f4" :answer/id #uuid "caf9fadd-4204-560a-bbdd-f5a3d57450f4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 1 \\\\ 20 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-e0dd670b-075f-5794-a254-3720ba484dbc" :answer/id #uuid "e0dd670b-075f-5794-a254-3720ba484dbc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}11 & 1 \\\\ 20 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" :answer/id #uuid "5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8b991cf9-c833-51b6-a70c-6462ead85a65" :answer/id #uuid "8b991cf9-c833-51b6-a70c-6462ead85a65" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 3 \\\\ 4 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-25168437-2aa4-5977-952c-2051730ceff6" :answer/id #uuid "25168437-2aa4-5977-952c-2051730ceff6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 4 \\\\ -2 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186365538 :question/problem "Consider the matrix $E=[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}].$ If $f(X)={X}^{2}+4X-5$, find $f(E).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$f(E)=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186116488 :tutorial/content "Powers of matrices are similar to powers of numbers. If $A$ is a matrix, then $A^n$ is $A$ multiplied by itself $n$ times: \n\n$$\nA^n = \\underbrace{A\\:\\cdot\\: A\\:\\cdot\\: \\ldots \\:\\cdot\\: A}_{\\Large{n\\text{ times}}}\n$$\n\nFor $A$ to be conformable with itself, $A$ needs to be a square matrix. So we can only take powers of square matrices.\n\nTo demonstrate, suppose that\n![](images/81/81537bed0eafc982114b89fc84baeac44f7a75997c89df5a0f89b8b0a00b2da3.svg)\n\nThen we can calculate $A^2$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3\\cdot 3+(-1)\\cdot 2 & 3\\cdot (-1)+(-1)\\cdot 1 \\\\ 2\\cdot 3+1\\cdot 2 & 2\\cdot (-1)+1\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -4 \\\\ 8 & -1\\end{aligned}]\\end{aligned}\n$$\n\nWe say that $A^0 = I,$ the identity matrix of the same dimension as $A.$" :db/ensure [:tutorial/validate]} {:db/id 17592186116489 :tutorial/content "Now that we know how to compute powers of matrices, we can evaluate polynomials where the input is a square matrix. \n\nFor example, consider the polynomial\n\n$$\nf(X) = X^2 + 4X + 3.\n$$\n\nNote that, in order to evaluate this polynomial for an input matrix $X,$ we need to interpret any constants as multiples of the identity matrix. So, we interpret the polynomial as\n\n$$\nf(X) = X^2 + 4X + 3I.\n$$\n\nFor example, if ![](images/6a/6abb7cbdef9c5d7b23d8519468b174de369cfe4af4b9f8c4578ce7dc74812f63.svg) then\n\n$$\n\\begin{aligned}{A}^{2} & =[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}],\\end{aligned}\n$$\n\nand we can evaluate $f(A)$ as follows:\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+4A+3I \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}]+4[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}]+3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 4\\end{aligned}]+[\\begin{aligned}4 & 4 \\\\ 0 & 8\\end{aligned}]+[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}1+4+3 & 3+4+0 \\\\ 0+0+0 & 4+8+3\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 7 \\\\ 0 & 15\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186115471 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186124535 :knowledge-point/questions ["question-a8f1b37f-0acc-5633-9cbd-f2e265b10e86"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a8f1b37f-0acc-5633-9cbd-f2e265b10e86" :question/id #uuid "a8f1b37f-0acc-5633-9cbd-f2e265b10e86" :question/math-academy-id "q-37645" :question/problem "$$\nA=[\\begin{aligned}17 & 15 & -20 \\\\ 10 & -8 & 40 \\\\ -5 & 15 & 2\\end{aligned}],\\,D=[\\begin{aligned}22 & 0 & 0 \\\\ 0 & -33 & 0 \\\\ 0 & 0 & 22\\end{aligned}],\\,P=[\\begin{aligned}a & 2 & -4 \\\\ b & -4 & 0 \\\\ 0 & 2 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=PD{P}^{-1},$ find the value of $\\frac{a}{b}.$" :question/worked-solution "Notice that $D={P}^{-1}AP$ is a diagonalization of the matrix $A.$\n\nFrom the diagonal matrix $D,$ we find that the eigenvalues of $A$ are\n\n$\\,$ ${\\lambda }_{1}={\\lambda }_{3}=22\\,$ and $\\,{\\lambda }_{2}=-33.$\n\nThe first column of $P$ corresponds to $\\lambda =22.$ Computing $A-\\lambda I,$ we have\n\n$$\n\\begin{aligned}A-22I & =[\\begin{aligned}17 & 15 & -20 \\\\ 10 & -8 & 40 \\\\ -5 & 15 & 2\\end{aligned}]-22[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 15 & -20 \\\\ 10 & -30 & 40 \\\\ -5 & 15 & -20\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-5 & 15 & -20 & 0 \\\\ 10 & -30 & 40 & 0 \\\\ -5 & 15 & -20 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-5 & 15 & -20 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ and ${x}_{3}$ are free variables. From the first equation, we obtain \n\n$$\n{x}_{1}=3{x}_{2}-4{x}_{3}.\n$$\n\nTherefore, the general solution is\n\n$$\n[\\begin{aligned}3{x}_{2}-4{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{2},{x}_{3}\\in R.\n$$\n\nComparing this with the first column of $P,$ we deduce that ${x}_{3}=0.$ Now, setting ${x}_{2}=1$ and substituting our values for ${x}_{2}$ and ${x}_{3}$ into the general solution, we obtain the following: \n\n$$\n[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}]\n$$\n\nFinally, $\\frac{a}{b}=\\frac{3}{1}=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d0f50ac1-621c-5235-ad7d-224956f53e0a"] :db/ensure [:question/validate]} {:db/id "answer-field-d0f50ac1-621c-5235-ad7d-224956f53e0a" :answer-field/id #uuid "d0f50ac1-621c-5235-ad7d-224956f53e0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-63fefe5f-26b9-59cb-a956-f8bed6df2376" :answer-field/choices ["answer-139d782e-a383-5c12-bf52-73fcc07ca5be" "answer-73128557-0f73-57a2-9b99-d5cf518492aa" "answer-3e557608-7c90-5f9f-8816-c7b24ea9c848" "answer-63fefe5f-26b9-59cb-a956-f8bed6df2376" "answer-dabd17f5-3e12-50d2-8e0e-fa3af018a1ba"] :db/ensure [:answer-field/validate]} {:db/id "answer-139d782e-a383-5c12-bf52-73fcc07ca5be" :answer/id #uuid "139d782e-a383-5c12-bf52-73fcc07ca5be" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-73128557-0f73-57a2-9b99-d5cf518492aa" :answer/id #uuid "73128557-0f73-57a2-9b99-d5cf518492aa" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-3e557608-7c90-5f9f-8816-c7b24ea9c848" :answer/id #uuid "3e557608-7c90-5f9f-8816-c7b24ea9c848" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-63fefe5f-26b9-59cb-a956-f8bed6df2376" :answer/id #uuid "63fefe5f-26b9-59cb-a956-f8bed6df2376" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-dabd17f5-3e12-50d2-8e0e-fa3af018a1ba" :answer/id #uuid "dabd17f5-3e12-50d2-8e0e-fa3af018a1ba" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "activity-1a021b74-af49-57bc-91b4-e012583e9421" :activity/id #uuid "1a021b74-af49-57bc-91b4-e012583e9421" :activity/title "Diagonalizing a 3x3 Matrix in the General Case" :activity/type :activity.type/review :activity/scope 17592186049929 :activity/course 17592186046658 :activity/steps ["step-2dead3e0-3b15-50b4-99b2-4571ed037ccd" "step-0ab03774-05e0-5ad9-980a-49d609e710be" "step-8f590590-9e11-52f1-90ad-28dc5cf36902" "step-d8fe4113-ee4c-5568-b69a-48326407375b" "step-5338e6df-863a-577a-95c4-402d4293d034"] :activity/first-step "step-2dead3e0-3b15-50b4-99b2-4571ed037ccd" :db/ensure [:activity/validate]} {:db/id "step-2dead3e0-3b15-50b4-99b2-4571ed037ccd" :step/id #uuid "2dead3e0-3b15-50b4-99b2-4571ed037ccd" :step/content "question-a8f1b37f-0acc-5633-9cbd-f2e265b10e86" :step/next "step-0ab03774-05e0-5ad9-980a-49d609e710be" :db/ensure [:step/validate]} {:db/id "step-0ab03774-05e0-5ad9-980a-49d609e710be" :step/id #uuid "0ab03774-05e0-5ad9-980a-49d609e710be" :step/content 17592186360740 :step/next "step-8f590590-9e11-52f1-90ad-28dc5cf36902" :db/ensure [:step/validate]} {:db/id "step-8f590590-9e11-52f1-90ad-28dc5cf36902" :step/id #uuid "8f590590-9e11-52f1-90ad-28dc5cf36902" :step/content 17592186404926 :step/next "step-d8fe4113-ee4c-5568-b69a-48326407375b" :db/ensure [:step/validate]} {:db/id "step-d8fe4113-ee4c-5568-b69a-48326407375b" :step/id #uuid "d8fe4113-ee4c-5568-b69a-48326407375b" :step/content 17592186360744 :step/next "step-5338e6df-863a-577a-95c4-402d4293d034" :db/ensure [:step/validate]} {:db/id "step-5338e6df-863a-577a-95c4-402d4293d034" :step/id #uuid "5338e6df-863a-577a-95c4-402d4293d034" :step/content 17592186272053 :db/ensure [:step/validate]} {:db/id 17592186392225 :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda )$:\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =|\\begin{aligned}6-\\lambda  & 11 \\\\ -3 & -6-\\lambda \\end{aligned}| \\\\  & =(6-\\lambda )(-6-\\lambda )+33 \\\\  & ={\\lambda }^{2}-3\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" height=\"20\" width=\"20\">$\\,\\,{x}^{13}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}-3\\,$</td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{15}-3{x}^{13}+{x}^{3}-5x+6\\phantom{|}}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{15}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,3{x}^{13}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,5x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,\\,+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,\\,\\,\\,6$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,3x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,2x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,\\,+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$\\,\\,\\,\\,\\,\\,\\,6$</td>\n</tr>\n</tbody></table>\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(-2x+6)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{13}+x.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(-2A+6I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(-2A+6I) \\\\  & =q(A)\\cdot O+(-2A+6I) \\\\  & =-2A+6I \\\\  & =-2[\\begin{aligned}6 & 11 \\\\ -3 & -6\\end{aligned}]+6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & -22 \\\\ 6 & 12\\end{aligned}]+[\\begin{aligned}6 & 0 \\\\ 0 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -22 \\\\ 6 & 18\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186124552 :knowledge-point/questions ["question-c746a2db-cfe0-519b-a0f3-936f85b88bb1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c746a2db-cfe0-519b-a0f3-936f85b88bb1" :question/id #uuid "c746a2db-cfe0-519b-a0f3-936f85b88bb1" :question/math-academy-id "q-140520" :question/problem "Given that $A=[\\begin{aligned}5 & 3 \\\\ -4 & 7\\end{aligned}],$ find the product of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's Formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2}=\\text{det}(A).\\end{aligned}\\end{aligned}\n$$\n\nSo, the product of the eigenvalues of $A$ is equal to the determinant of $A.$ Therefore, \n\n$$\n\\begin{aligned}{\\lambda }_{1}\\cdot {\\lambda }_{2} & =det(A) \\\\  & =|\\begin{aligned}5 & 3 \\\\ -4 & 7\\end{aligned}| \\\\  & =5\\cdot 7-(-4)\\cdot 3 \\\\  & =35+12 \\\\  & =47.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f58af114-b2ae-5846-9a75-5301fb89508f"] :db/ensure [:question/validate]} {:db/id "answer-field-f58af114-b2ae-5