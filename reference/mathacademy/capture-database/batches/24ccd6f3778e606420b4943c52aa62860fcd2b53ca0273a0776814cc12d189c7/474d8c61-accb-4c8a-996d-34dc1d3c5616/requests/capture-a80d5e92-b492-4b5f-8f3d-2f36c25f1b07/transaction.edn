-53d1-8564-0adb00dacfcd" :db/ensure [:step/validate]} {:db/id "step-8f7aa20f-720c-53d1-8564-0adb00dacfcd" :step/id #uuid "8f7aa20f-720c-53d1-8564-0adb00dacfcd" :step/content "question-f004f03a-3145-589b-b783-dc999853f011" :step/next "step-aaf86f29-9256-5810-966f-4a322d9f6e42" :db/ensure [:step/validate]} {:db/id "step-aaf86f29-9256-5810-966f-4a322d9f6e42" :step/id #uuid "aaf86f29-9256-5810-966f-4a322d9f6e42" :step/content "question-df7c4c47-80d6-5201-b456-75a42c3c1fbc" :step/next "step-adba93d5-db57-587a-9571-20d637543761" :db/ensure [:step/validate]} {:db/id "step-adba93d5-db57-587a-9571-20d637543761" :step/id #uuid "adba93d5-db57-587a-9571-20d637543761" :step/content "question-c85d6d2c-7d60-53c2-9293-99f57c859bc7" :step/next "step-3048f141-ef5f-5cad-b832-c238b4127174" :db/ensure [:step/validate]} {:db/id "step-3048f141-ef5f-5cad-b832-c238b4127174" :step/id #uuid "3048f141-ef5f-5cad-b832-c238b4127174" :step/content "question-d2ee3b0e-faf8-58c6-aa1f-4a103b69243b" :step/next "step-bb44bfa1-1e53-54ec-bb33-41f7f2529245" :db/ensure [:step/validate]} {:db/id "step-bb44bfa1-1e53-54ec-bb33-41f7f2529245" :step/id #uuid "bb44bfa1-1e53-54ec-bb33-41f7f2529245" :step/content "question-50efbd3d-db78-53ec-922c-e4529ac97e50" :db/ensure [:step/validate]} {:db/id 17592186097335 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "question-9756da76-54ed-58bb-84a5-fe67fc16acc7" :question/id #uuid "9756da76-54ed-58bb-84a5-fe67fc16acc7" :question/math-academy-id "q-69508" :question/problem "![](images/b6/b6200095c8fc6c8267fcb1511fcb1ffee896c23ece3a899b76bf3a8701e65440.png)\n\nThe diagram shows the vectors $a$ and $b.$  Which of the following diagrams illustrates the vector subtraction $a-b.$" :question/worked-solution "We interpret the subtraction\n$a-b$\nas the addition\n\n$$\na+(-b),\n$$\n\nwhere $-b$ is the vector that has the same magnitude as $b$ but goes in the direction *opposite* of $b.$\n\nFinally, we use the triangle law to add the vectors $a$ and $-b:$ \n\n- We can start $a$ from an arbitrary point on the plane.\n\n- Next, we draw the vector that is equal to $-b$ and has its tail placed at the head of $a.$\n\n- Now, according to the triangle law of addition, the resultant is the vector that goes from the tail of $\\text{a}$ to the head of $-\\text{b}$, as shown below.\n\n![](images/6f/6fe262898a31d393dc0e1046fbbcbb0a1c9d7c3fb00aed0a982bff5029fcd2a1.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b9df1b13-c754-54c2-9e96-913d5093b7bf"] :db/ensure [:question/validate]} {:db/id "answer-field-b9df1b13-c754-54c2-9e96-913d5093b7bf" :answer-field/id #uuid "b9df1b13-c754-54c2-9e96-913d5093b7bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3be231ec-2961-59f0-9c62-a8218e52a1f6" :answer-field/choices ["answer-e103853e-2bf0-5610-8cac-ea008ed6f26f" "answer-3be231ec-2961-59f0-9c62-a8218e52a1f6" "answer-2cadde5b-64c5-5e69-87ce-17b7c4c4079d" "answer-ee7107e0-b805-55a6-95df-0517737a0181" "answer-02d17fb1-db0e-56fc-9024-2583fa21dae5"] :db/ensure [:answer-field/validate]} {:db/id "answer-e103853e-2bf0-5610-8cac-ea008ed6f26f" :answer/id #uuid "e103853e-2bf0-5610-8cac-ea008ed6f26f" :answer/type :answer.type/image :answer/value "images/10/107791ab54cddf8f42b83c349d450d961f4334757f5a525e707f25382529ee02.png" :db/ensure [:answer/validate]} {:db/id "answer-3be231ec-2961-59f0-9c62-a8218e52a1f6" :answer/id #uuid "3be231ec-2961-59f0-9c62-a8218e52a1f6" :answer/type :answer.type/image :answer/value "images/23/238fe7bdb6d394bed88fd0442050da14977f0391e7650ef36d7a94e998446106.png" :db/ensure [:answer/validate]} {:db/id "answer-2cadde5b-64c5-5e69-87ce-17b7c4c4079d" :answer/id #uuid "2cadde5b-64c5-5e69-87ce-17b7c4c4079d" :answer/type :answer.type/image :answer/value "images/26/26bd490f6fbd3d3d9dab6a9653ed4e8043b5d266eeddd13255a30a6c2d10da0a.png" :db/ensure [:answer/validate]} {:db/id "answer-ee7107e0-b805-55a6-95df-0517737a0181" :answer/id #uuid "ee7107e0-b805-55a6-95df-0517737a0181" :answer/type :answer.type/image :answer/value "images/56/56e29d1e52f2c84cf6581f9b46d4b5216f53a9c44d15b2c0c1b21d2d1f57b0b3.png" :db/ensure [:answer/validate]} {:db/id "answer-02d17fb1-db0e-56fc-9024-2583fa21dae5" :answer/id #uuid "02d17fb1-db0e-56fc-9024-2583fa21dae5" :answer/type :answer.type/image :answer/value "images/f7/f7e357b3b9b74f27dc253bf611729dd188b632df511ba1f10c33e4bde313d8ec.png" :db/ensure [:answer/validate]} {:db/id 17592186096644 :knowledge-point/questions ["question-e294440f-b12e-5095-aeac-cd3f942d43e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e294440f-b12e-5095-aeac-cd3f942d43e6" :question/id #uuid "e294440f-b12e-5095-aeac-cd3f942d43e6" :question/math-academy-id "q-69856" :question/problem "![](images/32/3247a3ba0e4434860318ef697e29f7d377cfb0eb08135bb5d3e147516b2a5505.png)\n\nConsider the vector $\\overset{\\to }{CD},$ shown above. Which of the following could be $\\overset{\\to }{CD}+\\overset{\\to }{DC}?$" :question/worked-solution "According to the triangle law of addition, the resultant is the vector that goes from the tail of $\\overset{\\to }{CD}$ to the head of $\\overset{\\to }{DC}.$ Therefore, we obtain a new vector for which the tail and head is the same point, the tail of $\\overset{\\to }{CD}.$ \n\nThat vector is called the zero vector, and we write\n\n$$\n\\overset{\\to }{CD}+\\overset{\\to }{DC}=0.\n$$\n\nThe corresponding graph is shown below.\n\n![](images/8e/8e51db7c2e9eff46679a185b82a477d65842d43d1dd71289f3e6bab1a7a503de.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c506eaa0-7955-591f-814f-18652414f794"] :db/ensure [:question/validate]} {:db/id "answer-field-c506eaa0-7955-591f-814f-18652414f794" :answer-field/id #uuid "c506eaa0-7955-591f-814f-18652414f794" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-af573cc2-d740-58f5-a9b3-14514a40675a" :answer-field/choice