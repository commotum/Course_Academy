sure [:step/validate]} {:db/id "step-a4be8856-166e-5b28-9384-7b08fc3db5da" :step/id #uuid "a4be8856-166e-5b28-9384-7b08fc3db5da" :step/content "question-ba2fee1b-3766-585f-9ea4-855819a270ac" :step/next "step-8bcf8cd4-92a9-5914-84aa-0e48430a0339" :db/ensure [:step/validate]} {:db/id "step-8bcf8cd4-92a9-5914-84aa-0e48430a0339" :step/id #uuid "8bcf8cd4-92a9-5914-84aa-0e48430a0339" :step/content 17592186365288 :step/next "step-2cffda36-0576-57f3-9167-08b4838d2180" :db/ensure [:step/validate]} {:db/id "step-2cffda36-0576-57f3-9167-08b4838d2180" :step/id #uuid "2cffda36-0576-57f3-9167-08b4838d2180" :step/content 17592186496284 :step/next "step-c8464206-7b26-5ba5-b25a-82075e1f6a55" :db/ensure [:step/validate]} {:db/id "step-c8464206-7b26-5ba5-b25a-82075e1f6a55" :step/id #uuid "c8464206-7b26-5ba5-b25a-82075e1f6a55" :step/content 17592186365357 :db/ensure [:step/validate]} {:db/id 17592186078874 :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186078562 :knowledge-point/questions ["question-3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6" :question/id #uuid "3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6" :question/math-academy-id "q-111056" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{6}{7p}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{6}{7p}} & =\\frac{\\sqrt{6}}{\\sqrt{7p}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{7p}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{7p},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{6}}{\\sqrt{7p}}\\cdot \\frac{\\sqrt{7p}}{\\sqrt{7p}} & = \\\\ \\frac{\\sqrt{42p}}{(\\sqrt{7p})^{2}} & = \\\\ \\frac{\\sqrt{42p}}{7p}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["