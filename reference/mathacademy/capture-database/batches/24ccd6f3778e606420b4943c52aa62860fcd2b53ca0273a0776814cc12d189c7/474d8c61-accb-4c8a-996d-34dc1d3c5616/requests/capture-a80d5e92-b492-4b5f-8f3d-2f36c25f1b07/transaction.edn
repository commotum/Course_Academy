\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-373f0dad-4046-5d78-97b1-8de1de5c9448" "answer-field-c04e83f6-b794-5cf0-9959-5b7551374c68" "answer-field-f972157c-575f-53b6-b8af-78d5205fac36" "answer-field-4537bcac-ab29-58f9-98fa-b0cc3d3b1ffa"] :db/ensure [:question/validate]} {:db/id "answer-field-373f0dad-4046-5d78-97b1-8de1de5c9448" :answer-field/id #uuid "373f0dad-4046-5d78-97b1-8de1de5c9448" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-5b441ae6-5d72-5040-9a87-89a7e580466b" :answer-field/choices ["answer-4f70d6d8-adb4-5caa-b36e-911097b22efd" "answer-5b441ae6-5d72-5040-9a87-89a7e580466b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f70d6d8-adb4-5caa-b36e-911097b22efd" :answer/id #uuid "4f70d6d8-adb4-5caa-b36e-911097b22efd" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-5b441ae6-5d72-5040-9a87-89a7e580466b" :answer/id #uuid "5b441ae6-5d72-5040-9a87-89a7e580466b" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-c04e83f6-b794-5cf0-9959-5b7551374c68" :answer-field/id #uuid "c04e83f6-b794-5cf0-9959-5b7551374c68" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0693ee5d-484d-5630-8e5d-75b0e97f6d93" :answer-field/choices ["answer-0693ee5d-484d-5630-8e5d-75b0e97f6d93" "answer-61205364-65f1-5e48-bdcd-7587c59d8693"] :db/ensure [:answer-field/validate]} {:db/id "answer-0693ee5d-484d-5630-8e5d-75b0e97f6d93" :answer/id #uuid "0693ee5d-484d-5630-8e5d-75b0e97f6d93" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} 