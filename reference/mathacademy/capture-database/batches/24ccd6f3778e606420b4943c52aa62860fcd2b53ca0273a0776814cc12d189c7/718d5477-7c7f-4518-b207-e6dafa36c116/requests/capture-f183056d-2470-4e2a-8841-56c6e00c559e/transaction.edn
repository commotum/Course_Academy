aaf-58b5-bc92-454c75b1e996" :db/ensure [:step/validate]} {:db/id "step-f52a63f9-5aaf-58b5-bc92-454c75b1e996" :step/id #uuid "f52a63f9-5aaf-58b5-bc92-454c75b1e996" :step/content 17592186281649 :step/next "step-3418e5df-6b11-57d2-bb99-1913431eb137" :db/ensure [:step/validate]} {:db/id "step-3418e5df-6b11-57d2-bb99-1913431eb137" :step/id #uuid "3418e5df-6b11-57d2-bb99-1913431eb137" :step/content 17592186481357 :step/next "step-cb0bae8e-56e4-5d43-8dbc-3436ea5c01f1" :db/ensure [:step/validate]} {:db/id "step-cb0bae8e-56e4-5d43-8dbc-3436ea5c01f1" :step/id #uuid "cb0bae8e-56e4-5d43-8dbc-3436ea5c01f1" :step/content 17592186281662 :db/ensure [:step/validate]} [:db/retract 17592186086154 :answer-field/choices 17592186086155] [:db/retract 17592186086154 :answer-field/choices 17592186086156] [:db/retract 17592186086154 :answer-field/choices 17592186086157] [:db/retract 17592186086154 :answer-field/choices 17592186086158] [:db/retract 17592186086154 :answer-field/choices 17592186086159] {:db/id 17592186087830 :knowledge-point/questions ["question-b2554883-e4a0-51fb-ab55-70bbe918132c" "question-239de5f3-ea6f-59ef-b333-b7c1243259a4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b2554883-e4a0-51fb-ab55-70bbe918132c" :question/id #uuid "b2554883-e4a0-51fb-ab55-70bbe918132c" :question/math-academy-id "q-66431" :question/problem "The equation ${x}^{2}-10x+50=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x+50 & =0 \\\\ {x}^{2}-10x & =-50\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-50 \\\\ {x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2} & =-50 \\\\ (x-5)^{2}-25 & =-50 \\\\ (x-5)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-5,\\,q=-25,$ and $p+q=-30.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x-5)^{2} & =-25 \\\\ x-5 & =\\pm \\sqrt{-25} \\\\ x-5 & =\\pm 5\\,\\text{i} \\\\ x & =5\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=5+5\\,\\text{i}$ and $x=5-5\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5cbb9a83-83f5-559b-aa22-cc741328c862"] :db/ensure [:question/validate]} {:db/id "answer-field-5cbb9a83-83f5-559b-aa22-cc741328c862" :answer-field/id #uuid "5cbb9a83-83f5-559b-aa22-cc741328c862" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df58f72d-ec96-5b04-8b62-aec6bafc8591" :answer-field/choices ["answer-96c84526-c5b4-5255-bf98-af414fdb1fb0" "answer-d5d0d590-2ae3-51d3-8da2-43b173b5a68b" "answer-3d076420-a779-5e3e-a34a-583c1f93d33d" "answer-22b3528e-bd13-54b8-90c1-09193176faa0" "answer-df58f72d-ec96-5b04-8b62-aec6bafc8591"] :db/ensure [:answer-field/validate]} {:db/id "answer-96c84526-c5b4-5255-bf98-af414fdb1fb0" :answer/id #uuid "96c84526-c5b4-5255-bf98-af414fdb1fb0" :answer/type :answer.type/math :answer/value "p+q=-20,\\,x=-3\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d5d0d590-2ae3-51d3-8da2-43b173b5a68b" :answer/id #uuid "d5d0d590-2ae3-51d3-8da2-43b173b5a68b" :answer/type :answer.type/math :answer/value "p+q=-20,\\,x=5\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-3d076420-a779-5e3e-a34a-583c1f93d33d" :answer/id #uuid "3d076420-a779-5e3e-a34a-583c1f93d33d" :answer/type :answer.type/math :answer/value "p+q=-30,\\,x=-3\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-22b3528e-bd13-54b8-90c1-09193176faa0" :answer/id #uuid "22b3528e-bd13-54b8-90c1-09193176faa0" :answer/type :answer.type/math :answer/value "p+q=-30,\\,x=5\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-df58f72d-ec96-5b04-8b62-aec6bafc8591" :answer/id #uuid "df58f72d-ec96-5b04-8b62-aec6bafc8591" :answer/type :answer.type/math :answer/value "p+q=-30,\\,x=5\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186088250 :question/problem "The equation ${x}^{2}-8x+52=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x+52 & =0 \\\\ {x}^{2}-8x & =-52\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =-52 \\\\ {x}^{2}-2\\cdot 4x+{4}^{2}-{4}^{2} & =-52 \\\\ (x-4)^{2}-16 & =-52 \\\\ (x-4)^{2} & =-36\\end{aligned}\n$$\n\nTherefore, $p=-4,\\,q=-36,$ and $p+q=-40.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4)^{2} & =-36 \\\\ x-4 & =\\pm \\sqrt{-36} \\\\ x-4 & =\\pm 6\\,\\text{i} \\\\ x & =4\\pm 6\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=4+6\\,\\text{i}$ and $x=4-6\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186086154 :answer-field/correct "answer-e295243b-2633-5336-988f-8567cf89ac74" :answer-field/choices ["answer-2bd7ae77-8250-5020-80a4-12b94cebd915" "answer-b1727935-a31f-5667-8134-811f238cf74d" "answer-1c5a9dee-19f1-525b-8742-ffc708372643" "answer-b040fcf5-22f0-58e5-aba7-527d9e48d77e" "answer-e295243b-2633-5336-988f-8567cf89ac74"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bd7ae77-8250-5020-80a4-12b94cebd915" :answer/id #uuid "2bd7ae77-8250-5020-80a4-12b94cebd915" :answer/type :answer.type/math :answer/value "p+q=-10,\\,x=-4\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-b1727935-a31f-5667-8134-811f238cf74d" :answer/id #uuid "b1727935-a31f-5667-8134-811f238cf74d" :answer/type :answer.type/math :answer/value "p+q=-10,\\,x=4\\pm 6\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-1c5a9dee-19f1-525b-8742-ffc708372643" :answer/id #uuid "1c5a9dee-19f1-525b-8742-ffc708372643" :answer/type :answer.type/math :answer/value "p+q=-40,\\,x=-4\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-b040fcf5-22f0-58e5-aba7-527d9e48d77e" :answer/id #uuid "b040fcf5-22f0-58e5-aba7-527d9e48d77e" :answer/type :answer.type/math :answer/value "p+q=-40,\\,x=4\\pm 3\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-e295243b-2633-5336-988f-8567cf89ac74" :answer/id #uuid "e295243b-2633-5336-988f-8567cf89ac74" :answer/type :answer.type/math :answer/value "p+q=-40,\\,x=4\\pm 6\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-239de5f3-ea6f-59ef-b333-b7c1243259a4" :question/id #uuid "239de5f3-ea6f-59ef-b333-b7c1243259a4" :question/math-academy-id "q-66777" :question/problem "What are the solutions of the equation $(x-3)^{2}=-9?$" :question/worked-solution "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-9 \\\\ x-3 & =\\pm \\sqrt{-9} \\\\ x-3 & =\\pm 3\\,\\text{i} \\\\ x & =3\\pm 3\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+3\\,\\text{i}$ and $x=3-3\\,\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63c756b9-1e9d-5271-bbd7-583507116b40"] :db/ensure [:question/validate]} {:db/id "answer-field-63c756b9-1e9d-5271-bbd7-583507116b40" :answer-field/id #uuid "63c756b9-1e9d-5271-bbd7-583507116b40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aaa26d8b-77e9-5401-b941-393cc5d1b997" :answer-field/choices ["answer-e4eb8c58-f6fc-5d10-80b0-051c38578765" "answer-e380e9d9-befb-5010-b366-7137019f90be" "answer-aaa26d8b-77e9-5401-b941-393cc5d1b997" "answer-40c2a656-f6ad-5bfb-96eb-0caf8028ad4d" "answer-2d5d2c87-1a8f-5972-81f5-e437b77531ff"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4eb8c58-f6fc-5d10-80b0-051c38578765" :answer/id #uuid "e4eb8c58-f6fc-5d10-80b0-051c38578765" :answer/type :answer.type/math :answer/value "x=-3\\pm 3\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-e380e9d9-befb-5010-b3