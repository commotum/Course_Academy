election" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6d485cb2-89c5-5022-b5b4-533fc087f5b9" :answer-field/choices ["answer-b7fdda5c-b3a2-5a24-9521-9f6e08ac1fa7" "answer-57e6a003-f73c-515c-a06f-ba516c1963bd" "answer-6d485cb2-89c5-5022-b5b4-533fc087f5b9" "answer-8cc80659-76af-5a9d-b845-d8d0123dc768" "answer-4f5bbd1a-b6f0-537f-a093-4b3d1be271cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7fdda5c-b3a2-5a24-9521-9f6e08ac1fa7" :answer/id #uuid "b7fdda5c-b3a2-5a24-9521-9f6e08ac1fa7" :answer/type :answer.type/text :answer/value "$(-2,-1)$ and $(-1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-57e6a003-f73c-515c-a06f-ba516c1963bd" :answer/id #uuid "57e6a003-f73c-515c-a06f-ba516c1963bd" :answer/type :answer.type/text :answer/value "$(-2,-3)$ and $(1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-6d485cb2-89c5-5022-b5b4-533fc087f5b9" :answer/id #uuid "6d485cb2-89c5-5022-b5b4-533fc087f5b9" :answer/type :answer.type/text :answer/value "$(-2,3)$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-8cc80659-76af-5a9d-b845-d8d0123dc768" :answer/id #uuid "8cc80659-76af-5a9d-b845-d8d0123dc768" :answer/type :answer.type/text :answer/value "$(1,3)$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-4f5bbd1a-b6f0-537f-a093-4b3d1be271cf" :answer/id #uuid "4f5bbd1a-b6f0-537f-a093-4b3d1be271cf" :answer/type :answer.type/text :answer/value "$(2,1)$ and $(-1,2)$" :db/ensure [:answer/validate]} {:db/id "activity-18cfbf29-0714-53c4-bf61-75276fdf84b2" :activity/id #uuid "18cfbf29-0714-53c4-bf61-75276fdf84b2" :activity/title "Solving Systems of Nonlinear Equations Using Graphs" :activity/type :activity.type/review :activity/scope 17592186049330 :activity/course 17592186046647 :activity/steps ["step-504ad451-e9ae-5979-b879-13ec6623b2ca" "step-2d2a8d38-4a66-5619-979f-ca1ea501fd0f" "step-e6565653-a052-5dc4-ab06-3fb284893e9e"] :activity/first-step "step-504ad451-e9ae-5979-b879-13ec6623b2ca" :db/ensure [:activity/validate]} {:db/id "step-504ad451-e9ae-5979-b879-13ec6623b2ca" :step/id #uuid "504ad451-e9ae-5979-b879-13ec6623b2ca" :step/content 17592186054992 :step/next "step-2d2a8d38-4a66-5619-979f-ca1ea501fd0f" :db/ensure [:step/validate]} {:db/id "step-2d2a8d38-4a66-5619-979f-ca1ea501fd0f" :step/id #uuid "2d2a8d38-4a66-5619-979f-ca1ea501fd0f" :step/content "question-1ecf42ce-06ef-5bfd-b762-67d3f1697496" :step/next "step-e6565653-a052-5dc4-ab06-3fb284893e9e" :db/ensure [:step/validate]} {:db/id "step-e6565653-a052-5dc4-ab06-3fb284893e9e" :step/id #uuid "e6565653-a052-5dc4-ab06-3fb284893e9e" :step/content "question-e75342f3-2efc-5d3d-a3c3-d44c19646c04" :db/ensure [:step/validate]} {:db/id 17592186188359 :knowledge-point/questions ["question-7816847f-8647-5628-af20-0f9b03662f9a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188782 :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=3,$ $\\text{Var}[Y]=6,$ and $\\text{Cov}[X,Y]=2.$ Find $\\text{Var}[4X+2Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[4X+2Y] & ={4}^{2}\\cdot 3+{2}^{2}\\cdot 6+2\\cdot 4\\cdot 2\\cdot 2 \\\\  & =48+24+32 \\\\  & =104.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186186972 :answer-field/correct 17592186186975 :db/ensure [:answer-field/validate]} {:db/id "question-7816847f-8647-5628-af20-0f9b03662f9a" :question/id #uuid "7816847f-8647-5628-af20-0f9b03662f9a" :question/math-academy-id "q-148328" :question/problem "For two random variables $X$ and $Y,$ we have $\\text{Var}[X]=\\frac{1}{5},$ $\\text{Var}[Y]=\\frac{4}{5},$ and $\\text{Cov}[X,Y]=\\frac{3}{5}.$ Find $\\text{Var}[X-2Y].$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables, and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nSubstituting the given data into the formula above, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X-2Y] & ={1}^{2}\\cdot \\frac{1}{5}+(-2)^{2}\\cdot \\frac{4}{5}+2\\cdot 1\\cdot (-2)\\cdot \\frac{3}{5} \\\\  & =\\frac{1}{5}+\\frac{16}{5}-\\frac{12}{5} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35592764-2ebe-5eba-8d3a-5fd6d801071b"] :db/ensure [:question/validate]} {:db/id "answer-field-35592764-2ebe-5eba-8d3a-5fd6d801071b" :answer-field/id #uuid "35592764-2ebe-5eba-8d3a-5fd6d801071b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer-field/choices ["answer-eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" "answer-6ff55129-af5c-5c05-ba0c-79d2b64c94e0" "answer-7481dcce-5cb6-5d08-aba0-d849dc9f222e" "answer-cb00b5e5-8202-5384-a618-4818977df0c7" "answer-8fcb06a8-449e-5686-9043-282535027104"] :db/ensure [:answer-field/validate]} {:db/id "answer-eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer/id #uuid "eafe1606-b8c9-5c8f-9efb-4dfe5c92c0d5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6ff55129-af5c-5c05-ba0c-79d2b64c94e0" :answer/id #uuid "6ff55129-af5c-5c05-ba0c-79d2b64c94e0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-7481dcce-5cb6-5d08-aba0-d849dc9f222e" :answer/id #uuid "7481dcce-5cb6-5d08-aba0-d849dc9f222e" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-cb00b5e5-8202-5384-a618-4818977df0c7" :answer/id #uuid "cb00b5e5-8202-5384-a618-4818977df0c7" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8fcb06a8-449e-5686-9043-282535027104" :answer/id #uuid "8fcb06a8-449e-5686-9043-282535027104" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id 17592186188360 :knowledge-point/questions ["question-d31ef211-c21b-5026-971f-34b7088e4f67"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d31ef211-c21b-5026-971f-34b7088e4f67" :question/id #uuid "d31ef211-c21b-5026-971f-34b7088e4f67" :question/math-academy-id "q-148339" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=2,$ $\\text{E}[Y]=3,$ mixed moment $\\text{E}[XY]=4,$ and second raw moments $\\text{E}[{X}^{2}]=8$ and $\\text{E}[{Y}^{2}]=15.$ Find the variance of $5X+2Y.$" :question/worked-solution "Recall that if $X$ and $Y$ are random variables and $a$ and $b$ are constants, then\n\n$$\n\\text{Var}[aX+bY]={a}^{2}\\text{Var}[X]+{b}^{2}\\text{Var}[Y]+2ab\\,\\text{Cov}[X,Y].\n$$\n\nAlso, the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =8-{2}^{2} \\\\  & =4\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =15-{3}^{2} \\\\  & =6.\\end{aligned}\n$$\n\nNow, let's find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =4-2\\cdot 3 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X+2Y] & ={5}^{2}\\cdot 4+{2}^{2}\\cdot 6+2\\cdot 5\\cdot 2\\cdot (-2) \\\\  & =100+24-40 \\\\  & =84.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ea6f32d4-0004-5767-8eca-1a4a4e3083fd"] :db/ensure [:question/validate]} {:db/id "answer-field-ea6f32d4-0004-5767-8eca-1a4a4e3083fd" :answer-field/id #uuid "ea6f32d4-0004-5767-8eca-1a4a4e3083fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer-field/choices ["answer-128385d5-bbff-57a1-8e2c-763e126ac399" "answer-122174e1-2c44-5e9e-ad09-27766b4736d7" "answer-e981695e-7fa7-5ee6-a201-39d90e43a9af" "answer-ed768d67-5f42-5d63-9a00-ef0595ba307d" "answer-cb7e2361-9a17-5479-bcea-4c30a0b45a9d"] :db/ensure [:answer-field/validate]} {:db/id "answer-128385d5-bbff-57a1-8e2c-763e126ac399" :answer/id #uuid "128385d5-bbff-57a1-8e2c-763e126ac399" :answer/type :answer.type/math :answer/value "102" :db/ensure [:answer/validate]} {:db/id "answer-122174e1-2c44-5e9e-ad09-27766b4736d7" :answer/id #uuid "122174e1-2c44-5e9e-ad09-27766b4736d7" :answer/type :answer.type/math :answer/value "116" :db/ensure [:answer/validate]} {:db/id "answer-e981695e-7fa7-5ee6-a201-39d90e43a9af" :answer/id #uuid "e981695e-7fa7-5ee6-a201-39d90e43a9af" :answer/type :answer.type/math :answer/value "76" :db/ensure [:answer/validate]} {:db/id "answer-ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer/id #uuid "ed768d67-5f42-5d63-9a00-ef0595ba307d" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "answer-cb7e2361-9a17-5479-bcea-4c30a0b45a9d" :answer/id #uuid "cb7e2361-9a17-5479-bcea-4c30a0b45a9d" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id "activity-571d253e-3721-564a-9807-74e64b2231fa" :activity/id #uuid "571d253e-3721-564a-9807-74e64b2231fa" :activity/title "Variance of Sums of Random Variables" :activity/type :activity.type/review :activity/scope 17592186048165 :activity/course 17592186046658 :activity/steps ["step-43428109-0699-58be-ba28-1e9ad893c94b" "step-f2da1517-b73b-5aab-af67-7d5f5240aacd" "step-2408d45f-690e-5c16-b285-71995f2e1e91"] :activity/first-step "step-43428109-0699-58be-ba28-1e9ad893c94b" :db/ensure [:activity/validate]} {:db/id "step-43428109-0699-58be-ba28-1e9ad893c94b" :step/id #uuid "43428109-0699-58be-ba28-1e9ad893c94b" :step/content 17592186188782 :step/next "step-f2da1517-b73b-5aab-af67-7d5f5240aacd" :db/ensure [:step/validate]} {:db/id "step-f2da1517-b73b-5aab-af67-7d5f5240aacd" :step/id #uuid "f2da1517-b73b-5aab-af67-7d5f5240aacd" :step/content "question-7816847f-8647-5628-af20-0f9b03662f9a" :step/next "step-2408d45f-690e-5c16-b285-71995f2e1e91" :db/ensure [:step/validate]} {:db/id "step-2408d45f-690e-5c16-b285-71995f2e1e91" :step/id #uuid "2408d45f-690e-5c16-b285-71995f2e1e91" :step/content "question-d31ef211-c21b-5026-971f-34b7088e4f67" :db/ensure [:step/validate]} [:db/retract 17592186230302 :answer-field/choices 17592186230304] [:db/retract 17592186230302 :answer-field/choices 17592186230305] [:db/retract 17592186230302 :answer-field/choices 17592186230306] [:db/retract 17592186230302 :answer-field/choices 17592186230303] {:db/id 17592186231572 :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+3y=f(x)\n$$\n\non $[-2,2]$, where $f$ is $4$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $4$-periodic on $[-2,2]$, we have $L=2$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{2})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{2}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186230302 :answer-field/correct "answer-1fb9ae0a-ccab-5851-bc46-d8fb84f0673a" :answer-field/choices ["answer-3cf55ac9-9213-51d1-bb90-ad44b88e7647" "answer-391bcc0e-c46d-58de-a271-e5921f5359be" "answer-93cc08d4-e51b-59b2-b080-974e07e72850" "answer-1fb9ae0a-ccab-5851-bc46-d8fb84f0673a"] :db/ensure [:answer-field/validate]} {:db/id "answer-3cf55ac9-9213-51d1-bb90-ad44b88e7647" :answer/id #uuid "3cf55ac9-9213-51d1-bb90-ad44b88e7647" :answer/type :answer.type/math :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/ensure [:answer/validate]} {:db/id "answer-391bcc0e-c46d-58de-a271-e5921f5359be" :answer/id #uuid "391bcc0e-c46d-58de-a271-e5921f5359be" :answer/type :answer.type/math :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{4})" :db/ensure [:answer/validate]} {:db/id "answer-93cc08d4-e51b-59b2-b080-974e07e72850" :answer/id #uuid "93cc08d4-e51b-59b2-b080-974e07e72850" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{4})" :db/ensure [:answer/validate]} {:db/id "answer-1fb9ae0a-ccab-5851-bc46-d8fb84f0673a" :answer/id #uuid "1fb9ae0a-ccab-5851-bc46-d8fb84f0673a" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/ensure [:answer/validate]} {:db/id "activity-bd798445-730a-513c-89df-c11c197d2970" :activity/id #uuid "bd798445-730a-513c-89df-c11c197d2970" :activity/title "Solving BVPs Using Fourier Series" :activity/type :activity.type/review :activity/scope 17592186050814 :activity/course 17592186046645 :activity/steps ["step-ba8c4765-af9d-5f10-9a85-912af077957b" "step-4696628f-351c-5d46-b3f0-60830802e913" "step-e9ee883d-b008-50fb-95b4-c73166382a1a" "step-0e208ebe-b82a-51f2-b53a-db4dfe06f999" "step-f70d3be6-1593-5729-bffd-80d88097003c"] :activity/first-step "step-ba8c4765-af9d-5f10-9a85-912af077957b" :db/ensure [:activity/validate]} {:db/id "step-ba8c4765-af9d-5f10-9a85-912af077957b" :step/id #uuid "ba8c4765-af9d-5f10-9a85-912af077957b" :step/content 17592186231572 :step/next "step-4696628f-351c-5d46-b3f0-60830802e913" :db/ensure [:step/validate]} {:db/id "step-4696628f-351c-5d46-b3f0-60830802e913" :step/id #uuid "4696628f-351c-5d46-b3f0-60830802e913" :step/content 17592186455456 :step/next "step-e9ee883d-b008-50fb-95b4-c73166382a1a" :db/ensure [:step/validate]} {:db/id "step-e9ee883d-b008-50fb-95b4-c73166382a1a" :step/id #uuid "e9ee883d-b008-50fb-95b4-c73166382a1a" :step/content 17592186391884 :step/next "step-0e208ebe-b82a-51f2-b53a-db4dfe06f999" :db/ensure [:step/validate]} {:db/id "step-0e208ebe-b82a-51f2-b53a-db4dfe06f999" :step/id #uuid "0e208ebe-b82a-51f2-b53a-db4dfe06f999" :step/content 17592186497356 :step/next "step-f70d3be6-1593-5729-bffd-80d88097003c" :db/ensure [:step/validate]} {:db/id "step-f70d3be6-1593-5729-bffd-80d88097003c" :step/id #uuid "f70d3be6-1593-5729-bffd-80d88097003c" :step/content 17592186455483 :db/ensure [:step/validate]} {:db/id 17592186179646 :knowledge-point/questions ["question-7933960a-e5cd-5862-9088-b9c1f61b494c" "question-90bd3eab-412f-52dc-83f5-2f8877931db1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7933960a-e5cd-5862-9088-b9c1f61b494c" :question/id #uuid "7933960a-e5cd-5862-9088-b9c1f61b494c" :question/math-academy-id "q-226103" :question/problem "![](images/32/321c16127ae1999e4ec42024f35cd076930618588fe378b9ca16a4ee4eabd58a.png)\n\nConsider the vector field $F=-0.5x\\,i-0.5y\\,j$ and a square $C$ with side length $8$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/ab/abe90a592e098a4656577f3a2303669dccc126baff738397836c8f96c26b5389.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-0.5x\\,i-0.5y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-0.5{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-0.5{\\int }_{{C}_{1}}x\\,\\text{d}s & =-0.5{\\int }_{-4}^{4}4\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-4}^{4}\\text{d}t \\\\  & =-2(4-(-4)) \\\\  & =(-2)\\cdot 8 \\\\  & =-16.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=4\\cdot (-16)=-64.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a8f6c78e-2502-540d-9f7b-11049bb63129"] :db/ensure [:question/validate]} {:db/id "answer-field-a8f6c78e-2502-540d-9f7b-11049bb63129" :answer-field/id #uuid "a8f6c78e-2502-540d-9f7b-11049bb63129" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5a4b60e3-cd37-51c5-b631-37359cad927c" :answer-field/choices ["answer-e63d7042-0452-51d5-8e47-47acba03407b" "answer-4fce93da-e871-5c72-9d09-6eb4bf2aae2b" "answer-7ae15837-c155-5657-9cbb-e2ad0a708b49" "answer-cb15f9d8-3a05-5c26-bc50-d85a868e79fa" "answer-5a4b60e3-cd37-51c5-b631-37359cad927c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e63d7042-0452-51d5-8e47-47acba03407b" :answer/id #uuid "e63d7042-0452-51d5-8e47-47acba03407b" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-4fce93da-e871-5c72-9d09-6eb4bf2aae2b" :answer/id #uuid "4fce93da-e871-5c72-9d09-6eb4bf2aae2b" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-7ae15837-c155-5657-9cbb-e2ad0a708b49" :answer/id #uuid "7ae15837-c155-5657-9cbb-e2ad0a708b49" :answer/type :answer.type/math :answer/value "-32" :db/ensure [:answer/validate]} {:db/id "answer-cb15f9d8-3a05-5c26-bc50-d85a868e79fa" :answer/id #uuid "cb15f9d8-3a05-5c26-bc50-d85a868e79fa" :answer/type :answer.type/math :answer/value "-36" :db/ensure [:answer/validate]} {:db/id "answer-5a4b60e3-cd37-51c5-b631-37359cad927c" :answer/id #uuid "5a4b60e3-cd37-51c5-b631-37359cad927c" :answer/type :answer.type/math :answer/value "-64" :db/ensure [:answer/validate]} {:db/id "question-90bd3eab-412f-52dc-83f5-2f8877931db1" :question/id #uuid "90bd3eab-412f-52dc-83f5-2f8877931db1" :question/math-academy-id "q-127193" :question/problem "![](images/32/32d4722f4a1dd1cfae3fb22cde7399dcb66623e484bcd5989fd2de246a905b51.png)\n\nConsider the vector field $F=-3\\,j$ and a square $C$ with side length $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/3b/3bd953b7fb02b90a55a29bea6f58ff9bd8bab77d62b1df1c547ca899656d37a3.png)\n\nNow, since the vector field $F=-3\\,j$ is parallel to ${C}_{1}$ and ${C}_{3},$ there is zero net flow through these two sides. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=0.\n$$\n\nSo, our expression for the flux reduces to\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s.\n$$\n\nNow, since the vector field is uniform, the net inflow through ${C}_{2}$ will cancel with the net outflow through ${C}_{4}.$ That is\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s=-{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s\\,⟹\\,{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=0.\n$$\n\nTherefore, we conclude that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8bc18207-a6fd-5437-a68d-b3d6fef6d67e"] :db/ensure [:question/validate]} {:db/id "answer-field-8bc18207-a6fd-5437-a68d-b3d6fef6d67e" :answer-field/id #uuid "8bc18207-a6fd-5437-a68d-b3d6fef6d67e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1add2c2e-a167-5c2c-b545-a5f1eb517140" :answer-field/choices ["answer-d3235a30-a18e-50b4-a05b-6c1309b09270" "answer-91c49acb-1fa6-5ddc-9050-3b83a7f4c764" "answer-1add2c2e-a167-5c2c-b545-a5f1eb517140" "answer-ba10258f-f51b-5e95-9c08-2bf569bcb880" "answer-28b45251-3b7f-5715-8789-20bd83838a64"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3235a30-a18e-50b4-a05b-6c1309b09270" :answer/id #uuid "d3235a30-a18e-50b4-a05b-6c1309b09270" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-91c49acb-1fa6-5ddc-9050-3b83a7f4c764" :answer/id #uuid "91c49acb-1fa6-5ddc-9050-3b83a7f4c764" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-1add2c2e-a167-5c2c-b545-a5f1eb517140" :answer/id #uuid "1add2c2e-a167-5c2c-b545-a