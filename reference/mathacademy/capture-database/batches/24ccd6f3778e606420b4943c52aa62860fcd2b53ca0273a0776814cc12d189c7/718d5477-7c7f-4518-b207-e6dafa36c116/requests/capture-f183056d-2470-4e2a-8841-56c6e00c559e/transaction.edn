find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=24.$ Dividing the power by $4,$ we get\n\n$$\n24÷4=6\\,\\text{R}0.\n$$\n\nSo the remainder is $0.$ Therefore,\n\n$$\n{\\text{i}}^{24}={\\text{i}}^{0}=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d69cb58a-9fb7-5a73-a64e-7aa17b27dd9d"] :db/ensure [:question/validate]} {:db/id "answer-field-d69cb58a-9fb7-5a73-a64e-7aa17b27dd9d" :answer-field/id #uuid "d69cb58a-9fb7-5a73-a64e-7aa17b27dd9d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2bd305dc-bb6b-580b-a493-cecb52d1bacb" :answer-field/choices ["answer-1d58e1d6-9058-5654-9cd8-bc85995ee0c2" "answer-4ca0ff4d-6e49-5ce7-97f7-0e3c7cc15bd6" "answer-72a1e6f9-aafc-5e7c-830f-ed757a2ba64b" "answer-2bd305dc-bb6b-580b-a493-cecb52d1bacb" "answer-7472f77b-aba3-5528-b3ab-22b816acbcc3"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d58e1d6-9058-5654-9cd8-bc85995ee0c2" :answer/id #uuid "1d58e1d6-9058-5654-9cd8-bc85995ee0c2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-4ca0ff4d-6e49-5ce7-97f7-0e3c7cc15bd6" :answer/id #uuid "4ca0ff4d-6e49-5ce7-97f7-0e3c7cc15bd6" :answer/type :answer.type/math :answer/value "-4\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-72a1e6f9-aafc-5e7c-830f-ed757a2ba64b" :answer/id #uuid "72a1e6f9-aafc-5e7c-830f-ed757a2ba64b" :answer/type :answer.type/math :answer/value "-\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-2bd305dc-bb6b-580b-a493-cecb52d1bacb" :answer/id #uuid "2bd305dc-bb6b-580b-a493-cecb52d1bacb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-7472f77b-aba3-5528-b3ab-22b816acbcc3" :answer/id #uuid "7472f77b-aba3-5528-b3ab-22b816acbcc3" :answer/type :answer.type/math :answer/value "\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186054616 :knowledge-point/questions ["question-b7f8ea24-bf7b-5ebd-ac96-307434b99a43"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b7f8ea24-bf7b-5ebd-ac96-307434b99a43" :question/id #uuid "b7f8ea24-bf7b-5ebd-ac96-307434b99a43" :question/math-academy-id "q-569" :question/problem "If $a={\\text{i}}^{2}$ and $b={\\text{i}}^{9}$, then $ab=$" :question/worked-solution "Using the addition law for exponents, we have\n\n$$\nab={\\text{i}}^{2}\\cdot {\\text{i}}^{9}={\\text{i}}^{2+9}={\\text{i}}^{11}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=11.$ Dividing the power by $4,$ we get\n\n$$\n11÷4=2\\,\\text{R}3.\n$$\n\nSo the remainder is $3.$ Therefore,\n\n$$\n{\\text{i}}^{11}={\\text{i}}^{3}=-\\text{i}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b6fc5d96-a387-5e91-ac87-cf9885c4df7d"] :db/ensure [:question/validate]} {:db/id "answer-field-b6fc5d96-a387-5e91-ac87-cf9885c4df7d" :answer-field/id #uuid "b6fc5d96-a387-5e91-ac87-cf9885c4df7d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd35346f-a1c5-5550-a5a6-81e168550ef2" :answer-field/choices ["answer-d587220c-e013-541b-9d54-8b67285f5388" "answer-dd35346f-a1c5-5550-a5a6-81e168550ef2" "answer-efee7e06-9ddd-5cc2-a91d-904b6a75f560" "answer-fb570050-11b4-518d-a996-dd6fca923e36" "answer-ea41f662-9d78-5477-9638-0d4a0210d5c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-d587220c-e013-541b-9d54-8b67285f5388" :answer/id #uuid "d587220c-e013-541b-9d54-8b67285f5388" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-dd35346f-a1c5-5550-a5a6-81e168550ef2" :answer/id #uuid "dd35346f-a1c5-5550-a5a6-81e168550ef2" :answer/type :answer.type/math :answer/value "-\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-efee7e06-9ddd-5cc2-a91d-904b6a75f560" :answer/id #uuid "efee7e06-9ddd-5cc2-a91d-904b6a75f560" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-fb570050-11b4-518d-a996-dd6fca923e36" :answer/id #uuid "fb570050-11b4-518d-a996-dd6fca923e36" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-ea41f662-9d78-5477-9638-0d4a0210d5c8" :answer/id #uuid "ea41f662-9d78-5477-9638-0d4a0210d5c8" :answer/type :answer.type/math :answer/value "\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186055514 :question/problem "Simplify ${\\text{i}}^{50}.$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=50.$ Dividing the power by $4,$ we get:\n\n$$\n50÷4=12\\,\\text{R}2\n$$\n\nSo the remainder is $2.$ Therefore,\n\n$$\n{\\text{i}}^{50}={\\text{i}}^{2}=-1.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186054321 :answer-field/correct 17592186054326 :answer-field/choices ["answer-8d3a08f6-fd2f-5782-bbee-624c75d48b43" "answer-ed2b8611-d8d8-563c-b94b-aac6969ac4ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d3a08f6-fd2f-5782-bbee-624c75d48b43" :answer/id #uuid "8d3a08f6-fd2f-5782-bbee-624c75d48b43" :answer/type :answer.type/math :answer/value "-\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-ed2b8611-d8d8-563c-b94b-aac6969ac4ca" :answer/id #uuid "ed2b8611-d8d8-563c-b94b-aac6969ac4ca" :answer/type :answer.type/math :answer/value "\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186054617 :knowledge-point/questions ["question-5ff8f495-e68c-55fd-b502-1aeaa9ec649a" "question-e87479bf-28b6-5cab-9b25-26c4f45c1fed"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5ff8f495-e68c-55fd-b502-1aeaa9ec649a" :question/id #uuid "5ff8f495-e68c-55fd-b502-1aeaa9ec649a" :question/math-academy-id "q-86685" :question/problem "$5{\\text{i}}^{-2}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n5{\\text{i}}^{-2}=\\frac{5}{{\\text{i}}^{2}}.\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{5}{{\\text{i}}^{2}}=\\frac{5}{(-1)}=-5.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3bbba762-ecb5-5041-b8ef-4594788c4dee"] :db/ensure [:question/validate]} {:db/id "answer-field-3bbba762-ecb5-5041-b8ef-4594788c4dee" :answer-field/id #uuid "3bbba762-ecb5-5041-b8ef-4594788c4dee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e8bb9244-35b1-5fe4-ad95-b131580d21c2" :answer-field/choices ["answer-e8bb9244-35b1-5fe4-ad95-b131580d21c2" "answer-5e4cfbae-11f6-549a-9180-a3ba9c7d51e5" "answer-ffd35650-8e87-55f4-ab1d-4ed4eb0f56bf" "answer-30ea2c74-92f8-5dfc-906d-187ed5899c78" "answer-8d35d5d7-52fb-5e34-a0c3-d5050f550764"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8bb9244-35b1-5fe4-ad95-b131580d21c2" :answer/id #uuid "e8bb9244-35b1-5fe4-ad95-b131580d21c2" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-5e4cfbae-11f6-549a-9180-a3ba9c7d51e5" :answer/id #uuid "5e4cfbae-11f6-549a-9180-a3ba9c7d51e5" :answer/type :answer.type/math :answer/value "-5i" :db/ensure [:answer/validate]} {:db/id "answer-ffd35650-8e87-55f4-ab1d-4ed4eb0f56bf" :answer/id #uuid "ffd35650-8e87-55f4-ab1d-4ed4eb0f56bf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-30ea2c74-92f8-5dfc-906d-187ed5899c78" :answer/id #uuid "30ea2c74-92f8-5dfc-906d-187ed5899c78" :answer/type :answer.type/math :answer/value "5i" :db/ensure [:answer/validate]} {:db/id "answer-8d35d5d7-52fb-5e34-a0c3-d5050f550764" :answer/id #uuid "8d35d5d7-52fb-5e34-a0c3-d5050f550764" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "question-e87479bf-28b6-5cab-9b25-26c4f45c1fed" :question/id #uuid "e87479bf-28b6-5cab-9b25-26c4f45c1fed" :question/math-academy-id "q-86688" :question/problem "${\\text{i}}^{-1}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n{\\text{i}}^{-1}=\\frac{1}{\\text{i}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{\\text{i}}=\\frac{1}{\\text{i}}\\cdot \\frac{\\text{i}}{\\text{i}}=\\frac{\\text{i}}{{\\text{i}}^{2}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{\\text{i}}{{\\text{i}}^{2}}=\\frac{\\text{i}}{(-1)}=-\\text{i}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1f1babbe-939f-5426-872c-f51afac57e5d"] :db/ensure [:question/validate]} {:db/id "answer-field-1f1babbe-939f-5426-872c-f51afac57e5d" :answer-field/id #uuid "1f1babbe-939f-5426-872c-f51afac57e5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1067a6a6-ea44-54fb-9b49-340362e71e94" :answer-field/choices ["answer-e2479278-1d95-5cf6-8422-f5acf953ba01" "answer-e7448cff-8a46-50af-94f3-a8fa8bd54690" "answer-1067a6a6-ea44-54fb-9b49-340362e71e94" "answer-8bdda742-6458-58a9-9f84-0b3357e2d275" "answer-45daa364-6e41-502c-beff-1da50c08730e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2479278-1d95-5cf6-8422-f5acf953ba01" :answer/id #uuid "e2479278-1d95-5cf6-8422-f5acf953ba01" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-e7448cff-8a46-50af-94f3-a8fa8bd54690" :answer/id #uuid "e7448cff-8a46-50af-94f3-a8fa8bd54690" :answer/type :answer.type/math :answer/value "-\\frac{\\text{i}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1067a6a6-ea44-54fb-9b49-340362e71e94" :answer/id #uuid "1067a6a6-ea44-54fb-9b49-340362e71e94" :answer/type :answer.type/math :answer/value "-\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-8bdda742-6458-58a9-9f84-0b3357e2d275" :answer/id #uuid "8bdda742-6458-58a9-9f84-0b3357e2d275" :answer/type :answer.type/math :answer/value "1-\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-45daa364-6e41-502c-beff-1da50c08730e" :answer/id #uuid "45daa364-6e41-502c-beff-1da50c08730e" :answer/type :answer.type/math :answer/value "\\text{i}" :db/ensure [:answer/validate]} {:db/id "activity-12402d81-17be-551a-9fc6-ae90a859480b" :activity/id #uuid "12402d81-17be-551a-9fc6-ae90a859480b" :activity/title "The Cyclic Property of the Imaginary Unit" :activity/type :activity.type/review :activity/scope 17592186050218 :activity/course 17592186046647 :activity/steps ["step-a11a61d3-0935-5485-ba4d-8fd670986c6a" "step-cff7f8bd-a3b5-5283-8c95-6bf1c853c6be" "step-6a8db41c-81fc-5dff-9303-73c67d1ad74a" "step-48bed219-70d8-5c51-8f1e-24f1d3b0be35" "step-4298d0e8-1022-557f-ac4a-1cae4225f16c"] :activity/first-step "step-a11a61d3-0935-5485-ba4d-8fd670986c6a" :db/ensure [:activity/validate]} {:db/id "step-a11a61d3-0935-5485-ba4d-8fd670986c6a" :step/id #uuid "a11a61d3-0935-5485-ba4d-8fd670986c6a" :step/content "question-4c9f6489-bb99-5069-afdd-6f597a73df64" :step/next "step-cff7f8bd-a3b5-5283-8c95-6bf1c853c6be" :db/ensure [:step/validate]} {:db/id "step-cff7f8bd-a3b5-5283-8c95-6bf1c853c6be" :step/id #uuid "cff7f8bd-a3b5-5283-8c95-6bf1c853c6be" :step/content "question-b7f8ea24-bf7b-5ebd-ac96-307434b99a43" :step/next "step-6a8db41c-81fc-5dff-9303-73c67d1ad74a" :db/ensure [:step/validate]} {:db/id "step-6a8db41c-81fc-5dff-9303-73c67d1ad74a" :step/id #uuid "6a8db41c-81fc-5dff-9303-73c67d1ad74a" :step/content 17592186055514 :step/next "step-48bed219-70d8-5c51-8f1e-24f1d3b0be35" :db/ensure [:step/validate]} {:db/id "step-48bed219-70d8-5c51-8f1e-24f1d3b0be35" :step/id #uuid "48bed219-70d8-5c51-8f1e-24f1d3b0be35" :step/content "question-5ff8f495-e68c-55fd-b502-1aeaa9ec649a" :step/next "step-4298d0e8-1022-557f-ac4a-1cae4225f16c" :db/ensure [:step/validate]} {:db/id "step-4298d0e8-1022-557f-ac4a-1cae4225f16c" :step/id #uuid "4298d0e8-1022-557f-ac4a-1cae4225f16c" :step/content "question-e87479bf-28b6-5cab-9b25-26c4f45c1fed" :db/ensure [:step/validate]} {:db/id 17592186087755 :knowledge-point/questions ["question-6b8e59d5-6b05-50ce-8455-191b0c2a0b7a" "question-7c34a96f-d461-5b11-9cb5-80d7557e52d7" "question-80bbf2bd-d1de-5b2e-a143-1c03752fb710"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6b8e59d5-6b05-50ce-8455-191b0c2a0b7a" :question/id #uuid "6b8e59d5-6b05-50ce-8455-191b0c2a0b7a" :question/math-academy-id "q-73776" :question/problem "Which of the following statements are true regarding the polynomial $f(x)={x}^{2}+5x+4?$\n\nI. $x=4$ is a root of $f(x)$\n\nII. $(x-4)$ is a factor of $f(x)$\n\nIII. $(x-4)$ divides $f(x)$ with zero remainder" :question/worked-solution "The factor theorem states that $(x-r)$ is a factor of a polynomial $p(x)$ if and only if the root $x=r$ is also a root of $p(x).$ \n\nHere, we are considering $(x-4).$ The root of this expression can be found by setting the expression equal to $0$ and solving:\n\n$$\n\\begin{aligned}x-4 & =0 \\\\ x & =4\\end{aligned}\n$$\n\nWe now check each of the statements, in turn.\n\n- Statement I is false. Indeed, $x=4$ is not a root of $f(x):$\n\n$$\n\\begin{aligned}f(4) & ={4}^{2}+5(4)+4 \\\\  & =16+20+4 \\\\  & =40 \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement II is false. According to the factor theorem, since $x=4$ is not a root of $f(x),$ then $(x-4)$ is not a factor of $f(x).$\n\n- Statement III is false. Since $(x-4)$ is not a factor of $f(x),$ then it does not divide $f(x)$ with zero remainder.\n\nTherefore, the correct answer is \"None.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63b70b6a-3c22-5376-9d31-4b93eb63027c"] :db/ensure [:question/validate]} {:db/id "answer-field-63b70b6a-3c22-5376-9d31-4b93eb63027c" :answer-field/id #uuid "63b70b6a-3c22-5376-9d31-4b93eb63027c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b074b252-d948-500c-8a9b-b0d2c27004f1" :answer-field/choices ["answer-6fc2e5c4-3531-5d25-8436-a4eb1e7ccd7a" "answer-f2645d9f-4118-565c-be24-6f9684808038" "answer-002539d9-f83f-5f8a-821f-f91ec24993f6" "answer-17a8904d-7494-54a8-9cf6-42abe4eadb2e" "answer-b074b252-d948-500c-8a9b-b0d2c27004f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fc2e5c4-3531-5d25-8436-a4eb1e7ccd7a" :answer/id #uuid "6fc2e5c4-3531-5d25-8436-a4eb1e7ccd7a" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-f2645d9f-4118-565c-be24-6f9684808038" :answer/id #uuid "f2645d9f-4118-565c-be24-6f9684808038" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-002539d9-f83f-5f8a-821f-f91ec24993f6" :answer/id #uuid "002539d9-f83f-5f8a-821f-f91ec24993f6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-17a8904d-7494-54a8-9cf6-42abe4eadb2e" :answer/id #uuid "17a8904d-7494-54a8-9cf6-42abe4eadb2e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-b074b252-d948-500c-8a9b-b0d2c27004f1" :answer/id #uuid "b074b252-d948-500c-8a9b-b0d2c27004f1" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-7c34a96f-d461-5b11-9cb5-80d7557e52d7" :question/id #uuid "7c34a96f-d461-5b11-9cb5-80d7557e52d7" :question/math-academy-id "q-73777" :question/problem "For which of the following polynomials is $(x+1)$ a factor?\n\nI. $f(x)={x}^{2}+3x+2$\n\nII. $g(x)={x}^{2}+8x+7$\n\nIII. $h(x)=-{x}^{2}+x$" :question/worked-solution "The factor theorem states that $(x-r)$ is a factor of a polynomial $p(x)$ if and only if the root $x=r$ is also a root of $p(x).$ \n\nHere, we are considering $(x+1).$ The root of this expression can be found by setting the expression equal to $0$ and solving:\n\n$$\n\\begin{aligned}x+1 & =0 \\\\ x & =-1\\end{aligned}\n$$\n\nAccording to the factor theorem, $(x+1)$ is a factor of $p(x)$ if the root $x=-1$ is a root of $p(x).$ \n\nSo now, we will check if $x=-1$ is a root of the polynomials $f,$ $g$ and $h.$\n\n- Evaluating $x=-1$ at $f(x),$ we get\n\n$$\n\\begin{aligned}f(-1) & =(-1)^{2}+3(-1)+2 \\\\  & =1-3+2 \\\\  & =0.\\end{aligned}\n$$\n\nConsequently, by the factor theorem, we conclude that $(x+1)$ is indeed a factor of $f(x).$\n\n- Now, evaluating $x=-1$ at $g(x),$ we get\n\n$$\n\\begin{aligned}g(-1) & =(-1)^{2}+8(-1)+7 \\\\  & =1-8+7 \\\\  & =0.\\end{aligned}\n$$\n\nConsequently, by the factor theorem, we conclude that $(x+1)$ is indeed a factor of $g(x).$\n\n- Finally, evaluating $x=-1$ at $h(x),$ we get\n\n$$\n\\begin{aligned}h(-1) & =-(-1)^{2}+(-1) \\\\  & =-1-1 \\\\  & =-2\\ne 0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e9167685-de61-5642-a6f3-e2034b8507d4"] :db/ensure [:question/validate]} {:db/id "answer-field-e9167685-de61-5642-a6f3-e2034b8507d4" :answer-field/id #uuid "e9167685-de61-5642-a6f3-e2034b8507d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-613837ad-89d1-5321-957d-108904a65b60" :answer-field/choices ["answer-613837ad-89d1-5321-957d-108904a65b60" "answer-71f3178c-d1ea-5a2a-a611-b33edaa1e845" "answer-730eb180-4edc-5379-bca0-fecd47808404" "answer-0f287a40-81c1-5aaa-a86b-d2b035d996fa" "answer-d3344a98-2866-5a55-94ff-6269de66ca21"] :db/ensure [:answer-field/validate]} {:db/id "answer-613837ad-89d1-5321-957d-108904a65b60" :answer/id #uuid "613837ad-89d1-5321-957d-108904a65b60" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-71f3178c-d1ea-5a2a-a611-b33edaa1e845" :answer/id #uuid "71f3178c-d1ea-5a2a-a611-b33edaa1e845" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-730eb180-4edc-5379-bca0-fecd47808404" :answer/id #uuid "730eb180-4edc-5379-bca0-fecd47808404" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-0f287a40-81c1-5aaa-a86b-d2b035d996fa" :answer/id #uuid "0f287a40-81c1-5aaa-a86b-d2b035d996fa" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-d3344a98-2866-5a55-94ff-6269de66ca21" :answer/id #uuid "d3344a98-2866-5a55-94ff-6269de66ca21" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-80bbf2bd-d1de-5b2e-a143-1c03752fb710" :question/id #uuid "80bbf2bd-d1de-5b2e-a143-1c03752fb710" :question/math-academy-id "q-112375" :question/problem "Which of the following statements are true regarding the polynomial $f(x)={x}^{3}-64?$\n\nI. $x=-4$ is a root of $f(x)$\n\nII. $(x+4)$ is a factor of $f(x)$\n\nIII. $(x+4)$ divides $f(x)$ with zero remainder" :question/worked-solution "The factor theorem states that $(x-r)$ is a factor of a polynomial $p(x)$ if and only if the root $x=r$ is also a root of $p(x).$ \n\nHere, we are considering $(x+4).$ The root of this expression can be found by setting the expression equal to $0$ and solving:\n\n$$\n\\begin{aligned}x+4 & =0 \\\\ x & =-4\\end{aligned}\n$$\n\nWe now check each of the statements, in turn.\n\n- Statement I is false. Indeed, $x=-4$ is not a root of $f(x):$\n\n$$\n\\begin{aligned}f(-4) & =(-4)^{3}-64 \\\\  & =-64-64 \\\\  & =-128 \\\\  & \\ne 0\\end{aligned}\n$$\n\n- Statement II is false. According to the factor theorem, since $x=-4$ is not a root of $f(x),$ then $(x+4)$ is not a factor of $f(x).$\n\n- Statement III is false. Since $(x+4)$ is not a factor of $f(x),$ then it does not divide $f(x)$ with zero remainder.\n\nTherefore, the correct answer is \"None of the statements are true.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b4b04c50-0203-5dfc-9b1a-8237ab5897f1"] :db/ensure [:question/validate]} {:db/id "answer-field-b4b04c50-0203-5dfc-9b1a-8237ab5897f1" :answer-field/id #uuid "b4b04c50-0203-5dfc-9b1a-8237ab5897f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eb45be13-00dd-5fd8-b791-31a74d07d791" :answer-field/choices ["answer-1ce67f95-6bea-5f1e-b9d2-1af1c79e9ab5" "answer-db03f727-83ad-5c17-8bee-a86151b4ee85" "answer-e9c51bf4-bc5f-5e98-b7fe-9fe7917b1585" "answer-6cf05eee-7227-5199-af37-fe648f0fca6a" "answer-eb45be13-00dd-5fd8-b791-31a74d07d791"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ce67f95-6bea-5f1e-b9d2-1af1c79e9ab5" :answer/id #uuid "1ce67f95-6bea-5f1e-b9d2-1af1c79e9ab5" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-db03f727-83ad-5c17-8bee-a86151b4ee85" :answer/id #uuid "db03f727-83ad-5c17-8bee-a86151b4ee85" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e9c51bf4-bc5f-5e98-b7fe-9fe7917b1585" :answer/id #uuid "e9c51bf4-bc5f-5e98-b7fe-9fe7917b1585" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-6cf05eee-7227-5199-af37-fe648f0fca6a" :answer/id #uuid "6cf05eee-7227-5199-af37-fe648f0fca6a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-eb45be13-00dd-5fd8-b791-31a74d07d791" :answer/id #uuid "eb45be13-00dd-5fd8-b791-31a74d07d791" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "activity-d838f33a-4f86-5744-a7fc-eb75d6e74ec7" :activity/id #uuid "d838f33a-4f86-5744-a7fc-eb75d6e74ec7" :activity/title "The Factor Theorem" :activity/type :activity.type/review :activity/scope 17592186049242 :activity/course 17592186046647 :activity/steps ["step-43326e46-5e1e-5d89-9515-b93fb570546c" "step-3825af64-8557-55d7-8fbb-b760b9c6080d" "step-2e16a771-02ef-5ecb-9a92-67ab9fc2574e"