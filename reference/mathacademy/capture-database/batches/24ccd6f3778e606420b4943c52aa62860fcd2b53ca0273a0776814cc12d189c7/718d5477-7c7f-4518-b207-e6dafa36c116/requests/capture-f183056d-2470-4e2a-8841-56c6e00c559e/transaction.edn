5fe2-b3bb-4bb36c948590" :step/next "step-40d4dd98-8f00-5812-9744-7da402c1dc93" :db/ensure [:step/validate]} {:db/id "step-40d4dd98-8f00-5812-9744-7da402c1dc93" :step/id #uuid "40d4dd98-8f00-5812-9744-7da402c1dc93" :step/content "question-dcb3950f-e511-5b2b-8452-0fa93d40b2ff" :step/next "step-d99766e1-2da7-5900-95b2-c8df8b39afb9" :db/ensure [:step/validate]} {:db/id "step-d99766e1-2da7-5900-95b2-c8df8b39afb9" :step/id #uuid "d99766e1-2da7-5900-95b2-c8df8b39afb9" :step/content 17592186193317 :step/next "step-2f0a17d3-3284-5fc0-85d5-442eaf544c52" :db/ensure [:step/validate]} {:db/id "step-2f0a17d3-3284-5fc0-85d5-442eaf544c52" :step/id #uuid "2f0a17d3-3284-5fc0-85d5-442eaf544c52" :step/content "question-a62d30b2-87c9-5394-8f0b-7a8e71495548" :step/next "step-4f69e054-c648-523f-94bf-3bfc96d73fdb" :db/ensure [:step/validate]} {:db/id "step-4f69e054-c648-523f-94bf-3bfc96d73fdb" :step/id #uuid "4f69e054-c648-523f-94bf-3bfc96d73fdb" :step/content "question-6923f3da-7346-5c88-a6fe-bd6d1873e88f" :db/ensure [:step/validate]} {:db/id 17592186133931 :knowledge-point/questions ["question-56f4d79a-05af-516b-82f5-f4f41e31d95b" "question-46a23183-289b-59ee-a9e5-bbe0aa79406a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186134139 :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=1,$ $y=0,$ $y=1,$ $z=0,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=2xz\\,i+({x}^{2}+z)\\,j+2\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2xz)+\\frac{∂}{∂y}({x}^{2}+z)+\\frac{∂}{∂z}(2) \\\\  & =2z+0+0 \\\\  & =2z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2z\\,\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{1}2z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}\\text{d}x\\cdot {\\int }_{0}^{1}\\text{d}y\\cdot {\\int }_{0}^{1}2z\\,\\text{d}z \\\\  & =(1-(-1))\\cdot (1-0)\\cdot [{z}^{2}]_{z=0}^{z=1} \\\\  & =2({1}^{2}-{0}^{2}) \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186130990 :answer-field/correct 17592186130992 :db/ensure [:answer-field/validate]} {:db/id 17592186133930 :knowledge-point/questions ["question-d1625297-e3fd-57e3-914d-8b51c40eca40" "question-65b5959b-427f-58b2-a1ab-3381594e4750"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d1625297-e3fd-57e3-914d-8b51c40eca40" :question/id #uuid "d1625297-e3fd-57e3-914d-8b51c40eca40" :question/math-academy-id "q-162576" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x-1)^{2}+{y}^{2}+(z+3)^{2}=16$ and the vector field $F=(x+2y)\\,i+(4z-y)\\,j+(z+xy)\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x+2y)+\\frac{∂}{∂y}(4z-y)+\\frac{∂}{∂z}(z+xy) \\\\  & =1+(-1)+1 \\\\  & =1.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $4$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}1\\,\\text{d}V \\\\  & =1{∭}_{R}\\,\\text{d}V \\\\  & ={∭}_{R}\\,\\text{d}V \\\\  & =\\text{Volume}(R) \\\\  & =\\frac{4}{3}\\pi \\cdot {4}^{3} \\\\  & =\\frac{256\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-669b5857-9476-53d2-a3ba-83114e28734b"] :db/ensure [:question/validate]} {:db/id "answer-field-669b5857-9476-53d2-a3ba-83114e28734b" :answer-field/id #uuid "669b5857-9476-53d2-a3ba-83114e28734b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0f3756c9-bdae-5fc5-a4bd-d15ab3bd2b3d" :answer-field/choices ["answer-0beb80e1-b251-5f38-8c4b-335984f939ec" "answer-95616eaf-0047-5979-a335-7f695fe9eda0" "answer-e9c02b9f-29eb-57c2-9ffb-0ff1bd5df608" "answer-0f3756c9-bdae-5fc5-a4bd-d15ab3bd2b3d" "answer-2c776a19-195c-58aa-b365-bb6719e73143"] :db/ensure [:answer-field/validate]} {:db/id "answer-0beb80e1-b251-5f38-8c4b-335984f939ec" :answer/id #uuid "0beb80e1-b251-5f38-8c4b-335984f939ec" :answer/type :answer.type/math :answer/value "128\\pi " :db/ensure [:answer/validate]} {:db/id "answer-95616eaf-0047-5979-a335-7f695fe9eda0" :answer/id #uuid "95616eaf-0047-5979-a335-7f695fe9eda0" :answer/type :answer.type/math :answer/value "243\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e9c02b9f-29eb-57c2-9ffb-0ff1bd5df608" :answer/id #uuid "e9c02b9f-29eb-57c2-9ffb-0ff1bd5df608" :answer/type :answer.type/math :answer/value "64\\pi " :db/ensure [:answer/validate]} {:db/id "answer-0f3756c9-bdae-5fc5-a4bd-d15ab3bd2b3d" :answer/id #uuid "0f3756c9-bdae-5fc5-a4bd-d15ab3bd2b3d" :answer/type :answer.type/math :answer/value "\\frac{256\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-2c776a19-195c-58aa-b365-bb6719e73143" :answer/id #uuid "2c776a19-195c-58aa-b365-bb6719e73143" :answer/type :answer.type/math :answer/value "\\frac{512\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-65b5959b-427f-58b2-a1ab-3381594e4750" :question/id #uuid "65b5959b-427f-58b2-a1ab-3381594e4750" :question/math-academy-id "q-162582" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x-3)^{2}+{y}^{2}+{z}^{2}=36$ and the vector field $F=(x+1)\\,i-y\\,j+z\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x+1)+\\frac{∂}{∂y}(-y)+\\frac{∂}{∂z}(z) \\\\  & =1+(-1)+1 \\\\  & =1.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $6$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}1\\,\\text{d}V \\\\  & =1{∭}_{R}\\,\\text{d}V \\\\  & =1\\cdot \\text{Volume}(R) \\\\  & =1\\cdot \\frac{4}{3}\\pi \\cdot {6}^{3} \\\\  & =288\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cc272370-ecec-5e06-8147-00a26161afa7"] :db/ensure [:question/validate]} {:db/id "answer-field-cc272370-ecec-5e06-8147-00a26161afa7" :answer-field/id #uuid "cc272370-ecec-5e06-8147-00a26161afa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d99e9003-2612-560e-a604-89d922f8dac1" :answer-field/choices ["answer-1fc2daa4-0f98-5208-a949-6ecc2ca8eb4c" "answer-d99e9003-2612-560e-a604-89d922f8dac1" "answer-165fa76d-df92-5e45-90d0-0a3b012427c3" "answer-8bd28949-3198-5142-8676-57b452b2eeb4" "answer-fc5e4696-eeae-5ff1-9afd-e56c4c418a37"] :db/ensure [:answer-field/validate]} {:db/id "answer-1fc2daa4-0f98-5208-a949-6ecc2ca8eb4c" :answer/id #uuid "1fc2daa4-0f98-5208-a949-6ecc2ca8eb4c" :answer/type :answer.type/math :answer/value "256\\pi " :db/ensure [:answer/validate]} {:db/id "answer-d99e9003-2612-560e-a604-89d922f8dac1" :answer/id #uuid "d99e9003-2612-560e-a604-89d922f8dac1" :answer/type :answer.type/math :answer/value "288\\pi " :db/ensure [:answer/validate]} {:db/id "answer-165fa76d-df92-5e45-90d0-0a3b012427c3" :answer/id #uuid "165fa76d-df92-5e45-90d0-0a3b012427c3" :answer/type :answer.type/math :answer/value "512\\pi " :db/ensure [:answer/validate]} {:db/id "answer-8bd28949-3198-5142-8676-57b452b2eeb4" :answer/id #uuid "8bd28949-3198-5142-8676-57b452b2eeb4" :answer/type :answer.type/math :answer/value "\\frac{128\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-fc5e4696-eeae-5ff1-9afd-e56c4c418a37" :answer/id #uuid "fc5e4696-eeae-5ff1-9afd-e56c4c418a37" :answer/type :answer.type/math :answer/value "\\frac{64\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-56f4d79a-05af-516b-82f5-f4f41e31d95b" :question/id #uuid "56f4d79a-05af-516b-82f5-f4f41e31d95b" :question/math-academy-id "q-162598" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=0,$ $y=\\pi ,$ $z=2,$ $z=4.$ Given that the surface $S$ is positively (outward) oriented and $F={z}^{3}\\,i+2xz\\operatorname{cos}⁡y\\,j+x{y}^{2}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({z}^{3})+\\frac{∂}{∂y}(2xz\\operatorname{cos}⁡y)+\\frac{∂}{∂z}(x{y}^{2}) \\\\  & =0+(-2xz\\operatorname{sin}⁡y)+0 \\\\  & =-2xz\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(-2xz\\operatorname{sin}⁡y)\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\pi }{\\int }_{2}^{4}(-2xz\\operatorname{sin}⁡y)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2x\\,\\text{d}x\\cdot {\\int }_{0}^{\\pi }(-\\operatorname{sin}⁡y)\\text{d}y\\cdot {\\int }_{2}^{4}z\\,\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=1}\\cdot [\\operatorname{cos}⁡y]_{y=0}^{y=\\pi }\\cdot {[\\frac{{z}^{2}}{2}]}_{z=2}^{z=4} \\\\  & =({1}^{2}-{0}^{2})\\cdot (\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0)\\cdot (\\frac{{4}^{2}}{2}-\\frac{{2}^{2}}{2}) \\\\  & =1\\cdot (-2)\\cdot 6 \\\\  & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-69fd017c-8fd8-594c-96db-bb6def0c9f0a"] :db/ensure [:question/validate]} {:db/id "answer-field-69fd017c-8fd8-594c-96db-bb6def0c9f0a" :answer-field/id #uuid "69fd017c-8fd8-594c-96db-bb6def0c9f0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a2113a2-dd4d-539c-984a-b4939769ed41" :answer-field/choices ["answer-9a2113a2-dd4d-539c-984a-b4939769ed41" "answer-c491e7f1-cd3a-54c5-a9fb-12f4835abac8" "answer-e023c4cd-5ab4-51c0-8881-2596a66eaf02" "answer-e98c24e5-1c22-5064-93fa-bfdbc05fdb81" "answer-57dc0f26-61e8-54f6-8765-f4f9dd4d0d34"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a2113a2-dd4d-539c-984a-b4939769ed41" :answer/id #uuid "9a2113a2-dd4d-539c-984a-b4939769ed41" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-c491e7f1-cd3a-54c5-a9fb-12f4835abac8" :answer/id #uuid "c491e7f1-cd3a-54c5-a9fb-12f4835abac8" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-e023c4cd-5ab4-51c0-8881-2596a66eaf02" :answer/id #uuid "e023c4cd-5ab4-51c0-8881-2596a66eaf02" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-e98c24e5-1c22-5064-93fa-bfdbc05fdb81" :answer/id #uuid "e98c24e5-1c22-5064-93fa-bfdbc05fdb81" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-57dc0f26-61e8-54f6-8765-f4f9dd4d0d34" :answer/id #uuid "57dc0f26-61e8-54f6-8765-f4f9dd4d0d34" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-46a23183-289b-59ee-a9e5-bbe0aa79406a" :question/id #uuid "46a23183-289b-59ee-a9e5-bbe0aa79406a" :question/math-academy-id "q-162603" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=4,$ $y=0,$ $y=1,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=y\\sqrt{x}\\,i+(z-x)\\,j+{y}^{3}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y\\sqrt{x})+\\frac{∂}{∂y}(z-x)+\\frac{∂}{∂z}({y}^{3}) \\\\  & =\\frac{y}{2\\sqrt{x}}+0+0 \\\\  & =\\frac{y}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}\\frac{y}{2\\sqrt{x}}\\,\\text{d}V \\\\  & ={\\int }_{1}^{4}{\\int }_{0}^{1}{\\int }_{1}^{2}\\frac{y}{2\\sqrt{x}}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{1}{2\\sqrt{x}}\\,\\text{d}x\\cdot {\\int }_{0}^{1}y\\,\\text{d}y\\cdot {\\int }_{1}^{2}\\text{d}z \\\\  & =[\\sqrt{x}]_{x=1}^{x=4}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=1}\\cdot (2-1) \\\\  & =(2-1)\\cdot (\\frac{1}{2}-0)\\cdot 1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9b6833fc-e197-5043-abac-1f89f7ffca8f"] :db/ensure [:question/validate]} {:db/id "answer-field-9b6833fc-e197-5043-abac-1f89f7ffca8f" :answer-field/id #uuid "9b6833fc-e197-5043-abac-1f89f7ffca8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dbc29b15-264e-5331-b92c-70ab6eedaf01" :answer-field/choices ["answer-d60c91b7-6822-585c-88c2-65de5a82f0ca" "answer-ae79307e-0a76-5408-ab09-a497ed81c568" "answer-dbc29b15-264e-5331-b92c-70ab6eedaf01" "answer-b591f2b8-be38-5e17-9192-b6351f2a138c" "answer-28fa7678-f13a-5850-9ebd-3577ac1a0379"] :db/ensure [:answer-field/validate]} {:db/id "answer-d60c91b7-6822-585c-88c2-65de5a82f0ca" :answer/id #uuid "d60c91b7-6822-585c-88c2-65de5a82f0ca" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ae79307e-0a76-5408-ab09-a497ed81c568" :answer/id #uuid "ae79307e-0a76-5408-ab09-a497ed81c568" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-dbc29b15-264e-5331-b92c-70ab6eedaf01" :answer/id #uuid "dbc29b15-264e-5331-b92c-70ab6eedaf01" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b591f2b8-be38-5e17-9192-b6351f2a138c" :answer/id #uuid "b591f2b8-be38-5e17-9192-b6351f2a138c" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-28fa7678-f13a-5850-9ebd-3577ac1a0379" :answer/id #uuid "28fa7678-f13a-5850-9ebd-3577ac1a0379" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "activity-909a1e60-f32c-537c-a9f6-988fe797e725" :activity/id #uuid "909a1e60-f32c-537c-a9f6-988fe797e725" :activity/title "The Divergence Theorem" :activity/type :activity.type/review :activity/scope 17592186050534 :activity/course 1759218604664