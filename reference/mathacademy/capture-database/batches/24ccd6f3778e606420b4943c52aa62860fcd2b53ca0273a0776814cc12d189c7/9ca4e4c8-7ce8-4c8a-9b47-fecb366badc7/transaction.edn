d-81864079-1883-5b8b-8d59-ef9b83084c06"] :db/ensure [:question/validate]} {:db/id "answer-field-81864079-1883-5b8b-8d59-ef9b83084c06" :answer-field/id #uuid "81864079-1883-5b8b-8d59-ef9b83084c06" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0c538f5-e615-5347-ac75-743588bef9e4" :answer-field/choices ["answer-617e9b74-7b40-5151-b5f7-d2c38f23b567" "answer-cf529f56-e92e-5984-9cc7-844c47ce8fe9" "answer-c6039c55-9dd5-533f-aad5-b746c73a3126" "answer-db817b06-48e6-5db7-99e3-d3b7d92b252b" "answer-f0c538f5-e615-5347-ac75-743588bef9e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-617e9b74-7b40-5151-b5f7-d2c38f23b567" :answer/id #uuid "617e9b74-7b40-5151-b5f7-d2c38f23b567" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-cf529f56-e92e-5984-9cc7-844c47ce8fe9" :answer/id #uuid "cf529f56-e92e-5984-9cc7-844c47ce8fe9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 4 & 6 \\\\ 2 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c6039c55-9dd5-533f-aad5-b746c73a3126" :answer/id #uuid "c6039c55-9dd5-533f-aad5-b746c73a3126" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 0 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-db817b06-48e6-5db7-99e3-d3b7d92b252b" :answer/id #uuid "db817b06-48e6-5db7-99e3-d3b7d92b252b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 2 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f0c538f5-e615-5347-ac75-743588bef9e4" :answer/id #uuid "f0c538f5-e615-5347-ac75-743588bef9e4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-45fa10fd-570c-5dfa-b523-d7d0d1d7035b" :question/id #uuid "45fa10fd-570c-5dfa-b523-d7d0d1d7035b" :question/math-academy-id "q-265769" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].$" :question/worked-solution "Writing $A=[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}0 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c117a905-5939-59e0-9a30-20c1c80001bb"] :db/ensure [:question/validate]} {:db/id "answer-field-c117a905-5939-59e0-9a30-20c1c80001bb" :answer-field/id #uuid "c117a905-5939-59e0-9a30-20c1c80001bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer-field/choices ["answer-7b865f86-0d16-5302-9cc6-a10c9f8f37ab" "answer-ecefcf4c-8447-5494-8e2d-cad863dd1b8c" "answer-d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" "answer-3f851010-ea30-50ca-aace-f98e8eb2ec46" "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b865f86-0d16-5302-9cc6-a10c9f8f37ab" :answer/id #uuid "7b865f86-0d16-5302-9cc6-a10c9f8f37ab" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ecefcf4c-8447-5494-8e2d-cad863dd1b8c" :answer/id #uuid "ecefcf4c-8447-5494-8e2d-cad863dd1b8c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" :answer/id #uuid "d42e932d-9ed9-55f9-b7a7-ebf31d9b817a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3f851010-ea30-50ca-aace-f98e8eb2ec46" :answer/id #uuid "3f851010-ea30-50ca-aace-f98e8eb2ec46" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer/id #uuid "c32739f0-0d80-5ef2-8e02-dfabb53b4363" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-fd553fc9-eb2f-5541-8477-0b92e94ae292" :question/id #uuid "fd553fc9-eb2f-5541-8477-0b92e94ae292" :question/math-academy-id "q-265768" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$" :question/worked-solution "Writing $A=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$, we have\n\n$$\nf(x)={x}^{T}Ax.\n$$\n\nFor a symmetric matrix $A$, the gradient of the function $f(x)={x}^{T}Ax$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=2Ax.\n$$\n\nTherefore, since $A$ is symmetric, we get\n\n$$\n{∇}_{x}f(x)=2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4aaed9c4-a4e0-553f-a135-f824dfa18834"] :db/ensure [:question/validate]} {:db/id "answer-field-4aaed9c4-a4e0-553f-a135-f824dfa18834" :answer-field/id #uuid "4aaed9c4-a4e0-553f-a135-f824dfa18834" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer-field/choices ["answer-975432fd-8be5-5dac-b75c-323b7ff0169a" "answer-addd9a17-be40-5bcb-8f55-9c0685e9ead1" "answer-5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" "answer-48b8d3bd-6a11-58e6-8539-d23621262558"] :db/ensure [:answer-field/validate]} {:db/id "answer-975432fd-8be5-5dac-b75c-323b7ff0169a" :answer/id #uuid "975432fd-8be5-5dac-b75c-323b7ff0169a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-addd9a17-be40-5bcb-8f55-9c0685e9ead1" :answer/id #uuid "addd9a17-be40-5bcb-8f55-9c0685e9ead1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" :answer/id #uuid "5e8fe610-97bc-5ec7-b3c3-3a9ca69db85d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer/id #uuid "dfedd0c5-ba43-5a1b-9ed6-99bb599b9592" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-48b8d3bd-6a11-58e6-8539-d23621262558" :answer/id #uuid "48b8d3bd-6a11-58e6-8539-d23621262558" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-6620062e-023f-5c7d-9835-fb1b352d0fc1" :question/id #uuid "6620062e-023f-5c7d-9835-fb1b352d0fc1" :question/math-academy-id "q-276041" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}-2 & 1 \\\\ 2 & -2\\end{aligned}]+[\\begin{aligned}-2 & 2 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & -4\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ -1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & -4\\end{aligned}][\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4-3 \\\\ 3+4\\end{aligned}] \\\\  & =[\\begin{aligned}-7 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3996e568-037c-55af-9d58-338cfb32e23d" "answer-field-32739e0b-ce49-5335-90d2-32e863e2de3f"] :db/ensure [:question/validate]} {:db/id "answer-field-3996e568-037c-55af-9d58-338cfb32e23d" :answer-field/id #uuid "3996e568-037c-55af-9d58-338cfb32e23d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-39c82852-558e-54b0-9642-2d3f9d763221" :answer-field/choices ["answer-39c82852-558e-54b0-9642-2d3f9d763221"] :db/ensure [:answer-field/validate]} {:db/id "answer-39c82852-558e-54b0-9642-2d3f9d763221" :answer/id #uuid "39c82852-558e-54b0-9642-2d3f9d763221" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-field-32739e0b-ce49-5335-90d2-32e863e2de3f" :answer-field/id #uuid "32739e0b-ce49-5335-90d2-32e863e2de3f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer-field/choices ["answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer/id #uuid "a2f41369-88fc-57d9-9f6c-32363ff7bcbc" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-a1a89719-12d3-55da-8498-af0dfd930411" :question/id #uuid "a1a89719-12d3-55da-8498-af0dfd930411" :question/math-academy-id "q-276045" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 2\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}3 & -1 \\\\ -3 & 1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}3 & -1 \\\\ -3 & 1\\end{aligned}]+[\\begin{aligned}3 & -3 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -4 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 2\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}6 & -4 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}6-8 \\\\ -4+4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" "answer-field-6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43"] :db/ensure [:question/validate]} {:db/id "answer-field-5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" :answer-field/id #uuid "5e2ac6c8-308e-5ccb-b6d7-b77764401e1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-227e2fbf-1d08-52e2-8bba-7c210918adda" :answer-field/choices ["answer-227e2fbf-1d08-52e2-8bba-7c210918adda"] :db/ensure [:answer-field/validate]} {:db/id "answer-227e2fbf-1d08-52e2-8bba-7c210918adda" :answer/id #uuid "227e2fbf-1d08-52e2-8bba-7c210918adda" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43" :answer-field/id #uuid "6a3d4772-d0cb-5d4d-8e1f-b23b20b49b43" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9a795b8-272f-565d-b750-ab45ec83143c" :answer-field/choices ["answer-a9a795b8-272f-565d-b750-ab45ec83143c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9a795b8-272f-565d-b750-ab45ec83143c" :answer/id #uuid "a9a795b8-272f-565d-b750-ab45ec83143c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-4ab946d8-2af3-5f4a-a52a-5bbd914240e1" :question/id #uuid "4ab946d8-2af3-5f4a-a52a-5bbd914240e1" :question/math-academy-id "q-276047" :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 1 & 1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 1 & -1 \\\\ 0 & -1 & 1\\end{aligned}]+[\\begin{aligned}-1 & 1 & 0 \\\\ 0 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 2 & -2 \\\\ 1 & -2 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2+1+1 \\\\ 1+2-2 \\\\ 1-2+2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9b4eb1e8-7e8f-56fe-9cc5-7c0534c2be46" "answer-field-902e36f6-38d1-549f-a1dc-9a28e448d787" "answer-field-e8327b3c-174b-5286-b01b-5ae9db175fe7"] :db/ensure [:question/validate]} {:db/id "answer-field-9b4eb1e8-7e8f-56fe-9cc5-7c0534c2be46" :answer-field/id #uuid "9b4eb1e8-7e8f-56fe-9cc5-7c0534c2be46" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6989e33b-e0ac-5a5c-a634-fca03e458f20" :answer-field/choices ["answer-6989e33b-e0ac-5a5c-a634-fca03e458f20"] :db/ensure [:answer-field/validate]} {:db/id "answer-6989e33b-e0ac-5a5c-a634-fca03e458f20" :answer/id #uuid "6989e33b-e0ac-5a5c-a634-fca03e458f20" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-902e36f6-38d1-549f-a1dc-9a28e448d787" :answer-field/id #uuid "902e36f6-38d1-549f-a1dc-9a28e448d787" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-05c026ae-ac1c-53eb-98c4-1750389eab42" :answer-field/choices ["answer-05c026ae-ac1c-53eb-98c4-1750389eab42"] :db/ensure [:answer-field/validate]} {:db/id "answer-05c026ae-ac1c-53eb-98c4-1750389eab42" :answer/id #uuid "05c026ae-ac1c-53eb-98c4-1750389eab42" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-e8327b3c-174b-5286-b01b-5ae9db175fe7" :answer-field/id #uuid "e8327b3c-174b-5286-b01b-5ae9db175fe7" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a631b40f-dcc6-5bdb-b2e8-93b83082dd5c" :answer-field/choices ["answer-a631b40f-dcc6-5bdb-b2e8-93b83082dd5c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a631b40f-dcc6-5bdb-b2e8-93b83082dd5c" :answer/id #uuid "a631b40f-dcc6-5bdb-b2e8-93b83082dd5c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-9de18b18-ac36-55ed-9eeb-ad23a6b9ac98" :question/id #uuid "9de18b18-ac36-55ed-9eeb-ad23a6b9ac98" :question/math-academy-id "q-276042" :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}5 & -1\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}0 & 1 \\\\ -1 & -1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}0 & 1 \\\\ -1 & -1\\end{aligned}]+[\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & -2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}5 \\\\ -1\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0+0 \\\\ 0+2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aa55b97d-8499-5057-8619-61c35e2dc5f2" "answer-field-5b288cd4-9ea2-5bcc-bf0a-296457d3c81e"] :db/ensure [:question/validate]} {:db/id "answer-field-aa55b97d-8499-5057-8619-61c35e2dc5f2" :answer-field/id #uuid "aa55b97d-8499-5057-8619-61c35e2dc5f2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-85ce4622-61e3-5161-8887-f7653a676c93" :answer-field/choices ["answer-85ce4622-61e3-5161-8887-f7653a676c93"] :db/ensure [:answer-field/validate]} {:db/id "answer-85ce4622-61e3-5161-8887-f7653a676c93" :answer/id #uuid "85ce4622-61e3-5161-8887-f7653a676c93" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-5b288cd4-9ea2-5bcc-bf0a-296457d3c81e" :answer-field/id #uuid "5b288cd4-9ea2-5bcc-bf0a-296457d3c81e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f4ef699f-857f-5b56-9ba4-64e4abbc9940" :answer-field/choices ["answer-f4ef699f-857f-5b56-9ba4-64e4abbc9940"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4ef699f-857f-5b56-9ba4-64e4abbc9940" :answer/id #uuid "f4ef699f-857f-5b56-9ba4-64e4abbc9940" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186208957 :question/problem "Compute the gradient of the function $f:{R}^{2}\\to R$ defined by\n\n$$\nf(x)={x}^{T}[\\begin{aligned}1 & 3 \\\\ 0 & -1\\end{aligned}]x\n$$\n\nwith respect to $x$ at  $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T}.$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">$\\,{∇}_{x}f=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Defining the matrix $A$ as\n\n$$\nA=[\\begin{aligned}1 & 3 \\\\ 0 & -1\\end{aligned}],\n$$\n\nwe have $f(x)={x}^{T}Ax.$\n\nSince $A$ is not symmetric, we use the more general formula for the gradient of a quadratic function:\n\n$$\n{∇}_{x}f(x)=({A}^{T}+A)x\n$$\n\nFirst, we compute\n\n$$\n{A}^{T}=[\\begin{aligned}1 & 0 \\\\ 3 & -1\\end{aligned}],\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{A}^{T}+A & =[\\begin{aligned}1 & 0 \\\\ 3 & -1\\end{aligned}]+[\\begin{aligned}1 & 3 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 3 & -2\\end{aligned}].\\end{aligned}\n$$\n\nNow, compute the gradient at $x=[\\begin{aligned}1 \\\\ 0\\end{aligned}]:$\n\n$$\n\\begin{aligned}{∇}_{x}f(x) & =({A}^{T}+A)x \\\\  & =[\\begin{aligned}2 & 3 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2+0 \\\\ 3+0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186205485 :answer-field/correct "answer-b276ba5e-614d-56eb-b840-b87c5c18abf5" :answer-field/choices ["answer-b276ba5e-614d-56eb-b840-b87c5c18abf5"] :db/ensure [:answer-field/validate]} {:db/id "answer-b276ba5e-614d-56eb-b840-b87c5c18abf5" :answer/id #uuid "b276ba5e-614d-56eb-b840-b87c5c18abf5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186205486 :answer-field/correct "answer-785c6b67-1726-563e-bd72-64447433e923" :answer-field/choices ["answer-785c6b67-1726-563e-bd72-64447433e923"] :db/ensure [:answer-field/validate]} {:db/id "answer-785c6b67-1726-563e-bd72-64447433e923" :answer/id #uuid "785c6b67-1726-563e-bd72-64447433e923" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-41cc5d66-bf23-517e-b32a-3cd7a74b1b32" :question/id #uuid "41cc5d66-bf23-517e-b32a-3cd7a74b1b32" :question/math-academy-id "q-269549" :question/problem "Consider the function $L:{R}^{2}\\to R$ defined by $L(x)=(2Ax+b)^{T}(2Ax+b)$ where \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}0 \\\\ -2\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=2Ax+b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(2Ax+b)=2A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & =(2A)^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}0 \\\\ -2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & =(2A)^{T}\\cdot 2y \\\\  & =4\\cdot {A}^{T}(2Ax+b) \\\\  & =4\\cdot {[\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}]}^{T}(2\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 2 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]) \\\\  & =4\\cdot [\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 0\\end{aligned}](2\\cdot [\\begin{aligned}-2 \\\\ -4 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]) \\\\  & =[\\begin{aligned}0 & 4 & 8 \\\\ 4 & 8 & 0\\end{aligned}]\\cdot [\\begin{aligned}-5 \\\\ -6 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-24 \\\\ -68\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-86232881-3656-545b-b963-9a0c99bf87aa"] :db/ensure [:question/validate]} {:db/id "answer-field-86232881-3656-545b-b963-9a0c99bf87aa" :answer-field/id #uuid "86232881-3656-545b-b963-9a0c99bf87aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a9dc4e7-8077-518c-b53a-ff8f2d256e06" :answer-field/choices ["answer-6a9dc4e7-8077-518c-b53a-ff8f2d256e06" "answer-4182ba73-9501-5f1c-9045-cd1a7928503c" "answer-679dcc5a-5a9f-55d5-aac6-b3a5f41d78af" "answer-53197217-2f27-584f-b12c-4e35c041f0cb" "answer-c6597316-83c7-5e8b-81d5-baa98c470d15"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a9dc4e7-8077-518c-b53a-ff8f2d256e06" :answer/id #uuid "6a9dc4e7-8077-518c-b53a-ff8f2d256e06" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-24 \\\\ -68\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4182ba73-9501-5f1c-9045-cd1a7928503c" :answer/id #uuid "4182ba73-9501-5f1c-9045-cd1a7928503c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-35 & 55\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-679dcc5a-5a9f-55d5-aac6-b3a5f41d78af" :answer/id #uuid "679dcc5a-5a9f-55d5-aac6-b3a5f41d78af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}17 \\\\ 15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-53197217-2f27-584f-b12c-4e35c041f0cb" :answer/id #uuid "53197217-2f27-584f-b12c-4e35c041f0cb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}34 \\\\ -10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c6597316-83c7-5e8b-81d5-baa98c470d15" :answer/id #uuid "c6597316-83c7-5e8b-81d5-baa98c470d15" :answer/type :answer.type/math :answer/value "[\\begin{aligned}49 & -32\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-d5a5695b-8296-5985-af65-b20134a9d8cb" :question/id #uuid "d5a5695b-8296-5985-af65-b20134a9d8cb" :question/math-academy-id "q-269465" :question/problem "Consider the function $L:{R}^{3}\\to R$ defined by $L(x)=(5Ax-b)^{T}(5Ax-b)$ where \n\n$$\nA=[\\begin{aligned}0 & 2 & 3 \\\\ 1 & 0 & 2\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ 5\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=5Ax-b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(5Ax-b)=5A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & =(5A)^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & =(5A)^{T}\\cdot 2y \\\\  & =10\\cdot {A}^{T}(5Ax-b) \\\\  & =10\\cdot {[\\begin{aligned}0 & 2 & 3 \\\\ 1 & 0 & 2\\end{aligned}]}^{T}(5\\cdot [\\begin{aligned}0 & 2 & 3 \\\\ 1 & 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]-[\\begin{aligned}4 \\\\ 5\\end{aligned}]) \\\\  & =10\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ 3 & 2\\end{aligned}](5\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ 5\\end{aligned}]) \\\\  & =10\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ 3 & 2\\end{aligned}]([\\begin{aligned}10 \\\\ 5\\end{aligned}]-[\\begin{aligned}4 \\\\ 5\\end{aligned}]) \\\\  & =10\\cdot [\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}6 \\\\ 0\\end{aligned}] \\\\  & =10\\cdot [\\begin{aligned}0 \\\\ 12 \\\\ 18\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 120 \\\\ 180\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6bbd1a5c-0501-5482-a310-9debd05ca9bc"] :db/ensure [:question/validate]} {:db/id "answer-field-6bbd1a5c-0501-5482-a310-9debd05ca9bc" :answer-field/id #uuid "6bbd1a5c-0501-5482-a310-9debd05ca9bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-957a9f6c-3b1e-5704-941b-815bbeb74ee2" :answer-field/choices ["answer-de485c91-3834-59a5-9cbb-f1af63ef0211" "answer-ca3252ab-ce3d-5f5e-9724-067f5f2fb76b" "answer-957a9f6c-3b1e-5704-941b-815bbeb74ee2" "answer-42dd4b42-211d-5972-b5c4-cf90c5e8012b" "answer-b2d6caca-dd94-5d02-ac30-3a83b5799cc4"] :db/ensure [:answer-field/validate]} {:db/id "answer-de485c91-3834-59a5-9cbb-f1af63ef0211" :answer/id #uuid "de485c91-3834-59a5-9cbb-f1af63ef0211" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 12 & 18\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ca3252ab-ce3d-5f5e-9724-067f5f2fb76b" :answer/id #uuid "ca3252ab-ce3d-5f5e-9724-067f5f2fb76b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 12 \\\\ 18\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-957a9f6c-3b1e-5704-941b-815bbeb74ee2" :answer/id #uuid "957a9f6c-3b1e-5704-941b-815bbeb74ee2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 120 \\\\ 180\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-42dd4b42-211d-5972-b5c4-cf90c5e8012b" :answer/id #uuid "42dd4b42-211d-5972-b5c4-cf90c5e8012b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}120 & 0 & 180\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b2d6caca-dd94-5d02-ac30-3a83b5799cc4" :answer/id #uuid "b2d6caca-dd94-5d02-ac30-3a83b5799cc4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 & 12 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-411aabaa-bd7a-5b74-b0d5-19adca16cb89" :question/id #uuid "411aabaa-bd7a-5b74-b0d5-19adca16cb89" :question/math-academy-id "q-269470" :question/problem "Consider the function $L:{R}^{3}\\to R$ defined by $L(x)=(Ax-2b)^{T}(Ax-2b)$ where \n\n$$\nA=[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{x}L(x)$ at $x=[\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]?$" :question/worked-solution "We can solve this problem by applying the chain rule for gradients.\n\nLet $y=Ax-2b.$ Then, $L(x)={y}^{T}y,$ and\n\n$$\n{∇}_{x}L={(\\frac{\\text{d}L}{\\text{d}x})}^{T}={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T}.\n$$\n\nNow, since \n\n$$\n\\frac{\\text{d}}{\\text{d}y}({y}^{T}y)=2{y}^{T}\\,\\text{and}\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}}{\\text{d}x}(Ax-2b)=A,\n$$\n\nwe have that \n\n$$\n\\begin{aligned}{∇}_{x}L & ={(\\frac{\\text{d}y}{\\text{d}x})}^{T}\\cdot {(\\frac{\\text{d}L}{\\text{d}y})}^{T} \\\\  & ={A}^{T}\\cdot 2y.\\end{aligned}\n$$\n\nEvaluating at $x=[\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]$, we get\n\n$$\n\\begin{aligned}{∇}_{x}L & ={A}^{T}\\cdot 2y \\\\  & =2\\cdot {A}^{T}(Ax-2b) \\\\  & =2\\cdot {[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}]}^{T}([\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}]-2[\\begin{aligned}2 \\\\ 3\\end{aligned}]) \\\\  & =2\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 3 & 0\\end{aligned}]([\\begin{aligned}9 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ 6\\end{aligned}]) \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 2 \\\\ 6 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ -10 \\\\ 30\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7d61f281-b20f-5b2b-9b40-f631fe100b4f"] :db/ensure [:question/validate]} {:db/id "answer-field-7d61f281-b20f-5b2b-9b40-f631fe100b4f" :answer-field/id #uuid "7d61f281-b20f-5b2b-9b40-f631fe100b4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-142f877f-e698-5254-93da-53589da88451" :answer-field/choices ["answer-3b802d7a-2645-5ba2-9341-530841a24204" "answer-142f877f-e698-5254-93da-53589da88451" "answer-733ac048-f58d-5680-814f-d36675d8c2f1" "answer-f414dbbc-4b36-56b2-8d02-f57f2d9a1e36" "answer-9d2f0e60-7b67-503d-9ec7-438462275ae8"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b802d7a-2645-5ba2-9341-530841a24204" :answer/id #uuid "3b802d7a-2645-5ba2-9341-530841a24204" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & -10 & 30\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-142f877f-e698-5254-93da-53589da88451" :answer/id #uuid "142f877f-e698-525