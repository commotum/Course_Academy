 ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-0fa7ac06-8f23-52b1-a003-b4d31f99965a" :answer/id #uuid "0fa7ac06-8f23-52b1-a003-b4d31f99965a" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi /2\\}" :db/ensure [:answer/validate]} {:db/id "answer-f6f04e7a-6ee7-574b-9acd-39ccfd7fa0e7" :answer/id #uuid "f6f04e7a-6ee7-574b-9acd-39ccfd7fa0e7" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-7b887772-b201-5bfa-90a5-89c7bb297020" :answer/id #uuid "7b887772-b201-5bfa-90a5-89c7bb297020" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-bdcbbfdf-efed-5827-9f40-6d1768ae8a4f" :answer/id #uuid "bdcbbfdf-efed-5827-9f40-6d1768ae8a4f" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le 2\\pi \\}" :db/ensure [:answer/validate]} {:db/id 17592186281345 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\n![](images/0d/0d901312b6a14c863085276458cf8341cbd4cb6cc5411d5c5045244b8c656eb2.png)\n\n  \n\nNotice that inside our region, the spherical polar coordinates vary withing the following domains:\n\n- $\\rho \\in [0,2]$\n\n- $\\theta \\in [0,\\frac{\\pi }{2}]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186281276 :answer-field/correct "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer-field/choices ["answer-20ef2694-93c9-5433-b86a-aa9f99a0bde9" "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" "answer-4220d81b-5fee-5b30-8b21-5a4d1398318f" "answer-5962da49-0814-5ce2-838a-0da88eb72219" "answer-895ec483-a133-5e14-a169-801e1f3a0cdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-20ef2694-93c9-5433-b86a-aa9f99a0bde9" :answer/id #uuid "20ef2694-93c9-5433-b86a-aa9f99a0bde9" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi /2\\}" :db/ensure [:answer/validate]} {:db/id "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer/id #uuid "e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-4220d81b-5fee-5b30-8b21-5a4d1398318f" :answer/id #uuid "4220d81b-5fee-5b30-8b21-5a4d1398318f" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-5962da49-0814-5ce2-838a-0da88eb72219" :answer/id #uuid "5962da49-0814-5ce2-838a-0da88eb72219" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le 2\\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-895ec483-a133-5e14-a169-801e1f3a0cdf" :answer/id #uuid "895ec483-a133-5e14-a169-801e1f3a0cdf" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{2},\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi /2\\}" :db/ensure [:answer/validate]} {:db/id "question-1b4d1e3e-36ae-5b22-9e31-1455caee6c30" :question/id #uuid "1b4d1e3e-36ae-5b22-9e31-1455caee6c30" :question/math-academy-id "q-161852" :question/problem "![](images/b1/b15c12a1cabbab36feab2d15e1ac3d73e8d8c26afc14a8b820e2ca6f57d7d48d.png)\n\nThe solid enclosed by the sphere ${x}^{2}+{y}^{2}+{z}^{2}=2z,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $1$ centered at $(0,0,1).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=2z$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =2z \\\\ {\\rho }^{2} & =2\\rho \\operatorname{cos}⁡ϕ \\\\ \\rho (\\rho -2\\operatorname{cos}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =2\\operatorname{cos}⁡ϕ.$\n\n![](images/66/66812de081c1bbfe515162ab628806717b5602ec1a6cc61eaf22514f91e9c0ea.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,2\\rho \\operatorname{cos}⁡ϕ]$\n\n- $\\theta \\in [0,2\\pi ]$\n\n- $ϕ\\in [0,\\frac{\\pi }{2}]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2ef5564a-71c2-51d9-a5c5-1e430a20af03"] :db/ensure [:question/validate]} {:db/id "answer-field-2ef5564a-71c2-51d9-a5c5-1e430a20af03" :answer-field/id #uuid "2ef5564a-71c2-51d9-a5c5-1e430a20af03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer-field/choices ["answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" "answer-f98a9165-7703-5823-a7ab-afca420773e0" "answer-e8643e12-d858-53e7-9f58-5292e345b9fb" "answer-821c59c1-9fae-533c-87a2-1c8d423ee015" "answer-8f75f27a-bcb9-5bed-b305-7616971ca23d"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer/id #uuid "1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-f98a9165-7703-5823-a7ab-afca420773e0" :answer/id #uuid "f98a9165-7703-5823-a7ab-afca420773e0" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-e8643e12-d858-53e7-9f58-5292e345b9fb" :answer/id #uuid "e8643e12-d858-53e7-9f58-5292e345b9fb" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-821c59c1-9fae-533c-87a2-1c8d423ee015" :answer/id #uuid "821c59c1-9fae-533c-87a2-1c8d423ee015" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-8f75f27a-bcb9-5bed-b305-7616971ca23d" :answer/id #uuid "8f75f27a-bcb9-5bed-b305-7616971ca23d" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186363444 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-quarter of the sphere of radius $1$ centered at $(0,0,-1).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}+2z=0$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2}+2z & =0 \\\\ {\\rho }^{2}+2\\rho \\operatorname{cos}⁡ϕ & =0 \\\\ \\rho (\\rho +2\\operatorname{cos}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-2\\operatorname{cos}⁡ϕ.$\n\n![](images/14/1499d492c526bad77e81aca1128b6160cc574a209ad7706e8d89b3012112e1df.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,-2\\operatorname{cos}⁡ϕ]$\n\n- $\\theta \\in [0,\\frac{\\pi }{2}]$\n\n- $ϕ\\in [\\frac{\\pi }{2},\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186363445 :answer-field/correct "answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer-field/choices ["answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" "answer-2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" "answer-a973e4e0-ee5f-5fc6-ab29-b94e84360208" "answer-722d91c6-40fa-56a4-867b-919bace76541" "answer-da839e87-16a6-50ac-87fc-5f547394b48e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer/id #uuid "ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" :answer/id #uuid "2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-a973e4e0-ee5f-5fc6-ab29-b94e84360208" :answer/id #uuid "a973e4e0-ee5f-5fc6-ab29-b94e84360208" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-722d91c6-40fa-56a4-867b-919bace76541" :answer/id #uuid "722d91c6-40fa-56a4-867b-919bace76541" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-da839e87-16a6-50ac-87fc-5f547394b48e" :answer/id #uuid "da839e87-16a6-50ac-87fc-5f547394b48e" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186281370 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $2$ centered at $(0,-2,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}+4y=0$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2}+4y & =0 \\\\ {\\rho }^{2}+4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & =0 \\\\ \\rho (\\rho +4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/e2/e2865e838521a8864ad76d72e520d4b128a8fceb8c18cb9c35ba10134419c4eb.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [\\pi ,2\\pi ]$\n\n- $ϕ\\in [\\frac{\\pi }{2},\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186281177 :answer-field/correct "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer-field/choices ["answer-0888c7a6-5da3-5a1f-b87d-986ab2864e10" "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" "answer-18faa7fa-7eb2-59fb-8bb6-a8207578ac26" "answer-f3af3470-369d-504e-8f80-0f77cd8a8f68" "answer-3c9d4d58-b589-531c-a608-5dd3c04d9134"] :db/ensure [:answer-field/validate]} {:db/id "answer-0888c7a6-5da3-5a1f-b87d-986ab2864e10" :answer/id #uuid "0888c7a6-5da3-5a1f-b87d-986ab2864e10" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer/id #uuid "7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-18faa7fa-7eb2-59fb-8bb6-a8207578ac26" :answer/id #uuid "18faa7fa-7eb2-59fb-8bb6-a8207578ac26" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-f3af3470-369d-504e-8f80-0f77cd8a8f68" :answer/id #uuid "f3af3470-369d-504e-8f80-0f77cd8a8f68" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-3c9d4d58-b589-531c-a608-5dd3c04d9134" :answer/id #uuid "3c9d4d58-b589-531c-a608-5dd3c04d9134" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186176398 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at $(0,2,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=4y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =4y \\\\ {\\rho }^{2} & =4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/3a/3a6985012edbaf28ca42d88fd47e3769fa53704cad8f8c09021c944d966a3d48.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [0,\\pi ]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186363431 :answer-field/correct "answer-805a0a6c-588a-5652-8708-ef6f81947bad" :answer-field/choices ["answer-5088423b-db3e-54df-b831-a57602e5ebe9" "answer-bfd5bc74-b990-585b-b3cb-9771824e5c92" "answer-6bd62de5-f0c5-582e-9f22-e1174588775b" "answer-805a0a6c-588a-5652-8708-ef6f81947bad" "answer-f8e6ef4b-e544-53c2-99a8-afb161df11b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5088423b-db3e-54df-b831-a57602e5ebe9" :answer/id #uuid "5088423b-db3e-54df-b831-a57602e5ebe9" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\rho \\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-bfd5bc74-b990-585b-b3cb-9771824e5c92" :answer/id #uuid "bfd5bc74-b990-585b-b3cb-9771824e5c92" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\rho \\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-6bd62de5-f0c5-582e-9f22-e1174588775b" :answer/id #uuid "6bd62de5-f0c5-582e-9f22-e1174588775b" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-805a0a6c-588a-5652-8708-ef6f81947bad" :answer/id #uuid "805a0a6c-588a-5652-8708-ef6f81947bad" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-f8e6ef4b-e544-53c2-99a8-afb161df11b4" :answer/id #uuid "f8e6ef4b-e544-53c2-99a8-afb161df11b4" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "question-a7ea971b-d67e-5a60-86aa-35a475db9053" :question/id #uuid "a7ea971b-d67e-5a60-86aa-35a475db9053" :question/math-academy-id "q-161851" :question/problem "![](images/d8/d829e8f51e5cd49bf20587f0cd70abd29a8dd1a336a6bad827541726c9cd4416.png)\n\nThe solid enclosed by the sphere ${x}^{2}+{y}^{2}+{z}^{2}=4x,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at $(2,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=4x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =4x \\\\ {\\rho }^{2} & =4\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/df/dfc7359ad44caa959459676a1e54bf1575e3c7e0f771e92a74817d9d1f9cb581.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a25a1262-2d6c-5d10-9f4a-f4ca15577a84"] :db/ensure [:question/validate]} {:db/id "answer-field-a25a1262-2d6c-5d10-9f4a-f4ca15577a84" :answer-field/id #uuid "a25a1262-2d6c-5d10-9f4a-f4ca15577a84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer-field/choices ["answer-3ac36fc6-724d-59ba-bc41-3af29a3a8de8" "answer-c9301d6b-61d0-5484-9019-19d7b668ce0f" "answer-cb387986-8ebd-5bb9-877c-9abb1c25a852" "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" "answer-a1c646fb-4131-53cd-a9c8-3a4ae803fde4"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ac36fc6-724d-59ba-bc41-3af29a3a8de8" :answer/id #uuid "3ac36fc6-724d-59ba-bc41-3af29a3a8de8" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-c9301d6b-61d0-5484-9019-19d7b668ce0f" :answer/id #uuid "c9301d6b-61d0-5484-9019-19d7b668ce0f" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le 2\\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-cb387986-8ebd-5bb9-877c-9abb1c25a852" :answer/id #uuid "cb387986-8ebd-5bb9-877c-9abb1c25a852" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer/id #uuid "ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-a1c646fb-4131-53cd-a9c8-3a4ae803fde4" :answer/id #uuid "a1c646fb-4131-53cd-a9c8-3a4ae803fde4" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ,\\,-\\pi \\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186176120 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186217108 :knowledge-point/questions ["question-d109f13f-6c22-5d50-a9f4-da3fbec07962" "question-8a3fea1f-f2c7-5a54-bfc4-1db59932f81e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186216959 :question/problem "The parabola $y = x^2 + 2$ and the line $y = 3x$ intersect at the points $(x_1, y_1)$ and $(x_2, y_2),$ where $x_1 <        x_2.$ What is the value of $x_1 + x_2?$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+2 \\\\ y=3x\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+2 & =3x \\\\ {x}^{2}-3x+2 & =0 \\\\ (x-1)(x-2) & =0 \\\\ x & =1,2.\\end{aligned}\n$$\n\nSo, the $x$-coordinates of the intersection points are $x_1 = 1$ and $x_2 = 2.$ Therefore,\n\n$$\nx_1 + x_2 = 1 + 2 = 3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186217109 :knowledge-point/questions ["question-3860fd8d-fa51-5495-8869-9f057f53d9a4" "question-82d663f5-9675-5779-8562-0b4d4248c2b2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186216960 :question/problem "The parabola ![](images/49/49d58a04c172fb017d3e63107af8686694a70f8b3b281b61f1bf80fbbce1903c.svg) and the line ![](images/da/dad6e7d0144b11544800cab8e15352011d03b14a429fd6b38518e6d764777fbb.svg) intersect at the points ![](images/58/586d275bc1ac46d094c469d88dfd59d0a63d2ede5496929e15923c42b180fd47.svg) and ![](images/af/afa2f1d8401bc59845387bc9c7d1d6b765abe9c638b3c28f1914f6bd9458e348.svg) where ![](images/ba/bac1330d96cc473aab0c7d4fb929105e307a215a8e6031084e7c9cc61cb87b66.svg) What is the value of ![](images/f5/f52303e047d6e35cf5061a15e4136e4f253bf4cdd2d421145f8a58b05389a469.svg)" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n![](images/31/318d27072067aa70d893f2a1c0dc118ad7caced10b9ca5567b5bb0f91638ef30.svg)\n\nSetting the equations equal to one another and solving, we get\n![](images/c3/c3bb314de0a4b80fb6d51bbb155484aa968fee78d81011fd578cc8b8bca04df2.svg)\n\nSince ![](images/25/25273d659db203df5af353cdda1a390bdbb635b59363390a0ca00b45fdd24bb2.svg) the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinates of the intersection points are ![](images/4f/4fe2b5629a57d8e984a53a0887f0ab10595a82fe303f8c70080cff9039ee200f.svg) and ![](images/42/428ebea63626be22a9e5b18f6f4bd8ceba019bd6d3e685a0621e843604f0f826.svg) \n\nTo find the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinates of the intersection points, we plug these values into either the curve or the line. Let's choose the line since it's simpler.\n\n- Substituting ![](images/e3/e3f9686f4fa57342e9e4415fe494e0361ef79005a9c92c2192d11f8da980481f.svg) we get\n![](images/6b/6bf49ff9ecea5536117e06be2a55625e2dd056609abec901f615ad74bd52c290.svg)\nso one point of intersection is ![](images/2f/2f7731330530547c0207184c710622d49d8b696419aaba6572ae0b65cc3672ee.svg)\n\n- Substituting ![](images/d7/d7657c785332cdb454794e479e9aae39f6d6f92532f10912f85c1bf3bc2fb317.svg) we get\n![](images/40/406ee9901d6670c3ddb3774fc575c5a1a80d33668dcb345a7a494f297df64147.svg)\nso the other point of intersection is ![](images/f0/f07ed4790b4cd3a20a4af1c48d680f6e6681feb972d35075171975f967eea468.svg)\n\nTherefore, ![](images/1d/1d7e290e5d4bac0018851250cc98d151231495c6cc9187aedaec060d1f9579bf.svg) and\n![](images/a5/a5c25be7330db098773c5566f2ce52d8f6cb65f06e0e9fc9bc4eb0b92a0ba534.svg)\n\nA sketch of the situation is shown below.\n\n![](images/da/da3cbc81f8170e3cf098a97d249e3ad8f0abf358fa641d8b94b1eb301f1a7858.png)" :db/ensure [:question/validate]} {:db/id 17592186217110 :knowledge-point/questions ["question-b39dbd28-21a4-5509-83b2-cf250304af27" "question-69684600-8c5e-5874-b78e-2cbd727505f9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186216961 :question/problem "The parabola $y=-x^2+6x$ and the line $y=9$ intersect at a single point with coordinates $(p,q).$ What is $p+q?$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y=-{x}^{2}+6x \\\\ y=9\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}-{x}^{2}+6x & =9 \\\\ -{x}^{2}+6x-9 & =0 \\\\ -({x}^{2}-6x+9) & =0 \\\\ -(x-3)(x-3) & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of the intersection point is $x=3.$ \n\nWe know the $y$-coordinate of the intersection point from the equation of the line. So, the only point of intersection is $(3, 9).$ Therefore, $p=3,\\; q=9,$ and\n\n$$\np+q = 3+9 = 12.\n$$\n\nA sketch of the situation is shown below.\n\n![](images/f9/f9d09e07988752af26143fa2dc8df260784be5fcb16c28d8115bb44fc3c1a4a1.png)" :db/ensure [:question/validate]} {:db/id 17592186217111 :knowledge-point/questions ["question-dace6513-0d3a-5c62-b857-525a505a8ea4" "question-9485be5f-7e9e-52c2-8dc7-d3a495a119a9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186216962 :question/problem "Given that the line $y=x +2k$ does **not** intersect the parabola $y=x^2-x+3,$ what is the range of possible values of $k?$" :question/worked-solution "To determine whether the line $y=x +2k$ intersects the parabola $y=x^2-x+3,$ we need to solve the following system of equations for the two curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}-x+3 \\\\ y=x+2k\\end{aligned}\n$$\n\nSetting the equations equal to one another and writing in standard form, we get\n\n$$\n\\begin{aligned}{x}^{2}-x+3 & =x+2k \\\\ {x}^{2}-2x+3-2k & =0.\\end{aligned}\n$$\n\nNow, we solve this equation using the quadratic formula with $a=1,\\, b=-2,$ and $c=3-2k{:}$\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(3-2k)}}{2(1)} \\\\  & =\\frac{2\\pm \\sqrt{4-12+8k}}{2} \\\\  & =\\frac{2\\pm \\sqrt{8k-8}}{2}\\end{aligned}\n$$\n\nSince the line and parabola do not intersect, our quadratic equation must have no real solutions; hence, the expression inside the square root must be negative.\nSetting up and solving this inequality, we get\n\n$$\n\\begin{aligned}8k-8 & <0 \\\\ 8k & <8 \\\\ k & <1.\\end{aligned}\n$$\n\nTherefore, the range of possible values of $k$ is $k \\lt   1.$" :db/ensure [:question/validate]} {:db/id "question-d109f13f-6c22-5d50-a9f4-da3fbec07962" :question/id #uuid "d109f13f-6c22-5d50-a9f4-da3fbec07962" :question/math-academy-id "q-155523" :question/problem "The parabola $y={x}^{2}-2$ and the line $y=x$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ What is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}-2 \\\\ y=x\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}-2 & =x \\\\ {x}^{2}-x-2 & =0 \\\\ (x+1)(x-2) & =0 \\\\ x & =-1,2.\\end{aligned}\n$$\n\nSo, the $x$-coordinates of the intersection points are ${x}_{1}=-1$ and ${x}_{2}=2.$ Therefore,\n\n$$\n{x}_{1}+{x}_{2}=-1+2=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c5c2381-aeb2-5e5f-8fa1-214d94fd8d00"] :db/ensure [:question/validate]} {:db/id "answer-field-4c5c2381-aeb2-5e5f-8fa1-214d94fd8d00" :answer-field/id #uuid "4c5c2381-aeb2-5e5f-8fa1-214d94fd8d00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e5a9def2-c17c-5098-82fa-fe65f39f5c2f" :answer-field/choices ["answer-f0dd39fb-017e-5809-bd44-92c3cd0e399c" "answer-d7787e12-314e-5739-b74c-e63de38ced70" "answer-e5a9def2-c17c-5098-82fa-fe65f39f5c2f" "answer-283ebc04-f8a2-5328-b526-0807928a5a14" "answer-e5ac17cb-7070-52ae-a020-36f3ef568515"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0dd39fb-017e-5809-bd44-92c3cd0e399c" :answer/id #uuid "f0dd39fb-017e-5809-bd44-92c3cd0e399c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-d7787e12-314e-5739-b74c-e63de38ced70" :answer/id #uuid "d7787e12-314e-5739-b74c-e63de38ced70" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-e5a9def2-c17c-5098-82fa-fe65f39f5c2f" :answer/id #uuid "e5a9def2-c17c-5098-82fa-fe65f39f5c2f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-283ebc04-f8a2-5328-b526-0807928a5a14" :answer/id #uuid "283ebc04-f8a2-5328-b526-0807928a5a14" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e5ac17cb-7070-52ae-a020-36f3ef568515" :answer/id #uuid "e5ac17cb-7070-52ae-a020-36f3ef568515" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-8a3fea1f-f2c7-5a54-bfc4-1db59932f81e" :question/id #uuid "8a3fea1f-f2c7-5a54-bfc4-1db59932f81e" :question/math-academy-id "q-250072" :question/problem "The parabola $y=-{x}^{2}+3x+15$ and the line $y=4x-5$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ Find the values of ${x}_{1}$ and  ${x}_{2}.$\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y=-{x}^{2}+3x+15 \\\\ y=4x-5\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}-{x}^{2}+3x+15 & =4x-5 \\\\ -{x}^{2}-x+20 & =0 \\\\ -({x}^{2}+x-20) & =0 \\\\ -(x+5)(x-4) & =0 \\\\ x & =-5,4.\\end{aligned}\n$$\n\nTherefore, the $x$-coordinates of the intersection points are ${x}_{1}=-5$ and ${x}_{2}=4.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-abca62a1-f98f-5e60-8172-1b9e4959acc5" "answer-field-b8833578-9795-544f-95d8-425c9b507a3a"] :db/ensure [:question/validate]} {:db/id "answer-field-abca62a1-f98f-5e60-8172-1b9e4959acc5" :answer-field/id #uuid "abca62a1-f98f-5e60-8172-1b9e4959acc5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-904862d5-897c-534e-9e2f-e61c615561b1" :answer-field/choices ["answer-904862d5-897c-534e-9e2f-e61c615561b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-904862d5-897c-534e-9e2f-e61c615561b1" :answer/id #uuid "904862d5-897c-534e-9e2f-e61c615561b1" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-field-b8833578-9795-544f-95d8-425c9b507a3a" :answer-field/id #uuid "b8833578-9795-544f-95d8-425c9b507a3a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4cef0f64-87f7-5719-93e3-ab9a559f0d4a" :answer-field/choices ["answer-4cef0f64-87f7-5719-93e3-ab9a559f0d4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cef0f64-87f7-5719-93e3-ab9a559f0d4a" :answer/id #uuid "4cef0f64-87f7-5719-93e3-ab9a559f0d4a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-3860fd8d-fa51-5495-8869-9f057f53d9a4" :question/id #uuid "3860fd8d-fa51-5495-8869-9f057f53d9a4" :question/math-academy-id "q-250073" :question/problem "The parabola $y={x}^{2}$ and the line $y=9x-14$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ Find the values of ${y}_{1}$ and ${y}_{2}.$\n\n${y}_{1}=$\n{{field-1}}$,\\,{y}_{2}=$\n{{field-2}}" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2} \\\\ y=9x-14\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2} & =9x-14 \\\\ {x}^{2}-9x+14 & =0 \\\\ (x-2)(x-7) & =0 \\\\ x & =2,7.\\end{aligned}\n$$\n\nSince ${x}_{1}<{x}_{2},$ the $x$-coordinates of the intersection points are ${x}_{1}=2$ and ${x}_{2}=7.$\n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the parabola since it's simpler.\n\n- Substituting ${x}_{1}=2,$ we get\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1}^{2} \\\\  & =(2)^{2} \\\\  & =4,\\end{aligned}\n$$\n\nso one point of intersection is $({x}_{1},{y}_{1})=(2,4).$\n\n- Substituting ${x}_{2}=7,$ we get\n\n$$\n\\begin{aligned}{y}_{2} & ={x}_{2}^{2} \\\\  & =(7)^{2} \\\\  & =49,\\end{aligned}\n$$\n\nso the other point of intersection is $({x}_{2},{y}_{2})=(7,49).$\n\nA sketch of the situation is shown below.\n\n![](images/4e/4e0ce399e32d7b957b71384d61cf08024b5d9995fde28d5f1fac71e1f123b2aa.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-065b0803-ec37-52f0-b035-55be85dd7364" "answer-field-5a8aefaa-4fc2-5f99-957b-9d1dc03b153e"] :db/ensure [:question/validate]} {:db/id "answer-field-065b0803-ec37-52f0-b035-55be85dd7364" :answer-field/id #uuid "065b0803-ec37-52f0-b035-55be85dd7364" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b1426c5a-cb34-58ac-9b8e-e7c4a43242b5" :answer-field/choices ["answer-b1426c5a-cb34-58ac-9b8e-e7c4a43242b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1426c5a-cb34-58ac-9b8e-e7c4a43242b5" :answer/id #uuid "b1426c5a-cb34-58ac-9b8e-e7c4a43242b5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-5a8aefaa-4fc2-5f99-957b-9d1dc03b153e" :answer-field/id #uuid "5a8aefaa-4fc2-5f99-957b-9d1dc03b153e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-19f7c4fa-35f3-5ea1-bf8d-567b0e9bd672" :answer-field/choices ["answer-19f7c4fa-35f3-5ea1-bf8d-567b0e9bd672"] :db/ensure [:answer-field/validate]} {:db/id "answer-19f7c4fa-35f3-5ea1-bf8d-567b0e9bd672" :answer/id #uuid "19f7c4fa-35f3-5ea1-bf8d-567b0e9bd672" :answer/type :answer.type/math :answer/value "49" :db/ensure [:answer/validate]} {:db/id "question-82d663f5-9675-5779-8562-0b4d4248c2b2" :question/id #uuid "82d663f5-9675-5779-8562-0b4d4248c2b2" :question/math-academy-id "q-250076" :question/problem "The parabola $y={x}^{2}+2x-3$ and the line $y=5x+7$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ Find the values of ${y}_{1}$ and ${y}_{2}.$\n\n${y}_{1}=$\n{{field-1}}$,\\,{y}_{2}=$\n{{field-2}}" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+2x-3 \\\\ y=5x+7\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+2x-3 & =5x+7 \\\\ {x}^{2}-3x-10 & =0 \\\\ (x+2)(x-5) & =0 \\\\ x & =-2,5.\\end{aligned}\n$$\n\nSince ${x}_{1}<{x}_{2},$ the $x$-coordinates of the intersection points are ${x}_{1}=-2$ and ${x}_{2}=5.$\n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the line since it's simpler.\n\n- Substituting ${x}_{1}=-2,$ we get\n\n$$\n\\begin{aligned}{y}_{1} & =5{x}_{1}+7 \\\\  & =5(-2)+7 \\\\  & =-3,\\end{aligned}\n$$\n\nso one point of intersection is $({x}_{1},{y}_{1})=(-2,-3).$\n\n- Substituting ${x}_{2}=5,$ we get\n\n$$\n\\begin{aligned}{y}_{2} & =5{x}_{2}+7 \\\\  & =5(5)+7 \\\\  & =32,\\end{aligned}\n$$\n\nso the other point of intersection is $({x}_{2},{y}_{2})=(5,32).$\n\nA sketch of the situation is shown below.\n\n![](images/98/98d656438193d68da44573720da4a0fa5f7e1f7d253c29e0de2e309468c8b552.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-75cc18fd-6c53-54eb-b993-7a84046752bf" "answer-field-eeeb0417-7377-5df8-aa31-302ace210d7c"] :db/ensure [:question/validate]} {:db/id "answer-field-75cc18fd-6c53-54eb-b993-7a84046752bf" :answer-field/id #uuid "75cc18fd-6c53-54eb-b993-7a84046752bf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a59d5def-358e-53b7-8955-ecdd2b78feb6" :answer-field/choices ["answer-a59d5def-358e-53b7-8955-ecdd2b78feb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-a59d5def-358e-53b7-8955-ecdd2b78feb6" :answer/id #uuid "a59d5def-358e-53b7-8955-ecdd2b78feb6" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-field-eeeb0417-7377-5df8-aa31-302ace210d7c" :answer-field/id #uuid "eeeb0417-7377-5df8-aa31-302ace210d7c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3b65d251-1335-5b26-a787-171e76d4951a" :answer-field/choices ["answer-3b65d251-1335-5b26-a787-171e76d4951a"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b65d251-1335-5b26-a787-171e76d4951a" :answer/id #uuid "3b65d251-1335-5b26-a787-171e76d4951a" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "question-b39dbd28-21a4-5509-83b2-cf250304af27" :question/id #uuid "b39dbd28-21a4-5509-83b2-cf250304af27" :question/math-academy-id "q-250085" :question/problem "The parabola $y=-{x}^{2}-4x$ and the line $y=4$ intersect at the point $P.$ Find the coordinates of $P.$\n\nThe coordinates of $P$ are\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y=-{x}^{2}-4x \\\\ y=4\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}-{x}^{2}-4x & =4 \\\\ -{x}^{2}-4x-4 & =0 \\\\ -({x}^{2}+4x+4) & =0 \\\\ -(x+2)(x+2) & =0 \\\\ x & =-2.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of the intersection point is $x=-2.$\n\nWe know the y-coordinate of the intersection point from the equation of the line. So, the only point of intersection is $(-2,4).$\n\nA sketch of the situation is shown below.\n\n![](images/18/187c98be201ec084cdd4fb21f0347f9d768c251cfedcacc9532d754741199e14.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-133c52bf-75f1-5b10-8319-1bbbc0724fa9" "answer-field-795ff076-e948-5018-81c9-39834569438a"] :db/ensure [:question/validate]} {:db/id "answer-field-133c52bf-75f1-5b10-8319-1bbbc0724fa9" :answer-field/id #uuid "133c52bf-75f1-5b10-8319-1bbbc0724fa9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-abedf875-4b66-5cf2-8796-0df622776e78" :answer-field/choices ["answer-abedf875-4b66-5cf2-8796-0df622776e78"] :db/ensure [:answer-field/validate]} {:db/id "answer-abedf875-4b66-5cf2-8796-0df622776e78" :answer/id #uuid "abedf875-4b66-5cf2-8796-0df622776e78" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-795ff076-e948-5018-81c9-39834569438a" :answer-field/id #uuid "795ff076-e948-5018-81c9-39834569438a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a82dbd44-f08e-5a33-b1b6-6f9773885612" :answer-field/choices ["answer-a82dbd44-f08e-5a33-b1b6-6f9773885612"] :db/ensure [:answer-field/validate]} {:db/id "answer-a82dbd44-f08e-5a33-b1b6-6f9773885612" :answer/id #uuid "a82dbd44-f08e-5a33-b1b6-6f9773885612" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-69684600-8c5e-5874-b78e-2cbd727505f9" :question/id #uuid "69684600-8c5e-5874-b78e-2cbd727505f9" :question/math-academy-id "q-155534" :question/problem "The parabola $y={x}^{2}+x$ and the line $y=3x-1$ intersect at a single point with coordinates $(p,q).$ What is $p+q?$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+x \\\\ y=3x-1\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+x & =3x-1 \\\\ {x}^{2}+x-3x+1 & =0 \\\\ {x}^{2}-2x+1 & =0 \\\\ (x-1)(x-1) & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of the intersection point is $x=1.$ \n\nTo find the $y$-coordinate of the intersection point, we plug this value into either curve. \nLet's choose the equation of the line. Substituting $x=1,$ we get\n\n$$\n\\begin{aligned}y & =3x-1 \\\\  & =3(1)-1 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the only point of intersection is $(1,2).$ Therefore, $p=1,\\,q=2,$ and \n\n$$\np+q=1+2=3.\n$$\n\nA sketch of the situation is shown below.\n\n![](images/53/53b8622b0d2fa3fa756d5520d24849fb633539fb471037b9fce6c97464a5fc20.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2d6ee34c-e06e-5482-9e88-a1329d3b48a1"] :db/ensure [:question/validate]} {:db/id "answer-field-2d6ee34c-e06e-5482-9e88-a1329d3b48a1" :answer-field/id #uuid "2d6ee34c-e06e-5482-9e88-a1329d3b48a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-85e130e6-d2bb-54dd-9b8e-4da5b5c088bb" :answer-field/choices ["answer-101089e6-8955-56e5-a9af-e1292704d66d" "answer-32a2455a-2737-50ee-86bb-360681e30611" "answer-cd3a215d-79d6-530f-8102-b49ccd071024" "answer-85e130e6-d2bb-54dd-9b8e-4da5b5c088bb" "answer-a5c11f76-19e6-5543-8fb4-9888b01581c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-101089e6-8955-56e5-a9af-e1292704d66d" :answer/id #uuid "101089e6-8955-56e5-a9af-e1292704d66d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-32a2455a-2737-50ee-86bb-360681e30611" :answer/id #uuid "32a2455a-2737-50ee-86bb-360681e30611" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-cd3a215d-79d6-530f-8102-b49ccd071024" :answer/id #uuid "cd3a215d-79d6-530f-8102-b49ccd071024" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-85e130e6-d2bb-54dd-9b8e-4da5b5c088bb" :answer/id #uuid "85e130e6-d2bb-54dd-9b8e-4da5b5c088bb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a5c11f76-19e6-5543-8fb4-9888b01581c9" :answer/id #uuid "a5c11f76-19e6-5543-8fb4-9888b01581c9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-dace6513-0d3a-5c62-b857-525a505a8ea4" :question/id #uuid "dace6513-0d3a-5c62-b857-525a505a8ea4" :question/math-academy-id "q-250156" :question/problem "Given that the line $y=3x+2$ does **not** intersect the parabola $y={x}^{2}+5x+k,$ find the range of possible values of $k.$\n\n$k$\n{{field-1}}{{field-2}}" :question/worked-solution "To determine whether the line $y=3x+2$ intersects the parabola $y={x}^{2}+5x+k,$ we need to solve the following system of equations for the two curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+5x+k \\\\ y=3x+2\\end{aligned}\n$$\n\nSetting the equations equal to one another and writing in standard form, we get\n\n$$\n\\begin{aligned}{x}^{2}+5x+k & =3x+2 \\\\ {x}^{2}+2x+(k-2) & =0.\\end{aligned}\n$$\n\nNow, we solve this equation using the quadratic formula with $a=1,$ $b=2,$ and $c=k-2:$\n\n$$\n\\begin{aligned}x & =\\frac{-2\\pm \\sqrt{(2)^{2}-4(1)(k-2)}}{2(1)} \\\\  & =\\frac{-2\\pm \\sqrt{4-4k+8}}{2} \\\\  & =\\frac{-2\\pm \\sqrt{12-4k}}{2}\\end{aligned}\n$$\n\nSince the line and parabola do not intersect, our quadratic equation must have no real solutions; hence, the expression inside the square root must be negative. Setting up and solving this inequality, we get\n\n$$\n\\begin{aligned}12-4k & <0 \\\\ -4k & <-12 \\\\ k & >3.\\end{aligned}\n$$\n\nTherefore, the range of possible values of $k$ is $k>3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bef92fe3-e86f-53cd-bf4b-51bb44134db0" "answer-field-537c7c57-4db6-5792-bbce-5d1fd693dffa"] :db/ensure [:question/validate]} {:db/id "answer-field-bef92fe3-e86f-53cd-bf4b-51bb44134db0" :answer-field/id #uuid "bef92fe3-e86f-53cd-bf4b-51bb44134db0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ec28ef51-9620-5155-9c04-545b698f6e12" :answer-field/choices ["answer-ec28ef51-9620-5155-9c04-545b698f6e12"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec28ef51-9620-5155-9c04-545b698f6e12" :answer/id #uuid "ec28ef51-9620-5155-9c04-545b698f6e12" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "answer-field-537c7c57-4db6-5792-bbce-5d1fd693dffa" :answer-field/id #uuid "537c7c57-4db6-5792-bbce-5d1fd693dffa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-aae80146-7711-5756-a3e1-b69c4a8b8bcc" :answer-field/choices ["answer-aae80146-7711-5756-a3e1-b69c4a8b8bcc"] :db/ensure [:answer-field/validate]} {:db/id "answer-aae80146-7711-5756-a3e1-b69c4a8b8bcc" :answer/id #uuid "aae80146-7711-5756-a3e1-b69c4a8b8bcc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-9485be5f-7e9e-52c2-8dc7-d3a495a119a9" :question/id #uuid "9485be5f-7e9e-52c2-8dc7-d3a495a119a9" :question/math-academy-id "q-152313" :question/problem "Given that the line $y=4x+k$ does **not** intersect the parabola $y={x}^{2}+6x+7,$ what is the range of possible values of $k?$" :question/worked-solution "To determine whether the line $y=4x+k$ intersects the parabola $y={x}^{2}+6x+7,$ we need to solve the following system of equations for the two curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+6x+7 \\\\ y=4x+k\\end{aligned}\n$$\n\nSetting the equations equal to one another and writing in standard form, we get\n\n$$\n\\begin{aligned}{x}^{2}+6x+7 & =4x+k \\\\ {x}^{2}+2x+7-k & =0.\\end{aligned}\n$$\n\nNow, we solve this equation using the quadratic formula with $a=1,\\,b=2,$ and $c=7-k:$\n\n$$\n\\begin{aligned}x & =\\frac{-2\\pm \\sqrt{{2}^{2}-4(1)(7-k)}}{2(1)} \\\\  & =\\frac{-2\\pm \\sqrt{4-28+4k}}{2} \\\\  & =\\frac{-2\\pm \\sqrt{-24+4k}}{2}\\end{aligned}\n$$\n\nSince the line and parabola do not intersect, our quadratic equation must have no real solutions; hence, the expression inside the square root must be negative.\nSetting up and solving this inequality, we get\n\n$$\n\\begin{aligned}-24+4k & <0 \\\\ 4k & <24 \\\\ k & <6.\\end{aligned}\n$$\n\nTherefore, the range of possible values of $k$ is $k<6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2bbfb83c-6d7a-5008-8767-3335022b3066"] :db/ensure [:question/validate]} {:db/id "answer-field-2bbfb83c-6d7a-5008-8767-3335022b3066" :answer-field/id #uuid "2bbfb83c-6d7a-5008-8767-3335022b3066" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f22556c-3b2e-524d-85bb-92b3a3ca508b" :answer-field/choices ["answer-841b4151-23c6-5e4c-bcd4-1737cd56ac6b" "answer-7f22556c-3b2e-524d-85bb-92b3a3ca508b" "answer-b208aace-0a45-5228-9c09-221962d12ff2" "answer-e4b32aba-933a-56f5-8b1d-d0dea1394bd2" "answer-6884fc73-9e1c-5600-b1f9-aaba1f71b390"] :db/ensure [:answer-field/validate]} {:db/id "answer-841b4151-23c6-5e4c-bcd4-1737cd56ac6b" :answer/id #uuid "841b4151-23c6-5e4c-bcd4-1737cd56ac6b" :answer/type :answer.type/math :answer/value "k<4" :db/ensure [:answer/validate]} {:db/id "answer-7f22556c-3b2e-524d-85bb-92b3a3ca508b" :answer/id #uuid "7f22556c-3b2e-524d-85bb-92b3a3ca508b" :answer/type :answer.type/math :answer/value "k<6" :db/ensure [:answer/validate]} {:db/id "answer-b208aace-0a45-5228-9c09-221962d12ff2" :answer/id #uuid "b208aace-0a45-5228-9c09-221962d12ff2" :answer/type :answer.type/math :answer/value "k>-4" :db/ensure [:answer/validate]} {:db/id "answer-e4b32aba-933a-56f5-8b1d-d0dea1394bd2" :answer/id #uuid "e4b32aba-933a-56f5-8b1d-d0dea1394bd2" :answer/type :answer.type/math :answer/value "k>24" :db/ensure [:answer/validate]} {:db/id "answer-6884fc73-9e1c-5600-b1f9-aaba1f71b390" :answer/id #uuid "6884fc73-9e1c-5600-b1f9-aaba1f71b390" :answer/type :answer.type/math :answer/value "k>6" :db/ensure [:answer/validate]} {:db/id 17592186218320 :tutorial/content "Consider the line $y = x + 2$ and the parabola $y = x^2 + x + 1,$ shown in the graph below.\n\n![](images/9d/9d7ca10163c9b5096f90e19bdb50d98881bd55e92cbaea4aa5af6696e728f9f3.png)\n\nWe can see from the diagram that there are two points of intersection. So let's calculate the coordinates of these intersection points.\n\nAn intersection point is a common solution of the equations $y = x + 2$ and $y = x^2 + x + 1.$ In other words, to get the coordinates of the intersection points, we have to solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+x+1 \\\\ y=x+2\\end{aligned}\n$$\n\nSetting the equations equal to one another and then solving for $x$ using our knowledge of quadratic equations, we get\n![](images/96/9618f0221da97c281424def31e5d2a8fb96422b800928ad4ec4a01ed4dbad3d7.svg)\n\nSo, the $x$-coordinates of the intersection points are $x=-1$ and $x=1.$ \n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the line since it's simpler.\n\n- Substituting $x=−1,$ we get\n\n$$\n\\begin{aligned}y & =x+2 \\\\  & =(-1)+2 \\\\  & =1,\\end{aligned}\n$$\n\nso one point of intersection is $(-1,1).$\n\n- Substituting $x=1,$ we get\n\n$$\n\\begin{aligned}y & =x+2 \\\\  & =(1)+2 \\\\  & =3,\\end{aligned}\n$$\n\nso the other point of intersection is $(1,3).$\n\nTherefore, we conclude that the points of intersection are $\\left(-1,\\,1 \\right)$ and $\\left(1,\\,3 \\right).$" :db/ensure [:tutorial/validate]} {:db/id 17592186218321 :tutorial/content "![](images/b9/b9cb25bbb7b3076a3dae8688a232d18ec4092d68d9e815dedb438bc6900d97bb.png)\n\nA line and a parabola may have **two**, \n**one**, or **no** points of intersection.\n\nThis is similar to how a quadratic equation may have  **two**, \n**one**, or **no** solutions.\n\nWith that in mind, let's look at another example." :db/ensure [:tutorial/validate]} {:db/id 17592186217314 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} [:db/retract 17592186203364 :answer-field/choices 17592186203365] [:db/retract 17592186203364 :answer-field/choices 17592186203366] [:db/retract 17592186203364 :answer-field/choices 17592186203367] [:db/retract 17592186203358 :answer-field/choices 17592186203360] [:db/retract 17592186203467 :answer-field/choices 17592186203472] [:db/retract 17592186203467 :answer-field/choices 17592186203468] [:db/retract 17592186203467 :answer-field/choices 17592186203469] [:db/retract 17592186203467 :answer-field/choices 17592186203470] [:db/retract 17592186203467 :answer-field/choices 17592186203471] {:db/id 17592186204102 :knowledge-point/questions ["question-02680e0f-01a2-5039-ae5b-662f20597c66" "question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" "question-0446f1ce-7aff-5c2b-b94d-259fd188ab51" "question-bfb0421c-aa0c-535f-b51f-dc865b4acd28"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186203856 :question/problem "Compute the gradient of the function $f: \\mathbb{R}^4 \\rightarrow \\mathbb{R}$ defined by ![](images/47/471a898dd8e3dca3d9e0b077a135ac794ef58293dafa33703d23490dd92d12b6.svg) with respect to $\\mathbf{x}$ at ![](images/55/552dda7785a5e118e9ff3afa9bf7e7201e7d3be7454e7e380c42946d60506f31.svg)" :question/worked-solution "Writing ![](images/e0/e0ec0bd3b3ed1126735e229d153c206900bdff443354b04700379343ab15e876.svg), we have\n\n$$\nf(\\mathbf{x})= \\mathbf{b}^T\\mathbf{x}.\n$$\n\nThe gradient of a function $f(x) = \\mathbf{b}^T\\mathbf{x}$ with respect to $\\mathbf{x} \\in \\mathbb{R}^n$ is\n\n$$\n\\nabla_{\\mathbf{x}} f(\\mathbf{x}) = \\mathbf{b}.\n$$\n\nTherefore, we get\n![](images/4f/4f11665969b8a11e45fe97ef4f3add0115b365642e92e21172e2245e61147f31.svg)" :db/ensure [:question/validate]} {:db/id 17592186204103 :knowledge-point/questions ["question-1c52a19c-5a59-5b47-837b-41939417ff1a" "question-cdabeb8f-7345-59ca-9731-4ee1c58120d8" "question-ec192a53-8b67-53c4-a3ab-2010430980bc" "question-ffb6af35-3127-5869-9aa2-2d05c6e6ebee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186203864 :question/problem "Given the function \n\n$$\nf(\\mathbf{x}, \\mathbf{w}) = -7\\mathbf{w}^T\\mathbf{x} + 3\\|\\mathbf{w}\\|^2 - 2\n$$\n\nthat maps two vectors to a scalar, find $\\nabla_{\\mathbf w} f .$" :question/worked-solution "Using the results \n\n$$\n\\nabla_{\\mathbf w}(\\mathbf{w}^T\\mathbf{x}) = \\mathbf{x}, \\qquad \\nabla_{\\mathbf w} (\\mathbf{w}^T\\mathbf{w}) = 2\\mathbf{w},\n$$\n\n \nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-7{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-7\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})-{∇}_{w}(2) \\\\  & =-7\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)-{∇}_{w}(2) \\\\  & =-7\\cdot x+3\\cdot 2w-0 \\\\  & =-7x+6w.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186204104 :knowledge-point/questions ["question-f23dae50-683b-52ff-a0e9-aa781506dfbd" "question-451c95de-b4df-5e7d-8a76-df474224e7d9" "question-f3cf1839-85e6-5f28-8e77-8fe8ed36b0c8" "question-cda56dfe-5f02-56af-8d87-05b17e6af869"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186203874 :question/problem "Given the function \n\n$$\nf(\\mathbf{x}, \\mathbf{w}) = -3\\left(\\|\\mathbf{w}\\|_1\\right)^3  - 5\\mathbf x^T\\mathbf w\n$$\n\nthat maps a vector to a scalar, find $\\nabla_{\\mathbf w}f.$ You may assume that $\\mathbf w$ has no zero components." :question/worked-solution "Using the results\n\n$$\n\\nabla_{\\mathbf w} (\\|\\mathbf{w}\\|_1) = \\text{sign}(\\mathbf{w}), \\qquad \\nabla_{\\mathbf w}\\left(\\mathbf x^T\\mathbf w\\right) = \\mathbf x,\n$$\n\n we have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3{(‖w{‖}_{1})}^{3}-5{x}^{T}w) \\\\  & ={∇}_{w}(-3{(‖w{‖}_{1})}^{3})-{∇}_{w}(5{x}^{T}w) \\\\  & =-3\\cdot {∇}_{w}({(‖w{‖}_{1})}^{3})-5\\cdot {∇}_{w}({x}^{T}w) \\\\  & =-3\\cdot 3(‖w{‖}_{1})^{2}\\cdot {∇}_{w}(‖w{‖}_{1})-5\\cdot x \\\\  & =-3\\cdot 3(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-5\\cdot x \\\\  & =-9(‖w{‖}_{1})^{2}\\cdot \\text{sign}(w)-5x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-02680e0f-01a2-5039-ae5b-662f20597c66" :question/id #uuid "02680e0f-01a2-5039-ae5b-662f20597c66" :question/math-academy-id "q-265756" :question/problem "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}-1 & 0 & 1 & -1\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}2 \\\\ 3 \\\\ -1 \\\\ 0\\end{aligned}].$" :question/worked-solution "Writing $b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423"] :db/ensure [:question/validate]} {:db/id "answer-field-c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/id #uuid "c3c062f6-4f73-5b8e-a6b1-c784680f1423" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd675729-57e9-5d57-88d8-c335295910eb" :answer-field/choices ["answer-b68286b5-2fee-590c-b122-56aab19b9484" "answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07" "answer-cd675729-57e9-5d57-88d8-c335295910eb" "answer-5fa819ef-a851-5a01-9e84-7de7cf518f92" "answer-6cc262f1-2338-53de-80e9-d98a45c66d7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b68286b5-2fee-590c-b122-56aab19b9484" :answer/id #uuid "b68286b5-2fee-590c-b122-56aab19b9484" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/id #uuid "4a56765c-1fb2-5ac9-b03c-6b91b632cf07" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-cd675729-57e9-5d57-88d8-c335295910eb" :answer/id #uuid "cd675729-57e9-5d57-88d8-c335295910eb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/id #uuid "5fa819ef-a851-5a01-9e84-7de7cf518f92" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6cc262f1-2338-53de-80e9-d98a45c66d7e" :answer/id #uuid "6cc262f1-2338-53de-80e9-d98a45c66d7e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 3 \\\\ -1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/id #uuid "7bcd4936-683c-5a30-8d4e-a52d39fd01ec" :question/math-academy-id "q-265759" :question/problem "Compute the gradient of the function $f:{R}^{4}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & -2 & 3 & -4\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}].$" :question/worked-solution "Writing $b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4d0e16d2-5532-54aa-a176-c00276ff2a6b"] :db/ensure [:question/validate]} {:db/id "answer-field-4d0e16d2-5532-54aa-a176-c00276ff2a6b" :answer-field/id #uuid "4d0e16d2-5532-54aa-a176-c00276ff2a6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97f4111d-e21a-5f23-9e08-7a5877626445" :answer-field/choices ["answer-98a357d1-417a-56f0-84a8-27daff050492" "answer-97f4111d-e21a-5f23-9e08-7a5877626445" "answer-46f10615-3ea2-591f-aa16-650d0b75709e" "answer-6d49369b-d4d7-5a12-8c86-bfb38d359aaa" "answer-16d4a8a5-5903-55b3-93a1-5e3414473465"] :db/ensure [:answer-field/validate]} {:db/id "answer-98a357d1-417a-56f0-84a8-27daff050492" :answer/id #uuid "98a357d1-417a-56f0-84a8-27daff050492" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-97f4111d-e21a-5f23-9e08-7a5877626445" :answer/id #uuid "97f4111d-e21a-5f23-9e08-7a5877626445" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-46f10615-3ea2-591f-aa16-650d0b75709e" :answer/id #uuid "46f10615-3ea2-591f-aa16-650d0b75709e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6d49369b-d4d7-5a12-8c86-bfb38d359aaa" :answer/id #uuid "6d49369b-d4d7-5a12-8c86-bfb38d359aaa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-16d4a8a5-5903-55b3-93a1-5e3414473465" :answer/id #uuid "16d4a8a5-5903-55b3-93a1-5e3414473465" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 3 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-0446f1ce-7aff-5c2b-b94d-259fd188ab51" :question/id #uuid "0446f1ce-7aff-5c2b-b94d-259fd188ab51" :question/math-academy-id "q-264920" :question/problem "Given the function \n\n$$\nf(x,w)={w}^{T}x+4\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}x)=x,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}({w}^{T}x+4) \\\\  & ={∇}_{w}({w}^{T}x)+{∇}_{w}(4) \\\\  & =x+0 \\\\  & =x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d5c58c75-9e77-56fd-b251-39036e32bd87"] :db/ensure [:question/validate]} {:db/id "answer-field-d5c58c75-9e77-56fd-b251-39036e32bd87" :answer-field/id #uuid "d5c58c75-9e77-56fd-b251-39036e32bd87" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e45f0f82-ca1e-522b-beb2-25f53e90f4da" :answer-field/choices ["answer-65b1e62d-8397-5718-92b4-3cc4c0404c04" "answer-6a8027b8-6be4-57a7-a65f-2e31748d8ad1" "answer-e45f0f82-ca1e-522b-beb2-25f53e90f4da" "answer-58920a3a-358f-5d1e-8e4c-a50997ac4a92" "answer-e89b9918-d9b6-5ede-a900-7264152a3a30"] :db/ensure [:answer-field/validate]} {:db/id "answer-65b1e62d-8397-5718-92b4-3cc4c0404c04" :answer/id #uuid "65b1e62d-8397-5718-92b4-3cc4c0404c04" :answer/type :answer.type/math :answer/value "w" :db/ensure [:answer/validate]} {:db/id "answer-6a8027b8-6be4-57a7-a65f-2e31748d8ad1" :answer/id #uuid "6a8027b8-6be4-57a7-a65f-2e31748d8ad1" :answer/type :answer.type/math :answer/value "w+4" :db/ensure [:answer/validate]} {:db/id "answer-e45f0f82-ca1e-522b-beb2-25f53e90f4da" :answer/id #uuid "e45f0f82-ca1e-522b-beb2-25f53e90f4da" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "answer-58920a3a-358f-5d1e-8e4c-a50997ac4a92" :answer/id #uuid "58920a3a-358f-5d1e-8e4c-a50997ac4a92" :answer/type :answer.type/math :answer/value "x+4" :db/ensure [:answer/validate]} {:db/id "answer-e89b9918-d9b6-5ede-a900-7264152a3a30" :answer/id #uuid "e89b9918-d9b6-5ede-a900-7264152a3a30" :answer/type :answer.type/math :answer/value "‖x‖" :db/ensure [:answer/validate]} {:db/id 17592186204571 :question/problem "Compute the gradient of the function $f:{R}^{3}\\to R$ defined by \n\n$$\nf(x)=[\\begin{aligned}1 & 2 & 0\\end{aligned}]\\cdot x\n$$\n\n with respect to $x$ at $x=[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}].$" :question/worked-solution "Writing $b=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]$, we have\n\n$$\nf(x)={b}^{T}x.\n$$\n\nThe gradient of a function $f(x)={b}^{T}x$ with respect to $x\\in {R}^{n}$ is\n\n$$\n{∇}_{x}f(x)=b.\n$$\n\nTherefore, we get\n\n$$\n{∇}_{x}f(x)=b=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203364 :answer-field/correct "answer-38caa28c-728f-5eb5-9e10-21bbf0c1aa3d" :answer-field/choices ["answer-71c41df8-afa0-5e4a-abb0-9a56b9c39300" "answer-c5a28dfc-770a-54c1-8dbb-3b736ea154ac" "answer-38caa28c-728f-5eb5-9e10-21bbf0c1aa3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-71c41df8-afa0-5e4a-abb0-9a56b9c39300" :answer/id #uuid "71c41df8-afa0-5e4a-abb0-9a56b9c39300" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c5a28dfc-770a-54c1-8dbb-3b736ea154ac" :answer/id #uuid "c5a28dfc-770a-54c1-8dbb-3b736ea154ac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-38caa28c-728f-5eb5-9e10-21bbf0c1aa3d" :answer/id #uuid "38caa28c-728f-5eb5-9e10-21bbf0c1aa3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-bfb0421c-aa0c-535f-b51f-dc865b4acd28" :question/id #uuid "bfb0421c-aa0c-535f-b51f-dc865b4acd28" :question/math-academy-id "q-265741" :question/problem "Given the function \n\n$$\nf(x,w)=3{w}^{T}x-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}x)=x,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(3{w}^{T}x-2) \\\\  & =3\\cdot {∇}_{w}({w}^{T}x)-{∇}_{w}(2) \\\\  & =3\\cdot x+0 \\\\  & =3x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5c7f99c8-5b87-5868-bac9-130222bcf4cb"] :db/ensure [:question/validate]} {:db/id "answer-field-5c7f99c8-5b87-5868-bac9-130222bcf4cb" :answer-field/id #uuid "5c7f99c8-5b87-5868-bac9-130222bcf4cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33f579a6-f33f-5692-be37-c2a248a144e0" :answer-field/choices ["answer-93bed4b9-cea3-5925-a181-95a2520a01f0" "answer-22f87356-a267-54a0-ba16-c1efa75b59cb" "answer-33f579a6-f33f-5692-be37-c2a248a144e0" "answer-56e79ae4-c42d-5590-b5a0-1173d6e6e501" "answer-6ae18405-cefd-5d16-a534-187dec9d1497"] :db/ensure [:answer-field/validate]} {:db/id "answer-93bed4b9-cea3-5925-a181-95a2520a01f0" :answer/id #uuid "93bed4b9-cea3-5925-a181-95a2520a01f0" :answer/type :answer.type/math :answer/value "3w" :db/ensure [:answer/validate]} {:db/id "answer-22f87356-a267-54a0-ba16-c1efa75b59cb" :answer/id #uuid "22f87356-a267-54a0-ba16-c1efa75b59cb" :answer/type :answer.type/math :answer/value "3wx" :db/ensure [:answer/validate]} {:db/id "answer-33f579a6-f33f-5692-be37-c2a248a144e0" :answer/id #uuid "33f579a6-f33f-5692-be37-c2a248a144e0" :answer/type :answer.type/math :answer/value "3x" :db/ensure [:answer/validate]} {:db/id "answer-56e79ae4-c42d-5590-b5a0-1173d6e6e501" :answer/id #uuid "56e79ae4-c42d-5590-b5a0-1173d6e6e501" :answer/type :answer.type/math :answer/value "3x-2" :db/ensure [:answer/validate]} {:db/id "answer-6ae18405-cefd-5d16-a534-187dec9d1497" :answer/id #uuid "6ae18405-cefd-5d16-a534-187dec9d1497" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-1c52a19c-5a59-5b47-837b-41939417ff1a" :question/id #uuid "1c52a19c-5a59-5b47-837b-41939417ff1a" :question/math-academy-id "q-265745" :question/problem "Given the function \n\n$$\nf(x,w)=-10{w}^{T}x+3‖w{‖}^{2}-2\n$$\n\nthat maps two vectors to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the results \n\n$$\n{∇}_{w}({w}^{T}x)=x,\\,{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-10{w}^{T}x+3‖w{‖}^{2}-2) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}(‖w{‖}^{2})+{∇}_{w}(4) \\\\  & =-10\\cdot {∇}_{w}({w}^{T}x)+3\\cdot {∇}_{w}({w}^{T}w)+{∇}_{w}(4) \\\\  & =-10\\cdot x+3\\cdot 2w+0 \\\\  & =-10x+6w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-99449935-4cad-5a41-81a3-06a840cfe3db"] :db/ensure [:question/validate]} {:db/id "answer-field-99449935-4cad-5a41-81a3-06a840cfe3db" :answer-field/id #uuid "99449935-4cad-5a41-81a3-06a840cfe3db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47cee7c0-cbb6-5288-b280-1789ccc53d51" :answer-field/choices ["answer-11c584fd-625d-5a75-9b3f-f0f55a1a7eb9" "answer-31772745-7785-52c8-ba0e-2fa677b1f190" "answer-47cee7c0-cbb6-5288-b280-1789ccc53d51" "answer-5a133d62-0da5-55b0-b9e0-33c416fc66a0" "answer-751c670a-5038-517e-aea3-2ec5a4b70826"] :db/ensure [:answer-field/validate]} {:db/id "answer-11c584fd-625d-5a75-9b3f-f0f55a1a7eb9" :answer/id #uuid "11c584fd-625d-5a75-9b3f-f0f55a1a7eb9" :answer/type :answer.type/math :answer/value "-10w+6‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-31772745-7785-52c8-ba0e-2fa677b1f190" :answer/id #uuid "31772745-7785-52c8-ba0e-2fa677b1f190" :answer/type :answer.type/math :answer/value "-10x+3w" :db/ensure [:answer/validate]} {:db/id "answer-47cee7c0-cbb6-5288-b280-1789ccc53d51" :answer/id #uuid "47cee7c0-cbb6-5288-b280-1789ccc53d51" :answer/type :answer.type/math :answer/value "-10x+6w" :db/ensure [:answer/validate]} {:db/id "answer-5a133d62-0da5-55b0-b9e0-33c416fc66a0" :answer/id #uuid "5a133d62-0da5-55b0-b9e0-33c416fc66a0" :answer/type :answer.type/math :answer/value "-10x+6w-2