p-4c5492c8-87b7-5ec2-85d4-d931b3796a40" :step/id #uuid "4c5492c8-87b7-5ec2-85d4-d931b3796a40" :step/content "question-faa87228-4c67-51da-9af8-97fb8de0d515" :step/next "step-00ed98fb-e0bf-57db-9750-8314959c80f1" :db/ensure [:step/validate]} {:db/id "step-00ed98fb-e0bf-57db-9750-8314959c80f1" :step/id #uuid "00ed98fb-e0bf-57db-9750-8314959c80f1" :step/content 17592186284633 :step/next "step-da7c3597-d493-5043-8d99-feea500d55ed" :db/ensure [:step/validate]} {:db/id "step-da7c3597-d493-5043-8d99-feea500d55ed" :step/id #uuid "da7c3597-d493-5043-8d99-feea500d55ed" :step/content "question-3c5b79b6-c034-52ce-8e7b-d57a11d334d9" :db/ensure [:step/validate]} {:db/id 17592186068873 :knowledge-point/questions ["question-ba6abf23-a5c2-510c-be10-8fd79a136d85" "question-68e816d0-08a0-579d-bfa8-21cac7d54b69"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068672 :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+14x+49 & = \\\\ {x}^{2}+14x+{7}^{2} & = \\\\ {x}^{2}+2\\cdot 7x+{7}^{2} & = \\\\ (x+7)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+14x+49)-8 & = \\\\ (x+7)^{2}-8 & .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068874 :knowledge-point/questions ["question-51d99f03-ded8-52c4-99a8-b04fbc348a7b" "question-924bb0ed-916c-53af-b20c-31d4530221fb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068677 :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 - {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x - {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-12x+36 & = \\\\ {x}^{2}-12x+{6}^{2} & = \\\\ {x}^{2}-2\\cdot 6x+{6}^{2} & = \\\\ (x-6)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-12x+36)-5 & = \\\\ (x-6)^{2}-5 & .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068875 :knowledge-point/questions ["question-b855896c-0e74-5e62-9ab7-478fd01cda70"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068876 :knowledge-point/questions ["question-7bec21b0-2997-5975-9f9b-3c9e1dd0a0f7" "question-93dc778c-0905-5be0-ac96-c8581ce3887e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ba6abf23-a5c2-510c-be10-8fd79a136d85" :question/id #uuid "ba6abf23-a5c2-510c-be10-8fd79a136d85" :question/math-academy-id "q-250394" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}+18x+81)+5=(${{field-1}}$)^{2}\\,+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+18x+81 & = \\\\ {x}^{2}+2\\cdot 9x+{9}^{2} & = \\\\ (x+9)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+18x+81)+5 & = \\\\ (x+9)^{2}+5 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6b269a0c-0c11-5a2c-b30d-ef3067f26c41" "answer-field-31ec9ab8-de52-53b3-909d-0327c74ae195"] :db/ensure [:question/validate]} {:db/id "answer-field-6b269a0c-0c11-5a2c-b30d-ef3067f26c41" :answer-field/id #uuid "6b269a0c-0c11-5a2c-b30d-ef3067f26c41" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f" :answer-field/choices ["answer-47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f"] :db/ensure [:answer-field/validate]} {:db/id "answer-47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f" :answer/id #uuid "47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f" :answer/type :answer.type/math :answer/value "x+9" :db/ensure [:answer/validate]} {:db/id "answer-field-31e