field/id #uuid "11ab1b23-6e87-5f18-bf90-319aa4e40494" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53cdd14f-96d5-58b5-8397-9f6903783339" :answer-field/choices ["answer-4b5b79ee-698b-5f26-8367-9f89b495e958" "answer-53cdd14f-96d5-58b5-8397-9f6903783339" "answer-9d3a60c2-5b06-56d5-a3cc-c730cf971d66" "answer-e6babe52-b3d1-5761-b735-56416c05cc53" "answer-0c4a8afe-8653-50fc-a6c2-079485b7e081"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b5b79ee-698b-5f26-8367-9f89b495e958" :answer/id #uuid "4b5b79ee-698b-5f26-8367-9f89b495e958" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-53cdd14f-96d5-58b5-8397-9f6903783339" :answer/id #uuid "53cdd14f-96d5-58b5-8397-9f6903783339" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-9d3a60c2-5b06-56d5-a3cc-c730cf971d66" :answer/id #uuid "9d3a60c2-5b06-56d5-a3cc-c730cf971d66" :answer/type :answer.type/math :answer/value "x=7" :db/ensure [:answer/validate]} {:db/id "answer-e6babe52-b3d1-5761-b735-56416c05cc53" :answer/id #uuid "e6babe52-b3d1-5761-b735-56416c05cc53" :answer/type :answer.type/math :answer/value "x=\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-0c4a8afe-8653-50fc-a6c2-079485b7e081" :answer/id #uuid "0c4a8afe-8653-50fc-a6c2-079485b7e081" :answer/type :answer.type/text :answer/value "The equation has no real solution" :db/ensure [:answer/validate]} {:db/id 17592186233214 :question/problem "Which of the following equations have no real solution?\n\nI. $\\sqrt{7-2x}=-2$\n\nII. $\\sqrt{x-3}=-7$\n\nIII. $\\sqrt{6x-2}=5$" :question/answer-fields ["answer-field-f90f12a0-ed27-5b63-9d08-dbfcadce5512"] :db/ensure [:question/validate]} {:db/id "answer-field-f90f12a0-ed27-5b63-9d08-dbfcadce5512" :answer-field/id #uuid "f90f12a0-ed27-5b63-9d08-dbfcadce5512" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd6ac876-47f6-5460-97e7-ff997a6d48df" :answer-field/choices ["answer-fd6ac876-47f6-5460-97e7-ff997a6d48df" "answer-2f55c074-5c1b-568c-a7ea-28e935a77130" "answer-c6e35b7c-8732-531f-9d1d-833f24e8eca1" "answer-7e2af395-ee42-5de0-838f-0e24f21ad488" "answer-39f74041-ca9c-5dc0-ae3b-06c900366b22"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd6ac876-47f6-5460-97e7-ff997a6d48df" :answer/id #uuid "fd6ac876-47f6-5460-97e7-ff997a6d48df" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-2f55c074-5c1b-568c-a7ea-28e935a77130" :answer/id #uuid "2f55c074-5c1b-568c-a7ea-28e935a77130" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-c6e35b7c-8732-531f-9d1d-833f24e8eca1" :answer/id #uuid "c6e35b7c-8732-531f-9d1d-833f24e8eca1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7e2af395-ee42-5de0-838f-0e24f21ad488" :answer/id #uuid "7e2af395-ee42-5de0-838f-0e24f21ad488" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-39f74041-ca9c-5dc0-ae3b-06c900366b22" :answer/id #uuid "39f74041-ca9c-5dc0-ae3b-06c900366b22" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186055253 :question/problem "Solve $\\sqrt{1-7x}=-3.$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nTherefore, the given equation has no real solution." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186052755 :answer-field/correct 17592186052759 :answer-field/choices ["answer-2a2a6f70-7ba2-51f5-8315-7c292c85e4eb" "answer-21df286c-eaee-5596-9ba1-d3247025a1cb" "answer-f88399db-f363-5198-a216-2e06441b4d8e" "answer-732cb569-f017-5ff2-b071-6b7823f7731f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a2a6f70-7ba2-51f5-8315-7c292c85e4eb" :answer/id #uuid "2a2a6f70-7ba2-51f5-8315-7c292c85e4eb" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "answer-21df286c-eaee-5596-9ba1-d3247025a1cb" :answer/id #uuid "21df286c-eaee-5596-9ba1-d3247025a1cb" :answer/type :answer.type/math :answer/value "x=-\\frac{15}{7}" :db/ensure [:answer/validate]} {:db/id "answer-f88399db-f363-5198-a216-2e06441b4d8e" :answer/id #uuid "f88399db-f363-5198-a216-2e06441b4d8e" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-732cb569-f017-5ff2-b071-6b7823f7731f" :answer/id #uuid "732cb569-f017-5ff2-b071-6b7823f7731f" :answer/type :answer.type/math :answer/value "x=-\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id 17592186055470 :question/problem "Solve $\\sqrt{{x}^{2}-x+3}-3=0.$" :question/worked-solution "First, we isolate the square root by adding $3$ to both sides:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-x+3}-3 & =0 \\\\ \\sqrt{{x}^{2}-x+3} & =3\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-x+3} & =3 \\\\ {(\\sqrt{{x}^{2}-x+3})}^{2} & ={3}^{2} \\\\ {x}^{2}-x+3 & =9 \\\\ {x}^{2}-x-6 & =0 \\\\ (x+2)(x-3) & =0 \\\\ x & =-2,\\,3.\\end{aligned}\n$$\n\nLet's check the results by plugging them into the original equation.\n\n- For $x=-2,$ we get\n\n$$\n\\begin{aligned}\\sqrt{(-2)^{2}-(-2)+3}-3 & \\overset{?}{=}0 \\\\ \\sqrt{4+2+3}-3 & \\overset{?}{=}0 \\\\ \\sqrt{9}-3 & \\overset{?}{=}0 \\\\ 3-3 & \\overset{?}{=}0 \\\\ 0 & =0.\\,\\,✓\\end{aligned}\n$$\n\n- For $x=3,$ we get\n\n$$\n\\begin{aligned}\\sqrt{{3}^{2}-3+3}-3 & \\overset{?}{=}0 \\\\ \\sqrt{9-3+3}-3 & \\overset{?}{=}0 \\\\ \\sqrt{9}-3 & \\overset{?}{=}0 \\\\ 3-3 & \\overset{?}{=}0 \\\\ 0 & =0.\\,\\,✓\\end{aligned}\n$$\n\nBoth $x=-2$ and $x=3$ satisfy the original equation, so we can accept them both as solutions.\n\nTherefore, the solutions to $\\sqrt{{x}^{2}-x+3}-3=0$ are $x=-2$ and $x=3.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186054057 :answer-field/correct "answer-ea6bbfc2-4600-5b1d-a17c-9006b8303d72" :answer-field/choices ["answer-ea6bbfc2-4600-5b1d-a17c-9006b8303d72" "answer-07803253-951f-58de-951c-3a4c24cb8662" "answer-699690f3-59a4-585a-b6de-f37f5b8099bf" "answer-136fd48c-2cb3-5fa9-9b7b-625e2dc24ae4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea6bbfc2-4600-5b1d-a17c-9006b8303d72" :answer/id #uuid "ea6bbfc2-4600-5b1d-a17c-9006b8303d72" :answer/type :answer.type/math :answer/value "x=-2,\\,3" :db/ensure [:answer/validate]} {:db/id "answer-07803253-951f-58de-951c-3a4c24cb8662" :answer/id #uuid "07803253-951f-58de-951c-3a4c24cb8662" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-699690f3-59a4-585a-b6de-f37f5b8099bf" :answer/id #uuid "699690f3-59a4-585a-b6de-f37f5b8099bf" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-136fd48c-2cb3-5fa9-9b7b-625e2dc24ae4" :answer/id #uuid "136fd48c-2cb3-5fa9-9b7b-625e2dc24ae4" :answer/type :answer.type/math :answer/value "x=2,\\,3" :db/ensure [:answer/validate]} {:db/id 17592186234022 :question/answer-fields ["answer-field-f98d1a0e-e08a-51f4-8f73-306cde22d069"] :db/ensure [:question/validate]} {:db/id "answer-field-f98d1a0e-e08a-51f4-8f73-306cde22d069" :answer-field/id #uuid "f98d1a0e-e08a-51f4-8f73-306cde22d069" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a06c23de-53b7-5f6e-a082-ea88dc045b3d" :answer-field/choices ["answer-a06c23de-53b7-5f6e-a082-ea88dc045b3d" "answer-2ea44428-82fd-5d84-8e60-4fa4d6580387" "answer-4db5a159-03f8-5808-8203-a4b6895bbc3f" "answer-2630618c-0efc-5db4-8afb-2f86f8998beb" "answer-d6676e87-a4bb-50ce-84b9-6f657fa4982d"] :db/ensure [:answer-field/validate]} {:db/id "answer-a06c23de-53b7-5f6e-a082-ea88dc045b3d" :answer/id #uuid "a06c23de-53b7-5f6e-a082-ea88dc045b3d" :answer/type :answer.type/math :answer/value "x=142" :db/ensure [:answer/validate]} {:db/id "answer-2ea44428-82fd-5d84-8e60-4fa4d6580387" :answer/id #uuid "2ea44428-82fd-5d84-8e60-4fa4d6580387" :answer/type :answer.type/math :answer/value "x=23" :db/ensure [:answer/validate]} {:db/id "answer-4db5a159-03f8-5808-8203-a4b6895bbc3f" :answer/id #uuid "4db5a159-03f8-5808-8203-a4b6895bbc3f" :answer/type :answer.type/math :answer/value "x=47" :db/ensure [:answer/validate]} {:db/id "answer-2630618c-0efc-5db4-8afb-2f86f8998beb" :answer/id #uuid "2630618c-0efc-5db4-8afb-2f86f8998beb" :answer/type :answer.type/math :answer/value "x=98" :db/ensure [:answer/validate]} {:db/id "answer-d6676e87-a4bb-50ce-84b9-6f657fa4982d" :answer/id #uuid "d6676e87-a4bb-50ce-84b9-6f657fa4982d" :answer/type :answer.type/text :answer/value "The equation has no real solution" :db/ensure [:answer/validate]} {:db/id "question-4cfcdd38-dccd-5180-beb8-71439df888fe" :question/id #uuid "4cfcdd38-dccd-5180-beb8-71439df888fe" :question/math-academy-id "q-39756" :question/problem "Solve $2-3\\sqrt{x}=-x.$" :question/worked-solution "To solve the equation $2-3\\sqrt{x}=-x,$ we raise both sides to the power of $2.$  This allows us to get rid of the radical, and gives us a quadratic equation that is easier to solve:\n\n$$\n\\begin{aligned}2-3\\sqrt{x} & =-x \\\\ -3\\sqrt{x} & =-x-2 \\\\ 3\\sqrt{x} & =x+2 \\\\ {(3\\sqrt{x})}^{2} & =(x+2)^{2} \\\\ 9x & ={x}^{2}+4x+4 \\\\ {x}^{2}-5x+4 & =0 \\\\ ({x}^{2}-x)+(-4x+4) & =0 \\\\ x(x-1)-4(x-1) & =0 \\\\ (x-4)(x-1) & =0 \\\\ x & =1,\\,4\\end{aligned}\n$$\n\nRemember that in square root equations, we should always check the obtained value(s) to ensure that they are actually solutions of the original equation.\n\n- First, we check whether the obtained value $x=1$ is a solution of the original equation:\n\n$$\n\\begin{aligned}2-3\\sqrt{1} & \\overset{?}{=}-1 \\\\ 2-3 & \\overset{?}{=}-1 \\\\ -1 & =-1\\,✓\\end{aligned}\n$$\n\nIndeed, the value $x=1$ does satisfy the original equation.\n\n- Second, we check whether the obtained value $x=4$ is a solution of the original equation:\n\n$$\n\\begin{aligned}2-3\\sqrt{4} & \\overset{?}{=}-4 \\\\ 2-6 & \\overset{?}{=}-4 \\\\ -4 & =-4\\,✓\\end{aligned}\n$$\n\nIndeed, the value $x=4$ does satisfy the original equation.\n\nTherefore, the only solution of $2-3\\sqrt{x}=-x$  are $x=1,\\,4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fbf90299-3d38-5a19-b9b4-8be38acea213"] :db/ensure [:question/validate]} {:db/id "answer-field-fbf90299-3d38-5a19-b9b4-8be38acea213" :answer-field/id #uuid "fbf90299-3d38-5a19-b9b4-8be38acea213" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-da845571-4594-594d-9eae-214c174f9f15" :answer-field/choices ["answer-4b4dd67f-9f7f-54c7-b37f-0fff84e54ded" "answer-da845571-4594-594d-9eae-214c174f9f15" "answer-8e61b4e8-7863-5d7c-bc6f-47883ba042b2" "answer-1fb86604-5a0d-5a3a-bf6d-b040bfda5b62" "answer-06f8d68d-f40d-5c24-a4ce-7305f5d2d6c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b4dd67f-9f7f-54c7-b37f-0fff84e54ded" :answer/id #uuid "4b4dd67f-9f7f-54c7-b37f-0fff84e54ded" :answer/type :answer.type/math :answer/value "x=1,\\,25" :db/ensure [:answer/validate]} {:db/id "answer-da845571-4594-594d-9eae-214c174f9f15" :answer/id #uuid "da845571-4594-594d-9eae-214c174f9f15" :answer/type :answer.type/math :answer/value "x=1,\\,4" :db/ensure [:answer/validate]} {:db/id "answer-8e61b4e8-7863-5d7c-bc6f-47883ba042b2" :answer/id #uuid "8e61b4e8-7863-5d7c-bc6f-47883ba042b2" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-1fb86604-5a0d-5a3a-bf6d-b040bfda5b62" :answer/id #uuid "1fb86604-5a0d-5a3a-bf6d-b040bfda5b62" :answer/type :answer.type/math :answer/value "x=4,\\,36" :db/ensure [:answer/validate]} {:db/id "answer-06f8d68d-f40d-5c24-a4ce-7305f5d2d6c0" :answer/id #uuid "06f8d68d-f40d-5c24-a4ce-7305f5d2d6c0" :answer/type :answer.type/text :answer/value "The equation has no solution" :db/ensure [:answer/validate]} {:db/id 17592186055250 :question/problem "Solve for $x$ if given that $\\sqrt{14-x}=x-2.$" :question/worked-solution "To solve the equation $\\sqrt{14-x}=x-2$ we raise both sides to the power of $2.$  This allows us to get rid of the radical, and gives us a quadratic equation that is easier to solve:\n\n$$\n\\begin{aligned}\\sqrt{14-x} & =x-2 \\\\ (\\sqrt{14-x})^{2} & =(x-2)^{2} \\\\ 14-x & ={x}^{2}-4x+4 \\\\ {x}^{2}-4x+4+x-14 & =0 \\\\ {x}^{2}-3x-10 & =0 \\\\ {x}^{2}-5x+2x-10 & =0 \\\\ x(x-5)+2(x-5) & =0 \\\\ (x-5)(x+2) & =0 \\\\ x & =5,-2\\end{aligned}\n$$\n\nRemember that in square root equations, we should always check the obtained value(s) to ensure that they are actually solutions of the original equation.\n\n- First, we check whether the obtained value $x=5$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{14-5} & \\overset{?}{=}5-2 \\\\ \\sqrt{9} & \\overset{?}{=}5-2 \\\\ 3 & \\overset{?}{=}5-2 \\\\ 3 & =3\\,✓\\end{aligned}\n$$\n\nIndeed, the value $x=5$ does satisfy the original equation.\n\n- Second, we check whether the obtained value $x=-2$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{14-(-2)} & \\overset{?}{=}-2-2 \\\\ \\sqrt{16} & \\overset{?}{=}-2-2 \\\\ 4 & \\ne -4\\,\\times \\end{aligned}\n$$\n\nThe value $x=-2$ does *not* satisfy the original equation, so we discard it.\n\nTherefore, the only solution of $\\sqrt{14-x}=x-2$  is $x=5.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186052737 :answer-field/correct "answer-52881457-4fd5-53db-a157-640a3789bbb4" :answer-field/choices ["answer-4d30bd5a-8805-5386-be83-277816027d57" "answer-73e46bfd-7668-5274-b080-fd60ce6d36c3" "answer-52881457-4fd5-53db-a157-640a3789bbb4" "answer-368da266-8452-530b-a457-5e1f941fd39f" "answer-85d3e197-b880-50b5-b5ba-28ae572ba36f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d30bd5a-8805-5386-be83-277816027d57" :answer/id #uuid "4d30bd5a-8805-5386-be83-277816027d57" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-73e46bfd-7668-5274-b080-fd60ce6d36c3" :answer/id #uuid "73e46bfd-7668-5274-b080-fd60ce6d36c3" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-52881457-4fd5-53db-a157-640a3789bbb4" :answer/id #uuid "52881457-4fd5-53db-a157-640a3789bbb4" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-368da266-8452-530b-a457-5e1f941fd39f" :answer/id #uuid "368da266-8452-530b-a457-5e1f941fd39f" :answer/type :answer.type/math :answer/value "x=8" :db/ensure [:answer/validate]} {:db/id "answer-85d3e197-b880-50b5-b5ba-28ae572ba36f" :answer/id #uuid "85d3e197-b880-50b5-b5ba-28ae572ba36f" :answer/type :answer.type/math :answer/value "x=9" :db/ensure [:answer/validate]} {:db/id 17592186055984 :tutorial/content "To solve a radical equation where the radical is isolated on one side of the equation, like\n\n$$\n\\sqrt{x+1} = 3,\n$$\n\nwe square both sides. Remember that squaring is the opposite of the square root, so $\\left(\\sqrt{x+1}\\right)^2 =x+1,$ and we have\n\n$$\n\\begin{aligned}{(\\sqrt{x+1})}^{2} & ={3}^{2} \\\\ x+1 & =9.\\end{aligned}\n$$\n\nNow, we can solve the equation in the standard way:\n\n$$\n\\begin{aligned}x+1 & =9 \\\\ x & =8\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{(8)+1} & \\overset{?}{=}3 \\\\ \\sqrt{9} & \\overset{?}{=}3 \\\\ 3 & =3\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=8$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{x+1}=3$ is $x=8.$" :db/ensure [:tutorial/validate]} {:db/id 17592186055985 :tutorial/content "Some radical equations have no solutions. For example, consider the radical equation\n\n$$\n\\sqrt{3-x} = -2.\n$$\n\nThe square root of a number is always positive or zero. So in the equation above, the right-hand side is negative, while the left-hand side is always positive or zero. Consequently the two sides will never be equal, and there is no real solution.\n\nWe could also determine that there is no solution by using the same process as usual. If we try to solve this equation by squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{3-x} & =-2 \\\\ {(\\sqrt{3-x})}^{2} & =(-2)^{2} \\\\ 3-x & =4 \\\\ x & =-1.\\end{aligned}\n$$\n\nHowever, when we plug this result into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}\\sqrt{3-(-1)} & \\overset{?}{=}-2 \\\\ \\sqrt{4} & \\overset{?}{=}-2 \\\\ 2 & \\ne -2\\,\\,\\times \\end{aligned}\n$$\n\nThe value $x=-1$ does *not* satisfy the original equation, so we *cannot* accept it as a solution.\n\nTherefore, the equation $\\sqrt{3-x}=-2$ has no real solution." :db/ensure [:tutorial/validate]} {:db/id 17592186055941 :tutorial/content "When we want to solve a square root radical equation which has the square root on the left-hand side and a linear function on the right-hand side, like\n\n$$\n\\sqrt{2x-1}=x,\n$$\n\nwe raise both sides to the power of $2.$ This allows us to get rid of the radical, and gives us a quadratic equation that is easier to solve:\n\n$$\n\\begin{aligned}{(\\sqrt{2x-1})}^{2} & ={(x)}^{2} \\\\ 2x-1 & ={x}^{2} \\\\ {x}^{2}-2x+1 & =0 \\\\ (x-1)^{2} & =0 \\\\ x & =1\\end{aligned}\n$$\n\nRemember that in square root equations, we should always check the obtained value(s) to ensure that they are actually solutions of the original equation.\n\nHere, we check that the obtained value $x=1$ is actually a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{2(1)-1} & \\overset{?}{=}(1) \\\\ \\sqrt{1} & \\overset{?}{=1} \\\\ 1 & =1\\,✓\\end{aligned}\n$$\n\nTherefore, the equation $\\sqrt{2x-1}=x$ has the solution $x=1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186054873 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} [:db/retract 17592186126440 :answer-field/choices 17592186126441] [:db/retract 17592186126440 :answer-field/choices 17592186126442] [:db/retract 17592186126440 :answer-field/choices 17592186126443] [:db/retract 17592186126440 :answer-field/choices 17592186126444] [:db/retract 17592186126440 :answer-field/choices 17592186126445] {:db/id 17592186129318 :knowledge-point/questions ["question-7d6c3d2a-2d0d-538a-8df1-4fa8a05510f8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7d6c3d2a-2d0d-538a-8df1-4fa8a05510f8" :question/id #uuid "7d6c3d2a-2d0d-538a-8df1-4fa8a05510f8" :question/math-academy-id "q-138965" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={t}^{2},\\,y=t+1,\\,t\\in [0,2].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+1)=1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}(t+1)\\sqrt{{(2t)}^{2}+{(1)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}(t+1)\\sqrt{4{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-18ee6b17-46b2-5260-a155-51e284324ae6"] :db/ensure [:question/validate]} {:db/id "answer-field-18ee6b17-46b2-5260-a155-51e284324ae6" :answer-field/id #uuid "18ee6b17-46b2-5260-a155-51e284324ae6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8aa4f95f-378d-5338-8b6f-85c27742f8b0" :answer-field/choices ["answer-8aa4f95f-378d-5338-8b6f-85c27742f8b0" "answer-8f9b8633-af16-5b49-b623-797c047243a7" "answer-463add96-423b-5d1f-a988-936fb0b73d81" "answer-397b7274-6f31-5ec6-8f5f-76084e482538" "answer-6cc93547-60e1-5394-aaaf-3f2640834b2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8aa4f95f-378d-5338-8b6f-85c27742f8b0" :answer/id #uuid "8aa4f95f-378d-5338-8b6f-85c27742f8b0" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}(t+1)\\sqrt{4{t}^{2}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-8f9b8633-af16-5b49-b623-797c047243a7" :answer/id #uuid "8f9b8633-af16-5b49-b623-797c047243a7" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}{t}^{2}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-463add96-423b-5d1f-a988-936fb0b73d81" :answer/id #uuid "463add96-423b-5d1f-a988-936fb0b73d81" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{2}2t(4t+1)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-397b7274-6f31-5ec6-8f5f-76084e482538" :answer/id #uuid "397b7274-6f31-5ec6-8f5f-76084e482538" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{0}^{2}2{t}^{3}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-6cc93547-60e1-5394-aaaf-3f2640834b2d" :answer/id #uuid "6cc93547-60e1-5394-aaaf-3f2640834b2d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({t}^{2}+1)\\sqrt{2t+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id 17592186129320 :knowledge-point/questions ["question-c339d0f2-af34-5938-bbf8-d47914ddf165" "question-bec28ae8-3800-5ebe-aea9-25248c908bf5" "question-568d7106-115a-5160-be7c-9ea466db4771"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c339d0f2-af34-5938-bbf8-d47914ddf165" :question/id #uuid "c339d0f2-af34-5938-bbf8-d47914ddf165" :question/math-academy-id "q-138967" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={t}^{2}-1,\\,y=\\frac{{t}^{3}}{3}-t,\\,t\\in [1,2].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=1$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)=2t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{3}}{3}-t)={t}^{2}-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{{(2t)}^{2}+{({t}^{2}-1)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{4{t}^{2}+{t}^{4}-2{t}^{2}+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{{t}^{4}+2{t}^{2}+1}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression ${t}^{4}+2{t}^{2}+1,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{{t}^{4}+2{t}^{2}+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{{({t}^{2})}^{2}+2\\cdot 1\\cdot {t}^{2}+{1}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\sqrt{{({t}^{2}+1)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\cdot |{t}^{2}+1|\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{2}-1)\\cdot ({t}^{2}+1)\\,\\text{d}t \\\\  & =2\\pi {\\int }_{1}^{2}({t}^{4}-1)\\,\\text{d}t\\end{aligned}\n$$\n\nTherefore, using direct integration we get\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{1}^{2}({t}^{4}-1)\\,\\text{d}t \\\\  & =2\\pi \\cdot {[\\frac{{t}^{5}}{5}-t]}_{1}^{2} \\\\  & =2\\pi [(\\frac{{2}^{5}}{5}-2)-(\\frac{{1}^{5}}{5}-1)] \\\\  & =2\\pi [\\frac{22}{5}+\\frac{4}{5}] \\\\  & =2\\pi \\cdot \\frac{26}{5} \\\\  & =\\frac{52\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d460285e-96c9-5656-88a1-24adf10022f6"] :db/ensure [:question/validate]} {:db/id "answer-field-d460285e-96c9-5656-88a1-24adf10022f6" :answer-field/id #uuid "d460285e-96c9-5656-88a1-24adf10022f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2dd285d1-cf9d-5646-a446-ce41bd2e2458" :answer-field/choices ["answer-f9f80523-10c6-5bea-b36a-01b7f0de1f7e" "answer-c01060b2-f26a-567b-a1dd-ba792972b5d7" "answer-ef41bf2a-c7d0-5536-922b-f7eb8c9ec0ae" "answer-f173cc96-34cf-5cea-9d45-09f0f19aa1e2" "answer-2dd285d1-cf9d-5646-a446-ce41bd2e2458"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9f80523-10c6-5bea-b36a-01b7f0de1f7e" :answer/id #uuid "f9f80523-10c6-5bea-b36a-01b7f0de1f7e" :answer/type :answer.type/math :answer/value "\\frac{21\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-c01060b2-f26a-567b-a1dd-ba792972b5d7" :answer/id #uuid "c01060b2-f26a-567b-a1dd-ba792972b5d7" :answer/type :answer.type/math :answer/value "\\frac{32\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-ef41bf2a-c7d0-5536-922b-f7eb8c9ec0ae" :answer/id #uuid "ef41bf2a-c7d0-5536-922b-f7eb8c9ec0ae" :answer/type :answer.type/math :answer/value "\\frac{40\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-f173cc96-34cf-5cea-9d45-09f0f19aa1e2" :answer/id #uuid "f173cc96-34cf-5cea-9d45-09f0f19aa1e2" :answer/type :answer.type/math :answer/value "\\frac{48\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-2dd285d1-cf9d-5646-a446-ce41bd2e2458" :answer/id #uuid "2dd285d1-cf9d-5646-a446-ce41bd2e2458" :answer/type :answer.type/math :answer/value "\\frac{52\\pi }{5}" :db/ensure [:answer/validate]} {:db/id 17592186129490 :question/problem "Consider the curve defined parametrically as \n\n$$\nx=3t-{t}^{3},\\,y=3{t}^{2},\\,t\\in [0,1].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{3})=3-3{t}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\sqrt{{(3-3{t}^{2})}^{2}+{(6t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\sqrt{9-18{t}^{2}+9{t}^{4}+36{t}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\sqrt{9{t}^{4}+18{t}^{2}+9}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression $9{t}^{4}+18{t}^{2}+9,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\sqrt{9{t}^{4}+18{t}^{2}+9}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\sqrt{9({t}^{4}+2{t}^{2}+1)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}3{t}^{2}\\cdot 3\\sqrt{{t}^{4}+2{t}^{2}+1}\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{1}{t}^{2}\\sqrt{({t}^{2}+1)^{2}}\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{1}{t}^{2}\\cdot |{t}^{2}+1|\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{1}{t}^{2}({t}^{2}+1)\\,\\text{d}t \\\\  & =18\\pi {\\int }_{0}^{1}({t}^{4}+{t}^{2})\\,\\text{d}t\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =18\\pi {\\int }_{0}^{1}({t}^{4}+{t}^{2})\\,\\text{d}t \\\\  & =18\\pi \\cdot {[\\frac{{t}^{5}}{5}+\\frac{{t}^{3}}{3}]}_{0}^{1} \\\\  & =18\\pi [(\\frac{1}{5}+\\frac{1}{3})-(\\frac{0}{5}+\\frac{0}{3})] \\\\  & =18\\pi \\cdot \\frac{8}{15} \\\\  & =\\frac{48\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186126440 :answer-field/correct "answer-26b58db8-aa9b-5306-acc7-0ae354e19ac8" :answer-field/choices ["answer-e76641f1-4b1e-5f93-a7e4-384fd90837d0" "answer-0fd56eb4-4c51-5eff-a136-8a8cbe4d2081" "answer-26b58db8-aa9b-5306-acc7-0ae354e19ac8" "answer-e78f34b4-d5a7-5009-8033-283511cf7d05" "answer-d30855cf-2561-551f-9f08-0885a43147ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-e76641f1-4b1e-5f93-a7e4-384fd90837d0" :answer/id #uuid "e76641f1-4b1e-5f93-a7e4-384fd90837d0" :answer/type :answer.type/math :answer/value "\\frac{24\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-0fd56eb4-4c51-5eff-a136-8a8cbe4d2081" :answer/id #uuid "0fd56eb4-4c51-5eff-a136-8a8cbe4d2081" :answer/type :answer.type/math :answer/value "\\frac{32\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-26b58db8-aa9b-5306-acc7-0ae354e19ac8" :answer/id #uuid "26b58db8-aa9b-5306-acc7-0ae354e19ac8" :answer/type :answer.type/math :answer/value "\\frac{48\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-e78f34b4-d5a7-5009-8033-283511cf7d05" :answer/id #uuid "e78f34b4-d5a7-5009-8033-283511cf7d05" :answer/type :answer.type/math :answer/value "\\frac{56\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-d30855cf-2561-551f-9f08-0885a43147ea" :answer/id #uuid "d30855cf-2561-551f-9f08-0885a43147ea" :answer/type :answer.type/math :answer/value "\\frac{63\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "question-bec28ae8-3800-5ebe-aea9-25248c908bf5" :question/id #uuid "bec28ae8-3800-5ebe-aea9-25248c908bf5" :question/math-academy-id "q-139031" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=3{t}^{2},\\,y={t}^{3}-3t,\\,t\\in [-\\sqrt{3},0].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=-\\sqrt{3}$ to ${t}_{2}=0.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3t)=3{t}^{2}-3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{{(6t)}^{2}+{(3{t}^{2}-3)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{36{t}^{2}+9{t}^{4}-18{t}^{2}+9}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{9{t}^{4}+18{t}^{2}+9}\\,\\text{d}t\\end{aligned}\n$$\n\nNow, factoring the expression $9{t}^{4}+18{t}^{2}+9,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{9{t}^{4}+18{t}^{2}+9}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{9({t}^{4}+2{t}^{2}+1)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\cdot 3\\sqrt{{t}^{4}+2{t}^{2}+1}\\,\\text{d}t \\\\  & =6\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)\\sqrt{({t}^{2}+1)^{2}}\\,\\text{d}t \\\\  & =6\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)|{t}^{2}+1|\\,\\text{d}t \\\\  & =6\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{3}-3t)({t}^{2}+1)\\,\\text{d}t \\\\  & =6\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{5}-2{t}^{3}-3t)\\,\\text{d}t\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =6\\pi {\\int }_{-\\sqrt{3}}^{0}({t}^{5}-2{t}^{3}-3t)\\,\\text{d}t \\\\  & =6\\pi \\cdot {[\\frac{{t}^{6}}{6}-\\frac{{t}^{4}}{2}-\\frac{3{t}^{2}}{2}]}_{-\\sqrt{3}}^{0} \\\\  & =6\\pi [0-(\\frac{27}{6}-\\frac{9}{2}-\\frac{9}{2})] \\\\  & =6\\pi \\cdot \\frac{27}{6} \\\\  & =27\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9b1becb6-0d80-5be3-8b07-052ebc9be8d2"] :db/ensure [:question/validate]} {:db/id "answer-field-9b1becb6-0d80-5be3-8b07-052ebc9be8d2" :answer-field/id #uuid "9b1becb6-0d80-5be3-8b07-052ebc9be8d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d11b877-fb53-589c-8eea-da397cb6e4c7" :answer-field/choices ["answer-4d11b877-fb53-589c-8eea-da397cb6e4c7" "answer-dc7fb2c2-362a-55ce-b957-f29bf7d97ca4" "answer-fd4836d1-dcb7-5a07-b0af-0193ffb18029" "answer-e033b1bb-f523-513b-b42b-df8a9a20816a" "answer-9873e93d-4b80-59cd-bde4-4c4887e98e61"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d11b877-fb53-589c-8eea-da397cb6e4c7" :answer/id #uuid "4d11b877-fb53-589c-8eea-da397cb6e4c7" :answer/type :answer.type/math :answer/value "27\\pi " :db/ensure [:answer/validate]} {:db/id "answer-dc7fb2c2-362a-55ce-b957-f29bf7d97ca4" :answer/id #uuid "dc7fb2c2-362a-55ce-b957-f29bf7d97ca4" :answer/type :answer.type/math :answer/value "27\\sqrt{3}\\pi " :db/ensure [:answer/validate]} {:db/id "answer-fd4836d1-dcb7-5a07-b0af-0193ffb18029" :answer/id #uuid "fd4836d1-dcb7-5a07-b0af-0193ffb18029" :answer/type :answer.type/math :answer/value "9\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e033b1bb-f523-513b-b42b-df8a9a20816a" :answer/id #uuid "e033b1bb-f523-513b-b42b-df8a9a20816a" :answer/type :answer.type/math :answer/value "9\\sqrt{3}\\pi " :db/ensure [:answer/validate]} {:db/id "answer-9873e93d-4b80-59cd-bde4-4c4887e98e61" :answer/id #uuid "9873e93d-4b80-59cd-bde4-4c4887e98e61" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{9}\\pi " :db/ensure [:answer/validate]} {:db/id "question-568d7106-115a-5160-be7c-9ea466db4771" :question/id #uuid "568d7106-115a-5160-be7c-9ea466db4771" :question/math-academy-id "q-352091" :question/problem "Consider the curve defined parametrically as \n\n$$\nx=\\operatorname{cos}⁡(t),\\,y=\\operatorname{ln}⁡|\\operatorname{sec}⁡(t)+\\operatorname{tan}⁡(t)|-\\operatorname{sin}⁡(t),\\,t\\in [0,\\frac{\\pi }{3}].\n$$\n\nDetermine the surface area $S$ generated when this curve is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\frac{\\pi }{3}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}[\\operatorname{cos}⁡(t)]=-\\operatorname{sin}⁡(t), \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}[\\operatorname{ln}⁡|\\operatorname{sec}⁡(t)+\\operatorname{tan}⁡(t)|-\\operatorname{sin}⁡(t)]=\\operatorname{sec}⁡(t)-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{[-\\operatorname{sin}⁡(t)]}^{2}+{[\\operatorname{sec}⁡(t)-\\operatorname{cos}⁡(t)]}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{sin}^{2}⁡(t)+{sec}^{2}⁡(t)-2+{cos}^{2}⁡(t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{sec}^{2}⁡(t)-2+[{sin}^{2}⁡(t)+{cos}^{2}⁡(t)]}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the identity ${sin}^{2}⁡(t)+{cos}^{2}⁡(t)=1$ and ${sec}^{2}⁡(t)-1={tan}^{2}⁡(t)$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{sec}^{2}⁡(t)-2+[{sin}^{2}⁡(t)+{cos}^{2}⁡(t)]}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{sec}^{2}⁡(t)-2+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{sec}^{2}⁡(t)-1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\sqrt{{tan}^{2}⁡(t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\cdot |\\operatorname{tan}⁡(t)|\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\cdot \\operatorname{tan}⁡(t)\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(t)\\cdot \\frac{\\operatorname{sin}⁡(t)}{\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =2\\pi [-\\operatorname{cos}⁡(t)]_{0}^{\\pi /3} \\\\  & =-2\\pi [\\operatorname{cos}⁡(\\frac{\\pi }{3})-\\operatorname{cos}⁡(0)] \\\\  & =-2\\pi (\\frac{1}{2}-1) \\\\  & =-2\\pi \\cdot (-\\frac{1}{2}) \\\\  & =\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1a1dc858-f317-5a50-ac0a-63bd26d09cc3"] :db/ensure [:question/validate]} {:db/id "answer-field-1a1dc858-f317-5a50-ac0a-63bd26d09cc3" :answer-field/id #uuid "1a1dc858-f317-5a50-ac0a-63bd26d09cc3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e381238e-91d4-5561-a74f-947fada01bf0" :answer-field/choices ["answer-e381238e-91d4-5561-a74f-947fada01bf0"] :db/ensure [:answer-field/validate]} {:db/id "answer-e381238e-91d4-5561-a74f-947fada01bf0" :answer/id #uuid "e381238e-91d4-5561-a74f-947fada01bf0" :answer/type :answer.type/math :answer/value "\\pi" :db/ensure [:answer/validate]} {:db/id "activity-15816cbf-9c2c-53ef-a829-ca2321defe44" :activity/id #uuid "15816cbf-9c2c-53ef-a829-ca2321defe44" :activity/title "Surface Areas of Revolution for Parametric Curves" :activity/type :activity.type/review :activity/scope 17592186049265 :activity/course 17592186046645 :activity/steps ["step-d839e236-0c85-509d-9ef3-41872a77d0ff" "step-a37727ba-408c-54ca-b44b-c58bf3c5ee21" "step-57085c22-32d0-5a83-a69e-4ce3a9bdecbd" "step-64958667-b549-5eb7-8561-a3974fe10b64" "step-679ce636-9dcd-5b15-ab39-bb3b7ed24f1c"] :activity/first-step "step-d839e236-0c85-509d-9ef3-41872a77d0ff" :db/ensure [:activity/validate]} {:db/id "step-d839e236-0c85-509d-9ef3-41872a77d0ff" :step/id #uuid "d839e236-0c85-509d-9ef3-41872a77d0ff" :step/content "question-7d6c3d2a-2d0d-538a-8df1-4fa8a05510f8" :step/next "step-a37727ba-408c-54ca-b44b-c58bf3c5ee21" :db/ensure [:step/validate]} {:db/id "step-a37727ba-408c-54ca-b44b-c58bf3c5ee21" :step/id #uuid "a37727ba-408c-54ca-b44b-c58bf3c5ee21" :step/content "question-c339d0f2-af34-5938-bbf8-d47914ddf165" :step/next "step-57085c22-32d0-5a83-a69e-4ce3a9bdecbd" :db/ensure [:step/validate]} {:db/id "step-57085c22-32d0-5a83-a69e-4ce3a9bdecbd" :step/id #uuid "57085c22-32d0-5a83-a69e-4ce3a9bdecbd" :step/content 17592186129490 :step/next "step-64958667-b549-5eb7-8561-a3974fe10b64" :db/ensure [:step/validate]} {:db/id "step-64958667-b549-5eb7-8561-a3974fe10b64" :step/id #uuid "64958667-b549-5eb7-8561-a3974fe10b64" :step/content "question-bec28ae8-3800-5ebe-aea9-25248c908bf5" :step/next "step-679ce636-9dcd-5b15-ab39-bb3b7ed24f1c" :db/ensure [:step/validate]} {:db/id "step-679ce636-9dcd-5b15-ab39-bb3b7ed24f1c" :step/id #uuid "679ce636-9dcd-5b15-ab39-bb3b7ed24f1c" :step/content "question-568d7106-115a-5160-be7c-9ea466db4771" :db/ensure [:step/validate]} {:db/id 17592186172135 :knowledge-point/questions ["question-01a5e642-9803-5a1b-8846-85c812cf1513"] :db/ensure [:knowledge-point/validate]} {:db/id "question-01a5e642-9803-5a1b-8846-85c812cf1513" :question/id #uuid "01a5e642-9803-5a1b-8846-85c812cf1513" :question/math-academy-id "q-162815" :question/problem "Suppose we would like to find the minimum of the function $f(x,y,z)=xy-zy$ on the intersection of the surfaces $y+z=1$ and ${x}^{2}+{y}^{2}+{z}^{2}=1$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system: \n\n$$\n\\{\\begin{aligned}⟨y,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,-y⟩=\\lambda ⟨0,\\,1,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}}\\,⟩+\\mu ⟨2x,\\,2y,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}}\\,⟩ \\\\ y+z=1 \\\\ {x}^{2}+{y}^{2}+{z}^{2}=1\\end{aligned}\n$$\n\nFrom left to right, what are the missing parts of the expressions?" :question/worked-solution "We need to find the minimum value of \n\n$$\nf(x,y,z)=xy-zy\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)=y+z=1,\\,h(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}=1.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=1 \\\\ h(x,y,z)=1\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨y,\\,x-z,\\,-y⟩ & =\\lambda ⟨0,\\,1,\\,1⟩+\\mu ⟨2x,\\,2y,\\,2z⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d2718901-61ad-591c-ba8b-c2899ee3b35f"] :db/ensure [:question/validate]} {:db/id "answer-field-d2718901-61ad-591c-ba8b-c2899ee3b35f" :answer-field/id #uuid "d2718901-61ad-591c-ba8b-c2899ee3b35f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4899d2f0-4a9a-54c0-b255-243f00296fb1" :answer-field/choices ["answer-7c3d9025-0e2b-5e52-b2d1-c27a27ac63c7" "answer-900204f4-4ee6-51fa-bded-94c975db4cc9" "answer-4899d2f0-4a9a-54c0-b255-243f00296fb1" "answer-d5255563-50f7-52ae-bccd-46caade6840e" "answer-7307529a-c5fa-50c3-85e4-0c320e676b56"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c3d9025-0e2b-5e52-b2d1-c27a27ac63c7" :answer/id #uuid "7c3d9025-0e2b-5e52-b2d1-c27a27ac63c7" :answer/type :answer.type/text :answer/value "$-2z,\\,$ $0,\\,$  and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-900204f4-4ee6-51fa-bded-94c975db4cc9" :answer/id #uuid "900204f4-4ee6-51fa-bded-94c975db4cc9" :answer/type :answer.type/text :answer/value "$2z,\\,$ $1,\\,$  and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-4899d2f0-4a9a-54c0-b255-243f00296fb1" :answer/id #uuid "4899d2f0-4a9a-54c0-b255-243f00296fb1" :answer/type :answer.type/text :answer/value "$x-z,\\,$ $1,\\,$  and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-d5255563-50f7-52ae-bccd-46caade6840e" :answer/id #uuid "d5255563-50f7-52ae-bccd-46caade6840e" :answer/type :answer.type/text :answer/value "$xz,\\,$ $0,\\,$  and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-7307529a-c5fa-50c3-85e4-0c320e676b56" :answer/id #uuid "7307529a-c5fa-50c3-85e4-0c320e676b56" :answer/type :answer.type/text :answer/value "$yz,\\,$ $1,\\,$  and $z$" :db/ensure [:answer/validate]} {:db/id 17592186173258 :tutorial/content "We can find global extrema of multivariable functions subject to multiple constraints using the method of Lagrange multipliers. \n\nFor example, suppose that we want to find the minimum value of \n\n$$\nf(x,y,z) = 4xy+z^2\n$$\n\nsubject to the following *two* constraints: \n\n$$\ng(x,y,z)=x^2+y^2=1, \\qquad h(x,y,z)=2x^2 + 4y^2 - z = 0\n$$\n\nGeometrically, this means that we want to minimize $f(x,y,z)$ over the intersection of the cylinder $x^2+y^2=1$ and the elliptic paraboloid $2x^2 + 4y^2 - z = 0,$ as shown below.\n\n![](images/0b/0b16f73e034724a9f38d91a606f627db85299507552c45192e91c39bc0c6725a.png)\n\nThe method of Lagrange multipliers states that the extrema of the function $f(x,y,z)$ subject to constraints $g(x,y,z)=a$ and $h(x,y,z)=b$ can be found by solving the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=a \\\\ h(x,y,z)=b\\end{aligned}\n$$\n\nHere, the constants $\\lambda$ and $\\mu$ are the Lagrange multipliers of this system.\n\nAs before, this method assumes that $\\nabla g \\neq \\mathbf{0}$ and $\\nabla h \\neq \\mathbf{0}$ on the curves $g(x,y,z)=a$ and $h(x,y,z)=b,$ and that the extreme values exist.\n\n**Note:** Geometrically, the condition $\\nabla f = \\lambda \\nabla g + \\mu \\nabla h$ states that\n\n- $\\nabla f$ lies in the plane spanned by $\\nabla g$ and $\\nabla h,$ or, equivalently,\n\n- $\\nabla f$ is perpendicular to the level surfaces $g(x,y,z) = a$ and $h(x,y,z) = b.$\n\nWe'll explore this geometric intuition further at the end of the lesson." :db/ensure [:tutorial/validate]} {:db/id 17592186221409 :knowledge-point/questions ["question-900adaef-859d-5d14-9981-202d2269e069"] :db/ensure [:knowledge-point/validate]} {:db/id "question-900adaef-859d-5d14-9981-202d2269e069" :question/id #uuid "900adaef-859d-5d14-9981-202d2269e069" :question/math-academy-id "q-334626" :question/problem "Find ${e}^{At}$ for $A=[\\begin{aligned}5 & 6 \\\\ -3 & -1\\end{aligned}].$ \n\n*Hint: The eigenvalues of $A$ are $2\\pm 3\\text{i}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${e}^{At}={e}^{2t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"140px\">{{field-1}}</td>\n<td align=\"center\" width=\"140px\">$2\\operatorname{sin}⁡(3t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">$\\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t)$</td>\n<td align=\"center\"></td>\n</tr></tbody></table>" :question/worked-solution "We have a square matrix of dimension $n=2.$ Thus, \n\n$$\n\\begin{aligned}{e}^{At} & ={\\alpha }_{1}At+{\\alpha }_{0}I \\\\  & ={\\alpha }_{1}[\\begin{aligned}5 & 6 \\\\ -3 & -1\\end{aligned}]t+{\\alpha }_{0}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5{\\alpha }_{1}t+{\\alpha }_{0} & 6{\\alpha }_{1}t \\\\ -3{\\alpha }_{1}t & -{\\alpha }_{1}t+{\\alpha }_{0}\\end{aligned}].\\end{aligned}\n$$\n\nwhere ${\\alpha }_{1}$ and ${\\alpha }_{0}$ are functions to be determined.\n\nConsider the polynomial $r(\\lambda )={\\alpha }_{1}\\lambda +{\\alpha }_{0}.$ The eigenvalues or $At$ are \n\n$$\n{\\lambda }_{1}=(2+3\\text{i})t,\\,{\\lambda }_{2}=(2-3\\text{i})t,\n$$\n\nwhich are complex conjugates. Thus, we have the following:\n\n$$\n\\begin{aligned}r((2+3\\text{i})t) & ={e}^{(2+3\\text{i})t} \\\\ {\\alpha }_{1}(2+3\\text{i})t+{\\alpha }_{0} & ={e}^{2t}(\\operatorname{cos}⁡(3t)+\\text{i}\\operatorname{sin}⁡(3t)) \\\\ (2{\\alpha }_{1}t+{\\alpha }_{0})+3{\\alpha }_{1}\\text{i}t & ={e}^{2t}\\operatorname{cos}⁡(3t)+\\text{i}\\,{e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nNow, we equate the real and imaginary parts, and solve for ${\\alpha }_{1}$ and ${\\alpha }_{0}:$\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2{\\alpha }_{1}t+{\\alpha }_{0}={e}^{2t}\\operatorname{cos}⁡(3t) \\\\ 3t{\\alpha }_{1}={e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\\,⇒\\,\\{\\begin{aligned}{\\alpha }_{1}=\\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t) \\\\ {\\alpha }_{0}={e}^{2t}(\\operatorname{cos}⁡(3t)-\\frac{2}{3}\\operatorname{sin}⁡(3t))\\end{aligned}\\end{aligned}\n$$\n\nSubstituting ${\\alpha }_{1}$ and ${\\alpha }_{0}$ into the expressions for the required entries of ${e}^{At},$ we get the following:\n\n$$\n\\begin{aligned}5{\\alpha }_{1}t+{\\alpha }_{0} & =5\\cdot \\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t)\\cdot t+{e}^{2t}(\\operatorname{cos}⁡(3t)-\\frac{2}{3}\\operatorname{sin}⁡(3t)) \\\\  & =\\frac{5}{3}{e}^{2t}\\operatorname{sin}⁡(3t)+{e}^{2t}\\operatorname{cos}⁡(3t)-\\frac{2}{3}{e}^{2t}\\operatorname{sin}⁡(3t) \\\\  & ={e}^{2t}(\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)) \\\\ -3{\\alpha }_{1}t & =-3\\cdot \\frac{1}{3t}{e}^{2t}\\operatorname{sin}⁡(3t)\\cdot t \\\\  & =-{e}^{2t}\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{2t}[\\begin{aligned}\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t) & 2\\operatorname{sin}⁡(3t) \\\\ -\\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t)\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3247c73e-d754-5617-80f3-a0beacefea90" "answer-field-4788b925-6ee1-5536-8ffa-a6478b71d51d"] :db/ensure [:question/validate]} {:db/id "answer-field-3247c73e-d754-5617-80f3-a0beacefea90" :answer-field/id #uuid "3247c73e-d754-5617-80f3-a0beacefea90" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9a8db4e8-f732-5d22-9704-09e0ccf298b1" :answer-field/choices ["answer-9a8db4e8-f732-5d22-9704-09e0ccf298b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a8db4e8-f732-5d22-9704-09e0ccf298b1" :answer/id #uuid "9a8db4e8-f732-5d22-9704-09e0ccf298b1" :answer/type :answer.type/math :answer/value "\\cos(3t)+\\sin(3t)" :db/ensure [:answer/validate]} {:db/id "answer-field-4788b925-6ee1-5536-8ffa-a6478b71d51d" :answer-field/id #uuid "4788b925-6ee1-5536-8ffa-a6478b71d51d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f84eb7c6-9806-5d01-aade-ce5ce09883c7" :answer-field/choices ["answer-f84eb7c6-9806-5d01-aade-ce5ce09883c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-f84eb7c6-9806-5d01-aade-ce5ce09883c7" :answer/id #uuid "f84eb7c6-9806-5d01-aade-ce5ce09883c7" :answer/type :answer.type/math :answer/value "-\\sin(3t)" :db/ensure [:answer/validate]} {:db/id "activity-e67bdbbc-b2ac-5dc2-96db-49866bc692da" :activity/id #uuid "e67bdbbc-b2ac-5dc2-96db-49866bc692da" :activity/title "Matrix Exponentials" :activity/type :activity.type/review :activity/scope 17592186050054 :activity/course 17592186046645 :activity/steps ["step-447659a5-783c-55e2-b7bc-7044e79e9190" "step-783d8e6f-d461-5f0b-8f11-aa192fbe52a4" "step-03d5d0e2-58f6-580f-b08d-c488e5333a32" "step-dc3bbe46-b9a2-5b99-9ca0-73318c047651" "step-eabd75d2-306c-5778-a5d4-6908c275c489"] :activity/first-step "step-447659a5-783c-55e2-b7bc-7044e79e9190" :db/ensure [:activity/validate]} {:db/id "step-44765