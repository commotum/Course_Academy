 $-\\frac{1}{13}$ is  $-\\frac{13}{1}=-13.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-67816096-666b-5e5b-a860-8b118de6604b"] :db/ensure [:question/validate]} {:db/id "answer-field-67816096-666b-5e5b-a860-8b118de6604b" :answer-field/id #uuid "67816096-666b-5e5b-a860-8b118de6604b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59322dbd-f174-5317-bbae-842a880e3a93" :answer-field/choices ["answer-edf4ef07-4aa7-5714-841a-0679417bbf6a" "answer-59322dbd-f174-5317-bbae-842a880e3a93" "answer-074b6cbc-8a8b-544a-bb0b-d2f62805045c" "answer-900478d0-67c5-5aa5-bf2b-dc68224273e3" "answer-4c5a3fa6-95bd-5464-97a2-11c720c3b12e"] :db/ensure [:answer-field/validate]} {:db/id "answer-edf4ef07-4aa7-5714-841a-0679417bbf6a" :answer/id #uuid "edf4ef07-4aa7-5714-841a-0679417bbf6a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-59322dbd-f174-5317-bbae-842a880e3a93" :answer/id #uuid "59322dbd-f174-5317-bbae-842a880e3a93" :answer/type :answer.type/math :answer/value "-13" :db/ensure [:answer/validate]} {:db/id "answer-074b6cbc-8a8b-544a-bb0b-d2f62805045c" :answer/id #uuid "074b6cbc-8a8b-544a-bb0b-d2f62805045c" :answer/type :answer.type/math :answer/value "-\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "answer-900478d0-67c5-5aa5-bf2b-dc68224273e3" :answer/id #uuid "900478d0-67c5-5aa5-bf2b-dc68224273e3" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-4c5a3fa6-95bd-5464-97a2-11c720c3b12e" :answer/id #uuid "4c5a3fa6-95bd-5464-97a2-11c720c3b12e" :answer/type :answer.type/math :answer/value "\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "question-91c3c8c6-ac05-5f5c-bd08-a6bb467209d7" :question/id #uuid "91c3c8c6-ac05-5f5c-bd08-a6bb467209d7" :question/math-academy-id "q-173695" :question/problem "The reciprocal of $-4\\,\\frac{1}{2}$ is{{field-1}}." :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n-4\\,\\frac{1}{2}=-\\frac{4\\cdot 2+1}{2}=-\\frac{9}{2}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $-4\\frac{1}{2}$ is $-\\frac{2}{9}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a2cc768-0bf0-5878-9554-f1f1743dde13"] :db/ensure [:question/validate]} {:db/id "answer-field-9a2cc768-0bf0-5878-9554-f1f1743dde13" :answer-field/id #uuid "9a2cc768-0bf0-5878-9554-f1f1743dde13" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3" :answer-field/choices ["answer-87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3" :answer/id #uuid "87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3" :answer/type :answer.type/math :answer/value "-\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "question-f127ccf9-f581-5522-a0c1-5f3908dc1d25" :question/id #uuid "f127ccf9-f581-5522-a0c1-5f3908dc1d25" :question/math-academy-id "q-178342" :question/problem "The reciprocal of $4\\,\\frac{2}{3}$ is{{field-1}}." :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n4\\,\\frac{2}{3}=\\frac{4\\cdot 3+2}{3}=\\frac{14}{3}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $\\frac{14}{3}$ is $\\frac{3}{14}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-236ee32a-5f42-50af-8a76-80651d348499"] :db/ensure [:question/validate]} {:db/id "answer-field-236ee32a-5f42-50af-8a76-80651d348499" :answer-field/id #uuid "236ee32a-5f42-50af-8a76-80651d348499" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7567db39-67e8-5474-b3f5-331ea3bd5083" :answer-field/choices ["answer-7567db39-67e8-5474-b3f5-331ea3bd5083"] :db/ensure [:answer-field/validate]} {:db/id "answer-7567db39-67e8-5474-b3f5-331ea3bd5083" :answer/id #uuid "7567db39-67e8-5474-b3f5-331ea3bd5083" :answer/type :answer.type/math :answer/value "\\frac{3}{14}" :db/ensure [:answer/validate]} {:db/id "question-657c51ff-9f17-50fc-8c5e-6121474d9102" :question/id #uuid "657c51ff-9f17-50fc-8c5e-6121474d9102" :question/math-academy-id "q-99738" :question/problem "What is the reciprocal of $10\\,\\frac{5}{8}?$" :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n10\\,\\frac{5}{8}=\\frac{10\\cdot 8+5}{8}=\\frac{85}{8}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $10\\,\\frac{5}{8}$ is $\\frac{8}{85}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7084abcd-1786-50ea-abb5-04f3da896109"] :db/ensure [:question/validate]} {:db/id "answer-field-7084abcd-1786-50ea-abb5-04f3da896109" :answer-field/id #uuid "7084abcd-1786-50ea-abb5-04f3da896109" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0b5dd53-7ff1-5875-97af-ce171d0a2e39" :answer-field/choices ["answer-a9701a24-f1e7-52b5-a71b-1a0816c49740" "answer-d2b3ef9d-7982-5a8a-ba71-bdc9eca9c92e" "answer-d93b9067-cb4b-5e35-836d-d52f39ef7a38" "answer-89aaa317-f030-5993-8e3a-490efe0c9e44" "answer-d0b5dd53-7ff1-5875-97af-ce171d0a2e39"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9701a24-f1e7-52b5-a71b-1a0816c49740" :answer/id #uuid "a9701a24-f1e7-52b5-a71b-1a0816c49740" :answer/type :answer.type/math :answer/value "-\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d2b3ef9d-7982-5a8a-ba71-bdc9eca9c92e" :answer/id #uuid "d2b3ef9d-7982-5a8a-ba71-bdc9eca9c92e" :answer/type :answer.type/math :answer/value "-\\frac{8}{85}" :db/ensure [:answer/validate]} {:db/id "answer-d93b9067-cb4b-5e35-836d-d52f39ef7a38" :answer/id #uuid "d93b9067-cb4b-5e35-836d-d52f39ef7a38" :answer/type :answer.type/math :answer/value "\\frac{18}{5}" :db/ensure [:answer/validate]} {:db/id "answer-89aaa317-f030-5993-8e3a-490efe0c9e44" :answer/id #uuid "89aaa317-f030-5993-8e3a-490efe0c9e44" :answer/type :answer.type/math :answer/value "\\frac{5}{88}" :db/ensure [:answer/validate]} {:db/id "answer-d0b5dd53-7ff1-5875-97af-ce171d0a2e39" :answer/id #uuid "d0b5dd53-7ff1-5875-97af-ce171d0a2e39" :answer/type :answer.type/math :answer/value "\\frac{8}{85}" :db/ensure [:answer/validate]} {:db/id "question-807be93b-6cd0-5b9f-b7c9-fdc2729b89b6" :question/id #uuid "807be93b-6cd0-5b9f-b7c9-fdc2729b89b6" :question/math-academy-id "q-178518" :question/problem "Expressed as a **fraction in its simplest form**, the reciprocal of $-7.8$ is{{field-1}}." :question/worked-solution "We first convert the decimal to a fraction. By doing this, we get\n\n$$\n-7.8=-\\frac{78}{10}=-\\frac{39}{5}.\n$$\n\nNow, we flip the numerator and denominator, keeping the negative sign. So the reciprocal of $-7.8$ is $-\\frac{5}{39}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f14fc10f-c4d9-50cc-87e1-30b95f0d82a1"] :db/ensure [:question/validate]} {:db/id "answer-field-f14fc10f-c4d9-50cc-87e1-30b95f0d82a1" :answer-field/id #uuid "f14fc10f-c4d9-50cc-87e1-30b95f0d82a1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-44d2b8d3-02b8-55a7-92b7-737930bcb33f" :answer-field/choices ["answer-44d2b8d3-02b8-55a7-92b7-737930bcb33f"] :db/ensure [:answer-field/validate]} {:db/id "answer-44d2b8d3-02b8-55a7-92b7-737930bcb33f" :answer/id #uuid "44d2b8d3-02b8-55a7-92b7-737930bcb33f" :answer/type :answer.type/math :answer/value "-\\frac{5}{39}" :db/ensure [:answer/validate]} {:db/id "question-4dd2325a-9268-5f8d-bfb0-40e4777f32e3" :question/id #uuid "4dd2325a-9268-5f8d-bfb0-40e4777f32e3" :question/math-academy-id "q-99743" :question/problem "What is the reciprocal of $7.5?$" :question/worked-solution "We first convert the decimal to a fraction. By doing this, we get\n\n$$\n7.5=\\frac{75}{10}=\\frac{15}{2}.\n$$\n\nNow, we flip the numerator and denominator. So the reciprocal of $7.5$ is $\\frac{2}{15}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c291585-3958-5d0e-a07d-aef87471a966"] :db/ensure [:question/validate]} {:db/id "answer-field-9c291585-3958-5d0e-a07d-aef87471a966" :answer-field/id #uuid "9c291585-3958-5d0e-a07d-aef87471a966" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-edbe65dc-9c8a-5d95-8a59-e3b79418e861" :answer-field/choices ["answer-8a753aba-cf51-5d44-a250-a965d4985f4a" "answer-1650a834-fc87-5021-b8bf-062eb30d1dc2" "answer-19782674-e6b3-57a2-ae3e-8c71b8f55bdb" "answer-edbe65dc-9c8a-5d95-8a59-e3b79418e861" "answer-f030bd91-951d-54bd-81eb-7437b4fdae44"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a753aba-cf51-5d44-a250-a965d4985f4a" :answer/id #uuid "8a753aba-cf51-5d44-a250-a965d4985f4a" :answer/type :answer.type/math :answer/value "-\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "answer-1650a834-fc87-5021-b8bf-062eb30d1dc2" :answer/id #uuid "1650a834-fc87-5021-b8bf-062eb30d1dc2" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-19782674-e6b3-57a2-ae3e-8c71b8f55bdb" :answer/id #uuid "19782674-e6b3-57a2-ae3e-8c71b8f55bdb" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-edbe65dc-9c8a-5d95-8a59-e3b79418e861" :answer/id #uuid "edbe65dc-9c8a-5d95-8a59-e3b79418e861" :answer/type :answer.type/math :answer/value "\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "answer-f030bd91-951d-54bd-81eb-7437b4fdae44" :answer/id #uuid "f030bd91-951d-54bd-81eb-7437b4fdae44" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id 17592186135172 :tutorial/content "The **reciprocal** of a number is equal to ${\\color{red}{1}}$ divided by the number. For example:\n\n- the reciprocal of ${\\color{blue}{2}}$ is equal to ${\\color{red}{1}} \\div {\\color{blue}{2}} = \\dfrac{1}{2}$\n\n- the reciprocal of ${\\color{blue}{3}}$ is equal to  ${\\color{red}{1}} \\div {\\color{blue}{3}} = \\dfrac{1}{3}$\n\n- the reciprocal of $-{\\color{blue}{7}}$ is equal to  ${\\color{red}{1}} \\div ({\\color{blue}{-7}}) = -\\dfrac{1}{7}$\n\nThe reciprocal of ${\\color{blue}{1}}$ is  equal to  ${\\color{red}{1}} \\div {\\color{blue}{1}} = 1.$ So the number $1$ is equal to its reciprocal. The same is true for $-1.$\n\nThe reciprocal of a number always has the same sign as the original number.\n\n- If the number is positive, its reciprocal will be positive, while\n\n- if the number is negative, its reciprocal is also negative." :db/ensure [:tutorial/validate]} {:db/id 17592186135173 :tutorial/content "We find the reciprocal of a fraction by flipping its numerator and denominator, keeping the sign of the fraction. For example:\n\n- the reciprocal of $\\dfrac {\\color{red}{1}}{\\color{blue}{2}}$ is $\\dfrac{{\\color{blue}{2}}}{{\\color{red}{1}}} = 2$\n\n- the reciprocal of $- \\dfrac {\\color{red}{1}}{\\color{blue}{7}}$ is $- \\dfrac{{\\color{blue}{7}}}{{\\color{red}{1}}} = -7$\n\n- the reciprocal of $\\dfrac {\\color{red}{2}} {\\color{blue}{5}}$ is $\\dfrac{{\\color{blue}{5}}}{\\color{red}{2}}$\n\n- the reciprocal of $-\\dfrac {\\color{red}{4}} {\\color{blue}{9}}$ is $-\\dfrac{{\\color{blue}{9}}}{\\color{red}{4}}$" :db/ensure [:tutorial/validate]} {:db/id 17592186135174 :tutorial/content "The product of a number and its reciprocal is *always* equal to $1.$\n\nFor instance, the reciprocal of $2$ is $\\dfrac{1}{2}.$ If we multiply these two numbers together, we get\n\n$$\n2 \\cdot \\dfrac{1}{2} = \\dfrac{2\\cdot 1}{2} = \\dfrac{2}{2} = 1.\n$$\n\n \n\nSimilarly, the product of $-10$ and its reciprocal $-\\dfrac{1}{10}$ is\n\n$$\n(-10) \\cdot \\left(-\\dfrac{1}{10}\\right) = \\dfrac{10\\cdot 1}{10} = \\dfrac{10}{10} = 1.\n$$\n\n \n\nIn this case, we had a negative multiplied by a negative, which gave a positive." :db/ensure [:tutorial/validate]} {:db/id 17592186134043 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186370880 :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt{x}\\}.\n$$\n\nHence, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}{y}^{2}\\cdot 4My\\,\\text{d}y\\,\\text{d}x \\\\  & =4M{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =4M{\\int }_{0}^{1}{[\\frac{1}{4}{y}^{4}]}_{y=0}^{y=\\sqrt{x}}\\,\\text{d}x \\\\  & =4M{\\int }_{0}^{1}\\frac{1}{4}{x}^{2}\\,\\text{d}x \\\\  & =M{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x \\\\  & =M{[\\frac{1}{3}{x}^{3}]}_{0}^{1} \\\\  & =\\frac{M}{3}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{\\frac{M}{3}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{1}{3}} \\\\  & =\\frac{1}{\\sqrt{3}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186198651 :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,1\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the origin." :db/ensure [:question/validate]} {:db/id 17592186281676 :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the $y$-axis." :db/ensure [:question/validate]} {:db/id 17592186281678 :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,\\,1\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the origin." :db/ensure [:question/validate]} {:db/id 17592186198663 :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nIn polar coordinates, the region occupied by the plate is given by\n\n$$\nD=\\{(r,\\theta )\\,:\\,1\\le r\\le 2,\\,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nThe moment of inertia about the $y$-axis, in polar coordinates, is defined as\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta ){r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta ,\n$$\n\nwhere $\\lambda (r,\\theta )$ is the mass density function.\n\nAlso, the mass density in terms of polar coordinates is $\\lambda (r,\\theta )=\\frac{3}{7}Mr\\operatorname{sin}⁡\\theta .$\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}\\lambda (r,\\theta ){r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3}{7}M{\\int }_{0}^{\\pi /2}{\\int }_{1}^{2}{r}^{4}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3}{7}M({\\int }_{1}^{2}{r}^{4}\\,\\text{d}r)({\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{3}{7}M\\cdot \\frac{1}{5}{r}^{5}{|}_{1}^{2}\\cdot {[-\\frac{{cos}^{3}⁡\\theta }{3}]}_{0}^{\\pi /2} \\\\  & =\\frac{3}{7}M\\cdot (\\frac{32}{5}-\\frac{1}{5})\\cdot (-0+\\frac{1}{3}) \\\\  & =\\frac{3}{7}M\\cdot \\frac{31}{5}\\cdot \\frac{1}{3} \\\\  & =\\frac{31M}{35}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{y} & =\\sqrt{\\frac{{I}_{y}}{M}} \\\\  & =\\sqrt{\\frac{31M}{35}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{31}{35}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-315966ad-7330-535d-905a-0ad99188e4ab" :activity/id #uuid "315966ad-7330-535d-905a-0ad99188e4ab" :activity/title "Calculating the Radius of Gyration of a Plane Lamina" :activity/type :activity.type/review :activity/scope 17592186050741 :activity/course 17592186046660 :activity/steps ["step-6aa4a18d-6a7f-5ff6-bc60-411ff63cf5eb" "step-147cc4dc-7dc1-5126-916a-8cec1032d28e" "step-6eabb3c1-2352-5d3f-adb7-054c0b5fbb20" "step-c726fa30-b86e-5568-af6e-dfea63974539" "step-5a28356f-4b44-5c8b-b9c7-4d02b2d94106"] :activity/first-step "step-6aa4a18d-6a7f-5ff6-bc60-411ff63cf5eb" :db/ensure [:activity/validate]} {:db/id "step-6aa4a18d-6a7f-5ff6-bc60-411ff63cf5eb" :step/id #uuid "6aa4a18d-6a7f-5ff6-bc60-411ff63cf5eb" :step/content 17592186370880 :step/next "step-147cc4dc-7dc1-5126-916a-8cec1032d28e" :db/ensure [:step/validate]} {:db/id "step-147cc4dc-7dc1-5126-916a-8cec1032d28e" :step/id #uuid "147cc4dc-7dc1-5126-916a-8cec1032d28e" :step/content 17592186198651 :step/next "step-6eabb3c1-2352-5d3f-adb7-054c0b5fbb20" :db/ensure [:step/validate]} {:db/id "step-6eabb3c1-2352-5d3f-adb7-054c0b5fbb20" :step/id #uuid "6eabb3c1-2352-5d3f-adb7-054c0b5fbb20" :step/content 17592186281676 :step/next "step-c726fa30-b86e-5568-af6e-dfea63974539" :db/ensure [:step/validate]} {:db/id "step-c726fa30-b86e-5568-af6e-dfea63974539" :step/id #uuid "c726fa30-b86e-5568-af6e-dfea63974539" :step/content 17592186281678 :step/next "step-5a28356f-4b44-5c8b-b9c7-4d02b2d94106" :db/ensure [:step/validate]} {:db/id "step-5a28356f-4b44-5c8b-b9c7-4d02b2d94106" :step/id #uuid "5a28356f-4b44-5c8b-b9c7-4d02b2d94106" :step/content 17592186198663 :db/ensure [:step/validate]} {:db/id 17592186157393 :knowledge-point/questions ["question-f6cddda8-c777-5283-b03a-3671533a782a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f6cddda8-c777-5283-b03a-3671533a782a" :question/id #uuid "f6cddda8-c777-5283-b03a-3671533a782a" :question/math-academy-id "q-131153" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[10-4{X}^{2}].$\n\n$$\nf(x)=\\frac{2}{{x}^{2}},\\,1<x<2\n$$" :question/worked-solution "First, we simplify using the properties of expected value:\n\n$$\n\\text{E}[10-4{X}^{2}]=10-4\\text{E}[{X}^{2}]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{x}^{2}\\cdot \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}2\\,\\text{d}x \\\\  & =2x\\,{|}_{1}^{2} \\\\  & =2\\end{aligned}\n$$\n\nSubstituting $\\text{E}[{X}^{2}]=2$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[10-4{X}^{2}] & =10-4\\text{E}[{X}^{2}] \\\\  & =10-4\\cdot 2 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-623ea09b-af47-50f2-9745-0713c7359869"] :db/ensure [:question/validate]} {:db/id "answer-field-623ea09b-af47-50f2-9745-0713c7359869" :answer-field/id #uuid "623ea09b-af47-50f2-9745-0713c7359869" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff85e4b7-ab02-503c-8793-d2b775c75049" :answer-field/choices ["answer-7a90c263-2858-513a-872f-0ae63784d35a" "answer-edf857b5-69b2-5c68-8336-4b0f3c36ec60" "answer-1cfd005b-75a8-5b0f-ba56-4a0ed93ab33a" "answer-ff85e4b7-ab02-503c-8793-d2b775c75049" "answer-22afcee8-e19d-562c-b205-332bc6a88919"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a90c263-2858-513a-872f-0ae63784d35a" :answer/id #uuid "7a90c263-2858-513a-872f-0ae63784d35a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-edf857b5-69b2-5c68-8336-4b0f3c36ec60" :answer/id #uuid "edf857b5-69b2-5c68-8336-4b0f3c36ec60" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-1cfd005b-75a8-5b0f-ba56-4a0ed93ab33a" :answer/id #uuid "1cfd005b-75a8-5b0f-ba56-4a0ed93ab33a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ff85e4b7-ab02-503c-8793-d2b775c75049" :answer/id #uuid "ff85e4b7-ab02-503c-8793-d2b775c75049" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-22afcee8-e19d-562c-b205-332bc6a88919" :answer/id #uuid "22afcee8-e19d-562c-b205-332bc6a88919" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186157606 :question/problem "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{3{x}^{2}+4}{5},\\,0<x<1\n$$\n\nGiven that $\\text{E}[X]=\\frac{11}{20},$ compute $\\text{E}[2X-{X}^{3}+1].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" :question/worked-solution "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\begin{aligned}\\text{E}[2X-{X}^{3}+1] & =2\\text{E}[X]-\\text{E}[{X}^{3}]+\\text{E}[1] \\\\  & =2\\text{E}[X]-\\text{E}[{X}^{3}]+1\\end{aligned}\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{0}^{1}{x}^{3}\\cdot (\\frac{3{x}^{2}+4}{5})\\text{d}x \\\\  & ={\\int }_{0}^{1}(\\frac{3}{5}{x}^{5}+\\frac{4}{5}{x}^{3})\\text{d}x \\\\  & ={(\\frac{1}{10}{x}^{6}+\\frac{1}{5}{x}^{4})|}_{0}^{1} \\\\  & =\\frac{1}{10}+\\frac{1}{5} \\\\  & =\\frac{3}{10}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=\\frac{11}{20}$ and $\\text{E}[{X}^{3}]=\\frac{3}{10}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[2X-{X}^{3}+1] & =2\\text{E}[X]-\\text{E}[{X}^{3}]+1 \\\\  & =2\\cdot \\frac{11}{20}-\\frac{3}{10}+1 \\\\  & =\\frac{11}{10}-\\frac{3}{10}+1 \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186153880 :answer-field/correct 17592186153883 :db/ensure [:answer-field/validate]} {:db/id 17592186157395 :knowledge-point/questions ["question-ac78b028-e0aa-5c92-b54a-b1ba1527a82f" "question-2317ff10-80a3-5747-858a-863cca47fbc9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ac78b028-e0aa-5c92-b54a-b1ba1527a82f" :question/id #uuid "ac78b028-e0aa-5c92-b54a-b1ba1527a82f" :question/math-academy-id "q-152915" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{4}(1-x),\\,-2\\le x\\le 0.\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{-2}^{0}{x}^{3}\\cdot \\frac{1}{4}(1-x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{-2}^{0}({x}^{3}-{x}^{4})\\text{d}x \\\\  & =\\frac{1}{4}(\\frac{1}{4}{x}^{4}-\\frac{1}{5}{x}^{5}){|}_{-2}^{0} \\\\  & =\\frac{1}{4}(0-[4+\\frac{32}{5}]) \\\\  & =\\frac{1}{4}(-\\frac{52}{5}) \\\\  & =-\\frac{13}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-63b35dd5-9730-5404-b881-f84b63c0e854"] :db/ensure [:question/validate]} {:db/id "answer-field-63b35dd5-9730-5404-b881-f84b63c0e854" :answer-field/id #uuid "63b35dd5-9730-5404-b881-f84b63c0e854" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7862d49-f18d-5362-98d3-095ce5b8964a" :answer-field/choices ["answer-8a5de172-0879-5846-8775-50301538400b" "answer-a7862d49-f18d-5362-98d3-095ce5b8964a" "answer-92a6058f-3718-55b4-83a2-afc873b42494" "answer-8c404e33-978f-5492-8afd-92388f08864c" "answer-85e8f87d-a86b-5e5a-9b4c-520af1d67778"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a5de172-0879-5846-8775-50301538400b" :answer/id #uuid "8a5de172-0879-5846-8775-50301538400b" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-a7862d49-f18d-5362-98d3-095ce5b8964a" :answer/id #uuid "a7862d49-f18d-5362-98d3-095ce5b8964a" :answer/type :answer.type/math :answer/value "-\\frac{13}{5}" :db/ensure [:answer/validate]} {:db/id "answer-92a6058f-3718-55b4-83a2-afc873b42494" :answer/id #uuid "92a6058f-3718-55b4-83a2-afc873b42494" :answer/type :answer.type/math :answer/value "-\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8c404e33-978f-5492-8afd-92388f08864c" :answer/id #uuid "8c404e33-978f-5492-8afd-92388f08864c" :answer/type :answer.type/math :answer/value "\\frac{11}{8}" :db/ensure [:answer/validate]} {:db/id "answer-85e8f87d-a86b-5e5a-9b4c-520af1d67778" :answer/id #uuid "85e8f87d-a86b-5e5a-9b4c-520af1d67778" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "question-2317ff10-80a3-5747-858a-863cca47fbc9" :question/id #uuid "2317ff10-80a3-5747-858a-863cca47fbc9" :question/math-academy-id "q-152922" :question/problem "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{4}, & 0\\le x<1 \\\\ \\frac{1}{{x}^{5}}, & x\\ge 1.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{3}].$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the third raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{3}] & ={\\int }_{0}^{\\infty }{x}^{3}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{3}\\cdot \\frac{3}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{3}\\cdot \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}{x}^{3}\\,\\text{d}x+{lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{16}\\,{x}^{4}\\,{|}_{0}^{1}+{lim}_{a\\to \\infty }(-\\frac{1}{x}){|}_{1}^{a} \\\\  & =\\frac{3}{16}(1-0)+{lim}_{a\\to \\infty }(1-\\frac{1}{a}) \\\\  & =\\frac{3}{16}+(1-0) \\\\  & =\\frac{19}{16}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-aded51f8-58f0-5888-884c-244971621142"] :db/ensure [:question/validate]} {:db/id "answer-field-aded51f8-58f0-5888-884c-244971621142" :answer-field/id #uuid "aded51f8-58f0-5888-884c-244971621142" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bedb09af-8e03-5cb2-a39f-8ac2f91ce3a8" :answer-field/choices ["answer-e89460a9-557b-5055-9a71-6a052e322419" "answer-7f3f6cb5-53fa-5af5-81d3-830801107641" "answer-bedb09af-8e03-5cb2-a39f-8ac2f91ce3a8" "answer-82d2a8f9-d415-5d71-a7d9-fe699cab072f" "answer-1370ffbd-2eab-5260-a0b4-0bf5d3cdb6db"] :db/ensure [:answer-field/validate]} {:db/id "answer-e89460a9-557b-5055-9a71-6a052e322419" :answer/id #uuid "e89460a9-557b-5055-9a71-6a052e322419" :answer/type :answer.type/math :answer/value "\\frac{11}{6}" :db/ensure [:answer/validate]} {:db/id "answer-7f3f6cb5-53fa-5af5-81d3-830801107641" :answer/id #uuid "7f3f6cb5-53fa-5af5-81d3-830801107641" :answer/type :answer.type/math :answer/value "\\frac{17}{9}" :db/ensure [:answer/validate]} {:db/id "answer-bedb09af-8e03-5cb2-a39f-8ac2f91ce3a8" :answer/id #uuid "bedb09af-8e03-5cb2-a39f-8ac2f91ce3a8" :answer/type :answer.type/math :answer/value "\\frac{19}{16}" :db/ensure [:answer/validate]} {:db/id "answer-82d2a8f9-d415-5d71-a7d9-fe699cab072f" :answer/id #uuid "82d2a8f9-d415-5d71-a7d9-fe699cab072f" :answer/type :answer.type/math :answer/value "\\frac{21}{25}" :db/ensure [:answer/validate]} {:db/id "answer-1370ffbd-2eab-5260-a0b4-0bf5d3cdb6db" :answer/id #uuid "1370ffbd-2eab-5260-a0b4-0bf5d3cdb6db" :answer/type :answer.type/math :answer/value "\\frac{9}{5}" :db/ensure [:answer/validate]} {:db/id "activity-f961c2fd-b375-5e2b-8cfd-ec028dc7aa0d" :activity/id #uuid "f961c2fd-b375-5e2b-8cfd-ec028dc7aa0d" :activity/title "Moments of Continuous Random Variables" :activity/type :activity.type/review :activity/scope 17592186048747 :activity/course 17592186046659 :activity/steps ["step-1ec8cc12-b2a4-5daf-96fd-1e378052ed2d" "step-46c499f6-0d50-5bd9-9f52-26ed8cb8ebb6" "step-473a0974-6e51-5843-94d7-0cf17d7cd776" "step-121da9a3-a27d-57e3-b7b6-52d9b4081634" "step-b0bf133b-cce4-5d5c-905a-ed7bcb9e9bdc"] :activity/first-step "step-1ec8cc12-b2a4-5daf-96fd-1e378052ed2d" :db/ensure [:activity/validate]} {:db/id "step-1ec8cc12-b2a4-5daf-96fd-1e378052ed2d" :step/id #uuid "1ec8cc12-b2a4-5daf-96fd-1e378052ed2d" :step/content 17592186427364 :step/next "step-46c499f6-0d50-5bd9-9f52-26ed8cb8ebb6" :db/ensure [:step/validate]} {:db/id "step-46c499f6-0d50-5bd9-9f52-26ed8cb8ebb6" :step/id #uuid "46c499f6-0d50-5bd9-9f52-26ed8cb8ebb6" :step/content "question-f6cddda8-c777-5283-b03a-3671533a782a" :step/next "step-473a0974-6e51-5843-94d7-0cf17d7cd776" :db/ensure [:step/validate]} {:db/id "step-473a0974-6e51-5843-94d7-0cf17d7cd776" :step/id #uuid "473a0974-6e51-5843-94d7-0cf17d7cd776" :step/content 17592186157606 :step/next "step-121da9a3-a27d-57e3-b7b6-52d9b4081634" :db/ensure [:step/validate]} {:db/id "step-121da9a3-a27d-57e3-b7b6-52d9b4081634" :step/id #uuid "121da9a3-a27d-57e3-b7b6-52d9b4081634" :step/content "question-ac78b028-e0aa-5c92-b54a-b1ba1527a82f" :step/next "step-b0bf133b-cce4-5d5c-905a-ed7bcb9e9bdc" :db/ensure [:step/validate]} {:db/id "step-b0bf133b-cce4-5d5c-905a-ed7bcb9e9bdc" :step/id #uuid "b0bf133b-cce4-5d5c-905a-ed7bcb9e9bdc" :step/content "question-2317ff10-80a3-5747-858a-863cca47fbc9" :db/ensure [:step/validate]} {:db/id 17592186064251 :knowledge-point/questions ["question-3e911702-eb82-5b97-88c2-1d3bfbe6d604" "question-b47ad43a-e012-58c2-b33a-c151f7cd3d62" "question-d295fd4d-8093-5953-9c94-5f7f1a143168"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064252 :knowledge-point/questions ["question-854b6ede-01ab-595a-a1e4-df6af7f40d5d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064253 :knowledge-point/questions ["question-518b39e3-bc07-5491-9032-d91dac622690" "question-30cea08b-c33e-58ec-a947-197b4401903e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e911702-eb82-5b97-88c2-1d3bfbe6d604" :question/id #uuid "3e911702-eb82-5b97-88c2-1d3bfbe6d604" :question/math-academy-id "q-342576" :question/problem "![](images/9b/9bb238610c8f58efb4e0d1c41de0cec2fe2406e0f29e465237560b73cdb3618f.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(0,0)$ and lies on $y=f(x).$ Given that $(0,0)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(0)?$\n\n$({f}^{-1})^{′}(0)=$\n{{field-1}}" :question/worked-solution "Since $(0,0)$ lies on ${f}^{-1},$ we have ${f}^{-1}(0)=0.$ \nThe slope of the tangent to $f(x)$ for $x\\in [-1,1]$ is $3$, hence, ${f}^{′}(0)=3.$\n\nThe formula for the derivative of the inverse function is \n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=0,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(0)} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d84637eb-2310-5af2-a7e5-b3d8297c7f31"] :db/ensure [:question/validate]} {:db/id "answer-field-d84637eb-2310-5af2-a7e5-b3d8297c7f31" :answer-field/id #uuid "d84637eb-2310-5af2-a7e5-b3d8297c7f31" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-001d2f3c-cc4f-5b57-bf9b-9dee9b9d3cae" :answer-field/choices ["answer-001d2f3c-cc4f-5b57-bf9b-9dee9b9d3cae"] :db/ensure [:answer-field/validate]} {:db/id "answer-001d2f3c-cc4f-5b57-bf9b-9dee9b9d3cae" :answer/id #uuid "001d2f3c-cc4f-5b57-bf9b-9dee9b9d3cae" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-b47ad43a-e012-58c2-b33a-c151f7cd3d62" :question/id #uuid "b47ad43a-e012-58c2-b33a-c151f7cd3d62" :question/math-academy-id "q-342577" :question/problem "![](images/37/37067c32385be4b652765062bbaf4e413ec87cec2ec6d0d01c6cd5dce64d7d9a.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(1,0)$ and lies on $y=f(x).$ Given that $(0,1)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(0)?$\n\n$({f}^{-1})^{′}(0)=$\n{{field-1}}" :question/worked-solution "Since $(0,1)$ lies on ${f}^{-1},$ we have ${f}^{-1}(0)=1.$ \nThe slope of the tangent to $f(x)$ for $x\\in [-1,3]$ is $\\frac{3}{2}$, hence, ${f}^{′}(1)=\\frac{3}{2}.$\n\nThe formula for the derivative of the inverse function is \n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=0,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{(\\frac{3}{2})} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-08cb8f7a-3eff-5e61-a8e7-a58164764082"] :db/ensure [:question/validate]} {:db/id "answer-field-08cb8f7a-3eff-5e61-a8e7-a58164764082" :answer-field/id #uuid "08cb8f7a-3eff-5e61-a8e7-a58164764082" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b155602a-a9af-5cac-9ef9-d26df365210e" :answer-field/choices ["answer-b155602a-a9af-5cac-9ef9-d26df365210e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b155602a-a9af-5cac-9ef9-d26df365210e" :answer/id #uuid "b155602a-a9af-5cac-9ef9-d26df365210e" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-d295fd4d-8093-5953-9c94-5f7f1a143168" :question/id #uuid "d295fd4d-8093-5953-9c94-5f7f1a143168" :question/math-academy-id "q-110128" :question/problem "![](images/89/89dee9fffb22501189ac9f972dc4bcf7e2ed3602ef000b8ef01f04ddccd2e2eb.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(3,3)$ and lies on $y=f(x).$ Given that $(3,3)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(3)?$" :question/worked-solution "Since $(3,3)$ lies on ${f}^{-1},$ we have ${f}^{-1}(3)=3.$\nThe slope of the tangent to $f(x)$ for $x\\in [0,6]$ is $\\frac{1}{3}$, hence, ${f}^{′}(3)=\\frac{1}{3}.$\n\nThe formula for the derivative of the inverse function is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=3,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(3) & =\\frac{1}{{f}^{′}({f}^{-1}(3))} \\\\  & =\\frac{1}{{f}^{′}(3)} \\\\  & =\\frac{1}{(\\frac{1}{3})} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-525e14af-3d5d-5768-99db-cfa31e6ebfe1"] :db/ensure [:question/validate]} {:db/id "answer-field-525e14af-3d5d-5768-99db-cfa31e6ebfe1" :answer-field/id #uuid "525e14af-3d5d-5768-99db-cfa31e6ebfe1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-246e1b2f-6c69-5623-8546-f8f0f3b9f05b" :answer-field/choices ["answer-8f02771c-0941-5ad8-b645-f5b0bd475cd9" "answer-b5ff3de9-2ac1-527c-8bea-2348693c73ac" "answer-246e1b2f-6c69-5623-8546-f8f0f3b9f05b" "answer-2bdc9d8e-a8b0-5a1f-a275-4f9721c494f3" "answer-3ebda5a4-ae46-5937-b31f-c78480be0131"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f02771c-0941-5ad8-b645-f5b0bd475cd9" :answer/id #uuid "8f02771c-0941-5ad8-b645-f5b0bd475cd9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-b5ff3de9-2ac1-527c-8bea-2348693c73ac" :answer/id #uuid "b5ff3de9-2ac1-527c-8bea-2348693c73ac" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-246e1b2f-6c69-5623-8546-f8f0f3b9f05b" :answer/id #uuid "246e1b2f-6c69-5623-8546-f8f0f3b9f05b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-2bdc9d8e-a8b0-5a1f-a275-4f9721c494f3" :answer/id #uuid "2bdc9d8e-a8b0-5a1f-a275-4f9721c494f3" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-3ebda5a4-ae46-5937-b31f-c78480be0131" :answer/id #uuid "3ebda5a4-ae46-5937-b31f-c78480be0131" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186233516 :question/problem "Consider the function $f(x)=3(x-2)^{3}$ and the point $P(3,3)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$  calculate ${({f}^{-1})}^{′}(3).$" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(3,3).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =3(x-2)^{3} \\\\ {f}^{′}(x) & =9(x-2)^{2} \\\\ {f}^{′}(3) & =9\\end{aligned}\\end{aligned}\n$$\n\nSince $(3,3)$ lies on $y=f(x),$ we know that the corresponding point $(3,3)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{′}(3) & =\\frac{1}{{f}^{′}({f}^{-1}(3))} \\\\  & =\\frac{1}{{f}^{′}(3)} \\\\  & =\\frac{1}{9}.\\end{aligned}\\end{aligned}\n$$" :question/answer-fields ["answer-field-3284a90b-68b7-5de8-b142-fabe6295ab56"] :db/ensure [:question/validate]} {:db/id "answer-field-3284a90b-68b7-5de8-b142-fabe6295ab56" :answer-field/id #uuid "3284a90b-68b7-5de8-b142-fabe6295ab56" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-676f26c7-4ab2-5836-869b-b435bda6478d" :answer-field/choices ["answer-29f4747e-8569-594d-9e01-6f95ff1bf175" "answer-ca6374d3-9008-519f-8e9e-84d5bbdcb086" "answer-c253d35f-d637-5a2e-867a-5eb95c510123" "answer-809ed5d0-fd32-504a-bc8a-1e2f04cef67d" "answer-676f26c7-4ab2-5836-869b-b435bda6478d"] :db/ensure [:answer-field/validate]} {:db/id "answer-29f4747e-8569-594d-9e01-6f95ff1bf175" :answer/id #uuid "29f4747e-8569-594d-9e01-6f95ff1bf175" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ca6374d3-9008-519f-8e9e-84d5bbdcb086" :answer/id #uuid "ca6374d3-9008-519f-8e9e-84d5bbdcb086" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-c253d35f-d637-5a2e-867a-5eb95c510123" :answer/id #uuid "c253d35f-d637-5a2e-867a-5eb95c510123" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-809ed5d0-fd32-504a-bc8a-1e2f04cef67d" :answer/id #uuid "809ed5d0-fd32-504a-bc8a-1e2f04cef67d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-676f26c7-4ab2-5836-869b-b435bda6478d" :answer/id #uuid "676f26c7-4ab2-5836-869b-b435bda6478d" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "question-854b6ede-01ab-595a-a1e4-df6af7f40d5d" :question/id #uuid "854b6ede-01ab-595a-a1e4-df6af7f40d5d" :question/math-academy-id "q-15649" :question/problem "Consider the function $f(x)=\\frac{5}{8}\\sqrt{x}$ and the point $P(4,\\frac{5}{4})$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ determine the slope of $y={f}^{-1}(x)$ at the point $(\\frac{5}{4},4).$" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(4,\\frac{5}{4}).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\frac{5}{8}\\sqrt{x} \\\\ {f}^{′}(x) & =\\frac{5}{16\\sqrt{x}} \\\\ {f}^{′}(4) & =\\frac{5}{32}\\end{aligned}\\end{aligned}\n$$\n\nSince $(4,\\frac{5}{4})$ lies on $y=f(x),$ we know that the corresponding point $(\\frac{5}{4},4)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}({f}^{-1})^{′}(\\frac{5}{4}) & =\\frac{1}{{f}^{′}({f}^{-1}(\\frac{5}{4}))} \\\\  & =\\frac{1}{{f}^{′}(4)} \\\\  & =\\frac{1}{(\\frac{5}{32})} \\\\  & =\\frac{32}{5}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8dff0b2-a40e-5488-9228-977e8100365b"] :db/ensure [:question/validate]} {:db/id "answer-field-b8dff0b2-a40e-5488-9228-977e8100365b" :answer-field/id #uuid "b8dff0b2-a40e-5488-9228-977e8100365b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-48f99d44-4d8f-5e63-a4f9-ad7e2a143699" :answer-field/choices ["answer-56a8ed7c-03cd-521a-bb2f-1546988bfe36" "answer-48f99d44-4d8f-5e63-a4f9-ad7e2a143699" "answer-4f3cc394-a51e-5e49-9984-a7ac06825005" "answer-742bbfa3-afc2-5d30-96a9-b323199b849c" "answer-7b4ebe60-62a8-5574-8302-183ff5c9dbe0"] :db/ensure [:answer-field/validate]} {:db/id "answer-56a8ed7c-03cd-521a-bb2f-1546988bfe36" :answer/id #uuid "56a8ed7c-03cd-521a-bb2f-1546988bfe36" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-48f99d44-4d8f-5e63-a4f9-ad7e2a143699" :answer/id #uuid "48f99d44-4d8f-5e63-a4f9-ad7e2a143699" :answer/type :answer.type/math :answer/value "\\frac{32}{5}" :db/ensure [:answer/validate]} {:db/id "answer-4f3cc394-a51e-5e49-9984-a7ac06825005" :answer/id #uuid "4f3cc394-a51e-5e49-9984-a7ac06825005" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-742bbfa3-afc2-5d30-96a9-b323199b849c" :answer/id #uuid "742bbfa3-afc2-5d30-96a9-b323199b849c" :answer/type :answer.type/math :answer/value "\\frac{5}{32}" :db/ensure [:answer/validate]} {:db/id "answer-7b4ebe60-62a8-5574-8302-183ff5c9dbe0" :answer/id #uuid "7b4ebe60-62a8-5574-8302-183ff5c9dbe0" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-518b39e3-bc07-5491-9032-d91dac622690" :question/id #uuid "518b39e3-bc07-5491-9032-d91dac622690" :question/math-academy-id "q-342595" :question/problem "Find ${(g\\cdot {f}^{-1})}^{′}(-1)$ of the product of functions, given the following table of values of $f(x),{f}^{′}(x),g(x),$ and ${g}^{′}(x)$ at some points.\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $2$ | $-3$ | $-2$ | $1$ |\n| $5$ | $-1$ | $1$ | $3$ | $-2$ |\n\n${(g\\cdot {f}^{-1})}^{′}(-1)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse ${f}^{-1}(x)$ is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nUsing this, and the product rule, the derivative of the function $g(x){f}^{-1}(x)$ is\n\n$$\n(g\\cdot {f}^{-1})^{′}(x)={g}^{′}(x){f}^{-1}(x)+\\frac{g(x)}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=-1,$ we have\n\n$$\n(g\\cdot {f}^{-1})^{′}(-1)={g}^{′}(-1){f}^{-1}(-1)+\\frac{g(-1)}{{f}^{′}({f}^{-1}(-1))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(-1)=5,$ $g(-1)=-2,$ ${g}^{′}(-1)=1,$ and ${f}^{′}(5)=1.$ Therefore,\n\n$$\n\\begin{aligned}(g\\cdot {f}^{-1})^{′}(-1) & ={g}^{′}(-1){f}^{-1}(-1)+\\frac{g(-1)}{{f}^{′}({f}^{-1}(-1))} \\\\  & =1\\cdot 5+\\frac{(-2)}{{f}^{′}(5)} \\\\  & =5+\\frac{(-2)}{1} \\\\  & =5+(-2) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f1b8081d-9962-5728-8702-fe7f036192b8"] :db/ensure [:question/validate]} {:db/id "answer-field-f1b8081d-9962-5728-8702-fe7f036192b8" :answer-field/id #uuid "f1b8081d-9962-5728-8702-fe7f036192b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b1b0ae75-6c13-58b5-926a-902471dc65c4" :answer-field/choices ["answer-b1b0ae75-6c13-58b5-926a-902471dc65c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1b0ae75-6c13-58b5-926a-902471dc65c4" :answer/id #uuid "b1b0ae75-6c13-58b5-926a-902471dc65c4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-30cea08b-c33e-58ec-a947-197b4401903e" :question/id #uuid "30cea08b-c33e-58ec-a947-197b4401903e" :question/math-academy-id "q-110287" :question/problem "The following table gives the values of $f(x),{f}^{′}(x),g(x),$ and ${g}^{′}(x)$ at some points. Find $({f}^{-1}\\cdot g)^{′}(3)$ of the product of functions.\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $3$ | $1$ | $-4$ | $-2$ | $5$ |\n| $-2$ | $3$ | $-6$ | $-1$ | $-4$ |" :question/worked-solution "The formula for the derivative of the inverse ${f}^{-1}(x)$ is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nUsing this, and the product rule, the derivative of the function ${f}^{-1}(x)g(x)$ is\n\n$$\n({f}^{-1}\\cdot g)^{′}(x)=\\frac{g(x)}{{f}^{′}({f}^{-1}(x))}+{g}^{′}(x){f}^{-1}(x).\n$$\n\nSubstituting $x=3,$ we have\n\n$$\n({f}^{-1}\\cdot g)^{′}(3)=\\frac{g(3)}{{f}^{′}({f}^{-1}(3))}+{g}^{′}(3){f}^{-1}(3).\n$$\n\nFrom the table, we obtain ${f}^{-1}(3)=-2,$ $g(3)=-2,$ ${g}^{′}(3)=5,$ and ${f}^{′}(-2)=-6.$ Therefore,\n\n$$\n\\begin{aligned}({f}^{-1}\\cdot g)^{′}(3) & =\\frac{g(3)}{{f}^{′}({f}^{-1}(3))}+{g}^{′}(3){f}^{-1}(3) \\\\  & =\\frac{-2}{{f}^{′}(-2)}+5\\cdot (-2) \\\\  & =\\frac{-2}{-6}-10 \\\\  & =-\\frac{29}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35a15c29-4f1a-540c-8233-d86ef79a3897"] :db/ensure [:question/validate]} {:db/id "answer-field-35a15c29-4f1a-540c-8233-d86ef79a3897" :answer-field/id #uuid "35a15c29-4f1a-540c-8233-d86ef79a3897" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f66e96d-6782-582b-91de-1a05ef13ce2d" :answer-field/choices ["answer-fdad0167-4721-5b03-9ba3-f3128bcdab9c" "answer-3f66e96d-6782-582b-91de-1a05ef13ce2d" "answer-a31f2089-914e-52b4-894d-cc7b35421de1" "answer-44e8533d-7dac-5ba2-978b-55318c3e93f5" "answer-59bfce54-2237-51cf-8a25-f36803b18cb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdad0167-4721-5b03-9ba3-f3128bcdab9c" :answer/id #uuid "fdad0167-4721-5b03-9ba3-f3128bcdab9c" :answer/type :answer.type/math :answer/value "-\\frac{19}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3f66e96d-6782-582b-91de-1a05ef13ce2d" :answer/id #uuid "3f66e96d-6782-582b-91de-1a05ef13ce2d" :answer/type :answer.type/math :answer/value "-\\frac{29}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a31f2089-914e-52b4-894d-cc7b35421de1" :answer/id #uuid "a31f2089-914e-52b4-894d-cc7b35421de1" :answer/type :answer.type/math :answer/value "-\\frac{29}{9}" :db/ensure [:answer/validate]} {:db/id "answer-44e8533d-7dac-5ba2-978b-55318c3e93f5" :answer/id #uuid "44e8533d-7dac-5ba2-978b-55318c3e93f5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-59bfce54-2237-51cf-8a25-f36803b18cb6" :answer/id #uuid "59bfce54-2237-51cf-8a25-f36803b18cb6" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id 17592186233131 :question/problem "The following table gives the values of functions $f(x)$ and ${f}^{′}(x)$ at some points. Find $({f}^{-1})^{′}(4).$\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ |\n| --- | --- | --- |\n| $-2$ | $1$ | $4$ |\n| $1$ | $4$ | $-2$ |" :question/worked-solution "The formula for the derivative of the inverse is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=4,$ we have\n\n$$\n({f}^{-1})^{′}(4)=\\frac{1}{{f}^{′}({f}^{-1}(4))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(4)=1$ and ${f}^{′}(1)=-2.$ Therefore,\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(4) & =\\frac{1}{{f}^{′}({f}^{-1}(4))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{(-2)} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/answer-fields ["answer-field-484e8ff3-0366-5801-ac8d-a4625e5b7f52"] :db/ensure [:question/validate]} {:db/id "answer-field-484e8ff3-0366-5801-ac8d-a4625e5b7f52" :answer-field/id #uuid "484e8ff3-0366-5801-ac8d-a4625e5b7f52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-837fbf4e-1f0c-58a0-b94d-a38789af2130" :answer-field/choices ["answer-3b099fca-24ea-5ced-85d0-937df56f7086" "answer-837fbf4e-1f0c-58a0-b94d-a38789af2130" "answer-61702aec-ec4f-5953-a964-c69981cc8775" "answer-99286d9a-1709-5463-8a09-24f3fc27d097" "answer-c72d93cc-719b-57d5-9e3f-2f31832fa402"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b099fca-24ea-5ced-85d0-937df56f7086" :answer/id #uuid "3b099fca-24ea-5ced-85d0-937df56f7086" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-837fbf4e-1f0c-58a0-b94d-a38789af2130" :answer/id #uuid "837fbf4e-1f0c-58a0-b94d-a38789af2130" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-61702aec-ec4f-5953-a964-c69981cc8775" :answer/id #uuid "61702aec-ec4f-5953-a964-c69981cc8775" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-99286d9a-1709-5463-8a09-24f3fc27d097" :answer/id #uuid "99286d9a-1709-5463-8a09-24f3fc27d097" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c72d93cc-719b-57d5-9e3f-2f31832fa402" :answer/id #uuid "c72d93cc-719b-57d5-9e3f-2f31832fa402" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id 17592186233133 :question/problem "Consider the function $f(x)=3x+\\sqrt{x}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(2).$" :question/worked-solution "To determine $({f}^{-1})^{′}(2),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(2)=\\frac{1}{{f}^{′}({f}^{-1}(2))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(2).$ To do this, we solve the equation ${f}^{-1}(2)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(2) & =x \\\\ f(x) & =2 \\\\ 3x+\\sqrt{x} & =2 \\\\ \\sqrt{x} & =2-3x \\\\ x & =4-12x+9{x}^{2} \\\\ 9{x}^{2}-13x+4 & =0 \\\\ (9x-4)(x-1) & =0 \\\\ x & =\\frac{4}{9},\\,1.\\end{aligned}\n$$\n\nChecking the solutions, we notice that only $x=\\frac{4}{9}$ satisfies the equation $3x+\\sqrt{x}=2.$ Therefore, we discard $x=1$ and conclude that ${f}^{-1}(2)=\\frac{4}{9}.$\n\nNow, we calculate ${f}^{′}(\\frac{4}{9}),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =3x+\\sqrt{x} \\\\ {f}^{′}(x) & =3+\\frac{1}{2\\sqrt{x}} \\\\ {f}^{′}(\\frac{4}{9}) & =3+\\frac{1}{2\\sqrt{(\\frac{4}{9})}} \\\\ {f}^{′}(\\frac{4}{9}) & =3+\\frac{3}{4} \\\\ {f}^{′}(\\frac{4}{9}) & =\\frac{15}{4}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(\\frac{4}{9})} \\\\  & =\\frac{4}{15}.\\end{aligned}\n$$" :question/answer-fields ["answer-field-2d842570-384d-5f9a-8934-5fc8f5ec2231"] :db/ensure [:question/validate]} {:db/id "answer-field-2d842570-384d-5f9a-8934-5fc8f5ec2231" :answer-field/id #uuid "2d842570-384d-5f9a-8934-5fc8f5ec2231" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84826b57-c122-587c-baf5-141a650be923" :answer-field/choices ["answer-1049ad2b-d3c5-598f-a813-b594700c836e" "answer-fbeb8da5-4868-5726-bf1c-39c8f81f6da3" "answer-85d2c120-3987-58fb-b1a8-1cdfdf73f75a" "answer-2b3ce2a3-15e3-5f28-8cd5-6e81df3d84f7" "answer-84826b57-c122-587c-baf5-141a650be923"] :db/ensure [:answer-field/validate]} {:db/id "answer-1049ad2b-d3c5-598f-a813-b594700c836e" :answer/id #uuid "1049ad2b-d3c5-598f-a813-b594700c836e" :answer/type :answer.type/math :answer/value "-\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-fbeb8da5-4868-5726-bf1c-39c8f81f6da3" :answer/id #uuid "fbeb8da5-4868-5726-bf1c-39c8f81f6da3" :answer/type :answer.type/math :answer/value "-\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-85d2c120-3987-58fb-b1a8-1cdfdf73f75a" :answer/id #uuid "85d2c120-3987-58fb-b1a8-1cdfdf73f75a" :answer/type :answer.type/math :answer/value "\\frac{15}{4}" :db/ensure [:answer/validate]} {:db/id "answer-2b3ce2a3-15e3-5f28-8cd5-6e81df3d84f7" :answer/id #uuid "2b3ce2a3-15e3-5f28-8cd5-6e81df3d84f7" :answer/type :answer.type/math :answer/value "\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "answer-84826b57-c122-587c-baf5-141a650be923" :answer/id #uuid "84826b57-c122-587c-baf5-141a650be923" :answer/type :answer.type/math :answer/value "\\frac{4}{15}" :db/ensure [:answer/validate]} {:db/id 17592186065447 :tutorial/content "Consider the following function: \n\n$$\nf(x)= 4x^2+x, \\qquad x \\gt 0\n$$\n\nThe domain restriction $x > 0$ means that $f$ is invertible on its entire domain. \n\nThe point $P$ with coordinates $(2,18)$ lies on the curve $y = f(x).$ This means that the point $P'$ with coordinates $(18,2)$ lies on the curve of the inverse function $y=f^{-1}(x),$ as shown below.\n\n![](images/3e/3e16e532743be547c766e5a6a47bae8933a8dedb2b6d0fa0d60d47cc0b37ba04.png)\n\nHow do we find $\\dfrac{\\textrm d y}{\\textrm d x}$ at the point $P'?$\n\nFor this, we will use the fact that the slope of the tangent to the curve $y=f^{-1}(x)$ at $P'$ is the *reciprocal* of the slope of the tangent to the curve $y=f(x)$ at $P.$\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{{P}^{′}}=\\frac{1}{({\\frac{\\text{d}y}{\\text{d}x}|}_{P})}\\end{aligned}\n$$\n\nCalculating $\\dfrac{\\textrm d y}{\\textrm d x}$ at $P$ is straightforward. First, we differentiate $y=f(x).$ This gives\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x}  = 8x + 1,\n$$\n\nand then plugging in $x=2$ gives\n\n$$\n\\left.\\dfrac{\\textrm{d}y}{\\textrm{d}x}\\right|_P = 8(2)+1 = 17.\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\left.\\dfrac{\\textrm{d}y}{\\textrm{d}x}\\right|_{P'}= \\dfrac{1}{17}\n$$\n\nWe can summarize this process using the following formula:\n\n$$\n\\left(f^{-1}\\right)'(x) = \\dfrac{1}{f'(f^{-1}(x))}\n$$\n\nTo help remember this formula, note that it's okay to swap the derivative symbol (the prime) with the inverse symbol (the exponent of $-1$) as long as we take the reciprocal afterward." :db/ensure [:tutorial/validate]} {:db/id 17592186065448 :tutorial/content "The following table gives the values of functions $f(x)$ and $f'(x)$ at some points. \n\n| **$x$** | $f(x)$ | $f'(x)$ |\n| --- | --- | --- |\n| $1$ | $2$ | $3$ |\n| $2$ | $1$ | $12$ |\n\nLet's use this data to find $(f^{-1})'(1).$ \n\nRecall that the formula for the derivative of the inverse is\n\n$$\n(f^{-1})'(x) = \\dfrac{1}{f'(f^{-1}(x))}.\n$$\n\nSubstituting $x=1,$ we have\n\n$$\n(f^{-1})'(1) = \\dfrac{1}{f'(f^{-1}(1))}.\n$$\n\nFrom the table, we see that $f(2)=1$, hence $f^{-1}(1)=2$, and also $f'(2)=12$. Therefore\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(2)} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$\n\nWe can also use the rule for calculating derivatives of inverse functions in conjunction with other rules of differentiation. Let's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186064396 :activity/expected-seconds 1140.0 :db/ensure [:activity/validate]} {:db/id 17592186152299 :knowledge-point/questions ["question-db6984e3-bfbe-5e15-a092-ee9588e31df7" "question-bcde543e-81aa-57ea-886b-66ee35330ede"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151820 :question/problem "Evaluate $-7 + 3.1 - 5.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}-7+3.1-5 & = \\\\ (-7+3.1)-5 & = \\\\ -\\,3.9-5 & = \\\\ -8.9\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186152300 :knowledge-point/questions ["question-cafba121-70b2-571d-a218-1d3bb9b3e4ea" "question-35969ec8-7388-5a9c-af50-84fbe5444368"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151821 :question/problem "What is the value of $2 \\div 6 \\times (-5)?$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}2÷6\\times (-5) & = \\\\ (2÷6)\\times (-5) & = \\\\ \\frac{2}{6}\\times (-5) & = \\\\ \\frac{1}{3}\\times (-5) & = \\\\ \\frac{1}{3}\\times \\frac{(-5)}{1} & = \\\\ \\frac{1\\times (-5)}{3\\times 1} & = \\\\ -\\frac{5}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186152301 :knowledge-point/questions ["question-32e41319-b064-5c4a-91f7-13675a0d7fcb" "question-720361bc-07a5-589b-85d2-04870e7c2310"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151822 :question/problem "Evaluate $-2 + 6 \\div (-10).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}-2+6÷(-10) & = \\\\ -2+(6÷(-10)) & = \\\\ -2+(-0.6)\\end{aligned}\n$$\n\nFinally, we add:\n\n$$\n\\begin{aligned}-2+(-0.6) & =-2.6\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186152302 :knowledge-point/questions ["question-16c2fdd2-5848-54fb-8203-57bceb610cf0" "question-0d504829-eef7-5492-8d82-0cc4f8d13b08"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151823 :question/problem "What is the value of $\\left( -3 + 6 \\right) \\div \\dfrac{4}{3} - \\dfrac{1}{4}?$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-3+6)÷\\frac{4}{3}-\\frac{1}{4} & = \\\\ 3÷\\frac{4}{3}-\\frac{1}{4}\\end{aligned}\n$$\n\nNext, we divide:\n\n$$\n\\begin{aligned}3÷\\frac{4}{3}-\\frac{1}{4} & = \\\\ (3÷\\frac{4}{3})-\\frac{1}{4} & = \\\\ (\\frac{3}{1}÷\\frac{4}{3})-\\frac{1}{4} & = \\\\ (\\frac{3}{1}\\times \\frac{3}{4})-\\frac{1}{4} & = \\\\ \\frac{3\\times 3}{1\\times 4}-\\frac{1}{4} & = \\\\ \\frac{9}{4}-\\frac{1}{4}\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}\\frac{9}{4}-\\frac{1}{4} & = \\\\ \\frac{9-1}{4} & = \\\\ \\frac{8}{4} & = \\\\ 8÷4 & = \\\\ 2\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-db6984e3-bfbe-5e15-a092-ee9588e31df7" :question/id #uuid "db6984e3-bfbe-5e15-a092-ee9588e31df7" :question/math-academy-id "q-175940" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{1}{4}+3-\\frac{5}{8}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{1}{4}+3-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+3)-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+\\frac{12}{4})-\\frac{5}{8} & = \\\\ \\frac{1+12}{4}-\\frac{5}{8} & = \\\\ \\frac{13}{4}-\\frac{5}{8} & = \\\\ \\frac{26}{8}-\\frac{5}{8} & = \\\\ \\frac{26-5}{8} & = \\\\ \\frac{21}{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-64409c9a-b082-5202-877a-44cfa2b215a2"] :db/ensure [:question/validate]} {:db/id "answer-field-64409c9a-b082-5202-877a-44cfa2b215a2" :answer-field/id #uuid "64409c9a-b082-5202-877a-44cfa2b215a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e65ebf46-2f69-57b1-97a2-8a7627364272" :answer-field/choices ["answer-e65ebf46-2f69-57b1-97a2-8a7627364272"] :db/ensure [:answer-field/validate]} {:db/id "answer-e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/id #uuid "e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/type :answer.type/math :answer/value "\\frac{21}{8}" :db/ensure [:answer/validate]} {:db/id "question-bcde543e-81aa-57ea-886b-66ee35330ede" :question/id #uuid "bcde543e-81aa-57ea-886b-66ee35330ede" :question/math-academy-id "q-99811" :question/problem "$\\frac{4}{3}+5-\\frac{7}{6}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{4}{3}+5-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+5)-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+\\frac{15}{3})-\\frac{7}{6} & = \\\\ \\frac{4+15}{3}-\\frac{7}{6} & = \\\\ \\frac{19}{3}-\\frac{7}{6} & = \\\\ \\frac{38}{6}-\\frac{7}{6} & = \\\\ \\frac{38-7}{6} & = \\\\ \\frac{31}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94188954-378c-51e7-898f-7f8bdd2e70ae"] :db/ensure [:question/validate]} {:db/id "answer-field-94188954-378c-51e7-898f-7f8bdd2e70ae" :answer-field/id #uuid "94188954-378c-51e7-898f-7f8bdd2e70ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer-field/choices ["answer-7c97b078-eb82-558a-830c-8ca790a11d1d" "answer-9186da31-0d26-59a2-89cc-724bd81bef84" "answer-e3491aad-f540-5d63-b808-205276445ed8" "answer-d12d2174-597b-55c5-9f3a-9dd7d9e8014f" "answer-4dbc7d01-1ba7-5cfe-8510-01783b2399ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c97b078-eb82-558a-830c-8ca790a11d1d" :answer/id #uuid "7c97b078-eb82-558a-830c-8ca790a11d1d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-9186da31-0d26-59a2-89cc-724bd81bef84" :answer/id #uuid "9186da31-0d26-59a2-89cc-724bd81bef84" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-e3491aad-f540-5d63-b808-205276445ed8" :answer/id #uuid "e3491aad-f540-5d63-b808-205276445ed8" :answer/type :answer.type/math :answer/value "\\frac{13}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d12d2174-597b-55c5-9f3a-9dd7d9e8014f" :answer/id #uuid "d12d2174-597b-55c5-9f3a-9dd7d9e8014f" :answer/type :answer.type/math :answer/value "\\frac{29}{6}" :db/ensure [:answer/validate]} {:db/id "answer-4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer/id #uuid "4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer/type :answer.type/math :answer/value "\\frac{31}{6}" :db/ensure [:answer/validate]} {:db/id "question-cafba121-70b2-571d-a218-1d3bb9b3e4ea" :question/id #uuid "cafba121-70b2-571d-a218-1d3bb9b3e4ea" :question/math-academy-id "q-175955" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{3}{7}÷\\frac{2}{5}\\times 7=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}\\frac{3}{7}÷\\frac{2}{5}\\times 7 & = \\\\ (\\frac{3}{7}÷\\frac{2}{5})\\times 7 & = \\\\ (\\frac{3}{7}\\times \\frac{5}{2})\\times 7 & = \\\\ \\frac{3\\times 5}{7\\times 2}\\times 7 & = \\\\ \\frac{15}{14}\\times 7 & = \\\\ \\frac{15}{14}\\times \\frac{7}{1} & = \\\\ \\frac{15\\times 7}{14\\times 1} & = \\\\ \\frac{105}{14} & = \\\\ \\frac{15}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-89a1c7b6-5a65-5b4e-bfb7-cbbcc3b7d3f6"] :db/ensure [:question/validate]} {:db/id "answer-field-89a1c7b6-5a65-5b4e-bfb7-cbbcc3b7d3f6" :answer-field/id #uuid "89a1c7b6-5a65-5b4e-bfb7-cbbcc3b7d3f6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer-field/choices ["answer-9b403c69-74fe-5349-aefb-9cb442a9a6e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/id #uuid "9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "question-35969ec8-7388-5a9c-af50-84fbe5444368" :question/id #uuid "35969ec8-7388-5a9c-af50-84fbe5444368" :question/math-academy-id "q-75812" :question/problem "$\\frac{7}{2}\\times 3÷\\frac{1}{4}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}\\frac{7}{2}\\times 3÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times 3)÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times \\frac{3}{1})÷\\frac{1}{4} & = \\\\ \\frac{7\\times 3}{2\\times 1}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}\\times \\frac{4}{1} & = \\\\ \\frac{21\\times 4}{2\\times 1} & = \\\\ \\frac{84}{2} & = \\\\ 42\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6483320d-efd6-5033-ac44-8b3c7ef96b4a"] :db/ensure [:question/validate]} {:db/id "answer-field-6483320d-efd6-5033-ac44-8b3c7ef96b4a" :answer-field/id #uuid "6483320d-efd6-5033-ac44-8b3c7ef96b4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer-field/choices ["answer-6edf906e-43f0-5d16-aa0d-11200a173867" "answer-7bd7035f-0535-5d1b-baf7-fe650baf14c6" "answer-f1cde2af-e93f-51ce-b249-b3c8098d9356" "answer-3b07c6de-b540-57b6-96a7-08b3703af820" "answer-654dcaef-b3ac-5aa3-a431-ca34193d3cdc"] :db/ensure [:answer-field/validate]} {:db/id "answer-6edf906e-43f0-5d16-aa0d-11200a173867" :answer/id #uuid "6edf906e-43f0-5d16-aa0d-11200a173867" :answer/type :answer.type/math :answer/value "-42" :db/ensure [:answer/validate]} {:db/id "answer-7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/id #uuid "7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "answer-f1cde2af-e93f-51ce-b249-b3c8098d9356" :answer/id #uuid "f1cde2af-e93f-51ce-b249-b3c8098d9356" :answer/type :answer.type/math :answer/value "\\frac{11}{4}" :db/ensure [:answer/validate]} {:db/id "answer-3b07c6de-b540-57b6-96a7-08b3703af820" :answer/id #uuid "3b07c6de-b540-57b6-96a7-08b3703af820" :answer/type :answer.type/math :answer/value "\\frac{21}{2}" :db/ensure [:answer/validate]} {:db/id "answer-654dcaef-b3ac-5aa3-a431-ca34193d3cdc" :answer/id #uuid "654dcaef-b3ac-5aa3-a431-ca34193d3cdc" :answer/type :answer.type/math :answer/value "\\frac{2}{21}" :db/ensure [:answer/validate]} {:db/id "question-32e41319-b064-5c4a-91f7-13675a0d7fcb" :question/id #uuid "32e41319-b064-5c4a-91f7-13675a0d7fcb" :question/math-academy-id "q-174388" :question/problem "Expressed as a fraction in lowest terms, $\\frac{4}{3}÷2-\\frac{1}{3}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}\\frac{4}{3}÷2-\\frac{1}{3} & = \\\\ (\\frac{4}{3}÷\\frac{2}{1})-\\frac{1}{3} & = \\\\ (\\frac{4}{3}\\times \\frac{1}{2})-\\frac{1}{3} & = \\\\ (\\frac{4\\times 1}{3\\times 2})-\\frac{1}{3} & = \\\\ \\frac{4}{6}-\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}\\frac{4}{6}-\\frac{1}{3} & = \\\\ \\frac{2}{3}-\\frac{1}{3} & = \\\\ \\frac{2-1}{3} & = \\\\ \\frac{1}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-af98e227-3993-52d7-9ae5-2d273b174754"] :db/ensure [:question/validate]} {:db/id "answer-field-af98e227-3993-52d7-9ae5-2d273b174754" :answer-field/id #uuid "af98e227-3993-52d7-9ae5-2d273b174754" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer-field/choices ["answer-dcc6f5fd-050d-5fbb-88f7-e841559dfb66"] :db/ensure [:answer-field/validate]} {:db/id "answer-dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/id #uuid "dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-720361bc-07a5-589b-85d2-04870e7c2310" :question/id #uuid "720361bc-07a5-589b-85d2-04870e7c2310" :question/math-academy-id "q-176386" :question/problem "Expressed as an integer, $8÷(-\\frac{4}{5})-3=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}8÷(-\\frac{4}{5})-3 & = \\\\ (8÷(-\\frac{4}{5}))-3 & = \\\\ (\\frac{8}{1}\\times (-\\frac{5}{4}))-3 & = \\\\ -\\frac{8\\times 5}{1\\times 4}-3 & = \\\\ -\\frac{40}{4}-3 & = \\\\ -10-3\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}-10-3 & =-13\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a6b9cf49-c2bb-5ce4-941d-b3540c075320"] :db/ensure [:question/validate]} {:db/id "answer-field-a6b9cf49-c2bb-5ce4-941d-b3540c075320" :answer-field/id #uuid "a6b9cf49-c2bb-5ce4-941d-b3540c075320" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer-field/choices ["answer-d396ebfa-2351-59b3-9a9a-85e9a027b858"] :db/ensure [:answer-field/validate]} {:db/id "answer-d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/id #uuid "d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/type :answer.type/math :answer/value "-13" :db/ensure [:answer/validate]} {:db/id "question-16c2fdd2-5848-54fb-8203-57bceb610cf0" :question/id #uuid "16c2fdd2-5848-54fb-8203-57bceb610cf0" :question/math-academy-id "q-175317" :question/problem "$(0.6+2)÷2=${{field-1}}" :question/worked-solution "First, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(0.6+2)÷2 & = \\\\ 2.6÷2\\end{aligned}\n$$\n\nFinally, we multiply and divide, from left to right:\n\n$$\n\\begin{aligned}2.6÷2 & =1.3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07818ad5-3003-5a61-89f8-d143f34c577f"] :db/ensure [:question/validate]} {:db/id "answer-field-07818ad5-3003-5a61-89f8-d143f34c577f" :answer-field/id #uuid "07818ad5-3003-5a61-89f8-d143f34c577f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer-field/choices ["answer-f0ce97a1-5e79-58a4-9cd7-c578898dcd66"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/id #uuid "f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/type :answer.type/math :answer/value "1.3" :db/ensure [:answer/validate]} {:db/id "question-0d504829-eef7-5492-8d82-0cc4f8d13b08" :question/id #uuid "0d504829-eef7-5492-8d82-0cc4f8d13b08" :question/math-academy-id "q-176475" :question/problem "Expressed as a fraction in lowest terms, $\\frac{5}{2}÷(7+5)=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷(7+5) & = \\\\ \\frac{5}{2}÷12\\end{aligned}\n$$\n\nFinally, we divide:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷12 & = \\\\ \\frac{5}{2}÷\\frac{12}{1} & = \\\\ \\frac{5}{2}\\times \\frac{1}{12} & = \\\\ \\frac{5\\times 1}{2\\times 12} & = \\\\ \\frac{5}{24}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-78bc0c44-a6c7-5cb4-b731-9e72f7a43817"] :db/ensure [:question/validate]} {:db/id "answer-field-78bc0c44-a6c7-5cb4-b731-9e72f7a43817" :answer-field/id #uuid "78bc0c44-a6c7-5cb4-b731-9e72f7a43817" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-287b8b8b-a357-530b-a29a-b4409ba9867a" :answer-field/choices ["answer-287b8b8b-a357-530b-a29a-b4409ba9867a"] :db/ensure [:answer-field/validate]} {:db/id "answer-287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/id #uuid "287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/type :answer.type/math :answer/value "\\frac{5}{24}" :db/ensure [:answer/validate]} {:db/id 17592186153435 :tutorial/content "As we already know, to evaluate numerical expressions with a mix of different operations, we must follow the order of operations known as PEMDAS.\n\nThe same rules apply to numerical expressions with negative numbers. For example, let's compute the value of\n\n$$\n\\left( -5 + 7 \\right) \\div (-2) \\times 6.\n$$\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-5+7)÷(-2)\\times 6 & = \\\\ 2÷(-2)\\times 6\\end{aligned}\n$$\n\nNow recall that if both multiplication and division appear in an expression, we complete each operation from left to right (similarly for addition and subtraction).\nSo, we first divide:\n\n$$\n\\begin{aligned}2÷(-2)\\times 6 & = \\\\ -1\\times 6\\end{aligned}\n$$\n\nThen finally, we multiply:\n\n$$\n\\begin{aligned}-1\\times 6 & =-6\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186152316 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186192781 :knowledge-point/questions ["question-5d0c1517-fefb-518c-9505-969066e0bce6" "question-ada9b840-b530-5081-8048-c09da4df32f8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5d0c1517-fefb-518c-9505-969066e0bce6" :question/id #uuid "5d0c1517-fefb-518c-9505-969066e0bce6" :question/math-academy-id "q-110601" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:4x+5y-z=0\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}=1\\}$\n\nIII. $C=\\{0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $4x+5y-z=0$ since $4\\cdot 0+5\\cdot 0-0=0.$ So $0$ lies in $A.$\n\n- The set $B$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $C$ is a subspace. This subset has only one element, the zero vector $0=⟨0,0,0⟩,$ which is a special subspace of ${R}^{3}.$\n\nIn conclusion, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fc384e98-6294-5707-b8e0-2ed99c0215ec"] :db/ensure [:question/validate]} {:db/id "answer-field-fc384e98-6294-5707-b8e0-2ed99c0215ec" :answer-field/id #uuid "fc384e98-6294-5707-b8e0-2ed99c0215ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-65dcc751-70ac-5835-895f-9afe1c6981be" :answer-field/choices ["answer-65dcc751-70ac-5835-895f-9afe1c6981be" "answer-5f082dfc-3b85-5a93-bc09-af1e742628ea" "answer-db8d4f50-3033-5b61-9824-d94717ad9840" "answer-9290ba2f-84e6-50ba-bd20-50955e2e64ec" "answer-44c0119a-d6a0-5768-b521-97fbdb1b4a38"] :db/ensure [:answer-field/validate]} {:db/id "answer-65dcc751-70ac-5835-895f-9afe1c6981be" :answer/id #uuid "65dcc751-70ac-5835-895f-9afe1c6981be" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-5f082dfc-3b85-5a93-bc09-af1e742628ea" :answer/id #uuid "5f082dfc-3b85-5a93-bc09-af1e742628ea" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-db8d4f50-3033-5b61-9824-d94717ad9840" :answer/id #uuid "db8d4f50-3033-5b61-9824-d94717ad9840" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9290ba2f-84e6-50ba-bd20-50955e2e64ec" :answer/id #uuid "9290ba2f-84e6-50ba-bd20-50955e2e64ec" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-44c0119a-d6a0-5768-b521-97fbdb1b4a38" :answer/id #uuid "44c0119a-d6a0-5768-b521-97fbdb1b4a38" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-ada9b840-b530-5081-8048-c09da4df32f8" :question/id #uuid "ada9b840-b530-5081-8048-c09da4df32f8" :question/math-academy-id "q-110606" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nI. $A=\\{⟨x,y⟩\\in {R}^{2}:{x}^{2}+{y}^{2}=0\\}$\n\nII. $B=\\{⟨x,y⟩\\in {R}^{2}:3x+4y=1\\}$\n\nIII. $C=\\{⟨x,y⟩\\in {R}^{2}:x+3y=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ consists only of the vector $⟨0,0⟩$, which is a special (trivial) subspace of ${R}^{2}.$\n\n- The set $B$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0⟩$ does not satisfy the equation $3x+4y=1$ since $3\\cdot 0+4\\cdot 0\\ne 1.$\n\n- The set $C$ is a subspace. It also represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x+3y=0$ since $0+3\\cdot 0=0.$ So, $0$ lies in $C.$\n\nSo, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8c014ca5-93c9-54e8-95bc-87d740d016c0"] :db/ensure [:question/validate]} {:db/id "answer-field-8c014ca5-93c9-54e8-95bc-87d740d016c0" :answer-field/id #uuid "8c014ca5-93c9-54e8-95bc-87d740d016c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e2e434bd-13dd-5cf1-bb32-448ac1fcc0c3" :answer-field/choices ["answer-c3271208-f908-5d5d-adf8-766e9fc2f767" "answer-e2e434bd-13dd-5cf1-bb32-448ac1fcc0c3" "answer-154b8691-57de-5b5e-86f8-c31acc6d30e6" "answer-759885ae-9ef9-5c93-ab20-c1fe824077c5" "answer-62d73fd1-aa7f-5ec7-8f6d-743894ccf613"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3271208-f908-5d5d-adf8-766e9fc2f767" :answer/id #uuid "c3271208-f908-5d5d-adf8-766e9fc2f767" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e2e434bd-13dd-5cf1-bb32-448ac1fcc0c3" :answer/id #uuid "e2e434bd-13dd-5cf1-bb32-448ac1fcc0c3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-154b8691-57de-5b5e-86f8-c31acc6d30e6" :answer/id #uuid "154b8691-57de-5b5e-86f8-c31acc6d30e6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-759885ae-9ef9-5c93-ab20-c1fe824077c5" :answer/id #uuid "759885ae-9ef9-5c93-ab20-c1fe824077c5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-62d73fd1-aa7f-5ec7-8f6d-743894ccf613" :answer/id #uuid "62d73fd1-aa7f-5ec7-8f6d-743894ccf613" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id 17592186054838 :knowledge-point/questions ["question-1113da48-16db-5f6c-b647-7ec659a2ab4d" "question-c4c3b101-24b5-5159-855c-3722311747de"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054393 :question/problem "Evaluate $11p-2$ for $p=4.$" :question/worked-solution "Replacing $p$ with $\\color{blue}4$ in the expression, we get\n\n$$\n\\eqalign{\n\t\t11p-2 &= \\\n\t\t11({\\color{blue}4})-2 &= \\\n\t \t44-2 &= \\\n\t \t42 .\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054839 :knowledge-point/questions ["question-2175ddd7-b5c7-5bcd-b639-d4f01939487a" "question-a26bf3d9-e722-517d-a584-8e9fe07e450e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054424 :question/problem "Evaluate $2-\\dfrac{u}{4}$ for $u=\\dfrac43.$" :question/worked-solution "Replacing $u$ with $\\dfrac43$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{u}{4} & = \\\\ 2-\\frac{1}{4}u & = \\\\ 2-\\frac{1}{4}\\cdot \\frac{4}{3} & = \\\\ 2-\\frac{4}{12} & = \\\\ 2-\\frac{1}{3} & = \\\\ \\frac{6-1}{3} & = \\\\ \\frac{5}{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054840 :knowledge-point/questions ["question-9a5e0230-7894-51f3-afd6-6cc279d87228" "question-3ba0af4d-b531-5e58-b782-4b7a32460438"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054394 :question/problem "Evaluate $2(3 x-1) +2$ for $x=-3.$" :question/worked-solution "We replace $x$ with $-3$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}2(3x-1)+2 & = \\\\ 2(3\\cdot (-3)-1)+2 & = \\\\ 2(-9-1)+2 & = \\\\ 2(-10)+2 & = \\\\ -20+2 & = \\\\ -18\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054841 :knowledge-point/questions ["question-c819591b-7976-59a4-815e-5b13c1691fd5" "question-1eb0410f-52e0-5fe3-aa6d-2cf67e29e0a3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054395 :question/problem "Find the value of $x - \\dfrac{3}{2}y$ when $x=2$ and $y=-2.$" :question/worked-solution "Replacing $x$ with $2$ and $y$ with $-2$ in the expression, we get\n\n$$\n\\begin{aligned}x-\\frac{3}{2}y & = \\\\ 2-\\frac{3}{2}\\cdot (-2) & = \\\\ 2+(-\\frac{3}{2})\\cdot (-2) & = \\\\ 2+3 & = \\\\ 5.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-1113da48-16db-5f6c-b647-7ec659a2ab4d" :question/id #uuid "1113da48-16db-5f6c-b647-7ec659a2ab4d" :question/math-academy-id "q-186019" :question/problem "If $w=-6,$ then $-4w-15=$" :question/worked-solution "Replacing $w$ with $-6$ in the expression, we get\n\n$$\n\\begin{aligned}-4w-15 & = \\\\ -4(-6)-15 & = \\\\ 24-15 & = \\\\ 9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3538e5cf-6fb8-5a5e-a234-cabbb29eccf2"] :db/ensure [:question/validate]} {:db/id "answer-field-3538e5cf-6fb8-5a5e-a234-c