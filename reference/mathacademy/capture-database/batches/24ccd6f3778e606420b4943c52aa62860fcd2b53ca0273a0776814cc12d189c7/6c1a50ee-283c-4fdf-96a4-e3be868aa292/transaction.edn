ae3-52fc-ad0d-4b47a0b7914e" :answer-field/choices ["answer-b747ba62-bae3-52fc-ad0d-4b47a0b7914e" "answer-021593cc-5b62-54fd-ad2a-d326a2e3d10e" "answer-81c17bdd-3b38-50e3-a332-41ace43f5f79" "answer-1978069a-0cc3-5fab-aad0-1010c770c88c" "answer-10eb6ad1-4aa4-5b6e-898f-580577f64448"] :db/ensure [:answer-field/validate]} {:db/id "answer-b747ba62-bae3-52fc-ad0d-4b47a0b7914e" :answer/id #uuid "b747ba62-bae3-52fc-ad0d-4b47a0b7914e" :answer/type :answer.type/text :answer/value "$s⊥t$ and $w⊥t$" :db/ensure [:answer/validate]} {:db/id "answer-021593cc-5b62-54fd-ad2a-d326a2e3d10e" :answer/id #uuid "021593cc-5b62-54fd-ad2a-d326a2e3d10e" :answer/type :answer.type/text :answer/value "$s⊥w$ and $u⊥v$" :db/ensure [:answer/validate]} {:db/id "answer-81c17bdd-3b38-50e3-a332-41ace43f5f79" :answer/id #uuid "81c17bdd-3b38-50e3-a332-41ace43f5f79" :answer/type :answer.type/text :answer/value "$u⊥t$ and $u⊥w$" :db/ensure [:answer/validate]} {:db/id "answer-1978069a-0cc3-5fab-aad0-1010c770c88c" :answer/id #uuid "1978069a-0cc3-5fab-aad0-1010c770c88c" :answer/type :answer.type/text :answer/value "$u⊥t$ and $v⊥t$" :db/ensure [:answer/validate]} {:db/id "answer-10eb6ad1-4aa4-5b6e-898f-580577f64448" :answer/id #uuid "10eb6ad1-4aa4-5b6e-898f-580577f64448" :answer/type :answer.type/text :answer/value "$v⊥t$ and $v⊥w$" :db/ensure [:answer/validate]} {:db/id "question-b26db26d-7241-5602-a20a-a5953a1b2569" :question/id #uuid "b26db26d-7241-5602-a20a-a5953a1b2569" :question/math-academy-id "q-151162" :question/problem "![](images/49/495da285b0971f050ad2baa2031ef27a9d9fd719078f535559cb2795057516de.png)\n\nIn the figure above, find the perpendicular sides." :question/worked-solution "Two lines are perpendicular if they intersect and form a ${90}^{∘}$ angle.\n\nFirst, notice that the lines $\\overset{⟷}{PQ}$ and  $\\overset{⟷}{TP}$ are perpendicular.\n\n![](images/db/db4497b62f456afacd78221d68a76200d18dedcfd1e3e7b73f64847e39a55ae9.png)\n\nTherefore, we conclude that the sides $\\overset{―}{TP}$ and $\\overset{―}{PQ}$ are perpendicular. We can write this as follows: \n\n$$\n\\overset{―}{TP}⊥\\overset{―}{PQ}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f3d617a6-eddf-5ce1-9bc2-1a0a23e70cdf"] :db/ensure [:question/validate]} {:db/id "answer-field-f3d617a6-eddf-5ce1-9bc2-1a0a23e70cdf" :answer-field/id #uuid "f3d617a6-eddf-5ce1-9bc2-1a0a23e70cdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3a4993c1-7ce8-53eb-81eb-3f96aa79fa2b" :answer-field/choices ["answer-5d532c81-f440-5d55-8b5a-e9ff28e29b3c" "answer-eab4fa28-96d6-562e-8dcd-9d5152bd03df" "answer-23cf0cfe-7dc5-5836-a44f-5d124e0e733b" "answer-6d6da40f-0814-57e4-ba05-35b8718b3cca" "answer-3a4993c1-7ce8-53eb-81eb-3f96aa79fa2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d532c81-f440-5d55-8b5a-e9ff28e29b3c" :answer/id #uuid "5d532c81-f440-5d55-8b5a-e9ff28e29b3c" :answer/type :answer.type/math :answer/value "\\overset{―}{PQ}⊥\\overset{―}{QR}" :db/ensure [:answer/validate]} {:db/id "answer-eab4fa28-96d6-562e-8dcd-9d5152bd03df" :answer/id #uuid "eab4fa28-96d6-562e-8dcd-9d5152bd03df" :answer/type :answer.type/math :answer/value "\\overset{―}{QR}⊥\\overset{―}{RS}" :db/ensure [:answer/validate]} {:db/id "answer-23cf0cfe-7dc5-5836-a44f-5d124e0e733b" :answer/id #uuid "23cf0cfe-7dc5-5836-a44f-5d124e0e733b" :answer/type :answer.type/math :answer/value "\\overset{―}{RS}⊥\\overset{―}{ST}" :db/ensure [:answer/validate]} {:db/id "answer-6d6da40f-0814-57e4-ba05-35b8718b3cca" :answer/id #uuid "6d6da40f-0814-57e4-ba05-35b8718b3cca" :answer/type :answer.type/math :answer/value "\\overset{―}{ST}⊥\\overset{―}{TP}" :db/ensure [:answer/validate]} {:db/id "answer-3a4993c1-7ce8-53eb-81eb-3f96aa79fa2b" :answer/id #uuid "3a4993c1-7ce8-53eb-81eb-3f96aa79fa2b" :answer/type :answer.type/math :answer/value "\\overset{―}{TP}⊥\\overset{―}{PQ}" :db/ensure [:answer/validate]} {:db/id "question-2d6731a9-4b1d-5a58-8690-9d08ea615462" :question/id #uuid "2d6731a9-4b1d-5a58-8690-9d08ea615462" :question/math-academy-id "q-153412" :question/problem "![](images/e8/e8caa8e283c60d845c4b8fbe2c352818d300b51748f37b9788eac0bf1e73b7d5.png)\n\nIn the figure above, find the perpendicular sides." :question/worked-solution "Two lines are perpendicular if they intersect and form a ${90}^{∘}$ angle.\n\nFirst, notice that we have two sets of perpendicular lines:\n\n- $\\overset{⟷}{PU}$ is perpendicular to $\\overset{⟷}{PQ}$\n\n- $\\overset{⟷}{RS}$ is perpendicular to $\\overset{⟷}{ST}$\n\n![](images/24/2492594432bf29b2753d646c53b66ffd6230c21db71c4dd12479c9811217dc91.png)\n\nTherefore, we conclude that the sides $\\overset{―}{UP}$ and $\\overset{―}{PQ}$ are perpendicular, and $\\overset{―}{RS}$ and $\\overset{―}{ST}$ are also perpendicular. We can write this as follows:\n\n$\\,$ $\\overset{―}{UP}⊥\\overset{―}{PQ}$ and $\\overset{―}{RS}⊥\\overset{―}{ST}$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-59678b0c-54a4-5936-9c40-9493ba3f94b8"] :db/ensure [:question/validate]} {:db/id "answer-field-59678b0c-54a4-5936-9c40-9493ba3f94b8" :answer-field/id #uuid "59678b0c-54a4-5936-9c40-9493ba3f94b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d284ab2c-0ba3-561d-9483-739740f7bed6" :answer-field/choices ["answer-7dfd0425-445a-521f-bbc6-60a718f71b38" "answer-4671dac0-bbb0-5fa6-8601-b114c50e020d" "answer-d284ab2c-0ba3-561d-9483-739740f7bed6" "answer-2e0ee358-b0b8-5e46-96cd-100c7ec69c8f" "answer-5e68d63c-4d7e-5d45-8b8a-6533113be391"] :db/ensure [:answer-field/validate]} {:db/id "answer-7dfd0425-445a-521f-bbc6-60a718f71b38" :answer/id #uuid "7dfd0425-445a-521f-bbc6-60a718f71b38" :answer/type :answer.type/math :answer/value "\\overset{―}{QR}⊥\\overset{―}{TU}" :db/ensure [:answer/validate]} {:db/id "answer-4671dac0-bbb0-5fa6-8601-b114c50e020d" :answer/id #uuid "4671dac0-bbb0-5fa6-8601-b114c50e020d" :answer/type :answer.type/math :answer/value "\\overset{―}{UP}⊥\\overset{―}{ST}" :db/ensure [:answer/validate]} {:db/id "answer-d284ab2c-0ba3-561d-9483-739740f7bed6" :answer/id #uuid "d284ab2c-0ba3-561d-9483-739740f7bed6" :answer/type :answer.type/text :answer/value "$\\overset{―}{UP}⊥\\overset{―}{PQ}$ and $\\overset{―}{RS}⊥\\overset{―}{ST}$" :db/ensure [:answer/validate]} {:db/id "answer-2e0ee358-b0b8-5e46-96cd-100c7ec69c8f" :answer/id #uuid "2e0ee358-b0b8-5e46-96cd-100c7ec69c8f" :answer/type :answer.type/text :answer/value "$\\overset{―}{UP}⊥\\overset{―}{ST}$ and $\\overset{―}{PQ}⊥\\overset{―}{RS}$" :db/ensure [:answer/validate]} {:db/id "answer-5e68d63c-4d7e-5d45-8b8a-6533113be391" :answer/id #uuid "5e68d63c-4d7e-5d45-8b8a-6533113be391" :answer/type :answer.type/text :answer/value "$\\overset{―}{UP}⊥\\overset{―}{TU}$ and $\\overset{―}{ST}⊥\\overset{―}{TU}$" :db/ensure [:answer/validate]} {:db/id "question-e371cbf5-7ac9-5e8f-8f0f-f99fbc339fe5" :question/id #uuid "e371cbf5-7ac9-5e8f-8f0f-f99fbc339fe5" :question/math-academy-id "q-151165" :question/problem "![](images/d8/d8af8bd4c928216d30d6ee1764139a86af1f7ac2ce6a01d9b98cb081a60ed322.png)\n\nIn the figure above, find the perpendicular sides." :question/worked-solution "Two lines are perpendicular if they intersect and form a ${90}^{∘}$ angle.\n\nFirst, notice that we have two sets of perpendicular lines:\n\n- $\\overset{⟷}{AB}$ is perpendicular to $\\overset{⟷}{BC}$\n\n- $\\overset{⟷}{EA}$ is perpendicular to $\\overset{⟷}{AB}$\n\n![](images/90/90902346a26d5120e13c3df8e841e4fb57c6006b6e6a4390e30c6ae41f18630c.png)\n\nTherefore, we conclude that the sides $\\overset{―}{AB}$ and $\\overset{―}{BC}$ are perpendicular, and $\\overset{―}{EA}$ and $\\overset{―}{AB}$ are also perpendicular. We can write this as follows:\n\n$\\,$ $\\overset{―}{AB}⊥\\overset{―}{BC}$ and $\\overset{―}{EA}⊥\\overset{―}{AB}$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2cf52e37-e958-5b9e-aa5c-c3f361c160d4"] :db/ensure [:question/validate]} {:db/id "answer-field-2cf52e37-e958-5b9e-aa5c-c3f361c160d4" :answer-field/id #uuid "2cf52e37-e958-5b9e-aa5c-c3f361c160d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-92b220ec-ab36-5303-867c-2023a3a49d8e" :answer-field/choices ["answer-7eaac881-6525-556f-82dd-de41419834cb" "answer-92b220ec-ab36-5303-867c-2023a3a49d8e" "answer-2782a24d-8b70-594d-a3e2-40b88ce399c9" "answer-dcb05faf-6f92-5199-afe8-e8b4f268b3c1" "answer-48a38541-7d87-5134-8faa-e39193caae2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-7eaac881-6525-556f-82dd-de41419834cb" :answer/id #uuid "7eaac881-6525-556f-82dd-de41419834cb" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}⊥\\overset{―}{BC}$ and $\\overset{―}{CD}⊥\\overset{―}{DE}$" :db/ensure [:answer/validate]} {:db/id "answer-92b220ec-ab36-5303-867c-2023a3a49d8e" :answer/id #uuid "92b220ec-ab36-5303-867c-2023a3a49d8e" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}⊥\\overset{―}{BC}$ and $\\overset{―}{EA}⊥\\overset{―}{AB}$" :db/ensure [:answer/validate]} {:db/id "answer-2782a24d-8b70-594d-a3e2-40b88ce399c9" :answer/id #uuid "2782a24d-8b70-594d-a3e2-40b88ce399c9" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}⊥\\overset{―}{BC}$ only" :db/ensure [:answer/validate]} {:db/id "answer-dcb05faf-6f92-5199-afe8-e8b4f268b3c1" :answer/id #uuid "dcb05faf-6f92-5199-afe8-e8b4f268b3c1" :answer/type :answer.type/text :answer/value "$\\overset{―}{CD}⊥\\overset{―}{DE}$ and $\\overset{―}{EA}⊥\\overset{―}{BC}$" :db/ensure [:answer/validate]} {:db/id "answer-48a38541-7d87-5134-8faa-e39193caae2f" :answer/id #uuid "48a38541-7d87-5134-8faa-e39193caae2f" :answer/type :answer.type/text :answer/value "$\\overset{―}{EA}⊥\\overset{―}{BC}$ only" :db/ensure [:answer/validate]} {:db/id "question-86e173f6-09d0-539e-96a4-71b8b3120bde" :question/id #uuid "86e173f6-09d0-539e-96a4-71b8b3120bde" :question/math-academy-id "q-151168" :question/problem "![](images/94/940a6996800ee85745643b34e429bb1fa85064bbab94f52bed328b074024fd22.png)\n\nIn the figure above, find the perpendicular sides." :question/worked-solution "Two lines are perpendicular if they intersect and form a ${90}^{∘}$ angle.\n\nFirst, notice that the lines $\\overset{⟷}{EA}$ and  $\\overset{⟷}{AB}$ are perpendicular.\n\n![](images/81/81e84f9f6f3f50f6a5ef3f39381ebce028ccb52fa09b2d7042c9206a7027f337.png)\n\nTherefore, we conclude that the sides $\\overset{―}{EA}$ and $\\overset{―}{AB}$ are perpendicular. We can write this as follows: \n\n$$\n\\overset{―}{EA}⊥\\overset{―}{AB}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-79fc7f2b-e719-5054-8889-ff44ef6ee389"] :db/ensure [:question/validate]} {:db/id "answer-field-79fc7f2b-e719-5054-8889-ff44ef6ee389" :answer-field/id #uuid "79fc7f2b-e719-5054-8889-ff44ef6ee389" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-993dffec-f344-562c-9543-75e12d63d4ad" :answer-field/choices ["answer-1496590e-8d8f-5d52-8d67-d80702f65915" "answer-3666f51b-e46e-5a23-87fe-edf8c54ce722" "answer-87065749-1c12-5e85-b694-24f021f5c717" "answer-ff7cc857-32ab-5009-be38-e82260418916" "answer-993dffec-f344-562c-9543-75e12d63d4ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-1496590e-8d8f-5d52-8d67-d80702f65915" :answer/id #uuid "1496590e-8d8f-5d52-8d67-d80702f65915" :answer/type :answer.type/math :answer/value "\\overset{―}{AB}⊥\\overset{―}{BC}" :db/ensure [:answer/validate]} {:db/id "answer-3666f51b-e46e-5a23-87fe-edf8c54ce722" :answer/id #uuid "3666f51b-e46e-5a23-87fe-edf8c54ce722" :answer/type :answer.type/math :answer/value "\\overset{―}{BC}⊥\\overset{―}{CD}" :db/ensure [:answer/validate]} {:db/id "answer-87065749-1c12-5e85-b694-24f021f5c717" :answer/id #uuid "87065749-1c12-5e85-b694-24f021f5c717" :answer/type :answer.type/math :answer/value "\\overset{―}{CD}⊥\\overset{―}{DE}" :db/ensure [:answer/validate]} {:db/id "answer-ff7cc857-32ab-5009-be38-e82260418916" :answer/id #uuid "ff7cc857-32ab-5009-be38-e82260418916" :answer/type :answer.type/math :answer/value "\\overset{―}{DE}⊥\\overset{―}{EA}" :db/ensure [:answer/validate]} {:db/id "answer-993dffec-f344-562c-9543-75e12d63d4ad" :answer/id #uuid "993dffec-f344-562c-9543-75e12d63d4ad" :answer/type :answer.type/math :answer/value "\\overset{―}{EA}⊥\\overset{―}{AB}" :db/ensure [:answer/validate]} {:db/id "question-f045e30a-5c77-5aee-853f-bedc4016f900" :question/id #uuid "f045e30a-5c77-5aee-853f-bedc4016f900" :question/math-academy-id "q-153499" :question/problem "![](images/86/8666a8c28b50deb88fc9e7cca3951b9d5fab9d8d07ede6abac774f41271324b5.png)\n\nIn the figure above, find the parallel sides." :question/worked-solution "Two lines are parallel if they never intersect.\n\nNow, let's examine the direction of the sides in the figure to determine whether any pair lies along parallel lines.\n\nNotice that the sides $\\overset{―}{AB}$ and $\\overset{―}{DE}$ both lie along horizontal lines. The remaining sides have different directions, so they do not form any additional pair of parallel sides.\n\n![](images/7f/7f55b88378fe0e9389ea7a540cc40a02c9e619854a6815e9700b808770fa3a13.png)\n\nTherefore, we conclude that the sides $\\overset{―}{AB}$ and $\\overset{―}{DE}$ are parallel. We can write this as follows: \n\n$$\n\\overset{―}{AB}∥\\overset{―}{DE}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7cac5234-5bf9-5934-97a2-7bc5d83dd335"] :db/ensure [:question/validate]} {:db/id "answer-field-7cac5234-5bf9-5934-97a2-7bc5d83dd335" :answer-field/id #uuid "7cac5234-5bf9-5934-97a2-7bc5d83dd335" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-909d07a1-afb4-57a2-865a-03a683a8786a" :answer-field/choices ["answer-909d07a1-afb4-57a2-865a-03a683a8786a" "answer-cd97c790-1250-5a1f-a5ed-85bd9459bebf" "answer-ae0d3f4d-19fd-5dd8-857e-f6af7fd31107" "answer-6b74390b-09b9-593c-82b7-d426444631b0" "answer-7a66f47b-ac85-551b-a97a-3186d113774e"] :db/ensure [:answer-field/validate]} {:db/id "answer-909d07a1-afb4-57a2-865a-03a683a8786a" :answer/id #uuid "909d07a1-afb4-57a2-865a-03a683a8786a" :answer/type :answer.type/math :answer/value "\\overset{―}{AB}∥\\overset{―}{DE}" :db/ensure [:answer/validate]} {:db/id "answer-cd97c790-1250-5a1f-a5ed-85bd9459bebf" :answer/id #uuid "cd97c790-1250-5a1f-a5ed-85bd9459bebf" :answer/type :answer.type/math :answer/value "\\overset{―}{AE}∥\\overset{―}{BC}" :db/ensure [:answer/validate]} {:db/id "answer-ae0d3f4d-19fd-5dd8-857e-f6af7fd31107" :answer/id #uuid "ae0d3f4d-19fd-5dd8-857e-f6af7fd31107" :answer/type :answer.type/math :answer/value "\\overset{―}{BC}∥\\overset{―}{CD}" :db/ensure [:answer/validate]} {:db/id "answer-6b74390b-09b9-593c-82b7-d426444631b0" :answer/id #uuid "6b74390b-09b9-593c-82b7-d426444631b0" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}∥\\overset{―}{DE}$ and $\\overset{―}{AE}∥\\overset{―}{BC}$" :db/ensure [:answer/validate]} {:db/id "answer-7a66f47b-ac85-551b-a97a-3186d113774e" :answer/id #uuid "7a66f47b-ac85-551b-a97a-3186d113774e" :answer/type :answer.type/text :answer/value "None of the sides are parallel" :db/ensure [:answer/validate]} {:db/id 17592186193812 :tutorial/content "Two lines are **parallel** if they never meet. So, for example, the lines $r$ and $s$ below are parallel. \n\n![](images/d9/d9bcd3cb4e201292afd4c3dca68273f16cff43d76c5a6a2f80348f5d8db1bd4c.png)\n\nIf two lines are parallel, we can express this using the $\\parallel$ symbol as follows:\n\n$$\nr \\parallel s\n$$\n\nIn words, we say, \"the line $r$ is parallel to the line $s.$\"\n\nIf two lines are not parallel, they must have a common point. In this case, we say that the lines **intersect**.\n\nFor example, the lines $v$ and $w$ below intersect at the point $P{:}$\n\n![](images/a6/a659c4a23e60880656c4fea0ec8e6ca63e0d9e55704fdb53b5bdf1a6e30b89e3.png)\n\nWe have the following important property about lines in two-dimensional space.\n\n*Any two distinct lines are either parallel or intersect at exactly one point.*" :db/ensure [:tutorial/validate]} {:db/id 17592186193847 :tutorial/content "Two lines are **perpendicular** if they intersect and form a $90^\\circ$ angle. \n\nFor example, the lines $r$ and $s$ below are perpendicular.\n\n![](images/73/73d2e836e942d6e468c8d9652921a9321b842d47b54ba59529123da61a9a96b4.png)\n\nWhen two lines are perpendicular, we can express this with the symbol $\\perp,$ as follows:\n\n$$\nr \\perp s\n$$\n\nIn words, we say, \"the line $r$ is perpendicular to the line $s$.\"" :db/ensure [:tutorial/validate]} {:db/id 17592186192890 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186122666 :answer-field/choices 17592186122667] [:db/retract 17592186122666 :answer-field/choices 17592186122668] [:db/retract 17592186122666 :answer-field/choices 17592186122669] [:db/retract 17592186122666 :answer-field/choices 17592186122670] [:db/retract 17592186122666 :answer-field/choices 17592186122671] [:db/retract 17592186404129 :answer-field/choices 17592186404130] [:db/retract 17592186404129 :answer-field/choices 17592186404131] [:db/retract 17592186404129 :answer-field/choices 17592186404132] [:db/retract 17592186404129 :answer-field/choices 17592186404133] [:db/retract 17592186404129 :answer-field/choices 17592186404134] {:db/id 17592186124522 :knowledge-point/questions ["question-a82c548a-99d5-5982-b67f-c8bf62fc70fb" "question-bca3e3e8-22f6-5c69-8cd2-18d06e6e998f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124571 :knowledge-point/questions ["question-d00c6bd7-a884-5180-8cfd-0ffa34fc590f" "question-243cda6a-277e-5555-a0d1-a4b1a66521e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a82c548a-99d5-5982-b67f-c8bf62fc70fb" :question/id #uuid "a82c548a-99d5-5982-b67f-c8bf62fc70fb" :question/math-academy-id "q-37357" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}-40 & 6 & 30 \\\\ 0 & -10 & 0 \\\\ -80 & 14 & 60\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-40-\\lambda  & 6 & 30 \\\\ 0 & -10-\\lambda  & 0 \\\\ -80 & 14 & 60-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $2$nd row, we obtain the following:  \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-40-\\lambda  & 6 & 30 \\\\ 0 & -10-\\lambda  & 0 \\\\ -80 & 14 & 60-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )|\\begin{aligned}-40-\\lambda  & 30 \\\\ -80 & 60-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )((-40-\\lambda )(60-\\lambda )-(30)(-80)) & =0 \\\\ (-10-\\lambda )({\\lambda }^{2}-20\\lambda ) & =0 \\\\ (\\lambda +10)(\\lambda )(\\lambda -20) & =0 \\\\ \\lambda (\\lambda +10)(\\lambda -20) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b4136c8d-5a3d-54a3-8e0e-9880d33a4256"] :db/ensure [:question/validate]} {:db/id "answer-field-b4136c8d-5a3d-54a3-8e0e-9880d33a4256" :answer-field/id #uuid "b4136c8d-5a3d-54a3-8e0e-9880d33a4256" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-527cb312-c6a6-5a5d-9bcf-61787139c3d4" :answer-field/choices ["answer-6561688f-0f5b-5532-a636-4e1b1e285d0d" "answer-d221a7d6-bd60-5f61-a4eb-8f48bc286186" "answer-beaaed4b-e3bf-59ab-9162-b63b3f77485b" "answer-527cb312-c6a6-5a5d-9bcf-61787139c3d4" "answer-6e034595-10dd-5a5a-8870-372a9c9d5b27"] :db/ensure [:answer-field/validate]} {:db/id "answer-6561688f-0f5b-5532-a636-4e1b1e285d0d" :answer/id #uuid "6561688f-0f5b-5532-a636-4e1b1e285d0d" :answer/type :answer.type/math :answer/value "(\\lambda +40)(\\lambda -6)(\\lambda -30)=0" :db/ensure [:answer/validate]} {:db/id "answer-d221a7d6-bd60-5f61-a4eb-8f48bc286186" :answer/id #uuid "d221a7d6-bd60-5f61-a4eb-8f48bc286186" :answer/type :answer.type/math :answer/value "(\\lambda +80)(\\lambda -14)(\\lambda -60)=0" :db/ensure [:answer/validate]} {:db/id "answer-beaaed4b-e3bf-59ab-9162-b63b3f77485b" :answer/id #uuid "beaaed4b-e3bf-59ab-9162-b63b3f77485b" :answer/type :answer.type/math :answer/value "(\\lambda -10)(\\lambda +1)(\\lambda +20)=0" :db/ensure [:answer/validate]} {:db/id "answer-527cb312-c6a6-5a5d-9bcf-61787139c3d4" :answer/id #uuid "527cb312-c6a6-5a5d-9bcf-61787139c3d4" :answer/type :answer.type/math :answer/value "\\lambda (\\lambda +10)(\\lambda -20)=0" :db/ensure [:answer/validate]} {:db/id "answer-6e034595-10dd-5a5a-8870-372a9c9d5b27" :answer/id #uuid "6e034595-10dd-5a5a-8870-372a9c9d5b27" :answer/type :answer.type/math :answer/value "{\\lambda }^{2}(\\lambda +10)=0" :db/ensure [:answer/validate]} {:db/id "question-bca3e3e8-22f6-5c69-8cd2-18d06e6e998f" :question/id #uuid "bca3e3e8-22f6-5c69-8cd2-18d06e6e998f" :question/math-academy-id "q-80553" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$B=[\\begin{aligned}-3 & 0 & -3 \\\\ 0 & -4 & -2 \\\\ 0 & 0 & 5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-3-\\lambda  & 0 & -3 \\\\ 0 & -4-\\lambda  & -2 \\\\ 0 & 0 & 5-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-3-\\lambda  & 0 & -3 \\\\ 0 & -4-\\lambda  & -2 \\\\ 0 & 0 & 5-\\lambda \\end{aligned}| & =0 \\\\ (-3-\\lambda )(-4-\\lambda )(5-\\lambda ) & =0 \\\\ (\\lambda +3)(\\lambda +4)(\\lambda -5) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=-3,$ $\\,{\\lambda }_{2}=-4,$ and ${\\lambda }_{3}=5.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are always the entries on the main diagonal." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b75011bd-dfba-5826-af46-a8b32028e02b"] :db/ensure [:question/validate]} {:db/id "answer-field-b75011bd-dfba-5826-af46-a8b32028e02b" :answer-field/id #uuid "b75011bd-dfba-5826-af46-a8b32028e02b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d939250-f6e6-5ac0-9745-e9c2d7ddd5e4" :answer-field/choices ["answer-c32cb1b1-29a5-5579-8622-98540b8194df" "answer-8d939250-f6e6-5ac0-9745-e9c2d7ddd5e4" "answer-81325892-1923-5229-ade2-a096f5c023d6" "answer-978f7fe8-15da-52c6-ba65-b60baa2efb75" "answer-0dd806b5-b00a-5419-b12d-acd06881a066"] :db/ensure [:answer-field/validate]} {:db/id "answer-c32cb1b1-29a5-5579-8622-98540b8194df" :answer/id #uuid "c32cb1b1-29a5-5579-8622-98540b8194df" :answer/type :answer.type/math :answer/value "\\lambda \\in \\{-3,-2,5\\}" :db/ensure [:answer/validate]} {:db/id "answer-8d939250-f6e6-5ac0-9745-e9c2d7ddd5e4" :answer/id #uuid "8d939250-f6e6-5ac0-9745-e9c2d7ddd5e4" :answer/type :answer.type/math :answer/value "\\lambda \\in \\{-3,-4,5\\}" :db/ensure [:answer/validate]} {:db/id "answer-81325892-1923-5229-ade2-a096f5c023d6" :answer/id #uuid "81325892-1923-5229-ade2-a096f5c023d6" :answer/type :answer.type/math :answer/value "\\lambda \\in \\{-3,0,3\\}" :db/ensure [:answer/validate]} {:db/id "answer-978f7fe8-15da-52c6-ba65-b60baa2efb75" :answer/id #uuid "978f7fe8-15da-52c6-ba65-b60baa2efb75" :answer/type :answer.type/math :answer/value "\\lambda \\in \\{0,-4,-2\\}" :db/ensure [:answer/validate]} {:db/id "answer-0dd806b5-b00a-5419-b12d-acd06881a066" :answer/id #uuid "0dd806b5-b00a-5419-b12d-acd06881a066" :answer/type :answer.type/math :answer/value "\\lambda \\in \\{3,4,-5\\}" :db/ensure [:answer/validate]} {:db/id "question-d00c6bd7-a884-5180-8cfd-0ffa34fc590f" :question/id #uuid "d00c6bd7-a884-5180-8cfd-0ffa34fc590f" :question/math-academy-id "q-86751" :question/problem "Find the characteristic equation of the matrix \n$E=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 5 & -2 & 0 & 0 \\\\ -1 & 1 & 7 & 0 \\\\ 2 & 1 & 4 & 2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,E-\\lambda I:$\n﻿﻿﻿\n\n$$\nE-\\lambda I=[\\begin{aligned}1-\\lambda  & 0 & 0 & 0 \\\\ 5 & -2-\\lambda  & 0 & 0 \\\\ -1 & 1 & 7-\\lambda  & 0 \\\\ 2 & 1 & 4 & 2-\\lambda \\end{aligned}].\n$$\n\nThe characteristic equation is $det(E-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(E-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 0 & 0 & 0 \\\\ 5 & -2-\\lambda  & 0 & 0 \\\\ -1 & 1 & 7-\\lambda  & 0 \\\\ 2 & 1 & 4 & 2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-2-\\lambda )(7-\\lambda )(2-\\lambda ) & =0 \\\\ (\\lambda -1)(\\lambda +2)(\\lambda -7)(\\lambda -2) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-506939ed-7e7a-58fe-a23e-568138385abc"] :db/ensure [:question/validate]} {:db/id "answer-field-506939ed-7e7a-58fe-a23e-568138385abc" :answer-field/id #uuid "506939ed-7e7a-58fe-a23e-568138385abc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d612d7a1-320d-5230-8d43-429cf1f224b7" :answer-field/choices ["answer-7638f82e-310a-5356-96a6-5573794cce10" "answer-d612d7a1-320d-5230-8d43-429cf1f224b7" "answer-09eda0ec-8e1b-5e11-a68f-03dfb4b379e2" "answer-f3ff7a34-01f9-5d59-a7ea-85ad5c394bee" "answer-e44519c4-103d-5ede-bc2f-bccaf86b7bee"] :db/ensure [:answer-field/validate]} {:db/id "answer-7638f82e-310a-5356-96a6-5573794cce10" :answer/id #uuid "7638f82e-310a-5356-96a6-5573794cce10" :answer/type :answer.type/math :answer/value "(\\lambda +1)(\\lambda -2)(\\lambda +7)(\\lambda +2)=0" :db/ensure [:answer/validate]} {:db/id "answer-d612d7a1-320d-5230-8d43-429cf1f224b7" :answer/id #uuid "d612d7a1-320d-5230-8d43-429cf1f224b7" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda +2)(\\lambda -7)(\\lambda -2)=0" :db/ensure [:answer/validate]} {:db/id "answer-09eda0ec-8e1b-5e11-a68f-03dfb4b379e2" :answer/id #uuid "09eda0ec-8e1b-5e11-a68f-03dfb4b379e2" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda +2)(\\lambda -7)=0" :db/ensure [:answer/validate]} {:db/id "answer-f3ff7a34-01f9-5d59-a7ea-85ad5c394bee" :answer/id #uuid "f3ff7a34-01f9-5d59-a7ea-85ad5c394bee" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda +2)^{2}(\\lambda -7)=0" :db/ensure [:answer/validate]} {:db/id "answer-e44519c4-103d-5ede-bc2f-bccaf86b7bee" :answer/id #uuid "e44519c4-103d-5ede-bc2f-bccaf86b7bee" :answer/type :answer.type/math :answer/value "(\\lambda -1)(\\lambda -2)^{2}(\\lambda -7)=0" :db/ensure [:answer/validate]} {:db/id 17592186125011 :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}2 & 5 & 4 & 2 \\\\ 0 & -1 & 5 & 1 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}2-\\lambda  & 5 & 4 & 2 \\\\ 0 & -1-\\lambda  & 5 & 1 \\\\ 0 & 0 & 5-\\lambda  & 1 \\\\ 0 & 0 & 0 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 5 & 4 & 2 \\\\ 0 & -1-\\lambda  & 5 & 1 \\\\ 0 & 0 & 5-\\lambda  & 1 \\\\ 0 & 0 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-1-\\lambda )(5-\\lambda )(1-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +1)(\\lambda -5)(\\lambda -1) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186122666 :answer-field/correct "answer-457e9051-86d9-52ea-9195-8e29a88ad83f" :answer-field/choices ["answer-457e9051-86d9-52ea-9195-8e29a88ad83f" "answer-8bcf654c-f10a-5880-a4ae-224b5c7e4e07" "answer-691f275b-fd9a-54d9-8586-a64a1a03045b" "answer-414f9370-14a3-5aa6-8486-cea2e27301a8" "answer-75cdd761-23be-5c11-826b-34cb06e74a70"] :db/ensure [:answer-field/validate]} {:db/id "answer-457e9051-86d9-52ea-9195-8e29a88ad83f" :answer/id #uuid "457e9051-86d9-52ea-9195-8e29a88ad83f" :answer/type :answer.type/math :answer/value "(\\lambda -2)(\\lambda +1)(\\lambda -5)(\\lambda -1)=0" :db/ensure [:answer/validate]} {:db/id "answer-8bcf654c-f10a-5880-a4ae-224b5c7e4e07" :answer/id #uuid "8bcf654c-f10a-5880-a4ae-224b5c7e4e07" :answer/type :answer.type/math :answer/value "(\\lambda -2)(\\lambda -5)(\\lambda +1)^{2}=0" :db/ensure [:answer/validate]} {:db/id "answer-691f275b-fd9a-54d9-8586-a64a1a03045b" :answer/id #uuid "691f275b-fd9a-54d9-8586-a64a1a03045b" :answer/type :answer.type/math :answer/value "(\\lambda -2)(\\lambda -5)^{2}(\\lambda +1)=0" :db/ensure [:answer/validate]} {:db/id "answer-414f9370-14a3-5aa6-8486-cea2e27301a8" :answer/id #uuid "414f9370-14a3-5aa6-8486-cea2e27301a8" :answer/type :answer.type/math :answer/value "(\\lambda -2)^{2}(\\lambda +1)(\\lambda -5)=0" :db/ensure [:answer/validate]} {:db/id "answer-75cdd761-23be-5c11-826b-34cb06e74a70" :answer/id #uuid "75cdd761-23be-5c11-826b-34cb06e74a70" :answer/type :answer.type/math :answer/value "(\\lambda -2)^{2}(\\lambda -5)^{2}=0" :db/ensure [:answer/validate]} {:db/id 17592186366511 :question/problem "$$\nD=[\\begin{aligned}-1 & -2 & 4 & 6 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & -2 & 0 & 5 \\\\ 0 & 0 & 0 & -7\\end{aligned}].\n$$\n\nConsider the matrix $D$ given above. Which of the following statements are true?\n\nI. $\\lambda =2$ is an eigenvalue of $D$\n\nII. $\\lambda =-1$ is an eigenvalue of $D$\n\nIII. The eigenvalue $\\lambda =-1$ has algebraic multiplicity $2$" :db/ensure [:question/validate]} {:db/id "question-243cda6a-277e-5555-a0d1-a4b1a66521e4" :question/id #uuid "243cda6a-277e-5555-a0d1-a4b1a66521e4" :question/math-academy-id "q-37353" :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}5 & 0 & 0 & 0 \\\\ -3 & -1 & 0 & 0 \\\\ 0 & 5 & 4 & 0 \\\\ 2 & 0 & -3 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}5-\\lambda  & 0 & 0 & 0 \\\\ -3 & -1-\\lambda  & 0 & 0 \\\\ 0 & 5 & 4-\\lambda  & 0 \\\\ 2 & 0 & -3 & 1-\\lambda \\end{aligned}].\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}5-\\lambda  & 0 & 0 & 0 \\\\ -3 & -1-\\lambda  & 0 & 0 \\\\ 0 & 5 & 4-\\lambda  & 0 \\\\ 2 & 0 & -3 & 1-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(-1-\\lambda )(4-\\lambda )(1-\\lambda ) & =0 \\\\ (\\lambda -5)(\\lambda +1)(\\lambda -4)(\\lambda -1) & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-834cc150-7558-5f94-8ad6-94ae5f3cfbc7"] :db/ensure [:question/validate]} {:db/id "answer-field-834cc150-7558-5f94-8ad6-94ae5f3cfbc7" :answer-field/id #uuid "834cc150-7558-5f94-8ad6-94ae5f3cfbc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-26c14220-eceb-59a1-9b09-b87b97b8a7b6" :answer-field/choices ["answer-2498f497-cc93-5d6b-a1c8-83b43853b063" "answer-040615ac-cb0a-5fce-99f6-4ed63d75aaeb" "answer-26c14220-eceb-59a1-9b09-b87b97b8a7b6" "answer-f9560526-e72e-5f8b-ab9e-5ebe403d5441" "answer-2cd374ea-5661-54f0-b4f0-721321849bb9"] :db/ensure [:answer-field/validate]} {:db/id "answer-2498f497-cc93-5d6b-a1c8-83b43853b063" :answer/id #uuid "2498f497-cc93-5d6b-a1c8-83b43853b063" :answer/type :answer.type/math :answer/value "(\\lambda +5)(\\lambda +1)(\\lambda -4)(\\lambda -1)=0" :db/ensure [:answer/validate]} {:db/id "answer-040615ac-cb0