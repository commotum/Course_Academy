}{4x}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-15914c78-3443-5f37-8613-b5a6f0de9715"] :db/ensure [:question/validate]} {:db/id "answer-field-15914c78-3443-5f37-8613-b5a6f0de9715" :answer-field/id #uuid "15914c78-3443-5f37-8613-b5a6f0de9715" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-08f72752-b6a3-5fac-90f5-71764ab5509e" :answer-field/choices ["answer-08f72752-b6a3-5fac-90f5-71764ab5509e"] :db/ensure [:answer-field/validate]} {:db/id "answer-08f72752-b6a3-5fac-90f5-71764ab5509e" :answer/id #uuid "08f72752-b6a3-5fac-90f5-71764ab5509e" :answer/type :answer.type/math :answer/value "\\frac{3}{4x}" :db/ensure [:answer/validate]} {:db/id 17592186138751 :question/problem "In an inverse variation, $y=6$ when $x=-7.$ Find an equation that relates $x$ and $y.$\n\n$\\,y=$\n{{field-1}}" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nNext, we use the given data $y=6$ when $x=-7$ to find $k:$\n\n$$\n\\begin{aligned}6 & =\\frac{k}{(-7)} \\\\ 6\\cdot (-7) & =k \\\\ -42 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\ny=-\\frac{42}{x}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186135514 :answer-field/correct "answer-2f132f7e-60ad-5452-a2eb-ff4b5d68c418" :answer-field/choices ["answer-2f132f7e-60ad-5452-a2eb-ff4b5d68c418"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f132f7e-60ad-5452-a2eb-ff4b5d68c418" :answer/id #uuid "2f132f7e-60ad-5452-a2eb-ff4b5d68c418" :answer/type :answer.type/math :answer/value "-\\frac{42}{x}" :db/ensure [:answer/validate]} {:db/id "question-157c2ce3-5327-5267-a129-7f9aebf9b49f" :question/id #uuid "157c2ce3-5327-5267-a129-7f9aebf9b49f" :question/math-academy-id "q-115560" :question/problem "If $y$ varies inversely with $x$ and $y=3$ when $x=\\frac{5}{3},$ find the value of $y$ when $x=2.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nWe are told that $y=3$ when $x=\\frac{5}{3}.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}3 & =\\frac{k}{(\\frac{5}{3})} \\\\ 3\\cdot \\frac{5}{3} & =k \\\\ \\frac{15}{3} & =k \\\\ 5 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{5}{x}.\n$$\n\nFinally, substituting the value of $x=2$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{5}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6accb65d-487d-5e4c-9f58-e9f7512e092a"] :db/ensure [:question/validate]} {:db/id "answer-field-6accb65d-487d-5e4c-9f58-e9f7512e092a" :answer-field/id #uuid "6accb65d-487d-5e4c-9f58-e9f7512e092a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-576b3890-6abd-55de-92db-73d43f720e91" :answer-field/choices ["answer-7fd59b4d-9677-5eda-a75f-2e81639dd1ef" "answer-45e6265d-627c-5bfe-b4a4-c9064cb498a0" "answer-fcf3078c-b7b8-5e5f-a2a5-c5b18a6edb52" "answer-576b3890-6abd-55de-92db-73d43f720e91" "answer-460eaa64-2244-54be-b725-8a2f2bf21ee2"] :db/ensure [:answer-field/validate]} {:db/id "answer-7fd59b4d-9677-5eda-a75f-2e81639dd1ef" :answer/id #uuid "7fd59b4d-9677-5eda-a75f-2e81639dd1ef" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-45e6265d-627c-5bfe-b4a4-c9064cb498a0" :answer/id #uuid "45e6265d-627c-5bfe-b4a4-c9064cb498a0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-fcf3078c-b7b8-5e5f-a2a5-c5b18a6edb52" :answer/id #uuid "fcf3078c-b7b8-5e5f-a2a5-c5b18a6edb52" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-576b3890-6abd-55de-92db-73d43f720e91" :answer/id #uuid "576b3890-6abd-55de-92db-73d43f720e91" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-460eaa64-2244-54be-b725-8a2f2bf21ee2" :answer/id #uuid "460eaa64-2244-54be-b725-8a2f2bf21ee2" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-19618a93-f5c7-57b8-b5e4-4ba96b1ca9c7" :question/id #uuid "19618a93-f5c7-57b8-b5e4-4ba96b1ca9c7" :question/math-academy-id "q-51816" :question/problem "If $y$ varies inversely with $x$ and $y=10$ when $x=\\frac{3}{2},$ find the value of $y$ when $x=3.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nWe are told that $y=10$ when $x=\\frac{3}{2}.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}10 & =\\frac{k}{(\\frac{3}{2})} \\\\ 10\\cdot (\\frac{3}{2}) & =k \\\\ \\frac{30}{2} & =k \\\\ 15 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{15}{x}.\n$$\n\nFinally, substituting the value of $x=3$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{15}{3}=5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7738aed2-6969-583c-b1d2-159e3752029b"] :db/ensure [:question/validate]} {:db/id "answer-field-7738aed2-6969-583c-b1d2-159e3752029b" :answer-field/id #uuid "7738aed2-6969-583c-b1d2-159e3752029b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b24df18f-c0d7-55b0-a620-52ca08dd9606" :answer-field/choices ["answer-7e41d7eb-d6b5-5b2c-946b-12009ab1f71f" "answer-c5e978c6-725e-52b7-a7d5-e19dd3beea3b" "answer-b24df18f-c0d7-55b0-a620-52ca08dd9606" "answer-b803ed2a-92df-50aa-86b4-a74a3d347a8d" "answer-9784723c-c70e-51dd-9e53-5d403867e4f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e41d7eb-d6b5-5b2c-946b-12009ab1f71f" :answer/id #uuid "7e41d7eb-d6b5-5b2c-946b-12009ab1f71f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-c5e978c6-725e-52b7-a7d5-e19dd3beea3b" :answer/id #uuid "c5e978c6-725e-52b7-a7d5-e19dd3beea3b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-b24df18f-c0d7-55b0-a620-52ca08dd9606" :answer/id #uuid "b24df18f-c0d7-55b0-a620-52ca08dd9606" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-b803ed2a-92df-50aa-86b4-a74a3d347a8d" :answer/id #uuid "b803ed2a-92df-50aa-86b4-a74a3d347a8d" :answer/type :answer.type/math :answer/value "\\frac{14}{5}" :db/ensure [:answer/validate]} {:db/id "answer-9784723c-c70e-51dd-9e53-5d403867e4f4" :answer/id #uuid "9784723c-c70e-51dd-9e53-5d403867e4f4" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-3da28d76-c23e-56b2-b98e-5a4dbf8f4efa" :question/id #uuid "3da28d76-c23e-56b2-b98e-5a4dbf8f4efa" :question/math-academy-id "q-217253" :question/problem "| $\\,x\\,$ | $\\,y\\,$ |\n| --- | --- |\n| $0.3$ | $20$ |\n| $0.6$ | $10$ |\n| $2$ | $3$ |\n\nGiven the table above, select the options that make the following statement true:\n\nThe variable $y$ is {{field-1}} proportional to $x,$ and the constant of variation is $k=$  {{field-2}}." :question/worked-solution "If $y$ varies inversely with $x,$ then we must have\n\n$$\ny=\\frac{k}{x}.\n$$\n\nfor some constant $k.$ Note that we can rewrite the above equation as follows.\n\n$$\nx\\cdot y=k\n$$\n\nSo, we will compute $x\\cdot y=k$ for each row in the table. If we get the same value of $k$ for each row, then we can conclude that $y$ is inversely proportional to $x.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $x\\cdot y=k$ |\n| --- | --- | --- |\n| $0.3$ | $20$ | $0.3\\cdot 20=6$ |\n| $0.6$ | $10$ | $0.6\\cdot 10=6$ |\n| $2$ | $3$ | $2\\cdot 3=6$ |\n\nThe results are all the same: in each row, we have $k=6.$ Therefore, we conclude:\n\nThe variable $y$ is $\\text{inversely}$ proportional  to $x,$ and the constant of variation is $k=6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b08c00b7-2402-5844-b574-287c4bc50115" "answer-field-cdfbbcef-bf26-5772-810b-7bd392bc9c98"] :db/ensure [:question/validate]} {:db/id "answer-field-b08c00b7-2402-5844-b574-287c4bc50115" :answer-field/id #uuid "b08c00b7-2402-5844-b574-287c4bc50115" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ec968006-3a4b-5c45-a0a5-1e2f616e7e7f" :answer-field/choices ["answer-bd9afd47-8870-5dce-b868-e91c5ce20f62" "answer-ec968006-3a4b-5c45-a0a5-1e2f616e7e7f"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd9afd47-8870-5dce-b868-e91c5ce20f62" :answer/id #uuid "bd9afd47-8870-5dce-b868-e91c5ce20f62" :answer/type :answer.type/text :answer/value "directly" :db/ensure [:answer/validate]} {:db/id "answer-ec968006-3a4b-5c45-a0a5-1e2f616e7e7f" :answer/id #uuid "ec968006-3a4b-5c45-a0a5-1e2f616e7e7f" :answer/type :answer.type/text :answer/value "inversely" :db/ensure [:answer/validate]} {:db/id "answer-field-cdfbbcef-bf26-5772-810b-7bd392bc9c98" :answer-field/id #uuid "cdfbbcef-bf26-5772-810b-7bd392bc9c98" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-d0002b8a-73e2-536b-8292-bbfbf4151fdb" :answer-field/choices ["answer-90fd24b2-3e1e-56ea-94a3-a67bee566d7c" "answer-9968f11b-6765-5930-93fd-d8242102c550" "answer-3e6d8f00-2030-5663-a9a7-4a2e4758e45b" "answer-d0002b8a-73e2-536b-8292-bbfbf4151fdb"] :db/ensure [:answer-field/validate]} {:db/id "answer-90fd24b2-3e1e-56ea-94a3-a67bee566d7c" :answer/id #uuid "90fd24b2-3e1e-56ea-94a3-a67bee566d7c" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "answer-9968f11b-6765-5930-93fd-d8242102c550" :answer/id #uuid "9968f11b-6765-5930-93fd-d8242102c550" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-3e6d8f00-2030-5663-a9a7-4a2e4758e45b" :answer/id #uuid "3e6d8f00-2030-5663-a9a7-4a2e4758e45b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-d0002b8a-73e2-536b-8292-bbfbf4151fdb" :answer/id #uuid "d0002b8a-73e2-536b-8292-bbfbf4151fdb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-2fadf069-0681-5a52-8bef-b8793387f31e" :question/id #uuid "2fadf069-0681-5a52-8bef-b8793387f31e" :question/math-academy-id "q-217254" :question/problem "| $\\,x\\,$ | $\\,y\\,$ |\n| --- | --- |\n| $4$ | $3.5$ |\n| $7$ | $2$ |\n| $14$ | $1$ |\n\nGiven the table above, select the options that make the following statement true:\n\nThe variable $y$ is {{field-1}} proportional to $x,$ and the constant of variation is $k=$  {{field-2}}." :question/worked-solution "If $y$ varies inversely with $x,$ then we must have\n\n$$\ny=\\frac{k}{x}.\n$$\n\nfor some constant $k.$ Note that we can rewrite the above equation as follows.\n\n$$\nx\\cdot y=k\n$$\n\nSo, we will compute $x\\cdot y=k$ for each row in the table. If we get the same value of $k$ for each row, then we can conclude that $y$ is inversely proportional to $x.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $x\\cdot y=k$ |\n| --- | --- | --- |\n| $4$ | $3.5$ | $4\\cdot 3.5=14$ |\n| $7$ | $2$ | $7\\cdot 2=14$ |\n| $14$ | $1$ | $14\\cdot 1=14$ |\n\nThe results are all the same: in each row, we have $k=14.$ Therefore, we conclude:\n\nThe variable $y$ is $\\text{inversely}$ proportional  to $x,$ and the constant of variation is $k=14.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7dc4d23e-683f-5389-ade4-a228e326ad50" "answer-field-0cd7f47c-05e6-57af-902e-c3e2f8c4acce"] :db/ensure [:question/validate]} {:db/id "answer-field-7dc4d23e-683f-5389-ade4-a228e326ad50" :answer-field/id #uuid "7dc4d23e-683f-5389-ade4-a228e326ad50" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-775f6874-f183-5625-8825-10261bb31e31" :answer-field/choices ["answer-063a32cc-64a8-5d9b-8bbb-778e4ce065c4" "answer-775f6874-f183-5625-8825-10261bb31e31"] :db/ensure [:answer-field/validate]} {:db/id "answer-063a32cc-64a8-5d9b-8bbb-778e4ce065c4" :answer/id #uuid "063a32cc-64a8-5d9b-8bbb-778e4ce065c4" :answer/type :answer.type/text :answer/value "directly" :db/ensure [:answer/validate]} {:db/id "answer-775f6874-f183-5625-8825-10261bb31e31" :answer/id #uuid "775f6874-f183-5625-8825-10261bb31e31" :answer/type :answer.type/text :answer/value "inversely" :db/ensure [:answer/validate]} {:db/id "answer-field-0cd7f47c-05e6-57af-902e-c3e2f8c4acce" :answer-field/id #uuid "0cd7f47c-05e6-57af-902e-c3e2f8c4acce" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-23a4774a-3eec-5fe8-a35b-7924a8f896be" :answer-field/choices ["answer-23a4774a-3eec-5fe8-a35b-7924a8f896be" "answer-ac3f8911-bb59-5625-bccc-cceb648ee7ca" "answer-928fccb1-2b97-5443-90ad-c0afdbef9b28" "answer-39379ff7-d28b-54f8-b004-8168e94feeae"] :db/ensure [:answer-field/validate]} {:db/id "answer-23a4774a-3eec-5fe8-a35b-7924a8f896be" :answer/id #uuid "23a4774a-3eec-5fe8-a35b-7924a8f896be" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-ac3f8911-bb59-5625-bccc-cceb648ee7ca" :answer/id #uuid "ac3f8911-bb59-5625-bccc-cceb648ee7ca" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-928fccb1-2b97-5443-90ad-c0afdbef9b28" :answer/id #uuid "928fccb1-2b97-5443-90ad-c0afdbef9b28" :answer/type :answer.type/math :answer/value "3.5" :db/ensure [:answer/validate]} {:db/id "answer-39379ff7-d28b-54f8-b004-8168e94feeae" :answer/id #uuid "39379ff7-d28b-54f8-b004-8168e94feeae" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-53ba14a9-4fd5-5080-a5a5-86813a5ef68d" :question/id #uuid "53ba14a9-4fd5-5080-a5a5-86813a5ef68d" :question/math-academy-id "q-51895" :question/problem "![](images/38/383c7f4412b9c9b9017e8b93745191362ac2612cedc741b6aba6ee2bcfa13f21.png)\n\nThe graph above shows the relationship between $x$ and $y.$ Given that $y$ varies inversely with $x$, find the inverse variation equation between $x$ and $y.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nIn the graph, we notice a point with $x=3$ and $y=2.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}2 & =\\frac{k}{3} \\\\ 2\\cdot 3 & =k \\\\ 6 & =k\\end{aligned}\n$$\n\nTherefore, the inverse variation equation is given by\n\n$$\ny=\\frac{6}{x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26777947-b062-512b-9c23-c9ecd09ea93d"] :db/ensure [:question/validate]} {:db/id "answer-field-26777947-b062-512b-9c23-c9ecd09ea93d" :answer-field/id #uuid "26777947-b062-512b-9c23-c9ecd09ea93d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03509785-63f5-5445-8ab5-efc8af5db658" :answer-field/choices ["answer-7e8a8c85-4138-5aef-b7e9-c9d98c9335dd" "answer-4d7ac2c9-6132-5f14-aa53-56106ae322aa" "answer-9c0a8ef5-b908-5ec0-873a-721c483aabe5" "answer-03509785-63f5-5445-8ab5-efc8af5db658" "answer-a0d997a5-88f5-58af-9c73-ba0cf2bb6ba4"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e8a8c85-4138-5aef-b7e9-c9d98c9335dd" :answer/id #uuid "7e8a8c85-4138-5aef-b7e9-c9d98c9335dd" :answer/type :answer.type/math :answer/value "y=\\frac{3}{x}" :db/ensure [:answer/validate]} {:db/id "answer-4d7ac2c9-6132-5f14-aa53-56106ae322aa" :answer/id #uuid "4d7ac2c9-6132-5f14-aa53-56106ae322aa" :answer/type :answer.type/math :answer/value "y=\\frac{4}{x}" :db/ensure [:answer/validate]} {:db/id "answer-9c0a8ef5-b908-5ec0-873a-721c483aabe5" :answer/id #uuid "9c0a8ef5-b908-5ec0-873a-721c483aabe5" :answer/type :answer.type/math :answer/value "y=\\frac{5}{2x}" :db/ensure [:answer/validate]} {:db/id "answer-03509785-63f5-5445-8ab5-efc8af5db658" :answer/id #uuid "03509785-63f5-5445-8ab5-efc8af5db658" :answer/type :answer.type/math :answer/value "y=\\frac{6}{x}" :db/ensure [:answer/validate]} {:db/id "answer-a0d997a5-88f5-58af-9c73-ba0cf2bb6ba4" :answer/id #uuid "a0d997a5-88f5-58af-9c73-ba0cf2bb6ba4" :answer/type :answer.type/math :answer/value "y=\\frac{9}{x}" :db/ensure [:answer/validate]} {:db/id "question-4e4b31ea-beda-5fbb-b941-d610f8f1a932" :question/id #uuid "4e4b31ea-beda-5fbb-b941-d610f8f1a932" :question/math-academy-id "q-218382" :question/problem "![](images/bd/bd4cccf280ca8bb71b8c54bafc79959431b78540a047dcb1120785e603abd249.png)\n\nThe graph above shows an inverse variation relationship between $x$ and $y.$ Express $y$ in terms of $x.$\n\n$\\,y=$\n{{field-1}}" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nIn the graph, we notice a point with $x=8$ and $y=\\frac{3}{2}.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}\\frac{3}{2} & =\\frac{k}{8} \\\\ \\frac{3}{2}\\cdot 8 & =k \\\\ 12 & =k\\end{aligned}\n$$\n\nTherefore, the inverse variation equation is given by\n\n$$\ny=\\frac{12}{x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8df595bc-00dd-5e1e-9875-a07a226991b3"] :db/ensure [:question/validate]} {:db/id "answer-field-8df595bc-00dd-5e1e-9875-a07a226991b3" :answer-field/id #uuid "8df595bc-00dd-5e1e-9875-a07a226991b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3d46e461-53f4-5a4c-aa29-7447146a4f04" :answer-field/choices ["answer-3d46e461-53f4-5a4c-aa29-7447146a4f04"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d46e461-53f4-5a4c-aa29-7447146a4f04" :answer/id #uuid "3d46e461-53f4-5a4c-aa29-7447146a4f04" :answer/type :answer.type/math :answer/value "\\frac{12}{x}" :db/ensure [:answer/validate]} {:db/id 17592186139718 :tutorial/content "Suppose that we're making a juice drink with a fixed amount of pure orange and the rest water. \n\nThe more water that we add, the less that we'll be able to taste the orange. \n\nMore precisely, the concentration of pure orange $y$ (in grams per liter) varies **inversely** with the volume $x$ (in liters) of water added. We can express this idea using an **inverse variation equation** as follows:\n\n$$\ny= \\dfrac{k}{x}\n$$\n\nThe constant $k$ is called the **constant of variation** or **constant of proportionality.**\n\nNotice that:\n\n- If $x$ is small (i.e., there is not much water), then $y$ is large (i.e., there is a high concentration of orange).\n\n- If $x$ is large (i.e., there is lots of water), then $y$ is small (i.e., there is a low concentration of orange).\n\nTo find the constant of variation $k$, we need to plug in some data. \n\nFor example, suppose we know that the concentration is $y = 200\\, \\textrm{g/L}$ when $x = 4\\,\\textrm L$ of water has been added. Plugging this into our relationship and solving for $k,$ we have\n\n$$\n\\begin{aligned}y & =\\frac{k}{x} \\\\ 200 & =\\frac{k}{4} \\\\ 200\\cdot 4 & =k \\\\ 800 & =k\\end{aligned}\n$$\n\nTherefore, the relationship between $y$ and $x$ is\n\n$$\ny = \\dfrac {800} x.\n$$\n\nFinally, notice that we can rewrite the above relationship as\n\n$$\nxy = 800.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186139720 :tutorial/content "If  $y$ varies inversely with  $x,$ then we can also say that $y$ is **inversely proportional** to $x.$ We can express this mathematically as\n\n$$\ny \\propto \\dfrac{1}{x},\n$$\n\nwhere $\\propto$ is the proportionality symbol.\n\nThe following statements are equivalent:\n\n- $y = \\dfrac{k}{x}$ for some constant $k$\n\n- $y$ varies inversely with $x$\n\n- $y$ is inversely proportional to $x$\n\n- $y \\propto \\dfrac{1}{x}$" :db/ensure [:tutorial/validate]} {:db/id 17592186138599 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]}]
