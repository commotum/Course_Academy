{1}-3{X}_{2}+4{X}_{3}.\n$$\n\nSince ${X}_{1},{X}_{2},$ and ${X}_{3}$ are mutually independent, we have \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={a}_{1}{\\mu }_{1}+{a}_{2}{\\mu }_{2}+{a}_{3}{\\mu }_{3} \\\\  & =2\\cdot 3+(-3)\\cdot (-1)+4\\cdot 0 \\\\  & =9, \\\\ \\text{Var}[Y] & ={a}_{1}^{2}{\\sigma }_{1}^{2}+{a}_{2}^{2}{\\sigma }_{2}^{2}+{a}_{3}^{2}{\\sigma }_{3}^{2} \\\\  & ={2}^{2}\\cdot 4+{3}^{2}\\cdot 1+{4}^{2}\\cdot 3 \\\\  & =4\\cdot 4+9\\cdot 1+16\\cdot 3 \\\\  & =73.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}Y=2{X}_{1}-3{X}_{2}+4{X}_{3} & ∼N(9,73).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186173974 :answer-field/correct "answer-cbd6f88f-8b8d-5e32-9d78-e9dbd7ed4963" :answer-field/choices ["answer-44aad863-f96a-579d-b680-6ce5d56a02a7" "answer-d6292a34-5400-590e-b4c1-749f608bf003" "answer-4d54ca23-c0cf-5217-bc85-5e3536134a0f" "answer-cbd6f88f-8b8d-5e32-9d78-e9dbd7ed4963" "answer-1e750ca1-0028-593b-b691-2d6aec16572e"] :db/ensure [:answer-field/validate]} {:db/id "answer-44aad863-f96a-579d-b680-6ce5d56a02a7" :answer/id #uuid "44aad863-f96a-579d-b680-6ce5d56a02a7" :answer/type :answer.type/math :answer/value "Y∼N(3,72)" :db/ensure [:answer/validate]} {:db/id "answer-d6292a34-5400-590e-b4c1-749f608bf003" :answer/id #uuid "d6292a34-5400-590e-b4c1-749f608bf003" :answer/type :answer.type/math :answer/value "Y∼N(9,3)" :db/ensure [:answer/validate]} {:db/id "answer-4d54ca23-c0cf-5217-bc85-5e3536134a0f" :answer/id #uuid "4d54ca23-c0cf-5217-bc85-5e3536134a0f" :answer/type :answer.type/math :answer/value "Y∼N(9,70)" :db/ensure [:answer/validate]} {:db/id "answer-cbd6f88f-8b8d-5e32-9d78-e9dbd7ed4963" :answer/id #uuid "cbd6f88f-8b8d-5e32-9d78-e9dbd7ed4963" :answer/type :answer.type/math :answer/value "Y∼N(9,73)" :db/ensure [:answer/validate]} {:db/id "answer-1e750ca1-0028-593b-b691-2d6aec16572e" :answer/id #uuid "1e750ca1-0028-593b-b691-2d6aec16572e" :answer/type :answer.type/math :answer/value "Y∼N(9,9)" :db/ensure [:answer/validate]} {:db/id "question-f0eb5f1d-3690-5932-81c7-b92330f2d368" :question/id #uuid "f0eb5f1d-3690-5932-81c7-b92330f2d368" :question/math-academy-id "q-142962" :question/problem "Given that the random variables \n\n$$\n{X}_{1}∼N(3,1),\\,{X}_{2}∼N(-3,2),\\,{X}_{3}∼N(4,2)\n$$\n\nare mutually independent, what is the distribution of $Y=5{X}_{1}-{X}_{2}-2{X}_{3}?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},$ and ${X}_{3}$ are mutually independent random variables, where \n\n$$\n{X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2}),\\,{X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),\\,{X}_{3}∼N({\\mu }_{3},{\\sigma }_{3}^{2}),\n$$\n\nand ${a}_{1},{a}_{2},{a}_{3}$ are real constants,  then \n\n$$\n\\begin{aligned}Y & ={a}_{1}{X}_{1}+{a}_{2}{X}_{2}+{a}_{3}{X}_{3} \\\\  & ∼N({a}_{1}{\\mu }_{1}+{a}_{2}{\\mu }_{2}+{a}_{3}{\\mu }_{3},\\,{a}_{1}^{2}{\\sigma }_{1}^{2}+{a}_{2}^{2}{\\sigma }_{2}^{2}+{a}_{3}^{2}{\\sigma }_{3}^{2}).\\end{aligned}\n$$\n\nIn our case, we have\n\n$$\n{X}_{1}∼N(3,1),\\,{X}_{2}∼N(-3,2),\\,{X}_{3}∼N(4,2),\n$$\n\nand\n\n$$\nY=5{X}_{1}-{X}_{2}-2{X}_{3}.\n$$\n\nSince ${X}_{1},{X}_{2},$ and ${X}_{3}$ are mutually independent, we have \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={a}_{1}{\\mu }_{1}+{a}_{2}{\\mu }_{2}+{a}_{3}{\\mu }_{3} \\\\  & =5\\cdot 3+(-1)\\cdot (-3)+(-2)\\cdot 4 \\\\  & =15+3-8 \\\\  & =10, \\\\ \\text{Var}[Y] & ={a}_{1}^{2}{\\sigma }_{1}^{2}+{a}_{2}^{2}{\\sigma }_{2}^{2}+{a}_{3}^{2}{\\sigma }_{3}^{2} \\\\  & ={5}^{2}\\cdot 1+(-1)^{2}\\cdot 2+(-2)^{2}\\cdot 2 \\\\  & =25\\cdot 1+1\\cdot 2+4\\cdot 2 \\\\  & =25+2+8 \\\\  & =35.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}Y=5{X}_{1}-{X}_{2}-2{X}_{3} & ∼N(10,35).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f06d8d45-602b-5e23-93bd-528d5726ead7"] :db/ensure [:question/validate]} {:db/id "answer-field-f06d8d45-602b-5e23-93bd-528d5726ead7" :answer-field/id #uuid "f06d8d45-602b-5e23-93bd-