egin{aligned}P(|Y|<3) & =Φ(-1.5)-Φ(-2.25) \\\\  & ≈0.0668-0.0122 \\\\  & =0.0546.\\end{aligned}\n$$" 13194139535339 17592186045417 true] [17592186175906 1038 #edb/ref 17592186498538 13194139535339 17592186045417 true] [17592186175906 1038 #edb/ref 17592186498554 13194139535339 17592186045417 true] [17592186175907 1038 #edb/ref 17592186498505 13194139535339 17592186045417 true] [17592186175907 1038 #edb/ref 17592186498588 13194139535339 17592186045417 true] [17592186175908 1038 #edb/ref 17592186498563 13194139535339 17592186045417 true] [17592186175908 1038 #edb/ref 17592186498568 13194139535339 17592186045417 true] [17592186175908 1038 #edb/ref 17592186498597 13194139535339 17592186045417 true] [17592186176012 1038 #edb/ref 17592186498517 13194139535339 17592186045417 true] [17592186176012 1038 #edb/ref 17592186498531 13194139535339 17592186045417 true] [17592186176012 1038 #edb/ref 17592186498571 13194139535339 17592186045417 true] [17592186176012 1038 #edb/ref 17592186498577 13194139535339 17592186045417 true] [17592186176012 1038 #edb/ref 17592186498583 13194139535339 17592186045417 true] [17592186176013 1038 #edb/ref 17592186498502 13194139535339 17592186045417 true] [17592186176013 1038 #edb/ref 17592186498507 13194139535339 17592186045417 true] [17592186176013 1038 #edb/ref 17592186498555 13194139535339 17592186045417 true] [17592186176013 1038 #edb/ref 17592186498582 13194139535339 17592186045417 true] [17592186176013 1038 #edb/ref 17592186498602 13194139535339 17592186045417 true] [17592186176038 1038 #edb/ref 17592186498493 13194139535339 17592186045417 true] [17592186176038 1038 #edb/ref 17592186498510 13194139535339 17592186045417 true] [17592186176038 1038 #edb/ref 17592186498572 13194139535339 17592186045417 true] [17592186176038 1038 #edb/ref 17592186498596 13194139535339 17592186045417 true] [17592186176039 1038 #edb/ref 17592186498530 13194139535339 17592186045417 true] [17592186176039 1038 #edb/ref 17592186498541 13194139535339 17592186045417 true] 