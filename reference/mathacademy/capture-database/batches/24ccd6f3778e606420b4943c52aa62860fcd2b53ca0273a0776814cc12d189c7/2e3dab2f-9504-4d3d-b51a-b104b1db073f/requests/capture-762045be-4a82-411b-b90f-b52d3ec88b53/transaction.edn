retract 17592186150683 :answer-field/choices 17592186150686] [:db/retract 17592186150683 :answer-field/choices 17592186150687] {:db/id 17592186152130 :knowledge-point/questions ["question-712d7269-b4cd-5fc9-b8d2-ae2c1a69f311" "question-d57989f6-d842-5cb5-a58c-440f55f9dbda"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151932 :question/worked-solution "The fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with $8^{1/5},$ we get $x = 8$ and $n = 5.$ Therefore,\n\n$$\n8^{1/5} = \\sqrt[5]{8}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186152131 :knowledge-point/questions ["question-fe9954e2-d8b5-5670-b2ae-c502beed2e2e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151933 :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[5]{4},$ we get $x = 4$ and $n = 5.$ Therefore,\n\n$$\n\\sqrt[5]{4} = 4^{1/5}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186152128 :knowledge-point/questions ["question-1f30e377-2581-5fcb-9c99-e0f9d4fbdadd" "question-4e2076f0-c68c-52f4-9968-62b13912e45a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151930 :question/worked-solution "First, using the power law for exponents, we can write our expression as\n\n$$\n5^{2/3} = 5^{2\\cdot (1/3)} = \\left(5^2\\right)^{1/3}.\n$$\n\nThe fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with our expression above, we get $x = 5^2$ and $n = 3.$ Therefore,\n\n$$\n\\left(5^2\\right)^{1/3} = \\sqrt[3]{5^2}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186152129 :knowledge-point/questions ["question-dda23851-fa80-5ec4-9488-714cdb6cd2c1" "question-c6e04ff1-6e26-5bfa-a6e9-85e824fdf68a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151931 :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[3]{4^2},$ we get $x = 4^2$ and $n = 3.$ Therefore,\n\n$$\n\\sqrt[3]{4^2} = \\left(4^2\\right)^{1/3}.\n$$\n\nFinally, using the power law for exponents, we have\n\n$$\n\\left(4^2\\right)^{1/3} = 4^{2/3}.\n$$" :db/ensure [:question/validate]} {:db/id "question-712d7269-b4cd-5fc9-b8d2-ae2c1a69f311" :question/id #uuid "712d7269-b4cd-5fc9-b8d2-ae2c1a69f311" :question/math-academy-id "q-69210" :question/problem "Write ${10}^{1/4}$ using radical notation." :question/worked-solution "The fractional exponent ${x}^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing ${x}^{1/n}$ with ${10}^{1/4},$ we get $x=10$ and $n=4.$ Therefore,\n\n$$\n{10}^{1/4}=\\sqrt[4]{10}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fa568649-82c3-5879-8a09-d6b3fd2afc1c"] :db/ensure [:question/validate]} {:db/id "answer-field-fa568649-82c3-5879-8a09-d6b3fd2afc1c" :answer-field/id #uuid "fa568649-82c3-5879-8a09-d6b3fd2afc1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-926d4e1d-b5a0-5c32-a58f-0e78d2cd0069" :answer-field/choices ["answer-c3120201-b276-53c0-8e20-557ae0918433" "answer-926d4e1d-b5a0-5c32-a58f-0e78d2cd0069" "answer-1595414b-5fa3-55ae-b9c1-9c3ac08d2294" "answer-04b5c106-ac62-5f2e-b8a1-9a7c163d95bc" "answer-5ba19cf8-e4f4-50a3-97ea-b213d040a0a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3120201-b276-53c0-8e20-557ae0918433" :answer/id #uuid "c3120201-b276-53c0-8e20-557ae0918433" :answer/type :answer.type/math :answer/value "\\sqrt[10]{4}" :db/ensure [:answer/validate]} {:db/id "answer-926d4e1d-b5a0-5c32-a58f-0e78d2cd0069" :answer/id #uuid "926d4e1d-b5a0-5c32-a58f-0e78d2cd0069" :answer/type :answer.type/math :answer/value "\\sqrt[4]{10}" :db/ensure [:answer/validate]} {:db/id "answer-1595414b-5fa3-55ae-b9c1-9c3ac08d2294" :answer/id #uuid "1595414b-5fa3-55ae-b9c1-9c3ac08d2294" :answer/type :answer.type/math :answer/value "\\sqrt[4]{\\frac{1}{