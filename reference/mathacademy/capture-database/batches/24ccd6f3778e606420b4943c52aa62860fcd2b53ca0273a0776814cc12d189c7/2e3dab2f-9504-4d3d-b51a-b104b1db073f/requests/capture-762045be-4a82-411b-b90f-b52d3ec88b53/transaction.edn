6f2abd7-a9ed-5f92-955c-436d559b0445"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a30e9fa-dfe5-530f-990b-4872ef14bfbf" :answer/id #uuid "0a30e9fa-dfe5-530f-990b-4872ef14bfbf" :answer/type :answer.type/math :answer/value "{3}^{4/6}" :db/ensure [:answer/validate]} {:db/id "answer-0558bfb0-dcd9-5279-b989-345db840a2c2" :answer/id #uuid "0558bfb0-dcd9-5279-b989-345db840a2c2" :answer/type :answer.type/math :answer/value "{3}^{6/4}" :db/ensure [:answer/validate]} {:db/id "answer-b038f1be-3e10-5ac2-b672-f5ae64b48440" :answer/id #uuid "b038f1be-3e10-5ac2-b672-f5ae64b48440" :answer/type :answer.type/math :answer/value "{4}^{3/6}" :db/ensure [:answer/validate]} {:db/id "answer-5c276a48-72d0-5ae5-a793-8f7f2759b366" :answer/id #uuid "5c276a48-72d0-5ae5-a793-8f7f2759b366" :answer/type :answer.type/math :answer/value "{6}^{3/4}" :db/ensure [:answer/validate]} {:db/id "answer-d6f2abd7-a9ed-5f92-955c-436d559b0445" :answer/id #uuid "d6f2abd7-a9ed-5f92-955c-436d559b0445" :answer/type :answer.type/math :answer/value "{6}^{4/3}" :db/ensure [:answer/validate]} {:db/id 17592186153346 :tutorial/content "So far, we know the following:\n\n- To find the square root of a number, we need to find another that multiplies by itself $2$ times to give the original number. For example,\n\n$$\n\\sqrt{9} = \\sqrt{3 \\cdot 3} = \\sqrt{3^2} = 3.\n$$\n\n- To find the cube root of a number, we need to find another that multiplies by itself $3$ times to give the original number. For example,\n\n$$\n\\sqrt[3]{8} = \\sqrt[3]{2 \\cdot 2 \\cdot 2} = \\sqrt[3]{2^3} = 2.\n$$\n\nWe can extend this to any root. In general, to find the $n$th root of a number, we needed to find another number that multiplies by itself $n$ times to give the original number. We express the $n$th root as the radical $\\sqrt[n]{\\phantom{0}}.$ For instance,\n\n$$\n\\sqrt[{\\color{blue}4}]{16} = \\sqrt[{\\color{blue}4}]{\\underbrace{2\\cdot 2\\cdot 2\\cdot 2}_{{\\color{blue}4}\\text{ times}}} = \\sqrt[{\\color{blue}4}]{2^4} = 2.\n$$\n\nGiven a radical $\\sqrt[n]{x},$ we can write an equivalent expression using the fractional exponent $x^{1/n}.$ To demonstrate, let's write an equivalent expression for $\\sqrt[7]{3}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[7]{3},$ we get $x = 3$ and $n = 7.$ Therefore,\n\n$$\n\\sqrt[7]{3} = 3^{1/7}.\n$$\n\nThe reverse is also true: the fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\n**Note:** Remember that the square root of a number corresponds to the case of $n=2.$ So, for example, we have\n\n$$\n\\sqrt{3} = 3^{1/2}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186152321 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186163900 :answer-field/choices 17592186163905] [:db/retract 17592186163900 :answer-field/choices 17592186163901] [:db/retract 17592186163900 :answer-field/choices 17592186163903] {:db/id 17592186166883 :knowledge-point/questions ["question-65bd6053-5f41-5a6f-ac31-815596c779fb" "question-a130ee36-c4fa-557a-b62c-af4b4bf44ed4" "question-510822f4-2240-59da-8db4-5275b43b2562" "question-a8b13a1a-6bdb-56d5-b06e-dfa9901c1db1" "question-d1845eab-f52b-5f23-bd27-faf40f79c71a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166884 :knowledge-point/questions ["question-bbfd9077-09aa-55c5-a7ec-ce238f7922af" "question-0fd9a9b1-ea5c-5d82-ac2e-6cadd4a02789" "question-a3d12aa9-7854-5ac5-a883-81ef95d3c722"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166885 :knowledge-point/questions ["question-3b9226c2-67e0-5858-9c64-ae46c4147a95" "question-b2ff4fa5-a334-50b5-9869-f8e569ec5011" "question-b0a81f04-6f59-512d-aa20-c54e3b26a51d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-65bd6053-5f41-5a6f-ac31-815596c779fb" :question/id #uuid "65bd6053-5f41-5a6f-ac31-815596c779fb" :question/math-academy-id "q-163208" :question/problem "Consider the function $f(x,y)$ and the region $D$ given by\n\n$$\nf(x,y)=3y-2x,\\,D=\\{(x,y)\\,:\\,0\\le x\\le y,\\,0\\le y\\le 3\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ Find $b$ given that $a=1.$" :question/worked-solution "According to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that\n\n$$\n{∬}_{D}f(x,y)\\,\\text{d}A=f(a,b)\\cdot \\text{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}(3y-2x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{y}(3y-2x)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}[3xy-{x}^{2}]_{x=0}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}2{y}^{2}\\,\\text{d}y \\\\  & ={[\\frac{2{y}^{3}}{3}]}_{y=0}^{y=3} \\\\  & =18.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{y}\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}[x]_{x=0}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}y\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{2}]}_{y=0}^{y=3} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nAlso, we are told that $a=1.$ So, our initial equation simplifies to\n\n$$\n\\begin{aligned}18 & =f(1,b)\\cdot \\frac{9}{2} \\\\ 18 & =(3b-2\\cdot 1)\\cdot \\frac{9}{2} \\\\ 4 & =3b-2 \\\\ 6 & =3b \\\\ b & =2.\\end{aligned}\n$$\n\nNotice that $(1,2)\\in D.$ Therefore, the answer is $b=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-efe2ad41-143d-5a5f-9acb-57cf8643ab94"] :db/ensure [:question/validate]} {:db/id "answer-field-efe2ad41-143d-5a5f-9acb-57cf8643ab94" :answer-field/id #uuid "efe2ad41-143d-5a5f-9acb-57cf8643ab94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1a845bb-0954-584e-b542-37d3783851e0" :answer-field/choices ["answer-a7b6ca86-eebb-5760-b9bd-8e54ad1102c8" "answer-e1a845bb-0954-584e-b542-37d3783851e0" "answer-071427db-1ab5-5a7b-8ab5-fd9f44da6576" "answer-b5822c67-2544-5801-8e37-04b814eeeae7" "answer-38e562f4-0b20-5eaa-a03e-6faae7854a82"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7b6ca86-eebb-5760-b9bd-8e54ad1102c8" :answer/id #uuid "a7b6ca86-eebb-5760-b9bd-8e54ad1102c8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-e1a845bb-0954-584e-b542-37d3783851e0" :answer/id #uuid "e1a845bb-0954-584e-b542-37d3783851e0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-071427db-1ab5-5a7b-8ab5-fd9f44da6576" :answer/id #uuid "071427db-1ab5-5a7b-8ab5-fd9f44da6576" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-b5822c67-2544-5801-8e37-04b814eeeae7" :answer/id #uuid "b5822c67-2544-5801-8e37-04b814eeeae7" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-38e562f4-0b20-5eaa-a03e-6faae7854a82" :answer/id #uuid "38e562f4-0b20-5eaa-a03e-6faae7854a82" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-a130ee36-c4fa-557a-b62c-af4b4bf44ed4" :question/id #uuid "a130ee36-c4fa-557a-b62c-af4b4bf44ed4" :question/math-academy-id "q-163151" :question/problem "Consider the function $f(x,y)$ and the region $D$ given by\n\n$$\nf(x,y)=2x+{y}^{2},\\,D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 3\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ Find $a$ given that $b=1.$" :question/worked-solution "According to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that\n\n$$\n{∬}_{D}f(x,y)\\,\\text{d}A=f(a,b)\\cdot \\text{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}(2x+{y}^{2})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}(2x+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}[2xy+\\frac{{y}^{3}}{3}]_{y=0}^{y=3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(6x+9)\\,\\text{d}x \\\\  & =[3{x}^{2}+9x]_{x=0}^{x=2} \\\\  & =(3\\cdot {2}^{2}+9\\cdot 2)-0 \\\\  & =30.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\text{Area}(D)=2\\cdot 3=6.\n$$\n\nAlso, we are told that $b=1.$ So, our initial equation simplifies to\n\n$$\n\\begin{aligned}30 & =f(a,1)\\cdot 6 \\\\ 30 & =(2a+{1}^{2})\\cdot 6 \\\\ 30 & =12a+6 \\\\ 24 & =12a \\\\ a & =2.\\end{aligned}\n$$\n\nNotice that $(2,1)\\in D.$ Therefore, the answer is $a=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-db0e353a-fec5-5d61-839e-8dfe38eddf51"] :db/ensure [:question/validate]} {:db/id "answer-field-db0e353a-fec5-5d61-839e-8dfe38eddf51" :answer-field/id #uuid "db0e353a-fec5-5d61-839e-8dfe38eddf51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea4ec8f7-1073-567c-82c5-5f1ecde10a3e" :answer-field/choices ["answer-50b7b909-d962-51d6-9392-bbe5c3a4f0d0" "answer-ea4ec8f7-1073-567c-82c5-5f1ecde10a3e" "answer-e1ffe2e3-2de3-51af-a5e8-e086627cabd7" "answer-95973894-ec85-559b-89b7-bafc61605c0f" "answer-6bf4c5c6-de83-56d9-bcdb-6036594d8b2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-50b7b909-d962-51d6-9392-bbe5c3a4f0d0" :answer/id #uuid "50b7b909-d962-51d6-9392-bbe5c3a4f0d0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ea4ec8f7-1073-567c-82c5-5f1ecde10a3e" :answer/id #uuid "ea4ec8f7-1073-567c-82c5-5f1ecde10a3e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-e1ffe2e3-2de3-51af-a5e8-e086627cabd7" :answer/id #uuid "e1ffe2e3-2de3-51af-a5e8-e086627cabd7" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-95973894-ec85-559b-89b7-bafc61605c0f" :answer/id #uuid "95973894-ec85-559b-89b7-bafc61605c0f" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6bf4c5c6-de83-56d9-bcdb-6036594d8b2a" :answer/id #uuid "6bf4c5c6-de83-56d9-bcdb-6036594d8b2a" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-510822f4-2240-59da-8db4-5275b43b2562" :question/id #uuid "510822f4-2240-59da-8db4-5275b43b2562" :question/math-academy-id "q-163197" :question/problem "Consider the function $f(x,y)$ and the region $D$ given by\n\n$$\nf(x,y)=2xy,\\,D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{y}{2},\\,0\\le y\\le 4\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ Find $a$ given that $b=3.$" :question/worked-solution "According to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that\n\n$$\n{∬}_{D}f(x,y)\\,\\text{d}A=f(a,b)\\cdot \\text{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}2xy\\,\\text{d}A \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{y/2}2xy\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}[{x}^{2}y]_{x=0}^{x=y/2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}\\frac{{y}^{3}}{4}\\,\\text{d}y \\\\  & =[\\frac{{y}^{4}}{16}]_{y=0}^{y=4} \\\\  & =16.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={\\int }_{0}^{4}{\\int }_{0}^{y/2}\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}[x]_{x=0}^{x=y/2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}\\frac{y}{2}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{4}]}_{y=0}^{y=4} \\\\  & =4.\\end{aligned}\n$$\n\nAlso, we are told that $b=3.$ So, our initial equation simplifies to\n\n$$\n\\begin{aligned}16 & =f(a,3)\\cdot 4 \\\\ 16 & =(2a\\cdot 3)\\cdot 4 \\\\ 16 & =24a \\\\ a & =\\frac{2}{3}.\\end{aligned}\n$$\n\nNotice that $(\\frac{2}{3},3)\\in D.$ Therefore, the answer is $a=\\frac{2}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-421edb72-f508-5f8a-ab68-a626bb9c3ff3"] :db/ensure [:question/validate]} {:db/id "answer-field-421edb72-f508-5f8a-ab68-a626bb9c3ff3" :answer-field/id #uuid "421edb72-f508-5f8a-ab68-a626bb9c3ff3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2b32d836-4282-5cc7-9a51-0ec7993b4598" :answer-field/choices ["answer-0794f66a-f45d-5607-98bd-140c6175658d" "answer-f814775e-bc0c-5f32-a98d-179b8afcfcc4" "answer-bc7fc21c-1500-5e17-a1b2-d0a8f29d6724" "answer-2b32d836-4282-5cc7-9a51-0ec7993b4598" "answer-5932c544-2818-549e-b0bc-0ffb7089e13f"] :db/ensure [:answer-field/validate]} {:db/id "answer-0794f66a-f45d-5607-98bd-140c6175658d" :answer/id #uuid "0794f66a-f45d-5607-98bd-140c6175658d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-f814775e-bc0c-5f32-a98d-179b8afcfcc4" :answer/id #uuid "f814775e-bc0c-5f32-a98d-179b8afcfcc4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-bc7fc21c-1500-5e17-a1b2-d0a8f29d6724" :answer/id #uuid "bc7fc21c-1500-5e17-a1b2-d0a8f29d6724" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-2b32d836-4282-5cc7-9a51-0ec7993b4598" :answer/id #uuid "2b32d836-4282-5cc7-9a51-0ec7993b4598" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5932c544-2818-549e-b0bc-0ffb7089e13f" :answer/id #uuid "5932c544-2818-549e-b0bc-0ffb7089e13f" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-a8b13a1a-6bdb-56d5-b06e-dfa9901c1db1" :question/id #uuid "a8b13a1a-6bdb-56d5-b06e-dfa9901c1db1" :question/math-academy-id "q-163149" :question/problem "Consider the function $f(x,y)$ and the region $D$ given by\n\n$$\nf(x,y)=2x+3{y}^{2},\\,D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ Find $a$ given that $b=1.$" :question/worked-solution "According to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that\n\n$$\n{∬}_{D}f(x,y)\\,\\text{d}A=f(a,b)\\cdot \\text{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}(2x+3{y}^{2})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(2x+3{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}[2xy+{y}^{3}]_{y=0}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(4x+8)\\,\\text{d}x \\\\  & =[2{x}^{2}+8x]_{x=0}^{x=2} \\\\  & =(2\\cdot {2}^{2}+8\\cdot 2)-0 \\\\  & =24.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\text{Area}(D)=2\\cdot 2=4.\n$$\n\nAlso, we are told that $b=1.$ So, our initial equation simplifies to\n\n$$\n\\begin{aligned}24 & =f(a,1)\\cdot 4 \\\\ 24 & =(2a+3\\cdot {1}^{2})\\cdot 4 \\\\ 6 & =2a+3 \\\\ 3 & =2a \\\\ a & =\\frac{3}{2}.\\end{aligned}\n$$\n\nNotice that $(\\frac{3}{2},1)\\in D.$ Therefore, the answer is $a=\\frac{3}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0e005fc3-8464-5bd2-9ea3-7db99a984a04"] :db/ensure [:question/validate]} {:db/id "answer-field-0e005fc3-8464-5bd2-9ea3-7db99a984a04" :answer-field/id #uuid "0e005fc3-8464-5bd2-9ea3-7db99a984a04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c776c1f8-e8aa-56f3-b7bd-cc975451f08b" :answer-field/choices ["answer-85fad9c8-dc51-56ac-8cfd-ba8871833f87" "answer-0af1d0d8-4d56-5266-bc41-27fa5b76576a" "answer-c776c1f8-e8aa-56f3-b7bd-cc975451f08b" "answer-872e6360-ee60-5504-b2e0-a14058beef80" "answer-785b057b-4af7-5e4d-9df3-d94e6d6ae85a"] :db/ensure [:answer-field/validate]} {:db/id "answer-85fad9c8-dc51-56ac-8cfd-ba8871833f87" :answer/id #uuid "85fad9c8-dc51-56ac-8cfd-ba8871833f87" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0af1d0d8-4d56-5266-bc41-27fa5b76576a" :answer/id #uuid "0af1d0d8-4d56-5266-bc41-27fa5b76576a" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c776c1f8-e8aa-56f3-b7bd-cc975451f08b" :answer/id #uuid "c776c1f8-e8aa-56f3-b7bd-cc975451f08b" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-872e6360-ee60-5504-b2e0-a14058beef80" :answer/id #uuid "872e6360-ee60-5504-b2e0-a14058beef80" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-785b057b-4af7-5e4d-9df3-d94e6d6ae85a" :answer/id #uuid "785b057b-4af7-5e4d-9df3-d94e6d6ae85a" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "question-d1845eab-f52b-5f23-bd27-faf40f79c71a" :question/id #uuid "d1845eab-f52b-5f23-bd27-faf40f79c71a" :question/math-academy-id "q-163205" :question/problem "Consider the function $f(x,y)$ and the region $D$ given by\n\n$$\nf(x,y)=2x+y,\\,D=\\{(x,y)\\,:\\,\\frac{y}{2}\\le x\\le y,\\,\\,0\\le y\\le 6\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ Find $a$ given that $b=4.$" :question/worked-solution "According to the mean value theorem for double integrals, there exists a point $(a,b)\\in D$ such that\n\n$$\n{∬}_{D}f(x,y)\\,\\text{d}A=f(a,b)\\cdot \\text{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}(2x+y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{6}{\\int }_{y/2}^{y}(2x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{6}[{x}^{2}+xy]_{x=y/2}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{6}([{y}^{2}+{y}^{2}]-[\\frac{{y}^{2}}{4}+\\frac{{y}^{2}}{2}])\\,\\text{d}y \\\\  & ={\\int }_{0}^{6}\\frac{5{y}^{2}}{4}\\,\\text{d}y \\\\  & ={[\\frac{5{y}^{3}}{12}]}_{y=0}^{y=6} \\\\  & =90.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={\\int }_{0}^{6}{\\int }_{y/2}^{y}\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{6}[x]_{x=y/2}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{6}\\frac{y}{2}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{4}]}_{y=0}^{y=6} \\\\  & =9.\\end{aligned}\n$$\n\nAlso, we are told that $b=4.$ So, our initial equation simplifies to\n\n$$\n\\begin{aligned}90 & =f(a,4)\\cdot 9 \\\\ 90 & =(2a+4)\\cdot 9 \\\\ 10 & =2a+4 \\\\ 6 & =2a \\\\ a & =3.\\end{aligned}\n$$\n\nNotice that $(3,4)\\in D.$ Therefore, the answer is $a=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6c26abb0-e3c4-5856-80ba-2321788c3c2b"] :db/ensure [:question/validate]} {:db/id "answer-field-6c26abb0-e3c4-5856-80ba-2321788c3c2b" :answer-field/id #uuid "6c26abb0-e3c4-5856-80ba-2321788c3c2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9596a5ea-3eda-5d12-a885-036340592f59" :answer-field/choices ["answer-c0180c32-42f3-525a-b857-b3753cd90618" "answer-9596a5ea-3eda-5d12-a885-036340592f59" "answer-5a9d8a94-9534-5e68-924f-dcf67bae6e63" "answer-9993e960-d9b3-5a9c-a231-8dca7a1500f5" "answer-2edca394-1295-57f0-b5af-ed3335a801ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0180c32-42f3-525a-b857-b3753cd90618" :answer/id #uuid "c0180c32-42f3-525a-b857-b3753cd90618" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-9596a5ea-3eda-5d12-a885-036340592f59" :answer/id #uuid "9596a5ea-3eda-5d12-a885-036340592f59" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-5a9d8a94-9534-5e68-924f-dcf67bae6e63" :answer/id #uuid "5a9d8a94-9534-5e68-924f-dcf67bae6e63" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-9993e960-d9b3-5a9c-a231-8dca7a1500f5" :answer/id #uuid "9993e960-d9b3-5a9c-a231-8dca7a1500f5" :answer/type :answer.type/math :answer/value "\\frac{14}{5}" :db/ensure [:answer/validate]} {:db/id "answer-2edca394-1295-57f0-b5af-ed3335a801ae" :answer/id #uuid "2edca394-1295-57f0-b5af-ed3335a801ae" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-bbfd9077-09aa-55c5-a7ec-ce238f7922af" :question/id #uuid "bbfd9077-09aa-55c5-a7ec-ce238f7922af" :question/math-academy-id "q-163240" :question/problem "Find the average value of the function $f(x,y)=y+{x}^{2}$ on the region $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,x\\le y\\le 2x\\}$ given that the area of the region is $2.$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{2}{∬}_{D}y+{x}^{2}\\,\\text{d}A \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{x}^{2x}y+{x}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}[\\frac{{y}^{2}}{2}+{x}^{2}y]_{y=x}^{y=2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}[{x}^{3}+\\frac{3{x}^{2}}{2}]\\,\\text{d}x \\\\  & =\\frac{1}{2}[\\frac{{x}^{4}}{4}+\\frac{{x}^{3}}{2}]_{x=0}^{x=2} \\\\  & =\\frac{1}{2}(8-0) \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-da8ec83a-e269-5c73-bf54-b07a27aefc49"] :db/ensure [:question/validate]} {:db/id "answer-field-da8ec83a-e269-5c73-bf54-b07a27aefc49" :answer-field/id #uuid "da8ec83a-e269-5c73-bf54-b07a27aefc49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-654022a5-61f4-581f-8b07-c11340a40a55" :answer-field/choices ["answer-fc2a60a5-710d-5d16-938e-a0bd54aeac9c" "answer-654022a5-61f4-581f-8b07-c11340a40a55" "answer-1b7b96a3-3ee8-51d8-bf7e-f10bc137dc77" "answer-e98d6b52-9796-58a4-ba09-031961cb2020" "answer-5ea1906a-4d23-5e92-aa42-2516002c4c66"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc2a60a5-710d-5d16-938e-a0bd54aeac9c" :answer/id #uuid "fc2a60a5-710d-5d16-938e-a0bd54aeac9c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-654022a5-61f4-581f-8b07-c11340a40a55" :answer/id #uuid "654022a5-61f4-581f-8b07-c11340a40a55" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-1b7b96a3-3ee8-51d8-bf7e-f10bc137dc77" :answer/id #uuid "1b7b96a3-3ee8-51d8-bf7e-f10bc137dc77" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-e98d6b52-9796-58a4-ba09-031961cb2020" :answer/id #uuid "e98d6b52-9796-58a4-ba09-031961cb2020" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-5ea1906a-4d23-5e92-aa42-2516002c4c66" :answer/id #uuid "5ea1906a-4d23-5e92-aa42-2516002c4c66" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-0fd9a9b1-ea5c-5d82-ac2e-6cadd4a02789" :question/id #uuid "0fd9a9b1-ea5c-5d82-ac2e-6cadd4a02789" :question/math-academy-id "q-163234" :question/problem "Find the average value of the function $f(x,y)=6xy$ on the region $D=\\{(x,y)\\,:\\,0\\le x\\le 2{y}^{2},\\,0\\le y\\le 1\\}$ given that the area of the region is $\\frac{2}{3}.$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{(\\frac{2}{3})}{∬}_{D}6xy\\,\\text{d}A \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}{\\int }_{0}^{2{y}^{2}}6xy\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}[3{x}^{2}y]_{x=0}^{x=2{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{3}{2}{\\int }_{0}^{1}12{y}^{5}\\,\\text{d}y \\\\  & =\\frac{3}{2}[2{y}^{6}]_{y=0}^{y=1} \\\\  & =\\frac{3}{2}(2-0) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0d3f6daa-40ec-59fb-8ee1-def277ce39d2"] :db/ensure [:question/validate]} {:db/id "answer-field-0d3f6daa-40ec-59fb-8ee1-def277ce39d2" :answer-field/id #uuid "0d3f6daa-40ec-59fb-8ee1-def277ce39d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2d41d76-c8a4-5085-9df7-04c8d4913cd0" :answer-field/choices ["answer-b2d41d76-c8a4-5085-9df7-04c8d4913cd0" "answer-f1625dec-f23d-5eb0-987c-e4d1977364f2" "answer-3be8edd8-c7ec-5754-a981-50e1d2d61749" "answer-c33b5db7-e254-5fd2-94ab-40b1cb417d41" "answer-069138e9-203c-5336-a303-692fb1a04b6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2d41d76-c8a4-5085-9df7-04c8d4913cd0" :answer/id #uuid "b2d41d76-c8a4-5085-9df7-04c8d4913cd0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f1625dec-f23d-5eb0-987c-e4d1977364f2" :answer/id #uuid "f1625dec-f23d-5eb0-987c-e4d1977364f2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-3be8edd8-c7ec-5754-a981-50e1d2d61749" :answer/id #uuid "3be8edd8-c7ec-5754-a981-50e1d2d61749" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c33b5db7-e254-5fd2-94ab-40b1cb417d41" :answer/id #uuid "c33b5db7-e254-5fd2-94ab-40b1cb417d41" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-069138e9-203c-5336-a303-692fb1a04b6a" :answer/id #uuid "069138e9-203c-5336-a303-692fb1a04b6a" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id 17592186167135 :question/problem "Find the average value of the function $f(x,y)=14x{y}^{2}$ on the region $D=\\{(x,y)\\,:\\,0\\le x\\le {y}^{2},\\,0\\le y\\le 1\\}$ given that the area of the region is $\\frac{1}{3}.$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{(\\frac{1}{3})}{∬}_{D}14x{y}^{2}\\,\\text{d}A \\\\  & =3{\\int }_{0}^{1}{\\int }_{0}^{{y}^{2}}14x{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =3{\\int }_{0}^{1}[7{x}^{2}{y}^{2}]_{x=0}^{x={y}^{2}}\\,\\text{d}y \\\\  & =3{\\int }_{0}^{1}7{y}^{6}\\,\\text{d}y \\\\  & =3[{y}^{7}]_{y=0}^{y=1} \\\\  & =3(1-0) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186163888 :answer-field/correct 17592186163891 :db/ensure [:answer-field/validate]} {:db/id "question-a3d12aa9-7854-5ac5-a883-81ef95d3c722" :question/id #uuid "a3d12aa9-7854-5ac5-a883-81ef95d3c722" :question/math-academy-id "q-163231" :question/problem "Find the average value of the function $f(x,y)=3{x}^{2}-y$ on the region $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 3\\}.$" :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=2\\cdot 2=4.\n$$\n\nApplying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{4}{∬}_{D}(3{x}^{2}-y)\\,\\text{d}A \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{\\int }_{1}^{3}(3{x}^{2}-y)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{[3{x}^{2}y-\\frac{{y}^{2}}{2}]}_{y=1}^{y=3}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}(6{x}^{2}-4)\\,\\text{d}x \\\\  & =\\frac{1}{4}[2{x}^{3}-4x]_{x=0}^{x=2} \\\\  & =\\frac{1}{4}(2\\cdot {2}^{3}-4\\cdot 2\\cdot 1) \\\\  & =\\frac{8}{4} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f9685638-c235-52d8-a829-db7d8915b067"] :db/ensure [:question/validate]} {:db/id "answer-field-f9685638-c235-52d8-a829-db7d8915b067" :answer-field/id #uuid "f9685638-c235-52d8-a829-db7d8915b067" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b584152a-4a72-5fae-8aff-5821f4148d42" :answer-field/choices ["answer-b584152a-4a72-5fae-8aff-5821f4148d42" "answer-7a750c12-33ce-51e4-9a9c-051ed46ee042" "answer-bc66edf2-7bc3-52d4-a000-d458e2d36c4d" "answer-c21ae479-8299-5656-a0a9-95c5b26e7361" "answer-6b114397-6f41-5b17-af82-49b577e90f08"] :db/ensure [:answer-field/validate]} {:db/id "answer-b584152a-4a72-5fae-8aff-5821f4148d42" :answer/id #uuid "b584152a-4a72-5fae-8aff-5821f4148d42" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-7a750c12-33ce-51e4-9a9c-051ed46ee042" :answer/id #uuid "7a750c12-33ce-51e4-9a9c-051ed46ee042" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-bc66edf2-7bc3-52d4-a000-d458e2d36c4d" :answer/id #uuid "bc66edf2-7bc3-52d4-a000-d458e2d36c4d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c21ae479-8299-5656-a0a9-95c5b26e7361" :answer/id #uuid "c21ae479-8299-5656-a0a9-95c5b26e7361" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6b114397-6f41-5b17-af82-49b577e90f08" :answer/id #uuid "6b114397-6f41-5b17-af82-49b577e90f08" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id 17592186167134 :question/problem "Find the average value of the function $f(x,y)={x}^{2}-4{y}^{3}$ on the region $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 3\\}.$" :db/ensure [:question/validate]} {:db/id "question-3b9226c2-67e0-5858-9c64-ae46c4147a95" :question/id #uuid "3b9226c2-67e0-5858-9c64-ae46c4147a95" :question/math-academy-id "q-163257" :question/problem "Find the average value of the function $f(x,y)={y}^{2}$ on the disk of radius $2$ centered at the origin." :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <2\\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,{[\\frac{{r}^{4}}{4}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta (4-0)\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =2{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =2[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =2\\cdot 2\\pi  \\\\  & =4\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{4\\pi }\\cdot 4\\pi =1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2a10b6cc-8155-5c1e-bf70-aecfcd94d2ca"] :db/ensure [:question/validate]} {:db/id "answer-field-2a10b6cc-8155-5c1e-bf70-aecfcd94d2ca" :answer-field/id #uuid "2a10b6cc-8155-5c1e-bf70-aecfcd94d2ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e360105-eb66-5367-814d-689677702f6e" :answer-field/choices ["answer-c27b400b-e962-57cc-9be7-11f6f93220fa" "answer-7e360105-eb66-5367-814d-689677702f6e" "answer-d99527b4-de43-5d96-9eda-144ff935847e" "answer-9e9f7126-1aec-56cb-a084-4f34d28dafc8" "answer-a79440e4-ebcc-5811-a667-c1e64c7db96b"] :db/ensure [:answer-field/validate]} {:db/id "answer-c27b400b-e962-57cc-9be7-11f6f93220fa" :answer/id #uuid "c27b400b-e962-57cc-9be7-11f6f93220fa" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-7e360105-eb66-5367-814d-689677702f6e" :answer/id #uuid "7e360105-eb66-5367-814d-689677702f6e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-d99527b4-de43-5d96-9eda-144ff935847e" :answer/id #uuid "d99527b4-de43-5d96-9eda-144ff935847e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-9e9f7126-1aec-56cb-a084-4f34d28dafc8" :answer/id #uuid "9e9f7126-1aec-56cb-a084-4f34d28dafc8" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a79440e4-ebcc-5811-a667-c1e64c7db96b" :answer/id #uuid "a79440e4-ebcc-5811-a667-c1e64c7db96b" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "question-b2ff4fa5-a334-50b5-9869-f8e569ec5011" :question/id #uuid "b2ff4fa5-a334-50b5-9869-f8e569ec5011" :question/math-academy-id "q-163256" :question/problem "Find the average value of the function $f(x,y)={e}^{{x}^{2}+{y}^{2}}$ on the disk of radius $\\frac{1}{2}$ centered at the origin." :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\pi \\cdot {(\\frac{1}{2})}^{2}=\\frac{\\pi }{4}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le \\frac{1}{2},\\,0\\le \\theta <2\\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{e}^{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}{e}^{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{e}^{{r}^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{[\\frac{{e}^{{r}^{2}}}{2}]}_{0}^{1/2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(\\frac{{e}^{1/4}}{2}-\\frac{1}{2})\\text{d}\\theta  \\\\  & =\\frac{\\sqrt[4]{e}-1}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{\\sqrt[4]{e}-1}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{\\sqrt[4]{e}-1}{2}(2\\pi -0) \\\\  & =(\\sqrt[4]{e}-1)\\pi .\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{4}{\\pi }\\cdot (\\sqrt[4]{e}-1)\\pi =4(\\sqrt[4]{e}-1).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1136c19-2541-5007-b027-75b59e3253ba"] :db/ensure [:question/validate]} {:db/id "answer-field-d1136c19-2541-5007-b027-75b59e3253ba" :answer-field/id #uuid "d1136c19-2541-5007-b027-75b59e3253ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aaec5f62-9f91-57f5-b958-6eca6bd1c1da" :answer-field/choices ["answer-ff8cb142-efbd-5919-b474-a1189a94a948" "answer-9d49fd2e-9748-5870-a942-7855eab45dc3" "answer-c378d23d-c433-57b0-a302-3ca7d194c79d" "answer-aaec5f62-9f91-57f5-b958-6eca6bd1c1da" "answer-3d66d8b4-c0c5-583c-9422-a56fec563fa4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff8cb142-efbd-5919-b474-a1189a94a948" :answer/id #uuid "ff8cb142-efbd-5919-b474-a1189a94a948" :answer/type :answer.type/math :answer/value "2(\\sqrt[2]{e}+2)" :db/ensure [:answer/validate]} {:db/id "answer-9d49fd2e-9748-5870-a942-7855eab45dc3" :answer/id #uuid "9d49fd2e-9748-5870-a942-7855eab45dc3" :answer/type :answer.type/math :answer/value "2(\\sqrt[4]{e}+1)" :db/ensure [:answer/validate]} {:db/id "answer-c378d23d-c433-57b0-a302-3ca7d194c79d" :answer/id #uuid "c378d23d-c433-57b0-a302-3ca7d194c79d" :answer/type :answer.type/math :answer/value "4(\\sqrt[2]{e}-1)" :db/ensure [:answer/validate]} {:db/id "answer-aaec5f62-9f91-57f5-b958-6eca6bd1c1da" :answer/id #uuid "aaec5f62-9f91-57f5-b958-6eca6bd1c1da" :answer/type :answer.type/math :answer/value "4(\\sqrt[4]{e}-1)" :db/ensure [:answer/validate]} {:db/id "answer-3d66d8b4-c0c5-583c-9422-a56fec563fa4" :answer/id #uuid "3d66d8b4-c0c5-583c-9422-a56fec563fa4" :answer/type :answer.type/math :answer/value "\\sqrt[8]{e}-2" :db/ensure [:answer/validate]} {:db/id "question-b0a81f04-6f59-512d-aa20-c54e3b26a51d" :question/id #uuid "b0a81f04-6f59-512d-aa20-c54e3b26a51d" :question/math-academy-id "q-163277" :question/problem "![](images/06/06a853735916ae3219eea02fa7e7e30d9e941106600cd5b642d951f553aace59.png)\n\nFind the average value of the function $f(x,y)=5y({x}^{2}+{y}^{2})$ on the semicircle shown above." :question/worked-solution "First, notice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {1}^{2}=\\frac{\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(1,0).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that is mind, let's now write the $y=-\\sqrt{2x-{x}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}y & =-\\sqrt{2x-{x}^{2}} \\\\ {y}^{2} & =2x-{x}^{2} \\\\ {x}^{2}+{y}^{2} & =2x \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{cos}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}5y({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}5r\\operatorname{sin}⁡\\theta ((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\operatorname{sin}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {\\int }_{0}^{2\\operatorname{cos}⁡\\theta }5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta [{r}^{5}]_{0}^{2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta ((2\\operatorname{cos}⁡\\theta )^{5}-0)\\,\\text{d}\\theta  \\\\  & =32{\\int }_{-\\pi /2}^{0}\\operatorname{sin}⁡\\theta {cos}^{5}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[-\\frac{1}{6}{cos}^{6}⁡\\theta ]}_{-\\pi /2}^{0} \\\\  & =-\\frac{16}{3}[{cos}^{6}⁡(0)-{cos}^{6}⁡(-\\frac{\\pi }{2})] \\\\  & =-\\frac{16}{3}(1-0) \\\\  & =-\\frac{16}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{(\\frac{\\pi }{2})}\\cdot (-\\frac{16}{3})=-\\frac{32}{3\\pi }.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7e8c2182-159c-53aa-a9ec-6a0270a24944"] :db/ensure [:question/validate]} {:db/id "answer-field-7e8c2182-159c-53aa-a9ec-6a0270a24944" :answer-field/id #uuid "7e8c2182-159c-53aa-a9ec-6a0270a24944" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e979451f-00ff-5ed9-83e8-7aff07a87414" :answer-field/choices ["answer-07e40d47-7a70-5f2c-ba24-6a855b1d6eb7" "answer-e1b2263d-a0be-566e-8984-74cc5d983449" "answer-e979451f-00ff-5ed9-83e8-7aff07a87414" "answer-e83a9fc3-1293-5456-b3e0-ca1e41eb01ee" "answer-43bff162-e0e6-5e6e-b559-7547ee7c72a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-07e40d47-7a70-5f2c-ba24-6a855b1d6eb7" :answer/id #uuid "07e40d47-7a70-5f2c-ba24-6a855b1d6eb7" :answer/type :answer.type/math :answer/value "-\\frac{16}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-e1b2263d-a0be-566e-8984-74cc5d983449" :answer/id #uuid "e1b2263d-a0be-566e-8984-74cc5d983449" :answer/type :answer.type/math :answer/value "-\\frac{16}{5\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-e979451f-00ff-5ed9-83e8-7aff07a87414" :answer/id #uuid "e979451f-00ff-5ed9-83e8-7aff07a87414" :answer/type :answer.type/math :answer/value "-\\frac{32}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-e83a9fc3-1293-5456-b3e0-ca1e41eb01ee" :answer/id #uuid "e83a9fc3-1293-5456-b3e0-ca1e41eb01ee" :answer/type :answer.type/math :answer/value "-\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id "answer-43bff162-e0e6-5e6e-b559-7547ee7c72a5" :answer/id #uuid "43bff162-e0e6-5e6e-b559-7547ee7c72a5" :answer/type :answer.type/math :answer/value "-\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id 17592186167137 :question/problem "Find the average value of the function $f(x,y)=2x+y$ on the portion of the disk of radius $2$ centered at the origin, where $y\\ge 0.$" :question/worked-solution "First, let's sketch our region $D:$ \n\n![](images/b5/b5ba69ab02aa13e201b7b9113f6a36e705ad19e6412499504afc4f239459a8f3.png)\n\nNotice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {2}^{2}=2\\pi .\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}(2x+y)\\,\\text{d}A & ={∬}_{Δ}(2r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,{[\\frac{{r}^{3}}{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )(\\frac{{2}^{3}}{3}-0)\\text{d}\\theta  \\\\  & =\\frac{8}{3}{\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{8}{3}[2\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{0}^{\\pi } \\\\  & =\\frac{8}{3}((2\\operatorname{sin}⁡(\\pi )-\\operatorname{cos}⁡(\\pi ))-(2\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8}{3}(1+1) \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{1}{2\\pi }\\cdot \\frac{16}{3}=\\frac{8}{3\\pi }.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186163900 :answer-field/correct "answer-932abe94-bffd-5dad-a100-ed7dd0878970" :answer-field/choices ["answer-a461f542-25f5-59e6-a3ba-329bd57b7ee7" "answer-3243821a-d8ad-5dd7-aced-e15740550519" "answer-932abe94-bffd-5dad-a100-ed7dd0878970"] :db/ensure [:answer-field/validate]} {:db/id "answer-a461f542-25f5-59e6-a3ba-329bd57b7ee7" :answer/id #uuid "a461f542-25f5-59e6-a3ba-329bd57b7ee7" :answer/type :answer.type/math :answer/value "\\frac{4}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-3243821a-d8ad-5dd7-aced-e15740550519" :answer/id #uuid "3243821a-d8ad-5dd7-aced-e15740550519" :answer/type :answer.type/math :answer/value "\\frac{6}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-932abe94-bffd-5dad-a100-ed7dd0878970" :answer/id #uuid "932abe94-bffd-5dad-a100-ed7dd0878970" :answer/type :answer.type/math :answer/value "\\frac{8}{3\\pi }" :db/ensure [:answer/validate]} {:db/id 17592186281653 :question/worked-solution "First, let's sketch our region $D:$ \n\n![](images/25/25c1f00e588ddaa130f854d9f4e9dfe9b1158d7952a01bae8108ea4b94d3c347.png)\n\nNotice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {3}^{2}=\\frac{9\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2}{{x}^{2}+{y}^{2}+1}\\,\\text{d}A & ={∬}_{Δ}\\frac{2}{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{3}\\frac{2r}{{r}^{2}+1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}[\\operatorname{ln}⁡({r}^{2}+1)]_{0}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{ln}⁡10-\\operatorname{ln}⁡1)\\,\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡10{\\int }_{\\pi /2}^{3\\pi /2}\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡10[\\theta ]_{\\pi /2}^{3\\pi /2} \\\\  & =\\operatorname{ln}⁡10(\\frac{3\\pi }{2}-\\frac{\\pi }{2}) \\\\  & =\\pi \\operatorname{ln}⁡10.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{2}{9\\pi }\\cdot \\pi \\operatorname{ln}⁡10=\\frac{2\\operatorname{ln}⁡10}{9}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186168150 :tutorial/content "Given a continuous function $f(x)$ on a closed interval $[a, b],$ the mean value theorem for integrals guarantees that there exists a number $c \\in [a,b]$ such that\n\n$$\n\\int_a^b f(x)\\, \\textrm d x = f(c) \\cdot (b-a),\n$$\n\nwhich can be visualized as shown below.\n\n![](images/0a/0afb9b15787eb89f73f322290bdbe2288027c54924d274c438773ce151a17291.png)\n\n \n\nWe have a similar theorem for functions with two variables. The so-called **mean value theorem for double integrals** states:\n\n*If the function $f(x,y)$ is continuous on a closed and bounded region $D,$ then there exists a point $(a,b) \\in D$ such that*\n\n$$\n\\iint\\limits_D f(x,y) \\: \\textrm{d}A = f(a,b) \\cdot \\textrm{Area}(D).\n$$\n\nThis has a nice geometrical interpretation when $f$ is non-negative on $D.$ In this case, the theorem tells us that there exists a point $(a,b) \\in D$ such that the volume of the solid enclosed between the surface $z=f(x,y)$ and the $xy$-plane over the region $D$ equals the volume of the right cylinder with base $D$ and height $f(a,b).$ \n\nThe diagram below shows the case when $D$ is rectangular, and the corresponding cylinder is a rectangular solid.\n\n![](images/8e/8ed477207ee61fbdaf963ed8a127e3f1d4cf76707d2eeb4b450fd49f78e15b7e.png)\n\n \n\nIn general, the point $(a,b)$ mentioned in the theorem is not unique. Let's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186168151 :tutorial/content "Consider the continuous function \n\n$$\nf(x,y) = x+3y^2+2\n$$\n\nand the region $D$ given by\n\n$$\nD = \\big\\{ (x,y) \\: : \\: 0 \\leq x \\leq 2, \\: 0 \\leq y \\leq 2 \\big\\}.\n$$\n\nAccording to the mean value theorem for double integrals, there exists a point $(a,b) \\in D$ such that\n\n$$\n\\iint\\limits_D f(x,y) \\: \\textrm{d}A = f(a,b) \\cdot \\textrm{Area}(D).\n$$\n\nEvaluating the integral on the left-hand side, we have\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,\\text{d}A & ={∬}_{D}(x+3{y}^{2}+2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(x+3{y}^{2}+2)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{[xy+{y}^{3}+2y]}_{y=0}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(2x+12)\\,\\text{d}x \\\\  & ={[{x}^{2}+12x]}_{x=0}^{x=2} \\\\  & =28.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\textrm{Area}(D) = 2 \\cdot 2 = 4.\n$$\n\nSo, our mean-value equation simplifies to\n\n$$\n\\begin{aligned}28 & =f(a,b)\\cdot 4 \\\\ 7 & =f(a,b) \\\\ 7 & =a+3{b}^{2}+2 \\\\ a & =5-3{b}^{2}.\\end{aligned}\n$$\n\nThis equation describes part of a parabola in the $xy$-plane, as shown below.\n\n![](images/46/46873c4ecb290380488e589082fc0759324d3540494f5b83e2d64db5d9cdf62a.png)\n\n  \n\nTo find a particular point that satisfies the mean value theorem, we can set, for example, $b=1 \\in [0,2]$ and obtain $a=2.$ So, the point $(2,1)$ satisfies the mean value theorem for double integrals. Consequently, the two solids below must have the same volume.\n\n![](images/82/82d3a762ab323339570e6010038e75ce95f3fdbde958a2ffa876972cbf91e8fb.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186168149 :tutorial/content "Recall that the average value of a continuous function $f(x)$ on a closed interval $D = [a,b]$ is given by\n\n$$\nf_\\textrm{ave} = \\dfrac{1}{\\textrm{Length}(D)}\\int_a^b f(x) \\: \\textrm{d}x.\n$$\n\nThere is an analogous definition for functions of two variables, stated below:\n\n*Suppose $D$ is a closed and bounded region in $\\mathbb{R}^2$ which has non-zero finite area $\\textrm{Area}(D).$ If $f (x, y)$ is a continuous function on $D,$ then **the average value of $\\boldsymbol f$ on $\\boldsymbol D$** is given by*\n\n$$\nf_{\\textrm{ave}} =\\dfrac{1}{\\textrm{Area}(D)} \\, \\iint\\limits_D f(x,y) \\: \\textrm{d}A.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186166974 :activity/expected-seconds 900.0 :db/ensure [:activity/validate]} {:db/id 17592186054626 :knowledge-point/questions ["question-f8176f08-c3fb-5b9f-a7f7-c8961022e13b" "question-0c594a87-b025-5472-b8ba-c9c1f57faafe" "question-8db98389-40f2-5730-bf5c-0c0bb991f194"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054470 :question/problem "Evaluate $|x - 6| + 2 x +3$ for $x = -3.$" :question/worked-solution "We substitute $x = -3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-6|+2x+3 & = \\\\ |-3-6|+2(-3)+3 & = \\\\ |-9|+2(-3)+3 & = \\\\ 9+2(-3)+3 & = \\\\ 9-6+3 & = \\\\ 6\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054627 :knowledge-point/questions ["question-3d01c032-f798-5a69-9d8e-9a45c684623b" "question-b3323b73-981f-531d-b13a-02484111e1fb" "question-8e7406b5-c760-50f7-b793-e44ff061d556"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054471 :question/problem "Evaluate $|2 - x| + 1 + 5|x|$ for $x = 5.$" :question/worked-solution "We substitute $x = 5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2-x|+1+5|x| & = \\\\ |2-5|+1+5|5| & = \\\\ |-3|+1+5(5) & = \\\\ 3+1+25 & = \\\\ 4+25 & = \\\\ 29\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-f8176f08-c3fb-5b9f-a7f7-c8961022e13b" :question/id #uuid "f8176f08-c3fb-5b9f-a7f7-c8961022e13b" :question/math-academy-id "q-215791" :question/problem "If $y=-3,$ then $|2y+7{|}^{6}=${{field-1}}." :question/worked-solution "We substitute $y=-3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+7{|}^{6} & = \\\\ |2(-3)+7{|}^{6} & = \\\\ |-6+7{|}^{6} & = \\\\ |1{|}^{6} & = \\\\ {1}^{6} & = \\\\ 1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0f498857-35a2-5b14-a67d-d149c66e46bb"] :db/ensure [:question/validate]} {:db/id "answer-field-0f498857-35a2-5b14-a67d-d149c66e46bb" :answer-field/id #uuid "0f498857-35a2-5b14-a67d-d149c66e46bb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer-field/choices ["answer-684c058e-fbb0-5665-8e58-bdc2317acb6f"] :db/ensure [:answer-field/validate]} {:db/id "answer-684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/id #uuid "684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-0c594a87-b025-5472-b8ba-c9c1f57faafe" :question/id #uuid "0c594a87-b025-5472-b8ba-c9c1f57faafe" :question/math-academy-id "q-215788" :question/problem "If $x=-2,$ then $|{x}^{3}-x|+2x=${{field-1}}." :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{3}-x|+2x & = \\\\ |(-2)^{3}-(-2)|+2(-2) & = \\\\ |-8+2|-4 & = \\\\ |-6|-4 & = \\\\ 6-4 & = \\\\ 2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-da963681-e81e-570e-8ee7-27f4ce7fcb83"] :db/ensure [:question/validate]} {:db/id "answer-field-da963681-e81e-570e-8ee7-27f4ce7fcb83" :answer-field/id #uuid "da963681-e81e-570e-8ee7-27f4ce7fcb83" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-da556150-891e-5d8b-9f01-4c094a952cfc" :answer-field/choices ["answer-da556150-891e-5d8b-9f01-4c094a952cfc"] :db/ensure [:answer-field/validate]} {:db/id "answer-da556150-891e-5d8b-9f01-4c094a952cfc" :answer/id #uuid "da556150-891e-5d8b-9f01-4c094a952cfc" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-8db98389-40f2-5730-bf5c-0c0bb991f194" :question/id #uuid "8db98389-40f2-5730-bf5c-0c0bb991f194" :question/math-academy-id "q-212311" :question/problem "If $y=10,$ then $|y-15|+2-y=${{field-1}}." :question/worked-solution "We substitute $y=10$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|y-15|+2-y & = \\\\ |10-15|+2-10 & = \\\\ |-5|+2-10 & = \\\\ 5+2-10 & = \\\\ -3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-36e13187-05a7-5f23-83c3-7072e5bce2e1"] :db/ensure [:question/validate]} {:db/id "answer-field-36e13187-05a7-5f23-83c3-7072e5bce2e1" :answer-field/id #uuid "36e13187-05a7-5f23-83c3-7072e5bce2e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3871d1a8-8b5e-554b-aea0-bef649450799" :answer-field/choices ["answer-3871d1a8-8b5e-554b-aea0-bef649450799"] :db/ensure [:answer-field/validate]} {:db/id "answer-3871d1a8-8b5e-554b-aea0-bef649450799" :answer/id #uuid "3871d1a8-8b5e-554b-aea0-bef649450799" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-3d01c032-f798-5a69-9d8e-9a45c684623b" :question/id #uuid "3d01c032-f798-5a69-9d8e-9a45c684623b" :question/math-academy-id "q-215798" :question/problem "If $x=-7,$ then $|x+2|+|x|=${{field-1}}." :question/worked-solution "We substitute $x=-7$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+2|+|x| & = \\\\ |-7+2|+|-7| & = \\\\ |-5|+|-7| & = \\\\ 5+7 & = \\\\ 12 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ae6361ee-8e08-51d0-bc10-6459c6132ecc"] :db/ensure [:question/validate]} {:db/id "answer-field-ae6361ee-8e08-51d0-bc10-6459c6132ecc" :answer-field/id #uuid "ae6361ee-8e08-51d0-bc10-6459c6132ecc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer-field/choices ["answer-069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c"] :db/ensure [:answer-field/validate]} {:db/id "answer-069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/id #uuid "069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id 17592186055103 :question/problem "If $t=0,$ then $|t-2|-|t+3|=${{field-1}}." :question/worked-solution "We substitute $t=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|t-2|-|t+3| & = \\\\ |0-2|-|0+3| & = \\\\ |-2|-|3| & = \\\\ 2-3 & = \\\\ -1 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186052049 :answer-field/correct "answer-e021af68-5d6f-5219-aa63-1cfbae73cd9b" :answer-field/choices ["answer-e021af68-5d6f-5219-aa63-1cfbae73cd9b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e021af68-5d6f-5219-aa63-1cfbae73cd9b" :answer/id #uuid "e021af68-5d6f-5219-aa63-1cfbae73cd9b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-b3323b73-981f-531d-b13a-02484111e1fb" :question/id #uuid "b3323b73-981f-531d-b13a-02484111e1fb" :question/math-academy-id "q-131823" :question/problem "Evaluate $|{2}^{y}|-5|{y}^{2}|$ for $y=3.$" :question/worked-solution "We substitute $y=3$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{2}^{y}|-5|{y}^{2}| & = \\\\ |{2}^{3}|-5|{3}^{2}| & = \\\\ |8|-5|9| & = \\\\ 8-5(9) & = \\\\ 8-45 & = \\\\ -37\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b182bfc6-2593-5081-baaf-c8b369d39b1e"] :db/ensure [:question/validate]} {:db/id "answer-field-b182bfc6-2593-5081-baaf-c8b369d39b1e" :answer-field/id #uuid "b182bfc6-2593-5081-baaf-c8b369d39b1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer-field/choices ["answer-96142681-b0f0-50c5-a1f6-961274b69ff4" "answer-4c4f1470-7854-5859-9502-6ce3be1a1e33" "answer-771e746f-2dfa-570e-8e4f-dfd41179284f" "answer-cafe2d6b-b1ac-5a21-9a9b-b7f3a5473123" "answer-3376d8a9-d9cf-56fe-87c0-0b074a11fc4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-96142681-b0f0-50c5-a1f6-961274b69ff4" :answer/id #uuid "96142681-b0f0-50c5-a1f6-961274b69ff4" :answer/type :answer.type/math :answer/value "-27" :db/ensure [:answer/validate]} {:db/id "answer-4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer/id #uuid "4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer/type :answer.type/math :answer/value "-37" :db/ensure [:answer/validate]} {:db/id "answer-771e746f-2dfa-570e-8e4f-dfd41179284f" :answer/id #uuid "771e746f-2dfa-570e-8e4f-dfd41179284f" :answer/type :answer.type/math :answer/value "-45" :db/ensure [:answer/validate]} {:db/id "answer-cafe2d6b-b1ac-5a21-9a9b-b7f3a5473123" :answer/id #uuid "cafe2d6b-b1ac-5a21-9a9b-b7f3a5473123" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-3376d8a9-d9cf-56fe-87c0-0b074a11fc4f" :answer/id #uuid "3376d8a9-d9cf-56fe-87c0-0b074a11fc4f" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-8e7406b5-c760-50f7-b793-e44ff061d556" :question/id #uuid "8e7406b5-c760-50f7-b793-e44ff061d556" :question/math-academy-id "q-215801" :question/problem "If $y=-2,$ then $|3-{y}^{4}|+|y|-8=${{field-1}}." :question/worked-solution "We substitute $y=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{y}^{4}|+|y|-8 & = \\\\ |3-(-2)^{4}|+|-2|-8 & = \\\\ |3-16|+|-2|-8 & = \\\\ |-13|+|-2|-8 & = \\\\ 13+2-8 & = \\\\ 7 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aceab721-8a64-56ee-a107-a68ea20a149a"] :db/ensure [:question/validate]} {:db/id "answer-field-aceab721-8a64-56ee-a107-a68ea20a149a" :answer-field/id #uuid "aceab721-8a64-56ee-a107-a68ea20a149a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer-field/choices ["answer-6cc06e26-7f7d-5361-947a-a5a6be1a9519"] :db/ensure [:answer-field/validate]} {:db/id "answer-6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/id #uuid "6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186056066 :tutorial/content "Let's take a number, say, $-3.$ We can depict it on a number line as follows:\n\n![](images/de/ded8743284f207bff35eba24617fd4245a69d439ed151d09eed564813f9d72fb.png)\n\nThe *distance* between the number $-3$ and $0$ is known as the **absolute value** of $-3.$ We write it as\n\n$$\n|-3| = {\\color{red}3}.\n$$\n\nSimilarly, $|\\,2\\,|$, the absolute value of the number $2$, is the distance between $2$ and $0$:\n\n![](images/f4/f44fcd05fb0932083d48c8b11892247d8de8fbc46ccf7186fb12843702181aea.png)\n\nWe write $|\\,2\\,| = {\\color{red}2}.$\n\nSo, the absolute value simply \n\n- *removes the minus sign*, if the number is negative, or\n\n- does nothing, if the number is non-negative.\n\nSometimes, we can be asked to evaluate an expression involving the absolute value function, like $|x +1| + 5$ when $x=-3.$ In this case, we evaluate the expression inside the absolute value before simplifying the rest of the expression: \n\n$$\n\\begin{aligned}|x+1|+5 & = \\\\ |(-3)+1|+5 & = \\\\ |-2|+5 & = \\\\ 2+5 & = \\\\ 7 & \\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054936 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186157276 :knowledge-point/questions ["question-8702bab9-12cd-5dfe-a35e-1fe882de5059" "question-d1f6161d-c4cc-5098-b5d8-59c092ed97d0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157080 :question/problem "Given the orthogonal basis $\\mathcal{B}$ of $\\mathbb{R}^3$ and the vector $\\mathbf{x}$ below, find the value of $x_2,$ the second component of $[\\mathbf{x}]_{\\mathcal{B}}.$\n![](images/c4/c4e78bff8fa8544adb2d150f1cbe0ebc47370949b8198b1c495c0b0a84147798.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2,\\,\\mathbf{q}_3.$ \n\nSince $\\mathcal{B}$ is an orthogonal basis, we have that ![](images/0e/0eaf45bf0a651744841124a131304a22353ac85f2ebe5ae12ece10d515656469.svg) where $x_i = \\dfrac{\\mathbf{x} \\cdot \\mathbf{q}_i}{\\mathbf{q}_i \\cdot \\mathbf{q}_i}.$ \n\nComputing $x_2,$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{4\\cdot 1+6\\cdot 1+(-2)\\cdot (-4)}{{1}^{2}+{1}^{2}+(-4)^{2}} \\\\  & =\\frac{4+6+8}{1+1+16} \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186157081 :question/problem "Given the **orthonormal** basis ![](images/48/4870d8e5469a2ccc429a0325a19a422820a65a145fa9651b55fe174b17e59841.svg) of $\\mathbb R^2,$ find $[\\mathbf{x}]_{\\mathcal{B}}$ if ![](images/45/4555a53bc8e10db083aca9cab2ffde97d414f86c5c90366da1b0ace1f82dad5d.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\mathbf{q}_1,\\, \\mathbf{q}_2.$ \n\nSince $\\mathcal{B}$ is an orthonormal basis, we have that ![](images/a7/a7be5a62fbf433bf7c0e324aeb284a9c17cf31df39c2e8cc2a9bc1ace486dc98.svg) where $x_i = \\mathbf{x} \\cdot \\mathbf{q}_i.$ Computing the components of $\\mathbf{x},$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]=-2-6=-8 \\\\ {x}_{2} & =[\\begin{aligned}-2\\sqrt{5} \\\\ 3\\sqrt{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]=-4+3=-1\\end{aligned}\n$$\n\nTherefore, we have ![](images/da/da4ec39d0dbf73a9ec10828d14a2c2f3b0b2907a48e878f97b732d35b02d8200.svg)" :db/ensure [:question/validate]} {:db/id 17592186157768 :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $29{x}_{1}$, where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}3 \\\\ 4 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ -3 \\\\ -3\\end{aligned}],[\\begin{aligned}-18 \\\\ 5 \\\\ -17\\end{aligned}]\\},\\,x=[\\begin{aligned}5 \\\\ -1 \\\\ 2\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id "question-8702bab9-12cd-5dfe-a35e-1fe882de5059" :question/id #uuid "8702bab9-12cd-5dfe-a35e-1fe882de5059" :question/math-academy-id "q-81138" :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $20{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}10 \\\\ -3 \\\\ 5\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}6 \\\\ 25 \\\\ 3\\end{aligned}]\\},\\,x=[\\begin{aligned}3 \\\\ 4 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{3\\cdot 1+4\\cdot 0+(-2)\\cdot (-2)}{{1}^{2}+{0}^{2}+(-2)^{2}} \\\\  & =\\frac{3+4}{1+0+4} \\\\  & =\\frac{7}{5}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n20{x}_{2}=20\\cdot \\frac{7}{5}=28.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-928e03d6-910c-5861-9c3d-cf227edfab96"] :db/ensure [:question/validate]} {:db/id "answer-field-928e03d6-910c-5861-9c3d-cf227edfab96" :answer-field/id #uuid "928e03d6-910c-5861-9c3d-cf227edfab96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5220df4-8827-5dc8-840c-83a4bee32eed" :answer-field/choices ["answer-bc2be4f7-3223-5c2b-ab19-8ce7df237772" "answer-e062c38d-7830-506b-89e8-2800051a142b" "answer-d5220df4-8827-5dc8-840c-83a4bee32eed" "answer-e9f731c8-8b56-5a3c-a03f-ab4777054244" "answer-56ae470a-786d-52a8-ac62-58792ab8b8f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc2be4f7-3223-5c2b-ab19-8ce7df237772" :answer/id #uuid "bc2be4f7-3223-5c2b-ab19-8ce7df237772" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-e062c38d-7830-506b-89e8-2800051a142b" :answer/id #uuid "e062c38d-7830-506b-89e8-2800051a142b" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-d5220df4-8827-5dc8-840c-83a4bee32eed" :answer/id #uuid "d5220df4-8827-5dc8-840c-83a4bee32eed" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-e9f731c8-8b56-5a3c-a03f-ab4777054244" :answer/id #uuid "e9f731c8-8b56-5a3c-a03f-ab4777054244" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-56ae470a-786d-52a8-ac62-58792ab8b8f1" :answer/id #uuid "56ae470a-786d-52a8-ac62-58792ab8b8f1" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id 17592186237890 :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $6{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}4 \\\\ 2\\end{aligned}],[\\begin{aligned}-6 \\\\ 12\\end{aligned}]\\},\\,x=[\\begin{aligned}-9 \\\\ 8\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id 17592186157771 :question/problem "Given the orthogonal basis $B$ of ${R}^{2}$ and the vector $x$ below, find the value of $26{x}_{1},$ where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}-18 \\\\ 27\\end{aligned}]\\},\\,x=[\\begin{aligned}3 \\\\ -1\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id "question-d1f6161d-c4cc-5098-b5d8-59c092ed97d0" :question/id #uuid "d1f6161d-c4cc-5098-b5d8-59c092ed97d0" :question/math-academy-id "q-39491" :question/problem "Given the orthogonal basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $3{x}_{2}$, where ${x}_{2}$ is the second component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],[\\begin{aligned}-3 \\\\ 0 \\\\ 3\\end{aligned}]\\},\\,x=[\\begin{aligned}2 \\\\ -4 \\\\ 2\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2},\\,{q}_{3}.$ \n\nSince $B$ is an orthogonal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$, where ${x}_{i}=\\frac{x\\cdot {q}_{i}}{{q}_{i}\\cdot {q}_{i}}.$ Computing ${x}_{2},$ we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{x\\cdot {q}_{2}}{{q}_{2}\\cdot {q}_{2}} \\\\  & =\\frac{2\\cdot 1+(-4)\\cdot 2+2\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\frac{2-8+2}{1+4+1} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n3{x}_{2}=3\\cdot (-\\frac{2}{3})=-2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bc3a3607-0ff3-5794-9ec9-6e8573576500"] :db/ensure [:question/validate]} {:db/id "answer-field-bc3a3607-0ff3-5794-9ec9-6e8573576500" :answer-field/id #uuid "bc3a3607-0ff3-5794-9ec9-6e8573576500" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1a8cbc89-54fa-519f-83a7-e48a95410f62" :answer-field/choices ["answer-1a8cbc89-54fa-519f-83a7-e48a95410f62" "answer-70a5ffa8-a36b-5443-9016-168b83a69d60" "answer-ad1ad46a-3ef4-5555-bffd-65ab07d26aab" "answer-b7359631-1d40-5953-b4f1-5c9499b96c8a" "answer-426ae1b3-ab3f-577b-8b6d-7704b4df0833"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a8cbc89-54fa-519f-83a7-e48a95410f62" :answer/id #uuid "1a8cbc89-54fa-519f-83a7-e48a95410f62" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-70a5ffa8-a36b-5443-9016-168b83a69d60" :answer/id #uuid "70a5ffa8-a36b-5443-9016-168b83a69d60" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-ad1ad46a-3ef4-5555-bffd-65ab07d26aab" :answer/id #uuid "ad1ad46a-3ef4-5555-bffd-65ab07d26aab" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b7359631-1d40-5953-b4f1-5c9499b96c8a" :answer/id #uuid "b7359631-1d40-5953-b4f1-5c9499b96c8a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-426ae1b3-ab3f-577b-8b6d-7704b4df0833" :answer/id #uuid "426ae1b3-ab3f-577b-8b6d-7704b4df0833" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186237886 :question/problem "Given the **orthonormal** basis $B=\\{[\\begin{aligned}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{aligned}],[\\begin{aligned}\\frac{1}{2} \\\\ -\\frac{\\sqrt{3}}{2}\\end{aligned}]\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}2 \\\\ -2\\end{aligned}].$" :db/ensure [:question/validate]} {:db/id 17592186373456 :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $-\\frac{1}{2}{x}_{3}$, where ${x}_{3}$ is the third component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]\\},\\,x=[\\begin{aligned}-\\sqrt{5} \\\\ \\sqrt{2} \\\\ -\\frac{1}{2}\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id 17592186351234 :question/problem "Given the **orthonormal** basis $B$ of ${R}^{3}$ and the vector $x$ below, find the value of $\\frac{1}{2}{x}_{1}$, where ${x}_{1}$ is the first component of $[x]_{B}.$\n\n$$\nB=\\{[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}],[\\begin{aligned}-\\frac{2}{\\sqrt{14}} \\\\ \\frac{3}{\\sqrt{14}} \\\\ \\frac{1}{\\sqrt{14}}\\end{aligned}],[\\begin{aligned}\\frac{5}{\\sqrt{35}} \\\\ \\frac{3}{\\sqrt{35}} \\\\ \\frac{1}{\\sqrt{35}}\\end{aligned}]\\},\\,x=[\\begin{aligned}2\\sqrt{10} \\\\ \\frac{\\sqrt{10}}{2} \\\\ -\\frac{\\sqrt{10}}{2}\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id 17592186157769 :question/problem "Given the **orthonormal** basis $B=\\{[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}],[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$" :db/ensure [:question/validate]} {:db/id 17592186386000 :question/problem "Given the **orthonormal** basis $B=\\{[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}4 \\\\ 2\\end{aligned}].$" :db/ensure [:question/validate]} {:db/id 17592186158470 :tutorial/content "Given an orthogonal basis $\\mathcal{B}=\\{\\mathbf{q}_1, \\mathbf{q}_2, \\ldots, \\mathbf{q}_n\\}$ of $S=\\textrm{Span}\\{\\mathcal{B}\\},$ there is an easy way to find the components of a vector $\\mathbf{x}\\in S$ with respect to this basis. The vector $\\mathbf{x}$ with respect to the basis $\\mathcal{B}$ is\n![](images/82/82577033f8175a603c2f8b3b47bf5b9a9d568edf03801d58f844ca0007120f64.svg)\n\nFurthermore, if the basis is *orthonormal*, then we know that $\\mathbf{q}_i\\cdot\\mathbf{q}_i=1$. So, the formula for each component is\n![](images/c7/c7ef03afd5772c8446f0864cc470d7375b5ddb30a97a0e19c48cec9c0dc755a4.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186158471 :tutorial/content "Given any vector $\\mathbf{x}$ and any subspace $W$ in $\\mathbb{R}^n,$ we can always write $\\mathbf{x}$ as a sum of a vector from $W$ and a vector from $W^{\\perp}.$ This fact is known as the **orthogonal decomposition theorem.** We can state it formally as follows:\n\n*Let $W$ be a subspace of $\\mathbb{R}^n.$ Then each $\\mathbf{x}\\in\\mathbb{R}^n$ can be written uniquely in the form\n\n$$\n\\mathbf{x}= \\mathbf{y}+\\mathbf{z}\n$$\n\nwhere $\\mathbf{y} \\in W$ and $\\mathbf{z} \\in W^{\\perp}.$* \n\n*Moreover, since $\\mathbf y$ is the orthogonal projection of $\\mathbf x$ onto the subspace $W,$ if $\\{\\mathbf{u}_1\\,\\dots,\\mathbf{u}_p\\}$ is any orthogonal basis of $W,$ then* \n\n$$\n\\begin{aligned}y & ={\\text{proj}}_{W}\\,x \\\\  & ={\\text{proj}}_{{u}_{1}}\\,x+{\\text{proj}}_{{u}_{2}}\\,x+⋯+{\\text{proj}}_{{u}_{p}}\\,x \\\\  & =\\frac{x\\cdot {u}_{1}}{{u}_{1}\\cdot {u}_{1}}{u}_{1}+\\frac{x\\cdot {u}_{2}}{{u}_{2}\\cdot {u}_{2}}{u}_{2}+⋯+\\frac{x\\cdot {u}_{p}}{{u}_{p}\\cdot {u}_{p}}{u}_{p}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186157482 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186162124 :knowledge-point/questions ["question-40beaebe-e39b-5263-8664-2ca0bd457e93" "question-bf85ed85-426f-57b2-8e6b-2867b23718fe" "question-c34fa369-1de0-5740-997b-e34e018ecb92" "question-a1b40ecf-b8ac-57c2-a3f6-1fe3744073eb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161690 :question/problem "Let $X$ and $Y$ be discrete random variables with the joint probability mass function $f(x,y)$ shown below.\n\n| $f$ | $Y=-2$ | $Y=-1$ | $Y=0$ | $Y=2$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.05$ | $0.1$ | $0.2$ |\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F\\left(2,1\\right).$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y) = P(X \\leq x, Y \\leq y) = \\sum\\limits_{x_i \\leq x} \\sum\\limits_{y_i \\leq y} f(x_i, y_i).\n$$\n\nBy definition, we have\n\n$$\n\\begin{aligned}F(2,1) & =P(X\\le 2,Y\\le 1).\\end{aligned}\n$$\n\nWe start by highlighting all cells in the table that correspond to $X \\leq 2, Y \\leq 1.$\n\n| $f$ | $Y=-2$ | $Y=-1$ | $Y=0$ | $Y=2$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.05$ | $0.1$ | $0.2$ |\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}F(2,1) & ={\\sum }_{x\\le 2}{\\sum }_{y\\le 1}f(x,y) \\\\  & =f(1,-2)+f(1,-1)+f(1,0) \\\\  & =0.1+0.3+0.05 \\\\  & =0.45.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186162130 :knowledge-point/questions ["question-9db88b4b-2611-5ba3-82d8-88e768790963" "question-5f664747-7f72-51aa-bfa2-d2cff4da1dfc" "question-c5d1cc22-e243-59a9-86db-8bc6845a4180" "question-5555465c-a779-5eab-9f3a-3128b4e5cfe0" "question-65aabd4c-4895-5cab-b402-d575edfca45d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161696 :question/problem "Suppose ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) and ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg) are discrete random variables. Let the joint CDF of ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) and ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg) be ![](images/45/45ba004dac2f7f8efb58a5071b600dded19307f6fbc2bc376cc780ec2054b4fa.svg) where the supports of ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) and ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg), respectively, are\n\n![](images/bd/bdebc33e3a2a7a5827e1d661c690d7ce8143840da12c2af3f5edda1b59c9e73c.svg)\n\nFind an expression for the corresponding joint CDF when ![](images/7c/7caf891b1437635b9277ccb049e9cfa14c9298681a095f7092576c79176aac2b.svg)" :question/worked-solution "If ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) and ![](images/ab/ab4817775494786b06f0b9cecf225ea5979c035b69c36c1fa078f835524be9e9.svg) are discrete random variables with the joint probability mass function ![](images/7f/7f3705d5dab288c1c6774f437aa18dea961252d741fb302b399cb2ad18112a3a.svg) then the corresponding joint CDF is given by\n\n![](images/46/46c940af81646aebe3e9341b7ce505201025e0e218b65618efe63f57c9879c5d.svg)\n\nNote the following:\n\n- We can think of each point where ![](images/d1/d17e98e4e46a13b4d2d8f97bbcf008c339ed281a929aa3eec7ecdd7b63a9ac92.svg) as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF ![](images/24/246748e439e0fd3d76529b637ab1ac09d2308e45a826924cee283c1e9252e6ea.svg) is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at ![](images/e7/e76592a69e19fffc93e0e39005deba219d59736a203a18c95ebbe2496bd772a7.svg) and whose sides are parallel to the coordinate axis.\n\nGiven the supports of ![](