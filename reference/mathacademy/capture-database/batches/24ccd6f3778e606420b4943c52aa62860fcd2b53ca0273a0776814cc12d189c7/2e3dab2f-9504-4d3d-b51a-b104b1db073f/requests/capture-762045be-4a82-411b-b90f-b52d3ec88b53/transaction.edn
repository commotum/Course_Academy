4-c863d737ab2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/id #uuid "b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/type :answer.type/math :answer/value "77u^{2}-20u-12" :db/ensure [:answer/validate]} {:db/id "question-84908780-ec57-5aef-8661-1e98636ea221" :question/id #uuid "84908780-ec57-5aef-8661-1e98636ea221" :question/math-academy-id "q-111345" :question/problem "$(3k+7)(7k+2)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(3k+7)(7k+2) & = \\\\ 3k(7k+2)+7(7k+2) & = \\\\ 21{k}^{2}+6k+49k+14 & = \\\\ 21{k}^{2}+55k+14\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90bc955a-ad0b-54ff-af0f-b3b9d809da85"] :db/ensure [:question/validate]} {:db/id "answer-field-90bc955a-ad0b-54ff-af0f-b3b9d809da85" :answer-field/id #uuid "90bc955a-ad0b-54ff-af0f-b3b9d809da85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c2babc74-c619-5fbd-b511-3dc958506365" :answer-field/choices ["answer-c2babc74-c619-5fbd-b511-3dc958506365" "answer-1c0fe191-f3df-5f09-b110-f2120896e9c8" "answer-069f88ba-133f-535f-a723-563b81e5b29c" "answer-268d21ce-8e44-5443-9606-72092afa2e67" "answer-979209d8-91c0-5568-969c-cf60d20e453d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2babc74-c619-5fbd-b511-3dc958506365" :answer/id #uuid "c2babc74-c619-5fbd-b511-3dc958506365" :answer/type :answer.type/math :answer/value "21{k}^{2}+55k+14" :db/ensure [:answer/validate]} {:db/id "answer-1c0fe191-f3df-5f09-b110-f2120896e9c8" :answer/id #uuid "1c0fe191-f3df-5f09-b110-f2120896e9c8" :answer/type :answer.type/math :answer/value "21{k}^{2}+56k+9" :db/ensure [:answer/validate]} {:db/id "answer-069f88ba-133f-535f-a723-563b81e5b29c" :answer/id #uuid "069f88ba-133f-535f-a723-563b81e5b29c" :answer/type :answer.type/math :answer/value "21{k}^{2}+5k+14" :db/ensure [:answer/validate]} {:db/id "answer-268d21ce-8e44-5443-9606-72092afa2e67" :answer/id #uuid "268d21ce-8e44-5443-9606-72092afa2e67" :answer/type :answer.type/math :answer/value "21{k}^{2}-55k+14" :db/ensure [:answer/validate]} {:db/id "answer-979209d8-91c0-5568-969c-cf60d20e453d" :answer/id #uuid "979209d8-91c0-5568-969c-cf60d20e453d" :answer/type :answer.type/math :answer/value "21{k}^{2}-5k+14" :db/ensure [:answer/validate]} {:db/id 17592186064596 :question/problem "$(7{u}^{2}-6v)(v-u)=${{field-1}}${u}^{3}\\,+$\n{{field-2}}${u}^{2}v\\,+$\n{{field-3}}$uv\\,-$\n{{field-4}}${v}^{2}$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(7{u}^{2}-6v)(v-u) & = \\\\ 7{u}^{2}(v-u)+(-6v)(v-u) & = \\\\ 7{u}^{2}v-7{u}^{3}-6{v}^{2}+6uv & = \\\\ -7{u}^{3}+7{u}^{2}v+6uv-6{v}^{2}\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186061690 :answer-field/correct "answer-14a3f9bc-2830-5b92-931a-3c810b62441b" :answer-field/choices ["answer-14a3f9bc-2830-5b92-931a-3c810b62441b"] :db/ensure [:answer-field/validate]} {:db/id "answer-14a3f9bc-2830-5b92-931a-3c810b62441b" :answer/id #uuid "14a3f9bc-2830-5b92-931a-3c810b62441b" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id 17592186061692 :answer-field/correct "answer-a2f1bfe9-db04-5089-b55e-98e9532c2a94" :answer-field/choices ["answer-a2f1bfe9-db04-5089-b55e-98e9532c2a94"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2f1bfe9-db04-5089-b55e-98e9532c2a94" :answer/id #uuid "a2f1bfe9-db04-5089-b55e-98e9532c2a94" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186061691 :answer-field/correct "answer-272b01ca-2905-5fd4-8795-37ff6fdbfcd2" :answer-field/choices ["answer-272b01ca-2905-5fd4-8795-37ff6fdbfcd2"] :db/ensure [:answer-field/validate]} {:db/id "answer-272b01ca-2905-5fd4-8795-37ff6fdbfcd2" :answer/id #uuid "272b01ca-2905-5fd4-8795-37ff6fdbfcd2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186061693 :answer-field/correct "answer-402fdbb8-b6b5-5849-b4b5-7740744567bd" :answer-field/choices ["answer-402fdbb8-b6b5-5849-b4b5-7740744567bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-402fdbb8-b6b5-5849-b4b5-7740744567bd" :answer/id #uuid "402fdbb8-b6b5-5849-b4b5-7740744567bd" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-6e37bd4e-5f8a-5417-aabd-8b7d37d96ee7" :question/id #uuid "6e37bd4e-5f8a-5417-aabd-8b7d37d96ee7" :question/math-academy-id "q-111350" :question/problem "$(2{c}^{4}+3d)({c}^{4}+2d)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(2{c}^{4}+3d)({c}^{4}+2d) & = \\\\ 2{c}^{4}({c}^{4}+2d)+3d({c}^{4}+2d) & = \\\\ 2{c}^{8}+4{c}^{4}d+3{c}^{4}d+6{d}^{2} & = \\\\ 2{c}^{8}+7{c}^{4}d+6{d}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d6c24e3c-4bd6-5a5c-b865-47973c2733db"] :db/ensure [:question/validate]} {:db/id "answer-field-d6c24e3c-4bd6-5a5c-b865-47973c2733db" :answer-field/id #uuid "d6c24e3c-4bd6-5a5c-b865-47973c2733db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e451d3cd-f2c4-5e6b-adb0-b9b776390683" :answer-field/choices ["answer-255a116f-8e28-5678-a590-1c837c355838" "answer-e451d3cd-f2c4-5e6b-adb0-b9b776390683" "answer-20451e96-f9f3-5a95-974f-edcf9b7ac2f6" "answer-f9a5874d-090a-5bae-9920-7a31922ca870" "answer-d5ce409f-fc7b-5ac2-b10e-40e80d4d9fcb"] :db/ensure [:answer-field/validate]} {:db/id "answer-255a116f-8e28-5678-a590-1c837c355838" :answer/id #uuid "255a116f-8e28-5678-a590-1c837c355838" :answer/type :answer.type/math :answer/value "2{c}^{8}+4{c}^{4}{d}^{3}-3d{c}^{4}+6{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e451d3cd-f2c4-5e6b-adb0-b9b776390683" :answer/id #uuid "e451d3cd-f2c4-5e6b-adb0-b9b776390683" :answer/type :answer.type/math :answer/value "2{c}^{8}+7{c}^{4}d+6{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-20451e96-f9f3-5a95-974f-edcf9b7ac2f6" :answer/id #uuid "20451e96-f9f3-5a95-974f-edcf9b7ac2f6" :answer/type :answer.type/math :answer/value "2{c}^{8}+{c}^{4}d+6{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f9a5874d-090a-5bae-9920-7a31922ca870" :answer/id #uuid "f9a5874d-090a-5bae-9920-7a31922ca870" :answer/type :answer.type/math :answer/value "2{c}^{8}-4{c}^{4}{d}^{3}+3d{c}^{4}+6{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-d5ce409f-fc7b-5ac2-b10e-40e80d4d9fcb" :answer/id #uuid "d5ce409f-fc7b-5ac2-b10e-40e80d4d9fcb" :answer/type :answer.type/math :answer/value "2{c}^{8}-7{c}^{4}d-6{d}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186065440 :tutorial/content "When we want to multiply two binomials, we take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x + 2),$ we multiply ${\\color{blue}{x}}$ and $(x + 2),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x+2)$:\n\n$$\n\\eqalign{\n\t\t({\\color{blue}{x}} + {\\color{red}{3}})(x + 2) &= \\[5pt]\n\t\t{\\color{blue}{x}}(x + 2) + {\\color{red}{3}}(x + 2) &= \\[5pt]\n\t\tx^2 + 2x + 3x + 6 &= \\[5pt]\n\t\tx^2 + 5x + 6\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186064457 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}]
