11c4-e425-556e-9ed0-200d0e8bd4c4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157431 :knowledge-point/questions ["question-74b59c8c-c1aa-50c4-b3ef-52e18b9395b0" "question-d1c3e141-e136-55c6-9d3b-793077b3eeeb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157143 :question/problem "Solve the inequality ![](images/2a/2abe9cdeada000e13f085d8be9750f26a184e68557283f1bdec4e003afabf173.svg)" :question/worked-solution "First, we isolate the exponential term:\n![](images/c7/c7b01893901c216f2285f49c2fb38819dc193d003881b4e5719867f9c1863844.svg)\n\nNext, recall that a positive number raised to any real power is always positive. Since ![](images/e1/e19edf5f19279dad194a5f66ac4979df2518fedd68e0f768877ee0b5024b3540.svg) we have\n![](images/86/864dbe8402aa67932c2fcb31f22012c4904f575976d1fc62b027bb84443b6c3f.svg)\nfor every real value of ![](images/cf/cff7b257e3c71ec70dc7cd273bdd1cced4254993a43cffbfc338460c21bc7319.svg)\n\nIn particular, every value of ![](images/69/69e8d1fbd034994ec8c4d373a6428eb5f0344c0c9d71f7c624525b550fa73fdb.svg) is greater than ![](images/2e/2ed49f2115a6860b40a8ea69b5672921fb832f8592a69969e4c9f4bb370c1aa6.svg) Therefore,\n![](images/2f/2f954e20489fbbbc6b2a5e7a577ab39e8f4ea3769202c1db83c2db99549caec0.svg)\nfor all real values of ![](images/cf/cff7b257e3c71ec70dc7cd273bdd1cced4254993a43cffbfc338460c21bc7319.svg)\n\nHence, the original inequality is satisfied for all real numbers." :db/ensure [:question/validate]} {:db/id 17592186157432 :knowledge-point/questions ["question-f9ce2daa-e38d-5bb8-b99f-f6261d8e2ed1" "question-36396874-2543-5347-91a0-563733d2b600" "question-1731e842-6496-5676-8984-724a57e1229e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157736 :question/problem "Solve the inequality $2\\cdot {8}^{2x}<\\frac{1}{3}.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}2\\cdot {8}^{2x} & <\\frac{1}{3} \\\\ {8}^{2x} & <\\frac{1}{6}.\\end{aligned}\n$$\n\nThen, taking the logarithm to base $8$ of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({8}^{2x}) & <{log}_{8}⁡(\\frac{1}{6}) \\\\ 2x & <{log}_{8}⁡({6}^{-1}) \\\\ 2x & <-{log}_{8}⁡(6) \\\\ x & <-\\frac{1}{2}{log}_{8}⁡(6).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186155259 :answer-field/correct "answer-f4d0b791-662a-50d7-9a51-777bd93033b6" :answer-field/choices ["answer-f4d0b791-662a-50d7-9a51-777bd93033b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/id #uuid "f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/type :answer.type/text :answer/value "<" :db/ensure [:answer/validate]} {:db/id 17592186155258 :answer-field/correct "answer-fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer-field/choices ["answer-fb7116a0-6991-5a7c-bb2e-44f6d98b2da3"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/id #uuid "fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/type :answer.type/math :answer/value "-\\frac{\\ln 6}{2\\ln 8}" :db/ensure [:answer/validate]} {:db/id 17592186294072 :answer-field/correct "answer-2b25051c-b8bf-5ffe-b946-a66583b2154e" :answer-field/choices ["answer-2b25051c-b8bf-5ffe-b946-a66583b2154e"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b25051c-b8bf-5ffe-b946-a66583b2154e" :answer/id #uuid "2b25051c-b8bf-5ffe-b946-a66583b2154e" :answer/type :answer.type/text :answer/value ">" :db/ensure [:answer/validate]} {:db/id 17592186293989 :answer-field/correct "answer-91970135-4657-52ee-9605-13ea624195a9" :answer-field/choices ["answer-91970135-4657-52ee-9605-13ea624195a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-91970135-4657-52ee-9605-13ea624195a9" :answer/id #uuid "91970135-4657-52ee-9605-13ea624195a9" :answer/type :answer.type/math :answer/value "\\log_{4}(14)" :db/ensure [:answer/validate]} {:db/id 17592186157896 :question/problem "Solve the inequality $3{e}^{x}-4<0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}3{e}^{x}-4 & <0 \\\\ 3{e}^{x} & <4 \\\\ {e}^{x} & <\\frac{4}{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & <\\operatorname{ln}⁡(\\frac{4}{3}) \\\\ x & <\\operatorname{ln}⁡4-\\operatorname{ln}⁡3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186156297 :answer-field/correct "answer-99017c36-c974-535a-a6b7-1a935211faff" :answer-field/choices ["answer-faa1a3c0-c86e-5107-b638-b2b6168befce" "answer-07843e2a-4ff0-5606-88dd-fb6df01f2a02" "answer-99017c36-c974-535a-a6b7-1a935211faff" "answer-acfe2f60-036e-554b-a924-88f87430de8a" "answer-7ee6e0f1-6d16-57f9-853b-709deedcda1e"] :db/ensure [:answer-field/validate]} {:db/id "answer-faa1a3c0-c86e-5107-b638-b2b6168befce" :answer/id #uuid "faa1a3c0-c86e-5107-b638-b2b6168befce" :answer/type :answer.type/math :answer/value "x<\\operatorname{ln}⁡3+\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "answer-07843e2a-4ff0-5606-88dd-fb6df01f2a02" :answer/id #uuid "07843e2a-4ff0-5606-88dd-fb6df01f2a02" :answer/type :answer.type/math :answer/value "x<\\operatorname{ln}⁡3-\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "answer-99017c36-c974-535a-a6b7-1a935211faff" :answer/id #uuid "99017c36-c974-535a-a6b7-1a935211faff" :answer/type :answer.type/math :answer/value "x<\\operatorname{ln}⁡4-\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "answer-acfe2f60-036e-554b-a924-88f87430de8a" :answer/id #uuid "acfe2f60-036e-554b-a924-88f87430de8a" :answer/type :answer.type/math :answer/value "x>\\operatorname{ln}⁡3-\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "answer-7ee6e0f1-6d16-57f9-853b-709deedcda1e" :answer/id #uuid "7ee6e0f1-6d16-57f9-853b-709deedcda1e" :answer/type :answer.type/math :answer/value "x>\\operatorname{ln}⁡4-\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "question-f3a9275d-4331-54c5-bd20-117d217d8aa5" :question/id #uuid "f3a9275d-4331-54c5-bd20-117d217d8aa5" :question/math-academy-id "q-87718" :question/problem "Solve the inequality $5{e}^{x}+2\\le 4.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}5{e}^{x}+2 & \\le 4 \\\\ 5{e}^{x} & \\le 2 \\\\ {e}^{x} & \\le \\frac{2}{5}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & \\le \\operatorname{ln}⁡(\\frac{2}{5}) \\\\ x & \\le \\operatorname{ln}⁡2-\\operatorname{ln}⁡5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41f9833e-1de8-5784-982b-34d3e897640a"] :db/ensure [:question/validate]} {:db/id "answer-field-41f9833e-1de8-5784-982b-34d3e897640a" :answer-field/id #uuid "41f9833e-1de8-5784-982b-34d3e897640a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" :answer-field/choices ["answer-f34a907c-f391-5979-9222-48eb1c76e838" "answer-5e5e4a4c-1f14-58c2-b546-bbbe0317d298" "answer-cf312d58-edda-5e8f-ba13-2b32799659a0" "answer-e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" "answer-50ce5010-9bbd-5ade-899e-fe1a3f097428"] :db/ensure [:answer-field/validate]} {:db/id "answer-f34a907c-f391-5979-9222-48eb1c76e838" :answer/id #uuid "f34a907c-f391-5979-9222-48eb1c76e838" :answer/type :answer.type/math :answer/value "x\\ge \\operatorname{ln}⁡2+\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "answer-5e5e4a4c-1f14-58c2-b546-bbbe0317d298" :answer/id #uuid "5e5e4a4c-1f14-58c2-b546-bbbe0317d298" :answer/type :answer.type/math :answer/value "x\\ge \\operatorname{ln}⁡2-\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "answer-cf312d58-edda-5e8f-ba13-2b32799659a0" :answer/id #uuid "cf312d58-edda-5e8f-ba13-2b32799659a0" :answer/type :answer.type/math :answer/value "x\\le \\operatorname{ln}⁡2+\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "answer-e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" :answer/id #uuid "e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" :answer/type :answer.type/math :answer/value "x\\le \\operatorname{ln}⁡2-\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "answer-50ce5010-9bbd-5ade-899e-fe1a3f097428" :answer/id #uuid "50ce5010-9bbd-5ade-899e-fe1a3f097428" :answer/type :answer.type/math :answer/value "x\\le \\operatorname{ln}⁡5-\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "question-c14a17a4-e51c-5a30-87f2-f52799025a61" :question/id #uuid "c14a17a4-e51c-5a30-87f2-f52799025a61" :question/math-academy-id "q-277850" :question/problem "Solve the inequality $\\frac{3{e}^{x}-{e}^{3/2}}{2\\sqrt{e}}>e.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{3{e}^{x}-{e}^{3/2}}{2\\sqrt{e}} & >e \\\\ 3{e}^{x}-{e}^{3/2} & >2e\\sqrt{e} \\\\ 3{e}^{x}-{e}^{3/2} & >2e\\cdot {e}^{1/2} \\\\ 3{e}^{x}-{e}^{3/2} & >2{e}^{(1+\\frac{1}{2})} \\\\ 3{e}^{x}-{e}^{3/2} & >2{e}^{3/2} \\\\ 3{e}^{x} & >3{e}^{3/2} \\\\ {e}^{x} & >{e}^{3/2}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & >\\operatorname{ln}⁡({e}^{3/2}) \\\\ x & >\\frac{3}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-de8ff1b6-dbc5-59c7-b40e-6086f8c8b93d" "answer-field-b219f5c4-1405-5df3-8409-1c09dc28bb30"] :db/ensure [:question/validate]} {:db/id "answer-field-de8ff1b6-dbc5-59c7-b40e-6086f8c8b93d" :answer-field/id #uuid "de8ff1b6-dbc5-59c7-b40e-6086f8c8b93d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-53d7e613-89f8-5827-98a8-0f87820ea103" :answer-field/choices ["answer-53d7e613-89f8-5827-98a8-0f87820ea103"] :db/ensure [:answer-field/validate]} {:db/id "answer-53d7e613-89f8-5827-98a8-0f87820ea103" :answer/id #uuid "53d7e613-89f8-5827-98a8-0f87820ea103" :answer/type :answer.type/text :answer/value ">" :db/ensure [:answer/validate]} {:db/id "answer-field-b219f5c4-1405-5df3-8409-1c09dc28bb30" :answer-field/id #uuid "b219f5c4-1405-5df3-8409-1c09dc28bb30" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-36c91c58-a410-5c55-87bc-e96d25c23eaa" :answer-field/choices ["answer-36c91c58-a410-5c55-87bc-e96d25c23eaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-36c91c58-a410-5c55-87bc-e96d25c23eaa" :answer/id #uuid "36c91c58-a410-5c55-87bc-e96d25c23eaa" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-b1b6f8d1-34e2-5323-8ed2-7acebb0e0e39" :question/id #uuid "b1b6f8d1-34e2-5323-8ed2-7acebb0e0e39" :question/math-academy-id "q-115220" :question/problem "Solve the inequality $4{(\\frac{2}{7})}^{x-1}-8\\le 0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}4{(\\frac{2}{7})}^{x-1}-8 & \\le 0 \\\\ 4{(\\frac{2}{7})}^{x-1} & \\le 8 \\\\ {(\\frac{2}{7})}^{x-1} & \\le 2.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{2}{7})}^{x-1}] & \\le \\operatorname{ln}⁡2 \\\\ (x-1)\\operatorname{ln}⁡(\\frac{2}{7}) & \\le \\operatorname{ln}⁡2 \\\\ (x-1)(\\operatorname{ln}⁡2-\\operatorname{ln}⁡7) & \\le \\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡2-\\operatorname{ln}⁡7$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x-1 & \\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡7} \\\\ x & \\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡7}+1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-14298f8b-3948-5e99-b379-c1c2f8594591"] :db/ensure [:question/validate]} {:db/id "answer-field-14298f8b-3948-5e99-b379-c1c2f8594591" :answer-field/id #uuid "14298f8b-3948-5e99-b379-c1c2f8594591" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94e97f3c-853a-500e-b908-e2f7624c05ed" :answer-field/choices ["answer-94e97f3c-853a-500e-b908-e2f7624c05ed" "answer-b7154257-b8f9-54a3-83c0-a048530cced6" "answer-850770e0-edac-557e-a109-7fc5d8e886b5" "answer-35eb7433-2b86-503d-88e3-21340443b26e" "answer-0a472223-cb8b-539b-b7c5-6ad022cd38f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-94e97f3c-853a-500e-b908-e2f7624c05ed" :answer/id #uuid "94e97f3c-853a-500e-b908-e2f7624c05ed" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡7}+1" :db/ensure [:answer/validate]} {:db/id "answer-b7154257-b8f9-54a3-83c0-a048530cced6" :answer/id #uuid "b7154257-b8f9-54a3-83c0-a048530cced6" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡7+1}{\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "answer-850770e0-edac-557e-a109-7fc5d8e886b5" :answer/id #uuid "850770e0-edac-557e-a109-7fc5d8e886b5" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡7}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡7}-2" :db/ensure [:answer/validate]} {:db/id "answer-35eb7433-2b86-503d-88e3-21340443b26e" :answer/id #uuid "35eb7433-2b86-503d-88e3-21340443b26e" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡2+1}{\\operatorname{ln}⁡7}" :db/ensure [:answer/validate]} {:db/id "answer-0a472223-cb8b-539b-b7c5-6ad022cd38f3" :answer/id #uuid "0a472223-cb8b-539b-b7c5-6ad022cd38f3" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡7}{\\operatorname{ln}⁡2-1}" :db/ensure [:answer/validate]} {:db/id "question-2013b040-4b7b-5305-9113-8c2d239f0c8e" :question/id #uuid "2013b040-4b7b-5305-9113-8c2d239f0c8e" :question/math-academy-id "q-365305" :question/problem "Solve the inequality $3e-\\frac{1}{2}{(0.99)}^{x}>-2e.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}3e-\\frac{1}{2}{(0.99)}^{x} & >-2e \\\\ -\\frac{1}{2}{(0.99)}^{x} & >-5e \\\\ {(0.99)}^{x} & <10e.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.99)^{x}] & <\\operatorname{ln}⁡(10e) \\\\ x\\operatorname{ln}⁡(0.99) & <\\operatorname{ln}⁡(10e)\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡(0.99)$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & >\\frac{\\operatorname{ln}⁡(10e)}{\\operatorname{ln}⁡(0.99)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1fc155ab-c27b-5344-bdef-c950aecc2f25"] :db/ensure [:question/validate]} {:db/id "answer-field-1fc155ab-c27b-5344-bdef-c950aecc2f25" :answer-field/id #uuid "1fc155ab-c27b-5344-bdef-c950aecc2f25" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c6c3de8-6a0c-504c-945d-c2b5ae34d929" :answer-field/choices ["answer-1300c640-ecde-57fd-837d-d262fb2412e7" "answer-8edd91cd-4c33-519f-b4fc-3d1b8dbd21ca" "answer-eb314a9b-6e16-5467-8ef7-c1e828ba21c6" "answer-8c6c3de8-6a0c-504c-945d-c2b5ae34d929" "answer-49c537e9-a3cd-55e9-8199-34801bb2696a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1300c640-ecde-57fd-837d-d262fb2412e7" :answer/id #uuid "1300c640-ecde-57fd-837d-d262fb2412e7" :answer/type :answer.type/math :answer/value "x<\\frac{\\operatorname{ln}⁡(10e)}{\\operatorname{ln}⁡(0.99)}" :db/ensure [:answer/validate]} {:db/id "answer-8edd91cd-4c33-519f-b4fc-3d1b8dbd21ca" :answer/id #uuid "8edd91cd-4c33-519f-b4fc-3d1b8dbd21ca" :answer/type :answer.type/math :answer/value "x<\\frac{\\operatorname{ln}⁡(10e)}{\\operatorname{ln}⁡(1.98)}" :db/ensure [:answer/validate]} {:db/id "answer-eb314a9b-6e16-5467-8ef7-c1e828ba21c6" :answer/id #uuid "eb314a9b-6e16-5467-8ef7-c1e828ba21c6" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡(0.99)}{\\operatorname{ln}⁡(10e)}" :db/ensure [:answer/validate]} {:db/id "answer-8c6c3de8-6a0c-504c-945d-c2b5ae34d929" :answer/id #uuid "8c6c3de8-6a0c-504c-945d-c2b5ae34d929" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡(10e)}{\\operatorname{ln}⁡(0.99)}" :db/ensure [:answer/validate]} {:db/id "answer-49c537e9-a3cd-55e9-8199-34801bb2696a" :answer/id #uuid "49c537e9-a3cd-55e9-8199-34801bb2696a" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡(10e)}{\\operatorname{ln}⁡(1.98)}" :db/ensure [:answer/validate]} {:db/id "question-46e111c4-e425-556e-9ed0-200d0e8bd4c4" :question/id #uuid "46e111c4-e425-556e-9ed0-200d0e8bd4c4" :question/math-academy-id "q-87829" :question/problem "Solve the inequality ${(0.45)}^{x+3}-10\\ge 0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(0.45)}^{x+3}-10 & \\ge 0 \\\\ {(0.45)}^{x+3} & \\ge 10.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.45)^{x+3}] & \\ge \\operatorname{ln}⁡(10) \\\\ (x+3)\\operatorname{ln}⁡(0.45) & \\ge \\operatorname{ln}⁡(10)\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡(0.45)$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+3 & \\le \\frac{\\operatorname{ln}⁡(10)}{\\operatorname{ln}⁡(0.45)} \\\\ x & \\le \\frac{\\operatorname{ln}⁡(10)}{\\operatorname{ln}⁡(0.45)}-3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ed31c44d-45d6-599a-8504-8f396b5ed76f"] :db/ensure [:question/validate]} {:db/id "answer-field-ed31c44d-45d6-599a-8504-8f396b5ed76f" :answer-field/id #uuid "ed31c44d-45d6-599a-8504-8f396b5ed76f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a290065e-b826-5644-8f29-3001cc4d7b8a" :answer-field/choices ["answer-9b511230-9e3a-54c3-89e3-32a71b42d774" "answer-471adf4a-2ee6-55c5-b17b-f61758f27ffc" "answer-b772fffb-c14a-5583-b222-fea287da527c" "answer-2b1cc1bf-b9c7-5a29-aae6-fd2227f68750" "answer-a290065e-b826-5644-8f29-3001cc4d7b8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b511230-9e3a-54c3-89e3-32a71b42d774" :answer/id #uuid "9b511230-9e3a-54c3-89e3-32a71b42d774" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(0.45)}{\\operatorname{ln}⁡(10)}+3" :db/ensure [:answer/validate]} {:db/id "answer-471adf4a-2ee6-55c5-b17b-f61758f27ffc" :answer/id #uuid "471adf4a-2ee6-55c5-b17b-f61758f27ffc" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(0.45)}{\\operatorname{ln}⁡(10)}-3" :db/ensure [:answer/validate]} {:db/id "answer-b772fffb-c14a-5583-b222-fea287da527c" :answer/id #uuid "b772fffb-c14a-5583-b222-fea287da527c" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡(10)}{3}-\\operatorname{ln}⁡(0.45)" :db/ensure [:answer/validate]} {:db/id "answer-2b1cc1bf-b9c7-5a29-aae6-fd2227f68750" :answer/id #uuid "2b1cc1bf-b9c7-5a29-aae6-fd2227f68750" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡(10)}{\\operatorname{ln}⁡(0.45)}+3" :db/ensure [:answer/validate]} {:db/id "answer-a290065e-b826-5644-8f29-3001cc4d7b8a" :answer/id #uuid "a290065e-b826-5644-8f29-3001cc4d7b8a" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡(10)}{\\operatorname{ln}⁡(0.45)}-3" :db/ensure [:answer/validate]} {:db/id "question-74b59c8c-c1aa-50c4-b3ef-52e18b9395b0" :question/id #uuid "74b59c8c-c1aa-50c4-b3ef-52e18b9395b0" :question/math-academy-id "q-115225" :question/problem "Solve the inequality $\\frac{1}{2}\\cdot {7}^{3x-1}+1>0.$" :question/worked-solution "First, we isolate the exponential term:\n\n$$\n\\begin{aligned}\\frac{1}{2}\\cdot {7}^{3x-1}+1 & >0 \\\\ \\frac{1}{2}\\cdot {7}^{3x-1} & >-1 \\\\ {7}^{3x-1} & >-2.\\end{aligned}\n$$\n\nNext, recall that a positive number raised to any real power is always positive. Since $7>0,$ we have\n\n$$\n{7}^{3x-1}>0\n$$\n\nfor every real value of $x.$\n\nIn particular, every value of ${7}^{3x-1}$ is greater than $-2.$ Therefore,\n\n$$\n{7}^{3x-1}>-2\n$$\n\nfor all real values of $x.$\n\nHence, the original inequality is satisfied for all real numbers." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-98b6ea48-7da3-5707-b0d9-eff4c7665ffd"] :db/ensure [:question/validate]} {:db/id "answer-field-98b6ea48-7da3-5707-b0d9-eff4c7665ffd" :answer-field/id #uuid "98b6ea48-7da3-5707-b0d9-eff4c7665ffd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db8cda54-359f-5abf-a0c6-037e42f00934" :answer-field/choices ["answer-c89862f7-5f6e-5115-848d-958f4d4ddd5f" "answer-a2104c2f-e950-55e6-a073-9450db1a0659" "answer-5ad2df3d-a449-5d94-ab6c-aab6de9bf8c9" "answer-db8cda54-359f-5abf-a0c6-037e42f00934" "answer-7dfad3af-61d9-5b4e-a464-116b7a05b6d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-c89862f7-5f6e-5115-848d-958f4d4ddd5f" :answer/id #uuid "c89862f7-5f6e-5115-848d-958f4d4ddd5f" :answer/type :answer.type/math :answer/value "x>2\\operatorname{ln}⁡7+1" :db/ensure [:answer/validate]} {:db/id "answer-a2104c2f-e950-55e6-a073-9450db1a0659" :answer/id #uuid "a2104c2f-e950-55e6-a073-9450db1a0659" :answer/type :answer.type/math :answer/value "x>2\\operatorname{ln}⁡7-1" :db/ensure [:answer/validate]} {:db/id "answer-5ad2df3d-a449-5d94-ab6c-aab6de9bf8c9" :answer/id #uuid "5ad2df3d-a449-5d94-ab6c-aab6de9bf8c9" :answer/type :answer.type/mat