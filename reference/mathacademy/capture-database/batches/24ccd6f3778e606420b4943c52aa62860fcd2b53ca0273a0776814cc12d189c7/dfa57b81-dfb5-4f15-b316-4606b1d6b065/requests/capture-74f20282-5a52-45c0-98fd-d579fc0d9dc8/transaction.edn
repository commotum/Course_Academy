2-72f5-51d7-bde0-cc38a35c0d8c" :db/ensure [:step/validate]} {:db/id "step-7462aa22-72f5-51d7-bde0-cc38a35c0d8c" :step/id #uuid "7462aa22-72f5-51d7-bde0-cc38a35c0d8c" :step/content 17592186354604 :db/ensure [:step/validate]} [:db/retract 17592186163906 :answer-field/choices 17592186163907] [:db/retract 17592186163906 :answer-field/choices 17592186163908] [:db/retract 17592186163906 :answer-field/choices 17592186163909] [:db/retract 17592186163906 :answer-field/choices 17592186163910] [:db/retract 17592186163906 :answer-field/choices 17592186163911] {:db/id 17592186166791 :knowledge-point/questions ["question-97f38e8d-e7da-59bd-ba74-56efb7ebb5d0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-97f38e8d-e7da-59bd-ba74-56efb7ebb5d0" :question/id #uuid "97f38e8d-e7da-59bd-ba74-56efb7ebb5d0" :question/math-academy-id "q-95741" :question/problem "$$\n\n$\\int \\operatorname{coth}⁡x(2\\operatorname{sinh}⁡x+\\operatorname{csch}⁡x)\\,\\text{d}x=$" :question/worked-solution "$$\n\n$$\n\nFirst, we find the hyperbolic identity that corresponds to the trigonometry identity \n\n$$\n\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.\n$$\n\nUsing Osborn's rule, the corresponding hyperbolic identity is\n\n$$\n\\operatorname{coth}⁡x=\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}.\n$$\n\nNow, we multiply out the parentheses and then use the identity above, as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{coth}⁡x(2\\operatorname{sinh}⁡x+\\operatorname{csch}⁡x)\\,\\text{d}x & =\\int (\\operatorname{coth}⁡x\\cdot 2\\operatorname{sinh}⁡x+\\operatorname{coth}⁡x\\cdot \\operatorname{csch}⁡x)\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}\\cdot 2\\operatorname{sinh}⁡x+\\operatorname{coth}⁡x\\operatorname{csch}⁡x)\\text{d}x \\\\  & =\\int (2\\operatorname{cosh}⁡x+\\operatorname{coth}⁡x\\operatorname{csch}⁡x)\\text{d}x \\\\  & =\\int 2\\operatorname{cosh}⁡x\\,\\text{d}x+\\int \\operatorname{coth}⁡x\\operatorname{csch}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{sinh}⁡x-\\operatorname{csch}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d537a454-077e-5bec-8d5e-c804712b982d"] :db/ensure [:question/validate]} {:db/id "answer-field-d537a454-077e-5bec-8d5e-c804712b982d" :answer-field/id #uuid "d537a454-077e-5bec-8d5e-c804712b982d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ef82bee9-2b28-57a1-b630-a8d70ae2e61d" :answer-field/choices ["answer-efa87d3d-378e-520b-80c5-c18393473402" "answer-ef82bee9-2b28-57a1-b630-a8d70ae2e61d" "answer-d42ea941-f8f4-516d-9716-11327749134c" "answer-2ed2b512-fd94-527c-8aa7-14eb2e253d5c" "answer-677c0d5e-9a4f-53b6-831c-38e8d4e4c8aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-efa87d3d-378e-520b-80c5-c18393473402" :answer/id #uuid "efa87d3d-378e-520b-80c5-c18393473402" :answer/type :answer.type/math :answer/value "2\\operatorname{sinh}⁡x+\\operatorname{csch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-ef82bee9-2b28-57a1-b630-a8d70ae2e61d" :answer/id #uuid "ef82bee9-2b28-57a1-b630-a8d70ae2e61d" :answer/type :answer.type/math :answer/value "2\\operatorname{sinh}⁡x-\\operatorname{csch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-d42ea941-f8f4-516d-9716-11327749134c" :answer/id #uuid "d42ea941-f8f4-516d-9716-11327749134c" :answer/type :answer.type/math :answer/value "2\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-2ed2b512-fd94-527c-8aa7-14eb2e253d5c" :answer/id #uuid "2ed2b512-fd94-527c-8aa7-14eb2e253d5c" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡x-2\\operatorname{sinh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-677c0d5e-9a4f-53b6-831c-38e8d4e4c8aa" :answer/id #uuid "677c0d5e-9a4f-53b6-831c-38e8d4e4c8aa" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡x+2\\operatorname{cosh}⁡x" :db/ensure [:answer/validate]} {:db/id 17592186166793 :knowledge-point/questions ["question-0266df41-acf0-5289-8790-ab60c8f211ab" "question-ba7d332a-6786-594a-94f9-7b21daa8d15e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0266df41-acf0-5289-8790-ab60c8f211ab" :question/id #uuid "0266df41-acf0-5289-8790-ab60c8f211ab" :question/math-academy-id "q-96504" :question/problem "$$\n\nEvaluate ${\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡3}\\frac{1}{{sinh}^{2}⁡(2x)}\\,\\text{d}x.$" :question/worked-solution "$$\n\nFirst, recall the following identity:\n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}\n$$\n\nNow, we rewrite the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡3}\\frac{1}{{sinh}^{2}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡3}{csch}^{2}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=2x.$ Then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=2x.$\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡9$ |\n\nNow, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡3}{csch}^{2}⁡(2x)\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡9}{csch}^{2}⁡u\\,\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡9}{csch}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}(-\\operatorname{coth}⁡u){|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡9} \\\\  & =\\frac{1}{2}(-\\operatorname{coth}⁡(\\operatorname{ln}⁡9)+\\operatorname{coth}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{2}(-\\frac{{e}^{2\\operatorname{ln}⁡9}+1}{{e}^{2\\operatorname{ln}⁡9}-1}+\\frac{{e}^{2\\operatorname{ln}⁡4}+1}{{e}^{2\\operatorname{ln}⁡4}-1}) \\\\  & =\\frac{1}{2}(-\\frac{{9}^{2}+1}{{9}^{2}-1}+\\frac{{4}^{2}+1}{{4}^{2}-1}) \\\\  & =\\frac{1}{2}(-\\frac{41}{40}+\\frac{17}{15}) \\\\  & =\\frac{13}{240}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fca0c653-f489-5a0b-b300-4fbf7f846779"] :db/ensure [:question/validate]} {:db/id "answer-field-fca0c653-f489-5a0b-b300-4fbf7f846779" :answer-field/id #uuid "fca0c653-f489-5a0b-b300-4fbf7f846779" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d5ae3f1-9426-5b71-9c8a-39ff341b203d" :answer-field/choices ["answer-efbf3afe-ee5e-5490-a69f-dee8cd1d6186" "answer-3d5ae3f1-9426-5b71-9c8a-39ff341b203d" "answer-adaf5e80-f765-530e-bb4c-2a9cb2a2639f" "answer-f4838b2c-2ff8-52d4-bfdd-390ae6cc1518" "answer-e3b3d1f0-bf8f-570f-a904-dec2d7f66618"] :db/ensure [:answer-field/validate]} {:db/id "answer-efbf3afe-ee5e-5490-a69f-dee8cd1d6186" :answer/id #uuid "efbf3afe-ee5e-5490-a69f-dee8cd1d6186" :answer/type :answer.type/math :answer/value "\\frac{11}{120}" :db/ensure [:answer/validate]} {:db/id "answer-3d5ae3f1-9426-5b71-9c8a-39ff341b203d" :answer/id #uuid "3d5ae3f1-9426-5b71-9c8a-39ff341b203d" :answer/type :answer.type/math :answer/value "\\frac{13}{240}" :db/ensure [:answer/validate]} {:db/id "answer-adaf5e80-f765-530e-bb4c-2a9cb2a2639f" :answer/id #uuid "adaf5e80-f765-530e-bb4c-2a9cb2a2639f" :answer/type :answer.type/math :answer/value "\\frac{13}{75}" :db/ensure [:answer/validate]} {:db/id "answer-f4838b2c-2ff8-52d4-bfdd-390ae6cc1518" :answer/id #uuid "f4838b2c-2ff8-52d4-bfdd-390ae6cc1518" :answer/type :answer.type/math :answer/value "\\frac{23}{110}" :db/ensure [:answer/validate]} {:db/id "answer-e3b3d1f0-bf8f-570f-a904-dec2d7f66618" :answer/id #uuid "e3b3d1f0-bf8f-570f-a904-dec2d7f66618" :answer/type :answer.type/math :answer/value "\\frac{7}{45}" :db/ensure [:answer/validate]} {:db/id 17592186167138 :question/problem "$\\int \\operatorname{sech}⁡x(\\operatorname{tanh}⁡x-2\\operatorname{cosh}⁡x)\\text{d}x=$" :question/worked-solution "$$\n\n$$\n\nFirst, we recall the following identity:\n\n$$\n\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}\n$$\n\nNow, we multiply out the parentheses and then use the identity above, as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{sech}⁡x(\\operatorname{tanh}⁡x-2\\operatorname{cosh}⁡x)\\text{d}x & =\\int (\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-\\operatorname{sech}⁡x\\cdot 2\\operatorname{cosh}⁡x)\\,\\text{d}x \\\\  & =\\int (\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-\\frac{1}{\\operatorname{cosh}⁡x}\\cdot 2\\operatorname{cosh}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2)\\text{d}x \\\\  & =\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x-\\int 2\\,\\text{d}x \\\\  & =-\\operatorname{sech}⁡x-2x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186163906 :answer-field/correct "answer-efcfb69a-cb84-52fa-83e3-8c5deda2d628" :answer-field/choices ["answer-9751268b-065e-530e-8f61-524e89ea5d81" "answer-efcfb69a-cb84-52fa-83e3-8c5deda2d628" "answer-c58bd0f4-783c-5d87-a549-3f629b85dc92" "answer-d5845fec-c7b4-59ef-afad-7f9f315af72e" "answer-f0f06524-c375-54b5-86ff-27ccebc4476b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9751268b-065e-530e-8f61-524e89ea5d81" :answer/id #uuid "9751268b-065e-530e-8f61-524e89ea5d81" :answer/type :answer.type/math :answer/value "-\\operatorname{csch}⁡x-2x+C" :db/ensure [:answer/validate]} {:db/id "answer-efcfb69a-cb84-52fa-83e3-8c5deda2d628" :answer/id #uuid "efcfb69a-cb84-52fa-83e3-8c5deda2d628" :answer/type :answer.type/math :answer/value "-\\operatorname{sech}⁡x-2x+C" :db/ensure [:answer/validate]} {:db/id "answer-c58bd0f4-783c-5d87-a549-3f629b85dc92" :answer/id #uuid "c58bd0f4-783c-5d87-a549-3f629b85dc92" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡x-2x+C" :db/ensure [:answer/validate]} {:db/id "answer-d5845fec-c7b4-59ef-afad-7f9f315af72e" :answer/id #uuid "d5845fec-c7b4-59ef-afad-7f9f315af72e" :answer/type :answer.type/math :answer/value "\\operatorname{tanh}⁡x-2x+C" :db/ensure [:answer/validate]} {:db/id "answer-f0f06524-c375-54b5-86ff-27ccebc4476b" :answer/id #uuid "f0f06524-c375-54b5-86ff-27ccebc4476b" :answer/type :answer.type/math :answer/value "{sinh}^{2}⁡x-2x+C" :db/ensure [:answer/validate]} {:db/id 17592186166792 :knowledge-point/questions ["question-735acc88-33c3-52d8-953c-ec2e9e0254cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-735acc88-33c3-52d8-953c-ec2e9e0254cb" :question/id #uuid "735acc88-33c3-52d8-953c-ec2e9e0254cb" :question/math-academy-id "q-346480" :question/problem "$$\n\nEvaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}\\frac{{coth}^{2}⁡x}{2{cosh}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "$$\n\n$$\n\nFirst, we write the integral as\n\n$$\n{\\int }_{1}^{2}\\frac{{coth}^{2}⁡x}{2{cosh}^{2}⁡x}\\text{d}x=\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{{cosh}^{2}⁡x}\\cdot {coth}^{2}⁡x\\,\\text{d}x.\n$$\n\nNow we need to find the hyperbolic identity that corresponds to the trigonometric identity \n\n$$\n\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.\n$$\n\nUsing Osborn's rule, the corresponding hyperbolic identity is\n\n$$\n\\operatorname{coth}⁡x=\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}.\n$$\n\nThen, we use the above identity to write the integral as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{{cosh}^{2}⁡x}\\cdot {coth}^{2}⁡x\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{{cosh}^{2}⁡x}\\cdot \\frac{{cosh}^{2}⁡x}{{sinh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{{cosh}^{2}⁡x}{{cosh}^{2}⁡x}\\cdot \\frac{1}{{sinh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{{sinh}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}{csch}^{2}⁡x \\\\  & =-\\frac{1}{2}\\operatorname{coth}⁡x{|}_{1}^{2} \\\\  & =-\\frac{1}{2}\\operatorname{coth}⁡2-\\frac{1}{2}(-\\operatorname{coth}⁡(1)) \\\\  & =\\frac{1}{2}\\operatorname{coth}⁡(1)-\\frac{1}{2}\\operatorname{coth}⁡2 \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}+1}{{e}^{2}-1}-\\frac{{e}^{4}+1}{{e}^{4}-1}) \\\\  & =\\frac{1}{2}(\\frac{({e}^{2}+1)^{2}-({e}^{4}+1)}{({e}^{4}-1)}) \\\\  & =\\frac{{e}^{2}}{{e}^{4}-1}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-40c090a2-44ae-5ef6-9984-cc694c4d8efa"] :db/ensure [:question/validate]} {:db/id "answer-field-40c090a2-44ae-5ef6-9984-cc694c4d8efa" :answer-field/id #uuid "40c090a2-44ae-5ef6-9984-cc694c4d8efa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3a0d7365-f518-5311-a5f3-c5f826b81b2c" :answer-field/choices ["answer-3a0d7365-f518-5311-a5f3-c5f826b81b2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-3a0d7365-f518-5311-a5f3-c5f826b81b2c" :answer/id #uuid "3a0d7365-f518-5311-a5f3-c5f826b81b2c" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{{e}^{4}-1}" :db/ensure [:answer/validate]} {:db/id "question-ba7d332a-6786-594a-94f9-7b21daa8d15e" :question/id #uuid "ba7d332a-6786-594a-94f9-7b21daa8d15e" :question/math-academy-id "q-352941" :question/problem "$$\n\nEvaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡2}3\\operatorname{sech}⁡(3x)\\operatorname{tanh}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "$$\n\nFirst, we find the hyperbolic identities that correspond to the following trigonometric identities:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}\n$$\n\nUsing Osborn's rule, the corresponding hyperbolic identities are\n\n$$\n\\operatorname{tanh}⁡x=\\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x},\\,\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}.\n$$\n\nNow, we rewrite the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}3\\operatorname{sech}⁡(3x)\\operatorname{tanh}⁡(3x)\\,\\text{d}x & =3{\\int }_{0}^{\\operatorname{ln}⁡2}\\operatorname{sech}⁡(3x)\\operatorname{tanh}⁡(3x)\\,\\text{d}x \\\\  & =3{\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{1}{\\operatorname{cosh}⁡(3x)}\\cdot \\frac{\\operatorname{sinh}⁡(3x)}{\\operatorname{cosh}⁡(3x)}\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=3x.$ Then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}u=3\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=3x.$\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡8$ |\n\nNow, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}3{\\int }_{0}^{\\operatorname{ln}⁡2}\\operatorname{sech}⁡(3x)\\operatorname{tanh}⁡(3x)\\,\\text{d}x & ={\\int }_{0}^{\\operatorname{ln}⁡8}\\operatorname{sech}⁡(u)\\operatorname{tanh}⁡(u)\\,\\cdot \\text{d}u \\\\  & =-\\operatorname{sech}⁡(u){|}_{0}^{\\operatorname{ln}⁡8} \\\\  & =-\\operatorname{sech}⁡(\\operatorname{ln}⁡8)+\\operatorname{sech}⁡(0) \\\\  & =-\\frac{1}{\\operatorname{cosh}⁡(\\operatorname{ln}⁡8)}+1 \\\\  & =-\\frac{1}{(\\frac{8+{8}^{-1}}{2})}+1 \\\\  & =-\\frac{1}{(\\frac{65}{16})}+1 \\\\  & =\\frac{49}{65}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-25b5f170-7d01-575f-9c9a-1bf9fe7b0568"] :db/ensure [:question/validate]} {:db/id "answer-field-25b5f170-7d01-575f-9c9a-1bf9fe7b0568" :answer-field/id #uuid "25b5f170-7d01-575f-9c9a-1bf9fe7b0568" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4094b1d6-e49d-5a4c-8130-b945454b28db" :answer-field/choices ["answer-4094b1d6-e49d-5a4c-8130-b945454b28db"] :db/ensure [:answer-field/validate]} {:db/id "answer-4094b1d6-e49d-5a4c-8130-b945454b28db" :answer/id #uuid "4094b1d6-e49d-5a4c-8130-b945454b28db" :answer/type :answer.type/math :answer/value "\\frac{49}{65}" :db/ensure [:answer/validate]} {:db/id "activity-edf24058-88a8-5581-b794-478468ae810a" :activity/id #uuid "edf24058-88a8-5581-b794-478468ae810a" :activity/title "Integration Using Basic Hyperbolic Identities" :activity/type :activity.type/review :activity/scope 17592186048878 :activity/course 17592186046645 :activity/steps ["step-4a24ff8d-4408-5086-a362-5fda8f4d6863" "step-7045c248-0444-5e93-afb7-d434ed35d42a" "step-8ae138ac-bc59-5ae3-a741-0a8c4c2c3c10" "step-867e285f-fea0-51f6-8984-0117bc47c407" "step-5732f6ba-37ef-5624-8851-8bc3a6396c11"] :activity/first-step "step-4a24ff8d-4408-5086-a362-5fda8f4d6863" :db/ensure [:activity/validate]} {:db/id "step-4a24ff8d-4408-5086-a362-5fda8f4d6863" :step/id #uuid "4a24ff8d-4408-5086-a362-5fda8f4d6863" :step/content "question-97f38e8d-e7da-59bd-ba74-56efb7ebb5d0" :step/next "step-7045c248-0444-5e93-afb7-d434ed35d42a" :db/ensure [:step/validate]} {:db/id "step-7045c248-0444-5e93-afb7-d434ed35d42a" :step/id #uuid "7045c248-0444-5e93-afb7-d434ed35d42a" :step/content "question-0266df41-acf0-5289-8790-ab60c8f211ab" :step/next "step-8ae138ac-bc59-5ae3-a741-0a8c4c2c3c10" :db/ensure [:step/validate]} {:db/id "step-8ae138ac-bc59-5ae3-a741-0a8c4c2c3c10" :step/id #uuid "8ae138ac-bc59-5ae3-a741-0a8c4c2c3c10" :step/content 17592186167138 :step/next "step-867e285f-fea0-51f6-8984-0117bc47c407" :db/ensure [:step/validate]} {:db/id "step-867e285f-fea0-51f6-8984-0117bc47c407" :step/id #uuid "867e285f-fea0-51f6-8984-0117bc47c407" :step/content "question-735acc88-33c3-52d8-953c-ec2e9e0254cb" :step/next "step-5732f6ba-37ef-5624-8851-8bc3a6396c11" :db/ensure [:step/validate]} {:db/id "step-5732f6ba-37ef-5624-8851-8bc3a6396c11" :step/id #uuid "5732f6ba-37ef-5624-8851-8bc3a6396c11" :step/content "question-ba7d332a-6786-594a-94f9-7b21daa8d15e" :db/ensure [:step/validate]} {:db/id "activity-69edc7b5-e99c-51bc-925d-b4f0cb17b8a1" :activity/id #uuid "69edc7b5-e99c-51bc-925d-b4f0cb17b8a1" :activity/title "Flux in Three-Dimensional Vector Fields" :activity/type :activity.type/review :activity/scope 17592186050188 :activity/course 17592186046660 :activity/steps ["step-9e6a9636-664b-53c4-ba08-3b6f4a1ddd72" "step-1f385f05-45d4-59c1-9f32-a7029261c4c3" "step-0d825271-0805-5607-9fc6-a19d41bb2583" "step-712af108-5684-50a0-a3e2-b8caf5dce7fc" "step-1271c0a8-c668-5d48-a3f0-44627558c204"] :activity/first-step "step-9e6a9636-664b-53c4-ba08-3b6f4a1ddd72" :db/ensure [:activity/validate]} {:db/id "step-9e6a9636-664b-53c4-ba08-3b6f4a1ddd72" :step/id #uuid "9e6a9636-664b-53c4-ba08-3b6f4a1ddd72" :step/content 17592186167129 :step/next "step-1f385f05-45d4-59c1-9f32-a7029261c4c3" :db/ensure [:step/validate]} {:db/id "step-1f385f05-45d4-59c1-9f32-a7029261c4c3" :step/id #uuid "1f385f05-45d4-59c1-9f32-a7029261c4c3" :step/content 17592186281494 :step/next "step-0d825271-0805-5607-9fc6-a19d41bb2583" :db/ensure [:step/validate]} {:db/id "step-0d825271-0805-5607-9fc6-a19d41bb2583" :step/id #uuid "0d825271-0805-5607-9fc6-a19d41bb2583" :step/content 17592186281496 :step/next "step-712af108-5684-50a0-a3e2-b8caf5dce7fc" :db/ensure [:step/validate]} {:db/id "step-712af108-5684-50a0-a3e2-b8caf5dce7fc" :step/id #uuid "712af108-5684-50a0-a3e2-b8caf5dce7fc" :step/content 17592186370846 :step/next "step-1271c0a8-c668-5d48-a3f0-44627558c204" :db/ensure [:step/validate]} {:db/id "step-1271c0a8-c668-5d48-a3f0-44627558c204" :step/id #uuid "1271c0a8-c668-5d48-a3f0-44627558c204" :step/content 17592186370853 :db/ensure [:step/validate]} {:db/id 17592186092264 :knowledge-point/questions ["question-faab7281-1d54-5c27-a108-8672d8a7d7bc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-faab7281-1d54-5c27-a108-8672d8a7d7bc" :question/id #uuid "faab7281-1d54-5c27-a108-8672d8a7d7bc" :question/math-academy-id "q-11931" :question/problem "Given that $f(x)=\\operatorname{ln}⁡(3x+1)$, find $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{ln}⁡u,\\,u=3x+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot 3 \\\\  & =\\frac{1}{3x+1}\\cdot 3 \\\\  & =\\frac{3}{3x+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3eb65b3e-6b41-59b0-9d94-518769d72256"] :db/ensure [:question/validate]} {:db/id "answer-field-3eb65b3e-6b41-59b0-9d94-518769d72256" :answer-field/id #uuid "3eb65b3e-6b41-59b0-9d94-518769d72256" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60e32486-7db9-572e-bf0b-abb0511aec74" :answer-field/choices ["answer-7fa58aec-2436-55ed-8db4-68bc0b24c12c" "answer-84b40ed1-5a51-5fc6-89ae-d9b2b8b060a6" "answer-e5cbf553-6bf5-593b-adb6-71b0634cb9a2" "answer-60e32486-7db9-572e-bf0b-abb0511aec74" "answer-e777fd40-075b-5a8d-88b7-24757d97d60b"] :db/ensure [:answer-field/validate]} {:db/id "answer-7fa58aec-2436-55ed-8db4-68bc0b24c12c" :answer/id #uuid "7fa58aec-2436-55ed-8db4-68bc0b24c12c" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡(3x+1)" :db/ensure [:answer/validate]} {:db/id "answer-84b40ed1-5a51-5fc6-89ae-d9b2b8b060a6" :answer/id #uuid "84b40ed1-5a51-5fc6-89ae-d9b2b8b060a6" :answer/type :answer.type/math :answer/value "\\frac{1}{3x+1}" :db/ensure [:answer/validate]} {:db/id "answer-e5cbf553-6bf5-593b-adb6-71b0634cb9a2" :answer/id #uuid "e5cbf553-6bf5-593b-adb6-71b0634cb9a2" :answer/type :answer.type/math :answer/value "\\frac{1}{x+1}" :db/ensure [:answer/validate]} {:db/id "answer-60e32486-7db9-572e-bf0b-abb0511aec74" :answer/id #uuid "60e32486-7db9-572e-bf0b-abb0511aec74" :answer/type :answer.type/math :answer/value "\\frac{3}{3x+1}" :db/ensure [:answer/validate]} {:db/id "answer-e777fd40-075b-5a8d-88b7-24757d97d60b" :answer/id #uuid "e777fd40-075b-5a8d-88b7-24757d97d60b" :answer/type :answer.type/math :answer/value "\\frac{3}{x+1}" :db/ensure [:answer/validate]} {:db/id 17592186233100 :question/problem "Find the equation of the tangent to the curve $f(x)=\\operatorname{ln}⁡(4-2x)$ at the point $(1,\\operatorname{ln}⁡2).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{ln}⁡u,\\,u=4-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot (-2) \\\\  & =\\frac{1}{4-2x}\\cdot (-2) \\\\  & =-\\frac{2}{4-2x} \\\\  & =-\\frac{\\cancel{2}}{\\cancel{2}\\cdot (2-x)} \\\\  & =-\\frac{1}{2-x}\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={-\\frac{1}{2-x}|}_{x=1}=-\\frac{1}{2-1}=-1\\,.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,\\operatorname{ln}⁡2)$ is $m=-1.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\operatorname{ln}⁡2 & =-1(x-1) \\\\ y & =-x+1+\\operatorname{ln}⁡2\\end{aligned}\n$$" :question/answer-fields ["answer-field-499c195b-8d64-5d7d-9d3e-bb9baebdfb2e"] :db/ensure [:question/validate]} {:db/id "answer-field-499c195b-8d64-5d7d-9d3e-bb9baebdfb2e" :answer-field/id #uuid "499c195b-8d64-5d7d-9d3e-bb9baebdfb2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6007a77d-8635-5b6c-baa1-e41d26c907eb" :answer-field/choices ["answer-011261f6-f670-587f-9bdd-9a520a83e6ba" "answer-6c6fa548-c78e-5183-aee5-05878a4f08f9" "answer-6007a77d-8635-5b6c-baa1-e41d26c907eb" "answer-ed876f04-a32c-5ff4-8888-d57182793668" "answer-edf7f618-406b-55ec-a4b0-ea2a3cc3aa13"] :db/ensure [:answer-field/validate]} {:db/id "answer-011261f6-f670-587f-9bdd-9a520a83e6ba" :answer/id #uuid "011261f6-f670-587f-9bdd-9a520a83e6ba" :answer/type :answer.type/math :answer/value "y=-x+1" :db/ensure [:answer/validate]} {:db/id "answer-6c6fa548-c78e-5183-aee5-05878a4f08f9" :answer/id #uuid "6c6fa548-c78e-5183-aee5-05878a4f08f9" :answer/type :answer.type/math :answer/value "y=-x+1+4\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-6007a77d-8635-5b6c-baa1-e41d26c907eb" :answer/id #uuid "6007a77d-8635-5b6c-baa1-e41d26c907eb" :answer/type :answer.type/math :answer/value "y=-x+1+\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-ed876f04-a32c-5ff4-8888-d57182793668" :answer/id #uuid "ed876f04-a32c-5ff4-8888-d57182793668" :answer/type :answer.type/math :answer/value "y=-x+\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-edf7f618-406b-55ec-a4b0-ea2a3cc3aa13" :answer/id #uuid "edf7f618-406b-55ec-a4b0-ea2a3cc3aa13" :answer/type :answer.type/math :answer/value "y=-x-1-3\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id 17592186092265 :knowledge-point/questions ["question-694c8d1d-6f8f-5d0d-9977-6900e2cfbc80"] :db/ensure [:knowledge-point/validate]} {:db/id "question-694c8d1d-6f8f-5d0d-9977-6900e2cfbc80" :question/id #uuid "694c8d1d-6f8f-5d0d-9977-6900e2cfbc80" :question/math-academy-id "q-107472" :question/problem "Find the equation of the tangent to the curve $y=\\operatorname{log}⁡(4x+6)$ at the point $(1,1).$" :question/worked-solution "First, we need to find the slope of the tangent line. The slope is equal to the derivative of the curve at the given point:\n\n$$\nm=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1}\n$$\n\nTo compute $\\frac{\\text{d}y}{\\text{d}x},$ we first express $y$ as the composite function\n\n$$\ny=\\operatorname{log}⁡(u),\\,u=4x+6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{u\\operatorname{ln}⁡(10)},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u\\operatorname{ln}⁡(10)}\\cdot 4 \\\\  & =\\frac{4}{(4x+6)\\operatorname{ln}⁡(10)} \\\\  & =\\frac{2}{(2x+3)\\operatorname{ln}⁡(10)}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1} \\\\  & =\\frac{2}{(2x+3)\\operatorname{ln}⁡(10)}{|}_{x=1} \\\\  & =\\frac{2}{(2(1)+3)\\operatorname{ln}⁡(10)} \\\\  & =\\frac{2}{5\\operatorname{ln}⁡(10)}.\\end{aligned}\\end{aligned}\n$$\n\nNow we know that the slope of the tangent line at the point $(1,1)$ is $m=\\frac{2}{5\\operatorname{ln}⁡(10)}.$ Finally, we find the equation of the tangent line at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{2}{5\\operatorname{ln}⁡(10)}(x-1) \\\\ y & =\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡10}+1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-12a6637d-3fa8-57d6-a18a-381344c8f764"] :db/ensure [:question/validate]} {:db/id "answer-field-12a6637d-3fa8-57d6-a18a-381344c8f764" :answer-field/id #uuid "12a6637d-3fa8-57d6-a18a-381344c8f764" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ede9697-6d3d-5e61-a427-35aecef7a252" :answer-field/choices ["answer-35a68164-9e76-57b2-aab1-2d80d9c78b2c" "answer-06923402-c07c-528b-a298-0b8a71448268" "answer-0677b7f9-d152-5eed-97e5-8f5592a31657" "answer-2ede9697-6d3d-5e61-a427-35aecef7a252" "answer-b233612d-1ef2-5a1d-af72-2a0729071ac6"] :db/ensure [:answer-field/validate]} {:db/id "answer-35a68164-9e76-57b2-aab1-2d80d9c78b2c" :answer/id #uuid "35a68164-9e76-57b2-aab1-2d80d9c78b2c" :answer/type :answer.type/math :answer/value "y=-\\frac{2x}{5\\operatorname{ln}⁡(10)}+\\frac{2}{5\\operatorname{ln}⁡(10)}+1" :db/ensure [:answer/validate]} {:db/id "answer-06923402-c07c-528b-a298-0b8a71448268" :answer/id #uuid "06923402-c07c-528b-a298-0b8a71448268" :answer/type :answer.type/math :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}+1" :db/ensure [:answer/validate]} {:db/id "answer-0677b7f9-d152-5eed-97e5-8f5592a31657" :answer/id #uuid "0677b7f9-d152-5eed-97e5-8f5592a31657" :answer/type :answer.type/math :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡(10)}" :db/ensure [:answer/validate]} {:db/id "answer-2ede9697-6d3d-5e61-a427-35aecef7a252" :answer/id #uuid "2ede9697-6d3d-5e61-a427-35aecef7a252" :answer/type :answer.type/math :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡(10)}+1" :db/ensure [:answer/validate]} {:db/id "answer-b233612d-1ef2-5a1d-af72-2a0729071ac6" :answer/id #uuid "b233612d-1ef2-5a1d-af72-2a0729071ac6" :answer/type :answer.type/math :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "activity-4163d0cc-c56a-5718-9ce6-a0070aa91ee4" :activity/id #uuid "4163d0cc-c56a-5718-9ce6-a0070aa91ee4" :activity/title "The Chain Rule With Logarithmic Functions" :activity/type :activity.type/review :activity/scope 17592186049332 :activity/course 17592186046647 :activity/steps ["step-e22638d2-4c46-5db8-9072-104c4a9a278c" "step-b0ad1a3e-52d2-5769-a49d-34e5806ad438" "step-1598bc67-4403-5bf2-9b72-cfab9c69ea72"] :activity/first-step "step-e22638d2-4c46-5db8-9072-104c4a9a278c" :db/ensure [:activity/validate]} {:db/id "step-e22638d2-4c46-5db8-9072-104c4a9a278c" :step/id #uuid "e22638d2-4c46-5db8-9072-104c4a9a278c" :step/content "question-faab7281-1d54-5c27-a108-8672d8a7d7bc" :step/next "step-b0ad1a3e-52d2-5769-a49d-34e5806ad438" :db/ensure [:step/validate]} {:db/id "step-b0ad1a3e-52d2-5769-a49d-34e5806ad438" :step/id #uuid "b0ad1a3e-52d2-5769-a49d-34e5806ad438" :step/content 17592186233100 :step/next "step-1598bc67-4403-5bf2-9b72-cfab9c69ea72" :db/ensure [:step/validate]} {:db/id "step-1598bc67-4403-5bf2-9b72-cfab9c69ea72" :step/id #uuid "1598bc67-4403-5bf2-9b72-cfab9c69ea72" :step/content "question-694c8d1d-6f8f-5d0d-9977-6900e2cfbc80" :db/ensure [:step/validate]} {:db/id "activity-0e84b2fb-4cf2-5c9f-98bb-5999f15e2bd4" :activity/id #uuid "0e84b2fb-4cf2-5c9f-98bb-5999f15e2bd4" :activity/title "Calculating Flux Through Cartesian Surfaces" :activity/type :activity.type/review :activity/scope 17592186048253 :activity/course 17592186046660 :activity/steps ["step-4105b6fe-4490-51ed-ab36-ff7ad9a443aa" "step-c55337c0-db12-5a83-8b19-0b1d1ecef642" "step-21e5af0d-5744-5b51-88fc-a24cd228d975"] :activity/first-step "step-4105b6fe-4490-51ed-ab36-ff7ad9a443aa" :db/ensure [:activity/validate]} {:db/id "step-4105b6fe-4490-51ed-ab36-ff7ad9a443aa" :step/id #uuid "4105b6fe-4490-51ed-ab36-ff7ad9a443aa" :step/content 17592186423121 :step/next "step-c55337c0-db12-5a83-8b19-0b1d1ecef642" :db/ensure [:step/validate]} {:db/id "step-c55337c0-db12-5a83-8b19-0b1d1ecef642" :step/id #uuid "c55337c0-db12-5a83-8b19-0b1d1ecef642" :step/content 17592186278519 :step/next "step-21e5af0d-5744-5b51-88fc-a24cd228d975" :db/ensure [:step/validate]} {:db/id "step-21e5af0d-5744-5b51-88fc-a24cd228d975" :step/id #uuid "21e5af0d-5744-5b51-88fc-a24cd228d975" :step/content 17592186278545 :db/ensure [:step/validate]} {:db/id 17592186354377 :question/problem "Diana is choosing a $4$-digit passcode for her cellphone from the digits $\\{1,2,3,4,5,6\\},$ where no digit is used more than once. How many different passcodes are possible?" :db/ensure [:question/validate]} {:db/id "activity-9b7dddb8-f5d3-50d8-8850-49a9edd54ed3" :activity/id #uuid "9b7dddb8-f5d3-50d8-8850-49a9edd54ed3" :activity/title "Permutations" :activity/type :activity.type/review :activity/scope 17592186048254 :activity/course 17592186046647 :activity/steps ["step-829b7a87-c027-5f43-a68b-2f01748a8b77" "step-c2ce084d-6690-5deb-88e4-1d78920f59c2" "step-045008b5-fd03-57e6-bcb7-b6dce658010d"] :activity/first-step "step-829b7a87-c027-5f43-a68b-2f01748a8b77" :db/ensure [:activity/validate]} {:db/id "step-829b7a87-c027-5f43-a68b-2f01748a8b77" :step/id #uuid "829b7a87-c027-5f43-a68b-2f01748a8b77" :step/content 17592186284770 :step/next "step-c2ce084d-6690-5deb-88e4-1d78920f59c2" :db/ensure [:step/validate]} {:db/id "step-c2ce084d-6690-5deb-88e4-1d78920f59c2" :step/id #uuid "c2ce084d-6690-5deb-88e4-1d78920f59c2" :step/content 17592186332933 :step/next "step-045008b5-fd03-57e6-bcb7-b6dce658010d" :db/ensure [:step/validate]} {:db/id "step-045008b5-fd03-57e6-bcb7-b6dce658010d" :step/id #uuid "045008b5-fd03-57e6-bcb7-b6dce658010d" :step/content 17592186354377 :db/ensure [:step/validate]} [:db/retract 17592186089645 :answer-field/choices 17592186089648] [:db/retract 17592186089645 :answer-field/choices 17592186089649] [:db/retract 17592186089645 :answer-field/choices 17592186089650] [:db/retract 17592186089645 :answer-field/choices 17592186089646] [:db/retract 17592186089645 :answer-field/choices 17592186089647] [:db/retract 17592186089531 :answer-field/choices 17592186089536] [:db/retract 17592186089531 :answer-field/choices 17592186089532] [:db/retract 17592186089531 :answer-field/choices 17592186089533] [:db/retract 17592186089531 :answer-field/choices 17592186089534] [:db/retract 17592186089531 :answer-field/choices 17592186089535] {:db/id 17592186092330 :knowledge-point/questions ["question-33c4f786-72e7-5bcb-ae24-ddbd9884bcad" "question-c05d07c3-d88b-5f15-ae17-7072be0fa8fc" "question-f4cb9239-3b4d-5884-8d60-86ece34323bd" "question-a7dfbbbd-1a36-5131-be23-c3a22a696cb3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186091934 :question/problem "Let $\\mathbf{X} = [X_1, X_2]^T$ be a bivariate normal random vector. The variances of $X_1$ and $X_2$ and their correlation coefficient are given by\n\n$$\n\\sigma_1^2=9,\\qquad \\sigma_2^2 = 1, \\qquad \\rho = \\dfrac1{3}.\n$$\n\nGiven that the joint probability density function of $\\mathbf X$ is\n\n$$\nf(\\mathbf x) = \\dfrac1k\\,\\mathrm{exp}\\left( -\\dfrac 12(\\mathbf x - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf x - \\boldsymbol \\mu)\\right),\n$$\n\nwhere $\\boldsymbol{\\mu}$ is the mean vector and $\\Sigma$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere $\\sigma^2_i = \\textrm{Var}[X_i],$ $\\sigma_{12} = \\textrm{Cov}[X_1,X_2],$ and $\\rho$ is the correlation, then the joint probability density function of $\\mathbf X$ is\n\n$$\nf(\\mathbf x) = \\dfrac{1}{2\\pi\\sqrt{|\\Sigma|}} \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf x - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf x - \\boldsymbol \\mu)\\right)\n$$\n\nand $|\\Sigma|$ denotes the determinant of $\\Sigma.$\n\nUsing the given values of $\\sigma^2_1, \\sigma^2_2$, and $\\rho,$ our covariance matrix is\n\n![](images/f4/f44326b7be98378285978658be508da822c110d5d61e8950872cc75c4296d7ae.svg)\n\nTherefore,\n\n$$\n|\\Sigma| = 9\\cdot 1 - 1\\cdot 1 = 8.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{8}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{4\\pi \\sqrt{2}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=4\\pi\\sqrt 2.$" :db/ensure [:question/validate]} {:db/id 17592186092331 :knowledge-point/questions ["question-de58daf1-e39b-5442-89f0-7a159aadbac7" "question-3b8afbc1-6271-57eb-9548-1efb5cfd889f" "question-485fd77f-8eb8-5250-aed7-606fdfdfa4f3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186091935 :question/problem "Let $\\mathbf{X} = [X_1,X_2]^T$ be a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}2 \\\\ -1\\end{aligned}],\\,Σ=[\\begin{aligned}4 & -3 \\\\ -3 & 7\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y = 3X_1 + X_2 .$" :question/worked-solution "Recall that if $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY= aX_1 + bX_2\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have $\\mu_1 = 2$ and $\\mu_2 = -1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[3{X}_{1}+{X}_{2}] \\\\  & =3\\text{E}[{X}_{1}]+\\text{E}[{X}_{2}] \\\\  & =3\\cdot {\\mu }_{1}+{\\mu }_{2} \\\\  & =3\\cdot 2+(-1) \\\\  & =5.\\end{aligned}\n$$\n\nAlso, we have $\\sigma_1^2 = 4, \\sigma_2^2 = 7,$ and $\\sigma_{12} = \\sigma_{21} = -3.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[3{X}_{1}+{X}_{2}] \\\\  & ={3}^{2}\\cdot 4+{1}^{2}\\cdot 7+2\\cdot 3\\cdot 1\\cdot (-3) \\\\  & =36+7-18 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY \\sim N(5,25).\n$$" :db/ensure [:question/validate]} {:db/id 17592186092332 :knowledge-point/questions ["question-a69ab04f-b52a-5382-92a0-123e6cfce6f9" "question-5760ff2c-7d2e-56c5-873e-f2312179cd86" "question-b7717a0a-c395-5f69-ba3c-1ca2b2b29ed2" "question-279fa865-ddd8-5bba-a76f-e827f503b5bb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186091936 :question/problem "Let $\\mathbf{X} = [X_1, X_2,X_3]^T$ be a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,Σ=[\\begin{aligned}6 & 1 & 2 \\\\ 1 & 3 & 2 \\\\ 2 & 2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y = X_1 -2X_2 +4 X_3.$" :question/worked-solution "Recall that if $\\mathbf{X} =  [X_1, X_2, \\ldots, X_k]^T$ is a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ then the random variable $Y,$ defined as\n\n$$\nY= \\mathbf c^T \\mathbf X = \\sum_{i=1}^k c_i X_i\n$$\n\nis a normally distributed random variable, where $\\mathbf c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y = X_1 -2X_2 +4 X_3,$ we have \n\n![](images/12/129ff41cb0fc5917efdc4f990d3d2efeb7546911eadb52340156f1ddc4f9d92f.svg)\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}1 & -2 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =1-4+4 \\\\  & =1,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}1 & -2 & 4\\end{aligned}][\\begin{aligned}6 & 1 & 2 \\\\ 1 & 3 & 2 \\\\ 2 & 2 & 4\\end{aligned}][\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 & 4\\end{aligned}][\\begin{aligned}12 \\\\ 3 \\\\ 14\\end{aligned}] \\\\  & =12-6+56 \\\\  & =62.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY\\sim N(1,62).\n$$" :db/ensure [:question/validate]} {:db/id "question-33c4f786-72e7-5bcb-ae24-ddbd9884bcad" :question/id #uuid "33c4f786-72e7-5bcb-ae24-ddbd9884bcad" :question/math-academy-id "q-159742" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their correlation coefficient are given by\n\n$$\n{\\sigma }_{1}^{2}=5,\\,{\\sigma }_{2}^{2}=5,\\,\\rho =\\frac{4}{5}.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{2\\pi \\sqrt{|Σ|}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and $\\rho ,$ our covariance matrix is\n\n$$\nΣ=[\\begin{aligned}5 & \\frac{4}{5}\\cdot \\sqrt{5}\\cdot \\sqrt{5} \\\\ \\frac{4}{5}\\cdot \\sqrt{5}\\cdot \\sqrt{5} & 5\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ 4 & 5\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|Σ|=5\\cdot 5-4\\cdot 4=9.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{9}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{6\\pi }exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=6\\pi .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c7b0e0da-9a99-5474-9c0a-b2662fde58bf"] :db/ensure [:question/validate]} {:db/id "answer-field-c7b0e0da-9a99-5474-9c0a-b2662fde58bf" :answer-field/id #uuid "c7b0e0da-9a99-5474-9c0a-b2662fde58bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3f8cc3d-0caa-56a5-a312-f8f8ce8113b1" :answer-field/choices ["answer-929fe2cb-8abf-58de-b2d1-55a8dc7e08de" "answer-63d4b36e-a125-56e6-8dc4-26be28600df9" "answer-bb9e42d2-b0f5-554b-badc-9745ae7fdb7c" "answer-f3f8cc3d-0caa-56a5-a312-f8f8ce8113b1" "answer-a0a9103e-fc08-541d-9d5c-4caa1baddaf7"] :db/ensure [:answer-field/validate]} {:db/id "answer-929fe2cb-8abf-58de-b2d1-55a8dc7e08de" :answer/id #uuid "929fe2cb-8abf-58de-b2d1-55a8dc7e08de" :answer/type :answer.type/math :answer/value "12\\pi " :db/ensure [:answer/validate]} {:db/id "answer-63d4b36e-a125-56e6-8dc4-26be28600df9" :answer/id #uuid "63d4b36e-a125-56e6-8dc4-26be28600df9" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-bb9e42d2-b0f5-554b-badc-9745ae7fdb7c" :answer/id #uuid "bb9e42d2-b0f5-554b-badc-9745ae7fdb7c" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-f3f8cc3d-0caa-56a5-a312-f8f8ce8113b1" :answer/id #uuid "f3f8cc3d-0caa-56a5-a312-f8f8ce8113b1" :answer/type :answer.type/math :answer/value "6\\pi " :db/ensure [:answer/validate]} {:db/id "answer-a0a9103e-fc08-541d-9d5c-4caa1baddaf7" :answer/id #uuid "a0a9103e-fc08-541d-9d5c-4caa1baddaf7" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-c05d07c3-d88b-5f15-ae17-7072be0fa8fc" :question/id #uuid "c05d07c3-d88b-5f15-ae17-7072be0fa8fc" :question/math-academy-id "q-159744" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their correlation coefficient are given by\n\n$$\n{\\sigma }_{1}^{2}=20,\\,{\\sigma }_{2}^{2}=5,\\,\\rho =-\\frac{3}{5}.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{2\\pi \\sqrt{|Σ|}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and $\\rho ,$ our covariance matrix is\n\n$$\nΣ=[\\begin{aligned}20 & -\\frac{3}{5}\\cdot \\sqrt{20}\\cdot \\sqrt{5} \\\\ -\\frac{3}{5}\\cdot \\sqrt{20}\\cdot \\sqrt{5} & 5\\end{aligned}]=[\\begin{aligned}20 & -6 \\\\ -6 & 5\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|Σ|=20\\cdot 5-(-6)\\cdot (-6)=64.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{64}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{16\\pi }exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=16\\pi .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c5e974d9-137d-5422-9c75-5e0f9c76f643"] :db/ensure [:question/validate]} {:db/id "answer-field-c5e974d9-137d-5422-9c75-5e0f9c76f643" :answer-field/id #uuid "c5e974d9-137d-5422-9c75-5e0f9c76f643" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3dcc97e2-1cf4-58b0-8ccd-6aaf27892d07" :answer-field/choices ["answer-3dcc97e2-1cf4-58b0-8ccd-6aaf27892d07" "answer-9385d1b3-a5a1-5507-b599-cbba0c48627c" "answer-84f8a713-083b-567a-87f3-b56ca285c20f" "answer-246df32d-4746-5885-a035-d11664f353a2" "answer-d25bb8b0-15e2-5a36-ad57-03625d178a3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-3dcc97e2-1cf4-58b0-8ccd-6aaf27892d07" :answer/id #uuid "3dcc97e2-1cf4-58b0-8ccd-6aaf27892d07" :answer/type :answer.type/math :answer/value "16\\pi " :db/ensure [:answer/validate]} {:db/id "answer-9385d1b3-a5a1-5507-b599-cbba0c48627c" :answer/id #uuid "9385d1b3-a5a1-5507-b599-cbba0c48627c" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-84f8a713-083b-567a-87f3-b56ca285c20f" :answer/id #uuid "84f8a713-083b-567a-87f3-b56ca285c20f" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-246df32d-4746-5885-a035-d11664f353a2" :answer/id #uuid "246df32d-4746-5885-a035-d11664f353a2" :answer/type :answer.type/math :answer/value "4\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-d25bb8b0-15e2-5a36-ad57-03625d178a3b" :answer/id #uuid "d25bb8b0-15e2-5a36-ad57-03625d178a3b" :answer/type :answer.type/math :answer/value "8\\pi " :db/ensure [:answer/validate]} {:db/id "question-f4cb9239-3b4d-5884-8d60-86ece34323bd" :question/id #uuid "f4cb9239-3b4d-5884-8d60-86ece34323bd" :question/math-academy-id "q-159743" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their correlation coefficient are given by\n\n$$\n{\\sigma }_{1}^{2}=20,\\,{\\sigma }_{2}^{2}=2,\\,\\rho =-\\frac{1}{\\sqrt{10}}.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{2\\pi \\sqrt{|Σ|}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and $\\rho ,$ our covariance matrix is\n\n$$\nΣ=[\\begin{aligned}20 & -\\frac{1}{\\sqrt{10}}\\cdot \\sqrt{20}\\cdot \\sqrt{2} \\\\ -\\frac{1}{\\sqrt{10}}\\cdot \\sqrt{20}\\cdot \\sqrt{2} & 2\\end{aligned}]=[\\begin{aligned}20 & -2 \\\\ -2 & 2\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|Σ|=20\\cdot 2-(-2)\\cdot (-2)=36.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{36}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{12\\pi }exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=12\\pi .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3e8b48ff-d943-5ecb-9098-05bbf34d8cc8"] :db/ensure [:question/validate]} {:db/id "answer-field-3e8b48ff-d943-5ecb-9098-05bbf34d8cc8" :answer-field/id #uuid "3e8b48ff-d943-5ecb-9098-05bbf34d8cc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44909d7b-b627-5b06-8717-189b1d4b5122" :answer-field/choices ["answer-44909d7b-b627-5b06-8717-189b1d4b5122" "answer-593fcdbb-3bf7-51f3-8353-2a0bb906561b" "answer-e51b59d3-e3d9-56a2-bc23-364e27227cef" "answer-cd5b40e6-2599-5535-a953-6e2b8d5c5bcb" "answer-1ea11954-6a4f-5d76-99d3-931555d6a5a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-44909d7b-b627-5b06-8717-189b1d4b5122" :answer/id #uuid "44909d7b-b627-5b06-8717-189b1d4b5122" :answer/type :answer.type/math :answer/value "12\\pi " :db/ensure [:answer/validate]} {:db/id "answer-593fcdbb-3bf7-51f3-8353-2a0bb906561b" :answer/id #uuid "593fcdbb-3bf7-51f3-8353-2a0bb906561b" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-e51b59d3-e3d9-56a2-bc23-364e27227cef" :answer/id #uuid "e51b59d3-e3d9-56a2-bc23-364e27227cef" :answer/type :answer.type/math :answer/value "4\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-cd5b40e6-2599-5535-a953-6e2b8d5c5bcb" :answer/id #uuid "cd5b40e6-2599-5535-a953-6e2b8d5c5bcb" :answer/type :answer.type/math :answer/value "6\\pi " :db/ensure [:answer/validate]} {:db/id "answer-1ea11954-6a4f-5d76-99d3-931555d6a5a9" :answer/id #uuid "1ea11954-6a4f-5d76-99d3-931555d6a5a9" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id 17592186092579 :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their covariance are given by\n\n$$\n{\\sigma }_{1}^{2}=10,\\,{\\sigma }_{2}^{2}=5,\\,{\\sigma }_{12}=5.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf({x}_{1},{x}_{2})=\\frac{1}{2\\pi \\sqrt{|Σ|}}exp(-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and ${\\sigma }_{12},$ our covariance matrix is\n\n$$\nΣ=[\\begin{aligned}10 & 5 \\\\ 5 & 5\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|Σ|=10\\cdot 5-5\\cdot 5=25.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{25}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{10\\pi }exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=10\\pi .$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186089645 :answer-field/correct "answer-59b192f8-8a08-5e40-93d5-ab8e3f2938f4" :answer-field/choices ["answer-59b192f8-8a08-5e40-93d5-ab8e3f2938f4" "answer-0d4c0cb8-d9a4-5c3a-9a2d-8f3bcc6f2d8b" "answer-fca68fd5-18c4-580f-8af1-5f191fa77ca9" "answer-bb0c62a2-2941-508f-8b34-49fd4599dbf4" "answer-843df82d-bd20-5e2b-8054-24ab30500319"] :db/ensure [:answer-field/validate]} {:db/id "answer-59b192f8-8a08-5e40-93d5-ab8e3f2938f4" :answer/id #uuid "59b192f8-8a08-5e40-93d5-ab8e3f2938f4" :answer/type :answer.type/math :answer/value "10\\pi " :db/ensure [:answer/validate]} {:db/id "answer-0d4c0cb8-d9a4-5c3a-9a2d-8f3bcc6f2d8b" :answer/id #uuid "0d4c0cb8-d9a4-5c3a-9a2d-8f3bcc6f2d8b" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-fca68fd5-18c4-580f-8af1-5f191fa77ca9" :answer/id #uuid "fca68fd5-18c4-580f-8af1-5f191fa77ca9" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-bb0c62a2-2941-508f-8b34-49fd4599dbf4" :answer/id #uuid "bb0c62a2-2941-508f-8b34-49fd4599dbf4" :answer/type :answer.type/math :answer/value "5\\pi " :db/ensure [:answer/validate]} {:db/id "answer-843df82d-bd20-5e2b-8054-24ab30500319" :answer/id #uuid "843df82d-bd20-5e2b-8054-24ab30500319" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "question-a7dfbbbd-1a36-5131-be23-c3a22a696cb3" :question/id #uuid "a7dfbbbd-1a36-5131-be23-c3a22a696cb3" :question/math-academy-id "q-159737" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector. The variances of ${X}_{1}$ and ${X}_{2}$ and their covariance are given by\n\n$$\n{\\sigma }_{1}^{2}=2,\\,{\\sigma }_{2}^{2}=10,\\,{\\sigma }_{12}=-4.\n$$\n\nGiven that the joint probability density function of $X$ is\n\n$$\nf(x)=\\frac{1}{k}\\,exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )),\n$$\n\nwhere $\\mu $ is the mean vector and $Σ$ is the corresponding covariance matrix, find the value of $k.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =(\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}),\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${\\sigma }_{i}^{2}=\\text{Var}[{X}_{i}],$ ${\\sigma }_{12}=\\text{Cov}[{X}_{1},{X}_{2}],$ and $\\rho $ is the correlation, then the joint probability density function of $X$ is\n\n$$\nf({x}_{1},{x}_{2})=\\frac{1}{2\\pi \\sqrt{|Σ|}}exp(-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu ))\n$$\n\nand $|Σ|$ denotes the determinant of $Σ.$\n\nUsing the given values of ${\\sigma }_{1}^{2},{\\sigma }_{2}^{2}$, and ${\\sigma }_{12},$ our covariance matrix is\n\n$$\nΣ=[\\begin{aligned}2 & -4 \\\\ -4 & 10\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|Σ|=2\\cdot 10-(-4)\\cdot (-4)=4.\n$$\n\nSubstituting this value into our expression for the joint PDF, we obtain\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{2\\pi \\sqrt{4}}exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )) \\\\  & =\\frac{1}{4\\pi }exp(-\\frac{1}{2}(x-\\mu )^{T}\\,{Σ}^{-1}\\,(x-\\mu )).\\end{aligned}\n$$\n\nFinally, $k=4\\pi .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-47b850ea-8926-5c8f-8acd-249aeec872ce"] :db/ensure [:question/validate]} {:db/id "answer-field-47b850ea-8926-5c8f-8acd-249aeec872ce" :answer-field/id #uuid "47b850ea-8926-5c8f-8acd-249aeec872ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0a0e1aba-d9b8-59e9-9c12-caf928724ca6" :answer-field/choices ["answer-df425403-018d-5628-b418-23b7c205731c" "answer-0a0e1aba-d9b8-59e9-9c12-caf928724ca6" "answer-e0f879ab-0152-5dc2-bd80-fa45cb37146f" "answer-638f0ce8-9e40-5e97-b676-b714876cc977" "answer-ca644bff-bc2d-5268-9f93-15a088f842f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-df425403-018d-5628-b418-23b7c205731c" :answer/id #uuid "df425403-018d-5628-b418-23b7c205731c" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-0a0e1aba-d9b8-59e9-9c12-caf928724ca6" :answer/id #uuid "0a0e1aba-d9b8-59e9-9c12-caf928724ca6" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e0f879ab-0152-5dc2-bd80-fa45cb37146f" :answer/id #uuid "e0f879ab-0152-5dc2-bd80-fa45cb37146f" :answer/type :answer.type/math :answer/value "6\\pi " :db/ensure [:answer/validate]} {:db/id "answer-638f0ce8-9e40-5e97-b676-b714876cc977" :answer/id #uuid "638f0ce8-9e40-5e97-b676-b714876cc977" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-ca644bff-bc2d-5268-9f93-15a088f842f6" :answer/id #uuid "ca644bff-bc2d-5268-9f93-15a088f842f6" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id 17592186092580 :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,Σ=[\\begin{aligned}1 & 1 \\\\ 1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nLet $Y={X}_{1}-2{X}_{2}.$ Calculate $P(Y\\ge 1).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.8\\,$ | $\\,0.7967\\,$ | $\\,0.7995\\,$ | $\\,0.8023\\,$ |\n| $\\,0.9\\,$ | $\\,0.8238\\,$ | $\\,0.8264\\,$ | $\\,0.8289\\,$ |\n| $\\,1.0\\,$ | $\\,0.8485\\,$ | $\\,0.8508\\,$ | $\\,0.8531\\,$ |" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=0$ and ${\\mu }_{2}=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}-2{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]-2\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}-2\\cdot {\\mu }_{2} \\\\  & =0-2\\cdot (1) \\\\  & =-2.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=1,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=1.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[{X}_{1}-2{X}_{2}] \\\\  & ={1}^{2}\\cdot 1+(-2)^{2}\\cdot 4+2\\cdot 1\\cdot (-2)\\cdot 1 \\\\  & =1+16-4 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(-2,13).\n$$\n\nNow, we need to compute $P(Y\\ge 1).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 1) & =P(Z\\ge \\frac{1-(-2)}{\\sqrt{13}}) \\\\  & =P(Z\\ge 0.832)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(Z\\ge 0.83) & =1-P(Z<0.83) \\\\  & =1-P(Z\\le 0.83) \\\\  & =1-Φ(0.83)\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(0.83)=0.7967.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(Z\\ge 0.83) & =1-Φ(0.83) \\\\  & =1-0.7967 \\\\  & =0.2033.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y\\ge 1)=0.2033.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186089651 :answer-field/correct 17592186089655 :db/ensure [:answer-field/validate]} {:db/id "question-de58daf1-e39b-5442-89f0-7a159aadbac7" :question/id #uuid "de58daf1-e39b-5442-89f0-7a159aadbac7" :question/math-academy-id "q-159776" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}-2 \\\\ 3\\end{aligned}],\\,Σ=[\\begin{aligned}2 & -1 \\\\ -1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nLet $Y=2{X}_{1}+4{X}_{2}.$ Calculate $P(Y\\le 10).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.1\\,$ | $\\,0.5596\\,$ | $\\,0.5636\\,$ | $\\,0.5675\\,$ |\n| $\\,0.2\\,$ | $\\,0.5987\\,$ | $\\,0.6026\\,$ | $\\,0.6064\\,$ |\n| $\\,0.3\\,$ | $\\,0.6368\\,$ | $\\,0.6406\\,$ | $\\,0.6443\\,$ |" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=-2$ and ${\\mu }_{2}=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[2{X}_{1}+4{X}_{2}] \\\\  & =2\\text{E}[{X}_{1}]+4\\text{E}[{X}_{2}] \\\\  & =2{\\mu }_{1}+4{\\mu }_{2} \\\\  & =2(-2)+4(3) \\\\  & =8.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=2,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=-1.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[2{X}_{1}+4{X}_{2}] \\\\  & ={2}^{2}(2)+{4}^{2}(4)+2(2)(4)(-1) \\\\  & =8+64-16 \\\\  & =56.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(8,56).\n$$\n\nNow, we need to compute $P(Y\\le 10).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\le 10) & =P(Z\\le \\frac{10-8}{\\sqrt{56}}) \\\\  & =P(Z\\le 0.27) \\\\  & =Φ(0.27)\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\nΦ(0.27)=0.6064.\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y\\le 10)=0.6064.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c46b911-92e9-5ee5-b90b-d6b9b56e65d1"] :db/ensure [:question/validate]} {:db/id "answer-field-9c46b911-92e9-5ee5-b90b-d6b9b56e65d1" :answer-field/id #uuid "9c46b911-92e9-5ee5-b90b-d6b9b56e65d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f24b879-634d-55bb-9903-039b6caaac8d" :answer-field/choices ["answer-8c21487c-b2e7-534d-af44-5ceea08e6498" "answer-67dbfefa-4caa-5758-9ac2-e1c248073a63" "answer-6f24b879-634d-55bb-9903-039b6caaac8d" "answer-bfbb04af-60be-5e8f-b9e6-9d32e8c07a07" "answer-82b2c84e-fc23-5e11-8368-7f6cfde6c81d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c21487c-b2e7-534d-af44-5ceea08e6498" :answer/id #uuid "8c21487c-b2e7-534d-af44-5ceea08e6498" :answer/type :answer.type/math :answer/value "0.5636" :db/ensure [:answer/validate]} {:db/id "answer-67dbfefa-4caa-5758-9ac2-e1c248073a63" :answer/id #uuid "67dbfefa-4caa-5758-9ac2-e1c248073a63" :answer/type :answer.type/math :answer/value "0.5987" :db/ensure [:answer/validate]} {:db/id "answer-6f24b879-634d-55bb-9903-039b6caaac8d" :answer/id #uuid "6f24b879-634d-55bb-9903-039b6caaac8d" :answer/type :answer.type/math :answer/value "0.6064" :db/ensure [:answer/validate]} {:db/id "answer-bfbb04af-60be-5e8f-b9e6-9d32e8c07a07" :answer/id #uuid "bfbb04af-60be-5e8f-b9e6-9d32e8c07a07" :answer/type :answer.type/math :answer/value "0.6368" :db/ensure [:answer/validate]} {:db/id "answer-82b2c84e-fc23-5e11-8368-7f6cfde6c81d" :answer/id #uuid "82b2c84e-fc23-5e11-8368-7f6cfde6c81d" :answer/type :answer.type/math :answer/value "0.6443" :db/ensure [:answer/validate]} {:db/id "question-3b8afbc1-6271-57eb-9548-1efb5cfd889f" :question/id #uuid "3b8afbc1-6271-57eb-9548-1efb5cfd889f" :question/math-academy-id "q-159778" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}5 \\\\ 1\\end{aligned}],\\,Σ=[\\begin{aligned}1 & -2 \\\\ -2 & 5\\end{aligned}].\\end{aligned}\n$$\n\nLet $Y={X}_{1}+3{X}_{2}.$ Calculate $P(1\\le Y\\le 5).$\n\n*Hint: Tables of values of $Φ(z)$ for different values of $z$ are given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.2\\,$</th><td align=\"center\"> $\\,0.1151\\,$ </td><td align=\"center\"> $\\,0.1131\\,$ </td><td align=\"center\"> $\\,0.1112\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.1\\,$</th><td align=\"center\"> $\\,0.1357\\,$ </td><td align=\"center\"> $\\,0.1335\\,$ </td><td align=\"center\"> $\\,0.1314\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.0\\,$</th><td align=\"center\"> $\\,0.1587\\,$ </td><td align=\"center\"> $\\,0.1562\\,$ </td><td align=\"center\"> $\\,0.1539\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n<th width=\"5%\"></th>\n<th><p></p>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.03\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.6\\,$</th><td align=\"center\"> $\\,0.2709\\,$ </td><td align=\"center\"> $\\,0.2676\\,$ </td><td align=\"center\"> $\\,0.2643\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.5\\,$</th><td align=\"center\"> $\\,0.3050\\,$ </td><td align=\"center\"> $\\,0.3015\\,$ </td><td align=\"center\"> $\\,0.2981\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.4\\,$</th><td align=\"center\"> $\\,0.3409\\,$ </td><td align=\"center\"> $\\,0.3372\\,$ </td><td align=\"center\"> $\\,0.3336\\,$ </td></tr>\n</tbody></table>\n<p></p></th>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=5$ and ${\\mu }_{2}=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}+3{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]+3\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}+3\\cdot {\\mu }_{2} \\\\  & =5+3\\cdot 1 \\\\  & =8.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=1,{\\sigma }_{2}^{2}=5,$ and ${\\sigma }_{12}={\\sigma }_{21}=-2.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[{X}_{1}+3{X}_{2}] \\\\  & ={1}^{2}\\cdot 1+{3}^{2}\\cdot 5+2\\cdot 1\\cdot 3\\cdot (-2) \\\\  & =1+45-12 \\\\  & =34.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(8,34).\n$$\n\nNow, we need to compute $P(1\\le Y\\le 5).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(1\\le Y\\le 5) & =P(\\frac{1-8}{\\sqrt{34}}\\le Z\\le \\frac{5-8}{\\sqrt{34}}) \\\\  & =P(-1.20\\le Z\\le -0.51)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-1.20\\le Z\\le -0.51) & =P(Z\\le -0.51)-P(Z<-1.20) \\\\  & =P(Z\\le -0.51)-P(Z\\le -1.20) \\\\  & =Φ(-0.51)-Φ(-1.20)\\end{aligned}\n$$\n\nFrom the table, we have the following:\n\n$$\n\\begin{aligned}Φ(-1.20) & =0.1151 \\\\ Φ(-0.51) & =0.3050\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(-1.20\\le Z\\le -0.51) & =Φ(-0.51)-Φ(-1.20) \\\\  & =0.3050-0.1151 \\\\  & =0.1899.\\end{aligned}\n$$\n\nFinally, we conclude that\n\n$$\nP(1\\le Y\\le 5)=0.1899.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d466cd72-cb8d-5d38-94b7-6314b0963b1c"] :db/ensure [:question/validate]} {:db/id "answer-field-d466cd72-cb8d-5d38-94b7-6314b0963b1c" :answer-field/id #uuid "d466cd72-cb8d-5d38-94b7-6314b0963b1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e9a8cf30-b566-51f5-a9f4-f21f56e8c936" :answer-field/choices ["answer-45c0db7b-6f4a-57f4-80c3-8f88590dd601" "answer-1bfe9eed-26f1-58ae-878b-1a814c7aca9b" "answer-e9a8cf30-b566-51f5-a9f4-f21f56e8c936" "answer-07524969-032c-5c00-ab25-ee4291f1a0ea" "answer-23f237eb-8701-5484-ae9d-933afafe1c15"] :db/ensure [:answer-field/validate]} {:db/id "answer-45c0db7b-6f4a-57f4-80c3-8f88590dd601" :answer/id #uuid "45c0db7b-6f4a-57f4-80c3-8f88590dd601" :answer/type :answer.type/math :answer/value "0.1558" :db/ensure [:answer/validate]} {:db/id "answer-1bfe9eed-26f1-58ae-878b-1a814c7aca9b" :answer/id #uuid "1bfe9eed-26f1-58ae-878b-1a814c7aca9b" :answer/type :answer.type/math :answer/value "0.1762" :db/ensure [:answer/validate]} {:db/id "answer-e9a8cf30-b566-51f5-a9f4-f21f56e8c936" :answer/id #uuid "e9a8cf30-b566-51f5-a9f4-f21f56e8c936" :answer/type :answer.type/math :answer/value "0.1899" :db/ensure [:answer/validate]} {:db/id "answer-07524969-032c-5c00-ab25-ee4291f1a0ea" :answer/id #uuid "07524969-032c-5c00-ab25-ee4291f1a0ea" :answer/type :answer.type/math :answer/value "0.2002" :db/ensure [:answer/validate]} {:db/id "answer-23f237eb-8701-5484-ae9d-933afafe1c15" :answer/id #uuid "23f237eb-8701-5484-ae9d-933afafe1c15" :answer/type :answer.type/math :answer/value "0.2109" :db/ensure [:answer/validate]} {:db/id 17592186092560 :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,Σ=[\\begin{aligned}1 & 1 \\\\ 1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y={X}_{1}-2{X}_{2}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=0$ and ${\\mu }_{2}=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}-2{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]-2\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}-2\\cdot {\\mu }_{2} \\\\  & =0-2\\cdot (1) \\\\  & =-2.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=1,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=1.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[{X}_{1}-2{X}_{2}] \\\\  & ={1}^{2}\\cdot 1+(-2)^{2}\\cdot 4+2\\cdot 1\\cdot (-2)\\cdot 1 \\\\  & =1+16-4 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-2,13).\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186089531 :answer-field/correct "answer-22382cd6-21f0-5384-9d9e-e555a766fac4" :answer-field/choices ["answer-22382cd6-21f0-5384-9d9e-e555a766fac4" "answer-2d44a4ab-bf70-577b-95d4-802bedc72e77" "answer-dc53f2d3-d6bf-569d-bb68-e47e1dbbc0e6" "answer-09914385-0a05-5f0a-babc-48e716b5d3a5" "answer-9a5b2179-34b2-5f28-a785-1f671241e094"] :db/ensure [:answer-field/validate]} {:db/id "answer-22382cd6-21f0-5384-9d9e-e555a766fac4" :answer/id #uuid "22382cd6-21f0-5384-9d9e-e555a766fac4" :answer/type :answer.type/math :answer/value "Y∼N(-2,13)" :db/ensure [:answer/validate]} {:db/id "answer-2d44a4ab-bf70-577b-95d4-802bedc72e77" :answer/id #uuid "2d44a4ab-bf70-577b-95d4-802bedc72e77" :answer/type :answer.type/math :answer/value "Y∼N(-2,17)" :db/ensure [:answer/validate]} {:db/id "answer-dc53f2d3-d6bf-569d-bb68-e47e1dbbc0e6" :answer/id #uuid "dc53f2d3-d6bf-569d-bb68-e47e1dbbc0e6" :answer/type :answer.type/math :answer/value "Y∼N(-2,\\sqrt{13})" :db/ensure [:answer/validate]} {:db/id "answer-09914385-0a05-5f0a-babc-48e716b5d3a5" :answer/id #uuid "09914385-0a05-5f0a-babc-48e716b5d3a5" :answer/type :answer.type/math :answer/value "Y∼N(-2,\\sqrt{15})" :db/ensure [:answer/validate]} {:db/id "answer-9a5b2179-34b2-5f28-a785-1f671241e094" :answer/id #uuid "9a5b2179-34b2-5f28-a785-1f671241e094" :answer/type :answer.type/math :answer/value "Y∼N(-2,\\sqrt{17})" :db/ensure [:answer/validate]} {:db/id "question-485fd77f-8eb8-5250-aed7-606fdfdfa4f3" :question/id #uuid "485fd77f-8eb8-5250-aed7-606fdfdfa4f3" :question/math-academy-id "q-159747" :question/problem "Let $X=[{X}_{1},{X}_{2}]^{T}$ be a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}0 \\\\ 3\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 1 \\\\ 1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y={X}_{1}+{X}_{2}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2}]^{T}$ is a bivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nthen the random variable $Y,$ defined as\n\n$$\nY=a{X}_{1}+b{X}_{2}\n$$\n\nis a normally distributed random variable for all values of $a$ and $b,$ where\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$\n\nIn our case, we have ${\\mu }_{1}=0$ and ${\\mu }_{2}=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[{X}_{1}+{X}_{2}] \\\\  & =\\text{E}[{X}_{1}]+\\text{E}[{X}_{2}] \\\\  & ={\\mu }_{1}+{\\mu }_{2} \\\\  & =0+3 \\\\  & =3.\\end{aligned}\n$$\n\nAlso, we have ${\\sigma }_{1}^{2}=2,{\\sigma }_{2}^{2}=4,$ and ${\\sigma }_{12}={\\sigma }_{21}=1.$ Therefore, \n\n$$\n\\begin{aligned}Var[Y] & =Var[{X}_{1}+{X}_{2}] \\\\  & ={1}^{2}\\cdot 2+{1}^{2}\\cdot 4+2\\cdot 1\\cdot 1\\cdot 1 \\\\  & =2+4+2 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(3,8).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-31af4987-ee12-5601-b83b-d991adf87071"] :db/ensure [:question/validate]} {:db/id "answer-field-31af4987-ee12-5601-b83b-d991adf87071" :answer-field/id #uuid "31af4987-ee12-5601-b83b-d991adf87071" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-275ad22b-2609-5ea6-b5e7-33bd6dd56aa8" :answer-field/choices ["answer-1fbfe970-6da3-5f5a-8d7f-66bdfdaa11d2" "answer-483d5766-64b0-58a2-a33c-dd47e2b32667" "answer-275ad22b-2609-5ea6-b5e7-33bd6dd56aa8" "answer-b8326e47-f122-5282-9791-357440f05fa9" "answer-f5b54e42-31fd-5bc1-b149-fc46cf14e05c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1fbfe970-6da3-5f5a-8d7f-66bdfdaa11d2" :answer/id #uuid "1fbfe970-6da3-5f5a-8d7f-66bdfdaa11d2" :answer/type :answer.type/math :answer/value "Y∼N(1,2)" :db/ensure [:answer/validate]} {:db/id "answer-483d5766-64b0-58a2-a33c-dd47e2b32667" :answer/id #uuid "483d5766-64b0-58a2-a33c-dd47e2b32667" :answer/type :answer.type/math :answer/value "Y∼N(3,4)" :db/ensure [:answer/validate]} {:db/id "answer-275ad22b-2609-5ea6-b5e7-33bd6dd56aa8" :answer/id #uuid "275ad22b-2609-5ea6-b5e7-33bd6dd56aa8" :answer/type :answer.type/math :answer/value "Y∼N(3,8)" :db/ensure [:answer/validate]} {:db/id "answer-b8326e47-f122-5282-9791-357440f05fa9" :answer/id #uuid "b8326e47-f122-5282-9791-357440f05fa9" :answer/type :answer.type/math :answer/value "Y∼N(6,4)" :db/ensure [:answer/validate]} {:db/id "answer-f5b54e42-31fd-5bc1-b149-fc46cf14e05c" :answer/id #uuid "f5b54e42-31fd-5bc1-b149-fc46cf14e05c" :answer/type :answer.type/math :answer/value "Y∼N(6,8)" :db/ensure [:answer/validate]} {:db/id "question-a69ab04f-b52a-5382-92a0-123e6cfce6f9" :question/id #uuid "a69ab04f-b52a-5382-92a0-123e6cfce6f9" :question/math-academy-id "q-159906" :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}1 \\\\ 3 \\\\ -1\\end{aligned}],\\,Σ=[\\begin{aligned}5 & 3 & 2 \\\\ 3 & 4 & 1 \\\\ 2 & 1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y=-{X}_{1}+{X}_{2}-2{X}_{3}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y=-{X}_{1}+{X}_{2}-2{X}_{3},$ we have \n\n$$\nc=[\\begin{aligned}-1 \\\\ 1 \\\\ -2\\end{aligned}].\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}-1 & 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 3 \\\\ -1\\end{aligned}] \\\\  & =-1+3+2 \\\\  & =4,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}-1 & 1 & -2\\end{aligned}][\\begin{aligned}5 & 3 & 2 \\\\ 3 & 4 & 1 \\\\ 2 & 1 & 3\\end{aligned}][\\begin{aligned}-1 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 & -2\\end{aligned}][\\begin{aligned}-6 \\\\ -1 \\\\ -7\\end{aligned}] \\\\  & =6-1+14 \\\\  & =19.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(4,19).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-53378554-b1a5-553b-8166-b2092af85775"] :db/ensure [:question/validate]} {:db/id "answer-field-53378554-b1a5-553b-8166-b2092af85775" :answer-field/id #uuid "53378554-b1a5-553b-8166-b2092af85775" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-458f1ea7-cfea-59ee-baf1-e528c0816a4c" :answer-field/choices ["answer-52c5f538-dabe-5a48-92c1-4333dc4b66bb" "answer-458f1ea7-cfea-59ee-baf1-e528c0816a4c" "answer-407f15e3-cc95-57e6-baf2-1e8c8b85f9a8" "answer-1ccae1b9-35e7-5303-9d4c-35ad96bcbc31" "answer-b1c79a96-262b-5861-aff5-4efc84fd373d"] :db/ensure [:answer-field/validate]} {:db/id "answer-52c5f538-dabe-5a48-92c1-4333dc4b66bb" :answer/id #uuid "52c5f538-dabe-5a48-92c1-4333dc4b66bb" :answer/type :answer.type/math :answer/value "N(2,21)" :db/ensure [:answer/validate]} {:db/id "answer-458f1ea7-cfea-59ee-baf1-e528c0816a4c" :answer/id #uuid "458f1ea7-cfea-59ee-baf1-e528c0816a4c" :answer/type :answer.type/math :answer/value "N(4,19)" :db/ensure [:answer/validate]} {:db/id "answer-407f15e3-cc95-57e6-baf2-1e8c8b85f9a8" :answer/id #uuid "407f15e3-cc95-57e6-baf2-1e8c8b85f9a8" :answer/type :answer.type/math :answer/value "N(4,7)" :db/ensure [:answer/validate]} {:db/id "answer-1ccae1b9-35e7-5303-9d4c-35ad96bcbc31" :answer/id #uuid "1ccae1b9-35e7-5303-9d4c-35ad96bcbc31" :answer/type :answer.type/math :answer/value "N(6,19)" :db/ensure [:answer/validate]} {:db/id "answer-b1c79a96-262b-5861-aff5-4efc84fd373d" :answer/id #uuid "b1c79a96-262b-5861-aff5-4efc84fd373d" :answer/type :answer.type/math :answer/value "N(6,7)" :db/ensure [:answer/validate]} {:db/id 17592186092581 :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 1 & 1 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nLet $Y={X}_{1}+2{X}_{2}-{X}_{3}.$ Find $P(Y<1).$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ | $\\,0.08\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ | $\\,0.7190\\,$ |\n| $\\,0.6\\,$ | $\\,0.7422\\,$ | $\\,0.7454\\,$ | $\\,0.7486\\,$ | $\\,0.7517\\,$ |\n| $\\,0.7\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ | $\\,0.7794\\,$ | $\\,0.7823\\,$ |\n| $\\,0.8\\,$ | $\\,0.8023\\,$ | $\\,0.8051\\,$ | $\\,0.8078\\,$ | $\\,0.8106\\,$ |" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y={X}_{1}+2{X}_{2}-{X}_{3},$ we have \n\n$$\nc=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}1 & 2 & -1\\end{aligned}][\\begin{aligned}3 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =3+2-2 \\\\  & =3,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}1 & 2 & -1\\end{aligned}][\\begin{aligned}2 & 1 & 1 \\\\ 1 & 3 & 2 \\\\ 1 & 2 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 & -1\\end{aligned}][\\begin{aligned}3 \\\\ 5 \\\\ 1\\end{aligned}] \\\\  & =3+10-1 \\\\  & =12.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nY∼N(3,12).\n$$\n\nNow, we need to compute $P(Y<1).$ First, transform $Y$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y<1) & =P(Z<\\frac{1-3}{\\sqrt{12}}) \\\\  & =P(Z<-0.58)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(Z<-0.58) & =P(Z\\le -0.58) \\\\  & =Φ(-0.58).\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(0.58)=0.7190.\n$$\n\nBy the symmetry of the normal distribution, we have\n\n$$\nΦ(-0.58)=1-Φ(0.58)=1-0.7190=0.2810.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}P(Z<-0.58)=0.2810.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(Y<1)=0.2810.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186089657 :answer-field/correct 17592186089659 :db/ensure [:answer-field/validate]} {:db/id "question-5760ff2c-7d2e-56c5-873e-f2312179cd86" :question/id #uuid "5760ff2c-7d2e-56c5-873e-f2312179cd86" :question/math-academy-id "q-159788" :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}2 \\\\ 2 \\\\ -1\\end{aligned}],\\,Σ=[\\begin{aligned}4 & 1 & 2 \\\\ 1 & 5 & 3 \\\\ 2 & 3 & 7\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y={X}_{1}-{X}_{2}+3{X}_{3}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y={X}_{1}-{X}_{2}+3{X}_{3},$ we have \n\n$$\nc=[\\begin{aligned}1 \\\\ -1 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}1 & -1 & 3\\end{aligned}][\\begin{aligned}2 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =2-2-3 \\\\  & =-3,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}1 & -1 & 3\\end{aligned}][\\begin{aligned}4 & 1 & 2 \\\\ 1 & 5 & 3 \\\\ 2 & 3 & 7\\end{aligned}][\\begin{aligned}1 \\\\ -1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 & 3\\end{aligned}][\\begin{aligned}9 \\\\ 5 \\\\ 20\\end{aligned}] \\\\  & =9-5+60 \\\\  & =64.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-3,64).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-67479386-cd07-5c4b-bace-808cced8a369"] :db/ensure [:question/validate]} {:db/id "answer-field-67479386-cd07-5c4b-bace-808cced8a369" :answer-field/id #uuid "67479386-cd07-5c4b-bace-808cced8a369" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9fce381d-1327-590b-a9d0-bbac5c3547d3" :answer-field/choices ["answer-b2bcf75e-464c-51d2-bf87-67feb71d6670" "answer-9fce381d-1327-590b-a9d0-bbac5c3547d3" "answer-bacaf94a-b2f5-5841-93ff-7fce330f4aea" "answer-ef55d0bd-aea2-59fb-9676-cd9c08bfd13f" "answer-a63863ed-8164-57d5-b1c1-927b3010411d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2bcf75e-464c-51d2-bf87-67feb71d6670" :answer/id #uuid "b2bcf75e-464c-51d2-bf87-67feb71d6670" :answer/type :answer.type/math :answer/value "N(-1,8)" :db/ensure [:answer/validate]} {:db/id "answer-9fce381d-1327-590b-a9d0-bbac5c3547d3" :answer/id #uuid "9fce381d-1327-590b-a9d0-bbac5c3547d3" :answer/type :answer.type/math :answer/value "N(-3,64)" :db/ensure [:answer/validate]} {:db/id "answer-bacaf94a-b2f5-5841-93ff-7fce330f4aea" :answer/id #uuid "bacaf94a-b2f5-5841-93ff-7fce330f4aea" :answer/type :answer.type/math :answer/value "N(-3,8)" :db/ensure [:answer/validate]} {:db/id "answer-ef55d0bd-aea2-59fb-9676-cd9c08bfd13f" :answer/id #uuid "ef55d0bd-aea2-59fb-9676-cd9c08bfd13f" :answer/type :answer.type/math :answer/value "N(2,64)" :db/ensure [:answer/validate]} {:db/id "answer-a63863ed-8164-57d5-b1c1-927b3010411d" :answer/id #uuid "a63863ed-8164-57d5-b1c1-927b3010411d" :answer/type :answer.type/math :answer/value "N(2,71)" :db/ensure [:answer/validate]} {:db/id "question-b7717a0a-c395-5f69-ba3c-1ca2b2b29ed2" :question/id #uuid "b7717a0a-c395-5f69-ba3c-1ca2b2b29ed2" :question/math-academy-id "q-159794" :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}],\\,Σ=[\\begin{aligned}3 & 2 & 1 \\\\ 2 & 4 & 2 \\\\ 1 & 2 & 5\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y=-{X}_{1}+3{X}_{2}+2{X}_{3}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y=-{X}_{1}+3{X}_{2}+2{X}_{3},$ we have \n\n$$\nc=[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}].\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}-1 & 3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =0+9+4 \\\\  & =13,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}-1 & 3 & 2\\end{aligned}][\\begin{aligned}3 & 2 & 1 \\\\ 2 & 4 & 2 \\\\ 1 & 2 & 5\\end{aligned}][\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 3 & 2\\end{aligned}][\\begin{aligned}5 \\\\ 14 \\\\ 15\\end{aligned}] \\\\  & =-5+42+30 \\\\  & =67.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(13,67).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c8cb4950-ba1f-5989-a857-8e8855ec8b18"] :db/ensure [:question/validate]} {:db/id "answer-field-c8cb4950-ba1f-5989-a857-8e8855ec8b18" :answer-field/id #uuid "c8cb4950-ba1f-5989-a857-8e8855ec8b18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0eedeb12-ec11-56ff-b29b-e3751160e5e9" :answer-field/choices ["answer-4d051156-4080-5cde-a8d8-8d8f091756ce" "answer-0eedeb12-ec11-56ff-b29b-e3751160e5e9" "answer-9a11b056-cc10-5a5c-8bc6-2565c9be5efc" "answer-21764b22-3a61-5f2b-9d32-d852559b4581" "answer-ad020fb2-061b-5feb-8d6a-974e236033c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d051156-4080-5cde-a8d8-8d8f091756ce" :answer/id #uuid "4d051156-4080-5cde-a8d8-8d8f091756ce" :answer/type :answer.type/math :answer/value "N(13,51)" :db/ensure [:answer/validate]} {:db/id "answer-0eedeb12-ec11-56ff-b29b-e3751160e5e9" :answer/id #uuid "0eedeb12-ec11-56ff-b29b-e3751160e5e9" :answer/type :answer.type/math :answer/value "N(13,67)" :db/ensure [:answer/validate]} {:db/id "answer-9a11b056-cc10-5a5c-8bc6-2565c9be5efc" :answer/id #uuid "9a11b056-cc10-5a5c-8bc6-2565c9be5efc" :answer/type :answer.type/math :answer/value "N(17,51)" :db/ensure [:answer/validate]} {:db/id "answer-21764b22-3a61-5f2b-9d32-d852559b4581" :answer/id #uuid "21764b22-3a61-5f2b-9d32-d852559b4581" :answer/type :answer.type/math :answer/value "N(5,34)" :db/ensure [:answer/validate]} {:db/id "answer-ad020fb2-061b-5feb-8d6a-974e236033c4" :answer/id #uuid "ad020fb2-061b-5feb-8d6a-974e236033c4" :answer/type :answer.type/math :answer/value "N(5,67)" :db/ensure [:answer/validate]} {:db/id "question-279fa865-ddd8-5bba-a76f-e827f503b5bb" :question/id #uuid "279fa865-ddd8-5bba-a76f-e827f503b5bb" :question/math-academy-id "q-159790" :question/problem "Let $X=[{X}_{1},{X}_{2},{X}_{3}]^{T}$ be a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ$ given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}],\\,Σ=[\\begin{aligned}5 & 2 & 1 \\\\ 2 & 6 & 2 \\\\ 1 & 2 & 7\\end{aligned}].\\end{aligned}\n$$\n\nFind the distribution of $Y=2{X}_{1}-{X}_{2}-{X}_{3}.$" :question/worked-solution "Recall that if $X=[{X}_{1},{X}_{2},…,{X}_{k}]^{T}$ is a multivariate normal random vector with mean vector $\\mu $ and covariance matrix $Σ,$ then the random variable $Y,$ defined as\n\n$$\nY={c}^{T}X={\\sum }_{i=1}^{k}{c}_{i}{X}_{i}\n$$\n\nis a normally distributed random variable, where $c$ is any $k\\times 1$ column vector, and  \n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nIn our case, since we wish to know the distribution of $Y=2{X}_{1}-{X}_{2}-{X}_{3},$ we have \n\n$$\nc=[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}].\n$$\n\nTherefore, for the mean of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{E}[Y] & ={c}^{T}\\mu  \\\\  & =[\\begin{aligned}2 & -1 & -1\\end{aligned}][\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}] \\\\  & =-2-1-4 \\\\  & =-7,\\end{aligned}\n$$\n\nand for the variance of $Y,$ we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & ={c}^{T}Σc \\\\  & =[\\begin{aligned}2 & -1 & -1\\end{aligned}][\\begin{aligned}5 & 2 & 1 \\\\ 2 & 6 & 2 \\\\ 1 & 2 & 7\\end{aligned}][\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 & -1\\end{aligned}][\\begin{aligned}7 \\\\ -4 \\\\ -7\\end{aligned}] \\\\  & =14+4+7 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nY∼N(-7,25).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6c7e05ff-0edc-5d15-8a6d-ef02a4eb8812"] :db/ensure [:question/validate]} {:db/id "answer-field-6c7e05ff-0edc-5d15-8a6d-ef02a4eb8812" :answer-field/id #uuid "6c7e05ff-0edc-5d15-8a6d-ef02a4eb8812" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-212a264a-c734-5158-a429-631f6037efd0" :answer-field/choices ["answer-8783e7e5-5510-5cd7-9832-3afa73d7110a" "answer-212a264a-c734-5158-a429-631f6037efd0" "answer-e90be331-8dd6-5180-9867-a9f8b8fd88fc" "answer-96aaff8a-9da2-5003-b65f-22ecdfada8d2" "answer-85d3f3d0-e0a2-51c3-88b5-be41b56f5657"] :db/ensure [:answer-field/validate]} {:db/id "answer-8783e7e5-5510-5cd7-9832-3afa73d7110a" :answer/id #uuid "8783e7e5-5510-5cd7-9832-3afa73d7110a" :answer/type :answer.type/math :answer/value "N(-7,11)" :db/ensure [:answer/validate]} {:db/id "answer-212a264a-c734-5158-a429-631f6037efd0" :answer/id #uuid "212a264a-c734-5158-a429-631f6037efd0" :answer/type :answer.type/math :answer/value "N(-7,25)" :db/ensure [:answer/validate]} {:db/id "answer-e90be331-8dd6-5180-9867-a9f8b8fd88fc" :answer/id #uuid "e90be331-8dd6-5180-9867-a9f8b8fd88fc" :answer/type :answer.type/math :answer/value "N(1,25)" :db/ensure [:answer/validate]} {:db/id "answer-96aaff8a-9da2-5003-b65f-22ecdfada8d2" :answer/id #uuid "96aaff8a-9da2-5003-b65f-22ecdfada8d2" :answer/type :answer.type/math :answer/value "N(4,11)" :db/ensure [:answer/validate]} {:db/id "answer-85d3f3d0-e0a2-51c3-88b5-be41b56f5657" :answer/id #uuid "85d3f3d0-e0a2-51c3-88b5-be41b56f5657" :answer/type :answer.type/math :answer/value "N(4,13)" :db/ensure [:answer/validate]} {:db/id 17592186093481 :tutorial/content "Let $\\mathbf{X} = [X_1, X_2]^T$ be two (dependent) random variables. We say that $\\mathbf{X}$ is a **bivariate normal vector** with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ if the joint probability density function of $\\mathbf{X}$ is given by\n\n$$\nf(x_1, x_2) = \\dfrac{1}{2\\pi\\sqrt{|\\Sigma|}} \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right)\n$$\n\nwhere\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\nHere, \n\n- $\\sigma^2_1 = \\textrm{Var}[X_1]$ and $\\sigma^2_2 = \\textrm{Var}[X_2]$ are the variances of $X_1$ and $X_2,$\n\n- $\\sigma_{12} = \\sigma_{21} = \\textrm{Cov}[X_1,X_2]$ is the covariance of $X_1$ and $X_2$,\n\n- $\\rho$ is the linear correlation coefficient of $X_1$ and $X_2,$ and\n\n- $|\\Sigma|$ denotes the determinant of $\\Sigma,$ the covariance matrix.\n\nA graph of a typical density function of a bivariate normal vector is depicted below. \n\n![](images/d1/d195358d6dc5b7b8a1080d53c774ee4289ce0f97c17de3bf45a52e86c6b20e29.png)\n\n \n\nThis surface is often referred to as having a \"bell shape.\"" :db/ensure [:tutorial/validate]} {:db/id 17592186093483 :tutorial/content "Recall that a normally distributed random variable $X\\sim N(\\mu,\\sigma^2)$ has the probability density function\n\n$$\nf(x) = \\dfrac{1}{\\sigma \\sqrt{2\\pi}} e^{-\\frac{1}{2} \\left( \\frac{x-\\mu}{\\sigma} \\right)^2}.\n$$\n\nThis probability density function can be written as \n\n$$\nf(x) = (2\\pi)^{-{\\color{red}1}/2 } ({\\color{blue}\\sigma^2})^{-1/2} \\: \\mathrm{exp}\\left( -\\frac{1}{2} (x-\\mu) ({\\color{blue}\\sigma^2})^{-1} (x-\\mu) \\right).\n$$\n\nLet's compare this to the density function of a bivariate normal vector. First, we rewrite the joint density $f(x_1,x_2)$ of the bivariate normal distribution as follows:\n\n$$\n\\begin{aligned}f({x}_{1},{x}_{2}) & =\\frac{1}{2\\pi \\sqrt{|Σ|}}\\,exp(-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu )) \\\\  & =(2\\pi )^{-1}|Σ{|}^{-1/2}\\,exp(-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu )) \\\\  & =(2\\pi )^{-2/2}{|Σ|}^{-1/2}\\,exp(-\\frac{1}{2}(X-\\mu )^{T}\\,{Σ}^{-1}\\,(X-\\mu ))\\end{aligned}\n$$\n\nBy comparing the expressions for $f(x)$ and $f(x_1,x_2),$ we see that the *bivariate* normal distribution can be considered as a generalization of the *normal distribution* from the ${\\color{red}1}$-dimensional case (when we have only one variable, $x$) to the ${\\color{red}2}$-dimensional case (when we have two variables, $x_1$ and $x_2$).\n\nThis analogy will be particularly helpful when extending the bivariate normal distribution to more than two random variables." :db/ensure [:tutorial/validate]} {:db/id 17592186093485 :tutorial/content "Let's consider a bivariate normal vector $\\mathbf{X} = [X_1, X_2]^T$ with the joint probability density function \n\n$$\nf(x_1, x_2) = \\dfrac{1}{2\\pi\\sqrt{|\\Sigma|}} \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right),\n$$\n\nwhere the mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma$ are given by\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}]=[\\begin{aligned}{\\sigma }_{1}^{2} & \\rho {\\sigma }_{1}{\\sigma }_{2} \\\\ \\rho {\\sigma }_{1}{\\sigma }_{2} & {\\sigma }_{2}^{2}\\end{aligned}].\\end{aligned}\n$$\n\nMost of the parameters of the distribution can be interpreted geometrically on a corresponding graph of the probability density function:\n\n- The mean vector $\\boldsymbol{\\mu}$ gives the $xy$-coordinates of the peak.\n\n- The correlation coefficient $\\rho$ defines how much the bell is squeezed towards the plane $y=x{:}$ \n\n- when $\\rho \\to 0,$ the horizontal cross-sections are almost circular, while\n\n- when $\\rho \\to 1,$ the shape becomes more and more squeezed towards the plane $y=x.$\n\n![](images/5b/5bd69db417134cccedd5af45cb56fb44f27925ba5a8470f3b5622f0856ed855d.png)\n\n \n\n- The variances $\\sigma_1^2$ and $\\sigma_2^2$ represent how much the curve is spread out along the principal axes $x_1=\\mu_1$ and $x_2=\\mu_2{:}$\n\n- when $\\sigma_1^2$ and $\\sigma_2^2$ are small, the bell shape is more \"pointy,\" while\n\n- for larger $\\sigma_1^2$ and $\\sigma_2^2,$ the bell shape is more \"flat.\"\n\nThe level curves of the surface have equations of the form\n\n$$\n(\\mathbf X - \\boldsymbol \\mu)^T \\,\\Sigma^{-1} \\,(\\mathbf X - \\boldsymbol \\mu) = \\textrm{const},\n$$\n\n \n\nwhich represent ellipses centered at $(\\mu_1,\\mu_2).$\n\n![](images/1f/1f6b5643b7ab0568faa0b6e16b55a11482000b09d1b5862158d4ac9649281bb7.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186093484 :tutorial/content "A linear combination of coordinates of a bivariate normal random vector generates a (one-dimensional) normal distribution:\n\n*If $\\mathbf{X} = [X_1, X_2]^T$ is a bivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ given by*\n\n$$\n\\begin{aligned}\\mu =[\\begin{aligned}{\\mu }_{1} \\\\ {\\mu }_{2}\\end{aligned}],\\,Σ=[\\begin{aligned}{\\sigma }_{1}^{2} & {\\sigma }_{12} \\\\ {\\sigma }_{21} & {\\sigma }_{2}^{2}\\end{aligned}],\\end{aligned}\n$$\n\n*then the random variable $Y,$ defined as *\n\n$$\nY= aX_1 + bX_2\n$$\n\n*is a normally distributed random variable for all values of $a$ and $b.$ Furthermore, we have that*\n\n$$\n\\begin{aligned}E[Y] & =a{\\mu }_{1}+b{\\mu }_{2}, \\\\ Var[Y] & ={a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}+2ab{\\sigma }_{12}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186093482 :tutorial/content "Earlier, we compared the PDF of $X\\sim N(\\mu,\\sigma^2),$ given by \n\n$$\nf(x) = (2\\pi)^{-{\\color{red}1}/2 } ({\\color{blue}\\sigma^2})^{-1/2} \\: \\mathrm{exp}\\left( -\\frac{1}{2} (x-\\mu) ({\\color{blue}\\sigma^2})^{-1} (x-\\mu) \\right).\n$$\n\nand the joint PDF of a bivariate normal distribution $\\mathbf X = [X_1,X_2]^T$ with mean vector $\\boldsymbol\\mu$ and covariance matrix $\\Sigma,$ given by\n\n$$\nf(x_1, x_2) = (2\\pi)^{-{\\color{red}2}/2} {\\color{blue}|\\Sigma|}^{-1/2} \\: \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,{\\color{blue}\\Sigma}^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right).\n$$\n\nWe can generalize this for an arbitrary number of variables ${\\color{red}p},$ as follows:\n\n$$\nf(x_1, x_2, \\ldots, x_p) = (2\\pi)^{-{\\color{red}p}/2} {\\color{blue}|\\Sigma|}^{-1/2} \\: \\mathrm{exp}\\left( -\\dfrac 12(\\mathbf X - \\boldsymbol \\mu)^T \\,{\\color{blue}\\Sigma}^{-1} \\,(\\mathbf X - \\boldsymbol \\mu)\\right)\n$$\n\nThe function $f(x_1, x_2, \\ldots, x_p)$ is called the **multivariate normal** density function. A random vector $\\mathbf X = [X_1,X_2,\\ldots,X_p]^T$ with this joint density function is said to follow a **multivariate normal distribution**.\n\nSimilar to the bivariate case, we can consider linear combinations of coordinates of multivariate normal random vectors: \n\n*If $\\mathbf{X} =  [X_1, X_2, \\ldots, X_k]^T$ is a multivariate normal random vector with mean vector $\\boldsymbol{\\mu}$ and covariance matrix $\\Sigma,$ then the random variable $Y,$ defined as \n\n$$\nY= \\mathbf c^T \\mathbf X = \\sum_{i=1}^k c_i X_i\n$$\n\n is a normally distributed random variable, where $\\mathbf c$ is any $k\\times 1$ column vector, and*\n\n$$\n\\begin{aligned}E[Y] & ={c}^{T}\\mu , \\\\ Var[Y] & ={c}^{T}Σc.\\end{aligned}\n$$\n\nNotice that the expression for the variance is a quadratic form." :db/ensure [:tutorial/validate]} {:db/id 17592186092422 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]} {:db/id 17592186188297 :knowledge-point/questions ["question-5f78e73c-c303-57f1-975d-3a308d3af577" "question-464ccc1b-341e-50cc-a320-81b9eb3e2aa7" "question-613239a3-89a3-5820-a45d-8b5d5da600ee" "question-85bc8151-a6d7-5a1f-86a0-0e52ad8f1c73"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188004 :question/problem "Consider the polar curve $r=2(1+\\sin\\theta)$ for $\\theta \\in \\left[0, 2\\pi\\right).$ Given that \n\n$$\nx'(\\theta) =  2\\cos2\\theta - 2\\sin\\theta, \\qquad\ny'(\\theta) = 2\\cos\\theta+2\\sin2\\theta,\n$$\n\nand $x'\\left(\\dfrac{3\\pi}{2}\\right) = 0,$ which of the following statements are true?\n\nI. $y'\\left(\\dfrac{3\\pi}2\\right) = 0$\n\nII. $\\lim\\limits_{\\theta \\to 3\\pi/2} \\dfrac{\\textrm d y}{\\textrm d x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta = \\dfrac{3\\pi}{2}.$\n\n*Hint: Use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point $\\theta_0$, there is a horizontal tangent at $\\theta_0$ if\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = \\dfrac{y'(\\theta_0)}{x'(\\theta_0)} = 0\n$$\n\nwhich is equivalent to\n\n$$\ny'(\\theta_0) = 0 \\qquad \\textrm{and}\\qquad x'(\\theta_0) \\neq 0.\n$$\n\nHowever, if the curve is continuous at $\\theta_0$ yet the derivative $y'(x)$ takes the indeterminate form $\\dfrac00$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n\\lim\\limits_{\\theta \\to \\theta_0} \\dfrac{\\textrm d y}{\\textrm d x} = 0.\n$$\n\nIn this case, we're told that $x'\\left(\\dfrac{3\\pi}2\\right)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta = \\dfrac{3\\pi}2$ into the expression for $y'(\\theta),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{3\\pi }{2}) & =2\\operatorname{cos}⁡(\\frac{3\\pi }{2})+2\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{2}) \\\\  & =2\\operatorname{cos}⁡(\\frac{3\\pi }{2})+2\\operatorname{sin}⁡(3\\pi ) \\\\  & =0+0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta\\to \\dfrac{3\\pi}{2}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 3\\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to 3\\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to 3\\pi /2}(\\frac{2\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡2\\theta }{2\\operatorname{cos}⁡2\\theta -2\\operatorname{sin}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 3\\pi /2}(\\frac{\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡2\\theta }{\\operatorname{cos}⁡2\\theta -\\operatorname{sin}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 3\\pi /2}(\\frac{{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡2\\theta )}^{′}}{{(\\operatorname{cos}⁡2\\theta -\\operatorname{sin}⁡\\theta )}^{′}}) \\\\  & ={lim}_{\\theta \\to 3\\pi /2}(\\frac{-\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡2\\theta }{-2\\operatorname{sin}⁡2\\theta -\\operatorname{cos}⁡\\theta }) \\\\  & =\\frac{-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2})}{-2\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{cos}⁡(\\frac{3\\pi }{2})} \\\\  & =\\frac{-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(3\\pi )}{-2\\operatorname{sin}⁡(3\\pi )-\\operatorname{cos}⁡(\\frac{3\\pi }{2})} \\\\  & =\\frac{1+2\\cdot (-1)}{-2\\cdot 0-0} \\\\  & =\\frac{1-2}{0} \\\\  & =\\frac{-1}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta=\\dfrac{3\\pi}{2}.$ In fact, it is a vertical tangent.\n\n![](images/1b/1bff05165761ba775dfae73cd4d41c28f5a939b8caca602d516636a6fb05ae75.png)\n\nTherefore, the correct answer is \"I only.\"\n\n**Note**: We'll discuss vertical tangents in more detail later in this lesson." :db/ensure [:question/validate]} {:db/id 17592186188316 :knowledge-point/questions ["question-0404d67e-b2ba-59db-a275-bcabad92e41d" "question-8abdd58d-cab9-5ebc-bd19-2d063796fe12" "question-0e768435-2535-570e-8108-8e3e9452ca28" "question-9323ccd3-7220-5dbc-9cd7-954d1072bf99"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188023 :question/problem "Consider the polar curve $r=\\cot^2\\theta$ for $\\theta \\in \\left(0, \\pi\\right).$ Given that \n\n$$\nx'(\\theta) = -\\cot\\theta(\\cos\\theta + 2\\cot\\theta\\csc\\theta), \\qquad\ny'(\\theta) = -\\cot\\theta\\csc\\theta(1+\\sin^2\\theta),\n$$\n\nand $y'\\left(\\dfrac{\\pi}{2}\\right) = 0,$ which of the following statements are true?\n\nI. $x'\\left(\\dfrac\\pi2\\right) = 0$\n\nII. $\\lim\\limits_{\\theta \\to (\\pi/2)^{+}} \\dfrac{\\textrm d y}{\\textrm d x}=-\\infty$\n\nIII. The curve has a vertical tangent at $\\theta = \\dfrac\\pi 2$\n\n*Hint: You may wish to make use of the following results.*\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta \\to {0}^{+}\\,\\text{as}\\,\\theta \\to {(\\frac{\\pi }{2})}^{-} \\\\ \\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta \\to {0}^{-}\\,\\text{as}\\,\\theta \\to {(\\frac{\\pi }{2})}^{+}\\end{aligned}\n$$\n\n*It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta = \\theta_0$ if\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = \\dfrac{y'(\\theta_0)}{x'(\\theta_0)}\n$$\n\nis infinite. This means that\n\n$$\ny'(\\theta_0) \\neq 0 \\qquad \\textrm{and}\\qquad x'(\\theta_0) = 0.\n$$\n\nHowever, if the curve is continuous at $\\theta_0$ yet the derivative takes the indeterminate form $\\dfrac00$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n\\lim\\limits_{\\theta \\to \\theta_0^{-}} \\dfrac{\\textrm d y}{\\textrm d x} = \\pm\\infty \\qquad\\textrm{and}\\qquad \\lim\\limits_{\\theta \\to \\theta_0^{+}} \\dfrac{\\textrm d y}{\\textrm d x} = \\pm\\infty.\n$$\n\nIn this case, we're told that $y'\\left(\\dfrac\\pi2\\right)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta = \\dfrac\\pi2$ into the expression for $x'(\\theta),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{cot}⁡(\\frac{\\pi }{2})(\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{cot}⁡(\\frac{\\pi }{2})\\operatorname{csc}⁡(\\frac{\\pi }{2})) \\\\  & =0\\cdot (0+2\\cdot 0\\cdot 1) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta\\to\\left(\\dfrac{\\pi}{2}\\right)^+,$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{-\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta (1+{sin}^{2}⁡\\theta )}{-\\operatorname{cot}⁡\\theta (\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta )}) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{-\\cancel{cot}\\theta \\operatorname{csc}⁡\\theta (1+{sin}^{2}⁡\\theta )}{-\\cancel{cot}\\theta (\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta )}) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{csc}⁡\\theta (1+{sin}^{2}⁡\\theta )}{\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta }).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}(\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta ) & =\\operatorname{csc}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, using the second hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta }) \\\\  & =\\frac{2}{{0}^{-}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part I, and the first hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta +2\\operatorname{cot}⁡\\theta \\operatorname{csc}⁡\\theta }) \\\\  & =\\frac{2}{{0}^{+}} \\\\  & =\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta=\\dfrac{\\pi}{2}.$ \n\n![](images/2d/2dc0665a0f979fd247d010a7b6d5891a758eff7e5357b881011ddf0d3f2f2002.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :db/ensure [:question/validate]} {:db/id "question-5f78e73c-c303-57f1-975d-3a308d3af577" :question/id #uuid "5f78e73c-c303-57f1-975d-3a308d3af577" :question/math-academy-id "q-143690" :question/problem "Consider the polar curve $r=1+\\operatorname{cos}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-\\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡(2\\theta ),\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta +\\operatorname{cos}⁡(2\\theta ),\n$$\n\nand ${x}^{′}(\\theta )=0$ at $\\theta =\\pi ,$ which of the following statements are true?\n\nI. ${y}^{′}(\\pi )=0$\n\nII. ${lim}_{\\theta \\to \\pi }\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\pi $\n\n*Hint: Use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\pi )=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\pi $ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\pi ) & =\\operatorname{cos}⁡(\\pi )+\\operatorname{cos}⁡(2\\cdot \\pi ) \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi }\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi }\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi }(\\frac{\\operatorname{cos}⁡\\theta +\\operatorname{cos}⁡(2\\theta )}{-\\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi }(\\frac{(\\operatorname{cos}⁡\\theta +\\operatorname{cos}⁡(2\\theta ))^{′}}{(-\\operatorname{sin}⁡(\\theta )-\\operatorname{sin}⁡(2\\theta ))^{′}}) \\\\  & ={lim}_{\\theta \\to \\pi }(\\frac{-\\operatorname{sin}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}{-\\operatorname{cos}⁡(\\theta )-2\\operatorname{cos}⁡(2\\theta )}) \\\\  & =\\frac{-\\operatorname{sin}⁡\\pi -2\\operatorname{sin}⁡(2\\cdot \\pi )}{-\\operatorname{cos}⁡\\pi -2\\operatorname{cos}⁡(2\\pi )} \\\\  & =\\frac{0}{-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is true. Since the limit in part II equals $0,$ there is a horizontal tangent at $\\theta =0.$\n\n![](images/d1/d1308067e18807f159aee95433ea645be71abd153aa03888ef8092cf6fe226bd.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c2b0c7cd-ed3d-59d4-a4a4-9ad3a4bcbf7b"] :db/ensure [:question/validate]} {:db/id "answer-field-c2b0c7cd-ed3d-59d4-a4a4-9ad3a4bcbf7b" :answer-field/id #uuid "c2b0c7cd-ed3d-59d4-a4a4-9ad3a4bcbf7b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b433e913-f866-5b33-9b59-0a4885da5fd5" :answer-field/choices ["answer-7edb7d92-e818-544e-823b-3f4730b7ef09" "answer-97933b81-d675-57e7-930c-b4fb844e708e" "answer-89060f9d-efdf-54d3-92e8-0dd1496bbd98" "answer-b433e913-f866-5b33-9b59-0a4885da5fd5" "answer-e3777b0b-88ad-5005-9923-c4af38304f08"] :db/ensure [:answer-field/validate]} {:db/id "answer-7edb7d92-e818-544e-823b-3f4730b7ef09" :answer/id #uuid "7edb7d92-e818-544e-823b-3f4730b7ef09" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-97933b81-d675-57e7-930c-b4fb844e708e" :answer/id #uuid "97933b81-d675-57e7-930c-b4fb844e708e" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-89060f9d-efdf-54d3-92e8-0dd1496bbd98" :answer/id #uuid "89060f9d-efdf-54d3-92e8-0dd1496bbd98" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-b433e913-f866-5b33-9b59-0a4885da5fd5" :answer/id #uuid "b433e913-f866-5b33-9b59-0a4885da5fd5" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-e3777b0b-88ad-5005-9923-c4af38304f08" :answer/id #uuid "e3777b0b-88ad-5005-9923-c4af38304f08" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-464ccc1b-341e-50cc-a320-81b9eb3e2aa7" :question/id #uuid "464ccc1b-341e-50cc-a320-81b9eb3e2aa7" :question/math-academy-id "q-143720" :question/problem "Consider the polar curve $r={cos}^{3}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-4\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta ,\\,{y}^{′}(\\theta )={cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & ={cos}^{2}⁡(\\frac{\\pi }{2})({cos}^{2}⁡(\\frac{\\pi }{2})-3{sin}^{2}⁡(\\frac{\\pi }{2})) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta )}{-4\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\cancel{{cos}^{2}⁡\\theta }({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta )}{-4\\operatorname{sin}⁡\\theta {cos}^{\\cancel{3}}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta }{-4\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }) \\\\  & =\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-3{sin}^{2}⁡(\\frac{\\pi }{2})}{-4\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{-3}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/8b/8b68110c25bfa464c0971a396ec50908c0c0622cbdc92bf42239b984695655ca.png)\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-20ad0273-0b41-526f-89b9-432d7d34c4cd"] :db/ensure [:question/validate]} {:db/id "answer-field-20ad0273-0b41-526f-89b9-432d7d34c4cd" :answer-field/id #uuid "20ad0273-0b41-526f-89b9-432d7d34c4cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c9393e8-ba50-577d-bc72-427a22d73c00" :answer-field/choices ["answer-d784e426-65aa-55a1-bf4a-3e0846cd4ebc" "answer-2c9393e8-ba50-577d-bc72-427a22d73c00" "answer-643536bd-f153-53c3-950f-0557b9212659" "answer-c9ecdef1-5b9f-50e3-ad8c-ca6553b623db" "answer-bfd84e4c-427d-5399-8b03-e39a998a285a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d784e426-65aa-55a1-bf4a-3e0846cd4ebc" :answer/id #uuid "d784e426-65aa-55a1-bf4a-3e0846cd4ebc" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-2c9393e8-ba50-577d-bc72-427a22d73c00" :answer/id #uuid "2c9393e8-ba50-577d-bc72-427a22d73c00" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-643536bd-f153-53c3-950f-0557b9212659" :answer/id #uuid "643536bd-f153-53c3-950f-0557b9212659" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-c9ecdef1-5b9f-50e3-ad8c-ca6553b623db" :answer/id #uuid "c9ecdef1-5b9f-50e3-ad8c-ca6553b623db" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-bfd84e4c-427d-5399-8b03-e39a998a285a" :answer/id #uuid "bfd84e4c-427d-5399-8b03-e39a998a285a" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id 17592186188566 :question/problem "Consider the polar curve $r=1-\\operatorname{sin}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-\\operatorname{sin}⁡(\\theta )-\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡(\\theta )-\\operatorname{sin}⁡(2\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\pi /2$\n\n*Hint: Use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(\\pi ) \\\\  & =0-0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{cos}⁡(\\theta )-\\operatorname{sin}⁡(2\\theta )}{-\\operatorname{sin}⁡(\\theta )-\\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{(\\operatorname{cos}⁡(\\theta )-\\operatorname{sin}⁡(2\\theta ))}^{′}}{{(-\\operatorname{sin}⁡(\\theta )-\\operatorname{cos}⁡(2\\theta ))}^{′}}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{-\\operatorname{sin}⁡(\\theta )-2\\operatorname{cos}⁡(2\\theta )}{-\\operatorname{cos}⁡(\\theta )+2\\operatorname{sin}⁡(2\\theta )}) \\\\  & =\\frac{-\\operatorname{sin}⁡(\\frac{\\pi }{2})-2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})}{-\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})} \\\\  & =\\frac{-\\operatorname{sin}⁡(\\frac{\\pi }{2})-2\\operatorname{cos}⁡(\\pi )}{-\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{sin}⁡(\\pi )} \\\\  & =\\frac{-1-2\\cdot (-1)}{0+2\\cdot 0} \\\\  & =\\frac{-1+2}{0} \\\\  & =\\frac{1}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/2c/2c1b42bf3a8c1b5f8755e02a162e1554904bbc432285cb8ba8c7b06181e1cc03.png)\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186185676 :answer-field/correct 17592186185679 :db/ensure [:answer-field/validate]} {:db/id "question-613239a3-89a3-5820-a45d-8b5d5da600ee" :question/id #uuid "613239a3-89a3-5820-a45d-8b5d5da600ee" :question/math-academy-id "q-143586" :question/problem "Consider the polar curve $r=3\\operatorname{cos}⁡\\theta -3$ for $\\theta \\in [-\\pi ,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=3\\operatorname{sin}⁡(\\theta )-3\\operatorname{sin}⁡(2\\theta ),\\,{y}^{′}(\\theta )=3\\operatorname{cos}⁡(2\\theta )-3\\operatorname{cos}⁡(\\theta ),\n$$\n\nand ${x}^{′}(\\theta )=0$ at $\\theta =0,$ which of the following statements are true?\n\nI. ${y}^{′}(0)=0$\n\nII. ${lim}_{\\theta \\to 0}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =0$\n\n*Hint: Use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(0)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =0$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =3\\operatorname{cos}⁡(2\\cdot 0)-3\\operatorname{cos}⁡(0) \\\\  & =3-3 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to 0}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to 0}(\\frac{3\\operatorname{cos}⁡(2\\theta )-3\\operatorname{cos}⁡(\\theta )}{3\\operatorname{sin}⁡(\\theta )-3\\operatorname{sin}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{(3\\operatorname{cos}⁡(2\\theta )-3\\operatorname{cos}⁡(\\theta ))^{′}}{(3\\operatorname{sin}⁡(\\theta )-3\\operatorname{sin}⁡(2\\theta ))^{′}}) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{-6\\operatorname{sin}⁡(2\\theta )+3\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(\\theta )-6\\operatorname{cos}⁡(2\\theta )}) \\\\  & =\\frac{6\\operatorname{sin}⁡(2\\cdot 0)-3\\operatorname{sin}⁡(0)}{3\\operatorname{cos}⁡(0)-6\\operatorname{cos}⁡(2\\cdot 0)} \\\\  & =\\frac{0}{-3} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, there is a horizontal tangent at $\\theta =0.$\n\n![](images/9e/9ef9840644e37fbb660ede7d574d8814b9ce7ce3bd0ff3790b5c5d21420f3e70.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ae25116c-2863-575b-8604-36e46667778c"] :db/ensure [:question/validate]} {:db/id "answer-field-ae25116c-2863-575b-8604-36e46667778c" :answer-field/id #uuid "ae25116c-2863-575b-8604-36e46667778c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9120367-b038-51b1-82ec-64924db5b41f" :answer-field/choices ["answer-32345ee7-7a47-5474-a2bb-6e4a4aea50e0" "answer-c9ae8e98-0ca4-56d8-aaa8-7d7045c480d8" "answer-f9120367-b038-51b1-82ec-64924db5b41f" "answer-a8ce0a40-fa35-5f06-883c-f11fe791d936" "answer-6e5190c4-8756-52a6-96ba-4837d6e37505"] :db/ensure [:answer-field/validate]} {:db/id "answer-32345ee7-7a47-5474-a2bb-6e4a4aea50e0" :answer/id #uuid "32345ee7-7a47-5474-a2bb-6e4a4aea50e0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-c9ae8e98-0ca4-56d8-aaa8-7d7045c480d8" :answer/id #uuid "c9ae8e98-0ca4-56d8-aaa8-7d7045c480d8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-f9120367-b038-51b1-82ec-64924db5b41f" :answer/id #uuid "f9120367-b038-51b1-82ec-64924db5b41f" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-a8ce0a40-fa35-5f06-883c-f11fe791d936" :answer/id #uuid "a8ce0a40-fa35-5f06-883c-f11fe791d936" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-6e5190c4-8756-52a6-96ba-4837d6e37505" :answer/id #uuid "6e5190c4-8756-52a6-96ba-4837d6e37505" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-85bc8151-a6d7-5a1f-86a0-0e52ad8f1c73" :question/id #uuid "85bc8151-a6d7-5a1f-86a0-0e52ad8f1c73" :question/math-academy-id "q-143691" :question/problem "Consider the polar curve $r={sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta $ for $\\theta \\in (-\\pi ,\\pi ].$ Given that\n\n$$\n{x}^{′}(\\theta )=\\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )={sin}^{2}⁡\\theta (3{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\n$$\n\nand ${y}^{′}(\\theta )=0$ at $\\theta =0,$ which of the following statements are true?\n\nI. ${x}^{′}(0)=0$\n\nII. ${lim}_{\\theta \\to 0}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =0$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" :question/worked-solution "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${y}^{′}(0)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =0$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(0) & =\\operatorname{sin}⁡(2\\cdot 0)\\operatorname{cos}⁡(2\\cdot 0) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to 0}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to 0}(\\frac{{sin}^{2}⁡\\theta (3{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )}{\\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{{sin}^{2}⁡\\theta (3{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{{sin}^{\\cancel{2}}⁡\\theta (3{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )}{2\\cancel{\\operatorname{sin}⁡\\theta }\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{\\operatorname{sin}⁡\\theta (3{cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )}{2\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & =\\frac{\\operatorname{sin}⁡(0)(3{cos}^{2}⁡(0)-{sin}^{2}⁡(0))}{2\\operatorname{cos}⁡(0)\\operatorname{cos}⁡(2\\cdot 0)} \\\\  & =\\frac{0\\cdot (3\\cdot 1-0)}{2\\cdot 1\\cdot 1} \\\\  & =\\frac{0}{2} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is true. Since the limit in part II equals $0,$ there curve has a horizontal tangent at $\\theta =0.$\n\n![](images/a4/a48593a3bbcc61afaf80de619be505cb6dac58c559e03a0eab4553bd5a1e5013.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5bc92c9a-d12a-524b-92a8-ef263ab3cb9f"] :db/ensure [:question/validate]} {:db/id "answer-field-5bc92c9a-d12a-524b-92a8-ef263ab3cb9f" :answer-field/id #uuid "5bc92c9a-d12a-524b-92a8-ef263ab3cb9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1125bf9-4c3c-53b1-989c-df79c04e9962" :answer-field/choices ["answer-1d5d7f63-4773-5ead-8708-dd1a010b746b" "answer-f3d2719f-efb2-5cdd-a3fc-2255411e9071" "answer-f0275ae7-961c-5830-84f1-365d4ad8c89e" "answer-e1125bf9-4c3c-53b1-989c-df79c04e9962" "answer-32901a19-e02f-575c-8024-84512c37ec77"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d5d7f63-4773-5ead-8708-dd1a010b746b" :answer/id #uuid "1d5d7f63-4773-5ead-8708-dd1a010b746b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f3d2719f-efb2-5cdd-a3fc-2255411e9071" :answer/id #uuid "f3d2719f-efb2-5cdd-a3fc-2255411e9071" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f0275ae7-961c-5830-84f1-365d4ad8c89e" :answer/id #uuid "f0275ae7-961c-5830-84f1-365d4ad8c89e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e1125bf9-4c3c-53b1-989c-df79c04e9962" :answer/id #uuid "e1125bf9-4c3c-53b1-989c-df79c04e9962" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-32901a19-e02f-575c-8024-84512c37ec77" :answer/id #uuid "32901a19-e02f-575c-8024-84512c37ec77" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "question-0404d67e-b2ba-59db-a275-bcabad92e41d" :question/id #uuid "0404d67e-b2ba-59db-a275-bcabad92e41d" :question/math-academy-id "q-145010" :question/problem "Consider the polar curve $r=2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=\\operatorname{cos}⁡(2\\theta )+\\operatorname{cos}⁡(4\\theta ),\\,{y}^{′}(\\theta )=\\operatorname{sin}⁡(4\\theta ),\n$$\n\nand ${y}^{′}(\\frac{3\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${x}^{′}(\\frac{3\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{3\\pi }{2}$\n\n*Hint: You may wish to make use of the following results.*\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\theta )+2\\operatorname{sin}⁡(4\\theta )\\to {0}^{-}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{-} \\\\ \\operatorname{sin}⁡(2\\theta )+2\\operatorname{sin}⁡(4\\theta )\\to {0}^{+}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{+}\\end{aligned}\n$$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(\\frac{3\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{3\\pi }{2}$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{3\\pi }{2}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2})+\\operatorname{cos}⁡(4\\cdot \\frac{3\\pi }{2}) \\\\  & =\\operatorname{cos}⁡(3\\pi )+\\operatorname{cos}⁡(6\\pi ) \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{3\\pi }{2})}^{-}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{\\operatorname{sin}⁡(4\\theta )}{\\operatorname{cos}⁡(2\\theta )+\\operatorname{cos}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{(\\operatorname{sin}⁡(4\\theta ))^{′}}{(\\operatorname{cos}⁡(2\\theta )+\\operatorname{cos}⁡(4\\theta ))^{′}}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{4\\operatorname{cos}⁡(4\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-4\\operatorname{sin}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{4\\operatorname{cos}⁡(4\\theta )}{-2(\\operatorname{sin}⁡(2\\theta )+2\\operatorname{sin}⁡(4\\theta ))}).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}4\\operatorname{cos}⁡(4\\theta ) & =4\\operatorname{cos}⁡(4\\cdot \\frac{3\\pi }{2}) \\\\  & =4\\operatorname{cos}⁡(6\\pi ) \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, using the first hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{4\\operatorname{cos}⁡(4\\theta )}{-2(\\operatorname{sin}⁡(2\\theta )+2\\operatorname{sin}⁡(4\\theta )}) \\\\  & =\\frac{4}{-2\\cdot {0}^{-}} \\\\  & =\\frac{4}{{0}^{+}} \\\\  & =\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, and the second hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{+}}(\\frac{4\\operatorname{cos}⁡(4\\theta )}{-2(\\operatorname{sin}⁡(2\\theta )+2\\operatorname{sin}⁡(4\\theta )}) \\\\  & =\\frac{4}{-2\\cdot {0}^{+}} \\\\  & =\\frac{4}{{0}^{-}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{3\\pi }{2}.$\n\n![](images/f9/f9a4fc8fa61dac84d3dbc4bc48f86e2b702f7854b1fd1d3b3e5f4303fe7769a7.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-810830be-38ed-57ee-8e7a-4d8bf93a0313"] :db/ensure [:question/validate]} {:db/id "answer-field-810830be-38ed-57ee-8e7a-4d8bf93a0313" :answer-field/id #uuid "810830be-38ed-57ee-8e7a-4d8bf93a0313" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-075ae8f3-57cb-5b60-ba7d-7b522771c11d" :answer-field/choices ["answer-a9848c7d-6940-59ef-bdc8-e27fe80c778e" "answer-1b055083-25b0-50bd-915e-94df9cc030f2" "answer-b874085c-4187-5a6d-8924-748d9c4f64b3" "answer-075ae8f3-57cb-5b60-ba7d-7b522771c11d" "answer-321c8f80-1da5-598f-8ac9-48d513b22952"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9848c7d-6940-59ef-bdc8-e27fe80c778e" :answer/id #uuid "a9848c7d-6940-59ef-bdc8-e27fe80c778e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-1b055083-25b0-50bd-915e-94df9cc030f2" :answer/id #uuid "1b055083-25b0-50bd-915e-94df9cc030f2" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-b874085c-4187-5a6d-8924-748d9c4f64b3" :answer/id #uuid "b874085c-4187-5a6d-8924-748d9c4f64b3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-075ae8f3-57cb-5b60-ba7d-7b522771c11d" :answer/id #uuid "075ae8f3-57cb-5b60-ba7d-7b522771c11d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-321c8f80-1da5-598f-8ac9-48d513b22952" :answer/id #uuid "321c8f80-1da5-598f-8ac9-48d513b22952" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "question-8abdd58d-cab9-5ebc-bd19-2d063796fe12" :question/id #uuid "8abdd58d-cab9-5ebc-bd19-2d063796fe12" :question/math-academy-id "q-145211" :question/problem "Consider the polar curve $r=8{sin}^{3}⁡\\theta -8{sin}^{5}⁡\\theta $ for $\\theta \\in (-\\pi ,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=3\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡(4\\theta ),\\,{y}^{′}(\\theta )=16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1),\n$$\n\nand ${y}^{′}(0)=0,$ which of the following statements are true?\n\nI. ${x}^{′}(0)=0$\n\nII. ${lim}_{\\theta \\to {0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =0$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(0)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =0$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(0) & =3\\operatorname{sin}⁡(2\\cdot 0)\\operatorname{sin}⁡(4\\cdot 0) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to {0}^{-},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to {0}^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to {0}^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{3\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{6\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{12\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{24{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{\\cancel{3}}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }(3{cos}^{2}⁡\\theta -1)}{24\\cancel{{sin}^{2}⁡\\theta }{cos}^{\\cancel{2}}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16\\operatorname{sin}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{24\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & =\\frac{16\\operatorname{sin}⁡(0)(3{cos}^{2}⁡(0)-1)}{24\\operatorname{cos}⁡(0)\\operatorname{cos}⁡(2\\cdot 0)} \\\\  & =\\frac{0}{24} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is false. Since the right limit of our derivative is not infinite, the curve does *not* have a vertical tangent at $\\theta =0.$ In fact, it is a horizontal tangent.\n\n![](images/4a/4a525b9a7a04f228bb45dc8c0c1cb916d1e98d8907e5fb1411ea52eb964c96ef.png)\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-52fae6cf-133f-598f-bd90-ed8251199a12"] :db/ensure [:question/validate]} {:db/id "answer-field-52fae6cf-133f-598f-bd90-ed8251199a12" :answer-field/id #uuid "52fae6cf-133f-598f-bd90-ed8251199a12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a0f8ef7-8816-5c3a-91f4-4b087e45c987" :answer-field/choices ["answer-1c8ad316-23d2-5788-a2fe-5f1b87f5e5c7" "answer-0aaf653d-0c2b-54b8-b819-d44c0fbe6880" "answer-7a0f8ef7-8816-5c3a-91f4-4b087e45c987" "answer-8e29dbac-2fa1-558b-8390-191d5f378a62" "answer-2cc6d1eb-c42d-5931-9dbe-d36709d00384"] :db/ensure [:answer-field/validate]} {:db/id "answer-1c8ad316-23d2-5788-a2fe-5f1b87f5e5c7" :answer/id #uuid "1c8ad316-23d2-5788-a2fe-5f1b87f5e5c7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-0aaf653d-0c2b-54b8-b819-d44c0fbe6880" :answer/id #uuid "0aaf653d-0c2b-54b8-b819-d44c0fbe6880" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7a0f8ef7-8816-5c3a-91f4-4b087e45c987" :answer/id #uuid "7a0f8ef7-8816-5c3a-91f4-4b087e45c987" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-8e29dbac-2fa1-558b-8390-191d5f378a62" :answer/id #uuid "8e29dbac-2fa1-558b-8390-191d5f378a62" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-2cc6d1eb-c42d-5931-9dbe-d36709d00384" :answer/id #uuid "2cc6d1eb-c42d-5931-9dbe-d36709d00384" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "question-0e768435-2535-570e-8108-8e3e9452ca28" :question/id #uuid "0e768435-2535-570e-8108-8e3e9452ca28" :question/math-academy-id "q-145215" :question/problem "Consider the polar curve $r={tan}^{2}⁡\\theta $ for $\\theta \\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ Given that \n\n$$\n{x}^{′}(\\theta )=\\operatorname{tan}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sec}⁡\\theta ),\\,{y}^{′}(\\theta )={tan}^{2}⁡\\theta \\operatorname{sec}⁡\\theta ({cos}^{2}⁡\\theta +2),\\,\n$$\n\nand ${x}^{′}(0)=0,$ which of the following statements are true?\n\nI. ${y}^{′}(0)=0$\n\nII. ${lim}_{\\theta \\to {0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =0$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${x}^{′}(0)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =0$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & ={tan}^{2}⁡(0)\\operatorname{sec}⁡(0)({cos}^{2}⁡(0)+2) \\\\  & =0\\cdot 1\\cdot ({1}^{2}+2) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to {0}^{+},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to {0}^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to {0}^{+}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to {0}^{+}}(\\frac{{tan}^{2}⁡\\theta \\operatorname{sec}⁡\\theta ({cos}^{2}⁡\\theta +2)}{\\operatorname{tan}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sec}⁡\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{+}}(\\frac{{tan}^{\\cancel{2}}⁡\\theta \\operatorname{sec}⁡\\theta ({cos}^{2}⁡\\theta +2)}{\\cancel{\\operatorname{tan}⁡\\theta }(\\operatorname{cos}⁡\\theta +\\operatorname{sec}⁡\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{+}}(\\frac{\\operatorname{tan}⁡\\theta \\operatorname{sec}⁡\\theta ({cos}^{2}⁡\\theta +2)}{\\operatorname{cos}⁡\\theta +\\operatorname{sec}⁡\\theta }) \\\\  & =\\frac{\\operatorname{tan}⁡(0)\\operatorname{sec}⁡(0)({cos}^{2}⁡(0)+2)}{\\operatorname{cos}⁡(0)+\\operatorname{sec}⁡(0)} \\\\  & =\\frac{0\\cdot 1\\cdot ({1}^{2}+2)}{1+1} \\\\  & =\\frac{0}{2} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is false. Since the right limit of our derivative is not infinite, the curve does *not* have a vertical tangent at $\\theta =0.$ In fact, it is a horizontal tangent.\n\n![](images/49/498b937eba18870a36ee6f09bb99cf7dde38eb95c4cc2aa6edcb46080d0fcf04.png)\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ec36f9e6-099c-5944-9227-f178df8ff3ba"] :db/ensure [:question/validate]} {:db/id "answer-field-ec36f9e6-099c-5944-9227-f178df8ff3ba" :answer-field/id #uuid "ec36f9e6-099c-5944-9227-f178df8ff3ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7da7cab9-5764-5643-bc50-07cd0bd2f864" :answer-field/choices ["answer-75b52c4a-dd39-5248-b7ac-60a9f8d0e11f" "answer-20d01cf0-d95f-5916-b4f3-763c5a6e9849" "answer-7da7cab9-5764-5643-bc50-07cd0bd2f864" "answer-af09275f-fbfc-52f1-b658-e8836b59b4f3" "answer-00e4d7f5-507c-5de7-88d4-ea15a0e80797"] :db/ensure [:answer-field/validate]} {:db/id "answer-75b52c4a-dd39-5248-b7ac-60a9f8d0e11f" :answer/id #uuid "75b52c4a-dd39-5248-b7ac-60a9f8d0e11f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-20d01cf0-d95f-5916-b4f3-763c5a6e9849" :answer/id #uuid "20d01cf0-d95f-5916-b4f3-763c5a6e9849" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7da7cab9-5764-5643-bc50-07cd0bd2f864" :answer/id #uuid "7da7cab9-5764-5643-bc50-07cd0bd2f864" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-af09275f-fbfc-52f1-b658-e8836b59b4f3" :answer/id #uuid "af09275f-fbfc-52f1-b658-e8836b59b4f3" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-00e4d7f5-507c-5de7-88d4-ea15a0e80797" :answer/id #uuid "00e4d7f5-507c-5de7-88d4-ea15a0e80797" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id 17592186188567 :question/problem "Consider the polar curve $r=\\operatorname{sin}⁡\\theta -1$ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=\\operatorname{sin}⁡(\\theta )+\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )=-\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: You may wish to make use of the following results.*\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\theta )-2\\operatorname{sin}⁡(2\\theta )\\to {0}^{-}\\,\\text{as}\\,\\theta \\to {(\\frac{\\pi }{2})}^{-} \\\\ \\operatorname{cos}⁡(\\theta )-2\\operatorname{sin}⁡(2\\theta )\\to {0}^{+}\\,\\text{as}\\,\\theta \\to {(\\frac{\\pi }{2})}^{+}\\end{aligned}\n$$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(\\pi ) \\\\  & =-0+0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{\\pi }{2})}^{-}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{-\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta )}{\\operatorname{sin}⁡(\\theta )+\\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{{(-\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ))}^{′}}{{(\\operatorname{sin}⁡(\\theta )+\\operatorname{cos}⁡(2\\theta ))}^{′}}) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡(\\theta )-2\\operatorname{sin}⁡(2\\theta )}).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}(\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(\\pi ) \\\\  & =1+2\\cdot (-1) \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, using the first hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡(\\theta )-2\\operatorname{sin}⁡(2\\theta )}) \\\\  & =\\frac{-1}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, and the second hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡(\\theta )-2\\operatorname{sin}⁡(2\\theta )}) \\\\  & =\\frac{-1}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{\\pi }{2}.$\n\n![](images/51/515b4cbcb39ad80d4401adffd450aed9e222663c469f1cf1cf36cbd900b5eb4b.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186185682 :answer-field/correct 17592186185684 :db/ensure [:answer-field/validate]} {:db/id "question-9323ccd3-7220-5dbc-9cd7-954d1072bf99" :question/id #uuid "9323ccd3-7220-5dbc-9cd7-954d1072bf99" :question/math-academy-id "q-144998" :question/problem "Consider the polar curve $r=1+\\operatorname{sin}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta ),\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ),\n$$\n\nand ${y}^{′}(\\frac{3\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${x}^{′}(\\frac{3\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{3\\pi }{2}$\n\n*Hint: You may wish to make use of the following results.*\n\n$$\n\\begin{aligned}-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )\\to {0}^{-}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{-} \\\\ -2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )\\to {0}^{+}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{+}\\end{aligned}\n$$" :question/worked-solution "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(\\frac{3\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{3\\pi }{2}$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{3\\pi }{2}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =\\operatorname{cos}⁡(3\\pi )-\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =-1-(-1) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{3\\pi }{2})}^{-}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta )}{\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{{(\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ))}^{′}}{{(\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta ))}^{′}}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}(-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )) & =-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2}) \\\\  & =-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(3\\pi ) \\\\  & =-(-1)+2\\cdot (-1) \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, using the first hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{-1}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, and the second hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{+}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{-1}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{3\\pi }{2}.$\n\n![](images/f4/f4462c7c41e7d6d5d10acec7627ac54f73477569356e22857659f5110847302d.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d36c8c24-f03d-546f-b34a-dde62ed00658"] :db/ensure [:question/validate]} {:db/id "answer-field-d36c8c24-f03d-546f-b34a-dde62ed00658" :answer-field/id #uuid "d36c8c24-f03d-546f-b34a-dde62ed00658" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0a30101-e4dc-5b47-b643-52f9a3f0157a" :answer-field/choices ["answer-7ba9a9c7-f876-5d21-ad58-1993aa10b700" "answer-d2799d84-2613-5167-82f5-661dd78222f3" "answer-d0a30101-e4dc-5b47-b643-52f9a3f0157a" "answer-b823e1fd-ed55-5af9-8476-217b9d2d2816" "answer-e3855878-ba32-5feb-81b3-dfb3a2d666f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-7ba9a9c7-f876-5d21-ad58-1993aa10b700" :answer/id #uuid "7ba9a9c7-f876-5d21-ad58-1993aa10b700" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d2799d84-2613-5167-82f5-661dd78222f3" :answer/id #uuid "d2799d84-2613-5167-82f5-661dd78222f3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d0a30101-e4dc-5b47-b643-52f9a3f0157a" :answer/id #uuid "d0a30101-e4dc-5b47-b643-52f9a3f0157a" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-b823e1fd-ed55-5af9-8476-217b9d2d2816" :answer/id #uuid "b823e1fd-ed55-5af9-8476-217b9d2d2816" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e3855878-ba32-5feb-81b3-dfb3a2d666f1" :answer/id #uuid "e3855878-ba32-5feb-81b3-dfb3a2d666f1" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186189380 :tutorial/content "Let's consider the curve $r = 1+\\cos\\theta$ for $0\\leq \\theta < 2\\pi,$ shown below.\n\n![](images/e7/e72d6a7d4b490a37f99723d0cde12a378f038b43ba373547e9c8feaf71952717.png)\n\nUsing previously discussed techniques, it's straightforward to show that at point $C$ where $\\theta = \\pi,$ we have\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = \\dfrac{y'(\\theta)}{x'(\\theta)} = \\dfrac00.\n$$\n\nTo see what's happening at this point, let's zoom in and observe the behavior of the curve.\n\n![](images/d0/d03ca27e8cecd32aebc0e6914ac2ab128bce57ab876b96e8aaa91b562041ba4c.png)\n\nIf we look carefully, we notice that the tangent lines flatten out as we approach the point $C$ from either direction.\n\n![](images/4f/4fda95ed912c83ac36ec772b6afa6554ad8a81b7c98a330fd774d501b4bbecdf.png)\n\nTherefore, as we take the *limit* of the tangent lines as we approach $C,$ it would appear that they become horizontal. \n\n![](images/50/50f8bd688c55d8458a9db100469cd62138efc200402496d3adb18f90ea53e747.png)\n\nWhen the limit of the tangent lines becomes horizontal like this, we say that the curve has a horizontal tangent at $C.$" :db/ensure [:tutorial/validate]} {:db/id 17592186189391 :tutorial/content "So, it seems that the curve $r = 1+\\cos\\theta$ has a horizontal tangent at $\\theta = \\pi.$ However, to be sure of this, we need to check that the tangent lines flatten out as we approach $\\theta = \\pi.$ In other words, we need to check that\n\n \n\n$$\n\\lim\\limits_{\\theta \\to \\pi} \\dfrac{\\textrm d y}{\\textrm d x} = 0.\n$$\n\nLet's now verify that this is true:\n\nUsing techniques discussed in previous lessons, it's straightforward to show that\n\n$$\nx'(\\theta)=-\\sin\\theta(2\\cos\\theta+1), \\qquad \ny'(\\theta)=2\\cos^2\\theta +\\cos\\theta - 1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi }\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi }(\\frac{2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1}{-\\operatorname{sin}⁡\\theta (2\\operatorname{cos}⁡\\theta +1)}) \\\\  & =-{lim}_{\\theta \\to \\pi }(\\frac{2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1}{\\operatorname{sin}⁡\\theta (2\\operatorname{cos}⁡\\theta +1)}) \\\\  & =-{lim}_{\\theta \\to \\pi }(\\frac{2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta }) \\\\  & =-{lim}_{\\theta \\to \\pi }(\\frac{2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1}{\\operatorname{sin}⁡2\\theta +\\operatorname{sin}⁡\\theta }).\\end{aligned}\n$$\n\nWe already know that substituting $\\theta = \\pi$ gives the indeterminate form $\\dfrac00,$ so evaluating this limit by direct substitution won't work. However, we can evaluate this limit using L'Hopital's rule.\n\nApplying L'Hopital's rule, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi }\\frac{\\text{d}y}{\\text{d}x} & =-{lim}_{\\theta \\to \\pi }(\\frac{2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1}{\\operatorname{sin}⁡2\\theta +\\operatorname{sin}⁡\\theta }) \\\\  & =-{lim}_{\\theta \\to \\pi }(\\frac{(2{cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta -1)^{′}}{(\\operatorname{sin}⁡2\\theta +\\operatorname{sin}⁡\\theta )^{′}}) \\\\  & =-{lim}_{\\theta \\to \\pi }(\\frac{-4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡\\theta }{2\\operatorname{cos}⁡2\\theta +\\operatorname{cos}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to \\pi }(\\frac{4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta }{2\\operatorname{cos}⁡2\\theta +\\operatorname{cos}⁡\\theta }) \\\\  & =\\frac{4\\operatorname{cos}⁡\\pi \\operatorname{sin}⁡\\pi +\\operatorname{sin}⁡\\pi }{2\\operatorname{cos}⁡2\\pi +\\operatorname{cos}⁡\\pi } \\\\  & =\\frac{4\\cdot (-1)\\cdot (0)+0}{2\\cdot 1+(-1)} \\\\  & =\\frac{0}{1} \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, since\n\n$$\n\\lim\\limits_{\\theta \\to \\pi} \\dfrac{\\textrm d y}{\\textrm d x} = 0\n$$\n\nwe conclude that our curve does indeed have a horizontal tangent at $\\theta = \\pi.$\n\n![](images/f1/f172dbe1e7fa97fa924feed4ee193a620b1224a985a4e406ef4e46afbdc0cb2a.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186189367 :tutorial/content "Let's consider the curve $r = 1-\\sin\\theta$ for $0\\leq \\theta < 2\\pi,$ shown below.\n\n![](images/09/09b25bca42f62b6567cecf4b14987113003ccea6dd869a569be75af4fa1781c9.png)\n\nUsing previously discussed techniques, it's straightforward to show that at point $C$ where $\\theta = \\dfrac\\pi 2,$ we have\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = \\dfrac{y'(\\theta)}{x'(\\theta)} = \\dfrac00.\n$$\n\nTo see what's happening, let's zoom in and observe the behavior of the curve at this point. \n\n![](images/00/001914b359c9c95f6a8fceb655a5233242065eb4231765bcfc0d652ebbf4eed8.png)\n\nIf we look carefully, we notice that the tangent lines become steeper and steeper as we approach the point $C$ from either direction.\n\n![](images/40/40de3bbd7f8422ff4ab4af6091497579f8031b8a43296e466f8c23ed4a121097.png)\n\nTherefore, as we take the *limit* as we approach $C,$ it would appear that these tangent lines become vertical. \n\n![](images/ca/caf6255e2ae97865da52dec64413e2e61a9a807f50b54ae4eae2f2b96f030c30.png)\n\nWhen the limit of the tangent lines becomes vertical like this, we say that the curve has a vertical tangent at $C.$" :db/ensure [:tutorial/validate]} {:db/id 17592186189374 :tutorial/content "So, it seems that the curve $r = 1-\\sin\\theta$ has a vertical tangent at $\\theta = \\dfrac\\pi 2.$ However, to be sure of this, we need to check that the tangent lines' slopes grow to infinity as we approach $\\theta = \\dfrac \\pi 2.$ In other words, we need to check that\n\n$$\n\\lim\\limits_{\\theta \\to (\\pi/2)^{-}} \\dfrac{\\textrm d y}{\\textrm d x} = \\pm\\infty \\qquad\\textrm{and}\\qquad \\lim\\limits_{\\theta \\to (\\pi/2)^{+}} \\dfrac{\\textrm d y}{\\textrm d x} = \\pm\\infty.\n$$\n\nLet's now verify that this is true:\n\nUsing techniques discussed in previous lessons, it's straightforward to show that\n\n$$\nx'(\\theta)=-\\sin\\theta-\\cos(2\\theta), \\qquad \ny'(\\theta)=\\cos\\theta - \\sin2\\theta.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡2\\theta }{-\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡(2\\theta )}) \\\\  & =-{lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )}{\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡(2\\theta )}).\\end{aligned}\n$$\n\nWe already know that substituting $\\theta = \\dfrac\\pi 2$ gives the indeterminate form $\\dfrac00,$ so evaluating this limit by direct substitution won't work. However, we can evaluate this limit using L'Hopital's rule.\n\n- Applying L'Hopital's rule to evaluate the left-sided limit, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & =-{lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta ))}{\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡(2\\theta )}) \\\\  & =-{lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta ))^{′}}{(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡(2\\theta ))^{′}}) \\\\  & =-{lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{-\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}(\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡(2\\theta )) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(\\pi ) \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nFor the limit in the denominator, it can be shown that\n\n$$\n\\lim\\limits_{\\theta \\to (\\pi/2)^-} \\left(\\cos\\theta - 2\\sin(2\\theta)\\right) = 0^-,\n$$\n\nwhere the notation $0^-$ means that the denominator approaches zero from the negative numbers.  \n\nTherefore, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}) \\\\  & =\\frac{-1}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\n- Using similar methods, it can be shown that the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡(2\\theta )}{\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}) \\\\  & =\\frac{-1}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, we conclude that there is a vertical tangent to the curve at $\\theta=\\dfrac{\\pi}{2}.$ \n\n![](images/ea/ea0a03e575d962bd8d69505e20166dcc60c77cfe933f30762bb81296ccf7a797.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186188485 :activity/expected-seconds 900.0 :db/ensure [:activity/validate]} [:db/retract 17592186164433 :answer-field/choices 17592186164434] [:db/retract 17592186164433 :answer-field/choices 17592186164435] [:db/retract 17592186164433 :answer-field/choices 17592186164436] {:db/id 17592186167229 :question/problem "![](images/9a/9aa8e2fec9812145eba6ef3add63dfcf16c9ddeb5557c3d37ef511947ace2e52.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two complex eigenvalues $\\lambda =a\\pm b\\text{i},$ where $a,b\\in R,$ is shown above. Select the correct options in the reasoning below.\n\nThe given curve is \n{{field-1}},\nrepresenting\n{{field-2}}\nthat is traversed \n{{field-3}}.\nThus, we must have \n{{field-4}}." :question/worked-solution "Let $v=p+q\\text{i},$ where $p,q\\in {R}^{2},$ be an eigenvector corresponding to the eigenvalue $\\lambda =a+b\\text{i}.$\n\nThen, a complex solution of the system is given by\n\n$$\n{x}_{\\text{complex}}(t)=v{e}^{\\lambda t}.\n$$\n\nUsing Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{\\text{complex}}(t) & =v{e}^{(a+b\\text{i})t} \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)+\\text{i}\\operatorname{sin}⁡(bt))(p+q\\text{i}) \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+\\text{i}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q).\\end{aligned}\n$$\n\nTherefore, the general solution of the system is\n\n$$\n\\text{x}(t)={c}_{1}{e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+{c}_{2}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q),\n$$\n\nwhere the parts $(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)$ and $(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q)$ are bounded.\n\nNow, notice that the given curve is $\\text{bounded}$ (and closed), representing $\\text{an ellipse}$ (circle) that is traversed $\\text{clockwise}.$\n\nBut we have that:\n\n- ${e}^{at}\\to \\infty $ as $t\\to \\infty $ when $a>0,$ and\n\n- ${e}^{at}\\to 0$ as $t\\to \\infty $ when $a<0.$\n\nThus, we must have $a=0.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164443 :answer-field/correct 17592186164445 :db/ensure [:answer-field/validate]} {:db/id 17592186164440 :answer-field/correct 17592186164441 :db/ensure [:answer-field/validate]} {:db/id 17592186164437 :answer-field/correct 17592186164439 :db/ensure [:answer-field/validate]} {:db/id 17592186164433 :answer-field/correct "answer-5bd46fd9-4ec6-5d4d-b935-c34269ce5266" :answer-field/choices ["answer-5bd46fd9-4ec6-5d4d-b935-c34269ce5266" "answer-e0d1f152-2d71-5a47-a7da-fd041217b7f8" "answer-d93ff637-1a41-5c2a-a409-3b1e7bff5ef7"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bd46fd9-4ec6-5d4d-b935-c34269ce5266" :answer/id #uuid "5bd46fd9-4ec6-5d4d-b935-c34269ce5266" :answer/type :answer.type/math :answer/value "a=0" :db/ensure [:answer/validate]} {:db/id "answer-e0d1f152-2d71-5a47-a7da-fd041217b7f8" :answer/id #uuid "e0d1f152-2d71-5a47-a7da-fd041217b7f8" :answer/type :answer.type/math :answer/value "a\\ne 0" :db/ensure [:answer/validate]} {:db/id "answer-d93ff637-1a41-5c2a-a409-3b1e7bff5ef7" :answer/id #uuid "d93ff637-1a41-5c2a-a409-3b1e7bff5ef7" :answer/type :answer.type/math :answer/value "b=0" :db/ensure [:answer/validate]} {:db/id 17592186385185 :question/problem "![](images/95/95ad67abf7291e83476f26216aac2b48a91adf3da102ca73ffab2a29c9716514.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two complex eigenvalues $\\lambda =a\\pm b\\text{i}$ is shown above. Select the correct options in the reasoning below.\n\nThe given curve is \n{{field-1}},\nrepresenting\n{{field-2}}\nthat is traversed \n{{field-3}}.\nThus, we must have \n{{field-4}}.\n\nThe spiral is traversed toward \n{{field-5}}\nas $t\\to \\infty .$\nHence, \n{{field-6}}." :db/ensure [:question/validate]} {:db/id "activity-d990f3a7-db2b-51f0-8db9-f30c83207610" :activity/id #uuid "d990f3a7-db2b-51f0-8db9-f30c83207610" :activity/title "Phase Portraits for Linear Systems With Complex Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186049209 :activity/course 17592186046660 :activity/steps ["step-42f0ca7b-cd86-541c-96a8-c8c341a14559" "step-ad94239e-f4c8-525d-8841-959377d0f69a" "step-17236c24-ba39-5f16-a290-16a88cca22fb"] :activity/first-step "step-42f0ca7b-cd86-541c-96a8-c8c341a14559" :db/ensure [:activity/validate]} {:db/id "step-42f0ca7b-cd86-541c-96a8-c8c341a14559" :step/id #uuid "42f0ca7b-cd86-541c-96a8-c8c341a14559" :step/content 17592186167229 :step/next "step-ad94239e-f4c8-525d-8841-959377d0f69a" :db/ensure [:step/validate]} {:db/id "step-ad94239e-f4c8-525d-8841-959377d0f69a" :step/id #uuid "ad94239e-f4c8-525d-8841-959377d0f69a" :step/content 17592186167242 :step/next "step-17236c24-ba39-5f16-a290-16a88cca22fb" :db/ensure [:step/validate]} {:db/id "step-17236c24-ba39-5f16-a290-16a88cca22fb" :step/id #uuid "17236c24-ba39-5f16-a290-16a88cca22fb" :step/content 17592186385185 :db/ensure [:step/validate]} {:db/id 17592186119950 :knowledge-point/questions ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" "question-95752b1d-23a5-5822-b360-684f0368d8b3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119951 :knowledge-point/questions ["question-418f1354-66b6-535c-975e-7236a5d63898" "question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" "question-03727fdc-9b2a-53db-b355-f55f8718eb73"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119952 :knowledge-point/questions ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" "question-e60274a9-ad7a-5782-a789-be03c76f6f3c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119953 :knowledge-point/questions ["question-1faddb6e-7103-543e-9a46-6187e7487263" "question-baaafa36-2999-5769-af9b-da0e59cba7b8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/id #uuid "31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/math-academy-id "q-101258" :question/problem "What is the recursive formula for the following geometric sequence?\n\n$$\n20,\\,15,\\,\\frac{45}{4},\\,…\n$$" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=20,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15}{20}=\\frac{3}{4}.\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8095106a-9247-5646-9b1f-f9986551763f"] :db/ensure [:question/validate]} {:db/id "answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/id #uuid "8095106a-9247-5646-9b1f-f9986551763f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer-field/choices ["answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" "answer-009c5090-9761-5896-a02c-03e25cbe6026" "answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" "answer-ac81aff5-4139-5c1a-bd69-74881d053800"] :db/ensure [:answer-field/validate]} {:db/id "answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/id #uuid "d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{20}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/id #uuid "ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-009c5090-9761-5896-a02c-03e25cbe6026" :answer/id #uuid "009c5090-9761-5896-a02c-03e25cbe6026" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{8}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/id #uuid "72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{45}{4}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-ac81aff5-4139-5c1a-bd69-74881d053800" :answer/id #uuid "ac81aff5-4139-5c1a-bd69-74881d053800" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{4}{3}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/id #uuid "95752b1d-23a5-5822-b360-684f0368d8b3" :question/math-academy-id "q-249790" :question/problem "Consider the following geometric sequence:\n\n$$\n30,\\,50,\\,\\frac{250}{3},\\,…\n$$\n\nThe recursive formula for this geometric sequence is\n\n${a}_{n+1}=${{field-1}}$,\\,{a}_{1}=$\n{{field-2}}$,\\,n\\ge 1.$" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=30,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{50}{30}=\\frac{5}{3}.\n$$\n\nTherefore, the recursive formula is\n\n$$\n{a}_{n+1}=\\frac{5}{3}{a}_{n},\\,{a}_{1}=30,\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" "answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75"] :db/ensure [:question/validate]} {:db/id "answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/id #uuid "5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9007d100-56e2-5122-835f-80d3456291ac" :answer-field/choices ["answer-9007d100-56e2-5122-835f-80d3456291ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-9007d100-56e2-5122-835f-80d3456291ac" :answer/id #uuid "9007d100-56e2-5122-835f-80d3456291ac" :answer/type :answer.type/math :answer/value "\\frac{5}{3}a_n" :db/ensure [:answer/validate]} {:db/id "answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/id #uuid "5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer-field/choices ["answer-224edbc2-fbee-5d40-bf96-326d59bc470b"] :db/ensure [:answer-field/validate]} {:db/id "answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/id #uuid "224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "question-418f1354-66b6-535c-975e-7236a5d63898" :question/id #uuid "418f1354-66b6-535c-975e-7236a5d63898" :question/math-academy-id "q-79510" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-\\frac{1}{2}{a}_{n},\\,{a}_{1}=128,\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =128 \\\\ {a}_{2} & =-\\frac{1}{2}{a}_{1}=-\\frac{1}{2}(128)=-64 \\\\ {a}_{3} & =-\\frac{1}{2}{a}_{2}=-\\frac{1}{2}(-64)=32 \\\\ {a}_{4} & =-\\frac{1}{2}{a}_{3}=-\\frac{1}{2}(32)=-16\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-16.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41177c22-4ae0-5230-bc33-006cf9fb29c1"] :db/ensure [:question/validate]} {:db/id "answer-field-41177c22-4ae0-5230-bc33-006cf9fb29c1" :answer-field/id #uuid "41177c22-4ae0-5230-bc33-006cf9fb29c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer-field/choices ["answer-9bdf55a5-f673-5863-95de-682e4913eded" "answer-ec359335-db2b-5362-8e72-c6378e62b45f" "answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" "answer-25d55b98-960e-591e-bf2d-4f4a15f0caea" "answer-a82bbcfe-69b8-5590-98b0-bca18d5ecc85"] :db/ensure [:answer-field/validate]} {:db/id "answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer/id #uuid "9bdf55a5-f673-5863-95de-682e4913eded" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-ec359335-db2b-5362-8e72-c6378e62b45f" :answer/id #uuid "ec359335-db2b-5362-8e72-c6378e62b45f" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/id #uuid "7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-25d55b98-960e-591e-bf2d-4f4a15f0caea" :answer/id #uuid "25d55b98-960e-591e-bf2d-4f4a15f0caea" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-a82bbcfe-69b8-5590-98b0-bca18d5ecc85" :answer/id #uuid "a82bbcfe-69b8-5590-98b0-bca18d5ecc85" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186120171 :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=\\frac{1}{4}{a}_{n},\\,{a}_{1}=256,\\,n\\ge 1\n$$\n\nThe $4$th term of this geometric sequence is ${a}_{4}=$\n{{field-1}}." :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =256 \\\\ {a}_{2} & =\\frac{1}{4}{a}_{1}=\\frac{1}{4}(256)=64 \\\\ {a}_{3} & =\\frac{1}{4}{a}_{2}=\\frac{1}{4}(64)=16 \\\\ {a}_{4} & =\\frac{1}{4}{a}_{3}=\\frac{1}{4}(16)=4\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=4.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186117192 :answer-field/correct "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer-field/choices ["answer-027fccaa-c5ae-5f11-8896-43a5a65af33e"] :db/ensure [:answer-field/validate]} {:db/id "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/id #uuid "027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/id #uuid "aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/math-academy-id "q-44911" :question/problem "What is the $3$rd term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-5{a}_{n},\\,{a}_{1}=\\frac{1}{75},\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $3$rd term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{75} \\\\ {a}_{2} & =-5{a}_{1}=-5(\\frac{1}{75})=-\\frac{1}{15} \\\\ {a}_{3} & =-5{a}_{2}=-5(-\\frac{1}{15})=\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, ${a}_{3}=\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4"] :db/ensure [:question/validate]} {:db/id "answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/id #uuid "176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer-field/choices ["answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" "answer-b229ccac-19bf-5635-b760-624ad2c11e2c" "answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" "answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/id #uuid "e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/type :answer.type/math :answer/value "-\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-b229ccac-19bf-5635-b76