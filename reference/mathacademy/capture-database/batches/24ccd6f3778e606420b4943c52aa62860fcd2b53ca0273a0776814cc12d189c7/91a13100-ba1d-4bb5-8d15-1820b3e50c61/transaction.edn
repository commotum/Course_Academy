/correct "answer-5ae65b8c-35be-548c-a00d-0cc258220579" :answer-field/choices ["answer-5ae65b8c-35be-548c-a00d-0cc258220579" "answer-cb99c864-e94b-5f43-b916-b054dd2ef046" "answer-05bb9e95-1d10-5069-a452-c7b0b169db9b" "answer-fa49a3a2-0170-50ed-940e-118d1bf5b6a5" "answer-a6e3c89e-98d3-5561-a67a-a1b501b72224"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ae65b8c-35be-548c-a00d-0cc258220579" :answer/id #uuid "5ae65b8c-35be-548c-a00d-0cc258220579" :answer/type :answer.type/math :answer/value "20-4a" :db/ensure [:answer/validate]} {:db/id "answer-cb99c864-e94b-5f43-b916-b054dd2ef046" :answer/id #uuid "cb99c864-e94b-5f43-b916-b054dd2ef046" :answer/type :answer.type/math :answer/value "20-a" :db/ensure [:answer/validate]} {:db/id "answer-05bb9e95-1d10-5069-a452-c7b0b169db9b" :answer/id #uuid "05bb9e95-1d10-5069-a452-c7b0b169db9b" :answer/type :answer.type/math :answer/value "4-4a" :db/ensure [:answer/validate]} {:db/id "answer-fa49a3a2-0170-50ed-940e-118d1bf5b6a5" :answer/id #uuid "fa49a3a2-0170-50ed-940e-118d1bf5b6a5" :answer/type :answer.type/math :answer/value "8-4a" :db/ensure [:answer/validate]} {:db/id "answer-a6e3c89e-98d3-5561-a67a-a1b501b72224" :answer/id #uuid "a6e3c89e-98d3-5561-a67a-a1b501b72224" :answer/type :answer.type/math :answer/value "8-a" :db/ensure [:answer/validate]} {:db/id "question-fadc73be-dedf-5384-82b7-e3c8b9123466" :question/id #uuid "fadc73be-dedf-5384-82b7-e3c8b9123466" :question/math-academy-id "q-173697" :question/problem "$12-3x+(4x-5)\\cdot 2=$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}12-3x+(4x-5)\\cdot 2 & = \\\\ 12-3x+4x\\cdot 2+(-5)\\cdot 2 & = \\\\ 12-3x+(8x)+(-10) & = \\\\ 12-3x+8x-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}12-3x+8x-10 & = \\\\ (12-10)+(-3x+8x) & = \\\\ (2)+(5x) & = \\\\ 2+5x\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-56cc9ec7-a78c-54b1-a9