q & = \\\\ (-9p)+(-15q)+9q & = \\\\ -9p-15q+9q\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}-9p-15q+9q & = \\\\ -9p+(-15q+9q) & = \\\\ -9\\,p-6\\,q & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-36634756-bd5b-5b68-9066-c998674fe2a6" "answer-field-fb10cdd1-554d-5648-b07a-f7242920d579"] :db/ensure [:question/validate]} {:db/id "answer-field-36634756-bd5b-5b68-9066-c998674fe2a6" :answer-field/id #uuid "36634756-bd5b-5b68-9066-c998674fe2a6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer-field/choices ["answer-5ac84694-db3c-508f-ab4f-56602c4d7c88"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer/id #uuid "5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-field-fb10cdd1-554d-5648-b07a-f7242920d579" :answer-field/id #uuid "fb10cdd1-554d-5648-b07a-f7242920d579" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer-field/choices ["answer-d00aea71-15dd-50d3-9494-51ab03f8e7b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer/id #uuid "d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-a3308d93-fc2c-5afd-b2a2-d10eabcc55b8" :activity/id #uuid "a3308d93-fc2c-5afd-b2a2-d10eabcc55b8" :activity/title "Simplifying Linear Expressions Using the Distributive Law" :activity/type :activity.type/review :activity/scope 17592186050575 :activity/course 17592186046648 :activity/steps ["step-f47ccfb1-eb71-5fb2-bcfe-bd3c04a130c5" "step-f954900d-db8e-5669-983f-61ddeb5299ad" "step-d6103e78-f799-5832-96a9-e9962966f7a1" "step-4145c55f-d17c-5a31-bd5a-fdc2bf4c0fc5" "step-da58662e-c1cd-5da2-878b-9e28abdccc9d"] :activity/first-step "step-f47ccfb1-eb71-5fb2-bcfe-bd3c04a130c5" :db/ensure [:activity/validate]} {:db/id "step-f47ccfb1-eb71-5fb2-bcfe-bd3c04a130c5" :step/id #uuid "f47ccfb1-eb71-5fb2-bcfe-bd3c04a130c5" :step/content 17592186055007 :step/next "step-f954900d-db8e-5669-983f-61ddeb5299ad" :db/ensure [:step/validate]} {:db/id "step-f954900d-db8e-5669-983f-61ddeb5299ad" :step/id #uuid "f954900d-db8e-5669-983f-61ddeb5299ad" :step/content "question-56c7326b-73aa-516e-8094-38a5a4c858fb" :step/next "step-d6103e78-f799-5832-96a9-e9962966f7a1" :db/ensure [:step/validate]} {:db/id "step-d6103e78-f799-5832-96a9-e9962966f7a1" :step/id #uuid "d6103e78-f799-5832-96a9-e9962966f7a1" :step/content "question-5d0b6029-5d16-5038-805d-6574595234a2" :step/next "step-4145c55f-d17c-5a31-bd5a-fdc2bf4c0fc5" :db/ensure [:step/validate]} {:db/id "step-4145c55f-d17c-5a31-bd5a-fdc2bf4c0fc5" :step/id #uuid "4145c55f-d17c-5a31-bd5a-fdc2bf4c0fc5" :step/content "question-fadc73be-dedf-5384-82b7-e3c8b9123466" :step/next "step-da58662e-c1cd-5da2-878b-9e28abdccc9d" :db/ensure [:step/validate]} {:db/id "step-da58662e-c1cd-5da2-878b-9e28abdccc9d" :step/id #uuid "da58662e-c1cd-5da2-878b-9e28abdccc9d" :step/content "question-cd9687a1-fd95-59a6-b621-1301fd1f4974" :db/ensure [:step/validate]} {:db/id 17592186119927 :knowledge-point/questions ["question-a5bfe454-c84f-5da8-9381-6959e5f62f7a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a5bfe454-c84f-5da8-9381-6959e5f62f7a" :question/id #uuid "a5bfe454-c84f-5da8-9381-6959e5f62f7a" :question/math-academy-id "q-156680" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(1,-1,2)$ and $(-1,1,1).$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The direction vector of the line $L$ is \n\n$$\nd=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]-[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}].\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n\\frac{x-1}{-2}=\\frac{y+1}{2}=\\frac{z-2}{-1}.\n$$\n\nBut this line does not pass through the origin since \n\n$$\n\\frac{(0)-1}{-2}=\\frac{(0)+1}{2}\\ne \\frac{(0)-2}{-1}\\,\\times \n$$\n\n- Statement II is false. Let's consider the vectors $[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]$ from $L$ (the position vectors of the given points). Then,\n\n$$\n[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 3\\end{aligned}].\n$$\n\nHowever, the point $(0,0,3)$ does not belong to $L$ since\n\n$$\n\\frac{(0)-1}{-2}=\\frac{(0)+1}{2}\\ne -(3)+2.\\,\\times \n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-af22d48e-5724-584d-b3a5-2b9d70fcf5d0"] :db/ensure [:question/validate]} {:db/id "answer-field-af22d48e-5724-584d-b3a5-2b9d70fcf5d0" :answer-field/id #uuid "af22d48e-5724-584d-b3a5-2b9d70fcf5d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b00e08ba-08b5-5691-9161-9a7d57702f37" :answer-field/choices ["answer-5f19d8a6-dfab-5436-b75e-578f5c45a2f9" "answer-5630f304-d35f-5326-b26c-3feb0d15ab6f" "answer-8963240b-c71f-5fe4-9d91-80374eefb00a" "answer-d0dc412d-2d7f-5a7d-9147-f6af3bd08779" "answer-b00e08ba-08b5-5691-9161-9a7d57702f37"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f19d8a6-dfab-5436-b75e-578f5c45a2f9" :answer/id #uuid "5f19d8a6-dfab-5436-b75e-578f5c45a2f9" :answer/type :answer.type/text :answer/value "All the statements are true" :db/ensure [:answer/validate]} {:db/id "answer-5630f304-d35f-5326-b26c-3feb0d15ab6f" :answer/id #uuid "5630f304-d35f-5326-b26c-3feb0d15ab6f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-8963240b-c71f-5fe4-9d91-80374eefb00a" :answer/id #uuid "8963240b-c71f-5fe4-9d91-80374eefb00a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-d0dc412d-2d7f-5a7d-9147-f6af3bd08779" :answer/id #uuid "d0dc412d-2d7f-5a7d-9147-f6af3bd08779" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-b00e08ba-08b5-5691-9161-9a7d57702f37" :answer/id #uuid "b00e08ba-08b5-5691-9161-9a7d57702f37" :answer/type :answer.type/text :answer/value "IV only" :db/ensure [:answer/validate]} {:db/id 17592186119928 :knowledge-point/questions ["question-00c50921-42ae-53d0-a1bc-1a992257ffe3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-00c50921-42ae-53d0-a1bc-1a992257ffe3" :question/id #uuid "00c50921-42ae-53d0-a1bc-1a992257ffe3" :question/math-academy-id "q-157467" :question/problem "Let $Π$ be the plane with equation $z=3x+2y$ in ${R}^{3}.$ Which of the following statements are true? \n\nI. $Π$ contains the zero-vector\n\nII. $Π$ is closed under vector addition\n\nIII. $Π$ is closed under scalar multiplication\n\nIV. $Π$ is a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ y \\\\ 3x+2y\\end{aligned}],\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $z=3x+2y:$\n\n$$\n\\begin{aligned}z & =3x+2y \\\\ (0) & =3(0)+2(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 3{a}_{1}+2{a}_{2}\\end{aligned}]\\in Π$ and $b=[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ 3{b}_{1}+2{b}_{2}\\end{aligned}]\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 3{a}_{1}+2{a}_{2}\\end{aligned}]+[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ 3{b}_{1}+2{b}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ (3{a}_{1}+2{a}_{2})+(3{b}_{1}+2{b}_{2})\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ 3({a}_{1}+{b}_{1})+2({a}_{2}+{b}_{2})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=3x+2y.$ Therefore, $a+b\\in Π.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 3{a}_{1}+2{a}_{2}\\end{aligned}]\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 3{a}_{1}+2{a}_{2}\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ k(3{a}_{1}+2{a}_{2})\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ 3k{a}_{1}+2k{a}_{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=3x+2y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement IV is true. Since statements II and III are true, the plane $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ecd11032-a320-56b0-8408-67c72e266d26"] :db/ensure [:question/validate]} {:db/id "answer-field-ecd11032-a320-56b0-8408-67c72e266d26" :answer-field/id #uuid "ecd11032-a320-56b0-8408-67c72e266d26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d4caa60-0479-5815-b2a0-47647bc7550b" :answer-field/choices ["answer-8d4caa60-0479-5815-b2a0-47647bc7550b" "answer-1d6e4eb6-6d41-5ba5-b742-40b17f8d54e2" "answer-3c3fab0d-b7ef-53be-8720-40063138c092" "answer-759d092c-bea5-5b3e-a194-100cae11ae72" "answer-d7a005c0-68dc-5657-b99c-da3dd9395ea0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d4caa60-0479-5815-b2a0-47647bc7550b" :answer/id #uuid "8d4caa60-0479-5815-b2a0-47647bc7550b" :answer/type :answer.type/text :answer/value "All the statements are true" :db/ensure [:answer/validate]} {:db/id "answer-1d6e4eb6-6d41-5ba5-b742-40b17f8d54e2" :answer/id #uuid "1d6e4eb6-6d41-5ba5-b742-40b17f8d54e2" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3c3fab0d-b7ef-53be-8720-40063138c092" :answer/id #uuid "3c3fab0d-b7ef-53be-8720-40063138c092" :answer/type :answer.type/text :answer/value "I, II, and III only" :db/ensure [:answer/validate]} {:db/id "answer-759d092c-bea5-5b3e-a194-100cae11ae72" :answer/id #uuid "759d092c-bea5-5b3e-a194-100cae11ae72" :answer/type :answer.type/text :