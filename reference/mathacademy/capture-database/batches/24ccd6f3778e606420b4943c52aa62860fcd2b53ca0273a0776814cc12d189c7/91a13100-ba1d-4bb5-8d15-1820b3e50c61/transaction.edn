ledge-point/questions ["question-4d4bee9d-ce76-579e-9d30-cf5f9cf2d405" "question-955d0666-e318-54f6-bac2-1bee61b1768a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4d4bee9d-ce76-579e-9d30-cf5f9cf2d405" :question/id #uuid "4d4bee9d-ce76-579e-9d30-cf5f9cf2d405" :question/math-academy-id "q-6190" :question/problem "Express $\\frac{1}{81}$ as a base raised to a negative exponent." :question/worked-solution "First, we write $\\frac{1}{81}$ as a base raised to a power:\n\n$$\n\\begin{aligned}\\frac{1}{81} & =\\frac{1\\times 1}{9\\times 9} \\\\  & =\\frac{1}{9}\\times \\frac{1}{9} \\\\  & ={(\\frac{1}{9})}^{2}\\end{aligned}\n$$\n\nNow, we find the reciprocal of the base $(\\frac{1}{9}),$ and then raise that reciprocal to the same power but with the *opposite* sign $(-2),$ as follows:\n\n$$\n{(\\frac{1}{9})}^{2}={9}^{-2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ef6f073-8e74-5ee7-b25d-e99ceba5ec74"] :db/ensure [:question/validate]} {:db/id "answer-field-1ef6f073-8e74-5ee7-b25d-e99ceba5ec74" :answer-field/id #uuid "1ef6f073-8e74-5ee7-b25d-e99ceba5ec74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-516b5642-52ca-558f-b89f-3669698c909c" :answer-field/choices ["answer-10739a17-0249-5a0e-8b76-5d07b2aa0ed1" "answer-452d066e-6309-536b-a676-51ef94af1656" "answer-aab053b1-122b-5e8c-a002-523e16312d4e" "answer-698410dd-928f-564c-97a4-4166984a33ec" "answer-516b5642-52ca-558f-b89f-3669698c909c"] :db/ensure [:answer-field/validate]} {:db/id "answer-10739a17-0249-5a0e-8b76-5d07b2aa0ed1" :answer/id #uuid "10739a17-0249-5a0e-8b76-5d07b2aa0ed1" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-452d066e-6309-536b-a676-51ef94af1656" :answer/id #uuid "452d066e-6309-536b-a676-51ef94af1656" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-aab053b1-122b-5e8c-a002-523e16312