\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-$</td><td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,⋮$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nWe could continue the division, but the same digit keeps repeating. Thus, the decimal continues with repeating $3$'s:\n\n$$\n7.833…\n$$\n\nTherefore,\n\n$$\n\\frac{47}{6}=7.833…=7.8\\overset{―}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c34344b6-121d-5f88-899d-4ce1d5cefac3"] :db/ensure [:question/validate]} {:db/id "answer-field-c34344b6-121d-5f88-899d-4ce1d5cefac3" :answer-field/id #uuid "c34344b6-121d-5f88-899d-4ce1d5cefac3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f532a7e-3620-5134-85fe-ae40335b09f7" :answer-field/choices ["answer-6908f16b-4349-563f-bb19-9fe78d0d54fe" "answer-56554f30-f82c-5f75-a679-cb1717a64fd8" "answer-40403468-c5ae-5c11-ad26-3fd2ab25ca8d" "answer-48865973-f52d-562d-91ed-55a47d41d406" "answer-9f532a7e-3620-5134-85fe-ae40335b09f7"] :db/ensure [:answer-field/validate]} {:db/id "answer-6908f16b-4349-563f-bb19-9fe78d0d54fe" :answer/id #uuid "6908f16b-4349-563f-bb19-9fe78d0d54fe" :answer/type :answer.type/math :answer/value "7.3\\overset{―}{8}" :db/ensure [:answer/validate]} {:db/id "answer-56554f30-f82c-5f75-a679-cb1717a64fd8" :answer/id #uuid "56554f30-f82c-5f75-a679-cb1717a64fd8" :answer/type :answer.type/math :answer/value "7.6\\overset{―}{3}" :db/ensure [:answer/validate]} {:db/id "answer-40403468-c5ae-5c11-ad26-3fd2ab25ca8d" :answer/id #uuid "40403468-c5ae-5c11-ad26-3fd2ab25ca8d" :answer/type :answer.type/math :answer/value "7.6\\overset{―}{6}" :db/ensure [:answer/validate]} {:db/id "answer-48865973-f52d-562d-91ed-55a47d41d406" :answer/id #uuid "48865973-f52d-562d-91ed-55a47d41d406" :answer/type :answer.type/math :answer/value "7.7\\overset{―}{6}" :db/ensure [:answer/validate]} {:db/id "answer-9f532a7e-3620-5134-85fe-ae40335b09f7" :answer/id #uuid "9f532a7e-3620-5134-85fe-ae40335b09f7" :answer/type :answer.type/math :answer/value "7.8\\overset{―}{3}" :db/ensure [:answer/validate]} {:db/id "question-5f502aa5-65d4-518a-a479-69aa4507aee1" :question/id #uuid "5f502aa5-65d4-518a-a479-69aa4507aee1" :question/math-academy-id "q-223772" :question/problem "Which of the following numbers are rational?\n\nI. $1.353124…$\n\nII. $1.5\\overset{―}{21}$\n\nIII. $4.055$" :question/worked-solution "Let's examine each of our numbers in turn.\n\n- $1.353124…$ is not a rational number. The notation \"$…$\" tells us that digits after the decimal point extend forever. However, there are no repeating digits.\n\n- $1.5\\overset{―}{21}$ is a rational number. The notation $\\overset{―}{21}$ tells us that the digits $2$ and $1$ after the decimal point repeat indefinitely.\n\n$$\n1.5\\overset{―}{21}=1.52121212121…\n$$\n\nAny decimal with repeating digits can be represented as a ratio of two integers. In this case,\n\n$$\n1.5\\overset{―}{21}=\\frac{1\\,506}{990}.\n$$\n\n- $4.055$ is a rational number because it can be expressed as a ratio of two integers:\n\n$$\n4.055=\\frac{4\\,055}{1\\,000}\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1448713c-4d53-5407-b118-7d28dec94eda"] :db/ensure [:question/validate]} {:db/id "answer-field-1448713c-4d53-5407-b118-7d28dec94eda" :answer-field/id #uuid "1448713c-4d53-5407-b118-7d28dec94eda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21ed7e7e-47d0-51d4-9a00-b693a1f146e7" :answer-field/choices ["answer-08141af8-203c-560d-9d2f-d58a15e60119" "answer-9e870dfe-4629-58ec-b281-563663104cb8" "answer-f4732fd9-8b6b-5aea-b78d-38a224261978" "answer-21ed7e7e-47d0-51d4-9a00-b693a1f146e7" "answer-3076fbb6-d739-5e86-8919-58296cbe6704"] :db/ensure [:answer-field/validate]} {:db/id "answer-08141af8-203c-560d-9d2f-d58a15e60119" :answer/id #uuid "08141af8-203c-560d-9d2f-d58a15e60119" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9e870dfe-4629-58ec-b281-563663104cb8" :answer/id #uuid "9e870dfe-4629-58ec-b281-563663104cb8" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f4732fd9-8b6b-5aea-b78d-38a224261978" :answer/id #uuid "f4732fd9-8b6b-5aea-b78d-38a224261978" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-21ed7e7e-47d0-51d4-9a00-b693a1f146e7" :answer/id #uuid "21ed7e7e-47d0-51d4-9a00-b693a1f146e7" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-3076fbb6-d739-5e86-8919-58296cbe6704" :answer/id #uuid "3076fbb6-d739-5e86-8919-58296cbe6704" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186152676 :question/problem "Which of the following numbers are rational?\n\nI. $3.624$\n\nII. $0.\\overset{―}{25}$\n\nIII. $7.526380…$" :question/worked-solution "Let's examine each of our numbers in turn.\n\n- $3.624$ is a rational number because it can be expressed as a ratio of two integers:\n\n$$\n3.624=\\frac{3\\,624}{1\\,000}\n$$\n\n- $0.\\overset{―}{25}$ is a rational number. The notation $\\overset{―}{25}$ tells us that the digits $2$ and $5$ after the decimal point repeat indefinitely.\n\n$$\n0.\\overset{―}{25}=0.2525252525…\n$$\n\nAny decimal with repeating digits can be represented as a ratio of two integers. In this case,\n\n$$\n0.\\overset{―}{25}=\\frac{25}{99}.\n$$\n\n- $7.526380…$ is not a rational number. The notation \"$…$\" tells us that digits after the decimal point extend forever. However, there are no repeating digits.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186150563 :answer-field/correct 17592186150566 :db/ensure [:answer-field/validate]} {:db/id "tutorial-6c539020-aca7-5b8f-a2b0-b72c56336242" :tutorial/id #uuid "6c539020-aca7-5b8f-a2b0-b72c56336242" :tutorial/math-academy-id 15179 :tutorial/title "Introduction" :tutorial/content "A rational number can have a decimal representation that either *ends* or *repeats*.\n\nIn this lesson, we will see how to convert rational numbers written as fractions into decimals using *long division*. \nWe begin with examples where the decimal terminates. \n\nLet's convert $\\dfrac{7}{2}$ into a decimal using long division.\n\nTo write the fraction as a decimal, we divide the numerator by the denominator:\n\n$$\n7 \\div 2\n$$\n\nWe proceed using long division as usual, stopping once we obtain a remainder of $0\\mathbin{:}$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\,\\,3    {\\, . \\,} 5$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$2$</td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{7   {\\, . \\,} 0}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nTherefore,\n\n$$\n\\dfrac{7}{2} = 3.5.\n$$" :db/ensure [:tutorial/validate]} {:db/id "tutorial-b877953a-1821-5fae-aebf-3ff936971679" :tutorial/id #uuid "b877953a-1821-5fae-aebf-3ff936971679" :tutorial/math-academy-id 15177 :tutorial/title "Repeating Decimals" :tutorial/content "Let's consider the following rational number:\n\n$$\n\\dfrac13\n$$\n\nTo find its decimal representation, we divide $1$ by $3$ using long division, as follows:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\,\\,0 \\,. 3 {\\:\\phantom{|}} 3 {\\:\\phantom{|}} 3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\:\\ldots$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{1 {\\, . \\,} 0  {\\:\\phantom{|}} 0 {\\:\\phantom{|}} 0}$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,\\ldots$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nNotice that, in this case,\n\n- the long division process never ends, and\n\n- the digit $3$ after the decimal point repeats *forever*.\n\nTherefore,\n\n$$\n\\dfrac13 = 0.333\\,333\\ldots\n$$\n\nThis is an example of a **repeating decimal** - a decimal in which the digits after the decimal point continue forever in a *repeating pattern*." :db/ensure [:tutorial/validate]} {:db/id "tutorial-8545445f-23ee-5309-8571-5a1f6a4b253d" :tutorial/id #uuid "8545445f-23ee-5309-8571-5a1f6a4b253d" :tutorial/math-academy-id 15180 :tutorial/title "Notations for Repeating Decimals" :tutorial/content "It's convenient to use the following special **bar-notation** to indicate decimals that repeat indefinitely:\n\n$$\n0.\\overline{3} = 0.333\\,333\\ldots\n$$\n\nSome decimals have two or more digits that repeat indefinitely. For example:\n\n$$\n\\begin{aligned}0.\\overset{―}{78} & =0.78\\,78\\,78\\,78… \\\\ 0.\\overset{―}{675} & =0.675\\,675\\,675…\\end{aligned}\n$$\n\nSome repeating decimals have non-repeating digits before the repeating part. For example:\n\n$$\n0.45\\overline{67} = 0.45\\,67\\,67\\,67\\,67\\ldots\n$$" :db/ensure [:tutorial/validate]} {:db/id "tutorial-77b1162b-17a9-5251-8efe-31b7034274d5" :tutorial/id #uuid "77b1162b-17a9-5251-8efe-31b7034274d5" :tutorial/math-academy-id 15181 :tutorial/title "Any Repeating Decimal is a Rational" :tutorial/content "The key takeaway for this lesson is that every repeating decimal is rational! In other words, every repeating decimal can be expressed as a ratio of two integers.\n\nFor example:\n\n$$\n\\begin{aligned}0.\\overset{―}{3} & =\\frac{1}{3} \\\\ 0.\\overset{―}{78} & =\\frac{26}{33} \\\\ 0.333\\overset{―}{67} & =\\frac{16517}{49500}\\end{aligned}\n$$\n\nIn a future lesson, we'll learn how to express a repeating decimal as a fraction. For now, you can verify these results using a calculator." :db/ensure [:tutorial/validate]} {:db/id "activity-f5d315b3-1937-5219-9b02-93324c4b74bb" :activity/id #uuid "f5d315b3-1937-5219-9b02-93324c4b74bb" :activity/title "Rational Numbers as Finite or Repeating Decimals" :activity/type :activity.type/lesson :activity/scope 17592186408188 :activity/expected-seconds 480.0 :activity/steps ["step-9d911030-9a41-5eba-8339-d738949a2899" "step-dd795099-acd6-53fe-9be5-05e82111a5a2" "step-989620d9-34b2-5998-bf43-7b078a5551e7" "step-07766a04-75bc-582b-a3f7-a4d9e94b4bfa" "step-e016072c-e22d-536a-a6ed-5eef7793da16" "step-722917c0-0a2f-564d-92a1-3b8f90e0a367" "step-84e16e8f-676c-575f-83e7-d1a743860017"] :activity/first-step "step-9d911030-9a41-5eba-8339-d738949a2899" :db/ensure [:activity/validate]} {:db/id "step-9d911030-9a41-5eba-8339-d738949a2899" :step/id #uuid "9d911030-9a41-5eba-8339-d738949a2899" :step/content "tutorial-6c539020-aca7-5b8f-a2b0-b72c56336242" :step/math-academy-id 653251 :step/next "step-dd795099-acd6-53fe-9be5-05e82111a5a2" :db/ensure [:step/validate]} {:db/id "step-dd795099-acd6-53fe-9be5-05e82111a5a2" :step/id #uuid "dd795099-acd6-53fe-9be5-05e82111a5a2" :step/content "knowledge-point-9f161693-0317-5b9e-9156-c781f703a4c0" :step/math-academy-id 653252 :step/next "step-989620d9-34b2-5998-bf43-7b078a5551e7" :db/ensure [:step/validate]} {:db/id "step-989620d9-34b2-5998-bf43-7b078a5551e7" :step/id #uuid "989620d9-34b2-5998-bf43-7b078a5551e7" :step/content "tutorial-b877953a-1821-5fae-aebf-3ff936971679" :step/math-academy-id 653255 :step/next "step-07766a04-75bc-582b-a3f7-a4d9e94b4bfa" :db/ensure [:step/validate]} {:db/id "step-07766a04-75bc-582b-a3f7-a4d9e94b4bfa" :step/id #uuid "07766a04-75bc-582b-a3f7-a4d9e94b4bfa" :step/content "tutorial-8545445f-23ee-5309-8571-5a1f6a4b253d" :step/math-academy-id 653256 :step/next "step-e016072c-e22d-536a-a6ed-5eef7793da16" :db/ensure [:step/validate]} {:db/id "step-e016072c-e22d-536a-a6ed-5eef7793da16" :step/id #uuid "e016072c-e22d-536a-a6ed-5eef7793da16" :step/content "tutorial-77b1162b-17a9-5251-8efe-31b7034274d5" :step/math-academy-id 653257 :step/next "step-722917c0-0a2f-564d-92a1-3b8f90e0a367" :db/ensure [:step/validate]} {:db/id "step-722917c0-0a2f-564d-92a1-3b8f90e0a367" :step/id #uuid "722917c0-0a2f-564d-92a1-3b8f90e0a367" :step/content "knowledge-point-2ee93f86-38d1-591a-b694-a4f455240d75" :step/math-academy-id 653258 :step/next "step-84e16e8f-676c-575f-83e7-d1a743860017" :db/ensure [:step/validate]} {:db/id "step-84e16e8f-676c-575f-83e7-d1a743860017" :step/id #uuid "84e16e8f-676c-575f-83e7-d1a743860017" :step/content "knowledge-point-4c28dcab-dd12-58c2-88c6-0301dc0f9ce4" :step/math-academy-id 653261 :db/ensure [:step/validate]} {:db/id 17592186166825 :knowledge-point/questions ["question-cf9b9ee0-bd15-54c0-b3c4-9825b1263a05" "question-5f71a427-dbf6-5a8f-8911-889945fe6b51" "question-cfe7c3c3-ab90-5b66-a414-95dcb308c4a8" "question-2fbf9d75-3749-54f2-b9a0-4aefe7b4559b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166826 :knowledge-point/questions ["question-2325fcf7-3419-5c2a-84d5-5bfca9cad5a4" "question-d124118c-140f-52f2-b4ac-16dbd784c35b" "question-498c3c25-8224-532d-867c-1bb7c9c3d797" "question-d5e93823-c39c-538e-930e-c856e7a48401"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166831 :knowledge-point/questions ["question-4d1937b2-4611-58ce-a050-d85b88c9c4df" "question-222d3245-c08e-59e6-abe7-30dbec831345" "question-9ffb7646-1918-5230-b400-64576248fe40" "question-e2cf6287-aa23-5f4b-8eb1-c626aabdf157"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf9b9ee0-bd15-54c0-b3c4-9825b1263a05" :question/id #uuid "cf9b9ee0-bd15-54c0-b3c4-9825b1263a05" :question/math-academy-id "q-96864" :question/problem "Approximate the value of $z$ such that $P(Z\\le z)=0.2900$ using interval bisection.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.5\\,$ | $\\,0.2912\\,$ | $\\,0.2877\\,$ | $\\,0.2843\\,$ |\n| $\\,-0.4\\,$ | $\\,0.3264\\,$ | $\\,0.3228\\,$ | $\\,0.3192\\,$ |\n| $\\,-0.3\\,$ | $\\,0.3632\\,$ | $\\,0.3594\\,$ | $\\,0.3557\\,$ |" :question/worked-solution "First, we find the two numbers in the table that $0.2900$ lies between. These numbers are $0.2877$ and $0.2912.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.2877 & <0.2900<0.2912\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-0.56) & <Φ(z)<Φ(-0.55).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-0.56+(-0.55)}{2}=-0.555.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cb366ba9-396c-5a42-bdaf-db347d7da9e2"] :db/ensure [:question/validate]} {:db/id "answer-field-cb366ba9-396c-5a42-bdaf-db347d7da9e2" :answer-field/id #uuid "cb366ba9-396c-5a42-bdaf-db347d7da9e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ecbf931d-740e-5b29-8d5d-f8a78af98be9" :answer-field/choices ["answer-baa6de8f-284d-53b5-a4b5-5d8832406ae0" "answer-253fbccc-a2c8-55cb-9e16-0c7421cd1d12" "answer-e67b84dd-1d8d-5eb0-bda0-e01f8685277d" "answer-ecbf931d-740e-5b29-8d5d-f8a78af98be9" "answer-65666da5-14b2-5993-8bc2-0526aae204af"] :db/ensure [:answer-field/validate]} {:db/id "answer-baa6de8f-284d-53b5-a4b5-5d8832406ae0" :answer/id #uuid "baa6de8f-284d-53b5-a4b5-5d8832406ae0" :answer/type :answer.type/math :answer/value "-0.365" :db/ensure [:answer/validate]} {:db/id "answer-253fbccc-a2c8-55cb-9e16-0c7421cd1d12" :answer/id #uuid "253fbccc-a2c8-55cb-9e16-0c7421cd1d12" :answer/type :answer.type/math :answer/value "-0.455" :db/ensure [:answer/validate]} {:db/id "answer-e67b84dd-1d8d-5eb0-bda0-e01f8685277d" :answer/id #uuid "e67b84dd-1d8d-5eb0-bda0-e01f8685277d" :answer/type :answer.type/math :answer/value "-0.545" :db/ensure [:answer/validate]} {:db/id "answer-ecbf931d-740e-5b29-8d5d-f8a78af98be9" :answer/id #uuid "ecbf931d-740e-5b29-8d5d-f8a78af98be9" :answer/type :answer.type/math :answer/value "-0.555" :db/ensure [:answer/validate]} {:db/id "answer-65666da5-14b2-5993-8bc2-0526aae204af" :answer/id #uuid "65666da5-14b2-5993-8bc2-0526aae204af" :answer/type :answer.type/math :answer/value "-0.565" :db/ensure [:answer/validate]} {:db/id "question-5f71a427-dbf6-5a8f-8911-889945fe6b51" :question/id #uuid "5f71a427-dbf6-5a8f-8911-889945fe6b51" :question/math-academy-id "q-328307" :question/problem "| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.6\\,$ | $\\,0.0495\\,$ | $\\,0.0485\\,$ | $\\,0.0475\\,$ |\n| $\\,-1.5\\,$ | $\\,0.0606\\,$ | $\\,0.0594\\,$ | $\\,0.0582\\,$ |\n| $\\,-1.4\\,$ | $\\,0.0735\\,$ | $\\,0.0721\\,$ | $\\,0.0708\\,$ |\n\nApproximate the value of $z$ such that $P(Z\\le z)=0.0600$ using interval bisection and the above table\n\n$z≈$\n{{field-1}}" :question/worked-solution "First, we find the two numbers in the table that $0.0600$ lies between. These numbers are $0.0594$ and $0.0606.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.0594 & <0.0600<0.0606\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-1.56) & <Φ(z)<Φ(-1.55).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-1.56+(-1.55)}{2}=-1.555.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e3569f9-57c5-5dcb-ba38-28e922d55560"] :db/ensure [:question/validate]} {:db/id "answer-field-6e3569f9-57c5-5dcb-ba38-28e922d55560" :answer-field/id #uuid "6e3569f9-57c5-5dcb-ba38-28e922d55560" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-92d9b53a-882b-5842-85be-c8c6715c1bf0" :answer-field/choices ["answer-92d9b53a-882b-5842-85be-c8c6715c1bf0"] :db/ensure [:answer-field/validate]} {:db/id "answer-92d9b53a-882b-5842-85be-c8c6715c1bf0" :answer/id #uuid "92d9b53a-882b-5842-85be-c8c6715c1bf0" :answer/type :answer.type/math :answer/value "-1.555" :db/ensure [:answer/validate]} {:db/id "question-cfe7c3c3-ab90-5b66-a414-95dcb308c4a8" :question/id #uuid "cfe7c3c3-ab90-5b66-a414-95dcb308c4a8" :question/math-academy-id "q-328316" :question/problem "| $z$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- |\n| $\\,-2.6\\,$ | $\\,0.0045\\,$ | $\\,0.0044\\,$ | $\\,0.0043\\,$ |\n| $\\,-2.5\\,$ | $\\,0.0060\\,$ | $\\,0.0059\\,$ | $\\,0.0057\\,$ |\n| $\\,-2.4\\,$ | $\\,0.0080\\,$ | $\\,0.0078\\,$ | $\\,0.0075\\,$ |\n\nApproximate the value of $z$ such that $P(Z\\le z)=0.0058$ using interval bisection and the above table\n\n$z≈$\n{{field-1}}" :question/worked-solution "First, we find the two numbers in the table that $0.0058$ lies between. These numbers are $0.0057$ and $0.0059.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.0057 & <0.0058<0.0059\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-2.53) & <Φ(z)<Φ(-2.52).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-2.53+(-2.52)}{2}=-2.525.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8b471bf-ec68-521e-9a36-666090833190"] :db/ensure [:question/validate]} {:db