f-7168-5347-a8d3-f53e8a1874eb" :answer-field/id #uuid "e67fda2f-7168-5347-a8d3-f53e8a1874eb" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-6f2aab30-7cdd-5e6a-b89c-3a778d1501a6" :answer-field/choices ["answer-6f2aab30-7cdd-5e6a-b89c-3a778d1501a6" "answer-b0c9bf2b-ccef-54f9-8489-828f4a946872"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f2aab30-7cdd-5e6a-b89c-3a778d1501a6" :answer/id #uuid "6f2aab30-7cdd-5e6a-b89c-3a778d1501a6" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-b0c9bf2b-ccef-54f9-8489-828f4a946872" :answer/id #uuid "b0c9bf2b-ccef-54f9-8489-828f4a946872" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-1e6ccc5e-e2f1-5031-9908-8c3a1cc535d6" :answer-field/id #uuid "1e6ccc5e-e2f1-5031-9908-8c3a1cc535d6" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-72f49a2a-7e33-5dea-8248-8b07b4770499" :answer-field/choices ["answer-93a7b3b0-bb34-5a9f-a039-8842eb3f070b" "answer-72f49a2a-7e33-5dea-8248-8b07b4770499" "answer-02cd44fe-73ba-5cc5-888a-532c8eaa56c3" "answer-8695d407-b8e6-5951-8447-a9dc025727b8" "answer-ae14740c-0bec-5b4d-9e98-d2aa11f93eb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-93a7b3b0-bb34-5a9f-a039-8842eb3f070b" :answer/id #uuid "93a7b3b0-bb34-5a9f-a039-8842eb3f070b" :answer/type :answer.type/math :answer/value "inf(A)=-5\\in A" :db/ensure [:answer/validate]} {:db/id "answer-72f49a2a-7e33-5dea-8248-8b07b4770499" :answer/id #uuid "72f49a2a-7e33-5dea-8248-8b07b4770499" :answer/type :answer.type/math :answer/value "inf(A)=-5\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-02cd44fe-73ba-5cc5-888a-532c8eaa56c3" :answer/id #uuid "02cd44fe-73ba-5cc5-888a-532c8eaa56c3" :answer/type :answer.type/math :answer/value "inf(A)=5\\in A" :db/ensure [:answer/validate]} {:db/id "answer-8695d407-b8e6-5951-8447-a9dc025727b8" :answer/id #uuid "8695d407-b8e6-5951-8447-a9dc025727b8" :answer/type :answer.type/math :answer/value "inf(A)=5\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-ae14740c-0bec-5b4d-9e98-d2aa11f93eb7" :answer/id #uuid "ae14740c-0bec-5b4d-9e98-d2aa11f93eb7" :answer/type :answer.type/text :answer/value "$inf(A)$ does not exist" :db/ensure [:answer/validate]} {:db/id "question-03070e45-f0e3-5991-b98c-709745709961" :question/id #uuid "03070e45-f0e3-5991-b98c-709745709961" :question/math-academy-id "q-253526" :question/problem "Consider the following set.\n\n$$\nA=\\{7-{(\\frac{1}{2})}^{n}\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are all the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=7-{(\\frac{1}{2})}^{n},\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/ca/cae6f56db55b49b98df6ce7e3ae0777e725af14de9dedb5b61b54039bac41860.png)\n\nWe see that ${a}_{n}$ is increasing and converges to $7.$ \n\nSo, in our case, we have that\n\n- any number in the set $x\\ge 7$ is an upper bound of $A,$\n\n- any number in the set $x<7$ is **not** an upper bound of $A.$ In other words, we can always find a sufficiently large $n$ so that $7-{(\\frac{1}{2})}^{n}$ is greater than $x$ for any $x<7.$\n\nTherefore, $[7,\\infty )$ is the set of upper bounds of $A,$ and \n\n$$\nsup(A)=min[7,\\infty )=7.\n$$\n\nNotice that $7$ is *not* the maximum of $A$ (the set $A$ has no maximum). Therefore, we conclude that\n\n$$\nsup(A)=7\\notin A.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-11588f66-7282-571e-8e23-97b1f1c241fa"] :db/ensure [:question/validate]} {:db/id "answer-field-11588f66-7282-571e-8e23-97b1f1c241fa" :answer-field/id #uuid "11588f66-7282-571e-8e23-97b1f1c241fa" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4c403958-65ff-5e3d-a88d-eb4c593bbb86" :answer-field/choices ["answer-a9d0eb3a-5dc4-5b58-944e-b28df01e747b" "answer-4c403958-65ff-5e3d-a88d-eb4c593bbb86" "answer-424cb1f4-7e81-5741-9fea-91a70c42cb72" "answer-b98431df-8366-56c8-bb4a-a0335b0aa79f" "answer-590bf0de-aa9c-5cf8-b6b6-eb31e0700ed4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9d0eb3a-5dc4-5b58-944e-b28df01e747b" :answer/id #uuid "a9d0eb3a-5dc4-5b58-944e-b28df01e747b" :answer/type :answer.type/math :answer/value "sup(A)=7\\in A" :db/ensure [:answer/validate]} {:db/id "answer-4c403958-65ff-5e3d-a88d-eb4c593bbb86" :answer/id #uuid "4c403958-65ff-5e3d-a88d-eb4c593bbb86" :answer/type :answer.type/math :answer/value "sup(A)=7\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-424cb1f4-7e81-5741-9fea-91a70c42cb72" :answer/id #uuid "424cb1f4-7e81-5741-9fea-91a70c42cb72" :answer/type :answer.type/math :answer/value "sup(A)=\\frac{13}{2}\\in A" :db/ensure [:answer/validate]} {:db/id "answer-b98431df-8366-56c8-bb4a-a0335b0aa79f" :answer/id #uuid "b98431df-8366-56c8-bb4a-a0335b0aa79f" :answer/type :answer.type/math :answer/value "sup(A)=\\frac{13}{2}\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-590bf0de-aa9c-5cf8-b6b6-eb31e0700ed4" :answer/id #uuid "590bf0de-aa9c-5cf8-b6b6-eb31e0700ed4" :answer/type :answer.type/text :answer/value "$sup(A)$ does not exist" :db/ensure [:answer/validate]} {:db/id "question-c7f8c921-7225-588c-b9e8-a78affb7e519" :question/id #uuid "c7f8c921-7225-588c-b9e8-a78affb7e519" :question/math-academy-id "q-253843" :question/problem "Consider the following set.\n\n$$\nA=\\{3+2{(\\frac{3}{5})}^{n}\\,:\\,n\\in N\\}\n$$\n\nFor this set, we have that {{field-1}}." :question/worked-solution "The supremum of a set $A$ is the smallest upper bound of $A.$\n\nTo find the supremum of this set, we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nThe elements of $A$ are the terms of the sequence ${a}_{n},$ given by\n\n$$\n{a}_{n}=3+2{(\\frac{3}{5})}^{n},\\,n\\in N=\\{1,2,3,4,…\\}.\n$$\n\nLet's draw some points of our sequence on the real line:\n\n![](images/05/05737c6e8e7b88f1a91a5fd6cc7d5b6a088227e327ef66e937e279c090a47256.png)\n\nWe see that ${a}_{n}$ is decreasing and converges to $3.$ The maximum of $A$ is \n\n$$\nmax(A)={a}_{1}=3+2{(\\frac{3}{5})}^{1}=\\frac{21}{5}.\n$$\n\nSo, in our case, we have that\n\n- any number $x\\ge {a}_{1}$ is an upper bound of $A,$\n\n- any number $x<{a}_{1}$ cannot be an upper bound because ${a}_{1},$ an element of $A,$ is greater than $x.$\n\nTherefore, $[\\frac{21}{5},\\infty )$ is the set of upper bounds of $A,$ and \n\n$$\nsup(A)=min[\\frac{21}{5},\\infty )=\\frac{21}{5}.\n$$\n\nNotice that $\\frac{21}{5}$ is the maximum of $A.$ Therefore, we conclude that\n\n$$\nsup(A)=\\frac{21}{5}\\in A.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f7ca4c4c-da25-5075-bde9-61051e330507"] :db/ensure [:question/validate]} {:db/id "answer-field-f7ca4c4c-da25-5075-bde9-61051e330507" :answer-field/id #uuid "f7ca4c4c-da25-5075-bde9-61051e330507" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-dc4faa51-f0ba-59dd-a17c-8673a8ed7588" :answer-field/choices ["answer-5e011c7d-1483-5d78-9bc4-5f179586ff35" "answer-07ca890c-4ce7-564d-a6a4-a9bac71abb91" "answer-dc4faa51-f0ba-59dd-a17c-8673a8ed7588" "answer-f17c6a34-e689-50a4-8b50-91c915977c45" "answer-fef7ef80-e0c5-5157-bd1a-b6b0059c3156"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e011c7d-1483-5d78-9bc4-5f179586ff35" :answer/id #uuid "5e011c7d-1483-5d78-9bc4-5f179586ff35" :answer/type :answer.type/math :answer/value "sup(A)=3\\in A" :db/ensure [:answer/validate]} {:db/id "answer-07ca890c-4ce7-564d-a6a4-a9bac71abb91" :answer/id #uuid "07ca890c-4ce7-564d-a6a4-a9bac71abb91" :answer/type :answer.type/math :answer/value "sup(A)=3\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-dc4faa51-f0ba-59dd-a17c-8673a8ed7588" :answer/id #uuid "dc4faa51-f0ba-59dd-a17c-8673a8ed7588" :answer/type :answer.type/math :answer/value "sup(A)=\\frac{21}{5}\\in A" :db/ensure [:answer/validate]} {:db/id "answer-f17c6a34-e689-50a4-8b50-91c915977c45" :answer/id #uuid "f17c6a34-e689-50a4-8b50-91c915977c45" :answer/type :answer.type/math :answer/value "sup(A)=\\frac{21}{5}\\notin A" :db/ensure [:answer/validate]} {:db/id "answer-fef7ef80-e0c5-5157-bd1a-b6b0059c3156" :answer/id #uuid "fef7ef80-e0c5-5157-bd1a-b6b0059c3156" :answer/type :answer.type/text :answer/value "$sup(A)$ does not exist" :db/ensure [:answer/validate]} {:db/id "question-fd9f0c45-62d6-5bab-b897-93c9f4793a8e" :question/id #uuid "fd9f0c45-62d6-5bab-b897-93c9f4793a8e" :question/math-academy-id "q-253869" :question/problem "![](images/5d/5dc63d364beae0482fdb996372e5042e4c5edf2a6bdbd7a5b79dbcc55cf419cb.png)\n\nWhat is the supremum of the function $y=f(x)$ shown above?\n\n${sup}_{x\\in R}f(x)=$\n{{field-1}}" :question/worked-solution "The supremum of a function is the supremum of the range of the function.\n\nIn this case, the range of $f$ is $A=(-1,4].$\n\nTo find the supremum of a set $A,$ we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nSo, in our case, we have that\n\n- any number $y\\ge 4$ is an upper bound of $A,$\n\n- any number $y<4$ cannot be an upper bound of $A$ because $4,$ an element of $A,$ is greater than $y.$\n\nTherefore, $[4,\\infty )$ is the set of upper bounds of $A,$ and\n\n$$\n{sup}_{x\\in R}f(x)=sup(A)=min[4,\\infty )=4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-60ad18e2-13e5-50fe-b40b-8175f7273995"] :db/ensure [:question/validate]} {:db/id "answer-field-60ad18e2-13e5-50fe-b40b-8175f7273995" :answer-field/id #uuid "60ad18e2-13e5-50fe-b40b-8175f7273995" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5b8257c3-cb89-57e7-af23-191b90a42228" :answer-field/choices ["answer-5b8257c3-cb89-57e7-af23-191b90a42228"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b8257c3-cb89-57e7-af23-191b90a42228" :answer/id #uuid "5b8257c3-cb89-57e7-af23-191b90a42228" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-42308119-ffcd-55c6-b052-68e017e7cc90" :question/id #uuid "42308119-ffcd-55c6-b052-68e017e7cc90" :question/math-academy-id "q-253897" :question/problem "![](images/64/64131e649a82e06d2750d53bdf05b1701b0674a05b70149081ddb58d700adb54.png)\n\nWhat is the supremum of the function $y=f(x)$ shown above?\n\n${sup}_{x\\in R}f(x)=$\n{{field-1}}" :question/worked-solution "The supremum of a function is the supremum of the range of the function.\n\nIn this case, the range of $f$ is $A=(-1,2).$\n\nTo find the supremum of a set $A,$ we must find the set containing **all** upper bounds of $A$ (i.e., the set of upper bounds) and take the minimum of this set.\n\nSo, in our case, we have that\n\n- any number $y\\ge 2$ is an upper bound of $A,$\n\n- any number $y<2$ is **not** an upper bound of $A.$ In other words, we can always find an element of $A$ that is greater than $y$ for any $y<2.$\n\nTherefore, $[2,\\infty )$ is the set of lower bounds of $A,$ and\n\n$$\n{sup}_{x\\in R}f(x)=sup(A)=min[2,\\infty )=2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6ed2c775-df54-54e2-ad43-b85dd389a975"] :db/ensure [:question/validate]} {:db/id "answer-field-6ed2c775-df54-54e2-ad43-b85dd389a975" :answer-field/id #uuid "6ed2c775-df54-54e2-ad43-b85dd389a975" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d76112fe-0fce-56ee-bf7a-c6fba9800dcd" :answer-field/choices ["answer-d76112fe-0fce-56ee-bf7a-c6fba9800d