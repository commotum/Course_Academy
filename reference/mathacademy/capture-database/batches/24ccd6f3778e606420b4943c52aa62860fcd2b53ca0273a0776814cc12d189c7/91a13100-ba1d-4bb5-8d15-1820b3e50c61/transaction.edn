eight=\"20\" width=\"15\">$-\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-$</td><td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,⋮$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nWe could continue the division, but the same digit keeps repeating. Thus, the decimal continues with repeating $3$'s:\n\n$$\n5.833…\n$$\n\nTherefore,\n\n$$\n\\frac{35}{6}=5.833…=5.8\\overset{―}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-615923bb-681b-5ce2-ad26-01ed8cc6fffa"] :db/ensure [:question/validate]} {:db/id "answer-field-615923bb-681b-5ce2-ad26-01ed8cc6fffa" :answer-field/id #uuid "615923bb-681b-5ce2-ad26-01ed8cc6fffa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0cc3be08-24b1-54f9-af68-78b4bd4fdd21" :answer-field/choices ["answer-2ddf3277-cbe0-51ee-bc14-e95d0c8553d2" "answer-4c9783e6-52f6-5b82-8a6f-68e17c4b9078" "answer-0f4ed4ac-c2db-51ec-a5c3-d37e18d57b96" "answer-a5f94b37-0a6b-5996-b725-22ff2c85ea43" "answer-0cc3be08-24b1-54f9-af68-78b4bd4fdd21"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ddf3277-cbe0-51ee-bc14-e95d0c8553d2" :answer/id #uuid "2ddf3277-cbe0-51ee-bc14-e95d0c8553d2" :answer/type :answer.type/math :answer/value "5.3\\overset{―}{8}" :db/ensure [:answer/validate]} {:db/id "answer-4c9783e6-52f6-5b82-8a6f-6