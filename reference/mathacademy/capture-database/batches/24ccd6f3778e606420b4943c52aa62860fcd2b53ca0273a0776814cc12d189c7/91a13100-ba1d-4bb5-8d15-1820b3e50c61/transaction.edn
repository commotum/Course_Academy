egin{aligned}(32+(-28))^{3} & ={4}^{3}\\end{aligned}\n$$\n\nFinally, we compute the exponent:\n\n$$\n\\begin{aligned}{4}^{3}=64\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b9b18399-62b8-5129-8be3-3c30ac27453f"] :db/ensure [:question/validate]} {:db/id "answer-field-b9b18399-62b8-5129-8be3-3c30ac27453f" :answer-field/id #uuid "b9b18399-62b8-5129-8be3-3c30ac27453f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a21ccfb8-977e-519c-b897-7af24b809a54" :answer-field/choices ["answer-a21ccfb8-977e-519c-b897-7af24b809a54"] :db/ensure [:answer-field/validate]} {:db/id "answer-a21ccfb8-977e-519c-b897-7af24b809a54" :answer/id #uuid "a21ccfb8-977e-519c-b897-7af24b809a54" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "activity-60936641-355a-54ca-910d-83aee7c18376" :activity/id #uuid "60936641-355a-54ca-910d-83aee7c18376" :activity/title "Evaluating Expressions With Positive Integer Exponents" :activity/type :activity.type/review :activity/scope 17592186048594 :activity/course 17592186046648 :activity/steps ["step-721cbfa0-5e23-5864-b656-268c3fc3ca8a" "step-03c2edcd-575d-58ce-886d-f19883074feb" "step-9e957131-4874-5e4b-ad84-6fb1f2a5f82c" "step-11b7515f-341c-51bb-9088-1fd8218d06f4"] :activity/first-step "step-721cbfa0-5e23-5864-b656-268c3fc3ca8a" :db/ensure [:activity/validate]} {:db/id "step-721cbfa0-5e23-5864-b656-268c3fc3ca8a" :step/id #uuid "721cbfa0-5e23-5864-b656-268c3fc3ca8a" :step/content "question-50989de1-e6f3-5831-87a9-51e32375a2a1" :step/next "step-03c2edcd-575d-58ce-886d-f19883074feb" :db/ensure [:step/validate]} {:db/id "step-03c2edcd-575d-58ce-886d-f19883074feb" :step/id #uuid "03c2edcd-575d-58ce-886d-f19883074feb" :step/content "question-4b607318-28df-51c2-9737-62f37f3092a8" :step/next "step-9e957131-4874-5e4b-ad84-6fb1f2a5f82c" :db/ensure [:step/validate]} {:db/id "step-9e957131-4874-5e4b-ad84-6fb1f2a5f8