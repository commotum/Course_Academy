me{sin}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}xz\\,\\text{d}V & ={∭}_{Δ}(r\\operatorname{cos}⁡\\theta )z\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{5}{\\int }_{0}^{6+r\\operatorname{sin}⁡\\theta }{r}^{2}z\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139536001 17592186045417 true] [17592186129517 1070 #edb/ref 17592186045487 13194139536001 17592186045417 true] [17592186129517 1071 "If the solid region $R$ is given by\n$R = {(x, y, z): x^{2} + (y + 3)^{2} \\le 9, 0 \\le z \\le 2 + x^{2} + y^{2}}$,\nthen $∭_(R)xydV =$" 13194139536001 17592186045417 false] [17592186129517 1071 "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+3)^{2}\\le 9,\\,0\\le z\\le 2+{x}^{2}+{y}^{2}\\},\n$$\n\nthen ${∭}_{R}xy\\,\\text{d}V=$" 13194139536001 17592186045417 true] [17592186129517 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/75/75bec31176c369e69d5b11af3eeab23f86a4f32251e37f56b225e9dd0bd4a3de.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,-3)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=2+{x}^{2}+{y}^{2}=2+{r}^{2}.$\n\nWith that in mind, let's write the equation ${x}^{2}+(y+3)^{2}=9$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+3)^{2} & =9 \\\\ {(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta +3)}^{2} & =9 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +6r\\operatorname{sin}⁡\\theta +9 & =9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+6r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+6r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+6\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=-6\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -6\\operatorname{sin}⁡\\theta ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le 2+{r}^{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}xy\\,\\text{d}V & ={∭}_{Δ}(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139536001 17592186045417 true] [17592186129767 1070 #edb/ref 17592186045486 13194139536001 17592186045417 true] [17592186129767 1071 "Evaluate the triple integral\n$∭_(R)2zdV$\nover the region $R$ enclosed inside the cylinder $x^{2} + y^{2} = 9$ for $y \\ge 0$ and between the surfaces $z =-x$ and $z = 2 + x$." 13194139536001 17592186045417 false] [17592186129767 1071 "Evaluate the triple integral \n\n$$\n{∭}_{R}2z\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the cylinder ${x}^{2}+{y}^{2}=9$  for $y\\ge 0$ and between the surfaces $z=-x$ and $z=2+x.$" 13194139536001 17592186045417 true] [17592186129767 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/06/063fafc4f8c50dba56bcfb50b8366a2ffb8c713f5668ce22d10c0370376bbaba.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $3$ whose axis passes through the point $(1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-x=-r\\operatorname{cos}⁡\\theta ,$ and\n\n- bounded above by $z=2+x=2+r\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le \\pi ,\\,-r\\operatorname{cos}⁡\\theta \\le z\\le 2+r\\operatorname{cos}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2z\\,\\text{d}V & ={∭}_{Δ}2z\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{3}{\\int }_{-r\\operatorname{cos}⁡\\theta }^{2+r\\operatorname{cos}⁡\\theta }2rz\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{3}r[{z}^{2}]_{z=-r\\operatorname{cos}⁡\\theta }^{z=2+r\\operatorname{cos}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{3}r((2+r\\operatorname{cos}⁡\\theta )^{2}-(-r\\operatorname{cos}⁡\\theta )^{2})\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{3}4r+4{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{[2{r}^{2}+\\frac{4}{3}{r}^{3}\\operatorname{cos}⁡\\theta ]}_{r=0}^{r=3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }2(3)^{2}+\\frac{4}{3}(3)^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }18+36\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[18\\theta +36\\operatorname{sin}⁡\\theta ]_{\\theta =0}^{\\theta =\\pi } \\\\  & =18(\\pi -0)+36(0-0) \\\\  & =18\\pi .\\end{aligned}\n$$" 13194139536001 17592186045417 true] [17592186131167 1075 #edb/ref 17592186131168 13194139536001 17592186045417 false] [17592186131167 1075 #edb/ref 17592186131169 13194139536001 17592186045417 false] [17592186131167 1075 #edb/ref 17592186131170 13194139536001 17592186045417 false] [17592186131167 1075 #edb/ref 17592186131171 13194139536001 17592186045417 false] [17592186131167 1075 #edb/ref 17592186131172 13194139536001 17592186045417 false] [17592186131167 1075 #edb/ref 17592186555037 13194139536001 17592186045417 true] [17592186131167 1075 #edb/ref 17592186555092 13194139536001 17592186045417 true] [17592186131167 1075 #edb/ref 17592186555356 13194139536001 17592186045417 true] [17592186131167 1075 #edb/ref 17592186555399 13194139536001 17592186045417 true] [17592186131167 1075 #edb/ref 17592186555440 13194139536001 17592186045417 true] [17592186131167 1078 #edb/ref 17592186555037 13194139536001 17592186045417 true] [17592186132421 1075 #edb/ref 17592186132422 13194139536001 17592186045417 false] [17592186132421 1075 #edb/ref 17592186132423 13194139536001 17592186045417 false] [17592186132421 1075 #edb/ref 17592186132424 13194139536001 17592186045417 false] [17592186132421 1075 #edb/ref 17592186132425 13194139536001 17592186045417 false] [17592186132421 1075 #edb/ref 17592186132426 13194139536001 17592186045417 false] [17592186132421 1075 #edb/ref 17592186555028 13194139536001 17592186045417 true] [17592186132421 1075 #edb/ref 17592186555069 13194139536001 17592186045417 true] [17592186132421 1075 #edb/ref 17592186555289 13194139536001 17592186045417 true] [17592186132421 1075 #edb/ref 17592186555344 13194139536001 17592186045417 true] [17592186132421 1075 #edb/ref 17592186555525 13194139536001 17592186045417 true] [17592186132421 1078 #edb/ref 17592186555028 13194139536001 17592186045417 true] [17592186133742 1038 #edb/ref 17592186555762 13194139536001 17592186045417 true] [17592186133742 1038 #edb/ref 17592186555780 13194139536001 17592186045417 true] [17592186133742 1038 #edb/ref 17592186555791 13194139536001 17592186045417 true] [17592186133743 1038 #edb/ref 17592186555797 13194139536001 17592186045417 true] [17592186133743 1038 #edb/ref 17592186555812 13194139536001 17592186045417 true] [17592186133744 1038 #edb/ref 17592186555834 13194139536001 17592186045417 true] [17592186133870 1038 #edb/ref 17592186555850 13194139536001 17592186045417 true] [17592186134188 1070 #edb/ref 17592186045486 13194139536001 17592186045417 true] [17592186134188 1071 "Suppose that the following elementary row operations are applied to a $3 \\cdot 3$ matrix $A$ in the given order:\n$R_{1}↔R_{3}, R_{2}:=R_{2} - 2R_{3}, R_{1}:=3R_{1}$\nWhat is the equivalent notation in terms of matrix multiplication?" 13194139536001 17592186045417 false] [17592186134188 1071 "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{1}↔{R}_{3},\\,{R}_{2}:={R}_{2}-2{R}_{3},\\,{R}_{1}:=3{R}_{1}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" 13194139536001 17592186045417 true] [17592186134188 1074 "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}:={R}_{2}-2{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:=3{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=3{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$" 13194139536001 17592186045417 true] [17592186134397 1070 #edb/ref 17592186045487 13194139536001 17592186045417 true] [17592186134397 1071 "Suppose that the following elementary row operations are applied to a $3 \\cdot 3$ matrix $A$ in the given order:\n$R_{1}:=R_{1} + 2R_{3}, R_{2}:=-3R_{2}$\nWhat is the equivalent notation in terms of matrix multiplication?" 13194139536001 17592186045417 false] [17592186134397 1071 "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{1}:={R}_{1}+2{R}_{3},\\,{R}_{2}:=-3{R}_{2}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" 13194139536001 17592186045417 true] [17592186134397 1074 "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}:={R}_{1}+2{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}:=-3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" 13194139536001 17592186045417 true] [17592186135104 1064 "Let's consider an inner product space $V$ equipped with the inner product $\\langle \\cdot, \\cdot \\rangle.$ \nA set of vectors \n\n$$\n{U}=\\{ \\mathbf{u}_1, \\cdots, \\mathbf{u}_p \\}\n$$\n\nis called an **orthogonal set with respect to the given inner product** if all vectors in the set are mutually orthogonal.\n\nFor example, let's consider the set\n\n![](images/69/69571997d87ed3f40ee7e9b0742075fbd5ee107892f6a9b4198f75f3f5a9fce3.svg)\n\nand the inner product on $\\mathbb{R}^3$ defined as \n\n$$\n\\langle \\mathbf{x},\\mathbf{y} \\rangle = x_1 y_1 + 3x_2 y_2 + 2x_3 y_3.\n$$\n\nIf we denote the vectors in our set ${V}$ as $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\},$ we can check that ${V}$ is orthogonal by showing that \n\n$$\n\\left\\{\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ &=0 \\\\ ⟨{v}_{1},{v}_{3}⟩ &=0 \\\\ ⟨{v}_{2},{v}_{3}⟩ &=0.\\end{aligned}\\right.\n$$\n\nLet's compute each inner product:\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =(1)(2)+3(1)(2)+2(1)(-4)=2+6-8=0 & ✓ \\\\ ⟨{v}_{1},{v}_{3}⟩ & =(1)(-3)+3(1)(1)+2(1)(0)=-3+3+0=0 & ✓ \\\\ ⟨{v}_{2},{v}_{3}⟩ & =(2)(-3)+3(2)(1)+2(-4)(0)=-6+6+0=0 & ✓\\end{aligned}\n$$\n\nSo indeed, ${V}$ is an orthogonal set." 13194139536001 17592186045417 false] [17592186135104 1064 "Let's consider an inner product space $V$ equipped with the inner product $\\langle \\cdot, \\cdot \\rangle.$ \nA set of vectors \n\n$$\n{U}=\\{ \\mathbf{u}_1, \\cdots, \\mathbf{u}_p \\}\n$$\n\nis called an **orthogonal set with respect to the given inner product** if all vectors in the set are mutually orthogonal.\n\nFor example, let's consider the set\n\n![](images/69/69571997d87ed3f40ee7e9b0742075fbd5ee107892f6a9b4198f75f3f5a9fce3.svg)\n\nand the inner product on $\\mathbb{R}^3$ defined as \n\n$$\n\\langle \\mathbf{x},\\mathbf{y} \\rangle = x_1 y_1 + 3x_2 y_2 + 2x_3 y_3.\n$$\n\nIf we denote the vectors in our set ${V}$ as $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\},$ we can check that ${V}$ is orthogonal by showing that \n\n$$\n\\{\\begin{aligned}⟨{v}_{1},{v}_{2}⟩=0 \\\\ ⟨{v}_{1},{v}_{3}⟩=0 \\\\ ⟨{v}_{2},{v}_{3}⟩=0.\\end{aligned}\n$$\n\nLet's compute each inner product:\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =(1)(2)+3(1)(2)+2(1)(-4)=2+6-8=0 & ✓ \\\\ ⟨{v}_{1},{v}_{3}⟩ & =(1)(-3)+3(1)(1)+2(1)(0)=-3+3+0=0 & ✓ \\\\ ⟨{v}_{2},{v}_{3}⟩ & =(2)(-3)+3(2)(1)+2(-4)(0)=-6+6+0=0 & ✓\\end{aligned}\n$$\n\nSo indeed, ${V}$ is an orthogonal set." 13194139536001 17592186045417 true] [17592186156879 1078 #edb/ref 17592186156880 13194139536001 17592186045417 true] [17592186157369 1038 #edb/ref 17592186555857 13194139536001 17592186045417 true] [17592186157370 1038 #edb/ref 17592186555765 13194139536001 17592186045417 true] [17592186157370 1038 #edb/ref 17592186555796 13194139536001 17592186045417 true] [17592186157993 1070 #edb/ref 17592186045487 13194139536001 17592186045417 true] [17592186157993 1071 "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $E[X] \\approx 2.2778$, compute $Var[X]$. Round your answer to $3$ decimal places.\n$f(x) = {\\frac{x^{2}}{12},\\begin{vmatrix}0 < x < 2, \\\\ \\frac{7}{9},\\end{vmatrix}2 \\le x < 3,; 0, \\mid otherwise$.\n\n> A scientific calculator is required to answer this question." 13194139536001 17592186045417 false] [17592186157993 1071 "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈2.2778,$ compute $\\text{Var}[X].$ Round your answer to $3$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}}{12}, & 0<x<2, \\\\ \\frac{7}{9}, & 2\\le x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139536001 17592186045417 true] [17592186157993 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{{x}^{2}}{12}\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot \\frac{7}{9}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{4}}{12}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{7{x}^{2}}{9}\\,\\text{d}x \\\\  & ={\\frac{{x}^{5}}{60}|}_{0}^{2}+{\\frac{7{x}^{3}}{27}|}_{2}^{3} \\\\  & ≈5.4593\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈5.4593-(2.2778)^{2} \\\\  & ≈0.271\\end{aligned}\n$$\n\n \nrounded to three decimal places." 13194139536001 17592186045417 true] [17592186158876 1075 #edb/ref 17592186158877 13194139536001 17592186045417 false] [17592186158876 1075 #edb/ref 17592186158878 13194139536001 17592186045417 false] [17592186158876 1075 #edb/ref 17592186158879 13194139536001 17592186045417 false] [17592186158876 1075 #edb/ref 17592186158880 13194139536001 17592186045417 false] [17592186158876 1075 #edb/ref 17592186158881 13194139536001 17592186045417 false] [17592186158876 1075 #edb/ref 17592186555047 13194139536001 17592186045417 true] [17592186158876 1075 #edb/ref 17592186555216 13194139536001 17592186045417 true] [17592186158876 1075 #edb/ref 17592186555371 13194139536001 17592186045417 true] [17592186158876 1075 #edb/ref 17592186555408 13194139536001 17592186045417 true] [17592186158876 1075 #edb/ref 17592186555498 13194139536001 17592186045417 true] [17592186158876 1078 #edb/ref 17592186555498 13194139536001 17592186045417 true] [17592186159638 1075 #edb/ref 17592186159639 13194139536001 17592186045417 false] [17592186159638 1075 #edb/ref 17592186159640 13194139536001 17592186045417 false] [17592186159638 1075 #edb/ref 17592186159641 13194139536001 17592186045417 false] [17592186159638 1075 #edb/ref 17592186159642 13194139536001 17592186045417 false] [17592186159638 1075 #edb/ref 17592186159643 13194139536001 17592186045417 false] [17592186159638 1075 #edb/ref 17592186555072 13194139536001 17592186045417 true] [17592186159638 1075 #edb/ref 17592186555141 13194139536001 17592186045417 true] [17592186159638 1075 #edb/ref 17592186555226 13194139536001 17592186045417 true] [17592186159638 1075 #edb/ref 17592186555307 1319