a6d9962" "answer-76c46b39-fb61-53de-aef2-a8b005e5c480" "answer-8e4990a1-560f-53d5-be4f-2eec443e8c54"] :db/ensure [:answer-field/validate]} {:db/id "answer-79250653-a0e0-5fd6-8438-35684c5d9f56" :answer/id #uuid "79250653-a0e0-5fd6-8438-35684c5d9f56" :answer/type :answer.type/math :answer/value "(-1,3)" :db/ensure [:answer/validate]} {:db/id "answer-8b948419-a96f-581e-8189-0707e03cb683" :answer/id #uuid "8b948419-a96f-581e-8189-0707e03cb683" :answer/type :answer.type/math :answer/value "(-1,5)" :db/ensure [:answer/validate]} {:db/id "answer-163e8977-be3f-5eb3-bab0-8bd12a6d9962" :answer/id #uuid "163e8977-be3f-5eb3-bab0-8bd12a6d9962" :answer/type :answer.type/math :answer/value "(2,-1)" :db/ensure [:answer/validate]} {:db/id "answer-76c46b39-fb61-53de-aef2-a8b005e5c480" :answer/id #uuid "76c46b39-fb61-53de-aef2-a8b005e5c480" :answer/type :answer.type/math :answer/value "(3,2)" :db/ensure [:answer/validate]} {:db/id "answer-8e4990a1-560f-53d5-be4f-2eec443e8c54" :answer/id #uuid "8e4990a1-560f-53d5-be4f-2eec443e8c54" :answer/type :answer.type/math :answer/value "(5,1)" :db/ensure [:answer/validate]} {:db/id "question-55975c7c-e140-5b83-8d6a-51f167ef8423" :question/id #uuid "55975c7c-e140-5b83-8d6a-51f167ef8423" :question/math-academy-id "q-121421" :question/problem "The point  $(-2,-1)$ lies on the curve $y=f(x+1).$ Which of the following points **must** lie on $y=-f(x)+5?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(-2,-1)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+5:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x+1).$\n\n- Then, we shift the graph horizontally $1$ unit to the right  and get the graph of $y=f(x).$ After this transformation, the point $(-2,-1)$ will be mapped to the point\n\n$$\n(-2+1,-1)=(-1,-1).\n$$\n\n- Next, to plot the graph of $y=-f(x)+5,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(-1,-1)$ will be mapped  to the point\n\n$$\n(-1,-(-1))=(-1,1).\n$$\n\n- Next, we shift the result vertically by $5$ units up and obtain the graph of $y=-f(x)+5.$ After this transformation, the point $(-1,1)$ will be mapped to the point \n\n$$\n(-1,1+5)=(-1,6).\n$$\n\n**Method 2**\n\nSince the point $(-2,-1)$ lies on the graph of $y=f(x+1)$, we have that \n\n$$\nf(-2+1)=-1\\,⟹\\,f(-1)=-1.\n$$\n\nNow consider the graph of $y=-f(x)+5.$ Substituting $x=-1$, we get\n\n$$\n\\begin{aligned}y & =-f(-1)+5 \\\\  & =-(-1)+5 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the point $(-1,6)$ must lie on $y=-f(x)+5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f4950e2-03cb-5f11-85ed-613795c817b8"] :db/ensure [:question/validate]} {:db/id "answer-field-6f4950e2-03cb-5f11-85ed-613795c817b8" :answer-field/id #uuid "6f4950e2-03cb-5f11-85ed-613795c817b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0f25cad-eab5-5a40-99bb-508ece389e96" :answer-field/choices ["answer-5c5fb19f-3b69-50e2-a5c8-157bdbdbcd0d" "answer-879fd5e7-60da-528c-a623-2358cc1d9ace" "answer-b0f25cad-eab5-5a40-99bb-508ece389e96" "answer-e2b781c0-aac0-5ba0-81b2-3f926b1f60c9" "answer-51c26d35-5b70-50fd-b982-e858aad8a95b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c5fb19f-3b69-50e2-a5c8-157bdbdbcd0d" :answer/id #uuid "5c5fb19f-3b69-50e2-a5c8-157bdbdbcd0d" :answer/type :answer.type/math :answer/value "(-1,-3)" :db/ensure [:answer/validate]} {:db/id "answer-879fd5e7-60da-528c-a623-2358cc1d9ace" :answer/id #uuid "879fd5e7-60da-528c-a623-2358cc1d9ace" :answer/type :answer.type/math :answer/value "(-1,3)" :db/ensure [:answer/validate]} {:db/id "answer-b0f25cad-eab5-5a40-99bb-508ece389e96" :answer/id #uuid "b0f25cad-eab5-5a40-99bb-508ece389e96" :answer/type :answer.type/math :answer/value "(-1,6)" :db/ensure [:answer/validate]} {:db/id "answer-e2b781c0-aac0-5ba0-81b2-3f926b1f60c9" :answer/id #uuid "e2b781c0-aac0-5ba0-81b2-3f926b1f60c9" :answer/type :answer.type/math :answer/value "(-2,-6)" :db/ensure [:answer/validate]} {:db/id "answer-51c26d35-5b70-50fd-b982-e858aad8a95b" :answer/id #uuid "51c26d35-5b70-50fd-b982-e858aad8a95b" :answer/type :answer.type/math :answer/value "(1,2)" :db/ensure [:answer/validate]} {:db/id 17592186233626 :question/answer-fields ["answer-field-9baf028c-2be1-525c-9089-58ae2e463aa6"] :db/ensure [:question/validate]} {:db/id "answer-field-9baf028c-2be1-525c-9089-58ae2e463aa6" :answer-field/id #uuid "9baf028c-2be1-525c-9089-58ae2e463aa6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3ae4e3e9-d085-55ed-9313-06b8f54d31e8" :answer-field/choices ["answer-5bed65c8-975d-503b-9b83-e165f8009ed8" "answer-3ae4e3e9-d085-55ed-9313-06b8f54d31e8" "answer-23168941-3b8a-51c2-b51d-b598e62171f5" "answer-521f7174-ba78-5000-b679-f71ab821d9e0" "answer-59782a5e-02e6-59c8-8e17-98d88fc6cdfc"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bed65c8-975d-503b-9b83-e165f8009ed8" :answer/id #uuid "5bed65c8-975d-503b-9b83-e165f8009ed8" :answer/type :answer.type/math :answer/value "(-4,9)" :db/ensure [:answer/validate]} {:db/id "answer-3ae4e3e9-d085-55ed-9313-06b8f54d31e8" :answer/id #uuid "3ae4e3e9-d085-55ed-9313-06b8f54d31e8" :answer/type :answer.type/math :answer/value "(-5,4)" :db/ensure [:answer/validate]} {:db/id "answer-23168941-3b8a-51c2-b51d-b598e62171f5" :answer/id #uuid "23168941-3b8a-51c2-b51d-b598e62171f5" :answer/type :answer.type/math :answer/value "(-5,8)" :db/ensure [:answer/validate]} {:db/id "answer-521f7174-ba78-5000-b679-f71ab821d9e0" :answer/id #uuid "521f7174-ba78-5000-b679-f71ab821d9e0" :answer/type :answer.type/math :answer/value "(1,4)" :db/ensure [:answer/validate]} {:db/id "answer-59782a5e-02e6-59c8-8e17-98d88fc6cdfc" :answer/id #uuid "59782a5e-02e6-59c8-8e17-98d88fc6cdfc" :answer/type :answer.type/math :answer/value "(1,8)" :db/ensure [:answer/validate]} {:db/id 17592186060998 :tutorial/content "Consider the function $y=f(x)$ shown below. \n\n![](images/af/afe8baa8375ceaf4974b62549e4f073d0e6cecfcfc1a50a91200421296141ef1.png)\n\n \n\nThis function has a local minimum point, and a local maximum point, as shown. \n\nNotice that if we perform the graph transformation $y=f(2x)-1,$ then \n\n- the local *maximum* point on the original graph is mapped to a local *maximum* point on the transformed curve, and\n\n- the local *minimum* point on the original graph is mapped to a local *minimum* point on the transformed curve.\n\n![](images/cd/cda6d2c00de091df0f4df03d4b63019fd7c5681159cff65ea25e7518f5e263cd.png)\n\n \n\nSo, this transformation maps maximums (local and global) to maximums and minimums (local and global) to minimums. \n\nIs this always the case? In other words, does *any* graph transformation map maximums to maximums and minimums to minimums? \n\nTo answer this, let's consider another example." :db/ensure [:tutorial/validate]} {:db/id 17592186060999 :tutorial/content "Consider the transformation $y=-f(x)+2,$ which contains a reflection about the $x$-axis.\n\n![](images/7f/7f4041c17b278b0e40e31abbd98e3c47a8462b14a6109123d600c2db0e5d6f36.png)\n\n \n\nNotice that \n\n- the local *maximum* point on the original graph is mapped to a local ** *minimum* ** point on the transformed curve, and\n\n- the local *minimum* point on the original graph is mapped to a local ** *maximum* ** point on the transformed curve.\n\nSo, due to the presence of vertical reflection, this transformation maps maximums (local and global) to minimums and minimums (local and global) to maximums." :db/ensure [:tutorial/validate]} {:db/id 17592186061000 :tutorial/content "We can summarize our findings by the following theorem:\n\n*If a transformation does **not** contain a reflection across the $x$-axis, then the transformation maps local (or global) maximums to local (or global) maximums, and maps local (or global) minimums to local (or global) minimums. *\n\nIn the case where we do have a vertical reflection, we have the following theorem.\n\n*If a transformation contains a reflection across the $x$-axis, then the transformation maps local (or global) maximums to local (or global) minimums, and maps local (or global) minimums to local (or global) maximums. *" :db/ensure [:tutorial/validate]} {:db/id 17592186059878 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186124615 :knowledge-point/questions ["question-81d21d06-3e96-5b9a-927f-4e61cf10e9c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124426 :question/problem "![](images/3c/3ccabfea2a80fc5f858400c5bac362841b8c6f6b41cdc6fedbbfcd031d2241ca.svg)\n\nConsider the stochastic matrix $P$ and vector $\\mathbf{q}$ shown above. Which of the following statements are true?\n\nI. $\\mathbf{q}$ is a stochastic vector\n\nII. $P\\mathbf{q} = \\mathbf{q}$\n\nIII. $\\mathbf{q}$ is a steady-state vector of $P$" :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $\\mathbf{q}$ such that $P\\mathbf{q} = \\mathbf{q}.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $\\mathbf{q}$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement II is true. Indeed, we have \n![](images/e5/e51c398066c9be6bd62023005c888d115956938926a82f9d4695684f37421628.svg)\n\n- Statement III is true. Indeed, $\\mathbf{q}$ is a stochastic vector such that $P\\mathbf{q}=\\mathbf{q}.$ So, it's a steady-state vector of $P.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :db/ensure [:question/validate]} {:db/id "question-81d21d06-3e96-5b9a-927f-4e61cf10e9c2" :question/id #uuid "81d21d06-3e96-5b9a-927f-4e61cf10e9c2" :question/math-academy-id "q-135312" :question/problem "$$\nP=[\\begin{aligned}0.4 & 0.7 & 0.25 \\\\ 0.2 & 0.1 & 0.65 \\\\ 0.4 & 0.2 & 0.1\\end{aligned}],\\,q=[\\begin{aligned}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{aligned}]\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\nI. $q$ is a stochastic vector\n\nII. $Pq=q$\n\nIII. $q$ is a steady-state vector of $P$" :question/worked-solution "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement II is true. Indeed, we have \n\n$$\nPq=[\\begin{aligned}0.4 & 0.7 & 0.25 \\\\ 0.2 & 0.1 & 0.65 \\\\ 0.4 & 0.2 & 0.1\\end{aligned}][\\begin{aligned}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{aligned}]=[\\begin{aligned}\\frac{6.8}{38}+\\frac{7.7}{38}+\\frac{1.25}{19} \\\\ \\frac{3.4}{38}+\\frac{1.1}{38}+\\frac{3.25}{19} \\\\ \\frac{6.8}{38}+\\frac{2.2}{38}+\\frac{0.5}{19}\\end{aligned}]=[\\begin{aligned}\\frac{17}{38} \\\\ \\frac{11}{38} \\\\ \\frac{5}{19}\\end{aligned}]=q.\n$$\n\n- Statement III is true. Indeed, $q$ is a stochastic vector such that $Pq=q.$ So, it's a steady-state vector of $P.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-30b36195-3069-564b-b4ee-eb8a18d3068c"] :db/ensure [:question/validate]} {:db/id "answer-field-30b36195-3069-564b-b4ee-eb8a18d3068c" :answer-field/id #uuid "30b36195-3069-564b-b4ee-eb8a18d3068c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ccc323e-1621-5748-ad4b-61796a0013ef" :answer-field/choices ["answer-ddf20109-e5a0-5d3e-879b-f5b09bf29f0f" "answer-6ccc323e-1621-5748-ad4b-61796a0013ef" "answer-c96da41e-20e2-5525-b2cf-a83b365cb071" "answer-1e737225-dfe8-56fa-9c5c-420bb05fb213" "answer-3f79f79a-7208-5b41-a4f9-47134b6724e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-ddf20109-e5a0-5d3e-879b-f5b09bf29f0f" :answer/id #uuid "ddf20109-e5a0-5d3e-879b-f5b09bf29f0f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6ccc323e-1621-5748-ad4b-61796a0013ef" :answer/id #uuid "6ccc323e-1621-5748-ad4b-61796a0013ef" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-c96da41e-20e2-5525-b2cf-a83b365cb071" :answer/id #uuid "c96da41e-20e2-5525-b2cf-a83b365cb071" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-1e737225-dfe8-56fa-9c5c-420bb05fb213" :answer/id #uuid "1e737225-dfe8-56fa-9c5c-420bb05fb213" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-3f79f79a-7208-5b41-a4f9-47134b6724e6" :answer/id #uuid "3f79f79a-7208-5b41-a4f9-47134b6724e6" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id 17592186125855 :tutorial/content "Suppose we have a population where people live either in the city or the countryside. A study carried out by the local authority shows that, each year,\n\n- $6\\%$ of the city population relocates to the countryside,\n\n- $3\\%$ of the countryside population relocates to the city, and\n\n- everyone else remains where they are.\n\nAdditionally, $70\\%$ of the population lived in the city and $30\\%$ in the countryside at the time of the study. \n\nWe can represent this situation using a stochastic matrix $P$ and initial state vector $\\mathbf x_0,$ as follows:\n\n![](images/44/44fa9ad32622bd1d7b3541206030ecc862a3db9420f46049c9f16992fdb947ca.svg) \n\nAs we've seen, to find the state vector $\\mathbf x_{k+1}$ that corresponds to the $(k+1)$th year, we left-multiply the state vector corresponding to the $k$th year by $P.$ This gives rise to the following Markov chain:\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0}, \\\\ {x}_{2} & =P{x}_{1}, \\\\ {x}_{3} & =P{x}_{2}, \\\\ ⋮ & \\,⋮ \\\\ {x}_{k+1} & =P{x}_{k} \\\\ ⋮ & \\,⋮\\end{aligned}\n$$\n\nThe local authority wants to determine whether the state vectors settle down to a fixed state. With the aid of a computer, they compute the following states:\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0}=[\\begin{aligned}0.667 \\\\ 0.333\\end{aligned}] \\\\ {x}_{2} & =P{x}_{1}=[\\begin{aligned}0.636\\,97 \\\\ 0.363\\,03\\end{aligned}] \\\\ {x}_{3} & =P{x}_{2}=[\\begin{aligned}0.609\\,64 \\\\ 0.390\\,36\\end{aligned}] \\\\  & ⋮ \\\\ {x}_{100} & =P{x}_{99}=[\\begin{aligned}0.333\\,363 \\\\ 0.666\\,637\\end{aligned}]≈[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}] \\\\ {x}_{101} & =P{x}_{100}=[\\begin{aligned}0.333\\,36 \\\\ 0.666\\,64\\end{aligned}]≈[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the data, we see that the vectors $\\mathbf x_{100}$ and $\\mathbf x_{101}$ are both approximately equal to the vector\n\n![](images/03/030d5719a268d9e15c2c58488ff1c36602d5c757475e79c25dcd1da5a4eb8712.svg)\n\nFurthermore, computing $\\mathbf x_{102}, \\mathbf{x}_{103}, \\ldots$ all give vectors approximately equal to $\\mathbf q.$ This suggests that the sequence $\\mathbf x_k$ converges to $\\mathbf q\\mathbin{:}$\n\n$$\nx_k \\rightarrow \\mathbf q \\quad\\textrm{as}\\quad k\\to\\infty.\n$$\n\nThe vector $\\mathbf q$ is called a **steady-state vector** of the matrix $P.$ Here, our steady-state vector suggests that after enough time has passed, one-third of the population will live in the city and two-thirds will live in the countryside.\n\nFinally, notice that for large values of $k,$ we have\n\n$$\nP\\mathbf x_k \\approx \\mathbf x_{k}.\n$$\n\nThis observation indicates how to find $\\mathbf q$ without resorting to computers." :db/ensure [:tutorial/validate]} {:db/id 17592186125849 :tutorial/content "Suppose we have a stochastic matrix $P$ and a stochastic vector $\\mathbf{q}.$ Then, $\\mathbf{q}$ is a **steady-state vector** of $P$ if \n\n$$\nP\\mathbf{q} = \\mathbf{q}.\n$$\n\nFor example, to show that the stochastic vector \n![](images/ca/caba3c1b2f3245a3ebea0bd6ff6d47c63d409a7ba18a48db1f1269cb9ac13854.svg) \n\nis a steady-state vector for the stochastic matrix \n![](images/7f/7f231d09e7daf85eec90e682a9eb53c242aadac75b372e3685b65757ae3309dc.svg) \n\nwe compute the matrix product $P\\mathbf q\\mathbin:$\n\n$$\n\\begin{aligned}Pq & =[\\begin{aligned}0.94 & 0.03 \\\\ 0.06 & 0.97\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}0.94 & 0.03 \\\\ 0.06 & 0.97\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}0.94+2\\cdot 0.03 \\\\ 0.06+2\\cdot 0.97\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}] \\\\  & =q\\,✓\\end{aligned}\n$$\n\nSince $P\\mathbf q = \\mathbf q,$ the vector $\\mathbf q$ is a steady-state vector of $P.$" :db/ensure [:tutorial/validate]} {:db/id 17592186125850 :tutorial/content "To find a steady-state vector of a stochastic matrix $P,$ we seek a stochastic vector $\\mathbf{q}$ such that \n\n$$\nP\\mathbf{q} = \\mathbf{q}.\n$$\n\nLet's begin by writing this equation in a slightly different form:\n\n$$\n\\begin{aligned}Pq & =q \\\\ Pq-q & =0 \\\\ Pq-Iq & =0 \\\\ (P-I)q & =0\\end{aligned}\n$$\n\nTherefore, the vector we seek is a solution to the matrix equation $(P-I)\\mathbf{q} = \\mathbf{0}.$\n\nLet's use this idea to find a steady-state vector for the matrix\n![](images/77/77ffe4078d3c62c30ab94b59bc9465a92db659b9e70b137bb144deb44844e800.svg)\n\nFirst, we compute $(P-I):$\n![](images/3d/3d91ece6103baa469569adf1994f3965cfc3429fbe65c0d7cfffff53b83b20ef.svg)\n\nThen, to solve $(P-I)\\mathbf{q} = \\mathbf{0},$ we reduce the augmented matrix $M$ to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-0.75 & 0.5 & 0 \\\\ 0.75 & -0.5 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-0.75 & 0.5 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, $x_2$ is a free variable. From the first equation, we obtain \n\n$$\nx_1= \\dfrac 23 x_2.\n$$\n\nHence, the general solution is\n\n![](images/4a/4a5d81320f3e4eeee6b9fb09424238467d6c9e8b2e2246971ba3550b65a6d9c2.svg)\n\nSince the steady-state vector must be stochastic, its entries should add up to $1.$ Therefore, we have \n\n$$\n\\begin{aligned}\\frac{2}{3}{x}_{2}+{x}_{2} & =1 \\\\ \\frac{5}{3}{x}_{2} & =1 \\\\ {x}_{2} & =\\frac{3}{5}.\\end{aligned}\n$$\n\nFinally, our steady-state vector is\n\n![](images/85/8515cb27fa64a5186fae0c63184df2ff7651c03963eef5804c4d6bedbace2283.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186125851 :tutorial/content "A stochastic matrix $P$ is **regular** if there exists a positive integer $n$ such that $P^n$ has all positive elements.\n\nLet's consider some examples:\n\n- The stochastic matrix $P,$ given by\n![](images/e9/e9588bb9c77762d6caee5460403077eba65a891676f85a9e30ff99e7e6112184.svg) \nhas all positive elements. Therefore, it is a regular stochastic matrix.\n\n- The stochastic matrix $Q,$ given by\n![](images/e0/e0ba33618820d19e77d365a9f316239ef2e36133cbcac4007bf2b5c2f6e57137.svg) \ncontains a zero element. However, if we compute its square, we get\n![](images/29/29c5a411ac3c797699a39e35972e415e98df3347e66581bb5494f61a92d92bd5.svg) \nwhich has all positive elements. Therefore, $Q$ is a regular stochastic matrix.\n\nRegular stochastic matrices have the following important property:\n\n*Any regular stochastic matrix has a **unique** steady-state vector $\\mathbf q.$ Moreover, the Markov chain\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0}, \\\\ {x}_{2} & =P{x}_{1}, \\\\ {x}_{3} & =P{x}_{2}, \\\\ ⋮ & \\,⋮ \\\\ {x}_{k+1} & =P{x}_{k} \\\\ ⋮ & \\,⋮\\end{aligned}\n$$\n\nconverges to $\\mathbf q$ for **any** initial state $\\mathbf x_0.$*" :db/ensure [:tutorial/validate]} {:db/id 17592186124712 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186162106 :knowledge-point/questions ["question-c2a27711-6c10-58d5-b2f3-5f2c3c569a97"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c2a27711-6c10-58d5-b2f3-5f2c3c569a97" :question/id #uuid "c2a27711-6c10-58d5-b2f3-5f2c3c569a97" :question/math-academy-id "q-143400" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{20}$ is a sample of size $n=20$ drawn from a population with mean $\\mu =0.7$ and variance ${\\sigma }^{2}=0.1,$ calculate the value of $\\text{Var}[\\overset{―}{X}].$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}.\n$$\n\nSince the population variance ${\\sigma }^{2}=0.1$ and the sample size $n=20,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{0.1}{20} \\\\  & =0.005.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c8d2d1ba-3527-52e7-870f-e223ed442407"] :db/ensure [:question/validate]} {:db/id "answer-field-c8d2d1ba-3527-52e7-870f-e223ed442407" :answer-field/id #uuid "c8d2d1ba-3527-52e7-870f-e223ed442407" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aadddd80-82a5-5508-bc30-2242f6328bc5" :answer-field/choices ["answer-aadddd80-82a5-5508-bc30-2242f6328bc5" "answer-202c2206-09ba-5f9b-b455-39671ad1087d" "answer-ece61310-9e1e-5d98-9a54-46b33668a004" "answer-c446f581-f180-508c-8472-c4be11334fdf" "answer-26ea0188-d3a8-578a-947b-3ff305dc87fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-aadddd80-82a5-5508-bc30-2242f6328bc5" :answer/id #uuid "aadddd80-82a5-5508-bc30-2242f6328bc5" :answer/type :answer.type/math :answer/value "0.005" :db/ensure [:answer/validate]} {:db/id "answer-202c2206-09ba-5f9b-b455-39671ad1087d" :answer/id #uuid "202c2206-09ba-5f9b-b455-39671ad1087d" :answer/type :answer.type/math :answer/value "0.025" :db/ensure [:answer/validate]} {:db/id "answer-ece61310-9e1e-5d98-9a54-46b33668a004" :answer/id #uuid "ece61310-9e1e-5d98-9a54-46b33668a004" :answer/type :answer.type/math :answer/value "0.05" :db/ensure [:answer/validate]} {:db/id "answer-c446f581-f180-508c-8472-c4be11334fdf" :answer/id #uuid "c446f581-f180-508c-8472-c4be11334fdf" :answer/type :answer.type/math :answer/value "0.1" :db/ensure [:answer/validate]} {:db/id "answer-26ea0188-d3a8-578a-947b-3ff305dc87fd" :answer/id #uuid "26ea0188-d3a8-578a-947b-3ff305dc87fd" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "activity-0d2a4412-2dac-5e68-9ef6-8871a2ce8889" :activity/id #uuid "0d2a4412-2dac-5e68-9ef6-8871a2ce8889" :activity/title "Variance of Sample Means" :activity/type :activity.type/review :activity/scope 17592186049674 :activity/course 17592186046660 :activity/steps ["step-00d8fa95-6258-55b6-83d5-e04b9f3228b7" "step-ad80f446-b473-51f1-9360-f55320183fab" "step-1ed18c81-e6cc-5550-b6aa-5ce254478730" "step-e9d3d209-2fad-5117-88ff-6259a20aa11c" "step-c1d31ec5-a85e-563d-bde8-c3408887140b"] :activity/first-step "step-00d8fa95-6258-55b6-83d5-e04b9f3228b7" :db/ensure [:activity/validate]} {:db/id "step-00d8fa95-6258-55b6-83d5-e04b9f3228b7" :step/id #uuid "00d8fa95-6258-55b6-83d5-e04b9f3228b7" :step/content "question-c2a27711-6c10-58d5-b2f3-5f2c3c569a97" :step/next "step-ad80f446-b473-51f1-9360-f55320183fab" :db/ensure [:step/validate]} {:db/id "step-ad80f446-b473-51f1-9360-f55320183fab" :step/id #uuid "ad80f446-b473-51f1-9360-f55320183fab" :step/content 17592186425753 :step/next "step-1ed18c81-e6cc-5550-b6aa-5ce254478730" :db/ensure [:step/validate]} {:db/id "step-1ed18c81-e6cc-5550-b6aa-5ce254478730" :step/id #uuid "1ed18c81-e6cc-5550-b6aa-5ce254478730" :step/content 17592186418459 :step/next "step-e9d3d209-2fad-5117-88ff-6259a20aa11c" :db/ensure [:step/validate]} {:db/id "step-e9d3d209-2fad-5117-88ff-6259a20aa11c" :step/id #uuid "e9d3d209-2fad-5117-88ff-6259a20aa11c" :step/content 17592186418454 :step/next "step-c1d31ec5-a85e-563d-bde8-c3408887140b" :db/ensure [:step/validate]} {:db/id "step-c1d31ec5-a85e-563d-bde8-c3408887140b" :step/id #uuid "c1d31ec5-a85e-563d-bde8-c3408887140b" :step/content 17592186491183 :db/ensure [:step/validate]} {:db/id 17592186157370 :knowledge-point/questions ["question-15966dc5-b8d2-54f2-9092-584d157e0965" "question-42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186157993 :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈2.2778,$ compute $\\text{Var}[X].$ Round your answer to $3$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}}{12}, & 0<x<2, \\\\ \\frac{7}{9}, & 2\\le x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{{x}^{2}}{12}\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot \\frac{7}{9}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{4}}{12}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{7{x}^{2}}{9}\\,\\text{d}x \\\\  & ={\\frac{{x}^{5}}{60}|}_{0}^{2}+{\\frac{7{x}^{3}}{27}|}_{2}^{3} \\\\  & ≈5.4593\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈5.4593-(2.2778)^{2} \\\\  & ≈0.271\\end{aligned}\n$$\n\n \nrounded to three decimal places." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186156879 :answer-field/correct 17592186156880 :db/ensure [:answer-field/validate]} {:db/id 17592186157369 :knowledge-point/questions ["question-d36205bb-47f5-5c37-9085-d080474849b2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-15966dc5-b8d2-54f2-9092-584d157e0965" :question/id #uuid "15966dc5-b8d2-54f2-9092-584d157e0965" :question/math-academy-id "q-90603" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈3.314\\,81,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{9}, & 0<x<3, \\\\ \\frac{1}{9}(2x-5), & 3\\le x<5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{1}{9}\\,\\text{d}x+{\\int }_{3}^{5}{x}^{2}\\cdot \\frac{1}{9}(2x-5)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{{x}^{2}}{9}\\,\\text{d}x+{\\int }_{3}^{5}\\frac{1}{9}(2{x}^{3}-5{x}^{2})\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{27}|}_{0}^{3}+{\\frac{1}{9}(\\frac{{x}^{4}}{2}-\\frac{5{x}^{3}}{3})|}_{3}^{5} \\\\  & ≈13.074\\,07\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈13.074\\,07-(3.314\\,81)^{2} \\\\  & ≈2.09\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bb51de07-a3ab-5b3e-aa1b-ded6bbcf5569"] :db/ensure [:question/validate]} {:db/id "answer-field-bb51de07-a3ab-5b3e-aa1b-ded6bbcf5569" :answer-field/id #uuid "bb51de07-a3ab-5b3e-aa1b-ded6bbcf5569" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d77c1d14-7d11-58f9-9465-73a0b8c60934" :answer-field/choices ["answer-50907c91-9bbc-55c1-8c7d-3ee9bdffecbd" "answer-fbfc573b-da4d-5a63-a17a-aad20992b7b3" "answer-d77c1d14-7d11-58f9-9465-73a0b8c60934" "answer-368e39f4-7c89-5dbe-b59a-90b69ad68444" "answer-b1f51ad0-f017-5334-b1f9-111993585928"] :db/ensure [:answer-field/validate]} {:db/id "answer-50907c91-9bbc-55c1-8c7d-3ee9bdffecbd" :answer/id #uuid "50907c91-9bbc-55c1-8c7d-3ee9bdffecbd" :answer/type :answer.type/math :answer/value "1.78" :db/ensure [:answer/validate]} {:db/id "answer-fbfc573b-da4d-5a63-a17a-aad20992b7b3" :answer/id #uuid "fbfc573b-da4d-5a63-a17a-aad20992b7b3" :answer/type :answer.type/math :answer/value "1.95" :db/ensure [:answer/validate]} {:db/id "answer-d77c1d14-7d11-58f9-9465-73a0b8c60934" :answer/id #uuid "d77c1d14-7d11-58f9-9465-73a0b8c60934" :answer/type :answer.type/math :answer/value "2.09" :db/ensure [:answer/validate]} {:db/id "answer-368e39f4-7c89-5dbe-b59a-90b69ad68444" :answer/id #uuid "368e39f4-7c89-5dbe-b59a-90b69ad68444" :answer/type :answer.type/math :answer/value "2.45" :db/ensure [:answer/validate]} {:db/id "answer-b1f51ad0-f017-5334-b1f9-111993585928" :answer/id #uuid "b1f51ad0-f017-5334-b1f9-111993585928" :answer/type :answer.type/math :answer/value "3.12" :db/ensure [:answer/validate]} {:db/id "question-42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06" :question/id #uuid "42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06" :question/math-academy-id "q-90605" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]≈1.136\\,90,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}x, & 0\\le x<1, \\\\ \\frac{3{x}^{2}}{14}, & 1\\le x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot x\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot \\frac{3{x}^{2}}{14}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{3}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{3{x}^{4}}{14}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{4}|}_{0}^{1}+{\\frac{3{x}^{5}}{70}|}_{1}^{2} \\\\  & =1.578\\,57\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & ≈1.578\\,57-(1.136\\,90)^{2} \\\\  & ≈0.29\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-340fc414-84b2-5d60-ae70-bad6cd5d8dc3"] :db/ensure [:question/validate]} {:db/id "answer-field-340fc414-84b2-5d60-ae70-bad6cd5d8dc3" :answer-field/id #uuid "340fc414-84b2-5d60-ae70-bad6cd5d8dc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" :answer-field/choices ["answer-5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" "answer-f8ba96cd-c44c-5515-a683-4d13c806b5c8" "answer-e04aa9a5-64b5-59f1-8dde-5ebe34bb8a3c" "answer-d4ff1634-fce9-5b8f-a582-81c3cab8ed4d" "answer-98cdc799-45df-57d7-9906-2ddedbe7c5bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" :answer/id #uuid "5d8ed0ae-8c4c-5c40-b9fe-c94e4393c50b" :answer/type :answer.type/math :answer/value "0.29" :db/ensure [:answer/validate]} {:db/id "answer-f8ba96cd-c44c-5515-a683-4d13c806b5c8" :answer/id #uuid "f8ba96cd-c44c-5515-a683-4d13c806b5c8" :answer/type :answer.type/math :answer/value "0.46" :db/ensure [:answer/validate]} {:db/id "answer-e04aa9a5-64b5-59f1-8dde-5ebe34bb8a3c" :answer/id #uuid "e04aa9a5-64b5-59f1-8dde-5ebe34bb8a3c" :answer/type :answer.type/math :answer/value "0.98" :db/ensure [:answer/validate]} {:db/id "answer-d4ff1634-fce9-5b8f-a582-81c3cab8ed4d" :answer/id #uuid "d4ff1634-fce9-5b8f-a582-81c3cab8ed4d" :answer/type :answer.type/math :answer/value "1.34" :db/ensure [:answer/validate]} {:db/id "answer-98cdc799-45df-57d7-9906-2ddedbe7c5bb" :answer/id #uuid "98cdc799-45df-57d7-9906-2ddedbe7c5bb" :answer/type :answer.type/math :answer/value "1.56" :db/ensure [:answer/validate]} {:db/id "question-d36205bb-47f5-5c37-9085-d080474849b2" :question/id #uuid "d36205bb-47f5-5c37-9085-d080474849b2" :question/math-academy-id "q-131169" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{30(x-1)}{{x}^{7}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{5}}-\\frac{30}{{x}^{6}}\\,\\text{d}x \\\\  & =-\\frac{30}{4{x}^{4}}+\\frac{30}{5{x}^{5}}{|}_{1}^{\\infty } \\\\  & =-\\frac{15}{2{x}^{4}}+\\frac{6}{{x}^{5}}{|}_{1}^{\\infty } \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{30(x-1)}{{x}^{7}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30x-30}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{30}{{x}^{4}}-\\frac{30}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{30}{3{x}^{3}}+\\frac{30}{4{x}^{4}}{|}_{1}^{\\infty } \\\\  & =-\\frac{10}{{x}^{3}}+\\frac{15}{2{x}^{4}}{|}_{1}^{\\infty } \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{(\\frac{3}{2})}^{2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-45b92ccf-c96a-52fb-b618-ecc3a61419d1"] :db/ensure [:question/validate]} {:db/id "answer-field-45b92ccf-c96a-52fb-b618-ecc3a61419d1" :answer-field/id #uuid "45b92ccf-c96a-52fb-b618-ecc3a61419d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" :answer-field/choices ["answer-0ee61fd2-c684-57e7-9ea4-f09a8e349764" "answer-cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" "answer-aa206b43-8b04-5867-a4d8-d7210015326b" "answer-08fdd0c6-1d98-54af-82c9-a3de113fe661" "answer-9d9c7297-d71f-5a15-82a4-809b7fbacfeb"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ee61fd2-c684-57e7-9ea4-f09a8e349764" :answer/id #uuid "0ee61fd2-c684-57e7-9ea4-f09a8e349764" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" :answer/id #uuid "cb7d4718-a5a3-5cee-ad89-6d539fb4ecc9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-aa206b43-8b04-5867-a4d8-d7210015326b" :answer/id #uuid "aa206b43-8b04-5867-a4d8-d7210015326b" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-08fdd0c6-1d98-54af-82c9-a3de113fe661" :answer/id #uuid "08fdd0c6-1d98-54af-82c9-a3de113fe661" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9d9c7297-d71f-5a15-82a4-809b7fbacfeb" :answer/id #uuid "9d9c7297-d71f-5a15-82a4-809b7fbacfeb" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "activity-143fe4d3-2189-5558-ab34-db30f0c13f2d" :activity/id #uuid "143fe4d3-2189-5558-ab34-db30f0c13f2d" :activity/title "Variance of Continuous Random Variables" :activity/type :activity.type/review :activity/scope 17592186049786 :activity/course 17592186046658 :activity/steps ["step-27cb2740-d0d9-5281-bada-08690bd45b88" "step-dfc975d2-2b17-5834-9ec2-f3d0328a5946" "step-c4b6fd65-5ab7-5aa6-9e67-5234b1c48ef4" "step-89eecdb2-d635-5827-856f-b37cb0e945a8" "step-0d913b51-4d46-55e2-8d62-53eb1bef16a6"] :activity/first-step "step-27cb2740-d0d9-5281-bada-08690bd45b88" :db/ensure [:activity/validate]} {:db/id "step-27cb2740-d0d9-5281-bada-08690bd45b88" :step/id #uuid "27cb2740-d0d9-5281-bada-08690bd45b88" :step/content 17592186157993 :step/next "step-dfc975d2-2b17-5834-9ec2-f3d0328a5946" :db/ensure [:step/validate]} {:db/id "step-dfc975d2-2b17-5834-9ec2-f3d0328a5946" :step/id #uuid "dfc975d2-2b17-5834-9ec2-f3d0328a5946" :step/content 17592186444792 :step/next "step-c4b6fd65-5ab7-5aa6-9e67-5234b1c48ef4" :db/ensure [:step/validate]} {:db/id "step-c4b6fd65-5ab7-5aa6-9e67-5234b1c48ef4" :step/id #uuid "c4b6fd65-5ab7-5aa6-9e67-5234b1c48ef4" :step/content "question-15966dc5-b8d2-54f2-9092-584d157e0965" :step/next "step-89eecdb2-d635-5827-856f-b37cb0e945a8" :db/ensure [:step/validate]} {:db/id "step-89eecdb2-d635-5827-856f-b37cb0e945a8" :step/id #uuid "89eecdb2-d635-5827-856f-b37cb0e945a8" :step/content "question-42fc75dd-9bd8-5bf5-a346-8dddd7ab3b06" :step/next "step-0d913b51-4d46-55e2-8d62-53eb1bef16a6" :db/ensure [:step/validate]} {:db/id "step-0d913b51-4d46-55e2-8d62-53eb1bef16a6" :step/id #uuid "0d913b51-4d46-55e2-8d62-53eb1bef16a6" :step/content "question-d36205bb-47f5-5c37-9085-d080474849b2" :db/ensure [:step/validate]} [:db/retract 17592186058266 :answer-field/choices 17592186058267] [:db/retract 17592186058266 :answer-field/choices 17592186058268] [:db/retract 17592186058266 :answer-field/choices 17592186058269] [:db/retract 17592186058266 :answer-field/choices 17592186058270] [:db/retract 17592186058266 :answer-field/choices 17592186058271] {:db/id 17592186059634 :knowledge-point/questions ["question-8fda4d22-b124-5945-a801-91535484189e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8fda4d22-b124-5945-a801-91535484189e" :question/id #uuid "8fda4d22-b124-5945-a801-91535484189e" :question/math-academy-id "q-19294" :question/problem "![](images/8d/8d531960f0aa1444b614279f1ab82d8cc01904580e44be331f42d3d28266e1a9.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,4],$ we have a line with a slope of $1$ and $y$-intercept $0.$ So the graph is the line $y=x$ that ends at $(4,4),$ including this point.\n\n- On the interval $(4,\\infty ),$ we have a horizontal line that passes through the point $(4,2).$ So the graph is the line $y=2$ that starts at $(4,2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e1f95f09-2832-5ce0-bed7-f205e739286f"] :db/ensure [:question/validate]} {:db/id "answer-field-e1f95f09-2832-5ce0-bed7-f205e739286f" :answer-field/id #uuid "e1f95f09-2832-5ce0-bed7-f205e739286f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1927365-62c2-515d-9dbf-69034002b056" :answer-field/choices ["answer-fbcec12c-1509-5612-8ee1-be7da7f92471" "answer-3437553e-7766-56dc-b3d3-e9e7c72cc279" "answer-ae152954-f902-53bd-b2ef-b01345a0f0a1" "answer-e34b9c2d-6c57-55bf-8eed-c4819d40f872" "answer-e1927365-62c2-515d-9dbf-69034002b056"] :db/ensure [:answer-field/validate]} {:db/id "answer-fbcec12c-1509-5612-8ee1-be7da7f92471" :answer/id #uuid "fbcec12c-1509-5612-8ee1-be7da7f92471" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x<4 \\\\ 1-x,\\, & x\\ge 4\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-3437553e-7766-56dc-b3d3-e9e7c72cc279" :answer/id #uuid "3437553e-7766-56dc-b3d3-e9e7c72cc279" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x\\le 1 \\\\ x,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-ae152954-f902-53bd-b2ef-b01345a0f0a1" :answer/id #uuid "ae152954-f902-53bd-b2ef-b01345a0f0a1" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2x,\\, & x\\le 4 \\\\ 1,\\, & x>4\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-e34b9c2d-6c57-55bf-8eed-c4819d40f872" :answer/id #uuid "e34b9c2d-6c57-55bf-8eed-c4819d40f872" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}x+1,\\, & x\\le 2 \\\\ 2,\\, & x>2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-e1927365-62c2-515d-9dbf-69034002b056" :answer/id #uuid "e1927365-62c2-515d-9dbf-69034002b056" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}" :db/ensure [:answer/validate]} {:db/id 17592186060274 :question/problem "![](images/d5/d5da28420cf16c4563fbf7188a81b16c4cf8aaa62af39998456fe7016b76aa7d.png)\n\nWhat is the domain of the function $f(x),$ shown above?" :question/worked-solution "The function $f(x)$ above is defined for values between $x=-1$ and $x=5.$\n\n- Since there is a closed circle at $x=5,$ this point is included in the domain.\n\n- On the other hand, because there is an open circle at $x=-1,$ this point is not included in the domain.\n\nSo, the function $f(x)$ above is defined for values between $x=-1$ and $x=5,$ including $x=5$ but not including $x=-1.$\n\nTherefore, the domain is\n\n$$\nx\\in (-1,5].\n$$\n\nNote that the function is defined at the point $x=3,$  even though the function jumps at that point. The function value at $x=3$ is $1.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186058266 :answer-field/correct "answer-28abf02e-9cfb-5f65-a057-166a7d38267e" :answer-field/choices ["answer-45964d38-34b2-5ca7-bf8d-ba29864503fd" "answer-28abf02e-9cfb-5f65-a057-166a7d38267e" "answer-b1e5edc3-eb1e-53e9-97bc-e68a0469e168" "answer-b5858ca0-0bd2-52e8-9b7f-e5453fd6ff79" "answer-6a90e9e5-603c-5e40-922f-d01567889028"] :db/ensure [:answer-field/validate]} {:db/id "answer-45964d38-34b2-5ca7-bf8d-ba29864503fd" :answer/id #uuid "45964d38-34b2-5ca7-bf8d-ba29864503fd" :answer/type :answer.type/math :answer/value "(-1,5)" :db/ensure [:answer/validate]} {:db/id "answer-28abf02e-9cfb-5f65-a057-166a7d38267e" :answer/id #uuid "28abf02e-9cfb-5f65-a057-166a7d38267e" :answer/type :answer.type/math :answer/value "(-1,5]" :db/ensure [:answer/validate]} {:db/id "answer-b1e5edc3-eb1e-53e9-97bc-e68a0469e168" :answer/id #uuid "b1e5edc3-eb1e-53e9-97bc-e68a0469e168" :answer/type :answer.type/math :answer/value "[-1,3)\\cup (3,5]" :db/ensure [:answer/validate]} {:db/id "answer-b5858ca0-0bd2-52e8-9b7f-e5453fd6ff79" :answer/id #uuid "b5858ca0-0bd2-52e8-9b7f-e5453fd6ff79" :answer/type :answer.type/math :answer/value "[-1,5)" :db/ensure [:answer/validate]} {:db/id "answer-6a90e9e5-603c-5e40-922f-d01567889028" :answer/id #uuid "6a90e9e5-603c-5e40-922f-d01567889028" :answer/type :answer.type/math :answer/value "[-1,5]" :db/ensure [:answer/validate]} {:db/id 17592186059633 :knowledge-point/questions ["question-81bf18b7-eab3-5bbd-9ce6-359135969b2e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-81bf18b7-eab3-5bbd-9ce6-359135969b2e" :question/id #uuid "81bf18b7-eab3-5bbd-9ce6-359135969b2e" :question/math-academy-id "q-46785" :question/problem "Given that \n\n$$\nf(x)=\\{\\begin{aligned}1,\\, & x\\le 0 \\\\ -2,\\, & x\\text{ }>0,\\end{aligned}\n$$\n\nwhich of the following is the graph of $y=f(x)?$" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,0],$ we have $f(x)=1,$ so the graph is a horizontal line that ends at $(0,1),$ including this point.\n\n- On the interval $(0,\\infty )$, we have $f(x)=-2,$ so the graph is a horizontal line that begins at $(0,-2),$ excluding this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3dd397f7-5ec0-560f-a03e-535e6aeb3530"] :db/ensure [:question/validate]} {:db/id "answer-field-3dd397f7-5ec0-560f-a03e-535e6aeb3530" :answer-field/id #uuid "3dd397f7-5ec0-560f-a03e-535e6aeb3530" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc16fd87-410b-57e5-8b5c-be56639e5ed1" :answer-field/choices ["answer-b07ed8b7-ba04-5275-a158-92c500ad6e37" "answer-0cccba6b-f470-51dd-b23c-1c518f8d32fe" "answer-dc16fd87-410b-57e5-8b5c-be56639e5ed1" "answer-d89ee78f-3a41-5e1b-82db-a8654f6fdce9" "answer-e3d8f0c9-d1d6-5a68-ad42-ce31393b9535"] :db/ensure [:answer-field/validate]} {:db/id "answer-b07ed8b7-ba04-5275-a158-92c500ad6e37" :answer/id #uuid "b07ed8b7-ba04-5275-a158-92c500ad6e37" :answer/type :answer.type/image :answer/value "images/1a/1aefee3b012fc011ba7a643d92562724e520f78d06553d5ac82ec7226ccd0550.png" :db/ensure [:answer/validate]} {:db/id "answer-0cccba6b-f470-51dd-b23c-1c518f8d32fe" :answer/id #uuid "0cccba6b-f470-51dd-b23c-1c518f8d32fe" :answer/type :answer.type/