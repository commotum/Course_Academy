f-5435-9f47-0d26c955ed36" :answer-field/choices ["answer-a403bf17-2b48-55a3-a928-1f9b4c83a2d3" "answer-7f84ea8c-c7c9-5b77-8633-d538a890dd1d" "answer-bf55f709-9be8-5dd9-85dc-86bd8db6cd9e" "answer-6563e16f-667f-5435-9f47-0d26c955ed36" "answer-d234ef89-b2e5-55ce-8aea-ffb54263f9df"] :db/ensure [:answer-field/validate]} {:db/id "answer-a403bf17-2b48-55a3-a928-1f9b4c83a2d3" :answer/id #uuid "a403bf17-2b48-55a3-a928-1f9b4c83a2d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.12 \\\\ 0.52 \\\\ 0.36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7f84ea8c-c7c9-5b77-8633-d538a890dd1d" :answer/id #uuid "7f84ea8c-c7c9-5b77-8633-d538a890dd1d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.2 \\\\ 0.42 \\\\ 0.56\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bf55f709-9be8-5dd9-85dc-86bd8db6cd9e" :answer/id #uuid "bf55f709-9be8-5dd9-85dc-86bd8db6cd9e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.24 \\\\ 0.32 \\\\ 0.44\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6563e16f-667f-5435-9f47-0d26c955ed36" :answer/id #uuid "6563e16f-667f-5435-9f47-0d26c955ed36" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.24 \\\\ 0.4 \\\\ 0.36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d234ef89-b2e5-55ce-8aea-ffb54263f9df" :answer/id #uuid "d234ef89-b2e5-55ce-8aea-ffb54263f9df" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.28 \\\\ 0.38 \\\\ 0.34\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186124545 :knowledge-point/questions ["question-34952883-ed67-58e1-83a4-6ee369a6dde8" "question-af97554b-6ce7-555f-8ebb-05f560ef6317"] :db/ensure [:knowledge-point/validate]} {:db/id "question-34952883-ed67-58e1-83a4-6ee369a6dde8" :question/id #uuid "34952883-ed67-58e1-83a4-6ee369a6dde8" :question/math-academy-id "q-35847" :question/problem "A certain company produces $2$ types of flour, flour $A$ and flour $B.$ The following table describes how the number of consumers changes between both types of flour each month:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"2\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $A$</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $B$</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"2\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $A$</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.6$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $B$</b></td>\n<td align=\"center\">$0.7$</td>\n<td align=\"center\">$0.4$</td>\n</tr>\n</tbody></table>\n\nThat is, $70%$ of flour $A$ customers switch to flour $B$ each month, and $60%$ of flour $B$ customers change to flour $A.$\n\nCurrently, $6\\,000$ customers use flour $A,$ while $4\\,000$ customers use flour $B.$ How many customers will use flour $A$ in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=[\\begin{aligned}0.3 & 0.6 \\\\ 0.7 & 0.4\\end{aligned}]\n$$\n\nThe vector describing the number of customers for each type of flour is\n\n$$\n[\\begin{aligned}6\\,000 \\\\ 4\\,000\\end{aligned}].\n$$\n\nDividing the vector above by the total number of customers $(10\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{10\\,000}[\\begin{aligned}6\\,000 \\\\ 4\\,000\\end{aligned}]=[\\begin{aligned}0.6 \\\\ 0.4\\end{aligned}]\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.3 & 0.6 \\\\ 0.7 & 0.4\\end{aligned}][\\begin{aligned}0.6 \\\\ 0.4\\end{aligned}] \\\\  & =[\\begin{aligned}0.42 \\\\ 0.58\\end{aligned}].\\end{aligned}\n$$\n\nSo, after one month, $42%$ of customers will use flour $A.$ Computing $42%$ of $10\\,000,$ we obtain\n\n$$\n10\\,000\\cdot 0.42=4\\,200.\n$$\n\nTherefore, $4\\,200$ customers will use flour $A$ in one month." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2b5c355-cad0-5348-8dff-54a6b032b4f8"] :db/ensure [:question/validate]} {:db/id "answer-field-c2b5c355-cad0-5348-8dff-54a6b032b4f8" :answer-field/id #uuid "c2b5c355-cad0-5348-8dff-54a6b032b4f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-40c82cec-2aab-5e87-a7f3-187df9be1327" :answer-field/choices ["answer-105e81b4-ebb0-52a8-aaaf-535d61ac1ba6" "answer-40c82cec-2aab-5e87-a7f3-187df9be1327" "answer-3fc67c9e-b654-57e4-a474-667c5d454cc4" "answer-76ffc93a-e662-59db-8132-6716efe1d93a" "answer-9af91aff-676a-57a8-ab5a-633b6dcd682f"] :db/ensure [:answer-field/validate]} {:db/id "answer-105e81b4-ebb0-52a8-aaaf-535d61ac1ba6" :answer/id #uuid "105e81b4-ebb0-52a8-aaaf-535d61ac1ba6" :answer/type :answer.type/math :answer/value "3\\,800" :db/ensure [:answer/validate]} {:db/id "answer-40c82cec-2aab-5e87-a7f3-187df9be1327" :answer/id #uuid "40c82cec-2aab-5e87-a7f3-187df9be1327" :answer/type :answer.type/math :answer/value "4\\,200" :db/ensure [:answer/validate]} {:db/id "answer-3fc67c9e-b654-57e4-a474-667c5d454cc4" :answer/id #uuid "3fc67c9e-b654-57e4-a474-667c5d454cc4" :answer/type :answer.type/math :answer/value "4\\,500" :db/ensure [:answer/validate]} {:db/id "answer-76ffc93a-e662-59db-8132-6716efe1d93a" :answer/id #uuid "76ffc93a-e662-59db-8132-6716efe1d93a" :answer/type :answer.type/math :answer/value "4\\,800" :db/ensure [:answer/validate]} {:db/id "answer-9af91aff-676a-57a8-ab5a-633b6dcd682f" :answer/id #uuid "9af91aff-676a-57a8-ab5a-633b6dcd682f" :answer/type :answer.type/math :answer/value "5\\,500" :db/ensure [:answer/validate]} {:db/id "question-af97554b-6ce7-555f-8ebb-05f560ef6317" :question/id #uuid "af97554b-6ce7-555f-8ebb-05f560ef6317" :question/math-academy-id "q-135463" :question/problem "A certain store sells three types of instant soups: chicken, meat, and vegetable. The following table describes how the number of customers changes between the three types of instant soups each month:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"3\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Chicken</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Meat</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Vegetable</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"3\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Chicken</b></td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Meat</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Vegetable</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.5$</td>\n</tr>\n</tbody></table>\n\nFor example, $30%$ of chicken soup customers switch to vegetable each month, and $20%$ of vegetable customers switch to meat.\n\nCurrently, $400$ customers buy chicken soup, $400$ customers buy meat soup, and $200$ customers buy vegetable soup. How many customers will purchase vegetable instant soup in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=[\\begin{aligned}0.4 & 0.2 & 0.3 \\\\ 0.3 & 0.4 & 0.2 \\\\ 0.3 & 0.4 & 0.5\\end{aligned}]\n$$\n\nThe vector describing the number of customers for each type of instant soup is\n\n$$\n[\\begin{aligned}400 \\\\ 400 \\\\ 200\\end{aligned}].\n$$\n\nDividing the vector above by the total number of customers $(1\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000}[\\begin{aligned}400 \\\\ 400 \\\\ 200\\end{aligned}]=[\\begin{aligned}0.4 \\\\ 0.4 \\\\ 0.2\\end{aligned}]\n$$\n\nTo find the state vector ${x}_{1}$ after one month, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.4 & 0.2 & 0.3 \\\\ 0.3 & 0.4 & 0.2 \\\\ 0.3 & 0.4 & 0.5\\end{aligned}][\\begin{aligned}0.4 \\\\ 0.4 \\\\ 0.2\\end{aligned}] \\\\  & =[\\begin{aligned}0.3 \\\\ 0.32 \\\\ 0.38\\end{aligned}].\\end{aligned}\n$$\n\nSo, after one month, $38%$ of customers will buy vegetable soup. Computing $38%$ of $1\\,000,$ we obtain\n\n$$\n1\\,000\\cdot 0.38=380.\n$$\n\nTherefore, $380$ customers will buy vegetable instant soup in one month." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d3eedce2-2377-5540-8cff-1c60ab867920"] :db/ensure [:question/validate]} {:db/id "answer-field-d3eedce2-2377-5540-8cff-1c60ab867920" :answer-field/id #uuid "d3eedce2-2377-5540-8cff-1c60ab867920" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0e2774b-270a-55ce-93a5-e9e33d94f09e" :answer-field/choices ["answer-903bfffc-e426-59e3-ab24-11a7979aa4ac" "answer-a380b557-2215-594c-843f-24dc64b7b436" "answer-b0e2774b-270a-55ce-93a5-e9e33d94f09e" "answer-b1a5f251-9496-5266-9006-9a8c00b395c5" "answer-e100991f-d084-5436-83ef-32e93d923689"] :db/ensure [:answer-field/validate]} {:db/id "answer-903bfffc-e426-59e3-ab24-11a7979aa4ac" :answer/id #uuid "903bfffc-e426-59e3-ab24-11a7979aa4ac" :answer/type :answer.type/math :answer/value "300" :db/ensure [:answer/validate]} {:db/id "answer-a380b557-2215-594c-843f-24dc64b7b436" :answer/id #uuid "a380b557-2215-594c-843f-24dc64b7b436" :answer/type :answer.type/math :answer/value "320" :db/ensure [:answer/validate]} {:db/id "answer-b0e2774b-270a-55ce-93a5-e9e33d94f09e" :answer/id #uuid "b0e2774b-270a-55ce-93a5-e9e33d94f09e" :answer/type :answer.type/math :answer/value "380" :db/ensure [:answer/validate]} {:db/id "answer-b1a5f251-9496-5266-9006-9a8c00b395c5" :answer/id #uuid "b1a5f251-9496-5266-9006-9a8c00b395c5" :answer/type :answer.type/math :answer/value "420" :db/ensure [:answer/validate]} {:db/id "answer-e100991f-d084-5436-83ef-32e93d923689" :answer/id #uuid "e100991f-d084-5436-83ef-32e93d923689" :answer/type :answer.type/math :answer/value "450" :db/ensure [:answer/validate]} {:db/id 17592186125800 :tutorial/content "We can use repeated matrix multiplication to determine the state of a system given its initial state and some information about how one state transitions to the next state.\n\nTo explain this concretely, suppose we have a population where people live either in the city or the countryside. A study carried out by the local authority shows that, each year,\n\n- $6\\%$ of the city population relocates to the countryside,\n\n- $3\\%$ of the countryside population relocates to the city, and\n\n- everyone else remains where they are.\n\nThis information can be represented using a diagram, like the one below.\n\n![](images/ab/ab6b3cecac2af22b8665078db56c7daf492c0381434c9c88fe21f2630f743466.png)\n\nWe can also present this information as a table:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"2\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>City</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Countryside</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"2\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>City</b></td>\n<td align=\"center\">$0.94$</td>\n<td align=\"center\">$0.03$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Countryside</b></td>\n<td align=\"center\">$0.06$</td>\n<td align=\"center\">$0.97$</td>\n</tr>\n</tbody></table>\n\nWe want to use this information to determine how the population will be distributed $n$ years after the study was carried out. \n\nFirst, let's turn this table into a matrix $P\\mathbin{:}$\n\n![](images/aa/aa1be872e6f5cdcd842a2f02074f1b9ddd7619697973a2cd06a05f9c1cf9ab75.svg) \n\nNotice that this matrix has the following properties:\n\n- it is a square matrix\n\n- the sum of the entries in each column equals $1$\n\n- all entries in the matrix are non-negative\n\nA square matrix with these properties is called a **stochastic matrix**.\n\nNow suppose that, at the time of the study, $70\\%$ of the population lived in the city and $30\\%$ in the countryside. We can represent this **initial state** using a so-called **stochastic vector** $\\mathbf x_0,$ given by\n\n![](images/35/35a20015fc0e96a78ebf1ea2b8fa49721343279a39a35206d41c5ade0ac78ba8.svg)\n\nStochastic vectors contain non-negative entries only, and the sum of the entries equals $1.$ Note that each column of $P$ is a stochastic vector.\n\nNow that we have our stochastic matrix and initial state vector, we can use matrix multiplication to calculate the population distribution sometime after the initial study took place:\n\n- To calculate the population distribution after one year, we calculate the product $P\\mathbf x_0\\mathbin{:}$\n![](images/93/93e30410bcea9b657efe84dc9c32e5f8b3fd3cff159c41f0196547ac5119c766.svg)\nThe resulting vector \n![](images/4b/4b331a70fadd7c061d20b85bb6a7c144de91880f386691f498b1b417f65fa264.svg)\ntells us that one year after the study, $66.7$% of the population will live in the city, and $33.3$% will live in the countryside.\n\n- To model the distribution after $2$ years, we compute $P\\mathbf x_1\\mathbin{:}$\n![](images/53/53c774ea2bf14c3f98927d468db9d872c90d11bb8a7ce56f70f611e55faffab8.svg)\nThe resulting vector \n![](images/36/363f748dfe8d79023473d0e3a83f331ec6a92a905ddcc9115b675362a6194f1b.svg)\ntells us that two years after the study, $63.7$% of the population will live in the city, and $36.3$% will live in the countryside." :db/ensure [:tutorial/validate]} {:db/id 17592186125801 :tutorial/content "Let's reconsider the population we looked at earlier, where the stochastic vector that represents the initial distribution of people between the city and the countryside is\n\n![](images/a4/a423e2c13f55ff6af245ae6e51c7dfc6618d350f0e6de7ec813db176892be05c.svg)\nand the yearly change in this distribution is represented by the stochastic matrix \n\n![](images/71/714196a216ec63873059d772ce8c548ea644825f62ea32a6047469eaf285a875.svg)\n\nEarlier, we found that the population distribution after $1$ and $2$ years is given by the vectors $\\mathbf x_1$ and $\\mathbf x_2,$ \n respectively, where\n\n![](images/d0/d0b99c9251cef4d82dd48b71d2f4bfc1884f43439a516bd007a1b8ea903c65a5.svg)\n\nand\n\n![](images/48/48982abc258980890c8afd48b2949401e33e2401f8c692e5b1c65b3c4c68705d.svg)\n\nThe vectors $\\mathbf{x}_0, \\mathbf{x}_1, \\mathbf{x}_2, \\ldots$ are called **state vectors**, and $\\mathbf x_0$ is the **initial state**. \n\nTo find the state vector corresponding to the $(k+1)$th year, we left-multiply the state vector corresponding to the $k$th year by $P.$ This gives rise to the following sequence:\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0}, \\\\ {x}_{2} & =P{x}_{1}, \\\\ {x}_{3} & =P{x}_{2}, \\\\ ⋮ & \\,⋮ \\\\ {x}_{k+1} & =P{x}_{k} \\\\ ⋮ & \\,⋮\\end{aligned}\n$$\n\nA sequence of stochastic vectors $\\mathbf{x}_0, \\mathbf{x}_1, \\mathbf{x}_2, \\ldots$ related to a stochastic matrix $P$ in this way is called a **Markov chain**." :db/ensure [:tutorial/validate]} {:db/id 17592186124711 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186184142 :knowledge-point/questions ["question-24a538ad-232b-5718-acdd-ce07c94cc6d5" "question-97834400-1835-5bc3-9180-5bacac383a8e" "question-a7374391-644b-5fe8-92d1-774c6f2685b8" "question-dbced5cb-cb8f-554f-bc5c-eb4739e6f20e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184226 :knowledge-point/questions ["question-4643f6f8-6def-57fc-9f05-9106c1781f57" "question-2e61a3ba-7f7b-576c-9651-31afc3ef6f71" "question-9ecd9133-5002-52de-bbff-55ef2618e8b0" "question-f8787df3-5e2e-5b10-9759-f8010831da06" "question-bb1f9724-9227-5181-ae8d-25a299447d4f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-24a538ad-232b-5718-acdd-ce07c94cc6d5" :question/id #uuid "24a538ad-232b-5718-acdd-ce07c94cc6d5" :question/math-academy-id "q-274506" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{\\sqrt{5}}{3},\\,\\operatorname{cos}⁡u=-\\frac{2}{3},\\,\\operatorname{sin}⁡v=\\frac{5}{6}.\n$$\n\nIf $v$ lies in the first quadrant, then $\\operatorname{sin}⁡(u+v)=${{field-1}}." :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{cos}^{2}⁡v=1-{sin}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(\\frac{5}{6})}^{2} \\\\  & =1-\\frac{{5}^{2}}{{6}^{2}} \\\\  & =1-\\frac{25}{36} \\\\  & =\\frac{36}{36}-\\frac{25}{36} \\\\  & =\\frac{11}{36}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{11}{36}} \\\\  & =\\pm \\frac{\\sqrt{11}}{6}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{cos}⁡v=\\frac{\\sqrt{11}}{6}.\n$$\n\nWe can now apply the sum formula as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{\\sqrt{5}}{3})(\\frac{\\sqrt{11}}{6})+(-\\frac{2}{3})(\\frac{5}{6}) \\\\  & =\\frac{\\sqrt{55}}{18}-\\frac{10}{18} \\\\  & =\\frac{\\sqrt{55}-10}{18}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-82fa694a-25f2-5e7d-ab30-eca894f443f3"] :db/ensure [:question/validate]} {:db/id "answer-field-82fa694a-25f2-5e7d-ab30-eca894f443f3" :answer-field/id #uuid "82fa694a-25f2-5e7d-ab30-eca894f443f3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d4a6ccf5-14ce-5806-ace1-7ca838a6fd7f" :answer-field/choices ["answer-d4a6ccf5-14ce-5806-ace1-7ca838a6fd7f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4a6ccf5-14ce-5806-ace1-7ca838a6fd7f" :answer/id #uuid "d4a6ccf5-14ce-5806-ace1-7ca838a6fd7f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{55}-10}{18}" :db/ensure [:answer/validate]} {:db/id "question-97834400-1835-5bc3-9180-5bacac383a8e" :question/id #uuid "97834400-1835-5bc3-9180-5bacac383a8e" :question/math-academy-id "q-119317" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{\\sqrt{2}}{3},\\,\\operatorname{sin}⁡v=-\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{2}}{2}.\n$$\n\nGiven that $u$ lies in the first quadrant, and\n\n$$\n\\operatorname{sin}⁡(u+v)=\\frac{a-b\\sqrt{1}4}{6},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{sin}⁡v$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{cos}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(\\frac{\\sqrt{2}}{3})}^{2} \\\\  & =1-\\frac{(\\sqrt{2})^{2}}{{3}^{2}} \\\\  & =1-\\frac{2}{9} \\\\  & =\\frac{9}{9}-\\frac{2}{9} \\\\  & =\\frac{9-2}{9} \\\\  & =\\frac{7}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{cos}⁡u=\\frac{\\sqrt{7}}{3}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{\\sqrt{2}}{3})(\\frac{\\sqrt{2}}{2})+(\\frac{\\sqrt{7}}{3})(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{2}{6}-\\frac{\\sqrt{14}}{6} \\\\  & =\\frac{2-1\\sqrt{14}}{6}\\end{aligned}\n$$\n\nFinally, $a=2,b=1,$ and $a+b=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-826a30ca-938a-5809-9560-1e4fb2a1a3e6"] :db/ensure [:question/validate]} {:db/id "answer-field-826a30ca-938a-5809-9560-1e4fb2a1a3e6" :answer-field/id #uuid "826a30ca-938a-5809-9560-1e4fb2a1a3e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-23fabac7-34be-5901-889d-cbd6475a113f" :answer-field/choices ["answer-c7b4e39f-b8d2-5d43-9273-97be2dbccbc3" "answer-9975a3bb-76fc-5c77-ae49-5724d89ccc20" "answer-87f86819-67b7-5681-bbb3-b9db74260b7e" "answer-23fabac7-34be-5901-889d-cbd6475a113f" "answer-13d91780-96a0-5b05-9282-837d0bc5cf2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7b4e39f-b8d2-5d43-9273-97be2dbccbc3" :answer/id #uuid "c7b4e39f-b8d2-5d43-9273-97be2dbccbc3" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-9975a3bb-76fc-5c77-ae49-5724d89ccc20" :answer/id #uuid "9975a3bb-76fc-5c77-ae49-5724d89ccc20" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-87f86819-67b7-5681-bbb3-b9db74260b7e" :answer/id #uuid "87f86819-67b7-5681-bbb3-b9db74260b7e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-23fabac7-34be-5901-889d-cbd6475a113f" :answer/id #uuid "23fabac7-34be-5901-889d-cbd6475a113f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-13d91780-96a0-5b05-9282-837d0bc5cf2f" :answer/id #uuid "13d91780-96a0-5b05-9282-837d0bc5cf2f" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-a7374391-644b-5fe8-92d1-774c6f2685b8" :question/id #uuid "a7374391-644b-5fe8-92d1-774c6f2685b8" :question/math-academy-id "q-141359" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡u=\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{3}}{2}.\n$$\n\nGiven that $v$ lies in the first quadrant, and\n\n$$\n\\operatorname{sin}⁡(u-v)=\\frac{\\sqrt{a}-\\sqrt{b}}{4},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =1-\\frac{(\\sqrt{3})^{2}}{{2}^{2}} \\\\  & =1-\\frac{3}{4} \\\\  & =\\frac{4}{4}-\\frac{3}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{1}{4}} \\\\  & =\\pm \\frac{1}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the first quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{1}{2}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{\\sqrt{2}}{2})(\\frac{\\sqrt{3}}{2})-(\\frac{\\sqrt{2}}{2})(\\frac{1}{2}) \\\\  & =\\frac{\\sqrt{6}}{4}-\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$\n\nFinally, $a=6,b=2,$ and $a+b=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d88de4d6-11e4-59ab-b35f-5b9cbf6e3f93"] :db/ensure [:question/validate]} {:db/id "answer-field-d88de4d6-11e4-59ab-b35f-5b9cbf6e3f93" :answer-field/id #uuid "d88de4d6-11e4-59ab-b35f-5b9cbf6e3f93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-958cbb92-f043-53d1-bb9b-025a90326fd1" :answer-field/choices ["answer-2d409728-f16b-5dbd-989e-4297f678c27d" "answer-bde96f49-8d44-5f49-af06-0fedc038fdc1" "answer-505afb7e-87e3-5258-8fa9-547c7b39ab3f" "answer-4c87b11b-03eb-50d1-a061-8f5cba3a6ef6" "answer-958cbb92-f043-53d1-bb9b-025a90326fd1"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d409728-f16b-5dbd-989e-4297f678c27d" :answer/id #uuid "2d409728-f16b-5dbd-989e-4297f678c27d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-bde96f49-8d44-5f49-af06-0fedc038fdc1" :answer/id #uuid "bde96f49-8d44-5f49-af06-0fedc038fdc1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-505afb7e-87e3-5258-8fa9-547c7b39ab3f" :answer/id #uuid "505afb7e-87e3-5258-8fa9-547c7b39ab3f" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-4c87b11b-03eb-50d1-a061-8f5cba3a6ef6" :answer/id #uuid "4c87b11b-03eb-50d1-a061-8f5cba3a6ef6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-958cbb92-f043-53d1-bb9b-025a90326fd1" :answer/id #uuid "958cbb92-f043-53d1-bb9b-025a90326fd1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-dbced5cb-cb8f-554f-bc5c-eb4739e6f20e" :question/id #uuid "dbced5cb-cb8f-554f-bc5c-eb4739e6f20e" :question/math-academy-id "q-119320" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{\\sqrt{5}}{3},\\,\\operatorname{sin}⁡v=-\\frac{2}{7},\\,\\operatorname{cos}⁡v=-\\frac{3\\sqrt{5}}{7}.\n$$\n\nGiven that $u$ lies in the first quadrant, find the value of $\\operatorname{sin}⁡(u+v).$" :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{sin}⁡v$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{cos}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(\\frac{\\sqrt{5}}{3})}^{2} \\\\  & =1-\\frac{(\\sqrt{5})^{2}}{{3}^{2}} \\\\  & =1-\\frac{5}{9} \\\\  & =\\frac{9}{9}-\\frac{5}{9} \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{4}{9}} \\\\  & =\\pm \\frac{2}{3}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the first quadrant, where cosine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{cos}⁡u=\\frac{2}{3}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{\\sqrt{5}}{3})(-\\frac{3\\sqrt{5}}{7})+(\\frac{2}{3})(-\\frac{2}{7}) \\\\  & =-\\frac{15}{21}-\\frac{4}{21} \\\\  & =-\\frac{19}{21}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3b2f076d-ce9b-57f9-98c4-9fb84d87fd00"] :db/ensure [:question/validate]} {:db/id "answer-field-3b2f076d-ce9b-57f9-98c4-9fb84d87fd00" :answer-field/id #uuid "3b2f076d-ce9b-57f9-98c4-9fb84d87fd00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf06079f-488c-54c6-9f67-6f54375dcb2c" :answer-field/choices ["answer-f4e4f716-0f36-5041-8ce8-3e1332c0fd72" "answer-cf06079f-488c-54c6-9f67-6f54375dcb2c" "answer-dc5c049f-d4ae-506d-8359-38c91b104d66" "answer-77a7b2c9-147e-5fc7-9ea6-9c47b3f3c127" "answer-1f0f4507-f336-56f6-86cc-8b6c67aa2f7b"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4e4f716-0f36-5041-8ce8-3e1332c0fd72" :answer/id #uuid "f4e4f716-0f36-5041-8ce8-3e1332c0fd72" :answer/type :answer.type/math :answer/value "-\\frac{14}{21}" :db/ensure [:answer/validate]} {:db/id "answer-cf06079f-488c-54c6-9f67-6f54375dcb2c" :answer/id #uuid "cf06079f-488c-54c6-9f67-6f54375dcb2c" :answer/type :answer.type/math :answer/value "-\\frac{19}{21}" :db/ensure [:answer/validate]} {:db/id "answer-dc5c049f-d4ae-506d-8359-38c91b104d66" :answer/id #uuid "dc5c049f-d4ae-506d-8359-38c91b104d66" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-77a7b2c9-147e-5fc7-9ea6-9c47b3f3c127" :answer/id #uuid "77a7b2c9-147e-5fc7-9ea6-9c47b3f3c127" :answer/type :answer.type/math :answer/value "\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1f0f4507-f336-56f6-86cc-8b6c67aa2f7b" :answer/id #uuid "1f0f4507-f336-56f6-86cc-8b6c67aa2f7b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{21}" :db/ensure [:answer/validate]} {:db/id "question-4643f6f8-6def-57fc-9f05-9106c1781f57" :question/id #uuid "4643f6f8-6def-57fc-9f05-9106c1781f57" :question/math-academy-id "q-141389" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{3}{4},\\,\\operatorname{cos}⁡u=\\frac{\\sqrt{7}}{4},\\,\\operatorname{sin}⁡v=-\\frac{1}{2}.\n$$\n\nGiven that $v$ lies in the fourth quadrant, and\n\n$$\n\\operatorname{sin}⁡(u+v)=\\frac{a\\sqrt{3}-b\\sqrt{7}}{8},\n$$\n\ncalculate the value of $a+b.$" :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡v$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{cos}^{2}⁡v=1-{sin}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡v & =1-{sin}^{2}⁡v \\\\  & =1-{(-\\frac{1}{2})}^{2} \\\\  & =1-{(\\frac{1}{2})}^{2} \\\\  & =1-\\frac{{1}^{2}}{{2}^{2}} \\\\  & =1-\\frac{1}{4} \\\\  & =\\frac{4}{4}-\\frac{1}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the fourth quadrant, where cosine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{cos}⁡v=\\frac{\\sqrt{3}}{2}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{3}{4})(\\frac{\\sqrt{3}}{2})+(\\frac{\\sqrt{7}}{4})(-\\frac{1}{2}) \\\\  & =\\frac{3\\sqrt{3}}{8}-\\frac{\\sqrt{7}}{8} \\\\  & =\\frac{3\\sqrt{3}-1\\sqrt{7}}{8}\\end{aligned}\n$$\n\nFinally, $a=3,b=1,$ and $a+b=4.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5b2abad3-93fb-5e4a-a512-cc96b4e71bd9"] :db/ensure [:question/validate]} {:db/id "answer-field-5b2abad3-93fb-5e4a-a512-cc96b4e71bd9" :answer-field/id #uuid "5b2abad3-93fb-5e4a-a512-cc96b4e71bd9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f71b7119-0fb5-5212-83f2-49afd258fc8b" :answer-field/choices ["answer-c7d170e4-09b8-54a6-95dc-732e3918ff88" "answer-431f436d-286f-5124-9f57-838cbb663593" "answer-fb6b2054-d008-528a-bf1c-110725aeb7d5" "answer-f71b7119-0fb5-5212-83f2-49afd258fc8b" "answer-d2d301bb-3dab-58d3-b3c7-a4b5e4f95d3e"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7d170e4-09b8-54a6-95dc-732e3918ff88" :answer/id #uuid "c7d170e4-09b8-54a6-95dc-732e3918ff88" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-431f436d-286f-5124-9f57-838cbb663593" :answer/id #uuid "431f436d-286f-5124-9f57-838cbb663593" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-fb6b2054-d008-528a-bf1c-110725aeb7d5" :answer/id #uuid "fb6b2054-d008-528a-bf1c-110725aeb7d5" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f71b7119-0fb5-5212-83f2-49afd258fc8b" :answer/id #uuid "f71b7119-0fb5-5212-83f2-49afd258fc8b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d2d301bb-3dab-58d3-b3c7-a4b5e4f95d3e" :answer/id #uuid "d2d301bb-3dab-58d3-b3c7-a4b5e4f95d3e" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-2e61a3ba-7f7b-576c-9651-31afc3ef6f71" :question/id #uuid "2e61a3ba-7f7b-576c-9651-31afc3ef6f71" :question/math-academy-id "q-326306" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{5}{13},\\,\\operatorname{cos}⁡u=\\frac{12}{13},\\,\\operatorname{cos}⁡v=-\\frac{3}{5}.\n$$\n\nIf $v$ lies in the second quadrant, then $\\operatorname{sin}⁡(u+v)=${{field-1}}." :question/worked-solution "First, recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v$, we use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(-\\frac{3}{5})}^{2} \\\\  & =1-\\frac{{3}^{2}}{{5}^{2}} \\\\  & =1-\\frac{9}{25} \\\\  & =\\frac{25}{25}-\\frac{9}{25} \\\\  & =\\frac{16}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the second quadrant, where sine is positive. So, we disregard the negative value, and we have \n\n$$\n\\operatorname{sin}⁡v=\\frac{4}{5}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{5}{13})(-\\frac{3}{5})+(\\frac{12}{13})(\\frac{4}{5}) \\\\  & =-\\frac{15}{65}+\\frac{48}{65} \\\\  & =\\frac{33}{65}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-598d1261-b549-515b-a77a-1a37d5829749"] :db/ensure [:question/validate]} {:db/id "answer-field-598d1261-b549-515b-a77a-1a37d5829749" :answer-field/id #uuid "598d1261-b549-515b-a77a-1a37d5829749" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9ff4504-ac7a-57d3-a336-b4500ec61972" :answer-field/choices ["answer-a9ff4504-ac7a-57d3-a336-b4500ec61972"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9ff4504-ac7a-57d3-a336-b4500ec61972" :answer/id #uuid "a9ff4504-ac7a-57d3-a336-b4500ec61972" :answer/type :answer.type/math :answer/value "\\frac{33}{65}" :db/ensure [:answer/validate]} {:db/id "question-9ecd9133-5002-52de-bbff-55ef2618e8b0" :question/id #uuid "9ecd9133-5002-52de-bbff-55ef2618e8b0" :question/math-academy-id "q-326383" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{5}{13},\\,\\operatorname{cos}⁡u=\\frac{12}{13},\\,\\operatorname{cos}⁡v=\\frac{3}{4}.\n$$\n\nGiven that $v$ lies in the fourth quadrant, then\n\n| $\\operatorname{sin}⁡(u-v)$ | $=$ | {{field-1}}$\\,\\,+\\,$ {{field-2}}$\\sqrt{7}$ | . |\n| --- | --- | --- | --- |\n|  |  | $52$ |  |" :question/worked-solution "First, we recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{3}{4})}^{2} \\\\  & =1-\\frac{{3}^{2}}{{4}^{2}} \\\\  & =1-\\frac{9}{16} \\\\  & =\\frac{16}{16}-\\frac{9}{16} \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{7}{16}} \\\\  & =\\pm \\frac{\\sqrt{7}}{4}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the fourth quadrant, where sine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{sin}⁡v=-\\frac{\\sqrt{7}}{4}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{5}{13})(\\frac{3}{4})-(\\frac{12}{13})(-\\frac{\\sqrt{7}}{4}) \\\\  & =\\frac{15}{52}+\\frac{12\\sqrt{7}}{52} \\\\  & =\\frac{15+12\\sqrt{7}}{52}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ed949f4a-0931-51ac-8da5-094e551428fd" "answer-field-a7103d3e-80a2-5de4-ac0e-a10a2142cb05"] :db/ensure [:question/validate]} {:db/id "answer-field-ed949f4a-0931-51ac-8da5-094e551428fd" :answer-field/id #uuid "ed949f4a-0931-51ac-8da5-094e551428fd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e1710ed1-4caf-58bf-82be-5d414220e087" :answer-field/choices ["answer-e1710ed1-4caf-58bf-82be-5d414220e087"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1710ed1-4caf-58bf-82be-5d414220e087" :answer/id #uuid "e1710ed1-4caf-58bf-82be-5d414220e087" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-field-a7103d3e-80a2-5de4-ac0e-a10a2142cb05" :answer-field/id #uuid "a7103d3e-80a2-5de4-ac0e-a10a2142cb05" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2a040c0f-a1fd-58ed-aad2-fe5b5cf047d0" :answer-field/choices ["answer-2a040c0f-a1fd-58ed-aad2-fe5b5cf047d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a040c0f-a1fd-58ed-aad2-fe5b5cf047d0" :answer/id #uuid "2a040c0f-a1fd-58ed-aad2-fe5b5cf047d0" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-f8787df3-5e2e-5b10-9759-f8010831da06" :question/id #uuid "f8787df3-5e2e-5b10-9759-f8010831da06" :question/math-academy-id "q-144400" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡v=\\frac{1}{2},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{3}}{2},\\,\\operatorname{cos}⁡u=-\\frac{2}{3}.\n$$\n\nGiven that $u$ lies in the third quadrant, find the value of $\\operatorname{sin}⁡(u-v).$" :question/worked-solution "First, recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡v$, $\\operatorname{cos}⁡v$, and $\\operatorname{cos}⁡u.$ To find the missing value of $\\operatorname{sin}⁡u$, we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{sin}^{2}⁡u=1-{cos}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡u & =1-{cos}^{2}⁡u \\\\  & =1-{(-\\frac{2}{3})}^{2} \\\\  & =1-{(\\frac{2}{3})}^{2} \\\\  & =1-\\frac{{2}^{2}}{{3}^{2}} \\\\  & =1-\\frac{4}{9} \\\\  & =\\frac{9}{9}-\\frac{4}{9} \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡u & =\\pm \\sqrt{\\frac{5}{9}} \\\\  & =\\pm \\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where sine is negative. So, we disregard the positive value, and we have \n\n$$\n\\operatorname{sin}⁡u=-\\frac{\\sqrt{5}}{3}.\n$$\n\nWe can now apply the difference formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{5}}{3})(\\frac{\\sqrt{3}}{2})-(-\\frac{2}{3})(\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{15}}{6}+\\frac{1}{3} \\\\  & =\\frac{2-\\sqrt{15}}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-45d5c494-ab4a-516a-a05d-cf2961b1ecb2"] :db/ensure [:question/validate]} {:db/id "answer-field-45d5c494-ab4a-516a-a05d-cf2961b1ecb2" :answer-field/id #uuid "45d5c494-ab4a-516a-a05d-cf2961b1ecb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc24debd-ea85-5a42-99f4-725ec24bcaa3" :answer-field/choices ["answer-86c77418-8966-566d-a663-c864416cbf71" "answer-dc24debd-ea85-5a42-99f4-725ec24bcaa3" "answer-fb8359f2-1d22-508a-92f8-0e7f72b7d4ae" "answer-fdcce495-5552-55ea-89df-1f5a9fdec70c" "answer-8063e78c-b15b-5158-9362-eae8ddeee9b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-86c77418-8966-566d-a663-c864416cbf71" :answer/id #uuid "86c77418-8966-566d-a663-c864416cbf71" :answer/type :answer.type/math :answer/value "\\frac{2+\\sqrt{15}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-dc24debd-ea85-5a42-99f4-725ec24bcaa3" :answer/id #uuid "dc24debd-ea85-5a42-99f4-725ec24bcaa3" :answer/type :answer.type/math :answer/value "\\frac{2-\\sqrt{15}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-fb8359f2-1d22-508a-92f8-0e7f72b7d4ae" :answer/id #uuid "fb8359f2-1d22-508a-92f8-0e7f72b7d4ae" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{3}-\\sqrt{5}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-fdcce495-5552-55ea-89df-1f5a9fdec70c" :answer/id #uuid "fdcce495-5552-55ea-89df-1f5a9fdec70c" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{5}+\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-8063e78c-b15b-5158-9362-eae8ddeee9b6" :answer/id #uuid "8063e78c-b15b-5158-9362-eae8ddeee9b6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}-2\\sqrt{5}}{6}" :db/ensure [:answer/validate]} {:db/id "question-bb1f9724-9227-5181-ae8d-25a299447d4f" :question/id #uuid "bb1f9724-9227-5181-ae8d-25a299447d4f" :question/math-academy-id "q-326377" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{8}{17},\\,\\operatorname{cos}⁡u=\\frac{15}{17},\\,\\operatorname{cos}⁡v=\\frac{\\sqrt{3}}{2}.\n$$\n\nGiven that $v$ lies in the fourth quadrant, then\n\n| $\\operatorname{sin}⁡(u+v)$ | $=$ | {{field-1}}$\\sqrt{3}\\,-\\,$ {{field-2}} | . |\n| --- | --- | --- | --- |\n|  |  | $34$ |  |" :question/worked-solution "First, we recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u$, $\\operatorname{cos}⁡u$, and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =1-\\frac{(\\sqrt{3})^{2}}{{2}^{2}} \\\\  & =1-\\frac{3}{4} \\\\  & =\\frac{4}{4}-\\frac{3}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{1}{4}} \\\\  & =\\pm \\frac{1}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the fourth quadrant, where sine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{sin}⁡v=-\\frac{1}{2}.\n$$\n\nWe can now apply the sum formula, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u+v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{8}{17})(\\frac{\\sqrt{3}}{2})+(\\frac{15}{17})(-\\frac{1}{2}) \\\\  & =\\frac{8\\sqrt{3}}{34}-\\frac{15}{34} \\\\  & =\\frac{8\\sqrt{3}-15}{34}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ab314b19-c35e-5b2b-9cf9-5dbd3ed37713" "answer-field-24922baa-2702-5f4a-9cd9-809ee303d03c"] :db/ensure [:question/validate]} {:db/id "answer-field-ab314b19-c35e-5b2b-9cf9-5dbd3ed37713" :answer-field/id #uuid "ab314b19-c35e-5b2b-9cf9-5dbd3ed37713" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3fa37d87-2d10-5b67-a6d0-78d0e0a5a54d" :answer-field/choices ["answer-3fa37d87-2d10-5b67-a6d0-78d0e0a5a54d"] :db/ensure [:answer-field/validate]} {:db/id "answer-3fa37d87-2d10-5b67-a6d0-78d0e0a5a54d" :answer/id #uuid "3fa37d87-2d10-5b67-a6d0-78d0e0a5a54d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-24922baa-2702-5f4a-9cd9-809ee303d03c" :answer-field/id #uuid "24922baa-2702-5f4a-9cd9-809ee303d03c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-df83a4e1-66ba-5873-97da-2d74aacdb5f5" :answer-field/choices ["answer-df83a4e1-66ba-5873-97da-2d74aacdb5f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-df83a4e1-66ba-5873-97da-2d74aacdb5f5" :answer/id #uuid "df83a4e1-66ba-5873-97da-2d74aacdb5f5" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id 17592186185347 :tutorial/content "We can compute trigonometric ratios using the sum and difference formulas for sine together with the Pythagorean identity.\n\nLet's suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin v = \\dfrac{3}{5}, \\qquad \\cos v = \\dfrac{4}{5}, \\qquad \\sin u = -\\dfrac{12}{13}.\n$$\n\nHow can we find the value of $\\sin\\left(u - v\\right)$ given that $u$ lies in the third quadrant? \n\nFirst, recall the difference formula for sine:\n\n$$\n\\sin(u-v) = \\sin u \\cos v- \\cos u \\sin v\n$$\n\nWe know the values of $\\sin{v}$, $\\cos{v}$, and $\\sin{u}.$ To find the missing value of $\\cos{u}$, we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(-\\frac{12}{13})}^{2} \\\\  & =1-{(\\frac{12}{13})}^{2} \\\\  & =1-\\frac{{12}^{2}}{{13}^{2}} \\\\  & =1-\\frac{144}{169} \\\\  & =\\frac{169}{169}-\\frac{144}{169} \\\\  & =\\frac{25}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{25}{169}} \\\\  & =\\pm \\frac{5}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have \n\n$$\n\\cos u= -\\dfrac{5}{13}.\n$$\n\nWe can now apply the difference formula as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{12}{13})(\\frac{4}{5})-(-\\frac{5}{13})(\\frac{3}{5}) \\\\  & =-\\frac{48}{65}+\\frac{15}{65} \\\\  & =-\\frac{33}{65}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186184422 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} [:db/retract 17592186156933 :answer-field/choices 17592186156934] [:db/retract 17592186156933 :answer-field/choices 17592186156935] [:db/retract 17592186156933 :answer-field/choices 17592186156936] [:db/retract 17592186156933 :answer-field/choices 17592186156937] [:db/retract 17592186156933 :answer-field/choices 17592186156938] [:db/retract 17592186156969 :answer-field/choices 17592186156970] [:db/retract 17592186156969 :answer-field/choices 17592186156971] [:db/retract 17592186156969 :answer-field/choices 17592186156972] [:db/retract 17592186156969 :answer-field/choices 17592186156973] [:db/retract 17592186156969 :answer-field/choices 17592186156974] {:db/id 17592186157376 :knowledge-point/questions ["question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186158002 :question/problem "In a particular park, the smallest tree is $6$ meters tall, and the tallest tree $10$ meters tall. Assuming that the height of the trees is uniformly distributed, what is the mean height of the trees in this park?" :question/worked-solution "Let $X$ represent the height of a randomly chosen tree. From the problem statement, we know that $X∼U[6,10],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[6,10],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{6+10}{2}=8\n$$\n\nTherefore, the mean height of the trees is $8\\,\\text{m}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186156933 :answer-field/correct "answer-47139a26-d804-59e4-870b-0b5fc3a07282" :answer-field/choices ["answer-6b7576a7-b188-5d29-9666-0430897568db" "answer-d59bb3da-caf8-563a-a85b-45e4f3b2a669" "answer-c6d821b6-c4a4-5a46-ab4d-0167d341c182" "answer-47139a26-d804-59e4-870b-0b5fc3a07282" "answer-b400b317-0cb2-5752-955d-096fd7622908"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b7576a7-b188-5d29-9666-0430897568db" :answer/id #uuid "6b7576a7-b188-5d29-9666-0430897568db" :answer/type :answer.type/math :answer/value "10\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-d59bb3da-caf8-563a-a85b-45e4f3b2a669" :answer/id #uuid "d59bb3da-caf8-563a-a85b-45e4f3b2a669" :answer/type :answer.type/math :answer/value "7.5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-c6d821b6-c4a4-5a46-ab4d-0167d341c182" :answer/id #uuid "c6d821b6-c4a4-5a46-ab4d-0167d341c182" :answer/type :answer.type/math :answer/value "8.5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-47139a26-d804-59e4-870b-0b5fc3a07282" :answer/id #uuid "47139a26-d804-59e4-870b-0b5fc3a07282" :answer/type :answer.type/math :answer/value "8\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-b400b317-0cb2-5752-955d-096fd7622908" :answer/id #uuid "b400b317-0cb2-5752-955d-096fd7622908" :answer/type :answer.type/math :answer/value "9\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186158008 :question/problem "The duration of a podcast episode is uniformly distributed between $25$ and $34$ minutes. What is the expected duration of an episode?" :question/worked-solution "Let $X$ represent the duration of a randomly chosen episode. From the problem statement, we know that $X∼U[25,34],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[25,34],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{25+34}{2}=29.5\n$$\n\nTherefore, the mean duration of an episode is $29.5\\,\\text{min}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186156969 :answer-field/correct "answer-b131d1b8-1bd6-5d83-9081-be839823a988" :answer-field/choices ["answer-0123579c-fcde-53be-aa62-af9baaca87cb" "answer-b131d1b8-1bd6-5d83-9081-be839823a988" "answer-6ec7295d-bea7-5183-ab51-4e003202222f" "answer-94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" "answer-0e945b16-27df-5bf7-9478-2df2eca1e337"] :db/ensure [:answer-field/validate]} {:db/id "answer-0123579c-fcde-53be-aa62-af9baaca87cb" :answer/id #uuid "0123579c-fcde-53be-aa62-af9baaca87cb" :answer/type :answer.type/math :answer/value "25.5\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-b131d1b8-1bd6-5d83-9081-be839823a988" :answer/id #uuid "b131d1b8-1bd6-5d83-9081-be839823a988" :answer/type :answer.type/math :answer/value "29.5\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-6ec7295d-bea7-5183-ab51-4e003202222f" :answer/id #uuid "6ec7295d-bea7-5183-ab51-4e003202222f" :answer/type :answer.type/math :answer/value "30\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" :answer/id #uuid "94dcbe25-a54b-5b5d-bb4f-fe5f90e862e9" :answer/type :answer.type/math :answer/value "34\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id "answer-0e945b16-27df-5bf7-9478-2df2eca1e337" :answer/id #uuid "0e945b16-27df-5bf7-9478-2df2eca1e337" :answer/type :answer.type/math :answer/value "59\\,\\text{min}" :db/ensure [:answer/validate]} {:db/id 17592186157377 :knowledge-point/questions ["question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" "question-48548786-5710-5326-90a5-450f466b1ddc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/id #uuid "ac72fdfc-0b2a-5fb9-aa6a-78fe0b949c39" :question/math-academy-id "q-96924" :question/problem "The minimum time it takes a pizzeria to deliver an order is $15$ minutes, and the maximum time is $27$ minutes. If the delivery time is uniformly distributed, what is the variance in the delivery time?" :question/worked-solution "Let $X$ represent the time it takes to deliver a randomly selected order. From the problem statement, we know that $X∼U[15,27],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[15,27],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(27-15)^{2}}{12}=\\frac{144}{12}=12\n$$\n\nTherefore, the variance of the delivery time is $12\\,{\\text{min}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1"] :db/ensure [:question/validate]} {:db/id "answer-field-5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/id #uuid "5c06d34a-873f-5c1f-bb8a-cc928f9a21e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-709591d7-8631-5657-ba16-1f8436e9bee0" :answer-field/choices ["answer-709591d7-8631-5657-ba16-1f8436e9bee0" "answer-5e7bba96-7ecb-5799-909c-4e38cab89914" "answer-c142bb8b-582e-511f-a12d-8d39875ecb37" "answer-1f7cf9b6-d296-5917-b91b-a3922654ec0e" "answer-06b6b883-644f-5240-86cf-2f01bd1dd15d"] :db/ensure [:answer-field/validate]} {:db/id "answer-709591d7-8631-5657-ba16-1f8436e9bee0" :answer/id #uuid "709591d7-8631-5657-ba16-1f8436e9bee0" :answer/type :answer.type/math :answer/value "12\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5e7bba96-7ecb-5799-909c-4e38cab89914" :answer/id #uuid "5e7bba96-7ecb-5799-909c-4e38cab89914" :answer/type :answer.type/math :answer/value "14\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c142bb8b-582e-511f-a12d-8d39875ecb37" :answer/id #uuid "c142bb8b-582e-511f-a12d-8d39875ecb37" :answer/type :answer.type/math :answer/value "15\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1f7cf9b6-d296-5917-b91b-a3922654ec0e" :answer/id #uuid "1f7cf9b6-d296-5917-b91b-a3922654ec0e" :answer/type :answer.type/math :answer/value "17\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-06b6b883-644f-5240-86cf-2f01bd1dd15d" :answer/id #uuid "06b6b883-644f-5240-86cf-2f01bd1dd15d" :answer/type :answer.type/math :answer/value "27\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-48548786-5710-5326-90a5-450f466b1ddc" :question/id #uuid "48548786-5710-5326-90a5-450f466b1ddc" :question/math-academy-id "q-96951" :question/problem "A publisher has noticed that the minimum time needed to review a book is $115$ working days, and the maximum time is $235$ days. Assuming that the review time is uniformly distributed, what is the variance of the time needed to review a book?" :question/worked-solution "Let $X$ represent the time needed to review a randomly chosen book. From the problem statement, we know that $X∼U[115,235],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[115,235],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(235-115)^{2}}{12}=\\frac{14400}{12}=1200\n$$\n\nTherefore, the variance of the reviewing time is $1200\\,{\\text{days}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df"] :db/ensure [:question/validate]} {:db/id "answer-field-35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/id #uuid "35c0c28d-17f3-5232-805f-c8fc73f618df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer-field/choices ["answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" "answer-569bb1a3-cf81-5eea-ac47-49251694875a" "answer-a2432121-4603-59ed-a77f-958b0b8a2440" "answer-a07b88e6-0271-544e-b9c5-d07b293f86d1" "answer-3425537f-a9ce-571f-98b5-9007a9fdef43"] :db/ensure [:answer-field/validate]} {:db/id "answer-322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/id #uuid "322599c7-5fb6-5a1a-a0e3-86699496d4dc" :answer/type :answer.type/math :answer/value "1200\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-569bb1a3-cf81-5eea-ac47-49251694875a" :answer/id #uuid "569bb1a3-cf81-5eea-ac47-49251694875a" :answer/type :answer.type/math :answer/value "1215\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a2432121-4603-59ed-a77f-958b0b8a2440" :answer/id #uuid "a2432121-4603-59ed-a77f-958b0b8a2440" :answer/type :answer.type/math :answer/value "1235\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a07b88e6-0271-544e-b9c5-d07b293f86d1" :answer/id #uuid "a07b88e6-0271-544e-b9c5-d07b293f86d1" :answer/type :answer.type/math :answer/value "1350\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-3425537f-a9ce-571f-98b5-9007a9fdef43" :answer/id #uuid "3425537f-a9ce-571f-98b5-9007a9fdef43" :answer/type :answer.type/math :answer/value "1500\\,{\\text{days}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/id #uuid "9d49aabd-7000-5cc9-aab2-77d9e81c75f5" :question/math-academy-id "q-170688" :question/problem "The earliest that a football fan arrives at a match is $15$ minutes before the beginning of the match, and the latest that they arrive is $5$ minutes late. If the arrival times are uniformly distributed, what is the mean arrival time?" :question/worked-solution "Let $X$ represent the arrival time of a randomly chosen fan relative to the beginning of the match. From the problem statement, we know that $X∼U[-15,5],$ and we wish to compute $\\text{E}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following expected value:\n\n$$\n\\text{E}[X]=\\frac{a+b}{2}\n$$\n\nSo, for our random variable $X∼U[-15,5],$ we have the following expected value:\n\n$$\n\\text{E}[X]=\\frac{-15+5}{2}=-5\n$$\n\nTherefore, the mean arrival time is $5$ minutes before the beginning of the match." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-203f41b3-95ad-561c-b021-f76cc9d25199"] :db/ensure [:question/validate]} {:db/id "answer-field-203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/id #uuid "203f41b3-95ad-561c-b021-f76cc9d25199" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56" :answer-field/choices ["answer-ffcbb2d4-ba30-5383-bede-f139f251ad55" "answer-00a603bf-395b-559a-a676-83b6de7d673a" "answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" "answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b" "answer-ab957bdc-f463-5d79-a1f5-559b1eef4e56"] :db/ensure [:answer-field/validate]} {:db/id "answer-ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/id #uuid "ffcbb2d4-ba30-5383-bede-f139f251ad55" :answer/type :answer.type/text :answer/value "$10$ minutes before the beginning of the match" :db/ensure [:answer/validate]} {:db/id "answer-00a603bf-395b-559a-a676-83b6de7d673a" :answer/id #uuid "00a603bf-395b-559a-a676-83b6de7d673a" :answer/type :answer.type/text :answer/value "$15$ minutes before the beginning of the match" :db/ensure [:answer/validate]} {:db/id "answer-b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/id #uuid "b4cf7291-6aec-5175-a62d-fc2ac7cc99e9" :answer/type :answer.type/text :answer/value "$3$ minutes after the beginning of the match" :db/ensure [:answer/validate]} {:db/id "answer-66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/id #uuid "66cd71ac-bd10-5eb8-9b40-0347cef6a18b" :answer/type :answer.type/text :answer/value "$5$ minutes after the beginning of the match" :db/ensure [:answer/validate]} {:db/id "answer-ab957bdc