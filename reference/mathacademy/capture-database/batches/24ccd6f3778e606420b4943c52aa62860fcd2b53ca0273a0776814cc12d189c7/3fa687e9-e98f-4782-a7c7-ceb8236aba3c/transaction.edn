-935c-3bd9615919f8" :activity/id #uuid "50cb0aa0-643b-56c3-935c-3bd9615919f8" :activity/title "Computing the Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186049462 :activity/course 17592186046658 :activity/steps ["step-e1d62f93-fbf5-5e4e-9d59-00beb82dc703" "step-42d7236d-92fe-52f5-8b19-b1b09a4e3d89" "step-32d51e09-dfa1-5fdb-a2f2-601b26efdfc6" "step-0f51217a-fd5d-5fe6-b533-50d56f781766" "step-52507521-8d80-5625-b78a-9c6bf63ea91d"] :activity/first-step "step-e1d62f93-fbf5-5e4e-9d59-00beb82dc703" :db/ensure [:activity/validate]} {:db/id "step-e1d62f93-fbf5-5e4e-9d59-00beb82dc703" :step/id #uuid "e1d62f93-fbf5-5e4e-9d59-00beb82dc703" :step/content 17592186368913 :step/next "step-42d7236d-92fe-52f5-8b19-b1b09a4e3d89" :db/ensure [:step/validate]} {:db/id "step-42d7236d-92fe-52f5-8b19-b1b09a4e3d89" :step/id #uuid "42d7236d-92fe-52f5-8b19-b1b09a4e3d89" :step/content 17592186415574 :step/next "step-32d51e09-dfa1-5fdb-a2f2-601b26efdfc6" :db/ensure [:step/validate]} {:db/id "step-32d51e09-dfa1-5fdb-a2f2-601b26efdfc6" :step/id #uuid "32d51e09-dfa1-5fdb-a2f2-601b26efdfc6" :step/content 17592186415577 :step/next "step-0f51217a-fd5d-5fe6-b533-50d56f781766" :db/ensure [:step/validate]} {:db/id "step-0f51217a-fd5d-5fe6-b533-50d56f781766" :step/id #uuid "0f51217a-fd5d-5fe6-b533-50d56f781766" :step/content 17592186415578 :step/next "step-52507521-8d80-5625-b78a-9c6bf63ea91d" :db/ensure [:step/validate]} {:db/id "step-52507521-8d80-5625-b78a-9c6bf63ea91d" :step/id #uuid "52507521-8d80-5625-b78a-9c6bf63ea91d" :step/content 17592186367540 :db/ensure [:step/validate]} {:db/id 17592186147475 :knowledge-point/questions ["question-1818fb31-e6dd-51ed-98a5-48141bc40666"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1818fb31-e6dd-51ed-98a5-48141bc40666" :question/id #uuid "1818fb31-e6dd-51ed-98a5-48141bc40666" :question/math-academy-id "q-318203" :question/problem "When a new app was first launched, it had $60$ downloads. An exponential model estimates that at the end of each day after launch, the number of downloads increased by $120%$ of the number of downloads at the end of the previous day.\n\nWhich of the following equations best represents this model, where $D$ is the estimated number of downloads $t$ days after the app was launched, and $t\\le 7?$" :question/worked-solution "The number of downloads $D(t)$ grows exponentially with a growth rate of $120%.$\n\nLet's write down what we know:\n\n- $a=60$ is the total number of downloads initially\n\n- $r=1.2$ is the growth rate ($120%$ expressed as a decimal)\n\n- $t=$ the time (in days) after launch\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\nD=a(1+r)^{t}.\n$$\n\nTherefore, the correct expression for $D(t)$ is\n\n$$\nD=60\\cdot (1+1.2)^{t}.\n$$\n\nSimplifying the above, we get\n\n$$\nD(t)=60\\cdot (2.2)^{t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c306525f-8dcb-5d5f-ac56-1625bc0e3733"] :db/ensure [:question/validate]} {:db/id "answer-field-c306525f-8dcb-5d5f-ac56-1625bc0e3733" :answer-field/id #uuid "c306525f-8dcb-5d5f-ac56-1625bc0e3733" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f15b3e3b-3933-5a12-84e9-ce050c7c09a3" :answer-field/choices ["answer-a925509f-f08c-58a9-b080-19cb6b1fa0ce" "answer-ae522b8c-fb7c-5e53-b9b0-80eb9a9e7dfa" "answer-8cc1db70-ceb5-5077-8253-f53025313cf1" "answer-f15b3e3b-3933-5a12-84e9-ce050c7c09a3" "answer-80a4e79f-f5e3-5dea-8677-36fb735e95bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-a925509f-f08c-58a9-b080-19cb6b1fa0ce" :answer/id #uuid "a925509f-f08c-58a9-b080-19cb6b1fa0ce" :answer/type :answer.type/math :answer/value "D(t)=60\\cdot (0.2)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-ae522b8c-fb7c-5e53-b9b0-80eb9a9e7dfa" :answer/id #uuid "ae522b8c-fb7c-5e53-b9b0-80eb9a9e7dfa" :answer/type :answer.type/math :answer/value "D(t)=60\\cdot (1.2)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-8cc1db70-ceb5-5077-8253-f53025313cf1" :answer/id #uuid "8cc1db70-ceb5-5077-8253-f53025313cf1" :answer/type :answer.type/math :answer/value "D(t)=60\\cdot (12)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-f15b3e3b-3933-5a12-84e9-ce050c7c09a3" :answer/id #uuid "f15b3e3b-3933-5a12-84e9-ce050c7c09a3" :answer/type :answer.type/math :answer/value "D(t)=60\\cdot (2.2)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-80a4e79f-f5e3-5dea-8677-36fb735e95bb" :answer/id #uuid "80a4e79f-f5e3-5dea-8677-36fb735e95bb" :answer/type :answer.type/math :answer/value "D(t)=60\\cdot (22)^{t}" :db/ensure [:answer/validate]} {:db/id 17592186073742 :knowledge-point/questions ["question-bc6c1cea-fda3-5da9-9a26-2a572a4b6650"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bc6c1cea-fda3-5da9-9a26-2a572a4b6650" :question/id #uuid "bc6c1cea-fda3-5da9-9a26-2a572a4b6650" :question/math-academy-id "q-171875" :question/problem "![](images/d2/d29179efa4eaaf77d34a7c044e82c8a6bf053763adf829b83207b652d39fa531.png)\n\nIn the figure above, $m∠B=${{field-1}}${}^{∘}.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{74}^{∘}+(3x+{2}^{∘})+(4x-{1}^{∘}) & ={180}^{∘} \\\\ {75}^{∘}+7x & ={180}^{∘} \\\\ 7x & ={105}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nm∠B=3x+{2}^{∘}=3({15}^{∘})+{2}^{∘}={47}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cf5500f0-2865-526a-8496-9b3d246cba65"] :db/ensure [:question/validate]} {:db/id "answer-field-cf5500f0-2865-526a-8496-9b3d246cba65" :answer-field/id #uuid "cf5500f0-2865-526a-8496-9b3d246cba65" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6b1dd17e-6a46-5835-a89d-5170c527c7f9" :answer-field/choices ["answer-6b1dd17e-6a46-5835-a89d-5170c527c7f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b1dd17e-6a46-5835-a89d-5170c527c7f9" :answer/id #uuid "6b1dd17e-6a46-5835-a89d-5170c527c7f9" :answer/type :answer.type/math :answer/value "47" :db/ensure [:answer/validate]} {:db/id 17592186073882 :knowledge-point/questions ["question-14d57c7d-ff6e-530b-b67b-f43cfc293439"] :db/ensure [:knowledge-point/validate]} {:db/id "question-14d57c7d-ff6e-530b-b67b-f43cfc293439" :question/id #uuid "14d57c7d-ff6e-530b-b67b-f43cfc293439" :question/math-academy-id "q-92838" :question/problem "The ratio of the width of a volleyball court to its length is $\\frac{1}{2}.$ If the length of the volleyball court is $18$ meters, what is its width?" :question/worked-solution "The ratio of width to length is $\\frac{1}{2}.$\n\nIn this fraction, the numerator represents the width and the denominator represents the length.\n\nWe can make a denominator of $18$ by multiplying the numerator and denominator by $9$:\n\n$$\n\\frac{1\\times 9}{2\\times 9}=\\frac{9}{18}\n$$\n\nTherefore, the width of the volleyball court is $9$ meters." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2ec32fd6-a036-5546-a09f-d04ace386339"] :db/ensure [:question/validate]} {:db/id "answer-field-2ec32fd6-a036-5546-a09f-d04ace386339" :answer-field/id #uuid "2ec32fd6-a036-5546-a09f-d04ace386339" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b9811572-1c25-5655-8a5c-e49f5bdc3be6" :answer-field/choices ["answer-0d5e8c8f-f6e7-56e5-8a31-fc7adcc316f0" "answer-4a070890-c9f5-5a17-980a-3eb585400e7e" "answer-2d244888-b2c9-5337-8e94-586debfc6129" "answer-cde15c88-15bc-555a-ab11-1026e804b48c" "answer-b9811572-1c25-5655-8a5c-e49f5bdc3be6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d5e8c8f-f6e7-56e5-8a31-fc7adcc316f0" :answer/id #uuid "0d5e8c8f-f6e7-56e5-8a31-fc7adcc316f0" :answer/type :answer.type/text :answer/value "$10$ meters" :db/ensure [:answer/validate]} {:db/id "answer-4a070890-c9f5-5a17-980a-3eb585400e7e" :answer/id #uuid "4a0