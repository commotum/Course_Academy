id "step-1acb24af-8a42-51d8-8a03-c0d4e0e8b691" :step/id #uuid "1acb24af-8a42-51d8-8a03-c0d4e0e8b691" :step/content 17592186499566 :step/next "step-88415712-6ca6-5d4f-8f7d-fb43371cec32" :db/ensure [:step/validate]} {:db/id "step-88415712-6ca6-5d4f-8f7d-fb43371cec32" :step/id #uuid "88415712-6ca6-5d4f-8f7d-fb43371cec32" :step/content 17592186427624 :step/next "step-c43d7d78-510c-596a-aa28-5bc75b281ee3" :db/ensure [:step/validate]} {:db/id "step-c43d7d78-510c-596a-aa28-5bc75b281ee3" :step/id #uuid "c43d7d78-510c-596a-aa28-5bc75b281ee3" :step/content 17592186499537 :step/next "step-93d6f3db-b150-51e3-9b51-d278e0b21603" :db/ensure [:step/validate]} {:db/id "step-93d6f3db-b150-51e3-9b51-d278e0b21603" :step/id #uuid "93d6f3db-b150-51e3-9b51-d278e0b21603" :step/content 17592186499561 :db/ensure [:step/validate]} {:db/id 17592186083365 :knowledge-point/questions ["question-da211e88-d789-5f6a-b87d-2366e18b07f4" "question-0f16c2b9-1c8b-50a4-93ab-bbcc2578659f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-da211e88-d789-5f6a-b87d-2366e18b07f4" :question/id #uuid "da211e88-d789-5f6a-b87d-2366e18b07f4" :question/math-academy-id "q-5991" :question/problem "$1-\\operatorname{sin}⁡{30}^{∘}=$" :question/worked-solution "The angle ${30}^{∘}$ is special, and its sine has the value\n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1-\\operatorname{sin}⁡{30}^{∘} & = \\\\ 1-\\frac{1}{2} & = \\\\ \\frac{1}{2} & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-edfb1d06-ff84-5a5e-b3ca-4378a3fc65ab"] :db/ensure [:question/validate]} {:db/id "answer-field-edfb1d06-ff84-5a5e-b3ca-4378a3fc65ab" :answer-field/id #uuid "edfb1d06-ff84-5a5e-b3ca-4378a3fc65ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" :answer-field/choices ["answer-7fee911c-477b-55c3-9770-f92077500b94" "answer-9d2f2ca5-e104-5920-9146-0e49e1295162" "answer-5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" "answer-7ea00391-81e6-5aa5-92c3-aab074a102d5" "answer-a898a109-7268-53b6-8036-8d9cf20ccf01"] :db/ensure [:answer-field/validate]} {:db/id "answer-7fee911c-477b-55c3-9770-f92077500b94" :answer/id #uuid "7fee911c-477b-55c3-9770-f92077500b94" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9d2f2ca5-e104-5920-9146-0e49e1295162" :answer/id #uuid "9d2f2ca5-e104-5920-9146-0e49e1295162" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" :answer/id #uuid "5ae499bb-bf8f-5fc4-aec9-2dc9bdb9a4df" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7ea00391-81e6-5aa5-92c3-aab074a102d5" :answer/id #uuid "7ea00391-81e6-5aa5-92c3-aab074a102d5" :answer/type :answer.type/math :answer/value "\\frac{2-\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a898a109-7268-53b6-8036-8d9cf20ccf01" :answer/id #uuid "a898a109-7268-53b6-8036-8d9cf20ccf01" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "question-0f16c2b9-1c8b-50a4-93ab-bbcc2578659f" :question/id #uuid "0f16c2b9-1c8b-50a4-93ab-bbcc2578659f" :question/math-academy-id "q-5994" :question/problem "$3{tan}^{2}⁡{30}^{∘}-\\operatorname{tan}⁡{45}^{∘}=$" :question/worked-solution "The angles ${30}^{∘}$ and ${45}^{∘}$ are special, and their trigonometric ratios have the  values\n\n$$\n\\operatorname{tan}⁡{30}^{∘}=\\frac{\\sqrt{3}}{3},\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nAlso, note that ${tan}^{2}⁡{30}^{∘}$ simply means $(\\operatorname{tan}⁡{30}^{∘})^{2}.$\n\nTherefore,\n\n$$\n\\begin{aligned}3{tan}^{2}⁡{30}^{∘}-\\operatorname{tan}⁡{45}^{∘} & = \\\\ 3{(\\operatorname{tan}⁡{30}^{∘})}^{2}-\\operatorname{tan}⁡{45}^{∘} & = \\\\ 3{(\\frac{\\sqrt{3}}{3})}^{2}-1 & = \\\\ 3(\\frac{3}{9})-1 & = \\\\ 1-1 & = \\\\ 0 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2"] :db/ensure [:question/validate]} {:db/id "answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/id #uuid "c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer-field/choices ["answer-847735f3-85e7-556f-ab13-996c4f671091" "answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" "answer-52b2408a-7f36-5c00-b12f-5d5d12445119" "answer-7676748a-b3e1-574b-8bbc-7af2c704efdc" "answer-420931a7-bfe9-57fd-be28-96ee8c3e7a3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-847735f3-85e7-556f-ab13-996c4f671091" :answer/id #uuid "847735f3-85e7-556f-ab13-996c4f671091" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/id #uuid "8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/id #uuid "52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/id #uuid "7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}-1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/id #uuid "420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/type :answer.type/math :answer/value "\\sqrt{3}-1" :db/ensure [:answer/validate]} {:db/id 17592186083366 :knowledge-point/questions ["question-602ff191-9fc8-5da7-a56d-e21a1e6c8aee"] :db/ensure [:knowledge-point/validate]} {:db/id "question-602ff191-9fc8-5da7-a56d-e21a1e6c8aee" :question/id #uuid "602ff191-9fc8-5da7-a56d-e21a1e6c8aee" :question/math-academy-id "q-28935" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{30}^{∘}+\\operatorname{tan}⁡{0}^{∘}=$" :question/worked-solution "The angles ${45}^{∘},$ ${30}^{∘}$ and ${0}^{∘}$ are special angles, and their trigonometric ratios have the values\n\n$$\n\\operatorname{tan}⁡{45}^{∘}=1,\\,\\operatorname{tan}⁡{30}^{∘}=\\frac{\\sqrt{3}}{3},\\,\\operatorname{tan}⁡{0}^{∘}=0.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{30}^{∘}+\\operatorname{tan}⁡{0}^{∘} & = \\\\ 1+\\frac{\\sqrt{3}}{3}+0 & = \\\\ \\frac{3+\\sqrt{3}}{3}. & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ce869806-ba63-5a18-8a07-5e15d5ad7298"] :db/ensure [:question/validate]} {:db/id "answer-field-ce869806-ba63-5a18-8a07-5e15d5ad7298" :answer-field/id #uuid "ce869806-ba63-5a18-8a07-5e15d5ad7298" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4fc67d17-be4b-5361-a70d-ecc1ca22279a" :answer-field/choices ["answer-860778fd-bed5-5bee-ad73-89d756a4e533" "answer-499727a0-3e5b-5bde-ab2e-9a316650fcf2" "answer-4fc67d17-be4b-5361-a70d-ecc1ca22279a" "answer-e6954fa0-b6f7-5d60-9121-9e71a1f8c744" "answer-e80bfc0b-e9a2-5c8d-b1f4-256775d3038c"] :db/ensure [:answer-field/validate]} {:db/id "answer-860778fd-bed5-5bee-ad73-89d756a4e533" :answer/id #uuid "860778fd-bed5-5bee-ad73-89d756a4e533" :answer/type :answer.type/math :answer/value "\\frac{2+\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-499727a0-3e5b-5bde-ab2e-9a316650fcf2" :answer/id #uuid "499727a0-3e5b-5bde-ab2e-9a316650fcf2" :answer/type :answer.type/math :answer/value "\\frac{2+\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-4fc67d17-be4b-5361-a70d-ecc1ca22279a" :answer/id #uuid "4fc67d17-be4b-5361-a70d-ecc1ca22279a" :answer/type :answer.type/math :answer/value "\\frac{3+\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-e6954fa0-b6f7-5d60-9121-9e71a1f8c744" :answer/id #uuid "e6954fa0-b6f7-5d60-9121-9e71a1f8c744" :answer/type :answer.type/math :answer/value "\\frac{4+\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e80bfc0b-e9a2-5c8d-b1f4-256775d3038c" :answer/id #uuid "e80bfc0b-e9a2-5c8d-b1f4-256775d3038c" :answer/type :answer.type/math :answer/value "\\frac{4+\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186083367 :knowledge-point/questions ["question-aec99370-575e-52b4-9e36-bb43c957f2bf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083631 :question/problem "$\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡{90}^{∘}=${{field-1}}" :question/worked-solution "The angles of ${60}^{∘}$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{cos}⁡{60}^{∘}=\\frac{1}{2},\\,\\operatorname{sin}⁡{90}^{∘}=1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡{90}^{∘} & = \\\\ \\frac{1}{2}+1 & = \\\\ \\frac{3}{2}. & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186080782 :answer-field/correct "answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer-field/choices ["answer-0808b740-b9a6-53e0-b0ca-072927115f09"] :db/ensure [:answer-field/validate]} {:db/id "answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer/id #uuid "0808b740-b9a6-53e0-b0ca-072927115f09" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/id #uuid "aec99370-575e-52b4-9e36-bb43c957f2bf" :question/math-academy-id "q-266852" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘}=${{field-1}}" :question/worked-solution "The angles of ${0}^{∘},$ ${45}^{∘},$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{sin}⁡{90}^{∘}=1,\\,\\operatorname{tan}⁡{0}^{∘}=0,\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘} & = \\\\ 1+0-1 & = \\\\ 0. & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771"] :db/ensure [:question/validate]} {:db/id "answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/id #uuid "2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer-field/choices ["answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709"] :db/ensure [:answer-field/validate]} {:db/id "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/id #uuid "8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-a10d6d36-1f91-5420-9d67-cff0214d8f55" :activity/id #uuid "a10d6d36-1f91-5420-9d67-cff0214d8f55" :activity/title "Special Trigonometric Ratios" :activity/type :activity.type/review :activity/scope 17592186050847 :activity/course 17592186046647 :activity/steps ["step-5b7dbe22-dc0d-54cb-b4df-f39f966687ed" "step-9adf5944-13ef-501f-b0c3-0fc0d68be6fd" "step-306a8d26-1ef7-5b4b-a318-0b8e137317b1" "step-2d08ae5a-3900-5a4e-830c-45eae619438c" "step-8d66e22f-32f8-524d-9151-c3676a742fc5"] :activity/first-step "step-5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :db/ensure [:activity/validate]} {:db/id "step-5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :step/id #uuid "5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :step/content "question-da211e88-d789-5f6a-b87d-2366e18b07f4" :step/next "step-9adf5944-13ef-501f-b0c3-0fc0d68be6fd" :db/ensure [:step/validate]} {:db/id "step-9adf5944-13ef-501f-b0c3-0fc0d68be6fd" :step/id #uuid "9adf5944-13ef-501f-b0c3-0fc0d68be6fd" :step/content "question-0f16c2b9-1c8b-50a4-93ab-bbcc2578659f" :step/next "step-306a8d26-1ef7-5b4b-a318-0b8e137317b1" :db/ensure [:step/validate]} {:d