:step/validate]} {:db/id "step-90d440b1-77fd-57a5-b7b7-bc29251c9577" :step/id #uuid "90d440b1-77fd-57a5-b7b7-bc29251c9577" :step/content "question-2310204a-fdf5-57d1-9e96-98189fedc070" :step/next "step-a1c627f2-8e5c-5d6d-9e77-16402055855b" :db/ensure [:step/validate]} {:db/id "step-a1c627f2-8e5c-5d6d-9e77-16402055855b" :step/id #uuid "a1c627f2-8e5c-5d6d-9e77-16402055855b" :step/content "question-17a8497e-763c-5804-a8ea-e63d106be3fe" :step/next "step-1917119d-a3c7-5df2-a185-1f304577335a" :db/ensure [:step/validate]} {:db/id "step-1917119d-a3c7-5df2-a185-1f304577335a" :step/id #uuid "1917119d-a3c7-5df2-a185-1f304577335a" :step/content 17592186259845 :step/next "step-398a54a2-4081-54b9-91fa-06fdfcf9e9d3" :db/ensure [:step/validate]} {:db/id "step-398a54a2-4081-54b9-91fa-06fdfcf9e9d3" :step/id #uuid "398a54a2-4081-54b9-91fa-06fdfcf9e9d3" :step/content 17592186414783 :db/ensure [:step/validate]} {:db/id 17592186221436 :knowledge-point/questions ["question-002b6494-db6e-5c52-baa6-f8349498d2c1" "question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28"] :db/ensure [:knowledge-point/validate]} {:db/id "question-002b6494-db6e-5c52-baa6-f8349498d2c1" :question/id #uuid "002b6494-db6e-5c52-baa6-f8349498d2c1" :question/math-academy-id "q-331789" :question/problem "Consider a function $r(t)$ such that its Laplace transform is $L\\{r(t)\\}=R(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{3t}r(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{3t}r(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,r(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{3t}r(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{3t}\\,r(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-3)t}\\,r(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $R(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,r(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-3)t}\\,r(t)\\,\\text{d}t=R(s-3),\n$$\n\nwhere \n\n$$\ns-3>{s}_{0}\\,⇒\\,s>{s}_{0}+3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b2cf6229-1b40-568c-b2ae-1e954c9aa404" "answer-field-02bc9620-90dd-5010-be23-891afbacbab1" "answer-field-7870880a-6cb4-54d1-9b74-b04ea6ec049c" "answer-field-0cfeab26-b8e8-5d3e-bf00-0e9d0ae6a55c"] :db/ensure [:question/validate]} {:db/id "answer-field-b2cf6229-1b40-568c-b2ae-1e954c9aa404" :answer-field/id #uuid "b2cf6229-1b40-568c-b2ae-1e954c9aa404" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-aabb5487-1892-55ca-ba49-3577102d61e1" :answer-field/choices ["answer-74329352-03c2-598b-b3b8-cf7fa3c1748f" "answer-aabb5487-1892-55ca-ba49-3577102d61e1" "answer-a81fbb90-ddcd-5c5b-a412-d6fee1a8fc5f" "answer-42977ec0-6216-5444-bbcb-9b089427c15c"] :db/ensure [:answer-field/validate]} {:db/id "answer-74329352-03c2-598b-b3b8-cf7fa3c1748f" :answer/id #uuid "74329352-03c2-598b-b3b8-cf7fa3c1748f" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{-3t}r(t)" :db/ensure [:answer/validate]} {:db/id "answer-aabb5487-1892-55ca-ba49-3577102d61e1" :answer/id #uuid "aabb5487-1892-55ca-ba49-3577102d61e1" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{3t}r(t)" :db/ensure [:answer/validate]} {:db/id "answer-a81fbb90-ddcd-5c5b-a412-d6fee1a8fc5f" :answer/id #uuid "a81fbb90-ddcd-5c5b-a412-d6fee1a8fc5f" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{-3t}r(t)" :db/ensure [:answer/validate]} {:db/id "answer-42977ec0-6216-5444-bbcb-9b089427c15c" :answer/id #uuid "42977ec0-6216-5444-bbcb-9b089427c15c" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{3t}r(t)" :db/ensure [:answer/validate]} {:db/id "answer-field-02bc9620-90dd-501