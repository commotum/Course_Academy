 "cd7b1c65-0a50-5c1c-aa84-63f14f5a3427" :answer/type :answer.type/math :answer/value "R(s+3)" :db/ensure [:answer/validate]} {:db/id "answer-b3e29a46-3178-54ff-a783-5f42dc9353f0" :answer/id #uuid "b3e29a46-3178-54ff-a783-5f42dc9353f0" :answer/type :answer.type/math :answer/value "R(s-3)" :db/ensure [:answer/validate]} {:db/id "answer-field-0cfeab26-b8e8-5d3e-bf00-0e9d0ae6a55c" :answer-field/id #uuid "0cfeab26-b8e8-5d3e-bf00-0e9d0ae6a55c" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-06378f8e-e69c-5cd0-b88f-0bbbf42e9a3c" :answer-field/choices ["answer-ebfbc9f8-0e10-5337-8153-ddd9ca9629f5" "answer-06378f8e-e69c-5cd0-b88f-0bbbf42e9a3c" "answer-d3b50d8f-1121-5e49-9edb-b9db592fac11"] :db/ensure [:answer-field/validate]} {:db/id "answer-ebfbc9f8-0e10-5337-8153-ddd9ca9629f5" :answer/id #uuid "ebfbc9f8-0e10-5337-8153-ddd9ca9629f5" :answer/type :answer.type/math :answer/value "s>{s}_{0}" :db/ensure [:answer/validate]} {:db/id "answer-06378f8e-e69c-5cd0-b88f-0bbbf42e9a3c" :answer/id #uuid "06378f8e-e69c-5cd0-b88f-0bbbf42e9a3c" :answer/type :answer.type/math :answer/value "s>{s}_{0}+3" :db/ensure [:answer/validate]} {:db/id "answer-d3b50d8f-1121-5e49-9edb-b9db592fac11" :answer/id #uuid "d3b50d8f-1121-5e49-9edb-b9db592fac11" :answer/type :answer.type/math :answer/value "s>{s}_{0}-3" :db/ensure [:answer/validate]} {:db/id "question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/id #uuid "bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/math-academy-id "q-331792" :question/problem "Consider a function $w(t)$ such that its Laplace transform is $L\\{w(t)\\}=W(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{-6t}w(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,w(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-6t}\\,w(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $W(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,w(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t=W(s+6),\n$$\n\nwhere \n\n$$\ns+6>{s}_{0}\\,⇒\\,s>{s}_{0}-6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-74110f7b-0273-51e4-a4d8-5ebb7a3df510" "answer-field-5331794b-edb9-5987-ad14-749201d4047c" "answer-field-0be05dc0-5dcb-5229-97d5-3889f2b77acc" "answer-field-3e04132d-f893-5504-93e7-bc8007db050d"] :db/ensure [:question/validate]} {:db/id "answer-field-74110f7b-0273-51e4-a4d8-5ebb7a3df510" :answer-field/id #uuid "74110f7b-0273-51e4-a4d8-5ebb7a3df510" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-adb382f7-cd8b-5a3c-9d6e-49dc55e97be5" :answer-field/choices ["answer-adb382f7-cd8b-5a3c-9d6e-49dc55e97be5" "answer-150effe3-7d43-5fa4-9d1a-07dccdbc82d9" "answer-3f14ab23-4462-5f82-981d-d6cd0d7fa272" "answer-ff58dc45-b2dd-597e-b3ee-585688a5229f"] :db/ensure [:answer-field/validate]} {:db/id "answer-adb382f7-cd8b-5a3c-9d6e-49dc55e97be5" :answer/id #uuid "adb382f7-cd8b-5a3c-9d6e-49dc55e97be5" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{-6t}w(t)" :db/ensure [:answer/validate]} {:db/id "answer-150effe3-7d43-5fa4-9d1a-07dccdbc82d9" :answer/id #uuid "150effe3-7d43-5fa4-9d1a-07dccdbc82d9" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{6t}w(t)" :db/ensure [:answer/validate]} {:db/id "answer-3f14ab23-4462-5f82-981d-d6cd0d7fa272" :answer/id #uuid "3f14ab23-4462-5f82-981d-d6cd0d7fa272" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{-6t}w(t)" :db/ensure [:answer/validate]} {:db/id "answer-ff58dc45-b2dd-597e-b3ee-585688a5229f" :answer/id #uuid "ff58dc45-b2dd-597e-b3ee-585688a5229f" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{6t}w(t)" :db/ensure [:answer/validate]} {:db/id "answer-field-5331794b-edb9-5987-ad14-749201d4047c" :answer-field/id #uuid "5331794b-edb9-5987-ad14-749201d4047c" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-7dadd7cf-b74d-5865-8e1f-964dae9d2bb0" :answer-field/choices ["answer-96edeea9-662f-543c-958b-a437a0bb825b" "answer-743d231d-3125-555f-a732-b18231046dba" "answer-7dadd7cf-b74d-5865-8e1f-964dae9d2bb0" "answer-87a865e2-5879-5874-8e7e-ed9ac14c8e33"] :db/ensure [:answer-field/validate]} {:db/id "answer-96edeea9-662f-543c-958b-a437a0bb825b" :answer/id #uuid "96edeea9-662f-543c-958b-a437a0bb825b" :answer/type :answer.type/math :answer/value "{e}^{(s+6)t}" :db/ensure [:answer/validate]} {:db/id "answer-743d231d-3125-555f-a732-b18231046dba" :answer/id #uuid "743d231d-3125-555f-a732-b18231046dba" :answer/type :answer.type/math :answer/value "{e}^{(s-6)t}" :db/ensure [:answer/validate]} {:db/id "answer-7dadd7cf-b74d-5865-8e1f-964dae9d2bb0" :answer/id #uuid "7dadd7cf-b74d-5865-8e1f-964dae9d2bb0" :answer/type :answer.type/math :answer/value "{e}^{-(s+6)t}" :db/ensure [:answer/validate]} {:db/id "answer-87a865e2-5879-5874-8e7e-ed9ac14c8e33" :answer/id #uuid "87a865e2-5879-5874-8e7e-ed9ac14c8e33" :answer/type :answer.type/math :answer/value "{e}^{-(s-6)t}" :db/ensure [:answer/validate]} {:db/id "answer-field-0be05dc0-5dcb-5229-97d5-3889f2b77acc" :answer-field/id #uuid "0be05dc0-5dcb-5229-97d5-3889f2b77acc" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e1a8eccc-9669-52a0-a6c4-8e5789eba8f3" :answer-field/choices ["answer-01421a14-fbdd-550a-bb28-30816a633bd4" "answer-e1a8eccc-9669-52a0-a6c4-8e5789eba8f3" "answer-b4e2249c-de4b-59f7-8146-a8b2909f33c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-01421a14-fbdd-550a-bb28-30816a633bd4" :answer/id #uuid "01421a14-fbdd-550a-bb28-30816a633bd4" :answer/type :answer.type/math :answer/value "W(s)" :db/ensure [:answer/validate]} {:db/id "answer-e1a8eccc-9669-52a0-a6c4-8e5789eba8f3" :answer/id #uuid "e1a8eccc-9669-52a0-a6c4-8e5789eba8f3" :answer/type :answer.type/math :answer/value "W(s+6)" :db/ensure [:answer/validate]} {:db/id "answer-b4e2249c-de4b-59f7-8146-a8b2909f33c8" :answer/id #uuid "b4e2249c-de4b-59f7-8146-a8b2909f33c8" :answer/type :answer.type/math :answer/value "W(s-6)" :db/ensure [:answer/validate]} {:db/id "answer-field-3e04132d-f893-5504-93e7-bc8007db050d" :answer-field/id #uuid "3e04132d-f893-5504-93e7-bc8007db050d" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e60983fa-e6a9-5ac0-89a9-689d559fbabd" :answer-field/choices ["answer-bc516240-edf6-50de-a972-2d32bd44c276" "answer-e9fce1b0-8710-5564-a541-83b6838d2cc1" "answer-e60983fa-e6a9-5ac0-89a9-689d559fbabd"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc516240-edf6-50de-a972-2d32bd44c276" :answer/id #uuid "bc516240-edf6-50de-a972-2d32bd44c276" :answer/type :answer.type/math :answer/value "s>{s}_{0}" :db/ensure [:answer/validate]} {:db/id "answer-e9fce1b0-8710-5564-a541-83b6838d2cc1" :answer/id #uuid "e9fce1b0-8710-5564-a541-83b6838d2cc1" :answer/type :answer.type/math :answer/value "s>{s}_{0}+6" :db/ensure [:answer/validate]} {:db/id "answer-e60983fa-e6a9-5ac0-89a9-689d559fbabd" :answer/id #uuid "e60983fa-e6a9-5ac0-89a9-689d559fbabd" :answer/type :answer.type/math :answer/value "s>{s}_{0}-6" :db/ensure [:answer/validate]} {:db/id 17592186368088 :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)=7{t}^{2}+5{t}^{4}{e}^{t}$ for $s>1.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{7{t}^{2}+5{t}^{4}{e}^{t}\\} \\\\  & =L\\{7{t}^{2}\\}+L\\{5{t}^{4}{e}^{t}\\} \\\\  & =7L\\{{t}^{2}\\}+5L\\{{t}^{4}{e}^{t}\\}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L\\{{t}^{2}\\} & =\\frac{2}{{s}^{3}} \\\\ L\\{{t}^{4}\\} & =\\frac{24}{{s}^{5}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L\\{f(t)\\}=F(s),$ then $L\\{{e}^{at}f(t)\\}=F(s-a).$ Therefore,\n\n$$\nL\\{{t}^{4}{e}^{t}\\}=\\frac{24}{(s-1)^{5}}.\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =7L\\{{t}^{2}\\}+5L\\{{t}^{4}{e}^{t}\\} \\\\  & =7\\cdot \\frac{2}{{s}^{3}}+5\\cdot \\frac{24}{(s-1)^{5}} \\\\  & =\\frac{14}{{s}^{3}}+\\frac{120}{(s-1)^{5}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>1.$" :db/ensure [:question/validate]} {:db/id "activity-c46cfffe-18b2-5eac-8e1f-91eedc4c8269" :activity/id #uuid "c46cfffe-18b2-5eac-8e1f-91eedc4c8269" :activity/title "The First Shifting Theorem of Laplace Transforms" :activity/type :activity.type/review :activity/scope 17592186050615 :activity/course 17592186046660 :activity/steps ["step-f579c56e-583e-5d0a-8431-cb59e1d5eecc" "step-4352ef4f-23b6-5c61-ac25-56e4098a43c6" "step-34e3daa2-8ba3-59ec-8c00-c52a7eef4a03"] :activity/first-step "step-f579c56e-583e-5d0a-8431-cb59e1d5eecc" :db/ensure [:activity/validate]} {:db/id "step-f579c56e-583e-5d0a-8431-cb59e1d5eecc" :step/id #uuid "f579c56e-583e-5d0a-8431-cb59e1d5eecc" :step/content "question-002b6494-db6e-5c52-baa6-f8349498d2c1" :step/next "step-4352ef4f-23b6-5c61-ac25-56e4098a43c6" :db/ensure [:step/validate]} {:db/id "step-4352ef4f-23b6-5c61-ac25-56e4098a43c6" :step/id #uuid "4352ef4f-23b6-5c61-ac25-56e4098a43c6" :step/content "question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :step/next "step-34e3daa2-8ba3-59ec-8c00-c52a7eef4a03" :db/ensure [:step/validate]} {:db/id "step-34e3daa2-8ba3-59ec-8c00-c52a7eef4a03" :step/id #uuid "34e3daa2-8ba3-59ec-8c00-c52a7eef4a03" :step/content 17592186368088 :db/ensure [:step/validate]} [:db/retract 17592186161210 :answer-field/choices 17592186161211] [:db/retract 17592186161210 :answer-field/choices 17592186161212] [:db/retract 17592186161210 :answer-field/choices 17592186161213] [:db/retract 17592186161210 :answer-field/choices 17592186161214] [:db/retract 17592186161210 :answer-field/choices 17592186161215] {:db/id 17592186162005 :knowledge-point/questions ["question-e2384f15-0b1d-5ffb-9cdd-5f07e0af2003" "question-f4e82a18-a51f-5302-8e3f-b37a2f43e1e2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161797 :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n![](images/09/09d935cd479371e7cde4e52b2073cb23343a5137f311803c8da5879a59896fb4.svg)\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A\\mathbin{:}$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 2 & 0 \\\\ 2 & 1-\\lambda  & 0 \\\\ 0 & 0 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}1-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )((1-\\lambda )(1-\\lambda )-4) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}-2\\lambda -3) & =0 \\\\ (2-\\lambda )(\\lambda -3)(\\lambda +1) & =0 \\\\ \\lambda  & =3,\\,2,\\,-1\\end{aligned}\n$$\n\n \n\nSo, writing the eigenvalues in descending order, we obtain the diagonal matrix\n\n![](images/51/51694be12d594a39b6a07f48b37aedb47323fc5537a60f5d6a766576103d48f6.svg)\n\nThe corresponding quadratic form after a change of variables is\n\n$$\n3y_1^2 + 2y_2^2 - y_3^2.\n$$" :db/ensure [:question/validate]} {:db/id "question-e2384f15-0b1d-5ffb-9cdd-5f07e0af2003" :question/id #uuid "e2384f15-0b1d-5ffb-9cdd-5f07e0af2003" :question/math-academy-id "q-140988" :question/problem "Using the method of orthogonal transformations, find the canonical form of $Q(x)=2{x}_{1}^{2}+2{x}_{2}^{2}+2{x}_{3}^{2}+6{x}_{1}{x}_{2}.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}2 & 3 & 0 \\\\ 3 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}2-\\lambda  & 3 & 0 \\\\ 3 & 2-\\lambda  & 0 \\\\ 0 & 0 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}2-\\lambda  & 3 \\\\ 3 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )((2-\\lambda )(2-\\lambda )-9) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}-4\\lambda -5) & =0 \\\\ (2-\\lambda )(\\lambda -5)(\\lambda +1) & =0 \\\\ \\lambda  & =5,\\,2,\\,-1\\end{aligned}\n$$\n\n \n\nSo, writing the eigenvalues in descending order, we obtain the diagonal matrix\n\n$$\nD=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -1\\end{aligned}].\n$$\n\nThe corresponding quadratic form after a change of variables is\n\n$$\n5{y}_{1}^{2}+2{y}_{2}^{2}-{y}_{3}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9068f0e7-c225-543a-98c2-9fb66e6e943c"] :db/ensure [:question/validate]} {:db/id "answer-field-9068f0e7-c225-543a-98c2-9fb66e6e943c" :answer-field/id #uuid "9068f0e7-c225-543a-98c2-9fb66e6e943c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bbdc5c05-9bbe-541b-869c-9cf376ec10dc" :answer-field/choices ["answer-eda10016-5f60-5c0b-9d94-6cf80c8a71a1" "answer-901735db-1bf7-5c5f-b457-e88cba2e872b" "answer-09c4e6bc-afd2-5630-97ec-773be2228c82" "answer-9fdef02b-f2c0-5cf0-81a1-c3565e0d55b4" "answer-bbdc5c05-9bbe-541b-869c-9cf376ec10dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-eda10016-5f60-5c0b-9d94-6cf80c8a71a1" :answer/id #uuid "eda10016-5f60-5c0b-9d94-6cf80c8a71a1" :answer/type :answer.type/math :answer/value "2{y}_{1}^{2}+2{y}_{2}^{2}+{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-901735db-1bf7-5c5f-b457-e88cba2e872b" :answer/id #uuid "901735db-1bf7-5c5f-b457-e88cba2e872b" :answer/type :answer.type/math :answer/value "3{y}_{1}^{2}+5{y}_{2}^{2}-{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-09c4e6bc-afd2-5630-97ec-773be2228c82" :answer/id #uuid "09c4e6bc-afd2-5630-97ec-773be2228c82" :answer/type :answer.type/math :answer/value "3{y}_{1}^{2}-2{y}_{2}^{2}-{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-9fdef02b-f2c0-5cf0-81a1-c3565e0d55b4" :answer/id #uuid "9fdef02b-f2c0-5cf0-81a1-c3565e0d55b4" :answer/type :answer.type/math :answer/value "4{y}_{1}^{2}-2{y}_{2}^{2}+2{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bbdc5c05-9bbe-541b-869c-9cf376ec10dc" :answer/id #uuid "bbdc5c05-9bbe-541b-869c-9cf376ec10dc" :answer/type :answer.type/math :answer/value "5{y}_{1}^{2}+2{y}_{2}^{2}-{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "question-f4e82a18-a51f-5302-8e3f-b37a2f43e1e2" :question/id #uuid "f4e82a18-a51f-5302-8e3f-b37a2f43e1e2" :question/math-academy-id "q-94970" :question/problem "Using the method of orthogonal transformations, find the canonical form of $Q(x)=7{x}_{1}^{2}+8{x}_{2}^{2}+5{x}_{3}^{2}-4{x}_{2}{x}_{3}.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}7 & 0 & 0 \\\\ 0 & 8 & -2 \\\\ 0 & -2 & 5\\end{aligned}]\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}7-\\lambda  & 0 & 0 \\\\ 0 & 8-\\lambda  & -2 \\\\ 0 & -2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )|\\begin{aligned}8-\\lambda  & -2 \\\\ -2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (7-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ (7-\\lambda )(\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,7,\\,4\\end{aligned}\n$$\n\n \n\nSo, writing the eigenvalues in descending order, we obtain the diagonal matrix\n\n$$\nD=[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 7 & 0 \\\\ 0 & 0 & 4\\end{aligned}].\n$$\n\nThe corresponding quadratic form after a change of variables is\n\n$$\n9{y}_{1}^{2}+7{y}_{2}^{2}+4{y}_{3}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-47517d7d-e627-5322-bd0d-8ce492564569"] :db/ensure [:question/validate]} {:db/id "answer-field-47517d7d-e627-5322-bd0d-8ce492564569" :answer-field/id #uuid "47517d7d-e627-5322-bd0d-8ce492564569" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54be9190-6b23-5434-95db-5f490ba1a257" :answer-field/choices ["answer-63a7c54d-2bee-5bb4-a9cf-93c52af280d6" "answer-d18a843c-0b4d-5384-94d8-240379920e57" "answer-24d70dcb-3915-5dca-b77b-4d039c22fd0a" "answer-54be9190-6b23-5434-95db-5f490ba1a257" "answer-bbe60f6c-f903-56ca-b937-a0a3cc617414"] :db/ensure [:answer-field/validate]} {:db/id "answer-63a7c54d-2bee-5bb4-a9cf-93c52af280d6" :answer/id #uuid "63a7c54d-2bee-5bb4-a9cf-93c52af280d6" :answer/type :answer.type/math :answer/value "7{y}_{2}^{2}+5{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-d18a843c-0b4d-5384-94d8-240379920e57" :answer/id #uuid "d18a843c-0b4d-5384-94d8-240379920e57" :answer/type :answer.type/math :answer/value "8{y}_{1}^{2}-4{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-24d70dcb-3915-5dca-b77b-4d039c22fd0a" :answer/id #uuid "24d70dcb-3915-5dca-b77b-4d039c22fd0a" :answer/type :answer.type/math :answer/value "8{y}_{1}^{2}-7{y}_{2}^{2}-5{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-54be9190-6b23-5434-95db-5f490ba1a257" :answer/id #uuid "54be9190-6b23-5434-95db-5f490ba1a257" :answer/type :answer.type/math :answer/value "9{y}_{1}^{2}+7{y}_{2}^{2}+4{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bbe60f6c-f903-56ca-b937-a0a3cc617414" :answer/id #uuid "bbe60f6c-f903-56ca-b937-a0a3cc617414" :answer/type :answer.type/math :answer/value "9{y}_{1}^{2}-7{y}_{2}^{2}+4{y}_{3}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186162653 :question/problem "Given the quadratic form $Q(x)=9{x}_{1}^{2}+4{x}_{1}{x}_{2}+6{x}_{2}^{2},$ find its canonical (diagonal) form ${y}^{T}\\,Dy$ and an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables." :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}9 & 2 \\\\ 2 & 6\\end{aligned}]\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & 2 \\\\ 2 & 6-\\lambda \\end{aligned}| & =0 \\\\ {\\lambda }^{2}-15\\lambda +50 & =0 \\\\ \\lambda  & =10,\\,5\\end{aligned}\n$$\n\n \n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =[\\begin{aligned}9 & 2 \\\\ 2 & 6\\end{aligned}]-10[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 2 \\\\ 2 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}9 & 2 \\\\ 2 & 6\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\nFinally, we construct the diagonal matrix $D$ (writing the eigenvalues in descending order) and the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}10 & 0 \\\\ 0 & 5\\end{aligned}],\\,P=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161210 :answer-field/correct "answer-f9ac0f69-989b-5238-8a66-cf117b0fbd78" :answer-field/choices ["answer-38a4a01f-1d6e-59d7-8eb3-95232ec04361" "answer-230cd837-271b-59b8-8fc9-daa1826955f8" "answer-9bea0352-3bc6-5411-855c-6f3a0a33b11d" "answer-f9ac0f69-989b-5238-8a66-cf117b0fbd78" "answer-367d39e1-bdbe-5145-9d88-c22d95aa558e"] :db/ensure [:answer-field/validate]} {:db/id "answer-38a4a01f-1d6e-59d7-8eb3-95232ec04361" :answer/id #uuid "38a4a01f-1d6e-59d7-8eb3-95232ec04361" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}10 & 0 \\\\ 0 & -5\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-230cd837-271b-59b8-8fc9-daa1826955f8" :answer/id #uuid "230cd837-271b-59b8-8fc9-daa1826955f8" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}10 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-9bea0352-3bc6-5411-855c-6f3a0a33b11d" :answer/id #uuid "9bea0352-3bc6-5411-855c-6f3a0a33b11d" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}10 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-f9ac0f69-989b-5238-8a66-cf117b0fbd78" :answer/id #uuid "f9ac0f69-989b-5238-8a66-cf117b0fbd78" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}10 & 0 \\\\ 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-367d39e1-bdbe-5145-9d88-c22d95aa558e" :answer/id #uuid "367d39e1-bdbe-5145-9d88-c22d95aa558e" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}5 & 0 \\\\ 0 & -10\\end{aligned}]$ and $P=[\\begin{aligned}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id 17592186162007 :knowledge-point/questions ["question-896a96f2-03d3-58ec-b64e-91765762ee86" "question-b761dc5c-3f49-5a27-a4d6-ac454f2a31c5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-896a96f2-03d3-58ec-b64e-91765762ee86" :question/id #uuid "896a96f2-03d3-58ec-b64e-91765762ee86" :question/math-academy-id "q-140999" :question/problem "$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & 4\\end{aligned}],\\,D=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=5,\\,$ ${\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=0.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & 4\\end{aligned}]-5[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-4 & 0 & 0 \\\\ 0 & -4 & -2 \\\\ 0 & -2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-1I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & 4\\end{aligned}]-1[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ 0 & -2 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-1I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}\\text{ }[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & 4\\end{aligned}]-0[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & -2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1cc37d32-85e3-5b35-b602-5311d5cb36cc"] :db/ensure [:question/validate]} {:db/id "answer-field-1cc37d32-85e3-5b35-b602-5311d5cb36cc" :answer-field/id #uuid "1cc37d32-85e3-5b35-b602-5311d5cb36cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c2959145-8545-53a5-9cc2-12b48e654386" :answer-field/choices ["answer-8519bee2-f924-550a-82d3-1ce3ed4a3c3d" "answer-6acf5e39-85a5-5662-ac99-002108d8405f" "answer-c2959145-8545-53a5-9cc2-12b48e654386" "answer-b0aa8df4-f91f-58ac-8258-7e78318e4b39" "answer-3a6d8a1d-f652-58bc-bcde-9bf3f8a622e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-8519bee2-f924-550a-82d3-1ce3ed4a3c3d" :answer/id #uuid "8519bee2-f924-550a-82d3-1ce3ed4a3c3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6acf5e39-85a5-5662-ac99-002108d8405f" :answer/id #uuid "6acf5e39-85a5-5662-ac99-002108d8405f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c2959145-8545-53a5-9cc2-12b48e654386" :answer/id #uuid "c2959145-8545-53a5-9cc2-12b48e654386" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b0aa8df4-f91f-58ac-8258-7e78318e4b39" :answer/id #uuid "b0aa8df4-f91f-58ac-8258-7e78318e4b39" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3a6d8a1d-f652-58bc-bcde-9bf3f8a622e3" :answer/id #uuid "3a6d8a1d-f652-58bc-bcde-9bf3f8a622e3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-b761dc5c-3f49-5a27-a4d6-ac454f2a31c5" :question/id #uuid "b761dc5c-3f49-5a27-a4d6-ac454f2a31c5" :question/math-academy-id "q-95105" :question/problem "$$\nA=[\\begin{aligned}2 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 2\\end{aligned}],\\,D=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=5,\\,$ ${\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=-1.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}2 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 2\\end{aligned}]-5[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-3 & 0 & 3 \\\\ 0 & -4 & 0 \\\\ 3 & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}2 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 2\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 0 & 0 \\\\ 3 & 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-1,$ we have\n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}-1 & 0 & -2 \\\\ 0 & -2 & 0 \\\\ -2 & 0 & -1\\end{aligned}]-(-1)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}3 & 0 & 3 \\\\ 0 & 2 & 0 \\\\ 3 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-1)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cfad7264-087b-5d12-af15-8668354cbcad"] :db/ensure [:question/validate]} {:db/id "answer-field-cfad7264-087b-5d12-af15-8668354cbcad" :answer-field/id #uuid "cfad7264-087b-5d12-af15-8668354cbcad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-466013e6-797e-59a4-9c1c-4141122ba0a2" :answer-field/choices ["answer-d7d0778a-5d6a-5764-9992-8c375aebdffa" "answer-332fe242-10f7-53a4-a646-3b1c211d7235" "answer-d380404c-ea5d-58f6-bdab-c4d34c2e4292" "answer-0b53dd94-de3e-5a3e-a67c-8e211c2002d3" "answer-466013e6-797e-59a4-9c1c-4141122ba0a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7d0778a-5d6a-5764-9992-8c375aebdffa" :answer/id #uuid "d7d0778a-5d6a-5764-9992-8c375aebdffa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-332fe242-10f7-53a4-a646-3b1c211d7235" :answer/id #uuid "332fe242-10f7-53a4-a646-3b1c211d7235" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d380404c-ea5d-58f6-bdab-c4d34c2e4292" :answer/id #uuid "d380404c-ea5d-58f6-bdab-c4d34c2e4292" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0b53dd94-de3e-5a3e-a67c-8e211c2002d3" :answer/id #uuid "0b53dd94-de3e-5a3e-a67c-8e211c2002d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-466013e6-797e-59a4-9c1c-4141122ba0a2" :answer/id #uuid "466013e6-797e-59a4-9c1c-4141122ba0a2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186163229 :tutorial/content "Consider a quadratic form \n\n$$\n\\mathbf{x}^T \\! A \\mathbf{x},\n$$\n\nwhere $A$ is a symmetric matrix. As we know, any symmetric matrix can be orthogonally diagonalized as follows:\n\n$$\nD = P^T \\! AP,\n$$\n\nwhere $P$ is an orthogonal matrix and $D$ is a diagonal matrix that contains eigenvalues of $A$ on the main diagonal. \n\nNow, substituting the change of variable $\\mathbf{x} = P \\mathbf{y}$ into our quadratic form, we obtain\n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A(Py) \\\\  & ={y}^{T}\\,({P}^{T}\\,AP)y \\\\  & ={y}^{T}\\,Dy,\\end{aligned}\n$$\n\nwhich gives us a canonical form. \n\nAs a result, using the orthogonal diagonalization of $A,$ we can find the canonical form of $\\mathbf{x}^T \\! A \\mathbf{x}.$\n\nFor example, let's find the canonical form of \n\n$$\nQ(\\mathbf{x})=x_1^2+4x_1x_2+x_2^2.\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n![](images/43/43e0dc28161c0564a75f6ea2dc7f0e09ad74dffae05b864e13c61330221f2983.svg)\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A\\mathbin{:}$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(1-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-2\\lambda -3 & =0 \\\\ (\\lambda +1)(\\lambda -3) & =0 \\\\ \\lambda  & =3,\\,-1\\end{aligned}\n$$\n\n \n\nSo, writing the eigenvalues in descending order, we obtain the diagonal matrix\n\n![](images/c9/c93cabd6a18df429b5aad99815b23e337c17b88a1c271dd17344631dfc5f8ebb.svg)\n\nThe corresponding quadratic form after a change of variables is\n\n$$\n3y_1^2 - y_2^2.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186162221 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186054807 :knowledge-point/questions ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/id #uuid "403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/math-academy-id "q-167097" :question/problem "What are the $xy$-coordinates of the point $A?$\n\n$A\\,($\n{{field-1}}\n$,\\,$\n{{field-2}}\n$)$" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$- and $y$-axes.\n\n* The point is $4$ units to the *right* of the origin, in the *positive* direction of the $x$-axis. So, its $x$-coordinate is $4.$\n\n* The point is $3$ units *below* the origin, in the *negative* direction of the $y$-axis. So, its $y$-coordinate is $-3.$\n\nTherefore, the coordinates of our point are $(4,-3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" "answer-field-fb638e82-4178-578f-ab04-4a68913057eb"] :db/ensure [:question/validate]} {:db/id "answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/id #uuid "07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eb884622-28d7-5ef0-904b-b681c29a17d5" :answer-field/choices ["answer-eb884622-28d7-5ef0-904b-b681c29a17d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/id #uuid "eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/id #uuid "fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer-field/choices ["answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e"] :db/ensure [:answer-field/validate]} {:db/id "answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/id #uuid "579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id 17592186054669 :knowledge-point/questions ["question-fc8a9725-c277-5a2e-a217-f21f271d6767"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/id #uuid "fc8a9725-c277-5a2e-a217-f21f271d6767" :question/math-academy-id "q-167098" :question/problem "Write the equations of the vertical and horizontal lines that pass through the point $B.$\n\nThe **equation** of the vertical line is \n{{field-1}}\n\nThe **equation** of the horizontal line is \n{{field-2}}" :question/worked-solution "The coordinates of $B$ are $(1,3).$\n\n* Since the vertical line should pass through $(1,3)$, the $x$-value for every point on the line is $1.$ Hence, the equation of that line is \n\n$$\nx=1.\n$$\n\n* Since the horizontal line should pass through $(1,3)$, the $y$-value for every point on the line is $3.$ Hence, the equation of that line is \n\n$$\ny=3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" "answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1"] :db/ensure [:question/validate]} {:db/id "answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/id #uuid "23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4ae75924-88ff-50f4-b405-d0948000592c" :answer-field/choices ["answer-4ae75924-88ff-50f4-b405-d0948000592c"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ae75924-88ff-50f4-b405-d0948000592c" :answer/id #uuid "4ae75924-88ff-50f4-b405-d0948000592c" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/id #uuid "1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer-field/choices ["answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/id #uuid "411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/type :answer.type/math :answer/value "y=3" :db/ensure [:answer/validate]} {:db/id 17592186068720 :knowledge-point/questions ["question-3b67bc82-d512-510a-bcaa-06aed32ef341"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/id #uuid "3b67bc82-d512-510a-bcaa-06aed32ef341" :question/math-academy-id "q-167099" :question/problem "What is the length of $\\overset{―}{AB}?$\n\n$|\\overset{―}{AB}|\\,=\\,$\n{{field-1}}" :question/worked-solution "From the picture, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}|\\overset{―}{AB}| & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-4)^{2}+(3-(-3))^{2}} \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648"] :db/ensure [:question/validate]} {:db/id "answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/id #uuid "713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer-field/choices ["answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/id #uuid "df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/type :answer.type/math :answer/value "3\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id 17592186068894 :knowledge-point/questions ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/id #uuid "79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/math-academy-id "q-167100" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-(-3)}{1-4} \\\\  & =\\frac{6}{-3} \\\\  & =-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113"] :db/ensure [:question/validate]} {:db/id "answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/id #uuid "bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer-field/choices ["answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186068925 :knowledge-point/questions ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/id #uuid "7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/math-academy-id "q-167101" :question/problem "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$ - intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}" :question/worked-solution "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-2.$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,-3):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ -3 & =-2(4)+b \\\\ -3 & =-8+b \\\\ 5 & =b \\\\ b & =5\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" "answer-field-8958b128-5689-552d-8a7a-ed52385902c0"] :db/ensure [:question/validate]} {:db/id "answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/id #uuid "2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer-field/choices ["answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/id #uuid "8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/id #uuid "8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-35ec4058-3033-5189-b180-d21d1d98d10d" :answer-field/choices ["answer-35ec4058-3033-5189-b180-d21d1d98d10d"] :db/ensure [:answer-field/validate]} {:db/id "answer-35ec4058-3033-5189-b180-d21d1d98d10d" :answer/id #uuid "35ec4058-3033-5189-b180-d21d1d98d10d" :answer/type :answer.type/math :answer/value "-2x+5" :db/ensure [:answer/validate]} {:db/id 17592186068926 :knowledge-point/questions ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/id #uuid "2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/math-academy-id "q-167103" :question/problem "Calculate the $x$-intercept of the line $\\overset{↔}{AB}.$\n\n$x\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that $\\overset{↔}{AB}$ has equation\n\n$$\ny=-2x+5.\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 0 & =-2x+5 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=\\frac{5}{2}.$ The coordinates of the $x$-intercept are $(\\frac{5}{2},0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7"] :db/ensure [:question/validate]} {:db/id "answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/id #uuid "edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5356afcd-b86a-5455-aebb-d397c1bba50f" :answer-field/choices ["answer-5356afcd-b86a-5455-aebb-d397c1bba50f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/id #uuid "5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id 17592186087710 :knowledge-point/questions ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118"] :db/ensure [:knowledge-point/validate]} {:db/id "question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/id #uuid "44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/math-academy-id "q-167104" :question/problem "Write the equation of $\\overset{↔}{AB}$ in **standard form**.\n\nThe equation is \n{{field-1}} \n$x+y=$\n{{field-2}}." :question/worked-solution "Our goal is to write the equation in the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side:\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 2x+y & =5\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So, we are done!\n\nThe standard form of the line is \n\n$$\n2x+y=5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" "answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86"] :db/ensure [:question/validate]} {:db/id "answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/id #uuid "035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-51d43d9d-a774-52bb-ae32-16fc0e455143" :answer-field/choices ["answer-51d43d9d-a774-52bb-ae32-16fc0e455143"] :db/ensure [:answer-field/validate]} {:db/id "answer-51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/id #uuid "51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/id #uuid "1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-960e4af8-435d-53a1-926a-470205775d95" :answer-field/choices ["answer-960e4af8-435d-53a1-926a-470205775d95"] :db/ensure [:answer-field/validate]} {:db/id "answer-960e4af8-435d-53a1-926a-470205775d95" :answer/id #uuid "960e4af8-435d-53a1-926a-470205775d95" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186175910 :knowledge-point/questions ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/id #uuid "6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/math-academy-id "q-167105" :question/problem "Write the equation of the line that passes through the point $(4,0)$ and is parallel to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $\\overset{↔}{AB},$ i.e.,\n\n$$\nm=-2.\n$$\n\nSo, we want a line with the slope $m=-2$ that passes through the point $({x}_{1},{y}_{1})=(4,0).$ \n\nUsing point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-2\\cdot (x-4) \\\\ y & =-2x+8\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2"] :db/ensure [:question/validate]} {:db/id "answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/id #uuid "23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ea512d41-ab28-59ba-a04a-101b45b11211" :answer-field/choices ["answer-ea512d41-ab28-59ba-a04a-101b45b11211"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea512d41-ab28-59ba-a04a-101b45b11211" :answer/id #uuid "ea512d41-ab28-59ba-a04a-101b45b11211" :answer/type :answer.type/math :answer/value "-2x+8" :db/ensure [:answer/validate]} {:db/id 17592186175923 :knowledge-point/questions ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/id #uuid "c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/math-academy-id "q-167106" :question/problem "Write the equation of the line that passes through the point $(10,3)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-2,$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-2)}=\\frac{1}{2}.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=\\frac{1}{2}$ and passes through the point $({x}_{1},{y}_{1})=(10,3).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-10) \\\\ y-3 & =\\frac{1}{2}x-5 \\\\ y & =\\frac{1}{2}x-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3"] :db/ensure [:question/validate]} {:db/id "answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/id #uuid "852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer-field/choices ["answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/id #uuid "f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/type :answer.type/math :answer/value "\\frac{1}{2}x-2" :db/ensure [:answer/validate]} {:db/id "multistep-f86c67b8-5ef3-50e6-9f71-b4614feb6dde" :multistep/id #uuid "f86c67b8-5ef3-50e6-9f71-b4614feb6dde" :multistep/context "![](images/4f/4f2a3229336aa53a36621138c9cee114b1dee0c8244d778a6e3e2ac28950e908.png)\n\nConsider the diagram shown above." :multistep/steps ["step-7759f2fa-f496-5dd5-8aff-2653c3e9441a" "step-a2e163d1-dd5b-58d3-b361-e2807e494c9e" "step-e1f2abf3-17aa-5b88-9b26-303aa909a413" "step-2c8a856f-5da6-5572-88c5-cde44c333e98" "step-b6a9945a-7c14-50db-b608-15ec87c24466" "step-df46f7be-cf0c-53c7-b9a0-211aa6721b97" "step-d5db579b-2df0-58ee-8cdf-494999ac6603" "step-494f2d04-014d-5dbf-9ea0-9d3c98099132" "step-f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6"] :multistep/first-step "step-7759f2fa-f496-5dd5-8aff-2653c3e9441a" :db/ensure [:multistep/validate]} {:db/