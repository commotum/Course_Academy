\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-25a7cb9f-7a09-5793-9cb0-c7d79f0245b3"] :db/ensure [:question/validate]} {:db/id "answer-field-25a7cb9f-7a09-5793-9cb0-c7d79f0245b3" :answer-field/id #uuid "25a7cb9f-7a09-5793-9cb0-c7d79f0245b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e2b5f77a-6357-5f9d-a83c-5e2d8467f25d" :answer-field/choices ["answer-0ec95535-d6a1-5444-a66f-12c14cc90adf" "answer-99538083-becb-52d4-9672-1fc2b387c331" "answer-d3793b8d-2960-58c7-afcf-120f39097ca4" "answer-dfe4a5b1-a271-5ca0-b99e-5d25ada3dd88" "answer-e2b5f77a-6357-5f9d-a83c-5e2d8467f25d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ec95535-d6a1-5444-a66f-12c14cc90adf" :answer/id #uuid "0ec95535-d6a1-5444-a66f-12c14cc90adf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & -2 & -1 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-99538083-becb-52d4-9672-1fc2b387c331" :answer/id #uuid "99538083-becb-52d4-9672-1fc2b387c331" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ -2 \\\\ -1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d3793b8d-2960-58c7-afcf-120f39097ca4" :answer/id #uuid "d3793b8d-2960-58c7-afcf-120f39097ca4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & -4 & 2 & 5 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dfe4a5b1-a271-5ca0-b99e-5d25ada3dd88" :answer/id #uuid "dfe4a5b1-a271-5ca0-b99e-5d25ada3dd88" :answer/type :answer.type/math :answer/value "[\\begin{aligned