>$0.88$</td>\n</tr>\n</tbody></table>" :db/ensure [:answer/validate]} {:db/id "answer-8e327ddb-636a-51fe-9f9f-8dc1e67320c8" :answer/id #uuid "8e327ddb-636a-51fe-9f9f-8dc1e67320c8" :answer/type :answer.type/text :answer/value "<table align=\"left\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td colspan=\"2\" align=\"center\">From:</td> \n</tr>\n<tr>\n<td></td>\n<td></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td> \n</tr>\n<tr> \n<td rowspan=\"2\" align=\"center\">To:</td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td align=\"center\">$0.28$</td>\n<td align=\"center\">$0.88$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.72$</td>\n<td align=\"center\">$0.12$</td>\n</tr>\n</tbody></table>" :db/ensure [:answer/validate]} {:db/id "answer-ae851e7a-57eb-52b1-8b52-dcf69a01f009" :answer/id #uuid "ae851e7a-57eb-52b1-8b52-dcf69a01f009" :answer/type :answer.type/text :answer/value "<table align=\"left\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td colspan=\"2\" align=\"center\">From:</td> \n</tr>\n<tr>\n<td></td>\n<td></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td> \n</tr>\n<tr> \n<td rowspan=\"2\" align=\"center\">To:</td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td align=\"center\">$0.88$</td>\n<td align=\"center\">$0.28$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n</tbody></table>" :db/ensure [:answer/validate]} {:db/id "answer-f8546886-0820-5923-90be-94d7c0870ccd" :answer/id #uuid "f8546886-0820-5923-90be-94d7c0870ccd" :answer/type :answer.type/text :answer/value "<table align=\"left\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td colspan=\"2\" align=\"center\">From:</td> \n</tr>\n<tr>\n<td></td>\n<td></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td> \n</tr>\n<tr> \n<td rowspan=\"2\" align=\"center\">To:</td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td align=\"center\">$0.88$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.28$</td>\n</tr>\n</tbody></table>" :db/ensure [:answer/validate]} {:db/id 17592186124554 :knowledge-point/questions ["question-aad00a02-7311-5843-ab16-bebead54d45c" "question-8271e0f5-ad00-5357-b8f4-39e3fffd35ad"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aad00a02-7311-5843-ab16-bebead54d45c" :question/id #uuid "aad00a02-7311-5843-ab16-bebead54d45c" :question/math-academy-id "q-135453" :question/problem "$$\nP=[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}],\\,{x}_{0}=[\\begin{aligned}0.3 \\\\ 0.7\\end{aligned}]\n$$\n\n \n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}][\\begin{aligned}0.3 \\\\ 0.7\\end{aligned}] \\\\  & =[\\begin{aligned}0.21 \\\\ 0.79\\end{aligned}].\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}][\\begin{aligned}0.21 \\\\ 0.79\\end{aligned}] \\\\  & =[\\begin{aligned}0.192 \\\\ 0.808\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f757e78b-6af6-5637-affb-8a450f17cc85"] :db/ensure [:question/validate]} {:db/id "answer-field-f757e78b-6af6-5637-affb-8a450f17cc85" :answer-field/id #uuid "f757e78b-6af6-5637-affb-8a450f17cc85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2cb988c0-f3a5-5c82-b2bd-66aa789d780c" :answer-field/choices ["answer-7a50f6bd-62b5-52cc-8bc8-2701b3a19388" "answer-2cb988c0-f3a5-5c82-b2bd-66aa789d780c" "answer-5da59e22-9c22-5ce7-b43b-7e2e52a1f029" "answer-32d225e8-4f0c-59f9-8321-143a8679ecc9" "answer-94e347aa-0aab-5548-a61d-fa864e54a8eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a50f6bd-62b5-52cc-8bc8-2701b3a19388" :answer/id #uuid "7a50f6bd-62b5-52cc-8bc8-2701b3a19388" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.178 \\\\ 0.822\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2cb988c0-f3a5-5c82-b2bd-66aa789d780c" :answer/id #uuid "2cb988c0-f3a5-5c82-b2bd-66aa789d780c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.192 \\\\ 0.808\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5da59e22-9c22-5ce7-b43b-7e2e52a1f029" :answer/id #uuid "5da59e22-9c22-5ce7-b43b-7e2e52a1f029" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.252 \\\\ 0.748\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-32d225e8-4f0c-59f9-8321-143a8679ecc9" :answer/id #uuid "32d225e8-4f0c-59f9-8321-143a8679ecc9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.256 \\\\ 0.744\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-94e347aa-0aab-5548-a61d-fa864e54a8eb" :answer/id #uuid "94e347aa-0aab-5548-a61d-fa864e54a8eb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.322 \\\\ 0.678\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-8271e0f5-ad00-5357-b8f4-39e3fffd35ad" :question/id #uuid "8271e0f5-ad00-5357-b8f4-39e3fffd35ad" :question/math-academy-id "q-135449" :question/problem "$$\nP=[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}],\\,{x}_{0}=[\\begin{aligned}0.2 \\\\ 0.8\\end{aligned}]\n$$\n\n \n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}][\\begin{aligned}0.2 \\\\ 0.8\\end{aligned}] \\\\  & =[\\begin{aligned}0.39 \\\\ 0.61\\end{aligned}].\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}][\\begin{aligned}0.39 \\\\ 0.61\\end{aligned}] \\\\  & =[\\begin{aligned}0.333 \\\\ 0.667\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fdd5f643-5dc8-5fd7-924a-fad98f3489b8"] :db/ensure [:question/validate]} {:db/id "answer-field-fdd5f643-5dc8-5fd7-924a-fad98f3489b8" :answer-field/id #uuid "fdd5f643-5dc8-5fd7-924a-fad98f3489b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1c0b1479-7543-5906-9be5-c98b46ea8939" :answer-field/choices ["answer-ea15f24b-9cf0-5ff1-9bf9-e4b44b9c4cb0" "answer-1c0b1479-7543-5906-9be5-c98b46ea8939" "answer-9e44f886-a69a-5eb5-877d-eb9fbaded0e0" "answer-0d5a7632-a554-5190-bed3-1cebe52ce242" "answer-bd770536-c4d8-578e-9970-f59594cc8769"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea15f24b-9cf0-5ff1-9bf9-e4b44b9c4cb0" :answer/id #uuid "ea15f24b-9cf0-5ff1-9bf9-e4b44b9c4cb0" :answer/type