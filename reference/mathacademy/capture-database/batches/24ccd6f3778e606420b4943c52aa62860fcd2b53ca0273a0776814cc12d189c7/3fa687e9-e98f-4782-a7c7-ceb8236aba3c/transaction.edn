validate]} {:db/id "step-f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6" :step/id #uuid "f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6" :step/content "question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :db/ensure [:step/validate]} {:db/id "assigned-problem-c921b9c1-215e-583b-b5c1-6f40d1ba8918" :assigned-problem/id #uuid "c921b9c1-215e-583b-b5c1-6f40d1ba8918" :assigned-problem/content "multistep-f86c67b8-5ef3-50e6-9f71-b4614feb6dde" :assigned-problem/topic-coverage [17592186050517 17592186050763 17592186050975 17592186049061 17592186049394 17592186049840 17592186049930 17592186050473] :db/ensure [:assigned-problem/validate]} {:db/id "activity-fd591ceb-6ad3-5be8-a2d8-1f9aaf01adbf" :activity/id #uuid "fd591ceb-6ad3-5be8-a2d8-1f9aaf01adbf" :activity/title "Graphs of Linear Equations, Parallel and Perpendicular Lines" :activity/type :activity.type/assignment :activity/steps ["step-60560f38-76bf-5533-943c-7f76b2b4b916"] :activity/first-step "step-60560f38-76bf-5533-943c-7f76b2b4b916" :db/ensure [:activity/validate]} {:db/id "step-60560f38-76bf-5533-943c-7f76b2b4b916" :step/id #uuid "60560f38-76bf-5533-943c-7f76b2b4b916" :step/content "assigned-problem-c921b9c1-215e-583b-b5c1-6f40d1ba8918" :db/ensure [:step/validate]} {:db/id 17592186157704 :question/problem "Suppose $a=[1,\\,2]^{T}$ and $b=[-1,\\,-1]^{T}.$ Find the Manhattan distance between $a$ and $b.$\n\n${d}_{1}(a,b)=$ {{field-1}}" :question/worked-solution "Recall that the Manhattan distance is defined as\n\n$$\n{d}_{1}(a,b)=‖a-b{‖}_{1}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{1}={\\sum }_{i=1}^{N}|{v}_{i}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{1}(a,b) & =‖a-b{‖}_{1} \\\\  & ={‖[\\begin{aligned}1 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ -1\\end{aligned}]‖}_{1} \\\\  & =|1-(-1)|+|2-(-1)| \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186154794 :answer-field/correct "answer-563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer-field/choices ["answer-563e6698-12e7-517c-80a3-ae3b8a7dbd5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer/id #uuid "563e6698-12e7-517c-80a3-ae3b8a7dbd5d" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186157435 :knowledge-point/questions ["question-1902a701-3e4f-5245-87f9-f7a41d88dc2e" "question-462b7d51-6045-5919-bcf3-708ab4590d36"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1902a701-3e4f-5245-87f9-f7a41d88dc2e" :question/id #uuid "1902a701-3e4f-5245-87f9-f7a41d88dc2e" :question/math-academy-id "q-254896" :question/problem "Suppose $a=[3,\\,2]^{T},$ and $b=[1,\\,0]^{T},$ and $p=3.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{3}(a,b) & =‖a-b{‖}_{3} \\\\  & ={‖[\\begin{aligned}3 \\\\ 2\\end{aligned}]-[\\begin{aligned}1 \\\\ 0\\end{aligned}]‖}_{3} \\\\  & ={(|3-1{|}^{3}+|2-0{|}^{3})}^{1/3} \\\\  & ={16}^{1/3} \\\\  & ≈2.520.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e82930e-38a6-55d5-be72-bb77c24e88a9"] :db/ensure [:question/validate]} {:db/id "answer-field-9e82930e-38a6-55d5-be72-bb77c24e88a9" :answer-field/id #uuid "9e82930e-38a6-55d5-be72-bb77c24e88a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b5f2e898-94b7-5374-b014-a462691ec07c" :answer-field/choices ["answer-b5f2e898-94b7-5374-b014-a462691ec07c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5f2e898-94b7-5374-b014-a462691ec07c" :answer/id #uuid "b5f2e898-94b7-5374-b014-a462691ec07c" :answer/type :answer.type/math :answer/value "2.520" :db/ensure [:answer/validate]} {:db/id "question-462b7d51-6045-5919-bcf3-708ab4590d36" :question/id #uuid "462b7d51-6045-5919-bcf3-708ab4590d36" :question/math-academy-id "q-254906" :question/problem "Suppose $a=[4,\\,3,\\,1]^{T},$ and $b=[5,\\,3,\\,4]^{T},$ and $p=4.$ Find the Minkowski distance between $a$ and $b.$\n\nRounded to three decimal places, ${d}_{p}(a,b)≈$\n{{field-1}}." :question/worked-solution "Recall that the Minkowski distance is defined as\n\n$$\n{d}_{p}(a,b)=‖a-b{‖}_{p}\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{p}={({\\sum }_{i=1}^{N}|{v}_{i}{|}^{p})}^{1/p}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{4}(a,b) & =‖a-b{‖}_{4} \\\\  & ={‖[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}5 \\\\ 3 \\\\ 4\\end{aligned}]‖}_{4} \\\\  & ={(|4-5{|}^{4}+|3-3{|}^{4}+|1-4{|}^{4})}^{1/4} \\\\  & ={82}^{1/4} \\\\  & ≈3.009.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-01fb3d47-a00b-57d3-a31e-ce5dfb54248f"] :db/ensure [:question/validate]} {:db/id "answer-field-01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/id #uuid "01fb3d47-a00b-57d3-a31e-ce5dfb54248f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer-field/choices ["answer-3c4e00a7-9e21-5e82-95d0-df00dc452258"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/id #uuid "3c4e00a7-9e21-5e82-95d0-df00dc452258" :answer/type :answer.type/math :answer/value "3.009" :db/ensure [:answer/validate]} {:db/id 17592186157436 :knowledge-point/questions ["question-d6f36bc2-1e9d-59b6-b406-9f6515dd271d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :question/id #uuid "d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :question/math-academy-id "q-254908" :question/problem "Suppose $a=[2,\\,-7,\\,1]^{T}$ and $b=[-3,\\,-1,\\,5]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}2 \\\\ -7 \\\\ 1\\end{aligned}]-[\\begin{aligned}-3 \\\\ -1 \\\\ 5\\end{aligned}]‖}_{\\infty } \\\\  & =max(|2-(-3)|,|-7-(-1)|,|1-5|) \\\\  & =max(5,6,4) \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a03b69e0-c573-57f3-bd3a-5e82ec61e1fc"] :db/ensure [:question/validate]} {:db/id "answer-field-a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/id #uuid "a03b69e0-c573-57f3-bd3a-5e82ec61e1fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-93af4894-4929-5ba8-9e52-45ac424912a6" :answer-field/choices ["answer-93af4894-4929-5ba8-9e52-45ac424912a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-93af4894-4929-5ba8-9e52-45ac424912a6" :answer/id #uuid "93af4894-4929-5ba8-9e52-45ac424912a6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186157711 :question/problem "Suppose $a=[1,\\,-2]^{T}$ and $b=[-7,\\,8]^{T}.$ Find the Chebyshev distance between $a$ and $b.$\n\n${d}_{\\infty }(a,b)=$\n{{field-1}}" :question/worked-solution "Recall that the Chebyshev distance is defined as\n\n$$\n{d}_{\\infty }(a,b)=‖a-b{‖}_{\\infty }\n$$\n\nwhere for an $N$-dimensional vector $v,$\n\n$$\n‖v{‖}_{\\infty }=max(|{v}_{1}|,|{v}_{2}|,…,|{v}_{N}|).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{d}_{\\infty }(a,b) & =‖a-b{‖}_{\\infty } \\\\  & ={‖[\\begin{aligned}1 \\\\ -2\\end{aligned}]-[\\begin{aligned}-7 \\\\ 8\\end{aligned}]‖}_{\\infty } \\\\  & =max(|1-(-7)|,|-2-8|) \\\\  & =max(8,10) \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186154801 :answer-field/correct "answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer-field/choices ["answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/id #uuid "f6122a7a-6b67-5f19-8a75-76dd0a6dbb78" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "activity-5cfa171d-648e-5b65-a7a3-0d1f2fa3f65e" :activity/id #uuid "5cfa171d-648e-5b65-a7a3-0d1f2fa3f65e" :activity/title "Euclidean, Manhattan, and Minkowski Distance" :activity/type :activity.type/review :activity/scope 17592186050758 :activity/course 17592186046658 :activity/steps ["step-c444da4c-44ac-5f49-8b70-be92ed835d02" "step-02cb4930-9c19-5e79-99d9-884aeb31e740" "step-bd5a0f87-45ff-50ef-be33-1a497ab9f146" "step-26dd523e-2570-57bc-9b19-e96332194fb9" "step-a804594d-fc98-5747-be7f-efa9fc4ebf6a"] :activity/first-step "step-c444da4c-44ac-5f49-8b70-be92ed835d02" :db/ensure [:activity/validate]} {:db/id "step-c444da4c-44ac-5f49-8b70-be92ed835d02" :step/id #uuid "c444da4c-44ac-5f49-8b70-be92ed835d02" :step/content 17592186157704 :step/next "step-02cb4930-9c19-5e79-99d9-884aeb31e740" :db/ensure [:step/validate]} {:db/id "step-02cb4930-9c19-5e79-99d9-884aeb31e740" :step/id #uuid "02cb4930-9c19-5e79-99d9-884aeb31e740" :step/content "question-1902a701-3e4f-5245-87f9-f7a41d88dc2e" :step/next "step-bd5a0f87-45ff-50ef-be33-1a497ab9f146" :db/ensure [:step/validate]} {:db/id "step-bd5a0f87-45ff-50ef-be33-1a497ab9f146" :step/id #uuid "bd5a0f87-45ff-50ef-be33-1a497ab9f146" :step/content "question-462b7d51-6045-5919-bcf3-708ab4590d36" :step/next "step-26dd523e-2570-57bc-9b19-e96332194fb9" :db/ensure [:step/validate]} {:db/id "step-26dd523e-2570-57bc-9b19-e96332194fb9" :step/id #uuid "26dd523e-2570-57bc-9b19-e96332194fb9" :step/content "question-d6f36bc2-1e9d-59b6-b406-9f6515dd271d" :step/next "step-a804594d-fc98-5747-be7f-efa9fc4ebf6a" :db/ensure [:step/validate]} {:db/id "step-a804594d-fc98-5747-be7f-efa9fc4ebf6a" :step/id #uuid "a804594d-fc98-5747-be7f-efa9fc4ebf6a" :step/content 17592186157711 :db/ensure [:step/validate]} [:db/retract 17592186097262 :question/answer-fields 17592186095496] {:db/id 17592186096632 :knowledge-point/questions ["question-0eabe319-fbfe-5f66-832c-db699322266a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096631 :knowledge-point/questions ["question-fea7dc0c-332b-5e65-b34c-aa74602e656a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186393250 :question/problem "What is ${\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{ln}⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}\\operatorname{ln}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186393254 :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/ensure [:answer/validate]} {:db/id 17592186393252 :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/ensure [:answer/validate]} {:db/id 17592186393256 :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/ensure [:answer/validate]} {:db/id "question-fea7dc0c-332b-5e65-b34c-aa74602e656a" :question/id #uuid "fea7dc0c-332b-5e65-b34c-aa74602e656a" :question/math-academy-id "q-113885" :question/problem "What is ${\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+1)^{2},$ the lower bound is $a=2,$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+i\\cdot \\frac{2}{n})\\,\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+\\frac{2i}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{2i}{n}+1)}^{2}\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2bc5e161-63d6-5b2f-8b4b-8f2692b551e3"] :db/ensure [:question/validate]} {:db/id "answer-field-2bc5e161-63d6-5b2f-8b4b-8f2692b551e3" :answer-field/id #uuid "2bc5e161-63d6-5b2f-8b4b-8f2692b551e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-34501985-19ea-50dc-8d60-3b788c0405c5" :answer-field/choices ["answer-51e949c9-0d0e-5fdb-bb95-ab16798be0f2" "answer-dfa0ac59-d407-5702-ab18-aa0299efd7dc" "answer-6591ea6e-2346-5c79-acf4-89b87782b7b7" "answer-34501985-19ea-50dc-8d60-3b788c0405c5" "answer-28f1f4b7-57c0-56e1-a117-8415a85c841e"] :db/ensure [:answer-field/validate]} {:db/id "answer-51e949c9-0d0e-5fdb-bb95-ab16798be0f2" :answer/id #uuid "51e949c9-0d0e-5fdb-bb95-ab16798be0f2" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "answer-dfa0ac59-d407-5702-ab18-aa0299efd7dc" :answer/id #uuid "dfa0ac59-d407-5702-ab18-aa0299efd7dc" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{4i}{n})}^{2}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "answer-6591ea6e-2346-5c79-acf4-89b87782b7b7" :answer/id #uuid "6591ea6e-2346-5c79-acf4-89b87782b7b7" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(1+\\frac{i}{n})}^{2}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "answer-34501985-19ea-50dc-8d60-3b788c0405c5" :answer/id #uuid "34501985-19ea-50dc-8d60-3b788c0405c5" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "answer-28f1f4b7-57c0-56e1-a117-8415a85c841e" :answer/id #uuid "28f1f4b7-57c0-56e1-a117-8415a85c841e" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(3+\\frac{2i}{n})}^{2}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "question-0eabe319-fbfe-5f66-832c-db699322266a" :question/id #uuid "0eabe319-fbfe-5f66-832c-db699322266a" :question/math-academy-id "q-114899" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[4{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{1}{n}.$ Therefore, \n\n$$\n\\frac{1}{n}=\\frac{b-2}{n}\\,⟹\\,b=3.\n$$\n\nConsequently,  ${x}_{k}=2+\\frac{k}{n}$ and $f({x}_{k})=4{x}_{k}^{3}.$\n\nHence,\n\n$$\n{\\int }_{2}^{3}4{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[4{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=4{x}^{3}$ and $b=3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0a33f6fd-b93c-5b4f-b219-979a3489cf29"] :db/ensure [:question/validate]} {:db/id "answer-field-0a33f6fd-b93c-5b4f-b219-979a3489cf29" :answer-field/id #uuid "0a33f6fd-b93c-5b4f-b219-979a3489cf29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2a12a2b-40b0-5e22-9231-966dc3b78cb8" :answer-field/choices ["answer-b72f4429-d885-5f60-880a-67e28d6f6c64" "answer-a2a12a2b-40b0-5e22-9231-966dc3b78cb8" "answer-ace7f773-c717-5546-8619-944725dddd02" "answer-726d3224-ba57-579d-ae29-183da135a7ac" "answer-67ea339c-2b2b-5d4d-87b1-7c6bc85069c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b72f4429-d885-5f60-880a-67e28d6f6c64" :answer/id #uuid "b72f4429-d885-5f60-880a-67e28d6f6c64" :answer/type :answer.type/text :answer/value "$f(x)=4x$ and $b=3$" :db/ensure [:answer/validate]} {:db/id "answer-a2a12a2b-40b0-5e22-9231-966dc3b78cb8" :answer/id #uuid "a2a12a2b-40b0-5e22-9231-966dc3b78cb8" :answer/type :answer.type/text :answer/value "$f(x)=4{x}^{3}$ and $b=3$" :db/ensure [:answer/validate]} {:db/id "answer-ace7f773-c717-5546-8619-944725dddd02" :answer/id #uuid "ace7f773-c717-5546-8619-944725dddd02" :answer/type :answer.type/text :answer/value "$f(x)=4{x}^{3}$ and $b=5$" :db/ensure [:answer/validate]} {:db/id "answer-726d3224-ba57-579d-ae29-183da135a7ac" :answer/id #uuid "726d3224-ba57-579d-ae29-183da135a7ac" :answer/type :answer.type/text :answer/value "$f(x)=x$ and $b=5$" :db/ensure [:answer/validate]} {:db/id "answer-67ea339c-2b2b-5d4d-87b1-7c6bc85069c4" :answer/id #uuid "67ea339c-2b2b-5d4d-87b1-7c6bc85069c4" :answer/type :answer.type/text :answer/value "$f(x)={x}^{3}$ and $b=3$" :db/ensure [:answer/validate]} {:db/id "activity-8c741e1d-cd57-5c83-a8c8-16d24858c4c6" :activity/id #uuid "8c741e1d-cd57-5c83-a8c8-16d24858c4c6" :activity/title "Defining Definite Integrals Using Left and Right Riemann Sums" :activity/type :activity.type/review :activity/scope 17592186048862 :activity/course 17592186046658 :activity/steps ["step-ec476d83-723f-5784-843f-4fdb55768d1b" "step-8a4c4ba2-931e-5de8-95fc-f866b5f90f9a" "step-41bf41e2-b064-5bb6-9ccc-30e9675ed161" "step-d3e0a0e9-2ae7-5e40-acb0-bc04b722390d" "step-7a912a6d-06e4-5b08-99d4-ffcd3c9c8150"] :activity/first-step "step-ec476d83-723f-5784-843f-4fdb55768d1b" :db/ensure [:activity/validate]} {:db/id "step-ec476d83-723f-5784-843f-4fdb55768d1b" :step/id #uuid "ec476d83-723f-5784-843f-4fdb55768d1b" :step/content 17592186097262 :step/next "step-8a4c4ba2-931e-5de8-95fc-f866b5f90f9a" :db/ensure [:step/validate]} {:db/id "step-8a4c4ba2-931e-5de8-95fc-f866b5f90f9a" :step/id #uuid "8a4c4ba2-931e-5de8-95fc-f866b5f90f9a" :step/content 17592186393250 :step/next "step-41bf41e2-b064-5bb6-9ccc-30e9675ed161" :db/ensure [:step/validate]} {:db/id "step-41bf41e2-b064-5bb6-9ccc-30e9675ed161" :step/id #uuid "41bf41e2-b064-5bb6-9ccc-30e9675ed161" :step/content "question-fea7dc0c-332b-5e65-b34c-aa74602e656a" :step/next "step-d3e0a0e9-2ae7-5e40-acb0-bc04b722390d" :db/ensure [:step/validate]} {:db/id "step-d3e0a0e9-2ae7-5e40-acb0-bc04b722390d" :step/id #uuid "d3e0a0e9-2ae7-5e40-acb0-bc04b722390d" :step/content 17592186233196 :step/next "step-7a912a6d-06e4-5b08-99d4-ffcd3c9c8150" :db/ensure [:step/validate]} {:db/id "step-7a912a6d-06e4-5b08-99d4-ffcd3c9c8150" :step/id #uuid "7a912a6d-06e4-5b08-99d4-ffcd3c9c8150" :step/content "question-0eabe319-fbfe-5f66-832c-db699322266a" :db/ensure [:step/validate]} {:db/id 17592186124472 :knowledge-point/questions ["question-0fa77d6e-f50d-59b7-b662-8c42e4bce6dc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124473 :knowledge-point/questions ["question-2c532f18-d5b7-5299-a745-04db386fb5cd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124284 :question/problem "![](images/d9/d965e0b1087ad45206dd9259c963609f556bf5803af47ab18006bf40dffb2557.png)\n\n     \n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nI. $(-3,-1]$\n\nII. $(0,4]$\n\nIII. $[-2,2)$" :db/ensure [:question/validate]} {:db/id 17592186124285 :question/problem "Given that $f(x)=|x-2|-2,$ on which of the following intervals is $f(x)$ invertible?\n\nI. $x \\in (-\\infty, 2]$\n\nII. $x \\in (0, \\infty)$\n\nIII. $x \\in (-1,4]$" :question/worked-solution "First, let's graph the given function. The graph of the function $f(x)=|x-2|-2$ can be obtained in the following way:  \n\n1\\. Take the curve $y=|x|.$\n\n2\\. Translate it by $2$ units to the right,  to get $y= |x-2|.$\n\n3\\. Finally, translate $y= |x-2|$ by $2$ units down to get $f(x)=|x-2|-2.$\n\n![](images/60/60c2601abfd3c4034991408f47b75c8cf70a1bccb72f73b2f9624a52d0ed7b42.png)\n\nNow, remember that a function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on the interval $x\\in(-\\infty,2].$  Indeed, on this interval, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/45/45b0cdd26280d9379a449af41edbc9e69dd9d76f3b4116d938fbe708c21f6f29.png)\n\n- The function $f(x)$ is not invertible on any of the intervals $x\\in(0,\\infty)$ and $x \\in (-1,4].$ On these intervals, some horizontal lines will intersect the curve more than once.\n\n![](images/55/55b8483c59362d3a59dfd269db74f2c5f17a97cee1f25c896ece16890d80bd42.png)\n\n  \n\nTherefore, the correct answer is \"I only\"." :db/ensure [:question/validate]} {:db/id "question-0fa77d6e-f50d-59b7-b662-8c42e4bce6dc" :question/id #uuid "0fa77d6e-f50d-59b7-b662-8c42e4bce6dc" :question/math-academy-id "q-108578" :question/problem "![](images/44/448ae88055ea0da5dd44fb3db608b5ac71dbd3709c88edd41440c15124d74eae.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](images/e5/e582f5233163be3a094ac575ba0cf2a37b417038be8894a12717ca31d401e4d6.png)\n\nFrom the above, we see that:\n\n- For graphs I, III, and IV, any horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graphs I, III, and IV show one-to-one functions. As a result, those functions are invertible.\n\n- For graph II, some horizontal lines intersect the curve more than once. So, this is not a one-to-one function. As a result, it is not invertible." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94ecf65d-6eea-53a0-9871-cc56796efb87"] :db/ensure [:question/validate]} {:db/id "answer-field-94ecf65d-6eea-53a0-9871-cc56796efb87" :answer-field/id #uuid "94ecf65d-6eea-53a0-9871-cc56796efb87" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9dfda72e-5de7-5f08-ba60-2dee3b7773a3" :answer-field/choices ["answer-ca367dad-6e0f-5b2a-8664-a393b72e3336" "answer-2a9104b9-e583-516b-be38-1ff3c0823884" "answer-9dfda72e-5de7-5f08-ba60-2dee3b7773a3" "answer-893eab73-f1c0-575a-a598-02ac6d58b02d" "answer-962e2309-e615-5b74-8ecc-42b00f58fc3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca367dad-6e0f-5b2a-8664-a393b72e3336" :answer/id #uuid "ca367dad-6e0f-5b2a-8664-a393b72e3336" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-2a9104b9-e583-516b-be38-1ff3c0823884" :answer/id #uuid "2a9104b9-e583-516b-be38-1ff3c0823884" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-9dfda72e-5de7-5f08-ba60-2dee3b7773a3" :answer/id #uuid "9dfda72e-5de7-5f08-ba60-2dee3b7773a3" :answer/type :answer.type/text :answer/value "I, III and IV only" :db/ensure [:answer/validate]} {:db/id "answer-893eab73-f1c0-575a-a598-02ac6d58b02d" :answer/id #uuid "893eab73-f1c0-575a-a598-02ac6d58b02d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-962e2309-e615-5b74-8ecc-42b00f58fc3d" :answer/id #uuid "962e2309-e615-5b74-8ecc-42b00f58fc3d" :answer/type :answer.type/text :answer/value "IV only" :db/ensure [:answer/validate]} {:db/id "question-2c532f18-d5b7-5299-a745-04db386fb5cd" :question/id #uuid "2c532f18-d5b7-5299-a745-04db386fb5cd" :question/math-academy-id "q-36939" :question/problem "![](images/c2/c25885ba540cda475b528516df948ae3a7547c91ca78a8dcf2034284c50a4ca6.png)\n\nDetermine the largest domain on which the function $f(x)$ (shown above) is invertible." :question/worked-solution "First, notice that the domain of our function is $x\\in [-4,4].$ \n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ does not pass the horizontal line test on the interval $x\\in (-1,1).$ In this case, the horizontal line $y=1$ intersects the graph at more than one point.\n\n![](images/d2/d295d104bd8340a8701327e19103bfa8fd12622f1500c405411d2afd8bd47801.png)\n\n- Among the given options, the largest domain on which the function $f(x)$ is invertible is $x\\in [-4,-1)\\cup [0,4].$ On this domain, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/a7/a74a9a3f1fe52a7c841c763ccffb51faa922fdaec56825ef1000b5becc3534fe.png)\n\n \n\nTherefore, the correct answer is $x\\in [-4,-1)\\cup [0,4].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3f4d2d26-b1de-54c9-b0f1-b5c8e35847c3"] :db/ensure [:question/validate]} {:db/id "answer-field-3f4d2d26-b1de-54c9-b0f1-b5c8e35847c3" :answer-field/id #uuid "3f4d2d26-b1de-54c9-b0f1-b5c8e35847c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e92042a-79aa-5d53-8df9-c19fc7ee5467" :answer-field/choices ["answer-2b1e68d1-3f22-5cb4-8f92-a0dc46488ea6" "answer-7e92042a-79aa-5d53-8df9-c19fc7ee5467" "answer-b4a0926f-0440-50b7-962c-1887a3857632" "answer-50b0501e-3889-5168-a08d-5e8c7260c236" "answer-d11f8ac0-77df-5beb-96a0-4cf48090a9a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b1e68d1-3f22-5cb4-8f92-a0dc46488ea6" :answer/id #uuid "2b1e68d1-3f22-5cb4-8f92-a0dc46488ea6" :answer/type :answer.type/math :answer/value "x\\in [-1,4]" :db/ensure [:answer/validate]} {:db/id "answer-7e92042a-79aa-5d53-8df9-c19fc7ee5467" :answer/id #uuid "7e92042a-79aa-5d53-8df9-c19fc7ee5467" :answer/type :answer.type/math :answer/value "x\\in [-4,-1)\\cup [0,4]" :db/ensure [:answer/validate]} {:db/id "answer-b4a0926f-0440-50b7-962c-1887a3857632" :answer/id #uuid "b4a0926f-0440-50b7-962c-1887a3857632" :answer/type :answer.type/math :answer/value "x\\in [-4,-1]" :db/ensure [:answer/validate]} {:db/id "answer-50b0501e-3889-5168-a08d-5e8c7260c236" :answer/id #uuid "50b0501e-3889-5168-a08d-5e8c7260c236" :answer/type :answer.type/math :answer/value "x\\in [-4,4]" :db/ensure [:answer/validate]} {:db/id "answer-d11f8ac0-77df-5beb-96a0-4cf48090a9a7" :answer/id #uuid "d11f8ac0-77df-5beb-96a0-4cf48090a9a7" :answer/type :answer.type/math :answer/value "x\\in [0,4]" :db/ensure [:answer/validate]} {:db/id 17592186124694 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-da781ab0-9d0b-5ced-bd4a-ef1b4dbeec15" :activity/id #uuid "da781ab0-9d0b-5ced-bd4a-ef1b4dbeec15" :activity/title "Change of Variables in Quadratic Forms" :activity/type :activity.type/review :activity/scope 17592186048300 :activity/course 17592186046658 :activity/steps ["step-37c7cf3a-8392-5826-b9ec-d90c9519cc93" "step-d147e2e2-aa64-5057-9352-9369e34a44e5" "step-e7ce4ba0-2394-5109-8b2f-c042da1d0452" "step-64524a47-5e0e-5053-bd6f-0e2b585cdcb5" "step-22274fb1-dba1-5685-b7c6-d45b7e3adb09"] :activity/first-step "step-37c7cf3a-8392-5826-b9ec-d90c9519cc93" :db/ensure [:activity/validate]} {:db/id "step-37c7cf3a-8392-5826-b9ec-d90c9519cc93" :step/id #uuid "37c7cf3a-8392-5826-b9ec-d90c9519cc93" :step/content 17592186162602 :step/next "step-d147e2e2-aa64-5057-9352-9369e34a44e5" :db/ensure [:step/validate]} {:db/id "step-d147e2e2-aa64-5057-9352-9369e34a44e5" :step/id #uuid "d147e2e2-aa64-5057-9352-9369e34a44e5" :step/content 17592186357678 :step/next "step-e7ce4ba0-2394-5109-8b2f-c042da1d0452" :db/ensure [:step/validate]} {:db/id "step-e7ce4ba0-2394-5109-8b2f-c042da1d0452" :step/id #uuid "e7ce4ba0-2394-5109-8b2f-c042da1d0452" :step/content 17592186162621 :step/next "step-64524a47-5e0e-5053-bd6f-0e2b585cdcb5" :db/ensure [:step/validate]} {:db/id "step-64524a47-5e0e-5053-bd6f-0e2b585cdcb5" :step/id #uuid "64524a47-5e0e-5053-bd6f-0e2b585cdcb5" :step/content 17592186378025 :step/next "step-22274fb1-dba1-5685-b7c6-d45b7e3adb09" :db/ensure [:step/validate]} {:db/id "step-22274fb1-dba1-5685-b7c6-d45b7e3adb09" :step/id #uuid "22274fb1-dba1-5685-b7c6-d45b7e3adb09" :step/content 17592186394929 :db/ensure [:step/validate]} [:db/retract 17592186113983 :answer-field/choices 17592186113984] [:db/retract 17592186113983 :answer-field/choices 17592186113985] [:db/retract 17592186113983 :answer-field/choices 17592186113986] [:db/retract 17592186113983 :answer-field/choices 17592186113987] [:db/retract 17592186113983 :answer-field/choices 17592186113988] {:db/id 17592186115243 :knowledge-point/questions ["question-dd52658d-d0dc-5c1e-b084-552fde414f6a" "question-7abe0f71-31aa-5c86-a7a0-fa2df71ee9ab" "question-3a9d38f9-b939-5805-88eb-ef96ffddb725"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dd52658d-d0dc-5c1e-b084-552fde414f6a" :question/id #uuid "dd52658d-d0dc-5c1e-b084-552fde414f6a" :question/math-academy-id "q-130775" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:=(-2){R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{2}:=(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}] \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $C$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:={R}_{1}+(-1){R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}] \\\\  & =C\\end{aligned}\n$$\n\nTherefore, only $A$ and $C$ are elementary matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1767fe4-e53c-5579-92c4-0975b0bb4129"] :db/ensure [:question/validate]} {:db/id "answer-field-d1767fe4-e53c-5579-92c4-0975b0bb4129" :answer-field/id #uuid "d1767fe4-e53c-5579-92c4-0975b0bb4129" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0dfb83d-8ab3-5bf3-b0c6-cf693a27a6c8" :answer-field/choices ["answer-f0dfb83d-8ab3-5bf3-b0c6-cf693a27a6c8" "answer-fb20b7d7-1969-5e7b-b0bc-77ea754ddb15" "answer-ae49d544-bd4f-5e14-976f-0cf55c49ae03" "answer-4b3907f9-1f0a-5178-9e3a-4ced32f85e38" "answer-9fb9592e-f39c-550c-bee2-e4351328d285"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0dfb83d-8ab3-5bf3-b0c6-cf693a27a6c8" :answer/id #uuid "f0dfb83d-8ab3-5bf3-b0c6-cf693a27a6c8" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "answer-fb20b7d7-1969-5e7b-b0bc-77ea754ddb15" :answer/id #uuid "fb20b7d7-1969-5e7b-b0bc-77ea754ddb15" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "answer-ae49d544-bd4f-5e14-976f-0cf55c49ae03" :answer/id #uuid "ae49d544-bd4f-5e14-976f-0cf55c49ae03" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "answer-4b3907f9-1f0a-5178-9e3a-4ced32f85e38" :answer/id #uuid "4b3907f9-1f0a-5178-9e3a-4ced32f85e38" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "answer-9fb9592e-f39c-550c-bee2-e4351328d285" :answer/id #uuid "9fb9592e-f39c-550c-bee2-e4351328d285" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "question-7abe0f71-31aa-5c86-a7a0-fa2df71ee9ab" :question/id #uuid "7abe0f71-31aa-5c86-a7a0-fa2df71ee9ab" :question/math-academy-id "q-42756" :question/problem "Which of the following are **not** elementary matrices?\n\n$$\nH=[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}],\\,K=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,N=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $H$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:={R}_{2}+5{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}] \\\\  & =H\\end{aligned}\n$$\n\n- The matrix $K$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}↔{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}] \\\\  & =K\\end{aligned}\n$$\n\n- The matrix $N$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\nTherefore, only $N$ is not an elementary matrix." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4e59a97-7099-5d85-88ab-f4f7fe7124bb"] :db/ensure [:question/validate]} {:db/id "answer-field-f4e59a97-7099-5d85-88ab-f4f7fe7124bb" :answer-field/id #uuid "f4e59a97-7099-5d85-88ab-f4f7fe7124bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2009ffbb-834a-5c7a-8a8b-959aa0b24db2" :answer-field/choices ["answer-c4a6f7a8-a40b-5e83-8bb3-7321150a3ccc" "answer-40c3d139-ddd9-5cf3-80a9-cb1261eea249" "answer-65e51982-290b-5109-8387-cd14e01378eb" "answer-44c29b3a-55ca-586c-873f-1a2bc7582a6d" "answer-2009ffbb-834a-5c7a-8a8b-959aa0b24db2"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4a6f7a8-a40b-5e83-8bb3-7321150a3ccc" :answer/id #uuid "c4a6f7a8-a40b-5e83-8bb3-7321150a3ccc" :answer/type :answer.type/text :answer/value "$H$ and $K$ only" :db/ensure [:answer/validate]} {:db/id "answer-40c3d139-ddd9-5cf3-80a9-cb1261eea249" :answer/id #uuid "40c3d139-ddd9-5cf3-80a9-cb1261eea249" :answer/type :answer.type/text :answer/value "$H$ only" :db/ensure [:answer/validate]} {:db/id "answer-65e51982-290b-5109-8387-cd14e01378eb" :answer/id #uuid "65e51982-290b-5109-8387-cd14e01378eb" :answer/type :answer.type/text :answer/value "$K$ and $N$ only" :db/ensure [:answer/validate]} {:db/id "answer-44c29b3a-55ca-586c-873f-1a2bc7582a6d" :answer/id #uuid "44c29b3a-55ca-586c-873f-1a2bc7582a6d" :answer/type :answer.type/text :answer/value "$K$ only" :db/ensure [:answer/validate]} {:db/id "answer-2009ffbb-834a-5c7a-8a8b-959aa0b24db2" :answer/id #uuid "2009ffbb-834a-5c7a-8a8b-959aa0b24db2" :answer/type :answer.type/text :answer/value "$N$ only" :db/ensure [:answer/validate]} {:db/id "question-3a9d38f9-b939-5805-88eb-ef96ffddb725" :question/id #uuid "3a9d38f9-b939-5805-88eb-ef96ffddb725" :question/math-academy-id "q-42754" :question/problem "Which of the following are elementary matrices?\n\n$$\nT=[\\begin{aligned}0 & 1 \\\\ 1 & 3\\end{aligned}],\\,U=[\\begin{aligned}9 & 0 \\\\ 0 & 1\\end{aligned}],\\,X=[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $T$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $U$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:=9{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}:=9{R}_{1} \\\\  & ∼[\\begin{aligned}9 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\n- The matrix $X$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:={R}_{1}+3{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}] \\\\  & =X\\end{aligned}\n$$\n\nTherefore, only $U$ and $X$ are elementary matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0f0fef4-e8e5-5e33-982a-88aa1db63724"] :db/ensure [:question/validate]} {:db/id "answer-field-b0f0fef4-e8e5-5e33-982a-88aa1db63724" :answer-field/id #uuid "b0f0fef4-e8e5-5e33-982a-88aa1db63724" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c605cbc3-363f-5199-936d-cf502df10aa1" :answer-field/choices ["answer-6f096b5f-39c2-585d-9076-e381a97ad95f" "answer-95ac74e0-7781-595b-b1cb-5685696d0923" "answer-c605cbc3-363f-5199-936d-cf502df10aa1" "answer-ace569a1-cdae-5f8a-b5cb-eb5a89edde5d" "answer-9c9ae38d-468e-5c1b-a879-895b482ed7aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f096b5f-39c2-585d-9076-e381a97ad95f" :answer/id #uuid "6f096b5f-39c2-585d-9076-e381a97ad95f" :answer/type :answer.type/text :answer/value "$T$ and $U$ only" :db/ensure [:answer/validate]} {:db/id "answer-95ac74e0-7781-595b-b1cb-5685696d0923" :answer/id #uuid "95ac74e0-7781-595b-b1cb-5685696d0923" :answer/type :answer.type/text :answer/value "$T$ and $X$ only" :db/ensure [:answer/validate]} {:db/id "answer-c605cbc3-363f-5199-936d-cf502df10aa1" :answer/id #uuid "c605cbc3-363f-5199-936d-cf502df10aa1" :answer/type :answer.type/text :answer/value "$U$ and $X$ only" :db/ensure [:answer/validate]} {:db/id "answer-ace569a1-cdae-5f8a-b5cb-eb5a89edde5d" :answer/id #uuid "ace569a1-cdae-5f8a-b5cb-eb5a89edde5d" :answer/type :answer.type/text :answer/value "$U$ only" :db/ensure [:answer/validate]} {:db/id "answer-9c9ae38d-468e-5c1b-a879-895b482ed7aa" :answer/id #uuid "9c9ae38d-468e-5c1b-a879-895b482ed7aa" :answer/type :answer.type/text :answer/value "$X$ only" :db/ensure [:answer/validate]} {:db/id 17592186115244 :knowledge-point/questions ["question-6ad7a8de-9677-5fd6-a871-171f20886f2e" "question-3df63019-7de5-5b3e-afc6-d7a9e953df1d" "question-7effc142-a727-5443-a7a6-2e2db67c4b1f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ad7a8de-9677-5fd6-a871-171f20886f2e" :question/id #uuid "6ad7a8de-9677-5fd6-a871-171f20886f2e" :question/math-academy-id "q-130788" :question/problem "Find the inverse of the elementary matrix \n$N=[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{12}\\end{aligned}].$" :question/worked-solution "We write down $N$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[N\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & \\frac{1}{12} & 0 & 1\\end{aligned}] &  & {R}_{2}:=12{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 12\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{N}^{-1}=[\\begin{aligned}1 & 0 \\\\ 0 & 12\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f732bcd0-c8c8-5638-93ed-8a183c2c0d4b"] :db/ensure [:question/validate]} {:db/id "answer-field-f732bcd0-c8c8-5638-93ed-8a183c2c0d4b" :answer-field/id #uuid "f732bcd0-c8c8-5638-93ed-8a183c2c0d4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b50b8760-3a6d-55c4-a188-c37cf457dc61" :answer-field/choices ["answer-f98c45d9-1ef2-58e4-b974-3eb63756e062" "answer-32904df2-4f2b-512e-b905-4f4eebcb813e" "answer-b50b8760-3a6d-55c4-a188-c37cf457dc61" "answer-e8fc2b8c-e26a-5dd7-a42a-b9a4b347b89f" "answer-ffcf0b97-a0e4-515d-9606-6b57bb04f711"] :db/ensure [:answer-field/validate]}