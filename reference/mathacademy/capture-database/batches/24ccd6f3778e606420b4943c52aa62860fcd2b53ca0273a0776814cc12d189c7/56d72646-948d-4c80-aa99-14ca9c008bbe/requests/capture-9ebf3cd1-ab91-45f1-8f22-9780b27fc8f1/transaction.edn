ff87cfb699da7aae47f6dc6b.png)\n\n- Then, translate the result down by $3$ units to get the graph of $y=f(-x)-3.$\n\n![](images/1b/1b81c0a3c72fa80d35d5dccb462afeb2ba3f1b05c10f009f300fdfd170ed9e76.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fcc2d5ce-3092-541f-9a44-9ec3c17048dd"] :db/ensure [:question/validate]} {:db/id "answer-field-fcc2d5ce-3092-541f-9a44-9ec3c17048dd" :answer-field/id #uuid "fcc2d5ce-3092-541f-9a44-9ec3c17048dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8db3dfee-3c44-5016-97ff-b3ac6e0829e9" :answer-field/choices ["answer-8db3dfee-3c44-5016-97ff-b3ac6e0829e9" "answer-9b682db4-c5bc-55ad-815f-35e7b603f519" "answer-b71d69d2-b2d2-552c-8115-33bbaa83b60c" "answer-ee93e1f6-2578-53aa-9de8-61504b1abcb1" "answer-75123df3-af0c-5326-b6f0-9b5d2c22d9d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-8db3dfee-3c44-5016-97ff-b3ac6e0829e9" :answer/id #uuid "8db3dfee-3c44-5016-97ff-b3ac6e0829e9" :answer/type :answer.type/image :answer/value "images/54/54dd2266860cfb63305f51c619efa1668b63648864734149db944f9bc99d918c.png" :db/ensure [:answer/validate]} {:db/id "answer-9b682db4-c5bc-55ad-815f-35e7b603f519" :answer/id #uuid "9b682db4-c5bc-55ad-815f-35e7b603f519" :answer/type :answer.type/image :answer/value "images/59/5965dff24b2e580ff2da7abbdd979fb3d115cca22a43f8a4967e4b52e3c3af71.png" :db/ensure [:answer/validate]} {:db/id "answer-b71d69d2-b2d2-552c-8115-33bbaa83b60c" :answer/id #uuid "b71d69d2-b2d2-552c-8115-33bbaa83b60c" :answer/type :answer.type/image :answer/value "images/5b/5b22220a4cbf56ee3d66fffae33296839fa5fbf4f29007f56af21ff1cb9f3931.png" :db/ensure [:answer/validate]} {:db/id "answer-ee93e1f6-2578-53aa-9de8-61504b1abcb1" :answer/id #uuid "ee93e1f6-2578-53aa-9de8-61504b1abcb1" :answer/type :answer.type/image :answer/value "images/ba/ba2ad56b699c4972573bbd21f98b3f2d22b5f3d8a1fd137abd72726820add92b.png" :db/ensure [:answer/validate]} {:db/id "answer-75123df3-af0c-5326-b6f0-9b5d2c22d9d4" :answer/id #uuid "75123df3-af0c-5326-b6f0-9b5d2c22d9d4" :answer/type :answer.type/image :answer/value "images/d6/d64709985bf84c411cce9d99c375cdfc6a81db58f8096c1e23be4fbbb37f8cdb.png" :db/ensure [:answer/validate]} {:db/id "question-689e7bfc-91b5-5578-9523-c9029e296a11" :question/id #uuid "689e7bfc-91b5-5578-9523-c9029e296a11" :question/math-academy-id "q-97940" :question/problem "![](images/e5/e5138b92d20572b1680dfc010d6e0f8729de9c21c62448cdcb472efbf762c4d1.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(-2x)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=f(-(2x))\n$$\n\nTo plot $y=-f(-(2x)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{2}$ parallel to the $x$-axis to get the graph of $y=f(2x).$\n\n![](images/7d/7d76ce80b4212d0cb6cd8b64c424492dd46cad3819ce3cba17bab22c4df115f5.png)\n\n- Then, reflect the result across the $y$-axis to get the graph of $y=f(-2x).$\n\n![](images/de/ded37839584d99725ab44ebfb4e60e05ea162da6a3845817aa96f6904d67146a.png)\n\n- Finally, reflect the result across the $x$-axis to get the graph of $y=-f(-2x).$\n\n![](images/6f/6f16d9eed1ed1b5fa41c46124f775238ecb759d79261cc66073c1fb304deb468.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ea82b50a-93b2-5cb1-8254-45300689e485"] :db/ensure [:question/validate]} {:db/id "answer-field-ea82b50a-93b2-5cb1-8254-45300689e485" :answer-field/id #uuid "ea82b50a-93b2-5cb1-8254-45300689e485" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8fadb2c0-6442-5a83-af82-c9a725055c8f" :answer-field/choices ["answer-8fadb2c0-6442-5a83-af82-c9a725055c8f" "answer-1b95e52b-0904-5971-bbc3-a4919450f05c" "answer-04e27a6e-92cf-578c-9e8a-3a5d5cbe0c3d" "answer-be5af0ba-9b31-5fec-8893-b738ec606742" "answer-029bdf82-6366-59d5-8cfa-a391eed8c109"] :db/ensure [:answer-field/validate]} {:db/id "answer-8fadb2c0-6442-5a83-af82-c9a725055c8f" :answer/id #uuid "8fadb2c0-6442-5a83-af82-c9a725055c8f" :answer/type :answer.type/image :answer/value "images/1b/1b691a987508ea114f1020a0d66b3c80558539a0a16ee7bf9f4fd6c0b77b5ed4.png" :db/ensure [:answer/validate]} {:db/id "answer-1b95e52b-0904-5971-bbc3-a4919450f05c" :answer/id #uuid "1b95e52b-0904-5971-bbc3-a4919450f05c" :answer/type :answer.type/image :answer/value "images/39/39e8c399a890e3528289fa569c828d4f4ba27ebc08d52a279c24ca3f130414ed.png" :db/ensure [:answer/validate]} {:db/id "answer-04e27a6e-92cf-578c-9e8a-3a5d5cbe0c3d" :answer/id #uuid "04e27a6e-92cf-578c-9e8a-3a5d5cbe0c3d" :answer/type :answer.type/image :answer/value "images/94/94ebe249199debf2f62fd62ff878d6a8e6207381dcf9474f48e28a35f3046278.png" :db/ensure [:answer/validate]} {:db/id "answer-be5af0ba-9b31-5fec-8893-b738ec606742" :answer/id #uuid "be5af0ba-9b31-5fec-8893-b738ec606742" :answer/type :answer.type/image :answer/value "images/bd/bd7a0fb52338c43267c8e5be22e49796b4170ff83f0e184b09519ebbaeb67c21.png" :db/ensure [:answer/validate]} {:db/id "answer-029bdf82-6366-59d5-8cfa-a391eed8c109" :answer/id #uuid "029bdf82-6366-59d5-8cfa-a391eed8c109" :answer/type :answer.type/image :answer/value "images/e7/e7a483986183ee2e4cbbc74af0432d5a43d6daeab23dd342830f6a31482a7599.png" :db/ensure [:answer/validate]} {:db/id "question-f73ff2c0-b98a-5833-8e43-d855656798f9" :question/id #uuid "f73ff2c0-b98a-5833-8e43-d855656798f9" :question/math-academy-id "q-114069" :question/problem "![](images/93/938babc27340209a1a5477fb3184abbf155f409c520c76995c4e234f99691347.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(\\frac{x}{3})?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-f(\\frac{x}{3}),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{3})}=3$ parallel to the $x$-axis to get the graph of $y=f(\\frac{x}{3}).$\n\n![](images/f0/f0b289d42620a275eeb90d4bdbe265ca92ea4264de70ecc11e5f661a84149628.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-f(\\frac{x}{3}).$\n\n![](images/59/597ba19a0c993ea597ecd091df02d97e974364125c79780df04aef365442abb6.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-16b058af-5b74-55ea-8310-41c6fb4502e8"] :db/ensure [:question/validate]} {:db/id "answer-field-16b058af-5b74-55ea-8310-41c6fb4502e8" :answer-field/id #uuid "16b058af-5b74-55ea-8310-41c6fb4502e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-06c9dab7-2e99-5365-b6f9-2f92a770a384" :answer-field/choices ["answer-06c9dab7-2e99-5365-b6f9-2f92a770a384" "answer-56a351e4-0067-508f-9e5a-e7e8908908cd" "answer-11d75bbb-77b6-5e55-baef-b5f3c412881a" "answer-89c6681c-3b74-5712-ac28-f5586469ed52" "answer-e204c221-f408-5b2f-b387-49819b320673"] :db/ensure [:answer-field/validate]} {:db/id "answer-06c9dab7-2e99-5365-b6f9-2f92a770a384" :answer/id #uuid "06c9dab7-2e99-5365-b6f9-2f92a770a384" :answer/type :answer.type/image :answer/value "images/0e/0e49310e5441552232d841954e95fe3b38015b27565050fbd384d54b35a56bfc.png" :db/ensure [:answer/validate]} {:db/id "answer-56a351e4-0067-508f-9e5a-e7e8908908cd" :answer/id #uuid "56a351e4-0067-508f-9e5a-e7e8908908cd" :answer/type :answer.type/image :answer/value "images/3d/3d4a416592d9fe3683f6b39bb99ebef44d3f0b36c37b50f86c9dac5fa8aa862f.png" :db/ensure [:answer/validate]} {:db/id "answer-11d75bbb-77b6-5e55-baef-b5f3c412881a" :answer/id #uuid "11d75bbb-77b6-5e55-baef-b5f3c412881a" :answer/type :answer.type/image :answer/value "images/8f/8f8f679798bf48d8543522dfc3c77c25de4ebfd55618c17ea033549caea2f40a.png" :db/ensure [:answer/validate]} {:db/id "answer-89c6681c-3b74-5712-ac28-f5586469ed52" :answer/id #uuid "89c6681c-3b74-5712-ac28-f5586469ed52" :answer/type :answer.type/image :answer/value "images/d2/d2dad7c3e898a680e07eba09d822733619f1158f9877136ba11078e90cbf75c2.png" :db/ensure [:answer/validate]} {:db/id "answer-e204c221-f408-5b2f-b387-49819b320673" :answer/id #uuid "e204c221-f408-5b2f-b387-49819b320673" :answer/type :answer.type/image :answer/value "images/eb/eb85e0857a24ae273e7e768c51e80c08461be095e502e45c2c83e7340bf725b2.png" :db/ensure [:answer/validate]} {:db/id "question-2b3b851a-20c6-5158-b86d-a090b5acc8fc" :question/id #uuid "2b3b851a-20c6-5158-b86d-a090b5acc8fc" :question/math-academy-id "q-115018" :question/problem "![](images/5b/5b3e36d9b39fcc8d61fe30219d2f3191a1b305a44995b27d5daddb5f18926e02.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(x-2)-4?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-f(x-2)-4,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Translate it by $2$ units to the right to get the graph of $y=f(x-2).$\n\n![](images/48/482f1dc55995a299b21894c0ec191c0f8fb8213038cdc5f80da1e77a0d64af4e.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-f(x-2).$\n\n![](images/a2/a2832ebdf82e2a7bfddccf24fd598758e1ce86fc0726f9c128503574b09fcd0b.png)\n\n- Finally, translate it down by $4$ units to get the graph of $y=-f(x-2)-4.$\n\n![](images/94/9473b7ebfbe7db3d1cfefcf3f7b616ffec4b9ad2e685a6fc40f4560e8d2a1c59.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aeba0eb8-45b2-596a-a008-a7c9b43c3677"] :db/ensure [:question/validate]} {:db/id "answer-field-aeba0eb8-45b2-596a-a008-a7c9b43c3677" :answer-field/id #uuid "aeba0eb8-45b2-596a-a008-a7c9b43c3677" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c61c420-b613-5fa5-9767-aa23853b7af8" :answer-field/choices ["answer-3c61c420-b613-5fa5-9767-aa23853b7af8" "answer-b8d290dd-50f1-5bb7-9b1b-db031ef83878" "answer-f9bd2436-35ce-568b-8676-99947a0269b5" "answer-be653d9c-7610-5fa4-ae30-fe00750e5ab8" "answer-65fec13d-35d9-52cc-a4e8-f31af1e88cfb"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c61c420-b613-5fa5-9767-aa23853b7af8" :answer/id #uuid "3c61c420-b613-5fa5-9767-aa23853b7af8" :answer/type :answer.type/image :answer/value "images/2d/2d8a417e4b26d0683eda81d753f68a5d98ec42f4c7963490a0a3d3948a3c9d3d.png" :db/ensure [:answer/validate]} {:db/id "answer-b8d290dd-50f1-5bb7-9b1b-db031ef83878" :answer/id #uuid "b8d290dd-50f1-5bb7-9b1b-db031ef83878" :answer/type :answer.type/image :answer/value "images/49/49a77258ee0af7b356079e9f233ddb9bf81a77442e01c1a677b4ac442a2440d0.png" :db/ensure [:answer/validate]} {:db/id "answer-f9bd2436-35ce-568b-8676-99947a0269b5" :answer/id #uuid "f9bd2436-35ce-568b-8676-99947a0269b5" :answer/type :answer.type/image :answer/value "images/69/698ed28a31a3f81ab1fa8d7a8eb017dba9ecc2c4e2d677bb74ec4d98888745a2.png" :db/ensure [:answer/validate]} {:db/id "answer-be653d9c-7610-5fa4-ae30-fe00750e5ab8" :answer/id #uuid "be653d9c-7610-5fa4-ae30-fe00750e5ab8" :answer/type :answer.type/image :answer/value "images/ae/aecf2160494e12ae8a73bcef802aeec9c61d59f59d81ab9533cbda9edcfc8b44.png" :db/ensure [:answer/validate]} {:db/id "answer-65fec13d-35d9-52cc-a4e8-f31af1e88cfb" :answer/id #uuid "65fec13d-35d9-52cc-a4e8-f31af1e88cfb" :answer/type :answer.type/image :answer/value "images/fb/fb61bbc5809f3164d23db34848e8d634807489dd48f17f81ba7311ac24ee19fe.png" :db/ensure [:answer/validate]} {:db/id "question-269fb630-a40e-5592-b4e3-251a076c8d27" :question/id #uuid "269fb630-a40e-5592-b4e3-251a076c8d27" :question/math-academy-id "q-17782" :question/problem "![](images/ef/efc577f386353b4120dec733e5e6a627ad2412744dce4d71deba2b500a1edec2.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(\\frac{1}{2}x-1)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=-f(\\frac{1}{2}(x-2))\n$$\n\nTo plot $y=-f(\\frac{1}{2}(x-2)),$ we apply the following steps: \n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{2})}=2$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{2}x).$\n\n![](images/28/2891d009bd6f5d026ca47afe90f3ec4d6fafc654b7212392b325f76fe43f806e.png)\n\n \n\n- Then, translate the result by $2$ units to the right to get the graph of $y=f(\\frac{1}{2}(x-2)).$\n\n![](images/ab/ab1f210741e01139618dc2fa1347cf1591cb90ca4f67906b89ebc7df29d77f32.png)\n\n- Finally, reflect the result across the $x$-axis to get the graph of $y=-f(\\frac{1}{2}(x-2)).$\n\n![](images/e5/e5552a14dc62407e02bb8f5e633ae194a95d313bce04abb3186b56ce83ec2974.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94669996-364b-5fcd-ac9d-e6a8be125a40"] :db/ensure [:question/validate]} {:db/id "answer-field-94669996-364b-5fcd-ac9d-e6a8be125a40" :answer-field/id #uuid "94669996-364b-5fcd-ac9d-e6a8be125a40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8901eefd-bfc8-5877-be0f-8a92a3ab82dc" :answer-field/choices ["answer-8901eefd-bfc8-5877-be0f-8a92a3ab82dc" "answer-db644941-4b47-5d57-9948-d42917f87daa" "answer-3a6c53df-03c3-5272-b79f-e92b2df68cc8" "answer-6f1cbf10-0914-558c-a35e-1b176c12da6d" "answer-41d3f9e0-0839-5481-977d-ea32ab572300"] :db/ensure [:answer-field/validate]} {:db/id "answer-8901eefd-bfc8-5877-be0f-8a92a3ab82dc" :answer/id #uuid "8901eefd-bfc8-5877-be0f-8a92a3ab82dc" :answer/type :answer.type/image :answer/value "images/17/175b02e0003de363b989f13f7ad4082ea6d87b56f8cc616605328ba775db5be2.png" :db/ensure [:answer/validate]} {:db/id "answer-db644941-4b47-5d57-9948-d42917f87daa" :answer/id #uuid "db644941-4b47-5d57-9948-d42917f87daa" :answer/type :answer.type/image :answer/value "images/58/587a9e679f9d446c8ae57ec93fadcb69ed423fd4803abd2150cd845ac1dc9558.png" :db/ensure [:answer/validate]} {:db/id "answer-3a6c53df-03c3-5272-b79f-e92b2df68cc8" :answer/id #uuid "3a6c53df-03c3-5272-b79f-e92b2df68cc8" :answer/type :answer.type/image :answer/value "images/6b/6b4dec42ca9c8a54be8aa13f611907e5c7e3e4bce5e177c2cc5970bc2cf69735.png" :db/ensure [:answer/validate]} {:db/id "answer-6f1cbf10-0914-558c-a35e-1b176c12da6d" :answer/id #uuid "6f1cbf10-0914-558c-a35e-1b176c12da6d" :answer/type :answer.type/image :answer/value "images/83/839406ead3c7deda0ec0f783c01e1c99aca8877a7ba0ecfdb03f7adb883706fb.png" :db/ensure [:answer/validate]} {:db/id "answer-41d3f9e0-0839-5481-977d-ea32ab572300" :answer/id #uuid "41d3f9e0-0839-5481-977d-ea32ab572300" :answer/type :answer.type/image :answer/value "images/88/88b831093808dba6820a2f8faeb3770ecf50f66ef56a0ef34887622eee639a30.png" :db/ensure [:answer/validate]} {:db/id "question-d8c07848-a1dd-5eb7-8320-0b4777fcd645" :question/id #uuid "d8c07848-a1dd-5eb7-8320-0b4777fcd645" :question/math-academy-id "q-115013" :question/problem "![](images/85/8536196127d1e8fc92cd2d442005a386b2d981a027a497ecce363559f52ac0e6.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-\\frac{5}{2}f(x)-4?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-\\frac{5}{2}f(x)-4,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{5}{2}$ parallel to the $y$-axis to get the graph of $y=\\frac{5}{2}f(x).$\n\n![](images/ba/bafacd18cae6114ad22fb59d905a8ebb68cc8768a5b20a4a5a2e36f59c11ad11.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-\\frac{5}{2}f(x).$\n\n![](images/bd/bd69db18de3d58e6806b7ee3473a0fd4e8b6df384cf371be4e9648cac53e3927.png)\n\n- Finally, translate the result down by $4$ units to get the graph of $y=-\\frac{5}{2}f(x)-4.$\n\n![](images/fe/fe2e7245978e120a538cc87a31d6180c4e342fc438240be1f3ce367eed64bb33.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e4af18f8-8206-55c1-b168-26e7b4b9d10e"] :db/ensure [:question/validate]} {:db/id "answer-field-e4af18f8-8206-55c1-b168-26e7b4b9d10e" :answer-field/id #uuid "e4af18f8-8206-55c1-b168-26e7b4b9d10e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-867b22c8-ce8f-5bf6-ab0a-c1c5ac398bdb" :answer-field/choices ["answer-867b22c8-ce8f-5bf6-ab0a-c1c5ac398bdb" "answer-3abf1eb5-d7e3-5fa0-8c42-70389de225ed" "answer-50297d59-a216-5c1c-9ae6-f8e0b94604a8" "answer-9a53deaf-916f-500d-9688-841cfd82731d" "answer-a5dc6a84-b562-5e83-845a-a691eafb3f4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-867b22c8-ce8f-5bf6-ab0a-c1c5ac398bdb" :answer/id #uuid "867b22c8-ce8f-5bf6-ab0a-c1c5ac398bdb" :answer/type :answer.type/image :answer/value "images/27/27e807f3030f8780b64f7b80ce2da692d5a846da112c30215cefd13bd84a5fbd.png" :db/ensure [:answer/validate]} {:db/id "answer-3abf1eb5-d7e3-5fa0-8c42-70389de225ed" :answer/id #uuid "3abf1eb5-d7e3-5fa0-8c42-70389de225ed" :answer/type :answer.type/image :answer/value "images/8b/8b612ba10fddfa21f2d4495aa24adbe05fcb66b14fc682c78b163608e2d5a947.png" :db/ensure [:answer/validate]} {:db/id "answer-50297d59-a216-5c1c-9ae6-f8e0b94604a8" :answer/id #uuid "50297d59-a216-5c1c-9ae6-f8e0b94604a8" :answer/type :answer.type/image :answer/value "images/8f/8fdd077596cc508337947993d13bf197900e30d2ea21e54efce259a45036a127.png" :db/ensure [:answer/validate]} {:db/id "answer-9a53deaf-916f-500d-9688-841cfd82731d" :answer/id #uuid "9a53deaf-916f-500d-9688-841cfd82731d" :answer/type :answer.type/image :answer/value "images/c8/c8017c06848a7f9749742c28fed944a03fb4a6a46e2dc02e029a79d55fa20d50.png" :db/ensure [:answer/validate]} {:db/id "answer-a5dc6a84-b562-5e83-845a-a691eafb3f4a" :answer/id #uuid "a5dc6a84-b562-5e83-845a-a691eafb3f4a" :answer/type :answer.type/image :answer/value "images/fd/fde3bcc2394f7630ca77f137a3e7f8a2afa3b75d10a11e6f50beaa74da197719.png" :db/ensure [:answer/validate]} {:db/id "question-95bf6a06-ae4e-5d38-8c20-f91522b5fa5e" :question/id #uuid "95bf6a06-ae4e-5d38-8c20-f91522b5fa5e" :question/math-academy-id "q-17696" :question/problem "![](images/50/504024983dafee0fd49c0bb8227f33cc855e2ee9e4bb797f067f0a5e8e415815.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-4f(x-1)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-4f(x-1),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Translate it by $1$ unit to the right to get the graph of $y=f(x-1).$\n\n![](images/d0/d07f918fae59166e137e47a2c654dfe77ce1c56bb71e931d2d627c509682823e.png)\n\n- Then, stretch the result by a scale factor of $4$ parallel to the $y$-axis to get the graph of $y=4f(x-1).$\n\n![](images/4c/4c237eeb7ecb85ef71c86b73cdbeaae213e74a21604e079f0df4c14c381f6bd7.png)\n\n  \n\n- Finally, reflect the result across the $x$-axis to get the graph of $y=-4f(x-1).$\n\n![](images/58/583f01b214d4c86dcb00936e83f1fad0a4f0f8901b321880d904b2f0da95d7e8.png)\n\n \n\n$$\n\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-790b63a4-2afd-58c9-a20f-656426972c93"] :db/ensure [:question/validate]} {:db/id "answer-field-790b63a4-2afd-58c9-a20f-656426972c93" :answer-field/id #uuid "790b63a4-2afd-58c9-a20f-656426972c93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f45ad7b-d454-5e2f-9ace-ce03f717e36a" :answer-field/choices ["answer-c5832434-80d0-5574-9b32-b29a52fac560" "answer-fbba5cdd-b081-50bf-8bc3-7dfc2725fdab" "answer-6f45ad7b-d454-5e2f-9ace-ce03f717e36a" "answer-67bc3dc8-9412-57da-b948-67be931cf23a" "answer-9b1301d0-c9d3-524f-8d75-13c421d1d33f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5832434-80d0-5574-9b32-b29a52fac560" :answer/id #uuid "c5832434-80d0-5574-9b32-b29a52fac560" :answer/type :answer.type/image :answer/value "images/3e/3e2f9759b525575f97ee3c4a8d5684872e447edaa411c0fb5f605b50a9f553b8.png" :db/ensure [:answer/validate]} {:db/id "answer-fbba5cdd-b081-50bf-8bc3-7dfc2725fdab" :answer/id #uuid "fbba5cdd-b081-50bf-8bc3-7dfc2725fdab" :answer/type :answer.type/image :answer/value "images/50/504024983dafee0fd49c0bb8227f33cc855e2ee9e4bb797f067f0a5e8e415815.png" :db/ensure [:answer/validate]} {:db/id "answer-6f45ad7b-d454-5e2f-9ace-ce03f717e36a" :answer/id #uuid "6f45ad7b-d454-5e2f-9ace-ce03f717e36a" :answer/type :answer.type/image :answer/value "images/63/63e01f1062569e629b6dc8b004955db30ea97bfa9cc15025e17058300a628476.png" :db/ensure [:answer/validate]} {:db/id "answer-67bc3dc8-9412-57da-b948-67be931cf23a" :answer/id #uuid "67bc3dc8-9412-57da-b948-67be931cf23a" :answer/type :answer.type/image :answer/value "images/9e/9e29de3350d7e1729f7bbbc0345c4f0518df1b07ace92f36c1b0db43a5b985cf.png" :db/ensure [:answer/validate]} {:db/id "answer-9b1301d0-c9d3-524f-8d75-13c421d1d33f" :answer/id #uuid "9b1301d0-c9d3-524f-8d75-13c421d1d33f" :answer/type :answer.type/image :answer/value "images/e5/e52c421785b646c83ea29542a02e05c5f460ae8dab3b4e97d8148fe84704063a.png" :db/ensure [:answer/validate]} {:db/id 17592186158543 :tutorial/content "Given the graph of a curve $y= f(x),$ there are two types of reflections we can apply to it:\n\n1\\. Reflection across the $y$-axis. This is a transformation of the form \n\n  $$\n  y=f(-x).\n  $$\n\n2\\. Reflection across the $x$-axis. This is a transformation of the form \n\n  $$\n  y=-f(x).\n  $$\n\nFor example, let's consider the function $y=f(x)$ below. \n\n![](images/69/6931216dd63985631394e3f3f2fe59246ddd810ecce5af0f0c7ad18b8634133b.png)\n\nThe graph of $y=f(-x)$ is a reflection of $y=f(x)$ in the $y$-axis, and it looks as follows:\n\n![](images/e2/e2274a68c25ed14ba93410fe87d672f85b839b7214b30e80d34a3ae28f47ef03.png)\n\n \n\nThe graph of $y=-f(x)$ is a reflection of $y=f(x)$ in the $x$-axis, and it looks as follows:\n\n![](images/ee/eee560bdd17899d55cdaea35204e9963ae9f0148f0ef897173e6250a3eb874b3.png)\n\n  \n\nWe can also combine reflections with other graph transformations. Let's see how." :db/ensure [:tutorial/validate]} {:db/id 17592186157496 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} [:db/retract 17592186129528 :question/answer-fields 17592186126667] [:db/retract 17592186126620 :answer-field/choices 17592186126624] [:db/retract 17592186126620 :answer-field/choices 17592186126625] [:db/retract 17592186126620 :answer-field/choices 17592186126621] [:db/retract 17592186126620 :answer-field/choices 17592186126622] [:db/retract 17592186126620 :answer-field/choices 17592186126623] {:db/id 17592186129277 :knowledge-point/questions ["question-31b80dba-d43f-591d-b1ec-e6cb3d1597c2" "question-ac81bb63-6896-5260-96a8-5a88cb11f40d" "question-fff4e417-ea88-59e6-bd63-239378f4d2c6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129279 :knowledge-point/questions ["question-7da71e9d-63e8-5f19-957f-ca4c328a0eb6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128857 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n\\int_a^b \\int_{v_1(x)}^{v_2(x)} \\int_{u_1(x,y)}^{u_2(x,y)}  f(x,y,z) \\:\\textrm{d}z\\:\\textrm{d}y\\:\\textrm{d}x.\n$$\n\nFrom the repeated integrals, we see that the domain of integration $R = R_1\\cup R_2,$ where $R_1$ and $R_2$ are type I regions, is given by\n\n$$\n\\begin{aligned}{R}_{1} & =\\{(x,y,z)\\,:\\,-1\\le y\\le 0,\\,\\,{y}^{2}\\le x\\le 1,\\,\\,x-1\\le z\\le {y}^{2}\\}, \\\\ {R}_{2} & =\\{(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,y\\le x\\le 1,\\,\\,x-1\\le z\\le {y}^{2}\\}.\\end{aligned}\n$$\n\nSince all repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n\\int_a^b \\int_{v_1(x)}^{v_2(x)} \\int_{x-1}^{y^2} f(x,y,z) \\:\\textrm{d}z\\:\\textrm{d}y\\:\\textrm{d}x\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/c8/c8bfd933472e1944f63b1295bda7fc324311ea2ca2ada3636e9f5ab82e4e5fc5.png)\n\nThe region $D$ consists of two type II regions in the $xy$-plane:\n\n$$\nD =\n\\left\\{ (x,y) \\: : \\: -1 \\leq y \\leq 0, \\quad y^2 \\leq x \\leq 1 \\right\\}\n\\:\\cup\\:\n\\left\\{ (x,y) \\: : \\: 0 \\leq y \\leq 1, \\quad y \\leq x \\leq 1 \\right\\}\n$$\n\nTo change the order of integration from $\\textrm{d}z\\:\\textrm{d}x\\:\\textrm{d}y$ to $\\textrm{d}z\\:\\textrm{d}y\\:\\textrm{d}x,$ we write $D$ as a type I region.\n\nNotice that the lower boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=y^2\n\\qquad\\Longrightarrow\\qquad\ny = -\\sqrt{x}\n$$\n\nand the upper boundary of the region is\n\n$$\nx=y\n\\qquad\\Longrightarrow\\qquad\ny =x.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD = \\left\\{ (x,y) \\: : \\: 0 \\leq x \\leq 1, \\quad -\\sqrt{x} \\leq y \\leq  x \\right\\},\n$$\n\nas shown in the diagram below.\n\n![](images/c7/c73a0e30d6996490f9f41bf3e8777c14d542755387f643ad464bd1dd6cab2839.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\int_0^{\\bbox[2pt,Gainsboro]{1}} \\int_{\\bbox[2pt,Gainsboro]{-\\sqrt{x}}}^{\\bbox[2pt,Gainsboro]{x}} \\int_{x-1}^{y^2} f(x,y,z) \\:\\textrm{d}z\\:\\textrm{d}y\\:\\textrm{d}x.\n$$" :db/ensure [:question/validate]} {:db/id 17592186129280 :knowledge-point/questions ["question-f35d7c5d-0e2d-5ee0-b1c5-16c26213b1d0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31b80dba-d43f-591d-b1ec-e6cb3d1597c2" :question/id #uuid "31b80dba-d43f-591d-b1ec-e6cb3d1597c2" :question/math-academy-id "q-162327" :question/problem "![](images/d4/d4573a2e3c7b220ac363c996c5332a3db93cc48b5b941e46a529b6912804f0c6.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{1-{y}^{2}}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\nRewrite this repeated integral by integrating first with respect to $x,$ then $y,$ and then $z.$" :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1-{y}^{2},\\,\\,0\\le x\\le 2-y-z\\}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\nSince both repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/8d/8d1db6e886f00596814900ca0c4113590a37a407b65c800eb1f9926328ade50c.png)\n\nThe region $D$ is a type I region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1-{y}^{2}\\}\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we write $D$ as a type II region.\n\nNotice that the right boundary of the region, written in the form $y=y(z),$ is \n\n$$\nz=1-{y}^{2}\\,⟹\\,y=\\sqrt{1-z}.\n$$\n\nand the left boundary of the region is\n\n$$\ny=0.\n$$\n\nThen, the type II representation of the region $D$ is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le \\sqrt{1-z}\\},\n$$\n\nas shown below.\n\n![](images/1f/1fe8a810a7e98c8a40739d5019ff9054a5375c0a12ae7fd1b17f8b6c8bb19f75.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-z}}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e8f2f208-bfdf-5d7a-b0b7-7f94fe8a16ae"] :db/ensure [:question/validate]} {:db/id "answer-field-e8f2f208-bfdf-5d7a-b0b7-7f94fe8a16ae" :answer-field/id #uuid "e8f2f208-bfdf-5d7a-b0b7-7f94fe8a16ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57530fa0-a8c6-5fa8-b434-155da990f33e" :answer-field/choices ["answer-739cb01f-393c-57bf-a010-d144513405ba" "answer-57530fa0-a8c6-5fa8-b434-155da990f33e" "answer-93a3db56-671e-5488-9051-35f5266d1834" "answer-0a416a83-b992-5dea-933e-d7994ee0e1f1" "answer-619538c5-7b67-52bb-8a52-0a0ef0d09a15"] :db/ensure [:answer-field/validate]} {:db/id "answer-739cb01f-393c-57bf-a010-d144513405ba" :answer/id #uuid "739cb01f-393c-57bf-a010-d144513405ba" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-57530fa0-a8c6-5fa8-b434-155da990f33e" :answer/id #uuid "57530fa0-a8c6-5fa8-b434-155da990f33e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-z}}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-93a3db56-671e-5488-9051-35f5266d1834" :answer/id #uuid "93a3db56-671e-5488-9051-35f5266d1834" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-z}}{\\int }_{0}^{\\sqrt{2-y-z}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-0a416a83-b992-5dea-933e-d7994ee0e1f1" :answer/id #uuid "0a416a83-b992-5dea-933e-d7994ee0e1f1" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{1-z}}^{1}{\\int }_{0}^{2-y-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-619538c5-7b67-52bb-8a52-0a0ef0d09a15" :answer/id #uuid "619538c5-7b67-52bb-8a52-0a0ef0d09a15" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{1-z}}^{1}{\\int }_{0}^{\\sqrt{2-y-z}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id 17592186129528 :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type I region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le {x}^{2},\\,\\,0\\le z\\le {x}^{2}+y\\}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nSince both repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/8b/8b7cfa72ed3dbfb121039c6e64b843d83489878a9f457fb1386e455e7d9649ec.png)\n\nThe region $D$ is a type I region in the $xy$-plane:\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le {x}^{2}\\}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}x\\,\\text{d}y,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region, written in the form $x=x(y),$ is \n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nand the right boundary of the region is\n\n$$\nx=1.\n$$\n\nThen, the type II representation of the region $D$ is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\,\\sqrt{y}\\le x\\le 1\\},\n$$\n\nas shown below.\n\n![](images/f4/f49af5da2e4f1f281700e16c4659fabfcd0b15661947ca985d38f208f8563877.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$" :db/ensure [:question/validate]} {:db/id "question-ac81bb63-6896-5260-96a8-5a88cb11f40d" :question/id #uuid "ac81bb63-6896-5260-96a8-5a88cb11f40d" :question/math-academy-id "q-162495" :question/problem "![](images/2f/2f95783c1e9624e58b4cd26764e94fb61d45c7aa75260ce8ca726a6c2e5db9ab.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{3-3z/2}^{3}{\\int }_{8-4x/3-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z\n$$\n\nRewrite this repeated integral by integrating first with respect to $y,$ then $z,$ and then $x.$" :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type III region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 2,\\,\\,3-\\frac{3z}{2}\\le x\\le 3,\\,\\,8-\\frac{4x}{3}-2z\\le y\\le 4\\}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nSince both repeated integrals first integrate with respect to $y,$ the $y$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{8-4x/3-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xz$-plane shown below.\n\n![](images/85/85d184f328ebdbed5faf2d1c43261940a8241b6637450ab5fe1c8d803026e273.png)\n\nThe region $D$ is a type II region in the $xz$-plane:\n\n$$\nD=\\{(x,z)\\,:\\,0\\le z\\le 2,\\,\\,3-\\frac{3z}{2}\\le x\\le 3\\}\n$$\n\nTo change the order of integration from $\\text{d}y\\,\\text{d}x\\,\\text{d}z$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $D$ as a type I region.\n\nNotice that the bottom  boundary of the region, written in the form $z=z(x),$ is \n\n$$\nx=3-\\frac{3z}{2}\\,⟹\\,z=2-\\frac{2x}{3}\n$$\n\nand the top boundary of the region is\n\n$$\nz=2.\n$$\n\nThen, the type I representation of the region $D$ is\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 3,\\,\\,2-\\frac{2x}{3}\\le z\\le 2\\},\n$$\n\nas shown below.\n\n![](images/6a/6ac58e4c98c79a1a698d052479b55a45dd2b79bed4ca11422d172fe306dac15f.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{3}{\\int }_{2-2x/3}^{2}{\\int }_{8-4/3x-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-513d3730-41ea-5d79-9d65-fe4f1ea03b21"] :db/ensure [:question/validate]} {:db/id "answer-field-513d3730-41ea-5d79-9d65-fe4f1ea03b21" :answer-field/id #uuid "513d3730-41ea-5d79-9d65-fe4f1ea03b21" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebe2811f-8eb8-50fc-a883-7924a3888848" :answer-field/choices ["answer-043bca1a-2206-51e9-a120-247e71cc51ec" "answer-50146f2b-26fb-5cad-a0d7-79d0f7cde1c8" "answer-fba6c7d9-e4bf-58a1-9d10-b0e3db0b7fb5" "answer-ebe2811f-8eb8-50fc-a883-7924a3888848" "answer-4a550c5a-2b5d-5ffe-9202-bcc3022eb22c"] :db/ensure [:answer-field/validate]} {:db/id "answer-043bca1a-2206-51e9-a120-247e71cc51ec" :answer/id #uuid "043bca1a-2206-51e9-a120-247e71cc51ec" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{0}^{2-2x/3}{\\int }_{8-4x/3-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-50146f2b-26fb-5cad-a0d7-79d0f7cde1c8" :answer/id #uuid "50146f2b-26fb-5cad-a0d7-79d0f7cde1c8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{0}^{2-2x/3}{\\int }_{8-4x/3-2z}^{8}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-fba6c7d9-e4bf-58a1-9d10-b0e3db0b7fb5" :answer/id #uuid "fba6c7d9-e4bf-58a1-9d10-b0e3db0b7fb5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{1}^{3-x/2}{\\int }_{8-4x/3-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ebe2811f-8eb8-50fc-a883-7924a3888848" :answer/id #uuid "ebe2811f-8eb8-50fc-a883-7924a3888848" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{2-2x/3}^{2}{\\int }_{8-4x/3-2z}^{4}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-4a550c5a-2b5d-5ffe-9202-bcc3022eb22c" :answer/id #uuid "4a550c5a-2b5d-5ffe-9202-bcc3022eb22c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{3-x/2}^{1}{\\int }_{8-4x/3-2z}^{8}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186129530 :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le \\sqrt[3]{z},\\,\\,1+y-z\\le x\\le 2\\}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\nSince both repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{1+y-z}^{2}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/8f/8fff232443e6da697862c2e85a9d3abfe0554b80c2fcbfa8c93de42b94a45691.png)\n\nThe region $D$ is a type II region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le \\sqrt[3]{z}\\}\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $D$ as a type I region.\n\nNotice that the bottom boundary of the region, written in the form $z=z(y),$ is \n\n$$\ny=\\sqrt[3]{z}\\,⟹\\,z={y}^{3}\n$$\n\nand the top boundary of the region is\n\n$$\nz=1.\n$$\n\nThen, the type I representation of the region $D$ is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 1,\\,\\,{y}^{3}\\le z\\le 1\\},\n$$\n\nas shown below.\n\n![](images/72/726ff420cae25c40f212714141a134fab84633cca7f49bdd268f0668d5248766.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{{y}^{3}}^{1}{\\int }_{1+y-z}^{2}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$" :db/ensure [:question/validate]} {:db/id "question-fff4e417-ea88-59e6-bd63-239378f4d2c6" :question/id #uuid "fff4e417-ea88-59e6-bd63-239378f4d2c6" :question/math-academy-id "q-162329" :question/problem "![](images/8f/8fc551f1439ed5a551ae8fd18234479bb062d43ae9e4faf55d896739f76e0f4d.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{1}^{4}{\\int }_{1}^{4/z}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\nRewrite this repeated integral by integrating first with respect to $x,$ then $z,$ and then $y.$" :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le z\\le 4,\\,\\,1\\le y\\le \\frac{4}{z},\\,\\,0\\le x\\le 4-yz\\}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\nSince both repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/9a/9a59198b60398e2b3044296c3cc76b4748785303029dccc1087320cd11cb7d55.png)\n\nThe region $D$ is a type II region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,1\\le z\\le 4,\\,\\,1\\le y\\le \\frac{4}{z}\\}\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $D$ as a type I region.\n\nNotice that the top boundary of the region, written in the form $z=z(y),$ is \n\n$$\ny=\\frac{4}{z}\\,⟹\\,z=\\frac{4}{y}\n$$\n\nand the bottom boundary of the region is\n\n$$\nz=1.\n$$\n\nThen, the type I representation of the region $D$ is\n\n$$\nD=\\{(y,z)\\,:\\,1\\le y\\le 4,\\,\\,1\\le z\\le \\frac{4}{y}\\},\n$$\n\nas shown below.\n\n![](images/9b/9bc88aa4f0ad07d89ff5dd3c0de16208cb8bf47d774b557a7bf2140790c95291.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{1}^{4}{\\int }_{1}^{4/y}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d084d670-2e7b-5600-a90e-83f0ea45658b"] :db/ensure [:question/validate]} {:db/id "answer-field-d084d670-2e7b-5600-a90e-83f0ea45658b" :answer-field/id #uuid "d084d670-2e7b-5600-a90e-83f0ea45658b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7aef16c7-4821-502c-a25f-730651588c0a" :answer-field/choices ["answer-fcb0941d-3cc4-5879-87b3-21a7dac6fa5c" "answer-4955968f-08d9-5d5e-90f4-c1643ad1847e" "answer-7aef16c7-4821-502c-a25f-730651588c0a" "answer-cacc640b-c32f-5efa-abb2-b66482f7bb2a" "answer-ac21b4ed-6e73-52e4-9f6c-294e04f1814b"] :db/ensure [:answer-field/validate]} {:db/id "answer-fcb0941d-3cc4-5879-87b3-21a7dac6fa5c" :answer/id #uuid "fcb0941d-3cc4-5879-87b3-21a7dac6fa5c" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{0}^{1/y}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-4955968f-08d9-5d5e-90f4-c1643ad1847e" :answer/id #uuid "4955968f-08d9-5d5e-90f4-c1643ad1847e" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{0}^{1/y}{\\int }_{0}^{4/z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-7aef16c7-4821-502c-a25f-730651588c0a" :answer/id #uuid "7aef16c7-4821-502c-a25f-730651588c0a" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{1}^{4/y}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-cacc640b-c32f-5efa-abb2-b66482f7bb2a" :answer/id #uuid "cacc640b-c32f-5efa-abb2-b66482f7bb2a" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{1}^{4/y}{\\int }_{0}^{4/z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-ac21b4ed-6e73-52e4-9f6c-294e04f1814b" :answer/id #uuid "ac21b4ed-6e73-52e4-9f6c-294e04f1814b" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{1}^{4}{\\int }_{0}^{4-yz}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186281428 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nFrom the repeated integrals, we see that the domain of integration $R={R}_{1}\\cup {R}_{2},$ where ${R}_{1}$ and ${R}_{2}$ are type I regions, is given by\n\n$$\n\\begin{aligned}{R}_{1} & =\\{(x,y,z)\\,:\\,-2\\le y\\le 2,\\,\\,0\\le z\\le \\sqrt{y+2},\\,\\,-z\\le x\\le {y}^{2}\\}, \\\\ {R}_{2} & =\\{(x,y,z)\\,:\\,2\\le y\\le 6,\\,\\,0\\le z\\le \\sqrt{6-y},\\,\\,-z\\le x\\le {y}^{2}\\}.\\end{aligned}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{-z}^{{y}^{2}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/aa/aa1c884900c3cb01a719dc6d22604469984d2b08291d9d925b8f37d794d455b2.png)\n\nThe region $D$ consists of two type I regions in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,-2\\le y\\le 2,\\,0\\le z\\le \\sqrt{y+2}\\}\\,\\cup \\,\\{(y,z)\\,:\\,2\\le x\\le 6,\\,0\\le z\\le \\sqrt{6-y}\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region, written in the form $y=y(z),$ is\n\n$$\nz=\\sqrt{y+2}\\,⟹\\,y={z}^{2}-2\n$$\n\nand the right boundary of the region is\n\n$$\nz=\\sqrt{6-y}\\,⟹\\,y=6-{z}^{2}.\n$$\n\nThen, the type II representation of the region is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le 2,\\,{z}^{2}-2\\le y\\le 6-{z}^{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/e4/e4139dde4d56e83b91e4a72d42ccdf296ad20773520ccdaa51d7a84b9e1a3f31.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{\\int }_{0}^{2}{\\int }_{{z}^{2}-2}^{6-{z}^{2}}{\\int }_{-z}^{{y}^{2}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$" :db/ensure [:question/validate]} {:db/id 17592186129520 :question/problem "By changing the order of integration, find the missing limits in the following repeated integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{-{z}^{2}-1}^{-z}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z={\\int }_{-2}^{p}{\\int }_{q}^{1}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y+{\\int }_{-1}^{0}{\\int }_{0}^{r}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$" :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y+{\\int }_{c}^{d}{\\int }_{{v}_{3}(y)}^{{v}_{4}(y)}{\\int }_{{u}_{3}(y,z)}^{{u}_{4}(y,z)}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,-{z}^{2}-1\\le y\\le -z,\\,\\,0\\le x\\le 2y+z\\}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{0}^{1}{\\int }_{-{z}^{2}-1}^{-z}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y+{\\int }_{c}^{d}{\\int }_{{v}_{3}(y)}^{{v}_{4}(y)}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/59/59e5dae7cb1d621213f3e4ef792623bdfd9a42aef19c75f7ca9d65b3af32eeda.png)\n\nThe region $D$ is a type II region in the $yz$-plane:\n\n$$\nD=\\{(x,y)\\,:\\,0\\le z\\le 1,\\,-{z}^{2}-1\\le y\\le -z\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we split $D$ into two type I regions.\n\n![](images/9c/9c968af98710367752a9d788b9b4c00d8c04e31d5494f7887ea5d2d635312338.png)\n\nNotice that the bottom and top boundaries of the left region, written in the form $z=z(y),$ are\n\n$\\,$ $z=\\sqrt{-y-1}\\,$ and $\\,z=1.$\n\nAlso, the bottom and top boundaries of the right region, written in the form $z=z(y),$ are\n\n$\\,$ $z=0\\,$ and $\\,z=-y.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(y,z)\\,:\\,-2\\le y\\le -1,\\,\\sqrt{-y-1}\\le z\\le 1\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(y,z)\\,:\\,-1\\le y\\le 0,\\,0\\le z\\le -y\\}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{-1}{\\int }_{\\sqrt{-y-1}}^{1}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y+{\\int }_{-1}^{0}{\\int }_{0}^{-y}{\\int }_{0}^{2y+z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186126620 :answer-field/correct "answer-931c1007-7643-5d0e-86ab-07276a0fd174" :answer-field/choices ["answer-aab8905a-7a25-5c53-8b0c-6d625197c8ae" "answer-931c1007-7643-5d0e-86ab-07276a0fd174" "answer-270fc9a3-6745-5ea1-a800-6128a441ff7d" "answer-4779f108-0a30-5e16-95a9-540802d12ecd" "answer-53105811-6f7d-5823-80d4-62ba7e36f98f"] :db/ensure [:answer-field/validate]} {:db/id "answer-aab8905a-7a25-5c53-8b0c-6d625197c8ae" :answer/id #uuid "aab8905a-7a25-5c53-8b0c-6d625197c8ae" :answer/type :answer.type/math :answer/value "p=-1,\\,\\,\\,q=\\sqrt{-y+1},\\,\\,\\,r=-y" :db/ensure [:answer/validate]} {:db/id "answer-931c1007-7643-5d0e-86ab-07276a0fd174" :answer/id #uuid "931c1007-7643-5d0e-86ab-07276a0fd174" :answer/type :answer.type/math :answer/value "p=-1,\\,\\,\\,q=\\sqrt{-y-1},\\,\\,\\,r=-y" :db/ensure [:answer/validate]} {:db/id "answer-270fc9a3-6745-5ea1-a800-6128a441ff7d" :answer/id #uuid "270fc9a3-6745-5ea1-a800-6128a441ff7d" :answer/type :answer.type/math :answer/value "p=-1,\\,\\,\\,q=y,\\,\\,\\,r=\\sqrt{-y-1}" :db/ensure [:answer/validate]} {:db/id "answer-4779f108-0a30-5e16-95a9-540802d12ecd" :answer/id #uuid "4779f108-0a30-5e16-95a9-540802d12ecd" :answer/type :answer.type/math :answer/value "p=0,\\,\\,\\,q=\\sqrt{-y-1},\\,\\,\\,r=-y" :db/ensure [:answer/validate]} {:db/id "answer-53105811-6f7d-5823-80d4-62ba7e36f98f" :answer/id #uuid "53105811-6f7d-5823-80d4-62ba7e36f98f" :answer/type :answer.type/math :answer/value "p=0,\\,\\,\\,q=y,\\,\\,\\,r=\\sqrt{-y+1}" :db/ensure [:answer/validate]} {:db/id "question-7da71e9d-63e8-5f19-957f-ca4c328a0eb6" :question/id #uuid "7da71e9d-63e8-5f19-957f-ca4c328a0eb6" :question/math-academy-id "q-162234" :question/problem "By changing the order of integration in the following repeated integrals so that they are integrated first with respect to $x,$ then $z,$ and then $y,$ express the following sum as a single repeated integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2z}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{1}^{3}{\\int }_{0}^{3-z}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$" :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$\n\nFrom the repeated integrals, we see that the domain of integration $R={R}_{1}\\cup {R}_{2},$ where ${R}_{1}$ and ${R}_{2}$ are type II regions, is given by\n\n$$\n\\begin{aligned}{R}_{1} & =\\{(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le 2z,\\,\\,-y\\le x\\le z\\}, \\\\ {R}_{2} & =\\{(x,y,z)\\,:\\,1\\le z\\le 3,\\,\\,0\\le y\\le 3-z,\\,\\,-y\\le x\\le z\\}.\\end{aligned}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/9b/9b8806738b61c4ce692f555261abcd9918096a7585291954a7f11c39aadeab39.png)\n\nThe region $D$ consists of two type II regions in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le 1,\\,0\\le y\\le 2z\\}\\,\\cup \\,\\{(y,z)\\,:\\,1\\le z\\le 3,\\,0\\le y\\le 3-z\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $D$ as a type I region.\n\nNotice that the bottom boundary of the region, written in the form $z=z(y),$ is\n\n$$\ny=2z\\,⟹\\,z=\\frac{y}{2}\n$$\n\nand the top boundary of the region is\n\n$$\ny=3-z\\,⟹\\,z=3-y.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 2,\\,\\frac{y}{2}\\le z\\le 3-y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d1a9d83672ffbd372b6a994c62771291d957e6a5c13189a6baea6d544f6a1bbc.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{\\int }_{0}^{2}{\\int }_{y/2}^{3-y}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d9447dc2-1b9f-505d-ae0d-6cd7412e4910"] :db/ensure [:question/validate]} {:db/id "answer-field-d9447dc2-1b9f-505d-ae0d-6cd7412e4910" :answer-field/id #uuid "d9447dc2-1b9f-505d-ae0d-6cd7412e4910" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a908daaf-d2d3-5c7e-a2b3-0e34b598e588" :answer-field/choices ["answer-463d28ca-1df1-50c0-85de-534a393326de" "answer-a908daaf-d2d3-5c7e-a2b3-0e34b598e588" "answer-bc8e0a76-12f6-5235-8928-a55923107f05" "answer-6e2ad9b6-2325-5d04-8b7b-dc7feb79acf5" "answer-668be39c-6dba-5a63-9f61-5cb30fd0c100"] :db/ensure [:answer-field/validate]} {:db/id "answer-463d28ca-1df1-50c0-85de-534a393326de" :answer/id #uuid "463d28ca-1df1-50c0-85de-534a393326de" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{2y}^{2y+3}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-a908daaf-d2d3-5c7e-a2b3-0e34b598e588" :answer/id #uuid "a908daaf-d2d3-5c7e-a2b3-0e34b598e588" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{y/2}^{3-y}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bc8e0a76-12f6-5235-8928-a55923107f05" :answer/id #uuid "bc8e0a76-12f6-5235-8928-a55923107f05" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{{y}^{2}/2}^{3-2y}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-6e2ad9b6-2325-5d04-8b7b-dc7feb79acf5" :answer/id #uuid "6e2ad9b6-2325-5d04-8b7b-dc7feb79acf5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{2y}^{3-y}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-668be39c-6dba-5a63-9f61-5cb30fd0c100" :answer/id #uuid "668be39c-6dba-5a63-9f61-5cb30fd0c100" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{y/2}^{3+y}{\\int }_{-y}^{z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186401329 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{c}^{d}{\\int }_{{v}_{3}(z)}^{{v}_{4}(z)}{\\int }_{{u}_{3}(xy,z)}^{{u}_{4}(y,z)}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,\\sqrt{2y}-1\\le z\\le 2-\\frac{y}{2},\\,\\,-2z\\le x\\le y+3\\}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{0}^{2}{\\int }_{\\sqrt{2y}-1}^{2-y/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(x)}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{c}^{d}{\\int }_{{v}_{3}(z)}^{{v}_{4}(x)}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/a4/a4de9d9df51efcec67253a1c7118466f29459ffd5c9136c144d33500ec5557bc.png)\n\nThe region $D$ is a type I region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 2,\\,\\sqrt{2y}-1\\le z\\le 2-\\frac{y}{2}\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we split $D$ into two type II regions.\n\n![](images/18/18bb3e55f076e022176bb60df27d5665ed2d91d75d618969c04ce192378db922.png)\n\nNotice that the bottom and top boundaries of the lower region, written in the form $y=y(z),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=\\frac{1}{2}(z+1)^{2}.$\n\nAlso, the bottom and top boundaries of the upper region, written in the form $y=y(z),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=4-2z.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(y,z)\\,:\\,-1\\le z\\le 1,\\,0\\le y\\le \\frac{1}{2}(z+1)^{2}\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(y,z)\\,:\\,1\\le z\\le 2,\\,0\\le x\\le 4-2z\\}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{0}^{(z+1)^{2}/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{1}^{2}{\\int }_{0}^{4-2z}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186281427 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$\n\nFrom the repeated integrals, we see that the domain of integration $R={R}_{1}\\cup {R}_{2},$ where ${R}_{1}$ and ${R}_{2}$ are type I regions, is given by\n\n$$\n\\begin{aligned}{R}_{1} & =\\{(x,y,z)\\,:\\,-1\\le x\\le 0,\\,\\,-2{x}^{3}\\le y\\le 2,\\,\\,-y\\le z\\le x+3\\}, \\\\ {R}_{2} & =\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,\\sqrt{2x}\\le y\\le 2,\\,\\,-y\\le z\\le x+3\\}.\\end{aligned}\n$$\n\nSince all repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{-y}^{x+3}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/83/834238127fb9a55c956b2dd708e1dc7d925c63725990003eff6aac28ee42a873.png)\n\nThe region $D$ consists of two type I regions in the $xy$-plane:\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 0,\\,-2{x}^{3}\\le y\\le 2\\}\\,\\cup \\,\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\sqrt{2x}\\le y\\le 2\\}.\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}x\\,\\text{d}y,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region, written in the form $x=x(y),$ is\n\n$$\ny=-2{x}^{3}\\,⟹\\,x=-\\sqrt[3]{\\frac{y}{2}}\n$$\n\nand the right boundary of the region is\n\n$$\ny=\\sqrt{2x}\\,⟹\\,x=\\frac{1}{2}{y}^{2}.\n$$\n\nThen, the type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,-\\sqrt[3]{\\frac{y}{2}}\\le x\\le \\frac{1}{2}{y}^{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/82/82bddc0c83e0e5a5824b7525bcd4fd2dc9b8f88473dfe1fd5c6cdb2ff0cefcaf.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{\\int }_{0}^{2}{\\int }_{-\\sqrt[3]{y/2}}^{{y}^{2}/2}{\\int }_{-y}^{x+3}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$" :db/ensure [:question/validate]} {:db/id "question-f35d7c5d-0e2d-5ee0-b1c5-16c26213b1d0" :question/id #uuid "f35d7c5d-0e2d-5ee0-b1c5-16c26213b1d0" :question/math-academy-id "q-162326" :question/problem "Evaluate\n${\\int }_{0}^{1}{\\int }_{\\operatorname{arcsin}⁡y}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.$\n\n*Hint: First change the order of integration to $\\text{d}x\\,\\text{d}y\\,\\text{d}z.$*" :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,\\operatorname{arcsin}⁡y\\le z\\le \\frac{\\pi }{2},\\,\\,0\\le x\\le \\operatorname{cos}⁡z\\}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{0}^{\\operatorname{cos}⁡z}\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/ed/ed7308cf6c77f5d89b94ec90237fa9161fc85429182813f38b55d916bdbdaeef.png)\n\nThe region $D$ is type I region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 1,\\,\\operatorname{arcsin}⁡y\\le z\\le \\frac{\\pi }{2}\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region $D$ is\n\n$$\ny=0\n$$\n\nand the right boundary of the region $D,$ written in the form $y=y(z),$ is\n\n$$\nz=\\operatorname{arcsin}⁡y\\,⟹\\,y=\\operatorname{sin}⁡z.\n$$\n\nThen, the type II representation of the region is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{sin}⁡z\\},\n$$\n\nas shown in the diagram below.\n\n![](images/4f/4fb3323b2c295df8351910890f20266840b131a4dfd8a7bba0d61a3eb03bea23.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{\\operatorname{arcsin}⁡y}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡z}{\\int }_{0}^{\\operatorname{cos}⁡z}\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡z}[\\sqrt{1+{cos}^{2}⁡z}{\\int }_{0}^{\\operatorname{cos}⁡z}\\text{d}x]\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡z}\\sqrt{1+{cos}^{2}⁡z}\\,[x]_{0}^{\\operatorname{cos}⁡z}\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡z}\\operatorname{cos}⁡z\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}[\\operatorname{cos}⁡z\\sqrt{1+{cos}^{2}⁡z}{\\int }_{0}^{\\operatorname{sin}⁡z}\\text{d}y]\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡z\\sqrt{1+{cos}^{2}⁡z}\\,[y]_{0}^{\\operatorname{sin}⁡z}\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡z\\operatorname{cos}⁡z\\sqrt{1+{cos}^{2}⁡z}\\,\\text{d}z \\\\  & ={[-\\frac{1}{3}{(1+{cos}^{2}⁡z)}^{3/2}]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{3}[(1+0)^{3/2}-(1+1)^{3/2}] \\\\  & =-\\frac{1}{3}(1-{2}^{3/2}) \\\\  & =\\frac{2\\sqrt{2}-1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-46815972-0754-5def-987e-4a8b3dd30f2a"] :db/ensure [:question/validate]} {:db/id "answer-field-46815972-0754-5def-987e-4a8b3dd30f2a" :answer-field/id #uuid "46815972-0754-5def-987e-4a8b3dd30f2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c5440dc0-7eb1-5868-85fb-0761762da9be" :answer-field/choices ["answer-448ae3db-641d-5f64-a5c9-14f4cedec775" "answer-b2d6645f-466a-52fe-b330-b115e7efc0a6" "answer-482bfb85-d1a0-5e37-9c53-93569bba7aac" "answer-c5440dc0-7eb1-5868-85fb-0761762da9be" "answer-df1540ff-dda7-54f2-9afe-827410ca5f75"] :db/ensure [:answer-field/validate]} {:db/id "answer-448ae3db-641d-5f64-a5c9-14f4cedec775" :answer/id #uuid "448ae3db-641d-5f64-a5c9-14f4cedec775" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b2d6645f-466a-52fe-b330-b115e7efc0a6" :answer/id #uuid "b2d6645f-466a-52fe-b330-b115e7efc0a6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-482bfb85-d1a0-5e37-9c53-93569bba7aac" :answer/id #uuid "482bfb85-d1a0-5e37-9c53-93569bba7aac" :answer/type :answer.type/math :answer/value "3\\sqrt{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-c5440dc0-7eb1-5868-85fb-0761762da9be" :answer/id #uuid "c5440dc0-7eb1-5868-85fb-0761762da9be" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{2}-1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-df1540ff-dda7-54f2-9afe-827410ca5f75" :answer/id #uuid "df1540ff-dda7-54f2-9afe-827410ca5f75" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186129529 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type III region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,\\sqrt{z}\\le x\\le 1,\\,\\,0\\le y\\le {e}^{z/x}\\}\n$$\n\nSince all repeated integrals first integrate with respect to $y,$ the $y$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{0}^{{e}^{z/x}}\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xz$-plane shown below.\n\n![](images/e8/e83c249a6abf9710a201462e16c646a11411dbcdbca46f34e9beb8d2db7a654b.png)\n\nThe region $D$ is type II region in the $xz$-plane:\n\n$$\nD=\\{(x,z)\\,:\\,0\\le z\\le 1,\\,\\sqrt{z}\\le x\\le 1\\}.\n$$\n\nTo change the order of integration from $\\text{d}y\\,\\text{d}x\\,\\text{d}z$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $D$ as a type I region.\n\nNotice that the top boundary of the region $D,$ written in the form $z=z(x),$ is\n\n$$\nx=\\sqrt{z}\\,⟹\\,z={x}^{2}\n$$\n\nand the bottom boundary of the region $D$ is\n\n$$\nz=0.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le {x}^{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/7e/7e684766b85a214d1f1dd7845979052c532e11ecce74d0284b8fc379b5669957.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{\\sqrt{z}}^{1}{\\int }_{0}^{{e}^{z/x}}\\text{d}y\\,\\text{d}x\\,\\text{d}z & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{\\int }_{0}^{{e}^{z/x}}\\text{d}y\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}[{\\int }_{0}^{{e}^{z/x}}\\text{d}y]\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}[y]_{0}^{{e}^{z/x}}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{e}^{z/x}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{{x}^{2}}{e}^{z/x}\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{1}[x{e}^{z/x}]_{z=0}^{z={x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(x{e}^{x}-x)\\,\\text{d}x \\\\  & ={[(x-1){e}^{x}-\\frac{1}{2}{x}^{2}]}_{0}^{1} \\\\  & =(0-\\frac{1}{2})-(-1-0) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186281429 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type I region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,\\operatorname{arcsin}⁡y\\le x\\le \\frac{\\pi }{2},\\,\\,0\\le z\\le {e}^{\\operatorname{cos}⁡x}\\}\n$$\n\nSince all repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{0}^{{e}^{\\operatorname{cos}⁡x}}\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/38/38eb7316b1ee5c947eee37a9cc10530ff08f793b7564cf0d88c6ce24e1239f9d.png)\n\nThe region $D$ is type II region in the $xy$-plane:\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\operatorname{arcsin}⁡y\\le x\\le \\frac{\\pi }{2}\\}.\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}x\\,\\text{d}y$ to $\\text{d}z\\,\\text{d}y\\,\\text{d}x,$ we write $D$ as a type I region.\n\nNotice that the top boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=\\operatorname{arcsin}⁡y\\,⟹\\,y=\\operatorname{sin}⁡x\n$$\n\nand the bottom boundary of the region $D$ is\n\n$$\ny=0.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{sin}⁡x\\},\n$$\n\nas shown in the diagram below.\n\n![](images/24/241abff7fae5d6ba3301d605ff4c4e62ff61e423515c7bc3a54b17b9aec525aa.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{\\operatorname{arcsin}⁡y}^{\\pi /2}{\\int }_{0}^{{e}^{\\operatorname{cos}⁡x}}\\text{d}z\\,\\text{d}x\\,\\text{d}y & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}{\\int }_{0}^{{e}^{\\operatorname{cos}⁡x}}\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}[{\\int }_{0}^{{e}^{\\operatorname{cos}⁡x}}\\text{d}z]\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}[z]_{0}^{{e}^{\\operatorname{cos}⁡x}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}{e}^{\\operatorname{cos}⁡x}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{e}^{\\operatorname{cos}⁡x}[{\\int }_{0}^{\\operatorname{sin}⁡x}\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{e}^{\\operatorname{cos}⁡x}[y]_{0}^{\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{e}^{\\operatorname{cos}⁡x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =[-{e}^{\\operatorname{cos}⁡x}]_{0}^{\\pi /2} \\\\  & =-({e}^{\\operatorname{cos}⁡\\pi /2}-{e}^{\\operatorname{cos}⁡0}) \\\\  & =-(1-e) \\\\  & =e-1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186281440 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}y\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le \\operatorname{arccos}⁡y,\\,\\,0\\le x\\le 2\\}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{0}^{2}y\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/c5/c5f4ec9b9b12411f3057bc074a14a1f541c768c30d3a9746d7a0484b0491ad2e.png)\n\nThe region $D$ is type I region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 1,\\,0\\le z\\le \\operatorname{arccos}⁡y\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region $D$ is\n\n$$\ny=0\n$$\n\nand the right boundary of the region $D,$ written in the form $y=y(z),$ is\n\n$$\nz=\\operatorname{arccos}⁡y\\,⟹\\,y=\\operatorname{cos}⁡z.\n$$\n\nThen, the type II representation of the region is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le z\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{cos}⁡z\\},\n$$\n\nas shown in the diagram below.\n\n![](images/07/077fc8133673cd57aba570cca9a6e0f5f25aa742720948c46db2b9e1d05add69.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{\\operatorname{arccos}⁡y}{\\int }_{0}^{2}y\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}{\\int }_{0}^{2}y\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}[{\\int }_{0}^{2}y\\,\\text{d}x]\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}y\\,[x]_{0}^{2}\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡z}2y\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}[{\\int }_{0}^{\\operatorname{cos}⁡z}2y\\,\\text{d}y]\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}[{y}^{2}]_{0}^{\\operatorname{cos}⁡z}\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{cos}^{2}⁡z\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}(1+\\operatorname{cos}⁡2z)\\,\\text{d}z \\\\  & =\\frac{1}{2}{[z+\\frac{1}{2}\\operatorname{sin}⁡2z]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{2}) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186281443 :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le z\\le e,\\,\\,\\operatorname{ln}⁡z\\le y\\le 1,\\,\\,0\\le x\\le \\sqrt{3}y\\}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/14/14c67512e143995cbfcfcf9e80c8d0975bbbc42368c97aa29956bd2d3f3454a8.png)\n\nThe region $D$ is type II region in the $yz$-plane:\n\n$$\nD=\\{(y,z)\\,:\\,1\\le z\\le e,\\,\\operatorname{ln}⁡z\\le y\\le 1\\}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $D$ as a type I region.\n\nNotice that the bottom boundary of the region $D$ is\n\n$$\nz=1\n$$\n\nand the top boundary of the region $D,$ written in the form $z=z(y),$ is\n\n$$\ny=\\operatorname{ln}⁡z\\,⟹\\,z={e}^{y}.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 1,\\,1\\le z\\le {e}^{y}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d18470b45d21b4734187c1f639784a4e75924ed212e3fa4c7a214d19eaeb6022.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{\\int }_{\\operatorname{ln}⁡z}^{1}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}[{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x]\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}{[\\operatorname{arctan}⁡(\\frac{x}{y})]}_{x=0}^{x=\\sqrt{3}y}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}\\operatorname{arctan}⁡\\sqrt{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}\\frac{\\pi }{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[\\frac{\\pi }{3}{\\int }_{1}^{{e}^{y}}\\text{d}z]\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{\\pi }{3}[z]_{1}^{{e}^{y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{\\pi }{3}({e}^{y}-1)\\,\\text{d}y \\\\  & =\\frac{\\pi }{3}[{e}^{y}-y]_{0}^{1} \\\\  & =\\frac{\\pi }{3}(e-1-1+0) \\\\  & =\\frac{\\pi (e-2)}{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129387 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} {:db/id 17592186096744 :knowledge-point/questions ["question-6b244d67-f2e6-5997-9db2-2abb0586d4be" "question-8875866b-8dd0-5b03-ad00-243a32baa5f0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186097236 :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=-\\frac{2}{3}{a}_{n},\\,{a}_{1}=5,\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{2}{3}.\n$$\n\nSince $|r|=\\frac{2}{3}<1$, the sequence converges to $0.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186095340 :answer-field/correct 17592186095344 :db/ensure [:answer-field/validate]} {:db/id "question-6b244d67-f2e6-5997-9db2-2abb0586d4be" :question/id #uuid "6b244d67-f2e6-5997-9db2-2abb0586d4be" :question/math-academy-id "q-123333" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=2{a}_{n},\\,{a}_{1}=-4,\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=2.\n$$\n\nSince $|r|=2>1$, the sequence diverges." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f"] :db/ensure [:question/validate]} {:db/id "answer-field-4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/id #uuid "4eef3b91-cbf1-5165-b4b4-6db1ea5e763f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer-field/choices ["answer-f4d729f2-8517-5f08-b3f8-1bda0315fedc" "answer-6cdc885e-37b4-5a68-a0b9-c54691be5651" "answer-43955b41-f6e8-5349-9111-56dd4e7126c8" "answer-ba63283c-6ba0-5b52-bd92-e677158a64ba" "answer-a6fb9534-7b00-51a6-9b6b-3e0661951505"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/id #uuid "f4d729f2-8517-5f08-b3f8-1bda0315fedc" :answer/type :answer.type/text :answer/value "Converges to $-4$" :db/ensure [:answer/validate]} {:db/id "answer-6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/id #uuid "6cdc885e-37b4-5a68-a0b9-c54691be5651" :answer/type :answer.type/text :answer/value "Converges to $0$" :db/ensure [:answer/validate]} {:db/id "answer-43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/id #uuid "43955b41-f6e8-5349-9111-56dd4e7126c8" :answer/type :answer.type/text :answer/value "Converges to $2$" :db/ensure [:answer/validate]} {:db/id "answer-ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/id #uuid "ba63283c-6ba0-5b52-bd92-e677158a64ba" :answer/type :answer.type/text :answer/value "Converges to $\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/id #uuid "a6fb9534-7b00-51a6-9b6b-3e0661951505" :answer/type :answer.type/text :answer/value "The sequence diverges" :db/ensure [:answer/validate]} {:db/id "question-8875866b-8dd0-5b03-ad00-243a32baa5f0" :question/id #uuid "8875866b-8dd0-5b03-ad00-243a32baa5f0" :question/math-academy-id "q-123334" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=4{a}_{n},\\,{a}_{1}=-\\frac{1}{4},\\,n\\ge 1\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=4.\n$$\n\nSince $|r|=4>1$, the sequence diverges." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-77095092-5c7c-58b9-9d24-8f2368d8a83f"] :db/ensure [:question/validate]} {:db/id "answer-field-77095092-5c7c-58b9-9d24-8f2368d8a83f" :answer-field/id #uuid "77095092-5c7c-58b9-9d24-8f2368d8a83f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e0c72dcf-0cfe-526c-b0ed-899e73f67e02" :answer-field/choices ["answer-55d44151-35f1-54c2-9d4d-cb890968345b" "answer-f0d2babb-cf96-5a12-b155-7886cd64321e" "answer-0d1a1119-11c9-535c-a456-e45cc9d7de82" "answer-c9f1522c-e116-5be3-a536-f1ce7ed8e514" "answer-e0c72dcf-0cfe-526c-b0ed-899e73f67e02"] :db/ensure [:answer-field/validate]} {:db/id "answer-55d44151-35f1-54c2-9d4d-cb890968345b" :answer/id #uuid "55d44151-35f1-54c2-9d4d-cb8