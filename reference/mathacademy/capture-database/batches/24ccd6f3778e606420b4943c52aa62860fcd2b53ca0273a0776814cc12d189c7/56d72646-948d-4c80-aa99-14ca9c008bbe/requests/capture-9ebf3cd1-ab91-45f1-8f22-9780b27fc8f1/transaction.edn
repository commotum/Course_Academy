29b8-4042-52f6-9283-103505d83924" :step/id #uuid "84d329b8-4042-52f6-9283-103505d83924" :step/content "question-fc3c433e-4980-575f-8e3b-31e27fc92890" :step/next "step-7bbc9dde-d9d3-56a8-9296-319bb468b4c4" :db/ensure [:step/validate]} {:db/id "step-7bbc9dde-d9d3-56a8-9296-319bb468b4c4" :step/id #uuid "7bbc9dde-d9d3-56a8-9296-319bb468b4c4" :step/content "question-88e971de-92ab-5f11-8659-2661a18f45d8" :db/ensure [:step/validate]} {:db/id "question-6cd59b40-dc86-5174-9cba-78e6f66091cf" :question/id #uuid "6cd59b40-dc86-5174-9cba-78e6f66091cf" :question/math-academy-id "q-86454" :question/problem "Given the function $f(x,y,z)=2y{e}^{x}-{e}^{z}$, find the equation of the tangent plane to the level surface that passes through the point where $(x,y,z)=(1,1,-1).$" :question/worked-solution "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(1,1,-1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(2y{e}^{x}-{e}^{z})\\text{ }i+\\frac{∂}{∂y}(2y{e}^{x}-{e}^{z})\\text{ }j+\\frac{∂}{∂z}(2y{e}^{x}-{e}^{z})\\text{ }k \\\\  & =2y{e}^{x}\\text{ }i+2{e}^{x}\\text{ }j-{e}^{z}k \\\\ ∇\\,f(1,1,-1) & =2(1)e\\text{ }i+2e\\text{ }j-{e}^{-1}k \\\\  & =2e\\,i+2e\\,j-{e}^{-1}k \\\\  & =⟨2e,2e,-\\frac{1}{e}⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows: \n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,1,-1)\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ ⟨2e,2e,-\\frac{1}{e}⟩\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ 2ex+2ey-\\frac{z}{e}-4e-\\frac{1}{e} & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-102d43bf-f5e9-5d2c-bd0c-f23bbb64ece6"] :db/ensure [:question/validate]} {:db/id "answer-field-102d43bf-f5e9-5d2c-bd0c-f23bbb64ece6" :answer-field/id #uuid "102d43bf-f5e9-5d2c-bd0c-f23bbb64ece6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c1fe292e-1813-51b6-937f-ba4fbfabb74f" :answer-field/choices ["answer-8605bb25-4120-54e0-870c-c12a2d8a2246" "answer-1038e636-38ca-52da-90c5-a091da531eb0" "answer-b1a1e914-b611-51ed-ac80-498a071f0b9a" "answer-c1fe292e-1813-51b6-937f-ba4fbfabb74f" "answer-27782ffe-f397-5d41-939c-10588c08a068"] :db/ensure [:answer-field/validate]} {:db/id "answer-8605bb25-4120-54e0-870c-c12a2d8a2246" :answer/id #uuid "8605bb25-4120-54e0-870c-c12a2d8a2246" :answer/type :answer.type/math :answer/value "2ex+2ey+\\frac{z}{e}-2e+\\frac{1}{e}=0" :db/ensure [:answer/validate]} {:db/id "answer-1038e636-38ca-52da-90c5-a091da531eb0" :answer/id #uuid "1038e636-38ca-52da-90c5-a091da531eb0" :answer/type :answer.type/math :answer/value "2ex+2ey+\\frac{z}{e}-4e+\\frac{1}{e}=0" :db/ensure [:answer/validate]} {:db/id "answer-b1a1e914-b611-51ed-ac80-498a071f0b9a" :answer/id #uuid "b1a1e914-b611-51ed-ac80-498a071f0b9a" :answer/type :answer.type/math :answer/value "2ex+2ey+ez+3e=0" :db/ensure [:answer/validate]} {:db/id "answer-c1fe292e-1813-51b6-937f-ba4fbfabb74f" :answer/id #uuid "c1fe292e-1813-51b6-937f-ba4fbfabb74f" :answer/type :answer.type/math :answer/value "2ex+2ey-\\frac{z}{e}-4e-\\frac{1}{e}=0" :db/ensure [:answer/validate]} {:db/id "answer-27782ffe-f397-5d41-939c-10588c08a068" :answer/id #uuid "27782ffe-f397-5d41-939c-10588c08a068" :answer/type :answer.type/math :answer/value "2ex-2ey-\\frac{z}{e}-\\frac{1}{e}=0" :db/ensure [:answer/validate]} {:db/id 17592186129179 :knowledge-point/questions ["question-d5913a4b-d974-52bc-82fc-74c4bb66f8ca" "question-138bcf11-9efc-57ee-ad7b-ef21818db0e7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d5913a4b-d974-52bc-82fc-74c4bb66f8ca" :question/id #uuid "d5913a4b-d974-52bc-82fc-74c4bb66f8ca" :question/math-academy-id "q-102710" :question/problem "Consider the surface ${e}^{xy}-{x}^{2}-2{z}^{2}=e-3.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(1,1,-1),$ what is the value of $\\frac{a-b}{c}?$" :question/worked-solution "Let's define  $f(x,y,z)={e}^{xy}-{x}^{2}-2{z}^{2}.$ Then, our surface can be viewed as the level surface $f(x,y,z)=e-3.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(1,1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({e}^{xy}-{x}^{2}-2{z}^{2})i+\\frac{∂}{∂y}({e}^{xy}-{x}^{2}-2{z}^{2}))j+\\frac{∂}{∂z}({e}^{xy}-{x}^{2}-2{z}^{2})k \\\\  & =(y{e}^{xy}-2x)i+(x{e}^{xy})j+(-4z)k \\\\ ∇f(1,1,-1) & =((1){e}^{(1)(1)}-2(1))\\text{ }i+(1){e}^{(1)(1)}\\text{ }j+(-4)(-1)\\text{ }k \\\\  & =(e-2)\\text{ }i+e\\text{ }j+4\\text{ }k \\\\  & =⟨e-2,\\,e,\\,4⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨e-2,\\,e,\\,4⟩.$\n\nFinally, $\\frac{a-b}{c}=\\frac{(e-2)-e}{4}=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d777c8fd-8f4e-5ca8-a5be-b50636868cd0"] :db/ensure [:question/validate]} {:db/id "answer-field-d777c8fd-8f4e-5ca8-a5be-b50636868cd0" :answer-field/id #uuid "d777c8fd-8f4e-5ca8-a5be-b50636868cd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-003c768f-4220-5a83-901d-9287c7398508" :answer-field/choices ["answer-003c768f-4220-5a83-901d-9287c7398508" "answer-d5390bff-ed73-5aab-86b6-9bd0d5dc8156" "answer-c65e5475-456e-5a45-8351-be33d7aba2f9" "answer-189491e7-f8db-50dd-a6d1-6eeaca6515ff" "answer-f88cff99-c81a-54d6-be8d-ad3057aab4a8"] :db/ensure [:answer-field/validate]} {:db/id "answer-003c768f-4220-5a83-901d-9287c7398508" :answer/id #uuid "003c768f-4220-5a83-901d-9287c7398508" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d5390bff-ed73-5aab-86b6-9bd0d5dc8156" :answer/id #uuid "d5390bff-ed73-5aab-86b6-9bd0d5dc8156" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-c65e5475-456e-5a45-8351-be33d7aba2f9" :answer/id #uuid "c65e5475-456e-5a45-8351-be33d7aba2f9" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-189491e7-f8db-50dd-a6d1-6eeaca6515ff" :answer/id #uuid "189491e7-f8db-50dd-a6d1-6eeaca6515ff" :answer/type :answer.type/math :answer/value "\\frac{e-2}{4}" :db/ensure [:answer/validate]} {:db/id "answer-f88cff99-c81a-54d6-be8d-ad3057aab4a8" :answer/id #uuid "f88cff99-c81a-54d6-be8d-ad3057aab4a8" :answer/type :answer.type/math :answer/value "e-2" :db/ensure [:answer/validate]} {:db/id "question-138bcf11-9efc-57ee-ad7b-ef21818db0e7" :question/id #uuid "138bcf11-9efc-57ee-ad7b-ef21818db0e7" :question/math-academy-id "q-102712" :question/problem "Consider the surface ${z}^{2}y+16=4\\sqrt{x}+y.$ Find the equation of the tangent plane to that surface at the point $(4,-1,3).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{z}^{2}y+16 & =4\\sqrt{x}+y. \\\\ {z}^{2}y-4\\sqrt{x}-y & =-16\\end{aligned}\n$$\n\nIf we set $f(x,y,z)={z}^{2}y-4\\sqrt{x}-y$, our surface can be viewed as the level surface $f(x,y,z)=-16.$ \n\nRecall that the equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(4,-1,3):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({z}^{2}y-4\\sqrt{x}-y)\\text{ }i+\\frac{∂}{∂y}({z}^{2}y-4\\sqrt{x}-y)\\text{ }j+\\frac{∂}{∂z}({z}^{2}y-4\\sqrt{x}-y)\\text{ }k \\\\  & =-\\frac{2}{\\sqrt{x}}\\text{ }i+({z}^{2}-1)\\text{ }j+2zy\\text{ }k \\\\ ∇\\,f(4,-1,3) & =-\\frac{2}{\\sqrt{4}}\\text{ }i+({3}^{2}-1)\\text{ }j+2(3)(-1)\\text{ }k \\\\  & =-\\,i+8\\text{ }j-6\\,k \\\\  & =⟨-1,8,-6⟩\\end{aligned}\n$$\n\nFinally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(4,-1,3)\\cdot ⟨x-4,\\,y+1,\\,z-3⟩ & =0 \\\\ ⟨-1,8,-6⟩\\cdot ⟨x-4,\\,y+1,\\,z-3⟩ & =0 \\\\ -(x-4)+8(y+1)-6(z-3) & =0 \\\\ -x+8y-6z+30 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-74e95cce-259a-58bc-a6dc-cf74c51c993b"] :db/ensure [:question/validate]} {:db/id "answer-field-74e95cce-259a-58bc-a6dc-cf74c51c993b" :answer-field/id #uuid "74e95cce-259a-58bc-a6dc-cf74c51c993b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea005b66-1e1f-575c-a788-5fbfb346d025" :answer-field/choices ["answer-ea005b66-1e1f-575c-a788-5fbfb346d025" "answer-bd87e438-6635-5fc8-8041-e85ff749d4dd" "answer-d50bfffc-a66c-5b56-a37e-a72964286f8c" "answer-8da732bc-eb58-5338-abe0-8d52e81e25e9" "answer-065677e5-6668-589c-8f82-28615b7c7eea"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea005b66-1e1f-575c-a788-5fbfb346d025" :answer/id #uuid "ea005b66-1e1f-575c-a788-5fbfb346d025" :answer/type :answer.type/math :answer/value "-x+8y-6z+30=0" :db/ensure [:answer/validate]} {:db/id "answer-bd87e438-6635-5fc8-8041-e85ff749d4dd" :answer/id #uuid "bd87e438-6635-5fc8-8041-e85ff749d4dd" :answer/type :answer.type/math :answer/value "-x+9y-z+16=0" :db/ensure [:answer/validate]} {:db/id "answer-d50bfffc-a66c-5b56-a37e-a72964286f8c" :answer/id #uuid "d50bfffc-a66c-5b56-a37e-a72964286f8c" :answer/type :answer.type/math :answer/value "3x+5y-6z-3=0" :db/ensure [:answer/validate]} {:db/id "answer-8da732bc-eb58-5338-abe0-8d52e81e25e9" :answer/id #uuid "8da732bc-eb58-5338-abe0-8d52e81e25e9" :answer/type :answer.type/math :answer/value "3x+8y-5z+12=0" :db/ensure [:answer/validate]} {:db/id "answer-065677e5-6668-589c-8f82-28615b7c7eea" :answer/id #uuid "065677e5-6668-589c-8f82-28615b7c7eea" :answer/type :answer.type/math :answer/value "x-6y+z-13=0" :db/ensure [:answer/validate]} {:db/id "activity-9ef07479-9bd3-50f2-b4da-e02ee5217b48" :activity/id #uuid "9ef07479-9bd3-50f2-b4da-e02ee5217b48" :activity/title "Tangent Planes to Level Surfaces" :activity/type :activity.type/review :activity/scope 17592186048554 :activity/course 17592186046660 :activity/steps ["step-7191b9bd-5ed6-54dc-8494-3debf9947402" "step-fb365c06-0aef-539e-aff8-8e2d2bf57273" "step-588c4361-50c9-5029-a566-867e8863cbe8" "step-48086a64-8671-5a00-bbb5-b58661fd7a59" "step-9ee2cdbe-40de-5a18-809a-b2ba9fbc04a8"] :activity/first-step "step-7191b9bd-5ed6-54dc-8494-3debf9947402" :db/ensure [:activity/validate]} {:db/id "step-7191b9bd-5ed6-54dc-8494-3debf9947402" :step/id #uuid "7191b9bd-5ed6-54dc-8494-3debf9947402" :step/content 17592186394071 :step/next "step-fb365c06-0aef-539e-aff8-8e2d2bf57273" :db/ensure [:step/validate]} {:db/id "step-fb365c06-0aef-539e-aff8-8e2d2bf57273" :step/id #uuid "fb365c06-0aef-539e-aff8-8e2d2bf57273" :step/content "question-6cd59b40-dc86-5174-9cba-78e6f66091cf" :step/next "step-588c4361-50c9-5029-a566-867e8863cbe8" :db/ensure [:step/validate]} {:db/id "step-588c4361-50c9-5029-a566-867e8863cbe8" :step/id #uuid "588c4361-50c9-5029-a566-867e8863cbe8" :step/content 17592186366808 :step/next "step-48086a64-8671-5a00-bbb5-b58661fd7a59" :db/ensure [:step/validate]} {:db/id "step-48086a64-8671-5a00-bbb5-b58661fd7a59" :step/id #uuid "48086a64-8671-5a00-bbb5-b58661fd7a59" :step/content "question-d5913a4b-d974-52bc-82fc-74c4bb66f8ca" :step/next "step-9ee2cdbe-40de-5a18-809a-b2ba9fbc04a8" :db/ensure [:step/validate]} {:db/id "step-9ee2cdbe-40de-5a18-809a-b2ba9fbc04a8" :step/id #uuid "9ee2cdbe-40de-5a18-809a-b2ba9fbc04a8" :step/content "question-138bcf11-9efc-57ee-ad7b-ef21818db0e7" :db/ensure [:step/validate]} {:db/id 17592186064386 :knowledge-point/questions ["question-5cbfe710-aab6-5e49-b65f-e20759621640" "question-d00df18b-1c5e-50a7-89f5-e1bc96838901"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5cbfe710-aab6-5e49-b65f-e20759621640" :question/id #uuid "5cbfe710-aab6-5e49-b65f-e20759621640" :question/math-academy-id "q-53189" :question/problem "![](images/ff/ff93274daa7f179f86343e59b7cf277c0e70555fdfdd3cce113c3cba149b08ac.png)\n\nAn airplane $A$ is flying horizontally at a constant height of $800\\,\\text{m}$ above the ground. The angle of elevation $\\theta $ made by the airplane and a nearby radar station $R$ is decreasing at a rate of $0.05$ radians per second. What is the speed of the aircraft as a function of $\\theta ?$" :question/worked-solution "![](images/29/29d06d071e6983d3487426b08d5a5548a611134dcf116674d199f6d3de03f246.png)\n\nIn the figure, $y$ is the airplane's altitude, and $x$ is the horizontal distance between the radar station and the airplane. The quantity $y=800$ meters does not change with time because the airplane stays at a constant altitude.\n\nWe wish to calculate $\\frac{\\text{d}x}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{800}{x} \\\\ x & =800\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(800\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =(-800{csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=-0.05$ (negative because the angle is decreasing). Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =(-800{csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =(-800{csc}^{2}⁡\\theta )(-0.05) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =40{csc}^{2}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, the speed of the aircraft is $40{csc}^{2}⁡\\theta \\,\\,\\text{m/s}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b75072c9-8631-52be-933c-279fbcae935a"] :db/ensure [:question/validate]} {:db/id "answer-field-b75072c9-8631-52be-933c-279fbcae935a" :answer-field/id #uuid "b75072c9-8631-52be-933c-279fbcae935a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe72755a-430b-5ef8-a7fc-ef1ec5c17011" :answer-field/choices ["answer-5f4dce0c-9b7e-5a89-af25-5aa2a3346d10" "answer-2fac3cfa-7abf-57a7-a5c4-1542f336991f" "answer-ec45e093-51a8-53a6-b55a-12e8101873db" "answer-fe72755a-430b-5ef8-a7fc-ef1ec5c17011" "answer-6a41d46c-11a5-5084-856a-7e8059285981"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f4dce0c-9b7e-5a89-af25-5aa2a3346d10" :answer/id #uuid "5f4dce0c-9b7e-5a89-af25-5aa2a3346d10" :answer/type :answer.type/math :answer/value "20\\operatorname{sec}⁡\\theta \\,\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-2fac3cfa-7abf-57a7-a5c4-1542f336991f" :answer/id #uuid "2fac3cfa-7abf-57a7-a5c4-1542f336991f" :answer/type :answer.type/math :answer/value "30{cos}^{2}⁡\\theta \\,\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-ec45e093-51a8-53a6-b55a-12e8101873db" :answer/id #uuid "ec45e093-51a8-53a6-b55a-12e8101873db" :answer/type :answer.type/math :answer/value "30{sin}^{2}⁡\\theta \\,\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-fe72755a-430b-5ef8-a7fc-ef1ec5c17011" :answer/id #uuid "fe72755a-430b-5ef8-a7fc-ef1ec5c17011" :answer/type :answer.type/math :answer/value "40{csc}^{2}⁡\\theta \\,\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "answer-6a41d46c-11a5-5084-856a-7e8059285981" :answer/id #uuid "6a41d46c-11a5-5084-856a-7e8059285981" :answer/type :answer.type/math :answer/value "500\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id 17592186064288 :knowledge-point/questions ["question-4220ee9a-71ec-56c9-a4ec-d0480b90a44d" "question-70ef2d3a-cac0-51c8-b6cc-9ac0c81e8893"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4220ee9a-71ec-56c9-a4ec-d0480b90a44d" :question/id #uuid "4220ee9a-71ec-56c9-a4ec-d0480b90a44d" :question/math-academy-id "q-53199" :question/problem "![](images/06/06f965498f6415c08b32c5ae30235a8eec65d6dd67cd1f349e80bcbe88bd5495.png)\n\nA boy $B$ is flying a kite $K$ with a $20\\,\\text{m}$ length of string. If the kite is rising vertically at a constant speed of $1\\,\\text{m/s},$ at what rate is the angle of elevation $\\theta $ increasing when $\\theta ={45}^{∘}?$" :question/worked-solution "![](images/23/236144ff93bd22f5c4460c31e20216c45d6f8ac85dc945321dadecc093f379e0.png)\n\nIn the figure, $y$ is the kite's height, and $z$ is the distance between the boy and the kite. The quantity $z=20$ meters does not change with time because the string's length doesn't change.\n\nWe wish to calculate $\\frac{\\text{d}\\theta }{\\text{d}t}.$\nTo do this, let's start by setting up a relation between $y$ and $z.$ Relative to the angle $\\theta ,$ the sides $y$ and $z$ are the opposite and hypotenuse, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{y}{z} \\\\ \\operatorname{sin}⁡\\theta  & =\\frac{y}{20} \\\\ y & =20\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(20\\operatorname{sin}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =(20\\operatorname{cos}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nConverting the given information from degrees to radians, we have $\\frac{\\text{d}y}{\\text{d}t}=1$ and $\\theta ={45}^{∘}\\cdot \\frac{\\pi }{{180}^{∘}}=\\frac{\\pi }{4}.$ Substituting this into the above, we reach\n\n$$\n\\begin{aligned}1 & =(20\\operatorname{cos}⁡(\\frac{\\pi }{4}))\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{1}{20} & =(\\frac{\\sqrt{2}}{2})\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\frac{\\sqrt{2}}{20}.\\end{aligned}\n$$\n\nTherefore, the angle of elevation is increasing at a rate of $\\frac{\\sqrt{2}}{20}$ radians per second." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5096af22-5b72-55f8-89a3-f7336942ca60"] :db/ensure [:question/validate]} {:db/id "answer-field-5096af22-5b72-55f8-89a3-f7336942ca60" :answer-field/id #uuid "5096af22-5b72-55f8-89a3-f7336942ca60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d5b4088-b923-5d8d-b898-9ef038b7221e" :answer-field/choices ["answer-f407d38e-a26b-5b5c-8e63-0d3d2b384765" "answer-78790129-6ad3-5b94-a1fd-e8e6c328e78d" "answer-9212d90c-2509-5164-b39b-daaf88c41146" "answer-1d5b4088-b923-5d8d-b898-9ef038b7221e" "answer-14580d19-87db-5577-b886-dede88420678"] :db/ensure [:answer-field/validate]} {:db/id "answer-f407d38e-a26b-5b5c-8e63-0d3d2b384765" :answer/id #uuid "f407d38e-a26b-5b5c-8e63-0d3d2b384765" :answer/type :answer.type/math :answer/value "10\\sqrt{2}\\,\\text{rad/s}" :db/ensure [:answer/validate]} {:db/id "answer-78790129-6ad3-5b94-a1fd-e8e6c328e78d" :answer/id #uuid "78790129-6ad3-5b94-a1fd-e8e6c328e78d" :answer/type :answer.type/math :answer/value "\\frac{1}{10}\\,\\text{rad/s}" :db/ensure [:answer/validate]} {:db/id "answer-9212d90c-2509-5164-b39b-daaf88c41146" :answer/id #uuid "9212d90c-2509-5164-b39b-daaf88c41146" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\,\\text{rad/s}" :db/ensure [:answer/validate]} {:db/id "answer-1d5b4088-b923-5d8d-b898-9ef038b7221e" :answer/id #uuid "1d5b4088-b923-5d8d-b898-9ef038b7221e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{20}\\,\\text{rad/s}" :db/ensure [:answer/validate]} {:db/id "answer-14580d19-87db-5577-b886-dede88420678" :answer/id #uuid "14580d19-87db-5577-b886-dede88420678" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{10}\\,\\text{rad/s}" :db/ensure [:answer/validate]} {:db/id 17592186064385 :knowledge-point/questions ["question-847493a1-e66a-5ae4-9cf4-e1e68a84c19e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-847493a1-e66a-5ae4-9cf4-e1e68a84c19e" :question/id #uuid "847493a1-e66a-5ae4-9cf4-e1e68a84c19e" :question/math-academy-id "q-121713" :question/problem "![](images/ec/ecb02db9984510219c6209392c9f35df52eca11dacc802a133aa51c4e5065ede.png)\n\nA drone $D$ takes off from a point $P$ and climbs with an angle of elevation of ${60}^{∘}$ and a vertical speed of $4\\,\\text{km}/\\text{h}.$ Assuming the angle of elevation doesn't change, calculate the actual speed of the drone in the direction it is traveling.\nRound your answer to two decimal places." :question/worked-solution "![](images/69/69314419f6e0b93236fc048c6b9b6b262b09ff2cc061996353fbe23870a12726.png)\n\nLet $y$ denote the vertical distance from the drone's projection to the starting point, and $z$ be the distance between the drone and the starting point, as shown above.\n\nWe want to find $\\frac{\\text{d}z}{\\text{d}t}.$ To do this, let's start by setting up a relation between $y$ and $z.$ Relative to the angle $\\theta ={60}^{∘},$ the sides $y$ and $z$ are the opposite and hypotenuse, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡({60}^{∘}) & =\\frac{y}{z} \\\\ \\frac{\\sqrt{3}}{2} & =\\frac{y}{z} \\\\ z & =\\frac{2\\sqrt{3}}{3}y.\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(z) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2\\sqrt{3}}{3}y) \\\\ \\frac{\\text{d}z}{\\text{d}t} & =\\frac{2\\sqrt{3}}{3}\\,\\frac{\\text{d}y}{\\text{d}t}.\\end{aligned}\n$$\n\nWe know that $\\frac{\\text{d}y}{\\text{d}t}=4\\text{km}/\\text{h}.$ Substituting this into the above gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}t}=\\frac{2\\sqrt{3}}{3}\\cdot 4≈4.62\n$$\n\nrounded to two decimal places.\n\nTherefore, the speed of the drone is approximately $4.62\\,\\text{km}/\\text{h}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c44dc184-d6a9-51f1-aaf9-4f2394dbe32b"] :db/ensure [:question/validate]} {:db/id "answer-field-c44dc184-d6a9-51f1-aaf9-4f2394dbe32b" :answer-field/id #uuid "c44dc184-d6a9-51f1-aaf9-4f2394dbe32b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf8772f4-5572-5416-89ab-0f1ffa36973b" :answer-field/choices ["answer-33182b33-0b36-5640-a4c9-778cbc8910ae" "answer-cf8772f4-5572-5416-89ab-0f1ffa36973b" "answer-913b0f46-1aad-5da8-b8dd-1bf4b4bb9711" "answer-b840f7bb-0678-5531-ad85-8cea6f5889e6" "answer-e24d129b-6aba-55f9-bf48-3093ebfec375"] :db/ensure [:answer-field/validate]} {:db/id "answer-33182b33-0b36-5640-a4c9-778cbc8910ae" :answer/id #uuid "33182b33-0b36-5640-a4c9-778cbc8910ae" :answer/type :answer.type/math :answer/value "4.55\\,\\text{km}/\\text{h}" :db/ensure [:answer/validate]} {:db/id "answer-cf8772f4-5572-5416-89ab-0f1ffa36973b" :answer/id #uuid "cf8772f4-5572-5416-89ab-0f1ffa36973b" :answer/type :answer.type/math :answer/value "4.62\\,\\text{km}/\\text{h}" :db/ensure [:answer/validate]} {:db/id "answer-913b0f46-1aad-5da8-b8dd-1bf4b4bb9711" :answer/id #uuid "913b0f46-1aad-5da8-b8dd-1bf4b4bb9711" :answer/type :answer.type/math :answer/value "4.78\\,\\text{km}/\\text{h}" :db/ensure [:answer/validate]} {:db/id "answer-b840f7bb-0678-5531-ad85-8cea6f5889e6" :answer/id #uuid "b840f7bb-0678-5531-ad85-8cea6f5889e6" :answer/type :answer.type/math :answer/value "4.84\\,\\text{km}/\\text{h}" :db/ensure [:answer/validate]} {:db/id "answer-e24d129b-6aba-55f9-bf48-3093ebfec375" :answer/id #uuid "e24d129b-6aba-55f9-bf48-3093ebfec375" :answer/type :answer.type/math :answer/value "4.93\\,\\text{km}/\\text{h}" :db/ensure [:answer/validate]} {:db/id "question-d00df18b-1c5e-50a7-89f5-e1bc96838901" :question/id #uuid "d00df18b-1c5e-50a7-89f5-e1bc96838901" :question/math-academy-id "q-314883" :question/problem "![](images/7d/7de8ecd3d178cf07377aef5ca96ce28f638700e6284d151e3578ba11ed87327a.png)\n\nEthan notices a drone descending. He estimates that the distance between his location and the point on the ground directly beneath the drone is $150\\,\\text{ft}.$ If the angle of elevation $\\theta $ between him and the drone decreases at a rate of $0.1\\,\\text{rad/s},$ at what rate is its altitude decreasing when $\\theta =\\frac{\\pi }{3}?$ Assume that the rate of decreasing altitude is **positive** and do not round the answer.\n\nThe drone's altitude is decreasing at a rate of\n{{field-1}}\n$\\text{ft/s}.$" :question/worked-solution "![](images/50/5024a642ac27698d848577165b08e3158d3248d50c064a79432fcad6e2df90d5.png)\n\nIn the figure, $y$ is the drone’s altitude, and $x$ is the distance between Ethan and the shadow. The quantity $x=150\\,\\text{ft}$ does not change with time because the distance between Ethan and the shadow is fixed.\n\nWe wish to calculate $\\frac{\\text{d}y}{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{y}{150} \\\\ y & =150\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}(150\\operatorname{tan}⁡\\theta ) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =150{sec}^{2}⁡\\theta \\cdot \\frac{\\text{d}\\theta }{\\text{d}t}\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}\\theta }{\\text{d}t}=-0.1$ (negative because the angle is decreasing) and $\\theta =\\frac{\\pi }{3}.$ Substituting these values into the above, we reach\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =150{sec}^{2}⁡(\\frac{\\pi }{3})(-0.1) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =150(4)(-0.1) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =-60.\\end{aligned}\n$$\n\nTherefore, the drone's altitude is decreasing at a rate of $60\\,\\text{ft/s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1bfd8d1-d406-5259-8076-e675c9f53bf2"] :db/ensure [:question/validate]} {:db/id "answer-field-b1bfd8d1-d406-5259-8076-e675c9f53bf2" :answer-field/id #uuid "b1bfd8d1-d406-5259-8076-e675c9f53bf2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0acd652e-3691-5e84-bd19-a5ecf963137a" :answer-field/choices ["answer-0acd652e-3691-5e84-bd19-a5ecf963137a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0acd652e-3691-5e84-bd19-a5ecf963137a" :answer/id #uuid "0acd652e-3691-5e84-bd19-a5ecf963137a" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "question-70ef2d3a-cac0-51c8-b6cc-9ac0c81e8893" :question/id #uuid "70ef2d3a-cac0-51c8-b6cc-9ac0c81e8893" :question/math-academy-id "q-343183" :question/problem "![](images/c4/c410aeaa3ceeafe3b072233a51020594370431e35244ca240637c5b124807983.png)\n\nA firefighter $F$ is lowering a rescue basket $B$ from a helicopter. The basket stays $40\\,\\text{ft}$ above the ground while it moves horizontally toward the firefighter at a speed of $12\\,\\text{ft/s}.$ Find, in radians per second as a function of $\\theta ,$ the rate at which the angle $\\theta $ between the cable and the horizontal is increasing.\n\nThe angle is increasing at a rate of\n{{field-1}}\n$\\text{rad/s}.$" :question/worked-solution "![](images/cf/cfac2040d258398133397c5322e650bf60f59c7c372c97bfecec654eb3a4a278.png)\n\nIn the figure, $y$ is the basket's height, and $x$ is the horizontal distance between the firefighter and the basket. The quantity $y=40$ feet does not change with time because the basket height remains the same.\n\nWe wish to calculate $\\frac{\\text{d}\\theta }{\\text{d}t}.$ To do this, let's start by setting up a relation between $x$ and $y.$ Relative to the angle $\\theta ,$ the sides $x$ and $y$ are the adjacent and opposite, respectively. So, we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta  & =\\frac{y}{x} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{40}{x} \\\\ x & =40\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$\n\nNow, we differentiate both sides of the equation with respect to $t$ using implicit differentiation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(x) & =\\frac{\\text{d}}{\\text{d}t}(40\\operatorname{cot}⁡\\theta ) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =(-40{csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t}.\\end{aligned}\n$$\n\nFrom the given information, we have $\\frac{\\text{d}x}{\\text{d}t}=-12\\,\\text{ft/s}$ (negative because the horizontal distance is decreasing). Substituting this into the above, we reach\n\n$$\n\\begin{aligned}-12 & =(-40{csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{12}{40} & =({csc}^{2}⁡\\theta )\\frac{\\text{d}\\theta }{\\text{d}t} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\frac{12}{40}{sin}^{2}⁡\\theta  \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =\\frac{3}{10}{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, the angle is increasing at a rate of $\\frac{3}{10}{sin}^{2}⁡\\theta \\,\\text{rad/s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-075eec91-479f-514d-b496-401b7ceb517c"] :db/ensure [:question/validate]} {:db/id "answer-field-075eec91-479f-514d-b496-401b7ceb517c" :answer-field/id #uuid "075eec91-479f-514d-b496-401b7ceb517c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-25909b6a-2bda-5136-9440-1e737f4b1063" :answer-field/choices ["answer-25909b6a-2bda-5136-9440-1e737f4b1063"] :db/ensure [:answer-field/validate]} {:db/id "answer-25909b6a-2bda-5136-9440-1e737f4b1063" :answer/id #uuid "25909b6a-2bda-5136-9440-1e737f4b1063" :answer/type :answer.type/math :answer/value "\\frac{3}{10}\\sin^2\\theta" :db/ensure [:answer/validate]} {:db/id "activity-ca108108-17d4-5f4b-8827-323beb81ff84" :activity/id #uuid "ca108108-17d4-5f4b-8827-323beb81ff84" :activity/title "Calculating Related Rates Using Trigonometry" :activity/type :activity.type/review :activity/scope 17592186049168 :activity/course 17592186046669 :activity/steps ["step-9b218fda-b689-564e-9378-201209ba1bc4" "step-a88a66de-c5b3-5b9e-aac7-5154923ab26e" "step-9666dca7-9168-5a9d-9fb0-a3b4bc64ba0e" "step-3a9e38c3-b897-5f5d-93dc-fef0dc09243e" "step-663845a1-8a70-5c83-82d2-15fcdebd3d49"] :activity/first-step "step-9b218fda-b689-564e-9378-201209ba1bc4" :db/ensure [:activity/validate]} {:db/id "step-9b218fda-b689-564e-9378-201209ba1bc4" :step/id #uuid "9b218fda-b689-564e-9378-201209ba1bc4" :step/content "question-5cbfe710-aab6-5e49-b65f-e20759621640" :step/next "step-a88a66de-c5b3-5b9e-aac7-5154923ab26e" :db/ensure [:step/validate]} {:db/id "step-a88a66de-c5b3-5b9e-aac7-5154923ab26e" :step/id #uuid "a88a66de-c5b3-5b9e-aac7-5154923ab26e" :step/content "question-4220ee9a-71ec-56c9-a4ec-d0480b90a44d" :step/next "step-9666dca7-9168-5a9d-9fb0-a3b4bc64ba0e" :db/ensure [:step/validate]} {:db/id "step-9666dca7-9168-5a9d-9fb0-a3b4bc64ba0e" :step/id #uuid "9666dca7-9168-5a9d-9fb0-a3b4bc64ba0e" :step/content "question-847493a1-e66a-5ae4-9cf4-e1e68a84c19e" :step/next "step-3a9e38c3-b897-5f5d-93dc-fef0dc09243e" :db/ensure [:step/validate]} {:db/id "step-3a9e38c3-b897-5f5d-93dc-fef0dc09243e" :step/id #uuid "3a9e38c3-b897-5f5d-93dc-fef0dc09243e" :step/content "question-d00df18b-1c5e-50a7-89f5-e1bc96838901" :step/next "step-663845a1-8a70-5c83-82d2-15fcdebd3d49" :db/ensure [:step/validate]} {:db/id "step-663845a1-8a70-5c83-82d2-15fcdebd3d49" :step/id #uuid "663845a1-8a70-5c83-82d2-15fcdebd3d49" :step/content "question-70ef2d3a-cac0-51c8-b6cc-9ac0c81e8893" :db/ensure [:step/validate]} {:db/id 17592186198443 :knowledge-point/questions ["question-2573d8ba-3c24-5f3f-9b87-70aaa707f60f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2573d8ba-3c24-5f3f-9b87-70aaa707f60f" :question/id #uuid "2573d8ba-3c24-5f3f-9b87-70aaa707f60f" :question/math-academy-id "q-170399" :question/problem "The maximum value of the quadratic form $Q(x)=2{x}_{1}^{2}-4{x}_{1}{x}_{2}-{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $3.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}]\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=3:$\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -2 \\\\ -2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector $v=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-80690941-9f30-50e8-8d51-0076ff14e552"] :db/ensure [:question/validate]} {:db/id "answer-field-80690941-9f30-50e8-8d51-0076ff14e552" :answer-field/id #uuid "80690941-9f30-50e8-8d51-0076ff14e552" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-835e0ac0-7f22-528a-afc9-15cbe76a1402" :answer-field/choices ["answer-e89e9894-f31f-51c2-beb8-dd440d12ff18" "answer-863bde5b-d22c-5fd4-9a26-b04e908b2888" "answer-835e0ac0-7f22-528a-afc9-15cbe76a1402" "answer-342b5faf-5467-5bea-910c-e959f5b08625" "answer-a2cffe23-ea90-5557-b734-2ff2fade4737"] :db/ensure [:answer-field/validate]} {:db/id "answer-e89e9894-f31f-51c2-beb8-dd440d12ff18" :answer/id #uuid "e89e9894-f31f-51c2-beb8-dd440d12ff18" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-863bde5b-d22c-5fd4-9a26-b04e908b2888" :answer/id #uuid "863bde5b-d22c-5fd4-9a26-b04e908b2888" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-835e0ac0-7f22-528a-afc9-15cbe76a1402" :answer/id #uuid "835e0ac0-7f22-528a-afc9-15cbe76a1402" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-342b5faf-5467-5bea-910c-e959f5b08625" :answer/id #uuid "342b5faf-5467-5bea-910c-e959f5b08625" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a2cffe23-ea90-5557-b734-2ff2fade4737" :answer/id #uuid "a2cffe23-ea90-5557-b734-2ff2fade4737" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "activity-af4e152b-9159-5e39-89fa-52c6c18116b5" :activity/id #uuid "af4e152b-9159-5e39-89fa-52c6c18116b5" :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type :activity.type/review :activity/scope 17592186048933 :activity/course 17592186046658 :activity/steps ["step-8bde0413-d197-52dc-8e81-d70c140da1dd" "step-c4df8914-beec-5d9d-a94f-b0c600c66999" "step-b204c6c0-5e97-58d3-9261-a4f595c8b068" "step-78457419-551b-5efb-a799-a3963553ae4e" "step-d17cf88e-86b6-5923-b3e6-bc5926600e4f"] :activity/first-step "step-8bde0413-d197-52dc-8e81-d70c140da1dd" :db/ensure [:activity/validate]} {:db/id "step-8bde0413-d197-52dc-8e81-d70c140da1dd" :step/id #uuid "8bde0413-d197-52dc-8e81-d70c140da1dd" :step/content 17592186198685 :step/next "step-c4df8914-beec-5d9d-a94f-b0c600c66999" :db/ensure [:step/validate]} {:db/id "step-c4df8914-beec-5d9d-a94f-b0c600c66999" :step/id #uuid "c4df8914-beec-5d9d-a94f-b0c600c66999" :step/content "question-2573d8ba-3c24-5f3f-9b87-70aaa707f60f" :step/next "step-b204c6c0-5e97-58d3-9261-a4f595c8b068" :db/ensure [:step/validate]} {:db/id "step-b204c6c0-5e97-58d3-9261-a4f595c8b068" :step/id #uuid "b204c6c0-5e97-58d3-9261-a4f595c8b068" :step/content 17592186542191 :step/next "step-78457419-551b-5efb-a799-a3963553ae4e" :db/ensure [:step/validate]} {:db/id "step-78457419-551b-5efb-a799-a3963553ae4e" :step/id #uuid "78457419-551b-5efb-a799-a3963553ae4e" :step/content 17592186389629 :step/next "step-d17cf88e-86b6-5923-b3e6-bc5926600e4f" :db/ensure [:step/validate]} {:db/id "step-d17cf88e-86b6-5923-b3e6-bc5926600e4f" :step/id #uuid "d17cf88e-86b6-5923-b3e6-bc5926600e4f" :step/content 17592186389636 :db/ensure [:step/validate]} {:db/id "activity-6dc7ac15-0a44-5d9e-9fc8-92ea8c7c8833" :activity/id #uuid "6dc7ac15-0a44-5d9e-9fc8-92ea8c7c8833" :activity/title "The Fundamental Theorem for Line Integrals" :activity/type :activity.type/review :activity/scope 17592186048308 :activity/course 17592186046660 :activity/steps ["step-b60329da-a444-57a9-b50b-19ebe65ffae5" "step-b2250ee8-d365-5b15-95dc-e924af190b6e" "step-c701ba9d-2e0f-5001-9a2a-090a2ae8ed57" "step-483708f5-37ca-59c3-817d-8740001e626d" "step-e502ee71-f712-5183-adfd-f99482651c2f"] :activity/first-step "step-b60329da-a444-57a9-b50b-19ebe65ffae5" :db/ensure [:activity/validate]} {:db/id "step-b60329da-a444-57a9-b50b-19ebe65ffae5" :step/id #uuid "b60329da-a444-57a9-b50b-19ebe65ffae5" :step/content 17592186240919 :step/next "step-b2250ee8-d365-5b15-95dc-e924af190b6e" :db/ensure [:step/validate]} {:db/id "step-b2250ee8-d365-5b15-95dc-e924af190b6e" :step/id #uuid "b2250ee8-d365-5b15-95dc-e924af190b6e" :step/content 17592186240921 :step/next "step-c701ba9d-2e0f-5001-9a2a-090a2ae8ed57" :db/ensure [:step/validate]} {:db/id "step-c701ba9d-2e0f-5001-9a2a-090a2ae8ed57" :step/id #uuid "c701ba9d-2e0f-5001-9a2a-090a2ae8ed57" :step/content 17592186240926 :step/next "step-483708f5-37ca-59c3-817d-8740001e626d" :db/ensure [:step/validate]} {:db/id "step-483708f5-37ca-59c3-817d-8740001e626d" :step/id #uuid "483708f5-37ca-59c3-817d-8740001e626d" :step/content 17592186259589 :step/next "step-e502ee71-f712-5183-adfd-f99482651c2f" :db/ensure [:step/validate]} {:db/id "step-e502ee71-f712-5183-adfd-f99482651c2f" :step/id #uuid "e502ee71-f712-5183-adfd-f99482651c2f" :step/content 17592186259593 :db/ensure [:step/validate]} {:db/id "activity-aec8459e-928a-54f2-bdee-00c8aea7fe8b" :activity/id #uuid "aec8459e-928a-54f2-bdee-00c8aea7fe8b" :activity/title "The Image of a Linear Transformation in the Cartesian Plane" :activity/type :activity.type/review :activity/scope 17592186049895 :activity/course 17592186046669 :activity/steps ["step-ea3324c3-6bf7-53ce-b75e-4da72766cf63" "step-4e1cc83d-73ad-5afc-aeed-1408d33e5a20" "step-d2f2b9cb-b3c2-59aa-97dd-0e695b49c9ac" "step-ab78c80f-43b1-5e4a-b1ce-b10f78c76970" "step-ce998921-646a-57c6-8ac9-ac0f89d7c0db"] :activity/first-step "step-ea3324c3-6bf7-53ce-b75e-4da72766cf63" :db/ensure [:activity/validate]} {:db/id "step-ea3324c3-6bf7-53ce-b75e-4da72766cf63" :step/id #uuid "ea3324c3-6bf7-53ce-b75e-4da72766cf63" :step/content 17592186176476 :step/next "step-4e1cc83d-73ad-5afc-aeed-1408d33e5a20" :db/ensure [:step/validate]} {:db/id "step-4e1cc83d-73ad-5afc-aeed-1408d33e5a20" :step/id #uuid "4e1cc83d-73ad-5afc-aeed-1408d33e5a20" :step/content 17592186366052 :step/next "step-d2f2b9cb-b3c2-59aa-97dd-0e695b49c9ac" :db/ensure [:step/validate]} {:db/id "step-d2f2b9cb-b3c2-59aa-97dd-0e695b49c9ac" :step/id #uuid "d2f2b9cb-b3c2-59aa-97dd-0e695b49c9ac" :step/content 17592186366752 :step/next "step-ab78c80f-43b1-5e4a-b1ce-b10f78c76970" :db/ensure [:step/validate]} {:db/id "step-ab78c80f-43b1-5e4a-b1ce-b10f78c76970" :step/id #uuid "ab78c80f-43b1-5e4a-b1ce-b10f78c76970" :step/content 17592186366759 :step/next "step-ce998921-646a-57c6-8ac9-ac0f89d7c0db" :db/ensure [:step/validate]} {:db/id "step-ce998921-646a-57c6-8ac9-ac0f89d7c0db" :step/id #uuid "ce998921-646a-57c6-8ac9-ac0f89d7c0db" :step/content 17592186366780 :db/ensure [:step/validate]} {:db/id 17592186180043 :question/problem "![](images/96/9610c7c482b561f4893b562bb6cf891136b30bea20c73fd56caa9a1a12a7a088.png)\n\nConsider the vector field $F=-3x\\,i-2y\\,j$ and a rectangle $C$ with base $4$ and height $2$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/00/00a9df76d0be8ffd33b2ee968b57a21eb1e6947af6e94505313f163b584f5769.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-3x\\,i-2y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-3{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=2i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{1}}x\\,\\text{d}s & =-3{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-6{\\int }_{-1}^{1}\\text{d}t \\\\  & =(-6)\\cdot 2 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-12.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-3x\\,i-2y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-2{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{2}}y\\,\\text{d}s & =-2{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-2)\\cdot 4 \\\\  & =-8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-8.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-12)+2\\cdot (-8)=-40.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186177927 :answer-field/correct 17592186177928 :db/ensure [:answer-field/validate]} {:db/id "activity-578b92bf-466f-5207-945a-0605d797aa62" :activity/id #uuid "578b92bf-466f-5207-945a-0605d797aa62" :activity/title "Flux in Two-Dimensional Vector Fields" :activity/type :activity.type/review :activity/scope 17592186048376 :activity/course 17592186046660 :activity/steps ["step-97b65eb2-a61d-5b8b-bd1d-2f9610ae0159" "step-8882da5c-fefd-542c-9f62-ae9cdf72d28b" "step-8b05f5f4-56d4-5bb8-9e86-b287c5eec63b" "step-68811b82-5f24-573c-8d64-ab6082f50702" "step-8441d503-58fc-53ce-bdfa-9a92cf71eb4b"] :activity/first-step "step-97b65eb2-a61d-5b8b-bd1d-2f9610ae0159" :db/ensure [:activity/validate]} {:db/id "step-97b65eb2-a61d-5b8b-bd1d-2f9610ae0159" :step/id #uuid "97b65eb2-a61d-5b8b-bd1d-2f9610ae0159" :step/content 17592186180037 :step/next "step-8882da5c-fefd-542c-9f62-ae9cdf72d28b" :db/ensure [:step/validate]} {:db/id "step-8882da5c-fefd-542c-9f62-ae9cdf72d28b" :step/id #uuid "8882da5c-fefd-542c-9f62-ae9cdf72d28b" :step/content 17592186552470 :step/next "step-8b05f5f4-56d4-5bb8-9e86-b287c5eec63b" :db/ensure [:step/validate]} {:db/id "step-8b05f5f4-56d4-5bb8-9e86-b287c5eec63b" :step/id #uuid "8b05f5f4-56d4-5bb8-9e86-b287c5eec63b" :step/content 17592186262724 :step/next "step-68811b82-5f24-573c-8d64-ab6082f50702" :db/ensure [:step/validate]} {:db/id "step-68811b82-5f24-573c-8d64-ab6082f50702" :step/id #uuid "68811b82-5f24-573c-8d64-ab6082f50702" :step/content 17592186180043 :step/next "step-8441d503-58fc-53ce-bdfa-9a92cf71eb4b" :db/ensure [:step/validate]} {:db/id "step-8441d503-58fc-53ce-bdfa-9a92cf71eb4b" :step/id #uuid "8441d503-58fc-53ce-bdfa-9a92cf71eb4b" :step/content 17592186420915 :db/ensure [:step/validate]} {:db/id 17592186115287 :knowledge-point/questions ["question-dae1615e-910b-570a-9c8d-abe635df0b2e" "question-90f18038-3a01-51b3-920b-b432cec605da" "question-93eea4d8-b061-5509-a1b0-2eaeace6d46a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115110 :question/problem "Graph the curve corresponding to the equation $y=\\dfrac{1}{9}(x-3)(x+2)(x+3).$" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a positive cubic because if we were to expand the parentheses, the coefficient of the $x^3$ term would be positive:\n\n$$\n\\dfrac{1}{9}({\\color{blue}{x}}-3)({\\color{red}{x}}+2)(x+3) = \\dfrac 1 9\\cdot {\\color{blue}{x}}\\cdot {\\color{red}{x}}\\cdot x +\\cdots = \\dfrac 1 9 x^3+\\cdots\n$$\n\nThe equation is already in factored form. So by the zero-product rule, we deduce that the roots are $x=3,$ $x=-2,$ and $x=-3.$ \n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{9}(0-3)(0+2)(0+3) \\\\  & =\\frac{(-3)(2)(3)}{9} \\\\  & =-2\\end{aligned}\n$$\n\nSo, we draw an inverted ${\\textsf{S}}$-shaped graph that passes through the three roots $x=-3,-2,3$ and has the $y$-intercept $y=-2,$ as follows:\n\n![](images/71/7164fec4ddfa7b68489775b7feef639b61846188fc603186fe115f492dec606d.png)" :db/ensure [:question/validate]} {:db/id 17592186115288 :knowledge-point/questions ["question-8d4fa4d9-0aaf-5089-9a38-77f84d423e87" "question-17f76fde-fb9f-52ba-9f93-d56954798f7f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115111 :question/problem "Given that $x=2$ is a root of $f(x)=x^3-x^2-4x+4,$ graph the curve $y=f(x).$" :question/worked-solution "We are told that $x=2$ is a root of $f(x),$ which means that $(x-2)$ is a factor of $f(x).$ So, to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by  $(x-2)\\mathbin{:}$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 2 & 1 & -1 & -4 & 4 \\\\  &  & 2 & 2 & -4 \\\\  & 1 & 1 & -2 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x-2)({x}^{2}+x-2) \\\\  & =(x-2)(x-1)(x+2),\\end{aligned}\n$$\n\nso the other two roots of $f(x)$ are $x=1$ and $x=-2.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =(0-2)(0-1)(0+2) \\\\  & =(-2)(-1)(2) \\\\  & =4.\\end{aligned}\n$$\n\nSo, we draw an inverted ${\\textsf{S}}$-shaped graph that passes through the three roots $x=-2,1,2$ and has the $y$-intercept $y=4,$ as follows:\n\n![](images/77/77ab55ab6a105fd075d27e20286312d2c32118b113c7f0517deee9dbf3a16cff.png)" :db/ensure [:question/validate]} {:db/id 17592186115289 :knowledge-point/questions ["question-60969677-514c-5daf-874b-85d15a063d5f" "question-1bca3374-bd66-579c-b0ab-3963f1fce03c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115113 :question/problem "Graph the curve corresponding to the equation $y=f(x)$ where $f(x)=\\dfrac{1}{2}(x+5)(1-x)(x+2).$" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a negative cubic because if we were to expand the parentheses, the coefficient of the $x^3$ term would be negative:\n\n$$\n\\dfrac{1}{2}({\\color{blue}{x}}+5)(1-{\\color{red}{x}})(x+2) = \\dfrac 1 2\\cdot {\\color{blue}{x}}\\cdot (-{\\color{red}{x}})\\cdot x +\\cdots = -\\dfrac 1 2 x^3+\\cdots\n$$\n\nThe equation is given in the factored form. So by the zero-product rule, we deduce that the roots are  $x=-5,$ $x=1,$ and $x=-2.$ \n\nWe now find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(0+5)(1-0)(0+2) \\\\  & =\\frac{(5)(1)(2)}{2} \\\\  & =5\\end{aligned}\n$$\n\nSo, we draw an ${\\textsf{S}}$-shaped graph that passes through the three roots $x=-5,-2,1$ and has the $y$-intercept $y=5,$ as follows:\n\n![](images/8c/8c64b2285c626881d766811353184d2ecda06b2eaf2694b7d6b51db257115db9.png)" :db/ensure [:question/validate]} {:db/id 17592186115291 :knowledge-point/questions ["question-f1e2e562-7654-5d22-adb4-85fe265b1c2b" "question-e4fd339f-d602-5df0-954c-b8f9a8d50336"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115114 :question/problem "Given that $x=-1$ is a root of $f(x)=-x^3+4x^2-x-6,$ graph the curve $y=f(x).$" :question/worked-solution "Since $x=-1$ is a root of $f(x),$ this means that $(x+1)$ is a factor of $f(x),$ and therefore, we can begin factoring $f(x)$ by dividing it by $(x+1).$ We use synthetic division, as follows:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -1 & -1 & 4 & -1 & -6 \\\\  &  & 1 & -5 & 6 \\\\  & -1 & 5 & -6 & 0\\end{aligned}\n$$\n\nSo we obtain \n\n$$\n\\begin{aligned}f(x) & =(x+1)(-{x}^{2}+5x-6) \\\\  & =-(x+1)({x}^{2}-5x+6) \\\\  & =-(x+1)(x-2)(x-3).\\end{aligned}\n$$\n\nSetting the factors equal to zero, we find that the roots of $f(x)$ are $x=-1,2,3.$\n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =-(0+1)(0-2)(0-3) \\\\  & =-(1)(-2)(-3) \\\\  & =-6.\\end{aligned}\n$$\n\nSo, we draw an ${\\textsf{S}}$-shaped graph that passes through the three roots $x=-1,2,3$ and has the $y$-intercept $y=-6,$ as follows:\n\n![](images/ac/acf7dc9cc405f9ae632df5a437d51c4175331ac59b6221ed9f0586c4c6b47446.png)" :db/ensure [:question/validate]} {:db/id "question-dae1615e-910b-570a-9c8d-abe635df0b2e" :question/id #uuid "dae1615e-910b-570a-9c8d-abe635df0b2e" :question/math-academy-id "q-28492" :question/problem "Which of the following curves is generated by $y=\\frac{1}{5}(x+1)(x+2)(x-5)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a positive cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be positive:\n\n$$\n\\frac{1}{5}(x+1)(x+2)(x-5)=\\frac{1}{5}\\cdot x\\cdot x\\cdot x+⋯=\\frac{1}{5}{x}^{3}+⋯\n$$\n\nThe equation is already in factored form. So by the zero-product rule, we deduce that the roots are $x=-1,$ $x=-2,$ and $x=5.$ \n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{5}(0+1)(0+2)(0-5) \\\\  & =\\frac{(1)(2)(-5)}{5} \\\\  & =-2.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-2,-1,5$ and has the $y$-intercept $y=-2,$ as follows:\n\n \n\n![](images/e2/e27e18b8e79c71dcc888e62c4472723b44b1b4fa0367e124313f95bc08ef70fa.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-35457a0d-0c61-5711-94e0-bb380f8efb12"] :db/ensure [:question/validate]} {:db/id "answer-field-35457a0d-0c61-5711-94e0-bb380f8efb12" :answer-field/id #uuid "35457a0d-0c61-5711-94e0-bb380f8efb12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea971ece-bb53-5131-aea0-2ba8817c511d" :answer-field/choices ["answer-88894f92-5d4b-5479-b78f-1c05f2fc170a" "answer-db59d555-bcb7-53a2-b399-e6a3acaf9d4d" "answer-11204ec8-a1ac-5e56-a7ec-6a793c6d9b64" "answer-7a3c37c0-c74e-59d8-b081-edd1a9328982" "answer-ea971ece-bb53-5131-aea0-2ba8817c511d"] :db/ensure [:answer-field/validate]} {:db/id "answer-88894f92-5d4b-5479-b78f-1c05f2fc170a" :answer/id #uuid "88894f92-5d4b-5479-b78f-1c05f2fc170a" :answer/type :answer.type/image :answer/value "images/07/078cb44dc7e14390813616440e67a23c8b77e51eab0cd58c4080f2c5d54f3e17.png" :db/ensure [:answer/validate]} {:db/id "answer-db59d555-bcb7-53a2-b399-e6a3acaf9d4d" :answer/id #uuid "db59d555-bcb7-53a2-b399-e6a3acaf9d4d" :answer/type :answer.type/image :answer/value "images/6a/6a925943c2286b3390f219e7a9fbb76ad52fa4c8bd3a1c42f374a1c270dcc6f5.png" :db/ensure [:answer/validate]} {:db/id "answer-11204ec8-a1ac-5e56-a7ec-6a793c6d9b64" :answer/id #uuid "11204ec8-a1ac-5e56-a7ec-6a793c6d9b64" :answer/type :answer.type/image :answer/value "images/8e/8e3dce54c5c4131d0bd68ed9c3481ccaa26ca93d799795941d4c6f303b0a6a8b.png" :db/ensure [:answer/validate]} {:db/id "answer-7a3c37c0-c74e-59d8-b081-edd1a9328982" :answer/id #uuid "7a3c37c0-c74e-59d8-b081-edd1a9328982" :answer/type :answer.type/image :answer/value "images/ca/caeaca305217c61f2715c8594749158b80b9e25ed0c56dfc4a7a3272f8903038.png" :db/ensure [:answer/validate]} {:db/id "answer-ea971ece-bb53-5131-aea0-2ba8817c511d" :answer/id #uuid "ea971ece-bb53-5131-aea0-2ba8817c511d" :answer/type :answer.type/image :answer/value "images/e2/e27e18b8e79c71dcc888e62c4472723b44b1b4fa0367e124313f95bc08ef70fa.png" :db/ensure [:answer/validate]} {:db/id "question-90f18038-3a01-51b3-920b-b432cec605da" :question/id #uuid "90f18038-3a01-51b3-920b-b432cec605da" :question/math-academy-id "q-28058" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=\\frac{1}{6}(x-2)(x-3)(x+4)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a positive cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be positive:\n\n$$\n\\frac{1}{6}(x-2)(x-3)(x+4)=\\frac{1}{6}\\cdot x\\cdot x\\cdot x+⋯=\\frac{1}{6}{x}^{3}+⋯\n$$\n\nThe equation is already in factored form. So by the zero-product rule, we deduce that the roots are $x=2,$ $x=3,$ and $x=-4.$ \n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{6}(0-2)(0-3)(0+4) \\\\  & =\\frac{(-2)(-3)(4)}{6} \\\\  & =4.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-4,2,3$ and has the $y$-intercept $y=4,$ as follows:\n\n![](images/1f/1f574e24288b0094defccb791407c74d9c3a5eeb1821b3bcac3bfa88153e69f5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9336d9ac-e8c3-5844-8e2b-9cb0f75979ff"] :db/ensure [:question/validate]} {:db/id "answer-field-9336d9ac-e8c3-5844-8e2b-9cb0f75979ff" :answer-field/id #uuid "9336d9ac-e8c3-5844-8e2b-9cb0f75979ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-62b295bb-30eb-5877-8cf3-0a74c87d0816" :answer-field/choices ["answer-62b295bb-30eb-5877-8cf3-0a74c87d0816" "answer-4bcef24d-7b0d-557e-8247-dc9e93e19e1a" "answer-355c354e-9879-5d04-9628-bf8c3af50406" "answer-5ba9e4d3-26b7-534b-a2df-02b961f2dcab" "answer-314a18f1-a890-5a3b-a8ed-6cf505996b0e"] :db/ensure [:answer-field/validate]} {:db/id "answer-62b295bb-30eb-5877-8cf3-0a74c87d0816" :answer/id #uuid "62b295bb-30eb-5877-8cf3-0a74c87d0816" :answer/type :answer.type/image :answer/value "images/1f/1f574e24288b0094defccb791407c74d9c3a5eeb1821b3bcac3bfa88153e69f5.png" :db/ensure [:answer/validate]} {:db/id "answer-4bcef24d-7b0d-557e-8247-dc9e93e19e1a" :answer/id #uuid "4bcef24d-7b0d-557e-8247-dc9e93e19e1a" :answer/type :answer.type/image :answer/value "images/22/22aff69e331b9a47dca901612d080e9d4ef8f83d3975276878fc0c1f0d44e220.png" :db/ensure [:answer/validate]} {:db/id "answer-355c354e-9879-5d04-9628-bf8c3af50406" :answer/id #uuid "355c354e-9879-5d04-9628-bf8c3af50406" :answer/type :answer.type/image :answer/value "images/36/360493feba08788b1fec0eaac0005d04362095a4c9dc073c1e0c6fbde19ea6b3.png" :db/ensure [:answer/validate]} {:db/id "answer-5ba9e4d3-26b7-534b-a2df-02b961f2dcab" :answer/id #uuid "5ba9e4d3-26b7-534b-a2df-02b961f2dcab" :answer/type :answer.type/image :answer/value "images/a4/a4fc0eae860df4a13f1ca1d63581c50798d48fc4911f6d65ba931b4e52e519a3.png" :db/ensure [:answer/validate]} {:db/id "answer-314a18f1-a890-5a3b-a8ed-6cf505996b0e" :answer/id #uuid "314a18f1-a890-5a3b-a8ed-6cf505996b0e" :answer/type :answer.type/image :answer/value "images/d9/d92575639887aebfc28a664242f83ed5b78f0dbef3cccaa2526bbf2bbf7f1093.png" :db/ensure [:answer/validate]} {:db/id 17592186115679 :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=\\frac{1}{2}(x-1)(x+2)(x+3)?$ \n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a positive cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be positive:\n\n$$\n\\frac{1}{2}(x-1)(x+2)(x+3)=\\frac{1}{2}\\cdot x\\cdot x\\cdot x+⋯=\\frac{1}{2}{x}^{3}+⋯\n$$\n\nThe equation is already in factored form. So by the zero-product rule, we deduce that the roots are $x=1,$ $x=-2,$ and $x=-3.$ \n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(0-1)(0+2)(0+3) \\\\  & =\\frac{(-1)(2)(3)}{2} \\\\  & =-3\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-3,-2,1$ and has the $y$-intercept $y=-3,$ as follows:\n\n \n\n![](images/8b/8bc52ee56cc821a2d498ebee872c620a61c527f0967b3cb6de985bd10ffce97a.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186113040 :answer-field/correct 17592186113044 :db/ensure [:answer-field/validate]} {:db/id "question-93eea4d8-b061-5509-a1b0-2eaeace6d46a" :question/id #uuid "93eea4d8-b061-5509-a1b0-2eaeace6d46a" :question/math-academy-id "q-28059" :question/problem "Which of the following curves is generated by $y=\\frac{1}{3}(x+1)(x-3)(x+5)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a positive cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be positive:\n\n$$\n\\frac{1}{3}(x+1)(x-3)(x+5)=\\frac{1}{3}\\cdot x\\cdot x\\cdot x+⋯=\\frac{1}{3}{x}^{3}+⋯\n$$\n\nThe equation is already in factored form. So by the zero-product rule, we deduce that the roots are $x=-1$, $x=3$ and $x=-5.$\n\nWe also find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{1}{3}(0+1)(0-3)(0+5) \\\\  & =\\frac{(1)(-3)(5)}{3} \\\\  & =-5.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-5,-1,3$ and has the $y$-intercept $y=-5,$ as follows:\n\n \n\n![](images/05/0514909ce208ebf90584d7130705b5eccc0db08596d558dd83467b7cfda925fa.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d413ff44-236b-5252-8dd6-4240371ec92d"] :db/ensure [:question/validate]} {:db/id "answer-field-d413ff44-236b-5252-8dd6-4240371ec92d" :answer-field/id #uuid "d413ff44-236b-5252-8dd6-4240371ec92d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-477b9f30-5f38-5116-9a22-73330deb5652" :answer-field/choices ["answer-477b9f30-5f38-5116-9a22-73330deb5652" "answer-642eb021-cd1a-5d4d-843e-e1a50d704511" "answer-7a82002a-f169-572c-aa0c-f1dda8a63cac" "answer-0351d442-e295-5767-b615-4ef20bb63c22" "answer-20b71412-ebeb-5e1d-859d-b822ed7d9231"] :db/ensure [:answer-field/validate]} {:db/id "answer-477b9f30-5f38-5116-9a22-73330deb5652" :answer/id #uuid "477b9f30-5f38-5116-9a22-73330deb5652" :answer/type :answer.type/image :answer/value "images/05/0514909ce208ebf90584d7130705b5eccc0db08596d558dd83467b7cfda925fa.png" :db/ensure [:answer/validate]} {:db/id "answer-642eb021-cd1a-5d4d-843e-e1a50d704511" :answer/id #uuid "642eb021-cd1a-5d4d-843e-e1a50d704511" :answer/type :answer.type/image :answer/value "images/38/38f1108c6b4e04f1d505bc8234d97bb57ccf49202769c8d9624e950fdeb2dcd4.png" :db/ensure [:answer/validate]} {:db/id "answer-7a82002a-f169-572c-aa0c-f1dda8a63cac" :answer/id #uuid "7a82002a-f169-572c-aa0c-f1dda8a63cac" :answer/type :answer.type/image :answer/value "images/49/49ce31e582c6965da24d40167bfee7890dc1b898bcf1b783b010b831287d80da.png" :db/ensure [:answer/validate]} {:db/id "answer-0351d442-e295-5767-b615-4ef20bb63c22" :answer/id #uuid "0351d442-e295-5767-b615-4ef20bb63c22" :answer/type :answer.type/image :answer/value "images/79/79855a67f1703f5982fe3406ce5db72e1a2af087d94a6e4fe34db9b8f68a85ca.png" :db/ensure [:answer/validate]} {:db/id "answer-20b71412-ebeb-5e1d-859d-b822ed7d9231" :answer/id #uuid "20b71412-ebeb-5e1d-859d-b822ed7d9231" :answer/type :answer.type/image :answer/value "images/95/954b771542e9118f8417e5b5be35803e75d788ea1433c58f6430d985af4a57fa.png" :db/ensure [:answer/validate]} {:db/id "question-8d4fa4d9-0aaf-5089-9a38-77f84d423e87" :question/id #uuid "8d4fa4d9-0aaf-5089-9a38-77f84d423e87" :question/math-academy-id "q-112005" :question/problem "Given that $(x-2)$ is a factor of $f(x)={x}^{3}-2{x}^{2}-9x+18,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we note that the function is a positive cubic curve because the coefficient of ${x}^{3}$ is positive.\n\nWe are told that $(x-2)$ is a factor of $f(x),$ so to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by  $(x-2):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 2 & 1 & -2 & -9 & 18 \\\\  &  & 2 & 0 & -18 \\\\  & 1 & 0 & -9 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x-2)({x}^{2}-9) \\\\  & =(x-2)(x-3)(x+3),\\end{aligned}\n$$\n\nso the roots of $f(x)$ are $x=-3,$ $x=2,$ and $x=3.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =(0-2)(0-3)(0+3) \\\\  & =(-2)(-3)(3) \\\\  & =18.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-3,2,3$ and has the $y$-intercept $y=18,$ as follows:\n\n![](images/06/066d0669762137e2e014c2b76c941bdf7812c2d537ae1c03e0ae89a1d7107dc3.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41892c52-a16d-5548-87d4-6b57bd72c9f7"] :db/ensure [:question/validate]} {:db/id "answer-field-41892c52-a16d-5548-87d4-6b57bd72c9f7" :answer-field/id #uuid "41892c52-a16d-5548-87d4-6b57bd72c9f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6d9b87e-ae0c-5c29-8c91-0aaa91050925" :answer-field/choices ["answer-c6d9b87e-ae0c-5c29-8c91-0aaa91050925" "answer-24c0dc1e-2f85-5424-80ef-3dcc1ab214bf" "answer-4d71d480-77ad-564e-b1d3-b96ecf559a25" "answer-8d418708-fb94-5886-83dc-9a0b98948c8a" "answer-d12b49a3-f19f-50d3-928c-2490a6f014e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6d9b87e-ae0c-5c29-8c91-0aaa91050925" :answer/id #uuid "c6d9b87e-ae0c-5c29-8c91-0aaa91050925" :answer/type :answer.type/image :answer/value "images/06/066d0669762137e2e014c2b76c941bdf7812c2d537ae1c03e0ae89a1d7107dc3.png" :db/ensure [:answer/validate]} {:db/id "answer-24c0dc1e-2f85-5424-80ef-3dcc1ab214bf" :answer/id #uuid "24c0dc1e-2f85-5424-80ef-3dcc1ab214bf" :answer/type :answer.type/image :answer/value "images/40/40ab547f0afaa790fa659e6f4bdfdfae56b68c9b785047df165196cd483d3a52.png" :db/ensure [:answer/validate]} {:db/id "answer-4d71d480-77ad-564e-b1d3-b96ecf559a25" :answer/id #uuid "4d71d480-77ad-564e-b1d3-b96ecf559a25" :answer/type :answer.type/image :answer/value "images/af/af6d7de4eb00b6ad6c071a9047ac5e9a66490ade06781a6d4cba590b2d1737f7.png" :db/ensure [:answer/validate]} {:db/id "answer-8d418708-fb94-5886-83dc-9a0b98948c8a" :answer/id #uuid "8d418708-fb94-5886-83dc-9a0b98948c8a" :answer/type :answer.type/image :answer/value "images/b0/b040d194ecd2e1689402c529eb251cea42dd01dfa8126f0a5117423c72878621.png" :db/ensure [:answer/validate]} {:db/id "answer-d12b49a3-f19f-50d3-928c-2490a6f014e7" :answer/id #uuid "d12b49a3-f19f-50d3-928c-2490a6f014e7" :answer/type :answer.type/image :answer/value "images/dc/dc808580cd0a7dfee4d03a2357d278076650da7acdbe0b963c944ec1338ca66c.png" :db/ensure [:answer/validate]} {:db/id "question-17f76fde-fb9f-52ba-9f93-d56954798f7f" :question/id #uuid "17f76fde-fb9f-52ba-9f93-d56954798f7f" :question/math-academy-id "q-73907" :question/problem "Given that $(x+1)$ is a factor of $f(x)={x}^{3}+3{x}^{2}-x-3$, which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we note that the function is a positive cubic curve because the coefficient of ${x}^{3}$ is positive.\n\nWe are told that $(x+1)$ is a factor of $f(x),$ so to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by  $(x+1):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -1 & 1 & 3 & -1 & -3 \\\\  &  & -1 & -2 & 3 \\\\  & 1 & 2 & -3 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x+1)({x}^{2}+2x-3) \\\\  & =(x+1)(x-1)(x+3).\\end{aligned}\n$$\n\nso the roots of $f(x)$ are $x=-1,$ $x=1,$ and $x=-3.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =(0+1)(0-1)(0+3) \\\\  & =(1)(-1)(3) \\\\  & =-3.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-3,-1,1$ and has the $y$-intercept $y=-3,$ as follows:\n\n![](images/40/40b0fc54d72820b2893dba5160b4e5f1c70bf7b63aebd63eb3d5ea0ad078dcef.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f36e70e9-2a1f-5781-8df0-6ffb61fd4403"] :db/ensure [:question/validate]} {:db/id "answer-field-f36e70e9-2a1f-5781-8df0-6ffb61fd4403" :answer-field/id #uuid "f36e70e9-2a1f-5781-8df0-6ffb61fd4403" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bff52a36-ae0d-513f-bea3-ebe09da40039" :answer-field/choices ["answer-bf1cfb03-667f-5afb-9c47-360e2bed892f" "answer-bff52a36-ae0d-513f-bea3-ebe09da40039" "answer-9d508d81-98c0-536f-89eb-9ec315f7b71e" "answer-6f473e41-b55f-50e2-81be-a6ebc3c9f999" "answer-d53366b5-6acf-5a37-96bf-fb9f8a1a7546"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf1cfb03-667f-5afb-9c47-360e2bed892f" :answer/id #uuid "bf1cfb03-667f-5afb-9c47-360e2bed892f" :answer/type :answer.type/image :answer/value "images/39/39b3430d7a1d465b2f9e5c39d0106c60ad8b333919c24bb5bbb318866ba07408.png" :db/ensure [:answer/validate]} {:db/id "answer-bff52a36-ae0d-513f-bea3-ebe09da40039" :answer/id #uuid "bff52a36-ae0d-513f-bea3-ebe09da40039" :answer/type :answer.type/image :answer/value "images/40/40b0fc54d72820b2893dba5160b4e5f1c70bf7b63aebd63eb3d5ea0ad078dcef.png" :db/ensure [:answer/validate]} {:db/id "answer-9d508d81-98c0-536f-89eb-9ec315f7b71e" :answer/id #uuid "9d508d81-98c0-536f-89eb-9ec315f7b71e" :answer/type :answer.type/image :answer/value "images/a3/a3215ae0019c93a9e189bb2ff3d1019c3d8ab803b0a754b741671da06474e6e4.png" :db/ensure [:answer/validate]} {:db/id "answer-6f473e41-b55f-50e2-81be-a6ebc3c9f999" :answer/id #uuid "6f473e41-b55f-50e2-81be-a6ebc3c9f999" :answer/type :answer.type/image :answer/value "images/be/be78ab23063af0f890931c2f40b920495012a8234571e5858a571710a1a91b98.png" :db/ensure [:answer/validate]} {:db/id "answer-d53366b5-6acf-5a37-96bf-fb9f8a1a7546" :answer/id #uuid "d53366b5-6acf-5a37-96bf-fb9f8a1a7546" :answer/type :answer.type/image :answer/value "images/e6/e64162a9f7c30293c23a08bcbfbddabe3d3da54a98e98181c62abe372448e700.png" :db/ensure [:answer/validate]} {:db/id "question-60969677-514c-5daf-874b-85d15a063d5f" :question/id #uuid "60969677-514c-5daf-874b-85d15a063d5f" :question/math-academy-id "q-112010" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=(x+4)(x+2)(2-x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a negative cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be negative:\n\n$$\n(x+4)(x+2)(2-x)=x\\cdot x\\cdot (-x)+⋯=-{x}^{3}+⋯\n$$\n\nThe equation is given in the factored form. So by the zero-product rule, we deduce that the roots are  $x=-4,$ $x=-2,$ and $x=2.$ \n\nWe now find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =(0+4)(0+2)(2-0) \\\\  & =(4)(2)(2) \\\\  & =16\\end{aligned}\n$$\n\nSo, we draw an $\\text{S}$-shaped graph that passes through the three roots $x=-4,-2,2$ and has the $y$-intercept $y=16,$ as follows:\n\n![](images/06/06e69e393a48794262d45233bdd0df8f69f2b9ab8a3e9acee5aed3280db9f503.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cd7c1bc3-c7e4-5e0a-971c-0dbc11e064c1"] :db/ensure [:question/validate]} {:db/id "answer-field-cd7c1bc3-c7e4-5e0a-971c-0dbc11e064c1" :answer-field/id #uuid "cd7c1bc3-c7e4-5e0a-971c-0dbc11e064c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0634f6ca-c685-51dd-9320-d4639074b25b" :answer-field/choices ["answer-0634f6ca-c685-51dd-9320-d4639074b25b" "answer-d67c0327-7eba-58f1-a5d7-dd85c3ed0c30" "answer-4f8511bf-77e3-5154-87db-8a803f247e03" "answer-ff6821e9-999b-5770-954a-4adce57b70ca" "answer-6b377b9a-6945-5b63-b4e3-ee2b2f7a2965"] :db/ensure [:answer-field/validate]} {:db/id "answer-0634f6ca-c685-51dd-9320-d4639074b25b" :answer/id #uuid "0634f6ca-c685-51dd-9320-d4639074b25b" :answer/type :answer.type/image :answer/value "images/06/06e69e393a48794262d45233bdd0df8f69f2b9ab8a3e9acee5aed3280db9f503.png" :db/ensure [:answer/validate]} {:db/id "answer-d67c0327-7eba-58f1-a5d7-dd85c3ed0c30" :answer/id #uuid "d67c0327-7eba-58f1-a5d7-dd85c3ed0c30" :answer/type :answer.type/image :answer/value "images/48/48af95d7988c25c5513a60a3962d57ed9a9ee98a966316cb1def1cece96be0d7.png" :db/ensure [:answer/validate]} {:db/id "answer-4f8511bf-77e3-5154-87db-8a803f247e03" :answer/id #uuid "4f8511bf-77e3-5154-87db-8a803f247e03" :answer/type :answer.type/image :answer/value "images/86/86e4193b55ecabe36aba0dff3624e19a2b89961844a5645817dbfa563129baa7.png" :db/ensure [:answer/validate]} {:db/id "answer-ff6821e9-999b-5770-954a-4adce57b70ca" :answer/id #uuid "ff6821e9-999b-5770-954a-4adce57b70ca" :answer/type :answer.type/image :answer/value "images/87/8781ae0ba7463d56326eb9144c9013ad8811aaea05430295dd7687a454df8ab3.png" :db/ensure [:answer/validate]} {:db/id "answer-6b377b9a-6945-5b63-b4e3-ee2b2f7a2965" :answer/id #uuid "6b377b9a-6945-5b63-b4e3-ee2b2f7a2965" :answer/type :answer.type/image :answer/value "images/d4/d4733614738a1c241498c092812616e128de5ab4f0e5dd7bd562c219819c14f0.png" :db/ensure [:answer/validate]} {:db/id "question-1bca3374-bd66-579c-b0ab-3963f1fce03c" :question/id #uuid "1bca3374-bd66-579c-b0ab-3963f1fce03c" :question/math-academy-id "q-28501" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=-\\frac{1}{6}(x+3)(x-2)(x-3)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a negative cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be negative:\n\n$$\n-\\frac{1}{6}(x+3)(x-2)(x-3)=-\\frac{1}{6}\\cdot x\\cdot x\\cdot x+⋯=-\\frac{1}{6}{x}^{3}+⋯\n$$\n\nThe equation is given in the factored form. So by the zero-product rule, we deduce that the roots are  $x=-3,$ $x=2,$ and $x=3.$ \n\nWe now find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{6}(0+3)(0-2)(0-3) \\\\  & =-\\frac{(3)(-2)(-3)}{6} \\\\  & =-3.\\end{aligned}\n$$\n\nSo, we draw an $\\text{S}$-shaped graph that passes through the three roots $x=-3,2,3$ and has the $y$-intercept $y=-3,$ as follows:\n\n![](images/28/2852cbbe5f7e3e9dfb02968b92d2d3f1eca405b972dc716167375979958645e4.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-76de3f59-19a0-578d-bd08-9da8e8b2dd4d"] :db/ensure [:question/validate]} {:db/id "answer-field-76de3f59-19a0-578d-bd08-9da8e8b2dd4d" :answer-field/id #uuid "76de3f59-19a0-578d-bd08-9da8e8b2dd4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25a5e0b4-78f0-519c-aaa8-487ec25837a1" :answer-field/choices ["answer-1a93e68d-5525-5c5c-a5c0-40a3006df82b" "answer-e47e4051-8811-5cb7-9dc4-b1517ded5708" "answer-25a5e0b4-78f0-519c-aaa8-487ec25837a1" "answer-9ea388b8-b1ee-5301-9987-ad4ecee46eda" "answer-4c5cec13-7b2b-54b0-acd9-66e2a154b5da"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a93e68d-5525-5c5c-a5c0-40a3006df82b" :answer/id #uuid "1a93e68d-5525-5c5c-a5c0-40a3006df82b" :answer/type :answer.type/image :answer/value "images/10/10ac49b1571ab0c058ae72991382cf90710b8bc4e7f973b6152d7176df4841f7.png" :db/ensure [:answer/validate]} {:db/id "answer-e47e4051-8811-5cb7-9dc4-b1517ded5708" :answer/id #uuid "e47e4051-8811-5cb7-9dc4-b1517ded5708" :answer/type :answer.type/image :answer/value "images/21/210fa8caf7365154cb85e3f9d23d400a0e69c34920ffc49129abdf4e79b86c27.png" :db/ensure [:answer/validate]} {:db/id "answer-25a5e0b4-78f0-519c-aaa8-487ec25837a1" :answer/id #uuid "25a5e0b4-78f0-519c-aaa8-487ec25837a1" :answer/type :answer.type/image :answer/value "images/28/2852cbbe5f7e3e9dfb02968b92d2d3f1eca405b972dc716167375979958645e4.png" :db/ensure [:answer/validate]} {:db/id "answer-9ea388b8-b1ee-5301-9987-ad4ecee46eda" :answer/id #uuid "9ea388b8-b1ee-5301-9987-ad4ecee46eda" :answer/type :answer.type/image :answer/value "images/2c/2c5a0229cafec77667adf228886198d6f551704fd6bb6a67beb4f702bca924b0.png" :db/ensure [:answer/validate]} {:db/id "answer-4c5cec13-7b2b-54b0-acd9-66e2a154b5da" :answer/id #uuid "4c5cec13-7b2b-54b0-acd9-66e2a154b5da" :answer/type :answer.type/image :answer/value "images/48/48a836ec46ede6f53d6a608239edb89aa33d083d265dada32ff887871ff98f1e.png" :db/ensure [:answer/validate]} {:db/id "question-f1e2e562-7654-5d22-adb4-85fe265b1c2b" :question/id #uuid "f1e2e562-7654-5d22-adb4-85fe265b1c2b" :question/math-academy-id "q-112024" :question/problem "Given that $(x+2)$ is a factor of $f(x)=-{x}^{3}+5{x}^{2}+2x-24,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we notice that the function is a negative cubic curve because the coefficient of ${x}^{3}$ is negative.\n\nWe are told that $(x+2)$ is a factor of $f(x),$ so to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by  $(x+2):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -2 & -1 & 5 & 2 & -24 \\\\  &  & 2 & -14 & 24 \\\\  & -1 & 7 & -12 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x+2)(-{x}^{2}+7x-12) \\\\  & =-(x+2)({x}^{2}-7x+12) \\\\  & =-(x+2)(x-3)(x-4).\\end{aligned}\n$$\n\nSetting the factors equal to zero, we find that the roots of $f(x)$ are $x=-2,$ $x=3,$ and $x=4.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =-(0+2)(0-3)(0-4) \\\\  & =-(2)(-3)(-4) \\\\  & =-24.\\end{aligned}\n$$\n\nSo, we draw an  $\\text{S}$-shaped graph that passes through the three roots $x=-2,3,4$ and has the $y$-intercept $y=-24,$ as follows:\n\n![](images/e4/e41620d89bb720602c0271428847e05a6655b8ff1e037c0b408972ceaf252cec.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ed008ef5-e047-5355-bc29-75fe453b742b"] :db/ensure [:question/validate]} {:db/id "answer-field-ed008ef5-e047-5355-bc29-75fe453b742b" :answer-field/id #uuid "ed008ef5-e047-5355-bc29-75fe453b742b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-64595169-25de-552b-b205-b88be4528817" :answer-field/choices ["answer-50b3e54f-5a19-5942-97c8-1a0fef6ae694" "answer-b6dabf32-5011-5a39-8497-86b98fa63381" "answer-39ff338d-9db1-5cd4-b152-119d52099aee" "answer-734d4893-fde1-5b0c-b618-e1be6f8a10b0" "answer-64595169-25de-552b-b205-b88be4528817"] :db/ensure [:answer-field/validate]} {:db/id "answer-50b3e54f-5a19-5942-97c8-1a0fef6ae694" :answer/id #uuid "50b3e54f-5a19-5942-97c8-1a0fef6ae694" :answer/type :answer.type/image :answer/value "images/27/2777c31a4504d09e65dd8a9248d8e474146fb50af9723557795105bb4de186be.png" :db/ensure [:answer/validate]} {:db/id "answer-b6dabf32-5011-5a39-8497-86b98fa63381" :answer/id #uuid "b6dabf32-5011-5a39-8497-86b98fa63381" :answer/type :answer.type/image :answer/value "images/5e/5e9bdc79fdd7462a38ba8ffeceef400b8ead638de44d622dc85324ac8cd9c4c9.png" :db/ensure [:answer/validate]} {:db/id "answer-39ff338d-9db1-5cd4-b152-119d52099aee" :answer/id #uuid "39ff338d-9db1-5cd4-b152-119d52099aee" :answer/type :answer.type/image :answer/value "images/ab/ab99fa53c745af397e67db63b3d6aa892b66b13cd31dcf19503a01e2a8c2fc91.png" :db/ensure [:answer/validate]} {:db/id "answer-734d4893-fde1-5b0c-b618-e1be6f8a10b0" :answer/id #uuid "734d4893-fde1-5b0c-b618-e1be6f8a10b0" :answer/type :answer.type/image :answer/value "images/ac/ac4b0b9c322516609db9bf212eece54f7c2252fbf195c803b827480b0e083c68.png" :db/ensure [:answer/validate]} {:db/id "answer-64595169-25de-552b-b205-b88be4528817" :answer/id #uuid "64595169-25de-552b-b205-b88be4528817" :answer/type :answer.type/image :answer/value "images/e4/e41620d89bb720602c0271428847e05a6655b8ff1e037c0b408972ceaf252cec.png" :db/ensure [:answer/validate]} {:db/id "question-e4fd339f-d602-5df0-954c-b8f9a8d50336" :question/id #uuid "e4fd339f-d602-5df0-954c-b8f9a8d50336" :question/math-academy-id "q-27983" :question/problem "Given that $(x+1)$ is a factor of $f(x)=-{x}^{3}+7x+6,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we notice that the function is a negative cubic curve because the coefficient of ${x}^{3}$ is negative.\n\nWe are told that $(x+1)$ is a factor of $f(x),$ so to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by $(x+1):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -1 & -1 & 0 & 7 & 6 \\\\  &  & 1 & -1 & -6 \\\\  & -1 & 1 & 6 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x+1)(-{x}^{2}+x+6) \\\\  & =-(x+1)({x}^{2}-x-6) \\\\  & =-(x+1)(x+2)(x-3).\\end{aligned}\n$$\n\nSetting the factors equal to zero, we find that the roots of $f(x)$ are $x=-1,x=-2,$ and $x=3.$\n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =-(0+1)(0+2)(0-3) \\\\  & =-(1)(2)(-3) \\\\  & =6.\\end{aligned}\n$$\n\nSo, we draw an $S$-shaped graph that passes through the three roots $x=-2,-1,3$ and has the $y$-intercept $y=6,$ as follows:\n\n![](images/d8/d8bd6f9c8cbfd1872871a00d403e3e8980c081b03caac5f2c5cc656161a00cd5.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-110bf320-e38a-558c-a223-21f04cb27190"] :db/ensure [:question/validate]} {:db/id "answer-field-110bf320-e38a-558c-a223-21f04cb27190" :answer-field/id #uuid "110bf320-e38a-558c-a223-21f04cb27190" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c326836-cea1-569c-bfc7-a225df73e1de" :answer-field/choices ["answer-89b35751-ed9a-5685-a2ce-b98451f0d447" "answer-e5836ce4-600f-562b-abfb-fcdaead9a3f1" "answer-8fc388bc-6015-5f15-8fe6-e538d635b4f5" "answer-5c326836-cea1-569c-bfc7-a225df73e1de" "answer-00c7a8ec-6d84-537d-83ed-4ac922c27e5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-89b35751-ed9a-5685-a2ce-b98451f0d447" :answer/id #uuid "89b35751-ed9a-5685-a2ce-b98451f0d447" :answer/type :answer.type/image :answer/value "images/15/158da0fb2d74d02a63a6871a3b2e4737f1f73971ad8484e7e0dbd44b129c79eb.png" :db/ensure [:answer/validate]} {:db/id "answer-e5836ce4-600f-562b-abfb-fcdaead9a3f1" :answer/id #uuid "e5836ce4-600f-562b-abfb-fcdaead9a3f1" :answer/type :answer.type/image :answer/value "images/2d/2d3dcdc478bb34ef381154dffe90815dc512f30c75e615a13a31affeaeb0172e.png" :db/ensure [:answer/validate]} {:db/id "answer-8fc388bc-6015-5f15-8fe6-e538d635b4f5" :answer/id #uuid "8fc388bc-6015-5f15-8fe6-e538d635b4f5" :answer/type :answer.type/image :answer/value "images/79/791e8ed21436227851d591e51b9a917a088de2b18e3e872a168f978b9309fbf0.png" :db/ensure [:answer/validate]} {:db/id "answer-5c326836-cea1-569c-bfc7-a225df73e1de" :answer/id #uuid "5c326836-cea1-569c-bfc7-a225df73e1de" :answer/type :answer.type/image :answer/value "images/d8/d8bd6f9c8cbfd1872871a00d403e3e8980c081b03caac5f2c5cc656161a00cd5.png" :db/ensure [:answer/validate]} {:db/id "answer-00c7a8ec-6d84-537d-83ed-4ac922c27e5d" :answer/id #uuid "00c7a8ec-6d84-537d-83ed-4ac922c27e5d" :answer/type :answer.type/image :answer/value "images/f0/f0df952100b03d5714087a60a063abf1a65f4129d7e32e730b82f45e4c57e862.png" :db/ensure [:answer/validate]} {:db/id 17592186116519 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a >0$) has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots.\n\nFor instance, suppose that we want to plot the graph of $y = x^3-x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}{x}^{3}-x & =0 \\\\ x({x}^{2}-1) & =0 \\\\ x(x-1)(x+1) & =0\\end{aligned}\n$$\n\nBy the zero-product rule, we get three distinct roots $x=0, -1, 1.$ \n\nSo, we draw an inverted ${\\textsf{S}}$-shaped graph that passes through these three roots, as follows:\n\n![](images/ec/ec5e7195e9584059755c8462de65ddd9bba038f38b18d5fe301dc392e1cdc9b9.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186116520 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a <0$)  has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots. \n\nFor instance, suppose that we want to plot the graph of $y = -x^3+4x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}-{x}^{3}+4x & =0 \\\\ -x({x}^{2}-4) & =0 \\\\ -x(x-2)(x+2) & =0\\end{aligned}\n$$\n\nSo by the zero-product rule, we get three distinct roots $x=0, -2, 2.$ \n\nSo, we draw an ${\\textsf{S}}$-shape that passes through these three roots, as follows:\n\n![](images/7f/7ff179ef8c305c460c8a2dca0d7792c2297677bd07b737645130faf95497fa71.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186115447 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186133791 :knowledge-point/questions ["question-3561f664-6b98-59a1-983b-c026ed37b09d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3561f664-6b98-59a1-983b-c026ed37b09d" :question/id #uuid "3561f664-6b98-59a1-983b-c026ed37b09d" :question/math-academy-id "q-95340" :question/problem "$$\nA=[\\begin{aligned}\\frac{4}{3} & \\frac{2}{3} \\\\ \\frac{2}{3} & \\frac{1}{3}\\end{aligned}]\n$$\n\nConsider the matrix $A$ given above. Which of the following statements are true?\n\nI. ${A}^{T}=A$\n\nII. ${A}^{2}=A$\n\nIII. $A$ is an orthogonal projection matrix" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. Indeed, ${A}^{T}=A.$\n\n- Statement II is false. Indeed, \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}\\frac{4}{3} & \\frac{2}{3} \\\\ \\frac{2}{3} & \\frac{1}{3}\\end{aligned}][\\begin{aligned}\\frac{4}{3} & \\frac{2}{3} \\\\ \\frac{2}{3} & \\frac{1}{3}\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}20 & 10 \\\\ 10 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{20}{9} & \\frac{10}{9} \\\\ \\frac{10}{9} & \\frac{5}{9}\\end{aligned}] \\\\  & \\ne A.\\end{aligned}\n$$\n\n- Statement III is false since not both statements I and II are true.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f95e685a-8719-5a28-8f48-34b22e58d837"] :db/ensure [:question/validate]} {:db/id "answer-field-f95e685a-8719-5a28-8f48-34b22e58d837" :answer-field/id #uuid "f95e685a-8719-5a28-8f48-34b22e58d837" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8dbf19db-8c12-56d5-93cb-c6a8e4c35f89" :answer-field/choices ["answer-26616721-c1c2-5d9f-b10a-79047fee470c" "answer-8dbf19db-8c12-56d5-93cb-c6a8e4c35f89" "answer-ac5c093f-adcb-5278-a948-2600588e194d" "answer-95678053-edd8-5ce0-accb-5d3d57aea431" "answer-5645af54-a6c4-584e-8e27-fcde9bec94bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-26616721-c1c2-5d9f-b10a-79047fee470c" :answer/id #uuid "26616721-c1c2-5d9f-b10a-79047fee470c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-8dbf19db-8c12-56d5-93cb-c6a8e4c35f89" :answer/id #uuid "8dbf19db-8c12-56d5-93cb-c6a8e4c35f89" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ac5c093f-adcb-5278-a948-2600588e194d" :answer/id #uuid "ac5c093f-adcb-5278-a948-2600588e194d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-95678053-edd8-5ce0-accb-5d3d57aea431" :answer/id #uuid "95678053-edd8-5ce0-accb-5d3d57aea431" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5645af54-a6c4-584e-8e27-fcde9bec94bc" :answer/id #uuid "5645af54-a6c4-584e-8e27-fcde9bec94bc" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186133792 :knowledge-point/questions ["question-555dd099-33d6-5089-b5ce-f831f111dabe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-555dd099-33d6-5089-b5ce-f831f111dabe" :question/id #uuid "555dd099-33d6-5089-b5ce-f831f111dabe" :question/math-academy-id "q-95363" :question/problem "$$\na=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}],\\,P=\\frac{1}{6}[\\begin{aligned}{p}_{11} & {p}_{12} & {p}_{13} \\\\ {p}_{21} & {p}_{22} & {p}_{23} \\\\ {p}_{31} & {p}_{32} & {p}_{33}\\end{aligned}]\n$$\n\nGiven that the vector $a$ above spans ${S}^{⊥},$ and that $P$ is the orthogonal projection matrix of ${R}^{3}$ onto the subspace $S$, what is the value of ${p}_{12}+{p}_{33}?$" :question/worked-solution "First, we find the orthogonal projection matrix onto ${S}^{⊥}=\\text{Span}\\{a\\}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\n{P}_{{S}^{⊥}}=a({a}^{T}\\,a)^{-1}{a}^{T},\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]{([\\begin{aligned}1 & -1 & 2\\end{aligned}][\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}])}^{-1}[\\begin{aligned}1 & -1 & 2\\end{aligned}] \\\\  & ={6}^{-1}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}][\\begin{aligned}1 & -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 2 & -2 & 4\\end{aligned}]\\end{aligned}\n$$\n\nRecall that ${P}_{S}+{P}_{{S}^{⊥}}=I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]-\\frac{1}{6}[\\begin{aligned}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 2 & -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}5 & 1 & -2 \\\\ 1 & 5 & 2 \\\\ -2 & 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, ${p}_{12}+{p}_{33}=1+2=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d228661a-466c-50ca-9003-6059a883594a"] :db/ensure [:question/validate]} {:db/id "answer-field-d228661a-466c-50ca-9003-6059a883594a" :answer-field/id #uuid "d228661a-466c-50ca-9003-6059a883594a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58d46ea7-049e-5a25-a6c2-5ad53ae4d659" :answer-field/choices ["answer-d7117175-fba5-5e21-8e5f-4b0885591d4c" "answer-fd679fa5-f8b4-58d0-86cf-0a7829e9b639" "answer-58d46ea7-049e-5a25-a6c2-5ad53ae4d659" "answer-a99fb21f-5f60-57d9-893f-48f42ff18616" "answer-0e6be835-40ec-54ab-80f9-e88f6e1c2e5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7117175-fba5-5e21-8e5f-4b0885591d4c" :answer/id #uuid "d7117175-fba5-5e21-8e5f-4b0885591d4c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-fd679fa5-f8b4-58d0-86cf-0a7829e9b639" :answer/id #uuid "fd679fa5-f8b4-58d0-86cf-0a7829e9b639" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-58d46ea7-049e-5a25-a6c2-5ad53ae4d659" :answer/id #uuid "58d46ea7-049e-5a25-a6c2-5ad53ae4d659" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a99fb21f-5f60-57d9-893f-48f42ff18616" :answer/id #uuid "a99fb21f-5f60-57d9-893f-48f42ff18616" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0e6be835-40ec-54ab-80f9-e88f6e1c2e5b" :answer/id #uuid "0e6be835-40ec-54ab-80f9-e88f6e1c2e5b" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "activity-bdd7478d-9d30-52dc-9898-5d306ae615e9" :activity/id #uuid "bdd7478d-9d30-52dc-9898-5d306ae615e9" :activity/title "Projection Matrices, Linear Transformations and Their Properties" :activity/type :activity.type/review :activity/scope 17592186049489 :activity/course 17592186046669 :activity/steps ["step-a8ac4121-8588-5593-84d3-dac