d189-cf7d-5f99-8f8f-388141bfd59a" :answer/type :answer.type/math :answer/value "{x}^{6}y" :db/ensure [:answer/validate]} {:db/id "answer-50b57b47-dd06-59e4-862a-1653f1f39acf" :answer/id #uuid "50b57b47-dd06-59e4-862a-1653f1f39acf" :answer/type :answer.type/math :answer/value "{x}^{6}{y}^{-3}" :db/ensure [:answer/validate]} {:db/id "question-88e971de-92ab-5f11-8659-2661a18f45d8" :question/id #uuid "88e971de-92ab-5f11-8659-2661a18f45d8" :question/math-academy-id "q-72561" :question/problem "Which of the following is equivalent to ${(2{s}^{-1}{t}^{2})}^{4}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{s}^{-1}{t}^{2})}^{4} & = \\\\ {2}^{4}\\cdot {({s}^{-1})}^{4}\\cdot {({t}^{2})}^{4} & = \\\\ {2}^{4}\\cdot {s}^{-1\\cdot 4}\\cdot {t}^{2\\cdot 4} & = \\\\ 16{s}^{-4}{t}^{8} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-44861fea-3410-5450-86b8-07e1b724a388"] :db/ensure [:question/validate]} {:db/id "answer-field-44861fea-3410-5450-86b8-07e1b724a388" :answer-field/id #uuid "44861fea-3410-5450-86b8-07e1b724a388" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b27dfddf-37bd-561f-8a81-94cb1772fc8d" :answer-field/choices ["answer-6ea2d663-45f2-5abe-b547-69845ba53fa7" "answer-b27dfddf-37bd-561f-8a81-94cb1772fc8d" "answer-07df4f6b-9049-50d7-8512-583bba676f26" "answer-456bb3da-ad27-5108-aeb8-1382f2461e8e" "answer-9a6cb21d-a49b-5e2a-8746-b06ae9edbf59"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ea2d663-45f2-5abe-b547-69845ba53fa7" :answer/id #uuid "6ea2d663-45f2-5abe-b547-69845ba53fa7" :answer/type :answer.type/math :answer/value "16{s}^{-1}{t}^{8}" :db/ensure [:answer/validate]} {:db/id "answer-b27dfddf-37bd-561f-8a81-94cb1772fc8d" :answer/id #uuid "b27dfddf-37bd-561f-8a81-94cb1772fc8d" :answer/type :answer.type/math :answer/value "16{s}^{-4}{t}^{8}" :db/ensure [:answer/validate]} {:db/id "a