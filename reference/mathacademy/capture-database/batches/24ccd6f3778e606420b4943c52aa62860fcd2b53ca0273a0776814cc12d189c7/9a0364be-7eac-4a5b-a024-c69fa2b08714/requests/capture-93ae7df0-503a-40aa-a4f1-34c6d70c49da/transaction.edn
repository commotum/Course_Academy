493-0f5f-5868-922d-213ef6fbf52a" :question/math-academy-id "q-98313" :question/problem "Which of the following curves is *not* simple?" :question/worked-solution "A simple curve is a curve that doesn’t intersect itself anywhere between its endpoints.\n\nSo, a curve that intersects itself somewhere between its endpoints is not a simple curve. Among the given options, the only that is not a simple curve is the following:\n\n \n\n![](images/34/3441f522bfad1f9495f5dd94dab875d24b1916d0f2aaae9920995e8721e8b6c4.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7e36c233-9c45-5907-9140-f246e57dce94"] :db/ensure [:question/validate]} {:db/id "answer-field-7e36c233-9c45-5907-9140-f246e57dce94" :answer-field/id #uuid "7e36c233-9c45-5907-9140-f246e57dce94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4dfaea2e-3b1e-5c70-9b05-f47aed2b488c" :answer-field/choices ["answer-d905c697-b80e-512f-b5f9-b21675219bba" "answer-222431f8-e36d-5c4f-a51b-f68979a6a42f" "answer-4dfaea2e-3b1e-5c70-9b05-f47aed2b488c" "answer-7036cfcd-aab3-59c7-beb1-77b251a51d85" "answer-d293a4ff-5fd3-5f92-a7d6-13a78ea172e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-d905c697-b80e-512f-b5f9-b21675219bba" :answer/id #uuid "d905c697-b80e-512f-b5f9-b21675219bba" :answer/type :answer.type/image :answer/value "images/16/164613d41e3be09a8813adf84aae2c6bddaaaee28140ca894e8957a2d98c8cb0.png" :db/ensure [:answer/validate]} {:db/id "answer-222431f8-e36d-5c4f-a51b-f68979a6a42f" :answer/id #uuid "222431f8-e36d-5c4f-a51b-f68979a6a42f" :answer/type :answer.type/image :answer/value "images/18/1844d1f0761355482ce0939fb31d29990a29b0454f910e7958e9d6bd532655b3.png" :db/ensure [:answer/validate]} {:db/id "answer-4dfaea2e-3b1e-5c70-9b05-f47aed2b488c" :answer/id #uuid "4dfaea2e-3b1e-5c70-9b05-f47aed2b488c" :answer/type :answer.type/image :answer/value "images/34/3441f522bfad1f9495f5dd94dab875d24b1916d0f2aaae9920995e8721e8b6c4.png