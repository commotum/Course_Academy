-5686-8618-b1774a4c8c2c" :db/ensure [:step/validate]} {:db/id "step-cea5206e-4f27-5686-8618-b1774a4c8c2c" :step/id #uuid "cea5206e-4f27-5686-8618-b1774a4c8c2c" :step/content "question-14c37ea2-4835-508a-983a-3cccd74633e3" :step/next "step-bd3c0d1f-b492-59bf-b2f5-09655d2c295a" :db/ensure [:step/validate]} {:db/id "step-bd3c0d1f-b492-59bf-b2f5-09655d2c295a" :step/id #uuid "bd3c0d1f-b492-59bf-b2f5-09655d2c295a" :step/content 17592186348202 :db/ensure [:step/validate]} {:db/id 17592186184225 :knowledge-point/questions ["question-3146291f-928e-5260-bc40-131359b787ef" "question-7a5ad26b-eab5-5fd9-938d-c3f9865b2926"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184131 :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{5{w}^{3}}\\cdot \\sqrt{uv} & = \\\\ \\sqrt{5{w}^{3}\\cdot uv} & = \\\\ \\sqrt{5uv{w}^{3}} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186184320 :knowledge-point/questions ["question-d17d0de9-c925-52f5-bd49-81ba61ecf89c" "question-b57aff47-fce6-506a-bd4c-d85de1a296a5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186183935 :question/problem "Simplify $\\sqrt{x} \\cdot \\sqrt{x^3}.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\eqalign{\n\t\t\\sqrt{x} \\cdot \\sqrt{x^3} &= \\\n\t\t\\sqrt{x \\cdot x^3} &= \\\n\t\t\\sqrt{x^4} &= \\\n\t\t|x^2|\n\t}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}|{x}^{2}| & ={x}^{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186184321 :knowledge-point/questions ["question-750745d7-1de9-5ab2-9a88-105542b1b50e" "question-b49efc81-0ddf-5a4e-8d55-47ad95f0b7d1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186183936 :question/problem "Simplify $\\sqrt[3]{16x^2}\\cdot \\sqrt[3]{4x}.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt[3]{16{x}^{2}}\\cdot \\sqrt[3]{4x} & = \\\\ \\sqrt[3]{16{x}^{2}\\cdot 4x} & = \\\\ \\sqrt[3]{64{x}^{3}} & = \\\\ \\sqrt[3]{(4x)^{3}} & = \\\\ 4x & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-3146291f-928e-5260-bc40-131359b787ef" :question/id #uuid "3146291f-928e-5260-bc40-131359b787ef" :question/math-academy-id "q-141493" :question/problem "The expression $\\sqrt{14u}\\cdot \\sqrt{v}$ is equivalent to" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{14u}\\cdot \\sqrt{v} & = \\\\ \\sqrt{14u\\cdot v} & = \\\\ \\sqrt{14uv}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-57fdcfe6-6d56-5f51-bb7b-b1eef860472e"] :db/ensure [:question/validate]} {:db/id "answer-field-57fdcfe6-6d56-5f51-bb7b-b1eef860472e" :answer-field/id #uuid "57fdcfe6-6d56-5f51-bb7b-b1eef860472e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e61a8f64-3597-5f56-9cf2-f1c26072d67c" :answer-field/choices ["answer-03aa9e77-c1bd-5499-b44b-44dc50ce6ae6" "answer-08f49d0c-f8bf-5cbd-b4c6-6dfe0604684e" "answer-5ab73013-fe3d-5603-853c-82b4701416c6" "answer-2cbb732d-82d4-547c-80a8-7d83e3b744d5" "answer-e61a8f64-3597-5f56-9cf2-f1c26072d67c"] :db/ensure [:answer-field/validate]} {:db/id "answer-03aa9e77-c1bd-5499-b44b-44dc50ce6ae6" :answer/id #uuid "03aa9e77-c1bd-5499-b44b-44dc50ce6ae6" :answer/type :answer.type/math :answer/value "14\\sqrt{u+v}" :db/ensure [:answer/validate]} {:db/id "answer-08f49d0c-f8bf-5cbd-b4c6-6dfe0604684e" :answer/id #uuid "08f49d0c-f8bf-5cbd-b4c6-6dfe0604684e" :answer/type :answer.type/math :answer/value "14\\sqrt{uv}" :db/ensure [:answer/validate]} {:db/id "answer-5ab73013-fe3d-5603-853c-82b4701416c6" :answer/id #uuid "5ab73013-fe3d-5603-853c-82b4701416c6" :answer/type :answer.type/math :answer/value "2\\