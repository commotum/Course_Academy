"question-f8cf4372-3ba4-555f-93d2-c874764a61de" "question-1e63bbce-6bf5-50ed-a823-bd6bd4ad0965"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092914 :question/problem "$\\operatorname{cosh}⁡(\\operatorname{ln}⁡\\sqrt{3})=$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡\\sqrt{3}) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{3}}+{e}^{-\\operatorname{ln}⁡\\sqrt{3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{3}}+{e}^{\\operatorname{ln}⁡(1/\\sqrt{3})}) \\\\  & =\\frac{1}{2}(\\sqrt{3}+\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{1}{2}(\\frac{3+1}{\\sqrt{3}}) \\\\  & =\\frac{4}{2\\sqrt{3}} \\\\  & =\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186091684 :answer-field/correct 17592186091688 :db/ensure [:answer-field/validate]} {:db/id 17592186316986 :answer-field/correct "answer-4074f6b7-e649-530f-8bb2-231153d8d5c1" :answer-field/choices ["answer-4074f6b7-e649-530f-8bb2-231153d8d5c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-4074f6b7-e649-530f-8bb2-231153d8d5c1" :answer/id #uuid "4074f6b7-e649-530f-8bb2-231153d8d5c1" :answer/type :answer.type/math :answer/value "z^{-6}" :db/ensure [:answer/validate]} {:db/id 17592186317148 :answer-field/correct "answer-0aab7419-cbe8-5fc5-bb0b-aeb4216e8808" :answer-field/choices ["answer-0aab7419-cbe8-5fc5-bb0b-aeb4216e8808"] :db/ensure [:answer-field/validate]} {:db/id "answer-0aab7419-cbe8-5fc5-bb0b-aeb4216e8808" :answer/id #uuid "0aab7419-cbe8-5fc5-bb0b-aeb4216e8808" :answer/type :answer.type/math :answer/value "e^{3}" :db/ensure [:answer/validate]} {:db/id "question-568ae2e9-d676-5003-b917-02b31b4feb79" :question/id #uuid "568ae2e9-d676-5003-b917-02b31b4feb79" :question/math-academy-id "q-125343" :question/problem "$\\operatorname{cosh}⁡(\\sqrt{5})=$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\sqrt{5}) & =\\frac{1}{2}({e}^{\\sqrt{5}}+{e}^{-\\sqrt{5}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a1eaac59-af6f-54e8-bbb7-5ab38a15f5fe"] :db/ensure [:question/validate]} {:db/id "answer-field-a1eaac59-af6f-54e8-bbb7-5ab38a15f5fe" :answer-field/id #uuid "a1eaac59-af6f-54e8-bbb7-5ab38a15f5fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6466783-f231-50c1-96ff-206d27740ee4" :answer-field/choices ["answer-c91d4c39-01d7-575d-8878-a11bbceababe" "answer-e1e53f20-9b6f-54ab-a51f-65baa20ab8ff" "answer-56552855-f1e7-5ca3-aa77-2b042b5de66e" "answer-f6466783-f231-50c1-96ff-206d27740ee4" "answer-09cf99c6-7c24-52e7-be8a-8a9fb4ef2e41"] :db/ensure [:answer-field/validate]} {:db/id "answer-c91d4c39-01d7-575d-8878-a11bbceababe" :answer/id #uuid "c91d4c39-01d7-575d-8878-a11bbceababe" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{-\\sqrt{5}/2}-{e}^{\\sqrt{5}/2})" :db/ensure [:answer/validate]} {:db/id "answer-e1e53f20-9b6f-54ab-a51f-65baa20ab8ff" :answer/id #uuid "e1e53f20-9b6f-54ab-a51f-65baa20ab8ff" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{-\\sqrt{5}}-{e}^{\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "answer-56552855-f1e7-5ca3-aa77-2b042b5de66e" :answer/id #uuid "56552855-f1e7-5ca3-aa77-2b042b5de66e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}/2}+{e}^{-\\sqrt{5}/2})" :db/ensure [:answer/validate]} {:db/id "answer-f6466783-f231-50c1-96ff-206d27740ee4" :answer/id #uuid "f6466783-f231-50c1-96ff-206d27740ee4" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}}+{e}^{-\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "answer-09cf99c6-7c24-52e7-be8a-8a9fb4ef2e41" :answer/id #uuid "09cf99c6-7c24-52e7-be8a-8a9fb4ef2e41" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}}-{e}^{-\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "question-98232048-0528-5aa4-8a77-d211e3369a57" :question/id #uuid "98232048-0528-5aa4-8a77-d211e3369a57" :question/math-academy-id "q-300746" :question/problem "Express $\\operatorname{cosh}⁡(-\\frac{3x}{4})$ in terms of $e$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(-\\frac{3x}{4})=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-\\frac{3x}{4}) & =\\frac{1}{2}({e}^{-3x/4}+{e}^{-(-3x/4)}) \\\\  & =\\frac{1}{2}({e}^{-3x/4}+{e}^{3x/4}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4e34ca8a-375e-57fa-86d3-0c1d705c1138"] :db/ensure [:question/validate]} {:db/id "answer-field-4e34ca8a-375e-57fa-86d3-0c1d705c1138" :answer-field/id #uuid "4e34ca8a-375e-57fa-86d3-0c1d705c1138" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-17d5d01a-8c9a-52fd-8938-cc2f51a738d1" :answer-field/choices ["answer-17d5d01a-8c9a-52fd-8938-cc2f51a738d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-17d5d01a-8c9a-52fd-8938-cc2f51a738d1" :answer/id #uuid "17d5d01a-8c9a-52fd-8938-cc2f51a738d1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\left(e^{-\\frac{3x}{4}}+e^{\\frac{3x}{4}}\\right)" :db/ensure [:answer/validate]} {:db/id "question-b4db71bf-bb20-5cb8-bf0c-68dc6c798e64" :question/id #uuid "b4db71bf-bb20-5cb8-bf0c-68dc6c798e64" :question/math-academy-id "q-342686" :question/problem "Express $\\operatorname{sinh}⁡5x$ in terms of $e$ using the definition of the hyperbolic sine.\n\n$\\operatorname{sinh}⁡5x=$\n {{field-1}}" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡5x=\\frac{1}{2}({e}^{5x}-{e}^{-5x}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0c0b8b32-f645-55ea-a6f7-813ca2348e58"] :db/ensure [:question/validate]} {:db/id "answer-field-0c0b8b32-f645-55ea-a6f7-813ca2348e58" :answer-field/id #uuid "0c0b8b32-f645-55ea-a6f7-813ca2348e58" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ae355e57-f688-5172-8dd6-f32ed5aea3ca" :answer-field/choices ["answer-ae355e57-f688-5172-8dd6-f32ed5aea3ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae355e57-f688-5172-8dd6-f32ed5aea3ca" :answer/id #uuid "ae355e57-f688-5172-8dd6-f32ed5aea3ca" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\left(e^{5x}-e^{-5x}\\right)" :db/ensure [:answer/validate]} {:db/id "question-57b7ec72-0bfc-579f-8690-12d54f8319d9" :question/id #uuid "57b7ec72-0bfc-579f-8690-12d54f8319d9" :question/math-academy-id "q-342761" :question/problem "Evaluate $\\operatorname{sinh}⁡(\\sqrt{2}).$ **Do not round** your answer.\n\n$\\operatorname{sinh}⁡(\\sqrt{2})=\\frac{1}{2}({e}^{\\sqrt{2}}\\,-$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\sqrt{2}) & =\\frac{1}{2}({e}^{\\sqrt{2}}-{e}^{-\\sqrt{2}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a001c759-9442-561c-b232-f18a3ed62722"] :db/ensure [:question/validate]} {:db/id "answer-field-a001c759-9442-561c-b232-f18a3ed62722" :answer-field/id #uuid "a001c759-9442-561c-b232-f18a3ed62722" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6daf8145-1d04-579f-8c45-d0d73bb981a9" :answer-field/choices ["answer-6daf8145-1d04-579f-8c45-d0d73bb981a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-6daf8145-1d04-579f-8c45-d0d73bb981a9" :answer/id #uuid "6daf8145-1d04-579f-8c45-d0d73bb981a9" :answer/type :answer.type/math :answer/value "e^{-\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "question-958048ce-f9d1-5782-ad7f-1bcc0753619d" :question/id #uuid "958048ce-f9d1-5782-ad7f-1bcc0753619d" :question/math-academy-id "q-95492" :question/problem "Given that $z>0,$ which of the following is equivalent to $\\operatorname{sinh}⁡(2\\operatorname{ln}⁡z)?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(2\\operatorname{ln}⁡z) & =\\frac{1}{2}({e}^{2\\operatorname{ln}⁡z}-{e}^{-2\\operatorname{ln}⁡z}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡{z}^{2}}-{e}^{\\operatorname{ln}⁡{z}^{-2}}) \\\\  & =\\frac{1}{2}({z}^{2}-{z}^{-2}) \\\\  & =\\frac{1}{2}({z}^{2}-\\frac{1}{{z}^{2}}) \\\\  & =\\frac{1}{2}(\\frac{{z}^{4}-1}{{z}^{2}}) \\\\  & =\\frac{{z}^{4}-1}{2{z}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1c5c7ef5-8ca5-5c12-9d79-8a62b31c25ba"] :db/ensure [:question/validate]} {:db/id "answer-field-1c5c7ef5-8ca5-5c12-9d79-8a62b31c25ba" :answer-field/id #uuid "1c5c7ef5-8ca5-5c12-9d79-8a62b31c25ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59dc9393-aba4-55f1-a33b-edbc6a5c7c71" :answer-field/choices ["answer-ed0f0085-d2a8-5d8d-9d1f-f807dca76f30" "answer-cef8d180-cb9e-5d9e-bd31-7ec2446df85d" "answer-07554fcf-2e2c-5e04-b659-229769d5a42f" "answer-c9ac03e5-f4b2-5887-ba43-a82100a8936e" "answer-59dc9393-aba4-55f1-a33b-edbc6a5c7c71"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed0f0085-d2a8-5d8d-9d1f-f807dca76f30" :answer/id #uuid "ed0f0085-d2a8-5d8d-9d1f-f807dca76f30" :answer/type :answer.type/math :answer/value "\\frac{{z}^