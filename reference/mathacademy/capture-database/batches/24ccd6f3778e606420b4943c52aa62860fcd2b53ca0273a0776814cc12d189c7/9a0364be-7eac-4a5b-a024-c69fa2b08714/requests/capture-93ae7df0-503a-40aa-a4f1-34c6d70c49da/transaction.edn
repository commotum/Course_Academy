5234-5f95-ab08-5696cfa175b7" :answer-field/id #uuid "a3c733f8-5234-5f95-ab08-5696cfa175b7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ba26f4fc-9b25-5012-9058-68aac89a4425" :answer-field/choices ["answer-ba26f4fc-9b25-5012-9058-68aac89a4425"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba26f4fc-9b25-5012-9058-68aac89a4425" :answer/id #uuid "ba26f4fc-9b25-5012-9058-68aac89a4425" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-e08860ba-c89a-5bab-9100-e207695170f9" :question/id #uuid "e08860ba-c89a-5bab-9100-e207695170f9" :question/math-academy-id "q-237426" :question/problem "The measure of the angle that forms a linear pair with the angle of ${27}^{∘}$ is{{field-1}}${}^{∘}.$" :question/worked-solution "If two angles form a linear pair, the sum of their measures is equal to ${180}^{∘}.$ \n\nSo, the measure of an angle forming a linear pair with an angle of ${27}^{∘}$ equals\n\n$$\n\\begin{aligned}{180}^{∘}-{27}^{∘} & ={153}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e82aee16-2622-55e0-a5db-cad4413860c0"] :db/ensure [:question/validate]} {:db/id "answer-field-e82aee16-2622-55e0-a5db-cad4413860c0" :answer-field/id #uuid "e82aee16-2622-55e0-a5db-cad4413860c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c185cc5-4f85-5664-a619-1b09f768c62b" :answer-field/choices ["answer-4c185cc5-4f85-5664-a619-1b09f768c62b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c185cc5-4f85-5664-a619-1b09f768c62b" :answer/id #uuid "4c185cc5-4f85-5664-a619-1b09f768c62b" :answer/type :answer.type/math :answer/value "153" :db/ensure [:answer/validate]} {:db/id "question-29678fcd-bdef-5e0e-a077-5ea622166f37" :question/id #uuid "29678fcd-bdef-5e0e-a077-5ea622166f37" :question/math-academy-id "q-116947" :question/problem "Find the measure of an angle that's supplementary to an angle of $(2x+65)^{∘}.$" :question/worked-solution "Two angles are supplementary if their measures add up to ${180}^{∘}.$ \n\nSo, the measure of an angle that's supplementary to an angle of $(2x+65)^{∘}$ must be\n\n$$\n\\begin{aligned}{180}^{∘}-(2x+65)^{∘} & =(180-2x-65)^{∘} \\\\  & =(180-65-2x)^{∘} \\\\  & =(115-2x)^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be075f8e-e333-5152-b6eb-954bb5809f88"] :db/ensure [:question/validate]} {:db/id "answer-field-be075f8e-e333-5152-b6eb-954bb5809f88" :answer-field/id #uuid "be075f8e-e333-5152-b6eb-954bb5809f88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-39026e8c-a50e-5241-85fb-c25d882b359d" :answer-field/choices ["answer-39026e8c-a50e-5241-85fb-c25d882b359d" "answer-df319ec0-2902-5360-8b8d-161abbb47622" "answer-c1b23fa1-04c8-58f0-b137-5d64f4e4cb02" "answer-eeff8cef-f9d0-5872-94e7-733901ca86f9" "answer-08ed856c-a331-59e4-be0a-d6b1fcd53f89"] :db/ensure [:answer-field/validate]} {:db/id "answer-39026e8c-a50e-5241-85fb-c25d882b359d" :answer/id #uuid "39026e8c-a50e-5241-85fb-c25d882b359d" :answer/type :answer.type/math :answer/value "(115-2x)^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-df319ec0-2902-5360-8b8d-161abbb47622" :answer/id #uuid "df319ec0-2902-5360-8b8d-161abbb47622" :answer/type :answer.type/math :answer/value "(155-2x)^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c1b23fa1-04c8-58f0-b137-5d64f4e4cb02" :answer/id #uuid "c1b23fa1-04c8-58f0-b137-5d64f4e4cb02" :answer/type :answer.type/math :answer/value "(245-2x)^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-eeff8cef-f9d0-5872-94e7-733901ca86f9" :answer/id #uuid "eeff8cef-f9d0-5872-94e7-733901ca86f9" :answer/type :answer.type/math :answer/value "(25-2x)^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-08ed856c-a331-59e4-be0a-d6b1fcd53f89" :answer/id #uuid "08ed856c-a331-59e4-be0a-d6b1fcd53f89" :answer/type :answer.type/math :answer/value "(95-2x)^{∘}" :db/ensure [:answer/validate]} {:db/id "question-0c6ac92e-0be2-531f-8b8a-397c09e6a538" :question/id #uuid "0c6ac92e-0be2-531f-8b8a-397c09e6a538" :question/math-academy-id "q-5920" :question/problem "![](images/41/41719768d5ad07b128d4a44d0dd767c8b40ca23d4a2cc4ea7179c1591c900ebd.png)\n\nSolve for $x$ given the figure above." :question/worked-solution "Since the two angles are supplementary, the sum of their measures is equal to ${180}^{∘}.$ Therefore:\n\n$$\n\\begin{aligned}{40}^{∘}+(5x+{20}^{∘}) & ={180}^{∘} \\\\ 5x+{60}^{∘} & ={180}^{∘} \\\\ 5x & ={120}^{∘} \\\\ x & ={24}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6b0ca8a4-e827-5427-bc8e-2d2216283d94"] :db/ensure [:question/validate]} {:db/id "answer-field-6b0ca8a4-e827-5427-bc8e-2d2216283d94" :answer-field/id #uuid "6b0ca8a4-e827-5427-bc8e-2d2216283d94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c372a766-c59f-5385-8c29-b00b163db7b4" :answer-field/choices ["answer-5c2d6299-a8a5-53f9-b216-df1dbc49a1cd" "answer-188bec29-6e29-575a-85bd-d938e660cc52" "answer-c372a766-c59f-5385-8c29-b00b163db7b4" "answer-7961ee07-8f19-530d-a718-164eaa2b4559" "answer-6fc1ecb5-d7eb-5500-bd4b-91ea1d561875"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c2d6299-a8a5-53f9-b216-df1dbc49a1cd" :answer/id #uuid "5c2d6299-a8a5-53f9-b216-df1dbc49a1cd" :answer/type :answer.type/math :answer/value "{12}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-188bec29-6e29-575a-85bd-d938e660cc52" :answer/id #uuid "188bec29-6e29-575a-85bd-d938e660cc52" :answer/type :answer.type/math :answer/value "{18}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c372a766-c59f-5385-8c29-b00b163db7b4" :answer/id #uuid "c372a766-c59f-5385-8c29-b00b163db7b4" :answer/type :answer.type/math :answer/value "{24}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-7961ee07-8f19-530d-a718