ld/validate]} {:db/id "answer-71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/id #uuid "71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/type :answer.type/math :answer/value "e^{-3/2}" :db/ensure [:answer/validate]} {:db/id 17592186316959 :answer-field/correct "answer-2decd2dd-0162-5cec-a8e5-6a1fb6aa9937" :answer-field/choices ["answer-2decd2dd-0162-5cec-a8e5-6a1fb6aa9937"] :db/ensure [:answer-field/validate]} {:db/id "answer-2decd2dd-0162-5cec-a8e5-6a1fb6aa9937" :answer/id #uuid "2decd2dd-0162-5cec-a8e5-6a1fb6aa9937" :answer/type :answer.type/math :answer/value "e^{4q}-1" :db/ensure [:answer/validate]} {:db/id "question-ea77914f-6e86-5cb0-a566-942e82f36dc8" :question/id #uuid "ea77914f-6e86-5cb0-a566-942e82f36dc8" :question/math-academy-id "q-95601" :question/problem "$\\operatorname{tanh}⁡(-\\frac{1}{2})=$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\frac{1}{2}) & =\\frac{1-{e}^{-2(-1/2)}}{1+{e}^{-2(-1/2)}} \\\\  & =\\frac{1-e}{1+e}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3878f530-02bd-58fa-8a92-0929a7b051c9"] :db/ensure [:question/validate]} {:db/id "answer-field-3878f530-02bd-58fa-8a92-0929a7b051c9" :answer-field/id #uuid "3878f530-02bd-58fa-8a92-0929a7b051c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer-field/choices ["answer-79feb6a3-fd63-5722-bf1a-1b17b2a99447" "answer-4a3886a5-1d7a-5ca7-8738-12d8ef255d94" "answer-993d1f00-a0df-5f47-8016-9bb479cdc26d" "answer-d3b2a103-ca01-59e5-8aa6-8e7ebc6ce6cd" "answer-c8cb142d-3a7c-5922-acfe-51b1201c66ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-79feb6a3-fd63-5722-bf1a-1b17b2a99447" :answer/id #uuid "79feb6a3-fd63-5722-bf1a-1b17b2a99447" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4a3886a5-1d7a-5ca7-8738-12d8ef255d94" :answer/id #uuid "4a3886a5-1d7a-5ca7-8738-12d8ef255d94" :answer/type :answer.type/math :answer/value "\\frac{1+\\sqrt{e}}{1-\\sqrt{e}}" :db/ensure [:answer/validate]} {:db/id "answer-993d1f00-a0df-5f47-8016-9bb479cdc26d" :answer/id #uuid "993d1f00-a0df-5f47-8016-9bb479cdc26d" :answer/type :answer.type/math :answer/value "\\frac{1+e}{1-e}" :db/ensure [:answer/validate]} {:db/id "answer-d3b2a103-ca01-59e5-8aa6-8e7ebc6ce6cd" :answer/id #uuid "d3b2a103-ca01-59e5-8aa6-8e7ebc6ce6cd" :answer/type :answer.type/math :answer/value "\\frac{1-\\sqrt{e}}{1+\\sqrt{e}}" :db/ensure [:answer/validate]} {:db/id "answer-c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/id #uuid "c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/type :answer.type/math :answer/value "\\frac{1-e}{1+e}" :db/ensure [:answer/validate]} {:db/id "question-957cf846-05af-527e-b9b5-8a808e2c175e" :question/id #uuid "957cf846-05af-527e-b9b5-8a808e2c175e" :question/math-academy-id "q-342677" :question/problem "Simplify $tanh\\,(\\frac{k}{3})$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$tanh\\,(\\frac{k}{3})=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{2k/3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,(\\frac{k}{3}) & =\\frac{{e}^{2(k/3)}-1}{{e}^{2(k/3)}+1} \\\\  & =\\frac{{e}^{2k/3}-1}{{e}^{2k/3}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e28fb333-812f-5331-bf83-e683ff5050d2"] :db/ensure [:question/validate]} {:db/id "answer-field-e28fb333-812f-5331-bf83-e683ff5050d2" :answer-field/id #uuid "e28fb333-812f-5331-bf83-e683ff5050d2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer-field/choices ["answer-be416ad7-fa5c-5f2a-8f8e-5c23bca4c530"] :db/ensure [:answer-field/validate]} {:db/id "answer-be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/id #uuid "be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/type :answer.type/math :answer/value "e^{\\frac{2k}{3}}-1" :db/ensure [:answer/validate]} {:db/id "question-f8cf4372-3ba4-555f-93d2-c874764a61de" :question/id #uuid "f8cf4372-3ba4-555f-93d2-c874764a61de" :question/math-academy-id "q-9445" :question/problem "$\\operatorname{tanh}⁡(\\sqrt{3})=$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(\\sqrt{3}) & =\\frac{{e}^{2\\sqrt{3}}-1}{{e}^{2\\sqrt{3}}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cc305089-5207-543c-9838-545137559d4e"] :db/ensure [:question/validate]} {:db/id "answer-field-cc305089-5207-543c-9838-545137559d4e" :answer-field/id #uuid "cc305089-5207-543c-9838-545137559d4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0167f467-6165-5edb-9e25-0d0a365490f9" :answer-field/choices ["answer-a0202326-37e3-5269-ba19-043affa2e41b" "answer-0167f467-6165-5edb-9e25-0d0a365490f9" "answer-316c555c-d647-56c9-b59c-36c16a9b9cf3" "answer-a559c2ba-ee8a-52a3-88f0-cb110a813012" "answer-e4a59a07-a609-5baa-8e86-91a0b8608949"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0202326-37e3-5269-ba19-043affa2e41b" :answer/id #uuid "a0202326-37e3-5269-ba19-043affa2e41b" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2\\sqrt{3}}+1}{{e}^{2\\sqrt{3}}-1}" :db/ensure [:answer/validate]} {:db/id "answer-0167f467-6165-5edb-9e25-0d0a365490f9" :answer/id #uuid "0167f467-6165-5edb-9e25-0d0a365490f9" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2\\sqrt{3}}-1}{{e}^{2\\sqrt{3}}+1}" :db/ensure [:answer/validate]} {:db/id "answer-316c555c-d647-56c9-b59c-36c16a9b9cf3" :answer/id #uuid "316c555c-d647-56c9-b59c-36c16a9b9cf3" :answer/type :answer.type/math :answer/value "\\frac{{e}^{\\sqrt{3}/2}-1}{{e}^{\\sqrt{3}/2}+1}" :db/ensure [:answer/validate]} {:db/id "answer-a559c2ba-ee8a-52a3-88f0-cb110a813012" :answer/id #uuid "a559c2ba-ee8a-52a3-88f0-cb110a813012" :answer/type :answer.type/math :answer/value "\\frac{{e}^{\\sqrt{3}}+1}{{e}^{\\sqrt{3}}-1}" :db/ensure [:answer/validate]} {:db/id "answer-e4a59a07-a609-5baa-8e86-91a0b8608949" :answer/id #uuid "e4a59a07-a609-5baa-8e86-91a0b8608949" :answer/type :answer.type/math :answer/value "\\frac{{e}^{\\sqrt{3}}-1}{{e}^{\\sqrt{3}}+1}" :db/ensure [:answer/validate]} {:db/id "question-1e63bbce-6bf5-50ed-a823-bd6bd4ad0965" :question/id #uuid "1e63bbce-6bf5-50ed-a823-bd6bd4ad0965" :question/math-academy-id "q-342673" :question/problem "Simplify $tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x)$ using the definition of the hyperbolic tangent.\n\n$tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x)=$\n\n| {{field-1}} |\n| --- |\n| ${x}^{3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x) & =\\frac{{e}^{2(\\frac{3}{2}\\operatorname{ln}⁡x)}-1}{{e}^{2(\\frac{3}{2}\\operatorname{ln}⁡x)}+1} \\\\  & =\\frac{{e}^{3\\operatorname{ln}⁡x}-1}{{e}^{3\\operatorname{ln}⁡x}+1} \\\\  & =\\frac{{e}^{\\operatorname{ln}⁡{x}^{3}}-1}{{e}^{\\operatorname{ln}⁡{x}^{3}}+1} \\\\  & =\\frac{{x}^{3}-1}{{x}^{3}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a268cdd9-081d-55c2-903c-5d29e55e0ccc"] :db/ensure [:question/validate]} {:db/id "answer-field-a268cdd9-081d-55c2-903c-5d29e55e0ccc" :answer-field/id #uuid "a268cdd9-081d-55c2-903c-5d29e55e0ccc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-43fca01d-214c-5770-b687-855abe991a41" :answer-field/choices ["answer-43fca01d-214c-5770-b687-855abe991a41"] :db/ensure [:answer-field/validate]} {:db/id "answer-43fca01d-214c-5770-b687-855abe991a41" :answer/id #uuid "43fca01d-214c-5770-b687-855abe991a41" :answer/type :answer.type/math :answer/value "x^{3}-1" :db/ensure [:answer/validate]} {:db/id 17592186093453 :tutorial/content "The **hyperbolic functions** are functions defined using the exponential functions $e^x$ and $e^{-x}.$ As we will see at the end of the lesson, hyperbolic functions are closely related to trigonometric functions. \n\nThe **hyperbolic cosine** (abbreviated and pronounced \"cosh\") is defined as\n\n$$\n\\cosh x=  \\dfrac12\\left(e^x+e^{-x}\\right).\n$$\n\nThe graph of $y=\\cosh x$ is shown below.\n\n![](images/28/286e0b946edf5c8a8eb23753aaef79812d7c1e7471ab32f43eda81795fb7f47a.png)\n\nThe function $y=\\cosh x$ is not a parabola, although it may look like one.\n\nNote the following properties of $y=\\cosh x\\mathbin{:}$\n\n- Its domain is $x\\in (-\\infty, \\infty).$\n\n- Its range is $y \\geq 1.$\n\n- It is an even function.\n\nTo evaluate $\\cosh x$ at some value, say $x=2,$ we simply substitute our value into the definition:\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡2=\\frac{1}{2}({e}^{2}+{e}^{-2})≈3.7622\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186093456 :tutorial/content "Just as we do with trigonometric functions, we can use the basic hyperbolic functions $\\sinh x$ and $\\cosh x$ to create more hyperbolic functions.\n\nThe **hyperbolic tangent** (pronounced \"tanch\") is defined as \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x=\\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\,\\,\\,.\\end{aligned}\n$$\n\nThe graph of $y=\\tanh x$ is shown below.\n\n![](images/ac/ac244e57465dc7588094b3b6dae74bfc954f4705be6a2f5edbba2db3e6eeaa9d.png)\n\nNote the following properties of $y=\\tanh x\\mathbin{:}$\n\n- Its domain is $x\\in (-\\infty, \\infty).$\n\n- Its range is $y \\in (-1,1).$\n\n- It has horizontal asymptotes $y=\\pm 1.$\n\n- It is an odd function.\n\nWe can write down an equivalent definition of $\\tanh{x}$ by multiplying the numerator and denominator by $e^x\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\cdot \\,\\frac{{e}^{x}}{{e}^{x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1}\\end{aligned}\n$$\n\nThe third definition of $\\tanh{x}$ can be found by multiplying the numerator and denominator of our original definition by $e^{-x}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\cdot \\,\\frac{{e}^{-x}}{{e}^{-x}} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}\\end{aligned}\n$$\n\nWe can use any definition of $\\tanh x$ that we like for a given situation. However, it's often convenient to use the second or third definition when evaluating a function containing $\\tanh{x},$ because they include fewer exponential terms than the first definition." :db/ensure [:tutorial/validate]} {:db/id 17592186093459 :tutorial/content "We can similarly derive a link between $\\sin\\theta$ and $\\sinh\\theta.$ To do this, let's recall Euler's formula once more.\n\n$$\ne^{\\textrm i\\theta} = \\cos\\theta + \\textrm i\\sin\\theta\n$$\n\nWe also have\n\n$$\ne^{-\\textrm i\\theta} = \\cos\\theta - \\textrm i\\sin\\theta.\n$$\n\nSubtracting the two equations, we get\n\n$$\ne^{\\textrm i\\theta}  - e^{-\\textrm i\\theta} = 2\\textrm i\\sin\\theta.\n$$\n\nMaking $\\sin\\theta$ the subject of the equation, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{1}{2\\text{i}}({e}^{\\text{i}\\theta }-{e}^{-\\text{i}\\theta }) \\\\  & =-\\frac{\\text{i}}{2}({e}^{\\text{i}\\theta }-{e}^{-\\text{i}\\theta }),\\end{aligned}\n$$\n\nwhich gives us the identity\n\n$$\n\\sin\\theta = -\\textrm i \\sinh(\\textrm i\\theta).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186092451 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186129106 :knowledge-point/questions ["question-0645f9ac-fa94-5fef-b4fc-1a67ee7ebbe9" "question-6597c4d9-0b32-5959-9350-add218849a8e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128873 :question/worked-solution "The roots of the function are the $x$-intercepts. Therefore, the roots are $x=-6,-3,0,3,6.$\n\n![](images/53/534bffb28abfa0609ae498f987be560f82037134e21d16e79c133ed82f1b1cd3.png)" :db/ensure [:question/validate]} {:db/id 17592186129107 :knowledge-point/questions ["question-4a7f1341-51d1-5495-a7b0-9a9569fe4c9a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128874 :question/problem "If $f(x)$ is given by the table shown below, what are its roots?\n\n| $x$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $0$ | $-2$ | $-4$ | $0$ | $1$ | $3$ |" :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given table, we see that $f(-2)=0$ and $f(1)=0.$\n\nTherefore, the roots of the function are $x=-2$ and $x=1.$" :db/ensure [:question/validate]} {:db/id 17592186129108 :knowledge-point/questions ["question-8e742ff0-460d-5812-916a-b9b820b7f39f" "question-80fe3e8e-f7e1-5a2a-9e77-9f545ee857e4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128875 :question/worked-solution "The roots of the function are the values of $x$ such that $g(x)=0.$ In the given mapping diagram, we see that $g(9) = 0.$\n\nTherefore, the only root of the function is $x=9.$" :db/ensure [:question/validate]} {:db/id 17592186129109 :knowledge-point/questions ["question-24214f4f-5b69-59e3-9894-848806975f44" "question-093b2e5c-e9f3-501b-a863-23c715264f2d" "question-6b18fe87-24b2-577e-8e31-abad021a59b4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128876 :question/problem "What is the root of the function $f(x)=2-4x?$" :question/worked-solution "The roots are the solutions to the equation $f(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ 2-4x & =0 \\\\ 4x & =2 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\dfrac12.$" :db/ensure [:question/validate]} {:db/id "question-0645f9ac-fa94-5fef-b4fc-1a67ee7ebbe9" :question/id #uuid "0645f9ac-fa94-5fef-b4fc-1a67ee7ebbe9" :question/math-academy-id "q-37876" :question/problem "![](images/ae/ae3fdc9540bdca476e2f0dc06bf55826daade1ff57bad3b355eb2981a2acff57.png)\n\nWhat are the roots of the function shown above?" :question/worked-solution "The roots of the function are the $x$-intercepts. Therefore, the roots are $x=-4,-2,0,1,4.$\n\n![](images/2d/2d39c0f73b96e6d9a8e5208ac96dc36d215bc8e9217438ae3f5a334ac0e762d5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1085023c-078a-52f5-ab55-ca8c22a72451"] :db/ensure [:question/validate]} {:db/id "answer-field-1085023c-078a-52f5-ab55-ca8c22a72451" :answer-field/id #uuid "1085023c-078a-52f5-ab55-ca8c22a72451" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d93ac449-f67f-58eb-a719-54a6c92e7c20" :answer-field/choices ["answer-db3c0d81-86b7-55a6-8799-5215deb8ea83" "answer-d93ac449-f67f-58eb-a719-54a6c92e7c20" "answer-9c41784c-e055-5bda-afc3-596f365fd3d3" "answer-519519a0-9c0e-545a-9e46-ef92a256fe00" "answer-3b5d6c26-f149-5430-a069-508077b396bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-db3c0d81-86b7-55a6-8799-5215deb8ea83" :answer/id #uuid "db3c0d81-86b7-55a6-8799-5215deb8ea83" :answer/type :answer.type/math :answer/value "-3,-2,0,2,4" :db/ensure [:answer/validate]} {:db/id "answer-d93ac449-f67f-58eb-a719-54a6c92e7c20" :answer/id #uuid "d93ac449-f67f-58eb-a719-54a6c92e7c20" :answer/type :answer.type/math :answer/value "-4,-2,0,1,4" :db/ensure [:answer/validate]} {:db/id "answer-9c41784c-e055-5bda-afc3-596f365fd3d3" :answer/id #uuid "9c41784c-e055-5bda-afc3-596f365fd3d3" :answer/type :answer.type/math :answer/value "-5,-3,1,3,5" :db/ensure [:answer/validate]} {:db/id "answer-519519a0-9c0e-545a-9e46-ef92a256fe00" :answer/id #uuid "519519a0-9c0e-545a-9e46-ef92a256fe00" :answer/type :answer.type/math :answer/value "-6,-2,4,5" :db/ensure [:answer/validate]} {:db/id "answer-3b5d6c26-f149-5430-a069-508077b396bf" :answer/id #uuid "3b5d6c26-f149-5430-a069-508077b396bf" :answer/type :answer.type/math :answer/value "-6,-4,1,5" :db/ensure [:answer/validate]} {:db/id "question-6597c4d9-0b32-5959-9350-add218849a8e" :question/id #uuid "6597c4d9-0b32-5959-9350-add218849a8e" :question/math-academy-id "q-216819" :question/problem "![](images/37/37439fb84da05737f6edb9f89b39171692fef6101b1f533ded725e62564d4670.png)\n\nThe root of the function shown above is$\\,x=$\n{{field-1}}\n." :question/worked-solution "The roots of the function are the $x$-intercepts. Therefore, the root is $x=-2.$\n\n![](images/b5/b5360593c2f639b831a19a97eb17d85199c5bf57a9d496739fa46a3a7e48ddd5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-67063415-ef3a-53a3-9988-6ab8b08ec2a3"] :db/ensure [:question/validate]} {:db/id "answer-field-67063415-ef3a-53a3-9988-6ab8b08ec2a3" :answer-field/id #uuid "67063415-ef3a-53a3-9988-6ab8b08ec2a3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-faaa8b9d-62fc-59bf-bb2b-855e9803ad9a" :answer-field/choices ["answer-faaa8b9d-62fc-59bf-bb2b-855e9803ad9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-faaa8b9d-62fc-59bf-bb2b-855e9803ad9a" :answer/id #uuid "faaa8b9d-62fc-59bf-bb2b-855e9803ad9a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186129649 :question/problem "If $f(x)$ is given by the table shown below, what are its roots?\n\n| $x$ | $-4$ | $-3$ | $-2$ | $0$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $16$ | $6$ | $0$ | $1$ | $3$ | $0$ | $16$ | $25$ |" :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given table, we see that $f(-2)=0$ and $f(3)=0.$\n\nTherefore, the roots of the function are $x=-2$ and $x=3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186127375 :answer-field/correct 17592186127376 :db/ensure [:answer-field/validate]} {:db/id "question-4a7f1341-51d1-5495-a7b0-9a9569fe4c9a" :question/id #uuid "4a7f1341-51d1-5495-a7b0-9a9569fe4c9a" :question/math-academy-id "q-216842" :question/problem "| $x$ | $-4.5$ | $-3.5$ | $-2$ | $0$ | $1.5$ | $2$ | $4.5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $3$ | $0$ | $4$ | $-1$ | $2$ | $1$ |\n\nThe root of the function $f(x)$ is $x=$\n{{field-1}}." :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given table, we see that $f(-2)=0.$\n\nTherefore, the root of the function is $x=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a0812c29-8c56-5f13-bd58-25e0aa19978d"] :db/ensure [:question/validate]} {:db/id "answer-field-a0812c29-8c56-5f13-bd58-25e0aa19978d" :answer-field/id #uuid "a0812c29-8c56-5f13-bd58-25e0aa19978d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5211d2b3-169a-5664-921a-6bd8e69e284e" :answer-field/choices ["answer-5211d2b3-169a-5664-921a-6bd8e69e284e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5211d2b3-169a-5664-921a-6bd8e69e284e" :answer/id #uuid "5211d2b3-169a-5664-921a-6bd8e69e284e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "question-8e742ff0-460d-5812-916a-b9b820b7f39f" :question/id #uuid "8e742ff0-460d-5812-916a-b9b820b7f39f" :question/math-academy-id "q-216848" :question/problem "![](images/ac/acc14b61036a00f4fae8d850954293c99d48388a8b4a83dda158bf1688d97c62.png)\n\nWhat are the roots of the function $f(x)$ defined by the mapping diagram shown above?\n\nIn **ascending order**, the roots are $x=$\n{{field-1}}\nand $x=$\n{{field-2}}." :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given mapping diagram, we see that $f(3)=0$ and $f(4)=0.$\n\nTherefore, the roots of the function are $x=3$ and $x=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cbf215d5-5848-533e-8d4c-81471a5f8099" "answer-field-c6c64e7a-45b1-50f7-a4a9-40fff35c0d41"] :db/ensure [:question/validate]} {:db/id "answer-field-cbf215d5-5848-533e-8d4c-81471a5f8099" :answer-field/id #uuid "cbf215d5-5848-533e-8d4c-81471a5f8099" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-84718024-e970-569e-b08c-00713889c316" :answer-field/choices ["answer-84718024-e970-569e-b08c-00713889c316"] :db/ensure [:answer-field/validate]} {:db/id "answer-84718024-e970-569e-b08c-00713889c316" :answer/id #uuid "84718024-e970-569e-b08c-00713889c316" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-c6c64e7a-45b1-50f7-a4a9-40fff35c0d41" :answer-field/id #uuid "c6c64e7a-45b1-50f7-a4a9-40fff35c0d41" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-916428fb-b090-57bf-a725-0ec6f7