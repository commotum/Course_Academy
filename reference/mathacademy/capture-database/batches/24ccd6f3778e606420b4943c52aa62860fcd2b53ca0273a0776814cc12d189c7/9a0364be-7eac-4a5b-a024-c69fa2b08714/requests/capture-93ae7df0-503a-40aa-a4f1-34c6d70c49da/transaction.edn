d83b-c53b-5006-98d4-7381c08d15f2" :answer/id #uuid "045cd83b-c53b-5006-98d4-7381c08d15f2" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=0$" :db/ensure [:answer/validate]} {:db/id "answer-d7b0a05f-0b07-5c7d-b39c-d245b3b01504" :answer/id #uuid "d7b0a05f-0b07-5c7d-b39c-d245b3b01504" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=-1$" :db/ensure [:answer/validate]} {:db/id 17592186234076 :question/worked-solution "First, we let\n\n$$\nL={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h}.\n$$\n\nWe see that if we let $f(x)={e}^{x}$ and $a=2$, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{h\\to 0}\\frac{f(2+h)-f(2)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(2).$  \n\nComputing the derivative, we have\n \n\n$$\n{f}^{′}(x)={e}^{x},\\,{f}^{′}(2)={e}^{2},\n$$\n\nand therefore we conclude tha $L={e}^{2}.$" :question/answer-fields ["answer-field-62861340-2e7e-599e-813a-37a384aba64c"] :db/ensure [:question/validate]} {:db/id "answer-field-62861340-2e7e-599e-813a-37a384aba64c" :answer-field/id #uuid "62861340-2e7e-599e-813a-37a384aba64c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ffe7699b-53ea-50a7-b00d-672ab6f86d6a" :answer-field/choices ["answer-ed1dcb43-72f9-5632-8b87-c67d9b670e91" "answer-d746c8a3-bb8e-5572-8c8a-21e03e183d11" "answer-38c39ffa-cc37-57c6-bc37-b81b2034565a" "answer-53464bdb-2c4a-5641-a9f5-c6b77c691313" "answer-ffe7699b-53ea-50a7-b00d-672ab6f86d6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed1dcb43-72f9-5632-8b87-c67d9b670e91" :answer/id #uuid "ed1dcb43-72f9-5632-8b87-c67d9b670e91" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-d746c8a3-bb8e-5572-8c8a-21e03e183d11" :answer/id #uuid "d746c8a3-bb8e-5572-8c8a-21e03e183d11" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-38c39ffa-cc37-57c6-bc37-b81b2034565a" :answer/id #uuid "38c39ffa-cc37-57c6-bc37-b81b2034565a" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "answer-53464bdb-2c4a-5641-a9f5-c6b77c691313" :answer/id #uuid "53464bdb-2c4a-5641-a9f5-c6b77c691313" :answer/type :answer.type/math :answer/value "2{e}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ffe7699b-53ea-50a7-b00d-672ab6f86d6a" :answer/id #uuid "ffe7699b-53ea-50a7-b00d-672ab6f86d6a" :answer/type :answer.type/math :answer/value "{e}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186234014 :question/problem "Let $f(x)$ be the function defined below. For what value of $k$ is $f(x)$ continuous at $x=-1?$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{x-1}, & x<-1 \\\\ 2x-k, & x\\ge -1\\end{aligned}\n$$" :question/answer-fields ["answer-field-aa09ee35-3713-5a66-963f-92ef86cb648a"] :db/ensure [:question/validate]} {:db/id "answer-field-aa09ee35-3713-5a66-963f-92ef86cb648a" :answer-field/id #uuid "aa09ee35-3713-5a66-963f-92ef86cb648a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-38b73058-6d97-5937-90c5-70fa98985408" :answer-field/choices ["answer-2dc73b7a-ef3d-547d-a954-d41ff011c35f" "answer-38b73058-6d97-5937-90c5-70fa98985408" "answer-34bb0305-64c5-5b32-bbd0-485d92cf9acc" "answer-27c9870f-0506-5064-ac23-b292234d4b54" "answer-f7fcce4d-e5c7-52f8-9d54-5a89dffa0fb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dc73b7a-ef3d-547d-a954-d41ff011c35f" :answer/id #uuid "2dc73b7a-ef3d-547d-a954-d41ff011c35f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-38b73058-6d97-5937-90c5-70fa98985408" :answer/id #uuid "38b73058-6d97-5937-90c5-70fa98985408" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-34bb0305-64c5-5b32-bbd0-485d92cf9acc" :answer/id #uuid "34bb0305-64c5-5b32-bbd0-485d92cf9acc" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-27c9870f-0506-5064-ac23-b292234d4b54" :answer/id #uuid "27c9870f-0506-5064-ac23-b292234d4b54" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f7fcce4d-e5c7-52f8-9d54-5a89dffa0fb6" :answer/id #uuid "f7fcce4d-e5c7-52f8-9d54-5a89dffa0fb6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186234352 :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{sin}⁡x, & x\\le 0 \\\\ \\operatorname{ln}⁡x, & x>0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-2,-1]$\n\nII. $[-1,1]$\n\nIII. $(0,1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-2,-1].$ In this interval, $f(x)=\\operatorname{sin}⁡x$ and so $f(x)$ is continuous on $[-2,-1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Now, consider the interval $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}(\\operatorname{ln}⁡x)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Finally, we note that the interval $(0,1]$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I only\"." :question/answer-fields ["answer-field-488d2faf-a1cd-5796-984d-787dccc3cd23"] :db/ensure [:question/validate]} {:db/id "answer-field-488d2faf-a1cd-5796-984d-787dccc3cd23" :answer-field/id #uuid "488d2faf-a1cd-5796-984d-787dccc3cd23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16834030-119c-50b4-9662-edd5f91fc424" :answer-field/choices ["answer-565b2c1d-8909-5088-ae15-f6d4e0aa6c5f" "answer-16834030-119c-50b4-9662-edd5f91fc424" "answer-d4ef85bf-0c33-54a7-91ff-75cb78a92187" "answer-63422371-897b-542b-9d8a-828fa718a920" "answer-f24c9e76-cd98-5133-8f17-177d55d12f66"] :db/ensure [:answer-field/validate]} {:db/id "answer-565b2c1d-8909-5088-ae15-f6d4e0aa6c5f" :answer/id #uuid "565b2c1d-8909-5088-ae15-f6d4e0aa6c5f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-16834030-119c-50b4-9662-edd5f91fc424" :answer/id #uuid "16834030-119c-50b4-9662-edd5f91fc424" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d4ef85bf-0c33-54a7-91ff-75cb78a92187" :answer/id #uuid "d4ef85bf-0c33-54a7-91ff-75cb78a92187" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-63422371-897b-542b-9d8a-828fa718a920" :answer/id #uuid "63422371-897b-542b-9d8a-828fa718a920" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-f24c9e76-cd98-5133-8f17-177d55d12f66" :answer/id #uuid "f24c9e76-cd98-5133-8f17-177d55d12f66" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186234323 :question/problem "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $-1$ | $4$ | $1$ | $1$ | $-2$ |\n\n$$\n\n$$\n\nFind ${lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x}.$" :question/worked-solution "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x} & ={\\frac{f(x)+x}{g(x)-x}|}_{x=1} \\\\  & =\\frac{f(1)+1}{g(1)-1} \\\\  & =\\frac{-1+1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x} & ={lim}_{x\\to 1}\\frac{(f(x)+x)^{′}}{(g(x)-x)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, but once more, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1} & ={\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1}|}_{x=1} \\\\  & =\\frac{{f}^{′}(1)+1}{{g}^{′}(1)-1} \\\\  & =\\frac{-1+1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nWe apply L'Hopital's rule again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1} & ={lim}_{x\\to 1}\\frac{({f}^{′}(x)+1)^{′}}{({g}^{′}(x)-1)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{″}(x)}{{g}^{″}(x)},\\end{aligned}\n$$\n\nand this time, when we substitute $x=1,$ we are actually able to determine the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{″}(x)}{{g}^{″}(x)} & ={\\frac{{f}^{″}(x)}{{g}^{″}(x)}|}_{x=1} \\\\  & =\\frac{{f}^{″}(1)}{{g}^{″}(1)} \\\\  & =\\frac{4}{-2} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, ${lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x}=-2.$" :question/answer-fields ["answer-field-1708397b-83ae-5c80-89f5-21129d6d07ca"] :db/ensure [:question/validate]} {:db/id "answer-field-1708397b-83ae-5c80-89f5-21129d6d07ca" :answer-field/id #uuid "1708397b-83ae-5c80-89f5-21129d6d07ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ad11e55-5175-51b9-9e8f-656a196e28ab" :answer-field/choices ["answer-9ad11e55-5175-51b9-9e8f-656a196e28ab" "answer-bb74efbe-8eb8-51fd-9a34-c5b2d935c0a9" "answer-0a22e35d-f540-59ba-9ba7-9af1c2046fa7" "answer-4be847b3-c2c0-563c-9815-5338039bfb12" "answer-5a23779b-a5e0-5513-8d10-57ba249075f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ad11e55-5175-51b9-9e8f-656a196e28ab" :answer/id #uuid "9ad11e55-5175-51b9-9e8f-656a196e28ab" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-bb74efbe-8eb8-51fd-9a34-c5b2d935c0a9" :answer/id #uuid "bb74efbe-8eb8-51fd-9a34-c5b2d935c0a9" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-0a22e35d-f540-59ba-9ba7-9af1c2046fa7" :answer/id #uuid "0a22e35d-f540-59ba-9ba7-9af1c2046fa7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4be847b3-c2c0-563c-9815-5338039bfb12" :answer/id #uuid "4be847b3-c2c0-563c-9815-5338039bfb12" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5a23779b-a5e0-5513-8d10-57ba249075f5" :answer/id #uuid "5a23779b-a5e0-5513-8d10-57ba249075f5" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186166866 :knowledge-point/questions ["question-1e5b95a8-8914-5efe-a3ab-4b5dce1c8cbe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1e5b95a8-8914-5efe-a3ab-4b5dce1c8cbe" :question/id #uuid "1e5b95a8-8914-5efe-a3ab-4b5dce1c8cbe" :question/math-academy-id "q-127521" :question/problem "![](images/e7/e74f96531b57a877b043ac4302adae6beef90dc24d64efc8e1a24b563e4738b7.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(-1,2)$ and has semiaxes $4$ and $2,$ its equation is given by\n\n$$\n\\frac{(x-(-1))^{2}}{{4}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}}=1\\,⟹\\,\\frac{(x+1)^{2}}{16}+\\frac{(y-2)^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{16}+\\frac{(y-2)^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{16})+\\frac{\\text{d}}{\\text{d}x}(\\frac{(y-2)^{2}}{4}) & =0 \\\\ \\frac{2(x+1)}{16}+\\frac{2(y-2)}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y-2}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{8} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{4(y-2)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-88db5750-a4d8-5c4f-b26f-ef8a62130a02"] :db/ensure [:question/validate]} {:db/id "answer-field-88db5750-a4d8-5c4f-b26f-ef8a62130a02" :answer-field/id #uuid "88db5750-a4d8-5c4f-b26f-ef8a62130a02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" :answer-field/choices ["answer-4825a0cb-b3fb-5323-8a58-511f26bf6c7d" "answer-6c6a63f8-ed2d-5275-9398-6d460d70e710" "answer-c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" "answer-f7b72652-cf0b-559e-99bc-226911189b88" "answer-7dfcca81-3430-5271-8cd0-80e5d2035124"] :db/ensure [:answer-field/validate]} {:db/id "answer-4825a0cb-b3fb-5323-8a58-511f26bf6c7d" :answer/id #uuid "4825a0cb-b3fb-5323-8a58-511f26bf6c7d" :answer/type :answer.type/math :answer/value "-\\frac{2(y-2)}{x+1}" :db/ensure [:answer/validate]} {:db/id "answer-6c6a63f8-ed2d-5275-9398-6d460d70e710" :answer/id #uuid "6c6a63f8-ed2d-5275-9398-6d460d70e710" :answer/type :answer.type/math :answer/value "-\\frac{4(x+1)}{y-2}" :db/ensure [:answer/validate]} {:db/id "answer-c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" :answer/id #uuid "c5c781b7-f9f3-553f-b0be-cf3d3b1d44f3" :answer/type :answer.type/math :answer/value "-\\frac{x+1}{4(y-2)}" :db/ensure [:answer/validate]} {:db/id "answer-f7b72652-cf0b-559e-99bc-226911189b88" :answer/id #uuid "f7b72652-cf0b-559e-99bc-226911189b88" :answer/type :answer.type/math :answer/value "\\frac{x+1}{2(y-2)}" :db/ensure [:answer/validate]} {:db/id "answer-7dfcca81-3430-5271-8cd0-80e5d2035124" :answer/id #uuid "7dfcca81-3430-5271-8cd0-80e5d2035124" :answer/type :answer.type/math :answer/value "\\frac{y-2}{4(x+1)}" :db/ensure [:answer/validate]} {:db/id 17592186233441 :question/problem "Consider the function $y=\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}.$  The derivative of this function for $x\\in (0,\\pi )$ is given by\n\n$$\n{y}^{′}=\\frac{g(x)\\operatorname{sin}⁡x+h(x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}.\n$$\n\nFind the function $g(x)+h(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x} \\\\  & =\\sqrt{{x}^{2}+6x}\\cdot \\sqrt{{sin}^{2}⁡x} \\\\  & =({x}^{2}+6x)^{1/2}\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+6x)^{1/2}\\operatorname{sin}⁡x) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+6x)^{1/2})+\\operatorname{ln}⁡(\\operatorname{sin}⁡x) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+6x)+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+6x)+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+6x}\\cdot (2x+6)+\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{x+3}{{x}^{2}+6x}+\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{({x}^{2}+6x)\\operatorname{sin}⁡x}) \\\\  & =\\frac{|\\operatorname{sin}⁡x|}{\\operatorname{sin}⁡x}\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nGiven that $x\\in (0,\\pi ),$ then $|\\operatorname{sin}⁡x|=\\operatorname{sin}⁡x,$ so the fraction $\\frac{|\\operatorname{sin}⁡x|}{\\operatorname{sin}⁡x}$ simplifies to $1:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)+h(x)=x+3+{x}^{2}+6x={x}^{2}+7x+3.\n$$" :question/answer-fields ["answer-field-968ccea1-eddc-5df5-b531-eb97516921db"] :db/ensure [:question/validate]} {:db/id "answer-field-968ccea1-eddc-5df5-b531-eb97516921db" :answer-field/id #uuid "968ccea1-eddc-5df5-b531-eb97516921db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f352bcca-38a2-5ecb-8851-59eb03ee8d27" :answer-field/choices ["answer-a0187cce-8b24-5027-bfa7-f2e2f49ae2ea" "answer-63746cd7-d78b-55d9-9dd3-7e1c9980ab08" "answer-8b920ce3-ff7b-5bb6-8fdf-35583cef9643" "answer-a3e1935b-7c69-571c-988f-1bd72cb529a7" "answer-f352bcca-38a2-5ecb-8851-59eb03ee8d27"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0187cce-8b24-5027-bfa7-f2e2f49ae2ea" :answer/id #uuid "a0187cce-8b24-5027-bfa7-f2e2f49ae2ea" :answer/type :answer.type/math :answer/value "-{x}^{2}-5x+3" :db/ensure [:answer/validate]} {:db/id "answer-63746cd7-d78b-55d9-9dd3-7e1c9980ab08" :answer/id #uuid "63746cd7-d78b-55d9-9dd3-7e1c9980ab08" :answer/type :answer.type/math :answer/value "-{x}^{2}-7x+3" :db/ensure [:answer/validate]} {:db/id "answer-8b920ce3-ff7b-5bb6-8fdf-35583cef9643" :answer/id #uuid "8b920ce3-ff7b-5bb6-8fdf-35583cef9643" :answer/type :answer.type/math :answer/value "{x}^{2}+6x+1" :db/ensure [:answer/validate]} {:db/id "answer-a3e1935b-7c69-571c-988f-1bd72cb529a7" :answer/id #uuid "a3e1935b-7c69-571c-988f-1bd72cb529a7" :answer/type :answer.type/math :answer/value "{x}^{2}+6x-3" :db/ensure [:answer/validate]} {:db/id "answer-f352bcca-38a2-5ecb-8851-59eb03ee8d27" :answer/id #uuid "f352bcca-38a2-5ecb-8851-59eb03ee8d27" :answer/type :answer.type/math :answer/value "{x}^{2}+7x+3" :db/ensure [:answer/validate]} {:db/id 17592186233232 :question/answer-fields ["answer-field-beb2aeff-2de4-5697-9623-6df504a488b3"] :db/ensure [:question/validate]} {:db/id "answer-field-beb2aeff-2de4-5697-9623-6df504a488b3" :answer-field/id #uuid "beb2aeff-2de4-5697-9623-6df504a488b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-430337f1-4c86-50c2-883d-98f137d23325" :answer-field/choices ["answer-db253da5-f871-5e99-be8b-c740057241e2" "answer-648432b2-e9e4-5a70-b9af-d8b7b570d17e" "answer-430337f1-4c86-50c2-883d-98f137d23325" "answer-f9406b8a-7827-5235-b885-3b2359724270" "answer-931f54e7-f77f-56ee-ade7-8ea1f562b8ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-db253da5-f871-5e99-be8b-c740057241e2" :answer/id #uuid "db253da5-f871-5e99-be8b-c740057241e2" :answer/type :answer.type/math :answer/value "0.5\\text{ cm/s}" :db/ensure [:answer/validate]} {:db/id "answer-648432b2-e9e4-5a70-b9af-d8b7b570d17e" :answer/id #uuid "648432b2-e9e4-5a70-b9af-d8b7b570d17e" :answer/type :answer.type/math :answer/value "1.25\\text{ cm/s}" :db/ensure [:answer/validate]} {:db/id "answer-430337f1-4c86-50c2-883d-98f137d23325" :answer/id #uuid "430337f1-4c86-50c2-883d-98f137d23325" :answer/type :answer.type/math :answer/value "1.5\\text{ cm/s}" :db/ensure [:answer/validate]} {:db/id "answer-f9406b8a-7827-5235-b885-3b2359724270" :answer/id #uuid "f9406b8a-7827-5235-b885-3b2359724270" :answer/type :answer.type/math :answer/value "1\\text{ cm/s}" :db/ensure [:answer/validate]} {:db/id "answer-931f54e7-f77f-56ee-ade7-8ea1f562b8ab" :answer/id #uuid "931f54e7-f77f-56ee-ade7-8ea1f562b8ab" :answer/type :answer.type/math :answer/value "2.5\\text{ cm/s}" :db/ensure [:answer/validate]} {:db/id 17592186192701 :knowledge-point/questions ["question-3d6689df-3f70-5bf3-89ff-1a1c94f97ed3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3d6689df-3f70-5bf3-89ff-1a1c94f97ed3" :question/id #uuid "3d6689df-3f70-5bf3-89ff-1a1c94f97ed3" :question/math-academy-id "q-149457" :question/problem "The table below gives the values of a positive, continuous function $f(x)$ and its derivative ${f}^{′}(x)$ over the closed interval $[1,9].$\nUsing a right Riemann sum with $4$ equal subintervals, estimate the arc length of the curve $y=f(x)$ between $x=1$ and $x=9.$\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $4$ | $5$ | $\\frac{1}{2}$ | $\\sqrt{2}$ | $1$ |\n| ${f}^{′}(x)$ | $4\\sqrt{5}$ | $0$ | $\\sqrt{3}$ | $0$ | $3\\sqrt{7}$ |\n\n*Hint: The arc length of a smooth curve $y=f(x)$ between $x=a$ and $x=b$ is given by*\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Using the hint, we have that the arc length of a curve $y=f(x)$ between $x=1$ and $x=9$ is given by\n\n$$\nL={\\int }_{1}^{9}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nLet $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{9-1}{4}=2.\n$$\n\nWe can approximate the integral above using a *right* Riemann sum with $4$ equal subintervals and step size $Δx$ as follows:\n\n$$\n{\\int }_{1}^{9}g(x)\\,\\text{d}x≈(g(3)+g(5)+g(7)+g(9))\\cdot Δx\n$$\n\nNow, we set up a table with values of $g(x)$ at each point:\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}(x)$ | $4\\sqrt{5}$ | $0$ | $\\sqrt{3}$ | $0$ | $3\\sqrt{7}$ |\n| $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}$ | $9$ | $1$ | $2$ | $1$ | $8$ |\n\nFinally, we obtain the following approximation for our arc length:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{9}g(x)\\,\\text{d}x \\\\  & ≈(g(3)+g(5)+g(7)+g(9))\\cdot Δx \\\\  & =(1+2+1+8)\\cdot 2 \\\\  & =12\\cdot 2 \\\\  & =24\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-760fdca6-77da-5dd9-9d65-02c5cce92a93"] :db/ensure [:question/validate]} {:db/id "answer-field-760fdca6-77da-5dd9-9d65-02c5cce92a93" :answer-field/id #uuid "760fdca6-77da-5dd9-9d65-02c5cce92a93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b66b271-9507-58e9-99e0-0fe7ede3639c" :answer-field/choices ["answer-a5810297-ae4c-5cce-8442-330c69509540" "answer-6b66b271-9507-58e9-99e0-0fe7ede3639c" "answer-b8d689b2-11ba-5108-abea-16bbe6fc4773" "answer-e2aa52af-fca4-533c-a616-407168a944a1" "answer-4c714b33-004b-5d9e-9053-a9b7a733a681"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5810297-ae4c-5cce-8442-330c69509540" :answer/id #uuid "a5810297-ae4c-5cce-8442-330c69509540" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-6b66b271-9507-58e9-99e0-0fe7ede3639c" :answer/id #uuid "6b66b271-9507-58e9-99e0-0fe7ede3639c" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-b8d689b2-11ba-5108-abea-16bbe6fc4773" :answer/id #uuid "b8d689b2-11ba-5108-abea-16bbe6fc4773" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-e2aa52af-fca4-533c-a616-407168a944a1" :answer/id #uuid "e2aa52af-fca4-533c-a616-407168a944a1" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-4c714b33-004b-5d9e-9053-a9b7a733a681" :answer/id #uuid "4c714b33-004b-5d9e-9053-a9b7a733a681" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id 17592186078604 :knowledge-point/questions ["question-82a6bab7-1298-5d9a-9389-41a0c015118d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-82a6bab7-1298-5d9a-9389-41a0c015118d" :question/id #uuid "82a6bab7-1298-5d9a-9389-41a0c015118d" :question/math-academy-id "q-48021" :question/problem "Approximate the value of $\\sqrt{37}$ using the tangent line approximation of $f(x)=\\sqrt{x}$ at $x=36.$" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=36,$ which gives\n\n$$\nL(x)=f(36)+{f}^{′}(36)(x-36).\n$$\n\nLet's compute $f(36)$ and ${f}^{′}(36)$ in the expression above. Evaluating the function, we get\n\n$$\nf(36)=\\sqrt{36}=6,\n$$\n\nand computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})=\\frac{1}{2\\sqrt{x}},\\end{aligned}\n$$\n\nwhich in turn gives\n\n$$\n{f}^{′}(36)=\\frac{1}{2\\sqrt{36}}=\\frac{1}{12}.\n$$\n\nSo, the tangent line approximation is\n\n$$\n\\begin{aligned}L(x)=6+\\frac{1}{12}(x-36).\\end{aligned}\n$$\n\nWe can approximate $\\sqrt{37}$ by evaluating the tangent line approximation at $x=37.$ We get\n\n$$\n\\begin{aligned}\\sqrt{37} & ≈L(37) \\\\  & =6+\\frac{1}{12}(37-36) \\\\  & =6+\\frac{1}{12} \\\\  & =\\frac{73}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c29dba39-a035-580c-9c90-3ddf062b8c8f"] :db/ensure [:question/validate]} {:db/id "answer-field-c29dba39-a035-580c-9c90-3ddf062b8c8f" :answer-field/id #uuid "c29dba39-a035-580c-9c90-3ddf062b8c8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1ddda751-0d34-586d-b038-e0a01f2febc8" :answer-field/choices ["answer-6892d97d-bead-5f58-8dab-7c42339644ff" "answer-5cd61015-89c7-5df8-8f7f-0199795bc4d4" "answer-1ddda751-0d34-586d-b038-e0a01f2febc8" "answer-59169e9d-9262-57e2-9d1d-79d1fb530ef4" "answer-f65ed173-c910-51ea-9f87-39503a1ad9ff"] :db/ensure [:answer-field/validate]} {:db/id "answer-6892d97d-bead-5f58-8dab-7c42339644ff" :answer/id #uuid "6892d97d-bead-5f58-8dab-7c42339644ff" :answer/type :answer.type/math :answer/value "\\frac{111}{16}" :db/ensure [:answer/validate]} {:db/id "answer-5cd61015-89c7-5df8-8f7f-0199795bc4d4" :answer/id #uuid "5cd61015-89c7-5df8-8f7f-0199795bc4d4" :answer/type :answer.type/math :answer/value "\\frac{71}{12}" :db/ensure [:answer/validate]} {:db/id "answer-1ddda751-0d34-586d-b038-e0a01f2febc8" :answer/id #uuid "1ddda751-0d34-586d-b038-e0a01f2febc8" :answer/type :answer.type/math :answer/value "\\frac{73}{12}" :db/ensure [:answer/validate]} {:db/id "answer-59169e9d-9262-57e2-9d1d-79d1fb530ef4" :answer/id #uuid "59169e9d-9262-57e2-9d1d-79d1fb530ef4" :answer/type :answer.type/math :answer/value "\\frac{89}{15}" :db/ensure [:answer/validate]} {:db/id "answer-f65ed173-c910-51ea-9f87-39503a1ad9ff" :answer/id #uuid "f65ed173-c910-51ea-9f87-39503a1ad9ff" :answer/type :answer.type/math :answer/value "\\frac{91}{15}" :db/ensure [:answer/validate]} {:db/id 17592186100831 :knowledge-point/questions ["question-1508af35-4265-5067-b707-b4b8e57d8d0a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1508af35-4265-5067-b707-b4b8e57d8d0a" :question/id #uuid "1508af35-4265-5067-b707-b4b8e57d8d0a" :question/math-academy-id "q-82180" :question/problem "Which of the following could be the graph of a continuous function $f(x)$ that satisfies the conditions below?\n\n- ${f}^{′}(x)$ and ${f}^{″}(x)$ are undefined at $x=1$\n\n- if $x\\in (-\\infty ,1)$ then ${f}^{′}(x)<0$ and if $x\\in (1,\\infty )$ then ${f}^{′}(x)>0$\n\n- if $x\\in (-\\infty ,1)$ then ${f}^{″}(x)<0$ and if $x\\in (1,\\infty )$ then ${f}^{″}(x)>0$" :question/worked-solution "We summarize all the given information in the following table:\n\n| $x$ | $(-\\infty ,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $\\text{undef.}$ | $+$ |\n| ${f}^{″}$ | $-$ | $\\text{undef.}$ | $+$ |\n| $f$ | $↘\\,\\,⌢$ | $\\text{min}$ | $↗\\,\\,⌣$ |\n\nNow, let's sketch our graph: \n\n- We draw a point on the vertical line $x=1$, where the derivative is undefined.\n\n- Since $x=1$ is a local minimum, the graph must go up to the left and to the right of that point.\n\n- The graph must be concave down on $(-\\infty ,1)$ and concave up on $(1,\\infty ).$\n\n- Finally, we are told that the function is continuous.\n\nTherefore, a possible graph of $f$ could be as follows:\n\n![](images/0b/0b08e02b0999da13ec71b2fee4e2df4a8754f54d99cb711e6ff19c7a81ace9de.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f07b5cf1-c779-56d4-b26c-f37aa9c40d28"] :db/ensure [:question/validate]} {:db/id "answer-field-f07b5cf1-c779-56d4-b26c-f37aa9c40d28" :answer-field/id #uuid "f07b5cf1-c779-56d4-b26c-f37aa9c40d28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fffeff41-bc47-5ab4-9e5b-8411914a2274" :answer-field/choices ["answer-fffeff41-bc47-5ab4-9e5b-8411914a2274" "answer-60cd0cb8-cfc6-5e75-8468-3dd21d19f8b5" "answer-c94e71de-8159-5a0b-84e3-25e2cb48b3f2" "answer-9db8e3c3-8688-5ec4-8963-e4d97827cacf" "answer-a63e6117-ba6b-5a37-b61a-9b783a96b0a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-fffeff41-bc47-5ab4-9e5b-8411914a2274" :answer/id #uuid "fffeff41-bc47-5ab4-9e5b-8411914a2274" :answer/type :answer.type/image :answer/value "images/1e/1ecf03e6020276f37e6186c052d3463aa7b039806e204e018e938ab9896665fb.png" :db/ensure [:answer/validate]} {:db/id "answer-60cd0cb8-cfc6-5e75-8468-3dd21d19f8b5" :answer/id #uuid "60cd0cb8-cfc6-5e75-8468-3dd21d19f8b5" :answer/type :answer.type/image :answer/value "images/2c/2cebc6d4e2a93fac67aa135952f283ba2e5780ec920db28b4e9dc0a280ca2284.png" :db/ensure [:answer/validate]} {:db/id "answer-c94e71de-8159-5a0b-84e3-25e2cb48b3f2" :answer/id #uuid "c94e71de-8159-5a0b-84e3-25e2cb48b3f2" :answer/type :answer.type/image :answer/value "images/78/78a1f253f739855621f6b615d3c0f558ad35e020e5d7216d2bd45aaa24ecc957.png" :db/ensure [:answer/validate]} {:db/id "answer-9db8e3c3-8688-5ec4-8963-e4d97827cacf" :answer/id #uuid "9db8e3c3-8688-5ec4-8963-e4d97827cacf" :answer/type :answer.type/image :answer/value "images/b1/b1b2ad9ee747fd3b33582d02e2a9e70de87027d9266ba8ac5b4b5c7f1fff696c.png" :db/ensure [:answer/validate]} {:db/id "answer-a63e6117-ba6b-5a37-b61a-9b783a96b0a1" :answer/id #uuid "a63e6117-ba6b-5a37-b61a-9b783a96b0a1" :answer/type :answer.type/image :answer/value "images/b5/b5c5ed1dc6a8597603258dae636334d91324f4636fbbdf18cb8b2c8a919c1e62.png" :db/ensure [:answer/validate]} {:db/id 17592186100845 :knowledge-point/questions ["question-4ce61c51-3f39-5f7e-96d5-a322aa4a1799"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4ce61c51-3f39-5f7e-96d5-a322aa4a1799" :question/id #uuid "4ce61c51-3f39-5f7e-96d5-a322aa4a1799" :question/math-academy-id "q-118923" :question/problem "Consider a right triangle inscribed in a semicircle of radius\n$6.$ If the hypotenuse of the triangle lies along the diameter of the semicircle, what is the greatest possible perimeter of the triangle?" :question/worked-solution "We first draw a picture of the situation:\n\n![](images/41/417b284c87f735eb0c33f2369262b1548f9c54ff27ecbeb7880e91e9bc847f31.png)\n\nLet's call $l$ the length of one of the legs. By the Pythagorean theorem, the length of the other leg is $\\sqrt{144-{l}^{2}}.$\n\nTherefore, the perimeter is given by\n\n$$\n\\begin{aligned}P(l) & =12+l+\\sqrt{144-{l}^{2}}.\\end{aligned}\n$$\n\nSince $l$ is the length of a leg of a right triangle whose hypotenuse is $12,$ the permitted range of $l$ is $0<l<12.$\n\nWe want to maximize $P(l),$ so we need to compute the critical points. Taking the derivative, we get\n\n$$\n\\begin{aligned}{P}^{′}(l) & =1+\\frac{1}{2}\\cdot \\frac{-2l}{\\sqrt{144-{l}^{2}}} \\\\  & =1-\\frac{l}{\\sqrt{144-{l}^{2}}},\\end{aligned}\n$$\n\nand solving ${P}^{′}(l)=0$ gives the following critical point:\n\n$$\n\\begin{aligned}{P}^{′}(l) & =0 \\\\ 1-\\frac{l}{\\sqrt{144-{l}^{2}}} & =0 \\\\ \\frac{l}{\\sqrt{144-{l}^{2}}} & =1 \\\\ \\sqrt{144-{l}^{2}} & =l \\\\ 144-{l}^{2} & ={l}^{2} \\\\ 2{l}^{2} & =144 \\\\ {l}^{2} & =72 \\\\ l & =6\\sqrt{2}\\end{aligned}\n$$\n\nAll that's left now is to confirm that $l=6\\sqrt{2}$ does indeed give a maximum value of $P(l).$ To do this, we use the first derivative test. We write up a table of values:\n\n| Interval | $(0,6\\sqrt{2})$ | $6\\sqrt{2}$ | $(6\\sqrt{2},12)$ |\n| --- | --- | --- | --- |\n| Test Point | $1$ | $$ | $9$ |\n| ${P}^{′}$ | $+$ | $0$ | $-$ |\n| $P$ | $↗$ | $\\text{max}$ | $↘$ |\n\nSo, $l=6\\sqrt{2}$ does indeed give a maximum, and the perimeter of the resulting triangle will be the largest possible.\n\nTherefore, the greatest perimeter that a triangle can have is\n\n$$\n\\begin{aligned}P(6\\sqrt{2}) & =12+6\\sqrt{2}+\\sqrt{144-(6\\sqrt{2})^{2}} \\\\  & =12+6\\sqrt{2}+\\sqrt{144-72} \\\\  & =12+6\\sqrt{2}+\\sqrt{72} \\\\  & =12+6\\sqrt{2}+6\\sqrt{2} \\\\  & =12+12\\sqrt{2} \\\\  & =12(1+\\sqrt{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1c040818-e74b-5b00-9b27-984282da1f0b"] :db/ensure [:question/validate]} {:db/id "answer-field-1c040818-e74b-5b00-9b27-984282da1f0b" :answer-field/id #uuid "1c040818-e74b-5b00-9b27-984282da1f0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b102511-7ce6-5667-8a9e-af99d880f397" :answer-field/choices ["answer-748328ef-0f70-5abe-be70-fdf38563a350" "answer-6b102511-7ce6-5667-8a9e-af99d880f397" "answer-ff1796f3-aef2-54bc-967e-df5e4e0f94d9" "answer-58c242a0-360d-5c3f-a206-335a5f11f547" "answer-b6f56cd5-1bd4-5680-9418-30409996f34c"] :db/ensure [:answer-field/validate]} {:db/id "answer-748328ef-0f70-5abe-be70-fdf38563a350" :answer/id #uuid "748328ef-0f70-5abe-be70-fdf38563a350" :answer/type :answer.type/math :answer/value "12(1+2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-6b102511-7ce6-5667-8a9e-af99d880f397" :answer/id #uuid "6b102511-7ce6-5667-8a9e-af99d880f397" :answer/type :answer.type/math :answer/value "12(1+\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-ff1796f3-aef2-54bc-967e-df5e4e0f94d9" :answer/id #uuid "ff1796f3-aef2-54bc-967e-df5e4e0f94d9" :answer/type :answer.type/math :answer/value "12\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-58c242a0-360d-5c3f-a206-335a5f11f547" :answer/id #uuid "58c242a0-360d-5c3f-a206-335a5f11f547" :answer/type :answer.type/math :answer/value "3(1+2\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "answer-b6f56cd5-1bd4-5680-9418-30409996f34c" :answer/id #uuid "b6f56cd5-1bd4-5680-9418-30409996f34c" :answer/type :answer.type/math :answer/value "6(2+\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id 17592186100826 :knowledge-point/questions ["question-0ea6bbbd-4b7d-5900-9086-5360a21a6636"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0ea6bbbd-4b7d-5900-9086-5360a21a6636" :question/id #uuid "0ea6bbbd-4b7d-5900-9086-5360a21a6636" :question/math-academy-id "q-79412" :question/problem "![](images/3c/3cff4fddd4ae530a233a4f667b3fc84cc2109914a59dda332cbcc8bd5838a516.png)\n\nThe graph of the function $y={f}^{′}(x)$, the derivative of $y=f(x)$, is shown above. Which of the following could be the graph of $y={f}^{″}(x)?$" :question/worked-solution "First, if we denote $g(x)={f}^{′}(x)$ then ${f}^{″}(x)={g}^{′}(x).$ So, we need to sketch the graph of $y={g}^{′}(x)$ given the graph of $y=g(x),$ as usual.\n\nNotice the following:\n\n- At the stationary points, where the tangent line to $y=g(x)$ is parallel to the $x$-axis, we have ${g}^{′}(x)=0.$\n\n- When $g(x)$ is increasing, we have ${g}^{′}(x)>0.$\n\n- When $g(x)$ is decreasing, we have ${g}^{′}(x)<0.$\n\nWe can now summarize the information from the graph in the table below. Note that the stationary points were identified (approximately) from the graph of $y={g}^{′}(x)$:\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,0)$ | $0$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g$ | $↗$ | $\\text{max}$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ |\n| ${g}^{′}$ | $+$ | $0$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n\nAdditionally, the function $y=g(x)$ has inflection points at $x≈-0.5$ and $x≈0.5.$ At the inflection points, we have ${g}^{″}(x)=0,$ so the tangent to the graph of $y={g}^{′}(x)$ must be parallel to the $x$-axis at $x≈-0.5$ and $x≈0.5.$\n\nWe don't know the exact values of ${g}^{′}(-0.5)$ and ${g}^{′}(0.5)$, but from the graph of $y=g(x)$ we find that the slope of the tangents to ${g}^{′}(x)$ at $x≈-0.5$ and $x≈0.5$ are negative and positive, respectively. \n\nTherefore, the graph of $y={g}^{′}(x)={f}^{″}(x)$ may look as shown below.\n\n![](images/b5/b5cdb9170fbf8521bddc184d7a58cf0666ed9ad7d6323407ba1f518c59a9ede9.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-28d76c14-c77d-5f6f-b333-af9e5bb2acd4"] :db/ensure [:question/validate]} {:db/id "answer-field-28d76c14-c77d-5f6f-b333-af9e5bb2acd4" :answer-field/id #uuid "28d76c14-c77d-5f6f-b333-af9e5bb2acd4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e670a4e-c1d6-5a75-a485-a130dfb0dd9a" :answer-field/choices ["answer-38b71195-e7d1-54ed-96b8-6998a9d3fd62" "answer-8b25af1e-9e5d-5a85-9cce-824bd044b2fc" "answer-fd89e3b3-68d8-5eee-acba-d1d3b7eb731c" "answer-2e670a4e-c1d6-5a75-a485-a130dfb0dd9a" "answer-99251cbf-8178-51ff-96b3-c3adf56969e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-38b71195-e7d1-54ed-96b8-6998a9d3fd62" :answer/id #uuid "38b71195-e7d1-54ed-96b8-6998a9d3fd62" :answer/type :answer.type/image :answer/value "images/08/0836910fb50c56022a624a3c98701d8f818c20246e0c6b368543414d8fdc388e.png" :db/ensure [:answer/validate]} {:db/id "answer-8b25af1e-9e5d-5a85-9cce-824bd044b2fc" :answer/id #uuid "8b25af1e-9e5d-5a85-9cce-824bd044b2fc" :answer/type :answer.type/image :answer/value "images/24/242c86c451468306416606ac87e8e1af324d5290b981a530c0fe671cd84603da.png" :db/ensure [:answer/validate]} {:db/id "answer-fd89e3b3-68d8-5eee-acba-d1d3b7eb731c" 