54e7-8734-5135-9af9-664cad8ca414" "answer-c7fa432d-1e24-5a86-b227-9bd8e7f5ffaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-daa57dc6-1f16-5e29-96c2-37eb66dd98de" :answer/id #uuid "daa57dc6-1f16-5e29-96c2-37eb66dd98de" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-52f8b7f2-814b-52b7-8406-e6c27493120e" :answer/id #uuid "52f8b7f2-814b-52b7-8406-e6c27493120e" :answer/type :answer.type/math :answer/value "-100" :db/ensure [:answer/validate]} {:db/id "answer-65eac8e3-d47a-5916-a461-305de8d9c4b5" :answer/id #uuid "65eac8e3-d47a-5916-a461-305de8d9c4b5" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-586654e7-8734-5135-9af9-664cad8ca414" :answer/id #uuid "586654e7-8734-5135-9af9-664cad8ca414" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-c7fa432d-1e24-5a86-b227-9bd8e7f5ffaa" :answer/id #uuid "c7fa432d-1e24-5a86-b227-9bd8e7f5ffaa" :answer/type :answer.type/math :answer/value "1000" :db/ensure [:answer/validate]} {:db/id 17592186134406 :question/problem "$(-15)^{2}=$" :question/worked-solution "Since the product of two negative numbers gives a positive number, we have\n\n$$\n(-15)^{2}=(-15)\\cdot (-15)=15\\cdot 15\n$$\n\nNext, we calculate $15\\cdot 15:$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(-15)^{2}={15}^{2}=225.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186132475 :answer-field/correct 17592186132476 :db/ensure [:answer-field/validate]} {:db/id "activity-26dc73c3-a573-5ce4-b269-7e050d805860" :activity/id #uuid "26dc73c3-a573-5ce4-b269-7e050d805860" :activity/title "Squaring Rational Numbers" :activity/type :activity.type/review :activity/scope 17592186050428 :activity/course 17592186046648 :activity/steps ["step-044c8258-6998-590f-acbe-62a40481c0e9" "step-2eb80d86-6678-5a3e-88d9-4f420dd31528" "step-56ee66c4-5700-5c25-bdef-89a28b53c5bc"] :activity/first-step "step-044c8258-6998-590f-acbe-62a40481c0e9" :db/ensure [:activity/validate]} {:db/id "step-044c8258-6998-590f-acbe-62a40481c0e9" :step/id #uuid "044c8258-6998-590f-acbe-62a40481c0e9" :step/content "question-14d93e8f-2ff1-562e-a35c-f8de5c3818d2" :step/next "step-2eb80d86-6678-5a3e-88d9-4f420dd31528" :db/ensure [:step/validate]} {:db/id "step-2eb80d86-6678-5a3e-88d9-4f420dd31528" :step/id #uuid "2eb80d86-6678-5a3e-88d9-4f420dd31528" :step/content "question-dffd7631-0175-532f-861a-5fc5f04bbe69" :step/next "step-56ee66c4-5700-5c25-bdef-89a28b53c5bc" :db/ensure [:step/validate]} {:db/id "step-56ee66c4-5700-5c25-bdef-89a28b53c5bc" :step/id #uuid "56ee66c4-5700-5c25-bdef-89a28b53c5bc" :step/content 17592186134406 :db/ensure [:step/validate]} {:db/id 17592186064381 :knowledge-point/questions ["question-e8399078-36ec-5b21-87c0-73ffc0d26600" "question-3340fda4-31bb-56af-bac8-5dcbd67440f2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e8399078-36ec-5b21-87c0-73ffc0d26600" :question/id #uuid "e8399078-36ec-5b21-87c0-73ffc0d26600" :question/math-academy-id "q-2550" :question/problem "![](images/97/976db172587f6acdc7af6e426b01adf477e86ef731ce92939e122e291b53337b.png)\n\nA hot air balloon is inflated at the rate of $12\\,{\\text{in}}^{3}\\text{/s}.$ How fast is the radius, $r$, changing at the moment when $r=2\\,\\text{in}?$" :question/worked-solution "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=12\\,{\\text{in}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=2\\,\\text{in}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=12$ and $r=2,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (2)^{2} \\\\ 12 & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 16\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{3}{4\\pi }.\\end{aligned}\n$$\n\nTherefore, the radius of the balloon is decreasing at a rate of $\\frac{3}{4\\pi }\\,\\text{in}/\\text{s}$ when the radius is $2\\,\\text{in}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a61e3d80-f1fd-5eef-8661-45e65506ae2a"] :db/ensure [:question/validate]} {:db/id "answer-field-a61e3d80-f1fd-5eef-8661-45e65506ae2a" :answer-field/id #uuid "a61e3d80-f1fd-5eef-8661-45e65506ae2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-12cb41b0-01ea-5c46-86e5-04b8117b3dc4" :answer-field/choices ["answer-d5ad83a5-b560-5894-9b06-c5bb1a83e3ac" "answer-22fcb82c-2909-591f-be60-e9e88a12eb5a" "answer-67a91bd3-65bd-58c2-86c6-7c75df5bee1a" "answer-12cb41b0-01ea-5c46-86e5-04b8117b3dc4" "answer-7d1966ac-a96b-5e2d-9d3c-63f6e79e8a9d"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5ad83a5-b560-5894-9b06-c5bb1a83e3ac" :answer/id #uuid "d5ad83a5-b560-5894-9b06-c5bb1a83e3ac" :answer/type :answer.type/math :answer/value "4\\pi \\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-22fcb82c-2909-591f-be60-e9e88a12eb5a" :answer/id #uuid "22fcb82c-2909-591f-be60-e9e88a12eb5a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }\\,\\text{in}\\text{/s}" :db/ensure [:answer/validate]} {:db/id "answer-67a91bd3-65bd-58c2-86c6-7c75df5bee1a" :answer/id #uuid "67a91bd3-65bd-58c2-86c6-7c75df5bee1a" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{4}\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-12cb41b0-01ea-5c46-86e5-04b8117b3dc4" :answer/id #uuid "12cb41b0-01ea-5c46-86e5-04b8117b3dc4" :answer/type :answer.type/math :answer/value "\\frac{3}{4\\pi }\\,\\text{in/s}" :db/ensure [:answer/validate]} {:db/id "answer-7d1966ac-a96b-5e2d-9d3c-63f6e79e8a9d" :answer/id #uuid "7d1966ac-a96b-5e2d-9d3c-63f6e79e8a9d" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\,\\text{in}\\text{/s}" :db/ensure [:answer/validate]} {:db/id 17592186064379 :knowledge-point/questions ["question-37194e35-397f-5f0f-b8ce-0e1f1331cb3b" "question-d9d699d5-e68c-517c-8c66-c0218f7be321"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3340fda4-31bb-56af-bac8-5dcbd67440f2" :question/id #uuid "3340fda4-31bb-56af-bac8-5dcbd67440f2" :question/math-academy-id "q-116730" :question/problem "A spherical hot air balloon is inflated. At a particular moment, the rate of increase in the volume of the balloon is numerically equal to nine-halfs the rate of increase in its surface area. What is the radius of the balloon at that moment?" :question/worked-solution "Let $r$ be the radius of the balloon, $V$ the volume, and $A$ its surface area. We wish to find $r$ at the moment when $\\frac{\\text{d}V}{\\text{d}t}=\\frac{9}{2}\\frac{\\text{d}A}{\\text{d}t}.$\n\nTo start, let's set up an equation relating the volume $V$ and the surface area $A$ of the sphere. Since $A=4\\pi {r}^{2}$ and $V=\\frac{4\\pi }{3}{r}^{3},$ the relationship between $V$ and $A$ is\n\n$$\nV=\\frac{4\\pi }{3}{r}^{3}=\\frac{4\\pi }{3}{(\\frac{A}{4\\pi })}^{3/2}=\\frac{{A}^{3/2}}{3(4\\pi )^{1/2}}=\\frac{{A}^{3/2}}{6\\sqrt{\\pi }}.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{A}^{3/2}}{6\\sqrt{\\pi }}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}A}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}A}(\\frac{{A}^{3/2}}{6\\sqrt{\\pi }}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}A}{\\text{d}t}\\cdot \\frac{{A}^{1/2}}{4\\sqrt{\\pi }}.\\end{aligned}\n$$\n\nNow, since $\\frac{\\text{d}V}{\\text{d}t}=\\frac{9}{2}\\frac{\\text{d}A}{\\text{d}t},$ we have\n\n$$\n\\begin{aligned}\\frac{9}{2}\\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}A}{\\text{d}t}\\cdot \\frac{{A}^{1/2}}{4\\sqrt{\\pi }} \\\\ {A}^{1/2} & =18\\sqrt{\\pi } \\\\ A & ={(18\\sqrt{\\pi })}^{2} \\\\ A & =324\\pi .\\end{aligned}\n$$\n\nLastly, since $A=4\\pi {r}^{2},$ we have\n\n$$\n\\begin{aligned}4\\pi {r}^{2} & =324\\pi  \\\\ {r}^{2} & =81 \\\\ r & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-893ce6e9-d2a5-5687-890a-43b20d335c93"] :db/ensure [:question/validate]} {:db/id "answer-field-893ce6e9-d2a5-5687-890a-43b20d335c93" :answer-field/id #uuid "893ce6e9-d2a5-5687-890a-43b20d335c93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3ab0c31-9934-5df4-8de8-4658ed227b1a" :answer-field/choices ["answer-5ad7d797-78b2-528c-9d9b-806dc635caa2" "answer-8c834b34-6910-5d98-ab6c-76660ea17f16" "answer-03e5c2fc-62c3-5cff-8c3f-12578ac7eec2" "answer-4bd9e9ba-35f5-5dc8-b23d-1b83df5ca67c" "answer-a3ab0c31-9934-5df4-8de8-4658ed227b1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ad7d797-78b2-528c-9d9b-806dc635caa2" :answer/id #uuid "5ad7d797-78b2-528c-9d9b-806dc635caa2" :answer/type :answer.type/math :answer/value "1.5\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-8c834b34-6910-5d98-ab6c-76660ea17f16" :answer/id #uuid "8c834b34-6910-5d98-ab6c-76660ea17f16" :answer/type :answer.type/math :answer/value "12.5\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-03e5c2fc-62c3-5cff-8c3f-12578ac7eec2" :answer/id #uuid "03e5c2fc-62c3-5cff-8c3f-12578ac7eec2" :answer/type :answer.type/math :answer/value "2.5\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-4bd9e9ba-35f5-5dc8-b23d-1b83df5ca67c" :answer/id #uuid "4bd9e9ba-35f5-5dc8-b23d-1b83df5ca67c" :answer/type :answer.type/math :answer/value "4.5\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-a3ab0c31-9934-5df4-8de8-4658ed227b1a" :answer/id #uuid "a3ab0c31-9934-5df4-8de8-4658ed227b1a" :answer/type :answer.type/math :answer/value "9\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "question-37194e35-397f-5f0f-b8ce-0e1f1331cb3b" :question/id #uuid "37194e35-397f-5f0f-b8ce-0e1f1331cb3b" :question/math-academy-id "q-344726" :question/problem "![](images/1c/1c16496b13f9ad9fc995cc59dedf1777f25e394ca61dd2ea493d8bd8f69c5e14.png)\n\nPaint dripping onto a floor forms a circular puddle. The radius of the puddle increases at a rate of $10\\,\\text{in/min}.$ How fast is the area of the puddle increasing at the moment when the radius is $\\frac{9}{4\\pi }\\,\\text{in}?$\n\nThe area of the puddle is increasing at a rate of\n{{field-1}} ${\\text{in}}^{2}\\text{/min}.$" :question/worked-solution "In this situation, we want to find $\\frac{\\text{d}A}{\\text{d}t}$ at the moment when $r=\\frac{9}{4\\pi },$ and we are also told that $\\frac{\\text{d}r}{\\text{d}t}=10.$\n\nTo start, let's write down the area formula for the circle and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi r.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=10$ and $r=\\frac{9}{4\\pi },$ and solve for $\\frac{\\text{d}A}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =10\\cdot 2\\pi (\\frac{9}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =45.\\end{aligned}\n$$\n\nWe conclude that the area of the puddle is increasing at a rate of $45\\,{\\text{in}}^{2}\\text{/min}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-22d1d24c-d1f3-5b29-bd9f-d25502738b67"] :db/ensure [:question/validate]} {:db/id "answer-field-22d1d24c-d1f3-5b29-bd9f-d25502738b67" :answer-field/id #uuid "22d1d24c-d1f3-5b29-bd9f-d25502738b67" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7482730a-2ef8-51f5-a35d-2f7208beda4e" :answer-field/choices ["answer-7482730a-2ef8-51f5-a35d-2f7208beda4e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7482730a-2ef8-51f5-a35d-2f7208beda4e" :answer/id #uuid "7482730a-2ef8-51f5-a35d-2f7208beda4e" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "question-d9d699d5-e68c-517c-8c66-c0218f7be321" :question/id #uuid "d9d699d5-e68c-517c-8c66-c0218f7be321" :question/math-academy-id "q-344727" :question/problem "![](images/95/95e09441c0ab651a759862d3689aee517d089a43d2089697a1b77882de1e5d73.png)\n\nWater leaking onto a patio forms a circular pool. The radius of the pool increases at a rate of $3\\,\\text{m/min}.$ How fast is the area of the pool increasing at the moment when the radius is $\\frac{5}{2\\pi }\\,\\text{m}?$\n\nThe area of the pool is increasing at a rate of\n{{field-1}} ${\\text{m}}^{2}\\text{/min}.$" :question/worked-solution "In this situation, we want to find $\\frac{\\text{d}A}{\\text{d}t}$ at the moment when $r=\\frac{5}{2\\pi },$ and we are also told that $\\frac{\\text{d}r}{\\text{d}t}=3.$\n\nTo start, let's write down the area formula for the circle and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi r.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=3$ and $r=\\frac{5}{2\\pi },$ and solve for $\\frac{\\text{d}A}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =3\\cdot 2\\pi (\\frac{5}{2\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =15.\\end{aligned}\n$$\n\nWe conclude that the area of the pool is increasing at a rate of $15\\,{\\text{m}}^{2}\\text{/min}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-70fdc4f0-4261-5d00-b2fa-9b5690965424"] :db/ensure [:question/validate]} {:db/id "answer-field-70fdc4f0-4261-5d00-b2fa-9b5690965424" :answer-field/id #uuid "70fdc4f0-4261-5d00-b2fa-9b5690965424" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f09fc632-c551-511d-b5ff-0a2ef83dfc99" :answer-field/choices ["answer-f09fc632-c551-511d-b5ff-0a2ef83dfc99"] :db/ensure [:answer-field/validate]} {:db/id "answer-f09fc632-c551-511d-b5ff-0a2ef83dfc99" :answer/id #uuid "f09fc632-c551-511d-b5ff-0a2ef83dfc99" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "activity-2a8712d4-6984-598d-9326-16635a3b14bc" :activity/id #uuid "2a8712d4-6984-598d-9326-16635a3b14bc" :activity/title "Calculating Related Rates With Circles and Spheres" :activity/type :activity.type/review :activity/scope 17592186050411 :activity/course 17592186046644 :activity/steps ["step-fe01ad7d-1637-5e4b-88cb-7874304a764d" "step-bdda543f-34f7-5aaf-9190-3fecab0d3532" "step-a9bc4ee9-11ca-5a48-8b4d-0b8a2d853ce7" "step-f7e7553f-61e4-5efb-b004-ea189584c1c2" "step-04cf9317-baff-533e-bded-bc0975c757e1"] :activity/first-step "step-fe01ad7d-1637-5e4b-88cb-7874304a764d" :db/ensure [:activity/validate]} {:db/id "step-fe01ad7d-1637-5e4b-88cb-7874304a764d" :step/id #uuid "fe01ad7d-1637-5e4b-88cb-7874304a764d" :step/content "question-e8399078-36ec-5b21-87c0-73ffc0d26600" :step/next "step-bdda543f-34f7-5aaf-9190-3fecab0d3532" :db/ensure [:step/validate]} {:db/id "step-bdda543f-34f7-5aaf-9190-3fecab0d3532" :step/id #uuid "bdda543f-34f7-5aaf-9190-3fecab0d3532" :step/content 17592186369203 :step/next "step-a9bc4ee9-11ca-5a48-8b4d-0b8a2d853ce7" :db/ensure [:step/validate]} {:db/id "step-a9bc4ee9-11ca-5a48-8b4d-0b8a2d853ce7" :step/id #uuid "a9bc4ee9-11ca-5a48-8b4d-0b8a2d853ce7" :step/content "question-3340fda4-31bb-56af-bac8-5dcbd67440f2" :step/next "step-f7e7553f-61e4-5efb-b004-ea189584c1c2" :db/ensure [:step/validate]} {:db/id "step-f7e7553f-61e4-5efb-b004-ea189584c1c2" :step/id #uuid "f7e7553f-61e4-5efb-b004-ea189584c1c2" :step/content "question-37194e35-397f-5f0f-b8ce-0e1f1331cb3b" :step/next "step-04cf9317-baff-533e-bded-bc0975c757e1" :db/ensure [:step/validate]} {:db/id "step-04cf9317-baff-533e-bded-bc0975c757e1" :step/id #uuid "04cf9317-baff-533e-bded-bc0975c757e1" :step/content "question-d9d699d5-e68c-517c-8c66-c0218f7be321" :db/ensure [:step/validate]} {:db/id 17592186073743 :knowledge-point/questions ["question-a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f" :question/id #uuid "a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f" :question/math-academy-id "q-52959" :question/problem "Consider a triangle $△ABC,$ where $m∠C={90}^{∘}$, $m∠B=5x$ and $m∠A=x.$  Determine the value of $x.$" :question/worked-solution "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}{90}^{∘}+5x+x & ={180}^{∘} \\\\ {90}^{∘}+6x & ={180}^{∘} \\\\ 6x & ={90}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c9cd39b4-8f64-5987-b24f-823849f1e540"] :db/ensure [:question/validate]} {:db/id "answer-field-c9cd39b4-8f64-5987-b24f-823849f1e540" :answer-field/id #uuid "c9cd39b4-8f64-5987-b24f-823849f1e540" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2bc48f0d-cf97-57e5-b754-75ef64300c8d" :answer-field/choices ["answer-2bc48f0d-cf97-57e5-b754-75ef64300c8d" "answer-290c548b-c3c3-5628-aa5a-ac5099056fee" "answer-577eb998-b617-5fd0-ad2f-5345b0832fc8" "answer-aff69b7a-deee-5b22-ab6d-06c966782673" "answer-a896245b-b333-522d-8269-32007289480b"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bc48f0d-cf97-57e5-b754-75ef64300c8d" :answer/id #uuid "2bc48f0d-cf97-57e5-b754-75ef64300c8d" :answer/type :answer.type/math :answer/value "{15}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-290c548b-c3c3-5628-aa5a-ac5099056fee" :answer/id #uuid "290c548b-c3c3-5628-aa5a-ac5099056fee" :answer/type :answer.type/math :answer/value "{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-577eb998-b617-5fd0-ad2f-5345b0832fc8" :answer/id #uuid "577eb998-b617-5fd0-ad2f-5345b0832fc8" :answer/type :answer.type/math :answer/value "{45}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-aff69b7a-deee-5b22-ab6d-06c966782673" :answer/id #uuid "aff69b7a-deee-5b22-ab6d-06c966782673" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a896245b-b333-522d-8269-32007289480b" :answer/id #uuid "a896245b-b333-522d-8269-32007289480b" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186073742 :knowledge-point/questions ["question-8ed94581-861e-525e-ad7d-f6e47b0ded92"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8ed94581-861e-525e-ad7d-f6e47b0ded92" :question/id #uuid "8ed94581-861e-525e-ad7d-f6e47b0ded92" :question/math-academy-id "q-67734" :question/problem "![](images/67/671faf1efc8d64c4db563140d6d9bc8e080c1591eef92d44a5d7f381be115c95.png)\n\nFind the measure of angle $B.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{27}^{∘}+3x+(5x+{9}^{∘}) & ={180}^{∘} \\\\ {36}^{∘}+8x & ={180}^{∘} \\\\ 8x & ={144}^{∘} \\\\ x & ={18}^{∘}\\end{aligned}\n$$\n\nTherefore,\n\n$$\nm∠B=5x+{9}^{∘}=5({18}^{∘})+{9}^{∘}={99}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-acd2ba71-e40b-5b2c-8be7-8057e874f2c0"] :db/ensure [:question/validate]} {:db/id "answer-field-acd2ba71-e40b-5b2c-8be7-8057e874f2c0" :answer-field/id #uuid "acd2ba71-e40b-5b2c-8be7-8057e874f2c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be7c7d3d-4561-511b-b47f-dda2a95bacea" :answer-field/choices ["answer-b6ab8f41-6eaa-57b5-b1f6-d7874a04825c" "answer-bf6334e8-2413-5414-b886-62651d4edeba" "answer-82e33c43-c908-5a3f-984d-b2b02dcb3adb" "answer-cd1796c6-7878-5185-b51f-1ab525ee36ef" "answer-be7c7d3d-4561-511b-b47f-dda2a95bacea"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6ab8f41-6eaa-57b5-b1f6-d7874a04825c" :answer/id #uuid "b6ab8f41-6eaa-57b5-b1f6-d7874a04825c" :answer/type :answer.type/math :answer/value "{106}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-bf6334e8-2413-5414-b886-62651d4edeba" :answer/id #uuid "bf6334e8-2413-5414-b886-62651d4edeba" :answer/type :answer.type/math :answer/value "{109}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-82e33c43-c908-5a3f-984d-b2b02dcb3adb" :answer/id #uuid "82e33c43-c908-5a3f-984d-b2b02dcb3adb" :answer/type :answer.type/math :answer/value "{95}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-cd1796c6-7878-5185-b51f-1ab525ee36ef" :answer/id #uuid "cd1796c6-7878-5185-b51f-1ab525ee36ef" :answer/type :answer.type/math :answer/value "{97}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-be7c7d3d-4561-511b-b47f-dda2a95bacea" :answer/id #uuid "be7c7d3d-4561-511b-b47f-dda2a95bacea" :answer/type :answer.type/math :answer/value "{99}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186073744 :knowledge-point/questions ["question-e9dc1df9-d4f7-5877-9eec-28947f9d3962"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e9dc1df9-d4f7-5877-9eec-28947f9d3962" :question/id #uuid "e9dc1df9-d4f7-5877-9eec-28947f9d3962" :question/math-academy-id "q-116727" :question/problem "![](images/69/69245c30b32f12e59a5f57f2e8fb17c7374726ffd6db10726cb508727f66c409.png)\n\nFind the measure of angle $B$ given that $m∠A=m∠C.$" :question/worked-solution "Using $m∠A=m∠C,$ we get\n\n$$\n\\begin{aligned}m∠A & =m∠C \\\\ 3z+{20}^{∘} & =4z \\\\ z & ={20}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $z={20}^{∘}$ in the expression for $m∠C,$ we get\n\n$$\nm∠C=4({20}^{∘})={80}^{∘}.\n$$\n\nNow, we can find $m∠B$ using the fact that the internal angles of any triangle sum to ${180}^{∘}$:\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+2m∠C & ={180}^{∘} \\\\ m∠B+2\\cdot {80}^{∘} & ={180}^{∘} \\\\ m∠B+{160}^{∘} & ={180}^{∘} \\\\ m∠B & ={20}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d3bfce62-88f0-5b8e-beb5-ecf87f7a30ad"] :db/ensure [:question/validate]} {:db/id "answer-field-d3bfce62-88f0-5b8e-beb5-ecf87f7a30ad" :answer-field/id #uuid "d3bfce62-88f0-5b8e-beb5-ecf87f7a30ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-215914b0-2451-52ec-9701-ffbe8d9894d3" :answer-field/choices ["answer-3b1eafad-ed83-5dac-870a-8b0bca34caa8" "answer-8361a8e7-c4ac-5439-98e5-4797a5503bc0" "answer-215914b0-2451-52ec-9701-ffbe8d9894d3" "answer-9f85dcf7-d001-5073-8ed4-fa98397e59c8" "answer-9dddfcd0-8eb9-5ebd-9a05-f90a810f094b"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b1eafad-ed83-5dac-870a-8b0bca34caa8" :answer/id #uuid "3b1eafad-ed83-5dac-870a-8b0bca34caa8" :answer/type :answer.type/math :answer/value "{15}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-8361a8e7-c4ac-5439-98e5-4797a5503bc0" :answer/id #uuid "8361a8e7-c4ac-5439-98e5-4797a5503bc0" :answer/type :answer.type/math :answer/value "{18}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-215914b0-2451-52ec-9701-ffbe8d9894d3" :answer/id #uuid "215914b0-2451-52ec-9701-ffbe8d9894d3" :answer/type :answer.type/math :answer/value "{20}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-9f85dcf7-d001-5073-8ed4-fa98397e59c8" :answer/id #uuid "9f85dcf7-d001-5073-8ed4-fa98397e59c8" :answer/type :answer.type/math :answer/value "{23}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-9dddfcd0-8eb9-5ebd-9a05-f90a810f094b" :answer/id #uuid "9dddfcd0-8eb9-5ebd-9a05-f90a810f094b" :answer/type :answer.type/math :answer/value "{25}^{∘}" :db/ensure [:answer/validate]} {:db/id "activity-70f3ba64-46c6-5c7b-8a26-30ff5c2e8921" :activity/id #uuid "70f3ba64-46c6-5c7b-8a26-30ff5c2e8921" :activity/title "Interior Angles of Triangles" :activity/type :activity.type/review :activity/scope 17592186049949 :activity/course 17592186046648 :activity/steps ["step-62ab666f-6480-566e-aca2-60c89a11dcc4" "step-7199ec83-6eb5-50ad-a3dc-decf07fc55b0" "step-a880f21b-6654-5782-a317-e615d90fad77"] :activity/first-step "step-62ab666f-6480-566e-aca2-60c89a11dcc4" :db/ensure [:activity/validate]} {:db/id "step-62ab666f-6480-566e-aca2-60c89a11dcc4" :step/id #uuid "62ab666f-6480-566e-aca2-60c89a11dcc4" :step/content "question-a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f" :step/next "step-7199ec83-6eb5-50ad-a3dc-decf07fc55b0" :db/ensure [:step/validate]} {:db/id "step-7199ec83-6eb5-50ad-a3dc-decf07fc55b0" :step/id #uuid "7199ec83-6eb5-50ad-a3dc-decf07fc55b0" :step/content "question-8ed94581-861e-525e-ad7d-f6e47b0ded92" :step/next "step-a880f21b-6654-5782-a317-e615d90fad77" :db/ensure [:step/validate]} {:db/id "step-a880f21b-6654-5782-a317-e615d90fad77" :step/id #uuid "a880f21b-6654-5782-a317-e615d90fad77" :step/content "question-e9dc1df9-d4f7-5877-9eec-28947f9d3962" :db/ensure [:step/validate]} [:db/retract 17592186184815 :question/answer-fields 17592186183499] [:db/retract 17592186183487 :answer-field/choices 17592186183488] [:db/retract 17592186183487 :answer-field/choices 17592186183489] [:db/retract 17592186183487 :answer-field/choices 17592186183490] [:db/retract 17592186183487 :answer-field/choices 17592186183491] [:db/retract 17592186183487 :answer-field/choices 17592186183492] [:db/retract 17592186183493 :answer-field/choices 17592186183494] [:db/retract 17592186183493 :answer-field/choices 17592186183495] [:db/retract 17592186183493 :answer-field/choices 17592186183496] [:db/retract 17592186183493 :answer-field/choices 17592186183497] [:db/retract 17592186183493 :answer-field/choices 17592186183498] {:db/id 17592186184232 :knowledge-point/questions ["question-1724c4ea-89ed-51e2-a2bf-8d02f0f074fa" "question-cca814ca-cf90-5add-8be7-53a49b278718"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184191 :knowledge-point/questions ["question-2236615a-502f-5e6f-8a3b-d0bb2e05f4c6" "question-6f9c9fb5-398b-5a72-983c-e3a77bff1e92"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184192 :knowledge-point/questions ["question-6c6b5462-ae7e-592e-8c21-3452425e7810"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1724c4ea-89ed-51e2-a2bf-8d02f0f074fa" :question/id #uuid "1724c4ea-89ed-51e2-a2bf-8d02f0f074fa" :question/math-academy-id "q-141806" :question/problem "Solve the equation $4{x}^{2}-8x=5.$ \n\n*Hint: Use the fact that ${x}^{2}-2x+1$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-2x+1=(x-1)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}-8x & =5 \\\\ 4({x}^{2}-2x) & =5 \\\\ 4({x}^{2}-2\\cdot 1x) & =5 \\\\ 4({x}^{2}-2\\cdot 1x+{1}^{2}-{1}^{2}) & =5 \\\\ 4[(x-1)^{2}-{1}^{2}] & =5 \\\\ 4[(x-1)^{2}-1] & =5 \\\\ 4(x-1)^{2}-4 & =5\\end{aligned}\n$$\n\nIsolating the perfect square by adding $4$ to both sides and then dividing by $4,$ we get\n\n$$\n\\begin{aligned}4(x-1)^{2}-4 & =5 \\\\ 4(x-1)^{2}-4+4 & =5+4 \\\\ 4(x-1)^{2} & =9 \\\\ (x-1)^{2} & =\\frac{9}{4}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{9}{4} \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{\\frac{9}{4}} \\\\ |x-1| & =\\frac{3}{2} \\\\ x-1 & =\\pm \\frac{3}{2} \\\\ x & =1\\pm \\frac{3}{2} \\\\ x & =-\\frac{1}{2},\\,\\frac{5}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e38d1eab-b846-57b1-8eca-3e79f6301a02"] :db/ensure [:question/validate]} {:db/id "answer-field-e38d1eab-b846-57b1-8eca-3e79f6301a02" :answer-field/id #uuid "e38d1eab-b846-57b1-8eca-3e79f6301a02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ab5c423-17d6-5038-a462-ea15f5b2e87d" :answer-field/choices ["answer-fc5e520c-9345-5603-92aa-5989d3118aeb" "answer-9ab5c423-17d6-5038-a462-ea15f5b2e87d" "answer-cb0938db-92c7-585b-8cbd-31116bc33d89" "answer-bd51cecd-6c04-520f-9fa4-54a69b142f90" "answer-a9a5c631-15ae-5872-945b-175674fabfa0"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc5e520c-9345-5603-92aa-5989d3118aeb" :answer/id #uuid "fc5e520c-9345-5603-92aa-5989d3118aeb" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2},\\,-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9ab5c423-17d6-5038-a462-ea15f5b2e87d" :answer/id #uuid "9ab5c423-17d6-5038-a462-ea15f5b2e87d" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2},\\,\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-cb0938db-92c7-585b-8cbd-31116bc33d89" :answer/id #uuid "cb0938db-92c7-585b-8cbd-31116bc33d89" :answer/type :answer.type/math :answer/value "x=1\\pm \\frac{1}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "answer-bd51cecd-6c04-520f-9fa4-54a69b142f90" :answer/id #uuid "bd51cecd-6c04-520f-9fa4-54a69b142f90" :answer/type :answer.type/math :answer/value "x=1\\pm \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-a9a5c631-15ae-5872-945b-175674fabfa0" :answer/id #uuid "a9a5c631-15ae-5872-945b-175674fabfa0" :answer/type :answer.type/math :answer/value "x=\\frac{3}{2},\\,\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-cca814ca-cf90-5add-8be7-53a49b278718" :question/id #uuid "cca814ca-cf90-5add-8be7-53a49b278718" :question/math-academy-id "q-218766" :question/problem "Solve the equation $9{x}^{2}-18x=7.$  Write the solutions in ascending order.\n\n*Hint: Use the fact that ${x}^{2}-2x+1$ is a perfect square.*\n\n$\\,{x}_{1}=$\n{{field-1}} $,\\,{x}_{2}=$\n{{field-2}}" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-2x+1=(x-1)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}9{x}^{2}-18x & =7 \\\\ 9({x}^{2}-2x) & =7 \\\\ 9({x}^{2}-2\\cdot 1x) & =7 \\\\ 9({x}^{2}-2\\cdot 1y+{1}^{2}-{1}^{2}) & =7 \\\\ 9[(x-1)^{2}-{1}^{2}] & =7 \\\\ 9[(x-1)^{2}-1] & =7 \\\\ 9(x-1)^{2}-9 & =7\\end{aligned}\n$$\n\nIsolating the perfect square by adding $9$ to both sides and then dividing by $9$, we get\n\n$$\n\\begin{aligned}9(x-1)^{2}-9 & =7 \\\\ 9(x-1)^{2}-9+9 & =7+9 \\\\ 9(x-1)^{2} & =16 \\\\ (x-1)^{2} & =\\frac{16}{9}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{16}{9} \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{\\frac{16}{9}} \\\\ |x-1| & =\\frac{4}{3} \\\\ x-1 & =\\pm \\frac{4}{3} \\\\ x & =1\\pm \\frac{4}{3} \\\\ x & =-\\frac{1}{3},\\frac{7}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63bb1ee1-44d2-5a8b-a0ff-8a61b2d8e549" "answer-field-fd21be66-27be-55af-af71-359acfb6c6dc"] :db/ensure [:question/validate]} {:db/id "answer-field-63bb1ee1-44d2-5a8b-a0ff-8a61b2d8e549" :answer-field/id #uuid "63bb1ee1-44d2-5a8b-a0ff-8a61b2d8e549" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9dc7b935-bf72-53f8-affa-266bf6c23916" :answer-field/choices ["answer-9dc7b935-bf72-53f8-affa-266bf6c23916"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dc7b935-bf72-53f8-affa-266bf6c23916" :answer/id #uuid "9dc7b935-bf72-53f8-affa-266bf6c23916" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-fd21be66-27be-55af-af71-359acfb6c6dc" :answer-field/id #uuid "fd21be66-27be-55af-af71-359acfb6c6dc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a4b1d8eb-b6f3-5cda-88d1-2fdad4eeb482" :answer-field/choices ["answer-a4b1d8eb-b6f3-5cda-88d1-2fdad4eeb482"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4b1d8eb-b6f3-5cda-88d1-2fdad4eeb482" :answer/id #uuid "a4b1d8eb-b6f3-5cda-88d1-2fdad4eeb482" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "question-2236615a-502f-5e6f-8a3b-d0bb2e05f4c6" :question/id #uuid "2236615a-502f-5e6f-8a3b-d0bb2e05f4c6" :question/math-academy-id "q-35049" :question/problem "The equation $3{z}^{2}-12=9z$ can be written in the form $(z+p)^{2}=q.$ Find $\\,p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}3{z}^{2}-12 & =9z \\\\ 3{z}^{2}-9z-12 & =0 \\\\ 3({z}^{2}-3z-4) & =0 \\\\ {z}^{2}-3z-4 & =0 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2} & =4 \\\\ {z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{(\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =-4 \\\\ [{z}^{2}-2\\cdot z\\cdot \\frac{3}{2}+{(\\frac{3}{2})}^{2}]-{(\\frac{3}{2})}^{2} & =-4 \\\\ {(z-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =4 \\\\ {(z-\\frac{3}{2})}^{2}-\\frac{25}{4} & =0\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(z-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2} & =4 \\\\ {(z-\\frac{3}{2})}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nSo, $p=-\\frac{3}{2},q=\\frac{25}{4}$ and $p+q=\\frac{19}{4}.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}{(z-\\frac{3}{2})}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{(z-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |z-\\frac{3}{2}| & =\\frac{5}{2} \\\\ z-\\frac{3}{2} & =\\pm \\frac{5}{2} \\\\ z & =\\frac{3}{2}\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}z & =\\frac{3}{2}+\\frac{5}{2}=4 \\\\ z & =\\frac{3}{2}-\\frac{5}{2}=-1\\end{aligned}\n$$\n\nTherefore, the solutions are $z=4$ and $z=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9418bd8b-7dee-502f-b277-9872940fd25e"] :db/ensure [:question/validate]} {:db/id "answer-field-9418bd8b-7dee-502f-b277-9872940fd25e" :answer-field/id #uuid "9418bd8b-7dee-502f-b277-9872940fd25e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0eb231a-0f38-50bf-8cf9-3768fa9ab226" :answer-field/choices ["answer-854c086c-10d6-59fc-a728-734ed635b82f" "answer-6fc9c0e4-94e6-5a58-b402-1569ccdf0546" "answer-f0eb231a-0f38-50bf-8cf9-3768fa9ab226" "answer-9dedfe61-c595-5e0a-ab8d-634757cce0c0" "answer-a3b96d21-d357-5674-892a-42feaf9e8b50"] :db/ensure [:answer-field/validate]} {:db/id "answer-854c086c-10d6-59fc-a728-734ed635b82f" :answer/id #uuid "854c086c-10d6-59fc-a728-734ed635b82f" :answer/type :answer.type/text :answer/value "$p+q=-\\frac{19}{4},\\,z=4$ and $z=-1$" :db/ensure [:answer/validate]} {:db/id "answer-6fc9c0e4-94e6-5a58-b402-1569ccdf0546" :answer/id #uuid "6fc9c0e4-94e6-5a58-b402-1569ccdf0546" :answer/type :answer.type/text :answer/value "$p+q=\\frac{19}{4},\\,z=-4$ and $z=1$" :db/ensure [:answer/validate]} {:db/id "answer-f0eb231a-0f38-50bf-8cf9-3768fa9ab226" :answer/id #uuid "f0eb231a-0f38-50bf-8cf9-3768fa9ab226" :answer/type :answer.type/text :answer/value "$p+q=\\frac{19}{4},\\,z=4$ and $z=-1$" :db/ensure [:answer/validate]} {:db/id "answer-9dedfe61-c595-5e0a-ab8d-634757cce0c0" :answer/id #uuid "9dedfe61-c595-5e0a-ab8d-634757cce0c0" :answer/type :answer.type/text :answer/value "$p+q=\\frac{25}{4},\\,z=-4$ and $z=-1$" :db/ensure [:answer/validate]} {:db/id "answer-a3b96d21-d357-5674-892a-42feaf9e8b50" :answer/id #uuid "a3b96d21-d357-5674-892a-42feaf9e8b50" :answer/type :answer.type/text :answer/value "$p+q=\\frac{3}{4},\\,z=4$ and $z=-7$" :db/ensure [:answer/validate]} {:db/id "question-6f9c9fb5-398b-5a72-983c-e3a77bff1e92" :question/id #uuid "6f9c9fb5-398b-5a72-983c-e3a77bff1e92" :question/math-academy-id "q-218773" :question/problem "By completing the square, the equation $3{x}^{2}+12x+8=0$ is equivalent to\n\n$\\,\\,3(x\\,\\,+$\n{{field-1}}$)^{2}=$\n{{field-2}}." :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}3{x}^{2}+12x+8 & =0 \\\\ 3{x}^{2}+12x & =-8 \\\\ 3({x}^{2}+4x) & =-8 \\\\ 3[{x}^{2}+2\\cdot 2x+{(2)}^{2}-{(2)}^{2}] & -8 \\\\ 3[{(x+2)}^{2}-4] & =-8\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}3{(x+2)}^{2}-3\\cdot 4 & =-8 \\\\ 3{(x+2)}^{2}-12 & =-8 \\\\ 3{(x+2)}^{2} & =-8+12 \\\\ 3{(x+2)}^{2} & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f81580ec-b17d-59a4-8b79-db833bfb273c" "answer-field-6292167a-5bc6-5c4a-8390-f09eba2cfd71"] :db/ensure [:question/validate]} {:db/id "answer-field-f81580ec-b17d-59a4-8b79-db833bfb273c" :answer-field/id #uuid "f81580ec-b17d-59a4-8b79-db833bfb273c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-079234a2-8e4a-5862-b049-dbc5bc0a3653" :answer-field/choices ["answer-079234a2-8e4a-5862-b049-dbc5bc0a3653"] :db/ensure [:answer-field/validate]} {:db/id "answer-079234a2-8e4a-5862-b049-dbc5bc0a3653" :answer/id #uuid "079234a2-8e4a-5862-b049-dbc5bc0a3653" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-6292167a-5bc6-5c4a-8390-f09eba2cfd71" :answer-field/id #uuid "6292167a-5bc6-5c4a-8390-f09eba2cfd71" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-82580df0-052c-5542-a737-2921e6a984bb" :answer-field/choices ["answer-82580df0-052c-5542-a737-2921e6a984bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-82580df0-052c-5542-a737-2921e6a984bb" :answer/id #uuid "82580df0-052c-5542-a737-2921e6a984bb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186184813 :question/problem "The equation $5{x}^{2}+2x-3=0$ can be written in the form $5(x+p)^{2}=q.$ Find $q-p.$" :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}5{x}^{2}+2x-3 & =0 \\\\ 5{x}^{2}+2x & =3 \\\\ 5{x}^{2}+2x & =3 \\\\ 5({x}^{2}+\\frac{2}{5}x) & =3 \\\\ 5[{x}^{2}+2\\cdot \\frac{1}{5}x+{(\\frac{1}{5})}^{2}-{(\\frac{1}{5})}^{2}] & =3 \\\\ 5[{(x+\\frac{1}{5})}^{2}-\\frac{1}{25}] & =3\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}5{(x+\\frac{1}{5})}^{2}-5\\cdot \\frac{1}{25} & =3 \\\\ 5{(x+\\frac{1}{5})}^{2}-\\frac{1}{5} & =3 \\\\ 5{(x+\\frac{1}{5})}^{2} & =3+\\frac{1}{5} \\\\ 5{(x+\\frac{1}{5})}^{2} & =\\frac{16}{5}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{1}{5}$ and $q=\\frac{16}{5}.$ Finally,\n\n$$\nq-p=\\frac{16}{5}-\\frac{1}{5}=\\frac{15}{5}=3.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186183487 :answer-field/correct "answer-d75d4ab0-4dfc-5974-92a8-1f8911001872" :answer-field/choices ["answer-eb226441-7167-55d6-90f6-42c6f33cce44" "answer-d75d4ab0-4dfc-5974-92a8-1f8911001872" "answer-1ef3962e-a6bb-5a67-a558-58cd427de315" "answer-b5d4b756-0892-5fb7-92ca-8db3da31c1e4" "answer-33d18b14-4374-57fc-bccd-ad6999325131"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb226441-7167-55d6-90f6-42c6f33cce44" :answer/id #uuid "eb226441-7167-55d6-90f6-42c6f33cce44" :answer/type :answer.type/math :answer/value "q-p=2" :db/ensure [:answer/validate]} {:db/id "answer-d75d4ab0-4dfc-5974-92a8-1f8911001872" :answer/id #uuid "d75d4ab0-4dfc-5974-92a8-1f8911001872" :answer/type :answer.type/math :answer/value "q-p=3" :db/ensure [:answer/validate]} {:db/id "answer-1ef3962e-a6bb-5a67-a558-58cd427de315" :answer/id #uuid "1ef3962e-a6bb-5a67-a558-58cd427de315" :answer/type :answer.type/math :answer/value "q-p=4" :db/ensure [:answer/validate]} {:db/id "answer-b5d4b756-0892-5fb7-92ca-8db3da31c1e4" :answer/id #uuid "b5d4b756-0892-5fb7-92ca-8db3da31c1e4" :answer/type :answer.type/math :answer/value "q-p=5" :db/ensure [:answer/validate]} {:db/id "answer-33d18b14-4374-57fc-bccd-ad6999325131" :answer/id #uuid "33d18b14-4374-57fc-bccd-ad6999325131" :answer/type :answer.type/math :answer/value "q-p=6" :db/ensure [:answer/validate]} {:db/id "question-6c6b5462-ae7e-592e-8c21-3452425e7810" :question/id #uuid "6c6b5462-ae7e-592e-8c21-3452425e7810" :question/math-academy-id "q-60363" :question/problem "The equation $-4{x}^{2}-6x+10=0$ can be written in the form $4(x+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{x}^{2}-6x+10) & =(-1)\\cdot 0 \\\\ 4{x}^{2}+6x-10 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+6x-10 & =0 \\\\ 4{x}^{2}+6x & =10 \\\\ 4{x}^{2}+6x & =10 \\\\ 4({x}^{2}+\\frac{3}{2}x) & =10 \\\\ 4[{x}^{2}+2\\cdot \\frac{3}{4}x+{(\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =10 \\\\ 4[{(x+\\frac{3}{4})}^{2}-\\frac{9}{16}] & =10\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2}-4\\cdot \\frac{9}{16} & =10 \\\\ 4{(x+\\frac{3}{4})}^{2}-\\frac{9}{4} & =10 \\\\ 4{(x+\\frac{3}{4})}^{2} & =10+\\frac{9}{4} \\\\ 4{(x+\\frac{3}{4})}^{2} & =\\frac{49}{4}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{3}{4}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2} & =\\frac{49}{4} \\\\ {(x+\\frac{3}{4})}^{2} & =\\frac{49}{16} \\\\ \\sqrt{{(x+\\frac{3}{4})}^{2}} & =\\sqrt{\\frac{49}{16}} \\\\ |x+\\frac{3}{4}| & =\\frac{7}{4} \\\\ x+\\frac{3}{4} & =\\pm \\frac{7}{4} \\\\ x & =-\\frac{3}{4}\\pm \\frac{7}{4}.\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-\\frac{3}{4}-\\frac{7}{4}=-\\frac{10}{4}=-\\frac{5}{2} \\\\ x & =-\\frac{3}{4}+\\frac{7}{4}=1\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5}{2}$ and $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dcb7d856-8042-5bbe-be63-7001e1b25a2c"] :db/ensure [:question/validate]} {:db/id "answer-field-dcb7d856-8042-5bbe-be63-7001e1b25a2c" :answer-field/id #uuid "dcb7d856-8042-5bbe-be63-7001e1b25a2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2393a4d4-762d-5560-9226-5a0e216dec51" :answer-field/choices ["answer-a5ee5ca9-ea89-54cd-839a-29262cd0a71a" "answer-8910933f-a80b-5b82-961d-2627b5f5280c" "answer-f62dae0d-aa09-5a1e-b79c-fc4344431af4" "answer-0d50330c-784c-5a84-ac1e-5c7c5be92530" "answer-2393a4d4-762d-5560-9226-5a0e216dec51"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5ee5ca9-ea89-54cd-839a-29262cd0a71a" :answer/id #uuid "a5ee5ca9-ea89-54cd-839a-29262cd0a71a" :answer/type :answer.type/text :answer/value "$p=\\frac{3}{2},\\,x=-1$ and $x=-\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-8910933f-a80b-5b82-961d-2627b5f5280c" :answer/id #uuid "8910933f-a80b-5b82-961d-2627b5f5280c" :answer/type :answer.type/text :answer/value "$p=\\frac{3}{2},\\,x=-\\frac{5}{2}$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-f62dae0d-aa09-5a1e-b79c-fc4344431af4" :answer/id #uuid "f62dae0d-aa09-5a1e-b79c-fc4344431af4" :answer/type :answer.type/text :answer/value "$p=\\frac{3}{4},\\,x=-\\frac{1}{2}$ and $x=\\frac{3}{4}$" :db/ensure [:answer/validate]} {:db/id "answer-0d50330c-784c-5a84-ac1e-5c7c5be92530" :answer/id #uuid "0d50330c-784c-5a84-ac1e-5c7c5be92530" :answer/type :answer.type/text :answer/value "$p=\\frac{3}{4},\\,x=-\\frac{1}{4}$ and $x=\\frac{13}{4}$" :db/ensure [:answer/validate]} {:db/id "answer-2393a4d4-762d-5560-9226-5a0e216dec51" :answer/id #uuid "2393a4d4-762d-5560-9226-5a0e216dec51" :answer/type :answer.type/text :answer/value "$p=\\frac{3}{4},\\,x=-\\frac{5}{2}$ and $x=1$" :db/ensure [:answer/validate]} {:db/id 17592186184814 :question/problem "The equation $-5{x}^{2}+5x-1=0$ can be written in the form $5(x+p)^{2}=q.$ Find $q.$" :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-5{x}^{2}+5x-1) & =(-1)\\cdot 0 \\\\ 5{x}^{2}-5x+1 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}5{x}^{2}-5x+1 & =0 \\\\ 5{x}^{2}-5x & =-1 \\\\ 5({x}^{2}-x) & =-1 \\\\ 5[{x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}] & =-1 \\\\ 5[{(x-\\frac{1}{2})}^{2}-\\frac{1}{4}] & =-1\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}5{(x-\\frac{1}{2})}^{2}-5\\cdot \\frac{1}{4} & =-1 \\\\ 5{(x-\\frac{1}{2})}^{2}-\\frac{5}{4} & =-1 \\\\ 5{(x-\\frac{1}{2})}^{2} & =-1+\\frac{5}{4} \\\\ 5{(x-\\frac{1}{2})}^{2} & =\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, $p=-\\frac{1}{2}$ and $q=\\frac{1}{4}.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186183493 :answer-field/correct "answer-b34d4a38-3be9-5e99-9a2a-f46dac84f6db" :answer-field/choices ["answer-51247d6a-6677-500b-b718-1c064593b669" "answer-83912612-984f-5701-9ae3-68c22057a433" "answer-bca3e5a5-72f7-53a4-98d8-5a74a18fa611" "answer-b34d4a38-3be9-5e99-9a2a-f46dac84f6db" "answer-30938dcd-6958-5d27-99ab-ac151ecf0f4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-51247d6a-6677-500b-b718-1c064593b669" :answer/id #uuid "51247d6a-6677-500b-b718-1c064593b669" :answer/type :answer.type/math :answer/value "q=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-83912612-984f-5701-9ae3-68c22057a433" :answer/id #uuid "83912612-984f-5701-9ae3-68c22057a433" :answer/type :answer.type/math :answer/value "q=-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-bca3e5a5-72f7-53a4-98d8-5a74a18fa611" :answer/id #uuid "bca3e5a5-72f7-53a4-98d8-5a74a18fa611" :answer/type :answer.type/math :answer/value "q=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b34d4a38-3be9-5e99-9a2a-f46dac84f6db" :answer/id #uuid "b34d4a38-3be9-5e99-9a2a-f46dac84f6db" :answer/type :answer.type/math :answer/value "q=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-30938dcd-6958-5d27-99ab-ac151ecf0f4b" :answer/id #uuid "30938dcd-6958-5d27-99ab-ac151ecf0f4b" :answer/type :answer.type/math :answer/value "q=\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id 17592186184433 :activity/expected-seconds 1140.0 :db/ensure [:activity/validate]} [:db/retract 17592186310836 :answer-field/choices 17592186309462] [:db/retract 17592186311044 :answer-field/choices 17592186309899] {:db/id 17592186311559 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=5y(t) \\\\ {y}^{′}(t)=-5x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(5t) & \\operatorname{sin}⁡(5t) \\\\ -\\operatorname{sin}⁡(5t) & \\operatorname{cos}⁡(5t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 5 \\\\ -5 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"150px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186311400 :answer-field/correct "answer-2633b2d1-98e4-54f9-bd3d-9d6754122e46" :answer-field/choices ["answer-2633b2d1-98e4-54f9-bd3d-9d6754122e46"] :db/ensure [:answer-field/validate]} {:db/id "answer-2633b2d1-98e4-54f9-bd3d-9d6754122e46" :answer/id #uuid "2633b2d1-98e4-54f9-bd3d-9d6754122e46" :answer/type :answer.type/math :answer/value "-3\\cos(5t)+\\sin(5t)" :db/ensure [:answer/validate]} {:db/id 17592186311008 :answer-field/correct "answer-ce0f7ff2-63f3-536e-a712-0b2b5f23cf38" :answer-field/choices ["answer-ce0f7ff2-63f3-536e-a712-0b2b5f23cf38"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce0f7ff2-63f3-536e-a712-0b2b5f23cf38" :answer/id #uuid "ce0f7ff2-63f3-536e-a712-0b2b5f23cf38" :answer/type :answer.type/math :answer/value "3\\sin(5t)+\\cos(5t)" :db/ensure [:answer/validate]} {:db/id 17592186311560 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-7y(t) \\\\ {y}^{′}(t)=7x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & -\\operatorname{sin}⁡(7t) \\\\ \\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -7 \\\\ 7 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"170px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186310929 :answer-field/correct "answer-979f156d-01a6-59f8-8aca-1c984d058959" :answer-field/choices ["answer-979f156d-01a6-59f8-8aca-1c984d058959"] :db/ensure [:answer-field/validate]} {:db/id "answer-979f156d-01a6-59f8-8aca-1c984d058959" :answer/id #uuid "979f156d-01a6-59f8-8aca-1c984d058959" :answer/type :answer.type/math :answer/value "-2\\cos(7t)-3\\sin(7t)" :db/ensure [:answer/validate]} {:db/id 17592186311182 :answer-field/correct "answer-2678d709-b8ee-55e1-bb84-a652beb39148" :answer-field/choices ["answer-2678d709-b8ee-55e1-bb84-a652beb39148"] :db/ensure [:answer-field/validate]} {:db/id "answer-2678d709-b8ee-55e1-bb84-a652beb39148" :answer/id #uuid "2678d709-b8ee-55e1-bb84-a652beb39148" :answer/type :answer.type/math :answer/value "-2\\sin(7t)+3\\cos(7t)" :db/ensure [:answer/validate]} {:db/id 17592186229682 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3x(t)+y(t) \\\\ {y}^{′}(t)=-3y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{aligned}],$ where $A=[\\begin{aligned}-3 & 1 \\\\ 0 & -3\\end{aligned}].$*" :db/ensure [:question/validate]} {:db/id 17592186391586 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3y(t) \\\\ {y}^{′}(t)=-3x(t),\\end{aligned}\\,[\\begin{aligned}x(-1) \\\\ y(-1)\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & -\\operatorname{sinh}⁡(3t) \\\\ -\\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -3 \\\\ -3 & 0\\end{aligned}].$*" :db/ensure [:question/validate]} {:db/id 17592186310836 :answer-field/correct 17592186308934 :db/ensure [:answer-field/validate]} {:db/id 17592186311044 :answer-field/correct 17592186309155 :db/ensure [:answer-field/validate]} {:db/id "activity-6fa36af2-6f1b-58e0-aae4-87fdba06bbc7" :activity/id #uuid "6fa36af2-6f1b-58e0-aae4-87fdba06bbc7" :activity/title "Solving Homogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186048231 :activity/course 17592186046644 :activity/steps ["step-2c32e12b-7fa9-5de5-ab65-67b39782d31e" "step-1b4443f1-0280-5047-9471-acc341316636" "step-9b0fd3c3-6109-5d52-8875-92b52299b80a" "step-27866c4a-22d7-5b58-972c-cfe8b9d40b47" "step-323902b1-2dc9-5b75-a6de-c749bb49c955"] :activity/first-step "step-2c32e12b-7fa9-5de5-ab65-67b39782d31e" :db/ensure [:activity/validate]} {:db/id "step-2c32e12b-7fa9-5de5-ab65-67b39782d31e" :step/id #uuid "2c32e12b-7fa9-5de5-ab65-67b39782d31e" :step/content 17592186311559 :step/next "step-1b4443f1-0280-5047-9471-acc341316636" :db/ensure [:step/validate]} {:db/id "step-1b4443f1-0280-5047-9471-acc341316636" :step/id #uuid "1b4443f1-0280-5047-9471-acc341316636" :step/content 17592186311560 :step/next "step-9b0fd3c3-6109-5d52-8875-92b52299b80a" :db/ensure [:step/validate]} {:db/id "step-9b0fd3c3-6109-5d52-8875-92b52299b80a" :step/id #uuid "9b0fd3c3-6109-5d52-8875-92b52299b80a" :step/content 17592186229682 :step/next "step-27866c4a-22d7-5b58-972c-cfe8b9d40b47" :db/ensure [:step/validate]} {:db/id "step-27866c4a-22d7-5b58-972c-cfe8b9d40b47" :step/id #uuid "27866c4a-22d7-5b58-972c-cfe8b9d40b47" :step/content 17592186391586 :step/next "step-323902b1-2dc9-5b75-a6de-c749bb49c955" :db/ensure [:step/validate]} {:db/id "step-323902b1-2dc9-5b75-a6de-c749bb49c955" :step/id #uuid "323902b1-2dc9-5b75-a6de-c749bb49c955" :step/content 17592186311794 :db/ensure [:step/validate]} {:db/id 17592186147399 :knowledge-point/questions ["question-54f0409c-f2ef-5cc4-b4e4-ffc38eb896a2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147398 :knowledge-point/questions ["question-b1c05acb-14b2-5a23-a0fb-57fef367611e" "question-7896667b-b339-512f-9dbb-66fd90855442"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b1c05acb-14b2-5a23-a0fb-57fef367611e" :question/id #uuid "b1c05acb-14b2-5a23-a0fb-57fef367611e" :question/math-academy-id "q-349973" :question/problem "The rate at which water flows into a tank is given by the function\n\n$$\nr(t)=6t+10,\n$$\n\nwhere $r(t)$ is measured in liters per hour and $t>0$ is the time in hours since $1\\,\\text{p.m}.$\nWater is also draining from the tank at a steady rate of $8$ liters per hour.\n\nIf there were $200$ liters of water in the tank at $1\\,\\text{p.m},$ how many liters of water will be there at $5\\,\\text{p.m}?$\n\nThere will be \n{{field-1}}  liters of water in the tank at $5\\,\\text{p.m}.$" :question/worked-solution "Water is flowing into the tank at a rate of $6t+10$ liters per hour and is draining at a rate of $8$ liters per hour. Therefore, the **rate of change** in the amount of water (call it $R(t)$) is\n\n$$\n\\begin{aligned}R(t) & =r(t)-8 \\\\  & =6t+10-8 \\\\  & =6t+2.\\end{aligned}\n$$\n\nTo find the **total amount of water** after $t$ hours (call it $T(t)$), we apply the second fundamental theorem of calculus:\n\n$$\n\\begin{aligned}T(t) & =T(0)+{\\int }_{0}^{t}R(x)\\,\\text{d}x \\\\  & =200+{\\int }_{0}^{t}(6x+2)\\,\\text{d}x\\end{aligned}\n$$\n\nTo ensure that $T$ is a function of $t$ only, we use a different variable ($x$) for the integration. \n\nTo find out the amount of water after $4$ hours ($5\\,\\text{p.m}$), we substitute $t=4$ into the above and evaluate:\n\n$$\n\\begin{aligned}T(4) & =200+{\\int }_{0}^{4}(6x+2)\\,\\text{d}x \\\\  & =200+(3{x}^{2}+2x){|}_{0}^{4} \\\\  & =200+[(3\\cdot 16+8)-0] \\\\  & =200+56 \\\\  & =256\\end{aligned}\n$$\n\nTherefore, there will be $256$ liters of water in the tank at $5\\,\\text{p.m}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bdb50e03-36f7-5d1f-9178-33250a489690"] :db/ensure [:question/validate]} {:db/id "answer-field-bdb50e03-36f7-5d1f-9178-33250a489690" :answer-field/id #uuid "bdb50e03-36f7-5d1f-9178-33250a489690" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e6f34e98-745c-508e-9aac-c7930cd0847b" :answer-field/choices ["answer-e6f34e98-745c-508e-9aac-c7930cd0847b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6f34e98-745c-508e-9aac-c7930cd0847b" :answer/id #uuid "e6f34e98-745c-508e-9aac-c7930cd0847b" :answer/type :answer.type/math :answer/value "256" :db/ensure [:answer/validate]} {:db/id "question-7896667b-b339-512f-9dbb-66fd90855442" :question/id #uuid "7896667b-b339-512f-9dbb-66fd90855442" :question/math-academy-id "q-349984" :question/problem "A city is tracking the number of bikes available in a bike-share station.\nThey observe that bikes are returned to the station at a rate $r(t)$ given by the function\n\n$$\nr(t)=5{t}^{3}+2t,\n$$\n\nwhere $r(t)$ is measured in bikes per hour, and $t>0$ is the time in hours since tracking began.\nAt the same time, $4$ bikes are rented from the station each hour.\n\nIf there were initially $100$ bikes at the station, find the expression that gives $B(t),$ the number of bikes at the station $t$ hours after tracking began.\n\n$B(t)=\\frac{5}{4}{t}^{4}\\,+$\n{{field-1}}" :question/worked-solution "The number of bikes is increasing at a rate of $r(t)$ bikes per hour and is decreasing at a rate of $4$ bikes per hour. Therefore, the **rate of change** $R(t)$ of the number of bikes is\n\n$$\n\\begin{aligned}R(t) & =r(t)-4 \\\\  & =5{t}^{3}+2t-4.\\end{aligned}\n$$\n\nTo find the total number $B(t)$ of bikes after $t$ hours, we apply the second fundamental theorem of calculus:\n\n$$\n\\begin{aligned}B(t) & =B(0)+{\\int }_{0}^{t}R(x)\\,\\text{d}x \\\\  & =100+{\\int }_{0}^{t}(5{x}^{3}+2x-4)\\,\\text{d}x\\end{aligned}\n$$\n\nTo ensure that our final function is a function of $t$ only, we use a different variable ($x$) for the integration.\n\nWe can simplify the expression as follows:\n\n$$\n\\begin{aligned}B(t) & =100+{\\int }_{0}^{t}5{x}^{3}\\,\\text{d}x+{\\int }_{0}^{t}2x\\,\\text{d}x-{\\int }_{0}^{t}4\\,\\text{d}x \\\\  & =100+{5\\,\\frac{{x}^{4}}{4}|}_{0}^{t}+{2\\,\\frac{{x}^{2}}{2}|}_{0}^{t}-4x{|}_{0}^{t} \\\\  & =100+\\frac{5}{4}{t}^{4}+{t}^{2}-4t \\\\  & =\\frac{5}{4}{t}^{4}+\\,{t}^{2}-4t+100\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9eaf115f-1435-52c2-b951-5e9b2f69cb63"] :db/ensure [:question/validate]} {:db/id "answer-field-9eaf115f-1435-52c2-b951-5e9b2f69cb63" :answer-field/id #uuid "9eaf115f-1435-52c2-b951-5e9b2f69cb63" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b9635b2b-705b-58e9-94bd-88166205012c" :answer-field/choices ["answer-b9635b2b-705b-58e9-94bd-88166205012c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9635b2b-705b-58e9-94bd-88166205012c" :answer/id #uuid "b9635b2b-705b-58e9-94bd-88166205012c" :answer/type :answer.type/math :answer/value "t^{2}-4t+100" :db/ensure [:answer/validate]} {:db/id "question-54f0409c-f2ef-5cc4-b4e4-ffc38eb896a2" :question/id #uuid "54f0409c-f2ef-5cc4-b4e4-ffc38eb896a2" :question/math-academy-id "q-349997" :question/problem "On a certain afternoon, the total number of people $N(t)$ visiting the city's zoo is given by the function\n\n$$\nN(t)=30+4{\\int }_{0}^{t}(10-2x)\\,\\text{d}x,\n$$\n\nwhere $t>0$ is the time (in hours) since noon.  \n\nAt what time is the number of people in the zoo at a maximum, and how many people are at the zoo at that time?\n\nThe maximum number of people is\n{{field-1}}\nafter\n{{field-2}}\nhours." :question/worked-solution "To find when the number of people at the zoo is at maximum, we need to solve $\\frac{\\text{d}N}{\\text{d}t}=0.$ First, we differentiate:\n\n$$\n\\begin{aligned}\\frac{\\text{d}N}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(30+4{\\int }_{0}^{t}(10-2x)\\,\\text{d}x) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(30)+\\frac{\\text{d}}{\\text{d}t}(4{\\int }_{0}^{t}(10-2x)\\,\\text{d}x) \\\\  & =4\\frac{\\text{d}}{\\text{d}t}{\\int }_{0}^{t}(10-2x)\\,\\text{d}x \\\\  & =4(10-2t)\\end{aligned}\n$$\n\nNow, we solve $\\frac{\\text{d}N}{\\text{d}t}=0$:\n\n$$\n4(10-2t)=0\\,⟹\\,t=5\n$$\n\nSo there are two candidates for global extrema, $t=0$ and $t=5.$ To find out how many people are in the zoo when $t=5,$ we figure out $N(5):$\n\n$$\n\\begin{aligned}N(5) & =30+4{\\int }_{0}^{5}(10-2x)\\,\\text{d}x \\\\  & =30+4{[10x-{x}^{2}]|}_{0}^{5} \\\\  & =30+4[(10\\cdot 5-{5}^{2})-(0)] \\\\  & =30+4\\cdot 25 \\\\  & =130\\end{aligned}\n$$\n\nSince $30<130$, we conclude that the maximum number of people at the zoo is $130$, and this will happen after $5$ hours." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-265736ea-5f99-5ebe-9b6c-32c27324902a" "answer-field-25f4130c-9394-541b-a643-051a656f347b"] :db/ensure [:question/validate]} {:db/id "answer-field-265736ea-5f99-5ebe-9b6c-32c27324902a" :answer-field/id #uuid "265736ea-5f99-5ebe-9b6c-32c27324902a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9b09585d-43e7-56cb-8602-90e62261bd31" :answer-field/choices ["answer-9b09585d-43e7-56cb-8602-90e62261bd31"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b09585d-43e7-56cb-8602-90e62261bd31" :answer/id #uuid "9b09585d-43e7-56cb-8602-90e62261bd31" :answer/type :answer.type/math :answer/value "130" :db/ensure [:answer/validate]} {:db/id "answer-field-25f4130c-9394-541b-a643-051a656f347b" :answer-field/id #uuid "25f4130c-9394-541b-a643-051a656f347b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0dfaac65-5999-5ebb-b5c5-894a0344cbaf" :answer-field/choices ["answer-0dfaac65-5999-5ebb-b5c5-894a0344cbaf"] :db/ensure [:answer-field/validate]} {:db/id "answer-0dfaac65-5999-5ebb-b5c5-894a0344cbaf" :answer/id #uuid "0dfaac65-5999-5ebb-b5c5-894a0344cbaf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "activity-b0847fb5-fa32-5a94-94b5-243ac836859c" :activity/id #uuid "b0847fb5-fa32-5a94-94b5-243ac836859c" :activity/title "Integrating Rates of Change" :activity/type :activity.type/review :activity/scope 17592186049952 :activity/course 17592186046644 :activity/steps ["step-6c504d06-98a0-51e0-a67b-97bcf359f7c7" "step-a55587c2-e7e9-5369-8800-e5f86ed901d2" "step-d54dc8bc-ee1a-54b4-8dbf-4d22b96df654" "step-25fcc6e6-29c0-5bf9-9f04-6426e5b05635" "step-c49eac7d-056b-55ba-a0ba-a1b3b42a5b43"] :activity/first-step "step-6c504d06-98a0-51e0-a67b-97bcf359f7c7" :db/ensure [:activity/validate]} {:db/id "step-6c504d06-98a0-51e0-a67b-97bcf359f7c7" :step/id #uuid "6c504d06-98a0-51e0-a67b-97bcf359f7c7" :step/content 17592186332974 :step/next "step-a55587c2-e7e9-5369-8800-e5f86ed901d2" :db/ensure [:step/validate]} {:db/id "step-a55587c2-e7e9-5369-8800-e5f86ed901d2" :step/id #uuid "a55587c2-e7e9-5369-8800-e5f86ed901d2" :step/content "question-b1c05acb-14b2-5a23-a0fb-57fef367611e" :step/next "step-d54dc8bc-ee1a-54b4-8dbf-4d22b96df654" :db/ensure [:step/validate]} {:db/id "step-d54dc8bc-ee1a-54b4-8dbf-4d22b96df654" :step/id #uuid "d54dc8bc-ee1a-54b4-8dbf-4d22b96df654" :step/content "question-7896667b-b339-512f-9dbb-66fd90855442" :step/next "step-25fcc6e6-29c0-5bf9-9f04-6426e5b05635" :db/ensure [:step/validate]} {:db/id "step-25fcc6e6-29c0-5bf9-9f04-6426e5b05635" :step/id #uuid "25fcc6e6-29c0-5bf9-9f04-6426e5b05635" :step/content 17592186319359 :step/next "step-c49eac7d-056b-55ba-a0ba-a1b3b42a5b43" :db/ensure [:step/validate]} {:db/id "step-c49eac7d-056b-55ba-a0ba-a1b3b42a5b43" :step/id #uuid "c49eac7d-056b-55ba-a0ba-a1b3b42a5b43" :step/content "question-54f0409c-f2ef-5cc4-b4e4-ffc38eb896a2" :db/ensure [:step/validate]} [:db/retract 17592186102084 :answer-field/choices 17592186102085] [:db/retract 17592186102084 :answer-field/choices 17592186102086] [:db/retract 17592186102084 :answer-field/choices 17592186102087] [:db/retract 17592186102084 :answer-field/choices 17592186102088] [:db/retract 17592186102084 :answer-field/choices 17592186102089] [:db/retract 17592186105076 :answer-field/choices 17592186105077] [:db/retract 17592186105076 :answer-field/choices 17592186105078] [:db/retract 17592186105076 :answer-field/choices 17592186105079] [:db/retract 17592186105076 :answer-field/choices 17592186105080] [:db/retract 17592186105076 :answer-field/choices 17592186105081] {:db/id 17592186105749 :knowledge-point/questions ["question-3b2bb749-744c-58b7-8e55-b0bc2383bc8d" "question-41756a29-a06c-5e68-84f6-73d196f1e63f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105471 :question/problem "Consider the hexagon shown below. Draw an exterior angle of $\\angle B.$\n\n![](images/fc/fc1834e88b4d08a2705059d28d21105047898f251f0f2c29f8509be7b6321de0.png)" :question/worked-solution "To construct an exterior angle of $\\angle B,$ we extend $\\overline{AB}$ past $B.$ The angle between $\\overline{BC}$ and the extension of $\\overline{AB}$ is an exterior angle of $\\angle B.$\n\n![](images/d9/d91fc772042490e0785a4a617e4c3785c8616b7ed0ff05509ca8bc902eccc2a8.png)\n\nAnother way to construct an exterior angle of $\\angle B$ is to extend $\\overline{CB}$ past $B.$ The angle between $\\overline{AB}$ and the extension of $\\overline{CB}$ is also an exterior angle of $\\angle B.$\n\n![](images/8d/8d031a6a6cc1513fc0a8031755b537d144279b88c964fc75728d3588ae1e4af9.png)" :db/ensure [:question/validate]} {:db/id 17592186105750 :knowledge-point/questions ["question-09e9dcd8-fbe7-5f9f-9e34-7eb900193f19"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105472 :question/problem "![](images/02/02ac83b8318d6067ba7959c390ccb8b011001ebcb289e4f31c27ba8e1ceb2913.png)\n\nIn the figure above, determine the measure of the exterior angle of $\\angle{F}.$" :question/worked-solution "Let us call $x$ the exterior angle of $\\angle F.$ Since the sum of the exterior angles of a polygon is $360^{\\circ}$, we have\n\n$$\n\\begin{aligned}{100}^{∘}+{60}^{∘}+{78}^{∘}+{62}^{∘}+x & ={360}^{∘} \\\\ {300}^{∘}+x & ={360}^{∘} \\\\ x & ={360}^{∘}-{300}^{∘} \\\\ x & ={60}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105751 :knowledge-point/questions ["question-7bd80e8d-878b-5ffb-88fb-5a3f8d18232d" "question-7a62fde9-6a09-5998-9eb3-129787e83051"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105473 :question/problem "![](images/0f/0f2d7f92335d965840f8714dc4ceeb43201ecee2ada9b7aeb7eb54437a0f7d0f.png)\n\nFind the value of $x.$" :question/worked-solution "Note that the measure of the exterior angle at $A$ is $180^\\circ - 90^\\circ=90^\\circ$ and the measure of the exterior angle at $D$ is $180^\\circ - 2x.$ \n\nSince the sum of the exterior angles of a polygon is $360^{\\circ},$  we have\n\n$$\n\\begin{aligned}{90}^{∘}+(x+{10}^{∘})+({180}^{∘}-2x)+x+(x+{10}^{∘}) & ={360}^{∘} \\\\ x+{290}^{∘} & ={360}^{∘} \\\\ x & ={70}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105752 :knowledge-point/questions ["question-88db253f-f4d0-5a45-9c21-b523cf1fc7e0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105474 :question/problem "![](images/22/22130cbd3bb1f36d9ef8ce6290eead15354bbced7810e5fad5ac62972cd1d968.png)\n\nFor the quadrilateral above, determine the measure of the exterior angle of $\\angle A.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is $360^{\\circ}$, we have\n\n$$\n\\begin{aligned}(12x-{5}^{∘})+(6x+{5}^{∘})+(10x)+(9x-{10}^{∘}) & ={360}^{∘} \\\\ 37x-{10}^{∘} & ={360}^{∘} \\\\ 37x & ={360}^{∘}+{10}^{∘} \\\\ 37x & ={370}^{∘} \\\\ x & ={10}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of the exterior angle of $\\angle A$ equals\n\n$$\n\\begin{aligned}12x-{5}^{∘} & =12({10}^{∘})-{5}^{∘} \\\\  & ={120}^{∘}-{5}^{∘} \\\\  & ={115}^{∘}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-3b2bb749-744c-58b7-8e55-b0bc2383bc8d" :question/id #uuid "3b2bb749-744c-58b7-8e55-b0bc2383bc8d" :question/math-academy-id "q-23179" :question/problem "![](images/4d/4ddabde52952795caff26a3446465f74660bb4847911931859c8c2410c86a3ab.png)\n\nConsider the pentagon shown above. Which of the following shows an exterior angle of $∠D?$" :question/worked-solution "To construct an exterior angle of $∠D,$ we extend $\\overset{―}{CD}$ past $D.$ The angle between $\\overset{―}{ED}$ and the extension of $\\overset{―}{CD}$ is an exterior angle of $∠D.$\n\n![](images/e4/e4a4aeff749a6272032f69cdf1631daf352fe9ab601f549d255751107a1f4e0b.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-82ba01d4-73a3-57d7-bcd4-c0fe0737f3b2"] :db/ensure [:question/validate]} {:db/id "answer-field-82ba01d4-73a3-57d7-bcd4-c0fe0737f3b2" :answer-field/id #uuid "82ba01d4-73a3-57d7-bcd4-c0fe0737f3b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a8f7cf2-b4ad-51d5-8e94-a4c47e2692b9" :answer-field/choices ["answer-e09e8296-1a27-59ec-b0c3-2aa8608f6ece" "answer-6b4b81c9-ba73-5390-bc8e-8f718fde1729" "answer-b17b940b-06c6-595e-9916-a618e505eb90" "answer-6a8f7cf2-b4ad-51d5-8e94-a4c47e2692b9" "answer-e7e51bf9-9e16-529b-ba8b-7cc9e1a6d322"] :db/ensure [:answer-field/validate]} {:db/id "answer-e09e8296-1a27-59ec-b0c3-2aa8608f6ece" :answer/id #uuid "e09e8296-1a27-59ec-b0c3-2aa8608f6ece" :answer/type :answer.type/i