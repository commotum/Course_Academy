 [:answer/validate]} {:db/id "answer-2bf4a400-82fb-52be-897a-bf7bcbd48644" :answer/id #uuid "2bf4a400-82fb-52be-897a-bf7bcbd48644" :answer/type :answer.type/text :answer/value "$(1,\\infty )$ only" :db/ensure [:answer/validate]} {:db/id "question-926951ab-0eab-59e8-a59e-f3b17566f504" :question/id #uuid "926951ab-0eab-59e8-a59e-f3b17566f504" :question/math-academy-id "q-27762" :question/problem "![](images/0d/0d3b179cb8f464ca794d7529414af8421a327011b53418d08578bbf0dd7469d2.png)\n\nOn which interval is the function $y=f(x)$, shown above, decreasing?" :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in (-\\infty ,-3)$ the graph falls\n\n- For $x\\in (-3,-2)$ the graph rises\n\n- For $x\\in (-2,-1)$ the graph falls\n\n- For $x\\in (-1,0)$ the graph rises\n\n- For $x\\in (0,1)$ the graph falls\n\n- For $x\\in (1,2)$ the graph rises\n\n- For $x\\in (2,3)$ the graph falls\n\n- For $x\\in (3,\\infty )$ the graph rises\n\nThe function is decreasing on the intervals where it never rises: $(-\\infty ,-3),$  $(-2,-1),$  $(0,1),$ and $(2,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9309f481-c9db-53a4-8ece-427c7211eb69"] :db/ensure [:question/validate]} {:db/id "answer-field-9309f481-c9db-53a4-8ece-427c7211eb69" :answer-field/id #uuid "9309f481-c9db-53a4-8ece-427c7211eb69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be685eab-a092-5456-94d6-897eef0dbd64" :answer-field/choices ["answer-48c330d3-a889-5bc7-9a27-43033f7144c3" "answer-f17912e6-7f87-5a7c-87a0-369dd5591680" "answer-75e08f58-d63d-500a-bec5-0ce65a807f35" "answer-be685eab-a092-5456-94d6-897eef0dbd64" "answer-4793a490-127a-54a2-b8a5-7e09efd14338"] :db/ensure [:answer-field/validate]} {:db/id "answer-48c330d3-a889-5bc7-9a27-43033f7144c3" :answer/id #uuid "48c330d3-a889-5bc7-9a27-43033f7144c3" :answer/type :answer.type/text :answer/value "$(-3,-1),$  $(-1,1),$ and $(