92-5996-b868-ced2e8adeb9d" :activity/id #uuid "896b775a-da92-5996-b868-ced2e8adeb9d" :activity/title "The Distributive Laws" :activity/type :activity.type/review :activity/scope 17592186049989 :activity/course 17592186046658 :activity/steps ["step-fb1329da-957c-5193-8cb1-46919290659e" "step-623ba644-95a4-5cc0-a0f5-ac76b4b3690d" "step-b445dd0d-8061-5e06-9350-df2a654a8887" "step-e7a9c0db-6080-5dbc-a0ed-bd3eae0539cb" "step-47a97766-cdb6-5556-90e5-d537c4ea4376"] :activity/first-step "step-fb1329da-957c-5193-8cb1-46919290659e" :db/ensure [:activity/validate]} {:db/id "step-fb1329da-957c-5193-8cb1-46919290659e" :step/id #uuid "fb1329da-957c-5193-8cb1-46919290659e" :step/content "question-dd8060ac-5133-5617-8826-8c5bef481505" :step/next "step-623ba644-95a4-5cc0-a0f5-ac76b4b3690d" :db/ensure [:step/validate]} {:db/id "step-623ba644-95a4-5cc0-a0f5-ac76b4b3690d" :step/id #uuid "623ba644-95a4-5cc0-a0f5-ac76b4b3690d" :step/content "question-c7a7815a-c03d-5c73-81c2-1ce5ce9a6bba" :step/next "step-b445dd0d-8061-5e06-9350-df2a654a8887" :db/ensure [:step/validate]} {:db/id "step-b445dd0d-8061-5e06-9350-df2a654a8887" :step/id #uuid "b445dd0d-8061-5e06-9350-df2a654a8887" :step/content "question-a1582560-8fbb-58c7-88eb-84a06eeb3625" :step/next "step-e7a9c0db-6080-5dbc-a0ed-bd3eae0539cb" :db/ensure [:step/validate]} {:db/id "step-e7a9c0db-6080-5dbc-a0ed-bd3eae0539cb" :step/id #uuid "e7a9c0db-6080-5dbc-a0ed-bd3eae0539cb" :step/content "question-b0451199-17d2-50c9-834a-20bc2c5dbac9" :step/next "step-47a97766-cdb6-5556-90e5-d537c4ea4376" :db/ensure [:step/validate]} {:db/id "step-47a97766-cdb6-5556-90e5-d537c4ea4376" :step/id #uuid "47a97766-cdb6-5556-90e5-d537c4ea4376" :step/content 17592186387950 :db/ensure [:step/validate]} [:db/retract 17592186080219 :answer-field/choices 17592186080220] [:db/retract 17592186080219 :answer-field/choices 17592186080221] [:db/retract 17592186080219 :answer-field/choices 17592186080222] [:db/retract 17592186080219 :answer-field/choices 17592186080223] [:db/retract 17592186080987 :answer-field/choices 17592186080992] [:db/retract 17592186080987 :answer-field/choices 17592186080988] [:db/retract 17592186080987 :answer-field/choices 17592186080989] [:db/retract 17592186080987 :answer-field/choices 17592186080990] [:db/retract 17592186080987 :answer-field/choices 17592186080991] {:db/id 17592186083189 :knowledge-point/questions ["question-ed33137c-8a0a-513d-a96f-11ce31e8009b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082947 :question/problem "Sketch the graph of $y=|x|-3$." :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nThe function $y=|x|-3$ has $a=-3.$ Therefore, it is a vertical translation of the absolute value graph $y=|x|$ by $3$ units *down*.\n\n![](images/72/7266634257d662b0af75fdb80d402acaa779df2ed4b62fc43c074a7f4f902de0.png)" :db/ensure [:question/validate]} {:db/id 17592186083190 :knowledge-point/questions ["question-276e0cea-6920-5a35-bd19-e10e6d09e8ad"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082948 :question/problem "Sketch the graph of $y=|x-3|$." :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x-3|$ has $a=3.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $3$ units right.\n\n![](images/eb/ebe57ac4935c6ffc84abf20de2959c0f6f543514821ff32900fba65515b55646.png)\n\n**Watch Out!** It's easy to confuse the translations $y=|x-3|$ and $y=|x+3|$. The graph of $y=|x-3|$ is shifted to the right and the graph of $y=|x+3|$ is shifted to the left, even though it seems like it should be the other way around." :db/ensure [:question/validate]} {:db/id 17592186083191 :knowledge-point/questions ["question-2d5712de-7b42-579e-9943-a685763e7f7c" "question-e80f0782-a7b9-5425-b344-19fe7f2eb11e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082949 :question/problem "Sketch the graph of $y=|x+1|+2$." :question/worked-solution "Remember that $y=|x-h|+k$ is a translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+1|+2$ has $h=-1$ and $k=2.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $1$ unit *left* and $2$ units up.\n\n![](images/e8/e80f640da0a2e6e6c1e14790f66b6a05747f6149dddc8a14fc48932bd5e696eb.png)" :db/ensure [:question/validate]} {:db/id "question-ed33137c-8a0a-513d-a96f-11ce31e8009b" :question/id #uuid "ed33137c-8a0a-513d-a96f-11ce31e8009b" :question/math-academy-id "q-222329" :question/problem "![](images/66/66a45a4a2f5a794b53c05f5886fe944d7a2fd3d0344c3e25fc5a9d0c1984006f.png)\n\nThe graph above shows the image of the graph $y=|x|$ under the action of a single translation. What is the equation of this curve?\n\nThe equation of this curve is $y=$\n{{field-1}}." :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nHere, the graph is moved down by $8$ units. This corresponds to $a=-8.$ \n\nTherefore, the equation of the curve is $y=|x|-8.$\n\n![](images/47/477932b4bf3420b86a105da3ffe8c554ff9778fe574d62ef4625a29834b2ec83.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bbe57635-9ea1-50d5-b454-9cab79720de9"] :db/ensure [:question/validate]} {:db/id "answer-field-bbe57635-9ea1-50d5-b454-9cab79720de9" :answer-field/id #uuid "bbe57635-9ea1-50d5-b454-9cab79720de9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b32a26f2-a0a7-56e6-a8d4-7226c80af79b" :answer-field/choices ["answer-b32a26f2-a0a7-56e6-a8d4-7226c80af79b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b32a26f2-a0a7-56e6-a8d4-7226c80af79b" :answer/id #uuid "b32a26f2-a0a7-56e6-a8d4-7226c80af79b" :answer/type :answer.type/math :answer/value "\\left|x\\right|-8" :db/ensure [:answer/validate]} {:db/id 17592186083554 :question/problem "If $y=|x|+2$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nThe function $y=|x|+2$ has $a=2.$ Therefore, it is a vertical translation of the absolute value graph $y=|x|$ by $2$ units up.\n\n![](images/47/47bab8c5a2fa41bbe03dd6d5ed8d3c4a7d005e3cbb0eefdd258ff0ecbd61ee5c.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(0,2).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186080219 :answer-field/correct "answer-f86ba674-714b-56cb-b55c-60ac41f9871e" :answer-field/choices ["answer-4cb06b3e-9c0f-5dc0-838e-f4036f7adaaa" "answer-2e66c3cc-f7cf-58f5-8192-9227767d5b9b" "answer-f86ba674-714b-56cb-b55c-60ac41f9871e" "answer-8b5c1d6e-5e25-5bb0-95f8-e06759a9b228"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cb06b3e-9c0f-5dc0-838e-f4036f7adaaa" :answer/id #uuid "4cb06b3e-9c0f-5dc0-838e-f4036f7adaaa" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-2e66c3cc-f7cf-58f5-8192-9227767d5b9b" :answer/id #uuid "2e66c3cc-f7cf-58f5-8192-9227767d5b9b" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-f86ba674-714b-56cb-b55c-60ac41f9871e" :answer/id #uuid "f86ba674-714b-56cb-b55c-60ac41f9871e" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "answer-8b5c1d6e-5e25-5bb0-95f8-e06759a9b228" :answer/id #uuid "8b5c1d6e-5e25-5bb0-95f8-e06759a9b228" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "question-276e0cea-6920-5a35-bd19-e10e6d09e8ad" :question/id #uuid "276e0cea-6920-5a35-bd19-e10e6d09e8ad" :question/math-academy-id "q-222357" :question/problem "![](images/ce/ce3b78035978226d9b095a4746d76b090a9225e2c6eaf20a6a19a2857c056f98.png)\n\nThe graph above shows the image of the graph $y=|x|$ under the action of a single translation. What is the equation of this curve?\n\nThe equation of this curve is\n$y=$\n{{field-1}}." :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nNotice that here, the graph is moved *right* by $7$ units. This corresponds to $a=7.$\n\n Therefore, the equation of the curve is $y=|x-7|.$\n\n![](images/4b/4be0b85e84626fa9960cb44017209b842cec090d1dfd409a290721a7250caf6c.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-557637a6-25ce-583e-8770-0b00d28d71bc"] :db/ensure [:question/validate]} {:db/id "answer-field-557637a6-25ce-583e-8770-0b00d28d71bc" :answer-field/id #uuid "557637a6-25ce-583e-8770-0b00d28d71bc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-69059512-0123-51a4-ba8c-37e6d06f1ef4" :answer-field/choices ["answer-69059512-0123-51a4-ba8c-37e6d06f1ef4"] :db/ensure [:answer-field/validate]} {:db/id "answer-69059512-0123-51a4-ba8c-37e6d06f1ef4" :answer/id #uuid "69059512-0123-51a4-ba8c-37e6d06f1ef4" :answer/type :answer.type/math :answer/value "\\left|x-7\\right|" :db/ensure [:answer/validate]} {:db/id 17592186083676 :question/worked-solution "Remember that the graph of $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nHere, the graph is moved *right* by $2$ units. This corresponds to $a=2.$ So, the equation of the graph is $y=|x-2|.$\n\n![](images/3c/3c305a89fe9fd400cd9c58cfb12522b143b2654a49fa58aee582ba1100f94daa.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186080987 :answer-field/correct "answer-690d0474-f26e-57d5-bcb3-5886ad3b4d93" :answer-field/choices ["answer-05053c27-bf42-59a1-ad29-2607a9d8d05a" "answer-7e600479-7010-5639-af9a-cb25ab59f26e" "answer-690d0474-f26e-57d5-bcb3-5886ad3b4d93" "answer-5d74c09d-980c-52cc-b153-8f9ef9eaee8d" "answer-675c91da-7f14-501a-96c7-9d6ca516b68d"] :db/ensure [:answer-field/validate]} {:db/id "answer-05053c27-bf42-59a1-ad29-2607a9d8d05a" :answer/id #uuid "05053c27-bf42-59a1-ad29-2607a9d8d05a" :answer/type :answer.type/math :answer/value "y=2|x|" :db/ensure [:answer/validate]} {:db/id "answer-7e600479-7010-5639-af9a-cb25ab59f26e" :answer/id #uuid "7e600479-7010-5639-af9a-cb25ab59f26e" :answer/type :answer.type/math :answer/value "y=|x+2|" :db/ensure [:answer/validate]} {:db/id "answer-690d0474-f26e-57d5-bcb3-5886ad3b4d93" :answer/id #uuid "690d0474-f26e-57d5-bcb3-5886ad3b4d93" :answer/type :answer.type/math :answer/value "y=|x-2|" :db/ensure [:answer/validate]} {:db/id "answer-5d74c09d-980c-52cc-b153-8f9ef9eaee8d" :answer/id #uuid "5d74c09d-980c-52cc-b153-8f9ef9eaee8d" :answer/type :answer.type/math :answer/value "y=|x|+2" :db/ensure [:answer/validate]} {:db/id "answer-675c91da-7f14-501a-96c7-9d6ca516b68d" :answer/id #uuid "675c91da-7f14-501a-96c7-9d6ca516b68d" :answer/type :answer.type/math :answer/value "y=|x|-2" :db/ensure [:answer/validate]} {:db/id "question-2d5712de-7b42-579e-9943-a685763e7f7c" :question/id #uuid "2d5712de-7b42-579e-9943-a685763e7f7c" :question/math-academy-id "q-15822" :question/problem "If $y=|x-4|+3$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x-4|+3$ has $h=4$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $4$ units *right* and $3$ units *up*.\n\n![](images/a0/a0a914b0961f151f2b05b18e30feabb304915c016ee9552251130aa740a4e715.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(4,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8dbe3da-a555-5efe-9207-dbf146e7141d"] :db/ensure [:question/validate]} {:db/id "answer-field-f8dbe3da-a555-5efe-9207-dbf146e7141d" :answer-field/id #uuid "f8dbe3da-a555-5efe-9207-dbf146e7141d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e72b2cb-449b-5006-a14c-2f45b8a444b2" :answer-field/choices ["answer-5b14bbe4-bb62-5df0-a7d7-eddd893f69d8" "answer-87e4b0ca-ea36-5d56-96c6-2a601c9e1f2e" "answer-8b6ac952-7ce7-51a9-a901-e7e424ad44bc" "answer-ebb51025-d133-5cbf-a693-beb08481d006" "answer-6e72b2cb-449b-5006-a14c-2f45b8a444b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b14bbe4-bb62-5df0-a7d7-eddd893f69d8" :answer/id #uuid "5b14bbe4-bb62-5df0-a7d7-eddd893f69d8" :answer/type :answer.type/math :answer/value "(-3,4)" :db/ensure [:answer/validate]} {:db/id "answer-87e4b0ca-ea36-5d56-96c6-2a601c9e1f2e" :answer/id #uuid "87e4b0ca-ea36-5d56-96c6-2a601c9e1f2e" :answer/type :answer.type/math :answer/value "(-4,3)" :db/ensure [:answer/validate]} {:db/id "answer-8b6ac952-7ce7-51a9-a901-e7e424ad44bc" :answer/id #uuid "8b6ac952-7ce7-51a9-a901-e7e424ad44bc" :answer/type :answer.type/math :answer/value "(3,4)" :db/ensure [:answer/validate]} {:db/id "answer-ebb51025-d133-5cbf-a693-beb08481d006" :answer/id #uuid "ebb51025-d133-5cbf-a693-beb08481d006" :answer/type :answer.type/math :answer/value "(4,-3)" :db/ensure [:answer/validate]} {:db/id "answer-6e72b2cb-449b-5006-a14c-2f45b8a444b2" :answer/id #uuid "6e72b2cb-449b-5006-a14c-2f45b8a444b2" :answer/type :answer.type/math :answer/value "(4,3)" :db/ensure [:answer/validate]} {:db/id "question-e80f0782-a7b9-5425-b344-19fe7f2eb11e" :question/id #uuid "e80f0782-a7b9-5425-b344-19fe7f2eb11e" :question/math-academy-id "q-222359" :question/problem "The minimum value of the function $y=|x+1|+3$ is $y=${{field-1}}." :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+1|+3$ has $h=-1$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $1$ unit *left* and $3$ units *up*.\n\n![](images/aa/aabce12b2665678053ad7a440be44dc0b73e37d2ab45664a2347f55c14641b2a.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f46ad421-de88-5153-8d34-6ba10a17d548"] :db/ensure [:question/validate]} {:db/id "answer-field-f46ad421-de88-5153-8d34-6ba10a17d548" :answer-field/id #uuid "f46ad421-de88-5153-8d34-6ba10a17d548" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-97361026-0945-559f-ace7-f7afd35162ae" :answer-field/choices ["answer-97361026-0945-559f-ace7-f7afd35162ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-97361026-0945-559f-ace7-f7afd35162ae" :answer/id #uuid "97361026-0945-559f-ace7-f7afd35162ae" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186084526 :tutorial/content "Let's plot the graph of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg). According to the algebraic definition of absolute value, we have\n![](images/eb/ebc6cc8f3964043ffa2ff15f7e3501222794753f30577e4b71037efb2e4ffa30.svg)\nSo, the left-hand branch of the graph is the function ![](images/8f/8f96aa73ce843c7815a1fed6bf3f3774a173cfa4d56f13e1f3a8c48d53cd7097.svg), and the right-hand branch is ![](images/23/238e977be23f692486c8bf68f6b40255435b3d1796cc50d260a014a8c670be7b.svg):\n\n![](images/60/60ad4dfdb6086f20f5137c5b4ac4905e55d5697ec4cf31575bf79be5fd408e0c.png)\n\nNotice that the graph has a sharp corner at ![](images/c1/c1e8c20213b45135f50bdc8d4544220f7b0f943ff3ca49439660c86d017e789f.svg) We call this point the **vertex** or the **minimum point.**\n\nWe can apply **horizontal** and **vertical translations** to the graph of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg).\n\n- The graph of ![](images/91/91c9b5c48d46f81336e889febab90a9027a96accef8626bd0743ca81042f25b8.svg) is a **vertical translation** of the absolute value graph ![](images/0c/0cb4d1ae0c2e2451edd095b9dbcca94222e8ef0514db46745a2acce4b617d78e.svg) It moves the graph ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) units up.\n\n![](images/cd/cd8b826034f7c3668cacb490e0fab60daaf7c5cae63975bfa5cae9d468c7dec6.png)\n\n- The graph of ![](images/30/3016548be8be38ace3450d51a10371543820a3357b1adbf809d69c23c70f14bb.svg) is a **horizontal translation** of the absolute value graph ![](images/0c/0cb4d1ae0c2e2451edd095b9dbcca94222e8ef0514db46745a2acce4b617d78e.svg) It moves the graph ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) units to the *right*.\n\n![](images/65/65912d2831dd525964b78a20f2a707d7d828daa2a5e2ebd0793c6b337a42e360.png)\n\nNote the following:\n\n- When drawing horizontal and vertical translations, it is easiest to transform the graph's vertex first. Then, the two branches can be drawn coming out of the vertex.\n\n- When we translate the graph ![](images/87/87f4b5227cb69bd468d75d826fe448c91ae677181f9142fcbe9bc757d0acea77.svg) the resulting curve is called the **image** of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg) under the translation." :db/ensure [:tutorial/validate]} {:db/id 17592186084528 :tutorial/content "Horizontal and vertical translations can be combined. It does not matter which we do first.\n\nIn general, the graph of $y=|x-h|+k$ is a translation of the graph $y=|x|$ by\n\n- $h$ units right, and\n\n- $k$ units up." :db/ensure [:tutorial/validate]} {:db/id 17592186083468 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186110778 :knowledge-point/questions ["question-16005fe9-c0e8-5807-8dbf-172a83d89558" "question-978998ae-c2d1-5709-a415-cc49252cea0c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-16005fe9-c0e8-5807-8dbf-172a83d89558" :question/id #uuid "16005fe9-c0e8-5807-8dbf-172a83d89558" :question/math-academy-id "q-53062" :question/problem "Which of the following statements are true?\n\nI. A square is sometimes not a rectangle.\n\nII. A rectangle is always a quadrilateral.\n\nIII. A square is never a rhombus." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is false. In a rectangle, its four angles are right angles. The same is true for a square. A square is a specific type of rectangle, where the four angles are right angles and the four sides are congruent.\n\n- Statement II is true. A rectangle is always a quadrilateral because it has four sides.\n\n- Statement III is false. A rhombus is a parallelogram where all sides are congruent. A square is a specific type of rhombus, where the four angles are right angles and the four sides are congruent.\n\nIn conclusion, only statement II is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b73d6aaf-8b71-5986-9a72-f3f8cba064c2"] :db/ensure [:question/validate]} {:db/id "answer-field-b73d6aaf-8b71-5986-9a72-f3f8cba064c2" :answer-field/id #uuid "b73d6aaf-8b71-5986-9a72-f3f8cba064c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer-field/choices ["answer-04cd6f91-4830-5fb2-a760-6d1458397aff" "answer-6b6d04c0-fedf-5f99-93ce-81d660f42b3b" "answer-3cb14bc8-1566-5a66-a92e-6847a87ef3a0" "answer-40c8a717-049b-5524-b555-5e7634dfb774" "answer-9f2a5be0-7fd3-5d96-a0c9-2797fdcde248"] :db/ensure [:answer-field/validate]} {:db/id "answer-04cd6f91-4830-5fb2-a760-6d1458397aff" :answer/id #uuid "04cd6f91-4830-5fb2-a760-6d1458397aff" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6b6d04c0-fedf-5f99-93ce-81d660f42b3b" :answer/id #uuid "6b6d04c0-fedf-5f99-93ce-81d660f42b3b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer/id #uuid "3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-40c8a717-049b-5524-b555-5e7634dfb774" :answer/id #uuid "40c8a717-049b-5524-b555-5e7634dfb774" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-9f2a5be0-7fd3-5d96-a0c9-2797fdcde248" :answer/id #uuid "9f2a5be0-7fd3-5d96-a0c9-2797fdcde248" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-978998ae-c2d1-5709-a415-cc49252cea0c" :question/id #uuid "978998ae-c2d1-5709-a415-cc49252cea0c" :question/math-academy-id "q-53063" :question/problem "Which of the following statements are true?\n\nI. A parallelogram is sometimes a rectangle.\n\nII. A kite is never a quadrilateral.\n\nIII. A square is always a trapezoid." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is true. A parallelogram is a rectangle when all the angles are right.\n\n- Statement II is false. A kite is always a quadrilateral because it has four sides.\n\n- Statement III is false. A trapezoid has only $1$ pair of opposite sides that are parallel. However, in a square, $2$ pairs of opposite sides are parallel, and so doesn't fit the definition of a trapezoid.\n\nIn conclusion, only statement I is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-38a2df37-5f07-59b3-9c74-e390691ea42b"] :db/ensure [:question/validate]} {:db/id "answer-field-38a2df37-5f07-59b3-9c74-e390691ea42b" :answer-field/id #uuid "38a2df37-5f07-59b3-9c74-e390691ea42b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer-field/choices ["answer-e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" "answer-92f03582-9a2a-59ce-8ac4-d6529d374b33" "answer-1afb074a-342e-57b7-b473-fffc06924988" "answer-015f0057-b143-57ad-8fa5-2978f72ea3dc" "answer-555289bb-109d-55d5-955e-bed2ff4c8443"] :db/ensure [:answer-field/validate]} {:db/id "answer-e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" :answer/id #uuid "e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer/id #uuid "92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-1afb074a-342e-57b7-b473-fffc06924988" :answer/id #uuid "1afb074a-342e-57b7-b473-fffc06924988" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-015f0057-b143-57ad-8fa5-2978f72ea3dc" :answer/id #uuid "015f0057-b143-57ad-8fa5-2978f72ea3dc" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-555289bb-109d-55d5-955e-bed2ff4c8443" :answer/id #uuid "555289bb-109d-55d5-955e-bed2ff4c8443" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id 17592186110777 :knowledge-point/questions ["question-4ee12482-99b3-5022-8d03-b6e6abfce44f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4ee12482-99b3-5022-8d03-b6e6abfce44f" :question/id #uuid "4ee12482-99b3-5022-8d03-b6e6abfce44f" :question/math-academy-id "q-74591" :question/problem "![](images/e3/e3708d7723606224e201147b432250dd759022fd7ed275dabebf51935d68d8f8.png)\n\nWhich of the figures above is a rhombus?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rhombus is a parallelogram where all sides are congruent.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. The sides are not all congruent, so it is not a rhombus.\n\n- The shape $Q$ is a square. All its sides are congruent and the opposite sides are parallel, so it is a rhombus.\n\n- The shape $R$ is a trapezoid. Since it has only one pair of parallel sides, it is not a rhombus.\n\n- The shape $S$ is an isosceles trapezoid.  Since it has only one pair of parallel sides, it is not a rhombus.\n\nTherefore, shape $Q$ is a rhombus. The shapes $P,$ $R,$ and $S$ are not rhombuses." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7c39ae96-03b7-5d75-924b-50c66d2fd7a7"] :db/ensure [:question/validate]} {:db/id "answer-field-7c39ae96-03b7-5d75-924b-50c66d2fd7a7" :answer-field/id #uuid "7c39ae96-03b7-5d75-924b-50c66d2fd7a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6b01984-7aec-5b99-b309-32e1700f88cf" :answer-field/choices ["answer-faa76e22-ab2a-5e2f-b51a-88f71d4a4169" "answer-f6b01984-7aec-5b99-b309-32e1700f88cf" "answer-ab8a2580-e988-59db-b88f-bdf851f5dff2" "answer-dabfe65d-e001-5f6f-8eae-84c4f049a38c" "answer-6c5ff65a-e0ad-54f7-95cd-72299fae692b"] :db/ensure [:answer-field/validate]} {:db/id "answer-faa76e22-ab2a-5e2f-b51a-88f71d4a4169" :answer/id #uuid "faa76e22-ab2a-5e2f-b51a-88f71d4a4169" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-f6b01984-7aec-5b99-b309-32e1700f88cf" :answer/id #uuid "f6b01984-7aec-5b99-b309-32e1700f88cf" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-ab8a2580-e988-59db-b88f-bdf851f5dff2" :answer/id #uuid "ab8a2580-e988-59db-b88f-bdf851f5dff2" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "answer-dabfe65d-e001-5f6f-8eae-84c4f049a38c" :answer/id #uuid "dabfe65d-e001-5f6f-8eae-84c4f049a38c" :answer/type :answer.type/text :answer/value "$S$ only" :db/ensure [:answer/validate]} {:db/id "answer-6c5ff65a-e0ad-54f7-95cd-72299fae692b" :answer/id #uuid "6c5ff65a-e0ad-54f7-95cd-72299fae692b" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "activity-0fada08e-9ee8-50a7-a281-27eecc4451e2" :activity/id #uuid "0fada08e-9ee8-50a7-a281-27eecc4451e2" :activity/title "Classifying Quadrilaterals" :activity/type :activity.type/review :activity/scope 17592186049068 :activity/course 17592186046648 :activity/steps ["step-1472f937-314f-5429-8263-e1a67f2a5b4d" "step-a7b19881-e4d4-5ce2-a2db-ec80491290b8" "step-b98f15bb-0b73-5666-9f9e-51644b2b10be"] :activity/first-step "step-1472f937-314f-5429-8263-e1a67f2a5b4d" :db/ensure [:activity/validate]} {:db/id "step-1472f937-314f-5429-8263-e1a67f2a5b4d" :step/id #uuid "1472f937-314f-5429-8263-e1a67f2a5b4d" :step/content "question-16005fe9-c0e8-5807-8dbf-172a83d89558" :step/next "step-a7b19881-e4d4-5ce2-a2db-ec80491290b8" :db/ensure [:step/validate]} {:db/id "step-a7b19881-e4d4-5ce2-a2db-ec80491290b8" :step/id #uuid "a7b19881-e4d4-5ce2-a2db-ec80491290b8" :step/content "question-978998ae-c2d1-5709-a415-cc49252cea0c" :step/next "step-b98f15bb-0b73-5666-9f9e-51644b2b10be" :db/ensure [:step/validate]} {:db/id "step-b98f15bb-0b73-5666-9f9e-51644b2b10be" :step/id #uuid "b98f15bb-0b73-5666-9f9e-51644b2b10be" :step/content "question-4ee12482-99b3-5022-8d03-b6e6abfce44f" :db/ensure [:step/validate]} {:db/id 17592186064309 :knowledge-point/questions ["question-1d911ae7-875c-567e-a470-7c373f982af8" "question-62910e77-69f8-56ea-ac31-ee2dbfe3c8ff" "question-61a2565a-e401-5260-aae7-f12b167eb293" "question-174736f7-0588-55bb-bfa7-155dc6d18a73" "question-b9ab7545-6c81-5c20-9f25-5d780715f99d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064146 :question/problem "Consider the function $y = x^5 (\\cos x)^x.$ Its derivative is given by\n\n$$\ny'(x) = x^4 (\\cos x)^x \\left( 5 + g(x) \\right).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny = x^5 (\\cos x)^x.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{5}(\\operatorname{cos}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{5})+\\operatorname{ln}⁡((\\operatorname{cos}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =5\\operatorname{ln}⁡x+x\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}⁡x+x\\operatorname{ln}⁡(\\operatorname{cos}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{5}{x}+(x)^{′}\\cdot \\operatorname{ln}⁡(\\operatorname{cos}⁡x)+x\\cdot {(\\operatorname{ln}⁡(\\operatorname{cos}⁡x))}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x}+\\operatorname{ln}⁡(\\operatorname{cos}⁡x)+x\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x}+\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nNow, we solve for $y'{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{5}{x}+\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y = x^5 (\\cos x)^x {:}$\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{5}(\\operatorname{cos}⁡x)^{x}(\\frac{5}{x}+\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-x\\operatorname{tan}⁡x) \\\\  & ={x}^{5}(\\operatorname{cos}⁡x)^{x}(\\frac{5}{x}+\\frac{x\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}{x}-\\frac{{x}^{2}\\operatorname{tan}⁡x}{x}) \\\\  & ={x}^{4}(\\operatorname{cos}⁡x)^{x}(5+x\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-{x}^{2}\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x) = x \\ln ( \\cos  x ) - x^2 \\tan x.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064310 :knowledge-point/questions ["question-8a442047-ed6e-5bb4-89b9-beaee4b1e553" "question-adde1803-10ec-5c3d-8c04-d7e2c5d99587" "question-310e9298-b624-54d9-ac03-bed77b7fdecc" "question-11c48698-c6fd-5725-a4b0-1737e6fdc309" "question-dbe4c4ed-7bf7-5234-8564-800989eb5aa4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064147 :question/problem "Consider the function $y = \\dfrac{(x+3)^3}{(x+5)^6}.$ The derivative of this function is given by\n\n$$\ny' = -\\dfrac{g(x)(x+3)^2}{(x+5)^7}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny =  \\dfrac{(x+3)^3}{(x+5)^6}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+3)^{3}}{(x+5)^{6}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+3)^{3})-\\operatorname{ln}⁡((x+5)^{6}) \\\\ \\operatorname{ln}⁡y & =3\\operatorname{ln}⁡(x+3)-6\\operatorname{ln}⁡(x+5)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(x+3)-6\\operatorname{ln}⁡(x+5)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =3\\cdot \\frac{1}{x+3}-6\\cdot \\frac{1}{x+5} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3}{x+3}-\\frac{6}{x+5}\\end{aligned}\n$$\n\n \n\nNow, we solve for $y'{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3}{x+3}-\\frac{6}{x+5})\\end{aligned}\n$$\n\nFinally, we substitute $y =  \\dfrac{(x+3)^3}{(x+5)^6}{:}$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)^{3}}{(x+5)^{6}}(\\frac{3}{x+3}-\\frac{6}{x+5}) \\\\  & =\\frac{(x+3)^{3}}{(x+5)^{6}}(\\frac{3(x+5)-6(x+3)}{(x+3)(x+5)}) \\\\  & =\\frac{(x+3)^{3}}{(x+5)^{6}}(\\frac{-3x-3}{(x+3)(x+5)}) \\\\  & =-\\frac{3(x+1)(x+3)^{2}}{(x+5)^{7}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x) = \\bbox[2pt,Gainsboro]{3(x+1)}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064311 :knowledge-point/questions ["question-254041d3-aef5-5074-80f4-67b8b1344bc0" "question-06abf62c-6dfa-52f6-818c-3858ac967b34" "question-76085196-6a2f-5c76-90cb-5c742aa98a2b" "question-19b1b664-4a0c-5ebc-8d57-f886d4c9f0c2" "question-bc8a78e5-ffc8-5ad6-abfc-11fb82c73f1a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064148 :question/problem "Consider the function $y = \\sqrt[3]{\\dfrac{x^2}{x^5+ 1}}.$  The derivative of this function is given by\n\n$$\ny' =  \\dfrac{g(x)}{3\\sqrt[3]{x(x^5+1)^4}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{\\frac{{x}^{2}}{{x}^{5}+1}} \\\\  & =\\frac{\\sqrt[3]{{x}^{2}}}{\\sqrt[3]{{x}^{5}+1}} \\\\  & =\\frac{{x}^{2/3}}{({x}^{5}+1)^{1/3}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{x}^{2/3}}{({x}^{5}+1)^{1/3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2/3})-\\operatorname{ln}⁡(({x}^{5}+1)^{1/3}) \\\\ \\operatorname{ln}⁡y & =\\frac{2}{3}\\operatorname{ln}⁡x-\\frac{1}{3}\\operatorname{ln}⁡({x}^{5}+1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x{:}$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{3}\\operatorname{ln}⁡x-\\frac{1}{3}\\operatorname{ln}⁡({x}^{5}+1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{2}{3}\\cdot \\frac{1}{x}-\\frac{1}{3}\\cdot \\frac{1}{{x}^{5}+1}\\cdot (5{x}^{4}) \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{3}(\\frac{2}{x}-\\frac{5{x}^{4}}{{x}^{5}+1})\\end{aligned}\n$$\n\n \n\nNow, we solve for $y'{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{1}{3}(\\frac{2}{x}-\\frac{5{x}^{4}}{{x}^{5}+1}))\\end{aligned}\n$$\n\nFinally, we substitute $y =  \\sqrt[3]{\\dfrac{x^2}{x^5+ 1}}{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{3}\\sqrt[3]{\\frac{{x}^{2}}{{x}^{5}+1}}(\\frac{2}{x}-\\frac{5{x}^{4}}{{x}^{5}+1}) \\\\  & =\\frac{1}{3}\\sqrt[3]{\\frac{{x}^{2}}{{x}^{5}+1}}(\\frac{2({x}^{5}+1)-5{x}^{5}}{x({x}^{5}+1)}) \\\\  & =\\frac{1}{3}\\sqrt[3]{\\frac{{x}^{2}}{{x}^{5}+1}}(\\frac{-3{x}^{5}+2}{x({x}^{5}+1)}) \\\\  & =\\frac{1}{3}\\sqrt[3]{\\frac{{x}^{2}}{{x}^{5}+1}}(\\frac{-3{x}^{5}+2}{\\sqrt[3]{{x}^{3}({x}^{5}+1)^{3}}}) \\\\  & =\\frac{-3{x}^{5}+2}{3\\sqrt[3]{x({x}^{5}+1)^{4}}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x) = \\bbox[2pt,Gainsboro]{-3x^5+2}.\n$$" :db/ensure [:question/validate]} {:db/id "question-1d911ae7-875c-567e-a470-7c373f982af8" :question/id #uuid "1d911ae7-875c-567e-a470-7c373f982af8" :question/math-academy-id "q-343542" :question/problem "Given that $y=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x},$ find ${y}^{′}.$\n\n${y}^{′}=(\\operatorname{sin}⁡x)^{x}($\n{{field-1}}$\\,+\\,2x+x({x}^{2}+1)\\operatorname{cot}⁡(x))$" :question/worked-solution "We have the function \n\n$$\ny=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+1)+x\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{2}+1}\\cdot (2x)+(x)^{′}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x{(\\operatorname{ln}⁡(\\operatorname{sin}⁡x))}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+1)(\\operatorname{sin}⁡x)^{x}(\\frac{2x}{{x}^{2}+1}+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x\\operatorname{cot}⁡x) \\\\  & =(\\operatorname{sin}⁡x)^{x}(2x+({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+x({x}^{2}+1)\\operatorname{cot}⁡x) \\\\  & =(\\operatorname{sin}⁡x)^{x}(({x}^{2}+1)\\operatorname{ln}⁡(\\operatorname{sin}⁡x)+2x+x({x}^{2}+1)\\operatorname{cot}⁡x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2f1e7c1d-bc39-5ec5-a66f-51aa65b8b878"] :db/ensure [:question/validate]} {:db/id "answer-field-2f1e7c1d-bc39-5ec5-a66f-51aa65b8b878" :answer-field/id #uuid "2f1e7c1d-bc39-5ec5-a66f-51aa65b8b878" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-237677c3-f4bf-5920-adb2-829ac28f98fd" :answer-field/choices ["answer-237677c3-f4bf-5920-adb2-829ac28f98fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-237677c3-f4bf-5920-adb2-829ac28f98fd" :answer/id #uuid "237677c3-f4bf-5920-adb2-829ac28f98fd" :answer/type :answer.type/math :answer/value "(x^2+1)\\ln(\\sin x)" :db/ensure [:answer/validate]} {:db/id "question-62910e77-69f8-56ea-ac31-ee2dbfe3c8ff" :question/id #uuid "62910e77-69f8-56ea-ac31-ee2dbfe3c8ff" :question/math-academy-id "q-312655" :question/problem "Given that $y=({x}^{3}-2x){e}^{{x}^{4}+5x},$ find ${y}^{′}.$\n\n${y}^{′}={e}^{{x}^{4}+5x}($\n{{field-1}}${x}^{6}\\,-$\n{{field-2}}${x}^{4}\\,+$\n{{field-3}}${x}^{3}+3{x}^{2}-10x-2)$" :question/worked-solution "We have the function \n\n$$\ny=({x}^{3}-2x){e}^{{x}^{4}+5x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{3}-2x){e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+\\operatorname{ln}⁡({e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5 \\\\ \\frac{{y}^{′}}{y} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{3}-2x){e}^{{x}^{4}+5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{3}-2x){e}^{{x}^{4}+5x}(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5) \\\\  & ={e}^{{x}^{4}+5x}[3{x}^{2}-2+(4{x}^{3}+5)({x}^{3}-2x)] \\\\  & ={e}^{{x}^{4}+5x}(4{x}^{6}-8{x}^{4}+5{x}^{3}+3{x}^{2}-10x-2)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f5316a49-e71e-5b2a-be34-e3d00be0b5c1" "answer-field-e218e9f7-9f97-55c2-8470-2d5b2b9d85fc" "answer-field-81cfe4de-fb10-510e-9446-d496d731b1e0"] :db/ensure [:question/validate]} {:db/id "answer-field-f5316a49-e71e-5b2a-be34-e3d00be0b5c1" :answer-field/id #uuid "f5316a49-e71e-5b2a-be34-e3d00be0b5c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-64e1cc7c-fdf8-54e9-af16-e127bdf5e7b4" :answer-field/choices ["answer-64e1cc7c-fdf8-54e9-af16-e127bdf5e7b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-64e1cc7c-fdf8-54e9-af16-e127bdf5e7b4" :answer/id #uuid "64e1cc7c-fdf8-54e9-af16-e127bdf5e7b4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-e218e9f7-9f97-55c2-8470-2d5b2b9d85fc" :answer-field/id #uuid "e218e9f7-9f97-55c2-8470-2d5b2b9d85fc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-03563df1-ba6d-5b1c-a0b5-5ad046bfe9bb" :answer-field/choices ["answer-03563df1-ba6d-5b1c-a0b5-5ad046bfe9bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-03563df1-ba6d-5b1c-a0b5-5ad046bfe9bb" :answer/id #uuid "03563df1-ba6d-5b1c-a0b5-5ad046bfe9bb" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-81cfe4de-fb10-510e-9446-d496d731b1e0" :answer-field/id #uuid "81cfe4de-fb10-510e-9446-d496d731b1e0" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-320e3fd9-f5be-5ba8-b2a9-0494b08fbfc4" :answer-field/choices ["answer-320e3fd9-f5be-5ba8-b2a9-0494b08fbfc4"] :db/ensure [:answer-field/validate]} {:db/id "answer-320e3fd9-f5be-5ba8-b2a9-0494b08fbfc4" :answer/id #uuid "320e3fd9-f5be-5ba8-b2a9-0494b08fbfc4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-61a2565a-e401-5260-aae7-f12b167eb293" :question/id #uuid "61a2565a-e401-5260-aae7-f12b167eb293" :question/math-academy-id "q-312658" :question/problem "Given that $y={x}^{x}\\operatorname{tan}⁡x,$ find ${y}^{′}.$\n\n${y}^{′}={x}^{x}($\n{{field-1}}$+\\operatorname{tan}⁡(x)+{sec}^{2}⁡(x))$" :question/worked-solution "We have the function \n\n$$\ny={x}^{x}\\operatorname{tan}⁡x.\n$$\n\nFirst, we find the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x}\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{x})+\\operatorname{ln}⁡(\\operatorname{tan}⁡x) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\operatorname{ln}⁡x+x{(\\operatorname{ln}⁡x)}^{′}+{[\\operatorname{ln}⁡(\\operatorname{tan}⁡x)]}^{′} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}+\\frac{1}{\\operatorname{tan}⁡x}\\cdot {sec}^{2}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\frac{1}{{cos}^{2}⁡x} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x})\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{x}\\operatorname{tan}⁡x:$\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{x}\\operatorname{tan}⁡x(\\operatorname{ln}⁡x+1+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\operatorname{tan}⁡x) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{{cos}^{2}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+{sec}^{2}⁡x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6bed9cfc-3a69-5d51-ba57-741bfaabbf0a"] :db/ensure [:question/validate]} {:db/id "answer-field-6bed9cfc-3a69-5d51-ba57-741bfaabbf0a" :answer-field/id #uuid "6bed9cfc-3a69-5d51-ba57-741bfaabbf0a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0f4721e6-a280-5e36-9c3e-3d0197e080fb" :answer-field/choices ["answer-0f4721e6-a280-5e36-9c3e-3d0197e080fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f4721e6-a280-5e36-9c3e-3d0197e080fb" :answer/id #uuid "0f4721e6-a280-5e36-9c3e-3d0197e080fb" :answer/type :answer.type/math :answer/value "\\tan(x)\\ln(x)" :db/ensure [:answer/validate]} {:db/id "question-174736f7-0588-55bb-bfa7-155dc6d18a73" :question/id #uuid "174736f7-0588-55bb-bfa7-155dc6d18a73" :question/math-academy-id "q-138800" :question/problem "Consider the function $y=({x}^{4}+1){3}^{x+4}.$ The derivative of this function is given by\n\n$$\n{y}^{′}={3}^{x+4}\\cdot (a{x}^{4}+b{x}^{3}+c).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "We have the function \n\n$$\ny=({x}^{4}+1){3}^{x+4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+1){3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+\\operatorname{ln}⁡({3}^{x+4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{4}+1)+(x+4)\\operatorname{ln}⁡(3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+1}\\cdot 4{x}^{3}+\\operatorname{ln}⁡(3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3))\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{4}+1){3}^{x+4}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{4}+1){3}^{x+4}(\\frac{4{x}^{3}}{{x}^{4}+1}+\\operatorname{ln}⁡(3)) \\\\  & ={3}^{x+4}(4{x}^{3}+\\operatorname{ln}⁡(3)({x}^{4}+1)) \\\\  & ={3}^{x+4}(\\operatorname{ln}⁡(3){x}^{4}+4{x}^{3}+\\operatorname{ln}⁡(3))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=\\operatorname{ln}⁡(3)+4+\\operatorname{ln}⁡(3)=4+2\\operatorname{ln}⁡(3).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dde27e2d-4a7c-5959-b482-0d3df3d32fab"] :db/ensure [:question/validate]} {:db/id "answer-field-dde27e2d-4a7c-5959-b482-0d3df3d32fab" :answer-field/id #uuid "dde27e2d-4a7c-5959-b482-0d3df3d32fab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4cefdade-e796-5084-a7a3-e6383c60ef43" :answer-field/choices ["answer-4cefdade-e796-5084-a7a3-e6383c60ef43" "answer-9e897ff6-74eb-563e-ad6f-9b136723fdd4" "answer-c5bd5208-208d-5b00-a104-e894b45eded1" "answer-629e95fd-c8c0-5fb3-a0d4-61fa413fa7de" "answer-698dcec7-e3e1-5e7e-94be-301f09412429"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cefdade-e796-5084-a7a3-e6383c60ef43" :answer/id #uuid "4cefdade-e796-5084-a7a3-e6383c60ef43" :answer/type :answer.type/math :answer/value "4+2\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "answer-9e897ff6-74eb-563e-ad6f-9b136723fdd4" :answer/id #uuid "9e897ff6-74eb-563e-ad6f-9b136723fdd4" :answer/type :answer.type/math :answer/value "4+\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "answer-c5bd5208-208d-5b00-a104-e894b45eded1" :answer/id #uuid "c5bd5208-208d-5b00-a104-e894b45eded1" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "answer-629e95fd-c8c0-5fb3-a0d4-61fa413fa7de" :answer/id #uuid "629e95fd-c8c0-5fb3-a0d4-61fa413fa7de" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-698dcec7-e3e1-5e7e-94be-301f09412429" :answer/id #uuid "698dcec7-e3e1-5e7e-94be-301f09412429" :answer/type :answer.type/math :answer/value "6+2\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "question-b9ab7545-6c81-5c20-9f25-5d780715f99d" :question/id #uuid "b9ab7545-6c81-5c20-9f25-5d780715f99d" :question/math-academy-id "q-343327" :question/problem "Given that $y={(2x-3)}^{7}{({x}^{3}+5)}^{4},$ find ${y}^{′}.$\n\n${y}^{′}={(2x-3)}^{6}{({x}^{3}+5)}^{3}($\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$)$" :question/worked-solution "We have the function \n\n$$\ny={(2x-3)}^{7}{({x}^{3}+5)}^{4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7}{({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7})+\\operatorname{ln}⁡({({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5} \\\\ \\frac{{y}^{′}}{y} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5})\\end{aligned}\n$$\n\nFinally, we substitute $y={(2x-3)}^{7}{({x}^{3}+5)}^{4}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={(2x-3)}^{7}{({x}^{3}+5)}^{4}(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}) \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}[14({x}^{3}+5)+12{x}^{2}(2x-3)] \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}(38{x}^{3}-36{x}^{2}+70)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c1aa8109-3dc2-5c64-ba41-e3f530fba656" "answer-field-5b0091fa-b5a4-5939-b660-79b995ca2d23" "answer-field-7c634e48-9a53-537b-8310-97d5118fb24d"] :db/ensure [:question/validate]} {:db/id "answer-field-c1aa8109-3dc2-5c64-ba41-e3f530fba656" :answer-field/id #uuid "c1aa8109-3dc2-5c64-ba41-e3f530fba656" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b7e7a9b3-3d4f-54b8-8563-cde99f24e6bc" :answer-field/choices ["answer-b7e7a9b3-3d4f-54b8-8563-cde99f24e6bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7e7a9b3-3d4f-54b8-8563-cde99f24e6bc" :answer/id #uuid "b7e7a9b3-3d4f-54b8-8563-cde99f24e6bc" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "answer-field-5b0091fa-b5a4-5939-b660-79b995ca2d23" :answer-field/id #uuid "5b0091fa-b5a4-5939-b660-79b995ca2d23" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d7fc885f-4e1a-55a5-802c-ac89deca17cd" :answer-field/choices ["answer-d7fc885f-4e1a-55a5-802c-ac89deca17cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7fc885f-4e1a-55a5-802c-ac89deca17cd" :answer/id #uuid "d7fc885f-4e1a-55a5-802c-ac89deca17cd" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-field-7c634e48-9a53-537b-8310-97d5118fb24d" :answer-field/id #uuid "7c634e48-9a53-537b-8310-97d5118fb24d" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cf1bee4f-faf3-5c66-a6e9-0247b5788e19" :answer-field/choices ["answer-cf1bee4f-faf3-5c66-a6e9-0247b5788e19"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf1bee4f-faf3-5c66-a6e9-0247b5788e19" :answer/id #uuid "cf1bee4f-faf3-5c66-a6e9-0247b5788e19" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "question-8a442047-ed6e-5bb4-89b9-beaee4b1e553" :question/id #uuid "8a442047-ed6e-5bb4-89b9-beaee4b1e553" :question/math-academy-id "q-338291" :question/problem "Consider the function $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.$  Find the derivative of $y.$\n\n| ${y}^{′}$ | $=$ | $(x+2)^{3}\\,(-5{x}^{3}\\,-$\n{{field-1}}${x}^{2}\\,+$ \n{{field-2}}$x\\,-$\n{{field-3}}$)$ |\n| --- | --- | --- |\n|  |  | ${({x}^{3}+2x-1)}^{4}$ |" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+2)^{4})-\\operatorname{ln}⁡({({x}^{3}+2x-1)}^{3}) \\\\ \\operatorname{ln}⁡y & =4\\operatorname{ln}⁡(x+2)-3\\operatorname{ln}⁡({x}^{3}+2x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x+2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡({x}^{3}+2x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4\\cdot \\frac{1}{x+2}-3\\cdot \\frac{1}{{x}^{3}+2x-1}\\cdot (3{x}^{2}+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{3(3{x}^{2}+2)}{{x}^{3}+2x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{4({x}^{3}+2x-1)-(x+2)(9{x}^{2}+6)}{(x+2)({x}^{3}+2x-1)}) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{-5{x}^{3}-18{x}^{2}+2x-16}{(x+2)({x}^{3}+2x-1)}) \\\\  & =\\frac{(x+2)^{3}(-5{x}^{3}-18{x}^{2}+2x-16)}{{({x}^{3}+2x-1)}^{4}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-274547bb-be34-5b65-bb9d-f32876fabd37" "answer-field-b03d9a12-bbbf-5ee1-a420-92022427414d" "answer-field-94665d5f-2175-540b-accc-e742e344e1b0"] :db/ensure [:question/validate]} {:db/id "answer-field-274547bb-be34-5b65-bb9d-f32876fabd37" :answer-field/id #uuid "274547bb-be34-5b65-bb9d-f32876fabd37" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-102790ff-7839-5d1c-a7c1-c89c090c0d2a" :answer-field/choices ["answer-102790ff-7839-5d1c-a7c1-c89c090c0d2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-102790ff-7839-5d1c-a7c1-c89c090c0d2a" :answer/id #uuid "102790ff-7839-5d1c-a7c1-c89c090c0d2a" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-field-b03d9a12-bbbf-5ee1-a420-92022427414d" :answer-field/id #uuid "b03d9a12-bbbf-5ee1-a420-92022427414d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5274db64-5e9a-58d1-a778-b4f7735c7525" :answer-field/choices ["answer-5274db64-5e9a-58d1-a778-b4f7735c7525"] :db/ensure [:answer-field/validate]} {:db/id "answer-5274db64-5e9a-58d1-a778-b4f7735c7525" :answer/id #uuid "5274db64-5e9a-58d1-a778-b4f7735c7525" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-94665d5f-2175-540b-accc-e742e344e1b0" :answer-field/id #uuid "94665d5f-2175-540b-accc-e742e344e1b0" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f4323142-e936-5cd3-b6de-3092378faa67" :answer-field/choices ["answer-f4323142-e936-5cd3-b6de-3092378faa67"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4323142-e936-5cd3-b6de-3092378faa67" :answer/id #uuid "f4323142-e936-5cd3-b6de-3092378faa67" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "question-adde1803-10ec-5c3d-8c04-d7e2c5d99587" :question/id #uuid "adde1803-10ec-5c3d-8c04-d7e2c5d99587" :question/math-academy-id "q-138830" :question/problem "Consider the function $y=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{(x+3)^{5}(x+8)^{4}}{{sin}^{8}⁡x}(ax+63-8({x}^{2}+bx+c)\\operatorname{cot}⁡x).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+3)^{6})+\\operatorname{ln}⁡((x+8)^{5})-\\operatorname{ln}⁡({sin}^{8}⁡x) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\n \n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{x+3}+5\\cdot \\frac{1}{x+8}-8\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6(x+8)+5(x+3)-8\\operatorname{cot}⁡x(x+3)(x+8)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6x+48+5x+15-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{5}(x+8)^{4}}{{sin}^{8}⁡x}(11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=11+11+24=46.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-13bb00dc-f20f-5ab2-8e37-6185dcb84a29"] :db/ensure [:question/validate]} {:db/id "answer-field-13bb00dc-f20f-5ab2-8e37-6185dcb84a29" :answer-field/id #uuid "13bb00dc-f20f-5ab2-8e37-6185dcb84a29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eef1c07b-39fe-56ff-ad05-22dd4b396724" :answer-field/choices ["answer-24dcf1bc-40b1-5496-a498-3a7dae4ffe85" "answer-e2265b1b-5fa7-5e22-a840-d2ec09a5ad1a" "answer-94c691dd-0578-5e12-9cc1-90a7a7bb4085" "answer-a1f872ba-2453-55d3-97e1-d1431eaa6668" "answer-eef1c07b-39fe-56ff-ad05-22dd4b396724"] :db/ensure [:answer-field/validate]} {:db/id "answer-24dcf1bc-40b1-5496-a498-3a7dae4ffe85" :answer/id #uuid "24dcf1bc-40b1-5496-a498-3a7dae4ffe85" :answer/type :answer.type/math :answer/value "271" :db/ensure [:answer/validate]} {:db/id "answer-e2265b1b-5fa7-5e22-a840-d2ec09a5ad1a" :answer/id #uuid "e2265b1b-5fa7-5e22-a840-d2ec09a5ad1a" :answer/type :answer.type/math :answer/value "321" :db/ensure [:answer/validate]} {:db/id "answer-94c691dd-0578-5e12-9cc1-90a7a7bb4085" :answer/id #uuid "94c691dd-0578-5e12-9cc1-90a7a7bb4085" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "answer-a1f872ba-2453-55d3-97e1-d1431eaa6668" :answer/id #uuid "a1f872ba-2453-55d3-97e1-d1431eaa6668" :answer/type :answer.type/math :answer/value "44" :db/ensure [:answer/validate]} {:db/id "answer-eef1c07b-39fe-56ff-ad05-22dd4b396724" :answer/id #uuid "eef1c07b-39fe-56ff-ad05-22dd4b396724" :answer/type :answer.type/math :answer/value "46" :db/ensure [:answer/validate]} {:db/id "question-310e9298-b624-54d9-ac03-bed77b7fdecc" :question/id #uuid "310e9298-b624-54d9-ac03-bed77b7fdecc" :question/math-academy-id "q-343350" :question/problem "Consider the function $y=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}.$  Find ${y}^{′}.$\n\n| ${y}^{′}$ | $=$ | ${6}^{\\operatorname{cos}⁡x}\\,($\n{{field-1}}$(x-2)(3-x)\\operatorname{sin}⁡x\\,+$\n{{field-2}}$x\\,-$\n{{field-3}}$)$ |\n| --- | --- | --- |\n|  |  | $(x-2)^{5}(3-x)^{4}$ |" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient, product, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({6}^{\\operatorname{cos}⁡x})-\\operatorname{ln}⁡((x-2)^{4}(3-x)^{3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-(\\operatorname{ln}⁡((x-2)^{4})+\\operatorname{ln}⁡((3-x)^{3})) \\\\ \\operatorname{ln}⁡y & =\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6-4\\operatorname{ln}⁡(x-2)-3\\operatorname{ln}⁡(3-x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\,\\operatorname{ln}⁡6)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x-2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(3-x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-4\\cdot \\frac{1}{x-2}-3\\cdot \\frac{-1}{3-x} \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}(-(\\operatorname{ln}⁡6)\\operatorname{sin}⁡x-\\frac{4}{x-2}+\\frac{3}{3-x}) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x-4(3-x)+3(x-2)}{(x-2)(3-x)}) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}}{(x-2)^{4}(3-x)^{3}}(\\frac{-(\\operatorname{ln}⁡6)(x-2)(3-x)\\operatorname{sin}⁡x+7x-18}{(x-2)(3-x)}) \\\\  & =\\frac{{6}^{\\operatorname{cos}⁡x}(-\\operatorname{ln}⁡6(x-2)(3-x)\\operatorname{sin}⁡x+7x-18)}{(x-2)^{5}(3-x)^{4}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7487540a-070b-5d24-9ba2-dc636972e043" "answer-field-d150bf24-0895-5aa8-98a7-c4a97ebe264b" "answer-field-a0efc8ad-b4c8-5f06-a724-3416448817ff"] :db/ensure [:question/validate]} {:db/id "answer-field-7487540a-070b-5d24-9ba2-dc636972e043" :answer-field/id #uuid "7487540a-070b-5d24-9ba2-dc636972e043" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4ebc9a01-e27f-509b-a68a-42b56dc2ad7d" :answer-field/choices ["answer-4ebc9a01-e27f-509b-a68a-42b56dc2ad7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ebc9a01-e27f-509b-a68a-42b56dc2ad7d" :answer/id #uuid "4ebc9a01-e27f-509b-a68a-42b56dc2ad7d" :answer/type :answer.type/math :answer/value "-\\ln(6)" :db/ensure [:answer/validate]} {:db/id "answer-field-d150bf24-0895-5aa8-98a7-c4a97ebe264b" :answer-field/id #uuid "d150bf24-0895-5aa8-98a7-c4a97ebe264b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-97af42c5-8f26-50fc-a29e-fb1a80f1a04f" :answer-field/choices ["answer-97af42c5-8f26-50fc-a29e-fb1a80f1a04f"] :db/ensure [:answer-field/validate]} {:db/id "answer-97af42c5-8f26-50fc-a29e-fb1a80f1a04f" :answer/id #uuid "97af42c5-8f26-50fc-a29e-fb1a80f1a04f" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-a0efc8ad-b4c8-5f06-a724-3416448817ff" :answer-field/id #uuid "a0efc8ad-b4c8-5f06-a724-3416448817ff" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ec54cd01-acca-5a25-833a-60eab750baf4" :answer-field/choices ["answer-ec54cd01-acca-5a25-833a-60eab750baf4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec54cd01-acca-5a25-833a-60eab750baf4" :answer/id #uuid "ec54cd01-acca-5a25-833a-60eab750baf4" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "question-11c48698-c6fd-5725-a4b0-1737e6fdc309" :question/id #uuid "11c48698-c6fd-5725-a4b0-1737e6fdc309" :question/math-academy-id "q-138831" :question/problem "Consider the function $y=\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=-\\frac{(x+6)^{2}{cos}^{3}⁡x}{(x-1)^{8}}((ax+45)\\operatorname{cos}⁡x+(4{x}^{2}+bx+c)\\operatorname{sin}⁡x).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+6)^{3})+\\operatorname{ln}⁡({cos}^{4}⁡x)-\\operatorname{ln}⁡((x-1)^{7}) \\\\ \\operatorname{ln}⁡y & =3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡(x+6)+4\\operatorname{ln}⁡(\\operatorname{cos}⁡x)-7\\operatorname{ln}⁡(x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =3\\cdot \\frac{1}{x+6}+4\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x)-7\\cdot \\frac{1}{x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}(\\frac{3}{x+6}-4\\operatorname{tan}⁡x-\\frac{7}{x-1}) \\\\  & =\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}(\\frac{3(x-1)-4\\operatorname{tan}⁡x(x+6)(x-1)-7(x+6)}{(x+6)(x-1)}) \\\\  & =\\frac{(x+6)^{3}{cos}^{4}⁡x}{(x-1)^{7}}(\\frac{-4x-45-4\\operatorname{tan}⁡x({x}^{2}+5x-6)}{(x+6)(x-1)}) \\\\  & =-\\frac{(x+6)^{2}{cos}^{4}⁡x}{(x-1)^{8}}(4x+45+4\\operatorname{tan}⁡x({x}^{2}+5x-6)) \\\\  & =-\\frac{(x+6)^{2}{cos}^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+4\\operatorname{tan}⁡x({x}^{2}+5x-6)\\operatorname{cos}⁡x) \\\\  & =-\\frac{(x+6)^{2}{cos}^{3}⁡x}{(x-1)^{8}}((4x+45)\\operatorname{cos}⁡x+\\operatorname{sin}⁡x(4{x}^{2}+20x-24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=4+20+(-24)=0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c3dff71e-7253-5db5-a8db-526f8787e942"] :db/ensure [:question/validate]} {:db/id "answer-field-c3dff71e-7253-5db5-a8db-526f8787e942" :answer-field/id #uuid "c3dff71e-7253-5db5-a8db-526f8787e942" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d2bacdde-7997-50ac-944f-7a50e4a49e86" :answer-field/choices ["answer-deac3608-20ae-52c0-97b0-276c7fcb4d55" "answer-3e37cd6e-52b0-57de-acb7-d9a7a4ef0fe1" "answer-d2bacdde-7997-50ac-944f-7a50e4a49e86" "answer-6c234f23-48fe-556c-a0b1-24c477bfbdfa" "answer-39eac370-b597-5b13-a139-ed248af8a490"] :db/ensure [:answer-field/validate]} {:db/id "answer-deac3608-20ae-52c0-97b0-276c7fcb4d55" :answer/id #uuid "deac3608-20ae-52c0-97b0-276c7fcb4d55" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-3e37cd6e-52b0-57de-acb7-d9a7a4ef0fe1" :answer/id #uuid "3e37cd6e-52b0-57de-acb7-d9a7a4ef0fe1" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-d2bacdde-7997-50ac-944f-7a50e4a49e86" :answer/id #uuid "d2bacdde-7997-50ac-944f-7a50e4a49e86" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-6c234f23-48fe-556c-a0b1-24c477bfbdfa" :answer/id #uuid "6c234f23-48fe-556c-a0b1-24c477bfbdfa" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-39eac370-b597-5b13-a139-ed248af8a490" :answer/id #uuid "39eac370-b597-5b13-a139-ed248af8a490" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-dbe4c4ed-7bf7-5234-8564-800989eb5aa4" :question/id #uuid "dbe4c4ed-7bf7-5234-8564-800989eb5aa4" :question/math-academy-id "q-138839" :question/problem "Consider the function $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}((x+2)^{2}+g(x)).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+1)^{{x}^{2}})-\\operatorname{ln}⁡({e}^{2-4x}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\operatorname{ln}⁡(x+1)-(2-4x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{ln}⁡(x+1)-2+4x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\operatorname{ln}⁡(x+1)+{x}^{2}\\cdot \\frac{1}{x+1}+4 \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4) \\\\  & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}(\\frac{2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)}{x+1}) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4x+4) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+(x+2)^{2})\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2x(x+1)\\operatorname{ln}⁡(x+1).\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-63b209a8-1c66-5330-a9ec-0e55e08cba8c"] :db/ensure [:question/validate]} {:db/id "answer-field-63b209a8-1c66-5330-a9ec-0e55e08cba8c" :answer-field/id #uuid "63b209a8-1c66-5330-a9ec-0e55e08cba8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0f59a9ba-364e-508e-a41a-55a558b2bb49" :answer-field/choices ["answer-9e556be2-fc3f-5682-8727-573dea82908b" "answer-0f59a9ba-364e-508e-a41a-55a558b2bb49" "answer-75b16ee9-4f9f-5d41-b9b6-01fc0fada42c" "answer-478822c2-e030-5e90-884b-19998c062866" "answer-cb83d552-a42d-5c11-aa25-bd36f59bc3ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e556be2-fc3f-5682-8727-573dea82908b" :answer/id #uuid "9e556be2-fc3f-5682-8727-573dea82908b" :answer/type :answer.type/math :answer/value "2x(x+1)\\operatorname{ln}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-0f59a9ba-364e-508e-a41a-55a558b2bb49" :answer/id #uuid "0f59a9ba-364e-508e-a41a-55a558b2bb49" :answer/type :answer.type/math :answer/value "2x(x+1)\\operatorname{ln}⁡(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-75b16ee9-4f9f-5d41-b9b6-01fc0fada42c" :answer/id #uuid "75b16ee9-4f9f-5d41-b9b6-01fc0fada42c" :answer/type :answer.type/math :answer/value "x(x+1)\\operatorname{ln}⁡(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-478822c2-e030-5e90-884b-19998c062866" :answer/id #uuid "478822c2-e030-5e90-884b-19998c062866" :answer/type :answer.type/math :answer/value "x(x+2)\\operatorname{ln}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-cb83d552-a42d-5c11-aa25-bd36f59bc3ed" :answer/id #uuid "cb83d552-a42d-5c11-aa25-bd36f59bc3ed" :answer/type :answer.type/math :answer/value "x(x+2)\\operatorname{ln}⁡(x+1)" :db/ensure [:answer/validate]} {:db/id "question-254041d3-aef5-5074-80f4-67b8b1344bc0" :question/id #uuid "254041d3-aef5-5074-80f4-67b8b1344bc0" :question/math-academy-id "q-312672" :question/problem "Given that $y=\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}},$ find ${y}^{′}.$\n\n${y}^{′}=\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}($\n{{field-1}}$+\\,\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8))$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}} \\\\  & =\\frac{\\sqrt{{({x}^{4}+2{x}^{2}+8)}^{2}}}{\\sqrt{\\operatorname{cos}⁡x}} \\\\  & =\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{x}^{4}+2{x}^{2}+8}{(\\operatorname{cos}⁡x)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\operatorname{ln}⁡((\\operatorname{cos}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{4}+2{x}^{2}+8)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{{x}^{4}+2{x}^{2}+8}\\cdot (4{x}^{3}+4x)-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{cos}⁡x}\\cdot (-\\operatorname{sin}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4{x}^{3}+4x}{{x}^{4}+2{x}^{2}+8}+\\frac{\\operatorname{tan}⁡x}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{({x}^{4}+2{x}^{2}+8)}^{2}}{\\operatorname{cos}⁡x}}\\cdot \\frac{1}{2}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x) \\\\  & =\\frac{|{x}^{4}+2{x}^{2}+8|}{2\\sqrt{\\operatorname{cos}⁡x}}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nSince ${x}^{4}+2{x}^{2}+8>0\\text{ }∀x\\in R$, so $|{x}^{4}+2{x}^{2}+8|={x}^{4}+2{x}^{2}+8$ and we have:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{x}^{4}+2{x}^{2}+8}{2\\sqrt{\\operatorname{cos}⁡x}}(\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}+\\operatorname{tan}⁡x) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}[\\frac{8{x}^{3}+8x}{{x}^{4}+2{x}^{2}+8}\\cdot ({x}^{4}+2{x}^{2}+8)+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8)] \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡x}}(8{x}^{3}+8x+\\operatorname{tan}⁡x({x}^{4}+2{x}^{2}+8))\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b1cca9dd-6ad8-57a8-a947-88e8f34aa52d"] :db/ensure [:question/validate]} {:db/id "answer-field-b1cca9dd-6ad8-57a8-a947-88e8f34aa52d" :answer-field/id #uuid "b1cca9dd-6ad8-57a8-a947-88e8f34aa52d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-419792fe-6389-5363-a771-125381c66945" :answer-field/choices ["answer-419792fe-6389-5363-a771-125381c66945"] :db/ensure [:answer-field/validate]} {:db/id "answer-419792fe-6389-5363-a771-125381c66945" :answer/id #uuid "419792fe-6389-5363-a771-125381c66945" :answer/type :answer.type/math :answer/value "8x^3+8x" :db/ensure [:answer/validate]} {:db/id "question-06abf62c-6dfa-52f6-818c-3858ac967b34" :question/id #uuid "06abf62c-6dfa-52f6-818c-3858ac967b34" :question/math-academy-id "q-138850" :question/problem "Consider the function $y=({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+2x)^{5}}{3\\sqrt[3]{{sin}^{2}⁡x}}((ax+36)\\operatorname{sin}⁡x+(b{x}^{2}+cx)\\operatorname{cos}⁡x)\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x} \\\\  & =({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6}(\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2x)^{6})+\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/3}) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡({x}^{2}+2x)+\\frac{1}{3}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)+\\frac{1}{3}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot (\\operatorname{cos}⁡x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3})\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+2x)^{6}\\sqrt{\\operatorname{sin}⁡x}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cot}⁡x}{3}) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}(\\frac{12(x+1)}{{x}^{2}+2x}+\\frac{\\operatorname{cos}⁡x}{3\\operatorname{sin}⁡x}) \\\\  & =({x}^{2}+2x)^{6}\\sqrt[3]{\\operatorname{sin}⁡x}(\\frac{36(x+1)\\operatorname{sin}⁡x+({x}^{2}+2x)\\operatorname{cos}⁡x}{3({x}^{2}+2x)\\operatorname{sin}⁡x}) \\\\  & =\\frac{({x}^{2}+2x)^{5}}{3\\sqrt[3]{{sin}^{2}⁡x}}((36x+36)\\operatorname{sin}⁡x+(1{x}^{2}+2x)\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=36+1+2=39.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2b45ba0-9d41-52b1-8d31-cba0ed77bf02"] :db/ensure [:question/validate]} {:db/id "answer-field-c2b45ba0-9d41-52b1-8d31-cba0ed77bf02" :answer-field/id #uuid "c2b45ba0-9d41-52b1-8d31-cba0ed77bf02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27b15c20-ae96-5510-bdf6-238327aebb07" :answer-field/choices ["answer-cfa37242-7820-582d-b32a-092b97e43ab6" "answer-9fa83dc4-ef7c-5fb9-9ca5-7ad2f609a832" "answer-f9347296-ee2c-5eec-91b9-fff04cdeed07" "answer-9420b75f-9ddc-56f2-8501-2ed81e404fc6" "answer-27b15c20-ae96-5510-bdf6-238327aebb07"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfa37242-7820-582d-b32a-092b97e43ab6" :answer/id #uuid "cfa37242-7820-582d-b32a-092b97e43ab6" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "answer-9fa83dc4-ef7c-5fb9-9ca5-7ad2f609a832" :answer/id #uuid "9fa83dc4-ef7c-5fb9-9ca5-7ad2f609a832" :answer/type :answer.type/math :answer/value "34" :db/ensure [:answer/validate]} {:db/id "answer-f9347296-ee2c-5eec-91b9-fff04cdeed07" :answer/id #uuid "f9347296-ee2c-5eec-91b9-fff04cdeed07" :answer/type :answer.type/math :answer/value "37" :db/ensure [:answer/validate]} {:db/id "answer-9420b75f-9ddc-56f2-8501-2ed81e404fc6" :answer/id #uuid "9420b75f-9ddc-56f2-8501-2ed81e404fc6" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "answer-27b15c20-ae96-5510-bdf6-238327aebb07" :answer/id #uuid "27b15c20-ae96-5510-bdf6-238327aebb07" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "question-76085196-6a2f-5c76-90cb-5c742aa98a2b" :question/id #uuid "76085196-6a2f-5c76-90cb-5c742aa98a2b" :question/math-academy-id "q-138849" :question/problem "Consider the function $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\sqrt{{x}^{2}+1}(x-3)^{3}(a{x}^{2}+bx+c).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}} \\\\  & =\\sqrt{({x}^{2}+1)^{3}}\\cdot \\sqrt{(x-3)^{8}} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{8/2} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2}(x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2})+\\operatorname{ln}⁡((x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+1}\\cdot 2x+4\\cdot \\frac{1}{x-3} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{3x(x-3)+4({x}^{2}+1)}{({x}^{2}+1)(x-3)}) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}) \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}) \\\\  & =({x}^{2}+1)^{1/2}(x-3)^{3}(7{x}^{2}-9x+4) \\\\  & =\\sqrt{{x}^{2}+1}(x-3)^{3}(7{x}^{2}-9x+4)\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\na+b+c=7+(-9)+4=2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1d436c14-aa02-5c1c-8f96-e30ae5edad2a"] :db/ensure [:question/validate]} {:db/id "answer-field-1d436c14-aa02-5c1c-8f96-e30ae5edad2a" :answer-field/id #uuid "1d436c14-aa02-5c1c-8f96-e30ae5edad2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebacda43-d38a-518b-8124-0083b7f84186" :answer-field/choices ["answer-04c28e5d-0de9-502d-81aa-7351f4920069" "answer-93851dca-79be-57a5-b496-18ef7187487f" "answer-b193db5a-f715-5820-8744-ed3301ee43c4" "answer-ebacda43-d38a-518b-8124-0083b7f84186" "answer-90c27865-1c0b-519b-81bb-de523a0ce9d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-04c28e5d-0de9-502d-81aa-7351f4920069" :answer/id #uuid "04c28e5d-0de9-502d-81aa-7351f4920069" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-93851dca-79be-57a5-b496-18ef7187487f" :answer/id #uuid "93851dca-79be-57a5-b496-18ef7187487f" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-b193db5a-f715-5820-8744-ed3301ee43c4" :answer/id #uuid "b193db5a-f715-5820-8744-ed3301ee43c4" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-ebacda43-d38a-518b-8124-0083b7f84186" :answer/id #uuid "ebacda43-d38a-518b-8124-0083b7f84186" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-90c27865-1c0b-519b-81bb-de523a0ce9d7" :answer/id #uuid "90c27865-1c0b-519b-81bb-de523a0ce9d7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-19b1b664-4a0c-5ebc-8d57-f886d4c9f0c2" :question/id #uuid "19b1b664-4a0c-5ebc-8d57-f886d4c9f0c2" :question/math-academy-id "q-343952" :question/problem "Given that $y=\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}},$ find ${y}^{′}.$\n\n| ${y}^{′}=$ | $-$ | $x($\n{{field-1}}$)$ |\n| --- | --- | --- |\n|  |  | $2(2{x}^{2}+1)^{3}\\sqrt[4]{({x}^{2}+4)^{3}}$ |" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}} \\\\  & ={[\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}]}^{1/4} \\\\  & =({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4}(2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{1/4})+\\operatorname{ln}⁡((2{x}^{2}+1)^{-2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+4)-2\\operatorname{ln}⁡(2{x}^{2}+1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{4}\\cdot \\frac{1}{{x}^{2}+4}\\cdot (2x)-2\\cdot \\frac{1}{2{x}^{2}+1}\\cdot (4x) \\\\ \\frac{{y}^{′}}{y} & =\\frac{x}{2({x}^{2}+4)}-\\frac{8x}{2{x}^{2}+1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1})\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt[4]{\\frac{{x}^{2}+4}{(2{x}^{2}+1)^{8}}}\\cdot \\frac{1}{2}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}(\\frac{x}{{x}^{2}+4}-\\frac{16x}{2{x}^{2}+1}) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}(\\frac{x(2{x}^{2}+1)-16x({x}^{2}+4)}{({x}^{2}+4)(2{x}^{2}+1)}) \\\\  & =\\frac{({x}^{2}+4)^{1/4}}{2(2{x}^{2}+1)^{2}}(\\frac{-14{x}^{3}-63x}{({x}^{2}+4)(2{x}^{2}+1)}) \\\\  & =-\\frac{x(14{x}^{2}+63)}{2(2{x}^{2}+1)^{3}\\sqrt[4]{({x}^{2}+4)^{3}}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-61e10619-0457-5f47-8c3c-d968af092244"] :db/ensure [:question/validate]} {:db/id "answer-field-61e10619-0457-5f47-8c3c-d968af092244" :answer-field/id #uuid "61e10619-0457-5f47-8c3c-d968af092244" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1424a6ad-ac38-52fa-bea7-f95d3db15e1e" :answer-field/choices ["answer-1424a6ad-ac38-52fa-bea7-f95d3db15e1e"] :db/ensure [:answer-field/validate]} {:db/id "answer-1424a6ad-ac38-52fa-bea7-f95d3db15e1e" :answer/id #uuid "1424a6ad-ac38-52fa-bea7-f95d3db15e1e" :answer/type :answer.type/math :answer/value "14x^2+63" :db/ensure [:answer/validate]} {:db/id "question-bc8a78e5-ffc8-5ad6-abfc-11fb82c73f1a" :question/id #uuid "bc8a78e5-ffc8-5ad6-abfc-11fb82c73f1a" :question/math-academy-id "q-138865" :question/problem "Consider the function $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{a{x}^{5}+3{x}^{4}+b{x}^{3}-{x}^{2}+c}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}} \\\\  & =\\frac{\\sqrt{{x}^{4}+2x}}{\\sqrt{{x}^{2}+2x+2}} \\\\  & =\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+2x)^{1/2})-\\operatorname{ln}⁡(({x}^{2}+2x+2)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{4}+2x}\\cdot (4{x}^{3}+2)-\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+2x+2}\\cdot (2x+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{(2{x}^{3}+1)({x}^{2}+2x+2)-(x+1)({x}^{4}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{2{x}^{5}+4{x}^{4}+4{x}^{3}+{x}^{2}+2x+2-({x}^{5}+{x}^{4}+2{x}^{2}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\frac{1{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=1+4+2=7.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-de6a18ff-6676-56f5-b05e-7d4da313f1e4"] :db/ensure [:question/validate]} {:db/id "answer-field-de6a18ff-6676-56f5-b05e-7d4da313f1e4" :answer-field/id #uuid "de6a18ff-6676-56f5-b05e-7d4da313f1e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0164b4c-0fc5-5386-8a13-5df40b0b0015" :answer-field/choices ["answer-1ab36fdc-7bd5-5430-8835-a0815a440065" "answer-6d88a707-e10c-5afc-bea5-52cb9dd63b8c" "answer-9515e64c-16bf-58d0-b027-ae01ea34515a" "answer-7e987b10-51ae-5db1-b678-922798639d7e" "answer-d0164b4c-0fc5-5386-8a13-5df40b0b0015"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ab36fdc-7bd5-5430-8835-a0815a440065" :answer/id #uuid "1ab36fdc-7bd5-5430-8835-a0815a440065" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-6d88a707-e10c-5afc-bea5-52cb9dd63b8c" :answer/id #uuid "6d88a707-e10c-5afc-bea5-52cb9dd63b8c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-9515e64c-16bf-58d0-b027-ae01ea34515a" :answer/id #uuid "9515e64c-16bf-58d0-b027-ae01ea34515a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-7e987b10-51ae-5db1-b678-922798639d7e" :answer/id #uuid "7e987b10-51ae-5db1-b678-922798639d7e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-d0164b4c-0fc5-5386-8a13-5df40b0b0015" :answer/id #uuid "d0164b4c-0fc5-5386-8a13-5df40b0b0015" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186065396 :tutorial/content "When a function $y=y(x)$ contains complex products, quotients, or radicals, we can use logarithmic differentiation to find the derivative $y'(x).$ \n\nFor example, consider the following function: \n\n$$\ny = x^2 \\cdot 2^x\n$$\n\n \n\nOur goal is to find $y'(x).$ To do this, we will use the product rule for logarithms, namely\n\n$$\n\\ln(a b)= \\ln a + \\ln b.\n$$\n\n \n\nWe differentiate our function by following four steps.\n\n**Step 1.** We take the natural logarithm of both sides and apply the product and power rules:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2}\\cdot {2}^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{2})+\\operatorname{ln}⁡({2}^{x}) \\\\ \\operatorname{ln}⁡y & =2\\operatorname{ln}⁡x+x\\operatorname{ln}⁡2\\end{aligned}\n$$\n\n**Step 2.** Next, we differentiate both sides of our equation using implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x+x\\operatorname{ln}⁡2) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2\\cdot (\\operatorname{ln}⁡x)^{′}+(x)^{′}\\cdot \\operatorname{ln}⁡(2) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2\\cdot \\frac{1}{x}+1\\cdot \\operatorname{ln}⁡(2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{2}{x}+\\operatorname{ln}⁡2\\end{aligned}\n$$\n\n**Step 3.** Then, we solve for $y'{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2}{x}+\\operatorname{ln}⁡2)\\end{aligned}\n$$\n\n**Step 4.** Finally, we substitute back our original expression for $y =x^2\\cdot 2^x{:}$\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{2}\\cdot {2}^{x}(\\frac{2}{x}+\\operatorname{ln}⁡2) \\\\  & =x\\cdot {2}^{x+1}+{x}^{2}\\cdot {2}^{x}\\operatorname{ln}⁡2\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186065397 :tutorial/content "In cases where we wish to differentiate a quotient of functions\n\n$$\ny =  f(x) = \\dfrac{g(x)}{h(x)},\n$$\n\nwe can apply the quotient rule for logarithms: \n\n$$\n\\ln \\left(\\dfrac{a}{b}\\right) = \\ln a - \\ln b\n$$\n\n \n\nFor example, let's compute $y',$ where the function $y$ is given by\n\n$$\ny = \\dfrac {e^{x^2}}{(1-2x)^2(x-1)^3}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{2}}}{(1-2x)^{2}(x-1)^{3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{2}})-\\operatorname{ln}⁡((1-2x)^{2})-\\operatorname{ln}⁡((x-1)^{3}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}-2\\operatorname{ln}⁡(1-2x)-3\\operatorname{ln}⁡(x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2\\operatorname{ln}⁡(1-2x)-3\\operatorname{ln}⁡(x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x-2\\cdot \\frac{1}{1-2x}\\cdot (-2)-3\\cdot \\frac{1}{x-1} \\\\ \\frac{{y}^{′}}{y} & =2x+\\frac{4}{1-2x}-\\frac{3}{x-1}\\end{aligned}\n$$\n\nNow, we solve for $y'{:}$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x+\\frac{4}{1-2x}-\\frac{3}{x-1})\\end{aligned}\n$$\n\nFinally, we substitute our expression for $y,$ and simplify:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{2}}}{(1-2x)^{2}(x-1)^{3}}(2x+\\frac{4}{1-2x}-\\frac{3}{x-1}) \\\\  & =\\frac{{e}^{{x}^{2}}}{(1-2x)^{2}(x-1)^{3}}(\\frac{2x(1-2x)(x-1)+4(x-1)-3(1-2x)}{(1-2x)(x-1)}) \\\\  & =\\frac{{e}^{{x}^{2}}}{(1-2x)^{3}(x-1)^{4}}(2x(1-2x)(x-1)+4(x-1)-3(1-2x)) \\\\  & =\\frac{{e}^{{x}^{2}}}{(1-2x)^{3}(x-1)^{4}}(-4{x}^{3}+6{x}^{2}+8x-7) \\\\  & =-\\frac{{e}^{{x}^{2}}}{(1-2x)^{3}(x-1)^{4}}(4{x}^{3}-6{x}^{2}-8x+7) \\\\  & =-\\frac{{e}^{{x}^{2}}(4{x}^{3}-6{x}^{2}-8x+7)}{(1-2x)^{3}(x-1)^{4}}\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186064435 :activity/expected-seconds 1500.0 :db/ensure [:activity/validate]} {:db/id 17592186115337 :knowledge-point/questions ["question-86a019fb-a0e8-5be0-aaf0-3d6271255b32" "question-8a8a59cf-d2d4-5a12-9401-900431259a30"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186114915 :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in(-2,2)$ the graph rises\n\n- For $x\\in(2,5)$ the graph falls\n\n- For $x\\in(5,7)$ the graph is flat\n\n- For $x\\in(7,9)$ the graph rises\n\nTherefore, we conclude that:\n\n- The function is *strictly increasing* on the intervals where it always rises: $(-2,2)$ and $(7,9).$\n\n- The function is *increasing* on the intervals where it never falls: $(-2,2)$ and $(5,9).$" :db/ensure [:question/validate]} {:db/id 17592186115338 :knowledge-point/questions ["question-926951ab-0eab-59e8-a59e-f3b17566f504" "question-0877512d-738e-5955-a71c-cb46e2b35ffc" "question-3116b695-9176-5c93-b86c-7dbbc6db580d" "question-789bcfd1-c565-5f93-94ad-880a68644286"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186114916 :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in (-4,-3)$ the graph rises\n\n- For $x\\in (-3,0)$ the graph falls\n\n- For $x\\in (0,2)$ the graph rises\n\n- For $x\\in (2,4)$ the graph is flat\n\n- For $x\\in (4,5)$ the graph falls\n\nTherefore, we can conclude that:\n\n- The graph is *strictly decreasing* on the intervals where it always falls: $(-3,0)$ and $(4,5).$\n\n- The graph is *decreasing* on the intervals where it never rises: $(-3,0)$ and $(2,5).$" :db/ensure [:question/validate]} {:db/id "question-86a019fb-a0e8-5be0-aaf0-3d6271255b32" :question/id #uuid "86a019fb-a0e8-5be0-aaf0-3d6271255b32" :question/math-academy-id "q-159878" :question/problem "![](images/f1/f1d9c516171eade5488c3247bd20d0bfcafd515e4da7de8aee3fe35174a87e8b.png)\n\nOn which interval is the function $y=f(x)$, shown above, strictly increasing?" :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in (-\\infty ,-2)$ the graph falls\n\n- For $x\\in (-2,0)$ the graph is flat\n\n- For $x\\in (0,2)$ the graph rises\n\n- For $x\\in (2,\\infty )$ the graph falls\n\nThe function is strictly increasing on the intervals where it always rises: $(0,2)$ only." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-08e81c03-c105-508e-82e4-cc768050b45c"] :db/ensure [:question/validate]} {:db/id "answer-field-08e81c03-c105-508e-82e4-cc768050b45c" :answer-field/id #uuid "08e81c03-c105-508e-82e4-cc768050b45c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0f2d9ff-380c-593d-88b2-f03bfb6c454b" :answer-field/choices ["answer-bf65e757-4442-5a0f-86c5-79e9ccf99b0a" "answer-9658c700-bec9-550b-bdbf-ee8f31c9523c" "answer-d0f2d9ff-380c-593d-88b2-f03bfb6c454b" "answer-bd43085b-e350-5dbd-b67f-57e26b0018cf" "answer-9e257b9b-b145-5a50-8cc8-d2b04799983a"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf65e757-4442-5a0f-86c5-79e9ccf99b0a" :answer/id #uuid "bf65e757-4442-5a0f-86c5-79e9ccf99b0a" :answer/type :answer.type/math :answer/value "(-2,2)" :db/ensure [:answer/validate]} {:db/id "answer-9658c700-bec9-550b-bdbf-ee8f31c9523c" :answer/id #uuid "9658c700-bec9-550b-bdbf-ee8f31c9523c" :answer/type :answer.type/math :answer/value "(-\\infty ,-2)" :db/ensure [:answer/validate]} {:db/id "answer-d0f2d9ff-380c-593d-88b2-f03bfb6c454b" :answer/id #uuid "d0f2d9ff-380c-593d-88b2-f03bfb6c454b" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "answer-bd43085b-e350-5dbd-b67f-57e26b0018cf" :answer/id #uuid "bd43085b-e350-5dbd-b67f-57e26b0018cf" :answer/type :answer.type/math :answer/value "(0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-9e257b9b-b145-5a50-8cc8-d2b04799983a" :answer/id #uuid "9e257b9b-b145-5a50-8cc8-d2b04799983a" :answer/type :answer.type/math :answer/value "(2,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-8a8a59cf-d2d4-5a12-9401-900431259a30" :question/id #uuid "8a8a59cf-d2d4-5a12-9401-900431259a30" :question/math-academy-id "q-27850" :question/problem "![](images/2f/2ff5d462cdf3254dde5496a98c284bfec42d8f6d326456fb1f42c19d5e1c9230.png)\n\nOn whi