c4f19fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-14016c8d-bc19-5d72-b676-b62a2c4f19fc" :answer/id #uuid "14016c8d-bc19-5d72-b676-b62a2c4f19fc" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "question-63a331e7-b7cc-5047-a29a-affb9857bb9b" :question/id #uuid "63a331e7-b7cc-5047-a29a-affb9857bb9b" :question/math-academy-id "q-274631" :question/problem "The center of the hyperbola $\\frac{(x-4)^{2}}{16}-\\frac{(y-8)^{2}}{48}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-4)^{2}}{16}-\\frac{(y-8)^{2}}{48}=1\n$$\n\nIn this case, $h=4$ and $k=8.$\n\nTherefore, the center of the hyperbola is $(4,8).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-42f6bf5a-cca0-5a16-a39a-bdde6f400ab1" "answer-field-0b4962c7-003e-5849-8753-3566c3ea7ba5"] :db/ensure [:question/validate]} {:db/id "answer-field-42f6bf5a-cca0-5a16-a39a-bdde6f400ab1" :answer-field/id #uuid "42f6bf5a-cca0-5a16-a39a-bdde6f400ab1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-025c333e-57e0-57a7-82f4-e2b870eb5bf0" :answer-field/choices ["answer-025c333e-57e0-57a7-82f4-e2b870eb5bf0"] :db/ensure [:answer-field/validate]} {:db/id "answer-025c333e-57e0-57a7-82f4-e2b870eb5bf0" :answer/id #uuid "025c333e-57e0-57a7-82f4-e2b870eb5bf0" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-0b4962c7-003e-5849-8753-3566c3ea7ba5" :answer-field/id #uuid "0b4962c7-003e-5849-8753-3566c3ea7ba5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f8a15adb-71e4-5d4e-9c1a-e0c9c83b3b8f" :answer-field/choices ["answer-f8a15adb-71e4-5d4e-9c1a-e0c9c83b3b8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8a15adb-71e4-5d4e-9c1a-e0c9c83b3b8f" :answer/id #uuid "f8a15adb-71e4-5d4e-9c1a-e0c9c83b3b8f" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-6244a3eb-e8b2-58a8-937d-97547605cb0b" :question/id #uuid "6244a3eb-e8b2-58a8-937d-97547605cb0b" :question/math-academy-id "q-274633" :question/problem "The center of the hyperbola $\\frac{(y-1)^{2}}{144}-\\frac{(x-12)^{2}}{64}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-1)^{2}}{{12}^{2}}-\\frac{(x-12)^{2}}{{8}^{2}}=1\n$$\n\nIn this case, we have $h=12$ and $k=1.$\n\nTherefore, the center of the hyperbola is $(\\,12,1\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-62b7dbac-5222-53ad-a279-6fc17ea10361" "answer-field-ae7723be-3116-588d-ac1a-0db45607fb72"] :db/ensure [:question/validate]} {:db/id "answer-field-62b7dbac-5222-53ad-a279-6fc17ea10361" :answer-field/id #uuid "62b7dbac-5222-53ad-a279-6fc17ea10361" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ee939405-f0af-5391-9ecf-c046fa7486dd" :answer-field/choices ["answer-ee939405-f0af-5391-9ecf-c046fa7486dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee939405-f0af-5391-9ecf-c046fa7486dd" :answer/id #uuid "ee939405-f0af-5391-9ecf-c046fa7486dd" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-field-ae7723be-3116-588d-ac1a-0db45607fb72" :answer-field/id #uuid "ae7723be-3116-588d-ac1a-0db45607fb72" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1931ee66-94d1-5905-ad64-03198dc754ea" :answer-field/choices ["answer-1931ee66-94d1-5905-ad64-03198dc754ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-1931ee66-94d1-5905-ad64-03198dc754ea" :answer/id #uuid "1931ee66-94d1-5905-ad64-03198dc754ea" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186083931 :question/problem "What is the center of the hyperbola $\\frac{(y-1)^{2}}{16}-\\frac{(x-3)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nIn this case, we have $h=3$ and $k=1.$\n\nTherefore, the center of the hyperbola is $(3,1).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186082517 :answer-field/correct "answer-4c05ac38-38db-52dd-b117-c6e319b6b30c" :answer-field/choices ["answer-f0620820-a206-5f5c-b470-2c90a9777f22" "answer-4061c534-434f-5d4e-a89b-411fc3bb2c51" "answer-4c05ac38-38db-52dd-b117-c6e319b6b30c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0620820-a206-5f5c-b470-2c90a9777f22" :answer/id #uuid "f0620820-a206-5f5c-b470-2c90a9777f22" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "answer-4061c534-434f-5d4e-a89b-411fc3bb2c51" :answer/id #uuid "4061c534-434f-5d4e-a89b-411fc3bb2c51" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "answer-4c05ac38-38db-52dd-b117-c6e319b6b30c" :answer/id #uuid "4c05ac38-38db-52dd-b117-c6e319b6b30c" :answer/type :answer.type/math :answer/value "(3,1)" :db/ensure [:answer/validate]} {:db/id "question-709ee5be-390b-54a4-bcb8-cf4ff120d569" :question/id #uuid "709ee5be-390b-54a4-bcb8-cf4ff120d569" :question/math-academy-id "q-78865" :question/problem "What is the center of the hyperbola $\\frac{(y-3)^{2}}{2}-\\frac{{x}^{2}}{5}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-3)^{2}}{2}-\\frac{(x-0)^{2}}{5}=1\n$$\n\nIn this case, we have $h=0$ and $k=3.$\n\nTherefore, the center of the hyperbola is $(0,3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-11c82927-4137-5188-9368-c9232622cf2c"] :db/ensure [:question/validate]} {:db/id "answer-field-11c82927-4137-5188-9368-c9232622cf2c" :answer-field/id #uuid "11c82927-4137-5188-9368-c9232622cf2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd1b7408-5650-5154-bbf1-2f364160c73c" :answer-field/choices ["answer-f1651bb5-dc36-5ad7-96ac-589cacf28616" "answer-dd1b7408-5650-5154-bbf1-2f364160c73c" "answer-7015ba8d-eead-5d21-a7c0-ea70edc96a36" "answer-49d0507e-75d8-5a58-ba57-eb286cf73a08" "answer-1579ce49-5129-58f1-977d-f25b98149e6d"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1651bb5-dc36-5ad7-96ac-589cacf28616" :answer/id #uuid "f1651bb5-dc36-5ad7-96ac-589cacf28616" :answer/type :answer.type/math :answer/value "(0,-3)" :db/ensure [:answer/validate]} {:db/id "answer-dd1b7408-5650-5154-bbf1-2f364160c73c" :answer/id #uuid "dd1b7408-5650-5154-bbf1-2f364160c73c" :answer/type :answer.type/math :answer/value "(0,3)" :db/ensure [:answer/validate]} {:db/id "answer-7015ba8d-eead-5d21-a7c0-ea70edc96a36" :answer/id #uuid "7015ba8d-eead-5d21-a7c0-ea70edc96a36" :answer/type :answer.type/math :answer/value "(2,-5)" :db/ensure [:answer/validate]} {:db/id "answer-49d0507e-75d8-5a58-ba57-eb286cf73a08" :answer/id #uuid "49d0507e-75d8-5a58-ba57-eb286cf73a08" :answer/type :answer.type/math :answer/value "(2,5)" :db/ensure [:answer/validate]} {:db/id "answer-1579ce49-5129-58f1-977d-f25b98149e6d" :answer/id #uuid "1579ce49-5129-58f1-977d-f25b98149e6d" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "question-1b9ba30c-75b9-548b-bbd4-b9dfefeaa769" :question/id #uuid "1b9ba30c-75b9-548b-bbd4-b9dfefeaa769" :question/math-academy-id "q-328381" :question/problem "The center of the hyperbola ${x}^{2}-4{y}^{2}+6x+8y=-1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4{y}^{2}+6x+8y & =-1 \\\\ {x}^{2}+6x\\,-\\,4{y}^{2}+8y & =-1 \\\\ [{x}^{2}+6x]\\,-\\,4[{y}^{2}-2y] & =-1 \\\\ [(x+3)^{2}-9]\\,-\\,4[(y-1)^{2}-1] & =-1 \\\\ (x+3)^{2}-9\\,-\\,4(y-1)^{2}+4 & =-1 \\\\ (x+3)^{2}-4(y-1)^{2} & =-1+9-4 \\\\ (x+3)^{2}-4(y-1)^{2} & =4 \\\\ \\frac{(x-(-3))^{2}}{{2}^{2}}-\\frac{(y-1)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,-3,1\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-065502a1-574d-5373-972e-9dd301a59a4c" "answer-field-5f97af8f-a6f7-5f84-8ea4-e2d8f6e9746e"] :db/ensure [:question/validate]} {:db/id "answer-field-065502a1-574d-5373-972e-9dd301a59a4c" :answer-field/id #uuid "065502a1-574d-5373-972e-9dd301a59a4c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-96faa176-ccfe-57bf-bfcf-8b276f20c9b8" :answer-field/choices ["answer-96faa176-ccfe-57bf-bfcf-8b276f20c9b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-96faa176-ccfe-57bf-bfcf-8b276f20c9b8" :answer/id #uuid "96faa176-ccfe-57bf-bfcf-8b276f20c9b8" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-field-5f97af8f-a6f7-5f84-8ea4-e2d8f6e9746e" :answer-field/id #uuid "5f97af8f-a6f7-5f84-8ea4-e2d8f6e9746e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e2982ec7-0583-500f-aa4a-26911988ff2a" :answer-field/choices ["answer-e2982ec7-0583-500f-aa4a-26911988ff2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2982ec7-0583-500f-aa4a-26911988ff2a" :answer/id #uuid "e2982ec7-0583-500f-aa4a-26911988ff2a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-1e796ec1-771b-53ae-89e2-bbd160268b1c" :question/id #uuid "1e796ec1-771b-53ae-89e2-bbd160268b1c" :question/math-academy-id "q-10416" :question/problem "What is the center of the hyperbola $3{x}^{2}-{y}^{2}+6x+4y=19?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-{y}^{2}+6x+4y & =19 \\\\ 3{x}^{2}+6x-{y}^{2}+4y & =19 \\\\ 3[{x}^{2}+2x]-[{y}^{2}-4y] & =19 \\\\ 3[(x+1)^{2}-1]-[(y-2)^{2}-4] & =19 \\\\ 3(x+1)^{2}-3-(y-2)^{2}+4 & =19 \\\\ 3(x+1)^{2}-(y-2)^{2} & =19+3-4 \\\\ 3(x+1)^{2}-(y-2)^{2} & =18 \\\\ \\frac{(x+1)^{2}}{6}-\\frac{(y-2)^{2}}{18} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-1,2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-64962b7b-ebd6-5bb6-9027-d01b50e7decd"] :db/ensure [:question/validate]} {:db/id "answer-field-64962b7b-ebd6-5bb6-9027-d01b50e7decd" :answer-field/id #uuid "64962b7b-ebd6-5bb6-9027-d01b50e7decd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28b37f44-722d-50f1-9353-6cc3b1ab7af0" :answer-field/choices ["answer-28b37f44-722d-50f1-9353-6cc3b1ab7af0" "answer-088d7a55-2c63-5bcf-8a13-a58f4a3fe930" "answer-ef5946ab-4171-515f-9ea8-e92b45453683" "answer-97b138c1-ebdd-56b7-b004-0d049099818f" "answer-2bd90ff7-1c2a-5ae7-9373-ad219c3dfe75"] :db/ensure [:answer-field/validate]} {:db/id "answer-28b37f44-722d-50f1-9353-6cc3b1ab7af0" :answer/id #uuid "28b37f44-722d-50f1-9353-6cc3b1ab7af0" :answer/type :answer.type/math :answer/value "(-1,2)" :db/ensure [:answer/validate]} {:db/id "answer-088d7a55-2c63-5bcf-8a13-a58f4a3fe930" :answer/id #uuid "088d7a55-2c63-5bcf-8a13-a58f4a3fe930" :answer/type :answer.type/math :answer/value "(-1,4)" :db/ensure [:answer/validate]} {:db/id "answer-ef5946ab-4171-515f-9ea8-e92b45453683" :answer/id #uuid "ef5946ab-4171-515f-9ea8-e92b45453683" :answer/type :answer.type/math :answer/value "(-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-97b138c1-ebdd-56b7-b004-0d049099818f" :answer/id #uuid "97b138c1-ebdd-56b7-b004-0d049099818f" :answer/type :answer.type/math :answer/value "(1,-2)" :db/ensure [:answer/validate]} {:db/id "answer-2bd90ff7-1c2a-5ae7-9373-ad219c3dfe75" :answer/id #uuid "2bd90ff7-1c2a-5ae7-9373-ad219c3dfe75" :answer/type :answer.type/math :answer/value "(2,-1)" :db/ensure [:answer/validate]} {:db/id "question-ec84be9a-d1c8-5ef5-8c9c-eaa63d5e60df" :question/id #uuid "ec84be9a-d1c8-5ef5-8c9c-eaa63d5e60df" :question/math-academy-id "q-78873" :question/problem "What is the center of the hyperbola \n$4{x}^{2}-3{y}^{2}+18y=39?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{x}^{2}-3{y}^{2}+18y & =39 \\\\ 4{x}^{2}-3[{y}^{2}-6y] & =39 \\\\ 4{x}^{2}-3[(y-3)^{2}-9] & =39 \\\\ 4{x}^{2}-3(y-3)^{2}+27 & =39 \\\\ 4{x}^{2}-3(y-3)^{2} & =12 \\\\ \\frac{{x}^{2}}{3}-\\frac{(y-3)^{2}}{4} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(0,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-30a0789d-3435-597e-a492-e9d05f715a85"] :db/ensure [:question/validate]} {:db/id "answer-field-30a0789d-3435-597e-a492-e9d05f715a85" :answer-field/id #uuid "30a0789d-3435-597e-a492-e9d05f715a85" :answer-field/key "selection" :an