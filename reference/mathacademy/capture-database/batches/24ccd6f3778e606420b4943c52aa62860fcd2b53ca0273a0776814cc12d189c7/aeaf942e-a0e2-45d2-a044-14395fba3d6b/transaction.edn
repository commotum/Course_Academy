x}^{2}-10x-4{y}^{2} & =-1 \\\\ [{x}^{2}-10x]-4{y}^{2} & =-1 \\\\ [(x-5)^{2}-25]-4{y}^{2} & =-1 \\\\ (x-5)^{2}-25-4{y}^{2} & =-1 \\\\ (x-5)^{2}-4{y}^{2} & =-1+25 \\\\ (x-5)^{2}-4{y}^{2} & =24 \\\\ \\frac{(x-5)^{2}}{24}-\\frac{{y}^{2}}{6} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,0\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-98d7e53f-69e5-5fd8-9fe2-42e2ea31cb75" "answer-field-fdfbe9d8-ba4d-594f-9b79-9657cca29157"] :db/ensure [:question/validate]} {:db/id "answer-field-98d7e53f-69e5-5fd8-9fe2-42e2ea31cb75" :answer-field/id #uuid "98d7e53f-69e5-5fd8-9fe2-42e2ea31cb75" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ff9124c7-b114-5a38-abe7-dc0211821f70" :answer-field/choices ["answer-ff9124c7-b114-5a38-abe7-dc0211821f70"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff9124c7-b114-5a38-abe7-dc0211821f70" :answer/id #uuid "ff9124c7-b114-5a38-abe7-dc0211821f70" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-fdfbe9d8-ba4d-594f-9b79-9657cca29157" :answer-field/id #uuid "fdfbe9d8-ba4d-594f-9b79-9657cca29157" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4d289631-68ae-5161-bbf9-82623fa351a6" :answer-field/choices ["answer-4d289631-68ae-5161-bbf9-82623fa351a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d289631-68ae-5161-bbf9-82623fa351a6" :answer/id #uuid "4d289631-68ae-5161-bbf9-82623fa351a6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186083426 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186167188 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3 \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=\\frac{3-2s}{s(s-1)},\\,$\n${X}_{2}(s)=$ {{field-1}}." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)+3\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-{x}_{1}(t)+3{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}+3L\\{1\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-L\\{{x}_{1}(t)\\}+3L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+2={X}_{1}(s)+\\frac{3}{s} \\\\ s{X}_{2}(s)-1=-{X}_{1}(s)+3{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{1}(s)+2 & ={X}_{1}(s)+\\frac{3}{s} \\\\ (s-1){X}_{1}(s) & =\\frac{3}{s}-2 \\\\ (s-1){X}_{1}(s) & =\\frac{3-2s}{s} \\\\ {X}_{1}(s) & =\\frac{3-2s}{s(s-1)}.\\end{aligned}\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s),$ we have\n\n$$\n\\begin{aligned}s{X}_{2}(s)-1 & =-{X}_{1}(s)+3{X}_{2}(s) \\\\ (s-3){X}_{2}(s) & =1-{X}_{1}(s) \\\\ (s-3){X}_{2}(s) & =1-(\\frac{3-2s}{s(s-1)}) \\\\ (s-3){X}_{2}(s) & =\\frac{s(s-1)-3+2s}{s(s-1)} \\\\ (s-3){X}_{2}(s) & =\\frac{{s}^{2}-s-3+2s}{s(s-1)} \\\\ (s-3){X}_{2}(s) & =\\frac{{s}^{2}+s-3}{s(s-1)} \\\\ {X}_{2}(s) & =\\frac{{s}^{2}+s-3}{s(s-1)(s-3)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system  in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{3-2s}{s(s-1)},\\,{X}_{2}(s)=\\frac{{s}^{2}+s-3}{s(s-1)(s-3)}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164154 :answer-field/correct "answer-446d2e37-da3b-5ec4-9e85-ed0778e2a047" :answer-field/choices ["answer-446d2e37-da3b-5ec4-9e85-ed0778e2a047"] :db/ensure [:answer-field/validate]} {:db/id "answer-446d2e37-da3b-5ec4-9e85-ed0778e2a047" :answer/id #uuid "446d2e37-da3b-5ec4-9e85-ed0778e2a047" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+s-3}{s(s-1)(s-3)}" :db/ensure [:answer/validate]} {:db/id 17592186166935 :knowledge-point/questions ["question-afb0fc7e-4ba2-590c-909f-dbefd260c961" "question-a2d20627-2f13-5baa-ae6b-0096d23c5fcc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167189 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3 \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{1}{s-1}-\\frac{3}{s},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1/2}{s-1}-\\frac{1}{s}+\\frac{3/2}{s-3}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"40px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-1}-\\frac{3}{s}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-1}\\}-3{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & ={e}^{1\\cdot t}-3\\cdot 1 \\\\  & ={e}^{t}-3 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1/2}{s-1}-\\frac{1}{s}+\\frac{3/2}{s-3}\\} \\\\  & =\\frac{1}{2}{L}^{-1}\\{\\frac{1}{s-1}\\}-{L}^{-1}\\{\\frac{1}{s}\\}+\\frac{3}{2}{L}^{-1}\\{\\frac{1}{s-3}\\} \\\\  & =\\frac{1}{2}{e}^{1\\cdot t}-1+\\frac{3}{2}{e}^{3\\cdot t} \\\\  & =\\frac{1}{2}{e}^{t}+\\frac{3}{2}{e}^{3t}-1\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}{e}^{t}-3 \\\\ \\frac{1}{2}{e}^{t}+\\frac{3}{2}{e}^{3t}-1\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186304740 :answer-field/correct "answer-e83c20e7-16a6-544d-a4ca-f01a743529f8" :answer-field/choices ["answer-e83c20e7-16a6-544d-a4ca-f01a743529f8"] :db/ensure [:answer-field/validate]} {:db/id "answer-e83c20e7-16a6-544d-a4ca-f01a743529f8" :answer/id #uuid "e83c20e7-16a6-544d-a4ca-f01a743529f8" :answer/type :answer.type/math :answer/value "e^t-3" :db/ensure [:answer/validate]} {:db/id 17592186304154 :answer-field/correct "answer-c12e4719-ad23-58b9-a060-4357d834aedf" :answer-field/choices ["answer-c12e4719-ad23-58b9-a060-4357d834aedf"] :db/ensure [:answer-field/validate]} {:db/id "answer-c12e4719-ad23-58b9-a060-4357d834aedf" :answer/id #uuid "c12e4719-ad23-58b9-a060-4357d834aedf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}e^t-1+\\frac{3}{2}e^{3t}" :db/ensure [:answer/validate]} {:db/id 17592186308369 :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=5{x}_{2}(t)+2,\\end{aligned}\\,x(0)=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},$\\,$\n${X}_{2}(s)=\\frac{s+2}{s(s-5)}.$" :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{2{x}_{1}(t)+3{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{5{x}_{2}(t)+2\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=2L\\{{x}_{1}(t)\\}+3L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=5L\\{{x}_{2}(t)\\}+2L\\{1\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-0=2{X}_{1}(s)+3{X}_{2}(s) \\\\ s{X}_{2}(s)-1=5{X}_{2}(s)+\\frac{2}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the second equation for ${X}_{2}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{2}(s)-1 & =5{X}_{2}(s)+\\frac{2}{s} \\\\ (s-5){X}_{2}(s) & =1+\\frac{2}{s} \\\\ (s-5){X}_{2}(s) & =\\frac{s+2}{s} \\\\ {X}_{2}(s) & =\\frac{s+2}{s(s-5)}.\\end{aligned}\n$$\n\nSubstituting this in the first equation and solving for ${X}_{1}(s)$, we have\n\n$$\n\\begin{aligned}s{X}_{1}(s) & =2{X}_{1}(s)+3{X}_{2}(s) \\\\ (s-2){X}_{1}(s) & =3{X}_{2}(s) \\\\ (s-2){X}_{1}(s) & =3(\\frac{s+2}{s(s-5)}) \\\\ {X}_{1}(s) & =\\frac{3(s+2)}{s(s-5)(s-2)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{3(s+2)}{s(s-2)(s-5)},\\,{X}_{2}(s)=\\frac{s+2}{s(s-5)}.\n$$" :db/ensure [:question/validate]} {:db/id "question-afb0fc7e-4ba2-590c-909f-dbefd260c961" :question/id #uuid "afb0fc7e-4ba2-590c-909f-dbefd260c961" :question/math-academy-id "q-333125" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)+2 \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+4{x}_{2}(t)-3,\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{2}{s-2}-\\frac{1}{s},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=-\\frac{1}{s-2}+\\frac{1}{s}+\\frac{3}{s-4}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"40px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-2}-\\frac{1}{s}\\} \\\\  & =2\\,{L}^{-1}\\{\\frac{1}{s-2}\\}-{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =2{e}^{2\\cdot t}-1 \\\\  & =2{e}^{2t}-1 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{-\\frac{1}{s-2}+\\frac{1}{s}+\\frac{3}{s-4}\\} \\\\  & =-{L}^{-1}\\{\\frac{1}{s-2}\\}+{L}^{-1}\\{\\frac{1}{s}\\}+3\\,{L}^{-1}\\{\\frac{1}{s-4}\\} \\\\  & =-{e}^{2\\cdot t}+1+3{e}^{4\\cdot t} \\\\  & =3{e}^{4t}-{e}^{2t}+1\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}2{e}^{2t}-1 \\\\ 3{e}^{4t}-{e}^{2t}+1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7ca1bb4c-a167-5a9d-a3af-6cd2b38386a7" "answer-field-8ba858c4-352a-5ccd-b2f2-ddf2cb9c2ccb"] :db/ensure [:question/validate]} {:db/id "answer-field-7ca1bb4c-a167-5a9d-a3af-6cd2b38386a7" :answer-field/id #uuid "7ca1bb4c-a167-5a9d-a3af-6cd2b38386a7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ca3e6253-cb2f-51e3-a09f-722442297438" :answer-field/choices ["answer-ca3e6253-cb2f-51e3-a09f-722442297438"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca3e6253-cb2f-51e3-a09f-722442297438" :answer/id #uuid "ca3e6253-cb2f-51e3-a09f-722442297438" :answer/type :answer.type/math :answer/value "2e^{2t}-1" :db/ensure [:answer/validate]} {:db/id "answer-field-8ba858c4-352a-5ccd-b2f2-ddf2cb9c2ccb" :answer-field/id #uuid "8ba858c4-352a-5ccd-b2f2-ddf2cb9c2ccb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4a5fa96f-7d32-5292-9419-4df3266355da" :answer-field/choices ["answer-4a5fa96f-7d32-5292-9419-4df3266355da"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a5fa96f-7d32-5292-9419-4df3266355da" :answer/id #uuid "4a5fa96f-7d32-5292-9419-4df3266355da" :answer/type :answer.type/math :answer/value "-e^{2t}+1+3e^{4t}" :db/ensure [:answer/validate]} {:db/id "question-a2d20627-2f13-5baa-ae6b-0096d23c5fcc" :question/id #uuid "a2d20627-2f13-5baa-ae6b-0096d23c5fcc" :question/math-academy-id "q-333135" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-2{x}_{2}(t)-8 \\\\ {x}_{2}^{′}(t)=3{x}_{2}(t)+9,\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{3}{s-2}-\\frac{2}{s-3}+\\frac{1}{s},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1}{s-3}-\\frac{3}{s}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"40px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{3}{s-2}-\\frac{2}{s-3}+\\frac{1}{s}\\} \\\\  & =3\\,{L}^{-1}\\{\\frac{1}{s-2}\\}-2\\,{L}^{-1}\\{\\frac{1}{s-3}\\}+{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =3{e}^{2\\cdot t}-2{e}^{3\\cdot t}+1 \\\\  & =-2{e}^{3t}+3{e}^{2t}+1 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-3}-\\frac{3}{s}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-3}\\}-3\\,{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & ={e}^{3\\cdot t}-3 \\\\  & ={e}^{3t}-3\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}-2{e}^{3t}+3{e}^{2t}+1 \\\\ {e}^{3t}-3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-31d556ca-1ce9-5f66-b4a1-85148a156058" "answer-field-29a780d4-7f5e-5121-9749-f435d4e070d4"] :db/ensure [:question/validate]} {:db/id "answer-field-31d556ca-1ce9-5f66-b4a1-85148a156058" :answer-field/id #uuid "31d556ca-1ce9-5f66-b4a1-85148a156058" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-82f32ceb-ba57-523c-9952-b5724c0a4bf7" :answer-field/choices ["answer-82f32ceb-ba57-523c-9952-b5724c0a4bf7"] :db/ensure [:answer-field/validate]} {:db/id "answer-82f32ceb-ba57-523c-9952-b5724c0a4bf7" :answer/id #uuid "82f32ceb-ba57-523c-9952-b5724c0a4bf7" :answer/type :answer.type/math :answer/value "3e^{2t}-2e^{3t}+1" :db/ensure [:answer/validate]} {:db/id "answer-field-29a780d4-7f5e-5121-9749-f435d4e070d4" :answer-field/id #uuid "29a780d4-7f5e-5121-9749-f435d4e070d4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4faa0bc1-0f83-5df5-b327-6631924a3461" :answer-field/choices ["answer-4faa0bc1-0f83-5df5-b327-6631924a3461"] :db/ensure [:answer-field/validate]} {:db/id "answer-4faa0bc1-0f83-5df5-b327-6631924a3461" :answer/id #uuid "4faa0bc1-0f83-5df5-b327-6631924a3461" :answer/type :answer.type/math :answer/value "e^{3t}-3" :db/ensure [:answer/validate]} {:db/id "activity-acf80487-30da-5578-b5d8-3413af242da3" :activity/id #uuid "acf80487-30da-5578-b5d8-3413af242da3" :activity/title "Solving Inhomogeneous Systems of ODEs Using Laplace Transforms" :activity/type :activity.type/review :activity/scope 17592186049381 :activity/course 17592186046644 :activity/steps ["step-43aab161-e695-57a7-8969-5ee8f4c6d017" "step-d17d556a-f8ce-5c71-aba6-473c775f92dd" "step-d632b05d-a89a-5460-91b8-ea467b225b71" "step-69795229-d4bd-5f42-bbf9-ca3a1404c6ec" "step-1354470f-5d1a-53f8-82af-628f52a8a45f"] :activity/first-step "step-43aab161-e695-57a7-8969-5ee8f4c6d017" :db/ensure [:activity/validate]} {:db/id "step-43aab161-e695-57a7-8969-5ee8f4c6d017" :step/id #uuid "43aab161-e695-57a7-8969-5ee8f4c6d017" :step/content 17592186167188 :step/next "step-d17d556a-f8ce-5c71-aba6-473c775f92dd" :db/ensure [:step/validate]} {:db/id "step-d17d556a-f8ce-5c71-aba6-473c775f92dd" :step/id #uuid "d17d556a-f8ce-5c71-aba6-473c775f92dd" :step/content 17592186167189 :step/next "step-d632b05d-a89a-5460-91b8-ea467b225b71" :db/ensure [:step/validate]} {:db/id "step-d632b05d-a89a-5460-91b8-ea467b225b71" :step/id #uuid "d632b05d-a89a-5460-91b8-ea467b225b71" :step/content 17592186308369 :step/next "step-69795229-d4bd-5f42-bbf9-ca3a1404c6ec" :db/ensure [:step/validate]} {:db/id "step-69795229-d4bd-5f42-bbf9-ca3a1404c6ec" :step/id #uuid "69795229-d4bd-5f42-bbf9-ca3a1404c6ec" :step/content "question-afb0fc7e-4ba2-590c-909f-dbefd260c961" :step/next "step-1354470f-5d1a-53f8-82af-628f52a8a45f" :db/ensure [:step/validate]} {:db/id "step-1354470f-5d1a-53f8-82af-628f52a8a45f" :step/id #uuid "1354470f-5d1a-53f8-82af-628f52a8a45f" :step/content "question-a2d20627-2f13-5baa-ae6b-0096d23c5fcc" :db/ensure [:step/validate]} [:db/retract 17592186057606 :answer-field/choices 17592186057607] [:db/retract 17592186057606 :answer-field/choices 17592186057609] [:db/retract 17592186057606 :answer-field/choices 17592186057610] [:db/retract 17592186057606 :answer-field/choices 17592186057611] [:db/retract 17592186058272 :answer-field/choices 17592186058273] [:db/retract 17592186058272 :answer-field/choices 17592186058274] [:db/retract 17592186058272 :answer-field/choices 17592186058275] [:db/retract 17592186058272 :answer-field/choices 17592186058276] [:db/retract 17592186058272 :answer-field/choices 17592186058277] {:db/id 17592186059632 :knowledge-point/questions ["question-1fbabf96-94ef-591d-8e8e-acb10250f475" "question-fea5a4c0-e40e-5131-a0df-cb2f1f77a5c9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059458 :question/problem "For the function $g(x)$ defined on the set of integers, find $g(-12)$ and $g(3),$ where $g(x)$ is the following piecewise function:\n![](images/43/43ec07dcf63fdaf3f85bd576c64da4f4afccee23143cfe51c337dd3e3e855cce.svg)" :question/worked-solution "- First, we compute $g(-12).$ Since $-12 < 1,$ we use the first branch:\n\n$$\n\\begin{aligned}g(x) & =2x \\\\ g(-12) & =2(-12) \\\\  & =-24\\end{aligned}\n$$\n\n- Next, we compute $g(3).$ Since $3 \\geq 1,$ we use the second branch:\n\n$$\n\\begin{aligned}g(x) & =3x \\\\ g(3) & =3(3) \\\\  & =9\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186059633 :knowledge-point/questions ["question-a93d97c6-5ea5-55ad-8efc-6abdfa388b3a" "question-c6e693a9-56de-5225-8098-edeb2da1b200"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059459 :question/problem "Given that\n![](images/cf/cfe7164dbaeba6215a7fcb84fd9bf192a19c6165562ef124344258df3fcafde6.svg)\nwhat is the graph of $y=f(x)?$" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty, -3),$ we have $f(x) = 3,$ so the graph is a horizontal line that ends at $(-3,3),$ excluding this point.\n\n- On the interval $[-3, \\infty)$, we have $f(x) = 1,$ so the graph is a horizontal line that begins at $(-3,1),$ including this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/f0/f0cdcbeb59ce6f011504ead0de090fa79c925fb933b1a99ce2f885e61eb33107.png)" :db/ensure [:question/validate]} {:db/id 17592186059634 :knowledge-point/questions ["question-2e9f0d78-2c67-580d-a52c-3d6cdded2112"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059608 :question/problem "If $f$ is the piecewise function\n![](images/e6/e6a8c403594625a24b7f5af7eb5909d626e0ffbba5fc9a4947b7d856013c2bfe.svg)\nwhat is the graph of $y=f(x)?$" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty, 0],$ we have $f(x) = -1$, so the graph is a horizontal line that ends at $(0,-1),$ including this point.\n\n- On the interval $(0, \\infty)$, we have $f(x) = - x+2$, so the graph is a straight line of slope $-1$ that starts from $(0,2),$ not including this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/47/47a6d2d5b84424d0347efc7d9dc64ee90323855b233fde68827bff2a820121af.png)" :db/ensure [:question/validate]} {:db/id 17592186059635 :knowledge-point/questions ["question-ad1cae5c-dea6-50a2-9c54-2a5d56edb7d1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059623 :question/worked-solution "The function is defined for values between $-4$ and $1.$\n\n- Since there is an open circle at $x=-4,$ this point is not included in the domain.\n\n- Since there is a closed circle at $x=-1,$ this point is included in the domain.\n\n- Since there is an open circle at $x=1,$ this point is not included in the domain.\n\nSo, the function $f(x)$ above is defined for values between $x=-4$ and $x=1,$ not including $x=-4$ and $x=1$ but including $x=-1.$\n\nTherefore, the domain is\n\n$$\nx\\in (-4,1)\n$$\n\nNote that the function is defined at the point $x=-1,$  even though the function jumps at that point. The function value at $x=-1$ is $2.$" :db/ensure [:question/validate]} {:db/id "question-1fbabf96-94ef-591d-8e8e-acb10250f475" :question/id #uuid "1fbabf96-94ef-591d-8e8e-acb10250f475" :question/math-academy-id "q-7302" :question/problem "Given the following piecewise function $f(x),$ what is $f(5)?$\n\n$$\nf(x)=\\{\\begin{aligned}4,\\, & x\\le 5 \\\\ 5,\\, & x>5\\end{aligned}\n$$" :question/worked-solution "Since $x=5$ is in the interval $x\\le 5,$ we use the left-hand branch, namely $f(x)=4:$\n\n$$\n\\begin{aligned}f(5) & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5283cc23-d439-52da-a0b1-22daa8ef3c68"] :db/ensure [:question/validate]} {:db/id "answer-field-5283cc23-d439-52da-a0b1-22daa8ef3c68" :answer-field/id #uuid "5283cc23-d439-52da-a0b1-22daa8ef3c68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8f15e85-55b4-56fb-9bd6-07b79dfdd15c" :answer-field/choices ["answer-ea83d4e6-58b8-5f78-b35d-5f15e5936d7c" "answer-4356f7e1-d020-5df5-9671-0b5ffb441e32" "answer-e950dc80-9831-521e-93e7-d728826cb5cc" "answer-a8f15e85-55b4-56fb-9bd6-07b79dfdd15c" "answer-cc643682-a43f-5de3-b685-eae1e0e9fba4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea83d4e6-58b8-5f78-b35d-5f15e5936d7c" :answer/id #uuid "ea83d4e6-58b8-5f78-b35d-5f15e5936d7c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4356f7e1-d020-5df5-9671-0b5ffb441e32" :answer/id #uuid "4356f7e1-d020-5df5-9671-0b5ffb441e32" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-e950dc80-9831-521e-93e7-d728826cb5cc" :answer/id #uuid "e950dc80-9831-521e-93e7-d728826cb5cc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a8f15e85-55b4-56fb-9bd6-07b79dfdd15c" :answer/id #uuid "a8f15e85-55b4-56fb-9bd6-07b79dfdd15c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-cc643682-a43f-5de3-b685-eae1e0e9fba4" :answer/id #uuid "cc643682-a43f-5de3-b685-eae1e0e9fba4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-fea5a4c0-e40e-5131-a0df-cb2f1f77a5c9" :question/id #uuid "fea5a4c0-e40e-5131-a0df-cb2f1f77a5c9" :question/math-academy-id "q-19307" :question/problem "Given the following piecewise function $f(x),$ what is $f(1)?$\n\n$$\nf(x)=\\{\\begin{aligned}2x+7,\\, & x\\le 1 \\\\ 2x-3,\\, & x>1\\end{aligned}\n$$" :question/worked-solution "Since $x=1$ is in the interval $x\\le 1,$ we use the left-hand branch, namely $f(x)=2x+7:$\n\n$$\n\\begin{aligned}f(1) & =2(1)+7 \\\\  & =2+7 \\\\  & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb886fa5-107b-56e6-a6e2-1536f8ff860d"] :db/ensure [:question/validate]} {:db/id "answer-field-cb886fa5-107b-56e6-a6e2-1536f8ff860d" :answer-field/id #uuid "cb886fa5-107b-56e6-a6e2-1536f8ff860d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f1a4b4b-e61a-541c-a150-e2e138cfb3bb" :answer-field/choices ["answer-99a844c9-c435-5475-9100-27bc9c6a8999" "answer-82a694fe-810e-5de5-8a45-37cf9b7d272d" "answer-3d32363b-51ca-58e6-95b2-caf5fe68f209" "answer-150af1db-ec30-5f2f-88b3-80195d4642a5" "answer-3f1a4b4b-e61a-541c-a150-e2e138cfb3bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-99a844c9-c435-5475-9100-27bc9c6a8999" :answer/id #uuid "99a844c9-c435-5475-9100-27bc9c6a8999" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-82a694fe-810e-5de5-8a45-37cf9b7d272d" :answer/id #uuid "82a694fe-810e-5de5-8a45-37cf9b7d272d" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-3d32363b-51ca-58e6-95b2-caf5fe68f209" :answer/id #uuid "3d32363b-51ca-58e6-95b2-caf5fe68f209" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-150af1db-ec30-5f2f-88b3-80195d4642a5" :answer/id #uuid "150af1db-ec30-5f2f-88b3-80195d4642a5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-3f1a4b4b-e61a-541c-a150-e2e138cfb3bb" :answer/id #uuid "3f1a4b4b-e61a-541c-a150-e2e138cfb3bb" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-a93d97c6-5ea5-55ad-8efc-6abdfa388b3a" :question/id #uuid "a93d97c6-5ea5-55ad-8efc-6abdfa388b3a" :question/math-academy-id "q-46319" :question/problem "![](images/51/51558d572afe9611d7bbd49e63f71691ae4b8ed386cfa49c2d38817cd8bc7e30.png)\n\nWhat's the definition of the function $y=f(x)$ shown above, given that $f(x)$ is defined for $x\\in (-\\infty ,\\infty )?$" :question/worked-solution "We will determine each branch separately.\n\n- On the interval $(-\\infty ,1],$ we have $f(x)=0.$ Notice that the point $x=1$ is included.\n\n- On the interval $(1,\\infty )$, we have $f(x)=1.$ Notice that the point $x=1$ is excluded.\n\nHence the definition of $f(x)$ is\n\n$$\nf(x)=\\{\\begin{aligned}0\\,,\\, & x\\le 1 \\\\ 1\\,,\\, & x>1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-656b0233-0768-5523-842d-621f0a5ed5aa"] :db/ensure [:question/validate]} {:db/id "answer-field-656b0233-0768-5523-842d-621f0a5ed5aa" :answer-field/id #uuid "656b0233-0768-5523-842d-621f0a5ed5aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a9025efa-a52c-5478-94f4-dbd3e93c91d1" :answer-field/choices ["answer-e471feac-5100-522d-8fca-7b25ced37a7d" "answer-ae5e0509-dedd-5266-aadb-db54ab0a2371" "answer-e07ea9ec-c822-5f9d-a277-c86ec6c40658" "answer-a9025efa-a52c-5478-94f4-dbd3e93c91d1" "answer-5b04d53c-71b3-5fa8-971b-fe5342b88f7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e471feac-5100-522d-8fca-7b25ced37a7d" :answer/id #uuid "e471feac-5100-522d-8fca-7b25ced37a7d" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}-1\\,,\\, & x<1 \\\\ 0\\,,\\, & x\\ge 1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-ae5e0509-dedd-5266-aadb-db54ab0a2371" :answer/id #uuid "ae5e0509-dedd-5266-aadb-db54ab0a2371" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}0\\,,\\, & x<0 \\\\ 1\\,,\\, & x>0\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-e07ea9ec-c822-5f9d-a277-c86ec6c40658" :answer/id #uuid "e07ea9ec-c822-5f9d-a277-c86ec6c40658" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}0\\,,\\, & x\\le 0 \\\\ -1\\,,\\, & x>0\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-a9025efa-a52c-5478-94f4-dbd3e93c91d1" :answer/id #uuid "a9025efa-a52c-5478-94f4-dbd3e93c91d1" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}0\\,,\\, & x\\le 1 \\\\ 1\\,,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-5b04d53c-71b3-5fa8-971b-fe5342b88f7e" :answer/id #uuid "5b04d53c-71b3-5fa8-971b-fe5342b88f7e" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}1\\,,\\, & x<0 \\\\ 0\\,,\\, & x\\ge 0\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "question-c6e693a9-56de-5225-8098-edeb2da1b200" :question/id #uuid "c6e693a9-56de-5225-8098-edeb2da1b200" :question/math-academy-id "q-46373" :question/problem "![](images/aa/aa047bf7762739d439b076816b9f25dde4fdd632df08a2eb8e6424803f03a91c.png)\n\nWhat's the definition of the function $y=f(x)$ shown above, given that $f(x)$ is defined for $x\\in (-\\infty ,\\infty )?$" :question/worked-solution "We will determine each branch separately.\n\n- On the interval $(-\\infty ,-2),$ we have $f(x)=3.$ Notice that the point $x=-2$ is excluded.\n\n- On the interval $[-2,1),$ we have $f(x)=-2.$ Notice that the point $x=-2$ is included and the point $x=1$ is excluded.\n\n- On the interval $(1,\\infty )$, we have $f(x)=2.$ Notice that the point $x=1$ is included.\n\nHence the definition of $f(x)$ is\n\n$$\nf(x)=\\{\\begin{aligned}3\\,,\\, & x<-2 \\\\ -2\\,,\\, & -2\\le x<1 \\\\ 2\\,,\\, & x\\ge 1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ddb40709-0719-5c23-9c70-549b0439b7d8"] :db/ensure [:question/validate]} {:db/id "answer-field-ddb40709-0719-5c23-9c70-549b0439b7d8" :answer-field/id #uuid "ddb40709-0719-5c23-9c70-549b0439b7d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-403faf95-59a7-5c3a-bb47-2d08b5e3cc94" :answer-field/choices ["answer-fd1573cc-7433-5e78-8f6b-ed17c3a96319" "answer-5d58d27e-db4f-5504-993b-b1e1e0f7bd8f" "answer-ff2f9234-d84f-55a4-b4b7-ad2e213d7a1b" "answer-9e0ce3f2-a3f4-5c23-9872-19e3234a5167" "answer-403faf95-59a7-5c3a-bb47-2d08b5e3cc94"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd1573cc-7433-5e78-8f6b-ed17c3a96319" :answer/id #uuid "fd1573cc-7433-5e78-8f6b-ed17c3a96319" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}-3,\\, & x<-2 \\\\ 2,\\, & -2\\le x<1 \\\\ 1,\\, & x\\ge 1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-5d58d27e-db4f-5504-993b-b1e1e0f7bd8f" :answer/id #uuid "5d58d27e-db4f-5504-993b-b1e1e0f7bd8f" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x<-2 \\\\ -1,\\, & -2<x<1 \\\\ 3,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-ff2f9234-d84f-55a4-b4b7-ad2e213d7a1b" :answer/id #uuid "ff2f9234-d84f-55a4-b4b7-ad2e213d7a1b" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}3,\\, & x\\le -2 \\\\ 2,\\, & -2<x\\le 1 \\\\ -1,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-9e0ce3f2-a3f4-5c23-9872-19e3234a5167" :answer/id #uuid "9e0ce3f2-a3f4-5c23-9872-19e3234a5167" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}3\\,,\\, & x<-1 \\\\ -2\\,,\\, & -1<x<2 \\\\ 2\\,,\\, & x>2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-403faf95-59a7-5c3a-bb47-2d08b5e3cc94" :answer/id #uuid "403faf95-59a7-5c3a-bb47-2d08b5e3cc94" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}3\\,,\\, & x<-2 \\\\ -2\\,,\\, & -2\\le x<1 \\\\ 2\\,,\\, & x\\ge 1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "question-2e9f0d78-2c67-580d-a52c-3d6cdded2112" :question/id #uuid "2e9f0d78-2c67-580d-a52c-3d6cdded2112" :question/math-academy-id "q-7289" :question/problem "![](images/d1/d16451ba3da7b703a6b5a07e3ddcda7995c20dae4a4724382f1519017c719245.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,3],$ we have a line with a slope of $\\frac{1}{3}$ and $y$-intercept $0.$ So the graph is the line $y=\\frac{1}{3}x$ that ends at $(3,1),$ including this point.\n\n- On the interval $(3,\\infty ),$ we have a horizontal line that passes through the point $(3,2).$ So the graph is the line $y=2$ that starts at $(3,2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{3}x,\\, & x\\le 3 \\\\ 2,\\, & x>3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dfca57a4-a336-5739-bc9f-c538ba48cda4"] :db/ensure [:question/validate]} {:db/id "answer-field-dfca57a4-a336-5739-bc9f-c538ba48cda4" :answer-field/id #uuid "dfca57a4-a336-5739-bc9f-c538ba48cda4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab05b8e7-842e-557a-a1a9-5751fcb11128" :answer-field/choices ["answer-a3186160-228b-5740-8f76-391631f415ba" "answer-2fdf7af2-1473-5b37-8372-f5c15d05327e" "answer-28b5c02c-67c8-5f06-b143-6742ea487b89" "answer-ab05b8e7-842e-557a-a1a9-5751fcb11128" "answer-cfd3cd9f-4bfa-5684-a8e1-f95a5c6e4ecf"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3186160-228b-5740-8f76-391631f415ba" :answer/id #uuid "a3186160-228b-5740-8f76-391631f415ba" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}1-\\frac{1}{3}x,\\, & x<1 \\\\ 2,\\, & x\\ge 1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-2fdf7af2-1473-5b37-8372-f5c15d05327e" :answer/id #uuid "2fdf7af2-1473-5b37-8372-f5c15d05327e" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x\\le 3 \\\\ \\frac{1}{3}x,\\, & x>3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-28b5c02c-67c8-5f06-b143-6742ea487b89" :answer/id #uuid "28b5c02c-67c8-5f06-b143-6742ea487b89" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}3x,\\, & x\\le 3 \\\\ 2,\\, & x>3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-ab05b8e7-842e-557a-a1a9-5751fcb11128" :answer/id #uuid "ab05b8e7-842e-557a-a1a9-5751fcb11128" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}\\frac{1}{3}x,\\, & x\\le 3 \\\\ 2,\\, & x>3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-cfd3cd9f-4bfa-5684-a8e1-f95a5c6e4ecf" :answer/id #uuid "cfd3cd9f-4bfa-5684-a8e1-f95a5c6e4ecf" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}x,\\, & x\\le 1 \\\\ 2,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id 17592186060191 :question/problem "![](images/1a/1a7b132b3efcd909ec61421c956c6808cdbfd813123e2e9341fd0116d0d3deda.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,1],$ we have a line with slope $2$ and $y$-intercept $1.$ So the graph is the line $y=2x+1$ that ends at $(1,3),$ including this point.\n\n- On the interval $(1,\\infty )$, we have a line with a slope of $-2$ that passes through the point $(1,0).$ We can find the equation of this line using point-slope form:\n\n$$\ny-0=-2(x-1)\\,⟹\\,y=2-2x\n$$\n\nSo the graph is the line $y=2-2x$ that starts at $(1,0),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}2x+1,\\, & x\\le 1 \\\\ 2-2x,\\, & x>1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186057606 :answer-field/correct "answer-e56d03f3-6214-5a2d-b812-62eb1213aa8f" :answer-field/choices ["answer-e6676b49-b44c-580f-b15e-a5e689da79a6" "answer-0df10c74-c1ce-5a90-98c4-8fba09a65fd5" "answer-e56d03f3-6214-5a2d-b812-62eb1213aa8f" "answer-dfa718ca-5e40-5093-8ed6-1a6926b999dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6676b49-b44c-580f-b15e-a5e689da79a6" :answer/id #uuid "e6676b49-b44c-580f-b15e-a5e689da79a6" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}1-x,\\, & x\\le 1 \\\\ x-1,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-0df10c74-c1ce-5a90-98c4-8fba09a65fd5" :answer/id #uuid "0df10c74-c1ce-5a90-98c4-8fba09a65fd5" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2x+1,\\, & x\\le 1 \\\\ -2-2x,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-e56d03f3-6214-5a2d-b812-62eb1213aa8f" :answer/id #uuid "e56d03f3-6214-5a2d-b812-62eb1213aa8f" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2x+1,\\, & x\\le 1 \\\\ 2-2x,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-dfa718ca-5e40-5093-8ed6-1a6926b999dd" :answer/id #uuid "dfa718ca-5e40-5093-8ed6-1a6926b999dd" :answer/type :answer.type/math :answer/value "f(x)=\\{\\begin{aligned}2x-1,\\, & x\\le 1 \\\\ 1-2x,\\, & x>1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id 17592186060275 :question/worked-solution "The function is defined  for values less than $-1,$ and between $-1$ and $4.$\n\n- Since there is a closed circle at $x=4,$ this point is included in the domain.\n\n- On the other hand, because there are two open circles for $x=-1,$ this point is not included in the domain.\n\nTherefore, the domain is\n\n$$\nx\\in (-\\infty ,-1)\\cup (-1,4].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186058272 :answer-field/correct "answer-f0aa27c8-c3d8-525c-ad48-4859d71bce3e" :answer-field/choices ["answer-e1f1cb7d-01ea-52fc-bab0-d5f108f577bd" "answer-3ffeea7e-6d1a-5f6e-8d9d-08672465c5cf" "answer-f0aa27c8-c3d8-525c-ad48-4859d71bce3e" "answer-92c2451b-a10e-5360-af69-be02f0a0f8ec" "answer-b1f13cb6-9a35-5892-8bcb-eb8cec537b8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1f1cb7d-01ea-52fc-bab0-d5f108f577bd" :answer/id #uuid "e1f1cb7d-01ea-52fc-bab0-d5f108f577bd" :answer/type :answer.type/math :answer/value "(-4,-1)\\cup (-1,4]" :db/ensure [:answer/validate]} {:db/id "answer-3ffeea7e-6d1a-5f6e-8d9d-08672465c5cf" :answer/id #uuid "3ffeea7e-6d1a-5f6e-8d9d-08672465c5cf" :answer/type :answer.type/math :answer/value "(-\\infty ,-1)\\cup (-1,4)" :db/ensure [:answer/validate]} {:db/id "answer-f0aa27c8-c3d8-525c-ad48-4859d71bce3e" :answer/id #uuid "f0aa27c8-c3d8-525c-ad48-4859d71bce3e" :answer/type :answer.type/math :answer/value "(-\\infty ,-1)\\cup (-1,4]" :db/ensure [:answer/validate]} {:db/id "answer-92c2451b-a10e-5360-af69-be02f0a0f8ec" :answer/id #uuid "92c2451b-a10e-5360-af69-be02f0a0f8ec" :answer/type :answer.type/math :answer/value "(-\\infty ,-1)\\cup (-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-b1f13cb6-9a35-5892-8bcb-eb8cec537b8f" :answer/id #uuid "b1f13cb6-9a35-5892-8bcb-eb8cec537b8f" :answer/type :answer.type/math :answer/value "(-\\infty ,4]" :db/ensure [:answer/validate]} {:db/id "question-ad1cae5c-dea6-50a2-9c54-2a5d56edb7d1" :question/id #uuid "ad1cae5c-dea6-50a2-9c54-2a5d56edb7d1" :question/math-academy-id "q-129286" :question/problem "![](images/19/1969166670ad908b426c49b4f302a1b56b17693a09d97ddcd64c40ba5dc44987.png)\n\nWhat is the domain of the function $f(x),$ shown above?" :question/worked-solution "The function is defined for values less than $-2,$ and for values between $-2$ and $3.$\n\n- Since there is a closed circle at $x=-2,$ this point is included in the domain.\n\n- Since there is an open circle at $x=3,$ this point is excluded from the domain.\n\nTherefore, the domain is\n\n$$\nx\\in (-\\infty ,3).\n$$\n\nNote that the function is defined at the point $x=-2,$  even though the function jumps at that point. The function value at $x=-2$ is $1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-74dfdc8c-1de1-5138-8640-f866d354fd8d"] :db/ensure [:question/validate]} {:db/id "answer-field-74dfdc8c-1de1-5138-8640-f866d354fd8d" :answer-field/id #uuid "74dfdc8c-1de1-5138-8640-f866d354fd8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04cd771e-a59d-585b-9a33-55f846dde1fd" :answer-field/choices ["answer-149821a9-bec8-5cdb-92ab-f25f3f93a897" "answer-81c28162-d952-55d8-8172-a7bc88b018ff" "answer-04cd771e-a59d-585b-9a33-55f846dde1fd" "answer-de1348e2-9cc2-5dc2-b2de-ddf758c41819" "answer-503def74-391f-5205-b6c9-9b120f1146d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-149821a9-bec8-5cdb-92ab-f25f3f93a897" :answer/id #uuid "149821a9-bec8-5cdb-92ab-f25f3f93a897" :answer/type :answer.type/math :answer/value "(-\\infty ,-2)\\cup (2,3)" :db/ensure [:answer/validate]} {:db/id "answer-81c28162-d952-55d8-8172-a7bc88b018ff" :answer/id #uuid "81c28162-d952-55d8-8172-a7bc88b018ff" :answer/type :answer.type/math :answer/value "(-\\infty ,-2)\\cup (2,3]" :db/ensure [:answer/validate]} {:db/id "answer-04cd771e-a59d-585b-9a33-55f846dde1fd" :answer/id #uuid "04cd771e-a59d-585b-9a33-55f846dde1fd" :answer/type :answer.type/math :answer/value "(-\\infty ,3)" :db/ensure [:answer/validate]} {:db/id "answer-de1348e2-9cc2-5dc2-b2de-ddf758c41819" :answer/id #uuid "de1348e2-9cc2-5dc2-b2de-ddf758c41819" :answer/type :answer.type/math :answer/value "(-\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-503def74-391f-5205-b6c9-9b120f1146d2" :answer/id #uuid "503def74-391f-5205-b6c9-9b120f1146d2" :answer/type :answer.type/math :answer/value "[-2,3)" :db/ensure [:answer/validate]} {:db/id 17592186060870 :tutorial/content "A **piecewise function** is a function that is defined differently in different parts of the function's domain.\n\nFor example, consider the piecewise function ![](images/a8/a8e8a9c3f9a7bef1c9c40cad27eeb93267b8b30eb74ce36acd9bf90b461c21ae.svg) defined as follows:\n![](images/78/78daf51ed18581f874f275e211d9f6b651af383503fdbc6e04f7d06b083eaffd.svg)\nA plot of the function is given below:\n\n![](images/2a/2ad96db45424ed30eb3219a4ae36e13d5498a3719695ccb73a9313058f2fa15c.png)\n\nThe function has two distinct branches, one for  ![](images/a3/a3d6121723fd4e9feea862013f28e4326de8afabb08b46040ca1c80788500f84.svg) and one for  ![](images/ee/ee98d74fc058e95e72d13a5e575e70e4d5adedd26413e3f01ab1e3f788be87e8.svg). The function is a piecewise function because it has different definitions depending on where we are in the domain. \n\nSuppose that we want to calculate ![](images/0c/0c0dc4f7a3b289c14dd126e050458eab6b82ccccb923d9c6993ac5042303568e.svg) For this, we'd use the  left branch ![](images/a3/a3d6121723fd4e9feea862013f28e4326de8afabb08b46040ca1c80788500f84.svg) because ![](images/85/8521c0711d7afa3552209b26e08d80787124feea347c2cdfa81a8de5470ab58d.svg) On this branch, the function definition is ![](images/5d/5d344346082f57f1cd7456779e9a30d079068f78a466fe899ac376cfbd14dbaf.svg) so we have\n\n![](images/0e/0e990ed7688ceb39db8d63fd54c0f22f52f5260efb6636419319b92b43171610.svg)\n\nSimilarly, if we want to calculate ![](images/71/713ad3a0e19cfab825d702bd00e14c956db1844974c9da945d697930a02e7178.svg), we'd use the  right branch ![](images/ee/ee98d74fc058e95e72d13a5e575e70e4d5adedd26413e3f01ab1e3f788be87e8.svg) because ![](images/95/95a3686bf6cd3fddc29b98a39ab23027d1cc794ae2517aefde675a62f0a4d023.svg) On this branch, the function definition is ![](images/85/85f568b3e2d870a755a97fb3457f3c62e814f559b8b017ac05c291fb5d8aa79e.svg) so we have\n\n![](images/16/166c6a001bb66b83e3d369c2211f11baf60650e54c93da7bee47539fa717d44a.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186059893 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186167295 :question/answer-fields 17592186164985] [:db/retract 17592186317007 :answer-field/choices 17592186315475] {:db/id 17592186167295 :question/problem "Consider the function $F(x)=|x|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{\\pi }{2}-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (2n-1)^{2}}\\operatorname{cos}⁡((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡((2n-1)\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}={{field-4}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186317395 :question/problem "$$\nF(x)=\\{\\begin{aligned}-2x+1, & x\\in [-4,0] \\\\ {x}^{2}+2, & x\\in (0,4)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is converging when $x=-3.$\n\nThe Fourier series converges to {{field-1}} when $x=-3.$" :db/ensure [:question/validate]} {:db/id 17592186317397 :question/problem "$$\nF(x)=\\{\\begin{aligned}{x}^{2}-4, & x\\in [-5,0] \\\\ \\operatorname{sin}⁡x, & x\\in (0,5)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $10$-periodic extension $f(x)$ of $F(x)$ is converging when $x=-3.$\n\nThe Fourier series converges to {{field-1}} when $x=-3.$" :db/ensure [:question/validate]} {:db/id 17592186317399 :question/problem "Consider the function $F(x)=|\\operatorname{sin}⁡(\\frac{x}{2})|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{2}{\\pi }-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (4{n}^{2}-1)}\\operatorname{cos}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}={{field-4}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186317007 :answer-field/correct 17592186315571 :db/ensure [:answer-field/validate]} {:db/id 17592186402320 :question/problem "$$\nF(x)=\\{\\begin{aligned}-4, & x\\in [-\\pi ,0] \\\\ 2, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼-1+{\\sum }_{n=1}^{\\infty }\\frac{12}{\\pi (2n-1)}sin\\,((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=-\\frac{\\pi }{2},$ we have\n\n$$\nsin\\,((2n-1)\\cdot (-\\frac{\\pi }{2}))={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(-\\frac{\\pi }{2})={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :db/ensure [:question/validate]} {:db/id "activity-442f7906-7af4-5d3c-b0ed-f94af1daddc5" :activity/id #uuid "442f7906-7af4-5d3c-b0ed-f94af1daddc5" :activity/title "Convergence of Fourier Series" :activity/type :activity.type/review :activity/scope 17592186050989 :activity/course 17592186046644 :activity/steps ["step-953b546a-265d-5b9a-a212-47ea85583cca" "step-589a89f1-3670-5a97-9173-deba2449c324" "step-763f5bea-94fa-514d-8f84-2fa7e7e9d8bd" "step-dda307b5-8003-57b0-9aa5-1bc31da204b7" "step-bc78a68d-4643-5a86-980c-c8ebf837e55e"] :activity/first-step "step-953b546a-265d-5b9a-a212-47ea85583cca" :db/ensure [:activity/validate]} {:db/id "step-953b546a-265d-5b9a-a212-47ea85583cca" :step/id #uuid "953b546a-265d-5b9a-a212-47ea85583cca" :step/content 17592186167295 :step/next "step-589a89f1-3670-5a97-9173-deba2449c324" :db/ensure [:step/validate]} {:db/id "step-589a89f1-3670-5a97-9173-deba2449c324" :step/id #uuid "589a89f1-3670-5a97-9173-deba2449c324" :step/content 17592186317395 :step/next "step-763f5bea-94fa-514d-8f84-2fa7e7e9d8bd" :db/ensure [:step/validate]} {:db/id "step-763f5bea-94fa-514d-8f84-2fa7e7e9d8bd" :step/id #uuid "763f5bea-94fa-514d-8f84-2fa7e7e9d8bd" :step/content 17592186317397 :step/next "step-dda307b5-8003-57b0-9aa5-1bc31da204b7" :db/ensure [:step/validate]} {:db/id "step-dda307b5-8003-57b0-9aa5-1bc31da204b7" :step/id #uuid "dda307b5-8003-57b0-9aa5-1bc31da204b7" :step/content 17592186317399 :step/next "step-bc78a68d-4643-5a86-980c-c8ebf837e55e" :db/ensure [:step/validate]} {:db/id "step-bc78a68d-4643-5a86-980c-c8ebf837e55e" :step/id #uuid "bc78a68d-4643-5a86-980c-c8ebf837e55e" :step/content 17592186402320 :db/ensure [:step/validate]} {:db/id 17592186192768 :knowledge-point/questions ["question-82b4f2d5-49e5-54a4-9867-0518a805773f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192492 :question/problem "Represent the solution of the inequality $k -12 \\lt  -5$ on a number line." :question/worked-solution "To isolate $k,$ we need to perform the *opposite* of *subtracting* $12,$ which is *adding* $12.$\nRemember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}k-12 & <-5 \\\\ k-12+12 & <-5+12 \\\\ k+0 & <7 \\\\ k & <7\\end{aligned}\n$$\n\nTherefore, the solution is $k \\lt  7.$ The solution can be expressed on a number line, as shown below.\n\n![](images/9c/9cc25f8eec7586ce65a17be3eb7af6ee509d014bf8dc9896cd45c6ef99769250.png)" :db/ensure [:question/validate]} {:db/id 17592186192748 :knowledge-point/questions ["question-70d3487e-b503-50e8-b857-c63dd534d65a" "question-5f4cf73b-e442-544c-845a-c7e6521bdf69"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192467 :question/worked-solution "The variable $a$ is being *multiplied* by $-6.$ To isolate $a,$ we can perform the *opposite* operation, which is *dividing* by $-6.$ So, we divide both sides of the equation by $-6.$\n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}-6a\\,\\, & >\\,\\,-12 \\\\ \\frac{-6a}{-6}\\, & <\\,\\,\\frac{-12}{-6} \\\\ \\frac{-6a}{-6}\\, & <\\,\\,2\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-6a}{-6} & <2 \\\\ \\frac{\\cancel{-6}a}{\\cancel{-6}} & <2 \\\\ a & <2\\end{aligned}\n$$\n\nTherefore, the solution is $a<   2.$ The solution can be expressed on a number line, as shown below.\n\n![](images/2b/2b5947166eb517c08355c09c265f6a2c1f87bdafd776b2e03f5503585568b90b.png)" :db/ensure [:question/validate]} {:db/id 17592186192746 :knowledge-point/questions ["question-6280d0e4-77c7-572f-9c1a-10c2908c012a" "question-bd2c58ff-4c4c-5b74-8ac8-2ec07ff5ad46" "question-93f851d7-f3f4-511e-adef-c16fd42c2432"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192464 :question/worked-solution "First, we apply the addition principle, adding $6$ to both sides:\n\n$$\n\\begin{aligned}14 & <5x-6 \\\\ 14+6 & <5x-6+6 \\\\ 20 & <5x+0 \\\\ 20 & <5x\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $5{:}$\n\n$$\n\\begin{aligned}20 & <5x \\\\ \\frac{20}{5} & <\\frac{5x}{5} \\\\ \\frac{20}{5} & <\\frac{\\cancel{5}x}{\\cancel{5}} \\\\ 4 & <x\\end{aligned}\n$$\n\n \n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember that we also need to flip the inequality.\n\n$$\nx \\gt 4\n$$\n\nTherefore, the solution is $x  \\gt 4.$ The solution can be expressed on a number line, as shown below.\n\n![](images/3b/3b6c834b9f69e2610a3c61bb765ec0cba5ad03cfcd22a3ddb0290ff0fa3882f0.png)" :db/ensure [:question/validate]} {:db/id 17592186193124 :question/problem "Represent the solution of the inequality $a+5\\ge 11$ on a number line." :question/worked-solution "To isolate $a,$ we need to perform the *opposite* of *adding* $5,$ which is *subtracting* $5.$\nRemember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}a+5 & \\ge 11 \\\\ a+5-5 & \\ge 11-5 \\\\ a+0 & \\ge 6 \\\\ a & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $a\\ge 6.$ The solution can be expressed on a number line, as shown below.\n\n![](images/7d/7d898136f9b5ad8adfb0b2354c3b7b9630c7270440fafb481fbc860ee4fcc627.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186190630 :answer-field/correct 17592186190635 :db/ensure [:answer-field/validate]} {:db/id "question-82b4f2d5-49e5-54a4-9867-0518a805773f" :question/id #uuid "82b4f2d5-49e5-54a4-9867-0518a805773f" :question/math-academy-id "q-156657" :question/problem "Represent the solution of the inequality $5z\\le -45$ on a number line." :question/worked-solution "The variable $z$ is being *multiplied* by $5.$ To isolate $z$, we can perform the *opposite* operation, which is *dividing* by $5.$ So, we divide both sides of the equation by $5.$\n\n$$\n\\begin{aligned}5z & \\le -45 \\\\ \\frac{5z}{5} & \\le \\frac{-45}{5} \\\\ \\frac{5z}{5} & \\le -9\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $5$ from the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{5z}{5} & \\le -9 \\\\ \\frac{\\cancel{5}z}{\\cancel{5}} & \\le -9 \\\\ z & \\le -9\\end{aligned}\n$$\n\nTherefore, the solution is $z\\le -9.$ The solution can be expressed on a number line, as shown below.\n\n![](images/bd/bd4ccae5ea797d6c41e83c426b76491316552883e831bb82d82345d91773e4a3.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ccb8edc4-f1cb-5fa3-8c77-760f79763cca"] :db/ensure [:question/validate]} {:db/id "answer-field-ccb8edc4-f1cb-5fa3-8c77-760f79763cca" :answer-field/id #uuid "ccb8edc4-f1cb-5fa3-8c77-760f79763cca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e00ed368-9d78-5b72-9f53-1e8cd4629c82" :answer-field/choices ["answer-dc4c8a45-81fa-5e11-b89e-4e8e1f0a9b25" "answer-04877aae-808d-5869-acc3-5a7836b0a7ca" "answer-4594ab22-dba1-5ce6-bca6-9c4e4785457f" "answer-119d4a72-6df5-5dc3-8f43-96b52cce5fba" "answer-e00ed368-9d78-5b72-9f53-1e8cd4629c82"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc4c8a45-81fa-5e11-b89e-4e8e1f0a9b25" :answer/id #uuid "dc4c8a45-81fa-5e11-b89e-4e8e1f0a9b25" :answer/type :answer.type/image :answer/value "images/5a/5af366af2cb86131a092ae1ceae0087f6d5221faa6c376da9743c94ed09ba345.png" :db/ensure [:answer/validate]} {:db/id "answer-04877aae-808d-5869-acc3-5a7836b0a7ca" :answer/id #uuid "04877aae-808d-5869-acc3-5a7836b0a7ca" :answer/type :answer.type/image :answer/value "images/7d/7dbfffa34020e124d15a87b94961bd3a9f4f437dc0596e8cc87c81e0544582dd.png" :db/ensure [:answer/validate]} {:db/id "answer-4594ab22-dba1-5ce6-bca6-9c4e4785457f" :answer/id #uuid "4594ab22-dba1-5ce6-bca6-9c4e4785457f" :answer/type :answer.type/image :answer/value "images/8f/8f5c34779e0a05a0b1094261f7c7d221b14c2f2be16f08dab6903a465110e794.png" :db/ensure [:answer/validate]} {:db/id "answer-119d4a72-6df5-5dc3-8f43-96b52cce5fba" :answer/id #uuid "119d4a72-6df5-5dc3-8f43-96b52cce5fba" :answer/type :answer.type/image :answer/value "images/a7/a7df051043153eb7b88cfc4eb8af769f5d42dabf7c9e3dadd57986da8383374e.png" :db/ensure [:answer/validate]} {:db/id "answer-e00ed368-9d78-5b72-9f53-1e8cd4629c82" :answer/id #uuid "e00ed368-9d78-5b72-9f53-1e8cd4629c82" :answer/type :answer.type/image :answer/value "images/bd/bd4ccae5ea797d6c41e83c426b76491316552883e831bb82d82345d91773e4a3.png" :db/ensure [:answer/validate]} {:db/id "question-70d3487e-b503-50e8-b857-c63dd534d65a" :question/id #uuid "70d3487e-b503-50e8-b857-c63dd534d65a" :question/math-academy-id "q-156665" :question/problem "Represent the solution of the inequality $-5t>15$ on a number line." :question/worked-solution "The variable $t$ is being *multiplied* by $-5.$ To isolate $t,$ we can perform the *opposite* operation, which is *dividing* by $-5.$ So, we divide both sides of the equation by $-5.$\n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}-5t\\,\\, & >\\,\\,15 \\\\ \\frac{-5t}{-5}\\, & <\\,\\,\\frac{15}{-5} \\\\ \\frac{-5t}{-5}\\, & <\\,\\,-3\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-5$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-5t}{-5} & <-3 \\\\ \\frac{\\cancel{-5}t}{\\cancel{-5}} & <-3 \\\\ t & <-3\\end{aligned}\n$$\n\nTherefore, the solution is $t<-3.$ The solution can be expressed on a number line, as shown below.\n\n![](images/a6/a622d3f7ef117b60b5dd3744cd7c322235ead95ffd3ca806adc1e37a22014c0f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1dc56f59-f723-54a0-80fa-3788b2766711"] :db/ensure [:question/validate]} {:db/id "answer-field-1dc56f59-f723-54a0-80fa-3788b2766711" :answer-field/id #uuid "1dc56f59-f723-54a0-80fa-3788b2766711" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e7128377-c9ba-5a5b-9cde-64304bb2282b" :answer-field/choices ["answer-5daf1180-56a8-52e9-8381-542f6885592e" "answer-5d969f3e-15f3-5209-9cde-8047f9535b21" "answer-e7128377-c9ba-5a5b-9cde-64304bb2282b" "answer-e16b964a-0b5e-5b64-945a-fb48cdd1a7f7" "answer-6f23c623-b0ea-569e-9455-1c5116ebfbb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-5daf1180-56a8-52e9-8381-542f6885592e" :answer/id #uuid "5daf1180-56a8-52e9-8381-542f6885592e" :answer/type :answer.type/image :answer/value "images/3f/3fae3905deb78b9f5f1ea01717b7d4bc9cc21e560afb98d070bd0c6cb43c6dee.png" :db/ensure [:answer/validate]} {:db/id "answer-5d969f3e-15f3-5209-9cde-8047f9535b21" :answer/id #uuid "5d969f3e-15f3-5209-9cde-8047f9535b21" :answer/type :answer.type/image :answer/value "images/77/77cd7409394f178fa727b38008d26d3961e2e753303a058ca6aa29b4ea113424.png" :db/ensure [:answer/validate]} {:db/id "answer-e7128377-c9ba-5a5b-9cde-64304bb2282b" :answer/id #uuid "e7128377-c9ba-5a5b-9cde-64304bb2282b" :answer/type :answer.type/image :answer/value "images/a6/a622d3f7ef117b60b5dd3744cd7c322235ead95ffd3ca806adc1e37a22014c0f.png" :db/ensure [:answer/validate]} {:db/id "answer-e16b964a-0b5e-5b64-945a-fb48cdd1a7f7" :answer/id #uuid "e16b964a-0b5e-5b64-945a-fb48cdd1a7f7" :answer/type :answer.type/image :answer/value "images/ba/ba9e71603b1f780d8213d89f19242fba69a46c186f99e3657d874c3ce8e62bf4.png" :db/ensure [:answer/validate]} {:db/id "answer-6f23c623-b0ea-569e-9455-1c5116ebfbb6" :answer/id #uuid "6f23c623-b0ea-569e-9455-1c5116ebfbb6" :answer/type :answer.type/image :answer/value "images/ed/ed2bdc2c6fb877dd611c160ef902b8eeeaaabb49485e2e62695fcfd3a8bc2652.png" :db/ensure [:answer/validate]} {:db/id "question-5f4cf73b-e442-544c-845a-c7e6521bdf69" :question/id #uuid "5f4cf73b-e442-544c-845a-c7e6521bdf69" :question/math-academy-id "q-155556" :question/problem "Represent the solution of the inequality $-\\frac{a}{4}>-2$ on a number line." :question/worked-solution "The variable $a$ is being *divided* by $4.$ To isolate $a$ and remove the negative sign, we *multiply* by $-4.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{a}{4}\\,\\, & >\\,\\,-2 \\\\ (-4)\\cdot (-\\frac{a}{4})\\,\\, & <\\,\\,(-4)\\cdot (-2) \\\\ (-4)\\cdot (-\\frac{a}{4})\\,\\, & <\\,\\,8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-4)\\cdot (-\\frac{a}{4}) & <8 \\\\ (\\cancel{-}4)\\cdot (\\cancel{-}\\frac{a}{4}) & <8 \\\\ 4\\cdot \\frac{a}{4} & <8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $4$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}4\\cdot \\frac{a}{4} & <8 \\\\ \\frac{4a}{4} & <8 \\\\ \\frac{\\cancel{4}a}{\\cancel{4}} & <8 \\\\ a & <8\\end{aligned}\n$$\n\nTherefore, the solution is $a<8.$ The solution can be expressed on a number line, as shown below.\n\n \n\n![](images/eb/ebda9e955c2613aa9e65b950ac80ad7ec4e52d6db6fdcce76cc2f89bbc20b0d4.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f308d5d5-0b30-5d3f-8d6d-a8777cb225e6"] :db/ensure [:question/validate]} {:db/id "answer-field-f308d5d5-0b30-5d3f-8d6d-a8777cb225e6" :answer-field/id #uuid "f308d5d5-0b30-5d3f-8d6d-a8777cb225e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d9ef012-bf37-5052-b96d-18f78871459b" :answer-field/choices ["answer-12d9ae4e-8ee9-5dab-a678-998b84633eec" "answer-93ee5e59-9e5d-5c6a-8a09-ad948704dae4" "answer-364c3910-7df3-5411-bad0-d653131067da" "answer-99281185-8a83-594a-94a5-070bba47ed34" "answer-2d9ef012-bf37-5052-b96d-18f78871459b"] :db/ensure [:answer-field/validate]} {:db/id "answer-12d9ae4e-8ee9-5dab-a678-998b84633eec" :answer/id #uuid "12d9ae4e-8ee9-5dab-a678-998b84633eec" :answer/type :answer.type/image :answer/value "images/14/1443d401eb2bd5a6a699f6c80fdd33f95270bed6e24d55165aff7b90bbd546b2.png" :db/ensure [:answer/validate]} {:db/id "answer-93ee5e59-9e5d-5c6a-8a09-ad948704dae4" :answer/id #uuid "93ee5e59-9e5d-5c6a-8a09-ad948704dae4" :answer/type :answer.type/image :answer/value "images/35/3589e407d3ff892f4bfb00e73cf0c5e77a7fb4aaee39ecc3daeca53b60b49773.png" :db/ensure [:answer/validate]} {:db/id "answer-364c3910-7df3-5411-bad0-d653131067da" :answer/id #uuid "364c3910-7df3-5411-bad0-d653131067da" :answer/type :answer.type/image :answer/value "images/7d/7d2e6671729b92d2ac42a357268a6545f1d3491c7c1a6133e7e460227c8a04da.png" :db/ensure [:answer/validate]} {:db/id "answer-99281185-8a83-594a-94a5-070bba47ed34" :answer/id #uuid "99281185-8a83-594a-94a5-070bba47ed34" :answer/type :answer.type/image :answer/value "images/94/944ad59d879c9eb7fbf08615659d5ac6a4b88ca37cb2dda50ccad7aa3f28046b.png" :db/ensure [:answer/validate]} {:db/id "answer-2d9ef012-bf37-5052-b96d-18f78871459b" :answer/id #uuid "2d9ef012-bf37-5052-b96d-18f78871459b" :answer/type :answer.type/image :answer/value "images/eb/ebda9e955c2613aa9e65b950ac80ad7ec4e52d6db6fdcce76cc2f89bbc20b0d4.png" :db/ensure [:answer/validate]} {:db/id 17592186193332 :question/problem "Represent the solution of the inequality $-3x+2\\ge 5$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $2$ from both sides:\n\n$$\n\\begin{aligned}-3x+2 & \\ge 5 \\\\ -3x+2-2 & \\ge 5-2 \\\\ -3x+0 & \\ge 3 \\\\ -3x & \\ge 3\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing by $-3.$ \n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}-3x\\,\\, & \\ge \\,\\,3 \\\\ \\frac{-3x}{-3}\\, & \\le \\,\\,\\frac{3}{-3} \\\\ \\frac{\\cancel{-3}x}{\\cancel{-3}}\\, & \\le \\,\\,-1 \\\\ x\\,\\, & \\le \\,\\,-1\\end{aligned}\n$$\n\nTherefore, the solution is $x\\le -1.$ The solution can be expressed on a number line, as shown below.\n\n$$\n\n$$\n\n![](images/34/34610901823137e2c15d3bf4515a7c700469f97cd876961b6ea8d9afadd1d14f.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186191919 :answer-field/correct 17592186191923 :db/ensure [:answer-field/validate]} {:db/id 17592186193331 :question/problem "Represent the solution of the inequality $4x+2\\le 10$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $2$ from both sides:\n\n$$\n\\begin{aligned}4x+2 & \\le 10 \\\\ 4x+2-2 & \\le 10-2 \\\\ 4x+0 & \\le 8 \\\\ 4x & \\le 8\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $4:$\n\n$$\n\\begin{aligned}4x & \\le 8 \\\\ \\frac{4x}{4} & \\le \\frac{8}{4} \\\\ \\frac{\\cancel{4}x}{\\cancel{4}} & \\le \\frac{8}{4} \\\\ x & \\le 2\\end{aligned}\n$$\n\n \n\nTherefore, the solution is $x\\le 2.$ The solution can be expressed on a number line, as shown below.\n\n![](images/b0/b02bead6d12049fedcf78bea9558a7c95ee85d78f801e41c46ea653ba1712750.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186191913 :answer-field/correct 17592186191917 :db/ensure [:answer-field/validate]} {:db/id "question-6280d0e4-77c7-572f-9c1a-10c2908c012a" :question/id #uuid "6280d0e4-77c7-572f-9c1a-10c2908c012a" :question/math-academy-id "q-155561" :question/problem "Represent the solution of the inequality $-5x-7<-2$ on a number line." :question/worked-solution "First, we apply the addition principle, adding $7$ to both sides:\n\n$$\n\\begin{aligned}-5x-7 & <-2 \\\\ -5x-7+7 & <-2+7 \\\\ -5x+0 & <5 \\\\ -5x & <5\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing by $-5.$ \n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}-5x\\,\\, & <\\,\\,5 \\\\ \\frac{-5x}{-5}\\, & >\\,\\,\\frac{5}{-5} \\\\ \\frac{\\cancel{-5}x}{\\cancel{-5}}\\, & >\\,\\,-1 \\\\ x\\,\\, & >\\,\\,-1\\end{aligned}\n$$\n\nTherefore, the solution is $x>-1.$ The solution can be expressed on a number line, as shown below.\n\n![](images/23/236731caee3bdbb7fee8922577a4945e97d81ee2876ca5b050c12654b2277a2a.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f08a84c-613a-541b-a1fa-a3771715b702"] :db/ensure [:question/validate]} {:db/id "answer-field-6f08a84c-613a-541b-a1fa-a3771715b702" :answer-field/id #uuid "6f08a84c-613a-541b-a1fa-a3771715b702" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72d5a6d0-1fb2-5bd9-9430-d6a20ae02ead" :answer-field/choices ["answer-56b8f5ba-6708-5ca9-b0cd-47a546aa1b20" "answer-72d5a6d0-1fb2-5bd9-9430-d6a20ae02ead" "answer-37a5029c-6f03-58af-86ee-1d60ff82f949" "answer-01cf7ea8-3de1-5cae-9d52-a652bb86a99e" "answer-6713cb26-c5e6-589e-9365-8e54c4046e13"] :db/ensure [:answer-field/validate]} {:db/id "answer-56b8f5ba-6708-5ca9-b0cd-47a546aa1b20" :answer/id #uuid "56b8f5ba-6708-5ca9-b0cd-47a546aa1b20" :answer/type :answer.type/image :answer/value "images/19/19cce2d3039b99366d732bc3bdb9f0cae327413320049ddb1d9e1d9f763fe215.png" :db/ensure [:answer/validate]} {:db/id "answer-72d5a6d0-1fb2-5bd9-9430-d6a20ae02ead" :answer/id #uuid "72d5a6d0-1fb2-5bd9-9430-d6a20ae02ead" :answer/type :answer.type/image :answer/value "images/23/236731caee3bdbb7fee8922577a4945e97d81ee2876ca5b050c12654b2277a2a.png" :db/ensure [:answer/validate]} {:db/id "answer-37a5029c-6f03-58af-86ee-1d60ff82f949" :answer/id #uuid "37a5029c-6f03-58af-86ee-1d60ff82f949" :answer/type :answer.type/image :answer/value "images/5a/5a2b62f5f96850dbccb3c0d284d0b005069c82bba98c171b8bedb7c9377de5f2.png" :db/ensure [:answer/validate]} {:db/id "answer-01cf7ea8-3de1-5cae-9d52-a652bb86a99e" :answer/id #uuid "01cf7ea8-3de1-5cae-9d52-a652bb86a99e" :answer/type :answer.type/image :answer/value "images/7b/7bb94468ebcde9f65ca3192c5fe251c9a77c4548cce3bce62992a322d0469e65.png" :db/ensure [:answer/validate]} {:db/id "answer-6713cb26-c5e6-589e-9365-8e54c4046e13" :answer/id #uuid "6713cb26-c5e6-589e-9365-8e54c4046e13" :answer/type :answer.type/image :answer/value "images/de/dec03ecdf937a3e9fb9c38671dcb704de97162d8306392dfbab9b956ad8b49af.png" :db/ensure [:answer/validate]} {:db/id "question-bd2c58ff-4c4c-5b74-8ac8-2ec07ff5ad46" :question/id #uuid "bd2c58ff-4c4c-5b74-8ac8-2ec07ff5ad46" :question/math-academy-id "q-155565" :question/problem "Represent the solution of the inequality $4\\ge -3x+1$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $1$ from both sides:\n\n$$\n\\begin{aligned}4 & \\ge -3x+1 \\\\ 4-1 & \\ge -3x+1-1 \\\\ 3 & \\ge -3x+0 \\\\ 3 & \\ge -3x\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing by $-3.$ \n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}3\\,\\, & \\ge \\,\\,-3x \\\\ \\frac{3}{-3}\\, & \\le \\,\\,\\frac{-3x}{-3} \\\\ -1\\, & \\le \\,\\,\\frac{\\cancel{-3}x}{\\cancel{-3}} \\\\ -1\\,\\, & \\le \\,\\,x\\end{aligned}\n$$\n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\nx\\ge -1\n$$\n\nTherefore, the solution is $x\\ge -1.$ The solution can be expressed on a number line, as shown below.\n\n$$\n\n$$\n\n![](images/81/817328612514da56e2373483b7b579c5f8be03fb8b8ce182ec8220182a6bc9e7.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ef7eddd3-cc10-50df-acb8-45b0b3fa44a0"] :db/ensure [:question/validate]} {:db/id "answer-field-ef7eddd3-cc10-50df-acb8-45b0b3fa44a0" :answer-field/id #uuid "ef7eddd3-cc10-50df-acb8-45b0b3fa44a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a175f293-1509-584d-bc0c-d4cb84c90591" :answer-field/choices ["answer-f5afa12c-ba4a-51da-86ab-55010b4dfd33" "answer-a0362577-a809-5212-97fc-f68b9c903158" "answer-ce9e0618-ec14-563b-be45-2904cff0fc80" "answer-a175f293-1509-584d-bc0c-d4cb84c90591" "answer-9db9c939-0e10-532b-9f82-1b953ae7623f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5afa12c-ba4a-51da-86ab-55010b4dfd33" :answer/id #uuid "f5afa12c-ba4a-51da-86ab-55010b4dfd33" :answer/type :answer.type/image :answer/value "images/34/34610901823137e2c15d3bf4515a7c700469f97cd876961b6ea8d9afadd1d14f.png" :db/ensure [:answer/validate]} {:db/id "answer-a0362577-a809-5212-97fc-f68b9c903158" :answer/id #uuid "a0362577-a809-5212-97fc-f68b9c903158" :answer/type :answer.type/image :answer/value "images/44/447a65ae65d28c29d97170c576a4b5daf61345dfd5be6eafb677a59d9702f76a.png" :db/ensure [:answer/validate]} {:db/id "answer-ce9e0618-ec14-563b-be45-2904cff0fc80" :answer/id #uuid "ce9e0618-ec14-563b-be45-2904cff0fc80" :answer/type :answer.type/image :answer/value "images/7e/7e2c8543b9092501ef1a36289010f74e967b7a7238cfe9fe6904710cc0ffda08.png" :db/ensure [:answer/validate]} {:db/id "answer-a175f293-1509-584d-bc0c-d4cb84c90591" :answer/id #uuid "a175f293-1509-584d-bc0c-d4cb84c90591" :answer/type :answer.type/image :answer/value "images/81/817328612514da56e2373483b7b579c5f8be03fb8b8ce182ec8220182a6bc9e7.png" :db/ensure [:answer/validate]} {:db/id "answer-9db9c939-0e10-532b-9f82-1b953ae7623f" :answer/id #uuid "9db9c939-0e10-532b-9f82-1b953ae7623f" :answer/type :answer.type/image :answer/value "images/c3/c3b46d339b4a8faffe148f083270236ac63ed5cd627fdedf83ae321cb08749ab.png" :db/ensure [:answer/validate]} {:db/id "question-93f851d7-f3f4-511e-adef-c16fd42c2432" :question/id #uuid "93f851d7-f3f4-511e-adef-c16fd42c2432" :question/math-academy-id "q-44781" :question/problem "Represent the solution of the inequality $-2x+3\\le 7$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $3$ from both sides:\n\n$$\n\\begin{aligned}-2x+3 & \\le 7 \\\\ -2x+3-3 & \\le 7-3 \\\\ -2x+0 & \\le 4 \\\\ -2x & \\le 4\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing by $-2.$ \n\nRemember, when multiplying or dividing by a negative number, we need to flip the inequality:\n\n$$\n\\begin{aligned}-2x\\,\\, & \\le \\,\\,4 \\\\ \\frac{-2x}{-2}\\, & \\ge \\,\\,\\frac{4}{-2} \\\\ \\frac{\\cancel{-2}x}{\\cancel{-2}}\\, & \\ge \\,\\,-2 \\\\ x\\,\\, & \\ge \\,\\,-2\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -2.$ The solution can be expressed on a number line, as shown below.\n\n![](images/b9/b92ce4122ef412dd99aedba0bd4d01449dc1bf4ad2a9e40bb8894ebdd8fa3593.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-de782307-e385-5716-91a7-af2fcc5b4f7c"] :db/ensure [:question/validate]} {:db/id "answer-field-de782307-e385-5716-91a7-af2fcc5b4f7c" :answer-field/id #uuid "de782307-e385-5716-91a7-af2fcc5b4f7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8733ee62-58f4-5707-b765-cd0aee979d81" :answer-field/choices ["answer-ceb5af45-a7ca-5c8b-b035-a42871ca6fa0" "answer-ce471c74-dd80-5207-8b46-cc54ae26d8f3" "answer-f827a8b1-2175-5e30-bf37-0dfcab286741" "answer-8733ee62-58f4-5707-b765-cd0aee979d81" "answer-e1c76ece-2740-52eb-911f-2c79fc0be91c"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceb5af45-a7ca-5c8b-b035-a42871ca6fa0" :answer/id #uuid "ceb5af45-a7ca-5c8b-b035-a42871ca6fa0" :answer/type :answer.type/image :answer/value "images/49/4962a3a0904dd7d45a83f82e3708adeb9274b80c11849f563e630f8b198a72dc.png" :db/ensure [:answer/validate]} {:db/id "answer-ce471c74-dd80-5207-8b46-cc54ae26d8f3" :answer/id #uuid "ce471c74-dd80-5207-8b46-cc54ae26d8f3" :answer/type :answer.type/image :answer/value "images/66/66c332853de6ddf9494186fec7ee384c84b577d16908daf488882b8d53cb122e.png" :db/ensure [:answer/validate]} {:db/id "answer-f827a8b1-2175-5e30-bf37-0dfcab286741" :answer/id #uuid "f827a8b1-2175-5e30-bf37-0dfcab286741" :answer/type :answer.type/image :answer/value "images/b9/b92b3f18e34d94007facc917c8675d9e7fb62e4f3a33e0aa36afce5a2cc90a32.png" :db/ensure [:answer/validate]} {:db/id "answer-8733ee62-58f4-5707-b765-cd0aee979d81" :answer/id #uuid "8733ee62-58f4-5707-b765-cd0aee979d81" :answer/type :answer.type/image :answer/value "images/b9/b92ce4122ef412dd99aedba0bd4d01449dc1bf4ad2a9e40bb8894ebdd8fa3593.png" :db/ensure [:answer/validate]} {:db/id "answer-e1c76ece-2740-52eb-911f-2c79fc0be91c" :answer/id #uuid "e1c76ece-2740-52eb-911f-2c79fc0be91c" :answer/type :answer.type/image :answer/value "images/ca/cae0dff0348d79e848762a89b920c8eee1b5489c9258cc6bf4bf50e74b21e710.png" :db/ensure [:answer/validate]} {:db/id 17592186193860 :tutorial/content "We can always represent the solution of an inequality using a number line.\n\nFor example, let's express the solution of the following inequality using a number line:\n\n$$\n5x \\geq 30\n$$\n\nThe variable $x$ is being *multiplied* by $5.$ To isolate $x,$ we can perform the *opposite* operation, which is *dividing* by $5.$ So, we divide both sides of the inequality by $5{:}$\n\n$$\n\\begin{aligned}5x & \\ge 30 \\\\ \\frac{5x}{5} & \\ge \\frac{30}{5} \\\\ \\frac{5x}{5} & \\ge 6\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $5$ from the numerator and denominator:\n\n$$\n\\begin{aligned}\\frac{5x}{5} & \\ge 6 \\\\ \\frac{\\cancel{5}x}{\\cancel{5}} & \\ge 6 \\\\ x & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $x \\geq 6.$ This solution can be expressed on a number line, as shown below.\n\n![](images/c3/c3a3d5a89d9181af5de9658ad2ac00cd8026a3050d48765dba5f5b23d3a0e7bc.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186192908 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186221431 :knowledge-point/questions ["question-90de09a4-cb73-52eb-bce8-60541ed9cd90"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186370079 :question/problem "For the function\n\n$$\nG(s)=\\frac{6}{{s}^{5}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{6}{{s}^{5}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{6}{{s}^{4}}.$\nAlso, we know that\n\n$$\nL\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{6}{{s}^{4}}\\} \\\\  & ={L}^{-1}\\{\\frac{3!}{{s}^{3+1}}\\} \\\\  & ={t}^{3}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{3}\\,\\text{d}τ \\\\  & =\\frac{{t}^{4}}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-90de09a4-cb73-52eb-bce8-60541ed9cd90" :question/id #uuid "90de09a4-cb73-52eb-bce8-60541ed9cd90" :question/math-academy-id "q-330844" :question/problem "For the function\n\n$$\nG(s)=\\frac{120}{{s}^{7}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{120}{{s}^{7}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{120}{{s}^{6}}.$\nAlso, we know that\n\n$$\nL\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{120}{{s}^{6}}\\} \\\\  & ={L}^{-1}\\{\\frac{5!}{{s}^{5+1}}\\} \\\\  & ={t}^{5}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{5}\\,\\text{d}τ \\\\  & =\\frac{{t}^{6}}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c608cf93-4730-5e85-9788-45b64178d3fb"] :db/ensure [:question/validate]} {:db/id "answer-field-c608cf93-4730-5e85-9788-45b64178d3fb" :answer-field/id #uuid "c608cf93-4730-5e85-9788-45b64178d3fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4118ae4d-b8a7-5823-87d1-3c5655dd813f" :answer-field/choices ["answer-d45cf0c7-70de-5cf2-a714-6638ad61a769" "answer-e01c50ab-0391-5539-ad7b-4da467964cb6" "answer-4118ae4d-b8a7-5823-87d1-3c5655dd813f" "answer-6b9598b0-732d-5f03-a1ef-718b28f8b7c7" "answer-2a1f2a74-a853-5ec7-b0b4-0f03d890eefb"] :db/ensure [:answer-field/validate]} {:db/id "answer-d45cf0c7-70de-5cf2-a714-6638ad61a769" :answer/id #uuid "d45cf0c7-70de-5cf2-a714-6638ad61a769" :answer/type :answer.type/math :answer/value "\\frac{120}{{t}^{6}}" :db/ensure [:answer/validate]} {:db/id "answer-e01c50ab-0391-5539-ad7b-4da467964cb6" :answer/id #uuid "e01c50ab-0391-5539-ad7b-4da467964cb6" :answer/type :answer.type/math :answer/value "\\frac{{t}^{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-4118ae4d-b8a7-5823-87d1-3c5655dd813f" :answer/id #uuid "4118ae4d-b8a7-5823-87d1-3c5655dd813f" :answer/type :answer.type/math :answer/value "\\frac{{t}^{6}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-6b9598b0-732d-5f03-a1ef-718b28f8b7c7" :answer/id #uuid "6b9598b0-732d-5f03-a1ef-718b28f8b7c7" :answer/type :answer.type/math :answer/value "\\frac{{t}^{7}}{42}" :db/ensure [:answer/validate]} {:db/id "answer-2a1f2a74-a853-5ec7-b0b4-0f03d890eefb" :answer/id #uuid "2a1f2a74-a853-5ec7-b0b4-0f03d890eefb" :answer/type :answer.type/math :answer/value "{t}^{5}" :db/ensure [:answer/validate]} {:db/id 17592186221432 :knowledge-point/questions ["question-e8bb9695-808d-511b-81de-dd222d55651d" "question-1fff8974-347e-5cb7-8b9b-0077208b27ab"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e8bb9695-808d-511b-81de-dd222d55651d" :question/id #uuid "e8bb9695-808d-511b-81de-dd222d55651d" :question/math-academy-id "q-331054" :question/problem "Suppose we wish to find $L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={{field-3}} \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-6}}\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2161928e-f74f-573a-af14-39c0404a2ddd" "answer-field-7115419f-da22-5bc1-a720-36b742b78dd6" "answer-field-b8b13f7f-9d65-5a2b-9855-7e326801a846" "answer-field-f8bd19cb-6527-5598-b5cd-1224a8a1f8be" "answer-field-55e3df8b-c81c-5876-b3c9-3ed9d7bb8b3a" "answer-field-09a061c0-a394-598e-a30e-f9f916c35a0f"] :db/ensure [:question/validate]} {:db/id "answer-field-2161928e-f74f-573a-af14-39c0404a2ddd" :answer-field/id #uuid "2161928e-f74f-573a-af14-39c0404a2ddd" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-1ef0afb0-0e9f-593c-b760-f2229f6e2105" :answer-field/choices ["answer-1ef0afb0-0e9f-593c-b760-f2229f6e2105" "answer-cac040df-ceaa-58d4-94b8-5f753607a6cb" "answer-f5139fa5-2fba-58db-a4ca-f650ec7512cb" "answer-f877233b-10cb-5e81-9102-7e5858dabded"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ef0afb0-0e9f-593c-b760-f2229f6e2105" :answer/id #uuid "1ef0afb0-0e9f-593c-b760-f2229f6e2105" :answer/type :answer.type/math :answer/value "A(t)" :db/ensure [:answer/validate]} {:db/id "answer-cac040df-ceaa-58d4-94b8-5f753607a6cb" :answer/id #uuid "cac040df-ceaa-58d4-94b8-5f753607a6cb" :answer/type :answer.type/math :answer/value "f(τ)" :db/ensure [:answer/validate]} {:db/id "answer-f5139fa5-2fba-58db-a4ca-f650ec7512cb" :answer/id #uuid "f5139fa5-2fba-58db-a4ca-f650ec7512cb" :answer/type :answer.type/math :answer/value "{A}^{′}(t)" :db/ensure 