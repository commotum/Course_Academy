5a6f-bfb3-ae21d2a232b0" :answer/id #uuid "0a8105fb-f4bc-5a6f-bfb3-ae21d2a232b0" :answer/type :answer.type/text :answer/value "None of the options is correct" :db/ensure [:answer/validate]} {:db/id "question-e7ace049-182d-5867-9256-197b885a5673" :question/id #uuid "e7ace049-182d-5867-9256-197b885a5673" :question/math-academy-id "q-123739" :question/problem "Let $R=[1,2]\\times [3,4]$ be a region in the $xy$-plane, and let $f(x,y)=25-2{x}^{2}-{y}^{2}.$ Further, let \n\n$$\nI={∬}_{R}f(x,y)\\,\\text{d}A\n$$\n\nbe the unique number such that over all rectangular partitions $P$ of $R,$ we have \n$L(f,P)\\,\\le I\\,\\le U(f,P),$\nwhere $L(f,P)$ and $U(f,P)$ are the corresponding lower and upper Riemann sums, and \n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\\,.\n$$\n\nWhat expression is missing from the double summation above?" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$ \n\nWe need to compute $U(f,P).$ \n\nNotice that for all subregions ${R}_{ij},$ we have that\n\n- $f(x,y)=25-2{x}^{2}-{y}^{2}$ decreases as $x$ increases, and\n\n- $f(x,y)=25-2{x}^{2}-{y}^{2}$ decreases as $y$ increases.\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion. Therefore,\n\n$$\n{M}_{ij}=f({x}_{i-1},{y}_{j-1})=25-2{x}_{i-1}^{2}-{y}_{j-1}^{2}\n$$\n\nand the upper Riemann sum is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(25-2{x}_{i-1}^{2}-{y}_{j-1}^{2})Δ{x}_{i}Δ{y}_{j}.\n$$\n\nSo, the missing expression is $25-2{x}_{i-1}^{2}-{y}_{j-1}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b445ce38-a658-508d-aa3e-0d6849827d6d"] :db/ensure [:question/validate]} {:db/id "answer-field-b445ce38-a658-508d-aa3e-0d6849827d6d" :answer-field/id #uuid "b445ce38-a658-508d-aa3e-0d6849827d6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-757b9da1-118e-533a-9f87-773bf8421955" :answer-field/choices ["answer-757b9da1-118e-533a-9f87-773bf8421955" "answer-5850cba3-8505-5490-af92-ff55d93ad7c9" "answer-e1751e07-ab63-55d5-b441-84b4cc059fe9" "answer-90aafbe6-4932-5490-9a56-ed4cbe177dff" "answer-6dd17b0a-f96f-5478-adb3-fca9bb8a8df5"] :db/ensure [:answer-field/validate]} {:db/id "answer-757b9da1-118e-533a-9f87-773bf8421955" :answer/id #uuid "757b9da1-118e-533a-9f87-773bf8421955" :answer/type :answer.type/math :answer/value "25-2{x}_{i-1}^{2}-{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5850cba3-8505-5490-af92-ff55d93ad7c9" :answer/id #uuid "5850cba3-8505-5490-af92-ff55d93ad7c9" :answer/type :answer.type/math :answer/value "25-2{x}_{i-1}^{2}-{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e1751e07-ab63-55d5-b441-84b4cc059fe9" :answer/id #uuid "e1751e07-ab63-55d5-b441-84b4cc059fe9" :answer/type :answer.type/math :answer/value "25-2{x}_{i}^{2}-{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-90aafbe6-4932-5490-9a56-ed4cbe177dff" :answer/id #uuid "90aafbe6-4932-5490-9a56-ed4cbe177dff" :answer/type :answer.type/math :answer/value "25-2{x}_{i}^{2}-{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-6dd17b0a-f96f-5478-adb3-fca9bb8a8df5" :answer/id #uuid "6dd17b0a-f96f-5478-adb3-fca9bb8a8df5" :answer/type :answer.type/text :answer/value "None of the options is correct" :db/ensure [:answer/validate]} {:db/id 17592186129421 :question/problem "Let $R=[2,4]\\times [1,5]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=5$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ in each subregion ${R}_{ij}.$ \n\nNow, since ${m}_{ij}={M}_{ij}=5,$ we obtain\n\n$$\n\\begin{aligned}L(f,P)=U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}5\\,Δ{x}_{i}Δ{y}_{j} \\\\  & =5({\\sum }_{i=1}^{m}Δ{x}_{i})({\\sum }_{j=1}^{n}Δ{y}_{j}) \\\\  & =5(4-2)(5-1) \\\\  & =5\\cdot 2\\cdot 4 \\\\  & =40.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\nL(f,P)=40\\le {∬}_{R}f(x,y)\\,\\text{d}A\\le 40=U(f,P)\n$$\n\nwhich implies that\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=40.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186126026 :answer-field/correct 17592186126028 :db/ensure [:answer-field/validate]} {:db/id "question-0ff4898d-e534-599f-872e-88eb7fcaa580" :question/id #uuid "0ff4898d-e534-599f-872e-88eb7fcaa580" :question/math-academy-id "q-72911" :question/problem "Let $R=[-4,-1]\\times [0,3]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=7$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ in each subregion ${R}_{ij}.$ \n\nNow, since ${m}_{ij}={M}_{ij}=7,$ we obtain\n\n$$\n\\begin{aligned}L(f,P)=U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}7\\,Δ{x}_{i}Δ{y}_{j} \\\\  & =7({\\sum }_{i=1}^{m}Δ{x}_{i})({\\sum }_{j=1}^{n}Δ{y}_{j}) \\\\  & =7(-1-(-4))(3-0) \\\\  & =7\\cdot 3\\cdot 3 \\\\  & =63.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\nL(f,P)=63\\le {∬}_{R}f(x,y)\\,\\text{d}A\\le 63=U(f,P)\n$$\n\nwhich implies that\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=63.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7a591715-ee7a-5d95-ad6f-8eddb8ceb664"] :db/ensure [:question/validate]} {:db/id "answer-field-7a591715-ee7a-5d95-ad6f-8eddb8ceb664" :answer-field/id #uuid "7a591715-ee7a-5d95-ad6f-8eddb8ceb664" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a66b95b0-9cf5-502b-8503-2f74022c819c" :answer-field/choices ["answer-3d96103a-eddc-50df-bfc0-a254c0984a0e" "answer-2665a54a-8368-5f0d-8ea1-c4836034f779" "answer-a66b95b0-9cf5-502b-8503-2f74022c819c" "answer-c92f13f3-d565-5882-be3d-5e94075608d8" "answer-f0433c78-2baf-59bd-b1b5-e562af81ef70"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d96103a-eddc-50df-bfc0-a254c0984a0e" :answer/id #uuid "3d96103a-eddc-50df-bfc0-a254c0984a0e" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-2665a54a-8368-5f0d-8ea1-c4836034f779" :answer/id #uuid "2665a54a-8368-5f0d-8ea1-c4836034f779" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "answer-a66b95b0-9cf5-502b-8503-2f74022c819c" :answer/id #uuid "a66b95b0-9cf5-502b-8503-2f74022c819c" :answer/type :answer.type/math :answer/value "63" :db/ensure [:answer/validate]} {:db/id "answer-c92f13f3-d565-5882-be3d-5e94075608d8" :answer/id #uuid "c92f13f3-d565-5882-be3d-5e94075608d8" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "answer-f0433c78-2baf-59bd-b1b5-e562af81ef70" :answer/id #uuid "f0433c78-2baf-59bd-b1b5-e562af81ef70" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-d4b9b0fb-ea18-5f41-b2d9-09722c1e1b90" :question/id #uuid "d4b9b0fb-ea18-5f41-b2d9-09722c1e1b90" :question/math-academy-id "q-72912" :question/problem "Let $R=[2,7]\\times [-5,-4]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=-5$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ in each subregion ${R}_{ij}.$ \n\nNow, since ${m}_{ij}={M}_{ij}=-5,$ we obtain\n\n$$\n\\begin{aligned}L(f,P)=U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(-5)\\,Δ{x}_{i}Δ{y}_{j} \\\\  & =-5({\\sum }_{i=1}^{m}Δ{x}_{i})({\\sum }_{j=1}^{n}Δ{y}_{j}) \\\\  & =-5(7-2)(-4-(-5)) \\\\  & =-5\\cdot 5\\cdot 1 \\\\  & =-25.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\nL(f,P)=-25\\le {∬}_{R}f(x,y)\\,\\text{d}A\\le -25=U(f,P)\n$$\n\nwhich implies that\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=-25.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e285720e-425f-5085-8c1d-909dd19d0877"] :db/ensure [:question/validate]} {:db/id "answer-field-e285720e-425f-5085-8c1d-909dd19d0877" :answer-field/id #uuid "e285720e-425f-5085-8c1d-909dd19d0877" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a630db6-b2af-5715-973e-f8fab2c45884" :answer-field/choices ["answer-1b910532-e678-59a6-9fc0-591fe469e753" "answer-8a630db6-b2af-5715-973e-f8fab2c45884" "answer-9b51160b-236c-505c-8af3-e10fd336f85b" "answer-70e94939-5748-5e18-8702-5801f1a1f0e5" "answer-47353a54-dd87-5fb8-a7bd-3983b1ecac9d"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b910532-e678-59a6-9fc0-591fe469e753" :answer/id #uuid "1b910532-e678-59a6-9fc0-591fe469e753" :answer/type :answer.type/math :answer/value "-100" :db/ensure [:answer/validate]} {:db/id "answer-8a630db6-b2af-5715-973e-f8fab2c45884" :answer/id #uuid "8a630db6-b2af-5715-973e-f8fab2c45884" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "answer-9b51160b-236c-505c-8af3-e10fd336f85b" :answer/id #uuid "9b51160b-236c-505c-8af3-e10fd336f85b" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-70e94939-5748-5e18-8702-5801f1a1f0e5" :answer/id #uuid "70e94939-5748-5e18-8702-5801f1a1f0e5" :answer/type :answer.type/math :answer/value "-50" :db/ensure [:answer/validate]} {:db/id "answer-47353a54-dd87-5fb8-a7bd-3983b1ecac9d" :answer/id #uuid "47353a54-dd87-5fb8-a7bd-3983b1ecac9d" :answer/type :answer.type/math :answer/value "-75" :db/ensure [:answer/validate]} {:db/id "question-60d97de9-38ad-5bc2-ac62-24badbb7cfc3" :question/id #uuid "60d97de9-38ad-5bc2-ac62-24badbb7cfc3" :question/math-academy-id "q-123842" :question/problem "Let $R=[0,3]\\times [6,10]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=10$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ in each subregion ${R}_{ij}.$ \n\nNow, since ${m}_{ij}={M}_{ij}=10,$ we obtain\n\n$$\n\\begin{aligned}L(f,P)=U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}10\\,Δ{x}_{i}Δ{y}_{j} \\\\  & =10({\\sum }_{i=1}^{m}Δ{x}_{i})({\\sum }_{j=1}^{n}Δ{y}_{j}) \\\\  & =10(3-0)(10-6) \\\\  & =10\\cdot 3\\cdot 4 \\\\  & =120.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\nL(f,P)=120\\le {∬}_{R}f(x,y)\\,\\text{d}A\\le 120=U(f,P)\n$$\n\nwhich implies that\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=120.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-21d026c6-e63c-5eb4-8cc5-202bed8dbc9f"] :db/ensure [:question/validate]} {:db/id "answer-field-21d026c6-e63c-5eb4-8cc5-202bed8dbc9f" :answer-field/id #uuid "21d026c6-e63c-5eb4-8cc5-202bed8dbc9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d2e3215-aff4-5a65-95f0-9669ebd5076d" :answer-field/choices ["answer-0ffac16d-d1ad-5f31-8dd3-624a1864b9a3" "answer-1d2e3215-aff4-5a65-95f0-9669ebd5076d" "answer-aa3efd71-ec74-5d37-b91f-51d1f77a913d" "answer-61f538cd-b1ab-55a6-aa7f-ec30b2519b94" "answer-dec99a45-e5df-54af-9c05-6b66c37cc89d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ffac16d-d1ad-5f31-8dd3-624a1864b9a3" :answer/id #uuid "0ffac16d-d1ad-5f31-8dd3-624a1864b9a3" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-1d2e3215-aff4-5a65-95f0-9669ebd5076d" :answer/id #uuid "1d2e3215-aff4-5a65-95f0-9669ebd5076d" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-aa3efd71-ec74-5d37-b91f-51d1f77a913d" :answer/id #uuid "aa3efd71-ec74-5d37-b91f-51d1f77a913d" :answer/type :answer.type/math :answer/value "140" :db/ensure [:answer/validate]} {:db/id "answer-61f538cd-b1ab-55a6-aa7f-ec30b2519b94" :answer/id #uuid "61f538cd-b1ab-55a6-aa7f-ec30b2519b94" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "answer-dec99a45-e5df-54af-9c05-6b66c37cc89d" :answer/id #uuid "dec99a45-e5df-54af-9c05-6b66c37cc89d" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id 17592186129854 :question/problem "Let $R=[2,5]\\times [-2,2]$ be a region in the $xy$-plane, and let $f(x,y)$ be a function defined over $R.$\nThe lower and upper Riemann sums corresponding to an arbitrary partition $P$ of $R$ are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(2{y}_{j-1}-2{x}_{i}+1)Δ{x}_{i}Δ{y}_{j}, \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(2{y}_{j}-2{x}_{i-1}+1)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nUsing the definition of the double integral in terms of $L(f,P)$ and $U(f,P),$ compute ${∬}_{R}f(x,y)\\,\\text{d}A.$\n\n*Hint: You may wish to make use of the following results:*\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}=({x}_{m}^{2}-{x}_{0}^{2})({y}_{n}-{y}_{0}) \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j}=({x}_{m}-{x}_{0})({y}_{n}-{y}_{0})\\end{aligned}\n$$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P)\n$$\n\nover all partitions $P$ of $R.$\n\nFirst, notice that ${\\overset{¯}{x}}_{i}=\\frac{1}{2}({x}_{i-1}+{x}_{i})$ will always lie between ${x}_{i-1}$ and ${x}_{i}$, and similarly ${\\overset{¯}{y}}_{j}=\\frac{1}{2}({y}_{j-1}+{y}_{j})$ will always lie between ${y}_{j-1}$ and ${y}_{j}.$ Therefore,\n\n$$\n2{y}_{j-1}-2{x}_{i}+1\\le 2\\cdot \\frac{1}{2}({y}_{j-1}+{y}_{j})-2\\cdot \\frac{1}{2}({x}_{i-1}+{x}_{i})+1\\le 2{y}_{j}-2{x}_{i-1}+1\n$$\n\nwhich simplifies to \n\n$$\n2{y}_{j-1}-2{x}_{i}+1\\le ({y}_{j-1}+{y}_{j})-({x}_{i-1}+{x}_{i})+1\\le 2{y}_{j}-2{x}_{i-1}+1.\n$$\n\nMultiplying this by $Δ{x}_{i}Δ{y}_{j}$ and applying the double summation gives:\n\n$$\nL(f,P)\\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}[({y}_{j-1}+{y}_{j})-({x}_{i-1}+{x}_{i})+1]Δ{x}_{i}Δ{y}_{j}\\le U(f,P)\n$$\n\nSeparating the sums using the addition rule, we get\n\n$$\n\\begin{aligned}L(f,P) & \\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} \\\\  & \\,-{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} \\\\  & \\,+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} \\\\  & \\le U(f,P).\\end{aligned}\n$$\n\nUsing the hint, we get the following:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{j-1}+{x}_{j})Δ{x}_{i}Δ{y}_{j} & =({5}^{2}-{2}^{2})(2-(-2))=84 \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} & =({2}^{2}-(-2)^{2})(5-2)=0 \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} & =(5-2)(2-(-2))=12\\end{aligned}\n$$\n\nFinally then:\n\n$$\n\\begin{aligned}L(f,P)\\le 0-84+12\\le U(f,P)\\,⟹\\,L(f,P)\\le -72\\le U(f,P)\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=-72.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186128605 :answer-field/correct 17592186128608 :db/ensure [:answer-field/validate]} {:db/id "question-f1c4174f-ebe1-5065-81d1-0761f7cc8648" :question/id #uuid "f1c4174f-ebe1-5065-81d1-0761f7cc8648" :question/math-academy-id "q-72907" :question/problem "Let $R=[0,6]\\times [1,2]$ be a region in the $xy$-plane, and let $f(x,y)$ be a function defined over $R.$\nThe lower and upper Riemann sums corresponding to an arbitrary partition $P$ of $R$ are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}-{y}_{j})Δ{x}_{i}Δ{y}_{j}, \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i}-{y}_{j-1})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nUsing the definition of the double integral in terms of $L(f,P)$ and $U(f,P),$ compute ${∬}_{R}f(x,y)\\,\\text{d}A.$\n\n*Hint: You may wish to make use of the following result:*\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}=({x}_{m}^{2}-{x}_{0}^{2})({y}_{n}-{y}_{0})\\end{aligned}\n$$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P)\n$$\n\nover all partitions $P$ of $R.$\n\nFirst, notice that ${\\overset{¯}{x}}_{i}=\\frac{1}{2}({x}_{i-1}+{x}_{i})$ will always lie between ${x}_{i-1}$ and ${x}_{i}$, and similarly ${\\overset{¯}{y}}_{j}=\\frac{1}{2}({y}_{j-1}+{y}_{j})$ will always lie between ${y}_{j-1}$ and ${y}_{j}.$ Therefore,\n\n$$\n{x}_{i-1}-{y}_{j}\\le \\frac{1}{2}({x}_{i-1}+{x}_{i})-\\frac{1}{2}({y}_{j-1}+{y}_{j})\\le {x}_{i}-{y}_{j-1}\n$$\n\nMultiplying this by $Δ{x}_{i}Δ{y}_{j}$ and applying the double summation gives:\n\n$$\nL(f,P)\\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}[\\frac{1}{2}({x}_{i-1}+{x}_{i})-\\frac{1}{2}({y}_{j-1}+{y}_{j})]Δ{x}_{i}Δ{y}_{j}\\le U(f,P)\n$$\n\nSeparating the sums using the addition and constant multiple rules, we get\n\n$$\n\\begin{aligned}L(f,P) & \\le \\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}-\\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} \\\\  & \\le U(f,P).\\end{aligned}\n$$\n\nUsing the hint, we get the following:\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} & =\\frac{1}{2}({6}^{2}-{0}^{2})(2-1)=18 \\\\ \\frac{1}{2}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} & =\\frac{1}{2}({2}^{2}-{1}^{2})(6-0)=9\\end{aligned}\n$$\n\nFinally then:\n\n$$\n\\begin{aligned}L(f,P)\\le 18-9\\le U(f,P)\\,⟹\\,L(f,P)\\le 9\\le U(f,P)\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=9.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fd4f35ba-dc99-55f4-89c9-fd9fa4a3c49f"] :db/ensure [:question/validate]} {:db/id "answer-field-fd4f35ba-dc99-55f4-89c9-fd9fa4a3c49f" :answer-field/id #uuid "fd4f35ba-dc99-55f4-89c9-fd9fa4a3c49f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6077bd80-b2f2-516a-9522-53d1d4881f71" :answer-field/choices ["answer-7b153448-8d81-5ab9-b5f8-58997bf3f8b5" "answer-1d642645-7c2a-5ab7-8f58-4f03edba3213" "answer-064a104c-4e51-5489-b7b3-01bd2228b1ff" "answer-457523d5-a938-5ee1-a080-7acf69cac9c1" "answer-6077bd80-b2f2-516a-9522-53d1d4881f71"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b153448-8d81-5ab9-b5f8-58997bf3f8b5" :answer/id #uuid "7b153448-8d81-5ab9-b5f8-58997bf3f8b5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-1d642645-7c2a-5ab7-8f58-4f03edba3213" :answer/id #uuid "1d642645-7c2a-5ab7-8f58-4f03edba3213" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-064a104c-4e51-5489-b7b3-01bd2228b1ff" :answer/id #uuid "064a104c-4e51-5489-b7b3-01bd2228b1ff" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-457523d5-a938-5ee1-a080-7acf69cac9c1" :answer/id #uuid "457523d5-a938-5ee1-a080-7acf69cac9c1" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-6077bd80-b2f2-516a-9522-53d1d4881f71" :answer/id #uuid "6077bd80-b2f2-516a-9522-53d1d4881f71" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-e70b7574-2559-53cf-be83-ad5d3ac424a1" :question/id #uuid "e70b7574-2559-53cf-be83-ad5d3ac424a1" :question/math-academy-id "q-123855" :question/problem "Let $R=[1,3]\\times [-1,1]$ be a region in the $xy$-plane, and let $f(x,y)$ be a function defined over $R.$\nThe lower and upper Riemann sums corresponding to an arbitrary partition $P$ of $R$ are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(4{x}_{i-1}-2{y}_{j}-2)Δ{x}_{i}Δ{y}_{j}, \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(4{x}_{i}-2{y}_{j-1}-2)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nUsing the definition of the double integral in terms of $L(f,P)$ and $U(f,P),$ compute ${∬}_{R}f(x,y)\\,\\text{d}A.$\n\n*Hint: You may wish to make use of the following results:*\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j}=({x}_{m}^{2}-{x}_{0}^{2})({y}_{n}-{y}_{0}) \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j}=({x}_{m}-{x}_{0})({y}_{n}-{y}_{0})\\end{aligned}\n$$" :question/worked-solution "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P)\n$$\n\nover all partitions $P$ of $R.$\n\nFirst, notice that ${\\overset{¯}{x}}_{i}=\\frac{1}{2}({x}_{i-1}+{x}_{i})$ will always lie between ${x}_{i-1}$ and ${x}_{i}$, and similarly ${\\overset{¯}{y}}_{j}=\\frac{1}{2}({y}_{j-1}+{y}_{j})$ will always lie between ${y}_{j-1}$ and ${y}_{j}.$ Therefore,\n\n$$\n4{x}_{i-1}-2{y}_{j}-2\\le 4\\cdot \\frac{1}{2}({x}_{i-1}+{x}_{i})-2\\cdot \\frac{1}{2}({y}_{j-1}+{y}_{j})-2\\le 4{x}_{i}-2{y}_{j-1}-2\n$$\n\nwhich simplifies to\n\n$$\n4{x}_{i-1}-2{y}_{j}-2\\le 2({x}_{i-1}+{x}_{i})-({y}_{j-1}+{y}_{j})-2\\le 4{x}_{i}-2{y}_{j-1}-2.\n$$\n\nMultiplying this by $Δ{x}_{i}Δ{y}_{j}$ and applying the double summation gives:\n\n$$\nL(f,P)\\le {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}[2({x}_{i-1}+{x}_{i})-({y}_{j-1}+{y}_{j})-2]Δ{x}_{i}Δ{y}_{j}\\le U(f,P)\n$$\n\nSeparating the sums using the addition and constant multiple rules, we get\n\n$$\n\\begin{aligned}L(f,P) & \\le 2{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} \\\\  & \\,-{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} \\\\  & \\,-2{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} \\\\  & \\le U(f,P).\\end{aligned}\n$$\n\nUsing the hint, we get the following:\n\n$$\n\\begin{aligned}2{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}+{x}_{i})Δ{x}_{i}Δ{y}_{j} & =2({3}^{2}-{1}^{2})(1-(-1))=32 \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j-1}+{y}_{j})Δ{x}_{i}Δ{y}_{j} & =({1}^{2}-(-1)^{2})(3-1)=0 \\\\ 2{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} & =2(3-1)(1-(-1))=8\\end{aligned}\n$$\n\nFinally then:\n\n$$\n\\begin{aligned}L(f,P)\\le 32-0-8\\le U(f,P)\\,⟹\\,L(f,P)\\le 24\\le U(f,P)\\end{aligned}\n$$\n\nTherefore, we conclude that \n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=24.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-13b8ca33-75b3-517a-8d1c-6614e349d536"] :db/ensure [:question/validate]} {:db/id "answer-field-13b8ca33-75b3-517a-8d1c-6614e349d536" :answer-field/id #uuid "13b8ca33-75b3-517a-8d1c-6614e349d536" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-78e2f9f7-e47c-5e90-a68b-6243eff97531" :answer-field/choices ["answer-3894ea51-8099-503a-9254-0bc6a90a4fd3" "answer-16bca27f-4154-5ab8-b627-7c6d57d7d4d6" "answer-c9ebab66-ba68-5c89-bf35-1ea9d2f610a3" "answer-78e2f9f7-e47c-5e90-a68b-6243eff97531" "answer-406dc145-2407-567c-8138-8eb417181612"] :db/ensure [:answer-field/validate]} {:db/id "answer-3894ea51-8099-503a-9254-0bc6a90a4fd3" :answer/id #uuid "3894ea51-8099-503a-9254-0bc6a90a4fd3" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-16bca27f-4154-5ab8-b627-7c6d57d7d4d6" :answer/id #uuid "16bca27f-4154-5ab8-b627-7c6d57d7d4d6" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-c9ebab66-ba68-5c89-bf35-1ea9d2f610a3" :answer/id #uuid "c9ebab66-ba68-5c89-bf35-1ea9d2f610a3" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-78e2f9f7-e47c-5e90-a68b-6243eff97531" :answer/id #uuid "78e2f9f7-e47c-5e90-a68b-6243eff97531" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-406dc145-2407-567c-8138-8eb417181612" :answer/id #uuid "406dc145-2407-567c-8138-8eb417181612" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id 17592186233159 :question/answer-fields ["answer-field-707261a6-3005-5fdd-8637-a87bd78e3dff"] :db/ensure [:question/vali