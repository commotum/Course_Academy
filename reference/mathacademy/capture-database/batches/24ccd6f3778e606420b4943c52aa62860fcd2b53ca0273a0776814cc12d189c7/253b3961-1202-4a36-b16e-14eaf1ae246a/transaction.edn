:step/validate]} {:db/id "step-5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :step/id #uuid "5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :step/content "question-737200e6-c3ef-51a6-b724-78dcb92c8633" :step/next "step-2a7599e0-d833-5e8d-955f-489466bc1e3b" :db/ensure [:step/validate]} {:db/id "step-2a7599e0-d833-5e8d-955f-489466bc1e3b" :step/id #uuid "2a7599e0-d833-5e8d-955f-489466bc1e3b" :step/content "question-c76e6329-2e41-5111-9e2f-17e316c25286" :db/ensure [:step/validate]} {:db/id 17592186064174 :knowledge-point/questions ["question-41aba970-483d-56bd-ae8a-765c80a69d27" "question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-41aba970-483d-56bd-ae8a-765c80a69d27" :question/id #uuid "41aba970-483d-56bd-ae8a-765c80a69d27" :question/math-academy-id "q-28887" :question/problem "Find the intersection of intervals $(-2,\\infty )\\cap (1,\\infty ).$ Express the result as an inequality." :question/worked-solution "We start by sketching the two intervals $(-2,\\infty )$ and $(1,\\infty )$ separately:\n\n![](images/4b/4bd70e5f89643a5d2b19954003435b4c6aeec24c68bb3cd1f6a4e7a98c14f847.png)\n\n![](images/ef/eff58d0bb2d496d608ae1e415f38589c5b9b13efe1f282d172fb5313ba6792ff.png)\n\nThe intersection $(-2,\\infty )\\cap (1,\\infty )$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/61/6131e16f37e8ec44eae8c085be60a28dd094390e1975bdafe256cdc9e229f3dc.png)\n\nThus, $(-2,\\infty )\\cap (1,\\infty )=(1,\\infty ).$ This corresponds to the inequality $x>1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c997497d-11b1-5f1f-b96d-9d3ba0bd5017"] :db/ensure [:question/validate]} {:db/id "answer-field-c997497d-11b1-5f1f-b96d-9d3ba0bd5017" :answer-field/id #uuid "c997497d-11b1-5f1f-b96d-9d3ba0bd5017" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-648a569e-d6e2-581e-aaf0-c3843ce4953c" :answer-field/choices ["answer-ad77b642-5d0e-5f8c-a29c-a1e7f5ae4898" "answer-9ab7a7d4-8d57-556e-a809-860ec8ff4839" "answer-dfd54e2f-92b2-5044-821d-60b7f0fbe85a" "answer-648a569e-d6e2-581e-aaf0-c3843ce4953c" "answer-e5b8e284-2962-5a81-950b-945c41e9dbf2"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad77b642-5d0e-5f8c-a29c-a1e7f5ae4898" :answer/id #uuid "ad77b642-5d0e-5f8c-a29c-a1e7f5ae4898" :answer/type :answer.type/math :answer/value "-2<x<1" :db/ensure [:answer/validate]} {:db/id "answer-9ab7a7d4-8d57-556e-a809-860ec8ff4839" :answer/id #uuid "9ab7a7d4-8d57-556e-a809-860ec8ff4839" :answer/type :answer.type/math :answer/value "-2<x\\le 1" :db/ensure [:answer/validate]} {:db/id "answer-dfd54e2f-92b2-5044-821d-60b7f0fbe85a" :answer/id #uuid "dfd54e2f-92b2-5044-821d-60b7f0fbe85a" :answer/type :answer.type/math :answer/value "x<2" :db/ensure [:answer/validate]} {:db/id "answer-648a569e-d6e2-581e-aaf0-c3843ce4953c" :answer/id #uuid "648a569e-d6e2-581e-aaf0-c3843ce4953c" :answer/type :answer.type/math :answer/value "x>1" :db/ensure [:answer/validate]} {:db/id "answer-e5b8e284-2962-5a81-950b-945c41e9dbf2" :answer/id #uuid "e5b8e284-2962-5a81-950b-945c41e9dbf2" :answer/type :answer.type/math :answer/value "x\\ge 1" :db/ensure [:answer/validate]} {:db/id "question-03c05eb1-a1b5-5135-a57f-9c96b45d2734" :question/id #uuid "03c05eb1-a1b5-5135-a57f-9c96b45d2734" :question/math-academy-id "q-44840" :question/problem "Given the inequalities $-1<x<4$ and $x>2$, express their common set of solutions as an interval." :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](images/f9/f9409f298a0f4d1fd06bdac159e8fd7eb034ee577d2c8956730f0cc3919e051a.png)\n\n![](images/f4/f4fd2c61f600408511d967690cf02c95a3d2fa470aa5d7e9176a222d16823d5b.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/fd/fdf3410c69cf8559abfb7b223fc175bd1704d6334c8abbceb45240c894514172.png)\n\nTherefore, the common set of values is\n$(2,4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84"] :db/ensure [:question/validate]} {:db/id "answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/id #uuid "0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer-field/choices ["answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727" "answer-9599db7b-4328-50e9-b14b-8add3aa5bf58" "answer-371497aa-662c-5dc2-85a5-02ad33faeac9" "answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" "answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/id #uuid "8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/type :answer.type/math :answer/value "(-1,4)" :db/ensure [:answer/validate]} {:db/id "answer-9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/id #uuid "9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/type :answer.type/math :answer/value "(-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/id #uuid "371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/type :answer.type/math :answer/value "(-2,4)" :db/ensure [:answer/validate]} {:db/id "answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/id #uuid "7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/type :answer.type/math :answer/value "(2,4)" :db/ensure [:answer/validate]} {:db/id "answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/id #uuid "1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/type :answer.type/math :answer/value "(2,4]" :db/ensure [:answer/validate]} {:db/id "question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/id #uuid "7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/math-academy-id "q-214598" :question/problem "Find the intersection of intervals $(-\\infty ,4]\\cap (2,4).$ Express the result as an inequality.\n\n{{field-1}}\n\n$<x$\n{{field-2}}{{field-3}}" :question/worked-solution "We start by sketching the two intervals $(-\\infty ,4]$ and $(2,4)$ separately:\n\n![](images/6e/6ea8f23ba164e820b4ae33f6dbd7e5d70e9dd0b5af052a7ce5ecdcb680d3a895.png)\n\n![](images/81/81f94d814f98021781460cbe7c30470e3021832b40525da36563bb11af9804ad.png)\n\nThe intersection $(-\\infty ,4]\\cap (2,4)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/77/772ae637383243d60d40f9bc015c5347b92159b7eccb27cefaa661341176b9d6.png)\n\nThus, $(-\\infty ,4]\\cap (2,4)=(2,4).$ This corresponds to the inequality $2<x<4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" "answer-field-4305667d-3a58-5875-9689-814a3ecc8986" "answer-field-efe77e00-1a52-5b52-ba41-a1e72bc9367b"] :db/ensure [:question/validate]} {:db/id "answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/id #uuid "a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer-field/choices ["answer-6aec283e-3c07-5081-aa5d-febf7b6fb508"] :db/ensure [:answer-field/validate]} {:db/id "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/id #uuid "6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/id #uuid "4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer-field/choices ["answer-58ec3812-afbd-5c73-b90c-51b83b621d84"] :db/ensure [:answer-field/validate]} {:db/id "answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/id #uuid "58ec3812-afbd-5c