31bf2e3766" :db/ensure [:step/validate]} {:db/id "step-8f9fcbe2-aa90-5f81-8960-a431bf2e3766" :step/id #uuid "8f9fcbe2-aa90-5f81-8960-a431bf2e3766" :step/content 17592186284417 :step/next "step-70256a6c-5ad6-59e3-ab08-2d52513a56ea" :db/ensure [:step/validate]} {:db/id "step-70256a6c-5ad6-59e3-ab08-2d52513a56ea" :step/id #uuid "70256a6c-5ad6-59e3-ab08-2d52513a56ea" :step/content 17592186284422 :step/next "step-c3de40d9-0906-5d15-968e-d7cd6767d329" :db/ensure [:step/validate]} {:db/id "step-c3de40d9-0906-5d15-968e-d7cd6767d329" :step/id #uuid "c3de40d9-0906-5d15-968e-d7cd6767d329" :step/content 17592186367888 :step/next "step-87ef8ba1-8124-5cd2-acd6-4507d7bd5ac3" :db/ensure [:step/validate]} {:db/id "step-87ef8ba1-8124-5cd2-acd6-4507d7bd5ac3" :step/id #uuid "87ef8ba1-8124-5cd2-acd6-4507d7bd5ac3" :step/content 17592186284447 :db/ensure [:step/validate]} {:db/id 17592186124585 :knowledge-point/questions ["question-c06702a9-7f9f-5ebf-bbd9-2e359cfd7640"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c06702a9-7f9f-5ebf-bbd9-2e359cfd7640" :question/id #uuid "c06702a9-7f9f-5ebf-bbd9-2e359cfd7640" :question/math-academy-id "q-94606" :question/problem "Given the elliptic cone $\\frac{(x-6)^{2}}{2}+\\frac{(y-4)^{2}}{8}=(z-2)^{2},$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the elliptic cone, we plug $y=0$ and $z=0$ into the equation and solve for $x:$\n\n$$\n\\begin{aligned}\\frac{(x-6)^{2}}{2}+\\frac{(0-4)^{2}}{8} & =(0-2)^{2} \\\\ \\frac{(x-6)^{2}}{2}+\\frac{16}{8} & =4 \\\\ \\frac{(x-6)^{2}}{2}+2 & =4 \\\\ \\frac{(x-6)^{2}}{2} & =2 \\\\ (x-6)^{2} & =4 \\\\ x-6 & =\\pm 2 \\\\ x & =6\\pm 2 \\\\ x & =4,8\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $(4,0,0)$ and $(8,0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7b271f10-b638-58d9-8c15-6f54a2760bc2"] :db/ensure [:question/validate]} {:db/id "answer-field-7b271f10-b638-58d9-8c15-6f54a2760bc2" :answer-field/id #uuid "7b271f10-b638-58d9-8c15-6f54a2760bc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eee23346-be71-5a2e-883c-63ac858b2a5b" :answer-field/choices ["answer-200ae72a-6343-55a0-bb64-42d0cfc2e032" "answer-c850056d-98c5-53e9-817e-b69ff41dd285" "answer-149d7ad3-6a01-5174-82bf-5d60b9244ab5" "answer-7bdd0c2a-eed2-5368-b2da-6b29b25677d8" "answer-eee23346-be71-5a2e-883c-63ac858b2a5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-200ae72a-6343-55a0-bb64-42d0cfc2e032" :answer/id #uuid "200ae72a-6343-55a0-bb64-42d0cfc2e032" :answer/type :answer.type/text :answer/value "$(2,0,0)$ and $(10,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-c850056d-98c5-53e9-817e-b69ff41dd285" :answer/id #uuid "c850056d-98c5-53e9-817e-b69ff41dd285" :answer/type :answer.type/text :answer/value "$(2,0,0)$ and $(6,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-149d7ad3-6a01-5174-82bf-5d60b9244ab5" :answer/id #uuid "149d7ad3-6a01-5174-82bf-5d60b9244ab5" :answer/type :answer.type/text :answer/value "$(2,0,0)$ and $(8,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-7bdd0c2a-eed2-5368-b2da-6b29b25677d8" :answer/id #uuid "7bdd0c2a-eed2-5368-b2da-6b29b25677d8" :answer/type :answer.type/text :answer/value "$(4,0,0)$ and $(10,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-eee23346-be71-5a2e-883c-63ac858b2a5b" :answer/id #uuid "eee23346-be71-5a2e-883c-63ac858b2a5b" :answer/type :answer.type/text :answer/value "$(4,0,0)$ and $(8,0,0)$" :db/ensure [:answer/validate]} {:db/id "activity-b9323fcd-e255-54f9-952c-315c707f7555" :activity/id #uuid "b9323fcd-e255-54f9-952c-315c707f7555" :activity/title "Elliptic Cones" :activity/type :activity.type/review :activity/scope 17592186050456 :activity/course 17592186046658 :activity/steps ["step-7489fe9f-b6a1-5b05-8890-f8dbae2bb299" "step-86ddb20a-1f36-5b9e-8a19-40c4fef5a0e1" "step-7d8bace2-f443-5b72-a65f-94700f3f5957" "step-4d5600cf-e69e-5c6c-99e5-f393d1738070" "step-618882c4-39c0-5422-a1a5-8424f45a62bc"] :activity/first-step "step-7489fe9f-b6a1-5b05-8890-f8dbae2bb299" :db/ensure [:activity/validate]} {:db/id "step-7489fe9f-b6a1-5b05-8890-f8dbae2bb299" :step/id #uuid "7489fe9f-b6a1-5b05-8890-f8dbae2bb299" :step/content 17592186321020 :step/next "step-86ddb20a-1f36-5b9e-8a19-40c4fef5a0e1" :db/ensure [:step/validate]} {:db/id "step-86ddb20a-1f36-5b9e-8a19-40c4fef5a0e1" :step/id #uuid "86ddb20a-1f36-5b9e-8a19-40c4fef5a0e1" :step/content 17592186125239 :step/next "step-7d8bace2-f443-5b72-a65f-94700f3f5957" :db/ensure [:step/validate]} {:db/id "step-7d8bace2-f443-5b72-a65f-94700f3f5957" :step/id #uuid "7d8bace2-f443-5b72-a65f-94700f3f5957" :step/content "question-c06702a9-7f9f-5ebf-bbd9-2e359cfd7640" :step/next "step-4d5600cf-e69e-5c6c-99e5-f393d1738070" :db/ensure [:step/validate]} {:db/id "step-4d5600cf-e69e-5c6c-99e5-f393d1738070" :step/id #uuid "4d5600cf-e69e-5c6c-99e5-f393d1738070" :step/content 17592186360601 :step/next "step-618882c4-39c0-5422-a1a5-8424f45a62bc" :db/ensure [:step/validate]} {:db/id "step-618882c4-39c0-5422-a1a5-8424f45a62bc" :step/id #uuid "618882c4-39c0-5422-a1a5-8424f45a62bc" :step/content 17592186398624 :db/ensure [:step/validate]} {:db/id 17592186078544 :knowledge-point/questions ["question-5d70384a-18d5-5ae8-aba3-5e0332c40c5f" "question-bfa27842-a6ff-52d4-867b-7142afc0e5fe"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078199 :question/problem "Find the common ratio of the following geometric sequence.\n\n$$\n90, \\: -30, \\: 10, \\: -\\dfrac{10}{3}, \\: \\ldots\n$$" :question/worked-solution "The common ratio $r$ of a geometric sequence is the constant we multiply by to get to the next term. In other words, it is the ratio of consecutive terms.\n\nTherefore, the common ratio for our sequence is\n\n$$\nr = \\dfrac{a_2}{a_1} = \\dfrac{(-30)}{90} = -\\dfrac{1}{3}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186078545 :knowledge-point/questions ["question-feb40554-9f62-5369-873c-1a4212bcc47c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078200 :question/problem "Find the $7$th term of the following geometric sequence.\n\n$$\n1, \\: 2, \\: 4, \\: 8, \\: \\ldots\n$$" :question/worked-solution "![](images/65/653f9ccfe28f5e3630afd30562064f1d790245b227896ea7db2da4265f7bac1a.png)\n\nNotice that the sequence is geometric, with a common ratio of \n\n$$\nr=\\dfrac{2}{1}=2.\n$$\n\nSo, we can get each term by multiplying the previous term by $2.$\n\nContinuing to list terms of the sequence until we get to the $7$th term, we obtain the following:\n\n![](images/6a/6ae31d38f90d943b5bd802652d0dedd4925351b1ffadd6398d018a1dd4c7f0d3.png)\n\nTherefore, the $7$th term is $64.$" :db/ensure [:question/validate]} {:db/id 17592186078546 :knowledge-point/questions ["question-aefd99db-cf1d-5552-bc9d-e8816ab40f33" "question-2e89be9b-05fd-570e-aab3-708af6042f1b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078214 :question/problem "Given that $x$, $3x$, $36$ are the first three terms of a geometric sequence, find $x.$" :question/worked-solution "The first three terms are as follows:\n\n$$\n\\begin{aligned}{a}_{1}=x,\\,{a}_{2}=3x,\\,{a}_{3}=36.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{3x}{x}=3.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{36}{3x}=\\frac{12}{x}.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}3 & =\\frac{12}{x} \\\\ 3x & =12 \\\\ x & =4.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078547 :knowledge-point/questions ["question-5bf4971e-04f4-56ea-b8f7-ec174707b886" "question-011f3c60-0a40-5c48-8e42-7ae45f302869"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078201 :question/problem "Which of the sequences below are geometric sequences?\n\nI. $2, \\: 4, \\: 8, \\: 16, \\: \\ldots$\n\nII. $1, \\: -\\dfrac{1}{3}, \\: \\dfrac{1}{9}, \\: -\\dfrac{1}{27}, \\: \\ldots$\n\nIII. $4, \\: 8, \\: 12, \\: 16, \\: \\ldots$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{4}{2} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{8}{4} & =2 \\\\ \\frac{{a}_{4}}{{a}_{3}}=\\frac{16}{8} & =2\\end{aligned}\n$$\n\n- Sequence II is also geometric. Again, for each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-\\frac{1}{3})}{1} & =-\\frac{1}{3} \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{1}{9})}{(-\\frac{1}{3})} & =-\\frac{1}{3} \\\\ \\frac{{a}_{4}}{{a}_{3}}=\\frac{(-\\frac{1}{27})}{(\\frac{1}{9})} & =-\\frac{1}{3}\\end{aligned}\n$$\n\n- Sequence III is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{8}{4} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{12}{8} & =\\frac{3}{2}\\end{aligned}\n$$\n\nIn conclusion, only sequences I and II could be geometric sequences." :db/ensure [:question/validate]} {:db/id "question-5d70384a-18d5-5ae8-aba3-5e0332c40c5f" :question/id #uuid "5d70384a-18d5-5ae8-aba3-5e0332c40c5f" :question/math-academy-id "q-250656" :question/problem "Consider the following geometric sequence:\n\n$$\n243,\\,-162,\\,108,\\,-72,\\,…\n$$\n\nThe common ratio of this geometric sequence is{{field-1}}." :question/worked-solution "The common ratio $r$ of a geometric sequence is the constant we multiply by to get to the next term. In other words, it is the ratio of consecutive terms.\n\nTherefore, the common ratio for our sequence is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-162)}{243}=-\\frac{2}{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-34a2f5ca-3647-52a4-8e96-552ff18e0cf0"] :db/ensure [:question/validate]} {:db/id "answer-field-34a2f5ca-3647-52a4-8e96-552ff18e0cf0" :answer-field/id #uuid "34a2f5ca-3647-52a4-8e96-552ff18e0cf0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a94638c3-3706-5557-8410-7e36882e8a69" :answer-field/choices ["answer-a94638c3-3706-5557-8410-7e36882e8a69"] :db/ensure [:answer-field/validate]} {:db/id "answer-a94638c3-3706-5557-8410-7e36882e8a69" :answer/id #uuid "a94638c3-3706-5557-8410-7e36882e8a69" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-bfa27842-a6ff-52d4-867b-7142afc0e5fe" :question/id #uuid "bfa27842-a6ff-52d4-867b-7142afc0e5fe" :question/math-academy-id "q-250632" :question/problem "Consider the following geometric sequence:\n\n$$\n25,\\,-5,\\,1,\\,-\\frac{1}{5},\\,…\n$$\n\nThe common ratio of this geometric sequence is{{field-1}}." :question/worked-solution "The common ratio $r$ of a geometric sequence is the constant we multiply by to get to the next term. In other words, it is the ratio of consecutive terms.\n\nTherefore, the common ratio for our sequence is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-5)}{25}=-\\frac{1}{5}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-510f525c-3dca-5fa8-8675-d8d314365702"] :db/ensure [:question/validate]} {:db/id "answer-field-510f525c-3dca-5fa8-8675-d8d314365702" :answer-field/id #uuid "510f525c-3dca-5fa8-8675-d8d314365702" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e9eb9c31-94f2-588f-821e-14ddefff02d3" :answer-field/choices ["answer-e9eb9c31-94f2-588f-821e-14ddefff02d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9eb9c31-94f2-588f-821e-14ddefff02d3" :answer/id #uuid "e9eb9c31-94f2-588f-821e-14ddefff02d3" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id 17592186079077 :question/problem "Find the $5$th term of the following geometric sequence.\n\n$$\n2,\\,-4,\\,8,\\,-16,\\,…\n$$" :question/worked-solution "![](images/7c/7c6697d2a70a7499e6a834f3e588257c88f5da433c7365b9b1777314377e122d.png)\n\nNotice that the sequence is geometric, with a common ratio of \n\n$$\nr=\\frac{(-4)}{2}=-2.\n$$\n\nSo, we can get each term by multiplying the previous term by $-2.$\n\nContinuing to list terms of the sequence until we get to the $5$th term, we obtain the following:\n\n![](images/a5/a5cd75c3e262f76d12da48cd8e86bf04b2532f7e7084d1968ac30bd103373f64.png)\n\nTherefore, the $5$th term is $32.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186077240 :answer-field/correct 17592186077242 :db/ensure [:answer-field/validate]} {:db/id "question-feb40554-9f62-5369-873c-1a4212bcc47c" :question/id #uuid "feb40554-9f62-5369-873c-1a4212bcc47c" :question/math-academy-id "q-250679" :question/problem "Consider the following geometric sequence:\n\n$$\n2,\\,10,\\,50,\\,250,\\,…\n$$\n\nThe sixth term of this sequence is{{field-1}}." :question/worked-solution "![](images/64/64ab493abc4e32afc36676b20cf0e8898c4d0ba07c086280e426890c7bdfb70a.png)\n\nNotice that the sequence is geometric, with a common ratio of \n\n$$\nr=\\frac{10}{2}=5.\n$$\n\nSo, we can get each term by multiplying the previous term by $5.$ \n\nContinuing to list terms of the sequence until we get to the $6$th term, we obtain the following:\n\n![](images/32/32f60b73a942c4e792f3629b5f4824f1c639a25e03491a36f81679d126bcd685.png)\n\nTherefore, the $6$th term is $6250.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a292ed97-b950-5627-8916-577ea6d8682b"] :db/ensure [:question/validate]} {:db/id "answer-field-a292ed97-b950-5627-8916-577ea6d8682b" :answer-field/id #uuid "a292ed97-b950-5627-8916-577ea6d8682b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bca39d98-6ddb-59e1-9d17-5b686f32e444" :answer-field/choices ["answer-bca39d98-6ddb-59e1-9d17-5b686f32e444"] :db/ensure [:answer-field/validate]} {:db/id "answer-bca39d98-6ddb-59e1-9d17-5b686f32e444" :answer/id #uuid "bca39d98-6ddb-59e1-9d17-5b686f32e444" :answer/type :answer.type/math :answer/value "6250" :db/ensure [:answer/validate]} {:db/id "question-aefd99db-cf1d-5552-bc9d-e8816ab40f33" :question/id #uuid "aefd99db-cf1d-5552-bc9d-e8816ab40f33" :question/math-academy-id "q-101241" :question/problem "Given that $50$, $5x$, and $12.5x$ are the first three terms of a geometric sequence, find $x.$" :question/worked-solution "The first three terms are\n\n$$\n\\begin{aligned}{a}_{1}=50,\\,{a}_{2}=5x,\\,{a}_{3}=12.5x.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{5x}{50}=\\frac{x}{10}.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{12.5x}{5x}=2.5.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}2.5 & =\\frac{x}{10} \\\\ 25 & =x \\\\ x & =25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aebff470-79e5-5ba7-b4ee-54414e7698e3"] :db/ensure [:question/validate]} {:db/id "answer-field-aebff470-79e5-5ba7-b4ee-54414e7698e3" :answer-field/id #uuid "aebff470-79e5-5ba7-b4ee-54414e7698e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a778ef61-0261-5eec-98a3-a7479f594baf" :answer-field/choices ["answer-dbe2db88-963e-57e9-9c11-2568e077eafa" "answer-55959341-9939-5fcb-a730-41d470011ccc" "answer-a778ef61-0261-5eec-98a3-a7479f594baf" "answer-e605dc1e-a226-53f6-8081-124213074e79" "answer-c2b6755c-a6b5-59ab-9d2b-90b6f3c5976c"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbe2db88-963e-57e9-9c11-2568e077eafa" :answer/id #uuid "dbe2db88-963e-57e9-9c11-2568e077eafa" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-55959341-9939-5fcb-a730-41d470011ccc" :answer/id #uuid "55959341-9939-5fcb-a730-41d470011ccc" :answer/type :answer.type/math :answer/value "12.5" :db/ensure [:answer/validate]} {:db/id "answer-a778ef61-0261-5eec-98a3-a7479f594baf" :answer/id #uuid "a778ef61-0261-5eec-98a3-a7479f594baf" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-e605dc1e-a226-53f6-8081-124213074e79" :answer/id #uuid "e605dc1e-a226-53f6-8081-124213074e79" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-c2b6755c-a6b5-59ab-9d2b-90b6f3c5976c" :answer/id #uuid "c2b6755c-a6b5-59ab-9d2b-90b6f3c5976c" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "question-2e89be9b-05fd-570e-aab3-708af6042f1b" :question/id #uuid "2e89be9b-05fd-570e-aab3-708af6042f1b" :question/math-academy-id "q-109799" :question/problem "Given that $8$, $6x$, and $10x$ are the first three terms of a geometric sequence, find $x.$" :question/worked-solution "The first three terms are\n\n$$\n\\begin{aligned}{a}_{1}=8,\\,{a}_{2}=6x,\\,{a}_{3}=10x.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{6x}{8}=\\frac{3x}{4}.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{10x}{6x}=\\frac{5}{3}.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}\\frac{3x}{4} & =\\frac{5}{3} \\\\ 3x & =\\frac{20}{3} \\\\ x & =\\frac{20}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5fd92fce-27a7-528b-8997-468fa342ecb8"] :db/ensure [:question/validate]} {:db/id "answer-field-5fd92fce-27a7-528b-8997-468fa342ecb8" :answer-field/id #uuid "5fd92fce-27a7-528b-8997-468fa342ecb8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1582d224-094e-567c-a4d0-6a766eb83c10" :answer-field/choices ["answer-8082c854-a0c3-5658-9917-19fdd468998e" "answer-1582d224-094e-567c-a4d0-6a766eb83c10" "answer-75fba1b8-0f25-52b0-a4e5-d85355af26f1" "answer-e86e41a3-1743-5eae-a35d-1b9bb6aa8392" "answer-3acc9f02-23f0-5267-8e8f-2d43767b5290"] :db/ensure [:answer-field/validate]} {:db/id "answer-8082c854-a0c3-5658-9917-19fdd468998e" :answer/id #uuid "8082c854-a0c3-5658-9917-19fdd468998e" :answer/type :answer.type/math :answer/value "\\frac{1}{20}" :db/ensure [:answer/validate]} {:db/id "answer-1582d224-094e-567c-a4d0-6a766eb83c10" :answer/id #uuid "1582d224-094e-567c-a4d0-6a766eb83c10" :answer/type :answer.type/math :answer/value "\\frac{20}{9}" :db/ensure [:answer/validate]} {:db/id "answer-75fba1b8-0f25-52b0-a4e5-d85355af26f1" :answer/id #uuid "75fba1b8-0f25-52b0-a4e5-d85355af26f1" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-e86e41a3-1743-5eae-a35d-1b9bb6aa8392" :answer/id #uuid "e86e41a3-1743-5eae-a35d-1b9bb6aa8392" :answer/type :answer.type/math :answer/value "\\frac{9}{20}" :db/ensure [:answer/validate]} {:db/id "answer-3acc9f02-23f0-5267-8e8f-2d43767b5290" :answer/id #uuid "3acc9f02-23f0-5267-8e8f-2d43767b5290" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "question-5bf4971e-04f4-56ea-b8f7-ec174707b886" :question/id #uuid "5bf4971e-04f4-56ea-b8f7-ec174707b886" :question/math-academy-id "q-52474" :question/problem "Which of the sequences below are geometric sequences?\n\nI. $-1,\\,-6,\\,-36,\\,…$\n\nII. $1,\\,-4,\\,-16,\\,…$\n\nIII. $2,\\,7,\\,12,\\,…$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-6)}{(-1)}=6 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-36)}{(-6)}=6\\end{aligned}\n$$\n\n- Sequence II is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-4)}{1}=-4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-16)}{(-4)}=4\\end{aligned}\n$$\n\n- Sequence III is also not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{7}{2} \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{12}{7}\\end{aligned}\n$$\n\nIn conclusion, only sequence I could be a geometric sequence." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1cd1d0cb-5c67-54b2-9a8e-55d3e3199e6f"] :db/ensure [:question/validate]} {:db/id "answer-field-1cd1d0cb-5c67-54b2-9a8e-55d3e3199e6f" :answer-field/id #uuid "1cd1d0cb-5c67-54b2-9a8e-55d3e3199e6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5134393-8754-56f1-8c80-963cf9ae8285" :answer-field/choices ["answer-d89c9e75-1551-5bde-9f68-e97033024c24" "answer-b5134393-8754-56f1-8c80-963cf9ae8285" "answer-42dcbbf9-138e-544e-83b5-ce1af281813a" "answer-c8637f9e-b6c7-563c-8fbb-5358af318a7a" "answer-e7ee9576-7d5a-5cf5-bd8b-7b448a345983"] :db/ensure [:answer-field/validate]} {:db/id "answer-d89c9e75-1551-5bde-9f68-e97033024c24" :answer/id #uuid "d89c9e75-1551-5bde-9f68-e97033024c24" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-b5134393-8754-56f1-8c80-963cf9ae8285" :answer/id #uuid "b5134393-8754-56f1-8c80-963cf9ae8285" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-42dcbbf9-138e-544e-83b5-ce1af281813a" :answer/id #uuid "42dcbbf9-138e-544e-83b5-ce1af281813a" :answer/type :answer.type/text :answer/value "II and III" :db/ensure [:answer/validate]} {:db/id "answer-c8637f9e-b6c7-563c-8fbb-5358af318a7a" :answer/id #uuid "c8637f9e-b6c7-563c-8fbb-5358af318a7a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-e7ee9576-7d5a-5cf5-bd8b-7b448a345983" :answer/id #uuid "e7ee9576-7d5a-5cf5-bd8b-7b448a345983" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-011f3c60-0a40-5c48-8e42-7ae45f302869" :question/id #uuid "011f3c60-0a40-5c48-8e42-7ae45f302869" :question/math-academy-id "q-79509" :question/problem "Which of the sequences below are geometric sequences?\n\nI. $120,\\,80,\\,30,\\,…$\n\nII. $-243,\\,27,\\,-3,\\,…$\n\nIII. $225,\\,45,\\,9,\\,…$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{80}{120}=\\frac{2}{3} \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{30}{80}=\\frac{3}{8}\\end{aligned}\n$$\n\n- Sequence II is geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{27}{(-243)}=-\\frac{1}{9} \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-3)}{27}=-\\frac{1}{9}\\end{aligned}\n$$\n\n- Sequence III is also geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{45}{225}=\\frac{1}{5} \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{9}{45}=\\frac{1}{5}\\end{aligned}\n$$\n\nIn conclusion, only sequences II and III could be geometric sequences." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2cef64b1-c161-50e4-82e1-fafe2dafb2db"] :db/ensure [:question/validate]} {:db/id "answer-field-2cef64b1-c161-50e4-82e1-fafe2dafb2db" :answer-field/id #uuid "2cef64b1-c161-50e4-82e1-fafe2dafb2db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4119ef5a-ce8f-557a-86d3-930060c2d7af" :answer-field/choices ["answer-466b273e-c846-58e4-b675-7fc925b9a67b" "answer-dd63c68f-2391-56cd-bd26-5b2e6bf05ebe" "answer-4119ef5a-ce8f-557a-86d3-930060c2d7af" "answer-d499038b-1ca3-508e-ade3-a293c9a995d0" "answer-d2daa668-266e-57f8-9b6d-9aba42612c84"] :db/ensure [:answer-field/validate]} {:db/id "answer-466b273e-c846-58e4-b675-7fc925b9a67b" :answer/id #uuid "466b273e-c846-58e4-b675-7fc925b9a67b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-dd63c68f-2391-56cd-bd26-5b2e6bf05ebe" :answer/id #uuid "dd63c68f-2391-56cd-bd26-5b2e6bf05ebe" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4119ef5a-ce8f-557a-86d3-930060c2d7af" :answer/id #uuid "4119ef5a-ce8f-557a-86d3-930060c2d7af" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-d499038b-1ca3-508e-ade3-a293c9a995d0" :answer/id #uuid "d499038b-1ca3-508e-ade3-a293c9a995d0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-d2daa668-266e-57f8-9b6d-9aba42612c84" :answer/id #uuid "d2daa668-266e-57f8-9b6d-9aba42612c84" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186079625 :tutorial/content "Consider the following sequence:\n\n$$\n1,\\quad\\:\\: 3,\\quad\\:\\: 9,\\quad\\:\\: 27,\\quad\\:\\: 81,\\quad\\:\\: \\ldots\n$$\n\nNotice that each term is ${\\color{blue}3}$ times the previous term:\n\n![](images/9a/9a3af8dd763aa0ab6b176a3a9d711ead4d029e2cebef823f906403be5fc38786.png)\n\nA sequence like the one above, where each term is found by multiplying the previous term by a fixed constant, is called a **geometric sequence**. \n\nThis fixed constant is called the **common ratio**, and is denoted by $r.$ In this particular case, the common ratio is $r={\\color{blue}3}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186078694 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186166765 :knowledge-point/questions ["question-8198f6db-6c5f-5983-9cb0-0bd0190f9596" "question-2bf70c41-d3e4-5066-92f9-b0265e8edce1" "question-84e76c93-4252-53d8-b14a-d598aa6e8e08" "question-da5d7294-c739-5f77-ae4a-e6ad7eaa5e42" "question-d8788c2a-c953-5587-a4b0-071fdea7bf08"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166766 :knowledge-point/questions ["question-56abd260-e88d-5e15-85ad-d09d0617c5fa" "question-e713a272-c241-525b-b381-4fe5ba553286" "question-83895ad6-7f6a-50d5-a3b6-af8475bcabcc" "question-56f1a503-7979-5afa-a86c-36de0338e547"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8198f6db-6c5f-5983-9cb0-0bd0190f9596" :question/id #uuid "8198f6db-6c5f-5983-9cb0-0bd0190f9596" :question/math-academy-id "q-341473" :question/problem "$$\n\nIf $y=\\operatorname{arcsch}⁡({x}^{2}+4)-\\operatorname{ln}⁡({x}^{2}+4),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-\\frac{2x}{{x}^{2}+4}$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,[\\operatorname{arcsch}⁡({x}^{2}+4)-\\operatorname{ln}⁡({x}^{2}+4)] \\\\  & =-\\frac{1}{|{x}^{2}+4|\\sqrt{1+{({x}^{2}+4)}^{2}}}\\cdot {({x}^{2}+4)}^{′}-\\frac{{({x}^{2}+4)}^{′}}{{x}^{2}+4} \\\\  & =-\\frac{1}{({x}^{2}+4)\\sqrt{1+({x}^{4}+8{x}^{2}+16)}}\\cdot 2x-\\frac{2x}{{x}^{2}+4} \\\\  & =-\\frac{2x}{({x}^{2}+4)\\sqrt{{x}^{4}+8{x}^{2}+17}}-\\frac{2x}{{x}^{2}+4} \\\\  & =-\\frac{2x}{{x}^{2}+4}(\\frac{1}{\\sqrt{{x}^{4}+8{x}^{2}+17}}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-520cf314-e244-5017-a78d-80675136c535"] :db/ensure [:question/validate]} {:db/id "answer-field-520cf314-e244-5017-a78d-80675136c535" :answer-field/id #uuid "520cf314-e244-5017-a78d-80675136c535" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a0cd6cc1-2306-5ff5-bd40-675798a9d210" :answer-field/choices ["answer-a0cd6cc1-2306-5ff5-bd40-675798a9d210"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0cd6cc1-2306-5ff5-bd40-675798a9d210" :answer/id #uuid "a0cd6cc1-2306-5ff5-bd40-675798a9d210" :answer/type :answer.type/math :answer/value "(\\frac{1}{\\sqrt{{x}^{4}+8{x}^{2}+17}}+1)" :db/ensure [:answer/validate]} {:db/id "question-2bf70c41-d3e4-5066-92f9-b0265e8edce1" :question/id #uuid "2bf70c41-d3e4-5066-92f9-b0265e8edce1" :question/math-academy-id "q-95516" :question/problem "$$\n\nIf $y=\\operatorname{arcsch}⁡(-2x),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡(-2x)) \\\\  & =-\\frac{1}{|-2x|\\sqrt{1+(-2x)^{2}}}\\cdot (-2x)^{′} \\\\  & =-\\frac{1}{2|x|\\sqrt{1+4{x}^{2}}}\\cdot (-2) \\\\  & =\\frac{1}{|x|\\sqrt{1+4{x}^{2}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d0511943-6c7e-505f-bb50-f3028bf5ed85"] :db/ensure [:question/validate]} {:db/id "answer-field-d0511943-6c7e-505f-b