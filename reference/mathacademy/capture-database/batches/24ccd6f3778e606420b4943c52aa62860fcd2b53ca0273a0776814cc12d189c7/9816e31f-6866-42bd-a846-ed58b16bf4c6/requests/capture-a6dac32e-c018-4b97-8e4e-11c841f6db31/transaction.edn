$\n\\operatorname{log}⁡({10}^{1/5})=\\frac{1}{5}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ca4d7a52-ef14-5dda-b65b-bcf28ca1ff04"] :db/ensure [:question/validate]} {:db/id "answer-field-ca4d7a52-ef14-5dda-b65b-bcf28ca1ff04" :answer-field/id #uuid "ca4d7a52-ef14-5dda-b65b-bcf28ca1ff04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2a9d371-3a76-5637-9906-45dd3663f5fe" :answer-field/choices ["answer-c4100065-f970-51df-abe3-2d4743cff339" "answer-8126d526-06d8-51a6-b4ed-2154d37274ff" "answer-224d1381-d686-5630-b698-51e4184ce621" "answer-5fe9c910-5c4a-5b61-b6ca-b8292de50985" "answer-b2a9d371-3a76-5637-9906-45dd3663f5fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4100065-f970-51df-abe3-2d4743cff339" :answer/id #uuid "c4100065-f970-51df-abe3-2d4743cff339" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-8126d526-06d8-51a6-b4ed-2154d37274ff" :answer/id #uuid "8126d526-06d8-51a6-b4ed-2154d37274ff" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-224d1381-d686-5630-b698-51e4184ce621" :answer/id #uuid "224d1381-d686-5630-b698-51e4184ce621" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-5fe9c910-5c4a-5b61-b6ca-b8292de50985" :answer/id #uuid "5fe9c910-5c4a-5b61-b6ca-b8292de50985" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b2a9d371-3a76-5637-9906-45dd3663f5fe" :answer/id #uuid "b2a9d371-3a76-5637-9906-45dd3663f5fe" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "question-f698077a-723c-5eb7-8769-9b9cd991b10a" :question/id #uuid "f698077a-723c-5eb7-8769-9b9cd991b10a" :question/math-academy-id "q-66628" :question/problem "$\\operatorname{log}⁡(0.01)=$" :question/worked-solution "First, we rewrite $0.01$ as a power of $10$ (the base of the common logarithm) as follows:\n\n$$\n0.01={10}^{-2}\n$$\n\nTherefore, we have:\n\n$$\n\\operatorname{log}⁡(0.01)=\\operatorname{log}⁡({10}^{-2})\n$$\n\nThe common logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{log}⁡({10}^{x})=x\n$$\n\nIn our case, we have $x=-2.$ Therefore:\n\n$$\n\\operatorname{log}⁡({10}^{-2})=-2\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eb5c14ac-5329-5c13-b0e7-0bc5f4c03d4d"] :db/ensure [:question/validate]} {:db/id "answer-field-eb5c14ac-5329-5c13-b0e7-0bc5f4c03d4d" :answer-field/id #uuid "eb5c14ac-5329-5c13-b0e7-0bc5f4c03d4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1680aa84-06ac-5c02-87f2-0d18f50b616a" :answer-field/choices ["answer-1680aa84-06ac-5c02-87f2-0d18f50b616a" "answer-0ce058e3-52b3-583b-a851-b6062cd9d3ea" "answer-b2acd289-dcc6-5cec-9811-76edd35a02ef" "answer-d1db9dba-08d0-5e9e-9cb3-d347e5a711e4" "answer-5480002b-e285-507d-90f5-deb11809b3ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-1680aa84-06ac-5c02-87f2-0d18f50b616a" :answer/id #uuid "1680aa84-06ac-5c02-87f2-0d18f50b616a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-0ce058e3-52b3-583b-a851-b6062cd9d3ea" :answer/id #uuid "0ce058e3-52b3-583b-a851-b6062cd9d3ea" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-b2acd289-dcc6-5cec-9811-76edd35a02ef" :answer/id #uuid "b2acd289-dcc6-5cec-9811-76edd35a02ef" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d1db9dba-08d0-5e9e-9cb3-d347e5a711e4" :answer/id #uuid "d1db9dba-08d0-5e9e-9cb3-d347e5a711e4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-5480002b-e285-507d-90f5-deb11809b3ac" :answer/id #uuid "5480002b-e285-507d-90f5-deb11809b3ac" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-5a64a8e4-76a1-5b39-9c41-0b568b095115" :question/id #uuid "5a64a8e4-76a1-5b39-9c41-0b568b095115" :question/math-academy-id "q-99890" :question/problem "Rounded to $3$ decimal places, $\\frac{\\operatorname{log}⁡(8)}{3\\operatorname{log}⁡(11)}=$" :question/worked-solution "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{log}⁡(8)}{3\\operatorname{log}⁡(11)} & ≈\\frac{0.903\\,090}{3(1.041\\,393)} \\\\  & =\\frac{0.903\\,090}{3.124\\,179} \\\\  & ≈0.289\\,065 \\\\  & ≈0.289\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d53df081-5098-54e4-9ae1-62c7e1d21714"] :db/ensure [:question/validate]} {:db/id "answer-field-d53df081-5098-54e4-9ae1-62c7e1d21714" :answer-field/id #uuid "d53df081-5098-54e4-9ae1-62c7e1d21714" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-adebb719-c4b1-5c7f-93ff-0753b8468307" :answer-field/choices ["answer-c9ef1288-9185-54f8-a494-ce9ff1450ae7" "answer-e491dfee-0a87-5bf1-b4bd-3a44c6127c1a" "answer-adebb719-c4b1-5c7f-93ff-0753b8468307" "answer-dfd49abf-6780-5dcd-92e9-42ff9d78d77d" "answer-06947b56-6c63-577a-9939-3751fd944d34"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9ef1288-9185-54f8-a494-ce9ff1450ae7" :answer/id #uuid "c9ef1288-9185-54f8-a494-ce9ff1450ae7" :answer/type :answer.type/math :answer/value "0.211" :db/ensure [:answer/validate]} {:db/id "answer-e491dfee-0a87-5bf1-b4bd-3a44c6127c1a" :answer/id #uuid "e491dfee-0a87-5bf1-b4bd-3a44c6127c1a" :answer/type :answer.type/math :answer/value "0.223" :db/ensure [:answer/validate]} {:db/id "answer-adebb719-c4b1-5c7f-93ff-0753b8468307" :answer/id #uuid "adebb719-c4b1-5c7f-93ff-0753b8468307" :answer/type :answer.type/math :answer/value "0.289" :db/ensure [:answer/validate]} {:db/id "answer-dfd49abf-6780-5dcd-92e9-42ff9d78d77d" :answer/id #uuid "dfd49abf-6780-5dcd-92e9-42ff9d78d77d" :answer/type :answer.type/math :answer/value "0.296" :db/ensure [:answer/validate]} {:db/id "answer-06947b56-6c63-577a-9939-3751fd944d34" :answer/id #uuid "06947b56-6c63-577a-9939-3751fd944d34" :answer/type :answer.type/math :answer/value "0.308" :db/ensure [:answer/validate]} {:db/id "question-0714c123-409e-586b-bfd3-01ab5d4541d7" :question/id #uuid "0714c123-409e-586b-bfd3-01ab5d4541d7" :question/math-academy-id "q-78745" :question/problem "Rounded to $3$ decimal places, find the value of $f(x)=3\\operatorname{log}⁡(2x)-2\\operatorname{log}⁡(5x)$ at $x=3.$" :question/worked-solution "First, we replace $x=3$ and get:\n\n$$\n\\begin{aligned}f(3) & =3\\operatorname{log}⁡(2\\cdot 3)-2\\operatorname{log}⁡(5\\cdot 3) \\\\  & =3\\operatorname{log}⁡(6)-2\\operatorname{log}⁡(15)\\end{aligned}\n$$\n\nWe compute the required value to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}f(3) & =3\\operatorname{log}⁡(6)-2\\operatorname{log}⁡(15) \\\\  & ≈3(0.778\\,151)-2(1.176\\,091) \\\\  & =2.334\\,453-2.352\\,182 \\\\  & =-0.017\\,729 \\\\  & ≈-0.018\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-08659010-ed5d-5324-bfa0-6bd93f1094a1"] :db/ensure [:question/validate]} {:db/id "answer-field-08659010-ed5d-5324-bfa0-6bd93f1094a1" :answer-field/id #uuid "08659010-ed5d-5324-bfa0-6bd93f1094a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e3f3f233-eea1-5a76-9baf-466f825d91e3" :answer-field/choices ["answer-56228795-7d2f-53bb-bf44-1e1c61aeaaa4" "answer-e3f3f233-eea1-5a76-9baf-466f825d91e3" "answer-d4481b14-72e5-5219-9cd6-a49808fa8636" "answer-85e682e6-14f1-5c54-90be-cb8eb7b16c04" "answer-555bf3e6-16d1-5155-b677-d1d614176b74"] :db/ensure [:answer-field/validate]} {:db/id "answer-56228795-7d2f-53bb-bf44-1e1c61aeaaa4" :answer/id #uuid "56228795-7d2f-53bb-bf44-1e1c61aeaaa4" :answer/type :answer.type/math :answer/value "-0.014" :db/ensure [:answer/validate]} {:db/id "answer-e3f3f233-eea1-5a76-9baf-466f825d91e3" :answer/id #uuid "e3f3f233-eea1-5a76-9baf-466f825d91e3" :answer/type :answer.type/math :answer/value "-0.018" :db/ensure [:answer/validate]} {:db/id "answer-d4481b14-72e5-5219-9cd6-a49808fa8636" :answer/id #uuid "d4481b14-72e5-5219-9cd6-a49808fa8636" :answer/type :answer.type/math :answer/value "-0.160" :db/ensure [:answer/validate]} {:db/id "answer-85e682e6-14f1-5c54-90be-cb8eb7b16c04" :answer/id #uuid "85e682e6-14f1-5c54-90be-cb8eb7b16c04" :answer/type :answer.type/math :answer/value "-0.401" :db/ensure [:answer/validate]} {:db/id "answer-555bf3e6-16d1-5155-b677-d1d614176b74" :answer/id #uuid "555bf3e6-16d1-5155-b677-d1d614176b74" :answer/type :answer.type/math :answer/value "-1.004" :db/ensure [:answer/validate]} {:db/id 17592186084436 :tutorial/content "Suppose we are given the logarithm $\\log (100).$ If no base is specified, then by default the base is equal to $10.$\n\nIn our example, we have\n\n$$\n\\log(100)=\\log_{10}(100)=\\log_{10}(10^2) = 2.\n$$\n\nIn general, the logarithm with base $10$ is called the **common logarithm**, and is defined as follows:\n\n$a = 10^x$ is equivalent to $\\log{a} = x$\n\nEverything we did with logarithms, we can do with the common logarithm. For example, we can\n\n- convert between exponential and logarithm form,\n\n- evaluate common logarithm expressions, and\n\n- calculate specific values of $\\log a$ using a calculator.\n\nFinally, note that most calculators have a button for the common logarithm. This is usually denoted $\\log_{10}$ or simply $\\log.$" :db/ensure [:tutorial/validate]} {:db/id 17592186083421 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186092290 :knowledge-point/questions ["question-e77b2e22-83c2-5884-b6a1-4a4bd43f7297" "question-da7e5a10-376b-5a22-a310-bd1bf7fa24cf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e77b2e22-83c2-5884-b6a1-4a4bd43f7297" :question/id #uuid "e77b2e22-83c2-5884-b6a1-4a4bd43f7297" :question/math-academy-id "q-125854" :question/problem "$$\n\nGiven that $y\\ge 1,$ which of the following is equivalent to $\\operatorname{arcosh}⁡\\sqrt{y}?$" :question/worked-solution "The definition of $\\operatorname{arcosh}⁡x$ is \n\n$$\n\\operatorname{arcosh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\sqrt{y} & =\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{{(\\sqrt{y})}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y-1}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-70bd243f-e07d-55ba-afe6-e9424079d1a3"] :db/ensure [:question/validate]} {:db/id "answer-field-70bd243f-e07d-55ba-afe6-e9424079d1a3" :answer-field/id #uuid "70bd243f-e07d-55ba-afe6-e9424079d1a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-456e44ed-b28e-597a-8a94-9a42b91da0d1" :answer-field/choices ["answer-4e657d76-cffa-595b-9bca-194435c0c985" "answer-8086c909-031a-5d75-b37d-adde7d12e254" "answer-456e44ed-b28e-597a-8a94-9a42b91da0d1" "answer-786a2bb6-f534-5ec7-b7ad-24c1e39a3327" "answer-f593fa3e-303f-519f-8158-523c93d1ab3e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e657d76-cffa-595b-9bca-194435c0c985" :answer/id #uuid "4e657d76-cffa-595b-9bca-194435c0c985" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\sqrt{y+1}-\\sqrt{y})" :db/ensure [:answer/validate]} {:db/id "answer-8086c909-031a-5d75-b37d-adde7d12e254" :answer/id #uuid "8086c909-031a-5d75-b37d-adde7d12e254" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y+1})" :db/ensure [:answer/validate]} {:db/id "answer-456e44ed-b28e-597a-8a94-9a42b91da0d1" :answer/id #uuid "456e44ed-b28e-597a-8a94-9a42b91da0d1" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y-1})" :db/ensure [:answer/validate]} {:db/id "answer-786a2bb6-f534-5ec7-b7ad-24c1e39a3327" :answer/id #uuid "786a2bb6-f534-5ec7-b7ad-24c1e39a3327" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\sqrt{y}-\\sqrt{y-1})" :db/ensure [:answer/validate]} {:db/id "answer-f593fa3e-303f-519f-8158-523c93d1ab3e" :answer/id #uuid "f593fa3e-303f-519f-8158-523c93d1ab3e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(y-\\sqrt{y-1})" :db/ensure [:answer/validate]} {:db/id 17592186092291 :knowledge-point/questions ["question-8ddac48b-cef1-5d70-9862-741511be4eb3" "question-9750db93-431a-52f4-a35e-36e894133bed"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8ddac48b-cef1-5d70-9862-741511be4eb3" :question/id #uuid "8ddac48b-cef1-5d70-9862-741511be4eb3" :question/math-academy-id "q-125855" :question/problem "$$\n\n$\\operatorname{artanh}⁡(-\\frac{15}{17})=$" :question/worked-solution "The definition of $\\operatorname{artanh}⁡x$ is \n\n$$\n\\operatorname{artanh}⁡x=\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+x}{1-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{artanh}⁡(-\\frac{15}{17}) & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+(-\\frac{15}{17})}{1-(-\\frac{15}{17})}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1-\\frac{15}{17}}{1+\\frac{15}{17}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{2}{15}}{\\frac{32}{15}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{16}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡{2}^{-4} \\\\  & =-2\\operatorname{ln}⁡2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6245f27-68e2-534e-b326-9a13a0b95dff"] :db/ensure [:question/validate]} {:db/id "answer-field-c6245f27-68e2-534e-b326-9a13a0b95dff" :answer-field/id #uuid "c6245f27-68e2-534e-b326-9a13a0b95dff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-294f333b-a9d4-562a-8eae-492cfcc89909" :answer-field/choices ["answer-294f333b-a9d4-562a-8eae-492cfcc89909" "answer-66bb441d-dd19-59af-b152-79149e4a3104" "answer-536f3405-9be4-55d8-a59a-c53890d35b59" "answer-c82d5f0d-b3be-5af8-87e6-5da9ad05a797" "answer-2645204e-4a2f-5bad-beb3-763d90807c2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-294f333b-a9d4-562a-8eae-492cfcc89909" :answer/id #uuid "294f333b-a9d4-562a-8eae-492cfcc89909" :answer/type :answer.type/math :answer/value "-2\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-66bb441d-dd19-59af-b152-79149e4a3104" :answer/id #uuid "66bb441d-dd19-59af-b152-79149e4a3104" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-536f3405-9be4-55d8-a59a-c53890d35b59" :answer/id #uuid "536f3405-9be4-55d8-a59a-c53890d35b59" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-c82d5f0d-b3be-5af8-87e6-5da9ad05a797" :answer/id #uuid "c82d5f0d-b3be-5af8-87e6-5da9ad05a797" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-2645204e-4a2f-5bad-beb3-763d90807c2a" :answer/id #uuid "2645204e-4a2f-5bad-beb3-763d90807c2a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "question-9750db93-431a-52f4-a35e-36e894133bed" :question/id #uuid "9750db93-431a-52f4-a35e-36e894133bed" :question/math-academy-id "q-125859" :question/problem "$$\n\nGiven that $t>-\\frac{1}{2},$ which of the following is equivalent to $\\operatorname{artanh}⁡(\\frac{t}{t+1})?$" :question/worked-solution "The definition of $\\operatorname{artanh}⁡x$ is \n\n$$\n\\operatorname{artanh}⁡x=\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+x}{1-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{artanh}⁡(\\frac{t}{t+1}) & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+\\frac{t}{t+1}}{1-\\frac{t}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{t+1+t}{t+1}}{\\frac{t+1-t}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{2t+1}{t+1}}{\\frac{1}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(2t+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-08605099-e0ee-5781-8ffd-d1bea3536f65"] :db/ensure [:question/validate]} {:db/id "answer-field-08605099-e0ee-5781-8ffd-d1bea3536f65" :answer-field/id #uuid "08605099-e0ee-5781-8ffd-d1bea3536f65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72957adc-bbda-5a70-8bcf-de083ff0510a" :answer-field/choices ["answer-72957adc-bbda-5a70-8bcf-de083ff0510a" "answer-5f33329f-ed6e-55fc-8a52-3418bf264493" "answer-4ac055dd-9f86-515e-b1ae-23330cb8d42f" "answer-728d87fa-4ae9-5abf-a254-4e2127b85d13" "answer-2cca56e0-bd46-5cdc-92e5-fbf4d373740e"] :db/ensure [:answer-field/validate]} {:db/id "answer-72957adc-bbda-5a70-8bcf-de083ff0510a" :answer/id #uuid "72957adc-bbda-5a70-8bcf-de083ff0510a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2t+1)" :db/ensure [:answer/validate]} {:db/id "answer-5f33329f-ed6e-55fc-8a52-3418bf264493" :answer/id #uuid "5f33329f-ed6e-55fc-8a52-3418bf264493" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(t+\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-4ac055dd-9f86-515e-b1ae-23330cb8d42f" :answer/id #uuid "4ac055dd-9f86-515e-b1ae-23330cb8d42f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2t+1)" :db/ensure [:answer/validate]} {:db/id "answer-728d87fa-4ae9-5abf-a254-4e2127b85d13" :answer/id #uuid "728d87fa-4ae9-5abf-a254-4e2127b85d13" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2t+2)" :db/ensure [:answer/validate]} {:db/id "answer-2cca56e0-bd46-5cdc-92e5-fbf4d373740e" :answer/id #uuid "2cca56e0-bd46-5cdc-92e5-fbf4d373740e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(t+\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id 17592186092293 :knowledge-point/questions ["question-7e900458-4a34-53b2-8b6d-fd38c3b57268"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7e900458-4a34-53b2-8b6d-fd38c3b57268" :question/id #uuid "7e900458-4a34-53b2-8b6d-fd38c3b57268" :question/math-academy-id "q-125986" :question/problem "Using the definition of the hyperbolic cosine, calculate ${f}^{-1}(x)$ given that $f(x)=\\operatorname{cosh}⁡(x+1)$ and $x\\ge -1.$" :question/worked-solution "Let $y=\\operatorname{cosh}⁡(x+1).$ Since $x\\ge -1,$ we have $y\\ge 1.$\n\nTo find the inverse function we swap $x$ and $y:$ \n\n$$\nx=\\operatorname{cosh}⁡(y+1),\n$$\n\nwhere $x\\ge 1$ and $y\\ge -1.$\n\nNext, we apply the definition of $\\operatorname{cosh}⁡x:$\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}({e}^{y+1}+{e}^{-(y+1)}) \\\\ 2x & ={e}^{y+1}+{e}^{-(y+1)} \\\\ 2x{e}^{y+1} & ={e}^{2(y+1)}+1\\end{aligned}\n$$\n\nBringing everything to the left-hand side, we get\n\n$$\n\\begin{aligned}{e}^{2(y+1)}-2x{e}^{y+1}+1 & =0 \\\\ {({e}^{y+1})}^{2}-2x({e}^{y+1})+1 & =0.\\end{aligned}\n$$\n\nLet $Y={e}^{y+1}.$ We can form a quadratic equation in $Y$ and solve it by completing the square, as follows:\n\n$$\n\\begin{aligned}{Y}^{2}-2xY+1 & =0 \\\\ (Y-x)^{2}-{x}^{2}+1 & =0 \\\\ (Y-x)^{2} & ={x}^{2}-1 \\\\ Y-x & =\\pm \\sqrt{{x}^{2}-1} \\\\ Y & =x\\pm \\sqrt{{x}^{2}-1} \\\\ {e}^{y+1} & =x\\pm \\sqrt{{x}^{2}-1} \\\\ y+1 & =\\operatorname{ln}⁡(x\\pm \\sqrt{{x}^{2}-1})\\end{aligned}\n$$\n\nNote that for  $x\\ge 1,$ we have $x-\\sqrt{{x}^{2}-1}\\le 1$ and  $x+\\sqrt{{x}^{2}-1}\\ge 1.$ Since $y+1\\ge 0,$ the logarithm in the above equality must be non-negative. This requires its argument to be greater than or equal to $1$ for $x\\ge 1$, so we reject the alternative with the negative sign. This gives\n\n$$\n\\begin{aligned}y+1 & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}) \\\\ y & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{-1}(x)=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2a874508-e5a5-5caf-a21a-b4d69dce3efa"] :db/ensure [:question/validate]} {:db/id "answer-field-2a874508-e5a5-5caf-a21a-b4d69dce3efa" :answer-field/id #uuid "2a874508-e5a5-5caf-a21a-b4d69dce3efa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5683b63e-518f-5920-9350-c68914ed0bc4" :answer-field/choices ["answer-6c6a5d1c-174d-5af0-a15b-bcbed198a09b" "answer-46b674e3-477c-5d6b-8938-c0aa7e7328b4" "answer-5683b63e-518f-5920-9350-c68914ed0bc4" "answer-f79ae12a-4fbf-5066-b81a-c94e70a59044" "answer-1d9f22e8-2426-54ec-8e4d-ceebb5065f00"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c6a5d1c-174d-5af0-a15b-bcbed198a09b" :answer/id #uuid "6c6a5d1c-174d-5af0-a15b-bcbed198a09b" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})" :db/ensure [:answer/validate]} {:db/id "answer-46b674e3-477c-5d6b-8938-c0aa7e7328b4" :answer/id #uuid "46b674e3-477c-5d6b-8938-c0aa7e7328b4" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})+1" :db/ensure [:answer/validate]} {:db/id "answer-5683b63e-518f-5920-9350-c68914ed0bc4" :answer/id #uuid "5683b63e-518f-5920-9350-c68914ed0bc4" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1" :db/ensure [:answer/validate]} {:db/id "answer-f79ae12a-4fbf-5066-b81a-c94e70a59044" :answer/id #uuid "f79ae12a-4fbf-5066-b81a-c94e70a59044" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x-1+\\sqrt{{x}^{2}-1})" :db/ensure [:answer/validate]} {:db/id "answer-1d9f22e8-2426-54ec-8e4d-ceebb5065f00" :answer/id #uuid "1d9f22e8-2426-54ec-8e4d-ceebb5065f00" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x-1-\\sqrt{{x}^{2}-1})" :db/ensure [:answer/validate]} {:db/id "question-da7e5a10-376b-5a22-a310-bd1bf7fa24cf" :question/id #uuid "da7e5a10-376b-5a22-a310-bd1bf7fa24cf" :question/math-academy-id "q-300604" :question/problem "$$\n\nEvaluate $\\operatorname{arcosh}⁡3.$ **Do not round** your answer.\n\n$\\operatorname{arcosh}⁡3=$\n{{field-1}}" :question/worked-solution "By definition,\n\n$$\n\\operatorname{arcosh}⁡x=ln\\,(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡3 & =\\operatorname{ln}⁡(3+\\sqrt{{3}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(3+\\sqrt{9-1}) \\\\  & =\\operatorname{ln}⁡(3+\\sqrt{8}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f7cb44d4-8640-5f83-ba9b-96604fc838db"] :db/ensure [:question/validate]} {:db/id "answer-field-f7cb44d4-8640-5f83-ba9b-96604fc838db" :answer-field/id #uuid "f7cb44d4-8640-5f83-ba9b-96604fc838db" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4fbe8f32-b269-5817-8957-1ff911e57228" :answer-field/choices ["answer-4fbe8f32-b269-5817-8957-1ff911e57228"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fbe8f32-b269-5817-8957-1ff911e57228" :answer/id #uuid "4fbe8f32-b269-5817-8957-1ff911e57228" :answer/type :answer.type/math :answer/value "\\ln(3+2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "activity-5326f489-c4a2-5092-8c77-6ec4ee9bd4a1" :activity/id #uuid "5326f489-c4a2-5092-8c77-6ec4ee9bd4a1" :activity/title "The Inverse Hyperbolic Functions" :activity/type :activity.type/review :activity/scope 17592186050797 :activity/course 17592186046644 :activity/steps ["step-ca8b15bf-37da-5a6c-b30c-f92d0c220666" "step-a8b3c09c-22c0-55de-a5ad-4942d464fdf0" "step-75b8f4f6-638e-52c0-9e51-b84790620338" "step-5ead7583-af5a-50aa-b7c8-b27d60003f5d" "step-796ec98d-fdc6-5152-8f17-0c07206d2a8e"] :activity/first-step "step-ca8b15bf-37da-5a6c-b30c-f92d0c220666" :db/ensure [:activity/validate]} {:db/id "step-ca8b15bf-