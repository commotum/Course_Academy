n/id #uuid "227b11b3-a4e0-591c-bdef-0816b0978926" :question/math-academy-id "q-110278" :question/problem "![](images/5f/5f93b8d3dd3c88d70d6fe0e5a73bd6da1aeb4eae4811d7aaeb47d5ea620279a5.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=4f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "To graph the function $y=4f(x),$ we take the graph of $y=f(x)$ and stretch it by factor of $4$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $4.$\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/a4/a4b0c34ba1ed9036d8f42693e1c087f10df75e7fe27b1ad23d8885467de1cfab.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2b9aa712-5827-52b7-b935-1fbfbcd2238d"] :db/ensure [:question/validate]} {:db/id "answer-field-2b9aa712-5827-52b7-b935-1fbfbcd2238d" :answer-field/id #uuid "2b9aa712-5827-52b7-b935-1fbfbcd2238d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a988b3cb-1999-5eaa-a1f9-16c390668331" :answer-field/choices ["answer-00489729-6e18-5433-800f-f7406a4ba1bc" "answer-a988b3cb-1999-5eaa-a1f9-16c390668331" "answer-8789f6be-f803-526e-a6f6-58f4331ce2b1" "answer-1742f568-01fa-5c3a-8d9b-f9ccb1b3b33a" "answer-40d252ad-11ed-5159-9b39-0cfd9afec10c"] :db/ensure [:answer-field/validate]} {:db/id "answer-00489729-6e18-5433-800f-f7406a4ba1bc" :answer/id #uuid "00489729-6e18-5433-800f-f7406a4ba1bc" :answer/type :answer.type/image :answer/value "images/0e/0e320f1c1e873ef199547a2b52ccbb63d2e72e8472da1a202f10a7d5a4f1db04.png" :db/ensure [:answer/validate]} {:db/id "answer-a988b3cb-1999-5eaa-a1f9-16c390668331" :answer/id #uuid "a988b3cb-1999-5eaa-a1f9-16c390668331" :answer/type :answer.type/image :answer/value "images/25/2552a0e5c14bb480ab9c36c60a83c3dd6ddfdba4dc90564d0bbe4f7417946ae6.png" :db/ensure [:answer/validate]} {:db/id "answer-8789f6be-f803-526e-a6f6-58f4