6d0c2736c2dd" :answer/id #uuid "f7380bf9-1768-5c54-9eba-6d0c2736c2dd" :answer/type :answer.type/math :answer/value "y=-2" :db/ensure [:answer/validate]} {:db/id "answer-a03aa59a-1394-5203-9333-ab695d9a8b4b" :answer/id #uuid "a03aa59a-1394-5203-9333-ab695d9a8b4b" :answer/type :answer.type/math :answer/value "y>-2" :db/ensure [:answer/validate]} [:db/retract 17592186159686 :answer-field/choices 17592186159687] [:db/retract 17592186159686 :answer-field/choices 17592186159688] [:db/retract 17592186159686 :answer-field/choices 17592186159689] [:db/retract 17592186159686 :answer-field/choices 17592186159690] [:db/retract 17592186159686 :answer-field/choices 17592186159691] {:db/id 17592186162414 :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3}{2}, & {x}^{2}\\le y\\le 1,\\,0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{2}(1-{x}^{2}), & 0<x<1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the expression for the conditional expected value $\\text{E}[Y\\,|\\,X=x]$ for $0<x<1.$" :question/worked-solution "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3}{2})}{\\frac{3}{2}(1-{x}^{2})} \\\\  & =\\frac{1}{1-{x}^{2}},\\end{aligned}\n$$\n\nwhere ${x}^{2}\\le y\\le 1,\\,0<x<1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=x] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y \\\\  & ={\\int }_{{x}^{2}}^{1}y\\cdot \\,\\frac{1}{1-{x}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{1-{x}^{2}}{\\int }_{{x}^{2}}^{1}y\\,\\text{d}y \\\\  & =\\frac{1}{1-{x}^{2}}{[\\frac{{y}^{2}}{2}]}_{{x}^{2}}^{1} \\\\  & =\\frac{1}{1-{x}^{2}}[\\frac{1}{2}-\\frac{{x}^{4}}{2}] \\\\  & =\\frac{1}{1-{x}^{2}}\\cdot \\frac{1-{x}^{4}}{2} \\\\  & =\\frac{1}{\\cancel{1-{x}^{2}}}\\cdot \\frac{\\cancel{(1-{x}^{2})}(1+{x}^{2})}{2} \\\\  & =\\frac{1+{x}^{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186159686 :answer-field/correct "answer-7cfb93cf-bd42-5bbd-b926-c729076a7176" :answer-field/choices ["answer-9d05d328-ed87-5676-8000-bf330c49b276" "answer-f86d5c54-dcc9-590b-831d-717992f4b407" "answer-fd4e3252-f147-5beb-9e9a-fc41e8f66725" "answer-7cfb93cf-bd42-5bbd-b926-c729076a7176" "answer-e1e11f88-ae8b-5b32-bcc7-944cd00e9429"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d05d328-ed87-5676-8000-bf330c49b276" :answer/id #uuid "9d05d328-ed87-5676-8000-bf330c49b276" :answer/type :answer.type/math :answer/value "1+x" :db/ensure [:answer/validate]} {:db/id "answer-f86d5c54-dcc9-590b-831d-717992f4b407" :answer/id #uuid "f86d5c54-dcc9-590b-831d-717992f4b407" :answer/type :answer.type/math :answer/value "1-x" :db/ensure [:answer/validate]} {:db/id "answer-fd4e3252-f147-5beb-9e9a-fc41e8f66725" :answer/id #uuid "fd4e3252-f147-5beb-9e9a-fc41e8f66725" :answer/type :answer.type/math :answer/value "1-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-7cfb93cf-bd42-5bbd-b926-c729076a7176" :answer/id #uuid "7cfb93cf-bd42-5bbd-b926-c729076a7176" :answer/type :answer.type/math :answer/value "\\frac{1+{x}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e1e11f88-ae8b-5b32-bcc7-944cd00e9429" :answer/id #uuid "e1e11f88-ae8b-5b32-bcc7-944cd00e9429" :answer/type :answer.type/math :answer/value "\\frac{1-{x}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186162127 :knowledge-point/questions ["question-c0901d8a-5ab9-5481-aeea-fb9811603032" "question-febf3d13-3a80-5fb8-bb8d-fc4ac7755bf9" "question-72ca9ca6-7469-59a8-9b29-546c35450d5e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c0901d8a-5ab9-5481-aeea-fb9811603032" :question/id #uuid "c0901d8a-5ab9-5481-aeea-fb9811603032" :question/math-academy-id "q-146256" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{3(x+y)}{4}, & 0<x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}3{y}^{2}, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3(x+y)}{4})}{3{y}^{2}} \\\\  & =\\frac{(x+y)}{4{y}^{2}},\\end{aligned}\n$$\n\nwhere $0<x\\le 2y,\\,0<y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{(x+1)}{4}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{(x+1)}{4}\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}({x}^{2}+x)\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{{x}^{3}}{3}+\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =\\frac{1}{4}[(\\frac{8}{3}+2)-0] \\\\  & =\\frac{7}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e0a449ce-c8fa-55c9-ab8d-6d9f7f6b2000"] :db/ensure [:question/validate]} {:db/id "answer-field-e0a449ce-c8fa-55c9-ab8d-6d9f7f6b2000" :answer-field/id #uuid "e0a449ce-c8fa-55c9-ab8d-6d9f7f6b2000" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7d6410d-8ce9-57d1-9928-c24c78a23343" :answer-field/choices ["answer-92fa2249-5af2-5ed4-b4f5-e80a0891b31b" "answer-c7e58acf-da9e-5137-9d01-db3f88e60768" "answer-a59e2126-217b-588b-8ec1-c18e748c0160" "answer-02c49c4a-231f-5e98-b371-0e935a20a3ea" "answer-d7d6410d-8ce9-57d1-9928-c24c78a23343"] :db/ensure [:answer-field/validate]} {:db/id "answer-92fa2249-5af2-5ed4-b4f5-e80a0891b31b" :answer/id #uuid "92fa2249-5af2-5ed4-b4f5-e80a0891b31b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c7e58acf-da9e-5137-9d01-db3f88e60768" :answer/id #uuid "c7e58acf-da9e-5137-9d01-db3f88e60768" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a59e2126-217b-588b-8ec1-c18e748c0160" :answer/id #uuid "a59e2126-217b-588b-8ec1-c18e748c0160" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-02c49c4a-231f-5e98-b371-0e935a20a3ea" :answer/id #uuid "02c49c4a-231f-5e98-b371-0e935a20a3ea" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-d7d6410d-8ce9-57d1-9928-c24c78a23343" :answer/id #uuid "d7d6410d-8ce9-57d1-9928-c24c78a23343" :answer/type :answer.type/math :answer/value "\\frac{7}{6}" :db/ensure [:answer/validate]} {:db/id "question-febf3d13-3a80-5fb8-bb8d-fc4ac7755bf9" :question/id #uuid "febf3d13-3a80-5fb8-bb8d-fc4ac7755bf9" :question/math-academy-id "q-146344" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}1+y-x, & 0\\le x\\le 2y,\\,\\,0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}2y, & 0<y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional expected value $\\text{E}[X\\,|\\,Y=1].$" :question/worked-solution "Recall that the conditional expected value of $X$ given $Y=y$ is defined by\n\n$$\n\\text{E}[X\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(1+y-x)}{2y},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 2y,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{(2-x)}{2}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }x\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{(2-x)}{2}\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}(2x-{x}^{2})\\text{d}x \\\\  & =\\frac{1}{2}{[{x}^{2}-\\frac{{x}^{3}}{3}]}_{0}^{2} \\\\  & =\\frac{1}{2}[(4-\\frac{8}{3})-0] \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b1e89487-9f71-5b83-9a7d-94bccae434fa"] :db/ensure [:question/validate]} {:db/id "answer-field-b1e89487-9f71-5b83-9a7d-94bccae434fa" :answer-field/id #uuid "b1e89487-9f71-5b83-9a7d-94bccae434fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76810779-d00b-5526-95a9-f6b537df2534" :answer-field/choices ["answer-05ef324f-e3e0-55de-bf8c-31d0adf63779" "answer-76810779-d00b-5526-95a9-f6b537df2534" "answer-1433506f-2bda-51e6-9d54-5354fc116b88" "answer-1d68d2b6-b709-52d4-a640-81aa11b499e7" "answer-ac4f0db2-b37d-5e05-b26f-af89dbb0df5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-05ef324f-e3e0-55de-bf8c-31d0adf63779" :answer/id #uuid "05ef324f-e3e0-55de-bf8c-31d0adf63779" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-76810779-d00b-5526-95a9-f6b537df2534" :answer/id #uuid "76810779-d00b-5526-95a9-f6b537df2534" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-1433506f-2bda-51e6-9d54-5354fc116b88" :answer/id #uuid "1433506f-2bda-51e6-9d54-5354fc116b88" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1d68d2b6-b709-52d4-a640-81aa11b499e7" :answer/id #uuid "1d68d2b6-b709-52d4-a640-81aa11b499e7" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-ac4f0db2-b37d-5e05-b26f-af89dbb0df5e" :answer/id #uuid "ac4f0db2-b37d-5e05-b26f-af89dbb0df5e" :answer/type :answer.type/math :answer/value "\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "question-72ca9ca6-7469-59a8-9b29-546c35450d5e" :question/id #uuid "72ca9ca6-7469-59a8-9b29-546c35450d5e" :question/math-academy-id "q-146353" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{2+y-x}{3}, & 0\\le x\\le 1,\\,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{5-2x}{6}, & 0\\le x\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $X$ are shown above. Find the conditional expected value $\\text{E}[Y\\,|\\,X=1].$" :question/worked-solution "Recall that the conditional expected value of $Y$ given $X=x$ is defined by\n\n$$\n\\text{E}[Y\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nNote that $\\text{E}[Y\\,|\\,X=x]$ is a function of $x.$ \n\nThe conditional density function of $Y$ given $X=x$ can be computed as \n\n$$\n\\begin{aligned}{f}_{Y|X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{2+y-x}{3})}{(\\frac{5-2x}{6})} \\\\  & =\\frac{2(2+y-x)}{5-2x},\\end{aligned}\n$$\n\n \n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{Y|X}(y\\,|\\,x)=0.$\n\nNow, substituting $x=1$ into the expression for ${f}_{Y|X}(y\\,|\\,x),$ we get\n\n$$\n{f}_{Y|X}(y\\,|\\,1)=\\frac{2(2+y-1)}{5-2\\cdot 1}=\\frac{2(1+y)}{3}.\n$$\n\nTherefore, using the definition of the conditional expectation above, we obtain \n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=1] & ={\\int }_{-\\infty }^{\\infty }y\\,{f}_{Y|X}(y\\,|\\,1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{2(1+y)}{3}\\text{d}y \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}(y+{y}^{2})\\text{d}y \\\\  & =\\frac{2}{3}{[\\frac{{y}^{2}}{2}+\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =\\frac{2}{3}[(\\frac{1}{2}+\\frac{1}{3})-0] \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-52b89aa0-9d44-5e08-ab59-3cc05bb04a17"] :db/ensure [:question/validate]} {:db/id "answer-field-52b89aa0-9d44-5e08-ab59-3cc05bb04a17" :answer-field/id #uuid "52b89aa0-9d44-5e08-ab59-3cc05bb04a17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7217da2-ae78-508a-874f-f889c1b07a86" :answer-field/choices ["answer-052804b5-ac12-5294-a262-e3fa2b590da2" "answer-31321875-45ba-5d60-9460-76f9ff4b65bc" "answer-66deb24d-93e5-58be-9017-317a664a99a3" "answer-c902eb5b-0235-5da3-b574-a9735354dbe7" "answer-d7217da2-ae78-508a-874f-f889c1b07a86"] :db/ensure [:answer-field/validate]} {:db/id "answer-052804b5-ac12-5294-a262-e3fa2b590da2" :answer/id #uuid "052804b5-ac12-5294-a262-e3fa2b590da2" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-31321875-45ba-5d60-9460-76f9ff4b65bc" :answer/id #uuid "31321875-45ba-5d60-9460-76f9ff4b65bc" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-66deb24d-93e5-58be-9017-317a664a99a3" :answer/id #uuid "66deb24d-93e5-58be-9017-317a664a99a3" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-c902eb5b-0235-5da3-b574-a9735354dbe7" :answer/id #uuid "c902eb5b-0235-5da3-b574-a9735354dbe7" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "answer-d7217da2-ae78-508a-874f-f889c1b07a86" :answer/id #uuid "d7217da2-ae78-508a-874f-f889c1b07a86" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "activity-367fbdd0-286b-5990-a241-79149760686f" :activity/id #uuid "367fbdd0-286b-5990-a241-79149760686f" :activity/title "Conditional Expectation for Continuous Random Variables" :activity/type :activity.type/review :activity/scope 17592186050965 :activity/course 17592186046658 :activity/steps ["step-e99a2b96-04a4-56d4-b984-c2f3490f6093" "step-1181624e-c0cd-5f60-b961-039085d0722f" "step-a211e675-f3f3-58f6-9ae3-cb834095d76e" "step-a56c8877-9613-5958-b79a-c092e65fd1f3"] :activity/first-step "step-e99a2b96-04a4-56d4-b984-c2f3490f6093" :db/ensure [:activity/validate]} {:db/id "step-e99a2b96-04a4-56d4-b984-c2f3490f6093" :step/id #uuid "e99a2b96-04a4-56d4-b984-c2f3490f6093" :step/content 17592186162414 :step/next "step-1181624e-c0cd-5f60-b961-039085d0722f" :db/ensure [:step/validate]} {:db/id "step-1181624e-c0cd-5f60-b961-039085d0722f" :step/id #uuid "1181624e-c0cd-5f60-b961-039085d0722f" :step/content "question-c0901d8a-5ab9-5481-aeea-fb9811603032" :step/next "step-a211e675-f3f3-58f6-9ae3-cb834095d76e" :db/ensure [:step/validate]} {:db/id "step-a211e675-f3f3-58f6-9ae3-cb834095d76e" :step/id #uuid "a211e675-f3f3-58f6-9ae3-cb834095d76e" :step/content "question-febf3d13-3a80-5fb8-bb8d-fc4ac7755bf9" :step/next "step-a56c8877-9613-5958-b79a-c092e65fd1f3" :db/ensure [:step/validate]} {:db/id "step-a56c8877-9613-5958-b79a-c092e65fd1f3" :step/id #uuid "a56c8877-9613-5958-b79a-c092e65fd1f3" :step/content "question-72ca9ca6-7469-59a8-9b29-546c35450d5e" :db/ensure [:step/validate]} {:db/id 17592186092255 :knowledge-point/questions ["question-14f76056-5e3c-539d-8f82-855878eb07d3" "question-ac1cfe40-911c-5173-ab2c-22ea711c204a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092107 :question/problem "Given that $a_1=-2$ and $\\dfrac{a_{n+1}}{a_{n}} = -0.4$ for all integers $n \\geq 1,$ find the value of $\\displaystyle\\sum_{n=1}^\\infty a_{n}.$" :question/worked-solution "Notice that the given series is a geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity $S_\\infty$ of a geometric series is given by the formula\n\n$$\nS_\\infty = \\dfrac{a_1}{1-r}, \\qquad |r| <    1,\n$$\n\nwhere $a_1$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\na_1=-2.\n$$\n\nThe common ratio is\n\n$$\nr = \\dfrac{a_{n+1}}{a_{n}} = -0.4.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-2}{1-(-0.4)} \\\\  & =\\frac{-2}{1.4} \\\\  & =-\\frac{10}{7}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186092254 :knowledge-point/questions ["question-fbd76d75-8ee7-5bcd-acb2-1f5ae9aa3787" "question-df45f3a3-f545-5c42-98d5-edf671e88e36" "question-5c0c2f91-9457-576f-ab5b-77c8f4a530ad" "question-56e0e8e1-0cfd-5d25-b2ed-327a18d60529" "question-7e8589d7-77a6-5ea2-bd7d-7f7a24b35382"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092106 :question/problem "Evaluate the series $\\displaystyle\\sum_{n=1}^\\infty 2(0.5)^{n}.$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\displaystyle \\sum ar^n.$ \n\nThe sum to infinity $S_\\infty$ of a geometric series is given by the formula\n\n$$\nS_\\infty = \\dfrac{a_1}{1-r}, \\qquad |r| <    1,\n$$\n\nwhere $a_1$ is the first term and $r$ is the common ratio.\n\nThe first term is \n\n$$\na_1 = 2(0.5)^{1} = 1.\n$$\n\n \n\nThe common ratio is\n\n$$\nr = \\dfrac{a_2}{a_1} = \\dfrac{2(0.5)^2}{2(0.5)^1} = 0.5.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }2(0.5)^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{1}{1-0.5} \\\\  & =\\frac{1}{0.5} \\\\  & =2.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186092182 :knowledge-point/questions ["question-dd479934-e321-5035-bf71-51bd7984a9a8" "question-54f15411-79a5-546c-8ee4-965cb1e88cd5" "question-d588b5a8-8a0c-5e4d-8e17-d8c93ee42445" "question-75a391e4-92f0-5306-8519-d804235fa403"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092019 :question/problem "Evaluate the series $\\displaystyle \\sum_{n=2}^\\infty\\left(\\dfrac 2 3\\right)^n.$" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\displaystyle \\sum ar^n.$ \n\nIn this case, the first term is $a_2,$ and so the sum to infinity $S_\\infty$ of this geometric series is given by\n\n$$\nS_\\infty = \\dfrac{a_2}{1-r}, \\qquad |r| <        1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & ={(\\frac{2}{3})}^{2}=\\frac{4}{9} \\\\ {a}_{3} & ={(\\frac{2}{3})}^{3}=\\frac{8}{27}\\end{aligned}\n$$\n\nThe common ratio is:\n\n$$\nr = \\dfrac{a_3}{a_2} = \\dfrac{\\left( \\dfrac{8}{27}\\right)}{\\left( \\dfrac{4}{9}\\right)} = \\dfrac 2 3\n$$\n\nSo, the sum of the series is:\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }{(\\frac{2}{3})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{4}{9})}{(1-\\frac{2}{3})} \\\\  & =\\frac{(\\frac{4}{9})}{(\\frac{1}{3})} \\\\  & =\\frac{4\\cdot 3}{9} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186092256 :knowledge-point/questions ["question-4db8cfdc-3e22-5283-b109-341d9daf5b09" "question-7a6fcb51-44e7-59f8-9078-8afece3073a1" "question-499dc119-15d3-5a33-9631-8bc1b2a65d1c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092108 :question/problem "Evaluate the geometric series $\\displaystyle \\sum_{n=3}^\\infty \\dfrac{5}{2}\\left(\\dfrac{1}{2}\\right)^{2n}.$" :question/worked-solution "First, note that the index $n$ starts from $3.$ In this case, the first term is $a_3,$ and so the sum to infinity $S_\\infty$ of this geometric series is given by\n\n$$\nS_\\infty = \\dfrac{a_3}{1-r}, \\qquad |r| <        1.\n$$\n\nComputing the first few terms, we get:\n\n$$\na_3 = \\dfrac{5}{2}\\left(\\dfrac{1}{2}\\right)^{2(3)} = \\dfrac{5}{2}\\left(\\dfrac{1}{2}\\right)^{6} = 5\\left(\\dfrac{1}{2}\\right)^{7}\n$$\n\n \n\n$$\na_4 = \\dfrac{5}{2}\\left(\\dfrac{1}{2}\\right)^{2(4)} = \\dfrac{5}{2}\\left(\\dfrac{1}{2}\\right)^{8} = 5\\left(\\dfrac{1}{2}\\right)^{9}\n$$\n\nTherefore, the common ratio is\n\n$$\nr = \\dfrac{a_4}{a_3} = \\dfrac{5\\left(\\dfrac{1}{2}\\right)^{9}}{5\\left(\\dfrac{1}{2}\\right)^{7}} = \\left(\\dfrac{1}{2}\\right)^{2} = \\dfrac{1}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{5}{2}{(\\frac{1}{2})}^{2n} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{5{(\\frac{1}{2})}^{7}}{(1-\\frac{1}{4})} \\\\  & =\\frac{(\\frac{5}{128})}{(\\frac{3}{4})} \\\\  & =(\\frac{5}{128})(\\frac{4}{3}) \\\\  & =\\frac{5}{3(32)} \\\\  & =\\frac{5}{96}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-14f76056-5e3c-539d-8f82-855878eb07d3" :question/id #uuid "14f76056-5e3c-539d-8f82-855878eb07d3" :question/math-academy-id "q-50498" :question/problem "Given that ${a}_{1}=-\\frac{5}{2}$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$" :question/worked-solution "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-\\frac{5}{2}.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-\\frac{5}{2}}{(1-(-\\frac{1}{10}))} \\\\  & =\\frac{-\\frac{5}{2}}{(\\frac{11}{10})} \\\\  & =-\\frac{5}{2}\\cdot \\frac{10}{11} \\\\  & =-\\frac{25}{11}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4409dd34-9ab8-5a98-a1d2-9602397921b0"] :db/ensure [:question/validate]} {:db/id "answer-field-4409dd34-9ab8-5a98-a1d2-9602397921b0" :answer-field/id #uuid "4409dd34-9ab8-5a98-a1d2-9602397921b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75aed8b7-b806-509d-904b-d5e5a1544691" :answer-field/choices ["answer-359b2829-aef3-5244-a711-6b233756f5c3" "answer-75aed8b7-b806-509d-904b-d5e5a1544691" "answer-1bb127fe-81a1-51d8-a7f3-7f6901827eb3" "answer-ad2bcd84-ba3a-519d-a0e6-d8c907296ffc" "answer-3574038e-055d-56a6-9f8a-f1deedf83863"] :db/ensure [:answer-field/validate]} {:db/id "answer-359b2829-aef3-5244-a711-6b233756f5c3" :answer/id #uuid "359b2829-aef3-5244-a711-6b233756f5c3" :answer/type :answer.type/math :answer/value "-\\frac{23}{11}" :db/ensure [:answer/validate]} {:db/id "answer-75aed8b7-b806-509d-904b-d5e5a1544691" :answer/id #uuid "75aed8b7-b806-509d-904b-d5e5a1544691" :answer/type :answer.type/math :answer/value "-\\frac{25}{11}" :db/ensure [:answer/validate]} {:db/id "answ