#uuid "2b49dace-7157-5fcd-93a6-38c7a216f0bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-affb3ad8-1d5d-58a4-a1b4-565b6899a4b3" :answer-field/choices ["answer-9e70a9d6-bacc-5fe2-8568-8f05a6c6178d" "answer-f66f70aa-4cfe-5c9a-8e5d-f20fca2a0a07" "answer-affb3ad8-1d5d-58a4-a1b4-565b6899a4b3" "answer-8e6cdf5e-b7eb-5794-be85-9572ba174c02" "answer-756a6803-8e24-5a8f-81c5-20f6d39dcb43"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e70a9d6-bacc-5fe2-8568-8f05a6c6178d" :answer/id #uuid "9e70a9d6-bacc-5fe2-8568-8f05a6c6178d" :answer/type :answer.type/math :answer/value "7(a-b)" :db/ensure [:answer/validate]} {:db/id "answer-f66f70aa-4cfe-5c9a-8e5d-f20fca2a0a07" :answer/id #uuid "f66f70aa-4cfe-5c9a-8e5d-f20fca2a0a07" :answer/type :answer.type/math :answer/value "7a-b" :db/ensure [:answer/validate]} {:db/id "answer-affb3ad8-1d5d-58a4-a1b4-565b6899a4b3" :answer/id #uuid "affb3ad8-1d5d-58a4-a1b4-565b6899a4b3" :answer/type :answer.type/math :answer/value "\\frac{1}{7(a-b)}" :db/ensure [:answer/validate]} {:db/id "answer-8e6cdf5e-b7eb-5794-be85-9572ba174c02" :answer/id #uuid "8e6cdf5e-b7eb-5794-be85-9572ba174c02" :answer/type :answer.type/math :answer/value "\\frac{1}{7a-b}" :db/ensure [:answer/validate]} {:db/id "answer-756a6803-8e24-5a8f-81c5-20f6d39dcb43" :answer/id #uuid "756a6803-8e24-5a8f-81c5-20f6d39dcb43" :answer/type :answer.type/math :answer/value "a-b" :db/ensure [:answer/validate]} {:db/id "question-c85a34c5-6e9b-5e37-9be6-8bd5b320956b" :question/id #uuid "c85a34c5-6e9b-5e37-9be6-8bd5b320956b" :question/math-academy-id "q-113063" :question/problem "Simplify $\\frac{3t-15}{3{t}^{2}-30t+75}.$" :question/worked-solution "Here, we take out a factor of $3$ from the numerator and from the denominator, and then use the polynomial factorization ${t}^{2}-10t+25=(t-5)^{2}.$ Canceling out any common factors that appear in both the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{3t-15}{3{t}^{2}-30t+75} & =\\frac{3(t-5)}{3({t}^{2}-10t+25)} \\\\  & =\\frac{3(t-5)}{3(t-5)^{2}} \\\\  & =\\frac{3(t-5)}{3(t-5)(t-5)} \\\\  & =\\frac{\\cancel{3}\\cancel{(t-5)}}{\\cancel{3}\\cancel{(t-5)}(t-5)} \\\\  & =\\frac{1}{t-5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-32d5cbfd-428a-5053-acb7-ffa3e900ce28"] :db/ensure [:question/validate]} {:db/id "answer-field-32d5cbfd-428a-5053-acb7-ffa3e900ce28" :answer-field/id #uuid "32d5cbfd-428a-5053-acb7-ffa3e900ce28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2fc03f0-1570-50e3-8044-f6d69f974008" :answer-field/choices ["answer-b2fc03f0-1570-50e3-8044-f6d69f974008" "answer-9a600d81-113a-5888-96a7-e80b763e08ea" "answer-418dfecf-ec3a-5583-9851-3ff2cb427404" "answer-775d37e2-5c7a-56f2-a453-a2f9bac2ad89" "answer-2f13fc29-f05e-5620-98a4-db8b5e91ff7a"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2fc03f0-1570-50e3-8044-f6d69f974008" :answer/id #uuid "b2fc03f0-1570-50e3-8044-f6d69f974008" :answer/type :answer.type/math :answer/value "\\frac{1}{t-5}" :db/ensure [:answer/validate]} {:db/id "answer-9a600d81-113a-5888-96a7-e80b763e08ea" :answer/id #uuid "9a600d81-113a-5888-96a7-e80b763e08ea" :answer/type :answer.type/math :answer/value "\\frac{3t-15}{t-5}" :db/ensure [:answer/validate]} {:db/id "answer-418dfecf-ec3a-5583-9851-3ff2cb427404" :answer/id #uuid "418dfecf-ec3a-5583-9851-3ff2cb427404" :answer/type :answer.type/math :answer/value "\\frac{3}{t-5}" :db/ensure [:answer/validate]} {:db/id "answer-775d37e2-5c7a-56f2-a453-a2f9bac2ad89" :answer/id #uuid "775d37e2-5c7a-56f2-a453-a2f9bac2ad89" :answer/type :answer.type/math :answer/value "\\frac{t+5}{t-5}" :db/ensure [:answer/validate]} {:db/id "answer-2f13fc29-f05e-5620-98a4-db8b5e91ff7a" :answer/id #uuid "2f13fc29-f05e-5620-98a4-db8b5e91ff7a" :answer/type :answer.type/math :answer/value "\\frac{t-15}{3}" :db/ensure [:answer/validate]} {:db/id "question-ca2d9c6a-ef62-5982-8134-5f8260bfee4a" :question/id #uuid "ca2d9c6a-ef62-5982-8134-5f8260bfee4a" :question/math-academy-id "q-113084" :question/problem "$\\frac{5{h}^{2}-10h-15}{4{h}^{2}-4h-8}=$" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\frac{5{h}^{2}-10h-15}{4{h}^{2}-4h-8} & =\\frac{5({h}^{2}-2h-3)}{4({h}^{2}-h-2)} \\\\  & =\\frac{5(h+1)(h-3)}{4(h-2)(h+1)} \\\\  & =\\frac{5\\cancel{(h+1)}(h-3)}{4(h-2)\\cancel{(h+1)}} \\\\  & =\\frac{5(h-3)}{4(h-2)} \\\\  & =\\frac{5h-15}{4h-8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ce07fe95-9768-5d1e-bdb4-bd567a7424d0"] :db/ensure [:question/validate]} {:db/id "answer-field-ce07fe95-9768-5d1e-bdb4-bd567a7424d0" :answer-field/id #uuid "ce07fe95-9768-5d1e-bdb4-bd567a7424d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea3a3b7d-430a-5e6b-ad81-75063775b9b7" :answer-field/choices ["answer-79ace241-1195-5850-9c3f-c5067cd881cb" "answer-05d0df93-ac65-52bd-b1f7-5efc926ad378" "answer-dc19d4eb-f44e-5b44-98ae-da4ebb739925" "answer-ea3a3b7d-430a-5e6b-ad81-75063775b9b7" "answer-185900a0-b3b8-508d-b13a-d0f1a28cf375"] :db/ensure [:answer-field/validate]} {:db/id "answer-79ace241-1195-5850-9c3f-c5067cd881cb" :answer/id #uuid "79ace241-1195-5850-9c3f-c5067cd881cb" :answer/type :answer.type/math :answer/value "\\frac{5h+10}{4h+4}" :db/ensure [:answer/validate]} {:db/id "answer-05d0df93-ac65-52bd-b1f7-5efc926ad378" :answer/id #uuid "05d0df93-ac65-52bd-b1f7-5efc926ad378" :answer/type :answer.type/math :answer/value "\\frac{5h+15}{4h-2}" :db/ensure [:answer/validate]} {:db/id "answer-dc19d4eb-f44e-5b44-98ae-da4ebb739925" :answer/id #uuid "dc19d4eb-f44e-5b44-98ae-da4ebb739925" :answer/type :answer.type/math :answer/value "\\frac{5h-10}{4h+8}" :db/ensure [:answer/validate]} {:db/id "answer-ea3a3b7d-430a-5e6b-ad81-75063775b9b7" :answer/id #uuid "ea3a3b7d-430a-5e6b-ad81-75063775b9b7" :answer/type :answer.type/math :answer/value "\\frac{5h-15}{4h-8}" :db/ensure [:answer/validate]} {:db/id "answer-185900a0-b3b8-508d-b13a-d0f1a28cf375" :answer/id #uuid "185900a0-b3b8-508d-b13a-d0f1a28cf375" :answer/type :answer.type/math :answer/value "\\frac{5h-1}{4h+2}" :db/ensure [:answer/validate]} {:db/id 17592186115505 :question/problem "What is $\\frac{{y}^{2}-9}{{y}^{2}-6y+9}$ reduced to lowest terms?" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{y}^{2}-9}{{y}^{2}-6y+9} & =\\frac{(y+3)(y-3)}{(y-3)(y-3)} \\\\  & =\\frac{(y+3)\\cancel{(y-3)}}{(y-3)\\cancel{(y-3)}} \\\\  & =\\frac{y+3}{y-3}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186112039 :answer-field/correct "answer-f0b0bba3-a44d-5fed-b627-cf10eb5ab4e6" :answer-field/choices ["answer-f0b0bba3-a44d-5fed-b627-cf10eb5ab4e6" "answer-3a93a5c9-9b97-50c8-a9d7-889c73728a64" "answer-2a4c56f8-ce4c-5391-98e3-49ec1d8a6d45" "answer-d6fcaa55-a5ac-5cf9-823b-bfaa2dc9ba68" "answer-a53452b3-ec60-5862-88ef-57f3f210e854"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0b0bba3-a44d-5fed-b627-cf10eb5ab4e6" :answer/id #uuid "f0b0bba3-a44d-5fed-b627-cf10eb5ab4e6" :answer/type :answer.type/math :answer/value "\\frac{y+3}{y-3}" :db/ensure [:answer/validate]} {:db/id "answer-3a93a5c9-9b97-50c8-a9d7-889c73728a64" :answer/id #uuid "3a93a5c9-9b97-50c8-a9d7-889c73728a64" :answer/type :answer.type/math :answer/value "\\frac{y-3}{y+3}" :db/ensure [:answer/validate]} {:db/id "answer-2a4c56f8-ce4c-5391-98e3-49ec1d8a6d45" :answer/id #uuid "2a4c56f8-ce4c-5391-98e3-49ec1d8a6d45" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}-3}{{y}^{2}-2y+3}" :db/ensure [:answer/validate]} {:db/id "answer-d6fcaa55-a5ac-5cf9-823b-bfaa2dc9ba68" :answer/id #uuid "d6fcaa55-a5ac-5cf9-823b-bfaa2dc9ba68" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}-9}{{y}^{2}-6y+9}" :db/ensure [:answer/validate]} {:db/id "answer-a53452b3-ec60-5862-88ef-57f3f210e854" :answer/id #uuid "a53452b3-ec60-5862-88ef-57f3f210e854" :answer/type :answer.type/math :answer/value "y+3" :db/ensure [:answer/validate]} {:db/id "question-77fb920e-43ca-5282-8a0a-596d7af0b021" :question/id #uuid "77fb920e-43ca-5282-8a0a-596d7af0b021" :question/math-academy-id "q-79524" :question/problem "What is $\\frac{{a}^{2}-4a+4}{{a}^{2}-4}$ reduced to lowest terms?" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{a}^{2}-4a+4}{{a}^{2}-4} & =\\frac{(a-2)^{2}}{(a-2)(a+2)} \\\\  & =\\frac{(a-2)\\cancel{(a-2)}}{\\cancel{(a-2)}(a+2)} \\\\  & =\\frac{a-2}{a+2}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c230db6-7b8d-59da-8017-ad873f367157"] :db/ensure [:question/validate]} {:db/id "answer-field-9c230db6-7b8d-59da-8017-ad873f367157" :answer-field/id #uuid "9c230db6-7b8d-59da-8017-ad873f367157" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b15102e0-61a5-5171-a2af-da7cbae7775e" :answer-field/choices ["answer-a940a945-0eb1-5120-b96c-419114e81e79" "answer-fcb69b37-dc2f-5790-8ba1-41a7aa979bd7" "answer-878b8168-4e99-55cf-bfb9-df7740b08e3e" "answer-b15102e0-61a5-5171-a2af-da7cbae7775e" "answer-ca166edf-a07d-5672-8745-9a484f33beca"] :db/ensure [:answer-field/validate]} {:db/id "answer-a940a945-0eb1-5120-b96c-419114e81e79" :answer/id #uuid "a940a945-0eb1-5120-b96c-419114e81e79" :answer/type :answer.type/math :answer/value "\\frac{a+2}{a-2}" :db/ensure [:answer/validate]} {:db/id "answer-fcb69b37-dc2f-5790-8ba1-41a7aa979bd7" :answer/id #uuid "fcb69b37-dc2f-5790-8ba1-41a7aa979bd7" :answer/type :answer.type/math :answer/value "\\frac{a+2}{a}" :db/ensure [:answer/validate]} {:db/id "answer-878b8168-4e99-55cf-bfb9-df7740b08e3e" :answer/id #uuid "878b8168-4e99-55cf-bfb9-df7740b08e3e" :answer/type :answer.type/math :answer/value "\\frac{a-2}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b15102e0-61a5-5171-a2af-da7cbae7775e" :answer/id #uuid "b15102e0-61a5-5171-a2af-da7cbae7775e" :answer/type :answer.type/math :answer/value "\\frac{a-2}{a+2}" :db/ensure [:answer/validate]} {:db/id "answer-ca166edf-a07d-5672-8745-9a484f33beca" :answer/id #uuid "ca166edf-a07d-5672-8745-9a484f33beca" :answer/type :answer.type/math :answer/value "\\frac{a}{a+2}" :db/ensure [:answer/validate]} {:db/id "question-e14ac645-6583-57f4-8d3d-7907bb61243a" :question/id #uuid "e14ac645-6583-57f4-8d3d-7907bb61243a" :question/math-academy-id "q-113086" :question/problem "Which of the following is equivalent to $\\frac{{b}^{2}-7b+12}{4{b}^{2}+16b-84}?$" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\frac{{b}^{2}-7b+12}{4{b}^{2}+16b-84} & =\\frac{{b}^{2}-7b+12}{4({b}^{2}+4b-21)} \\\\  & =\\frac{(b-3)(b-4)}{4(b+7)(b-3)} \\\\  & =\\frac{\\cancel{(b-3)}(b-4)}{4(b+7)\\cancel{(b-3)}} \\\\  & =\\frac{b-4}{4(b+7)} \\\\  & =\\frac{b-4}{4b+28}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-02dbfdaf-c00e-5aee-95f8-716944a85088"] :db/ensure [:question/validate]} {:db/id "answer-field-02dbfdaf-c00e-5aee-95f8-716944a85088" :answer-field/id #uuid "02dbfdaf-c00e-5aee-95f8-716944a85088" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e3332cc0-b4ea-572e-b440-6236bbb8d4db" :answer-field/choices ["answer-9dbe3d10-5061-528e-81f8-39432f7bfbb2" "answer-5a70ca19-e1f1-5782-b3eb-5cb3bd61d5f5" "answer-3d02cd7b-0c89-50c8-a354-474f0af1ffff" "answer-603bb21b-1525-5e2c-8f15-00663cd88f35" "answer-e3332cc0-b4ea-572e-b440-6236bbb8d4db"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dbe3d10-5061-528e-81f8-39432f7bfbb2" :answer/id #uuid "9dbe3d10-5061-528e-81f8-39432f7bfbb2" :answer/type :answer.type/math :answer/value "\\frac{b+3}{4b-12}" :db/ensure [:answer/validate]} {:db/id "answer-5a70ca19-e1f1-5782-b3eb-5cb3bd61d5f5" :answer/id #uuid "5a70ca19-e1f1-5782-b3eb-5cb3bd61d5f5" :answer/type :answer.type/math :answer/value "\\frac{b+4}{4b+6}" :db/ensure [:answer/validate]} {:db/id "answer-3d02cd7b-0c89-50c8-a354-474f0af1ffff" :answer/id #uuid "3d02cd7b-0c89-50c8-a354-474f0af1ffff" :answer/type :answer.type/math :answer/value "\\frac{b-2}{4b+14}" :db/ensure [:answer/validate]} {:db/id "answer-603bb21b-1525-5e2c-8f15-00663cd88f35" :answer/id #uuid "603bb21b-1525-5e2c-8f15-00663cd88f35" :answer/type :answer.type/math :answer/value "\\frac{b-3}{4b+8}" :db/ensure [:answer/validate]} {:db/id "answer-e3332cc0-b4ea-572e-b440-6236bbb8d4db" :answer/id #uuid "e3332cc0-b4ea-572e-b440-6236bbb8d4db" :answer/type :answer.type/math :answer/value "\\frac{b-4}{4b+28}" :db/ensure [:answer/validate]} {:db/id 17592186116515 :tutorial/content "To reduce a rational expression to its lowest terms, we need to factor the numerator and denominator and then cancel out the common factors.\n\nFor example, to simplify the rational expression $\\dfrac{2x}{2+6x},$ we cancel out a factor of $2$ from the numerator and denominator:\n\n$$\n\\begin{aligned}\\frac{2x}{2+6x} & = \\\\ \\frac{2x}{2(1+3x)} & = \\\\ \\frac{x}{1+3x}\\end{aligned}\n$$\n\nSometimes, however, we can have more complicated expressions which require **polynomial factorization** in order to be simplified.\n\nNo need to panic though! The main strategy is always the same: factor the numerator and denominator, and then cancel out common factors.\n\nFor example, to simplify the rational expression $\\dfrac{x^2-4}{x+2},$ we factor the difference of squares in the numerator and then cancel out a common factor:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-4}{x+2} & = \\\\ \\frac{(x+2)(x-2)}{x+2} & = \\\\ \\frac{\\cancel{(x+2)}(x-2)}{\\cancel{x+2}} & = \\\\ x-2 & \\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186115452 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186124629 :knowledge-point/questions ["question-f1d7f6a4-6114-5671-a52c-7df48bee5e24"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f1d7f6a4-6114-5671-a52c-7df48bee5e24" :question/id #uuid "f1d7f6a4-6114-5671-a52c-7df48bee5e24" :question/math-academy-id "q-141342" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)\\ne 0,$ then  $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\text{Null}(A)$ has no basis\n\nII. $A$ is **not** invertible\n\nIII. All columns of $A$ are pivot columns" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately. \n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Null}(A)$ has no basis.* $\\,\\times $ \n\nSince $\\text{nullity}(A)\\ne 0,$ we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn, means that $\\text{Null}(A)$ must have a basis.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is **not** invertible.* $\\,✓$\n\nIndeed, by the invertible matrix theorem, since $\\text{nullity}(A)\\ne 0,$ we must have that $A$ is **not** invertible.\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then all columns of $A$ are pivot columns.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{n},$ which means that not all columns of $A$ are pivot columns.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-20580d7d-28aa-5c7c-a048-784d0bfa2d4b"] :db/ensure [:question/validate]} {:db/id "answer-field-20580d7d-28aa-5c7c-a048-784d0bfa2d4b" :answer-field/id #uuid "20580d7d-28aa-5c7c-a048-784d0bfa2d4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5d885553-3afc-5696-a382-4c860965f60c" :answer-field/choices ["answer-e94c076f-c6c7-517d-8c55-d74158a4a6fe" "answer-7bf00a72-f79f-582d-9aaa-38874ff20b92" "answer-7df12baa-7b1b-58dc-8f63-3871724e61dd" "answer-5d885553-3afc-5696-a382-4c860965f60c" "answer-c974d506-c2bc-5e7b-97a4-c51ae5371031"] :db/ensure [:answer-field/validate]} {:db/id "answer-e94c076f-c6c7-517d-8c55-d74158a4a6fe" :answer/id #uuid "e94c076f-c6c7-517d-8c55-d74158a4a6fe" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7bf00a72-f79f-582d-9aaa-38874ff20b92" :answer/id #uuid "7bf00a72-f79f-582d-9aaa-38874ff20b92" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7df12baa-7b1b-58dc-8f63-3871724e61dd" :answer/id #uuid "7df12baa-7b1b-58dc-8f63-3871724e61dd" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5d885553-3afc-5696-a382-4c860965f60c" :answer/id #uuid "5d885553-3afc-5696-a382-4c860965f60c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c974d506-c2bc-5e7b-97a4-c51ae5371031" :answer/id #uuid "c974d506-c2bc-5e7b-97a4-c51ae5371031" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186124511 :knowledge-point/questions ["question-74f4be02-4fe9-5741-a4d1-7268f77a2f5f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-74f4be02-4fe9-5741-a4d1-7268f77a2f5f" :question/id #uuid "74f4be02-4fe9-5741-a4d1-7268f77a2f5f" :question/math-academy-id "q-142472" :question/problem "Which of the following statements are true, given that $A$ is a $3\\times 3$ matrix and  $det(A)=-1?$ \n\nI. $A$ is **not** invertible\n\nII. $\\text{rank}(A)=3$\n\nIII. $A$ has $4$ pivot columns" :question/worked-solution "Since $A$ is a $3\\times 3$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{3} \\\\  & \\text{dim(Col}(A))=3=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{rank}(A)=3.$\n\n- Statement III is false. Since $\\text{rank}(A)=3$,  it must be $\\text{dim(Col}(A))=3$ which, in turn, means that  $A$ has $3$ pivot columns, not $4.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-255a02e5-2e2c-5989-905e-69f5223274a6"] :db/ensure [:question/validate]} {:db/id "answer-field-255a02e5-2e2c-5989-905e-69f5223274a6" :answer-field/id #uuid "255a02e5-2e2c-5989-905e-69f5223274a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e0746457-062b-51a1-b39b-1801dcc9dd24" :answer-field/choices ["answer-7385e402-bf26-5641-9a0b-660e87ee9d07" "answer-f4fb30e2-e856-5197-b6a2-1b2e5bd62f64" "answer-6c0bd5dd-c5f7-5e5d-b21c-bcdb4e2b830b" "answer-e0746457-062b-51a1-b39b-1801dcc9dd24" "answer-e15f2509-6136-5ef5-b754-59b129df8ee9"] :db/ensure [:answer-field/validate]} {:db/id "answer-7385e402-bf26-5641-9a0b-660e87ee9d07" :answer/id #uuid "7385e402-bf26-5641-9a0b-660e87ee9d07" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f4fb30e2-e856-5197-b6a2-1b2e5bd62f64" :answer/id #uuid "f4fb30e2-e856-5197-b6a2-1b2e5bd62f64" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6c0bd5dd-c5f7-5e5d-b21c-bcdb4e2b830b" :answer/id #uuid "6c0bd5dd-c5f7-5e5d-b21c-bcdb4e2b830b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e0746457-062b-51a1-b39b-1801dcc9dd24" :answer/id #uuid "e0746457-062b-51a1-b39b-1801dcc9dd24" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-e15f2509-6136-5ef5-b754-59b129df8ee9" :answer/id #uuid "e15f2509-6136-5ef5-b754-59b129df8ee9" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-266f8ba6-aa38-58ed-8d33-3aec933a1e12" :activity/id #uuid "266f8ba6-aa38-58ed-8d33-3aec933a1e12" :activity/title "The Invertible Matrix Theorem in Terms of Dimension, Rank and Nullity" :activity/type :activity.type/review :activity/scope 17592186049340 :activity/course 17592186046658 :activity/steps ["step-e46ea0a8-4991-5f8c-a308-9bc68c5b0d80" "step-cb8b82a3-c3e9-567b-8dbd-19ce7dce93de" "step-94778ac8-3dd7-5564-88c5-443046b2e6fe" "step-2a21ddf3-d51f-5117-8439-7fd92a4b2b2d" "step-0a7d2e71-2df5-5616-a66c-1039ae6b7480"] :activity/first-step "step-e46ea0a8-4991-5f8c-a308-9bc68c5b0d80" :db/ensure [:activity/validate]} {:db/id "step-e46ea0a8-4991-5f8c-a308-9bc68c5b0d80" :step/id #uuid "e46ea0a8-4991-5f8c-a308-9bc68c5b0d80" :step/content 17592186329820 :step/next "step-cb8b82a3-c3e9-567b-8dbd-19ce7dce93de" :db/ensure [:step/validate]} {:db/id "step-cb8b82a3-c3e9-567b-8dbd-19ce7dce93de" :step/id #uuid "cb8b82a3-c3e9-567b-8dbd-19ce7dce93de" :step/content 17592186272238 :step/next "step-94778ac