6147" :answer/type :answer.type/text :answer/value "$x=0$ and $x=6$" :db/ensure [:answer/validate]} {:db/id "answer-20178d11-ebc0-5da0-843f-8cc3f52ecea5" :answer/id #uuid "20178d11-ebc0-5da0-843f-8cc3f52ecea5" :answer/type :answer.type/text :answer/value "$x=3$ and $x=-6$" :db/ensure [:answer/validate]} {:db/id "answer-f474f41c-02ad-500d-a513-2b1e0c39ae6a" :answer/id #uuid "f474f41c-02ad-500d-a513-2b1e0c39ae6a" :answer/type :answer.type/text :answer/value "$x=3$ and $x=0$" :db/ensure [:answer/validate]} {:db/id "answer-0fb0d9a4-9047-58f4-8e38-7b273aec2f8b" :answer/id #uuid "0fb0d9a4-9047-58f4-8e38-7b273aec2f8b" :answer/type :answer.type/text :answer/value "$x=3$ and $x=6$" :db/ensure [:answer/validate]} {:db/id "question-ba657a54-9357-5409-90cb-ee552f02dde2" :question/id #uuid "ba657a54-9357-5409-90cb-ee552f02dde2" :question/math-academy-id "q-106037" :question/problem "![](images/dc/dc388ceccdd95990d69ebf1c2df36ab8ed0c83228d7684b13a7a791e9705851f.png)\n\nFind the roots of the parabola shown above." :question/worked-solution "The roots of a parabola are the $x$-intercepts of the parabola.\n\nFrom the graph, we can see that the curve intercepts the $x$-axis at the points $(-5,0)$ and $(0,0).$\n\nTherefore, the roots are $x=-5$ and $x=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2c9e6ff9-aea3-5884-90a2-d4e33d398c8a"] :db/ensure [:question/validate]} {:db/id "answer-field-2c9e6ff9-aea3-5884-90a2-d4e33d398c8a" :answer-field/id #uuid "2c9e6ff9-aea3-5884-90a2-d4e33d398c8a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bdac80d4-23d5-5508-be12-8819ce04d371" :answer-field/choices ["answer-71221b89-0e4a-5c2b-bc88-3d846a415acf" "answer-f5aaed55-ac20-50e6-8c01-664268febc9e" "answer-d4c268f8-b35a-53a8-bc9f-0fc1248085da" "answer-bdac80d4-23d5-5508-be12-8819ce04d371" "answer-cec52289-e463-54ce-875c-563a27e4c4a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-71221b89-0e4a