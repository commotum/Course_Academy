11dc528f8beeec090e69179674e2a2fcc06c4e.png" :db/ensure [:answer/validate]} {:db/id "answer-ace28041-7ad9-5b57-94d8-6d9337e5852f" :answer/id #uuid "ace28041-7ad9-5b57-94d8-6d9337e5852f" :answer/type :answer.type/image :answer/value "images/a3/a360c41302b317f2796fede233e8726bf53e44739e681d8d5688c135b2f70aa7.png" :db/ensure [:answer/validate]} {:db/id "answer-7e1392d9-c3ad-52cb-8246-784f99d67d3d" :answer/id #uuid "7e1392d9-c3ad-52cb-8246-784f99d67d3d" :answer/type :answer.type/image :answer/value "images/d7/d77bb469fad643a6d6eb7d5ec1cae73a5a4d47c1519cb16bea4e702e5bf60ade.png" :db/ensure [:answer/validate]} {:db/id "question-3149eba2-f75e-505c-909c-9beed59b368d" :question/id #uuid "3149eba2-f75e-505c-909c-9beed59b368d" :question/math-academy-id "q-70595" :question/problem "![](images/62/62474d31ab2981d6173671acb875ec401a51c230994e60e10421d385f2e099a9.png)\n\nConsider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+b$ shown above. What is the value of $b?$" :question/worked-solution "The graph of $y=f(x)+b$ can be obtained from the graph of $y=f(x)$ by translating it $6$ units *down*. So, $b=-6.$\n\n![](images/3f/3fcbd6ce5ea6543fea0038df30e8f31db18c82ceefa975aaaec1854d85766eab.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-72225bb6-b5d8-56a1-ac12-0e99393c3266"] :db/ensure [:question/validate]} {:db/id "answer-field-72225bb6-b5d8-56a1-ac12-0e99393c3266" :answer-field/id #uuid "72225bb6-b5d8-56a1-ac12-0e99393c3266" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1bc8ce54-b742-59c6-9903-b78514719396" :answer-field/choices ["answer-e58738c4-3bf2-5bfe-aa4f-5d3984b37392" "answer-1e2d58a8-eb6b-5ef4-954f-729d860e075d" "answer-1bc8ce54-b742-59c6-9903-b78514719396" "answer-5fd49550-1b77-52c7-b0e0-8cf183055005" "answer-6da3e2a8-a432-5259-a55b-a51c0d3a0e48"] :db/ensure [:answer-field/validate]} {:db/id "answer-e58738c4-3bf2-5bfe-aa4f-5d3984b37392" :answer/id #uuid "e58738c4-3bf2-5bfe-aa4f-5d3984b37392" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-1e2d58a8-eb6b-5ef4-954f-729d860e075d" :answer/id #uuid "1e2d58a8-eb6b-5ef4-954f-729d860e075d" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-1bc8ce54-b742-59c6-9903-b78514719396" :answer/id #uuid "1bc8ce54-b742-59c6-9903-b78514719396" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-5fd49550-1b77-52c7-b0e0-8cf183055005" :answer/id #uuid "5fd49550-1b77-52c7-b0e0-8cf183055005" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-6da3e2a8-a432-5259-a55b-a51c0d3a0e48" :answer/id #uuid "6da3e2a8-a432-5259-a55b-a51c0d3a0e48" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-2b584399-1501-573d-8e9c-16d0bbc631a2" :question/id #uuid "2b584399-1501-573d-8e9c-16d0bbc631a2" :question/math-academy-id "q-108226" :question/problem "![](images/71/7187ce3dfce771f3897b7073704b49fa8926bb8c1a16cd18af68e02978d2a526.png)\n\nConsider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+c$ shown above. What is the value of $c?$" :question/worked-solution "The graph of $y=f(x)+c$ can be obtained from the graph of $y=f(x)$ by translating it $7$ units *up*. So, $c=7.$\n\n![](images/a5/a5322569c974effb49773ee06a38da3f1953e0d9fc55464d8fae367e45dc15af.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90936840-6505-56df-90f9-a2edfbec12cb"] :db/ensure [:question/validate]} {:db/id "answer-field-90936840-6505-56df-90f9-a2edfbec12cb" :answer-field/id #uuid "90936840-6505-56df-90f9-a2edfbec12cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e2c17db8-79d4-5c91-98c2-303483103c80" :answer-field/choices ["answer-408388ae-c71c-5a75-be53-309c59afe320" "answer-5ee410dc-eac8-53e5-8eed-88265c9ceec3" "answer-d078ba90-2068-5c7a-a111-9232a1285b20" "answer-e2c17db8-79d4-5c91-98c2-303483103c80" "answer-6d99fce5-7d01-55e5-b9e8-8992bc58bc16"] :db/ensure [:answer-field/validate]} {:db/id "answer-408388ae-c71c-5a75-be53-309c59afe320" :answer/id #uuid "408388ae-c71c-5a75-be53-309c59afe320" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-5ee410dc-eac8-53e5-8eed-88265c9ceec3" :answer/id #uuid "5ee410dc-eac8-53e5-8eed-88265c9ceec3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-d078ba90-2068-5c7a-a111-9232a1285b20" :answer/id #uuid "d078ba90-2068-5c7a-a111-9232a1285b20" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-e2c17db8-79d4-5c91-98c2-303483103c80" :answer/id #uuid "e2c17db8-79d4-5c91-98c2-303483103c80" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-6d99fce5-7d01-55e5-b9e8-8992bc58bc16" :answer/id #uuid "6d99fce5-7d01-55e5-b9e8-8992bc58bc16" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-b9eb1708-044c-5408-bdf8-03d4b09b76eb" :question/id #uuid "b9eb1708-044c-5408-bdf8-03d4b09b76eb" :question/math-academy-id "q-27000" :question/problem "The point $P$ with coordinates $(-3,1)$ lies on the curve $y=f(x)+1.$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "**Method 1**\n\nThe graph of $y=f(x)$ is obtained by translating the graph of $y=f(x)+1$ by $1$ unit *down.* \n\nHence, if the point $(-3,1)$ lies on $y=f(x)+1$, then the point \n\n$$\n(-3,1-1)=(-3,0)\n$$\n\nlies on $y=f(x).$\n\n![](images/2c/2c76b54e0dc12d52fbc6e41a601d5e87a105537e055a9d4cee4c758b0dd3ae63.png)\n\n**Method 2**\n\nAs $(-3,1)$ lies on $y=f(x)+1$, we have:\n\n$$\n\\begin{aligned}f(-3)+1 & =1 \\\\ f(-3) & =1-1 \\\\ f(-3) & =0\\end{aligned}\n$$\n\nNow, if $x=-3$ then\n\n$$\n\\begin{aligned}y & =f(-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the point $(-3,0)$ must lie on $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eda83d9c-61f5-554b-a3a6-fe587fe8ef1f"] :db/ensure [:question/validate]} {:db/id "answer-field-eda83d9c-61f5-554b-a3a6-fe587fe8ef1f" :answer-field/id #uuid "eda83d9c-61f5-554b-a3a6-fe587fe8ef1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-02e3936f-735b-5739-9f09-3e74a82318f1" :answer-field/choices ["answer-9138bce0-3929-50d0-a3b3-2a59060c22de" "answer-02e3936f-735b-5739-9f09-3e74a82318f1" "answer-bbf1a6b1-5480-5182-b8fd-9f38cf9f6d99" "answer-c2f46679-b601-5392-a4a4-0c4b58d5241e" "answer-ec7b4503-619f-5a8e-b675-a2ab33c15ae1"] :db/ensure [:answer-field/validate]} {:db/id "answer-9138bce0-3929-50d0-a3b3-2a59060c22de" :answer/id #uuid "9138bce0-3929-50d0-a3b3-2a59060c22de" :answer/type :answer.type/math :answer/value "(-3,-1)" :db/ensure [:answer/validate]} {:db/id "answer-02e3936f-735b-5739-9f09-3e74a82318f1" :answer/id #uuid "02e3936f-735b-5739-9f09-3e74a82318f1" :answer/type :answer.type/math :answer/value "(-3,0)" :db/ensure [:answer/validate]} {:db/id "answer-bbf1a6b1-5480-5182-b8fd-9f38cf9f6d99" :answer/id #uuid "bbf1a6b1-5480-5182-b8fd-9f38cf9f6d99" :answer/type :answer.type/math :answer/value "(-3,1)" :db/ensure [:answer/validate]} {:db/id "answer-c2f46679-b601-5392-a4a4-0c4b58d5241e" :answer/id #uuid "c2f46679-b601-5392-a4a4-0c4b58d5241e" :answer/type :answer.type/math :answer/value "(-3,2)" :db/ensure [:answer/validate]} {:db/id "answer-ec7b4503-619f-5a8e-b675-a2ab33c15ae1" :answer/id #uuid "ec7b4503-619f-5a8e-b675-a2ab33c15ae1" :answer/type :answer.type/math :answer/value "(-4,1)" :db/ensure [:answer/validate]} {:db/id "question-e09e1da8-e383-596f-bdbd-80147bb9fb19" :question/id #uuid "e09e1da8-e383-596f-bdbd-80147bb9fb19" :question/math-academy-id "q-108382" :question/problem "The point $P$ with coordinates $(-2,3)$ lies on the curve $y=f(x)+4.$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "**Method 1**\n\nThe graph of $y=f(x)$ is obtained by translating the graph of $y=f(x)+4$ by $4$ units *down.* \n\nHence, if the point $(-2,3)$ lies on $y=f(x)+4$, then the point \n\n$$\n(-2,3-4)=(-2,-1)\n$$\n\nlies on $y=f(x).$\n\n![](images/5f/5f74a8d57dc1766912c4490ab156d0f7f2ed0bbc9b4dbb9e53ae46c48ceb8bb5.png)\n\n**Method 2**\n\nAs $(-2,3)$ lies on $y=f(x)+4$, we have:\n\n$$\n\\begin{aligned}f(-2)+4 & =3 \\\\ f(-2) & =3-4 \\\\ f(-2) & =-1\\end{aligned}\n$$\n\nNow, if $x=-2$ then\n\n$$\n\\begin{aligned}y & =f(-2) \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the point $(-2,-1)$ must lie on $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d83fabbc-abe9-5f4d-98e0-63937e6bc2ee"] :db/ensure [:question/validate]} {:db/id "answer-field-d83fabbc-abe9-5f4d-98e0-63937e6bc2ee" :answer-field/id #uuid "d83fabbc-abe9-5f4d-98e0-63937e6bc2ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c9182da-26b4-50dd-b999-b06ea4f26402" :answer-field/choices ["answer-5c9182da-26b4-50dd-b999-b06ea4f26402" "answer-7c0a67dc-b1bb-53f1-a28d-e4de8f2a5cf6" "answer-218a5463-3916-500e-8478-33f18275f486" "answer-1846fb2f-d11a-5c6c-8a8b-c56637894b4c" "answer-4b9120fe-c1c3-53ef-a361-99b8cca626c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c9182da-26b4-50dd-b999-b06ea4f26402" :answer/id #uuid "5c9182da-26b4-50dd-b999-b06ea4f26402" :answer/type :answer.type/math :answer/value "(-2,-1)" :db/ensure [:answer/validate]} {:db/id "answer-7c0a67dc-b1bb-53f1-a28d-e4de8f2a5cf6" :answer/id #uuid "7c0a67dc-b1bb-53f1-a28d-e4de8f2a5cf6" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-218a5463-3916-500e-8478-33f18275f486" :answer/id #uuid "218a5463-3916-500e-8478-33f18275f486" :answer/type :answer.type/math :answer/value "(-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-1846fb2f-d11a-5c6c-8a8b-c56637894b4c" :answer/id #uuid "1846fb2f-d11a-5c6c-8a8b-c56637894b4c" :answer/type :answer.type/math :answer/value "(-2,5)" :db/ensure [:answer/validate]} {:db/id "answer-4b9120fe-c1c3-53ef-a361-99b8cca626c8" :answer/id #uuid "4b9120fe-c1c3-53ef-a361-99b8cca626c8" :answer/type :answer.type/math :answer/value "(-2,7)" :db/ensure [:answer/validate]} {:db/id 17592186101945 :tutorial/content "Suppose that we have the graph of $y=f(x)$ shown below. What would the graph of $y=f(x)+2$ look like, and how does it relate to the original curve?\n\n![](images/1a/1a55ebd7e9dc656f3a2488debf14e63e655ed7548b76f63c26498f09d96d65ca.png)\n\nFor each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x)+2$ with the same $x$-value and a $y$-value that is two units greater. So let's create a table of points.\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=f(x)+2[/math]} \\\\ (-2,0) & (-2,2) \\\\ (0,1.5) & (0,3.5) \\\\ (1,2) & (1,4) \\\\ (3,-3) & (3,-1)\\end{aligned}\n$$\n\nEvery point on the graph of $y=f(x)+2$ is precisely two units above a point on the graph of $y=f(x)$. The graph of $y=f(x)+2$ is an **upward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/66/6636d65acf9cd34d818d3d9e12a7b7de36dec4ceb70c7503a08751f971868855.png)\n\nOn the other hand, for each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x)-2$ with the same $x$-value and a $y$-value that is two units smaller. So let's create a table of points.\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=f(x)-2[/math]} \\\\ (-2,0) & (-2,-2) \\\\ (0,1.5) & (0,-0.5) \\\\ (1,2) & (1,0) \\\\ (3,-3) & (3,-5)\\end{aligned}\n$$\n\nEvery point on the graph of $y=f(x)-2$ is two units below a point on the graph of $y=f(x)$. The graph of $y=f(x)-2$ is a **downward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/72/72588aaa92f5b4bf9923c381cf5ad28ebb7288e77f6442549d0ffe1fdac3dc48.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186101972 :tutorial/content "Consider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+b$ shown below. What is the value of $b?$\n\n![](images/b0/b058da1ea31e45f3029f1542642d802a35da7280f315a37ea92044e5c322fbd4.png)\n\nThe graph of $y=f(x)+b$ can be obtained from the graph of $y=f(x)$ by translating it $6$ units down. So, $b=-6.$" :db/ensure [:tutorial/validate]} {:db/id 17592186101091 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186068913 :knowledge-point/questions ["question-ead518c9-914d-5e94-b01b-fb4224373ff4" "question-ecfb5c66-7387-5472-a64e-2ed6bd44ab74"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068525 :question/worked-solution "Remember that in general, the graph of $y=x^2+k$ looks like the standard parabola $y=x^2$ but translated $k$ units up. The vertex of $y=x^2+k$ is located at $(0,k).$\n\nHere, the curve shown is the parabola $y=x^2$ after being translated $3$ units upward. The vertex is located at $(0,3).$\n\nTherefore, $k=3,$ and the equation of the parabola is $y = x^2 +3.$" :db/ensure [:question/validate]} {:db/id 17592186068914 :knowledge-point/questions ["question-1f5ba24c-6238-510f-bebb-ee4c2a2d372a" "question-eae2df82-c842-5432-893d-0301f5c3e7e4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068526 :question/problem "Sketch the graph of the function $y=(x+3)^2.$ What are the coordinates of the minimum point?" :question/worked-solution "In general, the graph of $y=(x-h)^2$ looks like the standard parabola $y=x^2$ but translated $h$ units right. The vertex of $y=(x-h)^2$ is located at $(h,0).$\n\nIn the given function $y=(x+3)^2,$ we have $h=-3.$ To see this clearly, we can write the curve as follows:\n\n$$\n\\begin{aligned}y & =(x+3)^{2} \\\\ y & =(x-(-3))^{2}\\end{aligned}\n$$\n\nTherefore, the given curve is the parabola $y=x^2$ after being translated $3$ units *left*. \n\n![](images/bf/bffdacd979eaa77a7a64364840ab318bcc4a1c39ca78137146e82f37540e02e4.png)\n\nThe vertex is located at $(-3,0),$ and these are the coordinates of the minimum point." :db/ensure [:question/validate]} {:db/id 17592186068865 :knowledge-point/questions ["question-9521123b-d716-51bb-900f-b70ee495c687" "question-82cee2a3-9424-531b-bce3-49f1ee87bedc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068503 :question/problem "Identify the equation of the graph shown below. \n\n![](images/36/36a2a45f6078cdf04b798c39b6382c1f40411375a3f16ef77e996b39aa0009b3.png)" :question/worked-solution "Remember that the graph of $y=(x-h)^2+k$ is a translation of the standard parabola $y=x^2$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^2+k$ is located at $(h,k).$\n\nHere, the parabola is translated $2$ units *left*, so we have $h=-2.$ The parabola is also translated $1$ unit up, so we have $k=1.$ We can also see that the vertex is at $(-2,1),$ so again we must have $h=-2$ and $k=1.$\n\nTherefore, the equation of the graph is:\n\n$$\n\\begin{aligned}y & =(x-(-2))^{2}+1 \\\\ y & =(x+2)^{2}+1\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-ead518c9-914d-5e94-b01b-fb4224373ff4" :question/id #uuid "ead518c9-914d-5e94-b01b-fb4224373ff4" :question/math-academy-id "q-23258" :question/problem "What are the coordinates of the minimum point of the function $y={x}^{2}+5?$" :question/worked-solution "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nFor the given function $y={x}^{2}+5,$ we have $k=5.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $5$ units *up*. \n\n![](images/a9/a975d014ad92c31850e41367a2b5e46e85ab18a8a7e63bee81cd0f9b6af02bc0.png)\n\nThe vertex is located at $(0,5),$ and these are the coordinates of the minimum point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8f0470ce-876d-5058-978b-ef826cab49e2"] :db/ensure [:question/validate]} {:db/id "answer-field-8f0470ce-876d-5058-978b-ef826cab49e2" :answer-field/id #uuid "8f0470ce-876d-5058-978b-ef826cab49e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bf4cfb10-6075-5c79-bf1b-7a2b0de8150f" :answer-field/choices ["answer-7913f231-c176-5415-8b75-bd3c6926c042" "answer-d54f1427-b742-5cdb-b862-50d717e4396f" "answer-afd7218c-4e71-594c-8d0e-00f950f23e24" "answer-bf4cfb10-6075-5c79-bf1b-7a2b0de8150f" "answer-200a5054-afad-5419-87fd-fdd2e2f96547"] :db/ensure [:answer-field/validate]} {:db/id "answer-7913f231-c176-5415-8b75-bd3c6926c042" :answer/id #uuid "7913f231-c176-5415-8b75-bd3c6926c042" :answer/type :answer.type/math :answer/value "(-5,5)" :db/ensure [:answer/validate]} {:db/id "answer-d54f1427-b742-5cdb-b862-50d717e4396f" :answer/id #uuid "d54f1427-b742-5cdb-b862-50d717e4396f" :answer/type :answer.type/math :answer/value "(0,-5)" :db/ensure [:answer/validate]} {:db/id "answer-afd7218c-4e71-594c-8d0e-00f950f23e24" :answer/id #uuid "afd7218c-4e71-594c-8d0e-00f950f23e24" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-bf4cfb10-6075-5c79-bf1b-7a2b0de8150f" :answer/id #uuid "bf4cfb10-6075-5c79-bf1b-7a2b0de8150f" :answer/type :answer.type/math :answer/value "(0,5)" :db/ensure [:answer/validate]} {:db/id "answer-200a5054-afad-5419-87fd-fdd2e2f96547" :answer/id #uuid "200a5054-afad-5419-87fd-fdd2e2f96547" :answer/type :answer.type/math :answer/value "(5,5)" :db/ensure [:answer/validate]} {:db/id "question-ecfb5c66-7387-5472-a64e-2ed6bd44ab74" :question/id #uuid "ecfb5c66-7387-5472-a64e-2ed6bd44ab74" :question/math-academy-id "q-23288" :question/problem "What are the coordinates of the minimum point of the function $y={x}^{2}+3?$" :question/worked-solution "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nFor the given function $y={x}^{2}+3,$ we have $k=3.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $3$ units *up*. \n\n![](images/b6/b66bc0862b1a16cd71e846624903adea3f98a1b6d867a6516ec08cdee970518c.png)\n\nThe vertex is located at $(0,3),$ and these are the coordinates of the minimum point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55fa6879-8741-5f72-b069-3b5bcb6c94e3"] :db/ensure [:question/validate]} {:db/id "answer-field-55fa6879-8741-5f72-b069-3b5bcb6c94e3" :answer-field/id #uuid "55fa6879-8741-5f72-b069-3b5bcb6c94e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e90deef-05f5-54f7-b6b5-a60fc604504b" :answer-field/choices ["answer-7e0607f5-b7ec-52a4-9c8c-469e8fedb035" "answer-1e90deef-05f5-54f7-b6b5-a60fc604504b" "answer-5701fab9-499a-5946-b69f-96306b1dfa0f" "answer-626ab0bf-bf71-548e-8f43-c173efd8aa97" "answer-f98dac33-52cf-5943-99b4-fd381fbb7686"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e0607f5-b7ec-52a4-9c8c-469e8fedb035" :answer/id #uuid "7e0607f5-b7ec-52a4-9c8c-469e8fedb035" :answer/type :answer.type/math :answer/value "(-3,3)" :db/ensure [:answer/validate]} {:db/id "answer-1e90deef-05f5-54f7-b6b5-a60fc604504b" :answer/id #uuid "1e90deef-05f5-54f7-b6b5-a60fc604504b" :answer/type :answer.type/math :answer/value "(0,3)" :db/ensure [:answer/validate]} {:db/id "answer-5701fab9-499a-5946-b69f-96306b1dfa0f" :answer/id #uuid "5701fab9-499a-5946-b69f-96306b1dfa0f" :answer/type :answer.type/math :answer/value "(1,-3)" :db/ensure [:answer/validate]} {:db/id "answer-626ab0bf-bf71-548e-8f43-c173efd8aa97" :answer/id #uuid "626ab0bf-bf71-548e-8f43-c173efd8aa97" :answer/type :answer.type/math :answer/value "(3,-3)" :db/ensure [:answer/validate]} {:db/id "answer-f98dac33-52cf-5943-99b4-fd381fbb7686" :answer/id #uuid "f98dac33-52cf-5943-99b4-fd381fbb7686" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "question-1f5ba24c-6238-510f-bebb-ee4c2a2d372a" :question/id #uuid "1f5ba24c-6238-510f-bebb-ee4c2a2d372a" :question/math-academy-id "q-105994" :question/problem "What are the coordinates of the minimum point of the function $y=(x-2)^{2}?$" :question/worked-solution "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nFor the given function $y=(x-2)^{2},$ we have $h=2.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $2$ units *right*. \n\n![](images/ae/aed4cce9a698952f9d24e386249c88023d4e56a353f2d7e0c6b75f3bec0cdf4d.png)\n\nThe vertex is located at $(2,0),$ and these are the coordinates of the minimum point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-25ef076e-0dd6-55ee-9768-7795df4ec394"] :db/ensure [:question/validate]} {:db/id "answer-field-25ef076e-0dd6-55ee-9768-7795df4ec394" :answer-field/id #uuid "25ef076e-0dd6-55ee-9768-7795df4ec394" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-754e42d5-00b8-5220-ac8f-4211ab364e6c" :answer-field/choices ["answer-c440783e-0d16-53b5-9063-c5d7f787f510" "answer-ea6f426e-8e62-5aa5-bc0d-861124834bb5" "answer-f14f1ac2-c498-5d46-a0e2-2fb7f8c23574" "answer-c4dc8e79-ffa4-5828-8957-7b048c0b06c3" "answer-754e42d5-00b8-5220-ac8f-4211ab364e6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-c440783e-0d16-53b5-9063-c5d7f787f510" :answer/id #uuid "c440783e-0d16-53b5-9063-c5d7f787f510" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-ea6f426e-8e62-5aa5-bc0d-861124834bb5" :answer/id #uuid "ea6f426e-8e62-5aa5-bc0d-861124834bb5" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "answer-f14f1ac2-c498-5d46-a0e2-2fb7f8c23574" :answer/id #uuid "f14f1ac2-c498-5d46-a0e2-2fb7f8c23574" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "answer-c4dc8e79-ffa4-5828-8957-7b048c0b06c3" :answer/id #uuid "c4dc8e79-ffa4-5828-8957-7b048c0b06c3" :answer/type :answer.type/math :answer/value "(2,-2)" :db/ensure [:answer/validate]} {:db/id "answer-754e42d5-00b8-5220-ac8f-4211ab364e6c" :answer/id #uuid "754e42d5-00b8-5220-ac8f-4211ab364e6c" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "question-eae2df82-c842-5432-893d-0301f5c3e7e4" :question/id #uuid "eae2df82-c842-5432-893d-0301f5c3e7e4" :question/math-academy-id "q-105999" :question/problem "![](images/60/60d4ffad53a01f24e99b838e057b73f270cc41771db7f0718bcf731909182908.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nHere, the curve shown is the parabola $y={x}^{2}$ after being translated $8$ units *right*. The vertex is located at $(8,0).$\n\nTherefore, $h=8,$ and the equation of the parabola is \n\n$$\n\\begin{aligned}y & =(x-8)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-03c1928f-244c-5d0e-ad94-8ab9e7bb47aa"] :db/ensure [:question/validate]} {:db/id "answer-field-03c1928f-244c-5d0e-ad94-8ab9e7bb47aa" :answer-field/id #uuid "03c1928f-244c-5d0e-ad94-8ab9e7bb47aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7bb9a773-d7bd-59a6-b607-d8a6634d4161" :answer-field/choices ["answer-64709e0b-f9bb-56d8-a87a-158dc54e0b30" "answer-7bb9a773-d7bd-59a6-b607-d8a6634d4161" "answer-406deb7b-69c7-5514-905f-0ef30ee8018f" "answer-7e496c3a-2275-5a92-b2e1-3f137a64a2fb" "answer-dd78595f-99f2-5055-b3b0-107db697bd51"] :db/ensure [:answer-field/validate]} {:db/id "answer-64709e0b-f9bb-56d8-a87a-158dc54e0b30" :answer/id #uuid "64709e0b-f9bb-56d8-a87a-158dc54e0b30" :answer/type :answer.type/math :answer/value "y=(x+8)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-7bb9a773-d7bd-59a6-b607-d8a6634d4161" :answer/id #uuid "7bb9a773-d7bd-59a6-b607-d8a6634d4161" :answer/type :answer.type/math :answer/value "y=(x-8)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-406deb7b-69c7-5514-905f-0ef30ee8018f" :answer/id #uuid "406deb7b-69c7-5514-905f-0ef30ee8018f" :answer/type :answer.type/math :answer/value "y=8{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-7e496c3a-2275-5a92-b2e1-3f137a64a2fb" :answer/id #uuid "7e496c3a-2275-5a92-b2e1-3f137a64a2fb" :answer/type :answer.type/math :answer/value "y={x}^{2}+8" :db/ensure [:answer/validate]} {:db/id "answer-dd78595f-99f2-5055-b3b0-107db697bd51" :answer/id #uuid "dd78595f-99f2-5055-b3b0-107db697bd51" :answer/type :answer.type/math :answer/value "y={x}^{2}-8" :db/ensure [:answer/validate]} {:db/id "question-9521123b-d716-51bb-900f-b70ee495c687" :question/id #uuid "9521123b-d716-51bb-900f-b70ee495c687" :question/math-academy-id "q-106003" :question/problem "What are the coordinates of the minimum point of the function $y=(x+2)^{2}+5?$" :question/worked-solution "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $2$ units *left*, so we have $h=-2.$ The parabola is also translated $5$ units *up*, so we have $k=5.$ \n\n![](images/8e/8e69ca48e852176d2ed258f062995835889374975492873fe0863ea782d87ebd.png)\n\nThe vertex is located at $(-2,5),$ and these are the coordinates of the minimum point." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3b305b97-627e-50ef-840c-8f184a04d4bd"] :db/ensure [:question/validate]} {:db/id "answer-field-3b305b97-627e-50ef-840c-8f184a04d4bd" :answer-field/id #uuid "3b305b97-627e-50ef-840c-8f184a04d4bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f65c646e-ad0e-5ac8-b385-704fe5f98263" :answer-field/choices ["answer-e6d480e5-47f5-5cc0-9365-85785634b243" "answer-f65c646e-ad0e-5ac8-b385-704fe5f98263" "answer-ecbeb427-f247-5d4a-afbe-21dbcab489cf" "answer-952e9ff5-0586-50d4-9a8d-748cbb94f2c0" "answer-3c31527b-b7bb-56c0-ae70-dc74a4214f25"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6d480e5-47f5-5cc0-9365-85785634b243" :answer/id #uuid "e6d480e5-47f5-5cc0-9365-85785634b243" :answer/type :answer.type/math :answer/value "(-2,-5)" :db/ensure [:answer/validate]} {:db/id "answer-f65c646e-ad0e-5ac8-b385-704fe5f98263" :answer/id #uuid "f65c646e-ad0e-5ac8-b385-704fe5f98263" :answer/type :answer.type/math :answer/value "(-2,5)" :db/ensure [:answer/validate]} {:db/id "answer-ecbeb427-f247-5d4a-afbe-21dbcab489cf" :answer/id #uuid "ecbeb427-f247-5d4a-afbe-21dbcab489cf" :answer/type :answer.type/math :answer/value "(-5,-2)" :db/ensure [:answer/validate]} {:db/id "answer-952e9ff5-0586-50d4-9a8d-748cbb94f2c0" :answer/id #uuid "952e9ff5-0586-50d4-9a8d-748cbb94f2c0" :answer/type :answer.type/math :answer/value "(2,5)" :db/ensure [:answer/validate]} {:db/id "answer-3c31527b-b7bb-56c0-ae70-dc74a4214f25" :answer/id #uuid "3c31527b-b7bb-56c0-ae70-dc74a4214f25" :answer/type :answer.type/math :answer/value "(5,2)" :db/ensure [:answer/validate]} {:db/id "question-82cee2a3-9424-531b-bce3-49f1ee87bedc" :question/id #uuid "82cee2a3-9424-531b-bce3-49f1ee87bedc" :question/math-academy-id "q-23089" :question/problem "Which of the following is the graph of the function $y=(x-2)^{2}+2?$" :question/worked-solution "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $2$ units *right*, so we have $h=2.$ The parabola is also translated $2$ units *up*, so we have $k=2.$ \n\n![](images/4e/4e43c68bd7ab2da6fb0be21ecc69ab29e111c442219caaae70b819e9df3488be.png)\n\nThe vertex is located at $(2,2),$ and these are the coordinates of the minimum point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d31978c6-bceb-5325-aea8-c4dcaee83acf"] :db/ensure [:question/validate]} {:db/id "answer-field-d31978c6-bceb-5325-aea8-c4dcaee83acf" :answer-field/id #uuid "d31978c6-bceb-5325-aea8-c4dcaee83acf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29128bb6-698e-5f80-b2d5-1fcc609cce2e" :answer-field/choices ["answer-9b46fcef-4a09-54d0-bb34-c44b26d14ef0" "answer-29128bb6-698e-5f80-b2d5-1fcc609cce2e" "answer-c7a8fd16-dc61-55e3-965a-7b6d954cc4b3" "answer-04cf61b8-04db-5f45-abb5-90fdc5ad1da5" "answer-af3ac06e-20d5-5b0d-8ed2-f6ae178a5871"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b46fcef-4a09-54d0-bb34-c44b26d14ef0" :answer/id #uuid "9b46fcef-4a09-54d0-bb34-c44b26d14ef0" :answer/type :answer.type/image :answer/value "images/1d/1d3505d032f9e3281f1686fc2816ceef71c97f1f886e6b720217481815d8e9ad.png" :db/ensure [:answer/validate]} {:db/id "answer-29128bb6-698e-5f80-b2d5-1fcc609cce2e" :answer/id #uuid "29128bb6-698e-5f80-b2d5-1fcc609cce2e" :answer/type :answer.type/image :answer/value "images/4e/4e43c68bd7ab2da6fb0be21ecc69ab29e111c442219caaae70b819e9df3488be.png" :db/ensure [:answer/validate]} {:db/id "answer-c7a8fd16-dc61-55e3-965a-7b6d954cc4b3" :answer/id #uuid "c7a8fd16-dc61-55e3-965a-7b6d954cc4b3" :answer/type :answer.type/image :answer/value "images/67/67cffd6bf1285b40c69a58b2571d7f396cd4df34d9d7ac71925ce5b6ecc8a633.png" :db/ensure [:answer/validate]} {:db/id "answer-04cf61b8-04db-5f45-abb5-90fdc5ad1da5" :answer/id #uuid "04cf61b8-04db-5f45-abb5-90fdc5ad1da5" :answer/type :answer.type/image :answer/value "images/a5/a5313544206d95a45b695bfeb6bc05ced0c113fe0e64760de3c8b9f618aa3749.png" :db/ensure [:answer/validate]} {:db/id "answer-af3ac06e-20d5-5b0d-8ed2-f6ae178a5871" :answer/id #uuid "af3ac06e-20d5-5b0d-8ed2-f6ae178a5871" :answer/type :answer.type/image :answer/value "images/d4/d46be7b4202aecdd112ffac222098e4f50f63d637c3358f122ce66598be69a88.png" :db/ensure [:answer/validate]} {:db/id 17592186069949 :tutorial/content "Suppose that we want to plot the curve $y=x^2.$ We start by making a table of values.\n\n| **$x$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $y=x^2$ | $9$ | $4$ | $1$ | $0$ | $1$ | $4$ | $9$ |\n\nWe can now plot the graph using the $(x,y)$ values in our table.\n\n![](images/57/576148f61e683e58c508b212221c103d9ef9914f549afabfec92a04ec778a268.png)\n\nThis curve's shape is known as a **parabola**, and the **minimum point** at $(0,0)$ is known as the **vertex** of the parabola." :db/ensure [:tutorial/validate]} {:db/id 17592186069980 :tutorial/content "Adding a value to ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) will **translate** (shift) the parabola up or down the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis. For instance, adding ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) to ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) will move each point on the parabola ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units up.\n\n![](images/2a/2a233fc5fe21dd3ffd460ab3fa343ac3c4587bca17fd958343309bc723a2cda5.png)\n\nOn the other hand, subtracting ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) will move each point of the parabola ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) units down.\n\n![](images/5b/5bcc36e857503b3faf90d1cbb58750150dc7849a0f2a0b3c58b77319ffff1224.png)\n\nIn general, the graph of ![](images/00/00abc9adb93347077819fc66fecc1e7eef09e68fc6f8e94a76e27c8eb70b13a0.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) but translated ![](images/8d/8dc6f7e80ecaac9fa07890ce1881dd51de319597ae8b1dce821aa03c1f3eff06.svg) units up. The vertex of ![](images/00/00abc9adb93347077819fc66fecc1e7eef09e68fc6f8e94a76e27c8eb70b13a0.svg) is located at ![](images/e8/e8c4c8598a8228afb25cbf13c034e2fe234393f9b9c0dfde8be1726b4fc79a8e.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186069953 :tutorial/content "The graph of  ![](images/78/7816c015ff36e92e579c157d0d1e074270678c48b06f0c2d37d920311224d5e5.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg), but shifted ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) units to the *right* along the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-axis. \n\n![](images/a4/a48db73aadd4192f244676c3cb54c6849ca284acf1adbf29d6245baa5a07afcb.png)\n\nSimilarly, the graph of ![](images/ce/ce16aa1f1cc35aaeae8aba5c19c0ebf1e9ea43e9624f0c6c18b42f7bfa21c304.svg) looks like the standard ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) parabola after it's been shifted ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units to the *left*:\n\n![](images/9c/9c33ae042e23cee23f96a35f31afbb3f80fb1dfece702b26c2a1aded17885861.png)\n\nIn general, the graph of ![](images/4b/4b00aba256457d4efcd4f517482795d922665890adf0c2f0c0991527b5c1edfb.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) but translated ![](images/99/994427fe929fdf538d7c1be792e6fa4b85697f0921161bf5ddf0e639864c9f27.svg) units right. The vertex of ![](images/4b/4b00aba256457d4efcd4f517482795d922665890adf0c2f0c0991527b5c1edfb.svg) is located at ![](images/ef/efb3fb22e5e729a56d75a55b8e4b43e7ebf0cb77a3798550afdf9e05ac3a1525.svg)\n\n**Watch Out!** It's easy to confuse the translations.\n\n- For ![](images/78/7816c015ff36e92e579c157d0d1e074270678c48b06f0c2d37d920311224d5e5.svg), we subtract ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) from ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) inside the parentheses, and the parabola moves to the right, *not* to the left (even though it seems like it should be the other way around).\n\n- Likewise, for ![](images/ce/ce16aa1f1cc35aaeae8aba5c19c0ebf1e9ea43e9624f0c6c18b42f7bfa21c304.svg), we add ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) to ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) inside the parentheses, and the parabola moves to the left, *not* to the right." :db/ensure [:tutorial/validate]} {:db/id 17592186069952 :tutorial/content "Horizontal and vertical translations can be combined. It does not matter which we do first.\n\nIn general, the graph of $y=(x-h)^2+k$ is a translation of the standard parabola $y=x^2$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^2+k$ is located at $(h,k).$" :db/ensure [:tutorial/validate]} {:db/id 17592186068980 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186065517 :answer-field/choices 17592186065520] [:db/retract 17592186065517 :answer-field/choices 17592186065521] [:db/retract 17592186065517 :answer-field/choices 17592186065522] [:db/retract 17592186065517 :answer-field/choices 17592186065518] [:db/retract 17592186065517 :answer-field/choices 17592186065519] [:db/retract 17592186066075 :answer-field/choices 17592186066080] [:db/retract 17592186066075 :answer-field/choices 17592186066076] [:db/retract 17592186066075 :answer-field/choices 17592186066077] [:db/retract 17592186066075 :answer-field/choices 17592186066078] [:db/retract 17592186066075 :answer-field/choices 17592186066079] [:db/retract 17592186066736 :answer-field/choices 17592186066737] [:db/retract 17592186066736 :answer-field/choices 17592186066738] [:db/retract 17592186066736 :answer-field/choices 17592186066739] [:db/retract 17592186066736 :answer-field/choices 17592186066740] [:db/retract 17592186066736 :answer-field/choices 17592186066741] [:db/retract 17592186065523 :answer-field/choices 17592186065524] [:db/retract 17592186065523 :answer-field/choices 17592186065525] [:db/retract 17592186065523 :answer-field/choices 17592186065527] [:db/retract 17592186065523 :answer-field/choices 17592186065528] [:db/retract 17592186065529 :answer-field/choices 17592186065530] [:db/retract 17592186065529 :answer-field/choices 17592186065531] [:db/retract 17592186065529 :answer-field/choices 17592186065532] [:db/retract 17592186065529 :answer-field/choices 17592186065533] [:db/retract 17592186065529 :answer-field/choices 17592186065534] {:db/id 17592186068802 :knowledge-point/questions ["question-abb34aa3-eece-5767-8c0d-162486a46e00" "question-89b9341d-d36f-5db4-a196-956e022f6dd9" "question-de3cc4c9-f0a7-5d21-89e4-4f5e7276aeec" "question-8f211adc-046d-5c01-ba2b-26f9e0e2be96"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068645 :question/problem "![](images/f6/f6ee4ef4870da694c0ef56cf7395012c9ea1edbe4bc31247d9cdc7b26186b7db.png)\n\nConsider the region bounded by $y=\\sqrt{x}$ and $y=x^3,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi$ radians about the $x$-axis." :question/worked-solution "Let $f(x)=\\sqrt{x}$ and $g(x)=x^3.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x\\mathbin{:}$ \n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ \\sqrt{x} & ={x}^{3} \\\\ x & ={x}^{6} \\\\ {x}^{6}-x & =0 \\\\ x({x}^{5}-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/2a/2abe3a274ab5afee2bc0a85c48c2f1218620b86354c3c4e6e4dd8758ca1af5e5.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)=x^3,$ and\n\n- *leaves* through the outer function $y=f(x)=\\sqrt{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{x}]}^{2}-{[{x}^{3}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(x-{x}^{6})\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068775 :knowledge-point/questions ["question-a5df2e25-639b-5613-82c1-85dbfc89566d" "question-17abd4d5-764f-50c1-82c3-4fcec4b8a574" "question-61a0b761-b748-5011-958d-51f405f814ac"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068617 :question/problem "![](images/73/7373418f2a0bac416e37662cea5a79101220820aa6f23c50a80fbf6addc5eefd.png)\n\nConsider the finite region bounded by $y=x^2$ and $y=x^5,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis." :question/worked-solution "Let $f(x)=x^2$ and $g(x)=x^5.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ {x}^{2} & ={x}^{5} \\\\ {x}^{5}-{x}^{2} & =0 \\\\ {x}^{2}({x}^{3}-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/e4/e41991c460504023c4086aa0070904f20d88304aecd42a293c4b0422132b40e0.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)=x^5,$ and\n\n- *leaves* through the outer function $y=f(x)=x^2.$\n\nTherefore, the volume is given by\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}({[\\text{outer}]}^{2}-{[\\text{inner}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[{x}^{2}]}^{2}-{[{x}^{5}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({x}^{4}-{x}^{10})\\text{d}x \\\\  & =\\pi {(\\frac{{x}^{5}}{5}-\\frac{{x}^{11}}{11})|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{5}-\\frac{1}{11})-0] \\\\  & =\\frac{6\\pi }{55}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068803 :knowledge-point/questions ["question-f666ceb4-bd3b-5b00-9ee5-dd4ca3fe5f6b" "question-0bef34f9-b7a4-5afd-919c-8a8bc54bd07d" "question-0b6da66a-d01e-54fd-b6f1-7c1c4b4f3048" "question-d84428ea-0ba4-5227-96d6-43b34422e545" "question-3d1bfa1c-c252-5832-a4ec-b38acfcd7492"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068646 :question/problem "![](images/97/97ead66fca615e8f9325d445ca14a8478a276e6dc8d2878a2fd5dbea5d880f7a.png)\n\nConsider the finite region bounded by $y=x^3$ and $x=y,$ where $y \\leq 0,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi$ radians about the $y$-axis." :question/worked-solution "Writing our first function in terms of $y,$ we get \n\n$$\n\\begin{aligned}y={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}.\\end{aligned}\n$$\n\nLet $f(y)=\\sqrt[3]{y}$ and $g(y)=y.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ \\sqrt[3]{y} & =y \\\\ y & ={y}^{3} \\\\ {y}^{3}-y & =0 \\\\ y({y}^{2}-1) & =0\\end{aligned}\n$$\n\nHence $y=0$ and $y=\\pm 1.$ But, since $y \\leq 0,$ the limits of integration are from $y=0$ to $y=-1.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/1a/1ab4ce88964c1a4ce12fdfb93b77810b675bc18e656060629c3544eea47129b2.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=y,$ and\n\n- *leaves* through the outer function $x=f(y)=\\sqrt[3]{y}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}({[\\sqrt[3]{y}]}^{2}-{[y]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}(\\sqrt[3]{{y}^{2}}-{y}^{2})\\text{d}y.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068776 :knowledge-point/questions ["question-bb5bb053-af9b-561d-bd9f-9db0ee360eaf" "question-4870784d-cfa2-5882-86d4-3e6f72784ac7" "question-10f20a34-5dca-5f03-b661-36330ae0c9f9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068618 :question/problem "![](images/cd/cd7319762569fbab0e64f03719b41af9dfb45d07aac073a534ea68f842b1ce99.png)\n\nConsider the region bounded by $x=\\sqrt{4-y^2},$ $x=1,$ and the horizontal lines $y=-1$ and $y=1,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $y$-axis." :question/worked-solution "Let $f(y)=\\sqrt{4-y^2}\\,$ and $g(y)=1.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/7f/7f875c024b25c37c434a82a4320b4927bde85dc8f0ada3b35837330f829b23c7.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=1,$ and\n\n- *leaves* through the outer function $x=f(y)=\\sqrt{4-y^2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{c}^{d}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}({[\\sqrt{4-{y}^{2}}]}^{2}-{1}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(3-{y}^{2})\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}(3-{y}^{2})\\text{d}y \\\\  & =2\\pi (3y-\\frac{{y}^{3}}{3}){|}_{0}^{1} \\\\  & =2\\pi (3-\\frac{1}{3}-0) \\\\  & =\\frac{16\\pi }{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-abb34aa3-eece-5767-8c0d-162486a46e00" :question/id #uuid "abb34aa3-eece-5767-8c0d-162486a46e00" :question/math-academy-id "q-50227" :question/problem "![](images/37/37bf4ff4ad6eb63c9bf51bc5fd188ddc0f5bd58bfd4a097617f56fb5de151300.png)\n\nConsider the finite region bounded by $y={x}^{3}$ and $y=x$ where $x\\ge 0,$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "Let $f(x)={x}^{3}$ and $g(x)=x.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$ \n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ {x}^{3} & =x \\\\ {x}^{3}-x & =0 \\\\ x({x}^{2}-1) & =0\\end{aligned}\n$$\n\nHence $x=0$ and $x=\\pm 1.$ But, since $x\\ge 0,$ the limits of integration are from $x=0$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/f8/f8850008be348bd78f48837def8691d3a4155e70d13909369c70da2eb31fffb4.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=f(x)={x}^{3},$ and\n\n- *leaves* through the outer function $y=g(x)=x.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[x]}^{2}-{[{x}^{3}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({x}^{2}-{x}^{6})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f148f577-f7bb-5169-8125-f796d9a90542"] :db/ensure [:question/validate]} {:db/id "answer-field-f148f577-f7bb-5169-8125-f796d9a90542" :answer-field/id #uuid "f148f577-f7bb-5169-8125-f796d9a90542" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-997c8b34-acb8-5d51-b0ae-736b81777bc1" :answer-field/choices ["answer-cdeb4b38-6351-5631-8b83-3929e2d6da84" "answer-eac52d03-8f6a-50d0-8ebf-326eb11bfb8d" "answer-997c8b34-acb8-5d51-b0ae-736b81777bc1" "answer-cbd2a9c4-8368-5788-ae30-4f5d3035458d" "answer-d1e5c7c0-9172-51b5-89ba-14cbe12807a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-cdeb4b38-6351-5631-8b83-3929e2d6da84" :answer/id #uuid "cdeb4b38-6351-5631-8b83-3929e2d6da84" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}({x}^{2}-{x}^{6})\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-eac52d03-8f6a-50d0-8ebf-326eb11bfb8d" :answer/id #uuid "eac52d03-8f6a-50d0-8ebf-326eb11bfb8d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}{(x-{x}^{3})}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-997c8b34-acb8-5d51-b0ae-736b81777bc1" :answer/id #uuid "997c8b34-acb8-5d51-b0ae-736b81777bc1" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({x}^{2}-{x}^{6})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-cbd2a9c4-8368-5788-ae30-4f5d3035458d" :answer/id #uuid "cbd2a9c4-8368-5788-ae30-4f5d3035458d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}{(x-{x}^{3})}^{2}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-d1e5c7c0-9172-51b5-89ba-14cbe12807a9" :answer/id #uuid "d1e5c7c0-9172-51b5-89ba-14cbe12807a9" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}{x}^{6}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-89b9341d-d36f-5db4-a196-956e022f6dd9" :question/id #uuid "89b9341d-d36f-5db4-a196-956e022f6dd9" :question/math-academy-id "q-86118" :question/problem "Consider the finite region bounded by $y=2-x$ and $y=4-{x}^{2}.$ Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "Let $f(x)=2-x$ and $g(x)=4-{x}^{2}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2-x & =4-{x}^{2} \\\\ {x}^{2}-x-2 & =0 \\\\ (x+1)(x-2) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-1$ to $x=2.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/ce/ce74cc02284807691e00fc59d00240520d392cdc01b8efafcd66518d717a607e.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)=2-x,$ and\n\n- *leaves* through the outer function $y=f(x)=4-{x}^{2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}({[4-{x}^{2}]}^{2}-{[2-x]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}({x}^{4}-9{x}^{2}+4x+12)\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-133f90f1-eeb0-5270-b7c6-2666bad917ef"] :db/ensure [:question/validate]} {:db/id "answer-field-133f90f1-eeb0-5270-b7c6-2666bad917ef" :answer-field/id #uuid "133f90f1-eeb0-5270-b7c6-2666bad917ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1c6907c7-0e08-5c4c-ab9a-a8400cdb535f" :answer-field/choices ["answer-bda440f4-5406-5b24-ab61-10164ddee7b6" "answer-5b71884b-5002-5915-86da-70993ec5a763" "answer-ad1f70b4-5f05-5a8a-abb1-ca42c8b73e11" "answer-1c6907c7-0e08-5c4c-ab9a-a8400cdb535f" "answer-0ce5f341-ccad-58e7-a3c7-e873e1465618"] :db/ensure [:answer-field/validate]} {:db/id "answer-bda440f4-5406-5b24-ab61-10164ddee7b6" :answer/id #uuid "bda440f4-5406-5b24-ab61-10164ddee7b6" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{0}({x}^{4}-9{x}^{2}+2)\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-5b71884b-5002-5915-86da-70993ec5a763" :answer/id #uuid "5b71884b-5002-5915-86da-70993ec5a763" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({x}^{4}-4{x}^{2}+12x-1)\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ad1f70b4-5f05-5a8a-abb1-ca42c8b73e11" :answer/id #uuid "ad1f70b4-5f05-5a8a-abb1-ca42c8b73e11" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({x}^{4}-9{x}^{2}+12)\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-1c6907c7-0e08-5c4c-ab9a-a8400cdb535f" :answer/id #uuid "1c6907c7-0e08-5c4c-ab9a-a8400cdb535f" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({x}^{4}-9{x}^{2}+4x+12)\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-0ce5f341-ccad-58e7-a3c7-e873e1465618" :answer/id #uuid "0ce5f341-ccad-58e7-a3c7-e873e1465618" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({x}^{4}+4x+12)\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186069014 :question/problem "![](images/4e/4eaf3eac9364aca72506f0d11c7d69332bbf853871d85986e45bd3082a607354.png)\n\nConsider the region bounded by $y=1-{x}^{2}$ and $y={x}^{2}-2x+1,$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "Let $f(x)=1-{x}^{2}$ and $g(x)={x}^{2}-2x+1.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$ \n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 1-{x}^{2} & ={x}^{2}-2x+1 \\\\ 2{x}^{2}-2x & =0 \\\\ x(x-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/3f/3fc8d26f99a0b640983b047af4e201fe5f8164c9d6ebc7f5bd234ae706fed796.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{2}-2x+1,$ and\n\n- *leaves* through the outer function $y=f(x)=1-{x}^{2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[1-{x}^{2}]}^{2}-{[{x}^{2}-2x+1]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[\\text{ }1-{x}^{2}]}^{2}-{[1-x]}^{4})\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186065517 :answer-field/correct "answer-6a378802-e8e4-51be-812e-eb9a47f10ca2" :answer-field/choices ["answer-e54a3c9d-8021-57cd-9c71-2255dbcd5636" "answer-6a378802-e8e4-51be-812e-eb9a47f10ca2" "answer-9aa36682-202b-5619-8b29-8025bcc92764" "answer-bf9361ee-93d2-5d97-bec7-8dc5e66297ff" "answer-3b824624-e1cb-5f67-82d4-a6a1bb43b515"] :db/ensure [:answer-field/validate]} {:db/id "answer-e54a3c9d-8021-57cd-9c71-2255dbcd5636" :answer/id #uuid "e54a3c9d-8021-57cd-9c71-2255dbcd5636" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({[1-x]}^{4}-{[\\text{ }1-{x}^{2}]}^{2})\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-6a378802-e8e4-51be-812e-eb9a47f10ca2" :answer/id #uuid "6a378802-e8e4-51be-812e-eb9a47f10ca2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({[\\text{ }1-{x}^{2}]}^{2}-{[1-x]}^{4})\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-9aa36682-202b-5619-8b29-8025bcc92764" :answer/id #uuid "9aa36682-202b-5619-8b29-8025bcc92764" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}{(1-x)}^{2}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-bf9361ee-93d2-5d97-bec7-8dc5e66297ff" :answer/id #uuid "bf9361ee-93d2-5d97-bec7-8dc5e66297ff" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}({[\\text{ }1-{x}^{2}]}^{2}-{[1-x]}^{2})\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-3b824624-e1cb-5f67-82d4-a6a1bb43b515" :answer/id #uuid "3b824624-e1cb-5f67-82d4-a6a1bb43b515" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{(1-x)}^{4}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-de3cc4c9-f0a7-5d21-89e4-4f5e7276aeec" :question/id #uuid "de3cc4c9-f0a7-5d21-89e4-4f5e7276aeec" :question/math-academy-id "q-86111" :question/problem "Consider the finite region bounded by $y=8x$ and $y={x}^{4}.$ Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "Let $f(x)=8x$ and $g(x)={x}^{4}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 8x & ={x}^{4} \\\\ {x}^{4}-8x & =0 \\\\ x({x}^{3}-8) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=2.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/ac/ac3248f7ada22b91c42971a0a85692625321cafa82ced12215671435ab584d00.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{4},$ and\n\n- *leaves* through the outer function $y=f(x)=8x.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{2}({[8x]}^{2}-{[{x}^{4}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{2}(64{x}^{2}-{x}^{8})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-14fbe87c-693f-54c6-b758-8a05c9ef6642"] :db/ensure [:question/validate]} {:db/id "answer-field-14fbe87c-693f-54c6-b758-8a05c9ef6642" :answer-field/id #uuid "14fbe87c-693f-54c6-b758-8a05c9ef6642" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-81d15c1d-e7f1-54d0-a40c-3b475025c5dd" :answer-field/choices ["answer-9f0118b8-bbf7-5150-a7c4-acdba0b36009" "answer-81d15c1d-e7f1-54d0-a40c-3b475025c5dd" "answer-75946804-66ca-5423-99e7-7c2f6c1fe690" "answer-cedcb368-116f-5423-9a88-50b3d7afd4d6" "answer-b0a5d8da-aae6-5343-924a-f1c245defe94"] :db/ensure [:answer-field/validate]} {:db/id "answer-9f0118b8-bbf7-5150-a7c4-acdba0b36009" :answer/id #uuid "9f0118b8-bbf7-5150-a7c4-acdba0b36009" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(4{x}^{2}-{x}^{8})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-81d15c1d-e7f1-54d0-a40c-3b475025c5dd" :answer/id #uuid "81d15c1d-e7f1-54d0-a40c-3b475025c5dd" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(64{x}^{2}-{x}^{8})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-75946804-66ca-5423-99e7-7c2f6c1fe690" :answer/id #uuid "75946804-66ca-5423-99e7-7c2f6c1fe690" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(6{x}^{2}-{x}^{6})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-cedcb368-116f-5423-9a88-50b3d7afd4d6" :answer/id #uuid "cedcb368-116f-5423-9a88-50b3d7afd4d6" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{4}(64{x}^{2}-{x}^{8})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b0a5d8da-aae6-5343-924a-f1c245defe94" :answer/id #uuid "b0a5d8da-aae6-5343-924a-f1c245defe94" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{\\sqrt{2}}(64{x}^{3}-{x}^{9})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-8f211adc-046d-5c01-ba2b-26f9e0e2be96" :question/id #uuid "8f211adc-046d-5c01-ba2b-26f9e0e2be96" :question/math-academy-id "q-122004" :question/problem "![](images/9c/9c5d2e2426a817b62f8cd834d7d31786c5f2dfd52a7b784fd0bf337abed6c4fc.png)\n\nConsider the region bounded by $y={e}^{2-x}$ and $y={e}^{{x}^{2}},$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "Let $f(x)={e}^{2-x}$ and $g(x)={e}^{{x}^{2}}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$ \n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ {e}^{2-x} & ={e}^{{x}^{2}} \\\\ 2-x & ={x}^{2} \\\\ 0 & ={x}^{2}+x-2 \\\\ (x+2)(x-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-2$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/8a/8a7f49165698bdac791a31a058c3228e6e2beab9f5ee9393971aa0e9aecd27b8.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={e}^{{x}^{2}},$ and\n\n- *leaves* through the outer function $y=f(x)={e}^{2-x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1}({[{e}^{2-x}]}^{2}-{[{e}^{{x}^{2}}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1}({e}^{4-2x}-{e}^{2{x}^{2}})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-114213cb-ff5a-5f09-8a9a-c11e6cbf3545"] :db/ensure [:question/validate]} {:db/id "answer-field-114213cb-ff5a-5f09-8a9a-c11e6cbf3545" :answer-field/id #uuid "114213cb-ff5a-5f09-8a9a-c11e6cbf3545" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8627ef67-ddb2-57f6-bf5f-dfecb65a8067" :answer-field/choices ["answer-a6ef96a4-129c-5753-ac25-dc9fa916032a" "answer-d14478ca-4070-5ce9-90a8-172b823c4e8c" "answer-5a9f8c59-1dc9-5e0d-8c2f-687618e26ae2" "answer-8627ef67-ddb2-57f6-bf5f-dfecb65a8067" "answer-5843c213-01a6-5e2b-9bc8-4fd5d86dbaad"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6ef96a4-129c-5753-ac25-dc9fa916032a" :answer/id #uuid "a6ef96a4-129c-5753-ac25-dc9fa916032a" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{2{x}^{2}}-{e}^{4-2x})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-d14478ca-4070-5ce9-90a8-172b823c4e8c" :answer/id #uuid "d14478ca-4070-5ce9-90a8-172b823c4e8c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{4-2x}-{e}^{2{x}^{2}})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-5a9f8c59-1dc9-5e0d-8c2f-687618e26ae2" :answer/id #uuid "5a9f8c59-1dc9-5e0d-8c2f-687618e26ae2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1}({e}^{2-x}-{e}^{{x}^{2}})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-8627ef67-ddb2-57f6-bf5f-dfecb65a8067" :answer/id #uuid "8627ef67-ddb2-57f6-bf5f-dfecb65a8067" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1}({e}^{4-2x}-{e}^{2{x}^{2}})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-5843c213-01a6-5e2b-9bc8-4fd5d86dbaad" :answer/id #uuid "5843c213-01a6-5e2b-9bc8-4fd5d86dbaad" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}({e}^{{x}^{2}}-{e}^{2-x})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-a5df2e25-639b-5613-82c1-85dbfc89566d" :question/id #uuid "a5df2e25-639b-5613-82c1-85dbfc89566d" :question/math-academy-id "q-11094" :question/problem "![](images/2b/2bf88537e9a37404dd10dd99769f6933879d07c1ffbb913adc2a4f52b11f48d6.png)\n\nConsider the finite region above bounded by $y=\\sqrt{x}$ and $y={x}^{3},$ as shown above. Calculate the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "Let $f(x)=\\sqrt{x}$ and $g(x)={x}^{3}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ \\sqrt{x} & ={x}^{3} \\\\ \\sqrt{x}-{x}^{3} & =0 \\\\ \\sqrt{x}(1-{x}^{5/2}) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ and $x=1.$ \n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/0c/0cdcf559f1498045d3d8cd725593da6adb0459addb1df7cc3c4167b2fd9b6214.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{3},$ and\n\n- *leaves* through the outer function $y=f(x)=\\sqrt{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{x}]}^{2}-{[{x}^{3}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(x-{x}^{6})\\text{d}x \\\\  & =\\pi {(\\frac{{x}^{2}}{2}-\\frac{{x}^{7}}{7})|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{2}-\\frac{1}{7})-0] \\\\  & =\\frac{5\\pi }{14}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae92ff64-4bee-5c75-a130-c0515196ac49"] :db/ensure [:question/validate]} {:db/id "answer-field-ae92ff64-4bee-5c75-a130-c0515196ac49" :answer-field/id #uuid "ae92ff64-4bee-5c75-a130-c0515196ac49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8ecc4d4-4427-5ab6-86a2-60f434bcd1e2" :answer-field/choices ["answer-a7cc3b11-8155-534b-8103-47d2fb5e7672" "answer-0689e233-9bc4-5d7a-a7c9-a4ddabcf8f8d" "answer-6362d776-a3dc-580c-8bc4-2d16e9c2b4e2" "answer-c8ecc4d4-4427-5ab6-86a2-60f434bcd1e2" "answer-33d5497e-3754-55e7-8f8c-02dbadf4046e"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7cc3b11-8155-534b-8103-47d2fb5e7672" :answer/id #uuid "a7cc3b11-8155-534b-8103-47d2fb5e7672" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-0689e233-9bc4-5d7a-a7c9-a4ddabcf8f8d" :answer/id #uuid "0689e233-9bc4-5d7a-a7c9-a4ddabcf8f8d" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{10}" :db/ensure [:answer/validate]} {:db/id "answer-6362d776-a3dc-580c-8bc4-2d16e9c2b4e2" :answer/id #uuid "6362d776-a3dc-580c-8bc4-2d16e9c2b4e2" :answer/type :answer.type/math :answer/value "\\frac{4}{15}" :db/ensure [:answer/validate]} {:db/id "answer-c8ecc4d4-4427-5ab6-86a2-60f434bcd1e2" :answer/id #uuid "c8ecc4d4-4427-5ab6-86a2-60f434bcd1e2" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{14}" :db/ensure [:answer/validate]} {:db/id "answer-33d5497e-3754-55e7-8f8c-02dbadf4046e" :answer/id #uuid "33d5497e-3754-55e7-8f8c-02dbadf4046e" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{15}" :db/ensure [:answer/validate]} {:db/id 17592186069107 :question/problem "Consider the finite region bounded by $y=2\\sqrt{x}$ and $y=2x.$ Calculate the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "Let $f(x)=2\\sqrt{x}$ and $g(x)=2x.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2\\sqrt{x} & =2x \\\\ x-\\sqrt{x} & =0 \\\\ \\sqrt{x}(\\sqrt{x}-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ and $x=1.$ \n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/d0/d0b8efe1137ecce643a16b690ba1b05f72a8f7f1e90a56e0b6c379d95886f321.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)=2x,$ and\n\n- *leaves* through the outer function $y=f(x)=2\\sqrt{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[2\\sqrt{x}]}^{2}-{[2x]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(4x-4{x}^{2})\\text{d}x \\\\  & =\\pi {(2{x}^{2}-4\\cdot \\frac{{x}^{3}}{3})|}_{0}^{1} \\\\  & =\\pi [(2-\\frac{4}{3})-0] \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186066075 :answer-field/correct "answer-06f41b0c-2317-5c10-90c1-9b4de8bc9b31" :answer-field/choices ["answer-305b1923-496e-5c90-8b84-1fed6def62da" "answer-06f41b0c-2317-5c10-90c1-9b4de8bc9b31" "answer-ff22f09a-b5a4-56d1-8ab3-09ffe4f90eca" "answer-a3dc5a4a-b487-510c-9286-d6baaafc6cc5" "answer-60ebdefb-f4b8-5761-88be-e25296f92b37"] :db/ensure [:answer-field/validate]} {:db/id "answer-305b1923-496e-5c90-8b84-1fed6def62da" :answer/id #uuid "305b1923-496e-5c90-8b84-1fed6def62da" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-06f41b0c-2317-5c10-90c1-9b4de8bc9b31" :answer/id #uuid "06f41b0c-2317-5c10-90c1-9b4de8bc9b31" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-ff22f09a-b5a4-56d1-8ab3-09ffe4f90eca" :answer/id #uuid "ff22f09a-b5a4-56d1-8ab3-09ffe4f90eca" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-a3dc5a4a-b487-510c-9286-d6baaafc6cc5" :answer/id #uuid "a3dc5a4a-b487-510c-9286-d6baaafc6cc5" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "answer-60ebdefb-f4b8-5761-88be-e25296f92b37" :answer/id #uuid "60ebdefb-f4b8-5761-88be-e25296f92b37" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "question-17abd4d5-764f-50c1-82c3-4fcec4b8a574" :question/id #uuid "17abd4d5-764f-50c1-82c3-4fcec4b8a574" :question/math-academy-id "q-122546" :question/problem "![](images/8c/8ce8a8061ec087c39ce93d73d0566832f33c4e6ce5c2f5185170c9372a0d88fa.png)\n\nConsider the finite region above bounded by $y=2x+2$ and $y=\\sqrt{4x+4},$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $x\\text{-axis.}$" :question/worked-solution "Let $f(x)=2x+2$ and $g(x)=\\sqrt{4x+4}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 2x+2 & =\\sqrt{4x+4} \\\\ 2(x+1) & =\\sqrt{4x+4} \\\\ 4(x+1)^{2} & =4x+4 \\\\ {x}^{2}+2x+1 & =x+1 \\\\ {x}^{2}+x & =0 \\\\ x(x+1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-1$ to $x=0.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/0a/0a6bdcc071500ac8dd40143c3219a14c80fc73d543d7307cb2c880a22db793a3.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=f(x)=2x+2,$ and\n\n- *leaves* through the outer function $y=g(x)=\\sqrt{4x+4}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}({[\\sqrt{4x+4}]}^{2}-{[2x+2]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}[4x+4-(2(x+1))^{2}]\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}[4(x+1)-4({x}^{2}+2x+1)]\\text{d}x \\\\  & =4\\pi {\\int }_{-1}^{0}[x+1-({x}^{2}+2x+1)]\\text{d}x \\\\  & =4\\pi {\\int }_{-1}^{0}(-{x}^{2}-x)\\text{d}x \\\\  & =4\\pi {(-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2})|}_{-1}^{0} \\\\  & =4\\pi (0-(\\frac{1}{3}-\\frac{1}{2})) \\\\  & =4\\pi (\\frac{1}{6}) \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c25b804-adcd-5109-97e9-a671522d2fa7"] :db/ensure [:question/validate]} {:db/id "answer-field-9c25b804-adcd-5109-97e9-a671522d2fa7" :answer-field/id #uuid "9c25b804-adcd-5109-97e9-a671522d2fa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c448d435-9bcd-595a-9b15-481488adc3cd" :answer-field/choices ["answer-c448d435-9bcd-595a-9b15-481488adc3cd" "answer-f7aa2104-1ab4-5d6d-8862-d71d4c61233f" "answer-99d1f1a0-32aa-5964-8ea7-584cb8f97f59" "answer-48706475-0664-565e-bd2d-7f83441bc4d8" "answer-c948edf4-7c1a-595a-9006-e62d1d1f4937"] :db/ensure [:answer-field/validate]} {:db/id "answer-c448d435-9bcd-595a-9b15-481488adc3cd" :answer/id #uuid "c448d435-9bcd-595a-9b15-481488adc3cd" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-f7aa2104-1ab4-5d6d-8862-d71d4c61233f" :answer/id #uuid "f7aa2104-1ab4-5d6d-8862-d71d4c61233f" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "answer-99d1f1a0-32aa-5964-8ea7-584cb8f97f59" :answer/id #uuid "99d1f1a0-32aa-5964-8ea7-584cb8f97f59" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-48706475-0664-565e-bd2d-7f83441bc4d8" :answer/id #uuid "48706475-0664-565e-bd2d-7f83441bc4d8" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-c948edf4-7c1a-595a-9006-e62d1d1f4937" :answer/id #uuid "c948edf4-7c1a-595a-9006-e62d1d1f4937" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id 17592186069261 :question/problem "![](images/3f/3f27cf1fddfbbbdb9dd2593567743494ae15e061bca8d1e111ac1f1561561943.png)\n\nConsider the finite region above bounded by $y={x}^{2}$ and $y=\\sqrt{x},$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "Let $f(x)={x}^{2}$ and $g(x)=\\sqrt{x}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ {x}^{2} & =\\sqrt{x} \\\\ {x}^{2}-\\sqrt{x} & =0 \\\\ \\sqrt{x}({x}^{3/2}-1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/bf/bf8d9039cbaa7fe5559d8d9d036063739e572b2abc46741668a88c09d9bcd28a.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=f(x)={x}^{2},$ and\n\n- *leaves* through the outer function $y=g(x)=\\sqrt{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{x}]}^{2}-{[{x}^{2}]}^{2})\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(x-{x}^{4})\\text{d}x \\\\  & =\\pi {(\\frac{{x}^{2}}{2}-\\frac{{x}^{5}}{5})|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{2}-\\frac{1}{5})-0] \\\\  & =\\frac{3\\pi }{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186066736 :answer-field/correct "answer-0682a3b0-8757-5407-94ef-a6f4c17bf7bd" :answer-field/choices ["answer-8056047e-a697-5657-982e-4344939eaf56" "answer-0bd79221-ded8-58df-aad5-c5b97ded34f7" "answer-17ab5395-aeaa-506c-9157-a7c38f8d6142" "answer-3952d716-6c08-5913-94b8-82d74fa976a7" "answer-0682a3b0-8757-5407-94ef-a6f4c17bf7bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-8056047e-a697-5657-982e-4344939eaf56" :answer/id #uuid "8056047e-a697-5657-982e-4344939eaf56" :answer/type :answer.type/math :answer/value "-\\frac{18\\pi }{25}" :db/ensure [:answer/validate]} {:db/id "answer-0bd79221-ded8-58df-aad5-c5b97ded34f7" :answer/id #uuid "0bd79221-ded8-58df-aad5-c5b97ded34f7" :answer/type :answer.type/math :answer/value "\\frac{13\\pi }{28}" :db/ensure [:answer/validate]} {:db/id "answer-17ab5395-aeaa-506c-9157-a7c38f8d6142" :answer/id #uuid "17ab5395-aeaa-506c-9157-a7c38f8d6142" :answer/type :answer.type/math :answer/value "\\frac{13\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "answer-3952d716-6c08-5913-94b8-82d74fa976a7" :answer/id #uuid "3952d716-6c08-5913-94b8-82d74fa976a7" :answer/type :answer.type/math :answer/value "\\frac{216\\pi }{73}" :db/ensure [:answer/validate]} {:db/id "answer-0682a3b0-8757-5407-94ef-a6f4c17bf7bd" :answer/id #uuid "0682a3b0-8757-5407-94ef-a6f4c17bf7bd" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{10}" :db/ensure [:answer/validate]} {:db/id "question-61a0b761-b748-5011-958d-51f405f814ac" :question/id #uuid "61a0b761-b748-5011-958d-51f405f814ac" :question/math-academy-id "q-362200" :question/problem "Consider the finite region bounded by $y=x+6$ and $y={x}^{2}.$ Find the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "Let $f(x)=x+6$ and $g(x)={x}^{2}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ x+6 & ={x}^{2} \\\\ {x}^{2}-x-6 & =0 \\\\ (x-3)(x+2) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=-2$ to $x=3.$\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/dd/dd8dc332f56d3b851647e5ed0fa8208eb5d3daf6e704a42ab5cffdb78ed78585.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner function $y=g(x)={x}^{2},$ and\n\n- *leaves* through the outer function $y=f(x)=x+6.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{3}((x+6)^{2}-({x}^{2})^{2})\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{3}({x}^{2}+12x+36-{x}^{4})\\,\\text{d}x \\\\  & =\\pi (\\frac{{x}^{3}}{3}+6{x}^{2}+36x-\\frac{{x}^{5}}{5})\\,{|}_{-2}^{3} \\\\  & =\\pi [(\\frac{27}{3}+54+108-\\frac{243}{5})-(-\\frac{8}{3}+24-72+\\frac{32}{5})] \\\\  & =\\frac{500\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7c19b998-512f-50eb-99a5-8be35004295f"] :db/ensure [:question/validate]} {:db/id "answer-field-7c19b998-512f-50eb-99a5-8be35004295f" :answer-field/id #uuid "7c19b998-512f-50eb-99a5-8be35004295f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c77480c4-6dc8-5251-b1f4-72672af1b05e" :answer-field/choices ["answer-c77480c4-6dc8-5251-b1f4-72672af1b05e"] :db/ensure [:answer-field/validate]} {:db/id "answer-c77480c4-6dc8-5251-b1f4-72672af1b05e" :answer/id #uuid "c77480c4-6dc8-5251-b1f4-72672af1b05e" :answer/type :answer.type/math :answer/value "\\frac{500\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "question-f666ceb4-bd3b-5b00-9ee5-dd4ca3fe5f6b" :question/id #uuid "f666ceb4-bd3b-5b00-9ee5-dd4ca3fe5f6b" :question/math-academy-id "q-50225" :question/problem "![](images/9b/9b328ecd6017922e429f11c57aca0ff452e4dc6a1476b14a448c6c9edd6b6679.png)\n\nConsider the region bounded by $x=2-\\sqrt{y}$ and $y=1-{x}^{2}$  from $y=0$ to $y=1,$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated ${360}^{∘}$ about the $y$-axis?" :question/worked-solution "Writing our second function in terms of $y,$ we get \n\n$$\n\\begin{aligned}y=1-{x}^{2}\\,⟹\\,x=\\sqrt{1-y}.\\end{aligned}\n$$\n\nLet $f(y)=2-\\sqrt{y}$ and $g(y)=\\sqrt{1-y}.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/7d/7d92b9f69ab27a2620ae94bfb4937509fc9db6dafdec4384af5de33a4dfecd30.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=\\sqrt{1-y},$ and\n\n- *leaves* through the outer function $x=f(y)=2-\\sqrt{y}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[2-\\sqrt{y}]}^{2}-{[\\sqrt{1-y}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[2-\\sqrt{y}]}^{2}-{[\\sqrt{1-y}]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e1f86725-a9a0-5a34-a3e3-7d5e69393d36"] :db/ensure [:question/validate]} {:db/id "answer-field-e1f86725-a9a0-5a34-a3e3-7d5e69393d36" :answer-field/id #uuid "e1f86725-a9a0-5a34-a3e3-7d5e69393d36" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b5329f2-5e6d-5dfd-ac89-e404f175543d" :answer-field/choices ["answer-b9b63ff9-b2d6-5c35-a869-8a8fe63e7eb4" "answer-6b5329f2-5e6d-5dfd-ac89-e404f175543d" "answer-868edb5d-0086-5d04-b4be-5d14df3a0c84" "answer-1bd9b3f4-ffc7-5550-9361-297d53cecc63" "answer-3453a2dc-525b-5c37-b554-085bee2c19a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9b63ff9-b2d6-5c35-a869-8a8fe63e7eb4" :answer/id #uuid "b9b63ff9-b2d6-5c35-a869-8a8fe63e7eb4" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}([2-\\sqrt{y}]-{[\\sqrt{1-y}]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-6b5329f2-5e6d-5dfd-ac89-e404f175543d" :answer/id #uuid "6b5329f2-5e6d-5dfd-ac89-e404f175543d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({[2-\\sqrt{y}]}^{2}-{[\\sqrt{1-y}]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-868edb5d-0086-5d04-b4be-5d14df3a0c84" :answer/id #uuid "868edb5d-0086-5d04-b4be-5d14df3a0c84" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}{[2-\\sqrt{y}]}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1bd9b3f4-ffc7-5550-9361-297d53cecc63" :answer/id #uuid "1bd9b3f4-ffc7-5550-9361-297d53cecc63" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}(1-y)\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-3453a2dc-525b-5c37-b554-085bee2c19a7" :answer/id #uuid "3453a2dc-525b-5c37-b554-085bee2c19a7" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({[2-\\sqrt{y}]}^{2}-[\\sqrt{1-y}])\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-0bef34f9-b7a4-5afd-919c-8a8bc54bd07d" :question/id #uuid "0bef34f9-b7a4-5afd-919c-8a8bc54bd07d" :question/math-academy-id "q-123369" :question/problem "![](images/fb/fb3afbc1bebf1abc77b0495135e02b26da362ffb346aa261d42ba43dca94ec66.png)\n\nConsider the finite region bounded by $x={e}^{{y}^{2}}$ and $x={e}^{y+2},$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated ${360}^{∘}$ about the $y$-axis?" :question/worked-solution "Let $f(y)={e}^{{y}^{2}}$ and $g(y)={e}^{y+2}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {e}^{{y}^{2}} & ={e}^{y+2} \\\\ {y}^{2} & =y+2 \\\\ {y}^{2}-y-2 & =0 \\\\ (y+1)(y-2) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-1$ and $y=2.$ \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/b6/b6db4894c0cf0204ae676a0350771cf47359031f30fb975d48d5864b1592e673.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)={e}^{{y}^{2}},$ and\n\n- *leaves* through the outer function $x=g(y)={e}^{y+2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}({[{e}^{y+2}]}^{2}-{[{e}^{{y}^{2}}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}({e}^{2y+4}-{e}^{2{y}^{2}})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1d70164c-5d29-5881-aced-1f4582314e1a"] :db/ensure [:question/validate]} {:db/id "answer-field-1d70164c-5d29-5881-aced-1f4582314e1a" :answer-field/id #uuid "1d70164c-5d29-5881-aced-1f4582314e1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75579b0b-8d22-5de4-92bc-15ad6764edee" :answer-field/choices ["answer-75579b0b-8d22-5de4-92bc-15ad6764edee" "answer-d1ef0c42-44f4-5b64-9ae2-1f685ea0e6c4" "answer-3a6213c7-b58b-555d-8665-b22f7434f0cf" "answer-8fe77835-b4df-5c45-a282-5fb5cd15ea31" "answer-bc0fb309-ab27-5ba5-ae7f-f3a42d9ac2c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-75579b0b-8d22-5de4-92bc-15ad6764edee" :answer/id #uuid "75579b0b-8d22-5de4-92bc-15ad6764edee" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{2y+4}-{e}^{2{y}^{2}})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-d1ef0c42-44f4-5b64-9ae2-1f685ea0e6c4" :answer/id #uuid "d1ef0c42-44f4-5b64-9ae2-1f685ea0e6c4" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{2{y}^{2}}-{e}^{2y+4})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-3a6213c7-b58b-555d-8665-b22f7434f0cf" :answer/id #uuid "3a6213c7-b58b-555d-8665-b22f7434f0cf" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{y+2}-{e}^{{y}^{2}})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-8fe77835-b4df-5c45-a282-5fb5cd15ea31" :answer/id #uuid "8fe77835-b4df-5c45-a282-5fb5cd15ea31" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({e}^{{y}^{2}}-{e}^{y+2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bc0fb309-ab27-5ba5-ae7f-f3a42d9ac2c3" :answer/id #uuid "bc0fb309-ab27-5ba5-ae7f-f3a42d9ac2c3" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1}({e}^{2y+4}-{e}^{2{y}^{2}})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-0b6da66a-d01e-54fd-b6f1-7c1c4b4f3048" :question/id #uuid "0b6da66a-d01e-54fd-b6f1-7c1c4b4f3048" :question/math-academy-id "q-50239" :question/problem "![](images/96/96f465c4da3f2e482fa0224e23564d27e363a727602ec05ed6daad8213807211.png)\n\nConsider the finite region bounded by ${x}^{2}+2{y}^{2}=5$ and $x=\\sqrt{3},$ where $x\\ge 0,$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "Writing our first function in terms of $y,$ we get \n\n$$\n\\begin{aligned}{x}^{2}+2{y}^{2}=5\\,⟹\\,x=\\sqrt{5-2{y}^{2}}.\\end{aligned}\n$$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}\\sqrt{3} & =\\sqrt{5-2{y}^{2}} \\\\ 3 & =5-2{y}^{2} \\\\ 2{y}^{2} & =2 \\\\ {y}^{2} & =1\\end{aligned}\n$$\n\n \n\nHence, the limits of integration are from $y=-1$ to $y=1.$ \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/54/54fbb219933d282480f70d8f87cbb8225c126979c58a5be6faed0a98eaf97c51.png)\n\n \n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=\\sqrt{3},$ and\n\n- *leaves* through the outer function $x=\\sqrt{5-2{y}^{2}}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}({[\\sqrt{5-2{y}^{2}}]}^{2}-{[\\sqrt{3}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}([5-2{y}^{2}]-3)\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(2-2{y}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2d83603e-459b-5049-90d7-a03f49d1df85"] :db/ensure [:question/validate]} {:db/id "answer-field-2d83603e-459b-5049-90d7-a03f49d1df85" :answer-field/id #uuid "2d83603e-459b-5049-90d7-a03f49d1df85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc2f2b0c-e5aa-5387-92f6-9f8ca058ee33" :answer-field/choices ["answer-7b562af0-779e-564f-bf8e-eff2bb21be8b" "answer-b77d9887-e116-582a-9a16-739bb87b78c5" "answer-bc2f2b0c-e5aa-5387-92f6-9f8ca058ee33" "answer-8e0882aa-5d49-5ef5-b6bb-ff8a59b2a3b6" "answer-b327338b-bdbd-5feb-84e7-2e98c88c2c12"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b562af0-779e-564f-bf8e-eff2bb21be8b" :answer/id #uuid "7b562af0-779e-564f-bf8e-eff2bb21be8b" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}{(2{y}^{2}-\\sqrt{3})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b77d9887-e116-582a-9a16-739bb87b78c5" :answer/id #uuid "b77d9887-e116-582a-9a16-739bb87b78c5" :answer/type :answer.type/math :answer/value "4\\pi {\\int }_{-1}^{1}(8-3{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bc2f2b0c-e5aa-5387-92f6-9f8ca058ee33" :answer/id #uuid "bc2f2b0c-e5aa-5387-92f6-9f8ca058ee33" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}(2-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-8e0882aa-5d49-5ef5-b6bb-ff8a59b2a3b6" :answer/id #uuid "8e0882aa-5d49-5ef5-b6bb-ff8a59b2a3b6" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}(5-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b327338b-bdbd-5feb-84e7-2e98c88c2c12" :answer/id #uuid "b327338b-bdbd-5feb-84e7-2e98c88c2c12" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}(\\sqrt{3}-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-d84428ea-0ba4-5227-96d6-43b34422e545" :question/id #uuid "d84428ea-0ba4-5227-96d6-43b34422e545" :question/math-academy-id "q-123365" :question/problem "![](images/55/55308256c72aaf122c04c0b7f3a987fccd72d2513dd4edb6cf0ea4ce857522e5.png)\n\nConsider the finite region bounded by $y=2x+2$ and $x=\\sqrt{y-2},$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "Writing our first function in terms of $y,$ we get \n\n$$\n\\begin{aligned}y=2x+2\\,⟹\\,x=\\frac{1}{2}y-1.\\end{aligned}\n$$\n\nLet $f(y)=\\frac{1}{2}y-1$ and $g(y)=\\sqrt{y-2}.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ \\frac{1}{2}y-1 & =\\sqrt{y-2} \\\\ y-2 & =2\\sqrt{y-2} \\\\ (y-2)^{2} & =4(y-2) \\\\ (y-2)^{2}-4(y-2) & =0 \\\\ (y-2)((y-2)-4) & =0 \\\\ (y-2)(y-6) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=2$ to $y=6.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/8e/8e621715ded3c5ed527d2367785707939b1e3593707eaafe0b4c5e4509883e49.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)=\\frac{1}{2}y-1,$ and\n\n- *leaves* through the outer function $x=g(y)=\\sqrt{y-2}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{2}^{6}({[\\sqrt{y-2}]}^{2}-{[\\frac{1}{2}y-1]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{2}^{6}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-82f32dfc-9143-5166-b02d-1b46261da802"] :db/ensure [:question/validate]} {:db/id "answer-field-82f32dfc-9143-5166-b02d-1b46261da802" :answer-field/id #uuid "82f32dfc-9143-5166-b02d-1b46261da802" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b6ea001f-721c-5acf-821a-a0ad541670bd" :answer-field/choices ["answer-d2a469bb-c186-589c-8768-0ebb679178a0" "answer-3531e655-6ae7-5b2d-ab95-2fc419eb17a6" "answer-b1c80ec3-99ea-519d-b6ba-11c8b1be9972" "answer-b6ea001f-721c-5acf-821a-a0ad541670bd" "answer-10a507d3-b82b-5812-b4bd-1a60a94b11a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2a469bb-c186-589c-8768-0ebb679178a0" :answer/id #uuid "d2a469bb-c186-589c-8768-0ebb679178a0" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{4}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-3531e655-6ae7-5b2d-ab95-2fc419eb17a6" :answer/id #uuid "3531e655-6ae7-5b2d-ab95-2fc419eb17a6" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{4}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b1c80ec3-99ea-519d-b6ba-11c8b1be9972" :answer/id #uuid "b1c80ec3-99ea-519d-b6ba-11c8b1be9972" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{6}(\\sqrt{y-2}-\\frac{1}{2}y+1)\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b6ea001f-721c-5acf-821a-a0ad541670bd" :answer/id #uuid "b6ea001f-721c-5acf-821a-a0ad541670bd" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{6}(y-2-{[\\frac{1}{2}y-1]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-10a507d3-b82b-5812-b4bd-1a60a94b11a0" :answer/id #uuid "10a507d3-b82b-5812-b4bd-1a60a94b11a0" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{6}({[\\frac{1}{2}y-1]}^{2}-y+2)\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-3d1bfa1c-c252-5832-a4ec-b38acfcd7492" :question/id #uuid "3d1bfa1c-c252-5832-a4ec-b38acfcd7492" :question/math-academy-id "q-122558" :question/problem "![](images/b9/b9f1ea82756eed4a815afb54defd8425631a57a0bcd1dfaba2dbf5b24b43b518.png)\n\nConsider the finite region bounded by $x=y\\operatorname{ln}⁡y$ and $x=3\\operatorname{ln}⁡y,$ as shown above. Which of the following gives the volume of the solid generated when that region is rotated ${360}^{∘}$ about the $y$-axis?" :question/worked-solution "Let $f(y)=y\\operatorname{ln}⁡y$ and $g(y)=3\\operatorname{ln}⁡y.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ y\\operatorname{ln}⁡y & =3\\operatorname{ln}⁡y \\\\ y\\operatorname{ln}⁡y-3\\operatorname{ln}⁡y & =0 \\\\ (y-3)\\operatorname{ln}⁡y & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=1$ and $y=3.$ \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/54/54278318429e01bc3fa2c0325fea7c7a918aacf096b1510d8acc87d3ffc53a73.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)=y\\operatorname{ln}⁡y,$ and\n\n- *leaves* through the outer function $x=g(y)=3\\operatorname{ln}⁡y.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{1}^{3}({[3\\operatorname{ln}⁡y]}^{2}-{[y\\operatorname{ln}⁡y]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{1}^{3}(9(\\operatorname{ln}⁡y)^{2}-{y}^{2}(\\operatorname{ln}⁡y)^{2})\\text{d}y \\\\  & =\\pi {\\int }_{1}^{3}(9-{y}^{2})(\\operatorname{ln}⁡y)^{2}\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c008af03-a6bf-532f-9d1b-deae201a2d39"] :db/ensure [:question/validate]} {:db/id "answer-field-c008af03-a6bf-532f-9d1b-deae201a2d39" :answer-field/id #uuid "c008af03-a6bf-532f-9d1b-deae201a2d39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ade3240-071a-5254-a5f2-d65b724dcda1" :answer-field/choices ["answer-cfa114cb-eaa2-5372-8f8c-a3f2840e8740" "answer-47a3aa53-5278-571f-be2f-61617323e3e7" "answer-5ade3240-071a-5254-a5f2-d65b724dcda1" "answer-8754fbd1-e952-53e6-8efa-f251620f9bc8" "answer-96993872-6660-5370-b129-947f15c62c5c"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfa114cb-eaa2-5372-8f8c-a3f2840e8740" :answer/id #uuid "cfa114cb-eaa2-5372-8f8c-a3f2840e8740" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{3}(9-{y}^{2})(\\operatorname{ln}⁡y)^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-47a3aa53-5278-571f-be2f-61617323e3e7" :answer/id #uuid "47a3aa53-5278-571f-be2f-61617323e3e7" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{3}({y}^{2}-9)(\\operatorname{ln}⁡y)^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-5ade3240-071a-5254-a5f2-d65b724dcda1" :answer/id #uuid "5ade3240-071a-5254-a5f2-d65b724dcda1" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{3}(9-{y}^{2})(\\operatorname{ln}⁡y)^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-8754fbd1-e952-53e6-8efa-f251620f9bc8" :answer/id #uuid "8754fbd1-e952-53e6-8efa-f251620f9bc8" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{3}(y-3)\\operatorname{ln}⁡y\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-96993872-6660-5370-b129-947f15c62c5c" :answer/id #uuid "96993872-6660-5370-b129-947f15c62c5c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{3}({y}^{2}-9)(\\operatorname{ln}⁡y)^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186069015 :question/problem "Consider the finite region bounded by $x=\\sqrt{y}$ and $x={y}^{3}.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Let $f(y)=\\sqrt{y}$ and $g(y)={y}^{3}.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ \\sqrt{y} & ={y}^{3} \\\\ \\sqrt{y}-{y}^{3} & =0 \\\\ \\sqrt{y}\\,(1-{y}^{5/2}) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=0$ and $y=1.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/cd/cdf95299f8b925adcec743141bda4d94ad5542bfa8859fbdf5501ae0d56cd4e8.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)={y}^{3},$ and\n\n- *leaves* through the outer function $x=f(y)=\\sqrt{y}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{y}]}^{2}-{[{y}^{3}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}(y-{y}^{6})\\text{d}y \\\\  & =\\pi {(\\frac{{y}^{2}}{2}-\\frac{{y}^{7}}{7})|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{2}-\\frac{1}{7})-0] \\\\  & =\\frac{5\\pi }{14}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186065523 :answer-field/correct "answer-c3d0691a-1f69-5347-b891-6fb7ae51a803" :answer-field/choices ["answer-69dba8d8-2b15-5feb-9dd7-9b6a0b0cb0a2" "answer-0ad14229-ac80-582b-a455-c69c94e3e805" "answer-c3d0691a-1f69-5347-b891-6fb7ae51a803" "answer-b4406c79-30eb-5ac3-b6ff-9a02bdd4edb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-69dba8d8-2b15-5feb-9dd7-9b6a0b0cb0a2" :answer/id #uuid "69dba8d8-2b15-5feb-9dd7-9b6a0b0cb0a2" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-0ad14229-ac80-582b-a455-c69c94e3e805" :answer/id #uuid "0ad14229-ac80-582b-a455-c69c94e3e805" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{10}" :db/ensure [:answer/validate]} {:db/id "answer-c3d0691a-1f69-5347-b891-6fb7ae51a803" :answer/id #uuid "c3d0691a-1f69-5347-b891-6fb7ae51a803" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{14}" :db/ensure [:answer/validate]} {:db/id "answer-b4406c79-30eb-5ac3-b6ff-9a02bdd4edb6" :answer/id #uuid "b4406c79-30eb-5ac3-b6ff-9a02bdd4edb6" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "question-bb5bb053-af9b-561d-bd9f-9db0ee360eaf" :question/id #uuid "bb5bb053-af9b-561d-bd9f-9db0ee360eaf" :question/math-academy-id "q-86145" :question/problem "Consider the finite region bounded by $x={y}^{2}-6$ and $x=-2.$ Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Let $f(y)={y}^{2}-6$ and $g(y)=-2.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {y}^{2}-6 & =-2 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-2$ and $y=2.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/ba/ba9886ace429eee313ac208f7a8aebd93993c734e4382656dcf31ef15d04cd00.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=-2,$ and\n\n- *leaves* through the outer function $x=f(y)={y}^{2}-6.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-2}^{2}({[{y}^{2}-6]}^{2}-{[-2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-2}^{2}({y}^{4}-12{y}^{2}+32)\\text{d}y \\\\  & =\\pi {(\\frac{{y}^{5}}{5}-4{y}^{3}+32y)|}_{-2}^{2} \\\\  & =\\pi [(\\frac{32}{5}-32+64)-(-\\frac{32}{5}+32-64)] \\\\  & =\\frac{384\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bac40885-b168-57ac-9764-80cef2e04f58"] :db/ensure [:question/validate]} {:db/id "answer-field-bac40885-b168-57ac-9764-80cef2e04f58" :answer-field/id #uuid "bac40885-b168-57ac-9764-80cef2e04f58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-78780af1-b667-5db4-80fc-158b6cdd4cf3" :answer-field/choices ["answer-a22fb4d8-f9d7-52f8-ba8d-91050811627a" "answer-78780af1-b667-5db4-80fc-158b6cdd4cf3" "answer-ac201446-7ce5-558f-be28-299a3a97fe4c" "answer-d3652865-5e1f-5c8f-897b-2f29a227539f" "answer-53b1658a-0743-5f39-aa3b-81a36c8036ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-a22fb4d8-f9d7-52f8-ba8d-91050811627a" :answer/id #uuid "a22fb4d8-f9d7-52f8-ba8d-91050811627a" :answer/type :answer.type/math :answer/value "\\frac{34\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-78780af1-b667-5db4-80fc-158b6cdd4cf3" :answer/id #uuid "78780af1-b667-5db4-80fc-158b6cdd4cf3" :answer/type :answer.type/math :answer/value "\\frac{384\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-ac201446-7ce5-558f-be28-299a3a97fe4c" :answer/id #uuid "ac201446-7ce5-558f-be28-299a3a97fe4c" :answer/type :answer.type/math :answer/value "\\frac{38\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-d3652865-5e1f-5c8f-897b-2f29a227539f" :answer/id #uuid "d3652865-5e1f-5c8f-897b-2f29a227539f" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-53b1658a-0743-5f39-aa3b-81a36c8036ae" :answer/id #uuid "53b1658a-0743-5f39-aa3b-81a36c8036ae" :answer/type :answer.type/math :answer/value "\\frac{84\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "question-4870784d-cfa2-5882-86d4-3e6f72784ac7" :question/id #uuid "4870784d-cfa2-5882-86d4-3e6f72784ac7" :question/math-academy-id "q-11107" :question/problem "![](images/0f/0f94662dcae88371bb47d9748d002e38c6e521b0ba689e31e782ce288d266a58.png)\n\nConsider the finite region bounded by ${x}^{2}-{y}^{2}=2$ and ${x}^{2}-2{y}^{2}=1,$ where $x\\ge 0,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Given that $x\\ge 0,$ writing our functions in terms of $y,$ we get the following:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}=2\\, & ⟹\\,x=\\sqrt{2+{y}^{2}} \\\\ {x}^{2}-2{y}^{2}=1\\, & ⟹\\,x=\\sqrt{1+2{y}^{2}}.\\end{aligned}\n$$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}\\sqrt{2+{y}^{2}} & =\\sqrt{1+2{y}^{2}} \\\\ 2+{y}^{2} & =1+2{y}^{2} \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-1$ to $y=1.$    \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/41/4177abe03f95230a3176738cddbc556d2e4c3703fe72c1391a53c1ecb5f82181.png)\n\n  \n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=\\sqrt{1+2{y}^{2}},$ and\n\n- *leaves* through the outer function $x=\\sqrt{2+{y}^{2}}.$\n\nTherefore, the integral that gives our volume is:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}({[\\sqrt{2+{y}^{2}}]}^{2}-{[\\sqrt{1+2{y}^{2}}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}((2+{y}^{2})-(1+2{y}^{2}))\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(1-{y}^{2})\\text{d}y \\\\  & =\\pi {(y-\\frac{{y}^{3}}{3})|}_{-1}^{1} \\\\  & =\\pi [(1-\\frac{1}{3})-((-1)+\\frac{1}{3})] \\\\  & =\\frac{4\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-68c55f83-abc0-585e-b0d0-0f5142052ec5"] :db/ensure [:question/validate]} {:db/id "answer-field-68c55f83-abc0-585e-b0d0-0f5142052ec5" :answer-field/id #uuid "68c55f83-abc0-585e-b0d0-0f5142052ec5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd6260e8-7e2e-517a-94a3-c2333c4374dc" :answer-field/choices ["answer-2531d59f-f2ae-5972-ad8d-0b5fd54daec2" "answer-beed519c-f20b-5284-af42-9fbc05bb7cb7" "answer-cd6260e8-7e2e-517a-94a3-c2333c4374dc" "answer-e25642d2-500b-5440-8219-49e59a725b80" "answer-abfcd8a6-cfe4-579a-ae03-ab736d027afa"] :db/ensure [:answer-field/validate]} {:db/id "answer-2531d59f-f2ae-5972-ad8d-0b5fd54daec2" :answer/id #uuid "2531d59f-f2ae-5972-ad8d-0b5fd54daec2" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-beed519c-f20b-5284-af42-9fbc05bb7cb7" :answer/id #uuid "beed519c-f20b-5284-af42-9fbc05bb7cb7" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-cd6260e8-7e2e-517a-94a3-c2333c4374dc" :answer/id #uuid "cd6260e8-7e2e-517a-94a3-c2333c4374dc" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-e25642d2-500b-5440-8219-49e59a725b80" :answer/id #uuid "e25642d2-500b-5440-8219-49e59a725b80" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-abfcd8a6-cfe4-579a-ae03-ab736d027afa" :answer/id #uuid "abfcd8a6-cfe4-579a-ae03-ab736d027afa" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-10f20a34-5dca-5f03-b661-36330ae0c9f9" :question/id #uuid "10f20a34-5dca-5f03-b661-36330ae0c9f9" :question/math-academy-id "q-123488" :question/problem "![](images/b2/b2888d7fef98dacad56792a627ef1554ed28def615f1431de35d3ba9820fe0de.png)\n\nConsider the finite region bounded by $x={y}^{2}+2$ and $y=2-x,$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Writing our second function in terms of $y,$ we get\n\n$$\ny=2-x\\,⟹\\,x=2-y.\n$$\n\nLet $f(y)={y}^{2}+2$ and $g(y)=2-y.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {y}^{2}+2 & =2-y \\\\ {y}^{2}+y & =0 \\\\ y(y+1) & =0\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=-1$ to $y=0.$    \n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/af/afe7bb6fbc5f523e04bdd8c5bc9e899af356729da0e4c7822bd7619dfeb3cb95.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=f(y)={y}^{2}+2,$ and\n\n- *leaves* through the outer function $x=g(y)=2-y.$\n\nTherefore, the integral that gives our volume is:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}({[2-y]}^{2}-{[{y}^{2}+2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}(4-4y+{y}^{2}-({y}^{4}+4{y}^{2}+4))\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}(-{y}^{4}-3{y}^{2}-4y)\\text{d}y \\\\  & =\\pi {(-\\frac{{y}^{5}}{5}-{y}^{3}-2{y}^{2})|}_{-1}^{0} \\\\  & =\\pi [0-(\\frac{1}{5}+1-2)] \\\\  & =\\frac{4\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f62f58ca-a3ef-528b-83c7-bf2ccd3c2d04"] :db/ensure [:question/validate]} {:db/id "answer-field-f62f58ca-a3ef-528b-83c7-bf2ccd3c2d04" :answer-field/id #uuid "f62f58ca-a3ef-528b-83c7-bf2ccd3c2d04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b80dc7eb-9456-5e23-b6c7-2d2f2b7e9338" :answer-field/choices ["answer-29fab220-23bc-5366-b741-676d8657ce65" "answer-d7e6f5d2-255a-53e4-a0a8-a54da7d2533b" "answer-c15e3f58-b077-5947-b270-fa6badb4c890" "answer-8cfc9f8a-4976-5927-99bf-331c5811136e" "answer-b80dc7eb-9456-5e23-b6c7-2d2f2b7e9338"] :db/ensure [:answer-field/validate]} {:db/id "answer-29fab220-23bc-5366-b741-676d8657ce65" :answer/id #uuid "29fab220-23bc-5366-b741-676d8657ce65" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-d7e6f5d2-255a-53e4-a0a8-a54da7d2533b" :answer/id #uuid "d7e6f5d2-255a-53e4-a0a8-a54da7d2533b" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-c15e3f58-b077-5947-b270-fa6badb4c890" :answer/id #uuid "c15e3f58-b077-5947-b270-fa6badb4c890" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-8cfc9f8a-4976-5927-99bf-331c5811136e" :answer/id #uuid "8cfc9f8a-4976-5927-99bf-331c5811136e" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-b80dc7eb-9456-5e23-b6c7-2d2f2b7e9338" :answer/id #uuid "b80dc7eb-9456-5e23-b6c7-2d2f2b7e9338" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{5}" :db/ensure [:answer/validate]} {:db/id 17592186069016 :question/problem "![](images/62/6250d388875796ad05e4d3eb8a5f625b6a633cbf0e9efb24926f72a9c6ceac7f.png)\n\nConsider the finite region bounded by $y=1-{x}^{2}$ and $x=1-\\sqrt{y},$ as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." :question/worked-solution "Writing our first function in terms of $y,$ we get \n\n$$\n\\begin{aligned}y=1-{x}^{2}\\,⟹\\,x=\\sqrt{1-y}.\\end{aligned}\n$$\n\nLet $f(y)=\\sqrt{1-y}\\,$ and $g(y)=1-\\sqrt{y}.$\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y:$\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ \\sqrt{1-y} & =1-\\sqrt{y} \\\\ 1-y & =1-2\\sqrt{y}+y \\\\ 2y-2\\sqrt{y} & =0 \\\\ \\sqrt{y}(\\sqrt{y}-1) & =0.\\end{aligned}\n$$\n\nHence, the limits of integration are from $y=0$ to $y=1.$\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/b6/b630edf4ad0b61defcb7aba67902f75202a8f6e9a209384fb28650c06545113f.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner function $x=g(y)=1-\\sqrt{y},$ and\n\n- *leaves* through the outer function $x=f(y)=\\sqrt{1-y}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{a}^{b}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[\\sqrt{1-y}]}^{2}-{[1-\\sqrt{y}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}([1-y]-[1-2\\sqrt{y}+y])\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}(2\\sqrt{y}-2y)\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}({y}^{1/2}-y)\\text{d}y \\\\  & =2\\pi {(\\frac{2{y}^{3/2}}{3}-\\frac{{y}^{2}}{2})|}_{0}^{1} \\\\  & =2\\pi [(\\frac{2}{3}-\\frac{1}{2})-0] \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186065529 :answer-field/correct "answer-600e3932-6193-582e-b8d3-9f02d1dac288" :answer-field/choices ["answer-4173c919-b0a7-54eb-a3f1-ef3e434be901" "answer-a1a21577-4501-5227-9e07-538c3f614cde" "answer-31f4d92d-a272-589c-aaa2-26e10752eec6" "answer-600e3932-6193-582e-b8d3-9f02d1dac288" "answer-9e4d79fc-2e5f-5cec-b5a4-479e429bcf09"] :db/ensure [:answer-field/validate]} {:db/id "answer-4173c919-b0a7-54eb-a3f1-ef3e434be901" :answer/id #uuid "4173c919-b0a7-54eb-a3f1-ef3e434be901" :answer/type :answer.type/math :answer/value "\\frac{49\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-a1a21577-4501-5227-9e07-538c3f614cde" :answer/id #uuid "a1a21577-4501-5227-9e07-538c3f614cde" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-31f4d92d-a272-589c-aaa2-26e10752eec6" :answer/id #uuid "31f4d92d-a272-589c-aaa2-26e10752eec6" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "answer-600e3932-6193-582e-b8d3-9f02d1dac288" :answer/id #uuid "600e3932-6193-582e-b8d3-9f02d1dac288" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-9e4d79fc-2e5f-5cec-b5a4-479e429bcf09" :answer/id #uuid "9e4d79fc-2e5f-5cec-b5a4-479e429bcf09" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{5}" :db/ensure [:answer/validate]} {:db/id 17592186069920 :tutorial/content "Consider the plane region enclosed by the curve $y=\\sqrt{x},$ the curve $y=\\dfrac{1}{2}x,$ and the vertical line $x=2,$ as shown below.\n\n![](images/65/651d5d0d9ccafdeb94608e74086136b121c394670afbea669c3e99606f9756aa.png)\n\nWe rotate this region $360^\\circ$ about the $x$-axis to get a solid of revolution, as shown below. How can we find the volume of this solid?\n\n![](images/7a/7a1e4b8d0a27283cad7a0b0e0f2b23f1a45d0e560582a61f84c0f90a4f61e039.png)\n\nTo find the volume of the solid generated when the region bounded by the outer curve $y=f(x),$ the inner curve $y=g(x),$ and the vertical lines $x=a$ and $x=b$ is rotated $360^\\circ$ about the $x$-axis, we use the following formula:\n\n$$\nV = \\pi \\int_{a}^{b} \\Big( \\big[ \\underbrace{f(x)}_\\text{outer} \\big]^2 - \\big[ \\underbrace{g(x)}_\\text{inner} \\big]^2 \\Big) \\:\\textrm{d}x.\n$$\n\nThis method of computing the volume is called the **washer method** because it involves breaking up the region into many thin washers (one such washer is shown below). \n\n![](images/29/2920f308f15ef81eaff0ba431d0f4eec3ccd9826fbde8f126242b0493f1f8e32.png)\n\nThe cross-sectional area of each washer corresponds to the region between two discs of radius $f(x)$ and $g(x),$ so the area of each washer cross-section is \n\n$$\n\\pi [f(x)]^2 - \\pi [g(x)]^2,\n$$\n\nand this is what we integrate.\n\nIn our case, the outer curve is $f(x)=\\sqrt{x}$ and the inner curve is $g(x) = \\dfrac{1}{2}x,$ so the volume is given by\n\n$$\n\\begin{aligned}V=\\pi {\\int }_{0}^{2}{(\\sqrt{x})}^{2}-{(\\frac{1}{2}x)}^{2}\\text{d}x.\\end{aligned}\n$$\n\nwhich simplifies to\n\n$$\n\\begin{aligned}V=\\pi {\\int }_{0}^{2}(x-\\frac{{x}^{2}}{4})\\text{d}x.\\end{aligned}\n$$\n\nEvaluating this integral gives\n\n$$\n\\begin{aligned}V & =\\pi ({\\int }_{0}^{2}x\\,\\text{d}x-\\frac{1}{4}{\\int }_{0}^{2}{x}^{2}\\,\\text{d}x) \\\\  & =\\pi ({\\frac{{x}^{2}}{2}|}_{0}^{2}-\\frac{1}{4}\\cdot {\\frac{{x}^{3}}{3}|}_{0}^{2}) \\\\  & =\\pi ((\\frac{4}{2}-0)-\\frac{1}{4}(\\frac{8}{3}-0)) \\\\  & =\\pi (2-\\frac{2}{3}) \\\\  & =\\frac{4\\pi }{3}.\\end{aligned}\n$$\n\nSo the volume of the solid is $\\dfrac{4\\pi}{3}$ cubic units." :db/ensure [:tutorial/validate]} {:db/id 17592186069921 :tutorial/content "Consider the plane region bounded by the curve ![](images/da/da9e7c622c9bb4816126baaf7030000b0df743977b620a20454f6f41974d4a66.svg) the curve ![](images/34/344c03d67f3618b1dc0560c072fc86443bf8eb991de0eed6ed1196fe20586053.svg) and the horizontal line ![](images/51/5105b7bf189fe285a6ab74d0f01cdea25d5acb40cac53551b0ac58def8d4180f.svg) as shown below.\n\n![](images/5c/5c3d071079a6f434bf7646a0fedef9d8670cf4d4d3809b6e2b42c5f2ba6833cd.png)\n\nWe rotate this region ![](images/6f/6f3e3ccd469bd4b7cf2baf7a17cad64bb11f3f6f2d202e79362b8c44df1fcdd2.svg) about the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis to get a solid of revolution, as shown below. How can we find the volume of this solid?\n\n![](images/67/67e20ea4be60086726fa1dfbede3d378f9b73e4ec57f8af722e8cebf307cd385.png)\n\nTo find the volume of this solid, we can use the same washer method approach that we used earlier for the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-axis. The only difference is that we need to swap ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) in our formula.\n\nSo, to find the volume of the solid generated when the region bounded by the outer curve ![](images/fb/fb5fe1228a41ca0e72e76733ab39448868766741ac776c45aecea72e44f44f90.svg) the inner curve ![](images/5c/5c619f7c19342f727ea87a18b5934867e3e338a4fc0d8257d5943a585274f9b7.svg) and the horizontal lines ![](images/f8/f82a3483d5e6e5035663e40a89075138ad85d12dfd69b61d1f3bc611ca189e2e.svg) and ![](images/4d/4d9c2e8f5a6bb7f7f3c2e807701829a3f5e75f21549c3c9381d8d56e8ce7e33a.svg) is rotated ![](images/10/10745a5addeb479a769635882ff8e37e42bbc2998b149f0e57506bdc8e77915b.svg) radians about the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis, we use the following formula:\n\n![](images/a0/a079fcfafdd8b3a07003ef6cae69801526bfb6906129cd9349cd44d55f5c01cc.svg)\n\nThis is the same washer method as before, the only difference is that we need to swap ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/33/3337bbda5af4a3203ef0f6135b36de4f06c1915c4a3ff1bd5358326627c1eecd.svg) It involves breaking up the region into many thin washers (one such washer is shown below). \n\n![](images/9d/9d68e0672b26293e97fd8f8b2fbae4b4e3f743799d26a24291a3fd13075763d2.png)\n\nThe cross-sectional area of each washer corresponds to the region between two discs of radius ![](images/b9/b9f0db1d3432899cc481800eb60264a89a79ed6b611df8154be3fe42c37283d9.svg) and ![](images/0a/0a6417d7b72bf8af441e07e5b6ab87c0a7c6fb55520d22ab9bc175784595d811.svg) so the area of each washer cross-section is \n\n![](images/be/becabc91e909a4378a952ea7093d3e41329bf69861125d53f934bf346bbfe3f1.svg)\n\nand this is what we integrate.\n\nIn our example, the outer curve is ![](images/02/02e779dd5a005a08c5d479b17e3b9fda2f5c96f0483bba826a722f379b8c9c59.svg) and the inner curve is ![](images/34/344c03d67f3618b1dc0560c072fc86443bf8eb991de0eed6ed1196fe20586053.svg) so the volume is given by\n\n![](images/8b/8b555bb0836cb4a4a237faf7e1238332db6dbb5c9c8799e6db28b7ffb72c0cf1.svg)\n\nwhich simplifies to\n![](images/f4/f4bc30c392b233cc455162bb29c01f96c06aad15c5c6e3111cca35c32b4e6f12.svg)\n\nEvaluating this integral gives\n\n![](images/8e/8e82f449a8685fac34a3800371b4de23c09aa830fa80fe8d8140e7a618372221.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186068949 :activity/expected-seconds 1500.0 :db/ensure [:activity/validate]} {:db/id 17592186069690 :step/math-academy-id 639680 :db/ensure [:step/validate]} {:db/id 17592186069726 :step/math-academy-id 639681 :db/ensure [:step/validate]} {:db/id 17592186069691 :step/math-academy-id 639684 :db/ensure [:step/validate]} {:db/id 17592186069692 :step/math-academy-id 639687 :db/ensure [:step/validate]} {:db/id 17592186069727 :step/math-academy-id 639688 :db/ensure [:step/validate]} {:db/id 17592186069693 :step/math-academy-id 639691 :db/ensure [:step/validate]} {:db/id 17592186100985 :knowledge-point/questions ["question-257d80f9-98d7-5f29-b46f-5e7f007c2b82" "question-227b11b3-a4e0-591c-bdef-0816b0978926"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100709 :question/problem "The graph of $y=f(x)$ is shown below. Sketch the graph of $y=4f(x).$\n\n![](images/49/495e5e02f89dfa125cb95095088cb80cf3e83ab9e6dae619494e900cbe1dc346.png)" :question/worked-solution "To graph the function $y = 4f(x),$ we take the graph of $y = f(x)$ and stretch it by factor of $4$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y = f(x)$ by $4.$\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/0b/0b20c1355ae0b2e8afc7e7ce701662e0aaf2a6fdcd8e43342ae057e8bd9250e9.png)" :db/ensure [:question/validate]} {:db/id 17592186100986 :knowledge-point/questions ["question-613bc0f6-6251-58fe-b528-1093bbbb500f" "question-dfd0113c-14f1-5d6a-ac3b-dca77d3d998d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100708 :question/problem "![](images/30/303b6a70330995c124cdfea0bc125febd5ebcf80cb79c8656086d57f3a6f272f.png)\n\nThe graph of $y=f(x)$ is shown above. Sketch the graph of $y = \\dfrac{1}{2}f(x).$" :question/worked-solution "To graph the function $y = \\dfrac{1}{2}f(x),$ we take the graph of $y = f(x)$ and compress it by factor of $2$ parallel to the $y$-axis. This has the effect of dividing the $y$-coordinates of all points on $y = f(x)$ by $2.$\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/71/71b6584d644419a56b2cebb64124510e9f15cca8a4f19e6c1a8d4b6f1441cd0a.png)" :db/ensure [:question/validate]} {:db/id 17592186100987 :knowledge-point/questions ["question-2708eacc-b12f-5049-bb93-6886b57484fd" "question-e1e8554d-3b9d-57c5-a60f-771660835934"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100711 :question/problem "The point $P$ with coordinates $(-2, 2)$ lies on the curve $y=f(x).$ Find a point that must lie on the graph of $y= 7f(x).$" :question/worked-solution "The function $y = 7f(x)$ represents a stretch of the function $y = f(x)$ by a factor of $7$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $7.$\n\nTherefore, the point $(-2,2)$ on $f(x)$ is mapped to the point $\\left(-2, 7 \\cdot 2\\right) = (-2 , 14),$ and this point must lie on the graph of $y = 7f(x).$" :db/ensure [:question/validate]} {:db/id "question-257d80f9-98d7-5f29-b46f-5e7f007c2b82" :question/id #uuid "257d80f9-98d7-5f29-b46f-5e7f007c2b82" :question/math-academy-id "q-111029" :question/problem "![](images/b8/b8150a85386a2ebea9119820d25f227a6cb33aef8dd09b519feef4e8f70a4013.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=2f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "To graph the function $y=2f(x),$ we take the graph of $y=f(x)$ and stretch it by factor of $2$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $2.$\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/a8/a88c2321811017dcedf2c83178b47dcf8f314926e1fb2ef4273681def639f2a0.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1256e56d-e67f-58f5-90d5-2a87fcd