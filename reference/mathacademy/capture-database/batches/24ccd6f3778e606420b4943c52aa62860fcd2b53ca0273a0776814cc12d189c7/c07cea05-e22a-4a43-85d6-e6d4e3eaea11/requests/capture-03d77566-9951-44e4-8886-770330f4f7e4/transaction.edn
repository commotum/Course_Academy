ure [:question/validate]} {:db/id "answer-field-90e4a11a-c640-5a57-bedb-12194318e132" :answer-field/id #uuid "90e4a11a-c640-5a57-bedb-12194318e132" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e0fd46de-1da2-5b10-a3af-605f35681790" :answer-field/choices ["answer-e0fd46de-1da2-5b10-a3af-605f35681790"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0fd46de-1da2-5b10-a3af-605f35681790" :answer/id #uuid "e0fd46de-1da2-5b10-a3af-605f35681790" :answer/type :answer.type/math :answer/value "-\\frac{2}{x\\sqrt{1-25x^{2}}}" :db/ensure [:answer/validate]} {:db/id "question-8af41eb0-cd12-5003-8c4d-9b2fa7191b55" :question/id #uuid "8af41eb0-cd12-5003-8c4d-9b2fa7191b55" :question/math-academy-id "q-95528" :question/problem "$$\n\nIf $y=-\\operatorname{arsech}⁡(\\operatorname{ln}⁡x),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{arsech}⁡(\\operatorname{ln}⁡x)) \\\\  & =-(-\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}})\\cdot (\\operatorname{ln}⁡x)^{′} \\\\  & =\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4cb0872-1c1c-5be2-826b-83e8a8aaf2ad"] :db/ensure [:question/validate]} {:db/id "answer-field-f4cb0872-1c1c-5be2-826b-83e8a8aaf2ad" :answer-field/id #uuid "f4cb0872-1c1c-5be2-826b-83e8a8aaf2ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd9737e3-0ec2-5ba3-add4-cec93d9b1ee2" :answer-field/choices ["answer-9e0a76b4-f5