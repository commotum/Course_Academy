d-fa393c5b-69a5-51b3-a77d-1f39127b18dc" :answer-field/id #uuid "fa393c5b-69a5-51b3-a77d-1f39127b18dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" :answer-field/choices ["answer-a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" "answer-c84d385d-e171-5620-9eeb-5a8f85a098a7" "answer-0b4b9d86-b8c2-53ab-aeb4-85c153141813" "answer-8879f320-bcc2-587d-aaca-28c7f3bdd676" "answer-93677d4d-73a3-5753-b99e-accf2ba9f954"] :db/ensure [:answer-field/validate]} {:db/id "answer-a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" :answer/id #uuid "a26a89f6-b7c9-5842-8fd9-8cb26c1f5869" :answer/type :answer.type/math :answer/value "12\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c84d385d-e171-5620-9eeb-5a8f85a098a7" :answer/id #uuid "c84d385d-e171-5620-9eeb-5a8f85a098a7" :answer/type :answer.type/math :answer/value "14\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0b4b9d86-b8c2-53ab-aeb4-85c153141813" :answer/id #uuid "0b4b9d86-b8c2-53ab-aeb4-85c153141813" :answer/type :answer.type/math :answer/value "24\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8879f320-bcc2-587d-aaca-28c7f3bdd676" :answer/id #uuid "8879f320-bcc2-587d-aaca-28c7f3bdd676" :answer/type :answer.type/math :answer/value "26\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-93677d4d-73a3-5753-b99e-accf2ba9f954" :answer/id #uuid "93677d4d-73a3-5753-b99e-accf2ba9f954" :answer/type :answer.type/math :answer/value "36\\,{\\text{min}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-881664f0-8e9c-5727-bbea-b101cf17a4b3" :question/id #uuid "881664f0-8e9c-5727-bbea-b101cf17a4b3" :question/math-academy-id "q-96956" :question/problem "The distance covered per game by a football player in an official match is uniformly distributed between $9$ km and $12$ km, inclusive. What is the variance in the distance covered by this player?" :question/worked-solution "Let $X$ represent the distance covered by the player. From the problem statement, we know that $X∼U[9,12],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[9,12],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(12-9)^{2}}{12}=\\frac{9}{12}=\\frac{3}{4}\n$$\n\nTherefore, the variance of the distance covered by the football player is $\\frac{3}{4}\\,{\\text{km}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9740dd9c-a42e-5b17-8af5-62f3038a4eb7"] :db/ensure [:question/validate]} {:db/id "answer-field-9740dd9c-a42e-5b17-8af5-62f3038a4eb7" :answer-field/id #uuid "9740dd9c-a42e-5b17-8af5-62f3038a4eb7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" :answer-field/choices ["answer-e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" "answer-50116483-a706-5dd6-a017-943ddc486998" "answer-c6ceb90f-a5c7-55b2-90f2-a1d30c0c01a6" "answer-daa1ca2a-c1b0-5926-8a0e-e922c3c89348" "answer-7f0cd53c-7363-5ab5-92fc-590bf229d977"] :db/ensure [:answer-field/validate]} {:db/id "answer-e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" :answer/id #uuid "e063d08e-9e0a-5ed0-ab66-0020ccdffa4c" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\,{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-50116483-a706-5dd6-a017-943ddc486998" :answer/id #uuid "50116483-a706-5dd6-a017-943ddc486998" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\,{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c6ceb90f-a5c7-55b2-90f2-a1d30c0c01a6" :answer/id #uuid "c6ceb90f-a5c7-55b2-90f2-a1d30c0c01a6" :answer/type :answer.type/math :answer/value "\\frac{5}{3}\\,{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-daa1ca2a-c1b0-5926-8a0e-e922c3c89348" :answer/id #uuid "daa1ca2a-c1b0-5926-8a0e-e922c3c89348" :answer/type :answer.type/math :answer/value "\\frac{5}{4}\\,{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-7f0cd53c-7363-5ab5-92fc-590bf229d977" :answer/id #uuid "7f0cd53c-7363-5ab5-92fc-590bf229d977" :answer/type :answer.type/math :answer/value "\\frac{9}{4}\\,{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186158009 :question/problem "The time it takes a mechanic to repair a car is uniformly distributed with a minimum of $2$ hours and a maximum of $6$ hours. What is the variance of the time it takes to repair a car?" :question/worked-solution "Let $X$ represent the time it takes to repair a car. From the problem statement, we know that $X∼U[2,6],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[2,6],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(6-2)^{2}}{12}=\\frac{16}{12}=\\frac{4}{3}\n$$\n\nTherefore, the variance of the time it takes to repair a car is $\\frac{4}{3}\\,{\\text{hr}}^{2}$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186156975 :answer-field/correct "answer-1971a4b2-550b-5394-b1b5-b2ce91a4486d" :answer-field/choices ["answer-5198a366-384f-526c-a099-9dad65d5986e" "answer-05252ab4-17c7-54ff-8a99-a05918ce2b8f" "answer-dd9f857e-b1eb-5a2b-a336-0e4b6cc339b3" "answer-9992cae0-ada8-57b8-84ad-c508b7212276" "answer-1971a4b2-550b-5394-b1b5-b2ce91a4486d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5198a366-384f-526c-a099-9dad65d5986e" :answer/id #uuid "5198a366-384f-526c-a099-9dad65d5986e" :answer/type :answer.type/math :answer/value "\\frac{11}{4}\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-05252ab4-17c7-54ff-8a99-a05918ce2b8f" :answer/id #uuid "05252ab4-17c7-54ff-8a99-a05918ce2b8f" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-dd9f857e-b1eb-5a2b-a336-0e4b6cc339b3" :answer/id #uuid "dd9f857e-b1eb-5a2b-a336-0e4b6cc339b3" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-9992cae0-ada8-57b8-84ad-c508b7212276" :answer/id #uuid "9992cae0-ada8-57b8-84ad-c508b7212276" :answer/type :answer.type/math :answer/value "\\frac{4}{13}\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1971a4b2-550b-5394-b1b5-b2ce91a4486d" :answer/id #uuid "1971a4b2-550b-5394-b1b5-b2ce91a4486d" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-b676f753-31e2-5fb5-a7e2-ab7b8253e6c3" :question/id #uuid "b676f753-31e2-5fb5-a7e2-ab7b8253e6c3" :question/math-academy-id "q-96950" :question/problem "A librarian has noticed that the minimum visiting time of a visitor is $0.5$ hours, whereas the maximum time is $6.5$ hours. If the visiting time is uniformly distributed, what is its variance?" :question/worked-solution "Let $X$ represent the visiting time of a randomly chosen visitor. From the problem statement, we know that $X∼U[0.5,6.5],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[0.5,6.5],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(6.5-0.5)^{2}}{12}=\\frac{36}{12}=3\n$$\n\nTherefore, the variance  is $3\\,{\\text{hr}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a4dcef72-956c-59fb-8c70-71f6c1dcf441"] :db/ensure [:question/validate]} {:db/id "answer-field-a4dcef72-956c-59fb-8c70-71f6c1dcf441" :answer-field/id #uuid "a4dcef72-956c-59fb-8c70-71f6c1dcf441" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37c899a0-311c-5b6b-9ff3-e7d42dfa323d" :answer-field/choices ["answer-e9766f35-9561-5089-93e8-b3efe0163bc9" "answer-e058e338-722a-56b0-801a-88babf877d02" "answer-37c899a0-311c-5b6b-9ff3-e7d42dfa323d" "answer-3ec20181-951b-5f69-b8f4-a198ce2328f2" "answer-f372aa5a-6bd3-5dfe-a21b-5891bbe6d4d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9766f35-9561-5089-93e8-b3efe0163bc9" :answer/id #uuid "e9766f35-9561-5089-93e8-b3efe0163bc9" :answer/type :answer.type/math :answer/value "3.5\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e058e338-722a-56b0-801a-88babf877d02" :answer/id #uuid "e058e338-722a-56b0-801a-88babf877d02" :answer/type :answer.type/math :answer/value "3.6\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-37c899a0-311c-5b6b-9ff3-e7d42dfa323d" :answer/id #uuid "37c899a0-311c-5b6b-9ff3-e7d42dfa323d" :answer/type :answer.type/math :answer/value "3\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-3ec20181-951b-5f69-b8f4-a198ce2328f2" :answer/id #uuid "3ec20181-951b-5f69-b8f4-a198ce2328f2" :answer/type :answer.type/math :answer/value "6.5\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f372aa5a-6bd3-5dfe-a21b-5891bbe6d4d0" :answer/id #uuid "f372aa5a-6bd3-5dfe-a21b-5891bbe6d4d0" :answer/type :answer.type/math :answer/value "6\\,{\\text{hr}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-fefe1132-ca93-5e93-921e-5c1fd45e5581" :question/id #uuid "fefe1132-ca93-5e93-921e-5c1fd45e5581" :question/math-academy-id "q-96953" :question/problem "A video game randomly generates an obstacle the player has to avoid. The obstacle's $x$-coordinate is uniformly distributed along a segment whose endpoints have $x$-coordinates of $16$ and $24.$ What is the variance of the $x$-coordinate of the obstacle?" :question/worked-solution "Let $X$ represent the randomly generated $x$-coordinate of the obstacle. From the problem statement, we know that $X∼U[16,24],$ and we wish to compute $\\text{Var}[X].$\n\nIn general, if $X∼U[a,b],$ then $X$ has the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}\n$$\n\nSo, for our random variable $X∼U[16,24],$ we have the following variance:\n\n$$\n\\text{Var}[X]=\\frac{(24-16)^{2}}{12}=\\frac{64}{12}=\\frac{16}{3}\n$$\n\nTherefore, the variance of the $x$-coordinate is $\\frac{16}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-101a0955-c20d-5d60-8f35-d4ac4d90df10"] :db/ensure [:question/validate]} {:db/id "answer-field-101a0955-c20d-5d60-8f35-d4ac4d90df10" :answer-field/id #uuid "101a0955-c20d-5d60-8f35-d4ac4d90df10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c3be71c0-f54f-59b2-826c-729857d8c48e" :answer-field/choices ["answer-7f654726-55d0-5fca-9cdd-7a52ab9a67b2" "answer-c3be71c0-f54f-59b2-826c-729857d8c48e" "answer-06fa8f9c-5850-57e0-979a-29fbc9973afa" "answer-600f499f-c1d3-5ae0-b4a1-160b380ead3c" "answer-60225bce-dd95-55d2-bd3a-e4a05b09a0ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f654726-55d0-5fca-9cdd-7a52ab9a67b2" :answer/id #uuid "7f654726-55d0-5fca-9cdd-7a52ab9a67b2" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-c3be71c0-f54f-59b2-826c-729857d8c48e" :answer/id #uuid "c3be71c0-f54f-59b2-826c-729857d8c48e" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-06fa8f9c-5850-57e0-979a-29fbc9973afa" :answer/id #uuid "06fa8f9c-5850-57e0-979a-29fbc9973afa" :answer/type :answer.type/math :answer/value "\\frac{3}{13}" :db/ensure [:answer/validate]} {:db/id "answer-600f499f-c1d3-5ae0-b4a1-160b380ead3c" :answer/id #uuid "600f499f-c1d3-5ae0-b4a1-160b380ead3c" :answer/type :answer.type/math :answer/value "\\frac{3}{25}" :db/ensure [:answer/validate]} {:db/id "answer-60225bce-dd95-55d2-bd3a-e4a05b09a0ed" :answer/id #uuid "60225bce-dd95-55d2-bd3a-e4a05b09a0ed" :answer/type :answer.type/math :answer/value "\\frac{64}{3}" :db/ensure [:answer/validate]} {:db/id 17592186158542 :tutorial/content "In general, if $X \\sim U[a,b]$ is uniformly distributed, then $X$ has the following probability density function:\n\n![](images/93/93894f939fa0ef715ee6ab6c225f456972b746184673df0b8d8312656727d793.svg)\n\nWe can use a continuous uniform distribution to model situations where all possible outcomes on a finite interval are equally likely.\n\nFor instance, suppose a dental receptionist wants to model the waiting time of a randomly selected patient. After observing a number of patients over several days, the receptionist notices that the waiting time is uniformly distributed between $6$ and $14$ minutes, inclusive.\n\nThen, by letting $X$ be the amount of time a randomly selected patient spends waiting, we can model the waiting time using the continuous uniform distribution: \n\n$$\nX \\sim U[6,14]\n$$\n\nTherefore, $X$ has the following probability density function:\n\n![](images/fd/fd37b3e19aad197ebb7eeabad00fca068455eed8da462a12630134cd7980941e.svg)\n\nWith this model, we can now make predictions about patient waiting times.\n\nFor example, the probability that a randomly selected patient waits longer than $9$ minutes is equal to\n\n$$\n\\begin{aligned}P(X\\ge 9) & ={\\int }_{9}^{14}\\frac{1}{8}\\,\\text{d}x \\\\  & =\\frac{1}{8}{\\int }_{9}^{14}\\,\\text{d}x \\\\  & =\\frac{1}{8}{[x]}_{9}^{14} \\\\  & =\\frac{1}{8}[14-9] \\\\  & =\\frac{5}{8}.\\end{aligned}\n$$\n\nWe can also calculate the mean waiting time by finding the expected value of $X\\mathbin{:}$\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{a+b}{2} \\\\  & =\\frac{6+14}{2} \\\\  & =10\\end{aligned}\n$$\n\nTherefore, the mean waiting time is $10$ minutes." :db/ensure [:tutorial/validate]} {:db/id 17592186157536 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186221445 :knowledge-point/questions ["question-6138bd37-a9a0-5af4-80eb-ad7aa981c99c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186222023 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nLet $F(x)=6x+1$ for $x\\in [-3,3).$ The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{5}.$\n\n${b}_{5}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3$ and $f(x)=6x+1$ for $x\\in (-3,3).$ So, substituting into the formula, we get\n\n$$\n{b}_{5}=\\frac{1}{3}{\\int }_{-3}^{3}(6x+1)\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=6x+1\\, & ⇒\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)\\, & ⇒\\,v=-\\frac{3}{5\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{5} & =\\frac{1}{3}(uv\\,{|}_{-3}^{3}-{\\int }_{-3}^{3}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3}(-\\frac{3}{5\\pi }{[(6x+1)\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}+\\frac{18}{5\\pi }{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-{[(6x+1)\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}+6{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-((6(3)+1)\\operatorname{cos}⁡(5\\pi )-(6(-3)+1)\\operatorname{cos}⁡(-5\\pi ))+\\frac{18}{5\\pi }{[\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}) \\\\  & =\\frac{1}{5\\pi }(36+\\frac{18}{5\\pi }(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi ))) \\\\  & =\\frac{1}{5\\pi }\\cdot 36 \\\\  & =\\frac{36}{5\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186220816 :answer-field/correct "answer-b9caddf0-8911-56aa-9169-d2dd07b18d7d" :answer-field/choices ["answer-b9caddf0-8911-56aa-9169-d2dd07b18d7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9caddf0-8911-56aa-9169-d2dd07b18d7d" :answer/id #uuid "b9caddf0-8911-56aa-9169-d2dd07b18d7d" :answer/type :answer.type/math :answer/value "\\frac{36}{5\\pi}" :db/ensure [:answer/validate]} {:db/id 17592186221444 :knowledge-point/questions ["question-53537d13-56ed-578b-89f6-12be53184c9c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186372798 :answer-field/correct "answer-e65592e2-0cd5-534f-88d7-0eb0fc781f52" :answer-field/choices ["answer-e65592e2-0cd5-534f-88d7-0eb0fc781f52"] :db/ensure [:answer-field/validate]} {:db/id "answer-e65592e2-0cd5-534f-88d7-0eb0fc781f52" :answer/id #uuid "e65592e2-0cd5-534f-88d7-0eb0fc781f52" :answer/type :answer.type/math :answer/value "\\frac{\\pi^2}{2}" :db/ensure [:answer/validate]} {:db/id "question-53537d13-56ed-578b-89f6-12be53184c9c" :question/id #uuid "53537d13-56ed-578b-89f6-12be53184c9c" :question/math-academy-id "q-341808" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{9}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{9}x)\n$$\n\nLet $F(x)=3x+\\frac{1}{2}$ for $x\\in [-9,9).$ The Fourier series of the $18$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=9$ and $f(x)=3x+\\frac{1}{2}$ for $x\\in [-9,9).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{9}{\\int }_{-9}^{9}(3x+\\frac{1}{2})\\,\\text{d}x \\\\  & =\\frac{1}{9}{[\\frac{3}{2}{x}^{2}+\\frac{1}{2}x]}_{-9}^{9} \\\\  & =\\frac{1}{9}((\\frac{3}{2}\\cdot {9}^{2}+\\frac{1}{2}\\cdot 9)-(\\frac{3}{2}\\cdot (-9)^{2}+\\frac{1}{2}\\cdot (-9))) \\\\  & =\\frac{1}{9}(126-117) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-960bde39-7017-5d3d-adb2-123ce9006d52"] :db/ensure [:question/validate]} {:db/id "answer-field-960bde39-7017-5d3d-adb2-123ce9006d52" :answer-field/id #uuid "960bde39-7017-5d3d-adb2-123ce9006d52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6d8018e4-ef90-524c-aab7-e82fc5dc5201" :answer-field/choices ["answer-6d8018e4-ef90-524c-aab7-e82fc5dc5201"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d8018e4-ef90-524c-aab7-e82fc5dc5201" :answer/id #uuid "6d8018e4-ef90-524c-aab7-e82fc5dc5201" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-6138bd37-a9a0-5af4-80eb-ad7aa981c99c" :question/id #uuid "6138bd37-a9a0-5af4-80eb-ad7aa981c99c" :question/math-academy-id "q-341815" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nThe Fourier series of the $6$-periodic extension $f(x)$ of the function \n\n$$\nF(x)=\\{\\begin{aligned}1, & x\\in [0,3) \\\\ -4, & x\\in [-3,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{2}.$\n\n${a}_{2}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3.$ Also, $f(x)=1$ for $x\\in [0,3)$ and $f(x)=-4$ for $x\\in [-3,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{3}{\\int }_{-3}^{3}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{-3}^{0}(-4)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x+\\frac{1}{3}{\\int }_{0}^{3}\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x \\\\  & =-\\frac{4}{3}\\cdot \\frac{3}{2\\pi }{[\\operatorname{sin}⁡(\\frac{2\\pi }{3}x)]}_{-3}^{0}+\\frac{1}{3}\\cdot \\frac{3}{2\\pi }{[\\operatorname{sin}⁡(\\frac{2\\pi }{3}x)]}_{0}^{3} \\\\  & =-\\frac{2}{\\pi }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-2\\pi ))+\\frac{1}{2\\pi }(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79cdb461-38af-5784-a292-e83653dfa433"] :db/ensure [:question/validate]} {:db/id "answer-field-79cdb461-38af-5784-a292-e83653dfa433" :answer-field/id #uuid "79cdb461-38af-5784-a292-e83653dfa433" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-93a95dfd-61c1-5b85-ad7a-7edfc0702959" :answer-field/choices ["answer-93a95dfd-61c1-5b85-ad7a-7edfc0702959"] :db/ensure [:answer-field/validate]} {:db/id "answer-93a95dfd-61c1-5b85-ad7a-7edfc0702959" :answer/id #uuid "93a95dfd-61c1-5b85-ad7a-7edfc0702959" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-594dca3c-3a9c-5fcb-ade7-ee04621be91e" :activity/id #uuid "594dca3c-3a9c-5fcb-ade7-ee04621be91e" :activity/title "Fourier Series of Arbitrary Period" :activity/type :activity.type/review :activity/scope 17592186048443 :activity/course 17592186046644 :activity/steps ["step-2f23af18-6fc6-51a2-9ae3-01f862c5c75a" "step-3a9f9a3f-bf20-54e7-9f47-aa598fef0e88" "step-8a15da49-604b-5a13-b749-afcedfa2e089" "step-a7e42cee-7619-57a2-a6a6-5a997e4e2632" "step-cf1e87c7-8f9a-5050-a189-bceb0d6f5b0e"] :activity/first-step "step-2f23af18-6fc6-51a2-9ae3-01f862c5c75a" :db/ensure [:activity/validate]} {:db/id "step-2f23af18-6fc6-51a2-9ae3-01f862c5c75a" :step/id #uuid "2f23af18-6fc6-51a2-9ae3-01f862c5c75a" :step/content 17592186222023 :step/next "step-3a9f9a3f-bf20-54e7-9f47-aa598fef0e88" :db/ensure [:step/validate]} {:db/id "step-3a9f9a3f-bf20-54e7-9f47-aa598fef0e88" :step/id #uuid "3a9f9a3f-bf20-54e7-9f47-aa598fef0e88" :step/content 17592186372791 :step/next "step-8a15da49-604b-5a13-b749-afcedfa2e089" :db/ensure [:step/validate]} {:db/id "step-8a15da49-604b-5a13-b749-afcedfa2e089" :step/id #uuid "8a15da49-604b-5a13-b749-afcedfa2e089" :step/content 17592186372797 :step/next "step-a7e42cee-7619-57a2-a6a6-5a997e4e2632" :db/ensure [:step/validate]} {:db/id "step-a7e42cee-7619-57a2-a6a6-5a997e4e2632" :step/id #uuid "a7e42cee-7619-57a2-a6a6-5a997e4e2632" :step/content "question-53537d13-56ed-578b-89f6-12be53184c9c" :step/next "step-cf1e87c7-8f9a-5050-a189-bceb0d6f5b0e" :db/ensure [:step/validate]} {:db/id "step-cf1e87c7-8f9a-5050-a189-bceb0d6f5b0e" :step/id #uuid "cf1e87c7-8f9a-5050-a189-bceb0d6f5b0e" :step/content "question-6138bd37-a9a0-5af4-80eb-ad7aa981c99c" :db/ensure [:step/validate]} {:db/id 17592186092327 :knowledge-point/questions ["question-bc096998-81ea-5954-87f7-a6c387f0821d" "question-83c42558-b7ba-54b4-8258-155dbb7534d4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092312 :knowledge-point/questions ["question-33175368-8c02-5445-a715-949176f366cb" "question-8fd741b4-3eaf-54db-b2d4-05c07c61f572"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092328 :knowledge-point/questions ["question-d4519b02-5082-5dd4-add0-c15242596fca" "question-e218d969-ef9b-5d39-ab4e-db60fd086832" "question-78e65e3d-79b6-5ea5-b7c8-3423e62535bc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186092329 :knowledge-point/questions ["question-617b4238-abb7-5b3b-bc81-af12e3c18aa5" "question-40dff619-4373-5ec6-a963-8c0ddd65024c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bc096998-81ea-5954-87f7-a6c387f0821d" :question/id #uuid "bc096998-81ea-5954-87f7-a6c387f0821d" :question/math-academy-id "q-141233" :question/problem "Which of the following expressions are polynomials?\n\nI. $({x}^{2}-3x)+({x}^{3})$\n\nII. $(1-2x)-(2-{x}^{2})$\n\nIII. $(x+1)\\cdot (4-{x}^{2})$" :question/worked-solution "Recall that polynomials have the following closure properties:\n\n- Polynomials are closed under addition, subtraction, and multiplication. This means that the sum, difference, and product of two polynomials is *always* a polynomial.\n\n- Polynomials are *not* closed under division. This means that the quotient of two polynomials is *not* always a polynomial.\n\nWith that in mind, let's examine our expressions in turn.\n\n- Expression I is a polynomial. It's a sum of two polynomials, and polynomials are closed under addition.\n\n- Expression II is a polynomial. It's a difference between two polynomials, and polynomials are closed under subtraction.\n\n- Expression III gives a polynomial. It's a product of two polynomials, and polynomials are closed under multiplication.\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f34e0d0-1b01-548e-8ace-ce5ffc57a3fe"] :db/ensure [:question/validate]} {:db/id "answer-field-8f34e0d0-1b01-548e-8ace-ce5ffc57a3fe" :answer-field/id #uuid "8f34e0d0-1b01-548e-8ace-ce5ffc57a3fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-73340f47-6707-588d-91fe-a6db909018b2" :answer-field/choices ["answer-62b3d276-65bb-589c-bef8-28434c7b3a4e" "answer-a3288bcb-72e7-5d83-920c-df3c72f026c6" "answer-73340f47-6707-588d-91fe-a6db909018b2" "answer-731874e9-843e-5b25-9236-a231f2d5a98f" "answer-3bd31b5f-4edb-5614-90b1-3db842e42842"] :db/ensure [:answer-field/validate]} {:db/id "answer-62b3d276-65bb-589c-bef8-28434c7b3a4e" :answer/id #uuid "62b3d276-65bb-589c-bef8-28434c7b3a4e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-a3288bcb-72e7-5d83-920c-df3c72f026c6" :answer/id #uuid "a3288bcb-72e7-5d83-920c-df3c72f026c6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-73340f47-6707-588d-91fe-a6db909018b2" :answer/id #uuid "73340f47-6707-588d-91fe-a6db909018b2" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-731874e9-843e-5b25-9236-a231f2d5a98f" :answer/id #uuid "731874e9-843e-5b25-9236-a231f2d5a98f" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-3bd31b5f-4edb-5614-90b1-3db842e42842" :answer/id #uuid "3bd31b5f-4edb-5614-90b1-3db842e42842" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-83c42558-b7ba-54b4-8258-155dbb7534d4" :question/id #uuid "83c42558-b7ba-54b4-8258-155dbb7534d4" :question/math-academy-id "q-141239" :question/problem "Which of the following expressions are polynomials?\n\nI. $(3{x}^{4})\\cdot ({x}^{3}-2x)$\n\nII. $(5x)+(-{x}^{7}-8)$\n\nIII. $(3{x}^{3}-{x}^{2}-1)÷({x}^{3})$" :question/worked-solution "Recall that polynomials have the following closure properties:\n\n- Polynomials are closed under addition, subtraction, and multiplication. This means that the sum, difference, and product of two polynomials is *always* a polynomial.\n\n- Polynomials are *not* closed under division. This means that the quotient of two polynomials is *not* always a polynomial.\n\nWith that in mind, let's examine our expressions in turn.\n\n- Expression I gives a polynomial. It's a product of two polynomials, and polynomials are closed under multiplication.\n\n- Expression II is a polynomial. It's a sum of two polynomials, and polynomials are closed under addition.\n\n- Expression III is *not* a polynomial. Carrying out the division, we get\n\n$$\n\\begin{aligned}\\frac{3{x}^{3}-{x}^{2}-1}{{x}^{3}} & =\\frac{3{x}^{3}}{{x}^{3}}-\\frac{{x}^{2}}{{x}^{3}}-\\frac{1}{{x}^{3}} \\\\  & =3-\\frac{1}{x}-\\frac{1}{{x}^{3}}\\end{aligned}\n$$\n\nwhich is *not* a polynomial.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-68aa1c15-4097-51da-a3fa-04695a76160c"] :db/ensure [:question/validate]} {:db/id "answer-field-68aa1c15-4097-51da-a3fa-04695a76160c" :answer-field/id #uuid "68aa1c15-4097-51da-a3fa-04695a76160c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f14a0e5-b515-5250-8a1b-eb814cf89647" :answer-field/choices ["answer-1f14a0e5-b515-5250-8a1b-eb814cf89647" "answer-5e906c3e-515c-5c94-8ce1-0dfb67aa41c6" "answer-d2074c51-9d9b-528e-97bf-67ff6b78335c" "answer-db4123da-0e66-5dc6-b2de-212a6e29b246" "answer-6a67d87d-b061-5ffd-9986-887ce52f98ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f14a0e5-b515-5250-8a1b-eb814cf89647" :answer/id #uuid "1f14a0e5-b515-5250-8a1b-eb814cf89647" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-5e906c3e-515c-5c94-8ce1-0dfb67aa41c6" :answer/id #uuid "5e906c3e-515c-5c94-8ce1-0dfb67aa41c6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d2074c51-9d9b-528e-97bf-67ff6b78335c" :answer/id #uuid "d2074c51-9d9b-528e-97bf-67ff6b78335c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-db4123da-0e66-5dc6-b2de-212a6e29b246" :answer/id #uuid "db4123da-0e66-5dc6-b2de-212a6e29b246" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-6a67d87d-b061-5ffd-9986-887ce52f98ad" :answer/id #uuid "6a67d87d-b061-5ffd-9986-887ce52f98ad" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-33175368-8c02-5445-a715-949176f366cb" :question/id #uuid "33175368-8c02-5445-a715-949176f366cb" :question/math-academy-id "q-277891" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $3$ and $12$, respectively,  the degree of $P\\cdot Q$ is{{field-1}}." :question/worked-solution "Since $P$ is a polynomial of degree $3,$ the leading term contains an ${x}^{3}.$\n\nSince $Q$ is a polynomial of degree $12,$ the leading term contains an ${x}^{12}.$\n\nIn $P\\cdot Q,$ the ${x}^{3}$ term in $P$ multiplies with the ${x}^{12}$ term in $Q$ to form a term containing ${x}^{3}\\cdot {x}^{12}={x}^{3+12}={x}^{15}.$\n\nTherefore, the degree of $P\\cdot Q$ must be $15.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce49d847-d598-5aa9-ac7a-bc9bb0b2cb3b"] :db/ensure [:question/validate]} {:db/id "answer-field-ce49d847-d598-5aa9-ac7a-bc9bb0b2cb3b" :answer-field/id #uuid "ce49d847-d598-5aa9-ac7a-bc9bb0b2cb3b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-25ab30e4-25f8-5a00-8578-49e889f2c8d2" :answer-field/choices ["answer-25ab30e4-25f8-5a00-8578-49e889f2c8d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-25ab30e4-25f8-5a00-8578-49e889f2c8d2" :answer/id #uuid "25ab30e4-25f8-5a00-8578-49e889f2c8d2" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "question-8fd741b4-3eaf-54db-b2d4-05c07c61f572" :question/id #uuid "8fd741b4-3eaf-54db-b2d4-05c07c61f572" :question/math-academy-id "q-141253" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $3$ and $5$, respectively, what is the degree of $P\\cdot Q?$" :question/worked-solution "Since $P$ is a polynomial of degree $3,$ the leading term contains an ${x}^{3}.$\n\nSince $Q$ is a polynomial of degree $5,$ the leading term contains an ${x}^{5}.$\n\nIn $P\\cdot Q,$ the ${x}^{3}$ term in $P$ multiplies with the ${x}^{5}$ term in $Q$ to form a term containing ${x}^{3}\\cdot {x}^{5}={x}^{3+5}={x}^{8}.$\n\nTherefore, the degree of $P\\cdot Q$ must be $8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e7b0c143-901f-594e-996e-d3db3b783f1d"] :db/ensure [:question/validate]} {:db/id "answer-field-e7b0c143-901f-594e-996e-d3db3b783f1d" :answer-field/id #uuid "e7b0c143-901f-594e-996e-d3db3b783f1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-315f6f41-73d5-5a7c-9f30-bd9a8163e36d" :answer-field/choices ["answer-48c504b3-5dbd-5772-b6de-1051007f0040" "answer-676adfbb-a0fb-55bc-b2d0-8fa166d87f74" "answer-1d36b948-45e9-522f-aa03-f7e65100fc67" "answer-f419ec20-70f8-5eeb-b096-e9b51c1355f8" "answer-315f6f41-73d5-5a7c-9f30-bd9a8163e36d"] :db/ensure [:answer-field/validate]} {:db/id "answer-48c504b3-5dbd-5772-b6de-1051007f0040" :answer/id #uuid "48c504b3-5dbd-5772-b6de-1051007f0040" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-676adfbb-a0fb-55bc-b2d0-8fa166d87f74" :answer/id #uuid "676adfbb-a0fb-55bc-b2d0-8fa166d87f74" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-1d36b948-45e9-522f-aa03-f7e65100fc67" :answer/id #uuid "1d36b948-45e9-522f-aa03-f7e65100fc67" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f419ec20-70f8-5eeb-b096-e9b51c1355f8" :answer/id #uuid "f419ec20-70f8-5eeb-b096-e9b51c1355f8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-315f6f41-73d5-5a7c-9f30-bd9a8163e36d" :answer/id #uuid "315f6f41-73d5-5a7c-9f30-bd9a8163e36d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-d4519b02-5082-5dd4-add0-c15242596fca" :question/id #uuid "d4519b02-5082-5dd4-add0-c15242596fca" :question/math-academy-id "q-111384" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $6$, then what is the **smallest possible** degree of $P-Q?$" :question/worked-solution "The smallest possible degree of $P-Q$ is $0.$\n\nFor example, suppose $P={x}^{6}$ and $Q={x}^{6}+1.$ Then $P-Q=-1,$ which is a polynomial of degree $0.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-47f10e55-2a14-563d-841d-335a4383d49b"] :db/ensure [:question/validate]} {:db/id "answer-field-47f10e55-2a14-563d-841d-335a4383d49b" :answer-field/id #uuid "47f10e55-2a14