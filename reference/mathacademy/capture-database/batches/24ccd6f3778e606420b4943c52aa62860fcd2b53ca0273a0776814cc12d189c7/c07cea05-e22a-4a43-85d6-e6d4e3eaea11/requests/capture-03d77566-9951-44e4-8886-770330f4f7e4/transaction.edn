 :answer-field/id #uuid "e45e0444-e71c-54ae-afbd-b2d40b2407b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a15f3c8-e961-5145-88db-0eb135efb5b4" :answer-field/choices ["answer-cfb17e04-e236-5f22-aeec-e13db4c07375" "answer-8a15f3c8-e961-5145-88db-0eb135efb5b4" "answer-26c7a5d6-1af2-5075-a7bd-450dd0ee43f3" "answer-d424a728-4479-5e44-9ae0-31a47ba3f480" "answer-33743398-b298-5983-bc4d-f2da54e46199"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfb17e04-e236-5f22-aeec-e13db4c07375" :answer/id #uuid "cfb17e04-e236-5f22-aeec-e13db4c07375" :answer/type :answer.type/math :answer/value "-100" :db/ensure [:answer/validate]} {:db/id "answer-8a15f3c8-e961-5145-88db-0eb135efb5b4" :answer/id #uuid "8a15f3c8-e961-5145-88db-0eb135efb5b4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-26c7a5d6-1af2-5075-a7bd-450dd0ee43f3" :answer/id #uuid "26c7a5d6-1af2-5075-a7bd-450dd0ee43f3" :answer/type :answer.type/math :answer/value "0.001" :db/ensure [:answer/validate]} {:db/id "answer-d424a728-4479-5e44-9ae0-31a47ba3f480" :answer/id #uuid "d424a728-4479-5e44-9ae0-31a47ba3f480" :answer/type :answer.type/math :answer/value "0.01" :db/ensure [:answer/validate]} {:db/id "answer-33743398-b298-5983-bc4d-f2da54e46199" :answer/id #uuid "33743398-b298-5983-bc4d-f2da54e46199" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id 17592186064364 :knowledge-point/questions ["question-27d1fbdb-2975-5b0f-9d8e-58c27611f8b1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-27d1fbdb-2975-5b0f-9d8e-58c27611f8b1" :question/id #uuid "27d1fbdb-2975-5b0f-9d8e-58c27611f8b1" :question/math-academy-id "q-181026" :question/problem "$7\\cdot (-0.9)=${{field-1}}" :question/worked-solution "We have a product of a positive number $(7)$ and a negative number $(-0.9).$ So the product will be negative:\n\n$$\n7\\cdot (-0.9)=-\\,\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $7$ by $0.9$ without any signs: $7\\cdot 0.9=6.3.$ So, we get\n\n$$\n7\\cdot (-0.9)=-6.3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fc3af737-6c46-5c87-a738-6dffb7ab08df"] :db/ensure [:question/validate]} {:db/id "answer-field-fc3af737-6c46-5c87-a738-6dffb7ab08df" :answer-field/id #uuid "fc3af737-6c46-5c87-a738-6dffb7ab08df" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a" :answer-field/choices ["answer-2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a" :answer/id #uuid "2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a" :answer/type :answer.type/math :answer/value "-6.3" :db/ensure [:answer/validate]} {:db/id "activity-e4eac077-4f1d-5981-a5d4-0a12ee18ecf9" :activity/id #uuid "e4eac077-4f1d-5981-a5d4-0a12ee18ecf9" :activity/title "Quiz 5" :activity/type :activity.type/assessment :activity/course 17592186046647 :activity/steps ["step-1d362339-07b4-5460-864e-97a3e99ad8b0" "step-e1a053f1-af9f-59fb-bd52-281255ff1c26" "step-feeea7a8-1dfd-5627-b84b-164d0f74b9b0" "step-1b69667b-02bf-5de5-837e-24c52b41afae" "step-88739bad-b1fe-5de7-a797-d8ff3ded8ea1" "step-14073ad5-1bc7-58a3-ba38-cf30e5ac0012" "step-0b06fe31-a4e6-591b-bde8-a03fb5494049" "step-c1578acf-49f4-5a18-9a4f-23e922f21480" "step-ad823232-aaaa-5cda-a180-16a4295f9aed" "step-bdc8647f-7c30-5355-b6b1-d2005ce98062" "step-e78ffec5-1b19-5a7e-8f25-192954cf695a" "step-a18b17f2-41c0-5be0-97e7-71dcdae9c073" "step-91e98bad-7979-59e7-936e-702de839d0d6" "step-f0fccd66-fa86-5d15-88d0-2060e8fb42fb"] :activity/first-step "step-1d362339-07b4-5460-864e-97a3e99ad8b0" :db/ensure [:activity/validate]} {:db/id "step-1d362339-07b4-5460-864e-97a3e99ad8b0" :step/id #uuid "1d362339-07b4-5460-864e-97a3e99ad8b0" :step/content "question-90c33764-1c3e-51f1-880d-65fb7c77f172" :step/next "step-e1a053f1-af9f-59f