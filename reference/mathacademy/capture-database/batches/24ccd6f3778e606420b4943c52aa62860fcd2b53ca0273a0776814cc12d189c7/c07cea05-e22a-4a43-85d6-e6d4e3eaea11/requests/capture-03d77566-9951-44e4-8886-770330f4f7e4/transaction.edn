46-58ca-9b60-fe0a52d9614e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ca1680c8-f47c-5b1b-8548-5d42d12634c6" :question/id #uuid "ca1680c8-f47c-5b1b-8548-5d42d12634c6" :question/math-academy-id "q-341475" :question/problem "$$\n\nIf $y=-2\\operatorname{arcsch}⁡(\\sqrt[4]{x}),$ calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x>0.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,[-2\\operatorname{arcsch}⁡(\\sqrt[4]{x})] \\\\  & =-2\\cdot [-\\frac{1}{|\\sqrt[4]{x}|\\sqrt{1+{(\\sqrt[4]{x})}^{2}}}]\\cdot {(\\sqrt[4]{x})}^{′} \\\\  & =\\frac{2}{\\sqrt[4]{x}\\sqrt{1+\\sqrt{x}}}\\cdot \\frac{1}{4\\sqrt[4]{{x}^{3}}} \\\\  & =\\frac{1}{2x\\sqrt{1+\\sqrt{x}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f068fa89-ce05-5148-b62a-30202a76bdb3"] :db/ensure [:question/validate]} {:db/id "answer-field-f068fa89-ce05-5148-b62a-30202a76bdb3" :answer-field/id #uuid "f068fa89-ce05-5148-b62a-30202a76bdb3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-93683338-b97b-5b47-8572-b2056cda9e98" :answer-field/choices ["answer-93683338-b97b-5b47-8572-b2056cda9e98"] :db/ensure [:answer-field/validate]} {:db/id "answer-93683338-b97b-5b47-8572-b2056cda9e98" :answer/id #uuid "93683338-b97b-5b47-8572-b2056cda9e98" :answer/type :answer.type/math :answer/value "\\frac{1}{2x\\sqrt{1+\\sqrt{x}}}" :db/ensure [:answer/validate]} {:db/id 17592186167378 :question/problem "$$\n\nIf $y=4\\operatorname{ln}⁡x+\\operatorname{arcsch}⁡{x}^{4},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡x+\\operatorname{arcsch}⁡{x}^{4}) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡{x}^{4}) \\\\  & =\\frac{4}{x}+(-\\frac{1}{|{x}^{4}|\\sqrt{1+({x}^{4})^{2}}})\\cdot ({x}^{4})^{′} \\\\  & =\\frac{4}{x}-\\frac{1}{{x}^{4}\\sqrt{1+{x}^{8}}}\\cdot 4{x}^{3} \\\\  & =\\frac{4}{x}-\\frac{4}{x\\sqrt{1+{x}^{8}}} \\\\  & =\\frac{4}{x}(1-\\frac{1}{\\sqrt{1+{x}^{8}}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165476 :answer-field/correct "answer-7f39a794-3765-568c-9788-0c0859104a83" :answer-field/choices ["answer-e839ce63-4bb9-53b7-a7ca-6fd8f3ee858e" "answer-2f805684-7c7e-5830-8bc2-33a31c975e08" "answer-67683680-de16-5a45-a98f-3994dc91a997" "answer-debe51b5-eeec-5077-a1f0-fbae0d3a18d9" "answer-7f39a794-3765-568c-9788-0c0859104a83"] :db/ensure [:answer-field/validate]} {:db/id "answer-e839ce63-4bb9-53b7-a7ca-6fd8f3ee858e" :answer/id #uuid "e839ce63-4bb9-53b7-a7ca-6fd8f3ee858e" :answer/type :answer.type/math :answer/value "4(\\frac{1}{x}+\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/ensure [:answer/validate]} {:db/id "answer-2f805684-7c7e-5830-8bc2-33a31c975e08" :answer/id #uuid "2f805684-7c7e-5830-8bc2-33a31c975e08" :answer/type :answer.type/math :answer/value "4(\\frac{1}{x}-\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/ensure [:answer/validate]} {:db/id "answer-67683680-de16-5a45-a98f-3994dc91a997" :answer/id #uuid "67683680-de16-5a45-a98f-3994dc91a997" :answer/type :answer.type/math :answer/value "\\frac{2}{x}(2-\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/ensure [:answer/validate]} {:db/id "answer-debe51b5-eeec-5077-a1f0-fbae0d3a18d9" :answer/id #uuid "debe51b5-eeec-5077-a1f0-fbae0d3a18d9" :answer/type :answer.type/math :answer/value "\\frac{4}{x}(1+\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/ensure [:answer/validate]} {:db/id "answer-7f39a794-3765-568c-9788-0c0859104a83" :answer/id #uuid "7f39a794-3765-568c-9788-0c0859104a83" :answer/type :answer.type/math :answer/value "\\frac{4}{x}(1-\\frac{1}{\\sqrt{1+{x}^{8}}})" :db/ensure [:answer/validate]} {:db/id "question-ee2856c4-f82b-5153-9418-e0c2792ce17b" :question/id #uuid "ee2856c4-f82b-5153-9418-e0c2792ce17b" :question/math-academy-id "q-95519" :question/problem "$$\n\nIf $y=\\operatorname{arctan}⁡x+\\operatorname{arcsch}⁡({x}^{2}+1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x+\\operatorname{arcsch}⁡({x}^{2}+1)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡({x}^{2}+1)) \\\\  & =\\frac{1}{{x}^{2}+1}+(-\\frac{1}{|{x}^{2}+1|\\sqrt{1+({x}^{2}+1)^{2}}})\\cdot ({x}^{2}+1)^{′} \\\\  & =\\frac{1}{{x}^{2}+1}-\\frac{1}{({x}^{2}+1)\\sqrt{1+{x}^{4}+2{x}^{2}+1}}\\cdot 2x \\\\  & =\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7230352a-4cad-516b-aa5e-9529af383602"] :db/ensure [:question/validate]} {:db/id "answer-field-7230352a-4cad-516b-aa5e-9529af383602" :answer-field/id #uuid "7230352a-4cad-516b-aa5e-9529af383602" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07099b62-b5de-5c35-89a0-02da7d237dd5" :answer-field/choices ["answer-109c4078-1dc2-5f49-97cd-be914eaf3edf" "answer-92f271ed-bbcd-5ac7-8f4f-93ee8ccc4ce9" "answer-07099b62-b5de-5c35-89a0-02da7d237dd5" "answer-c136c3e1-1248-5b47-b929-510459d6c30b" "answer-99e51ccf-d968-5c52-81a9-7aa43ff31aac"] :db/ensure [:answer-field/validate]} {:db/id "answer-109c4078-1dc2-5f49-97cd-be914eaf3edf" :answer/id #uuid "109c4078-1dc2-5f49-97cd-be914eaf3edf" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}(1+\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/ensure [:answer/validate]} {:db/id "answer-92f271ed-bbcd-5ac7-8f4f-93ee8ccc4ce9" :answer/id #uuid "92f271ed-bbcd-5ac7-8f4f-93ee8ccc4ce9" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}(1+\\frac{x}{\\sqrt{{x}^{4}+2}})" :db/ensure [:answer/validate]} {:db/id "answer-07099b62-b5de-5c35-89a0-02da7d237dd5" :answer/id #uuid "07099b62-b5de-5c35-89a0-02da7d237dd5" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/ensure [:answer/validate]} {:db/id "answer-c136c3e1-1248-5b47-b929-510459d6c30b" :answer/id #uuid "c136c3e1-1248-5b47-b929-510459d6c30b" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{2x}{\\sqrt{{x}^{4}+2}})" :db/ensure [:answer/validate]} {:db/id "answer-99e51ccf-d968-5c52-81a9-7aa43ff31aac" :answer/id #uuid "99e51ccf-d968-5c52-81a9-7aa43ff31aac" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}(1-\\frac{x}{\\sqrt{{x}^{4}+2{x}^{2}+2}})" :db/ensure [:answer/validate]} {:db/id "question-aa97bd1f-f2ce-5f6f-ba26-21c15fc2c29a" :question/id #uuid "aa97bd1f-f2ce-5f6f-ba26-21c15fc2c29a" :question/math-academy-id "q-95520" :question/problem "$$\n\nIf $y=6\\operatorname{arcsch}⁡(3x-1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-6\\operatorname{arcsch}⁡(3x-1)) \\\\  & =6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡(3x-1)) \\\\  & =6\\cdot (-\\frac{1}{|3x-1|\\sqrt{1+(3x-1)^{2}}})\\cdot (3x-1)^{′} \\\\  & =-6\\cdot \\frac{1}{|3x-1|\\sqrt{1+9{x}^{2}-6x+1}}\\cdot 3 \\\\  & =-\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aadc444a-ce5f-537d-823a-1f9066caed79"] :db/ensure [:question/validate]} {:db/id "answer-field-aadc444a-ce5f-537d-823a-1f9066caed79" :answer-field/id #uuid "aadc444a-ce5f-537d-823a-1f9066caed79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7609ee66-97eb-5813-aafc-fc892436fd47" :answer-field/choices ["answer-3cf94dd4-3101-57df-8fb6-af244a85af6b" "answer-7609ee66-97eb-5813-aafc-fc892436fd47" "answer-121480c5-f561-5438-8bde-1acc56bc6ff3" "answer-9773a4e4-9e61-52c8-8ddc-223abc70cb19" "answer-19520b3d-6125-58b2-9903-4c322a050cc6"] :db/ensure [:answer-field/validate]} {:db/id "answer-3cf94dd4-3101-57df-8fb6-af244a85af6b" :answer/id #uuid "3cf94dd4-3101-57df-8fb6-af244a85af6b" :answer/type :answer.type/math :answer/value "-\\frac{18}{|3x-1|\\sqrt{3{x}^{2}-2x+1}}" :db/ensure [:answer/validate]} {:db/id "answer-7609ee66-97eb-5813-aafc-fc892436fd47" :answer/id #uuid "7609ee66-97eb-5813-aafc-fc892436fd47" :answer/type :answer.type/math :answer/value "-\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/ensure [:answer/validate]} {:db/id "answer-121480c5-f561-5438-8bde-1acc56bc6ff3" :answer/id #uuid "121480c5-f561-5438-8bde-1acc56bc6ff3" :answer/type :answer.type/math :answer/value "-\\frac{6}{|3x-1|\\sqrt{3{x}^{2}-2x+1}}" :db/ensure [:answer/validate]} {:db/id "answer-9773a4e4-9e61-52c8-8ddc-223abc70cb19" :answer/id #uuid "9773a4e4-9e61-52c8-8ddc-223abc70cb19" :answer/type :answer.type/math :answer/value "\\frac{18}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/ensure [:answer/validate]} {:db/id "answer-19520b3d-6125-58b2-9903-4c322a050cc6" :answer/id #uuid "19520b3d-6125-58b2-9903-4c322a050cc6" :answer/type :answer.type/math :answer/value "\\frac{6}{|3x-1|\\sqrt{9{x}^{2}-6x+2}}" :db/ensure [:answer/validate]} {:db/id "question-f7d0c5e9-6b20-5038-9084-51ca2beb31f0" :question/id #uuid "f7d0c5e9-6b20-5038-9084-51ca2beb31f0" :question/math-academy-id "q-341460" :question/problem "$$\n\nIf $y=-4\\,\\operatorname{arcsch}⁡(3-2x),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{|3-2x|}$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,[-4\\,\\operatorname{arcsch}⁡(3-2x)] \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}\\,[\\operatorname{arcsch}⁡(3-2x)] \\\\  & =-4\\cdot [-\\frac{1}{|3-2x|\\sqrt{1+(3-2x)^{2}}}]\\cdot (3-2x)^{′} \\\\  & =\\frac{4}{|3-2x|\\sqrt{1+(9-12x+4{x}^{2})}}\\cdot (-2) \\\\  & =-\\frac{1}{|3-2x|}\\,\\frac{8}{\\sqrt{10-12x+4{x}^{2}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d4cb4e3c-90dc-5a4e-ad03-801bee72ca2f"] :db/ensure [:question/validate]} {:db/id "answer-field-d4cb4e3c-90dc-5a4e-ad03-801bee72ca2f" :answer-field/id #uuid "d4cb4e3c-90dc-5a4e-ad03-801bee72ca2f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-63d9495c-c41d-5aa2-aeaa-a8b740540555" :answer-field/choices ["answer-63d9495c-c41d-5aa2-aeaa-a8b740540555"] :db/ensure [:answer-field/validate]} {:db/id "answer-63d9495c-c41d-5aa2-aeaa-a8b740540555" :answer/id #uuid "63d9495c-c41d-5aa2-aeaa-a8b740540555" :answer/type :answer.type/math :answer/value "\\frac{8}{\\sqrt{4x^{2}-12x+10}}" :db/ensure [:answer/validate]} {:db/id "question-bd478fb8-ad97-5721-be1e-e2165b917cab" :question/id #uuid "bd478fb8-ad97-5721-be1e-e2165b917cab" :question/math-academy-id "q-95524" :question/problem "$$\n\nIf $y=-\\operatorname{arsech}⁡(x-3),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{arsech}⁡(x-3)) \\\\  & =-(-\\frac{1}{(x-3)\\sqrt{1-(x-3)^{2}}})\\cdot (x-3)^{′} \\\\  & =\\frac{1}{(x-3)\\sqrt{1-{x}^{2}+6x-9}}\\cdot 1 \\\\  & =\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3199a6b3-9ebf-5ee0-ab91-18ad9a99a784"] :db/ensure [:question/validate]} {:db/id "answer-field-3199a6b3-9ebf-5ee0-ab91-18ad9a99a784" :answer-field/id #uuid "3199a6b3-9ebf-5ee0-ab91-18ad9a99a784" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cb4343a1-3927-5329-9b12-c84f24e0a18a" :answer-field/choices ["answer-a4bb3106-2e47-50d0-84fc-a8d09d82a983" "answer-580baff0-5127-514b-bc2e-6c81d289eac9" "answer-cb4343a1-3927-5329-9b12-c84f24e0a18a" "answer-8917544d-559b-577c-8ba8-1430a960ff36" "answer-d1ff5ad7-503f-5dfb-a830-f4530ad208c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4bb3106-2e47-50d0-84fc-a8d09d82a983" :answer/id #uuid "a4bb3106-2e47-50d0-84fc-a8d09d82a983" :answer/type :answer.type/math :answer/value "-\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/ensure [:answer/validate]} {:db/id "answer-580baff0-5127-514b-bc2e-6c81d289eac9" :answer/id #uuid "580baff0-5127-514b-bc2e-6c81d289eac9" :answer/type :answer.type/math :answer/value "-\\frac{1}{(x-3)\\sqrt{{x}^{2}-6x+8}}" :db/ensure [:answer/validate]} {:db/id "answer-cb4343a