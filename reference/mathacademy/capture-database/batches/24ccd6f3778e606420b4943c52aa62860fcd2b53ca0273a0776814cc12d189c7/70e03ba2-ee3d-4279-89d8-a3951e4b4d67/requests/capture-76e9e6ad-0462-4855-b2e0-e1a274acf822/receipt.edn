rcumference of a circle is ![](images/63/636374af24eb4d5c435de97b8e1ac460148deba4916b0954e3d1d2f7a364f9d7.svg) where ![](images/31/3122e2ea79ab0512edfce5c875a099de1a7067581b658d1b8fc9c105277aed36.svg) is the radius. Therefore, we have \n![](images/15/15bff81cb45d3df680e782e69534d2489388dfbcfd12b3cd579298d03f8bd452.svg)\n\nFinally, the length of the border is\n![](images/15/15037adbdea6b21d54991917b5dad6108c60257fd8f509300642343a101ebeeb.svg)" 13194139535332 17592186045417 true] [17592186497490 1065 15549 13194139535332 17592186045417 true] [17592186497490 1066 #uuid "a14139c8-87eb-5e69-a268-c7cb088cf812" 13194139535332 17592186045417 true] [17592186497490 1067 "Calculating the Length of a Part of a Circle" 13194139535332 17592186045417 true]] :edb/tempids {"activity-245d9117-62b6-5cd4-a894-dc26b3c85ce0" 17592186496645 "activity-3a3a3cd6-f7f4-55d3-b9f0-51b6efa29ace" 17592186496646 "activity-4b16e189-7cae-52c7-b4b2-a5ce8c27642e" 17592186496647 "activity-5705edea-b336-51ef-88f9-19f848c1f228" 17592186496648 "activity-7a5a6986-cd36-531a-9f9c-dcfb6003f956" 17592186496649 "activity-7dbc97d0-d2e5-5a31-9865-e4bc3b4b7c2e" 17592186496650 "activity-81d8d903-aecb-5a17-a0cd-bd743d8e8e9a" 17592186496651 "activity-827fbf6e-9511-507b-adad-43d709f85170" 17592186496652 "activity-8b065634-803f-5739-9336-86488fa97262" 17592186496653 "activity-90858bbd-4be9-59a1-90ae-3a0211b98927" 17592186496654 "activity-96b6d663-08d7-585e-8073-b5b5fe80dad2" 17592186496655 "activity-b003c2d7-68ae-5238-bc0f-46f982a5621d" 17592186496656 "activity-cbb9bff8-0fb7-50be-adc5-7623e34f2040" 17592186496657 "activity-f54f5ad8-3bb5-5eec-b65a-dbed1b53f523" 17592186496658 "answer-00d61264-f40f-5d03-8c04-a35fe010f7f3" 17592186496659 "answer-00fd6574-74c6-5472-8ec2-afc12139c3ab" 17592186496660 "answer-0157b7bd-12dd-5467-9e0b-69e6b3b508f7" 17592186496661 "answer-033f2fdc-fe43-5a14-be7f-944d2c6065ac" 17592186496662 "answer-0342a05b-3acf-5c2d-a620-4ebb95fdb8e2" 17592186496663 "answer-034d9a67-8763-5c70-b5b9-7febdebfdaf9" 