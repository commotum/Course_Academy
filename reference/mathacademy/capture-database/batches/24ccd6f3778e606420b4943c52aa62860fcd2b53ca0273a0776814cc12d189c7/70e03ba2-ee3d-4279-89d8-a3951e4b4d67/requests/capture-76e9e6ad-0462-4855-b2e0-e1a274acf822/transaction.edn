-1} & = \\\\ \\frac{w+1}{\\sqrt{2w+3}-1}\\cdot \\frac{\\sqrt{2w+3}+1}{\\sqrt{2w+3}+1} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{(\\sqrt{2w+3}-1)(\\sqrt{2w+3}+1)} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{(\\sqrt{2w+3})^{2}-{1}^{2}} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{2w+3-1} & = \\\\ \\frac{(w+1)(\\sqrt{2w+3}+1)}{2w+2} & = \\\\ \\frac{\\cancel{(w+1)}(\\sqrt{2w+3}+1)}{2\\cancel{(w+1)}} & = \\\\ \\frac{\\sqrt{2w+3}+1}{2} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5bc4d4eb-b093-5f42-bf15-0372a2d6d50b"] :db/ensure [:question/validate]} {:db/id "answer-field-5bc4d4eb-b093-5f42-bf15-0372a2d6d50b" :answer-field/id #uuid "5bc4d4eb-b093-5f42-bf15-0372a2d6d50b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" :answer-field/choices ["answer-9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" "answer-58b04e7f-48fb-5d60-9894-e699ad85fce0" "answer-59ba9695-6e1c-5180-8ee9-758ebad42ea3" "answer-0bb361c6-6dd5-552c-a427-a36cf070b655" "answer-4881d5c1-1bbc-586e-9272-b79e718a7ae0"] :db/ensure [:answer-field/validate]} {:db/id "answer-9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" :answer/id #uuid "9fc00c71-a5e7-57f3-b1b5-fd9dc5eab57b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2w+3}+1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-58b04e7f-48fb-5d60-9894-e699ad85fce0" :answer/id #uuid "58b04e7f-48fb-5d60-9894-e699ad85fce0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2w+3}+2}{4}" :db/ensure [:answer/validate]} {:db/id "answer-59ba9695-6e1c-5180-8ee9-758ebad42ea3" :answer/id #uuid "59ba9695-6e1c-5180-8ee9-758ebad42ea3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2w+3}+4}{2}" :db/ensure [:answer/validate]} {:db/id "answer-0bb361c6-6dd5-552c-a427-a36cf070b655" :answer/id #uuid "0bb361c6-6dd5-552c-a427-a36cf070b655" :answer/type :answer.type/math :answer/value "\\frac{w(\\sqrt{2w+3}+1)}{w+1}" :db/ensure [:answer/validate]} {:db/id "answer-4881d5c1-1bbc-586e-9272-b79e718a7ae0" :answer/id #uuid "4881d5c1-1bbc-586e-9272-b79e718a7ae0" :answer/type :answer.type/math :answer/value "\\frac{w(\\sqrt{2w+3}+1)}{w+4}" :db/ensure [:answer/validate]} {:db/id "question-48232a69-9972-5f32-be1d-adbffa500e27" :question/id #uuid "48232a69-9972-5f32-be1d-adbffa500e27" :question/math-academy-id "q-296049" :question/problem "Rationalize the denominator of $\\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x+3}+\\sqrt{x+5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x+3}+\\sqrt{x+5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}} & = \\\\ \\frac{12}{\\sqrt{x+3}-\\sqrt{x+5}}\\cdot \\frac{\\sqrt{x+3}+\\sqrt{x+5}}{\\sqrt{x+3}+\\sqrt{x+5}} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(\\sqrt{x+3}+\\sqrt{x+5})(\\sqrt{x+3}+\\sqrt{x+5})} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(\\sqrt{x+3})^{2}-(\\sqrt{x+5})^{2}} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{(x+3)-(x+5)} & = \\\\ \\frac{12(\\sqrt{x+3}+\\sqrt{x+5})}{-2} & = \\\\ -6(\\sqrt{x+3}+\\sqrt{x+5})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e48e28cb-69c5-5ec3-b0b0-45cd22625ed2"] :db/ensure [:question/validate]} {:db/id "answer-field-e48e28cb-69c5-5ec3-b0b0-45cd22625ed2" :answer-field/id #uuid "e48e28cb-69c5-5ec3-b0b0-45cd22625ed2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d2128cd1-c593-59ee-8c09-21ce7bd84ce2" :answer-field/choices ["answer-82b190a0-3b5e-5790-9137-dada26dc5d6c" "answer-d2128cd1-c593-59ee-8c09-21ce7bd84ce2" "answer-cff26320-aaef-57fe-a31f-7c3b21af878a" "answer-1b65670a-a896-5610-82ac-5751ceff85c7" "answer-4ef52864-87e6-5b65-8775-27fca6c3a068"] :db/ensure [:answer-field/validate]} {:db/id "answer-82b190a0-3b5e-5790-9137-dada26dc5d6