"ada425c5-b3e7-5d8d-b301-db69b1684794" :question/math-academy-id "q-93094" :question/problem "Find the root of $f(x)=\\sqrt[4]{5x+16}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{5x+16}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{5x+16}-3 & =0 \\\\ \\sqrt[4]{5x+16} & =3 \\\\ (\\sqrt[4]{5x+16})^{4} & ={3}^{4} \\\\ 5x+16 & =81 \\\\ 5x & =65 \\\\ x & =13\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[4]{5\\cdot 13+16}-3 & =0 \\\\ \\sqrt[4]{81}-3 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=13.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0ad4260c-8e97-5454-9134-e3f06df178d5"] :db/ensure [:question/validate]} {:db/id "answer-field-0ad4260c-8e97-5454-9134-e3f06df178d5" :answer-field/id #uuid "0ad4260c-8e97-5454-9134-e3f06df178d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b91291c1-894c-5965-a1d5-d74e6d1467b2" :answer-field/choices ["answer-fdd7dead-c868-5a9b-8f89-5ca1d29c68d3" "answer-2aa479b5-5f37-5765-b689-84f1f509d932" "answer-b91291c1-894c-5965-a1d5-d74e6d1467b2" "answer-8aa6a0be-fc71-52d0-8360-661bc76de157" "answer-dfc57bab-01e9-564f-8f0a-666d810f1754"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdd7dead-c868-5a9b-8f89-5ca1d29c68d3" :answer/id #uuid "fdd7dead-c868-5a9b-8f89-5ca1d29c68d3" :answer/type :answer.type/math :answer/value "x=-15" :db/ensure [:answer/validate]} {:db/id "answer-2aa479b5-5f37-5765-b689-84f1f509d932" :answer/id #uuid "2aa479b5-5f37-5765-b689-84f1f509d932" :answer/type :answer.type/math :answer/value "x=11" :db/ensure [:answer/validate]} {:db/id "answer-b91291c1-894c-5965-a1d5-d74e6d1467b2" :answer/id #uuid "b91291c1-894c-5965-a1d5-d74e6d1467b2" :answer/type :answer.type/math :answer/value "x=13" :db/ensure [:answer/validate]} {:db/id "answer-8aa6a0be-fc71-52d0-8360-661bc76de157" :answer/id #uuid "8aa6a0be-fc71-52d0-8360-661bc76de157" :answer/type :answer.type/math :answer/value "x=\\pm 13" :db/ensure [:answer/validate]} {:db/id "answer-dfc57bab-01e9-564f-8f0a-666d810f1754" :answer/id #uuid "dfc57bab-01e9-564f-8f0a-666d810f1754" :answer/type :answer.type/text :answer/value "The function has no root" :db/ensure [:answer/validate]} {:db/id 17592186172023 :knowledge-point/questions ["question-98b881b2-8a42-522a-b7c6-2baeb5b35a53"] :db/ensure [:knowledge-point/validate]} {:db/id "question-98b881b2-8a42-522a-b7c6-2baeb5b35a53" :question/id #uuid "98b881b2-8a42-522a-b7c6-2baeb5b35a53" :question/math-academy-id "q-102542" :question/problem "Find the root of $f(x)=-3\\sqrt[7]{8x+11}+3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-3\\sqrt[7]{8x+11}+3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-3\\sqrt[7]{8x+11}+3 & =0 \\\\ -3\\sqrt[7]{8x+11} & =-3 \\\\ \\sqrt[7]{8x+11} & =1 \\\\ (\\sqrt[7]{8x+11})^{7} & ={1}^{7} \\\\ 8x+11 & =1 \\\\ 8x & =-10 \\\\ x & =-\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-\\frac{5}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3118cc79-2021-56b0-9cd9-4a79cc9d70d2"] :db/ensure [:question/validate]} {:db/id "answer-field-3118cc79-2021-56b0-9cd9-4a79cc9d70d2" :answer-field/id #uuid "3118cc79-2021-56b0-9cd9-4a79cc9d70d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c77b91a6-7524-58c0-91a9-ca26343172cb" :answer-field/choices ["answer-32fa1ff7-bcf0-5372-805c-7d99fa85f675" "answer-c77b91a6-7524-58c0-91a9-ca26343172cb" "answer-359b1b7a-7b55-5b2a-9755-d7b733425355" "answer-0afd0c8d-8c16-5991-a407-bb6c1438b8e0" "answer-d85b8f82-222f-5031-a5a9-252b0bdec0c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-32fa1ff7-b