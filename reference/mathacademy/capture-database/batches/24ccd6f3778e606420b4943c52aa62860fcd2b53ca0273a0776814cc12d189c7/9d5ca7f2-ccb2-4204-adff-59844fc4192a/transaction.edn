ef-9c9f-53a7-8ced-5bfd1d9ebce1" :answer/type :answer.type/math :answer/value "N∨M" :db/ensure [:answer/validate]} {:db/id 17592186157241 :knowledge-point/questions ["question-7fde2761-bb61-54c2-b335-1663af74408b" "question-ac648f3a-f305-5539-9491-09df3a7946e8" "question-1fc90f62-3260-577e-8311-14eaab4c330e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7fde2761-bb61-54c2-b335-1663af74408b" :question/id #uuid "7fde2761-bb61-54c2-b335-1663af74408b" :question/math-academy-id "q-83008" :question/problem "Simplify the following sentence: \"The watch is a wristwatch, or it is a pocket watch or it is a wristwatch.\"" :question/worked-solution "Using the commutative law, we can replace the phrase \"it is a pocket watch or it is a wristwatch\" with the phrase \"it is a wristwatch or it is a pocket watch.\" The sentence now reads\n\n\"The watch is a wristwatch, or it is a wristwatch or it is a pocket watch.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The watch is a wristwatch or it is a wristwatch, or it is a pocket watch.\"\n\nNow, we can simplify the phrase \"The watch is a wristwatch or it is a wristwatch\" to just \"The watch is a wristwatch.\" The sentence now reads\n\n\"The watch is a wristwatch, or it is a pocket watch.\"\n\nFinally, we can write the sentence more concisely:\n\n\"The watch is a wristwatch or a pocket watch.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9fa32171-20f1-5887-97bc-5d22ef44e87f"] :db/ensure [:question/validate]} {:db/id "answer-field-9fa32171-20f1-5887-97bc-5d22ef44e87f" :answer-field/id #uuid "9fa32171-20f1-5887-97bc-5d22ef44e87f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9cfd6ddb-60b6-564c-9317-a578e95fbffe" :answer-field/choices ["answer-ae7514c8-4086-527f-88a3-f7a45259b01a" "answer-e0575ef3-44fd-581e-9d8e-8d14ff44662f" "answer-1dbf8da0-fa61-52fd-9a6c-a7edbc60ad7e" "answer-9cfd6ddb-60b6-564c-9317-