 :db/ensure [:answer/validate]} {:db/id "answer-7ff860e9-1ecb-5c31-af96-b7c4314465c8" :answer/id #uuid "7ff860e9-1ecb-5c31-af96-b7c4314465c8" :answer/type :answer.type/text :answer/value "The juice is strawberry" :db/ensure [:answer/validate]} {:db/id 17592186157242 :knowledge-point/questions ["question-b8b24239-40f1-5136-9956-57abae0c726e" "question-5aad22c2-f4b5-5b1b-92ab-159f5eea4c65" "question-0268bb49-20bf-526d-b894-f6feb846e8a0" "question-fd1f6b88-5ede-50c3-bec3-63756a7c54a9" "question-6f4a26a2-aaa2-5db2-88b4-6bb08153b831"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b8b24239-40f1-5136-9956-57abae0c726e" :question/id #uuid "b8b24239-40f1-5136-9956-57abae0c726e" :question/math-academy-id "q-83016" :question/problem "Simplify $P∨(Q∨P).$" :question/worked-solution "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}P∨(Q∨P) & ≡P∨(P∨Q) \\\\  & ≡(P∨P)∨Q \\\\  & ≡P∨Q.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d7957362-7aab-525b-b527-7c314c364d56"] :db/ensure [:question/validate]} {:db/id "answer-field-d7957362-7aab-525b-b527-7c314c364d56" :answer-field/id #uuid "d7957362-7aab-525b-b527-7c314c364d56" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97822d8a-3aff-518e-abc9-9e9d7d91e9d3" :answer-field/choices ["answer-61ae890b-0ba2-5131-a806-a7d9e03bc836" "answer-c93ffbeb-8751-5d7e-a9b6-48a4a9215956" "answer-4d3ae000-e416-54e1-88ce-65be7c22e71c" "answer-97822d8a-3aff-518e-abc9-9e9d7d91e9d3" "answer-9d077b2f-2317-542b-8f04-527868cded9b"] :db/ensure [:answer-field/validate]} {:db/id "answer-61ae890b-0ba2-5131-a806-a7d9e03bc836" :answer/id #uuid "61ae890b-0ba2-5131-a806-a7d9e03bc836" :answer/type :answer.type/math :answer/value "P" :db/ensure [:answer/validate]} {:db/id "answer-c93ffbeb-8751-5d7e-a9b6-48a4a9215956" :answer/id #uuid "c93ffbeb-8751-5d7e-a9b6-48a4a9215956" :answer/type :answer.type/math :answer/value "P∧(Q∨P)" :db/ensure [:answer/validate]} {:db/id "answer-4d3ae000-e416-54e1-88ce-65be7c22e71c" :answer/id #uuid "4d3ae000-e416-54e1-88ce-65be7c22e71c" :answer/type :answer.type/math :answer/value "P∧Q" :db/ensure [:answer/validate]} {:db/id "answer-97822d8a-3aff-518e-abc9-9e9d7d91e9d3" :answer/id #uuid "97822d8a-3aff-518e-abc9-9e9d7d91e9d3" :answer/type :answer.type/math :answer/value "P∨Q" :db/ensure [:answer/validate]} {:db/id "answer-9d077b2f-2317-542b-8f04-527868cded9b" :answer/id #uuid "9d077b2f-2317-542b-8f04-527868cded9b" :answer/type :answer.type/math :answer/value "Q" :db/ensure [:answer/validate]} {:db/id "question-5aad22c2-f4b5-5b1b-92ab-159f5eea4c65" :question/id #uuid "5aad22c2-f4b5-5b1b-92ab-159f5eea4c65" :question/math-academy-id "q-128616" :question/problem "Simplify $(A∨B)∨A.$" :question/worked-solution "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∨B)∨A & ≡(B∨A)∨A \\\\  & ≡B∨(A∨A) \\\\  & ≡B∨A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eb39d5b7-afe7-5304-9593-d45a86244179"] :db/ensure [:question/validate]} {:db/id "answer-field-eb39d5b7-afe7-5304-9593-d45a86244179" :answer-field/id #uuid "eb39d5b7-afe7-5304-9593-d45a86244179" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83e753b0-ad8d-59e9-b744-b3bc1620b5a7" :answer-field/choices ["answer-473f1abd-f24c-5e83-aa4b-ba852c22e489" "answer-a84af6db-a147-5333-bbd1-35ac479b2e48" "answer-645bff79-8345-53ff-9db5-d834609884bb" "answer-428a7000-87f8-574a-b165-faf77e2503d9" "answer-83e753b0-ad8d-59e9-b744-b3bc1620b5a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-473f1abd-f24c-5e83-aa4b-ba852c22e489" :answer/id #uuid "473f1abd-f24c-5e83-aa4b-ba852c22e489" :answer/type :answer.type/math :answer/value "A" :db/ensure [:answer/validate]} {:db/id "answer-a84af6db-a147-5333-bbd1-35ac479b2e48" :answer/id #uuid "a84af6db-a147-5333-bbd1-35ac479b2e48" :answer/type :answer.type/math :answer/value "A∧(B∨A)" :db/ensure [:answer/validate]} {:db/id "answer-645bff79-8345-53ff-9db5-d834609884bb" :answer/id #uuid "645bff79-8345-53ff-9db5-d834609884bb" :answer/type :answer.type/math :answer/value "B" :db/ensure [:answer/validate]} {:db/id "answer-428a7000-87f8-574a-b165-faf77e2503d9" :answer/id #uuid "428a7000-87f8-574a-b165-faf77e2503d9" :answer/type :answer.type/math :answer/value "B∧A" :db/ensure [:answer/validate]} {:db/id "answer-83e753b0-ad8d-59e9-b744-b3bc1620b5a7" :answer/id #uuid "83e753b0-ad8d-59e9-b744-b3bc1620b5a7" :answer/type :answer.type/math :answer/value "B∨A" :db/ensure [:answer/validate]} {:db/id "question-0268bb49-20bf-526d-b894-f6feb846e8a0" :question/id #uuid "0268bb49-20bf-526d-b894-f6feb846e8a0" :question/math-academy-id "q-83019" :question/problem "Simplify $(A∨B)∨(C∨B).$" :question/worked-solution "Using the associative, commutative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∨B)∨(C∨B) & ≡(A∨B)∨(B∨C) \\\\  & ≡A∨(B∨B)∨C \\\\  & ≡A∨B∨C \\\\  & ≡A∨C∨B \\\\  & ≡(A∨C)∨B.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-730a3a57-2813-527b-aba4-8d7d6fcf61ef"] :db/ensure [:question/validate]} {:db/id "answer-field-730a3a57-2813-527b-aba4-8d7d6fcf61ef" :answer-field/id #uuid "730a3a57-2813-527b-aba4-8d7d6fcf61ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0f15ef4-dce3-572a-a6fa-42cc2175cc99" :answer-field/choices ["answer-44a4fac6-cae7-5e38-920f-49434cc841c6" "answer-b0f15ef4-dce3-572a-a6fa-42cc2175cc99" "answer-b8f552b0-c912-58c1-af76-a07b69cd681f" "answer-9df37840-4f95-58d0-9255-4bf4ff868e29" "answer-68233117-22ad-5c96-b609-248f60a2900b"] :db/ensure [:answer-field/validate]} {:db/id "answer-44a4fac6-cae7-5e38-920f-49434cc841c6" :answer/id #uuid "44a4fac6-cae7-5e38-920f-49434cc841c6" :answer/type :answer.type/math :answer/value "(A∨C)∧B" :db/ensure [:answer/validate]} {:db/id "answer-b0f15ef4-dce3-572a-a6fa-42cc2175cc99" :answer/id #uuid "b0f15ef4-dce3-572a-a6fa-42cc2175cc99" :answer/type :answer.type/math :answer/value "(A∨C)∨B" :db/ensure [:answer/validate]} {:db/id "answer-b8f552b0-c912-58c1-af76-a07b69cd681f" :answer/id #uuid "b8f552b0-c912-58c1-af76-a07b69cd681f" :answer/type :answer.type/math :answer/value "A∧C" :db/ensure [:answer/validate]} {:db/id "answer-9df37840-4f95-58d0-9255-4bf4ff868e29" :answer/id #uuid "9df37840-4f95-58d0-9255-4bf4ff868e29" :answer/type :answer.type/math :answer/value "A∨(B∧C)" :db/ensure [:answer/validate]} {:db/id "answer-68233117-22ad-5c96-b609-248f60a2900b" :answer/id #uuid "68233117-22ad-5c96-b609-248f60a2900b" :answer/type :answer.type/math :answer/value "A∨C" :db/ensure [:answer/validate]} {:db/id "question-fd1f6b88-5ede-50c3-bec3-63756a7c54a9" :question/id #uuid "fd1f6b88-5ede-50c3-bec3-63756a7c54a9" :question/math-academy-id "q-89270" :question/problem "Simplify $(Q∧P)∧Q.$" :question/worked-solution "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(Q∧P)∧Q & ≡(P∧Q)∧Q \\\\  & ≡P∧(Q∧Q) \\\\  & ≡P∧Q.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1d58cc7b-ecd6-527b-9efa-1509bf12fa3c"] :db/ensure [:question/validate]} {:db/id "answer-field-1d58cc7b-ecd6-527b-9efa-1509bf12fa3c" :answer-field/id #uuid "1d58cc7b-ecd6-527b-9efa-1509bf12fa3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c419c62-6537-5483-be7d-63387bb812ce" :answer-field/choices ["answer-c7e39c39-8e8e-5e07-928c-9dddcece1e0b" "answer-4c419c62-6537-5483-be7d-63387bb812ce" "answer-b0844a72-97da-517c-b6b2-50aad205bcb2" "answer-6a38bdaa-fadc-5e9d-ba1f-5a45a5c5fdc0" "answer-eecd006e-5aec-5cdf-9322-06355a5bab59"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7e39c39-8e8e-5e07-928c-9dddcece1e0b" :answer/id #uuid "c7e39c39-8e8e-5e07-928c-9dddcece1e0b" :answer/type :answer.type/math :answer/value "P" :db/ensure [:answer/validate]} {:db/id "answer-4c419c62-6537-5483-be7d-63387bb812ce" :answer/id #uuid "4c419c62-6537-5483-be7d-63387bb812ce" :answer/type :answer.type/math :answer/value "P∧Q" :db/ensure [:answer/validate]} {:db/id "answer-b0844a72-97da-517c-b6b2-50aad205bcb2" :answer/id #uuid "b0844a72-97da-517c-b6b2-50aad205bcb2" :answer/type :answer.type/math :answer/value "P∨Q" :db/ensure [:answer/validate]} {:db/id "answer-6a38bdaa-fadc-5e9d-ba1f-5a45a5c5fdc0" :answer/id #uuid "6a38bdaa-fadc-5e9d-ba1f-5a45a5c5fdc0" :answer/type :answer.type/math :answer/value "Q" :db/ensure [:answer/validate]} {:db/id "answer-eecd006e-5aec-5cdf-9322-06355a5bab59" :answer/id #uuid "eecd006e-5aec-5cdf-9322-06355a5bab59" :answer/type :answer.type/math :answer/value "Q∧(P∨Q)" :db/ensure [:answer/validate]} {:db/id "question-6f4a26a2-aaa2-5db2-88b4-6bb08153b831" :question/id #uuid "6f4a26a2-aaa2-5db2-88b4-6bb08153b831" :question/math-academy-id "q-128618" :question/problem "Simplify $(A∧A)∧(B∧A).$" :question/worked-solution "Using the associative, commutative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∧A)∧(B∧A) & ≡A∧(B∧A) \\\\  & ≡A∧(A∧B) \\\\  & ≡(A∧A)∧B \\\\  & ≡A∧B.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-38c6fbdd-5036-5358-ab1d-244d3bcd97f1"] :db/ensure [:question/validate]} {:db/id "answer-field-38c6fbdd-5036-5358-ab1d-244d3bcd97f1" :answer-field/id #uuid "38c6fbdd-5036-5358-ab1d-244d3bcd97f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5666b383-f628-5688-8d52-1dc2ee45d358" :answer-field/choices ["answer-70633ca9-81c5-5b12-a10f-fc37d1c8c1de" "answer-936f6959-c158-5c5b-8f54-4981edde6788" "answer-5666b383-f628-5688-8d52-1dc2ee45d358" "answer-e2b35641-aabc-59a7-b441-76325f052af0" "answer-435d8367-673b-5d54-8bc6-22c8eee6fbe4"] :db/ensure [:answer-field/validate]} {:db/id "answer-70633ca9-81c5-5b12-a10f-fc37d1c8c1de" :answer/id #uuid "70633ca9-81c5-5b12-a10f-fc37d1c8c1de" :answer/type :answer.type/math :answer/value "(A∧B)∨B" :db/ensure [:answer/validate]} {:db/id "answer-936f6959-c158-5c5b-8f54-4981edde6788" :answer/id #uuid "936f6959-c158-5c5b-8f54-4981edde6788" :answer/type :answer.type/math :answer/value "A" :db/ensure [:answer/validate]} {:db/id "answer-5666b383-f628-5688-8d52-1dc2ee45d358" :answer/id #uuid "5666b383-f628-5688-8d52-1dc2ee45d358" :answer/type :answer.type/math :answer/value "A∧B" :db/ensure [:answer/validate]} {:db/id "answer-e2b35641-aabc-59a7-b441-76325f052af0" :answer/id #uuid "e2b35641-aabc-59a7-b441-76325f052af0" :answer/type :answer.type/math :answer/value "A∨B" :db/ensure [:answer/validate]} {:db/id "answer-435d8367-673b-5d54-8bc6-22c8eee6fbe4" :answer/id #uuid "435d8367-673b-5d54-8bc6-22c8eee6fbe4" :answer/type :answer.type/math :answer/value "B" :db/ensure [:answer/validate]} {:db/id 17592186158576 :tutorial/content "The **associative law for conjunctions** states that when we have multiple conjunctions in a row, the placement of parentheses does not matter:\n\n$$\n(A \\land B) \\land C \\equiv A \\land (B \\land C)\n$$\n\nWe can prove this equivalence using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,C\\,$ | $\\, A \\land B\\,$ | $\\, B \\land C\\,$ | $\\, (A \\land B) \\land C\\,$ | $\\, A\\land (B \\land C)\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the associative law for conjunctions amounts to moving a comma between \"and\" statements. For example, the associative law states that the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{and}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the turtle is slow}}_{C}\n$$\n\nis logically equivalent to the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{A} \\quad ,  \\quad \\underbrace{\\vphantom{p}\\textrm{and}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{(B} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\textrm{the turtle is slow}}_{C)}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186158586 :tutorial/content "The **associative law for disjunctions** is similar:\n\n$$\n(A \\lor B) \\lor C \\equiv A \\lor (B \\lor C)\n$$\n\nWe can prove this equivalence using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,C\\,$ | $\\, A \\lor B\\,$ | $\\, B \\lor C\\,$ | $\\, (A \\lor B) \\lor C\\,$ | $\\, A\\lor (B \\lor C)\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the associative law for disjunctions amounts to moving a comma between \"or\" statements. For example, the associative law states that the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{or}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the turtle is slow}}_{C}\n$$\n\nis logically equivalent to the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{A} \\quad ,  \\quad \\underbrace{\\vphantom{p}\\textrm{or}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{(B} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\textrm{the turtle is slow}}_{C)}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186158577 :tutorial/content "The **commutative law for conjunctions** states that we can switch the order of a conjunction:\n\n$$\nA \\land B \\equiv B \\land A\n$$\n\nWe can prove this result using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ | $\\,B \\land A\\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the commutative law for conjunctions amounts to swapping two phrases surrounding the word \"and.\" For example, the commutative law states that the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)}\n$$\n\nis logically equivalent to the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The dog is loud}}_{(B} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the cat is quiet}}_{A)}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186158587 :tutorial/content "The **commutative law for disjunctions** is similar:\n\n$$\nA \\lor B \\equiv B \\lor A\n$$\n\nWe can prove this result using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\lor B\\,$ | $\\,B \\lor A\\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nLikewise, in natural language, the commutative law for disjunctions amounts to swapping two phrases surrounding the word \"or.\" For example, the commutative law states that the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)}\n$$\n\nis logically equivalent to the sentence\n\n$$\n\\underbrace{\\vphantom{p}\\textrm{The dog is loud}}_{(B} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the cat is quiet}}_{A)}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186157487 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186059992 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186059695 :knowledge-point/questions ["question-1eda43e3-b2a8-5d39-8cf8-7675e676743f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1eda43e3-b2a8-5d39-8cf8-7675e676743f" :question/id #uuid "1eda43e3-b2a8-5d39-8cf8-7675e676743f" :question/math-academy-id "q-32562" :question/problem "Solve for $x$ if ${log}_{3}⁡(x-5)=2.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}⁡(x-5) & =2 \\\\ {3}^{{log}_{3}⁡(x-5)} & ={3}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}⁡(x-5)}=x-5.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-5 & ={3}^{2} \\\\ x-5 & =9 \\\\ x & =14.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8b5d6150-ecf7-5f47-90e3-e6ef4745bb15"] :db/ensure [:question/validate]} {:db/id "answer-field-8b5d6150-ecf7-5f47-90e3-e6ef4745bb15" :answer-field/id #uuid "8b5d6150-ecf7-5f47-90e3-e6ef4745bb15" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer-field/choices ["answer-e104f5da-37f8-5cb6-904e-3df340074d96" "answer-6c76201f-926d-58e3-bd27-4d3220521737" "answer-04d4eaef-9aba-53fe-a0d9-58ac9c1d7a58" "answer-76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" "answer-39c2689e-7e14-5399-b564-9ce98c16d49c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e104f5da-37f8-5cb6-904e-3df340074d96" :answer/id #uuid "e104f5da-37f8-5cb6-904e-3df340074d96" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-6c76201f-926d-58e3-bd27-4d3220521737" :answer/id #uuid "6c76201f-926d-58e3-bd27-4d3220521737" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-04d4eaef-9aba-53fe-a0d9-58ac9c1d7a58" :answer/id #uuid "04d4eaef-9aba-53fe-a0d9-58ac9c1d7a58" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer/id #uuid "76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-39c2689e-7e14-5399-b564-9ce98c16d49c" :answer/id #uuid "39c2689e-7e14-5399-b564-9ce98c16d49c" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id 17592186059795 :knowledge-point/questions ["question-2f3b2436-4186-5dc4-8dde-9327a375de0e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2f3b2436-4186-5dc4-8dde-9327a375de0e" :question/id #uuid "2f3b2436-4186-5dc4-8dde-9327a375de0e" :question/math-academy-id "q-79388" :question/problem "If $7{log}_{5}⁡x-2{log}_{5}⁡x=10$, then what is the value of  $x?$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}7{log}_{5}⁡x-2{log}_{5}⁡x & =10 \\\\ (7-2){log}_{5}⁡x & =10 \\\\ 5{log}_{5}⁡x & =10 \\\\ {log}_{5}⁡x & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $5,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{5}⁡x & =2 \\\\ {5}^{{log}_{5}⁡x} & ={5}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${5}^{{log}_{5}⁡x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={5}^{2} \\\\ x & =25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d37a1738-f25e-5f6b-a20f-5e8e1491c6e4"] :db/ensure [:question/validate]} {:db/id "answer-field-d37a1738-f25e-5f6b-a20f-5e8e1491c6e4" :answer-field/id #uuid "d37a1738-f25e-5f6b-a20f-5e8e1491c6e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer-field/choices ["answer-0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" "answer-ce3a8353-c68e-51e9-a47a-944828e4d592" "answer-c61569de-9294-5a88-bfce-3bd6bd5b4e54" "answer-6d19565f-be3c-551f-8d53-cfc198fd1d80" "answer-c46e478d-c5ed-5093-9e4a-7df29e99dfc4"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer/id #uuid "0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-ce3a8353-c68e-51e9-a47a-944828e4d592" :answer/id #uuid "ce3a8353-c68e-51e9-a47a-944828e4d592" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-c61569de-9294-5a88-bfce-3bd6bd5b4e54" :answer/id #uuid "c61569de-9294-5a88-bfce-3bd6bd5b4e54" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6d19565f-be3c-551f-8d53-cfc198fd1d80" :answer/id #uuid "6d19565f-be3c-551f-8d53-cfc198fd1d80" :answer/type :answer.type/math :answer/value "\\sqrt[5]{5}" :db/ensure [:answer/validate]} {:db/id "answer-c46e478d-c5ed-5093-9e4a-7df29e99dfc4" :answer/id #uuid "c46e478d-c5ed-5093-9e4a-7df29e99dfc4" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "activity-3a8bd941-6c1d-5a78-9f47-aa480350898d" :activity/id #uuid "3a8bd941-6c1d-5a78-9f47-aa480350898d" :activity/title "Solving Logarithmic Equations" :activity/type :activity.type/review :activity/scope 17592186049944 :activity/course 17592186046647 :activity/steps ["step-3a1e0312-75fb-54c7-a879-e67bc1eb68c0" "step-844768ff-fb48-5a95-86f4-b402d7531d58" "step-baf6dd19-582e-523e-99fd-f96f25b7727e"] :activity/first-step "step-3a1e0312-75fb-54c7-a879-e67bc1eb68c0" :db/ensure [:activity/validate]} {:db/id "step-3a1e0312-75fb-54c7-a879-e67bc1eb68c0" :step/id #uuid "3a1e0312-75fb-54c7-a879-e67bc1eb68c0" :step/content 17592186059992 :step/next "step-844768ff-fb48-5a95-86f4-b402d7531d58" :db/ensure [:step/validate]} {:db/id "step-844768ff-fb48-5a95-86f4-b402d7531d58" :step/id #uuid "844768ff-fb48-5a95-86f4-b402d7531d58" :step/content "question-1eda43e3-b2a8-5d39-8cf8-7675e676743f" :step/next "step-baf6dd19-582e-523e-99fd-f96f25b7727e" :db/ensure [:step/validate]} {:db/id "step-baf6dd19-582e-523e-99fd-f96f25b7727e" :step/id #uuid "baf6dd19-582e-523e-99fd-f96f25b7727e" :step/content "question-2f3b2436-4186-5dc4-8dde-9327a375de0e" :db/ensure [:step/validate]} {:db/id "activity-9fe78c13-57f6-5d2b-8784-7d8d2d1a86f5" :activity/id #uuid "9fe78c13-57f6-5d2b-8784-7d8d2d1a86f5" :activity/title "Jordan Canonical Decomposition of a 3x3 Matrix" :activity/type :activity.type/review :activity/scope 17592186050504 :activity/course 17592186046673 :activity/steps ["step-bc673b2a-cdff-5e71-920c-d024cca2afda" "step-b1a85d1a-c3e1-5b83-9981-904d39039356" "step-0d618d20-ce2b-52a1-919f-fca94a9e0bd1" "step-438654aa-dae0-5e4a-a80b-cf1ad0dc12d4" "step-3fd32fe5-566f-58c4-b462-3add83153547"] :activity/first-step "step-bc673b2a-cdff-5e71-920c-d024cca2afda" :db/ensure [:activity/validate]} {:db/id "step-bc673b2a-cdff-5e71-920c-d024cca2afda" :step/id #uuid "bc673b2a-cdff-5e71-920c-d024cca2afda" :step/content 17592186176237 :step/next "step-b1a85d1a-c3e1-5b83-9981-904d39039356" :db/ensure [:step/validate]} {:db/id "step-b1a85d1a-c3e1-5b83-9981-904d39039356" :step/id #uuid "b1a85d1a-c3e1-5b83-9981-904d39039356" :step/content 17592186244289 :step/next "step-0d618d20-ce2b-52a1-919f-fca94a9e0bd1" :db/ensure [:step/validate]} {:db/id "step-0d618d20-ce2b-52a1-919f-fca94a9e0bd1" :step/id #uuid "0d618d20-ce2b-52a1-919f-fca94a9e0bd1" :step/content 17592186247143 :step/next "step-438654aa-dae0-5e4a-a80b-cf1ad0dc12d4" :db/ensure [:step/validate]} {:db/id "step-438654aa-dae0-5e4a-a80b-cf1ad0dc12d4" :step/id #uuid "438654aa-dae0-5e4a-a80b-cf1ad0dc12d4" :step/content 17592186386550 :step/next "step-3fd32fe5-566f-58c4-b462-3add83153547" :db/ensure [:step/validate]} {:db/id "step-3fd32fe5-566f-58c4-b462-3add83153547" :step/id #uuid "3fd32fe5-566f-58c4-b462-3add83153547" :step/content 17592186247156 :db/ensure [:step/validate]} {:db/id 17592186157274 :knowledge-point/questions ["question-eb08b876-0b66-567e-a3b3-60f7e35a27a7" "question-82b62b9d-dd4f-549e-842a-634acfc5109f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eb08b876-0b66-567e-a3b3-60f7e35a27a7" :question/id #uuid "eb08b876-0b66-567e-a3b3-60f7e35a27a7" :question/math-academy-id "q-103065" :question/problem "Which of the following are logically equivalent to $M?$\n\nI. $(M∧L)∧M$\n\nII. $M∧(M∨L)$\n\nIII. $(L∨M)∧M$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nM∧(M∨L)≡M.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not*  logically equivalent to $M.$\nThis statement cannot be simplified using the absorption laws.\n\n- Statement II is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}M∧(M∨L) & ≡M.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}(L∨M)∧M & ≡M∧(L∨M) \\\\  & ≡M∧(M∨L) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-27ae5af1-10c4-54a3-be72-6e7bf0fda29b"] :db/ensure [:question/validate]} {:db/id "answer-field-27ae5af1-10c4-54a3-be72-6e7bf0fda29b" :answer-field/id #uuid "27ae5af1-10c4-54a3-be72-6e7bf0fda29b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0f83e6b5-8139-59a3-8646-1a5f933d1f77" :answer-field/choices ["answer-5fde4f1e-5da6-568b-a479-ca97ca093cde" "answer-d864380a-e957-5064-a76f-12f401a7ae57" "answer-0f83e6b5-8139-59a3-8646-1a5f933d1f77" "answer-9632130f-8983-5698-9824-a32e0cd95369" "answer-4f6de57e-8591-59b8-8448-1673055375e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-5fde4f1e-5da6-568b-a479-ca97ca093cde" :answer/id #uuid "5fde4f1e-5da6-568b-a479-ca97ca093cde" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d864380a-e957-5064-a76f-12f401a7ae57" :answer/id #uuid "d864380a-e957-5064-a76f-12f401a7ae57" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-0f83e6b5-8139-59a3-8646-1a5f933d1f77" :answer/id #uuid "0f83e6b5-8139-59a3-8646-1a5f933d1f77" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9632130f-8983-5698-9824-a32e0cd95369" :answer/id #uuid "9632130f-8983-5698-9824-a32e0cd95369" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-4f6de57e-8591-59b8-8448-1673055375e2" :answer/id #uuid "4f6de57e-8591-59b8-8448-1673055375e2" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-82b62b9d-dd4f-549e-842a-634acfc5109f" :question/id #uuid "82b62b9d-dd4f-549e-842a-634acfc5109f" :question/math-academy-id "q-81715" :question/problem "Which of the following are logically equivalent to $P?$\n\nI. $P∧(Q∨P)$\n\nII. $Q∧(P∨Q)$\n\nIII. $(Q∨P)∧P$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nP∧(P∨Q)≡P.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $P.$ We have\n\n$$\n\\begin{aligned}P∧(Q∨P) & ≡P∧(P∨Q) \\\\  & ≡P.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $P.$ We have\n\n$$\n\\begin{aligned}Q∧(P∨Q) & ≡Q∧(Q∨P) \\\\  & ≡Q≢P.\\,\\times \\end{aligned}\n$$\n\n- Statement III is logically equivalent to $P.$ We have\n\n$$\n\\begin{aligned}(Q∨P)∧P & ≡P∧(P∨Q) \\\\  & ≡P.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb588db5-3985-5d4a-be0c-c6934ab18e42"] :db/ensure [:question/validate]} {:db/id "answer-field-bb588db5-3985-5d4a-be0c-c6934ab18e42" :answer-field/id #uuid "bb588db5-3985-5d4a-be0c-c6934ab18e42" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27476643-00e9-5714-814f-18c4f377b677" :answer-field/choices ["answer-27476643-00e9-5714-814f-18c4f377b677" "answer-f9fa991c-a5b9-5493-86e9-7b9f6adcdd44" "answer-0a6c8d12-edc5-5d8d-84f1-8bd450856653" "answer-2abb38c1-2920-5f25-a971-b6e140111e7a" "answer-486e456d-8ae1-5c05-8aac-4b0a494e12cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-27476643-00e9-5714-814f-18c4f377b677" :answer/id #uuid "27476643-00e9-5714-814f-18c4f377b677" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f9fa991c-a5b9-5493-86e9-7b9f6adcdd44" :answer/id #uuid "f9fa991c-a5b9-5493-86e9-7b9f6adcdd44" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-0a6c8d12-edc5-5d8d-84f1-8bd450856653" :answer/id #uuid "0a6c8d12-edc5-5d8d-84f1-8bd450856653" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-2abb38c1-2920-5f25-a971-b6e140111e7a" :answer/id #uuid "2abb38c1-2920-5f25-a971-b6e140111e7a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-486e456d-8ae1-5c05-8aac-4b0a494e12cc" :answer/id #uuid "486e456d-8ae1-5c05-8aac-4b0a494e12cc" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id 17592186157275 :knowledge-point/questions ["question-0fee1624-769e-58a6-a8e5-0e952d79cac1" "question-3b3dcd41-a4d5-5b14-ab14-5e50dc512f91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0fee1624-769e-58a6-a8e5-0e952d79cac1" :question/id #uuid "0fee1624-769e-58a6-a8e5-0e952d79cac1" :question/math-academy-id "q-81720" :question/problem "Which of the following are logically equivalent to $Y?$\n\nI. $(Z∧Y)∨Y$\n\nII. $Y∧(Z∧Y)$\n\nIII. $Y∨(Y∨Z)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nY∨(Y∧Z)≡Y.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $Y.$ We have\n\n$$\n\\begin{aligned}(Z∧Y)∨Y & ≡Y∨(Z∧Y) \\\\  & ≡Y∨(Y∧Z) \\\\  & ≡Y.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $Y.$ This statement cannot be simplified using the absorption laws.\n\n- Statement III is *not* logically equivalent to $Y.$ This statement cannot be simplified using the absorption laws.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6ad0f25f-fa4f-57f8-bd2a-9b8d93bbc416"] :db/ensure [:question/validate]} {:db/id "answer-field-6ad0f25f-fa4f-57f8-bd2a-9b8d93bbc416" :answer-field/id #uuid "6ad0f25f-fa4f-57f8-bd2a-9b8d93bbc416" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5ad27c1-d176-56fd-a3a6-de2511186a41" :answer-field/choices ["answer-5e53d921-3fb4-5f74-bff7-edc72cf430f4" "answer-b5ad27c1-d176-56fd-a3a6-de2511186a41" "answer-bd33bebd-120b-5f91-a1b4-e6c583d8f143" "answer-f641586b-a1ac-55b7-9450-73e0e253da93" "answer-1d5d890b-dbff-54dd-8714-164a761eead1"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e53d921-3fb4-5f74-bff7-edc72cf430f4" :answer/id #uuid "5e53d921-3fb4-5f74-bff7-edc72cf430f4" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-b5ad27c1-d176-56fd-a3a6-de2511186a41" :answer/id #uuid "b5ad27c1-d176-56fd-a3a6-de2511186a41" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-bd33bebd-120b-5f91-a1b4-e6c583d8f143" :answer/id #uuid "bd33bebd-120b-5f91-a1b4-e6c583d8f143" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f641586b-a1ac-55b7-9450-73e0e253da93" :answer/id #uuid "f641586b-a1ac-55b7-9450-73e0e253da93" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-1d5d890b-dbff-54dd-8714-164a761eead1" :answer/id #uuid "1d5d890b-dbff-54dd-8714-164a761eead1" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-3b3dcd41-a4d5-5b14-ab14-5e50dc512f91" :question/id #uuid "3b3dcd41-a4d5-5b14-ab14-5e50dc512f91" :question/math-academy-id "q-86780" :question/problem "Which of the following are logically equivalent to $H?$\n\nI. $(¬K∧H)∨H$\n\nII. $(H∨¬K)∨H$\n\nIII. $H∨(¬K∧H)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nH∨(H∧¬K)≡H.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $H.$ We have\n\n$$\n\\begin{aligned}(¬K∧H)∨H & ≡H∨(¬K∧H) \\\\  & ≡H∨(H∧¬K) \\\\  & ≡H.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $H.$ This statement cannot be simplified using the absorption laws.\n\n- Statement III is logically equivalent to $H.$ We have\n\n$$\n\\begin{aligned}H∨(¬K∧H) & ≡H∨(H∧¬K) \\\\  & ≡H.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6d2e7102-8410-5d15-9aeb-bb8f7fe4d860"] :db/ensure [:question/validate]} {:db/id "answer-field-6d2e7102-8410-5d15-9aeb-bb8f7fe4d860" :answer-field/id #uuid "6d2e7102-8410-5d15-9aeb-bb8f7fe4d860" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e40da01b-bf66-54a0-a62e-fefdce47a49b" :answer-field/choices ["answer-e40da01b-bf66-54a0-a62e-fefdce47a49b" "answer-9da5c4c3-58ec-5778-a963-28957f81791f" "answer-af3e7798-65c9-516d-b9fc-2270795e3283" "answer-ec86b30f-cf23-5883-92d3-1423ad369f6e" "answer-a8748e23-419d-5f51-8362-61ce0a9f63b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-e40da01b-bf66-54a0-a62e-fefdce47a49b" :answer/id #uuid "e40da01b-bf66-54a0-a62e-fefdce47a49b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-9da5c4c3-58ec-5778-a963-28957f81791f" :answer/id #uuid "9da5c4c3-58ec-5778-a963-28957f81791f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-af3e7798-65c9-516d-b9fc-2270795e3283" :answer/id #uuid "af3e7798-65c9-516d-b9fc-2270795e3283" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-ec86b30f-cf23-5883-92d3-1423ad369f6e" :answer/id #uuid "ec86b30f-cf23-5883-92d3-1423ad369f6e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-a8748e23-419d-5f51-8362-61ce0a9f63b0" :answer/id #uuid "a8748e23-419d-5f51-8362-61ce0a9f63b0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186158482 :tutorial/content "There are two laws, called the **absorption laws**, that can be used to drastically simplify some logical expressions.\n\n- The law that conjunction absorbs disjunction is stated as\n\n$$\nA \\land (A \\lor B) \\equiv A.\n$$\n\n- Likewise, the law that disjunction absorbs conjunction is stated as\n\n$$\nA \\lor (A \\land B) \\equiv A.\n$$\n\nSometimes, the laws are stated more concisely as\n\n$$\nA \\land (A \\lor B) \\equiv A \\lor (A \\land B) \\equiv A.\n$$\n\nTo prove that these laws hold, we can construct truth tables:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land (A \\lor B) \\,$ | $\\, A \\lor (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\color{blue} \\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\color{blue} \\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |" :db/ensure [:tutorial/validate]} {:db/id 17592186157480 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-f512a6df-58eb-5ba9-9576-bb9ab79c9e12" :activity/id #uuid "f512a6df-58eb-5ba9-9576-bb9ab79c9e12" :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type :activity.type/review :activity/scope 17592186049322 :activity/course 17592186046658 :activity/steps ["step-8de1845b-7bd3-5cc9-ac01-91de02bac6f7" "step-4520189c-2f23-58f6-8c5a-da1e7d444ffd" "step-e3e2ae28-2bca-5084-b4c1-d7fbd0b4a8e2" "step-9493a861-104a-5833-9f39-6e049c77a66e" "step-e7731aae-63ac-5bf9-97b3-13fce07182f4"] :activity/first-step "step-8de1845b-7bd3-5cc9-ac01-91de02bac6f7" :db/ensure [:activity/validate]} {:db/id "step-8de1845b-7bd3-5cc9-ac01-91de02bac6f7" :step/id #uuid "8de1845b-7bd3-5cc9-ac01-91de02bac6f7" :step/content 17592186315010 :step/next "step-4520189c-2f23-58f6-8c5a-da1e7d444ffd" :db/ensure [:step/validate]} {:db/id "step-4520189c-2f23-58f6-8c5a-da1e7d444ffd" :step/id #uuid "4520189c-2f23-58f6-8c5a-da1e7d444ffd" :step/content 17592186348333 :step/next "step-e3e2ae28-2bca-5084-b4c1-d7fbd0b4a8e2" :db/ensure [:step/validate]} {:db/id "step-e3e2ae28-2bca-5084-b4c1-d7fbd0b4a8e2" :step/id #uuid "e3e2ae28-2bca-5084-b4c1-d7fbd0b4a8e2" :step/content 17592186348336 :step/next "step-9493a861-104a-5833-9f39-6e049c77a66e" :db/ensure [:step/validate]} {:db/id "step-9493a861-104a-5833-9f39-6e049c77a66e" :step/id #uuid "9493a861-104a-5833-9f39-6e049c77a66e" :step/content 17592186262941 :step/next "step-e7731aae-63ac-5bf9-97b3-13fce07182f4" :db/ensure [:step/validate]} {:db/id "step-e7731aae-63ac-5bf9-97b3-13fce07182f4" :step/id #uuid "e7731aae-63ac-5bf9-97b3-13fce07182f4" :step/content 17592186262946 :db/ensure [:step/validate]} {:db/id 17592186096701 :knowledge-point/questions ["question-63f90954-aef6-5358-9e26-c4da4dbb21fd" "question-049a751e-712d-54cc-ad6d-c6e3564444d6" "question-95085e88-c005-5feb-bf13-36ae5ea5d897"] :db/ensure [:knowledge-point/validate]} {:db/id "question-63f90954-aef6-5358-9e26-c4da4dbb21fd" :question/id #uuid "63f90954-aef6-5358-9e26-c4da4dbb21fd" :question/math-academy-id "q-327052" :question/problem "![](images/22/22f309ffc9ff6ae4a43a5faae12e4ed952d65aec70f87a7e71f64594f0c61f92.png)\n\nConsider the picture above. If $c=\\frac{4}{3}a+\\lambda b,$ then$\\,\\lambda =$\n{{field-1}}." :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\frac{4}{3}a+\\lambda b.\n$$\n\nWe are given that one of the components is $\\frac{4}{3}a.$ So, we first draw the vector $\\frac{4}{3}a$ from the origin. Then we complete the path to the point $C.$\n\n![](images/b8/b8db5015e22e55282e180b1d81f7a2e1ca544dfe0f468dc4dedb6283bac2da5c.png)\n\nLet $P$ be the endpoint of the vector $\\frac{4}{3}a.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=\\frac{1}{4}|b|$\n\n- $\\overset{\\to }{PC}$ and $b$ have the same direction\n\nHence, $\\overset{\\to }{PC}=\\frac{1}{4}b.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =\\frac{4}{3}a+\\frac{1}{4}b.\\end{aligned}\n$$\n\nConsequently, $c=\\frac{4}{3}a+\\lambda b=\\frac{4}{3}a+\\frac{1}{4}b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $b,$ we get:\n\n$$\n\\lambda =\\frac{1}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f419c0b9-3927-593f-9535-801465b684b3"] :db/ensure [:question/validate]} {:db/id "answer-field-f419c0b9-3927-593f-9535-801465b684b3" :answer-field/id #uuid "f419c0b9-3927-593f-9535-801465b684b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-57534557-824c-57ce-9724-420aeeed76a9" :answer-field/choices ["answer-57534557-824c-57ce-9724-420aeeed76a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-57534557-824c-57ce-9724-420aeeed76a9" :answer/id #uuid "57534557-824c-57ce-9724-420aeeed76a9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-049a751e-712d-54cc-ad6d-c6e3564444d6" :question/id #uuid "049a751e-712d-54cc-ad6d-c6e3564444d6" :question/math-academy-id "q-120247" :question/problem "![](images/2e/2ea6acbf6574e970a798100729de9a92874bca90b8153db9883daa1cd6d98c2a.png)\n\nConsider the picture above. Given that $c=\\lambda a+2b$, find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+2b.\n$$\n\nWe are given that one of the components is $2b.$ So, we first draw the vector $2b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/3c/3c31e9b0d926de6a3f8c9f35bd816349d6488c8b98864d8576fdbfc395bbd92d.png)\n\nLet $P$ be the endpoint of the vector $2b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{PC}=3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =2b+3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+2b=3a+2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =3\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d13d9e16-1b93-5d32-9389-dc37d592577d"] :db/ensure [:question/validate]} {:db/id "answer-field-d13d9e16-1b93-5d32-9389-dc37d592577d" :answer-field/id #uuid "d13d9e16-1b93-5d32-9389-dc37d592577d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-89ca97dd-07f7-5d11-a1c6-2ec6ea64ebb7" :answer-field/choices ["answer-5de4b890-ee0f-528b-8086-4f0f53ba2eda" "answer-65dbfb77-dae6-5079-bb06-2fd6cdbe211b" "answer-326a02a6-28fe-5680-bcbd-26768b11a79b" "answer-89ca97dd-07f7-5d11-a1c6-2ec6ea64ebb7" "answer-0730b596-e8ba-5761-8d72-995459b9f482"] :db/ensure [:answer-field/validate]} {:db/id "answer-5de4b890-ee0f-528b-8086-4f0f53ba2eda" :answer/id #uuid "5de4b890-ee0f-528b-8086-4f0f53ba2eda" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-65dbfb77-dae6-5079-bb06-2fd6cdbe211b" :answer/id #uuid "65dbfb77-dae6-5079-bb06-2fd6cdbe211b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-326a02a6-28fe-5680-bcbd-26768b11a79b" :answer/id #uuid "326a02a6-28fe-5680-bcbd-26768b11a79b" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "answer-89ca97dd-07f7-5d11-a1c6-2ec6ea64ebb7" :answer/id #uuid "89ca97dd-07f7-5d11-a1c6-2ec6ea64ebb7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-0730b596-e8ba-5761-8d72-995459b9f482" :answer/id #uuid "0730b596-e8ba-5761-8d72-995459b9f482" :answer/type :answer.type/math :answer/value "3.5" :db/ensure [:answer/validate]} {:db/id "question-95085e88-c005-5feb-bf13-36ae5ea5d897" :question/id #uuid "95085e88-c005-5feb-bf13-36ae5ea5d897" :question/math-academy-id "q-70144" :question/problem "![](images/69/695c825905b268e40b7c77c681c608fcedfed4d0c5150f76224c4e60eb8ab045.png)\n\nConsider the picture above. Given that $c=\\lambda a+2b$, find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+2b.\n$$\n\nWe are given that one of the components is $2b.$ So, we first draw the vector $2b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/7d/7d388cdd1db5cfe59b447c3fc27b597fc4e42397966935592f56c1c9f4a598e6.png)\n\nLet $P$ be the endpoint of the vector $2b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{PC}=a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =2b+a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+2b=a+2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =1\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-03796815-dbdc-551f-b90d-8813f015cb09"] :db/ensure [:question/validate]} {:db/id "answer-field-03796815-dbdc-551f-b90d-8813f015cb09" :answer-field/id #uuid "03796815-dbdc-551f-b90d-8813f015cb09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d8d77447-c1f0-57ce-85f8-0d94c6932498" :answer-field/choices ["answer-8531da3a-3a08-5b28-869a-8b5faccae9ca" "answer-e6653684-3eb7-543a-b870-e6c60c1544db" "answer-d8d77447-c1f0-57ce-85f8-0d94c6932498" "answer-faf87587-6680-5ce8-9dce-68c1abd43d20" "answer-b081c18c-b180-5eb0-8c11-e10c3e68cddf"] :db/ensure [:answer-field/validate]} {:db/id "answer-8531da3a-3a08-5b28-869a-8b5faccae9ca" :answer/id #uuid "8531da3a-3a08-5b28-869a-8b5faccae9ca" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-e6653684-3eb7-543a-b870-e6c60c1544db" :answer/id #uuid "e6653684-3eb7-543a-b870-e6c60c1544db" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d8d77447-c1f0-57ce-85f8-0d94c6932498" :answer/id #uuid "d8d77447-c1f0-57ce-85f8-0d94c6932498" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-faf87587-6680-5ce8-9dce-68c1abd43d20" :answer/id #uuid "faf87587-6680-5ce8-9dce-68c1abd43d20" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b081c18c-b180-5eb0-8c11-e10c3e68cddf" :answer/id #uuid "b081c18c-b180-5eb0-8c11-e10c3e68cddf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186096652 :knowledge-point/questions ["question-eeb1828d-7e99-5d6a-aa95-0e286af84c7f" "question-ada3d5e7-07f2-5981-9fcd-59fe51195895"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eeb1828d-7e99-5d6a-aa95-0e286af84c7f" :question/id #uuid "eeb1828d-7e99-5d6a-aa95-0e286af84c7f" :question/math-academy-id "q-120265" :question/problem "![](images/67/6715bda9432c2ba3e61c31f436cd6b7608312da499bb4372944d25db6cf76090.png)\n\nConsider the picture above. Given that $c=\\lambda a+\\mu b$, find $\\lambda$ and $\\mu .$" :question/worked-solution "![](images/89/8997fda665e4bba248dd19f5b8fe0d2a2524df341042271a0f8426e0ce152ecd.png)\n\nIn $△OAC$ shown above, we have:\n\n- $OA=3|a|$\n\n- $\\overset{\\to }{OA}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{OA}=-3a.$\n\nSimilarly:\n\n- $AC=2|b|$\n\n- $\\overset{\\to }{AC}$ and $b$ have opposite directions\n\nHence, $\\overset{\\to }{AC}=-2b.$\n\nAdditionally, \n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =-3a-2b.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+\\mu b=-3a-2b.$ \n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =-2$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e94447c-6428-5f0d-9958-0d3458e2b5ba"] :db/ensure [:question/validate]} {:db/id "answer-field-6e94447c-6428-5f0d-9958-0d3458e2b5ba" :answer-field/id #uuid "6e94447c-6428-5f0d-9958-0d3458e2b5ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a9a75f3a-4920-5e33-be0c-78e376d995c9" :answer-field/choices ["answer-bb1a8c24-4115-5d89-a601-bd095e5bfa7f" "answer-e054b3a2-0eea-5210-8737-47555b3de52a" "answer-a9a75f3a-4920-5e33-be0c-78e376d995c9" "answer-58536380-845e-5010-b39b-f5e39e4c551c" "answer-1e8cd8a3-5848-5337-929a-567d0fe4c28c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb1a8c24-4115-5d89-a601-bd095e5bfa7f" :answer/id #uuid "bb1a8c24-4115-5d89-a601-bd095e5bfa7f" :answer/type :answer.type/text :answer/value "$\\lambda =-2$ and $\\mu =-3$" :db/ensure [:answer/validate]} {:db/id "answer-e054b3a2-0eea-5210-8737-47555b3de52a" :answer/id #uuid "e054b3a2-0eea-5210-8737-47555b3de52a" :answer/type :answer.type/text :answer/value "$\\lambda =-2$ and $\\mu =2$" :db/ensure [:answer/validate]} {:db/id "answer-a9a75f3a-4920-5e33-be0c-78e376d995c9" :answer/id #uuid "a9a75f3a-4920-5e33-be0c-78e376d995c9" :answer/type :answer.type/text :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/ensure [:answer/validate]} {:db/id "answer-58536380-845e-5010-b39b-f5e39e4c551c" :answer/id #uuid "58536380-845e-5010-b39b-f5e39e4c551c" :answer/type :answer.type/text :answer/value "$\\lambda =2$ and $\\mu =-2$" :db/ensure [:answer/validate]} {:db/id "answer-1e8cd8a3-5848-5337-929a-567d0fe4c28c" :answer/id #uuid "1e8cd8a3-5848-5337-929a-567d0fe4c28c" :answer/type :answer.type/text :answer/value "$\\lambda =3$ and $\\mu =2$" :db/ensure [:answer/validate]} {:db/id "question-ada3d5e7-07f2-5981-9fcd-59fe51195895" :question/id #uuid "ada3d5e7-07f2-5981-9fcd-59fe51195895" :question/math-academy-id "q-120273" :question/problem "![](images/5d/5dea155246de4f35697780db7ebf1802cdf5c2899fe42fa494993be2f65dd7f3.png)\n\nConsider the picture above. Given that $h=\\lambda f+\\mu g$, find $\\lambda$ and $\\mu .$" :question/worked-solution "![](images/99/9905448ad59cb2f68f5def832811eb34056305d1a535f23387f4403a340cb8f8.png)\n\nIn $△OFH$ shown above, we have \n\n- $OF=\\frac{1}{2}|f|$\n\n- $\\overset{\\to }{OF}$ has the opposite direction to $f$\n\nHence, $\\overset{\\to }{OF}=-\\frac{1}{2}f.$\n\nSimilarly:\n\n- $FH=2|g|$\n\n- $\\overset{\\to }{FH}$ has the opposite direction to $g$\n\nHence, $\\overset{\\to }{FH}=-2g.$\n\nAdditionally, \n\n$$\n\\begin{aligned}h & =\\overset{\\to }{OF}+\\overset{\\to }{FH} \\\\  & =-\\frac{1}{2}f-2g.\\end{aligned}\n$$\n\nConsequently, $h=\\lambda f+\\mu g=-\\frac{1}{2}f-2g.$\n\nSince $f∦g,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-\\frac{1}{2}$ and $\\mu =-2$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3810e182-6568-500c-b95b-e07cc9fea34d"] :db/ensure [:question/validate]} {:db/id "answer-field-3810e182-6568-500c-b95b-e07cc9fea34d" :answer-field/id #uuid "3810e182-6568-500c-b95b-e07cc9fea34d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0830e01b-93be-55a3-ac87-38d68196c9be" :answer-field/choices ["answer-a2644a20-0b59-59e2-bf9a-fb12db4f0be3" "answer-1bd72a4f-8a2a-5d84-a5df-17bc127c8a72" "answer-0830e01b-93be-55a3-ac87-38d68196c9be" "answer-a306cce2-e35e-56e8-a262-e2dc8808954f" "answer-8ed3d896-e6f3-5e0d-9156-7213b2534219"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2644a20-0b59-59e2-bf9a-fb12db4f0be3" :answer/id #uuid "a2644a20-0b59-59e2-bf9a-fb12db4f0be3" :answer/type :answer.type/text :answer/value "$\\lambda =-2$ and $\\mu =-1$" :db/ensure [:answer/validate]} {:db/id "answer-1bd72a4f-8a2a-5d84-a5df-17bc127c8a72" :answer/id #uuid "1bd72a4f-8a2a-5d84-a5df-17bc127c8a72" :answer/type :answer.type/text :answer/value "$\\lambda =-2$ and $\\mu =\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-0830e01b-93be-55a3-ac87-38d68196c9be" :answer/id #uuid "0830e01b-93be-55a3-ac87-38d68196c9be" :answer/type :answer.type/text :answer/value "$\\lambda =-\\frac{1}{2}$ and $\\mu =-2$" :db/ensure [:answer/validate]} {:db/id "answer-a306cce2-e35e-56e8-a262-e2dc8808954f" :answer/id #uuid "a306cce2-e35e-56e8-a262-e2dc8808954f" :answer/type :answer.type/text :answer/value "$\\lambda =2$ and $\\mu =-2$" :db/ensure [:answer/validate]} {:db/id "answer-8ed3d896-e6f3-5e0d-9156-7213b2534219" :answer/id #uuid "8ed3d896-e6f3-5e0d-9156-7213b2534219" :answer/type :answer.type/text :answer/value "$\\lambda =\\frac{1}{2}$ and $\\mu =\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id 17592186096886 :activity/expected-seconds 1500.0 :db/ensure [:activity/validate]} {:db/id "activity-4f3aedea-ce59-5377-a919-75712b7234d6" :activity/id #uuid "4f3aedea-ce59-5377-a919-75712b7234d6" :activity/title "Differentials" :activity/type :activity.type/review :activity/scope 17592186049789 :activity/course 17592186046673 :activity/steps ["step-05e1162b-9ac7-5dd4-9211-b622aacaf22f" "step-316729c9-4888-5409-95a4-73e5ccec848e" "step-31929053-f3b9-591b-bdc2-747c8a370f98" "step-1844416f-fe2c-5284-9655-9bd296331880" "step-e9b6a348-f1db-5091-823d-f40f938737e7"] :activity/first-step "step-05e1162b-9ac7-5dd4-9211-b622aacaf22f" :db/ensure [:activity/validate]} {:db/id "step-05e1162b-9ac7-5dd4-9211-b622aacaf22f" :step/id #uuid "05e1162b-9ac7-5dd4-9211-b622aacaf22f" :step/content 17592186125053 :step/next "step-316729c9-4888-5409-95a4-73e5ccec848e" :db/ensure [:step/validate]} {:db/id "step-316729c9-4888-5409-95a4-73e5ccec848e" :step/id #uuid "316729c9-4888-5409-95a4-73e5ccec848e" :step/content 17592186125056 :step/next "step-31929053-f3b9-591b-bdc2-747c8a370f98" :db/ensure [:step/validate]} {:db/id "step-31929053-f3b9-591b-bdc2-747c8a370f98" :step/id #uuid "31929053-f3b9-591b-bdc2-747c8a370f98" :step/content 17592186348265 :step/next "step-1844416f-fe2c-5284-9655-9bd296331880" :db/ensure [:step/validate]} {:db/id "step-1844416f-fe2c-5284-9655-9bd296331880" :step/id #uuid "1844416f-fe2c-5284-9655-9bd296331880" :step/content 17592186348271 :step/next "step-e9b6a348-f1db-5091-823d-f40f938737e7" :db/ensure [:step/validate]} {:db/id "step-e9b6a348-f1db-5091-823d-f40f938737e7" :step/id #uuid "e9b6a348-f1db-5091-823d-f40f938737e7" :step/content 17592186348291 :db/ensure [:step/validate]} {:db/id 17592186115293 :knowledge-point/questions ["question-f860d929-2f10-587c-a6b0-b33c9769a489"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f860d929-2f10-587c-a6b0-b33c9769a489" :question/id #uuid "f860d929-2f10-587c-a6b0-b33c9769a489" :question/math-academy-id "q-28199" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=(3-x)(1-x)^{2}?$" :question/worked-solution "The equation is already in factored form, so by the zero-product rule, we deduce that it has a single root at $x=3$ and a double root at $x=1.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =(3-0)(1-0)^{2} \\\\  & =(3)(1)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nSo, the curve\n\n- intercepts the $y$-axis at the point $(0,3),$\n\n- passes through the $x$-axis at the single root $x=3,$ and\n\n- touches the $x$-axis and turns around at the double root $x=1.$\n\nNotice that the leading coefficient is *negative*:\n\n$$\n\\begin{aligned}f(x) & =(3-x)(1-x)^{2} \\\\  & =(3-x)({x}^{2}-2x+1) \\\\  & =-{x}^{3}+⋯\\end{aligned}\n$$\n\n![](images/20/20ba88abb40a98b3d832402627568a1536abde65018e09cce9c89e184128132b.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d6576acb-ee3e-5578-a842-e3188dc1a132"] :db/ensure [:question/validate]} {:db/id "answer-field-d6576acb-ee3e-5578-a842-e3188dc1a132" :answer-field/id #uuid "d6576acb-ee3e-5578-a842-e3188dc1a132" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f866ab0a-1204-5a1f-9d28-44d47976870a" :answer-field/choices ["answer-f866ab0a-1204-5a1f-9d28-44d47976870a" "answer-0e8d4033-f315-5068-b4e7-7a561cacc09c" "answer-d692479a-cac9-5f6d-a067-421b5a18ccaa" "answer-43dc7a04-fefa-5f41-a95c-9ce5149a4c8d" "answer-ab057bb4-1fee-521c-b644-b78006739dc4"] :db/ensure [:answer-field/validate]} {:db/id "answer-f866ab0a-1204-5a1f-9d28-44d47976870a" :answer/id #uuid "f866ab0a-1204-5a1f-9d28-44d47976870a" :answer/type :answer.type/image :answer/value "images/20/20ba88abb40a98b3d832402627568a1536abde65018e09cce9c89e184128132b.png" :db/ensure [:answer/validate]} {:db/id "answer-0e8d4033-f315-5068-b4e7-7a561cacc09c" :answer/id #uuid "0e8d4033-f315-5068-b4e7-7a561cacc09c" :answer/type :answer.type/image :answer/value "images/3c/3c5b751fa88a63ae10d0118c7ad05f883b4f16f739d895690a3ad5f1c241989b.png" :db/ensure [:answer/validate]} {:db/id "answer-d692479a-cac9-5f6d-a067-421b5a18ccaa" :answer/id #uuid "d692479a-cac9-5f6d-a067-421b5a18ccaa" :answer/type :answer.type/image :answer/value "images/3e/3e6be7a333ce5a8d473da4fe54b11888c4e536220a085680a2f2782d953e1dcf.png" :db/ensure [:answer/validate]} {:db/id "answer-43dc7a04-fefa-5f41-a95c-9ce5149a4c8d" :answer/id #uuid "43dc7a04-fefa-5f41-a95c-9ce5149a4c8d" :answer/type :answer.type/image :answer/value "images/6d/6dfc86cf107cc6d37fe64b7efb852213027889bf55a001d5c751f45fd2ae7d7f.png" :db/ensure [:answer/validate]} {:db/id "answer-ab057bb4-1fee-521c-b644-b78006739dc4" :answer/id #uuid "ab057bb4-1fee-521c-b644-b78006739dc4" :answer/type :answer.type/image :answer/value "images/d5/d5f1625d33687f4053f3a5fd20dbf55aa0889bbdd57c266817f9396f47d27331.png" :db/ensure [:answer/validate]} {:db/id 17592186115692 :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186115294 :knowledge-point/questions ["question-024af745-75a4-59f6-8f6d-ac762eef1195"] :db/ensure [:knowledge-point/validate]} {:db/id "question-024af745-75a4-59f6-8f6d-ac762eef1195" :question/id #uuid "024af745-75a4-59f6-8f6d-ac762eef1195" :question/math-academy-id "q-75163" :question/problem "Given that $x+3$ is a factor of $f(x)=-{x}^{3}-7{x}^{2}-15x-9$, which of the following curves is generated by $y=f(x)?$\n\n*(Note: Figures not drawn to scale)*" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+3)$ is a factor of $f(x),$ so $(x+3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & -1 & -7 & -15 & -9 \\\\  &  & 3 & 12 & 9 \\\\  & -1 & -4 & -3 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{f(x)}{x+3} & =-{x}^{2}-4x-3 \\\\  & =-({x}^{2}+4x+3)\\end{aligned}\n$$\n\nwhich means that\n\n$$\nf(x)=-(x+3)({x}^{2}+4x+3).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\nf(x)=-(x+3)(x+1)(x+3)=-(x+1)(x+3)^{2}\n$$\n\nNow that we have the cubic in factored form, we can tell that it has a single root at $x=-1$ and a double root at $x=-3.$\n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-(0+1)(0+3)^{2} \\\\  & =-(1)(3)^{2} \\\\  & =-9.\\end{aligned}\n$$\n\nSo, the curve\n\n- intercepts the $y$-axis at $(0,-9),$\n\n- passes through the $x$-axis at the single root $x=-1,$ and\n\n- touches the $x$-axis and turns around at the double root $x=-3.$\n\nBecause the leading coefficient is negative, the graph takes an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/c0/c084c0059cecb1fa33430bc3761a4e5fbe23a44f3db59d61b9f2acfc74a87fa7.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-00f9b105-8b22-52e2-972a-ee7a0aed6cbb"] :db/ensure [:question/validate]} {:db/id "answer-field-00f9b105-8b22-52e2-972a-ee7a0aed6cbb" :answer-field/id #uuid "00f9b105-8b22-52e2-972a-ee7a0aed6cbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d5f8551-e61e-5d3a-b47a-6377f4a68f59" :answer-field/choices ["answer-bb957a48-c507-57d8-889a-32e9e0971c79" "answer-163a3c39-b596-599d-9c26-41996cf4088a" "answer-eb2f28cd-c700-5f76-b55a-b8e321d6abe5" "answer-35e7bb1b-0c0f-58f1-ae98-babedb00830d" "answer-4d5f8551-e61e-5d3a-b47a-6377f4a68f59"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb957a48-c507-57d8-889a-32e9e0971c79" :answer/id #uuid "bb957a48-c507-57d8-889a-32e9e0971c79" :answer/type :answer.type/image :answer/value "images/15/15fbaca7ca27b09be9122c5a33a9fdd4ce93999a419d9fb9f97601cf94018143.png" :db/ensure [:answer/validate]} {:db/id "answer-163a3c39-b596-599d-9c26-41996cf4088a" :answer/id #uuid "163a3c39-b596-599d-9c26-41996cf4088a" :answer/type :answer.type/image :answer/value "images/72/7275f0118937d84ac1ce42285ad2c6d6958ef925bb4a4387f95d51ae3d4059bd.png" :db/ensure [:answer/validate]} {:db/id "answer-eb2f28cd-c700-5f76-b55a-b8e321d6abe5" :answer/id #uuid "eb2f28cd-c700-5f76-b55a-b8e321d6abe5" :answer/type :answer.type/image :answer/value "images/92/92458bf99d2c9ac6bf226020a91cc1b9a7d0fde096711db