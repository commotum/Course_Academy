eparately:\n\n$$\n\\begin{aligned}3a-(b+4c) & =3\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+4\\cdot [\\begin{aligned}4 \\\\ -6\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+[\\begin{aligned}16 \\\\ -24\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-[\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" 13194139533864 true] [17592186259198 1000 #edb/ref 17592186259199 13194139533864 true] [17592186259198 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259198 1041 "r1c1" 13194139533864 true] [17592186259198 1104 #edb/ref 17592186259199 13194139533864 true] [17592186259198 1110 #uuid "64f3e97d-de55-5fb7-ad5d-d89294d4847f" 13194139533864 true] [17592186259199 1034 "-6" 13194139533864 true] [17592186259199 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259199 1111 #uuid "8c4ada3f-ec52-5933-a92d-326b5d35a8ee" 13194139533864 true] [17592186259200 1000 #edb/ref 17592186259201 13194139533864 true] [17592186259200 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259200 1041 "r2c1" 13194139533864 true] [17592186259200 1104 #edb/ref 17592186259201 13194139533864 true] [17592186259200 1110 #uuid "d6f32894-5980-59f9-9518-27185a1289eb" 13194139533864 true] [17592186259201 1034 "-1" 13194139533864 true] [17592186259201 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259201 1111 #uuid "e89259cc-eacd-5135-93d3-15fe21297e1c" 13194139533864 true] [17592186259202 1017 #edb/ref 17592186259203 13194139533864 true] [17592186259202 1017 #edb/ref 17592186259205 13194139533864 true] [17592186259202 1089 "q-70414" 13194139533864 true] [17592186259202 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259202 1100 "Let $a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 5\\end{aligned}]$ and $c=[\\begin{aligned}1 \\\\ 2\\end{aligned