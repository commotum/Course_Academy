13194139533864 true] [17592186257017 1110 #uuid "55c28b4d-6cd9-5534-b503-9d27638f083c" 13194139533864 true] [17592186257018 1034 "\\frac{1}{2}" 13194139533864 true] [17592186257018 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257018 1111 #uuid "5d1066e2-91d8-5669-ac31-819b92dcca1a" 13194139533864 true] [17592186257019 1017 #edb/ref 17592186257020 13194139533864 true] [17592186257019 1089 "q-123609" 13194139533864 true] [17592186257019 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257019 1100 "$\\operatorname{sec}{240}^{∘}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257019 1113 #uuid "13f67cae-eaf5-50b8-90bd-8b055038e1a6" 13194139533864 true] [17592186257019 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${240}^{∘}$ corresponds to the point $(-\\frac{1}{2},-\\frac{\\sqrt{3}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}{240}^{∘}=-\\frac{1}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{sec}{240}^{∘}=\\frac{1}{\\operatorname{cos}{240}^{∘}}=-2.\n$$" 13194139533864 true] [17592186257020 1000 #edb/ref 17592186257021 13194139533864 true] [17592186257020 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257020 1041 "answer" 13194139533864 true] [17592186257020 1104 #edb/ref 17592186257021 13194139533864 true] [17592186257020 1110 #uuid "3e5ab50b-a0de-5195-9cf0-1d6ce039d8ad" 13194139533864 true] [17592186257021 1034 "-2" 13194139533864 true] [17592186257021 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257021 1111 #uuid "54103ca5-dd3b-5843-bbe3-3e5f4f7ec8b9" 13194139533864 true] [175921862