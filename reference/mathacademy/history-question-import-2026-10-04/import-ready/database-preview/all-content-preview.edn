5}+5){e}^{-2{x}^{6}+5x})|}_{x=1} \\\\  & =(-12(1)^{5}+5){e}^{-2(1)^{6}+5(1)} \\\\  & =-7{e}^{3} \\\\  & =-7{e}^{3}\\end{aligned}\n$$" 13194139533864 true] [17592186259911 1000 #edb/ref 17592186259912 13194139533864 true] [17592186259911 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259911 1041 "field-1" 13194139533864 true] [17592186259911 1104 #edb/ref 17592186259912 13194139533864 true] [17592186259911 1110 #uuid "0c814946-1453-57b9-a6c5-6e6c5ac01d5c" 13194139533864 true] [17592186259912 1034 "-7{e}^{3}" 13194139533864 true] [17592186259912 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259912 1111 #uuid "4fd55798-3dc9-5e70-9dd2-d43f04a6af69" 13194139533864 true] [17592186259913 1017 #edb/ref 17592186259914 13194139533864 true] [17592186259913 1089 "q-340955" 13194139533864 true] [17592186259913 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259913 1100 "Find the slope $m$ of the tangent to the curve $y={e}^{-3x}$ at the point where $x=\\frac{1}{3}.$\n\n$m=$\n{{field-1}}" 13194139533864 true] [17592186259913 1113 #uuid "22c72ac4-7b5e-5497-a5a6-08cd37637b16" 13194139533864 true] [17592186259913 1145 "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=\\frac{1}{3}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/3} & ={(-3{e}^{-3x})|}_{x=1/3} \\\\  & =-3{e}^{-3(1/3)} \\\\  & =-3{e}^{-1} \\\\  & =-3{e}^{-1}\\end{aligned}\n$$" 13194139533864 true] [17592186259914 1000 #edb/ref 175921862