94139533864 true] [17592186261419 1041 "answer" 13194139533864 true] [17592186261419 1104 #edb/ref 17592186261420 13194139533864 true] [17592186261419 1110 #uuid "be1a0d8c-8c2f-5fce-99db-f20ddd31adeb" 13194139533864 true] [17592186261420 1034 "\\frac{m}{m+2}" 13194139533864 true] [17592186261420 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261420 1111 #uuid "a6c6d1a1-4cf0-5e34-b540-2be4480d9368" 13194139533864 true] [17592186261421 1017 #edb/ref 17592186261422 13194139533864 true] [17592186261421 1089 "q-73028" 13194139533864 true] [17592186261421 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261421 1100 "Given that $n\\ge -1$ is an integer, simplify $\\frac{(n+1)!}{(n+2)!}.$" 13194139533864 true] [17592186261421 1113 #uuid "523c0634-c18b-5a9f-a160-daed53a38d8f" 13194139533864 true] [17592186261421 1145 "First, notice the following:\n\n$$\n(n+2)!=(n+2)\\cdot (n+1)!\n$$\n\nThen, we cancel the $(n+1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n+2)!} & =\\frac{(n+1)!}{(n+2)\\cdot (n+1)!} \\\\  & =\\frac{\\cancel{(n+1)!}}{(n+2)\\cdot \\cancel{(n+1)!}} \\\\  & =\\frac{1}{n+2}\\end{aligned}\n$$" 13194139533864 true] [17592186261422 1000 #edb/ref 17592186261423 13194139533864 true] [17592186261422 1000 #edb/ref 17592186261424 13194139533864 true] [17592186261422 1000 #edb/ref 17592186261425 13194139533864 true] [17592186261422 1000 #edb/ref 17592186261426 13194139533864 true] [17592186261422 1000 #edb/ref 17592186261427 13194139533864 true] [17592186261422 1040 #edb/ref 17592186045450 13194139533864 true] [17592186261422 1041 "selection" 13194139533864 true] [17592186261422 1104 #edb/ref 17592186261427 13194139533864 true] [17592186261422 1110 #uuid "0c6ea9fe-5074-58f5-b881-5f4c8659a0cf" 13194139533864 true] [17592186261423 1034 "n+2" 13194139533864 true] [17592186261423 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261423 1111 #uuid "dfa9af18-0b89-5af5-8a9c-58e05f56fcda" 131941395