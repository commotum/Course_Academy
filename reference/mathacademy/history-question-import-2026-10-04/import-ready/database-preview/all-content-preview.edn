0d9d6" 13194139533864 true] [17592186260133 1017 #edb/ref 17592186260134 13194139533864 true] [17592186260133 1089 "q-350592" 13194139533864 true] [17592186260133 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260133 1100 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }\\frac{7}{5}{(0.3)}^{n}=$\n{{field-1}}" 13194139533864 true] [17592186260133 1113 #uuid "ecd963bf-5bba-5df2-996d-756760d0d41a" 13194139533864 true] [17592186260133 1145 "Notice that the given series is a geometric series because it is in the form\n$\\sum a{r}^{n}.$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=\\frac{7}{5}{(0.3)}^{1}=0.42.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{7}{5}{(0.3)}^{2}}{\\frac{7}{5}{(0.3)}^{1}}=0.3.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{7}{5}{(0.3)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{0.42}{1-0.3} \\\\  & =\\frac{0.42}{0.7} \\\\  & =\\frac{42}{70} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$" 13194139533864 true] [17592186260134 1000 #edb/ref 17592186260135 13194139533864 true] [17592186260134 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260134 1041 "field-1" 13194139533864 true] [17592186260134 1104 #edb/ref 17592186260135 13194139533864 true] [17592186260134 1110 #uuid "2b831cea-f9fe-5289-ab8e-950cf1dfb3ea" 13194139533864 true] [17592186260135 1034 "\\frac{3}{5}" 13194139533864 true] [17592186260135 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260135 1111 #uuid "72a09274-3b82-53bb-92cc-b7199d2b2359" 13194139533864 true] [17592186260136 1017 #edb/ref 17592186260137 13194139533864 true] [17592186260136 1089 "q-350593" 13194139533864 true] [17592186260136 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260136 1100 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }6{(0.75)}^{n}=$\n{{field-1}}" 13194139533864 true] [17592186260136 1113 #uuid "2a570aa2-6317-52cf-88ac-f33d0dd4de74" 13194139533864 true] [17592186260136 1145 "Notice that the given series is a geometric series because it is in the form\n$\\sum a{r}^{n}.$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=6{(0.75)}^{1}=4.5.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{6{(0.75)}^{2}}{6{(0.75)}^{1}}=0.75.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }6{(0.75)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{4.5}{1-0.75} \\\\  & =\\frac{4.5}{0.25} \\\\  & =\\frac{450}{25} \\\\  & =18.\\end{aligned}\n$$" 13194139533864 true] [17592186260137 1000 #edb/ref 17592186260138 13194139533864 true] [17592186260137 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260137 1041 "field-1" 13194139533864 true] [17592186260137 1104 #edb/ref 17592186260138 13194139533864 true] [17592186260137 1110 #uuid "20d1584c-c343-5091-b5fb-8a3f42a0ea37" 13194139533864 true] [17592186260138 1034 "18" 13194139533864 true] [17592186260138 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260138 1111 #uuid "f810e291-0c36-56a6-a2a9-94abdfc6f33f" 13194139533864 true] [17592186260139 1017 #edb/ref 17592186260140 13194139533864 true] [17592186260139 1089 "q-350619" 13194139533864 true] [17592186260139 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260139 1100 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=3}^{\\infty }\\frac{27}{4}{(\\frac{1}{3})}^{n}=$\n{{field-1}}" 13194139533864 true] [17592186260139 1113 #uuid "df35aa40-2aa1-5fa3-97f5-bedcf3e9ef31" 13194139533864 true] [17592186260139 1145 "First, note that the index $n$ starts from $3.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{3},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{27}{4}{(\\frac{1}{3})}^{3}=\\frac{1}{4} \\\\ {a}_{4} & =\\frac{27}{4}{(\\frac{1}{3})}^{4}=\\frac{1}{12}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{1}{12})}{(\\frac{1}{4})}=\\frac{1}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{27}{4}{(\\frac{1}{3})}^{n} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(\\frac{1}{4})}{(1-\\frac{1}{3})} \\\\  & =\\frac{(\\frac{1}{4})}{(\\frac{2}{3})} \\\\  & =\\frac{1}{4}\\cdot \\frac{3}{2} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" 13194139533864 true] [17592186260140 1000 #edb/ref 17592186260141 13194139533864 true] [17592186260140 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260140 1041 "field-1" 13194139533864 true] [17592186260140 1104 #edb/ref 17592186260141 13194139533864 true] [17592186260140 1110 #uuid "0134e7dc-b46b-5f77-8bb8-868006661de6" 13194139533864 true] [17592186260141 1034 "\\frac38" 13194139533864 true] [17592186260141 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260141 1111 #uuid "9d63ee3e-c7b4-55b0-8add-a7c71b980d69" 13194139533864 true] [17592186260142 1017 #edb/ref 17592186260143 13194139533864 true] [17592186260142 1089 "q-350620" 13194139533864 true] [17592186260142 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260142 1100 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=4}^{\\infty }\\frac{64}{9}{(\\frac{1}{4})}^{n}=$\n{{field-1}}" 13194139533864 true] [17592186260142 1113 #uuid "a590ae1b-a6f1-59bc-ae08-476c39ab9fd7" 13194139533864 true] [17592186260142 1145 "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{64}{9}{(\\frac{1}{4})}^{4}=\\frac{1}{36} \\\\ {a}_{5} & =\\frac{64}{9}{(\\frac{1}{4})}^{5}=\\frac{1}{144}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{(\\frac{1}{144})}{(\\frac{1}{36})}=\\frac{1}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }\\frac{64}{9}{(\\frac{1}{4})}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{(\\frac{1}{36})}{(1-\\frac{1}{4})} \\\\  & =\\frac{(\\frac{1}{36})}{(\\frac{3}{4})} \\\\  & =\\frac{1}{36}\\cdot \\frac{4}{3} \\\\  & =\\frac{1}{27}.\\end{aligned}\n$$" 13194139533864 true] [17592186260143 1000 #edb/ref 17592186260144 13194139533864 true] [17592186260143 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260143 1041 "field-1" 13194139533864 true] [17592186260143 1104 #edb/ref 17592186260144 13194139533864 true] [17592186260143 1110 #uuid "865a5466-9fc0-5e19-ac48-97dd76755a81" 13194139533864 true] [17592186260144 1034 "\\frac{1}{27}" 13194139533864 true] [17592186260144 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260144 1111 #uuid "c93478d7-5ad1-5168-bdbd-35f035c0cd48" 13194139533864 true] [17592186260145 1017 #edb/ref 17592186260146 13194139533864 true] [17592186260145 1089 "q-350633" 13194139533864 true] [17592186260145 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260145 1100 "Evaluate the geometric series ${\\sum }_{n=2}^{\\infty }25{(\\frac{3}{5})}^{n+1}.$ Do not round the answer.\n\n${\\sum }_{n=2}^{\\infty }25{(\\frac{3}{5})}^{n+1}=$\n{{field-1}}" 13194139533864 true] [17592186260145 1113 #uuid "9a515033-9d33-5db6-a4a5-02cf6fa471fb" 13194139533864 true] [17592186260145 1145 "First, note that the index $n$ starts from $2,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{2}=25{(\\frac{3}{5})}^{2+1}=\\frac{27}{5}\n$$\n\n \n\n$$\n{a}_{3}=25{(\\frac{3}{5})}^{3+1}=\\frac{81}{25}\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{81}{25})}{(\\frac{27}{5})}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }25{(\\frac{3}{5})}^{n+1} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{27}{5})}{(1-\\frac{3}{5})} \\\\  & =\\frac{(\\frac{27}{5})}{(\\frac{2}{5})} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186260146 1000 #edb/ref 17592186260147 13194139533864 true] [17592186260146 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260146 1041 "field-1" 13194139533864 true] [17592186260146 1104 #edb/ref 17592186260147 13194139533864 true] [17592186260146 1110 #uuid "fb6c0036-bfd5-5b86-9819-1c43e8908c53" 13194139533864 true] [17592186260147 1034 "\\frac{27}{2}" 13194139533864 true] [17592186260147 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260147 1111 #uuid "77a15f53-0b90-53fe-809b-00e1e651cdbe" 13194139533864 true] [17592186260148 1017 #edb/ref 17592186260149 13194139533864 true] [17592186260148 1089 "q-350648" 13194139533864 true] [17592186260148 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260148 1100 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=3}^{\\infty }6{(-\\frac{1}{5})}^{\\,n-2}=$\n{{field-1}}" 13194139533864 true] [17592186260148 1113 #uuid "7729376e-a449-523f-b26a-16e4bafe18ce" 13194139533864 true] [17592186260148 1145 "First, note that the index $n$ starts from $3,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{3}=6{(-\\frac{1}{5})}^{3-2}=6(-\\frac{1}{5})=-\\frac{6}{5}\n$$\n\n$$\n{a}_{4}=6{(-\\frac{1}{5})}^{4-2}=6(\\frac{1}{25})=\\frac{6}{25}.\n$$\n\nTherefore, the common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{6}{25})}{(-\\frac{6}{5})}=-\\frac{1}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }6{(-\\frac{1}{5})}^{\\,n-2} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(-\\frac{6}{5})}{1-(-\\frac{1}{5})} \\\\  & =-\\frac{(\\frac{6}{5})}{(\\frac{6}{5})} \\\\  & =-1.\\end{aligned}\n$$" 13194139533864 true] [17592186260149 1000 #edb/ref 17592186260150 13194139533864 true] [17592186260149 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260149 1041 "field-1" 13194139533864 true] [17592186260149 1104 #edb/ref 17592186260150 13194139533864 true] [17592186260149 1110 #uuid "ecd4bec2-b996-5e03-87f5-0771e4052cd0" 13194139533864 true] [17592186260150 1034 "-1" 13194139533864 true] [17592186260150 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260150 1111 #uuid "f218525b-e998-507f-b69d-bc0b09424db6" 13194139533864 true] [17592186260151 1017 #edb/ref 17592186260152 13194139533864 true] [17592186260151 1089 "q-3507" 13194139533864 true] [17592186260151 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260151 1100 "$\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260151 1113 #uuid "a1d4ccc4-62b7-5277-8fc9-0bf4602dfbe9" 13194139533864 true] [17592186260151 1145 "To compute\n\n$$\n\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{z-5}{{z}^{2}-2z-8}÷\\frac{1}{z-4} & = \\\\ \\frac{z-5}{{z}^{2}-2z-8}\\cdot \\frac{z-4}{1} & = \\\\ \\frac{z-5}{(z-4)(z+2)}\\cdot \\frac{z-4}{1} & = \\\\ \\frac{z-5}{\\cancel{(z-4)}(z+2)}\\cdot \\frac{\\cancel{z-4}}{1} & = \\\\ \\frac{z-5}{z+2}\\end{aligned}\n$$" 13194139533864 true] [17592186260152 1000 #edb/ref 17592186260153 13194139533864 true] [17592186260152 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260152 1041 "answer" 13194139533864 true] [17592186260152 1104 #edb/ref 17592186260153 13194139533864 true] [17592186260152 1110 #uuid "3c67e4e9-eb20-5070-9079-0fb5e6183091" 13194139533864 true] [17592186260153 1034 "\\frac{z-5}{z+2}" 13194139533864 true] [17592186260153 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260153 1111 #uuid "93a1a89f-f6a9-5b5f-a009-d11ee85778b9" 13194139533864 true] [17592186260154 1017 #edb/ref 17592186260155 13194139533864 true] [17592186260154 1089 "q-3509" 13194139533864 true] [17592186260154 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260154 1100 "Give an expression equivalent to $\\frac{a-b}{6b}-\\frac{6a-3b}{6b}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260154 1113 #uuid "9b6a3c47-707d-5180-93af-4c625ca6bef1" 13194139533864 true] [17592186260154 1145 "We have a common denominator of $6b,$ so we subtract the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{a-b}{6b}-\\frac{6a-3b}{6b} & = \\\\ \\frac{a-b-(6a-3b)}{6b} & = \\\\ \\frac{a-b-6a+3b}{6b} & = \\\\ \\frac{-5a+2b}{6b}\\end{aligned}\n$$" 13194139533864 true] [17592186260155 1000 #edb/ref 17592186260156 13194139533864 true] [17592186260155 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260155 1041 "answer" 13194139533864 true] [17592186260155 1104 #edb/ref 17592186260156 13194139533864 true] [17592186260155 1110 #uuid "267364fa-abf7-59ac-9da7-7ec3f03d2623" 13194139533864 true] [17592186260156 1034 "\\frac{-5a+2b}{6b}" 13194139533864 true] [17592186260156 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260156 1111 #uuid "7183fd3d-190e-5d57-b5e7-71c60c45f256" 13194139533864 true] [17592186260157 1017 #edb/ref 17592186260158 13194139533864 true] [17592186260157 1089 "q-352279" 13194139533864 true] [17592186260157 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260157 1100 "Calculate ${\\sum }_{n=1}^{\\infty }9{a}_{n}$ given that ${\\sum }_{n=1}^{\\infty }{a}_{n}=4.$\n\n${\\sum }_{n=1}^{\\infty }9{a}_{n}=$\n{{field-1}}" 13194139533864 true] [17592186260157 1113 #uuid "1b90e1c4-d521-5585-b6db-776d9a11ab9c" 13194139533864 true] [17592186260157 1145 "Taking the constant factor outside of the summation sign gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }9{a}_{n} & =9{\\sum }_{n=1}^{\\infty }{a}_{n} \\\\  & =9(4) \\\\  & =36.\\end{aligned}\n$$" 13194139533864 true] [17592186260158 1000 #edb/ref 17592186260159 13194139533864 true] [17592186260158 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260158 1041 "field-1" 13194139533864 true] [17592186260158 1104 #edb/ref 17592186260159 13194139533864 true] [17592186260158 1110 #uuid "146a7171-bd46-5961-a19f-d6ee20c17aea" 13194139533864 true] [17592186260159 1034 "36" 13194139533864 true] [17592186260159 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260159 1111 #uuid "c5d98fb1-73c0-52a8-aa21-b27565c0b3d5" 13194139533864 true] [17592186260160 1017 #edb/ref 17592186260161 13194139533864 true] [17592186260160 1089 "q-352290" 13194139533864 true] [17592186260160 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260160 1100 "Calculate \n${\\sum }_{n=1}^{\\infty }3{a}_{n}+{\\sum }_{n=1}^{\\infty }4{b}_{n}$\ngiven that \n${\\sum }_{n=1}^{\\infty }{a}_{n}=2$ and \n${\\sum }_{n=1}^{\\infty }{b}_{n}=-\\frac{1}{2}.$\n\n${\\sum }_{n=1}^{\\infty }3{a}_{n}+{\\sum }_{n=1}^{\\infty }4{b}_{n}=$\n{{field-1}}" 13194139533864 true] [17592186260160 1113 #uuid "fa440b09-fed9-5ae8-94fe-6509db1fed32" 13194139533864 true] [17592186260160 1145 "Taking the constant factors outside of the summation signs gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }3{a}_{n}+{\\sum }_{n=1}^{\\infty }4{b}_{n} & =3{\\sum }_{n=1}^{\\infty }{a}_{n}+4{\\sum }_{n=1}^{\\infty }{b}_{n} \\\\  & =3\\cdot 2+4\\cdot (-\\frac{1}{2}) \\\\  & =6-2 \\\\  & =4.\\end{aligned}\n$$" 13194139533864 true] [17592186260161 1000 #edb/ref 17592186260162 13194139533864 true] [17592186260161 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260161 1041 "field-1" 13194139533864 true] [17592186260161 1104 #edb/ref 17592186260162 13194139533864 true] [17592186260161 1110 #uuid "e2db9c67-a917-5a3d-8f0f-9bfae2afb4b9" 13194139533864 true] [17592186260162 1034 "4" 13194139533864 true] [17592186260162 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260162 1111 #uuid "e7d861e0-b37e-5859-8382-862845635d7f" 13194139533864 true] [17592186260163 1017 #edb/ref 17592186260164 13194139533864 true] [17592186260163 1089 "q-35252" 13194139533864 true] [17592186260163 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260163 1100 "Find ${lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}(4y-1)^{2}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260163 1113 #uuid "dbe7843b-5fc3-5be1-af00-dea6856d2e57" 13194139533864 true] [17592186260163 1145 "Here, we apply the product rule and the power rule to get\n \n\n$$\n\\begin{aligned}{lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}(4y-1)^{2} & ={lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}\\cdot {lim}_{y\\to 1}(4y-1)^{2} \\\\  & ={({lim}_{y\\to 1}(2{y}^{2}+1))}^{3}\\cdot {({lim}_{y\\to 1}(4y-1))}^{2} \\\\  & ={(2{(1)}^{2}+1)}^{3}{(4(1)-1)}^{2} \\\\  & =(3)^{3}(3)^{2} \\\\  & =243\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260164 1000 #edb/ref 17592186260165 13194139533864 true] [17592186260164 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260164 1041 "answer" 13194139533864 true] [17592186260164 1104 #edb/ref 17592186260165 13194139533864 true] [17592186260164 1110 #uuid "7e1331a0-8fbd-524a-8c07-5d64e2c40536" 13194139533864 true] [17592186260165 1034 "243" 13194139533864 true] [17592186260165 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260165 1111 #uuid "db5e330d-2cdf-5ad1-9ff4-ab4c886ff4bb" 13194139533864 true] [17592186260166 1017 #edb/ref 17592186260167 13194139533864 true] [17592186260166 1089 "q-35282" 13194139533864 true] [17592186260166 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260166 1100 "Calculate ${lim}_{z\\to (-4)}\\frac{{({z}^{2}-10)}^{2}}{(z+6)^{5}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260166 1113 #uuid "80fccaeb-23c0-5dec-b69b-a4bfad7c73ad" 13194139533864 true] [17592186260166 1145 "Here, we apply the quotient rule and the power rule to get\n \n\n$$\n\\begin{aligned}{lim}_{z\\to (-4)}\\frac{{({z}^{2}-10)}^{2}}{(z+6)^{5}} & =\\frac{{lim}_{z\\to (-4)}{({z}^{2}-10)}^{2}}{{lim}_{z\\to (-4)}(z+6)^{5}} \\\\  & =\\frac{{({lim}_{z\\to (-4)}({z}^{2}-10))}^{2}}{{({lim}_{z\\to (-4)}(z+6))}^{5}} \\\\  & =\\frac{{((-4)^{2}-10)}^{2}}{(-4+6)^{5}} \\\\  & =\\frac{{6}^{2}}{{2}^{5}} \\\\  & =\\frac{36}{32} \\\\  & =\\frac{9}{8}\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260167 1000 #edb/ref 17592186260168 13194139533864 true] [17592186260167 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260167 1041 "answer" 13194139533864 true] [17592186260167 1104 #edb/ref 17592186260168 13194139533864 true] [17592186260167 1110 #uuid "017ebeeb-f352-508f-8a30-1c71f2f15297" 13194139533864 true] [17592186260168 1034 "\\frac{9}{8}" 13194139533864 true] [17592186260168 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260168 1111 #uuid "e5ea2b8d-d5ab-5793-a4d2-056df9235ce4" 13194139533864 true] [17592186260169 1017 #edb/ref 17592186260170 13194139533864 true] [17592186260169 1089 "q-35284" 13194139533864 true] [17592186260169 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260169 1100 "Find ${lim}_{x\\to -1}\\sqrt[5]{(7x+11)^{3}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260169 1113 #uuid "2c647934-51df-52e0-8c0b-5d7fb08a09a0" 13194139533864 true] [17592186260169 1145 "Applying the root rule, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\sqrt[5]{(7x+11)^{3}} & =\\sqrt[5]{{lim}_{x\\to -1}(7x+11)^{3}} \\\\  & =\\sqrt[5]{{({lim}_{x\\to -1}(7x+11))}^{3}} \\\\  & =\\sqrt[5]{(7(-1)+11)^{3}} \\\\  & =\\sqrt[5]{{4}^{3}} \\\\  & =\\sqrt[5]{64} \\\\  & =\\sqrt[5]{{2}^{5}\\cdot 2} \\\\  & =2\\sqrt[5]{2}\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260170 1000 #edb/ref 17592186260171 13194139533864 true] [17592186260170 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260170 1041 "answer" 13194139533864 true] [17592186260170 1104 #edb/ref 17592186260171 13194139533864 true] [17592186260170 1110 #uuid "ad54c7fa-35e5-5d53-91ff-e0f9bbbadb45" 13194139533864 true] [17592186260171 1034 "2\\sqrt[5]{2}" 13194139533864 true] [17592186260171 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260171 1111 #uuid "1ad237af-5238-57f1-808d-7e9e471fd368" 13194139533864 true] [17592186260172 1017 #edb/ref 17592186260173 13194139533864 true] [17592186260172 1089 "q-35295" 13194139533864 true] [17592186260172 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260172 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/95e092490e087b5245f05b352b4738beb1ce3d9d649ea289ded881d0728129e5.png)\n\nFind ${lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260172 1113 #uuid "238f1bf7-e926-5a9a-b458-b3d344bdf40c" 13194139533864 true] [17592186260172 1145 "From the graph, we get that ${lim}_{x\\to 1/2}f(x)=1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x} & =\\sqrt{{lim}_{x\\to 1/2}(4(f(x))^{4}+10x)} \\\\  & =\\sqrt{4(1)^{4}+10\\cdot \\frac{1}{2}} \\\\  & =\\sqrt{4+5} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260173 1000 #edb/ref 17592186260174 13194139533864 true] [17592186260173 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260173 1041 "answer" 13194139533864 true] [17592186260173 1104 #edb/ref 17592186260174 13194139533864 true] [17592186260173 1110 #uuid "e0d3983f-d0e2-5d03-9246-2bc06892aa79" 13194139533864 true] [17592186260174 1034 "3" 13194139533864 true] [17592186260174 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260174 1111 #uuid "5bc01e6e-6ce6-5bc8-b813-3f42cc3847c3" 13194139533864 true] [17592186260175 1017 #edb/ref 17592186260176 13194139533864 true] [17592186260175 1089 "q-353317" 13194139533864 true] [17592186260175 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260175 1100 "Consider the infinite geometric sequence that has a third term equal to $27$ and a sixth term equal to $1.$ Find the sum to infinity ${S}_{\\infty }$ of the terms of this sequence. Do not round the answer.\n\n${S}_{\\infty }=$\n{{field-1}}" 13194139533864 true] [17592186260175 1113 #uuid "c5b3ef5f-3bcf-5c98-a527-aed005bdad3c" 13194139533864 true] [17592186260175 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{3}=27$ and ${a}_{6}=1.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{6-3} & =\\frac{1}{27} \\\\ {r}^{3} & =\\frac{1}{27} \\\\ {r}^{3} & ={(\\frac{1}{3})}^{3} \\\\ r & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, using the formula\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}\n$$\n\nfor the $n$th term of the geometric sequence, we can find the first term. Indeed, for $n=3$ we obtain:\n\n$$\n\\begin{aligned}{a}_{3} & ={a}_{1}(r)^{2} \\\\ 27 & ={a}_{1}{(\\frac{1}{3})}^{2} \\\\ 27 & ={a}_{1}(\\frac{1}{9}) \\\\ {a}_{1} & =243\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{243}{(1-\\frac{1}{3})} \\\\  & =\\frac{243}{(\\frac{2}{3})} \\\\  & =243(\\frac{3}{2}) \\\\  & =\\frac{729}{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186260176 1000 #edb/ref 17592186260177 13194139533864 true] [17592186260176 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260176 1041 "field-1" 13194139533864 true] [17592186260176 1104 #edb/ref 17592186260177 13194139533864 true] [17592186260176 1110 #uuid "293eeead-4ae0-5c88-9e68-19a4cafcedc9" 13194139533864 true] [17592186260177 1034 "\\frac{729}2" 13194139533864 true] [17592186260177 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260177 1111 #uuid "f62e55a8-541f-5460-be29-38471e8e82e0" 13194139533864 true] [17592186260178 1017 #edb/ref 17592186260179 13194139533864 true] [17592186260178 1089 "q-35615" 13194139533864 true] [17592186260178 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260178 1100 "Evaluate ${lim}_{x\\to \\infty }{(\\frac{x}{-2})}^{3}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260178 1113 #uuid "bafbcb3a-c207-54ff-a32e-667f79749c80" 13194139533864 true] [17592186260178 1145 "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{x}{-2})}^{3} & ={lim}_{x\\to \\infty }(-\\frac{{x}^{3}}{8}) \\\\  & =-{lim}_{x\\to \\infty }(-\\frac{1}{8}\\cdot {x}^{3}) \\\\  & =-\\frac{1}{8}\\cdot {lim}_{x\\to \\infty }{x}^{3}\\end{aligned}\n$$\n\nThe graph $y={x}^{3}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to \\infty }{x}^{3}=\\infty .\n$$\n\nMultiplication by the negative constant $-\\frac{1}{8}$ changes the sign of the limit. \nSo, we have\n\n$$\n\\begin{aligned} & =-\\frac{1}{8}\\cdot {lim}_{x\\to \\infty }{x}^{3} \\\\  & =-{lim}_{x\\to \\infty }{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to \\infty }(-\\frac{{x}^{3}}{8})=-\\infty .\n$$" 13194139533864 true] [17592186260179 1000 #edb/ref 17592186260180 13194139533864 true] [17592186260179 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260179 1041 "answer" 13194139533864 true] [17592186260179 1104 #edb/ref 17592186260180 13194139533864 true] [17592186260179 1110 #uuid "bacff38d-5cd9-5359-a59f-6319b288a8d6" 13194139533864 true] [17592186260180 1034 "-\\infty" 13194139533864 true] [17592186260180 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260180 1111 #uuid "b277f599-f98a-5ff6-9291-2f34583bbe40" 13194139533864 true] [17592186260181 1017 #edb/ref 17592186260182 13194139533864 true] [17592186260181 1089 "q-35621" 13194139533864 true] [17592186260181 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260181 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e647ebf6e8332e9be5abd75e0f5ac5102c89c4a40590cef21a8ddfc65a17701d.png)\n\nFind ${lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260181 1113 #uuid "18d96d23-85b4-508f-bbdc-a059435bb5b1" 13194139533864 true] [17592186260181 1145 "From the graph we get that ${lim}_{x\\to -1}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4}={lim}_{x\\to -1}(3{x}^{2}-1)^{2}\\cdot {lim}_{x\\to -1}(2-f(x))^{4}\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(3{x}^{2}-1)^{2} & ={({lim}_{x\\to -1}(3{x}^{2}-1))}^{2} \\\\  & ={(3(-1)^{2}-1)}^{2} \\\\  & =4\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(2-f(x))^{4} & ={({lim}_{x\\to -1}(2-f(x)))}^{4} \\\\  & ={(2-1)}^{4} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4} & ={({lim}_{x\\to -1}(3{x}^{2}-1))}^{2}{({lim}_{x\\to -1}(2-f(x)))}^{4} \\\\  & =4.\\end{aligned}\n$$" 13194139533864 true] [17592186260182 1000 #edb/ref 17592186260183 13194139533864 true] [17592186260182 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260182 1041 "answer" 13194139533864 true] [17592186260182 1104 #edb/ref 17592186260183 13194139533864 true] [17592186260182 1110 #uuid "4e9111b4-8506-5726-8c62-7d58cfb11fa0" 13194139533864 true] [17592186260183 1034 "4" 13194139533864 true] [17592186260183 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260183 1111 #uuid "e2404cbf-3ca7-59ae-a93b-18a00631f502" 13194139533864 true] [17592186260184 1017 #edb/ref 17592186260185 13194139533864 true] [17592186260184 1089 "q-35630" 13194139533864 true] [17592186260184 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260184 1100 "Calculate ${lim}_{y\\to 128}{y}^{-1/7}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260184 1113 #uuid "71c89bbc-3485-5efc-ade9-48f584e4aa2a" 13194139533864 true] [17592186260184 1145 "Applying the root rule, we get\n\n$$\n\\begin{aligned}{lim}_{y\\to 128}{y}^{-1/7} & ={({lim}_{y\\to 128}y)}^{-1/7} \\\\  & =(128)^{-1/7} \\\\  & ={({2}^{7})}^{-1/7} \\\\  & ={2}^{-1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186260185 1000 #edb/ref 17592186260186 13194139533864 true] [17592186260185 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260185 1041 "answer" 13194139533864 true] [17592186260185 1104 #edb/ref 17592186260186 13194139533864 true] [17592186260185 1110 #uuid "17995870-8b7a-576c-a863-4cb40c562045" 13194139533864 true] [17592186260186 1034 "\\frac{1}{2}" 13194139533864 true] [17592186260186 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260186 1111 #uuid "3c3a05bd-de3a-5c6b-8f3a-7f802aea3a86" 13194139533864 true] [17592186260187 1017 #edb/ref 17592186260188 13194139533864 true] [17592186260187 1089 "q-36077" 13194139533864 true] [17592186260187 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260187 1100 "Evaluate ${lim}_{x\\to -\\infty }(-7{x}^{3}+\\sqrt{2}{x}^{2}+6x-3).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260187 1113 #uuid "090d4d7a-51e4-5340-8ffd-149afaef8dcc" 13194139533864 true] [17592186260187 1145 "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-7{x}^{3}+\\sqrt{2}{x}^{2}+6x-3) & ={lim}_{x\\to -\\infty }(-7{x}^{3}) \\\\  & =-7\\cdot {lim}_{x\\to -\\infty }({x}^{3}) \\\\  & =-\\,(-\\infty ) \\\\  & =\\infty \\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260188 1000 #edb/ref 17592186260189 13194139533864 true] [17592186260188 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260188 1041 "answer" 13194139533864 true] [17592186260188 1104 #edb/ref 17592186260189 13194139533864 true] [17592186260188 1110 #uuid "f870bccf-08d8-5abe-a40c-b7b5d31a0287" 13194139533864 true] [17592186260189 1034 "\\infty" 13194139533864 true] [17592186260189 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260189 1111 #uuid "5f773f2f-71b1-5ee7-9f52-f412d35c6dda" 13194139533864 true] [17592186260190 1017 #edb/ref 17592186260191 13194139533864 true] [17592186260190 1089 "q-3635" 13194139533864 true] [17592186260190 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260190 1100 "$\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260190 1113 #uuid "ea688c05-e239-5220-b902-15b6dea2eef8" 13194139533864 true] [17592186260190 1145 "To compute\n\n$$\n\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15} & = \\\\ \\frac{9x}{xy+5y}\\cdot \\frac{3x+15}{{y}^{2}} & = \\\\ \\frac{9x}{y(x+5)}\\cdot \\frac{3(x+5)}{{y}^{2}} & = \\\\ \\frac{9x}{y\\cancel{(x+5)}}\\cdot \\frac{3\\cancel{(x+5)}}{{y}^{2}} & = \\\\ \\frac{9x}{y}\\cdot \\frac{3}{{y}^{2}} & = \\\\ \\frac{27x}{{y}^{3}}\\end{aligned}\n$$" 13194139533864 true] [17592186260191 1000 #edb/ref 17592186260192 13194139533864 true] [17592186260191 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260191 1041 "answer" 13194139533864 true] [17592186260191 1104 #edb/ref 17592186260192 13194139533864 true] [17592186260191 1110 #uuid "d26c6b86-8dee-53b5-979a-e9942547fb68" 13194139533864 true] [17592186260192 1034 "\\frac{27x}{{y}^{3}}" 13194139533864 true] [17592186260192 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260192 1111 #uuid "688319bd-d59e-5e87-9e7e-858ff689d865" 13194139533864 true] [17592186260193 1017 #edb/ref 17592186260194 13194139533864 true] [17592186260193 1017 #edb/ref 17592186260196 13194139533864 true] [17592186260193 1089 "q-36695" 13194139533864 true] [17592186260193 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260193 1100 "Find the left- and right-sided limits at $x=0$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)={\\begin{aligned}-x+1 & \\text{ for }\\,x\\le 0 \\\\ \\operatorname{sin}x+1 & \\text{ for }\\,x>0.\\end{aligned}\n$$\n\nLeft limit: {{left-limit}}\n\nRight limit: {{right-limit}}" 13194139533864 true] [17592186260193 1113 #uuid "98dc4d3c-dae5-5596-b008-46a065491e6b" 13194139533864 true] [17592186260193 1145 "Approaching from the left, we have $x<0,$ so we use the expression $f(x)=-x+1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}(-x+1) \\\\  & =-(0)+1 \\\\  & =1.\\end{aligned}\n$$\n\nNow, approaching from the right, we have $x>0,$ so we use the expression $f(x)=\\operatorname{sin}x+1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}\\operatorname{sin}x+1 \\\\  & =\\operatorname{sin}0+1 \\\\  & =0+1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to {0}^{-}}f(x)={lim}_{x\\to {0}^{+}}f(x)=1.\n$$" 13194139533864 true] [17592186260194 1000 #edb/ref 17592186260195 13194139533864 true] [17592186260194 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260194 1041 "left-limit" 13194139533864 true] [17592186260194 1104 #edb/ref 17592186260195 13194139533864 true] [17592186260194 1110 #uuid "b6d801d0-4de9-5e1e-8201-11f884ef6c79" 13194139533864 true] [17592186260195 1034 "1" 13194139533864 true] [17592186260195 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260195 1111 #uuid "4ca66b35-65c0-58bf-b873-78af0e82f941" 13194139533864 true] [17592186260196 1000 #edb/ref 17592186260197 13194139533864 true] [17592186260196 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260196 1041 "right-limit" 13194139533864 true] [17592186260196 1104 #edb/ref 17592186260197 13194139533864 true] [17592186260196 1110 #uuid "f54c2141-d85b-57b8-b293-61693a3d01dd" 13194139533864 true] [17592186260197 1034 "1" 13194139533864 true] [17592186260197 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260197 1111 #uuid "b28aa2e0-30f0-557d-8d6a-a9a9b931d232" 13194139533864 true] [17592186260198 1017 #edb/ref 17592186260199 13194139533864 true] [17592186260198 1089 "q-36722" 13194139533864 true] [17592186260198 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260198 1100 "Find the limit at $x=-2$ for the function\n\n$$\nf(x)={\\begin{aligned}{2}^{x}-3\\, & \\text{ for }\\,x\\le -2 \\\\ \\sqrt{2-x}\\, & \\text{ for }\\,-2<x<2.\\end{aligned}\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260198 1113 #uuid "45bcd46e-63f8-54ff-8722-e835994d8ea9" 13194139533864 true] [17592186260198 1145 "Approaching from the left, we have $x<-2,$ so we use the expression $f(x)={2}^{x}-3.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {(-2)}^{-}}f(x) & ={lim}_{x\\to {(-2)}^{-}}({2}^{x}-3) \\\\  & ={2}^{-2}-3 \\\\  & =\\frac{1}{4}-3 \\\\  & =-\\frac{11}{4}.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>-2,$ so we use the expression $f(x)=\\sqrt{2-x}.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {(-2)}^{+}}f(x) & ={lim}_{x\\to {(-2)}^{+}}\\sqrt{2-x} \\\\  & =\\sqrt{2-(-2)} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nSince the two limits are different, we conclude that\n\n$$\n{lim}_{x\\to (-2)}f(x)=\\text{DNE}.\n$$" 13194139533864 true] [17592186260199 1000 #edb/ref 17592186260200 13194139533864 true] [17592186260199 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260199 1041 "answer" 13194139533864 true] [17592186260199 1104 #edb/ref 17592186260200 13194139533864 true] [17592186260199 1110 #uuid "ae91c347-5060-5ede-a1cc-093cf9cf9b79" 13194139533864 true] [17592186260200 1034 "\\text{DNE}" 13194139533864 true] [17592186260200 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260200 1111 #uuid "2d98a025-d30c-5b8a-8231-ea585f24374b" 13194139533864 true] [17592186260201 1017 #edb/ref 17592186260202 13194139533864 true] [17592186260201 1089 "q-36735" 13194139533864 true] [17592186260201 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260201 1100 "Find the limit at $x=1$ for the function\n\n$$\nf(x)={\\begin{aligned}-{x}^{2}-x+2\\, & \\text{ for }\\,x\\le 1 \\\\ -{x}^{2}\\, & \\text{ for }\\,x>1.\\end{aligned}\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260201 1113 #uuid "58c75b63-39e4-5a53-bb97-bce7efb5c37c" 13194139533864 true] [17592186260201 1145 "Approaching from the left, we have $x<1,$ so we use the expression $f(x)=-{x}^{2}-x+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}(-{x}^{2}-x+2) \\\\  & =-(1)^{2}-1+2 \\\\  & =0.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>1,$ so we use the expression $f(x)=-{x}^{2}.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}(-{x}^{2}) \\\\  & =-(1)^{2} \\\\  & =-1.\\end{aligned}\n$$\n\nSince the two limits are different, we can conclude that\n\n$$\n{lim}_{x\\to 1}f(x)=\\text{DNE}.\n$$" 13194139533864 true] [17592186260202 1000 #edb/ref 17592186260203 13194139533864 true] [17592186260202 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260202 1041 "answer" 13194139533864 true] [17592186260202 1104 #edb/ref 17592186260203 13194139533864 true] [17592186260202 1110 #uuid "70b4206b-1d0f-5f90-a8c0-74341edfe1b6" 13194139533864 true] [17592186260203 1034 "\\text{DNE}" 13194139533864 true] [17592186260203 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260203 1111 #uuid "b421acdf-4ec9-52af-b94d-4a9b633c719b" 13194139533864 true] [17592186260204 1017 #edb/ref 17592186260205 13194139533864 true] [17592186260204 1017 #edb/ref 17592186260207 13194139533864 true] [17592186260204 1089 "q-36743" 13194139533864 true] [17592186260204 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260204 1100 "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}{x}^{2}+2x+b\\, & \\text{ for }\\,x\\le 1 \\\\ {x}^{2}+cx+2\\, & \\text{ for }\\,x>1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 1}f(x)=2.$ What is the value of the constants $b$ and $c?$\n\n$b$: {{b}}\n\n$c$: {{c}}" 13194139533864 true] [17592186260204 1113 #uuid "3cbc081a-4656-5dca-b3b1-aa3f8536f992" 13194139533864 true] [17592186260204 1145 "In order for ${lim}_{x\\to 1}f(x)$ to be equal to $2,$ the left and right-sided limits must both exist and be equal to $2.$\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)={x}^{2}+2x+b.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{2}+2x+b) \\\\  & ={1}^{2}+2(1)+b \\\\  & =1+2+b \\\\  & =b+3\\,.\\end{aligned}\n$$\n\nSince the left-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & =2 \\\\ b+3 & =2 \\\\ b & =2-3 \\\\ b & =-1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)={x}^{2}+cx+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{2}+cx+2) \\\\  & ={1}^{2}+c(1)+2 \\\\  & =1+c+2 \\\\  & =c+3\\,.\\end{aligned}\n$$\n\nSince the right-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & =2 \\\\ c+3 & =2 \\\\ c & =2-3 \\\\ c & =-1.\\end{aligned}\n$$" 13194139533864 true] [17592186260205 1000 #edb/ref 17592186260206 13194139533864 true] [17592186260205 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260205 1041 "b" 13194139533864 true] [17592186260205 1104 #edb/ref 17592186260206 13194139533864 true] [17592186260205 1110 #uuid "fef77817-3574-5917-8751-f6dc6ac2eaef" 13194139533864 true] [17592186260206 1034 "-1" 13194139533864 true] [17592186260206 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260206 1111 #uuid "3627d8f3-7507-59fd-add7-0a30a7f9cd5f" 13194139533864 true] [17592186260207 1000 #edb/ref 17592186260208 13194139533864 true] [17592186260207 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260207 1041 "c" 13194139533864 true] [17592186260207 1104 #edb/ref 17592186260208 13194139533864 true] [17592186260207 1110 #uuid "8e135889-0014-59ef-a4ff-b04ac2c9f0e6" 13194139533864 true] [17592186260208 1034 "-1" 13194139533864 true] [17592186260208 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260208 1111 #uuid "fda01204-9e15-5935-8160-c3810f97cd32" 13194139533864 true] [17592186260209 1017 #edb/ref 17592186260210 13194139533864 true] [17592186260209 1017 #edb/ref 17592186260212 13194139533864 true] [17592186260209 1089 "q-36744" 13194139533864 true] [17592186260209 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260209 1100 "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}{x}^{2}-3x+b\\, & \\text{ for }\\,x<2 \\\\ -{x}^{2}+cx+1\\, & \\text{ for }\\,x>2\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 2}f(x)=1.$ What is the value of the constants $b$ and $c?$\n\n$b$: {{b}}\n\n$c$: {{c}}" 13194139533864 true] [17592186260209 1113 #uuid "03dad123-1833-5311-a4f2-ae8087879f79" 13194139533864 true] [17592186260209 1145 "In order for ${lim}_{x\\to 2}f(x)$ to be equal to $1,$ the left and right-sided limits must both exist and be equal to $1.$\n\n- Approaching from the left, we have $x<2,$ so we use the expression $f(x)={x}^{2}-3x+b.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}({x}^{2}-3x+b) \\\\  & ={2}^{2}-3(2)+b \\\\  & =4-6+b \\\\  & =b-2\\,.\\end{aligned}\n$$\n\nSince the left-sided limit must be equal to $1,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & =1 \\\\ b-2 & =1 \\\\ b & =1+2 \\\\ b & =3\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>2,$ so we use the expression $f(x)=-{x}^{2}+cx+1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(-{x}^{2}+cx+1) \\\\  & =-{2}^{2}+c(2)+1 \\\\  & =-4+2c+1 \\\\  & =2c-3\\,.\\end{aligned}\n$$\n\nSince the right-sided limit must be equal to $1,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & =1 \\\\ 2c-3 & =1 \\\\ c & =\\frac{1+3}{2} \\\\ c & =2.\\end{aligned}\n$$" 13194139533864 true] [17592186260210 1000 #edb/ref 17592186260211 13194139533864 true] [17592186260210 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260210 1041 "b" 13194139533864 true] [17592186260210 1104 #edb/ref 17592186260211 13194139533864 true] [17592186260210 1110 #uuid "dbfb6eaf-b9f3-53be-be85-c1121d3491a0" 13194139533864 true] [17592186260211 1034 "3" 13194139533864 true] [17592186260211 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260211 1111 #uuid "32b89fbf-b014-5640-a34d-31a623a93f88" 13194139533864 true] [17592186260212 1000 #edb/ref 17592186260213 13194139533864 true] [17592186260212 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260212 1041 "c" 13194139533864 true] [17592186260212 1104 #edb/ref 17592186260213 13194139533864 true] [17592186260212 1110 #uuid "e9df87ad-3a19-5812-8a5e-fef466e5ea8d" 13194139533864 true] [17592186260213 1034 "2" 13194139533864 true] [17592186260213 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260213 1111 #uuid "6c8cbf0f-8ac1-5598-b1c6-00543cf63c2c" 13194139533864 true] [17592186260214 1017 #edb/ref 17592186260215 13194139533864 true] [17592186260214 1089 "q-3704" 13194139533864 true] [17592186260214 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260214 1100 "What is the distance between the points $(-10,-2)$ and $(-11,-7)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260214 1113 #uuid "25e9a336-856f-5a6a-ab32-87dcac5dfabb" 13194139533864 true] [17592186260214 1145 "In this case, we have ${{(-10,-2)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-11,-7)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(-11-(-10))^{2}+(-7-(-2))^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-5)^{2}} \\\\  & =\\sqrt{1+25} \\\\  & =\\sqrt{26}\\end{aligned}\n$$" 13194139533864 true] [17592186260215 1000 #edb/ref 17592186260216 13194139533864 true] [17592186260215 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260215 1041 "answer" 13194139533864 true] [17592186260215 1104 #edb/ref 17592186260216 13194139533864 true] [17592186260215 1110 #uuid "05097588-3588-5623-984f-fdd4a4aae5d1" 13194139533864 true] [17592186260216 1034 "\\sqrt{26}" 13194139533864 true] [17592186260216 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260216 1111 #uuid "49aee943-123d-5bbd-8a97-1fc7c8e86697" 13194139533864 true] [17592186260217 1017 #edb/ref 17592186260218 13194139533864 true] [17592186260217 1089 "q-37556" 13194139533864 true] [17592186260217 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260217 1100 "Factor the expression $8{x}^{3}+64{y}^{3}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260217 1113 #uuid "0f555f4c-a2a8-5de1-aa66-3ef3e108a7af" 13194139533864 true] [17592186260217 1145 "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $8.$ To simplify the computation, we can factor out the $8,$ as follows:\n\n$$\n8{x}^{3}+64{y}^{3}=8({x}^{3}+8{y}^{3})\n$$\n\nThe expression in parentheses can be written as a sum of cubes:\n\n$$\n8({x}^{3}+8{y}^{3})=8({x}^{3}+(2y)^{3})\n$$\n\nNow, we factor the expression in parentheses using the sum of cubes formula:\n\n$$\n\\begin{aligned}8{x}^{3}+64{y}^{3} & =8({x}^{3}+(2y)^{3}) \\\\  & =8(x+2y)({x}^{2}-x\\cdot 2y+(2y)^{2}) \\\\  & =8(x+2y)({x}^{2}-2xy+4{y}^{2})\\end{aligned}\n$$" 13194139533864 true] [17592186260218 1000 #edb/ref 17592186260219 13194139533864 true] [17592186260218 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260218 1041 "answer" 13194139533864 true] [17592186260218 1104 #edb/ref 17592186260219 13194139533864 true] [17592186260218 1110 #uuid "d10cbec4-2c07-5a22-947a-31490dc19a99" 13194139533864 true] [17592186260219 1034 "8(x+2y)({x}^{2}-2xy+4{y}^{2})" 13194139533864 true] [17592186260219 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260219 1111 #uuid "3f5b4ae7-d446-565d-8840-2a1c4124b6ca" 13194139533864 true] [17592186260220 1017 #edb/ref 17592186260221 13194139533864 true] [17592186260220 1089 "q-37702" 13194139533864 true] [17592186260220 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260220 1100 "Factor the expression $\\frac{3{x}^{4}}{2}-24.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260220 1113 #uuid "a639602e-39c5-51b8-b4e5-2591b688f7fc" 13194139533864 true] [17592186260220 1145 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that ${x}^{4}$ has a factor of $\\frac{3}{2}.$ To simplify the computation, we can factor out the $\\frac{3}{2}$ in our expression, as follows:\n\n$$\n\\frac{3{x}^{4}}{2}-24=\\frac{3}{2}\\cdot {x}^{4}-\\frac{3}{2}\\cdot 16=\\frac{3}{2}({x}^{4}-16)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n\\frac{3}{2}({x}^{4}-16)=\\frac{3}{2}({({x}^{2})}^{2}-{4}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n\\frac{3}{2}({({x}^{2})}^{2}-{4}^{2})=\\frac{3}{2}({x}^{2}+4)({x}^{2}-4)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}\\frac{3}{2}({x}^{2}+4)({x}^{2}-4) & =\\frac{3}{2}({x}^{2}+4)({x}^{2}-{2}^{2}) \\\\  & =\\frac{3}{2}({x}^{2}+4)(x+2)(x-2)\\end{aligned}\n$$" 13194139533864 true] [17592186260221 1000 #edb/ref 17592186260222 13194139533864 true] [17592186260221 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260221 1041 "answer" 13194139533864 true] [17592186260221 1104 #edb/ref 17592186260222 13194139533864 true] [17592186260221 1110 #uuid "7f870397-1f55-53b8-84e2-4c2fa430d34e" 13194139533864 true] [17592186260222 1034 "\\frac{3}{2}({x}^{2}+4)(x+2)(x-2)" 13194139533864 true] [17592186260222 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260222 1111 #uuid "8facd36b-4ffd-5122-899f-ee1d928a9890" 13194139533864 true] [17592186260223 1017 #edb/ref 17592186260224 13194139533864 true] [17592186260223 1089 "q-3771" 13194139533864 true] [17592186260223 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260223 1100 "${lim}_{x\\to 0}\\frac{{e}^{3x}-1}{x}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260223 1113 #uuid "fe552b19-ecf8-5441-b376-c5bd68d19d28" 13194139533864 true] [17592186260223 1145 "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{3x}-1}{x} & ={lim}_{x\\to 0}\\frac{[{e}^{3x}-1]^{'}}{[x]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{3{e}^{3x}}{1} \\\\  & =3{e}^{3(0)} \\\\  & =3(1) \\\\  & =3\\end{aligned}\n$$" 13194139533864 true] [17592186260224 1000 #edb/ref 17592186260225 13194139533864 true] [17592186260224 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260224 1041 "answer" 13194139533864 true] [17592186260224 1104 #edb/ref 17592186260225 13194139533864 true] [17592186260224 1110 #uuid "e998e495-1f1f-5d85-87c2-c25c02c03dfd" 13194139533864 true] [17592186260225 1034 "3" 13194139533864 true] [17592186260225 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260225 1111 #uuid "0aba405f-646d-527d-87c9-c54ec866fd50" 13194139533864 true] [17592186260226 1017 #edb/ref 17592186260227 13194139533864 true] [17592186260226 1089 "q-37713" 13194139533864 true] [17592186260226 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260226 1100 "Factor the expression $2{r}^{4}-32.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260226 1113 #uuid "5639c612-ad13-56af-82f6-525e8cd4941e" 13194139533864 true] [17592186260226 1145 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms in our expression have a common factor of $2.$ To simplify the computation, we can factor out the $2,$ as follows:\n\n$$\n2{r}^{4}-32=2\\cdot {r}^{4}-2\\cdot 16=2({r}^{4}-16)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n2({r}^{4}-16)=2({({r}^{2})}^{2}-{4}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n2({({r}^{2})}^{2}-{4}^{2})=2({r}^{2}+4)({r}^{2}-4)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}2({r}^{2}+4)({r}^{2}-4) & =2({r}^{2}+4)({r}^{2}-{2}^{2}) \\\\  & =2({r}^{2}+4)(r+2)(r-2)\\end{aligned}\n$$" 13194139533864 true] [17592186260227 1000 #edb/ref 17592186260228 13194139533864 true] [17592186260227 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260227 1041 "answer" 13194139533864 true] [17592186260227 1104 #edb/ref 17592186260228 13194139533864 true] [17592186260227 1110 #uuid "c4282184-b16c-5e57-9d04-02e18d0d9d1c" 13194139533864 true] [17592186260228 1034 "2({r}^{2}+4)(r+2)(r-2)" 13194139533864 true] [17592186260228 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260228 1111 #uuid "c338ffc9-147b-5a7e-95d6-815775f54f68" 13194139533864 true] [17592186260229 1017 #edb/ref 17592186260230 13194139533864 true] [17592186260229 1017 #edb/ref 17592186260232 13194139533864 true] [17592186260229 1089 "q-3783" 13194139533864 true] [17592186260229 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260229 1100 "$2{x}^{2}=-18$ has the solutions\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260229 1113 #uuid "6e7a2f2a-eb16-5a6f-9053-e49c72b4b60a" 13194139533864 true] [17592186260229 1145 "First, we rewrite the equation, as follows:\n\n$$\n\\begin{aligned}2{x}^{2} & =-18 \\\\ {x}^{2} & =-\\frac{18}{2} \\\\ {x}^{2} & =-9\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nx=\\pm \\sqrt{-9}\n$$\n\nWe now rewrite $x$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}x & =\\pm \\sqrt{-9} \\\\  & =\\pm \\sqrt{9\\cdot (-1)} \\\\  & =\\pm \\sqrt{9}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260230 1000 #edb/ref 17592186260231 13194139533864 true] [17592186260230 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260230 1041 "negative-imaginary" 13194139533864 true] [17592186260230 1104 #edb/ref 17592186260231 13194139533864 true] [17592186260230 1110 #uuid "f7910f23-724b-59d9-ad7d-a355a2f0691e" 13194139533864 true] [17592186260231 1034 "-3\\text{i}" 13194139533864 true] [17592186260231 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260231 1111 #uuid "db4a9db6-c627-5160-b1b1-62c11ebf7de3" 13194139533864 true] [17592186260232 1000 #edb/ref 17592186260233 13194139533864 true] [17592186260232 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260232 1041 "positive-imaginary" 13194139533864 true] [17592186260232 1104 #edb/ref 17592186260233 13194139533864 true] [17592186260232 1110 #uuid "c9a00dfb-b781-518e-841a-b1c1026bde2d" 13194139533864 true] [17592186260233 1034 "3\\text{i}" 13194139533864 true] [17592186260233 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260233 1111 #uuid "4568e03f-33ab-5c2f-a5b2-5d9d03208ba1" 13194139533864 true] [17592186260234 1017 #edb/ref 17592186260235 13194139533864 true] [17592186260234 1017 #edb/ref 17592186260237 13194139533864 true] [17592186260234 1089 "q-3808" 13194139533864 true] [17592186260234 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260234 1100 "Determine the solutions of the equation $3{r}^{2}+27=0.$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260234 1113 #uuid "77273b9c-44fa-5c95-bcfa-163635f82eb2" 13194139533864 true] [17592186260234 1145 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}3{r}^{2}+27 & =0 \\\\ 3{r}^{2} & =-27 \\\\ {r}^{2} & =-9\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nr=\\pm \\sqrt{-9}\n$$\n\nWe now rewrite $r$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}r & =\\pm \\sqrt{-9} \\\\  & =\\pm \\sqrt{9\\cdot (-1)} \\\\  & =\\pm \\sqrt{9}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260235 1000 #edb/ref 17592186260236 13194139533864 true] [17592186260235 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260235 1041 "negative-imaginary" 13194139533864 true] [17592186260235 1104 #edb/ref 17592186260236 13194139533864 true] [17592186260235 1110 #uuid "79368221-cc13-5803-8c43-ad8e07512ab9" 13194139533864 true] [17592186260236 1034 "-3\\text{i}" 13194139533864 true] [17592186260236 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260236 1111 #uuid "02724726-2784-5ef6-bc37-24132bdb2ccc" 13194139533864 true] [17592186260237 1000 #edb/ref 17592186260238 13194139533864 true] [17592186260237 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260237 1041 "positive-imaginary" 13194139533864 true] [17592186260237 1104 #edb/ref 17592186260238 13194139533864 true] [17592186260237 1110 #uuid "5835b15d-b5ee-570e-bb08-558cbd3e61b0" 13194139533864 true] [17592186260238 1034 "3\\text{i}" 13194139533864 true] [17592186260238 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260238 1111 #uuid "d5204408-ca35-5c5d-9cd5-c818ef94d47a" 13194139533864 true] [17592186260239 1017 #edb/ref 17592186260240 13194139533864 true] [17592186260239 1089 "q-38592" 13194139533864 true] [17592186260239 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260239 1100 "Let $f(x)$ be the function defined below. For what value of $k$ is $f(x)$ continuous at $x=-1?$\n\n$$\nf(x)={\\begin{aligned}\\frac{k}{x-1}, & x<-1 \\\\ 2x-k, & x\\ge -1\\end{aligned}\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260239 1113 #uuid "6a0708c3-6443-5100-a620-9e95f2c04652" 13194139533864 true] [17592186260239 1145 "From the definition of $f(x)$, the left-sided limit of $f(x)$ at $x=-1$ is\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{-}}f(x) & ={lim}_{x\\to -{1}^{-}}\\frac{k}{x-1} \\\\  & =\\frac{k}{-1-1} \\\\  & =-\\frac{k}{2}.\\end{aligned}\n$$\n\nOn the other hand, the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{+}}f(x) & ={lim}_{x\\to -{1}^{+}}(2x-k) \\\\  & =2(-1)-k \\\\  & =-2-k.\\end{aligned}\n$$\n\nWe also note that $f(-1)=-2-k.$ \n\nSo, for $f(x)$ to be continuous at $x=-1,$ we must have\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{+}}f(x) & ={lim}_{x\\to -{1}^{-}}f(x) \\\\ -2-k & =-\\frac{k}{2} \\\\ -4-2k & =-k \\\\ k & =-4.\\end{aligned}\n$$\n\nTherefore, $k=-4$ removes the discontinuity at $x=-1.$" 13194139533864 true] [17592186260240 1000 #edb/ref 17592186260241 13194139533864 true] [17592186260240 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260240 1041 "answer" 13194139533864 true] [17592186260240 1104 #edb/ref 17592186260241 13194139533864 true] [17592186260240 1110 #uuid "ebe8e595-9b2a-5813-9735-4dac52b76b87" 13194139533864 true] [17592186260241 1034 "-1" 13194139533864 true] [17592186260241 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260241 1111 #uuid "d8559109-d0d3-5d8a-9569-96affb8bc4a6" 13194139533864 true] [17592186260242 1017 #edb/ref 17592186260243 13194139533864 true] [17592186260242 1089 "q-38763" 13194139533864 true] [17592186260242 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260242 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/2a8352e83cdbdbfc250125d9d1e0f36ee079ca2793973cfde6eaacc2943fe8d3.png)\n\nWhat could be the equation of the polynomial curve shown above?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260242 1113 #uuid "7945d8b0-07f1-5fd2-9eec-daaae659ced4" 13194139533864 true] [17592186260242 1145 "First, we notice that the function has precisely three distinct roots, $x=-2,$ $x=-1,$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph just touches the $x$-axis and reverses direction at $x=-1,$ this root has even multiplicity.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=2,$ this root is a simple root (the multiplicity equals $1$).\n\nFrom the given options, the only possible equation is $y=\\frac{1}{4}(x+2)(x+1)^{2}(x-2).$" 13194139533864 true] [17592186260243 1000 #edb/ref 17592186260244 13194139533864 true] [17592186260243 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260243 1041 "answer" 13194139533864 true] [17592186260243 1104 #edb/ref 17592186260244 13194139533864 true] [17592186260243 1110 #uuid "949d84ef-9ca7-5ca6-9aa1-0f74623084fd" 13194139533864 true] [17592186260244 1034 "\\frac{1}{4}(x+2)(x+1)^{2}(x-2)" 13194139533864 true] [17592186260244 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260244 1111 #uuid "7e453391-40b7-54a7-a78f-5cea0e7b4f6f" 13194139533864 true] [17592186260245 1017 #edb/ref 17592186260246 13194139533864 true] [17592186260245 1089 "q-38765" 13194139533864 true] [17592186260245 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260245 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/8ec1115a3f38481a3013797b2824a0a13148b2bb0e7138964966b873094727c1.png)\n\nWhat could be the equation of the polynomial curve shown above?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260245 1113 #uuid "a9585562-3c89-5dba-a5e8-5e2ad82590cd" 13194139533864 true] [17592186260245 1145 "First, we notice that the function has precisely four distinct roots, $x=-1,$ $x=1,$ $x=2,$ and $x=3.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph just touches the $x$-axis and reverses direction at $x=-1,$ this root has even multiplicity.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=1,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph is *not* tangent to the $x$-axis at $x=2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph is *not* tangent to the $x$-axis at $x=3,$ this root is a simple root (the multiplicity equals $1$).\n\nFrom the given options, the only possible equation is $y=(x+1)^{2}(x-1)(x-2)(x-3).$" 13194139533864 true] [17592186260246 1000 #edb/ref 17592186260247 13194139533864 true] [17592186260246 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260246 1041 "answer" 13194139533864 true] [17592186260246 1104 #edb/ref 17592186260247 13194139533864 true] [17592186260246 1110 #uuid "ca40060d-767c-5fd4-b38e-78177238e5fb" 13194139533864 true] [17592186260247 1034 "(x+1)^{2}(x-1)(x-2)(x-3)" 13194139533864 true] [17592186260247 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260247 1111 #uuid "4da1c51a-0ca4-55fe-b18b-400c17d05362" 13194139533864 true] [17592186260248 1017 #edb/ref 17592186260249 13194139533864 true] [17592186260248 1089 "q-39069" 13194139533864 true] [17592186260248 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260248 1100 "What is the index of the term $-75$ for the arithmetic sequence below?\n\n$$\n{a}_{n+1}={a}_{n}-3,\\,{a}_{1}=-3,\\,n\\ge 1\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260248 1113 #uuid "9ec80876-92cf-51cb-8c78-67cced1a623f" 13194139533864 true] [17592186260248 1145 "We will convert the recursive formula to an explicit formula and then solve for the value of $n$ such that ${a}_{n}=-75.$\n\nThe recursive rule for an arithmetic sequence takes the form\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn the given formula, we have $d=-3.$ We are also told that ${a}_{1}=-3,$ so we can write the explicit formula as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-3+(n-1)(-3) \\\\  & =-3-3n+3 \\\\  & =-3n\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ such that ${a}_{n}=-75:$\n\n$$\n\\begin{aligned}{a}_{n} & =-3n \\\\ -75 & =-3n \\\\ \\frac{-75}{-3} & =n \\\\ 25 & =n\\end{aligned}\n$$\n\nTherefore, $-75$ is the $25$th term of the sequence." 13194139533864 true] [17592186260249 1000 #edb/ref 17592186260250 13194139533864 true] [17592186260249 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260249 1041 "answer" 13194139533864 true] [17592186260249 1104 #edb/ref 17592186260250 13194139533864 true] [17592186260249 1110 #uuid "644a2064-f413-5926-b152-af6d8ab6d2f8" 13194139533864 true] [17592186260250 1034 "25" 13194139533864 true] [17592186260250 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260250 1111 #uuid "8ae76a6d-e04f-580c-b80c-6fa055192eaf" 13194139533864 true] [17592186260251 1017 #edb/ref 17592186260252 13194139533864 true] [17592186260251 1089 "q-39273" 13194139533864 true] [17592186260251 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260251 1100 "For the curve $y=\\frac{1}{x},$ which of the following statements are true?\n\nI. - The domain of the function is $x\\in (-\\infty ,1)\\cup (1,\\infty ).$\nII. - The graph of the function passes through the point $(2,\\frac{1}{2}).$\nIII. - $y\\to -\\infty $ as $x\\to {0}^{+}.$" 13194139533864 true] [17592186260251 1113 #uuid "8c4a36da-599f-5664-ba9f-ac2ade1112ca" 13194139533864 true] [17592186260251 1145 "First, let's sketch the graph of $y=\\frac{1}{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ffd98b8f9b6c7a9260f43772f9c654901bd02c21efa1eb06f2a5fdad8b263729.png)\n\nNow, we analyze each statement in turn.\n\n- Statement I is false. The function is defined on all real numbers except $0.$ So, the domain of the function is $x\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- Statement II is true. When $x=2,$ we get $y=\\frac{1}{2},$ so the point $(2,\\frac{1}{2})$ lies on the curve.\n\n- Statement III is false. From the graph, we see that $y\\to \\infty $ as $x\\to {0}^{+}.$\n\nIn conclusion, the correct answer is \"II only\"." 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260253 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260254 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260255 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260256 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260257 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260258 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260259 13194139533864 true] [17592186260252 1000 #edb/ref 17592186260260 13194139533864 true] [17592186260252 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260252 1041 "selection" 13194139533864 true] [17592186260252 1104 #edb/ref 17592186260260 13194139533864 true] [17592186260252 1110 #uuid "2a811596-4561-58d6-aa4d-f28d49154dd6" 13194139533864 true] [17592186260253 1034 "I, II, and III" 13194139533864 true] [17592186260253 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260253 1111 #uuid "3f39dc82-820e-5548-a0dd-c19e651b8a80" 13194139533864 true] [17592186260254 1034 "II and III only" 13194139533864 true] [17592186260254 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260254 1111 #uuid "203714a3-86e4-5086-a47e-056427b64a5f" 13194139533864 true] [17592186260255 1034 "I and III only" 13194139533864 true] [17592186260255 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260255 1111 #uuid "68357f1e-38a3-5f15-ada5-2918d0749d0f" 13194139533864 true] [17592186260256 1034 "I only" 13194139533864 true] [17592186260256 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260256 1111 #uuid "004fcd5a-d9cd-5ef1-9566-8524db4dcaa1" 13194139533864 true] [17592186260257 1034 "III only" 13194139533864 true] [17592186260257 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260257 1111 #uuid "fe083ecf-90fd-5715-aac8-b2ee888d250f" 13194139533864 true] [17592186260258 1034 "I and II only" 13194139533864 true] [17592186260258 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260258 1111 #uuid "ee09beba-184e-52a2-8655-5ddd98441138" 13194139533864 true] [17592186260259 1034 "None of those listed" 13194139533864 true] [17592186260259 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260259 1111 #uuid "32e51ac3-ebb0-5b54-8c8a-8c0e6a914bb7" 13194139533864 true] [17592186260260 1034 "II only" 13194139533864 true] [17592186260260 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260260 1111 #uuid "d09abb86-4cb1-5d8a-81b3-f062a0ae6192" 13194139533864 true] [17592186260261 1017 #edb/ref 17592186260262 13194139533864 true] [17592186260261 1017 #edb/ref 17592186260264 13194139533864 true] [17592186260261 1089 "q-39790" 13194139533864 true] [17592186260261 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260261 1100 "Calculate the vertical asymptotes of $f(x)=\\frac{x+1}{2{x}^{2}+x-3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" 13194139533864 true] [17592186260261 1113 #uuid "81b756f0-9b92-5a8e-a082-00d2ced4e8ae" 13194139533864 true] [17592186260261 1145 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x+1}{(2x+3)(x-1)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(2x+3)(x-1) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-\\frac{3}{2}$ and $x=1.$ Therefore, the equations of the vertical asymptotes are $x=-\\frac{3}{2}$ and $x=1.$" 13194139533864 true] [17592186260262 1000 #edb/ref 17592186260263 13194139533864 true] [17592186260262 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260262 1041 "root-1" 13194139533864 true] [17592186260262 1104 #edb/ref 17592186260263 13194139533864 true] [17592186260262 1110 #uuid "771e6309-23e4-5a36-ae53-d5409300995e" 13194139533864 true] [17592186260263 1034 "-\\frac32" 13194139533864 true] [17592186260263 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260263 1111 #uuid "ba9ce503-e19f-5913-9d26-006b9308551f" 13194139533864 true] [17592186260264 1000 #edb/ref 17592186260265 13194139533864 true] [17592186260264 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260264 1041 "root-2" 13194139533864 true] [17592186260264 1104 #edb/ref 17592186260265 13194139533864 true] [17592186260264 1110 #uuid "6cfa389f-de85-58d6-9df0-88cfe98f06cb" 13194139533864 true] [17592186260265 1034 "1" 13194139533864 true] [17592186260265 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260265 1111 #uuid "6b4427b7-43fd-59ae-906a-c1bb5d224a31" 13194139533864 true] [17592186260266 1017 #edb/ref 17592186260267 13194139533864 true] [17592186260266 1017 #edb/ref 17592186260269 13194139533864 true] [17592186260266 1089 "q-39802" 13194139533864 true] [17592186260266 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260266 1100 "Find the vertical asymptotes of $f(x)=\\frac{{x}^{2}-x-2}{{x}^{3}+7{x}^{2}-x-7}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" 13194139533864 true] [17592186260266 1113 #uuid "60689cc0-1330-59f8-9b56-7c01aabe3494" 13194139533864 true] [17592186260266 1145 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-x-2}{{x}^{3}+7{x}^{2}-x-7} \\\\  & =\\frac{(x-2)(x+1)}{{x}^{2}(x+7)-(x+7)} \\\\  & =\\frac{(x-2)(x+1)}{({x}^{2}-1)(x+7)} \\\\  & =\\frac{(x-2)(x+1)}{(x-1)(x+1)(x+7)} \\\\  & =\\frac{(x-2)\\cancel{(x+1)}}{(x-1)\\cancel{(x+1)}(x+7)} \\\\  & =\\frac{x-2}{(x-1)(x+7)}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x-1)(x+7)=0\n$$\n\nThis gives the two solutions $x=-7$ and $x=1.$ Therefore, the equations of the vertical asymptotes are $x=-7$ and $x=1.$" 13194139533864 true] [17592186260267 1000 #edb/ref 17592186260268 13194139533864 true] [17592186260267 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260267 1041 "root-1" 13194139533864 true] [17592186260267 1104 #edb/ref 17592186260268 13194139533864 true] [17592186260267 1110 #uuid "a4838539-8ac7-5fe3-98da-c19d4d040c6b" 13194139533864 true] [17592186260268 1034 "-7" 13194139533864 true] [17592186260268 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260268 1111 #uuid "f67911e8-8b1d-5d46-866b-cf157e0fa04f" 13194139533864 true] [17592186260269 1000 #edb/ref 17592186260270 13194139533864 true] [17592186260269 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260269 1041 "root-2" 13194139533864 true] [17592186260269 1104 #edb/ref 17592186260270 13194139533864 true] [17592186260269 1110 #uuid "208f45e0-bf6c-5037-9987-d49ff6eb7dda" 13194139533864 true] [17592186260270 1034 "1" 13194139533864 true] [17592186260270 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260270 1111 #uuid "c68b2b34-ebf2-53f8-97aa-f1db5bbe7f2a" 13194139533864 true] [17592186260271 1017 #edb/ref 17592186260272 13194139533864 true] [17592186260271 1089 "q-39825" 13194139533864 true] [17592186260271 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260271 1100 "Solve $\\sqrt{8x-5}=\\sqrt{3}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260271 1113 #uuid "193e9c3b-5823-5fe7-b42e-9a9b3e4a9d8b" 13194139533864 true] [17592186260271 1145 "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{8x-5} & =\\sqrt{3} \\\\ {(\\sqrt{8x-5})}^{2} & =(\\sqrt{3})^{2} \\\\ 8x-5 & =3 \\\\ 8x & =8 \\\\ x & =1.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{8\\cdot 1-5} & \\overset{?}{=}\\sqrt{3} \\\\ \\sqrt{8-5} & \\overset{?}{=}\\sqrt{3} \\\\ \\sqrt{3} & =\\sqrt{3}\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=1$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{8x-5}=\\sqrt{3}$  is $x=1.$" 13194139533864 true] [17592186260272 1000 #edb/ref 17592186260273 13194139533864 true] [17592186260272 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260272 1041 "answer" 13194139533864 true] [17592186260272 1104 #edb/ref 17592186260273 13194139533864 true] [17592186260272 1110 #uuid "d059153d-357b-56ea-b351-d096c5692bff" 13194139533864 true] [17592186260273 1034 "1" 13194139533864 true] [17592186260273 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260273 1111 #uuid "fcf4dce6-1e7d-5176-950f-96b4537b78af" 13194139533864 true] [17592186260274 1017 #edb/ref 17592186260275 13194139533864 true] [17592186260274 1089 "q-39830" 13194139533864 true] [17592186260274 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260274 1100 "Solve $8-\\frac{\\sqrt{x+2}}{6}=6.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260274 1113 #uuid "0845673e-0a7d-58b4-9254-65ae15f4f4cf" 13194139533864 true] [17592186260274 1145 "First, we isolate the term $-\\frac{\\sqrt{x+2}}{6}$ by subtracting $8$ from both sides:\n\n$$\n\\begin{aligned}8-\\frac{\\sqrt{x+2}}{6} & =6 \\\\ -\\frac{\\sqrt{x+2}}{6} & =-2\\end{aligned}\n$$\n\nNow, we isolate the square root by multiplying by $-6$ on both sides:\n\n$$\n\\begin{aligned}-\\frac{\\sqrt{x+2}}{6} & =-2 \\\\ \\sqrt{x+2} & =12\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{x+2} & =12 \\\\ (\\sqrt{x+2})^{2} & ={12}^{2} \\\\ x+2 & =144 \\\\ x & =142.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}8-\\frac{\\sqrt{142+2}}{6} & \\overset{?}{=}6 \\\\ 8-\\frac{\\sqrt{144}}{6} & \\overset{?}{=}6 \\\\ 8-\\frac{12}{6} & \\overset{?}{=}6 \\\\ 6 & =6\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=142$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $8-\\frac{\\sqrt{x+2}}{6}=6$  is $x=142.$" 13194139533864 true] [17592186260275 1000 #edb/ref 17592186260276 13194139533864 true] [17592186260275 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260275 1041 "answer" 13194139533864 true] [17592186260275 1104 #edb/ref 17592186260276 13194139533864 true] [17592186260275 1110 #uuid "3d2b07a8-a82f-5b65-88a0-840cdbabae14" 13194139533864 true] [17592186260276 1034 "142" 13194139533864 true] [17592186260276 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260276 1111 #uuid "d0798a66-db69-5497-b608-6cd7176099fb" 13194139533864 true] [17592186260277 1017 #edb/ref 17592186260278 13194139533864 true] [17592186260277 1017 #edb/ref 17592186260280 13194139533864 true] [17592186260277 1089 "q-39832" 13194139533864 true] [17592186260277 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260277 1100 "Solve $\\sqrt{{x}^{2}-x-4}=4.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" 13194139533864 true] [17592186260277 1113 #uuid "98003bca-fa53-57e1-a8e6-79179173f6b8" 13194139533864 true] [17592186260277 1145 "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-x-4} & =4 \\\\ {(\\sqrt{{x}^{2}-x-4})}^{2} & ={4}^{2} \\\\ {x}^{2}-x-4 & =16 \\\\ {x}^{2}-x-20 & =0 \\\\ (x-5)(x+4) & =0 \\\\ x & =-4,\\,5.\\end{aligned}\n$$\n\nLet's check the result by plugging the solutions into the original equation. \n\n- For $x=-4$, we get\n\n$$\n\\begin{aligned}\\sqrt{(-4)^{2}-(-4)-4} & \\overset{?}{=}4 \\\\ \\sqrt{16+4-4} & \\overset{?}{=}4 \\\\ \\sqrt{16} & \\overset{?}{=}4 \\\\ 4 & =4\\,\\,✓\\end{aligned}\n$$\n\n- For $x=5$, we get\n\n$$\n\\begin{aligned}\\sqrt{{5}^{2}-5-4} & \\overset{?}{=}4 \\\\ \\sqrt{25-5-4} & \\overset{?}{=}4 \\\\ \\sqrt{16} & \\overset{?}{=}4 \\\\ 4 & =4\\,\\,✓\\end{aligned}\n$$\n\nThe values $x=-4,\\,5$ satisfy the original equation, so we can accept them as solutions.\n\nTherefore, the solutions to $\\sqrt{{x}^{2}-x-4}=4$  are $x=-4$ and $x=5.$" 13194139533864 true] [17592186260278 1000 #edb/ref 17592186260279 13194139533864 true] [17592186260278 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260278 1041 "root-1" 13194139533864 true] [17592186260278 1104 #edb/ref 17592186260279 13194139533864 true] [17592186260278 1110 #uuid "fc8d9b98-e0a3-59ab-aa53-d00a41de0596" 13194139533864 true] [17592186260279 1034 "-4" 13194139533864 true] [17592186260279 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260279 1111 #uuid "ef03f08c-e294-5878-842e-eb5f397b1825" 13194139533864 true] [17592186260280 1000 #edb/ref 17592186260281 13194139533864 true] [17592186260280 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260280 1041 "root-2" 13194139533864 true] [17592186260280 1104 #edb/ref 17592186260281 13194139533864 true] [17592186260280 1110 #uuid "736a8b92-b3e8-56c3-8089-3512e8c5dd0c" 13194139533864 true] [17592186260281 1034 "5" 13194139533864 true] [17592186260281 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260281 1111 #uuid "0b4e387d-4612-5b07-aae3-26f3b30882c7" 13194139533864 true] [17592186260282 1017 #edb/ref 17592186260283 13194139533864 true] [17592186260282 1017 #edb/re