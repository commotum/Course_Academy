139533864 true] [17592186259731 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259731 1100 "Using the fact that ${120}^{∘}={150}^{∘}-{30}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}({120}^{∘}).$\n\n$\\operatorname{cos}({120}^{∘})=$\n{{field-1}}" 13194139533864 true] [17592186259731 1113 #uuid "c17df135-ee84-5f51-838d-783803b3c840" 13194139533864 true] [17592186259731 1145 "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x={150}^{∘}$ and $y={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}({120}^{∘}) & =\\operatorname{cos}({150}^{∘}-{30}^{∘}) \\\\  & =\\operatorname{cos}({150}^{∘})\\operatorname{cos}({30}^{∘})+\\operatorname{sin}({150}^{∘})\\operatorname{sin}({30}^{∘}) \\\\  & =(-\\frac{\\sqrt{3}}{2})\\cdot \\frac{\\sqrt{3}}{2}+\\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{3}{4}+\\frac{1}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186259732 1000 #edb/ref 17592186259733 13194139533864 true] [17592186259732 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259732 1041 "field-1" 13194139533864 true] [17592186259732 1104 #edb/ref 17592186259733 13194139533864 true] [17592186259732 1110 #uuid "8d6cd35c-99df-53bf-a223-b226bd97ad44" 13194139533864 true] [17592186259733 1034 "-\\frac{1}{2}" 13194139533864 true] [17592186259733 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259733 1111 #uuid "51848a55-9dcd-5809-8d1d-b784e728b2d6" 13194139533864 true] [17592186259734 1017 #edb/ref 17592186259735 13194139533864 true] [17592186259734 1017 #edb/ref 17592186259737 13194139533864 true] [17592186259734 1089 "q-332509" 13194139533864 true] [17592186259734 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259734 1100 "Express $\\operatorname{cos}(x+{330}^{∘})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{cos}(x+{330}^{∘})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" 13194139533864 true] [17592186259734 1113 #uuid "b25c8bbb-7711-5aeb-aaeb-86aea98f9435" 13194139533864 true] [17592186259734 1145 "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(u+v)=\\operatorname{cos}u\\operatorname{cos}v-\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={330}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x+{330}^{∘}) & =\\operatorname{cos}x\\operatorname{cos}{330}^{∘}-\\operatorname{sin}x\\operatorname{sin}{330}^{∘} \\\\  & =\\operatorname{cos}x\\cdot \\frac{\\sqrt{3}}{2}-\\operatorname{sin}x\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$" 13194139533864 true] [17592186259735 1000 #edb/ref 17592186259736 13194139533864 true] [17592186259735 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259735 1041 "field-1" 13194139533864 true] [17592186259735 1104 #edb/ref 17592186259736 13194139533864 true] [17592186259735 1110 #uuid "063dfd94-2bbe-514c-a093-9dceaa47e537" 13194139533864 true] [17592186259736 1034 "\\frac{1}{2}" 13194139533864 true] [17592186259736 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259736 1111 #uuid "4d636191-15fc-5c2a-b9c9-8f4943ad9652" 13194139533864 true] [17592186259737 1000 #edb/ref 17592186259738 13194139533864 true] [17592186259737 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259737 1041 "field-2" 13194139533864 true] [17592186259737 1104 #edb/ref 17592186259738 13194139533864 true] [17592186259737 1110 #uuid "7aa0ccc9-583d-58a8-865d-696a168eb38e" 13194139533864 true] [17592186259738 1034 "\\frac{\\sqrt{3}}{2}" 13194139533864 true] [17592186259738 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259738 1111 #uuid "0ba279fd-6d34-5a0a-a655-9a8a46435c31" 13194139533864 true] [17592186259739 1017 #edb/ref 17592186259740 13194139533864 true] [17592186259739 1089 "q-334171" 13194139533864 true] [17592186259739 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259739 1100 "Given that $p(x)=\\frac{-6}{{x}^{5}}$ and $q(x)=\\frac{3}{{x}^{2}},$ evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)}=$\n{{field-1}}" 13194139533864 true] [17592186259739 1113 #uuid "0de860f6-11f7-5006-bbaa-d1ca0fb6d2bc" 13194139533864 true] [17592186259739 1145 "First, we divide the two functions, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{-6}{{x}^{5}})}{(\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }(-\\frac{2}{{x}^{3}})\\end{aligned}\n$$\n\nNow, we use the algebra of limits to pull out the constant factor of $-2:$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-\\frac{2}{{x}^{3}}) & ={lim}_{x\\to -\\infty }(-2\\cdot \\frac{1}{{x}^{3}}) \\\\  & =-2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})=0,\n$$\n\nwe can evaluate our limit as follows:\n\n$$\n-2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{3}})=-2\\cdot 0=0\n$$" 13194139533864 true] [17592186259740 1000 #edb/ref 17592186259741 13194139533864 true] [17592186259740 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259740 1041 "field-1" 13194139533864 true] [17592186259740 1104 #edb/ref 17592186259741 13194139533864 true] [17592186259740 1110 #uuid "13b5cebc-ed49-5730-9a88-a8e0f04c3d34" 13194139533864 true] [17592186259741 1034 "0" 13194139533864 true] [17592186259741 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259741 1111 #uuid "1c4fbdff-9f6e-56e1-a6c8-7bcfab6bbe8b" 13194139533864 true] [17592186259742 1017 #edb/ref 17592186259743 13194139533864 true] [17592186259742 1089 "q-334189" 13194139533864 true] [17592186259742 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259742 1100 "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{\\sqrt{3}}{6({x}^{5}-4)}=$\n{{field-1}}" 13194139533864 true] [17592186259742 1113 #uuid "9c04f322-6297-5a59-99f0-946aa65e8f91" 13194139533864 true] [17592186259742 1145 "First, we rewrite our limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{\\sqrt{3}}{6({x}^{5}-4)}=\\frac{\\sqrt{3}}{6}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${x}^{5}-4$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n\\frac{\\sqrt{3}}{6}\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}-4}=\\frac{\\sqrt{3}}{6}\\cdot 0=0\n$$" 13194139533864 true] [17592186259743 1000 #edb/ref 17592186259744 13194139533864 true] [17592186259743 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259743 1041 "field-1" 13194139533864 true] [17592186259743 1104 #edb/ref 17592186259744 13194139533864 true] [17592186259743 1110 #uuid "5fd90552-824a-5df9-b4cd-4c041b6d04fd" 13194139533864 true] [17592186259744 1034 "0" 13194139533864 true] [17592186259744 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259744 1111 #uuid "5268fcad-4ae8-573e-80fe-07a9521ab94c" 13194139533864 true] [17592186259745 1017 #edb/ref 17592186259746 13194139533864 true] [17592186259745 1089 "q-334208" 13194139533864 true] [17592186259745 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259745 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/26e2e4a51d40e9ed8e6a8fab342935e944e750587534c7cedc1855cbfddfbfc5.png)\n\nIf the figure above shows the graph of $f(x),$ then\n\n${lim}_{x\\to \\infty }\\frac{f(x)}{{x}^{3}+5x-6}=$\n{{field-1}}." 13194139533864 true] [17592186259745 1113 #uuid "521e4421-8c12-5483-a9ad-eb3663c791eb" 13194139533864 true] [17592186259745 1145 "From the diagram, ${lim}_{x\\to \\infty }f(x)=2.$\n\nNow, rewrite the target limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{{x}^{3}+5x-6} & ={lim}_{x\\to \\infty }f(x)\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}\\end{aligned}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${x}^{3}+5x-6$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n{lim}_{x\\to \\infty }f(x)\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{3}+5x-6}=2\\cdot 0=0\n$$" 13194139533864 true] [17592186259746 1000 #edb/ref 17592186259747 13194139533864 true] [17592186259746 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259746 1041 "field-1" 13194139533864 true] [17592186259746 1104 #edb/ref 17592186259747 13194139533864 true] [17592186259746 1110 #uuid "b713fe42-1112-55c0-a3e9-179614c29a7c" 13194139533864 true] [17592186259747 1034 "0" 13194139533864 true] [17592186259747 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259747 1111 #uuid "a6bb6be2-87df-5a90-b8da-3fd783476439" 13194139533864 true] [17592186259748 1017 #edb/ref 17592186259749 13194139533864 true] [17592186259748 1089 "q-334245" 13194139533864 true] [17592186259748 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259748 1100 "Evaluate the following limit:\n\n${lim}_{x\\to (-4)^{-}}\\frac{1}{x+4}=$\n{{field-1}}" 13194139533864 true] [17592186259748 1113 #uuid "4bd36deb-148b-5a1a-b1d2-7ce3ec169a2b" 13194139533864 true] [17592186259748 1145 "We can sketch the graph of $y=\\frac{1}{x+4}$ as follows:\n\n- Take the graph of $y=\\frac{1}{x}.$\n\n- Translate it to the left by $4$ units. This gives $y=\\frac{1}{x+4}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/77080e0c2085e5678929e33f8e0588a3639bfc11b3b629dc63310acbeba6ab57.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to (-4)^{-}}\\frac{1}{x+4}=-\\infty .\n$$" 13194139533864 true] [17592186259749 1000 #edb/ref 17592186259750 13194139533864 true] [17592186259749 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259749 1041 "field-1" 13194139533864 true] [17592186259749 1104 #edb/ref 17592186259750 13194139533864 true] [17592186259749 1110 #uuid "86d91666-8f76-51fe-bd30-9969a887fd2d" 13194139533864 true] [17592186259750 1034 "-\\infty " 13194139533864 true] [17592186259750 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259750 1111 #uuid "2f2a8fcf-b952-5bc9-8904-cca87e7400a2" 13194139533864 true] [17592186259751 1017 #edb/ref 17592186259752 13194139533864 true] [17592186259751 1089 "q-334267" 13194139533864 true] [17592186259751 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259751 1100 "Evaluate the following limit:\n\n${lim}_{x\\to -1}\\frac{1}{(x+1)^{8}}=$\n{{field-1}}" 13194139533864 true] [17592186259751 1113 #uuid "17706661-995f-5eb6-aa6e-cb6de0a1007a" 13194139533864 true] [17592186259751 1145 "We can sketch the graph of $y=\\frac{1}{(x+1)^{8}}$ as follows:\n\n- Take the graph of $y=\\frac{1}{{x}^{8}}.$\n\n- Translate it to the left by $1$ unit. This gives $y=\\frac{1}{(x+1)^{8}},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3231fdde89ea829347de177152ee793203612d5cffd074e0b2738389a2581f17.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to (-1)^{-}}\\frac{1}{(x+1)^{8}}=\\infty ,\\,{lim}_{x\\to (-1)^{+}}\\frac{1}{(x+1)^{8}}=\\infty ,\n$$\n\nand therefore\n\n$$\n{lim}_{x\\to -1}\\frac{1}{(x+1)^{8}}=\\infty .\n$$" 13194139533864 true] [17592186259752 1000 #edb/ref 17592186259753 13194139533864 true] [17592186259752 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259752 1041 "field-1" 13194139533864 true] [17592186259752 1104 #edb/ref 17592186259753 13194139533864 true] [17592186259752 1110 #uuid "5aae44f7-4f87-50b6-95ad-97f979d6701c" 13194139533864 true] [17592186259753 1034 "\\infty " 13194139533864 true] [17592186259753 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259753 1111 #uuid "56e7bcfd-aecd-5b2b-9943-1b6c5632144f" 13194139533864 true] [17592186259754 1017 #edb/ref 17592186259755 13194139533864 true] [17592186259754 1089 "q-334343" 13194139533864 true] [17592186259754 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259754 1100 "Given that $3\\operatorname{sec}\\theta =10\\operatorname{csc}\\theta ,$ calculate $\\operatorname{tan}\\theta .$\n\n$\\operatorname{tan}\\theta =$\n{{field-1}}" 13194139533864 true] [17592186259754 1113 #uuid "930639cf-caf6-5e8d-b822-7d58d5edf090" 13194139533864 true] [17592186259754 1145 "First, we recall the identities $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta }$ and $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ and we substitute them into the given expression:\n\n$$\n\\begin{aligned}3\\operatorname{sec}\\theta  & =10\\operatorname{csc}\\theta  \\\\ 3\\cdot \\frac{1}{\\operatorname{cos}\\theta } & =10\\cdot \\frac{1}{\\operatorname{sin}\\theta } \\\\ \\frac{3}{\\operatorname{cos}\\theta } & =\\frac{10}{\\operatorname{sin}\\theta }\\end{aligned}\n$$\n\nTo write the last equation in terms of $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }$ only, we multiply both sides of the equation by $\\operatorname{sin}\\theta ,$ and apply the above identity, as follows:\n\n$$\n\\begin{aligned}\\frac{3}{\\operatorname{cos}\\theta } & =\\frac{10}{\\operatorname{sin}\\theta } \\\\ \\frac{3}{\\operatorname{cos}\\theta }\\cdot \\operatorname{sin}\\theta  & =\\frac{10}{\\operatorname{sin}\\theta }\\cdot \\operatorname{sin}\\theta  \\\\ \\frac{3\\cdot \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =\\frac{10\\cdot \\operatorname{sin}\\theta }{\\operatorname{sin}\\theta } \\\\ 3\\cdot \\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =10 \\\\ 3\\operatorname{tan}\\theta  & =10\\end{aligned}\n$$\n\nFinally, we isolate $\\operatorname{tan}\\theta $ by dividing both sides of the equation by $3:$\n\n$$\n\\begin{aligned}\\frac{3\\operatorname{tan}\\theta }{3} & =\\frac{10}{3} \\\\ \\operatorname{tan}\\theta  & =\\frac{10}{3}\\end{aligned}\n$$" 13194139533864 true] [17592186259755 1000 #edb/ref 17592186259756 13194139533864 true] [17592186259755 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259755 1041 "field-1" 13194139533864 true] [17592186259755 1104 #edb/ref 17592186259756 13194139533864 true] [17592186259755 1110 #uuid "0c403739-b544-5818-95a2-e4df38d67d03" 13194139533864 true] [17592186259756 1034 "\\frac{10}{3}" 13194139533864 true] [17592186259756 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259756 1111 #uuid "20347862-221b-5860-8592-68978e928244" 13194139533864 true] [17592186259757 1017 #edb/ref 17592186259758 13194139533864 true] [17592186259757 1089 "q-336160" 13194139533864 true] [17592186259757 1091 #edb/ref 17592186045463 13194139533864 true] [17592186259757 1100 "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=-\\sqrt{2}\\operatorname{csc}t,\\,0<t<\\pi .\n$$\n\nCalculate the velocity at time $t=\\frac{\\pi }{4}.$\n\n$v(\\frac{\\pi }{4})=$\n{{field-1}}" 13194139533864 true] [17592186259757 1113 #uuid "9e386cce-90e7-5313-a0f9-874041a6503c" 13194139533864 true] [17592186259757 1145 "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\sqrt{2}\\operatorname{csc}t) \\\\  & =\\sqrt{2}\\operatorname{csc}t\\operatorname{cot}t\\end{aligned}\n$$\n\n \n\nTo calculate the velocity at $t=\\frac{\\pi }{4},$ we substitute $t=\\frac{\\pi }{4}$ into the velocity function above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{4}) & =\\sqrt{2}\\operatorname{csc}(\\frac{\\pi }{4})\\operatorname{cot}(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1 \\\\  & =2\\end{aligned}\n$$" 13194139533864 true] [17592186259758 1000 #edb/ref 17592186259759 13194139533864 true] [17592186259758 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259758 1041 "field-1" 13194139533864 true] [17592186259758 1104 #edb/ref 17592186259759 13194139533864 true] [17592186259758 1110 #uuid "335c7175-1070-581d-8e1f-409546a66e39" 13194139533864 true] [17592186259759 1034 "2" 13194139533864 true] [17592186259759 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259759 1111 #uuid "4500fac8-af20-5c20-911d-1f32dbb57955" 13194139533864 true] [17592186259760 1017 #edb/ref 17592186259761 13194139533864 true] [17592186259760 1089 "q-336189" 13194139533864 true] [17592186259760 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259760 1100 "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)=6\\operatorname{sin}t-8\\operatorname{cos}t,\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=\\frac{3\\pi }{2}\\,\\text{s}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{m/s}.$" 13194139533864 true] [17592186259760 1113 #uuid "d1f7c427-fd09-51c4-aeca-22ae40dad476" 13194139533864 true] [17592186259760 1145 "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}t-8\\operatorname{cos}t) \\\\  & =6\\operatorname{cos}t+8\\operatorname{sin}t\\end{aligned}\n$$\n\nWhen $t=\\frac{3\\pi }{2},$ the velocity is\n\n$$\n\\begin{aligned}v(\\frac{3\\pi }{2}) & =6\\operatorname{cos}(\\frac{3\\pi }{2})+8\\operatorname{sin}(\\frac{3\\pi }{2}) \\\\  & =6(0)+8(-1) \\\\  & =-8.\\end{aligned}\n$$\n\nTherefore, the speed is $|-8|=8\\,\\text{m/s}.$" 13194139533864 true] [17592186259761 1000 #edb/ref 17592186259762 13194139533864 true] [17592186259761 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259761 1041 "field-1" 13194139533864 true] [17592186259761 1104 #edb/ref 17592186259762 13194139533864 true] [17592186259761 1110 #uuid "d79b4b85-5bf6-5426-8987-1d99cefbf281" 13194139533864 true] [17592186259762 1034 "8" 13194139533864 true] [17592186259762 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259762 1111 #uuid "400aa6d7-ad0b-55c5-9730-4139ca77b867" 13194139533864 true] [17592186259763 1017 #edb/ref 17592186259764 13194139533864 true] [17592186259763 1089 "q-3362" 13194139533864 true] [17592186259763 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259763 1100 "If ${27}^{2n+2}={(\\frac{1}{81})}^{-2n+8},$ then $n=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186259763 1113 #uuid "11121e1d-3771-5b73-8d84-a5287eac4550" 13194139533864 true] [17592186259763 1145 "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $27={3}^{3}$ and $81={3}^{4},$ as follows:\n\n$$\n{({3}^{3})}^{2n+2}={(\\frac{1}{{3}^{4}})}^{-2n+8}\n$$\n\nThen, we apply the power rule and the power of quotient rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{3(2n+2)}=\\frac{1}{{3}^{4(-2n+8)}}\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using a negative exponent:\n\n$$\n\\begin{aligned}{3}^{3(2n+2)}={3}^{-4(-2n+8)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $n:$\n\n$$\n\\begin{aligned}3(2n+2) & =-4(-2n+8) \\\\ 6n+6 & =8n-32 \\\\ 2n & =38 \\\\ n & =19\\end{aligned}\n$$" 13194139533864 true] [17592186259764 1000 #edb/ref 17592186259765 13194139533864 true] [17592186259764 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259764 1041 "answer" 13194139533864 true] [17592186259764 1104 #edb/ref 17592186259765 13194139533864 true] [17592186259764 1110 #uuid "e7b5992c-e506-553c-a960-95b6a05f6a33" 13194139533864 true] [17592186259765 1034 "19" 13194139533864 true] [17592186259765 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259765 1111 #uuid "88946dd7-a497-59d4-9d3a-53ea96edf878" 13194139533864 true] [17592186259766 1017 #edb/ref 17592186259767 13194139533864 true] [17592186259766 1089 "q-336433" 13194139533864 true] [17592186259766 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259766 1100 "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by\n$v(t)=\\frac{t+3}{t+1}.$\nCalculate the velocity of the particle when the acceleration $a$ is equal to $-\\frac{1}{2}\\,{\\text{m/s}}^{2}.$\n\nWhen $a=-\\frac{1}{2}\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" 13194139533864 true] [17592186259766 1113 #uuid "2eb4629d-fc7e-5d92-9fc1-95bd60f68d87" 13194139533864 true] [17592186259766 1145 "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t+3}{t+1}) \\\\  & =\\frac{(1)\\cdot (t+1)-(t+3)\\cdot (1)}{(t+1)^{2}} \\\\  & =\\frac{t+1-t-3}{(t+1)^{2}} \\\\  & =-\\frac{2}{(t+1)^{2}}\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=-\\frac{1}{2},$ we substitute this into the above:\n\n$$\n\\begin{aligned}-\\frac{1}{2} & =-\\frac{2}{(t+1)^{2}} \\\\ \\frac{1}{2} & =\\frac{2}{(t+1)^{2}} \\\\ (t+1)^{2} & =4 \\\\ t+1 & =\\pm 2 \\\\ t & =-3,1\\end{aligned}\n$$\n\nThus, $t=1$ since $t\\ge 0.$\n\nThen, to calculate the velocity at time $t=1,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(1) & =\\frac{1+3}{1+1} \\\\  & =\\frac{4}{2} \\\\  & =2\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=-\\frac{1}{2}\\,{\\text{m/s}}^{2}$ is $v=2\\,\\text{m/s}.$" 13194139533864 true] [17592186259767 1000 #edb/ref 17592186259768 13194139533864 true] [17592186259767 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259767 1041 "field-1" 13194139533864 true] [17592186259767 1104 #edb/ref 17592186259768 13194139533864 true] [17592186259767 1110 #uuid "dbbe1e2b-3bac-52e4-9a4d-e5eeb164f79a" 13194139533864 true] [17592186259768 1034 "2" 13194139533864 true] [17592186259768 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259768 1111 #uuid "45d1a1b1-aaed-55d9-93ee-6e710a836e33" 13194139533864 true] [17592186259769 1017 #edb/ref 17592186259770 13194139533864 true] [17592186259769 1089 "q-336896" 13194139533864 true] [17592186259769 1091 #edb/ref 17592186045463 13194139533864 true] [17592186259769 1100 "${lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2})=${{field-1}}" 13194139533864 true] [17592186259769 1113 #uuid "1c2973b7-9660-53ce-9738-4f12653a5fcb" 13194139533864 true] [17592186259769 1145 "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2}) & ={lim}_{x\\to -\\infty }(\\frac{-5}{2}\\cdot {x}^{9}) \\\\  & =\\frac{-5}{2}\\cdot {lim}_{x\\to -\\infty }{x}^{9}.\\end{aligned}\n$$\n\nThe graph $y={x}^{9}$ is a power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{9}=-\\infty .\n$$\n\nMultiplication by the negative constant $\\frac{-5}{2}$ changes the sign of the limit. So, we have\n\n$$\n\\begin{aligned}\\frac{-5}{2}\\cdot {lim}_{x\\to -\\infty }{x}^{9} & =-{lim}_{x\\to -\\infty }{x}^{9}=\\infty . & \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{-5{x}^{9}}{2})=\\infty .\n$$" 13194139533864 true] [17592186259770 1000 #edb/ref 17592186259771 13194139533864 true] [17592186259770 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259770 1041 "field-1" 13194139533864 true] [17592186259770 1104 #edb/ref 17592186259771 13194139533864 true] [17592186259770 1110 #uuid "4e67a12c-5589-5fb2-9462-3a40855293a7" 13194139533864 true] [17592186259771 1034 "\\infty " 13194139533864 true] [17592186259771 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259771 1111 #uuid "26810715-9796-5c64-9514-da8abe94bd11" 13194139533864 true] [17592186259772 1017 #edb/ref 17592186259773 13194139533864 true] [17592186259772 1089 "q-336903" 13194139533864 true] [17592186259772 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259772 1100 "Evaluate the following limit:\n\n$\\,{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7}=$\n{{field-1}}" 13194139533864 true] [17592186259772 1113 #uuid "e257b16a-a775-5397-9d95-12edd8b09eb7" 13194139533864 true] [17592186259772 1145 "If we plug in $x=-4$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7} & ={lim}_{x\\to -4}\\frac{{[(x+4)^{3}]}^{'}}{{[3(x+5)^{1/3}-x-7]}^{'}} \\\\  & ={lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1} & ={lim}_{x\\to -4}\\frac{{[3(x+4)^{2}]}^{'}}{{[(x+5)^{-2/3}-1]}^{'}} \\\\  & ={lim}_{x\\to -4}\\frac{6(x+4)}{-\\frac{2}{3}(x+5)^{-5/3}} \\\\  & =-9{lim}_{x\\to -4}(x+4)(x+5)^{5/3} \\\\  & =-9(-4+4)\\,(-4+5)^{5/3} \\\\  & =-9\\cdot 0\\cdot 1 \\\\  & =0.\\end{aligned}\n$$" 13194139533864 true] [17592186259773 1000 #edb/ref 17592186259774 13194139533864 true] [17592186259773 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259773 1041 "field-1" 13194139533864 true] [17592186259773 1104 #edb/ref 17592186259774 13194139533864 true] [17592186259773 1110 #uuid "65b65e21-4124-599c-8ef5-38bd7add3afa" 13194139533864 true] [17592186259774 1034 "0" 13194139533864 true] [17592186259774 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259774 1111 #uuid "ee0f398f-597a-5b09-b835-c7b222771d92" 13194139533864 true] [17592186259775 1017 #edb/ref 17592186259776 13194139533864 true] [17592186259775 1089 "q-336927" 13194139533864 true] [17592186259775 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259775 1100 "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5}=$\n{{field-1}}" 13194139533864 true] [17592186259775 1113 #uuid "807afca8-b2c0-59ad-99e9-bb1c9df82ff6" 13194139533864 true] [17592186259775 1145 "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5} & ={lim}_{x\\to 0}\\frac{{[{5}^{x}-1-(\\operatorname{ln}5)x]}^{'}}{[{x}^{2}\\operatorname{ln}5]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\operatorname{ln}5)\\cdot {5}^{x}-(\\operatorname{ln}5)}{2\\operatorname{ln}5\\cdot x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\text{ }\\operatorname{ln}5} & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{[{5}^{x}-1]}^{'}}{[x]^{'}} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{(\\operatorname{ln}5){5}^{x}}{1} \\\\  & =\\frac{1}{2}\\,(\\operatorname{ln}5){e}^{0} \\\\  & =\\frac{\\operatorname{ln}5}{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186259776 1000 #edb/ref 17592186259777 13194139533864 true] [17592186259776 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259776 1041 "field-1" 13194139533864 true] [17592186259776 1104 #edb/ref 17592186259777 13194139533864 true] [17592186259776 1110 #uuid "68586d47-416c-5b02-a214-0b04cc3eb25e" 13194139533864 true] [17592186259777 1034 "\\frac{\\ln5}2" 13194139533864 true] [17592186259777 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259777 1111 #uuid "441ce2f1-8463-59ab-9df1-c1090a81dfa3" 13194139533864 true] [17592186259778 1017 #edb/ref 17592186259779 13194139533864 true] [17592186259778 1089 "q-336955" 13194139533864 true] [17592186259778 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259778 1100 "If $f(x)=3{x}^{9}$ and $g(x)=-2{x}^{-11}$, then\n\n${lim}_{x\\to \\infty }({x}^{2}\\cdot f(x)\\cdot g(x))=$\n{{field-1}}." 13194139533864 true] [17592186259778 1113 #uuid "39ff6f11-126f-5d17-90bb-5fef510de3a4" 13194139533864 true] [17592186259778 1145 "First, let's calculate ${x}^{2}\\cdot f(x):$\n\n$$\n{x}^{2}\\cdot f(x)={x}^{2}\\cdot (3{x}^{9})=3{x}^{11}\n$$\n\nWhen we multiply the two functions ${x}^{2}\\cdot f(x)$ and $g(x)$, we get a constant, and the limit of a constant is just the constant itself:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }({x}^{2}\\cdot f(x)\\cdot g(x)) & ={lim}_{x\\to \\infty }(3{x}^{11}\\cdot (-2{x}^{-11})) \\\\  & ={lim}_{x\\to \\infty }-6 \\\\  & =-6\\end{aligned}\n$$" 13194139533864 true] [17592186259779 1000 #edb/ref 17592186259780 13194139533864 true] [17592186259779 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259779 1041 "field-1" 13194139533864 true] [17592186259779 1104 #edb/ref 17592186259780 13194139533864 true] [17592186259779 1110 #uuid "f90da28f-f2df-5f89-bc5c-259715754e58" 13194139533864 true] [17592186259780 1034 "-6" 13194139533864 true] [17592186259780 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259780 1111 #uuid "eb907c0d-3b8a-5e38-bd9a-bee10c75c1dd" 13194139533864 true] [17592186259781 1017 #edb/ref 17592186259782 13194139533864 true] [17592186259781 1089 "q-337182" 13194139533864 true] [17592186259781 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259781 1100 "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sec}(x)}{5{x}^{3}}($\n{{field-1}}$)$" 13194139533864 true] [17592186259781 1113 #uuid "b58612b7-225f-5023-841c-cc50f36c7d9e" 13194139533864 true] [17592186259781 1145 "We calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}) \\\\  & =\\frac{(3\\operatorname{sec}(x)\\operatorname{tan}(x))(5{x}^{2})-(3\\operatorname{sec}(x))(10x)}{(5{x}^{2})^{2}} \\\\  & =\\frac{15{x}^{2}\\operatorname{sec}(x)\\operatorname{tan}(x)-30x\\operatorname{sec}(x)}{25{x}^{4}} \\\\  & =\\frac{5x\\operatorname{sec}(x)(3x\\operatorname{tan}(x)-6)}{25{x}^{4}} \\\\  & =\\frac{\\operatorname{sec}(x)(3x\\operatorname{tan}(x)-6)}{5{x}^{3}} \\\\  & =\\frac{3\\operatorname{sec}(x)}{5{x}^{3}}(x\\operatorname{tan}(x)-2)\\end{aligned}\n$$" 13194139533864 true] [17592186259782 1000 #edb/ref 17592186259783 13194139533864 true] [17592186259782 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259782 1041 "field-1" 13194139533864 true] [17592186259782 1104 #edb/ref 17592186259783 13194139533864 true] [17592186259782 1110 #uuid "f0acb996-b153-55cf-bbe7-8329594e8e99" 13194139533864 true] [17592186259783 1034 "x\\operatorname{tan}(x)-2" 13194139533864 true] [17592186259783 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259783 1111 #uuid "dc4dd606-3245-5362-863c-9cd43490bd4c" 13194139533864 true] [17592186259784 1017 #edb/ref 17592186259785 13194139533864 true] [17592186259784 1089 "q-337875" 13194139533864 true] [17592186259784 1091 #edb/ref 17592186045465 13194139533864 true] [17592186259784 1100 "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\sqrt{-(x-3)}=$\n{{field-1}}" 13194139533864 true] [17592186259784 1113 #uuid "ff3ed87e-89ed-5503-bbd2-d542dc726a73" 13194139533864 true] [17592186259784 1145 "Let $f(x)=\\sqrt{-(x-3)}.$ Let's sketch the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3fb10f30533c2d1390085223e1ea78ea7d23e723bbea0550d7d236368adcfa82.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$" 13194139533864 true] [17592186259785 1000 #edb/ref 17592186259786 13194139533864 true] [17592186259785 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259785 1041 "field-1" 13194139533864 true] [17592186259785 1104 #edb/ref 17592186259786 13194139533864 true] [17592186259785 1110 #uuid "8b2d9220-d1e0-536d-a6a4-5038fe9720c8" 13194139533864 true] [17592186259786 1034 "\\infty " 13194139533864 true] [17592186259786 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259786 1111 #uuid "6b834336-f44e-5ced-a4b6-82897769dbc8" 13194139533864 true] [17592186259787 1017 #edb/ref 17592186259788 13194139533864 true] [17592186259787 1089 "q-337889" 13194139533864 true] [17592186259787 1091 #edb/ref 17592186045463 13194139533864 true] [17592186259787 1100 "Evaluate the following limit:\n\n${lim}_{x\\to {1}^{+}}(\\sqrt[3]{8(x-1)}+2)=$\n{{field-1}}" 13194139533864 true] [17592186259787 1113 #uuid "eed63dc5-4938-533a-9ddd-3ca6174a3bcf" 13194139533864 true] [17592186259787 1145 "We substitute $x=1$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}(\\sqrt[3]{8(x-1)}+2) & =\\sqrt[3]{8(1-1)}+2 \\\\  & =\\sqrt[3]{0}+2 \\\\  & =2.\\end{aligned}\n$$" 13194139533864 true] [17592186259788 1000 #edb/ref 17592186259789 13194139533864 true] [17592186259788 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259788 1041 "field-1" 13194139533864 true] [17592186259788 1104 #edb/ref 17592186259789 13194139533864 true] [17592186259788 1110 #uuid "2dc19a03-5ebe-5d9b-8e53-685a0cef23f7" 13194139533864 true] [17592186259789 1034 "2" 13194139533864 true] [17592186259789 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259789 1111 #uuid "3d50905c-b55c-5093-a351-7a4a8afb1004" 13194139533864 true] [17592186259790 1017 #edb/ref 17592186259791 13194139533864 true] [17592186259790 1089 "q-337898" 13194139533864 true] [17592186259790 1091 #edb/ref 175