045449 13194139533864 true] [17592186260285 1041 "root-2" 13194139533864 true] [17592186260285 1104 #edb/ref 17592186260286 13194139533864 true] [17592186260285 1110 #uuid "5ad8d745-e329-584d-8a11-ce5b919ce507" 13194139533864 true] [17592186260286 1034 "6" 13194139533864 true] [17592186260286 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260286 1111 #uuid "99449027-c0b9-5dd4-9166-86aaa4b8715c" 13194139533864 true] [17592186260287 1017 #edb/ref 17592186260288 13194139533864 true] [17592186260287 1017 #edb/ref 17592186260290 13194139533864 true] [17592186260287 1017 #edb/ref 17592186260292 13194139533864 true] [17592186260287 1089 "q-3984" 13194139533864 true] [17592186260287 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260287 1100 "Solve for $m$ where $2{m}^{3}-5{m}^{2}-18m=2{m}^{2}+{m}^{3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" 13194139533864 true] [17592186260287 1113 #uuid "423dad75-ec6d-59c5-bce2-1028414952c4" 13194139533864 true] [17592186260287 1145 "First, let's rewrite the polynomial equation in the form ${P}_{n}(m)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}2{m}^{3}-5{m}^{2}-18m & =2{m}^{2}+{m}^{3} \\\\ {m}^{3}-5{m}^{2}-18m & =2{m}^{2} \\\\ {m}^{3}-7{m}^{2}-18m & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $m.$ We can factor out the $m$ as follows:\n\n$$\n\\begin{aligned}{m}^{3}-7{m}^{2}-18m & =0 \\\\ m({m}^{2}-7m-18) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${m}^{2}-7m-18$ as follows:\n\n$$\n\\begin{aligned}m({m}^{2}-7m-18) & =0 \\\\ m(m+2)(m-9) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $m=0,$ $m=-2,$ and $m=9.$" 13194139533864 true] [17592186260288 1000 #edb/ref 17592186260289 13194139533864 true] [17592186260288 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260288 1041 "root-1" 13194139533864 true] [17592186260288 1104 #edb/ref 17592186260289 13194139533864 true] [17592186260288 1110 #uuid "19d0e142-f90c-5c63-b1c3-353684dc6988" 13194139533864 true] [17592186260289 1034 "-2" 13194139533864 true] [17592186260289 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260289 1111 #uuid "3105e6bd-21ef-530e-8e10-b909bcf733ba" 13194139533864 true] [17592186260290 1000 #edb/ref 17592186260291 13194139533864 true] [17592186260290 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260290 1041 "root-2" 13194139533864 true] [17592186260290 1104 #edb/ref 17592186260291 13194139533864 true] [17592186260290 1110 #uuid "3351ea0b-eeff-5f58-becd-56fbf08f3f13" 13194139533864 true] [17592186260291 1034 "0" 13194139533864 true] [17592186260291 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260291 1111 #uuid "d23d4977-ec9c-564b-99ba-5632e8a3c200" 13194139533864 true] [17592186260292 1000 #edb/ref 17592186260293 13194139533864 true] [17592186260292 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260292 1041 "root-3" 13194139533864 true] [17592186260292 1104 #edb/ref 17592186260293 13194139533864 true] [17592186260292 1110 #uuid "003a3369-96ec-559a-9958-0a3c80649b81" 13194139533864 true] [17592186260293 1034 "9" 13194139533864 true] [17592186260293 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260293 1111 #uuid "0700acea-40cc-5401-9f43-345fa1a20bad" 13194139533864 true] [17592186260294 1017 #edb/ref 17592186260295 13194139533864 true] [17592186260294 1089 "q-40003" 13194139533864 true] [17592186260294 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260294 1100 "The first term of a geometric sequence is $-8$ and the common ratio is $4.$ Written in sigma notation, what is the sum of the first $30$ terms?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260294 1113 #uuid "fcaed1ea-a740-59c1-9f0c-86cba46523b0" 13194139533864 true] [17592186260294 1145 "First, we must express the series in the form:\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=-8,$ $r=4$ and $N=30.$\n\nExpressing the geometric series in sigma notation, we obtain:\n\n$$\n{S}_{30}={\\sum }_{n=1}^{30}(-8){4}^{n-1}\\,\\,\n$$\n\nFinally, we can simplify the above using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{30}(-8){4}^{n-1} & ={\\sum }_{n=1}^{30}(-2)\\cdot 4\\cdot {4}^{n-1} \\\\  & ={\\sum }_{n=1}^{30}(-2)\\cdot {4}^{1+n-1} \\\\  & ={\\sum }_{n=1}^{30}(-2){4}^{n}\\end{aligned}\n$$" 13194139533864 true] [17592186260295 1000 #edb/ref 17592186260296 13194139533864 true] [17592186260295 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260295 1041 "answer" 13194139533864 true] [17592186260295 1104 #edb/ref 17592186260296 13194139533864 true] [17592186260295 1110 #uuid "d8f73d13-4eeb-55c8-bb70-ee709dd0dc67" 13194139533864 true] [17592186260296 1034 "{\\sum }_{n=1}^{30}(-2){4}^{n}" 13194139533864 true] [17592186260296 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260296 1111 #uuid "75f74b92-bc0d-519a-88d4-52914aa59956" 13194139533864 true] [17592186260297 1017 #edb/ref 17592186260298 13194139533864 true] [17592186260297 1089 "q-40286" 13194139533864 true] [17592186260297 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260297 1100 "Consider the infinite geometric sequence that has a fifth term equal to $-\\frac{1}{2}$ and an eighth term equal to $-\\frac{1}{16}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260297 1113 #uuid "44cf182f-9628-54ce-8c6a-39e321172edf" 13194139533864 true] [17592186260297 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{5}=-\\frac{1}{2}$ and ${a}_{8}=-\\frac{1}{16}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{8-5} & =\\frac{(-\\frac{1}{16})}{(-\\frac{1}{2})} \\\\ {r}^{3} & =(-\\frac{1}{16})(-2) \\\\ {r}^{3} & =\\frac{1}{8} \\\\ {r}^{3} & ={(\\frac{1}{2})}^{3} \\\\ r & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow, using the formula\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}\n$$\n\nfor the $n$th term of the geometric sequence, we can find the first term. Indeed, for $n=5$ we obtain:\n\n$$\n\\begin{aligned}{a}_{5} & ={a}_{1}{r}^{4} \\\\ -\\frac{1}{2} & ={a}_{1}{(\\frac{1}{2})}^{4} \\\\ -\\frac{1}{2} & ={a}_{1}(\\frac{1}{16}) \\\\ {a}_{1} & =-8\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-8}{(1-\\frac{1}{2})} \\\\  & =-\\frac{8}{(\\frac{1}{2})} \\\\  & =-16.\\end{aligned}\n$$" 13194139533864 true] [17592186260298 1000 #edb/ref 17592186260299 13194139533864 true] [17592186260298 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260298 1041 "answer" 13194139533864 true] [17592186260298 1104 #edb/ref 17592186260299 13194139533864 true] [17592186260298 1110 #uuid "5b0833d4-4144-569c-b006-dceef4d41ca4" 13194139533864 true] [17592186260299 1034 "-16" 13194139533864 true] [17592186260299 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260299 1111 #uuid "db8b76fd-8b6b-55c3-8edc-c3327759fc25" 13194139533864 true] [17592186260300 1017 #edb/ref 17592186260301 13194139533864 true] [17592186260300 1017 #edb/ref 17592186260303 13194139533864 true] [17592186260300 1089 "q-40384" 13194139533864 true] [17592186260300 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260300 1100 "What is the range of $y=-4(3)^{x}+2?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" 13194139533864 true] [17592186260300 1113 #uuid "99cb9382-c994-5be5-9048-a51a60032aa8" 13194139533864 true] [17592186260300 1145 "The range of ${3}^{x}$ is \n\n$$\n{3}^{x}>0.\n$$\n\nMultiplying the above inequality by $-4$ and then adding $2,$ we get the following:\n\n$$\n\\begin{aligned}{3}^{x} & >0 \\\\ -4(3)^{x} & <0 \\\\ -4(3)^{x}+2 & <0+2 \\\\ y & <2\\end{aligned}\n$$\n\nTherefore, the range is $y\\in (-\\infty ,2).$ \n\nWe can also see that this is true from the graph of the function. The graph of $f(x)=-4(3)^{x}+2$ is shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e3e926c26f8174dd5c92a5875e550530304fadcea4c964ab33b35e701f7e5ae5.png)" 13194139533864 true] [17592186260301 1000 #edb/ref 17592186260302 13194139533864 true] [17592186260301 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260301 1041 "coordinate-1" 13194139533864 true] [17592186260301 1104 #edb/ref 17592186260302 13194139533864 true] [17592186260301 1110 #uuid "ab06826b-48c4-5499-b4e8-1c375d3ad4fb" 13194139533864 true] [17592186260302 1034 "-\\infty" 13194139533864 true] [17592186260302 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260302 1111 #uuid "22f9ee78-0a9c-5019-8ab5-4dc0d4377d5d" 13194139533864 true] [17592186260303 1000 #edb/ref 17592186260304 13194139533864 true] [17592186260303 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260303 1041 "coordinate-2" 13194139533864 true] [17592186260303 1104 #edb/ref 17592186260304 13194139533864 true] [17592186260303 1110 #uuid "2c6cd3c1-fc3a-51fa-bddb-1852000b1f5f" 13194139533864 true] [17592186260304 1034 "2" 13194139533864 true] [17592186260304 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260304 1111 #uuid "f422513d-cfb5-58ac-8d90-bfe90ab49b23" 13194139533864 true] [17592186260305 1017 #edb/ref 17592186260306 13194139533864 true] [17592186260305 1017 #edb/ref 17592186260308 13194139533864 true] [17592186260305 1089 "q-40423" 13194139533864 true] [17592186260305 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260305 1100 "What is the range of $y=-2(6)^{x-2}+3?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" 13194139533864 true] [17592186260305 1113 #uuid "9724fde1-fa48-5add-860f-b1dcb5499f93" 13194139533864 true] [17592186260305 1145 "The range of ${6}^{x}$ is  \n\n$$\n{6}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{6}^{x-2}>0.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $3,$ we get the following: \n\n$$\n\\begin{aligned}{6}^{x-2} & >0 \\\\ -2(6)^{x-2} & <0 \\\\ -2(6)^{x-2}+3 & <0+3 \\\\ y & <3\\end{aligned}\n$$\n\nTherefore, the range is $y\\in (-\\infty ,3).$ \n\nWe can also see that this is true from the graph of the function. The graph of $f(x)=-2(6)^{x-2}+3$ is shown below.   \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/cfaa2259cb247b3de4779f4dd490c7fe5bafaff8e90e1d7adfb6e42df9e39061.png)" 13194139533864 true] [17592186260306 1000 #edb/ref 17592186260307 13194139533864 true] [17592186260306 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260306 1041 "coordinate-1" 13194139533864 true] [17592186260306 1104 #edb/ref 17592186260307 13194139533864 true] [17592186260306 1110 #uuid "2bdbf706-5f21-521d-84ef-19669af05fef" 13194139533864 true] [17592186260307 1034 "-\\infty" 13194139533864 true] [17592186260307 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260307 1111 #uuid "c1d7da5a-6089-59d7-9862-471e5f092193" 13194139533864 true] [17592186260308 1000 #edb/ref 17592186260309 13194139533864 true] [17592186260308 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260308 1041 "coordinate-2" 13194139533864 true] [17592186260308 1104 #edb/ref 17592186260309 13194139533864 true] [17592186260308 1110 #uuid "8db27315-993c-5ecf-9d38-fa5bcfc577b8" 13194139533864 true] [17592186260309 1034 "3" 13194139533864 true] [17592186260309 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260309 1111 #uuid "3aba8180-32eb-5753-bfcf-4922343faaf3" 13194139533864 true] [17592186260310 1017 #edb/ref 17592186260311 13194139533864 true] [17592186260310 1089 "q-40557" 13194139533864 true] [17592186260310 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260310 1100 "Which of the following values ​are possible outputs of $f(x)=5{(2)}^{2x+1}-3?$\n\nI. - $-3$\nII. - $0$\nIII. - $3$" 13194139533864 true] [17592186260310 1113 #uuid "9867e83c-9088-5ac6-b716-bd2e12f821e5" 13194139533864 true] [17592186260310 1145 "The range of ${2}^{x}$ is \n\n$$\n{2}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{2}^{2x+1}>0.\n$$\n\nMultiplying the above inequality by $5$ and then subtracting $3,$ we get the following:\n\n$$\n\\begin{aligned}{2}^{2x+1} & >0 \\\\ 5(2)^{2x+1} & >0 \\\\ 5(2)^{2x+1}-3 & >0-3 \\\\ f(x) & >-3\\end{aligned}\n$$\n\nTherefore, the range is $f(x)>-3.$ Thus, of the given values, only $y=0$ and $y=3$ are outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/27d552fe970877167abdcfd528c3dd6f517d9afb7ecf33d1eb00c8e8c2a332d7.png)\n\nSo, the correct answer is \"II and III only.\"" 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260312 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260313 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260314 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260315 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260316 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260317 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260318 13194139533864 true] [17592186260311 1000 #edb/ref 17592186260319 13194139533864 true] [17592186260311 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260311 1041 "selection" 13194139533864 true] [17592186260311 1104 #edb/ref 17592186260313 13194139533864 true] [17592186260311 1110 #uuid "ba7aa15e-4cac-5399-8271-9f448bc7cb70" 13194139533864 true] [17592186260312 1034 "I, II, and III" 13194139533864 true] [17592186260312 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260312 1111 #uuid "ca8a3395-d6bb-562d-a159-c237ef1fe932" 13194139533864 true] [17592186260313 1034 "II and III only" 13194139533864 true] [17592186260313 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260313 1111 #uuid "38f428ec-022d-558f-a672-63e49d96b225" 13194139533864 true] [17592186260314 1034 "I and III only" 13194139533864 true] [17592186260314 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260314 1111 #uuid "8a0c63ab-5faa-55cc-86df-c63845487483" 13194139533864 true] [17592186260315 1034 "I only" 13194139533864 true] [17592186260315 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260315 1111 #uuid "e2d83f43-bead-5884-a214-46a07598b010" 13194139533864 true] [17592186260316 1034 "III only" 13194139533864 true] [17592186260316 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260316 1111 #uuid "834befe2-9790-522c-88e2-21bab3cfb4d3" 13194139533864 true] [17592186260317 1034 "I and II only" 13194139533864 true] [17592186260317 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260317 1111 #uuid "af9b1eb3-e4bf-53ad-9334-b88c0e5eb5e1" 13194139533864 true] [17592186260318 1034 "None of those listed" 13194139533864 true] [17592186260318 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260318 1111 #uuid "e0e7f295-5b59-5aff-9608-0f0092cefe7b" 13194139533864 true] [17592186260319 1034 "II only" 13194139533864 true] [17592186260319 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260319 1111 #uuid "3c32fe32-b4c1-5d28-b744-b61d6df8fb80" 13194139533864 true] [17592186260320 1017 #edb/ref 17592186260321 13194139533864 true] [17592186260320 1089 "q-40655" 13194139533864 true] [17592186260320 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260320 1100 "Find the domain of $f(x)=\\frac{1}{4}{log}_{6}(3x+4)+2.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260320 1113 #uuid "8b2b439e-829e-542e-9779-42c02c781e1f" 13194139533864 true] [17592186260320 1145 "The domain of $y={log}_{6}x$ is\n\n$$\nx>0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $3x+4$ in the above inequality. This gives\n\n$$\n3x+4>0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}3x+4 & >0 \\\\ 3x & >-4 \\\\ x & >-\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (-\\frac{4}{3},\\infty ).$" 13194139533864 true] [17592186260321 1000 #edb/ref 17592186260322 13194139533864 true] [17592186260321 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260321 1041 "answer" 13194139533864 true] [17592186260321 1104 #edb/ref 17592186260322 13194139533864 true] [17592186260321 1110 #uuid "40af7831-55ef-5dab-bf22-2e5ffd000178" 13194139533864 true] [17592186260322 1034 "x\\in (-\\frac{4}{3},\\infty )" 13194139533864 true] [17592186260322 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260322 1111 #uuid "89bee2d0-c0ab-5081-9920-1e0e5c9d2c73" 13194139533864 true] [17592186260323 1017 #edb/ref 17592186260324 13194139533864 true] [17592186260323 1089 "q-40691" 13194139533864 true] [17592186260323 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260323 1100 "$2.3\\overset{―}{43}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260323 1113 #uuid "beb2fadf-9974-5f6b-99c2-f5a2d68db56e" 13194139533864 true] [17592186260323 1145 "The given repeating decimal can be written as\n\n$$\n\\begin{aligned}2.3\\overset{―}{43} & =2.343\\,43... \\\\  & =2.3+0.043+0.000\\,43+0.000\\,004\\,3+… \\\\  & =2.3+{{\\frac{43}{1\\,000}+\\frac{43}{100\\,000}+\\frac{43}{10\\,000\\,000}+⋯.}_{⏟}}_{\\text{geometric series}}\\end{aligned}\n$$\n\nWe see that we have a geometric series where the first term is ${a}_{1}=\\frac{43}{1\\,000}$ and the common ratio is $\\frac{1}{100}.$ Therefore,\n\n$$\n\\begin{aligned}2.3\\overset{―}{43} & =2.3+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{1\\,000}{(\\frac{1}{100})}^{n-1} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43\\cdot 100}{1\\,000}{(\\frac{1}{100})}^{n} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{10}{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$" 13194139533864 true] [17592186260324 1000 #edb/ref 17592186260325 13194139533864 true] [17592186260324 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260324 1041 "answer" 13194139533864 true] [17592186260324 1104 #edb/ref 17592186260325 13194139533864 true] [17592186260324 1110 #uuid "872fc268-37e6-5ec2-8a77-98dbdaae9dc6" 13194139533864 true] [17592186260325 1034 "2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{10}{(\\frac{1}{100})}^{n}" 13194139533864 true] [17592186260325 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260325 1111 #uuid "30e05239-8c87-5ec0-8fe0-4e5e7f8ce9b3" 13194139533864 true] [17592186260326 1017 #edb/ref 17592186260327 13194139533864 true] [17592186260326 1089 "q-40796" 13194139533864 true] [17592186260326 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260326 1100 "Which of the following values ​are possible outputs of  $f(x)=-3(3)^{2-x}-1?$\n\nI. - $-2$\nII. - $1$\nIII. - $2$" 13194139533864 true] [17592186260326 1113 #uuid "4e0d2420-7cc7-5265-8dd5-8dd2efd21696" 13194139533864 true] [17592186260326 1145 "The range of ${3}^{x}$ is \n\n$$\n{3}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{3}^{2-x}>0.\n$$\n\nMultiplying the above inequality by $-3$ and then subtracting $1,$ we get the following: \n\n$$\n\\begin{aligned}{3}^{2-x}>0 \\\\ -3(3)^{2-x} & <0 \\\\ -3(3)^{2-x}-1 & <0-1 \\\\ f(x) & <-1\\end{aligned}\n$$\n\nTherefore, the range is $f(x)<-1.$ Thus, of the given values, only $y=-2$ is an   output of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a40084132e9a34f28b151ed65812410ebef888e33b5394a5e3960996aff515ac.png)\n\nSo, the correct answer is \"I only.\"" 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260328 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260329 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260330 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260331 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260332 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260333 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260334 13194139533864 true] [17592186260327 1000 #edb/ref 17592186260335 13194139533864 true] [17592186260327 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260327 1041 "selection" 13194139533864 true] [17592186260327 1104 #edb/ref 17592186260331 13194139533864 true] [17592186260327 1110 #uuid "11e2a69c-fd58-538b-bd4f-6db8d91ddad1" 13194139533864 true] [17592186260328 1034 "I, II, and III" 13194139533864 true] [17592186260328 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260328 1111 #uuid "3878df5a-fd9e-5894-b398-627dc8f169f3" 13194139533864 true] [17592186260329 1034 "II and III only" 13194139533864 true] [17592186260329 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260329 1111 #uuid "52b5bb8e-e56f-5632-908f-fae9f97d87ff" 13194139533864 true] [17592186260330 1034 "I and III only" 13194139533864 true] [17592186260330 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260330 1111 #uuid "7ce0f1aa-ca34-51ba-842b-15b2eaccd753" 13194139533864 true] [17592186260331 1034 "I only" 13194139533864 true] [17592186260331 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260331 1111 #uuid "e6157271-94a5-5f2d-aac5-c32cd9a60416" 13194139533864 true] [17592186260332 1034 "III only" 13194139533864 true] [17592186260332 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260332 1111 #uuid "c838cc0d-4303-5766-864d-aa1c4dc04040" 13194139533864 true] [17592186260333 1034 "I and II only" 13194139533864 true] [17592186260333 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260333 1111 #uuid "c552b19c-d3db-5d6c-9e64-40f372a6bd5a" 13194139533864 true] [17592186260334 1034 "None of those listed" 13194139533864 true] [17592186260334 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260334 1111 #uuid "c6aa2a47-ee9b-580c-bb16-ac8bc99d9108" 13194139533864 true] [17592186260335 1034 "II only" 13194139533864 true] [17592186260335 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260335 1111 #uuid "5e47c367-ce18-5083-a725-7bab0581569d" 13194139533864 true] [17592186260336 1017 #edb/ref 17592186260337 13194139533864 true] [17592186260336 1089 "q-40908" 13194139533864 true] [17592186260336 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260336 1100 "What is the range of the function $f(x)=4\\operatorname{sin}(x+{30}^{∘})-2?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260336 1113 #uuid "ce5ab7c9-d2d2-5d7e-a6a4-6ae8f85980c9" 13194139533864 true] [17592186260336 1145 "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $4$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1 \\\\  & -4\\le 4\\operatorname{sin}(x+{30}^{∘})\\le 4 \\\\  & -6\\le 4\\operatorname{sin}(x+{30}^{∘})-2\\le 2 \\\\  & -6\\le f(x)\\le 2.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-6,2].$" 13194139533864 true] [17592186260337 1000 #edb/ref 17592186260338 13194139533864 true] [17592186260337 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260337 1041 "answer" 13194139533864 true] [17592186260337 1104 #edb/ref 17592186260338 13194139533864 true] [17592186260337 1110 #uuid "122f7366-c70e-580b-9d66-1edc13dadd89" 13194139533864 true] [17592186260338 1034 "f(x)\\in [-6,2]" 13194139533864 true] [17592186260338 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260338 1111 #uuid "85c7964b-161a-5618-add4-7737a9851537" 13194139533864 true] [17592186260339 1017 #edb/ref 17592186260340 13194139533864 true] [17592186260339 1089 "q-4115" 13194139533864 true] [17592186260339 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260339 1100 "Find the domain of the function $f(x)=\\operatorname{log}(\\frac{x}{2}-1)-4.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260339 1113 #uuid "3f0af432-165a-5fe2-b10e-a843efae2448" 13194139533864 true] [17592186260339 1145 "The domain of $y=\\operatorname{log}x$ is\n\n$$\nx>0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $\\frac{x}{2}-1$ in the above inequality. This gives\n\n$$\n\\frac{x}{2}-1>0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}\\frac{x}{2}-1 & >0 \\\\ \\frac{x}{2} & >1 \\\\ x & >2.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (2,\\infty ).$" 13194139533864 true] [17592186260340 1000 #edb/ref 17592186260341 13194139533864 true] [17592186260340 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260340 1041 "answer" 13194139533864 true] [17592186260340 1104 #edb/ref 17592186260341 13194139533864 true] [17592186260340 1110 #uuid "6141a2d6-d8ab-5480-8496-7bd6259083f2" 13194139533864 true] [17592186260341 1034 "x\\in (2,\\infty )" 13194139533864 true] [17592186260341 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260341 1111 #uuid "90ef2e75-7179-54c7-ad60-d6c0b7aceeda" 13194139533864 true] [17592186260342 1017 #edb/ref 17592186260343 13194139533864 true] [17592186260342 1089 "q-41245" 13194139533864 true] [17592186260342 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260342 1100 "Find the minimum value of $f(x)=2\\operatorname{ln}(x-2)+3.$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No minimum value\"." 13194139533864 true] [17592186260342 1113 #uuid "8e61eb09-74d3-5874-8485-4b4618415641" 13194139533864 true] [17592186260342 1145 "The range of the function $y=\\operatorname{ln}x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no minimum value." 13194139533864 true] [17592186260343 1000 #edb/ref 17592186260344 13194139533864 true] [17592186260343 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260343 1041 "answer" 13194139533864 true] [17592186260343 1104 #edb/ref 17592186260344 13194139533864 true] [17592186260343 1110 #uuid "97335ce5-3863-514c-8bff-f00a02924bb0" 13194139533864 true] [17592186260344 1034 "No minimum value" 13194139533864 true] [17592186260344 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260344 1111 #uuid "1df260bd-367c-5988-822e-ba2c92b3ea18" 13194139533864 true] [17592186260345 1017 #edb/ref 17592186260346 13194139533864 true] [17592186260345 1089 "q-41246" 13194139533864 true] [17592186260345 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260345 1100 "Find the maximum value of $f(x)=\\frac{1}{2}\\operatorname{ln}(\\frac{x}{2}+1)-1.$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No maximum value\"." 13194139533864 true] [17592186260345 1113 #uuid "e7e52902-fed7-58d4-bb0e-42f5b74398ed" 13194139533864 true] [17592186260345 1145 "The range of the function $y=\\operatorname{ln}x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no maximum value." 13194139533864 true] [17592186260346 1000 #edb/ref 17592186260347 13194139533864 true] [17592186260346 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260346 1041 "answer" 13194139533864 true] [17592186260346 1104 #edb/ref 17592186260347 13194139533864 true] [17592186260346 1110 #uuid "b147741f-ed90-57c9-8ffb-d0d72e684bcd" 13194139533864 true] [17592186260347 1034 "No maximum value" 13194139533864 true] [17592186260347 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260347 1111 #uuid "a55e754a-d7fb-5292-89ba-7ca6df0dc0c1" 13194139533864 true] [17592186260348 1017 #edb/ref 17592186260349 13194139533864 true] [17592186260348 1089 "q-41478" 13194139533864 true] [17592186260348 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260348 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/34ba4a4dcd6655d68fbc20fb6192354ae755cc7eaf14a2459e9b7012ffe6d9ea.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(62)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260348 1113 #uuid "894785c9-b37d-573f-b85e-093f2abc4eb1" 13194139533864 true] [17592186260348 1145 "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep subtracting $4$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(62) & =f(62-4) \\\\  & =f(62-2\\cdot 4) \\\\  & =⋯ \\\\  & =f(62-15\\cdot 4) \\\\  & =f(2) \\\\  & =0\\end{aligned}\n$$" 13194139533864 true] [17592186260349 1000 #edb/ref 17592186260350 13194139533864 true] [17592186260349 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260349 1041 "answer" 13194139533864 true] [17592186260349 1104 #edb/ref 17592186260350 13194139533864 true] [17592186260349 1110 #uuid "1891fb5a-ae3c-53e5-bcfb-2e2ebdc3a191" 13194139533864 true] [17592186260350 1034 "0" 13194139533864 true] [17592186260350 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260350 1111 #uuid "7475235a-62e7-5fae-98a6-1664adf39916" 13194139533864 true] [17592186260351 1017 #edb/ref 17592186260352 13194139533864 true] [17592186260351 1089 "q-41571" 13194139533864 true] [17592186260351 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260351 1100 "If $\\frac{p-2}{p+2}+X=\\frac{2p}{3p+6},$ then what is $X?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260351 1113 #uuid "e2619fe6-700e-5cff-9a2b-9c3c893461a4" 13194139533864 true] [17592186260351 1145 "Since $\\frac{p-2}{p+2}+X=\\frac{2p}{3p+6},$ we have\n\n$$\n\\begin{aligned}X & =\\frac{2p}{3p+6}-\\frac{p-2}{p+2} \\\\  & =\\frac{2p}{3(p+2)}-\\frac{p-2}{p+2}.\\end{aligned}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $3(p+2)$ if we multiply the top and bottom of the second fraction by $3:$\n\n$$\n\\begin{aligned}X & =\\frac{2p}{3(p+2)}-\\frac{p-2}{p+2} \\\\  & =\\frac{2p}{3(p+2)}-\\frac{3}{3}\\cdot \\frac{p-2}{p+2} \\\\  & =\\frac{2p}{3(p+2)}-\\frac{3(p-2)}{3(p+2)} \\\\  & =\\frac{2p-3(p-2)}{3(p+2)} \\\\  & =\\frac{2p-3p+6}{3(p+2)} \\\\  & =\\frac{-p+6}{3(p+2)}\\end{aligned}\n$$\n\nTherefore $X=\\frac{-p+6}{3(p+2)}.$" 13194139533864 true] [17592186260352 1000 #edb/ref 17592186260353 13194139533864 true] [17592186260352 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260352 1041 "answer" 13194139533864 true] [17592186260352 1104 #edb/ref 17592186260353 13194139533864 true] [17592186260352 1110 #uuid "5530c730-e55a-56ca-822d-c39163e22c21" 13194139533864 true] [17592186260353 1034 "\\frac{-p+6}{3(p+2)}" 13194139533864 true] [17592186260353 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260353 1111 #uuid "3d9babea-ba75-5bf8-8a77-36ca409c93a7" 13194139533864 true] [17592186260354 1017 #edb/ref 17592186260355 13194139533864 true] [17592186260354 1017 #edb/ref 17592186260357 13194139533864 true] [17592186260354 1089 "q-41786" 13194139533864 true] [17592186260354 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260354 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/0836e8682e78ae6a53d9b5cf05bce78dd665765aca42504eb8774c6116f42520.png)\n\nThe polar curve $r=14$ and the ray $\\theta =\\frac{5\\pi }{3}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" 13194139533864 true] [17592186260354 1113 #uuid "dce89418-8ba6-5cb9-88b6-4ca10b594bb9" 13194139533864 true] [17592186260354 1145 "The polar coordinates of $P$ are $(r,\\theta )=(14,\\frac{5\\pi }{3}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}\\theta  \\\\  & =14\\operatorname{cos}(\\frac{5\\pi }{3}) \\\\  & =14\\cdot (\\frac{1}{2}) \\\\  & =7 \\\\ y & =r\\operatorname{sin}\\theta  \\\\  & =14\\operatorname{sin}(\\frac{5\\pi }{3}) \\\\  & =14\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-7\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(7,-7\\sqrt{3}).$" 13194139533864 true] [17592186260355 1000 #edb/ref 17592186260356 13194139533864 true] [17592186260355 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260355 1041 "coordinate-1" 13194139533864 true] [17592186260355 1104 #edb/ref 17592186260356 13194139533864 true] [17592186260355 1110 #uuid "ce685e4d-5028-5675-9495-8fe814cdaccf" 13194139533864 true] [17592186260356 1034 "7" 13194139533864 true] [17592186260356 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260356 1111 #uuid "33a7e1c8-f68c-596e-ab9f-344494cd75e2" 13194139533864 true] [17592186260357 1000 #edb/ref 17592186260358 13194139533864 true] [17592186260357 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260357 1041 "coordinate-2" 13194139533864 true] [17592186260357 1104 #edb/ref 17592186260358 13194139533864 true] [17592186260357 1110 #uuid "20d1131b-bf5a-5a6b-b61f-4518eba9dcbc" 13194139533864 true] [17592186260358 1034 "-7\\sqrt{3}" 13194139533864 true] [17592186260358 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260358 1111 #uuid "4fa1f869-f59f-572c-a553-4f29411d5321" 13194139533864 true] [17592186260359 1017 #edb/ref 17592186260360 13194139533864 true] [17592186260359 1089 "q-41911" 13194139533864 true] [17592186260359 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260359 1100 "Two balls are drawn from a bag that contains two red balls and two black balls. Define $A$ to be the event \"no black balls are selected.\" It is known that $P(A)=0.25.$ What is the probability of selecting at least one black ball?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260359 1113 #uuid "4ceee2f4-61b4-5f77-aefc-d5befcee1142" 13194139533864 true] [17592186260359 1145 "The event \"at least one black ball is selected\" is the opposite of the event \"no black balls are selected.\"\n\nSo, the event \"at least one black ball is selected\" is the complement of $A,$ denoted ${A}^{'}.$\n\nSince we know that $P(A)=0.25$ to $2$ decimal places, we can calculate $P({A}^{'})$ using the formula\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ P({A}^{'}) & =1-P(A) \\\\  & =1-0.25 \\\\  & =0.75.\\end{aligned}\n$$" 13194139533864 true] [17592186260360 1000 #edb/ref 17592186260361 13194139533864 true] [17592186260360 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260360 1041 "answer" 13194139533864 true] [17592186260360 1104 #edb/ref 17592186260361 13194139533864 true] [17592186260360 1110 #uuid "99a1e029-57c9-5535-a5a5-9b4e8d91d4df" 13194139533864 true] [17592186260361 1034 "0.75" 13194139533864 true] [17592186260361 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260361 1111 #uuid "720e1293-6223-51a2-8ae6-b8a8efbd2fe0" 13194139533864 true] [17592186260362 1017 #edb/ref 17592186260363 13194139533864 true] [17592186260362 1089 "q-42070" 13194139533864 true] [17592186260362 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260362 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4decd7da6d460540762f6cb2c32fcd36bc7f3c9e24fb62af9244afe0c29dbba4.png)\n\nConsider the sample space $S$ with the Venn diagram given above. What is $P(A)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260362 1113 #uuid "60abed17-1948-5b76-9695-4adb8b2b042e" 13194139533864 true] [17592186260362 1145 "From the given Venn diagram, we have $P(A)=y$ and $P({A}^{'})=\\frac{y}{5}.$\nTherefore\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ y+\\frac{y}{5} & =1 \\\\ \\frac{6y}{5} & =1 \\\\ y & =\\frac{5}{6}.\\end{aligned}\n$$\n\nConsequently,  $P(A)=y=\\frac{5}{6}.$" 13194139533864 true] [17592186260363 1000 #edb/ref 17592186260364 13194139533864 true] [17592186260363 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260363 1041 "answer" 13194139533864 true] [17592186260363 1104 #edb/ref 17592186260364 13194139533864 true] [17592186260363 1110 #uuid "d1e24f39-9ec8-541f-9dc3-1a38b67d0f37" 13194139533864 true] [17592186260364 1034 "\\frac{5}{6}" 13194139533864 true] [17592186260364 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260364 1111 #uuid "924ec03f-ea5a-5596-8164-807f45e54f59" 13194139533864 true] [17592186260365 1017 #edb/ref 17592186260366 13194139533864 true] [17592186260365 1089 "q-42443" 13194139533864 true] [17592186260365 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260365 1100 "What values is **not** in the range of $y=\\operatorname{arctan}x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260365 1113 #uuid "cf2dc9f7-7d68-5872-92d4-9358e4fec6ef" 13194139533864 true] [17592186260365 1145 "Let's recall the graph of $y=\\operatorname{arctan}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The range of the function is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nTherefore, the value $y=\\frac{3\\pi }{2}$ is not in the range of the function." 13194139533864 true] [17592186260366 1000 #edb/ref 17592186260367 13194139533864 true] [17592186260366 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260366 1041 "answer" 13194139533864 true] [17592186260366 1104 #edb/ref 17592186260367 13194139533864 true] [17592186260366 1110 #uuid "4c2e0bdf-a200-5fea-b8ad-369ad5565583" 13194139533864 true] [17592186260367 1034 "\\frac{3\\pi }{2}" 13194139533864 true] [17592186260367 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260367 1111 #uuid "42a737a0-59c0-52bf-a093-926a6c3eed4b" 13194139533864 true] [17592186260368 1017 #edb/ref 17592186260369 13194139533864 true] [17592186260368 1089 "q-42787" 13194139533864 true] [17592186260368 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260368 1100 "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}(\\frac{x}{2}+\\frac{\\pi }{6})=-\\sqrt{2}\n$$\n\nThe general solution of this equation is\n\n$$\nx=\\frac{7\\pi }{6}+4\\pi n,\\,x=a+4\\pi n,\n$$\n\nwhere $n$ is any integer. What could be the value of $a?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260368 1113 #uuid "a9bd9256-8a79-56fe-a09d-da67096b964f" 13194139533864 true] [17592186260368 1145 "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}(\\frac{x}{2}+\\frac{\\pi }{6})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n\\frac{x}{2}+\\frac{\\pi }{6}=\\frac{3\\pi }{4}+2\\pi n,\\,\\frac{x}{2}+\\frac{\\pi }{6}=\\frac{5\\pi }{4}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{2}=-\\frac{\\pi }{6}+\\frac{3\\pi }{4}+2\\pi n, & \\,\\frac{x}{2}=-\\frac{\\pi }{6}+\\frac{5\\pi }{4}+2\\pi n \\\\ \\frac{x}{2}=\\frac{7\\pi }{12}+2\\pi n, & \\,\\frac{x}{2}=\\frac{13\\pi }{12}+2\\pi n \\\\ x=\\frac{7\\pi }{6}+4\\pi n, & \\,x=\\frac{13\\pi }{6}+4\\pi n.\\end{aligned}\n$$\n\nSo, we have that $a=\\frac{13\\pi }{6}.$" 13194139533864 true] [17592186260369 1000 #edb/ref 17592186260370 13194139533864 true] [17592186260369 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260369 1041 "answer" 13194139533864 true] [17592186260369 1104 #edb/ref 17592186260370 13194139533864 true] [17592186260369 1110 #uuid "b3765f5b-c9c9-5376-a3ec-d8b9ae47c1cc" 13194139533864 true] [17592186260370 1034 "\\frac{13\\pi }{6}" 13194139533864 true] [17592186260370 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260370 1111 #uuid "50cb11be-3ef2-5464-9a38-6834624b5c2a" 13194139533864 true] [17592186260371 1017 #edb/ref 17592186260372 13194139533864 true] [17592186260371 1089 "q-43381" 13194139533864 true] [17592186260371 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260371 1100 "Find the exact value of $\\operatorname{cos}{165}^{∘}.$\n\n*Hint: Use the fact that ${165}^{∘}={120}^{∘}+{45}^{∘}.$*\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260371 1113 #uuid "1c73da58-2595-51a8-a8de-bdfae4bbae89" 13194139533864 true] [17592186260371 1145 "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x+y)=\\operatorname{cos}x\\operatorname{cos}y-\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x={120}^{∘}$ and $y={45}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}({165}^{∘}) & =\\operatorname{cos}({120}^{∘}+{45}^{∘}) \\\\  & =\\operatorname{cos}{120}^{∘}\\operatorname{cos}{45}^{∘}-\\operatorname{sin}{120}^{∘}\\operatorname{sin}{45}^{∘} \\\\  & =-\\frac{1}{2}\\cdot (\\frac{\\sqrt{2}}{2})-\\frac{\\sqrt{3}}{2}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$" 13194139533864 true] [17592186260372 1000 #edb/ref 17592186260373 13194139533864 true] [17592186260372 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260372 1041 "answer" 13194139533864 true] [17592186260372 1104 #edb/ref 17592186260373 13194139533864 true] [17592186260372 1110 #uuid "1d45fed3-648d-5387-b42d-eb8574d012d9" 13194139533864 true] [17592186260373 1034 "-\\frac{\\sqrt{6}+\\sqrt{2}}{4}" 13194139533864 true] [17592186260373 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260373 1111 #uuid "a96557a2-bb28-53a3-b5cd-b8bb2a476c30" 13194139533864 true] [17592186260374 1017 #edb/ref 17592186260375 13194139533864 true] [17592186260374 1089 "q-43384" 13194139533864 true] [17592186260374 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260374 1100 "$\\operatorname{cos}(x-\\frac{2\\pi }{3})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260374 1113 #uuid "3e55af46-7aa0-5eeb-8a65-43726ccf1418" 13194139533864 true] [17592186260374 1145 "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}(u-v)=\\operatorname{cos}u\\operatorname{cos}v+\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x-\\frac{2\\pi }{3}) & =\\operatorname{cos}x\\operatorname{cos}(\\frac{2\\pi }{3})+\\operatorname{sin}x\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}x\\cdot (-\\frac{1}{2})+\\operatorname{sin}x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}x-\\operatorname{cos}x).\\end{aligned}\n$$" 13194139533864 true] [17592186260375 1000 #edb/ref 17592186260376 13194139533864 true] [17592186260375 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260375 1041 "answer" 13194139533864 true] [17592186260375 1104 #edb/ref 17592186260376 13194139533864 true] [17592186260375 1110 #uuid "2e159b75-b237-56c5-b8c2-1fa3a976cc03" 13194139533864 true] [17592186260376 1034 "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}x-\\operatorname{cos}x)" 13194139533864 true] [17592186260376 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260376 1111 #uuid "96b8b029-c8c4-5881-a673-713bfc764f6e" 13194139533864 true] [17592186260377 1017 #edb/ref 17592186260378 13194139533864 true] [17592186260377 1089 "q-43462" 13194139533864 true] [17592186260377 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260377 1100 "Express $6\\operatorname{sin}(\\frac{3\\pi }{10})\\operatorname{cos}(\\frac{3\\pi }{10})$ as a single trigonometric ratio.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260377 1113 #uuid "5b13a054-dc23-5be0-bdef-7ff3c961a76d" 13194139533864 true] [17592186260377 1145 "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}x\\operatorname{cos}x=\\operatorname{sin}2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{10}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}(\\frac{3\\pi }{10})\\operatorname{cos}(\\frac{3\\pi }{10}) & =\\operatorname{sin}(2\\cdot \\frac{3\\pi }{10})=\\operatorname{sin}(\\frac{3\\pi }{5}).\\end{aligned}\n$$\n\nTherefore, \n\n$$\n6\\operatorname{sin}(\\frac{3\\pi }{10})\\operatorname{cos}(\\frac{3\\pi }{10})=3\\cdot 2\\operatorname{sin}(\\frac{3\\pi }{10})\\operatorname{cos}(\\frac{3\\pi }{10})=3\\operatorname{sin}(\\frac{3\\pi }{5}).\n$$" 13194139533864 true] [17592186260378 1000 #edb/ref 17592186260379 13194139533864 true] [17592186260378 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260378 1041 "answer" 13194139533864 true] [17592186260378 1104 #edb/ref 17592186260379 13194139533864 true] [17592186260378 1110 #uuid "8000b167-01ef-591c-8cee-ea82edff7347" 13194139533864 true] [17592186260379 1034 "3\\operatorname{sin}(\\frac{3\\pi }{5})" 13194139533864 true] [17592186260379 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260379 1111 #uuid "39ce3618-ce33-5fc6-809b-e21af8ad4860" 13194139533864 true] [17592186260380 1017 #edb/ref 17592186260381 13194139533864 true] [17592186260380 1089 "q-43575" 13194139533864 true] [17592186260380 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260380 1100 "Find the lowest common denominator of $\\frac{5}{20}$ and $\\frac{7}{45}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260380 1113 #uuid "6e1e45df-f294-5f60-b25f-93cd2088d874" 13194139533864 true] [17592186260380 1145 "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators.\n\n- We start by finding the prime factorization of $20:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7e03a139fc3afa7df4d7f32ecf42f8f30d19bfe0415725f47fe5be63301899b5.png)\n\nTherefore, $20={2}^{2}\\cdot 5.$\n\n- Next, we find the prime factorization of $45:$\n\nTherefore, $45={3}^{2}\\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}20 & ={2}^{2}\\cdot 5 \\\\ 45 & ={3}^{2}\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $2$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common denominator is ${2}^{2}\\cdot {3}^{2}\\cdot 5=180.$" 13194139533864 true] [17592186260381 1000 #edb/ref 17592186260382 13194139533864 true] [17592186260381 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260381 1041 "answer" 13194139533864 true] [17592186260381 1104 #edb/ref 17592186260382 13194139533864 true] [17592186260381 1110 #uuid "fc205521-7e24-5da7-8bbf-7fe31687c713" 13194139533864 true] [17592186260382 1034 "180" 13194139533864 true] [17592186260382 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260382 1111 #uuid "0c95150a-d601-580f-9756-c6f7a64b7c07" 13194139533864 true] [17592186260383 1017 #edb/ref 17592186260384 13194139533864 true] [17592186260383 1089 "q-43632" 13194139533864 true] [17592186260383 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260383 1100 "What is the prime decomposition of  $126?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260383 1113 #uuid "975f0bb3-e993-5f9b-a3ec-3b810e3cbf9a" 13194139533864 true] [17592186260383 1145 "To find the prime factorization of a number, we can use a factor tree.\n\nFirst, we need to express $126$ as the product of its *smallest* prime factor and *another* factor. \n\nThe *smallest* prime factor of $126$ is $2,$ and $126=2\\cdot 63.$ We write these factors below $126$ on our tree with the smallest prime factor on the left-hand side.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b4f520ebadd00c650f5172e14943f67e67bc63f8e38a1ecd3fe86a7e7ab74ad4.png)\n\nWe draw a circle around $2$ because it's prime. \n\nNext, we need to express $63$ as the product of its *smallest* prime factor and *another* factor. \n\nThe *smallest* prime factor of $63$ is $3,$ and $63=3\\cdot 21.$ We write these factors below $63$ on our tree with the smallest prime factor on the left-hand side.\n\nWe carry on like this, stopping only when all of the endpoints are prime. By doing this, we get the following: \n\nSo finally, our prime factorization is\n\n$$\n126=2\\cdot 3\\cdot 3\\cdot 7=2\\cdot {3}^{2}\\cdot 7.\n$$" 13194139533864 true] [17592186260384 1000 #edb/ref 17592186260385 13194139533864 true] [17592186260384 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260384 1041 "answer" 13194139533864 true] [17592186260384 1104 #edb/ref 17592186260385 13194139533864 true] [17592186260384 1110 #uuid "b83c8ac8-1b0a-5849-87e0-b94e6262669e" 13194139533864 true] [17592186260385 1034 "2\\cdot {3}^{2}\\cdot 7" 13194139533864 true] [17592186260385 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260385 1111 #uuid "8584c7f4-aee0-51c5-8848-9809d4b3fba5" 13194139533864 true] [17592186260386 1017 #edb/ref 17592186260387 13194139533864 true] [17592186260386 1089 "q-43634" 13194139533864 true] [17592186260386 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260386 1100 "What is the prime decomposition of $315?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260386 1113 #uuid "6e736a28-8e89-585c-8f2b-ce912c35bf20" 13194139533864 true] [17592186260386 1145 "To find the prime factorization of a number, we can use a factor tree.\n\nFirst, we need to express $315$ as the product of its *smallest* prime factor and *another* factor. \n\nThe *smallest* prime factor of $315$ is $3,$ and $315=3\\cdot 105.$ We write these factors below $315$ on our tree with the smallest prime factor on the left-hand side.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/35f5150e72285c0c706af351aa9827bf7010e22fa0dd49a07569466006c2bff1.png)\n\nWe draw a circle around $3$ because it's prime. \n\nNext, we need to express $105$ as the product of its *smallest* prime factor and *another* factor. \n\nThe *smallest* prime factor of $105$ is $3,$ and $105=3\\cdot 35.$ We write these factors below $105$ on our tree with the smallest prime factor on the left-hand side.\n\nWe carry on like this, stopping only when all of the endpoints are prime. By doing this, we get the following:\n\nSo finally, our prime factorization is \n\n$$\n315=3\\cdot 3\\cdot 5\\cdot 7={3}^{2}\\cdot 5\\cdot 7.\n$$" 13194139533864 true] [17592186260387 1000 #edb/ref 17592186260388 13194139533864 true] [17592186260387 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260387 1041 "answer" 13194139533864 true] [17592186260387 1104 #edb/ref 17592186260388 13194139533864 true] [17592186260387 1110 #uuid "97b3c1fb-965d-5446-b945-9970eb8d409a" 13194139533864 true] [17592186260388 1034 "{3}^{2}\\cdot 5\\cdot 7" 13194139533864 true] [17592186260388 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260388 1111 #uuid "21381e4c-dbdb-5dbf-9740-7260353e0ab7" 13194139533864 true] [17592186260389 1017 #edb/ref 17592186260390 13194139533864 true] [17592186260389 1089 "q-44045" 13194139533864 true] [17592186260389 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260389 1100 "Write the quadratic equation $(2x-1)(x-1)=-2{x}^{2}$ in standard form.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260389 1113 #uuid "8d8626cf-33ce-5080-be62-864632b78a7a" 13194139533864 true] [17592186260389 1145 "The standard form of a quadratic equation is\n\n$$\na{x}^{2}+bx+c=0,\n$$\n\nwhere $a,$ $b,$ and $c$ are constants and $a\\ne 0.$\n\nTo write this equation in standard form, we start by expanding the binomial product on the left-hand side:\n\n$$\n\\begin{aligned}(2x-1)(x-1) & =-2{x}^{2} \\\\ 2x(x-1)-1(x-1) & =-2{x}^{2} \\\\ 2{x}^{2}-2x-x+1 & =-2{x}^{2} \\\\ 2{x}^{2}-3x+1 & =-2{x}^{2}\\end{aligned}\n$$\n\nThen, we collect the ${x}^{2}$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}-3x+1 & =-2{x}^{2} \\\\ 2{x}^{2}-3x+1+2{x}^{2} & =-2{x}^{2}+2{x}^{2} \\\\ (2{x}^{2}+2{x}^{2})-3x+1 & =0 \\\\ 4{x}^{2}-3x+1 & =0\\end{aligned}\n$$\n\nWe see that our equation is in the standard form of a quadratic equation with $a=4,$ $b=-3,$ and $c=1.$\n\nTherefore, our equation is a quadratic equation." 13194139533864 true] [17592186260390 1000 #edb/ref 17592186260391 13194139533864 true] [17592186260390 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260390 1041 "answer" 13194139533864 true] [17592186260390 1104 #edb/ref 17592186260391 13194139533864 true] [17592186260390 1110 #uuid "2fecff78-4823-57f7-ba95-93f3f42f0f86" 13194139533864 true] [17592186260391 1034 "4x^2-3x+1=0" 13194139533864 true] [17592186260391 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260391 1111 #uuid "62c993ae-3b7f-54a9-8915-64cf4748902a" 13194139533864 true] [17592186260392 1017 #edb/ref 17592186260393 13194139533864 true] [17592186260392 1089 "q-44205" 13194139533864 true] [17592186260392 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260392 1100 "Solve for $t$ where $\\frac{1-3t}{5}=-\\frac{4+t}{2}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260392 1113 #uuid "fcdcd9f3-7122-5f59-93b6-53cc1a94a313" 13194139533864 true] [17592186260392 1145 "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{1-3t}{5} & =-\\frac{4+t}{2} \\\\ \\frac{1-3t}{5} & =\\frac{-(4+t)}{2} \\\\ \\frac{1-3t}{5} & =\\frac{-4-t}{2} \\\\ (1-3t)\\cdot 2 & =5\\cdot (-4-t)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(1-3t)\\cdot 2 & =5\\cdot (-4-t) \\\\ 2-6t & =-20-5t \\\\ 2-6t+5t & =-20-5t+5t \\\\ 2-t & =-20 \\\\ 2-t-2 & =-20-2 \\\\ -t & =-22 \\\\ -1\\cdot t & =-22 \\\\ \\frac{-1\\cdot t}{-1} & =\\frac{-22}{-1} \\\\ t & =22\\end{aligned}\n$$" 13194139533864 true] [17592186260393 1000 #edb/ref 17592186260394 13194139533864 true] [17592186260393 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260393 1041 "answer" 13194139533864 true] [17592186260393 1104 #edb/ref 17592186260394 13194139533864 true] [17592186260393 1110 #uuid "5a52611a-e49a-575e-a27a-b6d409261943" 13194139533864 true] [17592186260394 1034 "22" 13194139533864 true] [17592186260394 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260394 1111 #uuid "9e802ab2-21bf-5bbc-9750-1cc6f48bf884" 13194139533864 true] [17592186260395 1017 #edb/ref 17592186260396 13194139533864 true] [17592186260395 1017 #edb/ref 17592186260398 13194139533864 true] [17592186260395 1089 "q-44298" 13194139533864 true] [17592186260395 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260395 1100 "Calculate the $x$-intercept of the line $y=15x+5.$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" 13194139533864 true] [17592186260395 1113 #uuid "8c4e56e6-52fc-51ba-afd3-0b7b7237eab0" 13194139533864 true] [17592186260395 1145 "At the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =15x+5 \\\\ 0 & =15x+5 \\\\ -15x & =5 \\\\ \\frac{-15x}{(-15)} & =\\frac{5}{(-15)} \\\\ x & =-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=-\\frac{1}{3}.$ The coordinates of the $x$-intercept are $(-\\frac{1}{3},0).$" 13194139533864 true] [17592186260396 1000 #edb/ref 17592186260397 13194139533864 true] [17592186260396 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260396 1041 "coordinate-1" 13194139533864 true] [17592186260396 1104 #edb/ref 17592186260397 13194139533864 true] [17592186260396 1110 #uuid "da5b7cc0-e4c3-528c-aa88-a10de0acf241" 13194139533864 true] [17592186260397 1034 "-\\frac{1}{3}" 13194139533864 true] [17592186260397 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260397 1111 #uuid "2c4ee81a-ccfb-5af4-9d7f-6b289d2cd64d" 13194139533864 true] [17592186260398 1000 #edb/ref 17592186260399 13194139533864 true] [17592186260398 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260398 1041 "coordinate-2" 13194139533864 true] [17592186260398 1104 #edb/ref 17592186260399 13194139533864 true] [17592186260398 1110 #uuid "59769b53-693c-54d6-bb7a-05801ddb3206" 13194139533864 true] [17592186260399 1034 "0" 13194139533864 true] [17592186260399 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260399 1111 #uuid "ea076972-7904-5cb7-87e8-ab329a78a15c" 13194139533864 true] [17592186260400 1017 #edb/ref 17592186260401 13194139533864 true] [17592186260400 1089 "q-44569" 13194139533864 true] [17592186260400 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260400 1100 "Find the values of $k$ for which the quadratic equation ${x}^{2}-4x+k=0$ has two distinct real solutions.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260400 1113 #uuid "2ac70896-3e36-518c-bc5d-d9fb814801dd" 13194139533864 true] [17592186260400 1145 "The equation has two distinct real solutions if its discriminant is positive. So, we need to find the values of $k$ so that the discriminant is positive.\n\nFirst, we calculate the discriminant. We have $a=1,$ $b=-4$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-4)^{2}-4(1)(k) \\\\  & =16-4k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is positive:\n\n$$\n\\begin{aligned}D & >0 \\\\ 16-4k & >0 \\\\ 16 & >4k \\\\ 4k & <16 \\\\ k & <4\\end{aligned}\n$$\n\nTherefore, the given equation will have two distinct real solutions if $k<4.$" 13194139533864 true] [17592186260401 1000 #edb/ref 17592186260402 13194139533864 true] [17592186260401 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260401 1041 "answer" 13194139533864 true] [17592186260401 1104 #edb/ref 17592186260402 13194139533864 true] [17592186260401 1110 #uuid "40a973a8-50a3-54da-bd15-1983cd912fe0" 13194139533864 true] [17592186260402 1034 "k<4" 13194139533864 true] [17592186260402 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260402 1111 #uuid "dba1cbd4-42b3-5e19-a714-a1a51fbe05f2" 13194139533864 true] [17592186260403 1017 #edb/ref 17592186260404 13194139533864 true] [17592186260403 1089 "q-44571" 13194139533864 true] [17592186260403 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260403 1100 "Find the values of $k$ for which the quadratic equation $-3{x}^{2}+12x=-k$ has two distinct real solutions.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260403 1113 #uuid "40918e56-d78a-554c-b936-9df96a583818" 13194139533864 true] [17592186260403 1145 "The equation has two distinct real solutions if its discriminant is positive. So, we need to find the values of $k$ so that the discriminant is positive.\n\nFirst, we write the equation in standard form:\n\n$$\n-3{x}^{2}+12x+k=0.\n$$\n\nWe have $a=-3,$ $b=12,$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={12}^{2}-4(-3)(k) \\\\  & =144+12k.\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is positive:\n\n$$\n\\begin{aligned}D & >0 \\\\ 144+12k & >0 \\\\ 12k & >-144 \\\\ k & >-12.\\end{aligned}\n$$\n\nTherefore, the given equation will have two distinct real solutions if $k>-12.$" 13194139533864 true] [17592186260404 1000 #edb/ref 17592186260405 13194139533864 true] [17592186260404 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260404 1041 "answer" 13194139533864 true] [17592186260404 1104 #edb/ref 17592186260405 13194139533864 true] [17592186260404 1110 #uuid "6851ed09-f669-5650-858d-0ed4cd6c1a02" 13194139533864 true] [17592186260405 1034 "k>-12" 13194139533864 true] [17592186260405 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260405 1111 #uuid "821bc74d-363a-5f3d-bca0-3359ec5ce7dd" 13194139533864 true] [17592186260406 1017 #edb/ref 17592186260407 13194139533864 true] [17592186260406 1089 "q-44574" 13194139533864 true] [17592186260406 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260406 1100 "Find the values of $k$ for which the quadratic equation $2{x}^{2}+4x+k=0$ has two distinct real solutions.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260406 1113 #uuid "314699a9-b061-5681-8fe3-0fd5603826da" 13194139533864 true] [17592186260406 1145 "The equation has two distinct real solutions if its discriminant is positive. So, we need to find the values of $k$ so that the discriminant is positive.\n\nFirst, we calculate the discriminant. We have $a=2,$ $b=4$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(4)^{2}-4(2)(k) \\\\  & =16-8k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is positive:\n\n$$\n\\begin{aligned}D & >0 \\\\ 16-8k & >0 \\\\ 16 & >8k \\\\ 8k & <16 \\\\ k & <2.\\end{aligned}\n$$\n\nTherefore, the given equation will have two distinct real solutions if $k<2.$" 13194139533864 true] [17592186260407 1000 #edb/ref 17592186260408 13194139533864 true] [17592186260407 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260407 1041 "answer" 13194139533864 true] [17592186260407 1104 #edb/ref 17592186260408 13194139533864 true] [17592186260407 1110 #uuid "eea49d29-0250-5852-88cc-7c8a0607d7af" 13194139533864 true] [17592186260408 1034 "k<2" 13194139533864 true] [17592186260408 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260408 1111 #uuid "91a11659-bdc2-5dad-bdd4-1cfdb108d52d" 13194139533864 true] [17592186260409 1017 #edb/ref 17592186260410 13194139533864 true] [17592186260409 1089 "q-4460" 13194139533864 true] [17592186260409 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260409 1100 "Find ${lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260409 1113 #uuid "7f232a13-ac59-5c7f-b9ee-ff0c688c0095" 13194139533864 true] [17592186260409 1145 "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2}=\\frac{{lim}_{x\\to 1}(\\sqrt[3]{{x}^{2}+3x+4}+6x)}{{lim}_{x\\to 1}(4x-2)}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nApplying the root rule in the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}(\\sqrt[3]{{x}^{2}+3x+4}+6x) & =\\sqrt[3]{{1}^{2}+3(1)+4}+6(1) \\\\  & =\\sqrt[3]{1+3+4}+6 \\\\  & =\\sqrt[3]{8}+6 \\\\  & =2+6 \\\\  & =8.\\end{aligned}\n$$\n\nFor the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 1}(4x-2) & =4(1)-2=2\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2} & =\\frac{8}{2}=4\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260410 1000 #edb/ref 17592186260411 13194139533864 true] [17592186260410 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260410 1041 "answer" 13194139533864 true] [17592186260410 1104 #edb/ref 17592186260411 13194139533864 true] [17592186260410 1110 #uuid "3d213a5a-61a1-56dc-a89c-7e909aa9753d" 13194139533864 true] [17592186260411 1034 "4" 13194139533864 true] [17592186260411 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260411 1111 #uuid "ba9a8eb1-1589-50a7-aec1-2595510c8f04" 13194139533864 true] [17592186260412 1017 #edb/ref 17592186260413 13194139533864 true] [17592186260412 1089 "q-4469" 13194139533864 true] [17592186260412 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260412 1100 "Evaluate ${lim}_{x\\to {5}^{+}}\\frac{\\sqrt{2x-1}-3}{x-5}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260412 1113 #uuid "b1b61dac-dcb8-5733-8ee2-72d827e766d3" 13194139533864 true] [17592186260412 1145 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {5}^{+}}\\frac{\\sqrt{2x-1}-3}{x-5} & =\\frac{\\sqrt{2(5)-1}-3}{5-5}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {5}^{+}}\\frac{\\sqrt{2x-1}-3}{x-5} & ={lim}_{x\\to {5}^{+}}\\frac{(\\sqrt{2x-1}-3)(\\sqrt{2x-1}+3)}{(x-5)(\\sqrt{2x-1}+3)} \\\\  & ={lim}_{x\\to {5}^{+}}\\frac{{(\\sqrt{2x-1})}^{2}-{3}^{2}}{(x-5)(\\sqrt{2x-1}+3)} \\\\  & ={lim}_{x\\to {5}^{+}}\\frac{2x-1-9}{(x-5)(\\sqrt{2x-1}+3)} \\\\  & ={lim}_{x\\to {5}^{+}}\\frac{2x-10}{(x-5)(\\sqrt{2x-1}+3)} \\\\  & ={lim}_{x\\to {5}^{+}}\\frac{2(x-5)}{(x-5)(\\sqrt{2x-1}+3)} \\\\  & ={lim}_{x\\to {5}^{+}}\\frac{2}{\\sqrt{2x-1}+3} \\\\  & =\\frac{2}{\\sqrt{2(5)-1}+3} \\\\  & =\\frac{2}{6} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" 13194139533864 true] [17592186260413 1000 #edb/ref 17592186260414 13194139533864 true] [17592186260413 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260413 1041 "answer" 13194139533864 true] [17592186260413 1104 #edb/ref 17592186260414 13194139533864 true] [17592186260413 1110 #uuid "9f948605-0438-5761-a387-1a77da15a514" 13194139533864 true] [17592186260414 1034 "\\frac{1}{3}" 13194139533864 true] [17592186260414 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260414 1111 #uuid "6c02b898-1aa1-52df-aa4d-6305b77d4cd0" 13194139533864 true] [17592186260415 1017 #edb/ref 17592186260416 13194139533864 true] [17592186260415 1089 "q-45301" 13194139533864 true] [17592186260415 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260415 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/de02555d435e957019036ace7b723225ff6f3dd905f7533a51a353bacc603fce.png)\n\nWhich of the following combinations of transformations map the segment $AB$ to a congruent segment?\n\nI. - A reflection in the $y$-axis, followed by a reflection in the $x$-axis.\nII. - A rotation of ${35}^{∘}$ clockwise around the point $B.$\nIII. - A dilation of scale factor of $4$ with center of dilation $A,$ followed by a translation of $3$ units to the left." 13194139533864 true] [17592186260415 1113 #uuid "41248f0a-a076-5b66-940a-eca2e5291a4b" 13194139533864 true] [17592186260415 1145 "A rigid motion is a transformation that preserves distances. There are three types of rigid motions:\n\n- Translations\n\n- Rotations\n\n- Reflections\n\nAlso, two polygons are congruent if and only if one can be mapped to another using a combination of rigid motions.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Combination I maps $AB$ to a congruent segment. Indeed, reflections are rigid motions.\n\n- Combination II maps $AB$ to a congruent segment. Indeed, a rotation is a rigid motion.\n\n- Combination III does not map $AB$ to a congruent segment because dilation is not a rigid motion.\n\nTherefore, the correct answer is \"I and II only.\"" 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260417 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260418 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260419 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260420 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260421 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260422 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260423 13194139533864 true] [17592186260416 1000 #edb/ref 17592186260424 13194139533864 true] [17592186260416 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260416 1041 "selection" 13194139533864 true] [17592186260416 1104 #edb/ref 17592186260422 13194139533864 true] [17592186260416 1110 #uuid "fd9b793c-a80d-5119-bd10-c96f2a5e5f39" 13194139533864 true] [17592186260417 1034 "I, II, and III" 13194139533864 true] [17592186260417 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260417 1111 #uuid "0a479ba3-feb6-5453-9357-da6b1db12efa" 13194139533864 true] [17592186260418 1034 "II and III only" 13194139533864 true] [17592186260418 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260418 1111 #uuid "517f2865-77aa-509b-9701-a6cab8243aae" 13194139533864 true] [17592186260419 1034 "I and III only" 13194139533864 true] [17592186260419 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260419 1111 #uuid "4327f18a-dfb3-56fc-9926-b89eefc912f8" 13194139533864 true] [17592186260420 1034 "I only" 13194139533864 true] [17592186260420 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260420 1111 #uuid "baf45562-a86a-54e7-9a49-5399e7399a16" 13194139533864 true] [17592186260421 1034 "III only" 13194139533864 true] [17592186260421 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260421 1111 #uuid "2174ef5f-f026-5344-af8e-44b86ef478b3" 13194139533864 true] [17592186260422 1034 "I and II only" 13194139533864 true] [17592186260422 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260422 1111 #uuid "114a3157-beae-521a-913f-6953e81d1d44" 13194139533864 true] [17592186260423 1034 "None of those listed" 13194139533864 true] [17592186260423 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260423 1111 #uuid "f32881c3-f0b8-5f3d-a989-e1a2d518e877" 13194139533864 true] [17592186260424 1034 "II only" 13194139533864 true] [17592186260424 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260424 1111 #uuid "ec33a8d3-5f3f-525a-a94b-b70111b7d158" 13194139533864 true] [17592186260425 1017 #edb/ref 17592186260426 13194139533864 true] [17592186260425 1089 "q-45468" 13194139533864 true] [17592186260425 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260425 1100 "Which of the following transformations map every polygon to a congruent polygon?\n\nI. - $(x,y)↦(x-1,y)$\nII. - $(x,y)↦(-y,x)$\nIII. - $(x,y)↦(2x,y)$" 13194139533864 true] [17592186260425 1113 #uuid "ebee1808-fab9-59f7-b821-b1dbd643c058" 13194139533864 true] [17592186260425 1145 "A rigid motion is a transformation that preserves distances. There are three types of rigid motions:\n\n- Translations\n\n- Rotations\n\n- Reflections\n\nAlso, two polygons are congruent if and only if one can be mapped to another using a combination of rigid motions.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I is a translation of $1$ unit to the right. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation II is a rotation of ${90}^{∘}$ counterclockwise about the origin. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation III is a stretch with a stretch factor of $2$ in the $x$-direction. This is *not* a rigid motion. So, it does not map every polygon to a congruent polygon.\n\nTherefore, the correct answer is \"I and II only.\"" 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260427 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260428 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260429 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260430 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260431 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260432 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260433 13194139533864 true] [17592186260426 1000 #edb/ref 17592186260434 13194139533864 true] [17592186260426 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260426 1041 "selection" 13194139533864 true] [17592186260426 1104 #edb/ref 17592186260432 13194139533864 true] [17592186260426 1110 #uuid "18468b5f-9d2d-55e6-b1a6-13894be795c4" 13194139533864 true] [17592186260427 1034 "I, II, and III" 13194139533864 true] [17592186260427 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260427 1111 #uuid "5cd1f6ab-9e6f-5379-a843-509d13d54a28" 13194139533864 true] [17592186260428 1034 "II and III only" 13194139533864 true] [17592186260428 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260428 1111 #uuid "8b393e06-c6ab-55ad-84e1-b84baf9ce523" 13194139533864 true] [17592186260429 1034 "I and III only" 13194139533864 true] [17592186260429 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260429 1111 #uuid "6cee4cc0-d3b3-5d78-b68e-a0edbb097628" 13194139533864 true] [17592186260430 1034 "I only" 13194139533864 true] [17592186260430 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260430 1111 #uuid "64612897-434e-5af8-8a66-2a579b19b522" 13194139533864 true] [17592186260431 1034 "III only" 13194139533864 true] [17592186260431 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260431 1111 #uuid "c485b055-36f4-5265-94ce-14a224fd55fa" 13194139533864 true] [17592186260432 1034 "I and II only" 13194139533864 true] [17592186260432 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260432 1111 #uuid "9922f82f-d65d-53c8-b56b-c4df0a16c693" 13194139533864 true] [17592186260433 1034 "None of those listed" 13194139533864 true] [17592186260433 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260433 1111 #uuid "5adc6009-37d9-5443-bdf7-3a25923f800d" 13194139533864 true] [17592186260434 1034 "II only" 13194139533864 true] [17592186260434 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260434 1111 #uuid "ef89d4ba-070d-5810-9324-b577e0b6fd73" 13194139533864 true] [17592186260435 1017 #edb/ref 17592186260436 13194139533864 true] [17592186260435 1089 "q-46167" 13194139533864 true] [17592186260435 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260435 1100 "The curve $y=4{x}^{2}-24x+24$ can be written as $y=a(x+b)^{2}+c.$ Calculate $a+b+c.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260435 1113 #uuid "d537e63a-0b98-56d5-9a0e-cfd908ba035e" 13194139533864 true] [17592186260435 1145 "To express the equation of the parabola in vertex form, we need to complete the square. \n\nFirst, we take out a factor of $4$ from the entire expression:\n\n$$\n\\begin{aligned}4{x}^{2}-24x+24 & =4({x}^{2}-6x+6)\\end{aligned}\n$$\n\nNow, we complete the square for the expression inside the parentheses:\n\n$$\n\\begin{aligned}{x}^{2}-6x+6 & = \\\\ {x}^{2}-2\\cdot 3\\cdot x+6 & = \\\\ {x}^{2}-2\\cdot 3\\cdot x+{3}^{2}-{3}^{2}+6 & = \\\\ ({x}^{2}-2\\cdot 3\\cdot x+{3}^{2})-{3}^{2}+6 & = \\\\ (x-3)^{2}-{3}^{2}+6 & = \\\\ (x-3)^{2}-9+6 & = \\\\ (x-3)^{2}-3\\end{aligned}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}4({x}^{2}-6x+6) & = \\\\ 4((x-3)^{2}-3) & = \\\\ 4(x-3)^{2}-12\\end{aligned}\n$$\n\nSo,  $a+b+c=4+(-3)+(-12)=-11.$" 13194139533864 true] [17592186260436 1000 #edb/ref 17592186260437 13194139533864 true] [17592186260436 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260436 1041 "answer" 13194139533864 true] [17592186260436 1104 #edb/ref 17592186260437 13194139533864 true] [17592186260436 1110 #uuid "15d73943-5b21-5284-b561-312dc91a8737" 13194139533864 true] [17592186260437 1034 "-11" 13194139533864 true] [17592186260437 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260437 1111 #uuid "783b0e30-4221-51cb-be22-d35124ccd74f" 13194139533864 true] [17592186260438 1017 #edb/ref 17592186260439 13194139533864 true] [17592186260438 1089 "q-46814" 13194139533864 true] [17592186260438 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260438 1100 "Martin surveyed some students in a school, asking them if they have cats or dogs at home. His findings are summarized in the two-way frequency table below.\n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $6$ | $9$ | $15$ |\n| Doesn't have a cat | $10$ | $7$ | $17$ |\n| Totals | $16$ | $16$ | $32$ |\n\nEstimate the probability that a randomly chosen student in the school has either a cat or a dog but not both.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260438 1113 #uuid "f0371bfd-8501-506c-b9fa-24609b84ea8d" 13194139533864 true] [17592186260438 1145 "To estimate the probability that a randomly chosen student in the school has either a cat or a dog but not both, we\n\n- add up the numbers in the row **\" Has a cat\"** or the column **\"Has a dog\"** but not in their intersection, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the row **\"Has a cat\"** or the column **\"Has a dog\"** but not in their intersection are highlighted below.\n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $6$ | $9$ | $15$ |\n| Doesn't have a cat | $10$ | $7$ | $17$ |\n| Totals | $16$ | $16$ | $32$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(32),$ we get\n\n$$\np=\\frac{9+10}{32}=\\frac{19}{32}.\n$$" 13194139533864 true] [17592186260439 1000 #edb/ref 17592186260440 13194139533864 true] [17592186260439 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260439 1041 "answer" 13194139533864 true] [17592186260439 1104 #edb/ref 17592186260440 13194139533864 true] [17592186260439 1110 #uuid "d24908d8-a2f5-5436-aecb-56c6458ab874" 13194139533864 true] [17592186260440 1034 "\\frac{19}{32}" 13194139533864 true] [17592186260440 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260440 1111 #uuid "ae0f137c-f1e6-5c07-842d-8713cd771e0f" 13194139533864 true] [17592186260441 1017 #edb/ref 17592186260442 13194139533864 true] [17592186260441 1089 "q-46833" 13194139533864 true] [17592186260441 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260441 1100 "Evaluate ${lim}_{x\\to {2}^{-}}\\frac{x-2}{2x-\\sqrt{8x}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260441 1113 #uuid "678f5c58-bbd6-5e36-9285-ca3cd7002851" 13194139533864 true] [17592186260441 1145 "If we attempt to evaluate the limit by simply evaluating the function at $x=2$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}\\frac{x-2}{2x-\\sqrt{8x}} & =\\frac{2-2}{2(2)-\\sqrt{8(2)}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}\\frac{x-2}{2x-\\sqrt{8x}} & ={lim}_{x\\to {2}^{-}}\\frac{(x-2)(2x+\\sqrt{8x})}{(2x-\\sqrt{8x})(2x+\\sqrt{8x})} \\\\  & ={lim}_{x\\to {2}^{-}}\\frac{(x-2)(2x+\\sqrt{8x})}{(2x)^{2}-{(\\sqrt{8x})}^{2}} \\\\  & ={lim}_{x\\to {2}^{-}}\\frac{(x-2)(2x+\\sqrt{8x})}{4{x}^{2}-8x} \\\\  & ={lim}_{x\\to {2}^{-}}\\frac{(x-2)(2x+\\sqrt{8x})}{4x(x-2)} \\\\  & ={lim}_{x\\to {2}^{-}}\\frac{2x+\\sqrt{8x}}{4x} \\\\  & =\\frac{2(2)+\\sqrt{8(2)}}{4(2)} \\\\  & =\\frac{4+4}{8} \\\\  & =1.\\end{aligned}\n$$" 13194139533864 true] [17592186260442 1000 #edb/ref 17592186260443 13194139533864 true] [17592186260442 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260442 1041 "answer" 13194139533864 true] [17592186260442 1104 #edb/ref 17592186260443 13194139533864 true] [17592186260442 1110 #uuid "d277c78c-1469-51f9-96ba-677522683231" 13194139533864 true] [17592186260443 1034 "1" 13194139533864 true] [17592186260443 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260443 1111 #uuid "2a4b2d75-2e5e-5759-a73d-ce1d5a2549ae" 13194139533864 true] [17592186260444 1017 #edb/ref 17592186260445 13194139533864 true] [17592186260444 1089 "q-46839" 13194139533864 true] [17592186260444 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260444 1100 "Evaluate ${lim}_{x\\to {8}^{+}}\\frac{x-8}{4-\\sqrt{2x}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260444 1113 #uuid "d6fab19a-aae0-556f-9992-7a68d4d6de92" 13194139533864 true] [17592186260444 1145 "If we attempt to evaluate the limit by simply evaluating the function at $x=8$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {8}^{+}}\\frac{x-8}{4-\\sqrt{2x}} & =\\frac{8-8}{4-\\sqrt{2\\cdot 8}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {8}^{+}}\\frac{x-8}{4-\\sqrt{2x}} & ={lim}_{x\\to {8}^{+}}\\frac{(x-8)(4+\\sqrt{2x})}{(4-\\sqrt{2x})(4+\\sqrt{2x})} \\\\  & ={lim}_{x\\to {8}^{+}}\\frac{(x-8)(4+\\sqrt{2x})}{{4}^{2}-{(\\sqrt{2x})}^{2}} \\\\  & ={lim}_{x\\to {8}^{+}}\\frac{(x-8)(4+\\sqrt{2x})}{16-2x} \\\\  & ={lim}_{x\\to {8}^{+}}\\frac{(x-8)(4+\\sqrt{2x})}{-2(x-8)} \\\\  & ={lim}_{x\\to {8}^{+}}\\frac{4+\\sqrt{2x}}{-2} \\\\  & =\\frac{4+\\sqrt{2(8)}}{-2} \\\\  & =-4.\\end{aligned}\n$$" 13194139533864 true] [17592186260445 1000 #edb/ref 17592186260446 13194139533864 true] [17592186260445 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260445 1041 "answer" 13194139533864 true] [17592186260445 1104 #edb/ref 17592186260446 13194139533864 true] [17592186260445 1110 #uuid "b0581553-e79c-501c-a973-086be2342b5f" 13194139533864 true] [17592186260446 1034 "-4" 13194139533864 true] [17592186260446 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260446 1111 #uuid "b68e11b3-a57c-5715-bb2f-6f584359c034" 13194139533864 true] [17592186260447 1017 #edb/ref 17592186260448 13194139533864 true] [17592186260447 1089 "q-46841" 13194139533864 true] [17592186260447 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260447 1100 "Evaluate ${lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260447 1113 #uuid "e08fbc7b-1ab0-52e1-b7cf-725d96e81d95" 13194139533864 true] [17592186260447 1145 "If we attempt to evaluate the limit by simply evaluating the function at $x=25$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5} & =\\frac{25-25}{\\sqrt{25}-5}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5} & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{(\\sqrt{x}-5)(\\sqrt{x}+5)} \\\\  & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{{(\\sqrt{x})}^{2}-{5}^{2}} \\\\  & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{x-25} \\\\  & ={lim}_{x\\to 25}(\\sqrt{x}+5) \\\\  & =\\sqrt{25}+5 \\\\  & =10.\\end{aligned}\n$$" 13194139533864 true] [17592186260448 1000 #edb/ref 17592186260449 13194139533864 true] [17592186260448 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260448 1041 "answer" 13194139533864 true] [17592186260448 1104 #edb/ref 17592186260449 13194139533864 true] [17592186260448 1110 #uuid "d2114988-497a-53f9-a5a0-c96042ed491a" 13194139533864 true] [17592186260449 1034 "10" 13194139533864 true] [17592186260449 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260449 1111 #uuid "52445dd2-31d0-551a-bcb1-4c442de1e2b1" 13194139533864 true] [17592186260450 1017 #edb/ref 17592186260451 13194139533864 true] [17592186260450 1089 "q-46975" 13194139533864 true] [17592186260450 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260450 1100 "Given that $p(x)=\\frac{2}{{x}^{4}}$ and $q(x)=\\frac{1}{{x}^{2}},$ what is ${lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260450 1113 #uuid "5b240cab-24fa-5335-a943-6cdfe8310c86" 13194139533864 true] [17592186260450 1145 "First, we divide the two functions, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{2}{{x}^{4}})}{(\\frac{1}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }(\\frac{2}{{x}^{2}})\\end{aligned}\n$$\n\nNow, we use the algebra of limits to pull out the constant factor of $2:$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(\\frac{2}{{x}^{2}}) & ={lim}_{x\\to \\infty }(2\\cdot \\frac{1}{{x}^{2}}) \\\\  & =2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{2}})\\end{aligned}\n$$\n\nUsing the fact that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{1}{{x}^{2}})=0,\n$$\n\nWe can evaluate our limit as follows:\n\n$$\n2\\cdot {lim}_{x\\to -\\infty }(\\frac{1}{{x}^{2}})=2\\cdot 0=0\n$$" 13194139533864 true] [17592186260451 1000 #edb/ref 17592186260452 13194139533864 true] [17592186260451 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260451 1041 "answer" 13194139533864 true] [17592186260451 1104 #edb/ref 17592186260452 13194139533864 true] [17592186260451 1110 #uuid "511ca430-2669-5d58-94b7-ee16594c46e4" 13194139533864 true] [17592186260452 1034 "0" 13194139533864 true] [17592186260452 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260452 1111 #uuid "62b06ea6-f6ee-5ce4-8188-756ab212a69e" 13194139533864 true] [17592186260453 1017 #edb/ref 17592186260454 13194139533864 true] [17592186260453 1017 #edb/ref 17592186260456 13194139533864 true] [17592186260453 1089 "q-4698" 13194139533864 true] [17592186260453 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260453 1100 "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{8{x}^{4}+x}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" 13194139533864 true] [17592186260453 1113 #uuid "119a8c59-2e06-5773-a076-fad28dc30f8e" 13194139533864 true] [17592186260453 1145 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x:$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{8{x}^{4}+x} \\\\  & =\\frac{(x+1)(x-1)}{x(8{x}^{3}+1)} \\\\  & =\\frac{(x+1)(x-1)}{x[(2x)^{3}+{1}^{3}]} \\\\  & =\\frac{(x+1)(x-1)}{x(2x+1)(4{x}^{2}-2x+1)}.\\end{aligned}\n$$\n\nNotice that we used the sum of cubes formula to factor the denominator.\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx(2x+1)(4{x}^{2}-2x+1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x=0$ gives the solution $x=0.$\n\n- Solving $2x+1=0$ gives the solution $x=-\\frac{1}{2}.$\n\n- The equation $4{x}^{2}-2x+1=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(4)(1) \\\\  & =4-16 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the equations of the vertical asymptotes are $x=0$ and $x=-\\frac{1}{2}.$" 13194139533864 true] [17592186260454 1000 #edb/ref 17592186260455 13194139533864 true] [17592186260454 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260454 1041 "root-1" 13194139533864 true] [17592186260454 1104 #edb/ref 17592186260455 13194139533864 true] [17592186260454 1110 #uuid "46d1f1c9-b7e1-599a-82e1-4f2e81294d21" 13194139533864 true] [17592186260455 1034 "-\\frac12" 13194139533864 true] [17592186260455 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260455 1111 #uuid "a6460636-9908-59dc-9e66-447743541a94" 13194139533864 true] [17592186260456 1000 #edb/ref 17592186260457 13194139533864 true] [17592186260456 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260456 1041 "root-2" 13194139533864 true] [17592186260456 1104 #edb/ref 17592186260457 13194139533864 true] [17592186260456 1110 #uuid "9d831575-8a4a-5fa8-9723-55677181c32e" 13194139533864 true] [17592186260457 1034 "0" 13194139533864 true] [17592186260457 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260457 1111 #uuid "66d0bdef-2464-576f-9685-817bdc8a8870" 13194139533864 true] [17592186260458 1017 #edb/ref 17592186260459 13194139533864 true] [17592186260458 1089 "q-47042" 13194139533864 true] [17592186260458 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260458 1100 "Calculate ${lim}_{x\\to \\pi /3}\\operatorname{csc}(3x).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260458 1113 #uuid "7310ec48-8cde-5be8-a175-14a7f9afbd15" 13194139533864 true] [17592186260458 1145 "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /3}\\operatorname{csc}(3x) & =\\operatorname{csc}(3\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{csc}(\\pi ) \\\\  & =\\frac{1}{\\operatorname{sin}(\\pi )} \\\\  & =\\frac{1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{csc}(3x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/c858e8756e180eeefc965a760b9d59b0e369738dfd16b32b17b448ca0daa513e.png)\n\nAs $x$ approaches $\\frac{\\pi }{3}$ from the left, the values of $y=\\operatorname{csc}(3x)$ are positive and grow without bound. So,\n\n$$\n{lim}_{x\\to (\\pi /3)^{-}}\\operatorname{csc}(3x)=\\infty .\n$$\n\nSimilarly, as $x$ approaches $\\frac{\\pi }{3}$ from the right, the values of $y=\\operatorname{csc}(3x)$ are negative and decrease without bound. So,\n\n$$\n{lim}_{x\\to (\\pi /3)^{+}}\\operatorname{csc}(3x)=-\\infty .\n$$\n\nTherefore, since the two limits are not equal, we conclude that\n\n$$\n{lim}_{x\\to \\pi /3}\\operatorname{csc}(3x)=\\text{DNE}.\n$$" 13194139533864 true] [17592186260459 1000 #edb/ref 17592186260460 13194139533864 true] [17592186260459 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260459 1041 "answer" 13194139533864 true] [17592186260459 1104 #edb/ref 17592186260460 13194139533864 true] [17592186260459 1110 #uuid "a0c25169-4101-508e-a401-e9f2318a0312" 13194139533864 true] [17592186260460 1034 "\\text{DNE}" 13194139533864 true] [17592186260460 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260460 1111 #uuid "d7c80b8c-99b2-516c-92f6-6996a2326efa" 13194139533864 true] [17592186260461 1017 #edb/ref 17592186260462 13194139533864 true] [17592186260461 1089 "q-47125" 13194139533864 true] [17592186260461 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260461 1100 "Calculate ${lim}_{x\\to {0}^{-}}\\operatorname{csc}x.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260461 1113 #uuid "4c10226c-ef84-5cda-8872-1e74e05928af" 13194139533864 true] [17592186260461 1145 "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}\\operatorname{csc}x & =\\operatorname{csc}0 \\\\  & =\\frac{1}{\\operatorname{sin}0} \\\\  & =\\frac{1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{csc}(x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fcdebef9e1184a2850c91e9ff1c4b6f0b47ce12b8bad07772171a7304f79150a.png)\n\nAs $x$ approaches $0$ from the left, the values of $y=\\operatorname{csc}x$ are negative and decrease without bound. \n\nTherefore\n\n$$\n{lim}_{x\\to {0}^{-}}\\operatorname{csc}x=-\\infty \n$$" 13194139533864 true] [17592186260462 1000 #edb/ref 17592186260463 13194139533864 true] [17592186260462 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260462 1041 "answer" 13194139533864 true] [17592186260462 1104 #edb/ref 17592186260463 13194139533864 true] [17592186260462 1110 #uuid "3cb14d33-2172-566a-8006-02841f6205b2" 13194139533864 true] [17592186260463 1034 "-\\infty" 13194139533864 true] [17592186260463 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260463 1111 #uuid "66ff4626-a304-5c5d-a590-6920e36f3c7a" 13194139533864 true] [17592186260464 1017 #edb/ref 17592186260465 13194139533864 true] [17592186260464 1089 "q-47134" 13194139533864 true] [17592186260464 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260464 1100 "${lim}_{x\\to 0}\\operatorname{cot}8x=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260464 1113 #uuid "d5d16e5f-a36f-55fb-8cca-84ea5e751606" 13194139533864 true] [17592186260464 1145 "Let's introduce the new variable $t=8x.$ In the limit $x\\to 0,$ we have \n\n$$\n\\begin{aligned}t & \\to 8(0)=0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to 0}\\operatorname{cot}8x={lim}_{t\\to 0}\\operatorname{cot}t=\\text{DNE}.\n$$\n\nThe graph of $y=\\operatorname{cot}t$ is given below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/023929a3b0d4d40c7bd86a22ea04965d63e455ea3fc8d524c84314cb8fefdaac.png)" 13194139533864 true] [17592186260465 1000 #edb/ref 17592186260466 13194139533864 true] [17592186260465 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260465 1041 "answer" 13194139533864 true] [17592186260465 1104 #edb/ref 17592186260466 13194139533864 true] [17592186260465 1110 #uuid "dd9fade0-f663-5328-a0df-46c2650d18ad" 13194139533864 true] [17592186260466 1034 "\\text{DNE}" 13194139533864 true] [17592186260466 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260466 1111 #uuid "768e6c4d-51ac-50c3-8a3b-f304acb6b550" 13194139533864 true] [17592186260467 1017 #edb/ref 17592186260468 13194139533864 true] [17592186260467 1089 "q-47139" 13194139533864 true] [17592186260467 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260467 1100 "The employees and the interns of a company were asked whether they commute to work by car or by bus. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Employee | Intern | Totals |\n| --- | --- | --- | --- |\n| Car | $24$ | $16$ | $40$ |\n| Bus | $26$ | $14$ | $40$ |\n| Totals | $50$ | $30$ | $80$ |\n\nLet $I$ be the event that a randomly selected person is a **\"Intern\"**, and $B$ be the event that a randomly selected person commutes to work by **\"Bus\"**. Estimate $P(I\\cup B).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260467 1113 #uuid "6ed5c80c-e475-58de-a971-282836200277" 13194139533864 true] [17592186260467 1145 "First, note that $I\\cup B$ is the event that a randomly selected person is an intern or person who commutes to work by bus. \n\nTo estimate the probability of $I\\cup B,$ we\n\n- add up the numbers in the column **\"Intern\"** or the row **\"Bus\"**, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the column **\"Intern\"** or the row **\"Bus\"** are highlighted below.\n\n|  | Employee | Intern | Totals |\n| --- | --- | --- | --- |\n| Car | $24$ | $16$ | $40$ |\n| Bus | $26$ | $14$ | $40$ |\n| Totals | $50$ | $30$ | $80$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(80),$ we get\n\n$$\nP(I\\cup B)=\\frac{16+14+26}{80}=\\frac{56}{80}=0.70.\n$$" 13194139533864 true] [17592186260468 1000 #edb/ref 17592186260469 13194139533864 true] [17592186260468 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260468 1041 "answer" 13194139533864 true] [17592186260468 1104 #edb/ref 17592186260469 13194139533864 true] [17592186260468 1110 #uuid "743e6ede-3996-50f5-bcb2-0cea97ae3446" 13194139533864 true] [17592186260469 1034 "0.70" 13194139533864 true] [17592186260469 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260469 1111 #uuid "c16e723f-f101-552c-b2b0-a44b2c6fdb5a" 13194139533864 true] [17592186260470 1017 #edb/ref 17592186260471 13194139533864 true] [17592186260470 1089 "q-47274" 13194139533864 true] [17592186260470 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260470 1100 "Rounded to $3$ decimal places, find the value of $f(x)=2\\operatorname{log}(x)-4\\operatorname{log}(2x)$ at $x=4.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260470 1113 #uuid "10395e19-686b-58f5-b08a-69774a480eae" 13194139533864 true] [17592186260470 1145 "First, we replace $x=4$ and get:\n\n$$\n\\begin{aligned}f(4) & =2\\operatorname{log}(4)-4\\operatorname{log}(2\\cdot 4) \\\\  & =2\\operatorname{log}(4)-4\\operatorname{log}(8)\\end{aligned}\n$$\n\nWe compute the required value to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}f(4) & =2\\operatorname{log}(4)-4\\operatorname{log}(8) \\\\  & \\approx 2(0.602\\,060)-4(0.903\\,090) \\\\  & =1.204\\,120-3.612\\,360 \\\\  & =-2.408\\,240 \\\\  & \\approx -2.408\\end{aligned}\n$$" 13194139533864 true] [17592186260471 1000 #edb/ref 17592186260472 13194139533864 true] [17592186260471 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260471 1041 "answer" 13194139533864 true] [17592186260471 1104 #edb/ref 17592186260472 13194139533864 true] [17592186260471 1110 #uuid "c90c1f9c-f963-5c96-a354-804058c647dc" 13194139533864 true] [17592186260472 1034 "-2.408" 13194139533864 true] [17592186260472 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260472 1111 #uuid "dbb38578-339f-547d-a018-7c880ceec33c" 13194139533864 true] [17592186260473 1017 #edb/ref 17592186260474 13194139533864 true] [17592186260473 1089 "q-47299" 13194139533864 true] [17592186260473 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260473 1100 "Rose surveyed $168$ children in Arizona High School. She asked them about their favorite topics in math, between geometry and algebra. Her findings are summarized in the two-way frequency table below. \n\n|  | Geometry | Algebra | Totals |\n| --- | --- | --- | --- |\n| Girls | $28$ | $63$ | $91$ |\n| Boys | $56$ | $21$ | $77$ |\n| Totals | $84$ | $84$ | $168$ |\n\nLet $B$ be the event that a randomly selected child is a **\"Boy\"** and $G$ the event that a randomly selected child likes **\"Geometry\"**. Estimate $P(B\\cap G).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260473 1113 #uuid "75eedbd1-62f9-545d-b2b8-ed88a19bd586" 13194139533864 true] [17592186260473 1145 "First, note that $B\\cap G$ is the event that a randomly selected child is a boy and likes geometry. \n\nTo estimate the probability of $B\\cap G,$ we\n\n- find the number at the intersection of the row **\"Boys\"** and the column **\"Geometry\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Boys\"** and the column **\"Geometry\"** is highlighted in the table below.\n\n|  | Geometry | Algebra | Totals |\n| --- | --- | --- | --- |\n| Girls | $28$ | $63$ | $91$ |\n| Boys | $56$ | $21$ | $77$ |\n| Totals | $84$ | $84$ | $168$ |\n\nDividing by the total number of data points in the table $(168),$ we get\n\n$$\nP(B\\cap G)=\\frac{56}{168}=0.333.\n$$" 13194139533864 true] [17592186260474 1000 #edb/ref 17592186260475 13194139533864 true] [17592186260474 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260474 1041 "answer" 13194139533864 true] [17592186260474 1104 #edb/ref 17592186260475 13194139533864 true] [17592186260474 1110 #uuid "df64faa5-9c44-5a00-8262-d22fb90135ed" 13194139533864 true] [17592186260475 1034 "0.333" 13194139533864 true] [17592186260475 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260475 1111 #uuid "554bd0ac-14d9-5d7e-b6fa-9a9fbd6f80d5" 13194139533864 true] [17592186260476 1017 #edb/ref 17592186260477 13194139533864 true] [17592186260476 1089 "q-47306" 13194139533864 true] [17592186260476 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260476 1100 "A group of $5$th grade and $6$th grade students at Benjamin Franklin Elementary School are randomly selected for a survey. They are asked about their favorite places to go on summer vacations between the beach and the countryside. The results of this survey are summarized in the two-way frequency table below.\n\n|  | Beach | Countryside | Totals |\n| --- | --- | --- | --- |\n| $5$th grade | $55$ | $30$ | $85$ |\n| $6$th grade | $42$ | $33$ | $75$ |\n| Totals | $97$ | $63$ | $160$ |\n\nJohn Adams Elementary School has $250$ students in $5$th grade and $6$th grade. Assuming that the distribution of the results is the same in both elementary schools, estimate the number of students at John Adams Elementary School who are in $6$th grade or like to go to the beach on summer vacations (or both). Round your answer to the nearest integer.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260476 1113 #uuid "146b2ef3-9c02-5d19-b5a0-7ac41d8998b7" 13194139533864 true] [17592186260476 1145 "To estimate the number of students who are in $6$th grade or like to go to the beach on summer vacations, we\n\n- add up the numbers in the row **\"$6$th grade\"** or the column **\"Beach\"**, and then\n\n- divide by the total number of data points in the table.\n\n|  | Beach | Countryside | Totals |\n| --- | --- | --- | --- |\n| $5$th grade | $55$ | $30$ | $85$ |\n| $6$th grade | $42$ | $33$ | $75$ |\n| Totals | $97$ | $63$ | $160$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(160),$ we get\n\n$$\np=\\frac{55+42+33}{160}=\\frac{130}{160}=0.81.\n$$\n\nThis represents the estimated probability that a randomly selected student is in $6$th grade or likes to go to the beach on summer vacations.\n\nFinally, to find the estimated number of students of John Adams Elementary School who are in $6$th grade or like to go to the beach on summer vacations, we multiply the total number of students in the school $(250)$ by the probability above:\n\n$$\n\\begin{aligned}n & =250\\cdot p \\\\  & =250\\cdot 0.81 \\\\  & =202.5 \\\\  & =203,\\end{aligned}\n$$\n\nrounded to the nearest integer." 13194139533864 true] [17592186260477 1000 #edb/ref 17592186260478 13194139533864 true] [17592186260477 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260477 1041 "answer" 13194139533864 true] [17592186260477 1104 #edb/ref 17592186260478 13194139533864 true] [17592186260477 1110 #uuid "93ca5f3b-ab39-53ed-8854-3d49571cdace" 13194139533864 true] [17592186260478 1034 "203" 13194139533864 true] [17592186260478 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260478 1111 #uuid "ddcdc7a1-98ce-5f26-a400-e2c7ecdb290f" 13194139533864 true] [17592186260479 1017 #edb/ref 17592186260480 13194139533864 true] [17592186260479 1089 "q-47307" 13194139533864 true] [17592186260479 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260479 1100 "A group of randomly selected students from Chicago High School was asked which country they want to visit between Brazil, Spain, France, or Japan. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Brazil | Spain | France | Japan | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $12$ | $20$ | $9$ | $14$ | $55$ |\n| Boys | $14$ | $10$ | $20$ | $1$ | $45$ |\n| Totals | $26$ | $30$ | $29$ | $15$ | $100$ |\n\nBoston High School has $400$ students. Assuming that the distribution of the results is the same in both high schools, estimate the number of girls at Boston High School who wish to visit Brazil or France. Round your answer to the nearest integer.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260479 1113 #uuid "3636bb28-36be-554b-b1a3-2ece301c26d0" 13194139533864 true] [17592186260479 1145 "To estimate the number of girls who wish to visit Brazil or France, we\n\n- add up the numbers in the intersection of the row **\"Girls\"** and the column **\"Brazil\"** and the intersection of the row **\"Girls\"** and the column **\"France\"**, and then\n\n- divide by the total number of data points in the table.\n\n|  | Brazil | Spain | France | Japan | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $12$ | $20$ | $9$ | $14$ | $55$ |\n| Boys | $14$ | $10$ | $20$ | $1$ | $45$ |\n| Totals | $26$ | $30$ | $29$ | $15$ | $100$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(100),$ we get\n\n$$\np=\\frac{12+9}{100}=\\frac{21}{100}=0.21.\n$$\n\nThis represents the estimated probability that a randomly selected student is a girl who wishes to visit Brazil or France.\n\nFinally, to find the estimated number of girls of Boston High School who wish to visit Brazil or France, we multiply the total number of students in Boston High School $(400)$ by the probability above:\n\n$$\n\\begin{aligned}n & =400\\cdot p \\\\  & =400\\cdot 0.21 \\\\  & =84\\end{aligned}\n$$" 13194139533864 true] [17592186260480 1000 #edb/ref 17592186260481 13194139533864 true] [17592186260480 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260480 1041 "answer" 13194139533864 true] [17592186260480 1104 #edb/ref 17592186260481 13194139533864 true] [17592186260480 1110 #uuid "e1976e7b-5e56-5bf2-a749-123a4c7460f8" 13194139533864 true] [17592186260481 1034 "84" 13194139533864 true] [17592186260481 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260481 1111 #uuid "554267c3-b36b-53f1-96ea-a70a14233d73" 13194139533864 true] [17592186260482 1017 #edb/ref 17592186260483 13194139533864 true] [17592186260482 1089 "q-4740" 13194139533864 true] [17592186260482 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260482 1100 "${lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260482 1113 #uuid "0f5c87b7-966d-5648-9ab0-7c2badd23d66" 13194139533864 true] [17592186260482 1145 "First, we let\n\n$$\nL={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{'}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h}.\n$$\n\nWe see that if we let $f(x)={e}^{x}$ and $a=2$, we get\n\n$$\n\\begin{aligned}{f}^{'}(2) & ={lim}_{h\\to 0}\\frac{f(2+h)-f(2)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{'}(2).$ \n\nComputing the derivative, we have\n \n\n$$\n{f}^{'}(x)={e}^{x},\\,{f}^{'}(2)={e}^{2},\n$$\n\nand therefore we conclude tha $L={e}^{2}.$" 13194139533864 true] [17592186260483 1000 #edb/ref 17592186260484 13194139533864 true] [17592186260483 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260483 1041 "answer" 13194139533864 true] [17592186260483 1104 #edb/ref 17592186260484 13194139533864 true] [17592186260483 1110 #uuid "421c64e4-125b-5b7a-8648-b1ea40c681eb" 13194139533864 true] [17592186260484 1034 "{e}^{2}" 13194139533864 true] [17592186260484 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260484 1111 #uuid "15ad9b56-c4cd-59b1-b815-fd12c6966090" 13194139533864 true] [17592186260485 1017 #edb/ref 17592186260486 13194139533864 true] [17592186260485 1089 "q-47405" 13194139533864 true] [17592186260485 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260485 1100 "The equation of the normal line to the curve $y=2{x}^{3}$ at the point $(2,16)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $q-p.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260485 1113 #uuid "2dd83d18-2e82-5500-9a29-406ec35162d7" 13194139533864 true] [17592186260485 1145 "Let $f(x)=2{x}^{3}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3})=6{x}^{2}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,16):$\n\n$$\n\\begin{aligned}m={f}^{'}(2)=6(2)^{2}=24\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{'}$ is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{24}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(16) & =-\\frac{1}{24}(x-(2)) \\\\ 24y-384 & =-x+2 \\\\ x+24y & =386.\\end{aligned}\n$$\n\nTherefore, $q-p=386-24=362.$" 13194139533864 true] [17592186260486 1000 #edb/ref 17592186260487 13194139533864 true] [17592186260486 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260486 1041 "answer" 13194139533864 true] [17592186260486 1104 #edb/ref 17592186260487 13194139533864 true] [17592186260486 1110 #uuid "4d2e2314-4883-5c9a-a3d2-ba10b8b0172d" 13194139533864 true] [17592186260487 1034 "362" 13194139533864 true] [17592186260487 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260487 1111 #uuid "520a9952-36d1-5b28-9d1a-d3da42f14a77" 13194139533864 true] [17592186260488 1017 #edb/ref 17592186260489 13194139533864 true] [17592186260488 1089 "q-47447" 13194139533864 true] [17592186260488 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260488 1100 "If $P(x)$ and $Q(x)$ are polynomials of degree $3$ and $7,$ respectively, which of the following statements are true?\n\nI. - $P+Q$ is always a polynomial of degree $10$\nII. - $P-Q$ is always a polynomial of degree $4$\nIII. - $P\\cdot Q$ is always a polynomial of degree $10$" 13194139533864 true] [17592186260488 1113 #uuid "4c510ba2-7634-5ceb-8cb3-a5b35044f36d" 13194139533864 true] [17592186260488 1145 "Let's look at each statement in turn.\n\n- Statement I is false. For example, suppose $P(x)={x}^{3}$ and $Q(x)={x}^{7}.$ Then $P+Q={x}^{3}+{x}^{7},$ which is not a polynomial of degree $10.$\n\n- Statement II is false. For example, suppose $P(x)={x}^{3}$ and $Q(x)={x}^{7}.$ Then $P-Q={x}^{3}-{x}^{7},$ which is not a polynomial of degree $4.$\n\n- Statement III is true. The highest-degree terms in $P$ and $Q$ must contain ${x}^{3}$ and ${x}^{7},$ respectively. Therefore, the highest-degree term in $P\\cdot Q$ must contain ${x}^{3}\\cdot {x}^{7}={x}^{3+7}={x}^{10},$ meaning that $P\\cdot Q$ has degree $10.$\n\nIn conclusion, only statement III is true." 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260490 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260491 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260492 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260493 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260494 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260495 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260496 13194139533864 true] [17592186260489 1000 #edb/ref 17592186260497 13194139533864 true] [17592186260489 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260489 1041 "selection" 13194139533864 true] [17592186260489 1104 #edb/ref 17592186260494 13194139533864 true] [17592186260489 1110 #uuid "71f95d56-7ec8-583a-a3ec-79cbc7ddc998" 13194139533864 true] [17592186260490 1034 "I, II, and III" 13194139533864 true] [17592186260490 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260490 1111 #uuid "ebf2e9d7-31ca-5d03-bbcb-392994bc39ac" 13194139533864 true] [17592186260491 1034 "II and III only" 13194139533864 true] [17592186260491 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260491 1111 #uuid "063a9d47-c2f3-5ee8-888d-19388957813d" 13194139533864 true] [17592186260492 1034 "I and III only" 13194139533864 true] [17592186260492 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260492 1111 #uuid "354dfa5c-933f-56e0-b784-e3778f7b0c95" 13194139533864 true] [17592186260493 1034 "I only" 13194139533864 true] [17592186260493 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260493 1111 #uuid "5f4242d4-2b03-5e93-8f4c-e52fbd49c565" 13194139533864 true] [17592186260494 1034 "III only" 13194139533864 true] [17592186260494 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260494 1111 #uuid "ff96f702-8d09-5553-8e60-afeac0d3cb05" 13194139533864 true] [17592186260495 1034 "I and II only" 13194139533864 true] [17592186260495 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260495 1111 #uuid "efb3abad-5ae7-5dde-8f68-1f4ed8247a31" 13194139533864 true] [17592186260496 1034 "None of those listed" 13194139533864 true] [17592186260496 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260496 1111 #uuid "7342fdd3-89f9-5282-9690-bc9b44b19fbb" 13194139533864 true] [17592186260497 1034 "II only" 13194139533864 true] [17592186260497 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260497 1111 #uuid "7f067afb-9173-5325-99a3-8593dd6e211c" 13194139533864 true] [17592186260498 1017 #edb/ref 17592186260499 13194139533864 true] [17592186260498 1089 "q-47501" 13194139533864 true] [17592186260498 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260498 1100 "Anna decides to go jogging. Her position from the starting point, measured in meters, is given by the function $s(t),$ where $t$ is the time in seconds. The values of $s(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $s(t)$ | $1$ | $2$ | $4$ | $6$ | $14$ | $25$ |\n\n$$\n\n$$\n\nApproximate the velocity ${s}^{'}(t)$ at the point $t=7$ using a central difference approximation with the step size $h=2.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260498 1113 #uuid "2d36af06-fd0d-5636-867c-cb4b4f9d9cb6" 13194139533864 true] [17592186260498 1145 "We use the central difference approximation\n\n$$\n{s}^{'}(t)\\approx \\frac{s(t+h)-s(t-h)}{2h},\n$$\n\n \nat the time $t=7$ with step size $h=2.$ This gives\n\n$$\n\\begin{aligned}{s}^{'}(7) & \\approx \\frac{s(7+2)-s(7-2)}{2(2)} \\\\  & =\\frac{s(9)-s(5)}{2(2)} \\\\  & =\\frac{14-4}{4} \\\\  & =\\frac{10}{4} \\\\  & =2.5.\\end{aligned}\n$$\n\nThus, the velocity of Anna at the instant of time $t=7$ is $2.5\\,\\text{m}/\\text{s}.$" 13194139533864 true] [17592186260499 1000 #edb/ref 17592186260500 13194139533864 true] [17592186260499 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260499 1041 "answer" 13194139533864 true] [17592186260499 1104 #edb/ref 17592186260500 13194139533864 true] [17592186260499 1110 #uuid "42278b6f-a1bb-522a-bbf0-f5ce4a6360f8" 13194139533864 true] [17592186260500 1034 "2.5\\,\\text{m}/\\text{s}" 13194139533864 true] [17592186260500 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260500 1111 #uuid "b451fb31-a88a-5335-b989-3f4311200413" 13194139533864 true] [17592186260501 1017 #edb/ref 17592186260502 13194139533864 true] [17592186260501 1089 "q-47520" 13194139533864 true] [17592186260501 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260501 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3bb1c35edab6cecb8bdc0021b7d931c4a8284d02385c0d2398e0b3ca4fb473c0.png)\n\nWhich of the following statements are true regarding the function $f(x)$ plotted above?\n\nI. - The function is left-continuous at $x=0$\nII. - The function is right-continuous at $x=0$\nIII. - The function is continuous at $x=0$" 13194139533864 true] [17592186260501 1113 #uuid "8029b517-cfed-599d-a293-d42c50744670" 13194139533864 true] [17592186260501 1145 "Let's look at each statement in turn:\n\n- Statement I is true. The function is left-continuous at $x=0,$ since the left-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{-}}f(x)=0=f(0)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=0,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=1\\ne 0=f(0)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not right-continuous at this point.\n\nIn conclusion, only statement I is true." 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260503 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260504 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260505 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260506 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260507 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260508 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260509 13194139533864 true] [17592186260502 1000 #edb/ref 17592186260510 13194139533864 true] [17592186260502 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260502 1041 "selection" 13194139533864 true] [17592186260502 1104 #edb/ref 17592186260506 13194139533864 true] [17592186260502 1110 #uuid "4546afc4-5ede-5282-82c2-2149674417a0" 13194139533864 true] [17592186260503 1034 "I, II, and III" 13194139533864 true] [17592186260503 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260503 1111 #uuid "ad21724d-e6e8-5043-b9d8-2acf6ddcc615" 13194139533864 true] [17592186260504 1034 "II and III only" 13194139533864 true] [17592186260504 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260504 1111 #uuid "03f8ebf2-c952-5934-a775-da2d2f676039" 13194139533864 true] [17592186260505 1034 "I and III only" 13194139533864 true] [17592186260505 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260505 1111 #uuid "da5461dd-41c1-5e2f-8f1f-2660d57e5348" 13194139533864 true] [17592186260506 1034 "I only" 13194139533864 true] [17592186260506 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260506 1111 #uuid "96a94397-5062-5d2c-9777-42904783f519" 13194139533864 true] [17592186260507 1034 "III only" 13194139533864 true] [17592186260507 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260507 1111 #uuid "edcb216f-70e1-57f5-a503-0024f4c3a53b" 13194139533864 true] [17592186260508 1034 "I and II only" 13194139533864 true] [17592186260508 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260508 1111 #uuid "6d340422-abf5-5da9-8220-7695f2bc70a0" 13194139533864 true] [17592186260509 1034 "None of those listed" 13194139533864 true] [17592186260509 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260509 1111 #uuid "77742dde-dc9f-5bfd-887f-b5a25604d260" 13194139533864 true] [17592186260510 1034 "II only" 13194139533864 true] [17592186260510 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260510 1111 #uuid "13e81348-444c-5b9f-b19f-580e1444d765" 13194139533864 true] [17592186260511 1017 #edb/ref 17592186260512 13194139533864 true] [17592186260511 1089 "q-47777" 13194139533864 true] [17592186260511 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260511 1100 "What's the domain of $y={log}_{3}x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260511 1113 #uuid "1a14db00-97f9-5ed3-bfa8-49652c2e587c" 13194139533864 true] [17592186260511 1145 "Let's recall the graph of $y={log}_{3}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/c1b7274ff6a0887efcaa27bc44db67934d425c0ca83a19fc761a2cccc72436f6.png)\n\nThe domain of $y={log}_{3}x$ is $x\\in (0,\\infty )$ and the range is $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the correct answer is $x>0.$" 13194139533864 true] [17592186260512 1000 #edb/ref 17592186260513 13194139533864 true] [17592186260512 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260512 1041 "answer" 13194139533864 true] [17592186260512 1104 #edb/ref 17592186260513 13194139533864 true] [17592186260512 1110 #uuid "cc180485-bcef-5fce-9ffe-383cead88d7f" 13194139533864 true] [17592186260513 1034 "x>0" 13194139533864 true] [17592186260513 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260513 1111 #uuid "6a9aca8c-8551-54d8-b548-b466a4d34126" 13194139533864 true] [17592186260514 1017 #edb/ref 17592186260515 13194139533864 true] [17592186260514 1089 "q-47778" 13194139533864 true] [17592186260514 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260514 1100 "What's the range of $f(x)={log}_{9}x?$\n\nAnswer: {{answer}}\n\nUse an interval in words, such as \"All real numbers\"." 13194139533864 true] [17592186260514 1113 #uuid "f7b6a962-a925-5eb4-8eb3-c093275b7ef1" 13194139533864 true] [17592186260514 1145 "Let's recall the graph of $y={log}_{9}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/40664f83ba162a93ed06970798d37798db90b85c21d44a9ed20f338df4e1b4e1.png)\n\nThe domain of $y={log}_{9}x$ is $x\\in (0,\\infty )$ and the range is $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"All real numbers.\"" 13194139533864 true] [17592186260515 1000 #edb/ref 17592186260516 13194139533864 true] [17592186260515 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260515 1041 "answer" 13194139533864 true] [17592186260515 1104 #edb/ref 17592186260516 13194139533864 true] [17592186260515 1110 #uuid "82c34cd0-ab73-5aef-b587-d37f07c81adf" 13194139533864 true] [17592186260516 1034 "All real numbers" 13194139533864 true] [17592186260516 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260516 1111 #uuid "6574fd45-455a-5ce6-8ad8-68abbf105320" 13194139533864 true] [17592186260517 1017 #edb/ref 17592186260518 13194139533864 true] [17592186260517 1089 "q-47831" 13194139533864 true] [17592186260517 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260517 1100 "Find $\\frac{\\text{d}y}{\\text{d}x}$ when $y=\\frac{1}{\\sqrt[5]{{x}^{2}}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260517 1113 #uuid "96ce1d20-ba3f-5b49-92db-85f90f4852cb" 13194139533864 true] [17592186260517 1145 "Writing the radical as a rational exponent, we have\n\n$$\ny=\\frac{1}{\\sqrt[5]{{x}^{2}}}=\\frac{1}{{x}^{2/5}}={x}^{-2/5}\n$$\n\nApplying the power rule with $n=-\\frac{2}{5},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-2/5}) \\\\  & =-\\frac{2}{5}{x}^{-2/5-1} \\\\  & =-\\frac{2}{5}{x}^{-7/5} \\\\  & =-\\frac{2}{5{x}^{7/5}} \\\\  & =-\\frac{2}{5\\sqrt[5]{{x}^{7}}}.\\end{aligned}\n$$" 13194139533864 true] [17592186260518 1000 #edb/ref 17592186260519 13194139533864 true] [17592186260518 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260518 1041 "answer" 13194139533864 true] [17592186260518 1104 #edb/ref 17592186260519 13194139533864 true] [17592186260518 1110 #uuid "af055912-09b5-510f-9530-acedd1ad3056" 13194139533864 true] [17592186260519 1034 "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" 13194139533864 true] [17592186260519 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260519 1111 #uuid "e9fbcfcc-769d-5e6a-bea4-0b62fcbde775" 13194139533864 true] [17592186260520 1017 #edb/ref 17592186260521 13194139533864 true] [17592186260520 1089 "q-47989" 13194139533864 true] [17592186260520 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260520 1100 "If $f(x)=-\\operatorname{sin}(3x)+3,$ find ${({f}^{-1})}^{'}(x)$ as a function of ${f}^{-1}(x).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260520 1113 #uuid "ace057fc-f27d-5e1a-9af6-15a230a30edb" 13194139533864 true] [17592186260520 1145 "**Step 1:** First, we write the inverse function implicitly. The given function is $y=-\\operatorname{sin}(3x)+3,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=-\\operatorname{sin}(3y)+3\n$$\n\nNote that in the equation above, we have $y={f}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\operatorname{sin}(3y)+3) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-\\operatorname{cos}(3y)\\cdot 3 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-3\\operatorname{cos}(3y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{3\\operatorname{cos}(3y)} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\operatorname{sec}(3y)}{3}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =-\\frac{\\operatorname{sec}(3{f}^{-1}(x))}{3} \\\\ {({f}^{-1})}^{'}(x) & =-\\frac{\\operatorname{sec}(3{f}^{-1}(x))}{3}.\\end{aligned}\n$$" 13194139533864 true] [17592186260521 1000 #edb/ref 17592186260522 13194139533864 true] [17592186260521 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260521 1041 "answer" 13194139533864 true] [17592186260521 1104 #edb/ref 17592186260522 13194139533864 true] [17592186260521 1110 #uuid "be866a01-6949-54da-bbbb-634e3f6bec6d" 13194139533864 true] [17592186260522 1034 "-\\frac{\\operatorname{sec}(3{f}^{-1}(x))}{3}" 13194139533864 true] [17592186260522 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260522 1111 #uuid "c1d0ecf3-5468-5f38-9a7e-05e3641260a0" 13194139533864 true] [17592186260523 1017 #edb/ref 17592186260524 13194139533864 true] [17592186260523 1089 "q-48001" 13194139533864 true] [17592186260523 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260523 1100 "Find ${f}^{'}(x)$ for $f(x)={log}_{2}(3-2x).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260523 1113 #uuid "b3309e93-f137-593e-870a-4ed35e0bd925" 13194139533864 true] [17592186260523 1145 "First, we express $f(x)$ as the composite function\n\n$$\n{f}^{'}(x)={log}_{2}(u),\\,u=3-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u\\operatorname{ln}(2)},\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u\\operatorname{ln}(2)}\\cdot (-2) \\\\  & =\\frac{1}{(3-2x)\\operatorname{ln}(2)}\\cdot (-2) \\\\  & =-\\frac{2}{(3-2x)\\operatorname{ln}(2)}.\\end{aligned}\n$$" 13194139533864 true] [17592186260524 1000 #edb/ref 17592186260525 13194139533864 true] [17592186260524 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260524 1041 "answer" 13194139533864 true] [17592186260524 1104 #edb/ref 17592186260525 13194139533864 true] [17592186260524 1110 #uuid "ca1fdebe-70c6-5790-9a73-2e4d504ef086" 13194139533864 true] [17592186260525 1034 "-\\frac{2}{(3-2x)\\operatorname{ln}(2)}" 13194139533864 true] [17592186260525 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260525 1111 #uuid "9760e85b-5c83-50d7-aa61-a02b48c4fe40" 13194139533864 true] [17592186260526 1017 #edb/ref 17592186260527 13194139533864 true] [17592186260526 1089 "q-48003" 13194139533864 true] [17592186260526 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260526 1100 "Given that $y=-3{e}^{5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260526 1113 #uuid "18ca2967-70f1-50fc-adb1-d5ade712f567" 13194139533864 true] [17592186260526 1145 "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$" 13194139533864 true] [17592186260527 1000 #edb/ref 17592186260528 13194139533864 true] [17592186260527 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260527 1041 "answer" 13194139533864 true] [17592186260527 1104 #edb/ref 17592186260528 13194139533864 true] [17592186260527 1110 #uuid "52ce8ef2-2546-598b-876b-32e5d642c3bc" 13194139533864 true] [17592186260528 1034 "3{e}^{5-x}" 13194139533864 true] [17592186260528 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260528 1111 #uuid "5288b2ef-28bd-5248-a23b-3168a47dadcf" 13194139533864 true] [17592186260529 1017 #edb/ref 17592186260530 13194139533864 true] [17592186260529 1089 "q-48063" 13194139533864 true] [17592186260529 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260529 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/f5ba5f7cc2ea5aaf405db1abff7e6f28ed4378ba6a5ec88d73c6861ede1d75de.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. - $f(x)$ is defined at $x=2$\nII. - ${lim}_{x\\to \\,{2}^{-}}f(x)$ exists\nIII. - $f(x)$ is continuous at $x=2$" 13194139533864 true] [17592186260529 1113 #uuid "56d623d9-78f0-5f10-8521-99d9ec2fc8e8" 13194139533864 true] [17592186260529 1145 "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(2)=1.$\n\n- Statement II is true. Indeed, \n${lim}_{x\\to \\,{2}^{-}}f(x)=3.$\n\n- Statement III is false. The graph of $f(x)$ breaks at $x=2$,  it's impossible to draw the graph without taking our pencil off of the paper." 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260531 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260532 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260533 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260534 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260535 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260536 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260537 13194139533864 true] [17592186260530 1000 #edb/ref 17592186260538 13194139533864 true] [17592186260530 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260530 1041 "selection" 13194139533864 true] [17592186260530 1104 #edb/ref 17592186260536 13194139533864 true] [17592186260530 1110 #uuid "ac779f9e-c0a9-531b-b21a-ca5587c63114" 13194139533864 true] [17592186260531 1034 "I, II, and III" 13194139533864 true] [17592186260531 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260531 1111 #uuid "b9c5c917-cd9a-5116-977a-f13e8461778d" 13194139533864 true] [17592186260532 1034 "II and III only" 13194139533864 true] [17592186260532 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260532 1111 #uuid "cb2ad4e6-a361-5f9f-afac-1dbed637a8d9" 13194139533864 true] [17592186260533 1034 "I and III only" 13194139533864 true] [17592186260533 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260533 1111 #uuid "6f0521a6-cb41-51e5-98d9-bd0a4835723b" 13194139533864 true] [17592186260534 1034 "I only" 13194139533864 true] [17592186260534 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260534 1111 #uuid "2fb5de3c-2a0f-5ffc-bb2d-47e383c8020a" 13194139533864 true] [17592186260535 1034 "III only" 13194139533864 true] [17592186260535 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260535 1111 #uuid "00c33181-3288-5ae5-8ba3-6a6e11b11119" 13194139533864 true] [17592186260536 1034 "I and II only" 13194139533864 true] [17592186260536 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260536 1111 #uuid "b595ea90-16a9-5607-b40c-a6b2148a8777" 13194139533864 true] [17592186260537 1034 "None of those listed" 13194139533864 true] [17592186260537 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260537 1111 #uuid "58bfed97-d29c-5d97-afdb-29266e0fe8d2" 13194139533864 true] [17592186260538 1034 "II only" 13194139533864 true] [17592186260538 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260538 1111 #uuid "469095ff-9ad6-5993-92ea-1f7061e39341" 13194139533864 true] [17592186260539 1017 #edb/ref 17592186260540 13194139533864 true] [17592186260539 1089 "q-48208" 13194139533864 true] [17592186260539 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260539 1100 "Evaluate ${lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}x}{{e}^{x}}+7).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260539 1113 #uuid "3187ea03-2a2b-58df-8eac-de1e0d9676e0" 13194139533864 true] [17592186260539 1145 "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{x}≫\\operatorname{ln}x$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}x}{{e}^{x}}=0.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}x}{{e}^{x}}+7)=0+7=7.\n$$" 13194139533864 true] [17592186260540 1000 #edb/ref 17592186260541 13194139533864 true] [17592186260540 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260540 1041 "answer" 13194139533864 true] [17592186260540 1104 #edb/ref 17592186260541 13194139533864 true] [17592186260540 1110 #uuid "173daa7b-200e-5db0-a98f-a4d6280ca3f2" 13194139533864 true] [17592186260541 1034 "7" 13194139533864 true] [17592186260541 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260541 1111 #uuid "4384c527-a3e2-5dee-a56c-d7db6110ce47" 13194139533864 true] [17592186260542 1017 #edb/ref 17592186260543 13194139533864 true] [17592186260542 1089 "q-48216" 13194139533864 true] [17592186260542 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260542 1100 "Evaluate ${lim}_{x\\to \\infty }\\frac{\\operatorname{ln}x}{3x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260542 1113 #uuid "be4b5477-1b23-5f88-be13-f138d6d0f412" 13194139533864 true] [17592186260542 1145 "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since $3x≫\\operatorname{ln}x$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}x}{3x}=0.\n$$" 13194139533864 true] [17592186260543 1000 #edb/ref 17592186260544 13194139533864 true] [17592186260543 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260543 1041 "answer" 13194139533864 true] [17592186260543 1104 #edb/ref 17592186260544 13194139533864 true] [17592186260543 1110 #uuid "491ab714-6bce-5018-a106-c09c06b2cb82" 13194139533864 true] [17592186260544 1034 "0" 13194139533864 true] [17592186260544 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260544 1111 #uuid "99cf18cd-d6f1-5c96-9586-f2af15c7606c" 13194139533864 true] [17592186260545 1017 #edb/ref 17592186260546 13194139533864 true] [17592186260545 1089 "q-48219" 13194139533864 true] [17592186260545 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260545 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/f00b1960549affb287d1120ba43639c047bb5ad419e7a172063b8d9ce514e3e5.png)\n\nAt which points is the function $y=f(x)$ above left-continuous but is not continuous?\n\n$x$: {{x}}" 13194139533864 true] [17592186260545 1113 #uuid "4650e469-b715-5b14-be32-6211971fc986" 13194139533864 true] [17592186260545 1145 "To determine whether $f(x)$ is left-continuous at $x=c,$ we need to check whether the left-sided limit is equal to the function value.\n\nLet's check this for $x=-2$, at $x=1$ and at  $x=2.$\n\n- At $x=-2$ the function is not left-continuous because it's undefined at this point.\n\n- At $x=1$ the function is left-continuous because\n\n$$\n{lim}_{x\\to \\,{1}^{-}}f(x)=4=f(1).\n$$\n\n- At $x=2$ the function is not left-continuous because \n\n$$\n{lim}_{x\\to \\,{2}^{-}}f(x)=0\\ne 2=f(2).\n$$\n\nTherefore, the correct answer is $x=1$ only." 13194139533864 true] [17592186260546 1000 #edb/ref 17592186260547 13194139533864 true] [17592186260546 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260546 1041 "x" 13194139533864 true] [17592186260546 1104 #edb/ref 17592186260547 13194139533864 true] [17592186260546 1110 #uuid "be62c019-6d99-591d-a6a4-a1f610dc4692" 13194139533864 true] [17592186260547 1034 "1" 13194139533864 true] [17592186260547 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260547 1111 #uuid "027ed59a-c2bc-5f6e-9339-e71cc5646ad2" 13194139533864 true] [17592186260548 1017 #edb/ref 17592186260549 13194139533864 true] [17592186260548 1089 "q-48221" 13194139533864 true] [17592186260548 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260548 1100 "Evaluate ${lim}_{x\\to \\infty }x{e}^{-2x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260548 1113 #uuid "5c4a4a0b-e1a5-5f41-82c8-6f7ce8f75158" 13194139533864 true] [17592186260548 1145 "Notice that we can rewrite the given expression as\n\n$$\nx{e}^{-2x}=\\frac{x}{{e}^{2x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{2x}≫x$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }x{e}^{-2x}={lim}_{x\\to \\infty }\\frac{x}{{e}^{2x}}=0.\n$$" 13194139533864 true] [17592186260549 1000 #edb/ref 17592186260550 13194139533864 true] [17592186260549 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260549 1041 "answer" 13194139533864 true] [17592186260549 1104 #edb/ref 17592186260550 13194139533864 true] [17592186260549 1110 #uuid "699c09d3-0aa4-5110-9ac4-f1705eebb66d" 13194139533864 true] [17592186260550 1034 "0" 13194139533864 true] [17592186260550 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260550 1111 #uuid "268d2a23-f9fc-5723-8101-b984f9a1d733" 13194139533864 true] [17592186260551 1017 #edb/ref 17592186260552 13194139533864 true] [17592186260551 1089 "q-4825" 13194139533864 true] [17592186260551 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260551 1100 "Given $f(x)=2{x}^{2}+5x$ and $g(x)=9-2x,$ find $(fg)(-1).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260551 1113 #uuid "bd6a8a55-36de-5b05-883a-a794caef72c2" 13194139533864 true] [17592186260551 1145 "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-1),$ we find $f(-1)$ and $g(-1),$ and then multiply the results.\n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =2(-1)^{2}+5(-1)=-3 \\\\ g(-1) & =9-2(-1)=11\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-1)=f(-1)g(-1)=-3\\cdot 11=-33\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(2{x}^{2}+5x)(9-2x) \\\\  & =-4{x}^{3}+8{x}^{2}+45x\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(-1):$ \n\n$$\n\\begin{aligned}(fg)(-1) & =-4(-1)^{3}+8(-1)^{2}+45(-1) \\\\  & =4+8-45 \\\\  & =-33\\end{aligned}\n$$" 13194139533864 true] [17592186260552 1000 #edb/ref 17592186260553 13194139533864 true] [17592186260552 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260552 1041 "answer" 13194139533864 true] [17592186260552 1104 #edb/ref 17592186260553 13194139533864 true] [17592186260552 1110 #uuid "178b3ae7-011a-542f-917e-72857a90aa25" 13194139533864 true] [17592186260553 1034 "-33" 13194139533864 true] [17592186260553 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260553 1111 #uuid "f84ad872-89b4-594c-b109-88bee658a266" 13194139533864 true] [17592186260554 1017 #edb/ref 17592186260555 13194139533864 true] [17592186260554 1089 "q-48508" 13194139533864 true] [17592186260554 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260554 1100 "Find the equation of the tangent to the curve $y = \\cos (5x-2 )$ at the point $\\left(\\dfrac 2 5,1\\right).$\n\n$y =$: {{y}}" 13194139533864 true] [17592186260554 1113 #uuid "a9b3f537-d998-5b44-ac6e-d3ede45445e6" 13194139533864 true] [17592186260554 1145 "The slope of $y = f(x)$ at $x=\\dfrac 2 5$ is given by $f'\\left(\\dfrac 2 5\\right).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\cos{u}, \\qquad u = 5x-2.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -\\sin u \\qquad \\style{font-family:inherit;}{\\text{and}} \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = 5.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\nf'(x) &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-\\sin u \\cdot 5\\\\[5pt]\n&=-5\\sin u\\\\[5pt]\n&= -5\\sin\\left(5x-2 \\right).\n\\end{align*}\n\nEvaluating at $x=\\dfrac 25,$ we find\n\n\\begin{eqnarray}\n \\eqalign{\n\nm=f'\\left(\\dfrac 25\\right)  & =- 5 \\sin \\left(5\\cdot \\dfrac 2 5-2\\right)\\\\[5pt] \n\t\t& =- 5 \\sin 0\\\\[5pt]\n\t\t&= 0.\n \n       \n    }\n\\end{eqnarray}\nFinally, we find the equation of the tangent at the point $\\left(\\dfrac 2 5,1\\right) \\mathbin{:}$\n\n\\begin{align*}\ny-y_1&=m(x-x_1)\\\\[5pt]\ny-1&=0\\left(x-\\dfrac{2}{5}\\right)\\\\[5pt]\ny-1&=0\\\\[5pt]\ny&=1.\n\\end{align*}" 13194139533864 true] [17592186260555 1000 #edb/ref 17592186260556 13194139533864 true] [17592186260555 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260555 1041 "y" 13194139533864 true] [17592186260555 1104 #edb/ref 17592186260556 13194139533864 true] [17592186260555 1110 #uuid "1a7c8e57-06af-5956-8bd8-c3cc75ad39ab" 13194139533864 true] [17592186260556 1034 "1" 13194139533864 true] [17592186260556 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260556 1111 #uuid "a075da18-342a-549a-b681-746e39c6bd3e" 13194139533864 true] [17592186260557 1017 #edb/ref 17592186260558 13194139533864 true] [17592186260557 1089 "q-48510" 13194139533864 true] [17592186260557 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260557 1100 "Find the equation of the tangent to the curve $y=\\sec(3x)-2x$ at the point $\\left(0,1\\right).$\n\n$y =$: {{y}}" 13194139533864 true] [17592186260557 1113 #uuid "5d322c8f-a329-5374-8649-0dbb3acf87eb" 13194139533864 true] [17592186260557 1145 "Let $g(x)=\\sec(3x )$ and $h(x)=-2x.$ Then,\n\n\\begin{align}\nf(x)&=g(x)+h(x) . \n\\end{align}\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\sec(3x)$ as the composite function\n\\[\ng = \\sec u, \\qquad u = 3x.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d g}{\\textrm d u} = \\sec u \\tan u \\qquad \\text{and} \\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = 3.\n\\]\n\nWe now apply the chain rule, and we get\n\\[\n\t\\eqalign{\n\\require{cancel}\n\t\t\t\\dfrac{\\textrm{d}g}{\\textrm{d}x}&=\\dfrac{\\textrm{d}g}{\\textrm{d}u}\\cdot \\dfrac{\\textrm{d}u}{\\textrm{d}x}\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=\\sec u \\tan u \\cdot (3)\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=3 \\sec u \\tan u\\\\[5pt]\n                                                                        & =3\\sec (3x) \\tan (3x)\n}\n\n\\]\n\nNext, we differentiate $h(x)=-2x.$ \n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d h}{\\textrm d x} = -2\n\\]\n\nHence,\n\\[f'(x)=g'(x)+h'(x)=3\\sec (3x) \\tan (3x) -2.\\]\n\nEvaluating at $x=0,$ we find\n\n\\begin{align*}\nm=f'(0) & =3\\sec\\left(3\\cdot 0\\right)\\tan\\left(3\\cdot 0\\right) -2\\\\[3pt]\n\t& =3\\sec 0\\tan 0 -2\\\\[3pt]\n\t& =3\\cdot 1\\cdot 0 - 2\\\\[3pt]\n\t&=-2.       \n\\end{align*}\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\n\\begin{align}\ny-y_1&=m(x-x_1)\\\\[3pt]\ny-1&=-2 \\left(x-0 \\right)\\\\[3pt]\ny-1&=-2x\\\\[3pt]\ny&=-2x+1.\n\\end{align}" 13194139533864 true] [17592186260558 1000 #edb/ref 17592186260559 13194139533864 true] [17592186260558 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260558 1041 "y" 13194139533864 true] [17592186260558 1104 #edb/ref 17592186260559 13194139533864 true] [17592186260558 1110 #uuid "d6b0012d-1ca0-501f-b7be-a230702e57a1" 13194139533864 true] [17592186260559 1034 "-2x+1" 13194139533864 true] [17592186260559 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260559 1111 #uuid "7d0edba3-47c2-5dee-b6e3-7adad1957fba" 13194139533864 true] [17592186260560 1017 #edb/ref 17592186260561 13194139533864 true] [17592186260560 1089 "q-48608" 13194139533864 true] [17592186260560 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260560 1100 "The birth rate of a krill population is modeled by $B(t)=5\\cdot {2}^{0.7t}$ thousands of tons per year, where $t$ is the time, in years, since $1998.$ What was the birth rate, in thousands of tons per year, for the krill in $2008?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260560 1113 #uuid "9cc8a79a-7802-592e-80ef-d176d2e37ddd" 13194139533864 true] [17592186260560 1145 "The function $B(t)$ models the birth rate for the krill, in thousands of tons, $t$ years since $1998.$ Since we want the birth rate in $2008$, then $t=10$ years.\n\nThus, the birth rate for the krill in $2008$ was\n\n$$\n\\begin{aligned}B(10) & =5\\cdot {2}^{0.7(10)} \\\\  & =5\\cdot {2}^{7} \\\\  & =640.\\end{aligned}\n$$\n\nTherefore, the birth rate for the krill in $2008$ was $640$ thousand tons per year." 13194139533864 true] [17592186260561 1000 #edb/ref 17592186260562 13194139533864 true] [17592186260561 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260561 1041 "answer" 13194139533864 true] [17592186260561 1104 #edb/ref 17592186260562 13194139533864 true] [17592186260561 1110 #uuid "88dc04f0-ba52-595f-b804-826cb8ee5d73" 13194139533864 true] [17592186260562 1034 "640" 13194139533864 true] [17592186260562 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260562 1111 #uuid "2781a87c-c459-54dd-ba3e-a5af81917eb6" 13194139533864 true] [17592186260563 1017 #edb/ref 17592186260564 13194139533864 true] [17592186260563 1089 "q-48636" 13194139533864 true] [17592186260563 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260563 1100 "Find the equation of the tangent to the curve $f(x) = \\cos{\\left(x^3\\right)}$ at the point $\\left(0,1\\right).$\n\n$y =$: {{y}}" 13194139533864 true] [17592186260563 1113 #uuid "57478b30-a73d-57e4-8308-8dc05fea241e" 13194139533864 true] [17592186260563 1145 "First, the slope of $y = f(x)$ at $x = 0$ is given by $f'(0).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\cos{u}, \\qquad u = x^3.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -\\sin{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} =3x^2.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n\\dfrac{\\textrm d y}{\\textrm d x} &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&= -\\sin{u} \\cdot 3x^2\\\\[5pt]\n\n&=-3x^2\\sin(x^3).\n\\end{align*}\n\nEvaluating at $x=0,$ we find\n\\begin{align}\nm=f'(0) & = -3(0)^2\\sin(0^3) = 0.\n\\end{align}\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\\begin{align}\ny - y_1 & = m(x - x_1)\\\\[3pt]\n\ny - 1 & = 0 \\cdot \\left(x - 0 \\right)\\\\[3pt]\n\ny - 1 & = 0\\\\[3pt]\n\ny & =1.\n\\end{align}" 13194139533864 true] [17592186260564 1000 #edb/ref 17592186260565 13194139533864 true] [17592186260564 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260564 1041 "y" 13194139533864 true] [17592186260564 1104 #edb/ref 17592186260565 13194139533864 true] [17592186260564 1110 #uuid "cf82e01c-1269-551e-8e93-cecda9b6e244" 13194139533864 true] [17592186260565 1034 "1" 13194139533864 true] [17592186260565 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260565 1111 #uuid "5290779a-217c-5e77-a6ef-4d8a2c3e2fe3" 13194139533864 true] [17592186260566 1017 #edb/ref 17592186260567 13194139533864 true] [17592186260566 1089 "q-48644" 13194139533864 true] [17592186260566 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260566 1100 "Find the equation of the tangent to the curve $y =\\cos \\left(\\sin x \\right)$ at the point $\\left(0,1 \\right).$\n\n$y =$: {{y}}" 13194139533864 true] [17592186260566 1113 #uuid "3eae5d22-d1dc-5383-9678-4b5348d7df9b" 13194139533864 true] [17592186260566 1145 "First, the slope of $y = f(x)$ at $x = 0$ is given by $f'(0).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\nf = \\cos{u}, \\qquad u = \\sin x.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d f}{\\textrm d u} = -\\sin{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} =\\cos x.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n \\dfrac{\\textrm d f}{\\textrm d x} &= \\dfrac{\\textrm d f}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-\\sin u \\cdot (\\cos x)\\\\[5pt]\n&=-\\cos x \\sin (\\sin x).\n\\end{align*}\n\nEvaluating at $x=0,$ we find\n\\[\n\t\\eqalign{\n\tf'(0)&=-\\cos (0) \\sin (\\sin (0))\\\\[3pt]\n\t&=-1 \\cdot 0 \\\\[3pt]\n        &=0.\n}\n\\]\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\n\\begin{align}\ny-y_1 &= m(x-x_1)\\\\[3pt]\ny-1 &= (0)\\cdot\\left(x-0\\right)\\\\[3pt]\ny&=1.\n\\end{align}" 13194139533864 true] [17592186260567 1000 #edb/ref 17592186260568 13194139533864 true] [17592186260567 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260567 1041 "y" 13194139533864 true] [17592186260567 1104 #edb/ref 17592186260568 13194139533864 true] [17592186260567 1110 #uuid "f31279c8-8912-5d7a-a4fa-2d896f5d9f64" 13194139533864 true] [17592186260568 1034 "1" 13194139533864 true] [17592186260568 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260568 1111 #uuid "ffd05dd0-edc0-5d5e-9bf3-895de08612ac" 13194139533864 true] [17592186260569 1017 #edb/ref 17592186260570 13194139533864 true] [17592186260569 1089 "q-48700" 13194139533864 true] [17592186260569 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260569 1100 "The number of computers affected by the spread of some ransomware after $t$ days can be modeled by the function $f(t)=\\frac{100\\,({t}^{3}+2)}{t+1}.$ What is the instantaneous rate of change in the number of infected computers when $t=9$ days?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260569 1113 #uuid "4df84652-8096-5b0a-ac62-74634ce27764" 13194139533864 true] [17592186260569 1145 "The instantaneous rate of change in the spread when $t=9$ days is equal to ${f}^{'}(9).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{100\\,({t}^{3}+2)}{t+1}) \\\\  & =\\frac{100(3{t}^{2})(t+1)-100({t}^{3}+2)(1)}{{(t+1)}^{2}} \\\\  & =100\\cdot \\frac{2{t}^{3}+3{t}^{2}-2}{{(t+1)}^{2}}.\\end{aligned}\n$$\n\nNow, substituting $t=9,$ we get\n\n$$\n\\begin{aligned}{f}^{'}(9) & =100\\cdot \\frac{2(9)^{3}+3(9)^{2}-2}{{((9)+1)}^{2}} \\\\  & =100\\cdot \\frac{1\\,458+243-2}{100} \\\\  & =1\\,699.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change in the spread when $t=9$ is $1\\,699$ computers per day." 13194139533864 true] [17592186260570 1000 #edb/ref 17592186260571 13194139533864 true] [17592186260570 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260570 1041 "answer" 13194139533864 true] [17592186260570 1104 #edb/ref 17592186260571 13194139533864 true] [17592186260570 1110 #uuid "d2a308a1-1af3-5de6-8f8f-a49d604bfa0f" 13194139533864 true] [17592186260571 1034 "1\\,699" 13194139533864 true] [17592186260571 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260571 1111 #uuid "47b1dd97-14d2-5cc3-95b1-6cd4e9b6a358" 13194139533864 true] [17592186260572 1017 #edb/ref 17592186260573 13194139533864 true] [17592186260572 1017 #edb/ref 17592186260575 13194139533864 true] [17592186260572 1089 "q-48705" 13194139533864 true] [17592186260572 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260572 1100 "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)={e}^{3t-2}$, where $t$ is the time, measured in seconds.  Find the position and velocity of the particle at the initial moment of time $t=0\\,\\text{s}.$\n\nInitial position m: {{initial-position-m}}\n\nInitial velocity m per s: {{initial-velocity-m-per-s}}" 13194139533864 true] [17592186260572 1113 #uuid "1c048a62-43d8-5898-82bc-9cc14066f325" 13194139533864 true] [17592186260572 1145 "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)={e}^{3t-2}:$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & ={e}^{3(0)-2} \\\\  & ={e}^{-2} \\\\  & =\\frac{1}{{e}^{2}}\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{3t-2}) \\\\  & =3{e}^{3t-2}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =3{e}^{3(0)-2} \\\\  & =\\frac{3}{{e}^{2}}\\,\\text{m/s}\\end{aligned}\n$$" 13194139533864 true] [17592186260573 1000 #edb/ref 17592186260574 13194139533864 true] [17592186260573 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260573 1041 "initial-position-m" 13194139533864 true] [17592186260573 1104 #edb/ref 17592186260574 13194139533864 true] [17592186260573 1110 #uuid "2c5fc215-5f78-5714-9c8f-d434ee48aefd" 13194139533864 true] [17592186260574 1034 "1/e^2" 13194139533864 true] [17592186260574 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260574 1111 #uuid "785194ab-cf8a-5579-802e-42f1f32b4ff6" 13194139533864 true] [17592186260575 1000 #edb/ref 17592186260576 13194139533864 true] [17592186260575 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260575 1041 "initial-velocity-m-per-s" 13194139533864 true] [17592186260575 1104 #edb/ref 17592186260576 13194139533864 true] [17592186260575 1110 #uuid "43b9d78d-3b0c-54e0-8bab-1daad712c1f4" 13194139533864 true] [17592186260576 1034 "3/e^2" 13194139533864 true] [17592186260576 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260576 1111 #uuid "0efcfc89-241d-5a0f-ae58-7cb928ffcc65" 13194139533864 true] [17592186260577 1017 #edb/ref 17592186260578 13194139533864 true] [17592186260577 1089 "q-48718" 13194139533864 true] [17592186260577 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260577 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d2dadb0372f8b19ca8e017b1f8aa883ac6140a4f17deb9a4a28569f3afda61fe.png)\n\nThe volume of a sphere is increasing.\nFind the instantaneous rate of change of a sphere’s volume with respect to its radius when the radius is equal to $r=2\\,\\text{cm}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260577 1113 #uuid "a580dc26-7bce-5304-a10e-4329d4b6dd9b" 13194139533864 true] [17592186260577 1145 "We know that the volume of the sphere with radius $r$ is given by\n\n$$\nV=V(r)=\\frac{4}{3}\\pi {r}^{3}.\n$$\n\nTaking the derivative, the rate of change of $V(r)$  with respect to $r$ is \n\n$$\n\\begin{aligned}{V}^{'}(r) & =\\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\  & =\\frac{4}{3}\\cdot 3\\pi {r}^{2} \\\\  & =4\\pi {r}^{2},\\end{aligned}\n$$\n\nand evaluating at $r=2$ gives\n\n$$\n{V}^{'}(2)=4\\pi (2)^{2}=16\\pi .\n$$\n\nTherefore, the instantaneous rate at which the volume of the sphere is changing when its radius is $2\\,\\text{cm}$ is $16\\pi \\,{\\text{cm}}^{3}/\\text{cm}.$" 13194139533864 true] [17592186260578 1000 #edb/ref 17592186260579 13194139533864 true] [17592186260578 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260578 1041 "answer" 13194139533864 true] [17592186260578 1104 #edb/ref 17592186260579 13194139533864 true] [17592186260578 1110 #uuid "8dc6dc7e-270c-5c52-9af5-939c826eeb00" 13194139533864 true] [17592186260579 1034 "16\\pi \\,{\\text{cm}}^{3}/\\text{cm}" 13194139533864 true] [17592186260579 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260579 1111 #uuid "2c8303d5-ccba-5a93-84d7-6bcf0bf7a5a0" 13194139533864 true] [17592186260580 1017 #edb/ref 17592186260581 13194139533864 true] [17592186260580 1089 "q-48723" 13194139533864 true] [17592186260580 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260580 1100 "The surface area $A$ of a sphere is increasing. Find the instantaneous rate at which the surface area of the sphere is changing with respect to its radius at the moment when the radius of the sphere is equal to $4\\,\\text{in}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260580 1113 #uuid "0e9f5e03-89e1-560d-8854-0c3b942d5434" 13194139533864 true] [17592186260580 1145 "We know that the surface area of a sphere with radius $r$ is given by \n\n$$\nA=A(r)=4\\pi {r}^{2}.\n$$\n\nTaking the derivative, the rate of change of $A(r)$ with respect to $r$ is\n\n$$\n\\begin{aligned}{A}^{'}(r) & =\\frac{\\text{d}}{\\text{d}r}(4\\pi {r}^{2}) \\\\  & =4\\pi (2r) \\\\  & =8\\pi r,\\end{aligned}\n$$\n\nand evaluating at $r=4$ gives\n\n$$\n{A}^{'}(4)=8\\pi (4)=32\\pi .\n$$\n\nTherefore, the instantaneous rate at which the surface area of the sphere is changing when its radius is $4\\,\\text{in}$, is $32\\pi $ ${\\text{in}}^{2}/\\text{in}.$" 13194139533864 true] [17592186260581 1000 #edb/ref 17592186260582 13194139533864 true] [17592186260581 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260581 1041 "answer" 13194139533864 true] [17592186260581 1104 #edb/ref 17592186260582 13194139533864 true] [17592186260581 1110 #uuid "35e6d3dc-0869-5c1c-bc5b-fc35e25fc93c" 13194139533864 true] [17592186260582 1034 "32\\pi\\,\\mathrm{in}^2/\\mathrm{in}" 13194139533864 true] [17592186260582 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260582 1111 #uuid "caa3b461-2365-5c6a-8b5f-1a14cad7f232" 13194139533864 true] [17592186260583 1017 #edb/ref 17592186260584 13194139533864 true] [17592186260583 1089 "q-48866" 13194139533864 true] [17592186260583 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260583 1100 "Evaluate ${lim}_{x\\to \\infty }\\frac{\\operatorname{cos}x}{3{x}^{2}+x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260583 1113 #uuid "72cf5a4e-ff4b-5bf3-a1c6-4b089563c4f1" 13194139533864 true] [17592186260583 1145 "The numerator here is a bounded, oscillating function with\n\n$$\n|\\operatorname{cos}x|\\le 1.\n$$\n\nHowever, the denominator $3{x}^{2}+x$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{cos}x}{3{x}^{2}+x}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{\\operatorname{cos}x}{3{x}^{2}+x},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/80dcb33426c9981efdb4eddb4bbd33e75aeb5267cd776acfbda99758e010128a.png)" 13194139533864 true] [17592186260584 1000 #edb/ref 17592186260585 13194139533864 true] [17592186260584 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260584 1041 "answer" 13194139533864 true] [17592186260584 1104 #edb/ref 17592186260585 13194139533864 true] [17592186260584 1110 #uuid "a44932b0-57d2-57a8-a5ab-685dc9746c7b" 13194139533864 true] [17592186260585 1034 "0" 13194139533864 true] [17592186260585 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260585 1111 #uuid "859a9968-4603-567a-8951-158894e28316" 13194139533864 true] [17592186260586 1017 #edb/ref 17592186260587 13194139533864 true] [17592186260586 1089 "q-48869" 13194139533864 true] [17592186260586 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260586 1100 "Evaluate ${lim}_{x\\to \\infty }\\frac{\\operatorname{cos}x+4}{6{x}^{4}-2{x}^{2}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260586 1113 #uuid "a6e8da81-1916-527c-8075-091e80f07bef" 13194139533864 true] [17592186260586 1145 "The function $\\operatorname{cos}(x)$ is a bounded, oscillating function with\n\n$$\n|\\operatorname{cos}x|\\le 1.\n$$\n\nSo, the numerator here is a bounded, oscillating function with\n\n$$\n3\\le \\operatorname{cos}x+4\\le 5.\n$$\n\nHowever, the denominator $6{x}^{4}-2{x}^{2}$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{cos}x+4}{6{x}^{4}-2{x}^{2}}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{\\operatorname{cos}x+4}{6{x}^{4}-2{x}^{2}},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/2c4c732472ffcfa4a42e7a0dd7e1ff55a9b4d2f0d5b0b652b875efa284d9274d.png)" 13194139533864 true] [17592186260587 1000 #edb/ref 17592186260588 13194139533864 true] [17592186260587 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260587 1041 "answer" 13194139533864 true] [17592186260587 1104 #edb/ref 17592186260588 13194139533864 true] [17592186260587 1110 #uuid "09dbbc95-19f3-5123-b473-bbf74d305dc5" 13194139533864 true] [17592186260588 1034 "0" 13194139533864 true] [17592186260588 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260588 1111 #uuid "1af60cbf-868c-5faa-828d-3f9f7ecac8ba" 13194139533864 true] [17592186260589 1017 #edb/ref 17592186260590 13194139533864 true] [17592186260589 1017 #edb/ref 17592186260592 13194139533864 true] [17592186260589 1089 "q-48907" 13194139533864 true] [17592186260589 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260589 1100 "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)=\\operatorname{ln}(2t+e)$, where $t$ is the time, measured in seconds. Find the position and velocity of the particle at the initial moment of time $t=0\\,\\text{s}.$\n\nInitial position m: {{initial-position-m}}\n\nInitial velocity m per s: {{initial-velocity-m-per-s}}" 13194139533864 true] [17592186260589 1113 #uuid "5d6ad8bf-cda0-583d-b73e-9adebb22d32f" 13194139533864 true] [17592186260589 1145 "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)=\\operatorname{ln}(2t+e):$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & =\\operatorname{ln}(2\\cdot 0+e) \\\\  & =\\operatorname{ln}(e) \\\\  & =1\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}(2t+e)) \\\\  & =\\frac{2}{2t+e}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =\\frac{2}{2\\cdot 0+e} \\\\  & =\\frac{2}{e}\\,\\text{m/s}\\end{aligned}\n$$" 13194139533864 true] [17592186260590 1000 #edb/ref 17592186260591 13194139533864 true] [17592186260590 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260590 1041 "initial-position-m" 13194139533864 true] [17592186260590 1104 #edb/ref 17592186260591 13194139533864 true] [17592186260590 1110 #uuid "43689921-7c93-5357-ac72-a6d9e541ad3f" 13194139533864 true] [17592186260591 1034 "1" 13194139533864 true] [17592186260591 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260591 1111 #uuid "62ea0905-ce2a-5bef-abfe-be76392f8ef0" 13194139533864 true] [17592186260592 1000 #edb/ref 17592186260593 13194139533864 true] [17592186260592 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260592 1041 "initial-velocity-m-per-s" 13194139533864 true] [17592186260592 1104 #edb/ref 17592186260593 13194139533864 true] [17592186260592 1110 #uuid "afbb088c-39b6-5268-af57-64f0a9263ab9" 13194139533864 true] [17592186260593 1034 "2/e" 13194139533864 true] [17592186260593 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260593 1111 #uuid "862f6e8b-9945-5817-9e51-df584ef17c42" 13194139533864 true] [17592186260594 1017 #edb/ref 17592186260595 13194139533864 true] [17592186260594 1089 "q-48923" 13194139533864 true] [17592186260594 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260594 1100 "To measure the success of an amusement park, Ed uses the following three functions that model the daily number of visitors to the park $t$ minutes after the park is opened to the public.\n\n- $N(t)$ - the number of people inside the park\n\n- $E(t)$ - the rate at which people enter the park\n\n- $L(t)$ - the rate at which people leave the park\n\nWhat is the relationship between the functions above?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260594 1113 #uuid "61fc9e19-a1dc-5bda-bad9-f6840c970079" 13194139533864 true] [17592186260594 1145 "The function $N(t)$ gives the number of people inside the park $t$ minutes after opening. Then,\n\n$$\n{N}^{'}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{'}(t)$ gives the rate at which the number of people inside the park changes $t$ minutes after opening.\n\nIn addition, we can compute the rate of change of the number of people inside the park at time $t$ by finding the difference between the entry and exit rates at time $t.$ That is,\n\n$$\n{N}^{'}(t)=E(t)-L(t).\n$$" 13194139533864 true] [17592186260595 1000 #edb/ref 17592186260596 13194139533864 true] [17592186260595 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260595 1041 "answer" 13194139533864 true] [17592186260595 1104 #edb/ref 17592186260596 13194139533864 true] [17592186260595 1110 #uuid "92ea99bf-1e6b-5425-8540-f6c2f3c2597a" 13194139533864 true] [17592186260596 1034 "E(t)-L(t)" 13194139533864 true] [17592186260596 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260596 1111 #uuid "38123b91-7491-5390-9128-d9ba1de04d8b" 13194139533864 true] [17592186260597 1017 #edb/ref 17592186260598 13194139533864 true] [17592186260597 1089 "q-49173" 13194139533864 true] [17592186260597 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260597 1100 "$\\int {(1+5{x}^{2})}^{2}\\,\\text{d}x=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260597 1113 #uuid "db18238a-fc51-5865-8ca3-aaa8e71e44d6" 13194139533864 true] [17592186260597 1145 "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+5{x}^{2})}^{2}\\,\\text{d}x & =\\int (1+10{x}^{2}+25{x}^{4})\\,\\text{d}x \\\\  & =25\\int {x}^{4}\\,\\text{d}x+10\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =25(\\frac{{x}^{5}}{5})+10(\\frac{{x}^{3}}{3})+(x)+C \\\\  & =5{x}^{5}+\\frac{10{x}^{3}}{3}+x+C.\\end{aligned}\n$$" 13194139533864 true] [17592186260598 1000 #edb/ref 17592186260599 13194139533864 true] [17592186260598 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260598 1041 "answer" 13194139533864 true] [17592186260598 1104 #edb/ref 17592186260599 13194139533864 true] [17592186260598 1110 #uuid "9ea9442d-e5da-5cf6-9d19-fb38d9413713" 13194139533864 true] [17592186260599 1034 "5{x}^{5}+\\frac{10{x}^{3}}{3}+x+C" 13194139533864 true] [17592186260599 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260599 1111 #uuid "9c3922f1-2f0d-57dc-a324-9db300114e60" 13194139533864 true] [17592186260600 1017 #edb/ref 17592186260601 13194139533864 true] [17592186260600 1089 "q-49189" 13194139533864 true] [17592186260600 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260600 1100 "What is ${\\int }_{1}^{2}{x}^{2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260600 1113 #uuid "5ae0c14e-2353-57d2-951a-f4c503f5887d" 13194139533864 true] [17592186260600 1145 "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx,\n$$\n\n \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{l}=a+lΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{2}\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{2},$ the lower bound is $a=1,$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+l\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+\\frac{l}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{l}{n})}^{2}\\cdot \\frac{1}{n}].\\end{aligned}\n$$" 13194139533864 true] [17592186260601 1000 #edb/ref 17592186260602 13194139533864 true] [17592186260601 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260601 1041 "answer" 13194139533864 true] [17592186260601 1104 #edb/ref 17592186260602 13194139533864 true] [17592186260601 1110 #uuid "87a4bf30-e9a1-5c7c-9c08-9eae7b2d0bcf" 13194139533864 true] [17592186260602 1034 "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{l}{n})}^{2}\\cdot \\frac{1}{n}]" 13194139533864 true] [17592186260602 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260602 1111 #uuid "777ada17-74df-558c-8eb7-5eba2e110bf0" 13194139533864 true] [17592186260603 1017 #edb/ref 17592186260604 13194139533864 true] [17592186260603 1017 #edb/ref 17592186260606 13194139533864 true] [17592186260603 1089 "q-49233" 13194139533864 true] [17592186260603 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260603 1100 "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{-\\pi }^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{cos}^{2}(-\\pi +\\frac{\\pi k}{n})\\cdot \\frac{\\pi }{n}].$\n\nF of x: {{f-of-x}}\n\n$b$: {{b}}" 13194139533864 true] [17592186260603 1113 #uuid "ddefd999-6b86-57f0-8e66-8d7df90354a0" 13194139533864 true] [17592186260603 1145 "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=-\\pi .$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{\\pi }{n}.$ Therefore, \n\n$$\n\\frac{\\pi }{n}=\\frac{b-(-\\pi )}{n}\\,⟹\\,b=0.\n$$\n\nConsequently, ${x}_{k}=-\\pi +\\frac{\\pi k}{n}$ and $f({x}_{k})={cos}^{2}{x}_{k}.$\n\nHence,\n\n$$\n{\\int }_{-\\pi }^{0}{cos}^{2}x\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{cos}^{2}(-\\pi +\\frac{\\pi k}{n})\\cdot \\frac{\\pi }{n}].\n$$\n\nTherefore, the correct answer is $f(x)={cos}^{2}x$ and $b=0.$" 13194139533864 true] [17592186260604 1000 #edb/ref 17592186260605 13194139533864 true] [17592186260604 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260604 1041 "b" 13194139533864 true] [17592186260604 1104 #edb/ref 17592186260605 13194139533864 true] [17592186260604 1110 #uuid "9856fb6c-604b-546b-a8bc-5d907a6a53dd" 13194139533864 true] [17592186260605 1034 "0" 13194139533864 true] [17592186260605 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260605 1111 #uuid "95695239-c1c1-51f5-b8e7-58142046df6e" 13194139533864 true] [17592186260606 1000 #edb/ref 17592186260607 13194139533864 true] [17592186260606 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260606 1041 "f-of-x" 13194139533864 true] [17592186260606 1104 #edb/ref 17592186260607 13194139533864 true] [17592186260606 1110 #uuid "dcb31307-6f8d-554f-ab68-3850c849e46c" 13194139533864 true] [17592186260607 1034 "\\cos^2 x" 13194139533864 true] [17592186260607 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260607 1111 #uuid "b9d6f693-5690-565f-925c-c15da982068c" 13194139533864 true] [17592186260608 1017 #edb/ref 17592186260609 13194139533864 true] [17592186260608 1089 "q-49260" 13194139533864 true] [17592186260608 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260608 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/eb29a63cda5e01de48a224a2802542d45c6b69ee035edfd5ae675ed074d88bdb.png)\n\nThe area under the curve $y=16-{x}^{2}$ between $x=0$, $x=3$ and the $x$-axis is approximated using a right Riemann sum, as shown above. What is the expression for the Riemann sum in sigma notation?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260608 1113 #uuid "eb70f5d3-7528-53c6-aa91-6966c5074c0f" 13194139533864 true] [17592186260608 1145 "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nFrom the diagram, we see that there are $n=3$ rectangles. The endpoints indicate that $a=0$ and $b=3,$ so the step size is \n\n$$\nΔx=\\frac{3-0}{3}=\\frac{3}{3}=1.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as \n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{3}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{3}f(0+i\\cdot 1)\\cdot 1 \\\\  & ={\\sum }_{i=1}^{3}f(i) \\\\  & ={\\sum }_{i=1}^{3}(16-{i}^{2}).\\end{aligned}\n$$" 13194139533864 true] [17592186260609 1000 #edb/ref 17592186260610 13194139533864 true] [17592186260609 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260609 1041 "answer" 13194139533864 true] [17592186260609 1104 #edb/ref 17592186260610 13194139533864 true] [17592186260609 1110 #uuid "0fa7bda8-718c-5e7d-9f90-fdafbec0d4ce" 13194139533864 true] [17592186260610 1034 "{\\sum }_{i=1}^{3}(16-{i}^{2})" 13194139533864 true] [17592186260610 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260610 1111 #uuid "7194c7f4-bbb5-5b64-bfb9-02c7d2811cd0" 13194139533864 true] [17592186260611 1017 #edb/ref 17592186260612 13194139533864 true] [17592186260611 1089 "q-49366" 13194139533864 true] [17592186260611 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260611 1100 "The area under the curve $y=\\sqrt{x+1}$ between $x=-1$ and $x=4$ and the $x$-axis is approximated by a left Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260611 1113 #uuid "cb8716f6-3c22-54a1-bc3f-98777b2194cc" 13194139533864 true] [17592186260611 1145 "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=0}^{n-1}f({x}_{j})Δx,\n$$\n\nwhere $n$ is the number of subintervals, ${x}_{j}=a+jΔx$, and  $Δx=\\frac{b-a}{n}.$ \n\nThe endpoints indicate that $a=-1$ and $b=4,$ so the step size is\n\n$$\nΔx=\\frac{4-(-1)}{n}=\\frac{5}{n}.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{j=0}^{n-1}f({x}_{j})Δx & ={\\sum }_{j=0}^{n-1}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=0}^{n-1}f(-1+j\\cdot \\frac{5}{n})\\cdot \\frac{5}{n} \\\\  & ={\\sum }_{j=0}^{n-1}f(-1+\\frac{5j}{n})\\cdot \\frac{5}{n} \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{5}{n}\\cdot \\sqrt{(-1+\\frac{5j}{n})+1} \\\\  & ={\\sum }_{j=0}^{n-1}\\,\\frac{5}{n}\\sqrt{\\frac{5j}{n}}.\\end{aligned}\n$$" 13194139533864 true] [17592186260612 1000 #edb/ref 17592186260613 13194139533864 true] [17592186260612 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260612 1041 "answer" 13194139533864 true] [17592186260612 1104 #edb/ref 17592186260613 13194139533864 true] [17592186260612 1110 #uuid "4cf714d0-a133-56e5-a293-fca7ff99ee09" 13194139533864 true] [17592186260613 1034 "{\\sum }_{j=0}^{n-1}\\,\\frac{5}{n}\\sqrt{\\frac{5j}{n}}" 13194139533864 true] [17592186260613 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260613 1111 #uuid "d05ddaa7-36bb-5245-9790-05e0e5b9d1b6" 13194139533864 true] [17592186260614 1017 #edb/ref 17592186260615 13194139533864 true] [17592186260614 1089 "q-49515" 13194139533864 true] [17592186260614 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260614 1100 "Calculate $\\int \\frac{5}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260614 1113 #uuid "c472c0d4-d3df-50b1-a45a-c2d9b5dcf85c" 13194139533864 true] [17592186260614 1145 "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{5}{3x+4}\\,\\text{d}x & =\\int \\frac{5}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\operatorname{ln}|u|+C \\\\  & =\\frac{5}{3}\\operatorname{ln}|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{5}{3}\\operatorname{ln}K$ for another arbitrary positive constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\operatorname{ln}|3x+4|+C & =\\frac{5}{3}\\operatorname{ln}|3x+4|+\\frac{5}{3}\\operatorname{ln}K \\\\  & =\\frac{5}{3}(\\operatorname{ln}|3x+4|+\\operatorname{ln}K) \\\\  & =\\frac{5}{3}\\operatorname{ln}(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{5}{3x+4}\\,\\text{d}x=\\frac{5}{3}\\operatorname{ln}(K|3x+4|).\n$$" 13194139533864 true] [17592186260615 1000 #edb/ref 17592186260616 13194139533864 true] [17592186260615 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260615 1041 "answer" 13194139533864 true] [17592186260615 1104 #edb/ref 17592186260616 13194139533864 true] [17592186260615 1110 #uuid "e4eb7a7f-c819-5fd9-b614-2e86f953fb0c" 13194139533864 true] [17592186260616 1034 "\\frac{5}{3}\\operatorname{ln}(K|3x+4|)" 13194139533864 true] [17592186260616 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260616 1111 #uuid "049f54b3-4dcd-5a69-a4e8-f4d943ba4977" 13194139533864 true] [17592186260617 1017 #edb/ref 17592186260618 13194139533864 true] [17592186260617 1089 "q-49558" 13194139533864 true] [17592186260617 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260617 1100 "What is the fifth partial sum of the series\n${\\sum }_{n=1}^{\\infty }6{x}^{n+1}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260617 1113 #uuid "8a9cbdc6-b363-57d5-bb3e-8d0d655f7af6" 13194139533864 true] [17592186260617 1145 "Let ${a}_{n}=6{x}^{n+1}.$ We note that this is a geometric sequence with $r=x$ and first term given by\n\n$$\n{a}_{1}=6{x}^{1+1}=6{x}^{2}.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the fifth partial sum is\n\n$$\n\\begin{aligned}{s}_{5} & =6{x}^{2}\\cdot \\frac{1-{x}^{5}}{1-x} \\\\  & =\\frac{6{x}^{2}(1-{x}^{5})}{1-x}.\\end{aligned}\n$$" 13194139533864 true] [17592186260618 1000 #edb/ref 17592186260619 13194139533864 true] [17592186260618 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260618 1041 "answer" 13194139533864 true] [17592186260618 1104 #edb/ref 17592186260619 13194139533864 true] [17592186260618 1110 #uuid "2a373ee9-ba85-5a26-b04c-f9ec45642784" 13194139533864 true] [17592186260619 1034 "\\frac{6{x}^{2}(1-{x}^{5})}{1-x}" 13194139533864 true] [17592186260619 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260619 1111 #uuid "b5ba8282-f56e-5470-be68-7b26ce02cb57" 13194139533864 true] [17592186260620 1017 #edb/ref 17592186260621 13194139533864 true] [17592186260620 1089 "q-49568" 13194139533864 true] [17592186260620 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260620 1100 "Consider the following sequence: \n\n$$\n{a}_{n+1}=-\\frac{5}{4}{a}_{n},\\,{a}_{1}=\\frac{1}{2},\\,n\\ge 1.\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." 13194139533864 true] [17592186260620 1113 #uuid "71dac1d2-6ea4-558d-93e8-0311765a5a7d" 13194139533864 true] [17592186260620 1145 "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{5}{4}.\n$$\n\nSince $|r|>1$, the sequence diverges." 13194139533864 true] [17592186260621 1000 #edb/ref 17592186260622 13194139533864 true] [17592186260621 1000 #edb/ref 17592186260623 13194139533864 true] [17592186260621 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260621 1041 "selection" 13194139533864 true] [17592186260621 1104 #edb/ref 17592186260622 13194139533864 true] [17592186260621 1110 #uuid "d20d3612-8f26-5ea3-b4eb-4ce596ec8c19" 13194139533864 true] [17592186260622 1034 "Diverges" 13194139533864 true] [17592186260622 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260622 1111 #uuid "7493e4bf-895d-5e65-bb8f-bf2d383720b8" 13194139533864 true] [17592186260623 1034 "Converges" 13194139533864 true] [17592186260623 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260623 1111 #uuid "209fa5c5-1466-5ce7-a8d2-8973f26a4e1f" 13194139533864 true] [17592186260624 1017 #edb/ref 17592186260625 13194139533864 true] [17592186260624 1089 "q-49635" 13194139533864 true] [17592186260624 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260624 1100 "What is the fourth partial sum of the series\n${\\sum }_{n=1}^{\\infty }4(2x)^{n}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260624 1113 #uuid "e95dca68-877e-5128-aa96-9c3d5dd43bb0" 13194139533864 true] [17592186260624 1145 "Let ${a}_{n}=4(2x)^{n}.$ We note that this is a geometric sequence with $r=2x$ and first term given by\n\n$$\n{a}_{1}=4(2x)^{1}=4\\cdot 2x=8x.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the fourth partial sum is\n\n$$\n\\begin{aligned}{s}_{4} & =8x\\cdot \\frac{1-(2x)^{4}}{1-2x} \\\\  & =8x\\cdot \\frac{1-{2}^{4}{x}^{4}}{1-2x} \\\\  & =8x\\cdot \\frac{1-16{x}^{4}}{1-2x} \\\\  & =\\frac{8x(1-16{x}^{4})}{1-2x}.\\end{aligned}\n$$" 13194139533864 true] [17592186260625 1000 #edb/ref 17592186260626 13194139533864 true] [17592186260625 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260625 1041 "answer" 13194139533864 true] [17592186260625 1104 #edb/ref 17592186260626 13194139533864 true] [17592186260625 1110 #uuid "24fa643e-bd93-58ac-b414-22106e49cb68" 13194139533864 true] [17592186260626 1034 "\\frac{8x(1-16{x}^{4})}{1-2x}" 13194139533864 true] [17592186260626 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260626 1111 #uuid "8b6ae1f4-d44e-5228-bedb-cd47059e3e91" 13194139533864 true] [17592186260627 1017 #edb/ref 17592186260628 13194139533864 true] [17592186260627 1089 "q-49642" 13194139533864 true] [17592186260627 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260627 1100 "Consider the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{2}{(-1)}^{n}.$ Does it converge or diverge? If it converges, what is the sum of the series?" 13194139533864 true] [17592186260627 1113 #uuid "335820dd-ba2b-5e7f-92b7-d9a01208fa93" 13194139533864 true] [17592186260627 1145 "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =\\frac{1}{2}{(-1)}^{1}=-\\frac{1}{2} \\\\ {s}_{2} & =-\\frac{1}{2}+\\frac{1}{2}{(-1)}^{2}=0 \\\\ {s}_{3} & =0+\\frac{1}{2}{(-1)}^{3}=-\\frac{1}{2} \\\\ {s}_{4} & =-\\frac{1}{2}+\\frac{1}{2}{(-1)}^{4}=0\\end{aligned}\n$$\n\nFrom the above, we can see that the sequence of partial sums oscillates between  $-\\frac{1}{2}$ and $0$ forever. \n\nSo the limit of the sequence of partial sums does not exist, and therefore the series is divergent." 13194139533864 true] [17592186260628 1000 #edb/ref 17592186260629 13194139533864 true] [17592186260628 1000 #edb/ref 17592186260630 13194139533864 true] [17592186260628 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260628 1041 "selection" 13194139533864 true] [17592186260628 1104 #edb/ref 17592186260629 13194139533864 true] [17592186260628 1110 #uuid "8bafb7c5-b67d-5e0b-9773-76f093b2d804" 13194139533864 true] [17592186260629 1034 "Diverges" 13194139533864 true] [17592186260629 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260629 1111 #uuid "3ab84687-4674-50da-a455-1f6360b70d58" 13194139533864 true] [17592186260630 1034 "Converges" 13194139533864 true] [17592186260630 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260630 1111 #uuid "f0422631-e627-5668-a3fd-c50f7d2e4c0b" 13194139533864 true] [17592186260631 1017 #edb/ref 17592186260632 13194139533864 true] [17592186260631 1089 "q-49823" 13194139533864 true] [17592186260631 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260631 1100 "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, what is the condition for the real constant $K$ guaranteeing that ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}$ is divergent?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260631 1113 #uuid "1d36a125-e583-545a-9546-1099e4752895" 13194139533864 true] [17592186260631 1145 "If we multiply the terms of a divergent series by a non-zero constant, the resulting series is divergent.\n\nTherefore, the series\n\n$$\n{\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}\n$$\n\nis divergent when $K\\ne 0.$" 13194139533864 true] [17592186260632 1000 #edb/ref 17592186260633 13194139533864 true] [17592186260632 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260632 1041 "answer" 13194139533864 true] [17592186260632 1104 #edb/ref 17592186260633 13194139533864 true] [17592186260632 1110 #uuid "6aa4d1bb-1add-567d-a927-b677cb57cc66" 13194139533864 true] [17592186260633 1034 "K\\ne 0" 13194139533864 true] [17592186260633 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260633 1111 #uuid "068ba32f-c808-561c-b627-9c7459f62d69" 13194139533864 true] [17592186260634 1017 #edb/ref 17592186260635 13194139533864 true] [17592186260634 1089 "q-49824" 13194139533864 true] [17592186260634 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260634 1100 "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, what is the condition for the real constant $K$ guaranteeing that $K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260634 1113 #uuid "79b3da5f-c66e-5a1e-bee9-a95c92685b9a" 13194139533864 true] [17592186260634 1145 "Any constant multiple of a convergent series gives a convergent series. \n\nSo, $K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent for all $K.$" 13194139533864 true] [17592186260635 1000 #edb/ref 17592186260636 13194139533864 true] [17592186260635 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260635 1041 "answer" 13194139533864 true] [17592186260635 1104 #edb/ref 17592186260636 13194139533864 true] [17592186260635 1110 #uuid "9bbb7d57-388c-5c2a-8023-bee8e0b4ee60" 13194139533864 true] [17592186260636 1034 "K\\in\\mathbb R" 13194139533864 true] [17592186260636 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260636 1111 #uuid "b8d98476-9d3b-54f6-aeba-86dff4ce26de" 13194139533864 true] [17592186260637 1017 #edb/ref 17592186260638 13194139533864 true] [17592186260637 1089 "q-49836" 13194139533864 true] [17592186260637 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260637 1100 "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true? Assume that ${a}_{n}$ is well-defined for $n⩾1.$\n\nI. - $\\frac{1}{10\\,000}\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent\nII. - ${\\sum }_{n=1}^{8}{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent\nIII. - ${\\sum }_{n=10}^{\\infty }{a}_{n}$ is convergent" 13194139533864 true] [17592186260637 1113 #uuid "9f068f64-42c9-5eab-a9dd-69dbbca65fcb" 13194139533864 true] [17592186260637 1145 "Let's recall the properties of divergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}$ is also divergent for $K\\ne 0.$\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also divergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Any non-zero multiple of a divergent series gives a divergent series.\n\n- Statement II is false. Note that ${\\sum }_{n=1}^{8}{a}_{n}$ is a **finite series.** Therefore, ${\\sum }_{n=1}^{8}{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- Statement III is false. Removing a finite number of terms from a divergent series gives a divergent series.\n\nTherefore, the correct answer is \"I only.\"" 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260639 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260640 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260641 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260642 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260643 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260644 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260645 13194139533864 true] [17592186260638 1000 #edb/ref 17592186260646 13194139533864 true] [17592186260638 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260638 1041 "selection" 13194139533864 true] [17592186260638 1104 #edb/ref 17592186260642 13194139533864 true] [17592186260638 1110 #uuid "c39958ab-9a75-5986-89db-259aee63a2ce" 13194139533864 true] [17592186260639 1034 "I, II, and III" 13194139533864 true] [17592186260639 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260639 1111 #uuid "fb78b81a-08e0-5883-b8c1-d2b3762bd274" 13194139533864 true] [17592186260640 1034 "II and III only" 13194139533864 true] [17592186260640 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260640 1111 #uuid "c88b193c-1e36-53f0-bba8-c3b41432dc35" 13194139533864 true] [17592186260641 1034 "I and III only" 13194139533864 true] [17592186260641 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260641 1111 #uuid "2950368e-f30f-54a6-9cbc-e39d2b227801" 13194139533864 true] [17592186260642 1034 "I only" 13194139533864 true] [17592186260642 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260642 1111 #uuid "9764d03e-d2a5-51c2-b135-b591e8355b42" 13194139533864 true] [17592186260643 1034 "III only" 13194139533864 true] [17592186260643 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260643 1111 #uuid "ddf52af7-4622-5274-b8d9-df77922937e9" 13194139533864 true] [17592186260644 1034 "I and II only" 13194139533864 true] [17592186260644 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260644 1111 #uuid "4be3504a-0f66-5048-9275-871a324af799" 13194139533864 true] [17592186260645 1034 "None of those listed" 13194139533864 true] [17592186260645 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260645 1111 #uuid "5c5027dd-4dbf-56e5-b293-30e24a303a20" 13194139533864 true] [17592186260646 1034 "II only" 13194139533864 true] [17592186260646 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260646 1111 #uuid "13f34607-fa97-57d2-b597-fa8c4bd337b6" 13194139533864 true] [17592186260647 1017 #edb/ref 17592186260648 13194139533864 true] [17592186260647 1089 "q-49841" 13194139533864 true] [17592186260647 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260647 1100 "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true?\n\nI. - ${\\sum }_{n=100}^{\\infty }{a}_{n}$ is convergent\nII. - ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent\nIII. - $1\\,000{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent" 13194139533864 true] [17592186260647 1113 #uuid "f30cf6e1-a2f7-50a2-8c61-f5748c2a0e0f" 13194139533864 true] [17592186260647 1145 "Let's recall the properties of convergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}=K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is also convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Removing a finite number of terms from a convergent series gives a convergent series.\n\n- Statement II is false. The sum of two convergent series is convergent.\n\n- Statement III is true. Any constant multiple of a convergent series gives a convergent series.\n\nTherefore, the correct answer is \"I and III only.\"" 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260649 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260650 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260651 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260652 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260653 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260654 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260655 13194139533864 true] [17592186260648 1000 #edb/ref 17592186260656 13194139533864 true] [17592186260648 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260648 1041 "selection" 13194139533864 true] [17592186260648 1104 #edb/ref 17592186260651 13194139533864 true] [17592186260648 1110 #uuid "32524753-7bf7-51bd-b7ec-0c1ce05625a2" 13194139533864 true] [17592186260649 1034 "I, II, and III" 13194139533864 true] [17592186260649 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260649 1111 #uuid "5a35aa78-d547-5a55-8a2f-3f86e4c0afb5" 13194139533864 true] [17592186260650 1034 "II and III only" 13194139533864 true] [17592186260650 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260650 1111 #uuid "8644a362-1e72-5a40-acc5-710bc5a3bcd6" 13194139533864 true] [17592186260651 1034 "I and III only" 13194139533864 true] [17592186260651 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260651 1111 #uuid "e0dac5b6-786f-5744-93c0-87b1055f2912" 13194139533864 true] [17592186260652 1034 "I only" 13194139533864 true] [17592186260652 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260652 1111 #uuid "38362d27-f96d-5548-bff5-1512c06ada80" 13194139533864 true] [17592186260653 1034 "III only" 13194139533864 true] [17592186260653 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260653 1111 #uuid "0362b06e-efe4-545c-86bd-91cb1c3508c7" 13194139533864 true] [17592186260654 1034 "I and II only" 13194139533864 true] [17592186260654 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260654 1111 #uuid "acbfefc2-a7e5-5a3b-b04b-4a73976e50af" 13194139533864 true] [17592186260655 1034 "None of those listed" 13194139533864 true] [17592186260655 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260655 1111 #uuid "56f00260-986c-5669-a513-075f3979051c" 13194139533864 true] [17592186260656 1034 "II only" 13194139533864 true] [17592186260656 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260656 1111 #uuid "e1267788-fb64-575f-b20c-448bc0e42758" 13194139533864 true] [17592186260657 1017 #edb/ref 17592186260658 13194139533864 true] [17592186260657 1089 "q-5031" 13194139533864 true] [17592186260657 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260657 1100 "Consider the function $f(x)=\\operatorname{ln}({x}^{2}+1)+3x$ and the point $P(0,0)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$  calculate ${({f}^{-1})}^{'}(0).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260657 1113 #uuid "d99c943d-c7b7-53d6-8c63-62b556330e7e" 13194139533864 true] [17592186260657 1145 "We start by calculating the derivative of $f$ at the point $(0,0).$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}({x}^{2}+1)+3x \\\\ {f}^{'}(x) & =\\frac{2x}{{x}^{2}+1}+3 \\\\ {f}^{'}(0) & =3\\end{aligned}\n$$\n\nSince $(0,0)$ lies on $y=f(x),$ we know that the corresponding point $(0,0)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}{({f}^{-1})}^{'}(0) & =\\frac{1}{{f}^{'}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{'}(0)} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" 13194139533864 true] [17592186260658 1000 #edb/ref 17592186260659 13194139533864 true] [17592186260658 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260658 1041 "answer" 13194139533864 true] [17592186260658 1104 #edb/ref 17592186260659 13194139533864 true] [17592186260658 1110 #uuid "ba51ce0d-964f-5fa5-81c2-970951106ba8" 13194139533864 true] [17592186260659 1034 "\\frac{1}{3}" 13194139533864 true] [17592186260659 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260659 1111 #uuid "4b6b26c0-f41e-56e3-9bb3-7bd483e8aab3" 13194139533864 true] [17592186260660 1017 #edb/ref 17592186260661 13194139533864 true] [17592186260660 1089 "q-50450" 13194139533864 true] [17592186260660 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260660 1100 "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3q-1}}$ converge?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260660 1113 #uuid "485f013d-0bc9-5843-bf53-dbb0e9f37daa" 13194139533864 true] [17592186260660 1145 "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=3q-1.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\n3q-1>1\\,⟹\\,q>\\frac{2}{3}.\n$$\n\nTherefore, the series is convergent for all $q>\\frac{2}{3}.$" 13194139533864 true] [17592186260661 1000 #edb/ref 17592186260662 13194139533864 true] [17592186260661 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260661 1041 "answer" 13194139533864 true] [17592186260661 1104 #edb/ref 17592186260662 13194139533864 true] [17592186260661 1110 #uuid "72fea3e7-a34b-57dd-a2f0-690568ee01fc" 13194139533864 true] [17592186260662 1034 "q>\\frac{2}{3}" 13194139533864 true] [17592186260662 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260662 1111 #uuid "ae3472fc-382b-5dcd-9af1-257afd195ad9" 13194139533864 true] [17592186260663 1017 #edb/ref 17592186260664 13194139533864 true] [17592186260663 1089 "q-50621" 13194139533864 true] [17592186260663 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260663 1100 "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2q-2}}$ converge?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260663 1113 #uuid "256094b3-ea33-541d-8e90-d5daa58588f2" 13194139533864 true] [17592186260663 1145 "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=2q-2.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\n2q-2>1\\,⟹\\,q>\\frac{3}{2}.\n$$\n\nTherefore, the series is convergent for all $q>\\frac{3}{2}.$" 13194139533864 true] [17592186260664 1000 #edb/ref 17592186260665 13194139533864 true] [17592186260664 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260664 1041 "answer" 13194139533864 true] [17592186260664 1104 #edb/ref 17592186260665 13194139533864 true] [17592186260664 1110 #uuid "538d9ef9-6498-5e05-8579-48f1dbafb867" 13194139533864 true] [17592186260665 1034 "q>\\frac{3}{2}" 13194139533864 true] [17592186260665 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260665 1111 #uuid "b28c8366-7d9f-5ebc-b954-1186b42ed53d" 13194139533864 true] [17592186260666 1017 #edb/ref 17592186260667 13194139533864 true] [17592186260666 1089 "q-50623" 13194139533864 true] [17592186260666 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260666 1100 "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{4q-1}}$ converge?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260666 1113 #uuid "35266cb0-18e1-5e7d-94b2-eb7099779b72" 13194139533864 true] [17592186260666 1145 "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=4q-1.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\n4q-1>1\\,⟹\\,q>\\frac{1}{2}.\n$$\n\nTherefore, the series is convergent for all $q>\\frac{1}{2}.$" 13194139533864 true] [17592186260667 1000 #edb/ref 17592186260668 13194139533864 true] [17592186260667 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260667 1041 "answer" 13194139533864 true] [17592186260667 1104 #edb/ref 17592186260668 13194139533864 true] [17592186260667 1110 #uuid "c87bcaed-30d0-56bb-adf0-a10cb6ec7d1d" 13194139533864 true] [17592186260668 1034 "q>\\frac{1}{2}" 13194139533864 true] [17592186260668 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260668 1111 #uuid "0a8ded69-fffa-5883-b1be-99365048eb11" 13194139533864 true] [17592186260669 1017 #edb/ref 17592186260670 13194139533864 true] [17592186260669 1089 "q-50629" 13194139533864 true] [17592186260669 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260669 1100 "Which of the following series are convergent?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{n\\sqrt{{n}^{3}}}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{8}{\\sqrt[9]{{n}^{2}}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{{n}^{3}}}{2{n}^{2}}$" 13194139533864 true] [17592186260669 1113 #uuid "a897110c-16a9-5e34-8f8f-61673b309ea9" 13194139533864 true] [17592186260669 1145 "We analyze each series in turn.\n\n- First, we look at ${\\sum }_{n=1}^{\\infty }\\frac{1}{n\\sqrt{{n}^{3}}}.$ Rewriting this gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{1}{n\\sqrt{{n}^{3}}} & ={\\sum }_{n=1}^{\\infty }\\frac{1}{n\\cdot {n}^{3/2}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/2}},\\end{aligned}\n$$\n\nwhich is a $p$-series with $p=\\frac{5}{2}.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the second series, we have\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{8}{\\sqrt[9]{{n}^{2}}}=8\\cdot {\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2/9}},\n$$\n\n \nwhich is a $p$-series with $p=\\frac{2}{9}.$ Since $p\\le 1,$ the series is divergent.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{{n}^{3}}}{2{n}^{2}} & =\\frac{1}{2}{\\sum }_{n=1}^{\\infty }\\frac{{n}^{3/2}}{{n}^{2}} \\\\  & =\\frac{1}{2}{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1/2}},\\end{aligned}\n$$\n\nwhich is a $p$-series with $p=\\frac{1}{2}.$ Since $p\\le 1,$ the series diverges by the $p$-series test.\n\nHence, the correct answer is \"I only\"." 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260671 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260672 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260673 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260674 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260675 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260676 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260677 13194139533864 true] [17592186260670 1000 #edb/ref 17592186260678 13194139533864 true] [17592186260670 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260670 1041 "selection" 13194139533864 true] [17592186260670 1104 #edb/ref 17592186260674 13194139533864 true] [17592186260670 1110 #uuid "f719330c-8cad-5dd6-8388-518d937a28d9" 13194139533864 true] [17592186260671 1034 "I, II, and III" 13194139533864 true] [17592186260671 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260671 1111 #uuid "e82e0a94-0ef1-5341-a309-036af807e925" 13194139533864 true] [17592186260672 1034 "II and III only" 13194139533864 true] [17592186260672 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260672 1111 #uuid "d17dd7b5-7079-5e55-a247-27b2c0ea73e9" 13194139533864 true] [17592186260673 1034 "I and III only" 13194139533864 true] [17592186260673 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260673 1111 #uuid "ef7b6a8d-bcfe-50b3-a209-f5009fafc7bf" 13194139533864 true] [17592186260674 1034 "I only" 13194139533864 true] [17592186260674 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260674 1111 #uuid "b0008a49-cef9-5b3e-8b9e-c5f691191a5e" 13194139533864 true] [17592186260675 1034 "III only" 13194139533864 true] [17592186260675 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260675 1111 #uuid "0d405ad9-1854-5b2f-ba5e-5a63f59fac5d" 13194139533864 true] [17592186260676 1034 "I and II only" 13194139533864 true] [17592186260676 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260676 1111 #uuid "233a6e40-88e2-5eb9-86a7-69a846a8e298" 13194139533864 true] [17592186260677 1034 "None of those listed" 13194139533864 true] [17592186260677 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260677 1111 #uuid "66bff3b0-0197-5440-8606-f7cf19285068" 13194139533864 true] [17592186260678 1034 "II only" 13194139533864 true] [17592186260678 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260678 1111 #uuid "4a02105c-bb09-5f55-963a-149b9d550997" 13194139533864 true] [17592186260679 1017 #edb/ref 17592186260680 13194139533864 true] [17592186260679 1089 "q-51051" 13194139533864 true] [17592186260679 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260679 1100 "Evaluate ${lim}_{x\\to 0}\\frac{\\operatorname{cos}8x-1}{2x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260679 1113 #uuid "a06fc393-8cfd-59d3-ab02-f104a703cf73" 13194139533864 true] [17592186260679 1145 "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to 0}\\frac{\\operatorname{cos}8x-1}{2x}=\\frac{\\operatorname{cos}(8\\cdot 0)-1}{2\\cdot 0}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{\\theta \\to 0}\\frac{1-\\operatorname{cos}\\theta }{\\theta }=0\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{cos}8x-1}{2x} & ={lim}_{x\\to 0}\\frac{1}{2}\\cdot \\frac{-(1-\\operatorname{cos}8x)}{x} \\\\  & ={lim}_{x\\to 0}-\\frac{1}{2}\\cdot \\frac{1-\\operatorname{cos}8x}{x} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{x\\to 0}\\frac{1-\\operatorname{cos}8x}{x} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{x\\to 0}(8\\cdot \\frac{1-\\operatorname{cos}8x}{8\\cdot x}) \\\\  & =-\\frac{8}{2}\\cdot {lim}_{x\\to 0}\\frac{1-\\operatorname{cos}8x}{8x} \\\\  & =-4\\cdot {lim}_{x\\to 0}\\frac{1-\\operatorname{cos}8x}{8x}\\end{aligned}\n$$\n\nLet $\\theta =8x.$ Then, since $\\theta \\to 0$ as $x\\to 0,$ we have\n\n$$\n{lim}_{x\\to 0}\\frac{1-\\operatorname{cos}8x}{8x}={lim}_{\\theta \\to 0}\\frac{1-\\operatorname{cos}\\theta }{\\theta }=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-4\\cdot {lim}_{x\\to 0}\\frac{1-\\operatorname{cos}8x}{8x} & =-4\\cdot 0=0.\\end{aligned}\n$$" 13194139533864 true] [17592186260680 1000 #edb/ref 17592186260681 13194139533864 true] [17592186260680 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260680 1041 "answer" 13194139533864 true] [17592186260680 1104 #edb/ref 17592186260681 13194139533864 true] [17592186260680 1110 #uuid "afd8774b-b9d3-5d5c-a7e5-afdde01fad3d" 13194139533864 true] [17592186260681 1034 "0" 13194139533864 true] [17592186260681 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260681 1111 #uuid "915c35b1-110c-595b-ab13-a53989edc066" 13194139533864 true] [17592186260682 1017 #edb/ref 17592186260683 13194139533864 true] [17592186260682 1089 "q-5132" 13194139533864 true] [17592186260682 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260682 1100 "$(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260682 1113 #uuid "b141e260-989c-53cf-98aa-d200f8672d3a" 13194139533864 true] [17592186260682 1145 "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9{u}^{3}$ and $b=4{v}^{2},$ we have\n\n$$\n\\begin{aligned}(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2}) & = \\\\ {(9{u}^{3})}^{2}-{(4{v}^{2})}^{2} & = \\\\ 81{u}^{6}-16{v}^{4}.\\end{aligned}\n$$" 13194139533864 true] [17592186260683 1000 #edb/ref 17592186260684 13194139533864 true] [17592186260683 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260683 1041 "answer" 13194139533864 true] [17592186260683 1104 #edb/ref 17592186260684 13194139533864 true] [17592186260683 1110 #uuid "b43b8d1d-204d-5b69-ae25-e71475a20538" 13194139533864 true] [17592186260684 1034 "81{u}^{6}-16{v}^{4}" 13194139533864 true] [17592186260684 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260684 1111 #uuid "222b1f0d-bbab-5319-bc68-6839d10d8071" 13194139533864 true] [17592186260685 1017 #edb/ref 17592186260686 13194139533864 true] [17592186260685 1089 "q-51348" 13194139533864 true] [17592186260685 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260685 1100 "If $f(x)=4{x}^{2}+3,$ find ${({f}^{-1})}^{'}(x)$ as a function of ${f}^{-1}(x).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260685 1113 #uuid "824454d8-43d8-5ebf-a55a-85d20223cc1a" 13194139533864 true] [17592186260685 1145 "**Step 1:** First, we write the inverse function implicitly. The given function is $y=4{x}^{2}+3,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=4{y}^{2}+3\n$$\n\nNote that in the equation above, we have $y={f}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{2}+3) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =8y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{8y}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =\\frac{1}{8{f}^{-1}(x)} \\\\ {({f}^{-1})}^{'}(x) & =\\frac{1}{8{f}^{-1}(x)}.\\end{aligned}\n$$" 13194139533864 true] [17592186260686 1000 #edb/ref 17592186260687 13194139533864 true] [17592186260686 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260686 1041 "answer" 13194139533864 true] [17592186260686 1104 #edb/ref 17592186260687 13194139533864 true] [17592186260686 1110 #uuid "525e8ca0-013c-569e-ab32-1ace667393ec" 13194139533864 true] [17592186260687 1034 "\\frac{1}{8{f}^{-1}(x)}" 13194139533864 true] [17592186260687 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260687 1111 #uuid "9d54bce4-66fe-5868-9b54-f3f29c4c70bd" 13194139533864 true] [17592186260688 1017 #edb/ref 17592186260689 13194139533864 true] [17592186260688 1089 "q-51351" 13194139533864 true] [17592186260688 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260688 1100 "If $g(x)=\\operatorname{cos}(4x+\\pi ),$ find ${({g}^{-1})}^{'}(x)$ as a function of ${g}^{-1}(x).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260688 1113 #uuid "f004e747-fa40-510b-9a94-e1103a008e37" 13194139533864 true] [17592186260688 1145 "**Step 1:** First, we write the inverse function implicitly. The given function is $y=\\operatorname{cos}(4x+\\pi ),$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=\\operatorname{cos}(4y+\\pi )\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}[\\operatorname{cos}(4y+\\pi )] \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-\\operatorname{sin}(4y+\\pi )\\cdot 4 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-4\\operatorname{sin}(4y+\\pi ) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{4\\operatorname{sin}(4y+\\pi )} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\operatorname{csc}(4y+\\pi )}{4}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =-\\frac{\\operatorname{csc}(4{g}^{-1}(x)+\\pi )}{4} \\\\ {({g}^{-1})}^{'}(x) & =-\\frac{\\operatorname{csc}(4{g}^{-1}(x)+\\pi )}{4}.\\end{aligned}\n$$" 13194139533864 true] [17592186260689 1000 #edb/ref 17592186260690 13194139533864 true] [17592186260689 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260689 1041 "answer" 13194139533864 true] [17592186260689 1104 #edb/ref 17592186260690 13194139533864 true] [17592186260689 1110 #uuid "473cf69a-3e4f-5eca-90b6-0c3ea1e56d53" 13194139533864 true] [17592186260690 1034 "-\\frac{\\operatorname{csc}(4{g}^{-1}(x)+\\pi )}{4}" 13194139533864 true] [17592186260690 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260690 1111 #uuid "c12057c2-bb53-5e66-ac67-04a6e406e7cf" 13194139533864 true] [17592186260691 1017 #edb/ref 17592186260692 13194139533864 true] [17592186260691 1089 "q-5145" 13194139533864 true] [17592186260691 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260691 1100 "Find $p$ if $2$ is a root of $f(x)=12{x}^{2}-3px.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260691 1113 #uuid "64793999-0fa3-539c-b945-76159b1213b2" 13194139533864 true] [17592186260691 1145 "Since  $x=2$ is a root, we have $f(2)=0.$ Therefore, we can evaluate the polynomial at $x=2,$ set it equal to $0,$ and solve the equation for the parameter $p:$\n\n$$\n\\begin{aligned}12(2)^{2}-3p(2) & =0 \\\\ 12(4)-6p & =0 \\\\ 48-6p & =0 \\\\ -6p & =-48 \\\\ p & =8\\end{aligned}\n$$" 13194139533864 true] [17592186260692 1000 #edb/ref 17592186260693 13194139533864 true] [17592186260692 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260692 1041 "answer" 13194139533864 true] [17592186260692 1104 #edb/ref 17592186260693 13194139533864 true] [17592186260692 1110 #uuid "81f591d8-00b2-566c-99df-1c6a9f783203" 13194139533864 true] [17592186260693 1034 "8" 13194139533864 true] [17592186260693 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260693 1111 #uuid "ab16b9c5-9977-585e-b838-599705aeba9a" 13194139533864 true] [17592186260694 1017 #edb/ref 17592186260695 13194139533864 true] [17592186260694 1089 "q-5156" 13194139533864 true] [17592186260694 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260694 1100 "Factor ${t}^{4}-16.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260694 1113 #uuid "706f1b39-71a2-517a-b05a-ddde27e028de" 13194139533864 true] [17592186260694 1145 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{t}^{4}-16={({t}^{2})}^{2}-{4}^{2}\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n{({t}^{2})}^{2}-{4}^{2}=({t}^{2}+4)({t}^{2}-4)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}({t}^{2}+4)({t}^{2}-4) & =({t}^{2}+4)({t}^{2}-{2}^{2}) \\\\  & =({t}^{2}+4)(t+2)(t-2)\\end{aligned}\n$$" 13194139533864 true] [17592186260695 1000 #edb/ref 17592186260696 13194139533864 true] [17592186260695 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260695 1041 "answer" 13194139533864 true] [17592186260695 1104 #edb/ref 17592186260696 13194139533864 true] [17592186260695 1110 #uuid "26cb8504-091f-5e69-84cd-d1b1e36e3f99" 13194139533864 true] [17592186260696 1034 "({t}^{2}+4)(t+2)(t-2)" 13194139533864 true] [17592186260696 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260696 1111 #uuid "7920418e-af3c-5c66-b094-87b8928dd98c" 13194139533864 true] [17592186260697 1017 #edb/ref 17592186260698 13194139533864 true] [17592186260697 1089 "q-51567" 13194139533864 true] [17592186260697 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260697 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4585ab21f7130a45e2ff5871e0fdc66cda5483181033010519781d9725eec36a.png)\n\nThe graph of a periodic function $y=f(x)$ is shown above. What is the period of this function?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260697 1113 #uuid "d428032a-dc8a-5dbd-8dd9-59088ffcca86" 13194139533864 true] [17592186260697 1145 "Note that if we shift the graph $3$ units left or right, the graph remains unchanged.\n\nOn the other hand, if we shift the graph horizontally by any distance other than $3$ (or a multiple of $3$), we get a different graph.\n\nTherefore, the period of the function is $3.$" 13194139533864 true] [17592186260698 1000 #edb/ref 17592186260699 13194139533864 true] [17592186260698 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260698 1041 "answer" 13194139533864 true] [17592186260698 1104 #edb/ref 17592186260699 13194139533864 true] [17592186260698 1110 #uuid "3b6689cc-424a-5a03-b855-95578f1e475f" 13194139533864 true] [17592186260699 1034 "3" 13194139533864 true] [17592186260699 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260699 1111 #uuid "437dcd9d-2381-5665-8812-6db4db373dcb" 13194139533864 true] [17592186260700 1017 #edb/ref 17592186260701 13194139533864 true] [17592186260700 1089 "q-5165" 13194139533864 true] [17592186260700 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260700 1100 "Factor $3{x}^{4}-48.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260700 1113 #uuid "5a9dd0e6-6456-5413-b50a-4bf96b104572" 13194139533864 true] [17592186260700 1145 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms in our expression have a common factor of $3.$ To simplify the computation, we can factor out the $3,$ as follows:\n\n$$\n3{x}^{4}-48=3\\cdot {x}^{4}-3\\cdot 16=3({x}^{4}-16)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n3({x}^{4}-16)=3({({x}^{2})}^{2}-{4}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n3({({x}^{2})}^{2}-{4}^{2})=3({x}^{2}+4)({x}^{2}-4)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}3({x}^{2}+4)({x}^{2}-4) & =3({x}^{2}+4)({x}^{2}-{2}^{2}) \\\\  & =3({x}^{2}+4)(x+2)(x-2)\\end{aligned}\n$$" 13194139533864 true] [17592186260701 1000 #edb/ref 17592186260702 13194139533864 true] [17592186260701 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260701 1041 "answer" 13194139533864 true] [17592186260701 1104 #edb/ref 17592186260702 13194139533864 true] [17592186260701 1110 #uuid "ef137a8f-8a07-57cd-9a28-96dd910518f8" 13194139533864 true] [17592186260702 1034 "3({x}^{2}+4)(x+2)(x-2)" 13194139533864 true] [17592186260702 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260702 1111 #uuid "be9da5a2-0a9d-56da-b319-c3162727f00a" 13194139533864 true] [17592186260703 1017 #edb/ref 17592186260704 13194139533864 true] [17592186260703 1089 "q-5174" 13194139533864 true] [17592186260703 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260703 1100 "If ${log}_{2}x=3$, then what is $x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260703 1113 #uuid "51e5f7cc-f758-5b6e-9b53-61015feb7246" 13194139533864 true] [17592186260703 1145 "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $2,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{2}x & =3 \\\\ {2}^{{log}_{2}x} & ={2}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${2}^{{log}_{2}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={2}^{3} \\\\ x & =8.\\end{aligned}\n$$" 13194139533864 true] [17592186260704 1000 #edb/ref 17592186260705 13194139533864 true] [17592186260704 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260704 1041 "answer" 13194139533864 true] [17592186260704 1104 #edb/ref 17592186260705 13194139533864 true] [17592186260704 1110 #uuid "afb138c8-d5fe-521b-a16b-e38a7fd1ad20" 13194139533864 true] [17592186260705 1034 "8" 13194139533864 true] [17592186260705 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260705 1111 #uuid "5e1cdbb0-3158-56a8-8bf1-b12a39213539" 13194139533864 true] [17592186260706 1017 #edb/ref 17592186260707 13194139533864 true] [17592186260706 1089 "q-51843" 13194139533864 true] [17592186260706 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260706 1100 "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-3$ and ${a}_{2}=5,$ then ${a}_{4}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260706 1113 #uuid "aaf574a4-1edb-5e4e-ad18-e36c426d7d2b" 13194139533864 true] [17592186260706 1145 "To compute ${a}_{4},$ we first need to compute ${a}_{3}.$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}{a}_{n+2} & ={a}_{n+1}+{a}_{n} \\\\ {a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =5+(-3) \\\\ {a}_{3} & =2\\end{aligned}\n$$\n\nNext, to compute ${a}_{4},$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =2+5 \\\\ {a}_{4} & =7\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=7.$" 13194139533864 true] [17592186260707 1000 #edb/ref 17592186260708 13194139533864 true] [17592186260707 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260707 1041 "answer" 13194139533864 true] [17592186260707 1104 #edb/ref 17592186260708 13194139533864 true] [17592186260707 1110 #uuid "740de7d4-004d-5340-938d-4b8a451d2832" 13194139533864 true] [17592186260708 1034 "7" 13194139533864 true] [17592186260708 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260708 1111 #uuid "27dd64a2-7bd5-5f97-9dad-e0c5611a4652" 13194139533864 true] [17592186260709 1017 #edb/ref 17592186260710 13194139533864 true] [17592186260709 1089 "q-51884" 13194139533864 true] [17592186260709 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260709 1100 "If $f(n+2)=f(n+1)+f(n)$ with $f(1)=2$ and $f(2)=7,$ then $f(3)=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260709 1113 #uuid "1511ae51-ebcc-5ba6-b833-34f0d648c90d" 13194139533864 true] [17592186260709 1145 "The recursive formula is\n\n$$\nf(n+2)=f(n+1)+f(n).\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =7+2 \\\\ f(3) & =9.\\end{aligned}\n$$\n\nHence, $f(3)=9.$" 13194139533864 true] [17592186260710 1000 #edb/ref 17592186260711 13194139533864 true] [17592186260710 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260710 1041 "answer" 13194139533864 true] [17592186260710 1104 #edb/ref 17592186260711 13194139533864 true] [17592186260710 1110 #uuid "eee2c678-c53b-5c59-9f8e-f6f6412565fe" 13194139533864 true] [17592186260711 1034 "9" 13194139533864 true] [17592186260711 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260711 1111 #uuid "258fcf2a-82f0-5ea8-bd85-4a4bad015507" 13194139533864 true] [17592186260712 1017 #edb/ref 17592186260713 13194139533864 true] [17592186260712 1089 "q-5236" 13194139533864 true] [17592186260712 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260712 1100 "Express the following arithmetic series using sigma notation.\n\n$$\n4+1-2-…-20-23\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260712 1113 #uuid "4b147fea-e6ff-5e9f-b32f-ff0ababdac80" 13194139533864 true] [17592186260712 1145 "The first term ${a}_{1}=4$ and the common difference is:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =1-(4) \\\\  & =-3\\end{aligned}\n$$\n\nHence, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(-3) \\\\  & =4-3n+3 \\\\  & =7-3n\\end{aligned}\n$$\n\nWe don't know the index of the last term, but we can find it using the formula for the $n$th term:\n\n$$\n\\begin{aligned}{a}_{n} & =-23 \\\\ 7-3n & =-23 \\\\ 7+23 & =3n \\\\ 30 & =3n \\\\ 10 & =n\\end{aligned}\n$$\n\nThere are $10$ terms in total, from $n=1$ to $n=10.$ So, the sigma notation for the given sum is:\n\n$$\n{\\sum }_{n=1}^{10}(7-3n)\n$$" 13194139533864 true] [17592186260713 1000 #edb/ref 17592186260714 13194139533864 true] [17592186260713 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260713 1041 "answer" 13194139533864 true] [17592186260713 1104 #edb/ref 17592186260714 13194139533864 true] [17592186260713 1110 #uuid "fc093138-0c56-5346-b7af-a7d27bd79a9d" 13194139533864 true] [17592186260714 1034 "{\\sum }_{n=1}^{10}(7-3n)" 13194139533864 true] [17592186260714 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260714 1111 #uuid "ee1979b5-07d0-5b55-8b52-d7cb7cea2780" 13194139533864 true] [17592186260715 1017 #edb/ref 17592186260716 13194139533864 true] [17592186260715 1089 "q-52557" 13194139533864 true] [17592186260715 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260715 1100 "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=1$ and ${a}_{2}=6,$ then ${a}_{4}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260715 1113 #uuid "8a11f5a8-91b1-5863-9d5d-ca50ab4f8b49" 13194139533864 true] [17592186260715 1145 "The recursive formula is\n\n$$\n{a}_{n+2}={a}_{n+1}+{a}_{n}.\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =6+1 \\\\ {a}_{3} & =7\\end{aligned}\n$$\n\nSubstituting $n=2$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =7+6 \\\\ {a}_{4} & =13\\end{aligned}\n$$\n\nHence, ${a}_{4}=13.$" 13194139533864 true] [17592186260716 1000 #edb/ref 17592186260717 13194139533864 true] [17592186260716 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260716 1041 "answer" 13194139533864 true] [17592186260716 1104 #edb/ref 17592186260717 13194139533864 true] [17592186260716 1110 #uuid "047ab731-6e2a-50ae-8359-c91d287ccaa3" 13194139533864 true] [17592186260717 1034 "13" 13194139533864 true] [17592186260717 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260717 1111 #uuid "474158d3-9ce8-52f7-9f17-4787c83f481e" 13194139533864 true] [17592186260718 1017 #edb/ref 17592186260719 13194139533864 true] [17592186260718 1089 "q-5300" 13194139533864 true] [17592186260718 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260718 1100 "What is the sum of the arithmetic series ${\\sum }_{n=1}^{8}(-2n)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260718 1113 #uuid "ac22c321-341c-5b1a-8d5d-082d85416290" 13194139533864 true] [17592186260718 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nGiven the series ${\\sum }_{n=1}^{8}(-2n)$ in sigma notation, we note that\n\n- the total number of terms is $N=8$\n\n- the first term is ${a}_{1}=-2\\cdot 1=-2$\n\n- the last term is ${a}_{8}=-2\\cdot 8=-16$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we obtain:\n\n$$\n\\begin{aligned}{S}_{8} & =\\frac{8}{2}(-2+(-16)) \\\\  & =4(-18) \\\\  & =-72\\end{aligned}\n$$" 13194139533864 true] [17592186260719 1000 #edb/ref 17592186260720 13194139533864 true] [17592186260719 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260719 1041 "answer" 13194139533864 true] [17592186260719 1104 #edb/ref 17592186260720 13194139533864 true] [17592186260719 1110 #uuid "b530797f-f38a-5d88-8eb5-a1eb5d3c16a0" 13194139533864 true] [17592186260720 1034 "-72" 13194139533864 true] [17592186260720 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260720 1111 #uuid "817c3779-2936-58e7-a892-3e1f60da2e7f" 13194139533864 true] [17592186260721 1017 #edb/ref 17592186260722 13194139533864 true] [17592186260721 1089 "q-533" 13194139533864 true] [17592186260721 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260721 1100 "What is the value of ${\\text{i}}^{2}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260721 1113 #uuid "85fc0f28-62f8-538e-bd6b-a85278b14b50" 13194139533864 true] [17592186260721 1145 "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore, we have that ${\\text{i}}^{2}=-1.$" 13194139533864 true] [17592186260722 1000 #edb/ref 17592186260723 13194139533864 true] [17592186260722 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260722 1041 "answer" 13194139533864 true] [17592186260722 1104 #edb/ref 17592186260723 13194139533864 true] [17592186260722 1110 #uuid "cf132198-cedf-5b46-8c37-ea64c36630bb" 13194139533864 true] [17592186260723 1034 "-1" 13194139533864 true] [17592186260723 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260723 1111 #uuid "c1d65a6d-bf89-5a0a-82c2-a379c4c5fc50" 13194139533864 true] [17592186260724 1017 #edb/ref 17592186260725 13194139533864 true] [17592186260724 1089 "q-53707" 13194139533864 true] [17592186260724 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260724 1100 "Which of the following transformations map any polygon to a similar polygon?\n\nI. - Rotation by ${90}^{∘}$ counterclockwise around a point $O$\nII. - Reflection across the line $y=x$\nIII. - Translation by $2$ units downward, then reflection across the $y$-axis" 13194139533864 true] [17592186260724 1113 #uuid "1619c077-49d6-5e48-9ec7-0e73f45a0c3d" 13194139533864 true] [17592186260724 1145 "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I is a rotation, which is a rigid motion. Thus, it is a similarity transformation.\n\n- Transformation II is a reflection, which is also a rigid motion. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of translation and a reflection. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"I, II, and III.\"" 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260726 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260727 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260728 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260729 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260730 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260731 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260732 13194139533864 true] [17592186260725 1000 #edb/ref 17592186260733 13194139533864 true] [17592186260725 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260725 1041 "selection" 13194139533864 true] [17592186260725 1104 #edb/ref 17592186260726 13194139533864 true] [17592186260725 1110 #uuid "0cdedff1-749e-5f66-9b0d-e97ce597ac82" 13194139533864 true] [17592186260726 1034 "I, II, and III" 13194139533864 true] [17592186260726 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260726 1111 #uuid "59023a64-26c4-536d-8dde-931060606dd1" 13194139533864 true] [17592186260727 1034 "II and III only" 13194139533864 true] [17592186260727 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260727 1111 #uuid "fbef86b5-8e4f-5d00-8110-e4bf4686c160" 13194139533864 true] [17592186260728 1034 "I and III only" 13194139533864 true] [17592186260728 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260728 1111 #uuid "75a75933-3428-5e5e-b46a-2ed54e86b5e4" 13194139533864 true] [17592186260729 1034 "I only" 13194139533864 true] [17592186260729 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260729 1111 #uuid "4ef0d8bd-a31b-5645-a868-056b114c6e31" 13194139533864 true] [17592186260730 1034 "III only" 13194139533864 true] [17592186260730 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260730 1111 #uuid "814bed67-46ec-575f-a8ae-adc1ed17e415" 13194139533864 true] [17592186260731 1034 "I and II only" 13194139533864 true] [17592186260731 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260731 1111 #uuid "3dbf5293-70e3-58f3-aaa7-6c237f47bd6b" 13194139533864 true] [17592186260732 1034 "None of those listed" 13194139533864 true] [17592186260732 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260732 1111 #uuid "c7e770ba-8531-5c83-914e-39f596018db4" 13194139533864 true] [17592186260733 1034 "II only" 13194139533864 true] [17592186260733 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260733 1111 #uuid "0aba1027-d218-53d7-8a71-98065a34ecf3" 13194139533864 true] [17592186260734 1017 #edb/ref 17592186260735 13194139533864 true] [17592186260734 1089 "q-53708" 13194139533864 true] [17592186260734 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260734 1100 "Which of the following transformations map any polygon to a similar polygon?\n\nI. - Stretching with a stretch factor of $2$ in the $x$-direction and a stretch factor of $4$ in the $y$-direction\nII. - Translation by $3$ units to the left and $4$ units upward\nIII. - Dilation of scale factor $2$ with center $O,$ then reflection across the $y$-axis" 13194139533864 true] [17592186260734 1113 #uuid "588fd052-9e59-51dd-94e0-4bf0891bcc66" 13194139533864 true] [17592186260734 1145 "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I includes stretching with different factors in the $x$- and $y$-direction. Thus, it is not a similarity transformation.\n\n- Transformation II is a combination of two translations, which are rigid motions. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of dilation of scale factor $2$ and a reflection. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260736 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260737 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260738 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260739 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260740 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260741 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260742 13194139533864 true] [17592186260735 1000 #edb/ref 17592186260743 13194139533864 true] [17592186260735 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260735 1041 "selection" 13194139533864 true] [17592186260735 1104 #edb/ref 17592186260737 13194139533864 true] [17592186260735 1110 #uuid "6d48b603-1df0-5461-9d24-35d968e79fdd" 13194139533864 true] [17592186260736 1034 "I, II, and III" 13194139533864 true] [17592186260736 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260736 1111 #uuid "a3e4495b-139d-5866-a47e-ce97abbf6fc5" 13194139533864 true] [17592186260737 1034 "II and III only" 13194139533864 true] [17592186260737 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260737 1111 #uuid "15cf785b-2983-55a4-ad42-8fdd2f3019b6" 13194139533864 true] [17592186260738 1034 "I and III only" 13194139533864 true] [17592186260738 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260738 1111 #uuid "bda3f3ff-f263-5ced-ae65-4f7f16e76a88" 13194139533864 true] [17592186260739 1034 "I only" 13194139533864 true] [17592186260739 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260739 1111 #uuid "bd295e36-ebb3-5937-a21c-796f5e53a88a" 13194139533864 true] [17592186260740 1034 "III only" 13194139533864 true] [17592186260740 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260740 1111 #uuid "a70fb577-a5c2-5742-b5c1-2d14492e2ddb" 13194139533864 true] [17592186260741 1034 "I and II only" 13194139533864 true] [17592186260741 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260741 1111 #uuid "42bcf7ce-9945-591c-98e0-3fbaf24c2b01" 13194139533864 true] [17592186260742 1034 "None of those listed" 13194139533864 true] [17592186260742 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260742 1111 #uuid "332343e5-f574-585f-a7cf-a7ba25ad1cc8" 13194139533864 true] [17592186260743 1034 "II only" 13194139533864 true] [17592186260743 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260743 1111 #uuid "c96652f2-0d0f-52e0-afb8-eaef93aa99c2" 13194139533864 true] [17592186260744 1017 #edb/ref 17592186260745 13194139533864 true] [17592186260744 1017 #edb/ref 17592186260747 13194139533864 true] [17592186260744 1089 "q-53754" 13194139533864 true] [17592186260744 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260744 1100 "The equation of a curve is $3{x}^{2}-2{y}^{2}=9.$ The normal line at the point $(3,\\,3)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" 13194139533864 true] [17592186260744 1113 #uuid "91ee7106-7624-554e-a734-a1b55bccb844" 13194139533864 true] [17592186260744 1145 "First of all, we need to find the slope of the normal line at the point $(3,\\,3).$  Remember that the slope of the normal line, ${m}^{'},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{'}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}(3{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(2{y}^{2}) & =0 \\\\ 6x-4y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ -4y\\frac{\\text{d}y}{\\text{d}x} & =-6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-6x}{-4y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3x}{2y}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(3,\\,3)$ is \n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(3,\\,3)} \\\\  & ={(\\frac{3x}{2y})}_{(3,\\,3)} \\\\  & =\\frac{3\\cdot 3}{2\\cdot 3} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is ${m}^{'}=-\\frac{1}{m}=-\\frac{1}{3/2}=-\\frac{2}{3}.$ We can write the equation of the normal at the point $(3,\\,3)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{'}(x-{x}_{1}) \\\\ (y-3) & =-\\frac{2}{3}(x-3) \\\\ y & =-\\frac{2}{3}(x-3)+3\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}(x-3)+3 \\\\ y & =-\\frac{2}{3}(0-3)+3 \\\\ y & =-\\frac{2}{3}(-3)+3 \\\\ y & =2+3 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,5).$" 13194139533864 true] [17592186260745 1000 #edb/ref 17592186260746 13194139533864 true] [17592186260745 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260745 1041 "coordinate-1" 13194139533864 true] [17592186260745 1104 #edb/ref 17592186260746 13194139533864 true] [17592186260745 1110 #uuid "48897116-5235-5acf-94fe-bcd383de1cee" 13194139533864 true] [17592186260746 1034 "0" 13194139533864 true] [17592186260746 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260746 1111 #uuid "90209f67-483c-5e31-a0ad-bdd02e85f44a" 13194139533864 true] [17592186260747 1000 #edb/ref 17592186260748 13194139533864 true] [17592186260747 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260747 1041 "coordinate-2" 13194139533864 true] [17592186260747 1104 #edb/ref 17592186260748 13194139533864 true] [17592186260747 1110 #uuid "7b89e891-b1fa-58ac-b17a-34e1f3ff8d2e" 13194139533864 true] [17592186260748 1034 "\\,5" 13194139533864 true] [17592186260748 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260748 1111 #uuid "852d25b5-37c8-5917-8e19-a7a6fff4d1e1" 13194139533864 true] [17592186260749 1017 #edb/ref 17592186260750 13194139533864 true] [17592186260749 1089 "q-53755" 13194139533864 true] [17592186260749 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260749 1100 "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $2x{y}^{2}+\\operatorname{cos}({y}^{2})=3{x}^{3}+10$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260749 1113 #uuid "33cb77d7-6e78-5581-900a-a00f3718cb2e" 13194139533864 true] [17592186260749 1145 "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $2x{y}^{2}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(2x{y}^{2}+\\operatorname{cos}({y}^{2})) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{3}+10) \\\\ 2\\frac{\\text{d}}{\\text{d}x}(x{y}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}({y}^{2})) & =3\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}(10) \\\\ 2(2xy\\frac{\\text{d}y}{\\text{d}x}+{y}^{2})+(-2y\\operatorname{sin}({y}^{2}))\\frac{\\text{d}y}{\\text{d}x} & =9{x}^{2} \\\\ 4xy\\frac{\\text{d}y}{\\text{d}x}+2{y}^{2}+(-2y\\operatorname{sin}({y}^{2}))\\frac{\\text{d}y}{\\text{d}x} & =9{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}(4xy-2y\\operatorname{sin}({y}^{2}))\\frac{\\text{d}y}{\\text{d}x} & =9{x}^{2}-2{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{9{x}^{2}-2{y}^{2}}{4xy-2y\\operatorname{sin}({y}^{2})}\\end{aligned}\\end{aligned}\n$$" 13194139533864 true] [17592186260750 1000 #edb/ref 17592186260751 13194139533864 true] [17592186260750 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260750 1041 "answer" 13194139533864 true] [17592186260750 1104 #edb/ref 17592186260751 13194139533864 true] [17592186260750 1110 #uuid "3b3c0fb9-6237-5871-8361-29e4ea42065c" 13194139533864 true] [17592186260751 1034 "\\frac{9{x}^{2}-2{y}^{2}}{4xy-2y\\operatorname{sin}({y}^{2})}" 13194139533864 true] [17592186260751 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260751 1111 #uuid "c811d2c5-ded0-516d-b154-89ca184f076d" 13194139533864 true] [17592186260752 1017 #edb/ref 17592186260753 13194139533864 true] [17592186260752 1089 "q-538" 13194139533864 true] [17592186260752 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260752 1100 "${({\\text{i}}^{4})}^{2015}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260752 1113 #uuid "e22a5106-9b86-5df9-82bd-ae96786f3991" 13194139533864 true] [17592186260752 1145 "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{({\\text{i}}^{4})}^{2015}=(1)^{2015}=1.\n$$" 13194139533864 true] [17592186260753 1000 #edb/ref 17592186260754 13194139533864 true] [17592186260753 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260753 1041 "answer" 13194139533864 true] [17592186260753 1104 #edb/ref 17592186260754 13194139533864 true] [17592186260753 1110 #uuid "8df60c92-dcf7-5f84-9b2b-e78a9ed3f90b" 13194139533864 true] [17592186260754 1034 "1" 13194139533864 true] [17592186260754 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260754 1111 #uuid "da397cf0-577d-5fc2-a133-0ee5fec95c88" 13194139533864 true] [17592186260755 1017 #edb/ref 17592186260756 13194139533864 true] [17592186260755 1089 "q-54015" 13194139533864 true] [17592186260755 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260755 1100 "What is the distance between the points $(-1,1)$ and $(-3,-2)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260755 1113 #uuid "7024e369-0829-54d0-ba70-138c5c25ecf1" 13194139533864 true] [17592186260755 1145 "In this case, we have ${{(-1,1)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-3,-2)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$ \nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(-3-(-1))^{2}+(-2-1)^{2}} \\\\  & =\\sqrt{(-2)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}\\end{aligned}\n$$" 13194139533864 true] [17592186260756 1000 #edb/ref 17592186260757 13194139533864 true] [17592186260756 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260756 1041 "answer" 13194139533864 true] [17592186260756 1104 #edb/ref 17592186260757 13194139533864 true] [17592186260756 1110 #uuid "cc32d59f-5eaa-5dce-870c-1171f41b8fe8" 13194139533864 true] [17592186260757 1034 "\\sqrt{13}" 13194139533864 true] [17592186260757 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260757 1111 #uuid "a7672687-a15e-5c55-9924-d0a74b9e634c" 13194139533864 true] [17592186260758 1017 #edb/ref 17592186260759 13194139533864 true] [17592186260758 1089 "q-54448" 13194139533864 true] [17592186260758 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260758 1100 "${lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260758 1113 #uuid "0941c5e4-c170-5649-8bbf-3e710ae630e7" 13194139533864 true] [17592186260758 1145 "Let's sketch the graph of $y=\\operatorname{log}(2-7x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b4fcf2946431788963444f22bcd51b2a617b53dfc4bbfdd0d8b90bd9fd9304d2.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=\\infty \n$$" 13194139533864 true] [17592186260759 1000 #edb/ref 17592186260760 13194139533864 true] [17592186260759 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260759 1041 "answer" 13194139533864 true] [17592186260759 1104 #edb/ref 17592186260760 13194139533864 true] [17592186260759 1110 #uuid "6a6d3844-eda0-5060-8441-4edb3f922890" 13194139533864 true] [17592186260760 1034 "\\infty" 13194139533864 true] [17592186260760 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260760 1111 #uuid "773f25dd-c0e6-57b1-a3b9-3470cca31f88" 13194139533864 true] [17592186260761 1017 #edb/ref 17592186260762 13194139533864 true] [17592186260761 1089 "q-54449" 13194139533864 true] [17592186260761 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260761 1100 "${lim}_{x\\to -\\infty }(3x-\\operatorname{ln}(2x))=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260761 1113 #uuid "bc5e4f48-0994-54a5-be66-79482fad2c3c" 13194139533864 true] [17592186260761 1145 "Let's sketch the graph of $y=\\operatorname{ln}(2x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/cb507d2c8846ff1a55d2ff32c2db9264be34c008fff61098a3e3ad81d8c1c4de.png)\n\nThe function is not defined for $x\\le 0.$ Therefore,\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{ln}(2x)=\\text{DNE}\n$$\n\nSo, we can conclude that\n\n$$\n{lim}_{x\\to -\\infty }(3x-\\operatorname{ln}(2x))=\\text{DNE}\n$$" 13194139533864 true] [17592186260762 1000 #edb/ref 17592186260763 13194139533864 true] [17592186260762 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260762 1041 "answer" 13194139533864 true] [17592186260762 1104 #edb/ref 17592186260763 13194139533864 true] [17592186260762 1110 #uuid "261b7d51-097e-5d46-817e-da9e10b54961" 13194139533864 true] [17592186260763 1034 "\\text{DNE}" 13194139533864 true] [17592186260763 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260763 1111 #uuid "28629764-def0-5d1a-9a33-eef27711623b" 13194139533864 true] [17592186260764 1017 #edb/ref 17592186260765 13194139533864 true] [17592186260764 1089 "q-546" 13194139533864 true] [17592186260764 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260764 1100 "What is the value of ${\\text{i}}^{3}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260764 1113 #uuid "229ffe7b-501b-5f8e-8a23-2f28dfd64018" 13194139533864 true] [17592186260764 1145 "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore, we have that ${\\text{i}}^{3}=-\\text{i}.$" 13194139533864 true] [17592186260765 1000 #edb/ref 17592186260766 13194139533864 true] [17592186260765 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260765 1041 "answer" 13194139533864 true] [17592186260765 1104 #edb/ref 17592186260766 13194139533864 true] [17592186260765 1110 #uuid "81455e6a-1e14-5bc5-83bd-0eef65be8ca5" 13194139533864 true] [17592186260766 1034 "-\\text{i}" 13194139533864 true] [17592186260766 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260766 1111 #uuid "db6549fd-c3ae-50ba-a921-f0da391c0f40" 13194139533864 true] [17592186260767 1017 #edb/ref 17592186260768 13194139533864 true] [17592186260767 1017 #edb/ref 17592186260770 13194139533864 true] [17592186260767 1089 "q-54632" 13194139533864 true] [17592186260767 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260767 1100 "What are the solutions to $-24{t}^{2}-2=0?$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260767 1113 #uuid "34a045e8-fdb7-5bf9-9392-e9e2795878f6" 13194139533864 true] [17592186260767 1145 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}-24{t}^{2}-2 & =0 \\\\ -24{t}^{2} & =2 \\\\ {t}^{2} & =-\\frac{2}{24} \\\\ {t}^{2} & =-\\frac{1}{12}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nt=\\pm \\sqrt{-\\frac{1}{12}}\n$$\n\nWe now rewrite $t$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}t & =\\pm \\sqrt{-\\frac{1}{12}} \\\\  & =\\pm \\sqrt{\\frac{1}{12}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{1}{12}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{1}}{\\sqrt{12}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{1}}{2\\sqrt{3}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{1}{2\\sqrt{3}}\\text{i}\\end{aligned}\n$$\n\nFinally, we rationalize the denominator:\n\n$$\n\\begin{aligned}t & =\\pm \\frac{1}{2\\sqrt{3}}\\text{i} \\\\  & =\\pm \\frac{1}{2\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{3}}{6}\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260768 1000 #edb/ref 17592186260769 13194139533864 true] [17592186260768 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260768 1041 "negative-imaginary" 13194139533864 true] [17592186260768 1104 #edb/ref 17592186260769 13194139533864 true] [17592186260768 1110 #uuid "bc881db0-23a3-519b-9eac-a5a7cc486a8d" 13194139533864 true] [17592186260769 1034 "-\\frac{\\sqrt{3}}{6}\\text{i}" 13194139533864 true] [17592186260769 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260769 1111 #uuid "df91f6fb-ce3d-5528-802d-79e7b4a13d87" 13194139533864 true] [17592186260770 1000 #edb/ref 17592186260771 13194139533864 true] [17592186260770 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260770 1041 "positive-imaginary" 13194139533864 true] [17592186260770 1104 #edb/ref 17592186260771 13194139533864 true] [17592186260770 1110 #uuid "0445b6df-6822-5ad7-ad25-d1e3aa0428ce" 13194139533864 true] [17592186260771 1034 "\\frac{\\sqrt{3}}{6}\\text{i}" 13194139533864 true] [17592186260771 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260771 1111 #uuid "a80b6205-4143-51b2-8a80-4275d5744a71" 13194139533864 true] [17592186260772 1017 #edb/ref 17592186260773 13194139533864 true] [17592186260772 1089 "q-549" 13194139533864 true] [17592186260772 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260772 1100 "${\\text{i}}^{14}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260772 1113 #uuid "f8437f94-1d26-5f61-9246-7a0a4a80faa9" 13194139533864 true] [17592186260772 1145 "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=14.$ Dividing the power by $4,$ we get\n\n$$\n14÷4=3\\,\\text{R}2.\n$$\n\nSo the remainder is $2.$ Therefore,\n\n$$\n{\\text{i}}^{14}={\\text{i}}^{2}=-1.\n$$" 13194139533864 true] [17592186260773 1000 #edb/ref 17592186260774 13194139533864 true] [17592186260773 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260773 1041 "answer" 13194139533864 true] [17592186260773 1104 #edb/ref 17592186260774 13194139533864 true] [17592186260773 1110 #uuid "690025c3-3162-54f0-9482-c6813f64a78f" 13194139533864 true] [17592186260774 1034 "-1" 13194139533864 true] [17592186260774 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260774 1111 #uuid "b721c5a8-f447-5d0a-8137-886105d797b1" 13194139533864 true] [17592186260775 1017 #edb/ref 17592186260776 13194139533864 true] [17592186260775 1089 "q-56" 13194139533864 true] [17592186260775 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260775 1100 "$\\sqrt{-9}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260775 1113 #uuid "1f6501a8-c1cf-5be1-848d-9970c0779f7f" 13194139533864 true] [17592186260775 1145 "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}\\sqrt{-9} & =\\sqrt{9\\cdot (-1)} \\\\  & =\\sqrt{9}\\cdot \\sqrt{-1} \\\\  & =3\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260776 1000 #edb/ref 17592186260777 13194139533864 true] [17592186260776 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260776 1041 "answer" 13194139533864 true] [17592186260776 1104 #edb/ref 17592186260777 13194139533864 true] [17592186260776 1110 #uuid "27cf63c4-461e-590f-b47c-292436c38438" 13194139533864 true] [17592186260777 1034 "3\\text{i}" 13194139533864 true] [17592186260777 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260777 1111 #uuid "40519f37-cbd5-57a8-838b-c1d3330cdaf6" 13194139533864 true] [17592186260778 1017 #edb/ref 17592186260779 13194139533864 true] [17592186260778 1089 "q-575" 13194139533864 true] [17592186260778 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260778 1100 "If $a={\\text{i}}^{2}$ then ${a}^{4}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260778 1113 #uuid "feb815e0-49a2-5a08-9510-a18cd36fc9e1" 13194139533864 true] [17592186260778 1145 "Using the power law for exponents, we have\n\n$$\n{a}^{4}={({\\text{i}}^{2})}^{4}={\\text{i}}^{2\\cdot 4}={\\text{i}}^{8}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=8.$ Dividing the power by $4,$ we get\n\n$$\n8÷4=2\\,\\text{R}0.\n$$\n\nSo the remainder is $0.$ Therefore,\n\n$$\n{\\text{i}}^{8}={\\text{i}}^{0}=1.\n$$" 13194139533864 true] [17592186260779 1000 #edb/ref 17592186260780 13194139533864 true] [17592186260779 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260779 1041 "answer" 13194139533864 true] [17592186260779 1104 #edb/ref 17592186260780 13194139533864 true] [17592186260779 1110 #uuid "e656be50-0e8a-5b00-a570-bb0ae760e03d" 13194139533864 true] [17592186260780 1034 "1" 13194139533864 true] [17592186260780 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260780 1111 #uuid "841e8a1a-3c8b-5f97-965f-40251f13efe6" 13194139533864 true] [17592186260781 1017 #edb/ref 17592186260782 13194139533864 true] [17592186260781 1089 "q-5759" 13194139533864 true] [17592186260781 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260781 1100 "You're buying a new computer and can choose different options: $3$ different levels of RAM, $2$ different hard drive sizes, $3$ different monitor sizes, and $4$ different colors.  How many different computer systems can you create from these choices?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260781 1113 #uuid "749914bf-d1a3-5489-91da-4a74ce2608f3" 13194139533864 true] [17592186260781 1145 "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of computer systems} & =\\text{Number of RAM levels} \\\\  & \\times \\text{Number of hard drive sizes} \\\\  & \\times \\text{Number of monitor sizes} \\\\  & \\times \\text{Number of colors} \\\\  & =3\\times 2\\times 3\\times 4 \\\\  & =72.\\end{aligned}\n$$\n\nTherefore, we can create $72$ different computer systems." 13194139533864 true] [17592186260782 1000 #edb/ref 17592186260783 13194139533864 true] [17592186260782 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260782 1041 "answer" 13194139533864 true] [17592186260782 1104 #edb/ref 17592186260783 13194139533864 true] [17592186260782 1110 #uuid "31c1f32f-a92e-5062-8efa-0e6b7f45f5da" 13194139533864 true] [17592186260783 1034 "72" 13194139533864 true] [17592186260783 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260783 1111 #uuid "917b7239-d1a9-58a5-ae89-76e89f4a79c1" 13194139533864 true] [17592186260784 1017 #edb/ref 17592186260785 13194139533864 true] [17592186260784 1089 "q-5760" 13194139533864 true] [17592186260784 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260784 1100 "You're letting your computer make random songs using $5$ different notes, and you want the song to be $32$ notes long. All $32$ notes have the same duration. If notes can be repeated, how many different songs can your computer create?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260784 1113 #uuid "98158fcc-db0f-530b-87f1-367cdd949729" 13194139533864 true] [17592186260784 1145 "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of songs} & =\\text{Number of choices for the }1\\text{st note} \\\\  & \\times \\text{Number of choices for the }2\\text{nd note} \\\\  & \\times \\text{Number of choices for the }3\\text{rd note} \\\\  & \\times … \\\\  & \\times \\text{Number of choices for the }32\\text{nd note} \\\\  & ={{5\\times 5\\times 5\\times ⋯\\times 5}_{⏟}}_{32\\text{ times}} \\\\  & ={5}^{32}.\\end{aligned}\n$$\n\nTherefore, the computer can create ${5}^{32}$ different songs." 13194139533864 true] [17592186260785 1000 #edb/ref 17592186260786 13194139533864 true] [17592186260785 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260785 1041 "answer" 13194139533864 true] [17592186260785 1104 #edb/ref 17592186260786 13194139533864 true] [17592186260785 1110 #uuid "c2b84597-acc5-5c3d-9c3c-d9cb9cddc42b" 13194139533864 true] [17592186260786 1034 "{5}^{32}" 13194139533864 true] [17592186260786 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260786 1111 #uuid "dfad00bb-0495-5532-915c-4c3d81a054c0" 13194139533864 true] [17592186260787 1017 #edb/ref 17592186260788 13194139533864 true] [17592186260787 1089 "q-60150" 13194139533864 true] [17592186260787 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260787 1100 "In a zoo, there are $12$ camels. If the ratio of camels to monkeys is $3:7,$ how many monkeys are there in the zoo?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260787 1113 #uuid "2b7399af-5c1c-5c70-8b98-f78b69b577eb" 13194139533864 true] [17592186260787 1145 "We start with the ratio $3:7$ and write it as a fraction:\n\n$$\n\\frac{3}{7}\n$$\n\nIn this fraction, the numerator represents the number of camels and the denominator represents the number of monkeys.\n\nWe can make a numerator of $12$ by multiplying the numerator and denominator by $4$:\n\n$$\n\\frac{3\\times 4}{7\\times 4}=\\frac{12}{28}\n$$\n\nTherefore, there are $28$ monkeys in the zoo." 13194139533864 true] [17592186260788 1000 #edb/ref 17592186260789 13194139533864 true] [17592186260788 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260788 1041 "answer" 13194139533864 true] [17592186260788 1104 #edb/ref 17592186260789 13194139533864 true] [17592186260788 1110 #uuid "69b03fbc-9c09-5a05-9e92-855079d6d16c" 13194139533864 true] [17592186260789 1034 "28" 13194139533864 true] [17592186260789 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260789 1111 #uuid "ccced504-eda8-5d95-8eb9-d594c37589c1" 13194139533864 true] [17592186260790 1017 #edb/ref 17592186260791 13194139533864 true] [17592186260790 1089 "q-6054" 13194139533864 true] [17592186260790 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260790 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/15f17827141a0a31a7b748ab93c6811afcebd8c66781642554814f126aab8add.png)\n\nWhat is the inequality that describes the shaded region shown above?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260790 1113 #uuid "c65e4d48-c1de-5aac-888f-ff1772c474c0" 13194139533864 true] [17592186260790 1145 "First, we find the equation of the corresponding line in the slope-intercept form $y=mx+b.$\n\n- The line intercepts the $y$-axis at $(0,-1)$, so the $y$-intercept is $b=-1.$\n\n- The line passes through the points $(0,-1)$ and $(2,0)$, so its slope is\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{0-(-1)}{2-0}=\\frac{1}{2}=\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the equation of the line is $y=\\frac{x}{2}-1.$\n\nFinally, we need to decide which inequality symbol to use. Since the line is solid, we will use an \"or equal to\" inequality. Since the shaded region is *above* the line, the inequality refers to the $y$-values that are *greater than* or equal to those on the line.\n\nSo, the corresponding inequality is\n\n$$\ny\\ge \\frac{x}{2}-1.\n$$" 13194139533864 true] [17592186260791 1000 #edb/ref 17592186260792 13194139533864 true] [17592186260791 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260791 1041 "answer" 13194139533864 true] [17592186260791 1104 #edb/ref 17592186260792 13194139533864 true] [17592186260791 1110 #uuid "0d14d67f-4f11-54bb-a59c-80951a1501bf" 13194139533864 true] [17592186260792 1034 "y\\ge \\frac{x}{2}-1" 13194139533864 true] [17592186260792 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260792 1111 #uuid "0da948e5-8e68-529a-910f-d75505610a94" 13194139533864 true] [17592186260793 1017 #edb/ref 17592186260794 13194139533864 true] [17592186260793 1089 "q-6056" 13194139533864 true] [17592186260793 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260793 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/687a951c9cb6e0aaedb444d2ceaede6cb23e8d78198ec66d9dddbf3631dfcd52.png)\n\nWhat is the inequality that describes the shaded region shown above?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260793 1113 #uuid "458f851b-8b42-5a2e-8f64-02fe7feb2c7b" 13194139533864 true] [17592186260793 1145 "First, we find the equation of the corresponding line in the slope-intercept form $y=mx+b.$\n\n- The line intercepts the $y$-axis at $(0,0)$, so the $y$-intercept is $b=0.$\n\n- The line passes through the points $(0,0)$ and $(2,3)$, so its slope is\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{3-0}{2-0}=\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the equation of the line is $y=\\frac{3x}{2}.$\n\nFinally, we need to decide which inequality symbol to use. Since the line is solid, we will use an \"or equal to\" inequality. Since the shaded region is *below* the line, the inequality refers to the $y$-values that are *less than* or equal to those on the line.\n\nSo, the corresponding inequality is\n\n$$\ny\\le \\frac{3x}{2}.\n$$" 13194139533864 true] [17592186260794 1000 #edb/ref 17592186260795 13194139533864 true] [17592186260794 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260794 1041 "answer" 13194139533864 true] [17592186260794 1104 #edb/ref 17592186260795 13194139533864 true] [17592186260794 1110 #uuid "b3a89d57-9ac5-568c-b8ed-25d62bfdbb01" 13194139533864 true] [17592186260795 1034 "y\\le \\frac{3x}{2}" 13194139533864 true] [17592186260795 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260795 1111 #uuid "3fdad7ef-9f9b-5099-afbb-630b72506a83" 13194139533864 true] [17592186260796 1017 #edb/ref 17592186260797 13194139533864 true] [17592186260796 1089 "q-61" 13194139533864 true] [17592186260796 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260796 1100 "$\\sqrt{-13}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260796 1113 #uuid "b2a63fca-c627-59bf-af30-ba385e73b94c" 13194139533864 true] [17592186260796 1145 "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}\\sqrt{-13} & =\\sqrt{13\\cdot (-1)} \\\\  & =\\sqrt{13}\\cdot \\sqrt{-1} \\\\  & =\\sqrt{13}\\,\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260797 1000 #edb/ref 17592186260798 13194139533864 true] [17592186260797 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260797 1041 "answer" 13194139533864 true] [17592186260797 1104 #edb/ref 17592186260798 13194139533864 true] [17592186260797 1110 #uuid "1eb2f41e-7435-5ec1-aaad-140347f5d156" 13194139533864 true] [17592186260798 1034 "\\sqrt{13}\\,\\text{i}" 13194139533864 true] [17592186260798 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260798 1111 #uuid "f1ed1f0a-dc2e-51e1-8893-15c29b747a65" 13194139533864 true] [17592186260799 1017 #edb/ref 17592186260800 13194139533864 true] [17592186260799 1089 "q-62235" 13194139533864 true] [17592186260799 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260799 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e6597958db4f674e475a4795e51e3367b775807e67342aa69c7c3d31506ee58c.png)\n\nKate wants to paint a roof that has the form of a square pyramid, as shown above. Find the total surface area that she needs to paint if all four sides have the same surface area. Note that Kate does *not* need to paint the base.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260799 1113 #uuid "8a392e0a-6df0-5552-9026-7e13f4379af2" 13194139533864 true] [17592186260799 1145 "The net of our pyramid is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b06219065dd4f22d12056a759d7d10f0a0f44a096f5808e37fb71ff081ab4471.png)\n\n$$\n\n$$\n\nEach side face of our solid is a triangle, where the base is $5\\,\\text{m}$ and the height is $8\\,\\text{m}.$ Therefore\n\n$$\n\\text{Area of the triangle}=\\frac{1}{2}\\times 5\\times 8=20\\,{\\text{m}}^{2}.\n$$\n\nNow, the total area of the side surfaces consists of $4$ triangular faces. \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area of the sides} & =4\\times (\\text{Area of the triangle}) \\\\  & =4\\times 20 \\\\  & =80\\,{\\text{m}}^{2}.\\end{aligned}\n$$\n\nSo, Kate has to paint $80\\,{\\text{m}}^{2}$ of the roof." 13194139533864 true] [17592186260800 1000 #edb/ref 17592186260801 13194139533864 true] [17592186260800 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260800 1041 "answer" 13194139533864 true] [17592186260800 1104 #edb/ref 17592186260801 13194139533864 true] [17592186260800 1110 #uuid "7a714b0b-b324-5520-b12a-af0a549590d9" 13194139533864 true] [17592186260801 1034 "80\\,{\\text{m}}^{2}" 13194139533864 true] [17592186260801 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260801 1111 #uuid "e9275b7b-fb67-5c75-a88f-8d4a402bc14b" 13194139533864 true] [17592186260802 1017 #edb/ref 17592186260803 13194139533864 true] [17592186260802 1089 "q-62257" 13194139533864 true] [17592186260802 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260802 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7e357b1ade83f266d357c41d754a381ce9cdfd9a5fdc9e16ba773af220df198a.png)\n\nAssuming that all side faces have the same height of $6\\,\\text{ft}$, find the total surface area of the square pyramid above using its net.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260802 1113 #uuid "a88baf4a-b3d0-5e0e-af18-5660583efd32" 13194139533864 true] [17592186260802 1145 "The net of our pyramid is the following.\n\n$$\n\n$$\n\nFirst, notice that the base of the pyramid is a square with a side equal to $4\\,\\text{ft}.$ Hence:\n\n$$\n\\text{Area of the square}=4\\times 4=16\\,{\\text{ft}}^{2}.\n$$\n\n \n\nEach side face of our solid is triangle, where the base is $4\\,\\text{ft}$ and the height is $6\\,\\text{ft}.$ Therefore:\n\n$$\n\\text{Area of the triangle}=\\frac{1}{2}\\times 4\\times 6=12\\,{\\text{ft}}^{2}.\n$$\n\nFinally, the surface area of the pyramid consists of $1$ square (base) and $4$ triangles (side faces). \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =(\\text{Area of the square})+4\\times (\\text{Area of the triangle}) \\\\  & =16+4\\times 48 \\\\  & =16+48 \\\\  & =64\\,{\\text{ft}}^{2}.\\end{aligned}\n$$" 13194139533864 true] [17592186260803 1000 #edb/ref 17592186260804 13194139533864 true] [17592186260803 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260803 1041 "answer" 13194139533864 true] [17592186260803 1104 #edb/ref 17592186260804 13194139533864 true] [17592186260803 1110 #uuid "0286acbb-2f4d-5e1c-b288-8132393d69cd" 13194139533864 true] [17592186260804 1034 "64\\,{\\text{ft}}^{2}" 13194139533864 true] [17592186260804 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260804 1111 #uuid "6365d04f-b261-5fe5-8a1d-89e22df8935f" 13194139533864 true] [17592186260805 1017 #edb/ref 17592186260806 13194139533864 true] [17592186260805 1089 "q-6397" 13194139533864 true] [17592186260805 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260805 1100 "Given that $k\\ge 0$ is an integer, simplify $\\frac{(k+3)!}{(k+1)k!}.$" 13194139533864 true] [17592186260805 1113 #uuid "1390df05-6bca-5037-aa71-abe139ff704c" 13194139533864 true] [17592186260805 1145 "First, notice the following:\n\n$$\n(k+3)!=(k+3)\\cdot (k+2)\\cdot (k+1)\\cdot k!\n$$\n\nThen, we cancel the $k!$ and $(k+1)$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+3)!}{(k+1)k!}= & \\frac{(k+3)\\cdot (k+2)\\cdot (k+1)\\cdot k!}{(k+1)\\cdot k!} \\\\ = & \\frac{(k+3)\\cdot (k+2)\\cdot \\cancel{(k+1)}\\cdot \\cancel{k!}}{\\cancel{(k+1)}\\cdot \\cancel{k!}} \\\\ = & (k+3)(k+2) \\\\ = & {k}^{2}+5k+6\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186260806 1000 #edb/ref 17592186260807 13194139533864 true] [17592186260806 1000 #edb/ref 17592186260808 13194139533864 true] [17592186260806 1000 #edb/ref 17592186260809 13194139533864 true] [17592186260806 1000 #edb/ref 17592186260810 13194139533864 true] [17592186260806 1000 #edb/ref 17592186260811 13194139533864 true] [17592186260806 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260806 1041 "selection" 13194139533864 true] [17592186260806 1104 #edb/ref 17592186260808 13194139533864 true] [17592186260806 1110 #uuid "b54fd3d2-3af0-5e41-8978-da67e08d4bbb" 13194139533864 true] [17592186260807 1034 "k+2" 13194139533864 true] [17592186260807 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260807 1111 #uuid "9a4fc142-f8be-5f31-882a-e83b75f5f1ee" 13194139533864 true] [17592186260808 1034 "{k}^{2}+5k+6" 13194139533864 true] [17592186260808 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260808 1111 #uuid "b73b0fee-d32e-56aa-ad42-83d1a7c3fa14" 13194139533864 true] [17592186260809 1034 "{k}^{2}-3k+1" 13194139533864 true] [17592186260809 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260809 1111 #uuid "9fd33fda-aef8-5fb6-b1e9-74d1da876554" 13194139533864 true] [17592186260810 1034 "{k}^{2}+2k+3" 13194139533864 true] [17592186260810 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260810 1111 #uuid "3c092cc7-e57c-5648-9b3e-ba3be80ea005" 13194139533864 true] [17592186260811 1034 "k+3" 13194139533864 true] [17592186260811 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260811 1111 #uuid "8dd55d92-a16d-5694-9a50-729422e0bc37" 13194139533864 true] [17592186260812 1017 #edb/ref 17592186260813 13194139533864 true] [17592186260812 1089 "q-63983" 13194139533864 true] [17592186260812 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260812 1100 "What is the index of the term $192$ for the geometric sequence below?\n\n$$\nf(n+1)=2f(n),\\,f(1)=3,\\,n\\ge 1\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260812 1113 #uuid "4bb8271f-112b-50bc-8969-18efd4c79667" 13194139533864 true] [17592186260812 1145 "This geometric sequence is given as a recurrence relation, i.e.,\n\n$$\nf(n+1)=r\\cdot f(n).\n$$\n\nTherefore:\n\n$$\nf(1)=3,\\,r=2.\n$$\n\nWe're interested in finding $n$ such that $f(n)=192.$ Using the formula for the $n$th term, we get:\n\n$$\n\\begin{aligned}f(n) & =f(1)\\cdot {r}^{n-1} \\\\ 192 & =3\\cdot {2}^{n-1} \\\\ \\frac{192}{3} & ={2}^{n-1} \\\\ 64 & ={2}^{n-1} \\\\ {2}^{6} & ={2}^{n-1}\\end{aligned}\n$$\n\nEquating the exponents gives:\n\n$$\n6=n-1\\,⟹\\,n=7\n$$\n\nTherefore, $192$ is the $7$th term of the sequence." 13194139533864 true] [17592186260813 1000 #edb/ref 17592186260814 13194139533864 true] [17592186260813 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260813 1041 "answer" 13194139533864 true] [17592186260813 1104 #edb/ref 17592186260814 13194139533864 true] [17592186260813 1110 #uuid "7ba5a909-4d46-51cf-a875-7ce7b06f88a4" 13194139533864 true] [17592186260814 1034 "7" 13194139533864 true] [17592186260814 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260814 1111 #uuid "0279c069-a67d-5613-b216-68b81778d8dc" 13194139533864 true] [17592186260815 1017 #edb/ref 17592186260816 13194139533864 true] [17592186260815 1089 "q-64010" 13194139533864 true] [17592186260815 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260815 1100 "The third term of a geometric sequence is $108$ and its fifth term is $3.$  Find the common ratio $r$ of this sequence given that $r$ is positive.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260815 1113 #uuid "76388739-1ca8-5045-add3-33e80a2c5254" 13194139533864 true] [17592186260815 1145 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{5}=3$ and ${a}_{3}=108.$ Substituting $n=5$ and $m=3$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{5-3} & =\\frac{{a}_{5}}{{a}_{3}} \\\\ {r}^{2} & =\\frac{3}{108} \\\\ {r}^{2} & =\\frac{1}{36}.\\end{aligned}\n$$\n\nFinally, solving the equation for $r$ and considering that $r$ is positive, we get\n\n$$\n\\begin{aligned}{r}^{2} & =\\frac{1}{36} \\\\ {r}^{2} & ={(\\frac{1}{6})}^{2} \\\\ r & =\\frac{1}{6}.\\end{aligned}\n$$" 13194139533864 true] [17592186260816 1000 #edb/ref 17592186260817 13194139533864 true] [17592186260816 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260816 1041 "answer" 13194139533864 true] [17592186260816 1104 #edb/ref 17592186260817 13194139533864 true] [17592186260816 1110 #uuid "2642f3cb-c89f-58d1-845c-061ebbb035a5" 13194139533864 true] [17592186260817 1034 "\\frac{1}{6}" 13194139533864 true] [17592186260817 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260817 1111 #uuid "5f7157fd-8e05-5d45-a87c-b26a10f3d7b0" 13194139533864 true] [17592186260818 1017 #edb/ref 17592186260819 13194139533864 true] [17592186260818 1089 "q-6447" 13194139533864 true] [17592186260818 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260818 1100 "The arithmetic series $4+10+16+22+28+34+40$ can be written in sigma notation as\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260818 1113 #uuid "def295e5-6bc1-5660-bf4c-3c6ddeefa998" 13194139533864 true] [17592186260818 1145 "The first term is ${a}_{1}=4$ and the common difference is: \n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =10-4 \\\\  & =6\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(6) \\\\  & =4+6n-6 \\\\  & =6n-2\\end{aligned}\n$$\n\nThere are $7$ terms in total, from $n=1$ to $n=7.$ So the sigma notation for the given sum is:\n\n$$\n{\\sum }_{n=1}^{7}(6n-2)\n$$" 13194139533864 true] [17592186260819 1000 #edb/ref 17592186260820 13194139533864 true] [17592186260819 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260819 1041 "answer" 13194139533864 true] [17592186260819 1104 #edb/ref 17592186260820 13194139533864 true] [17592186260819 1110 #uuid "876b68a7-80d5-5bc0-b0d3-a7e1849858a6" 13194139533864 true] [17592186260820 1034 "{\\sum }_{n=1}^{7}(6n-2)" 13194139533864 true] [17592186260820 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260820 1111 #uuid "33eeb54b-38bc-58d5-b90e-312ae4fb437e" 13194139533864 true] [17592186260821 1017 #edb/ref 17592186260822 13194139533864 true] [17592186260821 1089 "q-64678" 13194139533864 true] [17592186260821 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260821 1100 "The angle $\\theta =-{650}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" 13194139533864 true] [17592186260821 1113 #uuid "0e21b7ac-5788-524c-8ceb-e2c5880c1015" 13194139533864 true] [17592186260821 1145 "First, we find an angle that's coterminal with $-{650}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $({0}^{∘},{360}^{∘}].$\n\n- $-{650}^{∘}+{360}^{∘}=-{290}^{∘}$\n\n- $-{650}^{∘}+2\\cdot {360}^{∘}={70}^{∘}\\,✓$\n\nSo the angle ${70}^{∘}$ is coterminal with $-{650}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/8dff305410da2b49c69006fdb84b4de6b481ccf2a526f42b18d2eae538601bfb.png)\n\nWe see that ${70}^{∘}$ lies in quadrant I. Therefore, $-{650}^{∘}$ also lies in this quadrant." 13194139533864 true] [17592186260822 1000 #edb/ref 17592186260823 13194139533864 true] [17592186260822 1000 #edb/ref 17592186260824 13194139533864 true] [17592186260822 1000 #edb/ref 17592186260825 13194139533864 true] [17592186260822 1000 #edb/ref 17592186260826 13194139533864 true] [17592186260822 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260822 1041 "selection" 13194139533864 true] [17592186260822 1104 #edb/ref 17592186260824 13194139533864 true] [17592186260822 1110 #uuid "4a2c4789-d7f3-566b-8e6b-156289316c1f" 13194139533864 true] [17592186260823 1034 "Quadrant II" 13194139533864 true] [17592186260823 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260823 1111 #uuid "40cfb998-cdc7-5a8a-9862-40b40601bcad" 13194139533864 true] [17592186260824 1034 "Quadrant I" 13194139533864 true] [17592186260824 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260824 1111 #uuid "74a27f2d-4de7-5c12-bf80-2bc0547ebf19" 13194139533864 true] [17592186260825 1034 "Quadrant III" 13194139533864 true] [17592186260825 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260825 1111 #uuid "949b5bce-4f4d-5782-b3a1-58fb0babf6a0" 13194139533864 true] [17592186260826 1034 "Quadrant IV" 13194139533864 true] [17592186260826 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260826 1111 #uuid "73c35910-0338-58bf-9e5d-77001c9a61d9" 13194139533864 true] [17592186260827 1017 #edb/ref 17592186260828 13194139533864 true] [17592186260827 1089 "q-64684" 13194139533864 true] [17592186260827 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260827 1100 "The angle $\\theta =\\frac{17\\pi }{6}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" 13194139533864 true] [17592186260827 1113 #uuid "45b2051b-479f-542d-97fb-8807ff31a294" 13194139533864 true] [17592186260827 1145 "First, we find an angle that's coterminal with $\\frac{17\\pi }{6}$ by *subtracting* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $\\frac{17\\pi }{6}-2\\pi =\\frac{5\\pi }{6}\\,✓$\n\nSo the angle $\\frac{17\\pi }{6}$ is coterminal with $\\frac{5\\pi }{6}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1c7c1d3a8d69502521dc71f24335ff79e707867161b95d6a80eaf95c0bf6e36c.png)\n\nWe see that $\\frac{5\\pi }{6}$ lies in quadrant II. Therefore, $\\frac{17\\pi }{6}$ also lies in this quadrant." 13194139533864 true] [17592186260828 1000 #edb/ref 17592186260829 13194139533864 true] [17592186260828 1000 #edb/ref 17592186260830 13194139533864 true] [17592186260828 1000 #edb/ref 17592186260831 13194139533864 true] [17592186260828 1000 #edb/ref 17592186260832 13194139533864 true] [17592186260828 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260828 1041 "selection" 13194139533864 true] [17592186260828 1104 #edb/ref 17592186260829 13194139533864 true] [17592186260828 1110 #uuid "3612bfb5-d8b9-5b06-9025-f70807e1466e" 13194139533864 true] [17592186260829 1034 "Quadrant II" 13194139533864 true] [17592186260829 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260829 1111 #uuid "8a098b45-c2e8-5184-ad1b-26d16ee81d23" 13194139533864 true] [17592186260830 1034 "Quadrant I" 13194139533864 true] [17592186260830 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260830 1111 #uuid "712753df-61f6-5b8d-aac1-8334199f6c95" 13194139533864 true] [17592186260831 1034 "Quadrant III" 13194139533864 true] [17592186260831 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260831 1111 #uuid "f1ce7416-c18b-595c-8946-699ee597f39c" 13194139533864 true] [17592186260832 1034 "Quadrant IV" 13194139533864 true] [17592186260832 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260832 1111 #uuid "43d72985-f62c-5dcf-b5d5-ca0c6215fc29" 13194139533864 true] [17592186260833 1017 #edb/ref 17592186260834 13194139533864 true] [17592186260833 1089 "q-64685" 13194139533864 true] [17592186260833 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260833 1100 "The angle $\\theta =-\\frac{4\\pi }{3}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" 13194139533864 true] [17592186260833 1113 #uuid "838287b6-8054-530d-a9fc-68e77332ddb3" 13194139533864 true] [17592186260833 1145 "First, we find an angle that's coterminal with $-\\frac{4\\pi }{3}$ by *adding* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $-\\frac{4\\pi }{3}+2\\pi =\\frac{2\\pi }{3}\\,✓$\n\nSo the angle $-\\frac{4\\pi }{3}$ is coterminal with $\\frac{2\\pi }{3}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b5397fc107a7425c822a9d00a169fa7c3624a3e29e3a8266897d459f19ac1aee.png)\n\nWe see that $\\frac{2\\pi }{3}$ lies in quadrant II. Therefore, $-\\frac{4\\pi }{3}$ also lies in this quadrant." 13194139533864 true] [17592186260834 1000 #edb/ref 17592186260835 13194139533864 true] [17592186260834 1000 #edb/ref 17592186260836 13194139533864 true] [17592186260834 1000 #edb/ref 17592186260837 13194139533864 true] [17592186260834 1000 #edb/ref 17592186260838 13194139533864 true] [17592186260834 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260834 1041 "selection" 13194139533864 true] [17592186260834 1104 #edb/ref 17592186260835 13194139533864 true] [17592186260834 1110 #uuid "fc8f9d6b-fcbc-5fd8-9a0d-eb8398e0a69b" 13194139533864 true] [17592186260835 1034 "Quadrant II" 13194139533864 true] [17592186260835 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260835 1111 #uuid "c3060ff9-5832-5483-b4f6-621dd4a0844d" 13194139533864 true] [17592186260836 1034 "Quadrant I" 13194139533864 true] [17592186260836 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260836 1111 #uuid "8eb093f3-6cd5-5f4f-9458-696e29118eb4" 13194139533864 true] [17592186260837 1034 "Quadrant III" 13194139533864 true] [17592186260837 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260837 1111 #uuid "80d886b1-7b9b-5484-9d4b-45199d952142" 13194139533864 true] [17592186260838 1034 "Quadrant IV" 13194139533864 true] [17592186260838 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260838 1111 #uuid "d843c8f7-8868-5f25-bca3-74331a0671cb" 13194139533864 true] [17592186260839 1017 #edb/ref 17592186260840 13194139533864 true] [17592186260839 1089 "q-64741" 13194139533864 true] [17592186260839 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260839 1100 "Express $\\operatorname{cot}(\\frac{7\\pi }{10})$ in terms of a reference angle.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260839 1113 #uuid "18a55104-bbdc-52e6-837d-232680de3e89" 13194139533864 true] [17592186260839 1145 "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(\\frac{7\\pi }{10})\\cdot (\\frac{{180}^{∘}}{\\pi })={126}^{∘}.\n$$\n\nTherefore $\\frac{7\\pi }{10}$ is equivalent to ${126}^{∘},$ which lies in the $2\\text{nd}$ quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/89b5e2656378adb5d91c9f58c261e4beaae252b67819b904bf209f6ed8a5a25e.png)\n\nTo express $\\operatorname{cot}(\\frac{7\\pi }{10})$ in terms of $\\operatorname{cot}{\\theta }_{R},$ we follow three steps:\n\n- Find its reference angle ${\\theta }_{R}.$\n\n- Calculate the value of the function for ${\\theta }_{R}.$\n\n- Determine whether the resulting value is positive or negative.\n\n**Step 1**: Since $\\theta =\\frac{7\\pi }{10}$ is in the $2$nd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\pi -\\theta  \\\\  & =\\pi -\\frac{7\\pi }{10} \\\\  & =\\frac{3\\pi }{10}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{cot}(\\frac{7\\pi }{10})$, and therefore we're interested in $\\operatorname{cot}{\\theta }_{R}=\\operatorname{cot}(\\frac{3\\pi }{10}).$\n\n**Step 3:** The ratio $\\operatorname{cot}(\\frac{7\\pi }{10})$ must be negative because tangent (and therefore cotangent) is always negative in the $2$nd quadrant. Therefore,\n\n$$\n\\operatorname{cot}(\\frac{7\\pi }{10})=-\\operatorname{cot}(\\frac{3\\pi }{10}).\n$$" 13194139533864 true] [17592186260840 1000 #edb/ref 17592186260841 13194139533864 true] [17592186260840 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260840 1041 "answer" 13194139533864 true] [17592186260840 1104 #edb/ref 17592186260841 13194139533864 true] [17592186260840 1110 #uuid "667f928d-bb59-502b-b95d-880887f47907" 13194139533864 true] [17592186260841 1034 "-\\operatorname{cot}(\\frac{3\\pi }{10})" 13194139533864 true] [17592186260841 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260841 1111 #uuid "f133d1b2-05cb-596f-97d1-51b16f3a3ec0" 13194139533864 true] [17592186260842 1017 #edb/ref 17592186260843 13194139533864 true] [17592186260842 1089 "q-6479" 13194139533864 true] [17592186260842 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260842 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1d60d9f28a5456d0814164572315767d733fa111de88aebd51116a6f7f3e8580.png)\n\nCalculate, to the nearest tenth, the measure of the obtuse angle $X.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260842 1113 #uuid "21385e38-4d49-556c-9fc8-465389827b09" 13194139533864 true] [17592186260842 1145 "The Law of Sines states that\n\n$$\n\\frac{\\operatorname{sin}X}{x}=\\frac{\\operatorname{sin}Y}{y}.\n$$\n\nIn this case, we have\n\n$$\nx=16,\\,m∠Y={36}^{∘},\\,y=14,\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}X}{16} & =\\frac{\\operatorname{sin}{36}^{∘}}{14} \\\\ \\operatorname{sin}X & =16\\cdot \\frac{\\operatorname{sin}{36}^{∘}}{14} \\\\  & =\\frac{8\\cdot \\operatorname{sin}{36}^{∘}}{7} \\\\  & \\approx \\frac{8\\cdot 0.587\\,8}{7} \\\\  & \\approx 0.671\\,8,\\end{aligned}\n$$\n\nrounded to $4$ decimal places. This gives\n\n$$\n\\begin{aligned}m∠X & \\approx \\operatorname{arcsin}(0.671\\,8)\\approx {42.2}^{∘},\\end{aligned}\n$$\n\nrounded to the nearest tenth. But this is less than ${90}^{∘}.$ To get the true value of $X,$ we subtract our answer from ${180}^{∘}:$\n\n$$\nm∠X\\approx {180}^{∘}-{42.20}^{∘}\\approx {137.8}^{∘},\n$$\n\nrounded to the nearest tenth." 13194139533864 true] [17592186260843 1000 #edb/ref 17592186260844 13194139533864 true] [17592186260843 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260843 1041 "answer" 13194139533864 true] [17592186260843 1104 #edb/ref 17592186260844 13194139533864 true] [17592186260843 1110 #uuid "f3e891c3-0b5d-5398-a7f8-753ff24adc33" 13194139533864 true] [17592186260844 1034 "{137.8}^{∘}" 13194139533864 true] [17592186260844 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260844 1111 #uuid "223544da-db5b-5a15-83d0-ae653cd9112e" 13194139533864 true] [17592186260845 1017 #edb/ref 17592186260846 13194139533864 true] [17592186260845 1089 "q-64863" 13194139533864 true] [17592186260845 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260845 1100 "Find the value of $\\operatorname{cos}0.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260845 1113 #uuid "5d76d623-1c6f-5d51-9983-82a36796ab6c" 13194139533864 true] [17592186260845 1145 "The angle $0$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $0$ corresponds to the point $(1,0).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}0=1.$" 13194139533864 true] [17592186260846 1000 #edb/ref 17592186260847 13194139533864 true] [17592186260846 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260846 1041 "answer" 13194139533864 true] [17592186260846 1104 #edb/ref 17592186260847 13194139533864 true] [17592186260846 1110 #uuid "1854554f-c17d-57f3-91f8-95d189868d2d" 13194139533864 true] [17592186260847 1034 "1" 13194139533864 true] [17592186260847 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260847 1111 #uuid "e6c93262-23b3-5291-822c-b2fc2431d836" 13194139533864 true] [17592186260848 1017 #edb/ref 17592186260849 13194139533864 true] [17592186260848 1089 "q-6491" 13194139533864 true] [17592186260848 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260848 1100 "What is the sum of the arithmetic series ${\\sum }_{n=1}^{10}(n+5)?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260848 1113 #uuid "51f91c45-43d2-5fcb-8a9f-a87826b50b9f" 13194139533864 true] [17592186260848 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nGiven the series ${\\sum }_{n=1}^{10}(n+5)$ in sigma notation, we note that\n\n- the total number of terms is $N=10$\n\n- the first term is ${a}_{1}=1+5=6$\n\n- the last term is ${a}_{10}=10+5=15$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we obtain:\n\n$$\n\\begin{aligned}{S}_{10} & =\\frac{10}{2}(6+15) \\\\  & =5\\cdot 21 \\\\  & =105\\end{aligned}\n$$" 13194139533864 true] [17592186260849 1000 #edb/ref 17592186260850 13194139533864 true] [17592186260849 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260849 1041 "answer" 13194139533864 true] [17592186260849 1104 #edb/ref 17592186260850 13194139533864 true] [17592186260849 1110 #uuid "39483401-c887-5eab-9097-84d46f3a7fff" 13194139533864 true] [17592186260850 1034 "105" 13194139533864 true] [17592186260850 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260850 1111 #uuid "81c51b21-cf4d-54d7-8ea3-bf125558d5d6" 13194139533864 true] [17592186260851 1017 #edb/ref 17592186260852 13194139533864 true] [17592186260851 1089 "q-64921" 13194139533864 true] [17592186260851 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260851 1100 "$\\operatorname{sin}(\\frac{\\pi }{3})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260851 1113 #uuid "7497aaee-16af-5435-8a6f-690db33f8226" 13194139533864 true] [17592186260851 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{3}$ corresponds to the point $(\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{3})=\\frac{\\sqrt{3}}{2}.$" 13194139533864 true] [17592186260852 1000 #edb/ref 17592186260853 13194139533864 true] [17592186260852 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260852 1041 "answer" 13194139533864 true] [17592186260852 1104 #edb/ref 17592186260853 13194139533864 true] [17592186260852 1110 #uuid "4faf4288-afb2-5118-afd9-bf306bdd19d8" 13194139533864 true] [17592186260853 1034 "\\frac{\\sqrt{3}}{2}" 13194139533864 true] [17592186260853 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260853 1111 #uuid "34724b94-1d6d-5ffc-b3ec-2e0b92812003" 13194139533864 true] [17592186260854 1017 #edb/ref 17592186260855 13194139533864 true] [17592186260854 1089 "q-64923" 13194139533864 true] [17592186260854 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260854 1100 "$\\operatorname{cos}(\\frac{5\\pi }{6})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260854 1113 #uuid "2b5a2976-278a-5503-aa48-0e6720682c18" 13194139533864 true] [17592186260854 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{5\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{5\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$" 13194139533864 true] [17592186260855 1000 #edb/ref 17592186260856 13194139533864 true] [17592186260855 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260855 1041 "answer" 13194139533864 true] [17592186260855 1104 #edb/ref 17592186260856 13194139533864 true] [17592186260855 1110 #uuid "424fca19-b484-52f5-9d03-9d3e8b433752" 13194139533864 true] [17592186260856 1034 "-\\frac{\\sqrt{3}}{2}" 13194139533864 true] [17592186260856 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260856 1111 #uuid "43750d40-b6a5-569a-9f14-594d1ce48907" 13194139533864 true] [17592186260857 1017 #edb/ref 17592186260858 13194139533864 true] [17592186260857 1089 "q-64929" 13194139533864 true] [17592186260857 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260857 1100 "$\\operatorname{sin}(\\frac{11\\pi }{6})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260857 1113 #uuid "8358751c-30a9-5482-b7a6-569bce8efae2" 13194139533864 true] [17592186260857 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a33ea7c6d1aa7cd7e54376aefb2af4347da59a61ecaabdbf4964d41b9661870a.png)\n\nFrom the unit circle, we see that the angle $\\frac{11\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{11\\pi }{6})=-\\frac{1}{2}.$" 13194139533864 true] [17592186260858 1000 #edb/ref 17592186260859 13194139533864 true] [17592186260858 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260858 1041 "answer" 13194139533864 true] [17592186260858 1104 #edb/ref 17592186260859 13194139533864 true] [17592186260858 1110 #uuid "bacd49d1-4171-50e8-bfbf-31f75f685056" 13194139533864 true] [17592186260859 1034 "-\\frac{1}{2}" 13194139533864 true] [17592186260859 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260859 1111 #uuid "93f296a3-9576-51c4-b33b-0f948582bc66" 13194139533864 true] [17592186260860 1017 #edb/ref 17592186260861 13194139533864 true] [17592186260860 1089 "q-64934" 13194139533864 true] [17592186260860 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260860 1100 "$\\operatorname{cot}(\\frac{2\\pi }{3})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260860 1113 #uuid "63944a14-9b57-535f-a780-94b108252e16" 13194139533864 true] [17592186260860 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{2\\pi }{3})=-\\frac{1}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{2\\pi }{3})=\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{cot}\\theta =\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{cot}(\\frac{2\\pi }{3})=\\frac{\\operatorname{cos}(\\frac{2\\pi }{3})}{\\operatorname{sin}(\\frac{2\\pi }{3})}=\\frac{(-\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}=-\\frac{1}{\\sqrt{3}}.\n$$" 13194139533864 true] [17592186260861 1000 #edb/ref 17592186260862 13194139533864 true] [17592186260861 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260861 1041 "answer" 13194139533864 true] [17592186260861 1104 #edb/ref 17592186260862 13194139533864 true] [17592186260861 1110 #uuid "b336fede-015d-5af2-8c22-62c56ef5e41a" 13194139533864 true] [17592186260862 1034 "-\\frac{1}{\\sqrt{3}}" 13194139533864 true] [17592186260862 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260862 1111 #uuid "96ffa976-f799-544c-88f1-6195338addb0" 13194139533864 true] [17592186260863 1017 #edb/ref 17592186260864 13194139533864 true] [17592186260863 1089 "q-64941" 13194139533864 true] [17592186260863 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260863 1100 "$\\operatorname{tan}(\\frac{11\\pi }{6})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260863 1113 #uuid "ff4fda6b-8804-52a2-b65a-8dfd56b273ee" 13194139533864 true] [17592186260863 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{11\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{11\\pi }{6})=\\frac{\\sqrt{3}}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{11\\pi }{6})=-\\frac{1}{2}.$\n\nTherefore, using the fact that $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{tan}(\\frac{11\\pi }{6})=\\frac{\\operatorname{sin}(\\frac{11\\pi }{6})}{\\operatorname{cos}(\\frac{11\\pi }{6})}=\\frac{(-\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}=-\\frac{1}{\\sqrt{3}}.\n$$" 13194139533864 true] [17592186260864 1000 #edb/ref 17592186260865 13194139533864 true] [17592186260864 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260864 1041 "answer" 13194139533864 true] [17592186260864 1104 #edb/ref 17592186260865 13194139533864 true] [17592186260864 1110 #uuid "a0c0dd7e-20c5-50aa-b886-faa6d7f0a5b9" 13194139533864 true] [17592186260865 1034 "-\\frac{1}{\\sqrt{3}}" 13194139533864 true] [17592186260865 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260865 1111 #uuid "fa246351-73e2-5338-a072-6a56045afa98" 13194139533864 true] [17592186260866 1017 #edb/ref 17592186260867 13194139533864 true] [17592186260866 1089 "q-64949" 13194139533864 true] [17592186260866 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260866 1100 "$\\operatorname{csc}(\\frac{5\\pi }{4})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260866 1113 #uuid "47e7cf2c-f3c5-5c55-b6d4-ea7685fb4e2d" 13194139533864 true] [17592186260866 1145 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{5\\pi }{4}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{5\\pi }{4})=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore, using the fact that $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{csc}(\\frac{5\\pi }{4})=\\frac{1}{\\operatorname{sin}(\\frac{5\\pi }{4})}=-\\frac{2}{\\sqrt{2}}=-\\sqrt{2}.\n$$" 13194139533864 true] [17592186260867 1000 #edb/ref 17592186260868 13194139533864 true] [17592186260867 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260867 1041 "answer" 13194139533864 true] [17592186260867 1104 #edb/ref 17592186260868 13194139533864 true] [17592186260867 1110 #uuid "0bec85a2-6b2c-590f-8c45-f5be49009f31" 13194139533864 true] [17592186260868 1034 "-\\sqrt{2}" 13194139533864 true] [17592186260868 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260868 1111 #uuid "d445d24f-83b4-550b-8ee2-43ea0f4edfb2" 13194139533864 true] [17592186260869 1017 #edb/ref 17592186260870 13194139533864 true] [17592186260869 1089 "q-65502" 13194139533864 true] [17592186260869 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260869 1100 "$\\operatorname{cos}(x+\\frac{2\\pi }{3})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260869 1113 #uuid "8bb03c0c-2bf3-5dda-8102-58698d5cc17e" 13194139533864 true] [17592186260869 1145 "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(u+v)=\\operatorname{cos}u\\operatorname{cos}v-\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x+\\frac{2\\pi }{3}) & =\\operatorname{cos}x\\operatorname{cos}(\\frac{2\\pi }{3})-\\operatorname{sin}x\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}x\\cdot (-\\frac{1}{2})-\\operatorname{sin}x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x).\\end{aligned}\n$$" 13194139533864 true] [17592186260870 1000 #edb/ref 17592186260871 13194139533864 true] [17592186260870 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260870 1041 "answer" 13194139533864 true] [17592186260870 1104 #edb/ref 17592186260871 13194139533864 true] [17592186260870 1110 #uuid "5cfbbf58-a0ba-5f08-ad19-4b0db32db4a1" 13194139533864 true] [17592186260871 1034 "-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x)" 13194139533864 true] [17592186260871 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260871 1111 #uuid "641d7778-b4a5-5a1f-9803-f84355fa85f4" 13194139533864 true] [17592186260872 1017 #edb/ref 17592186260873 13194139533864 true] [17592186260872 1089 "q-65551" 13194139533864 true] [17592186260872 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260872 1100 "Find the exact value of $\\operatorname{cos}(\\frac{13\\pi }{12}).$\n\n*Hint: Use the fact that $\\frac{13\\pi }{12}=\\frac{5\\pi }{4}-\\frac{\\pi }{6}.$*\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260872 1113 #uuid "d9857563-42e2-5591-8956-ff251a3df14e" 13194139533864 true] [17592186260872 1145 "Recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the difference formula for cosine with $x=\\frac{5\\pi }{4}$ and $y=\\frac{\\pi }{6}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(\\frac{13\\pi }{12}) & =\\operatorname{cos}(\\frac{5\\pi }{4}-\\frac{\\pi }{6}) \\\\  & =\\operatorname{cos}(\\frac{5\\pi }{4})\\operatorname{cos}(\\frac{\\pi }{6})+\\operatorname{sin}(\\frac{5\\pi }{4})\\operatorname{sin}(\\frac{\\pi }{6}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{6}}{4}-\\frac{\\sqrt{2}}{4} \\\\  & =-\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$" 13194139533864 true] [17592186260873 1000 #edb/ref 17592186260874 13194139533864 true] [17592186260873 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260873 1041 "answer" 13194139533864 true] [17592186260873 1104 #edb/ref 17592186260874 13194139533864 true] [17592186260873 1110 #uuid "edd23c3b-c6ee-5b97-bbf0-41e4e3cfc8e8" 13194139533864 true] [17592186260874 1034 "-\\frac{\\sqrt{6}+\\sqrt{2}}{4}" 13194139533864 true] [17592186260874 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260874 1111 #uuid "9c02e9f4-ac81-5fe7-8b37-3db5653b4693" 13194139533864 true] [17592186260875 1017 #edb/ref 17592186260876 13194139533864 true] [17592186260875 1089 "q-65556" 13194139533864 true] [17592186260875 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260875 1100 "Find the exact value of  $\\operatorname{cos}(\\frac{\\pi }{12}).$\n\n*Hint: Use the fact that $\\frac{\\pi }{12}=\\frac{\\pi }{3}-\\frac{\\pi }{4}.$*\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260875 1113 #uuid "7da7ff7e-6169-5165-9584-01d86caac744" 13194139533864 true] [17592186260875 1145 "Recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the difference formula for cosine with $x=\\frac{\\pi }{3}$ and $y=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(\\frac{\\pi }{12}) & =\\operatorname{cos}(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\operatorname{cos}(\\frac{\\pi }{3})\\operatorname{cos}(\\frac{\\pi }{4})+\\operatorname{sin}(\\frac{\\pi }{3})\\operatorname{sin}(\\frac{\\pi }{4}) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\  & =\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$" 13194139533864 true] [17592186260876 1000 #edb/ref 17592186260877 13194139533864 true] [17592186260876 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260876 1041 "answer" 13194139533864 true] [17592186260876 1104 #edb/ref 17592186260877 13194139533864 true] [17592186260876 1110 #uuid "206d5ba5-665d-57ac-a3f1-df6e1300a891" 13194139533864 true] [17592186260877 1034 "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" 13194139533864 true] [17592186260877 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260877 1111 #uuid "b20ccd39-3c8a-5cc2-ac4d-61d790088d67" 13194139533864 true] [17592186260878 1017 #edb/ref 17592186260879 13194139533864 true] [17592186260878 1089 "q-65608" 13194139533864 true] [17592186260878 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260878 1100 "$\\frac{\\operatorname{sin}(\\frac{\\pi }{3})}{{sin}^{2}(\\frac{\\pi }{6})}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260878 1113 #uuid "1e7013fe-76e9-5d3e-a584-12066788f47b" 13194139533864 true] [17592186260878 1145 "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}2x=2\\operatorname{sin}x\\operatorname{cos}x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n\\operatorname{sin}(2\\cdot \\frac{\\pi }{6})=2\\operatorname{sin}(\\frac{\\pi }{6})\\operatorname{cos}(\\frac{\\pi }{6})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}(\\frac{\\pi }{3})=2\\operatorname{sin}(\\frac{\\pi }{6})\\operatorname{cos}(\\frac{\\pi }{6}).\n$$\n\nDividing both sides by $\\operatorname{sin}(\\frac{\\pi }{6}),$ we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}(\\frac{\\pi }{3})}{{sin}^{2}(\\frac{\\pi }{6})} & =\\frac{2\\operatorname{sin}(\\frac{\\pi }{6})\\operatorname{cos}(\\frac{\\pi }{6})}{{sin}^{2}(\\frac{\\pi }{6})} \\\\  & =\\frac{2\\cancel{\\operatorname{sin}(\\frac{\\pi }{6})}\\operatorname{cos}(\\frac{\\pi }{6})}{\\cancel{\\operatorname{sin}(\\frac{\\pi }{6})}\\operatorname{sin}(\\frac{\\pi }{6})} \\\\  & =2\\operatorname{cot}(\\frac{\\pi }{6}).\\end{aligned}\n$$" 13194139533864 true] [17592186260879 1000 #edb/ref 17592186260880 13194139533864 true] [17592186260879 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260879 1041 "answer" 13194139533864 true] [17592186260879 1104 #edb/ref 17592186260880 13194139533864 true] [17592186260879 1110 #uuid "6b99217f-d43a-5910-b990-0ce4f782f447" 13194139533864 true] [17592186260880 1034 "2\\operatorname{cot}(\\frac{\\pi }{6})" 13194139533864 true] [17592186260880 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260880 1111 #uuid "a100d4b9-e06d-544a-8102-9cebac72f6d2" 13194139533864 true] [17592186260881 1017 #edb/ref 17592186260882 13194139533864 true] [17592186260881 1089 "q-65808" 13194139533864 true] [17592186260881 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260881 1100 "What values is **not** in the range of $y=\\operatorname{arcsin}x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260881 1113 #uuid "9ba20a3d-72d2-5250-a2dc-c7c364bd7072" 13194139533864 true] [17592186260881 1145 "Let's recall the graph of $y=\\operatorname{arcsin}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nNote that:\n\n- The range of the function is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nTherefore, the value $y=\\frac{2\\pi }{3}$ is not in the range of the function." 13194139533864 true] [17592186260882 1000 #edb/ref 17592186260883 13194139533864 true] [17592186260882 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260882 1041 "answer" 1319413953386