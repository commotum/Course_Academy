bf96" 13194139533864 true] [17592186257683 1034 "(n+6)\\cdot (n+4)!" 13194139533864 true] [17592186257683 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257683 1111 #uuid "fbc665a8-0d4b-52ee-8146-081448b0b6b1" 13194139533864 true] [17592186257684 1034 "(n+5)\\cdot (n+4)\\cdot (n+3)" 13194139533864 true] [17592186257684 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257684 1111 #uuid "7dd3b879-c086-5ba1-b450-6fce908c41c1" 13194139533864 true] [17592186257685 1034 "(n+5)\\cdot (n+4)!" 13194139533864 true] [17592186257685 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257685 1111 #uuid "b64b5da1-db41-598c-a0fb-ea377f30778f" 13194139533864 true] [17592186257686 1034 "(n+6)\\cdot (n+5)\\cdot (n+4)" 13194139533864 true] [17592186257686 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257686 1111 #uuid "945bfc0d-31e2-5ee2-b31f-9eda3f097d12" 13194139533864 true] [17592186257687 1017 #edb/ref 17592186257688 13194139533864 true] [17592186257687 1089 "q-124539" 13194139533864 true] [17592186257687 1091 #edb/ref 17592186045464 13194139533864 true] [17592186257687 1100 "What is $\\operatorname{tan}(-\\frac{17\\pi }{12})$ expressed in terms of a reference angle?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257687 1113 #uuid "c6ebff35-b9bf-5747-b659-ad392943e1fa" 13194139533864 true] [17592186257687 1145 "We wish to express $\\operatorname{tan}(-\\frac{17\\pi }{12})$ in terms of $\\operatorname{tan}{\\theta }_{R},$ where ${\\theta }_{R}$ is the reference angle corresponding to the angle $\\theta =-\\frac{17\\pi }{12}.$ \n\nTo express $\\operatorname{tan}(-\\frac{17\\pi }{12})$ in terms of $\\operatorname{tan}{\\theta }_{R},$ we proceed as follows: \n\n- **Step 1**: Find the corresponding coterminal angle that lies in the range $[0,2\\pi ).$ We do this by adding integer multiples of $2\\pi $ until we get our desired angle:\n\n$$\n-\\frac{17\\pi }{12}+2\\pi =\\frac{7\\pi }{12}\\,✓\n$$\n\nTherefore,\n\n$$\n\\operatorname{tan}(-\\frac{17\\pi }{12})=\\operatorname{tan}(\\frac{7\\pi }{12}).\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7828b40e3fba874611bb9c20e38e0880375aec389ae8ec646d92ea1e1b276883.png)\n\n- **Step 2**: Compute the reference angle. Since $\\theta =\\frac{7\\pi }{12}$ is in the $2$nd quadrant, the reference angle is\n\n$$\n{\\theta }_{R}=\\pi -\\frac{7\\pi }{12}=\\frac{5\\pi }{12}.\n$$\n\n- **Step 3**: Determine the correct sign. The tangent function is negative $(-)$ in the second quadrant. Therefore,\n\n$$\n\\operatorname{tan}(-\\frac{17\\pi }{12})=-\\operatorname{tan}{\\theta }_{R}=-\\operatorname{tan}(\\frac{5\\pi }{12})\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{tan}(-\\frac{17\\pi }{12})=-\\operatorname{tan}(\\frac{5\\pi }{12}).\n$$" 13194139533864 true] [17592186257688 1000 #edb/ref 17592186257689 13194139533864 true] [17592186257688 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257688 1041 "answer" 13194139533864 true] [17592186257688 1104 #edb/ref 17592186257689 13194139533864 true] [17592186257688 1110 #uuid "ad4a076e-40d0-5405-b2e6-af2c820695fc" 13194139533864 true] [17592186257689 1034 "-\\operatorname{tan}(\\frac{5\\pi }{12})" 13194139533864 true] [17592186257689 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257689 1111 #uuid "b6122e96-ea78-5eac-ba8d-309cf65d83d4" 13194139533864 true] [17592186257690 1017 #edb/ref 17592186257691 13194139533864 true] [17592186257690 1089 "q-124575" 13194139533864 true] [17592186257690 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257690 1100 "Given that ${a}_{1}=10$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-0.25$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257690 1113 #uuid "36e7cb14-a9b2-529b-981c-2ef8caf295b9" 13194139533864 true] [17592186257690 1145 "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=10.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-0.25.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{10}{1-(-0.25)} \\\\  & =\\frac{10}{1+0.25} \\\\  & =\\frac{10}{1.25} \\\\  & =\\frac{1\\,000}{125} \\\\  & =8.\\end{aligned}\n$$" 13194139533864 true] [17592186257691 1000 #edb/ref 17592186257692 13194139533864 true] [17592186257691 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257691 1041 "answer" 13194139533864 true] [17592186257691 1104 #edb/ref 17592186257692 13194139533864 true] [17592186257691 1110 #uuid "24b1fc7d-8f4a-5ba5-be9f-ebcd2a012b8d" 13194139533864 true] [17592186257692 1034 "8" 13194139533864 true] [17592186257692 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257692 1111 #uuid "c8c91737-753a-5b7e-af1c-19314d43919a" 13194139533864 true] [17592186257693 1017 #edb/ref 17592186257694 13194139533864 true] [17592186257693 1089 "q-124577" 13194139533864 true] [17592186257693 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257693 1100 "Given that ${a}_{1}=-14$ and $\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{3}$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257693 1113 #uuid "d5e58701-9bd7-5e77-97f9-f02a87ad3341" 13194139533864 true] [17592186257693 1145 "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-14.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-14}{(1-\\frac{1}{3})} \\\\  & =-\\frac{14}{(\\frac{2}{3})} \\\\  & =-14\\cdot \\frac{3}{2} \\\\  & =-21.\\end{aligned}\n$$" 13194139533864 true] [17592186257694 1000 #edb/ref 17592186257695 13194139533864 true] [17592186257694 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257694 1041 "answer" 13194139533864 true] [17592186257694 1104 #edb/ref 17592186257695 13194139533864 true] [17592186257694 1110 #uuid "e9f4cc6b-4a73-57ba-92d8-20124206b052" 13194139533864 true] [17592186257695 1034 "-21" 13194139533864 true] [17592186257695 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257695 1111 #uuid "bd517d52-a809-52ca-bfb2-6a41f1050cd9" 13194139533864 true] [17592186257696 1017 #edb/ref 17592186257697 13194139533864 true] [17592186257696 1089 "q-124580" 13194139533864 true] [17592186257696 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257696 1100 "${\\sum }_{n=1}^{\\infty }45(0.1)^{n}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257696 1113 #uuid "fe72df8e-159f-5c71-9114-1755109effd4" 13194139533864 true] [17592186257696 1145 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=45(0.1)^{1}=4.5.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{45(0.1)^{2}}{45(0.1)^{1}}=0.1.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }45(0.1)^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{4.5}{(1-0.1)} \\\\  & =\\frac{4.5}{0.9} \\\\  & =\\frac{45}{9} \\\\  & =5.\\end{aligned}\n$$" 13194139533864 true] [17592186257697 1000 #edb/ref 17592186257698 13194139533864 true] [17592186257697 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257697 1041 "answer" 13194139533864 true] [17592186257697 1104 #edb/ref 17592186257698 13194139533864 true] [17592186257697 1110 #uuid "89695a32-33de-5291-a31b-c425b3e0c9b3" 13194139533864 true] [17592186257698 1034 "5" 13194139533864 true] [17592186257698 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257698 1111 #uuid "f52124e0-1658-58b3-b02d-b5db6a8e4113" 13194139533864 true] [17592186257699 1017 #edb/ref 17592186257700 13194139533864 true] [17592186257699 1089 "q-124582" 13194139533864 true] [17592186257699 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257699 1100 "${\\sum }_{n=1}^{\\infty }15{(\\frac{2}{3})}^{n}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257699 1113 #uuid "00c8c66f-75df-508a-b3d1-06c349afffda" 13194139533864 true] [17592186257699 1145 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=15{(\\frac{2}{3})}^{1}=10.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15{(\\frac{2}{3})}^{2}}{15{(\\frac{2}{3})}^{1}}=\\frac{2}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }15{(\\frac{2}{3})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{10}{(1-\\frac{2}{3})} \\\\  & =\\frac{10}{(\\frac{1}{3})} \\\\  & =10\\cdot 3 \\\\  & =30.\\end{aligned}\n$$" 13194139533864 true] [17592186257700 1000 #edb/ref 17592186257701 13194139533864 true] [17592186257700 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257700 1041 "answer" 13194139533864 true] [17592186257700 1104 #edb/ref 17592186257701 13194139533864 true] [17592186257700 1110 #uuid "6e203945-6008-5260-8b6a-c5753324154c" 13194139533864 true] [17592186257701 1034 "30" 13194139533864 true] [17592186257701 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257701 1111 #uuid "6a3ac2e8-a0b4-5eec-a2cb-2e94e0572103" 13194139533864 true] [17592186257702 1017 #edb/ref 17592186257703 13194139533864 true] [17592186257702 1089 "q-124585" 13194139533864 true] [17592186257702 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257702 1100 "${\\sum }_{n=1}^{\\infty }15{(\\frac{2}{5})}^{n}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257702 1113 #uuid "9e0bc989-6c13-538f-9204-1071f5bfda3f" 13194139533864 true] [17592186257702 1145 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=15{(\\frac{2}{5})}^{1}=6.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15{(\\frac{2}{5})}^{2}}{15{(\\frac{2}{5})}^{1}}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }5{(\\frac{2}{5})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6}{(1-\\frac{2}{5})} \\\\  & =\\frac{6}{(\\frac{3}{5})} \\\\  & =6\\cdot \\frac{5}{3} \\\\  & =10.\\end{aligned}\n$$" 13194139533864 true] [17592186257703 1000 #edb/ref 17592186257704 13194139533864 true] [17592186257703 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257703 1041 "answer" 13194139533864 true] [17592186257703 1104 #edb/ref 17592186257704 13194139533864 true] [17592186257703 1110 #uuid "bf43fe7a-26b2-5fc0-8910-6663e9a0868c" 13194139533864 true] [17592186257704 1034 "10" 13194139533864 true] [17592186257704 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257704 1111 #uuid "8947bc3a-7ecb-51af-ac74-5b49f9403f42" 13194139533864 true] [17592186257705 1017 #edb/ref 17592186257706 13194139533864 true] [17592186257705 1089 "q-124586" 13194139533864 true] [17592186257705 1091 #edb/ref 17592186045465 13194139533864 true] [17592186257705 1100 "${\\sum }_{n=4}^{\\infty }16{(\\frac{1}{2})}^{n}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257705 1113 #uuid "4d9ee369-331b-5825-8ec6-ff1d89ebe2f6" 13194139533864 true] [17592186257705 1145 "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & =16{(\\frac{1}{2})}^{4}=16(\\frac{1}{16})=1 \\\\ {a}_{5} & =16{(\\frac{1}{2})}^{5}=16(\\frac{1}{32})=\\frac{1}{2}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{(\\frac{1}{2})}{1}=\\frac{1}{2}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }16{(\\frac{1}{2})}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{1}{(1-\\frac{1}{2})} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =1\\cdot \\frac{2}{1} \\\\  & =2.\\end{aligned}\n$$" 13194139533864 true] [17592186257706 1000 #edb/ref 17592186257707 13194139533864 true] [17592186257706 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257706 1041 "answer" 13194139533864 true] [17592186257706 1104 #edb/ref 17592186257707 13194139533864 true] [17592186257706 1110 #uuid "82825abf-7a8b-5dfe-821a-e491924b1552" 13194139533864 true] [17592186257707 1034 "2" 13194139533864 true] [17592186257707 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257707 1111 #uuid "4acbbefc-1b16-5c59-8b6e-56d7e6481078" 13194139533864 true] [17592186257708 1017 #edb/ref 17592186257709 13194139533864 true] [17592186257708 1089 "q-124587" 13194139533864 true] [17592186257708 1091 #edb/ref 17592186045465 13194139533864 true] [17592186257708 1100 "Evaluate the series ${\\sum }_{n=2}^{\\infty }75{(\\frac{2}{5})}^{n}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257708 1113 #uuid "51438042-d192-59cd-9eae-aac65ca4ba26" 13194139533864 true] [17592186257708 1145 "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =75{(\\frac{2}{5})}^{2}=12 \\\\ {a}_{3} & =75{(\\frac{2}{5})}^{3}=\\frac{24}{5}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{24}{5})}{12}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }75{(\\frac{2}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{12}{(1-\\frac{2}{5})} \\\\  & =\\frac{12}{(\\frac{3}{5})} \\\\  & =20.\\end{aligned}\n$$" 13194139533864 true] [17592186257709 1000 #edb/ref 17592186257710 13194139533864 true] [17592186257709 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257709 1041 "answer" 13194139533864 true] [17592186257709 1104 #edb/ref 17592186257710 13194139533864 true] [17592186257709 1110 #uuid "02f66923-1333-5f92-8020-0f438e3502a0" 13194139533864 true] [17592186257710 1034 "20" 13194139533864 true] [17592186257710 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257710 1111 #uuid "fd9bc9cd-64be-5155-9556-0bcc2ac93274" 13194139533864 true] [17592186257711 1017 #edb/ref 17592186257712 13194139533864 true] [17592186257711 1089 "q-124710" 13194139533864 true] [17592186257711 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257711 1100 "The angle $\\theta =-{675}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" 13194139533864 true] [17592186257711 1113 #uuid "aef049cc-770d-5d6c-beb4-622b042039bd" 13194139533864 true] [17592186257711 1145 "First, we find an angle that's coterminal with $-{305}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{675}^{∘}+{360}^{∘}=-{315}^{∘}$\n\n- $-{675}^{∘}+2\\cdot {360}^{∘}={45}^{∘}\\,✓$\n\nSo the angle ${45}^{∘}$ is coterminal with $-{675}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e9e985d1b9787a05c97ead1fa6d80ef411bc1a636bd7a670a221d663d7041f5c.png)\n\nWe see that ${45}^{∘}$ lies in quadrant I. Therefore, $-{675}^{∘}$ also lies in this quadrant." 13194139533864 true] [17592186257712 1000 #edb/ref 17592186257713 13194139533864 true] [17592186257712 1000 #edb/ref 17592186257714 13194139533864 true] [17592186257712 1000 #edb/ref 17592186257715 13194139533864 true] [17592186257712 1000 #edb/ref 17592186257716 13194139533864 true] [17592186257712 1040 #edb/ref 17592186045450 13194139533864 true] [17592186257712 1041 "selection" 13194139533864 true] [17592186257712 1104 #edb/ref 17592186257714 13194139533864 true] [17592186257712 1110 #uuid "713cd814-f1b5-5784-a54e-b1bff8791608" 13194139533864 true] [17592186257713 1034 "Quadrant II" 13194139533864 true] [17592186257713 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257713 1111 #uuid "99fb90fd-4eef-58fd-8fca-8f1d47988f02" 13194139533864 true] [17592186257714 1034 "Quadrant I" 13194139533864 true] [17592186257714 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257714 1111 #uuid "6f26502d-c71d-5b2e-af32-b17010a3f756" 13194139533864 true] [17592186257715 1034 "Quadrant III" 13194139533864 true] [17592186257715 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257715 1111 #uuid "69115848-ea6d-5953-bb32-bccba4c3250e" 13194139533864 true] [17592186257716 1034 "Quadrant IV" 13194139533864 true] [17592186257716 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257716 1111 #uuid "6b6483ef-d505-5969-b996-0b0edd3f1d72" 13194139533864 true] [17592186257717 1017 #edb/ref 17592186257718 13194139533864 true] [17592186257717 1089 "q-124719" 13194139533864 true] [17592186257717 1091 #edb/ref 17592186045465 13194139533864 true] [17592186257717 1100 "The angle $\\theta =-\\frac{27\\pi }{10}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" 13194139533864 true] [17592186257717 1113 #uuid "8ce00861-6b60-5530-adb7-2260647c73a2" 13194139533864 true] [17592186257717 1145 "First, we find an angle that's coterminal with $-\\frac{27\\pi }{10}$ by *adding* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $-\\frac{27\\pi }{10}+2\\pi =-\\frac{7\\pi }{10}$\n\n- $-\\frac{27\\pi }{10}+2\\cdot (2\\pi )=\\frac{13\\pi }{10}\\,✓$\n\nSo the angle $-\\frac{27\\pi }{10}$ is coterminal with $\\frac{13\\pi }{10}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/859964e94518cf2f6270c425cb6cc0db99bbde2af83c19b1f3cdae0083644b06.png)\n\nWe see that $\\frac{13\\pi }{10}$ lies in quadrant III. Therefore, $-\\frac{27\\pi }{10}$ also lies in this quadrant." 13194139533864 true] [17592186257718 1000 #edb/ref 17592186257719 13194139533864 true] [17592186257718 1000 #edb/ref 17592186257720 13194139533864 true] [17592186257718 1000 #edb/ref 17592186257721 13194139533864 true] [17592186257718 1000 #edb/ref 17592186257722 13194139533864 true] [17592186257718 1040 #edb/ref 17592186045450 13194139533864 true] [17592186257718 1041 "selection" 13194139533864 true] [17592186257718 1104 #edb/ref 17592186257721 13194139533864 true] [17592186257718 1110 #uuid "20e30312-fd1d-55eb-ad54-8557b97f1df8" 13194139533864 true] [17592186257719 1034 "Quadrant II" 13194139533864 true] [17592186257719 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257719 1111 #uuid "997613b3-bfc8-5ed3-ba9e-bfe36a2278ab" 13194139533864 true] [17592186257720 1034 "Quadrant I" 13194139533864 true] [17592186257720 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257720 1111 #uuid "e0afcaf6-96f9-5f04-b47a-1f7fc76fdae6" 13194139533864 true] [17592186257721 1034 "Quadrant III" 13194139533864 true] [17592186257721 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257721 1111 #uuid "267bc248-0e86-55b6-a42f-7d345142ce95" 13194139533864 true] [17592186257722 1034 "Quadrant IV" 13194139533864 true] [17592186257722 1103 #edb/ref 17592186045454 13194139533864 true] [17592186257722 1111 #uuid "c4a8c567-83cd-5324-b82c-c56a02442ee8" 13194139533864 true] [17592186257723 1017 #edb/ref 17592186257724 13194139533864 true] [17592186257723 1089 "q-124735" 13194139533864 true] [17592186257723 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257723 1100 "Which angle is coterminal with ${467}^{∘}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257723 1113 #uuid "760dac55-8601-5be5-8581-6b78da458ce7" 13194139533864 true] [17592186257723 1145 "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to ${467}^{∘}$:\n\n- ${467}^{∘}+{360}^{∘}={827}^{∘}$\n\nThere are no answer choices larger than ${827}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from ${467}^{∘}$:\n\n- ${467}^{∘}-{360}^{∘}={107}^{∘}\\,✓$\n\n- ${467}^{∘}-2\\cdot {360}^{∘}=-{253}^{∘}$\n\n- ${467}^{∘}-3\\cdot {360}^{∘}=-{613}^{∘}$\n\nThere are no answer choices smaller than $-{613}^{∘},$ so we can stop here.\n\nSo the correct answer is ${107}^{∘}.$" 13194139533864 true] [17592186257724 1000 #edb/ref 17592186257725 13194139533864 true] [17592186257724 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257724 1041 "answer" 13194139533864 true] [17592186257724 1104 #edb/ref 17592186257725 13194139533864 true] [17592186257724 1110 #uuid "833f060b-aa16-538c-b30b-99a64a409ff7" 13194139533864 true] [17592186257725 1034 "{107}^{∘}" 13194139533864 true] [17592186257725 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257725 1111 #uuid "49336535-e555-5207-80c7-d481684e5204" 13194139533864 true] [17592186257726 1017 #edb/ref 17592186257727 13194139533864 true] [17592186257726 1089 "q-124740" 13194139533864 true] [17592186257726 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257726 1100 "Which angle is coterminal with $-{186}^{∘}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257726 1113 #uuid "518cae3a-0414-5f8e-9c3c-ba9caf23f9e4" 13194139533864 true] [17592186257726 1145 "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{186}^{∘}$:\n\n- $-{186}^{∘}+{360}^{∘}={174}^{∘}$\n\n- $-{186}^{∘}+2\\cdot {360}^{∘}={534}^{∘}$\n\nThere are no answer choices larger than ${534}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{186}^{∘}$:\n\n- $-{186}^{∘}-{360}^{∘}=-{546}^{∘}\\,✓$\n\n- $-{186}^{∘}-2\\cdot {360}^{∘}=-{906}^{∘}$\n\nThere are no answer choices smaller than $-{906}^{∘},$ so we can stop here.\n\nSo the correct answer is $-{546}^{∘}.$" 13194139533864 true] [17592186257727 1000 #edb/ref 17592186257728 13194139533864 true] [17592186257727 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257727 1041 "answer" 13194139533864 true] [17592186257727 1104 #edb/ref 17592186257728 13194139533864 true] [17592186257727 1110 #uuid "43dd4b4c-5d7b-5b1f-8e45-de086685e68f" 13194139533864 true] [17592186257728 1034 "-{546}^{∘}" 13194139533864 true] [17592186257728 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257728 1111 #uuid "1cc1b11b-4a95-5f84-a757-f06f1901570c" 13194139533864 true] [17592186257729 1017 #edb/ref 17592186257730 13194139533864 true] [17592186257729 1089 "q-124751" 13194139533864 true] [17592186257729 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257729 1100 "Which angle is coterminal with $\\frac{5\\pi }{4}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257729 1113 #uuid "7a2a0dd2-1546-5e0a-a4bf-23483c4d3293" 13194139533864 true] [17592186257729 1145 "To find the coterminal angles of a given angle $\\theta $ (in radians), we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $\\frac{5\\pi }{4}$:\n\n- $\\frac{5\\pi }{4}+2\\pi =\\frac{13\\pi }{4}$\n\nThere are no answer choices larger than $\\frac{13\\pi }{4},$ so we can stop here.\n\nNow, let's subtract multiples of $2\\pi $ from $\\frac{5\\pi }{4}$:\n\n- $\\frac{5\\pi }{4}-2\\pi =-\\frac{3\\pi }{4}$\n\n- $\\frac{5\\pi }{4}-2\\cdot (2\\pi )=-\\frac{11\\pi }{4}$\n\n- $\\frac{5\\pi }{4}-3\\cdot (2\\pi )=-\\frac{19\\pi }{4}\\,✓$\n\nThere are no answer choices smaller than $-\\frac{19\\pi }{4},$ so we can stop here.\n\nSo the correct answer is $-\\frac{19\\pi }{4}.$" 13194139533864 true] [17592186257730 1000 #edb/ref 17592186257731 13194139533864 true] [17592186257730 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257730 1041 "answer" 13194139533864 true] [17592186257730 1104 #edb/ref 17592186257731 13194139533864 true] [17592186257730 1110 #uuid "98fd794b-fea6-53c2-82d9-03f17d1331de" 13194139533864 true] [17592186257731 1034 "-\\frac{19\\pi }{4}" 13194139533864 true] [17592186257731 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257731 1111 #uuid "c7667623-b9c3-5387-ad60-d35e1f90f38f" 13194139533864 true] [17592186257732 1017 #edb/ref 17592186257733 13194139533864 true] [17592186257732 1089 "q-124758" 13194139533864 true] [17592186257732 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257732 1100 "Which angle is coterminal with $\\frac{11\\pi }{3}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257732 1113 #uuid "458a2a1e-c894-53df-8dbd-7679592e8bbe" 13194139533864 true] [17592186257732 1145 "To find the coterminal angles of a given angle $\\theta $ (in radians), we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $\\frac{11\\pi }{3}$:\n\n- $\\frac{11\\pi }{3}+2\\pi =\\frac{17\\pi }{3}$\n\nThere are no answer choices larger than $\\frac{17\\pi }{3},$ so we can stop here.\n\nNow, let's subtract multiples of $2\\pi $ from $\\frac{11\\pi }{3}$:\n\n- $\\frac{11\\pi }{3}-2\\pi =\\frac{5\\pi }{3}$\n\n- $\\frac{11\\pi }{3}-2\\cdot (2\\pi )=-\\frac{\\pi }{3}\\,✓$\n\n- $\\frac{11\\pi }{3}-3\\cdot (2\\pi )=-\\frac{7\\pi }{3}$\n\nThere are no answer choices smaller than $-\\frac{7\\pi }{3},$ so we can stop here.\n\nSo the correct answer is $-\\frac{\\pi }{3}.$" 13194139533864 true] [17592186257733 1000 #edb/ref 17592186257734 13194139533864 true] [17592186257733 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257733 1041 "answer" 13194139533864 true] [17592186257733 1104 #edb/ref 17592186257734 13194139533864 true] [17592186257733 1110 #uuid "62938770-04ab-5d54-a268-d5b4e1f01fae" 13194139533864 true] [17592186257734 1034 "-\\frac{\\pi }{3}" 13194139533864 true] [17592186257734 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257734 1111 #uuid "3c35f8dc-22de-5a14-9ebc-39437f22ddbe" 13194139533864 true] [17592186257735 1017 #edb/ref 17592186257736 13194139533864 true] [17592186257735 1089 "q-124760" 13194139533864 true] [17592186257735 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257735 1100 "Which angle is coterminal with $\\frac{7\\pi }{3}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257735 1113 #uuid "35635b29-ef8a-58d1-829e-341b9dc52e13" 13194139533864 true] [17592186257735 1145 "To find the coterminal angles of a given angle $\\theta $ (in radians), we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $\\frac{7\\pi }{3}$:\n\n- $\\frac{7\\pi }{3}+2\\pi =\\frac{13\\pi }{3}$\n\nThere are no answer choices larger than $\\frac{13\\pi }{3},$ so we can stop here.\n\nNow, let's subtract multiples of $2\\pi $ from $\\frac{7\\pi }{3}$:\n\n- $\\frac{7\\pi }{3}-2\\pi =\\frac{\\pi }{3}$\n\n- $\\frac{7\\pi }{3}-2\\cdot 2\\pi =-\\frac{5\\pi }{3}\\,✓$\n\n- $\\frac{7\\pi }{3}-3\\cdot 2\\pi =-\\frac{11\\pi }{3}$\n\nThere are no answer choices smaller than $-\\frac{11\\pi }{3},$ so we can stop here.\n\nSo the correct answer is $-\\frac{5\\pi }{3}.$" 13194139533864 true] [17592186257736 1000 #edb/ref 17592186257737 13194139533864 true] [17592186257736 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257736 1041 "answer" 13194139533864 true] [17592186257736 1104 #edb/ref 17592186257737 13194139533864 true] [17592186257736 1110 #uuid "af894760-2eea-57c1-a63c-2c80af55d8b8" 13194139533864 true] [17592186257737 1034 "-\\frac{5\\pi }{3}" 13194139533864 true] [17592186257737 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257737 1111 #uuid "936442df-acdc-5d67-8bd9-1964d9dfeefb" 13194139533864 true] [17592186257738 1017 #edb/ref 17592186257739 13194139533864 true] [17592186257738 1089 "q-124893" 13194139533864 true] [17592186257738 1091 #edb/ref 17592186045464 13194139533864 true] [17592186257738 1100 "Evaluate the geometric series ${\\sum }_{n=4}^{\\infty }(0.75)^{n-3}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257738 1113 #uuid "a1070fac-dc84-5279-ab3e-7a24f1bc3b90" 13194139533864 true] [17592186257738 1145 "First, note that the index $n$ starts from $4,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{4}=(0.75)^{4-3}=0.75\n$$\n\n \n\n$$\n{a}_{5}=(0.75)^{5-3}={0.75}^{2}\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{{0.75}^{2}}{0.75}=0.75.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }(0.75)^{n-3} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{0.75}{1-0.75} \\\\  & =\\frac{0.75}{0.25} \\\\  & =3.\\end{aligned}\n$$" 13194139533864 true] [17592186257739 1000 #edb/ref 17592186257740 13194139533864 true] [17592186257739 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257739 1041 "answer" 13194139533864 true] [17592186257739 1104 #edb/ref 17592186257740 13194139533864 true] [17592186257739 1110 #uuid "d2c76489-c2c5-5932-a0c5-2b6042b00049" 13194139533864 true] [17592186257740 1034 "3" 13194139533864 true] [17592186257740 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257740 1111 #uuid "42da0ddb-f88f-5ff5-8e44-3d15fee0a2a5" 13194139533864 true] [17592186257741 1017 #edb/ref 17592186257742 13194139533864 true] [17592186257741 1089 "q-125086" 13194139533864 true] [17592186257741 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257741 1100 "Find $a+3b$ if $a=8i-5j$ and $b=-3i+2j.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257741 1113 #uuid "888651a7-a3b9-5d0f-8148-4bdfc5b7dab5" 13194139533864 true] [17592186257741 1145 "To compute $a+3b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a+3b & =(8i-5j)+3(-3i+2j) \\\\  & =8i-5j-9i+6j \\\\  & =(8i-9i)+(-5j+6j) \\\\  & =-i+j\\end{aligned}\n$$" 13194139533864 true] [17592186257742 1000 #edb/ref 17592186257743 13194139533864 true] [17592186257742 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257742 1041 "answer" 13194139533864 true] [17592186257742 1104 #edb/ref 17592186257743 13194139533864 true] [17592186257742 1110 #uuid "f1ac6207-4087-530e-9fe1-9da08c372a49" 13194139533864 true] [17592186257743 1034 "-i+j" 13194139533864 true] [17592186257743 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257743 1111 #uuid "982e47be-9d80-5b71-9f5d-44d3b6ae03dd" 13194139533864 true] [17592186257744 1017 #edb/ref 17592186257745 13194139533864 true] [17592186257744 1089 "q-125088" 13194139533864 true] [17592186257744 1091 #edb/ref 17592186045463 13194139533864 true] [17592186257744 1100 "Find $3a-2b$ if $a=-2i-2j$ and $b=4i-3j.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257744 1113 #uuid "f8e09c5f-3163-502a-9685-5b7910432e07" 13194139533864 true] [17592186257744 1145 "To compute $3a-2b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}3a-2b & =3(-2i-2j)-2(4i-3j) \\\\  & =-6i-6j-8i+6j \\\\  & =(-6i-8i)+(-6j+6j) \\\\  & =-14i+0j \\\\  & =-14i\\end{aligned}\n$$" 13194139533864 true] [17592186257745 1000 #edb/ref 17592186257746 13194139533864 true] [17592186257745 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257745 1041 "answer" 13194139533864 true] [17592186257745 1104 #edb/ref 17592186257746 13194139533864 true] [17592186257745 1110 #uuid "3bb81aa6-7477-544b-af82-6b5dc6e9f217" 13194139533864 true] [17592186257746 1034 "-14i" 13194139533864 true] [17592186257746 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257746 1111 #uuid "7eff72b0-d83a-598a-a19a-d7af0f1ab26f" 13194139533864 true] [17592186257747 1017 #edb/ref 17592186257748 13194139533864 true] [17592186257747 1089 "q-125118" 13194139533864 true] [17592186257747 1091 #edb/ref 17592186045465 13194139533864 true] [17592186257747 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/f35a3ad730621023ec86e5727588fc86083ee500b3a72c55ab2808bd290019e9.png)\n\nLet $P(1,2)$ and $Q(-2,1).$ Find $|\\overset{\\to }{PQ}|.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186257747 1113 #uuid "4b06fa37-d404-5589-9f6d-01799f159fa1" 13194139533864 true] [17592186257747 1145 "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+2j, \\\\  & \\overset{\\to }{OQ}=q=-2i+j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(-2i+j)-(i+2j) \\\\  & =-3i-j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{(-3)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+1} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$" 13194139533864 true] [17592186257748 1000 #edb/ref 17592186257749 13194139533864 true] [17592186257748 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257748 1041 "answer" 13194139533864 true] [17592186257748 1104 #edb/ref 17592186257749 13194139533864 true] [17592186257748 1110 #uuid "486a89ce-2ca7-592d-b461-1818f3bd9dd4" 13194139533864 true] [17592186257749 1034 "\\sqrt{10}" 13194139533864 true] [17592186257749 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257749 1111 #uuid "297ddded-ba04-5871-a811-d35802dbb51a" 13194139533864 true] [17592186257750 1017 #edb/ref 17592186257751 13194139533864 true] [17592186257750 1017 #edb/ref 17592186257753 13194139533864 true] [17592186257750 1089 "q-125135" 13194139533864 true] [17592186257750 1091 #edb/ref 17592186045465 13194139533864 true] [17592186257750 1100 "Let $b=[\\begin{aligned}8 \\\\ -6\\end{aligned}].$ Find a unit vector that is parallel to $b$ and points the same direction.\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" 13194139533864 true] [17592186257750 1113 #uuid "adb02de3-f7e5-57f1-818d-3edb75ea73ed" 13194139533864 true] [17592186257750 1145 "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|\\,b\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,b\\,| & =\\sqrt{{8}^{2}+(-6)^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we divide $b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|b|} \\\\  & =\\frac{1}{10}\\cdot b \\\\  & =\\frac{1}{10}\\cdot [\\begin{aligned}8 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]\\end{aligned}\n$$" 13194139533864 true] [17592186257751 1000 #edb/ref 17592186257752 13194139533864 true] [17592186257751 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257751 1041 "r1c1" 13194139533864 true] [17592186257751 1104 #edb/ref 17592186257752 13194139533864 true] [17592186257751 1110 #uuid "9cc48a5a-a3ae-50dc-a406-d66b55ee722d" 13194139533864 true] [17592186257752 1034 "\\frac45" 13194139533864 true] [17592186257752 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257752 1111 #uuid "16d7fea7-b0b6-52fc-b8f0-1978d271f1c0" 13194139533864 true] [17592186257753 1000 #edb/ref 17592186257754 13194139533864 true] [17592186257753 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257753 1041 "r2c1" 13194139533864 true] [17592186257753 1104 #edb/ref 17592186257754 13194139533864 true] [17592186257753 1110 #uuid "d7c2efb0-9ebd-52cf-b71e-dd25d35571a1" 13194139533864 true] [17592186257754 1034 "-\\frac35" 13194139533864 true] [17592186257754 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257754 1111 #uuid "795b4aeb-8179-56c1-a770-6892600e7b7b" 13194139533864 true] [17592186257755 1017 #edb/ref 17592186257756 13194139533864 true] [17592186257755 1017 #edb/ref 17592186257758 13194139533864 true] [17592186257755 1089 "q-125138" 13194139533864 true] [17592186257755 1091 #edb/ref 17592186045464 13194139533864 true] [17592186257755 1100 "Let $a=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}5 \\\\ 8\\end{aligned}].$ Find a unit vector that is parallel to $2a+b$ and points the same direction.\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" 13194139533864 true] [17592186257755 1113 #uuid "bde60051-298e-59aa-a76e-9c9fabb0aba6" 13194139533864 true] [17592186257755 1145 "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}2a+b & =2\\cdot [\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0+5 \\\\ 4+8\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 12\\end{aligned}]\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|2a+b| & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|} \\\\  & =\\frac{1}{13}(2a+b) \\\\  & =\\frac{1}{13}\\cdot [\\begin{aligned}5 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{13} \\\\ \\frac{12}{13}\\end{aligned}]\\end{aligned}\n$$" 13194139533864 true] [17592186257756 1000 #edb/ref 17592186257757 13194139533864 true] [17592186257756 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257756 1041 "r1c1" 13194139533864 true] [17592186257756 1104 #edb/ref 17592186257757 13194139533864 true] [17592186257756 1110 #uuid "f4a95cd3-7d33-5b9e-86f2-7f568b3a6e4e" 13194139533864 true] [17592186257757 1034 "\\frac{5}{13}" 13194139533864 true] [17592186257757 1103 #edb/ref 17592186045453 13194139533864 true] [17592186257757 1111 #uuid "186922e0-79e7-5bea-a1c9-9dc53e50e9f4" 13194139533864 true] [17592186257758 1000 #edb/ref 17592186257759 13194139533864 true] [17592186257758 1040 #edb/ref 17592186045449 13194139533864 true] [17592186257758 1041 "r2c1" 13194139533864 true] [17592186257758 1104 #edb/ref 17592186257759 13194139533864 true] [17592186257758 1110 #uuid "05f5166b-2a10-5206-90d3-d3328b1a0f86" 13194139533864 true] [17592186257759 1034 "\\frac{12}{13}" 13194139533864 true] [17592186257759 1103 #edb/ref 17592186045453 13194139