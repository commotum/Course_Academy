9533864 true] [17592186259682 1111 #uuid "51acf93b-ed3d-548f-b51d-e14652e3df59" 13194139533864 true] [17592186259683 1000 #edb/ref 17592186259684 13194139533864 true] [17592186259683 1040 #edb/ref 17592186045449 13194139533864 true] [17592186259683 1041 "field-2" 13194139533864 true] [17592186259683 1104 #edb/ref 17592186259684 13194139533864 true] [17592186259683 1110 #uuid "669e1d1d-0474-5d68-bb83-ac48ab6df60e" 13194139533864 true] [17592186259684 1034 "\\frac{\\sqrt{3}}{2}" 13194139533864 true] [17592186259684 1103 #edb/ref 17592186045453 13194139533864 true] [17592186259684 1111 #uuid "2de1260c-8c1f-5d38-8f76-c3e2dd75af80" 13194139533864 true] [17592186259685 1017 #edb/ref 17592186259686 13194139533864 true] [17592186259685 1017 #edb/ref 17592186259688 13194139533864 true] [17592186259685 1089 "q-329274" 13194139533864 true] [17592186259685 1091 #edb/ref 17592186045464 13194139533864 true] [17592186259685 1100 "Express $\\operatorname{sin}(x+\\frac{5\\pi }{3})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x+\\frac{5\\pi }{3})=$\n{{field-1}}$\\operatorname{sin}x\\,-$\n{{field-2}}$\\operatorname{cos}x$" 13194139533864 true] [17592186259685 1113 #uuid "208347ca-06e2-58b6-b488-fc91f6cb7f96" 13194139533864 true] [17592186259685 1145 "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}(u+v)=\\operatorname{sin}u\\operatorname{cos}v+\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{5\\pi }{3},$ we get \n\n$$\n\\begin{aligned}\\operatorname{sin}(x+\\frac{5\\pi }{3}) & =\\operatorname{sin}x\\operatorname{cos}(\\frac{5\\pi }{3})+\\operatorname{cos}x\\operatorname{sin}(\\frac{5\\pi }{3}) \\\\  & =\\operatorname{sin}x\\cdot (\\frac{1}{2})+\\operatorname{cos}x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}x-\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$" 13194139533864 true] [17592186259686 1000 #edb/ref 17592186259687 131941395