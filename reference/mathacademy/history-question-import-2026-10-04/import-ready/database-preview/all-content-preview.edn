1}\n$$\n\nSince $12=4\\cdot 3,$ the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-12} & =-\\sqrt{12\\cdot (-1)} \\\\  & =-\\sqrt{4\\cdot 3\\cdot (-1)} \\\\  & =-\\sqrt{4}\\cdot \\sqrt{3}\\cdot \\sqrt{-1} \\\\  & =-2\\sqrt{3}\\,\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260906 1000 #edb/ref 17592186260907 13194139533864 true] [17592186260906 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260906 1041 "answer" 13194139533864 true] [17592186260906 1104 #edb/ref 17592186260907 13194139533864 true] [17592186260906 1110 #uuid "33511e51-3352-536b-90a3-01c8208e3875" 13194139533864 true] [17592186260907 1034 "-2\\sqrt{3}\\,\\text{i}" 13194139533864 true] [17592186260907 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260907 1111 #uuid "845ca887-5584-5cbd-9e18-81eeca2eb160" 13194139533864 true] [17592186260908 1017 #edb/ref 17592186260909 13194139533864 true] [17592186260908 1089 "q-66226" 13194139533864 true] [17592186260908 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260908 1100 "$-\\sqrt{-8}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260908 1113 #uuid "7cbde6cf-0e45-5c99-bf6a-3df156d4e49a" 13194139533864 true] [17592186260908 1145 "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nSince $8=4\\cdot 2,$ the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-8} & =-\\sqrt{8\\cdot (-1)} \\\\  & =-\\sqrt{4\\cdot 2\\cdot (-1)} \\\\  & =-\\sqrt{4}\\cdot \\sqrt{2}\\cdot \\sqrt{-1} \\\\  & =-2\\sqrt{2}\\,\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260909 1000 #edb/ref 17592186260910 13194139533864 true] [17592186260909 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260909 1041 "answer" 13194139533864 true] [17592186260909 1104 #edb/ref 17592186260910 13194139533864 true] [17592186260909 1110 #uuid "703f5ba3-59ec-5cb4-96ad-1175b103312b" 13194139533864 true] [17592186260910 1034 "-2\\sqrt{2}\\,\\text{i}" 13194139533864 true] [17592186260910 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260910 1111 #uuid "da56c139-c398-5b9e-8c09-a7f84db87e86" 13194139533864 true] [17592186260911 1017 #edb/ref 17592186260912 13194139533864 true] [17592186260911 1089 "q-66235" 13194139533864 true] [17592186260911 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260911 1100 "$-\\sqrt{-\\frac{16}{9}}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260911 1113 #uuid "2ebbdd24-e97c-5ef9-8692-f3145c68ea3c" 13194139533864 true] [17592186260911 1145 "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-\\frac{16}{9}} & =-\\sqrt{\\frac{16}{9}\\cdot (-1)} \\\\  & =-\\sqrt{\\frac{16}{9}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{\\sqrt{16}}{\\sqrt{9}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{4}{3}\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260912 1000 #edb/ref 17592186260913 13194139533864 true] [17592186260912 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260912 1041 "answer" 13194139533864 true] [17592186260912 1104 #edb/ref 17592186260913 13194139533864 true] [17592186260912 1110 #uuid "5e71a553-1ce1-5a59-84b1-1c2013ff890b" 13194139533864 true] [17592186260913 1034 "-\\frac{4}{3}\\text{i}" 13194139533864 true] [17592186260913 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260913 1111 #uuid "a2e4f3cc-2370-598b-87d1-c1eebc198ea1" 13194139533864 true] [17592186260914 1017 #edb/ref 17592186260915 13194139533864 true] [17592186260914 1089 "q-66236" 13194139533864 true] [17592186260914 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260914 1100 "$-\\sqrt{-\\frac{9}{49}}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260914 1113 #uuid "be123228-4149-57f4-a7e3-eae84dca8b10" 13194139533864 true] [17592186260914 1145 "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-\\frac{9}{49}} & =-\\sqrt{\\frac{9}{49}\\cdot (-1)} \\\\  & =-\\sqrt{\\frac{9}{49}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{\\sqrt{9}}{\\sqrt{49}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{3}{7}\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260915 1000 #edb/ref 17592186260916 13194139533864 true] [17592186260915 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260915 1041 "answer" 13194139533864 true] [17592186260915 1104 #edb/ref 17592186260916 13194139533864 true] [17592186260915 1110 #uuid "6763b942-ee0c-5a78-a981-a1ac7258580b" 13194139533864 true] [17592186260916 1034 "-\\frac{3}{7}\\text{i}" 13194139533864 true] [17592186260916 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260916 1111 #uuid "240737e7-8e13-5104-a6fa-735cfd096f1d" 13194139533864 true] [17592186260917 1017 #edb/ref 17592186260918 13194139533864 true] [17592186260917 1017 #edb/ref 17592186260920 13194139533864 true] [17592186260917 1089 "q-66252" 13194139533864 true] [17592186260917 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260917 1100 "If $4{y}^{2}+25=0,$ then $y=$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260917 1113 #uuid "f724ceca-0067-5fb3-8235-2b58d83a773f" 13194139533864 true] [17592186260917 1145 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}+25 & =0 \\\\ 4{y}^{2} & =-25 \\\\ {y}^{2} & =-\\frac{25}{4}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\ny=\\pm \\sqrt{-\\frac{25}{4}}\n$$\n\nWe now rewrite $y$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}y & =\\pm \\sqrt{-\\frac{25}{4}} \\\\  & =\\pm \\sqrt{\\frac{25}{4}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{25}{4}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{25}}{\\sqrt{4}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{5}{2}\\text{i}\\end{aligned}\n$$" 13194139533864 true] [17592186260918 1000 #edb/ref 17592186260919 13194139533864 true] [17592186260918 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260918 1041 "negative-imaginary" 13194139533864 true] [17592186260918 1104 #edb/ref 17592186260919 13194139533864 true] [17592186260918 1110 #uuid "a99ba2b0-4b8c-597c-a54d-a843c069dc63" 13194139533864 true] [17592186260919 1034 "-\\frac{5}{2}\\text{i}" 13194139533864 true] [17592186260919 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260919 1111 #uuid "a44db1bc-9298-57d1-8e01-11f9e5b2cc36" 13194139533864 true] [17592186260920 1000 #edb/ref 17592186260921 13194139533864 true] [17592186260920 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260920 1041 "positive-imaginary" 13194139533864 true] [17592186260920 1104 #edb/ref 17592186260921 13194139533864 true] [17592186260920 1110 #uuid "bfe18c4b-63d6-5f20-b642-e5a386485e28" 13194139533864 true] [17592186260921 1034 "\\frac{5}{2}\\text{i}" 13194139533864 true] [17592186260921 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260921 1111 #uuid "3cf50468-3a39-541a-b9e4-e37113140920" 13194139533864 true] [17592186260922 1017 #edb/ref 17592186260923 13194139533864 true] [17592186260922 1089 "q-66385" 13194139533864 true] [17592186260922 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260922 1100 "What is the value of $4{\\text{i}}^{3}-5{\\text{i}}^{2}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260922 1113 #uuid "a68b8235-f32a-5c69-b523-5c1357944070" 13194139533864 true] [17592186260922 1145 "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}4{\\text{i}}^{3}-5{\\text{i}}^{2}=4(-\\text{i})-5(-1)=5-4\\text{i}.\\end{aligned}\n$$" 13194139533864 true] [17592186260923 1000 #edb/ref 17592186260924 13194139533864 true] [17592186260923 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260923 1041 "answer" 13194139533864 true] [17592186260923 1104 #edb/ref 17592186260924 13194139533864 true] [17592186260923 1110 #uuid "d958c418-00f9-566e-b673-2785517e3e74" 13194139533864 true] [17592186260924 1034 "5-4\\text{i}" 13194139533864 true] [17592186260924 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260924 1111 #uuid "e681740f-7a97-5e98-ac7a-808fbbb2af5f" 13194139533864 true] [17592186260925 1017 #edb/ref 17592186260926 13194139533864 true] [17592186260925 1089 "q-66407" 13194139533864 true] [17592186260925 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260925 1100 "If $f(x)=4x-1$ and $g(x)=x+6,$ then $(f+g)(x)=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260925 1113 #uuid "b430534c-adbb-540f-96e1-9fc409650077" 13194139533864 true] [17592186260925 1145 "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\nTo find the sum of the two functions, we add them together:\n\n$$\n\\begin{aligned}(f+g)(x) & =(4x-1)+(x+6) \\\\  & =(4x+x)+(-1+6) \\\\  & =5x+5\\end{aligned}\n$$" 13194139533864 true] [17592186260926 1000 #edb/ref 17592186260927 13194139533864 true] [17592186260926 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260926 1041 "answer" 13194139533864 true] [17592186260926 1104 #edb/ref 17592186260927 13194139533864 true] [17592186260926 1110 #uuid "044aa151-311a-5374-b2c1-d343787d2f55" 13194139533864 true] [17592186260927 1034 "5x+5" 13194139533864 true] [17592186260927 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260927 1111 #uuid "15498710-5e8b-5093-9791-0e4698730298" 13194139533864 true] [17592186260928 1017 #edb/ref 17592186260929 13194139533864 true] [17592186260928 1089 "q-66412" 13194139533864 true] [17592186260928 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260928 1100 "Given $f(x)={x}^{2}-6$ and $g(x)=-x+2,$ find  $(f-g)(4).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260928 1113 #uuid "85eb992c-5f22-5219-9748-87d4d54a3ac2" 13194139533864 true] [17592186260928 1145 "The notation $(f-g)(x)$ means the difference of the functions $f(x)$ and $g(x).$ \n\n**Method 1** \n\nTo evaluate $(f-g)(4),$ we find $f(4)$ and $g(4),$ and then subtract $g(4)$ from $f(4).$\n\nSo, first we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =(4)^{2}-6=10 \\\\ g(4) & =-(4)+2=-2\\end{aligned}\n$$\n\n \n\nNext, we subtract $g(4)$ from $f(4)$:\n\n$$\n(f-g)(4)=f(4)-g(4)=10-(-2)=12\n$$\n\n**Method 2**\n\nFirst we find the difference of the two functions $f$ and $g$ by subtracting $g(x)$ from $f(x)$: \n\n$$\n\\begin{aligned}(f-g)(x) & =({x}^{2}-6)-(-x+2) \\\\  & ={x}^{2}-6+x-2 \\\\  & ={x}^{2}+x-8\\end{aligned}\n$$\n\nNow, we evaluate $(f-g)(4):$\n\n$$\n\\begin{aligned}(f-g)(4) & =(4)^{2}+4-8=12\\end{aligned}\n$$" 13194139533864 true] [17592186260929 1000 #edb/ref 17592186260930 13194139533864 true] [17592186260929 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260929 1041 "answer" 13194139533864 true] [17592186260929 1104 #edb/ref 17592186260930 13194139533864 true] [17592186260929 1110 #uuid "6821fbd9-b4f5-5206-b8ed-cd3fb89fc36b" 13194139533864 true] [17592186260930 1034 "12" 13194139533864 true] [17592186260930 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260930 1111 #uuid "7638ef27-f19f-5c5f-a5c1-11acc4e29d6a" 13194139533864 true] [17592186260931 1017 #edb/ref 17592186260932 13194139533864 true] [17592186260931 1089 "q-66420" 13194139533864 true] [17592186260931 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260931 1100 "Given $f(x)=4{x}^{2}-4$ and $g(x)={x}^{2}+2,$ find  $(fg)(-2).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260931 1113 #uuid "7f3adebb-be1f-5f32-94a7-24221953a6e1" 13194139533864 true] [17592186260931 1145 "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-2),$ we find $f(-2)$ and $g(-2),$ and then multiply the results.\n\nFirst, we find $f(-2)$ and $g(-2):$\n\n$$\n\\begin{aligned}f(-2) & =4(-2)^{2}-4=12 \\\\ g(-2) & =(-2)^{2}+2=6\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-2)=f(-2)g(-2)=12\\cdot 6=72\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(4{x}^{2}-4)({x}^{2}+2) \\\\  & =4{x}^{4}+4{x}^{2}-8\\end{aligned}\n$$\n\n \n\nNow, we evaluate $(fg)(-2):$ \n\n$$\n\\begin{aligned}(fg)(-2) & =4(-2)^{4}+4(-2)^{2}-8 \\\\  & =64+16-8 \\\\  & =72\\end{aligned}\n$$" 13194139533864 true] [17592186260932 1000 #edb/ref 17592186260933 13194139533864 true] [17592186260932 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260932 1041 "answer" 13194139533864 true] [17592186260932 1104 #edb/ref 17592186260933 13194139533864 true] [17592186260932 1110 #uuid "e28444a1-1bf8-5433-8bf8-e1265d606a0e" 13194139533864 true] [17592186260933 1034 "72" 13194139533864 true] [17592186260933 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260933 1111 #uuid "7629391d-2609-5c56-8323-73c227842648" 13194139533864 true] [17592186260934 1017 #edb/ref 17592186260935 13194139533864 true] [17592186260934 1089 "q-66425" 13194139533864 true] [17592186260934 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260934 1100 "Given $f(x)=2{x}^{2}-6$ and $g(x)=-2x+2,$ find  $(f/g)(3).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260934 1113 #uuid "be22410d-413d-5639-ac9e-a2e4fceb3697" 13194139533864 true] [17592186260934 1145 "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(3),$ we find $f(3)$ and $g(3),$ and then divide the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =2(3)^{2}-6=12 \\\\ g(3) & =-2(3)+2=-4\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(3)=\\frac{f(3)}{g(3)}=\\frac{12}{-4}=-3\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{2{x}^{2}-6}{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$" 13194139533864 true] [17592186260935 1000 #edb/ref 17592186260936 13194139533864 true] [17592186260935 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260935 1041 "answer" 13194139533864 true] [17592186260935 1104 #edb/ref 17592186260936 13194139533864 true] [17592186260935 1110 #uuid "61952005-9460-5d76-b16f-7f533c1dbb6b" 13194139533864 true] [17592186260936 1034 "-3" 13194139533864 true] [17592186260936 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260936 1111 #uuid "b9267840-5ce8-574d-a2fc-24a332eabb5f" 13194139533864 true] [17592186260937 1017 #edb/ref 17592186260938 13194139533864 true] [17592186260937 1089 "q-66456" 13194139533864 true] [17592186260937 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260937 1100 "Suppose that $f(x)=2x+6$ and $g(x)=\\frac{x}{2}+k.$ If $g$ is the inverse of $f,$ then $k=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260937 1113 #uuid "923497f6-8730-5b4d-abe0-ef7248d1cbbc" 13194139533864 true] [17592186260937 1145 "If $g$ is the inverse of $f,$ then we must have:\n\n$$\ng(f(x))=x\n$$\n\nTo find $g(f(x)),$ we write down the function $g$ and replace every occurrence of $x$ with $f(x):$\n\n$$\n\\begin{aligned}g(x) & =\\frac{x}{2}+k \\\\ g(f(x)) & =\\frac{f(x)}{2}+k\\end{aligned}\n$$\n\nThen, we substitute $f(x)=2x+6$ into the right-hand side of our expression and simplify, as follows:\n\n$$\n\\begin{aligned}g(f(x)) & =\\frac{f(x)}{2}+k \\\\  & =\\frac{2x+6}{2}+k \\\\  & =x+3+k\\end{aligned}\n$$\n\nHowever, we also know that $g(f(x))=x.$ Equating the expression above with $x$ and solving for $k$ gives:\n\n$$\n\\begin{aligned}x+3+k & =x \\\\ \\cancel{x}+3+k & =\\cancel{x} \\\\ 3+k & =0 \\\\ k & =-3\\end{aligned}\n$$" 13194139533864 true] [17592186260938 1000 #edb/ref 17592186260939 13194139533864 true] [17592186260938 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260938 1041 "answer" 13194139533864 true] [17592186260938 1104 #edb/ref 17592186260939 13194139533864 true] [17592186260938 1110 #uuid "390887ae-57b4-509e-a85d-2fcab16c4c1d" 13194139533864 true] [17592186260939 1034 "-3" 13194139533864 true] [17592186260939 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260939 1111 #uuid "90f9a494-3dc9-5916-a927-e8fd3b943a34" 13194139533864 true] [17592186260940 1017 #edb/ref 17592186260941 13194139533864 true] [17592186260940 1089 "q-66481" 13194139533864 true] [17592186260940 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260940 1100 "Find  $(f/g)(-2)$  for $f(x)={x}^{2}+x$ and $g(x)={x}^{2}+2x.$\n\nAnswer: {{answer}}\n\nIf the value is undefined, enter \"Undefined\"." 13194139533864 true] [17592186260940 1113 #uuid "935c56eb-56da-5d6e-947a-de0e34bd7c74" 13194139533864 true] [17592186260940 1145 "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$ \n\nTo evaluate $(f/g)(-2),$ we find $f(-2)$ and $g(-2),$ and then divide the results. \n\nFirst, we find $f(-2)$ and $g(-2):$\n\n$$\n\\begin{aligned}f(-2) & =(-2)^{2}+(-2)=2 \\\\ g(-2) & =(-2)^{2}+2(-2)=0\\end{aligned}\n$$\n\n \n\nHowever, since the denominator of a fraction can't be zero, we can't divide $f(-2)$ by $g(-2).$\n\nTherefore, the value  $(f/g)(-2)$  is undefined." 13194139533864 true] [17592186260941 1000 #edb/ref 17592186260942 13194139533864 true] [17592186260941 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260941 1041 "answer" 13194139533864 true] [17592186260941 1104 #edb/ref 17592186260942 13194139533864 true] [17592186260941 1110 #uuid "db91a2a4-f747-5abc-b3f2-624d8c8adf48" 13194139533864 true] [17592186260942 1034 "Undefined" 13194139533864 true] [17592186260942 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260942 1111 #uuid "972fdea6-91a0-5c04-915e-c97d847aea79" 13194139533864 true] [17592186260943 1017 #edb/ref 17592186260944 13194139533864 true] [17592186260943 1089 "q-66490" 13194139533864 true] [17592186260943 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260943 1100 "$-4{\\text{i}}^{-2}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260943 1113 #uuid "1ba253e5-6b77-5991-9dca-b8648ddf6d5a" 13194139533864 true] [17592186260943 1145 "First, using the laws of exponents, we can write\n\n$$\n-4{\\text{i}}^{-2}=-\\frac{4}{{\\text{i}}^{2}}.\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n-\\frac{4}{{\\text{i}}^{2}}=-\\frac{4}{(-1)}=4.\n$$" 13194139533864 true] [17592186260944 1000 #edb/ref 17592186260945 13194139533864 true] [17592186260944 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260944 1041 "answer" 13194139533864 true] [17592186260944 1104 #edb/ref 17592186260945 13194139533864 true] [17592186260944 1110 #uuid "a58bb529-ef27-5657-bf19-9e025da5b449" 13194139533864 true] [17592186260945 1034 "4" 13194139533864 true] [17592186260945 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260945 1111 #uuid "593fe36f-a7fe-5072-a247-39f4491b9f08" 13194139533864 true] [17592186260946 1017 #edb/ref 17592186260947 13194139533864 true] [17592186260946 1089 "q-66543" 13194139533864 true] [17592186260946 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260946 1100 "${10}^{-2}=\\frac{1}{100}$ can be expressed as\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260946 1113 #uuid "8d9381b1-5d42-59c3-a9db-06ef4e432e12" 13194139533864 true] [17592186260946 1145 "The common logarithm of $a$ is defined as follows:\n\n$a={10}^{x}$ is equivalent to $\\operatorname{log}a=x$\n\nIf we compare ${10}^{-2}=\\frac{1}{100}$ with ${10}^{x}=a,$ we get that $a=\\frac{1}{100}$ and $x=-2.$\n\nTherefore, the given equation can be expressed as $\\operatorname{log}(\\frac{1}{100})=-2.$" 13194139533864 true] [17592186260947 1000 #edb/ref 17592186260948 13194139533864 true] [17592186260947 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260947 1041 "answer" 13194139533864 true] [17592186260947 1104 #edb/ref 17592186260948 13194139533864 true] [17592186260947 1110 #uuid "4f1ffe92-7dfd-5bed-b30d-4bf73054fd9b" 13194139533864 true] [17592186260948 1034 "\\log(\\frac1{100})=-2" 13194139533864 true] [17592186260948 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260948 1111 #uuid "76c18914-f970-503f-9a77-1028bab8d491" 13194139533864 true] [17592186260949 1017 #edb/ref 17592186260950 13194139533864 true] [17592186260949 1089 "q-66562" 13194139533864 true] [17592186260949 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260949 1100 "$\\sqrt[3]{8}=2$ can be expressed as\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260949 1113 #uuid "db59994b-3786-5ceb-b867-dea36ed5e45c" 13194139533864 true] [17592186260949 1145 "Notice that the given equation can be written using exponents as follows:\n\n$$\n{8}^{1/3}=2\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}a=x$\n\nIf we compare ${8}^{1/3}=2$ with $a={b}^{x},$ we get $a=2,b=8$ and $x=\\frac{1}{3}.$\n\nTherefore, the equation $\\sqrt[3]{8}=2$ can be expressed as ${log}_{8}2=\\frac{1}{3}.$" 13194139533864 true] [17592186260950 1000 #edb/ref 17592186260951 13194139533864 true] [17592186260950 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260950 1041 "answer" 13194139533864 true] [17592186260950 1104 #edb/ref 17592186260951 13194139533864 true] [17592186260950 1110 #uuid "34785903-564a-59db-bbad-262350972f05" 13194139533864 true] [17592186260951 1034 "\\log_8(2)=\\frac13" 13194139533864 true] [17592186260951 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260951 1111 #uuid "a31307d4-fe95-5905-a002-d3737b2b6099" 13194139533864 true] [17592186260952 1017 #edb/ref 17592186260953 13194139533864 true] [17592186260952 1089 "q-66608" 13194139533864 true] [17592186260952 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260952 1100 "${10}^{5}=100\\,000$ is equivalent to\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260952 1113 #uuid "60a81016-2737-5fbd-a942-918bcffa80d1" 13194139533864 true] [17592186260952 1145 "The common logarithm of $a$ is defined as follows:\n\n$a={10}^{x}$ is equivalent to $\\operatorname{log}a=x$\n\nIf we compare ${10}^{5}=100\\,000$ with ${10}^{x}=a,$ we get that $a=100\\,000$ and $x=5.$\n\nTherefore, the given equation can be expressed as $\\operatorname{log}100\\,000=5.$" 13194139533864 true] [17592186260953 1000 #edb/ref 17592186260954 13194139533864 true] [17592186260953 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260953 1041 "answer" 13194139533864 true] [17592186260953 1104 #edb/ref 17592186260954 13194139533864 true] [17592186260953 1110 #uuid "22b33d7f-14b9-5ed8-8917-15d3b8646c25" 13194139533864 true] [17592186260954 1034 "\\log(100000)=5" 13194139533864 true] [17592186260954 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260954 1111 #uuid "844b1b1f-1133-5919-81f9-e8fa8d4433c4" 13194139533864 true] [17592186260955 1017 #edb/ref 17592186260956 13194139533864 true] [17592186260955 1089 "q-66631" 13194139533864 true] [17592186260955 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260955 1100 "$\\operatorname{log}(\\sqrt[4]{10})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260955 1113 #uuid "eeafaca2-0567-55ba-95dd-d0ca684cdc15" 13194139533864 true] [17592186260955 1145 "First, we rewrite $\\sqrt[4]{10}$ as a power of $10$ (the base of the common logarithm) as follows:\n\n$$\n\\sqrt[4]{10}={10}^{1/4}\n$$\n\nTherefore, we have:\n\n$$\n\\operatorname{log}(\\sqrt[4]{10})=\\operatorname{log}({10}^{1/4})\n$$\n\nThe common logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{log}({10}^{x})=x\n$$\n\nIn our case, we have $x=\\frac{1}{4}.$ Therefore:\n\n$$\n\\operatorname{log}({10}^{1/4})=\\frac{1}{4}\n$$" 13194139533864 true] [17592186260956 1000 #edb/ref 17592186260957 13194139533864 true] [17592186260956 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260956 1041 "answer" 13194139533864 true] [17592186260956 1104 #edb/ref 17592186260957 13194139533864 true] [17592186260956 1110 #uuid "acd6482b-f428-5998-8399-25cb88d42795" 13194139533864 true] [17592186260957 1034 "\\frac{1}{4}" 13194139533864 true] [17592186260957 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260957 1111 #uuid "475a2c31-42f1-50cb-a261-1edd8acd5e39" 13194139533864 true] [17592186260958 1017 #edb/ref 17592186260959 13194139533864 true] [17592186260958 1089 "q-66772" 13194139533864 true] [17592186260958 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260958 1100 "$6{log}_{5}(100)-6{log}_{5}(4)=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260958 1113 #uuid "77269f1f-6854-5aa0-b092-d17b19bb30c9" 13194139533864 true] [17592186260958 1145 "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}(a)-{log}_{n}(b)={log}_{n}(\\frac{a}{b})\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get:\n\n$$\n\\begin{aligned}6{log}_{5}(100)-6{log}_{5}(4) & =6({log}_{5}(100)-{log}_{5}(4)) \\\\  & =6{log}_{5}(\\frac{100}{4}) \\\\  & =6{log}_{5}(25)\\end{aligned}\n$$\n\nNow, since ${5}^{2}=25$, then ${log}_{5}(25)={log}_{5}({5}^{2})=2.$ Therefore:\n\n$$\n6{log}_{5}(25)=6\\cdot 2=12.\n$$" 13194139533864 true] [17592186260959 1000 #edb/ref 17592186260960 13194139533864 true] [17592186260959 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260959 1041 "answer" 13194139533864 true] [17592186260959 1104 #edb/ref 17592186260960 13194139533864 true] [17592186260959 1110 #uuid "51107b99-a0e6-5ec3-9377-1d83c4b7a6fa" 13194139533864 true] [17592186260960 1034 "12" 13194139533864 true] [17592186260960 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260960 1111 #uuid "6130991a-8ab3-5716-b016-0c243c85f322" 13194139533864 true] [17592186260961 1017 #edb/ref 17592186260962 13194139533864 true] [17592186260961 1017 #edb/ref 17592186260964 13194139533864 true] [17592186260961 1089 "q-66775" 13194139533864 true] [17592186260961 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260961 1100 "Solve  the equation $\\,-8x+12=-2{x}^{2}.$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260961 1113 #uuid "a0ae1569-8075-5465-a638-d178abfe16cf" 13194139533864 true] [17592186260961 1145 "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n2{x}^{2}-8x+12=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=2,b=-8,$ and $c=12.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-8)\\pm \\sqrt{(-8)^{2}-4(2)(12)}}{2(2)} \\\\  & =\\frac{8\\pm \\sqrt{64-96}}{4} \\\\  & =\\frac{8\\pm \\sqrt{-32}}{4} \\\\  & =\\frac{8\\pm 4\\sqrt{-2}}{4} \\\\  & =\\frac{8\\pm 4\\sqrt{2}\\,\\text{i}}{4} \\\\  & =2\\pm \\sqrt{2}\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=2+\\sqrt{2}\\,\\text{i}$ and $x=2-\\sqrt{2}\\,\\text{i}.$" 13194139533864 true] [17592186260962 1000 #edb/ref 17592186260963 13194139533864 true] [17592186260962 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260962 1041 "negative-imaginary" 13194139533864 true] [17592186260962 1104 #edb/ref 17592186260963 13194139533864 true] [17592186260962 1110 #uuid "2b1ca20e-b7a1-5dae-937e-7b4ddecc1644" 13194139533864 true] [17592186260963 1034 "2-\\sqrt{2}\\text{i}" 13194139533864 true] [17592186260963 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260963 1111 #uuid "24f50e01-f88a-581c-b971-bbc1a112f822" 13194139533864 true] [17592186260964 1000 #edb/ref 17592186260965 13194139533864 true] [17592186260964 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260964 1041 "positive-imaginary" 13194139533864 true] [17592186260964 1104 #edb/ref 17592186260965 13194139533864 true] [17592186260964 1110 #uuid "54d6f046-a63a-575e-9cd1-252b6e2d357b" 13194139533864 true] [17592186260965 1034 "2+\\sqrt{2}\\text{i}" 13194139533864 true] [17592186260965 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260965 1111 #uuid "f0be5902-0d01-58a4-8d09-386efcd448f4" 13194139533864 true] [17592186260966 1017 #edb/ref 17592186260967 13194139533864 true] [17592186260966 1089 "q-66785" 13194139533864 true] [17592186260966 1091 #edb/ref 17592186045465 13194139533864 true] [17592186260966 1100 "Given that $f(x)=|x-4|+2,$ on which of the following intervals is $f(x)$ invertible?\n\nI. - $x\\in (-\\infty ,3)$\nII. - $x\\in (1,\\infty )$\nIII. - $x\\in (-\\infty ,5]$" 13194139533864 true] [17592186260966 1113 #uuid "4cce8534-f73e-5161-8a0a-c2664b949e49" 13194139533864 true] [17592186260966 1145 "The graph of the function $f(x)=|x-4|+2$ can be obtained in the following way:\n\n- Take the curve $y=|x|.$\n\n- Translate it by $4$ units to the right,  to get $y=|x-4|.$\n\n- Finally, translate $y=|x-4|$ by $2$ units up to get $f(x)=|x-4|+2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/56956d0f23ae6828098507712fd00525dc4f114a195716dc16e63d8475e9c143.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on the interval $x\\in (-\\infty ,3).$  Indeed, on this interval, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- The function $f(x)$ is not invertible on any of the intervals $x\\in (1,\\infty )$  and $(-\\infty ,5].$ On each of these intervals, some horizontal lines will intersect the curve more than once.\n\nTherefore, the correct answer is \"I only\"." 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260968 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260969 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260970 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260971 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260972 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260973 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260974 13194139533864 true] [17592186260967 1000 #edb/ref 17592186260975 13194139533864 true] [17592186260967 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260967 1041 "selection" 13194139533864 true] [17592186260967 1104 #edb/ref 17592186260971 13194139533864 true] [17592186260967 1110 #uuid "14d3f168-6a19-58ff-abd8-b04a5f4655b8" 13194139533864 true] [17592186260968 1034 "I, II, and III" 13194139533864 true] [17592186260968 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260968 1111 #uuid "ab26b8cb-a139-5ce9-a151-ebee17d1b6f9" 13194139533864 true] [17592186260969 1034 "II and III only" 13194139533864 true] [17592186260969 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260969 1111 #uuid "11c95497-a320-54ed-a88c-ad12ea0c199f" 13194139533864 true] [17592186260970 1034 "I and III only" 13194139533864 true] [17592186260970 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260970 1111 #uuid "d054f279-d2ac-5a3a-8060-047cfa775c71" 13194139533864 true] [17592186260971 1034 "I only" 13194139533864 true] [17592186260971 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260971 1111 #uuid "881d65ca-2072-5588-bce2-9ed33b1a57dc" 13194139533864 true] [17592186260972 1034 "III only" 13194139533864 true] [17592186260972 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260972 1111 #uuid "75b3a3b7-487c-519f-ba7a-d4d852a091ed" 13194139533864 true] [17592186260973 1034 "I and II only" 13194139533864 true] [17592186260973 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260973 1111 #uuid "0ed2ddfb-be8c-5994-95e9-1fa71c0540c7" 13194139533864 true] [17592186260974 1034 "None of those listed" 13194139533864 true] [17592186260974 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260974 1111 #uuid "dac16ae2-2b04-54fb-8083-8201d8ca44f7" 13194139533864 true] [17592186260975 1034 "II only" 13194139533864 true] [17592186260975 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260975 1111 #uuid "fe58edd6-ff34-597f-baca-916875313e30" 13194139533864 true] [17592186260976 1017 #edb/ref 17592186260977 13194139533864 true] [17592186260976 1017 #edb/ref 17592186260979 13194139533864 true] [17592186260976 1089 "q-66787" 13194139533864 true] [17592186260976 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260976 1100 "What are the solutions of the equation $(x+3)^{2}=-4?$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" 13194139533864 true] [17592186260976 1113 #uuid "f8dfc8a4-662b-559f-ab6e-e3ca78db96aa" 13194139533864 true] [17592186260976 1145 "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+3)^{2} & =-4 \\\\ x+3 & =\\pm \\sqrt{-4} \\\\ x+3 & =\\pm 2\\,\\text{i} \\\\ x & =-3\\pm 2\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-3+2\\,\\text{i}$ and $x=-3-2\\,\\text{i}.$" 13194139533864 true] [17592186260977 1000 #edb/ref 17592186260978 13194139533864 true] [17592186260977 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260977 1041 "negative-imaginary" 13194139533864 true] [17592186260977 1104 #edb/ref 17592186260978 13194139533864 true] [17592186260977 1110 #uuid "eb1b6100-cb79-5718-a6f4-98aeeb708567" 13194139533864 true] [17592186260978 1034 "-3-2\\text{i}" 13194139533864 true] [17592186260978 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260978 1111 #uuid "3d9a50a4-2738-52a1-9efe-e5a08cfdd147" 13194139533864 true] [17592186260979 1000 #edb/ref 17592186260980 13194139533864 true] [17592186260979 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260979 1041 "positive-imaginary" 13194139533864 true] [17592186260979 1104 #edb/ref 17592186260980 13194139533864 true] [17592186260979 1110 #uuid "3df237cf-ad3d-56bd-9c07-9290f3c220ab" 13194139533864 true] [17592186260980 1034 "-3+2\\text{i}" 13194139533864 true] [17592186260980 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260980 1111 #uuid "aa98451f-972f-5621-a6c4-fe158948853d" 13194139533864 true] [17592186260981 1017 #edb/ref 17592186260982 13194139533864 true] [17592186260981 1089 "q-66832" 13194139533864 true] [17592186260981 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260981 1100 "Find the exact solution to the equation $3({4}^{y})-14=19.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260981 1113 #uuid "201b2cc7-e621-5a40-94ff-980ef3cc44e5" 13194139533864 true] [17592186260981 1145 "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}3({4}^{y})-14 & =19 \\\\ 3({4}^{y}) & =33 \\\\ {4}^{y} & =11\\end{aligned}\n$$\n\nNow, we take ${log}_{4}$ of both sides of the equation and solve for $y$:\n\n$$\n\\begin{aligned}{log}_{4}({4}^{y}) & ={log}_{4}(11) \\\\ y & ={log}_{4}(11)\\end{aligned}\n$$\n\nTherefore, the solution is $y={log}_{4}(11).$" 13194139533864 true] [17592186260982 1000 #edb/ref 17592186260983 13194139533864 true] [17592186260982 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260982 1041 "answer" 13194139533864 true] [17592186260982 1104 #edb/ref 17592186260983 13194139533864 true] [17592186260982 1110 #uuid "df1cad20-449e-5a8e-a4b7-f19180feea15" 13194139533864 true] [17592186260983 1034 "{log}_{4}(11)" 13194139533864 true] [17592186260983 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260983 1111 #uuid "b3c1e965-aeee-5783-9611-e024460bf705" 13194139533864 true] [17592186260984 1017 #edb/ref 17592186260985 13194139533864 true] [17592186260984 1089 "q-66864" 13194139533864 true] [17592186260984 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260984 1100 "Find the value of $x$ that satisfies the equation ${9}^{x-5}={3}^{x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260984 1113 #uuid "a0166c2e-fa1a-5455-a7a2-c570d25330ae" 13194139533864 true] [17592186260984 1145 "To solve this equation, we need both exponential terms to have a common base.\n\nTo do this, we write $9$ as ${3}^{2},$ and then rewrite the left-hand side using the power rule of exponents:\n\n$$\n\\begin{aligned}{9}^{x-5} & ={3}^{x} \\\\ {({3}^{2})}^{x-5} & ={3}^{x} \\\\ {3}^{2(x-5)} & ={3}^{x}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $x:$\n\n$$\n\\begin{aligned}2(x-5) & =x \\\\ 2x-10 & =x \\\\ x & =10\\end{aligned}\n$$" 13194139533864 true] [17592186260985 1000 #edb/ref 17592186260986 13194139533864 true] [17592186260985 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260985 1041 "answer" 13194139533864 true] [17592186260985 1104 #edb/ref 17592186260986 13194139533864 true] [17592186260985 1110 #uuid "c3e9ccd4-c33e-56dc-9e3d-865956871ef6" 13194139533864 true] [17592186260986 1034 "10" 13194139533864 true] [17592186260986 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260986 1111 #uuid "089bec96-9182-5888-ac4f-ff6b790f83ca" 13194139533864 true] [17592186260987 1017 #edb/ref 17592186260988 13194139533864 true] [17592186260987 1089 "q-66874" 13194139533864 true] [17592186260987 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260987 1100 "${\\text{i}}^{-3}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260987 1113 #uuid "576be5ad-8307-5956-9086-af2a05212a49" 13194139533864 true] [17592186260987 1145 "First, using the laws of exponents, we can write\n\n$$\n{\\text{i}}^{-3}=\\frac{1}{{\\text{i}}^{3}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{{\\text{i}}^{3}}=\\frac{1}{{\\text{i}}^{3}}\\cdot \\frac{\\text{i}}{\\text{i}}=\\frac{\\text{i}}{{\\text{i}}^{4}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{4}=1.$ Therefore,\n\n$$\n\\frac{\\text{i}}{{\\text{i}}^{4}}=\\frac{\\text{i}}{1}=\\text{i}.\n$$" 13194139533864 true] [17592186260988 1000 #edb/ref 17592186260989 13194139533864 true] [17592186260988 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260988 1041 "answer" 13194139533864 true] [17592186260988 1104 #edb/ref 17592186260989 13194139533864 true] [17592186260988 1110 #uuid "21024aa7-8209-5db8-b265-c658bc298b37" 13194139533864 true] [17592186260989 1034 "\\text{i}" 13194139533864 true] [17592186260989 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260989 1111 #uuid "9372d3e7-ae97-5646-baa7-7ac94268ee26" 13194139533864 true] [17592186260990 1017 #edb/ref 17592186260991 13194139533864 true] [17592186260990 1089 "q-66880" 13194139533864 true] [17592186260990 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260990 1100 "${log}_{25}(\\sqrt{125})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260990 1113 #uuid "bf175bf7-41d9-5d9c-9ca1-8254b6c5a5b0" 13194139533864 true] [17592186260990 1145 "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=25$ and $X=\\sqrt{125}.$ Since both $a$ and $X$ can be presented as a power of $5,$ we set $b=5.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{25}(\\sqrt{125}) & =\\frac{{log}_{5}(\\sqrt{125})}{{log}_{5}(25)} \\\\  & =\\frac{{log}_{5}(\\sqrt{{5}^{3}})}{{log}_{5}({5}^{2})} \\\\  & =\\frac{{log}_{5}({5}^{3/2})}{{log}_{5}({5}^{2})} \\\\  & =\\frac{(\\frac{3}{2})}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$" 13194139533864 true] [17592186260991 1000 #edb/ref 17592186260992 13194139533864 true] [17592186260991 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260991 1041 "answer" 13194139533864 true] [17592186260991 1104 #edb/ref 17592186260992 13194139533864 true] [17592186260991 1110 #uuid "c060282b-a228-5149-88ee-93425f941ef2" 13194139533864 true] [17592186260992 1034 "\\frac{3}{4}" 13194139533864 true] [17592186260992 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260992 1111 #uuid "b03a8b08-8e7b-5cd4-a133-f21c8ad23ce8" 13194139533864 true] [17592186260993 1017 #edb/ref 17592186260994 13194139533864 true] [17592186260993 1089 "q-66887" 13194139533864 true] [17592186260993 1091 #edb/ref 17592186045464 13194139533864 true] [17592186260993 1100 "${log}_{9}(\\sqrt{27})=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186260993 1113 #uuid "47a63a18-20ff-5e2a-89aa-c14176c04a06" 13194139533864 true] [17592186260993 1145 "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=9$ and $X=\\sqrt{27}.$ Since both $a$ and $X$ can be presented as a power of $3,$ we set $b=3.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{9}(\\sqrt{27}) & =\\frac{{log}_{3}(\\sqrt{27})}{{log}_{3}(9)} \\\\  & =\\frac{{log}_{3}(\\sqrt{{3}^{3}})}{{log}_{3}({3}^{2})} \\\\  & =\\frac{{log}_{3}({3}^{3/2})}{{log}_{3}({3}^{2})} \\\\  & =\\frac{(\\frac{3}{2})}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$" 13194139533864 true] [17592186260994 1000 #edb/ref 17592186260995 13194139533864 true] [17592186260994 1040 #edb/ref 17592186045449 13194139533864 true] [17592186260994 1041 "answer" 13194139533864 true] [17592186260994 1104 #edb/ref 17592186260995 13194139533864 true] [17592186260994 1110 #uuid "d0e6003b-62b3-5c4a-a6fd-c807d1c3bba4" 13194139533864 true] [17592186260995 1034 "\\frac{3}{4}" 13194139533864 true] [17592186260995 1103 #edb/ref 17592186045453 13194139533864 true] [17592186260995 1111 #uuid "a37b4e09-7c5d-59e7-869c-54c3b277f653" 13194139533864 true] [17592186260996 1017 #edb/ref 17592186260997 13194139533864 true] [17592186260996 1089 "q-6690" 13194139533864 true] [17592186260996 1091 #edb/ref 17592186045463 13194139533864 true] [17592186260996 1100 "Is the function $f(x)=2{x}^{3}-2x$ even, odd, or neither?" 13194139533864 true] [17592186260996 1113 #uuid "04c5062c-5f4b-5176-9cc2-4587d770b021" 13194139533864 true] [17592186260996 1145 "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =2(-x)^{3}-2(-x) \\\\  & =-2{x}^{3}+2x.\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(2{x}^{3}-2x) \\\\  & =-2{x}^{3}+2x.\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd." 13194139533864 true] [17592186260997 1000 #edb/ref 17592186260998 13194139533864 true] [17592186260997 1000 #edb/ref 17592186260999 13194139533864 true] [17592186260997 1000 #edb/ref 17592186261000 13194139533864 true] [17592186260997 1040 #edb/ref 17592186045450 13194139533864 true] [17592186260997 1041 "selection" 13194139533864 true] [17592186260997 1104 #edb/ref 17592186260998 13194139533864 true] [17592186260997 1110 #uuid "f1cdf5a9-0267-594e-ae75-94addeb8ba71" 13194139533864 true] [17592186260998 1034 "Odd" 13194139533864 true] [17592186260998 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260998 1111 #uuid "cd64d0c3-583d-5c65-a565-ee541a6fd8d7" 13194139533864 true] [17592186260999 1034 "Neither" 13194139533864 true] [17592186260999 1103 #edb/ref 17592186045454 13194139533864 true] [17592186260999 1111 #uuid "bb107164-8082-5aaa-a7ea-d774a9761a12" 13194139533864 true] [17592186261000 1034 "Even" 13194139533864 true] [17592186261000 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261000 1111 #uuid "950d78ae-9463-5605-901d-784797ad43e3" 13194139533864 true] [17592186261001 1017 #edb/ref 17592186261002 13194139533864 true] [17592186261001 1089 "q-66901" 13194139533864 true] [17592186261001 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261001 1100 "Given that ${e}^{2h}-4=7,$ find the value of $h$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261001 1113 #uuid "c8d597e1-3a70-5551-8ca3-548ecbb3ddce" 13194139533864 true] [17592186261001 1145 "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{2h}-4 & =7 \\\\ {e}^{2h} & =11\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $h:$\n\n$$\n\\begin{aligned}{e}^{2h} & =11 \\\\ \\operatorname{ln}({e}^{2h}) & =\\operatorname{ln}(11) \\\\ 2h & =\\operatorname{ln}(11) \\\\ h & =\\frac{1}{2}\\operatorname{ln}(11)\\end{aligned}\n$$\n\nTherefore, the solution is $h=\\frac{1}{2}\\operatorname{ln}(11)$\n\nEvaluating the above expression using a calculator gives\n\n$$\nh\\approx 1.199\n$$\n\nrounded to $3$ decimal places." 13194139533864 true] [17592186261002 1000 #edb/ref 17592186261003 13194139533864 true] [17592186261002 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261002 1041 "answer" 13194139533864 true] [17592186261002 1104 #edb/ref 17592186261003 13194139533864 true] [17592186261002 1110 #uuid "06df9466-5754-5c36-a3e3-d7675a140094" 13194139533864 true] [17592186261003 1034 "3" 13194139533864 true] [17592186261003 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261003 1111 #uuid "119305f0-b1fe-5b2f-8e3b-0d6015572b29" 13194139533864 true] [17592186261004 1017 #edb/ref 17592186261005 13194139533864 true] [17592186261004 1089 "q-66904" 13194139533864 true] [17592186261004 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261004 1100 "Given that ${e}^{-7p}+3=8,$ find the value of $p$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261004 1113 #uuid "6e5cb6a2-7bc8-5f55-bf93-6f94f39a879f" 13194139533864 true] [17592186261004 1145 "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{-7p}+3 & =8 \\\\ {e}^{-7p} & =5\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $p:$\n\n$$\n\\begin{aligned}{e}^{-7p} & =5 \\\\ \\operatorname{ln}({e}^{-7p}) & =\\operatorname{ln}(5) \\\\ -7p & =\\operatorname{ln}(5) \\\\ p & =-\\frac{1}{7}\\operatorname{ln}(5)\\end{aligned}\n$$\n\nTherefore, the solution is $p=-\\frac{1}{7}\\operatorname{ln}(5)$\n\nEvaluating the above expression using a calculator gives\n\n$$\np\\approx -0.230\n$$\n\nrounded to $3$ decimal places." 13194139533864 true] [17592186261005 1000 #edb/ref 17592186261006 13194139533864 true] [17592186261005 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261005 1041 "answer" 13194139533864 true] [17592186261005 1104 #edb/ref 17592186261006 13194139533864 true] [17592186261005 1110 #uuid "4a59462f-4f5b-570c-b652-5baadec3debc" 13194139533864 true] [17592186261006 1034 "3" 13194139533864 true] [17592186261006 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261006 1111 #uuid "8cc96152-4ed2-5310-8597-d190b5027215" 13194139533864 true] [17592186261007 1017 #edb/ref 17592186261008 13194139533864 true] [17592186261007 1089 "q-66934" 13194139533864 true] [17592186261007 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261007 1100 "Use a calculator to evaluate ${log}_{8}(35)$ rounded to $2$ decimal places.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261007 1113 #uuid "1e980299-bf4e-5e95-b34b-d63085c5feea" 13194139533864 true] [17592186261007 1145 "Let's calculate ${log}_{8}(35)$ by changing the base $8$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=8,$ $X=35,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{8}(35) & =\\frac{{log}_{10}(35)}{{log}_{10}(8)} \\\\  & =\\frac{\\operatorname{log}(35)}{\\operatorname{log}(8)} \\\\  & \\approx \\frac{1.544\\,07}{0.903\\,09} \\\\  & \\approx 1.71\\end{aligned}\n$$" 13194139533864 true] [17592186261008 1000 #edb/ref 17592186261009 13194139533864 true] [17592186261008 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261008 1041 "answer" 13194139533864 true] [17592186261008 1104 #edb/ref 17592186261009 13194139533864 true] [17592186261008 1110 #uuid "49f59870-2611-597e-8a30-5301563263a2" 13194139533864 true] [17592186261009 1034 "1.71" 13194139533864 true] [17592186261009 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261009 1111 #uuid "fa06c276-2514-578f-8d2c-d26527f7e6c5" 13194139533864 true] [17592186261010 1017 #edb/ref 17592186261011 13194139533864 true] [17592186261010 1089 "q-66963" 13194139533864 true] [17592186261010 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261010 1100 "What is the value of $x$ if ${e}^{2x+3}=\\sqrt[5]{7}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261010 1113 #uuid "a4fcecca-42f0-5b23-b6e5-a78929f1c209" 13194139533864 true] [17592186261010 1145 "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{2x+3} & =\\sqrt[5]{7} \\\\ \\operatorname{ln}({e}^{2x+3}) & =\\operatorname{ln}(\\sqrt[5]{7})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n2x+3=\\operatorname{ln}(\\sqrt[5]{7})\n$$\n\nNext, we write $\\sqrt[5]{7}$ as ${7}^{1/5}.$ So, we get:\n\n$$\n2x+3=\\operatorname{ln}({7}^{1/5})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}2x+3 & =\\operatorname{ln}({7}^{1/5}) \\\\ 2x+3 & =\\frac{1}{5}\\operatorname{ln}(7) \\\\ 2x & =\\frac{1}{5}\\operatorname{ln}(7)-3 \\\\ x & =\\frac{1}{2}(\\frac{1}{5}\\operatorname{ln}(7)-3) \\\\ x & =\\frac{1}{10}\\operatorname{ln}7-\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{10}\\operatorname{ln}7-\\frac{3}{2}.$" 13194139533864 true] [17592186261011 1000 #edb/ref 17592186261012 13194139533864 true] [17592186261011 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261011 1041 "answer" 13194139533864 true] [17592186261011 1104 #edb/ref 17592186261012 13194139533864 true] [17592186261011 1110 #uuid "61dd824c-1395-5163-a6e9-bb2bbece39d8" 13194139533864 true] [17592186261012 1034 "\\frac{1}{10}\\operatorname{ln}7-\\frac{3}{2}" 13194139533864 true] [17592186261012 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261012 1111 #uuid "547d5c88-680a-58d0-88fd-be47bbc9dd96" 13194139533864 true] [17592186261013 1017 #edb/ref 17592186261014 13194139533864 true] [17592186261013 1089 "q-67043" 13194139533864 true] [17592186261013 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261013 1100 "The following arithmetic series has $13$ terms in total. Find the sum of the series.\n\n$$\n-9+(-11)+(-13)+(-15)+⋯+(-33)\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261013 1113 #uuid "1b0d02cf-7e0a-5619-ba74-9c01c7f880f0" 13194139533864 true] [17592186261013 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nFor our series, we have ${a}_{1}=-9,{a}_{N}=-33$ and $N=13.$ Substituting these values into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{13} & =\\frac{13}{2}(-9+(-33)) \\\\  & =\\frac{13}{2}(-42) \\\\  & =13(-21) \\\\  & =-273\\end{aligned}\n$$" 13194139533864 true] [17592186261014 1000 #edb/ref 17592186261015 13194139533864 true] [17592186261014 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261014 1041 "answer" 13194139533864 true] [17592186261014 1104 #edb/ref 17592186261015 13194139533864 true] [17592186261014 1110 #uuid "878d60a5-6709-5ede-b238-4483f961cae3" 13194139533864 true] [17592186261015 1034 "-273" 13194139533864 true] [17592186261015 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261015 1111 #uuid "45bf49dd-7841-5382-a86f-093a0a3c4e69" 13194139533864 true] [17592186261016 1017 #edb/ref 17592186261017 13194139533864 true] [17592186261016 1089 "q-67047" 13194139533864 true] [17592186261016 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261016 1100 "The following arithmetic series has $15$ terms in total. Find the sum of the series.\n\n$$\n-6+(-2)+2+6+⋯+50\n$$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261016 1113 #uuid "4fced0be-707f-5fb0-9e9e-ae88a44c183d" 13194139533864 true] [17592186261016 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nFor our series, we have ${a}_{1}=-6,{a}_{N}=50$ and $N=15.$ Substituting these values into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{15} & =\\frac{15}{2}(-6+50) \\\\  & =\\frac{15}{2}\\cdot 44 \\\\  & =15\\cdot 22 \\\\  & =330\\end{aligned}\n$$" 13194139533864 true] [17592186261017 1000 #edb/ref 17592186261018 13194139533864 true] [17592186261017 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261017 1041 "answer" 13194139533864 true] [17592186261017 1104 #edb/ref 17592186261018 13194139533864 true] [17592186261017 1110 #uuid "67ab2d8d-687a-57cc-bd4e-e89fb5e0950a" 13194139533864 true] [17592186261018 1034 "330" 13194139533864 true] [17592186261018 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261018 1111 #uuid "4eddb648-ec6d-570d-9987-b5a58e4f4ce2" 13194139533864 true] [17592186261019 1017 #edb/ref 17592186261020 13194139533864 true] [17592186261019 1089 "q-67158" 13194139533864 true] [17592186261019 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261019 1100 "Give an expression equivalent to ${log}_{81}x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261019 1113 #uuid "a8865266-a05d-5ca3-b448-4ff1c8f96fa4" 13194139533864 true] [17592186261019 1145 "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nWe want to change from base $a=81$ to base $b=3.$ So, we have\n\n$$\n\\begin{aligned}{log}_{81}x & =\\frac{{log}_{3}x}{{log}_{3}(81)}.\\end{aligned}\n$$\n\nRewriting the expression in the denominator using exponents, we get\n\n$$\n\\begin{aligned}\\frac{{log}_{3}x}{{log}_{3}(81)} & =\\frac{{log}_{3}x}{{log}_{3}({3}^{4})} \\\\  & =\\frac{{log}_{3}x}{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{log}_{81}x=\\frac{{log}_{3}x}{4}=\\frac{1}{4}{log}_{3}x.\n$$" 13194139533864 true] [17592186261020 1000 #edb/ref 17592186261021 13194139533864 true] [17592186261020 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261020 1041 "answer" 13194139533864 true] [17592186261020 1104 #edb/ref 17592186261021 13194139533864 true] [17592186261020 1110 #uuid "ec665f11-4ef7-53b9-87bb-a43387bde5a7" 13194139533864 true] [17592186261021 1034 "\\frac{1}{4}{log}_{3}x" 13194139533864 true] [17592186261021 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261021 1111 #uuid "61b7b539-5b9e-5c98-b5c1-1ecbb853e83f" 13194139533864 true] [17592186261022 1017 #edb/ref 17592186261023 13194139533864 true] [17592186261022 1089 "q-67160" 13194139533864 true] [17592186261022 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261022 1100 "An arithmetic series has the first term ${a}_{1}=2$, the $6$th term ${a}_{6}=22$, and the sum of the series is ${S}_{N}=288.$ Find the number of terms $N$ in the series.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261022 1113 #uuid "dedda1be-748d-5578-a854-6406afc3ca44" 13194139533864 true] [17592186261022 1145 "To solve this problem, we use the formula for the sum of an arithmetic series.\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d)\n$$\n\nSince we know two terms of the arithmetic series, we can find its common difference, as follows:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{6}-{a}_{1}}{6-1} \\\\  & =\\frac{22-2}{5} \\\\  & =\\frac{20}{5} \\\\  & =4\\end{aligned}\n$$\n\nNow, substituting ${a}_{1}=2$, $d=4$, and ${S}_{N}=288$ into the formula for the sum of an arithmetic series, we have: \n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 288 & =\\frac{N}{2}(2\\cdot 2+(N-1)\\cdot 4) \\\\ 288 & =\\frac{N}{2}(4+4N-4) \\\\ 288 & =\\frac{N}{2}(4N) \\\\ 288 & =2{N}^{2} \\\\ 144 & ={N}^{2} \\\\ N & =12\\end{aligned}\n$$\n\nNotice that we take the positive square root because $N$ can't be negative." 13194139533864 true] [17592186261023 1000 #edb/ref 17592186261024 13194139533864 true] [17592186261023 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261023 1041 "answer" 13194139533864 true] [17592186261023 1104 #edb/ref 17592186261024 13194139533864 true] [17592186261023 1110 #uuid "6f33194a-533e-5d5f-aeea-98fb2111edad" 13194139533864 true] [17592186261024 1034 "12" 13194139533864 true] [17592186261024 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261024 1111 #uuid "e4d4730e-784d-5184-9134-019f0cdedc08" 13194139533864 true] [17592186261025 1017 #edb/ref 17592186261026 13194139533864 true] [17592186261025 1089 "q-67177" 13194139533864 true] [17592186261025 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261025 1100 "An arithmetic series has ${a}_{1}=1$ and ${a}_{5}=3,$ where ${a}_{1}$ and ${a}_{5}$ are the first and fifth terms of the series, respectively. What is the sum of the first $13$ terms of the series?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261025 1113 #uuid "6a41ce80-b8e8-5930-a1cd-1406aa9952fe" 13194139533864 true] [17592186261025 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nWe know that ${a}_{5}=3.$ So, using the formula for the $n$th term of an arithmetic sequence, we have:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{5} & ={a}_{1}+(5-1)d \\\\ 3 & =1+4d \\\\ 4d & =2 \\\\ d & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow, substituting ${a}_{1}=1$, $d=\\frac{1}{2}$, and $N=13$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{13} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{13}{2}(2\\cdot 1+(13-1)\\cdot \\frac{1}{2}) \\\\  & =\\frac{13}{2}\\cdot (2+6) \\\\  & =\\frac{13}{2}\\cdot 8 \\\\  & =13\\cdot 4 \\\\  & =52\\end{aligned}\n$$" 13194139533864 true] [17592186261026 1000 #edb/ref 17592186261027 13194139533864 true] [17592186261026 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261026 1041 "answer" 13194139533864 true] [17592186261026 1104 #edb/ref 17592186261027 13194139533864 true] [17592186261026 1110 #uuid "a9f1ca61-45bb-5af2-b0d1-664076cee0bb" 13194139533864 true] [17592186261027 1034 "52" 13194139533864 true] [17592186261027 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261027 1111 #uuid "ceaf749a-0891-5b69-b7ba-0e8416117672" 13194139533864 true] [17592186261028 1017 #edb/ref 17592186261029 13194139533864 true] [17592186261028 1089 "q-67183" 13194139533864 true] [17592186261028 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261028 1100 "An arithmetic series has ${a}_{4}=-11$ and ${a}_{11}=-39,$ where ${a}_{4}$ and ${a}_{11}$ are the fourth and eleventh terms of the series, respectively. \nFind the sum of the first $15$ terms of the series.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261028 1113 #uuid "32b30204-fdd2-5361-b71f-01c0c6f85c10" 13194139533864 true] [17592186261028 1145 "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSince we know two terms of the arithmetic series, we can find its common difference, as follows:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{11}-{a}_{4}}{11-4} \\\\  & =\\frac{-39-(-11)}{11-4} \\\\  & =\\frac{-28}{7} \\\\  & =-4\\end{aligned}\n$$\n\nNow, as ${a}_{4}=-11$, using the formula for the $n$th term, we can compute ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{4} & ={a}_{1}+(4-1)\\cdot (-4) \\\\ -11 & ={a}_{1}+(-12) \\\\ {a}_{1} & =1\\end{aligned}\n$$\n\nSubstituting ${a}_{1}=1$, $d=-4$, and $N=15$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{15} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{15}{2}(2\\cdot 1+(15-1)\\cdot (-4)) \\\\  & =\\frac{15}{2}\\cdot (2-56) \\\\  & =\\frac{15}{2}\\cdot (-54) \\\\  & =15\\cdot (-27) \\\\  & =-405\\end{aligned}\n$$" 13194139533864 true] [17592186261029 1000 #edb/ref 17592186261030 13194139533864 true] [17592186261029 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261029 1041 "answer" 13194139533864 true] [17592186261029 1104 #edb/ref 17592186261030 13194139533864 true] [17592186261029 1110 #uuid "ec0376b2-78bc-5aa1-867c-d5690b732c26" 13194139533864 true] [17592186261030 1034 "-405" 13194139533864 true] [17592186261030 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261030 1111 #uuid "ae38c78a-c742-5fee-b66d-6fd8a1173707" 13194139533864 true] [17592186261031 1017 #edb/ref 17592186261032 13194139533864 true] [17592186261031 1089 "q-67217" 13194139533864 true] [17592186261031 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261031 1100 "Evaluate the geometric series ${\\sum }_{n=0}^{\\infty }{(\\frac{3}{4})}^{n+1}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261031 1113 #uuid "d7f6ddd3-7a07-53be-a65c-aca333beb0f5" 13194139533864 true] [17592186261031 1145 "First, note that the index $n$ starts from $0,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{0}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{0}={(\\frac{3}{4})}^{0+1}=\\frac{3}{4}\n$$\n\n \n\n$$\n{a}_{1}={(\\frac{3}{4})}^{1+1}={(\\frac{3}{4})}^{2}\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{1}}{{a}_{0}}=\\frac{{(\\frac{3}{4})}^{2}}{\\frac{3}{4}}=\\frac{3}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=0}^{\\infty }{(\\frac{3}{4})}^{n+1} & =\\frac{{a}_{0}}{1-r} \\\\  & =\\frac{(\\frac{3}{4})}{1-\\frac{3}{4}} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{1}{4})} \\\\  & =\\frac{3}{4}\\cdot \\frac{4}{1} \\\\  & =3.\\end{aligned}\n$$" 13194139533864 true] [17592186261032 1000 #edb/ref 17592186261033 13194139533864 true] [17592186261032 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261032 1041 "answer" 13194139533864 true] [17592186261032 1104 #edb/ref 17592186261033 13194139533864 true] [17592186261032 1110 #uuid "d11d1acd-f605-5019-b2ec-43e4dae29f74" 13194139533864 true] [17592186261033 1034 "3" 13194139533864 true] [17592186261033 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261033 1111 #uuid "847298b9-a2bc-5e6e-95ca-5505365402af" 13194139533864 true] [17592186261034 1017 #edb/ref 17592186261035 13194139533864 true] [17592186261034 1089 "q-67275" 13194139533864 true] [17592186261034 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261034 1100 "Consider the positive infinite geometric sequence that has a first term equal to $100$ and a third term equal to $4.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261034 1113 #uuid "cd3f6efc-8ad1-5ea4-8f11-4ecf2a1e15c9" 13194139533864 true] [17592186261034 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=100$ and ${a}_{3}=4.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{3-1} & =\\frac{4}{100} \\\\ {r}^{2} & =\\frac{1}{25} \\\\ r & =\\sqrt{\\frac{1}{25}} \\\\ r & =\\frac{1}{5}\\end{aligned}\n$$\n\nNote that we have taken the positive square root since we're told that the sequence is positive.\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{100}{(1-\\frac{1}{5})} \\\\  & =\\frac{100}{(\\frac{4}{5})} \\\\  & =100\\cdot \\frac{5}{4} \\\\  & =125.\\end{aligned}\n$$" 13194139533864 true] [17592186261035 1000 #edb/ref 17592186261036 13194139533864 true] [17592186261035 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261035 1041 "answer" 13194139533864 true] [17592186261035 1104 #edb/ref 17592186261036 13194139533864 true] [17592186261035 1110 #uuid "7a617679-97a1-5278-90f7-755630e05862" 13194139533864 true] [17592186261036 1034 "125" 13194139533864 true] [17592186261036 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261036 1111 #uuid "2ba2240c-2cbb-5aaf-b814-9c23b8e87e9b" 13194139533864 true] [17592186261037 1017 #edb/ref 17592186261038 13194139533864 true] [17592186261037 1089 "q-67277" 13194139533864 true] [17592186261037 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261037 1100 "Consider the infinite geometric sequence that has a first term equal to $36$ and a fourth term equal to $\\frac{4}{3}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261037 1113 #uuid "3c4f183b-d69c-5863-8872-aaadbc068516" 13194139533864 true] [17592186261037 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=36$ and ${a}_{4}=\\frac{4}{3}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{4}{3})}{36} \\\\ {r}^{3} & =\\frac{1}{27} \\\\ {r}^{3} & ={(\\frac{1}{3})}^{3} \\\\ r & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{36}{(1-\\frac{1}{3})} \\\\  & =\\frac{36}{(\\frac{2}{3})} \\\\  & =54.\\end{aligned}\n$$" 13194139533864 true] [17592186261038 1000 #edb/ref 17592186261039 13194139533864 true] [17592186261038 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261038 1041 "answer" 13194139533864 true] [17592186261038 1104 #edb/ref 17592186261039 13194139533864 true] [17592186261038 1110 #uuid "12a24b21-1e39-5e3a-b35e-388b6c84b984" 13194139533864 true] [17592186261039 1034 "54" 13194139533864 true] [17592186261039 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261039 1111 #uuid "ccff46d8-51f2-52c3-9d44-6f826b2af348" 13194139533864 true] [17592186261040 1017 #edb/ref 17592186261041 13194139533864 true] [17592186261040 1089 "q-67278" 13194139533864 true] [17592186261040 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261040 1100 "Consider the infinite geometric sequence that has a first term equal to $48$ and a fourth term equal to $\\frac{3}{4}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261040 1113 #uuid "bd4b8c3e-dfee-5ef6-85a6-3f80440979fd" 13194139533864 true] [17592186261040 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=48$ and ${a}_{4}=\\frac{3}{4}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{3}{4})}{48} \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{48}{(1-\\frac{1}{4})} \\\\  & =\\frac{48}{(\\frac{3}{4})} \\\\  & =48\\cdot \\frac{4}{3} \\\\  & =64.\\end{aligned}\n$$" 13194139533864 true] [17592186261041 1000 #edb/ref 17592186261042 13194139533864 true] [17592186261041 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261041 1041 "answer" 13194139533864 true] [17592186261041 1104 #edb/ref 17592186261042 13194139533864 true] [17592186261041 1110 #uuid "2615b029-78a2-5f37-bd7f-39a215cd4284" 13194139533864 true] [17592186261042 1034 "64" 13194139533864 true] [17592186261042 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261042 1111 #uuid "35f1fe2b-5643-5b0a-907c-3906ef26c821" 13194139533864 true] [17592186261043 1017 #edb/ref 17592186261044 13194139533864 true] [17592186261043 1089 "q-67279" 13194139533864 true] [17592186261043 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261043 1100 "Consider the infinite geometric sequence that has a first term equal to $35$ and a fourth term equal to $-\\frac{56}{25}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261043 1113 #uuid "2b352d28-1238-5c21-917e-ac85575e41a6" 13194139533864 true] [17592186261043 1145 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=35$ and ${a}_{4}=-\\frac{56}{25}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(-\\frac{56}{25})}{35} \\\\ {r}^{3} & =-\\frac{8}{125} \\\\ {r}^{3} & ={(-\\frac{2}{5})}^{3} \\\\ r & =-\\frac{2}{5}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{35}{(1-(-\\frac{2}{5}))} \\\\  & =\\frac{35}{(1+\\frac{2}{5})} \\\\  & =\\frac{35}{(\\frac{7}{5})} \\\\  & =35\\cdot \\frac{5}{7} \\\\  & =25.\\end{aligned}\n$$" 13194139533864 true] [17592186261044 1000 #edb/ref 17592186261045 13194139533864 true] [17592186261044 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261044 1041 "answer" 13194139533864 true] [17592186261044 1104 #edb/ref 17592186261045 13194139533864 true] [17592186261044 1110 #uuid "d86636ef-8a10-5440-9ad0-7bc6b121987b" 13194139533864 true] [17592186261045 1034 "25" 13194139533864 true] [17592186261045 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261045 1111 #uuid "0ec14a23-1c72-554b-953c-a75bf3129a46" 13194139533864 true] [17592186261046 1017 #edb/ref 17592186261047 13194139533864 true] [17592186261046 1089 "q-67281" 13194139533864 true] [17592186261046 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261046 1100 "An arithmetic series has ${a}_{1}=10$ and ${a}_{6}=-5,$ where ${a}_{1}$ and ${a}_{6}$ are the first and sixth terms of the series, respectively. What is the sum of the first ten terms of the series, expressed using sigma notation?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261046 1113 #uuid "37dec902-223c-5579-835f-ac0779fdd1ed" 13194139533864 true] [17592186261046 1145 "We know that ${a}_{6}=-5.$ So, using the formula for the $n$th term of an arithmetic sequence, we have:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ -5 & =10+(6-1)d \\\\ -5 & =10+5d \\\\ 5d & =-15 \\\\ d & =-3\\end{aligned}\n$$\n\nTherefore, ${a}_{1}=10$ and $d=-3.$ Thus, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =10+(n-1)(-3) \\\\  & =10-3n+3 \\\\  & =-3n+13\\end{aligned}\n$$\n\nFinally then, the sum of the first ten terms can be written as:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{10}(-3n+13)\\end{aligned}\n$$" 13194139533864 true] [17592186261047 1000 #edb/ref 17592186261048 13194139533864 true] [17592186261047 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261047 1041 "answer" 13194139533864 true] [17592186261047 1104 #edb/ref 17592186261048 13194139533864 true] [17592186261047 1110 #uuid "a97607db-c43b-584f-8802-45c2e2e2bd33" 13194139533864 true] [17592186261048 1034 "{\\sum }_{n=1}^{10}(-3n+13)" 13194139533864 true] [17592186261048 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261048 1111 #uuid "d729dfb7-37c2-5721-b7da-0dc8d6f93eb9" 13194139533864 true] [17592186261049 1017 #edb/ref 17592186261050 13194139533864 true] [17592186261049 1089 "q-67304" 13194139533864 true] [17592186261049 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261049 1100 "Evaluate the series ${\\sum }_{n=2}^{\\infty }{(\\frac{2}{5})}^{n}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261049 1113 #uuid "8da21356-cf78-57bd-8a24-bca56a7d11af" 13194139533864 true] [17592186261049 1145 "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & ={(\\frac{2}{5})}^{2}=\\frac{4}{25} \\\\ {a}_{3} & ={(\\frac{2}{5})}^{3}=\\frac{8}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{8}{125})}{(\\frac{4}{25})}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }{(\\frac{2}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{4}{25})}{(1-\\frac{2}{5})} \\\\  & =\\frac{(\\frac{4}{25})}{(\\frac{3}{5})} \\\\  & =\\frac{4}{15}.\\end{aligned}\n$$" 13194139533864 true] [17592186261050 1000 #edb/ref 17592186261051 13194139533864 true] [17592186261050 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261050 1041 "answer" 13194139533864 true] [17592186261050 1104 #edb/ref 17592186261051 13194139533864 true] [17592186261050 1110 #uuid "892a22f9-897a-55b5-b400-54bbd725f0eb" 13194139533864 true] [17592186261051 1034 "\\frac{4}{15}" 13194139533864 true] [17592186261051 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261051 1111 #uuid "399ca58c-1a93-5aa8-a3a1-30c792e828f7" 13194139533864 true] [17592186261052 1017 #edb/ref 17592186261053 13194139533864 true] [17592186261052 1089 "q-67324" 13194139533864 true] [17592186261052 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261052 1100 "The geometric series $-2+12-72+432$ can be expressed using sigma notation as\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261052 1113 #uuid "a2cca1fe-4d6f-58e1-ae4a-bc0f765dbc4c" 13194139533864 true] [17592186261052 1145 "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=-2$ and $N=4.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{12}{-2}=-6\n$$\n\nTherefore, expressing the given geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}-2+12-72+432 & ={\\sum }_{n=1}^{4}(-2)\\cdot (-6)^{n-1}\\end{aligned}\n$$\n\nFinally, we can simplify the above using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}(-2)\\cdot (-6)^{n-1} & ={\\sum }_{n=1}^{4}(-2)\\cdot (-6)^{n}\\cdot (-6)^{-1} \\\\  & ={\\sum }_{n=1}^{4}(-2)\\cdot {(-6)}^{-1}\\cdot (-6)^{n} \\\\  & ={\\sum }_{n=1}^{4}(-2)\\cdot (-\\frac{1}{6})(-6)^{n} \\\\  & ={\\sum }_{n=1}^{4}\\frac{1}{3}\\cdot (-6)^{n}\\end{aligned}\n$$" 13194139533864 true] [17592186261053 1000 #edb/ref 17592186261054 13194139533864 true] [17592186261053 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261053 1041 "answer" 13194139533864 true] [17592186261053 1104 #edb/ref 17592186261054 13194139533864 true] [17592186261053 1110 #uuid "330a5f64-318d-5fec-87c8-1b28e2989524" 13194139533864 true] [17592186261054 1034 "{\\sum }_{n=1}^{4}\\frac{1}{3}\\cdot (-6)^{n}" 13194139533864 true] [17592186261054 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261054 1111 #uuid "5d17aa3c-2d49-5537-99b1-465928ad76af" 13194139533864 true] [17592186261055 1017 #edb/ref 17592186261056 13194139533864 true] [17592186261055 1089 "q-67348" 13194139533864 true] [17592186261055 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261055 1100 "Given an arithmetic sequence that has ${a}_{4}=13$ and ${a}_{8}=41,$ what is the index of the term $90?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261055 1113 #uuid "9ea5035a-bbb0-5b32-9e84-2a69e6c2ebe9" 13194139533864 true] [17592186261055 1145 "To construct the formula for the sequence, we need to know the common difference $d$ and the first term ${a}_{1}.$\n\nSince we are given ${a}_{4}=13$ and ${a}_{8}=41,$ we can find the common difference by dividing the total difference by the number of jumps:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{8}-{a}_{4}}{8-4} \\\\  & =\\frac{41-13}{8-4} \\\\  & =\\frac{28}{4} \\\\  & =7\\end{aligned}\n$$\n\nNow, since ${a}_{4}=13$ is $3$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}+3d \\\\ 13 & ={a}_{1}+3(7) \\\\ 13 & ={a}_{1}+21 \\\\ -8 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-8+(n-1)(7) \\\\  & =-8+7n-7 \\\\  & =7n-15\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives ${a}_{n}=90,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =7n-15 \\\\ 90 & =7n-15 \\\\ 105 & =7n \\\\ \\frac{105}{7} & =n \\\\ 15 & =n\\end{aligned}\n$$\n\nTherefore, $90$ is the $15$th term of the sequence." 13194139533864 true] [17592186261056 1000 #edb/ref 17592186261057 13194139533864 true] [17592186261056 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261056 1041 "answer" 13194139533864 true] [17592186261056 1104 #edb/ref 17592186261057 13194139533864 true] [17592186261056 1110 #uuid "245df91c-45b7-5cee-88ee-1e72010dc86c" 13194139533864 true] [17592186261057 1034 "15" 13194139533864 true] [17592186261057 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261057 1111 #uuid "de80f496-7a51-5689-ba57-9b7b068772a3" 13194139533864 true] [17592186261058 1017 #edb/ref 17592186261059 13194139533864 true] [17592186261058 1089 "q-67377" 13194139533864 true] [17592186261058 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261058 1100 "The first term of a geometric sequence is $-5$ and the common ratio is $6.$ Written in sigma notation, what is the sum of the first $22$ terms?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261058 1113 #uuid "02a78a86-1025-5579-a281-d9673722caa0" 13194139533864 true] [17592186261058 1145 "First, we must express the series in the form:\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=-5,$ $r=6$ and $N=22.$\n\nExpressing the geometric series in sigma notation, we obtain:\n\n$$\n{S}_{22}={\\sum }_{n=1}^{22}(-5)\\cdot {6}^{n-1}\\,\\,\n$$\n\nFinally, we can simplify the above using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{22}(-5)\\cdot {6}^{n-1} & ={\\sum }_{n=1}^{22}(-5)\\cdot {6}^{n}\\cdot {6}^{-1} \\\\  & ={\\sum }_{n=1}^{22}(-5)\\cdot {6}^{-1}\\cdot {6}^{n} \\\\  & ={\\sum }_{n=1}^{22}(-5)\\cdot \\frac{1}{6}\\cdot {6}^{n} \\\\  & ={\\sum }_{n=1}^{22}(-\\frac{5}{6}){6}^{n}\\end{aligned}\n$$" 13194139533864 true] [17592186261059 1000 #edb/ref 17592186261060 13194139533864 true] [17592186261059 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261059 1041 "answer" 13194139533864 true] [17592186261059 1104 #edb/ref 17592186261060 13194139533864 true] [17592186261059 1110 #uuid "3a1bccbf-536d-5d16-b079-a27057fb73fe" 13194139533864 true] [17592186261060 1034 "{\\sum }_{n=1}^{22}(-\\frac{5}{6}){6}^{n}" 13194139533864 true] [17592186261060 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261060 1111 #uuid "f251cd0d-defd-5842-9f71-c73f345f8fbc" 13194139533864 true] [17592186261061 1017 #edb/ref 17592186261062 13194139533864 true] [17592186261061 1089 "q-67439" 13194139533864 true] [17592186261061 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261061 1100 "Solve the equation $-\\frac{2}{x+3}=\\frac{8}{x-1}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261061 1113 #uuid "d177fcdc-42ce-5f5f-82c6-0abf2f8ef727" 13194139533864 true] [17592186261061 1145 "First, we note that\n\n- $x=-3$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x+3}{2}=\\frac{x-1}{8}\n$$\n\nNext, we write both fractions using the least common denominator, $8.$ The equation becomes\n\n$$\n-\\frac{4x+12}{8}=\\frac{x-1}{8}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-8)\\cdot \\frac{4x+12}{-8} & =(-8)\\cdot \\frac{x-1}{8} \\\\ 4x+12 & =-x+1 \\\\ 4x+x & =1-12 \\\\ 5x & =-11 \\\\ (\\frac{1}{5})\\cdot (5x) & =(\\frac{1}{5})\\cdot (-11) \\\\ (\\cancel{\\frac{1}{5}})\\cdot (\\cancel{5}x) & =(\\frac{1}{5})\\cdot (-11) \\\\ x & =-\\frac{11}{5}\\end{aligned}\n$$" 13194139533864 true] [17592186261062 1000 #edb/ref 17592186261063 13194139533864 true] [17592186261062 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261062 1041 "answer" 13194139533864 true] [17592186261062 1104 #edb/ref 17592186261063 13194139533864 true] [17592186261062 1110 #uuid "bace9fc5-2f38-5ab3-b01e-2f59a7d5e614" 13194139533864 true] [17592186261063 1034 "-\\frac{11}{5}" 13194139533864 true] [17592186261063 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261063 1111 #uuid "34c48104-4fe1-5365-a916-797f9ea4ad0a" 13194139533864 true] [17592186261064 1017 #edb/ref 17592186261065 13194139533864 true] [17592186261064 1089 "q-67580" 13194139533864 true] [17592186261064 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261064 1100 "Given that $p(x)=\\frac{8}{{x}^{5}}$ and $q(x)=-\\frac{2}{3{x}^{3}}$, what is ${lim}_{x\\to -\\infty }\\frac{{x}^{2}\\cdot p(x)}{q(x)}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261064 1113 #uuid "818d4509-0f7c-512b-8135-c5e0fbca7d0f" 13194139533864 true] [17592186261064 1145 "First, let's calculate ${x}^{2}\\cdot p(x):$\n\n$$\n{x}^{2}\\cdot p(x)={x}^{2}\\cdot (\\frac{8}{{x}^{5}})=\\frac{8}{{x}^{3}}.\n$$\n\nWhen we divide the two functions ${x}^{2}\\cdot p(x)$ and $q(x)$, we get a constant, and the limit of a constant is just the constant itself:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{2}\\cdot p(x)}{q(x)} & ={lim}_{x\\to -\\infty }\\frac{(\\frac{8}{{x}^{3}})}{(-\\frac{2}{3{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{8}{(-\\frac{2}{3})} \\\\  & ={lim}_{x\\to -\\infty }(-\\frac{3}{2})\\cdot (8) \\\\  & ={lim}_{x\\to -\\infty }-12 \\\\  & =-12\\end{aligned}\n$$" 13194139533864 true] [17592186261065 1000 #edb/ref 17592186261066 13194139533864 true] [17592186261065 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261065 1041 "answer" 13194139533864 true] [17592186261065 1104 #edb/ref 17592186261066 13194139533864 true] [17592186261065 1110 #uuid "a5e97405-b554-57b0-ad9e-c3f78a6c8f79" 13194139533864 true] [17592186261066 1034 "-12" 13194139533864 true] [17592186261066 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261066 1111 #uuid "57d42ae6-dec0-587f-8e65-a76bd0d3d23f" 13194139533864 true] [17592186261067 1017 #edb/ref 17592186261068 13194139533864 true] [17592186261067 1089 "q-67622" 13194139533864 true] [17592186261067 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261067 1100 "Compute ${lim}_{x\\to -2}\\frac{1}{(x+2)^{6}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261067 1113 #uuid "2cd1a104-4645-5dc7-9cad-12182ecbefe8" 13194139533864 true] [17592186261067 1145 "We can sketch the graph of $y=\\frac{1}{(x+2)^{6}}$ as follows:\n\n- Take the graph of $y=\\frac{1}{{x}^{6}}.$\n\n- Translate it to the left by $2$ units. This gives $y=\\frac{1}{(x+2)^{6}},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b5b7cefccb376e47581c1e858d8e1afaa707cfa6b87518da42a826ce58dd341c.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to (-{2}^{-})}\\frac{1}{(x+2)^{6}}=\\infty ,\\,{lim}_{x\\to (-{2}^{+})}\\frac{1}{(x+2)^{6}}=\\infty ,\n$$\n\nand therefore\n\n$$\n{lim}_{x\\to -2}\\frac{1}{(x+2)^{6}}=\\infty .\n$$" 13194139533864 true] [17592186261068 1000 #edb/ref 17592186261069 13194139533864 true] [17592186261068 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261068 1041 "answer" 13194139533864 true] [17592186261068 1104 #edb/ref 17592186261069 13194139533864 true] [17592186261068 1110 #uuid "d9296741-9b7b-5bbc-844a-ca106415b8e2" 13194139533864 true] [17592186261069 1034 "\\infty" 13194139533864 true] [17592186261069 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261069 1111 #uuid "0f92f81a-719d-5179-8f88-1966ed85ddfc" 13194139533864 true] [17592186261070 1017 #edb/ref 17592186261071 13194139533864 true] [17592186261070 1089 "q-67655" 13194139533864 true] [17592186261070 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261070 1100 "Calculate ${lim}_{x\\to 3}{log}_{3}(x-3).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261070 1113 #uuid "98ffbfe8-0125-5a08-90b5-155d6aa70b17" 13194139533864 true] [17592186261070 1145 "Let's sketch the graph of $y={log}_{3}(x-3).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/91e0a0ebd65df128534d58d181e62be18aa1c398cf526da7838d1a56e62f7d08.png)\n\nThe function is not defined for $x\\le 3.$ Therefore,\n\n$$\n{lim}_{x\\to {3}^{-}}{log}_{3}(x-3)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>3.$ Moreover,\n\n$$\n{lim}_{x\\to {3}^{+}}{log}_{3}(x-3)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to 3}{log}_{3}(x-3)=\\text{DNE}.\n$$" 13194139533864 true] [17592186261071 1000 #edb/ref 17592186261072 13194139533864 true] [17592186261071 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261071 1041 "answer" 13194139533864 true] [17592186261071 1104 #edb/ref 17592186261072 13194139533864 true] [17592186261071 1110 #uuid "5c7bb6e1-e08f-549d-af87-6506c21efb7c" 13194139533864 true] [17592186261072 1034 "\\text{DNE}" 13194139533864 true] [17592186261072 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261072 1111 #uuid "83683802-cb20-5e8b-ae38-e38d262f5b3b" 13194139533864 true] [17592186261073 1017 #edb/ref 17592186261074 13194139533864 true] [17592186261073 1089 "q-67659" 13194139533864 true] [17592186261073 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261073 1100 "${lim}_{x\\to \\infty }\\,\\sqrt{x+3}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261073 1113 #uuid "f97ea71b-2d26-565c-a5fc-bee1699ced73" 13194139533864 true] [17592186261073 1145 "Let $f(x)=\\sqrt{x+3}.$ Let's sketch the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b03d3bc42d076a63937ab41d939c6d39ceca8bdb879c9ed58d583ab8a694a979.png)\n\nFrom the graph, we see that the function increases without bound as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }f(x)=\\infty .\n$$" 13194139533864 true] [17592186261074 1000 #edb/ref 17592186261075 13194139533864 true] [17592186261074 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261074 1041 "answer" 13194139533864 true] [17592186261074 1104 #edb/ref 17592186261075 13194139533864 true] [17592186261074 1110 #uuid "239240f1-3aeb-5c74-a4ab-d43f74a21b8f" 13194139533864 true] [17592186261075 1034 "\\infty" 13194139533864 true] [17592186261075 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261075 1111 #uuid "8c912fc0-3705-5a1a-88b6-d61d7865e577" 13194139533864 true] [17592186261076 1017 #edb/ref 17592186261077 13194139533864 true] [17592186261076 1089 "q-67696" 13194139533864 true] [17592186261076 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261076 1100 "Find ${lim}_{z\\to -1}\\frac{(z-2)^{4}}{(z+2)^{3}}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261076 1113 #uuid "93e1f776-dbc1-58f3-a68d-2ac0bb33599b" 13194139533864 true] [17592186261076 1145 "Here, we apply the quotient rule and the power rule to get\n\n \n\n$$\n\\begin{aligned}{lim}_{z\\to -1}\\frac{(z-2)^{4}}{(z+2)^{3}} & =\\frac{{lim}_{z\\to -1}(z-2)^{4}}{{lim}_{z\\to -1}(z+2)^{3}} \\\\  & =\\frac{{({lim}_{z\\to -1}(z-2))}^{4}}{{({lim}_{z\\to -1}(z+2))}^{3}} \\\\  & =\\frac{(-1-2)^{4}}{(-1+2)^{3}} \\\\  & =\\frac{(-3)^{4}}{{1}^{3}} \\\\  & =\\frac{81}{1} \\\\  & =81\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186261077 1000 #edb/ref 17592186261078 13194139533864 true] [17592186261077 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261077 1041 "answer" 13194139533864 true] [17592186261077 1104 #edb/ref 17592186261078 13194139533864 true] [17592186261077 1110 #uuid "f7242dff-1d2d-5dcb-a2ec-c3039ce685d0" 13194139533864 true] [17592186261078 1034 "81" 13194139533864 true] [17592186261078 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261078 1111 #uuid "db6c0abe-be01-5a18-89bf-81ac56e02c61" 13194139533864 true] [17592186261079 1017 #edb/ref 17592186261080 13194139533864 true] [17592186261079 1089 "q-67699" 13194139533864 true] [17592186261079 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261079 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/90f51ea4561fc1c1b892863daedc15bb813fbf18a03e1c9366d54f1a883d0db4.png)\n\nFind ${lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261079 1113 #uuid "e345d3a4-c2d8-581c-8529-3152719d2521" 13194139533864 true] [17592186261079 1145 "From the graph, we get that ${lim}_{x\\to \\,\\pi /2}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4}={lim}_{x\\to \\,\\pi /2}(4x)^{2}\\cdot {lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(4x)^{2} & ={({lim}_{x\\to \\,\\pi /2}(4x))}^{2} \\\\  & =(4\\cdot (\\pi /2))^{2} \\\\  & =(2\\pi )^{2} \\\\  & =4{\\pi }^{2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4} & ={({lim}_{x\\to \\,\\pi /2}(f(x)-2))}^{4} \\\\  & =(1-2)^{4} \\\\  & =(-1)^{4} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4} & ={lim}_{x\\to \\,\\pi /2}(4x)^{2}\\cdot {lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4} \\\\  & =(4{\\pi }^{2})\\cdot (1) \\\\  & =4{\\pi }^{2}\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186261080 1000 #edb/ref 17592186261081 13194139533864 true] [17592186261080 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261080 1041 "answer" 13194139533864 true] [17592186261080 1104 #edb/ref 17592186261081 13194139533864 true] [17592186261080 1110 #uuid "0f6064a8-9b36-5d48-95f7-99018aa0905b" 13194139533864 true] [17592186261081 1034 "4{\\pi }^{2}" 13194139533864 true] [17592186261081 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261081 1111 #uuid "c5f0457c-6fea-5192-9240-e27267ee21eb" 13194139533864 true] [17592186261082 1017 #edb/ref 17592186261083 13194139533864 true] [17592186261082 1089 "q-67700" 13194139533864 true] [17592186261082 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261082 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d81155f8c9b683e85a7f00ef41ac9ddcf36e303b40ca51c6de3e5d74833d5825.png)\n\nFind ${lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261082 1113 #uuid "ddb68ee1-fc65-5b56-84b0-11e3e63cec4f" 13194139533864 true] [17592186261082 1145 "From the graph, we get that ${lim}_{x\\to \\,3}f(x)=9.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2}={lim}_{x\\to \\,3}(3x-10)^{3}\\cdot {lim}_{x\\to \\,3}(f(x)-x)^{2}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(3x-10)^{3} & ={({lim}_{x\\to \\,3}(3x-10))}^{3} \\\\  & =(3(3)-10)^{3} \\\\  & =(-1)^{3} \\\\  & =-1,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(f(x)-x)^{2} & ={({lim}_{x\\to \\,3}(f(x)-x))}^{2} \\\\  & =(9-3)^{2} \\\\  & ={6}^{2} \\\\  & =36\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2} & ={lim}_{x\\to \\,3}(3x-10)^{3}\\cdot {lim}_{x\\to \\,3}(f(x)-x)^{2} \\\\  & =(-1)(36) \\\\  & =-36\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186261083 1000 #edb/ref 17592186261084 13194139533864 true] [17592186261083 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261083 1041 "answer" 13194139533864 true] [17592186261083 1104 #edb/ref 17592186261084 13194139533864 true] [17592186261083 1110 #uuid "9079c108-3383-5bba-a4f3-e607d0cdd310" 13194139533864 true] [17592186261084 1034 "-36" 13194139533864 true] [17592186261084 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261084 1111 #uuid "99c8788e-b678-5c57-9fef-cb3884fabb5e" 13194139533864 true] [17592186261085 1017 #edb/ref 17592186261086 13194139533864 true] [17592186261085 1089 "q-67702" 13194139533864 true] [17592186261085 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261085 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1786cfa3ea3b08a97e59ec148a8fe710d6e4b11fc1cbc3582c4bf925a41bf19f.png)\n\nFind ${lim}_{x\\to \\,-2}\\sqrt{17-2f(x)}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261085 1113 #uuid "f14e9302-b81e-5bd4-b3e0-dc1fe5b82277" 13194139533864 true] [17592186261085 1145 "From the graph, we get that ${lim}_{x\\to \\,-2}f(x)=4.$ \n\nApplying the root rule, we get\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-2}\\sqrt{17-2f(x)} & =\\sqrt{{lim}_{x\\to \\,-2}(17-2f(x))} \\\\  & =\\sqrt{17-2\\cdot (4)} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$" 13194139533864 true] [17592186261086 1000 #edb/ref 17592186261087 13194139533864 true] [17592186261086 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261086 1041 "answer" 13194139533864 true] [17592186261086 1104 #edb/ref 17592186261087 13194139533864 true] [17592186261086 1110 #uuid "369ba6c0-530d-5f3a-85c4-0d0286705012" 13194139533864 true] [17592186261087 1034 "3" 13194139533864 true] [17592186261087 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261087 1111 #uuid "249be7b5-1906-53fd-b666-f188a9dbdb3f" 13194139533864 true] [17592186261088 1017 #edb/ref 17592186261089 13194139533864 true] [17592186261088 1089 "q-67891" 13194139533864 true] [17592186261088 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261088 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e17bf0ffc492fc1ed22d97e422cf9926bfac01ac765614bbe63b887853d65e2e.png)\n\nDetermine the measure of each interior angle of a regular octagon.\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261088 1113 #uuid "d3f596ab-ac68-5c7f-b786-c059e7723c66" 13194139533864 true] [17592186261088 1145 "A regular octagon is an $8$-sided polygon where all the interior angles have the same measure.\n\nThe sum of the measures of its interior angles is \n\n$$\n{180}^{∘}\\times (8-2)=1\\,{080}^{∘}.\n$$\n\n \n\nTherefore, the measure of each interior angle is \n\n$$\n\\frac{1\\,{080}^{∘}}{8}={135}^{∘}.\n$$" 13194139533864 true] [17592186261089 1000 #edb/ref 17592186261090 13194139533864 true] [17592186261089 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261089 1041 "answer" 13194139533864 true] [17592186261089 1104 #edb/ref 17592186261090 13194139533864 true] [17592186261089 1110 #uuid "bb23736f-adab-5c1d-a381-de6e88c51841" 13194139533864 true] [17592186261090 1034 "{135}^{∘}" 13194139533864 true] [17592186261090 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261090 1111 #uuid "ee3f5f28-e01b-5a22-a55d-d03e9a923730" 13194139533864 true] [17592186261091 1017 #edb/ref 17592186261092 13194139533864 true] [17592186261091 1089 "q-68092" 13194139533864 true] [17592186261091 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261091 1100 "Evaluate ${lim}_{x\\to \\infty }\\frac{5x}{\\operatorname{ln}(7x)}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261091 1113 #uuid "816839db-3128-5843-a7d7-214ad5efb0db" 13194139533864 true] [17592186261091 1145 "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since $5x≫\\operatorname{ln}(7x)$ for large values of $x,$ the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{5x}{\\operatorname{ln}(7x)}=\\infty .\n$$" 13194139533864 true] [17592186261092 1000 #edb/ref 17592186261093 13194139533864 true] [17592186261092 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261092 1041 "answer" 13194139533864 true] [17592186261092 1104 #edb/ref 17592186261093 13194139533864 true] [17592186261092 1110 #uuid "0fa61e3a-8e6b-558a-8372-33d0a6ddd22f" 13194139533864 true] [17592186261093 1034 "\\infty" 13194139533864 true] [17592186261093 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261093 1111 #uuid "0401ff50-2b97-5feb-afd3-d615e56c717e" 13194139533864 true] [17592186261094 1017 #edb/ref 17592186261095 13194139533864 true] [17592186261094 1089 "q-6832" 13194139533864 true] [17592186261094 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261094 1100 "For the parametric curve\n\n$$\nx=\\operatorname{sin}(\\frac{\\pi t}{2}),\\,\\,\\,y=\\operatorname{cos}(\\frac{\\pi t}{3}),\\,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $0$ | $b$ | $0$ | $1$ | $0$ | $c$ |\n| $y$ | $a$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ | $-1$ |\n\n$$\n\n$$\n\nFind the value of $-a+b+c.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261094 1113 #uuid "bb6b00ad-d0da-51b8-947a-ae3a849534d3" 13194139533864 true] [17592186261094 1145 "- To find the value of $a,$ we substitute $t=-3$ into $y=\\operatorname{cos}(\\frac{\\pi t}{3}).$ This gives\n\n$$\na=\\operatorname{cos}(\\frac{\\pi (-3)}{3})=\\operatorname{cos}(-\\pi )=-1.\n$$\n\n- To find the value of $b,$ we substitute $t=-1$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nb=\\operatorname{sin}(\\frac{\\pi (-1)}{2})=\\operatorname{sin}(-\\frac{\\pi }{2})=-1.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=\\operatorname{sin}(\\frac{\\pi t}{2}).$ This gives\n\n$$\nc=\\operatorname{sin}(\\frac{\\pi (3)}{2})=\\operatorname{sin}(\\frac{3\\pi }{2})=-1.\n$$\n\nFinally, we have\n\n$$\n-a+b+c=-(-1)+(-1)+(-1)=-1.\n$$" 13194139533864 true] [17592186261095 1000 #edb/ref 17592186261096 13194139533864 true] [17592186261095 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261095 1041 "answer" 13194139533864 true] [17592186261095 1104 #edb/ref 17592186261096 13194139533864 true] [17592186261095 1110 #uuid "757137c4-df81-5d0c-9722-1fd017aa21a9" 13194139533864 true] [17592186261096 1034 "-1" 13194139533864 true] [17592186261096 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261096 1111 #uuid "d07a408d-61e2-5c18-ae4f-c310d6a3fc68" 13194139533864 true] [17592186261097 1017 #edb/ref 17592186261098 13194139533864 true] [17592186261097 1089 "q-68957" 13194139533864 true] [17592186261097 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261097 1100 "${(\\frac{6}{7})}^{8}\\cdot {7}^{3}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261097 1113 #uuid "4f339d72-643b-5603-8c4c-84752670bfae" 13194139533864 true] [17592186261097 1145 "First, we rewrite the first factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{6}{7})}^{8}\\cdot {7}^{3}=\\frac{{6}^{8}}{{7}^{8}}\\cdot {7}^{3}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n\\frac{{6}^{8}}{{7}^{8}}\\cdot {7}^{3}={6}^{8}\\cdot \\frac{{7}^{3}}{{7}^{8}}\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n{6}^{8}\\cdot \\frac{{7}^{3}}{{7}^{8}}={6}^{8}\\cdot {7}^{3-8}={6}^{8}\\cdot {7}^{-5}\n$$" 13194139533864 true] [17592186261098 1000 #edb/ref 17592186261099 13194139533864 true] [17592186261098 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261098 1041 "answer" 13194139533864 true] [17592186261098 1104 #edb/ref 17592186261099 13194139533864 true] [17592186261098 1110 #uuid "920bc779-3731-5cf3-8bd3-d6fec7f0b5ea" 13194139533864 true] [17592186261099 1034 "{6}^{8}\\cdot {7}^{-5}" 13194139533864 true] [17592186261099 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261099 1111 #uuid "05b55f04-7cd3-5516-801f-54d823312188" 13194139533864 true] [17592186261100 1017 #edb/ref 17592186261101 13194139533864 true] [17592186261100 1089 "q-69673" 13194139533864 true] [17592186261100 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261100 1100 "Find the interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,3\\,$ | $\\,5\\,$ | $\\,7\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,-1\\,$ | $\\,5\\,$ | $\\,-3\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,-2\\,$ | $\\,2\\,$ |\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261100 1113 #uuid "4551be98-ab92-5187-a58d-9f84d3f63f96" 13194139533864 true] [17592186261100 1145 "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(3)=f(7)=-2,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[3,7].$" 13194139533864 true] [17592186261101 1000 #edb/ref 17592186261102 13194139533864 true] [17592186261101 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261101 1041 "answer" 13194139533864 true] [17592186261101 1104 #edb/ref 17592186261102 13194139533864 true] [17592186261101 1110 #uuid "992e25e8-25ee-56cb-bbbd-521f7d1ca04a" 13194139533864 true] [17592186261102 1034 "[3,7]" 13194139533864 true] [17592186261102 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261102 1111 #uuid "5504da93-d9a6-5500-b49b-8ddb0bacf15b" 13194139533864 true] [17592186261103 1017 #edb/ref 17592186261104 13194139533864 true] [17592186261103 1089 "q-69674" 13194139533864 true] [17592186261103 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261103 1100 "Find an interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-3\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,7\\,$ | $\\,-4\\,$ | $\\,3\\,$ | $\\,-4\\,$ | $\\,1\\,$ | $\\,5\\,$ | $\\,-4\\,$ |\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261103 1113 #uuid "855a5a4d-d544-5179-beb7-e1ec84d7bfdf" 13194139533864 true] [17592186261103 1145 "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(-1)=f(9)=-4,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[-1,9].$" 13194139533864 true] [17592186261104 1000 #edb/ref 17592186261105 13194139533864 true] [17592186261104 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261104 1041 "answer" 13194139533864 true] [17592186261104 1104 #edb/ref 17592186261105 13194139533864 true] [17592186261104 1110 #uuid "64a093ec-b1ec-5c51-b524-05e9791e7039" 13194139533864 true] [17592186261105 1034 "[-1,9]" 13194139533864 true] [17592186261105 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261105 1111 #uuid "41820006-8575-577b-8637-c873853c0bab" 13194139533864 true] [17592186261106 1017 #edb/ref 17592186261107 13194139533864 true] [17592186261106 1089 "q-69708" 13194139533864 true] [17592186261106 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261106 1100 "Find the eighth partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2n+3).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261106 1113 #uuid "5a8ef49c-d0f0-5230-8a06-784e450e8567" 13194139533864 true] [17592186261106 1145 "Let ${a}_{n}=2n+3.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2(1)+3=5 \\\\ {a}_{2} & =2(2)+3=7 \\\\ {a}_{3} & =2(3)+3=9,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=2$ and first term ${a}_{1}=5.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{8}=2(8)+3=19,$ we get\n\n$$\n{s}_{8}=\\frac{8}{2}(5+19)=96.\n$$\n\nSo the eighth partial sum of ${\\sum }_{n=1}^{\\infty }(2n+3)$ is equal to $96.$" 13194139533864 true] [17592186261107 1000 #edb/ref 17592186261108 13194139533864 true] [17592186261107 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261107 1041 "answer" 13194139533864 true] [17592186261107 1104 #edb/ref 17592186261108 13194139533864 true] [17592186261107 1110 #uuid "3a5431de-10c0-57fb-86ad-1c754cd133cb" 13194139533864 true] [17592186261108 1034 "96" 13194139533864 true] [17592186261108 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261108 1111 #uuid "144e8652-fa68-52dc-82e6-05edd1d9d46d" 13194139533864 true] [17592186261109 1017 #edb/ref 17592186261110 13194139533864 true] [17592186261109 1089 "q-6979" 13194139533864 true] [17592186261109 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261109 1100 "Determine the horizontal asymptote of the function $f(x)=\\frac{3{x}^{3}+2{x}^{2}+x}{1-{x}^{3}}.$\n\n$y =$: {{y}}" 13194139533864 true] [17592186261109 1113 #uuid "f8e64f3e-acff-51b4-ab2e-e9c313440acf" 13194139533864 true] [17592186261109 1145 "To find the horizontal asymptote of a rational function, we divide every term in the numerator and denominator by the dominant term in the denominator, and then we let $x\\to \\infty .$\n\nIn this case, the dominant term in the denominator is ${x}^{3}.$ So, we divide every term in the numerator and denominator by ${x}^{3},$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{3{x}^{3}+2{x}^{2}+x}{1-{x}^{3}} \\\\  & =\\frac{(\\frac{3{x}^{3}}{{x}^{3}}+\\frac{2{x}^{2}}{{x}^{3}}+\\frac{x}{{x}^{3}})}{(\\frac{1}{{x}^{3}}-\\frac{{x}^{3}}{{x}^{3}})} \\\\  & =\\frac{(3+\\frac{2}{x}+\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{3}}-1)}\\end{aligned}\n$$\n\nNow, when $x$ is very large, the terms $\\frac{2}{x},\\frac{1}{{x}^{2}}$ and $\\frac{1}{{x}^{3}}$ become very small. Therefore, as $x\\to \\infty ,$ we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{(3+\\frac{2}{x}+\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{3}}-1)} \\\\  & \\to \\frac{3+0+0}{0-1} \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the horizontal asymptote is $y=-3.$" 13194139533864 true] [17592186261110 1000 #edb/ref 17592186261111 13194139533864 true] [17592186261110 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261110 1041 "y" 13194139533864 true] [17592186261110 1104 #edb/ref 17592186261111 13194139533864 true] [17592186261110 1110 #uuid "ff98420d-303a-5998-a7ab-08711c468a4e" 13194139533864 true] [17592186261111 1034 "-3" 13194139533864 true] [17592186261111 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261111 1111 #uuid "b08d7f70-e837-52b5-a04f-b94a8a4abbb0" 13194139533864 true] [17592186261112 1017 #edb/ref 17592186261113 13194139533864 true] [17592186261112 1089 "q-69791" 13194139533864 true] [17592186261112 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261112 1100 "Which of the following statements are true regarding the function $y={log}_{5}x?$\n\nI. - The domain is $x>1$\nII. - It has a maximum at $x=1$\nIII. - It passes through the point $(25,2)$" 13194139533864 true] [17592186261112 1113 #uuid "22db072b-47e0-5531-be05-96bd3329aa8c" 13194139533864 true] [17592186261112 1145 "Let's plot the graph of $y={log}_{5}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fd8c4765fa1b07d58a4d0b2e90a07383f5475883a2ada747ea6ae32e7a73808b.png)\n\nLet's go through each statement.\n\n- Statement I is false. From the graph, we see that the domain is $x>0.$\n\n- Statement II is false. The function is strictly increasing on its entire domain. Therefore, there are no maximum values.\n\n- Statement III is true. Substituting $x=25$ into the equation of the curve gives:\n\n$$\n\\begin{aligned}y & ={log}_{5}(25) \\\\  & ={log}_{5}({5}^{2}) \\\\  & =2\\,\\,✓\\end{aligned}\n$$\n\nIn conclusion, only statement III is true." 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261114 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261115 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261116 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261117 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261118 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261119 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261120 13194139533864 true] [17592186261113 1000 #edb/ref 17592186261121 13194139533864 true] [17592186261113 1040 #edb/ref 17592186045450 13194139533864 true] [17592186261113 1041 "selection" 13194139533864 true] [17592186261113 1104 #edb/ref 17592186261118 13194139533864 true] [17592186261113 1110 #uuid "7b376239-9277-5a5a-b27c-bad904bb69b7" 13194139533864 true] [17592186261114 1034 "I, II, and III" 13194139533864 true] [17592186261114 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261114 1111 #uuid "75311fce-4feb-567e-b92c-49d719962b96" 13194139533864 true] [17592186261115 1034 "II and III only" 13194139533864 true] [17592186261115 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261115 1111 #uuid "c402868e-47ed-50be-b9a7-189ca376d7a7" 13194139533864 true] [17592186261116 1034 "I and III only" 13194139533864 true] [17592186261116 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261116 1111 #uuid "77a8eadb-a898-5c1c-ab62-f63855a24e95" 13194139533864 true] [17592186261117 1034 "I only" 13194139533864 true] [17592186261117 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261117 1111 #uuid "40e36838-8b21-54b1-8762-5ad5ccff12d3" 13194139533864 true] [17592186261118 1034 "III only" 13194139533864 true] [17592186261118 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261118 1111 #uuid "d660b1d0-8f74-5e2a-95a1-a3d4bfbb381a" 13194139533864 true] [17592186261119 1034 "I and II only" 13194139533864 true] [17592186261119 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261119 1111 #uuid "722f8723-5569-5bf5-9c17-5140e64ebe19" 13194139533864 true] [17592186261120 1034 "None of those listed" 13194139533864 true] [17592186261120 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261120 1111 #uuid "f7bd8e97-4a84-5829-9d91-27806062c05c" 13194139533864 true] [17592186261121 1034 "II only" 13194139533864 true] [17592186261121 1103 #edb/ref 17592186045454 13194139533864 true] [17592186261121 1111 #uuid "5162764c-a93f-5b9a-bd1e-2e9c26b3a693" 13194139533864 true] [17592186261122 1017 #edb/ref 17592186261123 13194139533864 true] [17592186261122 1089 "q-69836" 13194139533864 true] [17592186261122 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261122 1100 "Factor the expression $8{x}^{5}-16{x}^{4}+6{x}^{3}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261122 1113 #uuid "7f344ca5-bedc-5439-977a-da1c0e3e41a4" 13194139533864 true] [17592186261122 1145 "Note that all of the terms have a common factor of $2{x}^{3}.$ To simplify the computation, we can factor out the $2{x}^{3},$ as follows:\n\n$$\n\\begin{aligned}8{x}^{5}-16{x}^{4}+6{x}^{3} & =2{x}^{3}(4{x}^{2}-8x+3)\\end{aligned}\n$$\n\nNow, we factor the polynomial $4{x}^{2}-8x+3,$ as follows:\n\n$$\n\\begin{aligned}2{x}^{3}(4{x}^{2}-8x+3) & = \\\\ 2{x}^{3}((4{x}^{2}-6x)+(-2x+3)) & = \\\\ 2{x}^{3}(2x(2x-3)-1(2x-3)) & = \\\\ 2{x}^{3}(2x-1)(2x-3)\\end{aligned}\n$$" 13194139533864 true] [17592186261123 1000 #edb/ref 17592186261124 13194139533864 true] [17592186261123 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261123 1041 "answer" 13194139533864 true] [17592186261123 1104 #edb/ref 17592186261124 13194139533864 true] [17592186261123 1110 #uuid "176689f2-69ef-5e45-9f54-dfa2d3462bc2" 13194139533864 true] [17592186261124 1034 "2{x}^{3}(2x-1)(2x-3)" 13194139533864 true] [17592186261124 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261124 1111 #uuid "f2732344-a0f6-52bd-a5da-e8f1133a71b1" 13194139533864 true] [17592186261125 1017 #edb/ref 17592186261126 13194139533864 true] [17592186261125 1089 "q-69923" 13194139533864 true] [17592186261125 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261125 1100 "For the parametric curve\n\n$$\nx=-3t,\\,\\,\\,y=2t,\\,-5\\le t\\le 0,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-5$ | $-4$ | $-3$ | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $15$ | $12$ | $9$ | $6$ | $3$ | $c$ |\n| $y$ | $-10$ | $a$ | $-6$ | $b$ | $-2$ | $0$ |\n\n$$\n\n$$\n\nFind the value of $a-b+c.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261125 1113 #uuid "97d679c9-1cde-5a51-924a-06ae37ba6ab4" 13194139533864 true] [17592186261125 1145 "- To find the value of $a,$ we substitute $t=-4$ into $y=2t.$ This gives\n\n$$\na=2(-4)=-8.\n$$\n\n- To find the value of $b,$ we substitute $t=-2$ into $y=2t.$ This gives\n\n$$\nb=2(-2)-4.\n$$\n\n- To find the value of $c,$ we substitute $t=0$ into $x=-3t.$ This gives\n\n$$\nc=-3(0)=0.\n$$\n\nFinally, we have\n\n$$\na-b+c=-8-(-4)+0=-4.\n$$" 13194139533864 true] [17592186261126 1000 #edb/ref 17592186261127 13194139533864 true] [17592186261126 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261126 1041 "answer" 13194139533864 true] [17592186261126 1104 #edb/ref 17592186261127 13194139533864 true] [17592186261126 1110 #uuid "29e41ae2-ae31-55b2-8633-b421b7bdd207" 13194139533864 true] [17592186261127 1034 "-4" 13194139533864 true] [17592186261127 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261127 1111 #uuid "8fc224f3-876f-5816-892b-79717b173126" 13194139533864 true] [17592186261128 1017 #edb/ref 17592186261129 13194139533864 true] [17592186261128 1089 "q-70017" 13194139533864 true] [17592186261128 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261128 1100 "If ${log}_{3}(x-6)+5=8$, then $x=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261128 1113 #uuid "513d3cec-982b-533e-81bb-8c54a8125de4" 13194139533864 true] [17592186261128 1145 "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}{log}_{3}(x-6)+5 & =8 \\\\ {log}_{3}(x-6) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}(x-6) & =3 \\\\ {3}^{{log}_{3}(x-6)} & ={3}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}(x-6)}=x-6.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-6 & ={3}^{3} \\\\ x-6 & =27 \\\\ x & =33.\\end{aligned}\n$$" 13194139533864 true] [17592186261129 1000 #edb/ref 17592186261130 13194139533864 true] [17592186261129 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261129 1041 "answer" 13194139533864 true] [17592186261129 1104 #edb/ref 17592186261130 13194139533864 true] [17592186261129 1110 #uuid "b50d5e7f-236c-51dc-af70-45c7389804d0" 13194139533864 true] [17592186261130 1034 "33" 13194139533864 true] [17592186261130 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261130 1111 #uuid "ef22657b-07c2-55e8-850e-53f5cacb390e" 13194139533864 true] [17592186261131 1017 #edb/ref 17592186261132 13194139533864 true] [17592186261131 1089 "q-70018" 13194139533864 true] [17592186261131 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261131 1100 "If $6{log}_{4}(x+11)=12$, then $x=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261131 1113 #uuid "6670ae0c-7bd3-5be8-8afd-7e9eadd30b6f" 13194139533864 true] [17592186261131 1145 "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}6{log}_{4}(x+11) & =12 \\\\ {log}_{4}(x+11) & =\\frac{12}{6} \\\\ {log}_{4}(x+11) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}(x+11) & =2 \\\\ {4}^{{log}_{4}(x+11)} & ={4}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}(x+11)}=x+11.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+11 & ={4}^{2} \\\\ x+11 & =16 \\\\ x & =5.\\end{aligned}\n$$" 13194139533864 true] [17592186261132 1000 #edb/ref 17592186261133 13194139533864 true] [17592186261132 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261132 1041 "answer" 13194139533864 true] [17592186261132 1104 #edb/ref 17592186261133 13194139533864 true] [17592186261132 1110 #uuid "7d747a78-d797-5920-a99b-727c7561455e" 13194139533864 true] [17592186261133 1034 "5" 13194139533864 true] [17592186261133 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261133 1111 #uuid "02211a15-7355-5260-8fcb-254354108bd0" 13194139533864 true] [17592186261134 1017 #edb/ref 17592186261135 13194139533864 true] [17592186261134 1089 "q-70038" 13194139533864 true] [17592186261134 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261134 1100 "If $2\\operatorname{ln}(x+1)=3+\\operatorname{ln}(x+1)$, then what is the value of  $x?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261134 1113 #uuid "42630df1-055b-586b-92da-4fb95bf927b0" 13194139533864 true] [17592186261134 1145 "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}2\\operatorname{ln}(x+1) & =3+\\operatorname{ln}(x+1) \\\\ 2\\operatorname{ln}(x+1)-\\operatorname{ln}(x+1) & =3 \\\\ (2-1)\\operatorname{ln}(x+1) & =3 \\\\ \\operatorname{ln}(x+1) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}(x+1) & =3 \\\\ {e}^{\\operatorname{ln}(x+1)} & ={e}^{3}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}(x+1)}=x+1.$ \n\nTherefore, \n\n$$\n\\begin{aligned}x+1 & ={e}^{3} \\\\ x & ={e}^{3}-1.\\end{aligned}\n$$" 13194139533864 true] [17592186261135 1000 #edb/ref 17592186261136 13194139533864 true] [17592186261135 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261135 1041 "answer" 13194139533864 true] [17592186261135 1104 #edb/ref 17592186261136 13194139533864 true] [17592186261135 1110 #uuid "98bac45e-d716-5fe8-a983-85f46620f64d" 13194139533864 true] [17592186261136 1034 "{e}^{3}-1" 13194139533864 true] [17592186261136 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261136 1111 #uuid "9e571226-fa06-51d8-a8a1-76ab885baf85" 13194139533864 true] [17592186261137 1017 #edb/ref 17592186261138 13194139533864 true] [17592186261137 1089 "q-70042" 13194139533864 true] [17592186261137 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261137 1100 "Given $f(x)=x+3$ and $g(x)=-2x+1,$ find $(f+g)(2).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261137 1113 #uuid "08ea8cf2-f1c0-54d8-b1f4-c3ee612c64fc" 13194139533864 true] [17592186261137 1145 "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(2),$ we find $f(2)$ and $g(2),$ and then add the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =2+3=5 \\\\ g(2) & =-2(2)+1=-3\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(2)=f(2)+g(2)=5+(-3)=2\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(x+3)+(-2x+1) \\\\  & =-x+4\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(2):$\n\n$$\n\\begin{aligned}(f+g)(2) & =-2+4=2\\end{aligned}\n$$" 13194139533864 true] [17592186261138 1000 #edb/ref 17592186261139 13194139533864 true] [17592186261138 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261138 1041 "answer" 13194139533864 true] [17592186261138 1104 #edb/ref 17592186261139 13194139533864 true] [17592186261138 1110 #uuid "1b1f79e3-52c1-5680-8033-9d1772967ff2" 13194139533864 true] [17592186261139 1034 "2" 13194139533864 true] [17592186261139 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261139 1111 #uuid "2af7aef1-c83a-5f90-b617-ed5f9a36c70b" 13194139533864 true] [17592186261140 1017 #edb/ref 17592186261141 13194139533864 true] [17592186261140 1089 "q-70044" 13194139533864 true] [17592186261140 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261140 1100 "Given $f(x)=3-2x$ and $g(x)=x+6,$ find  $(f+g)(5).$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261140 1113 #uuid "1a8dcfa2-7a22-559e-8b4a-993daded6d09" 13194139533864 true] [17592186261140 1145 "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(5),$ we find $f(5)$ and $g(5),$ and then add the results.\n\nFirst, we find $f(5)$ and $g(5):$\n\n$$\n\\begin{aligned}f(5) & =3-2(5)=-7 \\\\ g(5) & =5+6=11\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(5)=f(5)+g(5)=(-7)+11=4\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(3-2x)+(x+6) \\\\  & =9-x\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(5):$\n\n$$\n\\begin{aligned}(f+g)(5) & =9-5=4\\end{aligned}\n$$" 13194139533864 true] [17592186261141 1000 #edb/ref 17592186261142 13194139533864 true] [17592186261141 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261141 1041 "answer" 13194139533864 true] [17592186261141 1104 #edb/ref 17592186261142 13194139533864 true] [17592186261141 1110 #uuid "c8818533-22cd-5f3d-895a-867d995e5be4" 13194139533864 true] [17592186261142 1034 "4" 13194139533864 true] [17592186261142 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261142 1111 #uuid "0bf8de10-d41e-55cc-bf82-e50fe6e6a886" 13194139533864 true] [17592186261143 1017 #edb/ref 17592186261144 13194139533864 true] [17592186261143 1089 "q-70058" 13194139533864 true] [17592186261143 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261143 1100 "Find the values of $x$ such that $\\operatorname{ln}(3x+2)+2\\operatorname{ln}(3x+2)=6.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261143 1113 #uuid "36687ada-dae6-5a18-a462-3e7164dc30d5" 13194139533864 true] [17592186261143 1145 "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}\\operatorname{ln}(3x+2)+2\\operatorname{ln}(3x+2) & =6 \\\\ (1+2)\\operatorname{ln}(3x+2) & =6 \\\\ 3\\operatorname{ln}(3x+2) & =6 \\\\ \\operatorname{ln}(3x+2) & =\\frac{6}{3} \\\\ \\operatorname{ln}(3x+2) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}(3x+2) & =2 \\\\ {e}^{\\operatorname{ln}(3x+2)} & ={e}^{2}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}(3x+2)}=3x+2.$ \n\nTherefore, \n\n$$\n\\begin{aligned}3x+2 & ={e}^{2} \\\\ 3x & ={e}^{2}-2 \\\\ x & =\\frac{{e}^{2}-2}{3}.\\end{aligned}\n$$" 13194139533864 true] [17592186261144 1000 #edb/ref 17592186261145 13194139533864 true] [17592186261144 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261144 1041 "answer" 13194139533864 true] [17592186261144 1104 #edb/ref 17592186261145 13194139533864 true] [17592186261144 1110 #uuid "58b67547-4901-5698-8741-2b3163d6ab08" 13194139533864 true] [17592186261145 1034 "\\frac{{e}^{2}-2}{3}" 13194139533864 true] [17592186261145 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261145 1111 #uuid "a73a114f-9e98-5694-8e48-25dfff76b506" 13194139533864 true] [17592186261146 1017 #edb/ref 17592186261147 13194139533864 true] [17592186261146 1089 "q-70116" 13194139533864 true] [17592186261146 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261146 1100 "Evaluate $\\frac{2(x-3)}{4-x}$ for $x=2.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261146 1113 #uuid "275243bf-578c-5ea8-b1eb-e4e03906be2e" 13194139533864 true] [17592186261146 1145 "We replace $x$ with $2$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2(x-3)}{4-x} & = \\\\ \\frac{2(2-3)}{4-2} & = \\\\ \\frac{2(-1)}{2} & = \\\\ \\frac{\\cancel{2}(-1)}{\\cancel{2}} & = \\\\ -1\\end{aligned}\n$$" 13194139533864 true] [17592186261147 1000 #edb/ref 17592186261148 13194139533864 true] [17592186261147 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261147 1041 "answer" 13194139533864 true] [17592186261147 1104 #edb/ref 17592186261148 13194139533864 true] [17592186261147 1110 #uuid "cc207bd0-5db3-5bf4-999b-8a51dc1a7a3b" 13194139533864 true] [17592186261148 1034 "-1" 13194139533864 true] [17592186261148 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261148 1111 #uuid "35b1c28b-4cd8-5ae3-ae71-00d05daa2f29" 13194139533864 true] [17592186261149 1017 #edb/ref 17592186261150 13194139533864 true] [17592186261149 1089 "q-70142" 13194139533864 true] [17592186261149 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261149 1100 "Simplify $\\frac{3x+2}{3x}+\\frac{x-3}{3x}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261149 1113 #uuid "8467b02b-5d78-5734-bca3-a89323c30d4c" 13194139533864 true] [17592186261149 1145 "We have a common denominator of $3x,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{3x+2}{3x}+\\frac{x-3}{3x} & = \\\\ \\frac{3x+2+x-3}{3x} & = \\\\ \\frac{(3x+x)+(2-3)}{3x} & = \\\\ \\frac{4x-1}{3x} & \\end{aligned}\n$$" 13194139533864 true] [17592186261150 1000 #edb/ref 17592186261151 13194139533864 true] [17592186261150 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261150 1041 "answer" 13194139533864 true] [17592186261150 1104 #edb/ref 17592186261151 13194139533864 true] [17592186261150 1110 #uuid "f46904f7-8352-5966-aaa4-c533851a556d" 13194139533864 true] [17592186261151 1034 "\\frac{4x-1}{3x}" 13194139533864 true] [17592186261151 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261151 1111 #uuid "85e7f8c8-6042-5f54-ac15-b0fabd4ec7ff" 13194139533864 true] [17592186261152 1017 #edb/ref 17592186261153 13194139533864 true] [17592186261152 1089 "q-70143" 13194139533864 true] [17592186261152 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261152 1100 "Simplify $\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261152 1113 #uuid "9ec7633e-93ac-5273-b67e-f7908232a0a5" 13194139533864 true] [17592186261152 1145 "We have a common denominator of $4z,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z} & = \\\\ \\frac{2z-5w+3z+2w}{4z} & = \\\\ \\frac{(2z+3z)+(-5w+2w)}{4z} & = \\\\ \\frac{5z-3w}{4z}\\end{aligned}\n$$" 13194139533864 true] [17592186261153 1000 #edb/ref 17592186261154 13194139533864 true] [17592186261153 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261153 1041 "answer" 13194139533864 true] [17592186261153 1104 #edb/ref 17592186261154 13194139533864 true] [17592186261153 1110 #uuid "4320af23-4440-5115-9980-b996e937f94c" 13194139533864 true] [17592186261154 1034 "\\frac{5z-3w}{4z}" 13194139533864 true] [17592186261154 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261154 1111 #uuid "4ea8573f-d2ec-5460-9d3a-4dd595f8b002" 13194139533864 true] [17592186261155 1017 #edb/ref 17592186261156 13194139533864 true] [17592186261155 1089 "q-70210" 13194139533864 true] [17592186261155 1091 #edb/ref 17592186045464 13194139533864 true] [17592186261155 1100 "If you deposit $$2,000$ into an account with a $20%$ annual interest rate, compounded semi-annually, how many years will it take until there is at least $$4,000$ in the account?\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261155 1113 #uuid "cb756b6f-c9b7-51dc-82e2-024fa8b2534a" 13194139533864 true] [17592186261155 1145 "The compound interest equation states that\n\n$$\n\\begin{aligned}P & ={P}_{0}{(1+\\frac{r}{n})}^{nt}.\\end{aligned}\n$$\n\nThe annual interest is compounded semi-annually, so $n=2.$ We also have an initial amount of ${P}_{0}=2,000$ and annual rate of $r=0.2.$\n\nTo find the number of years it will take until $P\\ge 4,000,$ we substitute these values into the formula and solve for $t:$\n\n$$\n\\begin{aligned}P={P}_{0}{(1+\\frac{r}{n})}^{nt} & \\ge 4,000 \\\\ 2,000{(1+\\frac{0.2}{2})}^{2t} & \\ge 4,000 \\\\ (1+0.1)^{2t} & \\ge \\frac{4,000}{2,000} \\\\ (1.1)^{2t} & \\ge 2 \\\\ \\operatorname{log}({1.1}^{2t}) & \\ge \\operatorname{log}(2) \\\\ 2t\\operatorname{log}(1.1) & \\ge \\operatorname{log}(2) \\\\ 2t & \\ge \\frac{\\operatorname{log}(2)}{\\operatorname{log}(1.1)} \\\\ 2t & \\ge 7.272… \\\\ t & \\ge \\frac{7.272…}{2}\\approx 3.64\\end{aligned}\n$$\n\nRemember payments are compounded semi-annually, so we must choose either $3.5$ or $4$ years.\n\n- After $3.5$ years, there is still less than $$4,000$ in the account, because $3.5<3.64.$\n\n- After $4$ years, there will be more than $$4,000$ in the account, since $4>3.64.$\n\nTherefore, it will take $4$ years until there is at least $$4,000$ in the account." 13194139533864 true] [17592186261156 1000 #edb/ref 17592186261157 13194139533864 true] [17592186261156 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261156 1041 "answer" 13194139533864 true] [17592186261156 1104 #edb/ref 17592186261157 13194139533864 true] [17592186261156 1110 #uuid "2fc3f2cd-a3d6-5ac2-af86-a346aff71d9e" 13194139533864 true] [17592186261157 1034 "4" 13194139533864 true] [17592186261157 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261157 1111 #uuid "b700da5e-ba2d-5a12-ab05-324fb4f0bdd5" 13194139533864 true] [17592186261158 1017 #edb/ref 17592186261159 13194139533864 true] [17592186261158 1089 "q-70326" 13194139533864 true] [17592186261158 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261158 1100 "Simplify $\\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)}.$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261158 1113 #uuid "10adf2d3-95ec-5701-9e89-61b039914163" 13194139533864 true] [17592186261158 1145 "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $(w+1)(2z+3)$ if we multiply the top and bottom of the first fraction by $2z+3:$\n\n$$\n\\begin{aligned}\\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)} & = \\\\ \\frac{2z+3}{2z+3}\\cdot \\frac{2}{w+1}-\\frac{4z}{(w+1)(2z+3)} & = \\\\ \\frac{2(2z+3)}{(w+1)(2z+3)}-\\frac{4z}{(w+1)(2z+3)} & = \\\\ \\frac{2(2z+3)-4z}{(w+1)(2z+3)} & = \\\\ \\frac{4z+6-4z}{(w+1)(2z+3)} & = \\\\ \\frac{6}{(w+1)(2z+3)} & \\end{aligned}\n$$" 13194139533864 true] [17592186261159 1000 #edb/ref 17592186261160 13194139533864 true] [17592186261159 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261159 1041 "answer" 13194139533864 true] [17592186261159 1104 #edb/ref 17592186261160 13194139533864 true] [17592186261159 1110 #uuid "38889a91-063e-55bc-8927-2942a08bfd51" 13194139533864 true] [17592186261160 1034 "\\frac{6}{(w+1)(2z+3)}" 13194139533864 true] [17592186261160 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261160 1111 #uuid "0553b981-1930-577d-af1c-21ca7cdd423d" 13194139533864 true] [17592186261161 1017 #edb/ref 17592186261162 13194139533864 true] [17592186261161 1089 "q-70350" 13194139533864 true] [17592186261161 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261161 1100 "What is the result of dividing $\\frac{8a}{3}$ by $\\frac{7b}{2}?$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261161 1113 #uuid "4d031f53-2cb0-5ef4-9eb5-4fffa3c8a6c0" 13194139533864 true] [17592186261161 1145 "To compute\n\n$$\n\\frac{8a}{3}÷\\frac{7b}{2},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8a}{3}÷\\frac{7b}{2} & = \\\\ \\frac{8a}{3}\\cdot \\frac{2}{7b} & = \\\\ \\frac{16a}{21b} & \\end{aligned}\n$$" 13194139533864 true] [17592186261162 1000 #edb/ref 17592186261163 13194139533864 true] [17592186261162 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261162 1041 "answer" 13194139533864 true] [17592186261162 1104 #edb/ref 17592186261163 13194139533864 true] [17592186261162 1110 #uuid "8771c53a-74b9-50a2-8889-75fc553725e0" 13194139533864 true] [17592186261163 1034 "\\frac{16a}{21b}" 13194139533864 true] [17592186261163 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261163 1111 #uuid "f07f7a29-73e7-5018-9a3a-1c352f5f1553" 13194139533864 true] [17592186261164 1017 #edb/ref 17592186261165 13194139533864 true] [17592186261164 1089 "q-70355" 13194139533864 true] [17592186261164 1091 #edb/ref 17592186045463 13194139533864 true] [17592186261164 1100 "$\\frac{14}{a}÷\\frac{7}{b}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261164 1113 #uuid "deb08641-7369-57ac-a4cc-afb3b4f81d58" 13194139533864 true] [17592186261164 1145 "To compute\n\n$$\n\\frac{14}{a}÷\\frac{7}{b},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14}{a}÷\\frac{7}{b} & = \\\\ \\frac{14}{a}\\cdot \\frac{b}{7} & = \\\\ \\frac{14b}{7a} & = \\\\ \\frac{2\\cdot \\cancel{7}\\cdot b}{\\cancel{7}a} & = \\\\ \\frac{2b}{a} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $7$ in the numerator and denominator." 13194139533864 true] [17592186261165 1000 #edb/ref 17592186261166 13194139533864 true] [17592186261165 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261165 1041 "answer" 13194139533864 true] [17592186261165 1104 #edb/ref 17592186261166 13194139533864 true] [17592186261165 1110 #uuid "cd0f09be-093c-5e06-af95-ab99aea76101" 13194139533864 true] [17592186261166 1034 "7" 13194139533864 true] [17592186261166 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261166 1111 #uuid "e2ba21c6-5dbd-5441-a3ab-86955663155a" 13194139533864 true] [17592186261167 1017 #edb/ref 17592186261168 13194139533864 true] [17592186261167 1089 "q-70358" 13194139533864 true] [17592186261167 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261167 1100 "$\\frac{t+1}{t(t+2)}-\\frac{1}{3t}=$\n\nAnswer: {{answer}}" 13194139533864 true] [17592186261167 1113 #uuid "5978d3f8-08b2-5532-be4c-579c055ba69b" 13194139533864 true] [17592186261167 1145 "In this case, we need to put the fractions over a common denominator of $3t(t+2),$ since there are no common factors in either denominator that we can exploit.\n\nTo do this, we multiply the top and bottom of the first fraction by $3$, and the top and bottom of the second fraction by $(t+2):$\n\n$$\n\\begin{aligned}\\frac{t+1}{t(t+2)}-\\frac{1}{3t} & = \\\\ \\frac{3}{3}\\cdot \\frac{t+1}{t(t+2)}-\\frac{t+2}{t+2}\\cdot \\frac{1}{3t} & = \\\\ \\frac{3(t+1)}{3t(t+2)}-\\frac{t+2}{3t(t+2)} & = \\\\ \\frac{3(t+1)-(t+2)}{3t(t+2)} & = \\\\ \\frac{3t+3-t-2}{3t(t+2)} & = \\\\ \\frac{2t+1}{3t(t+2)} & \\end{aligned}\n$$" 13194139533864 true] [17592186261168 1000 #edb/ref 17592186261169 13194139533864 true] [17592186261168 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261168 1041 "answer" 13194139533864 true] [17592186261168 1104 #edb/ref 17592186261169 13194139533864 true] [17592186261168 1110 #uuid "9e53765c-9fa0-5a90-9326-4b3f7d537e32" 13194139533864 true] [17592186261169 1034 "\\frac{2t+1}{3t(t+2)}" 13194139533864 true] [17592186261169 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261169 1111 #uuid "b7ac4fea-92e3-5f1c-ad24-c9ed600b04ed" 13194139533864 true] [17592186261170 1017 #edb/ref 17592186261171 13194139533864 true] [17592186261170 1017 #edb/ref 17592186261173 13194139533864 true] [17592186261170 1089 "q-70409" 13194139533864 true] [17592186261170 1091 #edb/ref 17592186045465 13194139533864 true] [17592186261170 1100 "Let $n=[\\begin{aligned}5 \\\\ 4\\end{aligned}].$ Find a unit vector that is parallel to $n$ and points the same direction.\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" 13194139533864 true] [17592186261170 1113 #uuid "b579ce8c-aa57-57eb-9f60-cf64367e257f" 13194139533864 true] [17592186261170 1145 "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|\\,n\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|n| & =\\sqrt{{5}^{2}+{4}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nFinally, we divide $n$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|n|} \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot n \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot [\\begin{aligned}5 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{\\sqrt{41}} \\\\ \\frac{4}{\\sqrt{41}}\\end{aligned}]\\end{aligned}\n$$" 13194139533864 true] [17592186261171 1000 #edb/ref 17592186261172 13194139533864 true] [17592186261171 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261171 1041 "r1c1" 13194139533864 true] [17592186261171 1104 #edb/ref 17592186261172 13194139533864 true] [17592186261171 1110 #uuid "2a0dcdbb-3596-5b6f-8121-fdcc339515c7" 13194139533864 true] [17592186261172 1034 "\\frac{5}{\\sqrt{41}}" 13194139533864 true] [17592186261172 1103 #edb/ref 17592186045453 13194139533864 true] [17592186261172 1111 #uuid "74172640-18db-516a-b069-6856cf0ba0b7" 13194139533864 true] [17592186261173 1000 #edb/ref 17592186261174 13194139533864 true] [17592186261173 1040 #edb/ref 17592186045449 13194139533864 true] [17592186261173 1041 "r2c1" 13194139533864 true] [17592186261173 1104 #edb/ref 17592186261174 13194139533864 true] [17592186261173 1110 #uuid "c1c02555-f4ee-5efe-98e3-4b6aa3885d09" 13194139533864 true] [17592186261174 1034 "\\frac{4}{\\sqrt{41}}" 13194139533864 true] [17592186261174 1103 #edb/ref 1759