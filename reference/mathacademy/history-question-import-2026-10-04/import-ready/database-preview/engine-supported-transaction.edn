554be0ab200f9" "q-143211/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-143211/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-143211/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-143211/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-143211" :question/id #uuid "bb518bc9-a705-5791-94c1-9e0ce8b81253" :question/math-academy-id "q-143211" :question/problem "Given that  ${a}_{n}={e}^{2n-1}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}={e}^{2n-1}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is true. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{{e}^{2(n+1)-1}}{{e}^{2n-1}} \\\\  & =\\frac{{e}^{2n+1}}{{e}^{2n-1}} \\\\  & ={e}^{2n+1-(2n-1)} \\\\  & ={e}^{2n+1-2n+1} \\\\  & ={e}^{2} \\\\  & \\ge 1.\\end{aligned}\n$$\n\n- Statement II is true, whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-143211/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "11d7e9b2-b321-5c29-992a-775750c570f0"] :knowledge-point/questions ["q-143211"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123832/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "14576f93-39d1-5d0a-a612-b13bf42e327d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "2344dd6a-b951-57d9-8959-b149dabbc625" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "9ec29120-1aca-50bf-941f-8666b49457ff" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "f25d0059-9c21-538f-8182-201fc33118a4" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "4278e55e-54fe-5930-8a6a-b24bf10e09d5" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f3351e5e-3f56-53c9-9626-6bb7e6254fae" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "fa0a5f21-9f8a-53dc-b0af-1115d94652c5" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-123832/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "6b58ed57-564c-5fe2-befc-bbf155dfce35" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-123832/selection" :answer-field/id #uuid "9c7ec8b4-0a9b-5fcb-8280-de4e086351ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123832/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-123832/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-123832/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-123832/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-123832/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-123832/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-123832/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-123832/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-123832/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-123832" :question/id #uuid "fa300e70-1aa0-5ea9-b533-c6999af1ac96" :question/math-academy-id "q-123832" :question/problem "Given that  ${a}_{n}=\\frac{1}{n!}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=\\frac{1}{n!}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is false. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}\\frac{{a}_{n+1}}{{a}_{n}} & =\\frac{(\\frac{1}{(n+1)!})}{(\\frac{1}{n!})} \\\\  & =\\frac{n!}{(n+1)!} \\\\  & =\\frac{n!}{(n+1)\\cdot n!} \\\\  & =\\frac{\\cancel{n!}}{(n+1)\\cdot \\cancel{n!}} \\\\  & =\\frac{1}{n+1} \\\\  & \\le 1.\\end{aligned}\n$$\n\n- Statement II is false whereas statement III is true. Since $0\\le L<1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is decreasing.\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "169f59f9-ee45-5375-a22d-4906b7a09ad0"] :knowledge-point/questions ["q-123832"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123830/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "638f9b90-82b1-5356-974f-1720d2deaa40" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "aff5b700-74f3-5b4e-bcf9-ebfb3c1f41d8" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "716c0bd5-9251-5471-a449-007d2dc88bfd" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "70344720-f832-5ba3-8f40-b16f255ae8af" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "91faf9c1-42f4-57e9-9402-e0d79ddb9734" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "21b232e0-03f7-5eb2-adc6-bb5e6cb9d78d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "5ff178ed-6078-51ef-856c-8ebc0495c4b4" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-123830/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "1b320a43-ad5c-5dfd-a41b-e516802b30e2" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-123830/selection" :answer-field/id #uuid "4f5fc15e-4bd1-594d-bf6e-a168bad9446a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123830/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-123830/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-123830/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-123830/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-123830/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-123830/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-123830/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-123830/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-123830/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-123830" :question/id #uuid "f7a7813f-e804-5d6c-b87c-980e27be4a3f" :question/math-academy-id "q-123830" :question/problem "Given that  ${a}_{n}=(2n)!$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=(2n)!$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is true. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}\\frac{{a}_{n+1}}{{a}_{n}} & =\\frac{(2(n+1))!}{(2n)!} \\\\  & =\\frac{(2n+2)!}{(2n)!} \\\\  & =\\frac{(2n+2)\\cdot (2n+1)\\cdot (2n)!}{(2n)!} \\\\  & =\\frac{(2n+2)\\cdot (2n+1)\\cdot \\cancel{(2n)!}}{\\cancel{(2n)!}} \\\\  & =(2n+2)(2n+1) \\\\  & \\ge 1.\\end{aligned}\n$$\n\n- Statement II is true, whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123830/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "169f59f9-ee45-5375-a22d-4906b7a09ad0"] :knowledge-point/questions ["q-123830"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36743/b/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "3627d8f3-7507-59fd-add7-0a30a7f9cd5f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-36743/b" :answer-field/id #uuid "fef77817-3574-5917-8751-f6dc6ac2eaef" :answer-field/key "b" :answer-field/type :answer-field.type/blank :answer-field/correct "q-36743/b/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-36743/b/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-36743/c/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "fda01204-9e15-5935-8160-c3810f97cd32" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-36743/c" :answer-field/id #uuid "8e135889-0014-59ef-a4ff-b04ac2c9f0e6" :answer-field/key "c" :answer-field/type :answer-field.type/blank :answer-field/correct "q-36743/c/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-36743/c/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-36743" :question/id #uuid "3cbc081a-4656-5dca-b3b1-aa3f8536f992" :question/math-academy-id "q-36743" :question/problem "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}{x}^{2}+2x+b\\, & \\text{ for }\\,x\\le 1 \\\\ {x}^{2}+cx+2\\, & \\text{ for }\\,x>1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 1}f(x)=2.$ What is the value of the constants $b$ and $c?$\n\n$b$: {{b}}\n\n$c$: {{c}}" :question/worked-solution "In order for ${lim}_{x\\to 1}f(x)$ to be equal to $2,$ the left and right-sided limits must both exist and be equal to $2.$\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)={x}^{2}+2x+b.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{2}+2x+b) \\\\  & ={1}^{2}+2(1)+b \\\\  & =1+2+b \\\\  & =b+3\\,.\\end{aligned}\n$$\n\nSince the left-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & =2 \\\\ b+3 & =2 \\\\ b & =2-3 \\\\ b & =-1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)={x}^{2}+cx+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{2}+cx+2) \\\\  & ={1}^{2}+c(1)+2 \\\\  & =1+c+2 \\\\  & =c+3\\,.\\end{aligned}\n$$\n\nSince the right-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & =2 \\\\ c+3 & =2 \\\\ c & =2-3 \\\\ c & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36743/b" "q-36743/c"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4014376-4dae-56f1-b981-b35d3afab874"] :knowledge-point/questions ["q-36743"] :db/ensure [:knowledge-point/validate]} {:db/id "q-138998/L/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "8f537e09-63db-5400-87d5-4d6e62003142" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-138998/L" :answer-field/id #uuid "c587d7f7-4217-5d39-b98b-a9d169ba528f" :answer-field/key "L" :answer-field/type :answer-field.type/blank :answer-field/correct "q-138998/L/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-138998/L/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-138998/root-test-conclusion/51fd10dbedb33ad93fd55b8f7c554f5a1c68a3c598ab8e5e39bb43bf80ec7a73" :answer/id #uuid "7c19157b-eb38-5696-a3ca-5384bdc4700d" :answer/type :answer.type/text :answer/value "Converges" :db/ensure [:answer/validate]} {:db/id "q-138998/root-test-conclusion/2f3c1dd1bc7b5e6c12fd1a66e58ffc5b07ff34b9ca432abacf624236100c14e4" :answer/id #uuid "dd52aa37-3a3c-5f61-9789-314e2311d72c" :answer/type :answer.type/text :answer/value "Diverges" :db/ensure [:answer/validate]} {:db/id "q-138998/root-test-conclusion/d2dfd0d89e8d2dabc06c50240848dc42ad276aa7beae0a7a9ad5b97c484aadcd" :answer/id #uuid "c8a60af4-dc48-5f40-a169-b2599e64fc50" :answer/type :answer.type/text :answer/value "Inconclusive" :db/ensure [:answer/validate]} {:db/id "q-138998/root-test-conclusion" :answer-field/id #uuid "97e027c5-fe4d-5d1e-8776-99ade5e46f52" :answer-field/key "root-test-conclusion" :answer-field/type :answer-field.type/select :answer-field/correct "q-138998/root-test-conclusion/d2dfd0d89e8d2dabc06c50240848dc42ad276aa7beae0a7a9ad5b97c484aadcd" :answer-field/choices ["q-138998/root-test-conclusion/51fd10dbedb33ad93fd55b8f7c554f5a1c68a3c598ab8e5e39bb43bf80ec7a73" "q-138998/root-test-conclusion/2f3c1dd1bc7b5e6c12fd1a66e58ffc5b07ff34b9ca432abacf624236100c14e4" "q-138998/root-test-conclusion/d2dfd0d89e8d2dabc06c50240848dc42ad276aa7beae0a7a9ad5b97c484aadcd"] :db/ensure [:answer-field/validate]} {:db/id "q-138998" :question/id #uuid "166ee2ec-2929-59e4-ac37-3903890f3dc2" :question/math-academy-id "q-138998" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{3{n}^{n}}{(1+n)^{n}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?\n\n$L$: {{L}}\n\nRoot test conclusion: {{root-test-conclusion}}" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{3{n}^{n}}{(1+n)^{n}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{3{n}^{n}}{(1+n)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\sqrt[n]{3}\\,n}{1+n} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\sqrt[n]{3}\\,n}{n(\\frac{1}{n}+1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\sqrt[n]{3}}{(\\frac{1}{n}+1)} \\\\  & =\\frac{1}{0+1} \\\\  & =1\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{3}=1.\n$$\n\nSince $L=1,$ the root test gives no conclusion." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-138998/L" "q-138998/root-test-conclusion"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cab29074-3281-5c02-9a2b-423077675aef"] :knowledge-point/questions ["q-138998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49841/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "38362d27-f96d-5548-bff5-1512c06ada80" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e1267788-fb64-575f-b20c-448bc0e42758" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0362b06e-efe4-545c-86bd-91cb1c3508c7" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "acbfefc2-a7e5-5a3b-b04b-4a73976e50af" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e0dac5b6-786f-5744-93c0-87b1055f2912" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "8644a362-1e72-5a40-acc5-710bc5a3bcd6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "5a35aa78-d547-5a55-8a2f-3f86e4c0afb5" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-49841/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "56f00260-986c-5669-a513-075f3979051c" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-49841/selection" :answer-field/id #uuid "32524753-7bf7-51bd-b7ec-0c1ce05625a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49841/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-49841/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-49841/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-49841/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-49841/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-49841/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-49841/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-49841/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-49841/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-49841" :question/id #uuid "f30cf6e1-a2f7-50a2-8c61-f5748c2a0e0f" :question/math-academy-id "q-49841" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true?\n\nI. - ${\\sum }_{n=100}^{\\infty }{a}_{n}$ is convergent\nII. - ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent\nIII. - $1\\,000{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent" :question/worked-solution "Let's recall the properties of convergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}=K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is also convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Removing a finite number of terms from a convergent series gives a convergent series.\n\n- Statement II is false. The sum of two convergent series is convergent.\n\n- Statement III is true. Any constant multiple of a convergent series gives a convergent series.\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d138d2c-3295-5eae-990d-42711f5792f1"] :knowledge-point/questions ["q-49841"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75637/answer/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "14059387-7cc6-5a22-93fe-ea7e7cf93cfa" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-75637/answer" :answer-field/id #uuid "2ce71eca-a2b1-5174-a2e2-8be1c786d9e7" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-75637/answer/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer-field/choices ["q-75637/answer/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a"] :db/ensure [:answer-field/validate]} {:db/id "q-75637" :question/id #uuid "64aca08e-6aad-5814-b106-f9f74dd6f182" :question/math-academy-id "q-75637" :question/problem "Consider the positive infinite geometric sequence that has a first term equal to $56$ and a third term equal to $\\frac{7}{8}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=56$ and ${a}_{3}=\\frac{7}{8}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{3-1} & =\\frac{(\\frac{7}{8})}{56} \\\\ {r}^{2} & =(\\frac{7}{8})(\\frac{1}{56}) \\\\ {r}^{2} & =\\frac{1}{64} \\\\ r & =\\sqrt{\\frac{1}{64}} \\\\ r & =\\frac{1}{8}\\end{aligned}\n$$\n\nNote that we have taken the positive square root since we're told that the sequence is positive.\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{56}{(1-\\frac{1}{8})} \\\\  & =\\frac{56}{(\\frac{7}{8})} \\\\  & =56(\\frac{8}{7}) \\\\  & =64.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75637/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e"] :knowledge-point/questions ["q-75637"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30612/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "92113b13-9afe-5b9c-9dad-982f3ab8fea1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "209c21c4-7e6b-5776-9119-77f75ea9f42b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "2f2fa861-14fc-5e57-8227-38e1af00edef" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7eef7db2-3ce0-5d08-970f-0e4cef942ffe" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c969f090-f90c-5e12-bfcb-3b0f97b43ade" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "de778815-cdbd-57af-b56c-86699d271222" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "620979e0-b1ef-525e-a283-e88692b6e5af" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-30612/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "b1be4ee3-a14c-54f0-9e69-0e8a5551cf51" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-30612/selection" :answer-field/id #uuid "0816cacf-8922-5aca-afbb-cbc4aa237440" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30612/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-30612/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-30612/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-30612/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-30612/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-30612/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-30612/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-30612/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-30612/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-30612" :question/id #uuid "5418831c-17ec-5431-913b-b0965c88ed86" :question/math-academy-id "q-30612" :question/problem "Which of the following statements are true regarding the function $y={log}_{2}x?$\n\nI. - The range is $y>0$\nII. - Its vertical asymptote is $x=2$\nIII. - It passes through the point $(2,1)$" :question/worked-solution "Let's plot the graph of $y={log}_{2}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fbc441f5915ef0dbe1e65ce1f748675e135ea8a2dc3a7d24dad56d55fca20eaf.png)\n\nLet's go through each statement.\n\n- Statement I is false. From the graph, we see that the range is all real numbers.\n\n- Statement II is false. The vertical asymptote is $x=0.$\n\n- Statement III is true. Substituting $x=2$ into the equation of the curve gives:\n\n$$\n\\begin{aligned}y & ={log}_{2}(2) \\\\  & ={log}_{2}({2}^{1}) \\\\  & =1\\,\\,✓\\end{aligned}\n$$\n\nIn conclusion, only statement III is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-30612/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f"] :knowledge-point/questions ["q-30612"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73306/answer/aa56327b5902f25e2f7d95c792ef03ce1de9c18c97e2a74df0ef0eb1b77ad0a2" :answer/id #uuid "4264b569-e7c0-555a-8ec9-c5a63046db75" :answer/type :answer.type/math :answer/value "127" :db/ensure [:answer/validate]} {:db/id "q-73306/answer" :answer-field/id #uuid "4738a03a-d5cd-5418-9836-3ec26a7ff4bd" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-73306/answer/aa56327b5902f25e2f7d95c792ef03ce1de9c18c97e2a74df0ef0eb1b77ad0a2" :answer-field/choices ["q-73306/answer/aa56327b5902f25e2f7d95c792ef03ce1de9c18c97e2a74df0ef0eb1b77ad0a2"] :db/ensure [:answer-field/validate]} {:db/id "q-73306" :question/id #uuid "a1680abc-bbec-518f-a962-a951e4463528" :question/math-academy-id "q-73306" :question/problem "The fifth term of a geometric series is $4$ and the sixth term is $2.$ What is the sum of the first $7$ terms?\n\nAnswer: {{answer}}" :question/worked-solution "The sum of the first $N$ terms of a geometric series is given by the formula\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r},\n$$\n\nwhere ${a}_{1}$ is the first term of the series, and $r$ is the common ratio.\n\nTo find $r,$ we find the ratio between the consecutive terms ${a}_{5}$ and ${a}_{6}:$\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{6}}{{a}_{5}} \\\\  & =\\frac{2}{4} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow we must determine the value of ${a}_{1}.$ To do this, we use the formula for the $n$th term, which states that\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1}.\n$$\n\nFor $n=5,$ we get:\n\n$$\n\\begin{aligned}{a}_{5} & ={a}_{1}\\cdot {(\\frac{1}{2})}^{5-1} \\\\ 4 & ={a}_{1}\\cdot {(\\frac{1}{2})}^{4} \\\\ 4 & ={a}_{1}\\cdot \\frac{1}{16} \\\\ {a}_{1} & =\\frac{4}{(\\frac{1}{16})} \\\\ {a}_{1} & =64\\end{aligned}\n$$\n\nFinally, if we substitute ${a}_{1}=64,N=7$ and $r=\\frac{1}{2}$ into the formula for ${S}_{N},$ we obtain:\n\n$$\n\\begin{aligned}{S}_{7} & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{1-\\frac{1}{2}} \\\\  & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{\\frac{1}{2}} \\\\  & =\\frac{64}{(\\frac{1}{2})}\\cdot (1-\\frac{1}{128}) \\\\  & =128(1-\\frac{1}{128}) \\\\  & =128-1 \\\\  & =127\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73306/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "11263ba1-2ef9-5c93-8c56-d09dcbea8f8b"] :knowledge-point/questions ["q-73306"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75961/answer/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "219ce7e5-8d95-57ca-a29e-117e34fb5649" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-75961/answer" :answer-field/id #uuid "25ca1f87-1e1d-58c4-8107-110f2c30036e" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-75961/answer/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer-field/choices ["q-75961/answer/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740"] :db/ensure [:answer-field/validate]} {:db/id "q-75961" :question/id #uuid "c7212979-12af-55e0-b574-fe7390124c7f" :question/math-academy-id "q-75961" :question/problem "Which value of $y$ satisfies the equation $\\frac{y+1}{{y}^{2}}=\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}}?$\n\nAnswer: {{answer}}" :question/worked-solution "We note that $y=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators ${y}^{2}$ and $2y.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}({y}^{2},2y)=2{y}^{2}.\n$$\n\nSo, we multiply both sides of the equation by $2{y}^{2},$ and simplify: \n\n$$\n\\begin{aligned}\\frac{y+1}{{y}^{2}} & =\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}} \\\\ 2{y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =2{y}^{2}\\cdot (\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}}) \\\\ 2{y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =2{y}^{2}\\cdot (\\frac{3}{2y})+2{y}^{2}\\cdot (\\frac{2y-1}{{y}^{2}}) \\\\ 2\\cdot {y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =y\\cdot 2y\\cdot (\\frac{3}{2y})+2\\cdot {y}^{2}\\cdot (\\frac{2y-1}{{y}^{2}}) \\\\ 2\\cdot \\cancel{{y}^{2}}\\cdot (\\frac{y+1}{\\cancel{{y}^{2}}}) & =y\\cdot \\cancel{2y}\\cdot (\\frac{3}{\\cancel{2y}})+2\\cdot \\cancel{{y}^{2}}\\cdot (\\frac{2y-1}{\\cancel{{y}^{2}}}) \\\\ 2(y+1) & =3y+2(2y-1)\\end{aligned}\n$$\n\nWe now have a linear equation in $y,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}2(y+1) & =3y+2(2y-1) \\\\ 2y+2 & =7y-2 \\\\ 7y-2y & =2+2 \\\\ 5y & =4 \\\\ y & =\\frac{4}{5}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $y=0$ as a solution. But since $y=\\frac{4}{5}\\ne 0,$ we conclude that the solution is $y=\\frac{4}{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75961/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c698912-1f35-5110-8d5d-d490cce2e9a7"] :knowledge-point/questions ["q-75961"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39273/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "004fcd5a-d9cd-5ef1-9566-8524db4dcaa1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d09abb86-4cb1-5d8a-81b3-f062a0ae6192" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "fe083ecf-90fd-5715-aac8-b2ee888d250f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ee09beba-184e-52a2-8655-5ddd98441138" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "68357f1e-38a3-5f15-ada5-2918d0749d0f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "203714a3-86e4-5086-a47e-056427b64a5f" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "3f39dc82-820e-5548-a0dd-c19e651b8a80" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-39273/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "32e51ac3-ebb0-5b54-8c8a-8c0e6a914bb7" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-39273/selection" :answer-field/id #uuid "2a811596-4561-58d6-aa4d-f28d49154dd6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39273/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-39273/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-39273/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-39273/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-39273/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-39273/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-39273/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-39273/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-39273/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-39273" :question/id #uuid "8c4a36da-599f-5664-ba9f-ac2ade1112ca" :question/math-academy-id "q-39273" :question/problem "For the curve $y=\\frac{1}{x},$ which of the following statements are true?\n\nI. - The domain of the function is $x\\in (-\\infty ,1)\\cup (1,\\infty ).$\nII. - The graph of the function passes through the point $(2,\\frac{1}{2}).$\nIII. - $y\\to -\\infty $ as $x\\to {0}^{+}.$" :question/worked-solution "First, let's sketch the graph of $y=\\frac{1}{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ffd98b8f9b6c7a9260f43772f9c654901bd02c21efa1eb06f2a5fdad8b263729.png)\n\nNow, we analyze each statement in turn.\n\n- Statement I is false. The function is defined on all real numbers except $0.$ So, the domain of the function is $x\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- Statement II is true. When $x=2,$ we get $y=\\frac{1}{2},$ so the point $(2,\\frac{1}{2})$ lies on the curve.\n\n- Statement III is false. From the graph, we see that $y\\to \\infty $ as $x\\to {0}^{+}.$\n\nIn conclusion, the correct answer is \"II only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-39273/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99c4151a-d2e0-5603-b27d-d81c76a0c7ba"] :knowledge-point/questions ["q-39273"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74505/answer/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "a464cdf4-38d9-50a8-8df7-ec69e984734d" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-74505/answer" :answer-field/id #uuid "bec393cc-fbfd-5b39-83c2-d0012450e168" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-74505/answer/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer-field/choices ["q-74505/answer/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458"] :db/ensure [:answer-field/validate]} {:db/id "q-74505" :question/id #uuid "41763944-ffc1-5cbe-ae34-8d6954078ad7" :question/math-academy-id "q-74505" :question/problem "The following table shows some values of a continuous function $f(x)$ over the interval $[2,12].$\n\n| $x$ | $2$ | $4$ | $8$ | $10$ | $12$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $3$ | $2$ | $1$ | $1$ |\n\nUse the left Riemann sum, with the four subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[2,12].$\n\nAnswer: {{answer}}" :question/worked-solution "In this case, we have $n=4$ rectangles. Using the left Riemann sum, the area is approximated as\n\n$$\nA\\approx f(2)Δ{x}_{1}+f(4)Δ{x}_{2}+f(8)Δ{x}_{3}+f(10)Δ{x}_{4},\n$$\n\nwhere each $Δ{x}_{i}$ is calculated by considering the step between a particular $x$-value and the next one, i.e.,\n\n$$\nΔ{x}_{i}={x}_{i+1}-{x}_{i}.\n$$\n\nWe set up a value table that includes the $Δx$'s.\n\n| $x$ | $2$ | $4$ | $8$ | $10$ | $12$ |\n| --- | --- | --- | --- | --- | --- |\n| $Δx$ | $2$ | $4$ | $2$ | $2$ | $-$ |\n| $f(x)$ | $5$ | $3$ | $2$ | $1$ | $1$ |\n\nFinally, we plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & \\approx 5\\cdot 2+3\\cdot 4+2\\cdot 2+1\\cdot 2 \\\\  & =10+12+4+2 \\\\  & =28.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74505/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "00d82333-e4e0-5527-a084-0af8affe5bee"] :knowledge-point/questions ["q-74505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72064/answer/0b264a929df91f183c31537acf560edd2114ab983879cbe61ea3aed58b55bda9" :answer/id #uuid "eee1d4ba-d69b-5847-a859-94521b94f113" :answer/type :answer.type/math :answer/value "55" :db/ensure [:answer/validate]} {:db/id "q-72064/answer" :answer-field/id #uuid "f22aac6e-74b5-5d2e-aa51-0c181d3d7ce6" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-72064/answer/0b264a929df91f183c31537acf560edd2114ab983879cbe61ea3aed58b55bda9" :answer-field/choices ["q-72064/answer/0b264a929df91f183c31537acf560edd2114ab983879cbe61ea3aed58b55bda9"] :db/ensure [:answer-field/validate]} {:db/id "q-72064" :question/id #uuid "71771640-36aa-5365-9496-11f66f198e7d" :question/math-academy-id "q-72064" :question/problem "The following table shows the number of customers per minute, $C(t),$ that arrive at a bank, measured over a period of $15$ minutes.\n\n| $t\\,\\text{(minutes)}$ | $0$ | $3$ | $7$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- |\n| $C(t)\\,\\text{(customers/minute)}$ | $3$ | $4$ | $3$ | $5$ | $2$ |\n\nUse the right Riemann sum over $[0,15]$ with four subintervals to approximate the total number of customers served.\n\nAnswer: {{answer}}" :question/worked-solution "Let $A$ denote the area under the curve $y=C(t)$ over $[0,15].$ In this case, we have $n=4$ rectangles. Using the right Riemann sum, the area is approximated as \n\n$$\nA\\approx C(3)Δ{t}_{1}+C(7)Δ{t}_{2}+C(12)Δ{t}_{3}+C(15)Δ{t}_{4},\n$$\n\nwhere each $Δ{t}_{i}$ is calculated by considering the step between a particular $t$-value and the previous one, i.e.,\n\n$$\nΔ{t}_{i}={t}_{i}-{t}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δt$'s.\n\n| $t$ | $0$ | $3$ | $7$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- |\n| $Δt$ | $-$ | $3$ | $4$ | $5$ | $3$ |\n| $C(t)$ | $-$ | $4$ | $3$ | $5$ | $2$ |\n\nWe plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & \\approx 4\\cdot 3+3\\cdot 4+5\\cdot 5+2\\cdot 3 \\\\  & =12+12+25+6 \\\\  & =55.\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total number of customers served over a period of $15$ minutes. So, the total number of customers is approximately\n$55.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72064/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ecb9df79-5227-5fc6-9a20-818fee34e971"] :knowledge-point/questions ["q-72064"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49568/selection/51fd10dbedb33ad93fd55b8f7c554f5a1c68a3c598ab8e5e39bb43bf80ec7a73" :answer/id #uuid "209fa5c5-1466-5ce7-a8d2-8973f26a4e1f" :answer/type :answer.type/text :answer/value "Converges" :db/ensure [:answer/validate]} {:db/id "q-49568/selection/2f3c1dd1bc7b5e6c12fd1a66e58ffc5b07ff34b9ca432abacf624236100c14e4" :answer/id #uuid "7493e4bf-895d-5e65-bb8f-bf2d383720b8" :answer/type :answer.type/text :answer/value "Diverges" :db/ensure [:answer/validate]} {:db/id "q-49568/selection" :answer-field/id #uuid "d20d3612-8f26-5ea3-b4eb-4ce596ec8c19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49568/selection/2f3c1dd1bc7b5e6c12fd1a66e58ffc5b07ff34b9ca432abacf624236100c14e4" :answer-field/choices ["q-49568/selection/51fd10dbedb33ad93fd55b8f7c554f5a1c68a3c598ab8e5e39bb43bf80ec7a73" "q-49568/selection/2f3c1dd1bc7b5e6c12fd1a66e58ffc5b07ff34b9ca432abacf624236100c14e4"] :db/ensure [:answer-field/validate]} {:db/id "q-49568" :question/id #uuid "71dac1d2-6ea4-558d-93e8-0311765a5a7d" :question/math-academy-id "q-49568" :question/problem "Consider the following sequence: \n\n$$\n{a}_{n+1}=-\\frac{5}{4}{a}_{n},\\,{a}_{1}=\\frac{1}{2},\\,n\\ge 1.\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{5}{4}.\n$$\n\nSince $|r|>1$, the sequence diverges." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49568/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d"] :knowledge-point/questions ["q-49568"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100631/answer/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "07010dc9-1e29-58cf-80ff-96a56d9fba1d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-100631/answer" :answer-field/id #uuid "b23ee9cc-4294-5159-9632-fc1db62d39ad" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-100631/answer/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-100631/answer/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-100631" :question/id #uuid "64cb2061-188e-5a28-a695-11fcdda45850" :question/math-academy-id "q-100631" :question/problem "If ${log}_{8}x+2{log}_{8}x=2$, then what is the value of  $x?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}{log}_{8}x+2{log}_{8}x & =2 \\\\ (1+2){log}_{8}x & =2 \\\\ 3{log}_{8}x & =2 \\\\ {log}_{8}x & =\\frac{2}{3}\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $8,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{8}x & =\\frac{2}{3} \\\\ {8}^{{log}_{8}x} & ={8}^{2/3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${8}^{{log}_{8}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={8}^{2/3} \\\\ x & =\\sqrt[3]{64} \\\\ x & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-100631/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423"] :knowledge-point/questions ["q-100631"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75001/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "252a4fbf-f54e-5ebb-bb5f-29468c0431d6" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-75001/answer" :answer-field/id #uuid "e6225757-a29d-5471-869e-ed7428c25f85" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-75001/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-75001/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-75001" :question/id #uuid "1a178c1c-f11d-5828-ae41-32c929e1c753" :question/math-academy-id "q-75001" :question/problem "Find $|r(\\frac{\\pi }{3})|$ given that $r(t)=⟨2\\operatorname{cos}t,\\,4\\operatorname{sin}t,\\,6⟩.$\n\nAnswer: {{answer}}" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨2\\operatorname{cos}(\\frac{\\pi }{3}),\\,4\\operatorname{sin}(\\frac{\\pi }{3}),\\,6⟩ \\\\  & =⟨2\\cdot \\frac{1}{2},\\,4\\cdot \\frac{\\sqrt{3}}{2},\\,6⟩ \\\\  & =⟨1,\\,2\\sqrt{3},\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(1)}^{2}+{(2\\sqrt{3})}^{2}+(6)^{2}} \\\\  & =\\sqrt{1+12+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75001/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6"] :knowledge-point/questions ["q-75001"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315758/answer/2569eadfee40e0d27b5537dd21d237233116da072dfeb349d6a28ee66ddb635a" :answer/id #uuid "e134657f-d454-513e-af3b-c71b4ee5796e" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id "q-315758/answer" :answer-field/id #uuid "b0195630-1fa8-58d5-b20c-3e9474d53208" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315758/answer/2569eadfee40e0d27b5537dd21d237233116da072dfeb349d6a28ee66ddb635a" :answer-field/choices ["q-315758/answer/2569eadfee40e0d27b5537dd21d237233116da072dfeb349d6a28ee66ddb635a"] :db/ensure [:answer-field/validate]} {:db/id "q-315758" :question/id #uuid "cf7ed733-de8f-586d-bd6c-3546abb19c44" :question/math-academy-id "q-315758" :question/problem "$$\n{\\begin{aligned}y=-{x}^{2}+2x-3 \\\\ y=1\\end{aligned}\n$$\n\nIf pairs $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2})$ with ${x}_{1}<{x}_{2}$ are the solutions of the system above, what is the value of ${x}_{2}{y}_{2}?$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No real solutions\"." :question/worked-solution "First, we set the equations equal and solve for $x:$\n\n$$\n\\begin{aligned}-{x}^{2}+2x-3 & =1 \\\\ -{x}^{2}+2x-4 & =0 \\\\ {x}^{2}-2x+4 & =0\\end{aligned}\n$$\n\nIn the obtained quadratic equation, we have\n\n$$\na=1,\\,b=-1\\cdot 2=-2,\\,c=4.\n$$\n\nSo, the discriminant of the quadratic is\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(1)(4) \\\\  & =-12<0.\\end{aligned}\n$$\n\nTherefore, the system has no real solutions." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-315758/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d14794db-8429-5f5e-a068-45966d4bf55d"] :knowledge-point/questions ["q-315758"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315755/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "24270c0b-f6b0-5152-ae02-d754880a56f1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-315755/field-1" :answer-field/id #uuid "98a056b0-c3d0-51d6-975b-20443215dccf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315755/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-315755/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-315755/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "624c7ae5-bd38-54aa-be9a-0a6d0ecf556a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-315755/field-2" :answer-field/id #uuid "f3042e9c-e647-5a95-81fb-10468ab91b70" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315755/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-315755/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-315755" :question/id #uuid "5d374218-4fc1-5b1c-b8fc-aa9ccc1df000" :question/math-academy-id "q-315755" :question/problem "$$\n{\\begin{aligned}x=4 \\\\ x={y}^{2}-10y+29\\end{aligned}\n$$\n\nFind the solution $(x,y)$ of the system above.\n\n$(x,y)=($ {{field-1}}$,$ {{field-2}} $)$" :question/worked-solution "First, we set the equations equal and solve for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-10y+29 & =4 \\\\ {y}^{2}-10y+25 & =0 \\\\ (y-5)^{2} & =0 \\\\ y-5 & =0 \\\\ y & =5\\end{aligned}\n$$\n\nNow, from the first equation, we get\n\n$$\nx=4.\n$$\n\nTherefore, the solution is $(4,5).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315755/field-1" "q-315755/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d14794db-8429-5f5e-a068-45966d4bf55d"] :knowledge-point/questions ["q-315755"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315767/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "8863d29b-8e2a-5286-91cf-0c76e316cc04" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-315767/field-1" :answer-field/id #uuid "19a2f6e8-62c3-5307-aadb-70d34d8a2037" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315767/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-315767/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-315767/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "42c10b4f-628c-5218-8d12-3cd70398ba78" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-315767/field-2" :answer-field/id #uuid "76364189-2634-5706-b8d4-09600bad3673" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315767/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-315767/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-315767" :question/id #uuid "68136187-6129-51e6-90fd-f5ffc38cff9b" :question/math-academy-id "q-315767" :question/problem "$$\n{\\begin{aligned}x=7 \\\\ x={y}^{2}+4y+11\\end{aligned}\n$$\n\nFind the solution $(x,y)$ of the system above.\n\n$(x,y)=($ {{field-1}}$,$ {{field-2}} $)$" :question/worked-solution "First, we set the equations equal and solve for $y:$\n\n$$\n\\begin{aligned}{y}^{2}+4y+11 & =7 \\\\ {y}^{2}+4y+4 & =0 \\\\ (y+2)^{2} & =0 \\\\ y+2 & =0 \\\\ y & =-2\\end{aligned}\n$$\n\nNow, from the first equation, we get\n\n$$\nx=7.\n$$\n\nTherefore, the solution is $(7,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315767/field-1" "q-315767/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d14794db-8429-5f5e-a068-45966d4bf55d"] :knowledge-point/questions ["q-315767"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315764/answer/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer/id #uuid "beecc13b-b00c-5d98-bd7b-d43e933947ee" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "q-315764/answer" :answer-field/id #uuid "91e13cb0-b368-5ecf-ad50-5a5f174af71b" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315764/answer/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer-field/choices ["q-315764/answer/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b"] :db/ensure [:answer-field/validate]} {:db/id "q-315764" :question/id #uuid "2e2cc1ac-6bdd-51c7-9e50-11f12536a850" :question/math-academy-id "q-315764" :question/problem "$$\n{\\begin{aligned}x={y}^{2}-3y \\\\ x=10\\end{aligned}\n$$\n\nIf pairs $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2})$ with ${y}_{1}<{y}_{2}$ are the solutions of the system above, what is the value of ${x}_{1}{y}_{2}?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we set the equations equal and solve for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-3y & =10 \\\\ {y}^{2}-3y-10 & =0 \\\\ (y-5)(y+2) & =0 \\\\ y & =-2,\\,5\\end{aligned}\n$$\n\nNow, from the second equation, we get\n\n$$\nx=10.\n$$\n\nTherefore, the solutions are \n\n$$\n({x}_{1},{y}_{1})=(10,-2)\\,\\text{and}\\,({x}_{2},{y}_{2})=(10,5).\n$$\n\nFinally, we have that\n\n$$\n{x}_{1}{y}_{2}=(10)\\cdot (5)=50.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-315764/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d14794db-8429-5f5e-a068-45966d4bf55d"] :knowledge-point/questions ["q-315764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315776/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "68a8f98f-9dff-58da-8426-3f2116ce5153" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-315776/answer" :answer-field/id #uuid "41185ab3-82a6-5e34-ba19-ade16b2c73b6" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315776/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-315776/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-315776" :question/id #uuid "96fa5c30-270f-5517-92f5-554b6af8cb5c" :question/math-academy-id "q-315776" :question/problem "$$\n{\\begin{aligned}x={y}^{2}-5y+6 \\\\ x=2y-4\\end{aligned}\n$$\n\nIf pairs $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2})$ with ${y}_{1}<{y}_{2}$ are the solutions of the system above, what is the value of ${x}_{1}{y}_{2}?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we set the equations equal and solve for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-5y+6 & =2y-4 \\\\ {y}^{2}-7y+10 & =0 \\\\ (y-5)(y-2) & =0 \\\\ y & =2,\\,5\\end{aligned}\n$$\n\nNow, we substitute $y$ in the second equation.\n\n- For ${y}_{1}=2,$ we get\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1}-4 \\\\  & =2(2)-4 \\\\  & =0.\\end{aligned}\n$$\n\n- For ${y}_{2}=5,$ we get\n\n$$\n\\begin{aligned}{x}_{2} & =2{y}_{2}-4 \\\\  & =2(5)-4 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the solutions are \n\n$$\n({x}_{1},{y}_{1})=(0,2)\\,\\text{and}\\,({x}_{2},{y}_{2})=(6,5).\n$$\n\nFinally, we have that\n\n$$\n{x}_{1}{y}_{2}=(0)\\cdot (5)=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-315776/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7462b733-2c06-5795-8e24-566752ec17c6"] :knowledge-point/questions ["q-315776"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315782/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "16fdb34f-cb52-52b3-8f12-8f1f4fc8cd02" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-315782/field-1" :answer-field/id #uuid "6309eafd-2539-5eeb-8a2f-fb33e08e5c13" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315782/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-315782/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-315782/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "50bdecd5-2ea0-5053-a2c9-36af6feb993a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-315782/field-2" :answer-field/id #uuid "873d2ca7-9ce3-5d5d-8074-201ffd7e6aa0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315782/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-315782/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-315782" :question/id #uuid "92e73856-4ae4-5727-a5f9-ecbb2cce4a26" :question/math-academy-id "q-315782" :question/problem "$$\n{\\begin{aligned}x={y}^{2}+y+5 \\\\ x=-3y+1\\end{aligned}\n$$\n\nFind the solution $(x,y)$ of the system above.\n\n$(x,y)=($ {{field-1}}$,$ {{field-2}} $)$" :question/worked-solution "First, we set the equations equal and solve for $y:$\n\n$$\n\\begin{aligned}{y}^{2}+y+5 & =-3y+1 \\\\ {y}^{2}+4y+4 & =0 \\\\ (y+2)^{2} & =0 \\\\ y+2 & =0 \\\\ y & =-2\\end{aligned}\n$$\n\nNow, we substitute this into the second equation:\n\n$$\n\\begin{aligned}x & =-3y+1 \\\\  & =-3(-2)+1 \\\\  & =7\\end{aligned}\n$$\n\nTherefore, the solution is $(7,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315782/field-1" "q-315782/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7462b733-2c06-5795-8e24-566752ec17c6"] :knowledge-point/questions ["q-315782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315861/answer/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "a501b122-c456-5b2c-befa-1a923f6cc418" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-315861/answer" :answer-field/id #uuid "b6f4edf2-6034-5d9e-8266-21ca7ae38846" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315861/answer/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer-field/choices ["q-315861/answer/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412"] :db/ensure [:answer-field/validate]} {:db/id "q-315861" :question/id #uuid "7f964985-f603-54e9-95ca-111340622232" :question/math-academy-id "q-315861" :question/problem "$$\n{\\begin{aligned}x=3{y}^{2}-4y \\\\ 8x-7{y}^{2}=5x\\end{aligned}\n$$\n\nIf $(x,y)$ is a solution of the system above such that $x\\ne 0$, what is the value of $x+y?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we simplify the second equation:\n\n$$\n\\begin{aligned}8x-7{y}^{2} & =5x \\\\ 3x-7{y}^{2} & =0 \\\\ 3x & =7{y}^{2}\\end{aligned}\n$$\n\nNext, from the first equation, we have\n\n$$\nx=3{y}^{2}-4y.\n$$\n\nWe substitute this into the second equation:\n\n$$\n\\begin{aligned}3x & =7{y}^{2} \\\\ 3(3{y}^{2}-4y) & =7{y}^{2} \\\\ 9{y}^{2}-12y & =7{y}^{2} \\\\ 2{y}^{2}-12y & =0 \\\\ {y}^{2}-6y & =0 \\\\ y(y-6) & =0 \\\\ y & =0,\\,6\\end{aligned}\n$$\n\nNow, we substitute $y$ in the first equation.\n\n- For ${y}_{1}=0,$ we get\n\n$$\n\\begin{aligned}{x}_{1} & =3{y}_{1}^{2}-4{y}_{1} \\\\  & =3(0)^{2}-4(0) \\\\  & =0.\\end{aligned}\n$$\n\n- For ${y}_{2}=6,$ we get\n\n$$\n\\begin{aligned}{x}_{2} & =3{y}_{2}^{2}-4{y}_{2} \\\\  & =3(6)^{2}-4(6) \\\\  & =108-24 \\\\  & =84.\\end{aligned}\n$$\n\nTherefore, the solutions are \n\n$$\n({x}_{1},{y}_{1})=(0,0)\\,\\text{and}\\,({x}_{2},{y}_{2})=(84,6).\n$$\n\nFinally, since we require the solution such that $x\\ne 0,$ we have that\n\n$$\n\\begin{aligned}x+y & ={x}_{2}+{y}_{2} \\\\  & =84+6 \\\\  & =90.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315861/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a39ca5b1-af43-5f27-ad5a-0ce75519d1aa"] :knowledge-point/questions ["q-315861"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315849/answer/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "5d9b33ea-d06b-56b0-adff-af0c3dfb8852" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-315849/answer" :answer-field/id #uuid "9ca2b466-3788-5505-b7ed-22b8c756e13b" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315849/answer/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer-field/choices ["q-315849/answer/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776"] :db/ensure [:answer-field/validate]} {:db/id "q-315849" :question/id #uuid "d43a11ff-b10a-5b65-9970-066e56ae225b" :question/math-academy-id "q-315849" :question/problem "$$\n{\\begin{aligned}y={x}^{2}-6x \\\\ 5{x}^{2}=2y\\end{aligned}\n$$\n\nIf $(x,y)$ is a solution of the system above such that $x\\ne 0$, what is the value of $x+y?$\n\nAnswer: {{answer}}" :question/worked-solution "From the first equation, we have\n\n$$\ny={x}^{2}-6x.\n$$\n\nWe substitute this into the second equation:\n\n$$\n\\begin{aligned}5{x}^{2} & =2y \\\\ 5{x}^{2} & =2({x}^{2}-6x) \\\\ 5{x}^{2} & =2{x}^{2}-12x \\\\ 3{x}^{2}+12x & =0 \\\\ x(3x+12) & =0 \\\\ x & =0,\\,-4\\end{aligned}\n$$\n\nNow, we substitute $x$ in the first equation.\n\n- For ${x}_{1}=0,$ we get\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1}^{2}-6{x}_{1} \\\\  & =(0)^{2}-6(0) \\\\  & =0.\\end{aligned}\n$$\n\n- For ${x}_{2}=-4,$ we get\n\n$$\n\\begin{aligned}{y}_{2} & ={x}_{2}^{2}-6{x}_{2} \\\\  & =(-4)^{2}-6(-4) \\\\  & =16+24 \\\\  & =40.\\end{aligned}\n$$\n\nTherefore, the solutions are \n\n$$\n({x}_{1},{y}_{1})=(0,0)\\,\\text{and}\\,({x}_{2},{y}_{2})=(-4,40).\n$$\n\nFinally, since we require the solution such that $x\\ne 0,$ we have that\n\n$$\n\\begin{aligned}x+y & ={x}_{2}+{y}_{2} \\\\  & =-4+40 \\\\  & =36.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-315849/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a39ca5b1-af43-5f27-ad5a-0ce75519d1aa"] :knowledge-point/questions ["q-315849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315865/answer/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "22f30778-fb53-5312-8841-e16de75ddb46" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-315865/answer" :answer-field/id #uuid "4dfff635-3e1f-572d-9f57-1ef58d08225b" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315865/answer/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-315865/answer/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c"] :db/ensure [:answer-field/validate]} {:db/id "q-315865" :question/id #uuid "e7347537-9022-5098-b0dd-a7d044f3e73e" :question/math-academy-id "q-315865" :question/problem "$$\n{\\begin{aligned}x={y}^{2}+2y \\\\ 4x-3{y}^{2}=2x\\end{aligned}\n$$\n\nIf $(x,y)$ is a solution of the system above such that $y\\ne 0$, what is the value of $x-y?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we simplify the second equation:\n\n$$\n\\begin{aligned}4x-3{y}^{2} & =2x \\\\ 2x-3{y}^{2} & =0 \\\\ 2x & =3{y}^{2}\\end{aligned}\n$$\n\nNext, from the first equation, we have\n\n$$\nx={y}^{2}+2y.\n$$\n\nWe substitute this into the second equation:\n\n$$\n\\begin{aligned}2x & =3{y}^{2} \\\\ 2({y}^{2}+2y) & =3{y}^{2} \\\\ 2{y}^{2}+4y & =3{y}^{2} \\\\ {y}^{2}-4y & =0 \\\\ y(y-4) & =0 \\\\ y & =0,\\,4\\end{aligned}\n$$\n\nNow, we substitute $y$ in the first equation.\n\n- For ${y}_{1}=0,$ we get\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}^{2}+2{y}_{1} \\\\  & =(0)^{2}+2(0) \\\\  & =0.\\end{aligned}\n$$\n\n- For ${y}_{2}=4,$ we get\n\n$$\n\\begin{aligned}{x}_{2} & ={y}_{2}^{2}+2{y}_{2} \\\\  & =(4)^{2}+2(4) \\\\  & =24.\\end{aligned}\n$$\n\nTherefore, the solutions are \n\n$$\n({x}_{1},{y}_{1})=(0,0)\\,\\text{and}\\,({x}_{2},{y}_{2})=(24,4).\n$$\n\nFinally, since we require the solution such that $y\\ne 0,$ we have that\n\n$$\n\\begin{aligned}x-y & ={x}_{2}-{y}_{2} \\\\  & =24-4 \\\\  & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315865/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a39ca5b1-af43-5f27-ad5a-0ce75519d1aa"] :knowledge-point/questions ["q-315865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-92985/y/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "4b93ea71-7aef-56db-9a46-7a8bf77de11e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-92985/y" :answer-field/id #uuid "5c0b24f9-bb9d-54de-beac-975884c53c1c" :answer-field/key "y" :answer-field/type :answer-field.type/blank :answer-field/correct "q-92985/y/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-92985/y/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-92985" :question/id #uuid "f44d5537-7cca-5193-b04b-aab03731cb25" :question/math-academy-id "q-92985" :question/problem "Find the equation of the horizontal asymptote of the function $f(x)={(\\frac{1}{2})}^{x-3}+4.$\n\n$y =$: {{y}}" :question/worked-solution "Let's plot the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/47d570c5b05096a0e8b7a13df510d8cd71dbee93dd2bf58dae18d7ff49ff1787.png)\n\nSince the function approaches the line $y=4$ as $x\\to \\infty ,$ we conclude that the equation of the horizontal asymptote is $y=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-92985/y"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a"] :knowledge-point/questions ["q-92985"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119781/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1e257669-4e9a-5bdf-ac9d-4e4a6c397131" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "921f2784-76d0-5de5-864d-763447c6080c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "e0ea8bdd-632d-58e0-af4b-0c93e0683c00" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "9e738797-cf84-5fab-a373-b7d0a87b64c5" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "9a4e067d-c9c5-5fa9-be76-b089673d2924" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "89efa4a6-0420-51af-a849-84e77d8affb5" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "69302e63-a57e-5396-acc9-6dc6cea005b7" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-119781/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "60c0e146-2c9a-5ce1-aaac-193318cd408e" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-119781/selection" :answer-field/id #uuid "9ca5971d-3642-5e78-b611-8e6d7d3ff936" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119781/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-119781/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-119781/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-119781/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-119781/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-119781/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-119781/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-119781/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-119781/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-119781" :question/id #uuid "d8bee717-f3b4-52d8-bbff-9f569aa6d04c" :question/math-academy-id "q-119781" :question/problem "Which of the following statements must be true regarding any tetrahedron? \n\nI. - It has $4$ congruent faces, each in the form of a right triangle\nII. - Exactly $3$ faces meet at each vertex\nIII. - It has $4$ edges" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/adcc202ad86b782fd153566d6454269dcd50e8f1d9aca37bc42d2266c142ced8.png)\n\nLet's examine our statements in turn.\n\n- Statement I is false, while statement II is true. A tetrahedron is a regular polyhedron that \n\n- consists of $4$ congruent faces, each in the form of an equilateral triangle (not a right triangle), and\n\n- exactly $3$ faces meet at each vertex.\n\n- Statement III is false. Since there are $F=4$ faces, each in the form of an equilateral triangle, we have\n\n$$\nS=4\\cdot 3=12\n$$\n\nsides combined. Now, each edge of the polyhedron is created when two face sides coincide. So, the number of edges of the tetrahedron must be equal to\n\n$$\n\\frac{S}{2}=\\frac{12}{2}=6.\n$$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119781/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9af57500-6329-5f59-8b4c-18637df93d90"] :knowledge-point/questions ["q-119781"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121431/coordinate-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8a4290b4-1179-5391-8878-df28a5c914bf" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-121431/coordinate-1" :answer-field/id #uuid "2c7eeb88-bccb-5e85-9269-bef59e4f4989" :answer-field/key "coordinate-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-121431/coordinate-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-121431/coordinate-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-121431/coordinate-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "da777ae6-b120-55f4-8b2d-e46ca4e39c92" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-121431/coordinate-2" :answer-field/id #uuid "ad0cdf20-74e2-5ba8-bf91-ba3ecd430859" :answer-field/key "coordinate-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-121431/coordinate-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-121431/coordinate-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-121431" :question/id #uuid "cf204f4e-b758-5c5a-b337-1b3550b1b5b3" :question/math-academy-id "q-121431" :question/problem "The point  $(0,1)$ lies on the curve $y=f(x+2).$ What points **must** lie on $y=-f(x)+2?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(0,1)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x+2).$\n\n- Then, we shift the graph horizontally $2$ unit to the right  and get the graph of $y=f(x).$ After this transformation, the point $(0,1)$ will be mapped to the point\n\n$$\n(0+2,1)=(2,1).\n$$\n\n- Next, to plot the graph of $y=-f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(2,1)$ will be mapped  to the point\n\n$$\n(2,-(1))=(2,-1).\n$$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=-f(x)+2.$ After this transformation, the point $(2,-1)$ will be mapped to the point \n\n$$\n(2,-1+2)=(2,1).\n$$\n\n**Method 2**\n\nSince the point $(0,1)$ lies on the graph of $y=f(x+2)$, we have that \n\n$$\nf(0+2)=1\\,⟹\\,f(2)=1.\n$$\n\nNow consider the graph of $y=-f(x)+2.$ Substituting $x=2$, we get\n\n$$\n\\begin{aligned}y & =-f(2)+2 \\\\  & =-(1)+2 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the point $(2,1)$ must lie on $y=-f(x)+2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121431/coordinate-1" "q-121431/coordinate-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed"] :knowledge-point/questions ["q-121431"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158546/coordinate-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "757ceea5-8485-572d-98f2-8cb47886efb2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-158546/coordinate-1" :answer-field/id #uuid "39489835-9589-58bd-9bad-441feaac60d4" :answer-field/key "coordinate-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-158546/coordinate-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-158546/coordinate-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-158546/coordinate-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "bb9424a8-f686-5da8-a145-a91ff0b23144" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-158546/coordinate-2" :answer-field/id #uuid "33a2d1a7-1d12-5bad-8745-cad969fa31d3" :answer-field/key "coordinate-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-158546/coordinate-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-158546/coordinate-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-158546" :question/id #uuid "9ce49de9-b37c-5069-a547-f0dd26c1d448" :question/math-academy-id "q-158546" :question/problem "The point  $(2,1)$ lies on the curve $y=f(x-2).$ What points **must** lie on $y=3-f(x)?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(2,1)$ on $y=f(x).$ Then, we find a corresponding point on $y=3-f(x):$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x-2).$\n\n- Then, we shift the graph horizontally $2$ units to the left and get the graph of $y=f(x).$ After this transformation, the point $(2,1)$ will be mapped to the point\n\n$$\n(2-2,1)=(0,1).\n$$\n\n- Next, to plot the graph of $y=3-f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(0,1)$ will be mapped  to the point\n\n$$\n(0,-(1))=(0,-1).\n$$\n\n- Next, we shift the result vertically by $3$ units up and obtain the graph of $y=3-f(x).$ After this transformation, the point $(0,-1)$ will be mapped to the point \n\n$$\n(0,-1+3)=(0,2).\n$$\n\n**Method 2**\n\nSince the point $(2,1)$ lies on the graph of $y=f(x-2)$, we have that \n\n$$\nf(2-2)=1\\,⟹\\,f(0)=1.\n$$\n\nNow consider the graph of $y=3-f(x).$ Substituting $x=0$, we get\n\n$$\n\\begin{aligned}y & =3-f(0) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the point $(0,2)$ must lie on $y=3-f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158546/coordinate-1" "q-158546/coordinate-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed"] :knowledge-point/questions ["q-158546"] :db/ensure [:knowledge-point/validate]} {:db/id "q-211287/coordinate-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "c5e182b6-70c4-58ac-8ad9-1fed5941e707" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-211287/coordinate-1" :answer-field/id #uuid "d8562ea8-b60f-5aab-8f71-8c5a505b05ec" :answer-field/key "coordinate-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-211287/coordinate-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-211287/coordinate-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-211287/coordinate-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "7471de03-1dd9-5e44-8b88-2757d3b13db9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-211287/coordinate-2" :answer-field/id #uuid "da23d844-cff0-5c78-a80e-fb76eedea37a" :answer-field/key "coordinate-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-211287/coordinate-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-211287/coordinate-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-211287" :question/id #uuid "4e52eb90-51ba-5a17-ba12-4144b8a682da" :question/math-academy-id "q-211287" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/282e65324ea1e7893da25ead1cc822c7c166df880c3aecc60face9adbbb7279a.png)\n\nThe diagram above shows the local minimum and maximum of the function $y=f(x).$ What is the local maximum of $y=f(x+3)-2?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Notice that the graph of $y=f(x+3)-2$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $3$ units to the left, and then\n\n- translating it by $2$ unit down.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the local maximum of $y=f(x)$ to the local maximum of $y=f(x+3)-2.$ So, we need to find the image of $(-2,6),$ the local maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=f(x+3)-2,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(-2,6).$\n\n- Then, we shift the graph horizontally by $3$ units to the left and get the graph of $y=f(x+3).$ After this transformation, the point $(-2,6)$ will be mapped to the point\n\n$$\n(-2-3,6)=(-5,6).\n$$\n\n- Finally, we shift the result vertically by $2$ units downward and get the graph of $y=f(x+3)-2.$ After this transformation, the point $(-5,6)$ will be mapped to the point\n\n$$\n(-5,6-2)=(-5,4).\n$$\n\nTherefore, the local maximum of $y=f(x+3)-2$ is $(-5,4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-211287/coordinate-1" "q-211287/coordinate-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8"] :knowledge-point/questions ["q-211287"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113092/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "3ba8a4f9-6db3-5c67-98b1-6ca1d1ca2f8b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-113092/answer" :answer-field/id #uuid "74321424-c74a-5f83-a2a8-7acffeed9912" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-113092/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-113092/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-113092" :question/id #uuid "ee249868-10fd-54ab-8257-c7e4ccf74f80" :question/math-academy-id "q-113092" :question/problem "Find the roots of $f(w)=\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w}.$\n\nAnswer: {{answer}}" :question/worked-solution "The roots of $f(w)$ are the solutions to the equation $f(w)=0.$ In our case, we have\n\n$$\n\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(w) & =\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w} \\\\  & =\\frac{(w+2)(w-5)}{2w(w-5)} \\\\  & =\\frac{(w+2)\\cancel{(w-5)}}{2w\\cancel{(w-5)}} \\\\  & =\\frac{(w+2)}{2w}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $w:$\n\n$$\n\\begin{aligned}w+2 & =0\\,⟹\\,w=-2\\end{aligned}\n$$\n\nTherefore, the solution to $f(w)=0$ is $w=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113092/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e77fe2f6-0e93-5378-aa8d-cc6d5122bdaa"] :knowledge-point/questions ["q-113092"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73010/x/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "09577c60-8054-58d0-be47-1caacaf6eec7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-73010/x" :answer-field/id #uuid "7180fa9b-38c7-591a-b8ac-d09b14278b51" :answer-field/key "x" :answer-field/type :answer-field.type/blank :answer-field/correct "q-73010/x/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-73010/x/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-73010" :question/id #uuid "87ee7e2c-2bbd-59c8-9b69-81310098b6e4" :question/math-academy-id "q-73010" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{2{x}^{2}-4x}{{x}^{2}-x-2}.$\n\n$x =$: {{x}}" :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}-4x}{{x}^{2}-x-2} & =\\frac{2x(x-2)}{(x-2)(x+1)} \\\\  & =\\frac{2x\\cancel{(x-2)}}{\\cancel{(x-2)}(x+1)} \\\\  & =\\frac{2x}{x+1}\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\nx+1=0\\,⟹\\,x=-1\n$$\n\nSo the *only* vertical asymptote is at $x=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73010/x"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463"] :knowledge-point/questions ["q-73010"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39802/root-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "f67911e8-8b1d-5d46-866b-cf157e0fa04f" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-39802/root-1" :answer-field/id #uuid "a4838539-8ac7-5fe3-98da-c19d4d040c6b" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-39802/root-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-39802/root-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-39802/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c68b2b34-ebf2-53f8-97aa-f1db5bbe7f2a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-39802/root-2" :answer-field/id #uuid "208f45e0-bf6c-5037-9987-d49ff6eb7dda" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-39802/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-39802/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-39802" :question/id #uuid "60689cc0-1330-59f8-9b56-7c01aabe3494" :question/math-academy-id "q-39802" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{2}-x-2}{{x}^{3}+7{x}^{2}-x-7}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-x-2}{{x}^{3}+7{x}^{2}-x-7} \\\\  & =\\frac{(x-2)(x+1)}{{x}^{2}(x+7)-(x+7)} \\\\  & =\\frac{(x-2)(x+1)}{({x}^{2}-1)(x+7)} \\\\  & =\\frac{(x-2)(x+1)}{(x-1)(x+1)(x+7)} \\\\  & =\\frac{(x-2)\\cancel{(x+1)}}{(x-1)\\cancel{(x+1)}(x+7)} \\\\  & =\\frac{x-2}{(x-1)(x+7)}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x-1)(x+7)=0\n$$\n\nThis gives the two solutions $x=-7$ and $x=1.$ Therefore, the equations of the vertical asymptotes are $x=-7$ and $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-39802/root-1" "q-39802/root-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d"] :knowledge-point/questions ["q-39802"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12218/answer/532a13a971f8b0d9936484312740e821ff23739d39d7e3f6d1971dbf5b2b4a98" :answer/id #uuid "8524199f-2925-5235-89c3-8465d5e71310" :answer/type :answer.type/math :answer/value "\\frac{45}{4}" :db/ensure [:answer/validate]} {:db/id "q-12218/answer" :answer-field/id #uuid "902ad4d0-cf99-5344-b4d5-6eeec1833710" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-12218/answer/532a13a971f8b0d9936484312740e821ff23739d39d7e3f6d1971dbf5b2b4a98" :answer-field/choices ["q-12218/answer/532a13a971f8b0d9936484312740e821ff23739d39d7e3f6d1971dbf5b2b4a98"] :db/ensure [:answer-field/validate]} {:db/id "q-12218" :question/id #uuid "3f53a0d5-edce-5e43-88e9-e77b8a039ddf" :question/math-academy-id "q-12218" :question/problem "Find the values of $k$ for which the quadratic equation $5{x}^{2}+15x+k=0$ has one distinct real solution.\n\nAnswer: {{answer}}" :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=5,$ $b=15,$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(15)^{2}-4(5)(k) \\\\  & =225-20k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D & =0 \\\\ 225-20k & =0 \\\\ 20k & =225 \\\\ k & =\\frac{225}{20} \\\\ k & =\\frac{45}{4}\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=\\frac{45}{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12218/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "452d826b-4cb3-56e1-989a-b025b5d5c955"] :knowledge-point/questions ["q-12218"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83538/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "26273ade-5abc-59f8-b122-160e069e014e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-83538/answer" :answer-field/id #uuid "c51d8f76-2247-5bc3-9f3c-9466b39e3049" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-83538/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-83538/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-83538" :question/id #uuid "57953432-f314-5c58-a78f-a4a5625bcfcb" :question/math-academy-id "q-83538" :question/problem "Consider the equation $-5{x}^{2}+2x-6=0.$ How many distinct real solutions does it have?\n\nAnswer: {{answer}}" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=-5,$ $b=2,$ and $c=-6,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={2}^{2}-4(-5)(-6) \\\\  & =4-120 \\\\  & =-116\\end{aligned}\n$$\n\nSince the discriminant is negative $(D<0),$ the equation has no real solutions." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83538/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f"] :knowledge-point/questions ["q-83538"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83542/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ae8c871a-c889-5bb8-a4e3-84cbe582680f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-83542/answer" :answer-field/id #uuid "9e953dff-9782-5a49-9384-c0b88716c9eb" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-83542/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-83542/answer/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-83542" :question/id #uuid "8708ad07-e7c1-511e-ad81-a624c1913f98" :question/math-academy-id "q-83542" :question/problem "Consider the equation ${x}^{2}-4x+5=0.$ How many distinct real solutions does it have?\n\nAnswer: {{answer}}" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=1,$ $b=-4,$ and $c=5,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-4)^{2}-4(1)(5) \\\\  & =16-20 \\\\  & =-4\\end{aligned}\n$$\n\nSince the discriminant is negative $(D<0),$ the equation has no real solutions." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83542/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f"] :knowledge-point/questions ["q-83542"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40557/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "e2d83f43-bead-5884-a214-46a07598b010" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3c32fe32-b4c1-5d28-b744-b61d6df8fb80" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "834befe2-9790-522c-88e2-21bab3cfb4d3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "af9b1eb3-e4bf-53ad-9334-b88c0e5eb5e1" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "8a0c63ab-5faa-55cc-86df-c63845487483" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "38f428ec-022d-558f-a672-63e49d96b225" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "ca8a3395-d6bb-562d-a159-c237ef1fe932" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-40557/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "e0e7f295-5b59-5aff-9608-0f0092cefe7b" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-40557/selection" :answer-field/id #uuid "ba7aa15e-4cac-5399-8271-9f448bc7cb70" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40557/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-40557/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-40557/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-40557/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-40557/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-40557/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-40557/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-40557/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-40557/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-40557" :question/id #uuid "9867e83c-9088-5ac6-b716-bd2e12f821e5" :question/math-academy-id "q-40557" :question/problem "Which of the following values ​are possible outputs of $f(x)=5{(2)}^{2x+1}-3?$\n\nI. - $-3$\nII. - $0$\nIII. - $3$" :question/worked-solution "The range of ${2}^{x}$ is \n\n$$\n{2}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{2}^{2x+1}>0.\n$$\n\nMultiplying the above inequality by $5$ and then subtracting $3,$ we get the following:\n\n$$\n\\begin{aligned}{2}^{2x+1} & >0 \\\\ 5(2)^{2x+1} & >0 \\\\ 5(2)^{2x+1}-3 & >0-3 \\\\ f(x) & >-3\\end{aligned}\n$$\n\nTherefore, the range is $f(x)>-3.$ Thus, of the given values, only $y=0$ and $y=3$ are outputs of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/27d552fe970877167abdcfd528c3dd6f517d9afb7ecf33d1eb00c8e8c2a332d7.png)\n\nSo, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40557/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0"] :knowledge-point/questions ["q-40557"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40796/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "e6157271-94a5-5f2d-aac5-c32cd9a60416" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "5e47c367-ce18-5083-a725-7bab0581569d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "c838cc0d-4303-5766-864d-aa1c4dc04040" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c552b19c-d3db-5d6c-9e64-40f372a6bd5a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "7ce0f1aa-ca34-51ba-842b-15b2eaccd753" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "52b5bb8e-e56f-5632-908f-fae9f97d87ff" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "3878df5a-fd9e-5894-b398-627dc8f169f3" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-40796/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "c6aa2a47-ee9b-580c-bb16-ac8bc99d9108" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-40796/selection" :answer-field/id #uuid "11e2a69c-fd58-538b-bd4f-6db8d91ddad1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40796/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-40796/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-40796/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-40796/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-40796/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-40796/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-40796/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-40796/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-40796/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-40796" :question/id #uuid "4e0d2420-7cc7-5265-8dd5-8dd2efd21696" :question/math-academy-id "q-40796" :question/problem "Which of the following values ​are possible outputs of  $f(x)=-3(3)^{2-x}-1?$\n\nI. - $-2$\nII. - $1$\nIII. - $2$" :question/worked-solution "The range of ${3}^{x}$ is \n\n$$\n{3}^{x}>0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Therefore,\n\n$$\n{3}^{2-x}>0.\n$$\n\nMultiplying the above inequality by $-3$ and then subtracting $1,$ we get the following: \n\n$$\n\\begin{aligned}{3}^{2-x}>0 \\\\ -3(3)^{2-x} & <0 \\\\ -3(3)^{2-x}-1 & <0-1 \\\\ f(x) & <-1\\end{aligned}\n$$\n\nTherefore, the range is $f(x)<-1.$ Thus, of the given values, only $y=-2$ is an   output of $y=f(x).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a40084132e9a34f28b151ed65812410ebef888e33b5394a5e3960996aff515ac.png)\n\nSo, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40796/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0"] :knowledge-point/questions ["q-40796"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212645/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c781a724-2216-56d6-8a67-d54c013b0f5e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-212645/field-1" :answer-field/id #uuid "6231c067-b769-524b-a4e9-4623983ecb54" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-212645/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-212645/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-212645/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "30b2a856-b4c8-5929-aca8-89d91652234b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-212645/field-2" :answer-field/id #uuid "90897e95-2725-5182-9f51-5b49b378ffe5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-212645/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-212645/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-212645" :question/id #uuid "73a3f870-37f5-5f13-aa37-93b9fd1e9ec7" :question/math-academy-id "q-212645" :question/problem "The midpoint of the line segment with endpoints $(2,5)$ and $(6,1)$ is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(2,5)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$ and ${{(6,1)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{2+6}{2},\\frac{5+1}{2}) \\\\  & =(\\frac{8}{2},\\frac{6}{2}) \\\\  & =(4,3).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-212645/field-1" "q-212645/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92c49ea0-7ec5-5ffc-8a36-c4f46f78fda7"] :knowledge-point/questions ["q-212645"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112849/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "15c4698d-ad65-523e-bee5-6a8a35c0bf9a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-112849/answer" :answer-field/id #uuid "31bc67ec-dff9-543a-85d5-e152981038ba" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-112849/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-112849/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-112849" :question/id #uuid "a95f3ae6-2de7-53c9-a211-7238246c0d4d" :question/math-academy-id "q-112849" :question/problem "Consider the quadratic equation $4{x}^{2}-12x+9=0.$ How many distinct real solutions does it have?\n\nAnswer: {{answer}}" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=4,$ $b=-12,$ and $c=9,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-12)^{2}-4(4)(9) \\\\  & =144-144 \\\\  & =0\\end{aligned}\n$$\n\nSince the discriminant is zero $(D=0),$ the equation has one distinct real solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112849/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f"] :knowledge-point/questions ["q-112849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39069/answer/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "8ae76a6d-e04f-580c-b80c-6fa055192eaf" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-39069/answer" :answer-field/id #uuid "644a2064-f413-5926-b152-af6d8ab6d2f8" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-39069/answer/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer-field/choices ["q-39069/answer/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea"] :db/ensure [:answer-field/validate]} {:db/id "q-39069" :question/id #uuid "9ec80876-92cf-51cb-8c78-67cced1a623f" :question/math-academy-id "q-39069" :question/problem "What is the index of the term $-75$ for the arithmetic sequence below?\n\n$$\n{a}_{n+1}={a}_{n}-3,\\,{a}_{1}=-3,\\,n\\ge 1\n$$\n\nAnswer: {{answer}}" :question/worked-solution "We will convert the recursive formula to an explicit formula and then solve for the value of $n$ such that ${a}_{n}=-75.$\n\nThe recursive rule for an arithmetic sequence takes the form\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn the given formula, we have $d=-3.$ We are also told that ${a}_{1}=-3,$ so we can write the explicit formula as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-3+(n-1)(-3) \\\\  & =-3-3n+3 \\\\  & =-3n\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ such that ${a}_{n}=-75:$\n\n$$\n\\begin{aligned}{a}_{n} & =-3n \\\\ -75 & =-3n \\\\ \\frac{-75}{-3} & =n \\\\ 25 & =n\\end{aligned}\n$$\n\nTherefore, $-75$ is the $25$th term of the sequence." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39069/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c61d587-2441-5e8c-8da1-5bd62ff98e1e"] :knowledge-point/questions ["q-39069"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123613/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "a6098340-0187-5a7f-9aef-4ef7822370e7" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-123613/answer" :answer-field/id #uuid "bfec4f74-076d-5fbe-8559-e517fb506b1f" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-123613/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-123613/answer/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-123613" :question/id #uuid "dee6a74e-ad8a-5ab7-a159-3c455cf4f602" :question/math-academy-id "q-123613" :question/problem "$\\operatorname{sec}(\\frac{2\\pi }{3})=$\n\nAnswer: {{answer}}" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{2\\pi }{3})=-\\frac{1}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{sec}(\\frac{2\\pi }{3})=\\frac{1}{\\operatorname{cos}(\\frac{2\\pi }{3})}=-2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123613/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d"] :knowledge-point/questions ["q-123613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84431/answer/46ae1c9078fe3049b835f645ecfb4cfcf6bf630435551cccacdef8c89dd152f9" :answer/id #uuid "57cdb069-ec17-5a57-807b-c34261e4751b" :answer/type :answer.type/math :answer/value "\\frac{8}{11}" :db/ensure [:answer/validate]} {:db/id "q-84431/answer" :answer-field/id #uuid "9f1ed6f6-03cf-5262-bad9-889b0d7a9848" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-84431/answer/46ae1c9078fe3049b835f645ecfb4cfcf6bf630435551cccacdef8c89dd152f9" :answer-field/choices ["q-84431/answer/46ae1c9078fe3049b835f645ecfb4cfcf6bf630435551cccacdef8c89dd152f9"] :db/ensure [:answer-field/validate]} {:db/id "q-84431" :question/id #uuid "eb776e32-2017-5cbf-b5c4-b276faf266d9" :question/math-academy-id "q-84431" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a5e4261d260faf531e7a0eecc95eed379009f238b99f6424e598ac42c27e7c64.png)\n\nConsider the sample space $S$ with the Venn diagram given above. What is $P({Y}^{'})?$\n\nAnswer: {{answer}}" :question/worked-solution "From the given Venn diagram, we have $P(Y)=3p$ and $P({Y}^{'})=8p.$\nTherefore,\n\n$$\n\\begin{aligned}P(Y)+P({Y}^{'}) & =1 \\\\ 3p+8p & =1 \\\\ 11p & =1 \\\\ p & =\\frac{1}{11}.\\end{aligned}\n$$\n\nConsequently, $P({Y}^{'})=8p=\\frac{8}{11}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84431/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fbb5348e-e292-513f-8b0a-90428692fc0a"] :knowledge-point/questions ["q-84431"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158540/coordinate-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "16fa0f68-bcc1-512b-94af-8147b5a24f01" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-158540/coordinate-1" :answer-field/id #uuid "e1178a48-950c-5de3-92d7-39990b834f2e" :answer-field/key "coordinate-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-158540/coordinate-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-158540/coordinate-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-158540/coordinate-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "0ab5f2fb-c4e9-501a-9315-d07cd5d66360" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-158540/coordinate-2" :answer-field/id #uuid "ef6514f4-4875-53cd-b442-402cf686bbec" :answer-field/key "coordinate-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-158540/coordinate-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-158540/coordinate-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-158540" :question/id #uuid "6721ce60-bfa1-58ad-aee6-895ef577c707" :question/math-academy-id "q-158540" :question/problem "The point $(-1,1)$ lies on the curve $y=f(x).$ What points **must** lie on $y=3f(x+2)?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nTo plot $y=3f(x+2),$ we apply the following steps: \n\n- First, we take the graph $y=f(x).$\n\n- Then, shift the graph horizontally by $2$ unit to the left and get the graph of \n$y=f(x+2).$  After this transformation, the point $(-1,1)$ will be mapped to the point\n\n$$\n(-1-2,1)=(-3,1).\n$$\n\n- Finally, we stretch the result by a scale factor of $3$ parallel to the y-axis and get the graph of \n$y=3f(x+2).$ After this transformation, the point $(-3,1)$ will be mapped to the point\n\n$$\n(-3,3\\cdot 1)=(-3,3).\n$$\n\n**Method 2**\n\nSince the point $(-1,1)$ lies on the graph of $y=f(x)$, we have that $f(-1)=1.$\n\nNow consider the graph of $y=3f(x+2).$ Substituting $x=-3$, we get\n\n$$\n\\begin{aligned}y & =3f(-3+2) \\\\  & =3f(-1) \\\\  & =3\\cdot 1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the point $(-3,3)$ must lie on $y=3f(x+2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158540/coordinate-1" "q-158540/coordinate-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785"] :knowledge-point/questions ["q-158540"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19761/answer/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "5e959508-8320-5502-aa8d-9f88703c7ad1" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-19761/answer" :answer-field/id #uuid "b98cecff-487d-58d4-a352-f3f4ae326137" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-19761/answer/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer-field/choices ["q-19761/answer/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee"] :db/ensure [:answer-field/validate]} {:db/id "q-19761" :question/id #uuid "f8cb7c22-3b81-59c8-9e12-cf4c433c9fb7" :question/math-academy-id "q-19761" :question/problem "Charlie goes to buy a bike. There are $8$ black bikes, $6$ white bikes, and $7$ silver bikes. How many choices of bike does Charlie have?\n\nAnswer: {{answer}}" :question/worked-solution "In order to find the total number of choices Charlie has, we can use the **rule of sum**:\n\n$$\n8+6+7=21\n$$\n\nTherefore, Charlie has $21$ choices of bike." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19761/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94cbd132-72fc-5645-bca3-9c81b6ac3845"] :knowledge-point/questions ["q-19761"] :db/ensure [:knowledge-point/validate]} {:db/id "q-533/answer/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "c1d65a6d-bf89-5a0a-82c2-a379c4c5fc50" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-533/answer" :answer-field/id #uuid "cf132198-cedf-5b46-8c37-ea64c36630bb" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-533/answer/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-533/answer/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-533" :question/id #uuid "85fc0f28-62f8-538e-bd6b-a85278b14b50" :question/math-academy-id "q-533" :question/problem "What is the value of ${\\text{i}}^{2}?$\n\nAnswer: {{answer}}" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore, we have that ${\\text{i}}^{2}=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-533/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46"] :knowledge-point/questions ["q-533"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102077/answer/1afec9881a25d2037170a03e304265a154579ebca45281d7646f8bd387a1524a" :answer/id #uuid "074fa524-3867-542a-b63f-1113e37be26d" :answer/type :answer.type/math :answer/value "{10}" :db/ensure [:answer/validate]} {:db/id "q-102077/answer" :answer-field/id #uuid "4623e151-7175-5517-b3ff-7afdb59a23b4" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-102077/answer/1afec9881a25d2037170a03e304265a154579ebca45281d7646f8bd387a1524a" :answer-field/choices ["q-102077/answer/1afec9881a25d2037170a03e304265a154579ebca45281d7646f8bd387a1524a"] :db/ensure [:answer-field/validate]} {:db/id "q-102077" :question/id #uuid "fde102b2-05fb-5f0b-a8aa-3b7a81681d73" :question/math-academy-id "q-102077" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e495695d9def7518780fb2b9e44f11e890da4c70c2dff7c6525936b2684219e1.png)\n\nGiven the sets $S={8,10,11}$ and $T={10,12,15},$ find $S\\cap T.$\n\nAnswer: {{answer}}" :question/worked-solution "The intersection $S\\cap T$ consists of all the elements that are in both $S$ and $T.$ To represent $S\\cap T,$ we will shade in all the area that is contained in both $S$ and $T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/5f807aaf7a026cc52f53f4a5f50afab269da5f2dfdcb835f6166891ada864f72.png)\n\nOnly the element $10$ is in both $S$ and $T.$ Therefore, the intersection of $S$ and $T$ is\n\n$$\nS\\cap T={10}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102077/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "953e79cf-c216-5d4b-a056-455f76e7fa87"] :knowledge-point/questions ["q-102077"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83535/answer/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "8d30ae83-830f-59b8-b0c6-ad96496b8c60" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-83535/answer" :answer-field/id #uuid "a5336a8b-4ba5-5097-900d-ae962c807fe8" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-83535/answer/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer-field/choices ["q-83535/answer/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-83535" :question/id #uuid "4b5fab31-45d0-51ce-8ef5-97f676669b2b" :question/math-academy-id "q-83535" :question/problem "Calculate the discriminant of the quadratic equation $2(x+2)^{2}-3=0.$\n\nAnswer: {{answer}}" :question/worked-solution "First, note that\n\n$$\n\\begin{aligned}2(x+2)^{2}-3 & =2({x}^{2}+4x+{2}^{2})-3 \\\\  & =2{x}^{2}+8x+8-3 \\\\  & =2{x}^{2}+8x+5.\\end{aligned}\n$$\n\nWe have $a=2,$ $b=8,$ and $c=5.$ So, we calculate the discriminant as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={8}^{2}-4(2)(5) \\\\  & =64-40 \\\\  & =24\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-83535/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87636457-bdd5-53dd-9137-c070a4e12e84"] :knowledge-point/questions ["q-83535"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112837/answer/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "c8ed3567-e2e2-5776-b081-4666187091d5" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-112837/answer" :answer-field/id #uuid "3f66180a-6c98-506d-b01a-627d14bd739f" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-112837/answer/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-112837/answer/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-112837" :question/id #uuid "6d21dfae-6d8c-52e5-8ced-deddffba77c1" :question/math-academy-id "q-112837" :question/problem "Calculate the discriminant of the quadratic equation $4{x}^{2}-3x=0.$\n\nAnswer: {{answer}}" :question/worked-solution "We have $a=4,$ $b=-3,$ and $c=0.$ So, we calculate the discriminant as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-3)^{2}-4(4)(0) \\\\  & =9-0 \\\\  & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112837/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87636457-bdd5-53dd-9137-c070a4e12e84"] :knowledge-point/questions ["q-112837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83537/answer/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2d36712e-7eca-5b2f-a624-7f2244a6921f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-83537/answer" :answer-field/id #uuid "be543a50-c5a0-5c72-b7ab-c5327fad3313" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-83537/answer/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-83537/answer/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-83537" :question/id #uuid "36f2b2bd-57ab-5e38-8592-4e4272a98493" :question/math-academy-id "q-83537" :question/problem "Consider the equation $-{x}^{2}-2x+7=0.$ How many distinct real solutions does it have?\n\nAnswer: {{answer}}" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=-1,$ $b=-2,$ and $c=7,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(-1)(7) \\\\  & =4+28 \\\\  & =32\\end{aligned}\n$$\n\nSince the discriminant is positive $(D>0),$ the equation has two distinct real solutions." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83537/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f"] :knowledge-point/questions ["q-83537"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112848/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "5afaf879-395b-53d8-8fb1-82cbf20f0b1c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-112848/answer" :answer-field/id #uuid "ecbbe986-b8f4-5dfd-8cb7-e10017d88391" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-112848/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-112848/answer/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-112848" :question/id #uuid "651268f9-ded3-54c1-9fe8-21b92e019084" :question/math-academy-id "q-112848" :question/problem "Consider the quadratic equation ${x}^{2}-6x+9=0.$ How many distinct real solutions does it have?\n\nAnswer: {{answer}}" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=1,$ $b=-6,$ and $c=9,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-6)^{2}-4(1)(9) \\\\  & =36-36 \\\\  & =0\\end{aligned}\n$$\n\nSince the discriminant is zero $(D=0),$ the equation has one distinct real solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112848/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f"] :knowledge-point/questions ["q-112848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10318/root-1/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer/id #uuid "aa8219dd-5426-535a-8746-a20de862801e" :answer/type :answer.type/math :answer/value "-60" :db/ensure [:answer/validate]} {:db/id "q-10318/root-1" :answer-field/id #uuid "cb5ec21e-e3fb-5152-965f-9a7b693fb214" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-10318/root-1/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer-field/choices ["q-10318/root-1/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454"] :db/ensure [:answer-field/validate]} {:db/id "q-10318/root-2/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "c77f485b-642c-5f6c-a6a5-59814eca6ecb" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-10318/root-2" :answer-field/id #uuid "17516546-529b-517f-a2ff-3650e714700d" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-10318/root-2/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-10318/root-2/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-10318" :question/id #uuid "a8ca7739-ac12-5a8f-a94e-0d532b4daccf" :question/math-academy-id "q-10318" :question/problem "Find the values of $k$ for which the quadratic equation $-15{x}^{2}+kx-60=0$  has one distinct real solution.\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=-15,$ $b=k,$ and $c=-60,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(k)^{2}-4(-15)(-60) \\\\  & ={k}^{2}-3\\,600\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D=0 \\\\ {k}^{2}-3600 & =0 \\\\ {k}^{2} & =3600 \\\\ k & =\\pm \\sqrt{3600} \\\\ k & =\\pm 60\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=\\pm 60.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10318/root-1" "q-10318/root-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "452d826b-4cb3-56e1-989a-b025b5d5c955"] :knowledge-point/questions ["q-10318"] :db/ensure [:knowledge-point/validate]} {:db/id "q-157982/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "99f81b75-1734-5fd0-bb7c-b9869b1723f3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-157982/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "020898bf-9988-5d10-90ea-8c9130f04e69" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-157982/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "cd3c4172-e661-5776-9d5f-2f7dda89e8be" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-157982/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "6a1ea6b8-c971-5fa6-893e-7075d3966731" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-157982/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "60a4c1e6-c071-57b7-a98c-bebcd5215080" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-157982/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "9246247b-5d70-5