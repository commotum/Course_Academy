 =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)!\\cdot (k+2)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)\\cdot (k+1)!\\cdot (k+2)\\cdot (k+1)!} \\\\  & =\\frac{\\cancel{(k+2)}\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+1)!}}{(k+2)\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+2)}\\cdot \\cancel{(k+1)!}} \\\\  & =\\frac{1}{k+2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73037/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0"] :knowledge-point/questions ["q-73037"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19882/selection/12a0a47c54c23ca336fbe87c8fa0e908e0398c37d532493a51519e17fbe5c7fe" :answer/id #uuid "6d4b7050-b0ec-506e-8d2d-3de366c66aef" :answer/type :answer.type/math :answer/value "(n+8)(n+9)" :db/ensure [:answer/validate]} {:db/id "q-19882/selection/1f4acfd5c1f810a2ce5cca7f6647f22f3f4529bae1b8481680a82125c345dcab" :answer/id #uuid "238bf615-e4f5-5bc6-8891-998d63d57915" :answer/type :answer.type/math :answer/value "(n+7)(n+8)(n+9)" :db/ensure [:answer/validate]} {:db/id "q-19882/selection/a23046526eabd22f6b5cd4f4163f3df2c0e4ad432e83f20ec7efde6b91285e0b" :answer/id #uuid "43d0cf0c-78ed-59b6-80b1-240f71aac532" :answer/type :answer.type/math :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/ensure [:answer/validate]} {:db/id "q-19882/selection/167151f4d2177f2990179162bccf546f866ae1b9ec8e7ce940cddd671b5b9c13" :answer/id #uuid "77002e1b-3856-5764-ac6e-3589194b4e01" :answer/type :answer.type/math :answer/value "(n-8)(n+8)(n+9)" :db/ensure [:answer/validate]} {:db/id "q-19882/selection/6f4c0fe757ddfe96cf1758f56f7397bfab7db508359ded3319bf6ab93925bb23" :answer/id #uuid "acbce194-3273-5052-9801-7566a12961bb" :answer/type :answer.type/math :answer/value "\\frac{n+9}{n-9}" :db/ensure [:answer/validate]} {:db/id "q-19882/selection" :answer-field/id #uuid "520f903f-cc0f-5087-a651-ef4c311135ef" :answer-field/key "selection" :answer-field/type :answer