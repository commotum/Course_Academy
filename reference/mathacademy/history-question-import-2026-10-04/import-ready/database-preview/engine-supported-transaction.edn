ion.difficulty/easy :question/answer-fields ["q-318377/field-1" "q-318377/field-2" "q-318377/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8f819127-1ab3-5a85-a381-9e30e32884aa"] :knowledge-point/questions ["q-318377"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100989/r1c1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "4572ec97-bfa4-5060-b8f4-cbf12f7c3e97" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-100989/r1c1" :answer-field/id #uuid "a47fbca2-eeb1-52f3-9480-f2d0f75bab35" :answer-field/key "r1c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-100989/r1c1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-100989/r1c1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-100989/r2c1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "ff6aa3ec-8276-54a8-b2c9-eaa021198cd3" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-100989/r2c1" :answer-field/id #uuid "ccd71f6f-8015-5fb7-b775-c33622baa306" :answer-field/key "r2c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-100989/r2c1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-100989/r2c1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-100989/r3c1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "4e2c1459-2e82-5849-8376-a3f7512617f0" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-100989/r3c1" :answer-field/id #uuid "6ceb37b1-8699-5b9c-9eba-dc3db48f29bf" :answer-field/key "r3c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-100989/r3c1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-100989/r3c1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-100989" :question/id #uuid "ca9737e4-6571-57db-8572-7d99e7234d46" :question/math-academy-id "q-100989" :question/problem "If $a=[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]$ and $b=j-3k$, then $a-3b=$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "First, notice that\n\n$$\nb=j-3k=[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}].\n$$\n\nTo compute $a-3b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-3b & =[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]-3\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]-[\\begin{aligned}0 \\\\ 3 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -8 \\\\ 11\\end{aligned}] \\\\  & =⟨-6,-8,11⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-100989/r1c1" "q-100989/r2c1" "q-100989/r3c1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0"] :knowledge-point/questions ["q-100989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70428/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "95dde01a-7a00-5394-bfa9-d342b6cdffff" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-70428/r1c1" :answer-field/id #uuid "8729ffcf-a958-5385-a30c-750049b75bc8" :answer-field/key "r1c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70428/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-70428/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-70428/r2c1/a0e0e68f25b8