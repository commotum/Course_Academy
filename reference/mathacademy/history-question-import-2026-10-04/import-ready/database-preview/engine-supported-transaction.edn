77d9669a26d349c343f77b" "q-117039/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-117039/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-117039/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-117039/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-117039/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-117039/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-117039/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0"] :db/ensure [:answer-field/validate]} {:db/id "q-117039" :question/id #uuid "4c2df21e-7d98-55cc-bb9d-c4c6dd3c0b6c" :question/math-academy-id "q-117039" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}x?$\n\nI. - $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$\nII. - $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3})$\nIII. - $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}x,$ meaning $a=\\operatorname{sin}b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-\\frac{\\sqrt{2}}{2})$  lies on the graph of $y=\\operatorname{sin}x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arcsin}x.$\n\n- Next, we consider the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{3},-\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{sin}x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{5\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arcsin}x.$\n\n- Finally, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\frac{\\sqrt{3}}{2})$ does **not** lie on the graph of $y=\\operatorname{sin}x.$ $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}x.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117039/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363"] :knowledge-point/questions ["q-117039"] :db/ensure [:knowledge-point/validate]} {:db/id "q-118782/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6c9a1d31-55dc-5cac-9de6-5d54020933fe" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-118782/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "81ccf827-073c-5b1e-8402-506130440329" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-118782/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "a3956880-699f-50c3-98e2-75b8a47f798d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-118782/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "89b70b1a-c0f9-503a-8b4f-420