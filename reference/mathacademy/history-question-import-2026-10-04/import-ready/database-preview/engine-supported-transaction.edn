d/validate]} {:db/id "q-278465/field-3/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "3a2ea4cf-4e02-5d81-9a2c-e35e147e2d11" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-278465/field-3/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "edf49be4-466c-5d14-8b4a-d8dd032a788a" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-278465/field-3" :answer-field/id #uuid "ee27fcfc-c49a-5f2d-ac9b-76d82cff94ff" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-278465/field-3/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer-field/choices ["q-278465/field-3/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" "q-278465/field-3/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc"] :db/ensure [:answer-field/validate]} {:db/id "q-278465" :question/id #uuid "ed24486a-03ba-53f0-a903-d0d663446f22" :question/math-academy-id "q-278465" :question/problem "Choose the appropriate signs for the table shown below.\n\n|  | $(-\\infty ,0)$ | $(0,15)$ | $(15,\\infty )$ |\n| --- | --- | --- | --- |\n| $x-15$ | {{field-1}} | {{field-2}} | {{field-3}} |" :question/worked-solution "- On the interval $(-\\infty ,0),$ we can choose a test point ${x}_{1}=-1.$ Then we have\n\n$$\n\\begin{aligned}x-15 & =-1-15=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,0)$ | $(0,15)$ | $(15,\\infty )$ |\n| --- | --- | --- | --- |\n| $x-15$ | $-$ |  |  |\n\n- On the interval $(0,15),$ we can choose a test point ${x}_{1}=10.$ Then we have\n\n$$\n\\begin{aligned}x-15 & =10-15=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,0)$ | $(0,15)$ | $(15,\\infty )$ |\n| --- | --- | --- | --- |\n| $x-15$ | $-$ | $-$ |  |\n\n- On the interval $(15,\\infty ),$ we can choose a test point ${x}_{1}=100.$ Then we have\n\n$$\n\\begin{aligned}x-15 & =100-15=(+),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,0)$ | $(0,15)$ | $(15,\\infty )$ |\n| --- | --- | --- | --- |\n| $x-15$ | $-$ | $-$ | $+$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278465/field-1" "q-278465/field-2" "q-278465/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b23c4da-7a8d-5076-a4e9-8bcde40bc088"] :knowledge-point/questions ["q-278465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-228899/field-1/bd880bfe641eb65607b9ea0762b46b0be52bb529e1b56dc443fc62fcdc997bc2" :answer/id #uuid "e388c577-7061-527f-99d6-695d6ff9b4ee" :answer/type :answer.type/math :answer/value "-0.527" :db/ensure [:answer/validate]} {:db/id "q-228899/field-1" :answer-field/id #uuid "cb92bf39-5411-5859-9598-c76250d50b5f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-228899/field-1/bd880bfe641eb65607b9ea0762b46b0be52bb529e1b56dc443fc62fcdc997bc2" :answer-field/choices ["q-228899/field-1/bd880bfe641eb65607b9ea0762b46b0be52bb529e1b56dc443fc62fcdc997bc2"] :db/ensure [:answer-field/validate]} {:db/id "q-228899" :question/id #uuid "dce75f1f-4e44-5de1-9b3a-5c377c4f3af9" :question/math-academy-id "q-228899" :question/problem "If ${e}^{2x+3}=7,$ then $x\\approx ${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{2x+3} & =7 \\\\ \\operatorname{ln}({e}^{2x+3}) & =\\operatorname{ln}(7) \\\\ 2x+3 & =\\operatorname{ln}(7) \\\\ 2x & =\\operatorname{ln}(7)-3 \\\\ x & =\\frac{\\operatorname{ln}(7)-3}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx\\approx -0.527\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-228899/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe"] :knowledge-point/questions ["q-228899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263084/field-1/0154f97974c660227b1521e9c3087ce249c7862632ac3e938a2a8627b06ef887" :answer/id #uuid "5447b780-0ab4-56b4-8a53-e99d01a5e05f" :answer/type :answer.type/math :answer/value "0.024" :db/ensure [:answer/validate]} {:db/id "q-263084/field-1" :answer-field/id #uuid "ad7f6d1f-e7da-5ee4-802b-8191318a5090" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263084/field-1/0154f97974c660227b1521e9c3087ce249c7862632ac3e938a2a8627b06ef887" :answer-field/choices ["q-263084/field-1/0154f97974c660227b1521e9c3087ce249c7862632ac3e938a2a8627b06ef887"] :db/ensure [:answer-field/validate]} {:db/id "q-263084" :question/id #uuid "d4fded30-6fdc-57c4-9ae4-833f7de89572" :question/math-academy-id "q-263084" :question/problem "If ${e}^{1-4x}=\\sqrt[3]{15},$ then $x\\approx ${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{1-4x} & =\\sqrt[3]{15} \\\\ \\operatorname{ln}({e}^{1-4x}) & =\\operatorname{ln}(\\sqrt[3]{15}) \\\\ 1-4x & =\\operatorname{ln}({15}^{1/3})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side and solve for $x:$\n\n$$\n\\begin{aligned}1-4x & =\\frac{1}{3}\\operatorname{ln}(15) \\\\ -4x & =\\frac{1}{3}\\operatorname{ln}(15)-1 \\\\ x & =-\\frac{1}{12}\\operatorname{ln}(15)+\\frac{1}{4}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx\\approx 0.024\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-263084/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe"] :knowledge-point/questions ["q-263084"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66901/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "119305f0-b1fe-5b2f-8e3b-0d6015572b29" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-66901/answer" :answer-field/id #uuid "06df9466-5754-5c36-a3e3-d7675a140094" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-66901/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-66901/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-66901" :question/id #uuid "c8d597e1-3a70-5551-8ca3-548ecbb3ddce" :question/math-academy-id "q-66901" :question/problem "Given that ${e}^{2h}-4=7,$ find the value of $h$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{2h}-4 & =7 \\\\ {e}^{2h} & =11\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $h:$\n\n$$\n\\begin{aligned}{e}^{2h} & =11 \\\\ \\operatorname{ln}({e}^{2h}) & =\\operatorname{ln}(11) \\\\ 2h & =\\operatorname{ln}(11) \\\\ h & =\\frac{1}{2}\\operatorname{ln}(11)\\end{aligned}\n$$\n\nTherefore, the solution is $h=\\frac{1}{2}\\operatorname{ln}(11)$\n\nEvaluating the above expression using a calculator gives\n\n$$\nh\\approx 1.199\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66901/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367"] :knowledge-point/questions ["q-66901"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66904/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8cc96152-4ed2-5310-8597-d190b5027215" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-66904/answer" :answer-field/id #uuid "4a59462f-4f5b-570c-b652-5baadec3debc" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-66904/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-66904/answer/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-66904" :question/id #uuid "6e5cb6a2-7bc8-5f55-bf93-6f94f39a879f" :question/math-academy-id "q-66904" :question/problem "Given that ${e}^{-7p}+3=8,$ find the value of $p$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{-7p}+3 & =8 \\\\ {e}^{-7p} & =5\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $p:$\n\n$$\n\\begin{aligned}{e}^{-7p} & =5 \\\\ \\operatorname{ln}({e}^{-7p}) & =\\operatorname{ln}(5) \\\\ -7p & =\\operatorname{ln}(5) \\\\ p & =-\\frac{1}{7}\\operatorname{ln}(5)\\end{aligned}\n$$\n\nTherefore, the solution is $p=-\\frac{1}{7}\\operatorname{ln}(5)$\n\nEvaluating the above expression using a calculator gives\n\n$$\np\\approx -0.230\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66904/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367"] :knowledge-point/questions ["q-66904"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72091/answer/6d31a666ee02795d0c02bbe5b07d885b2845fc6d9ccccaf683f642154afa4fdc" :answer/id #uuid "79cd8330-ab97-5903-b9f3-ef508c00087b" :answer/type :answer.type/text :answer/value "Dollars per point" :db/ensure [:answer/validate]} {:db/id "q-72091/answer" :answer-field/id #uuid "3810100f-eb13-58ea-9c35-58a116899722" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-72091/answer/6d31a666ee02795d0c02bbe5b07d885b2845fc6d9ccccaf683f642154afa4fdc" :answer-field/choices ["q-72091/answer/6d31a666ee02795d0c02bbe5b07d885b2845fc6d9ccccaf683f642154afa4fdc"] :db/ensure [:answer-field/validate]} {:db/id "q-72091" :question/id #uuid "dbe3b6c2-cec5-5e7c-9393-5197f7a69152" :question/math-academy-id "q-72091" :question/problem "A student's parents promise to reward her $R(p)$ dollars if she obtains an average of $p$ points in her exams. What are the units of $\\frac{\\text{d}R}{\\text{d}p}?$\n\nAnswer: {{answer}}\n\nWrite the units in the form \"[output units] per [input unit]\"." :question/worked-solution "We have that the student's reward $R(p)$ is measured in dollars and the average exam result is measured in points. \n\n$$\n\\begin{aligned}R(p): & \\text{dollars} \\\\ p: & \\text{points}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}R}{\\text{d}p}$ measures a change in $R(p)$ over a change in $p.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}R}{\\text{d}p}: & \\frac{\\text{dollars}}{\\text{points}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}R}{\\text{d}p}$ is measured in \"dollars per point\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72091/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791"] :knowledge-point/questions ["q-72091"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110040/answer/4bcb5d19fad838a5cc6ccb50a34369ad051e3e77e59aeb123a80cacddc346312" :answer/id #uuid "54f6f675-87c1-50bf-ae96-b0ca58aac52e" :answer/type :answer.type/text :answer/value "Visitors per hour" :db/ensure [:answer/validate]} {:db/id "q-110040/answer" :answer-field/id #uuid "316d870c-3af4-574b-8b2e-fc81731c9bcd" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-110040/answer/4bcb5d19fad838a5cc6ccb50a34369ad051e3e77e59aeb123a80cacddc346312" :answer-field/choices ["q-110040/answer/4bcb5d19fad838a5cc6ccb50a34369ad051e3e77e59aeb123a80cacddc346312"] :db/ensure [:answer-field/validate]} {:db/id "q-110040" :question/id #uuid "c773c57f-ca50-5bf6-b884-84eac176a3dd" :question/math-academy-id "q-110040" :question/problem "A website receives $v(h)$ visits every $h$ hours. What are the units of $\\frac{\\text{d}v}{\\text{d}h}?$\n\nAnswer: {{answer}}\n\nWrite the units in the form \"[output units] per [input unit]\"." :question/worked-solution "We have that the time $h$ is measured in hours and the number of visits is measured in visitors. \n\n$$\n\\begin{aligned}h: & \\text{hours} \\\\ v(h): & \\text{visitors}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}v}{\\text{d}h}$ measures a change in $v$ over a change in $h.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}h}: & \\frac{\\text{visitors}}{\\text{hours}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}v}{\\text{d}h}$ is measured in \"visitors per hour \"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110040/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791"] :knowledge-point/questions ["q-110040"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112382/answer/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "7d43a382-c034-5630-8dba-d0491c7e917d" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-112382/answer" :answer-field/id #uuid "57fa2f2d-5fc0-5725-9f07-9fc0207ec675" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-112382/answer/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer-field/choices ["q-112382/answer/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab"] :db/ensure [:answer-field/validate]} {:db/id "q-112382" :question/id #uuid "7a6d442f-4688-5203-a723-98f8e649492f" :question/math-academy-id "q-112382" :question/problem "After taking a pill containing $300$ milligrams of a particular drug, the quantity of the drug in a patient's body decreases at a rate of $c(t)=300\\cdot {2}^{-0.7t}$ milligrams per hour, where $t$ is the time, in hours, since the patient consumed the pill. What will be the rate of decrease after $5$ hours? Round your answer to the nearest integer.\n\nAnswer: {{answer}}" :question/worked-solution "Since we want to determine the rate of decrease in the quantity of the drug in the patient's body after $5$ hours, we have $t=5.$\n\nThus, the rate of decrease in the quantity of the drug after $5$ hours will be\n\n$$\n\\begin{aligned}c(5) & =300\\cdot {2}^{-0.7(5)} \\\\  & =300\\cdot {2}^{-3.5} \\\\  & \\approx 27.\\end{aligned}\n$$\n\nTherefore, the rate of decrease will be $27$ milligrams per hour." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112382/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-112382"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48608/answer/f01650d9d3e784f99019feb75b1bbaaa5567b401c6aeec01faa73c167bdca4ef" :answer/id #uuid "2781a87c-c459-54dd-ba3e-a5af81917eb6" :answer/type :answer.type/math :answer/value "640" :db/ensure [:answer/validate]} {:db/id "q-48608/answer" :answer-field/id #uuid "88dc04f0-ba52-595f-b804-826cb8ee5d73" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-48608/answer/f01650d9d3e784f99019feb75b1bbaaa5567b401c6aeec01faa73c167bdca4ef" :answer-field/choices ["q-48608/answer/f01650d9d3e784f99019feb75b1bbaaa5567b401c6aeec01faa73c167bdca4ef"] :db/ensure [:answer-field/validate]} {:db/id "q-48608" :question/id #uuid "9cc8a79a-7802-592e-80ef-d176d2e37ddd" :question/math-academy-id "q-48608" :question/problem "The birth rate of a krill population is modeled by $B(t)=5\\cdot {2}^{0.7t}$ thousands of tons per year, where $t$ is the time, in years, since $1998.$ What was the birth rate, in thousands of tons per year, for the krill in $2008?$\n\nAnswer: {{answer}}" :question/worked-solution "The function $B(t)$ models the birth rate for the krill, in thousands of tons, $t$ years since $1998.$ Since we want the birth rate in $2008$, then $t=10$ years.\n\nThus, the birth rate for the krill in $2008$ was\n\n$$\n\\begin{aligned}B(10) & =5\\cdot {2}^{0.7(10)} \\\\  & =5\\cdot {2}^{7} \\\\  & =640.\\end{aligned}\n$$\n\nTherefore, the birth rate for the krill in $2008$ was $640$ thousand tons per year." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-48608/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-48608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14121/answer/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "e0adb4eb-4e10-57f3-a3ac-5158e7bc1653" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-14121/answer" :answer-field/id #uuid "214026e5-fe18-58f7-8562-0bab5c37ec87" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-14121/answer/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-14121/answer/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-14121" :question/id #uuid "fe52eb5f-7e5b-51d0-b560-47f98d7ed314" :question/math-academy-id "q-14121" :question/problem "Find all the real solutions to the equation $3{z}^{3}-{z}^{2}+27z-9=0.$\n\nAnswer: {{answer}}" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}3{z}^{3}-{z}^{2}+27z-9 & = \\\\ (3{z}^{3}-{z}^{2})+(27z-9) & = \\\\ {z}^{2}(3z-1)+9(3z-1) & = \\\\ (3z-1)\\cdot {z}^{2}+(3z-1)\\cdot 9 & = \\\\ (3z-1)({z}^{2}+9) & .\\end{aligned}\n$$\n\nThen, we solve $(3z-1)({z}^{2}+9)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(3z-1)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}3z-1 & =0 \\\\ 3z & =1 \\\\ z & =\\frac{1}{3}.\\end{aligned}\n$$\n\n- Setting the factor $({z}^{2}+9)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{z}^{2}+9 & =0 \\\\ {z}^{2} & =-9.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${z}^{2}+9=0$ has no real solutions.\n\nTherefore,  $z=\\frac{1}{3}$ is the only real solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-14121/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "385b1ccd-ea68-5c59-a0e6-1a0bb7937460"] :knowledge-point/questions ["q-14121"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114210/root-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "e472f6af-282c-5f81-8a6f-aa842163264c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-114210/root-1" :answer-field/id #uuid "f6d70c21-c5c7-5a91-ad70-3da57be7affc" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-114210/root-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-114210/root-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-114210/root-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "38e65078-5b50-50dd-8580-957b11fe5c19" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-114210/root-2" :answer-field/id #uuid "e4280d61-9ff1-5d9c-a021-b2720a3231c9" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-114210/root-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-114210/root-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-114210/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "01c18fee-8168-5be8-b443-ccc5b402231c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-114210/root-3" :answer-field/id #uuid "771c2df9-b495-5230-a083-074b60a82938" :answer-field/key "root-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-114210/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-114210/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-114210" :question/id #uuid "62a71b17-2204-59c1-8d38-eaaccf24e868" :question/math-academy-id "q-114210" :question/problem "Solve $-{m}^{3}-3{m}^{2}+25m+75=0.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, we multiply the equation by $-1$ to make the coefficient of the cubic term positive. This gives\n\n$$\n{m}^{3}+3{m}^{2}-25m-75=0.\n$$\n\nWe then proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}{m}^{3}+3{m}^{2}-25m-75 & = \\\\ ({m}^{3}+3{m}^{2})+(-25m-75) & = \\\\ {m}^{2}(m+3)-25(m+3) & = \\\\ ({m}^{2}-25)(m+3) & = \\\\ (m+5)(m-5)(m+3)\\end{aligned}\n$$\n\nThen, we solve $(m+5)(m-5)(m+3)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(m+5)$ equal to $0,$ we get $m=-5.$\n\n- Setting the factor $(m-5)$ equal to $0,$ we get $m=5.$\n\n- Setting the factor $(m+3)$ equal to $0,$ we get $m=-3.$\n\nTherefore, the solutions are $m=-3,\\,\\pm 5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114210/root-1" "q-114210/root-2" "q-114210/root-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01d58dfd-315a-5a4f-ae16-1db04010169a"] :knowledge-point/questions ["q-114210"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332500/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "51848a55-9dcd-5809-8d1d-b784e728b2d6" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332500/field-1" :answer-field/id #uuid "8d6cd35c-99df-53bf-a223-b226bd97ad44" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332500/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-332500/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-332500" :question/id #uuid "c17df135-ee84-5f51-838d-783803b3c840" :question/math-academy-id "q-332500" :question/problem "Using the fact that ${120}^{∘}={150}^{∘}-{30}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}({120}^{∘}).$\n\n$\\operatorname{cos}({120}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(x-y)=\\operatorname{cos}x\\operatorname{cos}y+\\operatorname{sin}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for cosine with $x={150}^{∘}$ and $y={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}({120}^{∘}) & =\\operatorname{cos}({150}^{∘}-{30}^{∘}) \\\\  & =\\operatorname{cos}({150}^{∘})\\operatorname{cos}({30}^{∘})+\\operatorname{sin}({150}^{∘})\\operatorname{sin}({30}^{∘}) \\\\  & =(-\\frac{\\sqrt{3}}{2})\\cdot \\frac{\\sqrt{3}}{2}+\\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{3}{4}+\\frac{1}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332500/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85"] :knowledge-point/questions ["q-332500"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120036/answer/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "c946f316-e0f1-528f-b04f-487fc62bc3a1" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-120036/answer" :answer-field/id #uuid "df3ccf03-d2f1-511e-9dd1-7c82faa09dd6" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-120036/answer/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-120036/answer/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-120036" :question/id #uuid "8d593e11-f74c-57da-a9e4-9637db488d53" :question/math-academy-id "q-120036" :question/problem "Find the exact value of ${(\\operatorname{sin}({165}^{∘})-\\operatorname{cos}({165}^{∘}))}^{2}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}({165}^{∘})-\\operatorname{cos}({165}^{∘}))}^{2} & ={sin}^{2}({165}^{∘})-2\\operatorname{sin}({165}^{∘})\\operatorname{cos}({165}^{∘})+{cos}^{2}({165}^{∘}) \\\\  & =[{sin}^{2}({165}^{∘})+{cos}^{2}({165}^{∘})]-2\\operatorname{sin}({165}^{∘})\\operatorname{cos}({165}^{∘}) \\\\  & =1-2\\operatorname{sin}({165}^{∘})\\operatorname{cos}({165}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}x\\operatorname{cos}x=\\operatorname{sin}2x\n$$\n\nSubstituting $x={165}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}({165}^{∘})\\operatorname{cos}({165}^{∘}) & =\\operatorname{sin}(2\\cdot {165}^{∘}) \\\\  & =\\operatorname{sin}({330}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1-2\\operatorname{sin}({165}^{∘})\\operatorname{cos}({165}^{∘})=1-(-\\frac{1}{2})=\\frac{3}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}({165}^{∘})+\\operatorname{cos}({165}^{∘}))}^{2}=\\frac{3}{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120036/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-120036"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120087/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "88ed0792-cb18-51e5-a9a3-54d22711fc17" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-120087/answer" :answer-field/id #uuid "127575f2-8f92-59b9-afdf-8307dff9b6e4" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-120087/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-120087/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-120087" :question/id #uuid "72bde4a1-d04b-50b4-bd0e-183a00744709" :question/math-academy-id "q-120087" :question/problem "$10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘})=$\n\nAnswer: {{answer}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}x\\operatorname{cos}x=\\operatorname{sin}2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘}) & =\\operatorname{sin}(2\\cdot {75}^{∘})=\\operatorname{sin}({150}^{∘})\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}10\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})\\operatorname{csc}({150}^{∘}) & =5\\cdot [2\\operatorname{sin}({75}^{∘})\\operatorname{cos}({75}^{∘})]\\operatorname{csc}({150}^{∘}) \\\\  & =5\\operatorname{sin}({150}^{∘})\\cdot \\frac{1}{\\operatorname{sin}({150}^{∘})} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120087/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf"] :knowledge-point/questions ["q-120087"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71778/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "adee0ecc-80f7-537c-884d-c7171e95523e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-71778/root-1" :answer-field/id #uuid "aa901033-8b8a-5397-a5eb-b35c081d2689" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-71778/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-71778/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-71778/root-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d2bf68f7-8f17-5d48-a0c8-4753c3310bc5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-71778/root-2" :answer-field/id #uuid "2113cfb0-dcde-5210-8cf3-60a45e92f9f7" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-71778/root-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-71778/root-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-71778/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "1e5ee175-51be-52ac-916b-773e369a6a66" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-71778/root-3" :answer-field/id #uuid "228f0d78-7b41-5269-8680-1df663ae7c7c" :answer-field/key "root-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-71778/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-71778/root-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-71778" :question/id #uuid "56a901dc-9638-58ff-af9a-f87cff2b0a14" :question/math-academy-id "q-71778" :question/problem "Solve the equation $5{z}^{3}-35{z}^{2}+50z=0.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, notice that all of the terms of the polynomial have a common factor of $5z.$ We can factor out the $5z$ as follows:\n\n$$\n\\begin{aligned}5{z}^{3}-35{z}^{2}+50z & =0 \\\\ 5z({z}^{2}-7z+10) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${z}^{2}-7z+10$ as follows:\n\n$$\n\\begin{aligned}5z({z}^{2}-7z+10) & =0 \\\\ 5z(z-2)(z-5) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $z=0,$ $z=2,$ and $z=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71778/root-1" "q-71778/root-2" "q-71778/root-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e25f87c9-3f2e-59a6-ad45-66f0640e68ef"] :knowledge-point/questions ["q-71778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3984/root-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "3105e6bd-21ef-530e-8e10-b909bcf733ba" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-3984/root-1" :answer-field/id #uuid "19d0e142-f90c-5c63-b1c3-353684dc6988" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-3984/root-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-3984/root-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-3984/root-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d23d4977-ec9c-564b-99ba-5632e8a3c200" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-3984/root-2" :answer-field/id #uuid "3351ea0b-eeff-5f58-becd-56fbf08f3f13" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-3984/root-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-3984/root-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-3984/root-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "0700acea-40cc-5401-9f43-345fa1a20bad" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-3984/root-3" :answer-field/id #uuid "003a3369-96ec-559a-9958-0a3c80649b81" :answer-field/key "root-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-3984/root-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-3984/root-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-3984" :question/id #uuid "423dad75-ec6d-59c5-bce2-1028414952c4" :question/math-academy-id "q-3984" :question/problem "Solve for $m$ where $2{m}^{3}-5{m}^{2}-18m=2{m}^{2}+{m}^{3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(m)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}2{m}^{3}-5{m}^{2}-18m & =2{m}^{2}+{m}^{3} \\\\ {m}^{3}-5{m}^{2}-18m & =2{m}^{2} \\\\ {m}^{3}-7{m}^{2}-18m & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $m.$ We can factor out the $m$ as follows:\n\n$$\n\\begin{aligned}{m}^{3}-7{m}^{2}-18m & =0 \\\\ m({m}^{2}-7m-18) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${m}^{2}-7m-18$ as follows:\n\n$$\n\\begin{aligned}m({m}^{2}-7m-18) & =0 \\\\ m(m+2)(m-9) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $m=0,$ $m=-2,$ and $m=9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-3984/root-1" "q-3984/root-2" "q-3984/root-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f2d12ff-f760-5c03-88c0-2b7088eb5fb2"] :knowledge-point/questions ["q-3984"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13468/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "14655ff6-bf2e-5fab-b23c-0740cbced876" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-13468/root-1" :answer-field/id #uuid "5c144115-70f1-5567-83f5-e0fb71d3f663" :answer-field/key "root-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-13468/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-13468/root-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-13468/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "35b6d5ca-5b61-555f-a534-35ad85260dc8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-13468/root-2" :answer-field/id #uuid "71df7fd7-7b26-5c2d-8809-b504f56db558" :answer-field/key "root-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-13468/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-13468/root-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-13468/root-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "24dc3cdc-0c4d-5ea2-8e04-f8924a82a9d8" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-13468/root-3" :answer-field/id #uuid "442f30a8-7af7-5011-bb14-90b9a46d8c25" :answer-field/key "root-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-13468/root-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-13468/root-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-13468" :question/id #uuid "73b7efc6-6b1f-5e8e-b511-0bc919992361" :question/math-academy-id "q-13468" :question/problem "Determine the real roots of the cubic equation $2{x}^{3}-40{x}^{2}+35x=-3{x}^{3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}2{x}^{3}-40{x}^{2}+35x=-3{x}^{3} \\\\ 5{x}^{3}-40{x}^{2}+35x & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $5x.$ We can factor out the $5x$ as follows:\n\n$$\n\\begin{aligned}5{x}^{3}-40{x}^{2}+35x & =0 \\\\ 5x({x}^{2}-8x+7) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${x}^{2}-8x+7$ as follows:\n\n$$\n\\begin{aligned}5x({x}^{2}-8x+7) & =0 \\\\ 5x(x-1)(x-7) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $x=0,$ $x=1,$ and $x=7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13468/root-1" "q-13468/root-2" "q-13468/root-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f2d12ff-f760-5c03-88c0-2b7088eb5fb2"] :knowledge-point/questions ["q-13468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70355/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "e2ba21c6-5dbd-5441-a3ab-86955663155a" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-70355/answer" :answer-field/id #uuid "cd0f09be-093c-5e06-af95-ab99aea76101" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70355/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-70355/answer/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-70355" :question/id #uuid "deb08641-7369-57ac-a4cc-afb3b4f81d58" :question/math-academy-id "q-70355" :question/problem "$\\frac{14}{a}÷\\frac{7}{b}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute\n\n$$\n\\frac{14}{a}÷\\frac{7}{b},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14}{a}÷\\frac{7}{b} & = \\\\ \\frac{14}{a}\\cdot \\frac{b}{7} & = \\\\ \\frac{14b}{7a} & = \\\\ \\frac{2\\cdot \\cancel{7}\\cdot b}{\\cancel{7}a} & = \\\\ \\frac{2b}{a} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $7$ in the numerator and denominator." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70355/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2"] :knowledge-point/questions ["q-70355"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5174/answer/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "5e1cdbb0-3158-56a8-8bf1-b12a39213539" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-5174/answer" :answer-field/id #uuid "afb138c8-d5fe-521b-a16b-e38a7fd1ad20" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-5174/answer/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-5174/answer/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-5174" :question/id #uuid "51e5f7cc-f758-5b6e-9b53-61015feb7246" :question/math-academy-id "q-5174" :question/problem "If ${log}_{2}x=3$, then what is $x?$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $2,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{2}x & =3 \\\\ {2}^{{log}_{2}x} & ={2}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${2}^{{log}_{2}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={2}^{3} \\\\ x & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-5174/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5fd76722-397f-564f-b592-52156e86ddc0"] :knowledge-point/questions ["q-5174"] :db/ensure [:knowledge-point/validate]} {:db/id "q-914/answer/bf9a21fe4dc212a46e36120707112677355d58d140bf05555ecb2406d2818099" :answer/id #uuid "64a61867-194c-5c5b-8079-5ef39b6bec38" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "q-914/answer" :answer-field/id #uuid "37ba8d5d-39aa-537d-aaed-64ef93471dd2" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-914/answer/bf9a21fe4dc212a46e36120707112677355d58d140bf05555ecb2406d2818099" :answer-field/choices ["q-914/answer/bf9a21fe4dc212a46e36120707112677355d58d140bf05555ecb2406d2818099"] :db/ensure [:answer-field/validate]} {:db/id "q-914" :question/id #uuid "3f443508-b423-5aae-b226-2edd43a6873e" :question/math-academy-id "q-914" :question/problem "If $\\operatorname{log}y=3$, then $y=$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the common logarithm is $10,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{log}y & =3 \\\\ {log}_{10}y & =3 \\\\ {10}^{{log}_{10}y} & ={10}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${10}^{{log}_{10}y}=y.$\n\nTherefore,\n\n$$\n\\begin{aligned}y & ={10}^{3} \\\\ y & =1\\,000.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-914/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5fd76722-397f-564f-b592-52156e86ddc0"] :knowledge-point/questions ["q-914"] :db/ensure [:knowledge-point/validate]} {:db/id "q-25135/answer/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "04455bff-31a6-5ffd-a084-e383ce9ea690" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "q-25135/answer" :answer-field/id #uuid "0be4f470-3937-507a-9f89-cd41aeeee049" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-25135/answer/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer-field/choices ["q-25135/answer/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a"] :db/ensure [:answer-field/validate]} {:db/id "q-25135" :question/id #uuid "22cd672b-7580-5f3f-b0e8-4ada6eb0f6d5" :question/math-academy-id "q-25135" :question/problem "Find $x$ such that ${log}_{4}(3x-2)=3.$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}(3x-2) & =3 \\\\ {4}^{{log}_{4}(3x-2)} & ={4}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}(3x-2)}=3x-2.$\n\nTherefore,\n\n$$\n\\begin{aligned}3x-2 & ={4}^{3} \\\\ 3x-2 & =64 \\\\ 3x & =66 \\\\ x & =22.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-25135/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98fb5d45-5215-506c-8b2a-99aaadb6631c"] :knowledge-point/questions ["q-25135"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79380/answer/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "90560ae3-56f4-52be-a0b1-acd9dd6e99b2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-79380/answer" :answer-field/id #uuid "7bb5e72b-9a4d-5593-8f5b-f183f0e6e8a7" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-79380/answer/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-79380/answer/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-79380" :question/id #uuid "036e1450-c076-5d46-8a8b-161ca824e7b5" :question/math-academy-id "q-79380" :question/problem "If ${log}_{9}(2y-3)=1$, then $y=$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $9,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{9}(2y-3) & =1 \\\\ {9}^{{log}_{9}(2y-3)} & ={9}^{1}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${9}^{{log}_{9}(2y-3)}=2y-3.$\n\nTherefore,\n\n$$\n\\begin{aligned}2y-3 & =9 \\\\ 2y & =12 \\\\ y & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79380/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98fb5d45-5215-506c-8b2a-99aaadb6631c"] :knowledge-point/questions ["q-79380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70018/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "02211a15-7355-5260-8fcb-254354108bd0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-70018/answer" :answer-field/id #uuid "7d747a78-d797-5920-a99b-727c7561455e" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70018/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-70018/answer/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-70018" :question/id #uuid "6670ae0c-7bd3-5be8-8afd-7e9eadd30b6f" :question/math-academy-id "q-70018" :question/problem "If $6{log}_{4}(x+11)=12$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}6{log}_{4}(x+11) & =12 \\\\ {log}_{4}(x+11) & =\\frac{12}{6} \\\\ {log}_{4}(x+11) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}(x+11) & =2 \\\\ {4}^{{log}_{4}(x+11)} & ={4}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}(x+11)}=x+11.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+11 & ={4}^{2} \\\\ x+11 & =16 \\\\ x & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70018/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78"] :knowledge-point/questions ["q-70018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70017/answer/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer/id #uuid "ef22657b-07c2-55e8-850e-53f5cacb390e" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "q-70017/answer" :answer-field/id #uuid "b50d5e7f-236c-51dc-af70-45c7389804d0" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70017/answer/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer-field/choices ["q-70017/answer/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9"] :db/ensure [:answer-field/validate]} {:db/id "q-70017" :question/id #uuid "513d3cec-982b-533e-81bb-8c54a8125de4" :question/math-academy-id "q-70017" :question/problem "If ${log}_{3}(x-6)+5=8$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}{log}_{3}(x-6)+5 & =8 \\\\ {log}_{3}(x-6) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}(x-6) & =3 \\\\ {3}^{{log}_{3}(x-6)} & ={3}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}(x-6)}=x-6.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-6 & ={3}^{3} \\\\ x-6 & =27 \\\\ x & =33.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70017/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78"] :knowledge-point/questions ["q-70017"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110768/answer/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "07f16a31-68cf-50b0-a4f8-6115e3e39831" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-110768/answer" :answer-field/id #uuid "5bf1c538-27c7-5ccf-8b87-dd65b49ef275" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-110768/answer/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-110768/answer/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-110768" :question/id #uuid "7cfeb4b6-43fa-5ecb-97ca-0bb7ce89abb9" :question/math-academy-id "q-110768" :question/problem "If $\\operatorname{log}(2x)+5=5,$ then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}\\operatorname{log}(2x)+5 & =5 \\\\ \\operatorname{log}(2x) & =0\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $10,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{log}(2x) & =0 \\\\ {10}^{\\operatorname{log}(2x)} & ={10}^{0}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${10}^{\\operatorname{log}(2x)}=2x.$\n\nTherefore,\n\n$$\n\\begin{aligned}2x & ={10}^{0} \\\\ 2x & =1 \\\\ x & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110768/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78"] :knowledge-point/questions ["q-110768"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100627/answer/d862bee29224a17b4866fadbc98df69a8369d5924baec9da0dfc2380463e2ec0" :answer/id #uuid "42bf02f2-51de-5cf2-b795-a860c928c6fe" :answer/type :answer.type/math :answer/value "755" :db/ensure [:answer/validate]} {:db/id "q-100627/answer" :answer-field/id #uuid "681993c1-a32e-56ef-8e99-9cd83ba96239" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-100627/answer/d862bee29224a17b4866fadbc98df69a8369d5924baec9da0dfc2380463e2ec0" :answer-field/choices ["q-100627/answer/d862bee29224a17b4866fadbc98df69a8369d5924baec9da0dfc2380463e2ec0"] :db/ensure [:answer-field/validate]} {:db/id "q-100627" :question/id #uuid "fb813bd0-6d03-5ce7-aeed-ba5a66fe6313" :question/math-academy-id "q-100627" :question/problem "If $-7{log}_{3}(x-26)=-42$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}-7{log}_{3}(x-26) & =-42 \\\\ {log}_{3}(x-26) & =\\frac{-42}{-7} \\\\ {log}_{3}(x-26) & =6\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}(x-26) & =6 \\\\ {3}^{{log}_{3}(x-26)} & ={3}^{6}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}(x-26)}=x-26.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-26 & ={3}^{6} \\\\ x-26 & =729 \\\\ x & =755.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-100627/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78"] :knowledge-point/questions ["q-100627"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79389/answer/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "20548a01-2b86-54af-86e2-47785b72dd24" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-79389/answer" :answer-field/id #uuid "4a4a00ad-aa7d-55a1-b4fc-d55a24214956" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-79389/answer/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer-field/choices ["q-79389/answer/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-79389" :question/id #uuid "085c7d1a-1e1a-5955-8d31-2be9a5ca85e3" :question/math-academy-id "q-79389" :question/problem "If $5{log}_{4}x+3{log}_{4}x=16$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}5{log}_{4}x+3{log}_{4}x & =16 \\\\ (5+3){log}_{4}x & =16 \\\\ 8{log}_{4}x & =16 \\\\ {log}_{4}x & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}x & =2 \\\\ {4}^{{log}_{4}x} & ={4}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={4}^{2} \\\\ x & =16.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79389/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423"] :knowledge-point/questions ["q-79389"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332197/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "30a15c72-9a15-5022-99b2-0c0968a3a7be" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-332197/field-1" :answer-field/id #uuid "76bf53f9-dc9f-5679-8fdd-3f5f5d0ff6ed" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332197/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-332197/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-332197/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "710df7e8-f09e-59ea-941f-dd92b0e48503" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332197/field-2" :answer-field/id #uuid "5b15d72a-1a4d-5b32-bf7a-3349b514d1cc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332197/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332197/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332197" :question/id #uuid "889a0c6a-4567-5269-8c45-169860a4a405" :question/math-academy-id "q-332197" :question/problem "Express $\\operatorname{sin}(x-\\frac{3\\pi }{2})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x-\\frac{3\\pi }{2})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}(u-v)=\\operatorname{sin}u\\operatorname{cos}v-\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{3\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x-\\frac{3\\pi }{2}) & =\\operatorname{sin}x\\operatorname{cos}(\\frac{3\\pi }{2})-\\operatorname{cos}x\\operatorname{sin}(\\frac{3\\pi }{2}) \\\\  & =\\operatorname{sin}x\\cdot 0-\\operatorname{cos}x\\cdot (-1) \\\\  & =\\operatorname{cos}x \\\\  & =0\\,\\operatorname{sin}x+1\\,\\operatorname{cos}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332197/field-1" "q-332197/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de"] :knowledge-point/questions ["q-332197"] :db/ensure [:knowledge-point/validate]} {:db/id "q-143196/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "17de2bda-8c5f-51b2-9f29-4957191f1a08" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-143196/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "417bafa0-6c93-561b-af7c-daa293eb6dc5" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-143196/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d9d1f3bc-fdc6-5a99-a73a-ea04a947050f" :ans