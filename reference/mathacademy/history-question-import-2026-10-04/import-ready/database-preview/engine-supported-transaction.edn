28/r1c1" "q-70428/r2c1" "q-70428/r3c1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0"] :knowledge-point/questions ["q-70428"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121937/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f5e1e700-f53a-5f31-b1e5-83e7775f2629" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-121937/r1c1" :answer-field/id #uuid "96feac81-6330-5421-8ed4-439f33a296e9" :answer-field/key "r1c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-121937/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-121937/r1c1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-121937/r2c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "20ab074f-0118-56c4-9b44-4bafeeac1c74" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-121937/r2c1" :answer-field/id #uuid "5eb92b71-ff02-5352-8087-3a7d6c5372bc" :answer-field/key "r2c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-121937/r2c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-121937/r2c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-121937/r3c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "a1a9057e-1899-5295-a74f-26c5f9dd16c0" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-121937/r3c1" :answer-field/id #uuid "77e61a13-55e4-51b6-9867-a32cbbee6a22" :answer-field/key "r3c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-121937/r3c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-121937/r3c1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-121937" :question/id #uuid "f65102c8-6fda-5ced-885c-0d555e3ecc9f" :question/math-academy-id "q-121937" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]$, $b=[\\begin{aligned}7 \\\\ 5 \\\\ -2\\end{aligned}]$ and $c=[\\begin{aligned}-5 \\\\ 3 \\\\ 8\\end{aligned}].$ Find $a-(b+c).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "To compute $a-(b+c),$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-(b+c) & =[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]-([\\begin{aligned}7 \\\\ 5 \\\\ -2\\end{aligned}]+[\\begin{aligned}-5 \\\\ 3 \\\\ 8\\end{aligned}]) \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}2 \\\\ 8 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -7 \\\\ -7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-121937/r1c1" "q-121937/r2c1" "q-121937/r3c1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "667a2ec8-c35c-52a8-a072-1d00fd8af78c"] :knowledge-point/questions ["q-121937"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70442/r1c1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "edf3db8b-07fa-5a05-beeb-5039706e1aa5" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-70442/r1c1" :answer-field/id #uuid "b7ae217c-f9a1-5468-8af7-29172a7dcf35" :answer-field/key "r1c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70442/r1c1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer-field/choices ["q-70442/r1c1/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3"] :db/ensure [:answer-field/validate]} {:db/id "q-70442/r2c1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "768d8132-dcf3-5926-82f7-085f0e901f0b" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-70442/r2c1" :answer-field/id #uuid "f03b04df-385a-5a8d-8329-2848e81acc38" :answer-field/key "r2c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70442/r2c1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-70442/r2c1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-70442/r3c1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "7c336456-9f5e-57c0-a7c6-81bbad42329d" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-70442/r3c1" :answer-field/id #uuid "85fc23fe-0c61-5bde-9cfe-866cea8c8bdd" :answer-field/key "r3c1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-70442/r3c1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer-field/choices ["q-70442/r3c1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b"] :db/ensure [:answer-field/validate]} {:db/id "q-70442" :question/id #uuid "5490d51d-3d7e-50a1-bf73-5cc6f43b1ef0" :question/math-academy-id "q-70442" :question/problem "Let $w=[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]$, $y=[\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]$ and $z=[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}].$ Find $2w-(3y+z).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "To compute $2w-(3y+z),$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2w-(3y+z) & =2\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]-(3\\cdot [\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}]) \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 4\\end{aligned}]-([\\begin{aligned}12 \\\\ -3 \\\\ 9\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}]) \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 4\\end{aligned}]-[\\begin{aligned}11 \\\\ -1 \\\\ 19\\end{aligned}] \\\\  & =[\\begin{aligned}-11 \\\\ 7 \\\\ -15\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70442/r1c1" "q-70442/r2c1" "q-70442/r3c1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "667a2ec8-c35c-52a8-a072-1d00fd8af78c"] :knowledge-point/questions ["q-70442"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349046/field-1/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer/id #uuid "769c13a1-2652-5745-bf0c-dc8847660a4e" :answer/type :answer.type/math :answer/value "\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id "q-349046/field-1" :answer-field/id #uuid "a72a5a13-7c65-5e73-9386-bea7dbcf8dfd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349046/field-1/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer-field/choices ["q-349046/field-1/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4"] :db/ensure [:answer-field/validate]} {:db/id "q-349046" :question/id #uuid "ea7ffee5-aba9-5009-a4aa-655ef4e3e64e" :question/math-academy-id "q-349046" :question/problem "Find the third partial sum ${s}_{3}$ of the series\n${\\sum }_{n=1}^{\\infty }\\frac{(n+1)!}{3}.$ Do not round the answer.\n\n${s}_{3}=$\n{{field-1}}" :question/worked-solution "Let's start by calculating the first three terms:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{(1+1)!}{3}=\\frac{2}{3} \\\\ {a}_{2} & =\\frac{(2+1)!}{3}=2 \\\\ {a}_{3} & =\\frac{(3+1)!}{3}=8\\end{aligned}\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3} & =\\frac{2}{3}+2+8=\\frac{32}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349046/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b5c61a4-3c02-5f45-a6e7-97cf79923e9a"] :knowledge-point/questions ["q-349046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349045/field-1/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "7cf696b4-e25a-5e0a-9745-b467dbeed7f3" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-349045/field-1" :answer-field/id #uuid "81a187a3-5575-57e4-b0e8-ccdf2051c02c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349045/field-1/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer-field/choices ["q-349045/field-1/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba"] :db/ensure [:answer-field/validate]} {:db/id "q-349045" :question/id #uuid "b503e377-0ec1-535d-8219-850878efeeae" :question/math-academy-id "q-349045" :question/problem "Find the third partial sum ${s}_{3}$ of the series\n${\\sum }_{n=1}^{\\infty }\\frac{n!}{2}.$ Do not round the answer.\n\n${s}_{3}=$\n{{field-1}}" :question/worked-solution "Let's start by calculating the first three terms:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1!}{2}=\\frac{1}{2} \\\\ {a}_{2} & =\\frac{2!}{2}=1 \\\\ {a}_{3} & =\\frac{3!}{2}=3\\end{aligned}\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3} & =\\frac{1}{2}+1+3=\\frac{9}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349045/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b5c61a4-3c02-5f45-a6e7-97cf79923e9a"] :knowledge-point/questions ["q-349045"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123940/answer/94f20eb71b3896acdc0d9a5089077d01bd5a4bb6ba44e13ce98382a85e87c8ef" :answer/id #uuid "2c354b3b-46f8-52ed-b64b-3bd9ce8ee2eb" :answer/type :answer.type/math :answer/value "-110" :db/ensure [:answer/validate]} {:db/id "q-123940/answer" :answer-field/id #uuid "1b400207-bef6-55aa-8972-5e014ca89499" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-123940/answer/94f20eb71b3896acdc0d9a5089077d01bd5a4bb6ba44e13ce98382a85e87c8ef" :answer-field/choices ["q-123940/answer/94f20eb71b3896acdc0d9a5089077d01bd5a4bb6ba44e13ce98382a85e87c8ef"] :db/ensure [:answer-field/validate]} {:db/id "q-123940" :question/id #uuid "66d6f0cd-ec5e-58d6-b37c-1dc9aefebc12" :question/math-academy-id "q-123940" :question/problem "Find the eleventh partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2-2n).$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=2-2n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2-2(1)=0 \\\\ {a}_{2} & =2-2(2)=-2 \\\\ {a}_{3} & =2-2(3)=-4,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=-2$ and first term ${a}_{1}=0.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{11}=2-2(11)=-20,$ we get\n\n$$\n{s}_{11}=\\frac{11}{2}(0-20)=-110.\n$$\n\nSo the eleventh partial sum of ${\\sum }_{n=1}^{\\infty }(2-2n)$ is equal to $-110.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123940/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c"] :knowledge-point/questions ["q-123940"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69708/answer/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7" :answer/id #uuid "144e8652-fa68-52dc-82e6-05edd1d9d46d" :answer/type :answer.type/math :answer/value "96" :db/ensure [:answer/validate]} {:db/id "q-69708/answer" :answer-field/id #uuid "3a5431de-10c0-57fb-86ad-1c754cd133cb" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-69708/answer/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7" :answer-field/choices ["q-69708/answer/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7"] :db/ensure [:answer-field/validate]} {:db/id "q-69708" :question/id #uuid "5a8ef49c-d0f0-5230-8a06-784e450e8567" :question/math-academy-id "q-69708" :question/problem "Find the eighth partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2n+3).$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=2n+3.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2(1)+3=5 \\\\ {a}_{2} & =2(2)+3=7 \\\\ {a}_{3} & =2(3)+3=9,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=2$ and first term ${a}_{1}=5.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{8}=2(8)+3=19,$ we get\n\n$$\n{s}_{8}=\\frac{8}{2}(5+19)=96.\n$$\n\nSo the eighth partial sum of ${\\sum }_{n=1}^{\\infty }(2n+3)$ is equal to $96.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69708/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c"] :knowledge-point/questions ["q-69708"] :db/ensure [:knowledge-point/validate]} {:db/id "q-322683/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "be648c48-4047-584a-b794-e75cad2c3eac" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-322683/field-1" :answer-field/id #uuid "2e2b2d3d-dc10-57bb-b4eb-b441ed7bed32" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322683/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-322683/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-322683/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "af0d2bc5-d722-511d-9c0b-71a05c581007" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-322683/field-2" :answer-field/id #uuid "8681383d-8705-5781-b760-7f881834df21" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322683/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-322683/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-322683/field-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "4b38906a-c5ec-5e2c-aa82-e74377f9d2b7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-322683/field-3" :answer-field/id #uuid "f25949b9-4354-5131-a1b6-3792ad7c0e6f" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322683/field-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-322683/field-3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-322683" :question/id #uuid "e95cfe22-0303-57f5-8f01-714df12a8f83" :question/math-academy-id "q-322683" :question/problem "Write the vector $b=-7i+2j+5k$ in angle bracket notation.\n\n$b=⟨$\n{{field-1}},\n{{field-2}},\n{{field-3}}$⟩$" :question/worked-solution "Remember that in general, if a point $B$ has coordinates $({b}_{x},{b}_{y},{b}_{z}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OB}=b=⟨{b}_{x},{b}_{y},{b}_{z}⟩=[\\begin{aligned}{b}_{x} \\\\ {b}_{y} \\\\ {b}_{z}\\end{aligned}]={b}_{x}\\,i+{b}_{y}\\,j+{b}_{z}\\,k.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}b & =-7i+2j+5k \\\\  & =-7\\cdot i+2\\cdot j+5\\cdot k \\\\  & =⟨-7,2,5⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-322683/field-1" "q-322683/field-2" "q-322683/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ea3855dd-f8c9-5065-ac55-99356bbaa583"] :knowledge-point/questions ["q-322683"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110277/answer/d0429f8462d478e6a5dba12a2a0ad7fc761b0e6a5486d81e249b0a1e04a4d230" :answer/id #uuid "7fc8b167-ef15-5146-9667-67a32a66e6bb" :answer/type :answer.type/math :answer/value "\\frac{19\\,531}{9}" :db/ensure [:answer/validate]} {:db/id "q-110277/answer" :answer-field/id #uuid "0d921919-d38f-5c37-be04-22304885e161" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-110277/answer/d0429f8462d478e6a5dba12a2a0ad7fc761b0e6a5486d81e249b0a1e04a4d230" :answer-field/choices ["q-110277/answer/d0429f8462d478e6a5dba12a2a0ad7fc761b0e6a5486d81e249b0a1e04a4d230"] :db/ensure [:answer-field/validate]} {:db/id "q-110277" :question/id #uuid "3e0062d6-cbd1-58f3-a005-e59a201ee54b" :question/math-academy-id "q-110277" :question/problem "Evaluate the series ${\\sum }_{n=1}^{7}\\frac{1}{9}(5)^{n-1}.$\n\nAnswer: {{answer}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, ${a}_{1}=\\frac{1}{9},$ $r=5$ and $N=7.$ If we substitute these values into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{7}\\frac{1}{9}(5)^{n-1} & =\\frac{1}{9}\\cdot \\frac{(1-{5}^{7})}{1-5} \\\\  & =\\frac{1}{9}\\cdot \\frac{(1-{5}^{7})}{(-4)} \\\\  & =-\\frac{1}{36}\\cdot (-78\\,124) \\\\  & =\\frac{19\\,531}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110277/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "850edf12-eb3a-56e5-8bcf-02eb10afa457"] :knowledge-point/questions ["q-110277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280142/field-1/0697fa2e4ce3dbcefda8b49ed7fcba2f77f7ab9adad47bcf72599039c9200996" :answer/id #uuid "85ebfb2c-99c6-5637-b42c-761be5242059" :answer/type :answer.type/math :answer/value "\\frac{781}{64}" :db/ensure [:answer/validate]} {:db/id "q-280142/field-1" :answer-field/id #uuid "e8086ada-f6fe-58cb-9114-cce7f17fbdd9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280142/field-1/0697fa2e4ce3dbcefda8b49ed7fcba2f77f7ab9adad47bcf72599039c9200996" :answer-field/choices ["q-280142/field-1/0697fa2e4ce3dbcefda8b49ed7fcba2f77f7ab9adad47bcf72599039c9200996"] :db/ensure [:answer-field/validate]} {:db/id "q-280142" :question/id #uuid "03feef15-6821-50d8-957a-59df60c1ee42" :question/math-academy-id "q-280142" :question/problem "Evaluate the **exact value** of the following series:\n\n${\\sum }_{n=1}^{5}4{(\\frac{3}{4})}^{n-1}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, ${a}_{1}=4,$ $r=\\frac{3}{4}$ and $N=5.$ If we substitute these values into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{5}4{(\\frac{3}{4})}^{n-1} & =4\\cdot \\frac{(1-{(\\frac{3}{4})}^{5})}{1-\\frac{3}{4}} \\\\  & =4\\cdot \\frac{(1-\\frac{243}{1024})}{\\frac{1}{4}} \\\\  & =4\\cdot \\frac{\\frac{781}{1024}}{\\frac{1}{4}} \\\\  & =4\\cdot \\frac{3124}{1024} \\\\  & =\\frac{781}{64}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280142/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "850edf12-eb3a-56e5-8bcf-02eb10afa457"] :knowledge-point/questions ["q-280142"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280149/field-1/c829d0d3138570b44e8ad29cc2b5097808263dbd9abe86666025a3b2e0ed69f3" :answer/id #uuid "791e76a9-3d5f-57c1-b10b-b6d07ab33163" :answer/type :answer.type/math :answer/value "2046" :db/ensure [:answer/validate]} {:db/id "q-280149/field-1" :answer-field/id #uuid "e210c240-5654-5bf6-9793-aef1a6e8b3c2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280149/field-1/c829d0d3138570b44e8ad29cc2b5097808263dbd9abe86666025a3b2e0ed69f3" :answer-field/choices ["q-280149/field-1/c829d0d3138570b44e8ad29cc2b5097808263dbd9abe86666025a3b2e0ed69f3"] :db/ensure [:answer-field/validate]} {:db/id "q-280149" :question/id #uuid "d76c89d6-e774-5178-8f95-00904170710b" :question/math-academy-id "q-280149" :question/problem "Evaluate the following geometric series:\n\n${\\sum }_{n=1}^{5}\\frac{3}{2}(4)^{n}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=4$ and $N=5.$ We need to figure out the value of ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=\\frac{3}{2}(4)^{n},\n$$\n\nand therefore, we can calculate the first term ${a}_{1}$ as follows:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{3}{2}(4)^{1} \\\\  & =6\\end{aligned}\n$$\n\nIf we substitute ${a}_{1}=6,r=4$ and $N=5$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{5}\\frac{3}{2}(4)^{n} & =6\\cdot \\frac{(1-{4}^{5})}{1-4} \\\\  & =6\\cdot \\frac{(-1023)}{(-3)} \\\\  & =6(341) \\\\  & =2046\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280149/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "044ed681-b1e8-594c-9b0a-520c0c5b475a"] :knowledge-point/questions ["q-280149"] :db/ensure [:knowledge-point/validate]} {:db/id "q-269890/field-1/c257072dd22891c65170a1a65f68969d7f47c2fdd931b2bd011e1f7679468dda" :answer/id #uuid "8623d5cd-6d19-5157-992a-6920f8c4437c" :answer/type :answer.type/math :answer/value "58590" :db/ensure [:answer/validate]} {:db/id "q-269890/field-1" :answer-field/id #uuid "ee7c095c-d9a2-513d-ac1a-600d9e4f8744" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-269890/field-1/c257072dd22891c65170a1a65f68969d7f47c2fdd931b2bd011e1f7679468dda" :answer-field/choices ["q-269890/field-1/c257072dd22891c65170a1a65f68969d7f47c2fdd931b2bd011e1f7679468dda"] :db/ensure [:answer-field/validate]} {:db/id "q-269890" :question/id #uuid "6b6c9e68-e0bd-5e83-8cdf-bece74c3ee55" :question/math-academy-id "q-269890" :question/problem "Evaluate the following geometric series:\n\n${\\sum }_{n=1}^{6}3(5)^{n}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=5$ and $N=6.$ We need to figure out the value of ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=3(5)^{n},\n$$\n\nand therefore, we can calculate the first term ${a}_{1}$ as follows:\n\n$$\n\\begin{aligned}{a}_{1} & =3(5)^{1} \\\\  & =15\\end{aligned}\n$$\n\nIf we substitute ${a}_{1}=15,r=5$ and $N=6$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{6}3(5)^{n} & =15\\cdot \\frac{(1-{5}^{6})}{1-5} \\\\  & =15\\cdot \\frac{(-15\\,624)}{(-4)} \\\\  & =15(3906) \\\\  & =58\\,590\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-269890/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "044ed681-b1e8-594c-9b0a-520c0c5b475a"] :knowledge-point/questions ["q-269890"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280253/field-1/a6ecfb1ac3ab8b028107c12208d7fdaf9e13188ca8e781e0cd0717567693cfae" :answer/id #uuid "e8824b1b-d8cd-591a-ab89-55dc9fbbc2c8" :answer/type :answer.type/math :answer/value "\\frac{259}{4}" :db/ensure [:answer/validate]} {:db/id "q-280253/field-1" :answer-field/id #uuid "b8031aa4-9ef9-5d3c-b2c0-4c90c083fca1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280253/field-1/a6ecfb1ac3ab8b028107c12208d7fdaf9e13188ca8e781e0cd0717567693cfae" :answer-field/choices ["q-280253/field-1/a6ecfb1ac3ab8b028107c12208d7fdaf9e13188ca8e781e0cd0717567693cfae"] :db/ensure [:answer-field/validate]} {:db/id "q-280253" :question/id #uuid "503b9785-4d55-5d08-a435-b657b276f67e" :question/math-academy-id "q-280253" :question/problem "Evaluate the **exact value** of the following geometric series:\n\n${\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1}=$\n{{field-1}}" :question/worked-solution "Notice that we can rewrite the series as follows:\n\n$$\n{\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1}\n$$\n\nSince the above series is in the form ${\\sum }_{n=1}^{N}a{r}^{n-1}$, it is a geometric series starting at $n=1$, with the exponent matching the standard form for partial sums.\n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series:\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=\\frac{1}{6}$, $N=4$, and the first term ${a}_{1}=54.$\n\nSubstituting into the formula gives:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1} & =54\\cdot \\frac{1-{(\\frac{1}{6})}^{4}}{1-\\frac{1}{6}} \\\\  & =54\\cdot \\frac{1295}{1296}\\cdot \\frac{6}{5} \\\\  & =\\frac{259}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280253/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16cdb454-0ef5-5ec4-8141-8b1182aab815"] :knowledge-point/questions ["q-280253"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280244/field-1/292a8a24e8c9a52b78b515921bf32405b61de8abeaee86a27783498d84ff7dc9" :answer/id #uuid "f46d4583-c3dc-5b07-9d0f-232e78e4619d" :answer/type :answer.type/math :answer/value "\\frac{1200}{343}" :db/ensure [:answer/validate]} {:db/id "q-280244/field-1" :answer-field/id #uuid "ba568ec5-107a-50c2-adc0-af80b846d5b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280244/field-1/292a8a24e8c9a52b78b515921bf32405b61de8abeaee86a27783498d84ff7dc9" :answer-field/choices ["q-280244/field-1/292a8a24e8c9a52b78b515921bf32405b61de8abeaee86a27783498d84ff7dc9"] :db/ensure [:answer-field/validate]} {:db/id "q-280244" :question/id #uuid "38d95bd5-b1e1-544e-9f92-f7bc640d7469" :question/math-academy-id "q-280244" :question/problem "Evaluate the **exact value** of the following geometric series:\n\n${\\sum }_{n=1}^{4}\\frac{21}{{7}^{n}}=$\n{{field-1}}" :question/worked-solution "Notice that we can rewrite the series as follows:\n\n$$\n{\\sum }_{n=1}^{4}\\frac{21}{{7}^{n}}={\\sum }_{n=1}^{4}21\\cdot {(\\frac{1}{7})}^{n}\n$$\n\nSince the above series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=\\frac{1}{7}$ and $N=4.$ We need to figure out ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=21\\cdot {(\\frac{1}{7})}^{n},\n$$\n\nand therefore the first term of the series is\n\n$$\n{a}_{1}=21\\cdot {(\\frac{1}{7})}^{1}=3.\n$$\n\nIf we substitute ${a}_{1}=3,r=\\frac{1}{7}$ and $N=4$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}21\\cdot {(\\frac{1}{7})}^{n} & =3\\cdot \\frac{[1-{(\\frac{1}{7})}^{4}]}{(1-\\frac{1}{7})} \\\\  & =3\\cdot \\frac{(1-\\frac{1}{2401})}{\\frac{6}{7}} \\\\  & =3\\cdot \\frac{7}{6}\\cdot \\frac{2400}{2401} \\\\  & =\\frac{1200}{343}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280244/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16cdb454-0ef5-5ec4-8141-8b1182aab815"] :knowledge-point/questions ["q-280244"] :db/ensure [:knowledge-point/validate]} {:db/id "q-269902/field-1/73247518b5cb75411dfcf299f085a6c9fc81b6eeae06c69f524f3571920834e2" :answer/id #uuid "c6eb5520-8d26-5f65-8501-73db7e4c1c5d" :answer/type :answer.type/math :answer/value "\\frac{312}{5}" :db/ensure [:answer/validate]} {:db/id "q-269902/field-1" :answer-field/id #uuid "6b0e809c-6844-5731-a64b-72f8fbdcd8bf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-269902/field-1/73247518b5cb75411dfcf299f085a6c9fc81b6eeae06c69f524f3571920834e2" :answer-field/choices ["q-269902/field-1/73247518b5cb75411dfcf299f085a6c9fc81b6eeae06c69f524f3571920834e2"] :db/ensure [:answer-field/validate]} {:db/id "q-269902" :question/id #uuid "67a65dcf-aa63-52fc-b7e4-2c741bfe2157" :question/math-academy-id "q-269902" :question/problem "Evaluate the following geometric series:\n\n${\\sum }_{n=0}^{3}2{(5)}^{n-1}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form $\\sum a{r}^{n-1},$ it is a geometric series. Notice that the index starts from $n=0$ instead of $n=1.$\n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{0}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=5.$ Also, note that $N=4,$ since there are $4$ terms in total.\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=2{(5)}^{n-1},\n$$\n\nand so the first term ${a}_{0}$ is given by\n\n$$\n\\begin{aligned}{a}_{0} & =2{(5)}^{0-1} \\\\  & =2{(5)}^{-1} \\\\  & =2\\cdot \\frac{1}{5} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nIf we substitute ${a}_{0}=\\frac{2}{5},r=5$ and $N=4$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{S}_{4} & =\\frac{2}{5}\\cdot \\frac{(1-{5}^{4})}{(1-5)} \\\\  & =\\frac{2}{5}\\cdot \\frac{(1-{5}^{4})}{(-4)} \\\\  & =\\frac{1248}{20} \\\\  & =\\frac{312}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-269902/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd612e5f-cc72-5df4-94da-e290473ed0a4"] :knowledge-point/questions ["q-269902"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110335/answer/3f8b4f58a5107a4794271c4790bbfd0338aea5d84c3bc74693bba2ca8078dfff" :answer/id #uuid "7fd952d3-2187-57f2-a6ea-3287343f7b91" :answer/type :answer.type/math :answer/value "\\frac{242}{3}" :db/ensure [:answer/validate]} {:db/id "q-110335/answer" :answer-field/id #uuid "e145e81e-6d32-5816-8b4d-7fbdfeb2d2d2" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-110335/answer/3f8b4f58a5107a4794271c4790bbfd0338aea5d84c3bc74693bba2ca8078dfff" :answer-field/choices ["q-110335/answer/3f8b4f58a5107a4794271c4790bbfd0338aea5d84c3bc74693bba2ca8078dfff"] :db/ensure [:answer-field/validate]} {:db/id "q-110335" :question/id #uuid "032226b5-f50b-5569-a40d-8825ca8a0e5f" :question/math-academy-id "q-110335" :question/problem "Evaluate the geometric series ${\\sum }_{n=0}^{4}2{(3)}^{n-1}.$\n\nAnswer: {{answer}}" :question/worked-solution "Since the given series is in the form $\\sum a{r}^{n-1},$ it is a geometric series. Notice that the index starts from $n=0$ instead of $n=1.$\n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{0}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=3.$ Also, note that $N=5,$ since there are $5$ terms in total.\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=2{(3)}^{n-1},\n$$\n\nand so the first term ${a}_{0}$ is given by\n\n$$\n\\begin{aligned}{a}_{0} & =2{(3)}^{0-1} \\\\  & =2{(3)}^{-1} \\\\  & =2\\cdot \\frac{1}{3} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nIf we substitute ${a}_{0}=\\frac{2}{3},r=3$ and $N=5$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{S}_{5} & =\\frac{2}{3}\\cdot \\frac{(1-{3}^{5})}{(1-3)} \\\\  & =\\frac{2}{3}\\cdot \\frac{(1-{3}^{5})}{(-2)} \\\\  & =-\\frac{1}{3}\\cdot (-242) \\\\  & =\\frac{242}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110335/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd612e5f-cc72-5df4-94da-e290473ed0a4"] :knowledge-point/questions ["q-110335"] :db/ensure [:knowledge-point/validate]} {:db/id "q-67043/answer/9896d1044be080c6a7a797803a27052e366fcac89242d04169a38ee074941e6a" :answer/id #uuid "45bf49dd-7841-5382-a86f-093a0a3c4e69" :answer/type :answer.type/math :answer/value "-273" :db/ensure [:answer/validate]} {:db/id "q-67043/answer" :answer-field/id #uuid "878d60a5-6709-5ede-b238-4483f961cae3" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-67043/answer/9896d1044be080c6a7a797803a27052e366fcac89242d04169a38ee074941e6a" :answer-field/choices ["q-67043/answer/9896d1044be080c6a7a797803a27052e366fcac89242d04169a38ee074941e6a"] :db/ensure [:answer-field/validate]} {:db/id "q-67043" :question/id #uuid "1b0d02cf-7e0a-5619-ba74-9c01c7f880f0" :question/math-academy-id "q-67043" :question/problem "The following arithmetic series has $13$ terms in total. Find the sum of the series.\n\n$$\n-9+(-11)+(-13)+(-15)+⋯+(-33)\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nFor our series, we have ${a}_{1}=-9,{a}_{N}=-33$ and $N=13.$ Substituting these values into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{13} & =\\frac{13}{2}(-9+(-33)) \\\\  & =\\frac{13}{2}(-42) \\\\  & =13(-21) \\\\  & =-273\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-67043/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "829ac8f1-7ade-5dd9-9f2f-78234a57a257"] :knowledge-point/questions ["q-67043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107751/answer/a89f367fc46b5ae96a202ad56869485a7325d963cd2e99b00337cc148b9d4337" :answer/id #uuid "0f702305-766f-5dd0-8437-9e8a07a18a6f" :answer/type :answer.type/math :answer/value "-8\\,364" :db/ensure [:answer/validate]} {:db/id "q-107751/answer" :answer-field/id #uuid "cdd765af-f333-566b-8af6-2696251ec62c" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-107751/answer/a89f367fc46b5ae96a202ad56869485a7325d963cd2e99b00337cc148b9d4337" :answer-field/choices ["q-107751/answer/a89f367fc46b5ae96a202ad56869485a7325d963cd2e99b00337cc148b9d4337"] :db/ensure [:answer-field/validate]} {:db/id "q-107751" :question/id #uuid "06cac020-1582-549c-9faf-4dee975a31ad" :question/math-academy-id "q-107751" :question/problem "Find the sum of the following arithmetic series.\n\n$$\n(-14)+(-20)+(-26)+(-32)+⋯+(-314)\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nFor our series, we have ${a}_{1}=-14$ and the common difference is:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-20-(-14) \\\\  & =-6\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-14+(n-1)(-6) \\\\  & =-14-6n+6 \\\\  & =-6n-8\\end{aligned}\n$$\n\nAs we know, the last term is ${a}_{N}=-314.$ Putting this value in the formula for the $n$th term obtained above, we get:\n\n$$\n\\begin{aligned}{a}_{N} & =-6N-8 \\\\ -314 & =-6N-8 \\\\ -306 & =-6N \\\\ N & =51\\end{aligned}\n$$\n\nFinally, substituting ${a}_{1}=-14$, ${a}_{51}=-314$, and $N=51$ into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{51} & =\\frac{N}{2}({a}_{1}+{a}_{N}) \\\\  & =\\frac{51}{2}\\cdot (-14-314) \\\\  & =\\frac{51}{2}\\cdot (-328) \\\\  & =-8\\,364\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107751/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "829ac8f1-7ade-5dd9-9f2f-78234a57a257"] :knowledge-point/questions ["q-107751"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107749/answer/8e0cc0f70b35f6c5ae9659d35d6f9bdaec481fc90a0049412fff4ccc9b180fee" :answer/id #uuid "37cfaf94-1a46-5072-bebb-e1a08259948a" :answer/type :answer.type/math :answer/value "616" :db/ensure [:answer/validate]} {:db/id "q-107749/answer" :answer-field/id #uuid "8532ae84-3559-5cd7-b556-eff814ccedbd" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-107749/answer/8e0cc0f70b35f6c5ae9659d35d6f9bdaec481fc90a0049412fff4ccc9b180fee" :answer-field/choices ["q-107749/answer/8e0cc0f70b35f6c5ae9659d35d6f9bdaec481fc90a0049412fff4ccc9b180fee"] :db/ensure [:answer-field/validate]} {:db/id "q-107749" :question/id #uuid "c01979e1-2f0d-57eb-bf22-2ecf15ad2571" :question/math-academy-id "q-107749" :question/problem "Find the sum of the following arithmetic series.\n\n$$\n5+11+17+23+⋯+83\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nFor our series, we have ${a}_{1}=5$ and the common difference is:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =11-5 \\\\  & =6\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =5+(n-1)(6) \\\\  & =5+6n-6 \\\\  & =6n-1\\end{aligned}\n$$\n\nAs we know, the last term is ${a}_{N}=83.$ Putting this value in the formula for the $n$th term obtained above, we get:\n\n$$\n\\begin{aligned}{a}_{N} & =6N-1 \\\\ 83 & =6N-1 \\\\ 84 & =6N \\\\ N & =14\\end{aligned}\n$$\n\nFinally, substituting ${a}_{1}=5$, ${a}_{14}=83$, and $N=14$ into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{14} & =\\frac{14}{2}(5+83) \\\\  & =7\\cdot 88 \\\\  & =616\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107749/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "829ac8f1-7ade-5dd9-9f2f-78234a57a257"] :knowledge-point/questions ["q-107749"] :db/ensure [:knowledge-point/validate]} {:db/id "q-67047/answer/6d5e653a0cc5c6e6fc44c5c3386727c89009586dc5171332dccb4c794ca30987" :answer/id #uuid "4eddb648-ec6d-570d-9987-b5a58e4f4ce2" :answer/type :answer.type/math :answer/value "330" :db/ensure [:answer/validate]} {:db/id "q-67047/answer" :answer-field/id #uuid "67ab2d8d-687a-57cc-bd4e-e89fb5e0950a" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-67047/answer/6d5e653a0cc5c6e6fc44c5c3386727c89009586dc5171332dccb4c794ca30987" :answer-field/choices ["q-67047/answer/6d5e653a0cc5c6e6fc44c5c3386727c89009586dc5171332dccb4c794ca30987"] :db/ensure [:answer-field/validate]} {:db/id "q-67047" :question/id #uuid "4fced0be-707f-5fb0-9e9e-ae88a44c183d" :question/math-academy-id "q-67047" :question/problem "The following arithmetic series has $15$ terms in total. Find the sum of the series.\n\n$$\n-6+(-2)+2+6+⋯+50\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nFor our series, we have ${a}_{1}=-6,{a}_{N}=50$ and $N=15.$ Substituting these values into the formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{15} & =\\frac{15}{2}(-6+50) \\\\  & =\\frac{15}{2}\\cdot 44 \\\\  & =15\\cdot 22 \\\\  & =330\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-67047/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "829ac8f1-7ade-5dd9-9f2f-78234a57a257"] :knowledge-point/questions ["q-67047"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5300/answer/8bf9008bc778888b2d3f4240302b812727e0200209b4202da0461e41435934e6" :answer/id #uuid "817c3779-2936-58e7-a892-3e1f60da2e7f" :answer/type :answer.type/math :answer/value "-72" :db/ensure [:answer/validate]} {:db/id "q-5300/answer" :answer-field/id #uuid "b530797f-f38a-5d88-8eb5-a1eb5d3c16a0" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-5300/answer/8bf9008bc778888b2d3f4240302b812727e0200209b4202da0461e41435934e6" :answer-field/choices ["q-5300/answer/8bf9008bc778888b2d3f4240302b812727e0200209b4202da0461e41435934e6"] :db/ensure [:answer-field/validate]} {:db/id "q-5300" :question/id #uuid "ac22c321-341c-5b1a-8d5d-082d85416290" :question/math-academy-id "q-5300" :question/problem "What is the sum of the arithmetic series ${\\sum }_{n=1}^{8}(-2n)?$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nGiven the series ${\\sum }_{n=1}^{8}(-2n)$ in sigma notation, we note that\n\n- the total number of terms is $N=8$\n\n- the first term is ${a}_{1}=-2\\cdot 1=-2$\n\n- the last term is ${a}_{8}=-2\\cdot 8=-16$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we obtain:\n\n$$\n\\begin{aligned}{S}_{8} & =\\frac{8}{2}(-2+(-16)) \\\\  & =4(-18) \\\\  & =-72\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-5300/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f6813b06-c450-599f-9b64-0588ec4142d9"] :knowledge-point/questions ["q-5300"] :db/ensure [:knowledge-point/validate]} {:db/id "q-6491/answer/e8fca892866a06a1ab302627b9de911942e4dfff7666b327843df0729f3939b1" :answer/id #uuid "81c51b21-cf4d-54d7-8ea3-bf125558d5d6" :answer/type :answer.type/math :answer/value "105" :db/ensure [:answer/validate]} {:db/id "q-6491/answer" :answer-field/id #uuid "39483401-c887-5eab-9097-84d46f3a7fff" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-6491/answer/e8fca892866a06a1ab302627b9de911942e4dfff7666b327843df0729f3939b1" :answer-field/choices ["q-6491/answer/e8fca892866a06a1ab302627b9de911942e4dfff7666b327843df0729f3939b1"] :db/ensure [:answer-field/validate]} {:db/id "q-6491" :question/id #uuid "51f91c45-43d2-5fcb-8a9f-a87826b50b9f" :question/math-academy-id "q-6491" :question/problem "What is the sum of the arithmetic series ${\\sum }_{n=1}^{10}(n+5)?$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the total number of terms.\n\nGiven the series ${\\sum }_{n=1}^{10}(n+5)$ in sigma notation, we note that\n\n- the total number of terms is $N=10$\n\n- the first term is ${a}_{1}=1+5=6$\n\n- the last term is ${a}_{10}=10+5=15$\n\nSubstituting these values into the formula for the sum of an arithmetic series, we obtain:\n\n$$\n\\begin{aligned}{S}_{10} & =\\frac{10}{2}(6+15) \\\\  & =5\\cdot 21 \\\\  & =105\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6491/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f6813b06-c450-599f-9b64-0588ec4142d9"] :knowledge-point/questions ["q-6491"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107794/answer/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "cdb382b0-20e2-5cac-aa00-9a26b5d81f32" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-107794/answer" :answer-field/id #uuid "81f67404-4664-57c5-a7ff-495c9b6fa304" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-107794/answer/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer-field/choices ["q-107794/answer/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f"] :db/ensure [:answer-field/validate]} {:db/id "q-107794" :question/id #uuid "e928ff1c-3648-56d1-a33b-01de56cefa49" :question/math-academy-id "q-107794" :question/problem "Calculate the sum of the first $15$ terms of the following arithmetic series.\n\n$$\n-1+(-\\frac{2}{5})+\\frac{1}{5}+\\frac{4}{5}+⋯\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nWe are given the total number of terms $N=15$ and the first term is ${a}_{1}=-1.$ Now, the common difference $d$ can be found as follows: \n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-\\frac{2}{5}-(-1) \\\\  & =\\frac{3}{5}\\end{aligned}\n$$\n\nSubstituting ${a}_{1}=-1$, $d=\\frac{3}{5}$, and $N=15$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{15} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{15}{2}(2(-1)+(15-1)\\cdot \\frac{3}{5}) \\\\  & =\\frac{15}{2}\\cdot (-2+8.4) \\\\  & =7.5\\cdot 6.4 \\\\  & =48\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107794/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d65ee5e-2211-5822-a99a-c49dfe4d2bbc"] :knowledge-point/questions ["q-107794"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107760/answer/277e858946cc5b4e84989da8e1d4a0ab1d893659106f0c55067d3e327cd34f5f" :answer/id #uuid "af802da0-192c-5cc1-a289-cc9a48a4a188" :answer/type :answer.type/math :answer/value "1\\,020" :db/ensure [:answer/validate]} {:db/id "q-107760/answer" :answer-field/id #uuid "894a8a89-af82-5b7b-828c-769b05f9756a" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-107760/answer/277e858946cc5b4e84989da8e1d4a0ab1d893659106f0c55067d3e327cd34f5f" :answer-field/choices ["q-107760/answer/277e858946cc5b4e84989da8e1d4a0ab1d893659106f0c55067d3e327cd34f5f"] :db/ensure [:answer-field/validate]} {:db/id "q-107760" :question/id #uuid "34c81d61-3e3f-5632-9eae-10ea56529564" :question/math-academy-id "q-107760" :question/problem "Calculate the sum of the first $20$ terms of the following arithmetic series. \n\n$$\n13+17+21+⋯\n$$\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nWe are given the total number of terms $N=20$ and the first term is ${a}_{1}=13.$ Now, the common difference $d$ can be found as follows: \n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =17-13 \\\\  & =4\\end{aligned}\n$$\n\nSubstituting ${a}_{1}=13$, $d=4$, and $N=20$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{20} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{20}{2}(2\\cdot 13+(20-1)\\cdot 4) \\\\  & =\\frac{20}{2}\\cdot (26+76) \\\\  & =\\frac{20}{2}\\cdot 102 \\\\  & =10\\cdot 102 \\\\  & =1\\,020\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107760/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d65ee5e-2211-5822-a99a-c49dfe4d2bbc"] :knowledge-point/questions ["q-107760"] :db/ensure [:knowledge-point/validate]} {:db/id "q-67177/answer/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" :answer/id #uuid "ceaf749a-0891-5b69-b7ba-0e8416117672" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id "q-67177/answer" :answer-field/id #uuid "a9f1ca61-45bb-5af2-b0d1-664076cee0bb" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-67177/answer/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" :answer-field/choices ["q-67177/answer/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997"] :db/ensure [:answer-field/validate]} {:db/id "q-67177" :question/id #uuid "6a41ce80-b8e8-5930-a1cd-1406aa9952fe" :question/math-academy-id "q-67177" :question/problem "An arithmetic series has ${a}_{1}=1$ and ${a}_{5}=3,$ where ${a}_{1}$ and ${a}_{5}$ are the first and fifth terms of the series, respectively. What is the sum of the first $13$ terms of the series?\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nWe know that ${a}_{5}=3.$ So, using the formula for the $n$th term of an arithmetic sequence, we have:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{5} & ={a}_{1}+(5-1)d \\\\ 3 & =1+4d \\\\ 4d & =2 \\\\ d & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow, substituting ${a}_{1}=1$, $d=\\frac{1}{2}$, and $N=13$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{13} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{13}{2}(2\\cdot 1+(13-1)\\cdot \\frac{1}{2}) \\\\  & =\\frac{13}{2}\\cdot (2+6) \\\\  & =\\frac{13}{2}\\cdot 8 \\\\  & =13\\cdot 4 \\\\  & =52\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-67177/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6133cdf6-6931-5363-918f-5ca8cd97b732"] :knowledge-point/questions ["q-67177"] :db/ensure [:knowledge-point/validate]} {:db/id "q-67183/answer/76bd63a07e56ae0e8b8cc5d81cffebb20d3c24e6fddb7fa021cea1aa6ba54705" :answer/id #uuid "ae38c78a-c742-5fee-b66d-6fd8a1173707" :answer/type :answer.type/math :answer/value "-405" :db/ensure [:answer/validate]} {:db/id "q-67183/answer" :answer-field/id #uuid "ec0376b2-78bc-5aa1-867c-d5690b732c26" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-67183/answer/76bd63a07e56ae0e8b8cc5d81cffebb20d3c24e6fddb7fa021cea1aa6ba54705" :answer-field/choices ["q-67183/answer/76bd63a07e56ae0e8b8cc5d81cffebb20d3c24e6fddb7fa021cea1aa6ba54705"] :db/ensure [:answer-field/validate]} {:db/id "q-67183" :question/id #uuid "32b30204-fdd2-5361-b71f-01c0c6f85c10" :question/math-academy-id "q-67183" :question/problem "An arithmetic series has ${a}_{4}=-11$ and ${a}_{11}=-39,$ where ${a}_{4}$ and ${a}_{11}$ are the fourth and eleventh terms of the series, respectively. \nFind the sum of the first $15$ terms of the series.\n\nAnswer: {{answer}}" :question/worked-solution "To calculate the sum of an arithmetic series, we use the formula\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSince we know two terms of the arithmetic series, we can find its common difference, as follows:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{11}-{a}_{4}}{11-4} \\\\  & =\\frac{-39-(-11)}{11-4} \\\\  & =\\frac{-28}{7} \\\\  & =-4\\end{aligned}\n$$\n\nNow, as ${a}_{4}=-11$, using the formula for the $n$th term, we can compute ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{4} & ={a}_{1}+(4-1)\\cdot (-4) \\\\ -11 & ={a}_{1}+(-12) \\\\ {a}_{1} & =1\\end{aligned}\n$$\n\nSubstituting ${a}_{1}=1$, $d=-4$, and $N=15$ into the above formula for ${S}_{N}$, we obtain:\n\n$$\n\\begin{aligned}{S}_{15} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\  & =\\frac{15}{2}(2\\cdot 1+(15-1)\\cdot (-4)) \\\\  & =\\frac{15}{2}\\cdot (2-56) \\\\  & =\\frac{15}{2}\\cdot (-54) \\\\  & =15\\cdot (-27) \\\\  & =-405\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-67183/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6133cdf6-6931-5363-918f-5ca8cd97b732"] :knowledge-point/questions ["q-67183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278249/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2d5d60ca-ce6e-5818-80f6-5e1f00a4ea32" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278249/field-1" :answer-field/id #uuid "ec5da6d3-c4f9-5015-b5e8-9cbbee98e21c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278249/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278249/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278249/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "983e13cd-944c-5cec-a2ca-63d865a191e0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-278249/field-2" :answer-field/id #uuid "e7d70ad1-2f32-53da-941b-6509c9c8c13c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278249/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-278249/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-278249" :question/id #uuid "af193db4-aced-5259-96b5-34c474664303" :question/math-academy-id "q-278249" :question/problem "In **ascending order**, the vertical asymptotes of $f(x)=\\frac{x+2}{{x}^{3}-3{x}^{2}}$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x+2}{{x}^{2}(x-3)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n{x}^{2}(x-3)=0\n$$\n\nThis gives the two solutions $x=0$ and $x=3.$ \n\nTherefore, in ascending order, the equations of the vertical asymptotes are $x=0$ and $x=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278249/field-1" "q-278249/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc"] :knowledge-point/questions ["q-278249"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278543/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f3b58eef-9b07-5e62-8dfd-06cdd9792dd0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-278543/field-1" :answer-field/id #uuid "e3d0c0c1-1bcd-51f6-8e4a-70dcf5913bcc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278543/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-278543/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-278543" :question/id #uuid "8e85e93c-3cfa-5608-97e9-59cee6be71eb" :question/math-academy-id "q-278543" :question/problem "The vertical asymptote of $f(x)=\\frac{{x}^{2}-x-6}{{x}^{2}+x-2}$ is $x=${{field-1}}." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-x-6}{{x}^{2}+x-2} \\\\  & =\\frac{(x-3)(x+2)}{(x-1)(x+2)} \\\\  & =\\frac{(x-3)\\cancel{(x+2)}}{(x-1)\\cancel{(x+2)}} \\\\  & =\\frac{x-3}{x-1}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\nx-1=0\n$$\n\nThis gives the solution $x=1.$\n\nTherefore, the equation of the vertical asymptote is $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-278543/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d"] :knowledge-point/questions ["q-278543"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278536/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "7cf57b73-5ad2-5eab-bf6d-fb4d095f013d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-278536/field-1" :answer-field/id #uuid "06303f5e-9a77-5a76-93dc-2cd6a3f05bfe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278536/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-278536/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-278536" :question/id #uuid "0df3445d-c4fe-56f7-8f72-bac44d3d2fd6" :question/math-academy-id "q-278536" :question/problem "The vertical asymptote of $f(x)=\\frac{{x}^{2}}{{x}^{3}-2{x}^{2}}$ is $x=${{field-1}}." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}}{{x}^{3}-2{x}^{2}} \\\\  & =\\frac{{x}^{2}}{{x}^{2}(x-2)} \\\\  & =\\frac{\\cancel{{x}^{2}}}{\\cancel{{x}^{2}}(x-2)} \\\\  & =\\frac{1}{x-2}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\nx-2=0\n$$\n\nThis gives the solution $x=2.$\n\nTherefore, the equation of the vertical asymptote is $x=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278536/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d"] :knowledge-point/questions ["q-278536"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113523/x/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "070582c7-9118-59ae-8fb8-cefbfc2e8342" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-113523/x" :answer-field/id #uuid "5d03e6ea-0b8d-5cd4-ad47-a3accdda2667" :answer-field/key "x" :answer-field/type :answer-field.type/blank :answer-field/correct "q-113523/x/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-113523/x/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-113523" :question/id #uuid "c37cf0e8-bbca-5ef1-ad17-b5e71311507a" :question/math-academy-id "q-113523" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{2x+4}{{x}^{3}-{x}^{2}+3x-3}.$\n\n$x =$: {{x}}" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2x+4}{{x}^{3}-{x}^{2}+3x-3} \\\\  & =\\frac{2(x+2)}{{x}^{2}(x-1)+3(x-1)} \\\\  & =\\frac{2(x+2)}{({x}^{2}+3)(x-1)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n({x}^{2}+3)(x-1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-1=0$ gives the solution $x=1.$\n\n- The equation ${x}^{2}+3=0$ has no real solutions.\n\nTherefore, the only vertical asymptote is $x=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113523/x"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9"] :knowledge-point/questions ["q-113523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278551/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e6bca57a-bbd7-5135-b4d1-5394e2880a4c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-278551/field-1" :answer-field/id #uuid "2bbf306f-0153-5b3f-845e-2e452538f0cf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278551/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-278551/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-278551" :question/id #uuid "5f2dc1ae-4892-50b9-981f-808f974086b6" :question/math-academy-id "q-278551" :question/problem "The vertical asymptote of $f(x)=\\frac{4}{2{x}^{3}-2{x}^{2}+x-1}$ is $x=${{field-1}}." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{4}{2{x}^{3}-2{x}^{2}+x-1} \\\\  & =\\frac{4}{2{x}^{2}(x-1)+(x-1)} \\\\  & =\\frac{4}{(2{x}^{2}+1)(x-1)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n(2{x}^{2}+1)(x-1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-1=0$ gives the solution $x=1.$\n\n- The equation $2{x}^{2}+1=0$ has no real solutions.\n\nTherefore, the vertical asymptote is $x=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278551/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9"] :knowledge-point/questions ["q-278551"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80680/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "58eeb9bd-8760-51d2-b2d7-e15ea6490c9b" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-80680/answer" :answer-field/id #uuid "878de882-ea49-5dfb-8a79-fdd6fee775dd" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-80680/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer-field/choices ["q-80680/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f"] :db/ensure [:answer-field/validate]} {:db/id "q-80680" :question/id #uuid "94f25a88-826e-5f93-a9c5-c2932f446753" :question/math-academy-id "q-80680" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x+1}{{x}^{2}+3x+4}.$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No vertical asymptotes\"." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x:$\n\nNote that the equation ${x}^{2}+3x+4=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={3}^{2}-4(1)(4) \\\\  & =9-16 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80680/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9"] :knowledge-point/questions ["q-80680"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113550/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "91ab451d-c25c-5f68-b886-6bf28b6f2808" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-113550/answer" :answer-field/id #uuid "1ca49ee6-7b3e-50f6-b6b8-2580dda21a0b" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-113550/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer-field/choices ["q-113550/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f"] :db/ensure [:answer-field/validate]} {:db/id "q-113550" :question/id #uuid "c1d02b50-c109-51fe-8f01-39a10ce1834c" :question/math-academy-id "q-113550" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}-3x}{{x}^{3}-3{x}^{2}+x-3}.$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No vertical asymptotes\"." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-3x}{{x}^{3}-3{x}^{2}+x-3} \\\\  & =\\frac{x(x-3)}{{x}^{2}(x-3)+(x-3)} \\\\  & =\\frac{x(x-3)}{(x-3)({x}^{2}+1)} \\\\  & =\\frac{x\\cancel{(x-3)}}{\\cancel{(x-3)}({x}^{2}+1)} \\\\  & =\\frac{x}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113550/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e"] :knowledge-point/questions ["q-113550"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113547/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "5b59731b-ccb9-53c5-82cf-caaaeebe66fd" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-113547/answer" :answer-field/id #uuid "6ce9b096-dc68-52ed-9491-356c80fb6f40" :answer-field/key "answer" :answer-field/type :answer-field.type/blank :answer-field/correct "q-113547/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer-field/choices ["q-113547/answer/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f"] :db/ensure [:answer-field/validate]} {:db/id "q-113547" :question/id #uuid "89758aa9-2520-5f08-bcf3-4dd38de13609" :question/math-academy-id "q-113547" :question/problem "Find all of the vertical asymptotes of the function $f(x)=\\frac{x+1}{{x}^{3}+{x}^{2}+x+1}.$\n\nAnswer: {{answer}}\n\nIf none exist, enter a phrase such as \"No vertical asymptotes\"." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x+1}{{x}^{3}+{x}^{2}+x+1} \\\\  & =\\frac{x+1}{{x}^{2}(x+1)+(x+1)} \\\\  & =\\frac{x+1}{(x+1)({x}^{2}+1)} \\\\  & =\\frac{\\cancel{x+1}}{\\cancel{(x+1)}({x}^{2}+1)} \\\\  & =\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ does not have any vertical asymptotes." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113547/answer"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e"] :knowledge-poin