23/selection/22c08457fa24ccb0ec82efe959810f460bc08df93e911830f49b39bfb33f01c7" "q-73023/selection/adfbe9c8cefc97e1b64e6ab08f81ce281114f64b98a003d11ec1d7380f60cb5c" "q-73023/selection/9ec99ca59da74de9937a88c0f06e501f02f7ae0990bb38dae722ec88f851f98a" "q-73023/selection/50b7ba5a7f889ae3b08f7a497c924af4822b5ffa8481b5c8e6b5e49437947579" "q-73023/selection/5f4d33a49352e358b235a25492a78a467c28d946fe899053ecacb5ee704bdab2"] :db/ensure [:answer-field/validate]} {:db/id "q-73023" :question/id #uuid "6c23c670-ac3c-5d23-92d6-e55e17344fd4" :question/math-academy-id "q-73023" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n+1)!}{(n-1)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+1)!=(n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n-1)!} & =\\frac{(n+1)\\cdot n\\cdot (n-1)!}{(n-1)!} \\\\  & =\\frac{(n+1)\\cdot n\\cdot \\cancel{(n-1)!}}{\\cancel{(n-1)!}} \\\\  & =n(n+1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73023/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28"] :knowledge-point/questions ["q-73023"] :db/ensure [:knowledge-point/validate]} {:db/id "q-6397/selection/3b588bd6af451366071fe5ed023b39d4796c98604ae734aeae722992d2d5afef" :answer/id #uuid "b73b0fee-d32e-56aa-ad42-83d1a7c3fa14" :answer/type :answer.type/math :answer/value "{k}^{2}+5k+6" :db/ensure [:answer/validate]} {:db/id "q-6397/selection/5fe169d0fdb25c41ba654dc9129aa33a8eb9dbdad90e48276ccf9c6bcfaaa167" :answer/id #uuid "3c092cc7-e57c-5648-9b3e-ba3be80ea005" :answer/type :answer.type/math :answer/value "{k}^{2}+2k+3" :db/ensure [:answer/validate]} {:db/id "q-6397/selection/10f2567a43e71120865ac1e8666a6899f2d9e78f0cc200357a020033fc7fa20c" :answer/id #uuid "9a4fc142-f8be-5f31-882a-e83b75f5f1ee" :answer/type :answer.type/math :answer/valu