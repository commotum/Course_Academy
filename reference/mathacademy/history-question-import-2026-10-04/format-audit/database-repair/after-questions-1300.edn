#{[{:db/id #edb/ref 17592186256432 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/title "Applying the Power Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5accb37d-9f8f-5be1-9aba-8d2a5cb9e479" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(9)" :db/id #edb/ref 17592186269297} {:answer/id #uuid "4bef347f-3b0f-5085-90fe-b4d819484c53" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186269298} {:answer/id #uuid "ada2d6c5-8ab3-54a7-a433-684cdfb0ccca" :answer/type {:db/ident :answer.type/math} :answer/value "(4)/(9)" :db/id #edb/ref 17592186269299} {:answer/id #uuid "04ccdb1f-c017-52da-8784-486ecd213bea" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(3)" :db/id #edb/ref 17592186269300} {:answer/id #uuid "bc8519cb-c807-551d-a3a8-e3122cf7979c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186269301}] :answer-field/correct {:answer/id #uuid "bc8519cb-c807-551d-a3a8-e3122cf7979c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186269301} :answer-field/id #uuid "82521da4-f9d1-51d9-aa31-a22c29237fa8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274134}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d37a6373-85f7-5021-93bf-bde115d91e8c" :question/math-academy-id "q-100235" :question/problem "Find ${lim}_{x\\to -1}\\frac{(2{x}^{4}+4)^{2}}{(x-2)^{3}}.$" :question/worked-solution "Here, we apply the quotient rule and the power rule to get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{(2{x}^{4}+4)^{2}}{(x-2)^{3}} & =\\frac{{lim}_{x\\to -1}(2{x}^{4}+4)^{2}}{{lim}_{x\\to -1}(x-2)^{3}} \\\\  & =\\frac{{({lim}_{x\\to -1}(2{x}^{4}+4))}^{2}}{{({lim}_{x\\to -1}(x-2))}^{3}} \\\\  & =\\frac{(2(-1)^{4}+4)^{2}}{(-1-2)^{3}} \\\\  & =\\frac{(6)^{2}}{(-3)^{3}} \\\\  & =\\frac{36}{-27} \\\\  & =-\\frac{4}{3}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256435 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/title "Applying the Power Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c61b47e-f06d-5592-b510-b7e154c698c1" :answer/type {:db/ident :answer.type/math} :answer/value "− (4)/(3)" :db/id #edb/ref 17592186269302} {:answer/id #uuid "ec1b07eb-1111-5eb7-921a-e8cb4f3c145c" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(9)" :db/id #edb/ref 17592186269303} {:answer/id #uuid "26c380fb-40e2-5faf-8c77-0ea444125cdc" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186269304} {:answer/id #uuid "3eb748c4-c22d-5727-b168-7d55635859e7" :answer/type {:db/ident :answer.type/math} :answer/value "216" :db/id #edb/ref 17592186269305} {:answer/id #uuid "49057f8c-7ff3-589b-8a2e-605131e6d366" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(3)" :db/id #edb/ref 17592186269306}] :answer-field/correct {:answer/id #uuid "3eb748c4-c22d-5727-b168-7d55635859e7" :answer/type {:db/ident :answer.type/math} :answer/value "216" :db/id #edb/ref 17592186269305} :answer-field/id #uuid "62f7d5fe-7bfc-59c6-90a2-44cf6450bfb9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274135}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "91317a16-9fb5-5d43-9550-4a0b2404efdf" :question/math-academy-id "q-100236" :question/problem "Find ${lim}_{y\\to -2}{({y}^{3}+2)}^{3}(2y+3).$" :question/worked-solution "Here, we apply the product rule and the power rule to get\n\n \n\n$$\n\\begin{aligned}{lim}_{y\\to -2}{({y}^{3}+2)}^{3}(2y+3) & =({lim}_{y\\to -2}({y}^{3}+2)^{3})\\cdot ({lim}_{y\\to -2}(2y+3)) \\\\  & ={({lim}_{y\\to -2}({y}^{3}+2))}^{3}\\cdot ({lim}_{y\\to -2}(2y+3)) \\\\  & =((-2)^{3}+2)^{3}\\cdot (2\\cdot (-2)+3) \\\\  & =(-6)^{3}\\cdot (-1) \\\\  & =216.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256438 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/title "Applying the Root Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7891540c-0602-534d-a552-7080dca3337b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269307} {:answer/id #uuid "e20e958a-146a-57b5-b101-08ac58295982" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269308} {:answer/id #uuid "d97d57de-b1d4-5806-bbb4-feefadadbf67" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269309} {:answer/id #uuid "07165a95-f5ed-5942-87a1-e1bd02a444d0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269310} {:answer/id #uuid "89856b02-d9df-50c3-adcd-3f335e8cdd62" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269311}] :answer-field/correct {:answer/id #uuid "89856b02-d9df-50c3-adcd-3f335e8cdd62" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269311} :answer-field/id #uuid "36ff6367-02a2-53d2-8d5d-28c2b83a678e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274136}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "855a5e48-e137-5598-94f7-f4832740f0f7" :question/math-academy-id "q-100264" :question/problem "Find ${lim}_{x\\to 4}(\\sqrt[3]{({x}^{2}-3x-5)^{5}}-\\sqrt{(2x-7)^{3}}).$" :question/worked-solution "Applying the sum and root rules, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 4}(\\sqrt[3]{({x}^{2}-3x-5)^{5}}-\\sqrt{(2x-7)^{3}}) & ={lim}_{x\\to 4}\\sqrt[3]{({x}^{2}-3x-5)^{5}}-{lim}_{x\\to 4}\\sqrt{(2x-7)^{3}} \\\\  & =\\sqrt[3]{{({lim}_{x\\to 4}({x}^{2}-3x-5))}^{5}}-\\sqrt{{({lim}_{x\\to 4}(2x-7))}^{3}} \\\\  & =\\sqrt[3]{({4}^{2}-3(4)-5)^{5}}-\\sqrt{(2(4)-7)^{3}} \\\\  & =\\sqrt[3]{(16-12-5)^{5}}-\\sqrt{(8-7)^{3}} \\\\  & =\\sqrt[3]{(-1)^{5}}-\\sqrt{(1)^{3}} \\\\  & =\\sqrt[3]{-1}-\\sqrt{1} \\\\  & =-1-1 \\\\  & =-2\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256444 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d447c3c-84ff-5b93-bd2f-c15ae436c679" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186269317} {:answer/id #uuid "a371523e-16c7-521d-be62-0087c3dd331e" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186269318} {:answer/id #uuid "4a4829c2-2b2e-5fa6-bbab-6517f7582558" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186269319} {:answer/id #uuid "4c483cc4-f1d7-5382-ad93-4d4be72743dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269320} {:answer/id #uuid "7d828b8d-d1e7-5e8c-82f5-93758a1369d8" :answer/type {:db/ident :answer.type/math} :answer/value "− 8" :db/id #edb/ref 17592186269321}] :answer-field/correct {:answer/id #uuid "4c483cc4-f1d7-5382-ad93-4d4be72743dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269320} :answer-field/id #uuid "b4630aa4-7d1c-5cd4-b378-2c19095dce69" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274138}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "beb0d5cc-39b2-586c-83f5-8cf543207207" :question/math-academy-id "q-100275" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e8aac08a40b3a318cb682afca1783a8d9563bf67f0b51bdff2ead8a9bf28117c.png)\n\nFind ${lim}_{x\\to -2}({x}^{3}+4)^{2}(4-2f(x))^{5}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph we get that ${lim}_{x\\to -2}f(x)=2.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to -2}({x}^{3}+4)^{2}(4-2f(x))^{5}={lim}_{x\\to -2}({x}^{3}+4)^{2}\\cdot {lim}_{x\\to -2}(4-2f(x))^{5}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}({x}^{3}+4)^{2} & ={({lim}_{x\\to -2}({x}^{3}+4))}^{2} \\\\  & ={((-2)^{3}+4)}^{2} \\\\  & ={(-8+4)}^{2} \\\\  & =16\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}(4-2f(x))^{5} & ={({lim}_{x\\to -2}(4-2f(x)))}^{5} \\\\  & ={(4-2(2))}^{5} \\\\  & ={(4-4)}^{5} \\\\  & =0.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}({x}^{3}+4)^{2}(4-2f(x))^{5} & ={({lim}_{x\\to -2}({x}^{3}+4))}^{2}{({lim}_{x\\to -2}(4-2f(x)))}^{5} \\\\  & =16\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256447 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd648131-3809-5f90-9cce-0833bcf13681" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186269322} {:answer/id #uuid "89198cc2-3758-55ec-a295-cf8087616eb5" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186269323} {:answer/id #uuid "47d2a495-7f91-5a72-96d4-fe49b064dbcd" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186269324} {:answer/id #uuid "fccb036b-9beb-5037-8246-6971aa791398" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186269325} {:answer/id #uuid "994a833e-9d91-5b80-8a6b-5adc59fb1d57" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269326}] :answer-field/correct {:answer/id #uuid "fccb036b-9beb-5037-8246-6971aa791398" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186269325} :answer-field/id #uuid "8832b1a6-43c6-50bd-896e-13192822c2b5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274139}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d37402e0-45e5-5794-8d62-3744bcf93a6d" :question/math-academy-id "q-100277" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ddf4b2d129022e27627afa1b0946f18ef7e98ab2ffe20dea6d609bedce65f84d.png)\n\nFind ${lim}_{x\\to \\,1}(1-3x)^{3}(3f(x)-4x)^{2}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,1}f(x)=2.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,1}(1-3x)^{3}(3f(x)-4x)^{2}={lim}_{x\\to \\,1}(1-3x)^{3}\\cdot {lim}_{x\\to \\,1}(3f(x)-4x)^{2}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(1-3x)^{3} & ={({lim}_{x\\to \\,1}(1-3x))}^{3} \\\\  & =(1-3(1))^{3} \\\\  & =(-2)^{3} \\\\  & =-8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(3f(x)-4x)^{2} & ={({lim}_{x\\to \\,1}(3f(x)-4x))}^{2} \\\\  & =(3(2)-4(1))^{2} \\\\  & ={2}^{2} \\\\  & =4\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(1-3x)^{3}(3f(x)-4x)^{2} & ={lim}_{x\\to \\,1}(1-3x)^{3}\\cdot {lim}_{x\\to \\,1}(3f(x)-4x)^{2} \\\\  & =(-8)\\cdot (4) \\\\  & =-32\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256480 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53710983-408a-5a6c-90ea-b34ff38359ea" :answer/type {:db/ident :answer.type/math} :answer/value "0.850" :db/id #edb/ref 17592186256482}] :answer-field/correct {:answer/id #uuid "53710983-408a-5a6c-90ea-b34ff38359ea" :answer/type {:db/ident :answer.type/math} :answer/value "0.850" :db/id #edb/ref 17592186256482} :answer-field/id #uuid "2da1e781-a4dc-50ed-92d1-c932089c7436" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256481}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "70c8405e-c25e-581b-907c-1bd10f59fc85" :question/math-academy-id "q-100674" :question/problem "Use a calculator to evaluate ${log}_{15}(10)$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{15}(10)$ by changing the base $15$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=15,$ $X=10,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{15}(10) & =\\frac{{log}_{10}(10)}{{log}_{10}(15)} \\\\  & =\\frac{\\operatorname{log}(10)}{\\operatorname{log}(15)} \\\\  & \\approx \\frac{1}{1.176\\,091} \\\\  & \\approx 0.850\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256483 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28c51bc3-a49c-557b-86c0-c22af227fbd2" :answer/type {:db/ident :answer.type/math} :answer/value "1.64" :db/id #edb/ref 17592186256485}] :answer-field/correct {:answer/id #uuid "28c51bc3-a49c-557b-86c0-c22af227fbd2" :answer/type {:db/ident :answer.type/math} :answer/value "1.64" :db/id #edb/ref 17592186256485} :answer-field/id #uuid "722b0dfa-4a0b-5cc5-9de6-df174301443b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256484}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c2f720ea-4efd-5c38-87f6-787d4de5f50b" :question/math-academy-id "q-100675" :question/problem "Use a calculator to evaluate ${log}_{8}(30)$ rounded to $2$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{8}(30)$ by changing the base $8$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=8,$ $X=30,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{8}(30) & =\\frac{{log}_{10}(30)}{{log}_{10}(8)} \\\\  & =\\frac{\\operatorname{log}(30)}{\\operatorname{log}(8)} \\\\  & \\approx \\frac{1.477\\,12}{0.903\\,09} \\\\  & \\approx 1.64\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256486 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28a98f76-933b-551d-9eab-cfe391420e07" :answer/type {:db/ident :answer.type/math} :answer/value "0.969" :db/id #edb/ref 17592186256488}] :answer-field/correct {:answer/id #uuid "28a98f76-933b-551d-9eab-cfe391420e07" :answer/type {:db/ident :answer.type/math} :answer/value "0.969" :db/id #edb/ref 17592186256488} :answer-field/id #uuid "601db05c-084b-5144-a803-3fc02ba6ccb5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256487}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2c2c3dd1-20e9-5368-9ec4-088bb43cb692" :question/math-academy-id "q-100676" :question/problem "Use a calculator to evaluate ${log}_{22}(20)$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{22}(20)$ by changing the base $22$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=22,$ $X=20,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{22}(20) & =\\frac{{log}_{10}(20)}{{log}_{10}(22)} \\\\  & =\\frac{\\operatorname{log}(20)}{\\operatorname{log}(22)} \\\\  & \\approx \\frac{1.301\\,030}{1.342\\,423} \\\\  & \\approx 0.969\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256535 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1e46ccf-27f8-55dd-93bd-3413e155db73" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269442} {:answer/id #uuid "06b4f67f-f41e-5f8c-bfef-b8310dd2d246" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186269443} {:answer/id #uuid "70ca35fe-1f1d-5b27-bd8c-1404ed4f916f" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186269444} {:answer/id #uuid "fd19f15b-fc86-5ba3-b1aa-02564d739d29" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186269445} {:answer/id #uuid "1795179b-0ae2-5f63-8aea-740d81778e05" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269446}] :answer-field/correct {:answer/id #uuid "1795179b-0ae2-5f63-8aea-740d81778e05" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269446} :answer-field/id #uuid "f87c1a4d-b069-512c-a3b7-f9fcd6079b99" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274163}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9ca4c60-8351-5109-8b21-60704b041116" :question/math-academy-id "q-101730" :question/problem "Consider the following table of values for $f(x).$ Knowing that the average rate of change of the function $f(x)$ on the interval $[-5,5]$ is $-1,$ find the value of $p.$ \n\n| $x$ | $\\,-5\\,$ | $\\,-3\\,$ | $\\,-1\\,$ | $\\,1\\,$ | $\\,3\\,$ | $\\,5\\,$ | $\\,7\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,4p+1\\,$ | $\\,2\\,$ | $\\,-3\\,$ | $\\,5\\,$ | $\\,10\\,$ | $\\,p+6\\,$ | $\\,8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(5)-f(-5)}{5-(-5)} \\\\  & =\\frac{(p+6)-(4p+1)}{5+5} \\\\  & =\\frac{5-3p}{10}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=-1$ on the interval $[-5,5].$ Thus, \n\n$$\n\\frac{5-3p}{10}=-1.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{5-3p}{10} & =-1 \\\\ 5-3p & =-10 \\\\ -3p & =-10-5 \\\\ -3p & =-15 \\\\ p & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256608 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d47bf5-d562-56c1-981f-81ce1bfb0996" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186256610}] :answer-field/correct {:answer/id #uuid "36d47bf5-d562-56c1-981f-81ce1bfb0996" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186256610} :answer-field/id #uuid "4a58f9f1-7f33-5634-9a0d-d31653864f38" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9cc04cfe-5c1c-58c0-b534-2ea8f4897bac" :question/math-academy-id "q-103216" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-2$ and ${a}_{2}=0,$ then ${a}_{3}=$\n\nAnswer: {{answer}}" :question/worked-solution "The recursive formula is\n\n$$\n{a}_{n+2}={a}_{n+1}+{a}_{n}.\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =0+(-2) \\\\ {a}_{3} & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256611 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ffa1a3f-0c84-5504-a5b3-3da85ca9f1c5" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186256613}] :answer-field/correct {:answer/id #uuid "8ffa1a3f-0c84-5504-a5b3-3da85ca9f1c5" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186256613} :answer-field/id #uuid "7c87d266-0ee7-554e-9da5-6db1aebe77e7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256612}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d61383ab-6ca0-5c21-90fc-da34d0ca7d99" :question/math-academy-id "q-103217" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=4$ and ${a}_{2}=5,$ then ${a}_{3}=$\n\nAnswer: {{answer}}" :question/worked-solution "The recursive formula is\n\n$$\n{a}_{n+2}={a}_{n+1}+{a}_{n}.\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =4+5 \\\\ {a}_{3} & =9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256614 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbb57b6c-f1e6-5978-b142-a098b7bb0037" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186256616}] :answer-field/correct {:answer/id #uuid "bbb57b6c-f1e6-5978-b142-a098b7bb0037" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186256616} :answer-field/id #uuid "309ffe6e-1a0d-5db1-8e6e-7d5c01c645e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256615}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0798bf8d-4438-5b94-a6a0-6a186fe4b314" :question/math-academy-id "q-103222" :question/problem "What is the fourth term of the following sequence?\n\n$$\nf(n+2)=f(n+1)+f(n)\\,,\\,f(1)=-2\\,,\\,f(2)=0,\\,n\\ge 1\n$$\n\nAnswer: {{answer}}" :question/worked-solution "The fourth term is represented by $f(4).$\n\nTo compute $f(4),$ we first need to compute $f(3).$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+2) & =f(n+1)+f(1) \\\\ f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =0+(-2) \\\\ f(3) & =-2\\end{aligned}\n$$\n\nNext, to compute $f(4),$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =-2+0 \\\\ f(4) & =-2\\end{aligned}\n$$\n\nTherefore, the fourth term of the sequence is $f(4)=-2.$"}] [{:db/id #edb/ref 17592186256617 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7149c441-adba-55e5-97a8-21d1a37322d9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256619}] :answer-field/correct {:answer/id #uuid "7149c441-adba-55e5-97a8-21d1a37322d9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256619} :answer-field/id #uuid "0531825e-15d9-55ac-8251-aacc8bb9e54a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256618}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "22ea45b9-f009-53ac-920f-698b600ba579" :question/math-academy-id "q-103223" :question/problem "If $f(n+2)=f(n+1)+f(n)$ with $f(1)=-1$ and $f(2)=1,$ then $f(3)=$\n\nAnswer: {{answer}}" :question/worked-solution "The recursive formula is\n\n$$\nf(n+2)=f(n+1)+f(n).\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =1+(-1) \\\\ f(3) & =0.\\end{aligned}\n$$\n\nHence, $f(3)=0.$"}] [{:db/id #edb/ref 17592186256659 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae1738d1-3261-5769-ab80-0edcc76ab6f3" :knowledge-point/title "Computing the Y-Intercept of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ab10a8-5037-5d55-a8d7-021528ae2a92" :answer/type {:db/ident :answer.type/math} :answer/value "− (9)/(4)" :db/id #edb/ref 17592186269587} {:answer/id #uuid "417b3f85-f6eb-52a2-b261-c983b3dd7786" :answer/type {:db/ident :answer.type/math} :answer/value "(9)/(4)" :db/id #edb/ref 17592186269588} {:answer/id #uuid "35b94af5-3d0e-533b-bea4-cc73ceff70e8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269589} {:answer/id #uuid "1a0ee879-78a7-52cc-85fc-60f0892fe5f6" :answer/type {:db/ident :answer.type/math} :answer/value "− (3)/(2)" :db/id #edb/ref 17592186269590} {:answer/id #uuid "0190884e-f7a4-5cca-a46d-726e0074d803" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269591}] :answer-field/correct {:answer/id #uuid "0190884e-f7a4-5cca-a46d-726e0074d803" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269591} :answer-field/id #uuid "8d817c38-8f19-5b03-badf-3ed29f68eb6a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274192}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "79f2ac8f-706d-5c75-bc5d-c89a9e2fab4f" :question/math-academy-id "q-106046" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/cd847efd8b91b1c622e93b1ee97035bcee803a79a603aa7b4beee8fae77abf06.png)\n\nThe equation of the curve above is $y=-{x}^{2}+2x+k.$ Find the value of $k.$" :question/worked-solution "Notice that if we substitute $x=0$ into the given equation, we obtain\n\n$$\n\\begin{aligned}y & =-{x}^{2}-x+k \\\\ y & =-(0)^{2}+2(0)+k \\\\ y & =k,\\end{aligned}\n$$\n\nmeaning that the curve intercepts the $y$-axis at the point $(0,k).$ Based on the graph, we see that we must have $k=5$ since our parabola intercepts the $y$-axis at $(0,5).$"}] [{:db/id #edb/ref 17592186256760 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6bae5cc-a920-50b7-932f-de5a6e7134cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186256762}] :answer-field/correct {:answer/id #uuid "f6bae5cc-a920-50b7-932f-de5a6e7134cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186256762} :answer-field/id #uuid "3f15f019-2ba2-5997-922b-a7d174fc823e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256761}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4051d6e3-232c-59f8-9d4f-58de8b478ba5" :question/math-academy-id "q-108374" :question/problem "Calculate ${log}_{125}(625)$ without using a calculator.\n\nAnswer: {{answer}}" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=125,$ and $X=625.$ Since both $a$ and $X$ are powers of $5,$ we set $b=5.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{125}(625) & =\\frac{{log}_{5}(625)}{{log}_{5}(125)} \\\\  & =\\frac{{log}_{5}({5}^{4})}{{log}_{5}({5}^{3})} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256795 :knowledge-point/_questions [{:knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d846de2-c4d6-5214-a2a5-446e5e20eb5b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-1)" :db/id #edb/ref 17592186269741} {:answer/id #uuid "347f2054-ddea-56eb-8bf6-755b31e9bf6f" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186269742} {:answer/id #uuid "07ea87fa-7e62-5ea1-9009-14cded3ef0b7" :answer/type {:db/ident :answer.type/math} :answer/value "y<x" :db/id #edb/ref 17592186269743} {:answer/id #uuid "2e524b0a-a103-5167-be37-487b042b3fff" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id #edb/ref 17592186269744} {:answer/id #uuid "ef310640-c1ea-556d-a1f6-75b836110991" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186269745}] :answer-field/correct {:answer/id #uuid "07ea87fa-7e62-5ea1-9009-14cded3ef0b7" :answer/type {:db/ident :answer.type/math} :answer/value "y<x" :db/id #edb/ref 17592186269743} :answer-field/id #uuid "3ed54e48-1eaa-5901-a3c4-a85aad81dd36" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274223}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "399c8dfe-cb86-5d6a-b44f-74bba4001d09" :question/math-academy-id "q-110080" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9cd032667b7138c5456cf9fa1a1cc954f1c8003779ac54fa58f6bbad296db4a1.png)\n\nWhat systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $2x+y=1.$ Since the line is dashed, the inequality is strict. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-2x+1.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>-2x+1,\n$$\n\n \n\nwhich we can rewrite as\n\n$$\n2x+y>1.\n$$\n\nNow consider the line $y=x.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies  *below* the line, the inequality is a \"less than\"  inequality. So the corresponding inequality is\n\n$$\ny<x.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}2x+y>1 \\\\ y<x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256848 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e18d451-4c7d-5649-9a73-0b00fa5d26e8" :knowledge-point/title "Finding the Negative Square Root of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c4dd54e-e87a-5f03-9ef8-773aadfb998e" :answer/type {:db/ident :answer.type/math} :answer/value "− 16\\textrm{i}" :db/id #edb/ref 17592186269825} {:answer/id #uuid "2ef07dc2-d0ad-5547-96ca-e60eeb16047a" :answer/type {:db/ident :answer.type/math} :answer/value "8\\textrm{i}" :db/id #edb/ref 17592186269826} {:answer/id #uuid "193c8647-ce57-5ad0-af28-0e93300d7baa" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269827} {:answer/id #uuid "edc546fe-dc20-51e1-8e94-21ab7e95c6d4" :answer/type {:db/ident :answer.type/math} :answer/value "− 8" :db/id #edb/ref 17592186269828} {:answer/id #uuid "7bbdc7dc-7acf-5e14-b505-87f31314e407" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{15}\\,\\text{i}" :db/id #edb/ref 17592186269829}] :answer-field/correct {:answer/id #uuid "7bbdc7dc-7acf-5e14-b505-87f31314e407" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{15}\\,\\text{i}" :db/id #edb/ref 17592186269829} :answer-field/id #uuid "23c46b83-6a1b-58ed-8147-66b819bb31fe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274240}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9a7660b-b110-5991-98aa-28a0f141dba4" :question/math-academy-id "q-111721" :question/problem "$-\\sqrt{-15}=$" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-15} & =-\\sqrt{15\\cdot (-1)} \\\\  & =-\\sqrt{15}\\cdot \\sqrt{-1} \\\\  & =-\\sqrt{15}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256851 :knowledge-point/_questions [{:knowledge-point/id #uuid "90028ddc-fde1-5c0c-8653-8e93f56c4057" :knowledge-point/title "Finding the Square Root of a Negative Number With Simplifications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f5f7be4-49fe-525d-afe7-206e2097b74a" :answer/type {:db/ident :answer.type/math} :answer/value "28\\textrm{i}" :db/id #edb/ref 17592186269830} {:answer/id #uuid "d99df58f-6218-56c0-aadd-f539b67d12a6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\textrm{i}" :db/id #edb/ref 17592186269831} {:answer/id #uuid "1619f967-37fc-5f50-a261-cdee02f23a84" :answer/type {:db/ident :answer.type/math} :answer/value "− 44\\textrm{i}" :db/id #edb/ref 17592186269832} {:answer/id #uuid "17a83ec0-c72e-517d-8ba6-5e25eada0659" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{5}\\,\\text{i}" :db/id #edb/ref 17592186269833} {:answer/id #uuid "3e605f6e-6404-5457-b8b9-c3c1adfa3755" :answer/type {:db/ident :answer.type/math} :answer/value "44\\textrm{i}" :db/id #edb/ref 17592186269834}] :answer-field/correct {:answer/id #uuid "17a83ec0-c72e-517d-8ba6-5e25eada0659" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{5}\\,\\text{i}" :db/id #edb/ref 17592186269833} :answer-field/id #uuid "d18dbd59-ef4e-5a3c-a90f-2f90816c47d0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274241}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b18cb4ef-a56d-5053-8e77-e1968dc8458c" :question/math-academy-id "q-111741" :question/problem "$\\sqrt{-180}=$" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nSince $180=36\\cdot 5,$ the given number can be rewritten as:\n\n$$\n\\begin{aligned}\\sqrt{-180} & =\\sqrt{180\\cdot (-1)} \\\\  & =\\sqrt{36\\cdot 5\\cdot (-1)} \\\\  & =\\sqrt{36}\\cdot \\sqrt{5}\\cdot \\sqrt{-1} \\\\  & =6\\sqrt{5}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256906 :knowledge-point/_questions [{:knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b13da7-1e7b-5834-88e3-b1bb6360b78d" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186269904} {:answer/id #uuid "49c98a43-16ff-5ce9-95e6-1d4adb5eded1" :answer/type {:db/ident :answer.type/math} :answer/value "\\textrm{i}" :db/id #edb/ref 17592186269905} {:answer/id #uuid "024d3d58-c0a8-5979-a1bc-540477508e24" :answer/type {:db/ident :answer.type/math} :answer/value "− \\textrm{i}" :db/id #edb/ref 17592186269906} {:answer/id #uuid "c51dc768-7591-5630-8133-1741d59e377e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269907} {:answer/id #uuid "29247ecc-9413-5d4e-8e1e-78e54d338992" :answer/type {:db/ident :answer.type/math} :answer/value "− 3\\textrm{i}" :db/id #edb/ref 17592186269908}] :answer-field/correct {:answer/id #uuid "c51dc768-7591-5630-8133-1741d59e377e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269907} :answer-field/id #uuid "6c556ee1-85fe-5aaa-835d-3e61ce611942" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274256}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dbdb58f0-667e-5aa7-8bff-41bad7b32ac0" :question/math-academy-id "q-113033" :question/problem "Simplify ${({\\text{i}}^{4})}^{26}.$" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{({\\text{i}}^{4})}^{26}=(1)^{26}=1.\n$$"}] [{:db/id #edb/ref 17592186256909 :knowledge-point/_questions [{:knowledge-point/id #uuid "aa5128ae-312f-5a12-9a19-9158fa7ddb9a" :knowledge-point/title "Raising i to a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5562264-28a3-5e43-a679-b89fe443ee4b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269909} {:answer/id #uuid "6bea00a2-959f-5db4-91ca-338fb094c567" :answer/type {:db/ident :answer.type/math} :answer/value "6\\textrm{i}" :db/id #edb/ref 17592186269910} {:answer/id #uuid "420bbc7b-bb2c-5b47-8773-0f9e2a535bd6" :answer/type {:db/ident :answer.type/math} :answer/value "− 6\\textrm{i}" :db/id #edb/ref 17592186269911} {:answer/id #uuid "70123383-cff8-5c1c-8188-989789e4c26d" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(6)\\textrm{i}" :db/id #edb/ref 17592186269912} {:answer/id #uuid "49e3fe72-5072-591f-ba3e-3b55fd4cfbf8" :answer/type {:db/ident :answer.type/math} :answer/value "− 6" :db/id #edb/ref 17592186269913}] :answer-field/correct {:answer/id #uuid "d5562264-28a3-5e43-a679-b89fe443ee4b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269909} :answer-field/id #uuid "6980e507-1175-50ea-8934-10a782e8e961" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274257}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "92f2f0b7-de4f-58b0-acaa-26e31d056305" :question/math-academy-id "q-113087" :question/problem "$9{\\text{i}}^{-4}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n9{\\text{i}}^{-4}=\\frac{9}{{\\text{i}}^{4}}.\n$$\n\nWe now recall that ${\\text{i}}^{4}=1.$ Therefore,\n\n$$\n\\frac{9}{{\\text{i}}^{4}}=\\frac{9}{1}=9.\n$$"}] [{:db/id #edb/ref 17592186257093 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eac8cd01-c52e-5e9c-80fc-114b81d2daa2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257095} {:answer/id #uuid "bcee4bb5-984a-5ee2-a65d-e06c31f0a27b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257096} {:answer/id #uuid "1b153650-8e00-5782-898a-033beb61c782" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257097} {:answer/id #uuid "d204e465-e283-57f1-a505-024b3e1f71fd" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257098} {:answer/id #uuid "b8d59aa3-7f16-5213-b7b6-2f801122b419" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257099} {:answer/id #uuid "3ab33868-c654-53bf-a8df-b79b7cd623cf" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257100} {:answer/id #uuid "b90288af-b97b-5a19-9f87-e5687fa1c355" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257101} {:answer/id #uuid "db2f86aa-b780-5dcb-ba7e-cb54eaab2841" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257102}] :answer-field/correct {:answer/id #uuid "1b153650-8e00-5782-898a-033beb61c782" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257097} :answer-field/id #uuid "cbdd74f5-16f9-550f-8f1e-4eb6c3e50781" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257094}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6afc5777-c42f-5d0a-931f-1320237e4acb" :question/math-academy-id "q-114605" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{7x+4}=-9$\nII. - $\\sqrt{3x-2}=3$\nIII. - $\\sqrt{9x-5}=-2$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only I and III state that a square is equal to a negative number. Therefore, equations I and III have no real solution.\n\nSo, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186257103 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3916e240-fb7f-535e-887a-c9e1c5a5d840" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257105} {:answer/id #uuid "33d66366-35e9-5641-878c-f406fa2cff58" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257106} {:answer/id #uuid "ce5ccb7b-514f-53e2-8cda-6932d842e9ff" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257107} {:answer/id #uuid "d56b2ee6-b94d-53ec-9172-b66232466e86" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257108} {:answer/id #uuid "0829c6b4-2de6-5d00-bbff-b771f8714cbb" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257109} {:answer/id #uuid "4fdeeb94-db0d-5f3f-8e17-5f724464727a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257110} {:answer/id #uuid "47659802-aae3-56c1-b33e-41edb3963bd2" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257111} {:answer/id #uuid "0eacfd5e-10a2-54d0-b2b3-050e45056245" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257112}] :answer-field/correct {:answer/id #uuid "4fdeeb94-db0d-5f3f-8e17-5f724464727a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257110} :answer-field/id #uuid "c061fa44-2283-5b2d-9a3a-45d58533becb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257104}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "55431f3f-1e50-5d2e-ae53-dc462ee5ce94" :question/math-academy-id "q-114606" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{7-2x}=-2$\nII. - $\\sqrt{x-3}=-7$\nIII. - $\\sqrt{6x-2}=5$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only I and II state that a square root is equal to a negative number. Therefore, equations I and II have no real solution.\n\nSo, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186257407 :knowledge-point/_questions [{:knowledge-point/id #uuid "46546a09-5d48-57d9-8166-5f9d8949c066" :knowledge-point/title "Estimating the Probability of the Intersection of Events"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e9a672f-a6bb-5fa6-ae17-fec0cfba16c2" :answer/type {:db/ident :answer.type/math} :answer/value "0.76" :db/id #edb/ref 17592186270452} {:answer/id #uuid "91d00942-622f-5365-93a2-b58370deff36" :answer/type {:db/ident :answer.type/math} :answer/value "0.60" :db/id #edb/ref 17592186270453} {:answer/id #uuid "2cbf547b-49c4-553e-837b-0e2e61899a87" :answer/type {:db/ident :answer.type/math} :answer/value "0.40" :db/id #edb/ref 17592186270454} {:answer/id #uuid "0cf919c0-9a0d-5777-8e9d-ccfc06a08109" :answer/type {:db/ident :answer.type/math} :answer/value "0.50" :db/id #edb/ref 17592186270455} {:answer/id #uuid "990d9cfc-02ca-5b22-9689-ee2675aebdca" :answer/type {:db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186270456}] :answer-field/correct {:answer/id #uuid "990d9cfc-02ca-5b22-9689-ee2675aebdca" :answer/type {:db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186270456} :answer-field/id #uuid "c1df8491-099d-5dc9-b1ab-ec5ccc5800a2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274366}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "02046115-abbf-5f23-b026-4fef673ef48b" :question/math-academy-id "q-120211" :question/problem "Some drinks of different sizes and flavors were sold during a school party. The two-way frequency table below summarizes the sold drinks.\n\n|  | Soda | Water | Coca-Cola | Fanta | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Small | $6$ | $7$ | $9$ | $8$ | $30$ |\n| Large | $5$ | $1$ | $7$ | $7$ | $20$ |\n| Totals | $11$ | $8$ | $16$ | $15$ | $50$ |\n\nEstimate the probability that a randomly selected sold drink is a small Fanta." :question/worked-solution "To estimate the probability that a randomly selected drink is a small Fanta, we\n\n- find the number at the intersection of the row **\"Small\"** and the column **\"Fanta\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Small\"** and the column **\"Fanta\"** is highlighted in the table below.\n\n|  | Soda | Water | Coca-Cola | Fanta | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Small | $6$ | $7$ | $9$ | $8$ | $30$ |\n| Large | $5$ | $1$ | $7$ | $7$ | $20$ |\n| Totals | $11$ | $8$ | $16$ | $15$ | $50$ |\n\nDividing by the total number of data points in the table $(50),$ we get\n\n$$\np=\\frac{8}{50}=0.16.\n$$"}] [{:db/id #edb/ref 17592186257415 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6956b58-5581-5221-8d4f-88ebde382f0c" :knowledge-point/title "Estimating Using Probabilities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "598390f0-875b-520e-bb8f-d7c8ae985b1f" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186270462} {:answer/id #uuid "2279b630-b92b-5b7a-b4f9-b8a170e1cbbd" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186270463} {:answer/id #uuid "9b079311-9bbb-53ba-bc2f-9f43177787d1" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270464} {:answer/id #uuid "67b38768-9ce2-52e1-8f34-6bfa5f37aad6" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186270465} {:answer/id #uuid "356b5a58-80d8-58e2-8939-55cdb9eddd6a" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186270466}] :answer-field/correct {:answer/id #uuid "67b38768-9ce2-52e1-8f34-6bfa5f37aad6" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186270465} :answer-field/id #uuid "ecacf83b-b19a-504a-bc95-5c418e491225" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274368}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a26858a-19aa-5552-b214-8bb2060beda5" :question/math-academy-id "q-120875" :question/problem "Researchers surveyed students in School A on which superpower they would most like to have. The results of this survey are summarized in the two-way frequency table below.\n\n|  | Flying | Invisibility | Other | Totals |\n| --- | --- | --- | --- | --- |\n| Female | $16$ | $18$ | $12$ | $46$ |\n| Male | $28$ | $12$ | $14$ | $54$ |\n| Totals | $44$ | $30$ | $26$ | $100$ |\n\nSchool B has $300$ students. Assuming the distribution of results is the same for both schools, estimate the number of School B students who are male and would choose to fly as their superpower." :question/worked-solution "To estimate the number of students who are male and would choose to fly as their superpower, we\n\n- find the number at the intersection of the row **\"Male\"** and the column **\"Flying\"**, and then\n\n- divide by the total number of data points at the table.\n\nThe number at the intersection of the row **\"Male\"** and the column **\"Flying\"** is highlighted in the table below.\n\n|  | Flying | Invisibility | Other | Totals |\n| --- | --- | --- | --- | --- |\n| Female | $16$ | $18$ | $12$ | $46$ |\n| Male | $28$ | $12$ | $14$ | $54$ |\n| Totals | $44$ | $30$ | $26$ | $100$ |\n\nDividing this number by the total number of data points in the table $(100),$ we get\n\n$$\np=\\frac{28}{100}=0.28.\n$$\n\nThis represents the estimated probability that a randomly selected School A student is a male and chooses to fly as his superpower.\n\nFinally, to find the estimated number of School B students who are male and would choose to fly as their superpower, we multiply the total number of School B students $(300)$ by the probability above:\n\n$$\n\\begin{aligned}n & =300\\cdot p \\\\  & =300\\cdot 0.28 \\\\  & =84\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257832 :knowledge-point/_questions [{:knowledge-point/id #uuid "f9eea0ca-bb7a-5e5c-b2d0-472305f2c490" :knowledge-point/title "Solving a Radical Equation When the Radical Is Not Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a5f301c-6f65-5b65-b875-a83ece63eb62" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-\\frac23)+2,2\\}" :db/id #edb/ref 17592186270822} {:answer/id #uuid "51e2e3ee-9bd2-53ed-894f-750d55124607" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-\\frac23)-2,2\\}" :db/id #edb/ref 17592186270823} {:answer/id #uuid "95b911a8-c75a-575b-9137-f4fbaf86f0f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-\\frac23,2\\}" :db/id #edb/ref 17592186270824} {:answer/id #uuid "0369ba53-f0a0-502d-bc47-9a5e9bb70ea0" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-\\frac23)+1,2\\}" :db/id #edb/ref 17592186270825} {:answer/id #uuid "f02e729a-d833-5fb6-a8ed-30096a8a48ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-\\frac23)-1,2\\}" :db/id #edb/ref 17592186270826}] :answer-field/correct {:answer/id #uuid "95b911a8-c75a-575b-9137-f4fbaf86f0f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-\\frac23,2\\}" :db/id #edb/ref 17592186270824} :answer-field/id #uuid "f7caf967-1e58-5611-8b97-b7075048e9dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274440}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b2810621-4a9f-5666-b439-842c3d34a484" :question/math-academy-id "q-131072" :question/problem "Solve $\\frac{\\sqrt{3{v}^{2}-4v+12}}{2}-2=0.$" :question/worked-solution "First, we isolate the term $\\frac{\\sqrt{3{v}^{2}-4v+12}}{2}$ by adding $2$ to both sides:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3{v}^{2}-4v+12}}{2}-2 & =0 \\\\ \\frac{\\sqrt{3{v}^{2}-4v+12}}{2} & =2\\end{aligned}\n$$\n\nNow, we isolate the square root by multiplying by $2$ on both sides:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3{v}^{2}-4v+12}}{2} & =2 \\\\ \\sqrt{3{v}^{2}-4v+12} & =4\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{3{v}^{2}-4v+12} & =4 \\\\ (\\sqrt{3{v}^{2}-4v+12})^{2} & ={4}^{2} \\\\ 3{v}^{2}-4v+12 & =16 \\\\ 3{v}^{2}-4v-4 & =0 \\\\ (3v+2)(v-2) & =0 \\\\ v & =-\\frac{2}{3},\\,2.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n- For $v=-\\frac{2}{3},$ we get\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3{(-\\frac{2}{3})}^{2}-4(-\\frac{2}{3})+12}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{\\sqrt{\\frac{4}{3}+\\frac{8}{3}+12}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{\\sqrt{16}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{4}{2}-2 & \\overset{?}{=}0 \\\\ 2-2 & \\overset{?}{=}0 \\\\ 0 & =0\\,\\,✓\\end{aligned}\n$$\n\n- For $v=2,$ we get\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3({2}^{2})-4(2)+12}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{\\sqrt{12-8+12}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{\\sqrt{16}}{2}-2 & \\overset{?}{=}0 \\\\ \\frac{4}{2}-2 & \\overset{?}{=}0 \\\\ 2-2 & \\overset{?}{=}0 \\\\ 0 & =0\\,\\,✓\\end{aligned}\n$$\n\nBoth $v=-\\frac{2}{3}$ and $v=2$ satisfy the original equation, so we can accept them both as solutions.\n\nTherefore, the solutions to $\\frac{\\sqrt{3{v}^{2}-4v+12}}{2}-2=0$ are $v=-\\frac{2}{3}$ and $v=2.$"}] [{:db/id #edb/ref 17592186257899 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1495831c-3fef-5728-be92-747772130cf0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186257901}] :answer-field/correct {:answer/id #uuid "1495831c-3fef-5728-be92-747772130cf0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186257901} :answer-field/id #uuid "3edf62ed-a7f4-5c27-aa57-65f9839c59ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257900}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e4dc0446-bdab-566c-a1ea-d739465a89a6" :question/math-academy-id "q-133092" :question/problem "Find the value of $f(x)$ at $x=4.$\n\n$f(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "We substitute $4$ for $x$ in the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =3\\sqrt{x+1} \\\\ f(4) & =3\\sqrt{4+1} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257902 :knowledge-point/_questions [{:knowledge-point/id #uuid "8daba5bf-5162-5779-9512-f22d0c8c0320" :knowledge-point/title "Evaluating Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9875c946-efae-5e29-b405-94de8fc3b770" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257904}] :answer-field/correct {:answer/id #uuid "9875c946-efae-5e29-b405-94de8fc3b770" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257904} :answer-field/id #uuid "d72cf376-ab9d-5294-aa38-2dbf171dad01" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257903}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4facbf96-c4c8-5f38-a25b-4b60a9204fda" :question/math-academy-id "q-133093" :question/problem "$h(4)\\,=\\,${{field-1}}" :question/worked-solution "Since $x=4$ is in the interval $x>3,$ we use the second branch of the piecewise function, namely $h(x)=2x-5:$\n\n$$\n\\begin{aligned}h(4) & =2(4)-5 \\\\  & =8-5 \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257905 :knowledge-point/_questions [{:knowledge-point/id #uuid "82d522a8-ae3c-5723-909e-540ddac1d9da" :knowledge-point/title "Finding the Roots Given a Function Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de2c845-8e92-58ae-94f4-adea8d283336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257907}] :answer-field/correct {:answer/id #uuid "8de2c845-8e92-58ae-94f4-adea8d283336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257907} :answer-field/id #uuid "b3867252-3213-5383-8a8b-466b65ee7411" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257906}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dac5550f-7f7a-5ad7-9089-a64688784e6f" :question/math-academy-id "q-133094" :question/problem "What is the root of the function $g(x)?$\n\nThe root is at $x\\,=$\n{{field-1}}" :question/worked-solution "The roots are the solutions to the equation $g(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}g(x) & =0 \\\\ 3x-2 & =0 \\\\ 3x & =2 \\\\ \\frac{3x}{3} & =\\frac{2}{3} \\\\ x & =\\frac{2}{3}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186257908 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ec3d139-c43a-5547-b0ae-147e41a55180" :knowledge-point/title "Identifying the Global Minimum of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "583857a8-0144-5997-9ea1-7321299750da" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257910}] :answer-field/correct {:answer/id #uuid "583857a8-0144-5997-9ea1-7321299750da" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257910} :answer-field/id #uuid "4123edc7-00ac-585c-92fc-0df39a14aa4e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257909}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1d26441c-ac3b-59d3-b427-084701de0ed6" :question/math-academy-id "q-133095" :question/problem "Using the graph of $y=h(x)$ on the interval $[-1,5],$ find the global minimum value of $h(x)$ on this interval.\n\n${h}_{min}\\,=\\,$\n{{field-1}}" :question/worked-solution "First, we recall the following definitions:\n\n* The global minimum of a function is the smallest value that the function attains on its domain. There can only be (at most) one global minimum.\n\n* A global minimum point of a function is a point $(x,y)$ where a function reaches a global minimum. There can be zero, one, or many global minimum points.\n\nFor our function, the minimum value reached by the function is $h(x)=-4.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/f76f7203f1ba17f8148bbc1140420034a631f46e6995a3bda5453ec3fd9a6f55.png)\n\nTherefore, the global minimum is ${h}_{min}=-4.$ The function reaches this value when $x=1,$ so the global minimum point is $(1,-4).$"}] [{:db/id #edb/ref 17592186257911 :knowledge-point/_questions [{:knowledge-point/id #uuid "2aafd8db-c723-508f-9ea3-43881f0d9140" :knowledge-point/title "Finding the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff8acee5-720e-5a47-8fb9-ed105708b61c" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3\\sqrt{x+1}-2" :db/id #edb/ref 17592186257913}] :answer-field/correct {:answer/id #uuid "ff8acee5-720e-5a47-8fb9-ed105708b61c" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3\\sqrt{x+1}-2" :db/id #edb/ref 17592186257913} :answer-field/id #uuid "90d22b92-cbdd-578f-962c-a6f0554738bc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257912}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "722596b3-9815-59b7-8c7b-48c557696a4b" :question/math-academy-id "q-133096" :question/problem "Write the expression for the function $(f+g)(x)$ in terms of $x.$\n\n$(f+g)(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "We find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(3\\sqrt{x+1})+(3x-2) \\\\  & =3x+3\\sqrt{x+1}-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257914 :knowledge-point/_questions [{:knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd0a4d20-c266-5180-8d8c-aa495464977f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186257916}] :answer-field/correct {:answer/id #uuid "dd0a4d20-c266-5180-8d8c-aa495464977f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186257916} :answer-field/id #uuid "ba7eefcc-e5e0-599e-a5d6-7a86d1ced9d4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257915}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "94dd89e7-71bf-5758-b5b6-2bb250a0931a" :question/math-academy-id "q-133097" :question/problem "Find the value of $(f/h)(4).$\n\n$(f/h)(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "The notation $(f/h)(x)$ means the quotient of the functions $f(x)$ and $h(x).$ \n\nTo evaluate $(f/h)(4),$ we need to divide $f(4)$ by $h(4).$\n\nEarlier, we found the following values:\n\n$$\n\\begin{aligned}f(4) & =3\\sqrt{5} \\\\ h(4) & =3\\end{aligned}\n$$\n\n \n\nTherefore, we obtain\n\n$$\n(f/h)(4)=\\frac{f(4)}{h(4)}=\\frac{3\\sqrt{5}}{3}=\\sqrt{5}.\n$$"}] [{:db/id #edb/ref 17592186257917 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f954ff1-3f02-5fb1-aca2-5911d5636167" :knowledge-point/title "Evaluating a Composite Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ec85d45-705f-58f2-9ecb-beeb96887d3c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257919}] :answer-field/correct {:answer/id #uuid "2ec85d45-705f-58f2-9ecb-beeb96887d3c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257919} :answer-field/id #uuid "1ba2c0da-5e9e-5cee-afa1-b64d8b64f6c9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257918}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "db7e3081-13ac-5bac-97f6-3cdfeabac772" :question/math-academy-id "q-133098" :question/problem "$(f∘h)(4)\\,=\\,${{field-1}}" :question/worked-solution "The expression $(f∘h)(4)$ is equivalent to $f(h(4)).$\n\nPreviously, we found that \n\n$$\nh(4)=3.\n$$\n\nThen, we substitute $x=3$ into $f(x).$ This gives\n\n$$\n\\begin{aligned}f(h(4)) & =f(3) \\\\  & =3\\sqrt{3+1} \\\\  & =3\\cdot \\sqrt{4} \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257920 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ebb0209-904f-598a-9ff2-ab9d4d0cabca" :knowledge-point/title "Identifying the Range of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b93ae47e-c9a4-5c74-b810-01aab25b220c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257922}] :answer-field/correct {:answer/id #uuid "b93ae47e-c9a4-5c74-b810-01aab25b220c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257922} :answer-field/id #uuid "9082cc46-6619-50c2-b109-27b601c47f11" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257921} {:answer-field/choices [{:answer/id #uuid "59a2bc2f-fe61-5929-96b2-b7033bdcf072" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257924}] :answer-field/correct {:answer/id #uuid "59a2bc2f-fe61-5929-96b2-b7033bdcf072" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257924} :answer-field/id #uuid "7d698e12-f6f5-591d-a04a-2546aa9ce49f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257923}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a61a79f3-a45a-5593-b4bc-eb0ce92364fe" :question/math-academy-id "q-133099" :question/problem "Consider the function $g(x)$ for $x\\in [0,2].$ What is its range over the given domain?\n\n{{field-1}}\n$\\le \\,g(x)\\,\\le $\n{{field-2}}" :question/worked-solution "First, we graph the function $g(x)=3x-2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/47eb01a66773e5cf2b223cc3f8f4ff02caa424170a8e090ec0b1e45ed6d69741.png)\n\nThen, we find the lowest and highest $y$-values in the graph over the domain $x\\in [0,2].$\n\n* The lowest $y$ value is $-2.$ This occurs at the point $(0,-2).$\n\n* The highest $y$ value is $4.$ This occurs at the point $(2,4).$\n\nThe function covers all the $y$-values between $-2$ and $4,$ including the endpoints.\n\nTherefore, the range is $-2\\le y\\le 4,$ which can also be written as \n\n$$\n-2\\le g(x)\\le 4.\n$$"}] [{:db/id #edb/ref 17592186257925 :knowledge-point/_questions [{:knowledge-point/id #uuid "06e51d62-ad2a-51c3-b276-eeb60022ab48" :knowledge-point/title "Computing an Inverse Function Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "607fe3ff-c70e-5e90-8be3-b217f42489ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257927}] :answer-field/correct {:answer/id #uuid "607fe3ff-c70e-5e90-8be3-b217f42489ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186257927} :answer-field/id #uuid "c06794a5-596c-5119-8f53-ec6c5b564819" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257926}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1c61acd1-ade2-5a44-8b2b-c8e5c8ab07c5" :question/math-academy-id "q-133100" :question/problem "Suppose that $r(x)=\\frac{1}{3}x+k$ is the inverse of $g(x).$ What is the value of $k?$\n\n$k\\,=\\,$\n{{field-1}}" :question/worked-solution "If $r$ is the inverse of $g,$ then \n\n$$\nr(g(x))=x.\n$$\n\nTo find $r(g(x)),$ we write down the function $r$ and replace every occurrence of $x$ with $g(x):$\n\n$$\n\\begin{aligned}r(x) & =\\frac{1}{3}x+k \\\\ r(g(x)) & =\\frac{1}{3}g(x)+k\\end{aligned}\n$$\n\nThen, we substitute $g(x)=3x-2$ into the right-hand side of our expression and simplify, as follows:\n\n$$\n\\begin{aligned}r(g(x)) & =\\frac{1}{3}g(x)+k \\\\  & =\\frac{1}{3}(3x-2)+k \\\\  & =x-\\frac{2}{3}+k\\end{aligned}\n$$\n\nHowever, we know that $r(g(x))=x.$ Equating the expression above with $x$ and solving for $k$ gives\n\n$$\n\\begin{aligned}r(g(x)) & =x \\\\ x-\\frac{2}{3}+k & =x \\\\ \\cancel{x}-\\frac{2}{3}+k & =\\cancel{x} \\\\ -\\frac{2}{3}+k & =0 \\\\ k & =\\frac{2}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258021 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ecc42a-3c19-5054-a951-8172f69d58bc" :answer/type {:db/ident :answer.type/math} :answer/value "-(4x+2)" :db/id #edb/ref 17592186270857} {:answer/id #uuid "b0e0c21b-495e-5bad-91e4-d7a1381ca48d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(4x+2)" :db/id #edb/ref 17592186270858} {:answer/id #uuid "47c90bfd-0022-5c1b-888a-eb10b47d7483" :answer/type {:db/ident :answer.type/math} :answer/value "2(4x+2)" :db/id #edb/ref 17592186270859} {:answer/id #uuid "1181b424-7966-518b-a2db-b69834c7959e" :answer/type {:db/ident :answer.type/math} :answer/value "4x+2" :db/id #edb/ref 17592186270860} {:answer/id #uuid "0768e0c2-4224-51f5-8594-87b2cd14db7c" :answer/type {:db/ident :answer.type/math} :answer/value "3(4x+2)" :db/id #edb/ref 17592186270861}] :answer-field/correct {:answer/id #uuid "1181b424-7966-518b-a2db-b69834c7959e" :answer/type {:db/ident :answer.type/math} :answer/value "4x+2" :db/id #edb/ref 17592186270860} :answer-field/id #uuid "3010a715-4b7a-551f-9851-a72ad6edf6dc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274447}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "807e93c4-5bb4-5de5-8fbc-1aec915f7b84" :question/math-academy-id "q-13585" :question/problem "If $f(x)=x+4$ and $g(x)=-3x+2,$ then $(f-g)(x)=$" :question/worked-solution "The notation $(f-g)(x)$ means the difference of the functions $f(x)$ and $g(x).$\n\nTo find the difference of the two functions, we subtract $g(x)$ from $f(x):$\n\n$$\n\\begin{aligned}(f-g)(x) & =f(x)-g(x) \\\\  & =(x+4)-(-3x+2) \\\\  & =(x+3x)+(4-2) \\\\  & =4x+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258111 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/title "Calculating the Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eaf157d-d6d6-5860-88e6-da99c1262636" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(5\\sqrt{3})" :db/id #edb/ref 17592186270972} {:answer/id #uuid "452dc9c3-d715-5893-bbec-edaec140913e" :answer/type {:db/ident :answer.type/math} :answer/value "2(5\\sqrt{3})" :db/id #edb/ref 17592186270973} {:answer/id #uuid "8af0a805-baa8-54ba-b3a6-6b6538ff758d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270974} {:answer/id #uuid "33941559-fc2f-58a8-9b28-987f6968484f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186270975} {:answer/id #uuid "9eb6c455-0ade-5892-950d-f278a30320ed" :answer/type {:db/ident :answer.type/math} :answer/value "-(5\\sqrt{3})" :db/id #edb/ref 17592186270976}] :answer-field/correct {:answer/id #uuid "33941559-fc2f-58a8-9b28-987f6968484f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186270975} :answer-field/id #uuid "0f0e216b-743d-5778-b6b8-5dda79c1b92d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274470}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e6b0a5be-d880-5387-a7aa-c743ad533f16" :question/math-academy-id "q-14152" :question/problem "What is the distance between the points $(-\\sqrt{3},2\\sqrt{3})$ and $(3\\sqrt{3},5\\sqrt{3})?$" :question/worked-solution "In this case, we have ${{(-\\sqrt{3},2\\sqrt{3})}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(3\\sqrt{3},5\\sqrt{3})}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{{(3\\sqrt{3}-(-\\sqrt{3}))}^{2}+{(5\\sqrt{3}-2\\sqrt{3})}^{2}} \\\\  & =\\sqrt{(4\\sqrt{3})^{2}+(3\\sqrt{3})^{2}} \\\\  & =\\sqrt{16(3)+9(3)} \\\\  & =\\sqrt{48+27} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258114 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d42bd8d-444d-5182-a41c-f500f5accc70" :answer/type {:db/ident :answer.type/math} :answer/value "-((x-6)^{2}-8)" :db/id #edb/ref 17592186270977} {:answer/id #uuid "bc7edb92-d33a-53d8-831a-19a0fcfb69ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}((x-6)^{2}-8)" :db/id #edb/ref 17592186270978} {:answer/id #uuid "abf46c1d-ac65-5b51-a5f2-44092fbc91cf" :answer/type {:db/ident :answer.type/math} :answer/value "2((x-6)^{2}-8)" :db/id #edb/ref 17592186270979} {:answer/id #uuid "00165c84-bdf4-589f-adc4-4e7c8bcd0d9b" :answer/type {:db/ident :answer.type/math} :answer/value "3((x-6)^{2}-8)" :db/id #edb/ref 17592186270980} {:answer/id #uuid "c80664ba-9794-5067-9b4f-00261ad6b126" :answer/type {:db/ident :answer.type/math} :answer/value "(x-6)^{2}-8" :db/id #edb/ref 17592186270981}] :answer-field/correct {:answer/id #uuid "c80664ba-9794-5067-9b4f-00261ad6b126" :answer/type {:db/ident :answer.type/math} :answer/value "(x-6)^{2}-8" :db/id #edb/ref 17592186270981} :answer-field/id #uuid "b8b0f9db-72a5-532c-bcbc-11c2cb5c4634" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274471}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec2a46d4-91b6-5d7c-83d9-c6d69abedfb0" :question/math-academy-id "q-141615" :question/problem "Complete the square on the quadratic expression ${x}^{2}-12x+28.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 6x+28\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${6}^{2},$ writing the constant term $28$ last:\n\n$$\n{{x}^{2}-2\\cdot 6x+{6}^{2}}_{⏟}-\\,{6}^{2}+28\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-6)^{2}-{6}^{2}+28\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x-6)^{2}-8.\n$$"}] [{:db/id #edb/ref 17592186258716 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "714781e3-e064-598f-ade4-ba11020a9a06" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186271240} {:answer/id #uuid "f92e04b8-f321-5b0e-be34-d07f8843c52d" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186271241} {:answer/id #uuid "528d4f20-ed18-5f9f-b5db-66f74d7bec10" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186271242} {:answer/id #uuid "371e89f6-0daf-544e-8eb3-8591a31de8c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186271243} {:answer/id #uuid "7a8fd3d1-fb81-5b8a-80a5-c4873e2a662e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271244}] :answer-field/correct {:answer/id #uuid "371e89f6-0daf-544e-8eb3-8591a31de8c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186271243} :answer-field/id #uuid "f42f36bf-b6c4-56ff-ae8c-bb6575614f7c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274526}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f7fded4-a7f4-5dbc-a96e-2d5c3e995127" :question/math-academy-id "q-17280" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/5e8383b56998815d4c981e72c946fdbf8de77ece15e52ca2ed5c7371c8f2c8af.png)" :question/worked-solution "Using the power and quotient rules, we can rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}{(\\frac{4f(x)-12}{{x}^{2}-2x+2})}^{2} & ={(\\frac{{lim}_{x\\to 3}(4f(x)-12)}{{lim}_{x\\to 3}({x}^{2}-2x+2)})}^{2}\\end{aligned}\n$$\n\nThe above is true provided that  ${lim}_{x\\to 3}f(x)$ exists.\n\nWe find from the graph that ${lim}_{x\\to 3}f(x)=4.$ We calculate the limits of the numerator and denominator, separately.\n\n$$\n{lim}_{x\\to 3}(4f(x)-12)=4(4)-12=4\n$$\n\nand\n\n$$\n{lim}_{x\\to 3}({x}^{2}-2x+2)={3}^{2}-2(3)+2=5\n$$\n\nSo we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 3}{(\\frac{4f(x)-12}{{x}^{2}-2x+2})}^{2} & ={(\\frac{{lim}_{x\\to 3}(4f(x)-12)}{{lim}_{x\\to 3}({x}^{2}-2x+2)})}^{2} \\\\  & ={(\\frac{4}{5})}^{2} \\\\  & =\\frac{16}{25}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258778 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41df9a82-1e7c-544a-98b5-e17a2104c045" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)-1,4\\}" :db/id #edb/ref 17592186271330} {:answer/id #uuid "96c9d935-d143-53a9-8736-8a3a77279473" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-4,4\\}" :db/id #edb/ref 17592186271331} {:answer/id #uuid "162f9161-3fb5-55ce-a310-22f3d4dbc415" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)+2,4\\}" :db/id #edb/ref 17592186271332} {:answer/id #uuid "ded636f2-8892-5349-b71a-03d8e983f3ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)+1,4\\}" :db/id #edb/ref 17592186271333} {:answer/id #uuid "fa194e92-b6f6-565e-a7ad-6772b92691d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)-2,4\\}" :db/id #edb/ref 17592186271334}] :answer-field/correct {:answer/id #uuid "96c9d935-d143-53a9-8736-8a3a77279473" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-4,4\\}" :db/id #edb/ref 17592186271331} :answer-field/id #uuid "07b17aee-b716-574d-bfdd-d1a221a2b6a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274544}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "149a5bb5-23b4-56cd-ac8a-edc3c7f35e91" :question/math-academy-id "q-19154" :question/problem "Consider the following table of values for $f(x).$ Knowing that the average rate of change of the function $f(x)$ on the interval $[1,23]$ is $1.5,$ find the value of $p.$\n\n| $x$ | $\\,-3\\,$ | $\\,1\\,$ | $\\,7\\,$ | $\\,13\\,$ | $\\,18\\,$ | $\\,21\\,$ | $\\,23\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,3\\,$ | $\\,-{p}^{2}-4\\,$ | $\\,-13\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,9\\,$ | $\\,13\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(23)-f(1)}{23-1} \\\\  & =\\frac{13-(-{p}^{2}-4)}{22} \\\\  & =\\frac{{p}^{2}+17}{22}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=1.5$ on the interval $[1,23].$ Thus, \n\n$$\n\\frac{{p}^{2}+17}{22}=1.5.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{{p}^{2}+17}{22} & =1.5 \\\\ {p}^{2}+17 & =33 \\\\ {p}^{2} & =33-17 \\\\ {p}^{2} & =16 \\\\ p & =\\pm 4.\\end{aligned}\n$$\n\nTherefore, we conclude that $p=-4$ or $p=4.$"}] [{:db/id #edb/ref 17592186258783 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9acd7573-dbc5-5c17-af7d-cef584464ac0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271335} {:answer/id #uuid "ec48773d-2817-5a65-9755-84884a0c1e9c" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186271336} {:answer/id #uuid "5a5dae0a-a55c-55ff-bcb7-001d670390de" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186271337} {:answer/id #uuid "8dbea336-fcba-5425-b870-71d31d38a07a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186271338} {:answer/id #uuid "f16e8bc0-f978-505a-b75d-9d6b20c6ada7" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186271339}] :answer-field/correct {:answer/id #uuid "8dbea336-fcba-5425-b870-71d31d38a07a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186271338} :answer-field/id #uuid "927d367f-7e72-5deb-b744-0d5f42ff4640" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2e3ab4e9-a63e-5231-88df-c45b46948041" :question/math-academy-id "q-19160" :question/problem "Consider the following table of values for $f(x).$ Knowing that the average rate of change of the function $f(x)$ on the interval $[-2,3]$ is $3,$ find the value of $p.$ \n\n| $x$ | $\\,-5\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,3\\,$ | $\\,5\\,$ | $\\,7\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,-11\\,$ | $\\,2p-1\\,$ | $\\,-5\\,$ | $\\,4\\,$ | $\\,p+10\\,$ | $\\,7\\,$ | $\\,8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(3)-f(-2)}{3-(-2)} \\\\  & =\\frac{(p+10)-(2p-1)}{3+2} \\\\  & =\\frac{11-p}{5}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=3$ on the interval $[-2,3].$ Thus, \n\n$$\n\\frac{11-p}{5}=3.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{11-p}{5} & =3 \\\\ 11-p & =15 \\\\ -p & =15-11 \\\\ -p & =4 \\\\ p & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258839 :knowledge-point/_questions [{:knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/title "Calculating the Average Rate of Change of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216b2984-e113-5bba-88d5-6705245bb2e3" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186271405} {:answer/id #uuid "4e01ed42-8b12-5f4e-a716-3c4d79ced27b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271406} {:answer/id #uuid "cc863713-9b7f-52a8-ac4f-4e1113eb33c6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271407} {:answer/id #uuid "65064dea-4b64-5c6a-b8bd-f1e69010a7df" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186271408} {:answer/id #uuid "fbb6a7bb-2aa6-56b0-88bb-d9561a113c56" :answer/type {:db/ident :answer.type/math} :answer/value "− (3)/(2)" :db/id #edb/ref 17592186271409}] :answer-field/correct {:answer/id #uuid "65064dea-4b64-5c6a-b8bd-f1e69010a7df" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186271408} :answer-field/id #uuid "a902d16d-4c72-5d55-a77d-d6a03f355276" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274559}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a2e31816-43ec-559b-a472-2ed0efb972fe" :question/math-academy-id "q-20823" :question/problem "A curve is defined as $y=2{x}^{3}-{x}^{2}+5x.$ Find the average rate of change of $y$ over the interval $[1,4].$" :question/worked-solution "Let $f(x)=2{x}^{3}-{x}^{2}+5x.$  Applying the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δy}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(4)-f(1)}{4-1} \\\\  & =\\frac{[2({4}^{3})-{4}^{2}+5(4)]-[2({1}^{3})-{1}^{2}+5(1)]}{3} \\\\  & =\\frac{132-6}{3} \\\\  & =42.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258845 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c28efa-aa14-58ba-b3dc-a75498363ec7" :answer/type {:db/ident :answer.type/math} :answer/value "2(187)" :db/id #edb/ref 17592186271415} {:answer/id #uuid "a828d8b8-063d-508c-a03b-5152205651be" :answer/type {:db/ident :answer.type/math} :answer/value "-(187)" :db/id #edb/ref 17592186271416} {:answer/id #uuid "cafa2323-bc0b-5f83-8ec4-06c7edd6e0fb" :answer/type {:db/ident :answer.type/math} :answer/value "3(187)" :db/id #edb/ref 17592186271417} {:answer/id #uuid "1141eecd-d100-5c84-b187-14ec6e0297db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(187)" :db/id #edb/ref 17592186271418} {:answer/id #uuid "1e88fa21-c4e3-5322-b893-b75224e1130a" :answer/type {:db/ident :answer.type/math} :answer/value "187" :db/id #edb/ref 17592186271419}] :answer-field/correct {:answer/id #uuid "1e88fa21-c4e3-5322-b893-b75224e1130a" :answer/type {:db/ident :answer.type/math} :answer/value "187" :db/id #edb/ref 17592186271419} :answer-field/id #uuid "f992a474-3940-54b6-9f30-2d327d5a6663" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274561}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "95d04696-3038-5931-a2a7-b332a1053193" :question/math-academy-id "q-21123" :question/problem "The number of machines infected by a computer virus is represented by the function $f(t)=4{t}^{3}-2{t}^{2}+5t+11,$ where $t$ is the time, in days, since the virus was first detected. What is the average rate of growth of $f(t)$ over the first week?" :question/worked-solution "Let $f(t)=4{t}^{3}-2{t}^{2}+5t+11$ be the number of machines infected by the computer virus after $t$ days. To find the average rate of growth of $f(t)$ over the first week, we use the average rate of change formula on the interval $[0,7]$:\n\n$$\n\\begin{aligned}\\frac{Δf}{Δt} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(7)-f(0)}{7-0} \\\\  & =\\frac{[4(7)^{3}-2(7)^{2}+5(7)+11]-[4(0)^{3}-2(0)^{2}+5(0)+11]}{7} \\\\  & =\\frac{1309}{7} \\\\  & =187\\end{aligned}\n$$\n\nTherefore, the average rate of growth over the first week is $187$ machines per day."}] [{:db/id #edb/ref 17592186258922 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b073db-b437-5dc9-988f-2b5987716d4a" :answer/type {:db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186258924}] :answer-field/correct {:answer/id #uuid "66b073db-b437-5dc9-988f-2b5987716d4a" :answer/type {:db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186258924} :answer-field/id #uuid "de6e5463-ac4d-5d4f-a5c3-955e6ac78200" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258923}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d77c7163-8f4b-52b0-9277-4b1a28b029a1" :question/math-academy-id "q-218682" :question/problem "The population $P(t)$ of a city, measured in thousands of people, $t$ years after $2012,$ is given by the expression $P(t)=5{t}^{2}+t.$\n\nThe average annual population growth rate from $2012$ to $2020$ was\n{{field-1}}\nthousand people." :question/worked-solution "Let $P(t)=5{t}^{2}+t$ be the population of the city, in thousands of people, $t$ years after $2012.$ Since $2020$ is $8$ years after $2012$, to find the average annual population growth rate from $2012$ to $2020$, we use the average rate of change formula on the interval $[0,8]$:\n\n$$\n\\begin{aligned}\\frac{Δf}{Δt} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(8)-f(0)}{8-0} \\\\  & =\\frac{(5({8}^{2})+8)-(5({0}^{2})+0)}{8} \\\\  & =\\frac{328-0}{8} \\\\  & =41\\end{aligned}\n$$\n\nTherefore, The average annual population growth rate from $2012$ to $2020$ was $41$ thousand people."}] [{:db/id #edb/ref 17592186258949 :knowledge-point/_questions [{:knowledge-point/id #uuid "87ee4eae-702f-59f0-aff4-46c9acb89f6c" :knowledge-point/title "Rewriting a Logarithm Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de5aa4ab-4544-59c2-b200-37613f4e1558" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186258951}] :answer-field/correct {:answer/id #uuid "de5aa4ab-4544-59c2-b200-37613f4e1558" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186258951} :answer-field/id #uuid "eaecb80d-b491-5cb5-a4f4-54d654e1a717" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258950}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c1dd647-0f9b-5884-88c2-d3741fd6e4c4" :question/math-academy-id "q-23197" :question/problem "Given that ${log}_{3}x=\\frac{{log}_{9}x}{k},$ what is the value of $k?$\n\nAnswer: {{answer}}" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nWe want to change from base $a=3$ to base $b=9.$ So, we have\n\n$$\n\\begin{aligned}{log}_{3}x & =\\frac{{log}_{9}x}{{log}_{9}3}.\\end{aligned}\n$$\n\nRewriting the expression in the denominator using exponents, we get\n\n$$\n\\begin{aligned}\\frac{{log}_{9}x}{{log}_{9}3} & =\\frac{{log}_{9}x}{{log}_{9}({9}^{1/2})} \\\\  & =\\frac{{log}_{9}x}{(\\frac{1}{2})}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{log}_{3}x=\\frac{{log}_{9}x}{(\\frac{1}{2})}.\n$$\n\nHence, $k=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186258999 :knowledge-point/_questions [{:knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/title "Calculating the Average Rate of Change of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af91813-016a-52d2-a1b1-723a71999cda" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186271518} {:answer/id #uuid "d5a3ecb1-80a9-5d42-a94d-bb1ff6199306" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271519} {:answer/id #uuid "2635f326-ebd2-5ecc-a2dd-76e19b0e8d8b" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186271520} {:answer/id #uuid "9611cdae-3e65-5684-90c3-650bce9dad44" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271521} {:answer/id #uuid "56a43913-fb9a-5225-85a9-b0688ada53a0" :answer/type {:db/ident :answer.type/math} :answer/value "− (3)/(2)" :db/id #edb/ref 17592186271522}] :answer-field/correct {:answer/id #uuid "2635f326-ebd2-5ecc-a2dd-76e19b0e8d8b" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186271520} :answer-field/id #uuid "76cb36cb-d52f-5727-88ca-0dff79bb39c1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274581}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "de2abca8-7e9d-54bd-8cdb-f6670388afba" :question/math-academy-id "q-2432" :question/problem "A curve is defined as $y=3{x}^{2}-7.$ Find the average rate of change of $y$ over the interval $[2,5].$" :question/worked-solution "Let $f(x)=3{x}^{2}-7.$ Applying the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δy}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(5)-f(2)}{5-2} \\\\  & =\\frac{[3(5)^{2}-7]-[3(2)^{2}-7]}{3} \\\\  & =\\frac{68-5}{3} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259010 :knowledge-point/_questions [{:knowledge-point/id #uuid "6aa081d4-f85a-5239-b034-b78894429611" :knowledge-point/title "Finding the Roots of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41b03920-d34d-54db-b029-56b19a2fe86f" :answer/type {:db/ident :answer.type/text} :answer/value "-1" :db/id #edb/ref 17592186271533} {:answer/id #uuid "7cd12e43-dea1-596a-a450-df935aea12f4" :answer/type {:db/ident :answer.type/text} :answer/value "1" :db/id #edb/ref 17592186271534} {:answer/id #uuid "68491eb9-cd10-5c7d-af51-e19fc4eb4d56" :answer/type {:db/ident :answer.type/text} :answer/value "No real roots" :db/id #edb/ref 17592186271535} {:answer/id #uuid "a2494ef1-56f7-55cf-b35f-cbf6ec928fe1" :answer/type {:db/ident :answer.type/text} :answer/value "0" :db/id #edb/ref 17592186271536}] :answer-field/correct {:answer/id #uuid "68491eb9-cd10-5c7d-af51-e19fc4eb4d56" :answer/type {:db/ident :answer.type/text} :answer/value "No real roots" :db/id #edb/ref 17592186271535} :answer-field/id #uuid "c5260ca6-fd08-5430-b29b-821b39dd7a58" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274584}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4ba2473a-7860-526f-a636-2580b5f71073" :question/math-academy-id "q-24635" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/2c688a8451bcdf9a0fcc23f0dea2355c66c73f6114ef07f48535d9dd3e5eeb12.png)\n\nFind the roots of the parabola shown above." :question/worked-solution "The roots of a parabola are the $x$-intercepts of the parabola.\n\nFrom the graph, we can see that the curve does not intercept the $x$-axis.\n\nTherefore, the parabola does not have any roots."}] [{:db/id #edb/ref 17592186259381 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1c429c4-17f9-5874-952f-2ae118e180d3" :knowledge-point/title "Solving a Radical Equation With an Isolated Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f141e1-91a8-53e9-811b-cb9fe1e3b143" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(8)" :db/id #edb/ref 17592186271724} {:answer/id #uuid "e83965d3-719b-5781-ba8f-71047c1f49d9" :answer/type {:db/ident :answer.type/math} :answer/value "2(8)" :db/id #edb/ref 17592186271725} {:answer/id #uuid "3fa086a8-42d0-5bb9-b912-5ca5053b04ef" :answer/type {:db/ident :answer.type/math} :answer/value "3(8)" :db/id #edb/ref 17592186271726} {:answer/id #uuid "789be32c-433c-5730-8c66-88ef3b2fba03" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271727} {:answer/id #uuid "2e63f78a-56d1-58f8-a3b2-743847304318" :answer/type {:db/ident :answer.type/math} :answer/value "-(8)" :db/id #edb/ref 17592186271728}] :answer-field/correct {:answer/id #uuid "789be32c-433c-5730-8c66-88ef3b2fba03" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271727} :answer-field/id #uuid "acfb6627-1cd4-5900-8057-f2a88cae91b2" :answer-field/key "a" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274624}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b6e17eb-b41f-58d1-bd2b-5852d16cb44e" :question/math-academy-id "q-3043" :question/problem "Solve for $a$ where $\\sqrt{\\frac{2a+4}{5}}=2.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{\\frac{2a+4}{5}}=2 \\\\ {(\\sqrt{\\frac{2a+4}{5}})}^{2} & ={2}^{2} \\\\ \\frac{2a+4}{5} & =4 \\\\ 2a+4 & =20 \\\\ a & =8.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{2\\cdot 8+4}{5}} & \\overset{?}{=}2 \\\\ \\sqrt{\\frac{16+4}{5}} & \\overset{?}{=}2 \\\\ \\sqrt{4} & \\overset{?}{=}2 \\\\ 2 & =2\\,\\,✓\\end{aligned}\n$$\n\nThe value $a=8$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{\\frac{2a+4}{5}}=2$  is $a=8.$"}] [{:db/id #edb/ref 17592186260086 :knowledge-point/_questions [{:knowledge-point/id #uuid "4030a2b3-34aa-5d00-bd95-e382ec781b20" :knowledge-point/title "Simplifying a Rational Expression by Factoring Second-Order Polynomials in Both the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8b66fe-a862-553c-870b-d0490f768e45" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2k+6}{k-3})" :db/id #edb/ref 17592186271869} {:answer/id #uuid "5526128a-134c-5761-8529-c91de1a306b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2k+6}{k-3}" :db/id #edb/ref 17592186271870} {:answer/id #uuid "dff5aee3-c2e3-5df1-906f-d92cbc906b69" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{2k+6}{k-3})" :db/id #edb/ref 17592186271871} {:answer/id #uuid "c94e58bf-26cd-5f62-a01d-ea7061e38472" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{2k+6}{k-3})" :db/id #edb/ref 17592186271872} {:answer/id #uuid "f0e01232-dfe7-51fe-ad3d-36bcf3adf135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{2k+6}{k-3})" :db/id #edb/ref 17592186271873}] :answer-field/correct {:answer/id #uuid "5526128a-134c-5761-8529-c91de1a306b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2k+6}{k-3}" :db/id #edb/ref 17592186271870} :answer-field/id #uuid "db0a368d-b941-53ab-bb27-244330af7dac" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274653}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0fb4fa9e-d01e-54da-a47b-046997e1a366" :question/math-academy-id "q-3489" :question/problem "$\\frac{2{k}^{2}-18}{{k}^{2}-6k+9}=$" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\frac{2{k}^{2}-18}{{k}^{2}-6k+9} & =\\frac{2({k}^{2}-9)}{{k}^{2}-6k+9} \\\\  & =\\frac{2(k+3)(k-3)}{(k-3)(k-3)} \\\\  & =\\frac{2(k+3)\\cancel{(k-3)}}{(k-3)\\cancel{(k-3)}} \\\\  & =\\frac{2(k+3)}{k-3} \\\\  & =\\frac{2k+6}{k-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260163 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/title "Applying the Power Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f939ece-7f53-5c20-b404-90e5aee92f6a" :answer/type {:db/ident :answer.type/math} :answer/value "− (4)/(3)" :db/id #edb/ref 17592186271884} {:answer/id #uuid "da9c07ff-5904-53e9-9e97-205bc1f6cd1f" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(9)" :db/id #edb/ref 17592186271885} {:answer/id #uuid "7e9e2486-636d-59f3-beaf-a8c61d3ad2fe" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186271886} {:answer/id #uuid "dcc2c2ef-2dec-50c2-9825-dcf1eddfef84" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(3)" :db/id #edb/ref 17592186271887} {:answer/id #uuid "84e1c12a-5095-553b-b328-9bd6c9ca4e20" :answer/type {:db/ident :answer.type/math} :answer/value "243" :db/id #edb/ref 17592186271888}] :answer-field/correct {:answer/id #uuid "84e1c12a-5095-553b-b328-9bd6c9ca4e20" :answer/type {:db/ident :answer.type/math} :answer/value "243" :db/id #edb/ref 17592186271888} :answer-field/id #uuid "ef25f498-16db-5d8a-80b7-2f89b0aa8bcd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274656}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dbe7843b-5fc3-5be1-af00-dea6856d2e57" :question/math-academy-id "q-35252" :question/problem "Find ${lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}(4y-1)^{2}.$" :question/worked-solution "Here, we apply the product rule and the power rule to get\n \n\n$$\n\\begin{aligned}{lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}(4y-1)^{2} & ={lim}_{y\\to 1}{(2{y}^{2}+1)}^{3}\\cdot {lim}_{y\\to 1}(4y-1)^{2} \\\\  & ={({lim}_{y\\to 1}(2{y}^{2}+1))}^{3}\\cdot {({lim}_{y\\to 1}(4y-1))}^{2} \\\\  & ={(2{(1)}^{2}+1)}^{3}{(4(1)-1)}^{2} \\\\  & =(3)^{3}(3)^{2} \\\\  & =243\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260172 :knowledge-point/_questions [{:knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bff22094-e1ea-50c0-89f9-fe3045f33536" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3)" :db/id #edb/ref 17592186271899} {:answer/id #uuid "27bbdb8b-f904-5306-a1ad-18a9ef2a6f89" :answer/type {:db/ident :answer.type/math} :answer/value "2(3)" :db/id #edb/ref 17592186271900} {:answer/id #uuid "3bfede60-9d66-54e4-bfdc-7bd115ee81b3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271901} {:answer/id #uuid "6727f25f-401a-5766-891c-3c838273de62" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271902} {:answer/id #uuid "b010f2c9-83c1-55b7-8899-5064f447c571" :answer/type {:db/ident :answer.type/math} :answer/value "-(3)" :db/id #edb/ref 17592186271903}] :answer-field/correct {:answer/id #uuid "3bfede60-9d66-54e4-bfdc-7bd115ee81b3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271901} :answer-field/id #uuid "ad14cef0-6e74-543e-94d1-ef72765467dd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274659}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "238f1bf7-e926-5a9a-b458-b3d344bdf40c" :question/math-academy-id "q-35295" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/95e092490e087b5245f05b352b4738beb1ce3d9d649ea289ded881d0728129e5.png)\n\nFind ${lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to 1/2}f(x)=1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x} & =\\sqrt{{lim}_{x\\to 1/2}(4(f(x))^{4}+10x)} \\\\  & =\\sqrt{4(1)^{4}+10\\cdot \\frac{1}{2}} \\\\  & =\\sqrt{4+5} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260181 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b33d273b-e856-5079-8a88-402ca798fb7a" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186271909} {:answer/id #uuid "75708081-4ef2-59f5-815e-73ed1f61240e" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186271910} {:answer/id #uuid "58ff0bbb-e8b0-50cf-ad6b-ac78fe58d701" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186271911} {:answer/id #uuid "bdc2764c-477e-5651-a3a6-9aeed815e1cd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186271912} {:answer/id #uuid "049433b2-357b-55f7-b6bb-f31d576ff64d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271913}] :answer-field/correct {:answer/id #uuid "bdc2764c-477e-5651-a3a6-9aeed815e1cd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186271912} :answer-field/id #uuid "165119c5-f249-5584-8c9b-2034a491df54" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274661}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18d96d23-85b4-508f-bbdc-a059435bb5b1" :question/math-academy-id "q-35621" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e647ebf6e8332e9be5abd75e0f5ac5102c89c4a40590cef21a8ddfc65a17701d.png)\n\nFind ${lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph we get that ${lim}_{x\\to -1}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4}={lim}_{x\\to -1}(3{x}^{2}-1)^{2}\\cdot {lim}_{x\\to -1}(2-f(x))^{4}\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(3{x}^{2}-1)^{2} & ={({lim}_{x\\to -1}(3{x}^{2}-1))}^{2} \\\\  & ={(3(-1)^{2}-1)}^{2} \\\\  & =4\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(2-f(x))^{4} & ={({lim}_{x\\to -1}(2-f(x)))}^{4} \\\\  & ={(2-1)}^{4} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}(3{x}^{2}-1)^{2}(2-f(x))^{4} & ={({lim}_{x\\to -1}(3{x}^{2}-1))}^{2}{({lim}_{x\\to -1}(2-f(x)))}^{4} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260217 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb1e753f-ed91-5ba4-bd25-5fba48060d58" :knowledge-point/title "Factoring a Sum of Cubes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f079d6-e0ca-52f7-8a31-144c38d70661" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(8(x+2y)({x}^{2}-2xy+4{y}^{2}))" :db/id #edb/ref 17592186271959} {:answer/id #uuid "f412fc04-810d-50c2-9a01-740a90fcac73" :answer/type {:db/ident :answer.type/math} :answer/value "-(8(x+2y)({x}^{2}-2xy+4{y}^{2}))" :db/id #edb/ref 17592186271960} {:answer/id #uuid "f92ebf82-5745-5f12-966d-696e504df815" :answer/type {:db/ident :answer.type/math} :answer/value "8(x+2y)({x}^{2}-2xy+4{y}^{2})" :db/id #edb/ref 17592186271961} {:answer/id #uuid "cf4ba4ba-c2ab-5765-ba62-20dfce71c63e" :answer/type {:db/ident :answer.type/math} :answer/value "2(8(x+2y)({x}^{2}-2xy+4{y}^{2}))" :db/id #edb/ref 17592186271962} {:answer/id #uuid "cb4b9fc8-57a1-53d4-9f9e-03a5a7799edf" :answer/type {:db/ident :answer.type/math} :answer/value "3(8(x+2y)({x}^{2}-2xy+4{y}^{2}))" :db/id #edb/ref 17592186271963}] :answer-field/correct {:answer/id #uuid "f92ebf82-5745-5f12-966d-696e504df815" :answer/type {:db/ident :answer.type/math} :answer/value "8(x+2y)({x}^{2}-2xy+4{y}^{2})" :db/id #edb/ref 17592186271961} :answer-field/id #uuid "e554f92b-ad1c-51bb-be51-8cbbcf777c4d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274671}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0f555f4c-a2a8-5de1-aa66-3ef3e108a7af" :question/math-academy-id "q-37556" :question/problem "Factor the expression $8{x}^{3}+64{y}^{3}.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $8.$ To simplify the computation, we can factor out the $8,$ as follows:\n\n$$\n8{x}^{3}+64{y}^{3}=8({x}^{3}+8{y}^{3})\n$$\n\nThe expression in parentheses can be written as a sum of cubes:\n\n$$\n8({x}^{3}+8{y}^{3})=8({x}^{3}+(2y)^{3})\n$$\n\nNow, we factor the expression in parentheses using the sum of cubes formula:\n\n$$\n\\begin{aligned}8{x}^{3}+64{y}^{3} & =8({x}^{3}+(2y)^{3}) \\\\  & =8(x+2y)({x}^{2}-x\\cdot 2y+(2y)^{2}) \\\\  & =8(x+2y)({x}^{2}-2xy+4{y}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260271 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1c429c4-17f9-5874-952f-2ae118e180d3" :knowledge-point/title "Solving a Radical Equation With an Isolated Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48f68237-576e-5272-ad22-3a2e37cc6aea" :answer/type {:db/ident :answer.type/math} :answer/value "-(1)" :db/id #edb/ref 17592186272014} {:answer/id #uuid "441a0074-24c7-50a9-b747-b3a68a5eeb13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1)" :db/id #edb/ref 17592186272015} {:answer/id #uuid "8cd3e95a-f736-5b43-b9ad-3d782810f539" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272016} {:answer/id #uuid "eec576a3-9400-59db-bc0a-f7014ac63d31" :answer/type {:db/ident :answer.type/math} :answer/value "2(1)" :db/id #edb/ref 17592186272017} {:answer/id #uuid "ba4bdf20-294c-56a8-8fde-f9992d6d9462" :answer/type {:db/ident :answer.type/math} :answer/value "3(1)" :db/id #edb/ref 17592186272018}] :answer-field/correct {:answer/id #uuid "8cd3e95a-f736-5b43-b9ad-3d782810f539" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272016} :answer-field/id #uuid "f9d8b022-b9d7-5491-a6d3-0b14f14fe9df" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274682}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "193e9c3b-5823-5fe7-b42e-9a9b3e4a9d8b" :question/math-academy-id "q-39825" :question/problem "Solve $\\sqrt{8x-5}=\\sqrt{3}.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{8x-5} & =\\sqrt{3} \\\\ {(\\sqrt{8x-5})}^{2} & =(\\sqrt{3})^{2} \\\\ 8x-5 & =3 \\\\ 8x & =8 \\\\ x & =1.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{8\\cdot 1-5} & \\overset{?}{=}\\sqrt{3} \\\\ \\sqrt{8-5} & \\overset{?}{=}\\sqrt{3} \\\\ \\sqrt{3} & =\\sqrt{3}\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=1$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{8x-5}=\\sqrt{3}$  is $x=1.$"}] [{:db/id #edb/ref 17592186260274 :knowledge-point/_questions [{:knowledge-point/id #uuid "f9eea0ca-bb7a-5e5c-b2d0-472305f2c490" :knowledge-point/title "Solving a Radical Equation When the Radical Is Not Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d4fe84-1ab6-5c0a-9386-f47008ed3e14" :answer/type {:db/ident :answer.type/math} :answer/value "-(142)" :db/id #edb/ref 17592186272019} {:answer/id #uuid "894fe26c-8645-5858-bbbc-ac2b7dd1afe3" :answer/type {:db/ident :answer.type/math} :answer/value "2(142)" :db/id #edb/ref 17592186272020} {:answer/id #uuid "24fd44a7-6473-5415-8250-0de8ec12f64c" :answer/type {:db/ident :answer.type/math} :answer/value "3(142)" :db/id #edb/ref 17592186272021} {:answer/id #uuid "1885a5cc-5c08-5689-917f-4d26754dc230" :answer/type {:db/ident :answer.type/math} :answer/value "142" :db/id #edb/ref 17592186272022} {:answer/id #uuid "9a486c41-20ed-5f98-8057-0475ff151927" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(142)" :db/id #edb/ref 17592186272023}] :answer-field/correct {:answer/id #uuid "1885a5cc-5c08-5689-917f-4d26754dc230" :answer/type {:db/ident :answer.type/math} :answer/value "142" :db/id #edb/ref 17592186272022} :answer-field/id #uuid "0cf09c0e-1d4c-53a5-a352-407962f426c1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274683}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0845673e-0a7d-58b4-9254-65ae15f4f4cf" :question/math-academy-id "q-39830" :question/problem "Solve $8-\\frac{\\sqrt{x+2}}{6}=6.$" :question/worked-solution "First, we isolate the term $-\\frac{\\sqrt{x+2}}{6}$ by subtracting $8$ from both sides:\n\n$$\n\\begin{aligned}8-\\frac{\\sqrt{x+2}}{6} & =6 \\\\ -\\frac{\\sqrt{x+2}}{6} & =-2\\end{aligned}\n$$\n\nNow, we isolate the square root by multiplying by $-6$ on both sides:\n\n$$\n\\begin{aligned}-\\frac{\\sqrt{x+2}}{6} & =-2 \\\\ \\sqrt{x+2} & =12\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{x+2} & =12 \\\\ (\\sqrt{x+2})^{2} & ={12}^{2} \\\\ x+2 & =144 \\\\ x & =142.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}8-\\frac{\\sqrt{142+2}}{6} & \\overset{?}{=}6 \\\\ 8-\\frac{\\sqrt{144}}{6} & \\overset{?}{=}6 \\\\ 8-\\frac{12}{6} & \\overset{?}{=}6 \\\\ 6 & =6\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=142$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $8-\\frac{\\sqrt{x+2}}{6}=6$  is $x=142.$"}] [{:db/id #edb/ref 17592186260277 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1c429c4-17f9-5874-952f-2ae118e180d3" :knowledge-point/title "Solving a Radical Equation With an Isolated Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9589129-6768-5310-8237-e9635f5fe5b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)-2,5\\}" :db/id #edb/ref 17592186272024} {:answer/id #uuid "76511f15-76e2-535e-87b3-e132e59347fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)+2,5\\}" :db/id #edb/ref 17592186272025} {:answer/id #uuid "4ee8bc06-4f62-556a-b6fa-ce4b178ed4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)+1,5\\}" :db/id #edb/ref 17592186272026} {:answer/id #uuid "3ab664bd-722c-567a-9dac-2d195c6ce119" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-4,5\\}" :db/id #edb/ref 17592186272027} {:answer/id #uuid "30ce8f79-0962-5483-970d-bfe45f2894fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-4)-1,5\\}" :db/id #edb/ref 17592186272028}] :answer-field/correct {:answer/id #uuid "3ab664bd-722c-567a-9dac-2d195c6ce119" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-4,5\\}" :db/id #edb/ref 17592186272027} :answer-field/id #uuid "acb2f4f1-ae27-58e9-9ce2-0b94163e41ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274684}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "98003bca-fa53-57e1-a8e6-79179173f6b8" :question/math-academy-id "q-39832" :question/problem "Solve $\\sqrt{{x}^{2}-x-4}=4.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-x-4} & =4 \\\\ {(\\sqrt{{x}^{2}-x-4})}^{2} & ={4}^{2} \\\\ {x}^{2}-x-4 & =16 \\\\ {x}^{2}-x-20 & =0 \\\\ (x-5)(x+4) & =0 \\\\ x & =-4,\\,5.\\end{aligned}\n$$\n\nLet's check the result by plugging the solutions into the original equation. \n\n- For $x=-4$, we get\n\n$$\n\\begin{aligned}\\sqrt{(-4)^{2}-(-4)-4} & \\overset{?}{=}4 \\\\ \\sqrt{16+4-4} & \\overset{?}{=}4 \\\\ \\sqrt{16} & \\overset{?}{=}4 \\\\ 4 & =4\\,\\,✓\\end{aligned}\n$$\n\n- For $x=5$, we get\n\n$$\n\\begin{aligned}\\sqrt{{5}^{2}-5-4} & \\overset{?}{=}4 \\\\ \\sqrt{25-5-4} & \\overset{?}{=}4 \\\\ \\sqrt{16} & \\overset{?}{=}4 \\\\ 4 & =4\\,\\,✓\\end{aligned}\n$$\n\nThe values $x=-4,\\,5$ satisfy the original equation, so we can accept them as solutions.\n\nTherefore, the solutions to $\\sqrt{{x}^{2}-x-4}=4$  are $x=-4$ and $x=5.$"}] [{:db/id #edb/ref 17592186260282 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1c429c4-17f9-5874-952f-2ae118e180d3" :knowledge-point/title "Solving a Radical Equation With an Isolated Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f99520d2-0281-575f-95ae-4f4e2fdbfbc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(2)+1,6\\}" :db/id #edb/ref 17592186272029} {:answer/id #uuid "98d29ad6-8335-56ca-a3d2-068ef26bfad1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2,6\\}" :db/id #edb/ref 17592186272030} {:answer/id #uuid "5a7ac52e-a339-5f76-b911-ce7ac6193fb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(2)+2,6\\}" :db/id #edb/ref 17592186272031} {:answer/id #uuid "acb20666-b244-5a70-84f3-27640bd96147" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(2)-2,6\\}" :db/id #edb/ref 17592186272032} {:answer/id #uuid "093f0e4c-a9a1-5ef5-94e7-b428c425a26d" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(2)-1,6\\}" :db/id #edb/ref 17592186272033}] :answer-field/correct {:answer/id #uuid "98d29ad6-8335-56ca-a3d2-068ef26bfad1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2,6\\}" :db/id #edb/ref 17592186272030} :answer-field/id #uuid "bb529374-1c38-5b56-8e80-b98472fcd4c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274685}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d0f5b567-86e0-5c3b-94d7-e63615575a3c" :question/math-academy-id "q-39833" :question/problem "Solve $\\sqrt{{x}^{2}-8x+37}=5.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-8x+37} & =5 \\\\ {(\\sqrt{{x}^{2}-8x+37})}^{2} & ={5}^{2} \\\\ {x}^{2}-8x+37 & =25 \\\\ {x}^{2}-8x+12 & =0 \\\\ (x-6)(x-2) & =0 \\\\ x & =2,\\,6.\\end{aligned}\n$$\n\nLet's check the result by plugging the solutions into the original equation. \n\n- For $x=2$, we get\n\n$$\n\\begin{aligned}\\sqrt{{2}^{2}-8\\cdot 2+37} & \\overset{?}{=}5 \\\\ \\sqrt{4-16+37} & \\overset{?}{=}5 \\\\ \\sqrt{25} & \\overset{?}{=}5 \\\\ 5 & =5\\,\\,✓\\end{aligned}\n$$\n\n- For $x=6$, we get\n\n$$\n\\begin{aligned}\\sqrt{{6}^{2}-8\\cdot 6+37} & \\overset{?}{=}5 \\\\ \\sqrt{36-48+37} & \\overset{?}{=}5 \\\\ \\sqrt{25} & \\overset{?}{=}5 \\\\ 5 & =5\\,\\,✓\\end{aligned}\n$$\n\nThe values $x=2,\\,6$ satisfy the original equation, so we can accept them as solutions.\n\nTherefore, the solutions to $\\sqrt{{x}^{2}-8x+37}=5$  are $x=2$ and $x=6.$"}] [{:db/id #edb/ref 17592186260348 :knowledge-point/_questions [{:knowledge-point/id #uuid "282b873c-1ba0-5205-b75f-c58721ffaaff" :knowledge-point/title "Inferring Values of a Periodic Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c4e1e7b-ed4f-5df7-a564-9de3a158a4b2" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186272087} {:answer/id #uuid "6d6fab31-f655-547e-bcb0-008753dbb5c1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272088} {:answer/id #uuid "dd9261fa-f546-5012-b53f-387083fdd9f2" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186272089} {:answer/id #uuid "0f5916c6-db79-5d88-8878-4dfd3813fcb0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272090} {:answer/id #uuid "874e336a-39ca-5657-89c8-7ff83ad85eb7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186272091}] :answer-field/correct {:answer/id #uuid "874e336a-39ca-5657-89c8-7ff83ad85eb7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186272091} :answer-field/id #uuid "d42604a6-8f7c-556b-8f8a-79e781785792" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274697}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "894785c9-b37d-573f-b85e-093f2abc4eb1" :question/math-academy-id "q-41478" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/34ba4a4dcd6655d68fbc20fb6192354ae755cc7eaf14a2459e9b7012ffe6d9ea.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(62)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep subtracting $4$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(62) & =f(62-4) \\\\  & =f(62-2\\cdot 4) \\\\  & =⋯ \\\\  & =f(62-15\\cdot 4) \\\\  & =f(2) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260409 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/title "Applying the Root Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d43b80-4f0d-53fa-b433-dbfc8e274faa" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186272176} {:answer/id #uuid "f95532b1-d02b-5243-8086-e21732e7696c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272177} {:answer/id #uuid "0591cf0c-45fd-5260-aa50-66a372634c3b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272178} {:answer/id #uuid "66221d75-355f-51e1-8210-5363fabfbdd2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272179} {:answer/id #uuid "d7ecbb15-7583-5f43-b5f8-094a1d0b45df" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272180}] :answer-field/correct {:answer/id #uuid "d7ecbb15-7583-5f43-b5f8-094a1d0b45df" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272180} :answer-field/id #uuid "a2d3b3e0-3b21-57b0-a355-02c18b276cf7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274715}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7f232a13-ac59-5c7f-b9ee-ff0c688c0095" :question/math-academy-id "q-4460" :question/problem "Find ${lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2}.$" :question/worked-solution "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2}=\\frac{{lim}_{x\\to 1}(\\sqrt[3]{{x}^{2}+3x+4}+6x)}{{lim}_{x\\to 1}(4x-2)}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nApplying the root rule in the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}(\\sqrt[3]{{x}^{2}+3x+4}+6x) & =\\sqrt[3]{{1}^{2}+3(1)+4}+6(1) \\\\  & =\\sqrt[3]{1+3+4}+6 \\\\  & =\\sqrt[3]{8}+6 \\\\  & =2+6 \\\\  & =8.\\end{aligned}\n$$\n\nFor the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 1}(4x-2) & =4(1)-2=2\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\sqrt[3]{{x}^{2}+3x+4}+6x}{4x-2} & =\\frac{8}{2}=4\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260438 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac12981c-ec1d-5f2d-8699-a03bd7d85e14" :knowledge-point/title "Estimating the Probability of the Union of Events"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fd300a0-dec0-5778-81a2-20c2aff4fd32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{32}" :db/id #edb/ref 17592186272186} {:answer/id #uuid "31b9fd09-0c24-5cc5-aa61-fc7ff9805bce" :answer/type {:db/ident :answer.type/math} :answer/value "0.52" :db/id #edb/ref 17592186272187} {:answer/id #uuid "c76a796e-db07-575e-b74b-658d4e33d7cb" :answer/type {:db/ident :answer.type/math} :answer/value "0.44" :db/id #edb/ref 17592186272188} {:answer/id #uuid "b601983d-71c5-5958-a5df-c68190e6f0c1" :answer/type {:db/ident :answer.type/math} :answer/value "0.32" :db/id #edb/ref 17592186272189} {:answer/id #uuid "1ef05911-100e-5276-a7b3-5be1d2a73edb" :answer/type {:db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186272190}] :answer-field/correct {:answer/id #uuid "6fd300a0-dec0-5778-81a2-20c2aff4fd32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{32}" :db/id #edb/ref 17592186272186} :answer-field/id #uuid "2d115552-1d7c-5534-b3d3-c682ef28e705" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274717}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f0371bfd-8501-506c-b9fa-24609b84ea8d" :question/math-academy-id "q-46814" :question/problem "Martin surveyed some students in a school, asking them if they have cats or dogs at home. His findings are summarized in the two-way frequency table below.\n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $6$ | $9$ | $15$ |\n| Doesn't have a cat | $10$ | $7$ | $17$ |\n| Totals | $16$ | $16$ | $32$ |\n\nEstimate the probability that a randomly chosen student in the school has either a cat or a dog but not both." :question/worked-solution "To estimate the probability that a randomly chosen student in the school has either a cat or a dog but not both, we\n\n- add up the numbers in the row **\" Has a cat\"** or the column **\"Has a dog\"** but not in their intersection, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the row **\"Has a cat\"** or the column **\"Has a dog\"** but not in their intersection are highlighted below.\n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $6$ | $9$ | $15$ |\n| Doesn't have a cat | $10$ | $7$ | $17$ |\n| Totals | $16$ | $16$ | $32$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(32),$ we get\n\n$$\np=\\frac{9+10}{32}=\\frac{19}{32}.\n$$"}] [{:db/id #edb/ref 17592186260467 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac12981c-ec1d-5f2d-8699-a03bd7d85e14" :knowledge-point/title "Estimating the Probability of the Union of Events"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e157c17a-4432-506f-be56-1325566a80fe" :answer/type {:db/ident :answer.type/math} :answer/value "0.70" :db/id #edb/ref 17592186272231} {:answer/id #uuid "3edd98cb-f6e9-5609-bf80-6b6dfa9665d3" :answer/type {:db/ident :answer.type/math} :answer/value "0.52" :db/id #edb/ref 17592186272232} {:answer/id #uuid "98f4c626-9ccc-5a29-9992-5ef27e6f569e" :answer/type {:db/ident :answer.type/math} :answer/value "0.44" :db/id #edb/ref 17592186272233} {:answer/id #uuid "8eb70aa0-665c-5cab-9f19-18d39a0d30ac" :answer/type {:db/ident :answer.type/math} :answer/value "0.32" :db/id #edb/ref 17592186272234} {:answer/id #uuid "565c43d5-d85b-5427-a253-f75a10b615ae" :answer/type {:db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186272235}] :answer-field/correct {:answer/id #uuid "e157c17a-4432-506f-be56-1325566a80fe" :answer/type {:db/ident :answer.type/math} :answer/value "0.70" :db/id #edb/ref 17592186272231} :answer-field/id #uuid "6f52cf81-c564-5666-8396-45c48bedfa88" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274726}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ed5c80c-e475-58de-a971-282836200277" :question/math-academy-id "q-47139" :question/problem "The employees and the interns of a company were asked whether they commute to work by car or by bus. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Employee | Intern | Totals |\n| --- | --- | --- | --- |\n| Car | $24$ | $16$ | $40$ |\n| Bus | $26$ | $14$ | $40$ |\n| Totals | $50$ | $30$ | $80$ |\n\nLet $I$ be the event that a randomly selected person is a **\"Intern\"**, and $B$ be the event that a randomly selected person commutes to work by **\"Bus\"**. Estimate $P(I\\cup B).$" :question/worked-solution "First, note that $I\\cup B$ is the event that a randomly selected person is an intern or person who commutes to work by bus. \n\nTo estimate the probability of $I\\cup B,$ we\n\n- add up the numbers in the column **\"Intern\"** or the row **\"Bus\"**, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the column **\"Intern\"** or the row **\"Bus\"** are highlighted below.\n\n|  | Employee | Intern | Totals |\n| --- | --- | --- | --- |\n| Car | $24$ | $16$ | $40$ |\n| Bus | $26$ | $14$ | $40$ |\n| Totals | $50$ | $30$ | $80$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(80),$ we get\n\n$$\nP(I\\cup B)=\\frac{16+14+26}{80}=\\frac{56}{80}=0.70.\n$$"}] [{:db/id #edb/ref 17592186260473 :knowledge-point/_questions [{:knowledge-point/id #uuid "46546a09-5d48-57d9-8166-5f9d8949c066" :knowledge-point/title "Estimating the Probability of the Intersection of Events"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b684379f-fdd5-53cf-a237-66cac98e96ca" :answer/type {:db/ident :answer.type/math} :answer/value "0.76" :db/id #edb/ref 17592186272241} {:answer/id #uuid "9a18c99e-17e6-572d-832c-8c4a40d4c442" :answer/type {:db/ident :answer.type/math} :answer/value "0.60" :db/id #edb/ref 17592186272242} {:answer/id #uuid "786bad81-a451-547d-a0ce-b23cab9e090c" :answer/type {:db/ident :answer.type/math} :answer/value "0.40" :db/id #edb/ref 17592186272243} {:answer/id #uuid "1e989a80-4c7b-5095-819c-cfa55756e748" :answer/type {:db/ident :answer.type/math} :answer/value "0.50" :db/id #edb/ref 17592186272244} {:answer/id #uuid "13b46677-43f3-59c6-bff8-7e132887f455" :answer/type {:db/ident :answer.type/math} :answer/value "0.333" :db/id #edb/ref 17592186272245}] :answer-field/correct {:answer/id #uuid "13b46677-43f3-59c6-bff8-7e132887f455" :answer/type {:db/ident :answer.type/math} :answer/value "0.333" :db/id #edb/ref 17592186272245} :answer-field/id #uuid "a718dea9-248d-5f1f-be17-9871b1eac191" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274728}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "75eedbd1-62f9-545d-b2b8-ed88a19bd586" :question/math-academy-id "q-47299" :question/problem "Rose surveyed $168$ children in Arizona High School. She asked them about their favorite topics in math, between geometry and algebra. Her findings are summarized in the two-way frequency table below. \n\n|  | Geometry | Algebra | Totals |\n| --- | --- | --- | --- |\n| Girls | $28$ | $63$ | $91$ |\n| Boys | $56$ | $21$ | $77$ |\n| Totals | $84$ | $84$ | $168$ |\n\nLet $B$ be the event that a randomly selected child is a **\"Boy\"** and $G$ the event that a randomly selected child likes **\"Geometry\"**. Estimate $P(B\\cap G).$" :question/worked-solution "First, note that $B\\cap G$ is the event that a randomly selected child is a boy and likes geometry. \n\nTo estimate the probability of $B\\cap G,$ we\n\n- find the number at the intersection of the row **\"Boys\"** and the column **\"Geometry\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Boys\"** and the column **\"Geometry\"** is highlighted in the table below.\n\n|  | Geometry | Algebra | Totals |\n| --- | --- | --- | --- |\n| Girls | $28$ | $63$ | $91$ |\n| Boys | $56$ | $21$ | $77$ |\n| Totals | $84$ | $84$ | $168$ |\n\nDividing by the total number of data points in the table $(168),$ we get\n\n$$\nP(B\\cap G)=\\frac{56}{168}=0.333.\n$$"}] [{:db/id #edb/ref 17592186260476 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6956b58-5581-5221-8d4f-88ebde382f0c" :knowledge-point/title "Estimating Using Probabilities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27768da8-c3e8-552a-8db5-573faf732542" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186272246} {:answer/id #uuid "f56ddc2b-0551-553e-96ad-c9ef66b4ba4f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186272247} {:answer/id #uuid "4224a6d0-e376-52ee-b43d-cd8e1ab89403" :answer/type {:db/ident :answer.type/math} :answer/value "203" :db/id #edb/ref 17592186272248} {:answer/id #uuid "4b161c94-5479-5470-be48-02a29f92bd48" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186272249} {:answer/id #uuid "fde0992d-1f58-52dc-b1c2-fa3235af67d9" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186272250}] :answer-field/correct {:answer/id #uuid "4224a6d0-e376-52ee-b43d-cd8e1ab89403" :answer/type {:db/ident :answer.type/math} :answer/value "203" :db/id #edb/ref 17592186272248} :answer-field/id #uuid "fab53c1c-ce59-5d63-b8b1-166f3a3c4a25" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274729}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "146b2ef3-9c02-5d19-b5a0-7ac41d8998b7" :question/math-academy-id "q-47306" :question/problem "A group of $5$th grade and $6$th grade students at Benjamin Franklin Elementary School are randomly selected for a survey. They are asked about their favorite places to go on summer vacations between the beach and the countryside. The results of this survey are summarized in the two-way frequency table below.\n\n|  | Beach | Countryside | Totals |\n| --- | --- | --- | --- |\n| $5$th grade | $55$ | $30$ | $85$ |\n| $6$th grade | $42$ | $33$ | $75$ |\n| Totals | $97$ | $63$ | $160$ |\n\nJohn Adams Elementary School has $250$ students in $5$th grade and $6$th grade. Assuming that the distribution of the results is the same in both elementary schools, estimate the number of students at John Adams Elementary School who are in $6$th grade or like to go to the beach on summer vacations (or both). Round your answer to the nearest integer." :question/worked-solution "To estimate the number of students who are in $6$th grade or like to go to the beach on summer vacations, we\n\n- add up the numbers in the row **\"$6$th grade\"** or the column **\"Beach\"**, and then\n\n- divide by the total number of data points in the table.\n\n|  | Beach | Countryside | Totals |\n| --- | --- | --- | --- |\n| $5$th grade | $55$ | $30$ | $85$ |\n| $6$th grade | $42$ | $33$ | $75$ |\n| Totals | $97$ | $63$ | $160$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(160),$ we get\n\n$$\np=\\frac{55+42+33}{160}=\\frac{130}{160}=0.81.\n$$\n\nThis represents the estimated probability that a randomly selected student is in $6$th grade or likes to go to the beach on summer vacations.\n\nFinally, to find the estimated number of students of John Adams Elementary School who are in $6$th grade or like to go to the beach on summer vacations, we multiply the total number of students in the school $(250)$ by the probability above:\n\n$$\n\\begin{aligned}n & =250\\cdot p \\\\  & =250\\cdot 0.81 \\\\  & =202.5 \\\\  & =203,\\end{aligned}\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186260752 :knowledge-point/_questions [{:knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e792b97-381b-52e9-877a-5b76db3c6fd0" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186272530} {:answer/id #uuid "136a636c-acfb-5b2e-b047-5ccc388badbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\textrm{i}" :db/id #edb/ref 17592186272531} {:answer/id #uuid "0447bf3b-164e-57fd-a534-559afacaf062" :answer/type {:db/ident :answer.type/math} :answer/value "− \\textrm{i}" :db/id #edb/ref 17592186272532} {:answer/id #uuid "5fe10320-4678-5a44-bef1-5b98dc25bb12" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272533} {:answer/id #uuid "063b934f-e307-52b5-873a-dc4f17486481" :answer/type {:db/ident :answer.type/math} :answer/value "− 3\\textrm{i}" :db/id #edb/ref 17592186272534}] :answer-field/correct {:answer/id #uuid "5fe10320-4678-5a44-bef1-5b98dc25bb12" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272533} :answer-field/id #uuid "c839ff46-95b7-5973-966b-c981c3fc5593" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274786}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e22a5106-9b86-5df9-82bd-ae96786f3991" :question/math-academy-id "q-538" :question/problem "${({\\text{i}}^{4})}^{2015}=$" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{({\\text{i}}^{4})}^{2015}=(1)^{2015}=1.\n$$"}] [{:db/id #edb/ref 17592186260764 :knowledge-point/_questions [{:knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46" :knowledge-point/title "Raising i to a Small Positive Integer Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91a4ea21-3e92-5d19-a58a-42ade5d33223" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272550} {:answer/id #uuid "3ff58cba-0663-5cba-9546-386991687118" :answer/type {:db/ident :answer.type/math} :answer/value "2\\textrm{i}" :db/id #edb/ref 17592186272551} {:answer/id #uuid "b7d84193-669d-50ae-9fe0-34802fa0c8cb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #e