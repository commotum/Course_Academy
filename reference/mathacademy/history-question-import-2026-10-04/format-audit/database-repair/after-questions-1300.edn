answer-field/correct {:answer/id #uuid "10b7e30c-deb4-56c7-90a3-2d1d0ba3bae8" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186272729} :answer-field/id #uuid "ab6821aa-1a5f-555a-a986-17c45bae556d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274829}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7cbde6cf-0e45-5c99-bf6a-3df156d4e49a" :question/math-academy-id "q-66226" :question/problem "$-\\sqrt{-8}=$" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nSince $8=4\\cdot 2,$ the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-8} & =-\\sqrt{8\\cdot (-1)} \\\\  & =-\\sqrt{4\\cdot 2\\cdot (-1)} \\\\  & =-\\sqrt{4}\\cdot \\sqrt{2}\\cdot \\sqrt{-1} \\\\  & =-2\\sqrt{2}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260911 :knowledge-point/_questions [{:knowledge-point/id #uuid "020697e9-c2fc-57d1-9fc9-5bb1c13a6fb9" :knowledge-point/title "Finding the Square Root of a Negative Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6014768-0508-51c6-b5d6-86e75916809d" :answer/type {:db/ident :answer.type/math} :answer/value "− (6)/(5)\\textrm{i}" :db/id #edb/ref 17592186272734} {:answer/id #uuid "1b647ced-910b-522b-be38-ff6df1242588" :answer/type {:db/ident :answer.type/math} :answer/value "(6)/(5)\\textrm{i}" :db/id #edb/ref 17592186272735} {:answer/id #uuid "5a266302-9539-587f-89b0-c9bcb6227662" :answer/type {:db/ident :answer.type/math} :answer/value "− (6)/(5)" :db/id #edb/ref 17592186272736} {:answer/id #uuid "78feeed5-dddd-5a53-ab2b-29629f04688a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}\\text{i}" :db/id #edb/ref 17592186272737} {:answer/id #uuid "285406bb-c8c0-547d-b872-c92c3e6b5813" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/(6)\\textrm{i}" :db/id #edb/ref 17592186272738}] :answer-field/correct {:answer/id #uuid "78feeed5-dddd-5a53-ab2b-29629f04688a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}\\text{i}" :db/id #edb/ref 17592186272737} :answer-field/id #uuid "420eaa01-9259-5c2a-b799-ead12d3098ce" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274830}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ebbdd24-e97c-5ef9-8692-f3145c68ea3c" :question/math-academy-id "q-66235" :question/problem "$-\\sqrt{-\\frac{16}{9}}=$" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-\\frac{16}{9}} & =-\\sqrt{\\frac{16}{9}\\cdot (-1)} \\\\  & =-\\sqrt{\\frac{16}{9}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{\\sqrt{16}}{\\sqrt{9}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{4}{3}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260914 :knowledge-point/_questions [{:knowledge-point/id #uuid "020697e9-c2fc-57d1-9fc9-5bb1c13a6fb9" :knowledge-point/title "Finding the Square Root of a Negative Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbaa3df0-67c9-5b23-b638-6955591dd0a3" :answer/type {:db/ident :answer.type/math} :answer/value "− (6)/(5)\\textrm{i}" :db/id #edb/ref 17592186272739} {:answer/id #uuid "b196a779-2d0c-5129-87df-5d26661965d0" :answer/type {:db/ident :answer.type/math} :answer/value "(6)/(5)\\textrm{i}" :db/id #edb/ref 17592186272740} {:answer/id #uuid "c6ce6940-86d0-598e-b275-00febfe4c8ad" :answer/type {:db/ident :answer.type/math} :answer/value "− (6)/(5)" :db/id #edb/ref 17592186272741} {:answer/id #uuid "eb390740-cc78-5ade-9e31-729b16d8ad4c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}\\text{i}" :db/id #edb/ref 17592186272742} {:answer/id #uuid "e681782f-ce33-5513-a62a-854d558a8e44" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/(6)\\textrm{i}" :db/id #edb/ref 17592186272743}] :answer-field/correct {:answer/id #uuid "eb390740-cc78-5ade-9e31-729b16d8ad4c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}\\text{i}" :db/id #edb/ref 17592186272742} :answer-field/id #uuid "14ef3d02-f6bc-57a0-9df7-2273d7f75c5d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274831}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "be123228-4149-57f4-a7e3-eae84dca8b10" :question/math-academy-id "q-66236" :question/problem "$-\\sqrt{-\\frac{9}{49}}=$" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-\\frac{9}{49}} & =-\\sqrt{\\frac{9}{49}\\cdot (-1)} \\\\  & =-\\sqrt{\\frac{9}{49}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{\\sqrt{9}}{\\sqrt{49}}\\cdot \\sqrt{-1} \\\\  & =-\\frac{3}{7}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260922 :knowledge-point/_questions [{:knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46" :knowledge-point/title "Raising i to a Small Positive Integer Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd139b03-a3fc-5ed7-a2d4-7dc1e5ffb071" :answer/type {:db/ident :answer.type/math} :answer/value "5-4\\text{i}" :db/id #edb/ref 17592186272749} {:answer/id #uuid "91a27adf-1ff9-5e12-b7e9-526bad913536" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272750} {:answer/id #uuid "8634c97c-09bc-59c4-968e-bf1fd8817a1e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\textrm{i}" :db/id #edb/ref 17592186272751} {:answer/id #uuid "9a1243c9-4463-53f0-a003-b7cf6fcd376a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272752} {:answer/id #uuid "8b1dc687-a1a1-55dc-8713-39220ce0e0ac" :answer/type {:db/ident :answer.type/math} :answer/value "− 3\\textrm{i}" :db/id #edb/ref 17592186272753}] :answer-field/correct {:answer/id #uuid "dd139b03-a3fc-5ed7-a2d4-7dc1e5ffb071" :answer/type {:db/ident :answer.type/math} :answer/value "5-4\\text{i}" :db/id #edb/ref 17592186272749} :answer-field/id #uuid "98358a82-3215-567d-89e5-a966f2f3eebd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274833}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a68b8235-f32a-5c69-b523-5c1357944070" :question/math-academy-id "q-66385" :question/problem "What is the value of $4{\\text{i}}^{3}-5{\\text{i}}^{2}?$" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}4{\\text{i}}^{3}-5{\\text{i}}^{2}=4(-\\text{i})-5(-1)=5-4\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260943 :knowledge-point/_questions [{:knowledge-point/id #uuid "aa5128ae-312f-5a12-9a19-9158fa7ddb9a" :knowledge-point/title "Raising i to a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55af0d58-34a4-59d2-ac6d-20ef5ac885a0" :answer/type {:db/ident :answer.type/math} :answer/value "6\\textrm{i}" :db/id #edb/ref 17592186272783} {:answer/id #uuid "ea4c9563-c82f-5fdc-80dd-1fa9ed3ecedb" :answer/type {:db/ident :answer.type/math} :answer/value "− 6\\textrm{i}" :db/id #edb/ref 17592186272784} {:answer/id #uuid "aac89e89-ae0a-519e-9c41-b641767d722e" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(6)\\textrm{i}" :db/id #edb/ref 17592186272785} {:answer/id #uuid "49e56e1c-1bde-5af8-a5ff-6b337a0fd32f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272786} {:answer/id #uuid "fe93ef0c-1047-5d97-9d81-6a94ca96ef67" :answer/type {:db/ident :answer.type/math} :answer/value "− 6" :db/id #edb/ref 17592186272787}] :answer-field/correct {:answer/id #uuid "49e56e1c-1bde-5af8-a5ff-6b337a0fd32f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272786} :answer-field/id #uuid "cdd38e9e-472b-5ca6-89b7-f05d7fbab706" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274840}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1ba253e5-6b77-5991-9dca-b8648ddf6d5a" :question/math-academy-id "q-66490" :question/problem "$-4{\\text{i}}^{-2}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n-4{\\text{i}}^{-2}=-\\frac{4}{{\\text{i}}^{2}}.\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n-\\frac{4}{{\\text{i}}^{2}}=-\\frac{4}{(-1)}=4.\n$$"}] [{:db/id #edb/ref 17592186260990 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b03a8b08-8e7b-5cd4-a133-f21c8ad23ce8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186260992}] :answer-field/correct {:answer/id #uuid "b03a8b08-8e7b-5cd4-a133-f21c8ad23ce8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186260992} :answer-field/id #uuid "c060282b-a228-5149-88ee-93425f941ef2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260991}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bf175bf7-41d9-5d9c-9ca1-8254b6c5a5b0" :question/math-academy-id "q-66880" :question/problem "${log}_{25}(\\sqrt{125})=$\n\nAnswer: {{answer}}" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=25$ and $X=\\sqrt{125}.$ Since both $a$ and $X$ can be presented as a power of $5,$ we set $b=5.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{25}(\\sqrt{125}) & =\\frac{{log}_{5}(\\sqrt{125})}{{log}_{5}(25)} \\\\  & =\\frac{{log}_{5}(\\sqrt{{5}^{3}})}{{log}_{5}({5}^{2})} \\\\  & =\\frac{{log}_{5}({5}^{3/2})}{{log}_{5}({5}^{2})} \\\\  & =\\frac{(\\frac{3}{2})}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260993 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a37b4e09-7c5d-59e7-869c-54c3b277f653" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186260995}] :answer-field/correct {:answer/id #uuid "a37b4e09-7c5d-59e7-869c-54c3b277f653" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186260995} :answer-field/id #uuid "d0e6003b-62b3-5c4a-a6fd-c807d1c3bba4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260994}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "47a63a18-20ff-5e2a-89aa-c14176c04a06" :question/math-academy-id "q-66887" :question/problem "${log}_{9}(\\sqrt{27})=$\n\nAnswer: {{answer}}" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=9$ and $X=\\sqrt{27}.$ Since both $a$ and $X$ can be presented as a power of $3,$ we set $b=3.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{9}(\\sqrt{27}) & =\\frac{{log}_{3}(\\sqrt{27})}{{log}_{3}(9)} \\\\  & =\\frac{{log}_{3}(\\sqrt{{3}^{3}})}{{log}_{3}({3}^{2})} \\\\  & =\\frac{{log}_{3}({3}^{3/2})}{{log}_{3}({3}^{2})} \\\\  & =\\frac{(\\frac{3}{2})}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261007 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa06c276-2514-578f-8d2c-d26527f7e6c5" :answer/type {:db/ident :answer.type/math} :answer/value "1.71" :db/id #edb/ref 17592186261009}] :answer-field/correct {:answer/id #uuid "fa06c276-2514-578f-8d2c-d26527f7e6c5" :answer/type {:db/ident :answer.type/math} :answer/value "1.71" :db/id #edb/ref 17592186261009} :answer-field/id #uuid "49f59870-2611-597e-8a30-5301563263a2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261008}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1e980299-bf4e-5e95-b34b-d63085c5feea" :question/math-academy-id "q-66934" :question/problem "Use a calculator to evaluate ${log}_{8}(35)$ rounded to $2$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{8}(35)$ by changing the base $8$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=8,$ $X=35,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{8}(35) & =\\frac{{log}_{10}(35)}{{log}_{10}(8)} \\\\  & =\\frac{\\operatorname{log}(35)}{\\operatorname{log}(8)} \\\\  & \\approx \\frac{1.544\\,07}{0.903\\,09} \\\\  & \\approx 1.71\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261019 :knowledge-point/_questions [{:knowledge-point/id #uuid "87ee4eae-702f-59f0-aff4-46c9acb89f6c" :knowledge-point/title "Rewriting a Logarithm Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f5fe841-2b61-5ae5-84f1-ef2ffe66ac2d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\log 6)/(\\log x)" :db/id #edb/ref 17592186272863} {:answer/id #uuid "f55cf81d-5469-5bac-8a03-4690b3db1a21" :answer/type {:db/ident :answer.type/math} :answer/value "\\log x − \\log 6" :db/id #edb/ref 17592186272864} {:answer/id #uuid "1d716b72-f6fb-587c-b252-90f1318fc02a" :answer/type {:db/ident :answer.type/math} :answer/value "(\\log x)/(\\log 6)" :db/id #edb/ref 17592186272865} {:answer/id #uuid "1ae7078f-cd32-5d5e-b4d9-af28ba9fe88e" :answer/type {:db/ident :answer.type/math} :answer/value "\\log x + \\log 6" :db/id #edb/ref 17592186272866} {:answer/id #uuid "39db8334-53fa-55e0-baeb-352ba597cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{log}_{3}x" :db/id #edb/ref 17592186272867}] :answer-field/correct {:answer/id #uuid "39db8334-53fa-55e0-baeb-352ba597cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{log}_{3}x" :db/id #edb/ref 17592186272867} :answer-field/id #uuid "ed205c04-45a2-5605-b004-6cd5169838b1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274856}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a8865266-a05d-5ca3-b448-4ff1c8f96fa4" :question/math-academy-id "q-67158" :question/problem "Which of the following is equivalent to ${log}_{81}x?$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nWe want to change from base $a=81$ to base $b=3.$ So, we have\n\n$$\n\\begin{aligned}{log}_{81}x & =\\frac{{log}_{3}x}{{log}_{3}(81)}.\\end{aligned}\n$$\n\nRewriting the expression in the denominator using exponents, we get\n\n$$\n\\begin{aligned}\\frac{{log}_{3}x}{{log}_{3}(81)} & =\\frac{{log}_{3}x}{{log}_{3}({3}^{4})} \\\\  & =\\frac{{log}_{3}x}{4}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{log}_{81}x=\\frac{{log}_{3}x}{4}=\\frac{1}{4}{log}_{3}x.\n$$"}] [{:db/id #edb/ref 17592186261076 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/title "Applying the Power Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c883a787-e1dc-5780-a499-949734cbe196" :answer/type {:db/ident :answer.type/math} :answer/value "− (4)/(3)" :db/id #edb/ref 17592186272953} {:answer/id #uuid "a0722b2d-7289-5de1-933b-3ba156715408" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(9)" :db/id #edb/ref 17592186272954} {:answer/id #uuid "ca8af2e3-5027-59bd-9ccf-ab16bafa6075" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186272955} {:answer/id #uuid "59f9e59a-00ce-586f-af47-a45a80135338" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186272956} {:answer/id #uuid "67870531-7aef-539f-adef-204651e75bf4" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(3)" :db/id #edb/ref 17592186272957}] :answer-field/correct {:answer/id #uuid "59f9e59a-00ce-586f-af47-a45a80135338" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186272956} :answer-field/id #uuid "f689b613-cd3f-5852-8acc-379b0eb48aca" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274874}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "93e1f776-dbc1-58f3-a68d-2ac0bb33599b" :question/math-academy-id "q-67696" :question/problem "Find ${lim}_{z\\to -1}\\frac{(z-2)^{4}}{(z+2)^{3}}.$" :question/worked-solution "Here, we apply the quotient rule and the power rule to get\n\n \n\n$$\n\\begin{aligned}{lim}_{z\\to -1}\\frac{(z-2)^{4}}{(z+2)^{3}} & =\\frac{{lim}_{z\\to -1}(z-2)^{4}}{{lim}_{z\\to -1}(z+2)^{3}} \\\\  & =\\frac{{({lim}_{z\\to -1}(z-2))}^{4}}{{({lim}_{z\\to -1}(z+2))}^{3}} \\\\  & =\\frac{(-1-2)^{4}}{(-1+2)^{3}} \\\\  & =\\frac{(-3)^{4}}{{1}^{3}} \\\\  & =\\frac{81}{1} \\\\  & =81\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261079 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c2d531-9080-5bb4-8600-ca05dffac0c6" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186272958} {:answer/id #uuid "fc860609-301d-5438-af00-6d0a638aa0a7" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186272959} {:answer/id #uuid "af257fbe-ae86-5083-804a-858de96fa2bf" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186272960} {:answer/id #uuid "355df8f7-a6c3-55d6-81ad-c170ac7b2072" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186272961} {:answer/id #uuid "2652c90b-1593-5c8a-925c-9a99faf188b5" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\pi }^{2}" :db/id #edb/ref 17592186272962}] :answer-field/correct {:answer/id #uuid "2652c90b-1593-5c8a-925c-9a99faf188b5" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\pi }^{2}" :db/id #edb/ref 17592186272962} :answer-field/id #uuid "8083911f-ba9b-53c8-854b-e4c4119794fe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274875}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e345d3a4-c2d8-581c-8529-3152719d2521" :question/math-academy-id "q-67699" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/90f51ea4561fc1c1b892863daedc15bb813fbf18a03e1c9366d54f1a883d0db4.png)\n\nFind ${lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,\\pi /2}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4}={lim}_{x\\to \\,\\pi /2}(4x)^{2}\\cdot {lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(4x)^{2} & ={({lim}_{x\\to \\,\\pi /2}(4x))}^{2} \\\\  & =(4\\cdot (\\pi /2))^{2} \\\\  & =(2\\pi )^{2} \\\\  & =4{\\pi }^{2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4} & ={({lim}_{x\\to \\,\\pi /2}(f(x)-2))}^{4} \\\\  & =(1-2)^{4} \\\\  & =(-1)^{4} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi /2}(4x)^{2}(f(x)-2)^{4} & ={lim}_{x\\to \\,\\pi /2}(4x)^{2}\\cdot {lim}_{x\\to \\,\\pi /2}(f(x)-2)^{4} \\\\  & =(4{\\pi }^{2})\\cdot (1) \\\\  & =4{\\pi }^{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261085 :knowledge-point/_questions [{:knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d19d96cc-bcc9-504d-b8b3-ff0d70683c29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3)" :db/id #edb/ref 17592186272968} {:answer/id #uuid "3e9038b6-fc40-584d-9e9d-a2abcb88b5fa" :answer/type {:db/ident :answer.type/math} :answer/value "2(3)" :db/id #edb/ref 17592186272969} {:answer/id #uuid "16407e75-3370-5f5d-9346-82ae9394f68d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272970} {:answer/id #uuid "92f71081-44d4-5bd8-b0e7-6ed65d283020" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186272971} {:answer/id #uuid "66afb206-4529-50c5-b540-5dedbebe01eb" :answer/type {:db/ident :answer.type/math} :answer/value "-(3)" :db/id #edb/ref 17592186272972}] :answer-field/correct {:answer/id #uuid "16407e75-3370-5f5d-9346-82ae9394f68d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272970} :answer-field/id #uuid "aea81ba1-d5f9-5cbe-bc64-9fb59c46b38e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274877}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f14e9302-b81e-5bd4-b3e0-dc1fe5b82277" :question/math-academy-id "q-67702" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1786cfa3ea3b08a97e59ec148a8fe710d6e4b11fc1cbc3582c4bf925a41bf19f.png)\n\nFind ${lim}_{x\\to \\,-2}\\sqrt{17-2f(x)}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,-2}f(x)=4.$ \n\nApplying the root rule, we get\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-2}\\sqrt{17-2f(x)} & =\\sqrt{{lim}_{x\\to \\,-2}(17-2f(x))} \\\\  & =\\sqrt{17-2\\cdot (4)} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261100 :knowledge-point/_questions [{:knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fdacd54-2745-55ca-8711-437e00bb4a43" :answer/type {:db/ident :answer.type/math} :answer/value "[5, 9]" :db/id #edb/ref 17592186272993} {:answer/id #uuid "bda79c7c-cf88-5e90-a602-0ec4bc60cc7a" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 5]" :db/id #edb/ref 17592186272994} {:answer/id #uuid "ab59f143-ab28-5f65-9453-446bd81720e6" :answer/type {:db/ident :answer.type/math} :answer/value "[7, 13]" :db/id #edb/ref 17592186272995} {:answer/id #uuid "fcec8fc1-82d7-5c9b-8992-8013973df6f2" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 9]" :db/id #edb/ref 17592186272996} {:answer/id #uuid "ed3c0574-a366-53c9-8822-5f6f21d7ad8f" :answer/type {:db/ident :answer.type/math} :answer/value "[3,7]" :db/id #edb/ref 17592186272997}] :answer-field/correct {:answer/id #uuid "ed3c0574-a366-53c9-8822-5f6f21d7ad8f" :answer/type {:db/ident :answer.type/math} :answer/value "[3,7]" :db/id #edb/ref 17592186272997} :answer-field/id #uuid "0b80f34d-a115-5ca1-ae46-edca24c65efb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274882}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4551be98-ab92-5187-a58d-9f84d3f63f96" :question/math-academy-id "q-69673" :question/problem "Find the interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,3\\,$ | $\\,5\\,$ | $\\,7\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,-1\\,$ | $\\,5\\,$ | $\\,-3\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,-2\\,$ | $\\,2\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(3)=f(7)=-2,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[3,7].$"}] [{:db/id #edb/ref 17592186261103 :knowledge-point/_questions [{:knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4debaf-0749-5db7-b711-c651994437b5" :answer/type {:db/ident :answer.type/math} :answer/value "[5, 9]" :db/id #edb/ref 17592186272998} {:answer/id #uuid "cfd8d6df-3673-5ad2-adaa-47dc22d5231f" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 5]" :db/id #edb/ref 17592186272999} {:answer/id #uuid "1041b629-9c39-59e7-8785-c6cbd9bdc618" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,9]" :db/id #edb/ref 17592186273000} {:answer/id #uuid "2cd49de0-fb5a-5d28-bc4d-1727a2b192bf" :answer/type {:db/ident :answer.type/math} :answer/value "[7, 13]" :db/id #edb/ref 17592186273001} {:answer/id #uuid "26d1f438-23cd-5e5c-9b16-99acb82f0dfd" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 9]" :db/id #edb/ref 17592186273002}] :answer-field/correct {:answer/id #uuid "1041b629-9c39-59e7-8785-c6cbd9bdc618" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,9]" :db/id #edb/ref 17592186273000} :answer-field/id #uuid "39e8d003-6c73-554c-8a47-13f0df12da42" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274883}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "855a5a4d-d544-5179-beb7-e1ec84d7bfdf" :question/math-academy-id "q-69674" :question/problem "Find an interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-3\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,7\\,$ | $\\,-4\\,$ | $\\,3\\,$ | $\\,-4\\,$ | $\\,1\\,$ | $\\,5\\,$ | $\\,-4\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(-1)=f(9)=-4,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[-1,9].$"}] [{:db/id #edb/ref 17592186261152 :knowledge-point/_questions [{:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa" :knowledge-point/title "Adding Rational Expressions With a Common Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bc1dfc9-c8c1-5c6f-90db-aec199170e9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{5z-3w}{4z})" :db/id #edb/ref 17592186273063} {:answer/id #uuid "d9dbdd3b-913c-5f86-b0dc-18f395230a4e" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{5z-3w}{4z})" :db/id #edb/ref 17592186273064} {:answer/id #uuid "ca9512e7-6b91-57cf-8c63-00b5c5004b3f" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{5z-3w}{4z})" :db/id #edb/ref 17592186273065} {:answer/id #uuid "59a5eb44-7225-5aad-a956-e1b933bf74f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5z-3w}{4z}" :db/id #edb/ref 17592186273066} {:answer/id #uuid "c530ec99-4bfd-5522-8451-70c534d84906" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{5z-3w}{4z})" :db/id #edb/ref 17592186273067}] :answer-field/correct {:answer/id #uuid "59a5eb44-7225-5aad-a956-e1b933bf74f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5z-3w}{4z}" :db/id #edb/ref 17592186273066} :answer-field/id #uuid "e972881e-9b81-589b-a1ba-9d9e0c2035c1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274896}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9ec7633e-93ac-5273-b67e-f7908232a0a5" :question/math-academy-id "q-70143" :question/problem "Simplify $\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z}.$" :question/worked-solution "We have a common denominator of $4z,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{2z-5w}{4z}+\\frac{3z+2w}{4z} & = \\\\ \\frac{2z-5w+3z+2w}{4z} & = \\\\ \\frac{(2z+3z)+(-5w+2w)}{4z} & = \\\\ \\frac{5z-3w}{4z}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261264 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99746b9a-db42-5c76-8f6b-77a4de7baadd" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261266} {:answer/id #uuid "7eb5cd38-555a-5de4-ad48-126e9197b058" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261267} {:answer/id #uuid "c143786c-c752-5d2e-9903-0c52b74f138f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261268} {:answer/id #uuid "3cd1718f-44b0-551a-bbe4-cbdf43e9b0a2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261269} {:answer/id #uuid "3dad651d-436f-570b-bf14-69598cf6d8ef" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261270} {:answer/id #uuid "3b03393d-0fc3-5bfe-bedd-0ae250e58214" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261271} {:answer/id #uuid "386e3c4b-41c6-5019-8f5b-b033d14e311d" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261272} {:answer/id #uuid "4651d533-ecbc-522b-9a54-12bd4e20021e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261273}] :answer-field/correct {:answer/id #uuid "3b03393d-0fc3-5bfe-bedd-0ae250e58214" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261271} :answer-field/id #uuid "db82101f-7c0e-501d-90c5-0ffe2bb275d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261265}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fd9d77ea-492f-56f5-8abf-5300e4f7832a" :question/math-academy-id "q-70907" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{3x+1}=-1$\nII. - $-\\sqrt{4-x}=6$\nIII. - $\\sqrt{2x+1}=1$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only I and II state that a square root is equal to a negative number. Therefore, equations I and II have no real solution.\n\nSo, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186261284 :knowledge-point/_questions [{:knowledge-point/id #uuid "f9eea0ca-bb7a-5e5c-b2d0-472305f2c490" :knowledge-point/title "Solving a Radical Equation When the Radical Is Not Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edfb934-0681-58d1-ab7d-577df9ac4afb" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-2)-2,5\\}" :db/id #edb/ref 17592186273173} {:answer/id #uuid "f82243c1-90e4-51d9-b052-b2b9112a30f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-2)+1,5\\}" :db/id #edb/ref 17592186273174} {:answer/id #uuid "4a88ef15-4a02-5f2c-bc5d-68a2646238b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-2)-1,5\\}" :db/id #edb/ref 17592186273175} {:answer/id #uuid "63a3ed91-a347-5a87-846e-adb1d2172bde" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-2,5\\}" :db/id #edb/ref 17592186273176} {:answer/id #uuid "950434fc-8e57-51d6-b562-975aff735817" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-2)+2,5\\}" :db/id #edb/ref 17592186273177}] :answer-field/correct {:answer/id #uuid "63a3ed91-a347-5a87-846e-adb1d2172bde" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-2,5\\}" :db/id #edb/ref 17592186273176} :answer-field/id #uuid "59d021fa-a82e-5d12-8505-a0fadb932736" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274918}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "90b1010c-b5bd-524a-86d1-a7ed6794e479" :question/math-academy-id "q-70913" :question/problem "Solve $\\sqrt{{x}^{2}-3x+6}-4=0.$" :question/worked-solution "First, we isolate the square root by adding $4$ to both sides:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-3x+6}-4 & =0 \\\\ \\sqrt{{x}^{2}-3x+6} & =4\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-3x+6} & =4 \\\\ {(\\sqrt{{x}^{2}-3x+6})}^{2} & ={4}^{2} \\\\ {x}^{2}-3x+6 & =16 \\\\ {x}^{2}-3x-10 & =0 \\\\ (x+2)(x-5) & =0 \\\\ x & =-2,\\,5.\\end{aligned}\n$$\n\nLet's check the results by plugging them into the original equation.\n\n- For $x=-2,$ we get\n\n$$\n\\begin{aligned}\\sqrt{(-2)^{2}-3(-2)+6}-4 & \\overset{?}{=}0 \\\\ \\sqrt{4+6+6}-4 & \\overset{?}{=}0 \\\\ \\sqrt{16}-4 & \\overset{?}{=}0 \\\\ 4-4 & \\overset{?}{=}0 \\\\ 0 & =0.\\,\\,✓\\end{aligned}\n$$\n\n- For $x=5,$ we get\n\n$$\n\\begin{aligned}\\sqrt{{5}^{2}-3(5)+6}-4 & \\overset{?}{=}0 \\\\ \\sqrt{25-15+6}-4 & \\overset{?}{=}0 \\\\ \\sqrt{16}-4 & \\overset{?}{=}0 \\\\ 4-4 & \\overset{?}{=}0 \\\\ 0 & =0.\\,\\,✓\\end{aligned}\n$$\n\nBoth $x=-2$ and $x=5$ satisfy the original equation, so we can accept them both as solutions.\n\nTherefore, the solutions to $\\sqrt{{x}^{2}-3x+6}-4=0$ are $x=-2$ and $x=5.$"}] [{:db/id #edb/ref 17592186261611 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffe0d77e-52ec-55af-86ee-7865dc316245" :knowledge-point/title "Finding the LCM of Three Monomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ae96aae-1f10-5ac7-9d29-105c275549e4" :answer/type {:db/ident :answer.type/math} :answer/value "12{w}^{3}" :db/id #edb/ref 17592186273571} {:answer/id #uuid "d8073d17-352d-5ea3-bcfa-4f1cb00b9517" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(12{w}^{3})" :db/id #edb/ref 17592186273572} {:answer/id #uuid "d632c816-a222-5e8e-b9ba-45e2d2ef2cdb" :answer/type {:db/ident :answer.type/math} :answer/value "3(12{w}^{3})" :db/id #edb/ref 17592186273573} {:answer/id #uuid "5ed832fe-8708-575c-a106-069f39aca48d" :answer/type {:db/ident :answer.type/math} :answer/value "2(12{w}^{3})" :db/id #edb/ref 17592186273574} {:answer/id #uuid "1a59a83f-214f-5cad-98db-156efd569fcc" :answer/type {:db/ident :answer.type/math} :answer/value "-(12{w}^{3})" :db/id #edb/ref 17592186273575}] :answer-field/correct {:answer/id #uuid "6ae96aae-1f10-5ac7-9d29-105c275549e4" :answer/type {:db/ident :answer.type/math} :answer/value "12{w}^{3}" :db/id #edb/ref 17592186273571} :answer-field/id #uuid "0c3b091d-1720-5e63-b555-a040fcf0b69c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274998}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8eb1d235-c690-5225-8779-e89c17dee989" :question/math-academy-id "q-76311" :question/problem "Find the least common multiple of $6w,$ $3{w}^{3},$ and $4{w}^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of three monomials, we find the least common multiple of the constants and the least common multiple of the variable parts. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(6,3,4):$\n\n- Multiples of $6:$ $\\,6,12,18,…$\n\n- Multiples of $3:$ $\\,3,6,9,12,…$\n\n- Multiples of $4:$ $\\,4,8,12,16,…$\n\nSo, $\\text{LCM}(6,3,4)=12.$\n\nTo find the $\\text{LCM}$ of $w,\\,{w}^{3},$ and ${w}^{2},$ we raise $w$ to the largest power that appears in all the expressions, which is $3.$ Therefore,\n\n$$\n\\text{LCM}(w,{w}^{3},{w}^{2})={w}^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(6w,3{w}^{3},4{w}^{2})=12\\cdot {w}^{3}=12{w}^{3}.\n$$"}] [{:db/id #edb/ref 17592186261652 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/title "Applying the Root Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d042c1b5-252e-5908-a1ae-7c1b3e3df608" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186273626} {:answer/id #uuid "9f367fc2-b6a0-57be-bae3-3be5cbfce69f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273627} {:answer/id #uuid "a62a20b5-9b4b-5cf6-af0e-2287e2dc9fde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186273628} {:answer/id #uuid "46e05939-6de2-5b5a-ac2e-70ae094a6ecb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273629} {:answer/id #uuid "01e59777-35f0-5571-bd89-0c4975d0997b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273630}] :answer-field/correct {:answer/id #uuid "a62a20b5-9b4b-5cf6-af0e-2287e2dc9fde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186273628} :answer-field/id #uuid "48d7881f-9650-5ee9-ae53-56f5169c6be4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275009}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a8ee25c9-f495-51c7-80ce-fd000c80af30" :question/math-academy-id "q-77740" :question/problem "Find ${lim}_{x\\to 4}\\frac{\\sqrt{{x}^{2}+9}-1}{3x-2}.$" :question/worked-solution "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 4}\\frac{\\sqrt{{x}^{2}+9}-1}{3x-2}=\\frac{{lim}_{x\\to 4}(\\sqrt{{x}^{2}+9}-1)}{{lim}_{x\\to 4}(3x-2)}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nApplying the root rule in the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}(\\sqrt{{x}^{2}+9}-1) & =\\sqrt{{4}^{2}+9}-1 \\\\  & =\\sqrt{16+9}-1 \\\\  & =\\sqrt{25}-1 \\\\  & =5-1 \\\\  & =4\\,.\\end{aligned}\n$$\n\nFor the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 4}(3x-2) & =3(4)-2 \\\\  & =10\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{\\sqrt{{x}^{2}+9}-1}{3x-2} & =\\frac{4}{10} \\\\  & =\\frac{2}{5}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261655 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abd7eb2-6e80-508b-8a88-0839f9c4cece" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186273631} {:answer/id #uuid "7025ad1a-64fb-57a5-9b27-fe2c9a75fb8c" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186273632} {:answer/id #uuid "af04f696-98e5-5974-ae2a-effbb4e66e25" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186273633} {:answer/id #uuid "a2cb06c4-65bf-5ee1-a16b-199dd7a96663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186273634} {:answer/id #uuid "6e9ca8f5-696c-5a09-91b2-6036247907da" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273635}] :answer-field/correct {:answer/id #uuid "a2cb06c4-65bf-5ee1-a16b-199dd7a96663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186273634} :answer-field/id #uuid "c32d9975-4e0a-5b9f-9b7b-3a5e49610531" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275010}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "336e3700-4bb5-5eae-b287-47106b8a9236" :question/math-academy-id "q-77743" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/44196cce68dab39addc447b332273371d5becb94bc0068e5200eeda596239ffa.png)\n\nFind ${lim}_{x\\to 0}\\frac{(2f(x)+3)^{8}}{(f(x)+4)^{3}}$ for the function $f(x)$ plotted above." :question/worked-solution "Using the power and quotient rules, we can rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(2f(x)+3)^{8}}{(f(x)+4)^{3}} & =\\frac{{({lim}_{x\\to 0}(2f(x)+3))}^{8}}{{({lim}_{x\\to 0}(f(x)+4))}^{3}}\\end{aligned}\n$$\n\nThe above is true provided that  ${lim}_{x\\to 0}f(x)$ exists.\n\nWe find from the graph that ${lim}_{x\\to 0}f(x)=-2.$ We calculate the limits of the numerator and denominator, separately.\n\n$$\n{lim}_{x\\to 0}(2f(x)+3)=2(-2)+3=-1\n$$\n\nand\n\n$$\n{lim}_{x\\to 0}(f(x)+4)=-2+4=2\n$$\n\nSo we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(2f(x)+3)^{8}}{(f(x)+4)^{3}} & =\\frac{{({lim}_{x\\to 0}(2f(x)+3))}^{8}}{{({lim}_{x\\to 0}(f(x)+4))}^{3}} \\\\  & =\\frac{(-1)^{8}}{{2}^{3}} \\\\  & =\\frac{1}{8}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261658 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad5b6836-697d-5ed3-a0b3-61ad971116f0" :answer/type {:db/ident :answer.type/math} :answer/value "(81)/(64)" :db/id #edb/ref 17592186273636} {:answer/id #uuid "7686d703-7db3-589a-8316-a71f5cd239a2" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186273637} {:answer/id #uuid "52526968-ca1f-5edc-92e2-b96fcc0c4e29" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(64)" :db/id #edb/ref 17592186273638} {:answer/id #uuid "230fc1b0-73b3-5de8-b42d-95b6d9cd02fc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273639} {:answer/id #uuid "2e106913-e6e4-546e-8e1f-45e2ad67832b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186273640}] :answer-field/correct {:answer/id #uuid "2e106913-e6e4-546e-8e1f-45e2ad67832b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186273640} :answer-field/id #uuid "fbf78ae4-0941-5820-87fb-ff74f9b2ca50" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275011}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3fd05b19-c616-5951-a797-4ee3e4c55001" :question/math-academy-id "q-77745" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4b3ef4ce6c3c2d40c60639b8467649155fb7e8a3c018dff359bf766a86cf8054.png)\n\nFind ${lim}_{x\\to 2}\\frac{(3f(x)-1)^{2}}{(f(x)-1)^{3}}$ for the function $f(x)$ plotted above." :question/worked-solution "Using the power and quotient rules, we can rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{(3f(x)-1)^{2}}{(f(x)-1)^{3}} & =\\frac{{({lim}_{x\\to 2}(3f(x)-1))}^{2}}{{({lim}_{x\\to 2}(f(x)-1))}^{3}}\\end{aligned}\n$$\n\nThe above is true provided that  ${lim}_{x\\to 2}f(x)$ exists.\n\nWe find from the graph that ${lim}_{x\\to 2}f(x)=-1.$ We calculate the limits of the numerator and denominator, separately.\n\n$$\n{lim}_{x\\to 2}(3f(x)-1)=3(-1)-1=-4\n$$\n\nand\n\n$$\n{lim}_{x\\to 2}(f(x)-1)=-1-1=-2\n$$\n\nSo we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{(3f(x)-1)^{2}}{(f(x)-1)^{3}} & =\\frac{{({lim}_{x\\to 2}(3f(x)-1))}^{2}}{{({lim}_{x\\to 2}(f(x)-1))}^{3}} \\\\  & =\\frac{(-4)^{2}}{(-2)^{3}} \\\\  & =\\frac{16}{-8} \\\\  & =-2\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261685 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5859d225-2274-54f7-9d72-83cf86f4624f" :answer/type {:db/ident :answer.type/math} :answer/value "-(4)" :db/id #edb/ref 17592186273661} {:answer/id #uuid "51999cfc-dbca-584c-900f-eeb68612e8a8" :answer/type {:db/ident :answer.type/math} :answer/value "3(4)" :db/id #edb/ref 17592186273662} {:answer/id #uuid "901189db-cc00-54aa-85b2-12bb72b0a560" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(4)" :db/id #edb/ref 17592186273663} {:answer/id #uuid "cf468797-fe0a-5eb2-9f09-a3274347e327" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273664} {:answer/id #uuid "6159b17a-8651-5fcc-bcd3-6ae12e3df98d" :answer/type {:db/ident :answer.type/math} :answer/value "2(4)" :db/id #edb/ref 17592186273665}] :answer-field/correct {:answer/id #uuid "cf468797-fe0a-5eb2-9f09-a3274347e327" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273664} :answer-field/id #uuid "d9ee0fb9-e2db-511e-998a-334676e44ba3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275016}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e6b1c009-5d14-58f7-8b31-aa7d55ec544b" :question/math-academy-id "q-78108" :question/problem "The number of bacteria in culture is given by the function $f(t)=-0.6{t}^{2}+10t+50,$ where $t$ is the time, in minutes, since the bacteria was isolated. What is the average rate of growth of $f(t)$ over the first $10$ minutes?" :question/worked-solution "Let $f(t)=-0.6{t}^{2}+10t+50$ be the number of bacteria in the culture after $t$ minutes. To find the average rate of growth of $f(t)$ over the first $10$ minutes, we use the average rate of change formula on the interval $[0,10]$:\n\n$$\n\\begin{aligned}\\frac{Δf}{Δt} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(10)-f(0)}{10-0} \\\\  & =\\frac{[-0.6(10)^{2}+10(10)+50]-[-0.6(0)^{2}+10(0)+50]}{10} \\\\  & =\\frac{90-50}{10} \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the average rate of growth over the first $10$ minutes is $4$ bacteria per minute."}] [{:db/id #edb/ref 17592186261707 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6943d3bc-08ed-53a3-8a57-6aae7d7ff9a3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273681} {:answer/id #uuid "22210e3d-c40e-525e-ab74-c54a7a3e4881" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186273682} {:answer/id #uuid "b647ecf6-7f7d-5b54-8556-6c34fcf44c8d" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186273683} {:answer/id #uuid "9806ddb2-bd19-54ca-910a-3aa340353f3a" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186273684} {:answer/id #uuid "1d1df1e6-9f44-5cd0-9da4-2f2c15105888" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186273685}] :answer-field/correct {:answer/id #uuid "6943d3bc-08ed-53a3-8a57-6aae7d7ff9a3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273681} :answer-field/id #uuid "6bef5d70-409d-5277-8664-b9eb3cc2bf74" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275020}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2f233d26-a151-550e-abff-b0d56859a52f" :question/math-academy-id "q-78618" :question/problem "Given $f(x)=10-{x}^{3}$ and $g(x)=5-2x,$ find  $(f+g)(2).$" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1** \n\nTo evaluate $(f+g)(2),$ we find $f(2)$ and $g(2),$ and then add the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =10-(2)^{3}=2 \\\\ g(2) & =5-2(2)=1\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(2)=f(2)+g(2)=2+1=3\n$$\n\n**Method 2** \n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(10-{x}^{3})+(5-2x) \\\\  & =-{x}^{3}-2x+15\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(2):$\n\n$$\n\\begin{aligned}(f+g)(2) & =-(2)^{3}-2(2)+15=-8-4+15=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261713 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffe05e10-59ca-5e25-968e-10a0fd41d964" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261715} {:answer/id #uuid "3bac9522-9348-55e2-8330-c263d930694f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261716} {:answer/id #uuid "f1ebc174-5cc1-5840-9e5c-5604061f4908" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261717} {:answer/id #uuid "8d215e9d-5ee0-531c-9c56-59b308a6aae9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261718} {:answer/id #uuid "f0e5aee1-5d41-56e7-b00c-80ee9183cb2b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261719} {:answer/id #uuid "4c181833-3588-536c-81c1-ced79756a50a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261720} {:answer/id #uuid "677dc537-57f0-5a09-8d3d-50b6e22a18b6" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261721} {:answer/id #uuid "986b5eb8-60ce-5158-9a08-c5ea42ea71a3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261722}] :answer-field/correct {:answer/id #uuid "8d215e9d-5ee0-531c-9c56-59b308a6aae9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261718} :answer-field/id #uuid "7f576e7a-0943-56d5-9e53-5531538e2081" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261714}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e48707eb-c35d-5d97-8abc-4a048269c15c" :question/math-academy-id "q-79248" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{2x-4}=-2$\nII. - $\\sqrt{8-3x}=1$\nIII. - $\\sqrt{x-7}=4$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only I states that a square root is equal to a negative number. Therefore, equation I has no real solution.\n\nSo, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186261723 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2230ade-0920-5220-9045-cd6d1c6a1d14" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261725} {:answer/id #uuid "126cee81-9a83-5954-83a2-22c702f4a5b6" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261726} {:answer/id #uuid "57308651-1460-57b4-a7d1-30b9fe7b42ff" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261727} {:answer/id #uuid "2d4c9c70-57f5-5518-a8ed-9b7f71ff2227" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261728} {:answer/id #uuid "00f59731-286b-54c8-86e4-a1b98f41bf30" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261729} {:answer/id #uuid "7cd7cc04-afa2-5f31-b312-8df61565bf85" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261730} {:answer/id #uuid "b700074f-ff81-5931-a4ec-44982358a62b" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261731} {:answer/id #uuid "15950900-69d0-5101-973e-12dc011fb487" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261732}] :answer-field/correct {:answer/id #uuid "57308651-1460-57b4-a7d1-30b9fe7b42ff" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261727} :answer-field/id #uuid "1f2b5810-9eef-5df4-8922-1d1b9118af75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261724}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a1727d27-de04-53c4-a9de-9b0d34a8d70c" :question/math-academy-id "q-79249" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{3x+7}=-4$\nII. - $\\sqrt{5x-6}=2$\nIII. - $\\sqrt{4x-3}=-3$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only I and III state that a square root is equal to a negative number. Therefore, equations I and III have no real solution.\n\nSo, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186261739 :knowledge-point/_questions [{:knowledge-point/id #uuid "e836ca22-abd9-5812-bbf7-3b057e3d6c4b" :knowledge-point/title "Factoring Biquadratic Expressions as Quadratic Trinomials With Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b86dc8-b6a5-573b-ac84-9fe072c5a499" :answer/type {:db/ident :answer.type/math} :answer/value "-((3{s}^{2}-4)(2{s}^{2}-1))" :db/id #edb/ref 17592186273701} {:answer/id #uuid "a2749fa6-47ff-5713-a8e8-7e4d7c7c71d4" :answer/type {:db/ident :answer.type/math} :answer/value "(3{s}^{2}-4)(2{s}^{2}-1)" :db/id #edb/ref 17592186273702} {:answer/id #uuid "ff3cb8b0-ecb7-5bde-9d88-61ea0b8d2188" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}((3{s}^{2}-4)(2{s}^{2}-1))" :db/id #edb/ref 17592186273703} {:answer/id #uuid "6311509f-e311-5313-b464-8d65374a1f27" :answer/type {:db/ident :answer.type/math} :answer/value "3((3{s}^{2}-4)(2{s}^{2}-1))" :db/id #edb/ref 17592186273704} {:answer/id #uuid "e6507a39-f6ae-5c95-8224-d2834f12bb20" :answer/type {:db/ident :answer.type/math} :answer/value "2((3{s}^{2}-4)(2{s}^{2}-1))" :db/id #edb/ref 17592186273705}] :answer-field/correct {:answer/id #uuid "a2749fa6-47ff-5713-a8e8-7e4d7c7c71d4" :answer/type {:db/ident :answer.type/math} :answer/value "(3{s}^{2}-4)(2{s}^{2}-1)" :db/id #edb/ref 17592186273702} :answer-field/id #uuid "6ab09eec-cb41-5bad-b5d5-bb03cd8d479c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275024}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f9d893db-0a35-530c-94cc-02031aeec566" :question/math-academy-id "q-79497" :question/problem "Factor $6{s}^{4}-11{s}^{2}+4.$" :question/worked-solution "We can introduce a new variable $t={s}^{2}$ and then rewrite the trinomial as a quadratic in terms of $t:$\n\n$$\n\\begin{aligned}6{s}^{4}-11{s}^{2}+4 & =6{({s}^{2})}^{2}-11({s}^{2})+4 \\\\  & =6{t}^{2}-11t+4\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $s:$\n\n$$\n\\begin{aligned}6{t}^{2}-11t+4 & =(3t-4)(2t-1) \\\\  & =(3{s}^{2}-4)(2{s}^{2}-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261745 :knowledge-point/_questions [{:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa" :knowledge-point/title "Adding Rational Expressions With a Common Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3e6914b-0ac6-5f28-955b-0d287e3181ef" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{3}{2})" :db/id #edb/ref 17592186273711} {:answer/id #uuid "3028fa0d-f1d3-5451-a31b-ba55049447b5" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{3}{2})" :db/id #edb/ref 17592186273712} {:answer/id #uuid "17c6b228-6605-50b9-a99d-95a1ed1652c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{3}{2})" :db/id #edb/ref 17592186273713} {:answer/id #uuid "48bc09ee-ffca-5ca9-b5f1-304141104676" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{3}{2})" :db/id #edb/ref 17592186273714} {:answer/id #uuid "8655612f-8c9d-5820-888f-3e87e0eec2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186273715}] :answer-field/correct {:answer/id #uuid "8655612f-8c9d-5820-888f-3e87e0eec2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186273715} :answer-field/id #uuid "77e1ffbc-bb00-5194-8406-09b8324e94ed" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275026}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3c0f2338-2ab2-574c-954b-5e423f2531e4" :question/math-academy-id "q-79540" :question/problem "Simplify $\\frac{x-3}{2x}+\\frac{3+2x}{2x}.$" :question/worked-solution "We have a common denominator of $2x,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{x-3}{2x}+\\frac{3+2x}{2x} & = \\\\ \\frac{x-3+3+2x}{2x} & = \\\\ \\frac{(-3+3)+(x+2x)}{2x} & = \\\\ \\frac{3x}{2x} & = \\\\ \\frac{3}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261938 :knowledge-point/_questions [{:knowledge-point/id #uuid "7eab4249-544e-56c6-81c0-e6db84033701" :knowledge-point/title "Computing the Variance Given the Number, Sum, and Sum of Squares of the Data Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79aa2e40-f4d2-5709-8b5b-54790b86acf2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261940}] :answer-field/correct {:answer/id #uuid "79aa2e40-f4d2-5709-8b5b-54790b86acf2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261940} :answer-field/id #uuid "b5dbac9f-85f4-59c4-8a53-10bde3633c1d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261939}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7dfa7943-f9fd-587a-96e7-82a3ae160d16" :question/math-academy-id "q-87562" :question/problem "Compute the variance ${\\sigma }^{2}$ of a data set ${x}_{i}$ consisting of $9$ data points, where\n\n$$\n{\\sum }_{i=1}^{9}{x}_{i}=27,\\,{\\sum }_{i=1}^{9}{x}_{i}^{2}=117.\n$$\n\nAnswer: {{answer}}" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance of the data set is given by \n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=9$ points in our data set, and we know that ${\\sum }_{i=1}^{9}{x}_{i}=27,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{9}{\\sum }_{i=1}^{9}{x}_{i} \\\\  & =\\frac{1}{9}\\cdot 27 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ We know that ${\\sum }_{i=1}^{9}{x}_{i}^{2}=117,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{9}{\\sum }_{i=1}^{9}{x}_{i}^{2} \\\\  & =\\frac{1}{9}\\cdot 117 \\\\  & =13.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =13-{(3)}^{2} \\\\  & =13-9 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261944 :knowledge-point/_questions [{:knowledge-point/id #uuid "c8effb25-abe6-5e37-8f2c-91ad12868b1a" :knowledge-point/title "Stretching a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8e5afe-e88e-5c4a-ac67-f6915d570a88" :answer/type {:db/ident :answer.type/math} :answer/value "((5)-1,3)" :db/id #edb/ref 17592186273913} {:answer/id #uuid "eecd525c-c5d1-5fb3-b04a-ea12253e0b7c" :answer/type {:db/ident :answer.type/math} :answer/value "((5)-2,3)" :db/id #edb/ref 17592186273914} {:answer/id #uuid "a7e53fc2-647b-53d2-8ef9-c32c486ecbf1" :answer/type {:db/ident :answer.type/math} :answer/value "((5)+2,3)" :db/id #edb/ref 17592186273915} {:answer/id #uuid "16c2494c-f538-59ee-8788-6177d4cf889c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186273916} {:answer/id #uuid "37e50d16-bc83-56da-80e4-7ae5168dfd23" :answer/type {:db/ident :answer.type/math} :answer/value "((5)+1,3)" :db/id #edb/ref 17592186273917}] :answer-field/correct {:answer/id #uuid "16c2494c-f538-59ee-8788-6177d4cf889c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186273916} :answer-field/id #uuid "2bcd66a5-0d2c-52ca-8863-789dcf243cf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275067}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "76d5aa8d-6b7f-5a59-a437-5e21bbd91bff" :question/math-academy-id "q-88205" :question/problem "A stretch of factor $-\\frac{1}{2}$ and invariant $x$-axis is applied to the point $(5,-6).$  What is the resulting point?" :question/worked-solution "Applying a stretch of factor $-\\frac{1}{2}$ and invariant $x$-axis to a point means that the $y$-coordinate of the point should be multiplied by $-\\frac{1}{2}.$ \n\nThe following function represents this transformation:\n\n$$\n(x,y)↦(x,-\\frac{1}{2}y)\n$$\n\nTherefore, the resulting point is\n\n$$\n(5,-6)↦(5,-\\frac{1}{2}\\cdot (-6))=(5,3).\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/76787875dff29fa140881c6de2ee0d7c08baf394994e31246204d21bbcf61f56.png)"}] [{:db/id #edb/ref 17592186261961 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c98ce69-8410-51a4-8d9c-eec7b46fb83b" :knowledge-point/title "Global vs. Local Extrema"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab74f05-3afc-5968-87f4-be4d044e94c5" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261963} {:answer/id #uuid "e6b21ac8-297f-5559-8890-905d5525ed71" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261964} {:answer/id #uuid "2de2d434-323b-5bd0-88c3-4a9168bb5e3d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261965} {:answer/id #uuid "e35d3b70-777c-576e-9426-bd095fa9b141" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261966} {:answer/id #uuid "8f387637-8b17-53e2-9637-872e8c44aabf" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261967} {:answer/id #uuid "8b88f3ab-2919-5f84-8aa0-b48c86a90793" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261968} {:answer/id #uuid "57b09224-30af-51ef-b156-ee01bb809d0a" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261969} {:answer/id #uuid "6be2d733-af51-531c-a6ae-fb3b8f9f6ff2" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261970}] :answer-field/correct {:answer/id #uuid "8f387637-8b17-53e2-9637-872e8c44aabf" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261967} :answer-field/id #uuid "1396d91b-da49-5297-9871-ffd0d3227bab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261962}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "029317bc-fcf6-501c-9125-ecc74c217368" :question/math-academy-id "q-90623" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/632da466eb26480490a49f9c5a71e0d6f95653efa749a8f117d81e016fd969ae.png)\n\nThe graph of a function $y=f(x)$ is shown above. Which of the following statements are true?\n\nI. - $f(x)$ attains a **global** maximum at $x=4$\nII. - $f(x)$ attains a **global** minimum at $x=3$\nIII. - $f(x)$ attains a local maximum at $x=1$" :question/worked-solution "Let's examine each of the given statements in turn.\n\n- Statement I is false. The function does *not* have a global maximum at $x=4.$ The global maximum is the highest point on the graph, but our function has points where its value is greater than $f(4).$ For example, $f(1)>f(4).$\n\n- Statement II is false. The function does *not* have a global minimum at $x=3.$ The global minimum is the lowest point on the graph, but our function has points where its value is smaller than $f(3).$ For example, $f(6)<f(3).$\n\n- Statement III is true. The function has a local maximum at $x=1.$ For example, in the interval $(0.5,1.5),$ the greatest value of the function is attained at $x=1,$ as shown below.\n\nWe can write this mathematically as $f(x)\\le f(1)\\,$ for all $\\,x\\in (0.5,1.5).$ \n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186261974 :knowledge-point/_questions [{:knowledge-point/id #uuid "760a1a5b-4c06-547d-9248-a6acb97c4b84" :knowledge-point/title "Raising i to a Positive Integer Power Using the Cyclic Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9418da8-22f6-52fc-ae63-f84104831591" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186273943} {:answer/id #uuid "917b6f94-e306-5e8b-b696-7d7f31f0d95b" :answer/type {:db/ident :answer.type/math} :answer/value "− \\textrm{i}" :db/id #edb/ref 17592186273944} {:answer/id #uuid "0b3c925c-5a29-551e-80e6-b800dd088a73" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186273945} {:answer/id #uuid "074feb8d-5760-5db4-aa90-fe90b4ba2031" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273946} {:answer/id #uuid "d7364c17-e720-5d20-bef3-b30376685e98" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273947}] :answer-field/correct {:answer/id #uuid "0b3c925c-5a29-551e-80e6-b800dd088a73" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186273945} :answer-field/id #uuid "011c4ee7-7bad-5ecc-bd6c-a06d60374606" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c4b2df1e-6d40-59ba-a881-5e43b1cc0734" :question/math-academy-id "q-924" :question/problem "${\\text{i}}^{33}=$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=33.$ Dividing the power by $4,$ we get\n\n$$\n33÷4=8\\,\\text{R}1.\n$$\n\nSo the remainder is $1.$ Therefore,\n\n$$\n{\\text{i}}^{33}={\\text{i}}^{1}=\\text{i}.\n$$"}]}
