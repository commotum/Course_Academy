#{[{:db/id #edb/ref 17592186256429 :knowledge-point/_questions [{:knowledge-point/id #uuid "2954b59f-d701-502f-963b-b62098a87c34" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea751cf-2a00-5214-9818-43e68fac1756" :answer/type {:db/ident :answer.type/math} :answer/value "(103)/(19)" :db/id #edb/ref 17592186269292} {:answer/id #uuid "c2e35580-2a0c-5621-a03a-4a13146e2451" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269293} {:answer/id #uuid "0dd1d771-7fd1-5539-a401-460cd85c47a4" :answer/type {:db/ident :answer.type/math} :answer/value "(153)/(25)" :db/id #edb/ref 17592186269294} {:answer/id #uuid "ece9dae9-779e-533f-86d5-d9c425b4134f" :answer/type {:db/ident :answer.type/math} :answer/value "(100)/(17)" :db/id #edb/ref 17592186269295} {:answer/id #uuid "668205a4-c2e7-52e9-996c-111dbca0d42e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269296}] :answer-field/correct {:answer/id #uuid "c2e35580-2a0c-5621-a03a-4a13146e2451" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269293} :answer-field/id #uuid "48d0b589-145c-5c24-94db-1edb64efd94f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274133}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ccfa9d31-45ab-5f64-a4e2-3d1fa5018f4c" :question/math-academy-id "q-10018" :question/problem "Calculate the sum to infinity of the geometric series $9+0.9+0.09+0.009+⋯$" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=9$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.9}{9}=0.1.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{9}{1-0.1} \\\\  & =\\frac{9}{0.9} \\\\  & =\\frac{90}{9} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256462 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fcc555-c18e-54af-bf99-dfb9e4502e77" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186269347} {:answer/id #uuid "a82eabb2-922d-5898-958f-ce0d2e835904" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{21}" :db/id #edb/ref 17592186269348} {:answer/id #uuid "af6f725a-3dbb-5885-9b70-a30809cc6c09" :answer/type {:db/ident :answer.type/math} :answer/value "− 13" :db/id #edb/ref 17592186269349} {:answer/id #uuid "a40c6c68-c3cb-51bd-99c9-629eaf471015" :answer/type {:db/ident :answer.type/math} :answer/value "− 18" :db/id #edb/ref 17592186269350} {:answer/id #uuid "b969889a-f3d4-52b6-896f-beab8a33f7aa" :answer/type {:db/ident :answer.type/math} :answer/value "− 6" :db/id #edb/ref 17592186269351}] :answer-field/correct {:answer/id #uuid "a82eabb2-922d-5898-958f-ce0d2e835904" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{21}" :db/id #edb/ref 17592186269348} :answer-field/id #uuid "9fa0abc0-26fb-5be6-bf8f-a4d3b59634e8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274144}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "50d2f9b4-0b9f-53dd-8422-aae20f0d13ad" :question/math-academy-id "q-100459" :question/problem "If ${216}^{3a+4}={(\\frac{1}{36})}^{6a-2}$ then $a=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $216={6}^{3}$ and $36={6}^{2},$ as follows:\n\n$$\n{({6}^{3})}^{3a+4}={(\\frac{1}{{6}^{2}})}^{6a-2}\n$$\n\nThen, we apply the power rule and the quotient rule of exponents. This gives:\n\n$$\n\\begin{aligned}{6}^{3(3a+4)}=\\frac{1}{{6}^{2(6a-2)}}\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using a negative exponent:\n\n$$\n\\begin{aligned}{6}^{3(3a+4)}={6}^{-2(6a-2)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(6)$, we equate the exponents and solve for $a:$\n\n$$\n\\begin{aligned}3(3a+4) & =-2(6a-2) \\\\ 9a+12 & =-12a+4 \\\\ 21a & =-8 \\\\ a & =-\\frac{8}{21}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256650 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d532119-a4cc-57a5-a45f-8e391248155d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{csc}x(1-\\operatorname{cot}x)" :db/id #edb/ref 17592186269572} {:answer/id #uuid "e02c54d9-d78f-5dea-b7e6-6a743dbe73db" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x + \\csc x\\cot x + \\sin x" :db/id #edb/ref 17592186269573} {:answer/id #uuid "92037fc7-cb49-5f97-b7a1-44a260e14433" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x − \\csc x\\cot x − \\sin x" :db/id #edb/ref 17592186269574} {:answer/id #uuid "cb7e0621-0639-5e25-8d0b-3ac02fc3581b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x − \\csc^{2} x + \\sin x" :db/id #edb/ref 17592186269575} {:answer/id #uuid "c8012914-a052-5104-a9e7-16f60939da9f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x + \\csc^{2} x + \\sin x" :db/id #edb/ref 17592186269576}] :answer-field/correct {:answer/id #uuid "8d532119-a4cc-57a5-a45f-8e391248155d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{csc}x(1-\\operatorname{cot}x)" :db/id #edb/ref 17592186269572} :answer-field/id #uuid "e9cd5d1b-c219-507e-aba8-80e80b804f20" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274189}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "667f744b-3445-5e28-b209-637d4bc0f280" :question/math-academy-id "q-104316" :question/problem "Find ${f}^{'}(x)$ if $f(x)={e}^{x}\\operatorname{csc}x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}\\operatorname{csc}x) \\\\  & ={e}^{x}(\\operatorname{csc}x)+{e}^{x}(-\\operatorname{csc}x\\operatorname{cot}x) \\\\  & ={e}^{x}\\operatorname{csc}x(1-\\operatorname{cot}x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256653 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c932c9b-3bea-5703-bbd3-deadeab003fa" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{2}" :db/id #edb/ref 17592186269577} {:answer/id #uuid "2b8423aa-22ee-5b32-841a-5795dfd6e557" :answer/type {:db/ident :answer.type/math} :answer/value "2(1-\\frac{\\pi }{2})" :db/id #edb/ref 17592186269578} {:answer/id #uuid "12150056-8f99-533d-9899-8807d60b6475" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269579} {:answer/id #uuid "390f11b0-98d3-57cf-ba50-1500cce79aae" :answer/type {:db/ident :answer.type/math} :answer/value "-(1-\\frac{\\pi }{2})" :db/id #edb/ref 17592186269580} {:answer/id #uuid "d9d9e705-4527-5f64-b282-484cbb14b166" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269581}] :answer-field/correct {:answer/id #uuid "3c932c9b-3bea-5703-bbd3-deadeab003fa" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{\\pi }{2}" :db/id #edb/ref 17592186269577} :answer-field/id #uuid "2b016ce0-6f29-5d99-a2cc-051fbad504ae" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274190}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1bd6438f-7499-53a3-942a-e79c9cbb8468" :question/math-academy-id "q-104437" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{4}$ if $f(x)=x\\operatorname{cot}x.$" :question/worked-solution "First, we take the derivative using the product rule:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}x) \\\\  & =\\operatorname{cot}x+x(-{csc}^{2}x) \\\\  & =\\operatorname{cot}x-x{csc}^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{\\pi /4} & =\\operatorname{cot}(\\frac{\\pi }{4})-\\frac{\\pi }{4}{csc}^{2}(\\frac{\\pi }{4}) \\\\  & =1-\\frac{\\pi }{4}\\cdot (\\sqrt{2})^{2} \\\\  & =1-\\frac{\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256824 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c6b30e7-fba6-597c-8306-27d707bfc244" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting One Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2d04eff-dd2e-53b7-b8d8-37ff63efc484" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/(4)" :db/id #edb/ref 17592186269786} {:answer/id #uuid "8ea5d83e-f4f1-5791-ab23-1947a431390e" :answer/type {:db/ident :answer.type/math} :answer/value "− 5" :db/id #edb/ref 17592186269787} {:answer/id #uuid "55ff7b42-408a-5563-af26-49d23dd7e381" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186269788} {:answer/id #uuid "cf2e07d5-5315-5c92-8cc6-acfbee509ef2" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(5)" :db/id #edb/ref 17592186269789} {:answer/id #uuid "8c1236d4-4e2d-5d25-9ba4-08e316fdfe2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186269790}] :answer-field/correct {:answer/id #uuid "8c1236d4-4e2d-5d25-9ba4-08e316fdfe2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186269790} :answer-field/id #uuid "4a2c3411-7a29-57e2-87a1-635d0cf0d5c4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274232}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f61369c5-9b9f-545c-8059-dd0509d17c85" :question/math-academy-id "q-110539" :question/problem "If ${81}^{2a}=\\frac{1}{{3}^{a-1}}$ then $a=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base.\n\nTo do this, we write $81$ as ${3}^{4},$ and then we rewrite the right-hand side using the power rule of exponents:\n\n$$\n\\begin{aligned}{81}^{2a} & =\\frac{1}{{3}^{a-1}} \\\\ {({3}^{4})}^{2a} & =\\frac{1}{{3}^{a-1}} \\\\ {3}^{8a} & =\\frac{1}{{3}^{a-1}}\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using a negative exponent: \n\n$$\n\\begin{aligned}{3}^{8a} & ={3}^{-(a-1)}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(3),$ we equate the exponents and solve for $a:$\n\n$$\n\\begin{aligned}8a & =-(a-1) \\\\ 8a & =-a+1 \\\\ 9a & =1 \\\\ a & =\\frac{1}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257155 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b3afcbb-5bc9-5a57-96cd-97f247b02f33" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos 1 + \\sin 1" :db/id #edb/ref 17592186270227} {:answer/id #uuid "b7c715e4-efc4-596f-91d8-a7126899a157" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos 1 + 4\\sin 1" :db/id #edb/ref 17592186270228} {:answer/id #uuid "a633e46d-7001-5ab8-bd93-7e826ced9f97" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos 1 + 2\\sin 1" :db/id #edb/ref 17592186270229} {:answer/id #uuid "ba4b5633-b2f0-581d-9f0a-8292fc8dc722" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos 1 + 2\\sin 1" :db/id #edb/ref 17592186270230} {:answer/id #uuid "a7ceb061-091f-501a-a788-b5260ccd82c9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270231}] :answer-field/correct {:answer/id #uuid "a7ceb061-091f-501a-a788-b5260ccd82c9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270231} :answer-field/id #uuid "bc1198c2-9aee-55af-b0ab-eace346709a9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274321}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cee486c2-ed27-5e12-b275-9a37215d5458" :question/math-academy-id "q-11603" :question/problem "If $y=3{x}^{2}{({x}^{3}-1)}^{4}$, find the value of $\\frac{\\text{d}y}{\\text{d}x}$ at $x=1.$" :question/worked-solution "This question requires the product rule. Let $u(x)=3{x}^{2}$ and $v(x)={({x}^{3}-1)}^{4}.$ Then\n\n$$\n{u}^{'}(x)=6x,\\,{v}^{'}(x)=12{x}^{2}{({x}^{3}-1)}^{3}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =(6x)(({x}^{3}-1)^{4})+(3{x}^{2})(12{x}^{2}({x}^{3}-1)^{3}) \\\\  & =6x({x}^{3}-1)^{4}+36{x}^{4}{({x}^{3}-1)}^{3} \\\\  & =(6x({x}^{3}-1)+36{x}^{4})\\,{({x}^{3}-1)}^{3} \\\\  & =(6{x}^{4}-6x+36{x}^{4})\\,{({x}^{3}-1)}^{3} \\\\  & =(42{x}^{4}-6x)\\,{({x}^{3}-1)}^{3}.\\end{aligned}\n$$\n\nTo evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at $x=1$, we substitute $x=1:$\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}y}{\\text{d}x})|}_{x=1} & =(42\\cdot {1}^{4}-6\\cdot 1){({1}^{3}-1)}^{3} \\\\  & =36\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257195 :knowledge-point/_questions [{:knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4781c7eb-c02d-538c-a92a-13c602dcca45" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{4\\pi }{3})" :db/id #edb/ref 17592186270272} {:answer/id #uuid "cab389df-181c-5c74-8204-3ee40f2b3f21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186270273} {:answer/id #uuid "68c84df7-1e0c-51c9-98b7-7503730d059c" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{4\\pi }{3})" :db/id #edb/ref 17592186270274} {:answer/id #uuid "627be6df-537e-5e60-be91-358e9781c574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{4\\pi }{3})" :db/id #edb/ref 17592186270275} {:answer/id #uuid "0f372b7a-16fb-53cb-9677-08199de7f282" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{4\\pi }{3})" :db/id #edb/ref 17592186270276}] :answer-field/correct {:answer/id #uuid "cab389df-181c-5c74-8204-3ee40f2b3f21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186270273} :answer-field/id #uuid "5e7f0670-3665-5683-b5b4-adcaee279be2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274330}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e4e51688-a8c1-51b7-9a2a-9013aa2e555b" :question/math-academy-id "q-117224" :question/problem "Which of the following values is **not** in the range of $y=\\operatorname{arccos}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nNote that:\n\n- The range of the function is $[0,\\pi ].$\n\nTherefore, the value $\\frac{4\\pi }{3}$ is not the range of the function."}] [{:db/id #edb/ref 17592186257198 :knowledge-point/_questions [{:knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ded3f952-61f0-5925-b863-e6ac4a7f0ea8" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257200} {:answer/id #uuid "e3e7a484-226e-585a-9c51-6c1fdb3b87b8" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257201} {:answer/id #uuid "6d4c73ce-b35e-58d9-a14f-bb9a593ff60c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257202} {:answer/id #uuid "44d360d7-afd6-5a05-b302-8665c4b431ef" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257203} {:answer/id #uuid "87ff9f03-9dce-54ed-8b24-c3705b8c5234" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257204} {:answer/id #uuid "28e0e9fb-1ae9-5291-bc57-3cc1aa0f925d" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257205} {:answer/id #uuid "17fbacbb-2c9d-5dfc-b8a3-7f5d9f890660" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257206} {:answer/id #uuid "f060392e-58ca-576a-b9ff-523b9bff84f8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257207}] :answer-field/correct {:answer/id #uuid "f060392e-58ca-576a-b9ff-523b9bff84f8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257207} :answer-field/id #uuid "521d14d3-bb5b-59f1-841d-5e4bfc9a8b8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257199}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fb4b0773-22d6-5ea4-882b-9ee12f384d27" :question/math-academy-id "q-117257" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}x?$\n\nI. - $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$\nII. - $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6})$\nIII. - $(\\pi ,-1)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{4},\\frac{\\sqrt{2}}{2})$ does **not** lie on the graph of $y=\\operatorname{cos}x.$ $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arccos}x.$\n\n- Next, we consider the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{6},-\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}x$ is $y\\in [0,\\pi ],$ and $y=\\frac{5\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6})$ lies on the graph of $y=\\operatorname{arccos}x.$\n\n- Finally, we consider the point $(\\pi ,-1).$ We note the following:\n\n- The point $(-1,\\pi )$ does **not** lie on the graph of $y=\\operatorname{cos}x.\\,\\times $\n\nTherefore, the point $(\\pi ,-1)$ does **not** lie on the graph of $y=\\operatorname{arccos}x.$"}] [{:db/id #edb/ref 17592186257231 :knowledge-point/_questions [{:knowledge-point/id #uuid "1587e39e-c7bf-5385-b726-a1b497f7c772" :knowledge-point/title "Identifying Values in the Range of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68806c14-eaa0-5b4e-b14a-4465f647b979" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(2)" :db/id #edb/ref 17592186270282} {:answer/id #uuid "6d234862-fb51-59eb-91fc-4cc61d19275d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270283} {:answer/id #uuid "a66748fa-2155-510c-b2dd-10119c8305ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186270284} {:answer/id #uuid "b1bcf94c-6794-541c-8766-5171c16bd824" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186270285} {:answer/id #uuid "38baa4df-a3fc-5e44-b87f-cfd90a674979" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186270286}] :answer-field/correct {:answer/id #uuid "a66748fa-2155-510c-b2dd-10119c8305ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186270284} :answer-field/id #uuid "481d24a5-55e7-5353-a01d-2aab33aef0c1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274332}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af21f9ad-d3fc-504f-8809-fa4c9ea3ace4" :question/math-academy-id "q-117339" :question/problem "Which of the following values is in the range of $y=\\operatorname{arctan}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The range of the function is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nTherefore, of the given values, only $y=\\frac{4}{9}$ is in the range of the function."}] [{:db/id #edb/ref 17592186257234 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d44d8b18-33a5-5a24-b9bd-673cc51f97b8" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257236} {:answer/id #uuid "58c68d78-b88a-515f-83c6-1c3d4bbca69c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257237} {:answer/id #uuid "f5724fe7-92ec-56ed-a3bc-f56af12e586e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257238} {:answer/id #uuid "99b79ba0-fff4-5683-abf9-c0c4c9a1e11b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257239} {:answer/id #uuid "4f137b7e-1902-5bdc-a1d0-dc1767719059" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257240} {:answer/id #uuid "2071b92f-10b1-5ac3-a15c-76aba9bb7fdf" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257241} {:answer/id #uuid "995ae627-9d8b-576a-bcee-28576e7ed6af" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257242} {:answer/id #uuid "63618dd2-0e11-5abc-82d7-1a61bb98c70c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257243}] :answer-field/correct {:answer/id #uuid "63618dd2-0e11-5abc-82d7-1a61bb98c70c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257243} :answer-field/id #uuid "a87b1ada-f070-5a16-8efc-b76311bcca9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257235}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e42e861e-a315-5ce3-9bfd-ad15ea97bc42" :question/math-academy-id "q-117373" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}x?$\n\nI. - $(1,\\frac{5\\pi }{4})$\nII. - $(-1,-\\frac{\\pi }{4})$\nIII. - $(0,\\pi )$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(1,\\frac{5\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{4},1)$ lies on the graph of $y=\\operatorname{tan}x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{5\\pi }{4}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(1,\\frac{5\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arctan}x.$\n\n- Next, we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ does lie on the graph of $y=\\operatorname{arctan}x.$\n\n- Finally, we consider the point $(0,\\pi ).$ We note the following:\n\n- The point $(\\pi ,0)$ lies on the graph of $y=\\operatorname{tan}x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\pi $ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(0,\\pi )$ does **not** lie on the graph of $y=\\operatorname{arctan}x.$"}] [{:db/id #edb/ref 17592186257294 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3235ef37-0ffb-5843-b119-69f7fbde2c58" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257296} {:answer/id #uuid "df5f3e74-890b-5156-ba8c-31602fb54a0f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257297} {:answer/id #uuid "258eb886-5afd-548a-957e-221d02dc85f3" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257298} {:answer/id #uuid "4e023746-ca48-5ec4-98d8-26a7b685ac4d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257299} {:answer/id #uuid "ee38a5c3-7fe8-556b-bb81-d972d9343ec4" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257300} {:answer/id #uuid "471dddbc-f346-5688-a28d-86d6ac2d38da" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257301} {:answer/id #uuid "5fd83e73-697a-5565-aede-9bf0a4362b1c" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257302} {:answer/id #uuid "d79bd66a-a044-5058-9373-524b6b028706" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257303}] :answer-field/correct {:answer/id #uuid "471dddbc-f346-5688-a28d-86d6ac2d38da" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257301} :answer-field/id #uuid "d629f59a-43b8-52d9-9357-8e959cb4368d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257295}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a3b6aeaa-a451-5b80-8bb6-433e2232b048" :question/math-academy-id "q-118863" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nI. - ${y}^{'}-8{e}^{y}=2$\nII. - $y{y}^{'}+3=\\operatorname{cos}y$\nIII. - $x{y}^{'}-8={e}^{y}$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{'}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is an autonomous differential equation. Writing the equation in the form ${y}^{'}=f(y),$ we get\n\n$$\n\\begin{aligned}{y}^{'}-8{e}^{y} & =2 \\\\ {y}^{'} & =8{e}^{y}+2 \\\\ {y}^{'} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=8{e}^{y}+2.$\n\n- Equation II is an autonomous differential equation. Writing the equation in the form ${y}^{'}=f(y),$ we get\n\n$$\n\\begin{aligned}y{y}^{'}+3 & =\\operatorname{cos}y \\\\ {y}^{'} & =\\frac{\\operatorname{cos}y-3}{y} \\\\ {y}^{'} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=\\frac{\\operatorname{cos}y-3}{y}.$\n\n- Equation III is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}x{y}^{'}-8 & ={e}^{y} \\\\ {y}^{'} & =\\frac{{e}^{y}+8}{x} \\\\ {y}^{'} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=\\frac{{e}^{y}+8}{x}.$ So, it is not possible to write the equation in the form ${y}^{'}=f(y).$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186257580 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfe5a9ca-d045-53ae-bc69-fff9dfbdc439" :knowledge-point/title "Finding a General Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e9333c5-a0c1-587b-a8b6-6be60246c404" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 11)/(2)" :db/id #edb/ref 17592186270637} {:answer/id #uuid "3e808f95-7140-5ee5-b17b-93eb69b14622" :answer/type {:db/ident :answer.type/math} :answer/value "(k(k + 5))/(2)" :db/id #edb/ref 17592186270638} {:answer/id #uuid "179ee929-60af-5082-9843-e270bd71a3d2" :answer/type {:db/ident :answer.type/math} :answer/value "(k(k + 1))/(2)" :db/id #edb/ref 17592186270639} {:answer/id #uuid "4160f2b8-1a25-5bfc-a501-d8cf2e0f5833" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 5)/(2)" :db/id #edb/ref 17592186270640} {:answer/id #uuid "3e51d2bb-bc27-59f7-b43d-55a330e9cb75" :answer/type {:db/ident :answer.type/math} :answer/value "-k(1+k)" :db/id #edb/ref 17592186270641}] :answer-field/correct {:answer/id #uuid "3e51d2bb-bc27-59f7-b43d-55a330e9cb75" :answer/type {:db/ident :answer.type/math} :answer/value "-k(1+k)" :db/id #edb/ref 17592186270641} :answer-field/id #uuid "34290001-3022-5cd3-a26d-7356e03bd7c0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274403}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1eaf8363-468f-5d8e-a0bf-40b4da507827" :question/math-academy-id "q-123946" :question/problem "Find the $k$th partial sum of the series\n${\\sum }_{n=1}^{\\infty }(-2n).$" :question/worked-solution "Let ${a}_{n}=-2n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =-2(1)=-2 \\\\ {a}_{2} & =-2(2)=-4 \\\\ {a}_{3} & =-2(3)=-6,\\end{aligned}\n$$\n\nand we see that this is an arithmetic sequence with common difference $d=-2$ and ${a}_{1}=-2.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{k}=-2k$ we get\n\n$$\n\\begin{aligned}{s}_{k} & =\\frac{k}{2}(-2+(-2k)) \\\\  & =-\\frac{k(2+2k)}{2} \\\\  & =-k(1+k).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257583 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfe5a9ca-d045-53ae-bc69-fff9dfbdc439" :knowledge-point/title "Finding a General Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e34230cc-12d6-5745-bdc4-69193a737ae4" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 11)/(2)" :db/id #edb/ref 17592186270642} {:answer/id #uuid "54c66bef-c8fd-5ca1-b7ce-86ea4d4b8c60" :answer/type {:db/ident :answer.type/math} :answer/value "(k(k + 5))/(2)" :db/id #edb/ref 17592186270643} {:answer/id #uuid "2f677981-5f3d-5393-aad1-120d22db68b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k(1-3k)}{2}" :db/id #edb/ref 17592186270644} {:answer/id #uuid "c90d8977-ac23-56a7-affb-7c9f939e6249" :answer/type {:db/ident :answer.type/math} :answer/value "(k(k + 1))/(2)" :db/id #edb/ref 17592186270645} {:answer/id #uuid "0da44a1c-18de-50f7-9e02-5a35b4cd53c3" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 5)/(2)" :db/id #edb/ref 17592186270646}] :answer-field/correct {:answer/id #uuid "2f677981-5f3d-5393-aad1-120d22db68b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k(1-3k)}{2}" :db/id #edb/ref 17592186270644} :answer-field/id #uuid "4113df8b-775e-5be8-ada1-b5eaee3fbcc2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274404}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "88a08d4f-2fec-5f88-b2ca-6305b4e3802f" :question/math-academy-id "q-123947" :question/problem "Find the $k$th partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2-3n).$" :question/worked-solution "Let ${a}_{n}=2-3n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2-3(1)=-1 \\\\ {a}_{2} & =2-3(2)=-4 \\\\ {a}_{3} & =2-3(3)=-7,\\end{aligned}\n$$\n\nand we see that this is an arithmetic sequence with common difference $d=-3$ and ${a}_{1}=-1.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{k}=2-3k$ we get\n\n$$\n\\begin{aligned}{s}_{k} & =\\frac{k}{2}(-1+(2-3k)) \\\\  & =\\frac{k}{2}(1-3k) \\\\  & =\\frac{k(1-3k)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257586 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d6bb40d-91af-55ae-ab0c-fbf5b6d0f0e1" :knowledge-point/title "Finding a Partial Sum of an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6c5b7f6-0c97-52bc-bbf7-858a463575cd" :answer/type {:db/ident :answer.type/math} :answer/value "(63)/(64)" :db/id #edb/ref 17592186270647} {:answer/id #uuid "cc7c8cdf-e801-587b-8a79-c1290e2dc1f6" :answer/type {:db/ident :answer.type/math} :answer/value "(31)/(32)" :db/id #edb/ref 17592186270648} {:answer/id #uuid "1f7d9014-7768-5b86-aeb9-a9f450beedbe" :answer/type {:db/ident :answer.type/math} :answer/value "(255)/(256)" :db/id #edb/ref 17592186270649} {:answer/id #uuid "cc2ebeca-2b58-5e7e-bdb3-d374eec96b92" :answer/type {:db/ident :answer.type/math} :answer/value "(15)/(16)" :db/id #edb/ref 17592186270650} {:answer/id #uuid "504e190b-97e5-5ef1-85b9-efeffdbf6177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{111}{64}" :db/id #edb/ref 17592186270651}] :answer-field/correct {:answer/id #uuid "504e190b-97e5-5ef1-85b9-efeffdbf6177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{111}{64}" :db/id #edb/ref 17592186270651} :answer-field/id #uuid "58379606-7543-5afe-9a51-14f144986f1a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274405}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "08572949-7072-5fd4-8efb-71e1ae8b0ef7" :question/math-academy-id "q-123953" :question/problem "Determine the third partial sum of the series\n${\\sum }_{n=1}^{\\infty }{(\\frac{3}{4})}^{n}.$" :question/worked-solution "Let ${a}_{n}={(\\frac{3}{4})}^{n}.$ We note that this is a geometric sequence with $r=\\frac{3}{4}$ and first term given by\n\n$$\n{a}_{1}={(\\frac{3}{4})}^{1}=\\frac{3}{4}.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3}={\\sum }_{n=1}^{3}{a}_{n} & ={a}_{1}\\cdot \\frac{(1-{r}^{3})}{1-r} \\\\  & =\\frac{3}{4}\\cdot \\frac{(1-{[\\frac{3}{4}]}^{3})}{(1-\\frac{3}{4})} \\\\  & =\\frac{3}{4}\\cdot \\frac{(1-\\frac{27}{64})}{(\\frac{1}{4})} \\\\  & =3\\cdot \\cancel{\\frac{1}{4}}\\cdot \\frac{(\\frac{37}{64})}{(\\cancel{\\frac{1}{4}})} \\\\  & =\\frac{111}{64}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257608 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d98bcee-d473-53b1-a6ef-1943d68702c3" :knowledge-point/title "Scalar Multiplication of a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48574ca9-f18d-5232-8aa7-75f42fe338bc" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-1)" :db/id #edb/ref 17592186270657} {:answer/id #uuid "81042c24-fe30-5382-9a10-3e3ebc05725a" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186270658} {:answer/id #uuid "224ac8f5-85fb-5c7f-a910-64046d9575ad" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id #edb/ref 17592186270659} {:answer/id #uuid "1cdfcab0-f30a-5dcd-b864-f74781377323" :answer/type {:db/ident :answer.type/math} :answer/value "1-K\\ne 0\\,\\Rightarrow \\,K\\ne 1" :db/id #edb/ref 17592186270660} {:answer/id #uuid "7efddbd6-59c0-54e0-ad2e-bea81e67da94" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186270661}] :answer-field/correct {:answer/id #uuid "1cdfcab0-f30a-5dcd-b864-f74781377323" :answer/type {:db/ident :answer.type/math} :answer/value "1-K\\ne 0\\,\\Rightarrow \\,K\\ne 1" :db/id #edb/ref 17592186270660} :answer-field/id #uuid "4c525ba6-04cc-53d4-982c-a056b38e4155" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274407}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3facbd4e-9556-5051-9eb1-216d555a418e" :question/math-academy-id "q-124072" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, determine all real values of $K$ for which ${\\sum }_{n=1}^{\\infty }(1-K)\\cdot {a}_{n}$ is divergent." :question/worked-solution "If we multiply the terms of a divergent series by a non-zero constant, the resulting series is divergent.\n\nTherefore, the series\n\n$$\n{\\sum }_{n=1}^{\\infty }(1-K)\\cdot {a}_{n}\n$$\n\nis divergent when\n\n$$\n1-K\\ne 0\\,\\Rightarrow \\,K\\ne 1.\n$$"}] [{:db/id #edb/ref 17592186257621 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d138d2c-3295-5eae-990d-42711f5792f1" :knowledge-point/title "Analyzing Statements Involving Sums of Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93784fbc-83fc-552e-bca4-b879f0cba48b" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257623} {:answer/id #uuid "39dc14bc-8f7b-5dc0-8c25-db4ce0daa200" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257624} {:answer/id #uuid "e8f6245f-990b-5cb6-ac0d-2f2ad6dedd8c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257625} {:answer/id #uuid "58f239de-e4fd-55ef-a60a-235d023bd6dc" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257626} {:answer/id #uuid "513ed02a-8b72-53e8-ab93-d7cda8f774bc" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257627} {:answer/id #uuid "eb95d64c-4c75-5942-9e5f-6610b98a0140" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257628} {:answer/id #uuid "5f45a70f-c513-545e-9bae-0dea0270c330" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257629} {:answer/id #uuid "11df1ff9-b048-5c6b-afa7-e4921a4772e3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257630}] :answer-field/correct {:answer/id #uuid "58f239de-e4fd-55ef-a60a-235d023bd6dc" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257626} :answer-field/id #uuid "907ac348-0d31-53aa-a507-4f3224e0eb36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257622}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b0132ee2-97f1-5701-b78e-440561d08c8c" :question/math-academy-id "q-124086" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true?\n\nI. - $-{10}^{500}{\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent\nII. - ${\\sum }_{n=25}^{\\infty }{b}_{n}$ is divergent\nIII. - ${\\sum }_{n=1}^{\\infty }{b}_{n}-{10}^{500}{\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent" :question/worked-solution "Let's recall the properties of convergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}=K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is also convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Any constant multiple of a convergent series gives a convergent series.\n\n- Statement II is false. Removing a finite number of terms from a convergent series gives a convergent series.\n\n- Statement III is false. The sum of two convergent series is convergent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186257690 :knowledge-point/_questions [{:knowledge-point/id #uuid "aaba35a4-5f6b-578c-9fbb-90b041c19803" :knowledge-point/title "Evaluating an Infinite Geometric Series Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "475ceb4c-381c-5ba9-8e5f-e2289ec59ae6" :answer/type {:db/ident :answer.type/math} :answer/value "− (28)/(3)" :db/id #edb/ref 17592186270667} {:answer/id #uuid "3a1a8e65-2165-5853-9a14-fa2a43435ea5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270668} {:answer/id #uuid "4b9fcdc6-8124-554e-814f-5dfcbdce27e3" :answer/type {:db/ident :answer.type/math} :answer/value "− 15" :db/id #edb/ref 17592186270669} {:answer/id #uuid "2080f00a-11a2-56c0-b74d-b16c629c6754" :answer/type {:db/ident :answer.type/math} :answer/value "− (180)/(19)" :db/id #edb/ref 17592186270670} {:answer/id #uuid "61148063-3326-5f2f-b78a-1f08703e303f" :answer/type {:db/ident :answer.type/math} :answer/value "− (19)/(2)" :db/id #edb/ref 17592186270671}] :answer-field/correct {:answer/id #uuid "3a1a8e65-2165-5853-9a14-fa2a43435ea5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270668} :answer-field/id #uuid "5b58dbe6-7962-5e0a-a2ac-9292e38d497c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274409}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "36e7cb14-a9b2-529b-981c-2ef8caf295b9" :question/math-academy-id "q-124575" :question/problem "Given that ${a}_{1}=10$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-0.25$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$" :question/worked-solution "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=10.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-0.25.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{10}{1-(-0.25)} \\\\  & =\\frac{10}{1+0.25} \\\\  & =\\frac{10}{1.25} \\\\  & =\\frac{1\\,000}{125} \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257693 :knowledge-point/_questions [{:knowledge-point/id #uuid "aaba35a4-5f6b-578c-9fbb-90b041c19803" :knowledge-point/title "Evaluating an Infinite Geometric Series Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd70ddd5-338e-57b2-8bc0-0056c41333f4" :answer/type {:db/ident :answer.type/math} :answer/value "− (28)/(3)" :db/id #edb/ref 17592186270672} {:answer/id #uuid "1fc7273c-4216-5c10-b5dd-ea9a5d0f8577" :answer/type {:db/ident :answer.type/math} :answer/value "− 15" :db/id #edb/ref 17592186270673} {:answer/id #uuid "1aaea0f7-2b64-5672-b864-1fd40bc2f465" :answer/type {:db/ident :answer.type/math} :answer/value "− (180)/(19)" :db/id #edb/ref 17592186270674} {:answer/id #uuid "2685e5ae-90e9-55a8-9c95-89f40b6747c9" :answer/type {:db/ident :answer.type/math} :answer/value "− (19)/(2)" :db/id #edb/ref 17592186270675} {:answer/id #uuid "84f58534-f7ee-51d1-90e5-a05172640e9f" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186270676}] :answer-field/correct {:answer/id #uuid "84f58534-f7ee-51d1-90e5-a05172640e9f" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186270676} :answer-field/id #uuid "fec86bba-b635-5169-b17d-8d9e9d492450" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274410}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d5e58701-9bd7-5e77-97f9-f02a87ad3341" :question/math-academy-id "q-124577" :question/problem "Given that ${a}_{1}=-14$ and $\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{3}$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$" :question/worked-solution "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-14.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-14}{(1-\\frac{1}{3})} \\\\  & =-\\frac{14}{(\\frac{2}{3})} \\\\  & =-14\\cdot \\frac{3}{2} \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257699 :knowledge-point/_questions [{:knowledge-point/id #uuid "5191b207-da9d-5408-8efd-3c616ffd3211" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0649ca8f-ed83-5198-b4ef-0f61e3b3f583" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(14)" :db/id #edb/ref 17592186270682} {:answer/id #uuid "a3d4a48c-aebf-5715-b878-473276bb4a33" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186270683} {:answer/id #uuid "880c5c58-c358-5bca-a8b3-a37b12f408f3" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(20)" :db/id #edb/ref 17592186270684} {:answer/id #uuid "b5784e14-897a-555a-8b49-84c2000bef27" :answer/type {:db/ident :answer.type/math} :answer/value "(6)/(29)" :db/id #edb/ref 17592186270685} {:answer/id #uuid "70c6c929-9fbb-5760-8ae5-1ce1bd4704ba" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(7)" :db/id #edb/ref 17592186270686}] :answer-field/correct {:answer/id #uuid "a3d4a48c-aebf-5715-b878-473276bb4a33" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186270683} :answer-field/id #uuid "f62e6d93-23d4-5e2e-a481-001b714cf79a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274412}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "00c8c66f-75df-508a-b3d1-06c349afffda" :question/math-academy-id "q-124582" :question/problem "${\\sum }_{n=1}^{\\infty }15{(\\frac{2}{3})}^{n}=$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=15{(\\frac{2}{3})}^{1}=10.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15{(\\frac{2}{3})}^{2}}{15{(\\frac{2}{3})}^{1}}=\\frac{2}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }15{(\\frac{2}{3})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{10}{(1-\\frac{2}{3})} \\\\  & =\\frac{10}{(\\frac{1}{3})} \\\\  & =10\\cdot 3 \\\\  & =30.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257705 :knowledge-point/_questions [{:knowledge-point/id #uuid "b98c8710-49f8-550f-aad3-7b78220bd08f" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab499f16-e262-57d1-a046-bef7e0044ee4" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186270692} {:answer/id #uuid "1b278f27-daec-5763-9292-b529e112ce9e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270693} {:answer/id #uuid "bcc0e25b-d723-556c-a55e-6676e66f7bd7" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186270694} {:answer/id #uuid "281425b3-8330-5954-87f0-0bda621c148c" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186270695} {:answer/id #uuid "e0c140ad-89ad-582a-8edd-3dc9a7541f87" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186270696}] :answer-field/correct {:answer/id #uuid "1b278f27-daec-5763-9292-b529e112ce9e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270693} :answer-field/id #uuid "8e2dba81-92b7-5842-8e36-9972fe418edf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274414}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d9ee369-331b-5825-8ec6-ff1d89ebe2f6" :question/math-academy-id "q-124586" :question/problem "${\\sum }_{n=4}^{\\infty }16{(\\frac{1}{2})}^{n}=$" :question/worked-solution "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & =16{(\\frac{1}{2})}^{4}=16(\\frac{1}{16})=1 \\\\ {a}_{5} & =16{(\\frac{1}{2})}^{5}=16(\\frac{1}{32})=\\frac{1}{2}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{(\\frac{1}{2})}{1}=\\frac{1}{2}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }16{(\\frac{1}{2})}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{1}{(1-\\frac{1}{2})} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =1\\cdot \\frac{2}{1} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257738 :knowledge-point/_questions [{:knowledge-point/id #uuid "530b0b21-6349-5ce4-acd2-d20f4c6d7b3e" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Non-Standard Form Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2363110-75f5-528e-8e0b-2e7fd43aadb1" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(5)" :db/id #edb/ref 17592186270727} {:answer/id #uuid "e284f419-5b7a-5ac1-b609-546d0b399ad8" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(3)" :db/id #edb/ref 17592186270728} {:answer/id #uuid "d6f2169b-5a4c-50e2-b00a-8b05779f17a2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270729} {:answer/id #uuid "1440c397-ccbc-5241-bd0c-a5a3fac446ee" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186270730} {:answer/id #uuid "714f621a-d946-58d7-bc6a-da86f8ad3c74" :answer/type {:db/ident :answer.type/math} :answer/value "− 3" :db/id #edb/ref 17592186270731}] :answer-field/correct {:answer/id #uuid "d6f2169b-5a4c-50e2-b00a-8b05779f17a2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270729} :answer-field/id #uuid "d8f26736-cfd5-5955-98dc-421f60274c9a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274421}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a1070fac-dc84-5279-ab3e-7a24f1bc3b90" :question/math-academy-id "q-124893" :question/problem "Evaluate the geometric series ${\\sum }_{n=4}^{\\infty }(0.75)^{n-3}.$" :question/worked-solution "First, note that the index $n$ starts from $4,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{4}=(0.75)^{4-3}=0.75\n$$\n\n \n\n$$\n{a}_{5}=(0.75)^{5-3}={0.75}^{2}\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{{0.75}^{2}}{0.75}=0.75.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }(0.75)^{n-3} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{0.75}{1-0.75} \\\\  & =\\frac{0.75}{0.25} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257763 :knowledge-point/_questions [{:knowledge-point/id #uuid "ead28b84-1f92-510d-87b3-07eb9a394622" :knowledge-point/title "Determining Whether a p-Series with Integer Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9692f1f4-374c-5e3b-be3b-965eeb6bdcb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186270762} {:answer/id #uuid "cb2004ff-1af2-5f9b-94a2-aaaeefa08755" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{5}{2})" :db/id #edb/ref 17592186270763} {:answer/id #uuid "7b79c875-72f8-588f-8fbd-4a6224e380b8" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{5}{2})" :db/id #edb/ref 17592186270764} {:answer/id #uuid "f054fed8-f5d2-5ad2-ad10-d95f7c6772d8" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{5}{2})" :db/id #edb/ref 17592186270765} {:answer/id #uuid "c0b5a03b-962d-5dca-8dc7-55cf4ace4920" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{5}{2})" :db/id #edb/ref 17592186270766}] :answer-field/correct {:answer/id #uuid "9692f1f4-374c-5e3b-be3b-965eeb6bdcb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186270762} :answer-field/id #uuid "c82e38e9-f615-5efb-8a8d-557c9920c1d6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4212a544-54a4-5b52-9acc-dd7e93b7e947" :question/math-academy-id "q-125247" :question/problem "Use the $p$-test to determine whether the series below converges or diverges.\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{5}{2{n}^{3}}\n$$" :question/worked-solution "The series can be written as\n\n$$\n\\frac{5}{2}{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}}.\n$$\n\nThis is a $p$-series with $p=3.$ Since $p>1,$ the series is convergent.\n\nNote that the factor of $\\frac{5}{2}$ multiplying the series has no effect on the convergence/divergence of the series."}] [{:db/id #edb/ref 17592186257766 :knowledge-point/_questions [{:knowledge-point/id #uuid "f6051f35-c390-57ba-8448-40f53f11c1c1" :knowledge-point/title "Determining Which Series Converge From a List"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3912c428-8308-54b9-90a5-343e36b58e8d" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257768} {:answer/id #uuid "a229ba77-fdb2-518d-85ef-4ca70a20e0c2" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257769} {:answer/id #uuid "9c355002-1b19-50ea-85dc-9abb1f0d9285" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257770} {:answer/id #uuid "3018a463-e4d9-528d-ba7f-3117f1126da6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257771} {:answer/id #uuid "0d42ce8b-b675-535e-a014-9de87dc59b8f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257772} {:answer/id #uuid "3dd98ab1-5c6a-574c-a40b-91694bdb0f1e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257773} {:answer/id #uuid "1ed076b8-4cfc-5d46-88a3-654a35b95d60" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257774} {:answer/id #uuid "a547bd5d-34b0-54f5-bf2e-6957451f460e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257775}] :answer-field/correct {:answer/id #uuid "3dd98ab1-5c6a-574c-a40b-91694bdb0f1e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257773} :answer-field/id #uuid "d57bfeb9-ff6f-5f21-8379-8a644a1e8993" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257767}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "79f1c9d5-2149-5539-a2fe-8aa88505e603" :question/math-academy-id "q-125257" :question/problem "Which of the following series are convergent?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{2}{n\\sqrt[3]{{n}^{2}}}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{3{n}^{4}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{5\\sqrt[3]{n}}{\\sqrt{n}}$" :question/worked-solution "We analyze each series in turn.\n\n- First, we look at ${\\sum }_{n=1}^{\\infty }\\frac{2}{n\\sqrt[3]{{n}^{2}}}.$ Rewriting this series gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{2}{n\\sqrt[3]{{n}^{2}}} & =2{\\sum }_{n=1}^{\\infty }\\frac{1}{n\\cdot {n}^{2/3}} \\\\  & =2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/3}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{5}{3}.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the second series, we have\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{3{n}^{4}}=\\frac{1}{3}\\cdot {\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{4}}\n$$\n\n \nwhich is a $p$-series with $p=4.$ Since $p>1,$ the series is convergent.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{5\\sqrt[3]{n}}{\\sqrt{n}} & =5{\\sum }_{n=1}^{\\infty }\\frac{{n}^{1/3}}{{n}^{1/2}} \\\\  & =5{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1/6}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{1}{6}.$ Since $p\\le 1,$ the series diverges by the $p$-series test.\n\nHence, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186257776 :knowledge-point/_questions [{:knowledge-point/id #uuid "f6051f35-c390-57ba-8448-40f53f11c1c1" :knowledge-point/title "Determining Which Series Converge From a List"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7557e630-127d-5696-8ab5-f9e3f6fbb3db" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257778} {:answer/id #uuid "713545a3-ea7f-5282-88c9-39d02b45d63b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257779} {:answer/id #uuid "e07ef159-94a5-5f67-ad2d-7ba9fa030ddb" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257780} {:answer/id #uuid "cbcfc2fe-609c-58e1-9d4b-c1988e64214d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257781} {:answer/id #uuid "f26d8e21-045f-5648-a5d4-d094704688fd" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257782} {:answer/id #uuid "0d774096-d79a-51b4-acd0-450f7b2e87cb" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257783} {:answer/id #uuid "e2f42e84-8872-5e2f-bf07-cd1bc26b38c7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257784} {:answer/id #uuid "520a6840-1d65-591b-a8ce-50874a28abf1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257785}] :answer-field/correct {:answer/id #uuid "520a6840-1d65-591b-a8ce-50874a28abf1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257785} :answer-field/id #uuid "6458c492-81ff-5d30-91f6-062ce4df0fc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257777}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71e47f74-abbf-5c16-a637-21fb96159208" :question/math-academy-id "q-125396" :question/problem "Which of the following series are convergent?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{3n}{\\sqrt[4]{{n}^{5}}}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{5}{4{n}^{3}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{n}}{\\sqrt[5]{{n}^{3}}}$" :question/worked-solution "We analyze each series in turn.\n\n- First, we look at ${\\sum }_{n=1}^{\\infty }\\frac{3n}{\\sqrt[4]{{n}^{5}}}.$ Rewriting this series gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{3n}{\\sqrt[4]{{n}^{5}}} & =3{\\sum }_{n=1}^{\\infty }\\frac{n}{{n}^{5/4}} \\\\  & =3{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1/4}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{1}{4}.$ Since $p\\le 1,$ the series diverges by the $p$-series test.\n\n- For the second series, we have\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{5}{4{n}^{3}}=\\frac{5}{4}\\cdot {\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}}\n$$\n\n \nand this is a $p$-series with $p=3.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{n}}{\\sqrt[5]{{n}^{3}}} & ={\\sum }_{n=1}^{\\infty }\\frac{{n}^{1/2}}{{n}^{3/5}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1/10}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{1}{10}.$ Since $p\\le 1,$ the series divergess by the $p$-series test.\n\nHence, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186257786 :knowledge-point/_questions [{:knowledge-point/id #uuid "f6051f35-c390-57ba-8448-40f53f11c1c1" :knowledge-point/title "Determining Which Series Converge From a List"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7819d449-01e9-5b16-a26a-433627b519ca" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257788} {:answer/id #uuid "9d253ade-e26c-5024-98c2-c679cd173dd6" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257789} {:answer/id #uuid "2918cd0c-06c0-5882-9896-90f1887dbc68" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257790} {:answer/id #uuid "e4953611-76ff-5149-b100-68d565619ece" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257791} {:answer/id #uuid "13ba2729-bc00-58be-9786-4da25b30bf6c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257792} {:answer/id #uuid "453f20c4-494d-50fe-8398-c5c545279843" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257793} {:answer/id #uuid "59f9339a-fb24-56d6-816d-d28aa94c5e16" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257794} {:answer/id #uuid "dc2ee59a-25b0-56bb-adc8-e30a6848104a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257795}] :answer-field/correct {:answer/id #uuid "453f20c4-494d-50fe-8398-c5c545279843" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257793} :answer-field/id #uuid "334686ca-1c54-5ac9-b7f3-b0b671401645" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257787}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e8a9197c-7c16-580e-b5da-6dee677da60d" :question/math-academy-id "q-125397" :question/problem "Which of the following series are convergent?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{3}}{{n}^{5}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{n\\sqrt[3]{n}}{\\sqrt[4]{{n}^{7}}}$" :question/worked-solution "We analyze each series in turn.\n\n- First, we look at ${\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}}.$ Rewriting this series gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}} & =4{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=2.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the second series, we have\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{\\sqrt{3}}{{n}^{5}}=\\sqrt{3}\\cdot {\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5}}\n$$\n\n \nwhich is a $p$-series with $p=5.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{n\\sqrt[3]{n}}{\\sqrt[4]{{n}^{7}}} & ={\\sum }_{n=1}^{\\infty }\\frac{n\\cdot {n}^{1/3}}{{n}^{7/4}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/12}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{5}{12}.$ Since $p\\le 1,$ the series is divergent.\n\nHence, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186257796 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4dff2ea-a90b-5618-82fc-647a40be0c46" :knowledge-point/title "Convergence Parameters for p-Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e8ce2d-11d2-5f30-8fd1-69370f9e5298" :answer/type {:db/ident :answer.type/math} :answer/value "q > 1" :db/id #edb/ref 17592186270767} {:answer/id #uuid "60cde306-0301-5c18-9470-59ed82a5363d" :answer/type {:db/ident :answer.type/math} :answer/value "q < 1" :db/id #edb/ref 17592186270768} {:answer/id #uuid "16ddf59b-9890-5b2e-9ce8-d980dd17e24b" :answer/type {:db/ident :answer.type/math} :answer/value "q < (1)/(2)" :db/id #edb/ref 17592186270769} {:answer/id #uuid "528d3971-61d4-5a4d-88e8-ad8490e7d35c" :answer/type {:db/ident :answer.type/math} :answer/value "q>3" :db/id #edb/ref 17592186270770} {:answer/id #uuid "3a7e6b85-be6c-5083-8562-d67e3732f4c7" :answer/type {:db/ident :answer.type/math} :answer/value "q < 0" :db/id #edb/ref 17592186270771}] :answer-field/correct {:answer/id #uuid "528d3971-61d4-5a4d-88e8-ad8490e7d35c" :answer/type {:db/ident :answer.type/math} :answer/value "q>3" :db/id #edb/ref 17592186270770} :answer-field/id #uuid "608910da-5e60-51fe-837c-054afce7db1b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274429}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86ca18b4-98eb-5ab0-9943-316111c50313" :question/math-academy-id "q-125403" :question/problem "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{q-2}}$ converge?" :question/worked-solution "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=q-2.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\nq-2>1\\,⟹\\,q>3.\n$$\n\nTherefore, the series is convergent for all $q>3.$"}] [{:db/id #edb/ref 17592186258038 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99f6b7cc-d38b-55d9-aec0-34f292b8455b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)" :db/id #edb/ref 17592186270877} {:answer/id #uuid "0b545572-1b8f-52bc-88de-5f3ddcf91c0a" :answer/type {:db/ident :answer.type/math} :answer/value "2(2)" :db/id #edb/ref 17592186270878} {:answer/id #uuid "c166e8ab-e10d-5234-b733-f9d57469429d" :answer/type {:db/ident :answer.type/math} :answer/value "3(2)" :db/id #edb/ref 17592186270879} {:answer/id #uuid "d0ec44ac-e421-5c9c-a45c-bbf9bf23ecd6" :answer/type {:db/ident :answer.type/math} :answer/value "-(2)" :db/id #edb/ref 17592186270880} {:answer/id #uuid "5fa31ef0-8b47-55ce-95b1-42e8ae425753" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270881}] :answer-field/correct {:answer/id #uuid "5fa31ef0-8b47-55ce-95b1-42e8ae425753" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270881} :answer-field/id #uuid "ad3b87aa-5d75-5c7e-9f85-42540fbd7e94" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274451}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f2feeaf1-eaac-5dbf-95f2-bd5007588656" :question/math-academy-id "q-13607" :question/problem "Determine whether the series\n${\\sum }_{n=1}^{\\infty }\\frac{2}{n\\sqrt{n}}$\nconverges or diverges." :question/worked-solution "The series can be written as\n\n$$\n2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1+1/2}}=2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3/2}},\n$$\n\nwhich is a $p$-series with $p=\\frac{3}{2}.$ Since $p>1$, the series is convergent. \n\nNote that the factor of $2$ multiplying the series has no effect on the convergence/divergence of the series."}] [{:db/id #edb/ref 17592186258120 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc59590f-a1a5-5494-a68e-0d2f76d12ebb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)" :db/id #edb/ref 17592186270987} {:answer/id #uuid "c838dabe-4b19-5010-b593-3ba62e648695" :answer/type {:db/ident :answer.type/math} :answer/value "2(2)" :db/id #edb/ref 17592186270988} {:answer/id #uuid "57e5676a-3e38-5e67-9a62-4feeaadbdf75" :answer/type {:db/ident :answer.type/math} :answer/value "3(2)" :db/id #edb/ref 17592186270989} {:answer/id #uuid "70709f1b-f5ad-5353-95ed-3833ff687525" :answer/type {:db/ident :answer.type/math} :answer/value "-(2)" :db/id #edb/ref 17592186270990} {:answer/id #uuid "635db397-7d38-500e-8026-1d6a25319064" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270991}] :answer-field/correct {:answer/id #uuid "635db397-7d38-500e-8026-1d6a25319064" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270991} :answer-field/id #uuid "1e98b52d-2f38-500c-8ab6-d6431a0f2f37" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274473}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a6a632e6-465f-5f69-9c0a-6eab5a5d00ca" :question/math-academy-id "q-14177" :question/problem "Determine whether the series\n${\\sum }_{n=1}^{\\infty }\\frac{2}{{n}^{2}\\sqrt{n}}$\nconverges or diverges." :question/worked-solution "The series can be written as\n\n$$\n2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2+1/2}}=2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/2}},\n$$\n\nwhich is a $p$-series with $p=\\frac{5}{2}.$ Since $p>1$, the series is convergent. \n\nNote that the factor of $2$ multiplying the series has no effect on the convergence/divergence of the series."}] [{:db/id #edb/ref 17592186258126 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "402af51f-a726-5f01-b342-7077d989db64" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186270997} {:answer/id #uuid "bdc1b30a-b48a-5a3d-8720-e73f62740825" :answer/type {:db/ident :answer.type/math} :answer/value "2(9)" :db/id #edb/ref 17592186270998} {:answer/id #uuid "4459f43b-1995-586a-aa4f-7970741da04f" :answer/type {:db/ident :answer.type/math} :answer/value "3(9)" :db/id #edb/ref 17592186270999} {:answer/id #uuid "f4daa9fa-99f7-5411-9ef8-dab34318ebfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(9)" :db/id #edb/ref 17592186271000} {:answer/id #uuid "12e40c63-22c0-5589-a660-29f379fdfbdf" :answer/type {:db/ident :answer.type/math} :answer/value "-(9)" :db/id #edb/ref 17592186271001}] :answer-field/correct {:answer/id #uuid "402af51f-a726-5f01-b342-7077d989db64" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186270997} :answer-field/id #uuid "997014b9-1d13-5827-a435-f454a076ff98" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274475}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "406bddc0-a5c1-5c9c-a58e-9ea56b088d28" :question/math-academy-id "q-14183" :question/problem "Determine whether the series\n${\\sum }_{n=1}^{\\infty }\\frac{9}{\\sqrt[7]{{n}^{6}}}$\nconverges or diverges." :question/worked-solution "The series can be written as\n\n$$\n9{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{6/7}},\n$$\n\nwhich is a $p$-series with $p=\\frac{6}{7}.$ Since $p\\le 1$, the series is divergent. \n\nNote that the factor of $9$ multiplying the series has no effect on the convergence/divergence \nof the series."}] [{:db/id #edb/ref 17592186258129 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d677b-2e7d-5a12-afff-79a777a6a32d" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186271002} {:answer/id #uuid "2e7f3a56-0a84-5569-b5c0-33228a5ac285" :answer/type {:db/ident :answer.type/math} :answer/value "2(9)" :db/id #edb/ref 17592186271003} {:answer/id #uuid "0