e0d4-db53-5431-8767-32af44ffaf02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186272702} {:answer/id #uuid "761c017d-79dc-575c-9846-bee2cae1743c" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{\\pi }{2})" :db/id #edb/ref 17592186272703}] :answer-field/correct {:answer/id #uuid "573ce0d4-db53-5431-8767-32af44ffaf02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186272702} :answer-field/id #uuid "e1f6ce77-2ff0-5982-9c1a-49d1e923347d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274823}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1b5a8d34-c652-5bb0-9d30-a93288635736" :question/math-academy-id "q-65944" :question/problem "Which of the following gives the $y$-intercept of the function $y=\\operatorname{arccos}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nFrom the graph, we see that the intersection with the $y$-axis occurs at $y=\\frac{\\pi }{2}.$"}] [{:db/id #edb/ref 17592186260984 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c6b30e7-fba6-597c-8306-27d707bfc244" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting One Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e19debf7-bf12-5147-815a-6adc004fbafc" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/(4)" :db/id #edb/ref 17592186272828} {:answer/id #uuid "45efdf29-def3-5319-a372-b4e7d7cadeb9" :answer/type {:db/ident :answer.type/math} :answer/value "− 5" :db/id #edb/ref 17592186272829} {:answer/id #uuid "7de7e7fe-0cee-54b8-8eac-54ee54c8b15a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272830} {:answer/id #uuid "ed08c546-17e7-5e1f-8a53-2451303f4c5f" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186272831} {:answer/id #uuid "f5485fbd-fef7-543f-97ad-b04c73835dac" :answer/type {:db/ident :answer.type/math} :answer/value "− (2)/(5)" :db/id #edb/ref 17592186272832}] :answer-field/correct {:answer/id #uuid "7de7e7fe-0cee-54b8-8eac-54ee54c8b15a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272830} :answer-field/id #uuid "080f0918-0174-52bb-a6b9-b9e59253f458" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274849}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a0166c2e-fa1a-5455-a7a2-c570d25330ae" :question/math-academy-id "q-66864" :question/problem "Find the value of $x$ that satisfies the equation ${9}^{x-5}={3}^{x}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base.\n\nTo do this, we write $9$ as ${3}^{2},$ and then rewrite the left-hand side using the power rule of exponents:\n\n$$\n\\begin{aligned}{9}^{x-5} & ={3}^{x} \\\\ {({3}^{2})}^{x-5} & ={3}^{x} \\\\ {3}^{2(x-5)} & ={3}^{x}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $x:$\n\n$$\n\\begin{aligned}2(x-5) & =x \\\\ 2x-10 & =x \\\\ x & =10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261031 :knowledge-point/_questions [{:knowledge-point/id #uuid "530b0b21-6349-5ce4-acd2-d20f4c6d7b3e" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Non-Standard Form Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bbbf478-ef72-586c-b43d-ab0880d3c172" :answer/type {:db/ident :answer.type/math} :answer/value "− (8)/(5)" :db/id #edb/ref 17592186272883} {:answer/id #uuid "baa59009-a452-5b63-8edc-2d53ceed72be" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(3)" :db/id #edb/ref 17592186272884} {:answer/id #uuid "b850da7d-34fd-56d2-bf77-22e54bcc6e06" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272885} {:answer/id #uuid "762acd9c-a9c1-5fe0-ae6d-13f92cf4b243" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186272886} {:answer/id #uuid "adb3d6eb-02c9-5da6-ad6e-30c057729d54" :answer/type {:db/ident :answer.type/math} :answer/value "− 3" :db/id #edb/ref 17592186272887}] :answer-field/correct {:answer/id #uuid "b850da7d-34fd-56d2-bf77-22e54bcc6e06" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272885} :answer-field/id #uuid "ce2cbe35-6577-55e2-b5ff-2a20994fa60a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274860}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d7f6ddd3-7a07-53be-a65c-aca333beb0f5" :question/math-academy-id "q-67217" :question/problem "Evaluate the geometric series ${\\sum }_{n=0}^{\\infty }{(\\frac{3}{4})}^{n+1}.$" :question/worked-solution "First, note that the index $n$ starts from $0,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{0}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{0}={(\\frac{3}{4})}^{0+1}=\\frac{3}{4}\n$$\n\n \n\n$$\n{a}_{1}={(\\frac{3}{4})}^{1+1}={(\\frac{3}{4})}^{2}\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{1}}{{a}_{0}}=\\frac{{(\\frac{3}{4})}^{2}}{\\frac{3}{4}}=\\frac{3}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=0}^{\\infty }{(\\frac{3}{4})}^{n+1} & =\\frac{{a}_{0}}{1-r} \\\\  & =\\frac{(\\frac{3}{4})}{1-\\frac{3}{4}} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{1}{4})} \\\\  & =\\frac{3}{4}\\cdot \\frac{4}{1} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261037 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c06300-9cd0-5f2e-a152-80664f7a74bc" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186272893} {:answer/id #uuid "c90d0320-0ca8-58c4-8d1e-48b26202c8a7" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186272894} {:answer/id #uuid "28d03a30-26ae-5111-9b9b-89c683da24ff" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272895} {:answer/id #uuid "eb32003d-f211-5fdf-b888-04d222dbf632" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272896} {:answer/id #uuid "33e835fd-3ad6-51e6-baf6-2216dc07b114" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186272897}] :answer-field/correct {:answer/id #uuid "33e835fd-3ad6-51e6-baf6-2216dc07b114" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186272897} :answer-field/id #uuid "e89ba5b0-0ea6-576d-975c-31e0bba7ae1d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274862}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c4f183b-d69c-5863-8872-aaadbc068516" :question/math-academy-id "q-67277" :question/problem "Consider the infinite geometric sequence that has a first term equal to $36$ and a fourth term equal to $\\frac{4}{3}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=36$ and ${a}_{4}=\\frac{4}{3}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{4}{3})}{36} \\\\ {r}^{3} & =\\frac{1}{27} \\\\ {r}^{3} & ={(\\frac{1}{3})}^{3} \\\\ r & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{36}{(1-\\frac{1}{3})} \\\\  & =\\frac{36}{(\\frac{2}{3})} \\\\  & =54.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261043 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116f82b0-69a9-5721-93c6-0f2dd2412b45" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186272903} {:answer/id #uuid "192c3a13-54d0-5a37-8c33-2207052a5d3c" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186272904} {:answer/id #uuid "dbe67658-fa6f-5afd-9322-8d439edaa925" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272905} {:answer/id #uuid "0f93df41-daa8-580c-ab8c-6d5279fbe13b" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272906} {:answer/id #uuid "c07f629f-235a-5d24-bbc4-a0a246d93264" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186272907}] :answer-field/correct {:answer/id #uuid "c07f629f-235a-5d24-bbc4-a0a246d93264" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186272907} :answer-field/id #uuid "f7661e87-f23d-5338-9d88-bb91008e8443" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274864}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2b352d28-1238-5c21-917e-ac85575e41a6" :question/math-academy-id "q-67279" :question/problem "Consider the infinite geometric sequence that has a first term equal to $35$ and a fourth term equal to $-\\frac{56}{25}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=35$ and ${a}_{4}=-\\frac{56}{25}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(-\\frac{56}{25})}{35} \\\\ {r}^{3} & =-\\frac{8}{125} \\\\ {r}^{3} & ={(-\\frac{2}{5})}^{3} \\\\ r & =-\\frac{2}{5}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{35}{(1-(-\\frac{2}{5}))} \\\\  & =\\frac{35}{(1+\\frac{2}{5})} \\\\  & =\\frac{35}{(\\frac{7}{5})} \\\\  & =35\\cdot \\frac{5}{7} \\\\  & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261049 :knowledge-point/_questions [{:knowledge-point/id #uuid "b98c8710-49f8-550f-aad3-7b78220bd08f" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5b6fcfe-5e7a-5c78-aee4-f0ab300cc8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186272913} {:answer/id #uuid "e2bb01c2-c06e-58b9-a397-7e27a1988187" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(3)" :db/id #edb/ref 17592186272914} {:answer/id #uuid "0ba9fed5-c8e6-57f7-8618-85f997f7adf2" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186272915} {:answer/id #uuid "ef0b7f97-c2b3-5d6d-857e-1399c4a576fb" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186272916} {:answer/id #uuid "a2dfa6f4-ed24-5bb8-93ba-cebd804db6ea" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186272917}] :answer-field/correct {:answer/id #uuid "f5b6fcfe-5e7a-5c78-aee4-f0ab300cc8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186272913} :answer-field/id #uuid "f18b96df-5011-5e25-9517-9e70a7e9caf8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274866}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8da21356-cf78-57bd-8a24-bca56a7d11af" :question/math-academy-id "q-67304" :question/problem "Evaluate the series ${\\sum }_{n=2}^{\\infty }{(\\frac{2}{5})}^{n}.$" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & ={(\\frac{2}{5})}^{2}=\\frac{4}{25} \\\\ {a}_{3} & ={(\\frac{2}{5})}^{3}=\\frac{8}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{8}{125})}{(\\frac{4}{25})}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }{(\\frac{2}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{4}{25})}{(1-\\frac{2}{5})} \\\\  & =\\frac{(\\frac{4}{25})}{(\\frac{3}{5})} \\\\  & =\\frac{4}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261235 :knowledge-point/_questions [{:knowledge-point/id #uuid "039f58e5-0f98-58b1-b2f7-9f0ee33ed075" :knowledge-point/title "Identifying Values in the Domain of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdffed3b-4e1d-5f4c-8f03-ac3bd18b88b2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac57" :db/id #edb/ref 17592186273158} {:answer/id #uuid "f555f876-456c-5aa0-96d7-a7b463166ee7" :answer/type {:db/ident :answer.type/math} :answer/value "− 5" :db/id #edb/ref 17592186273159} {:answer/id #uuid "d92699a6-4e5a-5ff4-9c24-7609d5f0c7c5" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186273160} {:answer/id #uuid "0106b730-f9bc-5c2d-b442-f753f6bf0b61" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186273161} {:answer/id #uuid "eea1a351-6823-50b5-9174-28ff86a65687" :answer/type {:db/ident :answer.type/math} :answer/value "(6)/(5)" :db/id #edb/ref 17592186273162}] :answer-field/correct {:answer/id #uuid "fdffed3b-4e1d-5f4c-8f03-ac3bd18b88b2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac57" :db/id #edb/ref 17592186273158} :answer-field/id #uuid "50c9a010-4eb1-5a0e-932c-78f564324664" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274915}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e2c9898d-1220-5cf6-af81-cc3018702654" :question/math-academy-id "q-70744" :question/problem "Which of the following values is in the domain of $y=\\operatorname{arccos}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nNote that:\n\n- The domain of the function is $[-1,1].$\n\nTherefore, of the given values, only $x=-\\frac{5}{7}$ is in the domain of $y=\\operatorname{arccos}x.$"}] [{:db/id #edb/ref 17592186261238 :knowledge-point/_questions [{:knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c393bf6-5c08-53f5-8247-bc5d657d724e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261240} {:answer/id #uuid "f97fe431-d63a-5296-b665-7da88a48dc74" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261241} {:answer/id #uuid "6349aaee-6305-50a4-bf23-008a5f3a5f9f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261242} {:answer/id #uuid "aace6f9d-4998-5209-964b-da997a689e12" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261243} {:answer/id #uuid "0e62c000-c8ff-52d1-bb7b-5d30a29b8198" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261244} {:answer/id #uuid "ea9a4e02-1364-55d9-bb77-ff054bc06049" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261245} {:answer/id #uuid "3c7e8319-f3fc-5d41-a2ab-88b41047141f" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261246} {:answer/id #uuid "3256a62d-aeb1-5525-a581-299382c8cbdd" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261247}] :answer-field/correct {:answer/id #uuid "0e62c000-c8ff-52d1-bb7b-5d30a29b8198" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261244} :answer-field/id #uuid "45350a9c-7538-5f62-8547-71134014764d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261239}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c5869734-9305-599d-bf1a-57e700c7e1e6" :question/math-academy-id "q-70766" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}x?$\n\nI. - $(\\frac{\\pi }{4},\\frac{1}{2})$\nII. - $(\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$\nIII. - $(-\\frac{1}{2},\\frac{2\\pi }{3})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\pi }{4},\\frac{1}{2}).$ We note the following:\n\n- The point $(\\frac{1}{2},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{cos}x.$ $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},\\frac{1}{2})$ does **not** lie on the graph of $y=\\operatorname{arccos}x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}x$ is $y\\in [0,\\pi ],$ and $y=-\\frac{\\pi }{4}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arccos}x.$\n\n- Finally, we consider the point $(-\\frac{1}{2},\\frac{2\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{2\\pi }{3},-\\frac{1}{2})$ lies on the graph of $y=\\operatorname{cos}x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}x$ is $y\\in [0,\\pi ],$ and $y=\\frac{2\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{1}{2},\\frac{2\\pi }{3})$ lies on the graph of $y=\\operatorname{arccos}x.$"}] [{:db/id #edb/ref 17592186261248 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3df2432-d0b3-55da-bb5f-06253adf8bae" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261250} {:answer/id #uuid "7712557a-7be5-5f7f-9c67-4d99cd9aa572" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261251} {:answer/id #uuid "eedd3e10-4981-51c4-9dd9-db253d883611" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261252} {:answer/id #uuid "627a980f-c83e-5930-8f39-3e3aa302d02b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261253} {:answer/id #uuid "f930a2ff-2e31-57a7-94aa-f1776ffcdd83" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261254} {:answer/id #uuid "c29eba9f-8b94-583e-aa05-3b9512acc2ff" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261255} {:answer/id #uuid "0fea163c-b666-5d70-960e-245dd1e65817" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261256} {:answer/id #uuid "619e2a91-10dd-555f-9125-519e91fc7680" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261257}] :answer-field/correct {:answer/id #uuid "627a980f-c83e-5930-8f39-3e3aa302d02b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261253} :answer-field/id #uuid "d3cff461-a7c4-5449-83d4-576218bc4146" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261249}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b051727c-2d33-5ba7-828f-c75227488b69" :question/math-academy-id "q-70790" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}x?$\n\nI. - $(\\sqrt{3},\\frac{\\pi }{3})$\nII. - $(\\sqrt{3},\\frac{\\pi }{4})$\nIII. - $(\\sqrt{3},-\\frac{2\\pi }{3})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points.  \n\n- First,  we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\sqrt{3})$ does **not** lie on the graph of $y=\\operatorname{tan}x.$ $\\,\\times $\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arctan}x.$\n\n- Finally, we consider the point $(\\sqrt{3},-\\frac{2\\pi }{3}).$ We note the following:\n\n- The point $(-\\frac{2\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{2\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\sqrt{3},-\\frac{2\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}x.$"}] [{:db/id #edb/ref 17592186261377 :knowledge-point/_questions [{:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5203e05-1295-5b0d-b684-2f3546ef7a79" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x\\csc^{2} (\\cos x)" :db/id #edb/ref 17592186273307} {:answer/id #uuid "32219ce8-0007-56e5-bdd8-d727b731b218" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x\\cot^{2} (\\cos x)" :db/id #edb/ref 17592186273308} {:answer/id #uuid "e3b84d33-2917-5c5d-9156-072e82e7277e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x\\cos^{2} (\\csc x)" :db/id #edb/ref 17592186273309} {:answer/id #uuid "733bfbac-dc7b-5915-a73a-5bf73716597c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x\\csc(\\cos x)\\cot(\\cos x)" :db/id #edb/ref 17592186273310} {:answer/id #uuid "60b75b1d-694e-523a-94aa-34dab7b1623d" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc x\\sin^{2} (\\cos x)" :db/id #edb/ref 17592186273311}] :answer-field/correct {:answer/id #uuid "733bfbac-dc7b-5915-a73a-5bf73716597c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x\\csc(\\cos x)\\cot(\\cos x)" :db/id #edb/ref 17592186273310} :answer-field/id #uuid "e0ddd5eb-7e9d-52ee-8337-c6525598f944" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274945}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4550e1e-4735-5154-97f7-9b71d5ccbc18" :question/math-academy-id "q-72170" :question/problem "Find the derivative of $y =\\csc ( \\cos x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n\\[\ny = \\csc{u}, \\qquad u = \\cos{x}.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -\\csc{u}\\cot u,\\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = -\\sin{x}.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n\\dfrac{\\textrm d y}{\\textrm d x} &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&=-\\csc u \\cot u \\cdot  (-\\sin x)\\\\[5pt]\n\n&=\\sin x\\csc \\left(\\cos x\\right) \\cot \\left(\\cos x\\right).\n\\end{align*}"}] [{:db/id #edb/ref 17592186261461 :knowledge-point/_questions [{:knowledge-point/id #uuid "54834980-1e19-58eb-b15f-e46e2a1aeffe" :knowledge-point/title "Finding Unknown Parameters Given a Stretched Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a308e51-4cff-5bca-88b1-4b13dfb96602" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273362} {:answer/id #uuid "879293b5-c2c5-5d53-8e38-25ff75f2d222" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7" :db/id #edb/ref 17592186273363} {:answer/id #uuid "7049eff1-2451-5d85-97a4-18b702af7632" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186273364} {:answer/id #uuid "055a1a12-463a-50fa-b918-85c081a16f60" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273365} {:answer/id #uuid "fd9fa553-21aa-5087-a4f6-a067cc046f8b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273366}] :answer-field/correct {:answer/id #uuid "fd9fa553-21aa-5087-a4f6-a067cc046f8b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273366} :answer-field/id #uuid "1ba4320e-9af1-537e-9b3f-4e60232fd8aa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274956}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2395de7-c9eb-54cc-9c43-efe503db4a0b" :question/math-academy-id "q-7311" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/95d77b35c2647bc98480dbe24692c3af3c0fe004a4e91b272d10ad0a4c5ebaae.png)\n\nGiven the diagram above, what is the value of $k?$" :question/worked-solution "The graph of $y=k{log}_{4}x$ can be obtained from $y={log}_{4}x$ by a vertical stretch of scale factor $k.$ \n\nFrom the diagram, we deduce that under such a transformation, the point $(4,1)$ that lies on $y={log}_{4}x$ becomes\n\n$$\n(4,k\\cdot 1)=(4,4)\n$$\n\nwhich lies on $y=k{log}_{4}x.$ \n\nTherefore, $k=4.$"}] [{:db/id #edb/ref 17592186261552 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c" :knowledge-point/title "Finding a Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acd9ff4e-8cf7-5c2b-bae6-c0f5094fe86f" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186273486} {:answer/id #uuid "c7b2a6e8-5c30-57a6-9458-631a799891ff" :answer/type {:db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186273487} {:answer/id #uuid "a776d016-88c3-5575-a5d6-2f90889ce7e9" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186273488} {:answer/id #uuid "8356d7c1-9f3b-5910-ab48-31629f508d63" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186273489} {:answer/id #uuid "7e624120-c40d-5ff0-a54a-da44d06793f0" :answer/type {:db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186273490}] :answer-field/correct {:answer/id #uuid "acd9ff4e-8cf7-5c2b-bae6-c0f5094fe86f" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186273486} :answer-field/id #uuid "cc6205f8-179e-5a0b-a625-caa108a4c031" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274981}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "78423b17-d99e-5bed-be25-87a38ce33c64" :question/math-academy-id "q-74697" :question/problem "Find the eighth partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2n-4).$" :question/worked-solution "Let ${a}_{n}=2n-4.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2(1)-4=-2 \\\\ {a}_{2} & =2(2)-4=0 \\\\ {a}_{3} & =2(3)-4=2,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=2$ and first term ${a}_{1}=-2.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{8}=2(8)-4=12,$ we get\n\n$$\n{s}_{8}=\\frac{8}{2}(-2+12)=40.\n$$\n\nSo the eighth partial sum of ${\\sum }_{n=1}^{\\infty }(2n-4)$ is equal to $40.$"}] [{:db/id #edb/ref 17592186261555 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c" :knowledge-point/title "Finding a Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6459bd4-444b-5335-8d0e-adc52dc19ff7" :answer/type {:db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186273491} {:answer/id #uuid "457d3f66-327c-50e2-a41c-bdd89fb45e55" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186273492} {:answer/id #uuid "2c25e97f-8bd7-50a8-b0cd-a72cf1a236b1" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186273493} {:answer/id #uuid "21207ba5-4a9c-589f-a21d-0bd687ff5ced" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186273494} {:answer/id #uuid "7fb0fe99-0d3b-5f7d-a668-8b1888628879" :answer/type {:db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186273495}] :answer-field/correct {:answer/id #uuid "2c25e97f-8bd7-50a8-b0cd-a72cf1a236b1" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186273493} :answer-field/id #uuid "bbcaa4ed-1851-5410-a6e3-b3b7b02530e1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274982}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "73bb57e1-72df-5ec1-b6e1-ed439e307054" :question/math-academy-id "q-74698" :question/problem "Find the sixth partial sum of the series\n${\\sum }_{n=1}^{\\infty }(6n-1).$" :question/worked-solution "Let ${a}_{n}=6n-1.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =6(1)-1=5 \\\\ {a}_{2} & =6(2)-1=11 \\\\ {a}_{3} & =6(3)-1=17,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=6$ and first term ${a}_{1}=5.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{6}=6(6)-1=35,$ we get\n\n$$\n{s}_{6}=\\frac{6}{2}(5+35)=120.\n$$\n\nSo the sixth partial sum of ${\\sum }_{n=1}^{\\infty }(6n-1)$ is equal to $120.$"}] [{:db/id #edb/ref 17592186261558 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d6bb40d-91af-55ae-ab0c-fbf5b6d0f0e1" :knowledge-point/title "Finding a Partial Sum of an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863ffab4-271f-50af-936e-f28d95736d92" :answer/type {:db/ident :answer.type/math} :answer/value "(63)/(64)" :db/id #edb/ref 17592186273496} {:answer/id #uuid "977e6956-1249-5691-a09c-514eeaa32998" :answer/type {:db/ident :answer.type/math} :answer/value "(31)/(32)" :db/id #edb/ref 17592186273497} {:answer/id #uuid "8235c66d-1c66-5ea8-9572-f57d86df5c53" :answer/type {:db/ident :answer.type/math} :answer/value "(255)/(256)" :db/id #edb/ref 17592186273498} {:answer/id #uuid "ca97b419-5093-592e-a764-af1ea78403b7" :answer/type {:db/ident :answer.type/math} :answer/value "(15)/(16)" :db/id #edb/ref 17592186273499} {:answer/id #uuid "0f011ad7-8575-5696-bf52-7018c3a771b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186273500}] :answer-field/correct {:answer/id #uuid "0f011ad7-8575-5696-bf52-7018c3a771b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186273500} :answer-field/id #uuid "4cb35f11-eea5-5389-b873-6847f9b8a11c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274983}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "685b71b2-628c-518e-91ff-af651d3035a3" :question/math-academy-id "q-74710" :question/problem "Determine the fourth partial sum of the series\n${\\sum }_{n=1}^{\\infty }{(\\frac{1}{3})}^{n}.$" :question/worked-solution "Let ${a}_{n}={(\\frac{1}{3})}^{n}.$ We note that this is a geometric sequence with $r=\\frac{1}{3}$ and first term given by\n\n$$\n{a}_{1}={(\\frac{1}{3})}^{1}=\\frac{1}{3}.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the fourth partial sum is\n\n$$\n\\begin{aligned}{s}_{4}={\\sum }_{n=1}^{4}{a}_{n} & ={a}_{1}\\cdot \\frac{(1-{r}^{4})}{1-r} \\\\  & =\\frac{1}{3}\\cdot \\frac{(1-{(\\frac{1}{3})}^{4})}{(1-\\frac{1}{3})} \\\\  & =\\frac{1}{3}\\cdot \\frac{(1-\\frac{1}{81})}{(\\frac{2}{3})} \\\\  & =\\frac{(\\frac{1}{3})}{(\\frac{2}{3})}\\cdot \\frac{80}{81} \\\\  & =\\frac{1}{2}\\cdot (\\frac{80}{81}) \\\\  & =\\frac{40}{81}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261779 :knowledge-point/_questions [{:knowledge-point/id #uuid "ead28b84-1f92-510d-87b3-07eb9a394622" :knowledge-point/title "Determining Whether a p-Series with Integer Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e2b1f65-a46d-549e-873d-5a228f09e45c" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261781} {:answer/id #uuid "603d1924-96a6-5d2b-ae86-df2ef4c4144e" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186261782}] :answer-field/correct {:answer/id #uuid "603d1924-96a6-5d2b-ae86-df2ef4c4144e" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186261782} :answer-field/id #uuid "fd0b0645-835e-53dd-911e-0a6a3bfbcc85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261780}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dc370e1e-b2df-5215-9a8e-5cac451a46d5" :question/math-academy-id "q-81422" :question/problem "Use the $p$-test to determine whether the series below converges or diverges.\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{7}}\n$$" :question/worked-solution "The given series is a $p$-series with $p=7.$ Since $p>1,$ the series is convergent."}] [{:db/id #edb/ref 17592186261789 :knowledge-point/_questions [{:knowledge-point/id #uuid "f6051f35-c390-57ba-8448-40f53f11c1c1" :knowledge-point/title "Determining Which Series Converge From a List"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d0168c-6ede-54fb-9652-f394884c4e7e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261791} {:answer/id #uuid "5b0b5d61-6fa5-5dbe-bbbd-c9da34c952d9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261792} {:answer/id #uuid "99718659-6b95-56c5-93fa-2b928cdebb4e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261793} {:answer/id #uuid "2f4adb4b-d7a3-56f6-8d9c-96e044bb71c7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261794} {:answer/id #uuid "32969826-446c-54d6-b26d-0e9590c471a2" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261795} {:answer/id #uuid "aff89f37-bb34-5b98-97a9-6b06bf8214f2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261796} {:answer/id #uuid "f643ff22-3868-5aa5-8920-ba5f8b8db4c0" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261797} {:answer/id #uuid "94930072-171e-5522-8c48-ceede9eb52fa" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261798}] :answer-field/correct {:answer/id #uuid "aff89f37-bb34-5b98-97a9-6b06bf8214f2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261796} :answer-field/id #uuid "a6c8bf6f-5303-5a12-a675-f73664df7044" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261790}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9f47715f-32fb-5b55-bda6-7c06af34e3a5" :question/math-academy-id "q-81430" :question/problem "Which of the following series converge?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{\\sqrt{{n}^{3}}}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{2\\sqrt[4]{{n}^{5}}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{n}{\\sqrt{{n}^{3}}}$" :question/worked-solution "We analyze each series in turn.\n\n- First, we look at ${\\sum }_{n=1}^{\\infty }\\frac{1}{\\sqrt{{n}^{3}}}.$ Rewriting this gives\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{\\sqrt{{n}^{3}}}={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3/2}},\n$$\n\nand this is a $p$-series with $p=\\frac{3}{2}.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the second series, we have\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{2\\sqrt[4]{{n}^{5}}}=\\frac{1}{2}\\cdot {\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/4}},\n$$\n\n \nwhich is a $p$-series with $p=\\frac{5}{4}.$ Since $p>1,$ the series converges by the $p$-series test.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{n}{\\sqrt{{n}^{3}}} & ={\\sum }_{n=1}^{\\infty }\\frac{n}{{n}^{3/2}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{1/2}},\\end{aligned}\n$$\n\nand this is a $p$-series with $p=\\frac{1}{2}.$ Since $p\\le 1,$ the series is divergent.\n\nHence, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186261799 :knowledge-point/_questions [{:knowledge-point/id #uuid "f6051f35-c390-57ba-8448-40f53f11c1c1" :knowledge-point/title "Determining Which Series Converge From a List"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c9c4a7e-172c-5151-b005-2f18d4b7f553" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261801} {:answer/id #uuid "a4905309-acf2-54f0-8ad1-8c3693d19495" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261802} {:answer/id #uuid "2ffb9354-834b-5e1e-ae5b-04ec4bf67261" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261803} {:answer/id #uuid "30283cbb-7e38-5130-a664-a545053caeaf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261804} {:answer/id #uuid "3425748c-4498-5dc4-8bdf-67d081fee3c7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261805} {:answer/id #uuid "d49e6dcf-48a0-5db3-83a8-312ebf38293b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261806} {:answer/id #uuid "99d4cd90-a9ad-5b81-a7cc-b8b3a67eacac" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261807} {:answer/id #uuid "45b7d340-5474-55a3-8cc9-b87c7cc44aba" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261808}] :answer-field/correct {:answer/id #uuid "a4905309-acf2-54f0-8ad1-8c3693d19495" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261802} :answer-field/id #uuid "41f4075f-7219-516b-b866-7b0a6ea4dbed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261800}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a79cd092-c0f5-50bf-ba4a-1bcea68a7322" :question/math-academy-id "q-81488" :question/problem "Which of the following series are convergent?\n\nI. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{n}$\nII. - ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}}$\nIII. - ${\\sum }_{n=1}^{\\infty }\\frac{3}{\\sqrt[3]{{n}^{7}}}$" :question/worked-solution "We analyze each series in turn.\n\n- The series ${\\sum }_{n=1}^{\\infty }\\frac{1}{n}$ is a $p$-series with $p=1$ (the harmonic series). Since $p\\le 1,$ the series diverges by the $p$-series test.\n\n- The series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}}$ is a $p$-series with $p=3.$ Since $p>1,$ the series is convergent by the $p$-series test.\n\n- For the third series, we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{3}{\\sqrt[3]{{n}^{7}}} & =3{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{7/3}},\\end{aligned}\n$$\n\nwhich is a $p$-series with $p=\\frac{7}{3}.$ Since $p>1,$ the series is convergent by the $p$-series test.\n\nHence, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186261809 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4dff2ea-a90b-5618-82fc-647a40be0c46" :knowledge-point/title "Convergence Parameters for p-Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf136ac-b3d6-5186-abe7-fa61b50e302d" :answer/type {:db/ident :answer.type/math} :answer/value "q>0" :db/id #edb/ref 17592186273760} {:answer/id #uuid "4cafdd9b-ea95-5899-9726-2b35825189c1" :answer/type {:db/ident :answer.type/math} :answer/value "q > 1" :db/id #edb/ref 17592186273761} {:answer/id #uuid "618e6036-79d3-56b7-a1cb-22d4606988f6" :answer/type {:db/ident :answer.type/math} :answer/value "q < 1" :db/id #edb/ref 17592186273762} {:answer/id #uuid "240fcf4b-0e9f-5d40-8d4d-bf7800a97107" :answer/type {:db/ident :answer.type/math} :answer/value "q < (1)/(2)" :db/id #edb/ref 17592186273763} {:answer/id #uuid "3f533c84-5e3f-589e-bf6f-984b31b70a95" :answer/type {:db/ident :answer.type/math} :answer/value "q < 0" :db/id #edb/ref 17592186273764}] :answer-field/correct {:answer/id #uuid "0cf136ac-b3d6-5186-abe7-fa61b50e302d" :answer/type {:db/ident :answer.type/math} :answer/value "q>0" :db/id #edb/ref 17592186273760} :answer-field/id #uuid "064c4c6e-e42e-5cc7-bc53-c74df7283943" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275036}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "79d71a30-04c5-5ca5-8156-b0027fdb06ca" :question/math-academy-id "q-81489" :question/problem "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{q+1}}$ converge?" :question/worked-solution "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=q+1.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\nq+1>1\\,⟹\\,q>0.\n$$\n\nTherefore, the series is convergent for all $q>0.$"}] [{:db/id #edb/ref 17592186261998 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747cdf7c-5056-585f-affb-0f39e3896048" :answer/type {:db/ident :answer.type/math} :answer/value "-(4)" :db/id #edb/ref 17592186273983} {:answer/id #uuid "6bf0aeae-1d4a-59b6-a35e-4f9ddc20b49d" :answer/type {:db/ident :answer.type/math} :answer/value "3(4)" :db/id #edb/ref 17592186273984} {:answer/id #uuid "2b945afd-383e-55e1-83c7-01f9c0580ee1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(4)" :db/id #edb/ref 17592186273985} {:answer/id #uuid "83512872-4ffd-58df-97b4-6f8ade19e936" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273986} {:answer/id #uuid "5ff99a2f-9482-5aee-94d0-e9705ad048bf" :answer/type {:db/ident :answer.type/math} :answer/value "2(4)" :db/id #edb/ref 17592186273987}] :answer-field/correct {:answer/id #uuid "83512872-4ffd-58df-97b4-6f8ade19e936" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186273986} :answer-field/id #uuid "77cb32d2-b330-5790-b32f-90447e5c6f58" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275081}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f9c004d-c216-5608-ad21-162c3e1dd45a" :question/math-academy-id "q-9331" :question/problem "Determine whether the series\n${\\sum }_{n=1}^{\\infty }\\frac{4}{\\sqrt[6]{{n}^{5}}}$\nconverges or diverges." :question/worked-solution "The series can be written as\n\n$$\n4{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{5/6}},\n$$\n\nwhich is a $p$-series with $p=\\frac{5}{6}.$ Since $p\\le 1,$ the series is divergent.\n\nNote that the factor of $4$ multiplying the series has no effect on the convergence/divergence of the series."}] [{:db/id #edb/ref 17592186262007 :knowledge-point/_questions [{:knowledge-point/id #uuid "855a9c5c-9d01-584b-9b24-99834365b732" :knowledge-point/title "Determining Whether a p-Series With Fractional Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e62b48ba-4e69-5f10-ad22-2ad3012371f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)" :db/id #edb/ref 17592186273998} {:answer/id #uuid "256dece0-4e35-585c-83ba-196bca719650" :answer/type {:db/ident :answer.type/math} :answer/value "2(2)" :db/id #edb/ref 17592186273999} {:answer/id #uuid "f5dac688-adc6-56df-9364-c73ad895e5ee" :answer/type {:db/ident :answer.type/math} :answer/value "3(2)" :db/id #edb/ref 17592186274000} {:answer/id #uuid "5b00f6af-605d-5823-956e-6a4c4d738476" :answer/type {:db/ident :answer.type/math} :answer/value "-(2)" :db/id #edb/ref 17592186274001} {:answer/id #uuid "ac090d5b-7556-5f6c-aaad-250e743ff38e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274002}] :answer-field/correct {:answer/id #uuid "ac090d5b-7556-5f6c-aaad-250e743ff38e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274002} :answer-field/id #uuid "2b6cebee-d8d7-50bc-bf90-f9d2e93123b3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275084}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b19142ea-49a5-5749-b0b5-ee3907a47a2f" :question/math-academy-id "q-9337" :question/problem "Determine whether the series\n${\\sum }_{n=1}^{\\infty }\\frac{2}{\\sqrt[3]{{n}^{4}}}$\nconverges or diverges." :question/worked-solution "The series can be written as\n\n$$\n2{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{4/3}},\n$$\n\nwhich is a $p$-series with $p=\\frac{4}{3}.$ Since $p>1$, the series is convergent. \n\nNote that the factor of $2$ multiplying the series has no effect on the convergence/divergence \nof the series."}] [{:db/id #edb/ref 17592186262033 :knowledge-point/_questions [{:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31ec9ae4-b0d6-5be9-bc8c-de29f3265f4d" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262035} {:answer/id #uuid "fa6ea8d3-f89e-5586-84d6-4f2fb5198b6c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262036} {:answer/id #uuid "a953b4c7-4ee6-5bc0-a8ac-ed73d3147732" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262037} {:answer/id #uuid "2f42e654-6c96-54e8-b757-9b1eb76c5697" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262038} {:answer/id #uuid "54293858-1d79-5dce-bab3-925acb13dc67" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262039} {:answer/id #uuid "34a68151-c242-525f-a5da-8df577aa7e20" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186262040} {:answer/id #uuid "9dffe7bf-50cd-5aa0-8f09-7c1dc592865a" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186262041} {:answer/id #uuid "112dd4e2-d13b-5fc2-92ec-691c04cd9869" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186262042}] :answer-field/correct {:answer/id #uuid "54293858-1d79-5dce-bab3-925acb13dc67" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262039} :answer-field/id #uuid "80ce5838-d2f1-5bb7-a228-f73d437d0ff4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262034}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "84c8c29b-26d7-54c7-9b98-3b25f5c1151a" :question/math-academy-id "q-96680" :question/problem "Which of the following are first-order ordinary differential equations?\n\nI. - $3{y}^{'}+2x{y}^{''}={x}^{2}y$\nII. - $5{x}^{2}{y}^{‴}+3x{y}^{'}={e}^{x}$\nIII. - $4{({y}^{'})}^{3}+7{x}^{3}=x({y}^{2}+{({y}^{'})}^{2})$" :question/worked-solution "A differential equation is of first-order if the largest derivative term in the equation is ${y}^{'}.$\n\nKeeping this in mind, let's check each given equation.\n\n- Equation I is not a first-order differential equation. The highest derivative in this equation is ${y}^{''},$ so this is a second-order differential equation.\n\n- Equation II is not a first-order differential equation. The highest derivative in this equation is ${y}^{‴},$ so this is a third-order differential equation.\n\n- Equation III is a first-order differential equation. The highest derivative in this equation is ${y}^{'}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186262053 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260ab397-b927-5671-a132-7dd09d609d34" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262055} {:answer/id #uuid "7f06ae2a-7201-5a3b-99b4-8509ecf16acd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262056} {:answer/id #uuid "8077e54d-7a37-5429-8fa9-ae9e74524229" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262057} {:answer/id #uuid "0dd93856-caf5-588c-b235-bc48388d2a25" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262058} {:answer/id #uuid "22e76f62-d0c3-5a80-bbc8-c2dc099d27b2" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262059} {:answer/id #uuid "6aa4a613-9929-59a9-ba2b-6961e9f0f413" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186262060} {:answer/id #uuid "51c281f4-b71a-50f5-b47b-39e1bf734f00" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186262061} {:answer/id #uuid "65c7d200-aec2-5a6c-8d68-07f6d3c47302" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186262062}] :answer-field/correct {:answer/id #uuid "7f06ae2a-7201-5a3b-99b4-8509ecf16acd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262056} :answer-field/id #uuid "75ce830f-f7ad-5a8f-80c9-bfdeca211ffb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262054}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "22de21fe-5e7f-50a8-9618-79ceefd5ab17" :question/math-academy-id "q-96703" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nI. - $x\\frac{\\text{d}y}{\\text{d}x}-3{y}^{3}=2$\nII. - $\\frac{\\text{d}y}{\\text{d}x}-7{y}^{2}=\\frac{1}{y}$\nIII. - $\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{ln}y$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{'}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}x\\frac{\\text{d}y}{\\text{d}x}-3{y}^{3} & =2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2+3{y}^{3}}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=\\frac{2+3{y}^{3}}{x}.$ So, it is not possible to write the equation in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y).$\n\n- Equation II is an autonomous differential equation. Writing the equation in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}-7{y}^{2} & =\\frac{1}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =7{y}^{2}+\\frac{1}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=7{y}^{2}+\\frac{1}{y}.$\n\n- Equation III is an autonomous differential equation. We see that it is of the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ where $f(y)=\\operatorname{ln}y.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186262063 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fa0c4b2-8dc6-5823-a9bb-b933a9f9ee7f" :knowledge-point/title "Determining Whether an Ordinary Differential Equation is Autonomous or Nonautonomous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b74d4121-19bd-519b-9f42-6e2d74a4e53e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262065} {:answer/id #uuid "974d493e-45f3-5112-9946-af67f80df4aa" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262066} {:answer/id #uuid "aae8832f-c0df-5015-9905-eda5a0e98849" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262067} {:answer/id #uuid "8784430a-fefb-5a0e-8037-7072e097a072" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262068} {:answer/id #uuid "e76fcc33-5ba1-50a2-b5ef-7bdb0d465af6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262069} {:answer/id #uuid "59f18cbc-4413-5cee-a2a2-0a7277b9cd1c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186262070} {:answer/id #uuid "710af5b4-256e-512a-a5d1-86c2b6361f9a" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186262071} {:answer/id #uuid "b70c79e3-f5b6-5da6-92fe-75d7cf1ec1e5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186262072}] :answer-field/correct {:answer/id #uuid "8784430a-fefb-5a0e-8037-7072e097a072" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262068} :answer-field/id #uuid "b143ce9c-1d2f-54f8-9822-2eb13785f2e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262064}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2f8c44a4-8695-5bce-9b85-93159ef8f779" :question/math-academy-id "q-96705" :question/problem "Which of the following are autonomous ordinary differential equations?\n\nI. - ${e}^{y}\\frac{\\text{d}y}{\\text{d}x}-3{y}^{3}=0$\nII. - $\\frac{\\text{d}y}{\\text{d}x}-2x=\\operatorname{ln}y$\nIII. - $5x\\frac{\\text{d}y}{\\text{d}x}-\\frac{y}{x}=0$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{'}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is an autonomous differential equation. Writing the equation in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ we get\n\n$$\n\\begin{aligned}{e}^{y}\\frac{\\text{d}y}{\\text{d}x}-3{y}^{3} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =3{y}^{3}{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=3{y}^{3}{e}^{-y}.$\n\n- Equation II is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}-2x & =\\operatorname{ln}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}y+2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=\\operatorname{ln}y+2x.$ So, it is not possible to write the equation in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y).$\n\n- Equation III is not an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}5x\\frac{\\text{d}y}{\\text{d}x}-\\frac{y}{x} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y}{5{x}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)=\\frac{y}{5{x}^{2}}.$ So, it is not possible to write the equation in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186262083 :knowledge-point/_questions [{:knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "debfa9e3-f0d6-59a8-bd1a-a93ddedec8c1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262085} {:answer/id #uuid "d5192a67-97b2-58a1-918c-4a7ae001f7db" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262086} {:answer/id #uuid "59b7ad7c-c2a0-5250-8870-d1c274c642d1" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262087} {:answer/id #uuid "755b967b-454d-5af1-a6d7-4423160433e4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262088} {:answer/id #uuid "7750975c-75a1-5e0e-b7af-140759e7ca53" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262089} {:answer/id #uuid "1e4e9f1f-b4a5-52d2-a38c-f17ed129eff4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186262090} {:answer/id #uuid "e36f6f5b-7422-5092-a409-609d64e0adf7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186262091} {:answer/id #uuid "425d8c3b-9b21-5902-964b-634b329711ed" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186262092}] :answer-field/correct {:answer/id #uuid "7750975c-75a1-5e0e-b7af-140759e7ca53" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262089} :answer-field/id #uuid "939e9ad9-80a2-515c-913c-6d8916123f54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262084}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8ed0d022-e8a6-5277-8016-371d657756f9" :question/math-academy-id "q-96987" :question/problem "Which of the following systems is a first-order initial value problem?\n\nI. - ${x}^{2}{y}^{''}-y=2x,\\,y(1)=1,\\,{y}^{'}(1)=3$\nII. - $x{y}^{‴}-{e}^{x}{y}^{'}=9y,\\,y(0)=1,\\,{y}^{'}(0)=1,\\,{y}^{''}(0)=2$\nIII. - $2{y}^{'}-\\frac{1}{x}={e}^{y},\\,y(0)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{'}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I is not a first-order initial value problem. It consists of a *second*-order differential equation ${x}^{2}{y}^{''}-y=2x$ together with *two* initial conditions $y(1)=1,\\,{y}^{'}(1)=3.$ This is a second-order initial value problem.\n\n- System II is not a first-order initial value problem. It consists of a *third*-order differential equation $x{y}^{‴}-{e}^{x}{y}^{'}=9y$ together with *three* initial conditions $y(0)=1,\\,{y}^{'}(0)=1,$ and ${y}^{''}(0)=2.$ This is a third-order initial value problem.\n\n- System III is a first-order initial value problem. It consists of a first-order differential equation $2{y}^{'}-\\frac{1}{x}={e}^{y}$ together with the initial condition $y(0)=1.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186262118 :knowledge-point/_questions [{:knowledge-point/id #uuid "f44d9ddf-a830-559a-807e-a5a3eaaf66e8" :knowledge-point/title "Finding Unknown Parameters Given a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0e3f759-5274-51e7-8ecd-266ff3f5116a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186274023} {:answer/id #uuid "47f1afa2-6574-5327-b36b-9fc7fdb3200b" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186274024} {:answer/id #uuid "537bd001-5423-518b-9713-cc5a4e5eeb51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186274025} {:answer/id #uuid "69f9a3b6-5a74-51f1-b71e-91ac659e1a51" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186274026} {:answer/id #uuid "43526ba2-d877-5556-a8a5-5b2e7155ee17" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274027}] :answer-field/correct {:answer/id #uuid "f0e3f759-5274-51e7-8ecd-266ff3f5116a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186274023} :answer-field/id #uuid "41fe5a01-3966-5abe-a2fe-5fa521e4af17" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275089}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6efc25c1-7280-5213-84a4-9dd424baaae7" :question/math-academy-id "q-98152" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4b445c27e9b4b720cfcc8b8b265485ba4f62106be39acc066cf041bf9db073b2.png)\n\nThe diagram above shows the graph of $y=k{log}_{3}(bx).$ Find the value of $b+k.$" :question/worked-solution "Clearly, $b\\ne 0.$ Substituting $x=\\frac{1}{b}$ into the equation of the curve, we get\n\n$$\n\\begin{aligned}y & =k{log}_{3}(b\\cdot \\frac{1}{b}) \\\\  & =k{log}_{3}1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, the point $(\\frac{1}{b},0)$ lies on the curve. But from the diagram, we know that $(\\frac{1}{3},0)$ lies on the curve. Hence\n\n$$\n(\\frac{1}{3},0)=(\\frac{1}{b},0)\\,\\Rightarrow \\,b=3.\n$$\n\nNow, we substitute coordinates of the point $(1,\\frac{1}{2})$ into the equation:\n\n$$\n\\begin{aligned}k{log}_{3}(bx) & =y \\\\ k{log}_{3}(3x) & =y \\\\ k{log}_{3}(3\\cdot 1) & =\\frac{1}{2} \\\\ k{log}_{3}3 & =\\frac{1}{2} \\\\ k & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, \n\n$$\nb+k=3+\\frac{1}{2}=\\frac{7}{2}.\n$$"}] [{:db/id #edb/ref 17592186262121 :knowledge-point/_questions [{:knowledge-point/id #uuid "f44d9ddf-a830-559a-807e-a5a3eaaf66e8" :knowledge-point/title "Finding Unknown Parameters Given a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecbcecd6-a04c-532e-b80b-5548d83f38cc" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186274028} {:answer/id #uuid "5bea9cd4-a3b9-5a85-a1c1-553ebc48f12a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274029} {:answer/id #uuid "fdf650b9-3907-5733-aa3e-412f2f80c80f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186274030} {:answer/id #uuid "8263c253-db73-5809-97bb-ea30d09f032a" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186274031} {:answer/id #uuid "2a6c5f12-6505-58be-9ece-63721da28a23" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274032}] :answer-field/correct {:answer/id #uuid "5bea9cd4-a3b9-5a85-a1c1-553ebc48f12a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274029} :answer-field/id #uuid "631f0b66-a9fc-58fe-8a3a-408ea8bc43de" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275090}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f292f735-dfaf-5103-802f-50b77b9a6c31" :question/math-academy-id "q-98153" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/60d178be10126417bfbfad4e7a316d43ad1fd94ca19ea72adae929500a7f13c2.png)\n\nThe diagram above shows the graph of $y=k\\operatorname{ln}(x)+c.$ Find the value of $k+c.$" :question/worked-solution "Substituting $x=1$ into the equation of the curve, we get\n\n$$\n\\begin{aligned}y & =k\\operatorname{ln}(1)+c \\\\  & =0+c \\\\  & =c.\\end{aligned}\n$$\n\nSo, the point $(1,c)$ lies on the curve. But from the diagram, we know that $(1,-2)$ lies on the curve. Hence,\n\n$$\n(1,-2)=(1,c)\\,\\Rightarrow \\,c=-2.\n$$\n\nNow, we substitute coordinates of the point $(e,2)$ into the equation:\n\n$$\n\\begin{aligned}k\\operatorname{ln}(x)+c & =y \\\\ k\\operatorname{ln}(e)-2 & =2 \\\\ k-2 & =2 \\\\ k & =4\\end{aligned}\n$$\n\nFinally, \n\n$$\nk+c=4-2=2.\n$$"}]}
