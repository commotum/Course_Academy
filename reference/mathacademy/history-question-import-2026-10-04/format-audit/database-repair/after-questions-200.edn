#{[{:db/id #edb/ref 17592186256517 :knowledge-point/_questions [{:knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6c0967d-45e8-5197-8136-0b4418975264" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2}{3})" :db/id #edb/ref 17592186269412} {:answer/id #uuid "5ac1da54-cf5e-5aa4-b9ec-6f86eef14b4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186269413} {:answer/id #uuid "2f7590c0-cff6-59f0-86cf-e7f408596773" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186269414} {:answer/id #uuid "461282c9-42a3-57d5-a09a-673377d2160d" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186269415} {:answer/id #uuid "5447069d-6bcc-5773-86c7-9655d3c940ae" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269416}] :answer-field/correct {:answer/id #uuid "5ac1da54-cf5e-5aa4-b9ec-6f86eef14b4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186269413} :answer-field/id #uuid "5e6236bf-1879-5147-b55c-8b758f048b38" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274157}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dcdef879-b89d-50b8-80c4-887502ec74b8" :question/math-academy-id "q-101283" :question/problem "${lim}_{x\\to 3}\\frac{\\sqrt{4x-3}-3}{x-3}=$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{\\sqrt{4x-3}-3}{x-3} & =\\frac{\\sqrt{4(3)-3}-3}{3-3} \\\\  & =\\frac{\\sqrt{9}-3}{3-3} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{\\sqrt{4x-3}-3}{x-3} & ={lim}_{x\\to 3}\\frac{(\\sqrt{4x-3}-3)(\\sqrt{4x-3}+3)}{(x-3)(\\sqrt{4x-3}+3)} \\\\  & ={lim}_{x\\to 3}\\frac{(\\sqrt{4x-3})^{2}-{3}^{2}}{(x-3)(\\sqrt{4x-3}+3)} \\\\  & ={lim}_{x\\to 3}\\frac{4x-3-9}{(x-3)(\\sqrt{4x-3}+3)} \\\\  & ={lim}_{x\\to 3}\\frac{4x-12}{(x-3)(\\sqrt{4x-3}+3)} \\\\  & ={lim}_{x\\to 3}\\frac{4(x-3)}{(x-3)(\\sqrt{4x-3}+3)} \\\\  & ={lim}_{x\\to 3}\\frac{4}{\\sqrt{4x-3}+3} \\\\  & =\\frac{4}{\\sqrt{4(3)-3}+3} \\\\  & =\\frac{4}{\\sqrt{9}+3} \\\\  & =\\frac{4}{6} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256523 :knowledge-point/_questions [{:knowledge-point/id #uuid "045722b6-b558-522b-86e1-322c64e2848f" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5da02319-9f2c-5c74-922b-4188ea152590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186269422} {:answer/id #uuid "d6da0acf-cc5e-54e0-8a5c-e43050f3765c" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186269423} {:answer/id #uuid "f1d793f7-e24b-534b-8ca8-7aa6cc23595f" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186269424} {:answer/id #uuid "e0fd9620-d808-5b13-b4b0-792a8ad90ebf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269425} {:answer/id #uuid "8d848261-34f1-54cd-8f46-70d43aca76a7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269426}] :answer-field/correct {:answer/id #uuid "5da02319-9f2c-5c74-922b-4188ea152590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186269422} :answer-field/id #uuid "5b1584c5-7042-5d0c-9932-0475f25ad3d0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274159}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e2dca2c7-e791-5c46-b7d1-0efafbd3a36b" :question/math-academy-id "q-101289" :question/problem "${lim}_{x\\to 0}\\frac{x}{\\sqrt{3x+4}-2}=$" :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=0,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x}{\\sqrt{3x+4}-2} & =\\frac{0}{\\sqrt{3(0)+4}-2} \\\\  & =\\frac{0}{\\sqrt{4}-2} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x}{\\sqrt{3x+4}-2} & ={lim}_{x\\to 0}\\frac{x(\\sqrt{3x+4}+2)}{(\\sqrt{3x+4}-2)(\\sqrt{3x+4}+2)} \\\\  & ={lim}_{x\\to 0}\\frac{x(\\sqrt{3x+4}+2)}{(\\sqrt{3x+4})^{2}-{2}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{x(\\sqrt{3x+4}+2)}{3x+4-4} \\\\  & ={lim}_{x\\to 0}\\frac{x(\\sqrt{3x+4}+2)}{3x} \\\\  & ={lim}_{x\\to 0}\\frac{\\sqrt{3x+4}+2}{3} \\\\  & =\\frac{\\sqrt{3(0)+4}+2}{3} \\\\  & =\\frac{\\sqrt{4}+2}{3} \\\\  & =\\frac{2+2}{3} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256681 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4196423-3401-54e1-b214-9dbc4861cfe1" :knowledge-point/title "Identifying Spheres, Hemispheres, Cones, and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c61f9f3-2a54-5019-a166-6ad0885eabb6" :answer/type {:db/ident :answer.type/text} :answer/value "Oblique cylinder" :db/id #edb/ref 17592186256683} {:answer/id #uuid "a77fc4ff-c00e-5410-babf-3a6afcbd4f10" :answer/type {:db/ident :answer.type/text} :answer/value "Right cylinder" :db/id #edb/ref 17592186256684} {:answer/id #uuid "5bc115f3-10a1-5c32-9f8a-ca39b3d811c2" :answer/type {:db/ident :answer.type/text} :answer/value "Sphere" :db/id #edb/ref 17592186256685} {:answer/id #uuid "4ebaf498-6c55-523c-b224-d3a9c1b5fc5d" :answer/type {:db/ident :answer.type/text} :answer/value "Pyramid" :db/id #edb/ref 17592186256686} {:answer/id #uuid "4c6e5ea9-ddc3-5a4e-99b3-62670139ebd0" :answer/type {:db/ident :answer.type/text} :answer/value "Cone" :db/id #edb/ref 17592186256687} {:answer/id #uuid "4a3728e3-ed0a-565b-81d5-e8fac6415c12" :answer/type {:db/ident :answer.type/text} :answer/value "Prism" :db/id #edb/ref 17592186256688}] :answer-field/correct {:answer/id #uuid "a77fc4ff-c00e-5410-babf-3a6afcbd4f10" :answer/type {:db/ident :answer.type/text} :answer/value "Right cylinder" :db/id #edb/ref 17592186256684} :answer-field/id #uuid "180de416-69ab-5c18-9a3a-a094db6648c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256682}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2a4b869e-ef91-5ea2-9f20-27bb98e30ff5" :question/math-academy-id "q-107246" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/2d6d392d4e0f773f962289075ffa07cd26353ebc00ec50e7473a5c992824417f.png)\n\nWhat is the name of the solid shown above?" :question/worked-solution "The solid is a **right cylinder**. \n\nNotice the following:\n\n- The solid has two parallel circular bases. So, it's a cylinder.\n\n- The axis that passes through the centers of the circles is perpendicular to the bases. So, it's right."}] [{:db/id #edb/ref 17592186256798 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae50c07a-41bb-5981-9220-c21e53072469" :answer/type {:db/ident :answer.type/text} :answer/value "a = $(-2)+1$; b = $6$" :db/id #edb/ref 17592186269746} {:answer/id #uuid "b0d6329b-1479-5959-911a-d85dcfe5964a" :answer/type {:db/ident :answer.type/text} :answer/value "a = $(-2)-1$; b = $6$" :db/id #edb/ref 17592186269747} {:answer/id #uuid "f4977250-2668-549f-b986-77a273db18a3" :answer/type {:db/ident :answer.type/text} :answer/value "a = $(-2)-2$; b = $6$" :db/id #edb/ref 17592186269748} {:answer/id #uuid "7fbeae33-b866-5c3a-a55b-75ade0fc68d7" :answer/type {:db/ident :answer.type/text} :answer/value "a = $-2$; b = $6$" :db/id #edb/ref 17592186269749} {:answer/id #uuid "7d411cb6-5782-5447-960b-d98bd47408ef" :answer/type {:db/ident :answer.type/text} :answer/value "a = $(-2)+2$; b = $6$" :db/id #edb/ref 17592186269750}] :answer-field/correct {:answer/id #uuid "7fbeae33-b866-5c3a-a55b-75ade0fc68d7" :answer/type {:db/ident :answer.type/text} :answer/value "a = $-2$; b = $6$" :db/id #edb/ref 17592186269749} :answer-field/id #uuid "026c8b9e-dcd7-5a73-9a7a-790114bc44ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274224}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ce12f197-2895-5a7b-ab67-64d3d897a2dc" :question/math-academy-id "q-110144" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9d4a5a15c0fc8487aa827a275375c07f048f38ed76fd94b9c40223ff7c38fa9c.png)\n\nThe diagram above shows the graphs of $y=f(x)$ and $y=g(x)$, where $g(x)=f(x+a)+b.$ What are the values of $a$ and $b?$" :question/worked-solution "Notice that every point on the graph $y=g(x)$ is two units *to the right* and six units *up* of the corresponding point on the graph of $y=f(x).$ \n\nSo, we conclude that $g(x)=f(x-2)+6,$ and therefore $a=-2$ and $b=6.$"}] [{:db/id #edb/ref 17592186256827 :knowledge-point/_questions [{:knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1a08a4e-fae4-5aa6-a445-d59e900cd096" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{2}{9\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186269791} {:answer/id #uuid "fc9cef15-8df3-50d4-be5b-eefdade0ce2c" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{2}{9\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186269792} {:answer/id #uuid "b9a16382-e90f-586d-b81f-d794c7165890" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186269793} {:answer/id #uuid "3f2c3c7c-c28f-50ab-9e3d-3370e70acc85" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2}{9\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186269794} {:answer/id #uuid "27aea7ba-1cf8-5194-9464-464fa14f626b" :answer/type {:db/ident :answer.type/math} :answer/value "(8)/(5(1 − 64x^{2}))" :db/id #edb/ref 17592186269795}] :answer-field/correct {:answer/id #uuid "b9a16382-e90f-586d-b81f-d794c7165890" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186269793} :answer-field/id #uuid "80345b89-d8ad-5656-9f95-5a2bd3a21853" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274233}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "113190a3-0cee-5e3d-a690-7a607d9c17f5" :question/math-academy-id "q-110540" :question/problem "Find ${f}^{'}(x)$  for $f(x)=\\frac{\\operatorname{arcsin}2x}{9}.$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arcsin}2x}{9}) \\\\  & =\\frac{1}{9}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}2x) \\\\  & =\\frac{1}{9}\\cdot \\frac{1}{\\sqrt{1-(2x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =\\frac{1}{9}\\cdot \\frac{1}{\\sqrt{1-4{x}^{2}}}\\cdot 2 \\\\  & =\\frac{2}{9\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256830 :knowledge-point/_questions [{:knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95351ed4-53ef-59ae-a5a8-e9d890c33f3e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}}" :db/id #edb/ref 17592186269796} {:answer/id #uuid "d94bcf2e-61ec-5253-a75e-2784754002a8" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}})" :db/id #edb/ref 17592186269797} {:answer/id #uuid "03409231-ce45-5155-8c78-f1407023d0d7" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}})" :db/id #edb/ref 17592186269798} {:answer/id #uuid "6dd450fc-f458-5e64-b332-c0c87ca5f5ae" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}})" :db/id #edb/ref 17592186269799} {:answer/id #uuid "d32294a8-61c8-5e69-b5a1-781c80510b1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}})" :db/id #edb/ref 17592186269800}] :answer-field/correct {:answer/id #uuid "95351ed4-53ef-59ae-a5a8-e9d890c33f3e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}}" :db/id #edb/ref 17592186269796} :answer-field/id #uuid "165b005f-709b-5157-a51a-bf8cd8210965" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274234}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cc4b610a-b353-55a8-9b6f-c012e84f0426" :question/math-academy-id "q-110621" :question/problem "Calculate ${f}^{'}(x)$ for $f(x)=\\operatorname{arccos}(5+3{x}^{2}).$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}\\operatorname{arccos}(5+3{x}^{2}) \\\\  & =-\\frac{1}{\\sqrt{1-{(5+3{x}^{2})}^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(5+3{x}^{2}) \\\\  & =-\\frac{1}{\\sqrt{1-{(5+3{x}^{2})}^{2}}}\\cdot (6x) \\\\  & =-\\frac{6x}{\\sqrt{1-{(5+3{x}^{2})}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256882 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Synthetic Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e227eeaa-4512-5ce5-8aa5-41d08e3f1a21" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269865} {:answer/id #uuid "0e77869b-8916-5efb-919d-255ba054baed" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269866} {:answer/id #uuid "d0dd452a-3232-54db-9d6a-2841b9df2960" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269867} {:answer/id #uuid "d7ba6cf5-51c0-5b39-a51d-38ab2e8124f2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269868} {:answer/id #uuid "11352df9-b8eb-59b2-a766-778fdef9eb81" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269869}] :answer-field/correct {:answer/id #uuid "0e77869b-8916-5efb-919d-255ba054baed" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269866} :answer-field/id #uuid "cd17730e-c37c-5f3f-aaa8-1bb4270cf630" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274248}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e3bc7886-a3e3-5609-abf7-ad1cbadc0e93" :question/math-academy-id "q-112786" :question/problem "What is the multiplicity of the root $x=4$ in the polynomial $p(x)={x}^{3}-6{x}^{2}+32?$" :question/worked-solution "Since $x=4$ is a root of $p(x),$ the factor theorem tells us that $(x-4)$ is a factor of $p(x).$\n\nBecause $(x-4)$ is a factor of $p(x),$ we know that $(x-4)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x-4)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $4$ | $1$ | $-6$ | $0$ | $32$ |\n|  | $↓$ | $4$ | $-8$ | $-32$ |\n|  | $1$ | $-2$ | $-8$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x-4}={x}^{2}-2x-8,\n$$\n\nwhich means that\n\n$$\np(x)=(x-4)({x}^{2}-2x-8).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x-4)(x+2)(x-4) \\\\  & =(x+2)(x-4)^{2}.\\end{aligned}\n$$\n\nThe factor $(x-4)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=4$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186257010 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89709514-f459-5dc2-91f4-8b1240600b26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3\\operatorname{sin}x-2\\operatorname{sec}x+C)" :db/id #edb/ref 17592186270072} {:answer/id #uuid "e5b8a76b-712c-5948-bccf-6df0c85bf565" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sin}x-2\\operatorname{sec}x+C" :db/id #edb/ref 17592186270073} {:answer/id #uuid "3b29cacc-962b-5386-b2aa-cb4779de3e8c" :answer/type {:db/ident :answer.type/math} :answer/value "2(3\\operatorname{sin}x-2\\operatorname{sec}x+C)" :db/id #edb/ref 17592186270074} {:answer/id #uuid "cb915e74-7962-5c19-9c7d-f263031e3ef7" :answer/type {:db/ident :answer.type/math} :answer/value "3(3\\operatorname{sin}x-2\\operatorname{sec}x+C)" :db/id #edb/ref 17592186270075} {:answer/id #uuid "9e173ee8-9adf-5556-9719-1e16b2cf51bc" :answer/type {:db/ident :answer.type/math} :answer/value "-(3\\operatorname{sin}x-2\\operatorname{sec}x+C)" :db/id #edb/ref 17592186270076}] :answer-field/correct {:answer/id #uuid "e5b8a76b-712c-5948-bccf-6df0c85bf565" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sin}x-2\\operatorname{sec}x+C" :db/id #edb/ref 17592186270073} :answer-field/id #uuid "6a27a90d-e061-500c-a634-2f61908e3dbe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274290}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "24d3110b-7801-5a06-a723-89be430fdf97" :question/math-academy-id "q-113923" :question/problem "$\\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x & =3\\int \\operatorname{cos}x\\,\\text{d}x-2\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3\\operatorname{sin}x-2\\operatorname{sec}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257013 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae717ede-0cb6-5522-a9ec-917dfa33e11f" :answer/type {:db/ident :answer.type/math} :answer/value "3(-2\\operatorname{csc}x-\\operatorname{cos}x+C)" :db/id #edb/ref 17592186270077} {:answer/id #uuid "6388fd91-e083-5f9d-8f11-981219f9b552" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-2\\operatorname{csc}x-\\operatorname{cos}x+C)" :db/id #edb/ref 17592186270078} {:answer/id #uuid "0066a829-c12e-597c-97e5-5c77470b21d9" :answer/type {:db/ident :answer.type/math} :answer/value "-(-2\\operatorname{csc}x-\\operatorname{cos}x+C)" :db/id #edb/ref 17592186270079} {:answer/id #uuid "b2d0e359-0b74-50bd-b5a0-c82b55bca03f" :answer/type {:db/ident :answer.type/math} :answer/value "2(-2\\operatorname{csc}x-\\operatorname{cos}x+C)" :db/id #edb/ref 17592186270080} {:answer/id #uuid "de0224ac-2a6a-5b9a-b1ec-8800b6d33d9d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{csc}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186270081}] :answer-field/correct {:answer/id #uuid "de0224ac-2a6a-5b9a-b1ec-8800b6d33d9d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{csc}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186270081} :answer-field/id #uuid "a0aa0280-ff42-5fd8-8d72-db32ee631cf7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274291}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4b0506f0-8883-54c9-8f52-ff9e6fd263bc" :question/math-academy-id "q-113925" :question/problem "$\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257019 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f937a4b5-0cf0-5d93-95b4-2f72cfc3a96f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}\\operatorname{tan}x+C" :db/id #edb/ref 17592186270087} {:answer/id #uuid "c3c943f3-fbf6-5761-af87-1b8054b98f82" :answer/type {:db/ident :answer.type/math} :answer/value "− \\sec x + 4\\csc x + C" :db/id #edb/ref 17592186270088} {:answer/id #uuid "a7aa0991-ae84-5c02-abb2-fd92a56f2e8b" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sec x\\tan x + C" :db/id #edb/ref 17592186270089} {:answer/id #uuid "39f06b33-7c68-5368-959f-543a2e85184c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x + 8\\tan x + C" :db/id #edb/ref 17592186270090} {:answer/id #uuid "dab8aa32-7ac1-5c6c-bee2-6306b58345d5" :answer/type {:db/ident :answer.type/math} :answer/value "− 8\\sec x\\csc x + C" :db/id #edb/ref 17592186270091}] :answer-field/correct {:answer/id #uuid "f937a4b5-0cf0-5d93-95b4-2f72cfc3a96f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}\\operatorname{tan}x+C" :db/id #edb/ref 17592186270087} :answer-field/id #uuid "7a0a30a5-b151-5e00-8676-26bd4684b2c7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274293}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "292b56dc-de2a-5032-a17e-6e3b6f3c4acc" :question/math-academy-id "q-113935" :question/problem "$\\int -\\frac{3}{2}{sec}^{2}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}x\\,\\text{d}x=\\operatorname{tan}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{3}{2}{sec}^{2}x\\,\\text{d}x & =-\\frac{3}{2}\\int {sec}^{2}x\\,\\text{d}x \\\\  & =-\\frac{3}{2}(\\operatorname{tan}x)+C \\\\  & =-\\frac{3}{2}\\operatorname{tan}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257025 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ab9182e-2ded-5b69-b9d0-f6913b2d801d" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x − 2\\csc x + C" :db/id #edb/ref 17592186270097} {:answer/id #uuid "d37108aa-f799-52db-be7e-7ab13eac191a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot x − \\csc x + C" :db/id #edb/ref 17592186270098} {:answer/id #uuid "d3665f2f-272f-513e-8446-1bbf9bdd89ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{cot}x+C" :db/id #edb/ref 17592186270099} {:answer/id #uuid "111727f7-262e-578a-8e5c-9638119e089c" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + 2\\csc x + C" :db/id #edb/ref 17592186270100} {:answer/id #uuid "db6afd34-956b-5c82-b1bb-e751d47b01d6" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + \\csc x + C" :db/id #edb/ref 17592186270101}] :answer-field/correct {:answer/id #uuid "d3665f2f-272f-513e-8446-1bbf9bdd89ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{cot}x+C" :db/id #edb/ref 17592186270099} :answer-field/id #uuid "91776852-3b65-5b77-83af-aa59be4f3695" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274295}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bb1ca69c-b1be-58c9-acc5-e85cafc81f4d" :question/math-academy-id "q-113948" :question/problem "$\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}x\\,\\text{d}x=-\\operatorname{cot}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x & =-\\frac{5}{2}\\int {csc}^{2}x\\,\\text{d}x \\\\  & =-\\frac{5}{2}(-\\operatorname{cot}x)+C \\\\  & =\\frac{5}{2}\\operatorname{cot}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257028 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e44081-07cb-58f1-a28d-c42bd86831c4" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x − 2\\csc x + C" :db/id #edb/ref 17592186270102} {:answer/id #uuid "70d8414c-1a2b-5c70-ad08-6f27b4455d60" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot x − \\csc x + C" :db/id #edb/ref 17592186270103} {:answer/id #uuid "90a2a024-fdbb-5e1c-9cd5-94663edf31d0" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + 2\\csc x + C" :db/id #edb/ref 17592186270104} {:answer/id #uuid "8fe2b696-1266-53a1-bc56-9366c4752d6b" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{cot}x-4\\operatorname{sec}x+C" :db/id #edb/ref 17592186270105} {:answer/id #uuid "320dcf64-099a-5d25-8a96-45313eb470d3" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + \\csc x + C" :db/id #edb/ref 17592186270106}] :answer-field/correct {:answer/id #uuid "8fe2b696-1266-53a1-bc56-9366c4752d6b" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{cot}x-4\\operatorname{sec}x+C" :db/id #edb/ref 17592186270105} :answer-field/id #uuid "3617c299-a4bb-518b-a9fd-eee65e957a4b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a9755d5-7b55-50ff-b000-477adfea203f" :question/math-academy-id "q-113952" :question/problem "$\\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =3\\int {csc}^{2}x\\,\\text{d}x-4\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3(-\\operatorname{cot}x)-4(\\operatorname{sec}x)+C \\\\  & =-3\\operatorname{cot}x-4\\operatorname{sec}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257031 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8144e49b-c1c6-58ba-96e3-a7aac74cff20" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x − 2\\csc x + C" :db/id #edb/ref 17592186270107} {:answer/id #uuid "df78d31d-634e-5ad1-b876-165a10921726" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot x − \\csc x + C" :db/id #edb/ref 17592186270108} {:answer/id #uuid "6d85fca4-d3ee-5195-9952-914d2e843589" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + 2\\csc x + C" :db/id #edb/ref 17592186270109} {:answer/id #uuid "1a1e05da-a64a-5c94-8bfc-ec499c9a517a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x+2\\operatorname{cot}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186270110} {:answer/id #uuid "6c53c198-976c-50ea-bc99-e423e4e9f6e3" :answer/type {:db/ident :answer.type/math} :answer/value "− \\cot x + \\csc x + C" :db/id #edb/ref 17592186270111}] :answer-field/correct {:answer/id #uuid "1a1e05da-a64a-5c94-8bfc-ec499c9a517a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x+2\\operatorname{cot}x-\\operatorname{cos}x+C" :db/id #edb/ref 17592186270110} :answer-field/id #uuid "20179517-86ad-52a4-9426-c1555f62a82a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274297}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "77f4c639-7c11-58bc-9bd0-af3de1cb662d" :question/math-academy-id "q-113958" :question/problem "$\\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int sin\\,\\text{d}x & =-\\operatorname{cos}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x & =\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x-2\\int {csc}^{2}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =\\operatorname{sec}x-2(-\\operatorname{cot}x)+(-\\operatorname{cos}x)+C \\\\  & =\\operatorname{sec}x+2\\operatorname{cot}x-\\operatorname{cos}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257315 :knowledge-point/_questions [{:knowledge-point/id #uuid "d052da28-3f44-5ec5-912d-c5d9ad169eab" :knowledge-point/title "Simplifying an Expression Using the Relationship Between Sine, Cosine, and Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85230a23-f357-5ff3-a3c6-fbe8406f0f65" :answer/type {:db/ident :answer.type/math} :answer/value "3(2\\operatorname{sec}\\theta)" :db/id #edb/ref 17592186270342} {:answer/id #uuid "06836763-c403-5bc1-b61d-89bcc3765972" :answer/type {:db/ident :answer.type/math} :answer/value "2(2\\operatorname{sec}\\theta)" :db/id #edb/ref 17592186270343} {:answer/id #uuid "ed186f58-c101-5c0a-8a9e-2b4da5787849" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2\\operatorname{sec}\\theta)" :db/id #edb/ref 17592186270344} {:answer/id #uuid "3d672603-3018-5d4b-98f5-3f4f3cdee0fc" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sec}\\theta)" :db/id #edb/ref 17592186270345} {:answer/id #uuid "ed04a29d-2007-526f-96f4-073ca939dca1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}\\theta" :db/id #edb/ref 17592186270346}] :answer-field/correct {:answer/id #uuid "ed04a29d-2007-526f-96f4-073ca939dca1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}\\theta" :db/id #edb/ref 17592186270346} :answer-field/id #uuid "13bdcce0-6e1b-5564-9fbe-d3291419dc55" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274344}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "de7d1c80-2055-515b-a4b8-9b8892573c46" :question/math-academy-id "q-119100" :question/problem "Simplify the expression $\\operatorname{sec}\\theta +\\frac{\\operatorname{tan}\\theta }{\\operatorname{sin}\\theta }.$" :question/worked-solution "First, let's interpret the fraction as a division:\n\n$$\n\\frac{\\operatorname{tan}\\theta }{\\operatorname{sin}\\theta }=\\operatorname{tan}\\theta ÷\\operatorname{sin}\\theta \n$$\n\nThen, we recall the identity $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ and we substitute it into the above expression:\n\n$$\n\\begin{aligned}\\operatorname{tan}\\theta ÷\\operatorname{sin}\\theta  & =(\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta })÷\\operatorname{sin}\\theta \\end{aligned}\n$$\n\nFinally, we turn the division into multiplication, and simplify the expression as much as possible:\n\n$$\n\\begin{aligned}\\operatorname{sec}\\theta +(\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta })÷\\operatorname{sin}\\theta  & =\\operatorname{sec}\\theta +\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }\\cdot \\frac{1}{\\operatorname{sin}\\theta } \\\\  & =\\operatorname{sec}\\theta +\\frac{\\operatorname{sin}\\theta \\cdot 1}{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta } \\\\  & =\\operatorname{sec}\\theta +\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta } \\\\  & =\\operatorname{sec}\\theta +\\frac{\\cancel{\\operatorname{sin}\\theta }}{\\operatorname{cos}\\theta \\cdot \\cancel{\\operatorname{sin}\\theta }} \\\\  & =\\operatorname{sec}\\theta +\\frac{1}{\\operatorname{cos}\\theta } \\\\  & =\\operatorname{sec}\\theta +\\operatorname{sec}\\theta  \\\\  & =2\\operatorname{sec}\\theta \\end{aligned}\n$$\n\nTherefore, $\\operatorname{sec}\\theta +\\frac{\\operatorname{tan}\\theta }{\\operatorname{sin}\\theta }=2\\operatorname{sec}\\theta .$"}] [{:db/id #edb/ref 17592186257318 :knowledge-point/_questions [{:knowledge-point/id #uuid "d052da28-3f44-5ec5-912d-c5d9ad169eab" :knowledge-point/title "Simplifying an Expression Using the Relationship Between Sine, Cosine, and Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ab5c0f8-d3cb-57ef-9f72-fca07c4e3245" :answer/type {:db/ident :answer.type/math} :answer/value "-(1)" :db/id #edb/ref 17592186270347} {:answer/id #uuid "e2d8aa33-5c64-55dd-afdb-b22142bb3a27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1)" :db/id #edb/ref 17592186270348} {:answer/id #uuid "40bf5054-348b-5e3f-9997-180d9a228c4c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270349} {:answer/id #uuid "abf45105-4393-50db-a178-70a8df934518" :answer/type {:db/ident :answer.type/math} :answer/value "2(1)" :db/id #edb/ref 17592186270350} {:answer/id #uuid "75887f87-6fe4-5e8d-9e6f-026ebc603793" :answer/type {:db/ident :answer.type/math} :answer/value "3(1)" :db/id #edb/ref 17592186270351}] :answer-field/correct {:answer/id #uuid "40bf5054-348b-5e3f-9997-180d9a228c4c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270349} :answer-field/id #uuid "28a629f6-f292-57ca-b5bf-f39a04d9b397" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274345}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "38ea29bc-c897-5316-8be5-65752445ef8f" :question/math-academy-id "q-119102" :question/problem "Simplify the expression $\\operatorname{tan}\\theta \\operatorname{cos}\\theta \\operatorname{csc}\\theta .$" :question/worked-solution "First, we recall the identities $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }$ and $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ and we substitute them into the given expression:\n\n$$\n\\operatorname{tan}\\theta \\operatorname{cos}\\theta \\operatorname{csc}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }\\cdot \\operatorname{cos}\\theta \\cdot \\frac{1}{\\operatorname{sin}\\theta }\n$$\n\nNow, we multiply the three quantities:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }\\cdot \\operatorname{cos}\\theta \\cdot \\frac{1}{\\operatorname{sin}\\theta } & =\\frac{\\operatorname{sin}\\theta \\cdot \\operatorname{cos}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}\\theta \\cdot \\operatorname{cos}\\theta }}{\\cancel{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta }} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $\\operatorname{tan}\\theta \\operatorname{cos}\\theta \\operatorname{csc}\\theta =1.$"}] [{:db/id #edb/ref 17592186257324 :knowledge-point/_questions [{:knowledge-point/id #uuid "27ed79c0-3efe-581a-807b-3327b8fd9a4a" :knowledge-point/title "Rewriting a Trigonometric Equation Using an Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c046f98e-6d30-55e7-9a7b-5469d1c8d262" :answer/type {:db/ident :answer.type/math} :answer/value "(13)/(12)" :db/id #edb/ref 17592186270357} {:answer/id #uuid "2ede4209-58bf-55df-b95c-fac94b262a60" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270358} {:answer/id #uuid "d1c2cc29-e9f3-5cee-8d36-0e38dcb3b746" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{7}" :db/id #edb/ref 17592186270359} {:answer/id #uuid "3f57bea6-b676-5703-bc60-622c4b1467c7" :answer/type {:db/ident :answer.type/math} :answer/value "− (12)/(13)" :db/id #edb/ref 17592186270360} {:answer/id #uuid "151cd030-1524-5b3a-a259-b570eb0ba8bc" :answer/type {:db/ident :answer.type/math} :answer/value "(12)/(13)" :db/id #edb/ref 17592186270361}] :answer-field/correct {:answer/id #uuid "d1c2cc29-e9f3-5cee-8d36-0e38dcb3b746" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{7}" :db/id #edb/ref 17592186270359} :answer-field/id #uuid "80230603-0c77-505c-8c24-50cf58e1ca66" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274347}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8371e6c3-10d4-531f-8a1a-633dab884727" :question/math-academy-id "q-119215" :question/problem "Given that  $7\\operatorname{sin}\\theta =17\\operatorname{cos}\\theta ,$ calculate $\\operatorname{tan}\\theta .$" :question/worked-solution "First, we recall the identity $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }.$\n\nTo write the equation in terms of $\\operatorname{tan}\\theta $ only, we divide both sides of the equation by $\\operatorname{cos}\\theta ,$ and apply the above identity, as follows:\n\n$$\n\\begin{aligned}7\\operatorname{sin}\\theta  & =17\\operatorname{cos}\\theta  \\\\ 7\\cdot \\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =17\\cdot \\frac{\\operatorname{cos}\\theta }{\\operatorname{cos}\\theta } \\\\ 7\\operatorname{tan}\\theta  & =17\\end{aligned}\n$$\n\nFinally, we isolate $\\operatorname{tan}\\theta $ by dividing both sides of the equation by $7:$\n\n$$\n\\begin{aligned}\\frac{7\\operatorname{tan}\\theta }{7} & =\\frac{17}{7} \\\\ \\operatorname{tan}\\theta  & =\\frac{17}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257327 :knowledge-point/_questions [{:knowledge-point/id #uuid "19936679-c713-564f-8e88-4f4557fd7607" :knowledge-point/title "Simplifying a Complex Rational Expression Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bba0c037-6810-55e2-a4ad-df685848099e" :answer/type {:db/ident :answer.type/math} :answer/value "-(1)" :db/id #edb/ref 17592186270362} {:answer/id #uuid "7c6238b1-d95f-5184-8db4-38710c2bdd1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1)" :db/id #edb/ref 17592186270363} {:answer/id #uuid "4731392c-d79a-5086-9037-e9628b2d3e93" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270364} {:answer/id #uuid "caeeca34-dac2-5fc8-8f48-78d483083f98" :answer/type {:db/ident :answer.type/math} :answer/value "2(1)" :db/id #edb/ref 17592186270365} {:answer/id #uuid "58c3a42b-45fd-555c-97bb-3af5e2ed9808" :answer/type {:db/ident :answer.type/math} :answer/value "3(1)" :db/id #edb/ref 17592186270366}] :answer-field/correct {:answer/id #uuid "4731392c-d79a-5086-9037-e9628b2d3e93" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270364} :answer-field/id #uuid "1a12ad00-dfa0-558d-a341-9ff56e90488d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274348}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5a14c4ac-9ae0-5be9-b8ff-f6429667be79" :question/math-academy-id "q-119266" :question/problem "Simplify the trigonometric expression $\\frac{\\operatorname{cos}\\theta -\\operatorname{sec}\\theta \\operatorname{cot}\\theta \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta -1}.$" :question/worked-solution "First, let's interpret the fraction as a division:\n\n$$\n\\frac{\\operatorname{cos}\\theta -\\operatorname{sec}\\theta \\operatorname{cot}\\theta \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta -1}=(\\operatorname{cos}\\theta -\\operatorname{sec}\\theta \\operatorname{cot}\\theta \\operatorname{sin}\\theta )÷(\\operatorname{cos}\\theta -1)\n$$\n\nThen, we recall the identities $\\operatorname{cot}\\theta =\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }$ and $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ and we substitute them into the above expression:\n\n$$\n\\begin{aligned}(\\operatorname{cos}\\theta -\\operatorname{sec}\\theta \\operatorname{cot}\\theta \\operatorname{sin}\\theta )÷(\\operatorname{cos}\\theta -1) & =(\\operatorname{cos}\\theta -\\frac{1}{\\operatorname{cos}\\theta }\\cdot \\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }\\cdot \\operatorname{sin}\\theta )÷(\\operatorname{cos}\\theta -1)\\end{aligned}\n$$\n\nFinally, we simplify, turn the division into multiplication, and then simplify again:\n\n$$\n\\begin{aligned}(\\operatorname{cos}\\theta -\\frac{1}{\\operatorname{cos}\\theta }\\cdot \\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }\\cdot \\operatorname{sin}\\theta )÷(\\operatorname{cos}\\theta -1) & =(\\operatorname{cos}\\theta -\\frac{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta })÷(\\operatorname{cos}\\theta -1) \\\\  & =(\\operatorname{cos}\\theta -\\frac{\\cancel{\\operatorname{cos}\\theta }\\cdot \\cancel{\\operatorname{sin}\\theta }}{\\cancel{\\operatorname{cos}\\theta }\\cdot \\cancel{\\operatorname{sin}\\theta }})÷(\\operatorname{cos}\\theta -1) \\\\  & =(\\operatorname{cos}\\theta -1)÷(\\operatorname{cos}\\theta -1) \\\\  & =(\\operatorname{cos}\\theta -1)\\cdot (\\frac{1}{\\operatorname{cos}\\theta -1}) \\\\  & =\\frac{\\operatorname{cos}\\theta -1}{\\operatorname{cos}\\theta -1} \\\\  & =\\frac{\\cancel{\\operatorname{cos}\\theta -1}}{\\cancel{\\operatorname{cos}\\theta -1}} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $\\frac{\\operatorname{cos}\\theta -\\operatorname{sec}\\theta \\operatorname{cot}\\theta \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta -1}=1.$"}] [{:db/id #edb/ref 17592186257339 :knowledge-point/_questions [{:knowledge-point/id #uuid "fbb5348e-e292-513f-8b0a-90428692fc0a" :knowledge-point/title "Calculating the Probability of the Complement Given the Probability of the Event"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12385c6e-a6d4-5814-aa59-680003235c51" :answer/type {:db/ident :answer.type/math} :answer/value "(4)/(5)" :db/id #edb/ref 17592186270382} {:answer/id #uuid "fdff33b9-862a-5556-b917-459a60336e94" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(5)" :db/id #edb/ref 17592186270383} {:answer/id #uuid "34dd33cf-69b1-543d-ada7-b8fed133f667" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186270384} {:answer/id #uuid "8abeedf9-4c1f-5267-8f3b-09f5e7f94387" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270385} {:answer/id #uuid "c0e977de-488d-512e-9bec-8fd57c4b18f5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270386}] :answer-field/correct {:answer/id #uuid "34dd33cf-69b1-543d-ada7-b8fed133f667" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186270384} :answer-field/id #uuid "207d86d8-adcb-596a-9f1e-d7a98ea82ae3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274352}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "307826c5-d518-52f5-8812-84ccd5425547" :question/math-academy-id "q-119398" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/791a76ebbb34751b2ce345243c5de4baf95a32357ce48830e3ea43043011b5e1.png)\n\nGiven the above sample space, find $P({X}^{'}).$" :question/worked-solution "The Venn diagram tells us that $P(X)=\\frac{2}{9}.$ So, we have\n\n$$\n\\begin{aligned}P({X}^{'}) & =1-P(X) \\\\  & =1-\\frac{2}{9} \\\\  & =\\frac{7}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257383 :knowledge-point/_questions [{:knowledge-point/id #uuid "b11642dd-80cc-539c-8c2d-8cdee58e9d3e" :knowledge-point/title "Finding a Unit Vector Parallel to a Given Vector in a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4878c70b-76de-5dbb-9a22-350d5cfb653e" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{2}{\\sqrt{17}}(m+n))" :db/id #edb/ref 17592186270412} {:answer/id #uuid "73d3d5c0-fa4f-5b7f-b124-c402fbeccbe1" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{2}{\\sqrt{17}}(m+n))" :db/id #edb/ref 17592186270413} {:answer/id #uuid "dcab9a2e-1e64-5f9c-9736-097058159bb7" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2}{\\sqrt{17}}(m+n))" :db/id #edb/ref 17592186270414} {:answer/id #uuid "dada74df-6c22-5706-8d8c-9939a64bfc7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{2}{\\sqrt{17}}(m+n))" :db/id #edb/ref 17592186270415} {:answer/id #uuid "8460a918-7451-5c72-8518-fd13425e0314" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{17}}(m+n)" :db/id #edb/ref 17592186270416}] :answer-field/correct {:answer/id #uuid "8460a918-7451-5c72-8518-fd13425e0314" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{17}}(m+n)" :db/id #edb/ref 17592186270416} :answer-field/id #uuid "633898fb-899d-53be-8444-97d088ac0b5f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274358}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6e8f6481-88a7-5c1f-b12c-d389c514d403" :question/math-academy-id "q-119805" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/95c30eab094a24beb6976262167401efa973dbac12781c69d074eb14e12e2743.png)\n\nConsider the picture above. What is a unit vector that is parallel to $m+n?$" :question/worked-solution "First, we have to find $m+n.$ According to the triangle law of addition, the resultant $m+n$ goes from the tail of $m$ to the head of $n:$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/87647211f77776c5f5f740c205fafb150eef1b9d3ebefb82df73a9fdcd953bdb.png)\n\nIn $△AHB$, we have $∠AHB={90}^{∘}$, $AH=0.5=\\frac{1}{2}$ and $BH=2.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|m+n| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{2})}^{2}+{2}^{2}} \\\\  & =\\sqrt{\\frac{1}{4}+4} \\\\  & =\\frac{\\sqrt{17}}{2}.\\end{aligned}\n$$\n\nHence, the magnitude of $m+n$ is $\\frac{\\sqrt{17}}{2}.$ Consequently, the unit vector is\n\n$$\n\\begin{aligned}u & =\\frac{1}{|m+n|}\\cdot (m+n) \\\\  & =\\frac{2}{\\sqrt{17}}(m+n).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257485 :knowledge-point/_questions [{:knowledge-point/id #uuid "f1740fa9-50b1-5fad-9f99-31820dd77067" :knowledge-point/title "Calculating the Radius or Diameter of a Circle Given the Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae6210c3-92cc-598d-a1da-3251738025e6" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186270532} {:answer/id #uuid "7f6d84fc-e1ef-57d1-a2bf-d1cea6880ef2" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270533} {:answer/id #uuid "50e90f37-598e-5cd8-825a-04e26a0a9ed5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186270534} {:answer/id #uuid "172a51a6-0089-5013-986e-d36c218a96e1" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270535} {:answer/id #uuid "ffa1c39e-f0c2-5fb6-9ec7-a777996081ff" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270536}] :answer-field/correct {:answer/id #uuid "50e90f37-598e-5cd8-825a-04e26a0a9ed5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "1e82e57a-5b44-5852-928c-1b44e041638d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274382}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f2d62cce-a90d-5450-806d-43401c6ea8b1" :question/math-academy-id "q-122326" :question/problem "What is the diameter of a circle if its area is $\\frac{9}{25}\\pi ?$" :question/worked-solution "The formula for the area of a circle is $A=\\pi {r}^{2}$, where $r$ is the radius. Therefore,\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ \\frac{9}{25}\\pi  & =\\pi {r}^{2} \\\\ \\frac{9}{25}\\cancel{\\pi } & =\\cancel{\\pi }{r}^{2} \\\\ r & =\\sqrt{\\frac{9}{25}} \\\\ r & =\\frac{3}{5}\\,.\\end{aligned}\n$$\n\nTherefore, the diameter is\n\n$$\nd=2\\cdot r=2\\cdot \\frac{3}{5}=\\frac{6}{5}.\n$$"}] [{:db/id #edb/ref 17592186257497 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2e28247-1113-5d9f-9c76-49af8b498fc5" :knowledge-point/title "Computing a Reciprocal Ratio of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a15362f-2b20-5913-95e9-c768b333513e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257499}] :answer-field/correct {:answer/id #uuid "7a15362f-2b20-5913-95e9-c768b333513e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257499} :answer-field/id #uuid "a4bd8137-d637-56bb-a703-1a13466d8298" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257498}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "133173ff-502a-5d88-b605-7da6031fa128" :question/math-academy-id "q-123586" :question/problem "Find the value of $\\operatorname{sec}0+\\operatorname{csc}(\\frac{\\pi }{2}).$\n\nAnswer: {{answer}}" :question/worked-solution "The angles $0$ and $\\frac{\\pi }{2}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\n- Let's first consider the angle $0.$ From the unit circle, we see that the angle $0$ corresponds to the point $(1,0).$  Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}0=1.$ Therefore, using the fact that $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{sec}0=\\frac{1}{\\operatorname{cos}0}=\\frac{1}{1}=1.\n$$\n\n- Now, let's consider the angle $\\frac{\\pi }{2}.$ From the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$  Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{2})=1.$ Therefore, using the fact that $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{csc}(\\frac{\\pi }{2})=\\frac{1}{\\operatorname{sin}(\\frac{\\pi }{2})}=\\frac{1}{1}=1.\n$$\n\nFinally, we get\n\n$$\n\\operatorname{sec}0+\\operatorname{csc}(\\frac{\\pi }{2})=1+1=2.\n$$"}] [{:db/id #edb/ref 17592186257958 :knowledge-point/_questions [{:knowledge-point/id #uuid "36b04804-a1f3-57de-b966-65074210fc6b" :knowledge-point/title "Classifying a Product or Quotient of Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed3b8032-3546-54b7-9d11-2ba01b471b1b" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257960} {:answer/id #uuid "1df3a48b-57b3-5f2d-941e-363407328668" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257961} {:answer/id #uuid "4a90ccd6-f190-51f1-a576-e641b61d1e99" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257962} {:answer/id #uuid "81ca6aa0-5893-5596-9769-736c214e24b1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257963} {:answer/id #uuid "12cdbc21-5d48-577c-b672-10da61434ad8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257964} {:answer/id #uuid "106cd227-8a53-5674-a963-1cd2ccac7aba" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257965} {:answer/id #uuid "44a6a700-fdf8-5f65-8367-a9a1f1bc0cd1" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257966} {:answer/id #uuid "2203de7e-d536-5ffd-945d-3aa3b477d87e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257967}] :answer-field/correct {:answer/id #uuid "12cdbc21-5d48-577c-b672-10da61434ad8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257964} :answer-field/id #uuid "356dec81-7040-5fb4-a3fe-80097d3f0467" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257959}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e4d6294-f5f5-58cd-9f5f-15ca164270ca" :question/math-academy-id "q-133428" :question/problem "Which of the following expressions are **irrational**?\n\nI. - ${8}^{5}\\cdot \\sqrt{36}$\nII. - ${3}^{20}\\cdot 7.0523$\nIII. - $\\sqrt{2}\\cdot {2}^{-15}$" :question/worked-solution "Recall that: \n\n- the product of two rational numbers is *always* rational:\n\n$$\n\\text{rational}\\times \\text{rational}=\\text{rational}\n$$\n\n- the product of a nonzero rational number and an irrational number is *always* irrational:\n\n$$\n\\text{rational}\\times \\text{irrational}=\\text{irrational}\n$$\n\n- the product of two irrational numbers is *sometimes* rational and *sometimes* irrational.\n\nWith that in mind, let's examine the statements.\n\n- Expression I is rational. Notice that $\\sqrt{36}=6$ is a rational number. The number ${8}^{5}$ is rational too. So, their product must be rational.\n\n- Expression II is rational. Since both ${3}^{20}$ and $7.0523$ are rational, their product must be rational.\n\n- Expression III is irrational. Since $\\sqrt{2}$ is irrational and ${2}^{-15}$ is rational, their product must be irrational.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186258108 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2471751-7e5c-5823-9f63-76d14f927db2" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Larger Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3424d0-2ad9-514f-811e-d9fa8495115d" :answer/type {:db/ident :answer.type/math} :answer/value "-(3|v{|}^{3}\\sqrt{2v})" :db/id #edb/ref 17592186270967} {:answer/id #uuid "d31655f4-5610-519b-af61-c34d4674e03d" :answer/type {:db/ident :answer.type/math} :answer/value "3(3|v{|}^{3}\\sqrt{2v})" :db/id #edb/ref 17592186270968} {:answer/id #uuid "0bb87985-190d-5c65-8114-bc102f94456b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3|v{|}^{3}\\sqrt{2v})" :db/id #edb/ref 17592186270969} {:answer/id #uuid "592233b3-0ae5-5cb3-9022-c12bd12ae7c1" :answer/type {:db/ident :answer.type/math} :answer/value "3|v{|}^{3}\\sqrt{2v}" :db/id #edb/ref 17592186270970} {:answer/id #uuid "7a556681-98d8-5aed-89c0-c6059f2b6c7c" :answer/type {:db/ident :answer.type/math} :answer/value "2(3|v{|}^{3}\\sqrt{2v})" :db/id #edb/ref 17592186270971}] :answer-field/correct {:answer/id #uuid "592233b3-0ae5-5cb3-9022-c12bd12ae7c1" :answer/type {:db/ident :answer.type/math} :answer/value "3|v{|}^{3}\\sqrt{2v}" :db/id #edb/ref 17592186270970} :answer-field/id #uuid "8a400b9c-2582-5e3b-a889-e73973193605" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274469}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cd088633-afad-5cbc-8832-da4bf83a4756" :question/math-academy-id "q-141474" :question/problem "Simplify $\\sqrt{18{v}^{7}}.$" :question/worked-solution "We first write $18{v}^{7}$ as the product $9{v}^{6}\\cdot 2v$ which contains a perfect square $(9{v}^{6}):$ \n\n$$\n\\begin{aligned}\\sqrt{18{v}^{7}} & = \\\\ \\sqrt{9{v}^{6}\\cdot 2v} & \\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{9{v}^{6}\\cdot 2v} & = \\\\ \\sqrt{{(3{v}^{3})}^{2}\\cdot 2v} & = \\\\ \\sqrt{{(3{v}^{3})}^{2}}\\cdot \\sqrt{2v} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{(3{v}^{3})}^{2}}\\cdot \\sqrt{2v} & = \\\\ |3{v}^{3}|\\cdot \\sqrt{2v} & = \\\\ |3|\\cdot |{v}^{3}|\\cdot \\sqrt{2v} & = \\\\ 3|v{|}^{3}\\sqrt{2v}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258287 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc" :knowledge-point/title "Differentiating a Power of a Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd98825-1fa3-5ba1-a06e-26ffa83da92f" :answer/type {:db/ident :answer.type/math} :answer/value "-8{csc}^{2}t" :db/id #edb/ref 17592186258289}] :answer-field/correct {:answer/id #uuid "0dd98825-1fa3-5ba1-a06e-26ffa83da92f" :answer/type {:db/ident :answer.type/math} :answer/value "-8{csc}^{2}t" :db/id #edb/ref 17592186258289} :answer-field/id #uuid "fb6cc1aa-ac01-556d-8d95-93c1477f94a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258288}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4df0d1f9-09b6-5d26-902c-aee8403ebe60" :question/math-academy-id "q-143516" :question/problem "The acceleration $a(t)$ of the particle is given by the derivative of the velocity with respect to time. Find the function $a(t).$\n\n$a(t)=$\n{{field-1}}$\\cdot \\operatorname{cot}t$" :question/worked-solution "First, we write\n\n$$\nv(t)=4{csc}^{2}(t).\n$$\n\nNow, we see that $v(t)$ can be expressed as the composite function\n\n$$\nv=4{u}^{2},\\,u=\\operatorname{csc}t.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}v}{\\text{d}u}=8u,\\,\\frac{\\text{d}u}{\\text{d}t}=-\\operatorname{csc}t\\operatorname{cot}t.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}a(t) & ={v}^{'}(t) \\\\  & =\\frac{\\text{d}v}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}t} \\\\  & =8u\\cdot (-\\operatorname{csc}t\\operatorname{cot}t) \\\\  & =(8\\operatorname{csc}t)\\cdot (-\\operatorname{csc}t\\operatorname{cot}t) \\\\  & =-8{csc}^{2}t\\operatorname{cot}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258290 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "845a858e-1ff4-54b5-aac1-289eca93d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "2t\\operatorname{sin}(3t)+3{t}^{2}\\operatorname{cos}(3t)" :db/id #edb/ref 17592186258292}] :answer-field/correct {:answer/id #uuid "845a858e-1ff4-54b5-aac1-289eca93d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "2t\\operatorname{sin}(3t)+3{t}^{2}\\operatorname{cos}(3t)" :db/id #edb/ref 17592186258292} :answer-field/id #uuid "173cbd5e-78dc-5814-8e0d-82fe30df3d42" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258291}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55d75440-a427-575a-b46b-23b4efdc3e82" :question/math-academy-id "q-143518" :question/problem "Find the acceleration function ${a}_{2}(t)$ of the second particle.\n\n${a}_{2}(t)\\,=\\,$\n{{field-1}}" :question/worked-solution "In part 3, we saw that the derivative of a particle's velocity with respect to time gives its acceleration.\n\nTo differentiate ${v}_{2}(t),$ we require the product rule. Let $g(t)={t}^{2}$ and $h(t)=\\operatorname{sin}(3t).$ Then\n\n$$\n{g}^{'}(t)=2t,\\,{h}^{'}(t)=3\\operatorname{cos}(3t).\n$$\n\nWe used the chain rule to calculate ${h}^{'}(t).$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}{a}_{2}(t) & ={v}_{2}^{'}(t) \\\\  & ={g}^{'}(t)\\cdot h(t)+g(t)\\cdot {h}^{'}(t) \\\\  & =(2t)(\\operatorname{sin}(3t))+({t}^{2})(3\\operatorname{cos}(3t)) \\\\  & =2t\\operatorname{sin}(3t)+3{t}^{2}\\operatorname{cos}(3t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258293 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dcfe0d3-17ce-5fc9-9e65-220f684bdd89" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id #edb/ref 17592186258295}] :answer-field/correct {:answer/id #uuid "2dcfe0d3-17ce-5fc9-9e65-220f684bdd89" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id #edb/ref 17592186258295} :answer-field/id #uuid "2e4da863-25d4-55d1-8bff-f6bed2de2493" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258294}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "89c0e22d-f3ea-5464-882b-c9952565de77" :question/math-academy-id "q-143522" :question/problem "$\\int v(t)\\,\\text{d}t\\,\\,=\\,${{field-1}} $+\\text{ }C$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}t\\,\\text{d}t=-\\operatorname{cot}t+C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4{csc}^{2}t\\,\\text{d}t & =4\\int {csc}^{2}t\\,\\text{d}t \\\\  & =4(-\\operatorname{cot}t)+C \\\\  & =-4\\operatorname{cot}t+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258296 :knowledge-point/_questions [{:knowledge-point/id #uuid "298d3ee7-bb43-5835-8dc5-3306d1f9841f" :knowledge-point/title "Evaluating an Expression Involving Special Angles in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5da6754-0d94-5766-8532-2c9f59a970a5" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186258298}] :answer-field/correct {:answer/id #uuid "b5da6754-0d94-5766-8532-2c9f59a970a5" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186258298} :answer-field/id #uuid "ca8409c4-5999-5423-bfeb-c04e340e43e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258297}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6a57fe21-061f-551f-9781-c27e61809783" :question/math-academy-id "q-143531" :question/problem "Find the velocity of the particle at $t=\\frac{\\pi }{6}.$\n\n$v(\\frac{\\pi }{6})\\,=\\,$\n{{field-1}}$\\text{m/s}$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{6})=\\frac{1}{2}.$\n\nTherefore, using the fact that $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{csc}(\\frac{\\pi }{6})=\\frac{1}{\\operatorname{sin}(\\frac{\\pi }{6})}=\\frac{1}{(\\frac{1}{2})}=2.\n$$\n\nFinally, evaluating $v(t)$ at $t=\\frac{\\pi }{6}$ we have\n\n$$\n4{csc}^{2}(\\frac{\\pi }{6})=4{(2)}^{2}=16.\n$$"}] [{:db/id #edb/ref 17592186258299 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c5a9d62-eab8-5f09-aeb7-7a9a1c4e6eb1" :knowledge-point/title "Finding a Trigonometric Ratio of a Larger Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64c80601-24aa-52a1-9fc6-11143ee6411a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186258301}] :answer-field/correct {:answer/id #uuid "64c80601-24aa-52a1-9fc6-11143ee6411a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186258301} :answer-field/id #uuid "49ba34d1-c6aa-52ee-a5b5-4dc69fb147c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258300}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8a118ade-6d19-5620-b450-e584298e740f" :question/math-academy-id "q-143534" :question/problem "Another particle has a velocity function given by ${v}_{2}(t)={t}^{2}\\operatorname{sin}(3t).$ Evaluate the velocity of this particle at $t=\\frac{5\\pi }{6}.$\n\n${v}_{2}(\\frac{5\\pi }{6})\\,=\\,$\n{{field-1}}$\\text{m/s}$" :question/worked-solution "Evaluating the function ${v}_{2}(t)$ at $t=\\frac{5\\pi }{6}$, we get\n\n$$\n{v}_{2}(\\frac{5\\pi }{6})={(\\frac{5\\pi }{6})}^{2}\\operatorname{sin}(\\frac{5\\pi }{2})\n$$\n\nFirst, we find an angle that's coterminal with $\\frac{5\\pi }{2}$ that lies in the range $[0,2\\pi ).$\n\n$$\n\\begin{aligned}\\frac{5\\pi }{2}-2\\pi  & =\\frac{\\pi }{2}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sin}(\\frac{5\\pi }{2})=\\operatorname{sin}(\\frac{\\pi }{2}).$\n\nLet's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{2})=1.$\n\nTherefore, $\\operatorname{sin}(\\frac{5\\pi }{2})=1.$\n\nFinally, \n\n$$\n{v}_{2}(\\frac{5\\pi }{6})={(\\frac{5\\pi }{6})}^{2}\\operatorname{sin}(\\frac{5\\pi }{2})=\\frac{25{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186258302 :knowledge-point/_questions [{:knowledge-point/id #uuid "c9368b4e-a855-5fab-b074-a3a505c7ab0c" :knowledge-point/title "Computing the Limit of Sine or Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd3bb56-f3ce-5393-bd36-fdcff5225992" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186258304}] :answer-field/correct {:answer/id #uuid "7bd3bb56-f3ce-5393-bd36-fdcff5225992" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186258304} :answer-field/id #uuid "b6e5b8b9-3638-59f2-aa45-251eb4e8fb35" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258303}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3d6ada42-4014-5f9a-a482-4f54294eb213" :question/math-academy-id "q-143539" :question/problem "Find ${lim}_{t\\to \\pi /6}{v}_{2}(t)\\,=\\,${{field-1}}" :question/worked-solution "Substituting $x=\\frac{\\pi }{6}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to \\pi /6}{v}_{2}(t) & ={lim}_{t\\to \\pi /6}{t}^{2}\\operatorname{sin}(3t) \\\\  & ={(\\frac{\\pi }{6})}^{2}\\operatorname{sin}(\\frac{\\pi }{2}) \\\\  & =\\frac{{\\pi }^{2}}{36}\\cdot 1 \\\\  & =\\frac{{\\pi }^{2}}{36}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258305 :knowledge-point/_questions [{:knowledge-point/id #uuid "b89b9224-71e0-5c90-8e9e-5fc3f7e29574" :knowledge-point/title "Computing the Limit of a Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6586bca5-be1d-57ac-8fe2-c59efbb1f408" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186258307}] :answer-field/correct {:answer/id #uuid "6586bca5-be1d-57ac-8fe2-c59efbb1f408" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186258307} :answer-field/id #uuid "37ed01ef-bd31-587f-b264-6569a62f6cbc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258306}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2fa4ce58-465a-5d0b-b7f5-902a5179526d" :question/math-academy-id "q-143540" :question/problem "${lim}_{t\\to {\\pi }^{-}}v(t)\\,=\\,${{field-1}}" :question/worked-solution "Substituting $t=\\pi $ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to {\\pi }^{-}}v(t) & ={lim}_{t\\to {\\pi }^{-}}4{csc}^{2}(t) \\\\  & =4{csc}^{2}(\\pi ) \\\\  & =4\\frac{1}{{sin}^{2}(\\pi )} \\\\  & =\\frac{4}{{(0)}^{2}} \\\\  & =\\frac{4}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{csc}t.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/361e8bf3b622fc2e73be712dae4ec5d189bd15eecbd33c9295db7365bcf71943.png)\n\nAs $t$ approaches $\\pi $ from the left, the values of $y=\\operatorname{csc}t$ are positive and grow without bound. \n\nTherefore\n\n$$\n{lim}_{t\\to {\\pi }^{-}}\\operatorname{csc}t=\\infty \n$$\n\nApplying the product and power rules, we get\n\n$$\n\\begin{aligned}{lim}_{t\\to {\\pi }^{-}}4{csc}^{2}(t) & ={lim}_{t\\to {\\pi }^{-}}4\\cdot {lim}_{t\\to {\\pi }^{-}}{csc}^{2}(t) \\\\  & =4\\cdot {({lim}_{t\\to {\\pi }^{-}}\\operatorname{csc}(t))}^{2}\\end{aligned}\n$$\n\nMultiplying by the positive constant $4$ does not change the sign of the limit, so we have\n\n$$\n4\\cdot {({lim}_{t\\to {\\pi }^{-}}\\operatorname{csc}(t))}^{2}=\\infty .\n$$"}] [{:db/id #edb/ref 17592186258328 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b" :knowledge-point/title "Dividing Rational Expressions and Simplifying the Result by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206c075e-67cd-5710-a655-028034b8b91a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x-8}{7}" :db/id #edb/ref 17592186271027} {:answer/id #uuid "850691ff-2951-52c8-8d99-c0841ece6702" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{4x-8}{7})" :db/id #edb/ref 17592186271028} {:answer/id #uuid "9dd3fa35-5f34-54ac-9a4b-6fd7bc345434" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{4x-8}{7})" :db/id #edb/ref 17592186271029} {:answer/id #uuid "b82c5413-b083-5119-909c-64574a0784de" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{4x-8}{7})" :db/id #edb/ref 17592186271030} {:answer/id #uuid "b4d1f457-4f48-538a-83a5-324912745281" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{4x-8}{7})" :db/id #edb/ref 17592186271031}] :answer-field/correct {:answer/id #uuid "206c075e-67cd-5710-a655-028034b8b91a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x-8}{7}" :db/id #edb/ref 17592186271027} :answer-field/id #uuid "98f260e2-3ad6-56e9-8a6f-c4f0ae34adf6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274481}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4d658cd8-ccd0-50fb-b58a-ac8ee83638ac" :question/math-academy-id "q-14461" :question/problem "$\\frac{16x-20}{3x-6}÷\\frac{28x-35}{3{x}^{2}-12x+12}=$" :question/worked-solution "To compute\n\n$$\n\\frac{16x-20}{3x-6}÷\\frac{28x-35}{3{x}^{2}-12x+12},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{16x-20}{3x-6}÷\\frac{28x-35}{3{x}^{2}-12x+12} & = \\\\ \\frac{16x-20}{3x-6}\\cdot \\frac{3{x}^{2}-12x+12}{28x-35} & = \\\\ \\frac{4(4x-5)}{3x-6}\\cdot \\frac{(3x-6)(x-2)}{7(4x-5)} & = \\\\ \\frac{4\\cancel{(4x-5)}}{\\cancel{(3x-6)}}\\cdot \\frac{(x-2)\\cancel{(3x-6)}}{7\\cancel{(4x-5)}} & = \\\\ \\frac{4(x-2)}{7} & = \\\\ \\frac{4x-8}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258356 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e178cc56-990b-5593-a621-2730c2b401a3" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{2\\pi }{3})" :db/id #edb/ref 17592186271067} {:answer/id #uuid "c7360378-dad5-5516-ae32-dd001db00ddf" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186271068} {:answer/id #uuid "05652796-cfca-5aa4-899c-bb7822ecf64b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186271069} {:answer/id #uuid "597bdccd-373d-549e-a094-a9afa150cb59" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{2\\pi }{3})" :db/id #edb/ref 17592186271070} {:answer/id #uuid "2e2c83e2-e5d1-5846-aded-e9b050059958" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{2\\pi }{3})" :db/id #edb/ref 17592186271071}] :answer-field/correct {:answer/id #uuid "05652796-cfca-5aa4-899c-bb7822ecf64b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186271069} :answer-field/id #uuid "6479988b-ff00-54fc-92d2-8a6e09ae9649" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274489}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cdcb38c4-f4a4-5b45-b1c7-b6357ee9e213" :question/math-academy-id "q-152752" :question/problem "Evaluate ${lim}_{x\\to \\,\\sqrt{3}}(\\pi -\\operatorname{arctan}(x)).$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fc06a4e63f38a315dd3944f65f871cca2dbdddee26ec268e857f79e5f4ab8848.png)\n\nThe domain of $\\operatorname{arctan}(x)$ is $x\\in (-\\infty ,\\infty ).$ \n\nNow, substituting $x=\\sqrt{3}$ directly into the limit, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\sqrt{3}}(\\pi -\\operatorname{arctan}(x)) & =\\pi -\\operatorname{arctan}(\\sqrt{3}) \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258359 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3f3b874-3177-5f42-bb5e-71c0a55ec19f" :answer/type {:db/ident :answer.type/text} :answer/value "-1" :db/id #edb/ref 17592186271072} {:answer/id #uuid "79c5211b-8eee-5c1d-ae66-17c91e357bef" :answer/type {:db/ident :answer.type/text} :answer/value "1" :db/id #edb/ref 17592186271073} {:answer/id #uuid "e41bc343-bdd8-5a76-9b26-842ae705ee32" :answer/type {:db/ident :answer.type/text} :answer/value "0" :db/id #edb/ref 17592186271074} {:answer/id #uuid "220846a8-917c-5527-b6c3-2a4598769336" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186271075}] :answer-field/correct {:answer/id #uuid "220846a8-917c-5527-b6c3-2a4598769336" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186271075} :answer-field/id #uuid "7e9b01e0-21de-503e-b320-aa2492d0df43" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "93b68d6a-209d-5990-a5e0-9593ec931e11" :question/math-academy-id "q-152782" :question/problem "What is the value of ${lim}_{x\\to \\,5}\\frac{\\operatorname{arcsin}(x)-5}{x}?$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arcsin}(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nThe domain of $\\operatorname{arcsin}(x)$ is $x\\in [-1,1].$ Since $5\\notin [-1,1],$ this means that $\\operatorname{arcsin}(5)$ is undefined.\n\nTherefore, our limit is undefined, too."}] [{:db/id #edb/ref 17592186258362 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac36f9fc-ed0e-5cf4-a80b-934791b347e8" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186271076} {:answer/id #uuid "55ae6d69-11b8-5b67-ad5d-e67246df9ed9" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186271077} {:answer/id #uuid "3212cb2b-1e00-5ad6-880e-3efcf4ee7840" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186271078} {:answer/id #uuid "d0ebfab1-e576-5ad8-9a81-de635b0bd49c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271079} {:answer/id #uuid "d4f7bc06-7c10-520a-a287-b5b1621e44f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186271080}] :answer-field/correct {:answer/id #uuid "d4f7bc06-7c10-520a-a287-b5b1621e44f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186271080} :answer-field/id #uuid "950a372e-df17-5dc7-832f-c3b194cafbda" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274491}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e6ad1b96-17fe-5464-ba79-198e73b68091" :question/math-academy-id "q-152870" :question/problem "${lim}_{x\\to \\,\\infty }\\operatorname{cos}(\\frac{1}{2}\\operatorname{arctan}(\\frac{x-3}{3}))=$" :question/worked-solution "First, let's sketch the graph of  $y=\\operatorname{arctan}(\\frac{x-3}{3}):$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ee481869c72bd5858ac5f2c561605b3b164555a4043eb914d49da7506dcf40dd.png)\n\nThe domain of   $\\operatorname{arctan}(\\frac{x-3}{3})$ is $(-\\infty ,\\infty ).$ \n\nAs $x$ increases to $\\infty ,$ the graph tends to $y=\\frac{\\pi }{2}.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\operatorname{cos}(\\frac{1}{2}\\operatorname{arctan}(\\frac{x-3}{3})) & =\\operatorname{cos}(\\frac{1}{2}\\cdot (\\frac{\\pi }{2})) \\\\  & =\\operatorname{cos}(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258545 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f19b5c4-e10c-5c70-8584-1c203dc7d03f" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258547} {:answer/id #uuid "a9d66bb6-1a71-5651-aa28-5c76ce9e870d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258548} {:answer/id #uuid "f0ace6d7-933c-550c-839a-ce6ea37a0a5a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258549} {:answer/id #uuid "4cd1cb4e-2125-579f-a82b-a38e052eaddf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258550} {:answer/id #uuid "c5c06e8a-a199-5dd2-b929-b6941f609134" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258551} {:answer/id #uuid "4c28e77e-db15-5c0d-8069-14e040f64ecc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258552} {:answer/id #uuid "3e3412e2-b865-5b94-9b3e-9b235d4aae3e" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258553} {:answer/id #uuid "252ca2ec-894b-5bb1-89e3-803daa8710f6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258554}] :answer-field/correct {:answer/id #uuid "252ca2ec-894b-5bb1-89e3-803daa8710f6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258554} :answer-field/id #uuid "73392058-1d10-5e8b-90df-46ae072c8bf7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258546}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7049a950-6667-5e99-a83e-6c95051eae41" :question/math-academy-id "q-160400" :question/problem "Which of the following numbers lie in the second quadrant in an Argand diagram?\n\nI. - $3-\\text{i}$\nII. - $-1+2\\text{i}$\nIII. - $-2-4\\text{i}$" :question/worked-solution "- The complex number $3-\\text{i}$ has the real part $x=3$ and the imaginary part $y=-1.$ So, it corresponds to the point $(3,-1)$, which lies in the fourth quadrant.\n\n- The complex number $-1+2\\text{i}$ has the real part $x=-1$ and the imaginary part $y=2.$ So, it corresponds to the point $(-1,2)$, which lies in the second quadrant.\n\n- The complex number $-2-4\\text{i}$ has the real part $x=-2$ and the imaginary part $y=-4.$ So, it corresponds to the point $(-2,-4)$, which lies in the third quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fafede137db90419fd849820668f36610ec675aa7a0e8a77d706872e33a149ef.png)\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186258577 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a8b5e35-96f2-5fc6-852f-d05f7ae11c09" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186258579}] :answer-field/correct {:answer/id #uuid "4a8b5e35-96f2-5fc6-852f-d05f7ae11c09" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186258579} :answer-field/id #uuid "fc5abb14-71a2-5556-b573-44c813a89a31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258578}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7e618581-c326-5ad5-9817-b1c392c0f169" :question/math-academy-id "q-166172" :question/problem "Find ${lim}_{x\\to \\,-\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,-\\infty }f(x)=$\n{{field-1}}" :question/worked-solution "We identify the leading term of the polynomial and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-\\infty }(2x-{x}^{2}) & ={lim}_{x\\to \\,-\\infty }(-{x}^{2}) \\\\  & =-{lim}_{x\\to \\,-\\infty }({x}^{2}) \\\\  & =-(\\infty ) \\\\  & =-\\infty \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258580 :knowledge-point/_questions [{:knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0a893a0-9c1f-588b-8481-c0239d08c817" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4\\sqrt{2}}" :db/id #edb/ref 17592186258582}] :answer-field/correct {:answer/id #uuid "a0a893a0-9c1f-588b-8481-c0239d08c817" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4\\sqrt{2}}" :db/id #edb/ref 17592186258582} :answer-field/id #uuid "c4366125-dde0-5e95-b07b-fea97429c985" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258581}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e7335c37-4d61-5445-b937-b7603f1ff98b" :question/math-academy-id "q-166173" :question/problem "Evaluate ${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{f(x)}.$  If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{f(x)}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit directly by substituting $x=2,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{f(x)} & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{2x-{x}^{2}} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{2}}{2(2)-(2)^{2}} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since there is a radical in the numerator, we can evaluate the limit by first multiplying the numerator and the denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{f(x)} & ={lim}_{x\\to {2}^{+}}\\frac{\\sqrt{x}-\\sqrt{2}}{2x-{x}^{2}} \\\\  & ={lim}_{x\\to {2}^{+}}\\frac{(\\sqrt{x}-\\sqrt{2})(\\sqrt{x}+\\sqrt{2})}{(2x-{x}^{2})(\\sqrt{x}+\\sqrt{2})} \\\\  & ={lim}_{x\\to {2}^{+}}\\frac{x-2}{x(2-x)(\\sqrt{x}+\\sqrt{2})} \\\\  & ={lim}_{x\\to {2}^{+}}\\frac{-(2-x)}{x(2-x)(\\sqrt{x}+\\sqrt{2})} \\\\  & =-{lim}_{x\\to {2}^{+}}\\frac{\\cancel{2-x}}{x\\cancel{(2-x)}(\\sqrt{x}+\\sqrt{2})} \\\\  & =-{lim}_{x\\to {2}^{+}}\\frac{1}{x(\\sqrt{x}+\\sqrt{2})} \\\\  & =-\\frac{1}{2(\\sqrt{2}+\\sqrt{2})} \\\\  & =-\\frac{1}{4\\sqrt{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258583 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8f2e684-6cd8-5ede-9f70-1a24ada54cb9" :knowledge-point/title "Calculating the Instantaneous Rate of Change of a Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88b9dd30-548b-5770-8c2d-ad71a4396953" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258585}] :answer-field/correct {:answer/id #uuid "88b9dd30-548b-5770-8c2d-ad71a4396953" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258585} :answer-field/id #uuid "4a784fbb-536a-5971-96a7-7d5e1444c0b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258584}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5be7f888-8103-5b32-9838-2ee1a31d74a5" :question/math-academy-id "q-166174" :question/problem "The instantaneous rate of change of $f(x)$ at $x=3$ is given by\n\n${f}^{'}(3)={lim}_{x\\to 3}\\frac{f(x)-f(3)}{x-3}={lim}_{x\\to 3}(-x-$\n{{field-1}}\n$).$" :question/worked-solution "Simplifying the expression under the limit, we get\n\n$$\n\\begin{aligned}{f}^{'}(3) & ={lim}_{x\\to 3}\\frac{f(x)-f(3)}{x-3} \\\\  & ={lim}_{x\\to 3}(\\frac{[2x-{x}^{2}]-[2(3)-(3)^{2}]}{x-3}) \\\\  & ={lim}_{x\\to 3}(\\frac{-{x}^{2}+2x+3}{x-3}) \\\\  & ={lim}_{x\\to 3}(\\frac{-({x}^{2}-2x-3)}{x-3}) \\\\  & ={lim}_{x\\to 3}(\\frac{-(x+1)\\cancel{(x-3)}}{\\cancel{x-3}}) \\\\  & ={lim}_{x\\to 3}(-x-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258732 :knowledge-point/_questions [{:knowledge-point/id #uuid "874dfb35-398e-5ed7-8a76-f0011569e6a1" :knowledge-point/title "Computing a Complement Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "474fc3a2-2339-5315-8a7c-2d0bb6ef1c72" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(4)" :db/id #edb/ref 17592186271260} {:answer/id #uuid "d0535600-650e-5e81-aa67-a3a2f81c1b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186271261} {:answer/id #uuid "edcd5cdc-b75e-5481-bb62-5dc97ce1e581" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186271262} {:answer/id #uuid "06fb01cc-da8e-5df3-9730-5d66c17261d5" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186271263} {:answer/id #uuid "f28fb8fd-96a9-5f2b-8857-91f7bd84591f" :answer/type {:db/ident :answer.type/math} :answer/value "(27)/(37)" :db/id #edb/ref 17592186271264}] :answer-field/correct {:answer/id #uuid "d0535600-650e-5e81-aa67-a3a2f81c1b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186271261} :answer-field/id #uuid "990c227c-a9e6-5b13-9da1-c01b82fd01d9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274530}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "27fe13ff-12fc-5d42-8d48-6dd6fccb6a52" :question/math-academy-id "q-180277" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a61a6232b2041bab3d455a7d765311ddfae25f674f8dbbf79696d2137355b159.png)\n\nThe Venn diagram shown above represents two events $A$ and $B$ and the number of outcomes in each region of the sample space.\n\nGiven that every outcome is equally likely, find $P({A}^{'}\\cup {B}^{'}).$" :question/worked-solution "To calculate the probability of an event using a Venn diagram, we count the number of outcomes in the region that represents the event, and divide by the total number of outcomes of the sample space $S.$\n\nIn the Venn diagram, ${A}^{'}\\cup {B}^{'}$ is represented by the area outside the circle $B$ or outside the circle $A$ (see the illustration below).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/6a3bb7b671e45aeb15d3239cae6fcedb7c36e52b15141d66b23e65066ab37edc.png)\n\nWe count up the outcomes:\n\n- The number of outcomes in ${A}^{'}\\cup {B}^{'}$ is \n\n$$\n2+5+1=8\n$$\n\n- The total number of outcomes in $S$ is\n\n$$\n2+9+5+1=17.\n$$\n\nSo, we have\n\n$$\nP({A}^{'}\\cup {B}^{'})=\\frac{8}{17}.\n$$"}] [{:db/id #edb/ref 17592186258792 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db4cc0da-6008-5a0a-ac75-6bb253dedf6f" :answer/type {:db/ident :answer.type/math} :answer/value "-(42)" :db/id #edb/ref 17592186271350} {:answer/id #uuid "c4d8b79b-72e5-5752-b348-cf3fc86c1b90" :answer/type {:db/ident :answer.type/math} :answer/value "3(42)" :db/id #edb/ref 17592186271351} {:answer/id #uuid "45a3d6b2-a30f-5890-aaa5-f8f88f80e109" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(42)" :db/id #edb/ref 17592186271352} {:answer/id #uuid "6a742c91-e915-5982-9a70-69a6e260c761" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186271353} {:answer/id #uuid "3df5ec53-4545-5150-9da5-65d6258b6b53" :answer/type {:db/ident :answer.type/math} :answer/value "2(42)" :db/id #edb/ref 17592186271354}] :answer-field/correct {:answer/id #uuid "6a742c91-e915-5982-9a70-69a6e260c761" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186271353} :answer-field/id #uuid "ea4735a1-ad65-59ec-ba23-ed8a4f02b65d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274548}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f100bda5-e5cc-5ecc-9c54-883833c98d6d" :question/math-academy-id "q-19306" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=5{e}^{t}+2\\operatorname{ln}t+{t}^{2},\\,t>0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to the nearest integer." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(5{e}^{t}+2\\operatorname{ln}t+{t}^{2}) \\\\  & =5{e}^{t}+\\frac{2}{t}+2t\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =5{e}^{2}+\\frac{2}{2}+2(2) \\\\  & =5{e}^{2}+5 \\\\  & =41.945… \\\\  & \\approx 42\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258810 :knowledge-point/_questions [{:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a473c55-d1f5-56bd-bab0-ab57417576a4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186271380} {:answer/id #uuid "070548af-d0c8-5d2d-9304-9e649592f2ef" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186271381} {:answer/id #uuid "f7121fd7-e35f-573a-a0c1-9cb633002de1" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186271382} {:answer/id #uuid "e9ca11aa-7dc5-506f-80b8-e8babca001db" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186271383} {:answer/id #uuid "9b025e0c-1662-5edd-96a2-053c9c0be539" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186271384}] :answer-field/correct {:answer/id #uuid "070548af-d0c8-5d2d-9304-9e649592f2ef" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186271381} :answer-field/id #uuid "3f1d7f23-6719-5e88-b15b-da25bec9a7b6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274554}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aaf4d311-c3be-544b-af6a-27bd8d3ca99a" :question/math-academy-id "q-19821" :question/problem "Peter has $8$ shirts, $6$ pants, and $6$ pairs of shoes. If Peter wears one shirt, one pant, and one pair of shoes, how many different ways can Peter dress?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of shirts} \\\\  & \\times \\text{Number of pants} \\\\  & \\times \\text{Number of pairs of shoes} \\\\  & =8\\times 6\\times 6 \\\\  & =288.\\end{aligned}\n$$\n\nTherefore, Peter can dress in $288$ different ways."}] [{:db/id #edb/ref 17592186258888 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7998900-b8cf-5b14-8ea5-7acebee13ddb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}x+\\operatorname{cos}x+C" :db/id #edb/ref 17592186271440} {:answer/id #uuid "e01a8351-56bd-51ff-a4f0-9cded947ff72" :answer/type {:db/ident :answer.type/math} :answer/value "− \\sec x + 4\\csc x + C" :db/id #edb/ref 17592186271441} {:answer/id #uuid "65607cf8-73d7-5d4a-9a12-00e8adecf21a" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sec x\\tan x + C" :db/id #edb/ref 17592186271442} {:answer/id #uuid "4f929db4-947a-59a0-bb34-c7729113ad0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x + 8\\tan x + C" :db/id #edb/ref 17592186271443} {:answer/id #uuid "b32fd4c8-2b31-5403-939e-7a55ce4758d4" :answer/type {:db/ident :answer.type/math} :answer/value "− 8\\sec x\\csc x + C" :db/id #edb/ref 17592186271444}] :answer-field/correct {:answer/id #uuid "a7998900-b8cf-5b14-8ea5-7acebee13ddb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}x+\\operatorname{cos}x+C" :db/id #edb/ref 17592186271440} :answer-field/id #uuid "b6023a6a-caed-556e-b679-4b0f693ed7d1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274566}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "88825c37-179e-5c8c-8712-b57ce55ee253" :question/math-academy-id "q-2162" :question/problem "$\\int (2{sec}^{2}x-\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int {sec}^{2}x\\,\\text{d}x & =\\operatorname{tan}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (2{sec}^{2}x-\\operatorname{sin}x)\\,\\text{d}x & =\\int 2{sec}^{2}x\\,\\text{d}x-\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2\\operatorname{tan}x-(-\\operatorname{cos}x)+C \\\\  & =2\\operatorname{tan}x+\\operatorname{cos}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258894 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cbbccf3-e32e-5fa1-82fc-bbb78279296c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x-\\operatorname{tan}x+C" :db/id #edb/ref 17592186271445} {:answer/id #uuid "0f41fd5c-1e8b-546f-b1dc-bac8be50f17b" :answer/type {:db/ident :answer.type/math} :answer/value "− \\sec x + 4\\csc x + C" :db/id #edb/ref 17592186271446} {:answer/id #uuid "567fb9b2-7c60-5f73-8ba4-48665b9c3511" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sec x\\tan x + C" :db/id #edb/ref 17592186271447} {:answer/id #uuid "fbf059ed-c04e-54cb-a860-eae766aa830a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x + 8\\tan x + C" :db/id #edb/ref 17592186271448} {:answer/id #uuid "aa713e36-ac94-52a1-9860-7d7b4ac9a96e" :answer/type {:db/ident :answer.type/math} :answer/value "− 8\\sec x\\csc x + C" :db/id #edb/ref 17592186271449}] :answer-field/correct {:answer/id #uuid "4cbbccf3-e32e-5fa1-82fc-bbb78279296c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x-\\operatorname{tan}x+C" :db/id #edb/ref 17592186271445} :answer-field/id #uuid "4c753101-d2f8-5964-8804-6f14b9a64241" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274567}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aae416b9-61a3-522e-b8ee-6ceb101dcd00" :question/math-academy-id "q-2165" :question/problem "$\\int (\\operatorname{sec}x\\operatorname{tan}x-{sec}^{2}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int {sec}^{2}x\\,\\text{d}x & =\\operatorname{tan}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{sec}x\\operatorname{tan}x-{sec}^{2}x)\\,\\text{d}x & =\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x-\\int {sec}^{2}x\\,\\text{d}x \\\\  & =\\operatorname{sec}x-\\operatorname{tan}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258940 :knowledge-point/_questions [{:knowledge-point/id #uuid "37e05385-7cb6-5f21-b0d8-a7641d912d5b" :knowledge-point/title "Calculating the Derivative of an Inverse Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edeb81d-4a45-5230-af19-c187d88f6700" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(4)" :db/id #edb/ref 17592186271470} {:answer/id #uuid "1af17e5d-f5c2-5ae3-9aa5-83317a4209fc" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(6)" :db/id #edb/ref 17592186271471} {:answer/id #uuid "3a6414a5-704c-51c0-968c-067749ea5450" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186271472} {:answer/id #uuid "f887e6d6-0d23-532e-b4b9-e04e44828d96" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271473} {:answer/id #uuid "849cac87-e8c0-5aa3-82ef-19186adcdd34" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(6)" :db/id #edb/ref 17592186271474}] :answer-field/correct {:answer/id #uuid "f887e6d6-0d23-532e-b4b9-e04e44828d96" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271473} :answer-field/id #uuid "8fa36bee-acf3-51d5-a3d4-30501224c41a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274572}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "53a3c182-13e5-5b44-8bb1-0f1776df69ca" :question/math-academy-id "q-2292" :question/problem "Consider the function $f(x)=x+\\operatorname{cos}x$ and the point $P(0,1)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$  calculate ${({f}^{-1})}^{'}(1).$" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(0,1).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =x+\\operatorname{cos}x \\\\ {f}^{'}(x) & =1-\\operatorname{sin}x \\\\ {f}^{'}(0) & =1\\end{aligned}\\end{aligned}\n$$\n\nSince $(0,1)$ lies on $y=f(x),$ we know that the corresponding point $(1,0)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{({f}^{-1})}^{'}(1) & =\\frac{1}{{f}^{'}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{'}(0)} \\\\  & =\\frac{1}{1} \\\\  & =1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258985 :knowledge-point/_questions [{:knowledge-point/id #uuid "19936679-c713-564f-8e88-4f4557fd7607" :knowledge-point/title "Simplifying a Complex Rational Expression Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1639212-f9d1-5b2d-b869-13305309b6a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{sec}\\theta \\operatorname{csc}\\theta)" :db/id #edb/ref 17592186271513} {:answer/id #uuid "94ec12c9-b1f8-59b6-a577-6451dd5004e3" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\operatorname{sec}\\theta \\operatorname{csc}\\theta)" :db/id #edb/ref 17592186271514} {:answer/id #uuid "1706f4a6-a186-527e-ab54-805cdeab50d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}\\theta \\operatorname{csc}\\theta" :db/id #edb/ref 17592186271515} {:answer/id #uuid "f1a842d6-f3b0-5210-b636-5131a0c80b2b" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\operatorname{sec}\\theta \\operatorname{csc}\\theta)" :db/id #edb/ref 17592186271516} {:answer/id #uuid "55fa92f8-b8ad-570c-a79c-1b4c1cfe6940" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\operatorname{sec}\\theta \\operatorname{csc}\\theta)" :db/id #edb/ref 17592186271517}] :answer-field/correct {:answer/id #uuid "1706f4a6-a186-527e-ab54-805cdeab50d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}\\theta \\operatorname{csc}\\theta" :db/id #edb/ref 17592186271515} :answer-field/id #uuid "4c6531a5-2819-50a9-879a-714ecc1fc6a9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274580}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4f512afc-cbd8-5308-aa66-6e7d1c3a8838" :question/math-academy-id "q-24084" :question/problem "Simplify the expression $\\frac{\\operatorname{sec}\\theta +\\operatorname{csc}\\theta }{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }.$" :question/worked-solution "First, let's interpret the fraction as a division:\n\n$$\n\\frac{\\operatorname{sec}\\theta +\\operatorname{csc}\\theta }{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }=(\\operatorname{sec}\\theta +\\operatorname{csc}\\theta )÷(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta )\n$$\n\nThen, we recall the identities $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta }$ and $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ and we substitute them into the above expression:\n\n$$\n\\begin{aligned}(\\operatorname{sec}\\theta +\\operatorname{csc}\\theta )÷(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta ) & =(\\frac{1}{\\operatorname{cos}\\theta }+\\frac{1}{\\operatorname{sin}\\theta })÷(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta ) \\\\  & =(\\frac{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta })÷(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta )\\end{aligned}\n$$\n\nFinally, we turn the division into multiplication, and simplify the expression as much as possible:\n\n$$\n\\begin{aligned}(\\frac{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta })÷(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta ) & =(\\frac{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta })\\cdot (\\frac{1}{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }) \\\\  & =\\frac{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta (\\operatorname{sin}\\theta +\\operatorname{cos}\\theta )} \\\\  & =\\frac{\\cancel{(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta )}}{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta \\cancel{(\\operatorname{sin}\\theta +\\operatorname{cos}\\theta )}} \\\\  & =\\frac{1}{\\operatorname{cos}\\theta \\cdot \\operatorname{sin}\\theta } \\\\  & =\\frac{1}{\\operatorname{cos}\\theta }\\cdot \\frac{1}{\\operatorname{sin}\\theta } \\\\  & =\\operatorname{sec}\\theta \\operatorname{csc}\\theta \\end{aligned}\n$$\n\nTherefore, $\\frac{\\operatorname{sec}\\theta +\\operatorname{csc}\\theta }{\\operatorname{sin}\\theta +\\operatorname{cos}\\theta }=\\operatorname{sec}\\theta \\operatorname{csc}\\theta $"}] [{:db/id #edb/ref 17592186259016 :knowledge-point/_questions [{:knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c78440b-a32a-5641-b555-ea5cf88f9d45" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186271537} {:answer/id #uuid "ec52f119-42fa-5e47-98b4-e31d69cb0218" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186271538} {:answer/id #uuid "ba5c478f-18ae-5573-b357-b4e48d3f8d35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186271539} {:answer/id #uuid "766f1ef2-a915-58de-abf3-5173f432c1c4" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186271540} {:answer/id #uuid "9a8ca2bf-fa43-57b4-9799-0fe9522b72ba" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}})" :db/id #edb/ref 17592186271541}] :answer-field/correct {:answer/id #uuid "ba5c478f-18ae-5573-b357-b4e48d3f8d35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186271539} :answer-field/id #uuid "3c24486c-a6f6-5dae-abc7-c270b9b31747" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274585}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3e90e8e6-2a76-510f-8d0b-5bd2dd5c7422" :question/math-academy-id "q-2481" :question/problem "Find ${f}^{'}(x)$ for $f(x)={arcsin}^{3}(2x).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}[{arcsin}^{3}(2x)] \\\\  & =3{arcsin}^{2}(2x)\\cdot \\frac{\\text{d}}{\\text{d}x}[\\operatorname{arcsin}(2x)] \\\\  & =3{arcsin}^{2}(2x)\\cdot [\\frac{1}{\\sqrt{1-(2x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x)] \\\\  & =3{arcsin}^{2}(2x)\\cdot [\\frac{1}{\\sqrt{1-(2x)^{2}}}\\cdot 2] \\\\  & =3{arcsin}^{2}(2x)\\cdot \\frac{2}{\\sqrt{1-4{x}^{2}}} \\\\  & =\\frac{6{arcsin}^{2}(2x)}{\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259060 :knowledge-point/_questions [{:knowledge-point/id #uuid "d916584b-c94e-557f-a438-f0464c1cea87" :knowledge-point/title "Finding the Intersection of Three Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3e9761f-25d0-5618-9539-6bd9adff0970" :answer/type {:db/ident :answer.type/math} :answer/value "-3<x<-1" :db/id #edb/ref 17592186271567} {:answer/id #uuid "471208c7-4466-5e68-919b-6a5609b23a1d" :answer/type {:db/ident :answer.type/math} :answer/value "− 4 < x < 0" :db/id #edb/ref 17592186271568} {:answer/id #uuid "1a96a7e6-f419-5e1e-b4a5-81bb85370717" :answer/type {:db/ident :answer.type/math} :answer/value "x < − 4" :db/id #edb/ref 17592186271569} {:answer/id #uuid "ead2f876-7635-5188-9b2f-ef9452bfc0d0" :answer/type {:db/ident :answer.type/math} :answer/value "(− 3, 5)" :db/id #edb/ref 17592186271570} {:answer/id #uuid "21045970-9f6a-5998-85ab-4c35f7879045" :answer/type {:db/ident :answer.type/math} :answer/value "(6, 3]" :db/id #edb/ref 17592186271571}] :answer-field/correct {:answer/id #uuid "a3e9761f-25d0-5618-9539-6bd9adff0970" :answer/type {:db/ident :answer.type/math} :answer/value "-3<x<-1" :db/id #edb/ref 17592186271567} :answer-field/id #uuid "7dee6319-c176-537d-887b-77243f1fd9c3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274591}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "322dbd6a-59b8-502c-b95f-dcd63b64b6ec" :question/math-academy-id "q-25893" :question/problem "Which of the following inequalities corresponds to the intersection $(-\\infty ,-1)\\cap (-4,\\infty )\\cap (-3,-1]?$" :question/worked-solution "To find the intersection of the intervals, we graph the separate intervals on a number line and find where they overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1dd185a59332b8a7d9c15b1de1fb50c046ce35c5df0cb3b23b75919c3f36682c.png)\n\nThus, $(-\\infty ,-1)\\cap (-4,\\infty )\\cap (-3,-1]=(-3,-1).$ This corresponds to the inequality\n\n$$\n-3<x<-1.\n$$"}] [{:db/id #edb/ref 17592186259158 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e22b29da-5cad-50a0-9730-5f8246b682d1" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186271632} {:answer/id #uuid "27bf1ae6-6c90-5f70-bf94-f0f943e3871e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271633} {:answer/id #uuid "c32a7723-855d-579e-b6aa-8237f0f8e3f1" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186271634} {:answer/id #uuid "653e6fc4-61c6-59ab-9fbe-72a17298b5f2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271635} {:answer/id #uuid "1f1b6736-c640-5019-8641-58db88e90d5b" :answer/type {:db/ident :answer.type/math} :answer/value "− 3" :db/id #edb/ref 17592186271636}] :answer-field/correct {:answer/id #uuid "e22b29da-5cad-50a0-9730-5f8246b682d1" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186271632} :answer-field/id #uuid "a528e63a-22b1-5bd9-8aec-5bf0610b6164" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274604}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5075616b-68b7-52dc-b8e0-d5d419a28444" :question/math-academy-id "q-27541" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/41875c5ab1216b78760c1c2dddec6ffc31bfd57d2da27f4797b1190dbf4af709.png)\n\nThe graph above shows the curve $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3.$ Hence, $c=-3.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-3 & =y \\\\ k{(\\frac{1}{2})}^{0}-3 & =1 \\\\ k-3 & =1 \\\\ k & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=4-(-3)=7.\n$$\n\nThe equation of the curve is $y=4{(\\frac{1}{2})}^{x}-3.$"}] [{:db/id #edb/ref 17592186259421 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2efa47b3-0388-541f-b4b7-dc4a4e609ed1" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x} + (x^{4})/(\\ln 4) − 2x^{2} + C" :db/id #edb/ref 17592186271749} {:answer/id #uuid "01de2d51-74a8-5fe1-b76a-25b38f8e5af5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{8}^{x}}{\\operatorname{ln}8}+3\\operatorname{ln}|x|+C" :db/id #edb/ref 17592186271750} {:answer/id #uuid "9ffbb48d-9e67-51e3-b2c9-7e12513bc7d2" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{x} + (4^{x})/(\\ln 4) − x^{2} + C" :db/id #edb/ref 17592186271751} {:answer/id #uuid "4dfdc688-cd45-56ff-b1b8-8a1de50e991c" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x} + (4^{x})/(\\ln 4) − x^{2} + C" :db/id #edb/ref 17592186271752} {:answer/id #uuid "fcffa9ec-9d95-50b6-a792-deaa5e72dde1" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{x} + 4^{x}\\ln 4 − (x^{2})/(2) + C" :db/id #edb/ref 17592186271753}] :answer-field/correct {:answer/id #uuid "01de2d51-74a8-5fe1-b76a-25b38f8e5af5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{8}^{x}}{\\operatorname{ln}8}+3\\operatorname{ln}|x|+C" :db/id #edb/ref 17592186271750} :answer-field/id #uuid "09136c24-b3f2-57bd-ba90-acf78702cad6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274629}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8e8b9317-60d7-599c-a6b0-5d0715ef2392" :question/math-academy-id "q-31261" :question/problem "$\\int ({e}^{x}+{8}^{x}+\\frac{3}{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int ({e}^{x}+{8}^{x}+\\frac{3}{x})\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x+\\int {8}^{x}\\,\\text{d}x+\\int \\frac{3}{x}\\,\\text{d}x \\\\  & ={e}^{x}+\\frac{{8}^{x}}{\\operatorname{ln}8}+3\\operatorname{ln}|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259463 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a36061a-89e5-5d38-8a4d-4753f2e1e551" :answer/type {:db/ident :answer.type/math} :answer/value "9t^2+12t-5" :db/id #edb/ref 17592186259465}] :answer-field/correct {:answer/id #uuid "2a36061a-89e5-5d38-8a4d-4753f2e1e551" :answer/type {:db/ident :answer.type/math} :answer/value "9t^2+12t-5" :db/id #edb/ref 17592186259465} :answer-field/id #uuid "f8670335-24d0-58b8-bdc3-947c6ccc38cf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259464}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f16010a1-03ac-5174-a9bf-0b8620798263" :question/math-academy-id "q-315534" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=3{t}^{3}+6{t}^{2}-5t.$ Calculate the acceleration $a$ of the particle at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+6{t}^{2}-5t) \\\\  & =9{t}^{2}+12t-5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259507 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bdf05f2-2d0a-5785-8632-d7bb1bd2cd88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}3" :db/id #edb/ref 17592186259509}] :answer-field/correct {:answer/id #uuid "5bdf05f2-2d0a-5785-8632-d7bb1bd2cd88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}3" :db/id #edb/ref 17592186259509} :answer-field/id #uuid "42e20265-3fc6-5ad1-b14c-f0c396b19a7f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259508}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b0bffb42-be09-55cb-8b31-881c330b35e8" :question/math-academy-id "q-316010" :question/problem "Evaluate ${\\int }_{1}^{32}\\frac{1}{\\sqrt[5]{{x}^{2}}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{32}\\frac{1}{\\sqrt[5]{{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{32}\\frac{1}{\\sqrt[5]{{x}^{2}}}\\,\\text{d}x & ={\\int }_{1}^{32}{x}^{-2/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-2/5+1}}{(-\\frac{2}{5}+1)}{|}_{1}^{32} \\\\  & =\\frac{5}{3}\\,{x}^{3/5}{|}_{1}^{32} \\\\  & =\\frac{5}{3}\\,{(\\sqrt[5]{x})}^{3}{|}_{1}^{32} \\\\  & =\\frac{5}{3}({(\\sqrt[5]{32})}^{3}-{(\\sqrt[5]{1})}^{3}) \\\\  & =\\frac{5}{3}({2}^{3}-1) \\\\  & =\\frac{5}{3}\\cdot 7 \\\\  & =\\frac{35}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259510 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d4230a-c6eb-5dc5-ad07-58e762322846" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186259512}] :answer-field/correct {:answer/id #uuid "11d4230a-c6eb-5dc5-ad07-58e762322846" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186259512} :answer-field/id #uuid "c6060556-4f2f-528e-867a-92246354b974" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259511} {:answer-field/choices [{:answer/id #uuid "34f275eb-583c-59aa-91f1-acad4dd146e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259514}] :answer-field/correct {:answer/id #uuid "34f275eb-583c-59aa-91f1-acad4dd146e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259514} :answer-field/id #uuid "af6761b6-ac37-533b-acfa-de643b510281" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d6fb64ab-22ee-5c67-af5e-8451c17bd02b" :question/math-academy-id "q-316031" :question/problem "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)=\\frac{\\operatorname{ln}(t+1)+6}{{t}^{2}+1}$, where $t$ is the time, measured in seconds. Find the position ${s}_{0}$ and velocity ${v}_{0}$ of the particle at the initial moment of time $t=0\\,\\text{s}.$\n\n${s}_{0}=$\n{{field-1}}$\\text{m}\\,\\text{and}\\,$\n${v}_{0}=$\n{{field-2}}$\\text{m/s}$" :question/worked-solution "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)=\\frac{\\operatorname{ln}(t+1)+6}{{t}^{2}+1}:$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & =\\frac{\\operatorname{ln}(0+1)+6}{{0}^{2}+1} \\\\  & =6\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\operatorname{ln}(t+1)+6}{{t}^{2}+1}) \\\\  & =\\frac{\\frac{1}{t+1}\\cdot ({t}^{2}+1)-(\\operatorname{ln}(t+1)+6)\\cdot 2t}{({t}^{2}+1)^{2}} \\\\  & =\\frac{{t}^{2}+1-2t(t+1)(\\operatorname{ln}(t+1)+6)}{(t+1)({t}^{2}+1)^{2}}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =\\frac{{0}^{2}+1-2(0)(0+1)(\\operatorname{ln}(0+1)+6)}{(0+1)({0}^{2}+1)^{2}} \\\\  & =\\frac{1}{1\\cdot {1}^{2}} \\\\  & =1\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259515 :knowledge-point/_questions [{:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2" :knowledge-point/title "Differentiating an Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6c84af9-70a9-5cf3-a37a-806f876094c5" :answer/type {:db/ident :answer.type/math} :answer/value "− (3)/(8(1 + x^{2}))" :db/id #edb/ref 17592186271814} {:answer/id #uuid "528c789d-e0f8-53f6-a92d-dac1b47cff5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{-1+2x-2{x}^{2}}" :db/id #edb/ref 17592186271815} {:answer/id #uuid "3a562b06-1920-5e76-93c6-4cffd1ae1e88" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(8(1 − x^{2}))" :db/id #edb/ref 17592186271816} {:answer/id #uuid "7536f167-fe18-57f5-9ea3-09dc9b7ac664" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(8(1 + x^{2}))" :db/id #edb/ref 17592186271817} {:answer/id #uuid "abef41c8-8002-586a-9413-fb36fda0513f" :answer/type {:db/ident :answer.type/math} :answer/value "− (25)/(10x − 13 − 50x^{2})" :db/id #edb/ref 17592186271818}] :answer-field/correct {:answer/id #uuid "528c789d-e0f8-53f6-a92d-dac1b47cff5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{-1+2x-2{x}^{2}}" :db/id #edb/ref 17592186271815} :answer-field/id #uuid "f109a719-7c11-5444-b72d-ae95911346d3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274642}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9aa198d8-6f8b-5468-8360-5a393ea89347" :question/math-academy-id "q-31712" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=3-6\\operatorname{arctan}(2x-1).$" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3-6\\operatorname{arctan}(2x-1)) \\\\  & =0-6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}(2x-1)) \\\\  & =0-6\\cdot \\frac{1}{1+(2x-1)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x-1) \\\\  & =0-6\\cdot \\frac{1}{1+(2x-1)^{2}}\\cdot 2 \\\\  & =0-6\\cdot \\frac{2}{1+(2x-1)^{2}} \\\\  & =-\\frac{12}{2+4{x}^{2}-4x} \\\\  & =\\frac{6}{-1+2x-2{x}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259552 :knowledge-point/_questions [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554}] :answer-field/correct {:answer/id #uuid "95c00f40-1fa1-5066-bc6d-a527f0363ea4" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186259554} :answer-field/id #uuid "4df4fbd9-c930-5449-b653-e838fec21002" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259553}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "09b04830-3363-5cf1-8509-ae768a428aac" :question/math-academy-id "q-320077" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/07386bb0e42ae051fadc55f3949150582f31df36b28acee666c1e9583c5cbbf1.png)\n\nWhat complex number is represented in the Argand diagram above? Use $i$ to denote the imaginary unit.\n\n$z=$\n{{field-1}}" :question/worked-solution "The coordinates of the point are $(0,-6).$\n\n- The real part of this complex number is $x=0,$ and\n\n- the imaginary part is $y=-6.$\n\nTherefore, the number depicted is $z=0-6i,$ which can be simplified to $z=-6i.$"}] [{:db/id #edb/ref 17592186259555 :knowledge-point/_questions [{:knowledge-point/id #uuid "79c85169-b2cd-5195-a225-395f470200b5" :knowledge-point/title "Identifying a Complex Number With No Real or No Imaginary Part Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d68337-8cd6-5ed5-82a3-0b8a8a0d951f" :answer/type {:db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186259557}] :answer-field/correct {:answer/id #uuid "08d68337-8cd6-5ed5-82a3-0b8a8a0d951f" :answer/type {:db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186259557} :answer-field/id #uuid "e6207bf4-f866-5a9c-b6ff-549730f55e47" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259556}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "164ede55-0c95-506b-b8ef-76149532d23c" :question/math-academy-id "q-320079" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/29ec09bdf2f2781a4f7ebfb09970d159c431498d7cfcc5d862630a37d386f4e7.png)\n\nWhat complex number is represented in the Argand diagram above? Use $i$ to denote the imaginary unit.\n\n$z=$\n{{field-1}}" :question/worked-solution "The coordinates of the point are $(0,8).$\n\n- The real part of this complex number is $x=0,$ and\n\n- the imaginary part is $y=8.$\n\nTherefore, the number depicted is $z=0+8i,$ which can be simplified to $z=8i.$"}] [{:db/id #edb/ref 17592186259558 :knowledge-point/_questions [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "407fd3df-d3d3-5c46-a5b2-64c625a711a8" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186259560}] :answer-field/correct {:answer/id #uuid "407fd3df-d3d3-5c46-a5b2-64c625a711a8" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186259560} :answer-field/id #uuid "1fefbc6f-1f19-515b-82ae-260c313e48df" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259559} {:answer-field/choices [{:answer/id #uuid "69f31a85-7a99-5202-8211-d6e74c6cb923" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259562}] :answer-field/correct {:answer/id #uuid "69f31a85-7a99-5202-8211-d6e74c6cb923" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259562} :answer-field/id #uuid "294c3075-7bff-58e6-ac44-1e6f9aa1e66d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259561}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0425acaa-1c0b-5694-b107-74b9601dd896" :question/math-academy-id "q-320153" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/0b8cbae8855b443f0f06abd22ecbbf6336f0b5494e4a2ceb1b42ea77abfbbf15.png)\n\nExpress the complex number represented in the Argand diagram above in the form $bi+a,$ where $a$ and $b$ are real numbers.\n\n$z=$\n{{field-1}}$i\\,+$\n{{field-2}}" :question/worked-solution "The coordinates of the point are $(1,-5).$\n\n- The real part of this complex number is $x=1,$ and\n\n- the imaginary part is $y=-5.$\n\nTherefore, the number depicted is $z=1-5i.$ Finally, notice that \n\n$$\n\\begin{aligned}z & =1-5i \\\\  & =-5\\,i+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259563 :knowledge-point/_questions [{:knowledge-point/id #uuid "208b226a-cdb5-575d-bc37-45b1ea33e40b" :knowledge-point/title "Identifying a Complex Number Represented by an Argand Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eadc3afc-965d-5497-a19e-5f6d336424a1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186259565}] :answer-field/correct {:answer/id #uuid "eadc3afc-965d-5497-a19e-5f6d336424a1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186259565} :answer-field/id #uuid "ea0da6aa-3703-5dc3-bd74-3a37024d0860" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259564} {:answer-field/choices [{:answer/id #uuid "9664be6e-b39e-54ab-a099-49eb1d97c714" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186259567}] :answer-field/correct {:answer/id #uuid "9664be6e-b39e-54ab-a099-49eb1d97c714" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186259567} :answer-field/id #uuid "af1ea0c3-ae93-594e-b961-0252edf69b5c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259566}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4c8480d-b5e8-5a54-886d-eb152592bdcc" :question/math-academy-id "q-320156" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/78f2b0b5784aee7237ad7a1912bf54f5371ec88fc504cee594618208f79b499b.png)\n\nExpress the complex number represented in the Argand diagram above in the form $bi+a,$ where $a$ and $b$ are real numbers.\n\n$z=$\n{{field-1}}$i\\,-$\n{{field-2}}" :question/worked-solution "The coordinates of the point are $(-6,3).$\n\n- The real part of this complex number is $x=-6,$ and\n\n- the imaginary part is $y=3.$\n\nTherefore, the number depicted is $z=-6+3i.$ Finally, notice that \n\n$$\n\\begin{aligned}z & =-6+3i \\\\  & =3\\,i-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259754 :knowledge-point/_questions [{:knowledge-point/id #uuid "27ed79c0-3efe-581a-807b-3327b8fd9a4a" :knowledge-point/title "Rewriting a Trigonometric Equation Using an Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20347862-221b-5860-8592-68978e928244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186259756}] :answer-field/correct {:answer/id #uuid "20347862-221b-5860-8592-68978e928244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186259756} :answer-field/id #uuid "0c403739-b544-5818-95a2-e4df38d67d03" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259755}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "930639cf-caf6-5e8d-b822-7d58d5edf090" :question/math-academy-id "q-334343" :question/problem "Given that $3\\operatorname{sec}\\theta =10\\operatorname{csc}\\theta ,$ calculate $\\operatorname{tan}\\theta .$\n\n$\\operatorname{tan}\\theta =$\n{{field-1}}" :question/worked-solution "First, we recall the identities $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta }$ and $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ and we substitute them into the given expression:\n\n$$\n\\begin{aligned}3\\operatorname{sec}\\theta  & =10\\operatorname{csc}\\theta  \\\\ 3\\cdot \\frac{1}{\\operatorname{cos}\\theta } & =10\\cdot \\frac{1}{\\operatorname{sin}\\theta } \\\\ \\frac{3}{\\operatorname{cos}\\theta } & =\\frac{10}{\\operatorname{sin}\\theta }\\end{aligned}\n$$\n\nTo write the last equation in terms of $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta }$ only, we multiply both sides of the equation by $\\operatorname{sin}\\theta ,$ and apply the above identity, as follows:\n\n$$\n\\begin{aligned}\\frac{3}{\\operatorname{cos}\\theta } & =\\frac{10}{\\operatorname{sin}\\theta } \\\\ \\frac{3}{\\operatorname{cos}\\theta }\\cdot \\operatorname{sin}\\theta  & =\\frac{10}{\\operatorname{sin}\\theta }\\cdot \\operatorname{sin}\\theta  \\\\ \\frac{3\\cdot \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =\\frac{10\\cdot \\operatorname{sin}\\theta }{\\operatorname{sin}\\theta } \\\\ 3\\cdot \\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta } & =10 \\\\ 3\\operatorname{tan}\\theta  & =10\\end{aligned}\n$$\n\nFinally, we isolate $\\operatorname{tan}\\theta $ by dividing both sides of the equation by $3:$\n\n$$\n\\begin{aligned}\\frac{3\\operatorname{tan}\\theta }{3} & =\\frac{10}{3} \\\\ \\operatorname{tan}\\theta  & =\\frac{10}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259775 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441ce2f1-8463-59ab-9df1-c1090a81dfa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln5}2" :db/id #edb/ref 17592186259777}] :answer-field/correct {:answer/id #uuid "441ce2f1-8463-59ab-9df1-c1090a81dfa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln5}2" :db/id #edb/ref 17592186259777} :answer-field/id #uuid "68586d47-416c-5b02-a214-0b04cc3eb25e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "807afca8-b2c0-59ad-99e9-bb1c9df82ff6" :question/math-academy-id "q-336927" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5} & ={lim}_{x\\to 0}\\frac{{[{5}^{x}-1-(\\operatorname{ln}5)x]}^{'}}{[{x}^{2}\\operatorname{ln}5]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\operatorname{ln}5)\\cdot {5}^{x}-(\\operatorname{ln}5)}{2\\operatorname{ln}5\\cdot x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\text{ }\\operatorname{ln}5} & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{[{5}^{x}-1]}^{'}}{[x]^{'}} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{(\\operatorname{ln}5){5}^{x}}{1} \\\\  & =\\frac{1}{2}\\,(\\operatorname{ln}5){e}^{0} \\\\  & =\\frac{\\operatorname{ln}5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259814 :knowledge-point/_questions [{:knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1ac8c16-0300-57ea-be9d-c169520d5e13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259816}] :answer-field/correct {:answer/id #uuid "c1ac8c16-0300-57ea-be9d-c169520d5e13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259816} :answer-field/id #uuid "3bc45c87-8b02-5cbf-82c3-75765280b0a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259815}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c474b397-28c9-5a8f-b7cf-50951877499f" :question/math-academy-id "q-338473" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 2}\\frac{\\sqrt{2x}-2}{x-2}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{2x}-2}{x-2} & =\\frac{\\sqrt{2(2)}-2}{2-2}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{2x}-2}{x-2} & ={lim}_{x\\to 2}\\frac{(\\sqrt{2x}-2)(\\sqrt{2x}+2)}{(x-2)(\\sqrt{2x}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{{(\\sqrt{2x})}^{2}-{2}^{2}}{(x-2)(\\sqrt{2x}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{2x-4}{(x-2)(\\sqrt{2x}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{2(x-2)}{(x-2)(\\sqrt{2x}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{2\\cancel{(x-2)}}{\\cancel{(x-2)}(\\sqrt{2x}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{2}{\\sqrt{2x}+2} \\\\  & =\\frac{2}{\\sqrt{2(2)}+2} \\\\  & =\\frac{2}{\\sqrt{4}+2} \\\\  & =\\frac{2}{4} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259820 :knowledge-point/_questions [{:knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a56ba9-d5c8-5edf-b051-a0fcda4a8487" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259822}] :answer-field/correct {:answer/id #uuid "a7a56ba9-d5c8-5edf-b051-a0fcda4a8487" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259822} :answer-field/id #uuid "d824f055-2a42-57ab-b57c-c2792c42c0d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259821}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aa14dfc7-bd15-596f-a1c8-753114c04592" :question/math-academy-id "q-338487" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 2}\\frac{\\sqrt{3x-2}-\\sqrt{x+2}}{x-2}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{3x-2}-\\sqrt{x+2}}{x-2} & =\\frac{\\sqrt{3(2)-2}-\\sqrt{2+2}}{2-2}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{3x-2}-\\sqrt{x+2}}{x-2} & ={lim}_{x\\to 2}\\frac{(\\sqrt{3x-2}-\\sqrt{x+2})(\\sqrt{3x-2}+\\sqrt{x+2})}{(x-2)(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{(\\sqrt{3x-2})^{2}-(\\sqrt{x+2})^{2}}{(x-2)(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{(3x-2)-(x+2)}{(x-2)(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{2x-4}{(x-2)(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{2(x-2)}{(x-2)(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{2\\cancel{(x-2)}}{\\cancel{(x-2)}(\\sqrt{3x-2}+\\sqrt{x+2})} \\\\  & ={lim}_{x\\to 2}\\frac{2}{\\sqrt{3x-2}+\\sqrt{x+2}} \\\\  & =\\frac{2}{\\sqrt{3(2)-2}+\\sqrt{2+2}} \\\\  & =\\frac{2}{2+2} \\\\  & =\\frac{2}{4} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259832 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4772e15f-3158-59c7-83b6-3713f61f26b1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259834}] :answer-field/correct {:answer/id #uuid "4772e15f-3158-59c7-83b6-3713f61f26b1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259834} :answer-field/id #uuid "a4b9627a-e7d2-5f0e-a6ad-61c7f1aa6553" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259833}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fab1224a-731f-5aa7-8ae2-ee992a17f981" :question/math-academy-id "q-339133" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,{1}^{-}}\\frac{25\\operatorname{arccos}(x)}{{x}^{2}+\\pi }=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arccos}(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/85a182aabfe64c27eaafde94e3bdbede9409b02cfd87395cb2fc5543b09c4e05.png)\n\nThe domain of $\\operatorname{arccos}(x)$ is $x\\in [-1,1].$ \n\nNow, substituting $x=1$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}\\frac{25\\operatorname{arccos}(x)}{{x}^{2}+\\pi } & =\\frac{25\\operatorname{arccos}(1)}{{1}^{2}+\\pi } \\\\  & =\\frac{25\\cdot 0}{1+\\pi } \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259835 :knowledge-point/_questions [{:knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5cac94-0da9-5a00-a571-d2ac997c806a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259837}] :answer-field/correct {:answer/id #uuid "0c5cac94-0da9-5a00-a571-d2ac997c806a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259837} :answer-field/id #uuid "6954fc0f-4cd6-5486-b67a-aa9af0bf66de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259836}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "130e1293-e299-5dab-8944-efcd214f6324" :question/math-academy-id "q-339377" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }\\frac{8}{\\pi }(\\operatorname{arctan}(5-x))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}(5-x):$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ce2078de99b2c037b0ab6d5c5dcd4dab1e8aa7005417d87ca83176bf197fd5dc.png)\n\nThe domain of $\\operatorname{arctan}(5-x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}(5-x)=\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{8}{\\pi }(\\operatorname{arctan}(5-x))=\\frac{8}{\\pi }\\cdot (\\frac{\\pi }{2})=4.\n$$"}] [{:db/id #edb/ref 17592186259841 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4c23c77-cb0b-559b-8f14-991329134687" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259843}] :answer-field/correct {:answer/id #uuid "b4c23c77-cb0b-559b-8f14-991329134687" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259843} :answer-field/id #uuid "8617f523-d884-5387-8b52-b9a7de42f133" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259842}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "286490e2-c616-59ab-b79b-2b35e220b7f8" :question/math-academy-id "q-339489" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,1}sin\\,(\\operatorname{arctan}(x))=$\n{{field-1}}" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/68f1ebd0457e0c127f8ed6c979feba58196aa6bb43d97d211efa9b39bc33f637.png)\n\nThe domain of $\\operatorname{arctan}(x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=1$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}sin\\,(\\operatorname{arctan}(x)) & =sin\\,(\\operatorname{arctan}(1)) \\\\  & =sin\\,(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260001 :knowledge-point/_questions [{:knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b15f869-2088-528d-a30f-f089d43136e3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186260003}] :answer-field/correct {:answer/id #uuid "1b15f869-2088-528d-a30f-f089d43136e3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186260003} :answer-field/id #uuid "84398312-46fa-5216-bccf-d7c099f1aa10" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260002}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "00faca6d-bf67-58f3-b4d7-d97abcc11999" :question/math-academy-id "q-343227" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }\\frac{5}{2\\pi }(\\operatorname{arctan}(2x+7))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}(2x+7):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/371cbb841c67494626038fc93747a1d0a2b2245f422364911f1a859f4711868d.png)\n\nThe domain of $\\operatorname{arctan}(2x+7)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}(2x+7)=-\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{5}{2\\pi }(\\operatorname{arctan}(2x+7))=\\frac{5}{2\\pi }\\cdot (-\\frac{\\pi }{2})=-\\frac{5}{4}.\n$$"}] [{:db/id #edb/ref 17592186260016 :knowledge-point/_questions [{:knowledge-point/id #uuid "20b289d4-96a7-5d1b-9714-6afabab4804d" :knowledge-point/title "Further Determining Rates of Change in Geometrical Settings"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e1f598f-1962-53d9-940a-781cb9cb4e4c" :answer/type {:db/ident :answer.type/math} :answer/value "324\\pi" :db/id #edb/ref 17592186260018}] :answer-field/correct {:answer/id #uuid "9e1f598f-1962-53d9-940a-781cb9cb4e4c" :answer/type {:db/ident :answer.type/math} :answer/value "324\\pi" :db/id #edb/ref 17592186260018} :answer-field/id #uuid "1dd944e5-ad59-555d-bb0c-b6c86234f33a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260017}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a84a074e-711b-5690-83be-0cf8858c8ef7" :question/math-academy-id "q-343501" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ed912b9c43e72f3c85f8f2f64b4ac0e760ab69b821462201584ba3111e97f913.png)\n\nA spherical balloon is being inflated so that its volume is increasing. Find the instantaneous rate at which the volume of the balloon is changing with respect to the radius at the moment when the diameter of the balloon is equal to $18\\,\\text{cm}.$\n\nThe instantaneous rate of change at the moment when the diameter is $18$ centimeters is equal to\n{{field-1}} ${\\text{cm}}^{3}/\\text{cm}.$" :question/worked-solution "Since we are given that the diameter of the spherical balloon is $18\\,\\text{cm}$, its radius $r$ is $9\\,\\text{cm}.$ Now, the volume of a sphere with radius $r$ is given by \n\n$$\nV=V(r)=\\frac{4}{3}\\pi {r}^{3}.\n$$\n\nTaking the derivative, the rate of change of $V(r)$ with respect to $r$ is \n\n$$\n\\begin{aligned}{V}^{'}(r) & =\\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\  & =\\frac{4}{3}\\pi (3{r}^{2}) \\\\  & =4\\pi {r}^{2},\\end{aligned}\n$$\n\nand evaluating at $r=9$ gives\n\n$$\n{V}^{'}(9)=4\\pi (9)^{2}=324\\pi .\n$$\n\nTherefore, the instantaneous rate of change at which the volume of the balloon is increasing when the diameter is $18\\,\\text{cm}$ is $324\\pi \\,{\\text{cm}}^{3}/\\text{cm}.$"}] [{:db/id #edb/ref 17592186260019 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59942e72-8f94-5727-92fc-f92352be456c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{({x}^{2}+1)^{2}}" :db/id #edb/ref 17592186260021}] :answer-field/correct {:answer/id #uuid "59942e72-8f94-5727-92fc-f92352be456c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{({x}^{2}+1)^{2}}" :db/id #edb/ref 17592186260021} :answer-field/id #uuid "a21c469f-2523-53c9-aeed-cfea4c47d98c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260020}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c9e18812-d532-537f-a281-49bc3a0ec990" :question/math-academy-id "q-344032" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}(3{x}^{2})}{{x}^{2}+1}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{6x}{({x}^{2}+1)(1+9{x}^{4})}\\,-$\n{{field-1}}\n$\\operatorname{arctan}(3{x}^{2})$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}x,$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}(3{x}^{2})}{{x}^{2}+1}) \\\\  & =\\frac{(({x}^{2}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}(3{x}^{2}))-\\operatorname{arctan}(3{x}^{2})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+1))}{({x}^{2}+1)^{2}} \\\\  & =\\frac{(({x}^{2}+1)\\cdot \\frac{1}{1+(3{x}^{2})^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(3{x}^{2})-\\operatorname{arctan}(3{x}^{2})\\cdot 2x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{(\\frac{({x}^{2}+1)(6x)}{1+9{x}^{4}}-2x\\operatorname{arctan}(3{x}^{2}))}{({x}^{2}+1)^{2}} \\\\  & =\\frac{6x}{({x}^{2}+1)(1+9{x}^{4})}-\\frac{2x}{({x}^{2}+1)^{2}}\\,\\operatorname{arctan}(3{x}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260040 :knowledge-point/_questions [{:knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8336c47c-020d-51d4-8e84-c0bfe61d4c38" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260042}] :answer-field/correct {:answer/id #uuid "8336c47c-020d-51d4-8e84-c0bfe61d4c38" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260042} :answer-field/id #uuid "c5c3d611-247b-5918-9040-ec4d0d2fa62d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260041}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2330acf3-8aaf-561f-b92b-c2c1d30163b7" :question/math-academy-id "q-344536" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-\\operatorname{arctan}(x+1))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}(x+1):$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4d81187377609f2cc79f2f972b1416a00f854d8c7a72731eb306aaa17d9f7339.png)\n\nThe domain of $\\operatorname{arctan}(x+1)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}(x+1)=-\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-\\operatorname{arctan}(x+1))=\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-(-\\frac{\\pi }{2}))=2.\n$$"}] [{:db/id #edb/ref 17592186260043 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51e98697-1c8b-5864-b131-8c913f48caed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac1{\\sqrt3}" :db/id #edb/ref 17592186260045}] :answer-field/correct {:answer/id #uuid "51e98697-1c8b-5864-b131-8c913f48caed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac1{\\sqrt3}" :db/id #edb/ref 17592186260045} :answer-field/id #uuid "ae9ef7aa-ab1f-5000-9a38-e17f97641b77" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260044}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b69b2429-02ac-54fc-89ef-3905ef90cf28" :question/math-academy-id "q-344572" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,1}tan\\,(\\frac{2}{3}\\operatorname{arctan}(x))=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ca5e8035505f20619b6707d6d1f2d0b7b2f125a004a0dbd9d448840b0e4ffd99.png)\n\nThe domain of $\\operatorname{arctan}(x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=1$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}tan\\,(\\frac{2}{3}\\operatorname{arctan}(x)) & =tan\\,(\\frac{2}{3}\\operatorname{arctan}(1)) \\\\  & =tan\\,(\\frac{2}{3}\\cdot \\frac{\\pi }{4}) \\\\  & =tan\\,(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260046 :knowledge-point/_questions [{:knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5ae7b4a-b764-5651-b099-39e3d878a347" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186260048}] :answer-field/correct {:answer/id #uuid "d5ae7b4a-b764-5651-b099-39e3d878a347" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186260048} :answer-field/id #uuid "18a60136-4443-5694-9062-88b3e2624711" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260047}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5fffd62e-3ebd-508e-80c4-5d5261e518a7" :question/math-academy-id "q-344583" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\infty }(8\\operatorname{arctan}(3x-1))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}(3x-1):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/56e73e41a60732857504125b12eb3d3265b2633b0a9d1502058096725630793b.png)\n\nThe domain of $\\operatorname{arctan}(3x-1)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to \\infty }\\operatorname{arctan}(3x-1)=\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,\\infty }(8\\operatorname{arctan}(3x-1))=(8\\cdot \\frac{\\pi }{2})=4\\pi .\n$$"}] [{:db/id #edb/ref 17592186260380 :knowledge-point/_questions [{:knowledge-point/id #uuid "c28dd57d-e6e5-5704-94a4-5f9bfb37f383" :knowledge-point/title "Finding the Lowest Common Denominator of Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e537773-8e8c-5a7a-ba13-8ebcad30fb8f" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186272137} {:answer/id #uuid "7686260f-5dd7-535f-b3a3-6f343b615777" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272138} {:answer/id #uuid "4a456cc7-324d-5a2a-aaee-ebbb835a528b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186272139} {:answer/id #uuid "c791c3fa-1b5d-5c27-aa3b-a575e3b285a2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186272140} {:answer/id #uuid "bf7a6f33-2eee-5f49-8766-3154176930c3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272141}] :answer-field/correct {:answer/id #uuid "1e537773-8e8c-5a7a-ba13-8ebcad30fb8f" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186272137} :answer-field/id #uuid "bcb82bc1-8691-55ff-9a10-955ab65f21b2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274707}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6e1e45df-f294-5f60-b25f-93cd2088d874" :question/math-academy-id "q-43575" :question/problem "Find the lowest common denominator of $\\frac{5}{20}$ and $\\frac{7}{45}.$" :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators.\n\n- We start by finding the prime factorization of $20:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7e03a139fc3afa7df4d7f32ecf42f8f30d19bfe0415725f47fe5be63301899b5.png)\n\nTherefore, $20={2}^{2}\\cdot 5.$\n\n- Next, we find the prime factorization of $45:$\n\nTherefore, $45={3}^{2}\\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}20 & ={2}^{2}\\cdot 5 \\\\ 45 & ={3}^{2}\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $2$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common denominator is ${2}^{2}\\cdot {3}^{2}\\cdot 5=180.$"}] [{:db/id #edb/ref 17592186260415 :knowledge-point/_questions [{:knowledge-point/id #uuid "b01281fd-5272-579c-98d5-ca5cc00c73e4" :knowledge-point/title "Identifying Maps Presented in Function Notation That Are Rigid Motions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a479ba3-feb6-5453-9357-da6b1db12efa" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186260417} {:answer/id #uuid "517f2865-77aa-509b-9701-a6cab8243aae" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186260418} {:answer/id #uuid "4327f18a-dfb3-56fc-9926-b89eefc912f8" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260419} {:answer/id #uuid "baf45562-a86a-54e7-9a49-5399e7399a16" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260420} {:answer/id #uuid "2174ef5f-f026-5344-af8e-44b86ef478b3" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260421} {:answer/id #uuid "114a3157-beae-521a-913f-6953e81d1d44" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260422} {:answer/id #uuid "f32881c3-f0b8-5f3d-a989-e1a2d518e877" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186260423} {:answer/id #uuid "ec33a8d3-5f3f-525a-a94b-b70111b7d158" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260424}] :answer-field/correct {:answer/id #uuid "114a3157-beae-521a-913f-6953e81d1d44" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260422} :answer-field/id #uuid "fd9b793c-a80d-5119-bd10-c96f2a5e5f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260416}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41248f0a-a076-5b66-940a-eca2e5291a4b" :question/math-academy-id "q-45301" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/de02555d435e957019036ace7b723225ff6f3dd905f7533a51a353bacc603fce.png)\n\nWhich of the following combinations of transformations map the segment $AB$ to a congruent segment?\n\nI. - A reflection in the $y$-axis, followed by a reflection in the $x$-axis.\nII. - A rotation of ${35}^{∘}$ clockwise around the point $B.$\nIII. - A dilation of scale factor of $4$ with center of dilation $A,$ followed by a translation of $3$ units to the left." :question/worked-solution "A rigid motion is a transformation that preserves distances. There are three types of rigid motions:\n\n- Translations\n\n- Rotations\n\n- Reflections\n\nAlso, two polygons are congruent if and only if one can be mapped to another using a combination of rigid motions.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Combination I maps $AB$ to a congruent segment. Indeed, reflections are rigid motions.\n\n- Combination II maps $AB$ to a congruent segment. Indeed, a rotation is a rigid motion.\n\n- Combination III does not map $AB$ to a congruent segment because dilation is not a rigid motion.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186260425 :knowledge-point/_questions [{:knowledge-point/id #uuid "b01281fd-5272-579c-98d5-ca5cc00c73e4" :knowledge-point/title "Identifying Maps Presented in Function Notation That Are Rigid Motions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd1f6ab-9e6f-5379-a843-509d13d54a28" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186260427} {:answer/id #uuid "8b393e06-c6ab-55ad-84e1-b84baf9ce523" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186260428} {:answer/id #uuid "6cee4cc0-d3b3-5d78-b68e-a0edbb097628" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260429} {:answer/id #uuid "64612897-434e-5af8-8a66-2a579b19b522" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260430} {:answer/id #uuid "c485b055-36f4-5265-94ce-14a224fd55fa" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260431} {:answer/id #uuid "9922f82f-d65d-53c8-b56b-c4df0a16c693" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260432} {:answer/id #uuid "5adc6009-37d9-5443-bdf7-3a25923f800d" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186260433} {:answer/id #uuid "ef89d4ba-070d-5810-9324-b577e0b6fd73" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260434}] :answer-field/correct {:answer/id #uuid "9922f82f-d65d-53c8-b56b-c4df0a16c693" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260432} :answer-field/id #uuid "18468b5f-9d2d-55e6-b1a6-13894be795c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260426}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ebee1808-fab9-59f7-b821-b1dbd643c058" :question/math-academy-id "q-45468" :question/problem "Which of the following transformations map every polygon to a congruent polygon?\n\nI. - $(x,y)↦(x-1,y)$\nII. - $(x,y)↦(-y,x)$\nIII. - $(x,y)↦(2x,y)$" :question/worked-solution "A rigid motion is a transformation that preserves distances. There are three types of rigid motions:\n\n- Translations\n\n- Rotations\n\n- Reflections\n\nAlso, two polygons are congruent if and only if one can be mapped to another using a combination of rigid motions.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I is a translation of $1$ unit to the right. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation II is a rotation of ${90}^{∘}$ counterclockwise about the origin. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation III is a stretch with a stretch factor of $2$ in the $x$-direction. This is *not* a rigid motion. So, it does not map every polygon to a congruent polygon.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186260447 :knowledge-point/_questions [{:knowledge-point/id #uuid "045722b6-b558-522b-86e1-322c64e2848f" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d41234f-48c6-5f12-8714-816261fec5f1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272201} {:answer/id #uuid "588fabc7-bd0c-5f89-882b-ffe5b26e5252" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186272202} {:answer/id #uuid "c0c684ff-cc65-51a9-a7d5-546eaae2578e" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186272203} {:answer/id #uuid "ffbaa151-fbfe-53d5-a176-390184206de6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272204} {:answer/id #uuid "3b7ae3ac-eb62-5a0e-aba9-5cbe84407d95" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186272205}] :answer-field/correct {:answer/id #uuid "7d41234f-48c6-5f12-8714-816261fec5f1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272201} :answer-field/id #uuid "7722bf9f-b660-56ae-8cb4-b82e1c6377e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274720}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e08fbc7b-1ab0-52e1-b7cf-725d96e81d95" :question/math-academy-id "q-46841" :question/problem "Evaluate ${lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5}.$" :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=25$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5} & =\\frac{25-25}{\\sqrt{25}-5}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 25}\\frac{x-25}{\\sqrt{x}-5} & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{(\\sqrt{x}-5)(\\sqrt{x}+5)} \\\\  & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{{(\\sqrt{x})}^{2}-{5}^{2}} \\\\  & ={lim}_{x\\to 25}\\frac{(x-25)(\\sqrt{x}+5)}{x-25} \\\\  & ={lim}_{x\\to 25}(\\sqrt{x}+5) \\\\  & =\\sqrt{25}+5 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260501 :knowledge-point/_questions [{:knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad21724d-e6e8-5043-b9d8-2acf6ddcc615" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186260503} {:answer/id #uuid "03f8ebf2-c952-5934-a775-da2d2f676039" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186260504} {:answer/id #uuid "da5461dd-41c1-5e2f-8f1f-2660d57e5348" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260505} {:answer/id #uuid "96a94397-5062-5d2c-9777-42904783f519" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260506} {:answer/id #uuid "edcb216f-70e1-57f5-a503-0024f4c3a53b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260507} {:answer/id #uuid "6d340422-abf5-5da9-8220-7695f2bc70a0" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260508} {:answer/id #uuid "77742dde-dc9f-5bfd-887f-b5a25604d260" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186260509} {:answer/id #uuid "13e81348-444c-5b9f-b19f-580e1444d765" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260510}] :answer-field/correct {:answer/id #uuid "96a94397-5062-5d2c-9777-42904783f519" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260506} :answer-field/id #uuid "4546afc4-5ede-5282-82c2-2149674417a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260502}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8029b517-cfed-599d-a293-d42c50744670" :question/math-academy-id "q-47520" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3bb1c35edab6cecb8bdc0021b7d931c4a8284d02385c0d2398e0b3ca4fb473c0.png)\n\nWhich of the following statements are true regarding the function $f(x)$ plotted above?\n\nI. - The function is left-continuous at $x=0$\nII. - The function is right-continuous at $x=0$\nIII. - The function is continuous at $x=0$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is true. The function is left-continuous at $x=0,$ since the left-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{-}}f(x)=0=f(0)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=0,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=1\\ne 0=f(0)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not right-continuous at this point.\n\nIn conclusion, only statement I is true."}] [{:db/id #edb/ref 17592186260517 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8d06cd8-9aae-50ab-90dc-6c70b545d569" :knowledge-point/title "Computing the Derivative of a Fractional Power Function Using the Power Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1baa70dc-19c4-545f-9cbc-f18d1951a259" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\frac{2}{5\\sqrt[5]{{x}^{7}}})" :db/id #edb/ref 17592186272280} {:answer/id #uuid "535b2ab2-43f5-5bb6-a9c6-d2d421391de3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" :db/id #edb/ref 17592186272281} {:answer/id #uuid "a4d380a3-4cfa-5361-a822-6505d3285e69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{2}{5\\sqrt[5]{{x}^{7}}})" :db/id #edb/ref 17592186272282} {:answer/id #uuid "3c64fd8a-9007-5ed9-80b9-73e781c290fb" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\frac{2}{5\\sqrt[5]{{x}^{7}}})" :db/id #edb/ref 17592186272283} {:answer/id #uuid "5e55e9cb-854e-5817-94fa-d4db902516e2" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\frac{2}{5\\sqrt[5]{{x}^{7}}})" :db/id #edb/ref 17592186272284}] :answer-field/correct {:answer/id #uuid "535b2ab2-43f5-5bb6-a9c6-d2d421391de3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" :db/id #edb/ref 17592186272281} :answer-field/id #uuid "e2a845de-84f8-557d-84b8-0dc3f460468f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274736}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "96ce1d20-ba3f-5b49-92db-85f90f4852cb" :question/math-academy-id "q-47831" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ when $y=\\frac{1}{\\sqrt[5]{{x}^{2}}}.$" :question/worked-solution "Writing the radical as a rational exponent, we have\n\n$$\ny=\\frac{1}{\\sqrt[5]{{x}^{2}}}=\\frac{1}{{x}^{2/5}}={x}^{-2/5}\n$$\n\nApplying the power rule with $n=-\\frac{2}{5},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-2/5}) \\\\  & =-\\frac{2}{5}{x}^{-2/5-1} \\\\  & =-\\frac{2}{5}{x}^{-7/5} \\\\  & =-\\frac{2}{5{x}^{7/5}} \\\\  & =-\\frac{2}{5\\sqrt[5]{{x}^{7}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260569 :knowledge-point/_questions [{:knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672" :knowledge-point/title "Determining a Rate of Change for a Given Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f825c9f6-fa66-5744-9891-f93ad569990e" :answer/type {:db/ident :answer.type/math} :answer/value "2(1\\,699)" :db/id #edb/ref 17592186272350} {:answer/id #uuid "3e4ae87d-ca20-5ec3-ab30-b42ad74b467a" :answer/type {:db/ident :answer.type/math} :answer/value "-(1\\,699)" :db/id #edb/ref 17592186272351} {:answer/id #uuid "0a9884b4-5900-5d9b-a23f-dcb291c1bb95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1\\,699)" :db/id #edb/ref 17592186272352} {:answer/id #uuid "42090516-9715-5392-8c32-b922ea5ea87d" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,699" :db/id #edb/ref 17592186272353} {:answer/id #uuid "680464eb-4cd1-5cb5-93cc-7c8e95b9261f" :answer/type {:db/ident :answer.type/math} :answer/value "3(1\\,699)" :db/id #edb/ref 17592186272354}] :answer-field/correct {:answer/id #uuid "42090516-9715-5392-8c32-b922ea5ea87d" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,699" :db/id #edb/ref 17592186272353} :answer-field/id #uuid "82a88222-952e-5819-9181-f73b5a076050" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274750}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4df84652-8096-5b0a-ac62-74634ce27764" :question/math-academy-id "q-48700" :question/problem "The number of computers affected by the spread of some ransomware after $t$ days can be modeled by the function $f(t)=\\frac{100\\,({t}^{3}+2)}{t+1}.$ What is the instantaneous rate of change in the number of infected computers when $t=9$ days?" :question/worked-solution "The instantaneous rate of change in the spread when $t=9$ days is equal to ${f}^{'}(9).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{100\\,({t}^{3}+2)}{t+1}) \\\\  & =\\frac{100(3{t}^{2})(t+1)-100({t}^{3}+2)(1)}{{(t+1)}^{2}} \\\\  & =100\\cdot \\frac{2{t}^{3}+3{t}^{2}-2}{{(t+1)}^{2}}.\\end{aligned}\n$$\n\nNow, substituting $t=9,$ we get\n\n$$\n\\begin{aligned}{f}^{'}(9) & =100\\cdot \\frac{2(9)^{3}+3(9)^{2}-2}{{((9)+1)}^{2}} \\\\  & =100\\cdot \\frac{1\\,458+243-2}{100} \\\\  & =1\\,699.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change in the spread when $t=9$ is $1\\,699$ computers per day."}] [{:db/id #edb/ref 17592186260577 :knowledge-point/_questions [{:knowledge-point/id #uuid "20b289d4-96a7-5d1b-9714-6afabab4804d" :knowledge-point/title "Further Determining Rates of Change in Geometrical Settings"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0f5b36b-7244-50f2-92d1-2e38aa0ed62e" :answer/type {:db/ident :answer.type/math} :answer/value "3(16\\pi \\,{\\text{cm}}^{3}/\\text{cm})" :db/id #edb/ref 17592186272360} {:answer/id #uuid "1a303edf-9147-53db-9a2c-66242e1ee1da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(16\\pi \\,{\\text{cm}}^{3}/\\text{cm})" :db/id #edb/ref 17592186272361} {:answer/id #uuid "f569d5d3-194f-5741-acbc-73b87aeeef41" :answer/type {:db/ident :answer.type/math} :answer/value "-(16\\pi \\,{\\text{cm}}^{3}/\\text{cm})" :db/id #edb/ref 17592186272362} {:answer/id #uuid "11800655-15c6-559f-a479-bcaafc2230cf" :answer/type {:db/ident :answer.type/math} :answer/value "2(16\\pi \\,{\\text{cm}}^{3}/\\text{cm})" :db/id #edb/ref 17592186272363} {:answer/id #uuid "22b8bdaa-d50a-53ea-9101-fe2bd3d5a9b5" :answer/type {:db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{cm}}^{3}/\\text{cm}" :db/id #edb/ref 17592186272364}] :answer-field/correct {:answer/id #uuid "22b8bdaa-d50a-53ea-9101-fe2bd3d5a9b5" :answer/type {:db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{cm}}^{3}/\\text{cm}" :db/id #edb/ref 17592186272364} :answer-field/id #uuid "06f5b7cc-564d-5379-9694-c01afdeb1970" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274752}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a580dc26-7bce-5304-a10e-4329d4b6dd9b" :question/math-academy-id "q-48718" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d2dadb0372f8b19ca8e017b1f8aa883ac6140a4f17deb9a4a28569f3afda61fe.png)\n\nThe volume of a sphere is increasing.\nFind the instantaneous rate of change of a sphere’s volume with respect to its radius when the radius is equal to $r=2\\,\\text{cm}.$" :question/worked-solution "We know that the volume of the sphere with radius $r$ is given by\n\n$$\nV=V(r)=\\frac{4}{3}\\pi {r}^{3}.\n$$\n\nTaking the derivative, the rate of change of $V(r)$  with respect to $r$ is \n\n$$\n\\begin{aligned}{V}^{'}(r) & =\\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\  & =\\frac{4}{3}\\cdot 3\\pi {r}^{2} \\\\  & =4\\pi {r}^{2},\\end{aligned}\n$$\n\nand evaluating at $r=2$ gives\n\n$$\n{V}^{'}(2)=4\\pi (2)^{2}=16\\pi .\n$$\n\nTherefore, the instantaneous rate at which the volume of the sphere is changing when its radius is $2\\,\\text{cm}$ is $16\\pi \\,{\\text{cm}}^{3}/\\text{cm}.$"}] [{:db/id #edb/ref 17592186260589 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9663fa45-19a8-5fd7-911c-e2141ecf847e" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $(1)-1$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272380} {:answer/id #uuid "5f1e8616-e220-51b6-b487-7a1a034ee77a" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $(1)+2$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272381} {:answer/id #uuid "a6483418-eaa0-566d-afcd-7d6a6e8615b9" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $(1)-2$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272382} {:answer/id #uuid "229fdbcb-0011-54c4-b5c9-d34711baa038" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $1$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272383} {:answer/id #uuid "dd99bc3f-c81c-5c15-a930-946f8ffd8ca9" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $(1)+1$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272384}] :answer-field/correct {:answer/id #uuid "229fdbcb-0011-54c4-b5c9-d34711baa038" :answer/type {:db/ident :answer.type/text} :answer/value "initial position m = $1$; initial velocity m per s = $2/e$" :db/id #edb/ref 17592186272383} :answer-field/id #uuid "a6c2471f-9ce9-5416-b16f-ded9a558efa7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274756}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5d6ad8bf-cda0-583d-b73e-9adebb22d32f" :question/math-academy-id "q-48907" :question/problem "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)=\\operatorname{ln}(2t+e)$, where $t$ is the time, measured in seconds. Find the position and velocity of the particle at the initial moment of time $t=0\\,\\text{s}.$" :question/worked-solution "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)=\\operatorname{ln}(2t+e):$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & =\\operatorname{ln}(2\\cdot 0+e) \\\\  & =\\operatorname{ln}(e) \\\\  & =1\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}(2t+e)) \\\\  & =\\frac{2}{2t+e}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =\\frac{2}{2\\cdot 0+e} \\\\  & =\\frac{2}{e}\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260603 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "039d59aa-0f93-5b00-9cd3-85e7ed8c591f" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $(\\cos^2 x)-1$; b = $0$" :db/id #edb/ref 17592186272400} {:answer/id #uuid "d62ba230-b05d-57e5-b9dd-d196bdd640da" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $\\cos^2 x$; b = $0$" :db/id #edb/ref 17592186272401} {:answer/id #uuid "cd857c4e-eaae-56eb-b7bd-5562b847a6de" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $(\\cos^2 x)+2$; b = $0$" :db/id #edb/ref 17592186272402} {:answer/id #uuid "1feaf368-b95c-588a-aad9-0f77ada18bda" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $(\\cos^2 x)+1$; b = $0$" :db/id #edb/ref 17592186272403} {:answer/id #uuid "68d18458-e8c1-50d2-b219-4a15735d75e8" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $(\\cos^2 x)-2$; b = $0$" :db/id #edb/ref 17592186272404}] :answer-field/correct {:answer/id #uuid "d62ba230-b05d-57e5-b9dd-d196bdd640da" :answer/type {:db/ident :answer.type/text} :answer/value "f of x = $\\cos^2 x$; b = $0$" :db/id #edb/ref 17592186272401} :answer-field/id #uuid "b8013420-d089-5eb9-9b7e-0648a1433710" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274760}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ddefd999-6b86-57f0-8e66-8d7df90354a0" :question/math-academy-id "q-49233" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{-\\pi }^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{cos}^{2}(-\\pi +\\frac{\\pi k}{n})\\cdot \\frac{\\pi }{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=-\\pi .$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{\\pi }{n}.$ Therefore, \n\n$$\n\\frac{\\pi }{n}=\\frac{b-(-\\pi )}{n}\\,⟹\\,b=0.\n$$\n\nConsequently, ${x}_{k}=-\\pi +\\frac{\\pi k}{n}$ and $f({x}_{k})={cos}^{2}{x}_{k}.$\n\nHence,\n\n$$\n{\\int }_{-\\pi }^{0}{cos}^{2}x\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{cos}^{2}(-\\pi +\\frac{\\pi k}{n})\\cdot \\frac{\\pi }{n}].\n$$\n\nTherefore, the correct answer is $f(x)={cos}^{2}x$ and $b=0.$"}] [{:db/id #edb/ref 17592186260758 :knowledge-point/_questions [{:knowledge-point/id #uuid "f956a45f-29cb-5b78-a29f-3796e22af09d" :knowledge-point/title "Evaluating Limits at Infinity of Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8223415-be85-5a4b-97a0-f50c5d7aa05a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272540} {:answer/id #uuid "a24eb7da-fdf4-5297-85de-3f61def26493" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186272541} {:answer/id #uuid "217ebe3a-96fa-5c36-8272-788b8c50fece" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186272542} {:answer/id #uuid "65334b10-02f1-5a89-bf1b-314551781f84" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186272543} {:answer/id #uuid "a6c11465-9ee9-531b-bb68-6e7ada4972bb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186272544}] :answer-field/correct {:answer/id #uuid "a24eb7da-fdf4-5297-85de-3f61def26493" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186272541} :answer-field/id #uuid "aab15d5f-54a5-5b63-952e-efffb0920381" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274788}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0941c5e4-c170-5649-8bbf-3e710ae630e7" :question/math-academy-id "q-54448" :question/problem "${lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{log}(2-7x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/b4fcf2946431788963444f22bcd51b2a617b53dfc4bbfdd0d8b90bd9fd9304d2.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=\\infty \n$$"}] [{:db/id #edb/ref 17592186260787 :knowledge-point/_questions [{:knowledge-point/id #uuid "48f71a07-2bd3-5164-a227-b82d56c0abc7" :knowledge-point/title "Using a Ratio to Compute a Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49318d66-8069-5879-98ce-feda8301b601" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186272585} {:answer/id #uuid "3ceed7c8-78b5-54ee-b8bf-f051a1dd54a0" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186272586} {:answer/id #uuid "bee6dc77-585f-5841-a4b4-f6eea1b57830" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186272587} {:answer/id #uuid "bf323860-141a-5b04-8c0b-4754c184e732" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186272588} {:answer/id #uuid "479b1974-f213-5ee8-9983-c7de72fc091c" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186272589}] :answer-field/correct {:answer/id #uuid "3ceed7c8-78b5-54ee-b8bf-f051a1dd54a0" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186272586} :answer-field/id #uuid "c52b4f0c-4222-5342-bd57-a44e8f2a3455" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b7399af-5c1c-5c70-8b98-f78b69b577eb" :question/math-academy-id "q-60150" :question/problem "In a zoo, there are $12$ camels. If the ratio of camels to monkeys is $3:7,$ how many monkeys are there in the zoo?" :question/worked-solution "We start with the ratio $3:7$ and write it as a fraction:\n\n$$\n\\frac{3}{7}\n$$\n\nIn this fraction, the numerator represents the number of camels and the denominator represents the number of monkeys.\n\nWe can make a numerator of $12$ by multiplying the numerator and denominator by $4$:\n\n$$\n\\frac{3\\times 4}{7\\times 4}=\\frac{12}{28}\n$$\n\nTherefore, there are $28$ monkeys in the zoo."}] [{:db/id #edb/ref 17592186260839 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1519905-a736-54a1-8778-cc03d019a084" :knowledge-point/title "Expressing a Reciprocal Trigonometric Ratio in Terms of a Reference Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "727c6028-dfc7-59dc-8db9-3f8b8e976c26" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\operatorname{cot}(\\frac{3\\pi }{10}))" :db/id #edb/ref 17592186272619} {:answer/id #uuid "a6ac5bbb-4616-5c1f-a574-7c28ca574908" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\operatorname{cot}(\\frac{3\\pi }{10}))" :db/id #edb/ref 17592186272620} {:answer/id #uuid "0cd0e51c-b4d6-53ff-b421-57f5dcfa7813" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cot}(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186272621} {:answer/id #uuid "6bee1b81-14e6-59ef-8a68-dade8800d904" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\operatorname{cot}(\\frac{3\\pi }{10}))" :db/id #edb/ref 17592186272622} {:answer/id #uuid "d2f0da03-74d5-5773-9bae-0cff112b64a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\operatorname{cot}(\\frac{3\\pi }{10}))" :db/id #edb/ref 17592186272623}] :answer-field/correct {:answer/id #uuid "0cd0e51c-b4d6-53ff-b421-57f5dcfa7813" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cot}(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186272621} :answer-field/id #uuid "126966cb-b91b-54f1-88c7-76821a5abeef" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274807}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "18a55104-bbdc-52e6-837d-232680de3e89" :question/math-academy-id "q-64741" :question/problem "Express $\\operatorname{cot}(\\frac{7\\pi }{10})$ in terms of a reference angle." :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(\\frac{7\\pi }{10})\\cdot (\\frac{{180}^{∘}}{\\pi })={126}^{∘}.\n$$\n\nTherefore $\\frac{7\\pi }{10}$ is equivalent to ${126}^{∘},$ which lies in the $2\\text{nd}$ quadrant.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/89b5e2656378adb5d91c9f58c261e4beaae252b67819b904bf209f6ed8a5a25e.png)\n\nTo express $\\operatorname{cot}(\\frac{7\\pi }{10})$ in terms of $\\operatorname{cot}{\\theta }_{R},$ we follow three steps:\n\n- Find its reference angle ${\\theta }_{R}.$\n\n- Calculate the value of the function for ${\\theta }_{R}.$\n\n- Determine whether the resulting value is positive or negative.\n\n**Step 1**: Since $\\theta =\\frac{7\\pi }{10}$ is in the $2$nd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\pi -\\theta  \\\\  & =\\pi -\\frac{7\\pi }{10} \\\\  & =\\frac{3\\pi }{10}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{cot}(\\frac{7\\pi }{10})$, and therefore we're interested in $\\operatorname{cot}{\\theta }_{R}=\\operatorname{cot}(\\frac{3\\pi }{10}).$\n\n**Step 3:** The ratio $\\operatorname{cot}(\\frac{7\\pi }{10})$ must be negative because tangent (and therefore cotangent) is always negative in the $2$nd quadrant. Therefore,\n\n$$\n\\operatorname{cot}(\\frac{7\\pi }{10})=-\\operatorname{cot}(\\frac{3\\pi }{10}).\n$$"}] [{:db/id #edb/ref 17592186261211 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2802d908-03d2-549b-99be-192038320561" :answer/type {:db/ident :answer.type/math} :answer/value "((\\frac{5}{4})-1,0)" :db/id #edb/ref 17592186273138} {:answer/id #uuid "d4067a8d-ec27-5ae4-ab73-6f887dc730a6" :answer/type {:db/ident :answer.type/math} :answer/value "((\\frac{5}{4})+1,0)" :db/id #edb/ref 17592186273139} {:answer/id #uuid "401fa27c-4c10-54ee-b362-392b4ad9cb72" :answer/type {:db/ident :answer.type/math} :answer/value "((\\frac{5}{4})-2,0)" :db/id #edb/ref 17592186273140} {:answer/id #uuid "b91ae7de-1134-54a5-af60-378a9bc42ef4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186273141} {:answer/id #uuid "7e5cd844-68f4-5c08-b545-fd4e94388bae" :answer/type {:db/ident :answer.type/math} :answer/value "((\\frac{5}{4})+2,0)" :db/id #edb/ref 17592186273142}] :answer-field/correct {:answer/id #uuid "b91ae7de-1134-54a5-af60-378a9bc42ef4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186273141} :answer-field/id #uuid "e892069b-e246-5026-84ad-c45368123fc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274911}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c3b4dcc1-a729-5d5a-b8a6-15ae89af7190" :question/math-academy-id "q-70517" :question/problem "Find where the tangent to the curve $y=6\\sqrt{x}+5x-13$ at the point $(1,-2)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=6\\sqrt{x}+5x-13.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5x-13) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5x) \\\\  & =3{x}^{-1/2}+5\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{'}(1)=3(1)^{-1/2}+5=8.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =8(x-1) \\\\ y & =8x-8-2 \\\\ y & =8x-10.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =8x-10 \\\\ x & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{5}{4},0).$"}] [{:db/id #edb/ref 17592186261229 :knowledge-point/_questions [{:knowledge-point/id #uuid "eff38343-20a5-5756-8463-d0420dc846fc" :knowledge-point/title "Simplifying an Expression Using the Relationship Between Sine, Cosine, and Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e82ce8-fa33-530f-b096-7e374dea9d3b" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\operatorname{sin}\\theta)" :db/id #edb/ref 17592186273148} {:answer/id #uuid "1e89f576-2ea8-57db-a94a-d57208724198" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{sin}\\theta)" :db/id #edb/ref 17592186273149} {:answer/id #uuid "660c7755-1789-55cb-b881-8f46207af0c5" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\operatorname{sin}\\theta)" :db/id #edb/ref 17592186273150} {:answer/id #uuid "d9358e4b-aa85-5be6-af3f-d71a8240f0c7" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\operatorname{sin}\\theta)" :db/id #edb/ref 17592186273151} {:answer/id #uuid "493a9ded-c3ad-5a5e-b4f1-d2cfd0421a99" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}\\theta" :db/id #edb/ref 17592186273152}] :answer-field/correct {:answer/id #uuid "493a9ded-c3ad-5a5e-b4f1-d2cfd0421a99" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}\\theta" :db/id #edb/ref 17592186273152} :answer-field/id #uuid "7b1047f3-3e9d-5fdb-b251-f97ef6058e32" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "29105bf7-6b32-50a3-8ad8-587438d8f958" :question/math-academy-id "q-70739" :question/problem "Simplify the trigonometric expression $\\frac{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }{\\operatorname{cot}\\theta +1}.$" :question/worked-solution "First, let's interpret the fraction as a division:\n\n$$\n\\frac{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }{\\operatorname{cot}\\theta +1}=(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )÷(\\operatorname{cot}\\theta +1)\n$$\n\nThen, we recall the identity $\\operatorname{cot}\\theta =\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta },$ and we substitute it into the above expression:\n\n$$\n\\begin{aligned}(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )÷(\\operatorname{cot}\\theta +1) & =(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )÷(\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta }+1) \\\\  & =(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )÷(\\frac{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }{\\operatorname{sin}\\theta })\\end{aligned}\n$$\n\nFinally, we turn the division into multiplication, and simplify the expression as much as possible:\n\n$$\n\\begin{aligned}(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )÷(\\frac{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }{\\operatorname{sin}\\theta }) & =(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )\\cdot (\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }) \\\\  & =\\frac{(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )\\cdot \\operatorname{sin}\\theta }{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta } \\\\  & =\\frac{\\cancel{(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )}\\cdot \\operatorname{sin}\\theta }{\\cancel{(\\operatorname{cos}\\theta +\\operatorname{sin}\\theta )}} \\\\  & =\\operatorname{sin}\\theta \\end{aligned}\n$$\n\nTherefore, $\\frac{\\operatorname{cos}\\theta +\\operatorname{sin}\\theta }{\\operatorname{cot}\\theta +1}=\\operatorname{sin}\\theta .$"}] [{:db/id #edb/ref 17592186261232 :knowledge-point/_questions [{:knowledge-point/id #uuid "eff38343-20a5-5756-8463-d0420dc846fc" :knowledge-point/title "Simplifying an Expression Using the Relationship Between Sine, Cosine, and Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4f809bf-2174-5ebc-bc4b-c4736ad3d77b" :answer/type {:db/ident :answer.type/math} :answer/value "3({sin}^{2}\\theta)" :db/id #edb/ref 17592186273153} {:answer/id #uuid "394b918c-a1f6-5819-ae3e-dfcc243295ac" :answer/type {:db/ident :answer.type/math} :answer/value "2({sin}^{2}\\theta)" :db/id #edb/ref 17592186273154} {:answer/id #uuid "a9bbe3f7-25a3-55e6-8c1c-6673c9556cc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({sin}^{2}\\theta)" :db/id #edb/ref 17592186273155} {:answer/id #uuid "91279ee6-81ce-5439-a748-cd730f0eea7f" :answer/type {:db/ident :answer.type/math} :answer/value "{sin}^{2}\\theta" :db/id #edb/ref 17592186273156} {:answer/id #uuid "9fdf6854-8218-5f55-b916-0967a77c84e7" :answer/type {:db/ident :answer.type/math} :answer/value "-({sin}^{2}\\theta)" :db/id #edb/ref 17592186273157}] :answer-field/correct {:answer/id #uuid "91279ee6-81ce-5439-a748-cd730f0eea7f" :answer/type {:db/ident :answer.type/math} :answer/value "{sin}^{2}\\theta" :db/id #edb/ref 17592186273156} :answer-field/id #uuid "0496621a-1cf1-52a0-92ea-b2bd5ea2fad1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274914}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "25f4b06a-33dc-5ef1-8e62-5a7ad79bbc27" :question/math-academy-id "q-70740" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}\\theta }{{cot}^{2}\\theta }.$" :question/worked-solution "First, let's interpret the fraction as a division:\n\n$$\n\\frac{{cos}^{2}\\theta }{{cot}^{2}\\theta }={cos}^{2}\\theta ÷{cot}^{2}\\theta \n$$\n\nThen, we recall the identity $\\operatorname{cot}\\theta =\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta },$ and we substitute it into the above expression:\n\n$$\n\\begin{aligned}{cos}^{2}\\theta ÷{cot}^{2}\\theta  & ={cos}^{2}\\theta ÷{(\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta })}^{2} \\\\  & ={cos}^{2}\\theta ÷\\frac{{cos}^{2}\\theta }{{sin}^{2}\\theta }\\end{aligned}\n$$\n\nFinally, we turn the division into multiplication, and simplify the expression as much as possible:\n\n$$\n\\begin{aligned}{cos}^{2}\\theta ÷\\frac{{cos}^{2}\\theta }{{sin}^{2}\\theta } & ={cos}^{2}\\theta \\cdot \\frac{{sin}^{2}\\theta }{{cos}^{2}\\theta } \\\\  & =\\frac{{cos}^{2}\\theta \\cdot {sin}^{2}\\theta }{{cos}^{2}\\theta } \\\\  & =\\frac{\\cancel{{cos}^{2}\\theta }\\cdot {sin}^{2}\\theta }{\\cancel{{cos}^{2}\\theta }} \\\\  & =\\frac{{sin}^{2}\\theta }{1} \\\\  & ={sin}^{2}\\theta \\end{aligned}\n$$\n\nTherefore, $\\frac{{cos}^{2}\\theta }{{cot}^{2}\\theta }={sin}^{2}\\theta .$"}] [{:db/id #edb/ref 17592186261339 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5169e2cf-3b2c-5463-8f2b-e08aedea671f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{sin}y+C" :db/id #edb/ref 17592186273258} {:answer/id #uuid "6dbc6a3c-616a-5018-92d4-069a013d76a7" :answer/type {:db/ident :answer.type/math} :answer/value "− 2\\cos y + C" :db/id #edb/ref 17592186273259} {:answer/id #uuid "4d9c85c6-8cbc-5702-9fd4-c0b3bb7512b3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos y + C" :db/id #edb/ref 17592186273260} {:answer/id #uuid "a306281b-0df5-5155-9658-0f7eaf5db84e" :answer/type {:db/ident :answer.type/math} :answer/value "− 2\\sin y + C" :db/id #edb/ref 17592186273261} {:answer/id #uuid "2edc577f-6408-5b66-8fb6-10b375dc1af5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin y + C" :db/id #edb/ref 17592186273262}] :answer-field/correct {:answer/id #uuid "5169e2cf-3b2c-5463-8f2b-e08aedea671f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{sin}y+C" :db/id #edb/ref 17592186273258} :answer-field/id #uuid "1b58fc84-d851-537c-9433-483d7acf6d1f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274935}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "521ab7c8-6b97-5cba-8f25-b1798a58600a" :question/math-academy-id "q-71653" :question/problem "$\\int 4\\operatorname{cos}y\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{cos}y\\,\\text{d}y=\\operatorname{sin}y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4\\operatorname{cos}y\\,\\text{d}y & =4\\int \\operatorname{cos}y\\,\\text{d}y \\\\  & =4(\\operatorname{sin}y)+C \\\\  & =4\\operatorname{sin}y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261342 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9659b760-6eee-5699-b71d-2ccdb13876b7" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\operatorname{cos}x+5\\operatorname{sin}x+C)" :db/id #edb/ref 17592186273263} {:answer/id #uuid "85785a77-2be3-5999-aa5d-41269f1b60cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\operatorname{cos}x+5\\operatorname{sin}x+C)" :db/id #edb/ref 17592186273264} {:answer/id #uuid "bc252578-a261-5142-b5ba-b6652ccb0437" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\operatorname{cos}x+5\\operatorname{sin}x+C)" :db/id #edb/ref 17592186273265} {:answer/id #uuid "1d0cb917-a1b4-5bd2-a1b7-404c050721b6" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\operatorname{cos}x+5\\operatorname{sin}x+C)" :db/id #edb/ref 17592186273266} {:answer/id #uuid "98025031-e233-59b2-9cb8-bcec5cea39ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}x+5\\operatorname{sin}x+C" :db/id #edb/ref 17592186273267}] :answer-field/correct {:answer/id #uuid "98025031-e233-59b2-9cb8-bcec5cea39ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}x+5\\operatorname{sin}x+C" :db/id #edb/ref 17592186273267} :answer-field/id #uuid "11c7a56f-c20b-54c9-a200-082af7e5b9b3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274936}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "467397a0-c530-591f-93a4-1e57ee145f34" :question/math-academy-id "q-71654" :question/problem "$\\int (\\operatorname{sin}x+5\\operatorname{cos}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sin}x+5\\operatorname{cos}x)\\,\\text{d}x & =\\int \\operatorname{sin}x\\,\\text{d}x+5\\int \\operatorname{cos}x\\,\\text{d}x \\\\  & =-\\operatorname{cos}x+5\\operatorname{sin}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261345 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db94084a-fbf1-5ec1-91fa-aa11583540e4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\csc y + C" :db/id #edb/ref 17592186273268} {:answer/id #uuid "75cf2e67-3b07-5c02-9af4-d74091886e22" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{csc}y+C" :db/id #edb/ref 17592186273269} {:answer/id #uuid "b4afff49-5c69-5c09-b4d4-09964f16e3ca" :answer/type {:db/ident :answer.type/math} :answer/value "− 2\\csc y + C" :db/id #edb/ref 17592186273270} {:answer/id #uuid "f0c25133-0508-5e76-958f-c39687d85403" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc y + C" :db/id #edb/ref 17592186273271} {:answer/id #uuid "b71b447c-2480-5b06-befd-d1688604582a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\csc^{2} y + C" :db/id #edb/ref 17592186273272}] :answer-field/correct {:answer/id #uuid "75cf2e67-3b07-5c02-9af4-d74091886e22" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{csc}y+C" :db/id #edb/ref 17592186273269} :answer-field/id #uuid "bdfc1273-a1bd-5238-ab78-182259a19f6b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274937}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4ebe3c4b-2395-5e47-9335-a17a764b723c" :question/math-academy-id "q-71657" :question/problem "$\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y & =-\\operatorname{csc}y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y & =-8\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y \\\\  & =-8(-\\operatorname{csc}y)+C \\\\  & =8\\operatorname{csc}y+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261418 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d482a0a4-c4a0-523f-9dfa-8ae004a7a6d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{m}{m+2})" :db/id #edb/ref 17592186273347} {:answer/id #uuid "5024b857-c0e1-54dd-bb82-dd0362440040" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{m}{m+2})" :db/id #edb/ref 17592186273348} {:answer/id #uuid "066694cc-d691-535f-90f5-2f4eb4a15ee1" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{m}{m+2})" :db/id #edb/ref 17592186273349} {:answer/id #uuid "d689297f-5b22-5ff8-bc09-bfa2df6142eb" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{m}{m+2})" :db/id #edb/ref 17592186273350} {:answer/id #uuid "e5ae44f1-2a50-5294-bdcf-25ccee976fbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m}{m+2}" :db/id #edb/ref 17592186273351}] :answer-field/correct {:answer/id #uuid "e5ae44f1-2a50-5294-bdcf-25ccee976fbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m}{m+2}" :db/id #edb/ref 17592186273351} :answer-field/id #uuid "37fdfa59-cc6e-533c-9eaa-4b041679b88f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274953}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "94132973-e1ea-56d3-91fd-3c60ba30fca6" :question/math-academy-id "q-73025" :question/problem "Given that $m\\ge 0$ is an integer, simplify $\\frac{m(m+1)!}{(m+2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(m+2)!=(m+2)\\cdot (m+1)!\n$$\n\nThen, we cancel the $(m+1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{m(m+1)!}{(m+2)!} & =\\frac{m\\cdot (m+1)!}{(m+2)\\cdot (m+1)!} \\\\  & =\\frac{m\\cdot \\cancel{(m+1)!}}{(m+2)\\cdot \\cancel{(m+1)!}} \\\\  & =\\frac{m}{m+2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261484 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2e2571a-f846-545f-9b69-df1f1458cc47" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\left({lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]\\right)" :db/id #edb/ref 17592186273397} {:answer/id #uuid "3123b326-4043-571b-9d81-698c9d5714b1" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186273398} {:answer/id #uuid "33e25834-b6db-5401-8bf8-903344f0ce00" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12\\left({lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]\\right)" :db/id #edb/ref 17592186273399} {:answer/id #uuid "b6dc44d7-cba5-5ad7-9846-e79d536eeecf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left({lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]\\right)" :db/id #edb/ref 17592186273400} {:answer/id #uuid "d8784a2e-e5bc-5b0d-99dc-a486b9efe157" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left({lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]\\right)" :db/id #edb/ref 17592186273401}] :answer-field/correct {:answer/id #uuid "3123b326-4043-571b-9d81-698c9d5714b1" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186273398} :answer-field/id #uuid "0718d37b-0269-5937-b774-76d2265a0b8c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274963}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a1860af4-870a-5e0b-8bed-0744128516ef" :question/math-academy-id "q-73186" :question/problem "What is ${\\int }_{4}^{7}(3x-7)^{3}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{4}^{7}(3x-7)^{3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(3x-7)^{3},$ the lower bound is $a=4$ and the upper bound is $b=7.$ So, we have\n\n$$\nΔx=\\frac{7-4}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{4}^{7}(3x+2)^{3}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(4+m\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(4+\\frac{3m}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(3(4+\\frac{3m}{n})-7)}^{3}\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(5+\\frac{9m}{n})}^{3}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261520 :knowledge-point/_questions [{:knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274ccbc5-03c8-5e16-a018-194d3d37affa" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}})" :db/id #edb/ref 17592186273437} {:answer/id #uuid "9e9ebc7b-1c4b-5462-8233-098b1d8efb57" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186273438} {:answer/id #uuid "f12c3026-1d7e-54d0-99f1-95540751920a" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}})" :db/id #edb/ref 17592186273439} {:answer/id #uuid "16c52c74-5550-5c48-853e-57274ea5957c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}})" :db/id #edb/ref 17592186273440} {:answer/id #uuid "92aa1a4e-7173-52d9-88f5-ff4025a04906" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}})" :db/id #edb/ref 17592186273441}] :answer-field/correct {:answer/id #uuid "9e9ebc7b-1c4b-5462-8233-098b1d8efb57" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186273438} :answer-field/id #uuid "2bc719a3-a417-5cf5-b54c-11ba8c61e211" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274971}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "132cf5fe-dc28-5d76-ae4e-cbb33fa550d6" :question/math-academy-id "q-73502" :question/problem "Calculate ${f}^{'}(x)$ for $f(x)=5\\operatorname{arccos}({e}^{x}).$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}[5\\operatorname{arccos}({e}^{x})] \\\\  & =5\\cdot (-\\frac{1}{\\sqrt{1-{({e}^{x})}^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =5\\cdot (-\\frac{1}{\\sqrt{1-{({e}^{x})}^{2}}})\\cdot {e}^{x} \\\\  & =-\\frac{5{e}^{x}}{\\sqrt{1-{e}^{2x}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261523 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c545da5-b81a-5657-8667-5fc524630571" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x}\\arctan x + (3^{x})/(x^{2} + 1)" :db/id #edb/ref 17592186273442} {:answer/id #uuid "fa6cb7c1-acfe-5612-8b53-370a3d7536d3" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x}\\arctan x\\ln 3 + (3^{x})/(x^{2} + 1)" :db/id #edb/ref 17592186273443} {:answer/id #uuid "ab6215b5-da86-5e65-bfe8-ea4acefdf742" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x}\\arctan x\\ln 3 + (3)/(x^{2} + 1)" :db/id #edb/ref 17592186273444} {:answer/id #uuid "ff94b548-5aae-58bf-9b06-153915515449" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}(\\operatorname{arcsin}x+\\frac{1}{\\sqrt{1-{x}^{2}}})" :db/id #edb/ref 17592186273445} {:answer/id #uuid "5e0cf08e-49c3-5826-87bf-3c9626c24081" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x}\\arctan x − (3^{x})/(x^{2} + 1)" :db/id #edb/ref 17592186273446}] :answer-field/correct {:answer/id #uuid "ff94b548-5aae-58bf-9b06-153915515449" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}(\\operatorname{arcsin}x+\\frac{1}{\\sqrt{1-{x}^{2}}})" :db/id #edb/ref 17592186273445} :answer-field/id #uuid "0bd2f594-6134-54ab-8959-b8f0614c85a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274972}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b9ae99f-c141-5521-b9c6-8a7948ccbe1d" :question/math-academy-id "q-73511" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y={e}^{x}\\operatorname{arcsin}x.$" :question/worked-solution "Applying the product rule and using the formula for the derivative of $\\operatorname{arcsin}x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({e}^{x}\\operatorname{arcsin}x) & =\\operatorname{arcsin}x\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x})+{e}^{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}x) \\\\  & =\\operatorname{arcsin}x\\cdot {e}^{x}+{e}^{x}\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}} \\\\  & ={e}^{x}(\\operatorname{arcsin}x+\\frac{1}{\\sqrt{1-{x}^{2}}}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261590 :knowledge-point/_questions [{:knowledge-point/id #uuid "b492068c-2bd2-5611-baab-780959d24c3d" :knowledge-point/title "Calculating the Derivative of an Inverse Function Using a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77416e0f-a4f7-5387-809d-57d5f319e686" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(3)" :db/id #edb/ref 17592186273536} {:answer/id #uuid "f45120cd-50e8-5fbc-b959-25063b17a4f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273537} {:answer/id #uuid "d0359b7c-3a01-544c-8df6-4b78eb2ea081" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(5)" :db/id #edb/ref 17592186273538} {:answer/id #uuid "c22729bd-c52f-52fa-8ebb-5808a6d1ff2a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186273539} {:answer/id #uuid "522f04f4-f787-54e6-8424-1b540557ab5f" :answer/type {:db/ident :answer.type/math} :answer/value "− 3" :db/id #edb/ref 17592186273540}] :answer-field/correct {:answer/id #uuid "f45120cd-50e8-5fbc-b959-25063b17a4f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273537} :answer-field/id #uuid "0133a190-bb4f-5b6e-98e2-c14e36c918f4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274991}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2fbff772-e6e5-5110-9b66-ccc497ff0d44" :question/math-academy-id "q-75829" :question/problem "The following table gives the values of functions $f(x)$ and ${f}^{'}(x)$ at some points. Find $({f}^{-1})^{'}(3).$\n\n| **$x$** | $f(x)$ | ${f}^{'}(x)$ |\n| --- | --- | --- |\n| $4$ | $-9$ | $0$ |\n| $5$ | $3$ | $-2$ |" :question/worked-solution "The formula for the derivative of the inverse is\n\n$$\n({f}^{-1})^{'}(x)=\\frac{1}{{f}^{'}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=3,$ we have\n\n$$\n({f}^{-1})^{'}(3)=\\frac{1}{{f}^{'}({f}^{-1}(3))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(3)=5$ and ${f}^{'}(5)=-2.$ Therefore,\n\n$$\n\\begin{aligned}({f}^{-1})^{'}(3) & =\\frac{1}{{f}^{'}({f}^{-1}(3))} \\\\  & =\\frac{1}{{f}^{'}(5)} \\\\  & =\\frac{1}{(-2)} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261596 :knowledge-point/_questions [{:knowledge-point/id #uuid "b492068c-2bd2-5611-baab-780959d24c3d" :knowledge-point/title "Calculating the Derivative of an Inverse Function Using a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dae66725-b71f-5a70-8f57-11cfbd0ca043" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(3)" :db/id #edb/ref 17592186273546} {:answer/id #uuid "6f5a3aac-0b9e-5aa9-bd3c-06b9a5f64aa1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186273547} {:answer/id #uuid "d56d16b6-91e3-5e8c-afa5-31c6e00d7db9" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(5)" :db/id #edb/ref 17592186273548} {:answer/id #uuid "b84684ea-e915-5907-9812-f1ad0d12cce8" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186273549} {:answer/id #uuid "a84b2a04-736b-51fd-8725-bd502080826e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186273550}] :answer-field/correct {:answer/id #uuid "6f5a3aac-0b9e-5aa9-bd3c-06b9a5f64aa1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186273547} :answer-field/id #uuid "2449764c-f0e0-5d84-9d13-109557b9d7bb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274993}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d12b09b-2880-5ee9-8ad4-d2afa2844e57" :question/math-academy-id "q-75838" :question/problem "The following table gives the values of $f(x),{f}^{'}(x),g(x),$ and ${g}^{'}(x)$ at some points. Find ${(g\\cdot {f}^{-1})}^{'}(2)$ of the product of functions.\n\n| **$x$** | $f(x)$ | ${f}^{'}(x)$ | $g(x)$ | ${g}^{'}(x)$ |\n| --- | --- | --- | --- | --- |\n| $2$ | $7$ | $-3$ | $6$ | $1$ |\n| $4$ | $2$ | $1$ | $-2$ | $-4$ |" :question/worked-solution "The formula for the derivative of the inverse ${f}^{-1}(x)$ is\n\n$$\n({f}^{-1})^{'}(x)=\\frac{1}{{f}^{'}({f}^{-1}(x))}.\n$$\n\nUsing this, and the product rule, the derivative of the function $g(x){f}^{-1}(x)$ is\n\n$$\n(g\\cdot {f}^{-1})^{'}(x)={g}^{'}(x){f}^{-1}(x)+\\frac{g(x)}{{f}^{'}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=2,$ we have\n\n$$\n(g\\cdot {f}^{-1})^{'}(2)={g}^{'}(2){f}^{-1}(2)+\\frac{g(2)}{{f}^{'}({f}^{-1}(2))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(2)=4,$ $g(2)=6,$ ${g}^{'}(2)=1,$ and ${f}^{'}(4)=1.$ Therefore,\n\n$$\n\\begin{aligned}(g\\cdot {f}^{-1})^{'}(2) & ={g}^{'}(2){f}^{-1}(2)+\\frac{g(2)}{{f}^{'}({f}^{-1}(2))} \\\\  & =1\\cdot 4+\\frac{6}{{f}^{'}(4)} \\\\  & =4+\\frac{6}{1} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261682 :knowledge-point/_questions [{:knowledge-point/id #uuid "d107785c-82d2-5dbf-9293-e66fad67ba54" :knowledge-point/title "Evaluating One-Sided Infinite Limits of Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d43e599-e193-58eb-b9db-3965caf6b618" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273656} {:answer/id #uuid "b0429554-0f47-5119-ac2d-e1d991ccaed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186273657} {:answer/id #uuid "dc2e9e26-57ec-5e81-a96e-5903a869c037" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186273658} {:answer/id #uuid "b03dcee2-78d6-5bf5-a9f4-f0dd2948a576" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273659} {:answer/id #uuid "b68056a6-dae6-5123-87e7-ab65621d5c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186273660}] :answer-field/correct {:answer/id #uuid "b68056a6-dae6-5123-87e7-ab65621d5c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186273660} :answer-field/id #uuid "19a278c8-4e6a-53f5-8329-b66e0420f51e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275015}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "de58437a-9fdc-5e47-b0e7-6387572b12ab" :question/math-academy-id "q-78101" :question/problem "Calculate ${lim}_{x\\to {2}^{-}}{log}_{4}(2-x).$" :question/worked-solution "Let's sketch the graph of $y={log}_{4}(2-x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/26fc43bf5d0d715faa38704ef48813392e9e55e84b519174c96fb4cfa8550350.png)\n\nThe function is not defined for $x\\ge 2.$ Therefore,\n\n$$\n{lim}_{x\\to {2}^{+}}{log}_{4}(2-x)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x<2.$ Moreover,\n\n$$\n{lim}_{x\\to {2}^{-}}{log}_{4}(2-x)=-\\infty .\n$$"}] [{:db/id #edb/ref 17592186261851 :knowledge-point/_questions [{:knowledge-point/id #uuid "c21c1eca-cf80-56bd-9f44-aab7989cb210" :knowledge-point/title "The Root of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312fc946-1f18-5d73-9d29-659aac1ee745" :answer/type {:db/ident :answer.type/math} :answer/value "-(-\\frac{1}{6})" :db/id #edb/ref 17592186273828} {:answer/id #uuid "473d18af-6c4a-5141-a3be-524b211780c8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186273829} {:answer/id #uuid "5b9a26eb-5f68-53d9-b3b4-960f17c1b53c" :answer/type {:db/ident :answer.type/math} :answer/value "2(-\\frac{1}{6})" :db/id #edb/ref 17592186273830} {:answer/id #uuid "c8a74b32-0699-50d4-94ce-afe57cbf4a30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-\\frac{1}{6})" :db/id #edb/ref 17592186273831} {:answer/id #uuid "07191ba0-4ebe-54ba-8fbf-882c8df29bb5" :answer/type {:db/ident :answer.type/math} :answer/value "3(-\\frac{1}{6})" :db/id #edb/ref 17592186273832}] :answer-field/correct {:answer/id #uuid "473d18af-6c4a-5141-a3be-524b211780c8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186273829} :answer-field/id #uuid "705b27e6-41c2-53ba-87cf-800b81660fa7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275050}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "01cf8919-1e7e-525e-9677-8521240a49d2" :question/math-academy-id "q-82003" :question/problem "Find the root of $f(x)=4{log}_{4}(-3x)+2.$" :question/worked-solution "To find the root of $f(x)$, we must solve $f(x)=0:$\n\n$$\n4{log}_{4}(-3x)+2=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}4{log}_{4}(-3x)+2 & =0 \\\\ 4{log}_{4}(-3x) & =-2 \\\\ {log}_{4}(-3x) & =-\\frac{1}{2} \\\\ {4}^{{log}_{4}(-3x)} & ={4}^{-1/2} \\\\ -3x & =\\frac{1}{{4}^{1/2}} \\\\ -3x & =\\frac{1}{2} \\\\ x & =-\\frac{1}{6}.\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-\\frac{1}{6}.$"}] [{:db/id #edb/ref 17592186261995 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8706351-f017-574d-8374-2cc8aa63a1f5" :answer/type {:db/ident :answer.type/math} :answer/value "2(17)" :db/id #edb/ref 17592186273978} {:answer/id #uuid "41cdc5a5-5b97-5d50-a268-f2ef777c05b8" :answer/type {:db/ident :answer.type/math} :answer/value "-(17)" :db/id #edb/ref 17592186273979} {:answer/id #uuid "e3084c63-e5b3-55c2-8b13-dee13ee93062" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186273980} {:answer/id #uuid "5ac7d4fa-47e2-5156-99d3-2a072dee49a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(17)" :db/id #edb/ref 17592186273981} {:answer/id #uuid "a46c2fed-5d00-5272-a744-4eab1c4e9a94" :answer/type {:db/ident :answer.type/math} :answer/value "3(17)" :db/id #edb/ref 17592186273982}] :answer-field/correct {:answer/id #uuid "e3084c63-e5b3-55c2-8b13-dee13ee93062" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186273980} :answer-field/id #uuid "f82bf711-4159-57eb-9b74-0497b00e0d4d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275080}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "915a85d2-04ba-5d69-9940-b94e85fbc1dd" :question/math-academy-id "q-93100" :question/problem "Find the root of $f(x)=3\\sqrt[6]{3x+13}-6.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n3\\sqrt[6]{3x+13}-6=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}3\\sqrt[6]{3x+13}-6 & =0 \\\\ 3\\sqrt[6]{3x+13} & =6 \\\\ \\sqrt[6]{3x+13} & =2 \\\\ (\\sqrt[6]{3x+13})^{6} & ={2}^{6} \\\\ 3x+13 & =64 \\\\ 3x & =51 \\\\ x & =17\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}3\\sqrt[6]{3\\cdot 17+13}-6 & =0 \\\\ 3\\sqrt[6]{64}-6 & =0 \\\\ 3\\cdot 2-6 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=17.$"}] [{:db/id #edb/ref 17592186262010 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b0bc67-9e69-591a-af43-9f9d6f672b43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186262012}] :answer-field/correct {:answer/id #uuid "27b0bc67-9e69-591a-af43-9f9d6f672b43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186262012} :answer-field/id #uuid "52b95d39-7d74-5974-8d4e-39079c7d9ed6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262011}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "04859e81-899a-55b9-b72c-cdf329ab2df5" :question/math-academy-id "q-956" :question/problem "Calculate ${log}_{8}(32)$ without using a calculator.\n\nAnswer: {{answer}}" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=8,$ and $X=32.$ Since both $a$ and $X$ are powers of $2,$ we set $b=2.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{8}(32) & =\\frac{{log}_{2}(32)}{{log}_{2}(8)} \\\\  & =\\frac{{log}_{2}({2}^{5})}{{log}_{2}({2}^{3})} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262151 :knowledge-point/_questions [{:knowledge-point/id #uuid "d107785c-82d2-5dbf-9293-e66fad67ba54" :knowledge-point/title "Evaluating One-Sided Infinite Limits of Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32cde937-55c0-555d-b47e-683d3bc5728a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186274078} {:answer/id #uuid "47261a2b-fa43-5491-b6cd-a8fa0c17cd07" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186274079} {:answer/id #uuid "75b6eaf4-2d1d-54a2-95ae-17a0ed5d602a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186274080} {:answer/id #uuid "7550331f-6f88-5b13-8b4e-37001fa48cd9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274081} {:answer/id #uuid "4ca968fc-e2c5-55f8-8181-72df5a8603f2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186274082}] :answer-field/correct {:answer/id #uuid "4ca968fc-e2c5-55f8-8181-72df5a8603f2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186274082} :answer-field/id #uuid "2c9ec4f1-b8c4-548f-925c-cb7b245d1b5f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275100}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1e99c216-eff2-5527-8eae-389675afcfda" :question/math-academy-id "q-99659" :question/problem "${lim}_{x\\to (-1)^{+}}{log}_{7}(-x-1)=$" :question/worked-solution "Let's sketch the graph of $y={log}_{7}(-x-1).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3ab8924d6d0f1be64e7b664f0a68e5d75c7721f7ac804241ecb311c8a7a4f095.png)\n\nThe function is not defined for $x\\ge -1.$ Therefore,\n\n$$\n{lim}_{x\\to (-1)^{+}}{log}_{7}(-x-1)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x<-1.$ Moreover,\n\n$$\n{lim}_{x\\to (-1)^{-}}{log}_{7}(-x-1)=-\\infty .\n$$"}]}
