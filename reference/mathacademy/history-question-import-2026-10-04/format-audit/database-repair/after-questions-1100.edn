#{[{:db/id #edb/ref 17592186256550 :knowledge-point/_questions [{:knowledge-point/id #uuid "37248a2e-6deb-5b4c-af42-51c358f21110" :knowledge-point/title "Finding a Union of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf7a484-21ad-51d5-836f-e11d87290fde" :answer/type {:db/ident :answer.type/math} :answer/value "\\{o,p,q,r,v,w\\}" :db/id #edb/ref 17592186269467} {:answer/id #uuid "a6328ac7-d894-590c-a4b3-bb865ce3e2c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\{o,p,q,r,v\\}" :db/id #edb/ref 17592186269468} {:answer/id #uuid "2f766a8a-3d53-58c9-a4bc-29f1b15c87d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{p,q,r,v,w\\}" :db/id #edb/ref 17592186269469} {:answer/id #uuid "12496af1-0dbd-5866-86bc-882dec2709da" :answer/type {:db/ident :answer.type/math} :answer/value "\\{o,p,q,r,v,w,0\\}" :db/id #edb/ref 17592186269470} {:answer/id #uuid "38cd5d8b-a02b-560b-9ff5-3c00b8f8fcee" :answer/type {:db/ident :answer.type/math} :answer/value "\\{o,p,q,r,v,0\\}" :db/id #edb/ref 17592186269471}] :answer-field/correct {:answer/id #uuid "7bf7a484-21ad-51d5-836f-e11d87290fde" :answer/type {:db/ident :answer.type/math} :answer/value "\\{o,p,q,r,v,w\\}" :db/id #edb/ref 17592186269467} :answer-field/id #uuid "41e781f4-d569-5799-a9c2-50c89f39e710" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274168}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "63afb8fc-ab5c-5b73-8ab7-253c50b7871e" :question/math-academy-id "q-102051" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1f3d0b514bc4ec701b6ac755b82cec7246a7a819400108e1733759eb0a2fec86.png)\n\nGiven the sets $A={o,p,q,r}$ and $B={q,r,v,w},$ find $A\\cup B.$" :question/worked-solution "The union $A\\cup B$ consists of all the elements that are in either $A$ or $B,$ or both. To represent $A\\cup B,$ we will shade in all the area that is contained in either $A$ or $B,$ or both.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7984b0cb81df816388aa0d5cbf860fc4bdad9f7e871e8671d4616ded02bcaf5b.png)\n\nThe elements $o,p,q,r,v,w$ are in either $A$ or $B$, or both. Therefore, the union of $A$ and $B$ is\n\n$$\nA\\cup B={o,p,q,r,v,w}.\n$$"}] [{:db/id #edb/ref 17592186256553 :knowledge-point/_questions [{:knowledge-point/id #uuid "65d40bd9-4d35-5e07-a767-8b2ae6ba559a" :knowledge-point/title "Finding a Union of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8e34632-ce26-5b4b-b565-b6ea74d08628" :answer/type {:db/ident :answer.type/math} :answer/value "\\{23,28,33,36,48,0\\}" :db/id #edb/ref 17592186269472} {:answer/id #uuid "93c271de-08ab-54b3-acaa-373a8744ac01" :answer/type {:db/ident :answer.type/math} :answer/value "\\{23,28,33,36,48\\}" :db/id #edb/ref 17592186269473} {:answer/id #uuid "a425aaf1-2924-5ba8-ba30-d8c29c920024" :answer/type {:db/ident :answer.type/math} :answer/value "\\{23,28,33,36,48,52\\}" :db/id #edb/ref 17592186269474} {:answer/id #uuid "cab2a67b-f553-51ce-bdf5-99f22334e09a" :answer/type {:db/ident :answer.type/math} :answer/value "\\{28,33,36,48,52\\}" :db/id #edb/ref 17592186269475} {:answer/id #uuid "252152a9-eb61-5bf9-ab81-9ad42b559672" :answer/type {:db/ident :answer.type/math} :answer/value "\\{23,28,33,36,48,52,0\\}" :db/id #edb/ref 17592186269476}] :answer-field/correct {:answer/id #uuid "a425aaf1-2924-5ba8-ba30-d8c29c920024" :answer/type {:db/ident :answer.type/math} :answer/value "\\{23,28,33,36,48,52\\}" :db/id #edb/ref 17592186269474} :answer-field/id #uuid "3f3c154b-1744-5d9c-aeb6-dfe49f24b92a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "883f571c-63e8-52a3-8d1c-45c027a3154a" :question/math-academy-id "q-102071" :question/problem "If $X={23,28,33,48}$ and $Y={28,36,52}$, then $X\\cup Y=$" :question/worked-solution "The set $X\\cup Y$ is the set of all elements belonging to either $X$ or $Y,$ or both. So, we have\n\n$$\n\\begin{aligned}X\\cup Y & ={23,28,33,48}\\cup {28,36,52} \\\\  & ={23,28,33,36,48,52}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256556 :knowledge-point/_questions [{:knowledge-point/id #uuid "953e79cf-c216-5d4b-a056-455f76e7fa87" :knowledge-point/title "Finding an Intersection of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34bb3489-9497-5cba-bc36-1418f549e341" :answer/type {:db/ident :answer.type/math} :answer/value "{10}" :db/id #edb/ref 17592186269477} {:answer/id #uuid "6c309148-6c86-5759-b3cc-f11163224f82" :answer/type {:db/ident :answer.type/math} :answer/value "2({10})" :db/id #edb/ref 17592186269478} {:answer/id #uuid "498f6dc1-6d0d-53e2-ab1b-a312f6be3d78" :answer/type {:db/ident :answer.type/math} :answer/value "{5}" :db/id #edb/ref 17592186269479} {:answer/id #uuid "0b3ca37f-e27d-53ae-8d78-03c0fc3ae7d3" :answer/type {:db/ident :answer.type/math} :answer/value "-({10})" :db/id #edb/ref 17592186269480} {:answer/id #uuid "d5a5678e-fc43-514c-8631-75938a7e00b5" :answer/type {:db/ident :answer.type/math} :answer/value "3({10})" :db/id #edb/ref 17592186269481}] :answer-field/correct {:answer/id #uuid "34bb3489-9497-5cba-bc36-1418f549e341" :answer/type {:db/ident :answer.type/math} :answer/value "{10}" :db/id #edb/ref 17592186269477} :answer-field/id #uuid "647c8692-c290-53c3-8f04-817c6c5a4449" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274170}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fde102b2-05fb-5f0b-a8aa-3b7a81681d73" :question/math-academy-id "q-102077" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e495695d9def7518780fb2b9e44f11e890da4c70c2dff7c6525936b2684219e1.png)\n\nGiven the sets $S={8,10,11}$ and $T={10,12,15},$ find $S\\cap T.$" :question/worked-solution "The intersection $S\\cap T$ consists of all the elements that are in both $S$ and $T.$ To represent $S\\cap T,$ we will shade in all the area that is contained in both $S$ and $T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/5f807aaf7a026cc52f53f4a5f50afab269da5f2dfdcb835f6166891ada864f72.png)\n\nOnly the element $10$ is in both $S$ and $T.$ Therefore, the intersection of $S$ and $T$ is\n\n$$\nS\\cap T={10}.\n$$"}] [{:db/id #edb/ref 17592186256569 :knowledge-point/_questions [{:knowledge-point/id #uuid "70b0ef91-c5ed-5e5d-a777-dea3ae515aed" :knowledge-point/title "Finding an Intersection of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8686f9ff-7dd5-5ce1-964e-a306d97cf1e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{15,17\\}" :db/id #edb/ref 17592186269482} {:answer/id #uuid "fd765d1d-1d22-5b10-8dca-f3ce4241eaab" :answer/type {:db/ident :answer.type/math} :answer/value "\\{15,0\\}" :db/id #edb/ref 17592186269483} {:answer/id #uuid "4274cbee-6517-5c54-9f44-d458fb9a459e" :answer/type {:db/ident :answer.type/math} :answer/value "\\{15\\}" :db/id #edb/ref 17592186269484} {:answer/id #uuid "d63e7cc0-6fc0-5778-961e-0ca9b9ff6647" :answer/type {:db/ident :answer.type/math} :answer/value "\\{15,17,0\\}" :db/id #edb/ref 17592186269485} {:answer/id #uuid "cab4e4d1-91f5-52c5-826c-065899384c18" :answer/type {:db/ident :answer.type/math} :answer/value "\\{17\\}" :db/id #edb/ref 17592186269486}] :answer-field/correct {:answer/id #uuid "8686f9ff-7dd5-5ce1-964e-a306d97cf1e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\{15,17\\}" :db/id #edb/ref 17592186269482} :answer-field/id #uuid "8098e216-aa44-5f5a-ac10-d96125ff4eb3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274171}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4b16d38-0e29-5036-a451-a2e4f5753235" :question/math-academy-id "q-102119" :question/problem "If $A={13,15,17,21}$ and $B={15,16,17,18},$ then $A\\cap B=$" :question/worked-solution "The set $A\\cap B$ is the set of all elements belonging to both $A$ and $B.$ Since $A$ and $B$ have only the elements $15$ and $17$ in common, we obtain\n\n$$\n\\begin{aligned}A\\cap B & ={13,15,17,21}\\cap {15,16,17,18} \\\\  & ={15,17}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256572 :knowledge-point/_questions [{:knowledge-point/id #uuid "03cc876e-66d5-51af-ad8d-6c20bc599609" :knowledge-point/title "Finding Unions of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7223c492-b26c-5b2c-8912-3889d4de33e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{2,4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269487} {:answer/id #uuid "d8f33c4f-64ff-5b00-a419-46cb4e8fde60" :answer/type {:db/ident :answer.type/math} :answer/value "\\{4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269488} {:answer/id #uuid "065e0a57-7dc6-5a7f-9fdf-c27b1e405dba" :answer/type {:db/ident :answer.type/math} :answer/value "\\{1,4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269489} {:answer/id #uuid "ea83396a-3160-543a-afbb-da501d271918" :answer/type {:db/ident :answer.type/math} :answer/value "\\{3,4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269490} {:answer/id #uuid "c63a9e1a-1824-5e7a-81bb-1079aee92adf" :answer/type {:db/ident :answer.type/math} :answer/value "\\{6,4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269491}] :answer-field/correct {:answer/id #uuid "d8f33c4f-64ff-5b00-a419-46cb4e8fde60" :answer/type {:db/ident :answer.type/math} :answer/value "\\{4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,\\ldots\\}" :db/id #edb/ref 17592186269488} :answer-field/id #uuid "6bde8527-4f26-5e7e-9bc0-98aa17a5c6dc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274172}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4c01791-56db-55fe-a66c-3347a83865ab" :question/math-academy-id "q-102146" :question/problem "Let $A$ and $B$ be the set of all multiples of $4$ greater than $0$ and the set of all multiples of $5$ greater than $0,$ respectively. What is $A\\cup B?$" :question/worked-solution "The multiples of $4$ that are greater than $0$ are\n\n$$\nA={4,8,12,16,20,24,28,32,36,40,44,48,…}.\n$$\n\nLikewise, multiples of $5$ that are greater than $0$ are\n\n$$\nB={5,10,15,20,25,30,…}.\n$$\n\nNow, $A\\cup B$ is the *union* of $A$ and $B,$ which means that we want to find the elements that are in either $A$ or $B,$ or both. In other words, $A\\cup B$ denotes the set of natural numbers that are either multiple of $4$ or multiple of $5.$ So, we have\n\n$$\n\\begin{aligned}A\\cup B & ={4,8,12,16,20,24,28,32,36,40,44,48,…}\\cup {5,10,15,20,25,30,…} \\\\  & ={4,5,8,10,12,15,16,20,24,25,28,30,32,35,36,40,…}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256578 :knowledge-point/_questions [{:knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97173655-3dea-5fd5-bc66-1b3bfc4400d4" :answer/type {:db/ident :answer.type/math} :answer/value "3(18\\,\\text{in})" :db/id #edb/ref 17592186269497} {:answer/id #uuid "faaf8528-7558-5728-89ec-68102a96eb9e" :answer/type {:db/ident :answer.type/math} :answer/value "2(18\\,\\text{in})" :db/id #edb/ref 17592186269498} {:answer/id #uuid "a081d586-2860-54b4-8896-3d848a4fe833" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\text{in}" :db/id #edb/ref 17592186269499} {:answer/id #uuid "3be39be9-a315-5a4f-9b8f-63bb08f828fa" :answer/type {:db/ident :answer.type/math} :answer/value "-(18\\,\\text{in})" :db/id #edb/ref 17592186269500} {:answer/id #uuid "5ce7fbe3-3d8a-5ab8-8097-a061e2d660ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(18\\,\\text{in})" :db/id #edb/ref 17592186269501}] :answer-field/correct {:answer/id #uuid "a081d586-2860-54b4-8896-3d848a4fe833" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\text{in}" :db/id #edb/ref 17592186269499} :answer-field/id #uuid "6ea1eeb1-3f42-543d-a3ac-5910cf25b634" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274174}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9ca0f34d-dd75-5cc4-8c72-6f6261fa4014" :question/math-academy-id "q-10229" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/70fc259b5863513eabaf6b67eeb5e6b8debcb40d4a91d096f6515cb9f2efe642.png)\n\nDetermine the length of the rectangular solid above given that its volume is $720\\,{\\text{in}}^{3}.$" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nV=720,\\,w=5,\\,h=8\n$$\n\ninto the formula, we obtain the following\n\n$$\n\\begin{aligned}720 & =l\\cdot 5\\cdot 8 \\\\ 720 & =40l \\\\ l & =18\\end{aligned}\n$$\n\nTherefore, the length is $18\\,\\text{in}.$"}] [{:db/id #edb/ref 17592186256581 :knowledge-point/_questions [{:knowledge-point/id #uuid "70b0ef91-c5ed-5e5d-a777-dea3ae515aed" :knowledge-point/title "Finding an Intersection of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3dabc45-7ec9-55ba-845d-9083e7388fbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\{f,i\\}" :db/id #edb/ref 17592186269502} {:answer/id #uuid "4a0d7665-dbaf-5966-a3fc-53bc7e896fa7" :answer/type {:db/ident :answer.type/math} :answer/value "\\{a,f\\}" :db/id #edb/ref 17592186269503} {:answer/id #uuid "f678c319-f162-5b10-b42f-cc8860ed5712" :answer/type {:db/ident :answer.type/math} :answer/value "\\{a,f,0\\}" :db/id #edb/ref 17592186269504} {:answer/id #uuid "1b4c78d8-0a5e-5a09-bd3d-cae6a3d3f986" :answer/type {:db/ident :answer.type/math} :answer/value "\\{a,f,i,0\\}" :db/id #edb/ref 17592186269505} {:answer/id #uuid "66b272c1-fef6-52f2-8c58-5df56db44e23" :answer/type {:db/ident :answer.type/math} :answer/value "\\{a,f,i\\}" :db/id #edb/ref 17592186269506}] :answer-field/correct {:answer/id #uuid "66b272c1-fef6-52f2-8c58-5df56db44e23" :answer/type {:db/ident :answer.type/math} :answer/value "\\{a,f,i\\}" :db/id #edb/ref 17592186269506} :answer-field/id #uuid "44a16ab2-29b9-587a-904a-d687348352ac" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274175}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a33d78df-c474-59f3-94e1-c9f5996f520b" :question/math-academy-id "q-102332" :question/problem "If $A={a,c,d,f,g,i}$ and $B={a,b,e,f,h,i,j},$ then $A\\cap B=$" :question/worked-solution "The set $A\\cap B$ is the set of all elements belonging to both $A$ and $B.$ Since $A$ and $B$ have only the elements $a,$ $f,$ and $i$ in common, we obtain\n\n$$\n\\begin{aligned}A\\cap B & ={a,c,d,f,g,i}\\cap {a,b,e,f,h,i,j} \\\\  & ={a,f,i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256603 :knowledge-point/_questions [{:knowledge-point/id #uuid "452d826b-4cb3-56e1-989a-b025b5d5c955" :knowledge-point/title "Choosing a Parameter to Force a Desired Number of Solutions to a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc090ffd-c718-5a21-a32a-f74e929ade5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-60,60\\}" :db/id #edb/ref 17592186269522} {:answer/id #uuid "c7a0278c-f6c4-5690-8035-9d1841ace918" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-60)-2,60\\}" :db/id #edb/ref 17592186269523} {:answer/id #uuid "1a5d7f2b-c1a5-5f76-8b55-ceb20c267bb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-60)+1,60\\}" :db/id #edb/ref 17592186269524} {:answer/id #uuid "5157853c-87fc-55c2-8942-5289aa8e42d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-60)-1,60\\}" :db/id #edb/ref 17592186269525} {:answer/id #uuid "bf0e1fa7-dcf7-522d-a2df-19a4401d6b56" :answer/type {:db/ident :answer.type/math} :answer/value "\\{(-60)+2,60\\}" :db/id #edb/ref 17592186269526}] :answer-field/correct {:answer/id #uuid "dc090ffd-c718-5a21-a32a-f74e929ade5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\{-60,60\\}" :db/id #edb/ref 17592186269522} :answer-field/id #uuid "ce2e6353-0f9c-5f2f-8b42-50b03d579d00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274179}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a8ca7739-ac12-5a8f-a94e-0d532b4daccf" :question/math-academy-id "q-10318" :question/problem "Find the values of $k$ for which the quadratic equation $-15{x}^{2}+kx-60=0$  has one distinct real solution." :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=-15,$ $b=k,$ and $c=-60,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(k)^{2}-4(-15)(-60) \\\\  & ={k}^{2}-3\\,600\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D=0 \\\\ {k}^{2}-3600 & =0 \\\\ {k}^{2} & =3600 \\\\ k & =\\pm \\sqrt{3600} \\\\ k & =\\pm 60\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=\\pm 60.$"}] [{:db/id #edb/ref 17592186256717 :knowledge-point/_questions [{:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03" :knowledge-point/title "Finding a Cubic Polynomial Given One Real Root, Two Complex Roots, and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa5c9fb-3c1b-5d14-8255-c6bf154b4234" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3} − 2x^{2} + 3x − 7" :db/id #edb/ref 17592186269637} {:answer/id #uuid "a35fda44-fc7c-509c-b0ca-c27cf79f93a9" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+3x+30" :db/id #edb/ref 17592186269638} {:answer/id #uuid "3bc2cf37-62cf-5599-b201-857444c8d7b9" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{3} − 6x^{2} + 48" :db/id #edb/ref 17592186269639} {:answer/id #uuid "7c1f6e6c-fc9f-5ec3-8021-65954c3e8ad2" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3} − 5x^{2} + 6x − 14" :db/id #edb/ref 17592186269640} {:answer/id #uuid "2407cb52-3c0e-58d3-b1b6-ba3a7233012e" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{3} + 6x^{2} − 12" :db/id #edb/ref 17592186269641}] :answer-field/correct {:answer/id #uuid "a35fda44-fc7c-509c-b0ca-c27cf79f93a9" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+3x+30" :db/id #edb/ref 17592186269638} :answer-field/id #uuid "ec1b26ce-be0a-51d0-90b3-f55de8904edf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274202}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "091a471e-7959-5ecb-b617-deff448e5df9" :question/math-academy-id "q-107542" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-2,{x}_{2,3}=1\\pm 2\\text{i},$ and the coefficient of the cubic term is $3.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-2$ and ${x}_{2,3}=1\\pm 2\\text{i},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =3(x-(-2))(x-(1+2\\text{i}))(x-(1-2\\text{i})) \\\\  & =3(x+2)(x-(1+2\\text{i}))(x-(1-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+2)(x-(1+2\\text{i}))(x-(1-2\\text{i})) & = \\\\ 3(x+2)({x}^{2}-x(1+2\\text{i})-x(1-2\\text{i})+(1+2\\text{i})(1-2\\text{i})) & = \\\\ 3(x+2)({x}^{2}-2x+5) & = \\\\ 3({x}^{3}+2{x}^{2}-2{x}^{2}-4x+5x+10) & = \\\\ 3({x}^{3}+x+10) & = \\\\ 3{x}^{3}+3x+30 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{3}+3x+30.$"}] [{:db/id #edb/ref 17592186256720 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87cff0dc-ecc8-5982-9453-47c4ec65c7a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(25\\sqrt{6}\\,{\\text{m}}^{3})" :db/id #edb/ref 17592186269642} {:answer/id #uuid "fb37676e-517d-5ff3-8504-2b4fcad4e29a" :answer/type {:db/ident :answer.type/math} :answer/value "3(25\\sqrt{6}\\,{\\text{m}}^{3})" :db/id #edb/ref 17592186269643} {:answer/id #uuid "c5b2292b-fc94-517c-b338-f717298897ba" :answer/type {:db/ident :answer.type/math} :answer/value "25\\sqrt{6}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186269644} {:answer/id #uuid "915308be-adf6-5987-8966-ba3f0692d814" :answer/type {:db/ident :answer.type/math} :answer/value "-(25\\sqrt{6}\\,{\\text{m}}^{3})" :db/id #edb/ref 17592186269645} {:answer/id #uuid "38b76b6d-409a-5ff8-a908-2dbdc5f1b287" :answer/type {:db/ident :answer.type/math} :answer/value "2(25\\sqrt{6}\\,{\\text{m}}^{3})" :db/id #edb/ref 17592186269646}] :answer-field/correct {:answer/id #uuid "c5b2292b-fc94-517c-b338-f717298897ba" :answer/type {:db/ident :answer.type/math} :answer/value "25\\sqrt{6}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186269644} :answer-field/id #uuid "8a0a1c90-197c-5861-950c-aba0bb49be32" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "632cef4f-7740-505b-810d-f1a534b0a2cb" :question/math-academy-id "q-107615" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/02a014f78ffde4ae39fb76e4fff32fd4e8789d436f296ee865f2be220dce549e.png)\n\nFind the volume of the rectangular prism shown above." :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=5\\,\\text{m},\\,w=\\sqrt{10}\\,\\text{m},\\,h=\\sqrt{15}\\,\\text{m}\n$$\n\ninto the formula, we obtain\n\n$$\nV=5\\cdot \\sqrt{10}\\cdot \\sqrt{15}=5\\sqrt{150}=25\\sqrt{6}\\,{\\text{m}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186256723 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e67e0e6f-1455-55b6-b3ef-8c8103cb6937" :answer/type {:db/ident :answer.type/math} :answer/value "90\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186269647} {:answer/id #uuid "9a3e8267-b4fb-5e46-a846-4a29e5f333e3" :answer/type {:db/ident :answer.type/math} :answer/value "-(90\\,{\\text{yd}}^{3})" :db/id #edb/ref 17592186269648} {:answer/id #uuid "c85f8f5e-452c-5356-b6f9-207a18516147" :answer/type {:db/ident :answer.type/math} :answer/value "3(90\\,{\\text{yd}}^{3})" :db/id #edb/ref 17592186269649} {:answer/id #uuid "0a011a54-f713-5301-9384-00e0e5fe6943" :answer/type {:db/ident :answer.type/math} :answer/value "2(90\\,{\\text{yd}}^{3})" :db/id #edb/ref 17592186269650} {:answer/id #uuid "b1ea4cba-e357-5ddd-9299-fc7f4607cf48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(90\\,{\\text{yd}}^{3})" :db/id #edb/ref 17592186269651}] :answer-field/correct {:answer/id #uuid "e67e0e6f-1455-55b6-b3ef-8c8103cb6937" :answer/type {:db/ident :answer.type/math} :answer/value "90\\,{\\text{yd}}^{3}" :db/id #edb/ref 17592186269647} :answer-field/id #uuid "0538e02f-1c07-571d-a437-fa6c01271e82" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274204}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f5a4ef33-833f-5eec-8f1e-c354f2635505" :question/math-academy-id "q-107618" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e32666f4e9aa77a69d85c0380d2dd9451d53f7c82111aaa60c5bed3e8694977d.png)\n\nFind the volume of the rectangular prism shown above." :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=6\\,\\text{yd},\\,w=5\\,\\text{yd},\\,h=3\\,\\text{yd}\n$$\n\ninto the formula, we obtain\n\n$$\nV=6\\cdot 5\\cdot 3=90\\,{\\text{yd}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186256726 :knowledge-point/_questions [{:knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7660d87a-39a7-5411-b020-00a43c58511c" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\text{yd}" :db/id #edb/ref 17592186269652} {:answer/id #uuid "3fba8642-10a4-5a0f-aa4b-3a6c7b85aad7" :answer/type {:db/ident :answer.type/math} :answer/value "-(7\\,\\text{yd})" :db/id #edb/ref 17592186269653} {:answer/id #uuid "79831f3b-3a5d-5ceb-a163-12b2d7f52047" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7\\,\\text{yd})" :db/id #edb/ref 17592186269654} {:answer/id #uuid "b5bce81f-2770-5f3a-8cfc-ac29e9928976" :answer/type {:db/ident :answer.type/math} :answer/value "2(7\\,\\text{yd})" :db/id #edb/ref 17592186269655} {:answer/id #uuid "946c0274-4114-51fa-99a3-e7b53317c917" :answer/type {:db/ident :answer.type/math} :answer/value "3(7\\,\\text{yd})" :db/id #edb/ref 17592186269656}] :answer-field/correct {:answer/id #uuid "7660d87a-39a7-5411-b020-00a43c58511c" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\text{yd}" :db/id #edb/ref 17592186269652} :answer-field/id #uuid "1937cae6-9f08-56e7-8179-99360c898142" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274205}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "334c2f91-1d22-56da-8cb1-a0b5225f3f04" :question/math-academy-id "q-107629" :question/problem "The length of a rectangular solid is $8\\,\\text{yd}$ and its volume is $392\\,{\\text{yd}}^{3}.$ If the side face (width x height) of the solid is a square, find the width of the solid." :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSince the side face of the rectangular solid is a square, we have that \n\n$$\nw=h.\n$$\n\nSubstituting \n\n$$\nV=392,\\,l=8,\\,h=w\n$$\n\ninto the formula, we obtain the following:\n\n$$\n\\begin{aligned}V & =lwh \\\\ V & =l{w}^{2} \\\\ 392 & =8\\cdot {w}^{2} \\\\ {w}^{2} & =49 \\\\ w & =7\\end{aligned}\n$$\n\nTherefore, the width is $7\\,\\text{yd}.$"}] [{:db/id #edb/ref 17592186256742 :knowledge-point/_questions [{:knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b888cb9-fb61-5a8e-928f-eb9835a27b5d" :answer/type {:db/ident :answer.type/math} :answer/value "-(45\\,{\\text{in}}^{3})" :db/id #edb/ref 17592186269667} {:answer/id #uuid "411127b8-c2f1-5bc2-8344-c9790da5bd97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(45\\,{\\text{in}}^{3})" :db/id #edb/ref 17592186269668} {:answer/id #uuid "3174bbe2-5ef0-59b6-8932-fbfda5fc8305" :answer/type {:db/ident :answer.type/math} :answer/value "2(45\\,{\\text{in}}^{3})" :db/id #edb/ref 17592186269669} {:answer/id #uuid "3c3d23f8-445b-55ac-af43-40ec3fd7dcf6" :answer/type {:db/ident :answer.type/math} :answer/value "45\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186269670} {:answer/id #uuid "26b54e7c-f1e6-594f-b89a-99acb22c9a30" :answer/type {:db/ident :answer.type/math} :answer/value "3(45\\,{\\text{in}}^{3})" :db/id #edb/ref 17592186269671}] :answer-field/correct {:answer/id #uuid "3c3d23f8-445b-55ac-af43-40ec3fd7dcf6" :answer/type {:db/ident :answer.type/math} :answer/value "45\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186269670} :answer-field/id #uuid "78e44cec-0009-589f-9b16-0e2bcf1caeb7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274208}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a3bf6537-6bba-55c4-8bda-93d506025b1f" :question/math-academy-id "q-107712" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/03a606251639b69e722613f9c2ccbe2bd576633a1051b4e1abeeecf33f90ad18.png)\n\nThe diagram above shows a milk carton. Three-eighths of the carton is filled with milk, forming a cube. Find the volume of the empty space in the carton." :question/worked-solution "The milk in the carton creates a cube. Since the height of the milk is $3\\,\\text{in},$ the side length of the cube is also $3\\,\\text{in}.$\n\nAlso, the height of $3\\,\\text{in}$ shown in the diagram represents three-eighths of the carton's height. Therefore, the height of the carton is\n\n$$\n\\frac{8}{3}\\cdot 3=8\\,\\text{in}.\n$$\n\nThe empty space in the carton is a rectangular prism that is $3\\,\\text{in}$ long, $3\\,\\text{in}$ wide, and $8-3=5\\,\\text{in}$ high.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=3\\,\\text{in},\\,w=3\\,\\text{in},\\,h=5\\,\\text{in}\n$$\n\ninto the formula, we obtain\n\n$$\nV=3\\cdot 3\\cdot 5=45\\,{\\text{in}}^{3}.\n$$\n\nTherefore, we conclude that there is $45\\,{\\text{in}}^{3}$ of empty space in the carton."}] [{:db/id #edb/ref 17592186256772 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d905f41-5940-547e-b3d2-558c6b881b68" :knowledge-point/title "Determining the Index of a Term in an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7ca1c0e-9830-57d1-87c2-d2f47a0da86d" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186256774}] :answer-field/correct {:answer/id #uuid "e7ca1c0e-9830-57d1-87c2-d2f47a0da86d" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186256774} :answer-field/id #uuid "58811d5d-80b6-5d2c-a9b9-9f2b21d3a4c5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256773}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "97acde06-7ca9-5d94-b594-1bd2bd789eb6" :question/math-academy-id "q-108753" :question/problem "What is the index of the term $104$ in the following arithmetic sequence?\n\n$$\n4,\\,9,\\,14,\\,…\n$$\n\nAnswer: {{answer}}" :question/worked-solution "Since ${a}_{1}=4$ and \n\n$$\nd=9-4=5,\n$$\n\nwe can construct the formula for the $n$th term as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(5) \\\\  & =4+5n-5 \\\\  & =5n-1\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives ${a}_{n}=104,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =5n-1 \\\\ 104 & =5n-1 \\\\ 105 & =5n \\\\ 21 & =n\\end{aligned}\n$$\n\nTherefore, $105$ is the $21$st term of the sequence."}] [{:db/id #edb/ref 17592186256842 :knowledge-point/_questions [{:knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c47e52-4b7d-5629-91e4-150e8ee989b1" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186269815} {:answer/id #uuid "7ffb79aa-175f-508a-b179-2c8a7565a322" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186269816} {:answer/id #uuid "b26c2a6e-282e-57b7-8bb4-721b3b0603eb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186269817} {:answer/id #uuid "ebd31311-5570-501d-9d95-29ac784ac7e5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269818} {:answer/id #uuid "b763984e-d4cf-5796-8b75-916831173640" :answer/type {:db/ident :answer.type/math} :answer/value "− 3" :db/id #edb/ref 17592186269819}] :answer-field/correct {:answer/id #uuid "7ffb79aa-175f-508a-b179-2c8a7565a322" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186269816} :answer-field/id #uuid "c4d6d6b5-2d4b-5d52-9b6d-aeefa697efd6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274238}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "55058b06-dd5d-5caa-a687-35d85c6cc189" :question/math-academy-id "q-111362" :question/problem "Given that  $(3{s}^{2}+2s+4)({s}^{2}+3s+2)=3{s}^{4}+a{s}^{3}+b{s}^{2}+cs+8,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{s}^{2}+2s+4)({s}^{2}+3s+2) & = \\\\ 3{s}^{2}({s}^{2}+3s+2)+(2s)({s}^{2}+3s+2)+(4)({s}^{2}+3s+2) & = \\\\ 3{s}^{4}+9{s}^{3}+6{s}^{2}+2{s}^{3}+6{s}^{2}+4s+4{s}^{2}+12s+8 & = \\\\ 3{s}^{4}+11{s}^{3}+16{s}^{2}+16s+8\\end{aligned}\n$$\n\nTherefore, $a=11,$ $b=16,$ and $c=16.$ So, \n\n$$\na+b+c=11+16+16=43.\n$$"}] [{:db/id #edb/ref 17592186256888 :knowledge-point/_questions [{:knowledge-point/id #uuid "87636457-bdd5-53dd-9137-c070a4e12e84" :knowledge-point/title "Calculating the Discriminant of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58315c39-d15a-5f46-a414-fbb3ae09dc02" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269874} {:answer/id #uuid "681bfb60-d4ce-536d-ab00-ae59816d5ddb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186269875} {:answer/id #uuid "17bbe582-5b70-54fb-b2b4-59231e296786" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186269876} {:answer/id #uuid "74eb27f0-2e60-5121-8701-c8e232e1e2a2" :answer/type {:db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186269877} {:answer/id #uuid "92476e42-f0cc-5be3-82d3-6e6f1f56c6cd" :answer/type {:db/ident :answer.type/math} :answer/value "− 49" :db/id #edb/ref 17592186269878}] :answer-field/correct {:answer/id #uuid "58315c39-d15a-5f46-a414-fbb3ae09dc02" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269874} :answer-field/id #uuid "ef3d22b0-2cc4-509a-bea8-152ed34663f8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274250}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d21dfae-6d8c-52e5-8ced-deddffba77c1" :question/math-academy-id "q-112837" :question/problem "Calculate the discriminant of the quadratic equation $4{x}^{2}-3x=0.$" :question/worked-solution "We have $a=4,$ $b=-3,$ and $c=0.$ So, we calculate the discriminant as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-3)^{2}-4(4)(0) \\\\  & =9-0 \\\\  & =9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256891 :knowledge-point/_questions [{:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f" :knowledge-point/title "Using the Discriminant to Determine the Number of Solutions to a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d79dac43-b5b8-534b-b311-bbd3e32aab82" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269879} {:answer/id #uuid "733aac39-2d6e-53b2-9246-c1fd0e1a3709" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269880} {:answer/id #uuid "349ba926-ca95-5b21-b02a-5a016de809c3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269881} {:answer/id #uuid "b31ab5d3-6d05-541b-af1d-2fd25869748c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269882} {:answer/id #uuid "1753719e-8043-5d25-ac73-f3a5c0e3fcc6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269883}] :answer-field/correct {:answer/id #uuid "349ba926-ca95-5b21-b02a-5a016de809c3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269881} :answer-field/id #uuid "79a0a0d9-dddd-595e-bf0c-5c22e12f9db6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "651268f9-ded3-54c1-9fe8-21b92e019084" :question/math-academy-id "q-112848" :question/problem "Consider the quadratic equation ${x}^{2}-6x+9=0.$ How many distinct real solutions does it have?" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=1,$ $b=-6,$ and $c=9,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-6)^{2}-4(1)(9) \\\\  & =36-36 \\\\  & =0\\end{aligned}\n$$\n\nSince the discriminant is zero $(D=0),$ the equation has one distinct real solution."}] [{:db/id #edb/ref 17592186256894 :knowledge-point/_questions [{:knowledge-point/id #uuid "926a6ba8-ec05-568a-9c13-c9f4d096e89f" :knowledge-point/title "Using the Discriminant to Determine the Number of Solutions to a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11dc1081-12bf-5e3c-b537-2e32ae09dcdc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269884} {:answer/id #uuid "77a3af46-17b4-5373-a025-3c5955c97637" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269885} {:answer/id #uuid "1168ce76-1a47-5e87-8a98-c0c38e057552" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269886} {:answer/id #uuid "de72e508-667f-56c4-8c3d-92ffafcfbacc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269887} {:answer/id #uuid "564f5399-df70-515e-b177-a96d855e1153" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269888}] :answer-field/correct {:answer/id #uuid "1168ce76-1a47-5e87-8a98-c0c38e057552" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269886} :answer-field/id #uuid "7d423179-1dda-55f5-9253-2548882ab978" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274252}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a95f3ae6-2de7-53c9-a211-7238246c0d4d" :question/math-academy-id "q-112849" :question/problem "Consider the quadratic equation $4{x}^{2}-12x+9=0.$ How many distinct real solutions does it have?" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=4,$ $b=-12,$ and $c=9,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-12)^{2}-4(4)(9) \\\\  & =144-144 \\\\  & =0\\end{aligned}\n$$\n\nSince the discriminant is zero $(D=0),$ the equation has one distinct real solution."}] [{:db/id #edb/ref 17592186256912 :knowledge-point/_questions [{:knowledge-point/id #uuid "e77fe2f6-0e93-5378-aa8d-cc6d5122bdaa" :knowledge-point/title "Finding the Roots of a Rational Function With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7162fcce-a6cc-58f7-aebb-b561485b794b" :answer/type {:db/ident :answer.type/math} :answer/value "3(-2)" :db/id #edb/ref 17592186269914} {:answer/id #uuid "59188a80-9988-5f2f-ad47-9c69440203ec" :answer/type {:db/ident :answer.type/math} :answer/value "2(-2)" :db/id #edb/ref 17592186269915} {:answer/id #uuid "82e0e84b-ee44-50d7-9d3d-1462021ef22b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-2)" :db/id #edb/ref 17592186269916} {:answer/id #uuid "3604ef2a-7f61-59c1-984b-8c9803642532" :answer/type {:db/ident :answer.type/math} :answer/value "-(-2)" :db/id #edb/ref 17592186269917} {:answer/id #uuid "89de1a3c-4862-518e-b53f-669f6ac682bb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269918}] :answer-field/correct {:answer/id #uuid "89de1a3c-4862-518e-b53f-669f6ac682bb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269918} :answer-field/id #uuid "b8bbde9a-c89d-5cc0-9007-57bed0b72393" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274258}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee249868-10fd-54ab-8257-c7e4ccf74f80" :question/math-academy-id "q-113092" :question/problem "Find the roots of $f(w)=\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w}.$" :question/worked-solution "The roots of $f(w)$ are the solutions to the equation $f(w)=0.$ In our case, we have\n\n$$\n\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(w) & =\\frac{{w}^{2}-3w-10}{2{w}^{2}-10w} \\\\  & =\\frac{(w+2)(w-5)}{2w(w-5)} \\\\  & =\\frac{(w+2)\\cancel{(w-5)}}{2w\\cancel{(w-5)}} \\\\  & =\\frac{(w+2)}{2w}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $w:$\n\n$$\n\\begin{aligned}w+2 & =0\\,⟹\\,w=-2\\end{aligned}\n$$\n\nTherefore, the solution to $f(w)=0$ is $w=-2.$"}] [{:db/id #edb/ref 17592186256938 :knowledge-point/_questions [{:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2" :knowledge-point/title "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab693bd-1fb1-5510-96d7-fe67f794ef5b" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186269954} {:answer/id #uuid "1c402282-8eec-5304-ace9-a5e8d412fd6e" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186269955} {:answer/id #uuid "3da56e71-80ac-5a44-aad6-e5943a5020dc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269956} {:answer/id #uuid "a96ec762-f658-5100-ac3e-95e7bc27350d" :answer/type {:db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186269957} {:answer/id #uuid "e92ecd02-4edb-5766-ac9e-93f07ffa35f1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186269958}] :answer-field/correct {:answer/id #uuid "e92ecd02-4edb-5766-ac9e-93f07ffa35f1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186269958} :answer-field/id #uuid "c6a2f0ce-014c-5b95-bf84-5a2ff478d71c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274266}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fa5f1c4b-9c02-56f6-92b6-f8a6f5b1eec5" :question/math-academy-id "q-113479" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/65348161e386fac14a98e8440d32d3883b5865a6d1eecfcd58e12931730ad0b8.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What is the value of $a+b+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=2,$ while the vertical asymptote is $x=1.$ This means that $k=2$ and $b=1,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-1}+2.\n$$\n\nAlso, we are given that the point $(2,5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x-1}+2 \\\\ 5 & =\\frac{a}{2-1}+2 \\\\ 3 & =\\frac{a}{1} \\\\ a & =3.\\end{aligned}\n$$\n\nFinally, $a+b+k=3+1+2=6.$"}] [{:db/id #edb/ref 17592186257149 :knowledge-point/_questions [{:knowledge-point/id #uuid "fbb5348e-e292-513f-8b0a-90428692fc0a" :knowledge-point/title "Calculating the Probability of the Complement Given the Probability of the Event"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a910f315-0389-510e-8630-64d78b2c67d0" :answer/type {:db/ident :answer.type/math} :answer/value "(4)/(5)" :db/id #edb/ref 17592186270217} {:answer/id #uuid "8a3329c7-7008-5ede-8371-2f4dad356808" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/(5)" :db/id #edb/ref 17592186270218} {:answer/id #uuid "09a4ef28-4a89-508e-8a0c-d77bc3b9e280" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270219} {:answer/id #uuid "2f2ef954-df7b-5468-b1e6-bee7b3be2f13" :answer/type {:db/ident :answer.type/math} :answer/value "0.075" :db/id #edb/ref 17592186270220} {:answer/id #uuid "fa9c92e8-7789-517e-80e3-99a435644f56" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270221}] :answer-field/correct {:answer/id #uuid "2f2ef954-df7b-5468-b1e6-bee7b3be2f13" :answer/type {:db/ident :answer.type/math} :answer/value "0.075" :db/id #edb/ref 17592186270220} :answer-field/id #uuid "78e7a6ef-b311-59fa-b569-deb46bc1a887" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274319}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18160ae9-a2e7-570f-b9a7-71d46ee99dc2" :question/math-academy-id "q-11590" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d773ba5052937e20997d5039fe4de6958862c4553cbe0edd8fdfe12eeb5de8fa.png)\n\nGiven the above sample space, find $P({X}^{'}).$" :question/worked-solution "The Venn diagram tells us that $P(X)=0.925.$ So, we have\n\n$$\n\\begin{aligned}P({X}^{'}) & =1-P(X) \\\\  & =1-0.925 \\\\  & =0.075.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257304 :knowledge-point/_questions [{:knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496112e7-2a0a-505e-9156-6a616b7379f1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,800\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186270332} {:answer/id #uuid "9d51cfe1-9c89-5d46-ae9b-80fa411547ae" :answer/type {:db/ident :answer.type/math} :answer/value "2(4\\,800\\,{\\text{ft}}^{3})" :db/id #edb/ref 17592186270333} {:answer/id #uuid "10f78738-76d0-5842-a08c-bdbcad5ef514" :answer/type {:db/ident :answer.type/math} :answer/value "3(4\\,800\\,{\\text{ft}}^{3})" :db/id #edb/ref 17592186270334} {:answer/id #uuid "94ef2fea-fd73-51d4-991c-ce031d524e7f" :answer/type {:db/ident :answer.type/math} :answer/value "-(4\\,800\\,{\\text{ft}}^{3})" :db/id #edb/ref 17592186270335} {:answer/id #uuid "360c23bb-5376-55b9-9f02-7e95eb7f0943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(4\\,800\\,{\\text{ft}}^{3})" :db/id #edb/ref 17592186270336}] :answer-field/correct {:answer/id #uuid "496112e7-2a0a-505e-9156-6a616b7379f1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,800\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186270332} :answer-field/id #uuid "926560e6-4edc-5dd9-ae08-a1c1686d0629" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274342}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4787160a-e9d5-53b7-b357-952fd5a6eafd" :question/math-academy-id "q-118874" :question/problem "A pedestal for a statue consists of eight identical stone blocks in the form of a rectangular solid. Each block is $20\\,\\text{ft}$ long, $15\\,\\text{ft}$ wide, and $2\\,\\text{ft}$ high. What is the total combined volume of the pedestal?" :question/worked-solution "First, we need to find the volume of one block.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=20,\\,w=15,\\,h=2\n$$\n\ninto the formula, we obtain \n\n$$\n\\begin{aligned}V=20\\cdot 15\\cdot 2=600\\,{\\text{ft}}^{3}.\\end{aligned}\n$$\n\nFinally, the total volume of the eight blocks is\n\n$$\n600\\cdot 8=4\\,800\\,{\\text{ft}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186257312 :knowledge-point/_questions [{:knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0469d5c-ec5e-5a1c-a813-b6f3b6828bcc" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186270337} {:answer/id #uuid "41a0ea3a-d22a-5ed8-acf7-15664ed42dc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186270338} {:answer/id #uuid "2de20593-7233-576f-a379-7a371dc2c4df" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270339} {:answer/id #uuid "4bc9b36c-357b-5fce-94b0-97e458caa2fb" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\sqrt{34})" :db/id #edb/ref 17592186270340} {:answer/id #uuid "09a1cdea-5900-5a54-937e-afdf59db90d5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{34})" :db/id #edb/ref 17592186270341}] :answer-field/correct {:answer/id #uuid "41a0ea3a-d22a-5ed8-acf7-15664ed42dc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186270338} :answer-field/id #uuid "274a2dec-b8a3-5036-8bee-47deacf08d85" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274343}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5ca0e9cb-003a-561c-aa77-aa39bda7e844" :question/math-academy-id "q-119029" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/42ba6528b1963aa50a80af060fef6331fffe51a564830e35ac10b71782d49e94.png)\n\nWhat is the length of $\\overset{―}{AB}?$" :question/worked-solution "From the figure, we note that the points $A$ and $B$ have coordinates ${{(1,5)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(6,2)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively. \n\nTo find the distance $AB,$ we can use the distance formula:\n\n$$\n\\begin{aligned}AB & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(6-1)^{2}+(2-5)^{2}} \\\\  & =\\sqrt{{5}^{2}+(-3)^{2}} \\\\  & =\\sqrt{25+9} \\\\  & =\\sqrt{34}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257333 :knowledge-point/_questions [{:knowledge-point/id #uuid "450401ad-3c58-5c15-ab78-b5e1ccf42a85" :knowledge-point/title "Determining Whether a Venn Diagram is Correct"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b5aeda2-7aba-51e5-9b9e-0310164416f4" :answer/type {:db/ident :answer.type/math} :answer/value "(4)/(5)" :db/id #edb/ref 17592186270372} {:answer/id #uuid "1fa89001-e808-55a9-838b-a37cf71e7b92" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270373} {:answer/id #uuid "acead608-903a-5794-84aa-45e06783d184" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186270374} {:answer/id #uuid "65f0b164-61b7-5f24-b29c-062b34037676" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(5)" :db/id #edb/ref 17592186270375} {:answer/id #uuid "98ced8ee-5d44-5a5c-a7a8-3ab0948e7e36" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270376}] :answer-field/correct {:answer/id #uuid "1fa89001-e808-55a9-838b-a37cf71e7b92" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270373} :answer-field/id #uuid "bb329c03-9b15-51f9-84e7-e28b4eed9441" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274350}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d531bcc0-5aad-57d1-a7e6-bdcbfb0a5d04" :question/math-academy-id "q-119376" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ff6cdd3a9cc650842bba6e546cc91fca3206279cb6d8f9d835357c3cdcb597ce.png)\n\nConsider the sample space $S$ with the Venn diagram given above. What is the value of a constant $b?$" :question/worked-solution "From the given Venn diagram, we have $P(X)=\\frac{1}{b}$ and $P({X}^{'})=\\frac{2}{b}.$\nTherefore,\n\n$$\n\\begin{aligned}P(X)+P({X}^{'}) & =1 \\\\ \\frac{1}{b}+\\frac{2}{b} & =1 \\\\ \\frac{3}{b} & =1 \\\\ b & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257342 :knowledge-point/_questions [{:knowledge-point/id #uuid "af4cfa4a-7f49-50c9-a875-ce51c3874c4f" :knowledge-point/title "Calculating the Probability of an Event Given the Probability of the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5aca2cb-5eff-53dc-966b-608f41239b20" :answer/type {:db/ident :answer.type/math} :answer/value "0.8766" :db/id #edb/ref 17592186270387} {:answer/id #uuid "2214af0a-27e3-550c-8e7e-1cf4caf49d18" :answer/type {:db/ident :answer.type/math} :answer/value "(22)/(37)" :db/id #edb/ref 17592186270388} {:answer/id #uuid "903ebd2c-a422-5650-8e32-23416a8e611d" :answer/type {:db/ident :answer.type/math} :answer/value "(19)/(37)" :db/id #edb/ref 17592186270389} {:answer/id #uuid "dea564bb-fb88-5a1f-bf0a-4cb8f7b61bb7" :answer/type {:db/ident :answer.type/math} :answer/value "(20)/(37)" :db/id #edb/ref 17592186270390} {:answer/id #uuid "2d1a0077-1f51-5ce5-89c9-c91602da3286" :answer/type {:db/ident :answer.type/math} :answer/value "(16)/(37)" :db/id #edb/ref 17592186270391}] :answer-field/correct {:answer/id #uuid "d5aca2cb-5eff-53dc-966b-608f41239b20" :answer/type {:db/ident :answer.type/math} :answer/value "0.8766" :db/id #edb/ref 17592186270387} :answer-field/id #uuid "8afaa9d6-36d5-5239-bc71-a0e9f13959bc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274353}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "63041fbf-1c6b-5528-a9b1-540c3e1c23bb" :question/math-academy-id "q-119406" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/c700c7a205ab674275e2e9f0b2dd79054853dfeaf33f6794d6d7e4196389274b.png)\n\nGiven the above sample space, find $P(X).$" :question/worked-solution "The Venn diagram tells us that $P({X}^{'})=0.1234.$ So, we have\n\n$$\n\\begin{aligned}P(X) & =1-P({X}^{'}) \\\\  & =1-0.1234 \\\\  & =0.8766.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257482 :knowledge-point/_questions [{:knowledge-point/id #uuid "452d826b-4cb3-56e1-989a-b025b5d5c955" :knowledge-point/title "Choosing a Parameter to Force a Desired Number of Solutions to a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "546aa239-e729-5930-a3ab-31774f082980" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{45}{4})" :db/id #edb/ref 17592186270527} {:answer/id #uuid "e77caf00-e8f1-5b2e-9a3c-bcb8faf1490b" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{45}{4})" :db/id #edb/ref 17592186270528} {:answer/id #uuid "f2b2a037-516b-5d41-a303-f3af244b4896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{45}{4}" :db/id #edb/ref 17592186270529} {:answer/id #uuid "ec381251-fa23-56bb-ace9-ed13dbaa6c21" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{45}{4})" :db/id #edb/ref 17592186270530} {:answer/id #uuid "fa4d5539-863a-5a9d-8e67-d384a81906b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{45}{4})" :db/id #edb/ref 17592186270531}] :answer-field/correct {:answer/id #uuid "f2b2a037-516b-5d41-a303-f3af244b4896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{45}{4}" :db/id #edb/ref 17592186270529} :answer-field/id #uuid "c43ef67e-78ba-5338-9750-8624fa1e56cc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274381}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3f53a0d5-edce-5e43-88e9-e77b8a039ddf" :question/math-academy-id "q-12218" :question/problem "Find the values of $k$ for which the quadratic equation $5{x}^{2}+15x+k=0$ has one distinct real solution." :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=5,$ $b=15,$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(15)^{2}-4(5)(k) \\\\  & =225-20k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D & =0 \\\\ 225-20k & =0 \\\\ 20k & =225 \\\\ k & =\\frac{225}{20} \\\\ k & =\\frac{45}{4}\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=\\frac{45}{4}.$"}] [{:db/id #edb/ref 17592186257503 :knowledge-point/_questions [{:knowledge-point/id #uuid "6699397d-0014-5749-b439-4a8486990986" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d4aff86-2d4a-5084-a9ac-09d8b33033f9" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186270542} {:answer/id #uuid "9ee0e3a8-d933-50ee-b10f-bd34bfa0957c" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186270543} {:answer/id #uuid "f8ce641e-da80-529e-bb5a-0bd2fcb4fefc" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186270544} {:answer/id #uuid "5735fd34-3039-5ec0-9a3c-2a4724a20281" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186270545} {:answer/id #uuid "08b901f0-0fe6-51dd-bfea-a5ed0a12f39a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270546}] :answer-field/correct {:answer/id #uuid "08b901f0-0fe6-51dd-bfea-a5ed0a12f39a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270546} :answer-field/id #uuid "85873d10-36bb-5c1e-a71a-3d88e11cb83c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274384}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3fe266bf-fb9f-5216-b5ca-e422fa0b4ebd" :question/math-academy-id "q-123601" :question/problem "$\\operatorname{cos}{45}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${45}^{∘}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}{45}^{∘}=\\frac{\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186257509 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ca26f8d-226b-5999-963c-74508297eb9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{1}{2})" :db/id #edb/ref 17592186270552} {:answer/id #uuid "d0806d59-ceb7-5bc7-8541-d693cfec71af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186270553} {:answer/id #uuid "70bf1e42-3697-5db4-8fca-1b3b260b4cd2" :answer/type {:db/ident :answer.type/math} :answer/value "(− 1)/(2)" :db/id #edb/ref 17592186270554} {:answer/id #uuid "0eb8f097-6a40-5710-9c12-aa661ed34cf2" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{1}{2})" :db/id #edb/ref 17592186270555} {:answer/id #uuid "1b347302-7ccf-5606-898f-166d7cf65ead" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{1}{2})" :db/id #edb/ref 17592186270556}] :answer-field/correct {:answer/id #uuid "d0806d59-ceb7-5bc7-8541-d693cfec71af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186270553} :answer-field/id #uuid "c0410bbb-2635-5ff7-add0-ce6acdb97eb7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274386}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e5a328a-ca83-5e2b-b8cf-4756149978bf" :question/math-academy-id "q-123603" :question/problem "$\\operatorname{sin}(\\frac{5\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{5\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{5\\pi }{6})=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186257512 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16cfeabd-4b6c-5ff5-aa59-305a99f9f94c" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186270557} {:answer/id #uuid "b8230aa0-a2ea-5ab6-9769-e08d7648becb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186270558} {:answer/id #uuid "4eb51c63-3764-543e-8621-2b0f9880a70d" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186270559} {:answer/id #uuid "e92460f9-b1d4-5372-b53b-80b153f5f92d" :answer/type {:db/ident :answer.type/math} :answer/value "(− 1)/(2)" :db/id #edb/ref 17592186270560} {:answer/id #uuid "48ba2c82-eebe-5b05-ad4e-dac333e490a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270561}] :answer-field/correct {:answer/id #uuid "48ba2c82-eebe-5b05-ad4e