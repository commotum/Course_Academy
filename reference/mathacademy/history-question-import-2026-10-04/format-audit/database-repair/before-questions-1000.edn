ac{5\\pi }{3})+\\operatorname{cos}x\\operatorname{sin}(\\frac{5\\pi }{3}) \\\\  & =\\operatorname{sin}x\\cdot (\\frac{1}{2})+\\operatorname{cos}x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}x-\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259693 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aafe7e74-012b-5867-9843-f6f95f6cb9f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186259695}] :answer-field/correct {:answer/id #uuid "aafe7e74-012b-5867-9843-f6f95f6cb9f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186259695} :answer-field/id #uuid "e20fe23c-7a02-56f5-808d-2f1ec74e564b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259694}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cbd2c5fc-c58b-57db-ac30-a7a42b7e4318" :question/math-academy-id "q-332158" :question/problem "Using the fact that ${75}^{∘}={45}^{∘}+{30}^{∘},$\ncalculate the **exact** value of $\\operatorname{sin}({75}^{∘}).$\n\n$\\operatorname{sin}({75}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}(x+y)=\\operatorname{sin}x\\operatorname{cos}y+\\operatorname{cos}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for sine with $x={45}^{∘}$ and $y={30}^{∘}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}({75}^{∘}) & =\\operatorname{sin}({45}^{∘}+{30}^{∘}) \\\\  & =\\operatorname{sin}({45}^{∘})\\operatorname{cos}({30}^{∘})+\\operatorname{cos}({45}^{∘})\\operatorname{sin}({30}^{∘}) \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259696 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0dac5fc-2439-5d73-b196-14468e003bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186259698}] :answer-field/correct {:answer/id #uuid "b0dac5fc-2439-5d73-b196-14468e003bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186259698} :answer-field/id #uuid "b1575dc5-e080-5bcf-8dcd-f51047d7d9db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259697}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03426ec1-9ce0-5841-b920-9dadf0efd8d7" :question/math-academy-id "q-332159" :question/problem "Using the fact that ${105}^{∘}={60}^{∘}+{45}^{∘},$\ncalculate the **exact** value of $\\operatorname{sin}({105}^{∘}).$\n\n$\\operatorname{sin}({105}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}(x+y)=\\operatorname{sin}x\\operatorname{cos}y+\\operatorname{cos}x\\operatorname{sin}y\n$$\n\nApplying the sum formula for sine with $x={60}^{∘}$ and $y={45}^{∘}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}({105}^{∘}) & =\\operatorname{sin}({60}^{∘}+{45}^{∘}) \\\\  & =\\operatorname{sin}({60}^{∘})\\operatorname{cos}({45}^{∘})+\\operatorname{cos}({60}^{∘})\\operatorname{sin}({45}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2}+\\frac{1}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259699 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ae6421-129b-575b-b2b6-ab31a96cbe98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186259701}] :answer-field/correct {:answer/id #uuid "24ae6421-129b-575b-b2b6-ab31a96cbe98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186259701} :answer-field/id #uuid "fbd8bbe6-bc05-5c2c-a743-aeafc06d91ef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259700} {:answer-field/choices [{:answer/id #uuid "49201727-cd3a-57c6-9758-3648785b9c28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259703}] :answer-field/correct {:answer/id #uuid "49201727-cd3a-57c6-9758-3648785b9c28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186259703} :answer-field/id #uuid "1c19205b-d1eb-5f8f-ae2b-42306b65a44e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259702}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7dcd7f55-ee85-5f1c-81d1-2e0b2fc5673a" :question/math-academy-id "q-332169" :question/problem "Express $\\operatorname{sin}(x+{210}^{∘})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x+{210}^{∘})=$\n{{field-1}}$\\operatorname{sin}x\\,-$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}(u+v)=\\operatorname{sin}u\\operatorname{cos}v+\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x+{210}^{∘}) & =\\operatorname{sin}x\\operatorname{cos}{210}^{∘}+\\operatorname{cos}x\\operatorname{sin}{210}^{∘} \\\\  & =\\operatorname{sin}x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{cos}x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}x-\\frac{1}{2}\\,\\operatorname{cos}x \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}x-\\frac{1}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259704 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "060d37dd-b9b6-5912-a8b6-3b0f5d07a3da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259706}] :answer-field/correct {:answer/id #uuid "060d37dd-b9b6-5912-a8b6-3b0f5d07a3da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259706} :answer-field/id #uuid "d7b96043-426a-5b32-9d94-f95ba17f69d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259705} {:answer-field/choices [{:answer/id #uuid "c2fd9a52-a1e1-5434-9279-2c42f8bfee4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259708}] :answer-field/correct {:answer/id #uuid "c2fd9a52-a1e1-5434-9279-2c42f8bfee4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259708} :answer-field/id #uuid "891072f3-bc92-5e26-a597-e4cea9c42139" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259707}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d1c1ea2d-6f2c-5f0b-a72c-0ac2aafa0c49" :question/math-academy-id "q-332176" :question/problem "Express $\\operatorname{sin}(x-{225}^{∘})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x-{225}^{∘})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}(u-v)=\\operatorname{sin}u\\operatorname{cos}v-\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={225}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x-{225}^{∘}) & =\\operatorname{sin}x\\operatorname{cos}{225}^{∘}-\\operatorname{cos}x\\operatorname{sin}{225}^{∘} \\\\  & =\\operatorname{sin}x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{cos}x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}x \\\\  & =-\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259709 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2454ebe5-ae13-5062-aaab-79717a4972a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259711}] :answer-field/correct {:answer/id #uuid "2454ebe5-ae13-5062-aaab-79717a4972a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259711} :answer-field/id #uuid "a8ceb5a4-b6a1-5fab-a650-016c5af8aa4c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259710} {:answer-field/choices [{:answer/id #uuid "b5cc0db4-d01c-5bcd-8f87-4a88d2b1052c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259713}] :answer-field/correct {:answer/id #uuid "b5cc0db4-d01c-5bcd-8f87-4a88d2b1052c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186259713} :answer-field/id #uuid "8f3e51f4-769c-5a73-9553-27ca6126ea66" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259712}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8fa8afe2-3453-592b-83a6-603e6ce9b5e1" :question/math-academy-id "q-332193" :question/problem "Express $\\operatorname{sin}(x-\\frac{7\\pi }{4})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x-\\frac{7\\pi }{4})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}(u-v)=\\operatorname{sin}u\\operatorname{cos}v-\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{7\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x-\\frac{7\\pi }{4}) & =\\operatorname{sin}x\\operatorname{cos}(\\frac{7\\pi }{4})-\\operatorname{cos}x\\operatorname{sin}(\\frac{7\\pi }{4}) \\\\  & =\\operatorname{sin}x\\cdot \\frac{\\sqrt{2}}{2}-\\operatorname{cos}x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}\\operatorname{sin}x}{2}+\\frac{\\sqrt{2}\\operatorname{cos}x}{2} \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259714 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30a15c72-9a15-5022-99b2-0c0968a3a7be" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259716}] :answer-field/correct {:answer/id #uuid "30a15c72-9a15-5022-99b2-0c0968a3a7be" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259716} :answer-field/id #uuid "76bf53f9-dc9f-5679-8fdd-3f5f5d0ff6ed" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259715} {:answer-field/choices [{:answer/id #uuid "710df7e8-f09e-59ea-941f-dd92b0e48503" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259718}] :answer-field/correct {:answer/id #uuid "710df7e8-f09e-59ea-941f-dd92b0e48503" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259718} :answer-field/id #uuid "5b15d72a-1a4d-5b32-bf7a-3349b514d1cc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259717}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "889a0c6a-4567-5269-8c45-169860a4a405" :question/math-academy-id "q-332197" :question/problem "Express $\\operatorname{sin}(x-\\frac{3\\pi }{2})$ in terms of $\\operatorname{sin}x$ and $\\operatorname{cos}x.$\n\n$\\operatorname{sin}(x-\\frac{3\\pi }{2})=$\n{{field-1}}$\\operatorname{sin}x\\,+$\n{{field-2}}$\\operatorname{cos}x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}(u-v)=\\operatorname{sin}u\\operatorname{cos}v-\\operatorname{cos}u\\operatorname{sin}v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{3\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}(x-\\frac{3\\pi }{2}) & =\\operatorname{sin}x\\operatorname{cos}(\\frac{3\\pi }{2})-\\operatorname{cos}x\\operatorname{sin}(\\frac{3\\pi }{2}) \\\\  & =\\operatorname{sin}x\\cdot 0-\\operatorname{cos}x\\cdot (-1) \\\\  & =\\operatorname{cos}x \\\\  & =0\\,\\operatorname{sin}x+1\\,\\operatorname{cos}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260190 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b" :knowledge-point/title "Dividing Rational Expressions and Simplifying the Result by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "688319bd-d59e-5e87-9e7e-858ff689d865" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27x}{{y}^{3}}" :db/id #edb/ref 17592186260192}] :answer-field/correct {:answer/id #uuid "688319bd-d59e-5e87-9e7e-858ff689d865" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27x}{{y}^{3}}" :db/id #edb/ref 17592186260192} :answer-field/id #uuid "d26c6b86-8dee-53b5-979a-e9942547fb68" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260191}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ea688c05-e239-5220-b902-15b6dea2eef8" :question/math-academy-id "q-3635" :question/problem "$\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute\n\n$$\n\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9x}{xy+5y}÷\\frac{{y}^{2}}{3x+15} & = \\\\ \\frac{9x}{xy+5y}\\cdot \\frac{3x+15}{{y}^{2}} & = \\\\ \\frac{9x}{y(x+5)}\\cdot \\frac{3(x+5)}{{y}^{2}} & = \\\\ \\frac{9x}{y\\cancel{(x+5)}}\\cdot \\frac{3\\cancel{(x+5)}}{{y}^{2}} & = \\\\ \\frac{9x}{y}\\cdot \\frac{3}{{y}^{2}} & = \\\\ \\frac{27x}{{y}^{3}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260204 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4014376-4dae-56f1-b981-b35d3afab874" :knowledge-point/title "Solving for a Constant Such that the Limit of a Piecewise Function Exists"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3627d8f3-7507-59fd-add7-0a30a7f9cd5f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260206}] :answer-field/correct {:answer/id #uuid "3627d8f3-7507-59fd-add7-0a30a7f9cd5f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260206} :answer-field/id #uuid "fef77817-3574-5917-8751-f6dc6ac2eaef" :answer-field/key "b" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260205} {:answer-field/choices [{:answer/id #uuid "fda01204-9e15-5935-8160-c3810f97cd32" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260208}] :answer-field/correct {:answer/id #uuid "fda01204-9e15-5935-8160-c3810f97cd32" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260208} :answer-field/id #uuid "8e135889-0014-59ef-a4ff-b04ac2c9f0e6" :answer-field/key "c" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260207}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3cbc081a-4656-5dca-b3b1-aa3f8536f992" :question/math-academy-id "q-36743" :question/problem "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}{x}^{2}+2x+b\\, & \\text{ for }\\,x\\le 1 \\\\ {x}^{2}+cx+2\\, & \\text{ for }\\,x>1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 1}f(x)=2.$ What is the value of the constants $b$ and $c?$\n\n$b$: {{b}}\n\n$c$: {{c}}" :question/worked-solution "In order for ${lim}_{x\\to 1}f(x)$ to be equal to $2,$ the left and right-sided limits must both exist and be equal to $2.$\n\n- Approaching from the left, we have $x<1,$ so we use the expression $f(x)={x}^{2}+2x+b.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{2}+2x+b) \\\\  & ={1}^{2}+2(1)+b \\\\  & =1+2+b \\\\  & =b+3\\,.\\end{aligned}\n$$\n\nSince the left-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & =2 \\\\ b+3 & =2 \\\\ b & =2-3 \\\\ b & =-1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>1,$ so we use the expression $f(x)={x}^{2}+cx+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{2}+cx+2) \\\\  & ={1}^{2}+c(1)+2 \\\\  & =1+c+2 \\\\  & =c+3\\,.\\end{aligned}\n$$\n\nSince the right-sided limit must be equal to $2,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & =2 \\\\ c+3 & =2 \\\\ c & =2-3 \\\\ c & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260229 :knowledge-point/_questions [{:knowledge-point/id #uuid "0b04beff-987b-504f-9783-4465474e01ab" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db4a9db6-c627-5160-b1b1-62c11ebf7de3" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{i}" :db/id #edb/ref 17592186260231}] :answer-field/correct {:answer/id #uuid "db4a9db6-c627-5160-b1b1-62c11ebf7de3" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{i}" :db/id #edb/ref 17592186260231} :answer-field/id #uuid "f7910f23-724b-59d9-ad7d-a355a2f0691e" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260230} {:answer-field/choices [{:answer/id #uuid "4568e03f-33ab-5c2f-a5b2-5d9d03208ba1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186260233}] :answer-field/correct {:answer/id #uuid "4568e03f-33ab-5c2f-a5b2-5d9d03208ba1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186260233} :answer-field/id #uuid "c9a00dfb-b781-518e-841a-b1c1026bde2d" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260232}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6e7a2f2a-eb16-5a6f-9053-e49c72b4b60a" :question/math-academy-id "q-3783" :question/problem "$2{x}^{2}=-18$ has the solutions\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rewrite the equation, as follows:\n\n$$\n\\begin{aligned}2{x}^{2} & =-18 \\\\ {x}^{2} & =-\\frac{18}{2} \\\\ {x}^{2} & =-9\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nx=\\pm \\sqrt{-9}\n$$\n\nWe now rewrite $x$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}x & =\\pm \\sqrt{-9} \\\\  & =\\pm \\sqrt{9\\cdot (-1)} \\\\  & =\\pm \\sqrt{9}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260234 :knowledge-point/_questions [{:knowledge-point/id #uuid "0b04beff-987b-504f-9783-4465474e01ab" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02724726-2784-5ef6-bc37-24132bdb2ccc" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{i}" :db/id #edb/ref 17592186260236}] :answer-field/correct {:answer/id #uuid "02724726-2784-5ef6-bc37-24132bdb2ccc" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{i}" :db/id #edb/ref 17592186260236} :answer-field/id #uuid "79368221-cc13-5803-8c43-ad8e07512ab9" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260235} {:answer-field/choices [{:answer/id #uuid "d5204408-ca35-5c5d-9cd5-c818ef94d47a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186260238}] :answer-field/correct {:answer/id #uuid "d5204408-ca35-5c5d-9cd5-c818ef94d47a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186260238} :answer-field/id #uuid "5835b15d-b5ee-570e-bb08-558cbd3e61b0" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260237}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "77273b9c-44fa-5c95-bcfa-163635f82eb2" :question/math-academy-id "q-3808" :question/problem "Determine the solutions of the equation $3{r}^{2}+27=0.$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}3{r}^{2}+27 & =0 \\\\ 3{r}^{2} & =-27 \\\\ {r}^{2} & =-9\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nr=\\pm \\sqrt{-9}\n$$\n\nWe now rewrite $r$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}r & =\\pm \\sqrt{-9} \\\\  & =\\pm \\sqrt{9\\cdot (-1)} \\\\  & =\\pm \\sqrt{9}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260251 :knowledge-point/_questions [{:knowledge-point/id #uuid "99c4151a-d2e0-5603-b27d-d81c76a0c7ba" :knowledge-point/title "Identifying Properties of Reciprocal Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f39dc82-820e-5548-a0dd-c19e651b8a80" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186260253} {:answer/id #uuid "203714a3-86e4-5086-a47e-056427b64a5f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186260254} {:answer/id #uuid "68357f1e-38a3-5f15-ada5-2918d0749d0f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260255} {:answer/id #uuid "004fcd5a-d9cd-5ef1-9566-8524db4dcaa1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260256} {:answer/id #uuid "fe083ecf-90fd-5715-aac8-b2ee888d250f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260257} {:answer/id #uuid "ee09beba-184e-52a2-8655-5ddd98441138" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260258} {:answer/id #uuid "32e51ac3-ebb0-5b54-8c8a-8c0e6a914bb7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186260259} {:answer/id #uuid "d09abb86-4cb1-5d8a-81b3-f062a0ae6192" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260260}] :answer-field/correct {:answer/id #uuid "d09abb86-4cb1-5d8a-81b3-f062a0ae6192" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260260} :answer-field/id #uuid "2a811596-4561-58d6-aa4d-f28d49154dd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260252}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8c4a36da-599f-5664-ba9f-ac2ade1112ca" :question/math-academy-id "q-39273" :question/problem "For the curve $y=\\frac{1}{x},$ which of the following statements are true?\n\nI. - The domain of the function is $x\\in (-\\infty ,1)\\cup (1,\\infty ).$\nII. - The graph of the function passes through the point $(2,\\frac{1}{2}).$\nIII. - $y\\to -\\infty $ as $x\\to {0}^{+}.$" :question/worked-solution "First, let's sketch the graph of $y=\\frac{1}{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ffd98b8f9b6c7a9260f43772f9c654901bd02c21efa1eb06f2a5fdad8b263729.png)\n\nNow, we analyze each statement in turn.\n\n- Statement I is false. The function is defined on all real numbers except $0.$ So, the domain of the function is $x\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- Statement II is true. When $x=2,$ we get $y=\\frac{1}{2},$ so the point $(2,\\frac{1}{2})$ lies on the curve.\n\n- Statement III is false. From the graph, we see that $y\\to \\infty $ as $x\\to {0}^{+}.$\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186260287 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f2d12ff-f760-5c03-88c0-2b7088eb5fb2" :knowledge-point/title "Solving a Cubic Equation by Rearranging"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3105e6bd-21ef-530e-8e10-b909bcf733ba" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186260289}] :answer-field/correct {:answer/id #uuid "3105e6bd-21ef-530e-8e10-b909bcf733ba" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186260289} :answer-field/id #uuid "19d0e142-f90c-5c63-b1c3-353684dc6988" :answer-field/key "root-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260288} {:answer-field/choices [{:answer/id #uuid "d23d4977-ec9c-564b-99ba-5632e8a3c200" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260291}] :answer-field/correct {:answer/id #uuid "d23d4977-ec9c-564b-99ba-5632e8a3c200" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260291} :answer-field/id #uuid "3351ea0b-eeff-5f58-becd-56fbf08f3f13" :answer-field/key "root-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260290} {:answer-field/choices [{:answer/id #uuid "0700acea-40cc-5401-9f43-345fa1a20bad" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260293}] :answer-field/correct {:answer/id #uuid "0700acea-40cc-5401-9f43-345fa1a20bad" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260293} :answer-field/id #uuid "003a3369-96ec-559a-9958-0a3c80649b81" :answer-field/key "root-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260292}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "423dad75-ec6d-59c5-bce2-1028414952c4" :question/math-academy-id "q-3984" :question/problem "Solve for $m$ where $2{m}^{3}-5{m}^{2}-18m=2{m}^{2}+{m}^{3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(m)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}2{m}^{3}-5{m}^{2}-18m & =2{m}^{2}+{m}^{3} \\\\ {m}^{3}-5{m}^{2}-18m & =2{m}^{2} \\\\ {m}^{3}-7{m}^{2}-18m & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $m.$ We can factor out the $m$ as follows:\n\n$$\n\\begin{aligned}{m}^{3}-7{m}^{2}-18m & =0 \\\\ m({m}^{2}-7m-18) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${m}^{2}-7m-18$ as follows:\n\n$$\n\\begin{aligned}m({m}^{2}-7m-18) & =0 \\\\ m(m+2)(m-9) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $m=0,$ $m=-2,$ and $m=9.$"}] [{:db/id #edb/ref 17592186260300 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef75bc93-76da-5992-8285-181b808eb7a0" :knowledge-point/title "Finding the Range of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22f9ee78-0a9c-5019-8ab5-4dc0d4377d5d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186260302}] :answer-field/correct {:answer/id #uuid "22f9ee78-0a9c-5019-8ab5-4dc0d4377d5d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186260302} :answer-field/id #uuid "ab06826b-48c4-5499-b4e8-1c375d3ad4fb" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260301} {:answer-field/choices [{:answer/id #uuid "f422513d-cfb5-58ac-8d90-bfe90ab49b23" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260304}] :answer-field/correct {:answer/id #uuid "f422513d-cfb5-58ac-8d90-bfe90ab49b23" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260304} :answer-field/id #uuid "2c6cd3c1-fc3a-51fa-bddb-1852000b1f5f" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260303}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "99cb9382-c994-5be5-9048-a51a60032aa8" :question/math-academy-id "q-40384" :question/problem "What is the range of $y=-4(3)^{x}+2?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "The range of ${3}^{x}$ is \n\n$$\n{3}^{x}>0.\n$$\n\nMultiplying the above inequality by $-4$ and then adding $2,$ we get the following:\n\n$$\n\\begin{aligned}{3}^{x} & >0 \\\\ -4(3)^{x} & <0 \\\\ -4(3)^{x}+2 & <0+2 \\\\ y & <2\\end{aligned}\n$$\n\nTherefore, the range is $y\\in (-\\infty ,2).$ \n\nWe can also see that this is true from the graph of the function. The graph of $f(x)=-4(3)^{x}+2$ is shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e3e926c26f8174dd5c92a5875e550530304fadcea4c964ab33b35e701f7e5ae5.png)"}] [{:db/id #edb/ref 17592186260323 :knowledge-point/_questions [{:knowledge-point/id #uuid "8813b8a0-3b5e-5cd8-a37d-6b921f2882b8" :knowledge-point/title "Expressing a Repeating Decimal as the Sum of a Number and a Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e05239-8c87-5ec0-8fe0-4e5e7f8ce9b3" :answer/type {:db/ident :answer.type/math} :answer/value "2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{10}{(\\frac{1}{100})}^{n}" :db/id #edb/ref 17592186260325}] :answer-field/correct {:answer/id #uuid "30e05239-8c87-5ec0-8fe0-4e5e7f8ce9b3" :answer/type {:db/ident :answer.type/math} :answer/value "2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{10}{(\\frac{1}{100})}^{n}" :db/id #edb/ref 17592186260325} :answer-field/id #uuid "872fc268-37e6-5ec2-8a77-98dbdaae9dc6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260324}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "beb2fadf-9974-5f6b-99c2-f5a2d68db56e" :question/math-academy-id "q-40691" :question/problem "$2.3\\overset{―}{43}=$\n\nAnswer: {{answer}}" :question/worked-solution "The given repeating decimal can be written as\n\n$$\n\\begin{aligned}2.3\\overset{―}{43} & =2.343\\,43... \\\\  & =2.3+0.043+0.000\\,43+0.000\\,004\\,3+… \\\\  & =2.3+{{\\frac{43}{1\\,000}+\\frac{43}{100\\,000}+\\frac{43}{10\\,000\\,000}+⋯.}_{⏟}}_{\\text{geometric series}}\\end{aligned}\n$$\n\nWe see that we have a geometric series where the first term is ${a}_{1}=\\frac{43}{1\\,000}$ and the common ratio is $\\frac{1}{100}.$ Therefore,\n\n$$\n\\begin{aligned}2.3\\overset{―}{43} & =2.3+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{1\\,000}{(\\frac{1}{100})}^{n-1} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43\\cdot 100}{1\\,000}{(\\frac{1}{100})}^{n} \\\\  & =2.3+{\\sum }_{n=1}^{\\infty }\\frac{43}{10}{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260354 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a7e1c8-f68c-596e-ab9f-344494cd75e2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260356}] :answer-field/correct {:answer/id #uuid "33a7e1c8-f68c-596e-ab9f-344494cd75e2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260356} :answer-field/id #uuid "ce685e4d-5028-5675-9495-8fe814cdaccf" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260355} {:answer-field/choices [{:answer/id #uuid "4fa1f869-f59f-572c-a553-4f29411d5321" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\sqrt{3}" :db/id #edb/ref 17592186260358}] :answer-field/correct {:answer/id #uuid "4fa1f869-f59f-572c-a553-4f29411d5321" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\sqrt{3}" :db/id #edb/ref 17592186260358} :answer-field/id #uuid "20d1131b-bf5a-5a6b-b61f-4518eba9dcbc" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260357}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dce89418-8ba6-5cb9-88b6-4ca10b594bb9" :question/math-academy-id "q-41786" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/0836e8682e78ae6a53d9b5cf05bce78dd665765aca42504eb8774c6116f42520.png)\n\nThe polar curve $r=14$ and the ray $\\theta =\\frac{5\\pi }{3}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(14,\\frac{5\\pi }{3}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}\\theta  \\\\  & =14\\operatorname{cos}(\\frac{5\\pi }{3}) \\\\  & =14\\cdot (\\frac{1}{2}) \\\\  & =7 \\\\ y & =r\\operatorname{sin}\\theta  \\\\  & =14\\operatorname{sin}(\\frac{5\\pi }{3}) \\\\  & =14\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-7\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(7,-7\\sqrt{3}).$"}] [{:db/id #edb/ref 17592186260368 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50cb11be-3ef2-5464-9a38-6834624b5c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\pi }{6}" :db/id #edb/ref 17592186260370}] :answer-field/correct {:answer/id #uuid "50cb11be-3ef2-5464-9a38-6834624b5c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\pi }{6}" :db/id #edb/ref 17592186260370} :answer-field/id #uuid "b3765f5b-c9c9-5376-a3ec-d8b9ae47c1cc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260369}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a9bd9256-8a79-56fe-a09d-da67096b964f" :question/math-academy-id "q-42787" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}(\\frac{x}{2}+\\frac{\\pi }{6})=-\\sqrt{2}\n$$\n\nThe general solution of this equation is\n\n$$\nx=\\frac{7\\pi }{6}+4\\pi n,\\,x=a+4\\pi n,\n$$\n\nwhere $n$ is any integer. What could be the value of $a?$\n\nAnswer: {{answer}}" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}(\\frac{x}{2}+\\frac{\\pi }{6})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n\\frac{x}{2}+\\frac{\\pi }{6}=\\frac{3\\pi }{4}+2\\pi n,\\,\\frac{x}{2}+\\frac{\\pi }{6}=\\frac{5\\pi }{4}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{2}=-\\frac{\\pi }{6}+\\frac{3\\pi }{4}+2\\pi n, & \\,\\frac{x}{2}=-\\frac{\\pi }{6}+\\frac{5\\pi }{4}+2\\pi n \\\\ \\frac{x}{2}=\\frac{7\\pi }{12}+2\\pi n, & \\,\\frac{x}{2}=\\frac{13\\pi }{12}+2\\pi n \\\\ x=\\frac{7\\pi }{6}+4\\pi n, & \\,x=\\frac{13\\pi }{6}+4\\pi n.\\end{aligned}\n$$\n\nSo, we have that $a=\\frac{13\\pi }{6}.$"}] [{:db/id #edb/ref 17592186260614 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049f54b3-4dcd-5a69-a4e8-f4d943ba4977" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{ln}(K|3x+4|)" :db/id #edb/ref 17592186260616}] :answer-field/correct {:answer/id #uuid "049f54b3-4dcd-5a69-a4e8-f4d943ba4977" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{ln}(K|3x+4|)" :db/id #edb/ref 17592186260616} :answer-field/id #uuid "e4eb7a7f-c819-5fd9-b614-2e86f953fb0c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260615}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c472c0d4-d3df-50b1-a45a-c2d9b5dcf85c" :question/math-academy-id "q-49515" :question/problem "Calculate $\\int \\frac{5}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant.\n\nAnswer: {{answer}}" :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{5}{3x+4}\\,\\text{d}x & =\\int \\frac{5}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\operatorname{ln}|u|+C \\\\  & =\\frac{5}{3}\\operatorname{ln}|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{5}{3}\\operatorname{ln}K$ for another arbitrary positive constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\operatorname{ln}|3x+4|+C & =\\frac{5}{3}\\operatorname{ln}|3x+4|+\\frac{5}{3}\\operatorname{ln}K \\\\  & =\\frac{5}{3}(\\operatorname{ln}|3x+4|+\\operatorname{ln}K) \\\\  & =\\frac{5}{3}\\operatorname{ln}(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{5}{3x+4}\\,\\text{d}x=\\frac{5}{3}\\operatorname{ln}(K|3x+4|).\n$$"}] [{:db/id #edb/ref 17592186260620 :knowledge-point/_questions [{:knowledge-point/id #uuid "e4380b34-0502-552b-b94f-e121eb855f1d" :knowledge-point/title "Determining Convergence Behavior of Geometric Sequences Written Recursively"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7493e4bf-895d-5e65-bb8f-bf2d383720b8" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186260622} {:answer/id #uuid "209fa5c5-1466-5ce7-a8d2-8973f26a4e1f" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186260623}] :answer-field/correct {:answer/id #uuid "7493e4bf-895d-5e65-bb8f-bf2d383720b8" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186260622} :answer-field/id #uuid "d20d3612-8f26-5ea3-b4eb-4ce596ec8c19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260621}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71dac1d2-6ea4-558d-93e8-0311765a5a7d" :question/math-academy-id "q-49568" :question/problem "Consider the following sequence: \n\n$$\n{a}_{n+1}=-\\frac{5}{4}{a}_{n},\\,{a}_{1}=\\frac{1}{2},\\,n\\ge 1.\n$$\n\nDetermine whether the sequence is convergent or divergent. If it converges, find the limit." :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nThe given sequence is a geometric sequence with the common ratio \n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{5}{4}.\n$$\n\nSince $|r|>1$, the sequence diverges."}] [{:db/id #edb/ref 17592186260647 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d138d2c-3295-5eae-990d-42711f5792f1" :knowledge-point/title "Analyzing Statements Involving Sums of Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a35aa78-d547-5a55-8a2f-3f86e4c0afb5" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186260649} {:answer/id #uuid "8644a362-1e72-5a40-acc5-710bc5a3bcd6" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186260650} {:answer/id #uuid "e0dac5b6-786f-5744-93c0-87b1055f2912" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260651} {:answer/id #uuid "38362d27-f96d-5548-bff5-1512c06ada80" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260652} {:answer/id #uuid "0362b06e-efe4-545c-86bd-91cb1c3508c7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260653} {:answer/id #uuid "acbfefc2-a7e5-5a3b-b04b-4a73976e50af" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260654} {:answer/id #uuid "56f00260-986c-5669-a513-075f3979051c" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186260655} {:answer/id #uuid "e1267788-fb64-575f-b20c-448bc0e42758" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260656}] :answer-field/correct {:answer/id #uuid "e0dac5b6-786f-5744-93c0-87b1055f2912" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260651} :answer-field/id #uuid "32524753-7bf7-51bd-b7ec-0c1ce05625a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260648}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f30cf6e1-a2f7-50a2-8c61-f5748c2a0e0f" :question/math-academy-id "q-49841" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true?\n\nI. - ${\\sum }_{n=100}^{\\infty }{a}_{n}$ is convergent\nII. - ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is divergent\nIII. - $1\\,000{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent" :question/worked-solution "Let's recall the properties of convergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}=K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is also convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Removing a finite number of terms from a convergent series gives a convergent series.\n\n- Statement II is false. The sum of two convergent series is convergent.\n\n- Statement III is true. Any constant multiple of a convergent series gives a convergent series.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186260703 :knowledge-point/_questions [{:knowledge-point/id #uuid "5fd76722-397f-564f-b592-52156e86ddc0" :knowledge-point/title "Solving Logarithmic Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e1cdbb0-3158-56a8-8bf1-b12a39213539" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260705}] :answer-field/correct {:answer/id #uuid "5e1cdbb0-3158-56a8-8bf1-b12a39213539" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260705} :answer-field/id #uuid "afb138c8-d5fe-521b-a16b-e38a7fd1ad20" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260704}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "51e5f7cc-f758-5b6e-9b53-61015feb7246" :question/math-academy-id "q-5174" :question/problem "If ${log}_{2}x=3$, then what is $x?$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $2,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{2}x & =3 \\\\ {2}^{{log}_{2}x} & ={2}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${2}^{{log}_{2}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={2}^{3} \\\\ x & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260767 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc45bf8f-2f0f-5ab9-b7d4-e9a3300b52a6" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Fractional Roots With Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df91f6fb-ce3d-5528-802d-79e7b4a13d87" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{6}\\text{i}" :db/id #edb/ref 17592186260769}] :answer-field/correct {:answer/id #uuid "df91f6fb-ce3d-5528-802d-79e7b4a13d87" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{6}\\text{i}" :db/id #edb/ref 17592186260769} :answer-field/id #uuid "bc881db0-23a3-519b-9eac-a5a7cc486a8d" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260768} {:answer-field/choices [{:answer/id #uuid "a80b6205-4143-51b2-8a80-4275d5744a71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}\\text{i}" :db/id #edb/ref 17592186260771}] :answer-field/correct {:answer/id #uuid "a80b6205-4143-51b2-8a80-4275d5744a71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}\\text{i}" :db/id #edb/ref 17592186260771} :answer-field/id #uuid "0445b6df-6822-5ad7-ad25-d1e3aa0428ce" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260770}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "34a045e8-fdb7-5bf9-9392-e9e2795878f6" :question/math-academy-id "q-54632" :question/problem "What are the solutions to $-24{t}^{2}-2=0?$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}-24{t}^{2}-2 & =0 \\\\ -24{t}^{2} & =2 \\\\ {t}^{2} & =-\\frac{2}{24} \\\\ {t}^{2} & =-\\frac{1}{12}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nt=\\pm \\sqrt{-\\frac{1}{12}}\n$$\n\nWe now rewrite $t$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}t & =\\pm \\sqrt{-\\frac{1}{12}} \\\\  & =\\pm \\sqrt{\\frac{1}{12}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{1}{12}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{1}}{\\sqrt{12}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{1}}{2\\sqrt{3}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{1}{2\\sqrt{3}}\\text{i}\\end{aligned}\n$$\n\nFinally, we rationalize the denominator:\n\n$$\n\\begin{aligned}t & =\\pm \\frac{1}{2\\sqrt{3}}\\text{i} \\\\  & =\\pm \\frac{1}{2\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{3}}{6}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260869 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641d7778-b4a5-5a1f-9803-f84355fa85f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x)" :db/id #edb/ref 17592186260871}] :answer-field/correct {:answer/id #uuid "641d7778-b4a5-5a1f-9803-f84355fa85f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x)" :db/id #edb/ref 17592186260871} :answer-field/id #uuid "5cfbbf58-a0ba-5f08-ad19-4b0db32db4a1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260870}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8bb03c0c-2bf3-5dda-8102-58698d5cc17e" :question/math-academy-id "q-65502" :question/problem "$\\operatorname{cos}(x+\\frac{2\\pi }{3})=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}(u+v)=\\operatorname{cos}u\\operatorname{cos}v-\\operatorname{sin}u\\operatorname{sin}v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}(x+\\frac{2\\pi }{3}) & =\\operatorname{cos}x\\operatorname{cos}(\\frac{2\\pi }{3})-\\operatorname{sin}x\\operatorname{sin}(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}x\\cdot (-\\frac{1}{2})-\\operatorname{sin}x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}x+\\sqrt{3}\\operatorname{sin}x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260917 :knowledge-point/_questions [{:knowledge-point/id #uuid "701015d7-cc6a-52ff-b40d-627a640cd0fb" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a44db1bc-9298-57d1-8e01-11f9e5b2cc36" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}\\text{i}" :db/id #edb/ref 17592186260919}] :answer-field/correct {:answer/id #uuid "a44db1bc-9298-57d1-8e01-11f9e5b2cc36" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}\\text{i}" :db/id #edb/ref 17592186260919} :answer-field/id #uuid "a99ba2b0-4b8c-597c-a54d-a843c069dc63" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260918} {:answer-field/choices [{:answer/id #uuid "3cf50468-3a39-541a-b9e4-e37113140920" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\text{i}" :db/id #edb/ref 17592186260921}] :answer-field/correct {:answer/id #uuid "3cf50468-3a39-541a-b9e4-e37113140920" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\text{i}" :db/id #edb/ref 17592186260921} :answer-field/id #uuid "bfe18c4b-63d6-5f20-b642-e5a386485e28" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260920}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f724ceca-0067-5fb3-8235-2b58d83a773f" :question/math-academy-id "q-66252" :question/problem "If $4{y}^{2}+25=0,$ then $y=$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}+25 & =0 \\\\ 4{y}^{2} & =-25 \\\\ {y}^{2} & =-\\frac{25}{4}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\ny=\\pm \\sqrt{-\\frac{25}{4}}\n$$\n\nWe now rewrite $y$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}y & =\\pm \\sqrt{-\\frac{25}{4}} \\\\  & =\\pm \\sqrt{\\frac{25}{4}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{25}{4}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{25}}{\\sqrt{4}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{5}{2}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260981 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d076e5d-9d08-5355-b813-d1749feb0803" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3c1e965-aeee-5783-9611-e024460bf705" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{4}(11)" :db/id #edb/ref 17592186260983}] :answer-field/correct {:answer/id #uuid "b3c1e965-aeee-5783-9611-e024460bf705" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{4}(11)" :db/id #edb/ref 17592186260983} :answer-field/id #uuid "df1cad20-449e-5a8e-a4b7-f19180feea15" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260982}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "201b2cc7-e621-5a40-94ff-980ef3cc44e5" :question/math-academy-id "q-66832" :question/problem "Find the exact solution to the equation $3({4}^{y})-14=19.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}3({4}^{y})-14 & =19 \\\\ 3({4}^{y}) & =33 \\\\ {4}^{y} & =11\\end{aligned}\n$$\n\nNow, we take ${log}_{4}$ of both sides of the equation and solve for $y$:\n\n$$\n\\begin{aligned}{log}_{4}({4}^{y}) & ={log}_{4}(11) \\\\ y & ={log}_{4}(11)\\end{aligned}\n$$\n\nTherefore, the solution is $y={log}_{4}(11).$"}] [{:db/id #edb/ref 17592186261128 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78" :knowledge-point/title "Solving Logarithmic Equations by First Rearranging the Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef22657b-07c2-55e8-850e-53f5cacb390e" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186261130}] :answer-field/correct {:answer/id #uuid "ef22657b-07c2-55e8-850e-53f5cacb390e" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186261130} :answer-field/id #uuid "b50d5e7f-236c-51dc-af70-45c7389804d0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261129}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "513d3cec-982b-533e-81bb-8c54a8125de4" :question/math-academy-id "q-70017" :question/problem "If ${log}_{3}(x-6)+5=8$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}{log}_{3}(x-6)+5 & =8 \\\\ {log}_{3}(x-6) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}(x-6) & =3 \\\\ {3}^{{log}_{3}(x-6)} & ={3}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}(x-6)}=x-6.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-6 & ={3}^{3} \\\\ x-6 & =27 \\\\ x & =33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261131 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78" :knowledge-point/title "Solving Logarithmic Equations by First Rearranging the Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02211a15-7355-5260-8fcb-254354108bd0" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261133}] :answer-field/correct {:answer/id #uuid "02211a15-7355-5260-8fcb-254354108bd0" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261133} :answer-field/id #uuid "7d747a78-d797-5920-a99b-727c7561455e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261132}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6670ae0c-7bd3-5be8-8afd-7e9eadd30b6f" :question/math-academy-id "q-70018" :question/problem "If $6{log}_{4}(x+11)=12$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}6{log}_{4}(x+11) & =12 \\\\ {log}_{4}(x+11) & =\\frac{12}{6} \\\\ {log}_{4}(x+11) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}(x+11) & =2 \\\\ {4}^{{log}_{4}(x+11)} & ={4}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}(x+11)}=x+11.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+11 & ={4}^{2} \\\\ x+11 & =16 \\\\ x & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261161 :knowledge-point/_questions [{:knowledge-point/id #uuid "993a1649-c534-5a08-805f-3388c2f83b20" :knowledge-point/title "Dividing Rational Expressions with No Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f07f7a29-73e7-5018-9a3a-1c352f5f1553" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16a}{21b}" :db/id #edb/ref 17592186261163}] :answer-field/correct {:answer/id #uuid "f07f7a29-73e7-5018-9a3a-1c352f5f1553" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16a}{21b}" :db/id #edb/ref 17592186261163} :answer-field/id #uuid "8771c53a-74b9-50a2-8889-75fc553725e0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4d031f53-2cb0-5ef4-9eb5-4fffa3c8a6c0" :question/math-academy-id "q-70350" :question/problem "What is the result of dividing $\\frac{8a}{3}$ by $\\frac{7b}{2}?$\n\nAnswer: {{answer}}" :question/worked-solution "To compute\n\n$$\n\\frac{8a}{3}÷\\frac{7b}{2},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8a}{3}÷\\frac{7b}{2} & = \\\\ \\frac{8a}{3}\\cdot \\frac{2}{7b} & = \\\\ \\frac{16a}{21b} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261164 :knowledge-point/_questions [{:knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2ba21c6-5dbd-5441-a3ab-86955663155a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261166}] :answer-field/correct {:answer/id #uuid "e2ba21c6-5dbd-5441-a3ab-86955663155a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261166} :answer-field/id #uuid "cd0f09be-093c-5e06-af95-ab99aea76101" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261165}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "deb08641-7369-57ac-a4cc-afb3b4f81d58" :question/math-academy-id "q-70355" :question/problem "$\\frac{14}{a}÷\\frac{7}{b}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute\n\n$$\n\\frac{14}{a}÷\\frac{7}{b},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14}{a}÷\\frac{7}{b} & = \\\\ \\frac{14}{a}\\cdot \\frac{b}{7} & = \\\\ \\frac{14b}{7a} & = \\\\ \\frac{2\\cdot \\cancel{7}\\cdot b}{\\cancel{7}a} & = \\\\ \\frac{2b}{a} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $7$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186261261 :knowledge-point/_questions [{:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53fa7533-ef15-5cdb-886b-85d4552daab9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}2}+4\\operatorname{ln}2" :db/id #edb/ref 17592186261263}] :answer-field/correct {:answer/id #uuid "53fa7533-ef15-5cdb-886b-85d4552daab9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}2}+4\\operatorname{ln}2" :db/id #edb/ref 17592186261263} :answer-field/id #uuid "d6a7b0e3-b7de-5a49-bb4f-9f16b34e5de5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261262}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9194b183-89a8-5cf0-9567-8d024e74d060" :question/math-academy-id "q-70897" :question/problem "Given that $y=2{log}_{2}x+{2}^{x}$, find the slope of the tangent at $x=2.$\n\nAnswer: {{answer}}" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}2}+{2}^{x}\\operatorname{ln}2\\,.\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{2}{x\\operatorname{ln}2}+{2}^{x}\\operatorname{ln}2)|}_{x=2} \\\\  & =\\frac{2}{2\\cdot \\operatorname{ln}2}+{2}^{2}\\operatorname{ln}2 \\\\  & =\\frac{1}{\\operatorname{ln}2}+4\\operatorname{ln}2\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261348 :knowledge-point/_questions [{:knowledge-point/id #uuid "e25f87c9-3f2e-59a6-ad45-66f0640e68ef" :knowledge-point/title "Solving a Cubic Equation With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adee0ecc-80f7-537c-884d-c7171e95523e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261350}] :answer-field/correct {:answer/id #uuid "adee0ecc-80f7-537c-884d-c7171e95523e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261350} :answer-field/id #uuid "aa901033-8b8a-5397-a5eb-b35c081d2689" :answer-field/key "root-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261349} {:answer-field/choices [{:answer/id #uuid "d2bf68f7-8f17-5d48-a0c8-4753c3310bc5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261352}] :answer-field/correct {:answer/id #uuid "d2bf68f7-8f17-5d48-a0c8-4753c3310bc5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261352} :answer-field/id #uuid "2113cfb0-dcde-5210-8cf3-60a45e92f9f7" :answer-field/key "root-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261351} {:answer-field/choices [{:answer/id #uuid "1e5ee175-51be-52ac-916b-773e369a6a66" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261354}] :answer-field/correct {:answer/id #uuid "1e5ee175-51be-52ac-916b-773e369a6a66" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261354} :answer-field/id #uuid "228f0d78-7b41-5269-8680-1df663ae7c7c" :answer-field/key "root-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261353}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "56a901dc-9638-58ff-af9a-f87cff2b0a14" :question/math-academy-id "q-71778" :question/problem "Solve the equation $5{z}^{3}-35{z}^{2}+50z=0.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "First, notice that all of the terms of the polynomial have a common factor of $5z.$ We can factor out the $5z$ as follows:\n\n$$\n\\begin{aligned}5{z}^{3}-35{z}^{2}+50z & =0 \\\\ 5z({z}^{2}-7z+10) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${z}^{2}-7z+10$ as follows:\n\n$$\n\\begin{aligned}5z({z}^{2}-7z+10) & =0 \\\\ 5z(z-2)(z-5) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $z=0,$ $z=2,$ and $z=5.$"}] [{:db/id #edb/ref 17592186261355 :knowledge-point/_questions [{:knowledge-point/id #uuid "3974b5c6-129f-5616-be84-08b6ab779f70" :knowledge-point/title "Solving a Higher-Order Polynomial Equation With No Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9034ebe5-feef-5495-9442-cddbdee5f57b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac13" :db/id #edb/ref 17592186261357}] :answer-field/correct {:answer/id #uuid "9034ebe5-feef-5495-9442-cddbdee5f57b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac13" :db/id #edb/ref 17592186261357} :answer-field/id #uuid "0efa319f-abe0-5aa0-ae2b-cc05e27ff7d6" :answer-field/key "root-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261356} {:answer-field/choices [{:answer/id #uuid "c928b2a7-f20b-58e4-9a77-0cc2ebee6b79" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261359}] :answer-field/correct {:answer/id #uuid "c928b2a7-f20b-58e4-9a77-0cc2ebee6b79" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261359} :answer-field/id #uuid "2eb521c9-4ece-56d2-afa4-907e8ab9f519" :answer-field/key "root-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261358} {:answer-field/choices [{:answer/id #uuid "141a2e77-c24b-5cfa-881d-5cdd835310a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac72" :db/id #edb/ref 17592186261361}] :answer-field/correct {:answer/id #uuid "141a2e77-c24b-5cfa-881d-5cdd835310a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac72" :db/id #edb/ref 17592186261361} :answer-field/id #uuid "53ab5d41-7bee-52e8-8c68-50edcb4f474d" :answer-field/key "root-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261360}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bfbcf977-a1e8-5bf7-8080-66924ccaab82" :question/math-academy-id "q-71782" :question/problem "Find the roots of the polynomial $p(t)=30{t}^{5}-95{t}^{4}-35{t}^{3}.$\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}\n\nValue 3 (least to greatest): {{root-3}}" :question/worked-solution "To find the roots of the polynomial, we must solve the equation $p(t)=0,$ that is\n\n$$\n30{t}^{5}-95{t}^{4}-35{t}^{3}=0.\n$$\n\nFirst, notice that all of the terms of the polynomial have a common factor of $5{t}^{3}.$ We can factor out the $5{t}^{3}$ as follows:\n\n$$\n\\begin{aligned}5{t}^{3}(6{t}^{2}-19t-7) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $6{t}^{2}-19t-7$ as follows:\n\n$$\n\\begin{aligned}5{t}^{3}(6{t}^{2}-19t-7) & =0 \\\\ 5{t}^{3}(3t+1)(2t-7) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $t=0,$ $t=-\\frac{1}{3},$ and $t=\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186261365 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecb9df79-5227-5fc6-9a20-818fee34e971" :knowledge-point/title "Using the Right Riemann Sum With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee1d4ba-d69b-5847-a859-94521b94f113" :answer/type {:db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186261367}] :answer-field/correct {:answer/id #uuid "eee1d4ba-d69b-5847-a859-94521b94f113" :answer/type {:db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186261367} :answer-field/id #uuid "f22aac6e-74b5-5d2e-aa51-0c181d3d7ce6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261366}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71771640-36aa-5365-9496-11f66f198e7d" :question/math-academy-id "q-72064" :question/problem "The following table shows the number of customers per minute, $C(t),$ that arrive at a bank, measured over a period of $15$ minutes.\n\n| $t\\,\\text{(minutes)}$ | $0$ | $3$ | $7$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- |\n| $C(t)\\,\\text{(customers/minute)}$ | $3$ | $4$ | $3$ | $5$ | $2$ |\n\nUse the right Riemann sum over $[0,15]$ with four subintervals to approximate the total number of customers served.\n\nAnswer: {{answer}}" :question/worked-solution "Let $A$ denote the area under the curve $y=C(t)$ over $[0,15].$ In this case, we have $n=4$ rectangles. Using the right Riemann sum, the area is approximated as \n\n$$\nA\\approx C(3)Δ{t}_{1}+C(7)Δ{t}_{2}+C(12)Δ{t}_{3}+C(15)Δ{t}_{4},\n$$\n\nwhere each $Δ{t}_{i}$ is calculated by considering the step between a particular $t$-value and the previous one, i.e.,\n\n$$\nΔ{t}_{i}={t}_{i}-{t}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δt$'s.\n\n| $t$ | $0$ | $3$ | $7$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- |\n| $Δt$ | $-$ | $3$ | $4$ | $5$ | $3$ |\n| $C(t)$ | $-$ | $4$ | $3$ | $5$ | $2$ |\n\nWe plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & \\approx 4\\cdot 3+3\\cdot 4+5\\cdot 5+2\\cdot 3 \\\\  & =12+12+25+6 \\\\  & =55.\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total number of customers served over a period of $15$ minutes. So, the total number of customers is approximately\n$55.$"}] [{:db/id #edb/ref 17592186261374 :knowledge-point/_questions [{:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac2fc9cc-427e-5a52-ad15-3495b432c99a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x\\operatorname{tan}x\\operatorname{cos}(\\operatorname{sec}x)" :db/id #edb/ref 17592186261376}] :answer-field/correct {:answer/id #uuid "ac2fc9cc-427e-5a52-ad15-3495b432c99a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}x\\operatorname{tan}x\\operatorname{cos}(\\operatorname{sec}x)" :db/id #edb/ref 17592186261376} :answer-field/id #uuid "4bfc3020-57b5-552b-ac6e-9d5c432ccce1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261375}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f5156b8-2062-5adc-85c3-14a0aa909be9" :question/math-academy-id "q-72163" :question/problem "Find the derivative of $y=\\operatorname{sin}(\\operatorname{sec}x).$\n\nAnswer: {{answer}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\operatorname{sin}u,\\,u=\\operatorname{sec}x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{cos}u,\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}x\\operatorname{tan}x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\operatorname{cos}u\\cdot (\\operatorname{sec}x\\operatorname{tan}x) \\\\  & =\\operatorname{sec}x\\operatorname{tan}x\\operatorname{cos}(\\operatorname{sec}x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261490 :knowledge-point/_questions [{:knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34caa26-5f27-577f-8e03-422281cd8826" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261492}] :answer-field/correct {:answer/id #uuid "a34caa26-5f27-577f-8e03-422281cd8826" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261492} :answer-field/id #uuid "7c45fb31-4247-5b73-97e3-1ea727fd41cd" :answer-field/key "time-s" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261491} {:answer-field/choices [{:answer/id #uuid "c97d4513-2be1-5a3e-adfd-fc5458c9499b" :answer/type {:db/ident :answer.type/math} :answer/value "-1/e^2" :db/id #edb/ref 17592186261494}] :answer-field/correct {:answer/id #uuid "c97d4513-2be1-5a3e-adfd-fc5458c9499b" :answer/type {:db/ident :answer.type/math} :answer/value "-1/e^2" :db/id #edb/ref 17592186261494} :answer-field/id #uuid "86c23dbb-d50f-502d-9f65-2aa430c4048d" :answer-field/key "velocity-m-per-s" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261493}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9016b9c4-555f-5f54-8e92-6ab14881289d" :question/math-academy-id "q-73243" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=t{e}^{-t},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment.\n\nTime s: {{time-s}}\n\nVelocity m per s: {{velocity-m-per-s}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t{e}^{-t}) \\\\  & =(1-t){e}^{-t}\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((1-t){e}^{-t}) \\\\  & =(t-2){e}^{-t}\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}0 & =(t-2){e}^{-t} \\\\ t-2 & =0 \\\\ t & =2\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=2.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(2) & =(1-(2)){e}^{-(2)} \\\\  & =-{e}^{-2} \\\\  & =-\\frac{1}{{e}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261501 :knowledge-point/_questions [{:knowledge-point/id #uuid "11263ba1-2ef9-5c93-8c56-d09dcbea8f8b" :knowledge-point/title "Calculating the Sum of a Geometric Series Given Two Consecutive Terms of the Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4264b569-e7c0-555a-8ec9-c5a63046db75" :answer/type {:db/ident :answer.type/math} :answer/value "127" :db/id #edb/ref 17592186261503}] :answer-field/correct {:answer/id #uuid "4264b569-e7c0-555a-8ec9-c5a63046db75" :answer/type {:db/ident :answer.type/math} :answer/value "127" :db/id #edb/ref 17592186261503} :answer-field/id #uuid "4738a03a-d5cd-5418-9836-3ec26a7ff4bd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261502}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a1680abc-bbec-518f-a962-a951e4463528" :question/math-academy-id "q-73306" :question/problem "The fifth term of a geometric series is $4$ and the sixth term is $2.$ What is the sum of the first $7$ terms?\n\nAnswer: {{answer}}" :question/worked-solution "The sum of the first $N$ terms of a geometric series is given by the formula\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r},\n$$\n\nwhere ${a}_{1}$ is the first term of the series, and $r$ is the common ratio.\n\nTo find $r,$ we find the ratio between the consecutive terms ${a}_{5}$ and ${a}_{6}:$\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{6}}{{a}_{5}} \\\\  & =\\frac{2}{4} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow we must determine the value of ${a}_{1}.$ To do this, we use the formula for the $n$th term, which states that\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1}.\n$$\n\nFor $n=5,$ we get:\n\n$$\n\\begin{aligned}{a}_{5} & ={a}_{1}\\cdot {(\\frac{1}{2})}^{5-1} \\\\ 4 & ={a}_{1}\\cdot {(\\frac{1}{2})}^{4} \\\\ 4 & ={a}_{1}\\cdot \\frac{1}{16} \\\\ {a}_{1} & =\\frac{4}{(\\frac{1}{16})} \\\\ {a}_{1} & =64\\end{aligned}\n$$\n\nFinally, if we substitute ${a}_{1}=64,N=7$ and $r=\\frac{1}{2}$ into the formula for ${S}_{N},$ we obtain:\n\n$$\n\\begin{aligned}{S}_{7} & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{1-\\frac{1}{2}} \\\\  & =64\\cdot \\frac{1-{(\\frac{1}{2})}^{7}}{\\frac{1}{2}} \\\\  & =\\frac{64}{(\\frac{1}{2})}\\cdot (1-\\frac{1}{128}) \\\\  & =128(1-\\frac{1}{128}) \\\\  & =128-1 \\\\  & =127\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261546 :knowledge-point/_questions [{:knowledge-point/id #uuid "00d82333-e4e0-5527-a084-0af8affe5bee" :knowledge-point/title "Calculating a Left Riemann Sum With Irregular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a464cdf4-38d9-50a8-8df7-ec69e984734d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186261548}] :answer-field/correct {:answer/id #uuid "a464cdf4-38d9-50a8-8df7-ec69e984734d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186261548} :answer-field/id #uuid "bec393cc-fbfd-5b39-83c2-d0012450e168" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261547}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41763944-ffc1-5cbe-ae34-8d6954078ad7" :question/math-academy-id "q-74505" :question/problem "The following table shows some values of a continuous function $f(x)$ over the interval $[2,12].$\n\n| $x$ | $2$ | $4$ | $8$ | $10$ | $12$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $3$ | $2$ | $1$ | $1$ |\n\nUse the left Riemann sum, with the four subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[2,12].$\n\nAnswer: {{answer}}" :question/worked-solution "In this case, we have $n=4$ rectangles. Using the left Riemann sum, the area is approximated as\n\n$$\nA\\approx f(2)Δ{x}_{1}+f(4)Δ{x}_{2}+f(8)Δ{x}_{3}+f(10)Δ{x}_{4},\n$$\n\nwhere each $Δ{x}_{i}$ is calculated by considering the step between a particular $x$-value and the next one, i.e.,\n\n$$\nΔ{x}_{i}={x}_{i+1}-{x}_{i}.\n$$\n\nWe set up a value table that includes the $Δx$'s.\n\n| $x$ | $2$ | $4$ | $8$ | $10$ | $12$ |\n| --- | --- | --- | --- | --- | --- |\n| $Δx$ | $2$ | $4$ | $2$ | $2$ | $-$ |\n| $f(x)$ | $5$ | $3$ | $2$ | $1$ | $1$ |\n\nFinally, we plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & \\approx 5\\cdot 2+3\\cdot 4+2\\cdot 2+1\\cdot 2 \\\\  & =10+12+4+2 \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261567 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252a4fbf-f54e-5ebb-bb5f-29468c0431d6" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261569}] :answer-field/correct {:answer/id #uuid "252a4fbf-f54e-5ebb-bb5f-29468c0431d6" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261569} :answer-field/id #uuid "e6225757-a29d-5471-869e-ed7428c25f85" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261568}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a178c1c-f11d-5828-ae41-32c929e1c753" :question/math-academy-id "q-75001" :question/problem "Find $|r(\\frac{\\pi }{3})|$ given that $r(t)=⟨2\\operatorname{cos}t,\\,4\\operatorname{sin}t,\\,6⟩.$\n\nAnswer: {{answer}}" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨2\\operatorname{cos}(\\frac{\\pi }{3}),\\,4\\operatorname{sin}(\\frac{\\pi }{3}),\\,6⟩ \\\\  & =⟨2\\cdot \\frac{1}{2},\\,4\\cdot \\frac{\\sqrt{3}}{2},\\,6⟩ \\\\  & =⟨1,\\,2\\sqrt{3},\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(1)}^{2}+{(2\\sqrt{3})}^{2}+(6)^{2}} \\\\  & =\\sqrt{1+12+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261584 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14059387-7cc6-5a22-93fe-ea7e7cf93cfa" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186261586}] :answer-field/correct {:answer/id #uuid "14059387-7cc6-5a22-93fe-ea7e7cf93cfa" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186261586} :answer-field/id #uuid "2ce71eca-a2b1-5174-a2e2-8be1c786d9e7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261585}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "64aca08e-6aad-5814-b106-f9f74dd6f182" :question/math-academy-id "q-75637" :question/problem "Consider the positive infinite geometric sequence that has a first term equal to $56$ and a third term equal to $\\frac{7}{8}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=56$ and ${a}_{3}=\\frac{7}{8}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{3-1} & =\\frac{(\\frac{7}{8})}{56} \\\\ {r}^{2} & =(\\frac{7}{8})(\\frac{1}{56}) \\\\ {r}^{2} & =\\frac{1}{64} \\\\ r & =\\sqrt{\\frac{1}{64}} \\\\ r & =\\frac{1}{8}\\end{aligned}\n$$\n\nNote that we have taken the positive square root since we're told that the sequence is positive.\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{56}{(1-\\frac{1}{8})} \\\\  & =\\frac{56}{(\\frac{7}{8})} \\\\  & =56(\\frac{8}{7}) \\\\  & =64.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261599 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c698912-1f35-5110-8d5d-d490cce2e9a7" :knowledge-point/title "Solving Rational Equations Containing Quadratic Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "219ce7e5-8d95-57ca-a29e-117e34fb5649" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186261601}] :answer-field/correct {:answer/id #uuid "219ce7e5-8d95-57ca-a29e-117e34fb5649" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186261601} :answer-field/id #uuid "25ca1f87-1e1d-58c4-8107-110f2c30036e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261600}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c7212979-12af-55e0-b574-fe7390124c7f" :question/math-academy-id "q-75961" :question/problem "Which value of $y$ satisfies the equation $\\frac{y+1}{{y}^{2}}=\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}}?$\n\nAnswer: {{answer}}" :question/worked-solution "We note that $y=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators ${y}^{2}$ and $2y.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}({y}^{2},2y)=2{y}^{2}.\n$$\n\nSo, we multiply both sides of the equation by $2{y}^{2},$ and simplify: \n\n$$\n\\begin{aligned}\\frac{y+1}{{y}^{2}} & =\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}} \\\\ 2{y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =2{y}^{2}\\cdot (\\frac{3}{2y}+\\frac{2y-1}{{y}^{2}}) \\\\ 2{y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =2{y}^{2}\\cdot (\\frac{3}{2y})+2{y}^{2}\\cdot (\\frac{2y-1}{{y}^{2}}) \\\\ 2\\cdot {y}^{2}\\cdot (\\frac{y+1}{{y}^{2}}) & =y\\cdot 2y\\cdot (\\frac{3}{2y})+2\\cdot {y}^{2}\\cdot (\\frac{2y-1}{{y}^{2}}) \\\\ 2\\cdot \\cancel{{y}^{2}}\\cdot (\\frac{y+1}{\\cancel{{y}^{2}}}) & =y\\cdot \\cancel{2y}\\cdot (\\frac{3}{\\cancel{2y}})+2\\cdot \\cancel{{y}^{2}}\\cdot (\\frac{2y-1}{\\cancel{{y}^{2}}}) \\\\ 2(y+1) & =3y+2(2y-1)\\end{aligned}\n$$\n\nWe now have a linear equation in $y,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}2(y+1) & =3y+2(2y-1) \\\\ 2y+2 & =7y-2 \\\\ 7y-2y & =2+2 \\\\ 5y & =4 \\\\ y & =\\frac{4}{5}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $y=0$ as a solution. But since $y=\\frac{4}{5}\\ne 0,$ we conclude that the solution is $y=\\frac{4}{5}.$"}] [{:db/id #edb/ref 17592186261614 :knowledge-point/_questions [{:knowledge-point/id #uuid "386bce9a-0c89-545c-b9ed-b9f67fb836b2" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Solutions With Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dab70658-07e0-5fa2-a80f-84d20695ac9b" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186261616}] :answer-field/correct {:answer/id #uuid "dab70658-07e0-5fa2-a80f-84d20695ac9b" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186261616} :answer-field/id #uuid "a9220558-be9c-55b7-aab1-84096e6c445f" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261615} {:answer-field/choices [{:answer/id #uuid "d1f2c148-a0f7-5f24-908f-63661447eec2" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186261618}] :answer-field/correct {:answer/id #uuid "d1f2c148-a0f7-5f24-908f-63661447eec2" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186261618} :answer-field/id #uuid "f01aeed2-550e-536e-9a98-81ddb37943df" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261617}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2e678503-4a31-59f2-91e3-8d0ec7418e01" :question/math-academy-id "q-76538" :question/problem "If $\\frac{{p}^{2}}{5}+15=0,$ then $p=$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}\\frac{{p}^{2}}{5}+15 & =0 \\\\ \\frac{{p}^{2}}{5} & =-15 \\\\ {p}^{2} & =-75\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\np=\\pm \\sqrt{-75}\n$$\n\nWe now rewrite $p$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}p & =\\pm \\sqrt{-75} \\\\  & =\\pm \\sqrt{75\\cdot (-1)} \\\\  & =\\pm \\sqrt{75}\\cdot \\sqrt{-1} \\\\  & =\\pm 5\\sqrt{3}\\cdot \\sqrt{-1} \\\\  & =\\pm 5\\sqrt{3}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261619 :knowledge-point/_questions [{:knowledge-point/id #uuid "701015d7-cc6a-52ff-b40d-627a640cd0fb" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c6ce8d-f149-5248-9c5c-2360d8da8d64" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\text{i}" :db/id #edb/ref 17592186261621}] :answer-field/correct {:answer/id #uuid "87c6ce8d-f149-5248-9c5c-2360d8da8d64" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\text{i}" :db/id #edb/ref 17592186261621} :answer-field/id #uuid "130c9408-369b-5d6f-9a4b-6753b529aac9" :answer-field/key "negative-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261620} {:answer-field/choices [{:answer/id #uuid "4c53f060-0c5e-5953-8600-1e8b4504118e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\text{i}" :db/id #edb/ref 17592186261623}] :answer-field/correct {:answer/id #uuid "4c53f060-0c5e-5953-8600-1e8b4504118e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\text{i}" :db/id #edb/ref 17592186261623} :answer-field/id #uuid "d9250e63-0b12-5035-b12a-50eb35a4e88d" :answer-field/key "positive-imaginary" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261622}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4a80650b-addc-581e-a84e-299da6eb427d" :question/math-academy-id "q-76539" :question/problem "If $9{z}^{2}+1=0$, then $z=$\n\nNegative imaginary: {{negative-imaginary}}\n\nPositive imaginary: {{positive-imaginary}}" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}9{z}^{2}+1 & =0 \\\\ 9{z}^{2} & =-1 \\\\ {z}^{2} & =-\\frac{1}{9}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nz=\\pm \\sqrt{-\\frac{1}{9}}\n$$\n\nWe now rewrite $z$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}z & =\\pm \\sqrt{-\\frac{1}{9}} \\\\  & =\\pm \\sqrt{\\frac{1}{9}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{1}{9}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{1}}{\\sqrt{9}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{1}{3}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261733 :knowledge-point/_questions [{:knowledge-point/id #uuid "98fb5d45-5215-506c-8b2a-99aaadb6631c" :knowledge-point/title "Solving Logarithmic Equations With Linear Arguments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90560ae3-56f4-52be-a0b1-acd9dd6e99b2" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261735}] :answer-field/correct {:answer/id #uuid "90560ae3-56f4-52be-a0b1-acd9dd6e99b2" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261735} :answer-field/id #uuid "7bb5e72b-9a4d-5593-8f5b-f183f0e6e8a7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261734}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "036e1450-c076-5d46-8a8b-161ca824e7b5" :question/math-academy-id "q-79380" :question/problem "If ${log}_{9}(2y-3)=1$, then $y=$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $9,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{9}(2y-3) & =1 \\\\ {9}^{{log}_{9}(2y-3)} & ={9}^{1}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${9}^{{log}_{9}(2y-3)}=2y-3.$\n\nTherefore,\n\n$$\n\\begin{aligned}2y-3 & =9 \\\\ 2y & =12 \\\\ y & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261736 :knowledge-point/_questions [{:knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423" :knowledge-point/title "Solving Logarithmic Equations by Combining Logarithmic Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20548a01-2b86-54af-86e2-47785b72dd24" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186261738}] :answer-field/correct {:answer/id #uuid "20548a01-2b86-54af-86e2-47785b72dd24" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186261738} :answer-field/id #uuid "4a4a00ad-aa7d-55a1-b4fc-d55a24214956" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261737}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "085c7d1a-1e1a-5955-8d31-2be9a5ca85e3" :question/math-academy-id "q-79389" :question/problem "If $5{log}_{4}x+3{log}_{4}x=16$, then $x=$\n\nAnswer: {{answer}}" :question/worked-solution "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}5{log}_{4}x+3{log}_{4}x & =16 \\\\ (5+3){log}_{4}x & =16 \\\\ 8{log}_{4}x & =16 \\\\ {log}_{4}x & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}x & =2 \\\\ {4}^{{log}_{4}x} & ={4}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={4}^{2} \\\\ x & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261769 :knowledge-point/_questions [{:knowledge-point/id #uuid "90b485f8-a07d-55f4-8cde-f699070eeae7" :knowledge-point/title "Identifying Monotonic Polynomial and Rational Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baac2114-91db-50b1-a268-6631f4f42b1b" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261771} {:answer/id #uuid "079f0eeb-7453-5945-9b06-9e1dad690e83" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261772} {:answer/id #uuid "8359f964-b89c-5b20-ba35-f8bbc3c43e56" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261773} {:answer/id #uuid "8f18f449-3068-57cf-a6d1-faeaf52320da" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261774} {:answer/id #uuid "8d243a0b-6222-5ef8-b72d-15bf1f4e8539" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261775} {:answer/id #uuid "13337942-1f12-53a6-aac8-e02e3958ef3d" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261776} {:answer/id #uuid "f0869464-02da-5c0c-8d4c-9fce35de8702" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261777} {:answer/id #uuid "73973f3e-ceb9-5f33-833e-e687f2dcc6e5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261778}] :answer-field/correct {:answer/id #uuid "8359f964-b89c-5b20-ba35-f8bbc3c43e56" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261773} :answer-field/id #uuid "dfdad0fd-561d-5abc-9287-2caf6255bd83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261770}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "752a7942-16ed-5bb1-8e0f-a8b976101dd2" :question/math-academy-id "q-81074" :question/problem "Given that  ${a}_{n}=\\frac{5}{(n+1)^{2}}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\le 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=\\frac{5}{(n+1)^{2}}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is true. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{(\\frac{5}{(n+2)^{2}})}{(\\frac{5}{(n+1)^{2}})} \\\\  & =\\frac{5(n+1)^{2}}{5(n+2)^{2}} \\\\  & =\\frac{(n+1)^{2}}{(n+2)^{2}} \\\\  & ={(\\frac{n+1}{n+2})}^{2}.\\end{aligned}\n$$\n\nNow, since $n\\ge 1,$ it follows that\n\n$$\n\\frac{n+1}{n+2}<1,\n$$\n\nsince the numerator is always smaller than the denominator. Therefore,\n\n$$\n0<L<1.\n$$\n\n- Statement II is false, whereas statement III is true. Since $0<L\\le 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is decreasing.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186261949 :knowledge-point/_questions [{:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f" :knowledge-point/title "Solving an Exponential Equation by Rearranging the Equation and Then Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3ddd15b-be62-51f7-b201-3ba924254ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac34" :db/id #edb/ref 17592186261951}] :answer-field/correct {:answer/id #uuid "c3ddd15b-be62-51f7-b201-3ba924254ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac34" :db/id #edb/ref 17592186261951} :answer-field/id #uuid "fb5b720f-0ca3-5e5c-b135-c481268d32f5" :answer-field/key "product-of-solutions" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261950}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f8148e6a-df0b-54f7-92fc-57c9f0d3a4be" :question/math-academy-id "q-88472" :question/problem "What is the product of solutions of the equation $4{x}^{2}{e}^{5x}=3{e}^{5x}-4x{e}^{5x}?$\n\nProduct of solutions: {{product-of-solutions}}" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4{x}^{2}{e}^{5x} & =3{e}^{5x}-4x{e}^{5x} \\\\ 4{x}^{2}{e}^{5x}+4x{e}^{5x}-3{e}^{5x} & =0 \\\\ (4{x}^{2}+4x-3){e}^{5x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n4{x}^{2}+4x-3=0\\,\\text{and}\\,{e}^{5x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $4{x}^{2}+4x-3=0$ can be factored as\n\n$$\n(2x+3)(2x-1)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{3}{2},\\frac{1}{2}.$\n\n- The equation ${e}^{5x}=0$ has no solutions because ${e}^{5x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{3}{2},\\frac{1}{2},$ and their product is $(-\\frac{3}{2})\\cdot \\frac{1}{2}=-\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186261971 :knowledge-point/_questions [{:knowledge-point/id #uuid "5fd76722-397f-564f-b592-52156e86ddc0" :knowledge-point/title "Solving Logarithmic Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a61867-194c-5c5b-8079-5ef39b6bec38" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,000" :db/id #edb/ref 17592186261973}] :answer-field/correct {:answer/id #uuid "64a61867-194c-5c5b-8079-5ef39b6bec38" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,000" :db/id #edb/ref 17592186261973} :answer-field/id #uuid "37ba8d5d-39aa-537d-aaed-64ef93471dd2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261972}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3f443508-b423-5aae-b226-2edd43a6873e" :question/math-academy-id "q-914" :question/problem "If $\\operatorname{log}y=3$, then $y=$\n\nAnswer: {{answer}}" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the common logarithm is $10,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{log}y & =3 \\\\ {log}_{10}y & =3 \\\\ {10}^{{log}_{10}y} & ={10}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${10}^{{log}_{10}y}=y.$\n\nTherefore,\n\n$$\n\\begin{aligned}y & ={10}^{3} \\\\ y & =1\\,000.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261986 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a" :knowledge-point/title "Finding the End-Behavior of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b93ea71-7aef-56db-9a46-7a8bf77de11e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261988}] :answer-field/correct {:answer/id #uuid "4b93ea71-7aef-56db-9a46-7a8bf77de11e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261988} :answer-field/id #uuid "5c0b24f9-bb9d-54de-beac-975884c53c1c" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261987}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f44d5537-7cca-5193-b04b-aab03731cb25" :question/math-academy-id "q-92985" :question/problem "Find the equation of the horizontal asymptote of the function $f(x)={(\\frac{1}{2})}^{x-3}+4.$\n\n$y =$: {{y}}" :question/worked-solution "Let's plot the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/47d570c5b05096a0e8b7a13df510d8cd71dbee93dd2bf58dae18d7ff49ff1787.png)\n\nSince the function approaches the line $y=4$ as $x\\to \\infty ,$ we conclude that the equation of the horizontal asymptote is $y=4.$"}] [{:db/id #edb/ref 17592186262142 :knowledge-point/_questions [{:knowledge-point/id #uuid "038fb60a-e596-5e48-b05e-f8414d454518" :knowledge-point/title "Infinite Limits of Reciprocal Functions Where the Leading Term Has an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb2e095d-246a-595d-ab5d-34f3ea85f05e" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186262144}] :answer-field/correct {:answer/id #uuid "eb2e095d-246a-595d-ab5d-34f3ea85f05e" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186262144} :answer-field/id #uuid "43197a4a-d042-57f0-a1d3-571f30860d6f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dfb95979-045e-5458-8e60-1f524273f5c3" :question/math-academy-id "q-99341" :question/problem "Compute ${lim}_{x\\to {1}^{-}}\\,\\frac{3}{7(x-1)^{4}}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}\\frac{3}{7(x-1)^{4}} & ={lim}_{x\\to {1}^{-}}(\\frac{3}{7}\\cdot \\frac{1}{(x-1)^{4}}) \\\\  & =\\frac{3}{7}\\cdot {lim}_{x\\to {1}^{-}}\\frac{1}{(x-1)^{4}}\\end{aligned}\n$$\n\nWe can sketch the graph of $y=\\frac{1}{(x-1)^{4}}$ as follows:\n\n- Take the graph of $y=\\frac{1}{{x}^{4}}.$\n\n- Translate it to the right by $1$ unit. This gives $y=\\frac{1}{(x-1)^{4}},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fc826419a3212b7ce5028a59c90ae43c826734719249119ac3be08386bae4481.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to {1}^{-}}\\frac{1}{(x-1)^{4}}=\\infty .\n$$\n\nThe positive factor of $\\frac{3}{7}$ does not change the sign of the limit. Therefore, we conclude that\n\n$$\n\\frac{3}{7}\\cdot {lim}_{x\\to {1}^{-}}\\frac{1}{(x-1)^{4}}=\\infty .\n$$"}] [{:db/id #edb/ref 17592186262148 :knowledge-point/_questions [{:knowledge-point/id #uuid "d107785c-82d2-5dbf-9293-e66fad67ba54" :knowledge-point/title "Evaluating One-Sided Infinite Limits of Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee96c01-0542-57be-8230-68794228c230" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186262150}] :answer-field/correct {:answer/id #uuid "eee96c01-0542-57be-8230-68794228c230" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186262150} :answer-field/id #uuid "23029f69-ff3b-534b-9af2-9f75be7f2975" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262149}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee0af1cf-1b2a-549f-8ef4-b2f7d590c8f6" :question/math-academy-id "q-99658" :question/problem "Calculate ${lim}_{x\\to {3}^{+}}{log}_{7}(x-3).$\n\nAnswer: {{answer}}" :question/worked-solution "Let's sketch the graph of $y={log}_{7}(x-3).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9a25c28ba2bb1c47a32b56620bfb8038d0ec76a51494ee40818c3c18fff94101.png)\n\nThe function is not defined for $x\\le 3.$ Therefore,\n\n$$\n{lim}_{x\\to {3}^{-}}{log}_{7}(x-3)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>3.$ Moreover,\n\n$$\n{lim}_{x\\to {3}^{+}}{log}_{7}(x-3)=-\\infty .\n$$"}]}
