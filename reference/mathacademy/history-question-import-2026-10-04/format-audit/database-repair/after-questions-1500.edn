(k-1)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)\\cdot k\\cdot \\cancel{(k-1)!}}{\\cancel{(k-1)!}} \\\\  & =k(k+1)(k+2)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257466 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e209561-4b0a-557c-802f-0a5efd206604" :answer/type {:db/ident :answer.type/math} :answer/value "(n-1)" :db/id #edb/ref 17592186257468} {:answer/id #uuid "0a472835-c516-5910-805b-f7805cb08c00" :answer/type {:db/ident :answer.type/math} :answer/value "(n-1)^{2}" :db/id #edb/ref 17592186257469} {:answer/id #uuid "aa2ee58b-07ea-5f37-926f-1986ccb81d64" :answer/type {:db/ident :answer.type/math} :answer/value "(n-1)^{3}" :db/id #edb/ref 17592186257470} {:answer/id #uuid "629819e6-148e-5cb1-adf8-947e6d73b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "n(n-1)^{2}" :db/id #edb/ref 17592186257471} {:answer/id #uuid "ed37c071-0dab-5bae-9533-39575192858a" :answer/type {:db/ident :answer.type/math} :answer/value "(n-1)^{2}(n-2)" :db/id #edb/ref 17592186257472}] :answer-field/correct {:answer/id #uuid "aa2ee58b-07ea-5f37-926f-1986ccb81d64" :answer/type {:db/ident :answer.type/math} :answer/value "(n-1)^{3}" :db/id #edb/ref 17592186257470} :answer-field/id #uuid "e312be77-589a-5e40-87c8-4626331f81a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257467}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3768b9a9-d6ba-5788-9af2-24549ab90243" :question/math-academy-id "q-122063" :question/problem "Given that $n\\ge 2$ is an integer, simplify $\\frac{(n-1)^{2}\\,(n-1)!}{(n-2)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n-1)! & =(n-1)(n-2)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n-2)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-1)^{2}\\cdot (n-1)!}{(n-2)!} & =\\frac{(n-1)^{2}\\cdot (n-1)\\cdot (n-2)!}{(n-2)!} \\\\  & =\\frac{(n-1)^{2}\\cdot (n-1)\\cancel{(n-2)!}}{\\cancel{(n-2)!}} \\\\  & =(n-1)^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258816 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82a50d39-d29f-52e0-85f8-4f3954ebd28a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(k+1)^{2}}{k!}" :db/id #edb/ref 17592186258818} {:answer/id #uuid "b5ddf863-39cd-5d4b-b3a8-b634565b2e09" :answer/type {:db/ident :answer.type/math} :answer/value "(k+1)k!" :db/id #edb/ref 17592186258819} {:answer/id #uuid "53069e24-60e2-55cb-802d-a45c95d6ce5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k+1}{k!}" :db/id #edb/ref 17592186258820} {:answer/id #uuid "7390bed0-b01c-5f2a-befd-54ef50e8735e" :answer/type {:db/ident :answer.type/math} :answer/value "(k+1)^{2}k!" :db/id #edb/ref 17592186258821} {:answer/id #uuid "d9a85205-4c01-59c8-80a2-d25bfd66faee" :answer/type {:db/ident :answer.type/math} :answer/value "(k+1)^{2}" :db/id #edb/ref 17592186258822}] :answer-field/correct {:answer/id #uuid "7390bed0-b01c-5f2a-befd-54ef50e8735e" :answer/type {:db/ident :answer.type/math} :answer/value "(k+1)^{2}k!" :db/id #edb/ref 17592186258821} :answer-field/id #uuid "f402311c-4280-5dc9-b696-2f17bc3e00bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258817}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ee6a7d7-dbe7-5b40-954a-acea9efee6e8" :question/math-academy-id "q-19877" :question/problem "Given that $k\\ge 0$ is an integer, $\\frac{{((k+1)!)}^{2}}{k!}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+1)!=(k+1)k!\n$$\n\nThen, we can cancel the $k!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{((k+1)!)}^{2}}{k!} & =\\frac{{((k+1)k!)}^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot (k!)^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot k!\\cdot \\cancel{k!}}{\\cancel{k!}} \\\\  & =(k+1)^{2}k!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258823 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d4b7050-b0ec-506e-8d2d-3de366c66aef" :answer/type {:db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186258825} {:answer/id #uuid "77002e1b-3856-5764-ac6e-3589194b4e01" :answer/type {:db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186258826} {:answer/id #uuid "238bf615-e4f5-5bc6-8891-998d63d57915" :answer/type {:db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186258827} {:answer/id #uuid "acbce194-3273-5052-9801-7566a12961bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186258828} {:answer/id #uuid "43d0cf0c-78ed-59b6-80b1-240f71aac532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186258829}] :answer-field/correct {:answer/id #uuid "77002e1b-3856-5764-ac6e-3589194b4e01" :answer/type {:db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186258826} :answer-field/id #uuid "520f903f-cc0f-5087-a651-ef4c311135ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258824}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4a8f7cc8-f392-57e5-b3c9-254ee480518f" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261411 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124f5eb9-bff4-5f56-809a-79b5740db700" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+1" :db/id #edb/ref 17592186261413} {:answer/id #uuid "29615bcf-2bca-5e3a-a7e0-52dbdb860cc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{k+1}" :db/id #edb/ref 17592186261414} {:answer/id #uuid "e8cb81ff-7440-5ef7-9eef-2eeb634d5ea5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{k}^{2}+k}" :db/id #edb/ref 17592186261415} {:answer/id #uuid "01caa79b-20d4-53dd-9372-34768d9e6bd7" :answer/type {:db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186261416} {:answer/id #uuid "44514ec7-893a-569f-ac23-8f40a2b4a2b2" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+k" :db/id #edb/ref 17592186261417}] :answer-field/correct {:answer/id #uuid "01caa79b-20d4-53dd-9372-34768d9e6bd7" :answer/type {:db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186261416} :answer-field/id #uuid "70fd2ccf-6e96-562d-b2ab-186cb2c633b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261412}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "26849cfe-6177-5c56-a6fc-8a733f7f0ace" :question/math-academy-id "q-73024" :question/problem "Given that $k\\ge 0$ is an integer, simplify $\\frac{(k+1)!}{k!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(k+1)!=(k+1)\\cdot k!\n$$\n\nThen, we cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+1)!}{k!} & =\\frac{(k+1)\\cdot k!}{k!} \\\\  & =\\frac{(k+1)\\cdot \\cancel{k!}}{\\cancel{k!}} \\\\  & =k+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261428 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54cba1dc-4159-563c-8499-4148232d8332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186261430} {:answer/id #uuid "de83739b-023b-5227-b44f-ca056e1dbdd2" :answer/type {:db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186261431} {:answer/id #uuid "9d922172-545f-554c-ab17-780785872aa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{k+2}" :db/id #edb/ref 17592186261432} {:answer/id #uuid "310e603e-da3b-53ef-90e9-02dcb8cd7d8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{k}^{2}+2k}" :db/id #edb/ref 17592186261433} {:answer/id #uuid "2eff115d-21cd-5dde-aead-c1bd60d4224c" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+k" :db/id #edb/ref 17592186261434}] :answer-field/correct {:answer/id #uuid "54cba1dc-4159-563c-8499-4148232d8332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186261430} :answer-field/id #uuid "76679ae7-e49f-5cfc-8ca8-3a7fd4cd9d1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261429}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8d5d1e46-bcf1-53fa-9a9c-1214b35811c7" :question/math-academy-id "q-73037" :question/problem "Given that $k\\ge -1$ is an integer, $\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+2)!=(k+2)(k+1)!\n$$\n\nThen, we can cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}} & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)!\\cdot (k+2)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)\\cdot (k+1)!\\cdot (k+2)\\cdot (k+1)!} \\\\  & =\\frac{\\cancel{(k+2)}\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+1)!}}{(k+2)\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+2)}\\cdot \\cancel{(k+1)!}} \\\\  & =\\frac{1}{k+2}.\\end{aligned}\n$$"}]}
