#{[{:db/id #edb/ref 17592186256501 :knowledge-point/_questions [{:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4572ec97-bfa4-5060-b8f4-cbf12f7c3e97" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186256503}] :answer-field/correct {:answer/id #uuid "4572ec97-bfa4-5060-b8f4-cbf12f7c3e97" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186256503} :answer-field/id #uuid "a47fbca2-eeb1-52f3-9480-f2d0f75bab35" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256502} {:answer-field/choices [{:answer/id #uuid "ff6aa3ec-8276-54a8-b2c9-eaa021198cd3" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186256505}] :answer-field/correct {:answer/id #uuid "ff6aa3ec-8276-54a8-b2c9-eaa021198cd3" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186256505} :answer-field/id #uuid "ccd71f6f-8015-5fb7-b775-c33622baa306" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256504} {:answer-field/choices [{:answer/id #uuid "4e2c1459-2e82-5849-8376-a3f7512617f0" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186256507}] :answer-field/correct {:answer/id #uuid "4e2c1459-2e82-5849-8376-a3f7512617f0" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186256507} :answer-field/id #uuid "6ceb37b1-8699-5b9c-9eba-dc3db48f29bf" :answer-field/key "r3c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256506}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ca9737e4-6571-57db-8572-7d99e7234d46" :question/math-academy-id "q-100989" :question/problem "If $a=[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]$ and $b=j-3k$, then $a-3b=$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "First, notice that\n\n$$\nb=j-3k=[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}].\n$$\n\nTo compute $a-3b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-3b & =[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]-3\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -5 \\\\ 2\\end{aligned}]-[\\begin{aligned}0 \\\\ 3 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -8 \\\\ 11\\end{aligned}] \\\\  & =⟨-6,-8,11⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256623 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a498624-ebf8-5a8a-ac4a-3a92bf9d2ecf" :knowledge-point/title "Expressing an Infinite Series Using Sigma Notation Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba118855-a6fa-579c-909c-306784f43523" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }(\\frac{8}{5}){(\\frac{3}{4})}^{n}" :db/id #edb/ref 17592186256625}] :answer-field/correct {:answer/id #uuid "ba118855-a6fa-579c-909c-306784f43523" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }(\\frac{8}{5}){(\\frac{3}{4})}^{n}" :db/id #edb/ref 17592186256625} :answer-field/id #uuid "c60e023d-40ef-56d7-b144-373de5481d2b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256624}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "55a081fd-27a0-5f3f-9ea6-07fb5a7d4d01" :question/math-academy-id "q-103257" :question/problem "Consider the sequence starting from ${a}_{1}=\\frac{6}{5}$  with the property $\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{3}{4}$ for all $n\\ge 1.$ Write the sum to infinity of the terms of this sequence using sigma notation.\n\nAnswer: {{answer}}" :question/worked-solution "Notice that the sequence is a geometric sequence since the ratio of any two successive terms is constant.\n\nThe first term of the sequence is ${a}_{1}=\\frac{6}{5},$ and the common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{3}{4}.\n$$\n\nTherefore, the general term ${a}_{n}$ can be expressed as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{(r)}^{n-1} \\\\  & =\\frac{6}{5}{(\\frac{3}{4})}^{n-1} \\\\  & =\\frac{6}{5}{(\\frac{3}{4})}^{-1}{(\\frac{3}{4})}^{n} \\\\  & =\\frac{8}{5}{(\\frac{3}{4})}^{n}.\\end{aligned}\n$$\n\nFinally, the infinite geometric series can be written in sigma notation as\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & ={\\sum }_{n=1}^{\\infty }(\\frac{8}{5}){(\\frac{3}{4})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256705 :knowledge-point/_questions [{:knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd87005a-4579-54cf-b44d-797224c53bdd" :answer/type {:db/ident :answer.type/math} :answer/value "3({x}^{2}+{e}^{1-3x})" :db/id #edb/ref 17592186256707}] :answer-field/correct {:answer/id #uuid "fd87005a-4579-54cf-b44d-797224c53bdd" :answer/type {:db/ident :answer.type/math} :answer/value "3({x}^{2}+{e}^{1-3x})" :db/id #edb/ref 17592186256707} :answer-field/id #uuid "65aabc0e-ccf5-5ae1-8ca8-6753b995425a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256706}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c88af4d4-fee6-50f4-a079-e773fbb850de" :question/math-academy-id "q-107420" :question/problem "Calculate ${f}^{'}(x)$ if $f(x)={x}^{3}-{e}^{1-3x}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we express $y={e}^{1-3x}$ as the composite function\n\n$$\ny={e}^{u},\\,u=1-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{1-3x}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-{e}^{1-3x}) \\\\  & =3{x}^{2}-(-3{e}^{1-3x}) \\\\  & =3({x}^{2}+{e}^{1-3x}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256708 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9213b1-b1fe-58b1-9b88-d91f70eb6ba9" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}\\cdot {2}^{3-{x}^{3}}\\operatorname{ln}2" :db/id #edb/ref 17592186256710}] :answer-field/correct {:answer/id #uuid "5c9213b1-b1fe-58b1-9b88-d91f70eb6ba9" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}\\cdot {2}^{3-{x}^{3}}\\operatorname{ln}2" :db/id #edb/ref 17592186256710} :answer-field/id #uuid "3751607b-b3a6-5d0c-b23c-f55d83a06d76" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256709}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35c8058a-5738-5793-b8ff-a2abf524886b" :question/math-academy-id "q-107458" :question/problem "If $f(x)={2}^{3-{x}^{3}},$ find ${f}^{'}(x).$\n\nAnswer: {{answer}}" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={2}^{u},\\,u=3-{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={2}^{u}\\operatorname{ln}2,\\,\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}2\\cdot (-3{x}^{2}) \\\\  & =-3{x}^{2}\\cdot {2}^{u}\\operatorname{ln}2 \\\\  & =-3{x}^{2}\\cdot {2}^{3-{x}^{3}}\\operatorname{ln}2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256775 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "852cbd16-a914-5ad4-9056-4d9ec5c12889" :answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186256777}] :answer-field/correct {:answer/id #uuid "852cbd16-a914-5ad4-9056-4d9ec5c12889" :answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186256777} :answer-field/id #uuid "39467e20-e20d-5502-9bf8-881bbc694917" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256776} {:answer-field/choices [{:answer/id #uuid "46c65590-ea51-547b-a16f-ef7e7566fc67" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256779}] :answer-field/correct {:answer/id #uuid "46c65590-ea51-547b-a16f-ef7e7566fc67" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256779} :answer-field/id #uuid "a3b98be8-fbca-50cf-a182-625dd393f4fc" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256778}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "99463695-96b3-52fc-80ac-01a64fec0d6b" :question/math-academy-id "q-10878" :question/problem "Find where the normal line to the curve $y={x}^{2}$ at the point $(3,9)$ intersects the $x$-axis.\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(3)=2(3)=6,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-9 & =-\\frac{1}{6}(x-3) \\\\ y & =-\\frac{1}{6}x+\\frac{1}{2}+9 \\\\ y & =-\\frac{1}{6}x+\\frac{19}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{6}x+\\frac{19}{2} & =0 \\\\ \\frac{19}{2} & =\\frac{1}{6}x \\\\ x & =57.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(57,0).$"}] [{:db/id #edb/ref 17592186256815 :knowledge-point/_questions [{:knowledge-point/id #uuid "850edf12-eb3a-56e5-8bcf-02eb10afa457" :knowledge-point/title "Finding the Sum of a Geometric Series Given in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fc8b167-ef15-5146-9667-67a32a66e6bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19\\,531}{9}" :db/id #edb/ref 17592186256817}] :answer-field/correct {:answer/id #uuid "7fc8b167-ef15-5146-9667-67a32a66e6bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19\\,531}{9}" :db/id #edb/ref 17592186256817} :answer-field/id #uuid "0d921919-d38f-5c37-be04-22304885e161" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256816}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3e0062d6-cbd1-58f3-a005-e59a201ee54b" :question/math-academy-id "q-110277" :question/problem "Evaluate the series ${\\sum }_{n=1}^{7}\\frac{1}{9}(5)^{n-1}.$\n\nAnswer: {{answer}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, ${a}_{1}=\\frac{1}{9},$ $r=5$ and $N=7.$ If we substitute these values into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{7}\\frac{1}{9}(5)^{n-1} & =\\frac{1}{9}\\cdot \\frac{(1-{5}^{7})}{1-5} \\\\  & =\\frac{1}{9}\\cdot \\frac{(1-{5}^{7})}{(-4)} \\\\  & =-\\frac{1}{36}\\cdot (-78\\,124) \\\\  & =\\frac{19\\,531}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256950 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/title "Finding the Antiderivative of a Monomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eaec2f0-8f10-5311-b25a-8b563b04ea27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{21}}{21}+C" :db/id #edb/ref 17592186256952}] :answer-field/correct {:answer/id #uuid "3eaec2f0-8f10-5311-b25a-8b563b04ea27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{21}}{21}+C" :db/id #edb/ref 17592186256952} :answer-field/id #uuid "09e4d1c2-b39b-5ff7-9a7b-349f1361e3a1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256951}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e90d408c-709e-5393-a17d-371e43b6c060" :question/math-academy-id "q-113665" :question/problem "Calculate $\\int {x}^{20}\\,\\text{d}x.$\n\nAnswer: {{answer}}" :question/worked-solution "We apply the power rule with $n=20$, and we get\n\n$$\n\\int {x}^{20}\\,\\text{d}x=\\frac{{x}^{20+1}}{20+1}+C=\\frac{{x}^{21}}{21}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{21}\\frac{\\text{d}}{\\text{d}x}({x}^{21})+0 & = \\\\ \\frac{1}{21}\\cdot 21{x}^{20} & = \\\\ {x}^{20}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256956 :knowledge-point/_questions [{:knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2aaa22b-0b94-5d33-bb53-a4566194273b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x^{5/4}}5+C" :db/id #edb/ref 17592186256958}] :answer-field/correct {:answer/id #uuid "c2aaa22b-0b94-5d33-bb53-a4566194273b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x^{5/4}}5+C" :db/id #edb/ref 17592186256958} :answer-field/id #uuid "c5f96349-8a29-5afd-877d-204cd6f3c12e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256957}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5356a9fa-e335-59c8-a9df-2ca4e329df90" :question/math-academy-id "q-113674" :question/problem "Find the antiderivative of ${x}^{1/4}.$\n\nAnswer: {{answer}}" :question/worked-solution "We can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{(\\frac{5}{4})}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 & = \\\\ \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} & = \\\\ {x}^{1/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256962 :knowledge-point/_questions [{:knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f338e2e-b40a-5439-b0c1-97997693af49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^{7/5}}7+C" :db/id #edb/ref 17592186256964}] :answer-field/correct {:answer/id #uuid "7f338e2e-b40a-5439-b0c1-97997693af49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^{7/5}}7+C" :db/id #edb/ref 17592186256964} :answer-field/id #uuid "69df822c-4648-58a5-8477-aefaa6ba44a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256963}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7638fecf-7803-5557-84d8-ceacc22a4c8d" :question/math-academy-id "q-113695" :question/problem "Find the antiderivative of $\\sqrt[5]{{x}^{2}}.$\n\nAnswer: {{answer}}" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{2}}={x}^{2/5}.$ So, we can apply the power rule with $n=\\frac{2}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{2}}\\,\\text{d}x & =\\int {x}^{2/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{2/5+1}}{(\\frac{2}{5}+1)}+C \\\\  & =\\frac{{x}^{7/5}}{(\\frac{7}{5})}+C \\\\  & =\\frac{5{x}^{7/5}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{7/5}}{7}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{7/5}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{5}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/5})+0 & = \\\\ \\frac{5}{7}\\cdot \\frac{7}{5}{x}^{7/5-1} & = \\\\ {x}^{2/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256965 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6464c877-fb70-5f4d-a76d-c49ff97dec49" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{{x}^{1/3}}+C" :db/id #edb/ref 17592186256967}] :answer-field/correct {:answer/id #uuid "6464c877-fb70-5f4d-a76d-c49ff97dec49" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{{x}^{1/3}}+C" :db/id #edb/ref 17592186256967} :answer-field/id #uuid "d3c9f094-adb0-53b0-9aa6-7016a1ce117b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256966}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "955521d3-c252-5d10-a38e-265439ed4f5c" :question/math-academy-id "q-113705" :question/problem "Given that $f(x)=\\frac{1}{{x}^{4/3}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$\n\nAnswer: {{answer}}" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{4/3}}={x}^{-4/3}.$ So, we can use the power rule with $n=-\\frac{4}{3}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-4/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{(-\\frac{1}{3})}+C \\\\  & =-3{x}^{-1/3}+C \\\\  & =-\\frac{3}{{x}^{1/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256968 :knowledge-point/_questions [{:knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2c3266-3d0f-507e-b850-a468ca8259d1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{15{x}^{5}}+C" :db/id #edb/ref 17592186256970}] :answer-field/correct {:answer/id #uuid "0a2c3266-3d0f-507e-b850-a468ca8259d1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{15{x}^{5}}+C" :db/id #edb/ref 17592186256970} :answer-field/id #uuid "690b8984-894a-57f2-9ea0-88435e2b71ef" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256969}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5000ff4a-e3b3-58d1-a0bd-1d7994a6fbf1" :question/math-academy-id "q-113733" :question/problem "Calculate $\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x.$\n\nAnswer: {{answer}}" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x & =\\frac{1}{3}\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-6+1}}{-6+1})+C \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-5}}{-5})+C \\\\  & =-\\frac{1}{15}\\cdot {x}^{-5}+C \\\\  & =-\\frac{1}{15{x}^{5}}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256977 :knowledge-point/_questions [{:knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2a892e5-2d4c-5509-a17f-11fb7a7ff6c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}x+C" :db/id #edb/ref 17592186256979}] :answer-field/correct {:answer/id #uuid "b2a892e5-2d4c-5509-a17f-11fb7a7ff6c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}x+C" :db/id #edb/ref 17592186256979} :answer-field/id #uuid "62e2f70d-6975-5b33-8ace-a4e0d4c31768" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256978}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ccbc8acc-7efb-5aec-8fb6-53294e0c01ed" :question/math-academy-id "q-113739" :question/problem "Calculate $\\int \\sqrt{5}\\,\\text{d}x.$\n\nAnswer: {{answer}}" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\sqrt{5}\\,\\text{d}x & =\\sqrt{5}\\int 1\\,\\text{d}x \\\\  & =\\sqrt{5}\\int {x}^{0}\\,\\text{d}x \\\\  & =\\sqrt{5}\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =\\sqrt{5}\\cdot x+C \\\\  & =\\sqrt{5}x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186257418 :knowledge-point/_questions [{:knowledge-point/id #uuid "97786302-e865-5581-b08e-8da7c6b7a01b" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bf506eb-2b5f-58df-abc0-fd517d134b8a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257420}] :answer-field/correct {:answer/id #uuid "8bf506eb-2b5f-58df-abc0-fd517d134b8a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257420} :answer-field/id #uuid "0f5b13d7-90f7-5557-ad9b-bb080e3046c5" :answer-field/key "a" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257419}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7be751c5-5761-5b27-a477-d52010e0eb74" :question/math-academy-id "q-121065" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cot}(2x)=\\sqrt{3}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx={a}^{∘}+n\\cdot {90}^{∘},\n$$\n\nwhere $n$ is any integer. What could be the value of $a?$\n\n$a =$: {{a}}" :question/worked-solution "The given equation is equivalent to \n\n$$\n\\operatorname{tan}(2x)=\\frac{\\sqrt{3}}{3}.\n$$\n\nSo, the general solution to our equation is\n\n$$\n\\begin{aligned}2x & ={30}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nSolving the above equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =\\frac{{30}^{∘}}{2}+\\frac{n\\cdot {180}^{∘}}{2} \\\\ x & ={15}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$\n\nTherefore, we have that $a=15.$"}] [{:db/id #edb/ref 17592186257436 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f40f50e-49a7-5eda-b642-dc7085569b23" :knowledge-point/title "Solving a Trigonometric Equation Containing the Tangent Function Transformed by One Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cbdbbd9-a40e-523f-a377-485da5ca9a1f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186257438}] :answer-field/correct {:answer/id #uuid "9cbdbbd9-a40e-523f-a377-485da5ca9a1f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186257438} :answer-field/id #uuid "df1d64ac-fbf7-5d22-828c-e26cd89a1be4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257437}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e822166-fc11-5d31-b0db-f193a2f4ca2e" :question/math-academy-id "q-121553" :question/problem "Consider the equation $\\operatorname{tan}2x=1$ for $0\\le x<2\\pi .$ If the exact solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{1}+{x}_{4}?$\n\nAnswer: {{answer}}" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{8}+\\frac{n\\pi }{2} \\\\  & =\\frac{\\pi }{8}+\\frac{4n\\pi }{8} \\\\ x & =\\frac{(1+4n)\\pi }{8}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{8}$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{8}$\n\n- Setting $n=2$ gives $x=\\frac{9\\pi }{8}$\n\n- Setting $n=3$ gives $x=\\frac{13\\pi }{8}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{8},\\frac{5\\pi }{8},\\frac{9\\pi }{8},\\frac{13\\pi }{8}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{4} & =\\frac{\\pi }{8}+\\frac{13\\pi }{8} \\\\  & =\\frac{14\\pi }{8} \\\\  & =\\frac{7\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257449 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f40f50e-49a7-5eda-b642-dc7085569b23" :knowledge-point/title "Solving a Trigonometric Equation Containing the Tangent Function Transformed by One Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "651f2754-926f-5093-8c02-3934d8e51f2a" :answer/type {:db/ident :answer.type/math} :answer/value "560" :db/id #edb/ref 17592186257451}] :answer-field/correct {:answer/id #uuid "651f2754-926f-5093-8c02-3934d8e51f2a" :answer/type {:db/ident :answer.type/math} :answer/value "560" :db/id #edb/ref 17592186257451} :answer-field/id #uuid "b9536be4-f080-5106-b857-a93e80b63cc1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257450}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "18ed24b1-d375-51e8-ad2b-0848def589e7" :question/math-academy-id "q-121912" :question/problem "Consider the equation $\\sqrt{3}\\operatorname{tan}(\\frac{3x}{2})+1=0$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the exact solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ are written in ascending order, what is the numerical value of ${x}_{2}+{x}_{3}?$\n\nAnswer: {{answer}}" :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}\\sqrt{3}\\operatorname{tan}(\\frac{3x}{2})+1 & =0 \\\\ \\sqrt{3}\\operatorname{tan}(\\frac{3x}{2}) & =-1 \\\\ \\operatorname{tan}(\\frac{3x}{2}) & =-\\frac{1}{\\sqrt{3}} \\\\ \\operatorname{tan}(\\frac{3x}{2}) & =-\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}\\frac{3x}{2} & =-{30}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}3x & =-{60}^{∘}+n\\cdot {360}^{∘} \\\\ x & =-\\frac{{60}^{∘}}{3}+\\frac{n\\cdot {360}^{∘}}{3} \\\\ x & =-{20}^{∘}+n\\cdot {120}^{∘}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=1$ gives $x={100}^{∘}$\n\n- Setting $n=2$ gives $x={220}^{∘}$\n\n- Setting $n=3$ gives $x={340}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ (written in ascending order) are\n\n$$\nx={100}^{∘},{220}^{∘},{340}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{2}+{x}_{3}$ is $220+340=560.$"}] [{:db/id #edb/ref 17592186257452 :knowledge-point/_questions [{:knowledge-point/id #uuid "667a2ec8-c35c-52a8-a072-1d00fd8af78c" :knowledge-point/title "Calculating Sums and Scalar Multiplication of More Than Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5e1e700-f53a-5f31-b1e5-83e7775f2629" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257454}] :answer-field/correct {:answer/id #uuid "f5e1e700-f53a-5f31-b1e5-83e7775f2629" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257454} :answer-field/id #uuid "96feac81-6330-5421-8ed4-439f33a296e9" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257453} {:answer-field/choices [{:answer/id #uuid "20ab074f-0118-56c4-9b44-4bafeeac1c74" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186257456}] :answer-field/correct {:answer/id #uuid "20ab074f-0118-56c4-9b44-4bafeeac1c74" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186257456} :answer-field/id #uuid "5eb92b71-ff02-5352-8087-3a7d6c5372bc" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257455} {:answer-field/choices [{:answer/id #uuid "a1a9057e-1899-5295-a74f-26c5f9dd16c0" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186257458}] :answer-field/correct {:answer/id #uuid "a1a9057e-1899-5295-a74f-26c5f9dd16c0" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186257458} :answer-field/id #uuid "77e61a13-55e4-51b6-9867-a32cbbee6a22" :answer-field/key "r3c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257457}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f65102c8-6fda-5ced-885c-0d555e3ecc9f" :question/math-academy-id "q-121937" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]$, $b=[\\begin{aligned}7 \\\\ 5 \\\\ -2\\end{aligned}]$ and $c=[\\begin{aligned}-5 \\\\ 3 \\\\ 8\\end{aligned}].$ Find $a-(b+c).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "To compute $a-(b+c),$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-(b+c) & =[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]-([\\begin{aligned}7 \\\\ 5 \\\\ -2\\end{aligned}]+[\\begin{aligned}-5 \\\\ 3 \\\\ 8\\end{aligned}]) \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]-[\\begin{aligned}2 \\\\ 8 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -7 \\\\ -7\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257577 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c" :knowledge-point/title "Finding a Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c354b3b-46f8-52ed-b64b-3bd9ce8ee2eb" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186257579}] :answer-field/correct {:answer/id #uuid "2c354b3b-46f8-52ed-b64b-3bd9ce8ee2eb" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186257579} :answer-field/id #uuid "1b400207-bef6-55aa-8972-5e014ca89499" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257578}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "66d6f0cd-ec5e-58d6-b37c-1dc9aefebc12" :question/math-academy-id "q-123940" :question/problem "Find the eleventh partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2-2n).$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=2-2n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2-2(1)=0 \\\\ {a}_{2} & =2-2(2)=-2 \\\\ {a}_{3} & =2-2(3)=-4,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=-2$ and first term ${a}_{1}=0.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{11}=2-2(11)=-20,$ we get\n\n$$\n{s}_{11}=\\frac{11}{2}(0-20)=-110.\n$$\n\nSo the eleventh partial sum of ${\\sum }_{n=1}^{\\infty }(2-2n)$ is equal to $-110.$"}] [{:db/id #edb/ref 17592186257589 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ca055ce-2958-54d3-b362-468dfb5f63ea" :knowledge-point/title "Determining Whether a Constant Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b01190d-f335-5a2f-9c2f-a1d6a06a1693" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257591} {:answer/id #uuid "75282ae4-fa28-5274-b61f-5ff217fb2b6f" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186257592}] :answer-field/correct {:answer/id #uuid "7b01190d-f335-5a2f-9c2f-a1d6a06a1693" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257591} :answer-field/id #uuid "97963b45-365e-5cfd-b622-26978b6bae07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257590}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "743b96cc-15a3-5525-bc3d-b9c616d0fdc1" :question/math-academy-id "q-123961" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }(-\\sqrt{3}).$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =-\\sqrt{3} \\\\ {s}_{2} & =-\\sqrt{3}+(-\\sqrt{3})=-2\\sqrt{3} \\\\ {s}_{3} & =-\\sqrt{3}+(-\\sqrt{3})+(-\\sqrt{3})=-3\\sqrt{3} \\\\ {s}_{4} & =-\\sqrt{3}+(-\\sqrt{3})+(-\\sqrt{3})+(-\\sqrt{3})=-4\\sqrt{3}\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum is \n\n$$\n{s}_{n}=-\\sqrt{3}n.\n$$\n\nThe sequence of partial sums is divergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }(-\\sqrt{3}n)=-\\infty \n$$\n\nTherefore, the series ${\\sum }_{n=1}^{\\infty }(-\\sqrt{3})$ is also divergent."}] [{:db/id #edb/ref 17592186257593 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fbf48c3-47f2-594f-90f0-b0cd659b0239" :knowledge-point/title "Determining Whether an Oscillating Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a66ce1c5-7ce5-5c02-afed-46f3d17ce2e7" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257595} {:answer/id #uuid "522c1f8e-78bc-58fa-9df4-84520078285a" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186257596}] :answer-field/correct {:answer/id #uuid "a66ce1c5-7ce5-5c02-afed-46f3d17ce2e7" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257595} :answer-field/id #uuid "fc98c227-8f2c-5b60-8bb3-540c6f306dcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257594}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "07ca5e2d-77a2-57ef-9113-ced1d4775a46" :question/math-academy-id "q-123969" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }\\operatorname{sin}(\\frac{\\pi }{2}+n\\pi ).$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =\\operatorname{sin}(\\frac{3\\pi }{2})=-1 \\\\ {s}_{2} & =-1+\\operatorname{sin}(\\frac{5\\pi }{2})=0 \\\\ {s}_{3} & =0+\\operatorname{sin}(\\frac{7\\pi }{2})=-1 \\\\ {s}_{4} & =-1+\\operatorname{sin}(\\frac{9\\pi }{2})=0\\end{aligned}\n$$\n\nFrom the above, we can see that the sequence of partial sums oscillates between $0$ and $-1$ forever. \n\nSo the limit of the sequence of partial sums does not exist, and therefore the series is divergent."}] [{:db/id #edb/ref 17592186257597 :knowledge-point/_questions [{:knowledge-point/id #uuid "a580ed7b-87a7-5603-ad67-1882a44782b0" :knowledge-point/title "Determining Whether an Infinite Arithmetic Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d67d966-acfc-5538-936e-5bb90e6f6882" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257599} {:answer/id #uuid "a3688785-1084-5422-8f3a-12fc901bf9f4" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186257600}] :answer-field/correct {:answer/id #uuid "8d67d966-acfc-5538-936e-5bb90e6f6882" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257599} :answer-field/id #uuid "b69e70c1-efa4-5882-aa08-8ecc147d051d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257598}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c556c0fb-0999-5d66-8c7d-1dbc40d7dbff" :question/math-academy-id "q-124060" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }\\frac{n}{2}.$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "The given series is an arithmetic series. Its first term is\n\n$$\n{a}_{1}=\\frac{1}{2},\n$$\n\nand its $n$th term is\n\n$$\n{a}_{n}=\\frac{n}{2}.\n$$\n\nUsing the formula for the sum of an arithmetic series, we get the following formula for the $n$th partial sum:\n\n$$\n\\begin{aligned}{s}_{n} & =\\frac{n}{2}({a}_{1}+{a}_{n}) \\\\  & =\\frac{n}{2}(\\frac{1}{2}+\\frac{n}{2}) \\\\  & =\\frac{n(1+n)}{4}\\end{aligned}\n$$\n\nTaking the limit of the partial sums, we get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{s}_{n} & ={lim}_{n\\to \\infty }\\frac{n(1+n)}{4} \\\\  & =\\frac{1}{4}{lim}_{n\\to \\infty }{n}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, since the limit of the sequence of partial sums is infinite, the series is divergent."}] [{:db/id #edb/ref 17592186257601 :knowledge-point/_questions [{:knowledge-point/id #uuid "a580ed7b-87a7-5603-ad67-1882a44782b0" :knowledge-point/title "Determining Whether an Infinite Arithmetic Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db8ae490-21a6-564a-8c12-32e6bd7fc5f5" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257603} {:answer/id #uuid "16877732-d7c6-5ba5-a177-69fec44dad3f" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186257604}] :answer-field/correct {:answer/id #uuid "db8ae490-21a6-564a-8c12-32e6bd7fc5f5" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186257603} :answer-field/id #uuid "5291b67e-7185-5f08-96fc-2f36ec0b9d6d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257602}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "afd7d27e-c371-5649-a501-b00a45a6a8b4" :question/math-academy-id "q-124062" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }(n+3).$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "The given series is an arithmetic series. Its first term is\n\n$$\n{a}_{1}=1+3=4,\n$$\n\nIts $n$th term is\n\n$$\n{a}_{n}=n+3.\n$$\n\nUsing the formula for the sum of an arithmetic series, we get the following formula for the $n$th partial sum:\n\n$$\n\\begin{aligned}{s}_{n} & =\\frac{n}{2}({a}_{1}+{a}_{n}) \\\\  & =\\frac{n}{2}(4+n+3) \\\\  & =\\frac{n(7+n)}{2}\\end{aligned}\n$$\n\nTaking the limit of the partial sums, we get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{s}_{n} & ={lim}_{n\\to \\infty }\\frac{n(7+n)}{2} \\\\  & =\\frac{1}{2}{lim}_{n\\to \\infty }{n}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, since the limit of the sequence of partial sums is infinite, the series is divergent."}] [{:db/id #edb/ref 17592186257696 :knowledge-point/_questions [{:knowledge-point/id #uuid "5191b207-da9d-5408-8efd-3c616ffd3211" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f52124e0-1658-58b3-b02d-b5db6a8e4113" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257698}] :answer-field/correct {:answer/id #uuid "f52124e0-1658-58b3-b02d-b5db6a8e4113" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257698} :answer-field/id #uuid "89695a32-33de-5291-a31b-c425b3e0c9b3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257697}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fe72df8e-159f-5c71-9114-1755109effd4" :question/math-academy-id "q-124580" :question/problem "${\\sum }_{n=1}^{\\infty }45(0.1)^{n}=$\n\nAnswer: {{answer}}" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=45(0.1)^{1}=4.5.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{45(0.1)^{2}}{45(0.1)^{1}}=0.1.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }45(0.1)^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{4.5}{(1-0.1)} \\\\  & =\\frac{4.5}{0.9} \\\\  & =\\frac{45}{9} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257702 :knowledge-point/_questions [{:knowledge-point/id #uuid "5191b207-da9d-5408-8efd-3c616ffd3211" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8947bc3a-7ecb-51af-ac74-5b49f9403f42" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257704}] :answer-field/correct {:answer/id #uuid "8947bc3a-7ecb-51af-ac74-5b49f9403f42" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257704} :answer-field/id #uuid "bf43fe7a-26b2-5fc0-8910-6663e9a0868c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e0bc989-6c13-538f-9204-1071f5bfda3f" :question/math-academy-id "q-124585" :question/problem "${\\sum }_{n=1}^{\\infty }15{(\\frac{2}{5})}^{n}=$\n\nAnswer: {{answer}}" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=15{(\\frac{2}{5})}^{1}=6.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15{(\\frac{2}{5})}^{2}}{15{(\\frac{2}{5})}^{1}}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }5{(\\frac{2}{5})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6}{(1-\\frac{2}{5})} \\\\  & =\\frac{6}{(\\frac{3}{5})} \\\\  & =6\\cdot \\frac{5}{3} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257708 :knowledge-point/_questions [{:knowledge-point/id #uuid "b98c8710-49f8-550f-aad3-7b78220bd08f" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd9bc9cd-64be-5155-9556-0bcc2ac93274" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186257710}] :answer-field/correct {:answer/id #uuid "fd9bc9cd-64be-5155-9556-0bcc2ac93274" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186257710} :answer-field/id #uuid "02f66923-1333-5f92-8020-0f438e3502a0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257709}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "51438042-d192-59cd-9eae-aac65ca4ba26" :question/math-academy-id "q-124587" :question/problem "Evaluate the series ${\\sum }_{n=2}^{\\infty }75{(\\frac{2}{5})}^{n}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =75{(\\frac{2}{5})}^{2}=12 \\\\ {a}_{3} & =75{(\\frac{2}{5})}^{3}=\\frac{24}{5}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{24}{5})}{12}=\\frac{2}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }75{(\\frac{2}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{12}{(1-\\frac{2}{5})} \\\\  & =\\frac{12}{(\\frac{3}{5})} \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258057 :knowledge-point/_questions [{:knowledge-point/id #uuid "55b978ec-9ec6-5349-a103-0c11d9a904c1" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d59d8b0-4b56-5725-be31-52c36a0cb78c" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186258059}] :answer-field/correct {:answer/id #uuid "5d59d8b0-4b56-5725-be31-52c36a0cb78c" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186258059} :answer-field/id #uuid "5eb399e4-3dec-5639-9a17-a37effe5f77c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258058}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "97aba825-3afc-5081-87e1-01c8ec528803" :question/math-academy-id "q-14060" :question/problem "Calculate the sum to infinity of the geometric series $40+20+10+5+⋯$\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=40$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{20}{40}=\\frac{1}{2}.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{40}{(1-\\frac{1}{2})} \\\\  & =\\frac{40}{(\\frac{1}{2})} \\\\  & =80.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258067 :knowledge-point/_questions [{:knowledge-point/id #uuid "530b0b21-6349-5ce4-acd2-d20f4c6d7b3e" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Non-Standard Form Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a19c25-9a8a-5f7c-8819-b75bf130ed1a" :answer/type {:db/ident :answer.type/math} :answer/value "-0.05" :db/id #edb/ref 17592186258069}] :answer-field/correct {:answer/id #uuid "00a19c25-9a8a-5f7c-8819-b75bf130ed1a" :answer/type {:db/ident :answer.type/math} :answer/value "-0.05" :db/id #edb/ref 17592186258069} :answer-field/id #uuid "2c94b1fa-56ab-5b4b-9e3b-4d7264d2e3ba" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258068}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "308c69f7-025f-5fb5-b821-d31e639575ed" :question/math-academy-id "q-14088" :question/problem "Determine the value of the geometric series ${\\sum }_{n=1}^{\\infty }6{(-0.2)}^{3n}$  rounded to $2$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is \n\n$$\n{a}_{1}=6(-0.2)^{3(1)}=6(-0.2)^{3}\n$$\n\n \n\nand the second term is \n\n$$\n{a}_{2}=6(-0.2)^{3(2)}=6(-0.2)^{6}.\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{6(-0.2)^{6}}{6(-0.2)^{3}}=(-0.2)^{3}=-0.008.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }6{(-0.2)}^{3n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6(-0.2)^{3}}{1-(-0.008)} \\\\  & =\\frac{6(-0.008)}{1.008} \\\\  & \\approx -0.05.\\end{aligned}\n$$\n\nNote that the final answer has been rounded to two decimal places."}] [{:db/id #edb/ref 17592186258164 :knowledge-point/_questions [{:knowledge-point/id #uuid "169f59f9-ee45-5375-a22d-4906b7a09ad0" :knowledge-point/title "Identifying Monotonic Sequences Containing Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a14d661-c47c-528c-ad49-f3111573954f" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258166} {:answer/id #uuid "fef1c9c1-1d1b-5361-8e97-6f610efc8c53" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258167} {:answer/id #uuid "1997d23c-8dc6-513e-9f79-d1e8a5b147d2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258168} {:answer/id #uuid "fa692625-fe97-50db-8394-916e1a62167d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258169} {:answer/id #uuid "b670e50d-9d06-52f7-885f-7b6145c0fa0c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258170} {:answer/id #uuid "3275672b-7eac-59f2-ae9c-df07c077799a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258171} {:answer/id #uuid "e6e1a970-75b2-517d-92c0-66364a778fe7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258172} {:answer/id #uuid "1c429934-d74c-5e2b-871b-b0adb3d332c5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258173}] :answer-field/correct {:answer/id #uuid "3275672b-7eac-59f2-ae9c-df07c077799a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258171} :answer-field/id #uuid "8dfdb71c-4f55-5217-b06e-b6a0b696eb0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258165}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "866beddf-cf9f-5dad-a386-56b1a393c58f" :question/math-academy-id "q-143182" :question/problem "Given that  ${a}_{n}=\\frac{(2n)!}{{5}^{n}}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n>2$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=\\frac{(2n)!}{{5}^{n}}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is false. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}\\frac{{a}_{n+1}}{{a}_{n}} & =\\frac{(\\frac{(2n+2)!}{{5}^{n+1}})}{(\\frac{(2n)!}{{5}^{n}})} \\\\  & =\\frac{{5}^{n}(2n+2)!}{{5}^{n+1}(2n)!} \\\\  & =\\frac{{5}^{n}\\cdot (2n+2)\\cdot (2n+1)\\cdot (2n)!}{{5}^{n}\\cdot 5\\cdot (2n)!} \\\\  & =\\frac{\\cancel{{5}^{n}}\\cdot (2n+2)\\cdot (2n+1)\\cdot \\cancel{(2n)!}}{\\cancel{{5}^{n}}\\cdot 5\\cdot \\cancel{(2n)!}} \\\\  & =\\frac{(2n+2)(2n+1)}{5} \\\\  & \\ge 1.\\end{aligned}\n$$\n\n- Statement II is true, whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186258234 :knowledge-point/_questions [{:knowledge-point/id #uuid "11d7e9b2-b321-5c29-992a-775750c570f0" :knowledge-point/title "Identifying Monotonic Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfa90fc8-38ca-55e3-9159-9619bdf6064d" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258236} {:answer/id #uuid "4efc1fe9-fb59-58eb-897b-132f8a3da32e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258237} {:answer/id #uuid "9cc0aa76-d859-5cfb-9595-aa80a06d48da" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258238} {:answer/id #uuid "acfaca99-cf56-5b14-b665-be234d6a14a4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258239} {:answer/id #uuid "d8cb2cae-6d51-59af-afcb-9fafc4cf378c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258240} {:answer/id #uuid "213f582c-b148-5447-906f-0b6eea404e1a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258241} {:answer/id #uuid "797972a0-5742-51d6-807c-998d79af4510" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258242} {:answer/id #uuid "8169b930-ea3a-5678-a86f-b3ce0eab37d2" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258243}] :answer-field/correct {:answer/id #uuid "8169b930-ea3a-5678-a86f-b3ce0eab37d2" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258243} :answer-field/id #uuid "1ae90bc1-de1b-51a3-8429-9ecc0f0b267b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258235}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "59532c68-165f-5d14-a2f1-4b6da63b73ec" :question/math-academy-id "q-143210" :question/problem "Given that  ${a}_{n}={e}^{n+1}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\le 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}={e}^{n+1}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is false. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{{e}^{n+2}}{{e}^{n+1}} \\\\  & ={e}^{n+2-(n+1)} \\\\  & ={e}^{n+2-n-1} \\\\  & ={e}^{1} \\\\  & =e \\\\  & \\ge 1.\\end{aligned}\n$$\n\n- Statement II is true, whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186258254 :knowledge-point/_questions [{:knowledge-point/id #uuid "169f59f9-ee45-5375-a22d-4906b7a09ad0" :knowledge-point/title "Identifying Monotonic Sequences Containing Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f035b59d-56fd-5dba-988d-37888866bd02" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258256} {:answer/id #uuid "d324918d-7802-5d47-bc42-7d49df0d1749" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258257} {:answer/id #uuid "e34f9685-cbe2-5a01-bd9c-ec1bc7e40922" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258258} {:answer/id #uuid "b56ebf76-8647-51e6-95b2-59f00006cdca" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258259} {:answer/id #uuid "3fc09b37-8d4c-5c4d-96f3-ec6ce3b4792f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258260} {:answer/id #uuid "af428e20-063b-5c7f-ba86-906dc61623c2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258261} {:answer/id #uuid "e95f08fb-a9ec-57d2-bb2b-f7ad16631d3d" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258262} {:answer/id #uuid "67d461b9-3042-50fe-a726-f8d308d60630" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258263}] :answer-field/correct {:answer/id #uuid "e34f9685-cbe2-5a01-bd9c-ec1bc7e40922" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258258} :answer-field/id #uuid "1d02046d-dcc0-55e3-b215-0b49df87464b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258255}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1b6783c3-ebe0-5273-9cb2-dc0ed4031e6e" :question/math-academy-id "q-143215" :question/problem "Given that  ${a}_{n}=\\frac{{4}^{n}}{(n!)^{2}}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\le 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=\\frac{{4}^{n}}{(n!)^{2}}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is true. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}\\frac{{a}_{n+1}}{{a}_{n}} & =\\frac{(\\frac{{4}^{n+1}}{((n+1)!)^{2}})}{(\\frac{{4}^{n}}{(n!)^{2}})} \\\\  & =\\frac{{4}^{n+1}(n!)^{2}}{{4}^{n}((n+1)!)^{2}} \\\\  & =\\frac{{4}^{n+1}(n!)^{2}}{{4}^{n}((n+1)n!)^{2}} \\\\  & =\\frac{{4}^{n}\\cdot 4\\cdot (n!)^{2}}{{4}^{n}\\cdot (n+1)^{2}\\cdot (n!)^{2}} \\\\  & =\\frac{\\cancel{{4}^{n}}\\cdot 4\\cdot \\cancel{(n!)^{2}}}{\\cancel{{4}^{n}}\\cdot (n+1)^{2}\\cdot \\cancel{(n!)^{2}}} \\\\  & =\\frac{4}{(n+1)^{2}} \\\\  & \\le 1.\\end{aligned}\n$$\n\n- Statement II is false, whereas statement III is true. Since $0<L\\le 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is decreasing.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186258264 :knowledge-point/_questions [{:knowledge-point/id #uuid "11d7e9b2-b321-5c29-992a-775750c570f0" :knowledge-point/title "Identifying Monotonic Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39e0ba58-7aaf-5b8e-8c5a-d2500c58bc54" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258266} {:answer/id #uuid "5165feff-7401-53b8-80a0-65318f5ffe09" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258267} {:answer/id #uuid "4ec01e9d-e1b1-5873-a02c-c01826ec3679" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258268} {:answer/id #uuid "968b1c70-b015-5c48-b573-1869a2dd4975" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258269} {:answer/id #uuid "773829ba-691c-5578-99ea-15e910cb4322" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258270} {:answer/id #uuid "07217c3b-a2dd-576c-9462-4d8745c86aac" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258271} {:answer/id #uuid "90697352-34c8-5f6e-9bc4-731f9cd53c2c" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258272} {:answer/id #uuid "9d852a96-7a30-5d23-8d03-f302826e638f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258273}] :answer-field/correct {:answer/id #uuid "773829ba-691c-5578-99ea-15e910cb4322" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258270} :answer-field/id #uuid "7f57ff79-8f14-56a6-af82-5d31973cc519" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258265}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d31628ba-8af1-53fa-8f64-d96203185f05" :question/math-academy-id "q-143217" :question/problem "Given that  ${a}_{n}={(\\frac{4}{5})}^{n+1}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}={(\\frac{4}{5})}^{n+1}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is false. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{{(\\frac{4}{5})}^{n+2}}{{(\\frac{4}{5})}^{n+1}} \\\\  & ={(\\frac{4}{5})}^{n+2-n-1} \\\\  & ={(\\frac{4}{5})}^{1} \\\\  & =\\frac{4}{5} \\\\  & \\le 1.\\end{aligned}\n$$\n\n- Statement II is false, whereas statement III is true. Since $0<L\\le 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is decreasing.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186258274 :knowledge-point/_questions [{:knowledge-point/id #uuid "11d7e9b2-b321-5c29-992a-775750c570f0" :knowledge-point/title "Identifying Monotonic Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1da15512-9141-5658-adc0-2d796eabc0be" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258276} {:answer/id #uuid "23ce18da-bf69-52ea-aee1-4c548b5d7805" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258277} {:answer/id #uuid "76758739-ba80-5f82-b136-044fff3dbf5b" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258278} {:answer/id #uuid "816d8401-ff89-562c-ae81-7b16d2a5bfcf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258279} {:answer/id #uuid "323b0993-1575-5b72-888c-f46d1ee98748" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258280} {:answer/id #uuid "1e01d71b-4a97-5dd2-989a-7f7537d1b14c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258281} {:answer/id #uuid "2b4c4a50-ca75-5aaf-8889-0aa4c0f2819e" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258282} {:answer/id #uuid "d2a2de85-3c1d-53ef-b1a4-3dca83582c5d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258283}] :answer-field/correct {:answer/id #uuid "1e01d71b-4a97-5dd2-989a-7f7537d1b14c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258281} :answer-field/id #uuid "64a9483f-15e7-582a-8f50-d98770d357aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258275}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "27707620-ae31-5355-beb9-34dcaa2b3212" :question/math-academy-id "q-143220" :question/problem "Given that  ${a}_{n}={(\\frac{7}{6})}^{n}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\ge 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}={(\\frac{7}{6})}^{n}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is true. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{{(\\frac{7}{6})}^{n+1}}{{(\\frac{7}{6})}^{n}} \\\\  & ={(\\frac{7}{6})}^{n+1-n} \\\\  & ={(\\frac{7}{6})}^{1} \\\\  & =\\frac{7}{6} \\\\  & \\ge 1.\\end{aligned}\n$$\n\n- Statement II is true, whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186258412 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d98bcee-d473-53b1-a6ef-1943d68702c3" :knowledge-point/title "Scalar Multiplication of a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d14ffde9-6472-5c5c-908f-3d98789b82d1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258414}] :answer-field/correct {:answer/id #uuid "d14ffde9-6472-5c5c-908f-3d98789b82d1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258414} :answer-field/id #uuid "0aaf5648-6c39-5954-ba61-f78b65318168" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258413}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6028f7b5-360d-5374-9eaf-4f3a559f7277" :question/math-academy-id "q-156162" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, determine all real values of $K$ for which ${\\sum }_{n=1}^{\\infty }(K-3)\\cdot {a}_{n}$ is **convergent.**\n\nAnswer: {{answer}}" :question/worked-solution "If we multiply the terms of a divergent series by a non-zero constant, the resulting series is divergent.\n\nHowever, multiplying the terms of a divergent series by $0$ gives a series that converges to $0.$\n\nTherefore, the series \n\n$$\n{\\sum }_{n=1}^{\\infty }(K-3)\\cdot {a}_{n}\n$$\n\nis convergent when \n\n$$\nK-3=0\\,\\Rightarrow \\,K=3.\n$$"}] [{:db/id #edb/ref 17592186258560 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8166bb-3a9d-5808-af53-a18ca99920f8" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40ec5b3b-658e-58ce-a37f-7b92341f3447" :answer/type {:db/ident :answer.type/math} :answer/value "-{15}^{∘}" :db/id #edb/ref 17592186258562}] :answer-field/correct {:answer/id #uuid "40ec5b3b-658e-58ce-a37f-7b92341f3447" :answer/type {:db/ident :answer.type/math} :answer/value "-{15}^{∘}" :db/id #edb/ref 17592186258562} :answer-field/id #uuid "c4bdaa2a-68be-5aaa-85d0-dd4f3b18f5a8" :answer-field/key "b" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258561}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "14f70208-8f58-51a9-8ebd-e8fa8a3ef6f6" :question/math-academy-id "q-16253" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{sin}(4x-{60}^{∘})=-\\frac{\\sqrt{3}}{2}\n$$\n\n \n\nThe general solution of this equation can be expressed as\n\n$$\nx={90}^{∘}n,\\,x=b+{90}^{∘}n,\n$$\n\nwhere $n$ is any integer. What could be the value of $b?$\n\n$b =$: {{b}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}4x-{60}^{∘} & =-{60}^{∘}+{360}^{∘}n, & \\, & \\, & 4x-{60}^{∘} & =-{120}^{∘}+{360}^{∘}n.\\end{aligned}\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}4x & ={60}^{∘}-{60}^{∘}+{360}^{∘}n & \\, & \\, & 4x & ={60}^{∘}-{120}^{∘}+{360}^{∘}n \\\\ 4x & ={360}^{∘}n & \\, & \\, & 4x & =-{60}^{∘}+{360}^{∘}n \\\\ x & ={90}^{∘}n & \\, & \\, & x & =-{15}^{∘}+{90}^{∘}n\\end{aligned}\n$$\n\nTherefore, we have that $b=-{15}^{∘}.$"}] [{:db/id #edb/ref 17592186258571 :knowledge-point/_questions [{:knowledge-point/id #uuid "a180dc90-c6b9-577e-9eef-ed60ecafe4e5" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcd9ab5e-9ca8-5494-88f9-a90a5a2fef22" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{24}" :db/id #edb/ref 17592186258573}] :answer-field/correct {:answer/id #uuid "bcd9ab5e-9ca8-5494-88f9-a90a5a2fef22" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{24}" :db/id #edb/ref 17592186258573} :answer-field/id #uuid "dcb349ee-5aff-5464-b3b9-949ef5685eb8" :answer-field/key "a" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258572}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "83f30889-f878-583f-b150-a995dc476f5d" :question/math-academy-id "q-16355" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cos}(2x+\\frac{3\\pi }{4})=\\frac{1}{2}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +\\pi n,\\,x=\\frac{11\\pi }{24}+\\pi n,\n$$\n\nwhere $n$ is any integer. What could be the value of $a?$\n\n$a =$: {{a}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{3\\pi }{4} & =\\frac{\\pi }{3}+2\\pi n, & \\, & \\, & 2x+\\frac{3\\pi }{4}=\\frac{5\\pi }{3}+2\\pi n.\\end{aligned}\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{12}+2\\pi n & \\, & \\, & 2x & =\\frac{11\\pi }{12}+2\\pi n \\\\ x & =-\\frac{5\\pi }{24}+\\pi n & \\, & \\, & x & =\\frac{11\\pi }{24}+\\pi n\\end{aligned}\n$$\n\nTherefore, $a=-\\frac{5}{24}.$"}] [{:db/id #edb/ref 17592186258574 :knowledge-point/_questions [{:knowledge-point/id #uuid "97786302-e865-5581-b08e-8da7c6b7a01b" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53134b9c-2ec9-5e5a-adbc-78b1a7ed6b45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186258576}] :answer-field/correct {:answer/id #uuid "53134b9c-2ec9-5e5a-adbc-78b1a7ed6b45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186258576} :answer-field/id #uuid "da0790fc-3f61-57e0-ae49-9f30ce6de3f8" :answer-field/key "a" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258575}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6404a99e-7757-52ba-89dd-f5be5b3def0b" :question/math-academy-id "q-16364" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{tan}(4x-\\frac{\\pi }{4})=1\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +\\frac{n\\pi }{4},\n$$\n\n \nwhere $n$ is any integer. What could be the value of $a?$\n\n$a =$: {{a}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}4x-\\frac{\\pi }{4} & =\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nSolving the above equation for $x,$ we get\n\n$$\n\\begin{aligned}4x & =\\frac{\\pi }{4}+\\frac{\\pi }{4}+n\\pi  \\\\ 4x & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{8}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, we have that $a=\\frac{1}{8}.$"}] [{:db/id #edb/ref 17592186258762 :knowledge-point/_questions [{:knowledge-point/id #uuid "14223e47-647d-5b4d-a877-694192638d49" :knowledge-point/title "Expressing a Position Vector in Component Form Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d80e21f6-7eeb-5260-8963-0283594391d2" :answer/type {:db/ident :answer.type/math} :answer/value "i+j+2k" :db/id #edb/ref 17592186258764}] :answer-field/correct {:answer/id #uuid "d80e21f6-7eeb-5260-8963-0283594391d2" :answer/type {:db/ident :answer.type/math} :answer/value "i+j+2k" :db/id #edb/ref 17592186258764} :answer-field/id #uuid "9c4ced30-ab72-5ea5-96f1-9a6336188a0b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258763}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b6c80cb4-20a6-5229-893e-cb6d3fa7a36d" :question/math-academy-id "q-18687" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/80749f47491522bb42ccca5bce0176b69ca03fa5ac6c33df37350392936857c3.png)\n\nGiven the picture above, find the position vector of the point $Q(1,1,2)$ in terms of $i$, $j$, and $k.$\n\nAnswer: {{answer}}" :question/worked-solution "Remember that in general, if a point $Q$ has coordinates $({q}_{x},{q}_{y},{q}_{z}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OQ}=q={q}_{x}i+{q}_{y}j+{q}_{z}k.\n$$\n\nHere, the point $Q$ has the coordinates $(1,1,2),$ so its position vector is given by\n\n$$\n\\overset{\\to }{OQ}=q=i+j+2k.\n$$"}] [{:db/id #edb/ref 17592186258771 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f819127-1ab3-5a85-a381-9e30e32884aa" :knowledge-point/title "Calculating Sums and Differences of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f7b78d4-1cc0-5070-b66f-31145be45620" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258773}] :answer-field/correct {:answer/id #uuid "9f7b78d4-1cc0-5070-b66f-31145be45620" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258773} :answer-field/id #uuid "e926ece9-9c6a-5930-b891-d76a9c4b2b6a" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258772} {:answer-field/choices [{:answer/id #uuid "c838a260-aad2-5399-833d-b5dbda46900c" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186258775}] :answer-field/correct {:answer/id #uuid "c838a260-aad2-5399-833d-b5dbda46900c" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186258775} :answer-field/id #uuid "a50714a1-8282-57e5-8d21-2bb9829fc692" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258774} {:answer-field/choices [{:answer/id #uuid "e83ad01d-cddb-50a4-9e42-14abe9456bdf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258777}] :answer-field/correct {:answer/id #uuid "e83ad01d-cddb-50a4-9e42-14abe9456bdf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258777} :answer-field/id #uuid "019580bf-188b-5cfc-bd21-39b4613134ce" :answer-field/key "r3c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "92ba06b2-5956-5b83-8cb1-36fb1d3ffbe6" :question/math-academy-id "q-19049" :question/problem "If $r=⟨0,-2,4⟩$ and $s=i-6j$, then $r+s=$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "First, notice that\n\n$$\ns=i-6j=⟨1,-6,0⟩.\n$$\n\nTo compute the sum, we just add each component individually:\n\n$$\n\\begin{aligned}r+s & =⟨0,-2,4⟩+⟨1,-6,0⟩ \\\\  & =⟨0+1,-2-6,4+0⟩ \\\\  & =⟨1,-8,4⟩ \\\\  & =[\\begin{aligned}1 \\\\ -8 \\\\ 4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258836 :knowledge-point/_questions [{:knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7103af-3b5f-5041-971c-4ee88f87e34e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{10}+C" :db/id #edb/ref 17592186258838}] :answer-field/correct {:answer/id #uuid "0c7103af-3b5f-5041-971c-4ee88f87e34e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{10}+C" :db/id #edb/ref 17592186258838} :answer-field/id #uuid "7dfedbf2-c835-5df4-be1a-365d0d36a169" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258837}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "739af692-e2e6-5444-a61f-f0c4fca9a9b7" :question/math-academy-id "q-2029" :question/problem "Calculate $\\int \\frac{z}{5}\\,\\text{d}z.$\n\nAnswer: {{answer}}" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{z}{5}\\,\\text{d}z & =\\frac{1}{5}\\int z\\,\\text{d}z \\\\  & =\\frac{1}{5}\\cdot (\\frac{{z}^{1+1}}{1+1})+C \\\\  & =\\frac{1}{5}\\cdot \\frac{{z}^{2}}{2}+C \\\\  & =\\frac{1}{10}\\cdot {z}^{2}+C \\\\  & =\\frac{{z}^{2}}{10}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259115 :knowledge-point/_questions [{:knowledge-point/id #uuid "044ed681-b1e8-594c-9b0a-520c0c5b475a" :knowledge-point/title "Finding the Sum of a Simplified Geometric Series Given in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8623d5cd-6d19-5157-992a-6920f8c4437c" :answer/type {:db/ident :answer.type/math} :answer/value "58590" :db/id #edb/ref 17592186259117}] :answer-field/correct {:answer/id #uuid "8623d5cd-6d19-5157-992a-6920f8c4437c" :answer/type {:db/ident :answer.type/math} :answer/value "58590" :db/id #edb/ref 17592186259117} :answer-field/id #uuid "ee7c095c-d9a2-513d-ac1a-600d9e4f8744" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259116}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6b6c9e68-e0bd-5e83-8cdf-bece74c3ee55" :question/math-academy-id "q-269890" :question/problem "Evaluate the following geometric series:\n\n${\\sum }_{n=1}^{6}3(5)^{n}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=5$ and $N=6.$ We need to figure out the value of ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=3(5)^{n},\n$$\n\nand therefore, we can calculate the first term ${a}_{1}$ as follows:\n\n$$\n\\begin{aligned}{a}_{1} & =3(5)^{1} \\\\  & =15\\end{aligned}\n$$\n\nIf we substitute ${a}_{1}=15,r=5$ and $N=6$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{6}3(5)^{n} & =15\\cdot \\frac{(1-{5}^{6})}{1-5} \\\\  & =15\\cdot \\frac{(-15\\,624)}{(-4)} \\\\  & =15(3906) \\\\  & =58\\,590\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259142 :knowledge-point/_questions [{:knowledge-point/id #uuid "9eb12a99-5169-52f7-8830-5de0d2d854f6" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Tangent Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39ce36e4-3f98-50d8-979e-ad7293d7deab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186259144}] :answer-field/correct {:answer/id #uuid "39ce36e4-3f98-50d8-979e-ad7293d7deab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186259144} :answer-field/id #uuid "6d1afe7a-f478-51ad-9eee-e49a15410344" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259143} {:answer-field/choices [{:answer/id #uuid "dbdcfdf0-209c-515a-8c89-174ca629a83c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259146}] :answer-field/correct {:answer/id #uuid "dbdcfdf0-209c-515a-8c89-174ca629a83c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259146} :answer-field/id #uuid "010a4434-3ae7-57ec-bd63-a696d00fe8f5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259145}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "caf90fcb-e8ed-5b84-8ede-f89b43555306" :question/math-academy-id "q-274705" :question/problem "Expressed in **ascending order** in radians, the **exact solutions** to the equation  $\\operatorname{tan}(x-\\frac{\\pi }{6})=-\\frac{\\sqrt{3}}{3},$ for $-\\pi \\le x<\\pi ,$  are\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{6} & =-\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{6}-\\frac{\\pi }{6}+n\\pi  \\\\ x & =n\\pi .\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi \\le x<\\pi .$\n\n- Setting $n=0$ gives $x=0$\n\n- Setting $n=-1$ gives $x=-\\pi $\n\nAll other values of $n$ generate solutions outside the domain $-\\pi \\le x<\\pi .$ \n\nSo, in ascending order,  the solutions are \n\n$$\n{x}_{1}=-\\pi ,\\,{x}_{2}=0.\n$$"}] [{:db/id #edb/ref 17592186259147 :knowledge-point/_questions [{:knowledge-point/id #uuid "9eb12a99-5169-52f7-8830-5de0d2d854f6" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Tangent Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b71290-7e7c-5c68-9cc7-10f0d22fc82b" :answer/type {:db/ident :answer.type/math} :answer/value "-150" :db/id #edb/ref 17592186259149}] :answer-field/correct {:answer/id #uuid "05b71290-7e7c-5c68-9cc7-10f0d22fc82b" :answer/type {:db/ident :answer.type/math} :answer/value "-150" :db/id #edb/ref 17592186259149} :answer-field/id #uuid "4bb31c8a-3267-5b07-9e99-2ac26ce7c640" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259148} {:answer-field/choices [{:answer/id #uuid "64951150-f61b-5d0c-a61d-34e60a478028" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186259151}] :answer-field/correct {:answer/id #uuid "64951150-f61b-5d0c-a61d-34e60a478028" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186259151} :answer-field/id #uuid "a07176f6-1dc2-5cfa-8111-55c57611ed93" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259150}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "28b54476-13f4-5be8-9db7-b73daab42ebb" :question/math-academy-id "q-274706" :question/problem "Expressed in **ascending order** in degrees, the **exact solutions** to the equation $\\operatorname{tan}(2x-{90}^{∘})=-\\frac{\\sqrt{3}}{3},$ for $-{180}^{∘}\\le x<0,$  are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x-{90}^{∘} & =-{30}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}2x & ={90}^{∘}-{30}^{∘}+n\\cdot {180}^{∘} \\\\ 2x & ={60}^{∘}+n\\cdot {180}^{∘} \\\\ x & ={30}^{∘}+n\\cdot {90}^{∘}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-{180}^{∘}\\le x<0.$\n\n- Setting $n=-1$ gives $x=-{60}^{∘}$\n\n- Setting $n=-2$ gives $x=-{150}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain $-{180}^{∘}\\le x<0.$ \n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}={-150}^{∘},\\,{x}_{2}={-60}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186259263 :knowledge-point/_questions [{:knowledge-point/id #uuid "850edf12-eb3a-56e5-8bcf-02eb10afa457" :knowledge-point/title "Finding the Sum of a Geometric Series Given in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ebfb2c-99c6-5637-b42c-761be5242059" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{781}{64}" :db/id #edb/ref 17592186259265}] :answer-field/correct {:answer/id #uuid "85ebfb2c-99c6-5637-b42c-761be5242059" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{781}{64}" :db/id #edb/ref 17592186259265} :answer-field/id #uuid "e8086ada-f6fe-58cb-9114-cce7f17fbdd9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259264}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "03feef15-6821-50d8-957a-59df60c1ee42" :question/math-academy-id "q-280142" :question/problem "Evaluate the **exact value** of the following series:\n\n${\\sum }_{n=1}^{5}4{(\\frac{3}{4})}^{n-1}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, ${a}_{1}=4,$ $r=\\frac{3}{4}$ and $N=5.$ If we substitute these values into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{5}4{(\\frac{3}{4})}^{n-1} & =4\\cdot \\frac{(1-{(\\frac{3}{4})}^{5})}{1-\\frac{3}{4}} \\\\  & =4\\cdot \\frac{(1-\\frac{243}{1024})}{\\frac{1}{4}} \\\\  & =4\\cdot \\frac{\\frac{781}{1024}}{\\frac{1}{4}} \\\\  & =4\\cdot \\frac{3124}{1024} \\\\  & =\\frac{781}{64}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259266 :knowledge-point/_questions [{:knowledge-point/id #uuid "044ed681-b1e8-594c-9b0a-520c0c5b475a" :knowledge-point/title "Finding the Sum of a Simplified Geometric Series Given in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "791e76a9-3d5f-57c1-b10b-b6d07ab33163" :answer/type {:db/ident :answer.type/math} :answer/value "2046" :db/id #edb/ref 17592186259268}] :answer-field/correct {:answer/id #uuid "791e76a9-3d5f-57c1-b10b-b6d07ab33163" :answer/type {:db/ident :answer.type/math} :answer/value "2046" :db/id #edb/ref 17592186259268} :answer-field/id #uuid "e210c240-5654-5bf6-9793-aef1a6e8b3c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259267}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d76c89d6-e774-5178-8f95-00904170710b" :question/math-academy-id "q-280149" :question/problem "Evaluate the following geometric series:\n\n${\\sum }_{n=1}^{5}\\frac{3}{2}(4)^{n}=$\n{{field-1}}" :question/worked-solution "Since the given series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=4$ and $N=5.$ We need to figure out the value of ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=\\frac{3}{2}(4)^{n},\n$$\n\nand therefore, we can calculate the first term ${a}_{1}$ as follows:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{3}{2}(4)^{1} \\\\  & =6\\end{aligned}\n$$\n\nIf we substitute ${a}_{1}=6,r=4$ and $N=5$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{5}\\frac{3}{2}(4)^{n} & =6\\cdot \\frac{(1-{4}^{5})}{1-4} \\\\  & =6\\cdot \\frac{(-1023)}{(-3)} \\\\  & =6(341) \\\\  & =2046\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259269 :knowledge-point/_questions [{:knowledge-point/id #uuid "16cdb454-0ef5-5ec4-8141-8b1182aab815" :knowledge-point/title "Finding the Sum of a Geometric Series by Determining the Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f46d4583-c3dc-5b07-9d0f-232e78e4619d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1200}{343}" :db/id #edb/ref 17592186259271}] :answer-field/correct {:answer/id #uuid "f46d4583-c3dc-5b07-9d0f-232e78e4619d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1200}{343}" :db/id #edb/ref 17592186259271} :answer-field/id #uuid "ba568ec5-107a-50c2-adc0-af80b846d5b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259270}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "38d95bd5-b1e1-544e-9f92-f7bc640d7469" :question/math-academy-id "q-280244" :question/problem "Evaluate the **exact value** of the following geometric series:\n\n${\\sum }_{n=1}^{4}\\frac{21}{{7}^{n}}=$\n{{field-1}}" :question/worked-solution "Notice that we can rewrite the series as follows:\n\n$$\n{\\sum }_{n=1}^{4}\\frac{21}{{7}^{n}}={\\sum }_{n=1}^{4}21\\cdot {(\\frac{1}{7})}^{n}\n$$\n\nSince the above series is in the form ${\\sum }_{n=1}^{N}a{r}^{n},$ it is a geometric series. \n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series.\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=\\frac{1}{7}$ and $N=4.$ We need to figure out ${a}_{1}.$\n\nThe formula for the $n$th term of the series is\n\n$$\n{a}_{n}=21\\cdot {(\\frac{1}{7})}^{n},\n$$\n\nand therefore the first term of the series is\n\n$$\n{a}_{1}=21\\cdot {(\\frac{1}{7})}^{1}=3.\n$$\n\nIf we substitute ${a}_{1}=3,r=\\frac{1}{7}$ and $N=4$ into the formula for ${S}_{N}$, we obtain the following:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}21\\cdot {(\\frac{1}{7})}^{n} & =3\\cdot \\frac{[1-{(\\frac{1}{7})}^{4}]}{(1-\\frac{1}{7})} \\\\  & =3\\cdot \\frac{(1-\\frac{1}{2401})}{\\frac{6}{7}} \\\\  & =3\\cdot \\frac{7}{6}\\cdot \\frac{2400}{2401} \\\\  & =\\frac{1200}{343}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259272 :knowledge-point/_questions [{:knowledge-point/id #uuid "16cdb454-0ef5-5ec4-8141-8b1182aab815" :knowledge-point/title "Finding the Sum of a Geometric Series by Determining the Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8824b1b-d8cd-591a-ab89-55dc9fbbc2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{259}{4}" :db/id #edb/ref 17592186259274}] :answer-field/correct {:answer/id #uuid "e8824b1b-d8cd-591a-ab89-55dc9fbbc2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{259}{4}" :db/id #edb/ref 17592186259274} :answer-field/id #uuid "b8031aa4-9ef9-5d3c-b2c0-4c90c083fca1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259273}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "503b9785-4d55-5d08-a435-b657b276f67e" :question/math-academy-id "q-280253" :question/problem "Evaluate the **exact value** of the following geometric series:\n\n${\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1}=$\n{{field-1}}" :question/worked-solution "Notice that we can rewrite the series as follows:\n\n$$\n{\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1}\n$$\n\nSince the above series is in the form ${\\sum }_{n=1}^{N}a{r}^{n-1}$, it is a geometric series starting at $n=1$, with the exponent matching the standard form for partial sums.\n\nTo determine the sum, we use the formula for the sum ${S}_{N}$ of a geometric series:\n\n$$\n{S}_{N}={a}_{1}\\frac{(1-{r}^{N})}{1-r}\n$$\n\nIn this case, $r=\\frac{1}{6}$, $N=4$, and the first term ${a}_{1}=54.$\n\nSubstituting into the formula gives:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}54\\cdot {(\\frac{1}{6})}^{n-1} & =54\\cdot \\frac{1-{(\\frac{1}{6})}^{4}}{1-\\frac{1}{6}} \\\\  & =54\\cdot \\frac{1295}{1296}\\cdot \\frac{6}{5} \\\\  & =\\frac{259}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259333 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050fa364-a0e5-5fed-b6f7-b0d51b22baa0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3{x}^{3}}+C" :db/id #edb/ref 17592186259335}] :answer-field/correct {:answer/id #uuid "050fa364-a0e5-5fed-b6f7-b0d51b22baa0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3{x}^{3}}+C" :db/id #edb/ref 17592186259335} :answer-field/id #uuid "a604736b-4a8c-5606-83c8-0e38d57b830b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259334}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "77f6dc16-41fa-5de8-9654-94f8eff9862e" :question/math-academy-id "q-29633" :question/problem "What is the antiderivative of $\\frac{1}{{x}^{4}}?$\n\nAnswer: {{answer}}" :question/worked-solution "Note that $\\frac{1}{{x}^{4}}={x}^{-4}.$ So, we can use the power rule with $n=-4$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x & =\\int {x}^{-4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4+1}}{-4+1}+C \\\\  & =-\\frac{{x}^{-3}}{3}+C \\\\  & =-\\frac{1}{3{x}^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259397 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6faeda4-9cd8-5fc1-a2cd-ee250d4c774f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186259399}] :answer-field/correct {:answer/id #uuid "d6faeda4-9cd8-5fc1-a2cd-ee250d4c774f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186259399} :answer-field/id #uuid "5df9d6fb-6be9-590e-a368-cd71009532f8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259398}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4147d71c-0780-5d7a-b644-4ac51dc7dac4" :question/math-academy-id "q-308798" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y={x}^{2}+3x$ at the point $(-1,-2).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)={x}^{2}+3x.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}+3x)=2x+3\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-2):$\n\n$$\nm={f}^{'}(-1)=2(-1)+3=-2+3=1\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259518 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f819127-1ab3-5a85-a381-9e30e32884aa" :knowledge-point/title "Calculating Sums and Differences of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1403987-3894-5423-9bcc-4b82657f9801" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186259520}] :answer-field/correct {:answer/id #uuid "a1403987-3894-5423-9bcc-4b82657f9801" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186259520} :answer-field/id #uuid "33603e3b-595e-5033-8240-5f2bd5947655" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259519} {:answer-field/choices [{:answer/id #uuid "6b6ab8fc-95fb-5574-ab64-f987a6f978f0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186259522}] :answer-field/correct {:answer/id #uuid "6b6ab8fc-95fb-5574-ab64-f987a6f978f0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186259522} :answer-field/id #uuid "828e8116-4b8a-5fd6-a3eb-8d0be9348da6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259521} {:answer-field/choices [{:answer/id #uuid "253ff50e-1689-55cd-9278-d0a36f0f2a65" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259524}] :answer-field/correct {:answer/id #uuid "253ff50e-1689-55cd-9278-d0a36f0f2a65" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259524} :answer-field/id #uuid "3a341263-1c17-5be0-97fe-3840c5178af0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259523}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "709b00dd-0479-5892-a6bc-f752585376ff" :question/math-academy-id "q-318377" :question/problem "If $c=⟨4,2,6⟩$ and $d=⟨-1,5,5⟩$, then\n\n$c-d=⟨$\n{{field-1}},\n{{field-2}},\n{{field-3}}$⟩.$" :question/worked-solution "To compute the difference, we subtract each component individually:\n\n$$\n\\begin{aligned}c-d & =⟨4,2,6⟩-⟨-1,5,5⟩ \\\\  & =⟨4-(-1),2-5,6-5⟩ \\\\  & =⟨5,-3,1⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259583 :knowledge-point/_questions [{:knowledge-point/id #uuid "14223e47-647d-5b4d-a877-694192638d49" :knowledge-point/title "Expressing a Position Vector in Component Form Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "952a2a84-1781-5ffd-936f-6f30ac5adcd6" :answer/type {:db/ident :answer.type/math} :answer/value "-i-3j+0k" :db/id #edb/ref 17592186259585}] :answer-field/correct {:answer/id #uuid "952a2a84-1781-5ffd-936f-6f30ac5adcd6" :answer/type {:db/ident :answer.type/math} :answer/value "-i-3j+0k" :db/id #edb/ref 17592186259585} :answer-field/id #uuid "6d881c1d-7f91-5c21-b1e1-8aa8814dfea8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259584}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71ec538c-6e4e-5430-adc3-249373639151" :question/math-academy-id "q-322676" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/2f5f1a6c55e05048d5e62920fd49de1f55075905123a05908594b7915cb46b2e.png)\n\nFind the position vector of $U(-1,-3,0)$ in terms of $i$, $j$, and $k.$ Type $i,$ $j,$ and $k$ to represent the vectors $i,$ $j,$ and $k,$ respectively.\n\nThe position vector of $U$ is\n{{field-1}}." :question/worked-solution "Remember that in general, if a point $U$ has coordinates $({u}_{x},{u}_{y},{u}_{z}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OU}=u={u}_{x}i+{u}_{y}j+{u}_{z}k.\n$$\n\nHere, the point $U$ has the coordinates $(-1,-3,0),$ so its position vector is given by\n\n$$\n\\overset{\\to }{OU}=(-1)i+(-3)j+0k=-i-3j.\n$$"}] [{:db/id #edb/ref 17592186259586 :knowledge-point/_questions [{:knowledge-point/id #uuid "ea3855dd-f8c9-5065-ac55-99356bbaa583" :knowledge-point/title "Converting Between Alternative Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be648c48-4047-584a-b794-e75cad2c3eac" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186259588}] :answer-field/correct {:answer/id #uuid "be648c48-4047-584a-b794-e75cad2c3eac" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186259588} :answer-field/id #uuid "2e2b2d3d-dc10-57bb-b4eb-b441ed7bed32" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259587} {:answer-field/choices [{:answer/id #uuid "af0d2bc5-d722-511d-9c0b-71a05c581007" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259590}] :answer-field/correct {:answer/id #uuid "af0d2bc5-d722-511d-9c0b-71a05c581007" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259590} :answer-field/id #uuid "8681383d-8705-5781-b760-7f881834df21" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259589} {:answer-field/choices [{:answer/id #uuid "4b38906a-c5ec-5e2c-aa82-e74377f9d2b7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186259592}] :answer-field/correct {:answer/id #uuid "4b38906a-c5ec-5e2c-aa82-e74377f9d2b7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186259592} :answer-field/id #uuid "f25949b9-4354-5131-a1b6-3792ad7c0e6f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259591}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e95cfe22-0303-57f5-8f01-714df12a8f83" :question/math-academy-id "q-322683" :question/problem "Write the vector $b=-7i+2j+5k$ in angle bracket notation.\n\n$b=⟨$\n{{field-1}},\n{{field-2}},\n{{field-3}}$⟩$" :question/worked-solution "Remember that in general, if a point $B$ has coordinates $({b}_{x},{b}_{y},{b}_{z}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OB}=b=⟨{b}_{x},{b}_{y},{b}_{z}⟩=[\\begin{aligned}{b}_{x} \\\\ {b}_{y} \\\\ {b}_{z}\\end{aligned}]={b}_{x}\\,i+{b}_{y}\\,j+{b}_{z}\\,k.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}b & =-7i+2j+5k \\\\  & =-7\\cdot i+2\\cdot j+5\\cdot k \\\\  & =⟨-7,2,5⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259656 :knowledge-point/_questions [{:knowledge-point/id #uuid "a180dc90-c6b9-577e-9eef-ed60ecafe4e5" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8481b97c-79bd-5680-a936-855eee350617" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186259658}] :answer-field/correct {:answer/id #uuid "8481b97c-79bd-5680-a936-855eee350617" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186259658} :answer-field/id #uuid "5c059408-4e1e-56d3-9bee-5e0446a61f1a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259657}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "47d2cbf1-1164-5cb5-ab6c-facf3e8732c7" :question/math-academy-id "q-328242" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cos}(6x+\\frac{\\pi }{3})=-1\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +\\frac{\\pi }{3}\\cdot n,\n$$\n\nwhere $n$ is any integer. Find a possible value of $a$ in the range $[0,\\frac{1}{3}).$\n\n$a=$\n{{field-1}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}6x+\\frac{\\pi }{3} & =\\pi +2\\pi n.\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get the following:\n\n$$\n\\begin{aligned}6x & =\\pi -\\frac{\\pi }{3}+2\\pi n \\\\ 6x & =\\frac{2\\pi }{3}+2\\pi n \\\\ x & =\\frac{\\pi }{9}+\\frac{\\pi }{3}\\cdot n\\end{aligned}\n$$\n\nTherefore, we have that $a=\\frac{1}{9}.$"}] [{:db/id #edb/ref 17592186259659 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3bd5e5c-b8d1-53e5-9968-8bef8faceb4b" :knowledge-point/title "Solving a Trigonometric Equation Containing the Tangent Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c158c77-0adb-5f06-8d4b-c07d37822cc7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259661}] :answer-field/correct {:answer/id #uuid "6c158c77-0adb-5f06-8d4b-c07d37822cc7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259661} :answer-field/id #uuid "6313b72d-4ece-5327-8d7f-7d8b27de6a3b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259660} {:answer-field/choices [{:answer/id #uuid "2f7935d6-915d-546d-9ca6-05f8521d9bd0" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186259663}] :answer-field/correct {:answer/id #uuid "2f7935d6-915d-546d-9ca6-05f8521d9bd0" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186259663} :answer-field/id #uuid "ee14a56f-6429-5c5e-a654-22356ab98625" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259662} {:answer-field/choices [{:answer/id #uuid "797a29ae-b1ec-5db8-ac8e-934955f9ac1f" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186259665}] :answer-field/correct {:answer/id #uuid "797a29ae-b1ec-5db8-ac8e-934955f9ac1f" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186259665} :answer-field/id #uuid "79538ab1-c604-5e0b-ab5a-c1801bb24957" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259664} {:answer-field/choices [{:answer/id #uuid "f754096a-e449-5d46-aad7-4001bd2da0e5" :answer/type {:db/ident :answer.type/math} :answer/value "270" :db/id #edb/ref 17592186259667}] :answer-field/correct {:answer/id #uuid "f754096a-e449-5d46-aad7-4001bd2da0e5" :answer/type {:db/ident :answer.type/math} :answer/value "270" :db/id #edb/ref 17592186259667} :answer-field/id #uuid "c520450c-f7cf-5826-9d4e-e16ba09003e0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259666}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ef87672-04a1-57b6-b8ef-a21f1ff660eb" :question/math-academy-id "q-328346" :question/problem "Expressed in **ascending order** in degrees, the **exact solutions** to the equation $\\operatorname{tan}(2x+{45}^{∘})=1,$ for ${0}^{∘}\\le x<{360}^{∘},$  are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$\n{{field-2}}${}^{∘},\\,{x}_{3}=$\n{{field-3}}${}^{∘},\\,{x}_{4}=$\n{{field-4}}${}^{∘}.$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x+{45}^{∘} & ={45}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}2x & =-{45}^{∘}+{45}^{∘}+n\\cdot {180}^{∘} \\\\ 2x & =n\\cdot {180}^{∘} \\\\ x & =n\\cdot {90}^{∘}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={0}^{∘}$\n\n- Setting $n=1$ gives $x={90}^{∘}$\n\n- Setting $n=2$ gives $x={180}^{∘}$\n\n- Setting $n=3$ gives $x={270}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ \n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}={0}^{∘},\\,{x}_{2}={90}^{∘},\\,{x}_{3}={180}^{∘},\\,{x}_{4}={270}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186259668 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3bd5e5c-b8d1-53e5-9968-8bef8faceb4b" :knowledge-point/title "Solving a Trigonometric Equation Containing the Tangent Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5fcd305-9bf2-539d-a1e2-4403dfbee354" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186259670}] :answer-field/correct {:answer/id #uuid "f5fcd305-9bf2-539d-a1e2-4403dfbee354" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186259670} :answer-field/id #uuid "d34873d1-7f49-5e2c-8a8f-c6f66824f2e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259669} {:answer-field/choices [{:answer/id #uuid "6dd25731-8ff7-503c-b80c-82c9e8d0849a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186259672}] :answer-field/correct {:answer/id #uuid "6dd25731-8ff7-503c-b80c-82c9e8d0849a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186259672} :answer-field/id #uuid "ac740bb2-2006-5d21-88a9-68fedeb52a80" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259671} {:answer-field/choices [{:answer/id #uuid "771c7e95-7848-525d-8ae7-8fefc48a65ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186259674}] :answer-field/correct {:answer/id #uuid "771c7e95-7848-525d-8ae7-8fefc48a65ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186259674} :answer-field/id #uuid "d80c21c5-b2dc-5132-8a5b-2e3a1fd62add" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259673} {:answer-field/choices [{:answer/id #uuid "b3ee9484-3b7b-5399-a1b0-d2cfb9b1eca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{4}" :db/id #edb/ref 17592186259676}] :answer-field/correct {:answer/id #uuid "b3ee9484-3b7b-5399-a1b0-d2cfb9b1eca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{4}" :db/id #edb/ref 17592186259676} :answer-field/id #uuid "be1d2089-a2c6-5262-a8ea-40a8fb205738" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259675}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "70ce8ce1-2756-53d1-854a-73628bf022cf" :question/math-academy-id "q-328348" :question/problem "Expressed in **ascending order** in radians, the **exact solutions** to the equation  $\\operatorname{tan}(2x+\\frac{\\pi }{6})=-\\sqrt{3},$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}$,\\,{x}_{3}=$\n{{field-3}}$,\\,{x}_{4}=$\n{{field-4}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =-\\frac{\\pi }{3}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{6}-\\frac{\\pi }{3}+n\\pi  \\\\ 2x & =-\\frac{\\pi }{2}+n\\pi  \\\\ x & =-\\frac{\\pi }{4}+\\frac{n\\pi }{2} \\\\ x & =\\frac{(2n-1)\\pi }{4}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=1$ gives $x=\\frac{\\pi }{4}$\n\n- Setting $n=2$ gives $x=\\frac{3\\pi }{4}$\n\n- Setting $n=3$ gives $x=\\frac{5\\pi }{4}$\n\n- Setting $n=4$ gives $x=\\frac{7\\pi }{4}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ \n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}=\\frac{\\pi }{4},\\,{x}_{2}=\\frac{3\\pi }{4},\\,{x}_{3}=\\frac{5\\pi }{4},\\,{x}_{4}=\\frac{7\\pi }{4}.\n$$"}] [{:db/id #edb/ref 17592186259677 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9797fa8-ae3c-59f1-81ef-9302007dc2a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}" :db/id #edb/ref 17592186259679}] :answer-field/correct {:answer/id #uuid "c9797fa8-ae3c-59f1-81ef-9302007dc2a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}" :db/id #edb/ref 17592186259679} :answer-field/id #uuid "73c1882f-1dd2-54b0-974a-249353e6af9b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259678}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3b14cf9c-c1ee-5a69-a0d8-213d7f9bcecc" :question/math-academy-id "q-328449" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}(4x)=\\frac{2}{\\sqrt{3}}\n$$\n\nThe general solution of this equation is\n\n$$\nx=\\frac{\\pi }{24}+\\frac{\\pi n}{2},\\,x=a\\pi +\\frac{\\pi n}{2},\n$$\n\nwhere $n$ is any integer. Find a possible value of $a$ in the range $[0,\\frac{1}{2}).$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}(4x)=\\frac{\\sqrt{3}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n4x=\\frac{\\pi }{6}+2\\pi n,\\,4x=\\frac{11\\pi }{6}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}4x & =\\frac{\\pi }{6}+2\\pi n, & \\,4x & =\\frac{11\\pi }{6}+2\\pi n \\\\ x & =\\frac{\\pi }{24}+\\frac{\\pi n}{2}, & \\,x & =\\frac{11\\pi }{24}+\\frac{\\pi n}{2}.\\end{aligned}\n$$\n\nSo, we have that $a=\\frac{11}{24}.$"}] [{:db/id #edb/ref 17592186259905 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f677b4-0a78-5d93-84e2-c44c254ad921" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186259907}] :answer-field/correct {:answer/id #uuid "30f677b4-0a78-5d93-84e2-c44c254ad921" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186259907} :answer-field/id #uuid "77c31624-34ce-5c6a-a27d-a8f7ce71483e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259906} {:answer-field/choices [{:answer/id #uuid "e1c7d0d4-e1bb-56b4-aad3-eb3d736dbab3" :answer/type {:db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186259909}] :answer-field/correct {:answer/id #uuid "e1c7d0d4-e1bb-56b4-aad3-eb3d736dbab3" :answer/type {:db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186259909} :answer-field/id #uuid "2d6839d6-dcb1-5941-bca7-1c53a24e01f4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259908}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f1ee8101-ef90-5936-9218-2b307b36327b" :question/math-academy-id "q-340942" :question/problem "Find the equation of the normal line to the curve $y=2{x}^{2}+1$ at the point $(2,9).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=2{x}^{2}+1.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+1)=4x\n$$\n\nThen, we compute the slope of the tangent at the point $(2,9):$\n\n$$\nm={f}^{'}(2)=4(2)=8\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-9 & =-\\frac{1}{8}(x-2) \\\\ 8y-72 & =-x+2 \\\\ x+8\\cdot y & =74.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259910 :knowledge-point/_questions [{:knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fd55798-3dc9-5e70-9dd2-d43f04a6af69" :answer/type {:db/ident :answer.type/math} :answer/value "-7{e}^{3}" :db/id #edb/ref 17592186259912}] :answer-field/correct {:answer/id #uuid "4fd55798-3dc9-5e70-9dd2-d43f04a6af69" :answer/type {:db/ident :answer.type/math} :answer/value "-7{e}^{3}" :db/id #edb/ref 17592186259912} :answer-field/id #uuid "0c814946-1453-57b9-a6c5-6e6c5ac01d5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259911}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bcb98d22-04ec-5cb4-9ac2-83bff537cec1" :question/math-academy-id "q-340948" :question/problem "Find the slope $m$ of the tangent to the curve $y={e}^{-2{x}^{6}+5x}$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=-2{x}^{6}+5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-12{x}^{5}+5.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-12{x}^{5}+5) \\\\  & =(-12{x}^{5}+5){e}^{u} \\\\  & =(-12{x}^{5}+5){e}^{-2{x}^{6}+5x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={((-12{x}^{5}+5){e}^{-2{x}^{6}+5x})|}_{x=1} \\\\  & =(-12(1)^{5}+5){e}^{-2(1)^{6}+5(1)} \\\\  & =-7{e}^{3} \\\\  & =-7{e}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259913 :knowledge-point/_questions [{:knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b460474-701c-558d-8975-8e95a9f6238b" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-1}" :db/id #edb/ref 17592186259915}] :answer-field/correct {:answer/id #uuid "2b460474-701c-558d-8975-8e95a9f6238b" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-1}" :db/id #edb/ref 17592186259915} :answer-field/id #uuid "973ae045-507b-5676-bd0d-ca0186c1dc80" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259914}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "22c72ac4-7b5e-5497-a5a6-08cd37637b16" :question/math-academy-id "q-340955" :question/problem "Find the slope $m$ of the tangent to the curve $y={e}^{-3x}$ at the point where $x=\\frac{1}{3}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=\\frac{1}{3}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/3} & ={(-3{e}^{-3x})|}_{x=1/3} \\\\  & =-3{e}^{-3(1/3)} \\\\  & =-3{e}^{-1} \\\\  & =-3{e}^{-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259945 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6aa3ee-91e6-588f-9610-d2b871f52395" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186259947}] :answer-field/correct {:answer/id #uuid "0d6aa3ee-91e6-588f-9610-d2b871f52395" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186259947} :answer-field/id #uuid "1de8457e-012a-5e41-81aa-c2795332adbc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259946}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3545fe3a-a0e6-548e-85e2-2ea53ccf0c60" :question/math-academy-id "q-342142" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=4-3{x}^{2}$ at the point $(1,1).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=4-3{x}^{2}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(4-3{x}^{2})=-6x\n$$\n\nThen, we compute the slope of the tangent at the point $(1,1):$\n\n$$\nm={f}^{'}(1)=-6(1)=-6\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{(-6)} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259948 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a79e81d-7957-5034-8f49-136ab4cac68c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186259950}] :answer-field/correct {:answer/id #uuid "1a79e81d-7957-5034-8f49-136ab4cac68c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186259950} :answer-field/id #uuid "7f400028-7c20-514f-a009-3d6ef64a38fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259949}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7fdc1ded-84f3-5aa0-9f75-d6f219a0924f" :question/math-academy-id "q-342147" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=\\frac{1}{4}{x}^{5}-4{x}^{2}$ at the point $(2,-8).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{1}{4}{x}^{5}-4{x}^{2}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{x}^{5}-4{x}^{2})=\\frac{5}{4}{x}^{4}-8x\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-8):$\n\n$$\nm={f}^{'}(2)=\\frac{5}{4}({2}^{4})-8(2)=20-16=4\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259951 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bc826bc-caaa-5fab-8d91-1740d9955e1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186259953}] :answer-field/correct {:answer/id #uuid "7bc826bc-caaa-5fab-8d91-1740d9955e1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186259953} :answer-field/id #uuid "46e92c24-80e6-5d0f-be8f-9482056003c8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259952}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c5af5c6e-7b27-5022-a2e9-5d5ddf2fa935" :question/math-academy-id "q-342152" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=2{x}^{3}-\\frac{1}{{x}^{4}}$ at the point $(-1,-3).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2{x}^{3}-\\frac{1}{{x}^{4}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-\\frac{1}{{x}^{4}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-{x}^{-4}) \\\\  & =6{x}^{2}+4{x}^{-5} \\\\  & =6{x}^{2}+\\frac{4}{{x}^{5}}.\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-3):$\n\n$$\nm={f}^{'}(-1)=6{(-1)}^{2}+\\frac{4}{(-1)^{5}}=6-4=2\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259954 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ba24c34-cdde-566c-b78b-46a9c4176575" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259956}] :answer-field/correct {:answer/id #uuid "8ba24c34-cdde-566c-b78b-46a9c4176575" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259956} :answer-field/id #uuid "08fbda2d-307a-5e11-987c-cf4a2e89319d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259955} {:answer-field/choices [{:answer/id #uuid "34358e83-d26d-565c-a696-0c6976f8d3a1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259958}] :answer-field/correct {:answer/id #uuid "34358e83-d26d-565c-a696-0c6976f8d3a1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259958} :answer-field/id #uuid "42e0fcf9-5fb0-513d-9339-ad66240b2699" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259957}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1a6ea14-1871-540c-9817-e8bcb2170f98" :question/math-academy-id "q-342163" :question/problem "Find the equation of the normal line to the curve $y=4x-{x}^{3}$ at the point $(1,3).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=4x-{x}^{3}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(4x-{x}^{3})=4-3{x}^{2}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,3):$\n\n$$\nm={f}^{'}(1)=4-3({1}^{2})=1\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-1\\cdot (x-1) \\\\ y-3 & =-x+1 \\\\ x+1\\cdot y & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260080 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfe5a9ca-d045-53ae-bc69-fff9dfbdc439" :knowledge-point/title "Finding a General Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55c0387-00b5-52c5-a868-9664438f0df4" :answer/type {:db/ident :answer.type/math} :answer/value "k(6-k)" :db/id #edb/ref 17592186260082}] :answer-field/correct {:answer/id #uuid "a55c0387-00b5-52c5-a868-9664438f0df4" :answer/type {:db/ident :answer.type/math} :answer/value "k(6-k)" :db/id #edb/ref 17592186260082} :answer-field/id #uuid "3b21288c-b4d5-53ea-81cb-4f6e9987af2f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260081}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9bc28102-4dcf-5e50-8666-fd7774b8784d" :question/math-academy-id "q-347920" :question/problem "Find the $k$th partial sum ${s}_{k}$ of the series ${\\sum }_{n=1}^{\\infty }(7-2n).$ Express the answer in terms of the parameter $k.$\n\n${s}_{k}=$\n{{field-1}}" :question/worked-solution "Let ${a}_{n}=7-2n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =7-2(1)=5 \\\\ {a}_{2} & =7-2(2)=3 \\\\ {a}_{3} & =7-2(3)=1,\\end{aligned}\n$$\n\nand we see that this is an arithmetic sequence with common difference $d=-2$ and ${a}_{1}=5.$\n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{k}=7-2k,$ we get\n\n$$\n\\begin{aligned}{s}_{k} & =\\frac{k}{2}(5+(7-2k)) \\\\  & =\\frac{k}{2}(12-2k) \\\\  & =k(6-k).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260089 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b5c61a4-3c02-5f45-a6e7-97cf79923e9a" :knowledge-point/title "Finding the First Partial Sums of an Infinite Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cf696b4-e25a-5e0a-9745-b467dbeed7f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186260091}] :answer-field/correct {:answer/id #uuid "7cf696b4-e25a-5e0a-9745-b467dbeed7f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186260091} :answer-field/id #uuid "81a187a3-5575-57e4-b0e8-ccdf2051c02c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260090}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b503e377-0ec1-535d-8219-850878efeeae" :question/math-academy-id "q-349045" :question/problem "Find the third partial sum ${s}_{3}$ of the series\n${\\sum }_{n=1}^{\\infty }\\frac{n!}{2}.$ Do not round the answer.\n\n${s}_{3}=$\n{{field-1}}" :question/worked-solution "Let's start by calculating the first three terms:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1!}{2}=\\frac{1}{2} \\\\ {a}_{2} & =\\frac{2!}{2}=1 \\\\ {a}_{3} & =\\frac{3!}{2}=3\\end{aligned}\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3} & =\\frac{1}{2}+1+3=\\frac{9}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260092 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b5c61a4-3c02-5f45-a6e7-97cf79923e9a" :knowledge-point/title "Finding the First Partial Sums of an Infinite Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769c13a1-2652-5745-bf0c-dc8847660a4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186260094}] :answer-field/correct {:answer/id #uuid "769c13a1-2652-5745-bf0c-dc8847660a4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186260094} :answer-field/id #uuid "a72a5a13-7c65-5e73-9386-bea7dbcf8dfd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260093}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ea7ffee5-aba9-5009-a4aa-655ef4e3e64e" :question/math-academy-id "q-349046" :question/problem "Find the third partial sum ${s}_{3}$ of the series\n${\\sum }_{n=1}^{\\infty }\\frac{(n+1)!}{3}.$ Do not round the answer.\n\n${s}_{3}=$\n{{field-1}}" :question/worked-solution "Let's start by calculating the first three terms:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{(1+1)!}{3}=\\frac{2}{3} \\\\ {a}_{2} & =\\frac{(2+1)!}{3}=2 \\\\ {a}_{3} & =\\frac{(3+1)!}{3}=8\\end{aligned}\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3} & =\\frac{2}{3}+2+8=\\frac{32}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260101 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfe5a9ca-d045-53ae-bc69-fff9dfbdc439" :knowledge-point/title "Finding a General Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0ca45d0-d903-59d2-b483-83b8b71f45bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3k(5-k)}{2}" :db/id #edb/ref 17592186260103}] :answer-field/correct {:answer/id #uuid "b0ca45d0-d903-59d2-b483-83b8b71f45bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3k(5-k)}{2}" :db/id #edb/ref 17592186260103} :answer-field/id #uuid "d55c1a76-09c5-59cc-b6de-ae8fc809ab06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260102}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9d6d7aed-0c66-5470-8540-1a575cf8c7e4" :question/math-academy-id "q-349084" :question/problem "Find the $k$th partial sum ${s}_{k}$ of the series ${\\sum }_{n=1}^{\\infty }(9-3n).$ Express the answer in terms of the parameter $k.$\n\n${s}_{k}=$\n{{field-1}}" :question/worked-solution "Let ${a}_{n}=9-3n.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =9-3(1)=6 \\\\ {a}_{2} & =9-3(2)=3 \\\\ {a}_{3} & =9-3(3)=0,\\end{aligned}\n$$\n\nand we see that this is an arithmetic sequence with common difference $d=-3$ and ${a}_{1}=6.$\n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{k}=9-3k,$ we get\n\n$$\n\\begin{aligned}{s}_{k} & =\\frac{k}{2}(6+(9-3k)) \\\\  & =\\frac{k}{2}(15-3k) \\\\  & =\\frac{3k(5-k)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260112 :knowledge-point/_questions [{:knowledge-point/id #uuid "25e9a94e-05d9-5a13-b480-be5f697d2e10" :knowledge-point/title "Expressing an Infinite Series Using Sigma Notation Given The First Few Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d87da9ff-f069-5727-ae59-98435659c8c0" :answer/type {:db/ident :answer.type/math} :answer/value "81{(\\frac{1}{3})}^{n}" :db/id #edb/ref 17592186260114}] :answer-field/correct {:answer/id #uuid "d87da9ff-f069-5727-ae59-98435659c8c0" :answer/type {:db/ident :answer.type/math} :answer/value "81{(\\frac{1}{3})}^{n}" :db/id #edb/ref 17592186260114} :answer-field/id #uuid "f49a7deb-520f-5bcd-aa8d-9bb68e699f4b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260113}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8b4eec09-d9de-5cf6-983b-fc87959ff0a3" :question/math-academy-id "q-350514" :question/problem "Write the following series in sigma notation in terms of index $n.$\n\n$27+9+3+…={\\sum }_{n=1}^{\\infty }${{field-1}}" :question/worked-solution "The first term is ${a}_{1}=27$ and the second term is ${a}_{2}=9.$ Using these two terms, we compute the common ratio:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{9}{27}=\\frac{1}{3}\n$$\n\nTherefore, the general term can be expressed as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{(r)}^{n-1} \\\\  & =27{(\\frac{1}{3})}^{n-1} \\\\  & =27{(\\frac{1}{3})}^{-1}{(\\frac{1}{3})}^{n} \\\\  & =27(3){(\\frac{1}{3})}^{n} \\\\  & =81{(\\frac{1}{3})}^{n}.\\end{aligned}\n$$\n\nFinally, the infinite geometric series can be written in sigma notation as\n\n$$\n\\begin{aligned}27+9+3+⋯ & ={\\sum }_{n=1}^{\\infty }{a}_{n} \\\\  & ={\\sum }_{n=1}^{\\infty }\\,81{(\\frac{1}{3})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260115 :knowledge-point/_questions [{:knowledge-point/id #uuid "25e9a94e-05d9-5a13-b480-be5f697d2e10" :knowledge-point/title "Expressing an Infinite Series Using Sigma Notation Given The First Few Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99ea972a-6e7e-50d4-8864-ea0bf9b419dd" :answer/type {:db/ident :answer.type/math} :answer/value "(-40){(-\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186260117}] :answer-field/correct {:answer/id #uuid "99ea972a-6e7e-50d4-8864-ea0bf9b419dd" :answer/type {:db/ident :answer.type/math} :answer/value "(-40){(-\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186260117} :answer-field/id #uuid "770f04d9-844e-556c-885c-dff520f5187e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260116}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "119025e4-ad43-59fd-a5a0-d8411aeec6a4" :question/math-academy-id "q-350523" :question/problem "Write the following series in sigma notation in terms of index $n.$\n\n$20-10+5-⋯={\\sum }_{n=1}^{\\infty }${{field-1}}" :question/worked-solution "The first term is ${a}_{1}=20$ and the second term is ${a}_{2}=-10.$ Using these two terms, we compute the common ratio:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{-10}{20}=-\\frac{1}{2}\n$$\n\nTherefore, the general term can be expressed as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{(r)}^{n-1} \\\\  & =20{(-\\frac{1}{2})}^{n-1} \\\\  & =20{(-\\frac{1}{2})}^{-1}{(-\\frac{1}{2})}^{n} \\\\  & =20(-2){(-\\frac{1}{2})}^{n} \\\\  & =(-40){(-\\frac{1}{2})}^{n}.\\end{aligned}\n$$\n\nFinally, the infinite geometric series can be written in sigma notation as\n\n$$\n\\begin{aligned}20-10+5-⋯ & ={\\sum }_{n=1}^{\\infty }{a}_{n} \\\\  & ={\\sum }_{n=1}^{\\infty }(-40){(-\\frac{1}{2})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260118 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a498624-ebf8-5a8a-ac4a-3a92bf9d2ecf" :knowledge-point/title "Expressing an Infinite Series Using Sigma Notation Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "810f46b8-b95c-5dd1-8c05-282c1e866727" :answer/type {:db/ident :answer.type/math} :answer/value "(-36){(\\frac{1}{6})}^{n}" :db/id #edb/ref 17592186260120}] :answer-field/correct {:answer/id #uuid "810f46b8-b95c-5dd1-8c05-282c1e866727" :answer/type {:db/ident :answer.type/math} :answer/value "(-36){(\\frac{1}{6})}^{n}" :db/id #edb/ref 17592186260120} :answer-field/id #uuid "0966fac8-0a78-5174-8104-3aae5458a81d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260119}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ea760bb2-cb14-5f5e-b860-8a942b4a58f7" :question/math-academy-id "q-350560" :question/problem "Consider the sequence starting from ${a}_{1}=-6$  with the property $\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{6}$ for all $n\\ge 1.$ Write the sum to infinity $S$ of the terms of this series using sigma notation in terms of index $n.$\n\n$S={\\sum }_{n=1}^{\\infty }${{field-1}}" :question/worked-solution "Notice that the sequence is a geometric sequence since the ratio of any two successive terms is constant.\n\nThe first term of the sequence is ${a}_{1}=-6,$ and the common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{6}.\n$$\n\nTherefore, the general term ${a}_{n}$ can be expressed as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{(r)}^{n-1} \\\\  & =(-6){(\\frac{1}{6})}^{n-1} \\\\  & =(-6){(\\frac{1}{6})}^{-1}{(\\frac{1}{6})}^{n} \\\\  & =(-36){(\\frac{1}{6})}^{n}.\\end{aligned}\n$$\n\nFinally,  the infinite geometric series $S$ can be written in sigma notation as\n\n$$\n\\begin{aligned}S={\\sum }_{n=1}^{\\infty }{a}_{n} & ={\\sum }_{n=1}^{\\infty }(-36){(\\frac{1}{6})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260121 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a498624-ebf8-5a8a-ac4a-3a92bf9d2ecf" :knowledge-point/title "Expressing an Infinite Series Using Sigma Notation Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8c7cffb-8a11-50fb-ba58-04efa5e9e069" :answer/type {:db/ident :answer.type/math} :answer/value "(-98){(\\frac{1}{7})}^{n}" :db/id #edb/ref 17592186260123}] :answer-field/correct {:answer/id #uuid "d8c7cffb-8a11-50fb-ba58-04efa5e9e069" :answer/type {:db/ident :answer.type/math} :answer/value "(-98){(\\frac{1}{7})}^{n}" :db/id #edb/ref 17592186260123} :answer-field/id #uuid "8fbf6570-4f71-52ca-8d18-db09f6b66bb5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260122}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "675b9ff6-dd95-522e-88f3-9cd816cf4e6d" :question/math-academy-id "q-350561" :question/problem "Consider the sequence starting from ${a}_{1}=-14$  with the property $\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{7}$ for all $n\\ge 1.$ Write the sum to infinity $S$ of the terms of this series using sigma notation in terms of index $n.$\n\n$S={\\sum }_{n=1}^{\\infty }${{field-1}}" :question/worked-solution "Notice that the sequence is a geometric sequence since the ratio of any two successive terms is constant.\n\nThe first term of the sequence is ${a}_{1}=-14,$ and the common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=\\frac{1}{7}.\n$$\n\nTherefore, the general term ${a}_{n}$ can be expressed as\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{(r)}^{n-1} \\\\  & =(-14){(\\frac{1}{7})}^{n-1} \\\\  & =(-14){(\\frac{1}{7})}^{-1}{(\\frac{1}{7})}^{n} \\\\  & =(-98){(\\frac{1}{7})}^{n}.\\end{aligned}\n$$\n\nFinally, the infinite geometric series $S$ can be written in sigma notation as\n\n$$\n\\begin{aligned}S={\\sum }_{n=1}^{\\infty }{a}_{n} & ={\\sum }_{n=1}^{\\infty }(-98){(\\frac{1}{7})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260124 :knowledge-point/_questions [{:knowledge-point/id #uuid "aaba35a4-5f6b-578c-9fbb-90b041c19803" :knowledge-point/title "Evaluating an Infinite Geometric Series Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96f638d7-8251-569a-a6ec-34300fefaa66" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186260126}] :answer-field/correct {:answer/id #uuid "96f638d7-8251-569a-a6ec-34300fefaa66" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186260126} :answer-field/id #uuid "30687167-a416-5b3d-a4e8-5eea820277d4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "978fbe70-b917-5f3f-8f89-44fd798a2554" :question/math-academy-id "q-350571" :question/problem "Given that ${a}_{1}=-7$ and $\\frac{{a}_{n+1}}{{a}_{n}}=0.5$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$\n\n${\\sum }_{n=1}^{\\infty }{a}_{n}=$\n{{field-1}}" :question/worked-solution "Notice that the given series is a geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-7.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=0.5.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{(-7)}{(1-0.5)} \\\\  & =\\frac{(-7)}{(0.5)} \\\\  & =-14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260127 :knowledge-point/_questions [{:knowledge-point/id #uuid "aaba35a4-5f6b-578c-9fbb-90b041c19803" :knowledge-point/title "Evaluating an Infinite Geometric Series Given Its First Term and Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b12c1066-af2f-5cfe-a611-8a4523274537" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260129}] :answer-field/correct {:answer/id #uuid "b12c1066-af2f-5cfe-a611-8a4523274537" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260129} :answer-field/id #uuid "1f56f715-e231-5fc2-8f7e-fd84242b7707" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260128}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2e44366-3661-52c4-bfa0-64b9706d86c5" :question/math-academy-id "q-350576" :question/problem "Given that ${a}_{1}=7$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-0.4$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$\n\n${\\sum }_{n=1}^{\\infty }{a}_{n}=$\n{{field-1}}" :question/worked-solution "Notice that the given series is a geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=7.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-0.4.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{7}{(1-(-0.4))} \\\\  & =\\frac{7}{(1+0.4)} \\\\  & =\\frac{7}{1.4} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260142 :knowledge-point/_questions [{:knowledge-point/id #uuid "b98c8710-49f8-550f-aad3-7b78220bd08f" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c93478d7-5ad1-5168-bdbd-35f035c0cd48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186260144}] :answer-field/correct {:answer/id #uuid "c93478d7-5ad1-5168-bdbd-35f035c0cd48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186260144} :answer-field/id #uuid "865a5466-9fc0-5e19-ac48-97dd76755a81" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a590ae1b-a6f1-59bc-ae08-476c39ab9fd7" :question/math-academy-id "q-350620" :question/problem "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=4}^{\\infty }\\frac{64}{9}{(\\frac{1}{4})}^{n}=$\n{{field-1}}" :question/worked-solution "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{64}{9}{(\\frac{1}{4})}^{4}=\\frac{1}{36} \\\\ {a}_{5} & =\\frac{64}{9}{(\\frac{1}{4})}^{5}=\\frac{1}{144}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{(\\frac{1}{144})}{(\\frac{1}{36})}=\\frac{1}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }\\frac{64}{9}{(\\frac{1}{4})}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{(\\frac{1}{36})}{(1-\\frac{1}{4})} \\\\  & =\\frac{(\\frac{1}{36})}{(\\frac{3}{4})} \\\\  & =\\frac{1}{36}\\cdot \\frac{4}{3} \\\\  & =\\frac{1}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260148 :knowledge-point/_questions [{:knowledge-point/id #uuid "530b0b21-6349-5ce4-acd2-d20f4c6d7b3e" :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Non-Standard Form Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f218525b-e998-507f-b69d-bc0b09424db6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260150}] :answer-field/correct {:answer/id #uuid "f218525b-e998-507f-b69d-bc0b09424db6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260150} :answer-field/id #uuid "ecd4bec2-b996-5e03-87f5-0771e4052cd0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260149}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7729376e-a449-523f-b26a-16e4bafe18ce" :question/math-academy-id "q-350648" :question/problem "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=3}^{\\infty }6{(-\\frac{1}{5})}^{\\,n-2}=$\n{{field-1}}" :question/worked-solution "First, note that the index $n$ starts from $3,$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nComputing the first few terms, we get:\n\n$$\n{a}_{3}=6{(-\\frac{1}{5})}^{3-2}=6(-\\frac{1}{5})=-\\frac{6}{5}\n$$\n\n$$\n{a}_{4}=6{(-\\frac{1}{5})}^{4-2}=6(\\frac{1}{25})=\\frac{6}{25}.\n$$\n\nTherefore, the common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{6}{25})}{(-\\frac{6}{5})}=-\\frac{1}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }6{(-\\frac{1}{5})}^{\\,n-2} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(-\\frac{6}{5})}{1-(-\\frac{1}{5})} \\\\  & =-\\frac{(\\frac{6}{5})}{(\\frac{6}{5})} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260297 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db8b76fd-8b6b-55c3-8edc-c3327759fc25" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186260299}] :answer-field/correct {:answer/id #uuid "db8b76fd-8b6b-55c3-8edc-c3327759fc25" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186260299} :answer-field/id #uuid "5b0833d4-4144-569c-b006-dceef4d41ca4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260298}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "44cf182f-9628-54ce-8c6a-39e321172edf" :question/math-academy-id "q-40286" :question/problem "Consider the infinite geometric sequence that has a fifth term equal to $-\\frac{1}{2}$ and an eighth term equal to $-\\frac{1}{16}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{5}=-\\frac{1}{2}$ and ${a}_{8}=-\\frac{1}{16}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{8-5} & =\\frac{(-\\frac{1}{16})}{(-\\frac{1}{2})} \\\\ {r}^{3} & =(-\\frac{1}{16})(-2) \\\\ {r}^{3} & =\\frac{1}{8} \\\\ {r}^{3} & ={(\\frac{1}{2})}^{3} \\\\ r & =\\frac{1}{2}\\end{aligned}\n$$\n\nNow, using the formula\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}\n$$\n\nfor the $n$th term of the geometric sequence, we can find the first term. Indeed, for $n=5$ we obtain:\n\n$$\n\\begin{aligned}{a}_{5} & ={a}_{1}{r}^{4} \\\\ -\\frac{1}{2} & ={a}_{1}{(\\frac{1}{2})}^{4} \\\\ -\\frac{1}{2} & ={a}_{1}(\\frac{1}{16}) \\\\ {a}_{1} & =-8\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-8}{(1-\\frac{1}{2})} \\\\  & =-\\frac{8}{(\\frac{1}{2})} \\\\  & =-16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260485 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "520a9952-36d1-5b28-9d1a-d3da42f14a77" :answer/type {:db/ident :answer.type/math} :answer/value "362" :db/id #edb/ref 17592186260487}] :answer-field/correct {:answer/id #uuid "520a9952-36d1-5b28-9d1a-d3da42f14a77" :answer/type {:db/ident :answer.type/math} :answer/value "362" :db/id #edb/ref 17592186260487} :answer-field/id #uuid "4d2e2314-4883-5c9a-a3d2-ba10b8b0172d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2dd83d18-2e82-5500-9a29-406ec35162d7" :question/math-academy-id "q-47405" :question/problem "The equation of the normal line to the curve $y=2{x}^{3}$ at the point $(2,16)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $q-p.$\n\nAnswer: {{answer}}" :question/worked-solution "Let $f(x)=2{x}^{3}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3})=6{x}^{2}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,16):$\n\n$$\n\\begin{aligned}m={f}^{'}(2)=6(2)^{2}=24\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{'}$ is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{24}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(16) & =-\\frac{1}{24}(x-(2)) \\\\ 24y-384 & =-x+2 \\\\ x+24y & =386.\\end{aligned}\n$$\n\nTherefore, $q-p=386-24=362.$"}] [{:db/id #edb/ref 17592186260526 :knowledge-point/_questions [{:knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5288b2ef-28bd-5248-a23b-3168a47dadcf" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{5-x}" :db/id #edb/ref 17592186260528}] :answer-field/correct {:answer/id #uuid "5288b2ef-28bd-5248-a23b-3168a47dadcf" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{5-x}" :db/id #edb/ref 17592186260528} :answer-field/id #uuid "52ce8ef2-2546-598b-876b-32e5d642c3bc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260527}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18ca2967-70f1-50fc-adb1-d5ade712f567" :question/math-academy-id "q-48003" :question/problem "Given that $y=-3{e}^{5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$\n\nAnswer: {{answer}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260617 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d6bb40d-91af-55ae-ab0c-fbf5b6d0f0e1" :knowledge-point/title "Finding a Partial Sum of an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5ba8282-f56e-5470-be68-7b26ce02cb57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}(1-{x}^{5})}{1-x}" :db/id #edb/ref 17592186260619}] :answer-field/correct {:answer/id #uuid "b5ba8282-f56e-5470-be68-7b26ce02cb57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}(1-{x}^{5})}{1-x}" :db/id #edb/ref 17592186260619} :answer-field/id #uuid "2a373ee9-ba85-5a26-b04c-f9ec45642784" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260618}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8a9cbdc6-b363-57d5-bb3e-8d0d655f7af6" :question/math-academy-id "q-49558" :question/problem "What is the fifth partial sum of the series\n${\\sum }_{n=1}^{\\infty }6{x}^{n+1}?$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=6{x}^{n+1}.$ We note that this is a geometric sequence with $r=x$ and first term given by\n\n$$\n{a}_{1}=6{x}^{1+1}=6{x}^{2}.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the fifth partial sum is\n\n$$\n\\begin{aligned}{s}_{5} & =6{x}^{2}\\cdot \\frac{1-{x}^{5}}{1-x} \\\\  & =\\frac{6{x}^{2}(1-{x}^{5})}{1-x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260624 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d6bb40d-91af-55ae-ab0c-fbf5b6d0f0e1" :knowledge-point/title "Finding a Partial Sum of an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b6ae1f4-d44e-5228-bedb-cd47059e3e91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x(1-16{x}^{4})}{1-2x}" :db/id #edb/ref 17592186260626}] :answer-field/correct {:answer/id #uuid "8b6ae1f4-d44e-5228-bedb-cd47059e3e91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x(1-16{x}^{4})}{1-2x}" :db/id #edb/ref 17592186260626} :answer-field/id #uuid "24fa643e-bd93-58ac-b414-22106e49cb68" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260625}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e95dca68-877e-5128-aa96-9c3d5dd43bb0" :question/math-academy-id "q-49635" :question/problem "What is the fourth partial sum of the series\n${\\sum }_{n=1}^{\\infty }4(2x)^{n}?$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=4(2x)^{n}.$ We note that this is a geometric sequence with $r=2x$ and first term given by\n\n$$\n{a}_{1}=4(2x)^{1}=4\\cdot 2x=8x.\n$$\n\nThe $k$th partial sum of a geometric series is given by\n\n$$\n{s}_{k}={a}_{1}(\\frac{1-{r}^{k}}{1-r}).\n$$\n\nTherefore, the fourth partial sum is\n\n$$\n\\begin{aligned}{s}_{4} & =8x\\cdot \\frac{1-(2x)^{4}}{1-2x} \\\\  & =8x\\cdot \\frac{1-{2}^{4}{x}^{4}}{1-2x} \\\\  & =8x\\cdot \\frac{1-16{x}^{4}}{1-2x} \\\\  & =\\frac{8x(1-16{x}^{4})}{1-2x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260627 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fbf48c3-47f2-594f-90f0-b0cd659b0239" :knowledge-point/title "Determining Whether an Oscillating Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab84687-4674-50da-a455-1f6360b70d58" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186260629} {:answer/id #uuid "f0422631-e627-5668-a3fd-c50f7d2e4c0b" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186260630}] :answer-field/correct {:answer/id #uuid "3ab84687-4674-50da-a455-1f6360b70d58" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186260629} :answer-field/id #uuid "8bafb7c5-b67d-5e0b-9773-76f093b2d804" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260628}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "335820dd-ba2b-5e7f-92b7-d9a01208fa93" :question/math-academy-id "q-49642" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{2}{(-1)}^{n}.$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =\\frac{1}{2}{(-1)}^{1}=-\\frac{1}{2} \\\\ {s}_{2} & =-\\frac{1}{2}+\\frac{1}{2}{(-1)}^{2}=0 \\\\ {s}_{3} & =0+\\frac{1}{2}{(-1)}^{3}=-\\frac{1}{2} \\\\ {s}_{4} & =-\\frac{1}{2}+\\frac{1}{2}{(-1)}^{4}=0\\end{aligned}\n$$\n\nFrom the above, we can see that the sequence of partial sums oscillates between  $-\\frac{1}{2}$ and $0$ forever. \n\nSo the limit of the sequence of partial sums does not exist, and therefore the series is divergent."}] [{:db/id #edb/ref 17592186261040 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f1fe2b-5643-5b0a-907c-3906ef26c821" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186261042}] :answer-field/correct {:answer/id #uuid "35f1fe2b-5643-5b0a-907c-3906ef26c821" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186261042} :answer-field/id #uuid "2615b029-78a2-5f37-bd7f-39a215cd4284" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261041}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bd4b8c3e-dfee-5ef6-85a6-3f80440979fd" :question/math-academy-id "q-67278" :question/problem "Consider the infinite geometric sequence that has a first term equal to $48$ and a fourth term equal to $\\frac{3}{4}.$ What is the sum to infinity of the terms of this sequence?\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=48$ and ${a}_{4}=\\frac{3}{4}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{3}{4})}{48} \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{48}{(1-\\frac{1}{4})} \\\\  & =\\frac{48}{(\\frac{3}{4})} \\\\  & =48\\cdot \\frac{4}{3} \\\\  & =64.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261106 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8a9c045-18f6-58c4-9746-9a119ed6975c" :knowledge-point/title "Finding a Partial Sum of an Infinite Arithmetic Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144e8652-fa68-52dc-82e6-05edd1d9d46d" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186261108}] :answer-field/correct {:answer/id #uuid "144e8652-fa68-52dc-82e6-05edd1d9d46d" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186261108} :answer-field/id #uuid "3a5431de-10c0-57fb-86ad-1c754cd133cb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261107}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5a8ef49c-d0f0-5230-8a06-784e450e8567" :question/math-academy-id "q-69708" :question/problem "Find the eighth partial sum of the series\n${\\sum }_{n=1}^{\\infty }(2n+3).$\n\nAnswer: {{answer}}" :question/worked-solution "Let ${a}_{n}=2n+3.$ If we compute the first few terms, we get\n\n$$\n\\begin{aligned}{a}_{1} & =2(1)+3=5 \\\\ {a}_{2} & =2(2)+3=7 \\\\ {a}_{3} & =2(3)+3=9,\\end{aligned}\n$$\n\nand we notice that this is an arithmetic sequence with common difference $d=2$ and first term ${a}_{1}=5.$ \n\nWe can compute the $k$th partial sum of an arithmetic series using the formula\n\n$$\n{s}_{k}=\\frac{k}{2}({a}_{1}+{a}_{k}).\n$$\n\nSince ${a}_{8}=2(8)+3=19,$ we get\n\n$$\n{s}_{8}=\\frac{8}{2}(5+19)=96.\n$$\n\nSo the eighth partial sum of ${\\sum }_{n=1}^{\\infty }(2n+3)$ is equal to $96.$"}] [{:db/id #edb/ref 17592186261185 :knowledge-point/_questions [{:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95dde01a-7a00-5394-bfa9-d342b6cdffff" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261187}] :answer-field/correct {:answer/id #uuid "95dde01a-7a00-5394-bfa9-d342b6cdffff" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261187} :answer-field/id #uuid "8729ffcf-a958-5385-a30c-750049b75bc8" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261186} {:answer-field/choices [{:answer/id #uuid "5da0d4af-aac1-53a4-a86a-ea6546bf8cc5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261189}] :answer-field/correct {:answer/id #uuid "5da0d4af-aac1-53a4-a86a-ea6546bf8cc5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261189} :answer-field/id #uuid "4a4b346e-2603-5b00-ae88-192f9484e5af" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261188} {:answer-field/choices [{:answer/id #uuid "fdabda59-396b-5b45-aede-35fd91b706d1" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261191}] :answer-field/correct {:answer/id #uuid "fdabda59-396b-5b45-aede-35fd91b706d1" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261191} :answer-field/id #uuid "3ac1c125-7419-510a-ab85-90b9b54b9793" :answer-field/key "r3c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261190}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "11ccab38-8cf0-5596-9d22-fd8f8163d9ed" :question/math-academy-id "q-70428" :question/problem "If $d=⟨1,0,-1⟩$ and $f=i-2j+k$, then $2d-3f=$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "First, notice that\n\n$$\nf=i-2j+k=⟨1,-2,1⟩.\n$$\n\nTo compute $2d-3f,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2d-3f & =2\\cdot ⟨1,0,-1⟩-3\\cdot ⟨1,-2,1⟩ \\\\  & =⟨2\\cdot 1,2\\cdot 0,2\\cdot (-1)⟩-⟨3\\cdot 1,3\\cdot (-2),3\\cdot 1⟩ \\\\  & =⟨2,0,-2⟩-⟨3,-6,3⟩ \\\\  & =⟨-1,6,-5⟩ \\\\  & =[\\begin{aligned}-1 \\\\ 6 \\\\ -5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261192 :knowledge-point/_questions [{:knowledge-point/id #uuid "ea3855dd-f8c9-5065-ac55-99356bbaa583" :knowledge-point/title "Converting Between Alternative Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "633662a1-2bf5-5033-a8f5-3ba3aa7fe838" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,4,0⟩" :db/id #edb/ref 17592186261194}] :answer-field/correct {:answer/id #uuid "633662a1-2bf5-5033-a8f5-3ba3aa7fe838" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,4,0⟩" :db/id #edb/ref 17592186261194} :answer-field/id #uuid "c27a3a4d-2dfd-5b9f-b981-41b44b0e69c9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261193}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f256bc4-5979-5678-bf31-d241337a4560" :question/math-academy-id "q-70435" :question/problem "What represents the vector $d=4j-i$ in angle bracket notation?\n\nAnswer: {{answer}}" :question/worked-solution "Remember that in general, if a point $D$ has coordinates $({d}_{x},{d}_{y},{d}_{z}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OD}=d=⟨{d}_{x},{d}_{y},{d}_{z}⟩=[\\begin{aligned}{d}_{x} \\\\ {d}_{y} \\\\ {d}_{z}\\end{aligned}]={d}_{x}\\,i+{d}_{y}\\,j+{d}_{z}\\,k.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}d & =4j-i \\\\  & =-1\\cdot i+4\\cdot j+0\\cdot k \\\\  & =⟨-1,4,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261195 :knowledge-point/_questions [{:knowledge-point/id #uuid "667a2ec8-c35c-52a8-a072-1d00fd8af78c" :knowledge-point/title "Calculating Sums and Scalar Multiplication of More Than Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf3db8b-07fa-5a05-beeb-5039706e1aa5" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186261197}] :answer-field/correct {:answer/id #uuid "edf3db8b-07fa-5a05-beeb-5039706e1aa5" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186261197} :answer-field/id #uuid "b7ae217c-f9a1-5468-8af7-29172a7dcf35" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261196} {:answer-field/choices [{:answer/id #uuid "768d8132-dcf3-5926-82f7-085f0e901f0b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261199}] :answer-field/correct {:answer/id #uuid "768d8132-dcf3-5926-82f7-085f0e901f0b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261199} :answer-field/id #uuid "f03b04df-385a-5a8d-8329-2848e81acc38" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261198} {:answer-field/choices [{:answer/id #uuid "7c336456-9f5e-57c0-a7c6-81bbad42329d" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261201}] :answer-field/correct {:answer/id #uuid "7c336456-9f5e-57c0-a7c6-81bbad42329d" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261201} :answer-field/id #uuid "85fc23fe-0c61-5bde-9cfe-866cea8c8bdd" :answer-field/key "r3c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261200}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5490d51d-3d7e-50a1-bf73-5cc6f43b1ef0" :question/math-academy-id "q-70442" :question/problem "Let $w=[\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]$, $y=[\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]$ and $z=[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}].$ Find $2w-(3y+z).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}\n\nRow 3, column 1: {{r3c1}}" :question/worked-solution "To compute $2w-(3y+z),$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2w-(3y+z) & =2\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ 2\\end{aligned}]-(3\\cdot [\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}]) \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 4\\end{aligned}]-([\\begin{aligned}12 \\\\ -3 \\\\ 9\\end{aligned}]+[\\begin{aligned}-1 \\\\ 2 \\\\ 10\\end{aligned}]) \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 4\\end{aligned}]-[\\begin{aligned}11 \\\\ -1 \\\\ 19\\end{aligned}] \\\\  & =[\\begin{aligned}-11 \\\\ 7 \\\\ -15\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261310 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/title "Finding the Antiderivative of a Monomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7ebee3-4549-5ca6-afbd-5a9fdec9eef6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{11}}{11}+C" :db/id #edb/ref 17592186261312}] :answer-field/correct {:answer/id #uuid "0e7ebee3-4549-5ca6-afbd-5a9fdec9eef6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{11}}{11}+C" :db/id #edb/ref 17592186261312} :answer-field/id #uuid "c2a44a56-ff21-5733-a26e-db72bd908903" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261311}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "557e5a3f-e4c2-5a77-ab22-ea3e93fa84fe" :question/math-academy-id "q-71121" :question/problem "Calculate $\\int {x}^{10}\\,\\text{d}x.$\n\nAnswer: {{answer}}" :question/worked-solution "We apply the power rule with $n=10$, and we get\n\n$$\n\\int {x}^{10}\\,\\text{d}x=\\frac{{x}^{10+1}}{10+1}+C=\\frac{{x}^{11}}{11}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{11}\\frac{\\text{d}}{\\text{d}x}({x}^{11})+0 & = \\\\ \\frac{1}{11}\\cdot 11{x}^{10} & = \\\\ {x}^{10}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261322 :knowledge-point/_questions [{:knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "439b80ae-8cdc-554f-8cdb-579fa8640aac" :answer/type {:db/ident :answer.type/math} :answer/value "-8x+C" :db/id #edb/ref 17592186261324}] :answer-field/correct {:answer/id #uuid "439b80ae-8cdc-554f-8cdb-579fa8640aac" :answer/type {:db/ident :answer.type/math} :answer/value "-8x+C" :db/id #edb/ref 17592186261324} :answer-field/id #uuid "2cfd84ea-5f5d-5c42-b7cf-aa218b09592c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4e1d1ce-4716-5c64-92ae-716e4a21fbff" :question/math-academy-id "q-71210" :question/problem "Calculate $\\int (-8)\\,\\text{d}x.$\n\nAnswer: {{answer}}" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-8)\\,\\text{d}x & =-8\\int 1\\,\\text{d}x \\\\  & =-8\\int {x}^{0}\\,\\text{d}x \\\\  & =-8\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =-8\\cdot x+C \\\\  & =-8x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186261331 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32db2457-07c5-5427-8a92-9bd848a6b907" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186261333}] :answer-field/correct {:answer/id #uuid "32db2457-07c5-5427-8a92-9bd848a6b907" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186261333} :answer-field/id #uuid "42e70d83-930f-5340-bd0c-7bd247ddc733" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261332}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "37f69159-8a56-5bc8-8f1b-0361b230c90b" :question/math-academy-id "q-71525" :question/problem "Find the slope of the normal line to the curve $y=2{x}^{3}-x+3$ at the point $(1,4).$\n\nAnswer: {{answer}}" :question/worked-solution "Let $f(x)=2{x}^{3}-x+3.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-x+3)=6{x}^{2}-1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,4):$\n\n$$\n\\begin{aligned}m={f}^{'}(1)=6(1)-1=5\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{'}$ is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$"}] [{:db/id #edb/ref 17592186261334 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1eb68a-e252-5e78-a0ae-e38739c43457" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261336}] :answer-field/correct {:answer/id #uuid "2e1eb68a-e252-5e78-a0ae-e38739c43457" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261336} :answer-field/id #uuid "8baad589-7eab-517d-90c5-8bf0ac079d1a" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261335} {:answer-field/choices [{:answer/id #uuid "0d7aaa54-efcb-5abb-8a7e-be2121262538" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186261338}] :answer-field/correct {:answer/id #uuid "0d7aaa54-efcb-5abb-8a7e-be2121262538" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186261338} :answer-field/id #uuid "d3e89ab2-4682-5c69-9be4-fd67450d1798" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261337}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a51e04ce-0c90-5337-b907-f8c65ca8414a" :question/math-academy-id "q-71542" :question/problem "Find where the normal line to the curve $f(x)=3{x}^{2}-4x+1$ at the point $(2,5)$ intersects the $y$-axis.\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-4x+1)=6x-4.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(2)=6(2)-4=8,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-5 & =-\\frac{1}{8}(x-2) \\\\ y & =-\\frac{1}{8}x+\\frac{1}{4}+5 \\\\ y & =-\\frac{1}{8}x+\\frac{21}{4}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{8}\\cdot 0+\\frac{21}{4} \\\\ y & =\\frac{21}{4}.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $(0,\\frac{21}{4}).$"}] [{:db/id #edb/ref 17592186261362 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f11eb26c-78e2-5d5f-99c1-28061148f43b" :answer/type {:db/ident :answer.type/math} :answer/value "(2+6{x}^{2}){5}^{x+{x}^{3}}\\operatorname{ln}5" :db/id #edb/ref 17592186261364}] :answer-field/correct {:answer/id #uuid "f11eb26c-78e2-5d5f-99c1-28061148f43b" :answer/type {:db/ident :answer.type/math} :answer/value "(2+6{x}^{2}){5}^{x+{x}^{3}}\\operatorname{ln}5" :db/id #edb/ref 17592186261364} :answer-field/id #uuid "f0afac87-5527-5858-9ed1-42c75fe593a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261363}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6b813cb6-e4a2-5067-a95c-39437dc6fa6f" :question/math-academy-id "q-71881" :question/problem "Given that $y=2\\cdot {5}^{x+{x}^{3}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=2\\cdot {5}^{u},\\,u=x+{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=2\\cdot {5}^{u}\\operatorname{ln}5,\\,\\frac{\\text{d}u}{\\text{d}x}=1+3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2\\cdot {5}^{u}\\operatorname{ln}5\\cdot (1+3{x}^{2}) \\\\  & =(1+3{x}^{2})\\cdot 2\\cdot {5}^{u}\\operatorname{ln}5 \\\\  & =(2+6{x}^{2}){5}^{x+{x}^{3}}\\operatorname{ln}5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261570 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ca055ce-2958-54d3-b362-468dfb5f63ea" :knowledge-point/title "Determining Whether a Constant Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60848fc6-9815-5a84-9685-23d15ae5a995" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261572} {:answer/id #uuid "6da93657-2a94-5e85-b951-99d639f9bda3" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186261573}] :answer-field/correct {:answer/id #uuid "60848fc6-9815-5a84-9685-23d15ae5a995" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261572} :answer-field/id #uuid "66ac0be6-6684-550f-8d5f-5fd3e9e13f6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261571}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9f2a5a3d-c14f-568e-bca3-40489a2b109e" :question/math-academy-id "q-75010" :question/problem "Consider the series ${\\sum }_{n=1}^{\\infty }(-\\sqrt{5}).$ Does it converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =-\\sqrt{5} \\\\ {s}_{2} & =-\\sqrt{5}+(-\\sqrt{5})=-2\\sqrt{5} \\\\ {s}_{3} & =-\\sqrt{5}+(-\\sqrt{5})+(-\\sqrt{5})=-3\\sqrt{5} \\\\ {s}_{4} & =-\\sqrt{5}+(-\\sqrt{5})+(-\\sqrt{5})+(-\\sqrt{5})=-4\\sqrt{5}\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum is \n\n$$\n{s}_{n}=-\\sqrt{5}\\,n.\n$$\n\nThe sequence of partial sums is divergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }(-\\sqrt{5}\\,n)=-\\infty \n$$\n\nTherefore, the series ${\\sum }_{n=1}^{\\infty }(-\\sqrt{5})$ is also divergent."}] [{:db/id #edb/ref 17592186261574 :knowledge-point/_questions [{:knowledge-point/id #uuid "9afc8277-0fcd-5fdd-9ced-a8de9e5d4168" :knowledge-point/title "Determining Whether a Piecewise Infinite Series Converges or Diverges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c93bf3-207c-59ce-a1b9-e78bffd77c61" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261576} {:answer/id #uuid "f17b3011-3910-51b9-b03b-b12b6857b9f5" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186261577}] :answer-field/correct {:answer/id #uuid "62c93bf3-207c-59ce-a1b9-e78bffd77c61" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186261576} :answer-field/id #uuid "c4cbd5f5-4303-5bab-a71c-9e19c41003cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261575}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6c03b37-a458-5686-aa0d-f791bd5b116f" :question/math-academy-id "q-75133" :question/problem "Given that the sequence ${a}_{n}$ is defined by\n\n$$\n{a}_{n}={\\begin{aligned}0,\\,n=1 \\\\ 1,\\,n=2 \\\\ -2,\\,n\\ge 3,\\end{aligned}\n$$\n\ndoes ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge? If it converges, what is the sum of the series?" :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =0 \\\\ {s}_{2} & =0+1=1 \\\\ {s}_{3} & =1-2=-1 \\\\ {s}_{4} & =-1-2=-3 \\\\ {s}_{5} & =-3-2=-5\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $n\\ge 3$ is\n\n$$\n{s}_{n}=1-2(n-2)=5-2n.\n$$\n\nThe sequence of partial sums is divergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }(5-2n)=-\\infty \n$$\n\nTherefore, the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ diverges."}] [{:db/id #edb/ref 17592186261578 :knowledge-point/_questions [{:knowledge-point/id #uuid "2954b59f-d701-502f-963b-b62098a87c34" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b94b13f9-7a1a-550f-a64c-b7417d391efe" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261580}] :answer-field/correct {:answer/id #uuid "b94b13f9-7a1a-550f-a64c-b7417d391efe" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261580} :answer-field/id #uuid "5ac99111-4cfe-5110-ae08-6fd3410179bf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261579}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c1cd2129-a959-502d-807d-9a8a76abff61" :question/math-academy-id "q-75626" :question/problem "Calculate the sum to infinity of the geometric series $2.1+0.63+0.189+0.056\\,7+⋯$\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=2.1$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.63}{2.1}=0.3.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{2.1}{1-0.3} \\\\  & =\\frac{2.1}{0.7} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261581 :knowledge-point/_questions [{:knowledge-point/id #uuid "2954b59f-d701-502f-963b-b62098a87c34" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9458b0d4-8d31-555b-a01c-fe2986e57d4d" :answer/type {:db/ident :answer.type/math} :answer/value "12.8" :db/id #edb/ref 17592186261583}] :answer-field/correct {:answer/id #uuid "9458b0d4-8d31-555b-a01c-fe2986e57d4d" :answer/type {:db/ident :answer.type/math} :answer/value "12.8" :db/id #edb/ref 17592186261583} :answer-field/id #uuid "25dbef3a-b117-5f99-b906-3d759d8ef1a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261582}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3d0cbb3a-0823-5976-9f6e-21a39f72136a" :question/math-academy-id "q-75633" :question/problem "Calculate the sum to infinity of the geometric series $3.2+2.4+1.8+1.35+⋯$\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=3.2$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{2.4}{3.2}=0.75.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{3.2}{1-0.75} \\\\  & =\\frac{3.2}{0.25} \\\\  & =12.8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261631 :knowledge-point/_questions [{:knowledge-point/id #uuid "6764008e-8336-58de-a8b1-eff2155d4e03" :knowledge-point/title "Expressing a Position Vector in Component Form Given Its Endpoints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbf83590-b75f-5d36-84ac-19d920e44f61" :answer/type {:db/ident :answer.type/math} :answer/value "2i-4j+4k" :db/id #edb/ref 17592186261633}] :answer-field/correct {:answer/id #uuid "bbf83590-b75f-5d36-84ac-19d920e44f61" :answer/type {:db/ident :answer.type/math} :answer/value "2i-4j+4k" :db/id #edb/ref 17592186261633} :answer-field/id #uuid "6cc2f308-2928-57e0-b876-679cef020c06" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261632}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a373b5a2-e4aa-5944-93f9-4a1f70035d92" :question/math-academy-id "q-76880" :question/problem "Let $P(1,0,-2)$ and $Q(3,-4,2).$ Find $\\overset{\\to }{PQ}$ in terms of $i,$ $j$ and $k.$\n\nAnswer: {{answer}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i-2k, \\\\  & \\overset{\\to }{OQ}=q=3i-4j+2k.\\end{aligned}\n$$\n\nNow, we can express $\\overset{\\to }{PQ}$ as the difference of position vectors, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(3i-4j+2k)-(i-2k) \\\\  & =2i-4j+4k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261634 :knowledge-point/_questions [{:knowledge-point/id #uuid "6764008e-8336-58de-a8b1-eff2155d4e03" :knowledge-point/title "Expressing a Position Vector in Component Form Given Its Endpoints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd071317-47a6-5099-9395-05b54ac0843c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,3,0⟩" :db/id #edb/ref 17592186261636}] :answer-field/correct {:answer/id #uuid "bd071317-47a6-5099-9395-05b54ac0843c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,3,0⟩" :db/id #edb/ref 17592186261636} :answer-field/id #uuid "3e2d9efe-fd4a-54c2-b83f-f24f4dde200c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261635}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f997d697-4e5a-59c7-b800-30897846e2e0" :question/math-academy-id "q-76881" :question/problem "Let $M(5,0,-1)$ and $N(8,3,-1).$ Find $\\overset{\\to }{MN}$ in angle bracket notation.\n\nAnswer: {{answer}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OM}=m=5i-k, \\\\  & \\overset{\\to }{ON}=n=8i+3j-k.\\end{aligned}\n$$\n\nNow, we can express $\\overset{\\to }{MN}$ as the difference of position vectors, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{MN} & =n-m \\\\  & =(8i+3j-k)-(5i-k) \\\\  & =3i+3j+0k \\\\  & =⟨3,3,0⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261637 :knowledge-point/_questions [{:knowledge-point/id #uuid "d14332ef-f2e1-5152-9af4-b30378097950" :knowledge-point/title "Calculating Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "565aba6d-9a77-55aa-b3ff-4905d5280491" :answer/type {:db/ident :answer.type/math} :answer/value "-3i+3j+3k" :db/id #edb/ref 17592186261639}] :answer-field/correct {:answer/id #uuid "565aba6d-9a77-55aa-b3ff-4905d5280491" :answer/type {:db/ident :answer.type/math} :answer/value "-3i+3j+3k" :db/id #edb/ref 17592186261639} :answer-field/id #uuid "b7cc5ecc-cfad-5899-9a07-2446709eeab9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261638}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a8e4b80a-935e-5578-8ba3-385529c98dce" :question/math-academy-id "q-76883" :question/problem "If $u=i-j-k$, then $-3u=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute the product, we just multiply each component individually:\n\n$$\n\\begin{aligned}-3u & =-3\\cdot (i-j-k) \\\\  & =-3\\cdot i-3\\cdot (-j)-3\\cdot (-k) \\\\  & =-3i+3j+3k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261640 :knowledge-point/_questions [{:knowledge-point/id #uuid "d14332ef-f2e1-5152-9af4-b30378097950" :knowledge-point/title "Calculating Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "979da310-904c-580e-bb6e-d93cf6a4223e" :answer/type {:db/ident :answer.type/math} :answer/value "10i-2k" :db/id #edb/ref 17592186261642}] :answer-field/correct {:answer/id #uuid "979da310-904c-580e-bb6e-d93cf6a4223e" :answer/type {:db/ident :answer.type/math} :answer/value "10i-2k" :db/id #edb/ref 17592186261642} :answer-field/id #uuid "2b0e8e05-b7ec-526c-93d9-21e3443c74e8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261641}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ed8b2de2-9237-5fd9-92df-b6c14b75334e" :question/math-academy-id "q-76884" :question/problem "If $u=5i-k$, then $2u=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute the product, we just multiply each component individually:\n\n$$\n\\begin{aligned}2u & =2\\cdot (5i-k) \\\\  & =2\\cdot (5i)+2\\cdot (-k) \\\\  & =10i-2k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262109 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8166bb-3a9d-5808-af53-a18ca99920f8" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ec7bfd3-8f80-5b87-aa75-1ec8afd1b0ec" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186262111}] :answer-field/correct {:answer/id #uuid "7ec7bfd3-8f80-5b87-aa75-1ec8afd1b0ec" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186262111} :answer-field/id #uuid "ec1a2131-1d28-5ffa-8e30-33f1d353ae90" :answer-field/key "b" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262110}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "70cc7789-9f93-5c83-af83-334149cbeb2c" :question/math-academy-id "q-97980" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{sin}(\\frac{1}{3}x-\\frac{\\pi }{3})=-1\n$$\n\n \n\nThe general solution of this equation can be expressed as\n\n$$\nx=b\\pi +6n\\pi ,\n$$\n\nwhere $n$ is any integer. What could be the value of $b?$\n\n$b =$: {{b}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{1}{3}x-\\frac{\\pi }{3} & =-\\frac{\\pi }{2}+2n\\pi .\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get:\n\n$$\n\\begin{aligned}\\frac{1}{3}x & =\\frac{\\pi }{3}-\\frac{\\pi }{2}+2n\\pi  \\\\ \\frac{1}{3}x & =-\\frac{\\pi }{6}+2n\\pi  \\\\ x & =-\\frac{\\pi }{2}+6n\\pi \\end{aligned}\n$$\n\nTherefore, we have that $b=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186262115 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1013782-3d79-51a2-9739-3f2e166b9f97" :answer/type {:db/ident :answer.type/math} :answer/value "350" :db/id #edb/ref 17592186262117}] :answer-field/correct {:answer/id #uuid "c1013782-3d79-51a2-9739-3f2e166b9f97" :answer/type {:db/ident :answer.type/math} :answer/value "350" :db/id #edb/ref 17592186262117} :answer-field/id #uuid "c5bb9771-544b-5e26-b5f1-fe053e541d83" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262116}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "579b5dc7-11ff-5357-9fa6-16fce5adbb8f" :question/math-academy-id "q-98030" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}(x-{20}^{∘})=\\frac{2}{\\sqrt{3}}.\n$$\n\nThe general solution of this equation is\n\n$$\nx={50}^{∘}+{360}^{∘}\\cdot n,\\,x={a}^{∘}+{360}^{∘}\\cdot n,\n$$\n\nwhere $n$ is any integer. What could be the value of $a?$\n\nAnswer: {{answer}}" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}(x-{20}^{∘})=\\frac{\\sqrt{3}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\nx-{20}^{∘}={30}^{∘}+{360}^{∘}\\cdot n,\\,x-{20}^{∘}={330}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}x={20}^{∘}+{30}^{∘}+{360}^{∘}\\cdot n, & \\,x={20}^{∘}+{330}^{∘}+{360}^{∘}\\cdot n \\\\ x={50}^{∘}+{360}^{∘}\\cdot n, & \\,x={350}^{∘}+{360}^{∘}\\cdot n.\\end{aligned}\n$$\n\nSo, we have that $a=350.$"}] [{:db/id #edb/ref 17592186262172 :knowledge-point/_questions [{:knowledge-point/id #uuid "55b978ec-9ec6-5349-a103-0c11d9a904c1" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f02455f8-7263-5aee-b6ca-44c762028d6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186262174}] :answer-field/correct {:answer/id #uuid "f02455f8-7263-5aee-b6ca-44c762028d6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186262174} :answer-field/id #uuid "1921c358-4dd0-59c7-bde4-fa7983f50160" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262173}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e2fe4fd1-88fd-50df-b7b9-458bd013b3aa" :question/math-academy-id "q-9983" :question/problem "Calculate the sum to infinity of the geometric series $10-2+\\frac{2}{5}-\\frac{2}{25}+⋯$\n\nAnswer: {{answer}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=10$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{-2}{10}=-\\frac{1}{5}.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{10}{(1-(-\\frac{1}{5}))} \\\\  & =\\frac{10}{(1+\\frac{1}{5})} \\\\  & =\\frac{10}{(\\frac{6}{5})} \\\\  & =\\frac{50}{6} \\\\  & =\\frac{25}{3}.\\end{aligned}\n$$"}]}
