#{[{:db/id #edb/ref 17592186256632 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993945fd-dc0b-56b1-884f-41e9146edbe4" :answer/type {:db/ident :answer.type/math} :answer/value "-(f(\\sqrt{2}))" :db/id #edb/ref 17592186269542} {:answer/id #uuid "49bef1ca-c6df-5bcb-97d5-3b9ce7230433" :answer/type {:db/ident :answer.type/math} :answer/value "2(f(\\sqrt{2}))" :db/id #edb/ref 17592186269543} {:answer/id #uuid "67ca0fde-e3a1-5db1-a05d-10e6dcacb35d" :answer/type {:db/ident :answer.type/math} :answer/value "f(\\sqrt{2})" :db/id #edb/ref 17592186269544} {:answer/id #uuid "e544d489-4e07-5d4b-8154-0316e0154675" :answer/type {:db/ident :answer.type/math} :answer/value "3(f(\\sqrt{2}))" :db/id #edb/ref 17592186269545} {:answer/id #uuid "7c6ad3bd-e4b0-5b05-abc5-61d167c84878" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(f(\\sqrt{2}))" :db/id #edb/ref 17592186269546}] :answer-field/correct {:answer/id #uuid "67ca0fde-e3a1-5db1-a05d-10e6dcacb35d" :answer/type {:db/ident :answer.type/math} :answer/value "f(\\sqrt{2})" :db/id #edb/ref 17592186269544} :answer-field/id #uuid "7db4f32c-bf57-505d-b7d8-9699cb2e066f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274183}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d7bd088-f78b-52b5-add1-d0b106096967" :question/math-academy-id "q-104149" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=\\sqrt{2}?$\n\n$$\nf(x)={\\begin{aligned}-\\frac{4}{{x}^{2}-2}, & x<\\sqrt{2} \\\\ \\frac{4}{{x}^{2}-2}, & x>\\sqrt{2}\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=\\sqrt{2}.$\n\n- We have that $f(\\sqrt{2})$ is not defined since $x=\\sqrt{2}$ does not belong to the domain of $f(x).$ $\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=\\sqrt{2}$ because $f(\\sqrt{2})$ does not exist."}] [{:db/id #edb/ref 17592186256635 :knowledge-point/_questions [{:knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "856468f9-caf6-5f34-b830-c62938d70b7f" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269547} {:answer/id #uuid "dd5cc4bc-a5b1-566d-b70c-c6dfb8f537c2" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269548} {:answer/id #uuid "2bc14897-abd8-5365-90ee-3478ca818463" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186269549} {:answer/id #uuid "c0e40296-7b42-5452-a6fa-f82cecc707ec" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269550} {:answer/id #uuid "8e4d9d96-b4df-56b1-b605-203bc43dabfa" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269551}] :answer-field/correct {:answer/id #uuid "856468f9-caf6-5f34-b830-c62938d70b7f" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269547} :answer-field/id #uuid "e2f80684-edc5-5f46-8641-18bf308dc11a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274184}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "146303a4-6968-5cfe-bc52-997b521163c5" :question/math-academy-id "q-104159" :question/problem "If $f(x)$ is continuous at $x=\\sqrt{3}$ and ${lim}_{x\\to {\\sqrt{3}}^{\\,-}}f(x)=9,$ then what is $f(\\sqrt{3})?$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=\\sqrt{3}.$ According to the definition of continuity, this means that ${lim}_{x\\to \\sqrt{3}}f(x)$ exists, and\n\n$$\nf(\\sqrt{3})={lim}_{x\\to \\sqrt{3}}f(x)={lim}_{x\\to {\\sqrt{3}}^{\\,-}}f(x)=9.\n$$"}] [{:db/id #edb/ref 17592186256638 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff9486fe-3ee1-5917-88de-97251c889552" :knowledge-point/title "Determining Whether a Function is Left- or Right-Continuous From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4bab77-fdd1-502b-aea3-1db5dacc68a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3)" :db/id #edb/ref 17592186269552} {:answer/id #uuid "8b75efdd-4b3a-573e-92f6-3b36588d47c8" :answer/type {:db/ident :answer.type/math} :answer/value "3(3)" :db/id #edb/ref 17592186269553} {:answer/id #uuid "2a7db0f3-aab5-5250-83f8-ac81876c2bc8" :answer/type {:db/ident :answer.type/math} :answer/value "2(3)" :db/id #edb/ref 17592186269554} {:answer/id #uuid "55ee60ef-85a9-58eb-b8ce-da20b3e79395" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269555} {:answer/id #uuid "5cfb07fb-ec43-5dac-95f1-b9065e16f476" :answer/type {:db/ident :answer.type/math} :answer/value "-(3)" :db/id #edb/ref 17592186269556}] :answer-field/correct {:answer/id #uuid "55ee60ef-85a9-58eb-b8ce-da20b3e79395" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269555} :answer-field/id #uuid "e647cff5-b3d6-5ed2-8445-74a6bd02fe50" :answer-field/key "x" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274185}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c868e391-1415-56f9-8288-1cafe3a76a66" :question/math-academy-id "q-104247" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/8dbc5d9ca713eadced5cdf2c3616bab04e6a7f5a88f305b6d9abb3e6b89f7463.png)\n\nAt which points is the function $y=f(x)$ above left-continuous but is not continuous?" :question/worked-solution "To determine whether $f(x)$ is left-continuous at $x=c,$ we need to check whether the left-sided limit is equal to the function value.\n\nLet's check this for $x=0$, at $x=2$ and at  $x=3.$\n\n- At $x=0$ the function is not left-continuous because \n\n$$\n{lim}_{x\\to \\,{0}^{-}}f(x)=3\\ne 2=f(0).\n$$\n\n- At $x=2$ the function is not left-continuous because \n\n$$\n{lim}_{x\\to \\,{2}^{-}}f(x)=0\\ne -2=f(2).\n$$\n\n- At $x=3$ the function is left-continuous because\n\n$$\n{lim}_{x\\to \\,{3}^{-}}f(x)=1=f(3).\n$$\n\nTherefore, the correct answer is $x=3$ only."}] [{:db/id #edb/ref 17592186256695 :knowledge-point/_questions [{:knowledge-point/id #uuid "969d32c6-b343-5e1f-9521-94ff346645b3" :knowledge-point/title "Identifying Correct Limits of a Given Function when Simplification is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0065993-5db1-59b7-b027-72e0e57586de" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186256697} {:answer/id #uuid "5e1463bc-1f3b-5336-a780-7bc5670543e0" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186256698} {:answer/id #uuid "ae643bc0-1d01-5856-baa8-16a8ad37ccc7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186256699} {:answer/id #uuid "2f05f808-bfc8-53eb-aa7f-a85bd2ed8eae" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186256700} {:answer/id #uuid "1854f7ef-55c8-5515-b0b5-534e35b760f1" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186256701} {:answer/id #uuid "5067d5e3-0ba8-5ccd-9a52-a879bfff4ca5" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186256702} {:answer/id #uuid "ecdff9dc-3802-5ee7-8876-4d6bd1a9a576" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186256703} {:answer/id #uuid "83f1c6d3-6da2-5556-9017-c5aadc76a5a5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186256704}] :answer-field/correct {:answer/id #uuid "2f05f808-bfc8-53eb-aa7f-a85bd2ed8eae" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186256700} :answer-field/id #uuid "c015e4bb-470c-5e78-af9e-eb498bed15fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256696}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6d755804-fa3d-550b-b69e-19c5ae177d05" :question/math-academy-id "q-107412" :question/problem "Given that $f(x)=\\frac{2{x}^{2}+3x-2}{4-{x}^{2}},$ which of the following statements is correct?\n\nI. - ${lim}_{x\\to {2}^{+}}f(x)=-\\infty $\nII. - ${lim}_{x\\to (-2)^{+}}f(x)=\\infty $\nIII. - ${lim}_{x\\to {2}^{-}}f(x)=-\\infty $" :question/worked-solution "First, let's factor the numerator and denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}+3x-2}{4-{x}^{2}} \\\\  & =-\\frac{(x+2)(2x-1)}{(x-2)(x+2)}\\end{aligned}\n$$\n\nTherefore, the domain is  $x\\ne \\pm 2,$ and we notice that the function can be simplified:\n\n$$\n\\begin{aligned}f(x)=-\\frac{2x-1}{x-2}.\\end{aligned}\n$$\n\nNow we see that the function has the only vertical asymptote $x=2.$ So statement II is false.\n\nTo find  ${lim}_{x\\to {2}^{+}}f(x)$ and ${lim}_{x\\to {2}^{-}}f(x),$ we evaluate $f(x)$ at $x$-values very close to $x=2$ from the left and right.\n\n| $x$ | $1.99$ | $1.999$ | $2$ | $2.001$ | $2.01$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $298$ | $2\\,998$ | $\\text{undefined}$ | $-3\\,002$ | $-302$ |\n\nAll values are positive and get larger and larger as $x\\to 2$ from the left and all values are negative and get smaller and smaller as $x\\to 2$ from the right . Therefore, \n\n$$\n{lim}_{x\\to {2}^{+}}f(x)=-\\infty \\,{lim}_{x\\to {2}^{-}}f(x)=\\infty \n$$\n\nConsequently, statement I is true and III is false.\n\nIn conclusion, only statement I is correct. A plot of the function is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9e96d6a81813c1c89a498d0206234f2685f0a53c1bab626ce7430d84f9c0f506.png)"}] [{:db/id #edb/ref 17592186256763 :knowledge-point/_questions [{:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "729dee8c-e06d-541d-8f52-d6226fedb772" :answer/type {:db/ident :answer.type/math} :answer/value "(y − x)/(x + 6y)" :db/id #edb/ref 17592186269697} {:answer/id #uuid "2a6a56ab-4db0-5e6f-b034-a6c5be1ff39c" :answer/type {:db/ident :answer.type/math} :answer/value "(6x − y)/(x − 2)" :db/id #edb/ref 17592186269698} {:answer/id #uuid "17491dbb-975a-56f0-9f6c-8d3085c39cd2" :answer/type {:db/ident :answer.type/math} :answer/value "(6x − y)/(x + 2y)" :db/id #edb/ref 17592186269699} {:answer/id #uuid "cc7f4bbc-1b02-59b5-a79c-bf3693c3a1ff" :answer/type {:db/ident :answer.type/math} :answer/value "24y-\\frac{2y\\operatorname{ln}(y)}{x}" :db/id #edb/ref 17592186269700} {:answer/id #uuid "b36d9146-36f5-5854-9714-1bb2dd83b284" :answer/type {:db/ident :answer.type/math} :answer/value "(3x^{2} + y)/(3x + 2y)" :db/id #edb/ref 17592186269701}] :answer-field/correct {:answer/id #uuid "cc7f4bbc-1b02-59b5-a79c-bf3693c3a1ff" :answer/type {:db/ident :answer.type/math} :answer/value "24y-\\frac{2y\\operatorname{ln}(y)}{x}" :db/id #edb/ref 17592186269700} :answer-field/id #uuid "d62df142-e7fb-518f-9d57-192d289e6eea" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274214}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5b263ad9-b2a7-5fb2-9db2-def03733fabf" :question/math-academy-id "q-108505" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}\\operatorname{ln}(y)=8{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}\\operatorname{ln}(y)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}\\operatorname{ln}(y) & =8{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{ln}(y)) & =\\frac{\\text{d}}{\\text{d}x}(8{x}^{3}) \\\\ [({x}^{2})(\\frac{1}{y}\\cdot \\frac{\\text{dy}}{\\text{d}x})+(2x)(\\operatorname{ln}(y))] & =24{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{y}(\\frac{\\text{d}y}{\\text{d}x})+2x\\operatorname{ln}(y) & =24{x}^{2} \\\\ \\frac{{x}^{2}}{y}(\\frac{\\text{d}y}{\\text{d}x}) & =24{x}^{2}-2x\\operatorname{ln}(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y(24{x}^{2}-2x\\operatorname{ln}(y))}{{x}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =24y-\\frac{2y\\operatorname{ln}(y)}{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256769 :knowledge-point/_questions [{:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ece9277-3231-5c0d-8e72-c19b7a238fd8" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(2)" :db/id #edb/ref 17592186269707} {:answer/id #uuid "9419c449-1313-5311-ab67-d288d52e2f02" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(4)" :db/id #edb/ref 17592186269708} {:answer/id #uuid "b92b7bf9-61cc-56b4-85f6-661b90d78790" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(2)" :db/id #edb/ref 17592186269709} {:answer/id #uuid "7e08fcd7-1520-59eb-94f3-10a1081be715" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186269710} {:answer/id #uuid "576e8a8c-0eb1-56f7-9133-1c58f1dbf373" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186269711}] :answer-field/correct {:answer/id #uuid "7e08fcd7-1520-59eb-94f3-10a1081be715" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186269710} :answer-field/id #uuid "4440c369-d3fe-504c-a999-624046d93c1e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274216}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4e293890-de10-5cd4-971c-ec26d5c69bb9" :question/math-academy-id "q-108681" :question/problem "Find the slope of the tangent at the point $(\\frac{1}{2},\\,2)$ for the curve ${x}^{2}{y}^{3}=2.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}{y}^{3}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2) \\\\ {x}^{2}\\frac{\\text{d}}{\\text{d}x}({y}^{3})+{y}^{3}\\frac{\\text{d}}{\\text{d}x}({x}^{2}) & =0 \\\\ 3{x}^{2}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+{y}^{3}\\cdot 2x & =0 \\\\ 3{x}^{2}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+2x{y}^{3} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x{y}^{3}}{3{x}^{2}{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2y}{3x}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{1}{2},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(1/2,\\,2)} \\\\  & ={(-\\frac{2y}{3x})}_{(1/2,\\,2)} \\\\  & =-\\frac{2\\cdot 2}{3\\cdot (\\frac{1}{2})} \\\\  & =-\\frac{8}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257022 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a29d1477-1fbe-50a5-93ee-83bc7198733d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)" :db/id #edb/ref 17592186270092} {:answer/id #uuid "c23e851e-4fc8-5393-89ad-a1c2b6abd0d9" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)" :db/id #edb/ref 17592186270093} {:answer/id #uuid "5ecabcbe-7d04-5005-abb8-376d380c4d9a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186270094} {:answer/id #uuid "a6e8b526-3111-57c4-923d-6147df373d1c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)" :db/id #edb/ref 17592186270095} {:answer/id #uuid "c112f0ea-840e-5ad1-9a6c-943958ca2ae9" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)" :db/id #edb/ref 17592186270096}] :answer-field/correct {:answer/id #uuid "5ecabcbe-7d04-5005-abb8-376d380c4d9a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186270094} :answer-field/id #uuid "51c799a9-2412-52cf-9a9e-2b1fcce297df" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274294}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23c94ac6-51bf-5545-8513-402f0a143fe8" :question/math-academy-id "q-113941" :question/problem "What is ${\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\sqrt{x},$ the lower bound is $a=4$ and the upper bound is $b=9.$ So, we have\n\n$$\nΔx=\\frac{9-4}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(4+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(4+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257073 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06553106-a12c-55fb-812c-e0b0b315f7f5" :answer/type {:db/ident :answer.type/math} :answer/value "(511)/(3)" :db/id #edb/ref 17592186270147} {:answer/id #uuid "86a1de37-572c-5e18-a0da-fb5327fd0535" :answer/type {:db/ident :answer.type/math} :answer/value "(529)/(3)" :db/id #edb/ref 17592186270148} {:answer/id #uuid "036dfa90-10a1-5de8-beab-810972593003" :answer/type {:db/ident :answer.type/math} :answer/value "(511)/(6)" :db/id #edb/ref 17592186270149} {:answer/id #uuid "c82bb0ca-db63-58f5-a235-e41d3e9c705d" :answer/type {:db/ident :answer.type/math} :answer/value "(255)/(6)" :db/id #edb/ref 17592186270150} {:answer/id #uuid "edc8c44c-9813-5bb4-97ea-a07db1c2b7d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\pi +4}{12}" :db/id #edb/ref 17592186270151}] :answer-field/correct {:answer/id #uuid "edc8c44c-9813-5bb4-97ea-a07db1c2b7d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\pi +4}{12}" :db/id #edb/ref 17592186270151} :answer-field/id #uuid "8a45c653-67a6-5187-b484-12b0dbb9a2f4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274305}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9e33d82b-67b7-5f1d-84c4-6afcc46ec7f6" :question/math-academy-id "q-114209" :question/problem "${\\int }_{0}^{1}(\\frac{3}{1+{t}^{2}}+{t}^{2})\\text{d}t=$" :question/worked-solution "We split the integral into the sum of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{3}{1+{t}^{2}}+{t}^{2})\\text{d}t & =3{\\int }_{0}^{1}\\frac{1}{1+{t}^{2}}\\,\\text{d}t+{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t \\\\  & =3\\operatorname{arctan}t\\,{|}_{0}^{1}+\\frac{1}{3}{t}^{3}\\,{|}_{0}^{1} \\\\  & =3(\\operatorname{arctan}1-\\operatorname{arctan}0)+\\frac{1}{3}({1}^{3}-{0}^{1}) \\\\  & =3(\\frac{\\pi }{4}-0)+\\frac{1}{3}(1-0) \\\\  & =\\frac{3\\pi }{4}+\\frac{1}{3} \\\\  & =\\frac{9\\pi +4}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257116 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fed1761-ceeb-5033-afa2-cb735e6bb96c" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b85f6829-84a8-52bd-a851-877b050f4826" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270172} {:answer/id #uuid "86aca8a2-f7fe-513f-947c-c40ad74f365e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270173} {:answer/id #uuid "c8999e92-bba2-5179-9360-ba488b206d7b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270174} {:answer/id #uuid "4a151041-d89e-5dbe-bf68-8e8b24859960" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270175} {:answer/id #uuid "17825f5f-edbb-5a96-8348-df95f5d17098" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270176}] :answer-field/correct {:answer/id #uuid "86aca8a2-f7fe-513f-947c-c40ad74f365e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270173} :answer-field/id #uuid "6bc9a344-346e-560d-9fc5-2c6bf704bb5b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274310}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1bd10278-9b76-5fcf-980b-136026be1670" :question/math-academy-id "q-114961" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d624edaffd8c90de40041d419cf65bcf8f3af5d31c8d88d1123bd8f3d7555166.png)\n\nWhat is the length of the major axis of the ellipse given above?" :question/worked-solution "The major axis is the longest diameter of the ellipse, which is the line segment bounded by the points $(-3,1)$ and $(5,1).$ So, the length of the major axis is $5-(-3)=8.$"}] [{:db/id #edb/ref 17592186257134 :knowledge-point/_questions [{:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0fce35b-dea5-5fa0-915b-14d76c22527c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac34(x-2)^2+4" :db/id #edb/ref 17592186270192} {:answer/id #uuid "8709881b-83e9-54b1-9114-9945ac274319" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270193} {:answer/id #uuid "993c66db-4485-5a71-b899-3bd5a69c5cf4" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270194} {:answer/id #uuid "72d1f3ec-4258-589b-82d9-11e84123fd2c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270195} {:answer/id #uuid "9d22fe07-a608-5ece-ab09-4690c51631d4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}(-\\frac34(x-2)^2+4)" :db/id #edb/ref 17592186270196}] :answer-field/correct {:answer/id #uuid "f0fce35b-dea5-5fa0-915b-14d76c22527c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac34(x-2)^2+4" :db/id #edb/ref 17592186270192} :answer-field/id #uuid "1b47dac2-6abb-5629-98e5-0416c1e1241f" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274314}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c976869-dd96-5219-84a7-962a7edc295e" :question/math-academy-id "q-115511" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(2,4)$ and which passes through the point $(4,1).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,4).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,1),$ so we can substitute $x=4$ and $y=1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (4-2)^{2} & =4p(1-4) \\\\ 4 & =-12p \\\\ p & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (x-2)^{2} & =4(-\\frac{1}{3})(y-4) \\\\ (x-2)^{2} & =-\\frac{4}{3}(y-4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257137 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd1affad-aac1-5f71-abc2-e17afaf89d16" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186270197} {:answer/id #uuid "caec6b2c-24a6-5dbe-ab39-ac4d491e4d40" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270198} {:answer/id #uuid "4b3160db-7c87-5309-a550-cb906c5abaf9" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2)" :db/id #edb/ref 17592186270199} {:answer/id #uuid "fc22cf53-47c5-5114-bf6a-c6a7b024abc5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270200} {:answer/id #uuid "eaa62684-cb40-51ab-a2d2-2ac7df8c3978" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270201}] :answer-field/correct {:answer/id #uuid "eaa62684-cb40-51ab-a2d2-2ac7df8c3978" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270201} :answer-field/id #uuid "8cfa4a37-c11b-5883-a992-df449d0529e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274315}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "724e9328-9953-5c76-8644-8a4bbc630b36" :question/math-academy-id "q-115521" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{{ln}^{2}x}{x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to \\infty }{ln}^{2}x=\\infty $ and ${lim}_{x\\to \\infty }x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{ln}^{2}x}{x} & ={lim}_{x\\to \\infty }\\frac{[{ln}^{2}x]^{'}}{{[x]}^{'}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2\\operatorname{ln}x}{x})}{1} \\\\  & =-{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}x}{x}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{(\\operatorname{ln}x)^{2}}{x} & ={lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}x}{x} \\\\  & ={lim}_{x\\to \\infty }\\frac{[2\\operatorname{ln}x]^{'}}{[x]^{'}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{x})}{1} \\\\  & =2{lim}_{x\\to \\infty }\\frac{1}{x} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257140 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfe08af3-9704-5e34-97e2-1aa68fc3c348" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186270202} {:answer/id #uuid "ce2b96f3-c9b9-54ca-b986-5ec4d3aed756" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186270203} {:answer/id #uuid "025d1d83-3ee2-5d6d-bb9c-af4c59e5aa3d" :answer/type {:db/ident :answer.type/math} :answer/value "(0)+2" :db/id #edb/ref 17592186270204} {:answer/id #uuid "18b8d918-820b-5439-8f53-644696af8917" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270205} {:answer/id #uuid "b1695ed7-f357-5f83-801b-2b7f340dce7a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270206}] :answer-field/correct {:answer/id #uuid "b1695ed7-f357-5f83-801b-2b7f340dce7a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270206} :answer-field/id #uuid "b3ff889b-f3b1-5a56-9630-3a89e66f8d99" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274316}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bb5aa37c-ec5b-54e4-abf6-b459e31e9391" :question/math-academy-id "q-115525" :question/problem "Evaluate ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{ln}(\\operatorname{cos}x)}{\\operatorname{tan}x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{ln}(\\operatorname{cos}x)=-\\infty $ and ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{tan}x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{ln}(\\operatorname{cos}x)}{\\operatorname{tan}x} & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{[\\operatorname{ln}(\\operatorname{cos}x)]^{'}}{{[\\operatorname{tan}x]}^{'}} \\\\  & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{(-\\frac{\\operatorname{sin}x}{\\operatorname{cos}x})}{{sec}^{2}x} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{(\\frac{\\operatorname{sin}x}{\\operatorname{cos}x})}{(\\frac{1}{{cos}^{2}x})} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{sin}x{cos}^{2}x}{\\operatorname{cos}x} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{sin}x\\operatorname{cos}x \\\\  & =-\\operatorname{sin}(\\frac{\\pi }{2})\\operatorname{cos}(\\frac{\\pi }{2}) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257143 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be56301-fd46-5b02-aad1-6b56ce8cb3d1" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186270207} {:answer/id #uuid "5a41f7be-8b5d-54c8-9ea6-55969116627b" :answer/type {:db/ident :answer.type/math} :answer/value "− 4" :db/id #edb/ref 17592186270208} {:answer/id #uuid "ac6cbb12-f76d-56e4-a66e-2db749b109c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186270209} {:answer/id #uuid "84df5cf7-a0b7-511d-bfc3-1c76de65c301" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270210} {:answer/id #uuid "65902239-f558-52f8-826d-950e7186d7c3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270211}] :answer-field/correct {:answer/id #uuid "ac6cbb12-f76d-56e4-a66e-2db749b109c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186270209} :answer-field/id #uuid "6ed0e9fe-c4e4-509d-b26e-3c1e74a668e6" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274317}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "96a5dc35-6a1c-5615-a025-affa6405f5ff" :question/math-academy-id "q-115529" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}2x}{\\operatorname{cot}x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{cot}2x=\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{cot}x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}2x}{\\operatorname{cot}x} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{cot}2x]^{'}}{[\\operatorname{cot}x]^{'}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(-2{csc}^{2}2x)}{-{csc}^{2}x} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{2\\cdot (\\frac{1}{{sin}^{2}2x})}{(\\frac{1}{{sin}^{2}x})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{2{sin}^{2}x}{{sin}^{2}2x} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{2{sin}^{2}x}{{(2\\operatorname{sin}x\\operatorname{cos}x)}^{2}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{2{sin}^{2}x}{4{sin}^{2}x{cos}^{2}x} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{2\\cancel{{sin}^{2}x}}{4\\cancel{{sin}^{2}x}{cos}^{2}x} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{1}{2{cos}^{2}x} \\\\  & =\\frac{1}{2{cos}^{2}0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257173 :knowledge-point/_questions [{:knowledge-point/id #uuid "dabb3127-172e-5a68-8e27-d22057f8ea8e" :knowledge-point/title "Calculating a Related Rate With a Sphere: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d868c37f-fd39-58dc-b277-90cafc57ddc9" :answer/type {:db/ident :answer.type/math} :answer/value "1.5\\,\\mathrm{cm/s}" :db/id #edb/ref 17592186270252} {:answer/id #uuid "882bdf1a-36bf-58e6-b288-b177a51514b0" :answer/type {:db/ident :answer.type/math} :answer/value "3(1.5\\,\\mathrm{cm/s})" :db/id #edb/ref 17592186270253} {:answer/id #uuid "3c17d8c0-ff9e-54a0-bfbc-264450a9eda3" :answer/type {:db/ident :answer.type/math} :answer/value "2(1.5\\,\\mathrm{cm/s})" :db/id #edb/ref 17592186270254} {:answer/id #uuid "84279bdc-b408-5a8c-a416-fb77ea10ab5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1.5\\,\\mathrm{cm/s})" :db/id #edb/ref 17592186270255} {:answer/id #uuid "348d470f-2ac1-5487-8640-d822b1b943e0" :answer/type {:db/ident :answer.type/math} :answer/value "-(1.5\\,\\mathrm{cm/s})" :db/id #edb/ref 17592186270256}] :answer-field/correct {:answer/id #uuid "d868c37f-fd39-58dc-b277-90cafc57ddc9" :answer/type {:db/ident :answer.type/math} :answer/value "1.5\\,\\mathrm{cm/s}" :db/id #edb/ref 17592186270252} :answer-field/id #uuid "1255b9b0-e160-51f9-a8a1-da4b90c2478d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274326}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b814e78f-cd5b-5605-af13-b03739b1afc4" :question/math-academy-id "q-116735" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/63fe9cf3a61a5cef09f9c19e16a18318338faa6837eeb77b83f49b636157bb95.png)\n\nA sphere is decreasing in volume at a rate of $54\\pi \\,{\\text{cm}}^{3}\\text{/s}.$ Calculate the rate at which the radius of the sphere is decreasing at the moment when the radius is $3\\,\\text{cm}.$" :question/worked-solution "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-54\\pi \\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=3\\,\\text{cm}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=-54\\pi $ and $r=3,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}-54\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (3)^{2} \\\\ -54\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 36\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-1.5.\\end{aligned}\n$$\n\nTherefore, the radius of the sphere is decreasing at a rate of $1.5\\text{ cm/s}$ when the radius is $3\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186257247 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f8fa2b3-ccaa-5390-89fa-03e338cf8690" :knowledge-point/title "Determining the Amplitude of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eb85519-95ee-5595-897b-68c61b42c7e5" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(2)" :db/id #edb/ref 17592186270292} {:answer/id #uuid "0e65a06b-d121-57d2-af3b-1975025cec57" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270293} {:answer/id #uuid "c6ecb60a-0600-5be6-b6bc-fc040dfd0224" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186270294} {:answer/id #uuid "3bddb983-8cf9-5393-8d4a-998cce35d2c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186270295} {:answer/id #uuid "ad88ddcd-e89b-545b-9ddf-42c87ba8391c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270296}] :answer-field/correct {:answer/id #uuid "3bddb983-8cf9-5393-8d4a-998cce35d2c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186270295} :answer-field/id #uuid "a164edf5-3c06-5955-97fa-ac47cc7481be" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274334}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "78732451-2db0-5c4e-aa11-0192b0cac8c2" :question/math-academy-id "q-117568" :question/problem "What is the amplitude of the function $f(x)=\\frac{3}{2}\\operatorname{cos}(2x-1)?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{cos}(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=\\frac{3}{2},$ we have that the amplitude is $|A|=|\\frac{3}{2}|=\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186257250 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f8fa2b3-ccaa-5390-89fa-03e338cf8690" :knowledge-point/title "Determining the Amplitude of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0331998-80d2-5bde-af12-978b96f76c4d" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(2)" :db/id #edb/ref 17592186270297} {:answer/id #uuid "0bedbf08-ace7-55ae-b491-2aee795f3abd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186270298} {:answer/id #uuid "7508c9e7-a1e3-5bbc-9826-a0bb85c728ae" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(5)" :db/id #edb/ref 17592186270299} {:answer/id #uuid "1af5a522-1dc9-5845-aa67-c3ebeddd436c" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186270300} {:answer/id #uuid "4ecf0259-9610-5b02-b9d3-1b5201fa54ce" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270301}] :answer-field/correct {:answer/id #uuid "4ecf0259-9610-5b02-b9d3-1b5201fa54ce" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270301} :answer-field/id #uuid "7c1b5325-72ff-5d6d-ada4-5e98da90f34c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274335}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8910d732-402d-5d51-b841-b7875aafc6e4" :question/math-academy-id "q-117575" :question/problem "What is the amplitude of the function $f(x)=-5\\operatorname{sin}(3x-\\pi )-3?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=-5,$ we have that the amplitude is $|A|=|-5|=5.$"}] [{:db/id #edb/ref 17592186257253 :knowledge-point/_questions [{:knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91930684-96f7-53d8-854b-ee1ff239c514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{\\pi }{6})" :db/id #edb/ref 17592186270302} {:answer/id #uuid "cb9f1b80-6983-5d7d-8c0f-3bdfba07792d" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{\\pi }{6})" :db/id #edb/ref 17592186270303} {:answer/id #uuid "80876cae-037d-5b0b-8beb-eaa64d633b5a" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{\\pi }{6})" :db/id #edb/ref 17592186270304} {:answer/id #uuid "cfbfba23-6ae4-5433-88d2-2296f9a5389b" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{\\pi }{6})" :db/id #edb/ref 17592186270305} {:answer/id #uuid "586833c2-e390-5e4d-991f-35e3bf40f803" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186270306}] :answer-field/correct {:answer/id #uuid "586833c2-e390-5e4d-991f-35e3bf40f803" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186270306} :answer-field/id #uuid "ba626645-9fad-5b7d-ad66-8b80252298bf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274336}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "da8a775b-a69b-5a24-98f0-d3d6e285343e" :question/math-academy-id "q-117580" :question/problem "Calculate the period of the function $y=\\operatorname{cos}(12x-\\frac{\\pi }{6}).$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=12.$ Therefore, the period is $\\frac{2\\pi }{12}=\\frac{\\pi }{6}.$"}] [{:db/id #edb/ref 17592186257256 :knowledge-point/_questions [{:knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb8448d2-5372-567d-bcad-35c15d6cd158" :answer/type {:db/ident :answer.type/math} :answer/value "{135}^{∘}" :db/id #edb/ref 17592186270307} {:answer/id #uuid "b9ada19c-f39b-530f-bdb3-be6c51225ee6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({135}^{∘})" :db/id #edb/ref 17592186270308} {:answer/id #uuid "36d632d3-e00f-5c30-a91c-6da3a69700fd" :answer/type {:db/ident :answer.type/math} :answer/value "-({135}^{∘})" :db/id #edb/ref 17592186270309} {:answer/id #uuid "4a897d64-cea5-5410-9e94-faa4134f9457" :answer/type {:db/ident :answer.type/math} :answer/value "2({135}^{∘})" :db/id #edb/ref 17592186270310} {:answer/id #uuid "9e0475b5-fe3f-5d01-b409-8f4fd3a118e9" :answer/type {:db/ident :answer.type/math} :answer/value "3({135}^{∘})" :db/id #edb/ref 17592186270311}] :answer-field/correct {:answer/id #uuid "eb8448d2-5372-567d-bcad-35c15d6cd158" :answer/type {:db/ident :answer.type/math} :answer/value "{135}^{∘}" :db/id #edb/ref 17592186270307} :answer-field/id #uuid "22b3afa0-f0cd-525e-9c97-93cc46a2bea1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274337}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7ecd9674-b0aa-5c61-a990-f67926f0e4db" :question/math-academy-id "q-117583" :question/problem "What is the period of the function $f(x)=\\operatorname{sin}(\\frac{8x}{3}+{20}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{sin}(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=\\frac{8}{3}.$ Therefore, the period is $\\frac{{360}^{∘}}{(\\frac{8}{3})}={135}^{∘}.$"}] [{:db/id #edb/ref 17592186257554 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "695b702c-d849-5fbd-9070-e12b861c5ae8" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186270627} {:answer/id #uuid "3b7f2187-c2b9-5992-9393-6f5aaf7808b3" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186270628} {:answer/id #uuid "792d8f6c-119f-581d-a023-ba79d792dbda" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186270629} {:answer/id #uuid "c00c50f5-5384-5739-8b91-e63ca6df67f9" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186270630} {:answer/id #uuid "cf2360ed-6857-5aa4-9599-bd9614d8502b" :answer/type {:db/ident :answer.type/math} :answer/value "− 10" :db/id #edb/ref 17592186270631}] :answer-field/correct {:answer/id #uuid "c00c50f5-5384-5739-8b91-e63ca6df67f9" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186270630} :answer-field/id #uuid "4da3eea4-8e7c-5837-a6a3-3e3d94913b3a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274401}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c56dbdf4-b093-5a0b-896e-fd12c3e29f0f" :question/math-academy-id "q-123754" :question/problem "For the parametric curve\n\n$$\nx=t-4,\\,\\,\\,y=1-2{t}^{2},\\,0\\le t\\le 4,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $a$ | $-3$ | $-2$ | $-1$ | $0$ |\n| $y$ | $1$ | $-1$ | $b$ | $c$ | $-31$ |\n\n$$\n\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=0$ into $x=t-4.$ This gives\n\n$$\na=0-4=-4.\n$$\n\n- To find the value of $b,$ we substitute $t=2$ into $y=1-2{t}^{2}.$ This gives\n\n$$\nb=1-2(2)^{2}=-7.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=1-2{t}^{2}.$ This gives\n\n$$\nc=1-2(3)^{2}=-17\n$$\n\nFinally, we have\n\n$$\na+b+c=-4+(-7)+(-17)=-28.\n$$"}] [{:db/id #edb/ref 17592186257631 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d138d2c-3295-5eae-990d-42711f5792f1" :knowledge-point/title "Analyzing Statements Involving Sums of Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6940f8b5-519f-52c4-bcac-f863b7c3b82e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257633} {:answer/id #uuid "25867eeb-0029-578e-9ae6-86fdfc9f914d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257634} {:answer/id #uuid "dbd47e54-75b0-5cfc-a0ed-d51f5986b1d4" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257635} {:answer/id #uuid "f7c2455e-888e-590f-95aa-15b1e28f2407" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257636} {:answer/id #uuid "cbd839a1-bff7-5b24-8a00-17e92901903a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257637} {:answer/id #uuid "d4011853-9f03-54b2-96c4-12ff2810ced2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257638} {:answer/id #uuid "daf46227-37b7-5824-b325-ba48e7625ed7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257639} {:answer/id #uuid "49a5bf3c-9ed0-57ba-9f2d-c99903851ecc" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257640}] :answer-field/correct {:answer/id #uuid "6940f8b5-519f-52c4-bcac-f863b7c3b82e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257633} :answer-field/id #uuid "6bf54287-4698-5a94-9cac-64d208e87386" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257632}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a5033c15-e0ed-52f4-b026-2ec54fd36d33" :question/math-academy-id "q-124087" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, which of the following statements are true?\n\nI. - ${\\sum }_{n=100}^{\\infty }{a}_{n}$ is convergent\nII. - $-{10}^{10}{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent\nIII. - ${\\sum }_{n=100}^{\\infty }{a}_{n}-{10}^{10}{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent." :question/worked-solution "Let's recall the properties of convergent series:\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }K\\cdot {a}_{n}=K\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is also convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent and ${\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent, then ${\\sum }_{n=1}^{\\infty }{a}_{n}+{\\sum }_{n=1}^{\\infty }{b}_{n}$ is convergent.\n\n- If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.\n\nWith that in mind, let's analyze each statement:\n\n- Statement I is true. Removing a finite number of terms from a convergent series gives a convergent series.\n\n- Statement II is true. Any constant multiple of a convergent series gives a convergent series.\n\n- Statement III is true. The sum of two convergent series is convergent.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186258044 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6005f9a-3eba-5f8d-909d-894d9cd24d12" :knowledge-point/title "Differentiating a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1659928e-8dcc-5c46-8c0a-8ccef82b97ab" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + x − 2" :db/id #edb/ref 17592186270887} {:answer/id #uuid "0c911388-881e-50a3-b683-d9d1adb0f3ce" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+7x+3" :db/id #edb/ref 17592186270888} {:answer/id #uuid "c1b7b06f-1c7a-51a5-a8a7-21fd42a7552b" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + 2x + 2" :db/id #edb/ref 17592186270889} {:answer/id #uuid "ccfa8ca3-51d0-548c-bc75-a5456098d70e" :answer/type {:db/ident :answer.type/math} :answer/value "− x^{2} + x − 1" :db/id #edb/ref 17592186270890} {:answer/id #uuid "ddb2e3e5-6072-5eef-a918-fc5326143154" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + 2x − 1" :db/id #edb/ref 17592186270891}] :answer-field/correct {:answer/id #uuid "0c911388-881e-50a3-b683-d9d1adb0f3ce" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+7x+3" :db/id #edb/ref 17592186270888} :answer-field/id #uuid "8c700aac-f9b4-5cab-bd6d-55b64fdb2a35" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274453}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f846d5c0-2f2b-5199-8370-0b3c4a4f1f0d" :question/math-academy-id "q-138848" :question/problem "Consider the function $y=\\sqrt{({x}^{2}+6x){sin}^{2}x}.$  The derivative of this function for $x\\in (0,\\pi )$ is given by\n\n$$\n{y}^{'}=\\frac{g(x)\\operatorname{sin}x+h(x)\\operatorname{cos}x}{\\sqrt{{x}^{2}+6x}}.\n$$\n\nFind the function $g(x)+h(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+6x){sin}^{2}x} \\\\  & =\\sqrt{{x}^{2}+6x}\\cdot \\sqrt{{sin}^{2}x} \\\\  & =({x}^{2}+6x)^{1/2}\\operatorname{sin}x.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}y & =\\operatorname{ln}(({x}^{2}+6x)^{1/2}\\operatorname{sin}x) \\\\ \\operatorname{ln}y & =\\operatorname{ln}(({x}^{2}+6x)^{1/2})+\\operatorname{ln}(\\operatorname{sin}x) \\\\ \\operatorname{ln}y & =\\frac{1}{2}\\operatorname{ln}({x}^{2}+6x)+\\operatorname{ln}(\\operatorname{sin}x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}({x}^{2}+6x)+\\operatorname{ln}(\\operatorname{sin}x)) \\\\ \\frac{1}{y}\\cdot {y}^{'} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+6x}\\cdot (2x+6)+\\frac{1}{\\operatorname{sin}x}\\cdot \\operatorname{cos}x \\\\ \\frac{{y}^{'}}{y} & =\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}x\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{'}:$\n\n$$\n\\begin{aligned}{y}^{'} & =y(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+6x){sin}^{2}x}:$\n\n$$\n\\begin{aligned}{y}^{'} & =\\sqrt{({x}^{2}+6x){sin}^{2}x}(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}x) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}x}(\\frac{x+3}{{x}^{2}+6x}+\\frac{\\operatorname{cos}x}{\\operatorname{sin}x}) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}x}(\\frac{(x+3)\\operatorname{sin}x+({x}^{2}+6x)\\operatorname{cos}x}{({x}^{2}+6x)\\operatorname{sin}x}) \\\\  & =\\frac{|\\operatorname{sin}x|}{\\operatorname{sin}x}\\frac{(x+3)\\operatorname{sin}x+({x}^{2}+6x)\\operatorname{cos}x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nGiven that $x\\in (0,\\pi ),$ then $|\\operatorname{sin}x|=\\operatorname{sin}x,$ so the fraction $\\frac{|\\operatorname{sin}x|}{\\operatorname{sin}x}$ simplifies to $1:$\n\n$$\n\\begin{aligned}{y}^{'} & =\\frac{(x+3)\\operatorname{sin}x+({x}^{2}+6x)\\operatorname{cos}x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)+h(x)=x+3+{x}^{2}+6x={x}^{2}+7x+3.\n$$"}] [{:db/id #edb/ref 17592186258132 :knowledge-point/_questions [{:knowledge-point/id #uuid "5fa86dd3-3bb3-54d5-8940-5dc07ae4c99f" :knowledge-point/title "Exponential Growth Functions With Horizontal and Vertical Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c66fe2-55c0-5652-b399-9a83c90d5f1f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258134}] :answer-field/correct {:answer/id #uuid "51c66fe2-55c0-5652-b399-9a83c90d5f1f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258134} :answer-field/id #uuid "f3a192a2-9343-5383-8e4b-3367a8cbe673" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258133} {:answer-field/choices [{:answer/id #uuid "457b69e5-fe27-5686-a4ce-b0533ec2b17a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258136}] :answer-field/correct {:answer/id #uuid "457b69e5-fe27-5686-a4ce-b0533ec2b17a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258136} :answer-field/id #uuid "85e2c635-2fde-5105-9f91-bec0aaf59d2f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258135}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "db023f5c-493e-5e6a-b5ba-9c2ad4393c03" :question/math-academy-id "q-142979" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/f065f31c629cbd21a6beffe013c8786a4e8165f6dff09bde72cd3e61c8ae8a62.png)\n\nThe function $f$ is part of the exponential curve $y={e}^{x-a}+b$ shown in the figure above. Find the values of $a$ and $b.$\n\n$a\\,=\\,$\n{{field-1}}\n$\\,b\\,=\\,$\n{{field-2}}" :question/worked-solution "Recall that the horizontal asymptote of $y={e}^{x-a}+b$ is $y=b.$ \n\nIn the figure above, the horizontal asymptote is $y=3.$ Hence, $b=3.$\n\nNext, we use the point $(5,4)$ to determine the value of $a.$\nSubstituting $(5,4)$ into the equation of the curve, we get\n\n$$\n\\begin{aligned}{e}^{5-a}+3 & =4 \\\\ {e}^{5-a} & =1 \\\\ 5-a & =0 \\\\ a & =5.\\end{aligned}\n$$\n\nTherefore, $a=5$ and $b=3.$"}] [{:db/id #edb/ref 17592186258137 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c5a9d62-eab8-5f09-aeb7-7a9a1c4e6eb1" :knowledge-point/title "Finding a Trigonometric Ratio of a Larger Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8c984c4-5b8a-578c-9f32-dd7cb5796e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}+3" :db/id #edb/ref 17592186258139}] :answer-field/correct {:answer/id #uuid "b8c984c4-5b8a-578c-9f32-dd7cb5796e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}+3" :db/id #edb/ref 17592186258139} :answer-field/id #uuid "3c4d5cb5-6452-5b82-a82b-bf7b5029a030" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258138}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8b028ef-fe60-50c8-bb59-4be283218d8c" :question/math-academy-id "q-142980" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/cced23601cd4ccb10839c503dc8068c7edf9a4f9daa2f83d2263c37abd7fe86d.png)\n\nThe function $g$ is part of the graph of the function $y=\\operatorname{sec}x+3.$ Find the exact value of $y$ when $x=\\frac{13\\pi }{6}.$\n\n$y\\,=\\,$\n{{field-1}}" :question/worked-solution "First, we find an angle that's coterminal with $\\frac{13\\pi }{6}$ that lies in the range $[0,2\\pi ).$\n\n$$\n\\begin{aligned}\\frac{13\\pi }{6}-2\\pi  & =\\frac{\\pi }{6}\\,✓\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sec}(\\frac{13\\pi }{6})=\\operatorname{sec}(\\frac{\\pi }{6}).$\n\nLet's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{\\pi }{6})=\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{sec}(\\frac{\\pi }{6})=\\frac{1}{\\operatorname{cos}(\\frac{\\pi }{6})}=\\frac{1}{(\\frac{\\sqrt{3}}{2})}=\\frac{2}{\\sqrt{3}}.\n$$\n\n \n\nTherefore, $y=\\operatorname{sec}(\\frac{\\pi }{6})+3=\\frac{2}{\\sqrt{3}}+3.$"}] [{:db/id #edb/ref 17592186258140 :knowledge-point/_questions [{:knowledge-point/id #uuid "f9eea0ca-bb7a-5e5c-b2d0-472305f2c490" :knowledge-point/title "Solving a Radical Equation When the Radical Is Not Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1128e265-7219-5e31-98f1-7cc944d3f363" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186258142}] :answer-field/correct {:answer/id #uuid "1128e265-7219-5e31-98f1-7cc944d3f363" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186258142} :answer-field/id #uuid "d4672edf-63c4-5c05-b468-eef9e9e3cb2a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258141}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0ad51429-6a62-5eb4-a98f-df87784728a5" :question/math-academy-id "q-142991" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e1ada2941e9819e75218f9995d1913d535889c71b29efbf39ef73d91f9113205.png)\n\nThe function $h$ is a part of the graph of the function $y=\\frac{2}{3}\\sqrt{x}+3,$ as shown in the figure above. Find the number of weeks $x$ at which the stock price given by this function was $$5,000.$\n\n*Hint: Remember that $h$ is measured in thousands of dollars.*\n\n$x\\,=\\,$\n{{field-1}}" :question/worked-solution "We have to solve $h(x)=5,$ or equivalently, $\\frac{2}{3}\\sqrt{x}+3=5.$\n\nFirst, we isolate the term $\\frac{2}{3}\\sqrt{x}$ by subtracting $3$ from both sides:\n\n$$\n\\begin{aligned}\\frac{2}{3}\\sqrt{x}+3 & =5 \\\\ \\frac{2}{3}\\sqrt{x} & =2\\end{aligned}\n$$\n\nNow, we isolate the square root by multiplying by $\\frac{3}{2}$ on both sides:\n\n$$\n\\begin{aligned}\\frac{2}{3}\\sqrt{x} & =2 \\\\ \\sqrt{x} & =3\\end{aligned}\n$$\n\nNow that the square root is isolated, we can proceed as usual. Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{x} & =3 \\\\ (\\sqrt{x})^{2} & ={3}^{2} \\\\ x & =9.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\frac{2}{3}\\sqrt{9}+3 & \\overset{?}{=}5 \\\\ \\frac{2}{3}\\cdot 3+3 & \\overset{?}{=}5 \\\\ 2+3 & =5\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=9$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\frac{2}{3}\\sqrt{x}+3=5$  is $x=9.$"}] [{:db/id #edb/ref 17592186258143 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbfddefc-d68b-5b1e-9ec5-fd18be204d92" :knowledge-point/title "Identifying Semi-Open Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043022d2-842f-5a0d-a3e6-a7431fabc0f6" :answer/type {:db/ident :answer.type/math} :answer/value "5.4" :db/id #edb/ref 17592186258145}] :answer-field/correct {:answer/id #uuid "043022d2-842f-5a0d-a3e6-a7431fabc0f6" :answer/type {:db/ident :answer.type/math} :answer/value "5.4" :db/id #edb/ref 17592186258145} :answer-field/id #uuid "9355f3c0-18a6-5b69-80a1-0364e00808cf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258144} {:answer-field/choices [{:answer/id #uuid "e5bf4fa7-65cf-5ee1-a4bf-f773b42ad1bb" :answer/type {:db/ident :answer.type/math} :answer/value "5.4" :db/id #edb/ref 17592186258147}] :answer-field/correct {:answer/id #uuid "e5bf4fa7-65cf-5ee1-a4bf-f773b42ad1bb" :answer/type {:db/ident :answer.type/math} :answer/value "5.4" :db/id #edb/ref 17592186258147} :answer-field/id #uuid "1a799249-37a9-557d-b0c5-0430f1083a73" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258146} {:answer-field/choices [{:answer/id #uuid "55261f6a-c49b-5feb-8d2c-d4962026c724" :answer/type {:db/ident :answer.type/math} :answer/value "7.2" :db/id #edb/ref 17592186258149}] :answer-field/correct {:answer/id #uuid "55261f6a-c49b-5feb-8d2c-d4962026c724" :answer/type {:db/ident :answer.type/math} :answer/value "7.2" :db/id #edb/ref 17592186258149} :answer-field/id #uuid "879e8785-e2e8-5bd7-be03-6e8a499faf90" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258148} {:answer-field/choices [{:answer/id #uuid "e76051ca-b880-583d-9253-e1380d6980a3" :answer/type {:db/ident :answer.type/math} :answer/value "7.2" :db/id #edb/ref 17592186258151}] :answer-field/correct {:answer/id #uuid "e76051ca-b880-583d-9253-e1380d6980a3" :answer/type {:db/ident :answer.type/math} :answer/value "7.2" :db/id #edb/ref 17592186258151} :answer-field/id #uuid "1298d7e4-33e3-5bbc-94f9-f7a723b0fb25" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258150}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a1d8e21-fdef-5be3-a0f9-7a1cd257412c" :question/math-academy-id "q-142992" :question/problem "What is the largest union of intervals on which the function describing the stock price is continuous?\n\n$x\\in [\\,\\,0\\,\\,,$\n{{field-1}}$)\\cup $\n$($\n{{field-2}}$\\,,$\n{{field-3}}$)\\cup $\n$($\n{{field-4}}$\\,,\\,\\infty ).$" :question/worked-solution "The function is continuous on the open intervals $(0,5.4)$, $(5.4,7.2)$ and $(7.2,\\infty ).$\n\nAdditionally, the function is right-continuous at $x=0.$ Hence, it is continuous on the interval $[0,5.4).$\n\nTherefore, we can say that the function is continuous on $x\\in [0,5.4)\\cup (5.4,7.2)\\cup (7.2,\\infty ).$"}] [{:db/id #edb/ref 17592186258152 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "640c48ea-eca5-5f5c-bd9f-649c0461679e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186258154}] :answer-field/correct {:answer/id #uuid "640c48ea-eca5-5f5c-bd9f-649c0461679e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186258154} :answer-field/id #uuid "4617226c-d552-56ab-9756-b1e85f92a465" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258153}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "757fea48-6784-5515-8c79-d693e955e14d" :question/math-academy-id "q-142993" :question/problem "Find the derivative of $h(x).$\n\n${h}^{'}(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}y}{\\text{d}x}(\\frac{2}{3}\\sqrt{x}+3) \\\\  & =\\frac{2}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{2}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{2}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{1}{3}{x}^{-1/2} \\\\  & =\\frac{1}{3\\sqrt{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258155 :knowledge-point/_questions [{:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000" :knowledge-point/title "Determining a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e3b4618-9a7e-5db9-979c-581e6614ef24" :answer/type {:db/ident :answer.type/math} :answer/value "1/9" :db/id #edb/ref 17592186258157}] :answer-field/correct {:answer/id #uuid "2e3b4618-9a7e-5db9-979c-581e6614ef24" :answer/type {:db/ident :answer.type/math} :answer/value "1/9" :db/id #edb/ref 17592186258157} :answer-field/id #uuid "3f7aaad1-78f8-517c-9f4a-76f17a311294" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258156}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3b81ed99-9a3f-5dfe-84ce-7ea4d4959a5c" :question/math-academy-id "q-142994" :question/problem "What was the exact rate of change of the stock's value at week $9?$\n\n{{field-1}}$\\,$ thousand dollars per week." :question/worked-solution "The function ${h}^{'}(x)$ models the rate of change of the value of the stock, applicable in the domain of $h(x).$\n\nThus, the rate of change of the value of the stock at $x=9$ weeks is\n\n$$\n\\begin{aligned}{h}^{'}(9) & =\\frac{1}{3\\sqrt{9}} \\\\  & =\\frac{1}{3\\cdot 3} \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$\n\nTherefore, the rate of change in the stock price was $\\frac{1}{9}$ thousand dollars per week."}] [{:db/id #edb/ref 17592186258158 :knowledge-point/_questions [{:knowledge-point/id #uuid "f945ef94-171c-5c19-adb3-f496408dc31b" :knowledge-point/title "Evaluating the Limit at Infinity of a Cube Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "810fcaa7-47c5-5b76-bae0-da51d895db9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186258160}] :answer-field/correct {:answer/id #uuid "810fcaa7-47c5-5b76-bae0-da51d895db9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186258160} :answer-field/id #uuid "a0e303ce-07a6-5eec-befe-7f409b2e02a1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258159}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec42b25b-8544-5fa5-b45c-8cc0ddc4cd34" :question/math-academy-id "q-143040" :question/problem "The broker predicts that, in the future, the stock will have an overall behavior similar to the function $\\sqrt[3]{x}.$ Calculate ${lim}_{x\\to \\infty }\\sqrt[3]{x}.$\n\n${lim}_{x\\to \\infty }\\sqrt[3]{x}=$\n{{field-1}}" :question/worked-solution "Let $k(x)=\\sqrt[3]{x}.$ Let's sketch the graph of $y=k(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9b81a63c0681b10343cf600cdfc17636c797aeb9b15920da4368d26643827ab5.png)\n\nThe graph shows that the function increases without bound as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }k(x)=\\infty .\n$$"}] [{:db/id #edb/ref 17592186258161 :knowledge-point/_questions [{:knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbd3b291-f315-505c-8814-812856363ced" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186258163}] :answer-field/correct {:answer/id #uuid "fbd3b291-f315-505c-8814-812856363ced" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186258163} :answer-field/id #uuid "97e4b732-93bd-528c-a1cf-2c1d29dca6b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5cd2d74d-d1cb-5152-8963-c0880a0c094a" :question/math-academy-id "q-143041" :question/problem "The antiderivative of $\\sqrt[3]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[3]{x}={x}^{1/3}$, we can apply the power rule with $n=\\frac{1}{3}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/3}\\,\\text{d}x & =\\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =\\frac{{x}^{4/3}}{(\\frac{4}{3})}+C \\\\  & =\\frac{3{x}^{4/3}}{4}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{4/3}}{4}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{4/3}}{4})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{3}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4/3})+0 & = \\\\ \\frac{3}{4}\\cdot \\frac{4}{3}{x}^{4/3-1} & = \\\\ {x}^{1/3}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258174 :knowledge-point/_questions [{:knowledge-point/id #uuid "90b485f8-a07d-55f4-8cde-f699070eeae7" :knowledge-point/title "Identifying Monotonic Polynomial and Rational Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c3f0dd1-7101-5e8a-8a4d-def94257f103" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258176} {:answer/id #uuid "c0365355-b02b-554c-81ea-383f5d75c51e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258177} {:answer/id #uuid "07ad044a-9941-5828-9cc0-10232340ffb1" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258178} {:answer/id #uuid "e96e100f-1eee-5783-967e-3be91b260a5e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258179} {:answer/id #uuid "b44a206e-e61a-52c0-8e31-7eb08be8d568" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258180} {:answer/id #uuid "90ce0177-07a5-5771-8645-06d784001a87" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258181} {:answer/id #uuid "a8a2d0f3-dc8a-5d03-aaa4-9fec605441cc" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258182} {:answer/id #uuid "5b5c0b65-3e2c-5da1-9db8-a08c28ba2700" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258183}] :answer-field/correct {:answer/id #uuid "5b5c0b65-3e2c-5da1-9db8-a08c28ba2700" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258183} :answer-field/id #uuid "21f9f03d-b6f6-51d4-ad67-325a813dfd9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258175}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9fa88825-edb5-50fd-b953-cabd8cb91f63" :question/math-academy-id "q-143193" :question/problem "Given that  ${a}_{n}=2{n}^{5}$ for $n\\ge 1,$ which of the following statements are true?\n\nI. - $\\frac{{a}_{n+1}}{{a}_{n}}\\le 1$ for all $n\\ge 1$\nII. - ${a}_{n}$ is an increasing sequence\nIII. - ${a}_{n}$ is a decreasing sequence" :question/worked-solution "Suppose the sequence ${a}_{n}$ is a positive sequence defined for $n\\ge 1,$ and that\n\n$$\nL=\\frac{{a}_{n+1}}{{a}_{n}}.\n$$\n\nThen,\n\n- if $L\\ge 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *increasing,* and\n\n- if $0<L\\le 1$ for all $n\\ge 1,$ then ${a}_{n}$ is *decreasing.*\n\nNotice that, in this case, ${a}_{n}=2{n}^{5}$ is positive for all $n\\ge 1.$\n\nWith that in mind, let's analyze each statement.\n\n- Statement I is false. Computing the ratio $L,$ we get\n\n$$\n\\begin{aligned}L & =\\frac{{a}_{n+1}}{{a}_{n}} \\\\  & =\\frac{2(n+1)^{5}}{2{n}^{5}} \\\\  & =\\frac{(n+1)^{5}}{{n}^{5}} \\\\  & ={(\\frac{n+1}{n})}^{5} \\\\  & ={(\\frac{n}{n}+\\frac{1}{n})}^{5} \\\\  & ={(1+\\frac{1}{n})}^{5}.\\end{aligned}\n$$\n\nNow, since $n\\ge 1,$ we have that $\\frac{1}{n}>0.$ Therefore, it follows that\n\n$$\n(1+\\frac{1}{n})>1,\n$$\n\nand therefore \n\n$$\nL={(1+\\frac{1}{n})}^{5}>1.\n$$\n\n- Statement II is true whereas statement III is false. Since $L\\ge 1$ for all $n\\ge 1,$ we can conclude that the sequence ${a}_{n}$ is increasing.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186258331 :knowledge-point/_questions [{:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6d0cff2-6c0e-557a-91b2-0dbb4bce6a73" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(2)" :db/id #edb/ref 17592186271032} {:answer/id #uuid "9b81c17e-8044-5811-9af5-e2d758beae11" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(4)" :db/id #edb/ref 17592186271033} {:answer/id #uuid "e17d0c45-66f7-55f3-af3c-7569a563bedf" :answer/type {:db/ident :answer.type/math} :answer/value "(3)/(2)" :db/id #edb/ref 17592186271034} {:answer/id #uuid "50942a1a-80af-511f-ace0-9b6a540c64a9" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186271035} {:answer/id #uuid "7b7f81a6-5538-50fb-b2cd-524da7df1bb4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271036}] :answer-field/correct {:answer/id #uuid "7b7f81a6-5538-50fb-b2cd-524da7df1bb4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271036} :answer-field/id #uuid "35851682-45a0-544e-964c-bed7119d0b61" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274482}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d727380b-a283-52ef-aecd-bfe58ab6a644" :question/math-academy-id "q-14527" :question/problem "Find the slope of the tangent at the point $(0,\\,1)$ for the curve $y\\operatorname{cos}(x)=1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $y\\operatorname{cos}(x)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y\\operatorname{cos}(x)) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ y\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}(x))+\\operatorname{cos}(x)\\frac{\\text{d}}{\\text{d}x}(y) & =0 \\\\ y(-\\operatorname{sin}(x))+\\operatorname{cos}(x)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}(x)}{\\operatorname{cos}(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(0,\\,1)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(0,\\,1)} \\\\  & ={\\frac{y\\operatorname{sin}(x)}{\\operatorname{cos}(x)}}_{(0,\\,1)} \\\\  & =\\frac{1\\cdot \\operatorname{sin}(0)}{\\operatorname{cos}(0)} \\\\  & =\\frac{1\\cdot 0}{1} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258334 :knowledge-point/_questions [{:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c" :knowledge-point/title "Determining an Intercept of a Tangent or Normal Line to a Curve Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f96eaba-0946-5733-a20a-ff6cb50a5c3c" :answer/type {:db/ident :answer.type/math} :answer/value "((0)+1,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271037} {:answer/id #uuid "479d08ef-5d5c-5369-b1d6-95640b980265" :answer/type {:db/ident :answer.type/math} :answer/value "((0)-1,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271038} {:answer/id #uuid "074ebab4-0f40-53a2-ae1e-f2d3b50e7c55" :answer/type {:db/ident :answer.type/math} :answer/value "((0)+2,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271039} {:answer/id #uuid "5270e74e-be84-56c9-bfd1-97e0be40058b" :answer/type {:db/ident :answer.type/math} :answer/value "((0)-2,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271040} {:answer/id #uuid "07095fbd-903c-58a9-9186-65b0e9c0be34" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271041}] :answer-field/correct {:answer/id #uuid "07095fbd-903c-58a9-9186-65b0e9c0be34" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\,-\\frac{1}{2})" :db/id #edb/ref 17592186271041} :answer-field/id #uuid "5e619117-8595-5614-85bb-0e2e270e549d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274483}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "02036e78-1a4a-5e3b-a210-404f9710dd18" :question/math-academy-id "q-14614" :question/problem "The equation of a curve is $xy+{x}^{2}=1.$ The normal line at the point $(1,\\,0)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(1,\\,0).$   Remember that the slope of the normal line, ${m}^{'},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{'}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(xy+{x}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(xy)+\\frac{\\text{d}}{\\text{d}x}({x}^{2}) & =0 \\\\ x\\frac{\\text{d}y}{\\text{d}x}+y+2x & =0 \\\\ x\\frac{\\text{d}y}{\\text{d}x} & =-(2x+y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x+y}{x}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(1,\\,0)$ is \n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(1,\\,0)} \\\\  & ={(-\\frac{2x+y}{x})}_{(1,\\,0)} \\\\  & =-\\frac{2\\cdot 1+0}{1} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is ${m}^{'}=-\\frac{1}{m}=-\\frac{1}{-2}=\\frac{1}{2}.$ We can write the equation of the normal at the point $(1,\\,0)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{'}(x-{x}_{1}) \\\\ (y-0) & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}(x-1)\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}(0-1) \\\\ y & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,-\\frac{1}{2}).$"}] [{:db/id #edb/ref 17592186258365 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "750986f7-a3e7-5061-9496-368882ff10ea" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186271081} {:answer/id #uuid "eb1046a2-dfbd-5e8d-b0d0-53a67cfea452" :answer/type {:db/ident :answer.type/math} :answer/value "(0)+1" :db/id #edb/ref 17592186271082} {:answer/id #uuid "11641771-8dd6-5bda-873b-79940b41a848" :answer/type {:db/ident :answer.type/math} :answer/value "(0)+2" :db/id #edb/ref 17592186271083} {:answer/id #uuid "ee778e02-c5fc-5813-951b-61b988c8c3cd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271084}] :answer-field/correct {:answer/id #uuid "ee778e02-c5fc-5813-951b-61b988c8c3cd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271084} :answer-field/id #uuid "631cf0b7-841e-53bd-8ae1-b05bf155fb76" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274492}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "324217ae-8df9-50ab-9ad5-02439e7104ed" :question/math-academy-id "q-152889" :question/problem "${lim}_{x\\to \\,1/2}\\operatorname{tan}(6\\operatorname{arccos}(x))=$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}(x)$ is $x\\in [-1,1].$ \n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1/2}\\operatorname{tan}(6\\operatorname{arccos}(x)) & =\\operatorname{tan}(6\\operatorname{arccos}(\\frac{1}{2})) \\\\  & =\\operatorname{tan}(6\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}(2\\pi ) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258368 :knowledge-point/_questions [{:knowledge-point/id #uuid "8edb0a6c-f22f-56cf-9545-2fae93896db2" :knowledge-point/title "Verifying Continuity at a Point Using the Definition"}] :questi