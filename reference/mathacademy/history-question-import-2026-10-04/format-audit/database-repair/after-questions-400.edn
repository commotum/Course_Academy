swer.type/text} :answer/value "III, IV" :db/id #edb/ref 17592186258382} {:answer/id #uuid "c2d3f792-7bce-5b94-984f-aba7e80ca910" :answer/type {:db/ident :answer.type/text} :answer/value "I, II" :db/id #edb/ref 17592186258383} {:answer/id #uuid "75049880-fd35-5317-930f-662f25d56abc" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, IV" :db/id #edb/ref 17592186258384} {:answer/id #uuid "4523da4d-4d0c-50ec-941f-2b48feb414fa" :answer/type {:db/ident :answer.type/text} :answer/value "II, III, IV" :db/id #edb/ref 17592186258385}] :answer-field/correct {:answer/id #uuid "3c863b61-20ca-5e19-8358-eed9e63d943e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, III, IV" :db/id #edb/ref 17592186258377} :answer-field/id #uuid "5ae82df4-cd7c-58ff-a25e-011cdd4816bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258369}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "02eda226-1684-50b8-a1ed-83b979a1c53a" :question/math-academy-id "q-152912" :question/problem "Consider the following function:\n\n$$\nf(x)={\\begin{aligned}-x-3, & x<-3 \\\\ 0, & x=-3 \\\\ x+3, & x>-3\\end{aligned}\n$$\n\nWhich of the following statements are true regarding $f(x)?$\n\nI. - $f(x)$ is defined at $x=-3$\nII. - ${lim}_{x\\to (-3)^{-}}f(x)={lim}_{x\\to (-3)^{+}}f(x)$\nIII. - ${lim}_{x\\to (-3)}f(x)=f(-3)$\nIV. - $f(x)$ is continuous at $x=-3$" :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n- Does $f(c)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Using the expression for the second branch of the function, we obtain that\n\n$$\nf(-3)=0.\n$$\n\nSo, $f(x)$ is defined at $x=-3.$ $\\,\\,✓$\n\n- Statement II is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)^{-}}f(x) & ={lim}_{x\\to (-3)^{-}}(-x-3) \\\\  & =-(-3)-3 \\\\  & =0 \\\\ {lim}_{x\\to (-3)^{+}}f(x) & ={lim}_{x\\to (-3)^{+}}(x+3) \\\\  & =(-3)+3 \\\\  & =0\\end{aligned}\n$$\n\nAs a result:\n\n$$\n{lim}_{x\\to (-3)^{-}}f(x)={lim}_{x\\to (-3)^{+}}f(x)\n$$\n\n \nTherefore, the limit of $f(x)$ at $x=-3$ exists:\n\n$$\n{lim}_{x\\to (-3)}f(x)=0\\,\\,✓\n$$\n\n- Statement III is true. Indeed, we have that ${lim}_{x\\to (-3)}f(x)=0=f(-3).$ $\\,\\,✓$\n\n- Statement IV is true. Since all statements I-III are true, according to the continuity test, the function $f(x)$ is continuous at $x=-3.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186258386 :knowledge-point/_questions [{:knowledge-point/id #uuid "8edb0a6c-f22f-56cf-9545-2fae93896db2" :knowledge-point/title "Verifying Continuity at a Point Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0ab3fbc-87cc-56d8-a974-522dd34b30d3" :answer/type {:db/ident :answer.type/text} :answer/value "I, III, IV" :db/id #edb/ref 17592186258388} {:answer/id #uuid "5fdaa303-0c0b-5b4e-823f-edbaf5152f63" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186258389} {:answer/id #uuid "b52df1ff-5d8e-5311-a703-5636d6666ad7" :answer/type {:db/ident :answer.type/text} :answer/value "II, III" :db/id #edb/ref 17592186258390} {:answer/id #uuid "f37ad898-cae0-5dd0-aa72-3e95cd65fde5" :answer/type {:db/ident :answer.type/text} :answer/value "I, III" :db/id #edb/ref 17592186258391} {:answer/id #uuid "f38c8c38-23aa-5d68-b966-e6c20ea1a14c" :answer/type {:db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186258392} {:answer/id #uuid "15010448-381a-5acd-8359-976f65c1af2c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, III" :db/id #edb/ref 17592186258393} {:answer/id #uuid "3863edcd-2e08-5c91-ae9f-61245cbcf496" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186258394} {:answer/id #uuid "17c82f92-278a-53e0-bdba-786d47904c92" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, III, IV" :db/id #edb/ref 17592186258395} {:answer/id #uuid "0fca9149-5777-5cb9-8cf8-a8c0ef67b2f0" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258396} {:answer/id #uuid "3ba37a39-4d97-5b49-8d13-91ee55115a42" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186258397} {:answer/id #uuid "6bb7170c-fa95-5385-bfd7-c1d6f7a4ff3a" :answer/type {:db/ident :answer.type/text} :answer/value "II, IV" :db/id #edb/ref 17592186258398} {:answer/id #uuid "690893ff-0dc1-5c5a-8cdf-39aae72ff9e5" :answer/type {:db/ident :answer.type/text} :answer/value "I, IV" :db/id #edb/ref 17592186258399} {:answer/id #uuid "cf9e1cb4-cca4-563d-bf5c-0dab612aa4b5" :answer/type {:db/ident :answer.type/text} :answer/value "III, IV" :db/id #edb/ref 17592186258400} {:answer/id #uuid "c6d5aea5-3dfa-517c-a044-6c722ffa4a07" :answer/type {:db/ident :answer.type/text} :answer/value "I, II" :db/id #edb/ref 17592186258401} {:answer/id #uuid "19be8788-5d4b-5792-b88b-d427cc1abe76" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, IV" :db/id #edb/ref 17592186258402} {:answer/id #uuid "845cd6bd-bf8f-56f6-b06a-250ba1f31627" :answer/type {:db/ident :answer.type/text} :answer/value "II, III, IV" :db/id #edb/ref 17592186258403}] :answer-field/correct {:answer/id #uuid "17c82f92-278a-53e0-bdba-786d47904c92" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, III, IV" :db/id #edb/ref 17592186258395} :answer-field/id #uuid "1a3f6704-198e-5b48-ba01-166fd6ced744" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258387}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4dfe3453-c9ac-58b3-b12c-8c3fa9577459" :question/math-academy-id "q-152928" :question/problem "Consider the following function:\n\n$$\nf(x)={\\begin{aligned}4x+12, & x\\ne -2 \\\\ 4, & x=-2\\end{aligned}\n$$\n\n \n\nWhich of the following statements are true regarding $f(x)?$\n\nI. - $f(x)$ is defined at $x=-2$\nII. - ${lim}_{x\\to (-2)^{-}}f(x)={lim}_{x\\to (-2)^{+}}f(x)$\nIII. - ${lim}_{x\\to (-2)}f(x)=f(-2)$\nIV. - $f(x)$ is continuous at $x=-2$" :question/worked-solution "To test for continuity of $f(x)$ at a point $x=c$, we need to check three conditions:\n\n- Does $f(c)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)$ exist?\n\n- Does ${lim}_{x\\to c}f(x)=f(c)?$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Using the expression for the second branch of the function, we obtain that \n\n$$\nf(-2)=4.\n$$\n\nSo, $f(x)$ is defined at $x=-2.$ $\\,\\,✓$\n\n- Statement II is true. By calculating the one-sided limits, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-2)^{-}}f(x) & ={lim}_{x\\to (-2)^{-}}(4x+12) \\\\  & =4(-2)+12 \\\\  & =4 \\\\ {lim}_{x\\to (-2)^{+}}f(x) & ={lim}_{x\\to (-2)^{+}}(4x+12) \\\\  & =4(-2)+12 \\\\  & =4\\end{aligned}\n$$\n\nAs a result:\n\n$$\n{lim}_{x\\to (-2)^{-}}f(x)={lim}_{x\\to (-2)^{+}}f(x)\n$$\n\n \nTherefore, the limit of $f(x)$ at $x=-2$ exists:\n\n$$\n{lim}_{x\\to (-2)}f(x)=4\\,\\,✓\n$$\n\n- Statement III is true. Indeed, we have that ${lim}_{x\\to (-2)}f(x)=4=f(-2).$ $\\,\\,✓$\n\n- Statement IV is true. Since all statements I-III are true, according to the continuity test, the function $f(x)$ is continuous at $x=-2.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186258555 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11128e59-218c-564c-899f-33d1f4d59de3" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\le-2$" :db/id #edb/ref 17592186271158} {:answer/id #uuid "ffb5f3b5-57fe-5b71-965f-7f1372d6b1f8" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271159} {:answer/id #uuid "68efaf3c-951d-5bf1-b314-a48ce708f80d" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge2$" :db/id #edb/ref 17592186271160} {:answer/id #uuid "cb06738f-cefd-5df9-a3f8-c1aecac469f2" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271161} {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162}] :answer-field/correct {:answer/id #uuid "78856cb5-8ef8-556d-b19f-eab43588da3c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\ge-\\frac14$ and $y\\ge-2$" :db/id #edb/ref 17592186271162} :answer-field/id #uuid "df9393bf-8b86-527d-966c-3fb1ffe4016c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274508}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4387361-c86a-55f1-abee-652931e3d6d3" :question/math-academy-id "q-16149" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx={t}^{2}+t,\\,\\,\\,y={t}^{2}-2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & ={t}^{2}+t \\\\  & ={(t+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} \\\\  & ={(t+\\frac{1}{2})}^{2}-\\frac{1}{4}\\end{aligned}\n$$\n\nSince ${(t+\\frac{1}{2})}^{2}\\ge 0,$ we can conclude that $x\\ge -\\frac{1}{4}.$\n\n- To find the range of $y,$ notice that ${t}^{2}\\ge 0.$ Therefore, we can conclude that $y\\ge -2.$\n\nSo, the ranges are $x\\ge -\\frac{1}{4}$ and $y\\ge -2.$"}] [{:db/id #edb/ref 17592186258695 :knowledge-point/_questions [{:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8ba9a04-b8b1-5d8f-9b2c-cbfdaf574a55" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186271210} {:answer/id #uuid "cc5e3537-78f7-58cd-9e24-19bb08c02042" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(10)" :db/id #edb/ref 17592186271211} {:answer/id #uuid "977e2a4f-e50d-5967-8e2a-45f550998a9e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186271212} {:answer/id #uuid "cf3e2c1c-3bbe-57c2-b8ba-d83e00327426" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271213} {:answer/id #uuid "45b9fb43-ea19-51ff-a154-41ccd454546e" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4)" :db/id #edb/ref 17592186271214}] :answer-field/correct {:answer/id #uuid "f8ba9a04-b8b1-5d8f-9b2c-cbfdaf574a55" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186271210} :answer-field/id #uuid "18703299-3f4c-580d-b6cc-56888a16fcc9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274520}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2e8234a-8f1b-5c06-89b8-b14ff16ffd00" :question/math-academy-id "q-170143" :question/problem "If $x=\\sqrt[3]{y}+1,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(3,8).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt[3]{y}+1) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt[3]{y})+\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{1/3})+\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =\\frac{1}{3}{y}^{-2/3}+0 \\\\  & =\\frac{1}{3{y}^{2/3}} \\\\  & =\\frac{1}{3\\sqrt[3]{{y}^{2}}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=3\\sqrt[3]{{y}^{2}}.\n$$\n\nFinally, substituting the point $(3,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(3,8)} & =3\\sqrt[3]{{y}^{2}}=12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258804 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd727bc4-c67f-5701-8b90-9e87fb069bc8" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((5x − 2)\\ln 5)" :db/id #edb/ref 17592186271370} {:answer/id #uuid "a8d0d278-5d78-5d4c-aa55-167448b26699" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(5)}" :db/id #edb/ref 17592186271371} {:answer/id #uuid "dff09901-63f1-56f2-ade1-762822f176cf" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((5x − 2)\\ln 3)" :db/id #edb/ref 17592186271372} {:answer/id #uuid "b4a37a7b-96ff-51d9-a5dd-f2d5e8a60bb2" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/((5x − 2)\\ln 5)" :db/id #edb/ref 17592186271373} {:answer/id #uuid "70b493cb-0729-5a5a-a913-02ec05789fd8" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((2x − 5)\\ln 3)" :db/id #edb/ref 17592186271374}] :answer-field/correct {:answer/id #uuid "a8d0d278-5d78-5d4c-aa55-167448b26699" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(5)}" :db/id #edb/ref 17592186271371} :answer-field/id #uuid "bff1d75f-d4ef-57dc-959d-3e78bbf882ee" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274552}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8315c87a-da4c-5df4-9d92-af7fcfe96632" :question/math-academy-id "q-1949" :question/problem "Find ${y}^{'}$ for $y={log}_{5}(5x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={log}_{5}(u),\\,u=5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{u\\operatorname{ln}(5)},\\,\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u\\operatorname{ln}(5)}\\cdot 5 \\\\  & =\\frac{1}{(5x)\\operatorname{ln}(5)}\\cdot 5 \\\\  & =\\frac{\\cancel{5}}{\\cancel{5}x\\operatorname{ln}(5)} \\\\  & =\\frac{1}{x\\operatorname{ln}(5)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258931 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae9e98c-4984-5a19-b01c-41ee454e95c5" :answer/type {:db/ident :answer.type/math} :answer/value "(x^{2})/(y^{2})" :db/id #edb/ref 17592186271460} {:answer/id #uuid "53d6b6e7-61f2-5fa5-88b2-9f52af062c71" :answer/type {:db/ident :answer.type/math} :answer/value "− (x^{2})/(3y^{2})" :db/id #edb/ref 17592186271461} {:answer/id #uuid "cfd2edfc-beda-5a21-8c4a-fa95f71212e8" :answer/type {:db/ident :answer.type/math} :answer/value "− (3x^{2})/(y^{2})" :db/id #edb/ref 17592186271462} {:answer/id #uuid "254e6932-5f47-5251-ba32-97703ef5861a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}(10)\\,xy" :db/id #edb/ref 17592186271463} {:answer/id #uuid "00246783-976e-54f9-a05f-b8b8608c0f0a" :answer/type {:db/ident :answer.type/math} :answer/value "− (x^{2})/(y^{2})" :db/id #edb/ref 17592186271464}] :answer-field/correct {:answer/id #uuid "254e6932-5f47-5251-ba32-97703ef5861a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}(10)\\,xy" :db/id #edb/ref 17592186271463} :answer-field/id #uuid "ddc12ae7-39f2-5e03-a8f3-565b3da7ab7e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274570}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "47b5689d-41d6-55e0-8e92-78e731c8962b" :question/math-academy-id "q-2288" :question/problem "Given that $\\operatorname{log}(y)-{x}^{2}=3,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\operatorname{log}(y)-{x}^{2} & =3 \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{log}(y)-{x}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(3) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{log}(y))-\\frac{\\text{d}}{\\text{d}x}({x}^{2}) & =0 \\\\ \\frac{1}{y\\operatorname{ln}(10)}(\\frac{\\text{d}y}{\\text{d}x})-2x & =0\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{y\\cdot \\operatorname{ln}(10)}\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(2x)(y\\operatorname{ln}(10)) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2\\operatorname{ln}(10)\\,xy\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258937 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ab5658-ece6-5a90-9fcc-67fd2710f972" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\frac{4}{2y+1})" :db/id #edb/ref 17592186271465} {:answer/id #uuid "d14d9d5e-162a-5170-952e-e43e3acd43b4" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{4}{2y+1})" :db/id #edb/ref 17592186271466} {:answer/id #uuid "3526d5c6-30f2-51bd-a4c7-9cdef379b93c" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\frac{4}{2y+1})" :db/id #edb/ref 17592186271467} {:answer/id #uuid "ca543f32-794b-5e3d-bf9e-58f03d638845" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{2y+1}" :db/id #edb/ref 17592186271468} {:answer/id #uuid "a62146f1-b5ff-5d8c-bce7-d00ba6dd240f" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{4}{2y+1})" :db/id #edb/ref 17592186271469}] :answer-field/correct {:answer/id #uuid "ca543f32-794b-5e3d-bf9e-58f03d638845" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{2y+1}" :db/id #edb/ref 17592186271468} :answer-field/id #uuid "a0d3b036-782f-5233-9bdd-15c902e12894" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274571}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "764decfa-e2f7-55e0-9e57-b97603e2a427" :question/math-academy-id "q-2291" :question/problem "Given that ${y}^{2}-4x+y=2,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}{y}^{2}-4x+y & =2 \\\\ {y}^{2}+y & =2+4x \\\\ \\frac{\\text{d}}{\\text{d}x}({y}^{2}+y) & =\\frac{\\text{d}}{\\text{d}x}(2+4x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x}+\\frac{\\text{d}y}{\\text{d}x} & =0+4\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(2y+1) & =4 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{4}{2y+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258967 :knowledge-point/_questions [{:knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73f9c8ad-33f7-5bc1-9144-cb52bc0e10b1" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(2)" :db/id #edb/ref 17592186271498} {:answer/id #uuid "3e7fab1f-d968-5e94-b1b0-15566296b1b2" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(2)" :db/id #edb/ref 17592186271499} {:answer/id #uuid "61a12b02-7df4-5d67-8d0e-1c261c885e2b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-(2)" :db/id #edb/ref 17592186271500} {:answer/id #uuid "8c5afd3d-ee31-5ffb-b4f4-5515ea98939b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}(2)" :db/id #edb/ref 17592186271501} {:answer/id #uuid "3a87e4d9-f3f0-53ee-abf3-717d9f45935b" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186271502}] :answer-field/correct {:answer/id #uuid "3a87e4d9-f3f0-53ee-abf3-717d9f45935b" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186271502} :answer-field/id #uuid "af7dbe1f-8980-5b1d-886c-dde8d0489682" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274577}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5768bcd4-3be1-5ac3-bde3-3e84a242be37" :question/math-academy-id "q-236892" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $0$ and a maximum value of $4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{0+4}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"}] [{:db/id #edb/ref 17592186258970 :knowledge-point/_questions [{:knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6cd65f-2069-5553-84d1-49092b807337" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186271503} {:answer/id #uuid "69615fd0-aacb-5b87-9c51-1b7f7b392048" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(-9)" :db/id #edb/ref 17592186271504} {:answer/id #uuid "d8b65173-56d7-53cd-8eb4-83d471257dff" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(-9)" :db/id #edb/ref 17592186271505} {:answer/id #uuid "93ffe568-6723-5845-8a0c-a405d337b8e1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}(-9)" :db/id #edb/ref 17592186271506} {:answer/id #uuid "fe971737-20c5-5606-b322-9eb832ed371a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-(-9)" :db/id #edb/ref 17592186271507}] :answer-field/correct {:answer/id #uuid "0c6cd65f-2069-5553-84d1-49092b807337" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186271503} :answer-field/id #uuid "6e5d3182-44d9-5375-abce-d97b099472a7" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274578}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "968a76bd-d1b3-5d50-b7ae-97e1392795e5" :question/math-academy-id "q-236903" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-14$ and a maximum value of $-4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-14+(-4)}{2} \\\\  & =\\frac{-18}{2} \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-9.$"}] [{:db/id #edb/ref 17592186259057 :knowledge-point/_questions [{:knowledge-point/id #uuid "5696c2d5-4e35-5ed3-a4a2-6fe9b158e461" :knowledge-point/title "Finding the Range of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a73f7c7-76f0-5051-8550-4a6ac5078060" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-1)" :db/id #edb/ref 17592186271562} {:answer/id #uuid "1f857b26-b61b-5602-84ff-cf81763238f1" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186271563} {:answer/id #uuid "090c88a0-95e1-5263-b807-7ee2da19490a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-1,3]" :db/id #edb/ref 17592186271564} {:answer/id #uuid "372f8378-afda-581d-aefc-dabb9aee639b" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id #edb/ref 17592186271565} {:answer/id #uuid "cb67b70b-4145-5ec1-a923-f0649d39428a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186271566}] :answer-field/correct {:answer/id #uuid "090c88a0-95e1-5263-b807-7ee2da19490a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-1,3]" :db/id #edb/ref 17592186271564} :answer-field/id #uuid "2e685ed9-1d9e-5e84-bf2c-7fe07e0d7dc2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274590}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b332baf-b639-50f9-98d4-7d9a200dfa68" :question/math-academy-id "q-25512" :question/problem "Find the range of the function $f(x)=-2\\operatorname{sin}(3x)+1.$" :question/worked-solution "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(3x)\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $1$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(3x)\\le 1 \\\\  & 2\\ge -2\\operatorname{sin}(2x)\\ge -2 \\\\  & 3\\ge -2\\operatorname{sin}(2x)+1\\ge -1 \\\\  & -1\\le f(x)\\le 3.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,3].$"}] [{:db/id #edb/ref 17592186259161 :knowledge-point/_questions [{:knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d21b302c-4d09-58ba-a350-7e2a766ecd2d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186259163}] :answer-field/correct {:answer/id #uuid "d21b302c-4d09-58ba-a350-7e2a766ecd2d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186259163} :answer-field/id #uuid "ace5df96-b742-55d0-9531-e84324d1e89c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259162} {:answer-field/choices [{:answer/id #uuid "b54c9f92-5fbe-51c6-aa72-b18fd110700b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186259165}] :answer-field/correct {:answer/id #uuid "b54c9f92-5fbe-51c6-aa72-b18fd110700b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186259165} :answer-field/id #uuid "cec13455-6050-5fa5-9850-121313402a37" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259164} {:answer-field/choices [{:answer/id #uuid "60438727-560b-57ea-ad5