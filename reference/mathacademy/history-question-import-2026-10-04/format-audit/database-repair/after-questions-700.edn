#{[{:db/id #edb/ref 17592186256508 :knowledge-point/_questions [{:knowledge-point/id #uuid "d766de83-9394-57be-84a4-bb88f5ddf792" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a947336e-66d4-5365-b9ce-a80eb665d71a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269397} {:answer/id #uuid "e8783072-bfbf-59c7-a211-ea7ba35aa67c" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186269398} {:answer/id #uuid "5c693f9a-9af8-5807-a1ea-95297ef2a499" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269399} {:answer/id #uuid "3ff7c653-72d4-54b0-8a51-12d98e49f589" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186269400} {:answer/id #uuid "d576bf5f-4387-5429-b122-b5b9ccfa4606" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{77}" :db/id #edb/ref 17592186269401}] :answer-field/correct {:answer/id #uuid "d576bf5f-4387-5429-b122-b5b9ccfa4606" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{77}" :db/id #edb/ref 17592186269401} :answer-field/id #uuid "ceaa4e82-9ee2-5a1f-aa2f-448d82216ef1" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274154}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d0e28f21-d62b-50a2-a5e7-709c0e5d467d" :question/math-academy-id "q-101004" :question/problem "Let $C(3,8,3)$ and $D(-5,0,-6).$ Find $|c+d|,$ where $c$ and $d$ are position vectors of $C$ and $D$, respectively." :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=3i+8j+3k, \\\\  & \\overset{\\to }{OD}=d=-5i-6k.\\end{aligned}\n$$\n\nComputing the coordinates of $c+d$, we obtain:\n\n$$\n\\begin{aligned}c+d & =(3i+8j+3k)+(-5i-6k) \\\\  & =-2i+8j-3k\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|c+d| & =\\sqrt{(-2)^{2}+{8}^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+64+9} \\\\  & =\\sqrt{77}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256511 :knowledge-point/_questions [{:knowledge-point/id #uuid "d766de83-9394-57be-84a4-bb88f5ddf792" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ced54a1d-3af8-5421-a3ca-f79f5a6ddf2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{170}" :db/id #edb/ref 17592186269402} {:answer/id #uuid "8678cbb9-a66d-5055-a4cc-79df390eccaa" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186269403} {:answer/id #uuid "3e1e29c0-f03f-5ccd-ad75-3752eec48fd0" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186269404} {:answer/id #uuid "5251cdd5-47df-5b2a-986d-ec08db990ffb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269405} {:answer/id #uuid "8e1416c3-fdaa-5f4f-9b2e-29f0d16388e5" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186269406}] :answer-field/correct {:answer/id #uuid "ced54a1d-3af8-5421-a3ca-f79f5a6ddf2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{170}" :db/id #edb/ref 17592186269402} :answer-field/id #uuid "786fe05c-ef1e-5ebb-99d5-843982a0a8ee" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274155}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3212fc88-66cd-514c-8c22-3497355c10c8" :question/math-academy-id "q-101008" :question/problem "Let $R(-1,1,4)$ and $S(8,-2,0).$ Find $|3r+s|,$ where $r$ and $s$ are position vectors of $R$ and $S$, respectively." :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OR}=r=-i+j+4k, \\\\  & \\overset{\\to }{OS}=s=8i-2j.\\end{aligned}\n$$\n\nComputing the coordinates of $3r+s$, we obtain:\n\n$$\n\\begin{aligned}3r+s & =3(-i+j+4k)+(8i-2j) \\\\  & =5i+j+12k\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|3r+s| & =\\sqrt{{5}^{2}+{1}^{2}+{12}^{2}} \\\\  & =\\sqrt{25+1+144} \\\\  & =\\sqrt{170}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256514 :knowledge-point/_questions [{:knowledge-point/id #uuid "1916efa2-6a98-59a5-858c-c4fe64d8e8bc" :knowledge-point/title "Calculating the Magnitude of a Vector Given the Coordinates of its Endpoints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76773fd2-df80-5244-87e9-2fef4f758b70" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle(\\frac{2}{3})-1,\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269407} {:answer/id #uuid "b977acbb-f647-5fca-ac2a-322739f011cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle\\frac{2}{3},\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269408} {:answer/id #uuid "398669d0-d3cd-5944-bbc5-ee40c191f041" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle(\\frac{2}{3})-2,\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269409} {:answer/id #uuid "68189d30-b071-5a91-8e01-e889c13a3f38" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle(\\frac{2}{3})+2,\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269410} {:answer/id #uuid "6daaff9d-c771-5fac-9440-0a90f357ad50" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle(\\frac{2}{3})+1,\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269411}] :answer-field/correct {:answer/id #uuid "b977acbb-f647-5fca-ac2a-322739f011cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle\\frac{2}{3},\\frac{2}{3},-\\frac{1}{3}\\rangle" :db/id #edb/ref 17592186269408} :answer-field/id #uuid "3a365c84-6169-5bd9-849c-9b04c1589f45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274156}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e20ebdd4-c7c2-56fa-9bfe-46ac87997401" :question/math-academy-id "q-101019" :question/problem "Let $A(6,7,6)$ and $B(8,9,5).$ Find a unit vector that is parallel to $\\overset{\\to }{AB}.$" :question/worked-solution "First, we have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=6i+7j+6k, \\\\  & \\overset{\\to }{OB}=b=8i+9j+5k.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =8i+9j+5k-(6i+7j+6k) \\\\  & =2i+2j-k \\\\  & =⟨2,2,-1⟩\\end{aligned}\n$$\n\nNow, remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\nu=\\frac{\\overset{\\to }{AB}}{|\\,\\overset{\\to }{AB}\\,|}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,\\overset{\\to }{AB}\\,| & =\\sqrt{{2}^{2}+{2}^{2}+(-1)^{2}} \\\\  & =\\sqrt{4+4+1} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$\n\nFinally, we divide $\\overset{\\to }{AB}$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{\\overset{\\to }{AB}}{|\\,\\overset{\\to }{AB}\\,|} \\\\  & =\\frac{1}{3}\\overset{\\to }{AB} \\\\  & =\\frac{1}{3}\\cdot ⟨2,2,-1⟩ \\\\  & =⟨\\frac{2}{3},\\frac{2}{3},-\\frac{1}{3}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256529 :knowledge-point/_questions [{:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2445c8ff-0eb4-5700-a9df-bd608f5ba051" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-4)" :db/id #edb/ref 17592186269432} {:answer/id #uuid "9d246e1f-3414-531a-8e5e-61facbdb9006" :answer/type {:db/ident :answer.type/math} :answer/value "-(-4)" :db/id #edb/ref 17592186269433} {:answer/id #uuid "04df2e25-4c8a-5912-ae33-e73f5d22561f" :answer/type {:db/ident :answer.type/math} :answer/value "3(-4)" :db/id #edb/ref 17592186269434} {:answer/id #uuid "5262beab-6291-53da-a9e0-2ebbd60407d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186269435} {:answer/id #uuid "f6648ee1-6572-5d32-9daa-d7086e0d73ba" :answer/type {:db/ident :answer.type/math} :answer/value "2(-4)" :db/id #edb/ref 17592186269436}] :answer-field/correct {:answer/id #uuid "5262beab-6291-53da-a9e0-2ebbd60407d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186269435} :answer-field/id #uuid "dac7ba87-7452-5817-b1f7-f5601dd2d149" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274161}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5712e498-177c-5ff5-9270-29807a04505c" :question/math-academy-id "q-101719" :question/problem "Given that $y=7-4{log}_{3}x$, find the instantaneous rate of change at $x=\\frac{1}{\\operatorname{ln}3}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}x)=\\frac{1}{x\\operatorname{ln}a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7-4{log}_{3}x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-4\\frac{\\text{d}}{\\text{d}x}({log}_{3}x) \\\\  & =0-4\\cdot \\frac{1}{x\\operatorname{ln}3} \\\\  & =-\\frac{4}{x\\operatorname{ln}3}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1/\\operatorname{ln}3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/\\operatorname{ln}3} & ={(-\\frac{4}{x\\operatorname{ln}3})\\,|}_{x=1/\\operatorname{ln}3} \\\\  & =-\\frac{4}{1} \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256532 :knowledge-point/_questions [{:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076ca171-ac42-51d6-8867-f7aeafbebb46" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3 + 5" :db/id #edb/ref 17592186269437} {:answer/id #uuid "d73674f3-4458-5378-adce-d643e9d85645" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(\\ln 3) + 5" :db/id #edb/ref 17592186269438} {:answer/id #uuid "1c79e632-579b-5b1a-9b41-f41f4846ef78" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(\\ln 3)" :db/id #edb/ref 17592186269439} {:answer/id #uuid "21b1390e-2360-5f0b-ba22-27f19232978b" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(\\ln 3)" :db/id #edb/ref 17592186269440} {:answer/id #uuid "0ced357c-9415-5ce3-b576-f6f55d4d654c" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{3}-\\frac{1}{\\operatorname{ln}7}" :db/id #edb/ref 17592186269441}] :answer-field/correct {:answer/id #uuid "0ced357c-9415-5ce3-b576-f6f55d4d654c" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{3}-\\frac{1}{\\operatorname{ln}7}" :db/id #edb/ref 17592186269441} :answer-field/id #uuid "ebc40bae-6c34-55bd-80c4-eb68d3960bb5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0d14b209-f1c5-59b3-ba28-3ccabf73112a" :question/math-academy-id "q-101723" :question/problem "Given that $y=4{e}^{x}-3{log}_{7}x$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4{e}^{x}-\\frac{3}{x\\operatorname{ln}7}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(4{e}^{x}-\\frac{3}{x\\operatorname{ln}7})|}_{x=3} \\\\  & =4{e}^{3}-\\frac{3}{3\\operatorname{ln}7} \\\\  & =4{e}^{3}-\\frac{1}{\\operatorname{ln}7}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256644 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a" :knowledge-point/title "Differentiating a Quotient of Two Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1ed54bf-d14d-5cde-8d7f-03137304bd35" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269562} {:answer/id #uuid "91bafd3b-9d25-5566-a88f-5f3fc513c823" :answer/type {:db/ident :answer.type/math} :answer/value "(10x + 5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269563} {:answer/id #uuid "be0a3924-ccc1-5004-94c5-40edb868d3cc" :answer/type {:db/ident :answer.type/math} :answer/value "(20x + 5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269564} {:answer/id #uuid "d297202f-619b-5e05-89d9-670c4f95d06e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20x}{{(3-{x}^{2})}^{2}}" :db/id #edb/ref 17592186269565} {:answer/id #uuid "ef72ed17-0ee3-5bfa-967f-33656f1e3195" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269566}] :answer-field/correct {:answer/id #uuid "d297202f-619b-5e05-89d9-670c4f95d06e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20x}{{(3-{x}^{2})}^{2}}" :db/id #edb/ref 17592186269565} :answer-field/id #uuid "c5a02940-99ac-545c-8a84-82603d521fc5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274187}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1d411e15-efea-5149-8fe7-10e8ce23e151" :question/math-academy-id "q-104305" :question/problem "Given that $f(x)=\\frac{10}{3-{x}^{2}}$, find ${f}^{'}(x).$" :question/worked-solution "The numerator and denominator are $u(x)=10$ and $v(x)=3-{x}^{2},$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{'}(x) & =0, \\\\ {v}^{'}(x) & =-2x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{{u}^{'}(x)\\cdot v(x)-u(x)\\cdot {v}^{'}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(0)\\cdot (3-{x}^{2})-(10)\\cdot (-2x)}{{(3-{x}^{2})}^{2}} \\\\  & =\\frac{20x}{{(3-{x}^{2})}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256647 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a" :knowledge-point/title "Differentiating a Quotient of Two Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd100885-e513-5fc6-a479-cf335b39ffdd" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269567} {:answer/id #uuid "b04352f6-4aed-53e1-9d1f-2ba14ea1ef61" :answer/type {:db/ident :answer.type/math} :answer/value "(10x + 5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269568} {:answer/id #uuid "92a73120-7cd2-52a5-b182-c432b6444c7e" :answer/type {:db/ident :answer.type/math} :answer/value "(20x + 5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269569} {:answer/id #uuid "d6d86edc-a422-52c4-b429-d5f98a44550b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-3x+1}{{({x}^{2}-1)}^{2}}" :db/id #edb/ref 17592186269570} {:answer/id #uuid "83b84b8d-dad2-5326-8e17-02a9860a96b9" :answer/type {:db/ident :answer.type/math} :answer/value "− (5)/((2x − 1)^{2})" :db/id #edb/ref 17592186269571}] :answer-field/correct {:answer/id #uuid "d6d86edc-a422-52c4-b429-d5f98a44550b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-3x+1}{{({x}^{2}-1)}^{2}}" :db/id #edb/ref 17592186269570} :answer-field/id #uuid "fbb39ffa-4c5a-596e-aff5-a6cb44f6fcf0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274188}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "466a6abc-d194-5c18-a31e-c8516267f1eb" :question/math-academy-id "q-104309" :question/problem "Given that $f(x)=\\frac{3-2x}{2{x}^{2}-2}$, find ${f}^{'}(x).$" :question/worked-solution "The numerator and denominator are $u(x)=3-2x$ and $v(x)=2{x}^{2}-2,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{'}(x) & =-2, \\\\ {v}^{'}(x) & =4x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n \n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{{u}^{'}(x)\\cdot v(x)-u(x)\\cdot {v}^{'}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-2)(2{x}^{2}-2)-(3-2x)(4x)}{{(2{x}^{2}-2)}^{2}} \\\\  & =\\frac{-4{x}^{2}+4-12x+8{x}^{2}}{{(2{x}^{2}-2)}^{2}} \\\\  & =\\frac{4{x}^{2}-12x+4}{4{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{x}^{2}-3x+1}{{({x}^{2}-1)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256711 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/title "Differentiating a Natural Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d8a8a36-9116-5800-bbd2-2d758c857c14" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x+1+\\ln2" :db/id #edb/ref 17592186269627} {:answer/id #uuid "0f960631-84ef-501c-89de-a3d7ce2084d7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}(-x+1+\\ln2)" :db/id #edb/ref 17592186269628} {:answer/id #uuid "45902f0a-0223-5787-aa5d-972db2a4fed9" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(-x+1+\\ln2)" :db/id #edb/ref 17592186269629} {:answer/id #uuid "3a91ed9f-8697-5ff4-a216-e991b0e63b80" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(-x+1+\\ln2)" :db/id #edb/ref 17592186269630} {:answer/id #uuid "b6e807db-5ec1-5a4c-8392-6ad1efc15c7e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-(-x+1+\\ln2)" :db/id #edb/ref 17592186269631}] :answer-field/correct {:answer/id #uuid "6d8a8a36-9116-5800-bbd2-2d758c857c14" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x+1+\\ln2" :db/id #edb/ref 17592186269627} :answer-field/id #uuid "c43506da-9a80-5bb4-ae7e-ab0c30d6bfb7" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274200}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5abbc5ce-58de-5d2f-bd7e-ce5e196f9c90" :question/math-academy-id "q-107469" :question/problem "Find the equation of the tangent to the curve $f(x)=\\operatorname{ln}(4-2x)$ at the point $(1,\\operatorname{ln}2).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{ln}u,\\,u=4-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot (-2) \\\\  & =\\frac{1}{4-2x}\\cdot (-2) \\\\  & =-\\frac{2}{4-2x} \\\\  & =-\\frac{\\cancel{2}}{\\cancel{2}\\cdot (2-x)} \\\\  & =-\\frac{1}{2-x}\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={-\\frac{1}{2-x}|}_{x=1}=-\\frac{1}{2-1}=-1\\,.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,\\operatorname{ln}2)$ is $m=-1.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\operatorname{ln}2 & =-1(x-1) \\\\ y & =-x+1+\\operatorname{ln}2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256786 :knowledge-point/_questions [{:knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7344dbe-de50-54b2-a7c2-4a829e3db557" :answer/type {:db/ident :answer.type/math} :answer/value "-(-116)" :db/id #edb/ref 17592186269727} {:answer/id #uuid "74dd7c27-a5bb-59e1-89ec-1face4172a9c" :answer/type {:db/ident :answer.type/math} :answer/value "2(-116)" :db/id #edb/ref 17592186269728} {:answer/id #uuid "438d0818-728f-5061-8126-854ccbc43e44" :answer/type {:db/ident :answer.type/math} :answer/value "3(-116)" :db/id #edb/ref 17592186269729} {:answer/id #uuid "9c49f95f-0e3f-5aa5-ab67-8ed8cd472094" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-116)" :db/id #edb/ref 17592186269730} {:answer/id #uuid "d6dffb05-6e92-584a-99cb-2e1e4c457756" :answer/type {:db/ident :answer.type/math} :answer/value "-116" :db/id #edb/ref 17592186269731}] :answer-field/correct {:answer/id #uuid "d6dffb05-6e92-584a-99cb-2e1e4c457756" :answer/type {:db/ident :answer.type/math} :answer/value "-116" :db/id #edb/ref 17592186269731} :answer-field/id #uuid "b565e5ab-36ee-5d91-9dd1-dca774b03f14" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274220}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "307089e8-baf9-5482-9f9b-5553f2129d31" :question/math-academy-id "q-10907" :question/problem "Find ${f}^{''}(-1)$ if $f(x)=4{x}^{5}-3{x}^{4}.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & ={(4{x}^{5}-3{x}^{4})}^{'} &  \\\\  & =5\\cdot 4{x}^{4}-4\\cdot 3{x}^{3} \\\\  & =20{x}^{4}-12{x}^{3}\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{''}(x) & ={(20{x}^{4}-12{x}^{3})}^{'} \\\\  & =4\\cdot 20{x}^{3}-3\\cdot 12{x}^{2} \\\\  & =80{x}^{3}-36{x}^{2}\\,.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=-1$, we obtain\n\n$$\n\\begin{aligned}{f}^{''}(-1) & =80(-1)^{3}-36(-1)^{2} \\\\  & =-80-36 \\\\  & =-116.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257179 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e88f43c-18c5-5fdb-b6d1-579370489099" :knowledge-point/title "Identifying Values in the Domain of the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de423cd0-6939-53bf-99a4-9cac30d1d170" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(4)" :db/id #edb/ref 17592186270262} {:answer/id #uuid "5614372c-02a3-5903-8cf0-969384bbce84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}" :db/id #edb/ref 17592186270263} {:answer/id #uuid "f1e3a58c-689a-566f-8331-a78c733e4c18" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270264} {:answer/id #uuid "cee92f53-de07-503a-9822-7088edea743d" :answer/type {:db/ident :answer.type/math} :answer/value "− 2" :db/id #edb/ref 17592186270265} {:answer/id #uuid "e363c55c-e73e-5e6c-b153-ee9d8928b306" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186270266}] :answer-field/correct {:answer/id #uuid "5614372c-02a3-5903-8cf0-969384bbce84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}" :db/id #edb/ref 17592186270263} :answer-field/id #uuid "c004c3a0-4322-5b24-991f-8c35ea2722af" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274328}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f94e32f6-7fb6-5970-bcb4-34f10163497e" :question/math-academy-id "q-116964" :question/problem "Which of the following values is in the domain of $y=\\operatorname{arcsin}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arcsin}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nNote that:\n\n- The domain of the function is $x\\in [-1,1].$\n\nTherefore, of the given values, only $x=-\\frac{\\pi }{6}$ is in the domain of the function."}] [{:db/id #edb/ref 17592186257182 :knowledge-point/_questions [{:knowledge-point/id #uuid "76b0ad1e-827e-5795-8431-3276c8eed881" :knowledge-point/title "Identifying Values in the Range of the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9933cba6-43c5-5b95-87fe-9916872db443" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186270267} {:answer/id #uuid "f67034e0-f9db-5562-9a85-5c44009c3a43" :answer/type {:db/ident :answer.type/math} :answer/value "-(\\frac{5}{2})" :db/id #edb/ref 17592186270268} {:answer/id #uuid "54ff29da-24a8-5905-8c67-8817bc68b8f5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\frac{5}{2})" :db/id #edb/ref 17592186270269} {:answer/id #uuid "db7782af-2ab2-5a15-b271-c8696c48f563" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270270} {:answer/id #uuid "58a1b6b0-8996-5f52-9dd6-b0ae72385b9e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270271}] :answer-field/correct {:answer/id #uuid "9933cba6-43c5-5b95-87fe-9916872db443" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186270267} :answer-field/id #uuid "206525a6-29df-553e-aae2-168a54611a76" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274329}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8fd2f5d3-ed41-5722-b4e0-f7436fc89d15" :question/math-academy-id "q-116968" :question/problem "Which of the following values is **not** in the range of $y=\\operatorname{arcsin}x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arcsin}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nNote that:\n\n- The range of the function is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nTherefore, the value $y=\\frac{5}{2}$ is not in the range of the function."}] [{:db/id #edb/ref 17592186257185 :knowledge-point/_questions [{:knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ceaa316-e3e1-55b2-ae3c-d9260d2939da" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257187} {:answer/id #uuid "ad2f7299-d4e7-5c89-8447-6e85fda04ee2" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257188} {:answer/id #uuid "78468aff-5ac8-572d-a1b3-a73174ef4604" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257189} {:answer/id #uuid "16f4a9c6-555a-5cc0-a62a-a0ef7a517e5b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257190} {:answer/id #uuid "9e7e9d7e-7fd9-5a94-b6f2-b010d988e926" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257191} {:answer/id #uuid "36157a81-80f3-5290-8881-297b953400a8" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257192} {:answer/id #uuid "1e1eb1bf-a535-588b-9c0f-c535e46f7d99" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257193} {:answer/id #uuid "70eed078-0e2d-5218-b18e-29e7b94f945d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257194}] :answer-field/correct {:answer/id #uuid "16f4a9c6-555a-5cc0-a62a-a0ef7a517e5b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257190} :answer-field/id #uuid "6892c31f-549c-572f-9ddb-e3cfa0dc1374" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257186}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4c2df21e-7d98-55cc-bb9d-c4c6dd3c0b6c" :question/math-academy-id "q-117039" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}x?$\n\nI. - $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$\nII. - $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3})$\nIII. - $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}x,$ meaning $a=\\operatorname{sin}b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-\\frac{\\sqrt{2}}{2})$  lies on the graph of $y=\\operatorname{sin}x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arcsin}x.$\n\n- Next, we consider the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{3},-\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{sin}x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{5\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arcsin}x.$\n\n- Finally, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\frac{\\sqrt{3}}{2})$ does **not** lie on the graph of $y=\\operatorname{sin}x.$ $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}x.$"}] [{:db/id #edb/ref 17592186257268 :knowledge-point/_questions [{:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1d02e3-1b5e-51c8-96be-c665bb1324fc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270327} {:answer/id #uuid "10920157-994c-5967-94ea-654819d7c344" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270328} {:answer/id #uuid "8dd026e4-ef7d-57ed-8d1f-e657c0a9f463" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270329} {:answer/id #uuid "0fb63b53-9671-5e10-9637-b4c2709d0eda" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270330} {:answer/id #uuid "d9eb3aac-221f-5d5d-9686-a05db6f1e542" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270331}] :answer-field/correct {:answer/id #uuid "0e1d02e3-1b5e-51c8-96be-c665bb1324fc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270327} :answer-field/id #uuid "22750716-65c7-5faf-90fe-b39eae8b08db" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274341}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6548405c-a613-5075-b99b-e7774982d1db" :question/math-academy-id "q-118780" :question/problem "What is the order of the ordinary differential equation ${x}^{2}\\frac{{\\text{d}}^{7}y}{\\text{d}{x}^{7}}-9{x}^{7}\\frac{\\text{d}y}{\\text{d}x}=2\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}}?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}},$ which has order $8.$\n\nTherefore, the order of the ODE is $8.$"}] [{:db/id #edb/ref 17592186257271 :knowledge-point/_questions [{:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd11e8a-9d28-5792-a51b-1ee774af6cb2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257273} {:answer/id #uuid "3f1de0e4-6581-50d8-b4dd-417ce299ef49" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257274} {:answer/id #uuid "fd82d032-b6b4-5f9f-bb42-9bc13998c9b2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257275} {:answer/id #uuid "6c9a1d31-55dc-5cac-9de6-5d54020933fe" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257276} {:answer/id #uuid "a3956880-699f-50c3-98e2-75b8a47f798d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257277} {:answer/id #uuid "89b70b1a-c0f9-503a-8b4f-42025621f37c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257278} {:answer/id #uuid "a75eaa53-ae4e-5fee-a937-f991724017e4" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257279} {:answer/id #uuid "81ccf827-073c-5b1e-8402-506130440329" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257280}] :answer-field/correct {:answer/id #uuid "89b70b1a-c0f9-503a-8b4f-42025621f37c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257278} :answer-field/id #uuid "257a23f9-a24a-5b27-a803-2fd9ff28766b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257272}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6fe84cb-75e2-55de-b6df-ded3330a421e" :question/math-academy-id "q-118782" :question/problem "Which of the following are second-order ordinary differential equations?\n\nI. - $9x{y}^{''}+8{y}^{'}=4$\nII. - $\\sqrt{{y}^{''}+x}=3y$\nIII. - ${y}^{‴}+{x}^{2}{y}^{''}=3$" :question/worked-solution "A differential equation is of second-order if the largest derivative term in the equation is ${y}^{''}.$\n\nKeeping this in mind, let's check each given equation.\n\n- Equation I is a second-order differential equation. The highest derivative in this equation is ${y}^{''}.$\n\n- Equation II is also a second-order differential equation. The highest derivative in this equation is ${y}^{''}.$\n\n- Equation III is not a second-order differential equation. The highest derivative in this equation is ${y}^{‴},$ so this is a third-order differential equation.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186257281 :knowledge-point/_questions [{:knowledge-point/id #uuid "13e08fd0-4f41-56eb-8650-b72aa739b7a1" :knowledge-point/title "Initial Value Problems and Initial Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39ee5fc1-03e0-57e5-bbbf-315d46f4703b" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257283} {:answer/id #uuid "f57d7578-82c4-5967-a523-96974dbf056c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257284} {:answer/id #uuid "9d8e1b40-531d-5738-bd3c-ddd411adcbb3" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257285} {:answer/id #uuid "3dac5233-1cb8-538b-a95f-9c3184be17d0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257286} {:answer/id #uuid "c9953a88-e46e-55ac-b3c0-ab066edb021f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257287} {:answer/id #uuid "b345a296-774e-57b4-8d0e-503947db627b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257288} {:answer/id #uuid "9d54d347-85b6-56fb-b78d-46ec06bb4b9b" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257289} {:answer/id #uuid "d2471a44-b1ef-5141-9fe5-a87c669720c3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257290}] :answer-field/correct {:answer/id #uuid "3dac5233-1cb8-538b-a95f-9c3184be17d0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257286} :answer-field/id #uuid "39594d48-3439-593f-beb0-784efbc73181" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257282}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d3e1743-cd34-559d-bad0-d34093686fd6" :question/math-academy-id "q-118786" :question/problem "Which of the following systems is a first-order initial value problem?\n\nI. - $(1+{x}^{2}){y}^{'}=8y,\\,y(-1)=3$\nII. - $8{y}^{'}-xy=3$\nIII. - $3{y}^{''}=4y,\\,y(-1)=0,\\,{y}^{'}(-1)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{'}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I is a first-order initial value problem. It consists of a first-order differential equation $(1+{x}^{2}){y}^{'}=8y$ together with the initial condition $y(-1)=3.$\n\n- System II is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\n- System III is not a first-order initial value problem. It consists of a *second*-order differential equation $3{y}^{''}=4y$ together with *two* initial conditions $y(-1)=0,\\,{y}^{'}(-1)=1.$ This is a second-order initial value problem.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186257321 :knowledge-point/_questions [{:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3b5b0b3-de77-56f3-bf94-531240a537e4" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x} − (1)/(x)" :db/id #edb/ref 17592186270352} {:answer/id #uuid "e102aba9-efc7-5e16-a4f6-2df0d7684d11" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x}\\ln 11 − (5)/(x)" :db/id #edb/ref 17592186270353} {:answer/id #uuid "24a6eb9d-f91a-5f4a-8b9c-e37259232e5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 11 + (5)/(x)" :db/id #edb/ref 17592186270354} {:answer/id #uuid "6a021199-6636-5bbb-bcc8-3e16482a4695" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186270355} {:answer/id #uuid "94fe2d20-3000-5414-8833-90f6a86c2777" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x}\\ln x − (1)/(x)" :db/id #edb/ref 17592186270356}] :answer-field/correct {:answer/id #uuid "6a021199-6636-5bbb-bcc8-3e16482a4695" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186270355} :answer-field/id #uuid "3770b1d3-4840-565c-bb8e-fd95d39faa11" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274346}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6efa523e-e3d2-57fc-85c3-4bc45ebc82f5" :question/math-academy-id "q-11914" :question/problem "Given that $y=5\\operatorname{ln}x-3{x}^{2}+2x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}x-3{x}^{2}+2x) \\\\  & =5(\\frac{1}{x})-3\\cdot 2x+2 \\\\  & =\\frac{5}{x}-6x+2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257605 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f975e5c-637e-57f6-a193-68254799e79b" :knowledge-point/title "Calculating a Sum of Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fbe71f8-8a60-54b2-aded-6f12678f7bff" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186270652} {:answer/id #uuid "0c2ca2c0-c63d-5b5f-b088-cd1923d1c87c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186270653} {:answer/id #uuid "75a47090-047f-5982-a4db-b595cf3c5323" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186270654} {:answer/id #uuid "07c29c9f-ec12-5a36-a99d-fe277ef874c9" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186270655} {:answer/id #uuid "3f47939b-574b-5919-b068-c31a3592dae7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186270656}] :answer-field/correct {:answer/id #uuid "3f47939b-574b-5919-b068-c31a3592dae7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186270656} :answer-field/id #uuid "8798d905-263c-5a8b-997d-2afb339096a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274406}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8c0a953b-56c6-5668-952a-c90e6b1ea708" :question/math-academy-id "q-124064" :question/problem "If ${\\sum }_{n=1}^{\\infty }{a}_{n}=-\\frac{3}{4}$, \nthen calculate ${\\sum }_{n=1}^{\\infty }8{a}_{n}.$" :question/worked-solution "Taking the constant factor outside of the summation sign gives\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }8{a}_{n} & =8{\\sum }_{n=1}^{\\infty }{a}_{n} \\\\  & =8(-\\frac{3}{4}) \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257611 :knowledge-point/_questions [{:knowledge-point/id #uuid "facb6c88-0c98-5f97-a0bf-1fe64a18c96f" :knowledge-point/title "Removing a Finite Number of Terms From a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e27595-0a81-5428-9abb-089c83c08a05" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257613} {:answer/id #uuid "9345163d-02cc-5438-87af-72f9c7ee5893" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257614} {:answer/id #uuid "1c66f9e1-7093-5248-babb-26644ce91839" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257615} {:answer/id #uuid "3f944afb-cc01-513f-8688-1027dbd1a9e3" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257616} {:answer/id #uuid "b7ce0565-dbc7-52a4-b169-d172edd975cc" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257617} {:answer/id #uuid "33220375-c9f2-51c0-b090-41092480c806" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257618} {:answer/id #uuid "442a40ce-f652-5e35-8b50-d1e22420cb13" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257619} {:answer/id #uuid "4ec4cb49-cedd-56c8-9b45-dc0e15e2bbd1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257620}] :answer-field/correct {:answer/id #uuid "4ec4cb49-cedd-56c8-9b45-dc0e15e2bbd1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257620} :answer-field/id #uuid "d2d0d90d-66d3-54f5-a712-29e05a119d40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257612}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f70941eb-1b43-57e6-9bb7-b412bbea5880" :question/math-academy-id "q-124085" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, which of the following statements is true regarding the series ${\\sum }_{n=k}^{\\infty }{a}_{n},$ where $k$ is a positive integer, and ${a}_{n}$ is well-defined for all $n⩾1?$\n\nI. - It is convergent for $1<k\\le 500$\nII. - It is divergent for $k>500$\nIII. - It is convergent for $50<k\\le 100$" :question/worked-solution "Removing the first $k-1$ terms from a divergent series results in a divergent series.\n\nMore precisely, assume ${a}_{n}$ is well-defined for $n\\ge 1$ and $k\\ge 1$ is an integer. Then, we have the following:\n\n*If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also divergent.*\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186257760 :knowledge-point/_questions [{:knowledge-point/id #uuid "ead28b84-1f92-510d-87b3-07eb9a394622" :knowledge-point/title "Determining Whether a p-Series with Integer Exponent Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f729811-bd6a-582a-a60c-3106fd18758a" :answer/type {:db/ident :answer.type/math} :answer/value "3(18)" :db/id #edb/ref 17592186270757} {:answer/id #uuid "72c3bdf4-c961-543d-8eac-cf032024aba4" :answer/type {:db/ident :answer.type/math} :answer/value "2(18)" :db/id #edb/ref 17592186270758} {:answer/id #uuid "626ddfaa-92c7-5aa3-a97d-7863319b062b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(18)" :db/id #edb/ref 17592186270759} {:answer/id #uuid "2cca689f-6824-5332-a429-5be5f64bb755" :answer/type {:db/ident :answer.type/math} :answer/value "-(18)" :db/id #edb/ref 17592186270760} {:answer/id #uuid "f2d65576-de3b-5b8f-9887-bb7b825702f6" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186270761}] :answer-field/correct {:answer/id #uuid "f2d65576-de3b-5b8f-9887-bb7b825702f6" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186270761} :answer-field/id #uuid "e4585eb6-5635-51e9-a0cf-8a5e31770d8b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274427}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0cf29daa-b0e5-53b9-baa2-725e5b094a4a" :question/math-academy-id "q-125241" :question/problem "Use the $p$-test to determine whether the series below converges or diverges.\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{18}{{n}^{9}}\n$$" :question/worked-solution "The series can be written as\n\n$$\n18{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{9}}.\n$$\n\nThis is a $p$-series with $p=9.$ Since $p>1,$ the series is convergent.\n\nNote that the factor of $18$ multiplying the series has no effect on the convergence/divergence of the series."}] [{:db/id #edb/ref 17592186257799 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4dff2ea-a90b-5618-82fc-647a40be0c46" :knowledge-point/title "Convergence Parameters for p-Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb0826d0-c6a1-502b-b55b-0f781f64d3d7" :answer/type {:db/ident :answer.type/math} :answer/value "q<\\frac{1}{3}" :db/id #edb/ref 17592186270772} {:answer/id #uuid "a2849a98-5f3b-5041-b6ce-f5f6c138ba61" :answer/type {:db/ident :answer.type/math} :answer/value "q > 1" :db/id #edb/ref 17592186270773} {:answer/id #uuid "b766c353-4791-557a-b172-e4138f946334" :answer/type {:db/ident :answer.type/math} :answer/value "q < 1" :db/id #edb/ref 17592186270774} {:answer/id #uuid "ee22fb73-6cdc-5315-a384-b6889c6621de" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186270775} {:answer/id #uuid "c2c81154-ea11-5c96-b2ef-c37be7663aa3" :answer/type {:db/ident :answer.type/math} :answer/value "q < 0" :db/id #edb/ref 17592186270776}] :answer-field/correct {:answer/id #uuid "fb0826d0-c6a1-502b-b55b-0f781f64d3d7" :answer/type {:db/ident :answer.type/math} :answer/value "q<\\frac{1}{3}" :db/id #edb/ref 17592186270772} :answer-field/id #uuid "09143fda-c88d-5810-bf93-51b02769ef70" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274430}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20934715-7c64-505f-835c-e42219a4ae63" :question/math-academy-id "q-125404" :question/problem "For which values of $q$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2-3q}}$ converge?" :question/worked-solution "A $p$-series is any series that takes the form\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{p}},\n$$\n\nwhere $p$ is a constant. The $p$-series test states that\n\n- if $p>1,$ then the series converges, while\n\n- if $p\\le 1,$ then the series diverges.\n\nComparing our series to the $p$-series, we have\n\n$$\np=2-3q.\n$$\n\nAccording to the $p$-series test, the given series converges if\n\n$$\n2-3q>1\\,⟹\\,q<\\frac{1}{3}.\n$$\n\nTherefore, the series is convergent for all $q<\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186257928 :knowledge-point/_questions [{:knowledge-point/id #uuid "c9368b4e-a855-5fab-b074-a3a505c7ab0c" :knowledge-point/title "Computing the Limit of Sine or Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b378bd0a-7b2a-59c0-b5a3-7a1f694c97a0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186257930}] :answer-field/correct {:answer/id #uuid "b378bd0a-7b2a-59c0-b5a3-7a1f694c97a0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186257930} :answer-field/id #uuid "03906845-5b9e-5247-b7d2-a1ef31e58f50" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257929}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c6346f18-6a05-5cb3-99b6-ef873ed75441" :question/math-academy-id "q-133321" :question/problem "Find ${lim}_{x\\to \\,\\pi }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,\\pi }f(x)=$\n{{field-1}}" :question/worked-solution "Substituting $x=\\pi $ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi }f(x) & ={lim}_{x\\to \\,\\pi }6\\operatorname{sin}(\\frac{x}{3}) \\\\  & =6\\operatorname{sin}(\\frac{\\pi }{3}) \\\\  & =6\\operatorname{sin}(\\frac{\\pi }{3}) \\\\  & =6\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257931 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fbbd792-e05f-5d77-acab-60a061084f05" :knowledge-point/title "Computing the Limit at Infinity of a Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d13a6b0-e0fd-57b9-9a8d-db15584f6682" :answer/type {:db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186257933}] :answer-field/correct {:answer/id #uuid "0d13a6b0-e0fd-57b9-9a8d-db15584f6682" :answer/type {:db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186257933} :answer-field/id #uuid "1953e4c1-cae1-5fbb-be88-88080280f26b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257932}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "78cb0bb2-b627-5822-b1ef-7eee7e62fe2f" :question/math-academy-id "q-133322" :question/problem "Find ${lim}_{x\\to \\,-\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,-\\infty }f(x)=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=f(x)=6\\operatorname{sin}(\\frac{x}{3}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/72a0459ee5db59562a19961d0304785fb8d46db8be24ad7839d4b8690b0dc835.png)\n\nAs $x$ decreases to $-\\infty $, the graph oscillates between the values $y=-6$ and $y=6$ indefinitely. Therefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }f(x)={lim}_{x\\to \\,-\\infty }6\\operatorname{sin}(\\frac{x}{3})=DNE.\n$$"}] [{:db/id #edb/ref 17592186257934 :knowledge-point/_questions [{:knowledge-point/id #uuid "4fec231d-3911-55db-99af-5e3656333afc" :knowledge-point/title "Calculating the Average Rate of Change Over a Varying Interval where the Parameter Represents Distance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62dc3b45-a815-59c2-b2dc-522571722f92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{h}\\operatorname{sin}(\\pi +\\frac{h}{3})" :db/id #edb/ref 17592186257936}] :answer-field/correct {:answer/id #uuid "62dc3b45-a815-59c2-b2dc-522571722f92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{h}\\operatorname{sin}(\\pi +\\frac{h}{3})" :db/id #edb/ref 17592186257936} :answer-field/id #uuid "be226e8c-bccd-5fef-9814-1659f67fd685" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257935}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15d329ae-5740-515c-97ca-1733812dca77" :question/math-academy-id "q-133323" :question/problem "What is the average rate of change of the function $f(x)$ over the interval $x\\in [3\\pi ,3\\pi +h],$ where $h>0$ is a parameter? Express your answer in terms of $h.$\n\n$\\frac{Δf}{Δx}\\,=\\,$\n{{field-1}}" :question/worked-solution "We have the function $f(x)=6\\operatorname{sin}(\\frac{x}{3}).$ Notice that we are given the length $h$ of the interval. So, the average rate of change of $f$ over this interval is given by\n\n$$\n\\frac{Δf}{Δx}=\\frac{f(a+h)-f(a)}{h},\n$$\n\nwith $a=3\\pi .$ Substituting into the formula and simplifying gives\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(a+h)-f(a)}{h} \\\\  & =\\frac{f(3\\pi +h)-f(3\\pi )}{h} \\\\  & =\\frac{6\\operatorname{sin}(\\frac{1}{3}(3\\pi +h))-6\\operatorname{sin}(\\frac{1}{3}\\cdot 3\\pi )}{h} \\\\  & =\\frac{6\\operatorname{sin}(\\pi +\\frac{h}{3})-6\\operatorname{sin}(\\pi )}{h} \\\\  & =\\frac{6\\operatorname{sin}(\\pi +\\frac{h}{3})-6(0)}{h} \\\\  & =\\frac{6\\operatorname{sin}(\\pi +\\frac{h}{3})}{h} \\\\  & =\\frac{6}{h}\\operatorname{sin}(\\pi +\\frac{h}{3})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257937 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e2b72a2-c486-5a7a-a65e-57e83b78f6cc" :knowledge-point/title "Identifying the Limit at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93e8b85a-cbcf-55fd-b21d-724a4d35c312" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257939}] :answer-field/correct {:answer/id #uuid "93e8b85a-cbcf-55fd-b21d-724a4d35c312" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257939} :answer-field/id #uuid "b4c911e3-9ea8-5569-8799-f7127763fe8d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c776c27-a6a4-5d10-97a0-9fb241329ba9" :question/math-academy-id "q-133324" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1186087a359b3065400101c7f436c3e885bf937477bdd9f73fbdaab6771aa48a.png)\n\nThe graph of the function $g(h)$ is shown above, where\n\n$$\ng(h)=\\frac{6}{h}\\operatorname{sin}(\\pi +\\frac{h}{3}).\n$$\n\nFrom the graph, what is ${lim}_{h\\to \\,0}g(h)?$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{h\\to \\,0}g(h)=$\n{{field-1}}" :question/worked-solution "The graph shows that as we approach $h=0$ from the left, the $y$ value approaches $-2.$ So, the left-hand limit is\n\n$$\n{lim}_{h\\to \\,{0}^{-}}g(h)=-2.\n$$\n\nSimilarly, when we approach $h=0$ from the right, the $y$ value approaches $-2.$ So, the right-hand limit is\n\n$$\n{lim}_{h\\to \\,{0}^{+}}g(h)=-2.\n$$\n\nSince both the left and right-hand limits exist and are equal to $-2,$ we conclude that\n\n$$\n{lim}_{h\\to \\,0}g(h)=-2.\n$$"}] [{:db/id #edb/ref 17592186257940 :knowledge-point/_questions [{:knowledge-point/id #uuid "f59b65fa-d395-5ef3-9a28-1c74301c8104" :knowledge-point/title "Computing the Limit of a Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1be0dd-6f4a-5f0d-8efe-3d4f02a58b14" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186257942}] :answer-field/correct {:answer/id #uuid "6f1be0dd-6f4a-5f0d-8efe-3d4f02a58b14" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186257942} :answer-field/id #uuid "775c24c3-fadf-52a7-91fb-f17a6c72d16f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257941}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "578e3510-260f-5bdc-b7f3-7223ae9ac6f4" :question/math-academy-id "q-133325" :question/problem "Find ${lim}_{x\\to \\,(3\\pi )^{-}}\\frac{1}{f(x)}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,(3\\pi )^{-}}\\frac{1}{f(x)}=$\n{{field-1}}" :question/worked-solution "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3\\pi )^{-}}\\frac{1}{f(x)} & ={lim}_{x\\to (3\\pi )^{-}}\\frac{1}{6\\operatorname{sin}(\\frac{x}{3})} \\\\  & =\\frac{1}{6\\operatorname{sin}(\\frac{3\\pi }{3})} \\\\  & =\\frac{1}{6\\operatorname{sin}(\\pi )} \\\\  & =\\frac{1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\frac{1}{6\\operatorname{sin}(\\frac{x}{3})}=\\frac{1}{6}\\operatorname{csc}(\\frac{x}{3}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/42869c56604cbec85b5e4915f77b42e72444b7d9d117e140d9eba56b58c0f131.png)\n\nFrom the graph, as $x$ approaches $3\\pi $ from the left, the values of $y=\\frac{1}{6}\\operatorname{csc}(\\frac{x}{3})$ are positive and increase without bound. Therefore,\n\n$$\n{lim}_{x\\to (3\\pi )^{-}}\\frac{1}{f(x)}={lim}_{x\\to \\,(3\\pi )^{-}}\\frac{1}{6}\\operatorname{csc}(\\frac{x}{3})=\\infty .\n$$"}] [{:db/id #edb/ref 17592186257943 :knowledge-point/_questions [{:knowledge-point/id #uuid "2072b915-15f9-5296-96dd-707e38df3d10" :knowledge-point/title "Calculating the Limit of a Rational Function With One Quadratic Term by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "039afb05-3dd1-55c1-8034-3ea673ee4a22" :answer/type {:db/ident :answer.type/math} :answer/value "1/4" :db/id #edb/ref 17592186257945}] :answer-field/correct {:answer/id #uuid "039afb05-3dd1-55c1-8034-3ea673ee4a22" :answer/type {:db/ident :answer.type/math} :answer/value "1/4" :db/id #edb/ref 17592186257945} :answer-field/id #uuid "209517ec-e06e-50a2-b3b4-440b13e55c97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257944}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8c3c9278-79a7-5543-b4fd-fdc095dcc49a" :question/math-academy-id "q-133326" :question/problem "Find ${lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n{lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}=\\frac{2-2}{(2)^{2}-4}=\\frac{0}{0}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{x-2}{{x}^{2}-4} & =\\frac{x-2}{(x-2)(x+2)} \\\\  & =\\frac{\\cancel{x-2}}{\\cancel{(x-2)}(x+2)} \\\\  & =\\frac{1}{x+2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4} & ={lim}_{x\\to \\,2}\\frac{1}{x+2} \\\\  & =\\frac{1}{2+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257946 :knowledge-point/_questions [{:knowledge-point/id #uuid "5feb914d-efad-5d89-85a9-db99befc9928" :knowledge-point/title "Applying the Product Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f4ed6e-501b-5b5e-9497-a5e6e518ce62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186257948}] :answer-field/correct {:answer/id #uuid "25f4ed6e-501b-5b5e-9497-a5e6e518ce62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186257948} :answer-field/id #uuid "7e480ad3-4c1f-58fa-acab-2ec945f606c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257947}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8555738f-0375-5e38-b16f-5d036c583f49" :question/math-academy-id "q-133327" :question/problem "Find ${lim}_{x\\to \\,2}\\frac{(x-2)f(x)}{{x}^{2}-4}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,2}\\frac{(x-2)f(x)}{{x}^{2}-4}=$\n{{field-1}}$\\cdot \\operatorname{sin}(\\frac{2}{3})$" :question/worked-solution "Previously, we found that \n\n$$\n{lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}=\\frac{1}{4}.\n$$\n\n \n\nApplying the product rule to the original limit, we obtain the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}\\frac{(x-2)f(x)}{{x}^{2}-4} & ={lim}_{x\\to \\,2}[\\frac{x-2}{{x}^{2}-4}\\cdot f(x)] \\\\  & ={lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}\\cdot {lim}_{x\\to \\,2}f(x) \\\\  & ={lim}_{x\\to \\,2}\\frac{x-2}{{x}^{2}-4}\\cdot {lim}_{x\\to \\,2}6\\operatorname{sin}(\\frac{x}{3}) \\\\  & =(\\frac{1}{4})\\cdot 6\\operatorname{sin}(\\frac{2}{3}) \\\\  & =\\frac{3}{2}\\cdot \\operatorname{sin}(\\frac{2}{3})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257949 :knowledge-point/_questions [{:knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e6cb36b-ea61-5db1-94ea-22b111e20e8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{(2\\pi +3)^{2}}" :db/id #edb/ref 17592186257951}] :answer-field/correct {:answer/id #uuid "7e6cb36b-ea61-5db1-94ea-22b111e20e8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{(2\\pi +3)^{2}}" :db/id #edb/ref 17592186257951} :answer-field/id #uuid "5f031406-cc55-59c4-9a75-ffc70113c109" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257950}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41f31c41-bebf-52ce-b67c-8ed460afd869" :question/math-academy-id "q-133328" :question/problem "Find ${lim}_{x\\to \\,\\pi }\\frac{\\sqrt{3}f(x)}{(2x+3)^{2}}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,\\pi }\\frac{\\sqrt{3}f(x)}{(2x+3)^{2}}=$\n{{field-1}}" :question/worked-solution "In part 1, we found that \n\n$$\n{lim}_{x\\to \\,\\pi }f(x)=3\\sqrt{3}.\n$$\n\n \n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\pi }\\frac{\\sqrt{3}f(x)}{(2x+3)^{2}} & =\\frac{{lim}_{x\\to \\,\\pi }(\\sqrt{3}f(x))}{{lim}_{x\\to \\,\\pi }(2x+3)^{2}}.\\end{aligned}\n$$\n\nNow, \n\n* applying the constant multiple rule in the numerator, and \n\n* the root rule, followed by the sum rule in the denominator, \n\nwe obtain the following:\n\n$$\n\\begin{aligned}\\frac{{lim}_{x\\to \\,\\pi }(\\sqrt{3}f(x))}{{lim}_{x\\to \\,\\pi }(2x+3)^{2}} & =\\frac{\\sqrt{3}\\cdot {lim}_{x\\to \\,\\pi }f(x)}{{({lim}_{x\\to \\,\\pi }(2x+3))}^{2}} \\\\  & =\\frac{\\sqrt{3}\\cdot (3\\sqrt{3})}{(2\\pi +3)^{2}} \\\\  & =\\frac{9}{(2\\pi +3)^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257952 :knowledge-point/_questions [{:knowledge-point/id #uuid "7b5c61a4-3c02-5f45-a6e7-97cf79923e9a" :knowledge-point/title "Finding the First Partial Sums of an Infinite Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "214cea84-cf05-523f-bebb-a3215775a2d2" :answer/type {:db/ident :answer.type/math} :answer/value "4+\\sqrt{3}" :db/id #edb/ref 17592186257954}] :answer-field/correct {:answer/id #uuid "214cea84-cf05-523f-bebb-a3215775a2d2" :answer/type {:db/ident :answer.type/math} :answer/value "4+\\sqrt{3}" :db/id #edb/ref 17592186257954} :answer-field/id #uuid "ca9b11ac-3c21-557c-a64c-fda1dd8a8667" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257953}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7b891d1c-e8f1-5953-9447-191cffc40004" :question/math-academy-id "q-133329" :question/problem "Find the third partial sum ${s}_{3}$ of the series ${\\sum }_{n=1}^{\\infty }\\frac{f(6n\\pi +\\pi )}{(\\sqrt{3})^{n}}.$\n\n${s}_{3}=$\n{{field-1}}" :question/worked-solution "Let's start by calculating the first three terms:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{f(6\\pi \\cdot 1+\\pi )}{(\\sqrt{3})^{1}}=\\frac{f(7\\pi )}{\\sqrt{3}}=\\frac{6\\operatorname{sin}(\\frac{7\\pi }{3})}{\\sqrt{3}}=\\frac{6\\sqrt{3}}{2\\cdot \\sqrt{3}}=3 \\\\ {a}_{2} & =\\frac{f(6\\pi \\cdot 2+\\pi )}{(\\sqrt{3})^{2}}=\\frac{f(13\\pi )}{3}=\\frac{6\\operatorname{sin}(\\frac{13\\pi }{3})}{3}=\\frac{6\\sqrt{3}}{2\\cdot 3}=\\sqrt{3} \\\\ {a}_{3} & =\\frac{f(6\\pi \\cdot 3+\\pi )}{(\\sqrt{3})^{3}}=\\frac{f(19\\pi )}{3\\sqrt{3}}=\\frac{6\\operatorname{sin}(\\frac{19\\pi }{3})}{3\\sqrt{3}}=\\frac{6\\sqrt{3}}{2\\cdot 3\\sqrt{3}}=1\\end{aligned}\n$$\n\nTherefore, the third partial sum is\n\n$$\n\\begin{aligned}{s}_{3} & ={a}_{1}+{a}_{2}+{a}_{3} \\\\  & =3+\\sqrt{3}+1 \\\\  & =4+\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257955 :knowledge-point/_questions [{:knowledge-point/id #uuid "55b978ec-9ec6-5349-a103-0c11d9a904c1" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbf4fa24-4330-573f-9a8d-bbd104e021f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{\\sqrt{3}-1}" :db/id #edb/ref 17592186257957}] :answer-field/correct {:answer/id #uuid "cbf4fa24-4330-573f-9a8d-bbd104e021f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{\\sqrt{3}-1}" :db/id #edb/ref 17592186257957} :answer-field/id #uuid "6a7c3b23-e791-5048-9fbd-09cfcdbc92e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257956}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cacbbb3f-0a1d-5dc5-9d6e-88b149a9ccf2" :question/math-academy-id "q-133330" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }\\frac{f(6n\\pi +\\pi )}{(\\sqrt{3})^{n}}$ is an infinite geometric series, compute its sum.\n\n${S}_{\\infty }=$\n{{field-1}}" :question/worked-solution "Previously, we evaluated the first few terms of the series:\n\n$$\n{a}_{1}=3,\\,{a}_{2}=\\sqrt{3},\\,{a}_{3}=1\n$$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term, and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=3,$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\sqrt{3}}{3}=\\frac{1}{\\sqrt{3}}.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{3}{1-(\\frac{1}{\\sqrt{3}})} \\\\  & =\\frac{3}{(\\frac{\\sqrt{3}-1}{\\sqrt{3}})} \\\\  & =\\frac{3\\sqrt{3}}{\\sqrt{3}-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258404 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d98bcee-d473-53b1-a6ef-1943d68702c3" :knowledge-point/title "Scalar Multiplication of a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6154da31-40ce-56cf-ae92-18ba65245998" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-1)" :db/id #edb/ref 17592186271085} {:answer/id #uuid "0f27516b-b4f9-5ea8-8913-c79fbea2920b" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186271086} {:answer/id #uuid "6f27dce1-6145-5343-9859-0ea0c740fd5c" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271087} {:answer/id #uuid "3875021f-1cd1-54d8-909c-7fad8464641e" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id #edb/ref 17592186271088} {:answer/id #uuid "d0b2eca1-7bf8-52c2-96c5-1abac050115d" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186271089}] :answer-field/correct {:answer/id #uuid "6f27dce1-6145-5343-9859-0ea0c740fd5c" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271087} :answer-field/id #uuid "d843b939-286d-5e84-be6f-a3e5eb9cd7bd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274493}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7176fbd8-b534-5d23-a9d2-78aa316ce007" :question/math-academy-id "q-156157" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, determine all real values of $K$ for which ${\\sum }_{n=1}^{\\infty }(1+{K}^{2})\\cdot {a}_{n}$ is divergent." :question/worked-solution "If we multiply the terms of a divergent series by a non-zero constant, the resulting series is divergent.\n\nHowever, the expression $1+{K}^{2}$ is always positive.\n\nTherefore, the series\n\n$$\n{\\sum }_{n=1}^{\\infty }(1+{K}^{2})\\cdot {a}_{n}\n$$\n\nis divergent for all $K.$"}] [{:db/id #edb/ref 17592186258418 :knowledge-point/_questions [{:knowledge-point/id #uuid "06ede1c9-b17d-504b-86a8-9284f7ded093" :knowledge-point/title "Finding the Zeros and Asymptotes of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77c01c87-2a26-5561-b241-e8590c29734e" :answer/type {:db/ident :answer.type/text} :answer/value "$y=-1$" :db/id #edb/ref 17592186271105} {:answer/id #uuid "6282fd75-f386-547a-9445-79467c7e9cec" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptotes" :db/id #edb/ref 17592186271106} {:answer/id #uuid "c6622ac3-b1d8-5bbe-94d1-f9fdf760854a" :answer/type {:db/ident :answer.type/text} :answer/value "$y=1$" :db/id #edb/ref 17592186271107} {:answer/id #uuid "52c3f3be-cf6b-5a44-815f-0f4118aeaf72" :answer/type {:db/ident :answer.type/text} :answer/value "$y=0$" :db/id #edb/ref 17592186271108}] :answer-field/correct {:answer/id #uuid "6282fd75-f386-547a-9445-79467c7e9cec" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptotes" :db/id #edb/ref 17592186271106} :answer-field/id #uuid "229c13dc-1c37-52cf-a633-445690e0ea5a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274497}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bc9adfeb-d883-541f-9bc6-0ae368d34338" :question/math-academy-id "q-156739" :question/problem "Which of the following is a horizontal asymptote of $y={log}_{8}x?$" :question/worked-solution "Let's recall the graph of $y={log}_{8}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/c9bc40573836e39bfb5c9ea0dab41b66ba7bb753bc7580936a3eb206b968e5c1.png)\n\nFrom the graph, we note that for $x>1$, the graph grows very slowly as we increase $x.$ \n\nWe say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nTherefore, there are no horizontal asymptotes."}] [{:db/id #edb/ref 17592186258421 :knowledge-point/_questions [{:knowledge-point/id #uuid "06ede1c9-b17d-504b-86a8-9284f7ded093" :knowledge-point/title "Finding the Zeros and Asymptotes of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3f41fbd-1cae-5aca-9180-704e9a1641c0" :answer/type {:db/ident :answer.type/text} :answer/value "$y=-1$" :db/id #edb/ref 17592186271109} {:answer/id #uuid "ce903413-5c67-503b-ad62-b31b4536ecd9" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptotes" :db/id #edb/ref 17592186271110} {:answer/id #uuid "a6c5f56b-ada4-5335-bc28-42b03a165652" :answer/type {:db/ident :answer.type/text} :answer/value "$y=1$" :db/id #edb/ref 17592186271111} {:answer/id #uuid "c9272bbb-5826-509a-b82d-4213a6f9981c" :answer/type {:db/ident :answer.type/text} :answer/value "$y=0$" :db/id #edb/ref 17592186271112}] :answer-field/correct {:answer/id #uuid "ce903413-5c67-503b-ad62-b31b4536ecd9" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptotes" :db/id #edb/ref 17592186271110} :answer-field/id #uuid "7327b4d7-aa2a-5430-8cef-be0558ac49df" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274498}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d0452204-fefa-5ed6-b9ea-ca7949b58b72" :question/math-academy-id "q-156741" :question/problem "Which of the following is a horizontal asymptote of $y={log}_{6}x?$" :question/worked-solution "Let's recall the graph of $y={log}_{6}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4177d9520b3758b29926eba7a7a74ed4c508d861e3c343f46c372ec79500fc9d.png)\n\nFrom the graph, we note that for $x>1$, the graph grows very slowly as we increase $x.$ \n\nWe say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nTherefore, there are no horizontal asymptotes."}] [{:db/id #edb/ref 17592186258424 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f" :knowledge-point/title "Identifying True Statements Regarding Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c449a5c-9956-5c45-bb3f-1595038ff2e9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258426} {:answer/id #uuid "2fa5e593-c292-526d-965e-73cca1ddab4d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258427} {:answer/id #uuid "4c7e53ce-1bbd-56fe-958e-a730dc197ffa" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258428} {:answer/id #uuid "eaba9b1d-0fae-50cc-8ec8-d77adfa6a6e7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258429} {:answer/id #uuid "e9be5aba-533d-57b5-a4e7-92b37a03a4c7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258430} {:answer/id #uuid "ddd04498-e892-5b43-8f3d-83b52b4c10c4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258431} {:answer/id #uuid "55e0dc77-c9f0-5ab9-8fb0-0a905ab4b185" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258432} {:answer/id #uuid "97f00078-2a9c-54b8-9d9b-3822a0e5f9af" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258433}] :answer-field/correct {:answer/id #uuid "e9be5aba-533d-57b5-a4e7-92b37a03a4c7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258430} :answer-field/id #uuid "0dc1a05f-0f59-55a8-ba28-ee76724d625c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258425}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fde27731-67b5-58df-9931-b7a1dd7d4277" :question/math-academy-id "q-156743" :question/problem "Which of the following statements are true regarding the function $y={log}_{6}x?$ \n\nI. - It has no zeros\nII. - $y\\to 6$ as $x\\to \\infty $\nIII. - It has a vertical asymptote at $x=0$" :question/worked-solution "Let's plot the graph of $y={log}_{6}x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d8d3f9dc995d8801d451b15129860362efa772178cdc3ef07be5adb6a1da5c45.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function has a zero at $x=1.$\n\n- Statement II is false. As $x$ increases, $y$ increases without bound. Therefore, $y\\to \\infty $ as $x\\to \\infty $\n\n- Statement III is true.\n\nIn conclusion, only statement III is true."}] [{:db/id #edb/ref 17592186258434 :knowledge-point/_questions [{:knowledge-point/id #uuid "ea24c558-8664-5b22-bdfc-71189a45a360" :knowledge-point/title "Scalar Multiplication of a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b761ca55-2ee7-52b9-80f6-46b73af05fc3" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186271113} {:answer/id #uuid "6f6a10f0-b4e3-5efe-8623-eaa867fca0df" :answer/type {:db/ident :answer.type/math} :answer/value "K < 2" :db/id #edb/ref 17592186271114} {:answer/id #uuid "ea5318ce-c9af-5fad-b0a5-28efcf770a9d" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271115} {:answer/id #uuid "efc7b0a2-12de-50fc-a4dd-4fd1cdde49dc" :answer/type {:db/ident :answer.type/math} :answer/value "K < 1" :db/id #edb/ref 17592186271116} {:answer/id #uuid "a0bc81fd-5473-515f-b9f2-a6952ae7345e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186271117}] :answer-field/correct {:answer/id #uuid "ea5318ce-c9af-5fad-b0a5-28efcf770a9d" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271115} :answer-field/id #uuid "57482141-bda7-557e-be60-2ca67bbeb457" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274499}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1c07bd47-618d-5265-96d8-88410bba9f45" :question/math-academy-id "q-156868" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, determine all real values of $K$ for which $(K+1)\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent." :question/worked-solution "Any constant multiple of a convergent series gives a convergent series. \n\nSo, $(K+1)\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent for all $K.$"}] [{:db/id #edb/ref 17592186258437 :knowledge-point/_questions [{:knowledge-point/id #uuid "ea24c558-8664-5b22-bdfc-71189a45a360" :knowledge-point/title "Scalar Multiplication of a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173a4e43-06da-5618-88af-f5afcb354d1e" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,\\infty)" :db/id #edb/ref 17592186271118} {:answer/id #uuid "d78c961b-bdb2-577b-91d8-357f87ea0197" :answer/type {:db/ident :answer.type/math} :answer/value "K < 2" :db/id #edb/ref 17592186271119} {:answer/id #uuid "1f0c4bf4-6d67-5d63-8a3c-489559759400" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271120} {:answer/id #uuid "cb09b68d-2c68-5bd4-9c10-aa5b858c6d45" :answer/type {:db/ident :answer.type/math} :answer/value "K < 1" :db/id #edb/ref 17592186271121} {:answer/id #uuid "41c4b5ed-9ea0-5fbb-b746-5e27d4897c7b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty,-3)" :db/id #edb/ref 17592186271122}] :answer-field/correct {:answer/id #uuid "1f0c4bf4-6d67-5d63-8a3c-489559759400" :answer/type {:db/ident :answer.type/math} :answer/value "K\\in\\mathbb R" :db/id #edb/ref 17592186271120} :answer-field/id #uuid "0597276b-91a8-54cf-9b7c-0f23e9479f46" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274500}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a93d0f2e-8dd2-5d9e-9eb1-2f2c0dc6b52a" :question/math-academy-id "q-156873" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, determine all real values of $K$ for which ${K}^{3}\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent." :question/worked-solution "Any constant multiple of a convergent series gives a convergent series. \n\nSo, ${K}^{3}\\cdot {\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent for all $K.$"}] [{:db/id #edb/ref 17592186258446 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d98bcee-d473-53b1-a6ef-1943d68702c3" :knowledge-point/title "Scalar Multiplication of a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f889c683-c5c7-51b5-800c-7dc690017278" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(2)" :db/id #edb/ref 17592186271133} {:answer/id #uuid "22b79a5b-1ec0-534e-871e-faf3866f346f" :answer/type {:db/ident :answer.type/math} :answer/value "2(2)" :db/id #edb/ref 17592186271134} {:answer/id #uuid "76fa3116-8500-5a28-a316-7797175c52ed" :answer/type {:db/ident :answer.type/math} :answer/value "3(2)" :db/id #edb/ref 17592186271135} {:answer/id #uuid "3451156b-4da8-5ddf-86f7-1431a7b47911" :answer/type {:db/ident :answer.type/math} :answer/value "-(2)" :db/id #edb/ref 17592186271136} {:answer/id #uuid "17da45ba-dca8-5442-906e-e32f95114f7c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271137}] :answer-field/correct {:answer/id #uuid "17da45ba-dca8-5442-906e-e32f95114f7c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271137} :answer-field/id #uuid "dcce3936-6d0e-5ada-9cb5-818ed6de70da" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274503}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6515e93f-5048-550d-a93c-1295e9ffd539" :question/math-academy-id "q-157059" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent,  determine all real values of $K$ for which  ${\\sum }_{n=1}^{\\infty }(\\frac{K}{2}-1)\\cdot {a}_{n}$ is **convergent.**" :question/worked-solution "If we multiply the terms of a divergent series by a non-zero constant, the resulting series is divergent.\n\nHowever, multiplying the terms of a divergent series by $0$ gives a series that converges to $0.$\n\nTherefore, the series \n\n$$\n{\\sum }_{n=1}^{\\infty }(\\frac{K}{2}-1)\\cdot {a}_{n}\n$$\n\nis convergent when\n\n$$\n\\begin{aligned}\\frac{K}{2}-1 & =0 \\\\ \\frac{K}{2} & =1 \\\\ K & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258449 :knowledge-point/_questions [{:knowledge-point/id #uuid "d74dd4ee-45f1-5ca7-ae6c-9cbb768ac636" :knowledge-point/title "Removing a Finite Number of Terms From a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fa0482b-bb1b-5a8f-8260-7563e97283f5" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186258451} {:answer/id #uuid "7d42eba7-2ff3-503d-b95d-6b7eb6cdb43f" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186258452}] :answer-field/correct {:answer/id #uuid "7d42eba7-2ff3-503d-b95d-6b7eb6cdb43f" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186258452} :answer-field/id #uuid "9a1e69e2-802e-563b-bdb3-25096f2cfd9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258450}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "11a1973e-aa91-5290-99cf-1bd17e28a67e" :question/math-academy-id "q-157060" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, which of the following is true regarding the series ${\\sum }_{n=85}^{\\infty }{a}_{n}?$" :question/worked-solution "Removing the first $k-1$ terms from a convergent series results in a convergent series.\n\nMore precisely, assume that $k\\ge 1$ is an integer. Then, we have the following:\n\n*If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.*\n\nSo, since ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, we have that ${\\sum }_{n=85}^{\\infty }{a}_{n}$ is also convergent."}] [{:db/id #edb/ref 17592186258453 :knowledge-point/_questions [{:knowledge-point/id #uuid "d74dd4ee-45f1-5ca7-ae6c-9cbb768ac636" :knowledge-point/title "Removing a Finite Number of Terms From a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9db9ea89-a83c-5057-b773-9aa10be347d1" :answer/type {:db/ident :answer.type/text} :answer/value "Diverges" :db/id #edb/ref 17592186258455} {:answer/id #uuid "1f9a4799-774c-58ae-8944-640de36765c6" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186258456}] :answer-field/correct {:answer/id #uuid "1f9a4799-774c-58ae-8944-640de36765c6" :answer/type {:db/ident :answer.type/text} :answer/value "Converges" :db/id #edb/ref 17592186258456} :answer-field/id #uuid "eae1f70e-1856-5bde-9d2c-039fc97bbfad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258454}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7099c532-a199-562f-8bf0-7842daffe958" :question/math-academy-id "q-157061" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, which of the following is true regarding the series ${\\sum }_{n=500}^{\\infty }{a}_{n}?$" :question/worked-solution "Removing the first $k-1$ terms from a convergent series results in a convergent series.\n\nMore precisely, assume that $k\\ge 1$ is an integer. Then, we have the following:\n\n*If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also convergent.*\n\nSo, since ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is convergent, we have that ${\\sum }_{n=500}^{\\infty }{a}_{n}$ is also convergent."}] [{:db/id #edb/ref 17592186258457 :knowledge-point/_questions [{:knowledge-point/id #uuid "facb6c88-0c98-5f97-a0bf-1fe64a18c96f" :knowledge-point/title "Removing a Finite Number of Terms From a Divergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57bd7a51-284e-5b66-b11f-cde3b70a46a6" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186258459} {:answer/id #uuid "df193af6-a205-5fbc-9010-7c149cf0304f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186258460} {:answer/id #uuid "dacc62f4-43bc-5b7b-a941-026a75dd859f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186258461} {:answer/id #uuid "a9501a14-d84d-5471-8838-5b058134ca7e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258462} {:answer/id #uuid "b7165fbb-94ce-504d-8e8d-a5797ebea533" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186258463} {:answer/id #uuid "8c9a7bbc-faa3-53ad-bb90-5b769f46612e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186258464} {:answer/id #uuid "f0e26266-1ff5-5e4b-972f-023b84d46d65" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186258465} {:answer/id #uuid "0ed63383-30c3-5004-be22-85e4846c9bb3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258466}] :answer-field/correct {:answer/id #uuid "0ed63383-30c3-5004-be22-85e4846c9bb3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186258466} :answer-field/id #uuid "5cba780f-da49-5d1d-9545-cc0c4c913504" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258458}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5b4cfd7c-15a9-5ca2-973b-6cc59e5854a8" :question/math-academy-id "q-157090" :question/problem "Given that ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, which of the following statements are true regarding the series ${\\sum }_{n=k}^{\\infty }{a}_{n},$ where $k$ is a positive integer, and ${a}_{n}$ is well-defined for all $n⩾1?$\n\nI. - It is convergent for $k>{5}^{10}$\nII. - It is divergent for all $k$\nIII. - It is convergent for $1<k<5$" :question/worked-solution "Removing the first $k-1$ terms from a divergent series results in a divergent series.\n\nMore precisely, assume ${a}_{n}$ is well-defined for $n\\ge 1$ and $k\\ge 1$ is an integer. Then, we have the following:\n\n*If ${\\sum }_{n=1}^{\\infty }{a}_{n}$ is divergent, then ${\\sum }_{n=k}^{\\infty }{a}_{n}$ is also divergent.*\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186258467 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d138d2c-3295-5eae-990d-42711f5792f1" :knowledge-point/title "Analyzing Statements Involving Sums of Convergent Series"}] :question/answer-fields [{: