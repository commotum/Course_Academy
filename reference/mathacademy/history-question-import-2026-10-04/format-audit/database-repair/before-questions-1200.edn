#{[{:db/id #edb/ref 17592186256477 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3dbb7fe-750e-5953-9a22-6daaaa63fb4a" :answer/type {:db/ident :answer.type/math} :answer/value "1.285" :db/id #edb/ref 17592186256479}] :answer-field/correct {:answer/id #uuid "c3dbb7fe-750e-5953-9a22-6daaaa63fb4a" :answer/type {:db/ident :answer.type/math} :answer/value "1.285" :db/id #edb/ref 17592186256479} :answer-field/id #uuid "f19c826c-626c-5bc4-83fd-030e4431b402" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "51214ed3-9217-5f35-8c62-58f93e8509fd" :question/math-academy-id "q-100673" :question/problem "Use a calculator to evaluate ${log}_{18}(41)$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{18}(41)$ by changing the base $18$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=18,$ $X=41,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{18}(41) & =\\frac{{log}_{10}(41)}{{log}_{10}(18)} \\\\  & =\\frac{\\operatorname{log}(41)}{\\operatorname{log}(18)} \\\\  & \\approx \\frac{1.612\\,784}{1.255\\,273} \\\\  & \\approx 1.285\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256541 :knowledge-point/_questions [{:knowledge-point/id #uuid "85687901-9285-5cd2-a5f2-24299bd7d3d5" :knowledge-point/title "Finding the Intersection of Two Intervals Given as Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6d1dce9-004e-5769-8953-fb9fe6ec2684" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,2]" :db/id #edb/ref 17592186256543}] :answer-field/correct {:answer/id #uuid "e6d1dce9-004e-5769-8953-fb9fe6ec2684" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,2]" :db/id #edb/ref 17592186256543} :answer-field/id #uuid "3dbff47b-b9f2-5ad0-a06a-f3b835005058" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256542}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "910e0483-5a9e-5329-b440-7a4f84a1a399" :question/math-academy-id "q-102007" :question/problem "Given the inequalities $-4<x\\le 2$ and $-1\\le x<4$, express their common set of solutions as an interval.\n\nAnswer: {{answer}}" :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/e862d5e61f97b3b1180f07dd80244524534ace031b1b67bb7b681ac1f245de26.png)\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/3ade64e9cfb1b5ab14ac31631f870e12b7b597e382c88715f97ca1df081e68d7.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4dcbbe3e83c10d02a84d61ab5800edcb38c93f48b23f72026440e8f88b1edca5.png)\n\nTherefore, the common set of values is\n$[-1,2].$"}] [{:db/id #edb/ref 17592186256544 :knowledge-point/_questions [{:knowledge-point/id #uuid "85687901-9285-5cd2-a5f2-24299bd7d3d5" :knowledge-point/title "Finding the Intersection of Two Intervals Given as Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d2a80c7-7b90-50dc-b319-e47dabd527e8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,4]" :db/id #edb/ref 17592186256546}] :answer-field/correct {:answer/id #uuid "4d2a80c7-7b90-50dc-b319-e47dabd527e8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,4]" :db/id #edb/ref 17592186256546} :answer-field/id #uuid "efb54118-162c-5ecb-8b80-6722864fce5b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256545}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8e633958-5056-5065-a6af-d8ca7e7764aa" :question/math-academy-id "q-102008" :question/problem "Given the inequalities $-2<x\\le 6$ and $-8\\le x\\le 4$, express their common set of solutions as an interval.\n\nAnswer: {{answer}}" :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d27fc4b96afb9056bd7850c1e1c89aa2723574c2dc28c828ec3b01fb0e784f5c.png)\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1dd975bf8c3016e337391f1f5884c5e2b6e1da831c569b89b5dfa850043c01bf.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/4e4205a4cfdb20ca75723691267ffc55f57d7584c657217a90294eef9e64a07b.png)\n\nTherefore, the common set of values is\n$(-2,4].$"}] [{:db/id #edb/ref 17592186256547 :knowledge-point/_questions [{:knowledge-point/id #uuid "d916584b-c94e-557f-a438-f0464c1cea87" :knowledge-point/title "Finding the Intersection of Three Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b5bf6fa-fcf6-5644-ae0f-ae3b74445740" :answer/type {:db/ident :answer.type/math} :answer/value "\\emptyset" :db/id #edb/ref 17592186256549}] :answer-field/correct {:answer/id #uuid "1b5bf6fa-fcf6-5644-ae0f-ae3b74445740" :answer/type {:db/ident :answer.type/math} :answer/value "\\emptyset" :db/id #edb/ref 17592186256549} :answer-field/id #uuid "84ed4f1a-9c1b-5d24-bcd2-4e1d4d74ae0a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256548}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f6a98b18-dfc3-507c-9faa-9a24dd2c20e2" :question/math-academy-id "q-102015" :question/problem "Given the inequalities $0<x<5,$ $\\,x\\le 1,$ and $\\,x>4$, What sets, expressed in interval notation, represents their common set of values?\n\nAnswer: {{answer}}" :question/worked-solution "To find the common set of values, we graph the inequalities on a number line and find where they overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/a187bf318e77f11eb2468bc23f9b84a3b8fd715ea43f07fe9c7e083ae5861491.png)\n\nFrom the graph above, we determine that there are no common points."}] [{:db/id #edb/ref 17592186256559 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce416271-d959-5f29-a613-74527db0fb36" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186256561} {:answer/id #uuid "8803f1cd-97ad-5de2-a183-cf168dc86ebb" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186256562} {:answer/id #uuid "a1943369-4326-5ce8-828f-6f497c0387c8" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186256563} {:answer/id #uuid "1a6b88e9-537f-5014-904c-2f3c5e74a690" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186256564} {:answer/id #uuid "0fe4a6d4-d9a3-509d-a10f-a48daed15eb4" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186256565} {:answer/id #uuid "3d948c4c-a856-5a84-a62a-0e142b8c5423" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186256566} {:answer/id #uuid "8b0aa4ce-2595-57a5-9575-ac87a8f8dd0a" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186256567} {:answer/id #uuid "e969ed7d-a030-5bbe-b5ff-e06b6ecf3ffc" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186256568}] :answer-field/correct {:answer/id #uuid "3d948c4c-a856-5a84-a62a-0e142b8c5423" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186256566} :answer-field/id #uuid "cbf8d454-a5e4-5c07-b361-eea7a481c457" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256560}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6b31ab2b-c4c5-5adb-93e3-725f33b127ef" :question/math-academy-id "q-102106" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d9cf9a5c61cbf1796cf6682b129b4c05171c364c7b34e7cce176ba27e9c9cb24.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\nI. - $x=-1$\nII. - $x=2$\nIII. - $x=4$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is continuous at $x=-1.$ The graph can be drawn in the neighborhood of $x=-1$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is continuous at $x=2.$ The graph can be drawn in the neighborhood of $x=2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is not continuous at $x=4.$ Since there is an asymptote at $x=4,$ it is impossible to draw the function in the neighborhood of $x=4$ without taking our pencil off of the paper.\n\nHence, the correct answer is  \"I and II only\".\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/95967eb82512aae261936a6c09e2f474c72c9a130d3ecb527f62408822d88c96.png)"}] [{:db/id #edb/ref 17592186256620 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9442754-d4d9-588b-9302-dd7a2e482a5b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256622}] :answer-field/correct {:answer/id #uuid "c9442754-d4d9-588b-9302-dd7a2e482a5b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256622} :answer-field/id #uuid "a8c0e081-89dc-5965-9267-824eb2083173" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256621}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "81f8219b-91a8-52ec-8e9f-7635a6f67073" :question/math-academy-id "q-103226" :question/problem "If $f(n+2)=f(n+1)+f(n)$ with $f(1)=0$ and $f(2)=2,$ then $f(4)=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute $f(4),$ we first need to compute $f(3).$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+2) & =f(n+1)+f(1) \\\\ f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =2+0 \\\\ f(3) & =2\\end{aligned}\n$$\n\nNext, to compute $f(4),$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =2+2 \\\\ f(4) & =4\\end{aligned}\n$$\n\nTherefore, $f(4)=4.$"}] [{:db/id #edb/ref 17592186256626 :knowledge-point/_questions [{:knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58aa1852-7367-551e-a37a-aae4cfbe78ae" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2" :db/id #edb/ref 17592186256628}] :answer-field/correct {:answer/id #uuid "58aa1852-7367-551e-a37a-aae4cfbe78ae" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2" :db/id #edb/ref 17592186256628} :answer-field/id #uuid "0d5d45e9-970b-5ec6-8525-0a0e9a5292bb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256627}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86d93e27-a5e1-5b45-a92f-58373db870a8" :question/math-academy-id "q-103615" :question/problem "Give an expression equivalent to $\\frac{18x-6}{3}?$\n\nAnswer: {{answer}}" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{18x-6}{3} & = \\\\ \\frac{18x}{3}-\\frac{6}{3} & = \\\\ \\frac{18}{3}\\cdot x-\\frac{6}{3} & = \\\\ 6\\cdot x-2 & = \\\\ 6x-2. & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256845 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e18d451-4c7d-5649-9a73-0b00fa5d26e8" :knowledge-point/title "Finding the Negative Square Root of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6aa369d-885f-586d-bdfd-9f032c4d4a1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{8}\\,\\text{i}" :db/id #edb/ref 17592186256847}] :answer-field/correct {:answer/id #uuid "a6aa369d-885f-586d-bdfd-9f032c4d4a1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{8}\\,\\text{i}" :db/id #edb/ref 17592186256847} :answer-field/id #uuid "88078637-009a-59cf-9066-8c70f1bd6a5c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256846}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd5a7ee1-e31e-503f-8ce9-191a315a879f" :question/math-academy-id "q-111717" :question/problem "$-\\sqrt{-8}=$\n\nAnswer: {{answer}}" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-8} & =-\\sqrt{8\\cdot (-1)} \\\\  & =-\\sqrt{8}\\cdot \\sqrt{-1} \\\\  & =-\\sqrt{8}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257167 :knowledge-point/_questions [{:knowledge-point/id #uuid "355573c6-a39e-5cd2-804f-bb07e2639ef7" :knowledge-point/title "Computing the Probability of the Complement of an Event: Symbolic Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71109537-5d34-5063-b2cc-92d751d6c0ea" :answer/type {:db/ident :answer.type/text} :answer/value "The patient is a smoker" :db/id #edb/ref 17592186257169} {:answer/id #uuid "1694fcf5-640e-59e5-9571-f2a08d9ddcad" :answer/type {:db/ident :answer.type/text} :answer/value "The patient is not a smoker" :db/id #edb/ref 17592186257170}] :answer-field/correct {:answer/id #uuid "1694fcf5-640e-59e5-9571-f2a08d9ddcad" :answer/type {:db/ident :answer.type/text} :answer/value "The patient is not a smoker" :db/id #edb/ref 17592186257170} :answer-field/id #uuid "402bb104-7405-5d66-aabd-ca4094fb9864" :answer-field/key "complement-event" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186257168} {:answer-field/choices [{:answer/id #uuid "5a35fb8f-d89c-565c-9fb6-7a7ddaee8c0e" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186257172}] :answer-field/correct {:answer/id #uuid "5a35fb8f-d89c-565c-9fb6-7a7ddaee8c0e" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186257172} :answer-field/id #uuid "b1f30e9b-cffc-5a2e-98ab-4d61c92e0d17" :answer-field/key "complement-probability" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257171}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d2dcf9c8-21c2-5756-902c-6ae34835148c" :question/math-academy-id "q-11670" :question/problem "A nutritionist has $25$ patients. Of his patients, $10$ of them are smokers, and $15$ of them have diabetes. We randomly select a patient among the $25$ patients. \n\nDefine $A$ to be the event \"the patient is a smoker.\" What is ${A}^{'}$ described in natural language, and what is $P({A}^{'})?$\n\nComplement event: {{complement-event}}\n\nComplement probability: {{complement-probability}}" :question/worked-solution "The **complement** of an event $A,$ denoted ${A}^{'},$ is the *opposite* of $A.$ That is to say, ${A}^{'}$  is the set of outcomes in which $A$ *does not* happen.\n\nHere, ${A}^{'}$ is the opposite of the event \"the patient is a smoker.\" So ${A}^{'}$ is the event \"the patient doesn't smoke.\" \n\nNow, let's calculate the probability $P({A}^{'}).$  There are $25$ patients, and $10$ of them are smokers, so there are $25-10=15$ non-smokers. Therefore, \n\n$$\nP({A}^{'})=\\frac{15}{25}=0.6.\n$$"}] [{:db/id #edb/ref 17592186257348 :knowledge-point/_questions [{:knowledge-point/id #uuid "355573c6-a39e-5cd2-804f-bb07e2639ef7" :knowledge-point/title "Computing the Probability of the Complement of an Event: Symbolic Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d002352a-cabf-5b87-813c-d520928bb3a5" :answer/type {:db/ident :answer.type/text} :answer/value "The participant has black hair" :db/id #edb/ref 17592186257350} {:answer/id #uuid "6d28ce5d-3252-5bfc-8b9d-30c90d229c50" :answer/type {:db/ident :answer.type/text} :answer/value "The participant has brown hair" :db/id #edb/ref 17592186257351}] :answer-field/correct {:answer/id #uuid "6d28ce5d-3252-5bfc-8b9d-30c90d229c50" :answer/type {:db/ident :answer.type/text} :answer/value "The participant has brown hair" :db/id #edb/ref 17592186257351} :answer-field/id #uuid "23b2594d-cab3-5737-9737-16ecb75f11d2" :answer-field/key "complement-event" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186257349} {:answer-field/choices [{:answer/id #uuid "6e683226-0127-5948-9917-9e280c6dfe37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac23" :db/id #edb/ref 17592186257353}] :answer-field/correct {:answer/id #uuid "6e683226-0127-5948-9917-9e280c6dfe37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac23" :db/id #edb/ref 17592186257353} :answer-field/id #uuid "8d0a21ef-d89d-5675-a3c4-6cd3830ce411" :answer-field/key "complement-probability" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257352}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e8e1a657-7b1c-5430-8f0a-97245cf198c9" :question/math-academy-id "q-119652" :question/problem "Of $12$ people attending a seminar, $4$ participants have black hair, and the rest have brown hair. Define $A$ to be the event \"a participant has black hair.\" What is ${A}^{'}$ described in natural language, and what is $P({A}^{'})?$\n\nComplement event: {{complement-event}}\n\nComplement probability: {{complement-probability}}" :question/worked-solution "The **complement** of an event $A,$ denoted ${A}^{'},$ is the *opposite* of $A.$ That is to say, ${A}^{'}$  is the set of outcomes in which $A$ *does not* happen.\n\nHere, ${A}^{'}$ is the opposite of the event \"a participant has black hair.\" So ${A}^{'}$ is the event \"a participant doesn't have black hair.\" In other words, the event ${A}^{'}$ is \"a participant has brown hair.\"\n\nNow, let's calculate the probability $P({A}^{'}).$ The sample space is \n\n$$\nS={\\text{black hair, brown hair}},\n$$\n\nand since there is a different number of participants with of each hair color, we have different probabilities of a participant having \"black hair\" or \"brown hair.\"\n\nOf $12$ people, $8$ of them have brown hair. Therefore, \n\n$$\nP({A}^{'})=\\frac{8}{12}=\\frac{2}{3}.\n$$"}] [{:db/id #edb/ref 17592186257354 :knowledge-point/_questions [{:knowledge-point/id #uuid "355573c6-a39e-5cd2-804f-bb07e2639ef7" :knowledge-point/title "Computing the Probability of the Complement of an Event: Symbolic Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "716804fe-fe83-5eb6-97aa-e9f5d1111d2d" :answer/type {:db/ident :answer.type/text} :answer/value "Mary wears an orange shirt" :db/id #edb/ref 17592186257356} {:answer/id #uuid "5d585645-c63f-5b50-a0ed-ac4876f0498b" :answer/type {:db/ident :answer.type/text} :answer/value "Mary does not wear an orange shirt" :db/id #edb/ref 17592186257357}] :answer-field/correct {:answer/id #uuid "5d585645-c63f-5b50-a0ed-ac4876f0498b" :answer/type {:db/ident :answer.type/text} :answer/value "Mary does not wear an orange shirt" :db/id #edb/ref 17592186257357} :answer-field/id #uuid "1085e064-35c0-5fd5-ab8e-1c897de5de71" :answer-field/key "complement-event" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186257355} {:answer-field/choices [{:answer/id #uuid "b12f6170-556d-5008-b51e-bdf278ffac3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac34" :db/id #edb/ref 17592186257359}] :answer-field/correct {:answer/id #uuid "b12f6170-556d-5008-b51e-bdf278ffac3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac34" :db/id #edb/ref 17592186257359} :answer-field/id #uuid "8e40d33c-09bb-5da4-9ca6-86df1b6bc0c5" :answer-field/key "complement-probability" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257358}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c05ffc72-f224-50a5-b7b1-6c15fbd2efb9" :question/math-academy-id "q-119653" :question/problem "Mary owns $5$ orange shirts, and $15$ shirts in other colors. Define $A$ to be the event \"Mary wears an orange shirt.\" What is ${A}^{'}$ described in natural language, and what is $P({A}^{'})?$\n\nComplement event: {{complement-event}}\n\nComplement probability: {{complement-probability}}" :question/worked-solution "The **complement** of an event $A,$ denoted ${A}^{'},$ is the *opposite* of $A.$ That is to say, ${A}^{'}$  is the set of outcomes in which $A$ *does not* happen.\n\nHere, ${A}^{'}$ is the opposite of the event \"Mary wears an orange shirt.\" So ${A}^{'}$ is the event \"Mary doesn't wear an orange shirt.\" In other words, the event ${A}^{'}$ is \"Mary wears a non-orange shirt.\"\n\nNow, let's calculate the probability $P({A}^{'}).$ The sample space is \n\n$$\nS={\\text{orange shirt, non-orange shirt}},\n$$\n\nand since there is a different number of shirts of each color, we have different probabilities of having an \"orange\" or \"non-orange\" shirt.\n\nMary owns $20$ shirts, and $15$ of them are non-orange. Therefore,\n\n$$\nP({A}^{'})=\\frac{15}{20}=\\frac{3}{4}.\n$$"}] [{:db/id #edb/ref 17592186257360 :knowledge-point/_questions [{:knowledge-point/id #uuid "081e58b9-a8ba-5ad7-8e1c-8f8510a33587" :knowledge-point/title "Identifying True Statements Regarding an Event and its Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ad92fe-06ee-57cb-aec2-77491ac1bb6e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186257362} {:answer/id #uuid "940c2463-620e-5c9c-b7fe-91995fe351c5" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257363} {:answer/id #uuid "3d67ee63-54ab-5bf4-8076-feb68e3aa3e2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257364} {:answer/id #uuid "f70090e3-98ef-5f3f-b28c-00eb47513251" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186257365} {:answer/id #uuid "bce7f2da-3789-5c2b-8e94-19ed4626c645" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257366} {:answer/id #uuid "226a80ab-c24c-5168-9995-96b4cdccd0e2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257367} {:answer/id #uuid "653dfee8-c0bc-5bea-86ab-851d707ca336" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186257368} {:answer/id #uuid "e1c0e67e-d808-53cd-9858-cc01631827c5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257369}] :answer-field/correct {:answer/id #uuid "3d67ee63-54ab-5bf4-8076-feb68e3aa3e2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186257364} :answer-field/id #uuid "4b17352a-c753-5c59-820d-fe9d7e06eb41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257361}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ccb354f9-ccd4-5d1d-9d93-05b8eecb5e81" :question/math-academy-id "q-119661" :question/problem "Two fair $6$-sided dice are rolled. Define $A$ to be the event \"the sum of outcomes is a prime number\" Which of the following statements are true regarding this event?\n\nI. - $P(A)=0.42$ to $2$ decimal places\nII. - ${A}^{'}$ is the event \"the sum of the outcomes is an even number\"\nIII. - $P({A}^{'})=0.58$ to $2$ decimal places" :question/worked-solution "Let's inspect each statement in turn.\n\n- Statement I is true. There are $36$ possible outcomes and $15$ of these have the sum of the outcomes equal to a prime, namely \n\n$$\n\\begin{aligned} & (1,1),(1,2),(2,1),(1,4),(4,1),(2,3),(3,2),(1,6), \\\\  & (6,1),(3,4),(4,3),(2,5),(5,2),(5,6),(6,5).\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(A)=\\frac{15}{36}=0.42\n$$\n\nto $2$ decimal places.\n\n- Statement II is false. The complement of $A$ is the event ${A}^{'},$ \"the sum of the outcomes is a composite number\".\n\n- Statement III is true. Since we know that $P(A)=0.42$ to $2$ decimal places, we can calculate $P({A}^{'})$ using the formula\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ P({A}^{'}) & =1-P(A) \\\\  & =1-0.42 \\\\  & =0.58.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186257370 :knowledge-point/_questions [{:knowledge-point/id #uuid "732b0025-3172-5685-aa98-1f4afcf387ab" :knowledge-point/title "Computing the Probability of the Complement of an Event: Verbal Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0c7da23-01a0-51be-9e7e-72e594b04dd3" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186257372}] :answer-field/correct {:answer/id #uuid "c0c7da23-01a0-51be-9e7e-72e594b04dd3" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186257372} :answer-field/id #uuid "4d625369-3894-5861-8ca4-9400a3db1aba" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257371}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "76002dd4-3fa5-5b97-999e-21ec06af100c" :question/math-academy-id "q-119699" :question/problem "Three balls are drawn from a bag that contains $5$ white balls and $4$ black balls. Define $A$ to be the event \"at least one white ball is drawn.\" It is known that $P(A)=0.95$ to $2$ decimal places. To two decimal places, what is the probability of drawing three black balls?\n\nAnswer: {{answer}}" :question/worked-solution "The event \"three black balls are drawn\" is the opposite of the event \"at least one white ball is drawn.\"\n\nSo, the event \"three black balls are drawn\" is the complement of $A,$ denoted ${A}^{'}.$\n\nSince we know that $P(A)=0.95$ to $2$ decimal places, we can calculate $P({A}^{'})$ using the formula\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ P({A}^{'}) & =1-P(A) \\\\  & =1-0.95 \\\\  & =0.05.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257421 :knowledge-point/_questions [{:knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d45faf36-f6c6-595d-8807-a8261845f66e" :answer/type {:db/ident :answer.type/math} :answer/value "a+1" :db/id #edb/ref 17592186257423}] :answer-field/correct {:answer/id #uuid "d45faf36-f6c6-595d-8807-a8261845f66e" :answer/type {:db/ident :answer.type/math} :answer/value "a+1" :db/id #edb/ref 17592186257423} :answer-field/id #uuid "01abc940-e8fa-5b9f-9dfd-03ec9a1369b8" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257422} {:answer-field/choices [{:answer/id #uuid "5acff8fa-3ac3-5926-8653-c273e47dfb38" :answer/type {:db/ident :answer.type/math} :answer/value "b-1" :db/id #edb/ref 17592186257425}] :answer-field/correct {:answer/id #uuid "5acff8fa-3ac3-5926-8653-c273e47dfb38" :answer/type {:db/ident :answer.type/math} :answer/value "b-1" :db/id #edb/ref 17592186257425} :answer-field/id #uuid "28235b12-ac31-57ff-961f-dd84f98b98c5" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257424}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0fef01f-2213-54a9-b56d-2a6ffe24af59" :question/math-academy-id "q-121381" :question/problem "The point $(a,b)$ lies on the curve $y=\\sqrt{x}.$ What points **must** lie on $y=\\sqrt{x-1}-1?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nTo plot $y=\\sqrt{x-1}-1,$ we apply the following steps:\n\n- First, we take the graph $y=\\sqrt{x}.$\n\n- Then, we shift the graph horizontally by $1$ unit to the right and get the graph of $y=\\sqrt{x-1}.$ After this transformation, the point $(a,b)$ will be mapped to the point\n\n$$\n(a+1,b).\n$$\n\n- Finally, we shift the result vertically by $1$ unit down and obtain the graph of $y=\\sqrt{x-1}-1.$ After this transformation, the point $(a+1,b)$ will be mapped to the point\n\n$$\n(a+1,b-1).\n$$\n\n**Method 2**\n\nSince the point $(a,b)$ lies on the graph of $y=\\sqrt{x}$, we have that $\\sqrt{a}=b.$\n\nNow consider the graph of $y=\\sqrt{x-1}-1.$ Substituting $x=a+1$, we get\n\n$$\n\\begin{aligned}y & =\\sqrt{a+1-1}-1 \\\\  & =\\sqrt{a}-1 \\\\  & =b-1.\\end{aligned}\n$$\n\nTherefore, the point $(a+1,b-1)$ must lie on $y=\\sqrt{x-1}-1.$"}] [{:db/id #edb/ref 17592186257426 :knowledge-point/_questions [{:knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7313299-63ee-5e14-86f9-1642a1e89e22" :answer/type {:db/ident :answer.type/math} :answer/value "a-2" :db/id #edb/ref 17592186257428}] :answer-field/correct {:answer/id #uuid "f7313299-63ee-5e14-86f9-1642a1e89e22" :answer/type {:db/ident :answer.type/math} :answer/value "a-2" :db/id #edb/ref 17592186257428} :answer-field/id #uuid "917a2fd6-e5fe-5455-9f16-9e9a6915e3c8" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257427} {:answer-field/choices [{:answer/id #uuid "e949d938-cc8b-57be-904b-0e1503b60994" :answer/type {:db/ident :answer.type/math} :answer/value "2b" :db/id #edb/ref 17592186257430}] :answer-field/correct {:answer/id #uuid "e949d938-cc8b-57be-904b-0e1503b60994" :answer/type {:db/ident :answer.type/math} :answer/value "2b" :db/id #edb/ref 17592186257430} :answer-field/id #uuid "c9113eda-8a00-5aef-8c24-0b19868e6613" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257429}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f1936c8-1899-5449-bbe4-ab64eec00d6a" :question/math-academy-id "q-121393" :question/problem "The point $(a,b)$ lies on the curve $y={x}^{3}.$ What points **must** lie on $y=2(x+2)^{3}?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nTo plot $y=2(x+2)^{3},$ we apply the following steps:\n\n- First, we take the graph $y={x}^{3}.$\n\n- Then, we shift the graph horizontally by $2$ units to the left and get the graph of $y=(x+2)^{3}.$ After this transformation, the point $(a,b)$ will be mapped to the point\n\n$$\n(a-2,b).\n$$\n\n- Finally, we stretch the graph by a scale factor of  $2$ parallel to the $y$ -axis and get the graph of  $y=2(x+2)^{3}.$ After this transformation, the point $(a-2,b)$ will be mapped to the point \n\n$$\n(a-2,2b).\n$$\n\n**Method 2**\n\nSince the point $(a,b)$ lies on the graph of $y={x}^{3}$, we have that ${a}^{3}=b.$\n\nNow consider the graph of $y=2(x+2)^{3}.$ Substituting $x=a-2$, we get\n\n$$\n\\begin{aligned}y & =2(a-2+2)^{3} \\\\  & =2{a}^{3} \\\\  & =2b.\\end{aligned}\n$$\n\nTherefore, the point $(a-2,2b)$ must lie on $y=2(x+2)^{3}.$"}] [{:db/id #edb/ref 17592186257491 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2e28247-1113-5d9f-9c76-49af8b498fc5" :knowledge-point/title "Computing a Reciprocal Ratio of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc8cdc6f-a69d-584f-b0fc-dabae251979e" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186257493}] :answer-field/correct {:answer/id #uuid "fc8cdc6f-a69d-584f-b0fc-dabae251979e" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186257493} :answer-field/id #uuid "68fb5449-9e08-575e-bf36-b120ccb0ea69" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257492}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "147149ab-0381-536f-a9c7-1b31461b25be" :question/math-academy-id "q-123544" :question/problem "Find the value of $\\operatorname{csc}({0}^{∘}).$\n\nAnswer: {{answer}}\n\nIf the value is undefined, enter \"Undefined\"." :question/worked-solution "The angle ${0}^{∘}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle ${0}^{∘}$ corresponds to the point $(1,0).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}({0}^{∘})=0.$\n\nTherefore, using the fact that $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{csc}({0}^{∘})=\\frac{1}{\\operatorname{sin}({0}^{∘})}=\\frac{1}{0}.\n$$\n\nHowever, division by zero is undefined. Therefore, $\\operatorname{csc}({0}^{∘})$ is undefined."}] [{:db/id #edb/ref 17592186257494 :knowledge-point/_questions [{:knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a90d3cb0-00ad-5297-8b6e-e1655f932b2f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186257496}] :answer-field/correct {:answer/id #uuid "a90d3cb0-00ad-5297-8b6e-e1655f932b2f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186257496} :answer-field/id #uuid "45720d87-6b35-533d-ae59-ce362ab3b985" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257495}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "606b2a8d-a2fe-5af3-a7b5-53405c89d3ce" :question/math-academy-id "q-123583" :question/problem "Find the value of $\\operatorname{tan}\\pi +\\operatorname{cot}(\\frac{\\pi }{2}).$\n\nAnswer: {{answer}}" :question/worked-solution "The angles $\\pi $ and $\\frac{\\pi }{2}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nLet's first consider the angle $\\pi .$ From the unit circle, we see that the angle $\\pi $ corresponds to the point $(-1,0).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}\\pi =-1.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}\\pi =0.$\n\nTherefore, using the fact that $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{tan}\\pi =\\frac{\\operatorname{sin}\\pi }{\\operatorname{cos}\\pi }=\\frac{0}{-1}=0.\n$$\n\nNow, let's consider the angle $\\frac{\\pi }{2}.$ From the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{\\pi }{2})=0.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{2})=1.$\n\nTherefore, using the fact that $\\operatorname{cot}\\theta =\\frac{\\operatorname{cos}\\theta }{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{cot}(\\frac{\\pi }{2})=\\frac{\\operatorname{cos}(\\frac{\\pi }{2})}{\\operatorname{sin}(\\frac{\\pi }{2})}=\\frac{0}{1}=0.\n$$\n\nFinally, we get\n\n$$\n\\operatorname{tan}\\pi +\\operatorname{cot}(\\frac{\\pi }{2})=0+0=0.\n$$"}] [{:db/id #edb/ref 17592186257647 :knowledge-point/_questions [{:knowledge-point/id #uuid "0a119150-6d23-59bd-90c9-699de3a75795" :knowledge-point/title "Finding the Correct Quadrant for Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b52fd012-8d14-5245-b910-5611e50ab1e7" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant II" :db/id #edb/ref 17592186257649} {:answer/id #uuid "f9b02ae1-79a5-5d4c-a37c-8d33b7bd5b37" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant I" :db/id #edb/ref 17592186257650} {:answer/id #uuid "8d03dfd0-283c-508e-808d-7b02fc18538d" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186257651} {:answer/id #uuid "f5a96c4f-bcd1-5e88-8d4a-f9e0848917fb" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant IV" :db/id #edb/ref 17592186257652}] :answer-field/correct {:answer/id #uuid "8d03dfd0-283c-508e-808d-7b02fc18538d" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186257651} :answer-field/id #uuid "cda67690-29b3-505f-9114-ae1f87b12f1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257648}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b02b1783-580f-5ba0-8828-54461d71b13a" :question/math-academy-id "q-124419" :question/problem "The angle $\\theta ={940}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with ${940}^{∘}$ by *subtracting* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- ${940}^{∘}-{360}^{∘}={580}^{∘}$\n\n- ${940}^{∘}-2\\cdot {360}^{∘}={220}^{∘}\\,✓$\n\nSo the angle ${220}^{∘}$ is coterminal with ${940}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/fda42bbc304e20454045766c7e6dffeeb4ecc65da14b6e89dd75f0a4be788afa.png)\n\nWe see that ${220}^{∘}$ lies in quadrant III. Therefore, ${940}^{∘}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186257717 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "997613b3-bfc8-5ed3-ba9e-bfe36a2278ab" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant II" :db/id #edb/ref 17592186257719} {:answer/id #uuid "e0afcaf6-96f9-5f04-b47a-1f7fc76fdae6" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant I" :db/id #edb/ref 17592186257720} {:answer/id #uuid "267bc248-0e86-55b6-a42f-7d345142ce95" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186257721} {:answer/id #uuid "c4a8c567-83cd-5324-b82c-c56a02442ee8" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant IV" :db/id #edb/ref 17592186257722}] :answer-field/correct {:answer/id #uuid "267bc248-0e86-55b6-a42f-7d345142ce95" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186257721} :answer-field/id #uuid "20e30312-fd1d-55eb-ad54-8557b97f1df8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186257718}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8ce00861-6b60-5530-adb7-2260647c73a2" :question/math-academy-id "q-124719" :question/problem "The angle $\\theta =-\\frac{27\\pi }{10}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-\\frac{27\\pi }{10}$ by *adding* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $-\\frac{27\\pi }{10}+2\\pi =-\\frac{7\\pi }{10}$\n\n- $-\\frac{27\\pi }{10}+2\\cdot (2\\pi )=\\frac{13\\pi }{10}\\,✓$\n\nSo the angle $-\\frac{27\\pi }{10}$ is coterminal with $\\frac{13\\pi }{10}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/859964e94518cf2f6270c425cb6cc0db99bbde2af83c19b1f3cdae0083644b06.png)\n\nWe see that $\\frac{13\\pi }{10}$ lies in quadrant III. Therefore, $-\\frac{27\\pi }{10}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186257726 :knowledge-point/_questions [{:knowledge-point/id #uuid "bba0ad98-6940-502a-873c-8a589a03a499" :knowledge-point/title "Finding Coterminal Angles in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc1b11b-4a95-5f84-a757-f06f1901570c" :answer/type {:db/ident :answer.type/math} :answer/value "-{546}^{∘}" :db/id #edb/ref 17592186257728}] :answer-field/correct {:answer/id #uuid "1cc1b11b-4a95-5f84-a757-f06f1901570c" :answer/type {:db/ident :answer.type/math} :answer/value "-{546}^{∘}" :db/id #edb/ref 17592186257728} :answer-field/id #uuid "43dd4b4c-5d7b-5b1f-8e45-de086685e68f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257727}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "518cae3a-0414-5f8e-9c3c-ba9caf23f9e4" :question/math-academy-id "q-124740" :question/problem "Which angle is coterminal with $-{186}^{∘}?$\n\nAnswer: {{answer}}" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{186}^{∘}$:\n\n- $-{186}^{∘}+{360}^{∘}={174}^{∘}$\n\n- $-{186}^{∘}+2\\cdot {360}^{∘}={534}^{∘}$\n\nThere are no answer choices larger than ${534}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{186}^{∘}$:\n\n- $-{186}^{∘}-{360}^{∘}=-{546}^{∘}\\,✓$\n\n- $-{186}^{∘}-2\\cdot {360}^{∘}=-{906}^{∘}$\n\nThere are no answer choices smaller than $-{906}^{∘},$ so we can stop here.\n\nSo the correct answer is $-{546}^{∘}.$"}] [{:db/id #edb/ref 17592186257729 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d65819f-0528-527e-8d1a-20421e221ca5" :knowledge-point/title "Finding Coterminal Angles in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7667623-b9c3-5387-ad60-d35e1f90f38f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19\\pi }{4}" :db/id #edb/ref 17592186257731}] :answer-field/correct {:answer/id #uuid "c7667623-b9c3-5387-ad60-d35e1f90f38f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19\\pi }{4}" :db/id #edb/ref 17592186257731} :answer-field/id #uuid "98fd794b-fea6-53c2-82d9-03f17d1331de" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257730}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a2a0dd2-1546-5e0a-a4bf-23483c4d3293" :question/math-academy-id "q-124751" :question/problem "Which angle is coterminal with $\\frac{5\\pi }{4}?$\n\nAnswer: {{answer}}" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $ (in radians), we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $\\frac{5\\pi }{4}$:\n\n- $\\frac{5\\pi }{4}+2\\pi =\\frac{13\\pi }{4}$\n\nThere are no answer choices larger than $\\frac{13\\pi }{4},$ so we can stop here.\n\nNow, let's subtract multiples of $2\\pi $ from $\\frac{5\\pi }{4}$:\n\n- $\\frac{5\\pi }{4}-2\\pi =-\\frac{3\\pi }{4}$\n\n- $\\frac{5\\pi }{4}-2\\cdot (2\\pi )=-\\frac{11\\pi }{4}$\n\n- $\\frac{5\\pi }{4}-3\\cdot (2\\pi )=-\\frac{19\\pi }{4}\\,✓$\n\nThere are no answer choices smaller than $-\\frac{19\\pi }{4},$ so we can stop here.\n\nSo the correct answer is $-\\frac{19\\pi }{4}.$"}] [{:db/id #edb/ref 17592186257741 :knowledge-point/_questions [{:knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "982e47be-9d80-5b71-9f5d-44d3b6ae03dd" :answer/type {:db/ident :answer.type/math} :answer/value "-i+j" :db/id #edb/ref 17592186257743}] :answer-field/correct {:answer/id #uuid "982e47be-9d80-5b71-9f5d-44d3b6ae03dd" :answer/type {:db/ident :answer.type/math} :answer/value "-i+j" :db/id #edb/ref 17592186257743} :answer-field/id #uuid "f1ac6207-4087-530e-9fe1-9da08c372a49" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257742}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "888651a7-a3b9-5d0f-8148-4bdfc5b7dab5" :question/math-academy-id "q-125086" :question/problem "Find $a+3b$ if $a=8i-5j$ and $b=-3i+2j.$\n\nAnswer: {{answer}}" :question/worked-solution "To compute $a+3b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}a+3b & =(8i-5j)+3(-3i+2j) \\\\  & =8i-5j-9i+6j \\\\  & =(8i-9i)+(-5j+6j) \\\\  & =-i+j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257744 :knowledge-point/_questions [{:knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7eff72b0-d83a-598a-a19a-d7af0f1ab26f" :answer/type {:db/ident :answer.type/math} :answer/value "-14i" :db/id #edb/ref 17592186257746}] :answer-field/correct {:answer/id #uuid "7eff72b0-d83a-598a-a19a-d7af0f1ab26f" :answer/type {:db/ident :answer.type/math} :answer/value "-14i" :db/id #edb/ref 17592186257746} :answer-field/id #uuid "3bb81aa6-7477-544b-af82-6b5dc6e9f217" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257745}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f8e09c5f-3163-502a-9685-5b7910432e07" :question/math-academy-id "q-125088" :question/problem "Find $3a-2b$ if $a=-2i-2j$ and $b=4i-3j.$\n\nAnswer: {{answer}}" :question/worked-solution "To compute $3a-2b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}3a-2b & =3(-2i-2j)-2(4i-3j) \\\\  & =-6i-6j-8i+6j \\\\  & =(-6i-8i)+(-6j+6j) \\\\  & =-14i+0j \\\\  & =-14i\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257755 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c45a70b-273c-5fec-a768-40a1cf218628" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186922e0-79e7-5bea-a1c9-9dc53e50e9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{13}" :db/id #edb/ref 17592186257757}] :answer-field/correct {:answer/id #uuid "186922e0-79e7-5bea-a1c9-9dc53e50e9f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{13}" :db/id #edb/ref 17592186257757} :answer-field/id #uuid "f4a95cd3-7d33-5b9e-86f2-7f568b3a6e4e" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257756} {:answer-field/choices [{:answer/id #uuid "fc68583d-2af0-5183-94e7-b79dc5a4617b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186257759}] :answer-field/correct {:answer/id #uuid "fc68583d-2af0-5183-94e7-b79dc5a4617b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186257759} :answer-field/id #uuid "05f5166b-2a10-5206-90d3-d3328b1a0f86" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257758}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bde60051-298e-59aa-a76e-9c9fabb0aba6" :question/math-academy-id "q-125138" :question/problem "Let $a=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}5 \\\\ 8\\end{aligned}].$ Find a unit vector that is parallel to $2a+b$ and points the same direction.\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}2a+b & =2\\cdot [\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0+5 \\\\ 4+8\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 12\\end{aligned}]\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|2a+b| & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|} \\\\  & =\\frac{1}{13}(2a+b) \\\\  & =\\frac{1}{13}\\cdot [\\begin{aligned}5 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{13} \\\\ \\frac{12}{13}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257820 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40504147-3868-54b4-8ba8-035ff5ce253e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,7⟩" :db/id #edb/ref 17592186257822}] :answer-field/correct {:answer/id #uuid "40504147-3868-54b4-8ba8-035ff5ce253e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,7⟩" :db/id #edb/ref 17592186257822} :answer-field/id #uuid "367b4bb7-ded0-5ab1-83e5-e805999abd93" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257821}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "24b4dd48-333d-5e25-aa2e-651c9caeda5d" :question/math-academy-id "q-1300" :question/problem "If $\\overset{\\to }{u}=⟨-3,1⟩$ and $\\overset{\\to }{v}=⟨4,6⟩$, then $\\overset{\\to }{u}+\\overset{\\to }{v}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{u}+\\overset{\\to }{v} & =⟨-3,1⟩+⟨4,6⟩ \\\\  & =⟨-3+4,1+6⟩ \\\\  & =⟨1,7⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257823 :knowledge-point/_questions [{:knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "247624a7-df97-533a-a6bd-bacaa26fd01a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,3⟩" :db/id #edb/ref 17592186257825}] :answer-field/correct {:answer/id #uuid "247624a7-df97-533a-a6bd-bacaa26fd01a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,3⟩" :db/id #edb/ref 17592186257825} :answer-field/id #uuid "d1246d23-8c2f-5ec3-b192-4d6d686e3caf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257824}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "43d779a0-07d6-5690-a96a-eab399e84e6a" :question/math-academy-id "q-1301" :question/problem "What is the sum of $\\overset{\\to }{A}=⟨10,5⟩$ and $\\overset{\\to }{B}=⟨8,-2⟩?$\n\nAnswer: {{answer}}" :question/worked-solution "To compute $\\overset{\\to }{A}+\\overset{\\to }{B},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{A}+\\overset{\\to }{B} & =⟨10,5⟩+⟨8,-2⟩ \\\\  & =⟨18,3⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257867 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f071f55-37a1-5cf3-a329-6c9003e2b725" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,6⟩" :db/id #edb/ref 17592186257869}] :answer-field/correct {:answer/id #uuid "9f071f55-37a1-5cf3-a329-6c9003e2b725" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,6⟩" :db/id #edb/ref 17592186257869} :answer-field/id #uuid "3d9000c4-d90d-5ca4-9f3f-708690172b37" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257868}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "97a85d1a-b43c-5d17-b735-55bbb45a8cd6" :question/math-academy-id "q-1324" :question/problem "If $\\overset{\\to }{U}=⟨1,3⟩$ and $\\overset{\\to }{V}=⟨6,3⟩$, then $\\overset{\\to }{U}+\\overset{\\to }{V}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{U}+\\overset{\\to }{V} & =⟨1,3⟩+⟨6,3⟩ \\\\  & =⟨1+6,3+3⟩ \\\\  & =⟨7,6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257870 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "513a423d-a88f-5e18-9d15-f24ca8887917" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257872}] :answer-field/correct {:answer/id #uuid "513a423d-a88f-5e18-9d15-f24ca8887917" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257872} :answer-field/id #uuid "948fdae7-05ca-5624-a16e-022fb33b1775" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257871}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e6095b63-ddc6-568b-9380-729c9ade9f90" :question/math-academy-id "q-133024" :question/problem "Find the value of $f(x)$ at $x=4.$\n\n$f(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "We substitute $4$ for $x$ in the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =4\\sqrt{x}-2 \\\\ f(4) & =4\\sqrt{4}-2 \\\\  & =4\\cdot 2-2 \\\\  & =8-2 \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257873 :knowledge-point/_questions [{:knowledge-point/id #uuid "8daba5bf-5162-5779-9512-f22d0c8c0320" :knowledge-point/title "Evaluating Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238dbe8d-4db0-537e-aa65-e66cdd944e03" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257875}] :answer-field/correct {:answer/id #uuid "238dbe8d-4db0-537e-aa65-e66cdd944e03" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257875} :answer-field/id #uuid "72b4136f-4387-5525-beff-16f19e2b0713" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257874}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f1754b32-47e1-5590-8a91-bbc36a0323fa" :question/math-academy-id "q-133025" :question/problem "$h(4)\\,=\\,${{field-1}}" :question/worked-solution "Since $x=4$ is in the interval $x>2,$ we use the second branch of the piecewise function, namely $h(x)=5-x:$\n\n$$\n\\begin{aligned}h(4) & =5-4 \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257876 :knowledge-point/_questions [{:knowledge-point/id #uuid "82d522a8-ae3c-5723-909e-540ddac1d9da" :knowledge-point/title "Finding the Roots Given a Function Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80f8910e-5b03-5984-9910-47019bc5d244" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186257878}] :answer-field/correct {:answer/id #uuid "80f8910e-5b03-5984-9910-47019bc5d244" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186257878} :answer-field/id #uuid "fe208381-c8c6-5813-a86d-b35b92287858" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257877}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6c8691c2-0337-5d26-bf63-fbc25bd0f7e7" :question/math-academy-id "q-133026" :question/problem "What is the root of the function $g(x)?$\n\nThe root is at $x\\,=$\n{{field-1}}" :question/worked-solution "The roots are the solutions to the equation $g(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}g(x) & =0 \\\\ 3x-1 & =0 \\\\ 3x & =1 \\\\ \\frac{3x}{3} & =\\frac{1}{3} \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186257879 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ec3d139-c43a-5547-b0ae-147e41a55180" :knowledge-point/title "Identifying the Global Minimum of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93e5b92f-ac10-506e-a57a-e16a167dbe6b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257881}] :answer-field/correct {:answer/id #uuid "93e5b92f-ac10-506e-a57a-e16a167dbe6b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257881} :answer-field/id #uuid "57a6ec67-c027-538e-9233-46de151c33f5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257880}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "84eeaa13-d68d-5cfc-8888-807b5ced7f65" :question/math-academy-id "q-133027" :question/problem "Using the graph of $y=h(x)$ on the interval $[-1,6],$ find the global minimum value of $h(x)$ on this interval.\n\n${h}_{min}\\,=\\,$\n{{field-1}}" :question/worked-solution "First, we recall the following definitions:\n\n* The global minimum of a function is the smallest value that the function attains on its domain. There can only be (at most) one global minimum.\n\n* A global minimum point of a function is a point $(x,y)$ where a function reaches a global minimum. There can be zero, one, or many global minimum points.\n\nFor our function, the minimum value reached by the function is $h(x)=-2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/bc25d9452e02cfd80ae586368897ef3d917ab9bc5c8e7ea1b74c154f1d4ebb19.png)\n\nTherefore, the global minimum is ${h}_{min}=-2.$ The function reaches this value when $x=1,$ so the global minimum point is $(1,-2).$"}] [{:db/id #edb/ref 17592186257882 :knowledge-point/_questions [{:knowledge-point/id #uuid "2aafd8db-c723-508f-9ea3-43881f0d9140" :knowledge-point/title "Finding the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35983dd7-a6f6-5f7e-892d-32e5bb3fc827" :answer/type {:db/ident :answer.type/math} :answer/value "3x+4\\sqrt{x}-3" :db/id #edb/ref 17592186257884}] :answer-field/correct {:answer/id #uuid "35983dd7-a6f6-5f7e-892d-32e5bb3fc827" :answer/type {:db/ident :answer.type/math} :answer/value "3x+4\\sqrt{x}-3" :db/id #edb/ref 17592186257884} :answer-field/id #uuid "b2f1c264-55ce-5555-ba73-15e60bb032a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257883}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "06310d36-bd4d-5d43-a430-ab4207ec0de1" :question/math-academy-id "q-133028" :question/problem "Write the expression for the function $(f+g)(x)$ in terms of $x.$\n\n$(f+g)(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "We find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(4\\sqrt{x}-2)+(3x-1) \\\\  & =3x+4\\sqrt{x}-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257885 :knowledge-point/_questions [{:knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d332894f-e277-5c10-8905-e605f713fc58" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257887}] :answer-field/correct {:answer/id #uuid "d332894f-e277-5c10-8905-e605f713fc58" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257887} :answer-field/id #uuid "6df0ed28-1b60-5812-9a56-ad326420afaa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257886}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f6b2a0d8-4028-5a47-a42c-61c14cfc6c36" :question/math-academy-id "q-133029" :question/problem "Find the value of $(f/h)(4).$\n\n$(f/h)(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "The notation $(f/h)(x)$ means the quotient of the functions $f(x)$ and $h(x).$ \n\nTo evaluate $(f/h)(4),$ we need to divide $f(4)$ by $h(4).$\n\nEarlier, we found the following values:\n\n$$\n\\begin{aligned}f(4) & =6 \\\\ h(4) & =1\\end{aligned}\n$$\n\n \n\nTherefore, we obtain\n\n$$\n(f/h)(4)=\\frac{f(4)}{h(4)}=\\frac{6}{1}=6.\n$$"}] [{:db/id #edb/ref 17592186257888 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f954ff1-3f02-5fb1-aca2-5911d5636167" :knowledge-point/title "Evaluating a Composite Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "945b8d50-f440-5780-8ea7-c9e76f811169" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257890}] :answer-field/correct {:answer/id #uuid "945b8d50-f440-5780-8ea7-c9e76f811169" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257890} :answer-field/id #uuid "731f05d4-c4f7-5886-9532-afcb439d53c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257889}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2f3209b-4bde-5973-b485-cd4659645aeb" :question/math-academy-id "q-133030" :question/problem "$(f∘h)(4)\\,=\\,${{field-1}}" :question/worked-solution "The expression $(f∘h)(4)$ is equivalent to $f(h(4)).$ \n\nPreviously, we found that \n\n$$\nh(4)=1.\n$$\n\nThen, we substitute $x=1$ into $f(x).$ This gives\n\n$$\n\\begin{aligned}f(h(4)) & =f(1) \\\\  & =4\\sqrt{1}-2 \\\\  & =4\\cdot 1-2 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257891 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ebb0209-904f-598a-9ff2-ab9d4d0cabca" :knowledge-point/title "Identifying the Range of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ef80c8-2db1-5351-9296-57af895684bd" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257893}] :answer-field/correct {:answer/id #uuid "96ef80c8-2db1-5351-9296-57af895684bd" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257893} :answer-field/id #uuid "06a77d84-2e97-5cb1-b50c-242f92a052c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257892} {:answer-field/choices [{:answer/id #uuid "8c191908-eb0e-5337-9407-0cca774ce695" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257895}] :answer-field/correct {:answer/id #uuid "8c191908-eb0e-5337-9407-0cca774ce695" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257895} :answer-field/id #uuid "ca89e50d-c4a3-56d4-a2ff-cc57d8270589" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257894}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2339506b-6632-5223-9e01-443389461a63" :question/math-academy-id "q-133031" :question/problem "Consider the function $g(x)$ for $x\\in [-1,1].$ What is its range over the given domain?\n\n{{field-1}}\n$\\le \\,g(x)\\,\\le $\n{{field-2}}" :question/worked-solution "First, we graph the function $g(x)=3x-1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/819903d614018e7945117ddd14b26cf669777c1d4f3742e095b1cebc212bf879.png)\n\nThen, we find the lowest and highest $y$-values in the graph over the domain $x\\in [-1,1].$\n\n* The lowest $y$ value is $-4.$ This occurs at the point $(-1,-4).$\n\n* The highest $y$ value is $2.$ This occurs at the point $(1,2).$\n\nThe function covers all the $y$-values between $-4$ and $2,$ including the endpoints.\n\nTherefore, the range is $-4\\le y\\le 2,$ which can also be written as \n\n$$\n-4\\le g(x)\\le 2.\n$$"}] [{:db/id #edb/ref 17592186257896 :knowledge-point/_questions [{:knowledge-point/id #uuid "06e51d62-ad2a-51c3-b276-eeb60022ab48" :knowledge-point/title "Computing an Inverse Function Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29abe2ec-1d6d-5b36-9243-f4f5463a1ce6" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186257898}] :answer-field/correct {:answer/id #uuid "29abe2ec-1d6d-5b36-9243-f4f5463a1ce6" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186257898} :answer-field/id #uuid "4b320bbe-c8b3-5d1b-b588-89fe83588f77" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257897}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6672f6f6-d069-5e08-8c51-22e371f34dc7" :question/math-academy-id "q-133032" :question/problem "Suppose that $r(x)=\\frac{1}{3}x+k$ is the inverse of $g(x).$ What is the value of $k?$\n\n$k\\,=\\,$\n{{field-1}}" :question/worked-solution "If $r$ is the inverse of $g,$ then \n\n$$\nr(g(x))=x.\n$$\n\nTo find $r(g(x)),$ we write down the function $r$ and replace every occurrence of $x$ with $g(x):$\n\n$$\n\\begin{aligned}r(x) & =\\frac{1}{3}x+k \\\\ r(g(x)) & =\\frac{1}{3}g(x)+k\\end{aligned}\n$$\n\nThen, we substitute $g(x)=3x-1$ into the right-hand side of our expression and simplify, as follows:\n\n$$\n\\begin{aligned}r(g(x)) & =\\frac{1}{3}g(x)+k \\\\  & =\\frac{1}{3}(3x-1)+k \\\\  & =x-\\frac{1}{3}+k\\end{aligned}\n$$\n\nHowever, we know that $r(g(x))=x.$ Equating the expression above with $x$ and solving for $k$ gives\n\n$$\n\\begin{aligned}r(g(x)) & =x \\\\ x-\\frac{1}{3}+k & =x \\\\ \\cancel{x}-\\frac{1}{3}+k & =\\cancel{x} \\\\ -\\frac{1}{3}+k & =0 \\\\ k & =\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258047 :knowledge-point/_questions [{:knowledge-point/id #uuid "1735c445-9c97-5aa7-83d6-7dee23993153" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Using Angle Bracket Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57b2ee3d-98e3-53db-9419-d7bb962afcb1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,-2⟩" :db/id #edb/ref 17592186258049}] :answer-field/correct {:answer/id #uuid "57b2ee3d-98e3-53db-9419-d7bb962afcb1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,-2⟩" :db/id #edb/ref 17592186258049} :answer-field/id #uuid "a95ee6b3-71c2-5e0f-9189-350c74985842" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258048}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8fecd984-6de7-5785-803b-13a1f0cd73ff" :question/math-academy-id "q-1389" :question/problem "If $\\overset{\\to }{A}=⟨4,\\frac{1}{2}⟩$, then $-4\\overset{\\to }{A}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute $-4\\overset{\\to }{A},$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}-4\\overset{\\to }{A} & =-4\\cdot ⟨4,\\frac{1}{2}⟩ \\\\  & =⟨(-4)\\cdot 4,(-4)\\cdot \\frac{1}{2}⟩ \\\\  & =⟨-16,-2⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258316 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2799b7b-24b4-5d16-80c2-ac7ae521d926" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186258318}] :answer-field/correct {:answer/id #uuid "b2799b7b-24b4-5d16-80c2-ac7ae521d926" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186258318} :answer-field/id #uuid "41bc5adc-5b0b-54f7-8e1e-d70f29a06994" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258317}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b8589e67-69ad-5bf0-a4d3-99bbd55f2e6c" :question/math-academy-id "q-14388" :question/problem "Given the recursive sequence $f(n+2)=f(n+1)+f(n)$ with $f(1)=1$ and $f(2)=3$, what is the value of $f(7)?$\n\nAnswer: {{answer}}" :question/worked-solution "The recursion relation is\n\n$$\nf(n+2)=f(n+1)+f(n).\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =3+1 \\\\ f(3) & =4.\\end{aligned}\n$$\n\nSubstituting $n=2$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =4+3 \\\\ f(4) & =7.\\end{aligned}\n$$\n\nSimilarly, substituting $n=3,4,5$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(5)= & f(3+2) & =f(3+1)+f(3)=f(4)+f(3)=7+4=11, \\\\ f(6)= & f(4+2) & =f(4+1)+f(4)=f(5)+f(4)=11+7=18, \\\\ f(7)= & f(5+2) & =f(5+1)+f(5)=f(6)+f(5)=18+11=29.\\end{aligned}\n$$\n\nHence, $f(7)=29.$"}] [{:db/id #edb/ref 17592186258532 :knowledge-point/_questions [{:knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f25075c9-151d-51ec-ad1b-51c290720160" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258534}] :answer-field/correct {:answer/id #uuid "f25075c9-151d-51ec-ad1b-51c290720160" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258534} :answer-field/id #uuid "543cbfb7-1173-5a65-bc37-f5518618feb6" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258533} {:answer-field/choices [{:answer/id #uuid "74696480-27e8-50b8-8e68-1f5bc2c8821e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258536}] :answer-field/correct {:answer/id #uuid "74696480-27e8-50b8-8e68-1f5bc2c8821e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258536} :answer-field/id #uuid "4dbbd9a8-a3e8-5417-a704-9319b9fef99a" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258535}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "56d9614f-42ba-58e8-a0d6-4b222638dad4" :question/math-academy-id "q-158542" :question/problem "The point  $(0,3)$ lies on the curve $y=f(x-1).$ What points **must** lie on $y=f(x)+2?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(0,3)$ on $y=f(x).$ Then, we find a corresponding point on $y=f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x-1).$\n\n- Then, we shift the graph horizontally $1$ unit to the left and get the graph of $y=f(x).$ After this transformation, the point $(0,3)$ will be mapped to the point\n\n$$\n(0-1,3)=(-1,3).\n$$\n\n- Next, to plot the graph of $y=f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=f(x)+2.$ After this transformation, the point $(-1,3)$ will be mapped to the point \n\n$$\n(-1,3+2)=(-1,5).\n$$\n\n**Method 2**\n\nSince the point $(0,3)$ lies on the graph of $y=f(x-1)$, we have that \n\n$$\nf(0-1)=3\\,⟹\\,f(-1)=3.\n$$\n\nNow consider the graph of $y=f(x)+2.$ Substituting $x=-1$, we get\n\n$$\n\\begin{aligned}y & =f(-1)+2 \\\\  & =3+2 \\\\  & =5.\\end{aligned}\n$$\n\nTherefore, the point $(-1,5)$ must lie on $y=f(x)+2.$"}] [{:db/id #edb/ref 17592186258542 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "327dfb30-a023-5c23-bba9-91f243856467" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258544}] :answer-field/correct {:answer/id #uuid "327dfb30-a023-5c23-bba9-91f243856467" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258544} :answer-field/id #uuid "5e28de3b-4f3d-59d5-b4c1-13d8631a52fb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258543}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "be5e99bc-6a52-5455-9180-0bb659dfe8a9" :question/math-academy-id "q-15940" :question/problem "Find the average rate of change of the function $f(x)$ on the interval $[10,13]$ given the following table of values for $f(x):$\n\n| $x$ | $\\,7\\,$ | $\\,10\\,$ | $\\,11\\,$ | $\\,13\\,$ | $\\,15\\,$ | $\\,17\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,-2\\,$ | $\\,1\\,$ | $\\,-3\\,$ | $\\,10\\,$ | $\\,-1\\,$ | $\\,-5\\,$ |\n\nAnswer: {{answer}}" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(13)-f(10)}{13-10} \\\\  & =\\frac{10-1}{13-10} \\\\  & =\\frac{9}{3} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258620 :knowledge-point/_questions [{:knowledge-point/id #uuid "3b2229bd-c425-5e53-b8cf-56f3f9f3f539" :knowledge-point/title "Evaluating a Polynomial Using Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86a99ba6-4c2c-5807-a56e-b249e1918b4e" :answer/type {:db/ident :answer.type/math} :answer/value "100a+10b" :db/id #edb/ref 17592186258622}] :answer-field/correct {:answer/id #uuid "86a99ba6-4c2c-5807-a56e-b249e1918b4e" :answer/type {:db/ident :answer.type/math} :answer/value "100a+10b" :db/id #edb/ref 17592186258622} :answer-field/id #uuid "4f2d11c4-7300-5965-99c0-2b6e61b8eb70" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258621}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3a5c3449-93ad-5a8f-bbf0-17b76476ebff" :question/math-academy-id "q-167192" :question/problem "In terms of $a$ and $b,\\,p(10)=\\,${{field-1}}." :question/worked-solution "We substitute $x=10$ into the expression for $p(x)$ and simplify: \n\n$$\n\\begin{aligned}p(x) & =a{x}^{2}+bx \\\\ p(10) & =a(10)^{2}+b(10) \\\\  & =100a+10b.\\end{aligned}\n$$\n\nTherefore, $p(10)=100a+10b.$"}] [{:db/id #edb/ref 17592186258623 :knowledge-point/_questions [{:knowledge-point/id #uuid "075c23a4-9de9-59b5-bec4-575b0b0454f4" :knowledge-point/title "Solving Two-Step Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3d37fcd-d281-5a16-a427-2712f01e728c" :answer/type {:db/ident :answer.type/math} :answer/value "480-10a" :db/id #edb/ref 17592186258625}] :answer-field/correct {:answer/id #uuid "b3d37fcd-d281-5a16-a427-2712f01e728c" :answer/type {:db/ident :answer.type/math} :answer/value "480-10a" :db/id #edb/ref 17592186258625} :answer-field/id #uuid "98c2fbae-67d3-52ab-807c-2446f504b794" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258624}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2bd624b7-fb93-5e18-810a-cc1dd71da80a" :question/math-academy-id "q-167193" :question/problem "If the company sells ten couches in a week, the weekly profit will be $$4\\,800.$ Find an expression for $b$ in terms of $a.$\n\n$b=$\n{{field-1}}" :question/worked-solution "In part 1, we found that $p(10)=100a+10b.$ So, we need to solve the equation $100a+10b=4\\,800$ for the parameter $b.$\n\nWe need to isolate the variable $b.$ To do this, we treat $a$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we subtract $100a$ from both sides of the equation:\n\n$$\n\\begin{aligned}100a+10b & =4\\,800 \\\\ 100a+10b-100a & =4\\,800-100a \\\\ 10b & =4\\,800-100a\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $10:$\n\n$$\n\\begin{aligned}10b & =4\\,800-100a \\\\ \\frac{10b}{10} & =\\frac{4\\,800-100a}{10} \\\\ \\frac{\\cancel{10}b}{\\cancel{10}} & =\\frac{4\\,800}{10}-\\frac{100a}{10} \\\\ b & =480-10a\\end{aligned}\n$$\n\nThus, $b=480-10a.$"}] [{:db/id #edb/ref 17592186258626 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "825436cb-9673-51cf-85dc-e619d63d520d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186258628}] :answer-field/correct {:answer/id #uuid "825436cb-9673-51cf-85dc-e619d63d520d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186258628} :answer-field/id #uuid "0b772ad6-06db-5726-b6ce-d03788093751" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258627} {:answer-field/choices [{:answer/id #uuid "99557b4b-cf24-5413-9953-5485c6e07968" :answer/type {:db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186258630}] :answer-field/correct {:answer/id #uuid "99557b4b-cf24-5413-9953-5485c6e07968" :answer/type {:db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186258630} :answer-field/id #uuid "c9d309dc-1a7d-576d-82a8-c54ce41c71fa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258629}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0afbd217-b5b5-5642-933f-a0e397418911" :question/math-academy-id "q-167194" :question/problem "The coefficients $a$ and $b$ also satisfy the equation $20b+400a=7\\,200.$ Find the values of $a$ and $b.$\n\n$a\\,=$\n{{field-1}}\n\n$b\\,=$\n{{field-2}}" :question/worked-solution "We have the following system of linear equations:\n\n$$\n{\\begin{aligned}b=480-10a \\\\ 20b+400a=7\\,200\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. \n\nNotice that the first equation is already solved for $b:$\n\n$$\nb=480-10a\n$$\n\nSo, we replace $b$ in the second equation and solve for $a:$\n\n$$\n\\begin{aligned}20b+400a & =7\\,200 \\\\ 20(480-10a)+400a & =7\\,200 \\\\ 9\\,600-200a+400a & =7\\,200 \\\\ 9\\,600+200a & =7\\,200 \\\\ 200a & =-2\\,400 \\\\ a & =-12\\end{aligned}\n$$\n\nIf we now substitute $a=-12$ into $b=480-10a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =480-10(-12) \\\\ b & =600\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-12,\\,b=600.$"}] [{:db/id #edb/ref 17592186258631 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354f5d76-8f03-5e6e-97fa-a25e850f3cf4" :answer/type {:db/ident :answer.type/math} :answer/value "4800" :db/id #edb/ref 17592186258633}] :answer-field/correct {:answer/id #uuid "354f5d76-8f03-5e6e-97fa-a25e850f3cf4" :answer/type {:db/ident :answer.type/math} :answer/value "4800" :db/id #edb/ref 17592186258633} :answer-field/id #uuid "43acb66d-8004-5c0e-a631-d3d64fd7793b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258632}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2a5fdcf4-99c8-52a0-adf5-3a386b9372b4" :question/math-academy-id "q-167195" :question/problem "Determine the weekly profit if the company produces $40$ couches in a week.\n\nThe company will earn$\\,$\n{{field-1}}$\\,$dollars." :question/worked-solution "From part 3, we have the function $p(x)=-12{x}^{2}+600x.$\n\nWe substitute $x=40$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}p(40) & =-12(40)^{2}+600(40) \\\\  & =-19\\,200+24\\,000 \\\\  & =4\\,800\\end{aligned}\n$$\n\nTherefore, the company will earn $$4\\,800.$"}] [{:db/id #edb/ref 17592186258634 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d1134c0-02ce-59c1-8238-4820da388f90" :knowledge-point/title "Factoring a Monomial From a Trinomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e98593c0-a0cd-5b2e-934f-7284597911fd" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-50x+600" :db/id #edb/ref 17592186258636}] :answer-field/correct {:answer/id #uuid "e98593c0-a0cd-5b2e-934f-7284597911fd" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-50x+600" :db/id #edb/ref 17592186258636} :answer-field/id #uuid "930038c5-6051-5626-9760-83c150e619a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258635}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c82903d9-874d-51ce-9030-da4bfd295182" :question/math-academy-id "q-167196" :question/problem "The manager wants to determine the number of couches the company should produce per week to make a weekly profit of $$7\\,200.$ The required number of sofas $x$ is the solution to the equation\n\n$$\n12{x}^{2}-600x+7\\,200=0.\n$$\n\nThis equation can be factored as $\\,$$12\\cdot ($\n{{field-1}} $)=0.$" :question/worked-solution "We factor $12{x}^{2}-600x+7\\,200$ using the greatest common factor (GCF).\n\nComputing the GCF, we get\n\n$$\n\\text{GCF}(12{x}^{2},600x,7\\,200)=12.\n$$\n\nThen, we rewrite each term in the original expression as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}12{x}^{2}-600x+7\\,200 & = \\\\ 12\\cdot ({x}^{2})+12\\cdot (-50x)+12\\cdot (600)\\end{aligned}\n$$\n\nFinally, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}12\\cdot ({x}^{2})+12\\cdot (-50x)+12\\cdot (600) & = \\\\ 12({x}^{2}-50x+600)\\end{aligned}\n$$\n\nTherefore, the missing expression is ${x}^{2}-50x+600.$"}] [{:db/id #edb/ref 17592186258637 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c9ba00d-9171-5732-8539-2e2943cce58e" :knowledge-point/title "Factoring Trinomials With Positive Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8069a5e-c350-59af-92e9-2784d9ed4e96" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186258639}] :answer-field/correct {:answer/id #uuid "d8069a5e-c350-59af-92e9-2784d9ed4e96" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186258639} :answer-field/id #uuid "2e13021a-bbe5-5777-8b5e-ea6b09aed017" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258638}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a0fc448-799b-505a-a910-4ee7e12527c9" :question/math-academy-id "q-167197" :question/problem "Find the minimum number of couches the company needs to produce per week to make a weekly profit of $$7\\,200.$\n\nThe company needs to produce$\\,$\n{{field-1}}$\\,$ couches per week." :question/worked-solution "From part 5, the required number of sofas $x$ is the solution to the equation\n\n$$\n12\\cdot ({x}^{2}-50x+600)=0.\n$$\n\nDividing this equation by $12,$ we have\n\n$$\n{x}^{2}-50x+600=0.\n$$\n\nTo solve this equation, we want to find a factor pair of the constant term $(600)$ that also adds up to the coefficient of the linear term $(-50).$ The required factors are $(-20)$ and $(-30).$\n\nUsing this factor pair, we write the linear term as $-50x=-20x-30x,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-50x+600 & =0 \\\\ {x}^{2}-20x-30x+600 & =0\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}-20x-30+600 & =0 \\\\ ({x}^{2}-20x)+(-30x+600) & =0 \\\\ x(x-20)-30(x-20) & =0 \\\\ (x-30)(x-20) & =0\\end{aligned}\n$$\n\nHence, the solutions are $x=20$ or $x=30.$ Since we require the minimum solution, we conclude that the company needs to produce $20$ couches per week to make a profit of $$7\\,200.$"}] [{:db/id #edb/ref 17592186258640 :knowledge-point/_questions [{:knowledge-point/id #uuid "36e1e439-ec4a-5577-80d5-3b113bf36e74" :knowledge-point/title "Converting a Recursive Formula to an Explicit Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae498387-642f-5cfd-b426-4ac8e5df83a2" :answer/type {:db/ident :answer.type/math} :answer/value "3n+8" :db/id #edb/ref 17592186258642}] :answer-field/correct {:answer/id #uuid "ae498387-642f-5cfd-b426-4ac8e5df83a2" :answer/type {:db/ident :answer.type/math} :answer/value "3n+8" :db/id #edb/ref 17592186258642} :answer-field/id #uuid "6a0acb02-2312-5020-b779-83aeb67738c3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c2d8939-9cf0-57a6-8fab-47c4fdcfdadf" :question/math-academy-id "q-167198" :question/problem "The company wants to increase its output by implementing a new production model. The number of couches ${a}_{n}$ produced in the $n$th week since the implementation of the new model is given by the arithmetic sequence\n\n$$\n{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=11,\\,n\\ge 1\n$$\n\nWhat is the explicit formula for the $n$th term of this arithmetic sequence?\n\n${a}_{n}=$\n{{field-1}}" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term ${a}_{1}$ and the common difference $d.$\n\nWe are given that the first term is ${a}_{1}=11,$ and we can use the recursive rule to compute the second term as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}+3 \\\\  & =11+3 \\\\  & =14\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =14-11 \\\\  & =3\\end{aligned}\n$$\n\nNow we substitute ${a}_{1}=11$ and $d=3$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =11+(n-1)(3) \\\\  & =11+3n-3 \\\\  & =3n+8\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=3n+8,\\,n\\ge 1.\n$$"}] [{:db/id #edb/ref 17592186258683 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c9ba00d-9171-5732-8539-2e2943cce58e" :knowledge-point/title "Factoring Trinomials With Positive Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb1ba20d-813b-5415-993b-3a79e31ed28e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258685}] :answer-field/correct {:answer/id #uuid "eb1ba20d-813b-5415-993b-3a79e31ed28e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258685} :answer-field/id #uuid "7b3cb1c6-fc04-50f8-86d3-976bbe0f949b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258684}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dcb05104-1d9d-5307-88a8-33037d9f7de1" :question/math-academy-id "q-167229" :question/problem "Find the minimum number of luxury white chocolate boxes the company needs to produce per day to make a daily profit of $$600.$\n\nThe company needs to produce$\\,$\n{{field-1}}$\\,$ luxury white chocolate boxes per day." :question/worked-solution "From part 5, the required number of white chocolate boxes $x$ is the solution to the equation\n\n$$\n3\\cdot ({x}^{2}-30x+200)=0.\n$$\n\nDividing this equation by $3,$ we have\n\n$$\n{x}^{2}-30x+200=0.\n$$\n\nTo solve this equation, we want to find a factor pair of the constant term $(200)$ that also adds up to the coefficient of the linear term $(-30).$ The required factors are $(-10)$ and $(-20).$\n\nUsing this factor pair, we write the linear term as $-30x=-10x-20x,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-30x+200 & =0 \\\\ {x}^{2}-10x-20x+200 & =0\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}-10x-20x+200 & =0 \\\\ ({x}^{2}-10x)+(-20x+200) & =0 \\\\ x(x-10)-20(x-10) & =0 \\\\ (x-10)(x-20)\\end{aligned}\n$$\n\nHence, the solutions are $x=10$ or $x=20.$ Since we require the minimum solution, we conclude that the company needs to produce $10$ luxury white chocolate boxes per day to make a profit of $$600.$"}] [{:db/id #edb/ref 17592186258686 :knowledge-point/_questions [{:knowledge-point/id #uuid "36e1e439-ec4a-5577-80d5-3b113bf36e74" :knowledge-point/title "Converting a Recursive Formula to an Explicit Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be9bb242-d8e0-523e-a10d-ba52a7adb2a7" :answer/type {:db/ident :answer.type/math} :answer/value "5n+5" :db/id #edb/ref 17592186258688}] :answer-field/correct {:answer/id #uuid "be9bb242-d8e0-523e-a10d-ba52a7adb2a7" :answer/type {:db/ident :answer.type/math} :answer/value "5n+5" :db/id #edb/ref 17592186258688} :answer-field/id #uuid "c7fd9160-1049-5716-8152-75e1f972a4e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258687}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3439e283-cebc-5b5c-92b2-6edb9d70656f" :question/math-academy-id "q-167230" :question/problem "The company wants to increase its output by implementing a new production model. The number of luxury white chocolate boxes ${a}_{n}$ produced on the $n$th day since the implementation of the new model is given by the arithmetic sequence\n\n$$\n{a}_{n+1}={a}_{n}+5,\\,{a}_{1}=10,\\,n\\ge 1\n$$\n\nWhat is the explicit formula for the $n$th term of this arithmetic sequence?\n\n${a}_{n}=$\n{{field-1}}" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term ${a}_{1}$ and the common difference $d.$\n\nWe are given that the first term is ${a}_{1}=10,$ and we can use the recursive rule to compute the second term as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}+5 \\\\  & =10+5 \\\\  & =15\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =15-10 \\\\  & =5\\end{aligned}\n$$\n\nNow we substitute ${a}_{1}=10$ and $d=5$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =10+(n-1)(5) \\\\  & =10+5n-5 \\\\  & =5n+5\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=5n+5,\\,n\\ge 1.\n$$"}] [{:db/id #edb/ref 17592186258689 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d65819f-0528-527e-8d1a-20421e221ca5" :knowledge-point/title "Finding Coterminal Angles in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d7b9fe9-363b-5c56-8f86-c8753415720b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186258691}] :answer-field/correct {:answer/id #uuid "7d7b9fe9-363b-5c56-8f86-c8753415720b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186258691} :answer-field/id #uuid "7801f687-43e5-5b78-9ddc-4b65f5614671" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258690}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "96eea9dc-629b-5788-b0d6-83fae5b2d265" :question/math-academy-id "q-1687" :question/problem "Which angle is coterminal with $\\frac{8\\pi }{3}?$\n\nAnswer: {{answer}}" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $ (in radians), we add and subtract integer multiples of $2\\pi :$\n\nLet's start by adding multiples of $2\\pi $ to $\\frac{8\\pi }{3}$:\n\n- $\\frac{8\\pi }{3}+2\\pi =\\frac{14\\pi }{3}$\n\nThere are no answer choices larger than $\\frac{14\\pi }{3},$ so we can stop here.\n\nNow, let's subtract multiples of $2\\pi $ from $\\frac{8\\pi }{3}$:\n\n- $\\frac{8\\pi }{3}-2\\pi =\\frac{2\\pi }{3}\\,✓$\n\n- $\\frac{8\\pi }{3}-2\\cdot (2\\pi )=-\\frac{4\\pi }{3}$\n\n- $\\frac{8\\pi }{3}-3\\cdot (2\\pi )=-\\frac{10\\pi }{3}$\n\nThere are no answer choices smaller than $-\\frac{10\\pi }{3},$ so we can stop here.\n\nSo the correct answer is $\\frac{2\\pi }{3}.$"}] [{:db/id #edb/ref 17592186258692 :knowledge-point/_questions [{:knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad12b9e-4974-5164-a400-ca66e15d7e60" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186258694}] :answer-field/correct {:answer/id #uuid "0ad12b9e-4974-5164-a400-ca66e15d7e60" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186258694} :answer-field/id #uuid "effc45c7-2b7f-53bd-9606-791d0a6f57ca" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258693}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7e6e397-9e1b-53ed-9539-68c7fd844687" :question/math-academy-id "q-1700" :question/problem "Find the value of $\\operatorname{tan}({270}^{∘})=$\n\nAnswer: {{answer}}\n\nIf the value is undefined, enter \"Undefined\"." :question/worked-solution "The angle ${270}^{∘}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle ${270}^{∘}$ corresponds to the point $(0,-1).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}({270}^{∘})=0.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}({270}^{∘})=-1.$\n\nTherefore, using the fact that $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{tan}({270}^{∘})=\\frac{\\operatorname{sin}({270}^{∘})}{\\operatorname{cos}({270}^{∘})}=\\frac{-1}{0}.\n$$\n\nHowever, division by zero is undefined. Therefore, $\\operatorname{tan}({270}^{∘})$ is undefined."}] [{:db/id #edb/ref 17592186258735 :knowledge-point/_questions [{:knowledge-point/id #uuid "f302298b-bae3-563f-9238-eb5f3280c556" :knowledge-point/title "Applying the Rules of Sum and Product With Letter and Digits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03404903-6661-5ae8-b691-ba3920cab111" :answer/type {:db/ident :answer.type/math} :answer/value "512" :db/id #edb/ref 17592186258737}] :answer-field/correct {:answer/id #uuid "03404903-6661-5ae8-b691-ba3920cab111" :answer/type {:db/ident :answer.type/math} :answer/value "512" :db/id #edb/ref 17592186258737} :answer-field/id #uuid "0196557c-c5ad-5730-928e-ed86abb7f003" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258736}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9727e37f-7458-5fb2-9794-a48d52770acf" :question/math-academy-id "q-1803" :question/problem "A word consists of $3$ letters, as shown below:\n\n| Letter | Letter | Letter |\n| --- | --- | --- |\n\nHere, each \"Letter\" can be any capital from A-H ($8$ in total). How many possible words are there?\n\nAnswer: {{answer}}" :question/worked-solution "For each letter, there is a total of $8$ possibilities: A, B, C, D, E, F, G, and H.\n\nUsing the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of words} & =\\text{Number of options in the first slot} \\\\  & \\times \\text{Number of options in the second slot} \\\\  & \\times \\text{Number of options in the third slot} \\\\  & =8\\times 8\\times 8 \\\\  & ={8}^{3} \\\\  & =512.\\end{aligned}\n$$\n\nSo, there are $512$ possible words."}] [{:db/id #edb/ref 17592186258738 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0c5630e-f5f4-54c8-8584-dcc2aedcb980" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{106}" :db/id #edb/ref 17592186258740}] :answer-field/correct {:answer/id #uuid "b0c5630e-f5f4-54c8-8584-dcc2aedcb980" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{106}" :db/id #edb/ref 17592186258740} :answer-field/id #uuid "d6c75e0d-a439-53ac-bd9b-8fbde45fa6f9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258739}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8406b4e9-04c6-52fc-af84-020cf7ff3fa4" :question/math-academy-id "q-18047" :question/problem "Let $a=⟨5,9⟩.$ Find $|\\,a\\,|.$\n\nAnswer: {{answer}}" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(5)^{2}+(9)^{2}} \\\\  & =\\sqrt{25+81} \\\\  & =\\sqrt{106}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258741 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5465f7ff-6941-5b43-892e-7db05bc0ea62" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186258743}] :answer-field/correct {:answer/id #uuid "5465f7ff-6941-5b43-892e-7db05bc0ea62" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186258743} :answer-field/id #uuid "b62aaa6b-f109-5d1c-bc9f-45c53fc6c0e8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258742}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "425402e4-1000-5287-829b-c8c1c029863d" :question/math-academy-id "q-18048" :question/problem "if $a=⟨-4,8⟩$, then  what is the magnitude of  $a?$\n\nAnswer: {{answer}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =\\sqrt{16\\cdot 5} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258744 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9043654-a6a6-5fda-9fca-448b0e42f6e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186258746}] :answer-field/correct {:answer/id #uuid "b9043654-a6a6-5fda-9fca-448b0e42f6e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186258746} :answer-field/id #uuid "feea1213-d4dc-56ef-94d3-648d9b29c71a" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258745}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a5ac1d93-f1e5-5ed9-858c-8c960fa481ce" :question/math-academy-id "q-18049" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1a250499768a91e3e225a05d141e42d7ed89168ba82c5560777f64b8b29fac4a.png)\n\nLet $C(-1,3)$ and $D(1,-2).$ Find $|\\overset{\\to }{CD}|.$\n\nAnswer: {{answer}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=-i+3j, \\\\  & \\overset{\\to }{OD}=d=i-2j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{CD}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =\\overset{\\to }{OD}-\\overset{\\to }{OC} \\\\  & =d-c \\\\  & =(i-2j)-(-i+3j) \\\\  & =2i-5j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{CD}| & =\\sqrt{{2}^{2}+(-5)^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258750 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f28586fc-b338-5f64-812b-f9245dd5f3c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186258752}] :answer-field/correct {:answer/id #uuid "f28586fc-b338-5f64-812b-f9245dd5f3c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186258752} :answer-field/id #uuid "55beb37c-2d2b-5ea3-a917-eaab108a2bd3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258751}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2e284b77-e04c-5fe5-8766-d54dc8a48dab" :question/math-academy-id "q-18055" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1e3e9c336bf85cf0f19b2326f12c5fd986fee5b0aae65b8d79257ea234efee13.png)\n\nPoints $P$ and $Q$ are shown in the picture above. Find $|\\overset{\\to }{PQ}|.$\n\nAnswer: {{answer}}" :question/worked-solution "From the picture, we obtain $P(1,1)$ and $Q(2,3).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+j, \\\\  & \\overset{\\to }{OQ}=q=2i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(2i+3j)-(i+j) \\\\  & =i+2j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{{1}^{2}+(2)^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258853 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2da4c-01a9-5aec-8ed0-4837588db794" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258855}] :answer-field/correct {:answer/id #uuid "8cb2da4c-01a9-5aec-8ed0-4837588db794" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258855} :answer-field/id #uuid "ce8f3da4-f6ae-5e81-af3b-b85a93e4272f" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258854} {:answer-field/choices [{:answer/id #uuid "41938051-cf64-5229-9f63-7c6cf400baea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258857}] :answer-field/correct {:answer/id #uuid "41938051-cf64-5229-9f63-7c6cf400baea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258857} :answer-field/id #uuid "079eb80a-3cfb-5b85-a9f2-6944f89285d6" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258856}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "792abd45-247a-55f0-b21d-fe9a605db7a6" :question/math-academy-id "q-211304" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/73da11bf77a8bc10c00f5636176321ed1b44bbf614c8d4658e574e8ae5f85831.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global minimum of $y=f(3x)+4?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Notice that the graph of $y=f(3x)+4$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $\\frac{1}{3}$ parallel to the $x$-axis, and then\n\n- translating it by $4$ units up.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the global minimum of $y=f(x)$ to the global minimum of $y=f(3x)+4.$ So, we need to find the image of $(15,-5),$ the global minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=f(3x)+4,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(15,-5).$\n\n- Then, we stretch the result along the $x$-axis by a scale factor of $\\frac{1}{3}$ and get the graph of $y=f(3x).$ After this transformation, the point $(15,-5)$ will be mapped to the point\n\n$$\n(\\frac{1}{3}\\cdot 15,-5)=(5,-5).\n$$\n\n- Finally, we shift the graph vertically by $4$ units up and get the graph of $y=f(3x)+4.$ After this transformation, the point $(5,-5)$ will be mapped to the point\n\n$$\n(5,-5+4)=(5,-1).\n$$\n\nTherefore, the global minimum of $y=f(3x)+4$ is $(5,-1).$"}] [{:db/id #edb/ref 17592186258858 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c37f8b76-b2a0-54d0-81ef-dc0d585b9280" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258860}] :answer-field/correct {:answer/id #uuid "c37f8b76-b2a0-54d0-81ef-dc0d585b9280" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258860} :answer-field/id #uuid "7886f806-4b4e-5ec7-9ff0-f5abc6c38247" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258859} {:answer-field/choices [{:answer/id #uuid "25a0f757-7428-5a0c-9bb3-857b616e17c0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258862}] :answer-field/correct {:answer/id #uuid "25a0f757-7428-5a0c-9bb3-857b616e17c0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186258862} :answer-field/id #uuid "18331c92-2d7a-5990-b3ed-933af437497e" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258861}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3ec07d68-7e85-5648-b443-8e43087e0d24" :question/math-academy-id "q-211305" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d8d23cf36bc9fb526c0e6d041b72e6b378638f662b67aae63531c66b4a8cd6c5.png)\n\nThe diagram above shows the local minimum and maximum of the function $y=f(x).$ What is the local maximum of $y=3f(\\frac{x}{2})?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Notice that the graph of $y=3f(\\frac{x}{2})$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $2$ parallel to the $x$-axis, and then\n\n- stretching it by a scale factor of $3$ parallel to the $y$-axis.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the local maximum of $y=f(x)$ to the local maximum of $y=3f(\\frac{x}{2}).$ So, we need to find the image of $(-2,-1),$ the local maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=3f(\\frac{x}{2}),$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(-2,-1).$\n\n- Then, we  stretch the graph  along the $x$-axis by a scale factor of $2$ and get the graph of $y=f(\\frac{x}{2}).$ After this transformation, the point $(-2,-1)$ will be mapped to the point\n\n$$\n(2\\cdot (-2),-1)=(-4,-1).\n$$\n\n- Finally, we stretch the result  along the $y$-axis by a scale factor of $3$ and get the graph of $y=3f(\\frac{x}{2}).$ After this transformation, the point $(-4,-1)$ will be mapped to the point\n\n$$\n(-4,3\\cdot (-1))=(-4,-3).\n$$\n\nTherefore, the local maximum of $y=3f(\\frac{x}{2})$ is $(-4,-3).$"}] [{:db/id #edb/ref 17592186258863 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93da801d-0b72-5360-a947-82b1e7f55971" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258865}] :answer-field/correct {:answer/id #uuid "93da801d-0b72-5360-a947-82b1e7f55971" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258865} :answer-field/id #uuid "a87437f4-6972-5d12-b08e-6f25c6683f33" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258864} {:answer-field/choices [{:answer/id #uuid "a3290094-9762-5a7e-9778-bbfbd1085202" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258867}] :answer-field/correct {:answer/id #uuid "a3290094-9762-5a7e-9778-bbfbd1085202" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258867} :answer-field/id #uuid "5ccb4329-6487-5563-a24d-77de4314a055" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258866}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "99887be0-5847-549d-86a8-9ddaeb49436c" :question/math-academy-id "q-211461" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/57f2d73dd902d3e0bafec168cfe6ecd46dfc7d7a9e05f3cf33d710ca3f6b1e76.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global minimum of $y=2f(x)+5?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "Notice that the graph of $y=2f(x)+5$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $2$ parallel to the $y$-axis, and then\n\n- translating it by $5$ units up.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the global minimum of $y=f(x)$ to the global minimum of $y=2f(x)+5.$ So, we need to find the image of $(4,-5),$ the global minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=2f(x)+5,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(4,-5).$\n\n- Then, we stretch the graph along the $y$-axis by a scale factor of $2$ and get the graph of $y=2f(x).$ After this transformation, the point $(4,-5)$ will be mapped to the point\n\n$$\n(4,2\\cdot (-5))=(4,-10).\n$$\n\n- Finally, we shift the result parallel to the $y$-axis by $5$ units up and get the graph of $y=2f(x)+5.$ After this transformation, the point $(4,-10)$ will be mapped to the point\n\n$$\n(4,-10+5)=(4,-5).\n$$\n\nTherefore, the global minimum of $y=2f(x)+5$ is $(4,-5).$"}] [{:db/id #edb/ref 17592186258873 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f0de88a-188e-520b-92ae-cabf356afd49" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258875}] :answer-field/correct {:answer/id #uuid "9f0de88a-188e-520b-92ae-cabf356afd49" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258875} :answer-field/id #uuid "00420ee4-74b7-5f21-9e8b-16d3139d38b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258874}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3e1a7869-1d36-5605-ac92-b7a41430847f" :question/math-academy-id "q-214154" :question/problem "Consider the following sequence:\n\n$$\nf(n+2)=f(n+1)+f(n)\\,,\\,f(1)=3\\,,\\,f(2)=-1,\\,n\\ge 1\n$$\n\nThe fourth term of the sequence is{{field-1}}." :question/worked-solution "The fourth term is represented by $f(4).$\n\nTo compute $f(4),$ we first need to compute $f(3).$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =(-1)+3 \\\\ f(3) & =2\\end{aligned}\n$$\n\nNext, to compute $f(4),$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =2+(-1) \\\\ f(4) & =1\\end{aligned}\n$$\n\nTherefore, the fourth term of the sequence is $f(4)=1.$"}] [{:db/id #edb/ref 17592186258876 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c60e9f3-3322-57c7-85da-e65ea232ef9e" :knowledge-point/title "Finding the Intersection of Two Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41443632-64e8-54e5-abe8-4ce4a5109c16" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258878}] :answer-field/correct {:answer/id #uuid "41443632-64e8-54e5-abe8-4ce4a5109c16" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258878} :answer-field/id #uuid "e736af70-aec3-5cfd-8854-8fc88ddd4184" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258877} {:answer-field/choices [{:answer/id #uuid "3754c365-f3e4-5f46-bf4e-91d2484608c0" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186258880}] :answer-field/correct {:answer/id #uuid "3754c365-f3e4-5f46-bf4e-91d2484608c0" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186258880} :answer-field/id #uuid "098ecdb4-b6be-595b-9324-0622d00f1861" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258879} {:answer-field/choices [{:answer/id #uuid "72680562-7418-5d88-86ce-91e592b71425" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258882}] :answer-field/correct {:answer/id #uuid "72680562-7418-5d88-86ce-91e592b71425" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258882} :answer-field/id #uuid "a64f3a61-4455-52da-95c2-a103ee70065b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3a0bc755-6ef3-5d48-9db2-a94c7ff5cd90" :question/math-academy-id "q-214601" :question/problem "Find the intersection of intervals $(-3,\\infty )\\cap (1,2).$ Express the result as an inequality.\n\n{{field-1}}\n$<x$\n{{field-2}}{{field-3}}" :question/worked-solution "We start by sketching the two intervals $(-3,\\infty )$ and $(1,2)$ separately:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/0e13318d542f265c4e6955710971f22c58a730c849da9dfdf7750667b8008269.png)\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/245813c1d2c41fbe3984e244cba87f0fc33f608d1cba55f9e336f58e16ed2c70.png)\n\nThe intersection $(-3,\\infty )\\cap (1,2)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/238d86c58f32da3c5bed87ad1ed44d3db1ae2daa00d4cafcb82b83cf482f6e9e.png)\n\nThus, $(-3,\\infty )\\cap (1,2)=(1,2).$ This corresponds to the inequality $1<x<2.$"}] [{:db/id #edb/ref 17592186258946 :knowledge-point/_questions [{:knowledge-point/id #uuid "bba0ad98-6940-502a-873c-8a589a03a499" :knowledge-point/title "Finding Coterminal Angles in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47ceb83f-6cc8-58ef-aa1a-c18c5da82874" :answer/type {:db/ident :answer.type/math} :answer/value "{145}^{∘}" :db/id #edb/ref 17592186258948}] :answer-field/correct {:answer/id #uuid "47ceb83f-6cc8-58ef-aa1a-c18c5da82874" :answer/type {:db/ident :answer.type/math} :answer/value "{145}^{∘}" :db/id #edb/ref 17592186258948} :answer-field/id #uuid "a70725e6-912d-57c9-923b-d73aea67ddd7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258947}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "13000a10-55bd-5f4c-8290-3040e5cc82c7" :question/math-academy-id "q-23188" :question/problem "What angles are coterminal with $\\theta ={145}^{∘}?$\n\nI. - ${155}^{∘}$\nII. - ${505}^{∘}$\nIII. - $-{575}^{∘}$\n\nAnswer: {{answer}}" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $, we add and subtract integer multiples of ${360}^{∘}:$\n\nLet's start by adding multiples of ${360}^{∘}$ to ${145}^{∘}$:\n\n- ${145}^{∘}+{360}^{∘}={505}^{∘}\\,✓$\n\nOf the given values, there is no angle greater than ${505}^{∘}.$ So we can stop there.\n\nNow, let's subtract multiples of ${360}^{∘}$ from ${145}^{∘}$\n\n- ${145}^{∘}-{360}^{∘}=-{215}^{∘}$\n\n- ${145}^{∘}-2\\cdot {360}^{∘}=-{575}^{∘}\\,✓$\n\nOf the given angles, only ${505}^{∘}$ and $-{575}^{∘}$ are coterminal with ${145}^{∘}.$\n\nSo the correct answer is II and III only."}] [{:db/id #edb/ref 17592186259005 :knowledge-point/_questions [{:knowledge-point/id #uuid "6aa081d4-f85a-5239-b034-b78894429611" :knowledge-point/title "Finding the Roots of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9410aef-859a-50f6-97ef-91aa9b99d3e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259007}] :answer-field/correct {:answer/id #uuid "d9410aef-859a-50f6-97ef-91aa9b99d3e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259007} :answer-field/id #uuid "f3483412-84da-5ca5-8b46-ea4c410dfb39" :answer-field/key "root-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259006} {:answer-field/choices [{:answer/id #uuid "dc60f7c2-bdc3-55b2-8f01-98d1b2da6836" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186259009}] :answer-field/correct {:answer/id #uuid "dc60f7c2-bdc3-55b2-8f01-98d1b2da6836" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186259009} :answer-field/id #uuid "4d24f560-5de1-53ca-a224-e5768fffe719" :answer-field/key "root-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259008}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fe159bf6-a623-5b2b-9a60-8be08ef9e05c" :question/math-academy-id "q-24395" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/6d2d3e924745d0703358b87c1a201113bcce2d02618ad1dce27d51d58eb6fbf7.png)\n\nFind the roots of the parabola shown above.\n\nValue 1 (least to greatest): {{root-1}}\n\nValue 2 (least to greatest): {{root-2}}" :question/worked-solution "The roots of a parabola are the $x$-intercepts of the parabola.\n\nFrom the graph, we can see that the curve intercepts the $x$-axis at the points $(2,0)$ and $(3,0).$\n\nTherefore, the roots are $x=2$ and $x=3.$"}] [{:db/id #edb/ref 17592186259063 :knowledge-point/_questions [{:knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ceb3578-325a-5ac3-b3ab-ba577bb36a47" :answer/type {:db/ident :answer.type/math} :answer/value "3a-\\frac{7b}{2}+5" :db/id #edb/ref 17592186259065}] :answer-field/correct {:answer/id #uuid "4ceb3578-325a-5ac3-b3ab-ba577bb36a47" :answer/type {:db/ident :answer.type/math} :answer/value "3a-\\frac{7b}{2}+5" :db/id #edb/ref 17592186259065} :answer-field/id #uuid "5996d810-799a-5238-b993-7cd514529d8f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259064}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ad52b62c-9add-5bf7-8a08-8fb877b371f6" :question/math-academy-id "q-2594" :question/problem "$\\frac{6a-7b+10}{2}=$\n\nAnswer: {{answer}}" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{6a-7b+10}{2} & = \\\\ \\frac{6a}{2}-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ \\frac{6}{2}\\cdot a-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ 3a-\\frac{7b}{2}+5 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259066 :knowledge-point/_questions [{:knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae4f6ae-5fb1-5cc5-ae42-10498c9ce19c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186259068}] :answer-field/correct {:answer/id #uuid "1ae4f6ae-5fb1-5cc5-ae42-10498c9ce19c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186259068} :answer-field/id #uuid "d6597cdd-3d12-57fe-91b5-adb0d3826231" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259067}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd83f564-9cd2-544d-a015-59cb37cfe78b" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$\n\nAnswer: {{answer}}" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f & = \\\\ \\frac{5d}{3}-3e-2f & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259069 :knowledge-point/_questions [{:knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0ca1201-59d6-5d99-8425-54337f9aba1a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259071}] :answer-field/correct {:answer/id #uuid "e0ca1201-59d6-5d99-8425-54337f9aba1a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186259071} :answer-field/id #uuid "85f980d9-837e-5661-9515-10e93fcf55b9" :answer-field/key "p" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259070} {:answer-field/choices [{:answer/id #uuid "17151e89-3a7d-5b5c-884f-a5edd5e6675e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186259073}] :answer-field/correct {:answer/id #uuid "17151e89-3a7d-5b5c-884f-a5edd5e6675e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186259073} :answer-field/id #uuid "270ac144-5953-5cbb-ba46-e5db7c41213c" :answer-field/key "q" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259072}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a30fbd5f-352a-5d56-829a-7c77316d6cc7" :question/math-academy-id "q-2601" :question/problem "If $\\frac{16a-8}{4}$ is written in the form $pa+q,$ what are the values of $p$ and $q?$\n\n$p$: {{p}}\n\n$q$: {{q}}" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{16a-8}{4} & = \\\\ \\frac{16a}{4}-\\frac{8}{4} & = \\\\ \\frac{16}{4}\\cdot a-2 & = \\\\ 4a-2 & .\\end{aligned}\n$$\n\nWriting the above in the form $pa+qb,$ we get\n\n$$\n\\begin{aligned}{{(4)}_{⏟}}_{p}a+{{(-2)}_{⏟}}_{q}.\\end{aligned}\n$$\n\nTherefore, $p=4$ and $q=-2.$"}] [{:db/id #edb/ref 17592186259083 :knowledge-point/_questions [{:knowledge-point/id #uuid "b406f464-6326-5dbf-b35c-8cde390a65de" :knowledge-point/title "Computing the Sine or Cosine of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf1192f-e906-594d-8ba6-63ec104447d2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259085}] :answer-field/correct {:answer/id #uuid "4bf1192f-e906-594d-8ba6-63ec104447d2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259085} :answer-field/id #uuid "423b274d-aff4-55df-8241-04b8772148bd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259084}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "73fddfea-f037-5816-ab9d-7f787859e070" :question/math-academy-id "q-262388" :question/problem "$\\operatorname{cos}({270}^{∘})+\\operatorname{sin}({180}^{∘})=${{field-1}}" :question/worked-solution "The angles ${180}^{∘}$ and ${270}^{∘}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/edad8c833f65c54453fe40a326cbf9394c263213934447872b530a8e4fb86de1.png)\n\n- Let's first consider the angle ${270}^{∘}.$ From the unit circle, we see that the angle ${270}^{∘}$ corresponds to the point $(0,-1).$ Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}({270}^{∘})=0.$\n\n- Now, let's consider the angle ${180}^{∘}.$ From the unit circle, we see that the angle ${180}^{∘}$ corresponds to the point $(-1,0).$ Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}({180}^{∘})=0.$\n\nFinally, we get\n\n$$\n\\operatorname{cos}({270}^{∘})+\\operatorname{sin}({180}^{∘})=0+0=0.\n$$"}] [{:db/id #edb/ref 17592186259092 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2e28247-1113-5d9f-9c76-49af8b498fc5" :knowledge-point/title "Computing a Reciprocal Ratio of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afb72c02-64d8-52ba-87e1-0d7943bea5d7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259094}] :answer-field/correct {:answer/id #uuid "afb72c02-64d8-52ba-87e1-0d7943bea5d7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259094} :answer-field/id #uuid "9fef343c-8013-5791-9491-769519311f08" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259093}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aff059bf-4c64-5257-9909-c76ee946a250" :question/math-academy-id "q-262541" :question/problem "Find the value of $\\operatorname{sec}\\pi +\\operatorname{csc}(\\frac{\\pi }{2}).$\n\n$\\operatorname{sec}\\pi +\\operatorname{csc}(\\frac{\\pi }{2})=\\,$\n{{field-1}}" :question/worked-solution "The angles $\\pi $ and $\\frac{\\pi }{2}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/edad8c833f65c54453fe40a326cbf9394c263213934447872b530a8e4fb86de1.png)\n\n- Let's first consider the angle $\\pi .$ From the unit circle, we see that the angle $\\pi $ corresponds to the point $(-1,0).$  Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}\\pi =-1.$ Therefore, using the fact that $\\operatorname{sec}\\theta =\\frac{1}{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{sec}\\pi =\\frac{1}{\\operatorname{cos}\\pi }=\\frac{1}{-1}=-1.\n$$\n\n- Now, let's consider the angle $\\frac{\\pi }{2}.$ From the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$  Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{2})=1.$ Therefore, using the fact that $\\operatorname{csc}\\theta =\\frac{1}{\\operatorname{sin}\\theta },$ we have\n\n$$\n\\operatorname{csc}(\\frac{\\pi }{2})=\\frac{1}{\\operatorname{sin}(\\frac{\\pi }{2})}=\\frac{1}{1}=1.\n$$\n\nFinally, we get\n\n$$\n\\operatorname{sec}\\pi +\\operatorname{csc}(\\frac{\\pi }{2})=-1+1=0.\n$$"}] [{:db/id #edb/ref 17592186259110 :knowledge-point/_questions [{:knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daec97e4-b893-5a00-8712-be94dd2588ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259112}] :answer-field/correct {:answer/id #uuid "daec97e4-b893-5a00-8712-be94dd2588ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259112} :answer-field/id #uuid "02800155-9bcb-5259-ba8e-424d9ec268b5" :answer-field/key "coordinate-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259111} {:answer-field/choices [{:answer/id #uuid "80e6f508-e53b-518c-98fa-cbc0b562a713" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186259114}] :answer-field/correct {:answer/id #uuid "80e6f508-e53b-518c-98fa-cbc0b562a713" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186259114} :answer-field/id #uuid "d4474c4f-228a-53d0-ae2e-3764680f1481" :answer-field/key "coordinate-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259113}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "49cddfeb-1204-5342-9323-0f53acd49339" :question/math-academy-id "q-26597" :question/problem "The point  $(0,4)$ lies on the curve $y=f(x)+2.$ What points **must** lie on $y=-f(x)-3?$\n\nCoordinate 1: {{coordinate-1}}\n\nCoordinate 2: {{coordinate-2}}" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)-3,$ we apply the following steps: \n\n- First, take the graph $y=f(x)+2.$\n\n- Then, we shift the graph vertically by $2$ unit down and get the graph of $y=f(x).$ After this transformation, the point $(0,4)$ will be mapped to the point\n\n$$\n(0,4-2)=(0,2).\n$$\n\n- Next, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(0,2)$ will be mapped  to the point\n\n$$\n(0,-(2))=(0,-2).\n$$\n\n- Finally, shift the result vertically by $3$ units down and obtain the graph of $y=-f(x)-3.$ After this transformation, the point $(0,-2)$ will be mapped to the point \n\n$$\n(0,-2-3)=(0,-5).\n$$\n\n**Method 2**\n\nSince the point $(0,4)$ lies on the graph of $y=f(x)+2$, we have that \n\n$$\nf(0)+2=4\\,⟹\\,f(0)=2.\n$$\n\nNow consider the graph of $y=-f(x)-3.$ Substituting $x=0$, we get\n\n$$\n\\begin{aligned}y & =-f(0)-3 \\\\  & =-2-3 \\\\  & =-5.\\end{aligned}\n$$\n\nTherefore, the point $(0,-5)$ must lie on $y=-f(x)-3.$"}] [{:db/id #edb/ref 17592186259322 :knowledge-point/_questions [{:knowledge-point/id #uuid "d916584b-c94e-557f-a438-f0464c1cea87" :knowledge-point/title "Finding the Intersection of Three Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92079d22-6708-52f2-9272-039ace1db573" :answer/type {:db/ident :answer.type/math} :answer/value "\\emptyset" :db/id #edb/ref 17592186259324}] :answer-field/correct {:answer/id #uuid "92079d22-6708-52f2-9272-039ace1db573" :answer/type {:db/ident :answer.type/math} :answer/value "\\emptyset" :db/id #edb/ref 17592186259324} :answer-field/id #uuid "5cee0f86-5317-5631-a0c3-945ea1ae0623" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259323}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "28246b2b-cdc4-5900-874e-a9bf17a69498" :question/math-academy-id "q-28910" :question/problem "Given the inequalities $-3\\le x\\le 3,$ $\\,x<-1,$ and $\\,x>\\frac{1}{2}$, What sets, expressed in interval notation, represents their common set of values?\n\nAnswer: {{answer}}" :question/worked-solution "To find the common set of values, we graph the inequalities on a number line and find where they overlap:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/6b3676a8f1a489200f861b7e5496b5ae98312a424b3341e120cd0200fdbbdb92.png)\n\nFrom the graph above, we determine that there are no common points."}] [{:db/id #edb/ref 17592186259394 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae1738d1-3261-5769-ab80-0edcc76ab6f3" :knowledge-point/title "Computing the Y-Intercept of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e47c6b49-e3ce-5556-8d0d-cb202b1a4356" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac32" :db/id #edb/ref 17592186259396}] :answer-field/correct {:answer/id #uuid "e47c6b49-e3ce-5556-8d0d-cb202b1a4356" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac32" :db/id #edb/ref 17592186259396} :answer-field/id #uuid "de1b8841-efef-53fd-8d2d-8d82fb7aa2a3" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259395}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0b30ed9d-e1db-5113-aeb4-9d6baba177b2" :question/math-academy-id "q-30780" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/315b26c0b615d3e9d6e422903b006ddf5eb8394aebbc75776453f46596f3e120.png)\n\nThe equation of the curve above is $y=\\frac{1}{2}{x}^{2}-3x+k.$ Find the value of $k.$\n\nAnswer: {{answer}}" :question/worked-solution "Notice that if we substitute $x=0$ into the given equation, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}{x}^{2}-3x+k \\\\ y & =\\frac{1}{2}(0)^{2}-3(0)+k \\\\ y & =k,\\end{aligned}\n$$\n\nmeaning that the curve intercepts the $y$-axis at the point $(0,k).$ Based on the graph, we can find that $k=-\\frac{3}{2}$ since our parabola intercepts the $y$-axis at $(0,-\\frac{3}{2}).$"}] [{:db/id #edb/ref 17592186260169 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/title "Applying the Root Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad237af-5238-57f1-808d-7e9e471fd368" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt[5]{2}" :db/id #edb/ref 17592186260171}] :answer-field/correct {:answer/id #uuid "1ad237af-5238-57f1-808d-7e9e471fd368" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt[5]{2}" :db/id #edb/ref 17592186260171} :answer-field/id #uuid "ad54c7fa-35e5-5d53-91ff-e0f9bbbadb45" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260170}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2c647934-51df-52e0-8c0b-5d7fb08a09a0" :question/math-academy-id "q-35284" :question/problem "Find ${lim}_{x\\to -1}\\sqrt[5]{(7x+11)^{3}}.$\n\nAnswer: {{answer}}" :question/worked-solution "Applying the root rule, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\sqrt[5]{(7x+11)^{3}} & =\\sqrt[5]{{lim}_{x\\to -1}(7x+11)^{3}} \\\\  & =\\sqrt[5]{{({lim}_{x\\to -1}(7x+11))}^{3}} \\\\  & =\\sqrt[5]{(7(-1)+11)^{3}} \\\\  & =\\sqrt[5]{{4}^{3}} \\\\  & =\\sqrt[5]{64} \\\\  & =\\sqrt[5]{{2}^{5}\\cdot 2} \\\\  & =2\\sqrt[5]{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260359 :knowledge-point/_questions [{:knowledge-point/id #uuid "732b0025-3172-5685-aa98-1f4afcf387ab" :knowledge-point/title "Computing the Probability of the Complement of an Event: Verbal Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "720e1293-6223-51a2-8ae6-b8a8efbd2fe0" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186260361}] :answer-field/correct {:answer/id #uuid "720e1293-6223-51a2-8ae6-b8a8efbd2fe0" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186260361} :answer-field/id #uuid "99a1e029-57c9-5535-a5a5-9b4e8d91d4df" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260360}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4ceee2f4-61b4-5f77-aefc-d5befcee1142" :question/math-academy-id "q-41911" :question/problem "Two balls are drawn from a bag that contains two red balls and two black balls. Define $A$ to be the event \"no black balls are selected.\" It is known that $P(A)=0.25.$ What is the probability of selecting at least one black ball?\n\nAnswer: {{answer}}" :question/worked-solution "The event \"at least one black ball is selected\" is the opposite of the event \"no black balls are selected.\"\n\nSo, the event \"at least one black ball is selected\" is the complement of $A,$ denoted ${A}^{'}.$\n\nSince we know that $P(A)=0.25$ to $2$ decimal places, we can calculate $P({A}^{'})$ using the formula\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ P({A}^{'}) & =1-P(A) \\\\  & =1-0.25 \\\\  & =0.75.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260479 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6956b58-5581-5221-8d4f-88ebde382f0c" :knowledge-point/title "Estimating Using Probabilities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "554267c3-b36b-53f1-96ea-a70a14233d73" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186260481}] :answer-field/correct {:answer/id #uuid "554267c3-b36b-53f1-96ea-a70a14233d73" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186260481} :answer-field/id #uuid "e1976e7b-5e56-5bf2-a749-123a4c7460f8" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260480}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3636bb28-36be-554b-b1a3-2ece301c26d0" :question/math-academy-id "q-47307" :question/problem "A group of randomly selected students from Chicago High School was asked which country they want to visit between Brazil, Spain, France, or Japan. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Brazil | Spain | France | Japan | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $12$ | $20$ | $9$ | $14$ | $55$ |\n| Boys | $14$ | $10$ | $20$ | $1$ | $45$ |\n| Totals | $26$ | $30$ | $29$ | $15$ | $100$ |\n\nBoston High School has $400$ students. Assuming that the distribution of the results is the same in both high schools, estimate the number of girls at Boston High School who wish to visit Brazil or France. Round your answer to the nearest integer.\n\nAnswer: {{answer}}" :question/worked-solution "To estimate the number of girls who wish to visit Brazil or France, we\n\n- add up the numbers in the intersection of the row **\"Girls\"** and the column **\"Brazil\"** and the intersection of the row **\"Girls\"** and the column **\"France\"**, and then\n\n- divide by the total number of data points in the table.\n\n|  | Brazil | Spain | France | Japan | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $12$ | $20$ | $9$ | $14$ | $55$ |\n| Boys | $14$ | $10$ | $20$ | $1$ | $45$ |\n| Totals | $26$ | $30$ | $29$ | $15$ | $100$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(100),$ we get\n\n$$\np=\\frac{12+9}{100}=\\frac{21}{100}=0.21.\n$$\n\nThis represents the estimated probability that a randomly selected student is a girl who wishes to visit Brazil or France.\n\nFinally, to find the estimated number of girls of Boston High School who wish to visit Brazil or France, we multiply the total number of students in Boston High School $(400)$ by the probability above:\n\n$$\n\\begin{aligned}n & =400\\cdot p \\\\  & =400\\cdot 0.21 \\\\  & =84\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260551 :knowledge-point/_questions [{:knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/title "Finding the Product of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f84ad872-89b4-594c-b109-88bee658a266" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186260553}] :answer-field/correct {:answer/id #uuid "f84ad872-89b4-594c-b109-88bee658a266" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186260553} :answer-field/id #uuid "178b3ae7-011a-542f-917e-72857a90aa25" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260552}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd6a8a55-36de-5b05-883a-a794caef72c2" :question/math-academy-id "q-4825" :question/problem "Given $f(x)=2{x}^{2}+5x$ and $g(x)=9-2x,$ find $(fg)(-1).$\n\nAnswer: {{answer}}" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-1),$ we find $f(-1)$ and $g(-1),$ and then multiply the results.\n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =2(-1)^{2}+5(-1)=-3 \\\\ g(-1) & =9-2(-1)=11\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-1)=f(-1)g(-1)=-3\\cdot 11=-33\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(2{x}^{2}+5x)(9-2x) \\\\  & =-4{x}^{3}+8{x}^{2}+45x\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(-1):$ \n\n$$\n\\begin{aligned}(fg)(-1) & =-4(-1)^{3}+8(-1)^{2}+45(-1) \\\\  & =4+8-45 \\\\  & =-33\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260706 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dd64a2-7bd5-5f97-9dad-e0c5611a4652" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260708}] :answer-field/correct {:answer/id #uuid "27dd64a2-7bd5-5f97-9dad-e0c5611a4652" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260708} :answer-field/id #uuid "740de7d4-004d-5340-938d-4b8a451d2832" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260707}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aaf574a4-1edb-5e4e-ad18-e36c426d7d2b" :question/math-academy-id "q-51843" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-3$ and ${a}_{2}=5,$ then ${a}_{4}=$\n\nAnswer: {{answer}}" :question/worked-solution "To compute ${a}_{4},$ we first need to compute ${a}_{3}.$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}{a}_{n+2} & ={a}_{n+1}+{a}_{n} \\\\ {a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =5+(-3) \\\\ {a}_{3} & =2\\end{aligned}\n$$\n\nNext, to compute ${a}_{4},$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =2+5 \\\\ {a}_{4} & =7\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=7.$"}] [{:db/id #edb/ref 17592186260709 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "258fcf2a-82f0-5ea8-bd85-4a4bad015507" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260711}] :answer-field/correct {:answer/id #uuid "258fcf2a-82f0-5ea8-bd85-4a4bad015507" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260711} :answer-field/id #uuid "eee2c678-c53b-5c59-9f8e-f6f6412565fe" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260710}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1511ae51-ebcc-5ba6-b833-34f0d648c90d" :question/math-academy-id "q-51884" :question/problem "If $f(n+2)=f(n+1)+f(n)$ with $f(1)=2$ and $f(2)=7,$ then $f(3)=$\n\nAnswer: {{answer}}" :question/worked-solution "The recursive formula is\n\n$$\nf(n+2)=f(n+1)+f(n).\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =7+2 \\\\ f(3) & =9.\\end{aligned}\n$$\n\nHence, $f(3)=9.$"}] [{:db/id #edb/ref 17592186260778 :knowledge-point/_questions [{:knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841e8a1a-3c8b-5f97-965f-40251f13efe6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260780}] :answer-field/correct {:answer/id #uuid "841e8a1a-3c8b-5f97-965f-40251f13efe6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260780} :answer-field/id #uuid "e656be50-0e8a-5b00-a570-bb0ae760e03d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260779}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "feb815e0-49a2-5a08-9510-a18cd36fc9e1" :question/math-academy-id "q-575" :question/problem "If $a={\\text{i}}^{2}$ then ${a}^{4}=$\n\nAnswer: {{answer}}" :question/worked-solution "Using the power law for exponents, we have\n\n$$\n{a}^{4}={({\\text{i}}^{2})}^{4}={\\text{i}}^{2\\cdot 4}={\\text{i}}^{8}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=8.$ Dividing the power by $4,$ we get\n\n$$\n8÷4=2\\,\\text{R}0.\n$$\n\nSo the remainder is $0.$ Therefore,\n\n$$\n{\\text{i}}^{8}={\\text{i}}^{0}=1.\n$$"}] [{:db/id #edb/ref 17592186260781 :knowledge-point/_questions [{:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "917b7239-d1a9-58a5-ae89-76e89f4a79c1" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186260783}] :answer-field/correct {:answer/id #uuid "917b7239-d1a9-58a5-ae89-76e89f4a79c1" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186260783} :answer-field/id #uuid "31c1f32f-a92e-5062-8efa-0e6b7f45f5da" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260782}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "749914bf-d1a3-5489-91da-4a74ce2608f3" :question/math-academy-id "q-5759" :question/problem "You're buying a new computer and can choose different options: $3$ different levels of RAM, $2$ different hard drive sizes, $3$ different monitor sizes, and $4$ different colors.  How many different computer systems can you create from these choices?\n\nAnswer: {{answer}}" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of computer systems} & =\\text{Number of RAM levels} \\\\  & \\times \\text{Number of hard drive sizes} \\\\  & \\times \\text{Number of monitor sizes} \\\\  & \\times \\text{Number of colors} \\\\  & =3\\times 2\\times 3\\times 4 \\\\  & =72.\\end{aligned}\n$$\n\nTherefore, we can create $72$ different computer systems."}] [{:db/id #edb/ref 17592186260784 :knowledge-point/_questions [{:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfad00bb-0495-5532-915c-4c3d81a054c0" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{32}" :db/id #edb/ref 17592186260786}] :answer-field/correct {:answer/id #uuid "dfad00bb-0495-5532-915c-4c3d81a054c0" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{32}" :db/id #edb/ref 17592186260786} :answer-field/id #uuid "c2b84597-acc5-5c3d-9c3c-d9cb9cddc42b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260785}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "98158fcc-db0f-530b-87f1-367cdd949729" :question/math-academy-id "q-5760" :question/problem "You're letting your computer make random songs using $5$ different notes, and you want the song to be $32$ notes long. All $32$ notes have the same duration. If notes can be repeated, how many different songs can your computer create?\n\nAnswer: {{answer}}" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of songs} & =\\text{Number of choices for the }1\\text{st note} \\\\  & \\times \\text{Number of choices for the }2\\text{nd note} \\\\  & \\times \\text{Number of choices for the }3\\text{rd note} \\\\  & \\times … \\\\  & \\times \\text{Number of choices for the }32\\text{nd note} \\\\  & ={{5\\times 5\\times 5\\times ⋯\\times 5}_{⏟}}_{32\\text{ times}} \\\\  & ={5}^{32}.\\end{aligned}\n$$\n\nTherefore, the computer can create ${5}^{32}$ different songs."}] [{:db/id #edb/ref 17592186260821 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40cfb998-cdc7-5a8a-9862-40b40601bcad" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant II" :db/id #edb/ref 17592186260823} {:answer/id #uuid "74a27f2d-4de7-5c12-bf80-2bc0547ebf19" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant I" :db/id #edb/ref 17592186260824} {:answer/id #uuid "949b5bce-4f4d-5782-b3a1-58fb0babf6a0" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186260825} {:answer/id #uuid "73c35910-0338-58bf-9e5d-77001c9a61d9" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant IV" :db/id #edb/ref 17592186260826}] :answer-field/correct {:answer/id #uuid "74a27f2d-4de7-5c12-bf80-2bc0547ebf19" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant I" :db/id #edb/ref 17592186260824} :answer-field/id #uuid "4a2c4789-d7f3-566b-8e6b-156289316c1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260822}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0e21b7ac-5788-524c-8ceb-e2c5880c1015" :question/math-academy-id "q-64678" :question/problem "The angle $\\theta =-{650}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{650}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $({0}^{∘},{360}^{∘}].$\n\n- $-{650}^{∘}+{360}^{∘}=-{290}^{∘}$\n\n- $-{650}^{∘}+2\\cdot {360}^{∘}={70}^{∘}\\,✓$\n\nSo the angle ${70}^{∘}$ is coterminal with $-{650}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/8dff305410da2b49c69006fdb84b4de6b481ccf2a526f42b18d2eae538601bfb.png)\n\nWe see that ${70}^{∘}$ lies in quadrant I. Therefore, $-{650}^{∘}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186260827 :knowledge-point/_questions [{:knowledge-point/id #uuid "0a119150-6d23-59bd-90c9-699de3a75795" :knowledge-point/title "Finding the Correct Quadrant for Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a098b45-c2e8-5184-ad1b-26d16ee81d23" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant II" :db/id #edb/ref 17592186260829} {:answer/id #uuid "712753df-61f6-5b8d-aac1-8334199f6c95" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant I" :db/id #edb/ref 17592186260830} {:answer/id #uuid "f1ce7416-c18b-595c-8946-699ee597f39c" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant III" :db/id #edb/ref 17592186260831} {:answer/id #uuid "43d72985-f62c-5dcf-b5d5-ca0c6215fc29" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant IV" :db/id #edb/ref 17592186260832}] :answer-field/correct {:answer/id #uuid "8a098b45-c2e8-5184-ad1b-26d16ee81d23" :answer/type {:db/ident :answer.type/text} :answer/value "Quadrant II" :db/id #edb/ref 17592186260829} :answer-field/id #uuid "3612bfb5-d8b9-5b06-9025-f70807e1466e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260828}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "45b2051b-479f-542d-97fb-8807ff31a294" :question/math-academy-id "q-64684" :question/problem "The angle $\\theta =\\frac{17\\pi }{6}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $\\frac{17\\pi }{6}$ by *subtracting* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $\\frac{17\\pi }{6}-2\\pi =\\frac{5\\pi }{6}\\,✓$\n\nSo the angle $\\frac{17\\pi }{6}$ is coterminal with $\\frac{5\\pi }{6}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/1c7c1d3a8d69502521dc71f24335ff79e707867161b95d6a80eaf95c0bf6e36c.png)\n\nWe see that $\\frac{5\\pi }{6}$ lies in quadrant II. Therefore, $\\frac{17\\pi }{6}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186260845 :knowledge-point/_questions [{:knowledge-point/id #uuid "b406f464-6326-5dbf-b35c-8cde390a65de" :knowledge-point/title "Computing the Sine or Cosine of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c93262-23b3-5291-822c-b2fc2431d836" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260847}] :answer-field/correct {:answer/id #uuid "e6c93262-23b3-5291-822c-b2fc2431d836" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260847} :answer-field/id #uuid "1854554f-c17d-57f3-91f8-95d189868d2d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260846}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d76d623-1c6f-5d51-9983-82a36796ab6c" :question/math-academy-id "q-64863" :question/problem "Find the value of $\\operatorname{cos}0.$\n\nAnswer: {{answer}}" :question/worked-solution "The angle $0$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $0$ corresponds to the point $(1,0).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}0=1.$"}] [{:db/id #edb/ref 17592186260896 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e18d451-4c7d-5649-9a73-0b00fa5d26e8" :knowledge-point/title "Finding the Negative Square Root of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee89403a-b838-5763-9a3e-35c189ef12d5" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\text{i}" :db/id #edb/ref 17592186260898}] :answer-field/correct {:answer/id #uuid "ee89403a-b838-5763-9a3e-35c189ef12d5" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\text{i}" :db/id #edb/ref 17592186260898} :answer-field/id #uuid "47e9da61-076c-5a3f-a9a3-d41d13625858" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260897}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a262349d-70c7-58bc-bdc8-80c61e190318" :question/math-academy-id "q-66221" :question/problem "$-\\sqrt{-49}=$\n\nAnswer: {{answer}}" :question/worked-solution "The imaginary unit $\\text{i}$ is defined as:\n\n$$\n\\text{i}=\\sqrt{-1}\n$$\n\nTherefore, the given number can be rewritten as:\n\n$$\n\\begin{aligned}-\\sqrt{-49} & =-\\sqrt{49\\cdot (-1)} \\\\  & =-\\sqrt{49}\\cdot \\sqrt{-1} \\\\  & =-7\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260925 :knowledge-point/_questions [{:knowledge-point/id #uuid "2aafd8db-c723-508f-9ea3-43881f0d9140" :knowledge-point/title "Finding the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15498710-5e8b-5093-9791-0e4698730298" :answer/type {:db/ident :answer.type/math} :answer/value "5x+5" :db/id #edb/ref 17592186260927}] :answer-field/correct {:answer/id #uuid "15498710-5e8b-5093-9791-0e4698730298" :answer/type {:db/ident :answer.type/math} :answer/value "5x+5" :db/id #edb/ref 17592186260927} :answer-field/id #uuid "044aa151-311a-5374-b2c1-d343787d2f55" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260926}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b430534c-adbb-540f-96e1-9fc409650077" :question/math-academy-id "q-66407" :question/problem "If $f(x)=4x-1$ and $g(x)=x+6,$ then $(f+g)(x)=$\n\nAnswer: {{answer}}" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\nTo find the sum of the two functions, we add them together:\n\n$$\n\\begin{aligned}(f+g)(x) & =(4x-1)+(x+6) \\\\  & =(4x+x)+(-1+6) \\\\  & =5x+5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260928 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7638ef27-f19f-5c5f-a5c1-11acc4e29d6a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260930}] :answer-field/correct {:answer/id #uuid "7638ef27-f19f-5c5f-a5c1-11acc4e29d6a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260930} :answer-field/id #uuid "6821fbd9-b4f5-5206-b8ed-cd3fb89fc36b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186260929}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "85eb992c-5f22-5219-9748-87d4d54a3ac2" :question/math-academy-id "q-66412" :question/problem "Given $f(x)={x}^{2}-6$ and $g(x)=-x+2,$ find  $(f-g)(4).$\n\nAnswer: {{answer}}" :question/worked-solution "The notation $(f-g)(x)$ means the difference of the functions $f(x)$ and $g(x).$ \n\n**Method 1** \n\nTo evaluate $(f-g)(4),$ we find $f(4)$ and $g(4),$ and then subtract $g(4)$ from $f(4).$\n\nSo, first we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =(4)^{2}-6=10 \\\\ g(4) & =-(4)+2=-2\\end{aligned}\n$$\n\n \n\nNext, we subtract $g(4)$ from $f(4)$:\n\n$$\n(f-g)(4)=f(4)-g(4)=10-(-2)=12\n$$\n\n**Method 2**\n\nFirst we find the difference of the two functions $f$ and $g$ by subtracting $g(x)$ from $f(x)$: \n\n$$\n\\begin{aligned}(f-g)(x) & =({x}^{2}-6)-(-x+2) \\\\  & ={x}^{2}-6+x-2 \\\\  & ={x}^{2}+x-8\\end{aligned}\n$$\n\nNow, we evaluate $(f-g)(4):$\n\n$$\n\\begin{aligned}(f-g)(4) & =(4)^{2}+4-8=12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261082 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99c8788e-b678-5c57-9fef-cb3884fabb5e" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186261084}] :answer-field/correct {:answer/id #uuid "99c8788e-b678-5c57-9fef-cb3884fabb5e" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186261084} :answer-field/id #uuid "9079c108-3383-5bba-a4f3-e607d0cdd310" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261083}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ddb68ee1-fc65-5b56-84b0-11e3e63cec4f" :question/math-academy-id "q-67700" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d81155f8c9b683e85a7f00ef41ac9ddcf36e303b40ca51c6de3e5d74833d5825.png)\n\nFind ${lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2}$ for the function $f(x)$ plotted above.\n\nAnswer: {{answer}}" :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,3}f(x)=9.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2}={lim}_{x\\to \\,3}(3x-10)^{3}\\cdot {lim}_{x\\to \\,3}(f(x)-x)^{2}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(3x-10)^{3} & ={({lim}_{x\\to \\,3}(3x-10))}^{3} \\\\  & =(3(3)-10)^{3} \\\\  & =(-1)^{3} \\\\  & =-1,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(f(x)-x)^{2} & ={({lim}_{x\\to \\,3}(f(x)-x))}^{2} \\\\  & =(9-3)^{2} \\\\  & ={6}^{2} \\\\  & =36\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}(3x-10)^{3}(f(x)-x)^{2} & ={lim}_{x\\to \\,3}(3x-10)^{3}\\cdot {lim}_{x\\to \\,3}(f(x)-x)^{2} \\\\  & =(-1)(36) \\\\  & =-36\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261140 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf8de10-d41e-55cc-bf82-e50fe6e6a886" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261142}] :answer-field/correct {:answer/id #uuid "0bf8de10-d41e-55cc-bf82-e50fe6e6a886" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261142} :answer-field/id #uuid "c8818533-22cd-5f3d-895a-867d995e5be4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261141}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a8dcfa2-7a22-559e-8b4a-993daded6d09" :question/math-academy-id "q-70044" :question/problem "Given $f(x)=3-2x$ and $g(x)=x+6,$ find  $(f+g)(5).$\n\nAnswer: {{answer}}" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(5),$ we find $f(5)$ and $g(5),$ and then add the results.\n\nFirst, we find $f(5)$ and $g(5):$\n\n$$\n\\begin{aligned}f(5) & =3-2(5)=-7 \\\\ g(5) & =5+6=11\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(5)=f(5)+g(5)=(-7)+11=4\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(3-2x)+(x+6) \\\\  & =9-x\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(5):$\n\n$$\n\\begin{aligned}(f+g)(5) & =9-5=4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261170 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c45a70b-273c-5fec-a768-40a1cf218628" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74172640-18db-516a-b069-6856cf0ba0b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{41}}" :db/id #edb/ref 17592186261172}] :answer-field/correct {:answer/id #uuid "74172640-18db-516a-b069-6856cf0ba0b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{41}}" :db/id #edb/ref 17592186261172} :answer-field/id #uuid "2a0dcdbb-3596-5b6f-8121-fdcc339515c7" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261171} {:answer-field/choices [{:answer/id #uuid "160eb8cd-fa9c-5fec-b1fd-c3ffb4c5b880" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{41}}" :db/id #edb/ref 17592186261174}] :answer-field/correct {:answer/id #uuid "160eb8cd-fa9c-5fec-b1fd-c3ffb4c5b880" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{41}}" :db/id #edb/ref 17592186261174} :answer-field/id #uuid "c1c02555-f4ee-5efe-98e3-4b6aa3885d09" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261173}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b579ce8c-aa57-57eb-9f60-cf64367e257f" :question/math-academy-id "q-70409" :question/problem "Let $n=[\\begin{aligned}5 \\\\ 4\\end{aligned}].$ Find a unit vector that is parallel to $n$ and points the same direction.\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|\\,n\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|n| & =\\sqrt{{5}^{2}+{4}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nFinally, we divide $n$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|n|} \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot n \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot [\\begin{aligned}5 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{\\sqrt{41}} \\\\ \\frac{4}{\\sqrt{41}}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261175 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c4ada3f-ec52-5933-a92d-326b5d35a8ee" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186261177}] :answer-field/correct {:answer/id #uuid "8c4ada3f-ec52-5933-a92d-326b5d35a8ee" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186261177} :answer-field/id #uuid "64f3e97d-de55-5fb7-ad5d-d89294d4847f" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261176} {:answer-field/choices [{:answer/id #uuid "e89259cc-eacd-5135-93d3-15fe21297e1c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261179}] :answer-field/correct {:answer/id #uuid "e89259cc-eacd-5135-93d3-15fe21297e1c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261179} :answer-field/id #uuid "d6f32894-5980-59f9-9518-27185a1289eb" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261178}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed8c6342-312a-5e87-b415-a663154a8416" :question/math-academy-id "q-70412" :question/problem "Let $a=[\\begin{aligned}4 \\\\ -7\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 4\\end{aligned}]$ and $c=[\\begin{aligned}4 \\\\ -6\\end{aligned}].$ Find $3a-(b+4c).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a-(b+4c) & =3\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+4\\cdot [\\begin{aligned}4 \\\\ -6\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+[\\begin{aligned}16 \\\\ -24\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-[\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261180 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddbb658-236b-51ec-8c51-94f2fd1dbbc5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261182}] :answer-field/correct {:answer/id #uuid "1ddbb658-236b-51ec-8c51-94f2fd1dbbc5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261182} :answer-field/id #uuid "1de335df-b994-51b7-92ca-da5c84a8cd11" :answer-field/key "r1c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261181} {:answer-field/choices [{:answer/id #uuid "1a06eab5-830d-579d-a65c-e49bd9fed32f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261184}] :answer-field/correct {:answer/id #uuid "1a06eab5-830d-579d-a65c-e49bd9fed32f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261184} :answer-field/id #uuid "c60283f6-0620-52ea-b3a9-32dd6ce73210" :answer-field/key "r2c1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261183}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "12cf330f-781a-5288-af56-a50437c935bb" :question/math-academy-id "q-70414" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 5\\end{aligned}]$ and $c=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Find $a+(2b-2c).$\n\nRow 1, column 1: {{r1c1}}\n\nRow 2, column 1: {{r2c1}}" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a+(2b-2c) & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+(2\\cdot [\\begin{aligned}2 \\\\ 5\\end{aligned}]-2\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+([\\begin{aligned}4 \\\\ 10\\end{aligned}]-[\\begin{aligned}2 \\\\ 4\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261274 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5837311-e37d-57ff-a9c1-422d5569df08" :knowledge-point/title "Identifying Radical Equations With No Real Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e55f859a-b44a-521e-8f69-f6fc35f05d6a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261276} {:answer/id #uuid "b1ae8032-4f08-58e6-be0b-5418814cf3ea" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261277} {:answer/id #uuid "775af3b1-5061-5125-8b7c-b29e2ad7c0f3" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261278} {:answer/id #uuid "821db7a8-8f56-556d-9121-149c04644e3b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261279} {:answer/id #uuid "038d8bbc-19ca-5980-b57c-1bfecd77321c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261280} {:answer/id #uuid "4f77c179-e69a-59bd-9aee-7e02ce2890e9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261281} {:answer/id #uuid "22358ea3-e645-529e-a108-3a8fc0a9a7c7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261282} {:answer/id #uuid "7550839f-4794-5b19-970d-ea559dd47bd0" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261283}] :answer-field/correct {:answer/id #uuid "7550839f-4794-5b19-970d-ea559dd47bd0" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261283} :answer-field/id #uuid "6ca60986-ae01-560b-84be-531cbd4f220f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261275}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ca52945b-4f7a-5b78-870a-fc1840d01e7d" :question/math-academy-id "q-70908" :question/problem "Which of the following equations have no real solution?\n\nI. - $\\sqrt{2x-3}=1$\nII. - $\\sqrt{4x+1}=-6$\nIII. - $\\sqrt{2x-1}=12$" :question/worked-solution "Remember that a square root is always positive or zero. So, a radical equation has no real solution if it states that a square root is equal to a negative number.\n\nOf the given equations, only II states that a square root is equal to a negative number. Therefore, equation II has no real solution.\n\nSo, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186261679 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91eb28b1-f951-5cc3-8a02-cf99fd93e522" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186261681}] :answer-field/correct {:answer/id #uuid "91eb28b1-f951-5cc3-8a02-cf99fd93e522" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186261681} :answer-field/id #uuid "641f80ba-c431-511c-8e84-51d38766fe3d" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261680}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d3fe2115-92b8-5f51-86a5-b888e4bd1095" :question/math-academy-id "q-78093" :question/problem "Suppose that $h(t)=90-5{t}^{2}$ represents the height of a ball thrown from the roof of a building, measured in meters from the ground level at $t$ seconds. What is the average rate of loss of height of $h(t)$ from $t=1$ to $t=4?$\n\nAnswer: {{answer}}" :question/worked-solution "Let $h(t)=90-5{t}^{2}$ be the height of the ball, in meters, after $t$ seconds. To find the average rate of change of the ball's height from $t=1$ to $t=4$, we use the average rate of change formula on the interval $[1,4]$:\n\n$$\n\\begin{aligned}\\frac{Δh}{Δt} & =\\frac{h(b)-h(a)}{b-a} \\\\  & =\\frac{h(4)-h(1)}{4-1} \\\\  & =\\frac{[90-5(4)^{2}]-[90-5(1)^{2}]}{3} \\\\  & =\\frac{10-85}{3} \\\\  & =-\\frac{75}{3} \\\\  & =-25\\end{aligned}\n$$\n\nTherefore, the average rate of loss of height of $h(t)$ is $25$ meters per second."}] [{:db/id #edb/ref 17592186261748 :knowledge-point/_questions [{:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa" :knowledge-point/title "Adding Rational Expressions With a Common Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45116868-fb17-5779-86ec-6b500e6f92f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{a+2b}{4b}" :db/id #edb/ref 17592186261750}] :answer-field/correct {:answer/id #uuid "45116868-fb17-5779-86ec-6b500e6f92f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{a+2b}{4b}" :db/id #edb/ref 17592186261750} :answer-field/id #uuid "3f50529a-19a3-52ab-b1bc-266f681889cf" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261749}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "46796fd2-e44b-52e5-81ec-b7e97f8e2d6a" :question/math-academy-id "q-79541" :question/problem "Simplify $\\frac{2a-b}{4b}-\\frac{a-3b}{4b}.$\n\nAnswer: {{answer}}" :question/worked-solution "We have a common denominator of $4b,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{2a-b}{4b}-\\frac{a-3b}{4b} & = \\\\ \\frac{2a-b-(a-3b)}{4b} & = \\\\ \\frac{2a-b-a+3b}{4b} & = \\\\ \\frac{a+2b}{4b}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261869 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae1738d1-3261-5769-ab80-0edcc76ab6f3" :knowledge-point/title "Computing the Y-Intercept of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af5acdf8-2660-557e-b016-ca2b92406387" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12" :db/id #edb/ref 17592186261871}] :answer-field/correct {:answer/id #uuid "af5acdf8-2660-557e-b016-ca2b92406387" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12" :db/id #edb/ref 17592186261871} :answer-field/id #uuid "320de538-91de-5b11-aaae-b12d0156cfe0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261870}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fb5f2917-c324-5280-bf72-56385246a1bc" :question/math-academy-id "q-83561" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/ca545b153cd04a539f30030c27a90dc4489b3a620e9a0d859bae5b531fcc7144.png)\n\nThe equation of the curve above is $y=\\frac{5}{2}{x}^{2}-3x+k.$ Find the value of $k.$\n\nAnswer: {{answer}}" :question/worked-solution "Notice that if we substitute $x=0$ into the given equation, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{5}{2}{x}^{2}-3x+k \\\\ y & =\\frac{5}{2}(0)^{2}-3(0)+k \\\\ y & =k,\\end{aligned}\n$$\n\nmeaning that the curve intercepts the $y$-axis at the point $(0,k).$ Based on the graph, we see that we must have $k=\\frac{1}{2}$ since our parabola intercepts the $y$-axis at $(0,\\frac{1}{2}).$"}] [{:db/id #edb/ref 17592186261898 :knowledge-point/_questions [{:knowledge-point/id #uuid "081e58b9-a8ba-5ad7-8e1c-8f8510a33587" :knowledge-point/title "Identifying True Statements Regarding an Event and its Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1812c78b-a55b-57c3-832c-8eaffa65f449" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261900} {:answer/id #uuid "6de1e2ae-c9eb-5c1a-af4b-7ad5418ce020" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261901} {:answer/id #uuid "dbb099e6-0299-5d14-85a1-e2f505b0f3c1" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261902} {:answer/id #uuid "9429ffb0-d529-544d-8017-1e51bef97808" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261903} {:answer/id #uuid "5ba7c15d-d3cb-59aa-9e04-f73793693b28" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261904} {:answer/id #uuid "e82f6fdf-cd6a-518c-bf93-5bcfbd58572d" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261905} {:answer/id #uuid "f53f81a0-20c4-5d62-822d-d15e0208bb72" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186261906} {:answer/id #uuid "616f6e0e-482f-510b-b573-5c356d87d0f5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261907}] :answer-field/correct {:answer/id #uuid "5ba7c15d-d3cb-59aa-9e04-f73793693b28" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261904} :answer-field/id #uuid "5749a1ac-dbc4-5b78-8fcc-ffe805a26b61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186261899}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bbd53da4-9111-5ade-a6dc-05cf5e290645" :question/math-academy-id "q-84489" :question/problem "Two fair $6$-sided dice are rolled. Define $A$ to be the event \"the sum of outcomes is equal to $5.$\" Which of the following statements are true regarding this event?\n\nI. - $P(A)=0.15$ to $2$ decimal places\nII. - ${A}^{'}$ is the event \"the sum of the outcomes is less than $5$\"\nIII. - $P({A}^{'})=0.89$ to $2$ decimal places" :question/worked-solution "Let's inspect each statement in turn.\n\n- Statement I is false. There are $36$ possible outcomes and $4$ of these have the sum of the outcomes equal to $5,$ namely $(1,4),(4,1),(2,3),(3,2).$ Therefore,\n\n$$\nP(A)=\\frac{4}{36}=0.11\n$$\n\nto $2$ decimal places.\n\n- Statement II is false. The complement of $A$ is the event ${A}^{'},$ \"the sum of the outcomes is not equal to $5.$\n\n- Statement III is true. Since we know that $P(A)=0.11$ to $2$ decimal places, we can calculate $P({A}^{'})$ using the formula\n\n$$\n\\begin{aligned}P(A)+P({A}^{'}) & =1 \\\\ P({A}^{'}) & =1-P(A) \\\\  & =1-0.11 \\\\  & =0.89.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186261911 :knowledge-point/_questions [{:knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1176aca-177b-56ab-8497-2f78a7b72522" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186261913}] :answer-field/correct {:answer/id #uuid "f1176aca-177b-56ab-8497-2f78a7b72522" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186261913} :answer-field/id #uuid "dc95bd45-30c4-5602-8cc2-a03cbae23f68" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261912}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aa9617ac-766d-5c56-b9e5-48a4a947fb5a" :question/math-academy-id "q-85486" :question/problem "Find the value of $\\operatorname{tan}({90}^{∘}).$\n\nAnswer: {{answer}}\n\nIf the value is undefined, enter \"Undefined\"." :question/worked-solution "The angle ${90}^{∘}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/edad8c833f65c54453fe40a326cbf9394c263213934447872b530a8e4fb86de1.png)\n\nFrom the unit circle, we see that the angle ${90}^{∘}$ corresponds to the point $(0,1).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}({90}^{∘})=0.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}({90}^{∘})=1.$\n\nTherefore, using the fact that $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{tan}({90}^{∘})=\\frac{\\operatorname{sin}({90}^{∘})}{\\operatorname{cos}({90}^{∘})}=\\frac{1}{0}.\n$$\n\nHowever, division by zero is undefined. Therefore, $\\operatorname{tan}({90}^{∘})$ is undefined."}] [{:db/id #edb/ref 17592186261983 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a" :knowledge-point/title "Finding the End-Behavior of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "686dcbf3-9915-5d87-a73c-2fe61d91472e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261985}] :answer-field/correct {:answer/id #uuid "686dcbf3-9915-5d87-a73c-2fe61d91472e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186261985} :answer-field/id #uuid "5bb8367a-3808-5ada-bad9-70a6c5853a45" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261984}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6fe18260-df06-55c2-bd92-ef2821897be4" :question/math-academy-id "q-92983" :question/problem "Find the equation of the horizontal asymptote of the function $f(x)={3}^{x}-1.$\n\n$y =$: {{y}}" :question/worked-solution "Let's plot the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d03c7a1ada2f422df96b8479894197e5d388f73e1f7980155a009b6502902cbb.png)\n\nSince the function approaches the line $y=-1$ as $x\\to -\\infty ,$ we conclude that the equation of the horizontal asymptote is $y=-1.$"}] [{:db/id #edb/ref 17592186261989 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c2518d5-0fde-5dfc-aa07-f1bdd3c1585a" :knowledge-point/title "Finding the End-Behavior of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f22c16fc-f6c1-5051-834f-8ea7f4851607" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261991}] :answer-field/correct {:answer/id #uuid "f22c16fc-f6c1-5051-834f-8ea7f4851607" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261991} :answer-field/id #uuid "692c0975-83dd-5e12-b8d5-3f74e2e8e1e1" :answer-field/key "y" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261990}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8e2b0b19-242a-586c-83d9-b9a00d75b930" :question/math-academy-id "q-92990" :question/problem "Find the equation of the horizontal asymptote of the function $f(x)=\\frac{1}{3}({2}^{2x+1})+3.$\n\n$y =$: {{y}}" :question/worked-solution "Let's plot the graph of $y=f(x):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/7df3ad89847be8197653ece86935a3e310d66a7632143e5e5218bf489f1c23d4.png)\n\nSince the function approaches the line $y=3$ as $x\\to -\\infty ,$ we conclude that the equation of the horizontal asymptote is $y=3.$"}] [{:db/id #edb/ref 17592186262112 :knowledge-point/_questions [{:knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6310d092-8863-5a48-bb29-8e40b3e3e2f2" :answer/type {:db/ident :answer.type/math} :answer/value "1.262" :db/id #edb/ref 17592186262114}] :answer-field/correct {:answer/id #uuid "6310d092-8863-5a48-bb29-8e40b3e3e2f2" :answer/type {:db/ident :answer.type/math} :answer/value "1.262" :db/id #edb/ref 17592186262114} :answer-field/id #uuid "546450ba-f0fc-5ac8-a380-753b82559f9e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262113}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4bb0c190-0bc7-5c24-bdb9-2ae5232df4b8" :question/math-academy-id "q-98" :question/problem "Use a calculator to evaluate ${log}_{12}(23)$ rounded to $3$ decimal places.\n\nAnswer: {{answer}}" :question/worked-solution "Let's calculate ${log}_{12}(23)$ by changing the base $12$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=12,$ $X=23,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{12}(23) & =\\frac{{log}_{10}(23)}{{log}_{10}(12)} \\\\  & =\\frac{\\operatorname{log}(23)}{\\operatorname{log}(12)} \\\\  & \\approx \\frac{1.361\\,728}{1.079\\,181} \\\\  & \\approx 1.262\\end{aligned}\n$$"}]}
