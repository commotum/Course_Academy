4810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335646" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335646" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" nil "attribute" "question/problem" "value" "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+2y(t) \\\\ {y}^{′}(t)=3x(t)-y(t)\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of linear differential equations above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" nil "attribute" "question/worked-solution" "value" "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n{\\begin{aligned}x+2y=0 \\\\ 3x-y=0\\end{aligned}\n$$\n\nMultiplying the first equation by $-3$ and adding the result to the second equation, we obtain\n\n$$\n-7y=0\\,⇒\\,y=0.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\nx+2\\cdot 0=0\\,⇒\\,x=0.\n$$\n\nTherefore, the equilibrium point is\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/activity-metadata.json" "file_sha256" "478e0ffeeb616cde990750ee6d12db861d4e636d27e873f81d582bbc202ae000" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ 3\\end{aligned}]$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335639" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}1 \\\\ 3\\end{aligned}]$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335470" "field" nil "attribute" "question/problem" "value" "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+2y(t)-1 \\\\ {y}^{′}(t)=2x(t)-2y(t)\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of linear differential equations above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335470" "field" nil "attribute" "question/worked-solution" "value" "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n{\\begin{aligned}x+2y-1=0 \\\\ 2x-2y=0\\end{aligned}\n$$\n\nAdding both equations, we obtain\n\n$$\n3x-1=0\\,⇒\\,x=\\frac{1}{3}.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\frac{1}{3}+2y-1=0\\,⇒\\,y=\\frac{1}{3}.\n$$\n\nTherefore, the equilibrium point is\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{1}{3}\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335470" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/activity-metadata.json" "file_sha256" "478e0ffeeb616cde990750ee6d12db861d4e636d27e873f81d582bbc202ae000" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335470" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/verification.json"} {"question" "q-335470" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$[\\begin{aligned}-\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}]$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/state.json" "file_sha256" "746d5e046d23d4ad06c4544810f7e0f65c91c067618bc9f939723cad8012347f" "basis" 2345 "verification" "/home/jake/Deve