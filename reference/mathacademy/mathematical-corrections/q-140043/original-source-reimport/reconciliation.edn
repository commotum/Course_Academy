demy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-139985" "field" nil "attribute" "question/worked-solution" "value" "We are given the system\n\n$$\n{\\begin{aligned}2x+(-5)y+7z=14 \\\\ -5x+6y+2z=9 \\\\ 3x+(-2)y+4z=1.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 2 \\\\ 3 & -2 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-139985" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/activity-metadata.json" "file_sha256" "a1a6979836a56791792e28734dc7b6d21137040e0b92775cd68600d8dd8033e4" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-139985" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/