ademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-140043" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "k=9"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-73694" "field" nil "attribute" "question/problem" "value" "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+3y+z=3 \\\\ x-z=k \\\\ x-2y+2z=1\\end{aligned}\n$$\n\nGiven that $z=2$ and that the determinant of the coefficient matrix is equal to $-15,$ find the value of $k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-73694" "field" nil "attribute" "question/worked-solution" "value" "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 1 \\\\ 1 & 0 & -1 \\\\ 1 & -2 & 2\\end{aligned}|=-15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 3 & 3 \\\\ 1 & 0 & k \\\\ 1 & -2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}0 & k \\\\ -2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & k \\\\ 1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}| \\\\  & =2(0+2k)-3(1-k)+3(-2-0) \\\\  & =4k-3+3k-6 \\\\  & =7k-9.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{7k-9}{-15}.\n$$\n\nFrom the problem statement, we know that $z=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{7k-9}{-15} & =2 \\\\ 7k-9 & =-30 \\\\ 7k & =-21 \\\\ k & =-3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-73694" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/activity-metadata.json" "file_sha256" "a1a6979836a56791792e28734dc7b6d21137040e0b92775cd68600d8dd8033e4" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-73694" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/state.json" "file_sha256" "90e660673bc166676e860f53e1bf78c96bb1957df35ab66fba72bf7ee76dd251" "basis" 1914 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059591/edb-import/verification.json"} {"question" "q-73694" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "k=-2"] "category" "ma_capture" "fil