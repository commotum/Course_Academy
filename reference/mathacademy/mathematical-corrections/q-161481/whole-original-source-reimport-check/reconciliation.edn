48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" nil "attribute" "question/problem" "value" "Consider the vector field $F(x,y,z)=⟨x,\\,y-z,\\,x+y⟩$ and the surface $S$ defined by $z=x-2y$ for $0\\le x\\le 1$ and $-1\\le y\\le 1.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{0}^{1}{\\int }_{-1}^{1}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" nil "attribute" "question/worked-solution" "value" "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,u-2v⟩\n$$\n\nover the domain \n\n$$\nD={(u,v)\\,:\\,0\\le u\\le 1,\\,-1\\le v\\le 1}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(u-2v)⟩ \\\\  & =⟨1,\\,0,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(u-2v)⟩ \\\\  & =⟨0,\\,1,\\,-2⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 0 & 1 & -2\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 0 & -2\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-1,\\,2,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x,\\,y-z,\\,x+y⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=u-2v} \\\\  & =⟨u,\\,v-(u-2v),\\,u+v⟩ \\\\  & =⟨u,\\,3v-u,\\,u+v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u,\\,3v-u,\\,u+v⟩\\cdot ⟨-1,\\,2,\\,1⟩ \\\\  & =u\\cdot (-1)+(3v-u)\\cdot 2+(u+v)\\cdot 1 \\\\  & =-u+6v-2u+u+v \\\\  & =-2u+7v.\\end{aligned}\n$$\n\n \n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨x,\\,y-z,\\,x+y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-2u+7v)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}(-2u+7v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/activity-metadata.json" "file_sha256" "fcc6e5e5dace3db1f93bc869d01232d35269ed72008a5716d4c43f6c74c60799" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2u+7v"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2u+v"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2u+4v"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4u+v"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4v-u"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161441" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2u+7v"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" nil "attribute" "question/problem" "value" "For a surface $S$ given by $y=-{x}^{2}z$ for $(x,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\,xz+Q+\\,{x}^{2})\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?\n\n*Hint: The orientation of $S$ should be chosen such that the unit normal vector has a positive  $j$-component.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" nil "attribute" "question/worked-solution" "value" "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $y=-{x}^{2}z,$ it can be parameterized as\n\n$$\nr(x,z)=⟨x,\\,-{x}^{2}z,z⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨1,\\,-2xz,\\,0⟩ \\\\ {r}_{z}^{′} & =⟨0,\\,-{x}^{2},\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{z}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & -2xz & 0 \\\\ 0 & -{x}^{2} & 1\\end{aligned}|=⟨-2xz,\\,-1,\\,-{x}^{2}⟩.\\end{aligned}\n$$\n\nHowever, notice that the $j$-component is negative. Therefore, we select the normal vector that points in the *opposite* direction:\n\n$$\n{r}_{z}^{′}\\times {r}_{x}^{′}=-{r}_{x}^{′}\\times {r}_{z}^{′}=⟨2xz,\\,1,\\,{x}^{2}⟩\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,z))\\cdot ({r}_{x}^{′}\\times {r}_{z}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,R\\,⟩\\cdot ⟨2xz,\\,1,\\,{x}^{2}⟩\\,\\text{d}A \\\\  & ={∬}_{D}(2P\\,xz+Q+R\\,{x}^{2})\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/activity-metadata.json" "file_sha256" "fcc6e5e5dace3db1f93bc869d01232d35269ed72008a5716d4c43f6c74c60799" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$-2P$ and $2R$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161453" "field" "selection" "attribute" "answer/value" "v