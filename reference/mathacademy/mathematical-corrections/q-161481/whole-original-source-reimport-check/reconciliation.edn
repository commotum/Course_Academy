ed}i & j & k \\\\ 1 & 0 & \\frac{∂g}{∂x} \\\\ 0 & 1 & \\frac{∂g}{∂y}\\end{aligned}|=⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{x}^{′}\\times {r}_{y}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}(-P\\frac{∂g}{∂x}+(-Q\\,)\\frac{∂g}{∂y}+R)\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161189" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/activity-metadata.json" "file_sha256" "fcc6e5e5dace3db1f93bc869d01232d35269ed72008a5716d4c43f6c74c60799" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161189" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/state.json" "file_sha256" "b65937d72afce5260534d53d0c48a0a2dadbce7b5a63ad0dc73a4e54242f6b9c" "basis" 2263 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067725/edb-import/verification.json"} {"question" "q-161189" "field" "selection" "attribute" "answer/value" "value" [:answe