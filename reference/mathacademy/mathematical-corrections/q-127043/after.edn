#{[{:db/id #edb/ref 17592186314759 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d313486-e349-59a2-b8d5-02e13fbf6d36" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} \\\\ -4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314761} {:answer/id #uuid "6eab4365-8239-52a0-a5f3-dd30891fced6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{3} \\\\ 4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186314762} {:answer/id #uuid "e97f4fd1-8bdf-5b77-8a43-223fd5730ee5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} \\\\ 4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314763} {:answer/id #uuid "1e232130-0aa4-523d-ad8b-da996a44179d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} \\\\ 4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186314764} {:answer/id #uuid "a27c9435-0f0a-5c61-a3d5-13481412c664" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{3} \\\\ -4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314765}] :answer-field/correct {:answer/id #uuid "9d313486-e349-59a2-b8d5-02e13fbf6d36" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} \\\\ -4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314761} :answer-field/id #uuid "b8e2521f-de41-5643-ba87-56daab4b42c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314760}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "11bd8602-a2be-5ae4-8ba8-6a2ffe62757c" :question/math-academy-id "q-127043" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=\\frac{1}{3}t-2 \\\\ y=5-4t \\\\ z=2t+\\frac{1}{7}\\end{aligned}\n$$\n\nFind a vector parallel to the line that points in the direction of increasing $t$." :question/worked-solution "Write the position vector as\n\n$$\n\\mathbf r(t)=\\begin{pmatrix}-2\\\\5\\\\\\frac17\\end{pmatrix}\n+t\\begin{pmatrix}\\frac13\\\\-4\\\\2\\end{pmatrix}.\n$$\n\nFor any positive increment $h$,\n\n$$\n\\mathbf r(t+h)-\\mathbf r(t)=h\\begin{pmatrix}\\frac13\\\\-4\\\\2\\end{pmatrix}.\n$$\n\nTherefore, $\\left(\\frac13,-4,2\\right)$ is parallel to the line and points in the direction of increasing $t$. Its negative $\\left(-\\frac13,4,-2\\right)$ is also parallel, but points in the direction of decreasing $t$ and does not satisfy the requested orientation."}]}
