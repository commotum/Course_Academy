\nTherefore, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/3c8cf015e3b1944ce18fa83f77a17912afc696e485dc6557760a1d78bfd81e3c.png)\n\nSo,\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/1bc658f161ad3523eaf0a263af0a9b86cb596483fe0f20f6088af1f366ff205f.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/example-26133.json" "file_sha256" "fda9fa9b901c74c94c13373e4b2d1f52d652390fde32c7c2b9557e55c043961d" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"}] "sources" [] "usage" {"q-161739" [] "e-8191" [] "q-161677" [] "q-161716" [] "e-8189" [] "q-161653" [] "q-161706" [] "e-8190" [] "q-161657" [] "q-161656" [] "e-26133" [] "q-161695" [] "q-161742" [] "q-40327" [] "q-161680" [] "q-161699" [] "q-161685" [] "q-40353" [] "q-161715" [] "q-161684" [] "q-161659" [] "q-161681" [] "q-161705" [] "q-161719" []} "basis" 2097 "retractions" [] "immutable_answers" [17592186128001 17592186128002 17592186128003 17592186128004 17592186128005 17592186128007 17592186128008 17592186128009 17592186128010 17592186128011 17592186347595 17592186347596 17592186347597 17592186347598 17592186347599 17592186347602 17592186347603 17592186347604 17592186347605 17592186347606 17592186347609 17592186347610 17592186347611 17592186347612 17592186347613 17592186347616 17592186347617 17592186347618 17592186347619 17592186347620 17592186347623 17592186347624 17592186347625 17592186347626 17592186347627 17592186347630 17592186347631 17592186347632 17592186347633 17592186347634 17592186347637 17592186347638 17592186347639 17592186347640 17592186347641 17592186347644 17592186347645 17592186347646 17592186347647 17592186347648 17592186347651 17592186347652 17592186