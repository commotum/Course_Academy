e-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161699" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" nil "attribute" "question/problem" "value" "Find the volume of the solid region enclosed by the $xz$-plane and the surface $y=5-3{z}^{2},$ and the planes $x=0,$ $x=1,$ $z=-1,$ $z=0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" nil "attribute" "question/worked-solution" "value" "Notice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,-1\\le z\\le 0,\\,\\,0\\le y\\le 5-3{z}^{2}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}{\\int }_{0}^{5-3{z}^{2}}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}[y]_{y=0}^{y=5-3{z}^{2}}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}5-3{z}^{2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}[5z-{z}^{3}]_{z=-1}^{z=0}\\,dx \\\\  & ={\\int }_{0}^{1}0-(5(-1)-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{1}5-1\\,dx \\\\  & =4{\\int }_{0}^{1}dx \\\\  & =4[x]_{x=0}^{x=1} \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/activity-metadata.json" "file_sha256" "44954716125f0fe9cdf4719fc91e1d6cbf920b220a1bde53d11db47b973b90dc" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161685" "field" "selection" "attribute" "answer/value" "val