type/math "\\frac{5}{4}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161742" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{6}{5}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-161742" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/7456b549ac815ab491945d9b3f2873d65b091636f7b8282f296a435954ba503d.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/702e54d6f4b951eec56a62d340f81df1f618622114cfef6045460a6d184bffbc.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3-x-z},\n$$\n\nwhere\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/af505b53a12bbe74da4d3885df59c4c00cc7bfaf71df9f7167caa9dbf67cfb73.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1,\\,\\,0\\le y\\le 3-x-z}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{3-x-z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[y]_{y=0}^{y=3-x-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(3-x-z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}3-x-z\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{[(3-x)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=1}\\,dx \\\\  & ={\\int }_{0}^{1}((3-x)(1)-\\frac{{1}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{5}{2}-x\\,dx \\\\  & ={[\\frac{5}{2}x-\\frac{{x}^{2}}{2}]}_{x=0}^{x=1} \\\\  & =(\\frac{5}{2}(1)-\\frac{{1}^{2}}{2})-0 \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/activity-metadata.json" "file_sha256" "44954716125f0fe9cdf4719fc91e1d6cbf920b220a1bde53d11db47b973b90dc" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha256" "217ab6b089dab9a6980216e821097024487dc65669dd1810309bd108144eba71" "basis" 2094 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/edb-import/verification.json"} {"question" "q-40353" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/state.json" "file_sha2