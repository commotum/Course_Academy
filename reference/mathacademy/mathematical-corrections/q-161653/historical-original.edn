#{[{:db/id #edb/ref 17592186347593 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e" :knowledge-point/title "Finding the Volume of a Solid Given in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e59ffa58-74f1-562a-a741-d4c6351b9270" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186347595} {:answer/id #uuid "ebeb9cd6-3829-5945-8ab6-7f8f8cf7d489" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186347596} {:answer/id #uuid "2b3d4c71-66a0-5a85-ac89-57300619ce15" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186347597} {:answer/id #uuid "6bb1709d-cb10-583f-9d82-bf25a8b48b20" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186347598} {:answer/id #uuid "f9433e48-13ab-58b9-a220-8fc15935944c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186347599}] :answer-field/correct {:answer/id #uuid "2b3d4c71-66a0-5a85-ac89-57300619ce15" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186347597} :answer-field/id #uuid "635a1867-36b4-5b88-bb71-5e9e1ee7e72a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347594}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "72d6f8d0-1f35-5a19-b558-bcfd9f34f6df" :question/math-academy-id "q-161653" :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 4,\\,2\\le z\\le 3y+x}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}{\\int }_{2}^{3y+x}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}[z]_{z=2}^{z=3y+x}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}3y+x-2\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[\\frac{3}{2}{y}^{2}+xy-2y]}_{y=1}^{y=4}\\,dx \\\\  & ={\\int }_{0}^{2}\\,[(24+4x-8)-(\\frac{3}{2}+x-2)]\\,dx \\\\  & =4{\\int }_{0}^{2}3x+\\frac{33}{2}\\,dx \\\\  & ={[\\frac{3{x}^{2}}{2}+\\frac{33}{2}x]}_{x=0}^{x=2} \\\\  & =\\frac{3(2)^{2}}{2}+\\frac{33}{2}(2)-0 \\\\  & =39.\\end{aligned}\n$$"}]}
