2v) \\\\  & =4+4uv.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}4+4uv & >0 \\\\ 4uv & >-4 \\\\ uv & >-1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v>-\\frac{1}{u}$ for $u>0$ and $v<-\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=-\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,1)$ and $(-1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n  \n\n![](images/c5/c501e7e341af57e86f18d73871314800d453f79572e16ccf2477335352d4dcdc.png)" "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4u+{v}^{2} \\\\ v-{u}^{2}\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}4 & 2v \\\\ -2u & 1\\end{vmatrix} \\\\  & =4\\cdot 1-(-2u)\\cdot (2v) \\\\  & =4+4uv.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}4+4uv & >0 \\\\ 4uv & >-4 \\\\ uv & >-1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v>-\\frac{1}{u}$ for $u>0$ and $v<-\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=-\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,1)$ and $(-1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n  \n\n![](images/c5/c501e7e341af57e86f18d73871314800d453f79572e16ccf2477335352d4dcdc.png)"] [:db/cas 17592186281360 :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{uv} \\\\ {u}^{2}+v\\end{bmatrix},\n$$\n\nis (locally) orientation-preserving?" "Which of the following shows the region in the $uv$-plane where the transformation $\\mathbf{T},$ given by \n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{uv} \\\\ {u}^{2}+v\\end{bmatrix},\n$$\n\nis (locally) orientation-preserving?"] [:db/cas 17592186281360 :question/worked-solution "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{uv} \\\\ {u}^{2}+v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v{e}^{uv} & u{e}^{uv} \\\\ 2u & 1\\end{vmatrix} \\\\  & =v{e}^{uv}\\cdot (1)-(2u)\\cdot u{e}^{uv} \\\\  & ={e}^{uv}(v-2{u}^{2}).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{e}^{uv}(v-2{u}^{2}) & >0 \\\\ v-2{u}^{2} & >0 \\\\ v & >2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(0,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/61/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png)" "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}{e}^{uv} \\\\ {u}^{2}+v\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =\\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\  & =\\begin{vmatrix}v{e}^{uv} & u{e}^{uv} \\\\ 2u & 1\\end{vmatrix} \\\\  & =v{e}^{uv}\\cdot (1)-(2u)\\cdot u{e}^{uv} \\\\  & ={e}^{uv}(v-2{u}^{2}).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{e}^{uv}(v-2{u}^{2}) & >0 \\\\ v-2{u}^{2} & >0 \\\\ v & >2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(0,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/61/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png)"] [:db/cas 17592186281366 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{1}{u}-v \\\\ {u}^{2}v\\end{bmatrix}?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf{T},$ given by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{1}{u}-v \\\\ {u}^{2}v\\end{bmatrix}?\n$$"] [:db/cas 17592186281367 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(4,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\sqrt{u}+{v}^{2} \\\\ uv\\end{bmatrix}?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(4,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf{T},$ given by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\sqrt{u}+{v}^{2} \\\\ uv\\end{bmatrix}?\n$$"] [:db/cas 17592186281368 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{cos}⁡u-{v}^{2} \\\\ u+v\\end{bmatrix}?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf{T},$ given by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\operatorname{cos}u-{v}^{2} \\\\ u+v\\end{bmatrix}?\n$$"] [:db/cas 17592186281371 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{{u}^{2}}{v} \\\\ uv\\end{bmatrix}?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf{T},$ given by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\frac{{u}^{2}}{v} \\\\ uv\\end{bmatrix}?\n$$"] [:db/cas 17592186281372 :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\sqrt{uv} \\\\ u{v}^{2}\\end{bmatrix}?\n$$" "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf{T},$ given by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}\\sqrt{uv} \\\\ u{v}^{2}\\end{bmatrix}?\n$$"] [:db/cas 17592186281416 :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=y\\,i+x\\,j$ along the closed curve $C$ given by $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+2\\operatorname{sin}⁡t\\,k$ for $t\\in [0,2\\pi ).$" "Calculate the circulation $Γ$ of the vector field $\\mathbf{F}(x,y,z)=y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{j}$ along the closed curve $C$ given by $\\mathbf{r}(t)=\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}+2\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k}$ for $t\\in [0,2\\pi ).$"] [:db/cas 17592186281416 :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=2\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,j \\\\  & =\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\operatorname{cos}⁡t\\,k) \\\\  & =\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+0\\cdot 2\\operatorname{cos}⁡t \\\\  & ={cos}^{2}⁡t-{sin}^{2}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({cos}^{2}⁡t-{sin}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2t)\\,\\text{d}t \\\\  & =[\\frac{\\operatorname{sin}⁡(2t)}{2}]_{0}^{2\\pi } \\\\  & =0\\end{aligned}\n$$" "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=2\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{j} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+2\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{cos}t\\cdot \\operatorname{cos}t+\\operatorname{sin}t\\cdot (-\\operatorname{sin}t)+0\\cdot 2\\operatorname{cos}t \\\\  & ={\\operatorname{cos}}^{2}t-{\\operatorname{sin}}^{2}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({\\operatorname{cos}}^{2}t-{\\operatorname{sin}}^{2}t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}(2t)\\hspace{0.278em}\\text{d}t \\\\  & =[\\frac{\\operatorname{sin}(2t)}{2}]_{0}^{2\\pi } \\\\  & =0\\end{aligned}\n$$"] [:db/cas 17592186281421 :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=y\\,i-x\\,j+z\\,k$ along the closed curve $C$ given by $r(t)=\\operatorname{sin}⁡(t)\\,i+\\operatorname{cos}⁡(t)\\,j+{t}^{2}\\,k$ for $t\\in [-\\pi ,\\pi ).$" "Calculate the circulation $Γ$ of the vector field $\\mathbf{F}(x,y,z)=y\\hspace{0.167em}\\mathbf{i}-x\\hspace{0.167em}\\mathbf{j}+z\\hspace{0.167em}\\mathbf{k}$ along the closed curve $C$ given by $\\mathbf{r}(t)=\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-\\pi ,\\pi ).$"] [:db/cas 17592186281421 :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡(t),\\,y=\\operatorname{cos}⁡(t),\\,z={t}^{2}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i-x\\,j+z\\,k \\\\  & =\\operatorname{cos}⁡(t)\\,i-\\operatorname{sin}⁡(t)\\,j+{t}^{2}\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(t))\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =\\operatorname{cos}⁡(t)\\,i-\\operatorname{sin}⁡(t)\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{cos}⁡(t)\\,i-\\operatorname{sin}⁡(t)\\,j+{t}^{2}\\,k)\\cdot (\\operatorname{cos}⁡(t)\\,i-\\operatorname{sin}⁡(t)\\,j+2t\\,k) \\\\  & =\\operatorname{cos}⁡(t)\\cdot \\operatorname{cos}⁡(t)+(-\\operatorname{sin}⁡(t))\\cdot (-\\operatorname{sin}⁡(t))+{t}^{2}\\cdot 2t \\\\  & ={cos}^{2}⁡(\\pi t)+{sin}^{2}⁡(t)+2{t}^{3} \\\\  & =1+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{-\\pi }^{\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(1+2{t}^{3})\\,\\text{d}t \\\\  & ={[t+\\frac{{t}^{4}}{2}]}_{-\\pi }^{\\pi } \\\\  & =((\\pi -(-\\pi ))+\\frac{{\\pi }^{4}-(-\\pi )^{4}}{2}) \\\\  & =2\\pi \\end{aligned}\n$$" "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡(t),\\,y=\\operatorname{cos}⁡(t),\\,z={t}^{2}.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}-x\\hspace{0.167em}\\mathbf{j}+z\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+{t}^{2}\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}(t)\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(t)\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{cos}(t)\\cdot \\operatorname{cos}(t)+(-\\operatorname{sin}(t))\\cdot (-\\operatorname{sin}(t))+{t}^{2}\\cdot 2t \\\\  & ={\\operatorname{cos}}^{2}(\\pi t)+{\\operatorname{sin}}^{2}(t)+2{t}^{3} \\\\  & =1+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-\\pi }^{\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(1+2{t}^{3})\\hspace{0.278em}\\text{d}t \\\\  & ={[t+\\frac{{t}^{4}}{2}]}_{-\\pi }^{\\pi } \\\\  & =((\\pi -(-\\pi ))+\\frac{{\\pi }^{4}-(-\\pi )^{4}}{2}) \\\\  & =2\\pi \\end{aligned}\n$$"] [:db/cas 17592186281422 :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=(x+y)\\,i-z\\,k$ along the closed curve $C$ given by $r(t)=(1-{t}^{2})\\,i+{t}^{2}\\,j+\\operatorname{sin}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$" "Calculate the circulation $Γ$ of the vector field $\\mathbf{F}(x,y,z)=(x+y)\\hspace{0.167em}\\mathbf{i}-z\\hspace{0.167em}\\mathbf{k}$ along the closed curve $C$ given by $\\mathbf{r}(t)=(1-{t}^{2})\\hspace{0.167em}\\mathbf{i}+{t}^{2}\\hspace{0.167em}\\mathbf{j}+\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,1).$"] [:db/cas 17592186281422 :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=1-{t}^{2},\\,y={t}^{2},\\,z=\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =(x+y)\\,i-z\\,k \\\\  & =(1-{t}^{2}+{t}^{2})\\,i-\\operatorname{sin}⁡(\\pi t)\\,k \\\\  & =i-\\operatorname{sin}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,k \\\\  & =-2t\\,i+2t\\,j+\\pi \\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(i-\\operatorname{sin}⁡(\\pi t)\\,k)\\cdot (-2t\\,i+2t\\,j+\\pi \\operatorname{cos}⁡(\\pi t)\\,k) \\\\  & =1\\cdot (-2t)+0\\cdot 2t+\\operatorname{sin}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =-2t+\\frac{\\pi }{2}\\operatorname{sin}⁡(2\\pi t).\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2t+\\frac{\\pi }{2}\\operatorname{sin}⁡(2\\pi t))\\,\\text{d}t \\\\  & ={[-{t}^{2}-\\frac{\\operatorname{cos}⁡(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =(-1-\\frac{1}{4})-(-1-\\frac{1}{4}) \\\\  & =0\\end{aligned}\n$$" "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=1-{t}^{2},\\,y={t}^{2},\\,z=\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =(x+y)\\hspace{0.167em}\\mathbf{i}-z\\hspace{0.167em}\\mathbf{k} \\\\  & =(1-{t}^{2}+{t}^{2})\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-2t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\mathbf{i}-\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k})\\cdot (-2t\\hspace{0.167em}\\mathbf{i}+2t\\hspace{0.167em}\\mathbf{j}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =1\\cdot (-2t)+0\\cdot 2t+\\operatorname{sin}(\\pi t)\\cdot \\pi \\operatorname{cos}(\\pi t) \\\\  & =-2t+\\frac{\\pi }{2}\\operatorname{sin}(2\\pi t).\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2t+\\frac{\\pi }{2}\\operatorname{sin}(2\\pi t))\\hspace{0.278em}\\text{d}t \\\\  & ={[-{t}^{2}-\\frac{\\operatorname{cos}(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =(-1-\\frac{1}{4})-(-1-\\frac{1}{4}) \\\\  & =0\\end{aligned}\n$$"] [:db/cas 17592186281424 :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=-z\\,j+y\\,k$ along the closed curve $C$ given by $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+\\operatorname{sin}⁡t\\,k$ for $t\\in [0,2\\pi ).$" "Calculate the circulation $Γ$ of the vector field $\\mathbf{F}(x,y,z)=-z\\hspace{0.167em}\\mathbf{j}+y\\hspace{0.167em}\\mathbf{k}$ along the closed curve $C$ given by $\\mathbf{r}(t)=\\operatorname{sin}t\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{sin}t\\hspace{0.167em}\\mathbf{k}$ for $t\\in [0,2\\pi ).$"] [:db/cas 17592186281424 :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =-z\\,j+y\\,k \\\\  & =-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k) \\\\  & =0\\cdot \\operatorname{cos}⁡t+(-\\operatorname{sin}⁡t)\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & ={sin}^{2}⁡t+{cos}^{2}⁡t. \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }1\\,\\text{d}t \\\\  & =[t]_{0}^{2\\pi } \\\\  & =2\\pi \\end{aligned}\n$$" "The circulation $Γ$ measures the total work done by a force $\\mathbf{F}$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\n\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r}={\\int }_{a}^{b}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{sin}⁡t,\\,y=\\operatorname{cos}⁡t,\\,z=\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =-z\\hspace{0.167em}\\mathbf{j}+y\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}t)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}t)\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k})\\cdot (\\operatorname{cos}t\\hspace{0.167em}\\mathbf{i}-\\operatorname{sin}t\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}t\\hspace{0.167em}\\mathbf{k}) \\\\  & =0\\cdot \\operatorname{cos}t+(-\\operatorname{sin}t)\\cdot (-\\operatorname{sin}t)+\\operatorname{cos}t\\cdot \\operatorname{cos}t \\\\  & ={\\operatorname{sin}}^{2}t+{\\operatorname{cos}}^{2}t. \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\mathrm{Γ}={∮}_{C}\\mathbf{F}\\cdot \\text{d}\\mathbf{r} & ={\\int }_{0}^{2\\pi }\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }1\\hspace{0.278em}\\text{d}t \\\\  & =[t]_{0}^{2\\pi } \\\\  & =2\\pi \\end{aligned}\n$$"] [:db/cas 17592186281436 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=(2{t}^{3}-2t)\\,i+(3{t}^{2}+3t)\\,j+({t}^{3}-t)\\,k$ for $t\\in [-1,0).$\nGiven that $F(x,y,z)=z\\,i+y\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $\\mathbf{r}(t)=(2{t}^{3}-2t)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{j}+({t}^{3}-t)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,0).$\nGiven that $\\mathbf{F}(x,y,z)=z\\hspace{0.167em}\\mathbf{i}+y\\hspace{0.167em}\\mathbf{k},$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$"] [:db/cas 17592186281436 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2{t}^{3}-2t,\\,y=3{t}^{2}+3t,\\,z={t}^{3}-t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =z\\,i+x\\,k \\\\  & =({t}^{3}-t)\\,i+(3{t}^{2}+3t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+3t)\\,j-\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\,k \\\\  & =(6{t}^{2}-2)\\,i+(6t+3)\\,j+(3{t}^{2}-1)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{3}-t)\\,i+(3{t}^{2}+3t)\\,k)\\cdot ((6{t}^{2}-2)\\,i+(6t+3)\\,j+(3{t}^{2}-1)\\,k) \\\\  & =({t}^{3}-t)\\cdot (6{t}^{2}-2)+0\\cdot (6t+3)+(3{t}^{2}+3t)\\cdot (3{t}^{2}-1) \\\\  & =6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{0}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}(6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t)\\,\\text{d}t \\\\  & ={[{t}^{6}+\\frac{9{t}^{5}}{5}+\\frac{{t}^{4}}{4}-{t}^{3}-\\frac{{t}^{2}}{2}]}_{-1}^{0} \\\\  & =0-(1-\\frac{9}{5}+\\frac{1}{4}+1-\\frac{1}{2}) \\\\  & =\\frac{1}{20}\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2{t}^{3}-2t,\\,y=3{t}^{2}+3t,\\,z={t}^{3}-t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =z\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-2t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{j}-\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\hspace{0.167em}\\mathbf{k} \\\\  & =(6{t}^{2}-2)\\hspace{0.167em}\\mathbf{i}+(6t+3)\\hspace{0.167em}\\mathbf{j}+(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+3t)\\hspace{0.167em}\\mathbf{k})\\cdot ((6{t}^{2}-2)\\hspace{0.167em}\\mathbf{i}+(6t+3)\\hspace{0.167em}\\mathbf{j}+(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}) \\\\  & =({t}^{3}-t)\\cdot (6{t}^{2}-2)+0\\cdot (6t+3)+(3{t}^{2}+3t)\\cdot (3{t}^{2}-1) \\\\  & =6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{0}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{0}(6{t}^{5}+9{t}^{4}+{t}^{3}-3{t}^{2}-t)\\hspace{0.222em}\\text{d}t \\\\  & ={[{t}^{6}+\\frac{9{t}^{5}}{5}+\\frac{{t}^{4}}{4}-{t}^{3}-\\frac{{t}^{2}}{2}]}_{-1}^{0} \\\\  & =0-(1-\\frac{9}{5}+\\frac{1}{4}+1-\\frac{1}{2}) \\\\  & =\\frac{1}{20}\\end{aligned}\n$$"] [:db/cas 17592186281438 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡(\\pi t)\\,i+\\operatorname{sin}⁡(\\pi t)\\,j+\\operatorname{cos}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=y\\,i+x\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $\\mathbf{r}(t)=\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{j}+\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,1).$\nGiven that $\\mathbf{F}(x,y,z)=y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{k},$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$"] [:db/cas 17592186281438 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=\\operatorname{cos}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,k \\\\  & =\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,k \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j-\\pi \\operatorname{sin}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j-\\pi \\operatorname{sin}⁡(\\pi t)\\,k) \\\\  & =\\operatorname{sin}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t))+0\\cdot \\pi \\operatorname{cos}⁡(\\pi t)+\\operatorname{cos}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)) \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)-\\pi {sin}^{2}⁡(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)-\\pi {sin}^{2}⁡(\\pi t))\\,\\text{d}t \\\\  & =-{\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)+\\frac{\\pi }{2}(1-\\operatorname{cos}⁡(2\\pi t)))\\,\\text{d}t \\\\  & =-{[\\frac{{sin}^{2}⁡(\\pi t)}{2}+\\frac{\\pi t}{2}-\\frac{\\operatorname{sin}⁡(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =-[0+\\frac{\\pi }{2}+0-(0-\\frac{\\pi }{2}+0)] \\\\  & =-\\pi \\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=\\operatorname{cos}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k})\\cdot (-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =\\operatorname{sin}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t))+0\\cdot \\pi \\operatorname{cos}(\\pi t)+\\operatorname{cos}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t)) \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)-\\pi {\\operatorname{sin}}^{2}(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)-\\pi {\\operatorname{sin}}^{2}(\\pi t))\\hspace{0.222em}\\text{d}t \\\\  & =-{\\int }_{-1}^{1}(\\pi \\operatorname{sin}(\\pi t)\\operatorname{cos}(\\pi t)+\\frac{\\pi }{2}(1-\\operatorname{cos}(2\\pi t)))\\hspace{0.222em}\\text{d}t \\\\  & =-{[\\frac{{\\operatorname{sin}}^{2}(\\pi t)}{2}+\\frac{\\pi t}{2}-\\frac{\\operatorname{sin}(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =-[0+\\frac{\\pi }{2}+0-(0-\\frac{\\pi }{2}+0)] \\\\  & =-\\pi \\end{aligned}\n$$"] [:db/cas 17592186281453 :question/problem "Let $C$ be the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x-y=1,$ $x=0,$ and $y=0.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨y,\\,-x,\\,1⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" "Let $C$ be the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x-y=1,$ $x=0,$ and $y=0.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\hspace{0.167em}\\mathbf{F}=⟨y,\\hspace{0.222em}-x,\\hspace{0.222em}1⟩,$ the circulation of $\\mathbf{F}$ along $C$ can be written as \n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}=\n$$"] [:db/cas 17592186281453 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=1+{x}^{2}+2{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1+{x}^{2}+2{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1+{x}^{2}+2{y}^{2})=4y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,-x,\\,1⟩{|}_{z=1+{x}^{2}+2{y}^{2}} \\\\  & =⟨y,\\,-x,\\,1⟩ \\\\  & =⟨\\underbrace{y}_{P},\\,\\underbrace{-x}_{Q},\\,\\underbrace{1}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-(-x)\\cdot (4y)+1)\\,\\text{d}A \\\\  & ={∬}_{D}(2xy+1)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/d8/d84b3ecc79c58a128d2f7ea262692d9f66dd9882ff244fb7c3dadd2b2571b550.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{x-1}^{0}\\,2xy+1\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=1+{x}^{2}+2{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1+{x}^{2}+2{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1+{x}^{2}+2{y}^{2})=4y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨y,\\hspace{0.222em}-x,\\hspace{0.222em}1⟩{|}_{z=1+{x}^{2}+2{y}^{2}} \\\\  & =⟨y,\\hspace{0.222em}-x,\\hspace{0.222em}1⟩ \\\\  & =⟨\\underbrace{y}_{P},\\hspace{0.222em}\\underbrace{-x}_{Q},\\hspace{0.222em}\\underbrace{1}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-(-x)\\cdot (4y)+1)\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}(2xy+1)\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/d8/d84b3ecc79c58a128d2f7ea262692d9f66dd9882ff244fb7c3dadd2b2571b550.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{x-1}^{0}\\,2xy+1\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"] [:db/cas 17592186281454 :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨-x{e}^{z},\\,0,\\,{e}^{z}⟩,$ and $C$ is the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ The curve $C$ is oriented counter-clockwise when viewed from above." "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r},\n$$\n\nwhere $\\text{curl}\\hspace{0.167em}\\mathbf{F}=⟨-x{e}^{z},\\hspace{0.222em}0,\\hspace{0.222em}{e}^{z}⟩,$ and $C$ is the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ The curve $C$ is oriented counter-clockwise when viewed from above."] [:db/cas 17592186281454 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨-x{e}^{z},\\,0,\\,{e}^{z}⟩{|}_{z=4} \\\\  & =⟨\\underbrace{-x{e}^{4}}_{P},\\,\\underbrace{0}_{Q},\\,\\underbrace{{e}^{4}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-x{e}^{4})-0\\cdot 0+{e}^{4})\\,\\text{d}A \\\\  & ={∬}_{D}{e}^{4}\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=4$ with radius $2$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{4}\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{e}^{4}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={e}^{4}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\cdot {\\int }_{0}^{2}r\\,\\text{d}r \\\\  & ={e}^{4}[\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{{r}^{2}}{2}]}_{r=0}^{r=2} \\\\  & ={e}^{4}(2\\pi -0)\\cdot (2-0) \\\\  & =4\\pi {e}^{4}.\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨-x{e}^{z},\\hspace{0.222em}0,\\hspace{0.222em}{e}^{z}⟩{|}_{z=4} \\\\  & =⟨\\underbrace{-x{e}^{4}}_{P},\\hspace{0.222em}\\underbrace{0}_{Q},\\hspace{0.222em}\\underbrace{{e}^{4}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-x{e}^{4})-0\\cdot 0+{e}^{4})\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}{e}^{4}\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=4$ with radius $2$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{4}\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{e}^{4}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={e}^{4}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\cdot {\\int }_{0}^{2}r\\,\\text{d}r \\\\  & ={e}^{4}[\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{{r}^{2}}{2}]}_{r=0}^{r=2} \\\\  & ={e}^{4}(2\\pi -0)\\cdot (2-0) \\\\  & =4\\pi {e}^{4}.\\end{aligned}\n$$"] [:db/cas 17592186281457 :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨0,\\,z,\\,x⟩,$ and $C$  is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ The curve $C$ is oriented counter-clockwise when viewed from above." "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r},\n$$\n\nwhere $\\text{curl}\\hspace{0.167em}\\mathbf{F}=⟨0,\\hspace{0.222em}z,\\hspace{0.222em}x⟩,$ and $C$  is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ The curve $C$ is oriented counter-clockwise when viewed from above."] [:db/cas 17592186281457 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=x.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨0,\\,z,\\,x⟩{|}_{z=x} \\\\  & =⟨\\underbrace{0}_{P},\\,\\underbrace{x}_{Q},\\,\\underbrace{x}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot 1-x\\cdot 0+x))\\,\\text{d}A \\\\  & ={∬}_{D}x\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }r\\operatorname{cos}⁡\\theta \\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{[{r}^{2}\\operatorname{sin}⁡\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =0.\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=x.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\hspace{0.167em}\\mathbf{F}:$\n\n$$\n\\begin{aligned}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\hspace{0.167em}{|}_{z=g(x,y)} & =⟨0,\\hspace{0.222em}z,\\hspace{0.222em}x⟩{|}_{z=x} \\\\  & =⟨\\underbrace{0}_{P},\\hspace{0.222em}\\underbrace{x}_{Q},\\hspace{0.222em}\\underbrace{x}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot 1-x\\cdot 0+x))\\hspace{0.222em}\\text{d}A \\\\  & ={∬}_{D}x\\hspace{0.222em}\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }r\\operatorname{cos}⁡\\theta \\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{[{r}^{2}\\operatorname{sin}⁡\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186281554 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=({t}^{2}+t)\\,i+({t}^{3}+{t}^{2})\\,j+(2{t}^{2}+2t)\\,k$ for $t\\in [-1,0).$\nGiven that $F(x,y,z)=y\\,i+z\\,j+x\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $\\mathbf{r}(t)=({t}^{2}+t)\\hspace{0.167em}\\mathbf{i}+({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{j}+(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,0).$\nGiven that $\\mathbf{F}(x,y,z)=y\\hspace{0.167em}\\mathbf{i}+z\\hspace{0.167em}\\mathbf{j}+x\\hspace{0.167em}\\mathbf{k},$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$"] [:db/cas 17592186281554 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}+t,\\,y={t}^{3}+{t}^{2},\\,z=2{t}^{2}+2t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+z\\,j+x\\,k \\\\  & =({t}^{3}+{t}^{2})\\,i+(2{t}^{2}+2t)\\,j+({t}^{2}+t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+2t)\\,k \\\\  & =(2t+1)\\,i+(3{t}^{2}+2t)\\,j+(4t+2)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{3}+{t}^{2})\\,i+(2{t}^{2}+2t)\\,j+({t}^{2}+t)\\,k)\\cdot ((2t+1)\\,i+(3{t}^{2}+2t)\\,j+(4t+2)\\,k) \\\\  & =({t}^{3}+{t}^{2})(2t+1)+(2{t}^{2}+2t)(3{t}^{2}+2t)+({t}^{2}+t)(4t+2) \\\\  & =2t+11{t}^{2}+17{t}^{3}+8{t}^{4}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{0}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}(2t+11{t}^{2}+17{t}^{3}+8{t}^{4})\\,\\text{d}t \\\\  & ={[{t}^{2}+\\frac{11}{3}{t}^{3}+\\frac{17}{4}{t}^{4}+\\frac{8}{5}{t}^{5}]}_{-1}^{0} \\\\  & =0-(1-\\frac{11}{3}+\\frac{17}{4}-\\frac{8}{5}) \\\\  & =\\frac{1}{60}\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}+t,\\,y={t}^{3}+{t}^{2},\\,z=2{t}^{2}+2t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+z\\hspace{0.167em}\\mathbf{j}+x\\hspace{0.167em}\\mathbf{k} \\\\  & =({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{i}+(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+({t}^{2}+t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{k} \\\\  & =(2t+1)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+(4t+2)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(({t}^{3}+{t}^{2})\\hspace{0.167em}\\mathbf{i}+(2{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+({t}^{2}+t)\\hspace{0.167em}\\mathbf{k})\\cdot ((2t+1)\\hspace{0.167em}\\mathbf{i}+(3{t}^{2}+2t)\\hspace{0.167em}\\mathbf{j}+(4t+2)\\hspace{0.167em}\\mathbf{k}) \\\\  & =({t}^{3}+{t}^{2})(2t+1)+(2{t}^{2}+2t)(3{t}^{2}+2t)+({t}^{2}+t)(4t+2) \\\\  & =2t+11{t}^{2}+17{t}^{3}+8{t}^{4}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{0}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{0}(2t+11{t}^{2}+17{t}^{3}+8{t}^{4})\\hspace{0.222em}\\text{d}t \\\\  & ={[{t}^{2}+\\frac{11}{3}{t}^{3}+\\frac{17}{4}{t}^{4}+\\frac{8}{5}{t}^{5}]}_{-1}^{0} \\\\  & =0-(1-\\frac{11}{3}+\\frac{17}{4}-\\frac{8}{5}) \\\\  & =\\frac{1}{60}\\end{aligned}\n$$"] [:db/cas 17592186281555 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=({t}^{3}-t)\\,i+(2{t}^{2}+1)\\,j+({t}^{2}-1)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=y\\,i+3\\,j+yz\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $\\mathbf{r}(t)=({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{j}+({t}^{2}-1)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,1).$\nGiven that $\\mathbf{F}(x,y,z)=y\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+yz\\hspace{0.167em}\\mathbf{k},$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$"] [:db/cas 17592186281555 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{3}-t,\\,y=2{t}^{2}+1,\\,z={t}^{2}-1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+3\\,j+yz\\,k \\\\  & =(2{t}^{2}+1)\\,i+3\\,j+(2{t}^{2}+1)({t}^{2}-1)\\,k \\\\  & =(2{t}^{2}+1)\\,i+3\\,j+(2{t}^{4}-{t}^{2}-1)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+1)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,k \\\\  & =(3{t}^{2}-1)\\,i+4t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((2{t}^{2}+1)\\,i+3\\,j+(2{t}^{4}-{t}^{2}-1)\\,k)\\cdot ((3{t}^{2}-1)\\,i+4t\\,j+2t\\,k) \\\\  & =(2{t}^{2}+1)(3{t}^{2}-1)+3(4t)+(2{t}^{4}-{t}^{2}-1)(2t) \\\\  & =-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5})\\,\\text{d}t \\\\  & ={[-t+5{t}^{2}+\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{4}+\\frac{6}{5}{t}^{5}+\\frac{2}{3}{t}^{6}]}_{-1}^{1} \\\\  & =(-1+5+\\frac{1}{3}-\\frac{1}{2}+\\frac{6}{5}+\\frac{2}{3})-(1+5-\\frac{1}{3}-\\frac{1}{2}-\\frac{6}{5}+\\frac{2}{3}) \\\\  & =-2+\\frac{2}{3}+\\frac{12}{5} \\\\  & =\\frac{16}{15}\\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{3}-t,\\,y=2{t}^{2}+1,\\,z={t}^{2}-1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =y\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+yz\\hspace{0.167em}\\mathbf{k} \\\\  & =(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{2}+1)({t}^{2}-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{4}-{t}^{2}-1)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+1)\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\hspace{0.167em}\\mathbf{k} \\\\  & =(3{t}^{2}-1)\\hspace{0.167em}\\mathbf{i}+4t\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =((2{t}^{2}+1)\\hspace{0.167em}\\mathbf{i}+3\\hspace{0.167em}\\mathbf{j}+(2{t}^{4}-{t}^{2}-1)\\hspace{0.167em}\\mathbf{k})\\cdot ((3{t}^{2}-1)\\hspace{0.167em}\\mathbf{i}+4t\\hspace{0.167em}\\mathbf{j}+2t\\hspace{0.167em}\\mathbf{k}) \\\\  & =(2{t}^{2}+1)(3{t}^{2}-1)+3(4t)+(2{t}^{4}-{t}^{2}-1)(2t) \\\\  & =-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5})\\hspace{0.222em}\\text{d}t \\\\  & ={[-t+5{t}^{2}+\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{4}+\\frac{6}{5}{t}^{5}+\\frac{2}{3}{t}^{6}]}_{-1}^{1} \\\\  & =(-1+5+\\frac{1}{3}-\\frac{1}{2}+\\frac{6}{5}+\\frac{2}{3})-(1+5-\\frac{1}{3}-\\frac{1}{2}-\\frac{6}{5}+\\frac{2}{3}) \\\\  & =-2+\\frac{2}{3}+\\frac{12}{5} \\\\  & =\\frac{16}{15}\\end{aligned}\n$$"] [:db/cas 17592186281556 :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡(\\pi t)\\,i+\\operatorname{sin}⁡(\\pi t)\\,j+2\\operatorname{sin}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=2y\\,i-2x\\,j+{e}^{z-2y}\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $\\mathbf{r}(t)=\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{j}+2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{k}$ for $t\\in [-1,1).$\nGiven that $\\mathbf{F}(x,y,z)=2y\\hspace{0.167em}\\mathbf{i}-2x\\hspace{0.167em}\\mathbf{j}+{e}^{z-2y}\\hspace{0.167em}\\mathbf{k},$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$"] [:db/cas 17592186281556 :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=2\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =2y\\,i-2x\\,j+{e}^{z-2y}\\,k \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+{e}^{2\\operatorname{sin}⁡(\\pi t)-2\\operatorname{sin}⁡(\\pi t)}\\,k \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(\\pi t))\\,k \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+k)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(\\pi t)\\,k) \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t))-2\\operatorname{cos}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t)+1\\cdot 2\\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =-2\\pi {sin}^{2}⁡(\\pi t)-2\\pi {cos}^{2}⁡(\\pi t)+2\\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =-2\\pi +2\\pi \\operatorname{cos}⁡(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2\\pi +2\\pi \\operatorname{cos}⁡(\\pi t))\\,\\text{d}t \\\\  & =[-2\\pi t+2\\operatorname{sin}⁡(\\pi t)]_{-1}^{1} \\\\  & =(-2\\pi (1)+0)-(-2\\pi (-1)+0) \\\\  & =-4\\pi \\end{aligned}\n$$" "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S}.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=2\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t)) & =2y\\hspace{0.167em}\\mathbf{i}-2x\\hspace{0.167em}\\mathbf{j}+{e}^{z-2y}\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+{e}^{2\\operatorname{sin}(\\pi t)-2\\operatorname{sin}(\\pi t)}\\hspace{0.167em}\\mathbf{k} \\\\  & =2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+\\mathbf{k}.\\end{aligned}\n$$\n\nComputing ${\\mathbf{r}}^{'}(t),$ we get\n\n$$\n\\begin{aligned}{\\mathbf{r}}^{'}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}(\\pi t))\\hspace{0.167em}\\mathbf{i}+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{j}+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}(\\pi t))\\hspace{0.167em}\\mathbf{k} \\\\  & =-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+2\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\mathbf{F}(\\mathbf{r}(t))\\cdot {\\mathbf{r}}^{'}(t) & =(2\\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}-2\\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+\\mathbf{k})\\cdot (-\\pi \\operatorname{sin}(\\pi t)\\hspace{0.167em}\\mathbf{i}+\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{j}+2\\pi \\operatorname{cos}(\\pi t)\\hspace{0.167em}\\mathbf{k}) \\\\  & =2\\operatorname{sin}(\\pi t)\\cdot (-\\pi \\operatorname{sin}(\\pi t))-2\\operatorname{cos}(\\pi t)\\cdot \\pi \\operatorname{cos}(\\pi t)+1\\cdot 2\\pi \\operatorname{cos}(\\pi t) \\\\  & =-2\\pi {\\operatorname{sin}}^{2}(\\pi t)-2\\pi {\\operatorname{cos}}^{2}(\\pi t)+2\\pi \\operatorname{cos}(\\pi t) \\\\  & =-2\\pi +2\\pi \\operatorname{cos}(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\hspace{0.167em}\\mathbf{F}\\cdot \\text{d}\\mathbf{S} & ={∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r} \\\\  & ={\\int }_{-1}^{1}\\mathbf{F}(r(t))\\cdot {\\mathbf{r}}^{'}(t)\\hspace{0.278em}\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2\\pi +2\\pi \\operatorname{cos}(\\pi t))\\hspace{0.222em}\\text{d}t \\\\  & =[-2\\pi t+2\\operatorname{sin}(\\pi t)]_{-1}^{1} \\\\  & =(-2\\pi (1)+0)-(-2\\pi (-1)+0) \\\\  & =-4\\pi \\end{aligned}\n$$"] [:db/cas 17592186287850 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{-2\\cdot 4+0\\cdot (-1)+0\\cdot 0}{\\sqrt{{4}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =-\\frac{8}{\\sqrt{17}}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{-2\\cdot 4+0\\cdot (-1)+0\\cdot 0}{\\sqrt{{4}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =-\\frac{8}{\\sqrt{17}}.\\end{aligned}\n$$"] [:db/cas 17592186287850 :question/problem "Let $c=⟨-2,0,0⟩$ and $d=⟨4,-1,0⟩.$ Find the scalar projection of $c$ onto $d.$" "Let $\\mathbf{c}=⟨-2,0,0⟩$ and $\\mathbf{d}=⟨4,-1,0⟩.$ Find the scalar projection of $\\mathbf{c}$ onto $\\mathbf{d}.$"] [:db/cas 17592186287886 :question/problem "Calculate the area of the triangle spanned by $r=⟨1,-2,3⟩$ and $t=⟨0,1,-2⟩.$" "Calculate the area of the triangle spanned by $\\mathbf{r}=⟨1,-2,3⟩$ and $\\mathbf{t}=⟨0,1,-2⟩.$"] [:db/cas 17592186287886 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}r\\times t & =\\begin{vmatrix}i & j & k \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 3 \\\\ 1 & -2\\end{vmatrix}i-\\begin{vmatrix}1 & 3 \\\\ 0 & -2\\end{vmatrix}j+\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}k \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)i-(1\\cdot (-2)-3\\cdot 0)j+(1\\cdot 1-(-2)\\cdot 0)k \\\\  & =i+2j+k \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,r\\times t\\,| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{r}\\times \\mathbf{t} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 3 \\\\ 1 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 3 \\\\ 0 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & -2 \\\\ 0 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)\\mathbf{i}-(1\\cdot (-2)-3\\cdot 0)\\mathbf{j}+(1\\cdot 1-(-2)\\cdot 0)\\mathbf{k} \\\\  & =\\mathbf{i}+2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{r}\\times \\mathbf{t}\\hspace{0.167em}| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$"] [:db/cas 17592186287887 :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2i+j+k)-k \\\\  & =2i+j \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(3i+j+k)-k \\\\  & =3i+j \\\\  & =⟨3,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & 0 \\\\ 3 & 1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 1 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & 0 \\\\ 3 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 1 \\\\ 3 & 1\\end{vmatrix}k \\\\  & =(1\\cdot 0-0\\cdot 1)i-(2\\cdot 0-0\\cdot 3)j+(2\\cdot 1-1\\cdot 3)k \\\\  & =-k \\\\  & =⟨0,0,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{0}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{1}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{i}+\\mathbf{j}+\\mathbf{k})-\\mathbf{k} \\\\  & =2\\mathbf{i}+\\mathbf{j} \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(3\\mathbf{i}+\\mathbf{j}+\\mathbf{k})-\\mathbf{k} \\\\  & =3\\mathbf{i}+\\mathbf{j} \\\\  & =⟨3,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & 0 \\\\ 3 & 1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 0 \\\\ 1 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 0 \\\\ 3 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ 3 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 0-0\\cdot 1)\\mathbf{i}-(2\\cdot 0-0\\cdot 3)\\mathbf{j}+(2\\cdot 1-1\\cdot 3)\\mathbf{k} \\\\  & =-\\mathbf{k} \\\\  & =⟨0,0,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{0}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{1}{2}.\n$$"] [:db/cas 17592186287909 :question/problem "Let $g=\\begin{bmatrix}{r}^{2} \\\\ -1 \\\\ -6\\end{bmatrix}$ and $h=\\begin{bmatrix}3 \\\\ {r}^{2} \\\\ 2\\end{bmatrix}.$ Given that $g⊥h$ and $r<0$, find the value of $r.$" "Let $\\mathbf{g}=\\begin{bmatrix}{r}^{2} \\\\ -1 \\\\ -6\\end{bmatrix}$ and $\\mathbf{h}=\\begin{bmatrix}3 \\\\ {r}^{2} \\\\ 2\\end{bmatrix}.$ Given that $\\mathbf{g}⊥\\mathbf{h}$ and $r<0$, find the value of $r.$"] [:db/cas 17592186287909 :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$" "We know that $\\mathbf{g}⊥\\mathbf{h}$ ($\\mathbf{g}$ and $\\mathbf{h}$ are perpendicular) if and only if $\\mathbf{g}\\cdot \\mathbf{h}=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\\mathbf{g}\\cdot \\mathbf{h} & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}\\mathbf{g}\\cdot \\mathbf{h} & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"] [:db/cas 17592186287928 :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" "Let $\\mathbf{a}=⟨3,2,1⟩$ and $\\mathbf{b}=⟨3,4,1⟩.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$"] [:db/cas 17592186287928 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"] [:db/cas 17592186287929 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"] [:db/cas 17592186287929 :question/problem "Let $p=⟨4,1,4⟩$ and $q=⟨2,3,3⟩.$ Find the scalar projection of $p$ onto $q.$" "Let $\\mathbf{p}=⟨4,1,4⟩$ and $\\mathbf{q}=⟨2,3,3⟩.$ Find the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}.$"] [:db/cas 17592186287930 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{\\mathbf{b}\\cdot \\mathbf{a}}{|\\hspace{0.167em}\\mathbf{a}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$"] [:db/cas 17592186287930 :question/problem "Let $a=⟨2,1,-1⟩$ and $b=⟨1,4,2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" "Let $\\mathbf{a}=⟨2,1,-1⟩$ and $\\mathbf{b}=⟨1,4,2⟩.$ Find ${\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b}.$"] [:db/cas 17592186287931 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{c}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"] [:db/cas 17592186287931 :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" "Let $\\mathbf{c}=⟨4,3,0⟩$ and $\\mathbf{d}=⟨2,1,2⟩.$ Find ${\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d}.$"] [:db/cas 17592186287932 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{\\mathbf{b}\\cdot \\mathbf{a}}{|\\hspace{0.167em}\\mathbf{a}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$"] [:db/cas 17592186287932 :question/problem "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" "Let $\\mathbf{a}=⟨-1,2,\\sqrt{11}⟩$ and $\\mathbf{b}=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b}.$"] [:db/cas 17592186287933 :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" "Let $\\mathbf{p}=⟨1,4,2\\sqrt{2}⟩$ and $\\mathbf{q}=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}+{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q}.$"] [:db/cas 17592186287933 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}+{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"] [:db/cas 17592186287968 :question/problem "Calculate the area of the parallelogram spanned by $u=⟨2,1,-1⟩$ and $v=⟨1,2,0⟩.$" "Calculate the area of the parallelogram spanned by $\\mathbf{u}=⟨2,1,-1⟩$ and $\\mathbf{v}=⟨1,2,0⟩.$"] [:db/cas 17592186287968 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}u\\times v & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & -1 \\\\ 1 & 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 2 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & -1 \\\\ 1 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}k \\\\  & =(1\\cdot 0-2\\cdot (-1))i-(2\\cdot 0-1\\cdot (-1))j+(2\\cdot 2-1\\cdot 1)k \\\\  & =2i-j+3k \\\\  & =⟨2,-1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,u\\times v\\,| \\\\  & =\\sqrt{{2}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{u}\\times \\mathbf{v} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & -1 \\\\ 1 & 2 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -1 \\\\ 2 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ 1 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 0-2\\cdot (-1))\\mathbf{i}-(2\\cdot 0-1\\cdot (-1))\\mathbf{j}+(2\\cdot 2-1\\cdot 1)\\mathbf{k} \\\\  & =2\\mathbf{i}-\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{u}\\times \\mathbf{v}\\hspace{0.167em}| \\\\  & =\\sqrt{{2}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$"] [:db/cas 17592186287969 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}f\\times g & =\\begin{vmatrix}i & j & k \\\\ 1 & 1 & -2 \\\\ 3 & 2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 2 & 1\\end{vmatrix}i-\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}j+\\begin{vmatrix}1 & 1 \\\\ 3 & 2\\end{vmatrix}k \\\\  & =(1\\cdot 1-2\\cdot (-2))i-(1\\cdot 1-3\\cdot (-2))j+(1\\cdot 2-3\\cdot 1)k \\\\  & =5i-7j-k \\\\  & =⟨5,-7,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,f\\times g\\,| \\\\  & =\\sqrt{{5}^{2}+(-7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{f}\\times \\mathbf{g} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 1 & -2 \\\\ 3 & 2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -2 \\\\ 2 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & -2 \\\\ 3 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 1 \\\\ 3 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot 1-2\\cdot (-2))\\mathbf{i}-(1\\cdot 1-3\\cdot (-2))\\mathbf{j}+(1\\cdot 2-3\\cdot 1)\\mathbf{k} \\\\  & =5\\mathbf{i}-7\\mathbf{j}-\\mathbf{k} \\\\  & =⟨5,-7,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{f}\\times \\mathbf{g}\\hspace{0.167em}| \\\\  & =\\sqrt{{5}^{2}+(-7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}.\\end{aligned}\n$$"] [:db/cas 17592186287969 :question/problem "Calculate the area of the parallelogram spanned by $f=⟨1,1,-2⟩$ and $g=⟨3,2,1⟩.$" "Calculate the area of the parallelogram spanned by $\\mathbf{f}=⟨1,1,-2⟩$ and $\\mathbf{g}=⟨3,2,1⟩.$"] [:db/cas 17592186287970 :question/problem "Calculate the area of the parallelogram spanned by $h=⟨2,0,3⟩$ and $l=⟨4,1,3⟩.$" "Calculate the area of the parallelogram spanned by $\\mathbf{h}=⟨2,0,3⟩$ and $\\mathbf{l}=⟨4,1,3⟩.$"] [:db/cas 17592186287970 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}h\\times l & =\\begin{vmatrix}i & j & k \\\\ 2 & 0 & 3 \\\\ 4 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 1 & 3\\end{vmatrix}i-\\begin{vmatrix}2 & 3 \\\\ 4 & 3\\end{vmatrix}j+\\begin{vmatrix}2 & 0 \\\\ 4 & 1\\end{vmatrix}k \\\\  & =(0\\cdot 3-1\\cdot 3)i-(2\\cdot 3-4\\cdot 3)j+(2\\cdot 1-4\\cdot 0)k \\\\  & =-3i+6j+2k \\\\  & =⟨-3,6,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,h\\times l\\,| \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{h}\\times \\mathbf{l} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 0 & 3 \\\\ 4 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 3 \\\\ 1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 3 \\\\ 4 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 0 \\\\ 4 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 3-1\\cdot 3)\\mathbf{i}-(2\\cdot 3-4\\cdot 3)\\mathbf{j}+(2\\cdot 1-4\\cdot 0)\\mathbf{k} \\\\  & =-3\\mathbf{i}+6\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-3,6,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{h}\\times \\mathbf{l}\\hspace{0.167em}| \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"] [:db/cas 17592186287971 :question/worked-solution "First, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =s-r \\\\  & =(2i-2j+2k)-(3i-2j+k) \\\\  & =-i+k \\\\  & =⟨-1,0,1⟩ \\\\ \\overset{\\to }{RT} & =t-r \\\\  & =(i-3j+3k)-(3i-2j+k) \\\\  & =-2i-j+2k \\\\  & =⟨-2,-1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}i & j & k \\\\ -1 & 0 & 1 \\\\ -2 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ -1 & 2\\end{vmatrix}i-\\begin{vmatrix}-1 & 1 \\\\ -2 & 2\\end{vmatrix}j+\\begin{vmatrix}-1 & 0 \\\\ -2 & -1\\end{vmatrix}k \\\\  & =(0\\cdot 2-(-1)\\cdot 1)i-((-1)\\cdot 2-(-2)\\cdot 1)j+((-1)\\cdot (-1)-(-2)\\cdot 0)k \\\\  & =i+k \\\\  & =⟨1,0,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\mathbf{s}-\\mathbf{r} \\\\  & =(2\\mathbf{i}-2\\mathbf{j}+2\\mathbf{k})-(3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k}) \\\\  & =-\\mathbf{i}+\\mathbf{k} \\\\  & =⟨-1,0,1⟩ \\\\ \\overset{\\to }{RT} & =\\mathbf{t}-\\mathbf{r} \\\\  & =(\\mathbf{i}-3\\mathbf{j}+3\\mathbf{k})-(3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k}) \\\\  & =-2\\mathbf{i}-\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-2,-1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -1 & 0 & 1 \\\\ -2 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 1 \\\\ -1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-1 & 1 \\\\ -2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-1 & 0 \\\\ -2 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 2-(-1)\\cdot 1)\\mathbf{i}-((-1)\\cdot 2-(-2)\\cdot 1)\\mathbf{j}+((-1)\\cdot (-1)-(-2)\\cdot 0)\\mathbf{k} \\\\  & =\\mathbf{i}+\\mathbf{k} \\\\  & =⟨1,0,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"] [:db/cas 17592186290429 :question/problem "![](images/6f/6f827dac7ecaf3a659245d1178aa39a519ae3a40339c917004247f12554c871a.png)\n\nConsider the vector field $F=2x\\,i+2y\\,j$ and a square $C$ with side length $8$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*" "![](images/6f/6f827dac7ecaf3a659245d1178aa39a519ae3a40339c917004247f12554c871a.png)\n\nConsider the vector field $\\mathbf{F}=2x\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j}$ and a square $C$ with side length $8$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across all four sides of the square.*"] [:db/cas 17592186290429 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/0b/0b753318ebad9270c3fc8788d0e3949ffb29a800eb3f8dd6fb67cb271be68033.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i+2y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-4}^{4}4\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =8{\\int }_{-4}^{4}\\text{d}t \\\\  & =8(4-(-4)) \\\\  & =8\\cdot 8 \\\\  & =64.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=4\\cdot 64=256.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/0b/0b753318ebad9270c3fc8788d0e3949ffb29a800eb3f8dd6fb67cb271be68033.png)\n\nFirst, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(2x\\hspace{0.167em}\\mathbf{i}+2y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=4\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-4,4].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =2{\\int }_{-4}^{4}4\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =8{\\int }_{-4}^{4}\\text{d}t \\\\  & =8(4-(-4)) \\\\  & =8\\cdot 8 \\\\  & =64.\\end{aligned}\n$$\n\nBy symmetry, the flux integrals over the sides ${C}_{2},{C}_{3},$ and ${C}_{4}$ must be the same. Therefore,\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s=4\\cdot 64=256.\n$$"] [:db/cas 17592186290430 :question/problem "![](images/2d/2dcfb8778adf7e9a05ff1dff886d0d8290427ed2ae910b46db4fe9aeb36170eb.png)\n\nConsider the vector field $F=x\\,i+3y\\,j$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" "![](images/2d/2dcfb8778adf7e9a05ff1dff886d0d8290427ed2ae910b46db4fe9aeb36170eb.png)\n\nConsider the vector field $\\mathbf{F}=x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j}$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*"] [:db/cas 17592186290430 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/f2/f283fe675e0a9ef736947e404f03ab5afb90a4209ba1a6949d18ac6d3fb20048.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(x\\,i+3y\\,j)\\cdot i\\,\\text{d}s \\\\  & ={\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}x\\,\\text{d}s & ={\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =3{\\int }_{-3}^{3}\\text{d}t \\\\  & =3\\cdot 6 \\\\  & =18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=18.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(x\\,i+3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\,\\text{d}s & =3{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =9{\\int }_{-3}^{3}\\text{d}t \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=54.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 18+2\\cdot 54=144.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/f2/f283fe675e0a9ef736947e404f03ab5afb90a4209ba1a6949d18ac6d3fb20048.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & ={\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & ={\\int }_{-3}^{3}3\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =3{\\int }_{-3}^{3}\\text{d}t \\\\  & =3\\cdot 6 \\\\  & =18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s=18.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${\\mathbf{n}}_{2}=\\mathbf{j},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}(x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s & =3{\\int }_{-3}^{3}3\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =9{\\int }_{-3}^{3}\\text{d}t \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s=54.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s=2\\cdot 18+2\\cdot 54=144.\n$$"] [:db/cas 17592186290431 :question/problem "![](images/ec/ec48931b53248128f4eefd2fe2428120adeef983b6fd2a613e7dcca96c00fe12.png)\n\nConsider the vector field $F=2x\\,i-y\\,j$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" "![](images/ec/ec48931b53248128f4eefd2fe2428120adeef983b6fd2a613e7dcca96c00fe12.png)\n\nConsider the vector field $\\mathbf{F}=2x\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j}$ and a square $C$ with side length $6$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*"] [:db/cas 17592186290431 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/86/867ab8337894fa75d010bcb12557702059a4a93aaa2bdef2f853c46ff2801d67.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i-y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=36.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(2x\\,i-y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}y\\,\\text{d}s & =-{\\int }_{-3}^{3}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-3}^{3}\\text{d}t \\\\  & =-3\\cdot 6 \\\\  & =-18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-18.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 36+2\\cdot (-18)=36.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/86/867ab8337894fa75d010bcb12557702059a4a93aaa2bdef2f853c46ff2801d67.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(2x\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3\\,i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =2{\\int }_{-3}^{3}3\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s=36.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${\\mathbf{n}}_{2}=\\mathbf{j},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}(2x\\hspace{0.167em}\\mathbf{i}-y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & =-{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}y\\hspace{0.222em}\\text{d}s & =-{\\int }_{-3}^{3}3\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =-3{\\int }_{-3}^{3}\\text{d}t \\\\  & =-3\\cdot 6 \\\\  & =-18.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s=-18.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s=2\\cdot 36+2\\cdot (-18)=36.\n$$"] [:db/cas 17592186290432 :question/problem "![](images/0a/0a62dfaec4e967433ef56d319e4e66a220441a711ce97a84ca96a4bbd7d0bf37.png)\n\nConsider the vector field $F=2x\\,i-3y\\,j$ and a rectangle $C$ with base $4$ and height $2$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" "![](images/0a/0a62dfaec4e967433ef56d319e4e66a220441a711ce97a84ca96a4bbd7d0bf37.png)\n\nConsider the vector field $\\mathbf{F}=2x\\hspace{0.167em}\\mathbf{i}-3y\\hspace{0.167em}\\mathbf{j}$ and a rectangle $C$ with base $4$ and height $2$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*"] [:db/cas 17592186290432 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/00/00a9df76d0be8ffd33b2ee968b57a21eb1e6947af6e94505313f163b584f5769.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(2x\\,i-3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=2i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\,\\text{d}s & =2{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}\\text{d}t \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(2x\\,i-3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{2}}y\\,\\text{d}s & =-3{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-12.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 8+2\\cdot (-12)=-8.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/00/00a9df76d0be8ffd33b2ee968b57a21eb1e6947af6e94505313f163b584f5769.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(2x\\hspace{0.167em}\\mathbf{i}-3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=2i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =2{\\int }_{-1}^{1}2\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =4{\\int }_{-1}^{1}\\text{d}t \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s=8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${\\mathbf{n}}_{2}=\\mathbf{j},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}(2x\\hspace{0.167em}\\mathbf{i}-3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & =-3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s & =-3{\\int }_{-2}^{2}1\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s=-12.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s=2\\cdot 8+2\\cdot (-12)=-8.\n$$"] [:db/cas 17592186290434 :question/problem "![](images/80/80cc5e165f78bc1fc8cc7f83644fd00ca4a8f4e05e69d97b654bb2f1450d9b99.png)\n\nConsider the vector field $F=-x\\,i+3y\\,j$ and a rectangle $C$ with base $6$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" "![](images/80/80cc5e165f78bc1fc8cc7f83644fd00ca4a8f4e05e69d97b654bb2f1450d9b99.png)\n\nConsider the vector field $\\mathbf{F}=-x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j}$ and a rectangle $C$ with base $6$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*"] [:db/cas 17592186290434 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/51/511bae61d710c3362bb18618717b3d44ef5dcedece5f669e0b5237b7b524a054.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-x\\,i+3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}x\\,\\text{d}s & =-{\\int }_{-2}^{2}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-12.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-x\\,i+3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\,\\text{d}s & =3{\\int }_{-3}^{3}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=36.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-12)+2\\cdot 36=48.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/51/511bae61d710c3362bb18618717b3d44ef5dcedece5f669e0b5237b7b524a054.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(-x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =-{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =-{\\int }_{-2}^{2}3\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s=-12.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${\\mathbf{n}}_{2}=\\mathbf{j},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}(-x\\hspace{0.167em}\\mathbf{i}+3y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s & =3{\\int }_{-3}^{3}2\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s=36.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s=2\\cdot (-12)+2\\cdot 36=48.\n$$"] [:db/cas 17592186290435 :question/problem "![](images/0a/0ac0fa01b3e09d268115a604a53ca6247c9e26d88603482223aa43927df20561.png)\n\nConsider the vector field $F=-2x\\,i+5y\\,j$ and a rectangle $C$ with base $2$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" "![](images/0a/0ac0fa01b3e09d268115a604a53ca6247c9e26d88603482223aa43927df20561.png)\n\nConsider the vector field $\\mathbf{F}=-2x\\hspace{0.167em}\\mathbf{i}+5y\\hspace{0.167em}\\mathbf{j}$ and a rectangle $C$ with base $2$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $\\mathbf{F}$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*"] [:db/cas 17592186290435 :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/29/29f4b57751e27f01539fb48acf115b6e255d47a04ee647ef85aa496731b266c8.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-2x\\,i+5y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{1}}x\\,\\text{d}s & =-2{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-2)\\cdot 4 \\\\  & =-8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-2x\\,i+5y\\,j)\\cdot j\\,\\text{d}s \\\\  & =5{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5{\\int }_{{C}_{2}}y\\,\\text{d}s & =5{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =10{\\int }_{-1}^{1}\\text{d}t \\\\  & =10\\cdot 2 \\\\  & =20.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=20.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-8)+2\\cdot 20=24.\n$$" "If $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf{F}$ across $C$ is given by\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s+{\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${\\mathbf{n}}_{i}$ are shown below.\n\n![](images/29/29f4b57751e27f01539fb48acf115b6e255d47a04ee647ef85aa496731b266c8.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${\\mathbf{n}}_{1}=\\mathbf{i},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{1}}(-2x\\hspace{0.167em}\\mathbf{i}+5y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{i}\\hspace{0.222em}\\text{d}s \\\\  & =-2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{1}}x\\hspace{0.222em}\\text{d}s & =-2{\\int }_{-2}^{2}1\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =-2{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-2)\\cdot 4 \\\\  & =-8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}\\mathbf{F}\\cdot {\\mathbf{n}}_{1}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{3}}\\mathbf{F}\\cdot {\\mathbf{n}}_{3}\\hspace{0.222em}\\text{d}s=-8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${\\mathbf{n}}_{2}=\\mathbf{j},$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s & ={\\int }_{{C}_{2}}(-2x\\hspace{0.167em}\\mathbf{i}+5y\\hspace{0.167em}\\mathbf{j})\\cdot \\mathbf{j}\\hspace{0.222em}\\text{d}s \\\\  & =5{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5{\\int }_{{C}_{2}}y\\hspace{0.222em}\\text{d}s & =5{\\int }_{-1}^{1}2\\cdot ||{\\mathbf{r}}^{'}(t)||\\hspace{0.167em}\\text{d}t \\\\  & =10{\\int }_{-1}^{1}\\text{d}t \\\\  & =10\\cdot 2 \\\\  & =20.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}\\mathbf{F}\\cdot {\\mathbf{n}}_{2}\\hspace{0.222em}\\text{d}s={\\int }_{{C}_{4}}\\mathbf{F}\\cdot {\\mathbf{n}}_{4}\\hspace{0.222em}\\text{d}s=20.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathbf{n}\\hspace{0.167em}\\text{d}s=2\\cdot (-8)+2\\cdot 20=24.\n$$"] [:db/cas 17592186290486 :question/problem "Let $p=\\begin{bmatrix}-2 \\\\ 0 \\\\ 5\\end{bmatrix}$ and $q=\\begin{bmatrix}15 \\\\ \\sqrt{2} \\\\ x\\end{bmatrix}.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" "Let $\\mathbf{p}=\\begin{bmatrix}-2 \\\\ 0 \\\\ 5\\end{bmatrix}$ and $\\mathbf{q}=\\begin{bmatrix}15 \\\\ \\sqrt{2} \\\\ x\\end{bmatrix}.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is $0,$ find the value of $x.$"] [:db/cas 17592186290486 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$"] [:db/cas 17592186290487 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$"] [:db/cas 17592186290487 :question/problem "Let $p=\\begin{bmatrix}5 \\\\ x \\\\ 2\\end{bmatrix}$ and $q=\\begin{bmatrix}4 \\\\ -2 \\\\ -3\\end{bmatrix}.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" "Let $\\mathbf{p}=\\begin{bmatrix}5 \\\\ x \\\\ 2\\end{bmatrix}$ and $\\mathbf{q}=\\begin{bmatrix}4 \\\\ -2 \\\\ -3\\end{bmatrix}.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is $0,$ find the value of $x.$"] [:db/cas 17592186290488 :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}$ and $b=\\begin{bmatrix}-2 \\\\ x \\\\ 2\\end{bmatrix}.$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" "Let $\\mathbf{a}=\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}$ and $\\mathbf{b}=\\begin{bmatrix}-2 \\\\ x \\\\ 2\\end{bmatrix}.$ Given that the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$ is $0,$ find the value of $x.$"] [:db/cas 17592186290488 :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$" "Since $\\mathbf{a}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{b}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{a}⊥\\mathbf{b}\\hspace{2em}⟹\\hspace{2em}\\mathbf{a}\\cdot \\mathbf{b}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"] [:db/cas 17592186290489 :question/problem "Let $p=i-3j$ and $q=xi+2j+k.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" "Let $\\mathbf{p}=\\mathbf{i}-3\\mathbf{j}$ and $\\mathbf{q}=x\\mathbf{i}+2\\mathbf{j}+\\mathbf{k}.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is $0,$ find the value of $x.$"] [:db/cas 17592186290489 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$"] [:db/cas 17592186290490 :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$" "Since $\\mathbf{a}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{b}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{a}⊥\\mathbf{b}\\hspace{2em}⟹\\hspace{2em}\\mathbf{a}\\cdot \\mathbf{b}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"] [:db/cas 17592186290490 :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" "Let $\\mathbf{a}=5\\mathbf{i}-4\\mathbf{j}+3\\mathbf{k}$ and $\\mathbf{b}=-7\\mathbf{i}+x\\mathbf{j}+\\mathbf{k}.$ Given that the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$ is zero, find the value of $x.$"] [:db/cas 17592186290491 :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" "Let $\\mathbf{p}=⟨2,0,3⟩$ and $\\mathbf{q}=⟨3,0,x⟩.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is zero, find the value of $x.$"] [:db/cas 17592186290491 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$"] [:db/cas 17592186290492 :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" "Let $\\mathbf{c}=⟨-3,\\sqrt{3},1⟩$ and $\\mathbf{d}=⟨x,0,-12⟩.$ Given that the scalar projection of $\\mathbf{c}$ onto $\\mathbf{d}$ is zero, find the value of $x.$"] [:db/cas 17592186290492 :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$" "Since $\\mathbf{c}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{d}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{c}⊥\\mathbf{d}\\hspace{2em}⟹\\hspace{2em}\\mathbf{c}\\cdot \\mathbf{d}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{c}\\cdot \\mathbf{d} & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{c}\\cdot \\mathbf{d} & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"] [:db/cas 17592186290493 :question/problem "Let $p=⟨3,5,x⟩$ and $q=⟨-3,1,2⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" "Let $\\mathbf{p}=⟨3,5,x⟩$ and $\\mathbf{q}=⟨-3,1,2⟩.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is zero, find the value of $x.$"] [:db/cas 17592186290493 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$"] [:db/cas 17592186292813 :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨-4,-2,1⟩$ and $b=⟨0,-2,-1⟩.$\n\n$A=${{field-1}}" "Calculate the area $A$ of the parallelogram spanned by $\\mathbf{a}=⟨-4,-2,1⟩$ and $\\mathbf{b}=⟨0,-2,-1⟩.$\n\n$A=${{field-1}}"] [:db/cas 17592186292813 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ -4 & -2 & 1 \\\\ 0 & -2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ -2 & -1\\end{vmatrix}i-\\begin{vmatrix}-4 & 1 \\\\ 0 & -1\\end{vmatrix}j+\\begin{vmatrix}-4 & -2 \\\\ 0 & -2\\end{vmatrix}k \\\\  & =((-2)\\cdot (-1)-(-2)\\cdot 1)i-((-4)\\cdot (-1)-0\\cdot 1)j+((-4)\\cdot (-2)-0\\cdot (-2))k \\\\  & =4i-4j+8k \\\\  & =⟨4,-4,8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{4}^{2}+(-4)^{2}+{8}^{2}} \\\\  & =4\\sqrt{6}.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -4 & -2 & 1 \\\\ 0 & -2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ -2 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-4 & 1 \\\\ 0 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-4 & -2 \\\\ 0 & -2\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot (-1)-(-2)\\cdot 1)\\mathbf{i}-((-4)\\cdot (-1)-0\\cdot 1)\\mathbf{j}+((-4)\\cdot (-2)-0\\cdot (-2))\\mathbf{k} \\\\  & =4\\mathbf{i}-4\\mathbf{j}+8\\mathbf{k} \\\\  & =⟨4,-4,8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{4}^{2}+(-4)^{2}+{8}^{2}} \\\\  & =4\\sqrt{6}.\\end{aligned}\n$$"] [:db/cas 17592186292814 :question/problem "Calculate the area ${A}_{△}$ of the triangle spanned by $a=⟨-2,-1,0⟩$ and $b=⟨-4,2,-2⟩.$\n\n${A}_{△}=${{field-1}}" "Calculate the area ${A}_{△}$ of the triangle spanned by $\\mathbf{a}=⟨-2,-1,0⟩$ and $\\mathbf{b}=⟨-4,2,-2⟩.$\n\n${A}_{△}=${{field-1}}"] [:db/cas 17592186292814 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ -2 & -1 & 0 \\\\ -4 & 2 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix}i-\\begin{vmatrix}-2 & 0 \\\\ -4 & -2\\end{vmatrix}j+\\begin{vmatrix}-2 & -1 \\\\ -4 & 2\\end{vmatrix}k \\\\  & =((-1)\\cdot (-2)-2\\cdot 0)i-((-2)\\cdot (-2)-(-4)\\cdot 0)j+((-2)\\cdot 2-(-4)\\cdot (-1))k \\\\  & =2i-4j-8k \\\\  & =⟨2,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =2\\sqrt{21}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{21}}{2}=\\sqrt{21}.\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -2 & -1 & 0 \\\\ -4 & 2 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-2 & 0 \\\\ -4 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-2 & -1 \\\\ -4 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =((-1)\\cdot (-2)-2\\cdot 0)\\mathbf{i}-((-2)\\cdot (-2)-(-4)\\cdot 0)\\mathbf{j}+((-2)\\cdot 2-(-4)\\cdot (-1))\\mathbf{k} \\\\  & =2\\mathbf{i}-4\\mathbf{j}-8\\mathbf{k} \\\\  & =⟨2,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =2\\sqrt{21}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{21}}{2}=\\sqrt{21}.\n$$"] [:db/cas 17592186292815 :question/worked-solution "First, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-3i+3j-4k)-(-2i-k) \\\\  & =-i+3j-3k \\\\  & =⟨-1,3,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2j+2k)-(-2i-k) \\\\  & =2i-2j+3k \\\\  & =⟨2,-2,3⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}i & j & k \\\\ -1 & 3 & -3 \\\\ 2 & -2 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -3 \\\\ -2 & 3\\end{vmatrix}i-\\begin{vmatrix}-1 & -3 \\\\ 2 & 3\\end{vmatrix}j+\\begin{vmatrix}-1 & 3 \\\\ 2 & -2\\end{vmatrix}k \\\\  & =(3\\cdot 3-(-2)\\cdot (-3))i-((-1)\\cdot 3-2\\cdot (-3))j+((-1)\\cdot (-2)-2\\cdot 3)k \\\\  & =3i-3j-4k \\\\  & =⟨3,-3,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{3}^{2}+(-3)^{2}+(-4)^{2}} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{34}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(-3\\mathbf{i}+3\\mathbf{j}-4\\mathbf{k})-(-2\\mathbf{i}-\\mathbf{k}) \\\\  & =-\\mathbf{i}+3\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨-1,3,-3⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-2\\mathbf{j}+2\\mathbf{k})-(-2\\mathbf{i}-\\mathbf{k}) \\\\  & =2\\mathbf{i}-2\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-2,3⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -1 & 3 & -3 \\\\ 2 & -2 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -3 \\\\ -2 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-1 & -3 \\\\ 2 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-1 & 3 \\\\ 2 & -2\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 3-(-2)\\cdot (-3))\\mathbf{i}-((-1)\\cdot 3-2\\cdot (-3))\\mathbf{j}+((-1)\\cdot (-2)-2\\cdot 3)\\mathbf{k} \\\\  & =3\\mathbf{i}-3\\mathbf{j}-4\\mathbf{k} \\\\  & =⟨3,-3,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{3}^{2}+(-3)^{2}+(-4)^{2}} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{34}}{2}.\n$$"] [:db/cas 17592186292816 :question/worked-solution "Note that the length of the altitude $CH$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CH\\cdot AB\n$$\n\nSo, to find $CH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2j-k)-(-2i-k) \\\\  & =2i-2j \\\\  & =⟨2,-2,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-3i-2j)-(-2i-k) \\\\  & =-i-2j+k \\\\  & =⟨-1,-2,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}i & j & k \\\\ 2 & -2 & 0 \\\\ -1 & -2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 0 \\\\ -2 & 1\\end{vmatrix}i-\\begin{vmatrix}2 & 0 \\\\ -1 & 1\\end{vmatrix}j+\\begin{vmatrix}2 & -2 \\\\ -1 & -2\\end{vmatrix}k \\\\  & =((-2)\\cdot 1-(-2)\\cdot 0)i-(2\\cdot 1-(-1)\\cdot 0)j+(2\\cdot (-2)-(-1)\\cdot (-2))k \\\\  & =-2i-2j-6k \\\\  & =⟨-2,-2,-6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{(-2)^{2}+(-2)^{2}+(-6)^{2}} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{11}}{2}=\\sqrt{11}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+{0}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CH\\cdot AB,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}CH\\cdot AB \\\\ \\sqrt{11} & =\\frac{1}{2}CH\\cdot 2\\sqrt{2} \\\\ \\sqrt{11} & =CH\\cdot \\sqrt{2} \\\\ CH & =\\frac{\\sqrt{11}}{\\sqrt{2}} \\\\ CH & =\\frac{\\sqrt{22}}{2}.\\end{aligned}\n$$" "Note that the length of the altitude $CH$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CH\\cdot AB\n$$\n\nSo, to find $CH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(-2\\mathbf{j}-\\mathbf{k})-(-2\\mathbf{i}-\\mathbf{k}) \\\\  & =2\\mathbf{i}-2\\mathbf{j} \\\\  & =⟨2,-2,0⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(-3\\mathbf{i}-2\\mathbf{j})-(-2\\mathbf{i}-\\mathbf{k}) \\\\  & =-\\mathbf{i}-2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨-1,-2,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & -2 & 0 \\\\ -1 & -2 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 0 \\\\ -2 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 0 \\\\ -1 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & -2 \\\\ -1 & -2\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot 1-(-2)\\cdot 0)\\mathbf{i}-(2\\cdot 1-(-1)\\cdot 0)\\mathbf{j}+(2\\cdot (-2)-(-1)\\cdot (-2))\\mathbf{k} \\\\  & =-2\\mathbf{i}-2\\mathbf{j}-6\\mathbf{k} \\\\  & =⟨-2,-2,-6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{(-2)^{2}+(-2)^{2}+(-6)^{2}} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{11}}{2}=\\sqrt{11}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+{0}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CH\\cdot AB,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}CH\\cdot AB \\\\ \\sqrt{11} & =\\frac{1}{2}CH\\cdot 2\\sqrt{2} \\\\ \\sqrt{11} & =CH\\cdot \\sqrt{2} \\\\ CH & =\\frac{\\sqrt{11}}{\\sqrt{2}} \\\\ CH & =\\frac{\\sqrt{22}}{2}.\\end{aligned}\n$$"] [:db/cas 17592186292825 :question/problem "Suppose $|\\,c\\,|=4$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{c}\\hspace{0.167em}|=4$ and the angle between vectors $\\mathbf{c}$ and $\\mathbf{d}$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $\\mathbf{c}$ onto $\\mathbf{d}.$\n\n${\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}=$\n{{field-1}}"] [:db/cas 17592186292825 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =4\\cdot 0 \\\\  & =0.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =|\\hspace{0.167em}\\mathbf{c}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =4\\operatorname{cos}\\left(\\frac{\\pi }{2}\\right) \\\\  & =4\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186292826 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"] [:db/cas 17592186292826 :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" "Let $\\mathbf{p}=⟨2,1,-2⟩$ and $\\mathbf{q}=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}.$\n\n${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}=$\n{{field-1}}"] [:db/cas 17592186292827 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"] [:db/cas 17592186292827 :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" "Let $\\mathbf{c}=⟨1,2,-3⟩$ and $\\mathbf{d}=⟨2,1,2⟩.$ Find the scalar projection of $\\mathbf{c}$ onto $\\mathbf{d}.$\n\n${\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}=$\n{{field-1}}"] [:db/cas 17592186292828 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{d}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{\\mathbf{c}\\cdot \\mathbf{d}}{|\\hspace{0.167em}\\mathbf{c}\\hspace{0.167em}|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d} & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"] [:db/cas 17592186292828 :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" "Let $\\mathbf{c}=⟨4,-3,0⟩$ and $\\mathbf{d}=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d}.$\n\n${\\text{comp}}_{\\mathbf{d}}\\hspace{0.167em}\\mathbf{c}-{\\text{comp}}_{\\mathbf{c}}\\hspace{0.167em}\\mathbf{d}=$\n{{field-1}}"] [:db/cas 17592186292829 :question/problem "Let $p=⟨-1,2,1⟩$ and $q=⟨2,x,0⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "Let $\\mathbf{p}=⟨-1,2,1⟩$ and $\\mathbf{q}=⟨2,x,0⟩.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}"] [:db/cas 17592186292829 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 2+2\\cdot x+1\\cdot 0 \\\\  & =-2+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -2+2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 2+2\\cdot x+1\\cdot 0 \\\\  & =-2+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ -2+2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"] [:db/cas 17592186292830 :question/problem "Let $a=\\begin{bmatrix}-1 \\\\ 2 \\\\ 4\\end{bmatrix}$ and $b=\\begin{bmatrix}0 \\\\ x \\\\ 2\\end{bmatrix}.$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" "Let $\\mathbf{a}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 4\\end{bmatrix}$ and $\\mathbf{b}=\\begin{bmatrix}0 \\\\ x \\\\ 2\\end{bmatrix}.$ Given that the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}"] [:db/cas 17592186292830 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"] [:db/cas 17592186297464 :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨-3,5,0⟩$ and $b=⟨4,-1,2⟩.$\n\n$A=${{field-1}}" "Calculate the area $A$ of the parallelogram spanned by $\\mathbf{a}=⟨-3,5,0⟩$ and $\\mathbf{b}=⟨4,-1,2⟩.$\n\n$A=${{field-1}}"] [:db/cas 17592186297464 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ -3 & 5 & 0 \\\\ 4 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 0 \\\\ -1 & 2\\end{vmatrix}i-\\begin{vmatrix}-3 & 0 \\\\ 4 & 2\\end{vmatrix}j+\\begin{vmatrix}-3 & 5 \\\\ 4 & -1\\end{vmatrix}k \\\\  & =(5\\cdot 2-0\\cdot (-1))i-((-3)\\cdot 2-0\\cdot 4)j+((-3)\\cdot (-1)-5\\cdot 4)k \\\\  & =10i+6j-17k \\\\  & =⟨10,6,-17⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{10}^{2}+{6}^{2}+(-17)^{2}} \\\\  & =\\sqrt{100+36+289} \\\\  & =\\sqrt{425} \\\\  & =5\\sqrt{17}.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -3 & 5 & 0 \\\\ 4 & -1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 0 \\\\ -1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-3 & 0 \\\\ 4 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-3 & 5 \\\\ 4 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(5\\cdot 2-0\\cdot (-1))\\mathbf{i}-((-3)\\cdot 2-0\\cdot 4)\\mathbf{j}+((-3)\\cdot (-1)-5\\cdot 4)\\mathbf{k} \\\\  & =10\\mathbf{i}+6\\mathbf{j}-17\\mathbf{k} \\\\  & =⟨10,6,-17⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{10}^{2}+{6}^{2}+(-17)^{2}} \\\\  & =\\sqrt{100+36+289} \\\\  & =\\sqrt{425} \\\\  & =5\\sqrt{17}.\\end{aligned}\n$$"] [:db/cas 17592186297465 :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨1,0,0⟩$ and $b=⟨0,3,4⟩.$\n\n$A=${{field-1}}" "Calculate the area $A$ of the parallelogram spanned by $\\mathbf{a}=⟨1,0,0⟩$ and $\\mathbf{b}=⟨0,3,4⟩.$\n\n$A=${{field-1}}"] [:db/cas 17592186297465 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =\\begin{vmatrix}i & j & k \\\\ 1 & 0 & 0 \\\\ 0 & 3 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 \\\\ 3 & 4\\end{vmatrix}i-\\begin{vmatrix}1 & 0 \\\\ 0 & 4\\end{vmatrix}j+\\begin{vmatrix}1 & 0 \\\\ 0 & 3\\end{vmatrix}k \\\\  & =(0\\cdot 4-0\\cdot 3)i-(1\\cdot 4-0\\cdot 0)j+(1\\cdot 3-0\\cdot 0)k \\\\  & =0i-4j+3k \\\\  & =⟨0,-4,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+{3}^{2}} \\\\  & =\\sqrt{0+16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\times \\mathbf{b} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 0 & 0 \\\\ 0 & 3 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}0 & 0 \\\\ 3 & 4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 0 \\\\ 0 & 4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 0 \\\\ 0 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(0\\cdot 4-0\\cdot 3)\\mathbf{i}-(1\\cdot 4-0\\cdot 0)\\mathbf{j}+(1\\cdot 3-0\\cdot 0)\\mathbf{k} \\\\  & =0\\mathbf{i}-4\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨0,-4,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{a}\\times \\mathbf{b}\\hspace{0.167em}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+{3}^{2}} \\\\  & =\\sqrt{0+16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"] [:db/cas 17592186297466 :question/problem "Calculate the area ${A}_{△}$ of the triangle spanned by $p=⟨0,5,-1⟩$ and $q=⟨6,0,1⟩.$\n\n${A}_{△}=${{field-1}}" "Calculate the area ${A}_{△}$ of the triangle spanned by $\\mathbf{p}=⟨0,5,-1⟩$ and $\\mathbf{q}=⟨6,0,1⟩.$\n\n${A}_{△}=${{field-1}}"] [:db/cas 17592186297466 :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}p\\times q & =\\begin{vmatrix}i & j & k \\\\ 0 & 5 & -1 \\\\ 6 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & -1 \\\\ 0 & 1\\end{vmatrix}i-\\begin{vmatrix}0 & -1 \\\\ 6 & 1\\end{vmatrix}j+\\begin{vmatrix}0 & 5 \\\\ 6 & 0\\end{vmatrix}k \\\\  & =(5\\cdot 1-(-1)\\cdot 0)i-(0\\cdot 1-(-1)\\cdot 6)j+(0\\cdot 0-5\\cdot 6)k \\\\  & =5i-6j-30k \\\\  & =⟨5,-6,-30⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,p\\times q\\,| \\\\  & =\\sqrt{{5}^{2}+(-6)^{2}+(-30)^{2}} \\\\  & =\\sqrt{25+36+900} \\\\  & =\\sqrt{961} \\\\  & =31.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{31}{2}.\n$$" "Using the formula, we have\n\n$$\n\\begin{aligned}\\mathbf{p}\\times \\mathbf{q} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 0 & 5 & -1 \\\\ 6 & 0 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & -1 \\\\ 0 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}0 & -1 \\\\ 6 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}0 & 5 \\\\ 6 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(5\\cdot 1-(-1)\\cdot 0)\\mathbf{i}-(0\\cdot 1-(-1)\\cdot 6)\\mathbf{j}+(0\\cdot 0-5\\cdot 6)\\mathbf{k} \\\\  & =5\\mathbf{i}-6\\mathbf{j}-30\\mathbf{k} \\\\  & =⟨5,-6,-30⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\hspace{0.167em}\\mathbf{p}\\times \\mathbf{q}\\hspace{0.167em}| \\\\  & =\\sqrt{{5}^{2}+(-6)^{2}+(-30)^{2}} \\\\  & =\\sqrt{25+36+900} \\\\  & =\\sqrt{961} \\\\  & =31.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{31}{2}.\n$$"] [:db/cas 17592186297467 :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(3i+j-k)-(i-2j) \\\\  & =2i+3j-k \\\\  & =⟨2,3,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(-i+2k)-(i-2j) \\\\  & =-2i+2j+2k \\\\  & =⟨-2,2,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & -1 \\\\ -2 & 2 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -1 \\\\ 2 & 2\\end{vmatrix}i-\\begin{vmatrix}2 & -1 \\\\ -2 & 2\\end{vmatrix}j+\\begin{vmatrix}2 & 3 \\\\ -2 & 2\\end{vmatrix}k \\\\  & =(3\\cdot 2-(-1)\\cdot 2)i-(2\\cdot 2-(-1)\\cdot (-2))j+(2\\cdot 2-3\\cdot (-2))k \\\\  & =8i-2j+10k \\\\  & =⟨8,-2,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{8}^{2}+(-2)^{2}+{10}^{2}} \\\\  & =\\sqrt{64+4+100} \\\\  & =\\sqrt{168} \\\\  & =2\\sqrt{42}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{42}}{2}=\\sqrt{42}.\n$$" "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\mathbf{q}-\\mathbf{p} \\\\  & =(3\\mathbf{i}+\\mathbf{j}-\\mathbf{k})-(\\mathbf{i}-2\\mathbf{j}) \\\\  & =2\\mathbf{i}+3\\mathbf{j}-\\mathbf{k} \\\\  & =⟨2,3,-1⟩ \\\\ \\overset{\\to }{PR} & =\\mathbf{r}-\\mathbf{p} \\\\  & =(-\\mathbf{i}+2\\mathbf{k})-(\\mathbf{i}-2\\mathbf{j}) \\\\  & =-2\\mathbf{i}+2\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨-2,2,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 3 & -1 \\\\ -2 & 2 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & -1 \\\\ 2 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ -2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 3 \\\\ -2 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 2-(-1)\\cdot 2)\\mathbf{i}-(2\\cdot 2-(-1)\\cdot (-2))\\mathbf{j}+(2\\cdot 2-3\\cdot (-2))\\mathbf{k} \\\\  & =8\\mathbf{i}-2\\mathbf{j}+10\\mathbf{k} \\\\  & =⟨8,-2,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{8}^{2}+(-2)^{2}+{10}^{2}} \\\\  & =\\sqrt{64+4+100} \\\\  & =\\sqrt{168} \\\\  & =2\\sqrt{42}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{42}}{2}=\\sqrt{42}.\n$$"] [:db/cas 17592186297468 :question/worked-solution "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =(-j)-(-2i+j+3k) \\\\  & =2i-2j-3k \\\\  & =⟨2,-2,-3⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =(2i+2j-k)-(-2i+j+3k) \\\\  & =4i+j-4k \\\\  & =⟨4,1,-4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}i & j & k \\\\ 2 & -2 & -3 \\\\ 4 & 1 & -4\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & -3 \\\\ 1 & -4\\end{vmatrix}i-\\begin{vmatrix}2 & -3 \\\\ 4 & -4\\end{vmatrix}j+\\begin{vmatrix}2 & -2 \\\\ 4 & 1\\end{vmatrix}k \\\\  & =((-2)\\cdot (-4)-(-3)\\cdot 1)i-(2\\cdot (-4)-(-3)\\cdot 4)j+(2\\cdot 1-(-2)\\cdot 4)k \\\\  & =11i-4j+10k \\\\  & =⟨11,-4,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{{11}^{2}+(-4)^{2}+{10}^{2}} \\\\  & =\\sqrt{121+16+100} \\\\  & =\\sqrt{237}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{237}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =\\mathbf{e}-\\mathbf{d} \\\\  & =(-\\mathbf{j})-(-2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k}) \\\\  & =2\\mathbf{i}-2\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨2,-2,-3⟩ \\\\ \\overset{\\to }{DF} & =\\mathbf{f}-\\mathbf{d} \\\\  & =(2\\mathbf{i}+2\\mathbf{j}-\\mathbf{k})-(-2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k}) \\\\  & =4\\mathbf{i}+\\mathbf{j}-4\\mathbf{k} \\\\  & =⟨4,1,-4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & -2 & -3 \\\\ 4 & 1 & -4\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & -3 \\\\ 1 & -4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -3 \\\\ 4 & -4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & -2 \\\\ 4 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot (-4)-(-3)\\cdot 1)\\mathbf{i}-(2\\cdot (-4)-(-3)\\cdot 4)\\mathbf{j}+(2\\cdot 1-(-2)\\cdot 4)\\mathbf{k} \\\\  & =11\\mathbf{i}-4\\mathbf{j}+10\\mathbf{k} \\\\  & =⟨11,-4,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{{11}^{2}+(-4)^{2}+{10}^{2}} \\\\  & =\\sqrt{121+16+100} \\\\  & =\\sqrt{237}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{237}}{2}.\n$$"] [:db/cas 17592186297469 :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2j-2k)-(-3i+k) \\\\  & =3i+2j-3k \\\\  & =⟨3,2,-3⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(2i-j)-(-3i+k) \\\\  & =5i-j-k \\\\  & =⟨5,-1,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}i & j & k \\\\ 3 & 2 & -3 \\\\ 5 & -1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -3 \\\\ -1 & -1\\end{vmatrix}i-\\begin{vmatrix}3 & -3 \\\\ 5 & -1\\end{vmatrix}j+\\begin{vmatrix}3 & 2 \\\\ 5 & -1\\end{vmatrix}k \\\\  & =(2\\cdot (-1)-(-3)\\cdot (-1))i-(3\\cdot (-1)-(-3)\\cdot 5)j+(3\\cdot (-1)-2\\cdot 5)k \\\\  & =-5i-12j-13k \\\\  & =⟨-5,-12,-13⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-12)^{2}+(-13)^{2}} \\\\  & =\\sqrt{25+144+169} \\\\  & =\\sqrt{338} \\\\  & =13\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{13\\sqrt{2}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{j}-2\\mathbf{k})-(-3\\mathbf{i}+\\mathbf{k}) \\\\  & =3\\mathbf{i}+2\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨3,2,-3⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(2\\mathbf{i}-\\mathbf{j})-(-3\\mathbf{i}+\\mathbf{k}) \\\\  & =5\\mathbf{i}-\\mathbf{j}-\\mathbf{k} \\\\  & =⟨5,-1,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & 2 & -3 \\\\ 5 & -1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -3 \\\\ -1 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & -3 \\\\ 5 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & 2 \\\\ 5 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot (-1)-(-3)\\cdot (-1))\\mathbf{i}-(3\\cdot (-1)-(-3)\\cdot 5)\\mathbf{j}+(3\\cdot (-1)-2\\cdot 5)\\mathbf{k} \\\\  & =-5\\mathbf{i}-12\\mathbf{j}-13\\mathbf{k} \\\\  & =⟨-5,-12,-13⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-12)^{2}+(-13)^{2}} \\\\  & =\\sqrt{25+144+169} \\\\  & =\\sqrt{338} \\\\  & =13\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{13\\sqrt{2}}{2}.\n$$"] [:db/cas 17592186297473 :question/worked-solution "Note that the length of the altitude $NP$ can be related to the area of $△\\,LMN$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,NP\\cdot LM.\n$$\n\nSo, to find $NP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2j+k)-(3i-j) \\\\  & =-3i+3j+k \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(-2i+j-k)-(3i-j) \\\\  & =-5i+2j-k \\\\  & =⟨-5,2,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}i & j & k \\\\ -3 & 3 & 1 \\\\ -5 & 2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 2 & -1\\end{vmatrix}i-\\begin{vmatrix}-3 & 1 \\\\ -5 & -1\\end{vmatrix}j+\\begin{vmatrix}-3 & 3 \\\\ -5 & 2\\end{vmatrix}k \\\\  & =(3\\cdot (-1)-1\\cdot 2)i-((-3)\\cdot (-1)-1\\cdot (-5))j+((-3)\\cdot 2-3\\cdot (-5))k \\\\  & =-5i-8j+9k \\\\  & =⟨-5,-8,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-8)^{2}+{9}^{2}} \\\\  & =\\sqrt{170}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{170}}{2}.\n$$\n\nLet's also compute $LM$ since it appears in the formula:\n\n$$\n\\begin{aligned}LM & =|\\overset{\\to }{LM}| \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{19}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,NP\\cdot LM,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,NP\\cdot LM \\\\ \\frac{\\sqrt{170}}{2} & =\\frac{1}{2}\\,NP\\cdot \\sqrt{19} \\\\ \\sqrt{170} & =NP\\cdot \\sqrt{19} \\\\ NP & =\\frac{\\sqrt{170}}{\\sqrt{19}} \\\\  & =\\frac{\\sqrt{3230}}{19}.\\end{aligned}\n$$" "Note that the length of the altitude $NP$ can be related to the area of $△\\,LMN$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,NP\\cdot LM.\n$$\n\nSo, to find $NP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(2\\mathbf{j}+\\mathbf{k})-(3\\mathbf{i}-\\mathbf{j}) \\\\  & =-3\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(-2\\mathbf{i}+\\mathbf{j}-\\mathbf{k})-(3\\mathbf{i}-\\mathbf{j}) \\\\  & =-5\\mathbf{i}+2\\mathbf{j}-\\mathbf{k} \\\\  & =⟨-5,2,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ -3 & 3 & 1 \\\\ -5 & 2 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 2 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}-3 & 1 \\\\ -5 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}-3 & 3 \\\\ -5 & 2\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot (-1)-1\\cdot 2)\\mathbf{i}-((-3)\\cdot (-1)-1\\cdot (-5))\\mathbf{j}+((-3)\\cdot 2-3\\cdot (-5))\\mathbf{k} \\\\  & =-5\\mathbf{i}-8\\mathbf{j}+9\\mathbf{k} \\\\  & =⟨-5,-8,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-8)^{2}+{9}^{2}} \\\\  & =\\sqrt{170}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{170}}{2}.\n$$\n\nLet's also compute $LM$ since it appears in the formula:\n\n$$\n\\begin{aligned}LM & =|\\overset{\\to }{LM}| \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{19}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,NP\\cdot LM,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,NP\\cdot LM \\\\ \\frac{\\sqrt{170}}{2} & =\\frac{1}{2}\\,NP\\cdot \\sqrt{19} \\\\ \\sqrt{170} & =NP\\cdot \\sqrt{19} \\\\ NP & =\\frac{\\sqrt{170}}{\\sqrt{19}} \\\\  & =\\frac{\\sqrt{3230}}{19}.\\end{aligned}\n$$"] [:db/cas 17592186297474 :question/worked-solution "Note that the length of the altitude $UT$ can be related to the area of $△\\,UVW$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,UT\\cdot VW.\n$$\n\nSo, to find $UT,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{VW} & =w-v \\\\  & =(3i-k)-(i-j+2k) \\\\  & =2i+j-3k \\\\  & =⟨2,1,-3⟩ \\\\ \\overset{\\to }{VU} & =u-v \\\\  & =(-2i+2j)-(i-j+2k) \\\\  & =-3i+3j-2k \\\\  & =⟨-3,3,-2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{VW}\\times \\overset{\\to }{VU} & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & -3 \\\\ -3 & 3 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -3 \\\\ 3 & -2\\end{vmatrix}i-\\begin{vmatrix}2 & -3 \\\\ -3 & -2\\end{vmatrix}j+\\begin{vmatrix}2 & 1 \\\\ -3 & 3\\end{vmatrix}k \\\\  & =(1\\cdot (-2)-(-3)\\cdot 3)i-(2\\cdot (-2)-(-3)\\cdot (-3))j+(2\\cdot 3-1\\cdot (-3))k \\\\  & =7i+13j+9k \\\\  & =⟨7,13,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{VW}\\times \\overset{\\to }{VU}| \\\\  & =\\sqrt{{7}^{2}+{13}^{2}+{9}^{2}} \\\\  & =\\sqrt{299}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,UVW$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{299}}{2}.\n$$\n\nLet's also compute $VW$ since it appears in the formula:\n\n$$\n\\begin{aligned}VW & =|\\overset{\\to }{VW}| \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+(-3)^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,UT\\cdot VW,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,UT\\cdot VW \\\\ \\frac{\\sqrt{299}}{2} & =\\frac{1}{2}\\,UT\\cdot \\sqrt{14} \\\\ \\sqrt{299} & =UT\\cdot \\sqrt{14} \\\\ UT & =\\frac{\\sqrt{299}}{\\sqrt{14}} \\\\  & =\\frac{\\sqrt{4186}}{14}.\\end{aligned}\n$$" "Note that the length of the altitude $UT$ can be related to the area of $△\\,UVW$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}\\,UT\\cdot VW.\n$$\n\nSo, to find $UT,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{VW} & =\\mathbf{w}-\\mathbf{v} \\\\  & =(3\\mathbf{i}-\\mathbf{k})-(\\mathbf{i}-\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}-3\\mathbf{k} \\\\  & =⟨2,1,-3⟩ \\\\ \\overset{\\to }{VU} & =\\mathbf{u}-\\mathbf{v} \\\\  & =(-2\\mathbf{i}+2\\mathbf{j})-(\\mathbf{i}-\\mathbf{j}+2\\mathbf{k}) \\\\  & =-3\\mathbf{i}+3\\mathbf{j}-2\\mathbf{k} \\\\  & =⟨-3,3,-2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{VW}\\times \\overset{\\to }{VU} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 1 & -3 \\\\ -3 & 3 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -3 \\\\ 3 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -3 \\\\ -3 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 1 \\\\ -3 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(1\\cdot (-2)-(-3)\\cdot 3)\\mathbf{i}-(2\\cdot (-2)-(-3)\\cdot (-3))\\mathbf{j}+(2\\cdot 3-1\\cdot (-3))\\mathbf{k} \\\\  & =7\\mathbf{i}+13\\mathbf{j}+9\\mathbf{k} \\\\  & =⟨7,13,9⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{VW}$ and $\\overset{\\to }{VU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{VW}\\times \\overset{\\to }{VU}| \\\\  & =\\sqrt{{7}^{2}+{13}^{2}+{9}^{2}} \\\\  & =\\sqrt{299}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,UVW$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{299}}{2}.\n$$\n\nLet's also compute $VW$ since it appears in the formula:\n\n$$\n\\begin{aligned}VW & =|\\overset{\\to }{VW}| \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+(-3)^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$\n\nFinally, using ${A}_{△}=\\frac{1}{2}\\,UT\\cdot VW,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}\\,UT\\cdot VW \\\\ \\frac{\\sqrt{299}}{2} & =\\frac{1}{2}\\,UT\\cdot \\sqrt{14} \\\\ \\sqrt{299} & =UT\\cdot \\sqrt{14} \\\\ UT & =\\frac{\\sqrt{299}}{\\sqrt{14}} \\\\  & =\\frac{\\sqrt{4186}}{14}.\\end{aligned}\n$$"] [:db/cas 17592186297475 :question/worked-solution "Note that the length of the altitude $VL$ can be related to the area of $△\\,TUV$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}VL\\cdot TU\n$$\n\nSo, to find $VL,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{TU} & =u-t \\\\  & =(3i+2j-k)-(i+k) \\\\  & =2i+2j-2k \\\\  & =⟨2,2,-2⟩ \\\\ \\overset{\\to }{TV} & =v-t \\\\  & =(-i+j)-(i+k) \\\\  & =-2i+j-k \\\\  & =⟨-2,1,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{TU}\\times \\overset{\\to }{TV} & =\\begin{vmatrix}i & j & k \\\\ 2 & 2 & -2 \\\\ -2 & 1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -2 \\\\ 1 & -1\\end{vmatrix}i-\\begin{vmatrix}2 & -2 \\\\ -2 & -1\\end{vmatrix}j+\\begin{vmatrix}2 & 2 \\\\ -2 & 1\\end{vmatrix}k \\\\  & =(2\\cdot (-1)-(-2)\\cdot 1)i-(2\\cdot (-1)-(-2)\\cdot (-2))j+(2\\cdot 1-2\\cdot (-2))k \\\\  & =0i+6j+6k \\\\  & =⟨0,6,6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{TU}\\times \\overset{\\to }{TV}| \\\\  & =\\sqrt{{0}^{2}+{6}^{2}+{6}^{2}} \\\\  & =\\sqrt{72} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,TUV$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{6\\sqrt{2}}{2}=3\\sqrt{2}.\n$$\n\nLet's also compute $TU$ since it appears in the formula:\n\n$$\n\\begin{aligned}TU & =|\\overset{\\to }{TU}| \\\\  & =\\sqrt{{2}^{2}+{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}VL\\cdot TU,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}VL\\cdot TU \\\\ 3\\sqrt{2} & =\\frac{1}{2}VL\\cdot 2\\sqrt{3} \\\\ 3\\sqrt{2} & =VL\\cdot \\sqrt{3} \\\\ VL & =\\frac{3\\sqrt{2}}{\\sqrt{3}} \\\\ VL & =\\sqrt{6}.\\end{aligned}\n$$" "Note that the length of the altitude $VL$ can be related to the area of $△\\,TUV$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}VL\\cdot TU\n$$\n\nSo, to find $VL,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{TU} & =\\mathbf{u}-\\mathbf{t} \\\\  & =(3\\mathbf{i}+2\\mathbf{j}-\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}-2\\mathbf{k} \\\\  & =⟨2,2,-2⟩ \\\\ \\overset{\\to }{TV} & =\\mathbf{v}-\\mathbf{t} \\\\  & =(-\\mathbf{i}+\\mathbf{j})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =-2\\mathbf{i}+\\mathbf{j}-\\mathbf{k} \\\\  & =⟨-2,1,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{TU}\\times \\overset{\\to }{TV} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & -2 \\\\ -2 & 1 & -1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -2 \\\\ 1 & -1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -2 \\\\ -2 & -1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ -2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot (-1)-(-2)\\cdot 1)\\mathbf{i}-(2\\cdot (-1)-(-2)\\cdot (-2))\\mathbf{j}+(2\\cdot 1-2\\cdot (-2))\\mathbf{k} \\\\  & =0\\mathbf{i}+6\\mathbf{j}+6\\mathbf{k} \\\\  & =⟨0,6,6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{TU}$ and $\\overset{\\to }{TV}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{TU}\\times \\overset{\\to }{TV}| \\\\  & =\\sqrt{{0}^{2}+{6}^{2}+{6}^{2}} \\\\  & =\\sqrt{72} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,TUV$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{6\\sqrt{2}}{2}=3\\sqrt{2}.\n$$\n\nLet's also compute $TU$ since it appears in the formula:\n\n$$\n\\begin{aligned}TU & =|\\overset{\\to }{TU}| \\\\  & =\\sqrt{{2}^{2}+{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}VL\\cdot TU,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}VL\\cdot TU \\\\ 3\\sqrt{2} & =\\frac{1}{2}VL\\cdot 2\\sqrt{3} \\\\ 3\\sqrt{2} & =VL\\cdot \\sqrt{3} \\\\ VL & =\\frac{3\\sqrt{2}}{\\sqrt{3}} \\\\ VL & =\\sqrt{6}.\\end{aligned}\n$$"] [:db/cas 17592186297477 :question/worked-solution "Note that the length of the altitude $IP$ can be related to the area of $△\\,HIJ$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}IP\\cdot HJ\n$$\n\nSo, to find $IP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ} & =j-h \\\\  & =(-2j+k)-(-i+2j) \\\\  & =i-4j+k \\\\  & =⟨1,-4,1⟩ \\\\ \\overset{\\to }{HI} & =i-h \\\\  & =(i+j+3k)-(-i+2j) \\\\  & =2i-j+3k \\\\  & =⟨2,-1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ}\\times \\overset{\\to }{HI} & =\\begin{vmatrix}i & j & k \\\\ 1 & -4 & 1 \\\\ 2 & -1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}-4 & 1 \\\\ -1 & 3\\end{vmatrix}i-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}j+\\begin{vmatrix}1 & -4 \\\\ 2 & -1\\end{vmatrix}k \\\\  & =((-4)\\cdot 3-1\\cdot (-1))i-(1\\cdot 3-1\\cdot 2)j+(1\\cdot (-1)-(-4)\\cdot 2)k \\\\  & =-11i-j+7k \\\\  & =⟨-11,-1,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{HJ}\\times \\overset{\\to }{HI}| \\\\  & =\\sqrt{(-11)^{2}+(-1)^{2}+{7}^{2}} \\\\  & =\\sqrt{171} \\\\  & =3\\sqrt{19}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,HIJ$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{19}}{2}.\n$$\n\nLet's also compute $HJ$ since it appears in the formula:\n\n$$\n\\begin{aligned}HJ & =|\\overset{\\to }{HJ}| \\\\  & =\\sqrt{{1}^{2}+(-4)^{2}+{1}^{2}} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}IP\\cdot HJ,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}IP\\cdot HJ \\\\ \\frac{3\\sqrt{19}}{2} & =\\frac{1}{2}\\,IP\\cdot 3\\sqrt{2} \\\\ \\sqrt{19} & =\\sqrt{2}\\,IP \\\\ IP & =\\frac{\\sqrt{19}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{38}}{2}.\\end{aligned}\n$$" "Note that the length of the altitude $IP$ can be related to the area of $△\\,HIJ$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}IP\\cdot HJ\n$$\n\nSo, to find $IP,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ} & =\\mathbf{j}-\\mathbf{h} \\\\  & =(-2\\mathbf{j}+\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =\\mathbf{i}-4\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,-4,1⟩ \\\\ \\overset{\\to }{HI} & =\\mathbf{i}-\\mathbf{h} \\\\  & =(\\mathbf{i}+\\mathbf{j}+3\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =2\\mathbf{i}-\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,-1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HJ}\\times \\overset{\\to }{HI} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & -4 & 1 \\\\ 2 & -1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}-4 & 1 \\\\ -1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & -4 \\\\ 2 & -1\\end{vmatrix}\\mathbf{k} \\\\  & =((-4)\\cdot 3-1\\cdot (-1))\\mathbf{i}-(1\\cdot 3-1\\cdot 2)\\mathbf{j}+(1\\cdot (-1)-(-4)\\cdot 2)\\mathbf{k} \\\\  & =-11\\mathbf{i}-\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨-11,-1,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{HJ}$ and $\\overset{\\to }{HI}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{HJ}\\times \\overset{\\to }{HI}| \\\\  & =\\sqrt{(-11)^{2}+(-1)^{2}+{7}^{2}} \\\\  & =\\sqrt{171} \\\\  & =3\\sqrt{19}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,HIJ$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{19}}{2}.\n$$\n\nLet's also compute $HJ$ since it appears in the formula:\n\n$$\n\\begin{aligned}HJ & =|\\overset{\\to }{HJ}| \\\\  & =\\sqrt{{1}^{2}+(-4)^{2}+{1}^{2}} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}IP\\cdot HJ,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}IP\\cdot HJ \\\\ \\frac{3\\sqrt{19}}{2} & =\\frac{1}{2}\\,IP\\cdot 3\\sqrt{2} \\\\ \\sqrt{19} & =\\sqrt{2}\\,IP \\\\ IP & =\\frac{\\sqrt{19}}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{38}}{2}.\\end{aligned}\n$$"] [:db/cas 17592186297486 :question/worked-solution "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =(2i+k)-(-i+2j) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =(i+3j+2k)-(-i+2j) \\\\  & =2i+j+2k \\\\  & =⟨2,1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}i & j & k \\\\ 3 & -2 & 1 \\\\ 2 & 1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ 1 & 2\\end{vmatrix}i-\\begin{vmatrix}3 & 1 \\\\ 2 & 2\\end{vmatrix}j+\\begin{vmatrix}3 & -2 \\\\ 2 & 1\\end{vmatrix}k \\\\  & =((-2)\\cdot 2-1\\cdot 1)i-(3\\cdot 2-2\\cdot 1)j+(3\\cdot 1-(-2)\\cdot 2)k \\\\  & =-5i-4j+7k \\\\  & =⟨-5,-4,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{(-5)^{2}+(-4)^{2}+{7}^{2}} \\\\  & =\\sqrt{90} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =\\mathbf{e}-\\mathbf{d} \\\\  & =(2\\mathbf{i}+\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =3\\mathbf{i}-2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{DF} & =\\mathbf{f}-\\mathbf{d} \\\\  & =(\\mathbf{i}+3\\mathbf{j}+2\\mathbf{k})-(-\\mathbf{i}+2\\mathbf{j}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+2\\mathbf{k} \\\\  & =⟨2,1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & -2 & 1 \\\\ 2 & 1 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ 1 & 2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & 1 \\\\ 2 & 2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & -2 \\\\ 2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =((-2)\\cdot 2-1\\cdot 1)\\mathbf{i}-(3\\cdot 2-2\\cdot 1)\\mathbf{j}+(3\\cdot 1-(-2)\\cdot 2)\\mathbf{k} \\\\  & =-5\\mathbf{i}-4\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨-5,-4,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{(-5)^{2}+(-4)^{2}+{7}^{2}} \\\\  & =\\sqrt{90} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$"] [:db/cas 17592186297487 :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(3i+2j)-(i-k) \\\\  & =2i+2j+k \\\\  & =⟨2,2,1⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(j+3k)-(i-k) \\\\  & =-i+j+4k \\\\  & =⟨-1,1,4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}i & j & k \\\\ 2 & 2 & 1 \\\\ -1 & 1 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 1 & 4\\end{vmatrix}i-\\begin{vmatrix}2 & 1 \\\\ -1 & 4\\end{vmatrix}j+\\begin{vmatrix}2 & 2 \\\\ -1 & 1\\end{vmatrix}k \\\\  & =(2\\cdot 4-1\\cdot 1)i-(2\\cdot 4-(-1)\\cdot 1)j+(2\\cdot 1-2\\cdot (-1))k \\\\  & =7i-9j+4k \\\\  & =⟨7,-9,4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{7}^{2}+(-9)^{2}+{4}^{2}} \\\\  & =\\sqrt{146}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{146}}{2}.\n$$" "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =\\mathbf{m}-\\mathbf{l} \\\\  & =(3\\mathbf{i}+2\\mathbf{j})-(\\mathbf{i}-\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}+\\mathbf{k} \\\\  & =⟨2,2,1⟩ \\\\ \\overset{\\to }{LN} & =\\mathbf{n}-\\mathbf{l} \\\\  & =(\\mathbf{j}+3\\mathbf{k})-(\\mathbf{i}-\\mathbf{k}) \\\\  & =-\\mathbf{i}+\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨-1,1,4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & 1 \\\\ -1 & 1 & 4\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 \\\\ 1 & 4\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & 1 \\\\ -1 & 4\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ -1 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 4-1\\cdot 1)\\mathbf{i}-(2\\cdot 4-(-1)\\cdot 1)\\mathbf{j}+(2\\cdot 1-2\\cdot (-1))\\mathbf{k} \\\\  & =7\\mathbf{i}-9\\mathbf{j}+4\\mathbf{k} \\\\  & =⟨7,-9,4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{7}^{2}+(-9)^{2}+{4}^{2}} \\\\  & =\\sqrt{146}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{146}}{2}.\n$$"] [:db/cas 17592186297489 :question/worked-solution "First, we find the vectors $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{ST} & =t-s \\\\  & =(2i+3j+k)-(j+2k) \\\\  & =2i+2j-k \\\\  & =⟨2,2,-1⟩ \\\\ \\overset{\\to }{SU} & =u-s \\\\  & =(4i+j+2k)-(j+2k) \\\\  & =4i+0j+0k \\\\  & =⟨4,0,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{ST}\\times \\overset{\\to }{SU} & =\\begin{vmatrix}i & j & k \\\\ 2 & 2 & -1 \\\\ 4 & 0 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 0 & 0\\end{vmatrix}i-\\begin{vmatrix}2 & -1 \\\\ 4 & 0\\end{vmatrix}j+\\begin{vmatrix}2 & 2 \\\\ 4 & 0\\end{vmatrix}k \\\\  & =(2\\cdot 0-(-1)\\cdot 0)i-(2\\cdot 0-(-1)\\cdot 4)j+(2\\cdot 0-2\\cdot 4)k \\\\  & =0i-4j-8k \\\\  & =⟨0,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{ST}\\times \\overset{\\to }{SU}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,STU$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{5}}{2}=2\\sqrt{5}.\n$$" "First, we find the vectors $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{ST} & =\\mathbf{t}-\\mathbf{s} \\\\  & =(2\\mathbf{i}+3\\mathbf{j}+\\mathbf{k})-(\\mathbf{j}+2\\mathbf{k}) \\\\  & =2\\mathbf{i}+2\\mathbf{j}-\\mathbf{k} \\\\  & =⟨2,2,-1⟩ \\\\ \\overset{\\to }{SU} & =\\mathbf{u}-\\mathbf{s} \\\\  & =(4\\mathbf{i}+\\mathbf{j}+2\\mathbf{k})-(\\mathbf{j}+2\\mathbf{k}) \\\\  & =4\\mathbf{i}+0\\mathbf{j}+0\\mathbf{k} \\\\  & =⟨4,0,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{ST}\\times \\overset{\\to }{SU} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 2 & 2 & -1 \\\\ 4 & 0 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & -1 \\\\ 0 & 0\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}2 & -1 \\\\ 4 & 0\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}2 & 2 \\\\ 4 & 0\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 0-(-1)\\cdot 0)\\mathbf{i}-(2\\cdot 0-(-1)\\cdot 4)\\mathbf{j}+(2\\cdot 0-2\\cdot 4)\\mathbf{k} \\\\  & =0\\mathbf{i}-4\\mathbf{j}-8\\mathbf{k} \\\\  & =⟨0,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{ST}\\times \\overset{\\to }{SU}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,STU$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{5}}{2}=2\\sqrt{5}.\n$$"] [:db/cas 17592186297491 :question/worked-solution "Note that the length of the altitude $CK$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CK\\cdot AB\n$$\n\nSo, to find $CK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i+2j+k)-(i+k) \\\\  & =3i+2j+0k \\\\  & =⟨3,2,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(2i+3j+2k)-(i+k) \\\\  & =i+3j+k \\\\  & =⟨1,3,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}i & j & k \\\\ 3 & 2 & 0 \\\\ 1 & 3 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 0 \\\\ 3 & 1\\end{vmatrix}i-\\begin{vmatrix}3 & 0 \\\\ 1 & 1\\end{vmatrix}j+\\begin{vmatrix}3 & 2 \\\\ 1 & 3\\end{vmatrix}k \\\\  & =(2\\cdot 1-0\\cdot 3)i-(3\\cdot 1-0\\cdot 1)j+(3\\cdot 3-2\\cdot 1)k \\\\  & =2i-3j+7k \\\\  & =⟨2,-3,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{2}^{2}+(-3)^{2}+{7}^{2}} \\\\  & =\\sqrt{62}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{62}}{2}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CK\\cdot AB,$ we get\n\n$$\n\\begin{aligned}\\frac{\\sqrt{62}}{2} & =\\frac{1}{2}CK\\cdot \\sqrt{13} \\\\ CK & =\\frac{\\sqrt{62}}{\\sqrt{13}} \\\\ CK & =\\frac{\\sqrt{806}}{13}.\\end{aligned}\n$$" "Note that the length of the altitude $CK$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CK\\cdot AB\n$$\n\nSo, to find $CK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\mathbf{b}-\\mathbf{a} \\\\  & =(4\\mathbf{i}+2\\mathbf{j}+\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =3\\mathbf{i}+2\\mathbf{j}+0\\mathbf{k} \\\\  & =⟨3,2,0⟩ \\\\ \\overset{\\to }{AC} & =\\mathbf{c}-\\mathbf{a} \\\\  & =(2\\mathbf{i}+3\\mathbf{j}+2\\mathbf{k})-(\\mathbf{i}+\\mathbf{k}) \\\\  & =\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,3,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & 2 & 0 \\\\ 1 & 3 & 1\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 0 \\\\ 3 & 1\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & 0 \\\\ 1 & 1\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & 2 \\\\ 1 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =(2\\cdot 1-0\\cdot 3)\\mathbf{i}-(3\\cdot 1-0\\cdot 1)\\mathbf{j}+(3\\cdot 3-2\\cdot 1)\\mathbf{k} \\\\  & =2\\mathbf{i}-3\\mathbf{j}+7\\mathbf{k} \\\\  & =⟨2,-3,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{2}^{2}+(-3)^{2}+{7}^{2}} \\\\  & =\\sqrt{62}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{62}}{2}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CK\\cdot AB,$ we get\n\n$$\n\\begin{aligned}\\frac{\\sqrt{62}}{2} & =\\frac{1}{2}CK\\cdot \\sqrt{13} \\\\ CK & =\\frac{\\sqrt{62}}{\\sqrt{13}} \\\\ CK & =\\frac{\\sqrt{806}}{13}.\\end{aligned}\n$$"] [:db/cas 17592186297492 :question/worked-solution "Note that the length of the altitude $HK$ can be related to the area of $△\\,GHI$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}HK\\cdot GI\n$$\n\nSo, to find $HK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{GI} & =i-g \\\\  & =(2i+4j+2k)-(i+j+k) \\\\  & =i+3j+k \\\\  & =⟨1,3,1⟩ \\\\ \\overset{\\to }{GH} & =h-g \\\\  & =(3i+2j+4k)-(i+j+k) \\\\  & =2i+j+3k \\\\  & =⟨2,1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{GI}\\times \\overset{\\to }{GH} & =\\begin{vmatrix}i & j & k \\\\ 1 & 3 & 1 \\\\ 2 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 1 & 3\\end{vmatrix}i-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}j+\\begin{vmatrix}1 & 3 \\\\ 2 & 1\\end{vmatrix}k \\\\  & =(3\\cdot 3-1\\cdot 1)i-(1\\cdot 3-1\\cdot 2)j+(1\\cdot 1-3\\cdot 2)k \\\\  & =8i-j-5k \\\\  & =⟨8,-1,-5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{GI}\\times \\overset{\\to }{GH}| \\\\  & =\\sqrt{{8}^{2}+(-1)^{2}+(-5)^{2}} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,GHI$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$\n\nLet's also compute $GI$ since it appears in the formula:\n\n$$\n\\begin{aligned}GI & =|\\overset{\\to }{GI}| \\\\  & =\\sqrt{{1}^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}HK\\cdot GI,$ we get\n\n$$\n\\begin{aligned}\\frac{3\\sqrt{10}}{2} & =\\frac{1}{2}HK\\cdot \\sqrt{11} \\\\ HK & =\\frac{3\\sqrt{10}}{\\sqrt{11}} \\\\ HK & =\\frac{3\\sqrt{110}}{11}.\\end{aligned}\n$$" "Note that the length of the altitude $HK$ can be related to the area of $△\\,GHI$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}HK\\cdot GI\n$$\n\nSo, to find $HK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{GI} & =\\mathbf{i}-\\mathbf{g} \\\\  & =(2\\mathbf{i}+4\\mathbf{j}+2\\mathbf{k})-(\\mathbf{i}+\\mathbf{j}+\\mathbf{k}) \\\\  & =\\mathbf{i}+3\\mathbf{j}+\\mathbf{k} \\\\  & =⟨1,3,1⟩ \\\\ \\overset{\\to }{GH} & =\\mathbf{h}-\\mathbf{g} \\\\  & =(3\\mathbf{i}+2\\mathbf{j}+4\\mathbf{k})-(\\mathbf{i}+\\mathbf{j}+\\mathbf{k}) \\\\  & =2\\mathbf{i}+\\mathbf{j}+3\\mathbf{k} \\\\  & =⟨2,1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{GI}\\times \\overset{\\to }{GH} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 1 & 3 & 1 \\\\ 2 & 1 & 3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 1 \\\\ 1 & 3\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}1 & 1 \\\\ 2 & 3\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}1 & 3 \\\\ 2 & 1\\end{vmatrix}\\mathbf{k} \\\\  & =(3\\cdot 3-1\\cdot 1)\\mathbf{i}-(1\\cdot 3-1\\cdot 2)\\mathbf{j}+(1\\cdot 1-3\\cdot 2)\\mathbf{k} \\\\  & =8\\mathbf{i}-\\mathbf{j}-5\\mathbf{k} \\\\  & =⟨8,-1,-5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{GI}\\times \\overset{\\to }{GH}| \\\\  & =\\sqrt{{8}^{2}+(-1)^{2}+(-5)^{2}} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,GHI$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$\n\nLet's also compute $GI$ since it appears in the formula:\n\n$$\n\\begin{aligned}GI & =|\\overset{\\to }{GI}| \\\\  & =\\sqrt{{1}^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}HK\\cdot GI,$ we get\n\n$$\n\\begin{aligned}\\frac{3\\sqrt{10}}{2} & =\\frac{1}{2}HK\\cdot \\sqrt{11} \\\\ HK & =\\frac{3\\sqrt{10}}{\\sqrt{11}} \\\\ HK & =\\frac{3\\sqrt{110}}{11}.\\end{aligned}\n$$"] [:db/cas 17592186297493 :question/worked-solution "Note that the length of the altitude $TK$ can be related to the area of $△\\,RST$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}TK\\cdot RS\n$$\n\nSo, to find $TK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =s-r \\\\  & =(7i+4j+5k)-(4i+5j+6k) \\\\  & =3i-j-k \\\\  & =⟨3,-1,-1⟩ \\\\ \\overset{\\to }{RT} & =t-r \\\\  & =(6i+8j+4k)-(4i+5j+6k) \\\\  & =2i+3j-2k \\\\  & =⟨2,3,-2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}i & j & k \\\\ 3 & -1 & -1 \\\\ 2 & 3 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -1 \\\\ 3 & -2\\end{vmatrix}i-\\begin{vmatrix}3 & -1 \\\\ 2 & -2\\end{vmatrix}j+\\begin{vmatrix}3 & -1 \\\\ 2 & 3\\end{vmatrix}k \\\\  & =((-1)(-2)-(-1)\\cdot 3)i-(3(-2)-(-1)\\cdot 2)j+(3\\cdot 3-(-1)\\cdot 2)k \\\\  & =5i+4j+11k \\\\  & =⟨5,4,11⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{5}^{2}+{4}^{2}+{11}^{2}} \\\\  & =\\sqrt{162} \\\\  & =9\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{9\\sqrt{2}}{2}.\n$$\n\nLet's also compute $RS$ since it appears in the formula:\n\n$$\n\\begin{aligned}RS & =|\\overset{\\to }{RS}| \\\\  & =\\sqrt{{3}^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}TK\\cdot RS,$ we get\n\n$$\n\\begin{aligned}\\frac{9\\sqrt{2}}{2} & =\\frac{1}{2}TK\\cdot \\sqrt{11} \\\\ TK & =\\frac{9\\sqrt{2}}{\\sqrt{11}} \\\\ TK & =\\frac{9\\sqrt{22}}{11}.\\end{aligned}\n$$" "Note that the length of the altitude $TK$ can be related to the area of $△\\,RST$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}TK\\cdot RS\n$$\n\nSo, to find $TK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\mathbf{s}-\\mathbf{r} \\\\  & =(7\\mathbf{i}+4\\mathbf{j}+5\\mathbf{k})-(4\\mathbf{i}+5\\mathbf{j}+6\\mathbf{k}) \\\\  & =3\\mathbf{i}-\\mathbf{j}-\\mathbf{k} \\\\  & =⟨3,-1,-1⟩ \\\\ \\overset{\\to }{RT} & =\\mathbf{t}-\\mathbf{r} \\\\  & =(6\\mathbf{i}+8\\mathbf{j}+4\\mathbf{k})-(4\\mathbf{i}+5\\mathbf{j}+6\\mathbf{k}) \\\\  & =2\\mathbf{i}+3\\mathbf{j}-2\\mathbf{k} \\\\  & =⟨2,3,-2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =\\begin{vmatrix}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ 3 & -1 & -1 \\\\ 2 & 3 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}-1 & -1 \\\\ 3 & -2\\end{vmatrix}\\mathbf{i}-\\begin{vmatrix}3 & -1 \\\\ 2 & -2\\end{vmatrix}\\mathbf{j}+\\begin{vmatrix}3 & -1 \\\\ 2 & 3\\end{vmatrix}\\mathbf{k} \\\\  & =((-1)(-2)-(-1)\\cdot 3)\\mathbf{i}-(3(-2)-(-1)\\cdot 2)\\mathbf{j}+(3\\cdot 3-(-1)\\cdot 2)\\mathbf{k} \\\\  & =5\\mathbf{i}+4\\mathbf{j}+11\\mathbf{k} \\\\  & =⟨5,4,11⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{5}^{2}+{4}^{2}+{11}^{2}} \\\\  & =\\sqrt{162} \\\\  & =9\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{9\\sqrt{2}}{2}.\n$$\n\nLet's also compute $RS$ since it appears in the formula:\n\n$$\n\\begin{aligned}RS & =|\\overset{\\to }{RS}| \\\\  & =\\sqrt{{3}^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}TK\\cdot RS,$ we get\n\n$$\n\\begin{aligned}\\frac{9\\sqrt{2}}{2} & =\\frac{1}{2}TK\\cdot \\sqrt{11} \\\\ TK & =\\frac{9\\sqrt{2}}{\\sqrt{11}} \\\\ TK & =\\frac{9\\sqrt{22}}{11}.\\end{aligned}\n$$"] [:db/cas 17592186299657 :question/problem "If $a=⟨5,1⟩$ and $b=⟨2,4⟩,$ then $a\\cdot b=${{field-1}}." "If $\\mathbf{a}=⟨5,1⟩$ and $\\mathbf{b}=⟨2,4⟩,$ then $\\mathbf{a}\\cdot \\mathbf{b}=${{field-1}}."] [:db/cas 17592186299657 :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =5\\cdot 2+1\\cdot 4 \\\\  & =10+4 \\\\  & =14.\\end{aligned}\n$$" "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =5\\cdot 2+1\\cdot 4 \\\\  & =10+4 \\\\  & =14.\\end{aligned}\n$$"] [:db/cas 17592186299658 :question/problem "If $u=⟨8,-2⟩$ and $v=⟨3,6⟩,$ then $u\\cdot v=${{field-1}}." "If $\\mathbf{u}=⟨8,-2⟩$ and $\\mathbf{v}=⟨3,6⟩,$ then $\\mathbf{u}\\cdot \\mathbf{v}=${{field-1}}."] [:db/cas 17592186299658 :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =8\\cdot 3+(-2)\\cdot 6 \\\\  & =24-12 \\\\  & =12.\\end{aligned}\n$$" "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}\\mathbf{u}\\cdot \\mathbf{v} & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =8\\cdot 3+(-2)\\cdot 6 \\\\  & =24-12 \\\\  & =12.\\end{aligned}\n$$"] [:db/cas 17592186299660 :question/problem "If $c=\\begin{bmatrix}k \\\\ 2k \\\\ 4\\end{bmatrix},$ $d=\\begin{bmatrix}-3 \\\\ 2 \\\\ 2\\end{bmatrix},$ and $c⊥d,$ then $k=${{field-1}}." "If $\\mathbf{c}=\\begin{bmatrix}k \\\\ 2k \\\\ 4\\end{bmatrix},$ $\\mathbf{d}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 2\\end{bmatrix},$ and $\\mathbf{c}⊥\\mathbf{d},$ then $k=${{field-1}}."] [:db/cas 17592186299660 :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$" "We know that $\\mathbf{c}⊥\\mathbf{d}$ ($\\mathbf{c}$ and $\\mathbf{d}$ are perpendicular) if and only if $\\mathbf{c}\\cdot \\mathbf{d}=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\\mathbf{c}\\cdot \\mathbf{d} & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}\\mathbf{c}\\cdot \\mathbf{d} & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$"] [:db/cas 17592186299664 :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$" "We know that $\\mathbf{a}⊥\\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if $\\mathbf{a}\\cdot \\mathbf{b}=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}\\mathbf{a}\\cdot \\mathbf{b} & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$"] [:db/cas 17592186299664 :question/problem "Let $a=⟨2{x}^{2},-4⟩$ and $b=⟨8,4⟩.$ If $a⊥b$ and $x>0,$ then $x=${{field-1}}." "Let $\\mathbf{a}=⟨2{x}^{2},-4⟩$ and $\\mathbf{b}=⟨8,4⟩.$ If $\\mathbf{a}⊥\\mathbf{b}$ and $x>0,$ then $x=${{field-1}}."] [:db/cas 17592186299701 :question/problem "Suppose $|\\,k\\,|=2\\sqrt{2}$ and the angle between vectors $k$ and $l$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $k$ onto $l.$\n\n${\\text{comp}}_{l}\\,k=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{k}\\hspace{0.167em}|=2\\sqrt{2}$ and the angle between vectors $\\mathbf{k}$ and $\\mathbf{l}$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $\\mathbf{k}$ onto $\\mathbf{l}.$\n\n${\\text{comp}}_{\\mathbf{l}}\\hspace{0.167em}\\mathbf{k}=$\n{{field-1}}"] [:db/cas 17592186299701 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{l}\\,k & =|\\,k\\,|\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡({120}^{∘}) \\\\  & =2\\sqrt{2}\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{l}}\\hspace{0.167em}\\mathbf{k} & =|\\hspace{0.167em}\\mathbf{k}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}({120}^{∘}) \\\\  & =2\\sqrt{2}\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$"] [:db/cas 17592186299702 :question/problem "Suppose $|\\,r\\,|=10$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|=10$ and the angle between vectors $\\mathbf{r}$ and $\\mathbf{s}$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $\\mathbf{r}$ onto $\\mathbf{s}.$\n\n${\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r}=$\n{{field-1}}"] [:db/cas 17592186299702 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10cos\\,\\left(\\frac{2\\pi }{3}\\right) \\\\  & =10\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-5.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r} & =|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =10cos\\hspace{-0.167em}\\left(\\frac{2\\pi }{3}\\right) \\\\  & =10\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-5.\\end{aligned}\n$$"] [:db/cas 17592186299703 :question/problem "Suppose $|\\,p\\,|=8$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|=8$ and the angle between vectors $\\mathbf{p}$ and $\\mathbf{q}$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}.$\n\n${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}=$\n{{field-1}}"] [:db/cas 17592186299703 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8cos\\,\\left(\\frac{\\pi }{6}\\right) \\\\  & =8\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =8cos\\hspace{-0.167em}\\left(\\frac{\\pi }{6}\\right) \\\\  & =8\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$"] [:db/cas 17592186299704 :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,\\left(\\frac{3\\pi }{4}\\right) \\\\  & =\\sqrt{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-1.\\end{aligned}\n$$" "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{u}}\\hspace{0.167em}\\mathbf{t} & =|\\hspace{0.167em}\\mathbf{t}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =\\sqrt{2}cos\\hspace{-0.167em}\\left(\\frac{3\\pi }{4}\\right) \\\\  & =\\sqrt{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\  & =-1.\\end{aligned}\n$$"] [:db/cas 17592186299704 :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{t}\\hspace{0.167em}|=\\sqrt{2}$ and the angle between vectors $\\mathbf{t}$ and $\\mathbf{u}$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $\\mathbf{t}$ onto $\\mathbf{u}.$\n\n${\\text{comp}}_{\\mathbf{u}}\\hspace{0.167em}\\mathbf{t}=$\n{{field-1}}"] [:db/cas 17592186299705 :question/problem "Suppose $|\\,r\\,|=3\\sqrt{3}$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" "Suppose $|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|=3\\sqrt{3}$ and the angle between vectors $\\mathbf{r}$ and $\\mathbf{s}$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $\\mathbf{r}$ onto $\\mathbf{s}.$\n\n${\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r}=$\n{{field-1}}"] [:db/cas 17592186299705 :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{3}cos\\,\\left(\\frac{\\pi }{2}\\right) \\\\  & =3\\sqrt{3}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$" "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r} & =|\\hspace{0.167em}\\mathbf{r}\\hspace{0.167em}|\\operatorname{cos}\\theta  \\\\  & =3\\sqrt{3}cos\\hspace{-0.167em}\\left(\\frac{\\pi }{2}\\right) \\\\  & =3\\sqrt{3}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"] [:db/cas 17592186299706 :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(4)(1)+(-1)(2)+(1)(2)}{\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{4-2+2}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(4)(1)+(-1)(2)+(1)(2)}{\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{4-2+2}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"] [:db/cas 17592186299706 :question/problem "Let $p=⟨4,-1,1⟩$ and $q=⟨1,2,2⟩.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" "Let $\\mathbf{p}=⟨4,-1,1⟩$ and $\\mathbf{q}=⟨1,2,2⟩.$ Find the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}.$\n\n${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}=$\n{{field-1}}"] [:db/cas 17592186299707 :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"] [:db/cas 17592186299707 :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" "Let $\\mathbf{a}=⟨3,-2,1⟩$ and $\\mathbf{b}=⟨2,1,-2⟩.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$\n\n${\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}=$\n{{field-1}}"] [:db/cas 17592186299708 :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r} & =\\frac{\\mathbf{r}\\cdot \\mathbf{s}}{|\\hspace{0.167em}\\mathbf{s}\\hspace{0.167em}|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$"] [:db/cas 17592186299708 :question/problem "Let $r=⟨-1,2,3⟩$ and $s=⟨2,0,0⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" "Let $\\mathbf{r}=⟨-1,2,3⟩$ and $\\mathbf{s}=⟨2,0,0⟩.$ Find the scalar projection of $\\mathbf{r}$ onto $\\mathbf{s}.$\n\n${\\text{comp}}_{\\mathbf{s}}\\hspace{0.167em}\\mathbf{r}=$\n{{field-1}}"] [:db/cas 17592186299709 :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{n}}\\hspace{0.167em}\\mathbf{m} & =\\frac{\\mathbf{m}\\cdot \\mathbf{n}}{|\\hspace{0.167em}\\mathbf{n}\\hspace{0.167em}|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{m}}\\hspace{0.167em}\\mathbf{n} & =\\frac{\\mathbf{m}\\cdot \\mathbf{n}}{|\\hspace{0.167em}\\mathbf{m}\\hspace{0.167em}|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{n}}\\hspace{0.167em}\\mathbf{m}-{\\text{comp}}_{\\mathbf{m}}\\hspace{0.167em}\\mathbf{n} & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$"] [:db/cas 17592186299709 :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" "Let $\\mathbf{m}=⟨6,8,0⟩$ and $\\mathbf{n}=⟨0,5,12⟩.$ Find ${\\text{comp}}_{\\mathbf{n}}\\hspace{0.167em}\\mathbf{m}-{\\text{comp}}_{\\mathbf{m}}\\hspace{0.167em}\\mathbf{n}.$\n\n${\\text{comp}}_{\\mathbf{n}}\\hspace{0.167em}\\mathbf{m}-{\\text{comp}}_{\\mathbf{m}}\\hspace{0.167em}\\mathbf{n}=$\n{{field-1}}"] [:db/cas 17592186299710 :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" "Let $\\mathbf{p}=⟨9,12,0⟩$ and $\\mathbf{q}=⟨0,3,4⟩.$ Find ${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}-{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q}.$\n\n${\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}-{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q}=$\n{{field-1}}"] [:db/cas 17592186299710 :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{q}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{\\mathbf{p}\\cdot \\mathbf{q}}{|\\hspace{0.167em}\\mathbf{p}\\hspace{0.167em}|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{q}}\\hspace{0.167em}\\mathbf{p}-{\\text{comp}}_{\\mathbf{p}}\\hspace{0.167em}\\mathbf{q} & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"] [:db/cas 17592186299726 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$" "Since $\\mathbf{p}$ is a nonzero vector, its scalar projection onto another nonzero vector $\\mathbf{q}$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\n\\mathbf{p}⊥\\mathbf{q}\\hspace{2em}⟹\\hspace{2em}\\mathbf{p}\\cdot \\mathbf{q}=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}\\mathbf{p}\\cdot \\mathbf{q} & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$"] [:db/cas 17592186299726 :question/problem "Let $p=⟨3,-1,2⟩$ and $q=⟨x,1,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "Let $\\mathbf{p}=⟨3,-1,2⟩$ and $\\mathbf{q}=⟨x,1,1⟩.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}"] [:db/cas 17592186299731 :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "Let $\\mathbf{p}=⟨4,1,-2⟩$ and $\\mathbf{q}=⟨1,x,3⟩.$ Given that the scalar projection of $\\mathbf{p}$ onto $\\mathbf{q}$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}"] [:db/cas 17592186299731 :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}