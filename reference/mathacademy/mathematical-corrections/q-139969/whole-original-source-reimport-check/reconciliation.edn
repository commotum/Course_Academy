\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=0+1+1=2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/state.json" "file_sha256" "ce9b68f635c51e00917f68e2fd3eece137cc866428907b1aa168dfb2bf1adeee" "basis" 2301 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/edb-import/verification.json"} {"question" "q-35316" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/activity-metadata.json" "file_sha256" "a5606ebf5f1faebbaffe824e7acbab6e7e461c64b72d4531435a2c3f726ca433" "basis" 2301 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/edb-import/verification.json"} {"question" "q-35316" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/state.json" "file_sha256" "ce9b68f635c51e00917f68e2fd3eece137cc866428907b1aa168dfb2bf1adeee" "basis" 2301 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/edb-import/verification.json"} {"question" "q-35316" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/state.json" "file_sha256" "ce9b68f635c51e00917f68e2fd3eece137cc866428907b1aa168dfb2bf1adeee" "basis" 2301 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068410/edb-import/verification.json"} {"question" "q-35316" "field" "selection" "attribute" "answer/value" "v