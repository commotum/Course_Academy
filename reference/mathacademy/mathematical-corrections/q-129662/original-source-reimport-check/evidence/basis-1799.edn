#{[{:db/id #edb/ref 17592186331255 :knowledge-point/_questions [{:knowledge-point/id #uuid "624215ff-efdc-5b12-8d61-9d66371672d9" :knowledge-point/title "Determining a Valid Region to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2542da32-68a0-53b6-942d-775aa8ee5e18" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186331257} {:answer/id #uuid "7c9717b4-bda6-5c16-a872-3c9e68626b63" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186331258} {:answer/id #uuid "3259c574-de60-518d-a827-76ca7d1eede2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186331259} {:answer/id #uuid "f1b65101-f209-53bc-8d2f-89f6870f9f61" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186331260} {:answer/id #uuid "cf6991b4-a0e1-5ded-a9c6-13ebdc588d70" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186331261}] :answer-field/correct {:answer/id #uuid "f1b65101-f209-53bc-8d2f-89f6870f9f61" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186331260} :answer-field/id #uuid "89bdd7b3-e81b-5841-b327-977245177885" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331256}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ed9e0959-13d6-5a2f-89f1-9c5d4089fd43" :question/math-academy-id "q-129662" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{9}+{y}^{2}=1.$ If \n\n$$\nf(x,y)={\\begin{aligned}9-{x}^{2}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}(9-{x}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nRequire $D\\subseteq R$, so the rectangle contains the entire region. Which of the following could be the definition of the rectangular domain $R?$\n\n- $R=[-3,3]\\times [-1,1]$\n- $R=[-4,4]\\times [-1,1]$\n- $R=[-3,3]\\times [0,2]$" :question/worked-solution "The ellipse $x^2/9+y^2\\le1$ has horizontal extent $[-3,3]$ and vertical extent $[-1,1]$. Rectangles I and II both contain this entire bounding box and thus all of $D$. Rectangle III excludes $(0,-1)$, so it does not contain all of $D$.\n\nOn either containing rectangle, $f=9-x^2$ on $D$ and zero on $R\\setminus D$. Consequently $\\iint_R f\\,dA=\\iint_D(9-x^2)\\,dA$. The answer is \"I and II only\"."}]}
