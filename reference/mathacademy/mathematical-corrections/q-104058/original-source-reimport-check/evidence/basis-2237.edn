#{[{:db/id #edb/ref 17592186354860 :knowledge-point/_questions [{:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473" :knowledge-point/title "Finding Particular Solutions of Differential Equations by First Rearranging and Then Separating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3499a528-3b5b-5342-a45f-58ae5606f8f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|={x}^{2}" :db/id #edb/ref 17592186354862} {:answer/id #uuid "13e70303-6e01-5cc5-bb94-b26acfeeebfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|+y=2{x}^{2}+2" :db/id #edb/ref 17592186354863} {:answer/id #uuid "b7b648b8-3bba-5404-bcfd-aefa9938d0b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|+y={x}^{2}+2" :db/id #edb/ref 17592186354864} {:answer/id #uuid "6024ef2e-28f1-5f1a-b820-5f13c5c76835" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|-y={x}^{2}-2" :db/id #edb/ref 17592186354865} {:answer/id #uuid "83146c73-c536-5451-b0e3-e6238f76276e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|-y=2{x}^{2}-2" :db/id #edb/ref 17592186354866}] :answer-field/correct {:answer/id #uuid "6024ef2e-28f1-5f1a-b820-5f13c5c76835" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|-y={x}^{2}-2" :db/id #edb/ref 17592186354865} :answer-field/id #uuid "921db6b7-2b72-5413-ada5-2ba6ae2de3c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354861}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f1428f3d-5054-5866-8041-e9c9eed9b449" :question/math-academy-id "q-104058" :question/problem "Find the particular solution to the differential equation $(\\frac{1}{xy}-\\frac{1}{x})\\frac{\\text{d}y}{\\text{d}x}=2$ that satisfies $y(1)=1.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}(\\frac{1}{xy}-\\frac{1}{x})\\frac{\\text{d}y}{\\text{d}x} & =2 \\\\ \\frac{1}{x}(\\frac{1}{y}-1)\\frac{\\text{d}y}{\\text{d}x} & =2 \\\\ (\\frac{1}{y}-1)\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ \\int (\\frac{1}{y}-1)\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y|-y & ={x}^{2}+C.\\end{aligned}\n$$\n\nWe now apply the initial condition $y(1)=1$ to find $C:$\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|1|-1 & ={1}^{2}+C \\\\ 0-1 & =1+C \\\\ C & =-2\\,.\\end{aligned}\n$$\n\nThus the particular solution of $(\\frac{1}{xy}-\\frac{1}{x})\\frac{\\text{d}y}{\\text{d}x}=2$ that satisfies the condition $y(1)=1$ in implicit form is\n\n$$\n\\operatorname{ln}⁡|y|-y={x}^{2}-2\\,.\n$$"}]}
