#{[{:db/id #edb/ref 17592186357000 :knowledge-point/_questions [{:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142" :knowledge-point/title "Finding a Level Surface of a Function Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8743c70-1eb7-5ec4-8bb9-4c34fe99a98a" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357002} {:answer/id #uuid "b2899bac-97db-5f57-b481-a04587b7e4b3" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\operatorname{cos}⁡xy" :db/id #edb/ref 17592186357003} {:answer/id #uuid "7c8c531f-b4c8-5d4a-9e6a-35f135f5ddbe" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pi -\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357004} {:answer/id #uuid "1c93ce09-8f59-5716-b3af-4b54a575dad3" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡xy" :db/id #edb/ref 17592186357005} {:answer/id #uuid "2e938519-b510-510d-94e1-c33aec43b04b" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357006}] :answer-field/correct {:answer/id #uuid "1c93ce09-8f59-5716-b3af-4b54a575dad3" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡xy" :db/id #edb/ref 17592186357005} :answer-field/id #uuid "d76830ff-d00f-56aa-9d9d-e9f2e9fc3065" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357001}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e3e19cf1-1438-5521-a704-9195b3cd730a" :question/math-academy-id "q-37131" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=xy+\\operatorname{arcsin}⁡z$ that passes through the point $P(0,1,1).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(0,1,1) & =0\\cdot 1+\\operatorname{arcsin}⁡(1)=\\frac{\\pi }{2}\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=\\frac{\\pi }{2}.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ xy+\\operatorname{arcsin}⁡z & =\\frac{\\pi }{2} \\\\ \\operatorname{arcsin}⁡z & =\\frac{\\pi }{2}-xy \\\\ z & =\\operatorname{sin}⁡(\\frac{\\pi }{2}-xy) \\\\ z & =\\operatorname{cos}⁡xy\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(0,1,1)$ is the surface $z=\\operatorname{cos}⁡xy.$"}]}
