#{[{:db/id #edb/ref 17592186356987 :knowledge-point/_questions [{:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489" :knowledge-point/title "Describing a Level Surface of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc89d93a-f650-5673-8db9-773c021bc91f" :answer/type {:db/ident :answer.type/text} :answer/value "A family of elliptic paraboloids: $z=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c$" :db/id #edb/ref 17592186356989} {:answer/id #uuid "bdcd5190-eaef-5b64-bd6c-a01857fc73b1" :answer/type {:db/ident :answer.type/text} :answer/value "A family of elliptic paraboloids: $z=-4{x}^{2}-9{y}^{2}+3+\\operatorname{ln}⁡c$" :db/id #edb/ref 17592186356990} {:answer/id #uuid "bf7146f5-d291-572f-9a8e-ea3d0423858a" :answer/type {:db/ident :answer.type/text} :answer/value "A family of surfaces: $z=\\operatorname{ln}⁡(4{x}^{2}+9{y}^{2}-3-c)$" :db/id #edb/ref 17592186356991} {:answer/id #uuid "49c71707-d07d-50a5-8cd5-8e64cc34a1f5" :answer/type {:db/ident :answer.type/text} :answer/value "A family of surfaces: $z=\\operatorname{ln}⁡(4{x}^{2}+9{y}^{2}-3)+c$" :db/id #edb/ref 17592186356992} {:answer/id #uuid "7f36be23-457b-50fb-b93f-741d67d40eb7" :answer/type {:db/ident :answer.type/text} :answer/value "A family of hyperboloids of two sheets: ${z}^{2}=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c$" :db/id #edb/ref 17592186356993}] :answer-field/correct {:answer/id #uuid "cc89d93a-f650-5673-8db9-773c021bc91f" :answer/type {:db/ident :answer.type/text} :answer/value "A family of elliptic paraboloids: $z=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c$" :db/id #edb/ref 17592186356989} :answer-field/id #uuid "fb381f8a-4bea-53df-91b1-08b8ff021513" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356988}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "252dccd1-3816-5e56-9b75-ae474230a890" :question/math-academy-id "q-129199" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)={e}^{4{x}^{2}+9{y}^{2}-z-3}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {e}^{4{x}^{2}+9{y}^{2}-z-3} & =c \\\\ 4{x}^{2}+9{y}^{2}-z-3 & =\\operatorname{ln}⁡c \\\\ z & =4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c,\\end{aligned}\n$$\n\nwhere $c>0.$\n\nTherefore, we get a family of elliptic paraboloids:\n\n$$\nz=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c,\\,c\\in (0,\\infty )\n$$"}] [{:db/id #edb/ref 17592186129536 :knowledge-point/_questions [{:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489" :knowledge-point/title "Describing a Level Surface of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ad949d-4d2e-56aa-84fc-128f042e9a4c" :answer/type {:db/ident :answer.type/text} :answer/value "A family of spheres centered at $(0,0,{e}^{-1})$" :db/id #edb/ref 17592186356995} {:answer/id #uuid "8760143c-d921-5b2b-b6ac-21e7470de4c3" :answer/type {:db/ident :answer.type/text} :answer/value "A family of spheres centered at $(0,0,e)$" :db/id #edb/ref 17592186356996} {:answer/id #uuid "4dc7fe16-21b8-5e01-b76d-1c688bcf3c89" :answer/type {:db/ident :answer.type/text} :answer/value "A family of spheres centered at the origin" :db/id #edb/ref 17592186356997} {:answer/id #uuid "67290681-9872-5ba5-89b3-941d47ec4615" :answer/type {:db/ident :answer.type/text} :answer/value "A family of surfaces given by  ${z}^{2}+c={x}^{2}+{y}^{2}$ for $c>0$" :db/id #edb/ref 17592186356998} {:answer/id #uuid "5e460968-e353-588b-8bdd-a7ff65ccde11" :answer/type {:db/ident :answer.type/text} :answer/value "A family of surfaces given by ${z}^{2}+c={x}^{2}+{y}^{2}$ for $c\\ne 0$" :db/id #edb/ref 17592186356999}] :answer-field/correct {:answer/id #uuid "4dc7fe16-21b8-5e01-b76d-1c688bcf3c89" :answer/type {:db/ident :answer.type/text} :answer/value "A family of spheres centered at the origin" :db/id #edb/ref 17592186356997} :answer-field/id #uuid "356be647-ae8c-5506-a2f3-4a2451b5dd03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356994}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a64b6d6-ab0a-5726-932f-2f26ae11023b" :question/math-academy-id "q-36342" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)={e}^{-{x}^{2}-{y}^{2}-{z}^{2}}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {e}^{-{x}^{2}-{y}^{2}-{z}^{2}} & =c \\\\ -{x}^{2}-{y}^{2}-{z}^{2} & =\\operatorname{ln}⁡c \\\\ {x}^{2}+{y}^{2}+{z}^{2} & =-\\operatorname{ln}⁡c\\end{aligned}\n$$\n\nNotice that $0<c\\le 1$ since $-\\operatorname{ln}⁡c$ must be non-negative. If we let $-\\operatorname{ln}⁡c={r}^{2},$ we get\n\n$$\n{x}^{2}+{y}^{2}+{z}^{2}={r}^{2}.\n$$\n\nTherefore, the level surfaces form a family of spheres centered at the origin."}] [{:db/id #edb/ref 17592186357000 :knowledge-point/_questions [{:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142" :knowledge-point/title "Finding a Level Surface of a Function Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8743c70-1eb7-5ec4-8bb9-4c34fe99a98a" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357002} {:answer/id #uuid "b2899bac-97db-5f57-b481-a04587b7e4b3" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\operatorname{cos}⁡xy" :db/id #edb/ref 17592186357003} {:answer/id #uuid "7c8c531f-b4c8-5d4a-9e6a-35f135f5ddbe" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pi -\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357004} {:answer/id #uuid "1c93ce09-8f59-5716-b3af-4b54a575dad3" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡xy" :db/id #edb/ref 17592186357005} {:answer/id #uuid "2e938519-b510-510d-94e1-c33aec43b04b" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{sin}⁡xy" :db/id #edb/ref 17592186357006} {:answer/id #uuid "edbdadbd-4697-59bf-985c-9065cd719ac6" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\cos(xy),\\quad 0\\le xy\\le\\pi" :db/id #edb/ref 17592186357022}] :answer-field/correct {:answer/id #uuid "edbdadbd-4697-59bf-985c-9065cd719ac6" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\cos(xy),\\quad 0\\le xy\\le\\pi" :db/id #edb/ref 17592186357022} :answer-field/id #uuid "6ce0ae16-eae7-50e8-8ea5-58dac8da8c7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357021}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e3e19cf1-1438-5521-a704-9195b3cd730a" :question/math-academy-id "q-37131" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=xy+\\operatorname{arcsin}⁡z$ that passes through the point $P(0,1,1).$\n\nGive the full level set, including the necessary range restriction from the principal real arcsine.\n\nHint: Compute $f(0,1,1)$, then use the principal range $-\\pi/2\\le\\arcsin z\\le\\pi/2$ before taking sine." :question/worked-solution "The level surface through $P=(0,1,1)$ has level constant\n$$c=f(0,1,1)=0+\\arcsin(1)=\\frac{\\pi}{2}.$$\nThus $xy+\\arcsin z=\\pi/2$, or $\\arcsin z=\\pi/2-xy$. The principal real arcsine takes values in $[-\\pi/2,\\pi/2]$. Therefore\n$$-\\frac{\\pi}{2}\\le\\frac{\\pi}{2}-xy\\le\\frac{\\pi}{2}\\quad\\Longleftrightarrow\\quad 0\\le xy\\le\\pi.$$\nTaking sine gives $z=\\sin(\\pi/2-xy)=\\cos(xy)$. Conversely, if $0\\le xy\\le\\pi$ and $z=\\cos(xy)$, then $\\pi/2-xy$ lies in the principal arcsine range, so $\\arcsin z=\\pi/2-xy$ and $f(x,y,z)=\\pi/2$. The exact full level set is\n$$\\boxed{\\{(x,y,z)\\in\\mathbb R^3:z=\\cos(xy),\\ 0\\le xy\\le\\pi\\}}.$$\nThe range restriction is essential. For instance $(x,y,z)=(2\\pi,1,1)$ satisfies $z=\\cos(xy)$, but $f(2\\pi,1,1)=2\\pi+\\pi/2=5\\pi/2$, not $\\pi/2$. The source's revealed answer a provides the algebraic relation but omits the restriction. Its original prompt, options, source grade and solution remain preserved; the study choice supplies the complete level set without changing the original function or point."}] [{:db/id #edb/ref 17592186357007 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4" :knowledge-point/title "Finding the Equation of a Level Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ba6e191-43d8-5547-b6d0-94e14aafed93" :answer/type {:db/ident :answer.type/math} :answer/value "z=x-y+2" :db/id #edb/ref 17592186357009} {:answer/id #uuid "bb53c6fc-f3a7-5348-aa34-74d8b978b88f" :answer/type {:db/ident :answer.type/math} :answer/value "z=x+y+1" :db/id #edb/ref 17592186357010} {:answer/id #uuid "7d16788d-ca1b-504e-88df-a4c3da7e4151" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\frac{1}{x+y-1}" :db/id #edb/ref 17592186357011} {:answer/id #uuid "0b114a20-d15d-5381-acc8-70cc1ab0618d" :answer/type {:db/ident :answer.type/math} :answer/value "z=x+y+2" :db/id #edb/ref 17592186357012} {:answer/id #uuid "d307c0a9-2630-56f5-9a70-0a9e9289c484" :answer/type {:db/ident :answer.type/math} :answer/value "z=-x-y-1" :db/id #edb/ref 17592186357013}] :answer-field/correct {:answer/id #uuid "0b114a20-d15d-5381-acc8-70cc1ab0618d" :answer/type {:db/ident :answer.type/math} :answer/value "z=x+y+2" :db/id #edb/ref 17592186357012} :answer-field/id #uuid "d14de792-7989-5c5a-9522-c3dfd65b9bda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357008}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e388c922-dab9-5bf6-870c-17599df704f0" :question/math-academy-id "q-71574" :question/problem "For the function $f(x,y,z)=z-x-y-1,$ find the equation of the level surface $f(x,y,z)=1.$" :question/worked-solution "The level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ z-x-y-1 & =1 \\\\ z & =x+y+2\\end{aligned}\n$$\n\nTherefore, the level surface for $c=1$ is the plane $z=x+y+2.$"}] [{:db/id #edb/ref 17592186357014 :knowledge-point/_questions [{:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142" :knowledge-point/title "Finding a Level Surface of a Function Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3793a2-fe4a-5725-99d7-031958909144" :answer/type {:db/ident :answer.type/math} :answer/value "z=(x-y)^{2}" :db/id #edb/ref 17592186357016} {:answer/id #uuid "ed9be010-ebc4-5754-95a3-77841972757d" :answer/type {:db/ident :answer.type/math} :answer/value "z={x}^{2}+2xy-{y}^{2}" :db/id #edb/ref 17592186357017} {:answer/id #uuid "451901a1-42ae-5cfb-9d27-7c947c9b5508" :answer/type {:db/ident :answer.type/math} :answer/value "z={y}^{2}+2xy-{x}^{2}" :db/id #edb/ref 17592186357018} {:answer/id #uuid "feb0774e-3d4b-5a90-8d59-dd78831bc49b" :answer/type {:db/ident :answer.type/math} :answer/value "z={x}^{2}-2xy-{y}^{2}" :db/id #edb/ref 17592186357019} {:answer/id #uuid "979ddc9b-cad0-56cf-8004-a82ef13bd803" :answer/type {:db/ident :answer.type/math} :answer/value "z=(x+y)^{2}" :db/id #edb/ref 17592186357020}] :answer-field/correct {:answer/id #uuid "ed9be010-ebc4-5754-95a3-77841972757d" :answer/type {:db/ident :answer.type/math} :answer/value "z={x}^{2}+2xy-{y}^{2}" :db/id #edb/ref 17592186357017} :answer-field/id #uuid "932e4ba5-543a-518f-8a15-dc35af72beff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357015}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5c696959-b72e-5102-9ec4-acc967980567" :question/math-academy-id "q-71593" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=\\frac{z-{x}^{2}+{y}^{2}}{xy}$ that passes through the point $P(1,1,2).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(1,1,2) & =\\frac{(2)-(1)^{2}+(1)^{2}}{(1)(1)}=2\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=2.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{z-{x}^{2}+{y}^{2}}{xy} & =2 \\\\ z-{x}^{2}+{y}^{2} & =2xy \\\\ z & ={x}^{2}+2xy-{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(1,1,2)$ is the surface $z={x}^{2}+2xy-{y}^{2}.$"}]}
