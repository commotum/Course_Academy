#{[{:db/id #edb/ref 17592186360804 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fae74f18-853a-5710-9dc9-d9f14d105b95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\pi -\\sqrt{3})" :db/id #edb/ref 17592186360806} {:answer/id #uuid "47caf0c6-c2e2-542f-a94c-15b9db3ddb84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}-\\frac{\\pi }{3})" :db/id #edb/ref 17592186360807} {:answer/id #uuid "0eaf434b-c8a7-521f-91da-406c51252b38" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}-\\pi " :db/id #edb/ref 17592186360808} {:answer/id #uuid "623a7141-d94a-5d42-8263-2b090887d144" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186360809} {:answer/id #uuid "1f5a6900-a291-5084-94b1-36e25017c628" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}+\\pi )" :db/id #edb/ref 17592186360810}] :answer-field/correct {:answer/id #uuid "623a7141-d94a-5d42-8263-2b090887d144" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186360809} :answer-field/id #uuid "873de911-186f-5b87-889c-bbe068ce98d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360805}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "1c3855bf-1622-5d3d-847f-9d7c74379538" :question/math-academy-id "q-132894" :question/problem "Find ${g}_{xx}(x,y)-{g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3})$ given that ${g}_{x}(x,y)=x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)$ and ${g}_{y}(x,y)=x\\operatorname{sin}⁡(x+y).$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)) \\\\  & =\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)+\\operatorname{sin}⁡(x+y) \\\\  & =2\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡(x+y)) \\\\  & =x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})+\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6} \\\\ {g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3})-{g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6}-(-\\frac{\\pi }{6})=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186360811 :knowledge-point/_questions [{:knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7711932b-125e-5d2c-94e1-24e735a181e1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186360813} {:answer/id #uuid "354a7545-e85e-59df-b65d-d2eefb2ac3ea" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186360814} {:answer/id #uuid "2528ed8a-e6b9-5549-896f-9cc56b700eb0" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186360815} {:answer/id #uuid "142d340b-0f5a-5abf-932b-039c8dc51fb6" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186360816} {:answer/id #uuid "1bae5314-0108-50bb-97e6-13d0524a8345" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186360817}] :answer-field/correct {:answer/id #uuid "142d340b-0f5a-5abf-932b-039c8dc51fb6" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186360816} :answer-field/id #uuid "0008eab6-b6ff-5522-9bc3-18ed3af8ed73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360812}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "130ad7f8-2367-56d1-afed-1995cee8fbfb" :question/math-academy-id "q-132984" :question/problem "Evaluate $\\lim_{z\\to1,\\ z\\ne1}f_{xyz}(-1,2,z)$ for $f(x,y,z)=x^3y^2z^2-\\frac{3}{\\ln z}$, defined on $z>0$, $z\\ne1$." :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({z}^{2}{x}^{3}{y}^{2}-\\frac{3}{\\operatorname{ln}⁡z}) \\\\  & =3{x}^{2}{y}^{2}{z}^{2}\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(3{x}^{2}{y}^{2}{z}^{2}) \\\\  & =6{x}^{2}y{z}^{2}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(6{x}^{2}y{z}^{2}) \\\\  & =12{x}^{2}yz\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(-1,2,1):$\n\n$$\n\\begin{aligned}{f}_{xyz}(-1,2,1) & =12(-1)^{2}(2)(1)=24\\end{aligned}\n$$\n\nDomain clarification: the original function is undefined at $z=1$, since $\\ln1=0$. Consequently the literal value $f_{xyz}(-1,2,1)$ in the source prompt is undefined. The derivatives above are valid on $z>0$, $z\\ne1$; there $f_x=3x^2y^2z^2$, $f_{xy}=6x^2yz^2$, and $f_{xyz}=12x^2yz$. Thus $f_{xyz}(-1,2,z)=24z$ and\n$$\\lim_{z\\to1,\\ z\\ne1}f_{xyz}(-1,2,z)=24.$$\nThe clarified study question explicitly asks for this limit, or continuous extension of the derivative, so the source's accepted answer $24$ and all original choices remain valid. This extension does not define the original function or its literal derivative at the excluded point."}] [{:db/id #edb/ref 17592186360818 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4e310da-fbab-5cf7-91ee-fd80803c69ba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360820} {:answer/id #uuid "e2c57dc7-2cb0-58ad-8793-c754bbdade0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360821} {:answer/id #uuid "294d9d73-fd6b-5737-bd43-44ba4b029f06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x-y}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360822} {:answer/id #uuid "1116da51-0686-53ac-a717-2a805f4c806f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360823} {:answer/id #uuid "5d2ccb86-60ad-528e-8451-25f1cc986782" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{-(x+y)}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360824}] :answer-field/correct {:answer/id #uuid "1116da51-0686-53ac-a717-2a805f4c806f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360823} :answer-field/id #uuid "d4b7b212-9858-5d6a-84ea-83c0249caacb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360819}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e753edf8-58fc-597a-9f65-e842d6000549" :question/math-academy-id "q-80403" :question/problem "Find ${f}_{xx}(x,y)+{f}_{yy}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{y}{{x}^{2}+{y}^{2}}$ and ${f}_{y}(x,y)=\\frac{x}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find ${f}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{y}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot (-\\frac{2x}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot (-\\frac{2y}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xx}(x,y)+{f}_{yy}(x,y) & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360825 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f7463d3-4943-5427-bf00-7470889d4589" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}+2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360827} {:answer/id #uuid "1019a7de-92e0-5bdf-8255-87b8fc565c77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(y-x)^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360828} {:answer/id #uuid "db3b5d12-dc5a-547b-8500-5dc2feaddd81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360829} {:answer/id #uuid "0f3b6c73-0448-5b76-bec8-2a617ac85bdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}-2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360830} {:answer/id #uuid "25ca5469-ae2c-5f0c-b653-d96a7de34d1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360831}] :answer-field/correct {:answer/id #uuid "0f3b6c73-0448-5b76-bec8-2a617ac85bdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}-2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186360830} :answer-field/id #uuid "e8c5eea7-ca30-59de-a7cf-969d82fbcdc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360826}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8c97e120-e555-59c4-8223-d7d466a7bcd8" :question/math-academy-id "q-80469" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{x}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot (-\\frac{2y}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{1}{{x}^{2}+{y}^{2}}-\\frac{x}{({x}^{2}+{y}^{2})^{2}}\\cdot 2x \\\\  & =\\frac{{x}^{2}+{y}^{2}-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}} \\\\  & =\\frac{{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}+\\frac{{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}} \\\\  & =\\frac{{y}^{2}-2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360832 :knowledge-point/_questions [{:knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfef15c8-dd5d-5e20-a358-9ff8c6c86bee" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}y\\operatorname{sin}⁡(xy)" :db/id #edb/ref 17592186360834} {:answer/id #uuid "7d8b7507-4166-5ec8-8ae0-a5c68714a672" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186360835} {:answer/id #uuid "0fb61e81-4ba0-5aae-9d6f-d8580ebb0072" :answer/type {:db/ident :answer.type/math} :answer/value "-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186360836} {:answer/id #uuid "bb02b69f-f5d7-5aad-894b-342e32fb4cc5" :answer/type {:db/ident :answer.type/math} :answer/value "-x\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186360837} {:answer/id #uuid "ed3e785d-cdf8-5c84-b8d0-78b6bbd8cdce" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{sin}⁡(xy)-xy\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186360838}] :answer-field/correct {:answer/id #uuid "0fb61e81-4ba0-5aae-9d6f-d8580ebb0072" :answer/type {:db/ident :answer.type/math} :answer/value "-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)" :db/id #edb/ref 17592186360836} :answer-field/id #uuid "34ec01b2-3288-5a6b-b361-cd1da6ec3772" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360833}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "80238c18-8486-5149-b928-3f5a200b3672" :question/math-academy-id "q-80474" :question/problem "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡(xy).$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy)) \\\\  & =x\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nNext, we find ${f}_{yy}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡(xy)) \\\\  & =-{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nFinally, we find ${f}_{yyx}(x,y)$ by differentiating ${f}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yyx}(x,y) & =\\frac{∂}{∂x}({f}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-{x}^{2}\\operatorname{sin}⁡(xy)) \\\\  & =-2x\\cdot \\operatorname{sin}⁡(xy)-{x}^{2}\\cdot \\operatorname{cos}⁡(xy)\\cdot y \\\\  & =-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)\\end{aligned}\n$$"}]}
