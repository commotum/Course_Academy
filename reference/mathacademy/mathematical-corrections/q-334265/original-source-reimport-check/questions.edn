#{[{:db/id #edb/ref 17592186332130 :knowledge-point/_questions [{:knowledge-point/id #uuid "aac5cb30-5659-547e-bedf-921f6c99067a" :knowledge-point/title "Finding the General Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408d1fd2-c8b8-5666-ab93-1e62a5837a20" :answer/type {:db/ident :answer.type/math} :answer/value "y={c}^{2}x+7c" :db/id #edb/ref 17592186332132} {:answer/id #uuid "f31f574e-4b81-5f25-942a-3f092b39c937" :answer/type {:db/ident :answer.type/math} :answer/value "y=cx+7{c}^{2}" :db/id #edb/ref 17592186332133} {:answer/id #uuid "d07d1777-4202-56e4-b247-805f90e02249" :answer/type {:db/ident :answer.type/math} :answer/value "y=cx+7" :db/id #edb/ref 17592186332134} {:answer/id #uuid "abae75ab-64c2-501e-a440-d4b163e2878f" :answer/type {:db/ident :answer.type/math} :answer/value "y={c}^{2}x-7c" :db/id #edb/ref 17592186332135} {:answer/id #uuid "211c21e1-0df4-52d5-bb9d-8282ba386d94" :answer/type {:db/ident :answer.type/math} :answer/value "y=cx-7c" :db/id #edb/ref 17592186332136}] :answer-field/correct {:answer/id #uuid "211c21e1-0df4-52d5-bb9d-8282ba386d94" :answer/type {:db/ident :answer.type/math} :answer/value "y=cx-7c" :db/id #edb/ref 17592186332136} :answer-field/id #uuid "46bfeada-20cb-5d64-b402-78d8a130158e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332131}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "618dbf12-e8c4-5dd6-9a3f-db361be015f7" :question/math-academy-id "q-334265" :question/problem "Find the general solution of the Clairaut differential equation:\n\n$$\ny=x{y}^{′}-7{y}^{′}.\n$$" :question/worked-solution "To solve the Clairaut differential equation\n\n$$\ny=x{y}^{′}-7{y}^{′},\n$$\n\nwe start by setting\n$p={y}^{′}.$\n\nSubstituting this into the equation gives\n\n$$\ny=xp-7p.\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}{y}^{′} & ={(xp-7p)}^{′} \\\\ p & =p+x{p}^{′}-7{p}^{′} \\\\ 0 & ={p}^{′}(x-7)\\end{aligned}\n$$\n\nThe product on the right-hand side equals zero, which means at least one of the factors must be zero.\n\nThe general solution of the Clairaut differential equation is obtained if ${p}^{′}=0.$ Then, $p$ is constant, say \n\n$$\np=c.\n$$\n\nSubstituting $p=c$ into $y=xp-7p,$ we get the general solution\n\n$$\ny=cx-7c.\n$$\n\nThis represents a family of straight lines, one line for each constant value of $c.$"}]}
