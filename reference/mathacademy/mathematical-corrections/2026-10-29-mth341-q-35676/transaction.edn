alpha \\beta )\\mathbf{y}} \\\\ {\\color{black}\\text{[A3]}}:{\\color{blue}\\mathbf{y}+\\mathbf{0}=\\mathbf{y}} & {\\color{black}\\text{[A7]}}:{\\color{blue}(\\alpha +\\beta )\\mathbf{y}=\\alpha \\mathbf{y}+\\beta \\mathbf{y}} \\\\ {\\color{black}\\text{[A4]}}:{\\color{blue}\\mathbf{y}+(-\\mathbf{y})=\\mathbf{0}} & {\\color{black}\\text{[A8]}}:{\\color{blue}\\alpha (\\mathbf{x}+\\mathbf{y})=\\alpha \\mathbf{x}+\\alpha \\mathbf{y}}\\end{array}\n$$"] [:db/cas 17592186649877 :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:*\n\n*If $y$ is a vector such that $x+y=x$ for some $x\\in V$, then $y=0.$*\n\n*Proof:*\n\n$$\n\\begin{aligned}x+y & =x &  & [\\,\\text{given}\\,] \\\\ (x+y)+(-x) & =x+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (y+x)+(-x) & =x+(-x) &  & [\\,\\text{axiom A1}\\,\\,] \\\\ y+(x+(-x)) & =x+(-x) &  & [\\,\\text{axiom __}\\,] \\\\ y+0 & =0 &  & [\\,\\text{axiom __}\\,] \\\\ y & =0 &  & [\\,\\text{axiom A3}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:*\n\n*If $y$ is a vector such that $x+y=x$ for some $x\\in V$, then $y=0.$*\n\n*Proof:*\n\n$$\n\\begin{aligned}x+y & =x &  & [\\,\\text{given}\\,] \\\\ (x+y)+(-x) & =x+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (y+x)+(-x) & =x+(-x) &  & [\\,\\text{axiom A1}\\,\\,] \\\\ y+(x+(-x)) & =x+(-x) &  & [\\,\\text{axiom __}\\,] \\\\ y+0 & =0 &  & [\\,\\text{axiom __}\