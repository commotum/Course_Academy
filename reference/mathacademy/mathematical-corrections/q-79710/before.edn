#{[{:db/id #edb/ref 17592186354979 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a962d5e-5cc9-530e-9f95-85c399af7e4b" :knowledge-point/title "Determining the Decoupling Substitution of a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aba063f-68f3-54ea-8159-9de3326c4244" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186354981} {:answer/id #uuid "dfd6f81a-e323-57f7-b4c5-91be57463d75" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 3 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186354982} {:answer/id #uuid "c3823b39-f9d1-59e4-b3e6-8a6a17d06a4c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186354983} {:answer/id #uuid "0d711c1a-0e4e-5193-a390-12b390a3c8da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186354984} {:answer/id #uuid "9eea97d7-cc62-5fb4-abf2-4ca9858210bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186354985}] :answer-field/correct {:answer/id #uuid "c3823b39-f9d1-59e4-b3e6-8a6a17d06a4c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186354983} :answer-field/id #uuid "4d7b0bca-2eb1-5822-9229-910cf3f64e31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354980}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "56774d2b-76f9-551f-b926-8c1400b9f917" :question/math-academy-id "q-79710" :question/problem "Let ${v}_{1}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}]$ be eigenvectors of a matrix $A.$ Find the decoupling matrix of the differential equation ${x}^{′}(t)=Ax(t).$" :question/worked-solution "First, we construct the matrix $E$, whose columns are the eigenvectors ${v}_{1}$ and ${v}_{2}:$\n\n$$\nE=[\\begin{aligned}1 & -3 \\\\ -1 & 2\\end{aligned}]\n$$\n\nNow, the decoupling matrix can be found as follows:\n\n$$\n\\begin{aligned}D & ={E}^{-1} \\\\  & ={[\\begin{aligned}1 & -3 \\\\ -1 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{1\\cdot 2-(-1)\\cdot (-3)}[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ -1 & -1\\end{aligned}]\\end{aligned}\n$$"}]}
