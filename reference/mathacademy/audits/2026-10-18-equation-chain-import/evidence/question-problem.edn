n=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{2t}$</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [#edb/ref 17592186305035 "$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=3{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-3{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\right.\\,x(0)=\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution\n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{1}{2s}+\\frac{7}{2(s-4)},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{3}{2s}-\\frac{7}{2(s-4)}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{4t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |"] [#edb/ref 17592186305036 "$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=3{x}_{1}(t)-3{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-3{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\right.\\,x(0)=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{4}{s}+\\frac{1}{s-6},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{4}{s}-\\frac{1}{s-6}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{6t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |"] [#edb/ref 17592186305037 "$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=5{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-5{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\right.\\,x(0)=\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{1}{s}+\\frac{4}{s-6},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{5}{s}-\\frac{4}{s-6}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$x(t)=\\,\\,$\n</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$\\,\\,+\\,\\,$\n</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n$\\,\\,{e}^{6t}$\n</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [#edb/ref 17592186305052 "Find the general solution to the system of differential equations\n$\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=2{x}_{1}(t) \\\\ {x}_{2}^{′}(t) &=-5{x}_{2}(t).\\end{aligned}\\right.$"] [#edb/ref 17592186305060 "$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+5{x}_{2}(t)+9{e}^{t} \\\\ {x}_{2}^{′}(t) &=4{x}_{1}(t)-{x}_{2}(t)+7{e}^{2t}\\end{aligned}\\right.\n$$\n\nThe system of linear ODEs above can be written in matrix form as follows:\n\n| ${x}^{′}(t)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,\\,x(t)+{e}^{t}\\,\\,$ |  | {{field-3}} |  |  | $\\,\\,+\\,{e}^{2t}\\,\\,$ |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- 