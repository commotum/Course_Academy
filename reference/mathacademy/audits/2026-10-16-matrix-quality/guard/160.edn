#{[{:db/id #edb/ref 17592186162347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "976a4a72-c37c-506f-8c55-c4643e65d8f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186159285} {:answer/id #uuid "d05656b4-08f5-52a1-80b8-ebc2dc7acd0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186159286} {:answer/id #uuid "e2a2efff-b722-5275-881d-f5320c78e3f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}-1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186159287} {:answer/id #uuid "42c672a2-61fd-58a4-85fb-5d92f67e5d84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186159288} {:answer/id #uuid "5b3e1ace-1fd2-5bdb-9adc-9cb9f1cb22f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186159289}] :answer-field/id #uuid "02ff52b1-991a-5bd8-8eff-61e11d9f4ae8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159284} {:answer-field/choices [{:answer/id #uuid "8acbd8c4-454c-5cb5-94b9-d2aef97a621d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186388500} {:answer/id #uuid "75bf6dcd-27e1-51e1-9f05-562eca4510ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186388501} {:answer/id #uuid "40b0edcc-0018-569c-9262-9bafdea8027f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186388502} {:answer/id #uuid "497dedca-2b4d-5208-9852-250645f33ff3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}-1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388503} {:answer/id #uuid "f2982666-7310-5da9-a646-3f4db7db597d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388504}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388504} :answer-field/id #uuid "c89488db-78bd-5cd5-94ff-8b1d3c72f02c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388499}] :question/id #uuid "b188c8ba-9da1-5dcf-b3ec-58cacd9ddb5b" :question/math-academy-id "q-136991" :question/problem "For the matrix \n$A=\\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix},$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "For an \"almost\" zero $m\\times n$ matrix with non-zero entries \n\n$$\n{\\sigma }_{1},\\,{\\sigma }_{2},\\,…,\\,{\\sigma }_{r}\n$$\n\non the main diagonal, the corresponding pseudoinverse is the \"almost\" zero $n\\times m$ matrix with entries \n\n$$\n{\\sigma }_{1}^{-1},\\,{\\sigma }_{2}^{-1},\\,…,\\,{\\sigma }_{r}^{-1}\n$$\n\non the main diagonal.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}{A}^{+} & ={\\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}}^{+} \\\\  & =\\begin{bmatrix}{3}^{-1} & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91bac979-c3d6-587b-9e0b-37dae19db297" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -2 \\\\ 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186159357} {:answer/id #uuid "c7ce847b-d79f-533b-b94a-3c520c287a67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}-1 & 1 \\\\ -2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186159358} {:answer/id #uuid "2cfdaddc-ceeb-5ac6-9249-bf4576f4b04c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & 1 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186159359} {:answer/id #uuid "643270bc-1570-5371-a7e1-efbd3eceade0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186159360} {:answer/id #uuid "759e9be3-488f-5b86-a58e-42d742bcc618" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}2 & -1 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186159361}] :answer-field/id #uuid "66c9b4d8-6610-57b4-be00-4fde019b2393" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159356} {:answer-field/choices [{:answer/id #uuid "222a8b2d-6567-55f3-a7b7-a0ec0324bdda" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & 1 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186371805} {:answer/id #uuid "12a45f6e-8ac4-5f44-bd7a-194f811965f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}-1 & 1 \\\\ -2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186371806} {:answer/id #uuid "108e5756-3514-5763-a24e-bf5ecafed318" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -2 \\\\ 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186371807} {:answer/id #uuid "811b95ae-51c6-569f-8ad3-02d215fdc025" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186371808} {:answer/id #uuid "f7b55d22-14a6-575e-97a4-57fe12f0d8b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}2 & -1 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186371809}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186371808} :answer-field/id #uuid "69e124c6-5e8d-5d2a-98ef-899e8525e8f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371804}] :question/id #uuid "40e6735e-d054-576f-846f-84bde633ad42" :question/math-academy-id "q-138622" :question/problem "$$\n{U}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,{Σ}_{r}=\\begin{bmatrix}\\sqrt{10}\\end{bmatrix},\\,{V}_{r}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{Σ}_{r}^{+}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1\\end{bmatrix},\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{10}}\\begin{bmatrix}1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c95d292b-b5d0-5097-a485-bcbedcb99071" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186161085} {:answer/id #uuid "cf435087-776e-5b47-9397-a41eb7fdb830" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186161086} {:answer/id #uuid "ecf02d81-6e1e-572d-a106-67f4f6532836" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186161087} {:answer/id #uuid "040f1313-e21c-514f-9c2e-75dfb47837fa" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186161088} {:answer/id #uuid "39e03b5b-87da-5c0f-a60a-40325e38f947" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}-1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186161089}] :answer-field/id #uuid "ed668d09-a90d-5725-a6ce-1892307a482f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161084} {:answer-field/choices [{:answer/id #uuid "d40f64db-c375-5eb5-90f5-65b7daa42137" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186404708} {:answer/id #uuid "2a5211a6-75f4-56a1-852c-872334169c7d" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186404709} {:answer/id #uuid "2889008a-1c9c-54e0-a4b6-94388ce56e86" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186404710} {:answer/id #uuid "8bacece9-6f5a-5672-9ede-4dd465de3062" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P=\\begin{bmatrix}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186404711} {:answer/id #uuid "1e966e11-c1da-51bf-87aa-b05920c029f3" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186404712}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186404708} :answer-field/id #uuid "3b952b55-79e1-55e1-ba57-d64596ae665f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404707}] :question/id #uuid "1587eada-a2ce-573f-9e77-1eddebc42115" :question/math-academy-id "q-94454" :question/problem "Given the quadratic form $Q(x)=-{x}_{1}^{2}-4{x}_{1}{x}_{2}-{x}_{2}^{2},$ find its canonical (diagonal) form ${y}^{T}\\,Dy$ and an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables." :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-1 & -2 \\\\ -2 & -1\\end{bmatrix}\n$$\n\nEvery quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nTo find the coefficients of the canonical form, we need to calculate the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}-1-\\lambda  & -2 \\\\ -2 & -1-\\lambda \\end{vmatrix} & =0 \\\\ {\\lambda }^{2}+2\\lambda -3 & =0 \\\\ \\lambda  & =1,\\,-3\\end{aligned}\n$$\n\n \n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=1,$ we have\n\n$$\n\\begin{aligned}A-1I & =\\begin{bmatrix}-1 & -2 \\\\ -2 & -1\\end{bmatrix}-1\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & -2 \\\\ -2 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-1I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=-3,$ we have\n\n$$\n\\begin{aligned}A-(-3)I & =\\begin{bmatrix}-1 & -2 \\\\ -2 & -1\\end{bmatrix}-(-3)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -2 \\\\ -2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-3)I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, we construct the diagonal matrix $D$ (writing the eigenvalues in descending order) and the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix},\\,P=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93afd1e7-589c-572d-81e8-cd95c2c7e1a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161091} {:answer/id #uuid "b5ead3be-52cb-51bc-a4ec-b140d0258480" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{bmatrix}" :db/id #edb/ref 17592186161092} {:answer/id #uuid "ca5ddbfb-38cf-5614-b107-bae7c3df3a66" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161093} {:answer/id #uuid "2ce52d2a-928e-513a-97af-4fe0bcce819b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186161094} {:answer/id #uuid "5809b31c-60e6-5689-a138-5e6ee5628d38" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186161095}] :answer-field/id #uuid "a39de5df-822b-5722-89ab-814c839cfed2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161090} {:answer-field/choices [{:answer/id #uuid "a042fc8f-539f-5bdb-bddf-c5fe30041a80" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186394978} {:answer/id #uuid "6dc77117-300e-5b56-8c2f-140816b1741a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186394979} {:answer/id #uuid "1b8d7eed-8c68-5288-bf38-d8900425c601" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186394980} {:answer/id #uuid "e217cdf1-3dc8-57d9-9626-db83e92641ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{bmatrix}" :db/id #edb/ref 17592186394981} {:answer/id #uuid "97cc3ca7-68d4-575c-b995-c7ff1f31637d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186394982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{bmatrix}" :db/id #edb/ref 17592186394981} :answer-field/id #uuid "d94e720f-93b6-56f5-a9cd-79db4928f0b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394977}] :question/id #uuid "7f0148f4-83df-5e99-8325-e264016c452b" :question/math-academy-id "q-94461" :question/problem "$$\nA=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{bmatrix},\\,D=\\begin{bmatrix}10 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=10,\\,$ ${\\lambda }_{2}=5,\\,$ and $\\,{\\lambda }_{3}=3.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{bmatrix}-10\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-7 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{bmatrix}-5\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & 4 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{3}=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{bmatrix}-3\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 6 & 2 \\\\ 0 & 2 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector ${v}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=1,$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=\\begin{bmatrix}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc8877a5-3ad2-52bb-a064-0496ec64af0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0\\end{bmatrix}" :db/id #edb/ref 17592186161217} {:answer/id #uuid "de86953f-2dc6-5b88-b2b6-6650bf357093" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161218} {:answer/id #uuid "2fb9df63-3e91-5305-ab66-7239c594b50a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161219} {:answer/id #uuid "463dc66e-e8fb-5326-b371-3f4a5d8ec9cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161220} {:answer/id #uuid "698774d3-bbc4-5952-8a59-a504e856805c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161221}] :answer-field/id #uuid "72d9a893-e9aa-5f30-88df-e785d8b3a106" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161216} {:answer-field/choices [{:answer/id #uuid "927834b7-3d18-5db5-abab-f666bc5af8f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186394998} {:answer/id #uuid "26af6070-1f6f-51b7-9850-35fb204fd9fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186394999} {:answer/id #uuid "64bcd310-100e-5d4a-9083-894659694caa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395000} {:answer/id #uuid "79ebf064-b4d2-5fc0-acb8-3c83ecd66e17" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0\\end{bmatrix}" :db/id #edb/ref 17592186395001} {:answer/id #uuid "fd8de7cc-e082-5310-94db-9f5a79a7e15a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395002}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186394998} :answer-field/id #uuid "bbd2f1c2-56b9-525a-98ce-2d7df8ee2c78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394997}] :question/id #uuid "00c817da-6580-5c3d-a2f1-9c059dd42da6" :question/math-academy-id "q-95095" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix},\\,D=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=4,\\,$ ${\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=-2.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=4,$ we have\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-3 & 0 & -3 \\\\ 0 & -3 & 0 \\\\ -3 & 0 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}-\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 & -3 \\\\ 0 & 0 & 0 \\\\ -3 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}3 & 0 & -3 \\\\ 0 & 3 & 0 \\\\ -3 & 0 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88817c4f-c3b9-56bc-adcd-03c60a03192d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161559} {:answer/id #uuid "ab726398-a6bf-5ccb-8b76-7638be326bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161560} {:answer/id #uuid "b6527ce3-e389-5aaa-b56f-28b8e5cb3b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186161561} {:answer/id #uuid "192d7516-f9d8-5c3c-923d-9aea265083e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161562} {:answer/id #uuid "70c54196-2e1b-509b-a193-ae9743cdbb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161563}] :answer-field/id #uuid "7b64cb77-d8a8-5314-8588-5996a0ed2a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161558} {:answer-field/choices [{:answer/id #uuid "fcbb2747-c859-5f45-8d0d-7a05c9e1438c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} {:answer/id #uuid "3a523ac3-cde3-56a8-a0ad-d2ed6c685448" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395272} {:answer/id #uuid "0bc93829-a56e-5c44-b5e8-b1f6a5b14a09" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186395273} {:answer/id #uuid "b256bcc9-0977-57b1-a4d8-3631bdea12e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395274} {:answer/id #uuid "38bfef24-5630-5d56-928e-7a0c767b17da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395275}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} :answer-field/id #uuid "1d6fa282-78f2-5e39-89f3-9b4093833ea4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395270}] :question/id #uuid "e4c01100-25ba-535e-8cf2-008c4f230608" :question/math-academy-id "q-97364" :question/problem "$$\nA=\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 & -2 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=2.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=9,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-9I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-9\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-9I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=4,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-4I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-4I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fd0fef2-41cf-5b78-ab4f-6f03d4dacfd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161643} {:answer/id #uuid "17be549c-a1c7-5060-987e-c5b65ac2b51a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161644} {:answer/id #uuid "3bcd3583-93e7-5a4f-bd1e-dbffb277553f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186161645} {:answer/id #uuid "56db7078-0264-534f-afb4-fd027ef181b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186161646} {:answer/id #uuid "6402e77e-c348-5104-b7eb-d18e02ab6813" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161647}] :answer-field/id #uuid "a8478cb6-55ac-5ba0-aa86-521b99077edf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161642} {:answer-field/choices [{:answer/id #uuid "e50a614d-fd6f-55be-9356-ebb15749bb1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382663} {:answer/id #uuid "f1a31908-a2f5-584e-8101-a70a1d5408a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382664} {:answer/id #uuid "5fa7355e-413d-5cfe-860d-bd5a74b01f14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382665} {:answer/id #uuid "d2048545-37eb-5154-98fb-fbdc70936239" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186382666} {:answer/id #uuid "a3ccc71c-705b-55f1-bd7a-216a4ecad2d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186382667}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186382667} :answer-field/id #uuid "601494e0-9a29-5b8f-8afd-34cbf959efa1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382662}] :question/id #uuid "dcd0e8b8-71e5-5dcd-a370-0847d15e9434" :question/math-academy-id "q-98797" :question/problem "$$\nA=\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=4.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{8}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-\\frac{4}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{3\\sqrt{2}}{x}_{1}+\\frac{4}{3\\sqrt{2}}{x}_{2}-\\frac{1}{3\\sqrt{2}}{x}_{3} &=0 \\\\ -\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2}-{x}_{3} &=0 \\\\ -{x}_{1}+{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & \\frac{2}{3} \\\\ \\frac{4}{3\\sqrt{2}} & 0 & \\frac{1}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & \\frac{2}{3}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186163228 :tutorial/content "A quadratic form is said to be in its **canonical form** if it does not contain any cross-product terms ($x_i x_j$ where $i \\neq j$). \n\nWith that in mind, which of the following quadratic forms are given in their canonical forms?\n\nI. - $P(\\mathbf{x})=x_1^2-2x_2^2$\nII. - $Q(\\mathbf{x})=x_1^2+2x_1x_3+x_2^2$\n\nLet's examine our quadratic forms in turn.\n\n- $P(\\mathbf{x})$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $Q(\\mathbf{x})$ is *not* in canonical form since it contains the cross-product term $2x_1x_3.$\n\nIn terms of matrix representation \n\n$$\n\\mathbf{x}^T \\! A \\mathbf{x},\n$$\n\n we have a canonical form if the corresponding matrix $A$ is diagonal.\n\nFor example, which of the following quadratic forms are given in their canonical forms?\n\nI. - $R(\\mathbf{x})=\\mathbf{x}^T \\! A \\mathbf{x},$ where $\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}$\nII. - $S(\\mathbf{x})=\\mathbf{x}^T \\! A \\mathbf{x},$ where $\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}$\n\nExamining our quadratic forms, we obtain the following.\n\n- $R(\\mathbf{x})$ is in canonical form. Indeed, its corresponding matrix is diagonal.\n\n- $S(\\mathbf{x})$ is *not* in canonical form since its corresponding matrix is not diagonal." :tutorial/id #uuid "eb4d92c4-a9c0-52b7-8ba2-5603a1793519" :tutorial/math-academy-id 4886 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186163270 :tutorial/content "We can generate new matrices by composing Jordan blocks.\n\nFor instance, suppose we have the following Jordan blocks:\n\n$$\n\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}\n$$\n\nTheir composition is a block diagonal matrix that can be written as follows:\n\n$$\n\\begin{aligned}3 & 1 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -5\\end{aligned}\n$$\n\nWe can compose more than two Jordan blocks. For example, if\n\n$$\n\\begin{bmatrix}-1\\end{bmatrix}\n$$\n\nthen the composition of these Jordan blocks is given by\n\n$$\n\\begin{aligned}-1 & 0 & 0 & 0 \\\\ 0 & 4 & 1 & 0 \\\\ 0 & 0 & 4 & 0 \\\\ 0 & 0 & 0 & 2\\end{aligned}\n$$\n\nMatrices that are formed by composing Jordan blocks are called **Jordan matrices**." :tutorial/id #uuid "1c5e2723-f0b0-5357-a28b-5ef8ca27600d" :tutorial/math-academy-id 5437 :tutorial/title "Compositions of Jordan Blocks"}] [{:db/id #edb/ref 17592186163277 :tutorial/content "Let's now consider Jordan canonical forms of $3 \\times 3$ matrices.\n\nLet $A$ be a $3\\times 3$ matrix. The simplest case is when $A$ has three distinct eigenvalues, say $\\lambda_1, \\lambda_2,$ and  $\\lambda_3.$ In this case, $A$ must be diagonalizable. Therefore, the Jordan canonical form of $A$ is\n\n$$\n\\begin{bmatrix}{\\lambda }_{1} & 0 & 0 \\\\ 0 & {\\lambda }_{2} & 0 \\\\ 0 & 0 & {\\lambda }_{3}\\end{bmatrix}\n$$\n\nFor example, consider the matrix\n\n$$\n\\begin{bmatrix}7 & 1 & -4 \\\\ 8 & 0 & 2 \\\\ 4 & -4 & 9\\end{bmatrix}\n$$\n\nThis matrix has eigenvalues $\\lambda_1=8,$ $\\lambda_2=5,$ and $\\lambda_3=3.$ Therefore, its Jordan canonical form is\n\n$$\n\\begin{bmatrix}8 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nRemember that a Jordan canonical form of a matrix is unique up to the order of the Jordan blocks." :tutorial/id #uuid "6659f1d2-f6c2-5a21-815e-c72ad939472d" :tutorial/math-academy-id 5464 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186163278 :tutorial/content "Let's now consider the matrix $A,$ given by\n\n$$\n\\begin{bmatrix}4 & 3 & 1 \\\\ 1 & 6 & 1 \\\\ 6 & -7 & 9\\end{bmatrix}\n$$\n\nThe characteristic equation of $A$ is given by\n\n$$\n(\\lambda-8)^2(\\lambda - 3) = 0.\n$$\n\nTherefore, this matrix has only two distinct eigenvalues, namely,\n\n- $\\lambda=8$ of algebraic multiplicity $2,$ and\n\n- $\\lambda=3$ of algebraic multiplicity $1.$\n\nHow can we find its Jordan canonical form?\n\nIn this example, we have one $1 \\times 1$ Jordan block $J_1(3)$ corresponding to $\\lambda=3.$\nHowever, there are two possibilities for the Jordan blocks corresponding to $\\lambda=8{:}$\n\n- *Case I.* We may get the single $2 \\times 2$ Jordan block $J_2(8).$ This happens when the generalized eigenvectors $\\mathbf v_1$ and $\\mathbf v_2$ corresponding to the eigenvalue $\\lambda=8$ form the following chain:\n\n$$\n\\mathbf{v}_2 \\xrightarrow{A-8I} \\mathbf{v}_1 \\xrightarrow{A-8I} \\mathbf{0}\n$$\n\n- *Case II.* We may get a composition of two $1 \\times 1$ Jordan blocks, namely $J_1(8) {\\:\\oplus\\:} J_1(8).$ This happens when the generalized eigenvectors $\\mathbf v_1$ and $\\mathbf v_2$ corresponding to the eigenvalue $\\lambda=8$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{1}\\overset{A-8I\\,}{\\to }0 &  \\\\ {v}_{2}\\overset{A-8I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we obtain in this situation, let's find the number of linearly independent eigenvectors corresponding to $\\lambda=8.$\n\nComputing $A-8I,$ we get\n\n$$\n\\begin{aligned}A-8I & =\\begin{bmatrix}4 & 3 & 1 \\\\ 1 & 6 & 1 \\\\ 6 & -7 & 9\\end{bmatrix}-8\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & 3 & 1 \\\\ 1 & -2 & 1 \\\\ 6 & -7 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A-8I & =\\begin{bmatrix}-4 & 3 & 1 \\\\ 1 & -2 & 1 \\\\ 6 & -7 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}\\leftrightarrow {R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ -4 & 3 & 1 \\\\ 6 & -7 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+4{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-6){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & -5 & 5 \\\\ 0 & 5 & -5\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & -5 & 5 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince $\\text{nullity}(A-8I)=1,$ there will be only one eigenvector that corresponds to the eigenvalue $\\lambda=8,$ say, $\\mathbf{v}_1.$ So, the generalized eigenvectors corresponding to the eigenvalue $\\lambda=8$ form the following chain: \n\n$$\n\\mathbf{v}_2 \\xrightarrow{A-8I} \\mathbf{v}_1 \\xrightarrow{A-8I} \\mathbf{0}\n$$\n\nTherefore, we have *case I*, and $A$ has the following Jordan canonical form:\n\n$$\n\\begin{bmatrix}8 & 1 & 0 \\\\ 0 & 8 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nAs always, the Jordan canonical form is unique up to the order of the Jordan blocks." :tutorial/id #uuid "630b8bf4-5ce6-5f2a-ac92-8ba6290b80ed" :tutorial/math-academy-id 5465 :tutorial/title "Jordan Canonical Forms of 3x3 Matrices That Have Two Distinct Eigenvalues"}] [{:db/id #edb/ref 17592186166545 :question/id #uuid "a38dad3a-1afd-5e97-9046-87e413574865" :question/math-academy-id "e-21642" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-8x(t) \\\\ {y}^{′}(t) &=-8y(t)\\end{aligned}\\right.\n$$\n\nSketch the phase portrait of the linear system above." :question/worked-solution "Writing our system in matrix form, we have\n![](images/73/737c96109e65d59f4df2c2fa574737fe604483fe4ccc9772a3d2bf22ee32e55a.svg)\nwhere ![](images/22/22dbda7d3b169206071e5af49fd1fe1af28d86ef1e0a8b37d58eacb62b44c1d2.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=-8$ with the corresponding eigenvectors $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ and ![](images/5b/5bd691bbaa9542184d90e55aeb16f4dfcd3d22d092b4652e8bddba7bf0b926aa.svg)\n\nThe general solution of the system is\n![](images/8b/8b25789fb45234e4299e4b5ce3371c1afafc181c64f9802d212ae7cbefc0970f.svg)\n\nNotice that for each vector ![](images/67/674212f0d815e0588faaf276bd797e9822ac5659e5d4b15a7635d7f1327d5dc5.svg) we get the straight-line solutions of the form\n![](images/d4/d4c31285e6f31a229bc6fc5cbe2d78e2bf50f73bb6305d91687c5dcc31c3885a.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/26/268764bbe776b03647daac7fc77e8ed24107e1bb0cf16d955f7a845a12c65755.svg)\n\nSince $e^{-8t} \\to 0$ as $t \\to \\infty,$ these solutions approach the origin as $t \\to \\infty,$ so the origin is a stable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/4c/4c337f7f6b80f340859844e8217525db98230660d22e760c70218f0c282d21e9.png)"}] [{:db/id #edb/ref 17592186167239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "815b8138-f510-5107-a4e5-02ac4eea8d19" :answer/type {:db/ident :answer.type/text} :answer/value "a saddle point" :db/id #edb/ref 17592186164494} {:answer/id #uuid "9c6bf31d-ae8a-5604-a0a6-3472491c8dbd" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable node (source)" :db/id #edb/ref 17592186164495} {:answer/id #uuid "2af9f5cc-d483-5244-9711-58ebfc066520" :answer/type {:db/ident :answer.type/text} :answer/value "a stable node (sink)" :db/id #edb/ref 17592186164496}] :answer-field/id #uuid "9f4c563d-8027-50b1-913d-cbfe46b3b03f" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164493} {:answer-field/choices [{:answer/id #uuid "84c293e8-e637-5ce6-b268-3a68429c50c4" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2x" :db/id #edb/ref 17592186164498} {:answer/id #uuid "1f131eb7-cf46-5bfe-a9bc-ea9c8d3feea2" :answer/type {:db/ident :answer.type/math} :answer/value "y = x" :db/id #edb/ref 17592186164499} {:answer/id #uuid "224fc0f4-09e8-5a41-8ec6-c56e757c640e" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x" :db/id #edb/ref 17592186164500} {:answer/id #uuid "4d0288de-0ab0-5675-938e-54ef6c4ab8ef" :answer/type {:db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186164501}] :answer-field/id #uuid "77950033-a58b-530b-81aa-1b6baa7ed3f9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164497} {:answer-field/choices [{:answer/id #uuid "bdf768f1-d157-594e-93e6-8712d929efef" :answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186164503} {:answer/id #uuid "ffb8ccc9-51f2-5dd2-bb26-551b5a471cae" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186164504}] :answer-field/id #uuid "f60034b7-9188-55cc-a8b2-57dccf7ab523" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164502} {:answer-field/choices [{:answer/id #uuid "c84bedda-2559-5487-9e67-150250512458" :answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186164506} {:answer/id #uuid "4f5e11be-145e-5998-9889-0c945d104df0" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186164507}] :answer-field/id #uuid "63823202-0c50-5533-9e21-f95eba077a8f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164505} {:answer-field/choices [{:answer/id #uuid "2b0634b8-f6ab-5ea4-b71a-8ff79c2910ac" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186391243} {:answer/id #uuid "5856e40c-0770-51af-9c03-743a46d8596e" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186391244} {:answer/id #uuid "8d1a4796-e97f-5429-9cff-49ce80190e1e" :answer/type {:db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186391245} {:answer/id #uuid "4d8f23ef-ea1d-51ba-a4c9-2d39a0d74b6f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186391246}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186391246} :answer-field/id #uuid "c05b5222-3879-5657-af29-d4fe6f0070f7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391242} {:answer-field/choices [{:answer/id #uuid "c7d4ce44-9e69-52f2-9caa-64e6d8f34a1a" :answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186391248} {:answer/id #uuid "22c29fa9-881d-5b05-8f81-c4fd49e6cd53" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186391249}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186391248} :answer-field/id #uuid "4ec1f102-d858-549e-95e7-119125b750c1" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391247} {:answer-field/choices [{:answer/id #uuid "ff6701bd-a4f7-52e4-90bd-ddcbd4815a94" :answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186391251} {:answer/id #uuid "57f9df6d-c566-5125-a5ee-dfefdfea7aec" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186391252}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186391251} :answer-field/id #uuid "0ef32066-7efb-5518-b08e-5b73f307a698" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391250} {:answer-field/choices [{:answer/id #uuid "9c1d23b5-f76a-5cfb-b2b7-024a619b5bc6" :answer/type {:db/ident :answer.type/text} :answer/value "a stable node (sink)" :db/id #edb/ref 17592186391254} {:answer/id #uuid "a4ef6ad1-d41a-592f-9f2a-dafc9e0ed0c9" :answer/type {:db/ident :answer.type/text} :answer/value "a saddle point" :db/id #edb/ref 17592186391255} {:answer/id #uuid "29fe338f-9f99-59e0-b948-9af05832bed6" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable node (source)" :db/id #edb/ref 17592186391256}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "a stable node (sink)" :db/id #edb/ref 17592186391254} :answer-field/id #uuid "244f6b3b-3578-574d-94fd-0dcddcc4492b" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391253}] :question/id #uuid "f735f61a-0791-5bf2-b5e1-a997e0f18859" :question/math-academy-id "q-333646" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-3x(t)-2y(t) \\\\ {y}^{′}(t) &=-x(t)-2y(t)\\end{aligned}\\right.\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=-1,$ for which the corresponding eigenvectors are ${v}_{1}=[2,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }1]^{T},$ respectively. Select the correct options below regarding the given system.$\\,$\n$y=\\frac{1}{2}x$ is {{field-1}} line.\n\n$\\,$\n{{field-2}} is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}{e}^{-4t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+{c}_{2}{e}^{-t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=\\frac{1}{2}x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-4t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$\nlie on that line and approach the origin as $t\\to \\infty .$ So, $y=\\frac{1}{2}x$ is $\\text{a stable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=-x.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{-t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$\nlie on that line and approach the origin as $t\\to \\infty .$ So, $y=-x$ is $\\text{a stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/63/6337a670b6fa73c4c21759b600269cb83d808a1c13026c90e2d02519fa31cd67.png)"}] [{:db/id #edb/ref 17592186167468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9268c777-8c11-587d-8e92-8259cc5a35a9" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$ and $V = \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186166017} {:answer/id #uuid "f7e15010-68b8-5d13-8a05-46a57b374da6" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$ and $V = \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186166018} {:answer/id #uuid "fc2c8936-40d0-5f2e-ba43-0e536ef27d59" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$ and $V = \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186166019} {:answer/id #uuid "17b99567-79ed-5509-87ab-eb0df57a874c" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{1}}\\end{bmatrix}$ and $V = \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186166020} {:answer/id #uuid "72c5e15c-eedb-5f25-92a3-1e3649c0988a" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$ and $V = \\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186166021}] :answer-field/id #uuid "e0bcae68-fbd0-5a05-8b00-13903f399796" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166016} {:answer-field/choices [{:answer/id #uuid "7bcdf095-24d5-524e-a65f-5181417d7108" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186371396} {:answer/id #uuid "a36e3fb8-0798-5fac-b30e-79b68bcb9da3" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186371397} {:answer/id #uuid "0613b5f9-b7a8-5e0a-8948-a76dbc898851" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186371398} {:answer/id #uuid "23aabe88-e989-5349-bdf7-ed4b2fa1fddf" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186371399} {:answer/id #uuid "1e38ffeb-f446-56e6-8a85-25b39aa0c303" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{1}}\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186371400}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$ and $V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186371396} :answer-field/id #uuid "11bf1f45-5128-5bda-8f96-b6a315da1dcd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371395}] :question/id #uuid "5cc513bc-fe77-5e9e-887b-62058a8b7f56" :question/math-academy-id "q-96434" :question/problem "$$\nA=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$\n\nConsider the matrix shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since ${A}^{T}\\,A$ is diagonal, the singular values of $A$ are \n\n$\\,$ ${\\sigma }_{1}={\\sigma }_{2}=1.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$): Seeking non-zero solutions of $({A}^{T}\\,A-1I)v=0,$ we obtain the unit eigenvectors \n\n$\\,$ ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\,$ and $\\,{v}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{1}\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =1\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =1\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $Σ,$ and $V:$\n\n$$\nU=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186168005 :tutorial/content "Let's sketch the phase portrait of the following linear system:\n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nWriting our system in matrix form, we have\n![](images/f5/f58fb57caaba8c5f6a110c72565c24803ac233f41b8eb2db0c5221bcf12d7fe2.svg)\nwhere ![](images/65/65298928a44147868c82da753a731e35c3aa0ad5e4b3400819d9d9f16f546a34.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=2$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and ![](images/69/694a89326f61bbbba7e91db5dcb607a74f99881ce16059450dbe1bbac7ee797e.svg)\n\nThe general solution of the system is\n![](images/ab/abd4dbe3156abbcd645e670fb893f93cc8765cba4b1da9bde11075e211f1eeaa.svg)\n\nNotice that for each vector ![](images/9d/9df6cb20bf3163f53850730242138ec62412ccc8af23098130d71228cac4b82a.svg) we get the straight-line solutions of the form\n![](images/71/7166c456c7912bf31d4ff2d98f4e4206537f8d01aca086fdba3c15b394db4b81.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/23/23074d10911b113811cc92bdc88a61a6758dbd8772c21425159c5e95d30b1075.svg)\n\nSince $e^{2t} \\to \\infty$ as $t \\to \\infty,$ these solutions move away from the origin as $t \\to \\infty,$ so the origin is an unstable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/b3/b32b5666c0138f5c17ff1622cef9bca6fb019375f6748b6422c11a547cfad282.png)" :tutorial/id #uuid "ae2e5f22-ed77-5781-b5af-ab6ead3ca6d6" :tutorial/math-academy-id 14467 :tutorial/title "A Worked Example of a Star Node"}] [{:db/id #edb/ref 17592186176225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b17622-2bed-5fdf-a001-6fed60a0e93d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173609} {:answer/id #uuid "c4667d2e-b3e6-57a3-af29-52f2fb24c0be" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173610} {:answer/id #uuid "fd725588-9adf-5c5c-949f-ec236a9b9a91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173611} {:answer/id #uuid "3d63b09a-3934-5fe3-bcc2-33aac9c09e71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173612} {:answer/id #uuid "3e409f37-33b3-5d46-ac67-07b2990b8f92" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173613}] :answer-field/id #uuid "b1148468-12b7-54d1-9cd0-e88e06b85167" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173608} {:answer-field/choices [{:answer/id #uuid "e9deac94-910d-5b63-9e57-f2b87ce35388" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386296} {:answer/id #uuid "1ed1599f-3aad-5db6-88b0-67ffb6cefac0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386297} {:answer/id #uuid "a98ce391-9389-52eb-9e86-0f61cb9645c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386298} {:answer/id #uuid "c1239255-deea-5186-b902-2c62a0e4f9b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386299} {:answer/id #uuid "77e95aa7-899b-565b-8665-45a05cc48157" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386300}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386300} :answer-field/id #uuid "1868ed6f-a38d-5a16-93a8-ed4612cf63a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386295}] :question/id #uuid "7a50741c-c4f5-5a02-bb86-14c9da06d5cf" :question/math-academy-id "q-108719" :question/problem "Find a Jordan canonical form of the matrix \n$A=\\begin{bmatrix}6 & 5 \\\\ -10 & -9\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(-4)=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186176237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6bf1261-c76e-5fd8-814a-f850246e8f38" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186173681} {:answer/id #uuid "c66147b3-aab4-5ac4-8f77-6683e7a7d328" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186173682} {:answer/id #uuid "c81ff904-fd46-5b5e-aeb2-80f02197cd1c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186173683} {:answer/id #uuid "e477f4cd-12da-5386-b63d-62b33fba67f1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186173684} {:answer/id #uuid "2cba62e1-c4b0-5b23-8c10-0da50162d785" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186173685}] :answer-field/id #uuid "ce751486-c7ea-54d9-9688-e2c059ee106c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173680} {:answer-field/choices [{:answer/id #uuid "31cbd2f1-c573-5672-9d87-2e00eb5bc69f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186366980} {:answer/id #uuid "decdb37e-a3a6-548b-877d-853060b844b8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366981} {:answer/id #uuid "41a2f50e-2db7-52e0-9ff0-8736dfd57ebe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366982} {:answer/id #uuid "e269a42a-078e-50b4-9631-43c273c196ec" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366983} {:answer/id #uuid "28222b03-159d-5f7e-bb56-c35121955d21" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186366984}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366983} :answer-field/id #uuid "c94e7f38-34a4-5dfd-85c2-b0df8007af43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366979}] :question/id #uuid "865c5b8a-ea36-5fcb-9ef1-0af019b2ab3b" :question/math-academy-id "q-109410" :question/problem "$$\nA=\\begin{bmatrix}-1 & 1 & 0 \\\\ -1 & -3 & 0 \\\\ 11 & 8 & 1\\end{bmatrix},\\,J=\\begin{bmatrix}-2 & 1 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}a & ∗ & ∗ \\\\ b & ∗ & ∗ \\\\ c & ∗ & ∗\\end{bmatrix}\n$$\n\nConsider the matrices above. Given that $A=PJ{P}^{-1}$ is a Jordan canonical decomposition of $A,$ find the value of $\\frac{a}{c}.$" :question/worked-solution "First, notice that the Jordan matrix $J$ may be written as a composition of Jordan blocks, as follows:\n\n$$\nJ={J}_{2}(-2)\\,⊕\\,{J}_{1}(1)\n$$\n\nSo, we have\n\n- a single $2\\times 2$ Jordan block corresponding to $\\lambda =-2,$ and\n\n- a single $1\\times 1$ block corresponding to $\\lambda =1.$\n\nTherefore, the columns of $P$ form the following chains: \n\n$$\n\\begin{aligned}{J}_{2}(-2) & : & {v}_{2}\\overset{A+2I\\,}{\\to }{v}_{1}\\overset{A+2I\\,}{\\to }0 &  \\\\ {J}_{1}(1) & : & {v}_{3}\\overset{A-I\\,}{\\to }0 & \\end{aligned}\n$$\n\nAs a result, the first column of $P$ is an eigenvector corresponding to $\\lambda =-2.$ \n\nNow, computing $A+2I,$ we get\n\n$$\n\\begin{aligned}A+2I & =\\begin{bmatrix}-1 & 1 & 0 \\\\ -1 & -3 & 0 \\\\ 11 & 8 & 1\\end{bmatrix}+2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 & 0 \\\\ -1 & -1 & 0 \\\\ 11 & 8 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M,$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ -1 & -1 & 0 & 0 \\\\ 11 & 8 & 3 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-11){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -3 & 3 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}↔{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 0 \\\\ 0 & -3 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we have ${x}_{2}={x}_{3}.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+({x}_{3})=0\\,⟹\\,{x}_{1}=-{x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nTherefore, setting ${x}_{3}=1,$ we get  \n\n$$\n{v}_{1}=\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $\\frac{a}{c}=\\frac{-1}{1}=-1.$"}] [{:db/id #edb/ref 17592186176239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c11c49e-0fdb-5b42-9869-157524fe65f9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186173693} {:answer/id #uuid "08b5fdc9-f8de-500f-8bd2-fd803bd41c9d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186173694} {:answer/id #uuid "1297fcc8-5fae-5a4d-aa70-aa6de1a6d53d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186173695} {:answer/id #uuid "4092d88e-33f1-5ef9-a396-b017e8609e16" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186173696} {:answer/id #uuid "65bb38a0-8d25-50fc-b41c-52bcfa0e7e36" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186173697}] :answer-field/id #uuid "50651942-1cc0-5141-b86b-03de03d0f498" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173692} {:answer-field/choices [{:answer/id #uuid "508949ea-5b51-5280-b7ab-27d6492174f1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186382903} {:answer/id #uuid "aa935015-81bf-547f-a080-a7fe2b7880cb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382904} {:answer/id #uuid "0538c0dd-dff1-5e5c-85fc-ac85f62eeb9b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382905} {:answer/id #uuid "ceaaeaed-2725-5055-96c1-5e6acec20a4c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186382906} {:answer/id #uuid "c93fd8ad-2159-5a4e-a662-0ffcbdb5864d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186382907}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186382907} :answer-field/id #uuid "8756abcf-dc38-5db6-8b7b-d7e0d62ca012" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382902}] :question/id #uuid "26868005-7875-58c6-a0da-00faceccbb0c" :question/math-academy-id "q-109416" :question/problem "$$\nA=\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 2 & -1 \\\\ -4 & 3 & 4\\end{bmatrix},\\,J=\\begin{bmatrix}2 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}a & ∗ & ∗ \\\\ b & ∗ & ∗ \\\\ c & ∗ & ∗\\end{bmatrix}\n$$\n\nConsider the matrices above. Given that $A=PJ{P}^{-1}$ is a Jordan canonical decomposition of $A,$ find the value of $\\frac{b}{c}.$" :question/worked-solution "Since the Jordan matrix $J$ has a single $3\\times 3$ Jordan block corresponding to $\\lambda =2,$ the columns of $P$ form the following chain: \n\n$$\n\\begin{aligned}{v}_{3}\\overset{A-2I\\,}{\\to }{v}_{2}\\overset{A-2I\\,}{\\to }{v}_{1}\\overset{A-2I\\,}{\\to }0\\end{aligned}\n$$\n\nAs a result, the first column of $P$ is an eigenvector corresponding to $\\lambda =2.$ \n\nNow, computing $A-2I,$ we get\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}0 & 1 & 0 \\\\ -1 & 2 & -1 \\\\ -4 & 3 & 4\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & 1 & 0 \\\\ -1 & 0 & -1 \\\\ -4 & 3 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M,$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 1 & 0 & 0 \\\\ -1 & 0 & -1 & 0 \\\\ -4 & 3 & 2 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 0 & -1 & 0 \\\\ -2 & 1 & 0 & 0 \\\\ -4 & 3 & 2 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 0 & -1 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 3 & 6 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-3){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 0 & -1 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we have ${x}_{2}=-2{x}_{3}.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}-{x}_{3}=0\\,⟹\\,{x}_{1}=-{x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-{x}_{3} \\\\ -2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nTherefore, setting ${x}_{3}=1,$ we get  \n\n$$\n{v}_{1}=\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $\\frac{b}{c}=\\frac{-2}{1}=-2.$"}] [{:db/id #edb/ref 17592186176246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4ac3bbe-9db3-5dca-a18b-042474674026" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186173735} {:answer/id #uuid "fc3beb7b-4983-5fa7-8c1a-1d1b6e2f4fe9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186173736} {:answer/id #uuid "0ac93395-6cd0-5068-b9af-2ce53affb010" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186173737} {:answer/id #uuid "2ac6a7b4-6c35-5b5f-b5f8-fffcd24b05f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186173738} {:answer/id #uuid "4372ba19-f6cf-5ba2-9372-728b9932774e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186173739}] :answer-field/id #uuid "b6815d4e-77ad-55bf-afac-7eb44c2c532f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173734} {:answer-field/choices [{:answer/id #uuid "791b8670-1c2e-5182-a705-6f1f025184ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186367000} {:answer/id #uuid "75c3e82d-75f0-5884-b4f6-e65c344b9a7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186367001} {:answer/id #uuid "269603d6-3e64-5081-a51d-b9b4274e6614" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186367002} {:answer/id #uuid "9738df9b-77f4-5668-bdde-5b0d9c815f10" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186367003} {:answer/id #uuid "2177f317-8114-556b-918f-ba19592f04fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186367004}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186367001} :answer-field/id #uuid "bdc2ab35-a243-5d04-bf17-3f3866fa1ab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366999}] :question/id #uuid "67f58682-8e34-5925-bec9-2cda3ee48ac0" :question/math-academy-id "q-109702" :question/problem "Which of the following is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ for the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}-4 & 0 \\\\ 1 & -4\\end{bmatrix}?\n$$" :question/worked-solution "Given a matrix $A$ with eigenvalue $\\lambda ,$ a generalized eigenvector of rank $k$ is a vector $v$ that satisfies\n\n$$\n(A-\\lambda I)^{k}v=0\\,\\text{and}\\,(A-\\lambda I)^{k-1}v\\ne 0.\n$$\n\nTo find a generalized eigenvector of rank $2$ corresponding to $\\lambda =-4,$ we need to find a vector $v$ that satisfies\n\n$$\n(A+4I)^{2}v=0\\,\\text{and}\\,(A+4I)v\\ne 0.\n$$\n\nLet's consider each condition:\n\n- We start by solving $(A+4I)^{2}v=0.$ First, we have\n\n$$\nA+4I=\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nComputing its square, we see that this matrix is nilpotent:\n\n$$\n(A+4I)^{2}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nThis means that *any* vector in ${R}^{2}$ is a solution to $(A+4I)^{2}v=0.$ Therefore, the solution to $(A+4I)^{2}v=0$ can be written as\n\n$$\n\\begin{aligned}v=\\begin{bmatrix}{v}_{1} \\\\ {v}_{2}\\end{bmatrix}={v}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{v}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n- Next, we solve $(A+4I)v=0.$ We have\n\n$$\nA+4I=\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix}\\,.\n$$\n\nConverting this matrix to reduced row echelon form, we get\n\n$$\nA+4I∼\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nThis means that the solution to $(A+4I)v=0$ is ${v}_{1}=0,$ where ${v}_{2}$ is a free variable. Therefore, the solution to $(A+4I)v=0$ can be written as\n\n$$\n\\begin{aligned}v=\\begin{bmatrix}{v}_{1} \\\\ {v}_{2}\\end{bmatrix}=\\begin{bmatrix}0 \\\\ {v}_{2}\\end{bmatrix}={v}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nComparing our two solutions, we see that the vector $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ satisfies $(A+4I)^{2}v=0$ but does *not* satisfy $(A+4I)v=0.$  \n\nHence, $\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ is a generalized eigenvector of rank $2$ of $A.$"}] [{:db/id #edb/ref 17592186176278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba18cdb8-24b3-5a41-8696-95f1e9e135b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186173927} {:answer/id #uuid "c32994d5-4277-5f2f-a99d-c954839aab1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186173928} {:answer/id #uuid "fac5cccf-ab8a-5ed3-8a9b-91fd88b34e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186173929} {:answer/id #uuid "fc9ab9ce-ebc0-5b30-b392-22ebf8b41bd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186173930} {:answer/id #uuid "15c3749b-3769-54f5-9adf-a55b3cf06d79" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173931}] :answer-field/id #uuid "8e364d87-5c0e-5c91-aac7-c0821e1a15ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173926} {:answer-field/choices [{:answer/id #uuid "be5856b8-7f85-5738-93a0-03177f25852b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186369114} {:answer/id #uuid "fdc01ced-3e30-5136-adfc-90359277ee2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186369115} {:answer/id #uuid "30f67092-fcbe-58c9-9dc9-6b0f85012367" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186369116} {:answer/id #uuid "66f01f5d-34be-50e9-82da-30251a7dc6ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186369117} {:answer/id #uuid "950cf8c5-37ab-5895-b74d-1b2abd8e16cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186369118}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186369118} :answer-field/id #uuid "43cc96a0-d424-53ae-a185-9589d58634ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369113}] :question/id #uuid "c713476f-2f6c-5e77-bd39-c13fa3ec8e32" :question/math-academy-id "q-112422" :question/problem "Find the Jordan canonical form of the matrix \n$A=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nNotice that $A$ is a scalar matrix, which means that it is already in Jordan canonical form. Therefore, it has a single (repeated) eigenvalue $\\lambda =2,$ and\n\n$$\nJ=A=2I=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}.\n$$"}]}
