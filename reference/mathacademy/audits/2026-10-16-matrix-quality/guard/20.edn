id #uuid "55babe7a-df9e-5246-9069-b8e548bbfc62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056634} {:answer-field/choices [{:answer/id #uuid "0430e0c4-a0b4-5049-ad23-35a8288d7cd5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-28,19,-19⟩" :db/id #edb/ref 17592186388752} {:answer/id #uuid "f4a43164-df74-5f59-9f11-3639b1e68c3e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-28,-19,-61⟩" :db/id #edb/ref 17592186388753} {:answer/id #uuid "fca0458d-7adb-55af-9b20-df320360f312" :answer/type {:db/ident :answer.type/math} :answer/value "⟨28,-19,-19⟩" :db/id #edb/ref 17592186388754} {:answer/id #uuid "afb78719-5f2d-59cd-b63d-0e3512a7ce7f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-18,19,-61⟩" :db/id #edb/ref 17592186388755} {:answer/id #uuid "cb139f18-1fd5-55e0-b900-e3e088cf39d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,19,61⟩" :db/id #edb/ref 17592186388756}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨-18,19,-61⟩" :db/id #edb/ref 17592186388755} :answer-field/id #uuid "26765ce1-5d1e-5d12-ad0e-0e45e31383cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388751}] :question/id #uuid "7427d773-9726-5cf6-8261-06dbd4949f9e" :question/math-academy-id "q-1405" :question/problem "Let $u=⟨-3,10,4⟩$ and $v=⟨4,7,1⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -3 & 10 & 4 \\\\ 4 & 7 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}10 & 4 \\\\ 7 & 1\\end{aligned}|i-|\\begin{aligned}-3 & 4 \\\\ 4 & 1\\end{aligned}|j+|\\begin{aligned}-3 & 10 \\\\ 4 & 7\\end{aligned}|k \\\\  & =(10\\cdot 1-4\\cdot 7)i-((-3)\\cdot 1-4\\cdot 4)j+((-3)\\cdot 7-10\\cdot 4)k \\\\  & =(10-28)i-(-3-16)j+(-21-40)k \\\\  & =-18i+19j-61k \\\\  & =⟨-18,19,-61⟩.\\end{aligned}\n$$"}] [{