#{[{:db/id #edb/ref 17592186054545 :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n$$\n\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054546 :question/id #uuid "fc4a66f3-5180-5ac0-bd4d-830196fa459a" :question/math-academy-id "e-4375" :question/problem "Calculate $A-B,$ where\n\n$$\n\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}-\\begin{bmatrix}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-0 & -1-(-1) \\\\ -1-2 & 0-(-1) \\\\ 3-(-1) & 2-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054547 :question/id #uuid "b77816bd-e128-5888-9973-97c51c99f7f0" :question/math-academy-id "e-4396" :question/problem "Calculate ${A}+ {B},$ where\n\n$$\n\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-2) & 3+(-3) & 1+1 & 0+1 \\\\ 2+1 & 4+(-2) & -1+3 & 2+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & 2 & 1 \\\\ 3 & 2 & 2 & 3\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051333} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051334} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051335} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051336} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051337}] :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051332} {:answer-field/choices [{:answer/id #uuid "a6e60215-8077-5f8c-8c55-359a0a908320" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186386738} {:answer/id #uuid "29d738c0-81db-5e6c-91c9-db679852e3b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186386739} {:answer/id #uuid "20fa7a5b-5a7b-5d2e-91fe-afbafad3502d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386740} {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186386741} {:answer/id #uuid "8751a674-6cb2-575b-98a1-e1863e33ff8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186386742}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186386741} :answer-field/id #uuid "1ce63358-0fcc-55be-a22f-c3c4afd97cf2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386737}] :question/id #uuid "06528850-f3e1-5360-9392-bba2a3bf7deb" :question/math-academy-id "q-11440" :question/problem "Calculate $A+B$, where\n\n$$\nA=\\begin{bmatrix}2 & 5 \\\\ 3 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}4 & 1 \\\\ -2 & 2\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}2 & 5 \\\\ 3 & 1\\end{bmatrix}+\\begin{bmatrix}4 & 1 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdc9d214-e74c-5f96-bff6-bfaecae8776c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & -1 \\\\ -1 & 0 & 0 \\\\ 0 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186051531} {:answer/id #uuid "05e9b903-8fb1-54a1-a212-2958f31dba29" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186051532} {:answer/id #uuid "16b54720-0aee-5dc1-95df-3480574935e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -1 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186051533} {:answer/id #uuid "360508ab-7d7e-5b0a-bd55-a50341dc5af6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186051534} {:answer/id #uuid "689fffc2-526d-5c19-8c7b-8c3d0a415871" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186051535}] :answer-field/id #uuid "fd03df85-93eb-5358-94ae-a5a77bf151e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051530} {:answer-field/choices [{:answer/id #uuid "7dfbe19d-41b8-5dfb-800e-9865a8f7adaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383364} {:answer/id #uuid "3eddf4c9-1033-5f87-a2c7-b456a63d1906" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186383365} {:answer/id #uuid "16abf2ad-3ae1-54b4-8eef-de46926f545d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -1 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383366} {:answer/id #uuid "14f066da-5cf6-5d7e-ae32-701f06d20d61" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & -1 \\\\ -1 & 0 & 0 \\\\ 0 & -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383367} {:answer/id #uuid "e35751c9-643f-50ac-8209-70ef1577654e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383368}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186383364} :answer-field/id #uuid "81540ad0-89f3-5c5b-8d62-a602145c0a08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383363}] :question/id #uuid "67ead67a-2b60-5086-96b4-6f9c74e5b6af" :question/math-academy-id "q-135371" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "The given matrix can be obtained from the identity matrix by permuting its columns. Therefore, $A$ is a permutation matrix.\n\nThe inverse of a permutation matrix can be found as follows: \n\n$$\n{P}^{-1}={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{bmatrix}}^{-1}={\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{bmatrix}}^{T}=\\begin{bmatrix}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055975 :tutorial/content "We can subtract matrices in the same way that we add matrices: we subtract the corresponding entries. Again, we can only do this if they have the same number of rows and columns, that is, they have the same dimensions.\n\nFor example, consider the matrices\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}\n$$\n\nWe see that both $A$ and $B$ are $2\\times 2$ matrices, so, we can subtract them. The difference ${A} - {B}\\,$ is given by\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-1 & 3-0 \\\\ 2-0 & 4-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 2 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nAgain, the difference of two matrices is another matrix with the same dimensions." :tutorial/id #uuid "6c907b34-7db5-5717-84ac-d2425bf6dbc3" :tutorial/math-academy-id 2986 :tutorial/title "Subtracting Matrices"}] [{:db/id #edb/ref 17592186059549 :question/id #uuid "4391bd7a-560e-5b59-bf5c-b68ff235c05e" :question/math-academy-id "e-4380" :question/problem "Calculate $-2A$, if \n$A=\\left\\lbrack\n    \t\\begin{matrix}\n        \t2 & -1  \\\\\n        \t4 & 7\n    \t\\end{matrix}\n    \t\\right\\rbrack.$" :question/worked-solution "We multiply each entry of $A$ by $-2,$ as follows:\n\n$$\n\\begin{aligned}-2A & =-2\\begin{bmatrix}2 & -1 \\\\ 4 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\cdot 2 & -2\\cdot (-1) \\\\ -2\\cdot 4 & -2\\cdot 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 2 \\\\ -8 & -14\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059550 :question/id #uuid "69ac9cdd-b27b-5b90-be25-02252df54e9e" :question/math-academy-id "e-4381" :question/problem "If $k {A} =\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t1 & 3 & 4  \\\\\n        \t6 & 0 & -2\n    \t\\end{matrix}\n    \t\\right\\rbrack,$\nwhere ${A} =\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t2 & 6 & 8  \\\\\n        \t12 & 0 & -4\n    \t\\end{matrix}\n    \t\\right\\rbrack$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot \\begin{bmatrix}2 & 6 & 8 \\\\ 12 & 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2k & 6k & 8k \\\\ 12k & 0 & -4k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t2k & 6k & 8k  \\\\\n        \t12k & 0 & -4k\n    \t\\end{matrix}\n    \t\\right\\rbrack\n=\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t1 & 3 & 4  \\\\\n        \t6 & 0 & -2\n    \t\\end{matrix}\n    \t\\right\\rbrack\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $2k$ and $1.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =1 \\\\ k & =\\frac{1}{2}.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186059551 :question/id #uuid "1828e8ba-504d-5b20-b5fa-82005c7588f6" :question/math-academy-id "e-4382" :question/problem "Calculate $2 {A} + \\dfrac{1}{2} {B}$, where\n$\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}$ and ${B}=\n    \\left\\lbrack\n    \\begin{matrix}\n        0 & 2  \\\\\n        4 & 2\n    \\end{matrix}\n    \\right\\rbrack\n.$" :question/worked-solution "We multiply each entry of $A$ by $2$ and each entry of $B$ by $\\dfrac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}2A+\\frac{1}{2}B & =2\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}0 & 2 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 1 & 2\\cdot 5 \\\\ 2\\cdot 1 & 2\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot 2 \\\\ \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 10 \\\\ 2 & 4\\end{bmatrix}+\\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+0 & 10+1 \\\\ 2+2 & 4+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 11 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059552 :question/id #uuid "e3d1f202-a3d6-561f-bd4b-3e886142e5a0" :question/math-academy-id "e-4386" :question/problem "Find $C^T,$ if \n![](images/d5/d5e344ac147321b0440d313274626b1a00527214467cbc85bac199c10fee00bd.png)" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n![](images/d6/d64f16633ed91692b0cd22daa4c739a6e4347ec6c0596c992d28088880ea2862.png)"}] [{:db/id #edb/ref 17592186059553 :question/id #uuid "c8ca81da-04d3-532f-94f4-5f43703c7216" :question/math-academy-id "e-4387" :question/problem "If\n    ${A} = \n    \\left\\lbrack\n    \\begin{matrix}\n        5 & -1 & 0  \\end{matrix}\n    \\right\\rbrack,$\nthen what is ${A^T} ?$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \n    \t\t\\left\\lbrack\n    \t\t\\begin{matrix}\n    5  \\\\\n    -1  \\\\\n    0  \\end{matrix}\n    \t\t\\right\\rbrack\n$$"}] [{:db/id #edb/ref 17592186059554 :question/id #uuid "02372092-ed41-5533-8238-0361856b731d" :question/math-academy-id "e-4388" :question/problem "Consider the matrix\n    ${B} = \n    \\left\\lbrack\n    \\begin{matrix}\n        1 & 2 & 4 & 2 \\\\\n        4 & 4 & 1 & 1 \\\\\n        3 & -3 & 0 & -1\n    \\end{matrix}\n    \\right\\rbrack.$\nWhat are the dimensions of ${B}^T?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N.$\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix."}] [{:db/id #edb/ref 17592186059555 :question/id #uuid "04e1822f-2da1-5b28-8967-7a0026c39319" :question/math-academy-id "e-4401" :question/problem "Find $AB$ and $BA,$ if \n$\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1\\cdot 0+0\\cdot (-1) & 1\\cdot 1+0\\cdot 2 \\\\ -5\\cdot 0+1\\cdot (-1) & -5\\cdot 1+1\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -1 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}BA & =\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1+1\\cdot (-5) & 0\\cdot 0+1\\cdot 1 \\\\ -1\\cdot 1+2\\cdot (-5) & -1\\cdot 0+2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 1 \\\\ -11 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n**Watch out!** Notice that \n\n$$\nAB \\neq BA.\n$$\n\nMatrix multiplication is not **commutative**, meaning that when we switch the order of multiplication, we often get a different result (like we did in this example)."}] [{:db/id #edb/ref 17592186059556 :question/id #uuid "3b0c400c-89bd-504d-87c3-e0f24957d42b" :question/math-academy-id "e-4402" :question/problem "Find $AB$, if \n$\\begin{bmatrix}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{bmatrix}$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+0-9 & -6+0-3 & 4+0+6 \\\\ 0-1+6 & 9+2+2 & -6-4-4 \\\\ 0+0+3 & -6+0+1 & 4+0-2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -9 & 10 \\\\ 5 & 13 & -14 \\\\ 3 & -5 & 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059557 :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A),$ if $\\begin{bmatrix}3 & 2 \\\\ 5 & 6\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059558 :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A),$ if $\\begin{bmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059559 :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n${A} = \n    \\left\\lbrack\n    \\begin{matrix}\n        2 & -1  \\\\\n        -3 & k\n    \\end{matrix}\n    \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 \\\\ -3 & k\\end{aligned}| \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059599 :question/id #uuid "4aaa04dd-1380-50c9-8118-52f6e414f830" :question/math-academy-id "e-5255" :question/problem "Let $Z=XY.$ What is the value of $z_{32}$, if\n\n$$\n\\begin{bmatrix}1 & 2 & 0 \\\\ -2 & 0 & -1 \\\\ 1 & 2 & 3\\end{bmatrix}\n$$" :question/worked-solution "Multiplying the $3$rd row in $X$ by the $2$nd column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{32} & =\\begin{bmatrix}1 & 2 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 4 \\\\ -2\\end{bmatrix} \\\\  & =1\\cdot (-1)+2\\cdot 4+3\\cdot (-2) \\\\  & =-1+8-6 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5a9bba7-f581-5372-a873-0fc17a55fb02" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & -9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186056126} {:answer/id #uuid "b9c177a1-6771-55e3-bd09-bf47def49ac2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 & 9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186056127} {:answer/id #uuid "0d1d8e7e-44fc-5700-9bdc-f19ade4437e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186056128} {:answer/id #uuid "5f95897b-76c9-50f9-ba67-9a60ae42a4ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186056129} {:answer/id #uuid "64489d72-05e0-5199-9ab5-2517bee16eda" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186056130}] :answer-field/id #uuid "fe11ff0e-55ca-57c1-896c-442215af5968" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056125} {:answer-field/choices [{:answer/id #uuid "3e95e2e5-f4c7-556f-9d3b-6806aa203aac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186386022} {:answer/id #uuid "93d2127b-e5d6-5f6a-b77b-e49e6b3917a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186386023} {:answer/id #uuid "dfcd1624-4c95-5d1d-b7c3-eadfb5affb1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & -9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186386024} {:answer/id #uuid "84d65aa0-7f3f-56d8-8813-60439890bf5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & -1 & 9\\end{bmatrix}" :db/id #edb/ref 17592186386025} {:answer/id #uuid "f47ccd2f-8569-5e0e-ae2f-f78a4ee09a4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 & 9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186386026}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186386022} :answer-field/id #uuid "6265e561-15e0-5e23-846a-8eab1f2ab8dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386021}] :question/id #uuid "73199f2e-4821-5c88-b3d1-fc53d8677008" :question/math-academy-id "q-10248" :question/problem "Consider the matrix $M,$ given by\n\n$$\nM=\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}.\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+3{R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+3{R}_{1}$ means that we need to add $3$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{bmatrix}\\,{R}_{3}:={R}_{3}+3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -4 \\\\ 8 & 3 & 1 \\\\ 3+(3)(-1) & -1+(3)(2) & 9+(3)(4)\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833663bf-3970-5af6-8e3a-39f84ce0af74" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ 4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186056156} {:answer/id #uuid "848e9a7a-7c07-5311-acc3-3f32cc5e5be9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186056157} {:answer/id #uuid "88494fb1-c066-508f-b55b-d80ff6428bdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186056158} {:answer/id #uuid "ce89aba2-05bf-5b03-9f7b-8c7a1ac5d7ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4 \\\\ -5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186056159} {:answer/id #uuid "06e646e6-1255-5a25-8e64-5d9c2c72a532" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186056160}] :answer-field/id #uuid "c3dafa3b-f8f7-511e-a394-16441e7131df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056155} {:answer-field/choices [{:answer/id #uuid "28b40ab3-2e2d-5b11-8aee-c2a90901f88a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ 4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186386090} {:answer/id #uuid "b462dd7b-c55c-5859-ab4a-5ce80868e897" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386091} {:answer/id #uuid "23804c66-ee95-50c0-84c0-7909c68a7143" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4 \\\\ -5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186386092} {:answer/id #uuid "c298e082-bb98-5541-8236-4d81c70f22ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386093} {:answer/id #uuid "343a923e-fc18-5408-a231-6bdb1ea178da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386094}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186386093} :answer-field/id #uuid "7f1df5bc-2c6e-5f27-92f8-344c9f3c4bb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386089}] :question/id #uuid "3f200fb1-1ac4-518a-a135-3b50068ae3b9" :question/math-academy-id "q-1045" :question/problem "Find ${Z}^{T}$ given that \n$Z=\\begin{bmatrix}-4 & 4 & 5 & 1\\end{bmatrix}.$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{Z}^{T}=\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}\n$$"}]}
