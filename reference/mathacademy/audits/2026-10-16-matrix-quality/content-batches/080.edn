0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}\\begin{bmatrix}72 \\\\ 0 \\\\ 41\\end{bmatrix} \\\\ \\begin{bmatrix}3 & 2 & 0 \\\\ -4 & 1 & 1\\end{bmatrix}\\begin{bmatrix}3 & -4 \\\\ 2 & 1 \\\\ 0 & 9\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 & 2 & 0 \\\\ -4 & 1 & 1\\end{bmatrix}\\begin{bmatrix}72 \\\\ 0 \\\\ 369\\end{bmatrix} \\\\ \\begin{bmatrix}13 & -10 \\\\ -10 & 26\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}216 \\\\ 81\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}13 & -10 \\\\ -10 & 26\\end{bmatrix}}^{-1}\\begin{bmatrix}216 \\\\ 81\\end{bmatrix} \\\\  & =\\frac{1}{13\\cdot 26-(-10)\\cdot (-10)}\\begin{bmatrix}26 & 10 \\\\ 10 & 13\\end{bmatrix}\\begin{bmatrix}216 \\\\ 81\\end{bmatrix} \\\\  & =\\frac{1}{238}\\begin{bmatrix}6\\,426 \\\\ 3\\,213\\end{bmatrix} \\\\  & =\\begin{bmatrix}27 \\\\ 13.5\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a098abef-eb06-522c-858c-8b857ee8a01f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388513} {:answer/id #uuid "5aed0d3b-0792-5228-9ce6-408af4d938ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186388514} {:answer/id #uuid "d738c650-2185-5af3-9c36-fdda0ee056af" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186388515} {:answer/id #uuid "b9398833-d22e-5297-be90-347916839a20" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388516} {:answer/id #uuid "09d5b5d2-4025-5a44-aced-68c3caf11839" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186388517}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186388515} :answer-field/id #uuid "390c184b-3595-5e47-8db5-afa305ac9721" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388512}] :question/id #uuid "12606daf-a2ce-5ddc-9fc1-a30958174a13" :question/math-academy-id "q-137905" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ -1 & 1 \\\\ -1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -4 \\\\ 2\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -1 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}3 \\\\ -4 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -4 & 4 \\\\ -4 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}3 \\\\ -16 \\\\ 8\\end{bmatrix} \\\\ \\begin{bmatrix}9 & -2 \\\\ -2 & 8\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}11 \\\\ -10\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}9 & -2 \\\\ -2 & 8\\end{bmatrix}}^{-1}\\begin{bmatrix}11 \\\\ -10\\end{bmatrix} \\\\  & =\\frac{1}{9\\cdot 8-(-2)\\cdot (-2)}\\begin{bmatrix}8 & 2 \\\\ 2 & 9\\end{bmatrix}\\begin{bmatrix}11 \\\\ -10\\end{bmatrix} \\\\  & =\\frac{1}{68}\\begin{bmatrix}68 \\\\ -68\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186389009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77509710-558f-57d7-aa0b-d2c981268322" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186389011} {:answer/id #uuid "1ea03b7e-02ea-578c-913e-693044d40660" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186389012} {:answer/id #uuid "16afd48a-f37f-5caa-9c97-076511b40cdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389013} {:answer/id #uuid "a84f2641-ea85-514d-b1d7-5c6aa198ca55" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389014} {:answer/id #uuid "315b04de-d0f3-59f7-b632-32a7cf9a8ecc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389015}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389013} :answer-field/id #uuid "68cf1131-7e03-5583-b36c-8f53f5e6d06d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389010}] :question/id #uuid "ed199a9d-a3a2-5954-968b-924b5a1b21d0" :question/math-academy-id "q-158372" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ 1 & 1 \\\\ 3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 1 & 1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 4 & 4 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}14 & 9 \\\\ 9 & 9\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}14 & 9 \\\\ 9 & 9\\end{bmatrix}}^{-1}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{14\\cdot 9-9\\cdot 9}\\begin{bmatrix}9 & -9 \\\\ -9 & 14\\end{bmatrix}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{45}\\begin{bmatrix}45 \\\\ -45\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186411867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118a9ee1-aa44-5777-9118-5227ee29fe39" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186411690} {:answer/id #uuid "343f47c9-bb05-5183-9f14-e8b4fa694501" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186411704} {:answer/id #uuid "4d9f0f42-a4f1-5465-a3a2-7a60cda35ef3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186411719} {:answer/id #uuid "8cb4a560-b34c-5ecb-b912-d45e89d2bc34" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186411753} {:answer/id #uuid "fd063dda-be76-5f0e-93fe-6561f604b438" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186411817}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186411719} :answer-field/id #uuid "4272bc52-3700-5a4c-920e-c054cf89452b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411825}] :question/id #uuid "9a9c63b9-55aa-5f88-8ff0-b14dd8c3b850" :question/math-academy-id "q-137889" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ 0 & 1 \\\\ 2 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 1 \\\\ 8 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ -8\\end{bmatrix} \\\\ \\begin{bmatrix}17 & 2 \\\\ 2 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-15 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}17 & 2 \\\\ 2 & 5\\end{bmatrix}}^{-1}\\begin{bmatrix}-15 \\\\ 3\\end{bmatrix} \\\\  & =\\frac{1}{17\\cdot 5-2\\cdot 2}\\begin{bmatrix}5 & -2 \\\\ -2 & 17\\end{bmatrix}\\begin{bmatrix}-15 \\\\ 3\\end{bmatrix} \\\\  & =\\frac{1}{81}\\begin{bmatrix}-81 \\\\ 81\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186412658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466cb1d5-bbaa-5bcf-a4b9-8e35b9769bc6" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186412638} {:answer/id #uuid "7390aa1b-1e0b-5b8f-8041-bba7a08ed6ca" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186412642} {:answer/id #uuid "b8d7ad48-ee12-53ed-ae80-3bfaa814df4f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186412647} {:answer/id #uuid "cb0cdbb1-4af3-53da-b876-22b6640991ee" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186412648} {:answer/id #uuid "f47c99c4-37e6-574e-a7cb-b1c519e96e66" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186412650}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186412642} :answer-field/id #uuid "68d36053-187e-5834-b46e-6140de6fde31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412655}] :question/id #uuid "7e019bd1-c120-5401-ab70-85681df29503" :question/math-academy-id "q-137930" :question/problem "$$\nA=\\begin{bmatrix}2 & 6 \\\\ -1 & -3 \\\\ 1 & 3\\end{bmatrix},\\,b=\\begin{bmatrix}-22 \\\\ 11 \\\\ 7\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}2 & 6 \\\\ -1 & -3 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-22 \\\\ 11 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}2 & 6 \\\\ -4 & -12 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}-22 \\\\ 44 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}9 & 27 \\\\ 27 & 81\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-81 \\\\ -243\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}9 & 27 & -81 \\\\ 27 & 81 & -243\\end{bmatrix} & {R}_{2}:={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}9 & 27 & -81 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-9-3{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-9-3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-9 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+\\frac{b}{c}=-9+\\frac{(-3)}{1}=-12.\n$$"} {:db/id #edb/ref 17592186443607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b1479a-f401-5be2-8d54-998ace998ee3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186443601} {:answer/id #uuid "8eb217f8-2e73-5566-a846-de9689a469fb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443602} {:answer/id #uuid "95c93c03-292b-584d-aa3a-7dff77290397" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186443603} {:answer/id #uuid "bc30efa1-ce98-5d2b-b5f5-b28ca6d26bf0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186443604} {:answer/id #uuid "df31033e-dd1d-5f18-81f3-78e9e429df55" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186443605}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443602} :answer-field/id #uuid "fc00c000-8569-5a9b-b4f0-7026f8c3241d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443606}] :question/id #uuid "642db6cf-d41e-5a55-a66e-30cab01320f7" :question/math-academy-id "q-137924" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 1 & -2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $2a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -8 & 16 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ -12 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}18 & -36 \\\\ -36 & 72\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}27 \\\\ -54\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}18 & -36 & 27 \\\\ -36 & 72 & -54\\end{bmatrix} & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}18 & -36 & 27 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{3}{2}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{3}{2}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{3}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+\\frac{b}{c}=2\\cdot \\frac{3}{2}+\\frac{2}{1}=5.\n$$"}] :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :topic/math-academy-id 3135 :topic/title "Weighted Least-Squares"}]}
