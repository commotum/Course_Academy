483456}} {:db/id #edb/ref 17592186483475 :step/content {:db/id #edb/ref 17592186269158 :question/id #uuid "f530dfca-e960-58b4-85b6-e3859f215c3f"} :step/id #uuid "751743ec-996c-5a2a-bfd6-fa0a4fc9b5c2" :step/next {:db/id #edb/ref 17592186483470}} {:db/id #edb/ref 17592186483499 :step/content {:db/id #edb/ref 17592186388511 :question/id #uuid "12606daf-a2ce-5ddc-9fc1-a30958174a13"} :step/id #uuid "d99942ec-6a5c-5573-82e8-6cbe4cc7bec4" :step/next {:db/id #edb/ref 17592186483475}}] :activity/title "Weighted Least-Squares" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186482803} {:activity/first-step {:db/id #edb/ref 17592186518291} :activity/id #uuid "e3aa0f2d-b3b2-57fa-9b22-abb7f5a88662" :activity/steps [{:db/id #edb/ref 17592186518291 :step/content {:db/id #edb/ref 17592186162356 :question/id #uuid "fe1495c6-48c4-58ae-8df8-b0dc82576087"} :step/id #uuid "bfe95e7b-6300-507c-9c3b-ebf83c2fe680" :step/next {:db/id #edb/ref 17592186518292}} {:db/id #edb/ref 17592186518292 :step/content {:db/id #edb/ref 17592186363141 :question/id #uuid "5018d743-6c3b-5485-b0a5-b9dd110b0784"} :step/id #uuid "c33819f8-c46b-5dee-a664-df0a06fddca7" :step/next {:db/id #edb/ref 17592186518300}} {:db/id #edb/ref 17592186518297 :step/content {:db/id #edb/ref 17592186269157 :question/id #uuid "80a60424-3ff9-5896-996b-077192e08a91"} :step/id #uuid "cfea7d4a-7abe-545a-885a-a12f28682791" :step/next {:db/id #edb/ref 17592186518304}} {:db/id #edb/ref 17592186518300 :step/content {:db/id #edb/ref 17592186269156 :question/id #uuid "670f8829-0bde-5ea3-bf13-816d75c51f2a"} :step/id #uuid "d69dbc57-2846-5307-b0ec-b87f9e963a12" :step/next {:db/id #edb/ref 17592186518297}} {:db/id #edb/ref 17592186518304 :step/content {:db/id #edb/ref 17592186518129 :question/id #uuid "4429ddaa-a525-58c0-92b3-0e53fe11c811"} :step/id #uuid "dbe4af0f-6deb-5714-9b84-7310ef2b54a2"}] :activity/title "Weighted Least-Squares" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186517493}] :db/id #edb/ref 17592186049282 :topic/knowledge-points [{:db/id #edb/ref 17592186162092 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161905 :question/id #uuid "2acc65a4-62df-5e61-a3c9-cb8a08e1ff8c" :question/math-academy-id "e-9831" :question/problem "![](images/07/07fcd57974679ef970ef0042fc81488b3568accb8ed22072d571f58481d0904f.svg)\n\nConsider the matrices $A$ and $W,$ and the vector $\\mathbf{b}$ above. If the normal equation for the corresponding weighted least-squares problem $W\\!A \\mathbf{x} = W\\mathbf{b}$ is given by\n\n![](images/80/80628bb0c815ce0ddee2fb11ae86835a6877f26c1c38a96aea6a9394c74bcd64.svg)\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\!A\\mathbf{x}=W\\mathbf{b},$ we pre-multiply both sides of the equation by $(W\\!A)^T{:}$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n![](images/8e/8eaf2b04375bfefc23f6367c09259b33f02357d2015c3e68144b898491620f84.svg)\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 4 \\\\ 9 & 18\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0 \\\\ 27\\end{bmatrix} \\\\ \\begin{bmatrix}10 & 18 \\\\ 18 & 40\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}29 \\\\ 54\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=10+40+54 = 104.\n$$"} :knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186" :knowledge-point/questions [{:db/id #edb/ref 17592186162349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5c53a9-a2e1-5c97-ae8a-eca40c100135" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186412635} {:answer/id #uuid "2c6fec5d-06d4-5c30-a152-268334590e76" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186412636} {:answer/id #uuid "465218a2-69bf-5497-8469-e2312eb7efd0" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186412637} {:answer/id #uuid "9ff085af-9e73-5865-91af-322d3998891a" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186412646} {:answer/id #uuid "fa9d5a16-3904-5615-8861-702cbf9dba03" :answer/type {:db/ident :answer.type/math} :answer/value "59" :db/id #edb/ref 17592186412652}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "59" :db/id #edb/ref 17592186412652} :answer-field/id #uuid "0676c358-31ac-5dc1-99e9-f46cd0df84d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412654}] :question/id #uuid "363b8573-3582-5360-9547-0ffac7abdb28" :question/math-academy-id "q-137101" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 \\\\ 4 & 4 \\\\ 2 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}4 \\\\ 1 \\\\ -1\\end{bmatrix},\\,W=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,A=Wb$ is given by\n\n$$\n\\begin{bmatrix}a & 18 \\\\ 18 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}c \\\\ 3\\end{bmatrix}\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{2}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 4 & 4 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}\\begin{bmatrix}4 & 0 \\\\ 4 & 4 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{bmatrix}\\begin{bmatrix}16 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}24 & 18 \\\\ 18 & 17\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}18 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=24+17+18=59.\n$$"} {:db/id #edb/ref 17592186162356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7e37e95-9cea-5ab2-a140-cd13a369a582" :answer/type {:db/ident :answer.type/math} :answer/value "252" :db/id #edb/ref 17592186159339} {:answer/id #uuid "13a4b33f-6cc5-5cf7-ae67-11fc4cec69cd" :answer/type {:db/ident :answer.type/math} :answer/value "272" :db/id #edb/ref 17592186159340} {:answer/id #uuid "1a556378-662e-50f4-84e2-69704397f53e" :answer/type {:db/ident :answer.type/math} :answer/value "225" :db/id #edb/ref 17592186159341} {:answer/id #uuid "26188799-c8bd-52c4-8204-93f83b48f701" :answer/type {:db/ident :answer.type/math} :answer/value "127" :db/id #edb/ref 17592186159342} {:answer/id #uuid "458d0deb-efd4-5187-a31c-bbfaa42d288f" :answer/type {:db/ident :answer.type/math} :answer/value "131" :db/id #edb/ref 17592186159343}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "131" :db/id #edb/ref 17592186159343} :answer-field/id #uuid "35881875-1699-51c1-8367-015366562cfb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159338}] :question/id #uuid "fe1495c6-48c4-58ae-8df8-b0dc82576087" :question/math-academy-id "q-137888" :question/problem "$$\nA=[\\begin{aligned}-4 & 3 \\\\ 0 & 0 \\\\ 8 & -6\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n[\\begin{aligned}a & -60 \\\\ -60 & b\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}-8 \\\\ c\\end{aligned}]\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}-4 & 0 & 8 \\\\ 3 & 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}-4 & 3 \\\\ 0 & 0 \\\\ 8 & -6\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-4 & 0 & 8 \\\\ 3 & 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}-4 & 0 & 8 \\\\ 3 & 0 & -6\\end{aligned}][\\begin{aligned}-4 & 3 \\\\ 0 & 0 \\\\ 8 & -6\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-4 & 0 & 8 \\\\ 3 & 0 & -6\\end{aligned}][\\begin{aligned}4 \\\\ 12 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}80 & -60 \\\\ -60 & 45\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-8 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=80+45+6=131.\n$$"} {:db/id #edb/ref 17592186269151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d1f5fd-cafb-568d-9657-f9184338194c" :answer/type {:db/ident :answer.type/math} :answer/value "121" :db/id #edb/ref 17592186266187} {:answer/id #uuid "4ebabaa4-b41e-5183-994d-28b7279d1eef" :answer/type {:db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186266846} {:answer/id #uuid "d0905648-e8ad-5aec-9b17-ddbb11a74a74" :answer/type {:db/ident :answer.type/math} :answer/value "73" :db/id #edb/ref 17592186268008} {:answer/id #uuid "d3e29d98-6dfb-5724-a307-5fe87ac6c792" :answer/type {:db/ident :answer.type/math} :answer/value "145" :db/id #edb/ref 17592186268034} {:answer/id #uuid "f6b05ccb-64dd-53d9-9246-34046d164ae8" :answer/type {:db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186268331}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186268331} :answer-field/id #uuid "a68dbddb-6995-52c9-8221-481a957ef459" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268704}] :question/id #uuid "47be74ee-5888-5dc1-a458-d8d8cd278e9e" :question/math-academy-id "q-137878" :question/problem "$$\nA=\\begin{bmatrix}1 & 2 \\\\ 0 & 1 \\\\ -2 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ -3\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n\\begin{bmatrix}a & 20 \\\\ 20 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}c \\\\ 29\\end{bmatrix}\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {3}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 1 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 0 & 4 \\\\ -18 & -9\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & -2 \\\\ 2 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ -27\\end{bmatrix} \\\\ \\begin{bmatrix}37 & 20 \\\\ 20 & 17\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}55 \\\\ 29\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=37+17+55=109.\n$$"} {:db/id #edb/ref 17592186269152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88379efe-bd21-5c51-850e-e09a0c2654f7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267347} {:answer/id #uuid "8af8b826-25de-5ea4-91b6-48d8ff65bae6" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186267390} {:answer/id #uuid "9187c33d-e56e-5b39-afa6-aaca5ffa3489" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267437} {:answer/id #uuid "eb7c974a-45a8-5296-9565-efd2494a5c3c" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186268239} {:answer/id #uuid "f8de906f-0edf-5d95-8dac-0d7afdfec975" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268350}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268350} :answer-field/id #uuid "607b337a-4a57-56c3-aade-80e9688ccfc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268581}] :question/id #uuid "2929a7d4-9735-5b52-a768-9418045b32c8" :question/math-academy-id "q-137880" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 \\\\ 1 & 1 \\\\ -1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 4 \\\\ 5\\end{bmatrix},\\,W=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n\\begin{bmatrix}a & 1 \\\\ 1 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}c \\\\ 4\\end{bmatrix}\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$