}3 & 1 \\\\ -2 & 4\\end{bmatrix}.\n$$\n\nTherefore, the original vector is\n\n$$\nv=\\frac{1}{14}\\begin{bmatrix}3 & 1 \\\\ -2 & 4\\end{bmatrix}\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}=\\frac{1}{14}\\begin{bmatrix}19 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}\\frac{19}{14} \\\\ \\frac{3}{7}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36533f99-5a38-51ab-a76c-21d2c4cf2cd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186297771}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186297771} :answer-field/id #uuid "0d0ee1f5-14c6-583b-8279-22df5a260e60" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298679} {:answer-field/choices [{:answer/id #uuid "eb2af7ab-0e8c-537e-ae26-3d4386eeffbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186298553}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186298553} :answer-field/id #uuid "38b1cfd1-1012-5e47-b980-7ca6cd2369f5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298830}] :question/id #uuid "cd8788b9-6293-5a49-9a61-bd47b2bc6704" :question/math-academy-id "q-317443" :question/problem "The vector $v$ in the plane is mapped to the vector $\\begin{bmatrix}12 \\\\ 4\\end{bmatrix}$ under the action of the linear transformation $T$ whose matrix $T$ is given by\n\n$$\nT=\\begin{bmatrix}5 & 6 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nWhat is the original vector $v?$\n\n| $v=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "From the given information, we have \n\n$$\nT\\cdot v=\\begin{bmatrix}12 \\\\ 4\\end{bmatrix}.\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\nv={T}^{-1}\\cdot \\begin{bmatrix}12 \\\\ 4\\end{bmatrix}.\n$$\n\nNow, we calculate the inverse of $T$:\n\n$$\n{T}^{-1}=\\frac{1}{(5)(1)-(6)(2)}\\begin{bmatrix}1 & -6 \\\\ -2 & 5\\end{bmatrix}=-\\frac{1}{7}\\begin{bmatrix}1 & -6 \\\\ -2 & 5\\end{bmatrix}.\n$$\n\nSo the original vector is\n\n$$\nv=-\\frac{1}{7}\\begin{bmatrix}1 & -6 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}12 \\\\ 4\\end{bmatrix}=-\\frac{1}{7}\\begin{bmatrix}-12 \\\\ -4\\end{bmatrix}=\\begin{bmatrix}\\frac{12}{7} \\\\ \\frac{4}{7}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076946ec-46d4-5873-85ff-636ee2aa9015" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297588}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297588} :answer-field/id #uuid "17419b90-1832-52dd-8245-fd5442b8bab9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298722} {:answer-field/choices [{:answer/id #uuid "999e75d1-03b1-5c94-8973-b6b2b8d5afb6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298218}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298218} :answer-field/id #uuid "bd439d18-e45f-5fdd-b5f8-729abb685c4d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299276}] :question/id #uuid "d578c347-dacb-5c6f-a84e-e7de12176473" :question/math-academy-id "q-317507" :question/problem "The vector $v$ in the plane is mapped to the vector $\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}$ under the action of the linear transformation $T$ whose matrix $T$ is given by\n\n$$\nT=\\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}.\n$$\n\nWhat is the original vector $v?$\n\n| $v=\\,\\,$ |  | {{fie