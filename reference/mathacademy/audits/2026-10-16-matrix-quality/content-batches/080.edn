f3-8ddc-7b3d81bb2458" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280676}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186280581} :answer-field/id #uuid "0933377b-1185-5c82-81ba-572b2e374bc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280846}] :question/id #uuid "d640e1ef-8b1e-5a87-a6d1-5fc3bd1f3743" :question/math-academy-id "q-162200" :question/problem "![](images/da/da6c0fb32e62b6effe133c527fee528c47b6f1c8dc7dd1d77d7d04f42b4c3d2b.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin."} {:db/id #edb/ref 17592186281408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023367fc-8545-563a-b592-eb5deed72636" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186278601} {:answer/id #uuid "09147043-07da-5971-9bf3-822cad3ff0cb" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186278678} {:answer/id #uuid "7f7879f1-8a5d-5414-a209-0e2adedbafed" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186279737} {:answer/id #uuid "8de0e8cb-1f2b-53b2-b630-7bf2d1a789e8" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186279855} {:answer/id #uuid "977fdb51-6e85-5ca3-96b2-572872bb338c" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279932}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186278678} :answer-field/id #uuid "9d401984-9474-531c-9292-760e36a149da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281111}] :question/id #uuid "df351e98-c8ca-5674-9053-41db731d6434" :question/math-academy-id "q-162201" :question/problem "![](images/cf/cfcbd4b374456b4a5913289592d875a42caf81fd02984180e68e34c5b82ef905.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin."} {:db/id #edb/ref 17592186281409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3885463f-c7a6-56fe-997b-ee287cd2f05a" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279085} {:answer/id #uuid "4975f701-587e-5fe7-8e4b-33c70f459982" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186279248} {:answer/id #uuid "99098b8e-da2b-592d-9c1f-e34491bb9744" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186279944} {:answer/id #uuid "bbcb8b58-fc45-5071-a477-b457f2f1ed98" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186280244} {:answer/id #uuid "f3e8043a-a238-5611-b6e7-ef351d2dd477" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186280728}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279085} :answer-field/id #uuid "d543117c-c7fd-56e3-93a4-09da102f0831" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281210}] :question/id #uuid "b8f12922-35f6-5a3b-8472-719f4cc88613" :question/math-academy-id "q-162202" :question/problem "![](images/89/8978d3bb02b4032b6e3a8b4a85878db647eb8323ac5b0423b5a9a6fab121c7e7.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 4 \\\\ -2 & -8\\end{bmatrix}.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 4 \\\\ -2 & -8\\end{aligned}| \\\\  & =1\\cdot (-8)-4\\cdot (-2) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the triangle under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186281410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05708488-ccd8-5605-95df-2765b075bf65" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186278641} {:answer/id #uuid "369dff19-98b2-5c47-b178-8eff0acee120" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186279069} {:answer/id #uuid "68ecfa8f-5ed1-5148-9ee1-64b89343f9aa" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279544} {:answer/id #uuid "70576f09-9a47-5c10-aa7b-96bd3fb89db0" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186279611} {:answer/id #uuid "80a75519-4bb8-5f8d-bf66-bc6c8b0d6879" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186279747}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279544} :answer-field/id #uuid "42a82260-c990-515f-8f88-567fb794bf93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280945}] :question/id #uuid "d076341b-6900-5a76-9cb3-7d856b14ee11" :question/math-academy-id "q-162203" :question/problem "![](images/bf/bfbd80c4e052ae3c286d25b2cd7bf5a1ffcd76ac5a030b7f9b633d0f12517231.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & 6 \\\\ 6 & 9\\end{bmatrix}.\n$$\n\nWhat would be the image of the pentagon shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}4 & 6 \\\\ 6 & 9\\end{aligned}| \\\\  & =4\\cdot 9-6\\cdot 6 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the pentagon under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186281411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0924fc26-ee91-542f-8fa2-ecc58bfba463" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186278680} {:answer/id #uuid "1a9548de-c3e2-5c7a-962f-b96ff5beb190" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186278834} {:answer/id #uuid "8e25faf2-3527-5984-b7f1-7a324619549a" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279858} {:answer/id #uuid "ec716651-bab0-5363-a2ed-e132ee549eaa" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280668} {:answer/id #uuid "fc26313f-bb67-5173-816d-d31934e140d5" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186280800}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279858} :answer-field/id #uuid "a5c88e06-5051-5ab1-8460-abd7ee08e85b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281121}] :question/id #uuid "40140618-61fa-5647-9056-c00bfaadeaae" :question/math-academy-id "q-162204" :question/problem "![](images/2c/2cb5cf6d3307c1291dbbb785cd71ed6edecba3d448afbc2f5f5c2d1128b457c1.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-2 & -4 \\\\ 3 & 6\\end{bmatrix}.\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-2 & -4 \\\\ 3 & 6\\end{aligned}| \\\\  & =(-2)\\cdot 6-(-4)\\cdot 3 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the quadrilateral under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186281412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c7c0bb-04c8-5b68-b839-a1fd420d22a5" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186278631} {:answer/id #uuid "4274a419-61b5-5bce-9898-d900ed5ce294" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186279190} {:answer/id #uuid "92ea8eef-5503-5300-bc03-4d743e1f2f90" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279897} {:answer/id #uuid "bab63e57-284a-556d-a8ec-1e457aefbc37" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186280237} {:answer/id #uuid "c98c1779-760c-5b17-a6d3-2f66a18d07d6" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280356}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279897} :answer-field/id #uuid "0c99b77d-a70e-5910-8a1b-617d614ff6ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280857}] :question/id #uuid "cd1aad0c-e4b0-51b3-9d8d-afbb5058a343" :question/math-academy-id "q-162207" :question/problem "![](images/57/57948af956c9b83ed944fafc26e81a5c003401f753bc520e088ffdbd71915c3a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & -1 \\\\ 3 & -2\\end{bmatrix}.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}2 & -1 \\\\ 3 & -2\\end{aligned}| \\\\  & =2\\cdot (-2)-(-1)\\cdot 3 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, we have a nonsingular matrix. Therefore, the image of our object under the action of  $T$ is a triangle."} {:db/id #edb/ref 17592186281413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1426060a-b9a8-5ec4-8710-e6c7c2d38ab4" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186278772} {:answer/id #uuid "339b5c5c-ee84-5443-a987-f2c7e4d8b1dc" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279040} {:answer/id #uuid "80867be3-b045-5cee-98c3-52438d048a37" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186279745} {:answer/id #uuid "e00b27ca-b875-5773-9299-68d6b7cf0bbe" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280571} {:answer/id #uuid "f725b8b3-2207-5775-b510-4923933df0f2" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186280755}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186278772} :answer-field/id #uuid "7d6fff09-af1e-53fd-b0c2-3a6ff70f73e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281063}] :question/id #uuid "2ee569a9-51ca-558e-aa25-dba25b19b61f" :question/math-academy-id "q-162208" :question/problem "![](images/02/0231cc5aaf661cc873f18ff676a03d66927be48b49d38649efc45860197d18c1.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix}.\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}2 & 0 \\\\ -1 & -1\\end{aligned}| \\\\  & =2\\cdot (-1)-0\\cdot (-1) \\\\  & =-2.\\end{aligned}\n$$\n\nSo, we have a nonsingular matrix. Therefore, the image of our object under the action of  $T$ is a quadrilateral."}] :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :topic/math-academy-id 1351 :topic/title "Singular Linear Transformations in the Plane"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186163036} :activity/id #uuid "fcbebdc5-6295-5f6d-84c8-dd3b196003b8" :activity/steps [{:db/id #edb/ref 17592186163036 :step/content {:db/id #edb/ref 17592186163308 :tutorial/content "Let's consider the least-squares problem $A\\mathbf{x}=\\mathbf{b},$ where \n\n![](images/4d/4d538e6a37eccc1f49f34d3aa1b31a0539d50b351e6029595af1b1f7e0f2967a.svg)\n\nRecall that the corresponding least-squares solution is a vector ${\\hat{\\mathbf{x}}}$ such that \n\n$$\n\\Vert  A{\\hat{\\mathbf{x}}} - \\mathbf{b} \\Vert\n$$\n\nis as small as possible.\n\nIn real-world problems, the coefficients stored in $A$ might come from sources that are not equally reliable. For example, the coefficients might be collected from population surveys with different sample sizes. As a result, we might want to assign a greater \"weight\" to the more reliable data.\n\nFor example, suppose we require the weight of the coefficients in the first row to be twice the weights of the other rows. Then, we can re-state our problem by saying that, for the matrix of weights $W,$ given by\n\n![](images/72/7268fdd7c8701a9cf780342d6eab11015d7764694d17c28a2fae2336db267223.svg)\n\nwe wish to find vectors ${\\hat{\\mathbf{x}}}$ such that \n\n$$\n\\Vert  W (A{\\hat{\\mathbf{x}}} - \\mathbf{b}) \\Vert\n$$\n\nis as small as possible.\n\nTherefore, instead of solving $A\\mathbf x = \\mathbf{b},$ we now need to solve the least-squares problem \n\n$$\nW\\!A\\mathbf x = W\\mathbf{b}.\n$$\n\nTo get the normal equation corresponding to this least-squares problem, we pre-multiply both sides of the equation by $(W\\!A)^T{:}$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n![](images/0c/0c7459270d9d27c40bdf5b0e6dc7eb0c7e17951541b77936804a9057f488c13f.svg)\n\nthe normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}9 \\\\ 0 \\\\ 18\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & -4 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}36 \\\\ 0 \\\\ 18\\end{bmatrix} \\\\ \\begin{bmatrix}9 & -6 \\\\ -6 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}72 \\\\ -54\\end{bmatrix}\\end{aligned}\n$$\n\nSolving the final equation, we obtain the least-squares solution ![](images/72/7259d4c16fa297be7b02cab3ed48a848d1fa73de61c2f14351885072c93c6362.svg)" :tutorial/id #uuid "92c4b629-686d-5377-b646-ffe0dd0d636a" :tutorial/math-academy-id 6076 :tutorial/title "Introduction"} :step/id #uuid "163538b7-47fd-5723-b154-a2b53db447fa" :step/next {:db/id #edb/ref 17592186163037}} {:db/id #edb/ref 17592186163037 :step/content {:db/id #edb/ref 17592186162092 :knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186"} :step/id #uuid "285c2b46-e74a-5ef0-8ec1-c86989af141c" :step/next {:db/id #edb/ref 17592186163038}} {:db/id #edb/ref 17592186163038 :step/content {:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685"} :step/id #uuid "7800afe1-dfc0-5278-8b64-b02ebb92f823" :step/next {:db/id #edb/ref 17592186163045}} {:db/id #edb/ref 17592186163045 :step/content {:db/id #edb/ref 17592186163312 :tutorial/content "Recall that if the solution ${\\hat{\\mathbf{x}}}$ of the least-squares problem $A\\mathbf x=\\mathbf{b}$ is unique, then $A{\\hat{\\mathbf{x}}}$ lies in $\\textrm{Col}(A).$ Furthermore, $A{\\hat{\\mathbf{x}}}$ is the vector in $\\textrm{Col}(A)$ that's closest to $\\mathbf b.$ \n\nIn terms of vector spaces, the vector $A{\\hat{\\mathbf{x}}}$ is the orthogonal projection of $\\mathbf{b}$ onto the subspace spanned by the columns of $A.$ Therefore, the error vector $A{\\hat{\\mathbf{x}}} - \\mathbf{b}$ is orthogonal to $\\textrm{Col}(A).$\n\n![](images/3a/3a1c79036954f0e04212892b7e3d79c75f8cd7b81d7785441f090f89a4eb6faf.png)\n\nA similar property holds for weighted least-squares solutions:\n\n*If the solution ${\\hat{\\mathbf{x}}}$ of the least-squares problem $W\\!A\\mathbf x=W\\mathbf{b}$ is unique, then\n$A{\\hat{\\mathbf{x}}} - \\mathbf{b}$ is orthogonal to $\\textrm{Col}(A)$ with respect to the weighted dot product defined as \n\n$$\n\\langle \\mathbf{x}, \\mathbf{y} \\rangle_W = \\sum_{i=1}^n w_i^2 x_i y_i,\n$$\n\n \nwhere the $w_i$'s are the weights from the main diagonal of the weight matrix $W.$* \n\nWe previously considered the weighted least-squares problem $W\\!Ax=W\\mathbf{b},$ where\n\n![](images/d4/d44c48deb0864fb8fd6aa92ce8af408b600de8abf2039a3f3cd7397fabc7d9fe.svg)\n\nIt's easy to show (using the usual techniques) that the unique weighted least-squares solution is given by \n\n![](images/db/db8f62fcb085d8c1fcfc22bb53cb8f22bd9a65b211e5fd5d4017e30bf9bdb4c7.svg)\n\nComputing our error vector $\\boldsymbol{\\varepsilon} = A{\\hat{\\mathbf{x}}} - \\mathbf{b},$ we get\n\n$$\n\\begin{aligned}ε & =A\\hat{x}-b \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ -6\\end{bmatrix}-\\begin{bmatrix}9 \\\\ 0 \\\\ 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 \\\\ 4 \\\\ 14\\end{bmatrix}-\\begin{bmatrix}9 \\\\ 0 \\\\ 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, let $\\mathbf a_1$ and $\\mathbf a_2$ denote the columns of $A\\mathbin{:}$ \n![](images/3f/3fbafcf3f9d80d2d54089647b2f0239662dcbe56c9ba68539e2303ce752d28ee.svg)\n\nNotice that the error vector $\\boldsymbol{\\varepsilon}$ is *not* orthogonal to the columns of $A\\mathbin{:}$\n\n- Computing $\\boldsymbol{\\varepsilon} \\cdot \\mathbf a_1,$ we have\n\n$$\n\\begin{aligned}ε\\cdot {a}_{1} & =⟨\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}⟩ \\\\  & =(1)(1)+(4)(1)+(-4)(2) \\\\  & =-3 \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Computing $\\boldsymbol{\\varepsilon} \\cdot \\mathbf a_2,$ we have\n\n$$\n\\begin{aligned}ε\\cdot {a}_{2} & =⟨\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix}⟩ \\\\  & =(1)(-1)+(4)(0)+(-4)(-1) \\\\  & =3 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nHowever, if we check the orthogonality with respect to the *weighted* dot product \n\n$$\n\\langle \\mathbf{x}, \\mathbf{y} \\rangle_W = \\sum_{i=1}^n w_i^2 x_i y_i = 4x_1y_1 + x_2y_2 + x_3y_3,\n\\quad\n$$\n\n \n\nwe obtain the following:\n\n$$\n\\begin{aligned}{⟨ε,{a}_{1}⟩}_{W} & ={⟨\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}⟩}_{W} \\\\  & =4(1)(1)+(4)(1)+(-4)(2) \\\\  & =0\\,✓ \\\\ {⟨ε,{a}_{2}⟩}_{W} & ={⟨\\begin{bmatrix}1 \\\\ 4 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix}⟩}_{W} \\\\  & =4(1)(-1)+(4)(0)+(-4)(-1) \\\\  & =0\\,✓\\end{aligned}\n$$\n\nThis means that $A{\\hat{\\mathbf{x}}} - \\mathbf{b}$ is orthogonal to $\\textrm{Col}(A)$ with respect to the weighted dot product. We can write this as\n\n$$\nA{\\hat{\\mathbf{x}}} - \\mathbf{b} \\perp_W \\textrm{Col}(A).\n$$\n\nIn terms of vector spaces, the vector $A{\\hat{\\mathbf{x}}}$ is the orthogonal projection with respect to $\\langle \\mathbf{x}, \\mathbf{y} \\rangle_W$ of the vector $\\mathbf{b}$ onto the subspace spanned by the columns of $A.$ \n\nFurthermore, the weighted least-squares problem with weight matrix $W$ is equivalent to finding a vector ${\\hat{\\mathbf{x}}}$ such that\n\n$$\n\\Vert  A{\\hat{\\mathbf{x}}} - \\mathbf{b} \\Vert_W\n$$\n\nis as small as possible." :tutorial/id #uuid "91e0f414-7785-5748-bba9-04278c6519ad" :tutorial/math-academy-id 6084 :tutorial/title "A Geometric Interpretation of the Weighted Least-Squares Solution"} :step/id #uuid "373b333f-64bb-5518-823a-a53a7c7b2614"}] :activity/title "Weighted Least-Squares" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186162229} {:activity/first-step {:db/id #edb/ref 17592186412663} :activity/id #uuid "5ae33ea6-f725-5358-bc56-131c7aa58050" :activity/steps [{:db/id #edb/ref 17592186412660 :step/content {:db/id #edb/ref 17592186162350 :question/id #uuid "f6bb363c-48b6-5047-89db-8e3fcc537bc7"} :step/id #uuid "41c0539c-002c-5259-832d-9bb45ac8b928" :step/next {:db/id #edb/ref 17592186412662}} {:db/id #edb/ref 17592186412661 :step/content {:db/id #edb/ref 17592186412658 :question/id #uuid "7e019bd1-c120-5401-ab70-85681df29503"} :step/id #uuid "4cdf2d74-0bb9-5a46-a586-06014aa796e7"} {:db/id #edb/ref 17592186412662 :step/content {:db/id #edb/ref 17592186412659 :question/id #uuid "8d91806b-81b0-566e-90e0-48dc8925cff9"} :step/id #uuid "887b3834-be22-5f6c-8700-a163d7c04bba" :step/next {:db/id #edb/ref 17592186412664}} {:db/id #edb/ref 17592186412663 :step/content {:db/id #edb/ref 17592186162349 :question/id #uuid "363b8573-3582-5360-9547-0ffac7abdb28"} :step/id #uuid "9b0b78c1-38dc-5b63-a705-26a38e682db9" :step/next {:db/id #edb/ref 17592186412660}} {:db/id #edb/ref 17592186412664 :step/content {:db/id #edb/ref 17592186411867 :question/id #uuid "9a9c63b9-55aa-5f88-8ff0-b14dd8c3b850"} :step/id #uuid "bf465e2e-a5d2-5c64-9820-18efd555ee8e" :step/next {:db/id #edb/ref 17592186412661}}] :activity/title "Weighted Least-Squares" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186412633} {:activity/first-step {:db/id #edb/ref 17592186443610} :activity/id #uuid "f2ca585c-f31d-5154-8e11-9d2a532a2dd5" :activity/steps [{:db/id #edb/ref 17592186443608 :step/conten