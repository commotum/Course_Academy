86533693} :answer-field/id #uuid "bf25c4a2-9615-55e8-80a6-24984ffb6cf7" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186533917} {:answer-field/choices [{:answer/id #uuid "419158cf-70f2-5d91-9b6b-0f00e29a1aaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(4t)" :db/id #edb/ref 17592186533292} {:answer/id #uuid "64ccc164-6f92-55cc-b816-e8d3b84684ba" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186533371} {:answer/id #uuid "724fa316-216e-5af0-a347-af472a9d82cf" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}\\operatorname{cos}⁡(4t)" :db/id #edb/ref 17592186533410} {:answer/id #uuid "9d98fb9d-a2c6-5309-af86-4809c290749f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186533521}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{e}^{t}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186533371} :answer-field/id #uuid "e8c1cd63-d0f9-5260-bcca-72e12c1a3c69" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186533944}] :question/id #uuid "603584a6-4f57-5f62-89eb-94456ff5e429" :question/math-academy-id "q-333740" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t)-4y(t) \\\\ {y}^{′}(t)=4x(t)+y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1,2}=1\\pm 4\\text{i},$ for which the corresponding eigenvectors are ${v}_{1,2}=[\\pm \\text{i},1]^{T},$ respectively. Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{t}[\\begin{aligned}\\operatorname{cos}⁡(4t) \\\\ \\operatorname{sin}⁡(4t)\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}-\\operatorname{sin}⁡(4t) \\\\ \\operatorname{cos}⁡(4t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFor example, when ${c}_{1}=1$ and ${c}_{2}=0,$ we obtain the following curve:\n\n$$\n\\{\\begin{aligned}x={{field-1}} \\\\ y={{field-2}}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $0$ | $\\frac{\\pi }{16}$ | $\\frac{\\pi }{8}$ |\n| --- | --- | --- | --- |\n| $x$ | $1$ | $0.86$ | {{field-3}} |\n| $y$ | $0$ | $0.86$ | {{field-4}} |\n\nLet's sketch this solution in the phase space.\n\n![](images/50/50b71bd4aefb94179b55a94992f9e7a42b9ddbd50cd3a9dcf17645f4afd4846c.png)\n\nAs $t\\to \\infty ,$ the curve\n{{field-5}}.\nSo, we have\n{{field-6}}\nthat is traversed \n{{field-7}}.\n\nThe spiral is traversed toward \n{{field-8}}\nas $t\\to \\infty .$\n\nThe {{field-9}} of our system looks as follows:\n\n![](images/f6/f60bdf0ec9c734a1d0d352c448b2c829869ba9fe0115bd860f639b9e4dc83cd0.png)" :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{t}[\\begin{aligned}\\operatorname{cos}⁡(4t) \\\\ \\operatorname{sin}⁡(4t)\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}-\\operatorname{sin}⁡(4t) \\\\ \\operatorname{cos}⁡(4t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFor example, when ${c}_{1}=1$ and ${c}_{2}=0,$ we obtain the following curve:\n\n$$\n\\{\\begin{aligned}x={e}^{t}\\operatorname{cos}⁡(4t) \\\\ y={e}^{t}\\operatorname{sin}⁡(4t)\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $0$ | $\\frac{\\pi }{16}$ | $\\frac{\\pi }{8}$ |\n| --- | --- | --- | --- |\n| $x$ | $1$ | $0.86$ | $0$ |\n| $y$ | $0$ | $0.86$ | $1.48$ |\n\nLet's sketch this solution in the phase space.\n\n![](images/50/50b71bd4aefb94179b55a94992f9e7a42b9ddbd50cd3a9dcf17645f4afd4846c.png)\n\nNotice that $|\\operatorname{sin}⁡(4t)|\\le 1$ and $|\\operatorname{cos}⁡(4t)|\\le 1$ but ${e}^{t}\\to \\infty $ as $t\\to \\infty .$ Thus, the curve $\\text{diverges}$ as $t\\to \\infty .$ So, we have $\\text{a spiral}$ that is traversed $\\text{counterclockwise}.$\n\nAgain, since ${e}^{t}\\to \\infty $ as $t\\to \\infty ,$ the spiral is traversed toward $\\text{infinity}$ as $t\\to \\infty .$\n\nThe $\\text{phase portrait}$ of our system looks as follows:\n\n![](images/f6/f60bdf0ec9c734a1d0d352c448b2c829869ba9fe0115bd860f639b9e4dc83cd0.png)"}] :knowledge-point/title "Sketching the Phase Portrait of a System"} {:db/id #edb/ref 17592186166942 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166551 :question/id #uuid "7b4f569b-ad3a-5a93-a53e-27a186b7700e" :question/math-academy-id "e-21658" :question/problem "The phase portrait for a system of linear differential equations whose matrix has two complex eigenvalues $\\lambda = a \\pm b\\text{i}$ is shown above. Provide an interpretation of the portrait and determine the possible values of $a.$\n\n![](images/6d/6d13d0dfadac45d40b74cb7e740a880305098f0939e2f45d74706c4022183c54.png)" :question/worked-solution "Let $\\mathbf{v}=\\mathbf{p}+\\mathbf{q}\\text{i},$ where $\\mathbf{p},\\mathbf{q} \\in \\mathbb{R}^2,$ be an eigenvector corresponding to the eigenvalue $\\lambda = a + b\\text{i}.$\n\nThen, a complex solution of the system is given by\n\n$$\n\\mathbf{x}_{\\text{complex}}(t) = \\mathbf{v} e^{\\lambda t}.\n$$\n\nUsing Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{\\text{complex}}(t) & =v{e}^{(a+b\\text{i})t} \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)+\\text{i}\\operatorname{sin}⁡(bt))(p+q\\text{i}) \\\\  & ={e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+\\text{i}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q).\\end{aligned}\n$$\n\nTherefore, the general solution of the system is\n\n$$\n\\textbf{x}(t) = \nc_1 e^{at}\\big(\\cos(bt)\\mathbf{p}-\\sin(bt)\\mathbf{q}\\big) + \nc_2 e^{at}\\big(\\sin(bt)\\mathbf{p}+\\cos(bt)\\mathbf{q}\\big),\n$$\n\nwhere the parts $\\big(\\cos(bt)\\mathbf{p}-\\sin(bt)\\mathbf{q}\\big)$ and $\\big(\\sin(bt)\\mathbf{p}+\\cos(bt)\\mathbf{q}\\big)$ are bounded.\n\nNow notice that the given curve is unbounded, representing a spiral that is traversed counterclockwise. Thus, we must have $a \\neq 0.$\n\nAlso, notice that the spiral is traversed toward the origin.\n\nHence, to insure that $e^{at} \\to 0,$ we require $a < 0.$"} :knowledge-point/id #uuid "b542bd66-f4f8-5b4e-a3e7-4717827c427a" :knowledge-point/questions [{:db/id #edb/ref 17592186167229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd46fd9-4ec6-5d4d-b935-c34269ce5266" :answer/type {:db/ident :answer.type/math} :answer/value "a=0" :db/id #edb/ref 17592186548524} {:answer/id #uuid "d93ff637-1a41-5c2a-a409-3b1e7bff5ef7" :answer/type {:db/ident :answer.type/math} :answer/value "b=0" :db/id #edb/ref 17592186548778} {:answer/id #uuid "e0d1f152-2d71-5a47-a7da-fd041217b7f8" :answer/type {:db/ident :answer.type/math} :answer/value "a\\ne 0" :db/id #edb/ref 17592186548789}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "a=0" :db/id #edb/ref 17592186548524} :answer-field/id #uuid "a5178042-2ee2-5608-860d-fde87cfb2607" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164433} {:answer-field/choices [{:answer/id #uuid "fa9f4f97-14d1-55b4-9c75-c0369f27d217" :answer/type {:db/ident :answer.type/text} :answer/value "counterclockwise" :db/id #edb/ref 17592186164438} {:answer/id #uuid "78ed1003-d99d-5872-97f8-588ec6238b27" :answer/type {:db/ident :answer.type/text} :answer/value "clockwise" :db/id #edb/ref 17592186164439}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "clockwise" :db/id #edb/ref 17592186164439} :answer-field/id #uuid "229c4e17-18f4-5a25-a3a7-ad03a2c43219" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164437} {:answer-fiel