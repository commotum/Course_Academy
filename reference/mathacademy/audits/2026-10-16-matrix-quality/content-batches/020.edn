 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 2 & -6 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -1 & -8 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2w &=-2 \\\\ y+w &=-6 \\\\ z-3w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2w-2 \\\\ y &=-w-6 \\\\ z &=3w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ff2e8-5074-588e-a4a9-3d3cfb18d3bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557506} {:answer/id #uuid "3076215c-304a-5d01-86d1-3ff9741ff4dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557512} {:answer/id #uuid "3fb3301d-33c0-5158-a03e-64250a27b511" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -4z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557518} {:answer/id #uuid "3febba3a-efe2-57ba-8af5-de2985e82134" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z+4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557519} {:answer/id #uuid "48c2af1b-9196-5808-96db-88b7f04e41cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557524}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557524} :answer-field/id #uuid "149fd90e-5691-5c54-8ab7-8d87034698b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557508}] :question/id #uuid "d05ea200-995d-55b2-a1b7-0a4ae934dd54" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y-8z &=-16 \\\\ 2x-y+4z &=-10 \\\\ 2x-5y-12z &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -4 & -8 & -16 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 2 & -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 3 & 12 & 6 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0da7ae-0be2-5a15-bb78-e9aa6a4e73bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557526} {:answer/id #uuid "7271e45f-8553-5ce0-acb1-6c300273e818" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z+3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557533} {:answer/id #uuid "8ccb0a70-9168-5376-aab3-e2bf68061d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} {:answer/id #uuid "b8bdf101-8a17-59f6-92cc-0d92a551d21e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ 5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557555} {:answer/id #uuid "f5a634f4-002a-58cb-96bc-17a4efd0a7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+5 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557568}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} :answer-field/id #uuid "a2993581-de40-5699-b32f-c45f7304d89a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557546}] :question/id #uuid "f34874f6-66c0-58d0-a503-ac8424ffc0ef" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-2z &=-16 \\\\ 2x+y+7z &=-1 \\\\ 2x+4z &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 3 & 9 & 15 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce1dc0c-75ef-52c2-bd4b-bf75d5f2e8dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+6 \\\\ 3z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557510} {:answer/id #uuid "3bf6b08b-6231-5a56-a8e3-c43b285af62d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z-4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557516} {:answer/id #uuid "86cd4be6-2d2c-56d7-b46a-2c157bb80402" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557537} {:answer/id #uuid "d2124629-8825-54e6-8828-d3638950e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557559} {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564} :answer-field/id #uuid "33817d11-0d35-5223-ad95-222c9e4cd34e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557514}] :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"} {:db/id #edb/ref 17592186115242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115071 :question/id #uuid "f2c7cfd3-da43-5208-bd0e-21692357fabe" :question/math-academy-id "e-4712" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-2y &=1, \\\\ 4x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n![](images/6f/6fa4508463b059ce8ef9a5cfa720de9463e41ecdbfb16f4460870bb6fce444bc.svg)\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -2 & 1 \\\\ 4 & k & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & k+4 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n![](images/21/215ff061dc7584055bf607f48d0048cb6bde4dcb1ed028fbf4c3a4bd47d89c25.svg)\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} :knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5" :knowledge-point/question-generator {:db/id #edb/ref 17592186557445 :question-generator/id #uuid "8ae9e325-9ab6-53e2-9f58-322c0a6527aa" :question-generator/script "generate/scratch/17592186115242.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186115753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3248af5c-24d6-51a0-a62b-8d5ab0e0e782" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300213} {:answer/id #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} {:answer/id #uuid "6b3ca3f5-57b3-5b3c-b6b4-0772e9be135c" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{4}" :db/id #edb/ref 17592186300503} {:answer/id #uuid "6f2681ec-b8ae-51dc-9094-2e2bcadf6d8a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300522} {:answer/id #uuid "fad186f0-c1c8-5bcc-8cc3-09b1f4f1ed49" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{4}{3}" :db/id #edb/ref 17592186301203}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} :answer-field/id #uuid "9bc72922-bebc-50a1-a8ff-483d8fbfcfc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301729}] :question/id #uuid "2a9a3feb-6c16-50e8-885d-ee5cd242ab95" :question/math-academy-id "q-32246" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+4y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 4 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 4 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 4-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (4-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{4}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186115831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359439f2-81e1-5ced-8482-b2cf08a71409" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186425939} {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} {:answer/id #uuid "545c0eb7-c35a-5d44-b8e2-b045ff203715" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186425942} {:answer/id #uuid "684ddf9d-dd44-5397-b1a8-e6e3ca6a2f95" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186425943} {:answer/id #uuid "9720657d-4e06-51f7-8e91-da074201b940" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186425945}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} :answer-field/id #uuid "e3a07998-8f4c-5e30-bdee-b2acbf389fbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113923}] :question/id #uuid "84cf8820-fa64-5d50-9d9c-d3a9404788a4" :question/math-academy-id "q-42059" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ 6x+(k+3)y &=-5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 1 \\\\ 0 & k-6 & -8\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+3y &=1 \\\\ (k-6)y &=-8.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=-8,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186266116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d8234-d927-5fa4-9649-52a3600a14ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} {:answer/id #uuid "59917889-7526-5cea-90f8-6ed9b5d31888" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186263771} {:answer/id #uuid "84ec393a-992f-55d2-9044-1e362627ed1c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264142} {:answer/id #uuid "9556b060-0b9f-5486-b05c-79753916db1d" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264279} {:answer/id #uuid "c483c739-bc7d-5f47-8dbf-09da12b3a0b2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-14" :db/id #edb/ref 17592186264722}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} :answer-field/id #uuid "4c23e17f-c925-52e8-86bd-0f648e063de0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265388}] :question/id #uuid "7d3ed27b-d876-58c6-8a51-55f4b36743e6" :question/math-academy-id "q-131726" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ 6x+(k+9)y &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 \\\\ 0 & k+13 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-3x+2y &=1 \\\\ (k+13)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-13,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-13.$"} {:db/id #edb/ref 17592186266117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4e76fd-e1c6-5cbe-93b0-49387b6d03cd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263361} {:answer/id #uuid "c2f1c78c-35e7-5dc3-a4ea-917746946f9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264698} {:answer/id #uuid "cad2e0cc-59d8-5847-8c17-7f7022f7428b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186264775} {:answer/id #uuid "ddd34857-39b4-5a84-88c6-46284b56c129" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264929} {:answer/id #uuid "f74d0318-2803-55b8-bb5b-49c8150dea17" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163} :answer-field/id #uuid "80ce296a-26b4-5d5b-bab5-71101c246341" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265471}] :question/id #uuid "0e7e4e8f-70c3-5d1c-92c5-d1d6f120ba7c" :question/math-academy-id "q-131727" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ 4x+3ky &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & -1 \\\\ 0 & 3k+12 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-1 \\\\ (3k+12)y &=7.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186266118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3a6e2e-1b7a-5ad1-b366-2deecae63253" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186264216} {:answer/id #uuid "96b3aa58-5c89-5f3c-896e-547bdfeef87c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} {:answer/id #uuid "9c0fed83-26f2-58cf-9e61-edca1345442b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186264336} {:answer/id #uuid "bedfa238-a1cb-50f4-b26d-08ac9994d923" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264662} {:answer/id #uuid "cffb3874-d3c5-58d9-9efc-875fe9730f23" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186264822}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} :answer-field/id #uuid "567ae966-e7d1-5296-a3f6-661d2e59d117" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265397}] :question/id #uuid "5288d9bb-0110-5357-979f-882b0ee060b3" :question/math-academy-id "q-131728" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ -3x+(3k+15)y &=-4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 4 & -2 \\\\ 0 & 3k+3 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-x+4y &=-2 \\\\ (3k+3)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-1,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-1.$"} {:db/id #edb/ref 17592186266119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427da7e5-15ac-51bd-a759-d90b6c65d454" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{7}" :db/id #edb/ref 17592186263588} {:answer/id #uuid "538a47b2-6a0b-5a53-99e0-b4e09df09626" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186263720} {:answer/id #uuid "7f383d71-c4b1-501b-823d-dfdddaac22d3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{7}{2}" :db/id #edb/ref 17592186264099} {:answer/id #uuid "b60949ed-65e4-5904-90e9-755392f2794a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} {:answer/id #uuid "d7266032-5cfb-59d1-b694-4b3ac335232b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264875}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} :answer-field/id #uuid "446ceb46-6d4a-51ab-82b3-1f055fd41555" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265373}] :question/id #uuid "49ba50cf-14b7-5be4-8660-2e096dc4c172" :question/math-academy-id "q-131729" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+7y &=6 \\\\ x+ky &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 7 & 6 \\\\ 1 & k & -3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ -2 & 7 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -3 \\\\ 0 & 2k+7 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=-3 \\\\ (2k+7)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-\\frac{7}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=-3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-\\frac{7}{2}.$"} {:db/id #edb/ref 17592186266120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5280ce29-a009-5d89-b11c-32a91956f88d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} {:answer/id #uuid "a8cf5fce-3112-5b03-8cf3-0d4a08494133" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186264442} {:answer/id #uuid "bac8e055-43dd-52ec-b2ee-c1af2bc589d4" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264621} {:answer/id #uuid "bf50ed27-034a-525d-8d4e-b76acf4ead2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186264666} {:answer/id #uuid "d2c3e1a0-f525-5859-8a97-2dbc90d7ad24" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264838}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} :answer-field/id #uuid "fe108dd5-5b35-596c-94e7-349c53f9ba7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265698}] :question/id #uuid "87026642-3a4d-5af1-8cd6-01d366fc76fa" :question/math-academy-id "q-131731" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ 5x+(k-6)y &=10\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 6 & -4 \\\\ 0 & k+9 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-2x+6y &=-4 \\\\ (k+9)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-9,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $-2x+6y=-4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-9.$"} {:db/id #edb/ref 17592186302109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eefeb35-a93a-5693-8a54-a335560cde62" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300764} {:answer/id #uuid "a14a43e5-9b21-562f-aaa1-5f805da32173" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300773} {:answer/id #uuid "a2621a0b-e192-593d-b62d-8165fb69e7a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300778} {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} {:answer/id #uuid "f15a5a0a-88a7-5b7b-9e41-9d091c25e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186301152}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} :answer-field/id #uuid "0c0fdc5a-0dcc-576e-afcb-e159db8dd3fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301262}] :question/id #uuid "534e2a93-e71a-5475-894e-dfd5ca99a3a6" :question/math-academy-id "q-32245" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ 4x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ 4 & k & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k+2 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k+2)y &=-2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nNow if $k=-2$, then the second equation is $0=-2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when  $k=-2.$"} {:db/id #edb/ref 17592186302143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} {:answer/id #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300297} {:answer/id #uuid "7951ba97-6d77-594c-84f6-7b1ce6a00426" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186300560} {:answer/id #uuid "8713309c-6e3b-5cbf-9236-a21b2e8d5efd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186300642} {:answer/id #uuid "99ccc30d-db87-5ff3-b366-54bc530fc04c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300734}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} :answer-field/id #uuid "7a94e5ac-1c4c-5f66-9534-54809e136ec5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301608}] :question/id #uuid "f5f8dda9-f72e-566e-91bc-44ecdce08b8e" :question/math-academy-id "q-32331" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ 8x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-4 & -1 & 2 \\\\ 8 & k & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -1 & 2 \\\\ 0 & k-2 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ (k-2)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=2,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=2.$"} {:db/id #edb/ref 17592186344961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9a3770-af37-58af-91e7-3430fd2463b3" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186343154} {:answer/id #uuid "71cae964-c567-5585-ab23-7241fb114732" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186343221} {:answer/id #uuid "a8f3da90-4b17-5b45-af78-2746f79a0b95" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186343724} {:answer/id #uuid "ad97781e-f202-56a0-803a-f17ee1a49ca9" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186343764} {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356} :answer-field/id #uuid "6517af05-6089-578f-972a-9310f8010c94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344664}] :question/id #uuid "a0c28bd7-70de-59aa-93c9-933cbaca4593" :question/math-academy-id "q-74646" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ 2x+(k+1)y &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & 2 \\\\ 0 & k-7 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+4y &=2 \\\\ (k-7)y &=-1.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=-1,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186344969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30949865-bcb4-5324-b20a-5013ed16ed8b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186342643} {:answer/id #uuid "b02857e6-f7e6-504c-84a4-ca08044eec2c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186343786} {:answer/id #uuid "bd377e49-f3f5-59d7-82a4-fcccc36aefd5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186343902} {:answer/id #uuid "cffbe52d-faab-5e8d-a8c2-edecdb561a49" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} {:answer/id #uuid "d763087a-bc9a-5f66-ac0e-8fa93b6ecd3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344130}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} :answer-field/id #uuid "78098d80-b356-5405-a056-ca928a0838fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344710}] :question/id #uuid "bdfa86e8-f2dc-5d19-9144-98ae43ab2ede" :question/math-academy-id "q-74688" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ 3x+2ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -4 \\\\ 0 & 2k-6 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+2y &=-4 \\\\ (2k-6)y &=10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=3,$ then the second equation is $0=10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=3.$"} {:db/id #edb/ref 17592186344971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba1e46b-dcb4-5f9e-b60f-f807d3ae1d2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{4}" :db/id #edb/ref 17592186342339} {:answer/id #uuid "47f4259f-5c12-50a0-8a37-001fbf58b6db" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186342833} {:answer/id #uuid "761008e6-93b4-567d-8e13-46b3d3b90948" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186343257} {:answer/id #uuid "ec9c9c6a-7091-5c96-a5e5-dd27877f775b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344317} {:answer/id #uuid "fa6d777f-a907-5d3e-9303-b5a3d04a19d9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{8}" :db/id #edb/ref 17592186344440}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186343257} :answer-field/id #uuid "4c8919c1-08e4-5d2b-8a8d-6b97ba594aea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344620}] :question/id #uuid "db41cb50-724f-5af7-85df-697ff3307e10" :question/math-academy-id "q-74695" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}4x+2y &=-8 \\\\ x+ky &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & 2 & -8 \\\\ 1 & k & -2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 4 & 2 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & -2 \\\\ 0 & 2-4k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=2 \\\\ (2-4k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{1}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=2.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186398982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3df6cd2-68c7-5027-b94c-cebc3edbefd0" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186398984} {:answer/id #uuid "3d7403d1-9523-59ef-892c-8762070fc770" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{2}" :db/id #edb/ref 17592186398985} {:answer/id #uuid "43b3ca27-4022-5e94-91a9-05d77b4b0c3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186398986} {:answer/id #uuid "321a43c8-209e-53e7-bddf-716f4dd735c7" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186398987} {:answer/id #uuid "a9f1972b-cdc9-5bbd-bf68-8c034ebe8712" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186398988}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186398987} :answer-field/id #uuid "ce520123-e722-5fc8-b4b5-0ce963a1fe4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398983}] :question/id #uuid "2b1df7fe-03a7-50e4-93e7-ab9ba910308e" :question/math-academy-id "q-74650" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ x+(k+1)y &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 6 & 4 \\\\ 0 & k-2 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ (k-2)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=2,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $2x+6y=4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=2.$"} {:db/id #edb/ref 17592186417082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0250b550-0b7c-5c05-b8f5-33da7345f93c" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186417069} {:answer/id #uuid "0e30254f-fef5-5030-ad74-62323657f390" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186417070} {:answer/id #uuid "32810e7f-ad8d-5b1e-a7d2-839ff11f12a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186417071} {:answer/id #uuid "5b0d5bd9-5c97-5445-afdc-58640864c07d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{3}" :db/id #edb/ref 17592186417074} {:answer/id #uuid "e23cbcca-7092-5855-aeeb-dd2de6061a27" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{2}" :db/id #edb/ref 17592186417078}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186417071} :answer-field/id #uuid "26b28742-5ee2-597a-8428-7062724625e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417079}] :question/id #uuid "6deb5ca1-ae5b-5721-895d-6efa8ac5fdfb" :question/math-academy-id "q-131730" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}3x+2y &=12 \\\\ x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 2 & 12 \\\\ 1 & k & 4\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 3 & 2 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & k & 4 \\\\ 0 & 2-3k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+ky &=4 \\\\ (2-3k)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{2}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{2}{3}.$"} {:db/id #edb/ref 17592186425949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17602323-8777-51fe-9a70-fac173438e8d" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186425938} {:answer/id #uuid "3745dd5b-bc8f-5c5f-bfbb-0a70d0ee8eee" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186425940} {:answer/id #uuid "8c1862b9-030a-5755-b668-e59ca4c9e456" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186425944} {:answer/id #uuid "a1294db0-0da9-5a02-b9e5-791ef34dcf11" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186425946} {:answer/id #uuid "cf6dc1f0-4ead-53bf-8e9f-9b57805aa51d" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186425947}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186425947} :answer-field/id #uuid "80130b9b-78a0-54cc-bf84-e036ce6c2ff0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425948}] :question/id #uuid "db005b4e-86cd-5194-b2fd-10ca4ee59c03" :question/math-academy-id "q-42021" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ -3x-(k+1)y &=-9\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 \\\\ -3 & -(k+1) & -9\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 3 \\\\ -3 & -(k+1) & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & -k+5 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}1-2y &=3 \\\\ -(k-5)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=5,$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+2y=3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=5.$"} {:db/id #edb/ref 17592186492874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7b0d87-9712-510c-adb7-5bde077204da" :answer/type {:db/ident :answer.type/math} :answer/value "k=10" :db/id #edb/ref 17592186492235} {:answer/id #uuid "58ea3fc2-519f-5eea-8c33-6dce5b9c6e3d" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186492389} {:answer/id #uuid "8133480e-57da-5ca9-9bce-a1b99fc82856" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186492477} {:answer/id #uuid "a85d27da-01e0-5767-a1e4-b5479a5241b4" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186492558} {:answer/id #uuid "da15d75f-b174-5630-b7ee-c26933c1301a" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186492646}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186492477} :answer-field/id #uuid "df2effb2-e366-52f0-a14b-bc202d0cbc2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492799}] :question/id #uuid "7409a043-b196-5341-8318-5b111a0c527e" :question/math-academy-id "q-131725" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+(k-5)y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & k-7 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k-7)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186557414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124ff963-b72f-5e65-b019-142dc4093408" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557411} {:answer/id #uuid "495a45f0-bf5a-5f2b-853f-98a9a40f50da" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186557417} {:answer/id #uuid "be3cc917-c1ca-51f1-b1a3-22d23039ef3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557437} {:answer/id #uuid "cf92e2a8-ab48-5340-bcba-2883848e6c01" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186557439} {:answer/id #uuid "d1ed5e36-0fb0-57ce-baac-38fe4ee2f4d2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186557440}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186557437} :answer-field/id #uuid "ba282d53-b116-5cfa-b41a-8b04b5bb86c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557436}] :question/id #uuid "2d5b5966-d0b2-51ba-a7a1-c76ebe8e6658" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ 2x+ky &=-8\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 2 & k & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & k-6 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+3y &=-5 \\\\ (k-6)y &=2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186557415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c268bc9-b98d-5227-b731-95e04d9c3527" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186557418} {:answer/id #uuid "ad10948b-c229-52b4-8bd9-550ddae2c192" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186557432} {:answer/id #uuid "b131d745-d31e-5a08-8285-4bc65717285c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186557433} {:answer/id #uuid "b28ffa47-7c40-5583-883d-0cf4b033e17f" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186557434} {:answer/id #uuid "db4baf4b-c62c-5894-9637-6b82ba9cf1c0" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186557443}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 175921865