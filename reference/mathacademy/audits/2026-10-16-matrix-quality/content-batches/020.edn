\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44d858c6-36e5-5228-a036-e8c30e129ec4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186393440} {:answer/id #uuid "b18343b0-1c7e-5b30-98ce-ceafad393a04" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186393441} {:answer/id #uuid "b84042c5-ba1a-5cd7-9cc2-1b2349158b3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186393442} {:answer/id #uuid "51d9493e-7fde-5dc6-bef8-ba7a9dbe9b92" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186393443} {:answer/id #uuid "34eb6041-c57a-5542-a98e-005314b126f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186393444}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186393441} :answer-field/id #uuid "f7bae7b3-cdd8-57c9-ab74-b804a04463ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393439}] :question/id #uuid "d3aabb18-a945-51e2-bce9-9f0029a0d83e" :question/math-academy-id "q-74774" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(4{v}_{1}-5{v}_{2})=\\begin{bmatrix}-13 \\\\ 6\\end{bmatrix}\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(4{v}_{1}-5{v}_{2}) & =4T({v}_{1})-5T({v}_{2}) \\\\ \\begin{bmatrix}-13 \\\\ 6\\end{bmatrix} & =4\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}-5T({v}_{2}) \\\\ 5T({v}_{2}) & =4\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}-13 \\\\ 6\\end{bmatrix} \\\\ 5T({v}_{2}) & =\\begin{bmatrix}-8 \\\\ 16\\end{bmatrix}-\\begin{bmatrix}-13 \\\\ 6\\end{bmatrix} \\\\ 5T({v}_{2}) & =\\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\ T({v}_{2}) & =\\frac{1}{5}\\begin{bmatrix}5 \\\\ 10\\end{bmatrix} \\\\ T({v}_{2}) & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"} {:db/id #edb/ref 17592186087749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087565 :question/id #uuid "fc3159fb-751c-55d6-b41e-4744b80b0ae9" :question/math-academy-id "e-5430" :question/problem "Consider a linear transformation $\\mathbf{T}.$ If $\\mathbf{v}_1 + \\mathbf{v}_2=\\mathbf{0}$ and $\\begin{bmatrix}9 \\\\ -12 \\\\ 8\\end{bmatrix}$ then find $\\mathbf{T}(17\\mathbf{v}_1+12\\mathbf{v}_2).$" :question/worked-solution "First, since $\\mathbf{v}_1 + \\mathbf{v}_2=\\mathbf{0},$ we have that \n\n$$\n\\begin{aligned}17{v}_{1}+12{v}_{2} & =5{v}_{1}+12{v}_{1}+12{v}_{2} \\\\  & =5{v}_{1}+12({v}_{1}+{v}_{2}) \\\\  & =5{v}_{1}+12(0) \\\\  & =5{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\mathbf{T}(17\\mathbf{v}_1+12\\mathbf{v}_2)=\\mathbf{T}(5\\mathbf{v}_1).\n$$\n\nNow, since $\\mathbf{T}$ is a linear transformation, we have that $\\mathbf{T}(k\\mathbf{v})=k\\mathbf{T}(\\mathbf{v}).$ So \n\n$$\n\\begin{aligned}T(5{v}_{1}) & =5T({v}_{1}) \\\\  & =5\\begin{bmatrix}9 \\\\ -12 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}45 \\\\ -60 \\\\ 40\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $\\begin{bmatrix}45 \\\\ -60 \\\\ 40\\end{bmatrix}$"} :knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/questions [{:db/id #edb/ref 17592186088148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05950c08-5