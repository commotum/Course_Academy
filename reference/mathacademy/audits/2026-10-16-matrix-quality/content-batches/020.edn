^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa35b3d1-b162-5941-885d-8db182d4c937" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402069} {:answer/id #uuid "47bb5c03-56ca-5b3a-9ba9-d6c4be7af812" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402070} {:answer/id #uuid "72f7434b-6af7-53ee-bdbc-e38c8f39837c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402071} {:answer/id #uuid "5f0e91d3-d561-5c05-80db-683f07d1c4f4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402072} {:answer/id #uuid "93e87a9b-599c-5a66-8fb7-bd8983873641" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402073}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402070} :answer-field/id #uuid "0fe2e4cc-de53-5a7a-8325-103564fb6a3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402068}] :question