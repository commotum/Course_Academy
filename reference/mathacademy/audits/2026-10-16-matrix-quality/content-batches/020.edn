{bmatrix}-9 \\\\ 12\\end{bmatrix}) & =T(-3\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}) \\\\  & =-3T(\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}) \\\\  & =-3\\begin{bmatrix}8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d613a2b-d0d2-5dd0-bfcb-0d04309c5e3a" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186297794}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186297794} :answer-field/id #uuid "313839fd-a6cf-55e8-9a6d-05dd7088a5a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298805} {:answer-field/choices [{:answer/id #uuid "eea9481f-8b3d-5fe0-96bc-7cf284e89469" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186298565}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186298565} :answer-field/id #uuid "5b3b2c01-106d-53a3-ab4d-0f90ccfccd4d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298948}] :question/id #uuid "b3bd5812-a3be-55f7-b7db-dd1cb0d14ecb" :question/math-academy-id "q-317699" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix})=\\begin{bmatrix}-18 \\\\ 36\\end{bmatrix}$, then find $T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}).$\n\n| $\\,T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}=2\\begin{bmatrix}3 \\\\ -6\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}) & =T(2\\begin{bmatrix}3 \\\\ -6\\end{bmatrix})=2T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix})=\\begin{bmatrix}-18 \\\\ 36\\end{bmatrix},\n$$\n\nwe must have\n\n$$\n\\begin{aligned}2T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}) & =\\begin{bmatrix}-18 \\\\ 36\\end{bmatrix} \\\\ T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}) & =\\frac{1}{2}\\begin{bmatrix}-18 \\\\ 36\\end{bmatrix} \\\\ T(\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}) & =\\begin{bmatrix}-9 \\\\ 18\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f2322a-148e-5026-8d94-f7a8eba14014" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186297566}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186297566} :answer-field/id #uuid "3c72cc3a-ae60-5085-b0d7-ce1454099854" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298841} {:answer-field/choices [{:answer/id #uuid "f6566f0d-a1d6-5e86-95ef-5fb26078a912" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186298603}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186298603} :answer-field/id #uuid "942dbde4-ca15-5362-b6a0-dc19f4d8408f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299128}] :question/id #uuid "9c06dea6-5de4-5173-b157-ea0b01e55c52" :question/math-academy-id "q-317703" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix})=\\begin{bmatrix}7 \\\\ -11\\end{bmatrix}$, then find $T(\\begin{bmatrix}-6 \\\\ 10\\end{bmatrix}).$\n\n| $\\,T(\\begin{bmatrix}-6 \\\\ 10\\end{bmatrix})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}-6 \\\\ 10\\end{bmatrix}=2\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}-6 \\\\ 10\\end{bmatrix}) & =T(2\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}) \\\\  & =2T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}) \\\\  & =2\\begin{bmatrix}7 \\\\ -11\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 \\\\ -22\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14aef52c-4281-534e-a4f4-7e89ef9efa70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186321316} {:answer/id #uuid "39770b01-1521-5634-8d8e-a8d5aab939b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ -10\\end{bmatrix}" :db/id #edb/ref 17592186321584} {:answer/id #uuid "6a5b6fe3-b145-5e80-b543-b7b59ca07995" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186321977} {:answer/id #uuid "c94d7abe-9be9-57c8-bdb5-b0b7fe1292ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186322714} {:answer/id #uuid "da1b1b2c-8043-564a-8e5c-18ed72e65a99" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186322855}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186322714} :answer-field/id #uuid "9227e2e9-45e7-5146-999e-879c9a38f64e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323453}] :question/id #uuid "71cd0047-bb0e-5e6f-8a23-200305fdb068" :question/math-academy-id "q-37870" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}8 \\\\ 16\\end{bmatrix})=\\begin{bmatrix}28 \\\\ -20\\end{bmatrix}$, then find $\\,T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}).$" :question/worked-solution "Since $\\,T\\,$ is a linear transformation, it must satisfy $\\,T(kv)=kT(v).$ Noting that $\\begin{bmatrix}8 \\\\ 16\\end{bmatrix}=4\\begin{bmatrix}2 \\\\ 4\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}8 \\\\ 16\\end{bmatrix}) & =T(4\\begin{bmatrix}2 \\\\ 4\\end{bmatrix})=4T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT(\\begin{bmatrix}8 \\\\ 16\\end{bmatrix})=\\begin{bmatrix}28 \\\\ -20\\end{bmatrix},\n$$\n\nwe must have\n\n$$\n\\begin{aligned}4T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\begin{bmatrix}28 \\\\ -20\\end{bmatrix} \\\\ T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\frac{1}{4}\\begin{bmatrix}28 \\\\ -20\\end{bmatrix} \\\\ T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\begin{bmatrix}7 \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c348231-faac-5f15-ba88-4a5fcff9895b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186393433} {:answer/id #uuid "1cbe61fb-3b9a-5b63-aefd-518ef08c77c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186393434} {:answer/id #uuid "741f5285-7e52-5afa-8fd8-e7ffe7bb3ffa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186393435} {:answer/id #uuid "3e486dbe-f3f0-57e0-8019-075933a8c6cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186393436} {:answer/id #uuid "9e1aa637-1399-5be1-8754-cfd06e8753a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186393437}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186393437} :answer-field/id #uuid "3d0c3af7-ad97-5864-bf2c-f087f946215b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393432}] :question/id #uuid "96c9c6b4-4b9d-5bd8-af24-21ff4fd8965e" :question/math-academy-id "q-74762" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}4 \\\\ 12\\end{bmatrix})=\\begin{bmatrix}-12 \\\\ 16\\end{bmatrix}$, then find $\\,T(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}).$" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}4 \\\\ 12\\end{bmatrix}=4\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}4 \\\\ 12\\end{bmatrix}) & =T(4\\begin{bmatrix}1 \\\\ 3\\end{bmatrix})=4T(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT(\\begin{bmatrix}4 \\\\ 12\\end{bmatrix})=\\begin{bmatrix}-12 \\\\ 16\\end{bmatrix},\n$$\n\nwe must have\n\n$$\n\\begin{aligned}4T(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}) & =\\begin{bmatrix}-12 \\\\ 16\\end{bmatrix} \\\\ T(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}) & =\\frac{1}{4}\\begin{bmatrix}-12 \\\\ 16\\end{bmatrix} \\\\ T(\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}) & =\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Determining the Image of a Vector Under a Map Using the Scalar Multiplication Property"} {:db/id #edb/ref 17592186087748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087564 :question/id #uuid "e34b53de-72d8-541f-bd04-16d2cbf1e6b2" :question/math-academy-id "e-5429" :question/problem "Consider a linear transformation $\\mathbf{T}.$ If $\\begin{bmatrix}-18 \\\\ 24\\end{bmatrix}$ and $\\begin{bmatrix}14 \\\\ -12\\end{bmatrix}$ then find $\\mathbf{T}(\\mathbf{v}_1).$" :question/worked-solution "Since $\\mathbf{T}$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $\\mathbf{v}$ and $\\mathbf{w}.$ Therefore,\n\n$$\n\\begin{aligned}T(4{v}_{1}+{v}_{2}) & =4T({v}_{1})+T({v}_{2}) \\\\ \\begin{bmatrix}-18 \\\\ 24\\end{bmatrix} & =4T({v}_{1})+\\begin{bmatrix}14 \\\\ -12\\end{bmatrix} \\\\ 4T({v}_{1}) & =\\begin{bmatrix}-18 \\\\ 24\\end{bmatrix}-\\begin{bmatrix}14 \\\\ -12\\end{bmatrix} \\\\ 4T({v}_{1}) & =\\begin{bmatrix}-32 \\\\ 36\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{4}\\begin{bmatrix}-32 \\\\ 36\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}-8 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/questions [{:db/id #edb/ref 17592186088147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7fead9e-30c6-5f59-9993-b1e7f244ea5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 22\\end{bmatrix}" :db/id #edb/ref 17592186085537} {:answer/id #uuid "ca948ea7-594b-5e5c-a292-8cdabb2b29cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186085538} {:answer/id #uuid "d5a1cfcf-3473-595f-b453-73a8cdbf5eb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186085539} {:answer/id #uuid "0bd9d42e-b54a-5243-a3f0-42f551eac72a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186085540} {:answer/id #uuid "7fc966ba-1b26-5c8f-8fb0-7ff129b4449d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186085541}] :answer-field/id #uuid "18018401-9cd4-586d-a218-84f5e193958b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :