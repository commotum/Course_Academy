n\n$$\n\\begin{aligned}T(3{v}_{1}) & =3T({v}_{1}) \\\\  & =3\\begin{bmatrix}54 \\\\ -36 \\\\ 30\\end{bmatrix} \\\\  & =\\begin{bmatrix}162 \\\\ -108 \\\\ 90\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(21{v}_{1}+18{v}_{2})=\\begin{bmatrix}162 \\\\ -108 \\\\ 90\\end{bmatrix}.$"} {:db/id #edb/ref 17592186088150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d67dd171-760d-5486-b3f7-56d80c2756a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-48 \\\\ 36 \\\\ 60\\end{bmatrix}" :db/id #edb/ref 17592186085555} {:answer/id #uuid "149272c4-bd63-5210-ba74-47dc48d4144f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-36 \\\\ 27 \\\\ 45\\end{bmatrix}" :db/id #edb/ref 17592186085556} {:answer/id #uuid "1f2d3e4c-12bb-56a0-9fa9-83424bcddd36" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-24 \\\\ 18 \\\\ 30\\end{bmatrix}" :db/id #edb/ref 17592186085557} {:answer/id #uuid "44f80e9b-8bb0-52fd-a953-ffb664af5bed" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186085558} {:answer/id #uuid "722337cf-5064-5645-9454-4697ac2f0ae4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-60 \\\\ 45 \\\\ 75\\end{bmatrix}" :db/id #edb/ref 17592186085559}] :answer-field/id #uuid "f6eeeeb4-f7d7-5194-9861-ba775d74d6ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085554}] :question/id #uuid "590c099f-8ba7-5c6d-8543-41afb4123917" :question/math-academy-id "q-37902" :question/problem "Consider a linear transformation $T$. If $v_{1} + v_{2} = 0$ and $T(v_{2}) = \\begin{bmatrix}-12 \\\\ 9 \\\\ 15\\end{bmatrix}$, find $T(15v_{1} + 19v_{2})$."} {:db/id #edb/ref 17592186284659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19625734-7113-5821-bfe0-4875b25d5510" :answer/type {:db/ident :answer.type/math} :answer/v