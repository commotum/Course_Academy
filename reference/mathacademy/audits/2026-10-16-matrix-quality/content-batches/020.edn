{2} \\\\ k\\cdot 0\\end{bmatrix} \\\\  & ={k}^{2}\\begin{bmatrix}{x}^{2} \\\\ 0\\end{bmatrix} \\\\  & \\ne kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}({x}_{1}+{x}_{2})^{2} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}^{2} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}{x}_{2}^{2} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}2{x}_{1}{x}_{2} \\\\ 0\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}+\\begin{bmatrix}2{x}_{1}{x}_{2} \\\\ 0\\end{bmatrix} \\\\  & \\ne T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\n \n\nAs a result, only statement III is true."} {:db/id #edb/ref 17592186348353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9bdc7e-42c3-53cc-a18e-22ffa2e86bb5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469134} {:answer/id #uuid "361c69af-6a32-5d90-a2fa-6b0197287d40" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135} :answer-field/id #uuid "cd53690d-e07b-5da6-966c-bd269499edd7" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470179} {:answer-field/choices [{:answer/id #uuid "23c74a53-044d-57cf-83b8-d90c2e0538e9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469136} {:answer/id #uuid "13abf251-50ed-5e34-bf36-94c66ecbad57" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137} :answer-field/id #uuid "f9eab1d5-593a-5a4b-9714-f2225f52eb4d" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470180} {:answer-field/choices [{:answer/id #uuid "de2f0777-10bc-5716-b903-2d5397b7afa4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469138} {:answer/id #uuid "1803f7d1-0e88-50d0-b801-03a457a85e83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139} :answer-field/id #uuid "06caeb1c-f4fa-5b23-9efc-e6e9cf272ed6" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470181}] :question/id #uuid "00b02bef-cbb1-520c-b74e-661d82b27e5e" :question/math-academy-id "q-8022" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}x+y \\\\ 2y\\end{bmatrix}.$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}kx+ky \\\\ 2(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}k(x+y) \\\\ k(2y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}x+y \\\\ 2y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 2({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}+{y}_{1} \\\\ 2{y}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2}+{y}_{2} \\\\ 2{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186351471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae458531-3fea-5d4a-9fef-16784006df96" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469290} {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291} :answer-field/id #uuid "ab84475d-72cc-534c-be81-a6861c464c13" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470257} {:answer-field/choices [{:answer/id #uuid "3a743681-e458-539f-acc1-e7e101830b51" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469292} {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293} :answer-field/id #uuid "21f12b61-0b8f-58ec-be60-cd2667a6b36b" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470258} {:answer-field/choices [{:answer/id #uuid "4fdad23f-a509-5ce9-9efa-82f9ccbc40a7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469294} {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295} :answer-field/id #uuid "45138a1d-ce8d-542c-875e-b3141969f4d5" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470259}] :question/id #uuid "d21c33a8-a8c0-5b77-a079-4c787c111b5f" :question/math-academy-id "q-8296" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix}.$\nWhich of the following statements are true?\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}5(kx)+2(ky) \\\\ 3(ky)\\end{bmatrix} \\\\  & =\\begin{bmatrix}k(5x+2y) \\\\ k(3y)\\end{bmatrix} \\\\  & =k\\begin{bmatrix}5x+2y \\\\ 3y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}5({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2}) \\\\ 3({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{x}_{1}+2{y}_{1} \\\\ 3{y}_{1}\\end{bmatrix}+\\begin{bmatrix}5{x}_{2}+2{y}_{2} \\\\ 3{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186351472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f2bbb7-924e-519b-858e-8781702c24be" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469296} {:answer/id #uuid "1d466783-f476-5fdd-b2b1-7f9609e90817" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469297}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469297} :answer-field/id #uuid "96bcc72e-3fee-5a08-ad21-87ada1e18d29" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470260} {:answer-field/choices [{:answer/id #uuid "ede2e360-cb72-5597-9136-07fadf25f445" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469298} {:answer/id #uuid "c34902f6-f6b8-58a7-9994-5b38c62f7aa2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469299}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469299} :answer-field/id #uuid "bf9a9df6-144f-56e6-8759-b734505fc26e" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470261} {:answer-field/choices [{:answer/id #uuid "b44a01d6-7730-572f-b4bc-9c85c5bf9a77" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469300} {:answer/id #uuid "77b7d58f-0e4e-5e7d-aed4-08c91f06adcb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469301}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469301} :answer-field/id #uuid "790adcf9-f3da-50a3-aa5c-dce48917f693" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470262}] :question/id #uuid "5104f251-39bc-5c29-bbcf-96e73f6b8fe5" :question/math-academy-id "q-8297" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}3y \\\\ 2x\\end{bmatrix}.$\nWhich of the following statements are true?\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}3ky \\\\ 2kx\\end{bmatrix} \\\\  & =k\\begin{bmatrix}3y \\\\ 2x\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}3({y}_{1}+{y}_{2}) \\\\ 2({x}_{1}+{x}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}3{y}_{1} \\\\ 2{x}_{1}\\end{bmatrix}+\\begin{bmatrix}3{y}_{2} \\\\ 2{x}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186395991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8c65cd4-8483-5860-b7e4-2e5f6999dce5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470901} {:answer/id #uuid "d058bcfd-95da-5b43-97d7-abe7d98ec345" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470902}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470902} :answer-field/id #uuid "161e0852-2b45-54f8-8b42-267cc6b1c63c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471956} {:answer-field/choices [{:answer/id #uuid "d386c399-9111-5bbd-9887-033eb7004c7e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470903} {:answer/id #uuid "69c4a485-5228-57d4-979a-ab95a231931b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470904}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470904} :answer-field/id #uuid "c48a1d31-3b71-53aa-a009-2fca300bedeb" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471957} {:answer-field/choices [{:answer/id #uuid "cf59e0b8-6c9c-5268-9247-b6aa262b7519" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470905} {:answer/id #uuid "dc2f1a31-c756-5d23-affa-6305848f8743" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470906}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470906} :answer-field/id #uuid "0f7620bf-1e26-5a27-9705-fa63bd75423e" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471958}] :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}x+y \\\\ 4x+3y\\end{bmatrix}.$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}kx+ky \\\\ 4kx+3ky\\end{bmatrix} \\\\  & =k\\begin{bmatrix}x+y \\\\ 4x+3y\\end{bmatrix} \\\\  & =kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{bmatrix}+\\begin{bmatrix}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186396176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f34066f-00d4-55b1-8d73-96ef234a63ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471627} {:answer/id #uuid "40aeb5d5-faee-5b7e-8df5-e870d6e9a6e1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471628}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471627} :answer-field/id #uuid "27ba3123-b0fe-5ec0-9a8d-2073c4afa0b4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472319} {:answer-field/choices [{:answer/id #uuid "3317098d-cf9d-5045-941b-07580beb38db" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471629} {:answer/id #uuid "cef4ff68-717a-544a-9ae5-83dfb3142903" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471630}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471629} :answer-field/id #uuid "75df2837-8fbd-5207-9ab7-c0c5f47ed8b5" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472320} {:answer-field/choices [{:answer/id #uuid "839e484e-16dc-5c22-99f9-7b695e23ac7b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471631} {:answer/id #uuid "d9f23ace-b866-586d-8acb-fe6dd49060d9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471632}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471632} :answer-field/id #uuid "64c08e3e-68be-5c0c-ab6e-798878cc578f" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472321}] :question/id #uuid "72a3fd90-5133-5a81-a0e8-33ac74b2d520" :question/math-academy-id "q-8049" :question/problem "Let \n$T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}1 \\\\ x\\end{bmatrix}.$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is **NOT** a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}=kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}, \\\\  & T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix}=T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ kx\\end{bmatrix} \\\\  & \\ne kT\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ {x}_{1}+{x}_{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ {x}_{2}\\end{bmatrix} \\\\  & \\ne T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,\\times \\end{aligned}\n$$\n\nAs a result, only statement III is true."}] :knowledge-point/title "Identifying Linear Transformations"} {:db/id #edb/ref 17592186087747 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087563 :question/id #uuid "8fe1f455-e739-59cb-95c2-0378dff32b8e" :question/math-academy-id "e-5428" :question/problem "If $\\mathbf{T}$ is a linear transformation and $\\begin{bmatrix}12 \\\\ 24\\end{bmatrix}$ then find $\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$" :question/worked-solution "Since $\\mathbf{T}$ is a linear transformation, it must satisfy $\\mathbf{T}(k\\mathbf{v})=k\\mathbf{T}(\\mathbf{v}).$ Noting that $\\begin{bmatrix}12 \\\\ 24\\end{bmatrix}$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}12 \\\\ 24\\end{bmatrix}) & =T(6\\begin{bmatrix}2 \\\\ 4\\end{bmatrix})=6T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\n\\begin{bmatrix}12 \\\\ 24\\end{bmatrix}\n$$\n\nwe must have\n\n$$\n\\begin{aligned}6T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\begin{bmatrix}18 \\\\ -30\\end{bmatrix} \\\\ T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\frac{1}{6}\\begin{bmatrix}18 \\\\ -30\\end{bmatrix} \\\\ T(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) & =\\begin{bmatrix}3 \\\\ -5\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8" :knowledge-point/questions [{:db/id #edb/ref 17592186088151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2d6a47-226c-51b2-aa28-dfaecd733285" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186321246} {:answer/id #uuid "228b70b6-639a-5ccb-b768-59755ded8a6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186321409} {:answer/id #uuid "8bee971f-0454-50dc-8309-af67a2173b38" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186322267} {:answer/id #uuid "8e6df426-6d51-555b-8f28-989da2b1d1ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186322278} {:answer/id #uuid "ec686057-fe80-53a4-9e32-072ae2451bdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186323005}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186321246} :answer-field/id #uuid "ece5ffa6-7324-5536-acf5-dd7b49cfbb63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323635}] :question/id #uuid "95ad2111-91ad-555b-a492-6ecabaa23b77" :question/math-academy-id "q-37903" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T(\\begin{bmatrix}-9 \\\\ 15\\end{bmatrix})=\\begin{bmatrix}12 \\\\ -18\\end{bmatrix}$, then find $\\,T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}).$" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $\\begin{bmatrix}-9 \\\\ 15\\end{bmatrix}=3\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}T(\\begin{bmatrix}-9 \\\\ 15\\end{bmatrix}) & =T(3\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix})=3T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT(\\begin{bmatrix}-9 \\\\ 15\\end{bmatrix})=\\begin{bmatrix}12 \\\\ -18\\end{bmatrix},\n$$\n\nwe must have\n\n$$\n\\begin{aligned}3T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}) & =\\begin{bmatrix}12 \\\\ -18\\end{bmatrix} \\\\ T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}) & =\\frac{1}{3}\\begin{bmatrix}12 \\\\ -18\\end{bmatrix} \\\\ T(\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}) & =\\begin{bmatrix}4 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6e75859-bf4a-5324-9d39-88794cb734f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186085567} {:ans