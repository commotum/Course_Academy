d{bmatrix} \\\\ 2T({v}_{1}) & =\\begin{bmatrix}11 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}5 \\\\ -19\\end{bmatrix} \\\\ 2T({v}_{1}) & =\\begin{bmatrix}6 \\\\ 22\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{2}\\begin{bmatrix}6 \\\\ 22\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}3 \\\\ 11\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "912948ff-f9a1-5e65-a839-3224e5593cec" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 18\\end{bmatrix}" :db/id #edb/ref 17592186085549} {:answer/id #uuid "bdf3f517-8e44-53c7-9026-1c3f07d5da55" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186085550} {:answer/id #uuid "155a6bec-24b9-56d4-92fd-68891f45f8c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186085551} {:answer/id #uuid "1c7692bf-89ca-5145-95ef-7648348d18f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186085552} {:answer/id #uuid "4dce2a1b-0076-5d92-8dc9-748f3b846712" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186085553}] :answer-field/id #uuid "f73514b8-149c-51c3-b988-f1916e58cf5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085548} {:answer-field/choices [{:answer/id #uuid "6ea7471b-f07d-5136-abb7-edbd6a6c22d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 18\\end{bmatrix}" :db/id #edb/ref 17592186392161} {:answer/id #uuid "bf986dff-1462-5e9f-94f9-b6d0d484764f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186392162} {:answer/id #uuid "67342caa-f633-50fb-9dc2-4053e590cf91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186392163} {:answer/id #uuid "89b4540a-daf5-5924-9891-f80197ce6f08" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186392164} {:answer/id #uuid "d5e112ba-48c8-504f-adb2-15695e08886d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186392165}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186392162} :answer-field/id #uuid "41610516-b0b1-5226-87ed-641ba05d065c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392160}] :question/id #uuid "00d97500-f2d6-5911-b246-c9aee29ac1dd" :question/math-academy-id "q-37898" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T({v}_{1}+3{v}_{2})=\\begin{bmatrix}15 \\\\ 6\\end{bmatrix}\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(v+kw)=T(v)+T(kw)=T(v)+kT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T({v}_{1}+3{v}_{2}) & =T({v}_{1})+3T({v}_{2}) \\\\ \\begin{bmatrix}15 \\\\ 6\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}+3T({v}_{2}) \\\\ 3T({v}_{2}) & =\\begin{bmatrix}15 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}6 \\\\ -12\\end{bmatrix} \\\\ 3T({v}_{2}) & =\\begin{bmatrix}9 \\\\ 18\\end{bmatrix} \\\\ T({v}_{2}) & =\\frac{1}{3}\\begin{bmatrix}9 \\\\ 18\\end{bmatrix} \\\\ T({v}_{2}) & =\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "803f1f1c-7d91-56fa-88d8-a91d1c2cd014" :answer/type {:db/ident :answer.type/math} :answe