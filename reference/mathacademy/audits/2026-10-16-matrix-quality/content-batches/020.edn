swer-field/choices [{:answer/id #uuid "d8d567ff-2c0f-5b01-a277-bdc34f50b08a" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186298481}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186298481} :answer-field/id #uuid "24448da8-7cec-5162-b7bd-b737f959ab7c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298758} {:answer-field/choices [{:answer/id #uuid "8e2a33bb-dd8e-5512-9401-ab165d9e1392" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298168}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298168} :answer-field/id #uuid "5bf4c268-bb86-5fd3-a7b9-7a1fb8eb974f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298950} {:answer-field/choices [{:answer/id #uuid "9beb1afd-3bfb-5c48-871b-683a3beaf8bf" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186298232}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186298232} :answer-field/id #uuid "7002e12f-0790-5626-a51c-4b7b91470a8c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299014}] :question/id #uuid "ce4779fa-1858-59d2-a648-a7695cdd9e6b" :question/math-academy-id "q-317833" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}4 \\\\ -1 \\\\ 3\\end{bmatrix}\\,$, find $\\,T(6{v}_{1}-7{v}_{2}).$\n\n| $\\,T(6{v}_{1}-7{v}_{2})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}6{v}_{1}-7{v}_{2} & =13{v}_{1}-7{v}_{1}-7{v}_{2} \\\\  & =13{v}_{1}-7({v}_{1}+{v}_{2}) \\\\  & =13{v}_{1}-7(0) \\\\  & =13{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(6{v}_{1}-7{v}_{2})=T(13{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(13{v}_{1}) & =13T({v}_{1}) \\\\  & =13\\begin{bmatrix}4 \\\\ -1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}52 \\\\ -13 \\\\ 39\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(6{v}_{1}-7{v}_{2})=\\begin{bmatrix}52 \\\\ -13 \\\\ 39\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99847489-7490-510b-90bc-bb2f01508c1f" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186298217}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186298217} :answer-field/id #uuid "70866c79-68f1-52cb-b6c8-d7e7a1f9bdc2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299021} {:answer-field/choices [{:answer/id #uuid "e3d8df8d-d452-56ee-9ac3-b8d9adcd1e38" :answer/type {:db/ident :answer.type/math} :answer/value "-78" :db/id #edb/ref 17592186298531}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-78" :db/id #edb/ref 17592186298531} :answer-field/id #uuid "d0821882-1efc-5523-a021-ceeafabe1606" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299340} {:answer-field/choices [{:answer/id #uuid "6b9ae9c8-7fc4-5ad7-8d09-e0c428d82f47" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186298015}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186298015} :answer-field/id #uuid "d1f3e072-018a-580f-aff1-e05f8e0b7f4d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299349}] :question/id #uuid "4179f434-5f10-59e7-b895-874278c3c8ee" :question/math-academy-id "q-317834" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}-2 \\\\ 5 \\\\ -6\\end{bmatrix}\\,$, find $\\,T(9{v}_{1}-4{v}_{2}).$\n\n| $\\,T(9{v}_{1}-4{v}_{2})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}9{v}_{1}-4{v}_{2} & =13{v}_{1}-4{v}_{1}-4{v}_{2} \\\\  & =13{v}_{1}-4({v}_{1}+{v}_{2}) \\\\  & =13{v}_{1}-4(0) \\\\  & =13{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(9{v}_{1}-4{v}_{2})=T(13{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(13{v}_{1}) & =13T({v}_{1}) \\\\  & =13\\begin{bmatrix}-2 \\\\ 5 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-26 \\\\ 65 \\\\ -78\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(9{v}_{1}-4{v}_{2})=\\begin{bmatrix}-26 \\\\ 65 \\\\ -78\\end{bmatrix}.$"} {:db/id #edb/ref 17592186344982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c173a97-fd74-5c7a-9868-7a03ea78e00c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}55 \\\\ 30 \\\\ -60\\end{bmatrix}" :db/id #edb/ref 17592186343161} {:answer/id #uuid "7a42e6e0-7f3e-582e-8f5e-4a37a89c1a25" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 24 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186343292} {:answer/id #uuid "b8f03d1a-3143-5883-bbd4-e904c31ce44f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ -12 \\\\ 24\\end{bmatrix}" :db/id #edb/ref 17592186343862} {:answer/id #uuid "eeff9569-9ef1-5aa1-912d-e036cc52021f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 \\\\ 12 \\\\ -24\\end{bmatrix}" :db/id #edb/ref 17592186344339} {:answer/id #uuid "f89f6e52-c1d4-5e5e-8532-59a24ee0ad56" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}77 \\\\ 42 \\\\ -84\\end{bmatrix}" :db/id #edb/ref 17592186344425}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 24 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186343292} :answer-field/id #uuid "6203bafa-3a21-5eb1-8ef0-5b0cea4d48f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344656}] :question/id #uuid "14ba9ce6-0517-5412-a2d3-c81941287a94" :question/math-academy-id "q-74776" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}\\,$, find $\\,T(7{v}_{1}-5{v}_{2}).$" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}7{v}_{1}-5{v}_{2} & =12{v}_{1}-5{v}_{1}-5{v}_{2} \\\\  & =12{v}_{1}-5({v}_{1}+{v}_{2}) \\\\  & =12{v}_{1}-5(0) \\\\  & =12{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(7{v}_{1}-5{v}_{2})=T(12{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(12{v}_{1}) & =12T({v}_{1}) \\\\  & =12\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 \\\\ 24 \\\\ -12\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(7{v}_{1}-5{v}_{2})=\\begin{bmatrix}12 \\\\ 24 \\\\ -12\\end{bmatrix}.$"} {:db/id #edb/ref 17592186344983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e91b37e-37bf-59c0-9728-bba6695f8755" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 \\\\ 26 \\\\ -14\\end{bmatrix}" :db/id #edb/ref 17592186342755} {:answer/id #uuid "4972069e-cd92-54f8-9a62-2c708ebc40dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}" :db/id #edb/ref 17592186342843} {:answer/id #uuid "5b55015b-9422-522b-9781-4a48a3def979" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 \\\\ -39 \\\\ 21\\end{bmatrix}" :db/id #edb/ref 17592186343002} {:answer/id #uuid "ab1a64c7-95da-5cd9-a12f-c6275d4dc1ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-40 \\\\ 130 \\\\ -70\\end{bmatrix}" :db/id #edb/ref 17592186343743} {:answer/id #uuid "de6b0e44-d373-5f03-8039-7a4b4e78d1e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -13 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186344191}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}" :db/id #edb/ref 17592186342843} :answer-field/id #uuid "c01fe572-57e8-50f5-a0a6-1bfc5b46a161" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344831}] :question/id #uuid "3ef5ef6a-15c2-53c9-b123-06bb8ec78062" :question/math-academy-id "q-74777" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}-4 \\\\ 13 \\\\ -7\\end{bmatrix}\\,$, find $\\,T(41{v}_{1}+37{v}_{2}).$" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}41{v}_{1}+37{v}_{2} & =37{v}_{1}+4{v}_{1}+37{v}_{2} \\\\  & =37({v}_{1}+{v}_{2})+4{v}_{1} \\\\  & =37(0)+4{v}_{1} \\\\  & =4{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(41{v}_{1}+37{v}_{2})=T(4{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(4{v}_{1}) & =4T({v}_{1}) \\\\  & =4\\begin{bmatrix}-4 \\\\ 13 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(41{v}_{1}+37{v}_{2})=\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}.$"} {:db/id #edb/ref 17592186344984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b04976-9bfc-56d7-801f-a1ef0a853a63" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186342249} {:answer/id #uuid "46cbe344-5439-5e0a-bd87-73047c87a17e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-40 \\\\ 20 \\\\ 45\\end{bmatrix}" :db/id #edb/ref 17592186342823} {:answer/id #uuid "758b29d9-f4ee-55d9-baae-0129f919eee2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}64 \\\\ -32 \\\\ -72\\end{bmatrix}" :db/id #edb/ref 17592186343253} {:answer/id #uuid "7a08d470-42c3-5b67-8c85-dd1691a27317" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -4 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186343289} {:answer/id #uuid "da0518b2-7cae-56e3-a0f8-6aba065ae55d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-64 \\\\ 32 \\\\ 72\\end{bmatrix}" :db/id #edb/ref 17592186344153}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186342249} :answer-field/id #uuid "0a14c23e-18a5-58d8-9ebf-12128c65d882" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344514}] :question/id #uuid "d7ef202c-eaf1-5409-8e7c-b60f4d3a89f4" :question/math-academy-id "q-74780" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}-8 \\\\ 4 \\\\ 9\\end{bmatrix}\\,$, find $\\,T(13{v}_{1}+8{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}13{v}_{1}+8{v}_{2} & =13{v}_{1}+13{v}_{2}-5{v}_{2} \\\\  & =13({v}_{1}+{v}_{2})-5{v}_{2} \\\\  & =13(0)-5{v}_{2} \\\\  & =-5{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(13{v}_{1}+8{v}_{2})=T(-5{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-5{v}_{2}) & =-5T({v}_{2}) \\\\  & =-5\\begin{bmatrix}-8 \\\\ 4 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(13{v}_{1}+8{v}_{2})=\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}.$"} {:db/id #edb/ref 17592186398989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9149cf2-edbf-544d-9c0f-90c2f55edc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}63 \\\\ 51 \\\\ -42\\end{bmatrix}" :db/id #edb/ref 17592186398991} {:answer/id #uuid "1f624e49-b4d8-5481-a766-3d48a04ffb70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-42 \\\\ -34 \\\\ 28\\end{bmatrix}" :db/id #edb/ref 17592186398992} {:answer/id #uuid "f08777ee-7bc2-552d-b942-d0cc1bce2816" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-21 \\\\ -17 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186398993} {:answer/id #uuid "05991325-fa66-564d-8673-e9450a190897" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-63 \\\\ -51 \\\\ 42\\end{bmatrix}" :db/id #edb/ref 17592186398994} {:answer/id #uuid "91bbea6d-c7c9-55fe-bfcc-d43e664cab17" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}42 \\\\ 34 \\\\ -28\\end{bmatrix}" :db/id #edb/ref 17592186398995}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}42 \\\\ 34 \\\\ -28\\end{bmatrix}" :db/id #edb/ref 17592186398995} :answer-field/id #uuid "8bb35426-6c4d-5808-82e6-12f94e6cdf85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398990}] :question/id #uuid "7e4e42a9-e81d-5610-8794-d5c4cdbe24ee" :question/math-academy-id "q-74781" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}21 \\\\ 17 \\\\ -14\\end{bmatrix}\\,$, find $\\,T(37{v}_{1}+39{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}37{v}_{1}+39{v}_{2} & =37{v}_{1}+37{v}_{2}+2{v}_{2} \\\\  & =37({v}_{1}+{v}_{2})+2{v}_{2} \\\\  & =37(0)+2{v}_{2} \\\\  & =2{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(37{v}_{1}+39{v}_{2})=T(2{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(2{v}_{2}) & =2T({v}_{2}) \\\\  & =2\\begin{bmatrix}21 \\\\ 17 \\\\ -14\\end{bmatrix} \\\\  & =\\begin{bmatrix}42 \\\\ 34 \\\\ -28\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(37{v}_{1}+39{v}_{2})=\\begin{bmatrix}42 \\\\ 34 \\\\ -28\\end{bmatrix}.$"} {:db/id #edb/ref 17592186398996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cf2543c-52a2-5d22-ade1-01fb909a24c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-42 \\\\ -48 \\\\ -54\\end{bmatrix}" :db/id #edb/ref 17592186398998} {:answer/id #uuid "9b60aca4-cebd-5057-86df-3f802303d985" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}42 \\\\ 48 \\\\ 54\\end{bmatrix}" :db/id #edb/ref 17592186398999} {:answer/id #uuid "6b5adb0d-8afe-589d-8766-6f54221b1923" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 \\\\ -8 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186399000} {:answer/id #uuid "cb286cb0-e275-5c5a-84c0-0da7775b4c26" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186399001} {:answer/id #uuid "2a887727-06ac-5683-8e7a-d8bd6d40d074" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}35 \\\\ 40 \\\\ 45\\end{bmatrix}" :db/id #edb/ref 17592186399002}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186399001} :answer-field/id #uuid "0c9e5e4c-86b6-5dbc-8c4b-1b6b65e5d494" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398997}] :question/id #uuid "4bde10d1-5d59-51e1-a436-733e237150d7" :question/math-academy-id "q-74782" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}7 \\\\ 8 \\\\ 9\\end{bmatrix}\\,$, find $\\,T(11{v}_{1}+6{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}11{v}_{1}+6{v}_{2} & =11{v}_{1}+11{v}_{2}-5{v}_{2} \\\\  & =11({v}_{1}+{v}_{2})-5{v}_{2} \\\\  & =11(0)-5{v}_{2} \\\\  & =-5{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(11{v}_{1}+6{v}_{2})=T(-5{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-5{v}_{2}) & =-5T({v}_{2}) \\\\  & =-5\\begin{bmatrix}7 \\\\ 8 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(11{v}_{1}+6{v}_{2})=\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}.$"}] :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186120625} :activity/id #uuid "faea29b6-21e9-5455-abc1-ad6fe37387f0" :activity/steps [{:db/id #edb/ref 17592186120625 :step/content {:db/id #edb/ref 17592186121020 :tutorial/content "Remember the following three standard elementary row operations: \n\n  I. Swapping two rows\n\n  II. Multiplying a row by a non-zero number\n\n  III. Adding a multiple of one row to another row\n\nOf these three elementary row operations, only III (adding a multiple of one row to another row) *preserves* the determinant. The other two operations, switching two rows or multiplying a row by a non-zero number, *change* the determinant.\n\nTo demonstrate, let's consider the matrix ![](images/fa/fa51d7c585db408c47e8640ae839c1a3bbf94e2b0097e1ade511e5773461f1e8.svg) Taking the determinant, we have\n![](images/bc/bcf5c5dc9f5b7ed3849e719665f802040cf51e3334ae99e25ea7648cbb0f6134.svg)\n\nIf we swap the two rows, we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4 \\\\  & =2 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nLikewise, if we multiply top row by ${\\color{red}2},$ then we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}| & =|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| \\\\  & =2\\cdot 4-3\\cdot 4 \\\\  & =-4 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nHowever, if we add twice the top row to the bottom row, then we get the same determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3+2\\cdot 1 & 4+2\\cdot 2\\end{aligned}| & =|\\begin{aligned}1 & 2 \\\\ 5 & 8\\end{aligned}| \\\\  & =1\\cdot 8-2\\cdot 5 \\\\  & =-2\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "e5ae8e63-4d2c-5491-9908-96fe94243ab9" :tutorial/math-academy-id 3004 :tutorial/title "Introduction"} :step/id #uuid "57d74627-70e0-5830-ba95-6cb026f4de4b" :step/next {:db/id #edb/ref 17592186120703}} {:db/id #edb/ref 17592186120626 :step/content {:db/id #edb/ref 17592186119775 :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538"} :step/id #uuid "07d38f85-837d-577c-a3fa-ed4adb824e28" :step/next {:db/id #edb/ref 17592186120704}} {:db/id #edb/ref 17592186120627 :step/content {:db/id #edb/ref 17592186119776 :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746"} :step/id #uuid "b2bed0ab-d12e-5d90-bbf5-94e480bceb4c" :step/next {:db/id #edb/ref 17592186120743}} {:db/id #edb/ref 17592186120628 :step/content {:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87"} :step/id #uuid "9c7f038a-e114-5e98-bc36-49762d4031f6" :step/next {:db/id #edb/ref 17592186120742}} {:db/id #edb/ref 17592186120629 :step/content {:db/id #edb/ref 17592186121021 :tutorial/content "Since $\\det(A^T)=\\det(A),$ the corresponding elementary column operations on determinants have the same properties as the elementary row ones.\n\n- Swapping two columns changes the sign of the determinant.\n\n- Multiplying a column by a number scales the determinant by that number.\n\n- Adding a multiple of one column to another column does not change the determinant." :tutorial/id #uuid "bac0b72b-b76a-5a06-9312-d2b7b8ac4247" :tutorial/math-academy-id 3005 :tutorial/title "Column Operations on Determinants"} :step/id #uuid "d5da1bd5-0cc1-56fe-a8d7-36aa6576326a"} {:db/id #edb/ref 17592186120703 :step/content {:db/id #edb/ref 17592186121044 :tutorial/content "As we saw, swapping two rows does not preserve the determinant. However, the only difference is the sign of the determinant changes. \n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 \\\\ 3 & 4\\end{vmatrix} & =1\\cdot 4-2\\cdot 3=-2 \\\\ \\begin{vmatrix}3 & 4 \\\\ 1 & 2\\end{vmatrix} & =3\\cdot 2-1\\cdot 4=2\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 \\\\ 3 & 4\\end{vmatrix} & =-\\begin{vmatrix}3 & 4 \\\\ 1 & 2\\end{vmatrix}.\\end{aligned}\n$$\n\nIn general, swapping any two rows of a matrix changes the sign of the determinant to the opposite one. That is to say, \n\n$$\n\\begin{aligned}det\\begin{bmatrix}⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{bmatrix}=-det\\begin{bmatrix}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮\\end{bmatrix}.\\end{aligned}\n$$" :tutorial/id #uuid "f151b612-1bdb-5723-af50-a48439141fbc" :tutorial/math-academy-id 3236 :tutorial/title "Switching Two Rows Changes the Sign of the Determinant"} :step/id #uuid "1889d210-a2bc-5893-b7e3-879d8fc8961f" :step/next {:db/id #edb/ref 17592186120626}} {:db/id #edb/ref 17592186120704 :step/content {:db/id #edb/ref 17592186121045 :tutorial/content "As we have seen, multiplying a row by a number does not preserve the determinant. However, it does affect the determinant in a predictable way: multiplying a row by a number scales the determinant by that number as well.\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 \\\\ 3 & 4\\end{vmatrix} & =1\\cdot 4-2\\cdot 3=-2 \\\\ \\begin{vmatrix}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{vmatrix}=\\begin{vmatrix}2 & 4 \\\\ 3 & 4\\end{vmatrix} & =2\\cdot 4-3\\cdot 4=-4\\end{aligned}\n$$\n\nSo, in the above example, we have\n![](images/08/0826c05fe2eabec96065eb2c83228168129b42c309764df4b101f4a520c4a0f9.svg)\n\nIn general, multiplying a row of a matrix by a number multiplies the determinant by that number. That is to say, we can factor out the common multiplier from the row of the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}⋮ & ⋮ & … & ⋮ \\\\ k△ & k△ & … & k△ \\\\ ⋮ & ⋮ & … & ⋮\\end{bmatrix}=k\\cdot det\\begin{bmatrix}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{bmatrix}\\end{aligned}\n$$" :tutorial/id #uuid "09c28da6-5340-56f9-bbf5-427a824977ee" :tutorial/math-academy-id 3237 :tutorial/title "Multiplying a Row By a Number Scales the Determinant By That Number"} :step/id #uuid "0cc1f27c-f5d8-5b74-9602-32ce4d87b799" :step/next {:db/id #edb/ref 17592186120627}} {:db/id #edb/ref 17592186120742 :step/content {:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d"} :step/id #uuid "e1ec39b0-859a-5c8a-a8ca-f8a0f6371e76" :step/next {:db/id #edb/ref 17592186120629}} {:db/id #edb/ref 17592186120743 :step/content {:db/id #edb/ref 17592186121061 :tutorial/content "Let's check what happens if we multiply the entire matrix (not only one row) by a number. For example,\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3\\cdot 1 & 3\\cdot 2 \\\\ 3\\cdot 3 & 3\\cdot 4\\end{aligned}|=|\\begin{aligned}3 & 6 \\\\ 9 & 12\\end{aligned}| & =3\\cdot 12-6\\cdot 9=-18\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n![](images/fe/fe02091dde43a8a2405f6b588f619bc9fa3f54b31ac8a1ac39d318761f00cc3e.svg)\n\nThe above is equivalent to multiplying both rows of the matrix by $3$. Multiplying the first row scales the determinant by $3$, and then multiplying the second row scales it by $3$ once more.\n\nIn general, multiplying an entire $n \\times n$ matrix by a number multiplies the determinant by that number to the power of $n$. That is to say, we can factor out the common multiplier from the entire matrix, as follows:\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A),\\end{aligned}\n$$\n\nwhere $A$ is an $n \\times n$ matrix." :tutorial/id #uuid "1c99dfd1-b583-5247-9ac5-c2ada47c0ee9" :tutorial/math-academy-id 3880 :tutorial/title "Multiplying a Matrix By a Scalar"} :step/id #uuid "ebb7b384-6a1f-56e3-9927-8911a4ec3563" :step/next {:db/id #edb/ref 17592186120744}} {:db/id #edb/ref 17592186120744 :step/content {:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9"} :step/id #uuid "6bb5981c-60d1-56ed-a146-3ef4d9c0f6bb" :step/next {:db/id #edb/ref 17592186120628}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186119994} {:activity/first-step {:db/id #edb/ref 17592186409694} :activity/id #uuid "26bcedbd-f502-5256-b322-6d751a0c036d" :activity/steps [{:db/id #edb/ref 17592186409692 :step/content {:db/id #edb/ref 17592186409691 :question/id #uuid "fded0a2c-cd1a-5de1-a671-20ea991daecd"} :step/id #uuid "0f93ad19-15c5-55b8-98ea-d5bcee8f0a3a" :step/next {:db/id #edb/ref 17592186409696}} {:db/id #edb/ref 17592186409693 :step/content {:db/id #edb/ref 17592186409688 :question/id #uuid "4a80ad4c-5529-5931-9d7c-574d40c6f47e"} :step/id #uuid "2aef95ee-e7e9-5cac-b9ad-3b67a53db79f"} {:db/id #edb/ref 17592186409694 :step/content {:db/id #edb/ref 17592186120431 :question/id #uuid "0a9d752b-69e4-5f21-888f-3429a8443f7b"} :step/id #uuid "2df25dd7-50b3-560b-9abe-b6b13654a237" :step/next {:db/id #edb/ref 17592186409695}} {:db/id #edb/ref 17592186409695 :step/content {:db/id #edb/ref 17592186409690 :question/id #uuid "9ac571f6-6f05-5f70-8bcf-34738f544556"} :step/id #uuid "8e6fad07-ec42-5416-85eb-9ef2b0059cbe" :step/next {:db/id #edb/ref 17592186409692}} {:db/id #edb/ref 17592186409696 :step/content {:db/id #edb/ref 17592186409689 :question/id #uuid "81c5993c-3d71-5869-bbf5-3e36b2df3a7f"} :step/id #uuid "d75809ee-199d-50e2-b002-2326810f1174" :step/next {:db/id #edb/ref 17592186409693}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186409657} {:activity/first-step {:db/id #edb/ref 17592186424902} :activity/id #uuid "11b6f742-f965-5993-a06f-bca8dfba7485" :activity/steps [{:db/id #edb/ref 17592186424900 :step/content {:db/id #edb/ref 17592186265993 :question/id #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002"} :step/id #uuid "0950983d-5529-5332-ba75-7636f5397a6b"} {:db/id #edb/ref 17592186424901 :step/content {:db/id #edb/ref 17592186265971 :question/id #uuid "da7f3dfc-3649-55d6-80af-942a6a83828d"} :step/id #uuid "5a731d48-68b1-58c7-b15e-4a787d1f4b44" :step/next {:db/id #edb/ref 17592186424903}} {:db/id #edb/ref 17592186424902 :step/content {:db/id #edb/ref 17592186329661 :question/id #uuid "44ea0623-3f8f-525c-8344-8d911fbef23b"} :step/id #uuid "5b098fcf-c1b8-5f75-8b3a-28dc83ab8997" :step/next {:db/id #edb/ref 17592186424904}} {:db/id #edb/ref 17592186424903 :step/content {:db/id #edb/ref 17592186424899 :question/id #uuid "200dace6-387b-586f-87ab-a5501c01cbe0"} :step/id #uuid "796d84ed-30ec-5eef-9c9e-3ecd61007abc" :step/next {:db/id #edb/ref 17592186424900}} {:db/id #edb/ref 17592186424904 :step/content {:db/id #edb/ref 17592186341855 :question/id #uuid "bce6072f-0fd1-50b6-a305-a94b72b85f4e"} :step/id #uuid "9e253f5b-694c-5716-b2be-ec3f736b8398" :step/next {:db/id #edb/ref 17592186424901}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db