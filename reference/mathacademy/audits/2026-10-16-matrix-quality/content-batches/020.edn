edb/ref 17592186389605} :answer-field/id #uuid "2caff293-2bb1-50a6-9bae-17c548a69250" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389602}] :question/id #uuid "e7beb869-f92b-5876-8cc3-7148caaba07a" :question/math-academy-id "q-168498" :question/problem "Let ${v}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}$ be eigenvectors of a matrix $A$ that correspond to eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=1,$ respectively.\nWhat is the general solution of the matrix differential equation ${x}^{′}(t)=Ax(t)?$" :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution of our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{4t}+{c}_{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271feb73-b77f-5623-991f-81df3088d04a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413699} {:answer/id #uuid "5176a3ef-a7e8-56ee-88b3-c87edbfb88f2" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413703} {:answer/id #uuid "8c5af234-fa4e-5f1f-bbf6-41796e869fad" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-2t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413706} {:answer/id #uuid "8fe1f55a-db1f-5973-81e4-e355d50f42c7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-2t}+{c}_{2}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413708} {:answer/id #uuid "c17a2582-0132-567b-8489-06c62880c92e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413711}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186413699} :answer-field/id #uuid "fd7ef556-cad9-5361-bc68-0597551b8615" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413714}] :question/id #uuid "450dd490-a7ea-5123-bd6e-a0e46d7aa855" :question/math-academy-id "q-79673" :question/problem "Let ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}$ be eigenvectors of a matrix $A$ that correspond to eigenvalues ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-2,$ respectively. What is the general solution of the matrix differential equation ${x}^{′}(t)=Ax(t)?$" :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution of our matrix differential equation is\n\n$$\nx(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R.\n$$"}] :knowledge-point/title "Finding the General Solution Given the Eigenvalues and Eigenvectors of the Corresponding Matrix"} {:db/id #edb/ref 17592186129306 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128952 :question/id #uuid "58c1b360-e67c-5074-919b-18fb5dbab146" :question/math-academy-id "e-5606" :question/problem "Find the general solution to the system of differential equations \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=6{x}_{1}(t)+7{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=-3{x}_{1}(t)-4{x}_{2}(t).\\end{aligned}\\right.\n$$\n\n*Hint: The eigenvalues of the system's matrix are $\\lambda_1=-1$ and $\\lambda_2=3.$*" :question/worked-solution "First, we write down the matrix differential equation $\\mathbf{x}'(t)=A\\mathbf{x}(t)$ for the given system:\n\n![](images/99/99512ca0bae468975d098cf0789926fe6e8f4ef608693129fa57a3dba02c870b.svg)\n\nWe need to find the eigenvalues and the eigenvectors of the matrix $A.$\n\n- We are given that the eigenvalues are \n\n$$\n\\lambda_1=-1\n\\qquad\\text{and}\\qquad\n\\lambda_2=3.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For $\\lambda_1 =-1,$ we get \n![](images/45/459df7b451dfbcef264fdf3a1af40f05526529934bb2617a8f43599ee56d27d4.svg)\nSo, we get an eigenvector \n![](images/b4/b4b518f6ec5abed1cefa88d9de3b42ec18a2553426667def4d7eb4a9964a7e56.svg)\n\n- For $\\lambda_2 =3,$ we get \n![](images/25/2555ccf5ffe3735fc7cbcd5c5cdbab58b5bf63921ede47ee10ba1192a629b6ba.svg)\nSo, we get an eigenvector \n![](images/26/26da2e9864ffdb4795701703b58edbee58f73b131cddc7b229b1dc2e007b1678.svg)\n\nThus, the general solution to the given system is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}7 \\\\ -3\\end{bmatrix}{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$"} :knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39" :knowledge-point/questions [{:db/id #edb/ref 17592186129579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b060c029-35d6-532a-b386-e84ed4083585" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}e^{2t} + c_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}e^{5t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126958} {:answer/id #uuid "c6fdc933-d36f-59fd-b850-bdceac33ae26" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}7 \\\\ 1\\end{bmatrix}e^{2t} + c_{2}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}e^{5t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126959} {:answer/id #uuid "d1c41b6c-0dba-5423-892a-40fc92a778a3" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}e^{5t} + c_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}e^{2t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126960} {:answer/id #uuid "ffbdb91a-0b3c-513c-bc21-378d01b12d9a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}e^{5t} + c_{2}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}e^{2t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126961} {:answer/id #uuid "4fd25f0f-7214-5a74-9774-50ecfe06dba5" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}e^{2t} + c_{2}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}e^{5t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126962}] :answer-field/id #uuid "ee9c730e-bc0a-5da0-95c1-3ad8917bef94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126957}] :question/id #uuid "274dc06d-8698-5edf-8bbd-fca69be0d29c" :question/math-acade