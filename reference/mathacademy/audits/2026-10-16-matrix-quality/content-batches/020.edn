rked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186411967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159fb8ce-d84b-5877-8981-51153df872c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186411912} {:answer/id #uuid "435012c4-9e86-5b0b-bd8c-bfd07580cbd8" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186411920} {:answer/id #uuid "870e5925-34c8-51ae-b42b-4ea1fe5d0ca4" :answer/type {:db/ident :answer.type/math} :answer/value "-73" :db/id #edb/ref 17592186411932} {:answer/id #uuid "a73f5def-1f48-510b-8531-86b21e5603ca" :answer/type {:db/ident :answer.type/math} :answer/value "-103" :db/id #edb/ref 17592186411936} {:answer/id #uuid "faac8cd2-8f8b-566d-bf90-337a0a3e3080" :answer/type {:db/ident :answer.type/math} :answer/value "103" :db/id #edb/ref 17592186411953}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-103" :db/id #edb/ref 17592186411936} :answer-field/id #uuid "6a9f68ad-92fa-5436-8d0c-8ac0948686e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411959}] :question/id #uuid "9e7ff967-4362-5d3c-a258-c6d91f60d8e0" :question/math-academy-id "q-130685" :question/problem "Suppose $B$ is a $7\\times 7$ matrix and $det(B)=103.$ The matrix $C$ is obtained from $B$ by applying the elementary row operation ${R}_{7}↔{R}_{3}$ (switching the seventh and the third rows). What is the value of $det(C)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(C) & =-det(B) \\\\  & =-(103) \\\\  & =-103.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Determinant After Switching Two Rows"} {:db/id #edb/ref 17592186119776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119590 :question/id #uuid "89152146-8f04-5b4f-8436-15b82431c35d" :question/math-academy-id "e-4423" :question/problem "Suppose $A$ is a $6 \\times 6$ matrix and $\\det(A) = 32.$ The matrix $B$ is obtained from $A$ by applying the elementary row operation $R_3:= \\dfrac{1}{8} R_3$. What is the value of $\\det(B)?$" :question/worked-solution "The row operation applied to $A$ consists of multiplying a row by the number $\\dfrac{1}{8}.$\n\nWhen we do this, the determinant is multiplied by the same number. So, we have\n\n$$\n\\begin{aligned}det(B) & =\\frac{1}{8}det(A) \\\\  & =\\frac{1}{8}\\cdot 32 \\\\  & =4.\\end{aligned}\n$$"} :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/questions [{:db/id #edb/ref 17592186120453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232073ae-c510-5f48-a5f3-9c541a6c13ac" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186327238} {:answer/id #uuid "2dca7964-2f48-506b-9487-7a70e775af51" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186327343} {:answer/id #uuid "847167d8-21c4-560e-87d5-0b2c88f27b6c" :answer/type {:db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186328078} {:answer/id #uuid "a753ec68-d63b-5cd4-9e4e-76d19214842b" :answer/type {:db/ident :answer.type/math} :answer/value "-105" :db/id #edb/ref 17592186328388} {:answer/id #uuid "f1616760-5bdf-56a2-b3ff-a0bf1de004f2" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186329040}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186327238} :answer-field/id #uuid "07acf18c-dad7-5fe5-9a13-5d6b19b5cfb8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329197}] :question/id #uuid "d347b77d-0a2e-5499-b039-62abd2cb7bcf" :quest