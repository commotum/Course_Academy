\\\ 16 \\\\ 20\\end{bmatrix} \\\\  & =\\begin{bmatrix}-75 \\\\ 48 \\\\ 60\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(15{v}_{1}+12{v}_{2})=\\begin{bmatrix}-75 \\\\ 48 \\\\ 60\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f180a75-ddf8-5dc1-9498-7f9ec4584a19" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186298173}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186298173} :answer-field/id #uuid "4ae0c876-9b50-5af7-9b67-2275f83de7c8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298887} {:answer-field/choices [{:answer/id #uuid "9a2dbbc4-68ee-5715-a884-dec4928ea3f0" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186298221}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186298221} :answer-field/id #uuid "5c07f8f4-21eb-52ee-af93-5689cb561ebd" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298951} {:answer-field/choices [{:answer/id #uuid "1a221b64-a91d-5f83-9b42-16cadb88d6c4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186297664}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186297664} :answer-field/id #uuid "d7ee1a12-2a03-5585-ac0a-2c905271881a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299369}] :question/id #uuid "8f334d4e-42b2-5fa3-8303-3cd4f312e50a" :question/math-academy-id "q-317822" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}3 \\\\ -2 \\\\ 5\\end{bmatrix}\\,$, find  $T(9{v}_{1}+4{v}_{2}).$\n\n| $\\,T(9{v}_{1}+4{v}_{2})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}9{v}_{1}+4{v}_{2} & =4{v}_{1}+5{v}_{1}+4{v}_{2} \\\\  & =4({v}_{1}+{v}_{2})+5{v}_{1} \\\\  & =4(0)+5{v}_{1} \\\\  & =5{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(9{v}_{1}+4{v}_{2})=T(5{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(5{v}_{1}) & =5T({v}_{1}) \\\\  & =5\\begin{bmatrix}3 \\\\ -2 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 \\\\ -10 \\\\ 25\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(9{v}_{1}+4{v}_{2})=\\begin{bmatrix}15 \\\\ -10 \\\\ 25\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec31264b-8623-5bfb-ad12-e6e6791216a3" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298557}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298557} :answer-field/id #uuid "27683d78-7862-5ee3-9dfe-de26a66c4f6f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298769} {:answer-field/choices [{:answer/id #uuid "8c90211a-3b66-5115-b238-966324942e50" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186298163}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186298163} :answer-field/id #uuid "3cf2dcc6-6ef8-5333-adfa-7bd0181651f9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298844} {:answer-field/choices [{:answer/id #uuid "36f444b2-927d-5879-a914-fdad60e6be1a" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186297773}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186297773} :answer-field/id #uuid "f14fc650-7662-52e2-9537-5c91b23cd884" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299449}] :question/id #uuid "5acd1234-a9f3-51d0-99c7-f42e82979b59" :question/math-academy-id "q-317824" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}-3 \\\\ 4 \\\\ 2\\end{bmatrix}\\,$, find  $T(7{v}_{1}+12{v}_{2}).$\n\n| $\\,T(7{v}_{1}+12{v}_{2})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}7{v}_{1}+12{v}_{2} & =12{v}_{1}-5{v}_{1}+12{v}_{2} \\\\  & =12({v}_{1}+{v}_{2})-5{v}_{1} \\\\  & =12(0)-5{v}_{1} \\\\  & =-5{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(7{v}_{1}+12{v}_{2})=T(-5{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-5{v}_{1}) & =-5T({v}_{1}) \\\\  & =-5\\begin{bmatrix}-3 \\\\ 4 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 \\\\ -20 \\\\ -10\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(7{v}_{1}+12{v}_{2})=\\begin{bmatrix}15 \\\\ -20 \\\\ -10\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3263dc1-7c86-5211-a6b4-fe593edf5bf8" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298268}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298268} :answer-field/id #uuid "2b03af05-e49e-5311-8881-bbfb74f7a26a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298784} {:answer-field/choices [{:answer/id #uuid "01da6c86-7841-54b6-8286-996845ba4832" :answer/type {:db/ident :answer.