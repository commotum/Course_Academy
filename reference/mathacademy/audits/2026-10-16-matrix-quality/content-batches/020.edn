ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298258}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298258} :answer-field/id #uuid "0467062b-d649-538f-9c77-dc029fd88d04" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298652} {:answer-field/choices [{:answer/id #uuid "bee585cb-de79-565c-947a-33064f58606c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186298389}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186298389} :answer-field/id #uuid "1038e7bd-a456-58ed-bdb4-3a175b27b2a8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298694}] :question/id #uuid "7ccff3f5-2317-563c-af12-25f8ff047ae3" :question/math-academy-id "q-317716" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(-5{v}_{1}+4{v}_{2})=\\begin{bmatrix}23 \\\\ -24\\end{bmatrix}\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(-kv+hw)=T(-kv)+T(hw)=-kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(-5{v}_{1}+4{v}_{2}) & =-5T({v}_{1})+4T({v}_{2}) \\\\ \\begin{bmatrix}23 \\\\ -24\\end{bmatrix} & =-5T({v}_{1})+4\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix} \\\\ 5T({v}_{1}) & =4\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}23 \\\\ -24\\end{bmatrix} \\\\ 5T({v}_{1}) & =\\begin{bmatrix}-12 \\\\ 16\\end{bmatrix}-\\begin{bmatrix}23 \\\\ -24\\end{bmatrix} \\\\ 5T({v}_{1}) & =\\begin{bmatrix}-35 \\\\ 40\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{5}\\begin{bmatrix}-35 \\\\ 40\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}-7 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299642 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7b2496b-dba2-56f2-af9f-53b63908d0fa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298349}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298349} :answer-field/id #uuid "c47f53f4-5e38-584b-a524-b3d84c109986" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299298} {:answer-field/choices [{:answer/id #uuid "61c388b8-ce86-5c04-b99b-8037f66461f0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297968}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297968} :answer-field/id #uuid "d2bf8dd0-e792-552d-9de9-0396cbb49a56" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299352}] :question/id #uuid "8ee352f1-381d-59d6-bf49-efc95302ce91" :question/math-academy-id "q-317722" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(-6{v}_{1}+5{v}_{2})=\\begin{bmatrix}8 \\\\ -39\\end{bmatrix}\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(-kv+hw)=T(-kv)+T(hw)=-kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(-6{v}_{1}+5{v}_{2}) & =-6T({v}_{1})+5T({v}_{2}) \\\\ \\begin{bmatrix}8 \\\\ -39\\end{bmatrix} & =-6T({v}_{1})+5\\begin{bmatrix}4 \\\\ -3\\end{bmatrix} \\\\ 6T({v}_{1}) & =5\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -39\\end{bmatrix} \\\\ 6T({v}_{1}) & =\\begin{bmatrix}20 \\\\ -15\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -39\\end{bmatrix} \\\\ 6T({v}_{1}) & =\\begin{bmatrix}12 \\\\ 24\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{6}\\begin{bmatrix}12 \\\\ 24\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7b507ea-38a1-53c4-90df-73b715056379" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298607}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298607} :answer-field/id #uuid "b7b16a57-503f-5b9b-a3bc-7d6273799178" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299259} {:answer-field/choices [{:answer/id #uuid "e5b1e75b-9b2e-5222-bb62-397b3eacd2bc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298538}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298538} :answer-field/id #uuid "e80fc6e0-3afa-5bed-9064-d4bf837a75ae" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299422}] :question/id #uuid "e63e02fd-0471-5470-a3c7-b8b9aafe03db" :question/math-academy-id "q-317745" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+{v}_{2})=\\begin{bmatrix}5 \\\\ 12\\end{bmatrix}\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$, then find $T({v}_{1}).$\n\n| $T({v}_{1})=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+{v}_{2}) & =3T({v}_{1})+T({v}_{2}) \\\\ \\begin{bmatrix}5 \\\\ 12\\end{bmatrix} & =3T({v}_{1})+\\begi