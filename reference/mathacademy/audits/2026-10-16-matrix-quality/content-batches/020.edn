1})+T({v}_{2}) \\\\ \\begin{bmatrix}-5 \\\\ 13\\end{bmatrix} & =3T({v}_{1})+\\begin{bmatrix}1 \\\\ 10\\end{bmatrix} \\\\ 3T({v}_{1}) & =\\begin{bmatrix}-5 \\\\ 13\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 10\\end{bmatrix} \\\\ 3T({v}_{1}) & =\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{3}\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbb1f6f-0919-5e14-aab3-63dd031f318d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186342622} {:answer/id #uuid "4deb3204-83bd-5f97-bdb5-4b404d233cbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186342877} {:answer/id #uuid "5fefe333-55f2-55d9-bd5f-c129617c8ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186343053} {:answer/id #uuid "acc17cbd-959f-5889-ae39-3ece2c5151f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186343759} {:answer/id #uuid "bd0bf072-44c5-5d87-8181-aa62fe42d3e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186343900}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186343900} :answer-field/id #uuid "7318bc52-e9d3-5153-a2f5-88eca1ef6902" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344699}] :question/id #uuid "2c55eb86-992c-5929-994c-e27a136f03fe" :question/math-academy-id "q-74769" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(-2{v}_{1}+{v}_{2})=\\begin{bmatrix}7 \\\\ 9\\end{bmatrix}\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+w)=T(kv)+T(w)=kT(v)+T(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(-2{v}_{1}+{v}_{2}) & =-2T({v}_{1})+T({v}_{2}) \\\\ \\begin{bmatrix}7 \\\\ 9\\end{bmatrix} & =-2T({v}_{1})+\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix} \\\\ -2T({v}_{1}) & =\\begin{bmatrix}7 \\\\ 9\\end{bmatrix}-\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix} \\\\ -2T({v}_{1}) & =\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\ T({v}_{1}) & =\\frac{1}{-2}\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\ T({v}_{1}) & =\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "583bad78-a483-5e27-bf47-58fa7202f27a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186342976} {:answer/id #uuid "6be637e4-9438-50fa-8eae-7474192f1762" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186343157} {:answer/id #uuid "9370f90d-c9b1-5bfd-8975-b97002f0395d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186343529} {:answer/id #uuid "a785af97-7aca-578f-a428-4801508b0088" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186343712} {:answer/id #uuid "d623a847-954d-5cb4-8a03-08d4a77a89db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186344112}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186342976} :answer-field/id #uuid "09ef93ff-b1a6-5f21-8b6f-950d9d095354" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344512}] :question/id #uuid "74809f1e-86dc-5e20-b04f-3f1424b7f6d1" :question/math-academy-id "q-74771" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T({v}_{1}+5{v}_{2})=\\begin{bmatrix}-7 \\\\ 11\\end{bmatrix}\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(v+kw)=T(v)+T(kw)=T(v)+kT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T({v}_{1}+5{v}_{2}) & =T({v}_{1})+5T({v}_{2}) \\\\ \\begin{bmatrix}-7 \\\\ 11\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}+5T({v}_{2}) \\\\ 5T({v}_{2}) & =\\begin{bmatrix}-7 \\\\ 11\\end{bmatrix}-\\begin{bmatrix}3 \\\\ -4\\end{bmatrix} \\\\ 5T({v}_{2}) & =\\begin{bmatrix}-10 \\\\ 15\\end{bmatrix} \\\\ T({v}_{2}) & =\\frac{1}{5}\\begin{bmatrix}-10 \\\\ 15\\end{bmatrix} \\\\ T({v}_{2}) & =\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49cf9e39-72e2-58f9-b054-455b37ef9011" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186342846} {:answer/id #uuid "631c5cf6-23fc-5295-927c-c35fd65028d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186343075} {:answer/id #uuid "6540d294-e2a1-52db-89de-e2012cde3668" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186343096} {:answer/id #uuid "8bde63a2-2e95-54b6-b901-af12256288f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186343460} {:answer/id #uuid "c9074965-facc-5