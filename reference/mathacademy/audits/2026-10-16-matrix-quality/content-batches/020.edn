w, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}{e}^{3t}+{c}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "443ac2d5-d9dc-5782-8406-16e9f95eb735" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}{e}^{4t}+{c}_{2}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300299} {:answer/id #uuid "651191de-7920-5980-9c30-4d454f5630fb" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}{e}^{2t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186300472} {:answer/id #uuid "81eda8b2-f7d3-51f2-8df1-a3518359b9c7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}{e}^{2t}+{c}_{2}\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300610} {:answer/id #uuid "a2b88785-892c-501b-a817-77ed7a21b1a8" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}{e}^{4t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186300781} {:answer/id #uuid "cead3c19-6eb3-589b-ac8a-fc45197e8979" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{2t}+{c}_{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300993}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{2t}+{c}_{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300