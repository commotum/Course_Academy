ution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(-16) \\\\  & =16.\\end{aligned}\n$$"} :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/questions [{:db/id #edb/ref 17592186120452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4e774c9-1a07-5f2d-8ff6-c901e441b9cb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118827} {:answer/id #uuid "36854f38-b868-5bf2-abd5-85c798776a55" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186118828} {:answer/id #uuid "429f4042-5205-54c8-9265-ca69863524b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{28}{3}" :db/id #edb/ref 17592186118829} {:answer/id #uuid "446421dc-6cb1-5016-9678-03b0e17926b1" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186118830} {:answer/id #uuid "4a3c95d6-f41a-5627-aa3e-4cd19103de77" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186118831}] :answer-field/id #uuid "9e5c7ecb-861e-5d66-a3df-9964c01f1aaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118826} {:answer-field/choices [{:answer/id #uuid "9130b080-a9c6-517f-ab25-7cad6b7c57ae" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{28}{3}" :db/id #edb/ref 17592186385450} {:answer/id #uuid "2cc8cf49-48b6-56f7-a5a1-3c2c3b03145d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186385451} {:answer/id #uuid "5b4617a3-07c2-5172-a155-623760aaad73" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186385452} {:answer/id #uuid "0bfe9c29-4aa6-55d5-93bf-35a97039e836" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186385453} {:answer/id #uuid "0d8c6831-8791