matrix}∼\\begin{bmatrix}1 & -1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSo, we get an eigenvector \n${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}\\begin{bmatrix}7 \\\\ 2\\end{bmatrix}{e}^{-4t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23dbff47-ced4-5e1f-967d-15a66f366021" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{3t}+{c}_{2}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300133} {:answer/id #uuid "268aa6d5-15cb-5fe8-b32a-50b08b72297e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{-t}+{c}_{2}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300146} {:answer/id #uuid "5490d6a4-11fb-5c37-8305-e24f1d5c779e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300397} {:answer/id #uuid "a315847c-6871-5c91-aabb-5902aa0f4adc" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{4t}+{c}_{2}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186300783} {:answer/id #uuid "c0883a28-1d0c-53fa-812e-402be0a7301e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}{e}^{4t}+{c}_{2}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref