}{2} & \\frac{3 \\sqrt{2}}{2} \\\\ - \\frac{3 \\sqrt{2}}{4} & - \\frac{\\sqrt{2}}{2}\\end{aligned}|+(- \\sqrt{2})|\\begin{aligned}\\frac{\\sqrt{2}}{2} & \\frac{4}{5} \\\\ - \\frac{3 \\sqrt{2}}{4} & \\frac{2}{5}\\end{aligned}| \\\\  & =(- \\frac{\\sqrt{2}}{2})(- \\frac{2 \\sqrt{2}}{5}- \\frac{3 \\sqrt{2}}{5})+(- \\frac{2}{5})(- \\frac{1}{2}+\\frac{9}{4})+(- \\sqrt{2})(\\frac{\\sqrt{2}}{5}+\\frac{3 \\sqrt{2}}{5}) \\\\  & =(- \\frac{\\sqrt{2}}{2})\\cdot (- \\sqrt{2})+(- \\frac{2}{5})\\cdot \\frac{7}{4}+(- \\sqrt{2})\\cdot \\frac{4 \\sqrt{2}}{5} \\\\  & =1- \\frac{7}{10}- \\frac{8}{5} \\\\  & =- \\frac{13}{10}\\end{aligned}\n$$\n\nSince $det(R)=- \\frac{13}{10}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186529220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f10ee21-6b89-5e0f-a04a-e49bcfa4c907" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529218} {:answer/id #uuid "fe16b8a0-13d3-5554-8edd-ff60470da1a2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529255}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529255} :answer-field/id #uuid "283cd5ed-404d-513a-8b29-74966f63a5de" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529213} {:answer-field/choices [{:answer/id #uuid "9bbf7977-41f6-5bb2-bc84-9b91b4aa2e00" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529239} {:answer/id #uuid "b655c0ce-1985-5548-8848-5fb9f83b43c3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529242}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529239} :answer-field/id #uuid "57424796-2385-5961-a89c-2d74ee068fcd" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529219} {:answer-field/choices [{:answer/id #uuid "670467a6-e81c-5c99-be97-28f089cc9d37" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529225} {:answer/id #uuid "db4c2f01-affa-593d-9e86-c0393439ae7e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529247}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529247} :answer-field/id #uuid "fbad6dc2-1046-5c88-93da-58012356da43" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529253}] :question/id #uuid "58253580-dd5c-51ba-b42f-aea83256773d" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n- **I.** $D$ is a singular matrix\n- **II.** $D$ is **not** a singular matrix\n- **III.** $det(D)=0$\n\n$$\nD=\\begin{bmatrix}- \\frac{3 \\sqrt{2}}{5} & \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}- \\frac{3 \\sqrt{2}}{5} & \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{aligned}| \\\\  & =(- \\frac{3 \\sqrt{2}}{5})|\\begin{aligned}- \\frac{2}{5} & \\frac{\\sqrt{2}}{4} \\\\ \\frac{4}{5} & - \\frac{\\sqrt{2}}{4}\\end{aligned}|+(- \\frac{2}{5})|\\begin{aligned}\\frac{3 \\sqrt{2}}{5} & \\frac{\\sqrt{2}}{4} \\\\ - \\frac{3 \\sqrt{2}}{5} & - \\frac{\\sqrt{2}}{4}\\end{aligned}|+\\frac{\\sqrt{2}}{4}|\\begin{aligned}\\frac{3 \\sqrt{2}}{5} & - \\frac{2}{5} \\\\ - \\frac{3 \\sqrt{2}}{5} & \\frac{4}{5}\\end{aligned}| \\\\  & =(- \\frac{3 \\sqrt{2}}{5})(\\frac{\\sqrt{2}}{10}- \\frac{\\sqrt{2}}{5})+(- \\frac{2}{5})(- \\frac{3}{10}+\\frac{3}{10})+\\frac{\\sqrt{2}}{4}(\\frac{12 \\sqrt{2}}{25}- \\frac{6 \\sqrt{2}}{25}) \\\\  & =(- \\frac{3 \\sqrt{2}}{5})\\cdot (- \\frac{\\sqrt{2}}{10})+(- \\frac{2}{5})\\cdot 0+\\frac{\\sqrt{2}}{4}\\cdot \\frac{6 \\sqrt{2}}{25} \\\\  & =\\frac{3}{25}+\\frac{3}{25} \\\\  & =\\frac{6}{25}\\end{aligned}\n$$\n\nSince $det(D)=\\frac{6}{25}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186529229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87861eb3-5f89-51bb-a83b-a2a2f34426b6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529234} {:answer/id #uuid "fb3191b2-823c-5ff2-9063-c65501bb4dc4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529252}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529252} :answer-field/id #uuid "0187374c-e9df-5d8a-b2e7-160b085f7e8a" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529206} {:answer-field/choices [{:answer/id #uuid "5e9331ae-3672-5960-a137-fec2b5ed94e4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529222} {:answer/id #uuid "c78e9128-09e7-5dbd-8651-62e753136ca1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529245}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529245} :answer-field/id #uuid "8e0b79b6-ad2c-596a-b49a-2f831ec2b99d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529236} {:answer-field/choices [{:answer/id #uuid "8f014eef-cc68-5016-a321-04739726f29b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529237} {:answer/id #uuid "9792a9f2-799d-58ba-9247-36ec66135b4f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529238}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529238} :answer-field/id #uuid "a28fbb07-9011-5ca0-97ac-fffd6b36f2ee" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529240}] :question/id #uuid "71433954-37ca-5812-b277-05c8f0f0a4e4" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n- **I.** $D$ is a singular matrix\n- **II.** $D$ is **not** a singular matrix\n- **III.** $det(D)=\\frac{7}{40}$\n\n$$\nD=\\begin{bmatrix}- \\frac{\\sqrt{7}}{5} & 1 & - \\frac{3 \\sqrt{7}}{4} \\\\ - \\frac{\\sqrt{7}}{5} & \\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2} & \\sqrt{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}- \\frac{\\sqrt{7}}{5} & 1 & - \\frac{3 \\sqrt{7}}{4} \\\\ - \\frac{\\sqrt{7}}{5} & \\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2} & \\sqrt{7}\\end{aligned}| \\\\  & =(- \\frac{\\sqrt{7}}{5})|\\begin{aligned}\\frac{1}{2} & \\frac{\\sqrt{7}}{4} \\\\ \\frac{3}{2} & \\sqrt{7}\\end{aligned}|+(-1)|\\begin{aligned}- \\frac{\\sqrt{7}}{5} & \\frac{\\sqrt{7}}{4} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\sqrt{7}\\end{aligned}|+(- \\frac{3 \\sqrt{7}}{4})|\\begin{aligned}- \\frac{\\sqrt{7}}{5} & \\frac{1}{2} \\\\ - \\frac{3 \\sqrt{7}}{5} & \\frac{3}{2}\\end{aligned}| \\\\  & =(- \\frac{\\sqrt{7}}{5})(\\frac{\\sqrt{7}}{2}- \\frac{3 \\sqrt{7}}{8})+(-1)(- \\frac{7}{5}+\\frac{21}{20})+(- \\frac{3 \\sqrt{7}}{4})(- \\frac{3 \\sqrt{7}}{10}+\\frac{3 \\sqrt{7}}{10}) \\\\  & =(- \\frac{\\sqrt{7}}{5})\\cdot \\frac{\\sqrt{7}}{8}+(-1)\\cdot (- \\frac{7}{20})+(- \\frac{3 \\sqrt{7}}{4})\\cdot 0 \\\\  & =- \\frac{7}{40}+\\frac{7}{20} \\\\  & =\\frac{7}{40}\\end{aligned}\n$$\n\nSince $det(D)=\\frac{7}{40}\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statements II and III are true."} {:db/id #edb/ref 17592186529250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e93d6b-04f6-5d4f-b5b6-d410c07da27b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529210} {:answer/id #uuid "ac318550-2f86-5de9-9b06-3ca0446a83ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529241}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529210} :answer-field/id #uuid "c469465a-d12b-5568-8d4c-567bbab54c8b" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529243} {:answer-field/choices [{:answer/id #uuid "48843694-108e-5d14-bd01-367c88bbda7b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529216} {:answer/id #uuid "66105f24-eeac-5dfa-906a-b29c7b525374" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529224}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529216} :answer-field/id #uuid "caa6403a-374c-56a6-9e6e-eff87afdb677" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529246} {:answer-field/choices [{:answer/id #uuid "0634ee5a-1fe4-5615-bb1f-de6045b61f9d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529207} {:answer/id #uuid "25008e01-79c7-58b7-aeed-e63a6324cfd6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529211}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529211} :answer-field/id #uuid "fd12a97e-9c51-5ed4-8b7d-226953a0be67" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529254}] :question/id #uuid "f4817fa1-7160-5d08-adc7-564c3155c399" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\nSelect all that apply.\n\n- **I.** $N$ is a singular matrix\n- **II.** $N$ is **not** a singular matrix\n- **III.** $det(N)=0$\n\n$$\nN=\\begin{bmatrix}\\frac{2 \\sqrt{2}}{3} & 1 & 2 \\sqrt{2} \\\\ - \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2 & - 4 \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(N) & =|\\begin{aligned}\\frac{2 \\sqrt{2}}{3} & 1 & 2 \\sqrt{2} \\\\ - \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2 & - 4 \\sqrt{2}\\end{aligned}| \\\\  & =\\frac{2 \\sqrt{2}}{3}|\\begin{aligned}- \\frac{1}{3} & \\sqrt{2} \\\\ -2 & - 4 \\sqrt{2}\\end{aligned}|+(-1)|\\begin{aligned}- \\frac{\\sqrt{2}}{3} & \\sqrt{2} \\\\ - \\frac{4 \\sqrt{2}}{3} & - 4 \\sqrt{2}\\end{aligned}|+2 \\sqrt{2}|\\begin{aligned}- \\frac{\\sqrt{2}}{3} & - \\frac{1}{3} \\\\ - \\frac{4 \\sqrt{2}}{3} & -2\\end{aligned}| \\\\  & =\\frac{2 \\sqrt{2}}{3}(\\frac{4 \\sqrt{2}}{3}+2 \\sqrt{2})+(-1)(\\frac{8}{3}+\\frac{8}{3})+2 \\sqrt{2}(\\frac{2 \\sqrt{2}}{3}- \\frac{4 \\sqrt{2}}{9}) \\\\  & =\\frac{2 \\sqrt{2}}{3}\\cdot \\frac{10 \\sqrt{2}}{3}+(-1)\\cdot \\frac{16}{3}+2 \\sqrt{2}\\cdot \\frac{2 \\sqrt{2}}{9} \\\\  & =\\frac{40}{9}- \\frac{16}{3}+\\frac{8}{9} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(N)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] :knowledge-point/title "Identifying Singular Matrices"} {:db/id #edb/ref 17592186059849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059454 :question/id #uuid "7780340c-43d6-5d38-9270-865914098218" :question/math-academy-id "e-14764" :question/problem "Given that the determinant of  $\\begin{bmatrix}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{bmatrix}$ is $2,$ find the value of the constant $k.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k\\mathbin{:}$\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{aligned}| & =3|\\begin{aligned}4 & 5 \\\\ 2 & 3\\end{aligned}|-1|\\begin{aligned}k & 5 \\\\ 0 & 3\\end{aligned}|+2|\\begin{aligned}k & 4 \\\\ 0 & 2\\end{aligned}| \\\\  & =3(12-10)-1(3k-0)+2(2k-0) \\\\  & =3\\cdot 2-1\\cdot 3k+2\\cdot 2k \\\\  & =6-3k+4k \\\\  & =k+6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $2,$ we have:\n\n$$\n\\begin{aligned}k+6 & =2 \\\\ k & =-4\\end{aligned}\n$$"} :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/questions [{:db/id #edb/ref 17592186060446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f01712c7-1167-5ce2-b75e-faae0fd6dd90" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440011} {:answer/id #uuid "b1d67a8b-60f6-5699-b39d-4d178f673f2f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440012}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440012} :answer-field/id #uuid "61f5a057-7cb0-51ea-b996-75db0a60dff4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440363} {:answer-field/choices [{:answer/id #uuid "c6fca5a5-1769-5de1-b1bf-16320511269e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440013} {:answer/id #uuid "cb641075-be34-57f4-a864-694183e2c508" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440014}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440014} :answer-field/id #uuid "879fdc02-b39f-5138-a50a-bc9a6b50ad60" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440364} {:answer-field/choices [{:answer/id #uuid "75886d2c-5cf6-5a81-8110-c8079335161c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440015} {:answer/id #uuid "7ea0b44e-7d7a-5b64-821c-4a5b0b90382a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440016}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440015} :answer-field/id #uuid "4c19ad5f-ec3a-56cd-ae45-a7c7a985e65c" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440365} {:answer-field/choices [{:answer/id #uuid "4a1c94fa-5812-57ef-8733-6134b2a1e0d0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440017} {:answer/id #uuid "f81f3281-2e69-5da9-9b98-4ee511d1a781" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440018}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440017} :answer-field/id #uuid "76e2a253-e6a9-582b-9179-7f6c5d046b9e" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440366} {:answer-field/choices [{:answer/id #uuid "5eba5ce9-07b6-5589-b99b-add0ef6aabc9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440019} {:answer/id #uuid "6daf17b8-46e1-58d1-9b63-2c0f10d0c47c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440020}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440019} :answer-field/id #uuid "fb5cb032-f8ea-56d0-adb4-1ec42dfab1ae" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440367} {:answer-field/choices [{:answer/id #uuid "1dba7438-ff22-567a-950d-78a7202b6d12" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440021} {:answer/id #uuid "b5f5fbbb-0e31-5721-bcc3-006f734ec307" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440022}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440021} :answer-field/id #uuid "abb35f96-8e34-5ec5-8483-299f03e8484c" :answer-field/key "VI" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440368}] :question/id #uuid "f04c86de-5ed5-52ee-bc8b-1a0c07c06519" :question/math-academy-id "q-9657" :question/problem "Given that the determinant of\n$\\begin{bmatrix}2 & -1 & 3 \\\\ x & 2 & 4 \\\\ -2 & 1 & x + 3\\end{bmatrix}$\nis $8$, find all the possible values of $x$.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-8$\n- **II.** $x=-2$\n- **III.** $x=2$\n- **IV.** $x=5$\n- **V.** $x=6$\n- **VI.** $x=8$" :question/worked-solution "The determinant is $x^{2} + 10 x + 24$. Setting it equal to $8$ gives $\\left\\{-8, -2\\right\\}$."} {:db/id #edb/ref 17592186060447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186357827} {:answer/id #uuid "1497bbf0-b0e3-55c9-a773-3097042ee709" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186357932} {:answer/id #uuid "94d5145f-94aa-5233-938d-f5a7dd10a709" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186359056} {:answer/id #uuid "bda894ff-ae9d-5d5a-99bd-a1f4b7cf8342" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359402} {:answer/id #uuid "e8ddf45e-881c-5c0c-a2da-d518f976e537" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186359817}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186357827} :answer-field/id #uuid "796c6d71-8b6e-59df-88c9-9b3757e40cfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360192}] :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $\\begin{bmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{aligned}| & =2|\\begin{aligned}3 & k \\\\ 0 & 1\\end{aligned}|-1|\\begin{aligned}2k+1 & k \\\\ 1 & 1\\end{aligned}|-4|\\begin{aligned}2k+1 & 3 \\\\ 1 & 0\\end{aligned}| \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"} {:db/id #edb/ref 17592186060456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c97d112-a733-50db-a3e0-14dc2721dcef" :answer/type {:db/ident :answer.type/text} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} {:answer/id #uuid "a2aa1a94-21f1-552d-ae6c-c5b0802357bb" :answer/type {:db/ident :answer.type/text} :answer/value "$10$ only" :db/id #edb/ref 17592186059360} {:answer/id #uuid "b2d37c14-0ed6-5cb1-ae4d-65ca40ec7dab" :answer/type {:db/ident :answer.type/text} :answer/value "$0$ only" :db/id #edb/ref 17592186059361} {:answer/id #uuid "0e5ddce2-efab-57ff-834e-5148be9476c7" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186059362} {:answer/id #uuid "73493f5b-e7e5-53c5-91c5-a37d38ea1731" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $-3$ only" :db/id #edb/ref 17592186059363}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} :answer-field/id #uuid "a3da1235-861c-5299-892e-dbd9ea51bf74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059358}] :question/id #uuid "aae8854c-5bc3-5b0c-a496-72765fde3229" :question/math-academy-id "q-9852" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$\\begin{bmatrix}0 & 7 & 4k \\\\ 0 & 9 & 5k \\\\ 0 & 11 & 6k\\end{bmatrix}$ is singular." :question/worked-solution "The determinant is $0$. Setting it equal to $0$ gives $\\mathbb{R}$."} {:db/id #edb/ref 17592186262917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fb98df-401c-5fa9-9f2f-08261df60aa9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186259918} {:answer/id #uuid "220b8b83-724a-5cbe-853b-6caa42638775" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186260170} {:answer/id #uuid "726ac3fa-740a-5e90-81fa-f599fc3f37a6" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186260875} {:answer/id #uuid "81ca9339-6bce-5219-8fae-787545463a11" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261005} {:answer/id #uuid "8c6b36bf-bffd-5918-ae53-d958ad6e391a" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261101}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261005} :answer-field/id #uuid "c45caafc-858f-500e-9ef9-058205b847f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262475}] :question/id #uuid "cb6a7e0a-d356-5b58-a703-e0864f9a1a58" :question/math-academy-id "q-128500" :question/problem "Given that\n$B=\\begin{bmatrix}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{bmatrix}$\nand $det(B)=12,$ find the value of $y.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}\\text{det}(B) & =|\\begin{aligned}1 & 2 & -5 \\\\ 1 & 2 & 1 \\\\ y & 2 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2 & 1 \\\\ 2 & 1\\end{aligned}|-2|\\begin{aligned}1 & 1 \\\\ y & 1\\end{aligned}|-5|\\begin{aligned}1 & 2 \\\\ y & 2\\end{aligned}| \\\\  & =0-2\\cdot (1-y)-5\\cdot (2-2y) \\\\  & =12y-12\\end{aligned}\n$$\n\nSince the determinant of the matrix is $12,$ we have:\n\n$$\n\\begin{aligned}12y-12 & =12 \\\\ 12y & =24 \\\\ y & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "183c086d-012b-5f39-b92e-4550955dfcbb" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186260085} {:answer/id #uuid "2044861f-98f6-51d9-9cf5-e5080be450a1" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186260152} {:answer/id #uuid "21a46985-36f6-5f1d-b213-16f3935ec5b0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260165} {:answer/id #uuid "91c5f6e6-19cd-5455-92f6-06f29a9d6687" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186261142} {:answer/id #uuid "c0800f44-af37-5d5d-b586-92ebc2148392" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261575}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186261575} :answer-field/id #uuid "9a39ba2f-181c-558b-b3c6-6fdf22cdca96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262399}] :question/id #uuid "9517ddd6-18dd-5bea-948b-a75416c96cbb" :question/math-academy-id "q-128502" :question/problem "Given that \n$C=\\begin{bmatrix}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{bmatrix}$ \nand $det(C)=28,$ find the value of $q.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $q:$\n\n$$\n\\begin{aligned}\\text{det}(C) & =|\\begin{aligned}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}q & 5 \\\\ -5 & 1\\end{aligned}|-3|\\begin{aligned}-1 & 5 \\\\ 0 & 1\\end{aligned}|+1|\\begin{aligned}-1 & q \\\\ 0 & -5\\end{aligned}| \\\\  & =2\\cdot (q+25)-3\\cdot (-1)+5 \\\\  & =2q+58\\end{aligned}\n$$\n\nSince the determinant of the matrix is $28,$ we have:\n\n$$\n\\begin{aligned}2q+58 & =28 \\\\ 2q & =-30 \\\\ q & =-15\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a96a6f2b-900e-5634-9638-19c6ba6bffea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} {:answer/id #uuid "5d1afda0-1dac-5620-821a-ad4de506b094" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439528}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439527} :answer-field/id #uuid "0a971e33-0a26-5898-ba8a-788195a8a8e8" :answer-field/key "I" :answer-field/type