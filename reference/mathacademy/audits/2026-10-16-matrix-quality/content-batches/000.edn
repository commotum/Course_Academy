} & 0 & -1 \\\\ 1 & \\sqrt{2} & 4\\end{aligned}| \\\\  & =2|\\begin{aligned}0 & -1 \\\\ \\sqrt{2} & 4\\end{aligned}|-\\sqrt{2}|\\begin{aligned}\\frac{1}{2} & -1 \\\\ 1 & 4\\end{aligned}|+2|\\begin{aligned}\\frac{1}{2} & 0 \\\\ 1 & \\sqrt{2}\\end{aligned}| \\\\  & =2(0+\\sqrt{2})-\\sqrt{2}(2+1)+2(\\frac{\\sqrt{2}}{2}-0) \\\\  & =2\\cdot \\sqrt{2}-\\sqrt{2}\\cdot 3+2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{2}-3\\sqrt{2}+\\sqrt{2} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."} {:db/id #edb/ref 17592186326671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6ffe837-0ba9-566a-847f-01c50e5b0d4e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438254} {:answer/id #uuid "0c851c6e-8e6f-5ce1-85f0-794bba8508bf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438255}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438255} :answer-field/id #uuid "ece7019d-4e4a-54c5-8c4b-3ee796bd1176" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439156} {:answer-field/choices [{:answer/id #uuid "69b3cb09-83cc-54f2-9f3a-46d5234e0bc2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438256} {:answer/id #uuid "e013cbff-c909-515f-a71d-027cdb4811c2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438257}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438256} :answer-field/id #uuid "1bcb1241-521a-5c92-ac65-6398206509ea" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439157} {:answer-field/choices [{:answer/id #uuid "1785546f-b00e-5a43-be50-0c26a6fc2ca6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438258} {:answer/id #uuid "1c201000-e71f-5609-9f1d-19bba5ab4630" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438259}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438258} :answer-field/id #uuid "e28dc200-2ac1-54de-90ea-6e018bd1ba08" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439158}] :question/id #uuid "084b3fe8-adf9-5ab7-9017-b2d4d829ca62" :question/math-academy-id "q-38179" :question/problem "Which of the following statements are true regarding the matrix $E$ given below?\n\nSelect all that apply.\n\n- **I.** $E$ is a singular matrix\n- **II.** $E$ is **not**  a singular matrix\n- **III.** $det(E)=-2$\n\n$$\nE=\\begin{bmatrix}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(E) & =|\\begin{aligned}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{aligned}| \\\\  & =\\frac{2}{3}|\\begin{aligned}5 & 6 \\\\ 7 & 8\\end{aligned}|-3|\\begin{aligned}\\frac{2}{3} & 6 \\\\ \\frac{2}{3} & 8\\end{aligned}|+4|\\begin{aligned}\\frac{2}{3} & 5 \\\\ \\frac{2}{3} & 7\\end{aligned}| \\\\  & =\\frac{2}{3}(40-42)-3(\\frac{16}{3}-\\frac{12}{3})+4(\\frac{14}{3}-\\frac{10}{3}) \\\\  & =\\frac{2}{3}\\cdot (-2)-3\\cdot \\frac{4}{3}+4\\cdot \\frac{4}{3} \\\\  & =-\\frac{4}{3}-\\frac{12}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(E)=0$, the matrix is singular. \n\nTherefore, only statement I is true."} {:db/id #edb/ref 17592186326673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79e4e142-7005-54c1-8d51-b38fccf87ef4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438260} {:answer/id #uuid "54cfd4e5-c485-53e9-8b91-e2afca217595" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438261}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438260} :answer-field/id #uuid "bc0815ad-f485-5e0c-8048-0318325f0ad4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439159} {:answer-field/choices [{:answer/id #uuid "7f7c0c3a-e50c-57b3-b6e3-787c897947c6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438262} {:answer/id #uuid "4c0b4616-bf0b-52ad-8642-7f8e6022ec10" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438263}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438263} :answer-field/id #uuid "ef01e74d-81a9-5880-81c3-faa3592706db" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439160} {:answer-field/choices [{:answer/id #uuid "8ce5156b-be05-52db-8fa2-508a2bebc677" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438264} {:answer/id #uuid "5c652fd1-d715-5a76-8fb9-1477a177d25a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438265}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438264} :answer-field/id #uuid "f4c6df6b-8841-5610-8b0d-3ae518f8442e" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439161}] :question/id #uuid "f2a72ef8-dad7-5172-8868-8d2781696df8" :question/math-academy-id "q-38182" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n- **I.** $Q$ is **not** a singular matrix\n- **II.** $Q$ is a singular matrix\n- **III.** $det(Q)=-5$\n\n$$\nQ=\\begin{bmatrix}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 7 \\\\ 5 & 8\\end{aligned}|-3|\\begin{aligned}1 & 7 \\\\ 2 & 8\\end{aligned}|+6|\\begin{aligned}1 & 4 \\\\ 2 & 5\\end{aligned}| \\\\  & =0-3(8-14)+6(5-8) \\\\  & =0-3\\cdot (-6)+6\\cdot (-3) \\\\  & =18-18 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186336011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89dca9db-88dc-5f58-9f23-ec98ca1bbc75" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438478} {:answer/id #uuid "128f9548-3706-5b6d-94e4-afd0ea31e354" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438479}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438479} :answer-field/id #uuid "f8abcdf3-f784-54de-90bb-b51f314f8912" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439268} {:answer-field/choices [{:answer/id #uuid "1b74bddc-ad74-5f61-a0ce-c1bb3f545d9e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438480} {:answer/id #uuid "f99619dc-7a17-50df-b37c-d5f5007df859" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438481}] :answer-field/correct {:answer/type 