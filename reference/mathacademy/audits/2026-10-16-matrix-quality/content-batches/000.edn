\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186400352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a30e54a5-5549-54be-a77d-0271a747f483" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437806} {:answer/id #uuid "1678c617-1408-5d9c-b2b6-f33cb2bcbc97" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437807}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437807} :answer-field/id #uuid "8934c094-53e8-5252-811d-16f83b72799e" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438932} {:answer-field/choices [{:answer/id #uuid "cdeb7450-ec19-5575-89aa-66f56497533b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437808} {:answer/id #uuid "cd4c6b03-6a3d-5e71-8ee1-bd76a8e47d7c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437809}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437808} :answer-field/id #uuid "f7edd53d-df96-5e60-b073-b95bd4d92abf" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438933} {:answer-field/choices [{:answer/id #uuid "0668d434-29bc-5c22-ae50-ede25ab3fb55" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437810} {:answer/id #uuid "a8d7c2a7-df8c-5627-999f-6d43c26ca389" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437811}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437811} :answer-field/id #uuid "b7f7e987-6e7f-5d92-a6ad-a4d71c321aa2" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438934}] :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n- **I.** $D$ is a singular matrix\n- **II.** $det(D)=1$\n- **III.** $det(D)=0$\n\n$$\nD=\\begin{bmatrix}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."} {:db/id #edb/ref 17592186400359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} {:answer/id #uuid "20bd5256-a3ef-5a48-b762-66cfb4a56832" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437819}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} :answer-field/id #uuid "f79065b5-83e0-5c45-91ca-02a92fe83586" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438938} {:answer-field/choices [{:answer/id #uuid "51e1d911-6963-56d2-a197-b7ef0fd454a4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437820} {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821} :answer-field/id #uuid "6d2d1bc7-850d-5cc3-a700-a5297c1412e2" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438939} {:answer-field/choices [{:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} {:answer/id #uuid "f7553a7c-6618-5039-9f2e-70225d0f69b9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437823}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} :answer-field/id #uuid "bd92868f-3a2b-5764-95b0-634de408c963" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438940}] :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nSelect all that apply.\n\n- **I.** $S$ is a singular matrix\n- **II.** $S$ is **not** a singular matrix\n- **III.** $det(S)=5+2\\sqrt{7}$\n\n$$\nS=\\begin{bmatrix}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186402609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53f93a90-917d-59e1-ad77-0b9aad541d3d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438266} {:answer/id #uuid "12af740c-a997-5387-8362-5e2cc16732ec" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438267}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438266} :answer-field/id #uuid "2b6fcdaf-3dd3-5706-a56b-12ba3e57c541" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439162} {:answer-field/choices [{:answer/id #uuid "80660670-28fa-562c-9cdd-803d3f3b6e24" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438268} {:answer/id #uuid "5834e804-b776-587a-9eff-2c1a6107cc1a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438269}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438269} :answer-field/id #uuid "676ac767-8dfd-50fa-9ecf-b51ab8fab0b5" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439163} {:answer-field/choices [{:answer/id #uuid "56d97f56-3c64-5231-b1a7-ace7dd7012d1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438270} {:answer/id #uuid "1c459c6d-1c91-560e-9b29-0f2524d0be20" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438271}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438270} :answer-field/id #uuid "091267d0-c528-519a-8b1c-763f1c12a047" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439164}] :question/id #uuid "a5eb8a6b-37c6-54e6-b340-18101dbf3f8f" :question/math-academy-id "q-38187" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\nSelect all that apply.\n\n- **I.** $N$ is **not** a singular matrix\n- **II.** $N$ is a singular matrix\n- **III.** $det(N)=-1$\n\n$$\nN=\\begin{bmatrix}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(N) & =|\\begin{aligned}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{aligned}| \\\\  & =\\frac{1}{7}|\\begin{aligned}4 & -\\frac{1}{7} \\\\ 5 & -\\frac{1}{7}\\end{aligned}|-3|\\begin{aligned}\\frac{1}{7} & -\\frac{1}{7} \\\\ \\frac{1}{7} & -\\frac{1}{7}\\end{aligned}|+(-\\frac{1}{7})|\\begin{aligned}\\frac{1}{7} & 4 \\\\ \\frac{1}{7} & 5\\end{aligned}| \\\\  & =\\frac{1}{7}(-\\frac{4}{7}+\\frac{5}{7})-3(-\\frac{1}{49}+\\frac{1}{49})-\\frac{1}{7}(\\frac{5}{7}-\\frac{4}{7}) \\\\  & =\\frac{1}{7}\\cdot \\frac{1}{7}-3\\cdot 0-\\frac{1}{7}\\cdot \\frac{1}{7} \\\\  & =\\frac{1}{49}-\\frac{1}{49} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(N)=0$, the matrix is singular. \n\nTherefore, only statement II is true."} {:db/id #edb/ref 17592186403335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8bfe8db-1989-5e4c-9ad9-c6db83ad7bb4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438484} {:answer/id #uuid "6b7cbeaf-dee8-5b96-8308-94729708799c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438485}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438484} :answer-field/id #uuid "4ec23c8b-291b-5610-9226-611cabeda584" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439271} {:answer-field/choices [{:answer/id #uuid "f42e4a93-c186-58e5-951e-917759693098" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438486} {:answer/id #uuid "f52e2b00-e5d8-52b7-83e8-eba250bef166" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438487}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438486} :answer-field/id #uuid "dfb6943e-42d8-5697-b023-3106b7e5611c" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439272} {:answer-field/choices [{:answer/id #uuid "74d5746f-c69f-5b13-8c52-ab7a0cb272bc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438488} {:answer/id #uuid "f9a8ba1d-5bcb-54c6-a41a-1a451759a5dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438489}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438489} :answer-field/id #uuid "2f6d01c9-2762-59a1-a7a5-cb52ffab3689" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439273}] :question/id #uuid "0582f249-3bf5-5079-8fe1-8ed6df521a52" :question/math-academy-id "q-69835" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nSelect all that apply.\n\n- **I.** $T$ is a singular matrix\n- **II.** $det(T)=-3$\n- **III.** $T$ is **not** a singular matrix\n\n \n\n$$\nT=\\begin{bmatrix}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{aligned}| \\\\  & =4|\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}|-2|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}|-1|\\begin{aligned}1 & 2 \\\\ -2 & -1\\end{aligned}| \\\\  & =4(2+3)-2(1+6)-1(-1+4) \\\\  & =4\\cdot 5-2\\cdot 7-1\\cdot 3 \\\\  & =20-14-3 \\\\  & =3\\end{aligned}\n$$\n\n \n\nSince $det(T)=3\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement III is true."} {:db/id #edb/ref 17592186529209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf30a48-c9e1-56ae-a6e7-d1c98a8ff3ea" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529217} {:answer/id #uuid "c73dcc5f-2dfd-545e-8686-1192c87baf69" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529244}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529217} :answer-field/id #uuid "6c836807-d3ab-5654-828e-8cfc6899a48e" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529226} {:answer-field/choices [{:answer/id #uuid "3352e3a8-a31e-5489-b928-3600c98b31be" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529215} {:answer/id #uuid "7eea3389-ae38-5700-acdf-02838bc43de5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529233}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529233} :answer-field/id #uuid "7319f1b7-7a37-5090-bc1d-79d9eee3c8d9" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529231} {:answer-field/choices [{:answer/id #uuid "59fb7559-abec-5a5a-8f38-66e0e05169a0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529221} {:answer/id #uuid "edd1215a-893f-52eb-9b40-de5e574e65b6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529249}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529249} :answer-field/id #uuid "885ed53f-bd5b-5462-9002-72b92ffeea39" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529235}] :question/id #uuid "0f86b247-8f09-549d-8811-1a1520e150f7" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n- **I.** $Q$ is a singular matrix\n- **II.** $Q$ is **not** a singular matrix\n- **III.** $det(Q)=0$\n\n$$\nQ=\\begin{bmatrix}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}\\frac{4 \\sqrt{2}}{3} & -1 & \\frac{\\sqrt{2}}{2} \\\\ \\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2 & - \\sqrt{2}\\end{aligned}| \\\\  & =\\frac{4 \\sqrt{2}}{3}|\\begin{aligned}\\frac{3}{2} & \\frac{\\sqrt{2}}{2} \\\\ 2 & - \\sqrt{2}\\end{aligned}|+1|\\begin{aligned}\\frac{2 \\sqrt{2}}{3} & \\frac{\\sqrt{2}}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & - \\sqrt{2}\\end{aligned}|+\\frac{\\sqrt{2}}{2}|\\begin{aligned}\\frac{2 \\sqrt{2}}{3} & \\frac{3}{2} \\\\ - \\frac{8 \\sqrt{2}}{3} & 2\\end{aligned}| \\\\  & =\\frac{4 \\sqrt{2}}{3}(- \\frac{3 \\sqrt{2}}{2}- \\sqrt{2})+1(- \\frac{4}{3}+\\frac{8}{3})+\\frac{\\sqrt{2}}{2}(\\frac{4 \\sqrt{2}}{3}+4 \\sqrt{2}) \\\\  & =\\frac{4 \\sqrt{2}}{3}\\cdot (- \\frac{5 \\sqrt{2}}{2})+1\\cdot \\frac{4}{3}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{16 \\sqrt{2}}{3} \\\\  & =- \\frac{20}{3}+\\frac{4}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."} {:db/id #edb/ref 17592186529214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623acce1-fff7-50e6-838b-7b0788c7f4cc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529223} {:answer/id #uuid "6f989a4f-56c1-50c2-8a6c-3fc3965f7ada" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529228}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529223} :answer-field/id #uuid "25dfb153-bf6c-5bc8-81b3-3f8c8e55fd75" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186529212} {:answer-field/choices [{:answer/id #uuid "6ea2a503-d065-55b2-8fd1-d25f4f09f9f5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529227} {:answer/id #uuid "7a8e8b31-aab5-5ebf-9a6d-c0ce4e4dec83" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186529232}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186529227} :answer-field/id #uuid "7227b94e-e860-5cf3-bd06-