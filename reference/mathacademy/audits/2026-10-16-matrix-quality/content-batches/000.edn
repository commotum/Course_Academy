ref 17592186443357} :answer-field/id #uuid "a0537553-eef3-548e-88f4-cd1a82bf96e9" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186443397} {:answer-field/choices [{:answer/id #uuid "279e25d8-a35a-51f3-909a-d3da6f6525dc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443329} {:answer/id #uuid "a52fec95-a2f3-5ebd-8882-c1f68cbdff88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186443360} {:answer/id #uuid "c2cfde41-79c8-5d5c-914a-bb91867ffd68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443366} {:answer/id #uuid "d430873f-a576-5e14-a8f1-aadcafaac029" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186443371}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186443371} :answer-field/id #uuid "ad304818-0973-5ffa-a52d-ed57c5f78953" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186443399} {:answer-field/choices [{:answer/id #uuid "09d46260-ae76-5595-885c-d19b632acbfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186443319} {:answer/id #uuid "80df9fd6-ebb0-583f-b02f-12ccf9bc0fd5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443355} {:answer/id #uuid "d2e2068e-3525-5b2c-a846-1daee1cd5c15" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443370} {:answer/id #uuid "e9dc424f-27f0-53d2-b13f-870a32506acb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186443382}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443355} :answer-field/id #uuid "be97c530-ef15-5632-922e-68f2e8ce47c0" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186443402} {:answer-field/choices [{:answer/id #uuid "4bf70411-1f19-53a2-a3b8-9a1b12b5ec70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186443338} {:answer/id #uuid "da239506-5511-599b-8ddb-c93e5896ff1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443374} {:answer/id #uuid "e151374e-b181-5980-8595-359e1cd1cb3f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186443378} {:answer/id #uuid "f00b04be-c45d-5315-b8e3-7fe8b852f7a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443384}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443374} :answer-field/id #uuid "e2ce7fcb-cc48-5f67-a313-8284ed75ba4a" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186443405}] :question/id #uuid "dd93c01d-3a4b-5e26-802f-bf34131bc696" :question/math-academy-id "q-363664" :question/problem "$$\nA=\\begin{bmatrix}0 & 0 \\\\ 1 & 1 \\\\ 3 & 3\\end{bmatrix},\\,Σ=\\begin{bmatrix}2\\sqrt{5} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $\\frac{3}{\\sqrt{10}}$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{1}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ -3{x}_{3} \\\\ {x}_{3}\\end{bmatrix}={x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}.\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-6}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-7}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\frac{1}{\\sqrt{10}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}0 & 0 \\\\ 1 & 1 \\\\ 3 & 3\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{2\\sqrt{5}}\\begin{bmatrix}0 \\\\ \\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{10}}{x}_{2}+\\frac{3}{\\sqrt{10}}{x}_{3}=0\\,⟹\\,{x}_{2}+3{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ -3{x}_{3} \\\\ {x}_{3}\\end{bmatrix}={x}_{1}{{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{1}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\,{u}_{3}=\\begin{bmatrix}0 \\\\ -\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{10}} & 0 & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & 0 & \\frac{1}{\\sqrt{10}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186545815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d123fb-94f0-5aac-857f-a1c531e7f651" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186545247} {:answer/id #uuid "23d43a08-a125-56be-8714-b272d81f49a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186545275} {:answer/id #uuid "a716560e-d5d2-5900-8632-2222944452ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186545507} {:answer/id #uuid "eea0b1f1-18c6-540d-8e1c-b25479154a86" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186545643}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186545643} :answer-field/id #uuid "4003ea6c-85a6-584e-907f-7e4790e055b5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186545695} {:answer-field/choices [{:answer/id #uuid "6bbd546a-ac91-57be-8257-ca874e2effc6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186545405} {:answer/id #uuid "b78b7d03-69a1-5546-ab22-9bb17524be88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186545534} {:answer/id #uuid "b7fdb3f7-442e-5568-ba87-007ae4162bc2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186545536} {:answer/id #uuid "ca7c8edd-16e1-565d-ad23-6ffd6816f3f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186545568}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186545536} :answer-field/id #uuid "9720450f-321d-5bbd-8340-39cc7efd2be9" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186545743} {:answer-field/choices [{:answer/id #uuid "086bf06e-49cc-5fc2-b690-21771d2e6292" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186545217} {:answer/id #uuid "b5e38f4b-d14f-5cd3-a709-59418ee77b2b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186545532} {:answer/id #uuid "bf4e1810-6af3-5193-8ab5-4d4c418b2f40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186545550} {:answer/id #uuid "d724a4a7-1aa6-53cf-9371-44d3f7f3ffca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186545594}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186545550} :answer-field/id #uuid "a1914afa-ce8e-56e4-9ab4-27489cd50a6f" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186545748} {:answer-field/choices [{:answer/id #uuid "0557401e-fab5-57e9-8d2e-cc9fa16eaa2c" :an