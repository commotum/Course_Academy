"0e0371a1-f883-509e-b3e4-7855d8e88716" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439535} {:answer/id #uuid "a0b90882-4bff-5443-8c31-7a91b7350876" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439536}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439536} :answer-field/id #uuid "198cedf3-5b38-5bbc-a323-0071838c80e3" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440125} {:answer-field/choices [{:answer/id #uuid "5eeee25d-d7f6-5d5a-afc8-5671c6bd7594" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439537} {:answer/id #uuid "bb9a7ab8-cbe0-554b-b424-c7b88ae9466a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439538}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439538} :answer-field/id #uuid "b9ffb7f8-f243-5639-9741-7c62c83492a6" :answer-field/key "VI" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440126}] :question/id #uuid "50033102-58e0-5acc-81a2-81bf1717d471" :question/math-academy-id "q-130575" :question/problem "Given that the determinant of\n$\\begin{bmatrix}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{bmatrix}$\nis $-48$, find all the possible values of $z.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $z=-5$\n- **II.** $z=-2$\n- **III.** $z=3$\n- **IV.** $z=5$\n- **V.** $z=6$\n- **VI.** $z=7$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $z:$\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}| & =2|\\begin{aligned}3 & z \\\\ -1 & 1\\end{aligned}|-1|\\begin{aligned}2 & z \\\\ z & 1\\end{aligned}|+5|\\begin{aligned}2 & 3 \\\\ z & -1\\end{aligned}| \\\\  & =2(3+z)-(2-{z}^{2})+5(-2-3z) \\\\  & =6+2z-2+{z}^{2}-10-15z \\\\  & ={z}^{2}-13z-6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-48,$ we have:\n\n$$\n\\begin{aligned}{z}^{2}-13z-6 & =-48 \\\\ {z}^{2}-13z+42 & =0 \\\\ z & =\\frac{-(-13)\\pm \\sqrt{{13}^{2}-4\\cdot 1\\cdot 42}}{2\\cdot 1} \\\\  & =\\frac{13\\pm \\sqrt{1}}{2} \\\\  & =\\frac{13\\pm 1}{2} \\\\  & =6,7\\end{aligned}\n$$\n\nTherefore, the solutions are $z=6$ and $z=7.$"} {:db/id #edb/ref 17592186265937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb6fbea-1024-5d3a-b73a-2652854807d7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439539} {:answer/id #uuid "bd68a459-7909-5063-ad2f-80212bf601c5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439540}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439540} :answer-field/id #uuid "875c3194-24a6-51ec-b673-71d77e13cf9f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440127} {:answer-field/choices [{:answer/id #uuid "db104ef8-98d3-5cd8-a99b-bdad6e429a02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439541} {:answer/id #uuid "1926db50-38a9-55a3-a39f-74a8cd416c7e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439542}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439541} :answer-field/id #uuid "c022e73a-1dba-5025-8738-461083ad2247" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440128} {:answer-field/choices [{:answer/id #uuid "d47cc84f-b399-5400-a29f-c5565f45d833" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439543} {:answer/id #uuid "8959a480-3878-5f14-97