/id #edb/ref 17592186408020 :question/id #uuid "256724b0-7532-517f-89d9-acc3daa6cf56"} :step/id #uuid "7f3114bf-a6be-5b7f-9354-2b9bd578a3a3" :step/next {:db/id #edb/ref 17592186505859}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186505095} {:activity/first-step {:db/id #edb/ref 17592186511613} :activity/id #uuid "bde3e653-9f22-5e55-948f-85ddf2e516b7" :activity/steps [{:db/id #edb/ref 17592186511603 :step/content {:db/id #edb/ref 17592186370654 :question/id #uuid "d4516c67-259f-5935-b3cd-af66ef9e5af8"} :step/id #uuid "2ae9fbe8-190e-52f6-9c10-192410ac4065"} {:db/id #edb/ref 17592186511611 :step/content {:db/id #edb/ref 17592186511512 :question/id #uuid "79df1f11-1c43-51b8-8e99-4f8efb003972"} :step/id #uuid "392eb1aa-9b69-5309-8d5f-16ee0b5603a3" :step/next {:db/id #edb/ref 17592186511603}} {:db/id #edb/ref 17592186511613 :step/content {:db/id #edb/ref 17592186443406 :question/id #uuid "77278df4-e113-5900-8941-27a77a33d7c4"} :step/id #uuid "3be28e76-1c88-5275-b4a3-f54e97e30cfd" :step/next {:db/id #edb/ref 17592186511652}} {:db/id #edb/ref 17592186511652 :step/content {:db/id #edb/ref 17592186371436 :question/id #uuid "1fbce2d1-be2d-5c6a-bfaf-0486d4c0daa8"} :step/id #uuid "ada82642-7b26-53dc-9e04-7877d6ceb00a" :step/next {:db/id #edb/ref 17592186511611}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186510767} {:activity/first-step {:db/id #edb/ref 17592186526150} :activity/id #uuid "ee9f2ff5-924b-56a2-8b37-9bc101891c90" :activity/steps [{:db/id #edb/ref 17592186526108 :step/content {:db/id #edb/ref 17592186162725 :question/id #uuid "dcd0e8b8-71e5-5dcd-a370-0847d15e9434"} :step/id #uuid "083a494b-c789-5c77-8d90-bf2796641ed3" :step/next {:db/id #edb/ref 17592186526143}} {:db/id #edb/ref 17592186526143 :step/content {:db/id #edb/ref 17592186525985 :question/id #uuid "03ae1482-39ea-5fad-a59a-df13068a2393"} :step/id #uuid "c7d0e522-c0f3-5784-84ea-d620614fe1b5" :step/next {:db/id #edb/ref 17592186526147}} {:db/id #edb/ref 17592186526147 :step/content {:db/id #edb/ref 17592186443407 :question/id #uuid "c1d729e8-d1cb-584b-b25e-2da8d463c255"} :step/id #uuid "e1f66dfa-3760-5612-bfad-a3090a4dcb42"} {:db/id #edb/ref 17592186526150 :step/content {:db/id #edb/ref 17592186162712 :question/id #uuid "0acab5c5-194e-580b-922b-276032b93c12"} :step/id #uuid "e90624ae-0e4a-5b46-b4b0-b6cd7ba7b5d1" :step/next {:db/id #edb/ref 17592186526108}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186525206} {:activity/first-step {:db/id #edb/ref 17592186549072} :activity/id #uuid "dd972c8c-5f4c-56c4-a97b-d1fb6dbd5aa0" :activity/steps [{:db/id #edb/ref 17592186549072 :step/content {:db/id #edb/ref 17592186408020 :question/id #uuid "256724b0-7532-517f-89d9-acc3daa6cf56"} :step/id #uuid "028b136c-5288-5837-bb2a-cd2215ac3911" :step/next {:db/id #edb/ref 17592186549144}} {:db/id #edb/ref 17592186549097 :step/content {:db/id #edb/ref 17592186549020 :question/id #uuid "84533a55-9193-5a76-a277-23539897c843"} :step/id #uuid "4d21c646-e85c-56f6-8e61-3f2078ff2fdc"} {:db/id #edb/ref 17592186549144 :step/content {:db/id #edb/ref 17592186162725 :question/id #uuid "dcd0e8b8-71e5-5dcd-a370-0847d15e9434"} :step/id #uuid "cf45a60d-01f5-523c-9aeb-263291d734f0" :step/next {:db/id #edb/ref 17592186549097}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186548354} {:activity/first-step {:db/id #edb/ref 17592186554652} :activity/id #uuid "d9857308-ff4e-593e-8311-ba09e1f7efdd" :activity/steps [{:db/id #edb/ref 17592186554652 :step/content {:db/id #edb/ref 17592186399329 :question/id #uuid "4670b2c4-578c-543d-913f-4a2e02949175"} :step/id #uuid "1a33946e-506b-53c6-b93a-9bf44559027f" :step/next {:db/id #edb/ref 17592186554746}} {:db/id #edb/ref 17592186554660 :step/content {:db/id #edb/ref 17592186408019 :question/id #uuid "07d790e0-8df9-5a35-b3fe-bdc95541cdd3"} :step/id #uuid "2ff88467-5969-5e38-b836-e4aa84d92e80"} {:db/id #edb/ref 17592186554733 :step/content {:db/id #edb/ref 17592186549020 :question/id #uuid "84533a55-9193-5a76-a277-23539897c843"} :step/id #uuid "cbc82354-7dd4-5242-8b45-d0398f57ee39" :step/next {:db/id #edb/ref 17592186554660}} {:db/id #edb/ref 17592186554746 :step/content {:db/id #edb/ref 17592186497345 :question/id #uuid "2c32a996-4944-5e2d-afe2-519907ae493e"} :step/id #uuid "eef19d66-db46-502e-88ca-61fb86cd6bca" :step/next {:db/id #edb/ref 17592186554733}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186553861}] :db/id #edb/ref 17592186048143 :topic/knowledge-points [{:db/id #edb/ref 17592186162041 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161835 :question/id #uuid "16e5cc04-aa74-55f7-992b-b9992a8dd1c7" :question/math-academy-id "e-8632" :question/problem "![](images/fd/fd51d8d8bc91a4702ad01324e7e444f099276dfd80e77e260fa9944d0dac9f6c.svg)\nConsider the matrices $A$ and $\\Sigma$ shown above. Given that $A=U \\Sigma V^T$ is a singular value decomposition of $A,$ find a $2\\times 2$ matrix that  could be the matrix $V.$" :question/worked-solution "Recall that if  $A=U \\Sigma V^T$ is a singular value decomposition of a $3 \\times 2$ matrix $A,$ then\n\n- $\\Sigma$ is a $3 \\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3 \\times 3$ matrix,\n\n- $V$ is an orthogonal $2 \\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & 1 \\\\ -1 & -3 \\\\ -4 & 4\\end{bmatrix}}^{T}\\begin{bmatrix}3 & 1 \\\\ -1 & -3 \\\\ -4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -1 & -4 \\\\ 1 & -3 & 4\\end{bmatrix}\\begin{bmatrix}3 & 1 \\\\ -1 & -3 \\\\ -4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}26 & -10 \\\\ -10 & 26\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values. From the matrix $\\Sigma,$ we deduce that $\\sigma_1=6$ and $\\sigma_2=4.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of $A^T \\! A$):\n\n- For $\\lambda_1=\\sigma_1^2=36,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-36I & =\\begin{bmatrix}26 & -10 \\\\ -10 & 26\\end{bmatrix}-36\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-10 & -10 \\\\ -10 & -10\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A^T \\! A - 36I)\\mathbf{v}=\\mathbf{0}$ gives the unit eigenvector\n![](images/d7/d7fa1eea4f89ef21e80d7e090d4487447cfc7a78b6edc99df4b3fd4fe51ab03a.svg)\n\n- For $\\lambda_2=\\sigma_2^2=16,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-16I & =\\begin{bmatrix}26 & -10 \\\\ -10 & 26\\end{bmatrix}-16\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}10 & -10 \\\\ -10 & 10\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A^T \\! A - 16I)\\mathbf{v}=\\mathbf{0}$ gives the unit eigenvector\n![](images/2c/2cc8e66369af5363ecfe712442910d939308452a61405e77c311bb3bc993bbae.svg)\n\nFinally, we construct the matrix $V\\mathbin{:}$\n\n![](images/61/6149abf5eabb91a50f0bee958e2a1fbaf547b75f10437f5449d8e06ea0789153.svg)"} :knowledge-point/id #uuid "44c68619-9cf3-5dd8-b3db-00c9730d3308" :knowledge-point/questions [{:db/id #edb/ref 17592186162711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88817c4f-c3b9-56bc-adcd-03c60a03192d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161559} {:answer/id #uuid "ab726398-a6bf-5ccb-8b76-7638be326bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161560} {:answer/id #uuid "b6527ce3-e389-5aaa-b56f-28b8e5cb3b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186161561} {:answer/id #uuid "192d7516-f9d8-5c3c-923d-9aea265083e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161562} {:answer/id #uuid "70c54196-2e1b-509b-a193-ae9743cdbb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161563}] :answer-field/id #uuid "7b64cb77-d8a8-5314-8588-5996a0ed2a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161558} {:answer-field/choices [{:answer/id #uuid "fcbb2747-c859-5f45-8d0d-7a05c9e1438c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} {:answer/id #uuid "3a523ac3-cde3-56a8-a0ad-d2ed6c685448" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395272} {:answer/id #uuid "0bc93829-a56e-5c44-b5e8-b1f6a5b14a09" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186395273} {:answer/id #uuid "b256bcc9-0977-57b1-a4d8-3631bdea12e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395274} {:answer/id #uuid "38bfef24-5630-5d56-928e-7a0c767b17da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395275}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} :answer-field/id #uuid "1d6fa282-78f2-5e39-89f3-9b4093833ea4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395270}] :question/id #uuid "e4c01100-25ba-535e-8cf2-008c4f230608" :question/math-academy-id "q-97364" :question/problem "$$\nA=\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 & -2 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=2.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=9,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-9I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-9\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-9I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=4,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-4I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-4I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186162713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "600bf3db-5667-53ef-8cc8-697e89e9eb2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186423726} {:answer/id #uuid "c1e582c7-f43a-5074-9431-2dbeec8476c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186423785} {:answer/id #uuid "d43023ae-90ad-5c17-8e06-f3d88fb48abd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186423799} {:answer/id #uuid "e125ccac-6900-5888-a6d0-a05c0b71786f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186423807} {:answer/id #uuid "e7e0fb65-d734-5e45-8732-f3de80575f14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186423811}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186423799} :answer-field/id #uuid "574876ef-03aa-5a40-bf88-67cee41508d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161570}] :question/id #uuid "59824d51-1add-5e7f-bc52-6958bfc3593a" :question/math-academy-id "q-97366" :question/problem "$$\nA=\\begin{bmatrix}0 & 0 \\\\ 1 & -1 \\\\ -2 & 2\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{10} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 0 \\\\ 1 & -1 \\\\ -2 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 0 \\\\ 1 & -1 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 & -2 \\\\ 0 & -1 & 2\\end{bmatrix}\\begin{bmatrix}0 & 0 \\\\ 1 & -1 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -5 \\\\ -5 & 5\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{10}$ and ${\\sigma }_{2}=0.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=10,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-10I & =\\begin{bmatrix}5 & -5 \\\\ -5 & 5\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-5 & -5 \\\\ -5 & -5\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-10I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}5 & -5 \\\\ -5 & 5\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}5 & -5 \\\\ -5 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186371401 :question/answer-fields [{: