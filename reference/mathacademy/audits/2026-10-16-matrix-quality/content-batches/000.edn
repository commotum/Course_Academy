w of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}6 & 0 & 7 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{aligned}| & =6|\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}|-0|\\begin{aligned}0 & 0 \\\\ 1 & -1\\end{aligned}|+7|\\begin{aligned}0 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =6(-2-0)-0+7(0-2) \\\\  & =6\\cdot (-2)+7\\cdot (-2) \\\\  & =-12-14 \\\\  & =-26\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f2d595-4c96-599f-b04a-ef1a4facbf7d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186324134} {:answer/id #uuid "35476165-d1db-5ee5-b183-b3201978c25b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324408} {:answer/id #uuid "36554c2e-a686-5080-983a-7fd2be339db8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324414} {:answer/id #uuid "5dc9de58-8130-508b-ad5a-dc48cfe4914d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186324751} {:answer/id #uuid "a45499fc-34c3-5b71-b300-396e74e38e5c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186325368}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186324134} :answer-field/id #uuid "17302b73-c3c5-5ca7-9ed6-b18a09cd2b48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326262}] :question/id #uuid "687c1640-263b-54f0-8cd7-1fc76a39da2b" :question/math-academy-id "q-38180" :question/problem "Find the value of $|\\begin{aligned}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{aligned}| & =0|\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}|-(-1)|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}|+3|\\begin{aligned}1 & 0 \\\\ 3 & -2\\end{aligned}| \\\\  & =0+1(0-6)+3(-2-0) \\\\  & =1\\cdot (-6)+3\\cdot (-2) \\\\  & =-6-6 \\\\  & =-12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186364948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b194044-2804-5fcf-a8b9-85153f639110" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186364950} {:answer/id #uuid "54638e37-8e75-56d4-9a53-7e2c86da678b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364951} {:answer/id #uuid "c81acd3d-ac95-59d4-82b7-c347ecf84382" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364952} {:answer/id #uuid "0c9c5b60-f770-5f9a-ba14-7c25357899e4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364953} {:answer/id #uuid "00b39530-0e0b-51c1-a111-9de7ad7bbe3b" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186364954}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364953} :answer-field/id #uuid "edaea1a1-bae4-5261-82aa-d4974642b5d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364949}] :question/id #uuid "16690ec9-e7e6-5efe-838c-d6c519315582" :question/math-academy-id "q-128308" :question/problem "Find the value of $|\\begin{aligned}7 & 1 & -3 \\\\ 0 & 3 & 1 \\\\ -3 & 1 & 2\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}7 & 1 & -3 \\\\ 0 & 3 & 1 \\\\ -3 & 1 & 2\\end{aligned}| & =7|\\begin{aligned}3 & 1 \\\\ 1 & 2\\end{aligned}|-1|\\begin{aligned}0 & 1 \\\\ -3 & 2\\end{aligned}|-3|\\begin{aligned}0 & 3 \\\\ -3 & 1\\end{aligned}| \\\\  & =7(6-1)-1(0+3)-3(0+9) \\\\  & =7\\cdot 5-1\\cdot 3-3\\cdot 9 \\\\  & =35-3-27 \\\\  & =5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee433e2e-01a3-589b-be2a-e296c1083d5c" :answer/type {:db/ident :answer.type/math} :answer/value "994" :db/id #edb/ref 17592186534249}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "994" :db/id #edb/ref 17592186534249} :answer-field/id #uuid "1293797e-50e4-52c1-9d9c-b8e13430af35" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534219}] :question/id #uuid "0e084855-b516-581f-ad22-fe3ead569b7b" :question/problem "If $R=[\\begin{aligned}8 & 7 & -2 \\\\ -6 & 2 & -6 \\\\ -6 & 6 & 7\\end{aligned}],$ then $det(R)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}8 & 7 & -2 \\\\ -6 & 2 & -6 \\\\ -6 & 6 & 7\\end{aligned}| & =8|\\begin{aligned}2 & -6 \\\\ 6 & 7\\end{aligned}|-7|\\begin{aligned}-6 & -6 \\\\ -6 & 7\\end{aligned}|+(-2)|\\begin{aligned}-6 & 2 \\\\ -6 & 6\\end{aligned}| \\\\  & =8(2\\cdot 7-(-6)\\cdot 6)+(-7)((-6)\\cdot 7-(-6)\\cdot (-6))+(-2)((-6)\\cdot 6-2\\cdot (-6)) \\\\  & =8(14-(-36))+(-7)(-42-36)+(-2)(-36-(-12)) \\\\  & =8\\cdot 50+(-7)\\cdot (-78)+(-2)\\cdot (-24) \\\\  & =400+546+48 \\\\  & =994\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef9004f-9673-5d56-b880-e9fd7d88fc3d" :answer/type {:db/ident :answer.type/math} :answer/value "-218" :db/id #edb/ref 17592186534224}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-218" :db/id #edb/ref 17592186534224} :answer-field/id #uuid "bb3b7366-e77f-5264-a6e0-