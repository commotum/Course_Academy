answer/value "-32" :db/id #edb/ref 17592186261839}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839} :answer-field/id #uuid "b65a4ca0-f974-538c-8c68-2ae22626c269" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262454}] :question/id #uuid "94e0f9cc-6b5b-54e5-ac6a-648684ded023" :question/math-academy-id "q-128309" :question/problem "Find the value of $|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}| & =-2|\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}|-1|\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}|+1|\\begin{aligned}1 & 4 \\\\ 5 & -3\\end{aligned}| \\\\  & =-2(4-0)-1(1-0)-1(-3-20) \\\\  & =-2\\cdot 4-1\\cdot 1+1\\cdot (-23) \\\\  & =-8-1-23 \\\\  & =-32\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c438cd2-2f9a-56e9-ba78-198237723b47" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186290809}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186290809} :answer-field/id #uuid "9902feec-4c1f-5bad-9074-0772c0883e74" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292218}] :question/id #uuid "ff3bf305-a423-59b5-a761-0e3f9822d595" :question/math-academy-id "q-275585" :question/problem "If $A=\\begin{bmatrix}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{bmatrix},$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-5 & 3 & 0 \\\\ 1 & 7 & 5 \\\\ 0 & -2 & -3\\end{aligned}| & =-5|\\begin{aligned}7 & 5 \\\\ -2 & -3\\end{aligned}|-3|\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}|+0|\\begin{aligned}1 & 7 \\\\ 0 & -2\\end{aligned}| \\\\  & =-5(-21-(-10))-3(-3-0)+0 \\\\  & =-5\\cdot (-11)-3\\cdot (-3) \\\\  & =55+9 \\\\  & =64\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb31b60f-3050-5ef7-b4c3-2476ae1e52f6" :answer/type {:db/ident :answer.type/math} :answer/value "-146" :db/id #edb/ref 17592186293849}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-146" :db/id #edb/ref 17592186293849} :answer-field/id #uuid "9e0b8646-041e-54fe-904d-5fd7e7631312" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294500}] :question/id #uuid "6794ccbb-8ffd-5507-a0b5-d0921c89d7f6" :question/math-academy-id "q-280387" :question/problem "If $H=\\begin{bmatrix}0 & 7 & 2 \\\\ 1 & 0 & -5 \\\\ 4 & -3 & 0\\end{bmatrix},$ then $det(H)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 7 & 2 \\\\ 1 & 0 & -5 \\\\ 4 & -3 & 0\\end{aligned}| & =0|\\begin{aligned}0 & -5 \\\\ -3 & 0\\end{aligned}|-7|\\begin{aligned}1 & -5 \\\\ 4 & 0\\end{aligned}|+2|\\begin{aligned}1 & 0 \\\\ 4 & -3\\end{aligned}| \\\\  & =0-7(0-(-20))+2(-3-0) \\\\  & =-7\\cdot (20)+2\\cdot (-3) \\\\  & =-140-6 \\\\  & =-146\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a27456-d8f3-561b-bb79-e130d6872c6c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293031}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293031} :answer-field/id #uuid "3d897447-080d-5fa1-811f-5026bf48e4a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294141}] :question/id #uuid "ee0a6b76-25b3-5557-92d9-083561656751" :question/math-academy-id "q-280390" :question/problem "If $A=\\begin{bmatrix}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{bmatrix},$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{aligned}| & =0|\\begin{aligned}0 & 5 \\\\ 0 & 4\\end{aligned}|-2|\\begin{aligned}0 & 5 \\\\ 0 & 4\\end{aligned}|+(-3)|\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}| \\\\  & =0-2(0-0)-3(0-0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1339ed7b-7b32-5f2e-97a1-9339503ac331" :answer/type {:db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186293012}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186293012} :answer-field/id #uuid "93fac66a-4741-5f19-907d-88bd6bf67c55" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294462}] :question/id #uuid "602c9b3b-40e9-5371-929a-34e8b2aaccf1" :question/math-academy-id "q-280393" :question/problem "If $Q=\\begin{bmatrix}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix},$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{aligned}| & =3|\\begin{aligned}1 & 0 \\\\ 3 & 2\\end{aligned}|-(-2)|\\begin{aligned}4 & 0 \\\\ -1 & 2\\end{aligned}|+5|\\begin{aligned}4 & 1 \\\\ -1 & 3\\end{aligned}| \\\\  & =3(1\\cdot 2-0\\cdot 3)+2(4\\cdot 2-0\\cdot (-1))+5(4\\cdot 3-1\\cdot (-1)) \\\\  & =3(2)+2(8)+5(12+1) \\\\  & =6+16+5(13) \\\\  & =6+16+65 \\\\  & =87\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7756ac8b-4d3e-5612-bad7-e5a160c5a43f" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186293420}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186293420} :answer-field/id #uuid "a7577202-1833-561f-80ac-32392b1ecb99" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294534}] :question/id #uuid "5aadd6ce-d715-5a22-9944-d786941130cb" :question/math-academy-id "q-280394" :question/problem "If $R=\\begin{bmatrix}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{bmatrix},$ then $det(R)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{aligned}| & =1|\\begin{aligned}3 & 5 \\\\ -1 & 2\\end{aligned}|-(-2)|\\begin{aligned}4 & 5 \\\\ 6 & 2\\end{aligned}|+0|\\begin{aligned}4 & 3 \\\\ 6 & -1\\end{aligned}| \\\\  & =1(3\\cdot 2-5\\cdot (-1))+2(4\\cdot 2-5\\cdot 6)+0 \\\\  & =1(6+5)+2(8-30) \\\\  & =11+2(-22) \\\\  & =11-44 \\\\  & =-33\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "199cfd6b-b7c6-5ebd-9bb2-5a78fca81a8a" :answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186293039}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186293039} :answer-field/id #uuid "ca1eadfe-246c-5