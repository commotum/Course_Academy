T}\\,A-16I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}8 & -8 \\\\ -8 & 8\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}8 & -8 \\\\ -8 & 8\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186388813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166eb57b-154c-5dff-9b80-1f8ca0845010" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388815} {:answer/id #uuid "3387a72d-c34d-5440-b9c6-c13590f43357" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186388816} {:answer/id #uuid "f74892c7-e706-5f81-ba76-aab1487434fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186388817} {:answer/id #uuid "3938ff66-5101-512b-b7f9-9ec1cbda303b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186388818} {:answer/id #uuid "b2140a7a-513d-531e-b6b9-0b2b2b2e4392" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}