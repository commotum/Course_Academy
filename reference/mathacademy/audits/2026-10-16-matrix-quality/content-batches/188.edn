\\end{bmatrix}+\\begin{bmatrix}-3 & 6 & -3 \\\\ -6 & 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-3 & -2+6 & -6-3 \\\\ 12-6 & -2+4 & 0+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 4 & -9 \\\\ 6 & 2 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cda33be-f4c6-5358-b97c-ac509dfe5e84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 33 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547221} {:answer/id #uuid "4dc9bf0f-6dcb-5d38-bdaa-cdb63cc04f58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186547222} {:answer/id #uuid "70680470-4943-58cd-932c-8ed0d4edfaa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ -9 & 0\\end{bmatrix}" :db/id #edb/ref 17592186547231} {:answer/id #uuid "719f4497-e045-5232-a000-2c042474f432" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 21 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547232} {:answer/id #uuid "8b10ff0b-61b8-501e-81b1-d9002a417dca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 15 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547235}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 15 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547235} :answer-field/id #uuid "1ba1a1ce-69bf-5937-bd9e-5f3def9e7216" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547204}] :question/id #uuid "4f8a4836-e75f-52bc-a172-eb28bcaeb8fe" :question/problem "Calculate $6P + 3H$, where\n$P = \\begin{bmatrix}1 & 0 \\\\ 4 & 4\\end{bmatrix}$\nand\n$H = \\begin{bmatrix}1 & 0 \\\\ -3 & 0\\end{bmatrix}$." :question/worked-solution "We multiply each entry of $P$ by $6$ and each entry of $H$ by $3,$ and then add the resulting matrices, 