3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d01278-cb84-5f5d-a32b-b98ca83a321c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260074} {:answer/id #uuid "a75df9e5-ef98-5f15-a399-833d4c5f611f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186261335} {:answer/id #uuid "b146748e-e256-5c6d-9fa5-662f3fd71470" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -5 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261440} {:answer/id #uuid "b80aadfb-906c-533d-99bd-4de8a4b77396" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261489} {:answer/id #uuid "ee25100e-908f-5ac7-adb9-fa6c14c5c100" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186261971}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261489} :answer-field/id #uuid "31cbb2e5-a601-51eb-b475-516bf69291e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262215}] :question/id #uuid "1a15a17b-1180-5608-8f0b-187c74fe5518" :question/math-academy-id "q-126009" :question/problem "Calculate $-A+2B$, where\n$A=\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}0 & -2 \\\\ -2 & 2\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $A$ by $-1$ and each entry of $B$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}-A+2B & =(-1)\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix}+2\\begin{bmatrix}0 & -2 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-1)\\cdot 3 & (-1)\\cdot 1 \\\\ (-1)\\cdot 1 & (-1)\\cdot 0\\end{bmatrix}+\\begin{bmatrix}2\\cdot 0 & 2\\cdot (-2) \\\\ 2\\cdot (-2) & 2\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}0 & -4 \\\\ -4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3+0 & -1+(-4) \\\\ -1+(-4) & 0+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a6d9c98-0d36-5c8c-88d6-f29f7189dc93" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298010}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298010} :answer-field/id #uuid "70257ab0-a556-5053-9433-85fc9778f431" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299016} {:answer-field/choices [{:answer/id #uuid "6a0e90e7-1f3e-5b6b-84b6-2b5faa9af3c4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298007}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298007} :answer-field/id #uuid "8045faa8-8bb2-5d93-891e-841546247f14" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299072} {:answer-field/choices [{:answer/id #uuid "44fd0c6e-d854-58df-95cb-a0a90567c1d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297835}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297835} :answer-field/id #uuid "b8fe989e-dadb-5348-aa38-7751bf6cd3b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299264} {:answer-field/choices [{:answer/id #uuid "096d5b5