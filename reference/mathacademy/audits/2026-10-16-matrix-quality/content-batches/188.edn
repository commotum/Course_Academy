,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}2M+2F & =2\\begin{bmatrix}4 & 3 \\\\ 4 & 4\\end{bmatrix}+2\\begin{bmatrix}4 & 1 \\\\ 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 4 & 2\\cdot 3 \\\\ 2\\cdot 4 & 2\\cdot 4\\end{bmatrix}+\\begin{bmatrix}2\\cdot 4 & 2\\cdot 1 \\\\ 2\\cdot 3 & 2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 6 \\\\ 8 & 8\\end{bmatrix}+\\begin{bmatrix}8 & 2 \\\\ 6 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}8+8 & 6+2 \\\\ 8+6 & 8+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & 8 \\\\ 14 & 10\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0260a01f-673f-54ca-b6d5-6a4282e31a2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 12 \\\\ 14 & 11\\end{bmatrix}" :db/id #edb/ref 17592186547194} {:answer/id #uuid "14e1ebd9-e302-5236-a1d1-f5eda6b5e6e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 3 \\\\ 8 & 5\\end{bmatrix}" :db/id #edb/ref 17592186547202} {:answer/id #uuid "1fb5a771-daf3-52e9-8b38-0e6585fca8bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186547207} {:answer/id #uuid "8f843875-6df8-502d-b2cb-bd665c753d81" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 9 \\\\ 8 & 7\\end{bmatrix}" :db/id #edb/ref 17592186547237} {:answer/id #uuid "e87cc193-1230-5ed9-92e4-eea668a20f67" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 15 \\\\ 16 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547265}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 15 \\\\ 16 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547265} :answer-field/id #uuid "04ac3c10-4cf0-5f05-9eb9-e8c40f11a5ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547195}]