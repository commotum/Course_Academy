 \\\\ 2 & - \\frac{1}{2}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284d06fe-6bc8-5a46-8f7a-84f2322ca80b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{8}{25} & \\frac{1}{10} & \\frac{2}{3} \\\\ \\frac{4}{15} & - \\frac{1}{2} & - \\frac{2}{25}\\end{bmatrix}" :db/id #edb/ref 17592186539218} {:answer/id #uuid "9a7284bd-268b-583b-9ff5-543f0fc28209" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{25} & - \\frac{1}{10} & - \\frac{2}{3} \\\\ - \\frac{4}{15} & \\frac{1}{2} & \\frac{2}{25}\\end{bmatrix}" :db/id #edb/ref 17592186539249} {:answer/id #uuid "c431035e-f233-579b-9f79-65126d10fe75" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} & - \\frac{1}{4} & - \\frac{5}{3} \\\\ - \\frac{2}{3} & \\frac{5}{4} & \\frac{1}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539259} {:answer/id #uuid "e2a16a43-83d2-539d-a0d6-a491f95d8545" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{25} & - \\frac{1}{10} & - \\frac{2}{3} \\\\ - \\frac{2}{3} & \\frac{5}{4} & \\frac{1}{5}\\end{bmatrix}" :db/id #edb/ref 17592186539269} {:answer/id #uuid "e661b4b9-36d7-5b2f-a59e-9ce16b2d47ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} & - \\frac{1}{4} & - \\frac{5}{3} \\\\ - \\frac{4}{15} & \\frac{1}{2} & \\frac{2}{25}\\end{bmatrix}" :db/id #edb/ref 17592186539271}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{25} & - \\frac{1}{10} & - \\frac{2}{3} \\\\ - \\frac{4}{15} & \\frac{1}{2} & \\frac{2}{25}\\end{bmatrix}" :db/id #edb/ref 17592186539249} :answer-field/id #uuid "b94565ce-78d6-5820-b498-ac78762eaf9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539256}] :question/id #uuid "ff15d39e-de79-5162-80ac-4216d5508790" :question/problem "Calculate $\\frac{2}{5}W$, if \n$W=\\begin{bmatrix}\\frac{4}{5} & - \\frac{1}{4} & - \\frac{5}{3} \\\\ - \\frac{2}{3} & \\frac{5}{4} & \\frac{1}{5}\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $W$ by $\\frac{2}{5},$ as follows:\n\n$$\n\\begin{aligned}\\frac{2}{5}W & =\\frac{2}{5}\\begin{bmatrix}\\frac{4}{5} & - \\frac{1}{4} & - \\frac{5}{3} \\\\ - \\frac{2}{3} & \\frac{5}{4} & \\frac{1}{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{5}\\cdot \\frac{4}{5} & \\frac{2}{5}\\cdot (- \\frac{1}{4}) & \\frac{2}{5}\\cdot (- \\frac{5}{3}) \\\\ \\frac{2}{5}\\cdot (- \\frac{2}{3}) & \\frac{2}{5}\\cdot \\frac{5}{4} & \\frac{2}{5}\\cdot \\frac{1}{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{8}{25} & - \\frac{1}{10} & - \\frac{2}{3} \\\\ - \\frac{4}{15} & \\frac{1}{2} & \\frac{2}{25}\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Scalar"} {:db/id #edb/ref 17592186059741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059550 :question/id #uuid "69ac9cdd-b27b-5b90-be25-02252df54e9e" :question/math-academy-id "e-4381" :question/problem "If $k {A} =\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t1 & 3 & 4  \\\\\n        \t6 & 0 & -2\n    \t\\end{matrix}\n    \t\\right\\rbrack,$\nwhere ${A} =\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t2 & 6 & 8  \\\\\n        \t12 & 0 & -4\n    \t\\end{matrix}\n    \t\\right\\rbrack$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot \\begin{bmatrix}2 & 6 & 8 \\\\ 12 & 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2k & 6k & 8k \\\\ 12k & 0 & -4k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t2k & 6k & 8k  \\\\\n        \t12k & 0 & -4k\n    \t\\end{matrix}\n    \t\\right\\rbrack\n=\n\\left\\lbrack\n    \t\\begin{matrix}\n        \t1 & 3 & 4  \\\\\n        \t6 & 0 & -2\n    \t\\end{matrix}\n    \t\\right\\rbrack\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $2k$ and $1.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =1 \\\\ k & =\\frac{1}{2}.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} :knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/question-generator {:db/id #edb/ref 17592186530580 :question-generator/id #uuid "b3722823-efb6-5ebe-bf0d-534c30b694f8" :question-generator/script "generate/scratch/17592186059741.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceb712c3-34be-5d56-b1da-c9f3dc12f14a" :answer/type {:db/ident :answer.type/math} :answer/value "k = 3" :db/id #edb/ref 17592186056329} {:answer/id #uuid "f430dc96-0627-52c0-96f8-3dd0d1fdc011" :answer/type {:db/ident :answer.type/math} :answer/value "k = 2" :db/id #edb/ref 17592186056330} {:answer/id #uuid "025ff679-230d-51ee-b4fc-f25b59e718f3" :answer/type {:db/ident :answer.type/math} :answer/value "k = 5" :db/id #edb/ref 17592186056331} {:answer/id #uuid "0f7de378-142c-5f3e-bed2-3c5acc9ca509" :answer/type {:db/ident :answer.type/math} :answer/value "k = 0" :db/id #edb/ref 17592186056332} {:answer/id #uuid "2632bad7-b0a0-5089-b585-44e7f1909169" :answer/type {:db/ident :answer.type/math} :answer/value "k = 4" :db/id #edb/ref 17592186056333}] :answer-field/id #uuid "14689557-d421-5d15-9b0f-08b601e5a6d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056328}] :question/id #uuid "58d59178-99ad-55b9-a1fd-7b9d14131c83" :question/math-academy-id "q-11442" :question/problem "If $kG = \\begin{bmatrix}5 & 0 \\\\ 10 & 30\\end{bmatrix}$,\nwhere $G = \\begin{bmatrix}1 & 0 \\\\ 2 & 6\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k$."} {:db/id #edb/ref 17592186060453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6c7feb-e1e4-5887-9269-a70c549b3932" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186361110} {:answer/id #uuid "4da79416-6947-54f4-88ab-d36dbb592119" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186361174} {:answer/id #uuid "53376dd3-6051-57be-9178-00766c6ec74e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186361206} {:answer/id #uuid "69e380fe-b63f-5b7d-8e40-f4c2783aa85f" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186361312} {:answer/id #uuid "83d9f12d-1a74-5c6d-b0b8-9182fdd9e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186361423}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186361174} :answer-field/id #uuid "a5735c9d-1438-5c01-a0eb-1e4ffee8d379" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362137}] :question/id #uuid "00d4f637-689d-5f49-8309-b4f927af6909" :question/math-academy-id "q-981" :question/problem "If $kA=\\begin{bmatrix}-7 & -21 & 56\\end{bmatrix}$,\nwhere $A=\\begin{bmatrix}-1 & -3 & 8\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot \\begin{bmatrix}-1 & -3 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-k & -3k & 8k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\begin{bmatrix}-k & -3k & 8k\\end{bmatrix}=\\begin{bmatrix}-7 & -21 & 56\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the leftmost elements, $-k$ and $-7.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-k & =-7 \\\\ k & =7.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186235400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a27d10-05f6-5852-96f7-8b0934d40235" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234581}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234581} :answer-field/id #uuid "0a51b386-9333-5451-874c-d530eb586091" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186234983}] :question/id #uuid "3f9a3ecf-f1b7-5cb8-ae2d-5e780921a8ed" :question/math-academy-id "q-139431" :question/problem "Maria and John agreed to increase the bet. After increasing, Maria's payoff matrix became\n\n$$\n\\begin{bmatrix}0 & -6 & 6 \\\\ 6 & 0 & -6 \\\\ -6 & 6 & 0\\end{bmatrix}.\n$$\n\nThis new matrix is obtained from matrix $P$ using the scalar multiplication $kP$, where\n\n                            \n                                    \n                                        \n                                        $\\,k=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "To express $kP,$ we multiply each entry of $P$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kP & =k\\begin{bmatrix}0 & -2 & 2 \\\\ 2 & 0 & -2 \\\\ -2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2k & 2k \\\\ 2k & 0 & -2k \\\\ -2k & 2k & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the value given for $kP$ in the problem statement:\n\n$$\n\\begin{bmatrix}0 & -2k & 2k \\\\ 2k & 0 & -2k \\\\ -2k & 2k & 0\\end{bmatrix}=\\begin{bmatrix}0 & -6 & 6 \\\\ 6 & 0 & -6 \\\\ -6 & 6 & 0\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-right elements, $2k$ and $6.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =6 \\\\ k & =3.\\end{aligned}\n$$\n\n**Note:** We would get the same result by equating any two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186299853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfd27dc5-4894-5e37-b2e5-2578b1696b56" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298457}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298457} :answer-field/id #uuid "e4e3dc78-835d-58b6-b211-120e5ef09fdf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299409}] :question/id #uuid "c737dee9-8d9f-5c6a-907a-8f6ef5631464" :question/math-academy-id "q-320536" :question/problem "If $kB=\\begin{bmatrix}33 & 36 \\\\ -12 & -24\\end{bmatrix}$,\nwhere $B=\\begin{bmatrix}11 & 12 \\\\ -4 & -8\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kB,$ we multiply each entry of $B$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kB & =k\\begin{bmatrix}11 & 12 \\\\ 4 & -8\\end{bmatrix} \\\\  & =\\begin{bmatrix}11k & 12k \\\\ 4k & -8k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kB$ in the problem statement:\n\n$$\n\\begin{bmatrix}11k & 12k \\\\ -4k & -8k\\end{bmatrix}=\\begin{bmatrix}33 & 36 \\\\ -12 & -24\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the bottom-left elements, $-4k$ and $-12.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-4k & =-12 \\\\ k & =3.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186299855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826094f3-db02-59ba-a855-db50607dea6c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298115}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298115} :answer-field/id #uuid "fa1a2567-d705-58f3-ad50-ac8337bd9075" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299481}] :question/id #uuid "c212ad13-93dd-5e76-9471-11a5cb69eaba" :question/math-academy-id "q-320551" :question/problem "If $kW=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 20 & -15 \\\\ 10 & -10 & 25\\end{bmatrix}$,\nwhere $W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & -3 \\\\ 2 & -2 & 5\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kW,$ we multiply each entry of $W$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kW & =k\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & -3 \\\\ 2 & -2 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}k & 0 & 0 \\\\ 0 & 4k & -3k \\\\ 2k & -2k & 5k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kW$ in the problem statement:\n\n$$\n\\begin{bmatrix}k & 0 & 0 \\\\ 0 & 4k & -3k \\\\ 2k & -2k & 5k\\end{bmatrix}=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 20 & -15 \\\\ 10 & -10 & 25\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the  leftmost elements of the third row, $2k$ and $10.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =10 \\\\ k & =5.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186299860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "796aff8c-2d9c-5570-96ae-5278b9bf5a36" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186298082}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186298082} :answer-field/id #uuid "83ce9b97-3a4a-54e6-b6b8-b4ed177d7ed4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299082}] :question/id #uuid "ef847762-e432-58b6-805a-1384db601a50" :question/math-academy-id "q-320563" :question/problem "If $kB=\\begin{bmatrix}8 & -4 & 2\\end{bmatrix}$,\nwhere $B=\\begin{bmatrix}24 & -12 & 6\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kB,$ we multiply each entry of $B$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kB & =k\\begin{bmatrix}24 & -12 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}24k & -12k & 6k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kB$ in the problem statement:\n\n$$\n\\begin{bmatrix}24k & -12k & 6k\\end{bmatrix}=\\begin{bmatrix}8 & -4 & 2\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the rightmost elements, $6k$ and $2.$ Equating these elements, we get\n\n$$\n\\begin{aligned}6k & =2 \\\\ k & =\\frac{1}{3}.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186335993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb162c3-0886-56a8-8bdd-ea309941ad8c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186333101} {:answer/id #uuid "8f762ea6-9c19-57f6-b072-412e84452fb2" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186334268} {:answer/id #uuid "9d0d7a0c-6212-5441-ab1d-b3033727fa78" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186334372} {:answer/id #uuid "c39b8c34-08f9-5cf0-b9ab-91abc406aa2e" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186334686} {:answer/id #uuid "e8a450c5-8b1d-5254-b15a-90a7c2647a52" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186335019}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186334372} :answer-field/id #uuid "0dd5fe3a-0ae8-537c-ab9c-6c666f2d1465" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335264}] :question/id #uuid "420a50cc-93bf-533b-b918-320c5c0ae443" :question/math-academy-id "q-69670" :question/problem "If $kS=\\begin{bmatrix}63 & -28 \\\\ 0 & -56\\end{bmatrix}$,\nwhere $S=\\begin{bmatrix}-9 & 4 \\\\ 0 & 8\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kS,$ we multiply each entry of $S$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kS & =k\\begin{bmatrix}-9 & 4 \\\\ 0 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9k & 4k \\\\ 0 & 8k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kS$ in the problem statement:\n\n$$\n\\begin{bmatrix}-9k & 4k \\\\ 0 & 8k\\end{bmatrix}=\\begin{bmatrix}63 & -28 \\\\ 0 & -56\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $-9k$ and $63.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-9k & =63 \\\\ k & =-7.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} {:db/id #edb/ref 17592186530579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb42f95-4419-5a51-91ab-4d7c28e0f3b0" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186530573} {:answer/id #uuid "7437b57a-2a12-5152-9852-a33567178cc2" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186530575} {:answer/id #uuid "8dcd8fd2-48c4-5255-ac9e-25c877fc43cd" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186530576} {:answer/id #uuid "a7c30caf-49b4-5ea7-aa58-b33e1e633129" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186530577} {:answer/id #uuid "b571ca6d-4ec5-50fd-8827-bb0c6a423d56" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186530578}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186530577} :answer-field/id #uuid "71c0ea85-8283-576a-8299-6ae94d64a63b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530574}] :question/id #uuid "f16bbe6e-f1a6-54a1-bc2e-dc02da0cf210" :question/problem "If $kA=\\begin{bmatrix}-12 & -54 & 60\\end{bmatrix}$,\nwhere $A=\\begin{bmatrix}-2 & -9 & 10\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot \\begin{bmatrix}-2 & -9 & 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}- 2 k & - 9 k & 10 k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\begin{bmatrix}- 2 k & - 9 k & 10 k\\end{bmatrix}=\\begin{bmatrix}-12 & -54 & 60\\end{bmatrix}\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the elements in row $1$ and column $2$, $- 9 k$ and $-54.$ Equating these elements, we get\n\n$$\n\\begin{aligned}- 9 k & =-54 \\\\ k & =6.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] :knowledge-point/title "Calculating the Value of a Scalar"} {:db/id #edb/ref 17592186059742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059551 :question/id #uuid "1828e8ba-504d-5b20-b5fa-82005c7588f6" :question/math-academy-id "e-4382" :question/problem "Calculate $2 {A} + \\dfrac{1}{2} {B}$, where\n$\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}$ and ${B}=\n    \\left\\lbrack\n    \\begin{matrix}\n        0 & 2  \\\\\n        4 & 2\n    \\end{matrix}\n    \\right\\rbrack\n.$" :question/worked-solution "We multiply each entry of $A$ by $2$ and each entry of $B$ by $\\dfrac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}2A+\\frac{1}{2}B & =2\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}0 & 2 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 1 & 2\\cdot 5 \\\\ 2\\cdot 1 & 2\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot 2 \\\\ \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 10 \\\\ 2 & 4\\end{bmatrix}+\\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+0 & 10+1 \\\\ 2+2 & 4+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 11 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/question-generator {:db/id #edb/ref 17592186547275 :question-generator/id #uuid "d9ebcc5d-f3e5-5466-b48c-dbe24aa281e8" :question-generator/script "generate/scratch/17592186059742.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d11ade1a-b8aa-5a3b-a93b-0c972ee05e30" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 & 8 \\\\ 8 & -8\\end{bmatrix}" :db/id #edb/ref 17592186056341} {:answer/id #uuid "d54a67c4-5025-5e41-8e4c-da1a85a87afd" :answer/typ