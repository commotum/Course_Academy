wer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 12 \\\\ 31 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547200} {:answer/id #uuid "18c48868-d901-5db6-b2c8-029b6ca8f044" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186547203} {:answer/id #uuid "1e9fbb7d-fc70-535d-b733-167a89f4b774" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24 & 12 \\\\ 28 & 10\\end{bmatrix}" :db/id #edb/ref 17592186547206} {:answer/id #uuid "92fd41df-5ad6-5dae-90a4-14de6a3baf88" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186547239} {:answer/id #uuid "9f420166-ec0b-5fd4-9d9e-43415d9d2819" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 & 12 \\\\ 29 & 11\\end{bmatrix}" :db/id #edb/ref 17592186547241}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 & 12 \\\\ 29 & 11\\end{bmatrix}" :db/id #edb/ref 17592186547241} :answer-field/id #uuid "08f6b01b-03ed-5750-b69a-ae4176a2cc2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547197}] :question/id #uuid "1e90755d-4fdb-5b79-966e-36f3d7430442" :question/problem "Calculate $6L+\\frac{1}{2}A$, where\n$L=\\begin{bmatrix}3 & 2 \\\\ 5 & 2\\end{bmatrix}$\nand\n$A=\\begin{bmatrix}6 & 0 \\\\ -2 & -2\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $L$ by $6$ and each entry of $A$ by $\\frac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}6L+\\frac{1}{2}A & =6\\begin{bmatrix}3 & 2 \\\\ 5 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}6 & 0 \\\\ -2 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\cdot 3 & 6\\cdot 2 \\\\ 6\\cdot 5 & 6\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 6 & \\frac{1}{2}\\cdot 0 \\\\ \\frac{1}{2}\\cdot (-2) & \\frac{1}{2}\\