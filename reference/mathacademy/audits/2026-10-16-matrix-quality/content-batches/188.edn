atrix}-4 & 12 \\\\ -12 & 0\\end{bmatrix}" :db/id #edb/ref 17592186547217} {:answer/id #uuid "8e8f91d2-fde3-5d2a-83cf-7da3d5c22812" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547236} {:answer/id #uuid "b37fb170-4635-5979-8641-e083ac238d5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547249} {:answer/id #uuid "ecaaabc2-e475-523a-ac9d-e35f29c3309f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & -18 \\\\ 18 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547268}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547249} :answer-field/id #uuid "c2b0de36-d947-517b-ac5f-9d13a5c03976" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547253}] :question/id #uuid "a1f995aa-a3a0-5af5-ac63-b17fbecfcac6" :question/problem "Calculate $-2Q+4G$, where\n$Q=\\begin{bmatrix}-2 & 3 \\\\ -3 & 2\\end{bmatrix}$\nand\n$G=\\begin{bmatrix}-1 & 3 \\\\ -3 & 0\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $Q$ by $-2$ and each entry of $G$ by $4,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}-2Q+4G & =(-2)\\begin{bmatrix}-2 & 3 \\\\ -3 & 2\\end{bmatrix}+4\\begin{bmatrix}-1 & 3 \\\\ -3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-2)\\cdot (-2) & (-2)\\cdot 3 \\\\ (-2)\\cdot (-3) & (-2)\\cdot 2\\end{bmatrix}+\\begin{bmatrix}4\\cdot (-1) & 4\\cdot 3 \\\\ 4\\cdot (-3) & 4\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -6 \\\\ 6 & -4\\end{bmatrix}+\\begin{bmatrix}-4 & 12 \\\\ -12 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+(-4) & -6+12 \\\\ 6+(-12) & -4+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299a064b-3bc4-547b-a7d0-c24eca4b4deb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 8 \\\\ 8 & 10\\end{bmatrix}" :db/id #edb/ref 17592186547212} {:answer/id #uuid "3ff42622-2f7e-56ba-8321-981bcc0a144f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186547218} {:answer/id #uuid "9a864b72-cebb-5676-996e-e69c04ff80a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 14 \\\\ 14 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547240} {:answer/id #uuid "b9a5dd37-1aa8-541a-92dc-3f6ead400d51" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}" :db/id #edb/ref 17592186547251} {:answer/id #uuid "f92aa0cf-ac0d-5ca5-8b3e-26f7bcc67c3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & 8 \\\\ 8 & 6\\end{bmatrix}" :db/id #edb/ref 17592186547272}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}" :db/id #edb/ref 17592186547251} :answer-field/id #uuid "cb89f7b2-852b-5f5c-9519-ac2c1cad12e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547256}] :question/id #uuid "b0adea88-04cc-5a53-88af-e806dd44e698" :question/problem "Calculate $3L+2M$, where\n$L=\\begin{bmatrix}4 & 4 \\\\ 4 & 4\\end{bmatrix}$\nand\n$M=\\begin{bmatrix}3 & 2 \\\\ 2 & 1\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $L$ by $3$ and each entry of $M$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}3L+2M & =3\\begin{bmatrix}4 & 4 \\\\ 4 & 4\\end{bmatrix}+2\\begin{bmatrix}3 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 4 & 3\\cdot 4 \\\\ 3\\cdot 4 & 3\\cdot 4\\end{bmatrix}+\\begin{bmatrix}2\\cdot 3 & 2\\cdot 2 \\\\ 2\\cdot 2 & 2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 12 \\\\ 12 & 12\\end{bmatrix}+\\begin{bmatrix}6 & 4 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}12+6 & 12+4 \\\\ 12+4 & 12+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f58c3564-dfde-564b-9a65-0870c4a0305b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186547270}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186547270} :answer-field/id #uuid "100cc00a-fae2-5238-bed5-cb9e46fec419" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547199} {:answer-field/choices [{:answer/id #uuid "b8efa023-82e2-5d1f-a36c-fdbdaf7e5bad" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186547250}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186547250} :answer-field/id #uuid "137004b2-1c1d-55c4-a9eb-f5faa779850a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547201} {:answer-field/choices [{:answer/id #uuid "fa01f361-fbca-5b4d-8c1d-05b48448c57d" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186547274}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186547274} :answer-field/id #uuid "2b68b469-2cdb-55e7-ab51-a9324a7ac5d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547214} {:answer-field/choices [{:answer/id #uuid "856dcb98-d967-5b1d-8c6b-c3d8bd1c9255" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186547234}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186547234} :answer-field/id #uuid "bae56912-3dcd-5133-95e4-a1ca766e27ae" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547252}] :question/id #uuid "c90cd801-8b18-54b6-8ab2-396380c16785" :question/problem "Calculate $4P-\\frac{1}{2}H$, where\n$P=\\begin{bmatrix}4 & -3 & 1 & 0\\end{bmatrix}$\nand\n$H=\\begin{bmatrix}4 & 4 & 2 & 0\\end{bmatrix}.$\n\n| $4P-\\frac{1}{2}H=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} |  |\n| --- | --- | --- | --- | --- | --- | --- |" :question/worked-solution "We multiply each entry of $P$ by $4$ and each entry of $H$ by $\\frac{1}{2},$ and then subtract the resulting matrices, as follows:\n\n$$\n\\begin{aligned}4P-\\frac{1}{2}H & =4\\begin{bmatrix}4 & -3 & 1 & 0\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}4 & 4 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4\\cdot 4 & 4\\cdot (-3) & 4\\cdot 1 & 4\\cdot 0\\end{bmatrix}-\\begin{bmatrix}\\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 2 & \\frac{1}{2}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & -12 & 4 & 0\\end{bmatrix}-\\begin{bmatrix}2 & 2 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}16-2 & -12-2 & 4-1 & 0-0\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & -14 & 3 & 0\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :topic/math-academy-id 146 :topic/title "Scalar Multiplication of Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186148276} :activity/id #uuid "9b33318d-1bab-5993-91f6-d6c8c1d3d0a0" :activity/steps [{:db/id #edb/ref 17592186148276 :step/content {:db/id #edb/ref 17592186148743 :tutorial/content "Suppose we are given the planes ${\\Pi_{{1}}}: 2x -y+z=0$ and ${\\Pi_{{2}}}: -x + y-z=1.$ First, notice that:\n\n- A normal vector to the plane ${\\Pi_{{1}}}$  is $\\mathbf{n}_1 = \\langle 2,\\:-1,\\: 1 \\rangle.$\n\n- A normal vector to the plane ${\\Pi_{{2}}}$  is $\\mathbf{n}_2 = \\langle -1,\\: 1,\\: -1 \\rangle.$\n\nIf two distinct planes intersect each other, their intersection will always be a straight line. A direction vector $\\mathbf{v}$ for that line can be found by computing the cross product of the normal vectors of the two planes. \n\n![](images/0c/0cf233086eccae47e640d3599908572e2c3a9996dd84d861e4d659c03108105c.png)\n\nIn our case, we have\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,\\,-1,\\,1⟩\\times ⟨-1,\\,1,\\,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 1 \\\\ -1 & 1 & -1\\end{aligned}\\right| \\\\  & =j+k \\\\  & =⟨0,1,1⟩.\\end{aligned}\n$$" :tutorial/id #uuid "1e276ddb-1c14-51fd-8261-8c02eb3294f0" :tutorial/math-academy-id 3803 :tutorial/title "Introduction"} :step/id #uuid "1ae4dc56-971c-585e-ac6e-a1d1927975cc" :step/next {:db/id #edb/ref 17592186148278}} {:db/id #edb/ref 17592186148277 :step/content {:db/id #edb/ref 17592186147425 :knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a"} :step/id #uuid "27bcbb90-63f9-5635-829b-a801f3809b3e" :step/next {:db/id #edb/ref 17592186148280}} {:db/id #edb/ref 17592186148278 :step/content {:db/id #edb/ref 17592186147426 :knowledge-point/id #uuid "4b5f51ee-5bde-5e39-8d2a-e5e482be4916"} :step/id #uuid "0ba22f44-3353-5e3e-a64c-1e09fd59d6d9" :step/next {:db/id #edb/ref 17592186148277}} {:db/id #edb/ref 17592186148279 :step/content {:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4"} :step/id #uuid "e4a1265b-c056-54ef-b3c5-eaaf48e49ec3" :step/next {:db/id #edb/ref 17592186148281}} {:db/id #edb/ref 17592186148280 :step/content {:db/id #edb/ref 17592186148744 :tutorial/content "In general, given two planes \n\n$$\n{\\Pi_{{1}}}\\mathbin{:} \\quad a_{1}x+b_{1}y + c_{1}z+ d_1=0 \\qquad  \\text{and} \\qquad   {\\Pi_{{2}}}\\mathbin{:} \\quad a_{2}x+b_{2}y + c_{2}z+ d_2=0,\n$$\n\n we have the following cases, regarding the positions of their normal vectors  $\\mathbf{n}_1$ and $\\mathbf{n}_2 \\mathbin{:}$ \n\n- *Case 1*:  If $\\mathbf{n}_1\\nparallel \\mathbf{n}_2$ then ${\\Pi_{{1}}}$   and ${\\Pi_{{2}}}$ intersect on a straight line.\n\n- *Case 2*:  If $\\mathbf{n}_1\\parallel \\mathbf{n}_2$ but the corresponding equations of the planes are not scalar multiples of each other, then the planes are distinct and are parallel to each other.\n\n- *Case 3*:  If the corresponding coefficients of ${\\Pi_{{1}}}$ and ${\\Pi_{{2}}}$ are all proportional, then the planes are coincident." :tutorial/id #uuid "50ffbdb5-c9d0-5815-9b29-b505cde7f0fa" :tutorial/math-academy-id 3804 :tutorial/title "Intersection of Two Planes in 3D"} :step/id #uuid "cba5c95d-7e83-5872-ae95-b6832ff486a2" :step/next {:db/id #edb/ref 17592186148279}} {:db/id #edb/ref 17592186148281 :step/content {:db/id #edb/ref 17592186148745 :tutorial/content "Consider a line that is given by its vector equation\n![](images/ca/ca43fd13bd65c544d66a4de2801871c2a79087fd960db44696ce6068d30c8377.svg)\n\nSince $y=2$ at every point on the line, the corresponding Cartesian equations of this line are\n\n$$\n\\dfrac{x-1}2 =z+1, \\quad y=2.\n$$\n\nWe may therefore interpret this line as the intersection of the planes $\\dfrac{x-1}2 =z+1$ and $y=2$.\n\nLet's look at one more example. Given the line \n\n![](images/1a/1a97b5bcff75bc7306d14a8af3fb1f169a2e7bf865be2e7a9c6d2741eecc63a6.svg)\n\nwe can write its Cartesian equation as\n\n$$\n\\dfrac{x-2}{-5}=\\dfrac{y-1}2 = \\dfrac{z-1}3\n$$\n\nwhich can be further written as the system of two equations:\n\n![](images/1f/1f4cce850809f3fda876dd96e1cf9c65fd873df97bbba44e291b611896c86ca4.svg)\n\nSo, again, our line can be represented as the intersection of the planes $2x+5y-9=0$ and $3y-2z-1=0$." :tutorial/id #uuid "a7303bab-ef2c-5a9b-9caa-dc6fcc7929d2" :tutorial/math-academy-id 3817 :tutorial/title "The Cartesian Equation of a Line as the Intersection of Two Planes"} :step/id #uuid "8aec20bb-3034-54e2-b58d-43a8fc04ec0d"}] :activity/title "The Intersection of Two Planes" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186147718} {:activity/first-step {:db/id #edb/ref 17592186421906} :activity/id #uuid "39b191e6-3a28-55d0-8f36-ad23b66bbcd4" :activity/steps [{:db/id #edb/ref 17592186421903 :step/content {:db/id #edb/ref 17592186413744 :question/id #uuid "abe7bafd-4069-5c23-9e34-e0cbd57e3732"} :step/id #uuid "0311a340-7168-5cea-821e-a5c70f05f78d" :step/next {:db/id #edb/ref 17592186421907}} {:db/id #edb/ref 17592186421904 :step/content {:db/id #edb/ref 17592186262998 :question/id #uuid "ad00dc96-c374-5320-be1d-ca73d7e96f79"} :step/id #uuid "4b62f78b-d432-5341-a2aa-4388a4c716e4"} {:db/id #edb/ref 17592186421905 :step/content {:db/id #edb/ref 17592186338949 :question/id #uuid "894f2787-9676-52de-a718-3b82f8fd7a1d"} :step/id #uuid "8993a320-0fa1-5bea-8343-47ddcfb4405b" :step/next {:db/id #edb/ref 17592186421903}} {:db/id #edb/ref 17592186421906 :step/content {:db/id #edb/ref 17592186421901 :question/id #uuid "3582cc5d-9e46-5e0a-8d0c-b0e74f8f5924"} :step/id #uuid "b2250ab1-dcbf-5807-a3a8-ee6a40866bf6" :step/next {:db/id #edb/ref 17592186421905}} {:db/id #edb/ref 17592186421907 :step/content {:db/id #edb/ref 17592186421902 :question/id #uuid "caefbcdd-6450-5b4b-b965-772f5b87b02a"} :step/id #uuid "c6d8b30b-6627-55c2-a300-1bd06da939e9" :step/next {:db/id #edb/ref 17592186421904}}] :activity/title "The Intersection of Two Planes" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186421888}] :db/id #edb/ref 17592186050991 :topic/knowledge-points [{:db/id #edb/ref 17592186147425 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147341 :question/id #uuid "fb408a64-6d03-594d-92bd-b95c2a5c95a8" :question/math-academy-id "e-5917" :question/problem "The intersection of the planes $x+2y+4z=0$ and $2x+4y+2z+18=0$ is given by the line \n\n$$\n\\mathbf r(t) = \\langle 0, a_2, a_3\\rangle + t \\mathbf b, \\quad t\\in(-\\infty,\\infty).\n$$\n\nCalculate $a_2+a_3,$ and find a possible direction vector $\\mathbf b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this into the first equation gives   \n\n$$\n0+2y+4z=0\\qquad\\Longrightarrow\\qquad y=-2z,\n$$\n\nand substituting $x=0$ and $y=-2z$ into the second equation gives \n\n$$\n\\begin{aligned}2x+4y+2z+18 & =0 \\\\ 2(0)+4(-2z)+2z+18 & =0 \\\\ -6z & =-18 \\\\ z & =3.\\end{aligned}\n$$\n\nTherefore, $y=-2z=-6$ and $\\mathbf a = \\langle 0,-6,3\\rangle$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+4z=0,$ a normal vector to the plane is $\\mathbf{n}_1 = \\langle 1,2,4 \\rangle.$\n\n- For the plane $2x+4y+2z+18=0,$ a normal vector to the plane is $\\mathbf{n}_2 = \\langle 2,4,2 \\rangle.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,4⟩\\times ⟨2,4,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 2\\end{aligned}\\right| \\\\  & =-12i+6j \\\\  & =⟨-12,6,0⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to $\\mathbf{n}_1 \\times \\mathbf{n}_2$ as a direction vector of the line. So, let \n \n\n$$\n\\mathbf{b} =\\dfrac{1}{6}(\\mathbf{n}_1 \\times \\mathbf{n}_2) = \\langle -2, 1, 0 \\rangle.\n$$\n\n \n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,-6,3⟩+t⟨-2,1,0⟩\\end{aligned}\n$$\n\nFinally then, $a_2 +a_3 = -6+3 = -3,$ and $\\mathbf b = \\langle  -2,1,0\\rangle.$"} :knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a" :knowledge-point/questions [{:db/id #edb/ref 17592186148199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be540dfd-762c-5070-b576-91d1f65ba618" :answer/type {:db/ident :answer.type/math} :answer/value "a_{1} + a_{3} =-4, b = ⟨1, 1, 1⟩" :db/id #edb/ref 17592186146949} {:answer/id #uuid "c0ead6d4-a3a5-5297-9e3f-2b5362a5e403" :answer/type {:db/ident :answer.type/math} :answer/value "a_{1} + a_{3} =-2, b = ⟨1, 1, 1⟩" :db/id #edb/ref 17592186146950} {:answer/id #uuid "c3a8e0db-17c2-573e-bfef-7bb3b1a3d751" :answer/type {:db/ident :answer.type/math} :answer/value "a_{1} + a_{3} =-6, b = ⟨1, 2,-1⟩" :db/id #edb/ref 17592186146951} {:answer/id #uuid "f00da056-bc15-5cdb-ac8d-f83e6c47f034" :answer/type {:db/ident :answer.type/math} :answer/value "a_{1} + a_{3} =-3, b = ⟨1, 1, 1⟩" :db/id #edb/ref 17592186146952} {:answer/id #uuid "54a06c36-f48c-5b5c-806d-2041a4d72d3f" :answer/type {:db/ident :answer.type/math} :answer/value "a_{1} + a_{3} =-2, b = ⟨1, 2,-1⟩" :db/id #edb/ref 17592186146953}] :answer-field/id #uuid "abdb5deb-aaca-55df-a9a2-8df310a5970d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146948}] :question/id #uuid "7c614b7a-0b81-5b6c-9de7-0ecb17578f77" :question/math-academy-id "q-71186" :question/problem "The intersection of the planes $x - y - 2 = 0$ and $y - z - 4 = 0$ is given by the line\n\n$r(t) = ⟨a_{1}, 0, a_{3}⟩ + tb, t ∈ (- ∞, ∞)$.\n\nCalculate $a_{1} + a_{3}$, and find a possible direction vector $b$."} {:db/id #edb/ref 17592186148200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1030568a-af15-5382-9a1b-bf9c88339fda" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨1,0,1⟩" :db/id #edb/ref 17592186336182} {:answer/id #uuid "2eaa47b7-38f8-58da-9f30-aeb4369d4b27" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-5,\\,b=⟨1,0,1⟩" :db/id #edb/ref 17592186336482} {:answer/id #uuid "476005ce-705e-5713-a12d-f65aeb450075" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,1,1⟩" :db/id #edb/ref 17592186336695} {:answer/id #uuid "b6c2a9b8-73bf-51bb-8fa9-2453addb7103" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-1,\\,b=⟨1,0,1⟩" :db/id #edb/ref 17592186337654} {:answer/id #uuid "dc57109d-bd57-58a8-96a0-ce37b2242a91" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-1,\\,b=⟨-1,1,1⟩" :db/id #edb/ref 17592186337949}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,1,1⟩" :db/id #edb/ref 17592186336695} :answer-field/id #uuid "397e1fa9-a437-5df7-afdf-3eacce33139e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338380}] :question/id #uuid "c01a5d8f-f2ce-5a5d-bfd0-e648dd7fcc1b" :question/math-academy-id "q-71187" :question/problem "The intersection of the planes $-x+y-2z=0$ and $-x-2y+z-3=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+y-2(0)=0\\,⟹\\,x=y,\n$$\n\nand substituting $z=0$ and $x=y$ into the second equation gives\n\n$$\n\\begin{aligned}-x-2y+z-3 & =0 \\\\ -y-2y+0-3 & =0 \\\\ -3y & =3 \\\\ y & =-1.\\end{aligned}\n$$\n\nTherefore, $x=y=-1$ and $a=⟨-1,-1,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+y-2z=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,1,-2⟩.$\n\n- For the plane $-x-2y+z-3=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,-2,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨-1,1,-2⟩\\times ⟨-1,-2,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & -2 \\\\ -1 & -2 & 1\\end{aligned}\\right| \\\\  & =-3i+3j+3k \\\\  & =⟨-3,3,3⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{3}({n}_{1}\\times {n}_{2})=⟨-1,1,1⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-1,0⟩+t⟨-1,1,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1-1=-2,$ and $b=⟨-1,1,1⟩.$"} {:db/id #edb/ref 17592186262965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f611ea-31f2-501c-9cc3-23608014fedc" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=6,\\,b=⟨-2,2,1⟩" :db/id #edb/ref 17592186260155} {:answer/id #uuid "3f1707da-9517-52e9-8e00-9f93c9d0abfe" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=3,\\,b=⟨-1,2,-2⟩" :db/id #edb/ref 17592186260430} {:answer/id #uuid "42dfcbee-13a1-540b-a8a6-6286d537f040" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-9,\\,b=⟨2,-2,2⟩" :db/id #edb/ref 17592186260457} {:answer/id #uuid "50a54438-46b1-55d4-84cb-cc6a7d594174" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-3,\\,b=⟨-1,-2,2⟩" :db/id #edb/ref 17592186260561} {:answer/id #uuid "dfbbf177-6cac-55a4-a754-8a6af640aab4" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-6,\\,b=⟨-2,1,2⟩" :db/id #edb/ref 17592186261851}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-3,\\,b=⟨-1,-2,2⟩" :db/id #edb/ref 17592186260561} :answer-field/id #uuid "77e7bd5a-219c-5fee-9736-344b1e3fc112" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262322}] :question/id #uuid "4b706d3e-4552-5c79-b5e0-57362ec81f02" :question/math-academy-id "q-129175" :question/problem "The intersection of the planes $2x-y-6=0$ and $y+z+6=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this to the first equation gives\n\n$$\n2x-0-6=0\\,⟹\\,x=3,\n$$\n\nand substituting $y=0$ into the second equation gives\n\n$$\n0+z+6=0\\,⟹\\,z=-6.\n$$\n\nTherefore, $a=⟨3,0,-6⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-y-6=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,0⟩.$\n\n- For the plane $y+z+6=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,-1,0⟩\\times ⟨0,1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 0 \\\\ 0 & 1 & 1\\end{aligned}\\right| \\\\  & =-i-2j+2k \\\\  & =⟨-1,-2,2⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨3,0,-6⟩+t⟨-1,-2,2⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=3-6=-3,$ and $b=⟨-1,-2,2⟩.$"} {:db/id #edb/ref 17592186262979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268fa0c4-3c71-52cc-a20f-50c8756daca0" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨6,3,6⟩" :db/id #edb/ref 17592186260214} {:answer/id #uuid "39232a78-19bb-523b-98f2-5ce30aa03c98" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=0,\\,b=⟨6,9,6⟩" :db/id #edb/ref 17592186260383} {:answer/id #uuid "a83d313c-82d4-5e27-af29-9ee9f021b21e" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=6,\\,b=⟨6,6,3⟩" :db/id #edb/ref 17592186261341} {:answer/id #uuid "aa753b89-fc4f-5101-af57-4dd4d182086c" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=0,\\,b=⟨3,9,3⟩" :db/id #edb/ref 17592186261368} {:answer/id #uuid "f771dd02-6995-5c42-bca9-528ebb2d4749" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=-3,\\,b=⟨9,6,6⟩" :db/id #edb/ref 17592186262037}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=0,\\,b=⟨6,9,6⟩" :db/id #edb/ref 17592186260383} :answer-field/id #uuid "6f97533b-595b-5dd2-9dc0-71ed20eb5ea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262306}] :question/id #uuid "6f756490-7a61-582b-bcb6-67677d42e56a" :question/math-academy-id "q-129202" :question/problem "The intersection of the planes $3x-2y-18=0$ and $2y-3z+18=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}-{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this to the first equation gives \n\n$$\n3x-0-18=0\\,⟹\\,x=6,\n$$\n\nand substituting $y=0$ into the second equation gives\n\n$$\n0-3z+18=0\\,⟹\\,z=6.\n$$\n\nTherefore, $a=⟨6,0,6⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $3x-2y-18=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-2,0⟩.$\n\n- For the plane $2y-3z+18=0,$ a normal vector to the plane is ${n}_{2}=⟨0,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨3,-2,0⟩\\times ⟨0,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -2 & 0 \\\\ 0 & 2 & -3\\end{aligned}\\right| \\\\  & =6i+9j+6k \\\\  & =⟨6,9,6⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨6,0,6⟩+t⟨6,9,6⟩\\end{aligned}\n$$\n\n \n\nFinally then, ${a}_{1}-{a}_{3}=6-6=0,$ and $b=⟨6,9,6⟩.$"} {:db/id #edb/ref 17592186262986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a3b231-41e0-5f2c-92e0-61f544a87c53" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨4,6,6⟩" :db/id #edb/ref 17592186260579} {:answer/id #uuid "60a9b0a8-9052-5c04-a76e-fcde86379d60" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=3,\\,b=⟨6,4,-6⟩" :db/id #edb/ref 17592186260708} {:answer/id #uuid "a99cbf33-52e8-50f0-b552-c66693909ca6" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-3,\\,b=⟨6,6,-4⟩" :db/id #edb/ref 17592186261358} {:answer/id #uuid "d499bbf8-ac81-52c6-941c-a51648e6dd97" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=3,\\,b=⟨6,6,4⟩" :db/id #edb/ref 17592186261748} {:answer/id #uuid "d8368f3f-3e45-5864-b90b-a510c6c5e2ec" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=12,\\,b=⟨6,4,-6⟩" :db/id #edb/ref 17592186261780}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=3,\\,b=⟨6,6,4⟩" :db/id #edb/ref 17592186261748} :answer-field/id #uuid "1e773425-891f-5651-93ce-1ac3155648dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262171}] :question/id #uuid "8a078a58-ff42-59ed-b6b4-1faac683836f" :question/math-academy-id "q-129215" :question/problem "The intersection of the planes $2x-3z=0$ and $2y-3z-6=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n2x-0=0\\,⟹\\,x=0,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\n2y-0-6=0\\,⟹\\,y=3.\n$$\n\nTherefore, $a=⟨0,3,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-3z=0,$ a normal vector to the plane is ${n}_{1}=⟨2,0,-3⟩.$\n\n- For the plane $2y-3z-6=0,$ a normal vector to the plane is ${n}_{2}=⟨0,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,0,-3⟩\\times ⟨0,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 0 & -3 \\\\ 0 & 2 & -3\\end{aligned}\\right| \\\\  & =6i+6j+4k \\\\  & =⟨6,6,4⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,3,0⟩+t⟨6,6,4⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=0+3=3,$ and $b=⟨6,6,4⟩.$"} {:db/id #edb/ref 17592186262995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b551f9-67b3-526e-ac61-401370fa20cc" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-4,\\,b=⟨-5,-1,7⟩" :db/id #edb/ref 17592186259921} {:answer/id #uuid "07e7c095-5cd7-5e7f-88a4-62d24ccca90d" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=7,\\,b=⟨-8,-5,1⟩" :db/id #edb/ref 17592186259948} {:answer/id #uuid "3ff09bea-49ff-5263-9791-28681318ee19" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-8,\\,b=⟨-7,5,-1⟩" :db/id #edb/ref 17592186260436} {:answer/id #uuid "9c5fb5ca-3244-5bde-9600-fcffb39c40c4" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=4,\\,b=⟨-1,-7,5⟩" :db/id #edb/ref 17592186261229} {:answer/id #uuid "cdacb13a-6960-5c52-ade6-a030f863a6d9" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=8,\\,b=⟨-7,-1,-5⟩" :db/id #edb/ref 17592186261688}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=8,\\,b=⟨-7,-1,-5⟩" :db/id #edb/ref 17592186261688} :answer-field/id #uuid "01374e00-e2e5-5f8e-8332-c708a773c51f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262126}] :question/id #uuid "e13e8792-4c4e-5029-9bf5-e791e6fc17d7" :question/math-academy-id "q-129229" :question/problem "The intersection of the planes $x+3y-2z-8=0$ and $2x+y-3z-16=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the second equation gives \n\n$$\nx+0-2z-8=0\\,⟹\\,x=2z+8,\n$$\n\nand substituting $y=0$ and $x=2z+8$ into the first equation gives \n\n$$\n\\begin{aligned}2(2z+8)+0-3z-16 & =0 \\\\ 4z+16-3z-16 & =0 \\\\ z & =0.\\end{aligned}\n$$\n\nTherefore, $x=2(0)+8=8$ and $a=⟨8,0,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+3y-2z-8=0,$ a normal vector to the plane is ${n}_{1}=⟨1,3,-2⟩.$\n\n- For the plane $2x+y-3z-16=0,$ a normal vector to the plane is ${n}_{2}=⟨2,1,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,3,-2⟩\\times ⟨2,1,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 3 & -2 \\\\ 2 & 1 & -3\\end{aligned}\\right| \\\\  & =-7i-j-5k \\\\  & =⟨-7,-1,-5⟩\\end{aligned}\n$$\n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨8,0,0⟩+t⟨-7,-1,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=8+0=8,$ and $b=⟨-7,-1,-5⟩.$"} {:db/id #edb/ref 17592186262998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbb0f75-5837-5fef-9156-1bb0626a6799" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-3,\\,b=⟨-1,1,2⟩" :db/id #edb/ref 17592186260264} {:answer/id #uuid "358aeb92-2af7-5b63-a3fc-98a16739711a" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨-2,1,1⟩" :db/id #edb/ref 17592186260355} {:answer/id #uuid "4ae1bb4f-6418-5cbe-8748-f187b44dbec8" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=3,\\,b=⟨-1,2,1⟩" :db/id #edb/ref 17592186260517} {:answer/id #uuid "83b18a92-b695-5c83-b721-b2dee329f376" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-2,1,-1⟩" :db/id #edb/ref 17592186261019} {:answer/id #uuid "db99d772-027a-5c17-b647-51f20577ed39" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=5,\\,b=⟨1,2,1⟩" :db/id #edb/ref 17592186261817}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=3,\\,b=⟨-1,2,1⟩" :db/id #edb/ref 17592186260517} :answer-field/id #uuid "3e5261fb-a30e-5c21-b272-d448a6432184" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262235}] :question/id #uuid "ad00dc96-c374-5320-be1d-ca73d7e96f79" :question/math-academy-id "q-129238" :question/problem "The intersection of the planes $x+y-z-3=0$ and $x+2y-3z+18=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this into the first equation gives  \n\n$$\nx+y-0-3=0\\,⟹\\,x=3-y,\n$$\n\nand substituting $z=0$ and $x=3-y$ into the second equation gives\n\n$$\n\\begin{aligned}(3-y)+2y-3(0)+18 & =0 \\\\ 3+y+18 & =0 \\\\ y & =-21.\\end{aligned}\n$$\n\nTherefore, $x=3-y=3+21=24$ and $a=⟨24,-21,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+y-z-3=0,$ a normal vector to the plane is ${n}_{1}=⟨1,1,-1⟩.$\n\n- For the plane $x+2y-3z+18=0,$ a normal vector to the plane is ${n}_{2}=⟨1,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,1,-1⟩\\times ⟨1,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & -1 \\\\ 1 & 2 & -3\\end{aligned}\\right| \\\\  & =-i+2j+k \\\\  & =⟨-1,2,1⟩\\end{aligned}\n$$\n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨24,-21,0⟩+t⟨-1,2,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=24-21=3,$ and $b=⟨-1,2,1⟩.$"} {:db/id #edb/ref 17592186338928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "781af1e7-5105-59b2-bc14-3db4b4b92263" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨-4,2,2⟩" :db/id #edb/ref 17592186337113} {:answer/id #uuid "7a329ed6-ba38-5f1d-a769-d1efd0b22207" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=-2,\\,b=⟨-4,2,2⟩" :db/id #edb/ref 17592186337133} {:answer/id #uuid "bae4aa70-2124-543e-86f2-6524fa9bf054" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨-2,-4,2⟩" :db/id #edb/ref 17592186337691} {:answer/id #uuid "c4489b46-42e8-5f99-95e5-777518c856b2" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=-4,\\,b=⟨-2,-4,2⟩" :db/id #edb/ref 17592186337776} {:answer/id #uuid "e46b095c-10b1-5401-9d77-19fb73327547" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=2,\\,b=⟨-4,2,2⟩" :db/id #edb/ref 17592186338023}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}-{a}_{3}=-4,\\,b=⟨-2,-4,2⟩" :db/id #edb/ref 17592186337776} :answer-field/id #uuid "6c61690c-f090-5fb7-bc15-6a556b219a15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338464}] :question/id #uuid "b67e5545-6e97-5043-a7bc-c8f5ceaad4b9" :question/math-academy-id "q-71347" :question/problem "The intersection of the planes $2x-y+6=0$ and $y+2z-2=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}-{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this to the first equation gives \n\n$$\n2x-0+6=0\\,⟹\\,x=-3,\n$$\n\nand substituting $y=0$ into the second equation gives\n\n$$\n0+2z-2=0\\,⟹\\,z=1.\n$$\n\nTherefore, $a=⟨-3,0,1⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-y+6=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,0⟩.$\n\n- For the plane $y+2z-2=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,2⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,-1,0⟩\\times ⟨0,1,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 0 \\\\ 0 & 1 & 2\\end{aligned}\\right| \\\\  & =-2i-4j+2k \\\\  & =⟨-2,-4,2⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-3,0,1⟩+t⟨-2,-4,2⟩\\end{aligned}\n$$\n\n \n\nFinally then, ${a}_{1}-{a}_{3}=-3-1=-4,$ and $b=⟨-2,-4,2⟩.$"} {:db/id #edb/ref 17592186338943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d45a629-81ec-5656-bcf4-6061e172ca71" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨2,-2,3⟩" :db/id #edb/ref 17592186336303} {:answer/id #uuid "631aefcc-a4b9-5328-8f64-63a53cadcd52" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=3,\\,b=⟨-1,-2,-3⟩" :db/id #edb/ref 17592186336924} {:answer/id #uuid "714b66a4-3d63-5a2f-840d-f5f413af2dcd" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-3,\\,b=⟨1,-2,3⟩" :db/id #edb/ref 17592186337043} {:answer/id #uuid "adcb20fe-7882-5a05-884d-a27b870c6518" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨1,-2,1⟩" :db/id #edb/ref 17592186337593} {:answer/id #uuid "cc415bdf-03a1-55d9-8e98-0b7d9f99e144" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨1,2,1⟩" :db/id #edb/ref 17592186337824}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨1,-2,1⟩" :db/id #edb/ref 17592186337593} :answer-field/id #uuid "ad3d3925-f645-5ca5-bd69-c443c9ab9ea2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338595}] :question/id #uuid "e2974487-1652-5f64-b7d4-0706a72b18a2" :question/math-academy-id "q-71446" :question/problem "The intersection of the planes $x+2y+3z=0$ and $3x+2y+z+8=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives    \n\n$$\nx+2(0)+3z=0\\,⟹\\,x=-3z,\n$$\n\nand substituting $y=0$ and $x=-3z$ into the second equation gives\n\n$$\n\\begin{aligned}3x+2y+z+8 & =0 \\\\ 3(-3z)+2(0)+z+8 & =0 \\\\ -8z & =-8 \\\\ z & =1.\\end{aligned}\n$$\n\nTherefore, $x=-3z=-3$ and $a=⟨-3,0,1⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+3z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,3⟩.$\n\n- For the plane $3x+2y+z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨3,2,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,3⟩\\times ⟨3,2,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 3 \\\\ 3 & 2 & 1\\end{aligned}\\right| \\\\  & =-4i+8j-4k \\\\  & =⟨-4,8,-4⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=-\\frac{1}{4}({n}_{1}\\times {n}_{2})=⟨1,-2,1⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-3,0,1⟩+t⟨1,-2,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-3+1=-2,$ and $b=⟨1,-2,1⟩.$"} {:db/id #edb/ref 17592186338944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d010f17-eca6-5efc-9c0b-169632d27e25" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=-3,\\,b=⟨2,1,3⟩" :db/id #edb/ref 17592186337307} {:answer/id #uuid "ac3a8aa9-91dd-5690-93db-4e90e97deefb" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=6,\\,b=⟨1,3,6⟩" :db/id #edb/ref 17592186337583} {:answer/id #uuid "ce496718-8511-5291-a356-f2abbc920d6c" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=-2,\\,b=⟨2,1,2⟩" :db/id #edb/ref 17592186337838} {:answer/id #uuid "dfcf64ba-ff60-559a-bea8-242366d87ceb" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=3,\\,b=⟨2,1,1⟩" :db/id #edb/ref 17592186337987} {:answer/id #uuid "ff69c900-64af-5638-a036-bdd78fd91848" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=2,\\,b=⟨2,2,1⟩" :db/id #edb/ref 17592186338272}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=3,\\,b=⟨2,1,1⟩" :db/id #edb/ref 17592186337987} :answer-field/id #uuid "737cd0dc-b8d6-5072-b373-f51f61ad7283" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338474}] :question/id #uuid "7fd28fdb-4130-5881-857a-aa4f88117872" :question/math-academy-id "q-71447" :question/problem "The intersection of the planes $x+2y-4z+6=0$ and $x-4y+2z=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this into the second equation gives \n\n$$\n0-4y+2z=0\\,⟹\\,z=2y,\n$$\n\nand substituting $x=0$ and $z=2y$ into the first equation gives \n\n$$\n\\begin{aligned}x+2y-4z+6 & =0 \\\\ 0+2y-4(2y)+6 & =0 \\\\ -6y & =-6 \\\\ y & =1.\\end{aligned}\n$$\n\nTherefore, $z=2y=2$ and $a=⟨0,1,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y-4z+6=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,-4⟩.$\n\n- For the plane $x-4y+2z=0,$ a normal vector to the plane is ${n}_{2}=⟨1,-4,2⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,-4⟩\\times ⟨1,-4,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & -4 \\\\ 1 & -4 & 2\\end{aligned}\\right| \\\\  & =-12i-6j-6k \\\\  & =⟨-12,-6,-6⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n \n\n$$\nb=-\\frac{1}{6}({n}_{1}\\times {n}_{2})=⟨2,1,1⟩.\n$$\n\n \n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,2⟩+t⟨2,1,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}+{a}_{3}=1+2=3,$ and $b=⟨2,1,1⟩.$"} {:db/id #edb/ref 17592186366212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3221a9ad-33cd-5589-8d04-58da9238940e" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨5,-1,3⟩" :db/id #edb/ref 17592186366214} {:answer/id #uuid "c700d7ec-2dc4-5c91-b31f-02251699ee00" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=0,\\,b=⟨3,-1,-5⟩" :db/id #edb/ref 17592186366215} {:answer/id #uuid "50edec43-8dae-5c9f-ab3b-07f67a03c9d5" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨5,1,3⟩" :db/id #edb/ref 17592186366216} {:answer/id #uuid "0fe78330-aad4-5b51-9fc7-f31f9d446de9" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=1,\\,b=⟨5,1,-3⟩" :db/id #edb/ref 17592186366217} {:answer/id #uuid "86b7c672-b3df-5dbe-8e30-f48eb2411bdb" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-1,\\,b=⟨5,-1,-3⟩" :db/id #edb/ref 17592186366218}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-1,\\,b=⟨5,-1,-3⟩" :db/id #edb/ref 17592186366218} :answer-field/id #uuid "fe204930-21f0-5f11-87d8-144b4ea013e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366213}] :question/id #uuid "56b3e332-cb62-524a-a627-2ac9bac6fdaa" :question/math-academy-id "q-71415" :question/problem "The intersection of the planes $3x+6y+3z=0$ and $x-y+2z+3=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this into the first equation gives  \n\n$$\n3x+6y+3(0)=0\\,⟹\\,x=-2y,\n$$\n\nand substituting $z=0$ and $x=-2y$ into the second equation gives\n\n$$\n\\begin{aligned}x-y+2z+3 & =0 \\\\ -2y-y+2(0)+3 & =0 \\\\ -3y & =-3 \\\\ y & =1.\\end{aligned}\n$$\n\nTherefore, $x=-2y=-2$ and $a=⟨-2,1,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $3x+6y+3z=0,$ a normal vector to the plane is ${n}_{1}=⟨3,6,3⟩.$\n\n- For the plane $x-y+2z+3=0,$ a normal vector to the plane is ${n}_{2}=⟨1,-1,2⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,6,3⟩\\times ⟨1,-1,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 6 & 3 \\\\ 1 & -1 & 2\\end{aligned}\\right| \\\\  & =15i-3j-9k \\\\  & =⟨15,-3,-9⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{3}({n}_{1}\\times {n}_{2})=⟨5,-1,-3⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-2,1,0⟩+t⟨5,-1,-3⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-2+1=-1,$ and $b=⟨5,-1,-3⟩.$"} {:db/id #edb/ref 17592186400429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6af159c-b46d-5f23-a72f-d37f7d8b6c4a" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨9,5,3⟩" :db/id #edb/ref 17592186400431} {:answer/id #uuid "c3139276-08b4-56c9-b405-23041fd40cc8" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=8,\\,b=⟨5,3,9⟩" :db/id #edb/ref 17592186400432} {:answer/id #uuid "880caa6a-847c-5b25-a64d-abcc3d2d9f08" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=4,\\,b=⟨9,3,5⟩" :db/id #edb/ref 17592186400433} {:answer/id #uuid "f699bd35-2839-5408-8f07-791a9775b7d8" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨3,9,5⟩" :db/id #edb/ref 17592186400434} {:answer/id #uuid "39de4a51-eaa0-5c94-bc09-d764bcf1c4ad" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨6,3,5⟩" :db/id #edb/ref 17592186400435}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=4,\\,b=⟨9,3,5⟩" :db/id #edb/ref 17592186400433} :answer-field/id #uuid "17d7ccaf-18fd-5fe2-bf5c-7ec52555ab3d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400430}] :question/id #uuid "923148c0-0ecb-5f91-a025-b18771e50157" :question/math-academy-id "q-129224" :question/problem "The intersection of the planes $2x-y-3z-8=0$ and $x+2y-3z-4=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n2x-y-3(0)-8=0\\,⟹\\,y=2x-8,\n$$\n\nand substituting $z=0$ and $y=2x-8$ into the second equation gives\n\n$$\n\\begin{aligned}x+2(2x-8)-0-4 & =0 \\\\ x+4x-16-4 & =0 \\\\ 5x & =20 \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, $y=2(4)-8=0$ and $a=⟨4,0,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-y-3z-8=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,-3⟩.$\n\n- For the plane $x+2y-3z-4=0,$ a normal vector to the plane is ${n}_{2}=⟨1,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-1,-3⟩\\times ⟨1,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & -3 \\\\ 1 & 2 & -3\\end{aligned}\\right| \\\\  & =9i+3j+5k \\\\  & =⟨9,3,5⟩\\end{aligned}\n$$\n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨4,0,0⟩+t⟨9,3,5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=4+0=4,$ and $b=⟨9,3,5⟩.$"} {:db/id #edb/ref 17592186421901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a5b51a0-3005-5ddd-b5ab-b8d3b530fe56" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=2,\\,b=⟨1,-1,-1⟩" :db/id #edb/ref 17592186421890} {:answer/id #uuid "77d58298-86f5-5da7-a6f5-5aadeb1af6ca" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=-1,\\,b=⟨1,1,-1⟩" :db/id #edb/ref 17592186421891} {:answer/id #uuid "782abb1a-40ca-50f3-9eb2-460b14bea776" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=0,\\,b=⟨1,1,-1⟩" :db/id #edb/ref 17592186421892} {:answer/id #uuid "8b4a733d-fbda-5f24-ba39-11bd9f15b6aa" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=1,\\,b=⟨1,-1,-1⟩" :db/id #edb/ref 17592186421893} {:answer/id #uuid "d67766c9-e639-50ae-a0fa-fe37c24c18e0" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=0,\\,b=⟨1,-1,-1⟩" :db/id #edb/ref 17592186421896}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}+{a}_{3}=0,\\,b=⟨1,-1,-1⟩" :db/id #edb/ref 17592186421896} :answer-field/id #uuid "ee9b9e23-e285-51ba-8f2e-0f93320571fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421900}] :question/id #uuid "3582cc5d-9e46-5e0a-8d0c-b0e74f8f5924" :question/math-academy-id "q-71349" :question/problem "The intersection of the planes $x+y-1=0$ and $x+z+1=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this to the first equation gives\n\n$$\n0+y-1=0\\,⟹\\,y=1,\n$$\n\nand substituting $x=0$ into the second equation gives\n\n$$\n0+z+1=0\\,⟹\\,z=-1.\n$$\n\nTherefore, $a=⟨0,1,-1⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+y-1=0,$ a normal vector to the plane is ${n}_{1}=⟨1,1,0⟩.$\n\n- For the plane $x+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,0,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,1,0⟩\\times ⟨1,0,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}\\right| \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,-1⟩+t⟨1,-1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}+{a}_{3}=1+(-1)=0,$ and $b=⟨1,-1,-1⟩.$"} {:db/id #edb/ref 17592186421902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc5a66d-b1b1-585a-b0bc-21d19ca71687" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=-18,\\,b=⟨3,9,-2⟩" :db/id #edb/ref 17592186421889} {:answer/id #uuid "9c3c1355-587b-53a6-a6d7-2db08ae599af" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=-20,\\,b=⟨3,-2,-9⟩" :db/id #edb/ref 17592186421894} {:answer/id #uuid "d155552d-65e9-593d-bf4d-41010a2e061a" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=18,\\,b=⟨3,9,-2⟩" :db/id #edb/ref 17592186421895} {:answer/id #uuid "e23fcb96-7207-5675-97d0-1ce03137e6ec" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=20,\\,b=⟨3,-2,-9⟩" :db/id #edb/ref 17592186421897} {:answer/id #uuid "f9b80375-370c-5de5-b724-efe10f25c766" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=10,\\,b=⟨3,-2,-9⟩" :db/id #edb/ref 17592186421898}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{2}-{a}_{3}=20,\\,b=⟨3,-2,-9⟩" :db/id #edb/ref 17592186421897} :answer-field/id #uuid "1ea7962c-6925-55c2-86b0-52523c308e6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421899}] :question/id #uuid "caefbcdd-6450-5b4b-b965-772f5b87b02a" :question/math-academy-id "q-129208" :question/problem "The intersection of the planes $2x+3y-3=0$ and $3x+z+19=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}-{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this to the first equation gives\n\n$$\n0+3y-3=0\\,⟹\\,y=1,\n$$\n\nand substituting $x=0$ into the second equation gives\n\n$$\n0+z+19=0\\,⟹\\,z=-19.\n$$\n\nTherefore, $a=⟨0,1,-19⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x+3y-3=0,$ a normal vector to the plane is ${n}_{1}=⟨2,3,0⟩.$\n\n- For the plane $3x+z+19=0,$ a normal vector to the plane is ${n}_{2}=⟨3,0,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,3,0⟩\\times ⟨3,0,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 3 & 0 \\\\ 3 & 0 & 1\\end{aligned}\\right| \\\\  & =3i-2j-9k \\\\  & =⟨3,-2,-9⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,-19⟩+t⟨3,-2,-9⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}-{a}_{3}=1-(-19)=20,$ and $b=⟨3,-2,-9⟩.$"} {:db/id #edb/ref 17592186559772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,-1,-1⟩" :db/id #edb/ref 17592186559098} {:answer/id #uuid "82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-1,1,-1⟩" :db/id #edb/ref 17592186559341} {:answer/id #uuid "8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨1,1,-1⟩" :db/id #edb/ref 17592186559357} {:answer/id #uuid "bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨-1,1,1⟩" :db/id #edb/ref 17592186559482} {:answer/id #uuid "f182158c-1a39-52d9-93a0-587908c41e2d" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨1,1,-1⟩" :db/id #edb/ref 17592186559604}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-1,1,-1⟩" :db/id #edb/ref 17592186559341} :answer-field/id #uuid "b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559741}] :question/id #uuid "0174198f-a0ad-5395-9af8-f36d4c14897b" :question/math-academy-id "q-71392" :question/problem "The intersection of the planes $-x+z-1=0$ and $y+z+5=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+0-1=0\\,⟹\\,x=-1,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\ny+0+5=0\\,⟹\\,y=-5.\n$$\n\nTherefore, $a=⟨-1,-5,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+z-1=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,0,1⟩.$\n\n- For the plane $y+z+5=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨-1,0,1⟩\\times ⟨0,1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}\\right| \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-5,0⟩+t⟨-1,1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1+(-5)=-6,$ and $b=⟨-1,1,-1⟩.$"} {:db/id #edb/ref 17592186559889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=1,\\,b=⟨6,2,5⟩" :db/id #edb/ref 17592186559161} {:answer/id #uuid "908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-1,\\,b=⟨6,4,5⟩" :db/id #edb/ref 17592186559376} {:answer/id #uuid "a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-4,\\,b=⟨6,2,5⟩" :db/id #edb/ref 17592186559440} {:answer/id #uuid "f462a311-ea89-555c-9281-1e9601a16c66" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨6,2,-5⟩" :db/id #edb/ref 17592186559616} {:answer/id #uuid "f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨6,-2,-5⟩" :db/id #edb/ref 17592186559623}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨6,2,-5⟩" :db/id #edb/ref 17592186559616} :answer-field/id #uuid "55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559691}] :question/id #uuid "fad299b6-2750-5729-9622-52ccf21ff85a" :question/math-academy-id "q-71414" :question/problem "The intersection of the planes $x+2y+2z=0$ and $4x-2y+4z+8=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives \n\n$$\nx+2(0)+2z=0\\,⟹\\,x=-2z,\n$$\n\nand substituting $y=0$ and $x=-2z$ into the second equation gives\n\n$$\n\\begin{aligned}4x-2y+4z+8 & =0 \\\\ 4(-2z)-2(0)+4z+8 & =0 \\\\ -4z & =-8 \\\\ z & =2.\\end{aligned}\n$$\n\nTherefore, $x=-2z=-4$ and $a=⟨-4,0,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+2z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,2⟩.$\n\n- For the plane $4x-2y+4z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨4,-2,4⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,2⟩\\times ⟨4,-2,4⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 4 & -2 & 4\\end{aligned}\\right| \\\\  & =12i+4j-10k \\\\  & =⟨12,4,-10⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{2}({n}_{1}\\times {n}_{2})=⟨6,2,-5⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-4,0,2⟩+t⟨6,2,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-4+2=-2,$ and $b=⟨6,2,-5⟩.$"}] :knowledge-point/title "Finding the Vector Equation of a Line Given as the Intersection of Two Planes"} {:db/id #edb/ref 17592186147426 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147342 :question/id #uuid "68b206e1-07ee-5591-ac08-0109cb2063cf" :question/math-academy-id "e-5920" :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\left\\{\\begin{aligned}2x+4y+5 &=0 \\\\ 3y-2z-7 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $2x+4y +5= 0,$ a normal vector to the plane is $\\mathbf{n}_1 = \\langle 2,4,0 \\rangle.$\n\n- For the plane $3y-2z-7= 0,$ a normal vector to the plane is $\\mathbf{n}_2 = \\langle 0,3,-2 \\rangle.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,4,0⟩\\times ⟨0,3,-2⟩ \\\\  & =\\left|\\begin{aligned}\\,i & \\,j & \\,k\\, \\\\ \\,2 & \\,4 & \\,0\\, \\\\ \\,0 & \\,3 & \\,\\,\\,-2\\,\\end{aligned}\\right| \\\\  & =-8i+4j+6k \\\\  & =⟨-8,4,6⟩\\end{aligned}\n$$"} :knowledge-point/id #uuid "4b5f51ee-5bde-5e39-8d2a-e5e482be4916" :knowledge-point/questions [{:db/id #edb/ref 17592186148195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c64926a1-902a-58d9-ba27-0fd710e7dd4f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-1,-5⟩" :db/id #edb/ref 17592186146926} {:answer/id #uuid "0d21c6b9-3f99-5745-ab7b-e3a41222131c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-2,-3⟩" :db/id #edb/ref 17592186146929} {:answer/id #uuid "251ddf2f-7d06-501e-bde5-438da0173d51" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,-5⟩" :db/id #edb/ref 17592186559107} {:answer/id #uuid "5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-1,1⟩" :db/id #edb/ref 17592186559254} {:answer/id #uuid "6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,0⟩" :db/id #edb/ref 17592186559282}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-1,-5⟩" :db/id #edb/ref 17592186146926} :answer-field/id #uuid "c5616580-763b-5332-8f52-a3f7d2017eaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146924}] :question/id #uuid "b4dd6df0-763b-5991-88eb-0cc2466040ce" :question/math-academy-id "q-71103" :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\{\\begin{aligned}x+2y-5=0 \\\\ 2x-y+z+1=0\\end{aligned}\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $x+2y-5=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,0⟩.$\n\n- For the plane $2x-y+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,2,0⟩\\times ⟨2,-1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 0 \\\\ 2 & -1 & 1\\end{aligned}\\right| \\\\  & =2i-j-5k \\\\  & =⟨2,-1,-5⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186148196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a75086a-b91e-5b01-8e17-10e8b481fdb9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 2, 0⟩" :db/id #edb/ref 17592186146931} {:answer/id #uuid "d380772a-9ee2-5e40-a2d5-bffc23bc0229" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 0,-1⟩" :db/id #edb/ref 17592186146932} {:answer/id #uuid "d5e2acb5-0788-5f2f-b124-32c14e2fcb7b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2, 1, 0⟩" :db/id #edb/ref 17592186146933} {:answer/id #uuid "e6ba7113-0ad1-5e9e-b922-b8a6c9ceeb97" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 2, 1, 0⟩" :db/id #edb/ref 17592186146934} {:answer/id #uuid "067e7fad-c72d-5a7f-8ce4-00dda9985309" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 2,-1⟩" :db/id #edb/ref 17592186146935}] :answer-field/id #uuid "608a8e9d-6642-5248-9d67-750c5274c2f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146930}] :question/id #uuid "9db0fb46-a8f6-5ec7-be64-0c8ecdc38fdb" :question/math-academy-id "q-71105" :question/problem "Find a direction vector of the line that is given as the intersection of the planes $z = 3$ and $x =-2y$."} {:db/id #edb/ref 17592186262963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042f093f-d5a9-5bf5-9d5b-2379616336a8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,3,10⟩" :db/id #edb/ref 17592186259914} {:answer/id #uuid "6a54e4ee-7c79-55fc-870a-0998ecf09a67" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,3,10⟩" :db/id #edb/ref 17592186260808} {:answer/id #uuid "b450a2bb-ed56-547f-a8c8-232888890920" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,3,-10⟩" :db/id #edb/ref 17592186261461} {:answer/id #uuid "db544191-d90c-5111-9151-21c167bf73ba" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,2,-10⟩" :db/id #edb/ref 17592186261813} {:answer/id #uuid "f8c0877b-5609-5c19-8d3a-532b75c50be2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-2,-10⟩" :db/id #edb/ref 17592186262047}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-2,-10⟩" :db/id #edb/ref 17592186262047} :answer-field/id #uuid "97f20976-38d3-57ca-9252-824b0a7821b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262396}] :question/id #uuid "da503009-d4dd-5f15-b7a1-042169b5682e" :question/math-academy-id "q-129168" :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\left\\{\\begin{aligned}2x+3y+10 &=0 \\\\ 2x-2y+z+15 &=0\\end{aligned}\\right.\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $2x+3y+10=0,$ a normal vector to the plane is ${n}_{1}=⟨2,3,0⟩.$\n\n- For the plane $2x-2y+z+15=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-2,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,3,0⟩\\times ⟨2,-2,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 3 & 0 \\\\ 2 & -2 & 1\\end{aligned}\\right| \\\\  & =3i-2j-10k \\\\  & =⟨3,-2,-10⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0211e7c3-7805-5634-b1d3-29a07cae4918" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,8,6⟩" :db/id #edb/ref 17592186259888} {:answer/id #uuid "1fa07d3d-d716-5f4c-96d8-fb15a8425df1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,4,6⟩" :db/