243481}] :question/id #uuid "8f2440fe-5d7f-50f0-96da-6c8dae104de5" :question/math-academy-id "q-106958" :question/problem "Find the characteristic equation of the matrix \n$B=\\begin{bmatrix}5 & -1 \\\\ 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(1-\\lambda )-0\\cdot (-1) & =0 \\\\ 5-5\\lambda -\\lambda +{\\lambda }^{2}+0 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5cd195-916d-51d3-a145-ac3d8abbdf92" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda -40=0" :db/id #edb/ref 17592186241427} {:answer/id #uuid "2bdfc526-d86a-5e73-baca-2112c1ad2358" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda +40=0" :db/id #edb/ref 17592186241571} {:answer/id #uuid "35403cd9-ea2a-5b57-971f-4e9e59069317" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda -40=0" :db/id #edb/ref 17592186241646} {:answer/id #uuid "a5cf22be-62ee-5bda-9228-41b20aca0652" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -10=0" :db/id #edb/ref 17592186242639} {:answer/id #uuid "dd32357c-ec00-5793-bb30-3f656df8bc88" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-4\\lambda +10=0" :db/id #edb/ref 17592186243148}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-3\\lambda -40=0" :db/id #edb/ref 17592186241427} :answer-field/id #uuid "9d00855c-44e0-5a49-b0df-a66417f8be4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/i