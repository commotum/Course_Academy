92186426459} :answer-field/id #uuid "a405d6cc-14d9-5743-9f23-3b29719764ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426468}] :question/id #uuid "f0cba12d-30e2-5e4e-9717-4d5124d428a8" :question/math-academy-id "q-76341" :question/problem "Find the characteristic equation of the matrix $L=\\begin{bmatrix}0 & 0 \\\\ -1 & \\frac{1}{5}\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=\\begin{bmatrix}0-\\lambda  & 0 \\\\ -1 & \\frac{1}{5}-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ \\begin{vmatrix}-\\lambda  & 0 \\\\ -1 & \\frac{1}{5}-\\lambda \\end{vmatrix} & =0 \\\\ -\\lambda (\\frac{1}{5}-\\lambda )-(-1)\\cdot 0 & =0 \\\\ -\\frac{1}{5}\\lambda +{\\lambda }^{2} & =0 \\\\ {\\lambda }^{2}-\\frac{1}{5}\\lambda  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0213af8b-e153-5a9f-bcae-d28d03ed5a5a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda +15=0" :db/id #edb/ref 17592186446634} {:answer/id #uuid "09d9b377-d154-58c3-9816-cc93e5ae714f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -5=0" :db/id #edb/ref 17592186446635} {:answer/id #uuid "8c1e288e-9f0e-5aa1-a99f-65dcd2f40da3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda -35=0" :db/id #edb/ref 17592186446677} {:answer/id #uuid "c55c3bab-e95d-5b9c-87f7-f189a3394e07" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda +15=0" :db/id #edb/ref 17592186446693} {:answer/id #uuid "eb843c49-7c9d-5188-a745-423ff5070742" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+15\\lambda +5=0" :db/id #edb/ref 17592186446705}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+8\\lambda +15=0" :db/id #edb/ref 17592186446693} :answer-field/id #uuid "7076766c-bcdf-54a7-b381-7806ea7001fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446724}] :question/id #uuid "0b0fd647-11bd-5cf6-9bab-c8f19524ee42" :question/math-academy-id "q-107986" :question/problem "Find the characteristic equation of the matrix $A=\\begin{bmatrix}2 & -7 \\\\ 5 & -10\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}2-\\lambda  & -7 \\\\ 5 & -10-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & -7 \\\\ 5 & -10-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-10-\\lambda )-5\\cdot (-7) & =0 \\\\ -20-2\\lambda +10\\lambda +{\\lambda }^{2}+35 & =0 \\\\ {\\lambda }^{2}+8\\lambda +15 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68d692e8-2c9b-54e7-a366-01c7bd296385" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )-\\sqrt{7}=0" :db/id #edb/ref 17592186446661} {:answer/id #uuid "70faf1f1-23c6-58e4-bf59-0e879757a31f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446665} {:answer/id #uuid "c9ec6264-3ee5-5365-b892-5188665949f4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1+\\lambda )=0" :db/id #edb/ref 17592186446696} {:answer/id #uuid "f29c22a6-dc15-5878-997c-e48683c9fce5" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}+\\lambda )(1+\\lambda )-\\sqrt{7}=0" :db/id #edb/ref 17592186446710} {:answer/id #uuid "f8320f69-edc7-50c1-b592-2506954adc67" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446713}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}-\\lambda )(1-\\lambda )=0" :db/id #edb/ref 17592186446713} :answer-field/id #uuid "7fe5a947-f078-594e-9bf7-dde3c2b3ec2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446726}] :question/id #uuid "548202ea-0779-523d-b823-a5921b15b56b" :question/math-academy-id "q-76342" :question/problem "Find the characteristic equation of the matrix $M=\\begin{bmatrix}\\sqrt{3} & \\sqrt{7} \\\\ 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,M-\\lambda I:$\n﻿﻿﻿\n\n$$\nM-\\lambda I=\\begin{bmatrix}\\sqrt{3}-\\lambda  & \\sqrt{7} \\\\ 0 & 1-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(M-\\lambda I) & =0 \\\\ \\begin{vmatrix}\\sqrt{3}-\\lambda  & \\sqrt{7} \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (\\sqrt{3}-\\lambda )(1-\\lambda )-0\\cdot \\sqrt{7} & =0 \\\\ (\\sqrt{3}-\\lambda )(1-\\lambda ) & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be045a5-6b6f-58a1-a9c0-054dd780305c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-5\\lambda +8=0" :db/id #edb/ref 17592186446652} {:answer/id #uuid "680fa24a-7dc3-543d-85de-5db5562557f9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-5\\lambda +4=0" :db/id #edb/ref 17592186446660} {:answer/id #uuid "9a3e29e7-ff34-52ad-a2b3-30b0d4dfc7ea" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda +4=0" :db/id #edb/ref 17592186446683} {:answer/id #uuid "bb76f2d9-d38e-5ad5-b5ba-f0c456c42a65" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+5\\lambda +8=0" :db/id #edb/ref 17592186446689} {:answer/id #uuid "ee278763-ab63-504f-822f-61b01cf166d4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+4=0" :db/id #edb/ref 17592186446708}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-5\\lambda +8=0" :db/id #edb/ref 17592186446652} :answer-field/id #uuid "5ff74171-fb77-58e8-9b4d-b1ac71573691" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446722}] :question/id #uuid "8a11188a-8a0f-5ab5-9de2-8d85b1d9c9bc" :question/math-academy-id "q-106954" :question/problem "Find the characteristic equation of the matrix $A=\\begin{bmatrix}1 & -2 \\\\ 2 & 4\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}1-\\lambda  & -2 \\\\ 2 & 4-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & -2 \\\\ 2 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(4-\\lambda )-2\\cdot (-2) & =0 \\\\ 4-\\lambda -4\\lambda +{\\lambda }^{2}+4 & =0 \\\\ {\\lambda }^{2}-5\\lambda +8 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a787981-8115-531c-a0b2-45614b628dbe" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda -30=0" :db/id #edb/ref 17592186446651} {:answer/id #uuid "514631b5-18c9-56ed-b862-2cfc925d4f44" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda -12=0" :db/id #edb/ref 17592186446655} {:answer/id #uuid "d0015afe-6401-5c12-9cf2-8b51092f7180" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-6=0" :db/id #edb/ref 17592186446699} {:answer/id #uuid "e79a4073-0867-556b-8d5c-c5025c11ea29" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -30=0" :db/id #edb/ref 17592186446703} {:answer/id #uuid "fcd3bb9f-f42f-5091-bf4d-48c5dff63db4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda +6=0" :db/id #edb/ref 17592186446715}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda -30=0" :db/id #edb/ref 17592186446651} :answer-field/id #uuid "e9ffc0b3-2fb7-50ab-863d-ef122a417f29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446730}] :question/id #uuid "c2d1ce53-250c-556e-b39c-e7210e507a13" :question/math-academy-id "q-106947" :question/problem "Find the characteristic equation of the matrix $A=\\begin{bmatrix}4 & 9 \\\\ 2 & -3\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}4-\\lambda  & 9 \\\\ 2 & -3-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 9 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(-3-\\lambda )-2\\cdot 9 & =0 \\\\ -12-4\\lambda +3\\lambda +{\\lambda }^{2}-18 & =0 \\\\ {\\lambda }^{2}-\\lambda -30 & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Characteristic Equation of a Matrix"} {:db/id #edb/ref 17592186092230 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092075 :question/id #uuid "55e695b2-4581-5ba7-9604-506234b88323" :question/math-academy-id "e-5480" :question/problem "Find all real eigenvalues of the matrix\n![](images/2c/2c669dd6f7c5fa368c5ea28961d2ef57cac9deaf7ba453f75a441b05206f6276.svg)" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I\\mathbin{:}$\n![](images/e4/e4e91261ec7f4a9a48847005a57730afa25f5e69a1f3818ad583acaadae639f8.svg)\n\nNow, let's find and solve the characteristic equation $\\det(B-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}4-\\lambda  & 0 \\\\ 0 & 4-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )(4-\\lambda )-0\\cdot 0 & =0 \\\\ (\\lambda -4)^{2} & =0\\end{aligned}\n$$\n\nTherefore, the matrix $B$ has only one eigenvalue $\\lambda=4,$ which is a double root of the characteristic equation. \n\n**Note:** We also say that $\\lambda=4$ has an **algebraic multiplicity** of $2.$"} :knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11" :knowledge-point/questions [{:db/id #edb/ref 17592186092691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a537b1-5dc1-566a-9e74-e2dcfcb05234" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =6$ and $\\lambda =10$" :db/id #edb/ref 17592186321430} {:answer/id #uuid "2f09fc12-e77b-5d3a-8bf5-3206a98228e9" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186321511} {:answer/id #uuid "8109cdb3-fff2-519d-b607-3ccd4eadccb8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =8$ and $\\lambda =5$" :db/id #edb/ref 17592186322162} {:answer/id #uuid "aa2951cc-d69d-5205-be76-aee83aade18c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-10$" :db/id #edb/ref 17592186322485} {:answer/id #uuid "da37b8b4-b86c-52be-9edf-4d44daca250f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =8$ (double root)" :db/id #edb/ref 17592186322856}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186321511} :answer-field/id #uuid "255562d5-b67b-5f8c-b0e9-9ed67cabbd41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323241}] :question/id #uuid "f563abe4-0d8d-5d69-9a75-20dcd9079f0b" :question/math-academy-id "q-36776" :question/problem "Find all real eigenvalues of the matrix\n$Q=\\begin{bmatrix}-6 & -3 \\\\ 2 & -10\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}-6-\\lambda  & -3 \\\\ 2 & -10-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}-6-\\lambda  & -3 \\\\ 2 & -10-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(-10-\\lambda )-(-3)\\cdot 2 & =0 \\\\ 60+6\\lambda +10\\lambda +{\\lambda }^{2}+6 & =0 \\\\ {\\lambda }^{2}+16\\lambda +66 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={16}^{2}-4\\cdot 1\\cdot 66 \\\\  & =256-264 \\\\  & =-8 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions, and therefore, $Q$ does not have real eigenvalues."} {:db/id #edb/ref 17592186092903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d80dad0-53c0-5d27-b5bd-04bb58893f9c" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091620} {:answer/id #uuid "18d67bdb-601f-58e7-8b75-d3e4da748215" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =4$" :db/id #edb/ref 17592186446641} {:answer/id #uuid "4a33786d-34fc-5151-8170-2a142f2702df" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$  (double root)" :db/id #edb/ref 17592186446654} {:answer/id #uuid "89b8c0e6-ae99-51c1-8e85-66f98539ea38" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186446676} {:answer/id #uuid "f1455b86-25c6-5810-8b96-3462621d7ca7" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\lambda =4$" :db/id #edb/ref 17592186446709}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186446676} :answer-field/id #uuid "7fe56ff3-6e9f-5f5f-b666-d2ba2dce775a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091618}] :question/id #uuid "8d64c1c7-5e2c-5d9e-ad36-647b8fb50a8a" :question/math-academy-id "q-9346" :question/problem "Find all real eigenvalues of the matrix\n$A=\\begin{bmatrix}3 & 1 \\\\ -1 & 1\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 1 \\\\ -1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(1-\\lambda )+1\\cdot 1 & =0 \\\\ 3-3\\lambda -\\lambda +{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2}-4\\lambda +4 & =0 \\\\ (\\lambda -2)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $A$ has only one eigenvalue $\\lambda =2,$ which is a double root of the characteristic equation."} {:db/id #edb/ref 17592186244110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a96d68e-1fa4-541b-b969-5ad9ad877559" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =43$" :db/id #edb/ref 17592186241274} {:answer/id #uuid "3fa22426-2c63-51ef-8ae0-9e3385cbf206" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =43$ (double root)" :db/id #edb/ref 17592186241752} {:answer/id #uuid "b5b862fe-da16-5b54-8cc4-0d2a73ecb1eb" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186242767} {:answer/id #uuid "c010ea74-931f-5ed7-82a4-366b8e5ff3d4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =13$ (double root)" :db/id #edb/ref 17592186242860} {:answer/id #uuid "fb27cfbc-81e9-5f53-8596-793c8294e762" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =13$ and $\\lambda =43$" :db/id #edb/ref 17592186243395}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186242767} :answer-field/id #uuid "3d879f6a-f621-5faa-a1c9-b89dff4b4b09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243558}] :question/id #uuid "41123383-6ac1-5b34-8d5e-987d1637c699" :question/math-academy-id "q-107852" :question/problem "Find all real eigenvalues of the matrix\n$Q=\\begin{bmatrix}5 & 1 \\\\ -3 & 8\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}5-\\lambda  & 1 \\\\ -3 & 8-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 1 \\\\ -3 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(8-\\lambda )-(-3)\\cdot 1 & =0 \\\\ 40-5\\lambda -8\\lambda +{\\lambda }^{2}+3 & =0 \\\\ {\\lambda }^{2}-13\\lambda +43 & =0.\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-13)^{2}-4\\cdot 1\\cdot 43 \\\\  & =169-172 \\\\  & =-3 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $Q$ does not have real eigenvalues."} {:db/id #edb/ref 17592186323849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069f9b9c-808b-52a2-8cd1-ba1dd320b25d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186321200} {:answer/id #uuid "0b25a024-ca60-5cec-a4ef-16d3adfbbac9" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\lambda =-4$" :db/id #edb/ref 17592186321241} {:answer/id #uuid "27dc592e-5ccd-5a55-8ebb-b0cfc6ace477" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186321460} {:answer/id #uuid "7a72309c-bcdb-57bb-a0ed-0810c18a643c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\lambda =4$" :db/id #edb/ref 17592186322106} {:answer/id #uuid "de878c27-7d43-59a1-8169-ad73cfcfdb53" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ (double root)" :db/id #edb/ref 17592186322885}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186321460} :answer-field/id #uuid "0c9a5847-44e9-58f0-98e1-eda04cb8c1fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323190}] :question/id #uuid "5318dbea-5fd5-50c8-abc5-19d9f5bd52ba" :question/math-academy-id "q-36756" :question/problem "Find all real eigenvalues of the matrix\n$B=\\begin{bmatrix}-4 & -4 \\\\ 16 & 12\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}-4-\\lambda  & -4 \\\\ 16 & 12-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}-4-\\lambda  & -4 \\\\ 16 & 12-\\lambda \\end{vmatrix} & =0 \\\\ (-4-\\lambda )(12-\\lambda )-16\\cdot (-4) & =0 \\\\ -48+4\\lambda -12\\lambda +{\\lambda }^{2}+64 & =0 \\\\ {\\lambda }^{2}-8\\lambda +16 & =0 \\\\ (\\lambda -4)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $B$ has only one eigenvalue $\\lambda =4,$ which is a double root of the characteristic equation."} {:db/id #edb/ref 17592186402502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59772435-47fc-5334-abcb-49806bdf663f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =-1$" :db/id #edb/ref 17592186402504} {:answer/id #uuid "21867d1c-a495-57db-b95a-b9f525722f3b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =2$" :db/id #edb/ref 17592186402505} {:answer/id #uuid "3dab84f4-4ead-5ca7-9590-c2bf48713203" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$  (double root)" :db/id #edb/ref 17592186402506} {:answer/id #uuid "62c503db-45e0-5faa-ab2f-83bcae925d16" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186402507} {:answer/id #uuid "d5a9dae7-b21e-58ee-93e8-fba98d0b7b38" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ (double root)" :db/id #edb/ref 17592186402508}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$  (double root)" :db/id #edb/ref 17592186402506} :answer-field/id #uuid "24b9c663-0209-5f63-b92c-ebaf5ed593f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402503}] :question/id #uuid "3b14bc23-f539-5c26-97da-0a4a4fc1772d" :question/math-academy-id "q-36778" :question/problem "Find all real eigenvalues of the matrix\n$E=\\begin{bmatrix}2 & 8 \\\\ -2 & -6\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $E-\\lambda I:$\n﻿﻿﻿\n\n$$\nE-\\lambda I=\\begin{bmatrix}2-\\lambda  & 8 \\\\ -2 & -6-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(E-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(E-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 8 \\\\ -2 & -6-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-6-\\lambda )-(-2)\\cdot 8 & =0 \\\\ -12-2\\lambda +6\\lambda +{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2}+4\\lambda +4 & =0 \\\\ (\\lambda +2)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $E$ has only one eigenvalue $\\lambda =-2,$ which is a double root of the characteristic equation."} {:db/id #edb/ref 17592186402509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ad3afc0-1147-5a90-b327-46c419abae45" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7$ (double root)" :db/id #edb/ref 17592186402511} {:answer/id #uuid "bebf86c2-9d02-56e0-8de7-e3c093fdb99b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =7$" :db/id #edb/ref 17592186402512} {:answer/id #uuid "1fe3b5b3-5b53-5af3-a386-d1a9cac7570e" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186402513} {:answer/id #uuid "5e1b2964-fbf6-54e9-a3dc-5eb4004c5b91" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =-5$" :db/id #edb/ref 17592186402514} {:answer/id #uuid "00de227b-1e08-5a35-a745-88b3e218426e" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/id #edb/ref 17592186402515}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186402513} :answer-field/id #uuid "9c905a94-1e61-56fb-85f0-520ef6a3631a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402510}] :question/id #uuid "1fda33b2-0f78-5ef6-abce-da9e465c13f7" :question/math-academy-id "q-36780" :question/problem "Find all real eigenvalues of the matrix\n$P=\\begin{bmatrix}7 & 1 \\\\ -5 & 7\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}7-\\lambda  & 1 \\\\ -5 & 7-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}7-\\lambda  & 1 \\\\ -5 & 7-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(7-\\lambda )-1\\cdot (-5) & =0 \\\\ 49-7\\lambda -7\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}-14\\lambda +54 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-14)^{2}-4\\cdot 1\\cdot 54 \\\\  & =196-216 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $P$ does not have real eigenvalues."} {:db/id #edb/ref 17592186426470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab8fa77-b07d-58b9-9474-d0c32cc4c09f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =7$" :db/id #edb/ref 17592186426442} {:answer/id #uuid "1fdedc73-108d-54bf-a80b-6f8d76425d70" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =8$" :db/id #edb/ref 17592186426443} {:answer/id #uuid "21d98a0f-7b72-5084-9fcf-ee900921103a" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186426444} {:answer/id #uuid "719faad2-519c-564b-8cd3-1c5984c43468" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ (double root)" :db/id #edb/ref 17592186426446} {:answer/id #uuid "91ad27ae-e7c0-5e02-81e4-7e77b33fc829" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =-5$" :db/id #edb/ref 17592186426451}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186426444} :answer-field/id #uuid "9ce446c5-2796-5a84-9642-b7abdb29a329" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426467}] :question/id #uuid "9582a502-0045-5277-be86-c165d61a4715" :question/math-academy-id "q-106983" :question/problem "Find all real eigenvalues of the matrix\n$Q=\\begin{bmatrix}1 & -2 \\\\ 2 & 4\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}1-\\lambda  & -2 \\\\ 2 & 4-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & -2 \\\\ 2 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(4-\\lambda )-2\\cdot (-2) & =0 \\\\ 4-\\lambda -4\\lambda +{\\lambda }^{2}+4 & =0 \\\\ {\\lambda }^{2}-5\\lambda +8 & =0.\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-5)^{2}-4\\cdot 1\\cdot 8 \\\\  & =25-32 \\\\  & =-7 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $Q$ does not have real eigenvalues."} {:db/id #edb/ref 17592186446737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1143f7a7-3c20-50bb-b995-564624c93a52" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =9$ and $\\lambda =-6$" :db/id #edb/ref 17592186446639} {:answer/id #uuid "17a34526-21cf-53cf-aa39-d12402af539d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446640} {:answer/id #uuid "1fdece1b-ac27-5958-a1d9-138dda9c3a7d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7$  (double root)" :db/id #edb/ref 17592186446643} {:answer/id #uuid "33cfa4f0-b28e-5bca-a516-62e8607d6074" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\lambda =5$" :db/id #edb/ref 17592186446649} {:answer/id #uuid "43843bb9-eeeb-51b0-be25-7866a7b2aeba" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\lambda =-5$" :db/id #edb/ref 17592186446653}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446640} :answer-field/id #uuid "3850d5ad-9421-5f33-bc57-b428d8dacd98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446718}] :question/id #uuid "688b15c3-44c2-5c91-89ca-dd25252cd049" :question/math-academy-id "q-36772" :question/problem "Find all real eigenvalues of the matrix\n$L=\\begin{bmatrix}3 & 6 \\\\ -9 & -11\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=\\begin{bmatrix}3-\\lambda  & 6 \\\\ -9 & -11-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(L-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 6 \\\\ -9 & -11-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-11-\\lambda )-6\\cdot (-9) & =0 \\\\ -33-3\\lambda +11\\lambda +{\\lambda }^{2}+54 & =0 \\\\ {\\lambda }^{2}+8\\lambda +21 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={8}^{2}-4\\cdot 1\\cdot 21 \\\\  & =64-84 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $L$ does not have real eigenvalues."} {:db/id #edb/ref 17592186446738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22ccfd10-2e0b-576f-8601-ee2b077cab77" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446644} {:answer/id #uuid "29073a5f-e09c-5fc6-ac4e-971be56c9568" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =-5$" :db/id #edb/ref 17592186446645} {:answer/id #uuid "3a1665e4-efa6-5ed5-bd33-ac9a8949a3fe" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =5$" :db/id #edb/ref 17592186446650} {:answer/id #uuid "7659b379-5d6c-548c-992e-76e7eb504258" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/id #edb/ref 17592186446669} {:answer/id #uuid "edc626a6-c9de-5b6a-9f82-091af50ae152" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ (double root)" :db/id #edb/ref 17592186446707}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446644} :answer-field/id #uuid "6829d208-f258-5b19-bd9a-4cdd3c37dde5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446723}] :question/id #uuid "6ff2d918-34fd-53ce-9a32-6157ad95bf62" :question/math-academy-id "q-36781" :question/problem "Find all real eigenvalues of the matrix\n$U=\\begin{bmatrix}-7 & 5 \\\\ -1 & -7\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $U-\\lambda I:$\n﻿﻿﻿\n\n$$\nU-\\lambda I=\\begin{bmatrix}-7-\\lambda  & 5 \\\\ -1 & -7-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(U-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(U-\\lambda I) & =0 \\\\ \\begin{vmatrix}-7-\\lambda  & 5 \\\\ -1 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (-7-\\lambda )(-7-\\lambda )-5\\cdot (-1) & =0 \\\\ 49+7\\lambda +7\\lambda +{\\lambda }^{2}+5 & =0 \\\\ {\\lambda }^{2}+14\\lambda +54 & =0\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & ={14}^{2}-4\\cdot 1\\cdot 54 \\\\  & =196-216 \\\\  & =-20 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $U$ does not have real eigenvalues."} {:db/id #edb/ref 17592186446740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "731c273b-83ef-5ecf-bca7-30fd9429facb" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =4$" :db/id #edb/ref 17592186446666} {:answer/id #uuid "75cd4420-20f3-5ded-8c44-39d55a82ae27" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-1$" :db/id #edb/ref 17592186446668} {:answer/id #uuid "77ff9bd5-364c-5949-a133-ce7f4bb78ba6" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186446670} {:answer/id #uuid "9c38e99e-6b40-58d6-baca-ae8ea0b40eb1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =6$" :db/id #edb/ref 17592186446684} {:answer/id #uuid "cecd0803-36c1-5916-aeae-507fa6a5a5c6" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446698}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446698} :answer-field/id #uuid "a4615f19-9c7a-5091-99a4-538030c0787d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446728}] :question/id #uuid "86473df3-55aa-5a6b-9f10-9b94fded00fc" :question/math-academy-id "q-106988" :question/problem "Find all real eigenvalues of the matrix\n$Q=\\begin{bmatrix}4 & -9 \\\\ 2 & -3\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}4-\\lambda  & -9 \\\\ 2 & -3-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}4-\\lambda  & -9 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(-3-\\lambda )-2\\cdot (-9) & =0 \\\\ -12-4\\lambda +3\\lambda +{\\lambda }^{2}+18 & =0 \\\\ {\\lambda }^{2}-\\lambda +6 & =0.\\end{aligned}\n$$\n\nComputing the discriminant of the quadratic equation above, we obtain \n\n$$\n\\begin{aligned}D & =(-1)^{2}-4\\cdot 1\\cdot 6 \\\\  & =1-24 \\\\  & =-23 \\\\  & <0.\\end{aligned}\n$$\n\nTherefore, we conclude that the characteristic equation does not have real solutions and therefore $Q$ does not have real eigenvalues."}] :knowledge-point/title "Computing the Eigenvalues of a Matrix With At Most One Distinct Eigenvalue"} {:db/id #edb/ref 17592186092231 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092076 :question/id #uuid "a42d0af8-869c-5c2a-8182-22b14b9546e2" :question/math-academy-id "e-5481" :question/problem "Find all real eigenvalues of the matrix ![](images/9f/9f13c3379e0613ce91669f6e52473dd11dc95360c422943764f30220dbccf430.svg)" :question/worked-solution "Let's start by writing the matrix $A - \\lambda I\\mathbin{:}$\n﻿﻿![](images/03/039ee6073538580614cc07453132b811a4da81f438abf37197bb686057b4b66c.svg)\n\nNow, let's find and solve the characteristic equation $\\det(A-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}10-\\lambda  & 3 \\\\ 6 & 7-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )(7-\\lambda )-3\\cdot 6 & =0 \\\\ 70-7\\lambda -10\\lambda +{\\lambda }^{2}-18 & =0 \\\\ {\\lambda }^{2}-17\\lambda +52 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{17\\pm \\sqrt{(-17)^{2}-4\\cdot 1\\cdot 52}}{2\\cdot 1} \\\\  & =\\frac{17\\pm \\sqrt{81}}{2} \\\\  & =\\frac{17\\pm 9}{2} \\\\  & =13,4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda=13$ and $\\lambda=4.$"} :knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559" :knowledge-point/questions [{:db/id #edb/ref 17592186092529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f340c7bd-03b1-55ed-a932-e14d741e32c6" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186089346} {:answer/id #uuid "0ed1dbe2-a3e9-5879-8b75-623f9f65ab10" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = 3$ (double root)" :db/id #edb/ref 17592186089347} {:answer/id #uuid "147159d4-486d-53bc-86ff-7b0ec6d036fa" :answer/type {:db/ident :answer.type/text} :answer/value "$λ =-7$ and $λ = 2$" :db/id #edb/ref 17592186089348} {:answer/id #uuid "50ea0e7a-7261-519c-bccb-c72664435980" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = 3$ and $λ =-7$" :db/id #edb/ref 17592186089349} {:answer/id #uuid "75c4adb1-026d-56c0-afdb-b0784153666d" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = 7$ and $λ = 3$" :db/id #edb/ref 17592186089350}] :answer-field/id #uuid "3371e534-cf93-5895-9436-a1a1fdcd78fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089345}] :question/id #uuid "02afaa13-fb24-5bea-87a9-22f981ba3717" :question/math-academy-id "q-12299" :question/problem "Find all real eigenvalues of the matrix\n$P = \\begin{bmatrix}-6 & 3 \\\\ 3 & 2\\end{bmatrix}$."} {:db/id #edb/ref 17592186092902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387e4d1f-ffff-549c-ae36-b18c3b2031ab" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186091616} {:answer/id #uuid "0f9c7839-7769-5b9e-b9cb-6a4582448142" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =8$ and $\\lambda =-5$" :db/id #edb/ref 17592186446638} {:answer/id #uuid "86cab0f8-b15d-5ea1-8e36-97308b179e3a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-8$ and  $\\lambda =5$" :db/id #edb/ref 17592186446675} {:answer/id #uuid "c3c98ca9-4231-5356-a04c-0710da85992a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =-5$" :db/id #edb/ref 17592186446692} {:answer/id #uuid "d968872b-bafd-5fbf-be0b-0478c03ae541" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ (double root)" :db/id #edb/ref 17592186446701}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =8$ and $\\lambda =-5$" :db/id #edb/ref 17592186446638} :answer-field/id #uuid "2fc34f16-51f9-5f2d-8f00-589e55c33860" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091612}] :question/id #uuid "4ecc70e1-e461-5246-9098-c27aa6c114e3" :question/math-academy-id "q-9341" :question/problem "Find all real eigenvalues of the matrix \n$A=\\begin{bmatrix}-4 & 2 \\\\ 6 & 7\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-4-\\lambda  & 2 \\\\ 6 & 7-\\lambda \\end{vmatrix} & =0 \\\\ (-4-\\lambda )(7-\\lambda )-2\\cdot 6 & =0 \\\\ -28-7\\lambda +4\\lambda +{\\lambda }^{2}-12 & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{3\\pm \\sqrt{(-3)^{2}+4\\cdot 1\\cdot 40}}{2} \\\\  & =\\frac{3\\pm \\sqrt{169}}{2} \\\\  & =\\frac{3\\pm 13}{2} \\\\  & =8,-5.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =8$ and $\\lambda =-5.$"} {:db/id #edb/ref 17592186253608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070fdb32-1472-515e-90a7-b7eca04d4913" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =-9$" :db/id #edb/ref 17592186250610} {:answer/id #uuid "a7f9142e-ec6a-5db4-bf53-b4b5f41ed070" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-9$ (double root)" :db/id #edb/ref 17592186252000} {:answer/id #uuid "bf5fecbe-8826-5f93-91a8-1a87c27225dd" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =9$" :db/id #edb/ref 17592186252242} {:answer/id #uuid "f168be24-e81a-5f01-8ba3-2fbfe874a9e6" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =-9$" :db/id #edb/ref 17592186252663} {:answer/id #uuid "fb386fae-34fc-5885-8a54-f5b25dd5f4d0" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186252755}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =-9$" :db/id #edb/ref 17592186250610} :answer-field/id #uuid "f6fbb95b-fec0-59e1-80fd-da660864679f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253242}] :question/id #uuid "3afe0de9-b343-5b36-b1d3-181e3380faa7" :question/math-academy-id "q-11984" :question/problem "Find all real eigenvalues of the matrix\n$M=\\begin{bmatrix}-4 & 5 \\\\ 5 & -4\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $M-\\lambda I:$\n﻿﻿﻿\n\n$$\nM-\\lambda I=\\begin{bmatrix}-4-\\lambda  & 5 \\\\ 5 & -4-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(M-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(M-\\lambda I) & =0 \\\\ \\begin{vmatrix}-4-\\lambda  & 5 \\\\ 5 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (-4-\\lambda )(-4-\\lambda )-5\\cdot 5 & =0 \\\\ 16+4\\lambda +4\\lambda +{\\lambda }^{2}-25 & =0 \\\\ {\\lambda }^{2}+8\\lambda -9 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-8\\pm \\sqrt{{8}^{2}+4\\cdot 1\\cdot 9}}{2} \\\\  & =\\frac{-8\\pm \\sqrt{100}}{2} \\\\  & =\\frac{-8\\pm 10}{2} \\\\  & =1,-9.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =1$ and $\\lambda =-9.$"} {:db/id #edb/ref 17592186256754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3df3ec-1125-5bbf-833e-06b9811c8a70" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =2$" :db/id #edb/ref 17592186253915} {:answer/id #uuid "35c849b3-ba48-538b-8146-b45958d48376" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$  (double root)" :db/id #edb/ref 17592186254133} {:answer/id #uuid "7ac2ec77-86f7-5765-9203-29f4055c3628" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186254761} {:answer/id #uuid "81d69d11-e154-5a32-9a10-b7833ac1b59a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-4$" :db/id #edb/ref 17592186254820} {:answer/id #uuid "de0f0cb6-4a3c-55d5-aaa6-e2ad4d3562e7" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-2$" :db/id #edb/ref 17592186255639}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =2$" :db/id #edb/ref 17592186253915} :answer-field/id #uuid "8ec03a8c-c264-5202-8472-a929a797fcef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256184}] :question/id #uuid "d0adf7a1-cd23-5667-b787-5b9256cecb86" :question/math-academy-id "q-12296" :question/problem "Find all real eigenvalues of the matrix\n$S=\\begin{bmatrix}-8 & 4 \\\\ -5 & 4\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $S-\\lambda I:$\n﻿﻿﻿\n\n$$\nS-\\lambda I=\\begin{bmatrix}-8-\\lambda  & 4 \\\\ -5 & 4-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(S-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(S-\\lambda I) & =0 \\\\ \\begin{vmatrix}-8-\\lambda  & 4 \\\\ -5 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (-8-\\lambda )(4-\\lambda )-4\\cdot (-5) & =0 \\\\ -32+8\\lambda -4\\lambda +{\\lambda }^{2}+20 & =0 \\\\ {\\lambda }^{2}+4\\lambda -12 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-4\\pm \\sqrt{{4}^{2}+4\\cdot 1\\cdot 12}}{2} \\\\  & =\\frac{-4\\pm \\sqrt{64}}{2} \\\\  & =\\frac{-4\\pm 8}{2} \\\\  & =-6,2.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-6$ and $\\lambda =2.$"} {:db/id #edb/ref 17592186357549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27ca6789-a24a-5ec2-9232-86bc94dc9daf" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186354999} {:answer/id #uuid "2e864f43-7357-599c-9a27-32f22c394e2c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ (double root)" :db/id #edb/ref 17592186355067} {:answer/id #uuid "31107606-ccb7-5d05-8596-4e5888c1144b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =-9$" :db/id #edb/ref 17592186355094} {:answer/id #uuid "897b443b-8095-5fdd-8fd7-f8556f4d4d9e" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =9$" :db/id #edb/ref 17592186355882} {:answer/id #uuid "bd6f96b4-1d8f-51e8-b377-5e6a706e3f60" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =9$" :db/id #edb/ref 17592186356323}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =9$" :db/id #edb/ref 17592186356323} :answer-field/id #uuid "44285aea-3536-59ba-a136-9c87d9d92638" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357027}] :question/id #uuid "7bbc0e33-82aa-5775-853a-c2bdd5e62b0b" :question/math-academy-id "q-9340" :question/problem "Find all real eigenvalues of the matrix \n$Q=\\begin{bmatrix}2 & 7 \\\\ 7 & 2\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=\\begin{bmatrix}2-\\lambda  & 7 \\\\ 7 & 2-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 7 \\\\ 7 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(2-\\lambda )-7\\cdot 7 & =0 \\\\ 4-2\\lambda -2\\lambda +{\\lambda }^{2}-49 & =0 \\\\ {\\lambda }^{2}-4\\lambda -45 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{4\\pm \\sqrt{(-4)^{2}+4\\cdot 1\\cdot 45}}{2} \\\\  & =\\frac{4\\pm \\sqrt{196}}{2} \\\\  & =\\frac{4\\pm 14}{2} \\\\  & =-5,9.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-5$ and $\\lambda =9.$"} {:db/id #edb/ref 17592186357550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "616d5508-8a25-5988-bb35-0e6edabd52b0" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186355531} {:answer/id #uuid "84cf261d-40c2-521f-8a39-62ae3d4837d1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186355836} {:answer/id #uuid "bbf397ea-4249-5ec0-9158-e941aa14ba00" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\lambda =4$" :db/id #edb/ref 17592186356309} {:answer/id #uuid "d61eee99-b39f-5bb9-952c-e406a93f7b97" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\lambda =-4$" :db/id #edb/ref 17592186356541} {:answer/id #uuid "f8c54bc1-9006-5edf-ad18-da9b6f40136b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\lambda =4$" :db/id #edb/ref 17592186356833}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\lambda =4$" :db/id #edb/ref 17592186356309} :answer-field/id #uuid "e23650fa-a017-55d4-aa2b-e248a6298430" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357322}] :question/id #uuid "b9a0d751-b8e6-598d-8c36-71f74a16fdfb" :question/math-academy-id "q-9348" :question/problem "Find all real eigenvalues of the matrix\n$L=\\begin{bmatrix}2 & 2 \\\\ 5 & -1\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=\\begin{bmatrix}2-\\lambda  & 2 \\\\ 5 & -1-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(L-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 2 \\\\ 5 & -1-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(-1-\\lambda )-5\\cdot 2 & =0 \\\\ -2+\\lambda -2\\lambda +{\\lambda }^{2}-10 & =0 \\\\ {\\lambda }^{2}-\\lambda -12 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{1\\pm \\sqrt{(-1)^{2}+4\\cdot 1\\cdot 12}}{2} \\\\  & =\\frac{1\\pm \\sqrt{49}}{2} \\\\  & =\\frac{1\\pm 7}{2} \\\\  & =-3,4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-3$ and $\\lambda =4.$"} {:db/id #edb/ref 17592186396223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37a54b7a-9e65-545c-8b9e-9040b89f5ca8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =1$" :db/id #edb/ref 17592186396225} {:answer/id #uuid "81520ab9-e8b9-5a20-bd00-4a25e83f3e01" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =-1$" :db/id #edb/ref 17592186396226} {:answer/id #uuid "4fb6f55a-c058-5570-865a-23bfee554e1f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ (double root)" :db/id #edb/ref 17592186396227} {:answer/id #uuid "908b91f8-8c3a-5a25-bd62-a97ade2711a1" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186396228} {:answer/id #uuid "15e52690-bd7d-58e2-8913-93ecfb9fb3db" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/id #edb/ref 17592186396229}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ and $\\lambda =1$" :db/id #edb/ref 17592186396225} :answer-field/id #uuid "a0bc18a7-dabd-5551-97ce-ba2edd3bdab7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396224}] :question/id #uuid "33ca03a0-a8c8-587c-a9fa-20692dfe790c" :question/math-academy-id "q-9347" :question/problem "Find all real eigenvalues of the matrix\n$D=\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $D-\\lambda I:$\n﻿﻿\n\n$$\nD-\\lambda I=\\begin{bmatrix}3-\\lambda  & 2 \\\\ 2 & 3-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(D-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(D-\\lambda I) & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 2 \\\\ 2 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(3-\\lambda )-2\\cdot 2 & =0 \\\\ 9-3\\lambda -3\\lambda +{\\lambda }^{2}-4 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{6\\pm \\sqrt{(-6)^{2}-4\\cdot 1\\cdot 5}}{2} \\\\  & =\\frac{6\\pm \\sqrt{16}}{2} \\\\  & =\\frac{6\\pm 4}{2} \\\\  & =5,1.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =5$ and $\\lambda =1.$"} {:db/id #edb/ref 17592186446732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ee468a0-d352-5289-a776-61c9098a0f54" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446663} {:answer/id #uuid "956a468e-b06e-5bee-8c3c-ec586866b569" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5$ and $\\lambda =-1$" :db/id #edb/ref 17592186446681} {:answer/id #uuid "a173a3e7-290e-5032-aef3-774d0ec21fe5" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5$ (double root)" :db/id #edb/ref 17592186446685} {:answer/id #uuid "d243faea-e0d3-5179-9ed1-a7f88786cefc" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =5$" :db/id #edb/ref 17592186446700} {:answer/id #uuid "fa490009-2047-5aaf-930f-ab551852d4a9" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ (double root)" :db/id #edb/ref 17592186446714}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =5$" :db/id #edb/ref 17592186446700} :answer-field/id #uuid "3b447c11-2343-5e3b-9317-039ab756a40a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446719}] :question/id #uuid "0d05d968-12a6-5808-b925-0cd007f4210b" :question/math-academy-id "q-107982" :question/problem "Find all real eigenvalues of the matrix \n$P=\\begin{bmatrix}1 & 4 \\\\ 2 & 3\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}1-\\lambda  & 4 \\\\ 2 & 3-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 4 \\\\ 2 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(3-\\lambda )-2\\cdot 4 & =0 \\\\ 3-\\lambda -3\\lambda +{\\lambda }^{2}-8 & =0 \\\\ {\\lambda }^{2}-4\\lambda -5 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{4\\pm \\sqrt{(-4)^{2}-4\\cdot 1\\cdot (-5)}}{2\\cdot 1} \\\\  & =\\frac{4\\pm \\sqrt{36}}{2} \\\\  & =\\frac{4\\pm 6}{2} \\\\  & =5,-1.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-1$ and $\\lambda =5.$"} {:db/id #edb/ref 17592186446736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de09d46-850c-56fb-987f-3452a117032d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =2$" :db/id #edb/ref 17592186446642} {:answer/id #uuid "74c14f3c-9cab-5b7a-ac87-feb91e66599f" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446667} {:answer/id #uuid "8eb7b9b2-8faa-570c-b54b-291054c89688" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7$ and $\\lambda =2$" :db/id #edb/ref 17592186446679} {:answer/id #uuid "c805c3e2-c747-567c-9254-772bf262c4ae" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ (double root)" :db/id #edb/ref 17592186446695} {:answer/id #uuid "f57eb3c3-c429-58ea-8bc7-183c23c639f6" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =2$" :db/id #edb/ref 17592186446712}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-7$ and $\\lambda =2$" :db/id #edb/ref 17592186446642} :answer-field/id #uuid "9dde9c69-e4af-5813-b923-f6b3bb4c7cb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446727}] :question/id #uuid "649da0b4-9af9-52b6-817f-cca5e0eb449f" :question/math-academy-id "q-12298" :question/problem "Find all real eigenvalues of the matrix\n$U=\\begin{bmatrix}-2 & 5 \\\\ 4 & -3\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $U-\\lambda I:$\n﻿﻿﻿\n\n$$\nU-\\lambda I=\\begin{bmatrix}-2-\\lambda  & 5 \\\\ 4 & -3-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(U-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(U-\\lambda I) & =0 \\\\ \\begin{vmatrix}-2-\\lambda  & 5 \\\\ 4 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (-2-\\lambda )(-3-\\lambda )-5\\cdot 4 & =0 \\\\ 6+2\\lambda +3\\lambda +{\\lambda }^{2}-20 & =0 \\\\ {\\lambda }^{2}+5\\lambda -14 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-5\\pm \\sqrt{{5}^{2}+4\\cdot 1\\cdot 14}}{2} \\\\  & =\\frac{-5\\pm \\sqrt{81}}{2} \\\\  & =\\frac{-5\\pm 9}{2} \\\\  & =-7,2.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-7$ and $\\lambda =2.$"} {:db/id #edb/ref 17592186446739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b87526d-2246-50c0-91fd-daa6bec84acf" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =3$" :db/id #edb/ref 17592186446647} {:answer/id #uuid "6b480b06-9772-5260-8335-48075d9da61c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ (double root)" :db/id #edb/ref 17592186446662} {:answer/id #uuid "93f12a44-5d1a-5651-a8b8-32b93c9ffdef" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446680} {:answer/id #uuid "b58f6d79-5ae8-55ec-a9dd-9618b7883532" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\lambda =-1$" :db/id #edb/ref 17592186446687} {:answer/id #uuid "e9f8b635-dc16-5331-b1fb-d3f18e1d1de5" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =1$" :db/id #edb/ref 17592186446704}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\lambda =1$" :db/id #edb/ref 17592186446704} :answer-field/id #uuid "4019788e-b3f0-5d69-b057-88ed3798f2cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446720}] :question/id #uuid "7beb1182-833d-5c48-8b2c-88ca021df959" :question/math-academy-id "q-12294" :question/problem "Find all real eigenvalues of the matrix \n$B=\\begin{bmatrix}-8 & 7 \\\\ -9 & 8\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=\\begin{bmatrix}-8-\\lambda  & 7 \\\\ -9 & 8-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ \\begin{vmatrix}-8-\\lambda  & 7 \\\\ -9 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-8-\\lambda )(8-\\lambda )-7\\cdot (-9) & =0 \\\\ -64+8\\lambda -8\\lambda +{\\lambda }^{2}+63 & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-1$ and $\\lambda =1.$"} {:db/id #edb/ref 17592186446742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee3c296-e699-5a89-9d1d-f1037248664d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186446637} {:answer/id #uuid "82038ac4-a96c-5a3c-b35c-2282a0dcbbe1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$  (double root)" :db/id #edb/ref 17592186446672} {:answer/id #uuid "b88cc7bb-ae8f-5c80-a43e-0886bc245383" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =4$" :db/id #edb/ref 17592186446688} {:answer/id #uuid "beb9ae44-9c2f-5ff1-949c-f0430bfe2729" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =4$" :db/id #edb/ref 17592186446690} {:answer/id #uuid "c7d63c00-47c6-5ea0-81b5-0ff89c996117" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-4$" :db/id #edb/ref 17592186446694}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-6$ and $\\lambda =-4$" :db/id #edb/ref 17592186446694} :answer-field/id #uuid "72630b4f-5b3f-5c7f-b8aa-ef29d3000b9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446725}] :question/id #uuid "95ae8df3-3e3d-5382-b3db-f47a4094753f" :question/math-academy-id "q-12293" :question/problem "Find all real eigenvalues of the matrix \n$P=\\begin{bmatrix}-5 & 1 \\\\ 1 & -5\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=\\begin{bmatrix}-5-\\lambda  & 1 \\\\ 1 & -5-\\lambda \\end{bmatrix}.\n$$\n\nNow, let's find and solve the characteristic equation $det(P-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ \\begin{vmatrix}-5-\\lambda  & 1 \\\\ 1 & -5-\\lambda \\end{vmatrix} & =0 \\\\ (-5-\\lambda )(-5-\\lambda )-1\\cdot 1 & =0 \\\\ 25+5\\lambda +5\\lambda +{\\lambda }^{2}-1 & =0 \\\\ {\\lambda }^{2}+10\\lambda +24 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-10\\pm \\sqrt{{10}^{2}-4\\cdot 1\\cdot 24}}{2} \\\\  & =\\frac{-10\\pm \\sqrt{4}}{2} \\\\  & =\\frac{-10\\pm 2}{2} \\\\  & =-6,-4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-6$ and $\\lambda =-4.$"}] :knowledge-point/title "Computing the Eigenvalues of a Matrix With Two Distinct Eigenvalues"} {:db/id #edb/ref 17592186092232 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092077 :question/id #uuid "9e40836e-18e9-5df6-a930-05875b920335" :question/math-academy-id "e-5482" :question/problem "Find all real eigenvalues of the matrix ![](images/e3/e34b5bf690a1dd8f5275f2d742b264494386b95394bc7c32aaafb9eeba68e058.svg)" :question/worked-solution "Let's start by writing the matrix $A - \\lambda I \\mathbin{:}$\n﻿﻿﻿![](images/37/37f547d6ad345415a1cc2480adf227ec29e31a351cf935e584b9544e44347310.svg)\n\nNow, let's find and solve the characteristic equation $\\det (A - \\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 0 \\\\ 9 & -2\\sqrt{3}-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(-2\\sqrt{3}-\\lambda )-9\\cdot 0 & =0 \\\\ (\\lambda -3)(\\lambda +2\\sqrt{3}) & =0\\end{aligned}\n$$\n\nSo, we get the eigenvalues $\\lambda={\\color{red}3}$ and $\\lambda={\\color{blue}-2\\sqrt{3}}.$\n\nIf we look again at the matrix ![](images/f4/f4e86a797cafe4857d5f135ec37d57e33368469767e50793f55b89ec7185c2eb.svg)\nwe see that the eigenvalues are the entries on the main diagonal. This is true in general: the eigenvalues of a *triangular* or *diagonal* matrix are *always* given by the entries on the main diagonal!\n\n**Watch out!** For a general matrix (which is neither triangular nor diagonal), this might not be the case!"} :knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/questions [{:db/id #edb/ref 17592186092516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cbcb05c-0d49-5cbd-80eb-6b804f107249" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = \\sqrt{3}$ and $λ = 2$" :db/id #edb/ref 17592186089268} {:answer/id #uuid "0a494e60-093c-58c4-a59c-aa2a3b60e7e3" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186089269} {:answer/id #uuid "323c248b-e18e-5611-b08d-9631fd900654" :answer/type {:db/ident :answer.type/text} :answer/value "$λ =-2$ and $λ = \\sqrt{3}$" :db/id #edb/ref 17592186089270} {:answer/id #uuid "479da784-7457-5ebe-ab3e-66bcab6eacf4" :answer/type {:db/ident :answer.type/text} :answer/value "$λ =-2$ and $λ =-\\sqrt{3}$" :db/id #edb/ref 17592186089271} {:answer/id #uuid "5016ca94-d6c8-5940-9a53-df997f015259" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = 4$ (double root)" :db/id #edb/ref 17592186089272}] :answer-field/id #uuid "aed5cf4f-5cf4-5caf-81e8-f22caef29322" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089267} {:answer-field/choices [{:answer/id #uuid "403a1993-2eb3-586b-abbd-dfbb80940fae" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186395986} {:answer/id #uuid "b8a6ca2d-3dc9-5356-a637-77388249f113" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =-\\sqrt{3}$" :db/id #edb/ref 17592186395987} {:answer/id #uuid "21c5c9ca-97c8-5152-9b6c-25a5632a907d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{3}$ and $\\lambda =2$" :db/id #edb/ref 17592186395988} {:answer/id #uuid "87da898e-ea6a-541f-9651-68144afb0f0f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =\\sqrt{3}$" :db/id #edb/ref 17592186395989} {:answer/id #uuid "46e8370f-0146-536e-a75f-2dc4592b1276" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186395990}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{3}$ and $\\lambda =2$" :db/id #edb/ref 17592186395988} :answer-field/id #uuid "b1ec3bb9-10bd-5719-b579-dd5c85d65b96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395985}] :question/id #uuid "b1fb4b20-223a-5224-b15e-06a76416065c" :question/math-academy-id "q-11983" :question/problem "Find all real eigenvalues of the matrix\n$A=\\begin{bmatrix}\\sqrt{3} & 0 \\\\ 4 & 2\\end{bmatrix}.$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=\\begin{bmatrix}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{bmatrix}\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (\\sqrt{3}-\\lambda )(2-\\lambda )-0\\cdot 4 & =0 \\\\ (\\lambda -\\sqrt{3})(\\lambda -2) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\sqrt{3}$ and $\\lambda =2.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."} {:db/id #edb/ref 17592186092688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf9d3fa7-5b4c-5f8b-bc90-c19e5bef9ea8" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = \\sqrt{2}$ and $λ = 0$" :db/id #edb/ref 17592186090329} {:answer/id #uuid "e5801894-9c11-5544-9b15-5fcc79a2ea9b" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = 0$ (double root)" :db/id #edb/ref 17592186090330} {:answer/id #uuid "ea55fab5-1f86-5407-bfc5-ffde73de4e22" :answer/type {:db/ident :answer.type/text} :answer/value "$λ =-\\sqrt{2}$ and $λ = \\sqrt{3}$" :db/id #edb/ref 17592186090331} {:answer/id #uuid "23e6e938-3d0a-517b-a1ef-31d13b0c4767" :answer/type {:db/ident :answer.type/text} :answer/value "$λ = \\sqrt{2}$ and $λ =-\\sqrt{3}$" :db/id #edb/ref 17592186090332} {:answer/id #uuid "3a306770-d910-5cf6-a14a-4f747c2f5f1d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186090333}] :answer-field/id #uuid "aedce133-20db-5976-a22f-55b178daf606" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090328}] :question/id #uuid "c135dbca-fe3a-5a71-9515-27c168425dfd" :question/math-academy-id "q-36755" :question/problem "Find all real eigenvalues of the matrix\n$C = \\begin{bmatrix}\\sqrt{2} & 0 \\\\ 0 & -\\sqrt{3}\\end{bmatrix}$."} {:db/id #edb/ref 17592186243993 