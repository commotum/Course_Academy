d.type/radio} :db/id #edb/ref 17592186323360}] :question/id #uuid "828025a7-8e36-5624-b951-a72497529e70" :question/math-academy-id "q-36771" :question/problem "Find the characteristic equation of the matrix \n$D=\\begin{bmatrix}5 & -5 \\\\ 4 & -7\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,D-\\lambda I:$\n﻿﻿﻿\n\n$$\nD-\\lambda I=\\begin{bmatrix}5-\\lambda  & -5 \\\\ 4 & -7-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is \n\n$$\n\\begin{aligned}det(D-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & -5 \\\\ 4 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(-7-\\lambda )-(-5)\\cdot 4 & =0 \\\\ -35-5\\lambda +7\\lambda +{\\lambda }^{2}+20 & =0 \\\\ {\\lambda }^{2}+2\\lambda -15 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017805c8-48bf-57dc-b09d-74e6b2bfba19" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}-\\lambda +7=0" :db/id #edb/ref 17592186342261} {:answer/id #uuid "0253286d-2396-5b34-9595-0ead6ef0024f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda -7=0" :db/id #edb/ref 17592186342270} {:answer/id #uuid "280e0be4-002f-5ca8-8806-210888ed4e42" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+\\lambda +9=0" :db/id #edb/ref 17592186342575} {:answer/id #uuid "51f8ce86-0ab7-5721-9391-a78b021fdf9a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+3\\lambda -7=0" :db/id #edb/ref 17592186342919} {:answer/id #uuid "c8b8ea00-14c7-5b3b-bd85-fef87b049b3a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+3\\lambda -9=0" :db/id #edb/ref 17592186343999}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }^{2}+3\\lambda -7=0" :db/id #edb/ref 17592186342919} :answer-field/id #uuid "aca482a3-c452-5901-a487-b7d812b9aa8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344796}] :question/id #uuid "3d955282-7504-58a3-b804-21dff055f0dc" :question/math-academy-id "q-76343" :question/problem "Find the characteristic equation of the matrix $N=\\begin{bmatrix}-2 & 3 \\\\ 3 & -1\\end{bmatrix}.$" :question/worked-solution "First, we find the matrix $\\,N-\\lambda I:$\n﻿﻿﻿\n\n$$\nN-\\lambda I=\\begin{bmatrix}-2-\\lambda  & 3 \\\\ 3 & -1-\\lambda \\end{bmatrix}.\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(N-\\lambda I) & =0 \\\\ \\begin{vmatrix}-2-\\lambda  & 3 \\\\ 3 & -1-\\lambda \\end{vmatrix} & =0 \\\\ (-2-\\lambda )(-1-\\lambda )-3\\cdot 3 & =0 \\\\ 2+2\\lambda +\\lambda +{\\lambda }^{2}-9 & =0 \\\\ {\\lambda }^{2}+3\\lambda -7 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186426473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579836b-928d-5630-a28f-d0c7c7253871" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}-\\lambda )(3+\\lambda )=0" :db/id #edb/ref 17592186426441} {:answer/id #uuid "9013b695-47d7-5345-8e34-adeef9ec45a5" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}-\\lambda )(3-\\lambda )=0" :db/id #edb/ref 17592186426450} {:answer/id #uuid "a6fcae26-6730-5f46-b148-3f49f85151c6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}+\\lambda )(3+\\lambda )=0" :db/id #edb/ref 17592186426455} {:answer/id #uuid "cd6c3991-2598-5cbe-9812-a3bee7a1a7b9" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}-\\lambda )(3+\\lambda )=3\\sqrt{5}" :db/id #edb/ref 17592186426457} {:answer/id #uuid "ee2114a5-18f4-5f18-bee2-e633eb8f49ce" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}-\\lambda )(3-\\lambda )=3\\sqrt{5}" :db/id #edb/ref 17592186426463}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}-\\lambda )(3+\\lambda )=0" :db/id #edb/ref 17592186426441} :answer-field/id #uuid "a6f044b9-2809-589e-a7