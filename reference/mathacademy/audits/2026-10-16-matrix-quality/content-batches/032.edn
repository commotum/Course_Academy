 & -1\\end{bmatrix}\\begin{bmatrix}4 & 2 & 1 \\\\ -3 & -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -2 & -1 \\\\ 3 & 2 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,3),(-2,2),(-1,-3).$\n\nSo, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186278320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5b2ba9-1bfe-57b5-9caf-c99e7cd00766" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465315} {:answer/id #uuid "0e47c71f-651b-5dab-adbd-31cee6b0d544" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465316}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465315} :answer-field/id #uuid "81d1cd43-a1b8-500d-ac08-e5f0fb4d4fe8" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466501} {:answer-field/choices [{:answer/id #uuid "96cce611-53f4-585e-abe8-9b124fe8324e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465317} {:answer/id #uuid "6aae8e41-20a4-5fa6-a286-626b3ae6f630" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465318}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465318} :answer-field/id #uuid "b37cfc2c-cedf-5629-9c08-1c82f0317e43" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466502} {:answer-field/choices [{:answer/id #uuid "8081da32-5615-591d-a668-9527b67107cc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465319} {:answer/id #uuid "7537192a-f28a-5528-8449-0c72e08da197" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465320}] :answer-field/correct {:answer/type {:db/iden