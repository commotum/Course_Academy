bmatrix}=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/f1/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n \n\n![](images/26/266af89426f86d22bc634a231c46a5ad89be14d06bc300a5fa20597998c826fd.png)"} {:db/id #edb/ref 17592186389049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8867d91-bcda-5489-8280-49d891cc31ab" :answer/type {:db/ident :answer.type/image} :answer/value "images/ea/ead70b80d9256e1211addc404613f2dfe4a19baf822cbd77f429572ffc9a3a6d.png" :db/id #edb/ref 17592186389051} {:answer/id #uuid "48a91081-fad4-5761-a448-423550b39ed7" :answer/type {:db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} {:answer/id #uuid "3faab04f-ba07-5e75-a43f-8198da358c66" :answer/type {:db/ident :answer.type/image} :answer/value "images/5a/5a1923eec2b66ef4eb861ec42b00ea48a3285aaaf3255c42d12c001c9cde32f8.png" :db/id #edb/ref 17592186389053} {:answer/id #uuid "fe51163e-7d12-5501-9934-728d90d9412d" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/09b2ae9333118de0621a5f29610b6a83689fadaeb9c05e7a30b2799b12a1bd58.png" :db/id #edb/ref 17592186389054} {:answer/id #uuid "7c87cd81-f329-516d-8bf5-dc6b1dc8dca3" :answer/type {:db/ident :answer.type/image} :answer/value "images/23/23f63717c8d356c698137359824112511b0bbd5ec04c59e47d22500d842d03b6.png" :db/id #edb/ref 17592186389055}] :answer-field/correct {:answer/type {:db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} :answer-field/id #uuid "328c6cdb-dc56-550a-b1a6-60351bc4df59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389050}] :question/id #uuid "04e79ef7-7090-527f-95f0-0f13ae5b3650" :question/math-academy-id "q-160627" :question/problem "![](images/0b/0bd98626bc49cc3c58e503d5a7373b6af0fcce721cfdf82ff372eaa57d157dda.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Consider the standard basis $\\{i,j\\}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of $\\{i,j\\}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}=-j \\\\ {j}^{′} & =Aj=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/77/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](images/d5/d5ff1c1a7c99b08d04d2ac58d9f8195ee29c8b564873a9abfb2635e93cec1968.png)"} {:db/id #edb/ref 17592186394270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcbf67f7-3f48-58b0-b313-1ddf0a908258" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b66fd6bb3e9b37fd3a72927a1fb4df87eaffea3bf5579e681fee3aeda4885e75.png" :db/id #edb/ref 17592186394272} {:answer/id #uuid "8d294a24-e87b-5b66-a362-f26102dab0e0" :answer/type {:db/ident :answer.type/image} :answer/value "images/aa/aa78e1ab38afbc0cd7bf92061d176a816c7a8a0e1d08c8825486c45dbe8fb5f5.png" :db/id #edb/ref 17592186394273} {:answer/id #uuid "4b69504f-e2