egin{bmatrix}2 & 3 & -4 \\\\ -3 & 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 1 & -1 \\\\ -2 & -3 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,-2),(1,-3),(-1,4).$\n\nSo, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186278331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebab737c-3e75-5b8f-b989-c0713c607418" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465339} {:answer/id #uuid "2d0ea619-2a3d-580d-bb55-d89ecb4be6fc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465340}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465339} :answer-field/id #uuid "d655662a-7f8e-5f35-b0ef-dd409f006042" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466513} {:answer-field/choices [{:answer/id #uuid "fc1ef610-f738-5115-9fe4-3b92fa8e8065" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465341} {:answer/id #uuid "9cac5e6d-2492-55e9-abf4-39626be79db0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465342}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465342} :answer-field/id #uuid "93513d5a-1460-5f17-a948-63b2339af984" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466514} {:answer-field/choices [{:answer/id #uuid "9f99862a-ed36-5f79-9c6a-ae70685ef153" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465343} {:answer/id #uuid "4b5d9f00-532a-54ab-a6ea-7764cdcabed3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465344}] :answer-field/correct {:answer/type {:db/ident :answer.type/text}