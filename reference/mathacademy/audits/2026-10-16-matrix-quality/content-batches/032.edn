f}^{′}(x) & ={3}^{x}\\operatorname{ln}⁡3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{2}(1)) & =\\begin{bmatrix}f(1) & {f}^{′}(1) \\\\ 0 & f(1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{3}^{1} & {3}^{1}\\cdot \\operatorname{ln}⁡3 \\\\ 0 & {3}^{1}\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 3\\operatorname{ln}⁡3 \\\\ 0 & 3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292553 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2f1d491-225c-5354-b01a-3fe0a4aad742" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291655}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291655} :answer-field/id #uuid "11d4fb62-cf49-508f-bbd2-0f1c686de796" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291795} {:answer-field/choices [{:answer/id #uuid "84672947-c399-56e2-9a96-16bb2c7b73ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186291196}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186291196} :answer-field/id #uuid "2106af4e-4319-513e-8649-c2fd2737f5ad" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291857} {:answer-field/choices [{:answer/id #uuid "91fac1aa-46fd-52fd-a751-30b8c7cb2c89" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291259}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291259} :answer-field/id #uuid "44130793-c76f-5a80-a4d6-ae5a1eededae" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291956} {:answer-field/choices [{:answer/id #uuid "3662eafb-bb6d-5e53-a712-d8a28ebffb7d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290855}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186290855} :answer-field/id #uuid "de72ad53-2ef6-5032-830e-e8f6f99c77d9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292429}] :question/id #uuid "4a7995b0-8edf-54fd-bba8-6bdd314549ce" :question/math-academy-id "q-253400" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $-3$ | $0$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\operatorname{cos}⁡(3{J}_{4}(\\frac{\\pi }{6}))=\\,\\,$ |  | $0$ | $0$ | {{field-3}} | $0$ |  |\n|  | $0$ | $0$ | $0$ | $-3$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-4}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nIn this case, we have $f(x)=\\operatorname{cos}⁡3x,$ $n=4,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=4,$ we need to compute the first $4-1=3$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡(3x) \\\\ {f}^{′}(x) & =-3\\operatorname{sin}⁡(3x) \\\\ {f}^{″}(x) & =-9\\operatorname{cos}⁡(3x) \\\\ {f}^{‴}(x) & =27\\operatorname{sin}⁡(3x)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{4}(\\frac{\\pi }{6})) & =\\begin{bmatrix}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) & \\frac{1}{3!}{f}^{‴}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{6}) \\\\ 0 & 0 & f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & 0 & 0 & f(\\frac{\\pi }{6})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) & \\frac{9}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\text{ } \\\\ 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) & -\\frac{9}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2}) & -3\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ 0 & 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -3 & 0 & \\frac{9}{2} \\\\ 0 & 0 & -3 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b8ce02-aaab-5ed9-a96f-7d40074b31ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186290920}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186290920} :answer-field/id #uuid "07b17775-671b-5ea5-97b5-f4b7681f97e9" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291759} {:answer-field/choices [{:answer/id #uuid "01370c93-bf95-5d2c-a046-0b3bed9e537d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186290645}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186290645} :answer-field/id #uuid "18639552-5880-510d-bf1b-3ca4bdd652b7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291826} {:answer-field/choices [{:answer/id #uuid "e7675497-5399-5ef0-b4aa-c1db3f8dfe0e" :answer/type {:db/ident :answer.typ