5739af35c3a8acfaa4d4e6f469b3e50afe69b96990e39.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](images/57/578b3315028bf5a19a4b6e17d228db08b41f24dee63e5cb7f8d601ce667785f4.png)"} {:db/id #edb/ref 17592186394277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f49ed28e-978a-55fd-bd7b-2df17c569b23" :answer/type {:db/ident :answer.type/image} :answer/value "images/b4/b4e5acb557d1b4fefa77f644d675723c84d5fa103888a6cb6b04372a57189c73.png" :db/id #edb/ref 17592186394279} {:answer/id #uuid "b72e224a-08da-52bd-9018-a7f3d9c843e2" :answer/type {:db/ident :answer.type/image} :answer/value "images/d1/d187f89ab21a36c6709422c48263541df1acc8568d436614502c001cf576b426.png" :db/id #edb/ref 17592186394280} {:answer/id #uuid "42ab01c3-3fc2-5b66-bdb6-a0ce03097a8f" :answer/type {:db/ident :answer.type/image} :answer/value "images/0d/0d1ea82168dc6a122d1b20ad568b8958af496fc963edfb5e789bf57fc9108624.png" :db/id #edb/ref 17592186394281} {:answer/id #uuid "c4919a5c-5a7e-5cd3-86bc-b374d49c6330" :answer/type {:db/ident :answer.type/image} :answer/value "images/97/979157d993a86617fabf4b2dfacc6d4c1d973885b42be081b4bcffb36058e091.png" :db/id #edb/ref 17592186394282} {:answer/id #uuid "403fab31-f71b-56cc-8174-fc9692f29b7f" :answer/type {:db/ident :answer.type/image} :answer/value "images/4b/4bf42e3bdeb61feccd68cf4eeb9e3c4a40e8b903a5739df77c993e9aa4abc993.png" :db/id #edb/ref 17592186394283}] :answer-field/correct {:answer/type {:db/ident :answer.type/image} :answer/value "images/b4/b4e5acb557d1b4fefa77f644d675723c84d5fa103888a6cb6b04372a57189c73.png" :db/id #edb/ref 17592186394279} :answer-field/id #uuid "df5fef47-9715-5751-a827-65804bfea511" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394278}] :question/id #u