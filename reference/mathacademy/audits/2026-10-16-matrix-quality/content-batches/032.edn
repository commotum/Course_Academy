\pi )\\end{bmatrix}=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157699 :question/answer-fields [{:answer-field/id #uuid "ad9af26e-ea05-5b01-b0c6-461b3d696b89" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154706} {:answer-field/id #uuid "274760f0-1d01-519a-8d6d-b8c4e32ecdb4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154707} {:answer-field/id #uuid "2d524776-5ac5-59c2-8a04-19f14ce85f22" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154708} {:answer-field/id #uuid "30d76250-759d-5354-acac-dca758871629" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154709} {:answer-field/id #uuid "3965c9a6-fee0-5240-964e-9944af5228e4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154710} {:answer-field/id #uuid "575a5c2b-acf3-5d18-ac51-44a941367002" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186154711}] :question/id #uuid "bae82a4f-7a13-5026-a1d3-47bd0b285bb2" :question/math-academy-id "q-253242" :question/problem "Given that\n$D = \\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 0 & -12 & 0 & 0 \\\\ 0 & 0 & 9 & 0 \\\\ 0 & 0 & 0 & 21\\end{bmatrix}$,\nfind $2^{D/3}$.\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} | $0$ |  |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $2^{D/2} =$ |  | $0$ | {{field-4}} | $0$ | $0$ |  |\n|  | $0$ | $0$ | {{field-5}} | $0$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-6}} |  |"} {:db/id #edb/ref 17592186292544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d78c3c23-c322-5a1e-93f2-43e40bf33302" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291533}] :answer-fie