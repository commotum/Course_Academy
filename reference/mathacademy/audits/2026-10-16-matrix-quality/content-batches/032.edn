{2!} \\\\ 0 & f(1) & {f}^{′}(1) \\\\ 0 & 0 & f(1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}e & e & \\frac{e}{2} \\\\ 0 & e & e \\\\ 0 & 0 & e\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186414006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f52e38a-24e3-5e4b-ac01-1a4c1fa10cf8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186413971}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186413971} :answer-field/id #uuid "093ddcaf-e7d3-52fa-b839-ddb952fa312d" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413983} {:answer-field/choices [{:answer/id #uuid "6955b1a9-a439-57c6-9b26-fa5bc116e904" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2" :db/id #edb/ref 17592186413965}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2" :db/id #edb/ref 17592186413965} :answer-field/id #uuid "3e2ad92d-90c5-5fb3-835e-78716fc2952e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413987} {:answer-field/choices [{:answer/id #uuid "9ac63b60-993d-5f75-a07c-b064fe44237b" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2" :db/id #edb/ref 17592186413975}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\ln 2" :db/id #edb/ref 17592186413975} :answer-field/id #uuid "5cd3c5e6-c84b-55d0-9b74-8cf6164e62a1" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413989} {:answer-field/choices [{:answer/id #uuid "e81f2645-ea93-5b69-8f12-9506be78d784" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186413982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186413982} :answ