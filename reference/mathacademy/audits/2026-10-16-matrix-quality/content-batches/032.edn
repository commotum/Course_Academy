 :answer-field.type/radio} :db/id #edb/ref 17592186386323}] :question/id #uuid "90d77503-0508-58ca-9f96-9ade71955fc1" :question/math-academy-id "q-108984" :question/problem "${J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(7)$ represents a $1\\times 1$ Jordan block with $7$'s on the leading diagonal,\n\n- ${J}_{1}(-1)$ represents a $1\\times 1$ Jordan block with $-1$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(7)=\\begin{bmatrix}7\\end{bmatrix},\\,{J}_{1}(-1)=\\begin{bmatrix}-1\\end{bmatrix}.\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=\\begin{bmatrix}7 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186386350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f7fbcbb-8bd9-5ade-b398-ca47e80a82e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 & 0 \\\\ 0 & 6 & 1 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386352} {:answer/id #uuid "961df242-abdb-58eb-8926-b42833dabb0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 & 0 \\\\ 0 & -4 & 1 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386353} {:answer/id #uuid "0c2b072c-8eb0-5f3d-a914-ca569ea2f77c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386354} {:answer/id #uuid "35ac030f-b2be-5171-8576-61e8d3f51624" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386355} {:answer/id #uuid "cf03acad-0363-5e23-a615-45af96d7d677" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 & 0 \\\\ 0 & 6 & 1 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386356}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186386355} :answer-field/id #uuid "233410d4-280f-56ce-a630-00c4323a1919" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386351}] :question/id #uuid "3453f0f1-3761-5d09-8029-f41d61e8a4aa" :question/math-academy-id "q-109061" :question/problem "${J}_{2}(-4)\\,⊕\\,{J}_{1}(6)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{2}(-4)$ represents a $2\\times 2$ Jordan block with $-4$'s on the leading diagonal.\n\n- ${J}_{1}(6)$ represents a $1\\times 1$ Jordan block with $6$'s on the leading diagonal,\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{2}(-4)=\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix},\\,{J}_{1}(6)=\\begin{bmatrix}6\\end{bmatrix}.\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{2}(-4)\\,⊕\\,{J}_{1}(6)=\\begin{bmatrix}-4 & 1 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186420750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17fdc9db-a108-524c-b263-d619b7128c84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186420720} {:answer/id #uuid "5db22639-73a7-5cfe-9009-d855d472def2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 1 & 0 \\\\ 0 & 9 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186420732} {:answer/id #uuid "a3ff2a73-b7e5-5155-a809-9b12b320a062" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186420738} {:answer/id #uuid "c31d7a77-cdc2-56ac-a580-83cba32888e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 1 & 0 \\\\ 0 & 9 & 1 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #