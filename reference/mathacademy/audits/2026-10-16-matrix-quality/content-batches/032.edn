:answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413980}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413980} :answer-field/id #uuid "e5c61432-7357-5400-9143-63f15ef64c3f" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186414002}] :question/id #uuid "7819c8fe-793f-5300-ba05-a00d3d72cc5c" :question/math-academy-id "q-253884" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $0$ | $0$ | $0$ |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))}=\\,\\,$ |  | $0$ | {{field-2}} | {{field-3}} | $\\frac{1}{2}$ |  |\n|  | $0$ | $0$ | {{field-4}} | {{field-5}} |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-6}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{(\\begin{bmatrix}{J}_{1}(3) & 0 \\\\ 0 & {J}_{3}(0)\\end{bmatrix})} \\\\  & =\\begin{bmatrix}{e}^{({J}_{1}(3))} & 0 \\\\ 0 & {e}^{({J}_{3}(0))}\\end{bmatrix} \\\\  & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))}.\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{1}(3),$ we have $n=1$ and $\\lambda =3.$ since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(3)) & =\\begin{bmatrix}f(3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3}\\end{bmatrix} \\\\ .\\end{aligned}\n$$\n\n- For ${J}_{3}(0),$ we have $n=3$ and $\\lambda =2.$ \\since $n=3,$ we need to compute the first and second derivatives of $f$ only:\n\n$$\n\\begin{aligned}f(x) & ={e}^{x} \\\\ {f}^{′}(x) & ={e}^{x} \\\\ {f}^{″}(x) & ={e}^{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{3}(0)) & =\\begin{bmatrix}f(0) & {f}^{′}(0) & \\frac{{f}^{″}(0)}{2} \\\\ 0 & f(0) & {f}^{′}(0) \\\\ 0 & 0 & f(0)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{0} & {e}^{0} & \\frac{{e}^{0}}{2} \\\\ 0 & {e}^{0} & {e}^{0} \\\\ 0 & 0 & {e}^{0}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & \\frac{1}{2} \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))} \\\\  & =\\begin{bmatrix}{e}^{3} & 0 & 0 & 0 \\\\ 0 & 1 & 1 & \\frac{1}{2} \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea0401e5-9d3a-57a5-b046-48a14ed96f7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186562164}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186562164} :answer-field/id #uuid "250a0410-56cf-50a6-9de1-7caaa7d5a608" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562244} {:answer-field/choices [{:answer/id #uuid "aa32fab1-7f40-54da-a1e0-f1997cc223c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186562007}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186562007} :answer-field/id #uuid "8a725e18-61fa-5fa6-82d0-ff96754212ab" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562313} {:answer-field/choices [{:answer/id #uuid "9841f45c-6a19-51eb-88e2-92efb70ca08d" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186561957}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186561957} :answer-field/id #uuid "bc31d784-bb6f-5691-9bf1-b7d09bc77e17" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562342} {:answer-field/choices [{:answer/id #uuid "b8b8037b-0482-5919-b25b-6c561eb8d3a4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186562050}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186562050} :answer-field/id #uuid "c78abd9f-d0b3-531a-96cd-b8ea8b5d6311" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562349} {:answer-field/choices [{:answer/id #uuid "83d08973-12e3-5a13-bcc4-7e7a8399498d" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186561912}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186561912} :answer-field/id #uuid "d18814a4-c3b7-50c0-86f8-c7a6e058383a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186562356}] :question/id #uuid "59f14881-731e-52d2-9146-dab6e581e8a4" :question/math-academy-id "q-253868" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | {{field-2}} | $0$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2))=\\,\\,$ |  | $0$ | {{field-3}} | {{field-4}} |  |\n|  |  | $0$ | $0$ | {{field-5}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡([\\begin{aligned}{J}_{2}(2) & 0 \\\\ 0 & {J}_{1}(2)\\end{aligned}]) \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)) & 0 \\\\ 0 & \\operatorname{ln}⁡({J}_{1}(2))\\end{aligned}] \\\\  & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)).\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{2}(2),$ we have $n=2$ and $\\lambda =2.$ \\since $n=2,$ we need to compute the first derivative of $f$ only:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡x \\\\ {f}^{′}(x) & =\\frac{1}{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{2}(2)) & =[\\begin{aligned}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡(2) & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2 & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$\n\n- For ${J}_{1}(2),$ we have $n=1$ and $\\lambda =1.$ \\since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(2)) & =[\\begin{aligned}f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)) \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2 & \\frac{1}{2} & 0 \\\\ 0 & \\operatorname{ln}⁡2 & 0 \\\\ 0 & 0 & \\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Value of a Function of a Jordan Matrix"} {:db/id #edb/ref 17592186157271 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157038 :question/id #uuid "6b751a5e-56c2-5ef0-a640-b77793aa1a72" :question/math-academy-id "e-16517" :question/problem "Consider the following matrices:\n\n![](images/17/17b4d68be43e4a4eb895ebbe623b713f1a808153424dd221b7497579d666b00a.png)\n\nGiven that $V = PJP^{-1},$ find $\\sin\\left(\\pi V\\right).$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SAS^{-1}) = S \\cdot f(A) \\cdot S^{-1}.\n$$\n\nFor $f(x) = \\sin(\\pi x)$ and the given matrix $V,$ we have\n\n$$\n\\sin(\\pi V) = \\sin\\left(\\pi{PJP^{-1}}\\right) = P \\cdot (\\sin(\\pi J)) \\cdot P^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $-3$s on the main diagonal, we have\n\n![](images/a8/a8ad3d4a15a5a8e7307fdd6449d8086d6c9c7e656caea877d41f021c7d8584cc.png)\n\nThe derivative of $f$ is $f'(x) = \\pi \\cos \\pi x.$ So, we get\n\n![](images/9a/9af57a3b00b9c9e64508c119ae77690904bdb8c30b124b8165d4280149361bad.png)\n\nAlso, the inverse of $P$ is\n\n![](images/ff/ff9333784a9cdd38f510398b48e485764eac400f56c2cc9f2f1a18e5138845d8.png)\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\pi V) & =P\\cdot (\\operatorname{sin}⁡(\\pi J))\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & -\\pi  \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}\\pi  & -\\pi  \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\pi  & -\\pi  \\\\ \\pi  & -\\pi \\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "706303c1-0e4c-55f7-8b62-5094938f85bc" :knowledge-point/questions [{:db/id #edb/ref 17592186157693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91f3c3cb-38af-5957-8dea-8eae4d134ae8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\ln 2 & \\ln 2 \\\\ -\\ln 2 & \\ln 2\\end{bmatrix}" :db/id #edb/ref 17592186154675} {:answer/id #uuid "9703a352-abb5-5214-8d92-0f1c7b042279" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\ln 2 & 2\\ln 2 \\\\ -\\ln 2 & 2\\ln 2\\end{bmatrix}" :db/id #edb/ref 17592186154676} {:answer/id #uuid "efd73ef6-30bf-5ee8-aa16-537deaa0d1ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\ln 2 & -\\ln 2 \\\\ 2\\ln 2 & -\\ln 2\\end{bmatrix}" :db/id #edb/ref 17592186154677} {:answer/id #uuid "0ce9b349-8431-5a1f-94a0-03651f7b6410" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\ln 2 & \\ln 2 \\\\ 2\\ln 2 & \\ln 2\\end{bmatrix}" :db/id #edb/ref 17592186154678} {:answer/id #uuid "4c43b8dc-1205-53eb-9f71-8e34b80b98f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\ln 2 & 2\\ln 2 \\\\ \\ln 2 & 2\\ln 2\\end{bmatrix}" :db/id #edb/ref 17592186154679}] :answer-field/id #uuid "053f5192-7432-57e1-b46b-11a36300b300" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186154674} {:answer-field/choices [{:answer/id #uuid "c07db4b9-ac89-59f7-9d33-9dfb4e0ed947" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{ln}⁡2 & -\\operatorname{ln}⁡2 \\\\ 2\\operatorname{ln}⁡2 & -\\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390459} {:answer/id #uuid "f0baa69d-2278-57c4-b35a-4be6001576c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{ln}⁡2 & \\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡2 & \\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390460} {:answer/id #uuid "4d81d875-d6cf-5cd5-bc0d-5a4f7e51ad2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{ln}⁡2 & \\operatorname{ln}⁡2 \\\\ 2\\operatorname{ln}⁡2 & \\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390461} {:answer/id #uuid "c7187480-ce34-508c-b3ec-9aca89a490db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390462} {:answer/id #uuid "bdd0b52a-8a06-56ea-b802-eaecc89cba1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2 \\\\ \\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390463}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2\\end{bmatrix}" :db/id #edb/ref 17592186390462} :answer-field/id #uuid "d866f6d2-3a06-5422-82c3-a9cfd7fd2522" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390458}] :question/id #uuid "8fbea78d-a11e-5e1b-9dbc-9e0727e11887" :question/math-academy-id "q-252922" :question/problem "Consider the following matrices:\n\n$$\nB=\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix},\\,D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nGiven that $B=PD{P}^{-1},$ find $\\operatorname{ln}⁡B.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{ln}⁡x$ and the given matrix $B,$ we have\n\n$$\n\\operatorname{ln}⁡B=\\operatorname{ln}⁡(PD{P}^{-1})=P\\cdot (\\operatorname{ln}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n\\operatorname{ln}⁡D=\\begin{bmatrix}\\operatorname{ln}⁡1 & 0 \\\\ 0 & \\operatorname{ln}⁡2\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & \\operatorname{ln}⁡2\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{2\\cdot 1-1\\cdot 1}\\begin{bmatrix}1 & -1 \\\\ -1 & 2\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -1 & 2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡B & =P\\cdot (\\operatorname{ln}⁡D)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & 0 \\\\ 0 & \\operatorname{ln}⁡2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & 0 \\\\ -\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡2 & 2\\operatorname{ln}⁡2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186157694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fe7ce25-0b30-58c2-bf63-9503ead7b997" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2e & {e}^{3}-4e \\\\ e & {e}^{3}-2e\\end{bmatrix}" :db/id #edb/ref 17592186413963} {:answer/id #uuid "771abe02-8516-59d0-acc3-5894347ab301" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{3}+2e & -4e \\\\ e & {e}^{3}-2e\\end{bmatrix}" :db/id #edb/ref 17592186413969} {:answer/id #uuid "86191a40-b259-50e8-a428-ed6d4258f5b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3e & -4e \\\\ e & -e\\end{bmatrix}" :db/id #edb/ref 17592186413972} {:answer/id #uuid "a1f65777-1fc0-5be0-b73c-a38fdbb7f26f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3{e}^{3} & -4{e}^{3} \\\\ {e}^{3} & -{e}^{3}\\end{bmatrix}" :db/id #edb/ref 17592186413976} {:answer/id #uuid "c1499551-986a-5c17-a47d-1c94feaf79fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3{e}^{3} & 2{e}^{3} \\\\ 2{e}^{3} & -{e}^{3}\\end{bmatrix}" :db/id #edb/ref 17592186413978}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3{e}^{3} & -4{e}^{3} \\\\ {e}^{3} & -{e}^{3}\\end{bmatrix}" :db/id #edb/ref 17592186413976} :answer-field/id #uuid "dc2ff6f6-b56f-5924-a7f7-5f180522f2b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414000}] :question/id #uuid "e45b0296-d991-5cc8-b0d3-09c2315c742d" :question/math-academy-id "q-252923" :question/problem "Consider the following matrices:\n\n$$\nB=\\begin{bmatrix}5 & -4 \\\\ 1 & 1\\end{bmatrix},\\,J=\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix},\\,P=\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nGiven that $B=PJ{P}^{-1},$ find ${e}^{B}.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)={e}^{x}$ and the given matrix $B,$ we have\n\n$$\n{e}^{B}={e}^{PJ{P}^{-1}}=P\\cdot ({e}^{J})\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $3$s on the main diagonal, we have\n\n$$\nf(J)=\\begin{bmatrix}f(3) & {f}^{′}(3) \\\\ 0 & f(3)\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)={e}^{x}.$ So, we get\n\n$$\n{e}^{J}=\\begin{bmatrix}f(3) & {f}^{′}(3) \\\\ 0 & f(3)\\end{bmatrix}=\\begin{bmatrix}{e}^{3} & {e}^{3} \\\\ 0 & {e}^{3}\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{2\\cdot 1-3\\cdot 1}\\begin{bmatrix}1 & -3 \\\\ -1 & 2\\end{bmatrix}=\\begin{bmatrix}-1 & 3 \\\\ 1 & -2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{e}^{B} & =P\\cdot ({e}^{J})\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}{e}^{3} & {e}^{3} \\\\ 0 & {e}^{3}\\end{bmatrix}\\begin{bmatrix}-1 & 3 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & {e}^{3} \\\\ {e}^{3} & -2{e}^{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}3{e}^{3} & -4{e}^{3} \\\\ {e}^{3} & -{e}^{3}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12757d3c-d5dc-5a60-9dd8-80b0634914c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\pi }{4} & -5\\pi  \\\\ \\frac{3\\pi }{2} & \\frac{5\\pi }{4}\\end{bmatrix}" :db/id #edb/ref 17592186290708} {:answer/id #uuid "b0c7309e-2e5e-5d36-a265-de9c1b111209" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5\\pi }{4} & -5\\pi  \\\\ \\frac{\\pi }{2} & -\\frac{3\\pi }{4}\\end{bmatrix}" :db/id #edb/ref 17592186291400} {:answer/id #uuid "bb079a50-21d2-529b-9df8-21fc1b846a75" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3\\pi }{4} & -5\\pi  \\\\ \\frac{\\pi }{2} & -\\frac{5\\pi }{4}\\end{bmatrix}" :db/id #edb/ref 17592186291444} {:answer/id #uuid "e9e854ed-0698-51e5-be0c-8d0081604988" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5\\pi }{4} & -3\\pi  \\\\ \\frac{3\\pi }{2} & \\frac{\\pi }{2}\\end{bmatrix}" :db/id #edb/ref 17592186291610} {:answer/id #uuid "f89076db-c462-5bc0-8408-7db1258d6aff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5\\pi }{4} & -3\\pi  \\\\ \\frac{\\pi }{2} & -\\frac{5\\pi }{4}\\end{bmatrix}" :db/id #edb/ref 17592186291680}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5\\pi }{4} & -3\\pi  \\\\ \\frac{\\pi }{2} & -\\frac{5\\pi }{4}\\end{bmatrix}" :db/id #edb/ref 17592186291680} :answer-field/id #uuid "c8626f14-9ab6-5295-b087-e345000362f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292346}] :question/id #uuid "7bd1175d-4492-5f77-a2bd-46478fd0dcbe" :question/math-academy-id "q-253441" :question/problem "Consider the following matrices:\n\n$$\nK=\\begin{bmatrix}5 & -12 \\\\ 2 & -5\\end{bmatrix},\\,D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix},\\,P=\\begin{bmatrix}3 & 2 \\\\ 1 & 1\\end{bmatrix}\n$$\n\nGiven that $K=PD{P}^{-1},$ find $\\operatorname{arctan}⁡K.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{arctan}⁡K$ and the given matrix $K,$ we have\n\n$$\n\\operatorname{arctan}⁡K=\\operatorname{arctan}⁡(PD{P}^{-1})=P\\cdot (\\operatorname{arctan}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n\\operatorname{arctan}⁡D=\\begin{bmatrix}\\operatorname{arctan}⁡1 & 0 \\\\ 0 & \\operatorname{arctan}⁡(-1)\\end{bmatrix}=\\begin{bmatrix}\\frac{\\pi }{4} & 0 \\\\ 0 & -\\frac{\\pi }{4}\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{3}{1\\cdot 1-1\\cdot 2}\\begin{bmatrix}1 & -2 \\\\ -1 & 3\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ -1 & 3\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{arctan}⁡K & =P\\cdot (\\operatorname{arctan}⁡D)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}3 & 2 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{\\pi }{4} & 0 \\\\ 0 & -\\frac{\\pi }{4}\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 2 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{\\pi }{4} & -\\frac{\\pi }{2} \\\\ \\frac{\\pi }{4} & -\\frac{3\\pi }{4}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5\\pi }{4} & -3\\pi  \\\\ \\frac{\\pi }{2} & -\\frac{5\\pi }{4}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137e534f-bd6f-5c02-a6f5-0e5fdadf5e06" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ -1 & 1\\end{bmatrix}." :db/id #edb/ref 17592186290713} {:answer/id #uuid "462c0bc3-ae5d-5e7d-ba6c-584073583cc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}." :db/id #edb/ref 17592186290921} {:answer/id #uuid "70f6d2e4-7bdd-5df2-a189-1ec0ba9e8bd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291116} {:answer/id #uuid "a0ea62a0-6627-5db1-881f-af6d402bcf16" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 4 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291333} {:answer/id #uuid "b6f2e637-dd26-5470-a0dc-0787ea0ddf23" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 4 \\\\ 0 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291424}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 4 \\\\ 0 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291424} :answer-field/id #uuid "be47bb85-4317-5a50-92bc-2c97250cebc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292320}] :question/id #uuid "dbb79f16-63e6-597b-b683-9d7f2d6be154" :question/math-academy-id "q-253480" :question/problem "Consider the following matrices:\n\n$$\nC=\\begin{bmatrix}\\pi  & 2\\pi  \\\\ 0 & 2\\pi \\end{bmatrix},\\,D=\\begin{bmatrix}\\pi  & 0 \\\\ 0 & 2\\pi \\end{bmatrix},\\,P=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nGiven that $C=PD{P}^{-1},$ find $\\operatorname{cos}⁡C.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{cos}⁡C$ and the given matrix $C,$ we have\n\n$$\n\\operatorname{cos}⁡C=\\operatorname{cos}⁡(PD{P}^{-1})=P\\cdot (\\operatorname{cos}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n\\operatorname{cos}⁡D=\\begin{bmatrix}\\operatorname{cos}⁡\\pi  & 0 \\\\ 0 & \\operatorname{cos}⁡2\\pi \\end{bmatrix}=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-2\\cdot 0}\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡C & =P\\cdot (\\operatorname{cos}⁡D)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68ad4ed0-c537-5d8f-aead-f1784d1197e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & 4 \\\\ -9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186291078} {:answer/id #uuid "8ae06e79-3bd7-5fdf-b3cd-92fb3be942fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186291219} {:answer/id #uuid "bfe9c811-0437-544e-8d60-7821fc519cc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2 \\\\ 9 & 4\\end{bmatrix}" :db/id #edb/ref 17592186291458} {:answer/id #uuid "cf13d4d0-71c1-5909-8c73-82fde542f1f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 4 \\\\ -9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186291510} {:answer/id #uuid "ddd5ad0a-5aa6-52bb-92c9-15cb1bf537eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186291562}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 4 \\\\ -9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186291510} :answer-field/id #uuid "018bfc53-7c6a-52c8-857a-7ccecc5ecb47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291735}] :question/id #uuid "0d405cd8-28c4-52fd-a2da-376dd14ddae8" :question/math-academy-id "q-253508" :question/problem "Consider the following matrices:\n\n$$\nM=\\begin{bmatrix}-5 & 4 \\\\ -9 & 7\\end{bmatrix},\\,J=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\n$$\n\nGiven that $M=PJ{P}^{-1},$ find $\\operatorname{ln}⁡M.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{ln}⁡x$ and the given matrix $M,$ we have\n\n$$\n\\operatorname{ln}⁡M=\\operatorname{ln}⁡(PJ{P}^{-1})=P\\cdot (\\operatorname{ln}⁡J)\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $1$s on the main diagonal, we have\n\n$$\n\\operatorname{ln}⁡J=\\begin{bmatrix}f(1) & {f}^{′}(1) \\\\ 0 & f(1)\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)=\\frac{1}{x}.$ So, we get\n\n$$\n\\operatorname{ln}⁡J=\\begin{bmatrix}f(1) & {f}^{′}(1) \\\\ 0 & f(1)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{ln}⁡(1) & \\frac{1}{(1)} \\\\ 0 & \\operatorname{ln}⁡(1)\\end{bmatrix}=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{2\\cdot 2-3\\cdot 1}\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡M & =P\\cdot (\\operatorname{ln}⁡J)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 4 \\\\ -9 & 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186363647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5526c323-a2c1-5c5b-97ef-7fe8dc93120e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363649} {:answer/id #uuid "047b15e1-e229-59bd-ae6f-4c8c03b091db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363650} {:answer/id #uuid "4de571fa-6b40-524d-9743-5964efb8c012" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363651} {:answer/id #uuid "cdd35503-f16c-5a9e-8b68-9a58e3b5810d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363652} {:answer/id #uuid "c854110d-1b0f-5794-affe-f3486969e32d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363653}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363649} :answer-field/id #uuid "c4428f89-e5a9-5f0c-ab0a-de1fa79f0c7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363648}] :question/id #uuid "260b8d2c-8f9e-56a2-81b8-5ecd16019589" :question/math-academy-id "q-253493" :question/problem "Consider the following matrices:\n\n$$\nE=\\begin{bmatrix}1 & 1 \\\\ -1 & 3\\end{bmatrix},\\,J=\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\n$$\n\nGiven that $E=PJ{P}^{-1},$ find $\\operatorname{cos}⁡(\\pi E).$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{cos}⁡(\\pi x)$ and the given matrix $E,$ we have\n\n$$\n\\operatorname{cos}⁡(\\pi E)=\\operatorname{cos}⁡(\\pi PJ{P}^{-1})=P\\cdot (\\operatorname{cos}⁡\\pi J)\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $2$s on the main diagonal, we have\n\n$$\nf(J)=\\begin{bmatrix}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)=-\\pi \\operatorname{sin}⁡(\\pi x).$ So, we get\n\n$$\n\\operatorname{cos}⁡(\\pi E)=\\begin{bmatrix}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}⁡(2\\pi ) & -\\pi \\operatorname{sin}⁡(2\\pi ) \\\\ 0 & \\operatorname{cos}⁡(2\\pi )\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 3-1\\cdot 2}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}=\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}cos(\\pi E) & =P\\cdot (\\operatorname{cos}⁡(\\pi J))\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb02d1ee-e874-56ee-9c31-9b099e11c6ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 4 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186390487} {:answer/id #uuid "3867f9a1-a810-56f4-a7b7-b06c990c71a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -4 \\\\ 0 & 9\\end{bmatrix}" :db/id #edb/ref 17592186390488} {:answer/id #uuid "6df1956e-364a-5a9a-881a-6421ee452c3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -4 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186390489} {:answer/id #uuid "526ac3c4-7ca1-57b6-9892-c6c51a1de885" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186390490} {:answer/id #uuid "af136552-a664-56da-af57-825d45a55ef2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186390491}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -4 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186390489} :answer-field/id #uuid "db812932-512e-5037-a8e9-0e6ef6900bbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390486}] :question/id #uuid "8bf7af58-a7c5-5140-8c49-6a540dd66971" :question/math-academy-id "q-253440" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix},\\,D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\\,P=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nGiven that $A=PD{P}^{-1},$ find ${2}^{A}.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)={2}^{x}$ and the given matrix $A,$ we have\n\n$$\n{2}^{A}={2}^{(PD{P}^{-1})}=P\\cdot ({2}^{D})\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n{2}^{D}=\\begin{bmatrix}{2}^{2} & 0 \\\\ 0 & {2}^{3}\\end{bmatrix}=\\begin{bmatrix}4 & 0 \\\\ 0 & 8\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-0\\cdot (-1)}\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{2}^{A} & =P\\cdot ({2}^{D})\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 0 \\\\ 0 & 8\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 4 \\\\ 0 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -4 \\\\ 0 & 8\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11616b01-2dc9-5583-b247-44011865d37e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\pi -6 & -3 \\\\ 3 & 4\\pi +6\\end{bmatrix}" :db/id #edb/ref 17592186390494} {:answer/id #uuid "347181c6-f735-53cd-9e7a-c9a179a7fb52" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\pi +6 & -6 \\\\ 6 & 4\\pi -6\\end{bmatrix}" :db/id #edb/ref 17592186390495} {:answer/id #uuid "97728fa4-9b8c-5b3f-bfe8-e7cd26108fec" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\pi +6 & 3 \\\\ -3 & 2\\pi -6\\end{bmatrix}" :db/id #edb/ref 17592186390496} {:answer/id #uuid "8351c2fe-bb03-587a-86e5-dc4f192359bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\pi +3 & -6 \\\\ 6 & 2\\pi -3\\end{bmatrix}" :db/id #edb/ref 17592186390497} {:answer/id #uuid "5cc015e4-fa81-5911-b453-9b01ae821ced" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\pi -3 & -6 \\\\ 6 & 4\\pi +3\\end{bmatrix}" :db/id #edb/ref 17592186390498}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\pi +6 & -6 \\\\ 6 & 4\\pi -6\\end{bmatrix}" :db/id #edb/ref 17592186390495} :answer-field/id #uuid "2fe431d2-c2a4-554b-8c9d-25c08aebb39d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390493}] :question/id #uuid "462adc62-6b27-5233-9c9d-d820967cef9b" :question/math-academy-id "q-253677" :question/problem "Consider the following matrices:\n\n$$\nG=\\begin{bmatrix}\\sqrt{3}+2 & \\,\\,-2 \\\\ 2 & \\,\\,\\sqrt{3}-2\\end{bmatrix},\\,\\,\\,J=\\begin{bmatrix}\\sqrt{3} & \\,1 \\\\ 0 & \\,\\sqrt{3}\\end{bmatrix},\\,\\,\\,P=\\begin{bmatrix}2 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$\n\nGiven that $G=PJ{P}^{-1},$ find $12\\operatorname{arctan}⁡G.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=12\\operatorname{arctan}⁡x$ and the given matrix $G,$ we have\n\n$$\n12\\operatorname{arctan}⁡G=12\\operatorname{arctan}⁡(PJ{P}^{-1})=P\\cdot (12\\operatorname{arctan}⁡J)\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $\\sqrt{3}$ on the main diagonal, we have\n\n$$\nf(J)=\\begin{bmatrix}f(\\sqrt{3}) & {f}^{′}(\\sqrt{3}) \\\\ 0 & f(\\sqrt{3})\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)=\\frac{12}{{x}^{2}+1}$ So, we get\n\n$$\n12\\operatorname{arctan}⁡J=\\begin{bmatrix}f(\\sqrt{3}) & {f}^{′}(\\sqrt{3}) \\\\ 0 & f(\\sqrt{3})\\end{bmatrix}=\\begin{bmatrix}4\\pi  & 3 \\\\ 0 & 4\\pi \\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 2-2\\cdot 2}\\begin{bmatrix}1 & -2 \\\\ -2 & 2\\end{bmatrix}=\\frac{1}{2}\\begin{bmatrix}-1 & 2 \\\\ 2 & -2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}12\\operatorname{arctan}⁡G & =P\\cdot (12\\operatorname{arctan}⁡J)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}4\\pi  & 3 \\\\ 0 & 4\\pi \\end{bmatrix}\\frac{1}{2}\\begin{bmatrix}-1 & 2 \\\\ 2 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}-2\\pi +3 & 4\\pi -3 \\\\ 4\\pi  & -4\\pi \\end{bmatrix} \\\\  & =\\begin{bmatrix}4\\pi +6 & -6 \\\\ 6 & 4\\pi -6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a046da-5836-5310-b035-b3ab87808bb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9\\operatorname{ln}⁡(3) & 9 \\\\ -9 & 9\\operatorname{ln}⁡(3)\\end{bmatrix}" :db/id #edb/ref 17592186390501} {:answer/id #uuid "6c4b63d5-d2f6-5ba0-9f3d-4114e4e39210" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3) \\\\ -9\\operatorname{ln}⁡(3) & \\operatorname{ln}⁡(3)\\end{bmatrix}" :db/id #edb/ref 17592186390502} {:answer/id #uuid "68fa6317-9f05-5a88-b253-5911ad78919f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3) \\\\ -9\\operatorname{ln}⁡(3) & -\\operatorname{ln}⁡(3)\\end{bmatrix}" :db/id #edb/ref 17592186390503} {:answer/id #uuid "bc33a49f-e4db-52ac-8dc1-e9a2a9bfa5a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3\\operatorname{ln}⁡(3)+9 & \\operatorname{ln}⁡(3) \\\\ -\\operatorname{ln}⁡(3) & 3\\operatorname{ln}⁡(3)+9\\end{bmatrix}" :db/id #edb/ref 17592186390504} {:answer/id #uuid "c46be42c-dda5-53c8-9a44-89e57ebf0b1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9-9\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3) \\\\ -9\\operatorname{ln}⁡(3) & 9+9\\operatorname{ln}⁡(3)\\end{bmatrix}" :db/id #edb/ref 17592186390505}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9-9\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3) \\\\ -9\\operatorname{ln}⁡(3) & 9+9\\operatorname{ln}⁡(3)\\end{bmatrix}" :db/id #edb/ref 17592186390505} :answer-field/id #uuid "39a6382b-3f11-58a5-8769-fb40b3f511f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390500}] :question/id #uuid "01aa6efd-1aa0-5169-9c59-06c6dc6237ee" :question/math-academy-id "q-253682" :question/problem "Consider the following matrices:\n\n$$\nK=\\begin{bmatrix}2 & 2 \\\\ -2 & 6\\end{bmatrix},\\,J=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix},\\,P=\\begin{bmatrix}1 & \\frac{1}{2} \\\\ 1 & 1\\end{bmatrix}\n$$\n\nGiven that $K=PJ{P}^{-1},$ find ${3}^{K/2}.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)={3}^{x/2}$ and the given matrix $K,$ we have\n\n$$\n{3}^{K/2}={3}^{\\frac{1}{2}PJ{P}^{-1}}=P\\cdot ({3}^{J/2})\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $4$s on the main diagonal, we have\n\n$$\nf(J)=\\begin{bmatrix}f(4) & {f}^{′}(4) \\\\ 0 & f(4)\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)=\\frac{{3}^{x/2}\\operatorname{ln}⁡(3)}{2}.$ So, we get\n\n$$\n{3}^{J/2}=\\begin{bmatrix}f(4) & {f}^{′}(4) \\\\ 0 & f(4)\\end{bmatrix}=\\begin{bmatrix}9 & \\frac{9\\operatorname{ln}⁡(3)}{2} \\\\ 0 & 9\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-\\frac{1}{2}\\cdot 1}\\begin{bmatrix}1 & -\\frac{1}{2} \\\\ -1 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ -2 & 2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{3}^{K/2} & =P\\cdot ({3}^{J/2})\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & \\frac{1}{2} \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}9 & \\frac{9\\operatorname{ln}⁡(3)}{2} \\\\ 0 & 9\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & \\frac{1}{2} \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}18-9\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3)-9 \\\\ -18 & 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}9-9\\operatorname{ln}⁡(3) & 9\\operatorname{ln}⁡(3) \\\\ -9\\operatorname{ln}⁡(3) & 9+9\\operatorname{ln}⁡(3)\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186414004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "086b5f8c-361e-5e84-ba7f-07908a6ffad8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-92 & 62 \\\\ -186 & 125\\end{bmatrix}" :db/id #edb/ref 17592186413955} {:answer/id #uuid "5f32c9ba-7882-5683-b822-c627858b4d7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}72 & -52 \\\\ -166 & 75\\end{bmatrix}" :db/id #edb/ref 17592186413962} {:answer/id #uuid "6915da6f-7547-5e67-bf4a-3730ded795b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}62 & 92 \\\\ -125 & 186\\end{bmatrix}" :db/id #edb/ref 17592186413964} {:answer/id #uuid "774e359d-a732-5eac-9259-4f31c4ad4889" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}32 & 24 \\\\ -18 & 180\\end{bmatrix}" :db/id #edb/ref 17592186413970} {:answer/id #uuid "8e0c78fd-212a-50ef-8305-029fa98e0cf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}31 & 46 \\\\ -67 & 98\\end{bmatrix}" :db/id #edb/ref 17592186413973}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-92 & 62 \\\\ -186 & 125\\end{bmatrix}" :db/id #edb/ref 17592186413955} :answer-field/id #uuid "d52e4f2e-ac8e-5bd0-a3c8-e99ceefdc963" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413997}] :question/id #uuid "5a76ab5b-a059-5458-b5f4-e674816ed366" :question/math-academy-id "q-253488" :question/problem "Consider the following matrices:\n\n$$\nB=\\begin{bmatrix}-2 & 2 \\\\ -6 & 5\\end{bmatrix},\\,D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\n$$\n\nGiven that $X=PD{P}^{-1},$ find ${X}^{5}.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)={x}^{5}$ and the given matrix $X,$ we have\n\n$$\n{X}^{5}=(PD{P}^{-1})^{5}=P\\cdot ({D}^{5})\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n{D}^{5}=\\begin{bmatrix}{1}^{5} & 0 \\\\ 0 & {2}^{5}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 32\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{2}{2\\cdot 1-3\\cdot 1}\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{X}^{5} & =P\\cdot ({D}^{5})\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 32\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ -96 & 64\\end{bmatrix} \\\\  & =\\begin{bmatrix}-92 & 62 \\\\ -186 & 125\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186562471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613b1292-599e-5175-a4de-dac872a76495" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186561817} {:answer/id #uuid "650f951f-a1c7-5370-9079-613e1ed08f22" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ -2 & 0\\end{aligned}]" :db/id #edb/ref 17592186561832} {:answer/id #uuid "69eb12dd-2688-5a53-91ae-fe2035e9de63" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186561847} {:answer/id #uuid "70bc40d1-370d-5f28-96fb-58c2c278fc37" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186561863} {:answer/id #uuid "d2c5f2de-8e97-5e34-b223-ff08b5bc179e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186562112}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ -2 & 0\\end{aligned}]" :db/id #edb/ref 17592186561832} :answer-field/id #uuid "85a7cfaa-2021-5878-b715-b12be6d3a7f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562308}] :question/id #uuid "a906d22b-042f-5736-a4c7-747a5da98697" :question/math-academy-id "q-253490" :question/problem "Consider the following matrices:\n\n$$\nE=[\\begin{aligned}\\frac{\\pi }{6} & 0 \\\\ \\frac{5\\pi }{6} & \\pi \\end{aligned}],\\,D=[\\begin{aligned}\\frac{\\pi }{6} & 0 \\\\ 0 & \\pi \\end{aligned}],\\,P=[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]\n$$\n\nGiven that $E=PD{P}^{-1},$ find $4\\operatorname{sin}⁡E.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=4\\operatorname{sin}⁡E$ and the given matrix $C,$ we have\n\n$$\n4\\operatorname{sin}⁡E=4\\operatorname{sin}⁡(PD{P}^{-1})=P\\cdot (4\\operatorname{sin}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n4\\operatorname{sin}⁡D=[\\begin{aligned}4\\operatorname{sin}⁡\\frac{\\pi }{6} & 0 \\\\ 0 & 4\\operatorname{sin}⁡\\pi \\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-(-1)\\cdot 0}[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡E & =P\\cdot (4\\operatorname{sin}⁡D)\\cdot {P}^{-1} \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Value of a Function of a Jordan Decomposition"}] :topic/math-academy-id 2927 :topic/title "Matrix Functions"}]}
