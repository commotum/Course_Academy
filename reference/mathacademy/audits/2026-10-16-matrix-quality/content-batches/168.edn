}⁡(t-1) & \\operatorname{sin}⁡(t-1) \\\\ -\\operatorname{sin}⁡(t-1) & \\operatorname{cos}⁡(t-1)\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}][\\begin{aligned}{e}^{s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2\\operatorname{cos}⁡(t-1)+3\\operatorname{sin}⁡(t-1) \\\\ -2\\operatorname{sin}⁡(t-1)+3\\operatorname{cos}⁡(t-1)\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{s}\\operatorname{cos}⁡(t-s) \\\\ -{e}^{s}\\operatorname{sin}⁡(t-s)\\end{aligned}]\\text{d}s.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c917360-af2a-547f-83e0-3ae046b64006" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(6(t-1))-2\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556681} {:answer/id #uuid "9a272e7c-5ccc-58a1-bc0e-68ec31a26ddd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(6(t-1))+2\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556802} {:answer/id #uuid "d2839194-a132-5ab8-875a-6230951d4cfa" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(6(t-1))+\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556938} {:answe