90-bb5412259f35" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.265 \\\\ 0.735\\end{bmatrix}" :db/id #edb/ref 17592186388384} {:answer/id #uuid "7a6667aa-28b0-525c-9069-3973c21dd227" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.346 \\\\ 0.654\\end{bmatrix}" :db/id #edb/ref 17592186388385} {:answer/id #uuid "c94cfbdf-e0f1-5ad7-b58a-42146e7370a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.145 \\\\ 0.855\\end{bmatrix}" :db/id #edb/ref 17592186388386} {:answer/id #uuid "42ec7241-18a7-516f-909e-e9c55084fa71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.325 \\\\ 0.675\\end{bmatrix}" :db/id #edb/ref 17592186388387} {:answer/id #uuid "a30db03d-ef25-5ff9-9835-bf33eddfb7ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.415 \\\\ 0.585\\end{bmatrix}" :db/id #edb/ref 17592186388388}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.325 \\\\ 0.675\\end{bmatrix}" :db/id #edb/ref 17592186388387} :answer-field/id #uuid "1799f441-3ae2-50b8-8266-618df3f86647" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388383}] :question/id #uuid "0b120930-cc5f-5db6-89a1-4f05e7c988bd" :question/math-academy-id "q-135446" :question/problem "$$\nP=\\begin{bmatrix}0.35 & 0.3 \\\\ 0.65 & 0.7\\end{bmatrix},\\,{x}_{0}=\\begin{bmatrix}0.5 \\\\ 0.5\\end{bmatrix}\n$$\n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{1}.$" :question/worked-solution "To find the state vector ${x}_{1},$ we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.35 & 0.3 \\\\ 0.65 & 0.7\\end{bmatrix}\\begin{bmatrix}0.5 \\\\ 0.5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.325 \\\\ 0.675\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186391917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2142caaf-044f-5d3f-9140-4e393d284810" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.61 \\\\ 0.39\\end{bmatrix}" :db/id #edb/ref 17592186391919} {:answer/id #uuid "35d7a9f8-fdd2-5c1b-8843-b9f8697e2f9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.516 \\\\ 0.484\\end{bmatrix}" :db/id #edb/ref 17592186391920} {:answer/id #uuid "0e8fe8fd-dde4-59d4-b249-277b754f9beb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.39 \\\\ 0.61\\end{bmatrix}" :db/id #edb/ref 17592186391921} {:answer/id #uuid "cfd8efc0-924f-5b81-ac50-aecb46fdfe49" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.484 \\\\ 0.516\\end{bmatrix}" :db/id #edb/ref 17592186391922} {:answer/id #uuid "e0c78f45-ea8e-5998-ac5d-b29decb14e02" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.844 \\\\ 0.156\\end{bmatrix}" :db/id #edb/ref 17592186391923}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.484 \\\\ 0.516\\end{bmatrix}" :db/id #edb/ref 17592186391922} :answer-field/id #uuid "317c9011-9bc9-5c33-a4df-4f7ca53eee4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391918}] :question/id #uuid "b15112f4-7893-524a-8de9-46c29499aff4" :question/math-academy-id "q-35789" :question/problem "$$\nP=\\begin{bmatrix}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{bmatrix},\\,{x}_{0}=\\begin{bmatrix}0.4 \\\\ 0.6\\end{bmatrix}\n$$\n\n \nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{bmatrix}\\begin{bmatrix}0.4 \\\\ 0.6\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.61 \\\\ 0.39\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =\\begin{bmatrix}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{bmatrix}\\begin{bmatrix}0.61 \\\\ 0.39\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.484 \\\\ 0.516\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5a7632-a554-5190-bed3-1cebe52ce242" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.376 \\\\ 0.624\\end{aligned}]" :db/id #edb/ref 17592186550402} {:answer/id #uuid "1c0b1479-7543-5906-9be5-c98b46ea8939" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.333 \\\\ 0.667\\end{aligned}]" :db/id #edb/ref 17592186550428} {:answer/id #uuid "9e44f886-a69a-5eb5-877d-eb9fbaded0e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.345 \\\\ 0.655\\end{aligned}]" :db/id #edb/ref 17592186550773} {:answer/id #uuid "bd770536-c4d8-578e-9970-f59594cc8769" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.433 \\\\ 0.567\\end{aligned}]" :db/id #edb/ref 17592186550890} {:answer/id #uuid "ea15f24b-9cf0-5ff1-9bf9-e4b44b9c4cb0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.289 \\\\ 0.711\\end{aligned}]" :db/id #edb/ref 17592186551000}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.333 \\\\ 0.667\\end{aligned}]" :db/id #edb/ref 17592186550428} :answer-field/id #uuid "fdd5f643-5dc8-5fd7-924a-fad98f3489b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551228}] :question/id #uuid "8271e0f5-ad00-5357-b8f4-39e3fffd35ad" :question/math-academy-id "q-135449" :question/problem "$$\nP=[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}],\\,{x}_{0}=[\\begin{aligned}0.2 \\\\ 0.8\\end{aligned}]\n$$\n\n \n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}][\\begin{aligned}0.2 \\\\ 0.8\\end{aligned}] \\\\  & =[\\begin{aligned}0.39 \\\\ 0.61\\end{aligned}].\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.15 & 0.45 \\\\ 0.85 & 0.55\\end{aligned}][\\begin{aligned}0.39 \\\\ 0.61\\end{aligned}] \\\\  & =[\\begin{aligned}0.333 \\\\ 0.667\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb988c0-f3a5-5c82-b2bd-66aa789d780c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.192 \\\\ 0.808\\end{aligned}]" :db/id #edb/ref 17592186550478} {:answer/id #uuid "32d225e8-4f0c-59f9-8321-143a8679ecc9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.256 \\\\ 0.744\\end{aligned}]" :db/id #edb/ref 17592186550489} {:answer/id #uuid "5da59e22-9c22-5ce7-b43b-7e2e52a1f029" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.252 \\\\ 0.748\\end{aligned}]" :db/id #edb/ref 17592186550594} {:answer/id #uuid "7a50f6bd-62b5-52cc-8bc8-2701b3a19388" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.178 \\\\ 0.822\\end{aligned}]" :db/id #edb/ref 17592186550675} {:answer/id #uuid "94e347aa-0aab-5548-a61d-fa864e54a8eb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.322 \\\\ 0.678\\end{aligned}]" :db/id #edb/ref 17592186550740}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.192 \\\\ 0.808\\end{aligned}]" :db/id #edb/ref 17592186550478} :answer-field/id #uuid "f757e78b-6af6-5637-affb-8a450f17cc85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551225}] :question/id #uuid "aad00a02-7311-5843-ab16-bebead54d45c" :question/math-academy-id "q-135453" :question/problem "$$\nP=[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}],\\,{x}_{0}=[\\begin{aligned}0.3 \\\\ 0.7\\end{aligned}]\n$$\n\n \n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}][\\begin{aligned}0.3 \\\\ 0.7\\end{aligned}] \\\\  & =[\\begin{aligned}0.21 \\\\ 0.79\\end{aligned}].\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.35 & 0.15 \\\\ 0.65 & 0.85\\end{aligned}][\\begin{aligned}0.21 \\\\ 0.79\\end{aligned}] \\\\  & =[\\begin{aligned}0.192 \\\\ 0.808\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a State Vector"} {:db/id #edb/ref 17592186124614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124425 :question/id #uuid "25622a0e-3e5b-5f09-bef6-afaa30d153d3" :question/math-academy-id "e-9162" :question/problem "Which of the following are stochastic matrices?\n\n![](images/70/70ee929c71d89a443d3ea0efc39ed225f344685059b86a04285a118a476da0f8.png)" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $\\bf{U}$ is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n\\begin{bmatrix}-0.2 & 0 \\\\ 1.2 & 1\\end{bmatrix}\n$$\n\n- Matrix $\\bf{V}$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are nonnegative and add up to one): \n\n$$\n\\begin{aligned}\\begin{bmatrix}0.35 & 0.95 \\\\ 0.65 & 0.05\\end{bmatrix}\\,\\begin{aligned}0.35+0.65=1 \\\\ 0.95+0.05=1\\end{aligned}\\end{aligned}\n$$\n\n- Matrix $\\bf{W}$ is *not* a stochastic matrix since its third column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n\\begin{bmatrix}0 & 1 & 0 \\\\ 0.5 & 0 & 0.4 \\\\ 0.5 & 0 & 0.7\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$\\bf{V}$ only.\""} :knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22" :knowledge-point/questions [{:db/id #edb/ref 17592186124768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029787b4-76ef-5324-83eb-649b506a66cd" :answer/type {:db/ident :answer.type/text} :answer/value "$u$, $v$, and $w$" :db/id #edb/ref 17592186244331} {:answer/id #uuid "1bc43066-87ae-5d14-b7df-35e4b5a96b4a" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $v$ only" :db/id #edb/ref 17592186244559} {:answer/id #uuid "1f880ee7-2dae-5e94-a00e-cf7ea06127d2" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ only" :db/id #edb/ref 17592186244592} {:answer/id #uuid "47d8a976-4e1b-5d5c-9400-17de622336ab" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ only" :db/id #edb/ref 17592186244953} {:answer/id #uuid "66317c76-eb73-56c5-a0e6-948b81d5904d" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $w$ only" :db/id #edb/ref 17592186245215}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$u$ only" :db/id #edb/ref 17592186244953} :answer-field/id #uuid "8587d707-0f0d-5a40-a9a9-e5a919395461" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246777}] :question/id #uuid "6d6371d4-1a60-5526-b7b1-69a38ead3549" :question/math-academy-id "q-109881" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=\\begin{bmatrix}0.5 \\\\ 0 \\\\ 0.5\\end{bmatrix},\\,v=\\begin{bmatrix}-0.45 \\\\ 1.55\\end{bmatrix},\\,w=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.5+0+0.5=1\n$$\n\n- Vector $v$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $w$ is *not* a stochastic vector since the entries do not add up to one:\n\n$$\n0+0=0\\ne 1\n$$\n\nTherefore, the correct answer is \"$u$ only.\""} {:db/id #edb/ref 17592186124769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14b2aa6-e2b0-5c7b-9b5e-bff935134b81" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186121212} {:answer/id #uuid "ce803d77-1449-5c03-be82-10019ec069fc" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186121213} {:answer/id #uuid "da0f9182-973c-5ad4-8864-b3f5bfe87290" :answer/type {:db/ident :answer.type/text} :answer/value "$U$, $V$, and $W$" :db/id #edb/ref 17592186121214} {:answer/id #uuid "220b5ad9-a6a4-53ed-82b9-92706d35035d" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186121215} {:answer/id #uuid "5a819f20-4b26-5673-9f89-915cc0e71698" :answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186121216}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186121213} :answer-field/id #uuid "28b7af88-7cb5-53b2-af84-a7246e3059bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121211}] :question/id #uuid "8d2f0627-b325-5745-b223-6d5747b6cfb7" :question/math-academy-id "q-109882" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=[\\begin{aligned}0.2 & 0 \\\\ 0.5 & 1\\end{aligned}],\\,V=[\\begin{aligned}0.45 & 0.25 \\\\ 0.55 & 0.75\\end{aligned}],\\,W=[\\begin{aligned}0 & 1 & 0 \\\\ 0.5 & 0.2 & 0.3 \\\\ 0.5 & 0 & 0.7\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its first column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n[\\begin{aligned}0.2 & 0 \\\\ 0.5 & 1\\end{aligned}]\n$$\n\n- Matrix $V$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are nonnegative and add up to one): \n\n$$\n\\begin{aligned}[\\begin{aligned}0.45 & 0.25 \\\\ 0.55 & 0.75\\end{aligned}]\\,\\begin{aligned}0.45+0.55=1 \\\\ 0.25+0.75=1\\end{aligned}\\end{aligned}\n$$\n\n- Matrix $W$ is *not* a stochastic matrix since its second column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 0.5 & 0.2 & 0.3 \\\\ 0.5 & 0 & 0.7\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$V$ only.\""} {:db/id #edb/ref 17592186269070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c8a29d7-0acb-5b44-bc72-1f81d655f23b" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ only" :db/id #edb/ref 17592186266820} {:answer/id #uuid "70308050-832b-5746-8df5-3cb267e921c2" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $v$ only" :db/id #edb/ref 17592186267130} {:answer/id #uuid "a22c3f44-c3fc-5780-bac0-3344d318de9a" :answer/type {:db/ident :answer.type/text} :answer/value "$w$ only" :db/id #edb/ref 17592186267604} {:answer/id #uuid "e55678c7-ca8c-51b4-8d84-84cfb03d8b6d" :answer/type {:db/ident :answer.type/text} :answer/value "$u,$ $v,$ and $w$" :db/id #edb/ref 17592186268170} {:answer/id #uuid "e806bb5c-d2b8-5349-93ed-a2adb6fafce4" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ and $w$ only" :db/id #edb/ref 17592186268201}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$v$ and $w$ only" :db/id #edb/ref 17592186268201} :answer-field/id #uuid "c6ef889f-0b8f-5911-9459-7463579addf8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268762}] :question/id #uuid "2df67835-850a-53e8-b383-b1ca105c4466" :question/math-academy-id "q-135483" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=\\begin{bmatrix}0.45 \\\\ 0.55 \\\\ -0.05\\end{bmatrix},\\,v=\\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix},\\,w=\\begin{bmatrix}0.65 \\\\ 0.15 \\\\ 0.2\\end{bmatrix}\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $v$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.7+0.3=1\n$$\n\n- Vector $w$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.65+0.15+0.2=1\n$$\n\nTherefore, the correct answer is \"$v$ and $w$ only.\""} {:db/id #edb/ref 17592186269071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100e7ac1-977d-57e8-8537-f447520ebbe7" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $w$ only" :db/id #edb/ref 17592186266279} {:answer/id #uuid "a0ac8d92-30b7-55e8-8c1b-4fbd0c938812" :answer/type {:db/ident :answer.type/text} :answer/value "$w$ only" :db/id #edb/ref 17592186267593} {:answer/id #uuid "c33077d6-4605-5fad-b1ff-a0adb0d6c789" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ only" :db/id #edb/ref 17592186267887} {:answer/id #uuid "c9b33dec-4fb2-5e79-8f85-978fd7de31dd" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $v$ only" :db/id #edb/ref 17592186267953} {:answer/id #uuid "cb455989-e31a-579c-88b2-224865603b14" :answer/type {:db/ident :answer.type/text} :answer/value "$u,$ $v,$ and $w$" :db/id #edb/ref 17592186267965}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $w$ only" :db/id #edb/ref 17592186266279} :answer-field/id #uuid "4408aba7-06c0-5aff-af06-1dce83123fb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268521}] :question/id #uuid "0039e727-f97e-5ab6-aa21-97ec0dadd8d9" :question/math-academy-id "q-135484" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=\\begin{bmatrix}0.15 \\\\ 0.85\\end{bmatrix},\\,v=\\begin{bmatrix}0.8 \\\\ -0.1 \\\\ 0.3\\end{bmatrix},\\,w=\\begin{bmatrix}0.2 \\\\ 0.3 \\\\ 0.5\\end{bmatrix}\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.15+0.85=1\n$$\n\n- Vector $v$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $w$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0.2+0.3+0.5=1\n$$\n\nTherefore, the correct answer is \"$u$ and $w$ only.\""} {:db/id #edb/ref 17592186269072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "474a8a35-2f0e-5821-afca-895b853e2f60" :answer/type {:db/ident :answer.type/text} :answer/value "$w$ only" :db/id #edb/ref 17592186266778} {:answer/id #uuid "7a0a8a8f-bd88-5bd7-93f5-1f51e245d19b" :answer/type {:db/ident :answer.type/text} :answer/value "$u,$ $v,$ and $w$ only" :db/id #edb/ref 17592186267220} {:answer/id #uuid "a844b50d-312f-5ead-8e57-174902607b02" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186267669} {:answer/id #uuid "bb1631ac-a4e6-5289-a648-1a896c779f27" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $v$ only" :db/id #edb/ref 17592186267823} {:answer/id #uuid "e9d91b88-d944-5bcf-aa2b-85fbc6643155" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $w$ only" :db/id #edb/ref 17592186268227}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186267669} :answer-field/id #uuid "3f7a808f-2559-583a-bc17-73f587979c51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268511}] :question/id #uuid "11a06254-1131-54e3-ac79-433bb7764638" :question/math-academy-id "q-135485" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=\\begin{bmatrix}-0.2 \\\\ 0.7 \\\\ 0.5\\end{bmatrix},\\,v=\\begin{bmatrix}0.6 \\\\ -0.1 \\\\ 0.5\\end{bmatrix},\\,w=\\begin{bmatrix}0.15 \\\\ 0.95\\end{bmatrix}\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $v$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $w$is *not* a stochastic vector since the entries do not add up to one:\n\n$$\n0.15+0.95=1.1\\ne 1\n$$\n\nTherefore, the correct answer is \"None.\""} {:db/id #edb/ref 17592186269073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8786cf44-21c3-5f91-ae1e-9ed86d4c4ab6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464048} {:answer/id #uuid "6733f645-af10-5821-819f-178e020da088" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464049}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464048} :answer-field/id #uuid "cf10f3fa-2ffc-5223-b491-71ebeb6d2901" :answer-field/key "U" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464958} {:answer-field/choices [{:answer/id #uuid "04d077b2-7359-59a4-bab3-16da7d8ee52c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464050} {:answer/id #uuid "25c5dce9-5e91-5159-8c35-a198c693e152" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464051}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464050} :answer-field/id #uuid "a6141f05-7c5c-52c2-b7b5-86083319e913" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464959} {:answer-field/choices [{:answer/id #uuid "254b6e6f-8a77-5da1-8b3b-d863cf065f1c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464052} {:answer/id #uuid "3db8c5ce-4f8b-5b6c-9c0e-73a437e1a407" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464053}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464053} :answer-field/id #uuid "746bc2c9-0d6d-5f8a-9494-27efcd2995b1" :answer-field/key "W" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464960}] :question/id #uuid "7cb13afc-7824-57e2-abcc-e880dfaafeec" :question/math-academy-id "q-135488" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=\\begin{bmatrix}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{bmatrix},\\,V=\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix},\\,W=\\begin{bmatrix}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its second column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n\\begin{bmatrix}0.1 & 0 & 0.9 \\\\ 0 & 0 & 0 \\\\ 0.9 & 0 & 0.1\\end{bmatrix}\n$$\n\n- Matrix $V$  is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix}\n$$\n\n- Matrix $W$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are non-negative and add up to one): \n\n$$\n\\begin{aligned}\\begin{bmatrix}0.5 & 0.3 \\\\ 0.5 & 0.7\\end{bmatrix}\\,\\begin{aligned}0.5+0.5=1 \\\\ 0.3+0.7=1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$W$ only.\""} {:db/id #edb/ref 17592186378671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "490995ed-ac99-5768-ad40-5b0e11f10a45" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471033} {:answer/id #uuid "484cb763-07fa-5ad2-a411-8df07f51dab0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471034}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471033} :answer-field/id #uuid "42e6465e-3deb-5f06-abdf-59086e80b9f5" :answer-field/key "U" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472022} {:answer-field/choices [{:answer/id #uuid "e74dd853-f834-5489-9ab6-2207e01c886a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471035} {:answer/id #uuid "41a85770-ab01-5832-833b-ff27a5be8436" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471036}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471036} :answer-field/id #uuid "6b48cb6c-8acd-5de5-896e-2355e9e0e35d" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472023} {:answer-field/choices [{:answer/id #uuid "d2269aad-57fb-5cbb-ab49-87e39a9ac7cf" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471037} {:answer/id #uuid "f0f0420b-4735-51ba-ba16-ed5ea138cc6f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471038}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471038} :answer-field/id #uuid "1807e1b7-7969-53ae-b85d-f2a54b4c14bf" :answer-field/key "W" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472024}] :question/id #uuid "90365b47-9514-5b9b-bb0b-216780f54607" :question/math-academy-id "q-135487" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix},\\,V=\\begin{bmatrix}0.1 & 0.2 \\\\ 0.9 & 0.8\\end{bmatrix},\\,W=\\begin{bmatrix}0.5 & 0 & 0.5 \\\\ 0 & 1 & 0 \\\\ 0.5 & 0 & 0.5\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n\\begin{bmatrix}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{bmatrix}\n$$\n\n- Matrix $V$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are nonnegative and add up to one): \n\n$$\n\\begin{aligned}\\begin{bmatrix}0.1 & 0.2 \\\\ 0.9 & 0.8\\end{bmatrix}\\,\\begin{aligned}0.1+0.9=1 \\\\ 0.2+0.8=1\\end{aligned}\\end{aligned}\n$$\n\n- Matrix $W$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are non-negative and add up to one): \n\n$$\n\\begin{aligned}\\begin{bmatrix}0.5 & 0 & 0.5 \\\\ 0 & 1 & 0 \\\\ 0.5 & 0 & 0.5\\end{bmatrix}\\,\\begin{aligned}0.5+0+0.5=1 \\\\ 0+1+0=1 \\\\ 0.5+0+0.5=1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$V$ and $W$ only.\""} {:db/id #edb/ref 17592186551279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01856f5b-cc6c-5c01-87c6-35513dae3331" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ and $w$ only" :db/id #edb/ref 17592186550374} {:answer/id #uuid "5092eb4e-8f98-579e-b1a4-2b0ec10dcf24" :answer/type {:db/ident :answer.type/text} :answer/value "$u,$ $v,$ and $w$" :db/id #edb/ref 17592186550558} {:answer/id #uuid "5566d9eb-9357-5cab-bfb4-b03789725566" :answer/type {:db/ident :answer.type/text} :answer/value "$w$ only" :db/id #edb/ref 17592186550572} {:answer/id #uuid "ae7e88a2-b349-5d40-9e95-5904b7a47fe6" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ only" :db/id #edb/ref 17592186550841} {:answer/id #uuid "ce51276c-e4d8-5e7f-ad9a-e2ef4556a160" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ and $w$ only" :db/id #edb/ref 17592186550922}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$w$ only" :db/id #edb/ref 17592186550572} :answer-field/id #uuid "8c8d9e16-689e-57a7-9c40-a1537c1647fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551151}] :question/id #uuid "55574236-41f2-5d82-abc0-f140064784e6" :question/math-academy-id "q-135481" :question/problem "Which of the following are stochastic vectors?\n\n$$\nu=[\\begin{aligned}0 \\\\ 0.5\\end{aligned}],\\,v=[\\begin{aligned}-0.5 \\\\ 1.5\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 0.1 \\\\ 0.9\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$\n\nWith that in mind, let's examine our vectors in turn.\n\n- Vector $u$ is *not*  a stochastic vector since the entries do not add up to one:\n\n$$\n0+0.5=0.5\\ne 1\n$$\n\n- Vector $v$ is *not* a stochastic vector since it contains negative entries.\n\n- Vector $w$ is a stochastic vector. Indeed, \n\n- its entries are all nonnegative, and\n\n- the entries add up to one:\n\n$$\n0+0.1+0.9=1\n$$\n\nTherefore, the correct answer is \"$w$ only.\""} {:db/id #edb/ref 17592186551290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4216f855-abd4-509e-b9fe-1f121e941dc6" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186550523} {:answer/id #uuid "634b88fd-fbd1-55cf-a285-25f45e9c0447" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186550606} {:answer/id #uuid "7140a834-dbc4-5e37-81b0-24348554cc3b" :answer/type {:db/ident :answer.type/text} :answer/value "$U,$ $V,$ and $W$ only" :db/id #edb/ref 17592186550652} {:answer/id #uuid "76d69def-a627-5cf5-94e5-9d688f380f9c" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186550667} {:answer/id #uuid "9748d7be-c943-5b7a-8ed6-ed3b73afb63f" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186550752}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186550752} :answer-field/id #uuid "9b9b2d59-8140-5362-8fc0-b70ab471b530" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551158}] :question/id #uuid "718b908f-f156-56c4-954e-a24b1b0d0bf9" :question/math-academy-id "q-135486" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=[\\begin{aligned}0.1 & 0.7 \\\\ 0.9 & 0.3\\end{aligned}],\\,V=[\\begin{aligned}0.45 & 0.35 \\\\ 0.25 & 0.65\\end{aligned}],\\,W=[\\begin{aligned}0 & -1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are nonnegative and add up to one): \n\n$$\n\\begin{aligned}[\\begin{aligned}0.1 & 0.7 \\\\ 0.9 & 0.3\\end{aligned}]\\,\\begin{aligned}0.1+0.9=1 \\\\ 0.7+0.3=1\\end{aligned}\\end{aligned}\n$$\n\n- Matrix $V$ is *not* a stochastic matrix since its first column is not a stochastic vector (the corresponding entries don't add up to one): \n\n$$\n[\\begin{aligned}0.45 & 0.35 \\\\ 0.25 & 0.65\\end{aligned}]\n$$\n\n- Matrix $W$  *not* a stochastic matrix since its second column is not a stochastic vector (it contains negative entries):\n\n$$\n[\\begin{aligned}0 & -1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$U$ only.\""}] :knowledge-point/title "Identifying Stochastic Vectors and Stochastic Matrices"}] :topic/math-academy-id 1911 :topic/title "Markov Chains"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186134963} :activity/id #uuid "ca0a3eea-55f5-5163-8729-4bb826d5ef6e" :activity/steps [{:db/id #edb/ref 17592186134963 :step/content {:db/id #edb/ref 17592186135177 :tutorial/content "Suppose we have a square $n\\times n$ matrix $Q$ with columns $\\mathbf{q}_1, \\mathbf{q}_2, \\ldots, \\mathbf{q}_n{:}$\n\n![](images/1b/1b69d138277cdd7ee291aaa70b81849dee28fa7112b821beaaab2235cde6c17b.svg)\n\nThe matrix $Q$ is said to be **orthogonal** if its columns $\\mathbf{q}_1, \\mathbf{q}_2, \\dots, \\mathbf{q}_n$ form an *orthonormal* set. In other words, \n\n- the columns of $Q$ must be *mutually orthogonal*, and\n\n- they must all be *unit* vectors.\n\nFor instance, the matrix \n![](images/8c/8c5cdeffc5e91988c140e53623b252c100f86e573a4f2c5a761b5e7667cce9ef.svg) \nis orthogonal since its columns \n\n![](images/87/874cd61d37f79fc732f36b7b3a2578b4957dde1a364522674cb3c93fe4c50ae8.svg)\n\nform an orthonormal set $\\left\\{ {\\color{black}\\mathbf{q}_1}, {\\color{black}\\mathbf{q}_2} \\right\\}.$ To see this, note the following:\n\n- The vectors $\\mathbf q_1$ and $\\mathbf q_2$ are orthogonal, since\n\n$$\n\\begin{aligned}{q}_{1}\\cdot {q}_{2} & =\\begin{bmatrix}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{1}{2} \\\\ \\frac{\\sqrt{3}}{2}\\end{bmatrix} \\\\  & =(\\frac{\\sqrt{3}}{2})\\cdot (-\\frac{1}{2})+(\\frac{1}{2})\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\sqrt{3}}{4}+\\frac{\\sqrt{3}}{4} \\\\  & =0.\\end{aligned}\n$$\n\n- Both $\\mathbf q_1$ and $\\mathbf q_2$ are unit vectors, since\n\n$$\n\\begin{aligned}||{q}_{1}|{|}^{2} & ={q}_{1}\\cdot {q}_{1} \\\\  & =\\begin{bmatrix}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{bmatrix} \\\\  & ={(\\frac{\\sqrt{3}}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\  & =\\frac{3}{4}+\\frac{1}{4} \\\\  & =1,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}||{q}_{2}|{|}^{2} & ={q}_{2}\\cdot {q}_{2} \\\\  & =\\begin{bmatrix}-\\frac{1}{2} \\\\ \\frac{\\sqrt{3}}{2}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{1}{2} \\\\ \\frac{\\sqrt{3}}{2}\\end{bmatrix} \\\\  & ={(-\\frac{1}{2})}^{2}+{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =\\frac{1}{4}+\\frac{3}{4} \\\\  & =1.\\end{aligned}\n$$" :tutorial/id #uuid "6e985a62-c62b-5e6d-8c21-8c92fc9d0eca" :tutorial/math-academy-id 8095 :tutorial/title "Introduction"} :step/id #uuid "baea1d10-b335-5c05-873c-8c3781704792" :step/next {:db/id #edb/ref 17592186134974}} {:db/id #edb/ref 17592186134964 :step/content {:db/id #edb/ref 17592186133948 :knowledge-point/id #uuid "b9017b4e-ddb3-56f6-ba30-b494a7e4e09f"} :step/id #uuid "1b964665-b339-5ff4-aa19-0e0879ae4c03" :step/next {:db/id #edb/ref 17592186134967}} {:db/id #edb/ref 17592186134965 :step/content {:db/id #edb/ref 17592186135178 :tutorial/content "Orthogonal matrices also have the following important properties:\n\n- $\\det(Q)=\\pm1$ (the determinant of an orthogonal matrix is either $1$ or $-1$)\n\n- If $\\lambda$ is an eigenvalue of an orthogonal matrix $Q,$ then $| \\lambda |= 1 .$\n\n**Watch out!** These properties are necessary *but not sufficient* conditions:\n\n- Every orthogonal matrix has determinant equal to $\\pm 1$, but not every matrix with determinant $\\pm 1$ is orthogonal!\n\n- Similarly, every orthogonal matrix has eigenvalues $1$ or $-1$ only, but not every matrix with eigenvalues $1$ or $-1$ is orthogonal." :tutorial/id #uuid "40e97f72-22ae-5b05-b248-5575125c1f7f" :tutorial/math-academy-id 8096 :tutorial/title "Properties of Orthogonal Matrices"} :step/id #uuid "e3828614-c6de-5b63-8d62-801b458873a0" :step/next {:db/id #edb/ref 17592186134966}} {:db/id #edb/ref 17592186134966 :step/content {:db/id #edb/ref 17592186133949 :knowledge-point/id #uuid "ee00be0e-f6a2-5269-a36d-1eeaf1b32344"} :step/id #uuid "3f5d49dd-17a8-5f53-9f58-22af80e495a7" :step/next {:db/id #edb/ref 17592186134969}} {:db/id #edb/ref 17592186134967 :step/content {:db/id #edb/ref 17592186135179 :tutorial/content "Recall the following theorem:\n\n*A matrix $Q$ is orthogonal if and only if*\n\n$$\nQ \\cdot {\\color{blue}{Q^T}} = {\\color{blue}{Q^T}} \\cdot Q = I.\n$$\n\nNow, recall that for $Q$ to be invertible, there must exist a matrix $Q^{-1}$ such that\n\n$$\nQ \\cdot {\\color{blue}{Q^{-1}}} = {\\color{blue}{Q^{-1}}} \\cdot Q = I.\n$$\n\nBy comparing the two equations above, we can deduce the following:\n\n- Every orthogonal matrix $Q$ is invertible, and\n\n- the inverse of an orthogonal matrix $Q$ is ${\\color{blue}{Q^T}},$ that is\n\n$$\nQ^{-1} = Q^T.\n$$\n\nThese properties explain why orthogonal matrices are desirable. We can always find the inverse of an orthogonal matrix, and we can quickly compute the inverse by simply transposing the original matrix." :tutorial/id #uuid "90b27dd6-cc1a-5dce-8437-3591d747d64f" :tutorial/math-academy-id 8097 :tutorial/title "The Inverse of an Orthogonal Matrix"} :step/id #uuid "062775af-7380-574c-8ecb-f0cc3b8fea6c" :step/next {:db/id #edb/ref 17592186134968}} {:db/id #edb/ref 17592186134968 :step/content {:db/id #edb/ref 17592186133950 :knowledge-point/id #uuid "f2a22cfc-9a78-57ab-93a4-3c3255c34bf7"} :step/id #uuid "44dc7741-7fa8-58c7-8b4a-4570be6f5f12" :step/next {:db/id #edb/ref 17592186134965}} {:db/id #edb/ref 17592186134969 :step/content {:db/id #edb/ref 17592186133951 :knowledge-point/id #uuid "da20ffe7-173b-5fc0-8629-3b9b70222860"} :step/id #uuid "7dc9b452-5374-5f91-9f38-dabff8c23307"} {:db/id #edb/ref 17592186134974 :step/content {:db/id #edb/ref 17592186135182 :tutorial/content "Checking that the columns of $Q$ form an orthonormal set is a fair amount of work. Thankfully, we have the following theorem to make our lives easier: \n\n*A matrix $Q$ is orthogonal if and only if*\n\n$$\nQ \\cdot Q^T = Q^T \\cdot Q = I\n$$\n\nNote the following:\n\n- $Q^T$ denotes the transpose of $Q.$  It's the matrix we get when we interchange the rows and columns of $Q.$\n\n- To verify that a matrix is orthogonal in practice, we only need to check that $Q \\, Q^T = I.$\n\nLet's see an example of applying this theorem." :tutorial/id #uuid "b840b2b3-6615-5d30-96ea-42b4e51360f2" :tutorial/math-academy-id 8173 :tutorial/title "A Straightforward Test of Orthogonality"} :step/id #uuid "d5ca3a24-e2ca-5b76-8ea8-93b5a8d9b6e0" :step/next {:db/id #edb/ref 17592186134964}}] :activity/title "Orthogonal Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186133992} {:activity/first-step {:db/id #edb/ref 17592186521572} :activity/id #uuid "40997d44-940a-52f1-8654-3ad1000fd7b5" :activity/steps [{:db/id #edb/ref 17592186521572 :step/content {:db/id #edb/ref 17592186134226 :question/id #uuid "28eca231-06c6-5db5-8cec-335cddc2ad41"} :step/id #uuid "057e2df5-62de-5772-a9be-1e31132f5c72" :step/next {:db/id #edb/ref 17592186521626}} {:db/id #edb/ref 17592186521600 :step/content {:db/id #edb/ref 17592186354338 :question/id #uuid "338bf787-fdf7-5cae-8c88-ce44fc0beac0"} :step/id #uuid "5c859452-c242-51fd-8f27-755ab3b53b24"} {:db/id #edb/ref 17592186521613 :step/content {:db/id #edb/ref 17592186366483 :question/id #uuid "e6401598-f82b-58db-b408-23496dde6519"} :step/id #uuid "734bd8c7-6cda-5908-8980-183fb1942573" :step/next {:db/id #edb/ref 17592186521622}} {:db/id #edb/ref 17592186521622 :step/content {:db/id #edb/ref 17592186354334 :question/id #uuid "4787a532-15b1-5c33-ada2-7b169aff9333"} :step/id #uuid "8d0835ae-d91c-5c36-b4d2-e4d86cb27fd8" :step/next {:db/id #edb/ref 17592186521600}} {:db/id #edb/ref 17592186521626 :step/content {:db/id #edb/ref 17592186521553 :question/id #uuid "d61adfc9-5b12-5408-9a76-aa7eede82be4"} :step/id #uuid "a0dd7217-b8aa-50b8-a492-e108a3a2b002" :step/next {:db/id #edb/ref 17592186521613}}] :activity/title "Orthogonal Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186520751}] :db/id #edb/ref 17592186049606 :topic/knowledge-points [{:db/id #edb/ref 17592186133948 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133503 :question/id #uuid "00b886e2-e15e-5b9e-a371-7c8e659febb1" :question/math-academy-id "e-12947" :question/problem "![](images/dc/dc96a7656f4725f266f66c74752504b9b926b21215899cb4e62548f5c748ce4e.svg)\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\nI. $A$ is a square matrix\n\nII. $A \\cdot A^T = I$\n\nIII. $A$ is an orthogonal matrix" :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA \\cdot A^T = A^T\\cdot A = I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement I is true. The number of rows in $A$ is the same as the number of columns. So, it's a square matrix.\n\n- Statement II is true. Indeed,\n![](images/c7/c7cae63465ded2fe22d8ad21e22458042b3324f820ce2efcbe80df061cfecaeb.svg)\n\n- Statement III is true. Since $A\\cdot A^T = I,$ our matrix is orthogonal.\n\nTherefore, the correct answer is \"I, II, and III.\""} :knowledge-point/id #uuid "b9017b4e-ddb3-56f6-ba30-b494a7e4e09f" :knowledge-point/questions [{:db/id #edb/ref 17592186134145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b805d1a2-bb33-5257-a280-f039c5e15d3f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186131012} {:answer/id #uuid "e3270ac4-64c6-5eea-9650-4e11888001c7" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186131013} {:answer/id #uuid "e616815b-103e-54a1-a63e-753435dea6cd" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186131014} {:answer/id #uuid "f7e363ef-f5d1-5efb-9cf9-9ea1b246f55c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186131015} {:answer/id #uuid "6f91129a-c61f-513a-be22-0d913bc609b7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186131016}] :answer-field/id #uuid "eaff0759-8c5c-5436-aee5-1bc97ad84d09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131011}] :question/id #uuid "c85d2016-702e-57d5-b88e-4f900fe43f76" :question/math-academy-id "q-176873" :question/problem "$A = \\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\n1. $A$ is a square matrix\n2. $A \\cdot A^{T} = I$\n3. $A$ is an orthogonal matrix"} {:db/id #edb/ref 17592186134146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb3c5ad3-5294-5142-97b2-6b8bfdc08545" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186131018} {:answer/id #uuid "d2020022-fe64-5afe-9620-d78c53c4c5f7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186131019} {:answer/id #uuid "fba3dc0f-17aa-53e9-a92d-c271bba87e60" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186131020} {:answer/id #uuid "5e5f3192-f1b7-511e-a0a3-16b2d59b899d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186131021} {:answer/id #uuid "5f523a7a-62b0-57fb-8eb9-200e119b6acc" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186131022}] :answer-field/id #uuid "862a38c9-10d5-52bb-bf1d-a7e34330402a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131017}] :question/id #uuid "ddbf9cd2-f17b-58ad-9193-b518f439b014" :question/math-academy-id "q-176874" :question/problem "$A = \\begin{bmatrix}\\frac{1}{2} & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & -\\frac{1}{2}\\end{bmatrix}$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\n1. $A$ is a square matrix\n2. $A \\cdot A^{T} = I$\n3. $A$ is an orthogonal matrix"} {:db/id #edb/ref 17592186284752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018101f5-88ee-578c-a18f-ccb93c8d48a0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450096} {:answer/id #uuid "c29f7788-c13c-5a54-a0c1-b9bc3632f0fc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450097}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450097} :answer-field/id #uuid "a15ee7f8-704f-50c7-a501-7e31a8a48730" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451002} {:answer-field/choices [{:answer/id #uuid "7fc1dfdb-574a-5d3e-8dcc-d5d199f77133" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450098} {:answer/id #uuid "44ee64b7-a9ed-57a5-9c6d-f5b74d0c9d2b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450099}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450098} :answer-field/id #uuid "8404deb2-95c0-5b00-b0a4-3ba4ca1fd885" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451003} {:answer-field/choices [{:answer/id #uuid "061b9611-610d-526d-aa04-e5f83ac6ed51" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450100} {:answer/id #uuid "a5e22063-362d-5058-bb98-b1bcb42d4106" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450101}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450100} :answer-field/id #uuid "c7fdbc26-d6af-51af-bd0e-f6efec58fa66" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451004}] :question/id #uuid "044de50e-6da8-5a08-93e7-4cbfebd23610" :question/math-academy-id "q-177658" :question/problem "$$\nA=\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is a square matrix\n- **II.** $A\\cdot {A}^{T}=I$\n- **III.** $A$ is an orthogonal matrix" :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA\\cdot {A}^{T}={A}^{T}\\cdot A=I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement I is true. The number of rows in $A$ is the same as the number of columns. So, it's a square matrix.\n\n- Statement II is false. Note that\n\n$$\nA\\cdot {A}^{T}=\\begin{bmatrix}2 & 3 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}2 & -3 \\\\ 3 & 2\\end{bmatrix}=\\begin{bmatrix}13 & 0 \\\\ 0 & 13\\end{bmatrix}\\ne I.\n$$\n\n- Statement III is false. Since $A\\cdot {A}^{T}\\ne I,$ our matrix is **not** orthogonal.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186284753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "838c5084-eb44-519f-a803-5a82f181e56f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450102} {:answer/id #uuid "21d2ed10-202f-51b3-ba91-671ffa3044b6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450103}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450103} :answer-field/id #uuid "258cc04b-5017-5949-824f-ec823acf6383" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451005} {:answer-field/choices [{:answer/id #uuid "0826a009-00f9-5adc-bce5-6f9fcda95294" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450104} {:answer/id #uuid "d1c513a9-75b1-5961-9a3b-199d701df809" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450105}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450105} :answer-field/id #uuid "067e8cef-a0a9-5385-8882-0f661b4be518" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451006} {:answer-field/choices [{:answer/id #uuid "b9638414-3798-5f91-a1d3-e5e7f0eb46de" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450106} {:answer/id #uuid "0496a90c-d5f1-5c68-8740-345ff17ec22c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450107}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450107} :answer-field/id #uuid "925d9be4-b3e2-57f7-969e-84df3d94eb40" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451007}] :question/id #uuid "d52fcd7c-0cb8-5f3b-83e6-5d87eafb229f" :question/math-academy-id "q-177660" :question/problem "$$\nA=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is a square matrix\n- **II.** $A\\cdot {A}^{T}=I$\n- **III.** $A$ is an orthogonal matrix" :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA\\cdot {A}^{T}={A}^{T}\\cdot A=I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement I is true. The number of rows in $A$ is the same as the number of columns. So, it's a square matrix.\n\n- Statement II is true. Indeed,\n\n$$\nA\\cdot {A}^{T}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=I.\n$$\n\n- Statement III is true. Since ${A}^{T}\\cdot A=I,$ our matrix is orthogonal.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186284754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d1a953a-f5cc-5be1-84b3-69be0a7afa05" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450108} {:answer/id #uuid "64c1ca58-d0a7-51aa-9436-360d901fce42" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450109}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450109} :answer-field/id #uuid "1bed3038-b384-5d43-92b5-a0801e084f7f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451008} {:answer-field/choices [{:answer/id #uuid "387af6f7-f068-535a-b1fa-30498114a5dd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450110} {:answer/id #uuid "d52bca8f-a9d5-5566-ae77-cab60157a898" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450111}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450111} :answer-field/id #uuid "969e4688-8a93-5b23-94b5-256f6e748b85" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451009} {:answer-field/choices [{:answer/id #uuid "82c9c179-5409-5d04-9678-f54cfceb9c1a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450112} {:answer/id #uuid "71370e63-41c6-524f-82b0-a8ba1bdc4344" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450113}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450113} :answer-field/id #uuid "60bc5925-c6b8-5b12-a3d1-f7e96566501c" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451010}] :question/id #uuid "c17d5c10-3940-55d7-92e1-ac427e80f858" :question/math-academy-id "q-177662" :question/problem "$$\nA=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is a square matrix\n- **II.** $A\\cdot {A}^{T}=I$\n- **III.** $A$ is an orthogonal matrix" :question/worked-solution "Recall that a square matrix $A$ is **orthogonal** if and only if\n\n$$\nA\\cdot {A}^{T}={A}^{T}\\cdot A=I\n$$\n\nwhere $I$ is the identity matrix.\n\nWith that in mind, let's examine the given statements. \n\n- Statement I is true. The number of rows in $A$ is the same as the number of columns. So, it's a square matrix.\n\n- Statement II is true. Indeed,\n\n$$\nA\\cdot {A}^{T}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=I.\n$$\n\n- Statement III is true. Since ${A}^{T}\\cdot A=I,$ our matrix is orthogonal.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186284755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b83cbcb7-0b07-5ebc-aa53-89e2be0b52df" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450114} {:answer/id #uuid "a563d8ec-88fc-5fd2-9125-f7a62ee49b1f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450115}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450115} :answer-field/id #uuid "f129ca4a-c8e7-580b-91d4-1a0d29e6e4ed" :answer-field/key "I" :answer-field/type {: