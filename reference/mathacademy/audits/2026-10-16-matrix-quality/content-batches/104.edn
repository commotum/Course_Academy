b/ref 17592186504741}} {:db/id #edb/ref 17592186504741 :step/content {:db/id #edb/ref 17592186367443 :question/id #uuid "b9b18fd2-40c6-532b-a289-0305c371077f"} :step/id #uuid "fbf9bf75-5bbc-570d-b638-4b8e78bce342" :step/next {:db/id #edb/ref 17592186504713}}] :activity/title "The Least-Squares Solution of a Linear System (With Collinearity)" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186504028} {:activity/first-step {:db/id #edb/ref 17592186538044} :activity/id #uuid "86690471-d357-5c6d-a479-0d9d6dca4cdc" :activity/steps [{:db/id #edb/ref 17592186538042 :step/content {:db/id #edb/ref 17592186269135 :question/id #uuid "a9599aec-b36e-5461-9425-547d03dffdb7"} :step/id #uuid "a688d4f0-219c-53ce-8859-4cf2cfa1b6e7" :step/next {:db/id #edb/ref 17592186538049}} {:db/id #edb/ref 17592186538043 :step/content {:db/id #edb/ref 17592186134374 :question/id #uuid "00e4806c-b4ce-579d-8d0e-03b84320da38"} :step/id #uuid "a9d99bb3-bbe7-5cd2-986b-c2d9fa71e9d6" :step/next {:db/id #edb/ref 17592186538042}} {:db/id #edb/ref 17592186538044 :step/content {:db/id #edb/ref 17592186326913 :question/id #uuid "85d7c223-d931-53ec-98fb-80a06e5b2764"} :step/id #uuid "aa620879-5cfd-5e7d-a99d-239929c57208" :step/next {:db/id #edb/ref 17592186538043}} {:db/id #edb/ref 17592186538049 :step/content {:db/id #edb/ref 17592186424019 :question/id #uuid "4cb13173-852b-58a2-8c1f-3d6511a05fac"} :step/id #uuid "ba011249-f521-57db-a1bf-2b091aa5de6e" :step/next {:db/id #edb/ref 17592186538056}} {:db/id #edb/ref 17592186538056 :step/content {:db/id #edb/ref 17592186367436 :question/id #uuid "8e0db89b-f0c6-50f0-a4df-0e579944e4eb"} :step/id #uuid "c9b55ea0-c7ec-5e84-a315-6b02347bb893"}] :activity/title "The Least-Squares Solution of a Linear System (With Collinearity)" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186537213} {:activity/first-step {:db/id #edb/ref 17592186554740} :activity/id #uuid "dfbcc6d4-aa47-5bf7-a3cb-e2c9e5257f13" :activity/steps [{:db/id #edb/ref 17592186554665 :step/content {:db/id #edb/ref 17592186134105 :question/id #uuid "c5084be9-ec71-5d1f-a612-cc093e9f2408"} :step/id #uuid "3b38d3ba-b3fc-5a7a-a4cc-f7a07636c5f2"} {:db/id #edb/ref 17592186554700 :step/content {:db/id #edb/ref 17592186326896 :question/id #uuid "5b6fc54b-cb36-5749-9df6-d5883bd36fd6"} :step/id #uuid "8a4eb61b-cd4e-51aa-a92c-b2f72c08f03f" :step/next {:db/id #edb/ref 17592186554739}} {:db/id #edb/ref 17592186554717 :step/content {:db/id #edb/ref 17592186134374 :question/id #uuid "00e4806c-b4ce-579d-8d0e-03b84320da38"} :step/id #uuid "a7457c42-668c-5326-bdf6-c03519363ce9" :step/next {:db/id #edb/ref 17592186554665}} {:db/id #edb/ref 17592186554739 :step/content {:db/id #edb/ref 17592186134372 :question/id #uuid "80e97aa1-dac8-53af-afe4-09e324e932eb"} :step/id #uuid "d8e8a02e-385c-546e-a7e7-66e3e6ee2675" :step/next {:db/id #edb/ref 17592186554717}} {:db/id #edb/ref 17592186554740 :step/content {:db/id #edb/ref 17592186326895 :question/id #uuid "c3df77ba-fc93-5eb8-9827-0c8cef3d9027"} :step/id #uuid "db25a48d-03e1-551c-b686-ab08530dbada" :step/next {:db/id #edb/ref 17592186554700}}] :activity/title "The Least-Squares Solution of a Linear System (With Collinearity)" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186553863}] :db/id #edb/ref 17592186049557 :topic/knowledge-points [{:db/id #edb/ref 17592186133801 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133610 :question/id #uuid "cb31a55d-6107-509a-80e2-9bdffcaff6e3" :question/math-academy-id "e-5590" :question/problem "![](images/16/169c756c5420efe2234b3f20da794cc77e45f24c27cfafadfdf899ea9330c986.svg)\n\nConsider the matrix $A$ and vector $\\mathbf{b}$ shown above. Find the general least-squares solution of the system $A\\mathbf{x}=\\mathbf{b}.$" :question/worked-solution "The least-squares solution of $A\\mathbf{x}=\\mathbf{b}$ satisfies the corresponding normal equation:\n\n$$\nA^T \\! A\\mathbf{x} = A^T\\mathbf{b}\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 2 \\\\ -3 & 3 & -6\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ -1 & 3 \\\\ 2 & -6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & 2 \\\\ -3 & 3 & -6\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -18 \\\\ -18 & 54\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ 12\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -18 & -4 \\\\ -18 & 54 & 12\\end{bmatrix} & {R}_{2}:={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & -18 & -4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, $x_2$ is a free variable. From the first equation, we have \n\n$$\nx_1=-\\dfrac{2}{3}+3x_2.\n$$\n\nHence, the general solution is\n\n![](images/8c/8c70b499e599314c309470a3a46b99ab3172774886aa08c5dccffac0f130721b.svg)"} :knowledge-point/id #uuid "9642ac63-6925-5ea3-925d-e697a6222064" :knowledge-point/questions [{:db/id #edb/ref 17592186134332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ec9bd3-99d5-5104-8812-7b53252709d6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324385} {:answer/id #uuid "444cc429-dfb0-5a5b-b8d4-d4fc2403cd81" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324522} {:answer/id #uuid "4c018f0f-7adf-5ead-8130-41b36d9554f7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324593} {:answer/id #uuid "67fb75dd-92e4-5c22-83db-40e298fd59cd" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324838} {:answer/id #uuid "e675d251-277e-5b93-99a7-e7f84b39dcf3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186326002}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324838} :answer-field/id #uuid "5027b317-01e3-5fb7-adb1-b9069ee0de3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326354}] :question/id #uuid "da9cd726-dc83-58c0-961c-2d8f4017268b" :question/math-academy-id "q-40941" :question/problem "$$\nA=\\begin{bmatrix}2 & 4 \\\\ -1 & -2 \\\\ 1 & 2 \\\\ -3 & -6\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $6a+\\frac{b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & -1 & 1 & -3 \\\\ 4 & -2 & 2 & -6\\end{bmatrix}\\begin{bmatrix}2 & 4 \\\\ -1 & -2 \\\\ 1 & 2 \\\\ -3 & -6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & -1 & 1 & -3 \\\\ 4 & -2 & 2 & -6\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}15 & 30 \\\\ 30 & 60\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}10 \\\\ 20\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}15 & 30 & 10 \\\\ 30 & 60 & 20\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}15 & 30 & 10 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{2}{3}-2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{2}{3}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n6a+\\frac{b}{c}=6\\cdot \\frac{2}{3}+\\frac{(-2)}{1}=2.\n$$"} {:db/id #edb/ref 17592186134333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2563641c-3674-599a-bc9b-6a7ff8dc6db8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324278} {:answer/id #uuid "3380e44e-eb6f-5319-9afd-04efe1186590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186324383} {:answer/id #uuid "4a8960b7-70fe-5198-ad4d-9a451b90165c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324576} {:answer/id #uuid "d91bf06c-7c91-517f-8dda-93fec52181f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325860} {:answer/id #uuid "f579c837-0e7b-5922-9481-0a119644e5dd" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186326131}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325860} :answer-field/id #uuid "a6ad0704-99f4-509f-bb7d-ffd14144c5c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326518}] :question/id #uuid "871a1be1-8f4a-5616-a788-c400e98cd9b7" :question/math-academy-id "q-40943" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 & 1 \\\\ -1 & 2 & -1 \\\\ 2 & -2 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}2 \\\\ b \\\\ c\\end{bmatrix}+{x}_{3}\\begin{bmatrix}a \\\\ 1 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R\n$$\n\nwhat is the value of $a+2b+c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 2 & -2 \\\\ 1 & -1 & 0\\end{bmatrix}\\begin{bmatrix}1 & -2 & 1 \\\\ -1 & 2 & -1 \\\\ 2 & -2 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 2 & -2 \\\\ 1 & -1 & 0\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -8 & 2 \\\\ -8 & 12 & -4 \\\\ 2 & -4 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -8 & 2 & 0 \\\\ -8 & 12 & -4 & 2 \\\\ 2 & -4 & 2 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & -4 & 2 & -2 \\\\ -8 & 12 & -4 & 2 \\\\ 6 & -8 & 2 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+4{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & -4 & 2 & -2 \\\\ 0 & -4 & 4 & -6 \\\\ 0 & 4 & -4 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-1){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & -4 & 2 & -2 \\\\ 0 & -4 & 4 & -6 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we have \n\n$$\n{x}_{2}=\\frac{3}{2}+{x}_{3}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n2{x}_{1}-4(\\frac{3}{2}+{x}_{3})+2{x}_{3}=-2\\,⟹\\,{x}_{1}=2+{x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}2+{x}_{3} \\\\ \\frac{3}{2}+{x}_{3} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}2 \\\\ \\frac{3}{2} \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+2b+c=1+2\\cdot \\frac{3}{2}+0=4.\n$$"} {:db/id #edb/ref 17592186269136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5a9c23-8d4c-5a61-af41-8b6d2c96bcb7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266659} {:answer/id #uuid "b2fa2a26-e812-549e-8835-6295aa5319d0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267747} {:answer/id #uuid "cf723ad7-5492-59ea-aec1-79f455aab318" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267999} {:answer/id #uuid "db4cc96a-2085-57a1-9317-5c474924f1e3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186268084} {:answer/id #uuid "f40e0d44-f7ca-5e19-a8b9-8693564691ec" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186268312}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267999} :answer-field/id #uuid "d11dceef-fa44-5f21-b07d-72b4a644c05f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268782}] :question/id #uuid "ef71613a-c794-54f5-9a74-68efbe48ffea" :question/math-academy-id "q-137034" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & -2 & -2\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}a \\\\ -\\frac{1}{5} \\\\ b\\end{bmatrix}\\,+\\,{x}_{3}\\begin{bmatrix}0 \\\\ c \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R,\n$$\n\nwhat is the value of $a+2b+c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b.\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & -2 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 5 & 5 \\\\ 0 & 5 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 0 & 1 \\\\ 0 & 5 & 5 & -1 \\\\ 0 & 5 & 5 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 1 \\\\ 0 & 5 & 5 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{5}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 1 \\\\ 0 & 1 & 1 & -\\frac{1}{5} \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable.\n\nFrom the second row, we have \n\n$$\n{x}_{2}+{x}_{3}=-\\frac{1}{5}\\,⟹\\,{x}_{2}=-\\frac{1}{5}-{x}_{3}.\n$$\n\nFrom the first row, we obtain\n\n$$\n{x}_{1}=1.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -\\frac{1}{5}-{x}_{3} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -\\frac{1}{5} \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+2b+c=1+2\\cdot 0+(-1)=0.\n$$"} {:db/id #edb/ref 17592186326894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027310f9-ee0d-507a-bc28-d9da862bc3bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186323994} {:answer/id #uuid "13cbf72a-775b-5500-b4ce-fd7dee8abc45" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324150} {:answer/id #uuid "6058f5f8-765c-528f-b9e3-77d370e52e5f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186324776} {:answer/id #uuid "df18dbbf-d1af-5d62-9ba8-07e3f6047abf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325920} {:answer/id #uuid "df1f5f2f-9dda-564b-8601-3ba072795d25" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325921}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186323994} :answer-field/id #uuid "58847018-c5c9-5b9a-9650-5b07e75b721b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326372}] :question/id #uuid "d34cdae0-7b23-59fc-a8bc-f0d99444106f" :question/math-academy-id "q-40921" :question/problem "$$\nA=\\begin{bmatrix}-3 & 1 \\\\ 6 & -2 \\\\ -3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ -5\\end{bmatrix}.\n$$\n\n \n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $3a+\\frac{b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-3 & 6 & -3 \\\\ 1 & -2 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 1 \\\\ 6 & -2 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 & 6 & -3 \\\\ 1 & -2 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ -5\\end{bmatrix} \\\\ \\begin{bmatrix}54 & -18 \\\\ -18 & 6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}12 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}54 & -18 & 12 \\\\ -18 & 6 & -4\\end{bmatrix} & {R}_{2}:={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}54 & -18 & 12 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{2}{9}+\\frac{1}{3}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{2}{9}+\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{9} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{3} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n3a+\\frac{b}{c}=3\\cdot \\frac{2}{9}+\\frac{(\\frac{1}{3})}{1}=1.\n$$"} {:db/id #edb/ref 17592186326895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10eb91a6-2d3a-53b3-b073-a10d66decb1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186324127} {:answer/id #uuid "398c42e6-61f6-5edb-a6af-56df8a41a08f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324439} {:answer/id #uuid "70e7b5cd-ce67-5487-8c59-0136c6664fc6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324901} {:answer/id #uuid "73b39860-f650-5a09-8af5-6cb9c76b62c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186324931} {:answer/id #uuid "9fba6c6f-ee94-52be-9456-59da4a7eee4c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186325329}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324439} :answer-field/id #uuid "7b1a7497-9e7d-5e11-87dd-d6334e26484a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326441}] :question/id #uuid "c3df77ba-fc93-5eb8-9827-0c8cef3d9027" :question/math-academy-id "q-40923" :question/problem "$$\nA=\\begin{bmatrix}3 & -1 \\\\ 6 & -2 \\\\ 3 & -1 \\\\ -6 & 2\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 0 \\\\ 1 \\\\ 4\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $-10a+\\frac{6b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}3 & 6 & 3 & -6 \\\\ -1 & -2 & -1 & 2\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ 6 & -2 \\\\ 3 & -1 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 & 6 & 3 & -6 \\\\ -1 & -2 & -1 & 2\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}90 & -30 \\\\ -30 & 10\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-27 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}90 & -30 & -27 \\\\ -30 & 10 & 9\\end{bmatrix} & {R}_{2}:={R}_{2}+\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}90 & -30 & -27 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have  \n\n$$\n{x}_{1}=-\\frac{3}{10}+\\frac{1}{3}{x}_{2}.\n$$\n\nHence, the general solution is \n\n$$\n\\begin{bmatrix}-\\frac{3}{10}+\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{3}{10} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{3} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-10a+\\frac{6b}{c}=-10\\cdot (-\\frac{3}{10})+\\frac{6\\cdot (\\frac{1}{3})}{1}=5.\n$$"} {:db/id #edb/ref 17592186326896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a2e5c9-1ec3-53d7-9d65-67e652469f37" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324010} {:answer/id #uuid "48074d8b-44cf-5ab6-976d-e49c216938d8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324554} {:answer/id #uuid "5dad58d2-2933-50ed-bf94-504e98ebf78f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324749} {:answer/id #uuid "c15de438-95e3-56a6-9a64-f99e256f9c2f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186325633} {:answer/id #uuid "e20db4f3-7b86-5a65-991a-7ed79cec5074" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325952}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324749} :answer-field/id #uuid "74ca8095-e929-5df1-909d-a6fa762d4c42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326428}] :question/id #uuid "5b6fc54b-cb36-5749-9df6-d5883bd36fd6" :question/math-academy-id "q-40927" :question/problem "$$\nA=\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $-2a+\\frac{b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}30 & -60 \\\\ -60 & 120\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-15 \\\\ 30\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ -2 & 4 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{2}+2{x}_{2}.\n$$\n\n Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-2a+\\frac{b}{c}=-2\\cdot (-\\frac{1}{2})+\\frac{2}{1}=3.\n$$"} {:db/id #edb/ref 17592186326897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c8cf07-1252-5e91-b5c9-12f38c1f946f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324034} {:answer/id #uuid "91384dd4-5bcc-5860-814c-f96556460493" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325204} {:answer/id #uuid "93d14029-007f-54bd-9d2a-0c82c9066807" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325227} {:answer/id #uuid "a9f7e58b-5b63-5e1f-ae19-6232045969c6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186325419} {:answer/id #uuid "b3759c15-e036-5c30-848d-c2b42024912f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325509}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324034} :answer-field/id #uuid "6314ea6d-cf55-58df-9abc-6434d47d5c83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326389}] :question/id #uuid "db567127-1e8b-50cb-a3d2-dc5e2ea462cd" :question/math-academy-id "q-40950" :question/problem "$$\nA=\\begin{bmatrix}-2 & 1 & 1 \\\\ 2 & -1 & 1 \\\\ 2 & -1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 2 \\\\ 4\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}b \\\\ c \\\\ 1\\end{bmatrix}\\,+\\,{x}_{2}\\begin{bmatrix}a \\\\ 1 \\\\ 0\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $2a-3b-6c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b.\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-2 & 2 & 2 \\\\ 1 & -1 & -1 \\\\ 1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}-2 & 1 & 1 \\\\ 2 & -1 & 1 \\\\ 2 & -1 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 & 2 & 2 \\\\ 1 & -1 & -1 \\\\ 1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}12 & -6 & 0 \\\\ -6 & 3 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}12 \\\\ -6 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}12 & -6 & 0 & 12 \\\\ -6 & 3 & 0 & -6 \\\\ 0 & 0 & 2 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=2{R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}12 & -6 & 0 & 12 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}↔{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}12 & -6 & 0 & 12 \\\\ 0 & 0 & 2 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=(1/6){R}_{1} \\\\ {R}_{2}:=(1/2){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & -1 & 0 & 2 \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $3$rd). Thus, ${x}_{2}$ is a free variable.  \n\nFrom the third row, we have\n\n$$\n{x}_{3}=1,\n$$\n\nand from the first row we obtain\n\n$$\n2{x}_{1}-{x}_{2}=2\\,⟹\\,{x}_{1}=1+\\frac{{x}_{2}}{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}1+\\frac{{x}_{2}}{2} \\\\ {x}_{2} \\\\ 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{2} \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n2a-3b-6c=2(\\frac{1}{2})-3(1)-6(0)=-2.\n$$"} {:db/id #edb/ref 17592186326913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c20af83-4b36-5128-89ee-a2b0f277470a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324458} {:answer/id #uuid "58d3b34f-653e-5908-8110-49345a2e51c6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186324708} {:answer/id #uuid "5c3eb528-5cf9-526f-857f-315ec81f0eb3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324735} {:answer/id #uuid "b0bbe617-b13b-516f-806c-a9356a26279f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325479} {:answer/id #uuid "c5751e84-51f5-5505-bf51-a2e74963787c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325674}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325479} :answer-field/id #uuid "ac5ff18b-ee0a-5c8e-a1ac-a863dbac8c0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326532}] :question/id #uuid "85d7c223-d931-53ec-98fb-80a06e5b2764" :question/math-academy-id "q-41904" :question/problem "$$\nA=\\begin{bmatrix}4 & -2 \\\\ -2 & 1 \\\\ -4 & 2 \\\\ 2 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 2 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $15a+\\frac{b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}4 & -2 & -4 & 2 \\\\ -2 & 1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}4 & -2 \\\\ -2 & 1 \\\\ -4 & 2 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 & -2 & -4 & 2 \\\\ -2 & 1 & 2 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2 \\\\ -1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}40 & -20 \\\\ -20 & 10\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}10 & -5 & 1 \\\\ -10 & 5 & -1\\end{bmatrix} & {R}_{2}:={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}10 & -5 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{1}{10}+\\frac{1}{2}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{10}+\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{10} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n15a+\\frac{b}{c}=15\\cdot \\frac{1}{10}+\\frac{(\\frac{1}{2})}{1}=2.\n$$"} {:db/id #edb/ref 17592186367436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c464ae52-c792-5966-9d49-a2e4829b9b98" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186367438} {:answer/id #uuid "60181620-1848-5691-9b01-0836bdae2569" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186367439} {:answer/id #uuid "1ffce98a-3785-54ef-a67a-a79256e5e528" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186367440} {:answer/id #uuid "61d68627-501b-5d8d-a22c-84fdf7f0c3a4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186367441} {:answer/id #uuid "5a336a5d-1d0b-5110-8865-6d48c421f50f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186367442}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186367440} :answer-field/id #uuid "ac10a081-d7a4-5b23-9a50-e6500fcd48c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367437}] :question/id #uuid "8e0db89b-f0c6-50f0-a4df-0e579944e4eb" :question/math-academy-id "q-137033" :question/problem "$$\nA=\\begin{bmatrix}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 1 & 0 & 2\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}-1 \\\\ b \\\\ c\\end{bmatrix}\\,+\\,{x}_{3}\\begin{bmatrix}a \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R,\n$$\n\nwhat is the value of $a-4b+c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b.\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 1 \\\\ -1 & 1 & 0 \\\\ 2 & -2 & 2\\end{bmatrix}\\begin{bmatrix}1 & -1 & 2 \\\\ -1 & 1 & -2 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & 1 \\\\ -1 & 1 & 0 \\\\ 2 & -2 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}3 & -2 & 6 \\\\ -2 & 2 & -4 \\\\ 6 & -4 & 12\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ -1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -2 & 6 & 0 \\\\ -2 & 2 & -4 & -1 \\\\ 6 & -4 & 12 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-2 & 2 & -4 & -1 \\\\ 3 & -2 & 6 & 0 \\\\ 6 & -4 & 12 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=-\\frac{1}{2}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & \\frac{1}{2} \\\\ 3 & -2 & 6 & 0 \\\\ 6 & -4 & 12 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-3{R}_{1} \\\\ {R}_{3}:={R}_{3}-6{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & \\frac{1}{2} \\\\ 0 & 1 & 0 & -\\frac{3}{2} \\\\ 0 & 2 & 0 & -3\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-2{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & \\frac{1}{2} \\\\ 0 & 1 & 0 & -\\frac{3}{2} \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second row, we have \n\n$$\n{x}_{2}=-\\frac{3}{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(-\\frac{3}{2})+2{x}_{3}=\\frac{1}{2}\\,⟹\\,{x}_{1}=-1-2{x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-1-2{x}_{3} \\\\ -\\frac{3}{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ -\\frac{3}{2} \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R.\n$$\n\nTherefore, we have\n\n$$\na-4b+c=-2-4\\cdot (-\\frac{3}{2})+0=4.\n$$"} {:db/id #edb/ref 17592186368554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1299ade0-03c4-5049-abac-d1b905ea647d" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186368556} {:answer/id #uuid "de3e0276-368e-58fc-81ca-2ba8066692a7" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186368557} {:answer/id #uuid "ce89137e-5a01-54bb-9780-320b4e37ec64" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186368558} {:answer/id #uuid "ce900d5f-43f0-5f77-adbc-98050b478ea1" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186368559} {:answer/id #uuid "ba8250d4-f373-5760-9fc7-2ed30b0938ab" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186368560}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186368557} :answer-field/id #uuid "1812231c-b731-57f0-8e96-cc3da0e4fe33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368555}] :question/id #uuid "8912c2e3-5605-5590-8ee8-b25e93901622" :question/math-academy-id "q-42245" :question/problem "$$\nA=\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ -1 & 1 & -2\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}-4 \\\\ b \\\\ c\\end{bmatrix}+{x}_{3}\\begin{bmatrix}a \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{3}\\in R\n$$\n\nwhat is the value of $a+b+4c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 & -1 \\\\ -1 & 1 & 1 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ -1 & 1 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & 0 & -1 \\\\ -1 & 1 & 1 \\\\ 2 & 0 & -2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}2 & -2 & 4 \\\\ -2 & 3 & -4 \\\\ 4 & -4 & 8\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -1 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & -2 & 4 & -2 \\\\ -2 & 3 & -4 & -1 \\\\ 4 & -4 & 8 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\,\\,\\begin{bmatrix}2 & -2 & 4 & -2 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\frac{1}{2}{R}_{1}\\end{aligned} \\\\  & ∼\\,\\,\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable.\n\n From the second row, we have \n\n$$\n{x}_{2}=-3.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(-3)+2{x}_{3}=-1\\,⟹\\,{x}_{1}=-4-2{x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-4-2{x}_{3} \\\\ -3 \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\na+b+4c=(-2)+(-3)+4\\cdot 0=-5.\n$$"} {:db/id #edb/ref 17592186415140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "612c1237-1d75-5779-901e-394b60ae8abc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186415123} {:answer/id #uuid "985ff754-4000-553d-84fd-3adae2a90775" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186415127} {:answer/id #uuid "a0f160c1-cc03-5355-b516-d2d19b494551" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186415129} {:answer/id #uuid "b6774fe7-0b94-51e6-8366-d780b5d12442" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186415130} {:answer/id #uuid "fe32f448-8a3a-522b-9c2c-5ad76f739b65" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186415133}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186415127} :answer-field/id #uuid "bf2aa749-d040-57c2-b657-f15f0f4f8d98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415137}] :question/id #uuid "090045f3-969e-5b87-b1e6-6f48922501d3" :question/math-academy-id "q-136945" :question/problem "$$\nA=\\begin{bmatrix}1 & -1 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 2 & 2\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 2 \\\\ -2\\end{bmatrix}.\n$$\n\n \n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is given by\n\n$$\n\\begin{bmatrix}-1 \\\\ a \\\\ b\\end{bmatrix}+{x}_{2}\\begin{bmatrix}c \\\\ 1 \\\\ 0\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $a+3b+c?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & -2 \\\\ -1 & 1 & 2 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}1 & -1 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 2 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & -1 & -2 \\\\ -1 & 1 & 2 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -6 & -4 \\\\ -6 & 6 & 4 \\\\ -4 & 4 & 4\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -2 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -6 & -4 & 2 \\\\ -6 & 6 & 4 & -2 \\\\ -4 & 4 & 4 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-4 & 4 & 4 & -4 \\\\ -6 & 6 & 4 & -2 \\\\ 6 & -6 & -4 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\frac{1}{4}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 & -1 \\\\ -6 & 6 & 4 & -2 \\\\ 6 & -6 & -4 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-6){R}_{1} \\\\ {R}_{3}:={R}_{3}+6{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 & -1 \\\\ 0 & 0 & -2 & 4 \\\\ 0 & 0 & 2 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 & -1 \\\\ 0 & 0 & -2 & 4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $3$rd). Thus, ${x}_{2}$ is a free variable. From the second equation, we have \n\n$$\n{x}_{3}=-2,\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+{x}_{2}+(-2)=-1\\,⟹\\,{x}_{1}=-1+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-1+{x}_{2} \\\\ {x}_{2} \\\\ -2\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+3b+c=0+3\\cdot (-2)+1=-5.\n$$"} {:db/id #edb/ref 17592186415143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd7515d-bc8c-5fbf-b8b7-be4ee29a026e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186415110} {:answer/id #uuid "229bfab5-ba1b-52fe-b0f1-2051f81b3eae" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186415111} {:answer/id #uuid "383d6df1-6a22-5c04-94da-26eb4b0bd68d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186415120} {:answer/id #uuid "59b52a2f-1933-53c4-9f7d-6b819b9dbb83" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186415122} {:answer/id #uuid "7818ba2a-afff-5ecd-8ff6-f5c7aa948efc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186415124}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186415124} :answer-field/id #uuid "54a4eb9e-e422-55cf-a2cc-fe7a41adc569" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415134}] :question/id #uuid "d4a26f8e-8621-57f0-b0fb-289f901931d0" :question/math-academy-id "q-136954" :question/problem "$$\nA=\\begin{bmatrix}-2 & 6 \\\\ 1 & -3 \\\\ -1 & 3\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nConsider the matrix $A$ and vector $b$ shown above. If the general least-squares solution of $Ax=b$ is \n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of $2a+\\frac{b}{c}?$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-2 & 1 & -1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}-2 & 6 \\\\ 1 & -3 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-2 & 1 & -1 \\\\ 6 & -3 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -18 \\\\ -18 & 54\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -18 & -3 \\\\ -18 & 54 & 9\\end{bmatrix} & {R}_{2}:={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & -18 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{2}+3{x}_{2}.\n$$\n\n Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}+3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$2a+\\frac{b}{c}=2\\cdot (-\\frac{1}{2})+\\frac{3}{1}=2.$"}] :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given in Matrix Form with Collinearity"} {:db/id #edb/ref 17592186133802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133611 :question/id #uuid "c5097abf-c541-5c52-85d3-1e56a4e53cb9" :question/math-academy-id "e-5591" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2} &=1 \\\\ 2{x}_{1}-8{x}_{2} &=1 \\\\ -2{x}_{1}+8{x}_{2} &=-1\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. Find the general least-squares solution of the system $A \\mathbf x = \\mathbf b.$" :question/worked-solution "First, we write our system in matrix form as $A\\mathbf{x}=\\mathbf{b},$ where \n\n![](images/9e/9e09cbd3d953c8ce24e0a4b8a2b37c90dc3fc00d20c008b64dd068737c6ff49e.svg)\n\nThe least-squares solution of $A\\mathbf{x}=\\mathbf{b}$ satisfies the corresponding normal equation:\n\n$$\nA^T \\! A\\mathbf{x} = A^T\\mathbf{b}\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 2 & -2 \\\\ 4 & -8 & 8\\end{bmatrix}\\begin{bmatrix}-1 & 4 \\\\ 2 & -8 \\\\ -2 & 8\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 2 & -2 \\\\ 4 & -8 & 8\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}9 & -36 \\\\ -36 & 144\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -12\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}9 & -36 & 3 \\\\ -36 & 144 & -12\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+4{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}9 & -36 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, $x_2$ is a free variable. From the first equation, we have \n\n$$\nx_1=\\dfrac{1}{3}+ 4x_2.\n$$\n\nHence, the general solution is\n\n![](images/bb/bb44b493b7c78eb144467289be8a7eef6f56c65ae37efcd742475c1ac0a55690.svg)"} :knowledge-point/id #uuid "8bc1e31e-5794-5ae3-8620-6bcaadde6a15" :knowledge-point/questions [{:db/id #edb/ref 17592186134105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae9b053-73a2-5eb3-b597-87d039af513d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186266808} {:answer/id #uuid "72fb8006-32f8-5a4b-b420-08bb7d248ae5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267152} {:answer/id #uuid "85f588e5-6773-5642-8c30-504849a49eca" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186267324} {:answer/id #uuid "8733d84d-cb14-50b6-a119-5848b9c83b85" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267339} {:answer/id #uuid "de87d864-0f52-58a0-9af7-835670ea9d69" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268111}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267152} :answer-field/id #uuid "dbd4b54f-5a7e-5db0-b3a7-cdc2ebd91e2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268798}] :question/id #uuid "c5084be9-ec71-5d1f-a612-cc093e9f2408" :question/math-academy-id "q-137131" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2} &=2 \\\\ {x}_{1}-4{x}_{2} &=2 \\\\ 2{x}_{1}-8{x}_{2} &=4\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $3a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 4 \\\\ 1 & -4 \\\\ 2 & -8\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 2 \\\\ 4\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 1 & 2 \\\\ 4 & -4 & -8\\end{bmatrix}\\begin{bmatrix}-1 & 4 \\\\ 1 & -4 \\\\ 2 & -8\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 1 & 2 \\\\ 4 & -4 & -8\\end{bmatrix}\\begin{bmatrix}2 \\\\ 2 \\\\ 4\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -24 \\\\ -24 & 96\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ -32\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -24 & 8 \\\\ -24 & 96 & -32\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+4{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}6 & -24 & 8 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{4}{3}+4{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{4}{3}+4{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{4}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n3a+\\frac{b}{c}=3\\cdot \\frac{4}{3}+\\frac{4}{1}=8.\n$$"} {:db/id #edb/ref 17592186134374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195f5438-dbcb-5fdf-b558-bce11648bd92" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186324187} {:answer/id #uuid "34da3d3b-8b0d-5731-9512-7880150858c2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324401} {:answer/id #uuid "acc58718-2cff-5c4d-a0a5-bc1a9d33067c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186325439} {:answer/id #uuid "cd585b41-d5de-5636-9761-c198aae3b03f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325751} {:answer/id #uuid "edef752f-66e7-582a-9d21-188b3b7ac00b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186326067}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325751} :answer-field/id #uuid "2c9ed528-04bf-5ec5-8933-3ee5c01fd349" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326296}] :question/id #uuid "00e4806c-b4ce-579d-8d0e-03b84320da38" :question/math-academy-id "q-41919" :question/problem "$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=1 \\\\ 5{x}_{1}-5{x}_{2} &=0 \\\\ 2{x}_{1}-2{x}_{2} &=0\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $30a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 5 & -5 \\\\ 2 & -2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 5 & 2 \\\\ -1 & -5 & -2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 5 & -5 \\\\ 2 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 5 & 2 \\\\ -1 & -5 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}30 & -30 \\\\ -30 & 30\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}30 & -30 & 1 \\\\ -30 & 30 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}30 & -30 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{1}{30}+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{30}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{30} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n30a+\\frac{b}{c}=30\\cdot \\frac{1}{30}+\\frac{1}{1}=2.\n$$"} {:db/id #edb/ref 17592186269137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1c90f3-c1b6-573f-ab6c-07ec11bf9f28" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266365} {:answer/id #uuid "4aab64f6-7242-5884-9cd4-b0a3a4a9143e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266805} {:answer/id #uuid "5bba4d55-7c36-5233-8c45-c58d4705d39d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266956} {:answer/id #uuid "90976ab1-62e5-54ff-a6c5-42bb9d3b1bf6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267431} {:answer/id #uuid "ba4dfd78-93dd-5e18-9a5e-04b304c3c8d8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267816}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266365} :answer-field/id #uuid "5364be24-88fb-5a2f-b7c6-4e394496b06e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268556}] :question/id #uuid "26d67fbf-4de7-566c-9152-9d1736d17888" :question/math-academy-id "q-137061" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2} &=-3 \\\\ {x}_{1}-2{x}_{2} &=1 \\\\ -5{x}_{1}+10{x}_{2} &=2\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $2a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}2 & -4 \\\\ 1 & -2 \\\\ -5 & 10\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & 1 & -5 \\\\ -4 & -2 & 10\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}30 & -60 \\\\ -60 & 120\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-15 \\\\ 30\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ -2 & 4 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{2}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n2a+\\frac{b}{c}=2\\cdot (-\\frac{1}{2})+\\frac{2}{1}=1.\n$$"} {:db/id #edb/ref 17592186269138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71872f14-7cc4-5fb9-8cf7-9ffe96aefe19" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267142} {:answer/id #uuid "725897a0-9e77-57f9-b8a9-68f56715093b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267146} {:answer/id #uuid "828574ad-8b28-58c3-ac93-daffbb878a55" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267291} {:answer/id #uuid "9d160852-1af1-56d1-8d23-a808bbfc6b00" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186267556} {:answer/id #uuid "edbdca09-407a-5b44-b814-062fce5150c1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268256}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267291} :answer-field/id #uuid "b1b80840-f020-56db-8303-eb251d19e950" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268722}] :question/id #uuid "cb576d6c-dcbf-591c-a5dd-97e97349a8f0" :question/math-academy-id "q-137095" :question/problem "$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=1 \\\\ 3{x}_{1}-3{x}_{2} &=4 \\\\ -2{x}_{1}+2{x}_{2} &=3\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $4a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 3 & -3 \\\\ -2 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 4 \\\\ 3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 3 & -2 \\\\ -1 & -3 & 2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 3 & -3 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 3 & -2 \\\\ -1 & -3 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}14 & -14 \\\\ -14 & 14\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}14 & -14 & 7 \\\\ -14 & 14 & -7\\end{bmatrix} & {R}_{2}:={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}14 & -14 & 7 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{1}{2}+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{2} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n4a+\\frac{b}{c}=4\\cdot (\\frac{1}{2})+\\frac{1}{1}=3.\n$$"} {:db/id #edb/ref 17592186269139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7360267e-e517-562f-a7ab-234dea8e16b2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267158} {:answer/id #uuid "8a852bda-8769-55af-b974-271e085d782f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267380} {:answer/id #uuid "abc3d198-0e91-5133-9e31-d766dcdd7bac" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267694} {:answer/id #uuid "df227e4e-6f3a-5099-aa04-1ab50365aa3d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268116} {:answer/id #uuid "f0784891-ea63-5109-abfd-c29f5a65f3e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268282}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267158} :answer-field/id #uuid "5fef7bda-8cd4-5d78-b705-1883723f2fd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268579}] :question/id #uuid "7264a872-6f66-52f9-bc5f-7b2565f54aa2" :question/math-academy-id "q-137096" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}+4{x}_{2} &=3 \\\\ -2{x}_{1}-4{x}_{2} &=6 \\\\ {x}_{1}+2{x}_{2} &=-3\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $a-\\frac{3b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & 4 \\\\ -2 & -4 \\\\ 1 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 6 \\\\ -3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & -2 & 1 \\\\ 4 & -4 & 2\\end{bmatrix}\\begin{bmatrix}2 & 4 \\\\ -2 & -4 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & -2 & 1 \\\\ 4 & -4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 6 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}9 & 18 \\\\ 18 & 36\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ -18\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}9 & 18 & -9 \\\\ 18 & 36 & -18\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}9 & 18 & -9 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-1-2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-1-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na-\\frac{3b}{c}=-1-\\frac{3(-2)}{1}=5.\n$$"} {:db/id #edb/ref 17592186269140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b66e8f9-798c-5fb5-9702-3848b450ff05" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266376} {:answer/id #uuid "1c88a6e9-e50e-5742-b36a-eb35a929b299" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266387} {:answer/id #uuid "275bb128-5a9f-5d1f-abdd-0647ca8896e7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266494} {:answer/id #uuid "5ed0a256-a969-57ba-a38b-d639f21e2e86" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266980} {:answer/id #uuid "7b3b665d-ddd7-5f8f-a302-3a3d75a9b19e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267232}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266980} :answer-field/id #uuid "343b4b87-3893-598e-8c73-4fe5b3ba88f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268495}] :question/id #uuid "93179ecb-11e4-5253-ab06-7702070386da" :question/math-academy-id "q-137097" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+{x}_{2} &=-4 \\\\ {x}_{1}-{x}_{2} &=2 \\\\ 5{x}_{1}-5{x}_{2} &=-3\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $-9a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 1 \\\\ 1 & -1 \\\\ 5 & -5\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}-4 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 1 & 5 \\\\ 1 & -1 & -5\\end{bmatrix}\\begin{bmatrix}-1 & 1 \\\\ 1 & -1 \\\\ 5 & -5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 1 & 5 \\\\ 1 & -1 & -5\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 2 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}27 & -27 \\\\ -27 & 27\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}27 & -27 & -9 \\\\ -27 & 27 & 9\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}27 & -27 & -9 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{3}+{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{3}+{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-9a+\\frac{b}{c}=-9\\cdot (-\\frac{1}{3})+\\frac{1}{1}=4.\n$$"} {:db/id #edb/ref 17592186269141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c10002-500f-5b1c-9ac3-3bccf7a34be4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266786} {:answer/id #uuid "6a9f182d-98f4-54f1-b0c2-ab6dea49e81a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186267087} {:answer/id #uuid "6e9ed506-cab1-5977-a1b0-8323058b9941" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267114} {:answer/id #uuid "7aae27b3-24bc-58a7-8eb4-69dda6ad9f1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267226} {:answer/id #uuid "b759c551-e5e4-5b83-9eba-bf5f0616ed57" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267788}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267226} :answer-field/id #uuid "9274ef15-b4ba-50d9-b139-ab18e30c28bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268662}] :question/id #uuid "58ba77df-63a2-5a9b-ba59-e2f2dbd16055" :question/math-academy-id "q-137119" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+2{x}_{2} &=3 \\\\ 2{x}_{1}-4{x}_{2} &=-2 \\\\ 3{x}_{1}-6{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $7a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4 \\\\ 3 & -6\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & 2 & 3 \\\\ 2 & -4 & -6\\end{bmatrix}\\begin{bmatrix}-1 & 2 \\\\ 2 & -4 \\\\ 3 & -6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & 2 & 3 \\\\ 2 & -4 & -6\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}14 & -28 \\\\ -28 & 56\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}14 & -28 & -4 \\\\ -28 & 56 & 8\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}14 & -28 & -4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{2}{7}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{2}{7}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{2}{7} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n7a+\\frac{b}{c}=7\\cdot (-\\frac{2}{7})+\\frac{2}{1}=0.\n$$"} {:db/id #edb/ref 17592186367443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "faba9b8c-2db9-5102-aa65-00748558a463" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186367445} {:answer/id #uuid "e2d0ce5d-e84e-57e4-8a47-bf9cb06a4a06" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186367446} {:answer/id #uuid "ec1f8972-dbc3-5adb-b2ee-427452d50a48" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186367447} {:answer/id #uuid "8e3fff1f-5172-5721-9989-85b34c09b139" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186367448} {:answer/id #uuid "fb047e4f-69c3-5551-ba4d-0963ccacfe94" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186367449}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186367447} :answer-field/id #uuid "778fca66-9171-578b-a82f-9dd5127d9503" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367444}] :question/id #uuid "b9b18fd2-40c6-532b-a289-0305c371077f" :question/math-academy-id "q-137090" :question/problem "$$\n\\left\\{\\begin{aligned}-3{x}_{1}+{x}_{2} &=3 \\\\ 6{x}_{1}-2{x}_{2} &=1 \\\\ 3{x}_{1}-{x}_{2} &=-2\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $-4a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-3 & 1 \\\\ 6 & -2 \\\\ 3 & -1\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-3 & 6 & 3 \\\\ 1 & -2 & -1\\end{bmatrix}\\begin{bmatrix}-3 & 1 \\\\ 6 & -2 \\\\ 3 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-3 & 6 & 3 \\\\ 1 & -2 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}54 & -18 \\\\ -18 & 6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}54 & -18 & -9 \\\\ -18 & 6 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+\\frac{1}{3}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}54 & -18 & -9 \\\\ 0 & 0 & 0\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\frac{1}{9}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}6 & -2 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{1}{6}+\\frac{1}{3}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{6}+\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{6} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{3} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n-4a+\\frac{b}{c}=-4\\cdot (-\\frac{1}{6})+\\frac{(\\frac{1}{3})}{1}=1.\n$$"} {:db/id #edb/ref 17592186367450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0366dc6-1996-570e-840e-8c80856c8afa" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186367452} {:answer/id #uuid "2b06eb22-5e54-52d9-a5d8-de25d113e619" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186367453} {:answer/id #uuid "425e4639-bd5f-5d47-b6e2-c94ebaa608bf" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186367454} {:answer/id #uuid "a4a6a34f-befd-59cd-bdc7-6ba87f58be40" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186367455} {:answer/id #uuid "977b53fc-6878-5223-bf26-85404a2bfdba" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186367456}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186367453} :answer-field/id #uuid "c701115a-b609-5cd4-a698-790dbbe0d2a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367451}] :question/id #uuid "f080e633-9838-5e96-8287-b7abe35cec6e" :question/math-academy-id "q-137091" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}+4{x}_{2} &=2 \\\\ -{x}_{1}-2{x}_{2} &=0 \\\\ {x}_{1}+2{x}_{2} &=2\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $5a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & 4 \\\\ -1 & -2 \\\\ 1 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 0 \\\\ 3\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & -1 & 1 \\\\ 4 & -2 & 2\\end{bmatrix}\\begin{bmatrix}2 & 4 \\\\ -1 & -2 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & -1 & 1 \\\\ 4 & -2 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}6 & 12 \\\\ 12 & 24\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ 12\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & 12 & 6 \\\\ 12 & 24 & 12\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}6 & 12 & 6 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=1-2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}1-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n5a+\\frac{b}{c}=5\\cdot 1+\\frac{(-2)}{1}=3.\n$$"} {:db/id #edb/ref 17592186415139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa14c10-e738-56f6-ba1c-e071a121f17f" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186415109} {:answer/id #uuid "3394fe0c-1ef5-5d2a-acd6-6a75d0644ea8" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186415118} {:answer/id #uuid "796589ac-95c1-56f9-b1db-31d0e03ed1d4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186415125} {:answer/id #uuid "a0ae1013-f366-5e65-90ff-b5b5ec91675a" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186415128} {:answer/id #uuid "f6952c2b-bc0a-5679-9e51-c3da4a58655d" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186415132}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186415128} :answer-field/id #uuid "ed476833-2f74-5fd6-89de-22e15124bc5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415138}] :question/id #uuid "01d4a87d-4b65-5a4c-9736-928bedaa6703" :question/math-academy-id "q-137086" :question/problem "$$\n\\left\\{\\begin{aligned}-{x}_{1}+3{x}_{2} &=3 \\\\ -2{x}_{1}+6{x}_{2} &=1 \\\\ {x}_{1}-3{x}_{2} &=-5\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $12a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}-1 & 3 \\\\ -2 & 6 \\\\ 1 & -3\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ -5\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & -2 & 1 \\\\ 3 & 6 & -3\\end{bmatrix}\\begin{bmatrix}-1 & 3 \\\\ -2 & 6 \\\\ 1 & -3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 & -2 & 1 \\\\ 3 & 6 & -3\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ -5\\end{bmatrix} \\\\ \\begin{bmatrix}6 & -18 \\\\ -18 & 54\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-10 \\\\ 30\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -18 & -10 \\\\ -18 & 54 & 30\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}6 & -18 & -10 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-\\frac{5}{3}+3{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{5}{3}+3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-\\frac{5}{3} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n12a+\\frac{b}{c}=12\\cdot (-\\frac{5}{3})+\\frac{3}{1}=-17.\n$$"} {:db/id #edb/ref 17592186415141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e85101-f9b2-5d74-83c6-aabdd8fc2745" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186415114} {:answer/id #uuid "2baff1db-5ead-50b2-af5a-abe277ae4820" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186415115} {:answer/id #uuid "2ccd28ea-578f-5414-8332-a6408e6df178" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186415116} {:answer/id #uuid "2e8878bb-5944-584d-9b48-2add56ecc5fb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186415117} {:answer/id #uuid "8cd78f8e-e662-5c98-aa4d-0c408cd252ed" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186415126}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186415126} :answer-field/id #uuid "a27c023d-32d0-5cf3-ade4-1f1674089f41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415135}] :question/id #uuid "4a92698e-17e4-57b8-8191-7aa9adc0e63f" :question/math-academy-id "q-137092" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}-{x}_{2} &=1 \\\\ 4{x}_{1}-2{x}_{2} &=1 \\\\ -2{x}_{1}+{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $6a+\\frac{4b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & -1 \\\\ 4 & -2 \\\\ -2 & 1\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}2 & 4 & -2 \\\\ -1 & -2 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 4 & -2 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & 4 & -2 \\\\ -1 & -2 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}24 & -12 \\\\ -12 & 6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}24 & -12 & 4 \\\\ -12 & 6 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}24 & -12 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{1}{6}+\\frac{1}{2}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{6}+\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{6} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n6a+\\frac{4b}{c}=6\\cdot \\frac{1}{6}+\\frac{4\\cdot \\frac{1}{2}}{1}=3.\n$$"} {:db/id #edb/ref 17592186415142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26168406-f1b0-5099-9e07-25cd625153b8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186415112} {:answer/id #uuid "28a4b0d8-24a1-5c50-8d0d-3d18a2ad1c94" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186415113} {:answer/id #uuid "37a33051-e1b1-5298-99ef-d2c6766952fc" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186415119} {:answer/id #uuid "571ff69e-5db2-5300-b1f0-1d3e4bea31c0" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186415121} {:answer/id #uuid "d61a5d2e-e72e-5b6e-9e93-29e9d0122c9f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186415131}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186415131} :answer-field/id #uuid "ac3cd328-26f2-53b0-bd30-ec73823e7080" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415136}] :question/id #uuid "abb758c7-4ff1-5d36-aa75-96f61271e2e1" :question/math-academy-id "q-137094" :question/problem "$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=1 \\\\ -2{x}_{1}+4{x}_{2} &=-1 \\\\ 3{x}_{1}-6{x}_{2} &=2\\end{aligned}\\right.\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n\\begin{bmatrix}a \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}b \\\\ c\\end{bmatrix},\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $14a+\\frac{b}{c}?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 3 & -6\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$\n\nThe least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}\\,Ax={A}^{T}b\n$$\n\nNotice that the columns of $A$ are linearly dependent. So first, let's write down the normal equation in matrix form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -2 & 3 \\\\ -2 & 4 & -6\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 3 & -6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -2 & 3 \\\\ -2 & 4 & -6\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}14 & -28 \\\\ -28 & 56\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}9 \\\\ -18\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the final matrix equation using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}14 & -28 & 9 \\\\ -28 & 56 & -18\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}14 & -28 & 9 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{9}{14}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{9}{14}+2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}\\frac{9}{14} \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n14a+\\frac{b}{c}=14\\cdot \\frac{9}{14}+\\frac{2}{1}=11.\n$$"}] :knowledge-point/title "Finding the Least-Squares Solution of a Linear System With Collinearity"} {:db/id #edb/ref 17592186133822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133634 :question/id #uuid "8a39f109-9436-55f8-bbb8-87253668378d" :question/math-academy-id "e-5963" :question/problem "![](images/71/7122f0c4dd74925137e301a4b0ac3672d1f1b30cadf19f3bce438bce202b5720.svg)\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a-b+c?$" :question/worked-solution "First, we write our system in matrix form as \n![](images/d4/d48e14c19cb4927af5d1199fe7a8f34ff4ddd96314f56d69534d438786dc2ff9.svg)\n\nThe normal equation corresponding to $A\\mathbf{x}=\\mathbf{b}$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}4 & 8 \\\\ -3 & -6 \\\\ -1 & -2\\end{bmatrix}\\begin{bmatrix}4 & -3 & -1 \\\\ 8 & -6 & -2\\end{bmatrix}x & =\\begin{bmatrix}4 & 8 \\\\ -3 & -6 \\\\ -1 & -2\\end{bmatrix}\\begin{bmatrix}4 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}80 & -60 & -20 \\\\ -60 & 45 & 15 \\\\ -20 & 15 & 5\\end{bmatrix}x & =\\begin{bmatrix}32 \\\\ -24 \\\\ -8\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na-b+c=(-20)-(-24)+(-20) = -16.\n$$"} :knowledge-point/id #uuid "fda08f5d-4513-5be0-b8c4-475e82f9bf5a" :knowledge-point/questions [{:db/id #edb/ref 17592186134372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bcce621-ad6c-5e38-92ce-59257d82b2e8" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186324207} {:answer/id #uuid "3ae637f1-21bd-58c0-8588-1f56b6ddf620" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186324445} {:answer/id #uuid "4f41b66f-c2b8-5e09-b24b-82987c5cd64f" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186324621} {:answer/id #uuid "7508b388-8184-5a28-8894-9eb4c9ab46c7" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186324944} {:answer/id #uuid "e8ac2159-63e1-59da-a0e5-00c6faec0140" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186326019}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186324621} :answer-field/id #uuid "fcdd0b61-b5b9-5f31-8491-d5721c2ec5db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326665}] :question/id #uuid "80e97aa1-dac8-53af-afe4-09e324e932eb" :question/math-academy-id "q-41909" :question/problem "$$\n\\left\\{\\begin{aligned}7{x}_{1}+2{x}_{2}+{x}_{3} &=5 \\\\ 14{x}_{1}+4{x}_{2}+2{x}_{3} &=0\\end{aligned}\\right.\\,\\,\\begin{bmatrix}245 & 70 & a \\\\ 70 & 20 & 10 \\\\ c & 10 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}35 \\\\ b \\\\ 5\\end{bmatrix}\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a+b+c?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}7 & 2 & 1 \\\\ 14 & 4 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}.\n$$\n\nThe normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}7 & 14 \\\\ 2 & 4 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}7 & 2 & 1 \\\\ 14 & 4 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}7 & 14 \\\\ 2 & 4 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}245 & 70 & 35 \\\\ 70 & 20 & 10 \\\\ 35 & 10 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}35 \\\\ 10 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=35+10+35=80.\n$$"} {:db/id #edb/ref 17592186134373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26aa4593-3d98-5568-b67c-3b36a4383f3e" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186324284} {:answer/id #uuid "a3f4d817-1036-5a87-85de-df19f0869e3c" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186325364} {:answer/id #uuid "b886b769-4bdc-5b28-b33e-ef5410db3a27" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186325554} {:answer/id #uuid "c4d92ab1-11c6-5ede-ba4b-baadc653d506" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186325665} {:answer/id #uuid "f0650000-2b66-5f84-8b7a-45f618ea7d09" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186326094}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186324284} :answer-field/id #uuid "44bac779-9147-528b-95c6-2676174b0918" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326337}] :question/id #uuid "0680aa30-4775-5c1b-82c5-b722226f12db" :question/math-academy-id "q-41912" :question/problem "$$\nA=\\begin{bmatrix}1 & 1 \\\\ 4 & 4 \\\\ 2 & 2 \\\\ 0 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}4 \\\\ 1 \\\\ -1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $b$ above. If the normal equation corresponding to the system $Ax=b$ is given below, what is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}a & 21 \\\\ 21 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}6 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "The normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}1 & 4 & 2 & 0 \\\\ 1 & 4 & 2 & 0\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 4 & 4 \\\\ 2 & 2 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 4 & 2 & 0 \\\\ 1 & 4 & 2 & 0\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1 \\\\ -1 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}21 & 21 \\\\ 21 & 21\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=21+21+6=48.\n$$"} {:db/id #edb/ref 17592186269133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d703fb0-7994-5d82-8b71-6be1827d9ddc" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186266687} {:answer/id #uuid "88367a43-375e-5e01-83f4-d0f7de933fbc" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186267346} {:answer/id #uuid "a6d72a61-2a7e-5cb3-a6e5-3065b7c3d949" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186267657} {:answer/id #uuid "bd28f937-92d1-5e4e-a751-76b6b5ad07fa" :answer/type {:db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186267838} {:answer/id #uuid "bfd2b28e-e590-5556-9f9a-e76676abf533" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186267862}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186267862} :answer-field/id #uuid "4a07625f-c093-52f8-9ba1-1a8f11822bed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268530}] :question/id #uuid "d00d21df-b149-5102-8948-a439a72941dc" :question/math-academy-id "q-136811" :question/problem "$$\nA=\\begin{bmatrix}1 & 2 \\\\ -3 & -6 \\\\ 0 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $b$ above. If the normal equation corresponding to the system $Ax=b$ is given below, what is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}a & 20 \\\\ 20 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "The normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}1 & -3 & 0 \\\\ 2 & -6 & 0\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & -6 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & -3 & 0 \\\\ 2 & -6 & 0\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}10 & 20 \\\\ 20 & 40\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=10+40+(-2)=48.\n$$"} {:db/id #edb/ref 17592186269134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "056bde88-c84a-542b-b854-757f76eb5537" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266192} {:answer/id #uuid "11577138-092f-5405-8add-1bf21e092d2a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186266289} {:answer/id #uuid "1af21ba1-ec9f-5759-8519-d9a10d13d566" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186266374} {:answer/id #uuid "603109b1-cdf0-531f-bf87-a3d70e3bcf7f" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186266993} {:answer/id #uuid "ce5b4264-6657-5997-9a3f-3e00aff7f007" :answer/type {:db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186267987}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186266993} :answer-field/id #uuid "126b6f84-805d-591b-a564-13937bad6be3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268438}] :question/id #uuid "69f4362f-6b4d-5c30-8b5c-dedd940a5e83" :question/math-academy-id "q-136822" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}-{x}_{2}-3{x}_{3} &=-2 \\\\ -6{x}_{1}+3{x}_{2}+9{x}_{3} &=1\\end{aligned}\\right.\\,\\,\\begin{bmatrix}40 & -20 & -60 \\\\ -20 & 10 & a \\\\ c & 30 & 90\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}-10 \\\\ b \\\\ 15\\end{bmatrix}\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a+b+c?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & -1 & -3 \\\\ -6 & 3 & 9\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.\n$$\n\nThe normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ -3 & 9\\end{bmatrix}\\begin{bmatrix}2 & -1 & -3 \\\\ -6 & 3 & 9\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ -3 & 9\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}40 & 20 & -60 \\\\ -20 & 10 & 30 \\\\ -60 & 30 & 90\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}-10 \\\\ 5 \\\\ 15\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=30+5+(-60)=-25.\n$$"} {:db/id #edb/ref 17592186269135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b3d1a3-e2c5-53af-933b-517ec9a0d72b" :answer/type {:db/ident :answer.type/math} :answer/value "-44" :db/id #edb/ref 17592186266589} {:answer/id #uuid "5c45d0cb-d619-548e-8823-23b2000f9c8d" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186266959} {:answer/id #uuid "5f359553-9efb-5c8e-94ff-571d277b5bfc" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186266983} {:answer/id #uuid "d1706cd6-61bf-52a6-816c-b55ddc048d76" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186268018} {:answer/id #uuid "e5d0f2d7-43a5-560a-91a8-6d0fe37c6f97" :answer/type {:db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186268179}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186266983} :answer-field/id #uuid "8ca2f21a-e889-5f63-95ad-6473117737ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268656}] :question/id #uuid "a9599aec-b36e-5461-9425-547d03dffdb7" :question/math-academy-id "q-136875" :question/problem "$$\n\\left\\{\\begin{aligned}4{x}_{1}-8{x}_{2}+2{x}_{3} &=4 \\\\ -2{x}_{1}+4{x}_{2}-{x}_{3} &=-3\\end{aligned}\\right.\\,\\,\\begin{bmatrix}20 & a & 10 \\\\ c & 80 & -20 \\\\ 10 & -20 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}22 \\\\ b \\\\ 11\\end{bmatrix}\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a-b+c?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}4 & -8 & 2 \\\\ -2 & 4 & -1\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}.\n$$\n\nThe normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}4 & -2 \\\\ -8 & 4 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}4 & -8 & 2 \\\\ -2 & 4 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}4 & -2 \\\\ -8 & 4 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}4 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}20 & -40 & 10 \\\\ -40 & 80 & -20 \\\\ 10 & -20 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}22 \\\\ -44 \\\\ 11\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nTherefore, we have \n\n$$\na-b+c=(-40)-(-44)+(-40)=-36.\n$$"} {:db/id #edb/ref 17592186367429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61f6d487-6ec9-51e0-b88b-fc9df19cbc3a" :answer/typ