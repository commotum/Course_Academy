\n<td align=\"center\">$0.28$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n</tbody></table>" :db/id #edb/ref 17592186550842} {:answer/id #uuid "f8546886-0820-5923-90be-94d7c0870ccd" :answer/type {:db/ident :answer.type/text} :answer/value "<table align=\"left\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td colspan=\"2\" align=\"center\">From:</td> \n</tr>\n<tr>\n<td></td>\n<td></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td> \n</tr>\n<tr> \n<td rowspan=\"2\" align=\"center\">To:</td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td align=\"center\">$0.88$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.28$</td>\n</tr>\n</tbody></table>" :db/id #edb/ref 17592186551034}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "<table align=\"left\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td colspan=\"2\" align=\"center\">From:</td> \n</tr>\n<tr>\n<td></td>\n<td></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td> \n</tr>\n<tr> \n<td rowspan=\"2\" align=\"center\">To:</td>\n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Cities</b></td>\n<td align=\"center\">$0.88$</td>\n<td align=\"center\">$0.28$</td>\n</tr>\n<tr> \n<td width=\"60\" bgcolor=\"#D6EAF8\" align=\"center\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n</tbody></table>" :db/id #edb/ref 17592186550842} :answer-field/id #uuid "6f6518b4-e34a-514d-90e9-c9eb50aaae11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551128}] :question/id #uuid "1cf7f6b8-f438-52c0-a338-61f2ad7fa03e" :question/math-academy-id "q-135555" :question/problem "In a particular country, there are two groups of people: those who live in the cities and those who live in the countryside. A study has shown that each decade \n\n- $12%$ of people who lived in the cities relocate to the countryside, and\n\n- $28%$ of people who lived in the countryside relocate to the cities.\n\nWhich of the following tables describes how these people change their preferences each year?" :question/worked-solution "We are given the following situation for each decade: \n\n- $12%$ of people who live in the cities relocate to the countryside. This implies that $88%$ of them remain living in the cities.\n\n- $28%$ of people who live in the countryside relocate to the cities. This implies that $72%$ of them remain living in the countryside.\n\nWriting this information in tabular form, we obtain the following:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"2\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Cities</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Countryside</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"2\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Cities</b></td>\n<td align=\"center\">$0.88$</td>\n<td align=\"center\">$0.28$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Countryside</b></td>\n<td align=\"center\">$0.12$</td>\n<td align=\"center\">$0.72$</td>\n</tr>\n</tbody></table>\n\nNote that we can write a corresponding stochastic matrix as follows:\n\n$$\n[\\begin{aligned}0.88 & 0.28 \\\\ 0.12 & 0.72\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186551295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277522b5-e3dd-5b89-81f3-5cdba4469a16" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186550464} {:answer/id #uuid "77d648dd-908d-5044-81c9-f4c8de288371" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186550670} {:answer/id #uuid "98ceb55d-c397-5695-99ff-7995f7e2e05a" :answer/type {:db/ident :answer.type/math} :answer/value "0.95" :db/id #edb/ref 17592186550755} {:answer/id #uuid "b6eebac0-9289-5154-9d7a-80de8f6fa66c" :answer/type {:db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186550867} {:answer/id #uuid "b7b44784-1307-5ab1-8d5a-2ec2e4bf1930" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186550873}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186550873} :answer-field/id #uuid "87636227-a251-5be3-befa-08c44f225fa6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551146}] :question/id #uuid "7d2bfda5-1f22-5eca-90c5-42502b97859c" :question/math-academy-id "q-135564" :question/problem "There are three supermarket chains in a particular city: chain $A,$ chain $B,$ and chain $C.$ A study has shown that, each month\n\n- from the customers that prefer chain $A,$ $5%$ change to chain $B$ and $15%$ change to chain $C,$\n\n- from the customers that prefer chain $B,$ $25%$ change to chain $A$ and $25%$ change to chain $C,$\n\n- from the customers that prefer chain $C,$ $15%$ change to chain $A$ and $35%$ change to chain $B.$\n\nThe stochastic matrix that describes this situation is given below. What is the value of $a+b+c?$\n\n$$\nP=[\\begin{aligned}0.8 & a & 0.15 \\\\ b & 0.5 & 0.35 \\\\ 0.15 & 0.25 & c\\end{aligned}]\n$$" :question/worked-solution "We are given the following situation for each month:\n\n- From the customers that prefer chain $A,$ $5%$ change to chain $B$ and $15%$ change to chain $C.$ This implies that $80%$ of them continue to prefer chain $A.$\n\n- From the customers that prefer chain $B,$ $25%$ change to chain $A$ and $25%$ change to chain $C.$ This implies that $50%$ of them continue to prefer chain $B.$\n\n- From the customers that prefer chain $C,$ $15%$ change to chain $A$ and $35%$ change to chain $B.$ This implies that $50%$ of them continue to prefer chain $C.$\n\nWriting this information in tabular form, we obtain the following:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"3\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain A</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain B</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain C</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"3\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain A</b></td>\n<td align=\"center\">$0.8$</td>\n<td align=\"center\">$0.25$</td>\n<td align=\"center\">$0.15$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain B</b></td>\n<td align=\"center\">$0.05$</td>\n<td align=\"center\">$0.5$</td>\n<td align=\"center\">$0.35$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Chain C</b></td>\n<td align=\"center\">$0.15$</td>\n<td align=\"center\">$0.25$</td>\n<td align=\"center\">$0.5$</td>\n</tr>\n</tbody></table>\n\nWe can write the corresponding stochastic matrix as follows:\n\n$$\nP=[\\begin{aligned}0.8 & 0.25 & 0.15 \\\\ 0.05 & 0.5 & 0.35 \\\\ 0.15 & 0.25 & 0.5\\end{aligned}].\n$$\n\nFinally, we have\n\n$$\na+b+c=0.25+0.05+0.5=0.8.\n$$"}] :knowledge-point/title "Constructing a Stochastic Matrix Given Some Data"} {:db/id #edb/ref 17592186124545 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124354 :question/id #uuid "95a45716-8c29-5955-af3c-43b6344912da" :question/math-academy-id "e-5599" :question/problem "A certain industry produces $2$ types of sugar, namely sugar $A$ and sugar $B$. The following table describes how the number of consumers changes between both types of sugar in a month:\n\n|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Sugar $A$** | **Sugar $B$** |\n| To: | **Sugar $A$** | $0.3$ | $0.45$ |\n| **Sugar $B$** | $0.7$ | $0.55$ |  |\n\nThat is, $70\\%$ of sugar $A$ customers switch to sugar $B$ each month, and $45\\%$ of sugar $B$ customers switch to sugar $A.$\n\nCurrently, $600$ customers use sugar $A,$ while $400$ customers use sugar $B.$ How many customers will use sugar $A$ in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n![](images/45/451b82e8cb00ede7b0ddf73f35c0555d0eeeeefc5beb5ce4fddd54f0df5f2577.png)\n\nThe vector describing the number of customers for each type of sugar is\n![](images/56/56952aeed1d718033af8a3e6d09e8e269f1d70aa8dc31609b8289f025f2e6bd6.png)\nDividing the vector above by the total number of customers $(1\\,000),$ we get the stochastic vector of the initial state:\n\n![](images/ca/cae1bed6b8b01b3ff66c2e8bacf7a10f6c0ece53f3aeac0fb1a51e8fc3c07e8e.png)\n\nTo find the state vector $\\mathbf{x}_1$ after one month, we apply one step of the Markov chain:\n\n$$\n\\mathbf{x}_1=P\\mathbf{x}_0\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.3 & 0.45 \\\\ 0.7 & 0.55\\end{bmatrix}\\begin{bmatrix}0.6 \\\\ 0.4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.36 \\\\ 0.64\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one month, $\\color{blue}36\\%$ of customers will use sugar $A.$ Computing $36\\%$ of $1\\,000,$ we obtain\n\n$$\n1\\,000 \\cdot 0.36 = 360.\n$$\n\nTherefore, $360$ customers will use sugar $A$ in one month."} :knowledge-point/id #uuid "3e93dde4-a8e8-548a-801e-3d9a320a4513" :knowledge-point/questions [{:db/id #edb/ref 17592186124788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "848e6076-4e56-59d8-ab84-6808bf321d6a" :answer/type {:db/ident :answer.type/math} :answer/value "280000" :db/id #edb/ref 17592186121326} {:answer/id #uuid "9bcf50f0-b54f-5b81-ac83-38f4c029b097" :answer/type {:db/ident :answer.type/math} :answer/value "290000" :db/id #edb/ref 17592186121327} {:answer/id #uuid "ba1bfe76-520c-5c10-b350-34d63223b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "360000" :db/id #edb/ref 17592186121328} {:answer/id #uuid "1d3baefa-8431-5777-b25e-a8c744de4e97" :answer/type {:db/ident :answer.type/math} :answer/value "350000" :db/id #edb/ref 17592186121329} {:answer/id #uuid "6e96dbb2-a51b-5a98-9932-cfb97c3b4f5c" :answer/type {:db/ident :answer.type/math} :answer/value "320000" :db/id #edb/ref 17592186121330}] :answer-field/id #uuid "876af953-f2d1-5ba4-815e-383a7226bac2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121325}] :question/id #uuid "c4d4936a-631d-5b30-8f00-e65967e70fc6" :question/math-academy-id "q-135462" :question/problem "A certain company produces three types of cars: Standard, Sports, and Deluxe. The following table describes how the number of customers changes between the three types of cars each year:\n\n|  |  | From: |  |  |\n| --- | ---: | ---: | ---: | ---: |\n|  |  | **Standard** | **Sports** | **Deluxe** |\n| To: | **Standard** | $0.6$ | $0.1$ | $0.1$ |\n| **Sports** | $0.2$ | $0.6$ | $0.2$ |  |\n| **Deluxe** | $0.2$ | $0.3$ | $0.7$ |  |\n\nFor example, $20%$ of Standard customers switch to Sports each year, and $30%$ of Sports customers switch to Deluxe.\n\nCurrently, $500000$ customers use Standard, $400000$ customers use Sports and $100000$ customers use Deluxe. How many customers will use Sports in one year? You may assume that the total number of customers doesn't change.\n\n> A calculator is required to answer this question."} {:db/id #edb/ref 17592186124924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "758ee170-1fcb-5640-8b61-f22fb7a21811" :answer/type {:db/ident :answer.type/math} :answer/value "520\\,000" :db/id #edb/ref 17592186322063} {:answer/id #uuid "936daf2f-be59-5538-b600-77f0341e8b82" :answer/type {:db/ident :answer.type/math} :answer/value "400\\,000" :db/id #edb/ref 17592186322316} {:answer/id #uuid "c3c760ab-015f-5f08-8419-73f7e6627df3" :answer/type {:db/ident :answer.type/math} :answer/value "430\\,000" :db/id #edb/ref 17592186322665} {:answer/id #uuid "ce8548e7-cae1-5bab-a94c-045833d4e0f9" :answer/type {:db/ident :answer.type/math} :answer/value "480\\,000" :db/id #edb/ref 17592186322760} {:answer/id #uuid "f5b6826a-9e7d-507c-8455-dfd824432ed5" :answer/type {:db/ident :answer.type/math} :answer/value "640\\,000" :db/id #edb/ref 17592186323073}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "480\\,000" :db/id #edb/ref 17592186322760} :answer-field/id #uuid "fe25491b-be23-5337-9805-76ec9cd44496" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323663}] :question/id #uuid "62389cec-4c75-591c-8976-ec4ed362e628" :question/math-academy-id "q-35845" :question/problem "A certain company produces two types of smartphones: Phone $A$ and Phone $B.$ The following table describes how the number of customers changes between both types of smartphones each year:\n\n|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Phone $A$** | **Phone $B$** |\n| To: | **Phone $A$** | $0.6$ | $0.3$ |\n| **Phone $B$** | $0.4$ | $0.7$ |  |\n\nThat is, $40%$ of Phone $A$ customers switch to Phone $B$ each year, and $30%$ of Phone $B$ customers switch to Phone $A.$\n\nCurrently, $600\\,000$ customers use Phone $A,$ while $400\\,000$ customers use Phone $B.$ How many customers will use Phone $A$ in one year? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.6 & 0.3 \\\\ 0.4 & 0.7\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each smartphone is\n\n$$\n\\begin{bmatrix}600\\,000 \\\\ 400\\,000\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(1\\,000\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000\\,000}\\begin{bmatrix}600\\,000 \\\\ 400\\,000\\end{bmatrix}=\\begin{bmatrix}0.6 \\\\ 0.4\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.6 & 0.3 \\\\ 0.4 & 0.7\\end{bmatrix}\\begin{bmatrix}0.6 \\\\ 0.4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.48 \\\\ 0.52\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one year, $48%$ of customers will use Phone $A.$ Computing $48%$ of $1\\,000\\,000,$ we obtain\n\n$$\n1\\,000\\,000\\cdot 0.48=480\\,000.\n$$\n\nTherefore, $480\\,000$ customers will use Phone $A$ in one year."} {:db/id #edb/ref 17592186269065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f0d96c-1266-5785-8200-892b41ae2e8f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,600" :db/id #edb/ref 17592186266361} {:answer/id #uuid "1c6aefc8-fccb-554a-919c-0d626007ab77" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,400" :db/id #edb/ref 17592186266385} {:answer/id #uuid "4a0a3823-7474-55ff-83e9-092185c3fab1" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,200" :db/id #edb/ref 17592186266801} {:answer/id #uuid "889e6871-62c6-5b24-9488-61a6053543e1" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,100" :db/id #edb/ref 17592186267355} {:answer/id #uuid "93f13ff1-3840-561f-a2c2-0b8bd1918cf4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,800" :db/id #edb/ref 17592186267469}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5\\,200" :db/id #edb/ref 17592186266801} :answer-field/id #uuid "fe6c15ab-cb59-5b2b-a36e-bc8f4709ba95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268850}] :question/id #uuid "bbeb73de-fe7f-52b6-aff7-483b9a90311b" :question/math-academy-id "q-135458" :question/problem "A certain company produces two types of motorcycles: classic and high-cylinder. The following table describes how the number of customers changes between both types of motorcycles each decade:\n\n|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Classic** | **High-Cylinder** |\n| To: | **Classic** | $0.6$ | $0.2$ |\n| **High-Cylinder** | $0.4$ | $0.8$ |  |\n\nThat is, $40%$ of classic motorcycle customers switch to high-cylinder each decade, and $20%$ of high-cylinder motorcycle customers switch to Classic.\n\nCurrently, $7\\,000$ customers use classic motorcycles while $3\\,000$ customers use high-cylinder motorcycles. How many customers will use high-cylinder motorcycles in one decade? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.6 & 0.2 \\\\ 0.4 & 0.8\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each type of motorcycle is\n\n$$\n\\begin{bmatrix}7\\,000 \\\\ 3\\,000\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(10\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{10\\,000}\\begin{bmatrix}7\\,000 \\\\ 3\\,000\\end{bmatrix}=\\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one decade, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.6 & 0.2 \\\\ 0.4 & 0.8\\end{bmatrix}\\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.48 \\\\ 0.52\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one decade, $52%$ of customers will use high-cylinder motorcycles. Computing $52%$ of $10\\,000,$ we obtain\n\n$$\n10\\,000\\cdot 0.52=5\\,200.\n$$\n\nTherefore, $5\\,200$ customers will use high-cylinder motorcycles in one decade."} {:db/id #edb/ref 17592186269066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24994118-ebad-57bf-83f4-62737cb7f322" :answer/type {:db/ident :answer.type/math} :answer/value "430\\,000" :db/id #edb/ref 17592186266475} {:answer/id #uuid "2ab6a0d7-b2f1-561f-8739-c4f788b6dcf8" :answer/type {:db/ident :answer.type/math} :answer/value "320\\,000" :db/id #edb/ref 17592186266517} {:answer/id #uuid "3f49f017-a4ff-57a7-be09-7e543b784fdf" :answer/type {:db/ident :answer.type/math} :answer/value "280\\,000" :db/id #edb/ref 17592186266713} {:answer/id #uuid "580525e0-3a6c-5403-84c8-ef55fb9b36e3" :answer/type {:db/ident :answer.type/math} :answer/value "360\\,000" :db/id #edb/ref 17592186266931} {:answer/id #uuid "ca0e2789-6e67-5ec0-9e1b-71e22f227a66" :answer/type {:db/ident :answer.type/math} :answer/value "380\\,000" :db/id #edb/ref 17592186267959}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "360\\,000" :db/id #edb/ref 17592186266931} :answer-field/id #uuid "26bda911-40c4-556e-ac7b-5b4e769f88b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268467}] :question/id #uuid "9699dcc6-557c-5bb4-a953-a7c82014e4b2" :question/math-academy-id "q-135460" :question/problem "A certain company produces three types of milk: whole, skim, and lactose-free. The following table describes how the number of customers changes between the three types of milk each year:\n\n|  |  | From: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **Whole** | **Skim** | **Lactose-free** |\n| To: | **Whole** | $0.5$ | $0.3$ | $0.2$ |\n| **Skim** | $0.3$ | $0.4$ | $0.4$ |  |\n| **Lactose-free** | $0.2$ | $0.3$ | $0.4$ |  |\n\nFor example, $30%$ of whole milk customers switch to skim milk each year, and $20%$ of lactose-free milk customers switch to whole milk.\n\nCurrently, $400\\,000$ customers consume whole milk, $400\\,000$ customers consume skim milk, and $200\\,000$ customers consume lactose-free milk. How many customers will consume whole milk after one year? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.5 & 0.3 & 0.2 \\\\ 0.3 & 0.4 & 0.4 \\\\ 0.2 & 0.3 & 0.4\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each type of milk is\n\n$$\n\\begin{bmatrix}400\\,000 \\\\ 400\\,000 \\\\ 200\\,000\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(1\\,000\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000\\,000}\\begin{bmatrix}400\\,000 \\\\ 400\\,000 \\\\ 200\\,000\\end{bmatrix}=\\begin{bmatrix}0.4 \\\\ 0.4 \\\\ 0.2\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.5 & 0.3 & 0.2 \\\\ 0.3 & 0.4 & 0.4 \\\\ 0.2 & 0.3 & 0.4\\end{bmatrix}\\begin{bmatrix}0.4 \\\\ 0.4 \\\\ 0.2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.36 \\\\ 0.36 \\\\ 0.28\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one year, $36%$ of customers will consume whole milk. Computing $36%$ of $1\\,000\\,000,$ we obtain\n\n$$\n1\\,000\\,000\\cdot 0.36=360\\,000.\n$$\n\nTherefore, $360\\,000$ customers will consume whole milk after one year."} {:db/id #edb/ref 17592186269067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0455b8ee-0cb2-5011-aa4d-bae1103f59d2" :answer/type {:db/ident :answer.type/math} :answer/value "390\\,000" :db/id #edb/ref 17592186266179} {:answer/id #uuid "1f836c3a-c67b-5970-8731-c0f0a7334dca" :answer/type {:db/ident :answer.type/math} :answer/value "240\\,000" :db/id #edb/ref 17592186266420} {:answer/id #uuid "4593e854-e146-55e2-af50-0ca44d510660" :answer/type {:db/ident :answer.type/math} :answer/value "470\\,000" :db/id #edb/ref 17592186266763} {:answer/id #uuid "cb506bd9-f1a3-567e-8cea-e083a2f8627e" :answer/type {:db/ident :answer.type/math} :answer/value "340\\,000" :db/id #edb/ref 17592186267966} {:answer/id #uuid "cb83c181-c6fd-55f9-89d8-36bb89054cd6" :answer/type {:db/ident :answer.type/math} :answer/value "290\\,000" :db/id #edb/ref 17592186267968}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "290\\,000" :db/id #edb/ref 17592186267968} :answer-field/id #uuid "0274237b-5707-50b2-a56c-b7645a561434" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268407}] :question/id #uuid "25a6f23d-99a0-510e-abf4-afb5461a1de7" :question/math-academy-id "q-135465" :question/problem "A certain company produces three types of ground coffee: fine, medium, and coarse. The following table describes how the number of customers changes between the three types of ground coffee each year:\n\n|  |  | From: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **Fine** | **Medium** | **Coarse** |\n| To: | **Fine** | $0.5$ | $0.2$ | $0.2$ |\n| **Medium** | $0.3$ | $0.6$ | $0.4$ |  |\n| **Coarse** | $0.2$ | $0.2$ | $0.4$ |  |\n\nFor example, $30%$ of fine ground coffee customers switch to medium ground coffee each year, and $20%$ of coarse ground coffee customers switch to fine ground coffee.\n\nCurrently, $300\\,000$ customers buy fine ground coffee, $500\\,000$ customers buy medium ground coffee, and $200\\,000$ customers buy coarse ground coffee. How many customers will purchase fine ground coffee in one year? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.5 & 0.2 & 0.2 \\\\ 0.3 & 0.6 & 0.4 \\\\ 0.2 & 0.2 & 0.4\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each type of ground coffee is\n\n$$\n\\begin{bmatrix}300\\,000 \\\\ 500\\,000 \\\\ 200\\,000\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(1\\,000\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000\\,000}\\begin{bmatrix}300\\,000 \\\\ 500\\,000 \\\\ 200\\,000\\end{bmatrix}=\\begin{bmatrix}0.3 \\\\ 0.5 \\\\ 0.2\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.5 & 0.2 & 0.2 \\\\ 0.3 & 0.6 & 0.4 \\\\ 0.2 & 0.2 & 0.4\\end{bmatrix}\\begin{bmatrix}0.3 \\\\ 0.5 \\\\ 0.2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.29 \\\\ 0.47 \\\\ 0.24\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one year, $29%$ of customers will buy fine ground coffee. Computing $29%$ of $1\\,000\\,000,$ we obtain\n\n$$\n1\\,000\\,000\\cdot 0.29=290\\,000.\n$$\n\nTherefore, $290\\,000$ customers will buy fine ground coffee in one year."} {:db/id #edb/ref 17592186269068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e506614-6ad3-5ffc-8247-0e3a91569c30" :answer/type {:db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186266699} {:answer/id #uuid "793d45cd-6995-5fab-9fe4-6fa8b697a840" :answer/type {:db/ident :answer.type/math} :answer/value "290" :db/id #edb/ref 17592186267212} {:answer/id #uuid "88e7f5c9-6471-53b4-9fc2-9c61038cba6c" :answer/type {:db/ident :answer.type/math} :answer/value "330" :db/id #edb/ref 17592186267362} {:answer/id #uuid "a8524f89-c098-5123-9e05-ed04a141017f" :answer/type {:db/ident :answer.type/math} :answer/value "310" :db/id #edb/ref 17592186267670} {:answer/id #uuid "f234613c-1b03-5960-b4c7-1efd529f2a66" :answer/type {:db/ident :answer.type/math} :answer/value "420" :db/id #edb/ref 17592186268296}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "330" :db/id #edb/ref 17592186267362} :answer-field/id #uuid "a378411e-f5b4-5192-ba9c-75457c99a5f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268697}] :question/id #uuid "9bc1baec-638c-5833-91cf-cfdafab596c1" :question/math-academy-id "q-135466" :question/problem "A certain cinema sells three types of popcorn: traditional, butter, and caramelized. The following table describes how the number of customers changes between the three types of popcorn each month:\n\n|  |  | From: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **Traditional** | **Butter** | **Caramelized** |\n| To: | **Traditional** | $0.4$ | $0.1$ | $0.2$ |\n| **Butter** | $0.3$ | $0.5$ | $0.2$ |  |\n| **Caramelized** | $0.3$ | $0.4$ | $0.6$ |  |\n\nFor example, $30%$ of traditional popcorn customers switch to butter popcorn each month, and $40%$ of butter popcorn customers switch to caramelized popcorn.\n\nCurrently, $400$ customers buy traditional popcorn, $300$ customers buy butter popcorn, and $300$ customers buy caramelized popcorn. How many customers will purchase butter popcorn in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.4 & 0.1 & 0.2 \\\\ 0.3 & 0.5 & 0.2 \\\\ 0.3 & 0.4 & 0.6\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each type of popcorn customers is\n\n$$\n\\begin{bmatrix}400 \\\\ 300 \\\\ 300\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(1\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000}\\begin{bmatrix}400 \\\\ 300 \\\\ 300\\end{bmatrix}=\\begin{bmatrix}0.4 \\\\ 0.3 \\\\ 0.3\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.4 & 0.1 & 0.2 \\\\ 0.3 & 0.5 & 0.2 \\\\ 0.3 & 0.4 & 0.6\\end{bmatrix}\\begin{bmatrix}0.4 \\\\ 0.3 \\\\ 0.3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.25 \\\\ 0.33 \\\\ 0.42\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one year, $33%$ of customers will buy butter popcorn. Computing $33%$ of $1\\,000,$ we obtain\n\n$$\n1\\,000\\cdot 0.33=330.\n$$\n\nTherefore, $330$ customers will buy butter popcorn in one month."} {:db/id #edb/ref 17592186378664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df1090c-b953-55e7-82db-2918444fb6f3" :answer/type {:db/ident :answer.type/math} :answer/value "405\\,000" :db/id #edb/ref 17592186378666} {:answer/id #uuid "ddc961d6-6767-5034-8c94-13fc400c4870" :answer/type {:db/ident :answer.type/math} :answer/value "425\\,000" :db/id #edb/ref 17592186378667} {:answer/id #uuid "cbec1301-90b2-5468-bdbd-75e91b591098" :answer/type {:db/ident :answer.type/math} :answer/value "395\\,000" :db/id #edb/ref 17592186378668} {:answer/id #uuid "d3c54158-eb40-57d4-902a-43c93f2cbfcb" :answer/type {:db/ident :answer.type/math} :answer/value "555\\,000" :db/id #edb/ref 17592186378669} {:answer/id #uuid "07a27bf2-8db9-58f0-b441-14ea9ca218eb" :answer/type {:db/ident :answer.type/math} :answer/value "360\\,000" :db/id #edb/ref 17592186378670}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "405\\,000" :db/id #edb/ref 17592186378666} :answer-field/id #uuid "c01d1ab0-b4e0-570d-9f6a-3444da987d66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378665}] :question/id #uuid "960aa206-ef2f-590f-b6e6-46bfb1026352" :question/math-academy-id "q-135457" :question/problem "A certain company produces two types of footwear: casual and sports. The following table describes how the number of customers changes between both types of footwear each year:\n\n|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **Casual** | **Sports** |\n| To: | **Casual** | $0.55$ | $0.7$ |\n| **Sports** | $0.45$ | $0.3$ |  |\n\nThat is, $45%$ of casual customers switch to sports each year, and $70%$ of sports customers change to casual.\n\nCurrently, $700\\,000$ customers purchase casual footwear, while $300\\,000$ customers purchase sports footwear. How many customers will purchase sports footwear in one year? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=\\begin{bmatrix}0.55 & 0.7 \\\\ 0.45 & 0.3\\end{bmatrix}\n$$\n\nThe vector describing the number of customers for each type of footwear is\n\n$$\n\\begin{bmatrix}700\\,000 \\\\ 300\\,000\\end{bmatrix}.\n$$\n\nDividing the vector above by the total number of customers $(1\\,000\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000\\,000}\\begin{bmatrix}700\\,000 \\\\ 300\\,000\\end{bmatrix}=\\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix}\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.55 & 0.7 \\\\ 0.45 & 0.3\\end{bmatrix}\\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.595 \\\\ 0.405\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, after one year, $40.5%$ of customers will purchase sports footwear. Computing $40.5%$ of $1\\,000\\,000,$ we obtain\n\n$$\n1\\,000\\,000\\cdot 0.405=405\\,000.\n$$\n\nTherefore, $405\\,000$ customers will purchase sports footwear in one year."} {:db/id #edb/ref 17592186551261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105e81b4-ebb0-52a8-aaaf-535d61ac1ba6" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,800" :db/id #edb/ref 17592186550409} {:answer/id #uuid "3fc67c9e-b654-57e4-a474-667c5d454cc4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,500" :db/id #edb/ref 17592186550514} {:answer/id #uuid "40c82cec-2aab-5e87-a7f3-187df9be1327" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,200" :db/id #edb/ref 17592186550517} {:answer/id #uuid "76ffc93a-e662-59db-8132-6716efe1d93a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,800" :db/id #edb/ref 17592186550668} {:answer/id #uuid "9af91aff-676a-57a8-ab5a-633b6dcd682f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,500" :db/id #edb/ref 17592186550761}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4\\,200" :db/id #edb/ref 17592186550517} :answer-field/id #uuid "c2b5c355-cad0-5348-8dff-54a6b032b4f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551184}] :question/id #uuid "34952883-ed67-58e1-83a4-6ee369a6dde8" :question/math-academy-id "q-35847" :question/problem "A certain company produces $2$ types of flour, flour $A$ and flour $B.$ The following table describes how the number of consumers changes between both types of flour each month:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"2\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $A$</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $B$</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"2\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $A$</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.6$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"80\"><b>Flour $B$</b></td>\n<td align=\"center\">$0.7$</td>\n<td align=\"center\">$0.4$</td>\n</tr>\n</tbody></table>\n\nThat is, $70%$ of flour $A$ customers switch to flour $B$ each month, and $60%$ of flour $B$ customers change to flour $A.$\n\nCurrently, $6\\,000$ customers use flour $A,$ while $4\\,000$ customers use flour $B.$ How many customers will use flour $A$ in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=[\\begin{aligned}0.3 & 0.6 \\\\ 0.7 & 0.4\\end{aligned}]\n$$\n\nThe vector describing the number of customers for each type of flour is\n\n$$\n[\\begin{aligned}6\\,000 \\\\ 4\\,000\\end{aligned}].\n$$\n\nDividing the vector above by the total number of customers $(10\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{10\\,000}[\\begin{aligned}6\\,000 \\\\ 4\\,000\\end{aligned}]=[\\begin{aligned}0.6 \\\\ 0.4\\end{aligned}]\n$$\n\nTo find the state vector ${x}_{1}$ after one year, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.3 & 0.6 \\\\ 0.7 & 0.4\\end{aligned}][\\begin{aligned}0.6 \\\\ 0.4\\end{aligned}] \\\\  & =[\\begin{aligned}0.42 \\\\ 0.58\\end{aligned}].\\end{aligned}\n$$\n\nSo, after one month, $42%$ of customers will use flour $A.$ Computing $42%$ of $10\\,000,$ we obtain\n\n$$\n10\\,000\\cdot 0.42=4\\,200.\n$$\n\nTherefore, $4\\,200$ customers will use flour $A$ in one month."} {:db/id #edb/ref 17592186551325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "903bfffc-e426-59e3-ab24-11a7979aa4ac" :answer/type {:db/ident :answer.type/math} :answer/value "300" :db/id #edb/ref 17592186550734} {:answer/id #uuid "a380b557-2215-594c-843f-24dc64b7b436" :answer/type {:db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186550792} {:answer/id #uuid "b0e2774b-270a-55ce-93a5-e9e33d94f09e" :answer/type {:db/ident :answer.type/math} :answer/value "380" :db/id #edb/ref 17592186550850} {:answer/id #uuid "b1a5f251-9496-5266-9006-9a8c00b395c5" :answer/type {:db/ident :answer.type/math} :answer/value "420" :db/id #edb/ref 17592186550852} {:answer/id #uuid "e100991f-d084-5436-83ef-32e93d923689" :answer/type {:db/ident :answer.type/math} :answer/value "450" :db/id #edb/ref 17592186550982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "380" :db/id #edb/ref 17592186550850} :answer-field/id #uuid "d3eedce2-2377-5540-8cff-1c60ab867920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551201}] :question/id #uuid "af97554b-6ce7-555f-8ebb-05f560ef6317" :question/math-academy-id "q-135463" :question/problem "A certain store sells three types of instant soups: chicken, meat, and vegetable. The following table describes how the number of customers changes between the three types of instant soups each month:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"3\">From:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Chicken</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Meat</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Vegetable</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"3\">To:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Chicken</b></td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.2$</td>\n<td align=\"center\">$0.3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Meat</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"60\"><b>Vegetable</b></td>\n<td align=\"center\">$0.3$</td>\n<td align=\"center\">$0.4$</td>\n<td align=\"center\">$0.5$</td>\n</tr>\n</tbody></table>\n\nFor example, $30%$ of chicken soup customers switch to vegetable each month, and $20%$ of vegetable customers switch to meat.\n\nCurrently, $400$ customers buy chicken soup, $400$ customers buy meat soup, and $200$ customers buy vegetable soup. How many customers will purchase vegetable instant soup in one month? You may assume that the total number of customers doesn't change." :question/worked-solution "From the table, we can build the corresponding stochastic matrix: \n\n$$\nP=[\\begin{aligned}0.4 & 0.2 & 0.3 \\\\ 0.3 & 0.4 & 0.2 \\\\ 0.3 & 0.4 & 0.5\\end{aligned}]\n$$\n\nThe vector describing the number of customers for each type of instant soup is\n\n$$\n[\\begin{aligned}400 \\\\ 400 \\\\ 200\\end{aligned}].\n$$\n\nDividing the vector above by the total number of customers $(1\\,000),$ we get the stochastic vector of the initial state:\n\n$$\n{x}_{0}=\\frac{1}{1\\,000}[\\begin{aligned}400 \\\\ 400 \\\\ 200\\end{aligned}]=[\\begin{aligned}0.4 \\\\ 0.4 \\\\ 0.2\\end{aligned}]\n$$\n\nTo find the state vector ${x}_{1}$ after one month, we apply one step of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.4 & 0.2 & 0.3 \\\\ 0.3 & 0.4 & 0.2 \\\\ 0.3 & 0.4 & 0.5\\end{aligned}][\\begin{aligned}0.4 \\\\ 0.4 \\\\ 0.2\\end{aligned}] \\\\  & =[\\begin{aligned}0.3 \\\\ 0.32 \\\\ 0.38\\end{aligned}].\\end{aligned}\n$$\n\nSo, after one month, $38%$ of customers will buy vegetable soup. Computing $38%$ of $1\\,000,$ we obtain\n\n$$\n1\\,000\\cdot 0.38=380.\n$$\n\nTherefore, $380$ customers will buy vegetable instant soup in one month."}] :knowledge-point/title "Constructing a Stochastic Matrix and Making a Prediction"} {:db/id #edb/ref 17592186124554 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124363 :question/id #uuid "09540ff7-0444-5169-b582-471be2f1972d" :question/math-academy-id "e-5971" :question/problem "![](images/16/165917feacd28344502759fc6e03f96c5b54d9530701916b746fc489374a6d0b.png) \n\nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector $\\mathbf{x}_0$ given above. Calculate the state vector $\\mathbf{x}_2.$" :question/worked-solution "To find the state vector $\\mathbf{x}_2,$ we apply two steps of the Markov chain:\n\n$$\n\\mathbf{x_1}=P\\mathbf{x}_0, \\qquad \\mathbf{x}_2=P\\mathbf{x}_1\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =\\begin{bmatrix}0.5 & 0.1 \\\\ 0.5 & 0.9\\end{bmatrix}\\begin{bmatrix}0.2 \\\\ 0.8\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.18 \\\\ 0.82\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =\\begin{bmatrix}0.5 & 0.1 \\\\ 0.5 & 0.9\\end{bmatrix}\\begin{bmatrix}0.18 \\\\ 0.82\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.172 \\\\ 0.828\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4821de45-1b6b-5b4f-be0e-96cf5395bc8d" :knowledge-point/questions [{:db/id #edb/ref 17592186124922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6563e16f-667f-5435-9f47-0d26c955ed36" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.24 \\\\ 0.4 \\\\ 0.36\\end{aligned}]" :db/id #edb/ref 17592186550614} {:answer/id #uuid "7f84ea8c-c7c9-5b77-8633-d538a890dd1d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.2 \\\\ 0.42 \\\\ 0.56\\end{aligned}]" :db/id #edb/ref 17592186550688} {:answer/id #uuid "a403bf17-2b48-55a3-a928-1f9b4c83a2d3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.12 \\\\ 0.52 \\\\ 0.36\\end{aligned}]" :db/id #edb/ref 17592186550795} {:answer/id #uuid "bf55f709-9be8-5dd9-85dc-86bd8db6cd9e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.24 \\\\ 0.32 \\\\ 0.44\\end{aligned}]" :db/id #edb/ref 17592186550892} {:answer/id #uuid "d234ef89-b2e5-55ce-8aea-ffb54263f9df" :answer/type {:db/ident :answer.ty