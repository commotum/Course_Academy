qrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{bmatrix},\\,Q=\\begin{bmatrix}2\\sqrt{7} & \\sqrt{5} \\\\ 4\\sqrt{5} & 5\\sqrt{7}\\end{bmatrix}\n$$\n\nFind $|\\text{det}(PQ)|$ given that $P$ is an orthogonal matrix." :question/worked-solution "We use the following facts: \n\n- The determinant of a product is equal to the product of the determinants.\n\n- The determinant of an orthogonal matrix $P$ is equal to $\\pm 1.$\n\nApplying these ideas, we get the following:\n\n$$\n\\begin{aligned}|\\text{det}(PQ)| & =|\\text{det}(P)\\cdot \\text{det}(Q)| \\\\  & =|(\\pm 1)\\cdot \\text{det}(Q)| \\\\  & =|\\pm 1|\\cdot |\\text{det}(Q)| \\\\  & =|\\text{det}(Q)| \\\\  & =|2\\sqrt{7}\\cdot 5\\sqrt{7}-\\sqrt{5}\\cdot 4\\sqrt{5}| \\\\  & =50\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0017c3ff-522f-550f-ba50-ab7f6d3d884f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}+5" :db/id #edb/ref 17592186351560} {:answer/id #uuid "1bd908ef-94c7-5e6a-a16f-cd2bb7aedfc0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}+5" :db/id #edb/ref 17592186351816} {:answer/id #uuid "5c194a85-4104-5986-97cd-7a2684f730f6" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186352380} {:answer/id #uuid "97d2052a-ed7f-5229-bac6-5a4d03578614" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}-3" :db/id #edb/ref 17592186352873} {:answer/id #uuid "dca17b36-8e6b-5b04-bfe5-7dafbc3ab14b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}+5" :db/id #edb/ref 17592186353487}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}+5" :db/id #edb/ref 17592186351816} :answer-field/id #uuid "092a98ca-a013-5f27-a9ba-85301521d380" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353832}] :question/id #uuid "7dfc3ce1-c0a3-5