{bmatrix}-15 \\\\ 15\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\na+b+c=17+(-17)+15=15.\n$$"} {:db/id #edb/ref 17592186424018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20388d9f-ef78-593d-a86d-57d7b9255118" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186424008} {:answer/id #uuid "6235969c-cd1d-5e61-9e7a-9328ddcaeab8" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186424009} {:answer/id #uuid "75f256ad-47a3-5c49-a78e-1c5ae0257228" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186424010} {:answer/id #uuid "903e90ec-6c0f-5989-8ade-87db319935c6" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186424012} {:answer/id #uuid "adae751b-b0cd-56eb-9595-ed2b595298d5" :answer/type {:db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186424014}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186424008} :answer-field/id #uuid "d8116051-5575-52c2-b4e3-895e85818216" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424017}] :question/id #uuid "130f7ccc-d087-5052-915e-6df794e733bd" :question/math-academy-id "q-136921" :question/problem "$$\nA=\\begin{bmatrix}2 & 4 \\\\ 1 & 2 \\\\ 2 & 4 \\\\ -1 & -2\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $b$ above. If the normal equation corresponding to the system $Ax=b$ is given below, what is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}a & 20 \\\\ 20 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}c \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "The normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}2 & 1 & 2 & -1 \\\\ 4 & 2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}2 & 4 \\\\ 1 & 2 \\\\ 2 & 4 \\\\ -1 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 & 1 & 2 & -1 \\\\ 4 & 2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}10 & 20 \\\\ 20 & 40\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=10+40+4=54.\n$$"} {:db/id #edb/ref 17592186424019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a52bea-6ee1-5ba3-91a9-fa2c837b2777" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186424006} {:answer/id #uuid "1c6dd795-91e5-55e1-984a-5549435634d1" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186424007} {:answer/id #uuid "8612d6bf-1d46-5e5b-bb7f-ca4d007e7546" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186424011} {:answer/id #uuid "a4dbc700-783c-5f48-a597-56c6ebf71f61" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186424013} {:answer/id #uuid "d4b6a212-c60d-5b71-a8fe-b61548150715" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186424015}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186424015} :answer-field/id #uuid "389ee680-9312-52e5-a68e-aecf86a358ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424016}] :question/id #uuid "4cb13173-852b-58a2-8c1f-3d6511a05fac" :question/math-academy-id "q-136920" :question/problem "$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2}+{x}_{3} &=0 \\\\ 4{x}_{1}+2{x}_{2}+2{x}_{3} &=1\\end{aligned}\\right.\\,\\,\\begin{bmatrix}20 & 10 & a \\\\ 10 & 5 & 5 \\\\ c & 5 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}b \\\\ 2 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a+b+c?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}2 & 1 & 1 \\\\ 4 & 2 & 2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nThe normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}2 & 4 \\\\ 1 & 2 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}2 & 1 & 1 \\\\ 4 & 2 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}2 & 4 \\\\ 1 & 2 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}20 & 10 & 10 \\\\ 10 & 5 & 5 \\\\ 10 & 5 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 2 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=10+4+10=24.\n$$"} {:db/id #edb/ref 17592186442296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1053e502-fa88-53f4-be0b-479818f8c240" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186442290} {:answer/id #uuid "299f4294-b751-5683-b5f0-226953e8f833" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186442291} {:answer/id #uuid "2b3bc517-738d-5126-88d0-bb939758899a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442292} {:answer/id #uuid "65d7077d-9a54-50ce-b898-454bc4952add" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442293} {:answer/id #uuid "95715e13-7ac3-5517-874f-49e84cbcd24f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442294}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442294} :answer-field/id #uuid "78b40939-3724-59f7-a9d3-46896f75c235" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442295}] :question/id #uuid "9375f3f0-3aa6-5a84-b715-8086fa3c68db" :question/math-academy-id "q-136883" :question/problem "$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+{x}_{3} &=1 \\\\ -2{x}_{1}+4{x}_{2}-2{x}_{3} &=-1\\end{aligned}\\right.\\,\\,\\begin{bmatrix}5 & -10 & 5 \\\\ -10 & a & b \\\\ 5 & -10 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}3 \\\\ c \\\\ 3\\end{bmatrix}\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a+b+c?$" :question/worked-solution "First, we write our system in matrix form as $Ax=b,$ where \n\n$$\nA=\\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\n$$\n\nThe normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & -2 & 1 \\\\ -2 & 4 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}5 & -10 & 5 \\\\ -10 & 20 & -10 \\\\ 5 & -10 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}3 \\\\ -6 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=20+(-10)+(-6)=4.\n$$"} {:db/id #edb/ref 17592186483345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25aea580-a131-5020-b30d-b5f2b4370628" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186482878} {:answer/id #uuid "76a4e80b-2f39-52e5-80e8-443d6b5ce7ce" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186483018} {:answer/id #uuid "8285d911-033a-592a-924a-4fdc1f065e32" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186483039} {:answer/id #uuid "97b08ce5-c487-5065-ae59-8968740c7c47" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186483073} {:answer/id #uuid "cdc4dbae-9c2c-52ae-b11f-052f7e384e7e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186483156}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186482878} :answer-field/id #uuid "5dab3d8e-15fe-590d-8c8a-109dbb4d368d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483271}] :question/id #uuid "0200c257-e4df-57c1-8eaf-e14f946ede8a" :question/math-academy-id "q-41913" :question/problem "$$\nA=\\begin{bmatrix}1 & 0 & 2 \\\\ 4 & 0 & 8 \\\\ 1 & 1 & 2 \\\\ 0 & 1 & 0\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ 3 \\\\ -1\\end{bmatrix}\n$$\n\n \n\nConsider the matrix $A$ and vector $b$ above. If the normal equation corresponding to the system $Ax=b$ is given below, what is the value of $a-b-c?$ \n\n$$\n\\begin{bmatrix}18 & 1 & 36 \\\\ 1 & 2 & 2 \\\\ b & 2 & a\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}10 \\\\ 2 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "The normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ \\begin{bmatrix}1 & 4 & 1 & 0 \\\\ 0 & 0 & 1 & 1 \\\\ 2 & 8 & 2 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 & 2 \\\\ 4 & 0 & 8 \\\\ 1 & 1 & 2 \\\\ 0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 & 4 & 1 & 0 \\\\ 0 & 0 & 1 & 1 \\\\ 2 & 8 & 2 & 0\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ 3 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}18 & 1 & 36 \\\\ 1 & 2 & 2 \\\\ 36 & 2 & 72\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix} & =\\begin{bmatrix}10 \\\\ 2 \\\\ 20\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na=72,\\,b=36,\\,c=20,\n$$\n\nand hence\n\n$$\na-b-c=72-36-20=16.\n$$"}] :knowledge-point/title "Constructing the Normal Equation Corresponding to a Linear System"}] :topic/math-academy-id 2167 :topic/title "The Least-Squares Solution of a Linear System (With Collinearity)"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186176736} :activity/id #uuid "d78cd3be-1d2a-523a-8697-c68f98a589f3" :activity/steps [{:db/id #edb/ref 17592186176736 :step/content {:db/id #edb/ref 17592186176997 :tutorial/content "Not every square matrix is diagonalizable. However, if a square matrix is not diagonalizable, it is \"almost\" diagonalizable. \n\nMore precisely, every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA = PJP^{-1},\n$$\n\nwhere $J$ is a Jordan matrix, and $P$ is an invertible matrix. We say that $J$ is a **Jordan canonical form** (or **Jordan normal form**) of $A.$\n\nNot all square matrices have corresponding diagonal matrices. However, *all* square matrices have Jordan canonical forms. A Jordan canonical form is either diagonal or \"almost\" diagonal. \n\nOur goal in this lesson is to find a Jordan canonical form of any $2\\times 2$ matrix.\n\nIf a matrix is diagonalizable, then finding its Jordan canonical form is equivalent to finding its diagonal form. \n\nFor diagonalizable $2\\times 2$ matrices, we have two separate cases:\n\n- $A$ has two distinct eigenvalues.\n\n- $A$ is a **scalar matrix**. A diagonal matrix is scalar if every value on the leading diagonal is the same.\n\nLet's discuss these two cases first. Then, we will discuss the final case, which is when $A$ is not diagonalizable." :tutorial/id #uuid "08eeaf45-d9aa-50e2-a1d4-64ee464c4729" :tutorial/math-academy-id 5439 :tutorial/title "Introduction"} :step/id #uuid "a91a4bcf-6390-569f-b6db-61d6d0af3359" :step/next {:db/id #edb/ref 17592186176737}} {:db/id #edb/ref 17592186176737 :step/content {:db/id #edb/ref 17592186175988 :knowledge-point/id #uuid "65f20482-73ea-5f1c-bb2b-1d7472fbfd4e"} :step/id #uuid "1babc62c-bf05-5b82-9cc3-3c1c5db69824" :step/next {:db/id #edb/ref 17592186176775}} {:db/id #edb/ref 17592186176773 :step/content {:db/id #edb/ref 17592186177015 :tutorial/content "When a $2\\times 2$ matrix with repeated eigenvalue $\\lambda$ is not diagonalizable, its Jordan canonical form is given by\n\n$$\nJ = J_2(\\lambda).\n$$\n\nAs an example, let's find a Jordan canonical form of the matrix \n\n$$\n\\begin{bmatrix}5 & 4 \\\\ -1 & 1\\end{bmatrix}\n$$\n\nWe first find the eigenvalues of $A$ by solving $\\det(A-\\lambda I)=0{:}$\n\n$$\n\\begin{aligned}\\begin{vmatrix}5-\\lambda  & 4 \\\\ -1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(1-\\lambda )-4\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda_1=\\lambda_2=3.$ \n\nSince $A$ has a repeated eigenvalue and is not a scalar matrix, we conclude that $A$ is not diagonalizable. \n\nTherefore, in this case, the Jordan canonical form of $A$ is\n\n$$\n\\begin{bmatrix}3 & 1 \\\\ 0 & 3\\end{bmatrix}\n$$\n\nNote that $J$ is \"almost\" diagonal." :tutorial/id #uuid "70056323-b6a3-52d6-8ebc-22f6d493088b" :tutorial/math-academy-id 5584 :tutorial/title "Finding a Jordan Canonical Form of a Non-Diagonalizable 2x2 Matrix"} :step/id #uuid "ec6918dd-4d6e-5fd7-b37e-24cbfecd322f" :step/next {:db/id #edb/ref 17592186176774}} {:db/id #edb/ref 17592186176774 :step/content {:db/id #edb/ref 17592186176008 :knowledge-point/id #uuid "b629bead-e64a-5e73-ae42-80d4ebb3762b"} :step/id #uuid "06ead4b8-8dc4-5c4b-9215-eb8ae6101d9f" :step/next {:db/id #edb/ref 17592186176778}} {:db/id #edb/ref 17592186176775 :step/content {:db/id #edb/ref 17592186176009 :knowledge-point/id #uuid "511398e8-780e-57b2-8f1b-092e9f6cca45"} :step/id #uuid "f282e279-40b8-542c-86e5-6dbd39bf2e2c" :step/next {:db/id #edb/ref 17592186176773}} {:db/id #edb/ref 17592186176778 :step/content {:db/id #edb/ref 17592186177017 :tutorial/content "Given a $2 \\times 2$ matrix $A,$ we have $3$ possible cases:\n\n- If $A$ has two distinct eigenvalues $\\lambda_1 \\neq \\lambda_2,$ then $A$ is diagonalizable, and $J$ is a diagonal matrix. In this case, $J$ is a composition of two distinct $1 \\times 1$ Jordan blocks:\n\n$$\n\\begin{bmatrix}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{bmatrix}\n$$\n\n- If $A$ has only one eigenvalue $\\lambda$ of algebraic multiplicity $2$ and there exist two linearly independent eigenvectors corresponding to this eigenvalue, then $A$ must be a scalar matrix. This situation corresponds to the case where $A$ is already diagonalized, and $J$ is a composition of two identical $1 \\times 1$ Jordan blocks:\n\n$$\n\\begin{bmatrix}\\lambda  & 0 \\\\ 0 & \\lambda \\end{bmatrix}\n$$\n\n- If $A$ has only one eigenvalue $\\lambda$ of algebraic multiplicity $2$ and only one linearly independent eigenvector exists that corresponds to this eigenvalue, then $A$ is not diagonalizable. In this case, $J$ is a single $2 \\times 2$ Jordan block:\n\n$$\n\\begin{bmatrix}\\lambda  & 1 \\\\ 0 & \\lambda \\end{bmatrix}\n$$\n\nSo, in two out of three cases, our matrix is diagonalizable. But in the third case, the closest we can get to a diagonal matrix is a Jordan block with a $1$ on the superdiagonal." :tutorial/id #uuid "56909b69-a1ff-5904-931a-bb0ed2f8da72" :tutorial/math-academy-id 5597 :tutorial/title "Overview of All Possible Jordan Canonical Forms of 2x2 Matrices"} :step/id #uuid "72da1946-1276-5e5b-935a-3b2250f7ee5e"}] :activity/title "Jordan Canonical Form of a 2x2 Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186176147} {:activity/first-step {:db/id #edb/ref 17592186417024} :activity/id #uuid "1a828261-7549-50fc-9351-973710b5a9dc" :activity/steps [{:db/id #edb/ref 17592186417023 :step/content {:db/id #edb/ref 17592186417021 :question/id #uuid "ac392660-8c5c-5e68-838e-b85d4459418a"} :step/id #uuid "3aabf133-bf72-52b0-a030-8bc47c57798f"} {:db/id #edb/ref 17592186417024 :step/content {:db/id #edb/ref 17592186176224 :question/id #uuid "8231d418-c039-5ff1-a299-022f1329d9d4"} :step/id #uuid "3df4f0c7-e2f6-53d4-bf59-1f902df4fbc7" :step/next {:db/id #edb/ref 17592186417025}} {:db/id #edb/ref 17592186417025 :step/content {:db/id #edb/ref 17592186417022 :question/id #uuid "e942ac9f-a757-5ca8-b8d8-e1e06a44c7a7"} :step/id #uuid "4f73b6c6-716a-5db9-bcea-62459f215b9f" :step/next {:db/id #edb/ref 17592186417026}} {:db/id #edb/ref 17592186417026 :step/content {:db/id #edb/ref 17592186417019 :question/id #uuid "62c396bc-091d-5afa-9941-7c10127fae8a"} :step/id #uuid "9391166f-6480-5bb0-a92a-2c09079f320d" :step/next {:db/id #edb/ref 17592186417027}} {:db/id #edb/ref 17592186417027 :step/content {:db/id #edb/ref 17592186417020 :question/id #uuid "69022431-229c-5853-9ee3-a4c4ae931331"} :step/id #uuid "e857209b-3061-52e6-9a22-de05db4ab83e" :step/next {:db/id #edb/ref 17592186417023}}] :activity/title "Jordan Canonical Form of a 2x2 Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186416988}] :db/id #edb/ref 17592186049576 :topic/knowledge-points [{:db/id #edb/ref 17592186175988 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175839 :question/id #uuid "e1c44d04-1798-5619-813d-a75e8f05140d" :question/math-academy-id "e-9087" :question/problem "Find a Jordan canonical form of the matrix \n![](images/1a/1a6c3918b93419f9576951374ebd69b2df271106345493084ffa0797b0a35847.png)" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA = PJP^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $\\det(A-\\lambda I)=0{:}$\n\n$$\n\\begin{aligned}|\\begin{aligned}5-\\lambda  & 4 \\\\ 2 & -2-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(-2-\\lambda )-4\\cdot 2 & =0 \\\\ {\\lambda }^{2}-3\\lambda -18 & =0 \\\\ (\\lambda -6)(\\lambda +3) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are $\\lambda_1=-3$ and $\\lambda_2=6.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n![](images/d6/d6c87739f52f450b27c68a118bba04e51e68a377da7d0a16ae0658e1b2d547f0.png)\n\n**Note**: A Jordan canonical form is unique up to permutations of its Jordan blocks. Therefore, another Jordan canonical form for this matrix is\n\n![](images/7b/7bd509d943bf0707e75c9436aee3a511f8366502bbf8121b715cec8ce366953b.png)"} :knowledge-point/id #uuid "65f20482-73ea-5f1c-bb2b-1d7472fbfd4e" :knowledge-point/questions [{:db/id #edb/ref 17592186176225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b17622-2bed-5fdf-a001-6fed60a0e93d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173609} {:answer/id #uuid "c4667d2e-b3e6-57a3-af29-52f2fb24c0be" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173610} {:answer/id #uuid "fd725588-9adf-5c5c-949f-ec236a9b9a91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173611} {:answer/id #uuid "3d63b09a-3934-5fe3-bcc2-33aac9c09e71" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173612} {:answer/id #uuid "3e409f37-33b3-5d46-ac67-07b2990b8f92" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186173613}] :answer-field/id #uuid "b1148468-12b7-54d1-9cd0-e88e06b85167" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173608} {:answer-field/choices [{:answer/id #uuid "e9deac94-910d-5b63-9e57-f2b87ce35388" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386296} {:answer/id #uuid "1ed1599f-3aad-5db6-88b0-67ffb6cefac0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386297} {:answer/id #uuid "a98ce391-9389-52eb-9e86-0f61cb9645c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386298} {:answer/id #uuid "c1239255-deea-5186-b902-2c62a0e4f9b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386299} {:answer/id #uuid "77e95aa7-899b-565b-8665-45a05cc48157" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386300}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186386300} :answer-field/id #uuid "1868ed6f-a38d-5a16-93a8-ed4612cf63a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386295}] :question/id #uuid "7a50741c-c4f5-5a02-bb86-14c9da06d5cf" :question/math-academy-id "q-108719" :question/problem "Find a Jordan canonical form of the matrix \n$A=\\begin{bmatrix}6 & 5 \\\\ -10 & -9\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(-4)=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186176282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1441c511-da12-53ae-8f9f-c5ea647d372c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186244500} {:answer/id #uuid "7c7e1b6c-2ab7-59c0-9f5a-5f9c53675cd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186245404} {:answer/id #uuid "9d3ea264-8cea-5f04-ac0a-1a432e019399" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186245712} {:answer/id #uuid "de4be96b-1fd2-5c0e-9a1e-5b6fbb0e9166" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186246281} {:answer/id #uuid "ef6b3d93-1eda-5a13-827c-9e25c91d6216" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186246432}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186246432} :answer-field/id #uuid "4da5d5fa-ba17-5504-b9bf-88fe68f53ded" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246674}] :question/id #uuid "036242ed-9cf3-5798-a052-46558ecda9fb" :question/math-academy-id "q-112453" :question/problem "Find a Jordan canonical form of the matrix \n$A=\\begin{bmatrix}5 & -2 \\\\ 1 & 8\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}5-\\lambda  & -2 \\\\ 1 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(8-\\lambda )-(-2)(1) & =0 \\\\ {\\lambda }^{2}-13\\lambda +42 & =0 \\\\ (\\lambda -7)(\\lambda -6) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=7$ and ${\\lambda }_{2}=6.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(7)\\,⊕\\,{J}_{1}(6)=\\begin{bmatrix}7 & 0 \\\\ 0 & 6\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186244272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ce7a75-813f-5ae4-b539-bccc51785d0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186241988} {:answer/id #uuid "7e8994de-63ba-53ae-b699-bc7263d361c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186242291} {:answer/id #uuid "93704c6d-c0fb-525a-ae41-0563128e7814" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186242472} {:answer/id #uuid "98183edb-8f61-5213-a098-3a5d7f57525e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186242512} {:answer/id #uuid "a30ab4aa-b409-53b0-968d-af58d57b67bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186242606}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186242512} :answer-field/id #uuid "8bb16f68-5636-5662-9ee8-09a56750b6b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243701}] :question/id #uuid "52870c2b-5862-5c0b-884f-72d410941954" :question/math-academy-id "q-109316" :question/problem "Find a Jordan canonical form of the matrix \n$A=\\begin{bmatrix}1 & 2 \\\\ 2 & -2\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1-\\lambda  & 2 \\\\ 2 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(-2-\\lambda )-(2)(2) & =0 \\\\ {\\lambda }^{2}+\\lambda -6 & =0 \\\\ (\\lambda +3)(\\lambda -2) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(-3)\\,⊕\\,{J}_{1}(2)=\\begin{bmatrix}-3 & 0 \\\\ 0 & 2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186247271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11c08573-7da9-5f3b-b9fd-fec195d31103" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186244476} {:answer/id #uuid "5e335c01-3ed8-5339-b6f5-9c86715a3d81" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186245144} {:answer/id #uuid "6f39158b-343b-54a4-a58f-8a9e22e04844" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186245302} {