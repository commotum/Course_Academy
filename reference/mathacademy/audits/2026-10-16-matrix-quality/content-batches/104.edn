/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 9 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186416998} {:answer/id #uuid "5fa36f3b-bf80-5db3-b764-a0218c369342" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 0 & 9\\end{bmatrix}" :db/id #edb/ref 17592186417000} {:answer/id #uuid "a2ff33c1-3f15-529f-84b2-061fce0b1530" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 9\\end{bmatrix}" :db/id #edb/ref 17592186417006} {:answer/id #uuid "a4115946-4c02-5432-b8f2-66ab9b1555c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186417007} {:answer/id #uuid "abb8b95a-5b60-56cf-a1e8-1a33cc205b9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 1 \\\\ 0 & 9\\end{bmatrix}" :db/id #edb/ref 17592186417008}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 0 & 9\\end{bmatrix}" :db/id #edb/ref 17592186417000} :answer-field/id #uuid "9b283720-eadb-54f9-b376-5d69b0511f8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417015}] :question/id #uuid "62c396bc-091d-5afa-9941-7c10127fae8a" :question/math-academy-id "q-112447" :question/problem "Find the Jordan canonical form of the matrix \n$A=\\begin{bmatrix}9 & 0 \\\\ 0 & 9\\end{bmatrix}.$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nNotice that $A$ is a scalar matrix, which means that it is already in Jordan canonical form. Therefore, it has a single (repeated) eigenvalue $\\lambda =9,$ and\n\n$$\nJ=A=9I=\\begin{bmatrix}9 & 0 \\\\ 0 & 9\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186417022 :question/answer-fields [{:answer-field/choices [{:answer/id #u