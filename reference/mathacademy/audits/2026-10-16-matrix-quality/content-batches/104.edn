rix}" :db/id #edb/ref 17592186484957} {:answer/id #uuid "8504229e-0026-5df9-835e-7fe9e313f2ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186485104} {:answer/id #uuid "aa7e2b55-2e48-5a32-bdcc-b4982d78bb17" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186485185} {:answer/id #uuid "d8eeb0b4-6fde-5e11-820c-fd3ac0790bd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 0 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186485271} {:answer/id #uuid "e6941f8d-a51c-5dea-b565-f989e9b10972" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{2} \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186485302}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186485185} :answer-field/id #uuid "c1b3bc70-0e0f-5fed-8f78-181f20b95555" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131491}] :question/id #uuid "ab7c31a0-8694-52ae-9c85-3e23bf4389e6" :question/math-academy-id "q-39867" :question/problem "Solve for $x$ in $Ax=b$ given that the matrix $A$ is orthogonal, and \n\n$$\nA=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & -1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,b=\\begin{bmatrix}2\\sqrt{2} \\\\ 0 \\\\ -2\\sqrt{2}\\end{bmatrix}.\n$$" :question/worked-solution "The inverse of an orthogonal matrix is equal to its transpose.\n\nHence, since $A$ is orthogonal, we have ${A}^{-1}={A}^{T}.$ Therefore,\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ x & ={A}^{-1}b \\\\ x & ={A}^{T}b \\\\ x & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & -1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}2\\sqrt{2} \\\\ 0 \\\\ -2\\sqrt{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166cacd8-7020-5f1c-86a5-0227fea99376" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{7}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186269457} {:answer/id #uuid "21c788c6-1356-57a2-82a0-5f5207d35468" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186269559} {:answer/id #uuid "24c0b08e-bf14-5222-ab2b-25191a1a367a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{7}{3} \\\\ -\\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186269592} {:answer/id #uuid "a9468d13-9fb6-50d4-9618-5f4c85674da0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{3} \\\\ -\\frac{1}{3} \\\\ \\frac{7}{3}\\end{bmatrix}" :db/id #edb/ref 17592186270778} {:answer/id #uuid "dd314a8d-8509-5487-9dae-61cddef0e332" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{7}{3}\\end{bmatrix}" :db/id #edb/ref 17592186271210}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{7}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186269457} :answer-field/id #uuid "8681c451-1220-56a4-bf52-1ccbfa0f5a57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271745}] :question/id #uuid "37be5226-f355-5da6-9310-01c6af117505" :question/math-academy-id "q-140563" :question/problem "Solve for $x$ in $Ax=b$ given that the matrix $A$ is orthogonal, and \n\n$$\nA=\\begin{bmatrix}\\frac{1}{3} & \\frac{2}{3} & -\\frac{2}{3} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ -\\frac{2\\sqrt{5}}{15} & \\frac{\\sqrt{5}}{3} & \\frac{4\\sqrt{5}}{15}\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ \\sqrt{5} \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "The inverse of an orthogonal matrix is equal to its transpose.\n\nHence, since $A$ is orthogonal, we have ${A}^{-1}={A}^{T}.$ Therefore,\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ x & ={A}^{-1}b \\\\ x & ={A}^{T}b \\\\ x & =\\begin{bmatrix}\\frac{1}{3} & \\frac{2}{\\sqrt{5}} & -\\frac{2\\sqrt{5}}{15} \\\\ \\frac{2}{3} & 0 & \\frac{\\sqrt{5}}{3} \\\\ -\\frac{2}{3} & \\frac{1}{\\sqrt{5}} & \\frac{4\\sqrt{5}}{15}\\end{bmatrix}\\begin{bmatrix}1 \\\\ \\sqrt{5} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{7}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09dcffe0-ee7a-5e63-8278-dca38632fe98" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{10} & -\\sqrt{10} \\\\ \\sqrt{10} & -\\sqrt{10}\\end{bmatrix}" :db/id #edb/ref 17592186351652} {:answer/id #uuid "20da2b06-38a4-5f6f-bd3b-23e027784978" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{10} & \\sqrt{10} \\\\ -\\sqrt{10} & -\\sqrt{10}\\end{bmatrix}" :db/id #edb/ref 17592186351862} {:answer/id #uuid "3c0842ed-cdfa-501d-926c-0f64071688a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186352124} {:answer/id #uuid "a960c5de-6970-5dbc-9644-409ecdc07fdd" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ is not invertible" :db/id #edb/ref 17592186353004} {:answer/id #uuid "effacf4a-06ee-5f96-940d-3f6cb94b7ab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{3}{\\sqrt{10}} & \\