tep/content {:db/id #edb/ref 17592186371332 :question/id #uuid "01aea047-32df-527d-acda-292ec1b804c9"} :step/id #uuid "efda492f-25e3-5015-b6b0-eea97e75b0a2" :step/next {:db/id #edb/ref 17592186564568}}] :activity/title "Singular Value Decomposition of 2x2 Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186563965}] :db/id #edb/ref 17592186050726 :topic/knowledge-points [{:db/id #edb/ref 17592186162016 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161808 :question/id #uuid "232a0173-d743-5696-a6d9-c8279514bcba" :question/math-academy-id "e-8413" :question/problem "![](images/e5/e56fbd2ced76bc02d7c9b29a81f3afab000053d11ec878040f26cef6cc5f65ce.svg)\nConsider the matrix $U$ shown above. Given that $A=U \\Sigma V^T$ is a singular value decomposition of a $2\\times2$ matrix $A,$ which of the following could be the second column of the matrix $U?$\n![](images/ba/ba1b9ecff7b4825d7eb4fa25ad706c14d04a82b8daa45e524d556c90d71700ca.svg)" :question/worked-solution "Recall that since $A=U \\Sigma V^T$ is a singular value decomposition of a $2\\times2$ matrix $A,$ the matrix $U$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{bmatrix}$ has both properties."} :knowledge-point/id #uuid "c94ec9c4-650f-5d39-9294-651b03b172bf" :knowledge-point/questions [{:db/id #edb/ref 17592186162660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2facb273-5b3a-5cd5-9f77-b45e57823a4d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186161253} {:answer/id #uuid "3175fa9c-0a3f-5a90-8e08-d7d3002df8e9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186161254} {:answer/id #uuid "37cc9058-a8d4-59c8-bfa8-b764a691e3f0" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186161255} {:answer/id #uuid "4ca5f6ce-8716-53ea-ac9d-2ea2360d48ba" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186161256} {:answer/id #uuid "71114289-f465-58cb-af70-f6df347e2413" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186161257}] :answer-field/id #uuid "ab755589-0d45-52a6-832b-6db01c5b097a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161252}] :question/id #uuid "10427aa7-40f6-5201-b68f-d8ce041b7d25" :question/math-academy-id "q-95711" :question/problem "Given the singular value decomposition $A = UΣV^{T}$, where $A$ is a $3 \\cdot 2$ matrix, which of the following statements are true?\n\n1. $U$ is a $3 \\cdot 3$ matrix\n2. $V$ is an orthogonal matrix\n3. $U$ is a symmetric matrix"} {:db/id #edb/ref 17592186162661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6af590b-55e9-50ca-967b-137596f7e2a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371272} {:answer/id #uuid "c185b138-6500-5add-8f60-2acaf5c45f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371273} {:answer/id #uuid "a698c5de-7d7a-53e9-b6b3-0a8b34b021f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186371274} {:answer/id #uuid "bb1ac6ce-abc8-59d7-8bf1-4a21048147c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186371275} {:answer/id #uuid "2736d822-5317-5398-ac4b-44b773f5fdea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371276}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371272} :answer-field/id #uuid "77cacd37-552d-5101-8376-7ec4e8525d61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371271}] :question/id #uuid "ac18412f-c58c-58db-864c-85b0aa3758c1" :question/math-academy-id "q-95713" :question/problem "$$\nU=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\,∗\\, \\\\ -\\frac{1}{\\sqrt{5}} & \\,∗\\,\\end{bmatrix}\n$$\n\nConsider the matrix $U$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ which of the following could be the second column of the matrix $U?$" :question/worked-solution "Recall that since $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ the matrix $U$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}$ has both properties."} {:db/id #edb/ref 17592186369783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b9cd8ec-34b0-5264-9342-7001d366e227" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186369785} {:answer/id #uuid "99a44a66-ca0e-59ed-b288-489aa0bc0e6d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186369786} {:answer/id #uuid "0ce5c0ce-eb03-59b7-acd9-b1e758b553ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186369787} {:answer/id #uuid "07fd189d-6d8e-58c7-a251-35f39c4b571d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186369788} {:answer/id #uuid "6b293b03-8103-5a42-af9e-675bdac3e64c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186369789}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186369788} :answer-field/id #uuid "01a9c185-8587-5c2b-99f9-ccc53cebb3a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369784}] :question/id #uuid "3faf95ec-a55f-54ec-912a-16a996122518" :question/math-academy-id "q-140632" :question/problem "$$\nV=\\begin{bmatrix}\\,∗\\, & \\frac{3}{5} \\\\ \\,∗\\, & \\frac{4}{5}\\end{bmatrix}\n$$\n\nConsider the matrix $V$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ which of the following could be the first column of the matrix $V?$" :question/worked-solution "Recall that since $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ the matrix $V$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the first column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}$ has both properties."} {:db/id #edb/ref 17592186371311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db30ab95-8699-5004-b903-54a7d7052417" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454232} {:answer/id #uuid "271ff49f-e72c-5468-9c3f-0cc6c530d565" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454233}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454232} :answer-field/id #uuid "1db4f576-2ad1-5320-8590-67d86f0c7439" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454866} {:answer-field/choices [{:answer/id #uuid "4148eede-5713-54e3-bd86-a0acb6357545" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454234} {:answer/id #uuid "6277a987-dd0e-589e-8b01-33031824c5b9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454235}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454235} :answer-field/id #uuid "4a8fecf1-fd37-5bd2-88ad-dc7ce65627e7" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454867} {:answer-field/choices [{:answer/id #uuid "606ef50e-5565-573c-a9cc-adfb12eb722a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454236} {:answer/id #uuid "ef77a733-82ed-51f8-8913-ee4a16c23eaf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454237}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454236} :answer-field/id #uuid "33a5cf3b-bfbb-5c3f-8007-277d8855dbec" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454868}] :question/id #uuid "2fb35509-809b-57e2-9940-708d4200bd1d" :question/math-academy-id "q-96119" :question/problem "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $4\\times 2$ matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Σ$ is an orthogonal matrix\n- **II.** $U$ is a $4\\times 4$ matrix\n- **III.** $V$ is a symmetric matrix" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. The matrix $Σ$ must be diagonal but not necessarily orthogonal.\n\n- Statement II is true. Indeed, since $A$ is a $4\\times 2$ matrix,the matrix $U$ in the singular value decomposition $UΣ{V}^{T}$ must be orthogonal $4\\times 4$ matrix.\n\n- Statement III is false. The matrix $V$ must be orthogonal but not necessarily symmetric.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186371318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2e6c66-9a79-55e3-b1e0-94a4d29ebfc8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454238} {:answer/id #uuid "7a02bb30-1669-593f-af54-15cf2d69a411" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454239}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454239} :answer-field/id #uuid "96b94f0d-44e4-5954-a592-c0a67cf046d3" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454869} {:answer-field/choices [{:answer/id #uuid "ca7d9711-e8da-5402-9353-d7a54c6fdd1b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454240} {:answer/id #uuid "258167a2-8c9b-5c15-b4d3-d269611a65f3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454241}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454240} :answer-field/id #uuid "9075c6d7-7962-5c2f-853b-b0a4037eac22" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454870} {:answer-field/choices [{:answer/id #uuid "5ec35b84-9702-578b-bcaa-46c83d81452c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454242} {:answer/id #uuid "b986e593-ff87-5dce-80c3-5466a385fd15" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454243}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454243} :answer-field/id #uuid "39546f24-c90a-5e38-bfbe-6ba14074b842" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454871}] :question/id #uuid "d3302b4c-3bdd-5b04-9e3e-aac900425c6e" :question/math-academy-id "q-96120" :question/problem "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $5\\times 3$ matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Σ$ is a $5\\times 3$ matrix\n- **II.** $Σ$ is a diagonal matrix with only positive elements on the main diagonal\n- **III.** $V$ is a $3\\times 3$ orthogonal matrix" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $5\\times 3$ matrix, $Σ$ must be a $5\\times 3$ matrix.\n\n- Statement II is false. The matrix $Σ$ in the singular value decomposition $UΣ{V}^{T}$ must be diagonal with nonnegative elements on the main diagonal. The main diagonal may contain zeroes.\n\n- Statement III is true. Indeed, since $A$ is a $5\\times 3$ matrix, $V$ in the singular value decomposition $UΣ{V}^{T}$ must be a $3\\times 3$ orthogonal matrix.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186399295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80ab0437-c045-5c7f-b38c-be5cb1712a21" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}" :db/id #edb/ref 17592186399297} {:answer/id #uuid "907e5e7f-7e94-57d6-9bfb-14bd7f6ece40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ -\\frac{2}{\\sqrt{13}}\\end{bmatrix}" :db/id #edb/ref 17592186399298} {:answer/id #uuid "0e159865-11e2-5161-bb1a-c643efc6678d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186399299} {:answer/id #uuid "57e76023-479d-5f84-af88-1fb8fed76692" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186399300} {:answer/id #uuid "2546f306-2d7a-5ce6-8172-c0754a16f6b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186399301}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ -\\frac{2}{\\sqrt{13}}\\end{bmatrix}" :db/id #edb/ref 17592186399298} :answer-field/id #uuid "7b34650b-cc77-5f2b-8326-4e505803a14c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399296}] :question/id #uuid "eab879a0-3375-58dd-903d-5ef4248752b2" :question/math-academy-id "q-96231" :question/problem "$$\nU=\\begin{bmatrix}\\frac{2}{\\sqrt{13}} & \\,∗\\, \\\\ \\frac{3}{\\sqrt{13}} & \\,∗\\,\\end{bmatrix}\n$$\n\nConsider the matrix $U$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ which 