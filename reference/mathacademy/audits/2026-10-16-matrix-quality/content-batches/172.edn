1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186371383} :answer-field/id #uuid "f9c6dbf7-365b-568c-b7a1-8cd4a51005ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371382}] :question/id #uuid "f93258a8-eb4b-5688-9b20-35af35814e98" :question/math-academy-id "q-96354" :question/problem "$$\nA=\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 3\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix}}^{T}\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}17 & 8 \\\\ 8 & 17\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=3.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=25,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =\\begin{bmatrix}17 & 8 \\\\ 8 & 17\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-8 & 8 \\\\ 8 & -8\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=9,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-9I & =\\begin{bmatrix}17 & 8 \\\\ 8 & 17\\end{bmatrix}-9\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}8 & 8 \\\\ 8 & 8\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-9I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}\\frac{5}{\\sqrt{2}} \\\\ \\frac{5}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{3}\\begin{bmatrix}4 & 1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}-\\frac{3}{\\sqrt{2}} \\\\ \\frac{3}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186383445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3fdc7b-cc4f-5300-9428-be412b8d82e8" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186383447} {:answer/id #uuid "7580f4d3-a9ae-53bf-87d8-25751de6fad2" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}}\\end{bmatrix}$" :db/id #edb/ref 17592186383448} {:answer/id #uuid "97463941-fa0d-59f8-b1db-e649cb46ab0f" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{4}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}\\frac{4}{5} & \\frac{3}{5} \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$" :db/id #edb/ref 17592186383449} {:answer/id #uuid "c6bd6c2b-d9f4-56e6-9f0d-e1028d64607b" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186383450} {:answer/id #uuid "8a4aa31f-a713-577a-a29e-2db3742c2525" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{4}{5} & \\frac{3}{5} \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}-\\frac{4}{5} & -\\frac{3}{5} \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$" :db/id #edb/ref 17592186383451}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{4}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$\nand \n$V=\\begin{bmatrix}\\frac{4}{5} & \\frac{3}{5} \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}$" :db/id #edb/ref 17592186383449} :answer-field/id #uuid "74ab9e4f-dd58-5516-8c25-76193498e9c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383446}] :question/id #uuid "dbd7a90d-1fca-5332-9851-2184d13895b4" :question/math-academy-id "q-140645" :question/problem "$$\nA=\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}15 & 0 \\\\ 0 & 10\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 12 \\\\ -12 & 1\\end{bmatrix}\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}180 & -60 \\\\ -60 & 145\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=15$ and ${\\sigma }_{2}=10.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=225,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-225I & =\\begin{bmatrix}180 & -60 \\\\ -60 & 145\\end{bmatrix}-225\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-45 & -60 \\\\ -60 & -80\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-225I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=100,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-100I & =\\begin{bmatrix}180 & -60 \\\\ -60 & 145\\end{bmatrix}-100\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}80 & -60 \\\\ -60 & 45\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-100I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A:$ Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{15}\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix} \\\\  & =\\frac{1}{15}\\begin{bmatrix}12 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{10}\\begin{bmatrix}6 & -12 \\\\ 12 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}-6 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}\\frac{4}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{4}{5}\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{4}{5} & \\frac{3}{5} \\\\ -\\frac{3}{5} & \\frac{4}{5}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186395086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "332ee583-e727-5bba-8acd-922d23695b56" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{3}{\\sqrt{5}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186395088} {:answer/id #uuid "a10add95-adc6-5235-9f97-1b43eca22a80" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{3}{\\sqrt{5}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186395089} {:answer/id #uuid "cd26ab61-b779-5a11-875e-496dff8002aa" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186395090} {:answer/id #uuid "193f3747-9a2d-5cbb-a6bc-941942f42e0e" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186395091} {:answer/id #uuid "2f4b6724-9b4a-518a-bc3a-5a3c01258664" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186395092}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186395091} :answer-field/id #uuid "9d28a695-b25d-5276-8883-5cca1cebedbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395087}] :question/id #uuid "5db18361-738b-5a9a-b3b0-1db51bcde1bd" :question/math-academy-id "q-95911" :question/problem "$$\nA=\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix},\\,Σ=\\begin{bmatrix}10 & 0 \\\\ 0 & 5\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix}}^{T}\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 7 \\\\ 2 & 6\\end{bmatrix}\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}85 & 30 \\\\ 30 & 40\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=10$ and ${\\sigma }_{2}=5.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=100,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-100I & =\\begin{bmatrix}85 & 30 \\\\ 30 & 40\\end{bmatrix}-100\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-15 & 30 \\\\ 30 & -60\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-100I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=25,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =\\begin{bmatrix}85 & 30 \\\\ 30 & 40\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}60 & 30 \\\\ 30 & 15\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{10}\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix}\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{10}\\begin{bmatrix}-2\\sqrt{5} \\\\ 10\\sqrt{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-6 & 2 \\\\ 7 & 6\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}2\\sqrt{5} \\\\ \\sqrt{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186404836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e43e58b-e171-5bde-8e66-fa1047e3a5e7" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186404838} {:answer/id #uuid "ad42d289-8707-56c1-bf83-45db2fe36ea2" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186404839} {:answer/id #uuid "999d413b-60b1-5bd7-abe7-54bb8a4e91b7" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{1}{\\sqrt{13}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & -\\frac{1}{\\sqrt{13}} \\\\ \\frac{1}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186404840} {:answer/id #uuid "fbe630aa-18c2-5c17-a5c7-5d9c6cf67fbb" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186404841} {:answer/id #uuid "7758da6c-c911-54cb-96cc-7117ea4fabca" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & -\\frac{1}{\\sqrt{13}} \\\\ \\frac{1}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{1}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186404842}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186404839} :answer-field/id #uuid "ca27652a-1905-5111-863a-956b813d6f8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404837}] :question/id #uuid "069d96cb-6a82-58f7-9653-ba67b55165b9" :question/math-academy-id "q-95912" :question/problem "$$\nA=\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix},\\,Σ=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -6 \\\\ -6 & 13\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=4$ and ${\\sigma }_{2}=1.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=16,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-16I & =\\begin{bmatrix}4 & -6 \\\\ -6 & 13\\end{bmatrix}-16\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-12 & -6 \\\\ -6 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-16I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=1,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-I & =\\begin{bmatrix}4 & -6 \\\\ -6 & 13\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}3 & -6 \\\\ -6 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{4}\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-\\frac{4}{\\sqrt{5}} \\\\ \\frac{8}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}\\begin{bmatrix}0 & -2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}}\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186404891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4eaa68b-520c-58b4-a17b-57dd48766c58" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{3}{\\sqrt{13}} & -\\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186404893} {:answer/id #uuid "dad029c8-f1bd-5774-bd9b-6cc44666c74f" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$" :db/id #edb/ref 17592186404894} {:answer/id #uuid "b1179464-c161-5f17-9d1b-ec79fe124e14" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{4}{\\sqrt{17}} & -\\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{bmatrix}$" :db/id #edb/ref 17592186404895} {:answer/id #uuid "13acfcf7-36f6-5edb-88df-5d728cfbb0ec" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & -\\frac{1}{\\sqrt{17}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{bmatrix}$" :db/id #edb/ref 17592186404896} {:answer/id #uuid "717ea9f0-7aa4-55d1-823a-4458379130c2" :answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}\\frac{3}{\\sqrt{10}} & -\\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$" :db/id #edb/ref 17592186404897}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$U=\\begin{bmatrix}-\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & -\\frac{1}{\\sqrt{17}}\\end{bmatrix}$\nand\n$V=\\begin{bmatrix}\\frac{1}{\\sqrt{17}} & -\\frac{4}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}}\\end{bmatrix}$" :db/id #edb/ref 17592186404896} :answer-field/id #uuid "e29ceeea-56