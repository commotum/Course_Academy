 3\\end{bmatrix}.$ Dividing $v$ by its norm, we get \n\n$$\n\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{bmatrix}.\n$$\n\nTherefore,\n\n$$\n|{v}_{12}|+|{v}_{22}|=|\\frac{1}{\\sqrt{10}}|+|\\frac{3}{\\sqrt{10}}|=\\frac{4}{\\sqrt{10}}.\n$$"} {:db/id #edb/ref 17592186371283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e784017-9f26-57fb-8d09-e2c85b00c13e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186371285} {:answer/id #uuid "c0fd7571-0b27-57c2-bd8b-9ae270401cc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186371286} {:answer/id #uuid "053e86da-1624-5e0f-a032-984baf156135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{5}}" :db/id #edb/ref 17592186371287} {:answer/id #uuid "7a7c0920-0814-53cc-a6b5-0e0aded26986" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186371288} {:answer/id #uuid "52d8a537-0c37-5e79-800b-5a598b1c9e12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186371289}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{5}}" :db/id #edb/ref 17592186371287} :answer-field/id #uuid "06d08e03-206a-52a5-b561-b040a6082be8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371284}] :question/id #uuid "7f6a8969-0c0e-547e-babb-6ff2c612e774" :question/math-academy-id "q-95903" :question/problem "$$\n{A}^{T}\\,A=\\begin{bmatrix}68 & 26 \\\\ 26 & 29\\end{bmatrix},\\,Σ=\\begin{bmatrix}9 & 0 \\\\ 0 & 4\\end{bmatrix},\\,V=\\begin{bmatrix}{v}_{11} & {v}_{12} \\\\ {v}_{21} & {v}_{22}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the value of $|{v}_{12}|+|{v}_{22}|?$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ the columns of $V$ must be the right singular vectors of $A,$ i.e., the unit eigenvectors of the matrix ${A}^{T}\\,A.$\n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=9$ and ${\\sigma }_{2}=4.$ So, the second column of $V$ corresponds to the singular value ${\\sigma }_{2}=4.$\n\nHence, we need to find a unit eigenvector of ${A}^{T}\\,A$ that corresponds to ${\\lambda }_{2}={\\sigma }_{2}^{2}=16.$ Computing ${A}^{T}\\,A-16I,$ we get\n\n$$\n{A}^{T}\\,A-16I=\\begin{bmatrix}68 & 26 \\\\ 26 & 29\\end{bmatrix}-16\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}52 & 26 \\\\ 26 & 13\\end{bmatrix}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-16I)v=0$ gives the eigenvector $v=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$ Dividing $v$ by its norm, we get \n\n$$\n\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\nTherefore,\n\n$$\n|{v}_{12}|+|{v}_{22}|=|-\\frac{1}{\\sqrt{5}}|+|\\frac{2}{\\sqrt{5}}|=\\frac{3}{\\sqrt{5}}.\n$$"} {:db/id #edb/ref 17592186371290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8816896f-cca6-5ce2-bf30-8d2b1f66e3f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186371292} {:answer/id #uuid "2e10c5b6-c997-5994-9093-7e45e10efbd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{5}}" :db/id #edb/ref 17592186371293} {:answer/id #uuid "d4fea695-072e-5f95-902a-71d988e363cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186371294} {:answer/id #uuid "dcd9c1a8-ef05-5de9-af7d-a1baeb76d255" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186371295} {:answer/id #uuid "5b42e903-5007-58dd-9a44-08bf6ca76aa