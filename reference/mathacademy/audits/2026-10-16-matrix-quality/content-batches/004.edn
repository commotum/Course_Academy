answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366883}] :question/id #uuid "805370e1-4b6f-5f6b-992c-fc44245708cb" :question/math-academy-id "q-108895" :question/problem "Find \n$|\\begin{aligned}1 & 9 & 0 \\\\ d & e & 0 \\\\ 0 & 0 & 5\\end{aligned}|$\ngiven that \n$|\\begin{aligned}1 & 9 \\\\ d & e\\end{aligned}|=9.$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 9 & 0 \\\\ d & e & 0 \\\\ 0 & 0 & 5\\end{aligned}| & =|\\begin{aligned}1 & 9 & 0 \\\\ d & e & 0 \\\\ 0 & 0 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 9 \\\\ d & e\\end{aligned}|\\cdot 5 \\\\  & =9\\cdot 5 \\\\  & =45\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b03d98ca-28a3-5b1b-837b-365735626fc1" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186113455} {:answer/id #uuid "cd0aea47-9012-5647-a71d-743dddececee" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186113456} {:answer/id #uuid "cf0b1d3a-5028-5c48-ac1b-b85de77895d2" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186113457} {:answer/id #uuid "3e4fdab7-20e2-56f2-b232-89b380c0ef24" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186113458} {:answer/id #uuid "49750543-eedf-58ef-bd7f-3e05fffa0faa" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186113459}] :answer-field/id #uuid "1f0fcab6-eb43-51c1-a1d7-c61c176af69e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113454} {:answer-field/choices [{:answer/id #uuid "6354d303-4208-5175-9716-605b5640c50e" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186367959} {:answ