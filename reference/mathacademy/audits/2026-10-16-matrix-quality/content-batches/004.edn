question/answer-fields [{:answer-field/choices [{:answer/id #uuid "170a6a8b-0a94-5182-b976-bd0b41e8fe28" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186342442} {:answer/id #uuid "b220f0b0-24d4-501f-958a-b59cb6183ced" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-3{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186343802} {:answer/id #uuid "ccca0f14-75d2-51d0-9c72-dc0eae6278da" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186344044} {:answer/id #uuid "dbf57b16-c151-502c-b06d-4bddc574b353" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186344167} {:answer/id #uuid "e60b0611-b8ae-57e8-9414-9ab2f893e68c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-3{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186344259}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-3{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186343802} :answer-field/id #uuid "6727db5e-bd9d-5baf-8e3c-10a6c913aa52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344668}] :question/id #uuid "0ac77401-4e26-5c21-810e-811c018a9f7f" :question/math-academy-id "q-74872" :question/problem "Consider the matrix $A=\\begin{bmatrix}-3 & 9 & -9 \\\\ 6 & -18 & 18 \\\\ 3 & -8 & 9\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-3 & 9 & -9 \\\\ 6 & -18 & 18 \\\\ 3 & -8 & 9\\end{bmatrix} & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 3 \\\\ 6 & -18 & 18 \\\\ 3 & -8 & 9\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-6){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 3 & -8 & 9\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -3 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+3{x}_{3} &=0 \\\\ {x}_{2} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2}$, and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}-3(0)+3{x}_{3}=0\\,⟹\\,{x}_{1}=-3{x}_{3}.\n$$\n\nSo the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)={\\begin{bmatrix}-3{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}.\n$$"} {:db/id #edb/ref 17592186391871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f0198d9-f83e-5d0e-a8f2-b00c3ca2d46b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}4{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186391873} {:answer/id #uuid "5f0421dd-4b76-5b27-941c-50a51355f127" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186391874} {:answer/id #uuid "98535724-16db-586b-94d6-47675062a82b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-11{x}_{2} \\\\ {x}_{2} \\\\ 4{x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391875} {:answer/id #uuid "fb7b7c44-935c-5b9c-95d9-ab7dff1476d7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-11{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186391876} {:answer/id #uuid "4d601e9e-c427-56eb-9ac5-b71bffd8d3e8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ 4{x}_{1} \\\\ -11{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186391877}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-11{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}" :db/id #edb/ref 17592186391876} :answer-field/id #uuid "6fde154e-f5aa-5ee6-91b0-0f999f1f1a17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391872}] :question/id #uuid "d54de9d5-0eaf-51ac-a971-a5633a39368a" :question/math-academy-id "q-34334" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & 6 & 9 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 6 & 9 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 4 & 9 & 8 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & -4 \\\\ 4 & 8 & 12\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 3 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+3{x}_{3} &=0 \\\\ {x}_{2}-4{x}_{3} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2}$, and we have one free variables, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$\n\nFrom the second equation we get ${x}_{2}=4{x}_{3}.$ Substituting ${x}_{2}=4{x}_{3}$ into the first equation, we get \n\n$$\n{x}_{1}+2(4{x}_{3})+3{x}_{3}=0\\,⟹\\,{x}_{1}=-11{x}_{3}.\n$$\n\nSo the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)={\\begin{bmatrix}-11{x}_{3} \\\\ 4{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{3}\\in R}.\n$$"} {:db/id #edb/ref 17592186417740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dea2883-7aed-50ab-88db-338d6b05d1d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}4{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430953} {:answer/id #uuid "6d08ac3a-bf71-57e5-86bb-45513f396dce" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}6{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430958} {:answer/id #uuid "78246ec8-609c-551f-b0ac-0dadda339bf8" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430960} {:answer/id #uuid "a3181278-1876-5206-9569-f7c580389091" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430963} {:answer/id #uuid "bcdbf8dd-4179-511e-ac05-173b55d1fa27" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ -{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430965}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430960} :answer-field/id #uuid "59767641-5ff1-522d-98ff-ca8331e026ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417735}] :question/id #uuid "87edb91a-a643-5fdb-a1df-2e5d059d6b9b" :question/math-academy-id "q-111154" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -3 & 6 \\\\ 4 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 4 & -8\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=0 \\\\ 0 &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=2{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}.\n$$"} {:db/id #edb/ref 17592186417742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267cb3d1-2ef0-50d2-827b-ba6571c4e7a7" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186417711} {:answer/id #uuid "4c4607fe-b4f6-500f-b628-c9efb2f77b90" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417718} {:answer/id #uuid "63a9c9e9-789b-5e69-a3e9-b68cbdaf3c6e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417720} {:answer/id #uuid "cbb639f6-eb5e-5bc1-a3ee-ebf239dfc56d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ {x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186417730} {:answer/id #uuid "e3dcbb04-64eb-5c82-a9e6-1019c7c418e3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186417732}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186417711} :answer-field/id #uuid "9debef96-eaa3-515c-b307-163bd264f5ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417736}] :question/id #uuid "f53050dc-6a1d-553b-afc7-7c5bd1dcb5bf" :question/math-academy-id "q-111165" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -3 \\\\ 1 & -2 \\\\ 2 & -4\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -3 \\\\ 1 & -2 \\\\ 2 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 2 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 0 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=0 \\\\ {x}_{2} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}-3(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)={0}.$"} {:db/id #edb/ref 17592186436466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbca735-134e-51b1-aa7d-1ae1dcf3526f" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436448} {:answer/id #uuid "207eceb9-2f6c-5231-8711-6fe00f2f5ba6" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436449} {:answer/id #uuid "278fe98f-e5e3-5f01-ba15-bc21fad992ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186436451} {:answer/id #uuid "9eeec1b5-b07a-5d06-b4a8-79874cf73995" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436457} {:answer/id #uuid "b6e10da3-1a9f-5d6d-ae50-a5481958989c" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186436458}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436449} :answer-field/id #uuid "efeb7b02-1be6-5efa-9bd8-eb3062a43a07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436464}] :question/id #uuid "312e3366-ac87-55a7-a43b-4cbe0aecef1d" :question/math-academy-id "q-111115" :question/problem "Consider the matrix $A=\\begin{bmatrix}4 & -12 \\\\ -2 & 6\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & -12 \\\\ -2 & 6\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ -2 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=3{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}.\n$$"} {:db/id #edb/ref 17592186436467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c3ebd9-a42e-5c1a-8426-98e7d5e3d271" :answer/type {:db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186436447} {:answer/id #uuid "33ab5a52-8fe6-5223-b21e-fdcf36d0f3ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436453} {:answer/id #uuid "73ca3d47-be47-5546-93ee-f037f5752428" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436454} {:answer/id #uuid "cdb8c109-a288-5915-8204-b0852f404fb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2}-{x}_{3} \\\\ {x}_{1}+{x}_{3} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436459} {:answer/id #uuid "f36c9e43-5eb7-51e7-9804-19a6c9a93b03" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{2}-{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436461}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436453} :answer-field/id #uuid "7879cf33-2aec-51b3-9623-83b7a16a99c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436463}] :question/id #uuid "b6c9ad88-847a-5bc3-8131-a821e5ea8f1f" :question/math-academy-id "q-34952" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -1 & 1 \\\\ 7 & -7 & 7\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -1 & 1 \\\\ 7 & -7 & 7\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-7){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have two free variables, ${x}_{2}$ and ${x}_{3}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}$ and ${x}_{3}.$\n\nFrom the first equation we get ${x}_{1}={x}_{2}-{x}_{3},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{\\begin{bmatrix}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R\\}.\n$$"}] :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :topic/math-academy-id 1854 :topic/title "The Null Space of a Matrix"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186125423} :activity/id #uuid "165fbf2b-e87c-54f7-8870-018acdd52972" :activity/steps [{:db/id #edb/ref 17592186125423 :step/content {:db/id #edb/ref 17592186125792 :tutorial/content "An $n\\times n$ matrix $A$ is said to be diagonalizable if there exists a diagonal matrix $D$ and an invertible matrix $P$ such that \n\n$$\nA=PDP^{-1}.\n$$\n\n \n\nFor example, the matrix ![](images/81/810ae901dcd83f59297a122fbf20beb91e29374baff41c19bcacf40b3a7e7091.svg) is diagonalizable because\n![](images/2c/2c41221da0e4c0895928e65602e588f380452172e29d79f6e9f68ebb49e57807.svg)\n\nIn general, we have the following theorem:\n\n*An $n\\times n$ matrix $A$ is diagonalizable if and only if there exists a basis of $\\mathbb{R}^n$ that consists of eigenvectors of $A$.*\n\nSince eigenvectors corresponding to different eigenvalues are linearly independent, we can also  conclude the following fact:\n\n*If an $n\\times n$ matrix $A$ has $n$ *distinct* eigenvalues (that is, $n$ simple roots of the corresponding characteristic equation), then there exists a basis of eigenvectors. Thus, the matrix is diagonalizable.*\n\nLet's show you how to use the diagonalization theorem with an example. \n\nSuppose that $\\lambda_1={\\color{blue}-2},$ $\\lambda_2={\\color{red}1},$ $\\lambda_3=-3$ are eigenvalues of a $3\\times 3$  matrix $A$, and that\n![](images/ec/ecc57b51a49c8d1d6fbadd69908dbf6f48803cd6ca1f72ad189a1e5410c5d71c.svg)\nare the respective eigenvectors. To find an invertible matrix $P$ and  a diagonal matrix $D$ such that $PDP^{-1} = A,$  we do the following: .\n\nFirst, we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n![](images/4f/4f878ce6a4b6f770cd520e22a8e4a3c6f8b3012b7de446bd3f533e61bda85a13.svg)\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to $\\lambda_1={\\color{blue}-2},$\n\n- the $2$nd column is the eigenvector corresponding to $\\lambda_2={\\color{red}1},$ and\n\n- the $3$rd column is the eigenvector corresponding to $\\lambda_3=-3.$\n\nTherefore, we get\n\n![](images/95/95c896911a6d54ea6385821846a3f0e4fc1a8f05f29e83b951ba270a3898938e.svg)\n\n**Note:** If the matrix $A$ does not have $n$ distinct eigenvalues, it is not always possible to diagonalize it. However, the algorithm to diagonalize any diagonalizable $n\\!\\times\\! n$ matrix is the same as the $3\\!\\times\\! 3$ case!" :tutorial/id #uuid "aef11f46-9f49-598e-9d5b-938d54814c1e" :tutorial/math-academy-id 3578 :tutorial/title "Introduction"} :step/id #uuid "2b97df2a-2c81-5e5c-aae7-42dd0059d96e" :step/next {:db/id #edb/ref 17592186125424}} {:db/id #edb/ref 17592186125424 :step/content {:db/id #edb/ref 17592186124532 :knowledge-point/id #uuid "c0db5cbe-3288-5c04-a7f4-55ff5dd93ad5"} :step/id #uuid "c9398a9c-468d-5eda-8f0e-08b6ae582dd6" :step/next {:db/id #edb/ref 17592186125425}} {:db/id #edb/ref 17592186125425 :step/content {:db/id #edb/ref 17592186124533 :knowledge-point/id #uuid "05cb6509-dc1c-53b7-a495-4cfec2abdfe0"} :step/id #uuid "72500366-9058-55a3-8409-3413cf056fad" :step/next {:db/id #edb/ref 17592186125426}} {:db/id #edb/ref 17592186125426 :step/content {:db/id #edb/ref 17592186124534 :knowledge-point/id #uuid "e0a6d3b3-be78-540d-bb10-47c7fff64001"} :step/id #uuid "60b0ed38-7920-5718-bf00-7dd0beab7c34" :step/next {:db/id #edb/ref 17592186125499}} {:db/id #edb/ref 17592186125499 :step/content {:db/id #edb/ref 17592186124578 :knowledge-point/id #uuid "2d22e4bf-1d84-587b-8106-e27319ecbc95"} :step/id #uuid "f3ae6ecb-ff9c-5f85-9746-535278eb647f"}] :activity/title "Diagonalizing a 3x3 Matrix With Distinct Eigenvalues" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186124755} {:activity/first-step {:db/id #edb/ref 17592186481443} :activity/id #uuid "d7d226d5-3cd0-5230-8042-7df3d54ca7fe" :activity/steps [{:db/id #edb/ref 17592186481443 :step/content {:db/id #edb/ref 17592186323890 :question/id #uuid "d618b848-c7f8-598a-9ced-1322da396f72"} :step/id #uuid "0fecd705-060a-546c-8151-ee407ac03416" :step/next {:db/id #edb/ref 17592186481446}} {:db/id #edb/ref 17592186481446 :step/content {:db/id #edb/ref 17592186125102 :question/id #uuid "49ced030-28af-526f-807c-a151930584ea"} :step/id #uuid "1b8367ed-930a-55dd-ab5d-7c8f0aba21b9" :step/next {:db/id #edb/ref 17592186481448}} {:db/id #edb/ref 17592186481448 :step/content {:db/id #edb/ref 17592186323949 :questi