n{bmatrix}7 \\\\ 14\\end{bmatrix}\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, only ${b}_{2}$ lies in $\\text{Null}(A).$"} {:db/id #edb/ref 17592186402389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "492978d5-2bec-55d1-bdda-860ad257a369" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{2}$ only" :db/id #edb/ref 17592186402391} {:answer/id #uuid "f6789158-3583-5bab-89c7-6784cdb9397a" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$,  ${b}_{2}$, and ${b}_{3}$" :db/id #edb/ref 17592186402392} {:answer/id #uuid "b68888a5-1eb0-5529-977b-9f744647ef8f" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186402393} {:answer/id #uuid "7354f182-00ec-50bf-9755-be6a57c5b1ec" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402394} {:answer/id #uuid "36c2d878-22ee-54ba-8dc0-b9b9e3b0d0aa" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{2}$ and ${b}_{3}$ only" :db/id #edb/ref 17592186402395}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186402393} :answer-field/id #uuid "9d0b1afa-4467-52dd-b537-3af075fc6fea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402390}] :question/id #uuid "65ef5949-cf70-59d8-adcb-422768352bc5" :question/math-academy-id "q-34984" :question/problem "The matrix $A$ and vectors ${b}_{1}$, ${b}_{2}$, ${b}_{3}$ are given below. Which of the vectors lie in $\\text{Null}(A)?$\n\n$$\nA=\\begin{bmatrix}0 & 2 & 4\\end{bmatrix},\\,{b}_{1}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "A vector $b$ lies in $\\text{Null}(A)$ if $Ab=0.$ So, we need to compute the product of $A$ and each of the given vectors and check whether it is equal to $0:$\n\n$$\n\\begin{aligned}A{b}_{1} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}=0\\,✓ \\\\ A{b}_{2} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}=-4\\ne 0\\,\\times  \\\\ A{b}_{3} & =\\begin{bmatrix}0 & 2 & 4\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}=4\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, only ${b}_{1}$ lies in $\\text{Null}(A).$"} {:db/id #edb/ref 17592186417739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b313932-8a2d-5efe-9590-f6798ae0a9bc" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186417709} {:answer/id #uuid "1839cd87-9807-5099-aa1b-8c59eca72147" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$ and ${b}_{3}$ only" :db/id #edb/ref 17592186417710} {:answer/id #uuid "4200484a-68ef-5a68-826c-3f22c3f6744b" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$ only" :db/id #edb/ref 17592186417715} {:answer/id #uuid "43348635-a4e0-572f-b730-392f51070b83" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{1}$,  ${b}_{2}$, and ${b}_{3}$" :db/id #edb/ref 17592186417716} {:answer/id #uuid "aac34498-7b04-5d6d-ae12-08f353104028" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{3}$ only" :db/id #edb/ref 17592186417727}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186417709} :answer-field/id #uuid "e63daa46-8b3f-5be5-a899-eeb5be3faafc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417737}] :question/id #uuid "840cf185-0fde-50bc-83f8-78075677882d" :question/math-academy-id "q-74858" :question/problem "The matrix $A$ and vectors ${b}_{1}$, ${b}_{2}$, ${b}_{3}$ are given below. Which of the vectors lie in $\\text{Null}(A)?$\n\n$$\nA=\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix},\\,{b}_{1}=\\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}2 \\\\ 4 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "A vector $b$ lies in $\\text{Null}(A)$ if $Ab=0.$ So, we need to compute the product of $A$ and each of the given vectors and check whether it is equal to $0:$\n\n$$\n\\begin{aligned}A{b}_{1} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ -3 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 5 \\\\ 0\\end{bmatrix}\\ne 0\\,\\times  \\\\ A{b}_{2} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix}\\ne 0\\,\\times  \\\\ A{b}_{3} & =\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -1 & 0 \\\\ -1 & 3 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 4 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}9 \\\\ 0 \\\\ 8\\end{bmatrix}\\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, none of the vectors lies in $\\text{Null}(A).$"}] :knowledge-point/title "Identifying Whether a Vector Lies in the Null Space of a Given Matrix"} {:db/id #edb/ref 17592186119813 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119624 :question/id #uuid "e38db5fa-1753-5176-bb5e-a077ea63ddec" :question/math-academy-id "e-4812" :question/problem "Consider the matrix ![](images/c8/c85268d7db6efb171da25432988c0ee99252f4cdb10f8a1cc24f31af5b2e239d.svg) and the vector ![](images/c7/c7095b22e7a8cbbeefc6b75b63886550a4c7c35f23585e2c0006ddf14b424c28.svg) Find the value of $k$ such that $\\mathbf{b}\\in\\textrm{Null}(A).$" :question/worked-solution "If $\\mathbf{b} \\in \\textrm{Null}(A),$ then we must have $A\\mathbf{b} = \\mathbf{0}.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}3 & 2 & -4 \\\\ -3 & 3 & -1 \\\\ 6 & -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ k \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}6+2k-12 \\\\ -6+3k-3 \\\\ 12-6k+6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}2k-6 &=0 \\\\ 3k-9 &=0 \\\\ -6k+18 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=3.$"} :knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/questions [{:db/id #edb/ref 17592186120333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a71d4e5-db95-5190-a6f4-1f7d949b8805" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315271} {:answer/id #uuid "9104a292-68d5-51c7-9879-7d1f6acdde4c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315927} {:answer/id #uuid "a42cfc13-4d68-5fe3-a10d-eac000efa2bf" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186316045} {:answer/id #uuid "e860462e-7469-572f-9e4e-58e41e9b635a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186316407} {:answer/id #uuid "f15c106c-e4cd-56e0-aba7-f4f99788cf2b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186316462}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186316407} :answer-field/id #uuid "20ac2b13-c799-563d-95c3-c286d2b9c40c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316624}] :question/id #uuid "a6c6f7d8-9823-545e-9337-58f3a1ee9d18" :question/math-academy-id "q-34386" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & -1 \\\\ -12 & 4 \\\\ 9 & -3\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}k \\\\ -6\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}3 & -1 \\\\ -12 & 4 \\\\ 9 & -3\\end{bmatrix}\\begin{bmatrix}k \\\\ -6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}3k+6 \\\\ -12k-24 \\\\ 9k+18\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}3k+6 &=0 \\\\ -12k-24 &=0 \\\\ 9k+18 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=-2.$"} {:db/id #edb/ref 17592186120368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a39d581c-3b62-5c09-a732-56adb33a38d7" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186118323} {:answer/id #uuid "aa532d54-2c1f-51c9-9517-830bddc998b1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186118324} {:answer/id #uuid "06bf2739-60b7-51ae-9729-f70be3d53515" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186118325} {:answer/id #uuid "34f3a46f-4953-5c1d-ba88-02625e10d02f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118326} {:answer/id #uuid "78df5c8e-55da-5783-918c-a76a576b4acb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186118327}] :answer-field/id #uuid "59b85dee-84eb-5f97-bd5f-0408e1a48598" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118322} {:answer-field/choices [{:answer/id #uuid "eb1cf5c1-9f30-52ce-a89c-7f1fce6e3095" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186391898} {:answer/id #uuid "8d2f68fa-3b71-5d07-b733-af46cee12558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186391899} {:answer/id #uuid "719f24a8-1729-514f-af15-f14817d50ed5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186391