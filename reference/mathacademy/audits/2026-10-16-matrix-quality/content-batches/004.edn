matrix}0\\cdot x+1\\cdot y \\\\ 1\\cdot x+0\\cdot y\\end{bmatrix}.\n$$\n\nNotice that\n    \n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}y \\\\ x\\end{bmatrix}.\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186253579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17680857-523a-56e1-8420-c08210489de4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186250760} {:answer/id #uuid "1b2349f9-546b-554c-b41a-858b240c556b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186250785} {:answer/id #uuid "63dd99ab-fead-531a-9761-7733e0bb2f2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186251368} {:answer/id #uuid "87876316-f8ab-5e4e-adf4-44606bad247e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186251693} {:answer/id #uuid "dd4a9ee1-81a3-52f3-91aa-ac10ad95cfc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186252503}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186251368} :answer-field/id #uuid "7c78b755-d795-5ba9-92eb-1cb1d5ff8158" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253020}] :question/id #uuid "0145758b-88e9-57c3-9578-3a41888f61e8" :question/math-academy-id "q-11945" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T$, where\n\n$$\nT:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}2x+3y \\\\ y\\end{bmatrix}.\n$$" :question/worked-solution "We require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2\\cdot x+3\\cdot y \\\\ 0\\cdot x+1\\cdot y\\end{bmatrix}.\n$$\n\nNotice that\n    \n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2x+3y \\\\ y\\end{bmatrix}.\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n\\begin{bmatrix}2 & 3 \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186284600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e31661-7513-564f-a135-396131d08c69" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 1 & -2\\end{bmatrix}." :db/id #edb/ref 17592186281860} {:answer/id #uuid "1ff3688f-c6c8-57e3-871f-f68a2fbbb114" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}." :db/id #edb/ref 17592186281976} {:answer/id #uuid "3bac9e39-c3d5-5861-90d6-851b591efbce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -1 & 1\\end{bmatrix}." :db/id #edb/ref 17592186282211} {:answer/id #uuid "bbdfbd11-da0b-5978-8108-f2e1c3285018" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}." :db/id #edb/ref 17592186283315} {:answer/id #uuid "f7347802-33db-50dd-9658-03eaaaff6502" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 1 & -1\\end{bmatrix}." :db/id #edb/ref 17592186283851}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 1 & -1\\end{bmatrix}." :db/id #edb/ref 17592186283851} :answer-field/id #uuid "5f89389a-7880-5dfe-bd2a-2f790287db6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284090}] :question/id #uuid "a17b82a8-468f-57fd-b668-608379ae246b" :question/math-academy-id "q-168102" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T$, where\n\n$$\nT:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}2x \\\\ x-y\\end{bmatrix}.\n$$" :question/worked-solution "We require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2\\cdot x+0\\cdot y \\\\ 1\\cdot x+(-1)\\cdot y\\end{bmatrix}.\n$$\n\nNotice that\n    \n\n$$\n\\begin{bmatrix}2 & 0 \\\\ 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2x \\\\ x-y\\end{bmatrix}.\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n\\begin{bmatrix}2 & 0 \\\\ 1 & -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ba1a75-e973-5a24-b574-9f3260d6223d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297644}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297644} :answer-field/id #uuid "0fdc02c9-ee41-52a4-999a-7c49d260aa68" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298693} {:answer-field/choices [{:answer/id #uuid "928be1fd-95ef-59ea-b107-4ab42c163229" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298186}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298186} :answer-field/id #uuid "3412b12c-d756-537f-918c-d511a58d6674" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298816} {:answer-field/choices [{:answer/id #uuid "aa43655f-ab3e-597b-84d5-6166c39cbbc3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298294}