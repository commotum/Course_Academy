wer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186417719} {:answer/id #uuid "754f9b55-2a4f-56a1-a443-6730aeb9dbd2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186417721} {:answer/id #uuid "a602ff6b-6d7d-5c41-a3a4-a43d6175780c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186417725} {:answer/id #uuid "d5fab15a-6aaa-5d52-a720-35f24b947f9a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186417731}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186417721} :answer-field/id #uuid "2b31ab65-a8d2-52bf-9fe7-84343a8c24b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417734}] :question/id #uuid "89126de9-6477-52ae-9bf6-a1ac2a8f4680" :question/math-academy-id "q-111103" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ 4 & -12\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}k \\\\ 1\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}2 & -6 \\\\ -1 & 3 \\\\ 4 & -12\\end{bmatrix}\\begin{bmatrix}k \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}2k-6 \\\\ -k+3 \\\\ 4k-12\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}2k-6 &=0 \\\\ -k+3 &=0 \\\\ 4k-12 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=3.$"} {:db/id #edb/ref 17592186430969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a35883-74f9-50df-a12a-cf22366812d0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186430954} {:answer/id #uuid "5b2f74fd-3217-5473-9e5d-cc531fb68341" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430955} {:answer/id #uuid "5c378093-8041-5762-8640-d5a40681b948" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186430956} {:answer/id #uuid "92e9ac83-d31a-5747-bd54-27c5176de395" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186430961} {:answer/id #uuid "cceb993a-7fdf-519c-8422-5d552bf54f8f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186430967}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430955} :answer-field/id #uuid "7b1195de-a391-5f4a-ba01-152a7cff1406" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430968}] :question/id #uuid "d6084cfc-eb77-5ae0-9ec3-a6e87e13ee7f" :question/math-academy-id "q-34980" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & -7\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}0 \\\\ k\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}2 & -7\\end{bmatrix}\\begin{bmatrix}0 \\\\ k\\end{bmatrix} & =0 \\\\ -7k & =0.\\end{aligned}\n$$\n\nand for this equation, we obtain $k=0.$"} {:db/id #edb/ref 17592186436465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26159372-b71c-53aa-b5de-cd66262e13d2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186436450} {:answer/id #uuid "30b01182-4cb9-5d97-bf75-ba208916b906" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436452} {:answer/id #uuid "7bcf1b8a-8c6e-5d2f-89fa-e89e9f45ad26" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436455} {:answer/id #uuid "8053bf30-d2ef-56f4-8354-9c959a10f447" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436456} {:answer/id #uuid "e19d83c2-3ef3-5b10-a767-87a0e48125c6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436460}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436460} :answer-field/id #uuid "2ce54b5e-3110-587b-a5da-74e4583bb5ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436462}] :question/id #uuid "0f9d6921-1029-58c3-84e2-79c33a9e57b1" :question/math-academy-id "q-111104" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & -2 & -1 \\\\ -2 & 4 & 2\\end{bmatrix}$ and the vector $b=\\begin{bmatrix}3 \\\\ k \\\\ 1\\end{bmatrix}.$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}1 & -2 & -1 \\\\ -2 & 4 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ k \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}-2k+2 \\\\ 4k-4\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\left\\{\\begin{aligned}-2k+2 &=0 \\\\ 4k-4 &=0\\end{aligned}\\right.\n$$\n\nand for each of these equations, we obtain $k=1.$"}] :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"} {:db/id #edb/ref 17592186119814 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119625 :question/id #uuid "1e59cd29-ea54-5b90-8215-60c81d1b6dbb" :question/math-academy-id "e-4814" :question/problem "Consider the matrix ![](images/17/17cd2f2b0846461e1ed6480f82ce576fc82e5066258d80ed6f7084b0d55ca4a9.svg) Find $\\textrm{Null}(A).$" :question/worked-solution "We need to solve the equation $A\\mathbf{x}=\\mathbf{0}.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & -12 \\\\ 3 & -8\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 3 & -8\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=0 \\\\ {x}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe second equation tells us that $x_2=0.$ Substituting this into the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}-3{x}_{2} & =0 \\\\ {x}_{1}-3(0) & =0 \\\\ {x}_{1} & =0.\\end{aligned}\n$$\n\nSo, we conclude that ![](images/db/db533ede6312d49204e619379dfff639c0871f37ee997ce152ec35bd64105926.svg) is the only solution to this system.\n\nTherefore, $\\textrm{Null}(A) = \\left\\{ \\mathbf{0} \\right\\}.$"} :knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/questions [{:db/id #edb/ref 17592186120324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a54c0add-73d3-59e6-a39b-e7a418e46c8c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}2x_{2} \\\\ x_{2}\\end{bmatrix}: x_{2} ∈ R}" :db/id #edb/ref 17592186118084} {:answer/id #uuid "b48c2cfd-7c3f-5010-8056-b39ed91a19a3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}x_{2} \\\\ -3x_{2}\\end{bmatrix}: x_{2} ∈ R}" :db/id #edb/ref 17592186118085} {:answer/id #uuid "b6a55a82-bfd9-5b46-9246-8dad3eac99c5" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186118086} {:answer/id #uuid "fc4b3f11-a561-57ec-addc-83ecdc021aa1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2x_{2} \\\\ x_{2}\\end{bmatrix}: x_{2} ∈ R}" :db/id #edb/ref 17592186118087} {:answer/id #uuid "5d9defd2-5053-560e-9cb1-5d3d60c073a2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}x_{2} \\\\ 2x_{2}\\end{bmatrix}: x_{2} ∈ R}" :db/id #edb/ref 17592186118088}] :answer-field/id #uuid "6e11750b-6ea3-587d-9b5b-5e604b2b3b7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118083} {:answer-field/choices [{:answer/id #uuid "49a83d03-bcec-5b15-ad52-b1e7c32edc9e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391866} {:answer/id #uuid "880e8c11-d342-5705-af1b-e6abf47c5224" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186391867} {:answer/id #uuid "0fbbdb7c-314c-5954-a1ec-3f2ec80b9ff4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{2} \\\\ -3{x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391868} {:answer/id #uuid "0eee38af-d79e-5905-9c03-fc841d170da3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391869} {:answer/id #uuid "919f5be6-a5f1-5fa3-a69f-295d49529851" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391870}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186391870} :answer-field/id #uuid "46545e04-c37a-551e-b919-1faa52207c4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391865}] :question/id #uuid "dcd84fb5-e504-5016-bbba-4d8edb437f6b" :question/math-academy-id "q-34333" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & 6 \\\\ 6 & 12\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 6 \\\\ 6 & 12\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 6 & 12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-6){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=-2{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)={\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}.\n$$"} {:db/id #edb/ref 17592186120369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d396bf2-d60a-5101-8bb1-a17c152536e9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{2}-5{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186317704} {:answer/id #uuid "2ee65b09-c8b7-50b3-bc5f-eb5085cb8c97" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ 4 \\\\ 0\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186317707} {:answer/id #uuid "4dae7a85-6819-5b7e-abec-33707086188f" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186317821} {:answer/id #uuid "607f1d85-3c03-5d67-9128-ad35b26514a5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ 1 \\\\ 1\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186317892} {:answer/id #uuid "ffc3b059-1978-5d9f-b8cb-bece5926c1d6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186318419}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186318419} :answer-field/id #uuid "f600de0e-cf8c-5396-9c4b-6ed5c550f57c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318934}] :question/id #uuid "c2b12c60-dc2b-5369-b49c-eb15948f4eb2" :question/math-academy-id "q-34951" :question/problem "Consider the matrix $A=\\begin{bmatrix}-1 & 3 & -2 \\\\ 5 & -15 & 10 \\\\ 2 & -6 & 4\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 3 & -2 \\\\ 5 & -15 & 10 \\\\ 2 & -6 & 4\\end{bmatrix} & {R}_{1} & :=(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 5 & -15 & 10 \\\\ 2 & -6 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 0 \\\\ 2 & -6 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} &=0 \\\\ 0 &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have two free variables, ${x}_{2}$ and ${x}_{3}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}$  and ${x}_{3}.$\n\nFrom the first equation we get ${x}_{1}=3{x}_{2}-2{x}_{3},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)={\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}.\n$$"} {:db/id #edb/ref 17592186247217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1195e87d-7fff-5c95-afca-61b5c71bbbd5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-3{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186244475} {:answer/id #uuid "26027e6d-8553-54aa-ab31-c8e32b25fed7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ 2{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186244652} {:answer/id #uuid "4ff7df42-bf19-5cdd-b9a6-b35582c49f87" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}{x}_{1} \\\\ 5{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R}" :db/id #edb/ref 17592186245025} {:answer/id #uuid "f5f0f059-3b8c-57ce-bea2-31d42f3046b9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}5{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R}" :db/id #edb/ref 17592186246484} {:answer/id #uuid "fda30eea-30c0-5f04-8aae-bfd3ab070ac4" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186246531}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186246531} :answer-field/id #uuid "19cbf8a6-4c99-57c7-bc8f-50168be36cb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246592}] :question/id #uuid "6d07bd1b-dc0b-5c96-a400-d7f17ccf0d9a" :question/math-academy-id "q-111220" :question/problem "Consider the matrix $A=\\begin{bmatrix}5 & 15 \\\\ 2 & 3\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}5 & 15 \\\\ 2 & 3\\end{bmatrix} & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 2 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=0 \\\\ -3{x}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}+3(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)={0}.$"} {:db/id #edb/ref 17592186317454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6572e448-2a1b-54fa-b7eb-b164a363dfcd" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ -2{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430957} {:answer/id #uuid "77ade1d1-f580-5223-b0a2-1bf51cbff285" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{2} \\\\ 2{x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430959} {:answer/id #uuid "9e92c0f2-12f6-52e4-bc39-5f630e281daf" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix}\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430962} {:answer/id #uuid "b0b063f1-874e-516d-844c-6910584fd9fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}{x}_{1} \\\\ -3{x}_{1}\\end{bmatrix}\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430964} {:answer/id #uuid "bd56a073-7763-5f3e-8627-e620cdb34e7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186430966}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186430966} :answer-field/id #uuid "7741c95a-c056-57b4-9397-7a01a1ba8764" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316831}] :question/id #uuid "870e5cfd-95f3-5e52-b251-41fd48145e5a" :question/math-academy-id "q-34392" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & 4 \\\\ 2 & 5\\end{bmatrix}.$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 4 \\\\ 2 & 5\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 2 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=0 \\\\ {x}_{2} &=0\\end{aligned}\\right.\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)=\\{0\\}.$"} {:db/id #edb/ref 17592186344988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "139ee80c-6e6e-531b-a6b8-99112c3e1abb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}5{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186342410} {:answer/id #uuid "3b64258e-e02b-59a9-874c-a387dbf35e5e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}2{x}_{2}-5{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186342725} {:answer/id #uuid "8638435e-1b5c-5f83-bf5a-e7216da4208f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}5{x}_{2}+2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\\,:\\,{x}_{2},{x}_{3}\\in R}" :db/id #edb/ref 17592186343390} {:answer/id #uuid "9feaf2b5-7a06-5f65-9627-c410de97218e" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186343649} {:answer/id #uuid "b43c1faf-0fd9-599c-8b4