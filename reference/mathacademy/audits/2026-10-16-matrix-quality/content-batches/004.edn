activity/title "Diagonalizing a 3x3 Matrix With Distinct Eigenvalues" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186486593} {:activity/first-step {:db/id #edb/ref 17592186547130} :activity/id #uuid "16e399ed-aaf5-574b-b8ef-a202b3c5e60d" :activity/steps [{:db/id #edb/ref 17592186547090 :step/content {:db/id #edb/ref 17592186547037 :question/id #uuid "9b44391f-e44c-563d-bb93-f77bd480441b"} :step/id #uuid "0b0969b3-262a-5153-9174-f2474cba9c54" :step/next {:db/id #edb/ref 17592186547173}} {:db/id #edb/ref 17592186547092 :step/content {:db/id #edb/ref 17592186404287 :question/id #uuid "497d051f-d1fb-59f1-b865-99c679ab4f76"} :step/id #uuid "0df1cf10-1e1a-5231-a243-6e1cba0328b6" :step/next {:db/id #edb/ref 17592186547168}} {:db/id #edb/ref 17592186547130 :step/content {:db/id #edb/ref 17592186323890 :question/id #uuid "d618b848-c7f8-598a-9ced-1322da396f72"} :step/id #uuid "9a3e245d-e9df-50c8-a0ba-a6fdd95a970a" :step/next {:db/id #edb/ref 17592186547092}} {:db/id #edb/ref 17592186547168 :step/content {:db/id #edb/ref 17592186354311 :question/id #uuid "cffbdb26-6f7f-5724-84b4-58cbeec7ece4"} :step/id #uuid "ea51166f-4840-546b-931f-abe3f065d282" :step/next {:db/id #edb/ref 17592186547090}} {:db/id #edb/ref 17592186547173 :step/content {:db/id #edb/ref 17592186547083 :question/id #uuid "fe4db266-521b-5e74-9fc0-1f891e601787"} :step/id #uuid "f12218ef-2fca-593c-b948-51ba2b4eab27"}] :activity/title "Diagonalizing a 3x3 Matrix With Distinct Eigenvalues" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186546235}] :db/id #edb/ref 17592186048195 :topic/knowledge-points [{:db/id #edb/ref 17592186124532 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124341 :question/id #uuid "a285ae3e-4f06-5e09-a06f-b2620be99888" :question/math-academy-id "e-5504" :question/problem "Consider the matrix $A$ for which $\\lambda_1=-1,$ $\\lambda_2=1,$ $\\lambda_3=0$ are eigenvalues, and\n![](images/10/10c3a1128f78cd19b14ca29bda23bcd3c14a49a6bbf2608aa568f6f7c22aea9b.svg)\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n![](images/83/837556eba2375812c7d20c59533fc51f91716c6306254d2fc193b98315dd5663.svg)" :question/worked-solution "Since the eigenvalues of the matrix are $\\lambda_1={\\color{blue}-1},$ $\\lambda_2={\\color{red}1},$ $\\lambda_3=0,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n![](images/20/20ee95979c2ae9a6f3eca54e65923f608ef569141c6ff1393ef53e99636dda1a.svg)\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to $\\lambda_1={\\color{blue}-1},$\n\n- the $2$nd column is the eigenvector corresponding to $\\lambda_2={\\color{red}1},$ and\n\n- the $3$rd column is the eigenvector corresponding to $\\lambda_3=0.$\n\nTherefore, we get\n\n![](images/13/13f61ba37464f828258713594c973c4ab7c5c1d6aa50c2b482dcc2b444013686.svg)\n\nFinally, we obtain\n\n![](images/69/69506c47b7fce7fd91eee135299db2920598325d4eb28611d758aeb5e3815489.svg)\n\nIn conclusion, we get $a=0,$ $b=-1,$ and $c=-1.$"} :knowledge-point/id #uuid "c0db5cbe-3288-5c04-a7f4-55ff5dd93ad5" :knowledge-point/questions [{:db/id #edb/ref 17592186125044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a878895-0261-52a2-8d5d-21731254fa7f" :answer/type {:db/ident :answer.type/text} :answer/value "$a =-1$, $b = 1$, and $c = 3$" :db/id #edb/ref 17592186122865} {:answer/id #uuid "af4af818-ca30-5e27-ab97-469351689194" :answer/type {:db/ident :answer.type/text} :answer/value "$a =-1$, $b = 0$, and $c =-3$" :db/id #edb/ref 17592186122866} {:answer/id #uuid "c6bde566-20e6-5bc6-840a-e17d83767ae2" :answer/type {:db/ident :answer.type/text} :answer/value "$a = 1$, $b = 0$, and $c = 3$" :db/id #edb/ref 17592186122867} {:answer/id #uuid "ebe6ee5c-983f-5e6f-a903-e7e740fec90b" :answer/type {:db/ident :answer.type/text} :answer/value "$a = 1$, $b = 1$, and $c =-3$" :db/id #edb/ref 17592186122868} {:answer/id #uuid "0b410d84-7daf-5655-8415-da842950d9ab" :answer/type {:db/ident :answer.type/text} :answer/value "$a = 1$, $b =-1$, and $c = 3$" :db/id #edb/ref 17592186122869}] :answer-field/id #uuid "dd878418-7a32-5a80-a516-ae71bf887067" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122864}] :question/id #uuid "4ebb1166-c9cf-5d73-8646-baa7e1e1c3e4" :question/math-academy-id "q-37251" :question/problem "Consider the matrix $A$ for which $λ_{1} = 3$, $λ_{2} =-3$, $λ_{3} =-6$ are eigenvalues, and\n$v_{1} = \\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}, v_{2} = \\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}, v_{3} = \\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}$\nare the respective eigenvectors. What are the values of $a, b, c$ given that\n$A = \\begin{bmatrix}-1 & a & 1 \\\\ 1 & 1 & 0 \\\\ 1 & b & 1\\end{bmatrix}\\begin{bmatrix}c & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & -6\\end{bmatrix}\\begin{bmatrix}-1 & a & 1 \\\\ 1 & 1 & 0 \\\\ 1 & b & 1\\end{bmatrix}^{-1}$?"} {:db/id #edb/ref 17592186125101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d28198c-10ed-558f-8e71-d5f2fb79b590" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 1 & -2 \\\\ 0 & 0 & 1 \\\\ -1 & 3 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186432155} {:answer/id #uuid "2103dd17-24f4-5247-b56e-72b117146a35" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186432156} {:answer/id #uuid "2efa584d-3db2-57e9-a646-6fda0b51e92f" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186432157} {:answer/id #uuid "6054a99d-5ddb-5221-9dce-cc7c44c1f9ca" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186432160} {:answer/id #uuid "b4acffba-1ec8-59df-8d94-4699791de74a" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 1 & -2 \\\\ 0 & 0 & 1 \\\\ -1 & 3 & 0\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186432163}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186432156} :answer-field/id #uuid "883bc44f-5335-5507-b72b-47a96f7fe8f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123206}] :question/id #uuid "17cb4954-c3d0-565d-94a6-8a00df11ece9" :question/math-academy-id "q-37806" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=-3,$ ${\\lambda }_{2}=1,$ ${\\lambda }_{3}=-1$ are eigenvalues, and \n\n$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}\n$$\n\nare the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-3,$ ${\\lambda }_{2}=1,$ ${\\lambda }_{3}=-1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-3,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=1,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=-1.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}2 & -2 & 1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186272033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1071a0dc-8b19-5bef-a4de-68bd17a2d063" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}5 & 3 & -1 \\\\ 3 & -1 & 3 \\\\ 0 & 2 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186269416} {:answer/id #uuid "216ebfc0-85bd-5c61-b0a1-b89108ff92b1" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}5 & 3 & -1 \\\\ 3 & 1 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186269553} {:answer/id #uuid "2f345769-34f5-5cd3-91fc-d8d55cd8b2ff" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-3 & 3 & -1 \\\\ 3 & 1 & 3 \\\\ 0 & 2 & 4\\end{bmatrix}$" :db/id #edb/ref 17592186269690} {:answer/id #uuid "57a92029-5481-5962-8b5d-911e1292a0dd" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}5 & 3 & -1 \\\\ 3 & -1 & 2 \\\\ 0 & 2 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186270044} {:answer/id #uuid "fae144b8-7fd6-5baa-96f7-827baf082445" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 3 & 0 \\\\ 3 & -1 & 3 \\\\ 0 & 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186271461}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}5 & 3 & -1 \\\\ 3 & -1 & 3 \\\\ 0 & 2 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186269416} :answer-field/id #uuid "0e5c1d59-e4c5-54b5-a13a-49e537917303" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271531}] :question/id #uuid "bef89b96-901a-544e-a966-8fabb149e3c6" :question/math-academy-id "q-140135" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=-3,$ ${\\lambda }_{2}=4,$ ${\\lambda }_{3}=5$ are eigenvalues, and \n\n$$\n{v}_{1}=\\begin{bmatrix}5 \\\\ 3 \\\\ 0\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}3 \\\\ -1 \\\\ 2\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}\n$$\n\nare the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-3,$ ${\\lambda }_{2}=4,$ ${\\lambda }_{3}=5,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-3,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=4,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=5.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}5 & 3 & -1 \\\\ 3 & -1 & 3 \\\\ 0 & 2 & -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186351532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "292d3e4a-49ca-586e-9d3b-f5f6d0366ec4" :answer/type {:db/ident :answer.type/text} :answer/value "$a=2,$ $b=-2,$ and $c=1$" :db/id #edb/ref 17592186348804} {:answer/id #uuid "8a67ee78-fafc-582b-b484-d26f473783ac" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=1,$ and $c=2$" :db/id #edb/ref 17592186349702} {:answer/id #uuid "8c2e19b7-85ba-50c9-a102-4a03c9ac4cd3" :answer/type {:db/ident :answer.type/text} :answer/value "$a=2,$ $b=1,$ and $c=-2$" :db/id #edb/ref 17592186349715} {:answer/id #uuid "a8c9f6e4-6090-598c-b2ae-2166f896860d" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=1,$ and $c=2$" :db/id #edb/ref 17592186349950} {:answer/id #uuid "ecfcd014-7506-5cef-ab2b-20d0a95bcb26" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=2,$ and $c=-2$" :db/id #edb/ref 17592186350517}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$a=2,$ $b=1,$ and $c=-2$" :db/id #edb/ref 17592186349715} :answer-field/id #uuid "b25efae5-9ca3-54c2-bb72-d6200b3565a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351014}] :question/id #uuid "acf36c4a-75fa-50c1-b40a-bf6551d64bed" :question/math-academy-id "q-83697" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=-2,$ ${\\lambda }_{3}=2$ are eigenvalues, and\n\n$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=\\begin{bmatrix}a & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & b & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & c & 0 \\\\ 0 & 0 & 2\\end{bmatrix}{\\begin{bmatrix}a & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & b & -1\\end{bmatrix}}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=-2,$ ${\\lambda }_{3}=2,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=1,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-2,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=-2.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}.\n$$\n\nFinally, we obtain\n\n$$\nA=\\begin{bmatrix}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}{\\begin{bmatrix}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}}^{-1}.\n$$\n\nIn conclusion, we get $a=2,$ $b=1,$ and $c=-2.$"} {:db/id #edb/ref 17592186351533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d59528b-cdd3-5b86-8192-072c8f8d7878" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & 2 & -1 \\\\ 1 & 2 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186348563} {:answer/id #uuid "62e390e1-3e96-5e93-a534-8cd460604753" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & 1 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186349352} {:answer/id #uuid "d001947d-99b0-5aaf-8f74-6e8d15704c9a" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & 2 & 1 \\\\ 0 & 2 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186350278} {:answer/id #uuid "da87e45a-8c4a-5a42-8899-d6dbd59835c7" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & -3 & 0 \\\\ 2 & 0 & 0\\end{bmatrix}$ and $P=\\begin{bmatrix