swer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186241835} {:answer/id #uuid "59137118-e001-511f-b69f-3ecb70934b5b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186241982} {:answer/id #uuid "6c307841-6755-575d-94aa-7c93bb6cfdd1" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186242151} {:answer/id #uuid "b7adfc2c-ef57-5a51-8511-adbcc4b8b582" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186242788}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186242788} :answer-field/id #uuid "34ce1f74-60fb-554b-a85d-9ebeb0adcded" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243537}] :question/id #uuid "548f0040-ec44-5816-9b73-e986b0aab71c" :question/math-academy-id "q-109267" :question/problem "Find $\\,|\\begin{aligned}v & w & 0 & 0 \\\\ 5 & 4 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 5 & 5\\end{aligned}|$ given that $\\,|\\begin{aligned}v & w \\\\ 5 & 4\\end{aligned}|=3.$" :question/worked-solution "Notice that we have a block diagonal matrix. Therefore, its determinant is equal to the product of the diagonal blocks' determinants:\n\n$$\n\\begin{aligned}|\\begin{aligned}v & w & 0 & 0 \\\\ 5 & 4 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 5 & 5\\end{aligned}| & =|\\begin{aligned}v & w & 0 & 0 \\\\ 5 & 4 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 5 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}v & w \\\\ 5 & 4\\end{aligned}|\\cdot |\\begin{aligned}2 & 1 \\\\ 5 & 5\\end{aligned}| \\\\  & =3\\cdot 5 \\\\  & =15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "217666e8-071d-5a25-aed4-6c71a7bf9bd6" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186241472} {:answer/id #uuid "2b36684f-9b26-5fbd-88f6-07df0bf41f04" :answer/type {