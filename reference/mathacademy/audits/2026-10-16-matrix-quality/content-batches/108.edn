6-ba2f-f64d182752ed" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $x=3$" :db/id #edb/ref 17592186396188} {:answer/id #uuid "c2e9ced4-a3e4-50e4-8475-6ffa71f360f3" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=3$" :db/id #edb/ref 17592186396189}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $3$" :db/id #edb/ref 17592186396187} :answer-field/id #uuid "daffb22d-4d43-548d-b3e0-44a4cfce0727" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396184}] :question/id #uuid "3ddcb294-a508-54d0-bd15-63145db8f082" :question/math-academy-id "q-8054" :question/problem "What linear transformation $T$ is represented by the matrix $T=\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix}?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n\\begin{bmatrix}k & 0 \\\\ 0 & k\\end{bmatrix}.\n$$\n\nHere, we have $k=3.$ Therefore, the matrix represents a dilation with a scale factor of $3.$"} {:db/id #edb/ref 17592186396190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fe2e6e8-335c-58be-b255-c60fa43a41f2" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $1$" :db/id #edb/ref 17592186396192} {:answer/id #uuid "7aa33fd0-bc88-5221-b0ce-b4b35cc3e471" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $x$-axis" :db/id #edb/ref 17592186396193} {:answer/id #uuid "99f4a2a9-46a7-591a-b8d7-dd58887c39ab" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=x$" :db/id #edb/ref 17592186396194} {:answer/id #uuid "7810d358-12eb-5db3-8061-1d557a816ce3" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=-x$" :db/id #edb/ref 17592186396195} {:answer/id #uuid "84c9888e-01f7-56a1-a9cc-589307e77959" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186396196}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=-x$" :db/id #edb/ref 17592186396195} :answer-field/id #uuid "4259dafc-1a37-55ff-aa39-09cc98e980bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396191}] :question/id #uuid "e53a5dab-4c76-5167-b8bb-303aab059a57" :question/math-academy-id "q-8060" :question/problem "What linear transformation $T$ is represented by the matrix $T=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}?$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we compute the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}=-j \\\\ {j}^{′} & =T(j)=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following image:\n\n![](images/4a/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)\n\nTherefore, the matrix represents a reflection in the line $y=-x.$"} {:db/id #edb/ref 17592186396708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c162ec8c-668b-5bfc-ab23-8423cf76c91f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186396710} {:answer/id #uuid "62baa2db-7c19-5634-b5e6-1d42635e4fb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186396711} {:answer/id #uuid "e8c0ccfc-1a58-56d8-bf17-b789f1ca213c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186396712} {:answer/id #uuid "c8045e89-1656-55f6-a0dd-d7b1b98bab9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186396713} {:answer/id #uuid "d3f965ef-6b47-527f-a571-556003d4b579" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186396714}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186396711} :answer-field/id #uuid "d53d07f6-e520-5ab9-8077-eda6c3ac37ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396709}] :question/id #uuid "1040f4bd-3d1a-5f7b-8b2b-4c581d4ad345" :question/math-academy-id "q-78297" :question/problem "Which of the following represents a reflection across the $x$-axis?" :question/worked-solution "The correct answer is $T=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}.$ Indeed, consider the standard basis $\\{i,j\\}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of $\\{i,j\\}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=i \\\\ {j}^{′} & =T(j)=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}=-j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](images/b9/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)"} {:db/id #edb/ref 17592186396715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "272ad4ce-b146-5a57-8c5a-5d1e1b3e79ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186396717} {:answer/id #uuid "b7fe5771-8880-5a10-a850-ea4baad6b72e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186396718} {:answer/id #uuid "c2191dbe-147e-5390-a126-2d6a0061ee2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186396719} {:answer/id #uuid "c22c0f50-7b0a-5358-91f1-6489ddb8ffdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186396720} {:answer/id #uuid "ace98a54-10d8-5584-91a9-8dc23cfa3eb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186396721}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186396720} :answer-field/id #uuid "47512c4c-4d28-5025-9b41-fddc19cb1574" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396716}] :question/id #uuid "a51c70cd-319b-5de1-a71f-816af37c3370" :question/math-academy-id "q-78302" :question/problem "Which of the following represents a reflection in the line $y=-x?$" :question/worked-solution "The correct answer is $T=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}.$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}=-j \\\\ {j}^{′} & =T(j)=\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}=-i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](images/4a/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)"} {:db/id #edb/ref 17592186401137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ad4e4e-04cb-51fe-abe1-4e867e431a03" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=x+\\frac{2}{3}$" :db/id #edb/ref 17592186401139} {:answer/id #uuid "5a15a75a-e128-599b-b3b9-5645e7305697" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=\\frac{2}{3}x$" :db/id #edb/ref 17592186401140} {:answer/id #uuid "f0452ac4-63df-52cb-a5ba-4c3d6f3508db" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{2}{3}$" :db/id #edb/ref 17592186401141} {:answer/id #uuid "4708c967-b8d8-54c4-ada0-7e3e2fab1f49" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{3}{2}$" :db/id #edb/ref 17592186401142} {:answer/id #uuid "d94c5e9f-ee52-566e-9640-baf243e6ea0e" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=\\frac{2}{3}$" :db/id #edb/ref 17592186401143}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{2}{3}$" :db/id #edb/ref 17592186401141} :answer-field/id #uuid "7629eca5-066a-5cf0-88fc-0ed79060b5bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401138}] :question/id #uuid "0bb92e93-2cdf-508a-a231-165363849a16" :question/math-academy-id "q-159764" :question/problem "What linear transformation $T$ is represented by the matrix $T=\\begin{bmatrix}\\frac{2}{3} & 0 \\\\ 0 & \\frac{2}{3}\\end{bmatrix}?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n\\begin{bmatrix}k & 0 \\\\ 0 & k\\end{bmatrix}.\n$$\n\nHere, we have $k=\\frac{2}{3}.$ Therefore, the matrix represents a dilation with a scale factor of $\\frac{2}{3}.$"}] :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"} {:db/id #edb/ref 17592186087752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087568 :question/id #uuid "ef17b637-7c4d-5515-99b7-13b1290244f4" :question/math-academy-id "e-5452" :question/problem "A linear transformation $\\mathbf{T}$ represents a dilation. Given that ![](images/bd/bd6574ee05b60919de656a889f8532e5a512b381eae63f7a65f251a7afe72738.png) and ![](images/be/be73c2a933a6fb99eaa389774a618848bdadd9cafdf0fcd2f6af126b49b87707.png) what is the standard matrix of $\\mathbf{T}?$" :question/worked-solution "We can write $\\mathbf{T}(\\mathbf{v})$ as follows:\n\n$$\n\\begin{aligned}T(v) & =\\begin{bmatrix}6 \\\\ 4\\end{bmatrix} \\\\  & =\\frac{1}{4}\\cdot \\begin{bmatrix}24 \\\\ 16\\end{bmatrix} \\\\  & =\\frac{1}{4}v\\end{aligned}\n$$\n\nSince we have $\\mathbf{T}(\\mathbf{v}) = \\dfrac{1}{4}\\mathbf{v},$ we conclude that the linear transformation $\\mathbf T$ is a dilation with scale factor $k = \\dfrac{1}{4}.$\n\nRemember that the matrix representing a dilation of scale factor $k$ is given by\n![](images/48/4866597a50fbdb530e9275c77f2ca926c932c7cc334635bd05191aaddd510d75.png)\n\nTherefore, the standard matrix of $\\mathbf{T}$ is\n![](images/96/962b9458714f9b7f6b17fe2259e140dfabba443d8ecb5b9e2328172ab3f8a1a2.png)"} :knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/questions [{:db/id #edb/ref 17592186088154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88b661cd-c33a-50ad-b654-ffcaf22d821b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 30 \\\\ -30 & 0\\end{bmatrix}" :db/id #edb/ref 17592186085579} {:answer/id #uuid "cb413df9-adb6-5b08-93d7-26991b21352d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 0 \\\\ 0 & -15\\end{bmatrix}" :db/id #edb/ref 17592186085580} {:answer/id #uuid "37f5c4fe-70ff-5338-a214-4dd038196527" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}30 & 0 \\\\ 0 & 30\\end{bmatrix}" :db/id #edb/ref 17592186085581} {:answer/id #uuid "3a054d94-a97b-505b-80a0-235b57e4c2f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 \\\\ 30 & 90\\end{bmatrix}" :db/id #edb/ref 17592186085582} {:answer/id #uuid "4a96f14f-36d0-51c7-a339-f22a43efbdbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 0 \\\\ 0 & 15\\end{bmatrix}" :db/id #edb/ref 17592186085583}] :answer-field/id #uuid "3aa5cdb8-733b-570b-b88b-f2e44873b161" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085578}] :question/id #uuid "40086a0d-2442-5605-bf60-ce4d133979bb" :question/math-academy-id "q-38042" :question/problem "A linear transformation $T$ represents a dilation. Given that $v = \\begin{bmatrix}2 \\\\ -6\\end{bmatrix}$ and $T(v) = \\begin{bmatrix}30 \\\\ -90\\end{bmatrix}$, what is the standard matrix of $T$?"} {:db/id #edb/ref 17592186088155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0207d956-c871-5c34-8c83-998c0d45f1b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ 6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186413275} {:answer/id #uuid "240b2653-be6a-543b-87fa-bc567dfdb80c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 1 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186413277} {:answer/id #uuid "4b10917c-7b50-5beb-9269-5fa579194a74" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 0 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186413282} {:answer/id #uuid "b113d288-13d0-5627-8a97-e292566d6fa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 48 \\\\ 8 & -1\\end{bmatrix}" :db/id #edb/ref 17592186413284} {:answer/id #uuid "b29172ef-23dc-5743-a67c-26d08a2db9a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186413285}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186413285} :answer-field/id #uuid "1235c3ee-01a6-5118-9232-ffc94935dca5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413286}] :question/id #uuid "7193e739-601b-592a-8f0d-83363b6d9331" :question/math-academy-id "q-38046" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=\\begin{bmatrix}8 \\\\ -1\\end{bmatrix}$ and $T(v)=\\begin{bmatrix}48 \\\\ -6\\end{bmatrix},$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =\\begin{bmatrix}48 \\\\ -6\\end{bmatrix} \\\\  & =6\\cdot \\begin{bmatrix}8 \\\\ -1\\end{bmatrix} \\\\  & =6v\\end{aligned}\n$$\n\nSo we have $T(v)=6v,$ and so the linear transformation $T$ is a dilation with scale factor $k=6.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n\\begin{bmatrix}k & 0 \\\\ 0 & k\\end{bmatrix}.\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=\\begin{bmatrix}6 & 0 \\\\ 0 & 6\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186278257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "604197b6-9e1c-5a78-9637-a1d400ba7ffe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186276338} {:answer/id #uuid "b6a70493-a010-5dc9-9dfc-07188b10ff9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186277101} {:answer/id #uuid "cc1d3cd4-89ea-57b1-ad66-325a0b7275fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & \\frac{1}{4} \\\\ \\frac{1}{4} & 0\\end{bmatrix}" :db/id #edb/ref 17592186277292} {:answer/id #uuid "d0031bd1-a038-5821-ba49-67e5c807c811" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186277320} {:answer/id #uuid "f8da7eeb-77bb-5eb0-8e0d-8c218f345e91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186277653}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186277653} :answer-field/id #uuid "6b838235-d041-5a56-bbd8-91053c7372c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277913}] :question/id #uuid "0a98d338-0c74-5c5f-9d1e-e0a133debca0" :question/math-academy-id "q-159760" :question/problem "A linear transformation $T$ represents a dilation.  Given that $v=\\begin{bmatrix}16 \\\\ -20\\end{bmatrix}$ and $T(v)=\\begin{bmatrix}4 \\\\ -5\\end{bmatrix},$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =\\begin{bmatrix}4 \\\\ -5\\end{bmatrix} \\\\  & =\\frac{1}{4}\\cdot \\begin{bmatrix}16 \\\\ -20\\end{bmatrix} \\\\  & =\\frac{1}{4}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{1}{4}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{1}{4}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n\\begin{bmatrix}k & 0 \\\\ 0 & k\\end{bmatrix}.\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{4}\\end{bmatrix}.\n$$"} {: