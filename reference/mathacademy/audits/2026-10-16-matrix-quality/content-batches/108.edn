0 & 0 \\\\ -3 & 7 & 1 & -4 \\\\ 5 & -8 & -10 & 4\\end{aligned}| \\\\  & =2\\cdot (-1)^{2+1}|\\begin{aligned}-2 & 0 & 3 \\\\ 7 & 1 & -4 \\\\ -8 & -10 & 4\\end{aligned}| \\\\  & =-2|\\begin{aligned}-2 & 0 & 3 \\\\ 7 & 1 & -4 \\\\ -8 & -10 & 4\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d6e884-c166-55a3-a97c-9e435db64b06" :answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}-1 & 3 & 4 \\\\ -2 & 2 & 3 \\\\ 1 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186483607} {:answer/id #uuid "5e4476d2-7b18-522a-b167-52cbab3f3c3f" :answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}3 & 6 & -3 \\\\ -2 & 2 & 3 \\\\ 1 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186483748} {:answer/id #uuid "8b44067d-79fe-52e7-82bd-1255f8daff64" :answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}1 & 3 & 4 \\\\ 2 & 2 & 3 \\\\ 4 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186483854} {:answer/id #uuid "9e5f3ec9-451c-5e08-9424-a012a9cef0b1" :answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186483895} {:answer/id #uuid "d5ed131f-b891-52a5-9551-160b86e31eff" :answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}4 & 5 & 3 \\\\ 8 & 6 & -5 \\\\ 1 & 9 & 7\\end{aligned}|" :db/id #edb/ref 17592186483994}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3|\\begin{aligned}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186483895} :answer-field/id #uuid "773fbcca-312d-53ef-8e00-a56e31c49e76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484139}] :question/id #uuid "858b58f0-f246-57e1-b5d7-2b4a24d86dda" :question/math-academy-id "q-91200" :question/problem "$$\n|\\begin{aligned}9 & 3 & 6 & -3 \\\\ 1 & -1 & 3 & 4 \\\\ 2 & -2 & 2 & 3 \\\\ 4 & 1 & -1 & -2\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{12}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{12}=3$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}9 & 3 & 6 & -3 \\\\ 1 & -1 & 3 & 4 \\\\ 2 & -2 & 2 & 3 \\\\ 4 & 1 & -1 & -2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-3){C}_{2} \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}0 & 3 & 0 & 0 \\\\ 4 & -1 & 5 & 3 \\\\ 8 & -2 & 6 & 1 \\\\ 1 & 1 & -3 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}0 & 3 & 0 & 0 \\\\ 4 & -1 & 5 & 3 \\\\ 8 & -2 & 6 & 1 \\\\ 1 & 1 & -3 & -1\\end{aligned}| \\\\  & =3\\cdot (-1)^{1+2}|\\begin{aligned}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{aligned}| \\\\  & =-3|\\begin{aligned}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158027fe-d400-5403-b113-28a2067773a8" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 2 & 1 \\\\ -2 & -1 & 3 \\\\ -1 & -2 & 2\\end{aligned}|" :db/id #edb/ref 17592186550413} {:answer/id #uuid "337cbaa8-fc57-5b7c-903e-2bd27c9209af" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 2 & 2 \\\\ 5 & -2 & -1 \\\\ 7 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186550491} {:answer/id #uuid "aa13465f-e041-55e1-9140-2cd2282116de" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 3 & 1 \\\\ -4 & 2 & 2 \\\\ 5 & -2 & -1\\end{aligned}|" :db/id #edb/ref 17592186550821} {:answer/id #uuid "b73a51f1-c568-5f92-aff8-42cc56eb157b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{aligned}|" :db/id #edb/ref 17592186550871} {:answer/id #uuid "c02e61c6-21c0-5d92-95e2-e73618a38e09" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-6 & -4 & 9 \\\\ 6 & 1 & -6 \\\\ 5 & 9 & -1\\end{aligned}|" :db/id #edb/ref 17592186550894}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{aligned}|" :db/id #edb/ref 17592186550871} :answer-field/id #uuid "29c80b82-1274-56dd-b869-d31fed57239d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551089}] :question/id #uuid "4038f08b-56e1-5740-bb03-adc638c1a6b4" :question/math-academy-id "q-91219" :question/problem "$$\n|\\begin{aligned}1 & 3 & 1 & -4 \\\\ -4 & 2 & 2 & 1 \\\\ 5 & -2 & -1 & 3 \\\\ 7 & -1 & -2 & 2\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{13}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{13}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 3 & 1 & -4 \\\\ -4 & 2 & 2 & 1 \\\\ 5 & -2 & -1 & 3 \\\\ 7 & -1 & -2 & 2\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-1){C}_{3} \\\\ {C}_{2}:={C}_{2}+(-3){C}_{3} \\\\ {C}_{4}:={C}_{4}+4{C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -6 & -4 & 2 & 9 \\\\ 6 & 1 & -1 & -1 \\\\ 9 & 5 & -2 & -6\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -6 & -4 & 2 & 9 \\\\ 6 & 1 & -1 & -1 \\\\ 9 & 5 & -2 & -6\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+3}|\\begin{aligned}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{aligned}| \\\\  & =|\\begin{aligned}-6 & -4 & 9 \\\\ 6 & 1 & -1 \\\\ 9 & 5 & -6\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ea1ce55-966d-5f10-abed-3819f8de0d04" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}1 & -2 & -2 \\\\ 5 & 8 & 3 \\\\ 13 & -9 & 10\\end{aligned}|" :db/id #edb/ref 17592186550554} {:answer/id #uuid "88557905-c296-5243-b252-30962e7378f3" :answer/type {:db/ident :answer.type/math} :answer/value "3|\\begin{aligned}7 & -2 & 5 \\\\ 5 & 8 & 5 \\\\ 10 & -9 & 11\\end{aligned}|" :db/id #edb/ref 17592186550712} {:answer/id #uuid "8a9b00b3-88c8-55d0-a71f-b06285ff52ff" :answer/type {:db/ident :answer.type/math} :answer/value "5|\\begin{aligned}2 & 4 & -2 \\\\ 4 & -5 & 5 \\\\ 13 & 6 & -11\\end{aligned}|" :db/id #edb/ref 17592186550719} {:answer/id #uuid "b93f13a2-e5b1-5e21-8544-b4448537f761" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}7 & 2 & -2 \\\\ -3 & 4 & 5 \\\\ 13 & -9 & 12\\end{aligned}|" :db/id #edb/ref 17592186550878} {:answer/id #uuid "fe7aab0a-5fbf-5e2a-a8eb-5cfb03bbb901" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{aligned}|" :db/id #edb/ref 17592186551051}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{aligned}|" :db/id #edb/ref 17592186551051} :answer-field/id #uuid "d4767d77-4ea5-54fd-8af5-d2063ff21fec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551202}] :question/id #uuid "634c0345-e97a-5738-8ae3-640a8e78ce93" :question/math-academy-id "q-132023" :question/problem "$$\n|\\begin{aligned}3 & 1 & 7 & -5 \\\\ -2 & 9 & -2 & 7 \\\\ 5 & 3 & 6 & 6 \\\\ 1 & -2 & 3 & -1\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the right of ${a}_{41}$ equal to zero.*" :question/worked-solution "Let's make entries to the right of ${a}_{41}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 1 & 7 & -5 \\\\ -2 & 9 & -2 & 7 \\\\ 5 & 3 & 6 & 6 \\\\ 1 & -2 & 3 & -1\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+2{C}_{1} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{1} \\\\ {C}_{4}:={C}_{4}+{C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}3 & 7 & -2 & -2 \\\\ -2 & 5 & 4 & 5 \\\\ 5 & 13 & -9 & 11 \\\\ 1 & 0 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 7 & -2 & -2 \\\\ -2 & 5 & 4 & 5 \\\\ 5 & 13 & -9 & 11 \\\\ 1 & 0 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+1}|\\begin{aligned}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{aligned}| \\\\  & =-|\\begin{aligned}7 & -2 & -2 \\\\ 5 & 4 & 5 \\\\ 13 & -9 & 11\\end{aligned}|.\\end{aligned}\n$$"}] :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] :topic/math-academy-id 1773 :topic/title "Finding Determinants Using Row and Column Operations"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186088609} :activity/id #uuid "bc935836-c5f6-5bf6-8105-6072d1f0946d" :activity/steps [{:db/id #edb/ref 17592186088609 :step/content {:db/id #edb/ref 17592186088930 :tutorial/content "A **dilation** of scale factor $k$ with the center at the origin is a linear transformation that multiplies the standard basis vectors by $k.$ It is represented by the matrix\n![](images/0b/0bad96759d0f794111219092aebafa8242d11ab8adf1bd4dbec31d28f745c766.svg)\n\nFor example, let ![](images/f6/f6c5df003fc9570c1a7ee6111f778f79f27bdffd61d717ee3a5ebf6e53c9718e.svg) be the matrix of a linear transformation $\\mathbf{T}.$ This transformation is a dilation of scale factor $2.$\n\nTo visualize the dilation $\\mathbf{T},$ consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square $\\mathrm{R}$ spanned by the vectors, as shown below. \n\n![](images/6e/6e38185922e9cad6d3961e7c5e755eabf4c52eafd1cc81a1e81a383b4df5ae82.png)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =Ti=[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 0\\end{aligned}]=2i, \\\\ {j}^{′} & =Tj=[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}]=2j.\\end{aligned}\n$$\n\nThe transformation $\\mathbf{T}$ multiplies vectors $\\mathbf{i}$ and $\\mathbf{j}$ by $2.$ The resulting vectors span a larger region, shown below.\n\n![](images/cc/cc6677c641a2a713e0324db90edfdd86a5ca1c096c0ffd70f1216119f36da645.png)" :tutorial/id #uuid "689fa0a7-c69e-5bd3-8a10-31aca7d9871f" :tutorial/math-academy-id 3536 :tutorial/title "Introduction"} :step/id #uuid "b3147c60-fe22-5922-b00c-9f4e25a56724" :step/next {:db/id #edb/ref 17592186088612}} {:db/id #edb/ref 17592186088610 :step/content {:db/id #edb/ref 17592186088931 :tutorial/content "A **reflection in the $x$-axis** is represented by the matrix\n![](images/96/96d1e42ccb0e19c6a7fe605af0cbd17ded39967798c9804bf7514adc845c44b8.svg)\n\nTo visualize a reflection in the $x$-axis, consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square $\\mathrm{R}$ spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nThen, we obtain the following image:\n\n![](images/b9/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)\n\nSimilarly, a **reflection in the $y$-axis** is represented by the matrix\n![](images/40/40e77688a74462b8d0d29bca87db283c4ccb960fad6f1ac7cbac716a73f7b8e0.svg)\n\nAgain, we can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j\\end{aligned}\n$$\n\nWe obtain the following image:\n\n![](images/49/4993d8586a84e4a40a54edddd8011cd3d516264bfffc7e3c33d27a10edf1e7d7.png)" :tutorial/id #uuid "f38c3a51-d627-5de8-aa0b-e8e8064003c9" :tutorial/math-academy-id 3537 :tutorial/title "Reflection in the X and Y Axes"} :step/id #uuid "3318223f-ba60-5669-a52f-d290b463770d" :step/next {:db/id #edb/ref 17592186088665}} {:db/id #edb/ref 17592186088611 :step/content {:db/id #edb/ref 17592186087751 :knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"} :step/id #uuid "06bf3e6f-207a-50aa-b32c-11f8a634e387"} {:db/id #edb/ref 17592186088612 :step/content {:db/id #edb/ref 17592186087752 :knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508"} :step/id #uuid "6cfaedb9-ffad-54bf-a47e-87c0ea841b5a" :step/next {:db/id #edb/ref 17592186088610}} {:db/id #edb/ref 17592186088665 :step/content {:db/id #edb/ref 17592186088956 :tutorial/content "A **reflection in line $y=x$** is represented by the matrix\n![](images/d6/d6c5ff7f9c96510f6243059a023a32026a3ea0dd181a2b07bdf82147de887361.svg)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nThen, we obtain the following image:\n\n![](images/0e/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)\n\nSimilarly, a **reflection in line $y=-x$** is represented by the matrix\n![](images/f4/f450c3581b23abb715ba02d7459b043f6414cbd06e50bafdafbdb011e4160625.svg)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nThen, we obtain the following image:\n\n![](images/4a/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)" :tutorial/id #uuid "9b34a369-035e-5610-a337-6169ea364331" :tutorial/math-academy-id 4161 :tutorial/title "Reflection in the Lines y=x and y=-x"} :step/id #uuid "0aa5472d-88af-57aa-8bf3-c32dc3b082a4" :step/next {:db/id #edb/ref 17592186088611}}] :activity/title "Dilations and Reflections as Linear Transformations" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087934}] :db/id #edb/ref 17592186049719 :topic/knowledge-points [{:db/id #edb/ref 17592186087751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087567 :question/id #uuid "8559e2bf-8b48-5e26-81c6-0db03d93645a" :question/math-academy-id "e-5451" :question/problem "What linear transformation is represented by the matrix\n![](images/03/0394b5d3a371caf95d5e701c0ffb00894eb685e706d8b70af2149057de0b0cb5.png)" :question/worked-solution "Consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square spanned by the vectors, as depicted below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nWe can find the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=i \\\\ {j}^{′} & =T(j)=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}=-j\\end{aligned}\n$$\n\nThen, we obtain the following image:\n\n![](images/b9/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)\n\nTherefore, the matrix represents the reflection across the $x$-axis."} :knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/questions [{:db/id #edb/ref 17592186088359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cf882f5-9cd3-58b6-b676-05c7608b1255" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186345603} {:answer/id #uuid "5590b2dc-4b76-5740-a506-529e10bb557b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186346079} {:answer/id #uuid "88e477a7-8a6f-5d2e-958a-698149516385" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186346538} {:answer/id #uuid "dac5f817-6a9a-589b-b357-c2881f148863" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186347273} {:answer/id #uuid "e5ee60e1-9cbf-5634-a8d8-b658b07a4f1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186347377}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186345603} :answer-field/id #uuid "5e9ebdbf-409d-5500-858b-2c2dbee0dd0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347770}] :question/id #uuid "cad47c40-27a1-5f31-8c6f-6a66b9bee47d" :question/math-academy-id "q-78299" :question/problem "Which of the following represents a reflection across the $y$-axis?" :question/worked-solution "The correct answer is $T=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}.$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}=-i \\\\ {j}^{′} & =T(j)=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](images/49/4993d8586a84e4a40a54edddd8011cd3d516264bfffc7e3c33d27a10edf1e7d7.png)"} {:db/id #edb/ref 17592186088383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86d14c1a-f401-5ece-a7fd-8dc456503e05" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y =-x$" :db/id #edb/ref 17592186086952} {:answer/id #uuid "b91003e9-9cda-59bd-a623-dc2eca7b7c4b" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $x$-axis" :db/id #edb/ref 17592186086953} {:answer/id #uuid "1900ec49-bcbf-51a4-8673-82004b36471f" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186086954} {:answer/id #uuid "56189f96-70b8-57c9-a6e2-c95f473ef25f" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y = x$" :db/id #edb/ref 17592186086955} {:answer/id #uuid "6a65cd81-49e3-545f-b183-c5d5e0d4e782" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $1$" :db/id #edb/ref 17592186086956}] :answer-field/id #uuid "5108189c-9d0c-55f1-a1f1-c54ab6bbf2c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086951}] :question/id #uuid "93e946fa-bcea-5052-8f17-765d1f144f5b" :question/math-academy-id "q-8058" :question/problem "What linear transformation $T$ is represented by the matrix $T = \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$?"} {:db/id #edb/ref 17592186253584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17422a22-e149-5bfb-9657-fc23993ddd58" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{2}$" :db/id #edb/ref 17592186250757} {:answer/id #uuid "2dea7143-87eb-57ea-9ee5-bf9592bfb8c1" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=x$" :db/id #edb/ref 17592186250946} {:answer/id #uuid "6e6a5c2e-ec0e-5e88-b094-13e73328184e" :answer/type {:db/ident :answer.type/text} :answe