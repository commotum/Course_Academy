\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 2 & 6 \\\\ 0 & 1 & -4 & -3 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{1}+2{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & -7 & -4 & 12 \\\\ 0 & 1 & -4 & -3 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-7 & -4 & 12 \\\\ -4 & -3 & 3\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186388688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088d91a0-3eaf-51f2-8ffe-b7c678ccdbc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -8 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186388690} {:answer/id #uuid "a023134e-086b-501d-b434-5e8d31a4adbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -8 \\\\ 6 & 3\\end{bmatrix}" :db/id #edb/ref 17592186388691} {:answer/id #uuid "ab0e6d22-1976-5811-872d-d23e457baf1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -8 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388692} {:answer/id #uuid "ad10460a-fb61-5b63-8b5e-2777f724a5aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -8 \\\\ 3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388693} {:answer/id #uuid "37fb40f0-005c-5d6e-98d1-6dd223500ce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 3 \\\\ -1 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388694}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -8 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388692} :answer-field/id #uuid "6d8dbb4a-8123-5815-85e7-0b6642b71201" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388689}] :question/id #uuid "3c5b8550-93bd-5bca-bdbb-d5d6c011cb4e" :question/math-academy-id "q-140441" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{\\begin{bmatrix}2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 2 & -2 & -4 \\\\ 4 & 6 & 2 & 4\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 & -2 \\\\ 4 & 6 & 2 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 & -2 \\\\ 0 & 2 & 6 & 12\\end{bmatrix} & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -1 & -2 \\\\ 0 & 1 & 3 & 6\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -4 & -8 \\\\ 0 & 1 & 3 & 6\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-4 & -8 \\\\ 3 & 6\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186395276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d7bfb37-1065-5eb4-8134-8741170afa97" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 & 1 \\\\ -2 & -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186395278} {:answer/id #uuid "ee82fd86-59d0-5395-b20a-10cc6c3f34f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 & 1 \\\\ -2 & 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186395279} {:answer/id #uuid "7e79a045-c45d-5539-80e3-ec38e76da4e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 4 & -3 \\\\ -2 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186395280} {:answer/id #uuid "b7bbf985-e0a4-50f0-862f-a9b7751b5950" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -1 & -3 \\\\ -2 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186395281} {:answer/id #uuid "017d966b-2f05-53e7-8103-f08e13543bbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -2 & -3 \\\\ 2 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186395282}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -1 & -3 \\\\ -2 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186395281} :answer-field/id #uuid "9066e9bb-d0c4-5730-a4a9-19d3c2a0f9ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395277}] :question/id #uuid "6ab6a3b9-40b4-5b5f-8edf-85f76fb14b73" :question/math-academy-id "q-97549" :question/problem "Consider the basis $B={{b}_{1},{b}_{2},{b}_{3}}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC={\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}4 \\\\ 2\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 4 & -1 & -3 \\\\ 3 & 5 & 2 & 2 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 4 & -1 & -3 \\\\ 0 & 5 & -10 & 5 & 10\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{5}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 4 & -1 & -3 \\\\ 0 & 1 & -2 & 1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}4 & -1 & -3 \\\\ -2 & 1 & 2\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186480658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4643689c-111c-506e-83db-71c5cf05b657" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186480225} {:answer/id #uuid "c162ebde-a03d-59c9-b01e-5d46df6d7d47" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 2 \\\\ -1 & 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186480432} {:answer/id #uuid "d10ce345-4811-5492-ab7d-0be280aefd58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 & 0 \\\\ 2 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480463} {:answer/id #uuid "d3f0d8d3-dcb7-5a4e-a72f-5cde1424c4b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480468} {:answer/id #uuid "d66cee92-5593-5458-8315-9a280b3f17f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 & 0 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186480474}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480468} :answer-field/id #uuid "e3cea2c7-492b-5863-ae01-4ec758213e20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480611}] :question/id #uuid "537bf679-c812-55fa-b501-947966556962" :question/math-academy-id "q-97544" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}3 \\\\ -4\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 1 & 3 & -2 & 1 \\\\ 2 & -1 & -4 & 4 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & -3 & 2 & -1 \\\\ 2 & -1 & -4 & 4 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & -3 & 2 & -1 \\\\ 0 & 1 & 2 & 0 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186480659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b87f35e-0758-5462-b6a0-d49e1dccda79" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 1 & 0 \\\\ 11 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480157} {:answer/id #uuid "8473dd0f-3699-547a-b702-13728d708130" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 11 \\\\ 3 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480332} {:answer/id #uuid "be55f8ab-39e7-5927-bc8d-b778cc3678e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 3 \\\\ 2 & 11 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480427} {:answer/id #uuid "c550d392-6e57-5f4d-8987-e916e530a5c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 1 & 2 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480438} {:answer/id #uuid "efd4b1a9-a352-5827-8e72-7263ea973184" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 3 & 0 \\\\ 1 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480506}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 1 & 2 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186480438} :answer-field/id #uuid "5e1702e9-d224-54f0-ba7a-5b0ced65eeb6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480563}] :question/id #uuid "53cc1ac5-9894-5a1e-9795-bc748bbd204d" :question/math-academy-id "q-97543" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 3 & -2 & -1 & 1 \\\\ -1 & 4 & 1 & -1 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 1 & -1 \\\\ -1 & 4 & 1 & -1 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 1 & -1 \\\\ 0 & 1 & 3 & 0 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 11 & 1 & 2 \\\\ 0 & 1 & 3 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}11 & 1 & 2 \\\\ 3 & 0 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186501135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3811dc15-f044-5933-86e0-b81332887411" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -3 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186500581} {:answer/id #uuid "575b1543-5913-5111-9e9c-4cf207869497" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ -1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186500645} {:answer/id #uuid "5e277c6c-dcd2-5491-b1f3-c7fa6def4dfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186500660} {:answer/id #uuid "6a9c8e6c-8875-5f05-83c5-ba640b983ce5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186500687} {:answer/id #uuid "be36abcb-60b4-5b59-8d60-819c63d7b780" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186500862}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186500862} :answer-field/id #uuid "f4374709-dd94-564d-a093-c34e0f6d470b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501125}] :question/id #uuid "00e54e6a-cd0f-51b4-97b3-2489c07dd2c2" :question/math-academy-id "q-97574" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ -4 & 1 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 0 & -3 & 9 & -3\\end{bmatrix} & {R}_{2} & :=(-\\frac{1}{3}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 0 & 1 & -3 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 1 & -3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-1 & 0 \\\\ -3 & 1\\end{bmatrix}\n$$"}] :knowledge-point/title "Finding the Matrix of a Linear Map Relative to Two Bases Given One Basis"}] :topic/math-academy-id 1967 :topic/title "The Matrix of a Linear Map Relative to Two Bases"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186129976} :activity/id #uuid "9eb9ab54-1ec4-5368-a2e1-150d6811c312" :activity/steps [{:db/id #edb/ref 17592186129976 :step/content {:db/id #edb/ref 17592186130353 :tutorial/content "Rotation-scaling matrices are involved in an important theorem regarding complex eigenvalues.\n\nTo sketch out the key idea, let's consider the matrix \n\n![](images/06/06a28b9b9d8db65a4214ed1d446c68f288978acc59afd3720873da7f825efe13.svg)\n\nwhich has the complex eigenvalue \n\n$$\n\\lambda=1-2\\textrm{i}={\\color{blue}1}+({\\color{red}-2})\\textrm{i}\n$$\n\nand the corresponding complex eigenvector \n\n![](images/1b/1b7aa45404b3e6e02cb9802da371f6c74f6848f4b5601261f2257e12b7d362d0.svg)\n\nNow, we construct a rotation-scaling matrix $C$ using the real and imaginary parts of the eigenvalue $\\lambda$ as follows:\n![](images/0f/0f29362b05dd18b6a8a307f531cea6d59c083301703285bde41a9488f228c386.svg)\nWe also construct a matrix $P$ whose columns are the real and imaginary parts of the corresponding eigenvector:\n![](images/d1/d1b2efc5b22e34c0bb4cb93a4777c8d8139ca0047253b7177bd1809a272f5b37.svg)\n\nThe **rotation-scaling theorem** states that $A$ can be factored as follows:\n\n$$\nA=PCP^{-1}\n$$\n\n \n\nLet's check that this is true in this case:\n\n$$\n\\begin{aligned}PC{P}^{-1} & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}]{[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]}^{-1} \\\\  & =[\\begin{aligned}0 & -5 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -10 \\\\ 4 & 7\\end{aligned}] \\\\  & =A\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "d79a993f-cb2c-5ec9-a24b-ddc7bd94485d" :tutorial/math-academy-id 3594 :tutorial/title "Introduction"} :step/id #uuid "19750f8a-a131-5f4c-9488-2c2c664f3b38" :step/next {:db/id #edb/ref 17592186129978}} {:db/id #edb/ref 17592186129977 :step/content {:db/id #edb/ref 17592186129134 :knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f"} :step/id #uuid "e7048fe4-4391-5227-903b-216c1855d7e0" :step/next {:db/id #edb/ref 17592186130109}} {:db/id #edb/ref 17592186129978 :step/content {:db/id #edb/ref 17592186130354 :tutorial/content "Let's now formally state the rotation-scaling theorem:\n\n*Let $A$ be a $2 \\times 2$ matrix with real entries. If $\\lambda$ is a complex (not real) eigenvalue of $A,$ and $\\mathbf{v}$ is an eigenvector corresponding to $\\lambda,$ then *\n\n$$\nA = PCP^{-1}\n$$\n\n*where*\n![](images/74/74b63ce33cfa7779a6668a22974b709d549843a221c3b13067887e8193c6e6f0.svg)\n\nNote the following:\n\n- When two matrices $A$ and $C$ are related via the equation $A = PCP^{-1},$ we say that they are **similar.**\n\n- The rotation-scaling theorem tells us that every $2 \\!\\times\\! 2$ real matrix with complex (non-real) eigenvalues is similar to a rotation-scaling matrix.\n\n- We call the right-hand side of $A = PCP^{-1}$ the **rotation-scaling form** of $A.$ We can also refer to this as the **rotation-scaling decomposition** of $A.$\n\n- The matrix $P$ *must* be constructed from the eigenvector that corresponds to the eigenvalue defined by $C.$" :tutorial/id #uuid "09a26114-9068-50b4-897e-76504d4f7e68" :tutorial/math-academy-id 3595 :tutorial/title "The Rotation-Scaling Theorem"} :step/id #uuid "6e5f25d2-d5e2-5abe-a1c6-08572dd50606" :step/next {:db/id #edb/ref 17592186129979}} {:db/id #edb/ref 17592186129979 :step/content {:db/id #edb/ref 17592186129135 :knowledge-point/id #uuid "1dcdd3f4-c03e-5887-a493-05598dbe4fc3"} :step/id #uuid "b2e60b35-aad7-5404-bbeb-360484d2e855" :step/next {:db/id #edb/ref 17592186129977}} {:db/id #edb/ref 17592186129980 :step/content {:db/id #edb/ref 17592186129136 :knowledge-point/id #uuid "148c97a4-24c1-5289-ad80-bee4af34509b"} :step/id #uuid "380e2b24-5a1b-580a-9d3e-20419aa321c4" :step/next {:db/id #edb/ref 17592186129981}} {:db/id #edb/ref 17592186129981 :step/content {:db/id #edb/ref 17592186130355 :tutorial/content "Suppose $A$ is a real $2\\!\\times\\! 2$ matrix. To interpret the rotation-scaling form $A=PCP^{-1},$ we should bear in mind the following:\n\n- The matrix $C$ rotates vectors $\\mathbf x\\in\\mathbb R^2$ and then scales them.\n\n- We can think of $P$ as representing the following change of variable:\n\n$$\n\\mathbf x = P\\mathbf u \\qquad \\Longleftrightarrow\\qquad  \\mathbf u = P^{-1}\\mathbf x\n$$\n\nTherefore, $A$ can be thought of as a change of variable from $\\mathbf x$ to $\\mathbf u,$ followed by a rotation and scaling before returning to the original variable.\n\n![](images/ab/ab40869137296cea63fe209a842a4713fcae4fbf53c5089e6722b70bdf3f3230.png)\n\nFor example, let's consider the matrix $A,$ given by\n\n![](images/74/74c17c58d6b39ff6a13ec56e135ec17ce0f260d2e9d90e562544637f6e677db0.svg)\n\nThis is a real matrix with complex eigenvalues and is thus similar to a rotation-scaling matrix. \n\nUsing the techniques described in this lesson, we can show that the rotation-scaling decomposition of $A$ is\n\n![](images/15/1542ac2d3f79e1494ecf9e67dda3219966efdf76267ebda82d7689555dc4df30.svg)\nThe matrix $C$ can be written explicitly as a constant multiple of a rotation matrix as follows:\n![](images/f0/f0d562472e2b230a0cd393829ab4a5dec380e6fd1e2a797af4f1f651aae88f75.svg)\n\nThus, the matrix $C$ represents the following:\n\n- a rotation of $\\arccos\\left(\\dfrac{\\sqrt 3}{2}\\right) = \\dfrac\\pi 6$ counterclockwise about $O,$ and\n\n- an enlargement of scale factor ${\\color{blue}{2}}.$\n\nThe image of a unit square centered at the origin under the action of $A$ can therefore be decomposed as follows:\n\n![](images/92/92f2ab84b9ac8f36a93c42bf93b70b08a3e64eb3920a8bd2d5276217d936ab79.png)" :tutorial/id #uuid "5e77afe5-c30a-56bd-95a6-037f1a903eda" :tutorial/math-academy-id 3596 :tutorial/title "The Geometric Interpretation of Rotation-Scaling Form"} :step/id #uuid "ed8aecde-9d1f-5061-afa2-aa5cc7c1036e"} {:db/id #edb/ref 17592186130109 :step/content {:db/id #edb/ref 17592186129214 :knowledge-point/id #uuid "88f3ba21-6407-503e-aec0-fa4462a69e73"} :step/id #uuid "7ce1fcbb-0bb6-5b74-ba7c-4006f8e5f481" :step/next {:db/id #edb/ref 17592186129980}}] :activity/title "Reducing Real 2x2 Matrices to Rotation-Scaling Form" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186129361} {:activity/first-step {:db/id #edb/ref 17592186410860} :activity/id #uuid "5f5420bc-3099-5b53-8e6a-d43b1a5bffb0" :activity/steps [{:db/id #edb/ref 17592186410858 :step/content {:db/id #edb/ref 17592186410856 :question/id #uuid "b89eb3d0-aaac-5e32-8106-610f887f220d"} :step/id #uuid "43b5ac79-b939-5882-be87-3661f9387201"} {:db/id #edb/ref 17592186410859 :step/content {:db/id #edb/ref 17592186410855 :question/id #uuid "59a82201-03c5-57db-ad1f-7c04fbb98da0"} :step/id #uuid "8a7b4be3-057a-5a01-ae4d-c3c2e06c7bcc" :step/next {:db/id #edb/ref 17592186410861}} {:db/id #edb/ref 17592186410860 :step/content {:db/id #edb/ref 17592186129666 :question/id #uuid "dce754c8-5be0-5c82-8349-b2f897b46d75"} :step/id #uuid "aae2eb64-abfd-507c-b3bc-9c0cd712cf93" :step/next {:db/id #edb/ref 17592186410859}} {:db/id #edb/ref 17592186410861 :step/content {:db/id #edb/ref 17592186410857 :question/id #uuid "d6880ebc-9daa-5cd0-b5d7-2100fa039d06"} :step/id #uuid "c04d526e-a848-55ef-9d6a-e6653cc7bbac" :step/next {:db/id #edb/ref 17592186410858}}] :activity/title "Reducing Real 2x2 Matrices to Rotation-Scaling Form" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186410830}] :db/id #edb/ref 17592186048584 :topic/knowledge-points [{:db/id #edb/ref 17592186129134 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128945 :question/id #uuid "1b13d9bb-9bcf-50be-a58d-39e82d99b9bf" :question/math-academy-id "e-5530" :question/problem "![](images/5f/5f3cd6aeb514ee0a59d1f3534342f85e1c00743d9e7c7004b8aaf8ccfbe353f9.png)\nConsider the vector $\\mathbf{v}$ and the rotation-scaling matrix $C$ shown above. Given that $\\mathbf{v}$ is an eigenvector of a $2 \\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda=-1-4\\textrm{i},$ find a matrix $P$ such that $A=PCP^{-1}.$" :question/worked-solution "Recall that for any $2 \\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PCP^{-1},$ where \n\n![](images/9f/9fb15e52a1df912c9e5fb4238f45d705cd0a56fb7190620c0f0fd597f9a2b8c0.png)\n\nand $\\mathbf{v}$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda.$\n\nFirst, notice that \n\n![](images/80/80bd36915851e6ebeb67befe8af41e5496fa5491b9d87c294d8b937eb586319f.png)\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}1 \\\\ 1+2\\text{i}\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P\\mathbin{:}$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 1 & 2\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "b049dea4-5045-57ec-ad6a-c49f30e5da1f" :knowledge-point/questions [{:db/id #edb/ref 17592186129662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "759cb3d1-4fd4-57fd-844b-d403ba0481c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186324947} {:answer/id #uuid "796c6bac-6d8d-550a-a75a-5f92e47919c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186324983} {:answer/id #uuid "7af1e329-8609-5f4a-8e5e-4244568929ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186325002} {:answer/id #uuid "b7920c46-2a16-5664-ad36-5cc0669a6d90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186325545} {:answer/id #uuid "c7e60701-4ad6-55b4-ad0d-8c5364d13882" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186325703}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186325545} :answer-field/id #uuid "3177b407-9bba-58a0-8ce8-54e30ce98d1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326309}] :question/id #uuid "31a3b63f-4053-528b-a2b8-f0ec571660f1" :question/math-academy-id "q-38557" :question/problem "$$\nv=\\begin{bmatrix}-\\text{i} \\\\ 1\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 4 \\\\ -4 & 3\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =3+4\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}3 & 4 \\\\ -4 & 3\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}-\\text{i} \\\\ 1\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ce9065-737f-5539-9ccc-e2b738124790" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 1 \\\\ 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186410831} {:answer/id #uuid "1b240860-8981-5813-8afb-56eb81d9d5f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ 3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186410835} {:answer/id #uuid "d4ea0660-35e1-50a9-b795-bedb0a6fec90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186410847} {:answer/id #uuid "dd8d4b33-9126-5017-a544-498f72884d7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186410848} {:answer/id #uuid "ed49cec1-2e8a-5d58-9643-ab871cbaf80d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186410849}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186410848} :answer-field/id #uuid "ca3e15c9-c3c6-56d5-be44-2ff142682b75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410854}] :question/id #uuid "dce754c8-5be0-5c82-8349-b2f897b46d75" :question/math-academy-id "q-38571" :question/problem "$$\nv=\\begin{bmatrix}1+2\\text{i} \\\\ 3\\end{bmatrix},\\,C=\\begin{bmatrix}-7 & -6 \\\\ 6 & -7\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =-7-6\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}-7 & -6 \\\\ 6 & -7\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}1+2\\text{i} \\\\ 3\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0405aea9-6912-5d85-9e50-a3f9ef69a2bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186269306} {:answer/id #uuid "3d3ed471-493b-5435-b1f2-8404cb3fb83b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186269825} {:answer/id #uuid "76148e90-2e97-59b6-9686-95ff7f62c8f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186270311} {:answer/id #uuid "be868ce8-04ee-5308-bbc1-9f946b3d503c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186270952} {:answer/id #uuid "ff5f8b2e-bd39-59f2-ae43-18e5f25b4d40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186271502}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186269825} :answer-field/id #uuid "e52c45ba-1fe0-515f-b234-81ad534395fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271916}] :question/id #uuid "aee079e8-606a-5604-9149-5f1f625de3c5" :question/math-academy-id "q-140494" :question/problem "$$\nv=\\begin{bmatrix}1+2\\text{i} \\\\ 2\\end{bmatrix},\\,C=\\begin{bmatrix}2 & -3 \\\\ 3 & 2\\end{bmatrix}\n$$\n\nConsider the vector $v$ and the rotation-scaling matrix $C$ shown above. Given that $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\lambda =2-3\\text{i},$ find a matrix $P$ such that $A=PC{P}^{-1}.$" :question/worked-solution "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}2 & -3 \\\\ 3 & 2\\end{bmatrix}=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =\\begin{bmatrix}1+2\\text{i} \\\\ 2\\end{bmatrix}={{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 2 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1682a02-6f01-568d-9b39-e36d7afe9f96" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -3 \\\\ -7 & 2\\end{bmatrix}" :db/id #edb/ref 17592186325485} {:answer/id #uuid "de0bfca7-1c3c-585b-a748-6a9cf2e709b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -7 \\\\ 2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186325907} {:answer/id #uuid "e9930dcb-8324-555e-be15-6c7ef589a459" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2 \\\\ 5 & -7\\end{bmatrix}" :db/id