e8a-5f6a-9003-4f5059c3cc71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395303}] :question/id #uuid "5a1af09a-7369-5e69-a1b2-09373ab32df5" :question/math-academy-id "q-97588" :question/problem "$$\nB=\\{\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}3 \\\\ -5\\end{bmatrix}\\},\\,[T]_{B|C}=\\begin{bmatrix}1 & 3 \\\\ 1 & -2 \\\\ -4 & 9\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}={x}_{1}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ -5\\end{bmatrix}.\n$$\n\nThis gives us the system\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+3{x}_{2} &=2 \\\\ 2{x}_{1}-5{x}_{2} &=-1.\\end{aligned}\\right.\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 3 & 2 \\\\ 2 & -5 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & -2 \\\\ 2 & -5 & -1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & -2 \\\\ 0 & 1 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 7 \\\\ 0 & 1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}.$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ 1 & -2 \\\\ -4 & 9\\end{bmatrix}\\begin{bmatrix}7 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186395309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0ded21-2914-5901-ba60-7f716efa5e48" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -13 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186395311} {:answer/id #uuid "1b0722fc-0542-524c-ad19-7fdcd805068d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186395312} {:answer/id #uuid "090376a9-c063-5c0e-91cf-b1cb0b242009" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186395313} {:answer/id #uuid "72046917-807c-5280-98a2-91bcf1867971" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ -13 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186395314} {:answer/id #uuid "659b92fb-bd9f-501f-b53d-a3c6dee5253a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -11 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186395315}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -13 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186395311} :answer-field/id #uuid "891c04a2-9d93-52c6-aea9-a089a7974eb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395310}] :question/id #uuid "c270a7d7-66ac-54a5-b280-e44726faad52" :question/math-academy-id "q-97591" :question/problem "$$\nB={\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}-4 \\\\ 5\\end{bmatrix}},\\,[T]_{B|C}=\\begin{bmatrix}1 & -3 \\\\ -1 & 2 \\\\ -1 & 6\\end{bmatrix},\\,x=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}={x}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-4 \\\\ 5\\end{bmatrix}.\n$$\n\nThis gives us the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-4{x}_{2} &=3 \\\\ -{x}_{1}+5{x}_{2} &=2.\\end{aligned}\\right.\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -4 & 3 \\\\ -1 & 5 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -4 & 3 \\\\ 0 & 1 & 5\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+4{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 23 \\\\ 0 & 1 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}23 \\\\ 5\\end{bmatrix}.$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =\\begin{bmatrix}1 & -3 \\\\ -1 & 2 \\\\ -1 & 6\\end{bmatrix}\\begin{bmatrix}23 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 \\\\ -13 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a28d6132-1d8e-5724-a07d-6971ca3567ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 7 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186480380} {:answer/id #uuid "bf252bd4-6469-59c0-8687-e65f303aa93b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 7 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186480430} {:answer/id #uuid "c65e8608-9b76-56f3-ab38-505b05e017bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186480444} {:answer/id #uuid "cd84be47-ba2b-5391-a8b6-48c42bfc3182" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186480451} {:answer/id #uuid "e332b530-85d0-5d7e-a5be-150ed9ff7435" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186480488}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 7 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186480380} :answer-field/id #uuid "ce679d09-ac04-52d4-b77b-07e1721ea8d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480603}] :question/id #uuid "fc550b7f-6e92-5df1-a72d-54e40643e133" :question/math-academy-id "q-97589" :question/problem "$$\nB=\\{\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}\\},\\,[T]_{B|C}=\\begin{bmatrix}2 & 4 \\\\ 8 & 1 \\\\ 7 & 9\\end{bmatrix},\\,x=\\begin{bmatrix}1 \\\\ -6\\end{bmatrix}\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=\\begin{bmatrix}1 \\\\ -6\\end{bmatrix}={x}_{1}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}.\n$$\n\nThis gives us the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=1 \\\\ -3{x}_{1}+3{x}_{2} &=-6.\\end{aligned}\\right.\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 1 \\\\ -3 & 3 & -6\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 3 & -3\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 8 & 1 \\\\ 7 & 9\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 7 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7031b44d-1e9b-52c9-93b5-f0f954e92248" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186480291} {:answer/id #uuid "8aaf2c0c-dd2e-5921-873c-4712cba0c50f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 15 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186480345} {:answer/id #uuid "9e29c21b-0cb0-546e-800f-baae9705e68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 20 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186480371} {:answer/id #uuid "bec8cfba-4845-5925-99ab-2a603a385da9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186480428} {:answer/id #uuid "fbf6ec06-6876-5b3d-a8d5-9db339d794c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 20 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186480521}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 20 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186480521} :answer-field/id #uuid "851e1d62-f928-5cf2-bd67-94c62fcd5262" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480576}] :question/id #uuid "fcef5190-a033-5c84-9651-3cf919b057c9" :question/math-academy-id "q-97582" :question/problem "$$\nB=\\{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}3 \\\\ 9\\end{bmatrix}\\},\\,[T]_{B|C}=\\begin{bmatrix}1 & 5 \\\\ 3 & 2 \\\\ 2 & 1\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}={x}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ 9\\end{bmatrix}.\n$$\n\nThis gives us the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=2 \\\\ 2{x}_{1}+9{x}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 2 \\\\ 2 & 9 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 3 & -6\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 1 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+(-3){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 8 \\\\ 0 & 1 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}8 \\\\ -2\\end{bmatrix}.$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =\\begin{bmatrix}1 & 5 \\\\ 3 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 20 \\\\ 14\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Image of a Vector Given With Respect to the Standard Basis Under a Linear Map"} {:db/id #edb/ref 17592186124603 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124415 :question/id #uuid "01b46867-ba6d-5085-9543-b77ded581194" :question/math-academy-id "e-8604" :question/problem "Suppose $\\mathbf{T} : V \\rightarrow W$ is a linear map and $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2, \\mathbf{b}_3 \\}$ and $\\mathcal{C} = \\{ \\mathbf{c}_1,\\mathbf{c}_2 \\}$ are the bases of the vector spaces $V$ and $W,$ respectively. Find the matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of the map $\\mathbf{T}$ relative to these bases, if \n\n$\\mathbf{T}(\\mathbf{b}_1)=-3\\mathbf{c}_1+5\\mathbf{c}_2,\\quad$ $\\mathbf{T}(\\mathbf{b}_2)=\\mathbf{c}_2-2\\mathbf{c}_1\\quad$ and $\\quad\\mathbf{T}(\\mathbf{b}_3)=\\mathbf{c}_1+5\\mathbf{c}_2.$" :question/worked-solution "First, we write the images of vectors in $\\mathcal{B}$ relative to the basis $\\mathcal{C} \\mathbin{:}$ \n\n$$\n\\begin{aligned}T({b}_{1})=-3{c}_{1}+5{c}_{2} & \\,⟹\\,[T({b}_{1})]_{C}=\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix} \\\\ T({b}_{2})={c}_{2}-2{c}_{1} & \\,⟹\\,[T({b}_{2})]_{C}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix} \\\\ T({b}_{3})={c}_{1}+5{c}_{2} & \\,⟹\\,[T({b}_{3})]_{C}=\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ is the matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2)$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{C}\\mathbin{:}$\n\n![](images/9c/9c62d029595cc269463dcd6fc6ee0d510cb98379823b25c181906a9d3c31085c.svg)"} :knowledge-point/id #uuid "a7f1e542-f0a2-54ea-ba7f-0a9928415907" :knowledge-point/questions [{:db/id #edb/ref 17592186125127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b88ee40-c93b-5e90-9712-910c5ae65334" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}-2 & 1 \\\\ 4 & 3 \\\\ -2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186324076} {:answer/id #uuid "59648977-c1e1-5065-bf72-bfe47947f84a" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}1 & -2 \\\\ 3 & 4 \\\\ -7 & -2\\end{bmatrix}" :db/id #edb/ref 17592186324712} {:answer/id #uuid "9310be99-07fd-50f3-a668-35fec4c0883f" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}-2 & 4 & -2 \\\\ 1 & 3 & -7\\end{bmatrix}" :db/id #edb/ref 17592186325219} {:answer/id #uuid "9966e12b-69b1-5f54-aa39-02d1e847d2ab" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}1 & 4 & -7 \\\\ -2 & 3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186325277} {:answer/id #uuid "b68bf65b-b463-5f61-b480-7522c9574d25" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}1 & -2 \\\\ 4 & 3 \\\\ -2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186325539}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}-2 & 1 \\\\ 4 & 3 \\\\ -2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186324076} :answer-field/id #uuid "831d25e1-0cdb-590f-b339-d424d5e34066" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326457}] :question/id #uuid "a7a7dfc1-b352-5fd9-84db-53ec5b318168" :question/math-academy-id "q-38529" :question/problem "Suppose $T:V\\to W$ is a linear map and $B={{b}_{1},{b}_{2}}$ and $C={{c}_{1},{c}_{2},{c}_{3}}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$\\,$ $T({b}_{1})=-2{c}_{1}+4{c}_{2}-2{c}_{3}\\,$ and $\\,T({b}_{2})=3{c}_{2}-7{c}_{3}+{c}_{1}.$" :question/worked-solution "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=-2{c}_{1}+4{c}_{2}-2{c}_{3} & \\,⟹\\,[T({b}_{1})]_{C}=\\begin{bmatrix}-2 \\\\ 4 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2})=3{c}_{2}-7{c}_{3}+{c}_{1} & \\,⟹\\,[T({b}_{2})]_{C}=\\begin{bmatrix}1 \\\\ 3 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and  $T({b}_{2})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=\\begin{bmatrix}-2 & 1 \\\\ 4 & 3 \\\\ -2 & -7\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186125128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6189de1e-59ce-5de6-a4ea-9870fd4b1245" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}6 & 4 & 0 \\\\ -5 & 7 & -2\\end{bmatrix}" :db/id #edb/ref 17592186324786} {:answer/id #uuid "6f31d61b-20e3-5d62-ad04-d1662e373991" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}-5 & 6 \\\\ 4 & 7 \\\\ -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186324884} {:answer/id #uuid "c41be21e-94f0-5f5f-a8ca-a7a32fe61856" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}6 & -5 \\\\ 4 & 7 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186325657} {:answer/id #uuid "c52a5637-73a5-5229-a99e-77244530b23d" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}7 & -2 & -5 \\\\ 4 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186325671} {:answer/id #uuid "cf6ee70a-3b5f-5dd8-ba07-f2ce5d3aa900" :answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}-5 & 7 & 0 \\\\ 6 & 4 & -2\\end{bmatrix}" :db/id #edb/ref 17592186325774}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[T]_{B|C}=\\begin{bmatrix}6 & 4 & 0 \\\\ -5 & 7 & -2\\end{bmatrix}" :db/id #edb/ref 17592186324786} :answer-field/id #uu