egin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ -(-5) & -6\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ 5 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix}\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {A}^{-1}A & =\\begin{bmatrix}2/3 & -1 \\\\ 5/3 & -2\\end{bmatrix}\\begin{bmatrix}-6 & 3 \\\\ -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f66079f-8a13-5f2d-b31c-0226934fa120" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186295881}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186295881} :answer-field/id #uuid "2471fbb6-4020-556f-a24a-22a1c2f5e2a0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296698} {:answer-field/choices [{:answer/id #uuid "0e7b5b59-0ba4-5602-87fc-1603751e6151" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295353}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295353} :answer-field/id #uuid "7d537624-30b3-5cb7-b8f0-e8594a47571a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296889} {:answer-field/choices [{:answer/id #uuid "64863451-c3cd-5629-ac5b-993b0bd3afb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186295839}] :answer-f