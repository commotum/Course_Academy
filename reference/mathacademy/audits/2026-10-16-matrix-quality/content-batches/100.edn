{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{4}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{8}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{8}\\begin{bmatrix}-1 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{8}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d429bc69-c341-5a48-9804-58abbc0fd361" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388540} {:answer/id #uuid "cd2b9dd8-a0a6-54ff-bad0-f2b924848fee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388541} {:answer/id #uuid "458b76cb-2abb-5fc3-a5a9-245ea3e66854" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388542} {:answer/id #uuid "995e3bea-2562-5ab5-b1cc-c0d23ed28382" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}" :db/id #edb/ref 17592186388543} {:answer/id #uuid "05ff9060-6856-5584-a21f-f5fc9a61e407" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388544}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388540} :answer-field/id #uuid "f696834e-14d7-57d4-8ca7-b243c8ebb58c" :answer-field/key "selection" :answer-field/type {:db/ident :