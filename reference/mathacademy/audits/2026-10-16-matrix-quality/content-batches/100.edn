t {:db/id #edb/ref 17592186388566 :question/id #uuid "4e5b5ecc-a097-5151-8920-89607e5df059"} :step/id #uuid "eb3412d5-16df-507f-9b06-15b54daa4c47"}] :activity/title "Singular Value Decomposition and the Pseudoinverse Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186444698} {:activity/first-step {:db/id #edb/ref 17592186511662} :activity/id #uuid "b5254e07-5277-5044-88b8-8db457aafdb3" :activity/steps [{:db/id #edb/ref 17592186511591 :step/content {:db/id #edb/ref 17592186511514 :question/id #uuid "80fca04e-db43-5719-819a-d2aec209a00e"} :step/id #uuid "16a6c242-af22-5cb6-bbb9-21913b53eaae" :step/next {:db/id #edb/ref 17592186511665}} {:db/id #edb/ref 17592186511594 :step/content {:db/id #edb/ref 17592186388559 :question/id #uuid "ccd15e93-fc94-54ae-b632-ce7df7380590"} :step/id #uuid "1ad8e3aa-2544-535a-b8c8-09ae28fba811"} {:db/id #edb/ref 17592186511595 :step/content {:db/id #edb/ref 17592186388545 :question/id #uuid "5dda960b-69e5-5ef3-bb01-a043422ae94b"} :step/id #uuid "1e7c14bb-006e-5e34-b55c-ef232ee8999e" :step/next {:db/id #edb/ref 17592186511591}} {:db/id #edb/ref 17592186511662 :step/content {:db/id #edb/ref 17592186371790 :question/id #uuid "acee5e61-29a9-5109-9401-92b3f77d7707"} :step/id #uuid "cdba1b8c-84f0-595a-bbc8-675a1ff04aff" :step/next {:db/id #edb/ref 17592186511595}} {:db/id #edb/ref 17592186511665 :step/content {:db/id #edb/ref 17592186511568 :question/id #uuid "e15227a9-4593-50e7-a6e9-0ebad0f88648"} :step/id #uuid "d166b145-57b4-5cbe-9caf-70939c1de8e3" :step/next {:db/id #edb/ref 17592186511594}}] :activity/title "Singular Value Decomposition and the Pseudoinverse Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186510765} {:activity/first-step {:db/id #edb/ref 17592186536037} :activity/id #uuid "4651fdb1-dd40-53d3-b305-e10d5b0654f3" :activity/steps [{:db/id #edb/ref 17592186536020 :step/content {:db/id #edb/ref 17592186420791 :question/id #uuid "a18b0561-3c55-5481-a95c-144e99d62fb8"} :step/id #uuid "4eba4deb-ed0f-515b-a345-779312604459" :step/next {:db/id #edb/ref 17592186536039}} {:db/id #edb/ref 17592186536022 :step/content {:db/id #edb/ref 17592186162348 :question/id #uuid "e9a9aba1-e21b-5ed5-95bf-a323e7389c16"} :step/id #uuid "591850ba-9970-5a8d-bf3a-764546c77c4d" :step/next {:db/id #edb/ref 17592186536024}} {:db/id #edb/ref 17592186536024 :step/content {:db/id #edb/ref 17592186371790 :question/id #uuid "acee5e61-29a9-5109-9401-92b3f77d7707"} :step/id #uuid "669edee2-ccb2-50da-8e3b-99ebbeee39b7" :step/next {:db/id #edb/ref 17592186536020}} {:db/id #edb/ref 17592186536037 :step/content {:db/id #edb/ref 17592186162345 :question/id #uuid "44a4660e-d3b5-5880-9cf8-ce9a4c5ec070"} :step/id #uuid "a5943526-8e3d-5a79-a06b-26f442d59590" :step/next {:db/id #edb/ref 17592186536022}} {:db/id #edb/ref 17592186536039 :step/content {:db/id #edb/ref 17592186420792 :question/id #uuid "f2315875-6b0f-5492-8e9e-75741c68b770"} :step/id #uuid "ac1e0a61-7b66-5421-b09e-c861aaca5832"}] :activity/title "Singular Value Decomposition and the Pseudoinverse Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186535430}] :db/id #edb/ref 17592186049503 :topic/knowledge-points [{:db/id #edb/ref 17592186162089 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161902 :question/id #uuid "e0a12130-2908-58fd-a8e0-91083fa30e96" :question/math-academy-id "e-9828" :question/problem "![](images/39/399738d7c4da59c73c954cfd41d8c76fc93ad0351fc8f2854ad33796aa2379df.svg)\nConsider the matrices shown above. Given that $A=U \\Sigma V^T$ is a singular value decomposition of $A,$ find the pseudoinverse $A^+.$" :question/worked-solution "If $A=U \\Sigma V ^T$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV \\, \\Sigma^+ \\, U^T,\n$$\n\nwhere $\\Sigma^+$ is the pseudoinverse of $\\Sigma.$ \n\nFirst, notice that\n\n![](images/f6/f6703dcf594334ec5ab821bbaac5654de5e3970b0e7981f256a8fd00df31060f.svg)\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 3 & 0 \\\\ -3 & 4 & 0 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}4 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e82e8b16-51a8-59c8-9ed1-51619335de97" :knowledge-point/questions [{:db/id #edb/ref 17592186162344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065fffc8-3e59-5969-929b-5087533bf93f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432586} {:answer/id #uuid "39695dbd-9cb4-567f-a279-8277626c4d7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}\\begin{bmatrix}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432588} {:answer/id #uuid "597aa326-f1e8-5701-9c20-5031aee7b048" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432590} {:answer/id #uuid "fcd31e64-a634-576e-a8e8-c7e2bca6ed34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-2 & 1 \\\\ 4 & -2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432594} {:answer/id #uuid "ffb3d5ad-4c33-5033-8c68-0522a4f523a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-2 & 4 & 0 \\\\ 1 & -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432595}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186432586} :answer-field/id #uuid "821729eb-93c4-5d09-9aa0-cfa962c2ddca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159266}] :question/id #uuid "989a4485-e5eb-5b78-be60-afb9e4f1a969" :question/math-academy-id "q-136972" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}} \\\\ 0 & 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}-1 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 2 & 0 \\\\ 0 & 0 & \\sqrt{5} \\\\ 2 & 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 4 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186162345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b31a3213-6d62-5519-ac95-346c2bef5b5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388494} {:answer/id #uuid "f79a1708-92c0-594d-97af-70797d07c647" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}-4 & 4 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388495} {:answer/id #uuid "22e67faa-26c8-5a3f-8ac2-2e70e7163f7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388496} {:answer/id #uuid "e40c9722-c036-5e6f-b81f-4c1388f000ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}-3 & 4 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186388497} {:answer/id #uuid "0f190784-d3ea-5b28-a3a5-404a8ae0d16b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388498}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388496} :answer-field/id #uuid "053ac9c2-65bd-5970-b100-18b05cb5c7be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388493}] :question/id #uuid "44a4660e-d3b5-5880-9cf8-ce9a4c5ec070" :question/math-academy-id "q-136973" :question/problem "$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,Σ=\\begin{bmatrix}5\\sqrt{2} & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{3}{5} & \\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix},\\,{Σ}^{+}=\\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,{U}^{T}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\frac{1}{5\\sqrt{2}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 4 \\\\ 4 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}-3 & 0 \\\\ 4 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{50}\\begin{bmatrix}3 & -3 \\\\ -4 & 4\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186371783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a66a064-024a-502e-9b04-347d649103a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371785} {:answer/id #uuid "9647bbdf-fcf2-5bad-a3b3-3e9694fc3084" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186371786} {:answer/id #uuid "2921dae6-65