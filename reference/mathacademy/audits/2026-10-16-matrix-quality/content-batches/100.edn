.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\frac{1}{2\\sqrt{10}}\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 0 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{20}\\begin{bmatrix}2 & 2 \\\\ 1 & 1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186371790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b4a3be8-df10-5faf-b317-36ff32669597" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}-1 & 1 \\\\ -3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371792} {:answer/id #uuid "d3753217-52ac-503e-a3b9-b9c996fbce84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371793} {:answer/id #uuid "57f72ceb-0f4d-5765-9c5f-222b4acb12bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & -1 \\\\ 3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186371794} {:answer/id #uuid "aa40830a-cf56-5825-8289-12a0609ab711" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\begin{bmatrix}1 & 2 \\\\ 3 & 6\\end{bmatrix}" :db/id #edb/ref 17592186371795} {:answer/id #uuid "1626cc32-b3e1-51e6-9c3b-cf5ddc6a9040" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\begin{bmatrix}1 & 1 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186371796}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186371793} :