 :db/id #edb/ref 17592186298176}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186298176} :answer-field/id #uuid "588ee9fc-b1ad-590a-902a-aa67ff051060" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298940} {:answer-field/choices [{:answer/id #uuid "4e235848-7d84-5c03-8f30-0fd2297b7d8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186297879}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186297879} :answer-field/id #uuid "98cadb3e-fd34-5d08-9dd7-982a5a1572bf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299143} {:answer-field/choices [{:answer/id #uuid "a55fb1b2-3b16-5c94-9d74-cc1c7a144fb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186298278}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186298278} :answer-field/id #uuid "e519f8fb-61e9-5c0d-a5e4-7091ce4b87b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299411}] :question/id #uuid "2eafafcb-8727-5ab6-b75d-030156359000" :question/math-academy-id "q-316780" :question/problem "Calculate ${A}^{-1},$ where\n$A=\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}.$\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| ${A}^{-1}=\\,\\,$ |  |  |  |  |\n|  |  | {{field-3}} | $-\\frac{1}{2}$ |  |" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nA=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $A$ can be found using the following formula:\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(A)=6\\cdot 1-2\\cdot 9=-12\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{-12}\\begin{bmatrix}1 & -2 \\\\ -9 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}A{A}^{-1} & =\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix}\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {A}^{-1}A & =\\begin{bmatrix}-1/12 & 1/6 \\\\ 3/4 & -1/2\\end{bmatrix}\\begin{bmatrix}6 & 2 \\\\ 9 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8bcb10-ac3e-55b6-b031-7dbf74e239f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}-7 & 3 \\\\ 8 & -4\\end{bmatrix}" :db/id #edb/ref 17592186345737} {:answer/id #uuid "59fd8952-62da-5a67-b9f7-07fe0e852847" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix}" :db/id #edb/ref 17592186346119} {:answer/id #uuid "d49fb2b3-f414-5e50-a37a-0e6179c2bd77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix}" :db/id #edb/ref 17592186347218} {:answer/id #uuid "ed42e7fe-6e5f-52f5-bd0b-40cd218c7c42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}-7 & 8 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186347444} {:answer/id #uuid "f42a5c98-7204-58b2-97fa-48ee5b75bef4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}7 & 3 \\\\ 8 & 4\\end{bmatrix}" :db/id #edb/ref 17592186347516}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix}" :db/id #edb/ref 17592186347218} :answer-field/id #uuid "259e0501-a96f-5581-b7ba-bcbbab78467e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347668}] :question/id #uuid "d05fea71-6716-5388-8215-29b86b42d217" :question/math-academy-id "q-7921" :question/problem "Calculate ${E}^{-1}$, where\n$E=\\begin{bmatrix}4 & 3 \\\\ 8 & 7\\end{bmatrix}.$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nE=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $E$ can be found using the following formula:\n\n$$\n\\begin{aligned}{E}^{-1} & =\\frac{1}{det(E)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(E)=4\\cdot 7-8\\cdot 3=4\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{E}^{-1} & =\\frac{1}{det(E)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}E{E}^{-1} & =\\begin{bmatrix}4 & 3 \\\\ 8 & 7\\end{bmatrix}\\cdot \\frac{1}{4}\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {E}^{-1}E & =\\frac{1}{4}\\begin{bmatrix}7 & -3 \\\\ -8 & 4\\end{bmatrix}\\begin{bmatrix}4 & 3 \\\\ 8 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186395938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "306a57a1-c90d-5377-92c1-ce8a4090bf78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395940} {:answer/id #uuid "8bcb109b-8e0c-537f-97bd-617cfaf0f544" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186395941} {:answer/id #uuid "f263605b-a3cd-5db3-ab7d-ef1aab9f3dff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395942} {:answer/id #uuid "236f7032-923a-5882-b067-96dd10890441" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\begin{bmatrix}2 & 1 \\\\ 5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186395943} {:answer/id #uuid "8b77ea03-f99e-5649-8358-600824460ebc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395944}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}" :db/id #edb/ref 17592186395942} :answer-field/id #uuid "aedcf9db-ed57-5dd9-8b52-eb742bee0864" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395939}] :question/id #uuid "e922303e-f1e5-5b8d-b2da-04cdac58e3ea" :question/math-academy-id "q-7945" :question/problem "Calculate ${Q}^{-1}$, where\n$Q=\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix}.$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nQ=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $Q$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Q)=(-3)\\cdot (-2)-5\\cdot 1=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{1}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Q{Q}^{-1} & =\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix}\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {Q}^{-1}Q & =\\begin{bmatrix}-2 & -1 \\\\ -5 & -3\\end{bmatrix}\\begin{bmatrix}-3 & 1 \\\\ 5 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bce01ee3-e62d-5dbf-8ab7-ab7ffd839257" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\begin{bmatrix}-2 & 8 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186398335} {:answer/id #uuid "cb1c7834-02fe-5c78-b2fe-aa883eb34976" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\begin{bmatrix}8 & 2 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398336} {:answer/id #uuid "c2e1ebaa-2f3e-5015-b022-3d3df282249e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\begin{bmatrix}8 & 2 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398337} {:answer/id #uuid "717243f7-02ac-50c5-9655-63bba2b18b42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-1 & 2 \\\\ 3 & 8\\end{bmatrix}" :db/id #edb/ref 17592186398338} {:answer/id #uuid "fcfc218d-9756-5117-a5b1-a400cbe24097" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398339}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186398339} :answer-field/id #uuid "16d27f97-4329-5b65-b357-06a7d75d56ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398334}] :question/id #uuid "9fd0e8ab-5ed1-5462-b099-07b3173547c9" :question/math-academy-id "q-127736" :question/problem "Calculate ${Z}^{-1}$ where\n$Z=\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix}.$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nZ=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $Z$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Z)=1\\cdot 8-3\\cdot 2=2\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Z{Z}^{-1} & =\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {Z}^{-1}Z & =\\frac{1}{2}\\begin{bmatrix}8 & -2 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7ce0b9-8bef-5a30-a632-26629274772f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & 3 \\\\ 5 & 7\\end{bmatrix}" :db/id #edb/ref 17592186398342} {:answer/id #uuid "a1e85deb-4ee7-5dd1-83b9-549af07b1b5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186398343} {:answer/id #uuid "506981c3-b1de-57d9-8bb9-05dbc5caad2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}-2 & -3 \\\\ 5 & 7\\end{bmatrix}" :db/id #edb/ref 17592186398344} {:answer/id #uuid "c55c053c-99f7-578e-a9b7-2928fc100ac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186398345} {:answer/id #uuid "da2f7c91-660d-5f24-88f0-96190a785249" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186398346}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}" :db/id #edb/ref 17592186398345} :answer-field/id #uuid "194044ba-41ba-5420-975a-652d3ae5b598" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398341}] :question/id #uuid "e9cf7ac8-28c7-510c-8205-256a03a04ef2" :question/math-academy-id "q-127737" :question/problem "Calculate ${U}^{-1}$, where \n$U=\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix}.$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nU=\\begin{bmatrix}a & b \\\\ c & d\\end{bmatrix},\n$$\n\nthe inverse of $U$ can be found using the following formula:\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix}.\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(U)=-2\\cdot 7-(-5)\\cdot 3=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}\\begin{bmatrix}d & -b \\\\ -c & a\\end{bmatrix} \\\\  & =\\frac{1}{1}\\begin{bmatrix}7 & -3 \\\\ -(-5) & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}U{U}^{-1} & =\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓ \\\\ {U}^{-1}U & =\\begin{bmatrix}7 & -3 \\\\ 5 & -2\\end{bmatrix}\\begin{bmatrix}-2 & 3 \\\\ -5 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Inverse of a 2x2 Matrix"} {:db/id #edb/ref 17592186087702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087509 :question/id #uuid "195d7dab-edf2-536b-a7b7-d1c16c7b1071" :question/math-academy-id "e-4503" :question/problem "Which of the matrices below are singular?\n\n$$\n\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}\n$$" :question/worked-solution "- For the matrix $A$, we have\n\n$$\n\\det({A})=1 \\cdot 1 - 1 \\cdot 1 = 0.\n$$\n\nBecause $\\det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $3 \\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\n\\det({C})=3 \\cdot 3 - (-3) \\cdot 3 = 18.\n$$\n\nBecause $\\det(C) \\neq 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular."} :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/questions [{:db/id #edb/ref 17592186087989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6b2951-5fda-53c8-896a-8bde83921b7d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459437} {:answer/id #uuid "c82dca82-40a1-54e5-8fe2-071a3a53d264" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459438}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459437} :answer-field/id #uuid "8c97d18a-669f-55a0-ae63-6af35a70edb2" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460585} {:answer-field/choices [{:answer/id #uuid "6411512f-7951-596a-b5a9-6237363cf23b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459439} {:answer/id #uuid "b589497c-aaa2-56ee-9385-1f32f8cc20e5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459440}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459439} :answer-field/id #uuid "7db0dbb8-05ee-56da-a79d-d8bf4fa9497d" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460586} {:answer-field/choices [{:answer/id #uuid "eb6ed13f-8fd7-53ba-8290-837d992b005f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459441} {:answer/id #uuid "da8baa64-f2af-5f17-8355-f4e19addbcd5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459442}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459442} :answer-field/id #uuid "0b3bde15-dda9-5eec-8013-c3084007af6f" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460587}] :question/id #uuid "dd3fba16-5fcc-50bc-8866-44ee67a3b9b6" :question/math-academy-id "q-11718" :question/problem "Which of the matrices below are singular?\n\n$$\nA=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=0\\cdot 0-1\\cdot 1=-1.\n$$\n\nBecause $det(A)\\ne 0,$ we conclude that $A$ is invertible.\n\n- The matrix $B$ is a $3\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible. Since $C$ is a square matrix that is not invertible, we also say that $C$ is singular.\n\nTherefore, only $C$ is singular."} {:db/id #edb/ref 17592186087993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c0a8452-772e-5183-968e-5081778d81a7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459443} {:answer/id #uuid "16964185-0fa1-5c40-ba30-02add50a42e2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459444}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459444} :answer-field/id #uuid "1d7d1630-9e25-5340-bd4c-d1503c868d24" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460588} {:answer-field/choices [{:answer/id #uuid "c49f134d-b275-58ab-85af-ec9fd2b5885b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459445} {:answer/id #uuid "e352c568-e812-5e17-b65a-6e55c2065821" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459446}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459446} :answer-field/id #uuid "91e63b07-cfa6-51d4-9446-17be269137d3" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460589} {:answer-field/choices [{:answer/id #uuid "5cd74d9f-29c9-5af3-86e7-5d73dd7bfffd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459447} {:answer/id #uuid "20983efb-be24-5fea-9f77-4785c48e9e97" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459448}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459447} :answer-field/id #uuid "18e9fed9-651b-5bfd-9db4-7ea966e44fd6" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460590}] :question/id #uuid "d6fdbc09-a579-52c0-b98c-5f14a5229abc" :question/math-academy-id "q-11725" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=\\begin{bmatrix}1 & 5 & 0 \\\\ -1 & 1 & -1\\end{bmatrix},\\,B=\\begin{bmatrix}6 & 8 \\\\ 3 & 4\\end{bmatrix},\\,C=\\begin{bmatrix}-1 & 1 \\\\ 5 & 5\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "- The matrix $A$ is a $2\\times 3$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=6\\cdot 4-8\\cdot 3=0.\n$$\n\nBecause $det(B)=0,$ we conclude that $B$ is not invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=(-1)\\cdot 5-1\\cdot 5=-10.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ and $B$ do not have an inverse."} {:db/id #edb/ref 17592186253311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3458a089-3888-542e-968d-c9518a04e88d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461815} {:answer/id #uuid "50778f05-ddf5-582c-8db9-cc7782d783f9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461816}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461816} :answer-field/id #uuid "6eca055b-5464-5837-a901-254ea6c3a13c" :answer-field/key "H" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462661} {:answer-field/choices [{:answer/id #uuid "0abc8f03-a6b8-5309-9492-8dc139b5f6cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461817} {:answer/id #uuid "9c816193-4544-54b9-b7d7-6c9d022fe5bf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461818}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461818} :answer-field/id #uuid "2cf477f3-ea09-51a1-9a9b-7b55b2cadfda" :answer-field/key "J" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462662} {:answer-field/choices [{:answer/id #uuid "73ab26a4-2324-5b3c-8149-15706d53927d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461819} {:answer/id #uuid "f92a8eac-48f4-5940-81c5-cfc73dbdf656" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461820}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461819} :answer-field/id #uuid "9d8dc630-97cd-5342-89aa-58a8996e2070" :answer-field/key "K" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462663}] :question/id #uuid "87ca815d-8c8d-5ffa-9415-2a57d9bd87a2" :question/math-academy-id "q-11717" :question/problem "Which of the matrices below are singular?\n\n$$\nH=\\begin{bmatrix}5 & 0 \\\\ 3 & 0\\end{bmatrix},\\,J=\\begin{bmatrix}2 & 4 \\\\ 3 & 6\\end{bmatrix},\\,K=\\begin{bmatrix}1 & 4 \\\\ 0 & 5 \\\\ -3 & 0\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "- For the matrix $H$, we have\n\n$$\ndet(H)=5\\cdot 0-3\\cdot 0=0.\n$$\n\nBecause $det(H)=0,$ we conclude that $H$ is not invertible. Since $H$ is a square matrix that is not invertible, we also say that $H$ is singular.\n\n- For the matrix $J$, we have\n\n$$\ndet(J)=2\\cdot 6-3\\cdot 4=0.\n$$\n\nBecause $det(J)=0,$ we conclude that $J$ is not invertible. Since $J$ is a square matrix that is not invertible, we also say that $J$ is singular.\n\n- The matrix $K$ is a $3\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $H$ and $J$ is singular."} {:db/id #edb/ref 17592186262822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83031cf0-e568-5359-b7ee-f956035ef639" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463634} {:answer/id #uuid "e4cf2a4d-34df-5aca-961e-fc888997d1ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463635}] :answer-f