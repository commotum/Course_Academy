}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}8 & 9 \\\\ 4 & 5\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 8-9\\cdot 4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}5 & -9 \\\\ -4 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=\\frac{5}{4}+(-\\frac{9}{4})+2=1.\n$$"} {:db/id #edb/ref 17592186259634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4892ddc7-1f21-5fb6-9203-29d772bde8dd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257419} {:answer/id #uuid "92a426f4-8720-57e6-a1e8-ad581c1828da" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186258075} {:answer/id #uuid "9f843863-e410-57ac-ad2a-c4d41c982c3c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258183} {:answer/id #uuid "a1613b31-d49f-5ba6-a356-2221335e1c8f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186258196} {:answer/id #uuid "b9fab22d-ecf7-5ea8-a60c-5286e5e43015" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258411}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258411} :answer-field/id #uuid "da74548d-3633-5796-b2bf-ea07c5e41132" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259414}] :question/id #uuid "8b41b10b-145c-5e96-a5f6-3186f40b3311" :question/math-academy-id "q-124244" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & 5 \\\\ b & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}c \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}-2 & 5 \\\\ -1 & 3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-2)-5\\cdot (-1)}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}3 & -5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}6 \\\\ 2\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}6 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-8 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-3+(-1)+8=4.\n$$"} {:db/id #edb/ref 17592186378511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f72881c3-753e-5b95-85bc-02adf0a4b6ac" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186378513} {:answer/id #uuid "10e6c944-c91f-5601-afd3-1264cce42262" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186378514} {:answer/id #uuid "0c1ae003-dccd-5309-a927-aa8062a16789" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186378515} {:answer/id #uuid "6cff2f36-4d4d-5658-b4ec-57ea83760e2f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378516} {:answer/id #uuid "850aab39-a558-52d2-9840-bfe63e357aba" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186378517}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186378513} :answer-field/id #uuid "9a66050a-14bd-575f-8ade-240f74a63651" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378512}] :question/id #uuid "1eec2757-8c74-5907-98ae-2f84f566443e" :question/math-academy-id "q-124225" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-1 & a \\\\ b & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}c \\\\ -3\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-1\\cdot 1-6\\cdot 0}\\begin{bmatrix}1 & 6 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}1 & 6 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-9 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}9 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-6+0+9=3.\n$$"} {:db/id #edb/ref 17592186378518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576fa355-b0ad-5f7f-82ea-214602f10a74" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186378520} {:answer/id #uuid "1ec474e3-c103-5511-800f-b72719bab6a5" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186378521} {:answer/id #uuid "38e1ed23-aab7-59b2-9b00-a16962ce3dd6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186378522} {:answer/id #uuid "446ee2f7-fb2c-5f38-8440-e65e54aee38f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186378523} {:answer/id #uuid "820e4682-aac4-5441-8db0-af73fa38dda7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186378524}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186378521} :answer-field/id #uuid "318602de-98f7-5667-b748-7034fc29a160" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378519}] :question/id #uuid "28f90c96-f9c7-5e28-9523-e654be1b91fd" :question/math-academy-id "q-124227" :question/problem "The matrix form of the affine transformation $T$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 5 & 9\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}.\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}a & 2 \\\\ b & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}10 \\\\ c\\end{bmatrix}.\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{\\begin{bmatrix}1 & 2 \\\\ 5 & 9\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{9\\cdot 1-2\\cdot 5}\\begin{bmatrix}9 & -2 \\\\ -5 & 1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}9 & -2 \\\\ -5 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}-10 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & 2 \\\\ 5 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}+\\begin{bmatrix}10 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-9+5+(-6)=-10.\n$$"}] :knowledge-point/title "Inverting Affine Transformations Given in Matrix Form"} {:db/id #edb/ref 17592186179772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179433 :question/id #uuid "c5e70edd-5a39-5e85-9461-68df182780dc" :question/math-academy-id "e-12430" :question/problem "The affine transformation $\\mathbf T$ is defined as\n\n$$\nx = u - v + 2, \\qquad y = 4u - 5v + 9.\n$$\n\nGiven that the inverse transformation $\\mathbf T^{-1}$ of $\\mathbf T$ is\n\n$$\nu = \\bbox[Gainsboro,2pt]{a}x - y + \\bbox[Gainsboro,2pt]{b}, \\qquad v = \\bbox[Gainsboro,2pt]{c}x - y + 1,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is a function of the form\n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $\\mathbf{T},$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-v+2 \\\\ 4u-5v+9\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-v \\\\ 4u-5v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}1 & -1 \\\\ 4 & -5\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A{:}$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot (-5)-(-1)\\cdot 4}\\begin{bmatrix}-5 & 1 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}-5 & 1 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -1 \\\\ 4 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the inverse transformation $\\mathbf{T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}5 & -1 \\\\ 4 & -1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}5 & -1 \\\\ 4 & -1\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y-9\\end{bmatrix} \\\\  & =\\begin{bmatrix}5\\cdot (x-2)+(-1)\\cdot (y-9) \\\\ 4\\cdot (x-2)+(-1)\\cdot (y-9)\\end{bmatrix} \\\\  & =\\begin{bmatrix}5x-y-1 \\\\ 4x-y+1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation $\\mathbf{T}^{-1}$ in coordinate form is\n\n$$\nu = \\bbox[Gainsboro,2pt]{5}x - y + \\bbox[Gainsboro,2pt]{(-1)}, \\qquad v = \\bbox[Gainsboro,2pt]{4}x - y + 1.\n$$\n\nTherefore, we have\n\n$$\na+b+c = 5 + (-1) + 4 = 8.\n$$"} :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/questions [{:db/id #edb/ref 17592186179994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac22d07-8691-5c44-b67c-6e7865e43fad" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257010} {:answer/id #uuid "58760954-b904-5a73-913c-5b1ad756061e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257549} {:answer/id #uuid "d3dfb1cf-950e-500f-b4be-1f7247af446b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258637} {:answer/id #uuid "e472c312-5cda-551e-a503-6a75203866c9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258765} {:answer/id #uuid "f41b1866-8645-52ac-9a51-a0de9e882a2e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258914}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257549} :answer-field/id #uuid "92c9361f-adde-5033-b3b8-4704fce8ce3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259289}] :question/id #uuid "167f2fd7-c35e-5f43-aff5-1c9b26e281cd" :question/math-academy-id "q-124114" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=u+v,\\,y=u+2v+1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-y+1,\\,v=by-x+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u+v \\\\ u+2v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+v \\\\ u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}1 & 1 \\\\ 1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-1\\cdot 1}\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & -1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot x+(-1)\\cdot (y-1) \\\\ (-1)\\cdot x+1\\cdot (y-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-y+1 \\\\ y-x-1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-y+1,\\,v=1y-x+(-1).\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+1+(-1)=2.\n$$"} {:db/id #edb/ref 17592186180006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0182ba25-bcd8-55e5-8013-b828a9c5ff90" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186256797} {:answer/id #uuid "41a1d1dc-e244-506d-997b-bc89413597c2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257367} {:answer/id #uuid "571155db-6efb-5faa-9019-2ba1a26ba568" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257532} {:answer/id #uuid "6562caad-319d-55ce-9e80-60b39e3192cd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257674} {:answer/id #uuid "99e7d73f-33dd-564e-911c-9afcac829f5b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258135}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257674} :answer-field/id #uuid "8718cf9a-1f4f-5f95-be16-ddb1f9a82f54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259266}] :question/id #uuid "8d02964b-863a-50f8-a2b8-3e8d91aa0f8d" :question/math-academy-id "q-124317" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=5v-7u+3,\\,y=7v-10u+5.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-5y+4,\\,v=bx+cy+5,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}5v-7u+3 \\\\ 7v-10u+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u+5v \\\\ -10u+7v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 5\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-7 & 5 \\\\ -10 & 7\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot (-7)-5\\cdot (-10)}\\begin{bmatrix}7 & -5 \\\\ 10 & -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & -5 \\\\ 10 & -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}7 & -5 \\\\ 10 & -7\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}7 & -5 \\\\ 10 & -7\\end{bmatrix}\\begin{bmatrix}x-3 \\\\ y-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}7\\cdot (x-3)+(-5)\\cdot (y-5) \\\\ 10\\cdot (x-3)+(-7)\\cdot (y-5)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7x-5y+4 \\\\ 10x-7y+5\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7x-5y+4,\\,v=10x+(-7)y+5.\n$$\n\nTherefore, we have\n\n$$\na+b+c=7+10+(-7)=10.\n$$"} {:db/id #edb/ref 17592186259647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5221f3d2-3945-59bf-8f2a-8074c4d35eac" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257481} {:answer/id #uuid "6335888e-8880-5dda-bb22-cb264ba5e045" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257656} {:answer/id #uuid "65be3f91-2307-5b7c-a45f-3cfedff40838" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257678} {:answer/id #uuid "90189be9-60a0-5430-b1cf-cb0e4429164f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258050} {:answer/id #uuid "cf076746-fa92-51fc-a391-045e00ab93d1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581} :answer-field/id #uuid "ddb82f61-7d4c-5474-a0b0-ba491f22517e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259422}] :question/id #uuid "4865ae47-4fd4-593e-a597-ec2a2d5aa88e" :question/math-academy-id "q-124276" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=4u+7v+2,\\,y=u+2v+1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-7y+3,\\,v=by+cx-2,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u+7v+2 \\\\ u+2v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u+7v \\\\ u+2v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}4 & 7 \\\\ 1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 4-7\\cdot 1}\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x-2)+(-7)\\cdot (y-1) \\\\ (-1)\\cdot (x-2)+4\\cdot (y-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-7y+3 \\\\ 4y-x-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-7y+3,\\,v=4y+(-1)x-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+4+(-1)=5.\n$$"} {:db/id #edb/ref 17592186259649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bed1340-8927-5ff0-ba69-b2b93cdd78e8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186256896} {:answer/id #uuid "81fb632e-14da-5038-b6f9-74ec0da963a5" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257937} {:answer/id #uuid "82d7f633-617d-5497-a90c-a0550510c2f6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257941} {:answer/id #uuid "d5507f11-f2dc-54ed-aa00-8c211067e5e5" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186258649} {:answer/id #uuid "e3817db8-3192-5a2c-ad51-eb7cb8e7b55c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258760}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186258649} :answer-field/id #uuid "fa29d767-9911-5a05-a828-3b3c81faca3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259473}] :question/id #uuid "f20eb077-8cae-5138-ae0e-248f60ff9fb8" :question/math-academy-id "q-124280" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2-u-v,\\,y=3u+4v-1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=7+ax-y,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2-u-v \\\\ 3u+4v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u-v \\\\ 3u+4v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-1 & -1 \\\\ 3 & 4\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 3}\\begin{bmatrix}4 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}4 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-4 & -1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\cdot (x-2)+(-1)\\cdot (y+1) \\\\ 3\\cdot (x-2)+1\\cdot (y+1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-4x-y \\\\ 3x+y-5\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7+(-4)x-y,\\,v=3x+y+(-5).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+3+(-5)=-6.\n$$"} {:db/id #edb/ref 17592186259651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04abb601-17e0-5fec-b990-97706ac5a596" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186256822} {:answer/id #uuid "20b7769d-6be5-53ae-a10f-0d9f4c90d0a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186257049} {:answer/id #uuid "525f19b0-d029-5095-845b-fc54069a98b8" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186257485} {:answer/id #uuid "6ffe1822-1c33-543b-8781-69059dae9e47" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186257765} {:answer/id #uuid "97f74daa-bcde-5c29-bc67-733be230ca01" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186258121}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186257049} :answer-field/id #uuid "a412914a-2d2e-597f-8fb0-48dccc9cd9de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259321}] :question/id #uuid "ab7706f1-5139-5e95-9482-c097bef51185" :question/math-academy-id "q-124282" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2u-v+1,\\,y=9u-4v+3.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=y-4x+a,\\,v=by+cx+3,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-v+1 \\\\ 9u-4v+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-v \\\\ 9u-4v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 3\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & -1 \\\\ 9 & -4\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-1)\\cdot 9}\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-4 & 1 \\\\ -9 & 2\\end{bmatrix}\\begin{bmatrix}x-1 \\\\ y-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\cdot (x-1)+1\\cdot (y-3) \\\\ -9\\cdot (x-1)+2\\cdot (y-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}y-4x+1 \\\\ 2y-9x+3\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=y-4x+1,\\,v=2y+(-9)x+3.\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+2+(-9)=-6.\n$$"} {:db/id #edb/ref 17592186259658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fdb495-a50d-59f6-b046-fe30fe635f8a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257108} {:answer/id #uuid "5f6236ee-e014-5f31-9c0b-507d1ed24205" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257619} {:answer/id #uuid "9ecc44db-c676-5cdc-839b-e110af343425" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258179} {:answer/id #uuid "abb5e142-fe8f-50af-abc0-38ee182fa294" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258279} {:answer/id #uuid "fe1dcd76-a73e-5df1-bf1a-c3586f41efe9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186259008}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257108} :answer-field/id #uuid "28a7e71e-201f-5d7e-a0e6-449ce37babeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259104}] :question/id #uuid "ffb6ce4d-ba43-5120-a804-c2465f94124d" :question/math-academy-id "q-124312" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v-4,\\,y=2u-4v-5.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+ay+b,\\,v=x-y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-3v-4 \\\\ 2u-4v-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-3v \\\\ 2u-4v\\end{bmatrix}+\\begin{bmatrix}-4 \\\\ -5\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & -3 \\\\ 2 & -4\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-4 \\\\ -5\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-3)\\cdot 2}\\begin{bmatrix}-4 & 3 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\frac{1}{-2}\\begin{bmatrix}-4 & 3 \\\\ -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}-4 \\\\ -5\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}x+4 \\\\ y+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x+4)+(-\\frac{3}{2})\\cdot (y+5) \\\\ 1\\cdot (x+4)+(-1)\\cdot (y+5)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-\\frac{3}{2}y+\\frac{1}{2} \\\\ x-y-1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+(-\\frac{3}{2})y+\\frac{1}{2},\\,v=x-y+(-1).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-\\frac{3}{2}+\\frac{1}{2}+(-1)=-2.\n$$"} {:db/id #edb/ref 17592186259659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23580040-99be-5f75-be43-adefd3cbfade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186257077} {:answer/id #uuid "58e9a951-d5aa-5d93-8ae3-c1349449a5e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186257554} {:answer/id #uuid "8cc83444-b44c-54bf-83b7-307d0775c0bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186258020} {:answer/id #uuid "b1de513c-2a81-54b9-9e95-c28eb012ca2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186258331} {:answer/id #uuid "f8c13e37-05bf-5042-b338-1fc4c401c1ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186258964}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186257077} :answer-field/id #uuid "c3cd215d-51f0-56ca-9929-c005182aeb03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259373}] :question/id #uuid "6d452c80-d748-5af8-bbed-4f41e3a6ab8b" :question/math-academy-id "q-124314" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v+2,\\,y=6v-3u-4.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+y+a,\\,v=x+by+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-3v+2 \\\\ 6v-3u-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-3v \\\\ -3u+6v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -4\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & -3 \\\\ -3 & 6\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-(-3)\\cdot (-3)}\\begin{bmatrix}6 & 3 \\\\ 3 & 2\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}6 & 3 \\\\ 3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x-2)+1\\cdot (y+4) \\\\ 1\\cdot (x-2)+(\\frac{2}{3})\\cdot (y+4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x+y \\\\ x+\\frac{2}{3}y+\\frac{2}{3}\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+0,\\,v=x+\\frac{2}{3}y+\\frac{2}{3}.\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+\\frac{2}{3}+\\frac{2}{3}=\\frac{4}{3}.\n$$"} {:db/id #edb/ref 17592186259660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e2f4802-202c-5744-af7c-a265e1282f29" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186257190} {:answer/id #uuid "6145b310-d9fa-5c70-bf9e-37a7eee79a20" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257636} {:answer/id #uuid "6565c78d-4700-5b5e-8fa6-fa3c4fceeb2b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257675} {:answer/id #uuid "7f7de5ee-ba45-55a9-a92f-e771483fbdc6" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257917} {:answer/id #uuid "a6c4affd-1411-548e-b075-bcc64b41f0e9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186258237}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186257190} :answer-field/id #uuid "c7ef3bd3-deb2-573a-a0a0-ddce62489c56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259379}] :question/id #uuid "2c660cc6-fa1c-504a-b604-d474fb35da3e" :question/math-academy-id "q-124315" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=5u-9v-2,\\,y=4u-8v+4.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-\\frac{9}{4}y+b,\\,v=cx-\\frac{5}{4}y+7.\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}5u-9v-2 \\\\ 4u-8v+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}5u-9v \\\\ 4u-8v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}5 & -9 \\\\ 4 & -8\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-8\\cdot 5-(-9)\\cdot 4}\\begin{bmatrix}-8 & 9 \\\\ -4 & 5\\end{bmatrix} \\\\  & =\\frac{1}{-4}\\begin{bmatrix}-8 & 9 \\\\ -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -\\frac{9}{4} \\\\ 1 & -\\frac{5}{4}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & -\\frac{9}{4} \\\\ 1 & -\\frac{5}{4}\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}-2 \\\\ 4\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & -\\frac{9}{4} \\\\ 1 & -\\frac{5}{4}\\end{bmatrix}\\begin{bmatrix}x+2 \\\\ y-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x+2)-\\frac{9}{4}\\cdot (y-4) \\\\ 1\\cdot (x+2)+(-\\frac{5}{4})\\cdot (y-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-\\frac{9}{4}y+13 \\\\ x-\\frac{5}{4}y+7\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-\\frac{9}{4}y+13,\\,v=1x-\\frac{5}{4}y+7.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+13+1=16.\n$$"} {:db/id #edb/ref 17592186259661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53738dbc-4b70-55ed-adf7-876b2058b1ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257496} {:answer/id #uuid "59ddb57a-f6cd-53ad-88c2-68b3cb86c6ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186257561} {:answer/id #uuid "856eab72-8ef0-5f0d-86b5-7524bd1dc449" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257959} {:answer/id #uuid "8aa25317-3d38-5f84-a8a8-e73117c3ec7a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258000} {:answer/id #uuid "a85c6f0e-2cad-59d6-b55d-141145779bd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186258252}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186257561} :answer-field/id #uuid "0766267b-b236-5b60-9642-8cc48300764d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259048}] :question/id #uuid "599d880d-d7f3-5208-a64f-d6b9b8d46ef7" :question/math-academy-id "q-124316" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=-2v-4,\\,y=u+4v+6.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+y+a,\\,v=bx+cy-2,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}-2v-4 \\\\ u+4v+6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2v \\\\ u+4v\\end{bmatrix}+\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}0 & -2 \\\\ 1 & 4\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 0-(-2)\\cdot 1}\\begin{bmatrix}4 & 2 \\\\ -1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}4 & 2 \\\\ -1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{bmatrix}\\begin{bmatrix}x+4 \\\\ y-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x+4)+1\\cdot (y-6) \\\\ (-\\frac{1}{2})\\cdot (x+4)+0\\cdot (y-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x+y+2 \\\\ -\\frac{1}{2}x-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+2,\\,v=(-\\frac{1}{2})x+0y-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+(-\\frac{1}{2})+0=\\frac{3}{2}.\n$$"} {:db/id #edb/ref 17592186378525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc6f2740-b844-5e3d-b3be-f2767c45c427" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186378527} {:answer/id #uuid "ae0d81d7-4701-5803-aae0-424af637d6ec" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186378528} {:answer/id #uuid "778b833e-4ab5-5368-a17f-72ef518e8b05" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186378529} {:answer/id #uuid "5c0bace7-9cd9-5586-b788-0291313bfdde" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186378530} {:answer/id #uuid "3f72a571-e32f-50f6-9a16-49ca88d08cac" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186378531}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186378528} :answer-field/id #uuid "f797fdf2-8ac4-5a95-89c0-632befddfd41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378526}] :question/id #uuid "b8dec679-ec12-5859-8ce2-b460329b6578" :question/math-academy-id "q-124286" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=3v-7u+7,\\,y=v-2u+3.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax+by-2,\\,v=-2x+7y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}3v-7u+7 \\\\ v-2u+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u+3v \\\\ -2u+v\\end{bmatrix}+\\begin{bmatrix}7 \\\\ 3\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-7 & 3 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot (-7)-3\\cdot (-2)}\\begin{bmatrix}1 & -3 \\\\ 2 & -7\\end{bmatrix} \\\\  & =\\frac{1}{-1}\\begin{bmatrix}1 & -3 \\\\ 2 & -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 3 \\\\ -2 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}-1 & 3 \\\\ -2 & 7\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}-1 & 3 \\\\ -2 & 7\\end{bmatrix}\\begin{bmatrix}x-7 \\\\ y-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1\\cdot (x-7)+3\\cdot (y-3) \\\\ -2\\cdot (x-7)+7\\cdot (y-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-x+3y-2 \\\\ -2x+7y-7\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=(-1)x+3y-2,\\,v=-2x+7y+(-7).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+3+(-7)=-5.\n$$"} {:db/id #edb/ref 17592186406969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f998697-e815-585e-b0b5-3820b9ab9a03" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186406958} {:answer/id #uuid "51054506-a98c-59d1-82db-eab8461f2cb2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186406959} {:answer/id #uuid "6c76efec-c230-59b8-bab5-b44500517e1e" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186406960} {:answer/id #uuid "80f4eee2-e47a-55c2-b5f0-e42eb70ff849" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186406962} {:answer/id #uuid "c3375fbb-f890-5cba-a4b4-7f53a73a78cb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186406963}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186406960} :answer-field/id #uuid "20065c9e-4427-527a-a708-a46b3d2f2065" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406966}] :question/id #uuid "e92cb69b-a679-593b-8882-9cab8d26a8fb" :question/math-academy-id "q-124289" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=u-v-1,\\,y=3v-2u-6.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax+y+9,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-v-1 \\\\ 3v-2u-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-v \\\\ -2u+3v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -6\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}1 & -1 \\\\ -2 & 3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 1-(-1)\\cdot (-2)}\\begin{bmatrix}3 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 1 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}3 & 1 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}3 & 1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}x+1 \\\\ y+6\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot (x+1)+1\\cdot (y+6) \\\\ 2\\cdot (x+1)+1\\cdot (y+6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3x+y+9 \\\\ 2x+y+8\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=3x+y+9,\\,v=2x+y+8.\n$$\n\nTherefore, we have\n\n$$\na+b+c=3+2+8=13.\n$$"}] :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"} {:db/id #edb/ref 17592186179775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179436 :question/id #uuid "98ebb2b6-475b-53c5-acae-0b1b0f0778d2" :question/math-academy-id "e-12441" :question/problem "![](images/87/8797a50ddc0750a97190f96d8bc1cffe70c6ef9cc8e55a46f5a75d6b6702c81d.png)\n\nConsider the affine transformation $\\mathbf T,$ given by\n![](images/34/347a44c388bd81e78d4dcf5f40584ce76273ffe25513ebb1522568ba479ac4fc.png) \nDescribe the image of the triangle shown above under the action of $\\mathbf{T}.$" :question/worked-solution "Recall that for any affine transformation \n\n$$\n\\mathbf{T}: \\mathbf{u} \\longrightarrow A \\mathbf{u} + \\mathbf{b},\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $\\mathbf u$ and $\\mathbf b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $\\mathbf{T}$ is non-singular, i.e., when $\\det(A) \\neq 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $\\mathbf{T}$ is singular, i.e., when $\\det(A) = 0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $\\mathbf{T}$ is \n![](images/94/94625329d7eba1da88a9dde36b6e64335a9801658a8c1fd054cea9db835ea4fa.png)\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}2 & 1 \\\\ 4 & 2\\end{aligned}| \\\\  & =2\\cdot 2-4\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $\\mathbf{T}$ is non-invertible and the image of the triangle under the action of $\\mathbf{T}$ is a line segment."} :knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4" :knowledge-point/questions [{:db/id #edb/ref 17592186180089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acc367e-71f3-5e97-87ce-92842c5b3257" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelepiped" :db/id #edb/ref 17592186278836} {:answer/id #uuid "3f4b22b4-65fa-5db1-94f1-780f0591f6e8" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186279153} {:answer/id #uuid "638bcae2-f573-5b91-97f0-f5ab7fc66eb9" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279497} {:answer/id #uuid "7e024141-a94e-5f97-ae2f-a04b85d857ef" :answer/type {:db/ident :answer.type/text} :answer/value "A point on the plane" :db/id #edb/ref 17592186279720} {:answer/id #uuid "a42ad425-777b-5f11-8db0-c06039f852ee" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186280049}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279497} :answer-field/id #uuid "2222be89-5b86-5d7e-873f-1d11313d8d91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280888}] :question/id #uuid "79161a5e-44bb-5845-8a74-564fa863b598" :question/math-academy-id "q-162151" :question/problem "![](images/3f/3f8c1c9854ec54dd3caf4487328d3f3c35f2d69680a8fd1c13d28125dac77d03.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2 & 6 \\\\ 1 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the square shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}-2 & 6 \\\\ 1 & -3\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}-2 & 6 \\\\ 1 & -3\\end{vmatrix} \\\\  & =(-2)\\cdot (-3)-6\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the square under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186180090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb9e4f8b-d0c4-5086-8596-91a0851e17e3" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186178210} {:answer/id #uuid "bda6418e-36dd-56f0-8b44-aeb05dbfffc9" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186178211} {:answer/id #uuid "c9a3fdca-1cad-5329-9369-93921013d411" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186178212} {:answer/id #uuid "60f3d54e-e77e-5c24-adbf-01a9a8a23c01" :answer/type {:db/ident :answer.type/text} :answer/value "A tetrahedron" :db/id #edb/ref 17592186178213} {:answer/id #uuid "654d91f7-864b-5c86-9bd6-ee865a9e141a" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186178214}] :answer-field/id #uuid "a4025ff7-15c7-55d7-9de9-9d98aea501e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178209}] :question/id #uuid "2a5baf7e-c7c5-5ee4-b2ff-f2b8dad11ff2" :question/math-academy-id "q-162152" :question/problem "![](images/d6/d6577c3cffc67af81d74407b51850184e725bd205f5930e8e73be6f96409a67c.png)\n\nConsider the affine transformation $T$, given by\n$x = 2u - v, y = u + 2v + 1$.\nWhat would be the image of the triangle shown above under the action of $T$?"} {:db/id #edb/ref 17592186281405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "086b2610-2023-519b-a8e8-91e8082fe456" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186278671} {:answer/id #uuid "0a885a75-ef44-5b04-a856-76c492be9fc1" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186278692} {:answer/id #uuid "1b430cc2-04e6-53e3-8792-e3477c685484" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186278844} {:answer/id #uuid "21f1b945-693e-5bf9-9e09-ed3b2d638d8e" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186278898} {:answer/id #uuid "79335a04-020e-533a-baf4-a95091808bee" :answer/type {:db/ident :answer.type/text} :answer/value "A cube" :db/id #edb/ref 17592186279674}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186278692} :answer-field/id #uuid "90e2fed4-7709-5047-b4b1-cf83d0815012" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281094}] :question/id #uuid "7aaa6c3c-ccc5-5e4c-bbad-d399e1496037" :question/math-academy-id "q-162196" :question/problem "![](images/57/576d60f179b56159504efc59178ada3db798046d01a7dbc92986cd1162f770ea.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=u+2v+1,\\,y=2u+v-1.\n$$\n\nWhat would be the image of the square shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u+2v+1 \\\\ 2u+v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+2v \\\\ 2u+v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}1 & 2 \\\\ 2 & 1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}1 & 2 \\\\ 2 & 1\\end{vmatrix} \\\\  & =1\\cdot 1-2\\cdot 2 \\\\  & =-3 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible and the image of the square under the action of $T$ is a parallelogram."} {:db/id #edb/ref 17592186281414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411cf09f-aaa8-5213-a15d-e483b24650c1" :answer/type {:db/ident :answer.type/text} :answer/value "A tetrahedron" :db/id #edb/ref 17592186279170} {:answer/id #uuid "87fc0aa9-2d9d-5344-8ce5-d4d954e92fb5" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279807} {:answer/id #uuid "99cffdbb-a38c-5a63-9d04-87167a638bb7" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279951} {:answer/id #uuid "d5f74625-2c51-5fb6-83b9-61fbae0292bb" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280479} {:answer/id #uuid "e51121c0-fae9-532e-b1aa-79a388ca1f2d" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280613}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279807} :answer-field/id #uuid "aec2e96d-de39-5f66-aab1-77904959b9e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281132}] :question/id #uuid "0a795336-4ab0-5101-bbca-aa94f4ca2a93" :question/math-academy-id "q-162214" :question/problem "![](images/00/00151dc7a58722a649a52494434950695a27cb4e7cad14f32f76abbddf629a91.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=u-3v+2,\\,y=4v-1.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-3v+2 \\\\ 4v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-3v \\\\ 4v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -3 \\\\ 0 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}1 & -3 \\\\ 0 & 4\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}1 & -3 \\\\ 0 & 4\\end{vmatrix} \\\\  & =1\\cdot 4-0\\cdot (-3) \\\\  & =4 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible and the image of the triangle under the action of $T$ is a triangle."} {:db/id #edb/ref 17592186281415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195bb2b0-3c00-5188-a9b8-26a0a9ccdf97" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186278815} {:answer/id #uuid "40a9cc60-2352-5a99-93fb-5f67de8ebc93" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279166} {:answer/id #uuid "4dcb619f-eec5-5b5f-acec-793e11542403" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279297} {:answer/id #uuid "80bfc1b2-c5dd-5eb9-b31c-ba89843e8c5b" :answer/type {:db/ident :answer.type/text} :answer/value "A square" :db/id #edb/ref 17592186279748} {:answer/id #uuid "b9da83b0-baf3-5459-8002-3bf2e296dcbe" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186280229}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186278815} :answer-field/id #uuid "e482fdd7-8e2a-5c19-b286-23e1eb8eb9fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281232}] :question/id #uuid "6ae18cba-a48e-5294-b453-329b86fcae7b" :question/math-academy-id "q-162217" :question/problem "![](images/c1/c1ee8bc2c212708ed583c709420a856b28f6e2129c24690a504b4716b2692aa7.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=u-2v+1,\\,y=2u-3v+1.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}u-2v+1 \\\\ 2u-3v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}u-2v \\\\ 2u-3v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}1 & -2 \\\\ 2 & -3\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}1 & -2 \\\\ 2 & -3\\end{vmatrix} \\\\  & =1\\cdot (-3)-2\\cdot (-2) \\\\  & =1 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible and the image of the triangle under the action of $T$ is a triangle."} {:db/id #edb/ref 17592186281417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2caab8eb-db16-5bdf-96dc-2168d092e843" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186278984} {:answer/id #uuid "6a83847c-1e16-5393-bea7-d87851c125e5" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279559} {:answer/id #uuid "6b4374f4-2af6-558f-accd-d53004d33ecf" :answer/type {:db/ident :answer.type/text} :answer/value "A square" :db/id #edb/ref 17592186279566} {:answer/id #uuid "8a15b67b-ab7d-5421-98e9-271ea88c8de4" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279823} {:answer/id #uuid "8fb84763-333b-5784-9255-e80858f6a6dc" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186279871}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279559} :answer-field/id #uuid "85eb8117-14af-5ac9-87c7-29d7a050f538" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281074}] :question/id #uuid "f95513aa-0be5-512e-82ea-b1dcd0aafc49" :question/math-academy-id "q-162222" :question/problem "![](images/95/957d55e3fb66bb2633798cf13d5c6049ffa4524ca585515ffaf88771ee32fe9b.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is a zero matrix\n$A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.$\n\nTherefore, $T$ is non-invertible, and the image of the triangle under the action of $T$ is a point on the plane."} {:db/id #edb/ref 17592186281418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c423a78-0db9-5f90-983b-9dfbb047e9f8" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186279124} {:answer/id #uuid "8ea410e2-60c7-51c0-9002-7d8a661b4542" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279860} {:answer/id #uuid "e1b22b8d-787b-5280-a5f2-57f6394bbe69" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186280587} {:answer/id #uuid "eb788c5f-15bc-5b4c-bbd8-95a2b365d823" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280660} {:answer/id #uuid "f7ed7cb4-543a-55f8-a67b-979cd22e5cbe" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280765}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280660} :answer-field/id #uuid "228341f6-d27f-56b7-9f4c-9d5fa6515e22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280890}] :question/id #uuid "ef668553-5d10-5944-a4d2-e24693f30a54" :question/math-academy-id "q-162223" :question/problem "![](images/52/522a51527563645261a3b4c5a1472510bcb3e890fc82d3b4c1b2ccdae59b9dbd.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the rectangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}9 & -3 \\\\ 3 & -1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}9 & -3 \\\\ 3 & -1\\end{vmatrix} \\\\  & =9\\cdot (-1)-3\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the rectangle under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186281419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c78548a-862a-5246-bc1b-00578ccf3514" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279276} {:answer/id #uuid "71afa1df-e22f-56d7-a584-9af2514d05a2" :answer/type {:db/ident :answer.type/text} :answer/value "A cube" :db/id #edb/ref 17592186279623} {:answer/id #uuid "9e198494-80d4-58da-996d-eb4de786f578" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279994} {:answer/id #uuid "cd8d7ef9-8b78-57e0-9208-4006881080c9" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186280403} {:answer/id #uuid "ef008053-89a0-534a-9bfd-e9f8124ce870" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186280685}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186279994} :answer-field/id #uuid "ba133b2f-ee36-5e2b-87c2-26ccbd0be401" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281162}] :question/id #uuid "32ed1c68-126b-5577-85f4-628388a45f45" :question/math-academy-id "q-162224" :question/problem "![](images/b5/b57fe5ce4b75c7daa5c866f3eb537ed62546e5fced67f6e2cb82af768cf382cb.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the square shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is a zero matrix\n$A=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.$\n\nTherefore, $T$ is non-invertible, and the image of the square under the action of $T$ is a point on the plane."} {:db/id #edb/ref 17592186281420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6f4259-f8e6-50d2-a27a-e21a3dbd842f" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186278885} {:answer/id #uuid "26605c63-dc1f-553c-9a90-202cae212a68" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186278933} {:answer/id #uuid "41dbf191-5e3f-5815-9255-4e8bf000acff" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279178} {:answer/id #uuid "7e2a63fe-e4fb-5e2e-9aa6-50ac6644284c" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186279722} {:answer/id #uuid "d09f332e-616c-505d-a0aa-63486360b032" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186280429}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186279178} :answer-field/id #uuid "2c149585-db76-5f50-b0c3-8e2eb75eb5e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280914}] :question/id #uuid "4197fe63-5776-5546-b6a0-81601947295c" :question/math-academy-id "q-162225" :question/problem "![](images/af/afee2a3c30384baa044088177550b0ac5ed2de228b14e48dd7f729e8a7493318.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3 & 6 \\\\ -2 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the pentagon shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}3 & 6 \\\\ -2 & -4\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}3 & 6 \\\\ -2 & -4\\end{vmatrix} \\\\  & =3\\cdot (-4)-(-2)\\cdot 6 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible, and the image of the pentagon under the action of $T$ is a line segment."} {:db/id #edb/ref 17592186389250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df95a0cf-0d57-5a93-ac2f-e7e698ff77a1" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186389252} {:answer/id #uuid "b92ebcbf-f068-555d-863e-04c41a13ff18" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186389253} {:answer/id #uuid "1f7c5c2f-8c10-5091-a460-a5b671bf8c82" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186389254} {:answer/id #uuid "5ef4fb02-e604-5dc5-8e46-a8a75eadac14" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389255} {:answer/id #uuid "955f1935-0944-5d9f-9475-dcae022a4eeb" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186389256}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186389252} :answer-field/id #uuid "e581555a-cb1e-51f4-adbf-43ba3b75f28d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389251}] :question/id #uuid "11c11bf3-c97a-56d9-961f-42e1efebf284" :question/math-academy-id "q-162197" :question/problem "![](images/c3/c36f3eb07b45eebf7f4de2a26cb366ca4ab785b5c7e8e6d25eb7bbad2c418838.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=3u-v-1,\\,y=2u+5v.\n$$\n\nWhat would be the image of the rectangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}3u-v-1 \\\\ 2u+5v\\end{bmatrix} \\\\  & =\\begin{bmatrix}3u-v \\\\ 2u+5v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -1 \\\\ 2 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}3 & -1 \\\\ 2 & 5\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}3 & -1 \\\\ 2 & 5\\end{vmatrix} \\\\  & =3\\cdot 5-2\\cdot (-1) \\\\  & =17 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible, and the image of the rectangle under the action of $T$ is a parallelogram."} {:db/id #edb/ref 17592186389257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e04b870d-e25b-5d96-b606-28a110148002" :answer/type {:db/ident :answer.type/text} :answer/value "A square" :db/id #edb/ref 17592186389259} {:answer/id #uuid "062427a9-0f48-53fc-94f1-c6c3d5e866d8" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186389260} {:answer/id #uuid "b7b5ad5a-830d-59fb-be20-4b48087915f5" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186389261} {:answer/id #uuid "4003098a-783e-5e93-bb25-5f94f36652a5" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389262} {:answer/id #uuid "1f7e5e40-3f3f-5c2d-abac-4a9137d31956" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186389263}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389262} :answer-field/id #uuid "d1250926-eea3-55ee-b530-0094a4347a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389258}] :question/id #uuid "b31d6cdc-6f82-507f-838b-9eddf7b3f11a" :question/math-academy-id "q-162215" :question/problem "![](images/1f/1f550963f047a3860566564abc2cb1e9f3939125895912762ff751767ca55c57.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=2u-v,\\,y=4u-v+2.\n$$\n\nWhat would be the image of the pentagon shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u-v \\\\ 4u-v+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u-v \\\\ 4u-v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 4 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}2 & -1 \\\\ 4 & -1\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}2 & -1 \\\\ 4 & -1\\end{vmatrix} \\\\  & =2\\cdot (-1)-4\\cdot (-1) \\\\  & =2 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible, and the image of the pentagon under the action of $T$ is a pentagon."} {:db/id #edb/ref 17592186406968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc064fc-557b-51b4-acc4-5e5aac84e9ea" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186406956} {:answer/id #uuid "394dd73f-cf48-54c7-81fb-4dd53a787045" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186406957} {:answer/id #uuid "72653cf4-8cbf-523e-b1d8-e878cfd112ab" :answer/type {:db/ident :answer.type/text} :answer/value "A square" :db/id #edb/ref 17592186406961} {:answer/id #uuid "c61e03b3-7008-5b09-9b8a-dd9dc056f91b" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186406964} {:answer/id #uuid "d1b9f565-9eda-5c15-bc7f-e57e8c6bdef5" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186406965}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186406957} :answer-field/id #uuid "2eef93f6-f290-530b-8af5-dd127f8894d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406967}] :question/id #uuid "353e50fd-8521-51a5-ae98-273dc887e6d8" :question/math-academy-id "q-162221" :question/problem "![](images/99/99b3d68b7f0c89ba430b098f9e7fda95f3013f310060dd71cf86eacc6e51afa7.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ -4 & 8\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}.\n$$\n\n \nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=\\begin{bmatrix}-1 & 2 \\\\ -4 & 8\\end{bmatrix}.$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}-1 & 2 \\\\ -4 & 8\\end{vmatrix} \\\\  & =(-1)\\cdot 8-(-4)\\cdot 2 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible, and the image of the quadrilateral under the action of $T$ is a line segment."}] :knowledge-point/title "Identifying the Types of Images Formed by an Affine Transformation"}] :topic/math-academy-id 3707 :topic/title "The Inverse of an Affine Transformation"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186172890} :activity/id #uuid "b43f46e4-16a6-5109-897b-7d61b6455c74" :activity/steps [{:db/id #edb/ref 17592186172882 :step/content {:db/id #edb/ref 17592186172025 :knowledge-point/id #uuid "a6598e4e-7ea6-56ce-abef-95e64d010e96"} :step/id #uuid "a2aa8190-261c-5faa-a399-c992ada54b4e" :step/next {:db/id #edb/ref 17592186172884}} {:db/id #edb/ref 17592186172883 :step/content {:db/id #edb/ref 17592186172026 :knowledge-point/id #uuid "4754d4e6-b2d0-5efb-ac92-c004c70004df"} :step/id #uuid "af3ae02e-e0d1-5714-a823-36990c3416dc"} {:db/id #edb/ref 17592186172884 :step/content {:db/id #edb/ref 17592186172027 :knowledge-point/id #uuid "31ae5cdc-ae3f-5497-88d8-f02a7263340d"} :step/id #uuid "136b060b-1871-5958-8dc0-d7310998c040" :step/next {:db/id #edb/ref 17592186172883}} {:db/id #edb/ref 17592186172890 :step/content {:db/id #edb/ref 17592186173154 :tutorial/content "A square matrix $A$ is **orthogonally diagonalizable** if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PDP^T,\n$$\n\nwhere $D$ is a diagonal matrix. Note that this is equivalent to the equation\n\n$$\nD = P^TAP.\n$$\n\nSo, to orthogonally diagonalize a matrix $A,$ we need to find a diagonal matrix $D$ and an orthogonal matrix $P$ that satisfies the above equations.\n\nA helpful theorem allows us to determine whether a real matrix is orthogonally diagonalizable. It states the following:\n\n*A matrix $A$ with real entries is orthogonally diagonalizable if and only if it is symmetric.*\n\nConsequently, *every* symmetric matrix is orthogonally diagonalizable!\n\nFor example, the symmetric matrix \n\n![](images/b3/b3970eb885720ce2aa4394918c6c5f9f343e26aa60039df219abf56398f096db.svg)\n\nhas the orthogonal diagonalization\n\n$$\n\\begin{aligned}A & ={{[\\begin{aligned}\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}4 & 0 \\\\ 0 & -6\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}}\\end{aligned}]}^{T}}_{⏟}}_{{P}^{T}},\\end{aligned}\n$$\n\nwhere $P$ is orthogonal, and $D$ is diagonal. As usual, the entries on the main diagonal of $D$ are the eigenvalues of $A.$ Also, the columns of $P$ are *orthonormal* eigenvectors corresponding to the eigenvalues of $A.$\n\nThe procedure of the orthogonal diagonalization of a $2 \\times 2$ real symmetric matrix $A$ is almost the same as the diagonalization of a matrix:\n\n- **Step 1**: Find the eigenvalues of the matrix $A$.\n\n- **Step 2**: Find a basis of  $\\mathbb{R}^2$ consisting of *unit orthogonal* eigenvectors of $A.$\n\n- **Step 3**: Construct the matrices $D$ and $P.$\n\nIn the case of symmetric matrices, the two eigenvectors we compute in step 2 will always be orthogonal, provided that they correspond to different eigenvalues. However, we must also ensure that we *normalize* those eigenvectors." :tutorial/id #uuid "c729ab04-2eef-5b7c-a28e-3d0f55428c54" :tutorial/math-academy-id 5006 :tutorial/title "Introduction"} :step/id #uuid "337f89b5-9c83-5bda-ac19-7d80b551f82e" :step/next {:db/id #edb/ref 17592186172882}}] :activity/title "Diagonalization of 2x2 Symmetric Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186172166} {:activity/first-step {:db/id #edb/ref 17592186519655} :activity/id #uuid "64fc3270-931c-55b0-ab11-941f63cb1739" :activity/steps [{:db/id #edb/ref 17592186519616 :step/content {:db/id #edb/ref 17592186404619 :question/id #uuid "46cbbf2d-cd23-5aab-9cf1-375dd44b0200"} :step/id #uuid "1cb45d40-3dff-5b26-9cf1-cf5ae94915d3" :step/next {:db/id #edb/ref 17592186519642}} {:db/id #edb/ref 17592186519624 :step/content {:db/id #edb/ref 17592186394880 :question/id #uuid "bc9e75e4-89e6-5c5c-b897-fce34f0588db"} :step/id #uuid "2f94d183-1b9a-5126-80a9-56929d485a13" :step/next {:db/id #edb/ref 17592186519616}} {:db/id #edb/ref 17592186519642 :step/content {:db/id #edb/ref 17592186357637 :question/id #uuid "b031f1a5-d4c2-57ba-adf6-a3fa295e4440"} :step/id #uuid "6dd7af92-0a90-5fa3-955d-021bfada8c3b"} {:db/id #edb/ref 17592186519655 :step/content {:db/id #edb/ref 17592186172612 :question/id #uuid "22c685a9-35f7-5e7f-8909-4579d1ac4e02"} :step/id #uuid "9f77e54a-ce06-5ad1-86c7-0ccf9bdad4ea" :step/next {:db/id #edb/ref 17592186519661}} {:db/id #edb/ref 17592186519661 :step/content {:db/id #edb/ref 17592186519598 :question/id #uuid "f2f205d5-62a6-56a8-a8b2-ff79782e487c"} :step/id #uuid "c59605b5-04a9-57e2-b8a6-b29858b31bee" :step/next {:db/id #edb/ref 17592186519624}}] :activity/title "Diagonalization of 2x2 Symmetric Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186518979} {:activity/first-step {:db/id #edb/ref 17592186555891} :activity/id #uuid "8204430f-7743-5e1b-97bd-65f00f3fe35a" :activity/steps [{:db/id #edb/ref 17592186555883 :step/content {:db/id #edb/ref 17592186492002 :question/id #uuid "23817e7f-6a06-51ca-bb89-ae0fdb8c7004"} :step/id #uuid "157496fd-75d6-56b5-bfa4-94bcbd0776e1" :step/next {:db/id #edb/ref 17592186555908}} {:db/id #edb/ref 17592186555891 :step/content {:db/id #edb/ref 17592186172613 :question/id #uuid "c7e02b11-9226-5c5b-9fda-bf26ea5fa1e5"} :step/id #uuid "32350c25-225c-5d5b-849f-e0a560c38b8d" :step/next {:db/id #edb/ref 17592186555948}} {:db/id #edb/ref 17592186555904 :step/content {:db/id #edb/ref 17592186357631 :question/id #uuid "5fd6de92-b207-5bcd-bc32-b23f271f69c3"} :step/id #uuid "546364d3-3227-5aec-9b6e-8dc453cb8430" :step/next {:db/id #edb/ref 17592186555883}} {:db/id #edb/ref 17592186555908 :step/content {:db/id #edb/ref 17592186555870 :question/id #uuid "f4374452-85e0-5d4e-85af-02cf21a24ee9"} :step/id #uuid "589cc2a9-3241-538e-b04a-719092fbc24c"} {:db/id #edb/ref 17592186555948 :step/content {:db/id #edb/ref 17592186172615 :question/id #uuid "6397dc6a-e670-5a27-9059-a00e14d9ffee"} :step/id #uuid "e1bb2cd0-ae3d-5129-96c2-1f14197550c9" :step/next {:db/id #edb/ref 17592186555904}}] :activity/title "Diagonalization of 2x2 Symmetric Matrices" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186554995}] :db/id #edb/ref 17592186048493 :topic/knowledge-points [{:db/id #edb/ref 17592186172025 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171831 :question/id #uuid "2a7b5d23-3dc7-57f8-98ed-72b1a45e787a" :question/math-academy-id "e-8157" :question/problem "![](images/9c/9cba1591f419653a58de73519f06b9c64b57e92b88376a7a3a1a22f62e45bc74.svg)\nConsider the matrix $P$ shown above. Given that $A=PDP^T$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the first column of the matrix $P?$\n\n![](images/db/dbe82125589c07f379dc34f725c5052ebf2f50ace729a5294d749bc82e5f796c.svg)" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PDP^T,\n$$\n\nwhere $D$ is a diagonal matrix.\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nSince  $A=PDP^T$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A,$ the matrix $P$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the first column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{3\\sqrt{10}}{10} \\\\ -\\frac{\\sqrt{10}}{10}\\end{bmatrix}$ has both properties."} :knowledge-point/id #uuid "a6598e4e-7ea6-56ce-abef-95e64d010e96" :knowledge-point/questions [{:db/id #edb/ref 17592186172611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db62ee4-2a6e-5aca-99a2-279b4cdde2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186491479} {:answer/id #uuid "1e147f75-020d-5d8c-b2c5-aeaaf906cd68" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186491516} {:answer/id #uuid "7ade7dd9-f5fe-54b0-9b8e-f4562b03352e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186491668} {:answer/id #uuid "c53dca38-f58e-5432-8695-431c6b85b38e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186491792} {:answer/id #uuid "c856dfd5-97c0-5fc2-9f6b-8bd13f9b8e61" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186491795}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186491668} :answer-field/id #uuid "9cc9b8d0-ff97-509a-86fb-5808b2c08721" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171291}] :question/id #uuid "338f7fda-0eb6-5e0f-ab2e-d2b60ab1cc4e" :question/math-academy-id "q-93586" :question/problem "$$\nP=\\begin{bmatrix}\\frac{\\sqrt{2}}{2} & \\,∗\\, \\\\ \\frac{\\sqrt{2}}{2} & \\,∗\\,\\end{bmatrix}\n$$\n\nConsider the matrix $P$ shown above. Given that $A=PD{P}^{T}$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the second column of the matrix $P?$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix.\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nSince  $A=PD{P}^{T}$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A,$ the matrix $P$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the second column must be orthogonal to the first column, and\n\n- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}$ has both properties."} {:db/id #edb/ref 17592186172614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d552401-7df8-5f99-a836-4969de7073d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]" :db/id #edb/ref 17592186540553} {:answer/id #uuid "456d1178-57b7-5b0c-943b-835fd8bfb7ac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186540646} {:answer/id #uuid "69d71126-9044-53dc-ac17-82d6b0ae4420" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186540709} {:answer/id #uuid "6e543dd2-637e-5897-999c-1a3bee825439" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{4}{5}\\end{aligned}]" :db/id #edb/ref 17592186540719} {:answer/id #uuid "c3445e30-2b43-549c-8a2b-9e83ae6551c9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}20 \\\\ 15\\end{aligned}]" :db/id #edb/ref 17592186540854}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186540709} :answer-field/id #uuid "e077db50-237c-5ac5-8ad2-51e21edf25be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171309}] :question/id #uuid "ea847699-4209-5eaf-a7b8-0e9066abdca0" :question/math-academy-id "q-94000" :question/problem "$$\nP=[\\begin{aligned}\\,∗\\, & \\frac{3}{5} \\\\ \\,∗\\, & -\\frac{4}{5}\\end{aligned}]\n$$\n\nConsider the matrix $P$ shown above. Given that $A=PD{P}^{T}$ is an orthogonal diagonalization of a $2\\times 2$ symmetric matrix $A$ for some diagonal matrix $D,$ which of the following could be the first column of the matrix $P?$" :question/worked-solution "Recall 