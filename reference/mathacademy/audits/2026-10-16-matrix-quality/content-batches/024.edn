Ax-b)\\cdot {x}^{T} \\\\  & =2([\\begin{aligned}1 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}4 \\\\ 4\\end{aligned}]-[\\begin{aligned}8 \\\\ 0 \\\\ 2\\end{aligned}])\\cdot [\\begin{aligned}4 & 4\\end{aligned}] \\\\  & =2([\\begin{aligned}8 \\\\ -4 \\\\ 4\\end{aligned}]-[\\begin{aligned}8 \\\\ 0 \\\\ 2\\end{aligned}])\\cdot [\\begin{aligned}4 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -8 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}4 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -32 & -32 \\\\ 16 & 16\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccc7cd39-2b31-5e60-9f7f-6d6dbdd6fcd6" :answer/type {:db/ident :answer.type/math} :answer/value "4280" :db/id #edb/ref 17592186533633}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4280" :db/id #edb/ref 17592186533633} :answer-field/id #uuid "4a1b8af5-7b32-59e0-af44-041131fdb958" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533841} {:answer-field/choices [{:answer/id #uuid "847371f3-c4cc-51af-87c4-80f81681286d" :answer/type {:db/ident :answer.type/math} :answer/value "480" :db/id #edb/ref 17592186533450}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "480" :db/id #edb/ref 17592186533450} :answer-field/id #uuid "9b35ca60-322b-555a-a5bd-d55c7f80941e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533897} {:answer-field/choices [{:answer/id #uuid "e4b7f285-21bd-5c63-961f-8c698aa411e9" :answer/type {:db/ident :answer.type/math} :answer/value "4280" :db/id #edb/ref 17592186533702}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4280" :db/id #edb/ref 17592186533702} :answer-field/id #uuid "e8bb2f47-6b22-5ef2-a095-870537c2a058" :answer-field/key "field-3" :answer-field/type {:db/ident :