begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0107d3b9-5fbb-503f-9f5b-d99973f71407" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186263011} {:answer/id #uuid "7693e55b-92ab-5364-abe5-31f20f15b4b8" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|+2\\cdot |\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186264031} {:answer/id #uuid "9a90c933-55bc-50b6-9cd8-1e1694e93249" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|+|\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186264324} {:answer/id #uuid "9cdcb76b-8330-5e4a-8ba4-f271dfd66ff8" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|+2\\cdot |\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186264342} {:answer/id #uuid "cfed8262-5a70-58b7-9d97-6022f5446b20" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|-2\\cdot |\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186264821}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186263011} :answer-field/id #uuid 