f 17592186345335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e61f4c2-8085-5114-a20b-6ea7aea00f18" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|" :db/id #edb/ref 17592186342492} {:answer/id #uuid "25a545b6-2f31-5036-b445-a8862f234210" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|" :db/id #edb/ref 17592186342554} {:answer/id #uuid "57480ec8-f1b7-52b3-a79c-b6a587fef1b0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+3\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|" :db/id #edb/ref 17592186342965} {:answer/id #uuid "ad7d3e0d-3e6e-53ab-9ce6-1a956f138509" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|" :db/id #edb/ref 17592186343763} {:answer/id #uuid "d50ce4c7-1536-586c-bce7-e90d1ada92fd" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|" :db/id #edb/ref 17592186344105}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|" :db/id #edb/ref 17592186342492} :answer-field/id #uuid "6420e3da-ebe0-5423-a2d2-71302a68d23d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344662}] :question/id #uuid "658f3c01-d02e-55ae-801b-ed3db4082fef" :question/math-academy-id "q-77798" :question/problem "$|\\begin{aligned}0 & -3 & 2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{aligned}|=$" :question/worked-solution "The $1$rst row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -3 & 2 & 0 \\\\ 1 & -4 & -3 & 8 \\\\ 9 & 5 & -3 & -6 \\\\ -2 & 6 & 7 & 0\\end{aligned}| & =0\\cdot {C}_{11}+-3\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =-3\\cdot (-1)^{1+2}|\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & 8 \\\\ 9 & -3 & -6 \\\\ -2 & 7 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -4 & 8 \\\\ 9 & 5 & -6 \\\\ -2 & 6 & 0\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0697b8f8-60bd-5ea9-b299-33fb8a105bd6" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|-6\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186342298} {:answer/id #uuid "0bd2dbe7-49de-58ee-b0a6-7ca4dd81cd94" :answer/type {:db/ident :answer.type/math} :answer/value "6\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|-3\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186342342} {:answer/id #uuid "478a2b31-fc2b-5057-9df6-cb76999d8cec" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186342829} {:answer/id #uuid "e7803236-3735-5a23-a9ed-53518e027f4c" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186344271} {:answer/id #uuid "f0ce6711-9158-5ade-944d-8e8347b0264c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|+6\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186344354}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|-6\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}|" :db/id #edb/ref 17592186342298} :answer-field/id #uuid "434a7d58-b4ae-59e3-8116-c520bcdbc4c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344601}] :question/id #uuid "3050e12e-4f05-5836-84f0-bb2d520a66fd" :question/math-academy-id "q-77799" :question/problem "$|\\begin{aligned}-7 & -1 & 5 & 8 \\\\ 3 & -6 & 0 & 0 \\\\ 4 & -3 & 2 & -1 \\\\ 1 & 3 & -5 & -7\\end{aligned}|=$" :question/worked-solution "The $2$nd row of the matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}-7 & -1 & 5 & 8 \\\\ 3 & -6 & 0 & 0 \\\\ 4 & -3 & 2 & -1 \\\\ 1 & 3 & -5 & -7\\end{aligned}| & =3\\cdot {C}_{21}+(-6)\\cdot {C}_{22}+0\\cdot {C}_{23}+0\\cdot {C}_{24} \\\\  & =3\\cdot (-1)^{2+1}|\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|+(-6)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}| \\\\  & =-3\\cdot |\\begin{aligned}-1 & 5 & 8 \\\\ -3 & 2 & -1 \\\\ 3 & -5 & -7\\end{aligned}|-6\\cdot |\\begin{aligned}-7 & 5 & 8 \\\\ 4 & 2 & -1 \\\\ 1 & -5 & -7\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "deea6f11-2212-5136-986d-eb2c6c9161fb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392975} {:answer/id #uuid "dc83f30f-7301-5d68-b5c4-bf0d0381be6c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392976} {:answer/id #uuid "c71fbff2-d8c7-5f96-969d-6b1c6b5f9789" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392977} {:answer/id #uuid "d75f538e-88e2-521b-8696-849c4f3b1cf8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392978} {:answer/id #uuid "745346ec-61c9-599a-be09-b23f7093ed5a" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392979}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392976} :answer-field/id #uuid "83d6a691-7c53-5720-81d6-4ff94ceac019" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392974}] :question/id #uuid "77b8f120-b46e-5255-b315-458b6b755462" :question/math-academy-id "q-69950" :question/problem "$|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}| & =0\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+2\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186425877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "394cf326-2a8e-53d3-b6bb-9d00bbd00896" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425857} {:answer/id #uuid "cdaba3a2-4f44-5d67-97c9-41759abf06af" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425866} {:answer/id #uuid "d00a3088-dd85-511b-a78d-c803fdd41730" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425867} {:answer/id #uuid "e302e086-65fb-5d1c-95c1-38d5bea87093" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425869} {:answer/id #uuid "fb0c8f0c-3314-5bf3-83d0-87976ede682e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425871}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" :db/id #edb/ref 17592186425867} :answer-field/id #uuid "ed337fba-8f9c-5284-b664-f31a93279b80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425874}] :question/id #uuid "eec69fbf-a0cd-50e6-9b17-0f0c96351008" :question/math-academy-id "q-69953" :question/problem "$|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -3 & -1 & 2 & 4 \\\\ -1 & -5 & 5 & 1 \\\\ -2 & -1 & 2 & 3\\end{aligned}|=$" :question/worked-solution "The $1$st row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -3 & -1 & 2 & 4 \\\\ -1 & -5 & 5 & 1 \\\\ -2 & -1 & 2 & 3\\end{aligned}| & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+1\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =1\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|.\\end{aligned}\n$$"}] :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :topic/math-academy-id 1770 :topic/title "Finding Determinants Using Laplace Expansions"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186205011} :activity/id #uuid "f13da08f-0333-5cf7-8f52-a79e6bf0ebd6" :activity/steps [{:db/id #edb/ref 17592186205011 :step/content {:db/id #edb/ref 17592186205186 :tutorial/content "In previous lessons, we defined the gradient of a scalar-valued function with respect to a vector. In this lesson, we extend this idea to functions where the input is a *matrix* and the output is a scalar.\n\nSuppose we have a function $f: \\mathbb{R}^{m \\times n} \\to \\mathbb{R}$ that maps a matrix $A \\in \\mathbb{R}^{m \\times n}$ to a scalar value $f(A)$. Just like with vector inputs, we define the **gradient of $f$ with respect to $A$** as the matrix of partial derivatives of $f$ with respect to each individual entry of $A{:}$\n\n![](images/0b/0b3ce184c982fe85eb25f79161431b7620227b96909d87998fa82efbb469423c.svg)\n\nThis gradient has the same shape as the matrix $A.$ It tells us how sensitive the output $f(A)$ is to changes in each element $a_{ij}$.\n\nLet’s apply this to a concrete example. Suppose we define the function\n\n$$\nf(X) = \\ln(\\det(X))\n$$\n\nfor a square matrix $X \\in \\mathbb{R}^{2 \\times 2}$. Let's find the gradient of $f$ with respect to $X$ and evaluate it at a specific point.\n\nFirst, we write the matrix $X$ as\n![](images/67/67c8cc92409c6bd1595fda93c8711ce91a40d220526cc52ee9a8f4d3842f7354.svg)\nThen, the determinant of $X$ is\n\n$$\n\\det(X) = x_{11}x_{22} - x_{12}x_{21}.\n$$\n\nSo, the function becomes\n\n$$\nf(X) = \\ln(x_{11}x_{22} - x_{12}x_{21}).\n$$\n\nTo find the gradient, we differentiate $f$ with respect to each element of $X.$ This gives\n\n$$\n\\begin{aligned}{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}(\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{12}}(\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) \\\\ \\frac{∂}{∂{x}_{21}}(\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{22}}(\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21}))\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{{x}_{22}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & -\\frac{{x}_{21}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} \\\\ -\\frac{{x}_{12}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & \\frac{{x}_{11}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}}\\end{aligned}] \\\\  & =\\frac{1}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}}[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}] \\\\  & =\\frac{1}{det(X)}[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}].\\end{aligned}\n$$\n\nNow, suppose we wish to evaluate this gradient at\n![](images/93/93200d9d52e6a58a52e4b9f65db6bc13ded0c6e17dbb8fc0381ae40081932ff9.svg)\nFirst, we compute the determinant:\n\n$$\n\\begin{aligned}det(X) & =3\\cdot (-2)-1\\cdot 5 \\\\  & =-6-5 \\\\  & =-11\\end{aligned}\n$$\n\nThen, we substitute our values into our gradient. This gives\n\n$$\n\\begin{aligned}{∇}_{X}f(X) & =-\\frac{1}{11}[\\begin{aligned}-2 & -5 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{11}[\\begin{aligned}2 & 5 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nThis result tells us how the scalar output $f(X) = \\ln(\\det(X))$ would change with respect to small changes in each entry of the matrix $X$. Each element in the gradient matrix captures that local rate of change." :tutorial/id #uuid "4ace4da9-e2b2-56f1-b064-78e25344a30e" :tutorial/math-academy-id 12175 :tutorial/title "Introduction"} :step/id #uuid "51d89ff0-2e51-5813-be29-4f290760f1f7" :step/next {:db/id #edb/ref 17592186205012}} {:db/id #edb/ref 17592186205012 :step/content {:db/id #edb/ref 17592186204079 :knowledge-point/id #uuid "c676a83b-f3d4-579b-ab54-de2104552e8f"} :step/id #uuid "5682316e-09ab-5709-825d-abbce84fe179" :step/next {:db/id #edb/ref 17592186205013}} {:db/id #edb/ref 17592186205013 :step/content {:db/id #edb/ref 17592186205192 :tutorial/content "Suppose we have a scalar-valued function defined by\n\n$$\nf = \\mathbf{y}^T A \\mathbf{x},\n$$\n\nwhere $\\mathbf{y} \\in \\mathbb{R}^m$, $\\mathbf{x} \\in \\mathbb{R}^n$, and $A \\in \\mathbb{R}^{m \\times n}$.\n\nWe want to compute the gradient of $f$ with respect to the matrix $A$. The result turns out to be\n\n$$\n\\nabla_A f = \\mathbf{y} \\cdot \\mathbf{x}^T.\n$$\n\nLet’s verify this by working component-wise. \n\nFirst, note that we can write the product $\\mathbf y^T A \\mathbf x$ as a double summation as follows:\n\n$$\nf = \\mathbf y^T A \\mathbf x = \\sum_{k=1}^m \\sum_{l=1}^n y_k A_{kl} x_l.\n$$\n\nIn a previous lesson, we saw how to do this for $\\mathbf x^T A \\mathbf x$. The idea here is similar.\n\nNow, we differentiate this summation with respect to $A_{ij}{:}$\n\n$$\n\\frac{\\partial f}{\\partial A_{ij}} \n= \\frac{\\partial}{\\partial A_{ij}} \\left( \\sum_{k=1}^m \\sum_{l=1}^n y_k A_{kl} x_l \\right)\n$$\n\nSince only the term where $k = i$ and $l = j$ depends on $A_{ij}$, all other terms vanish. So, we get\n\n$$\n\\frac{\\partial f}{\\partial A_{ij}} \n= y_i x_j.\n$$\n\nThis tells us that the entry in the $i$th row and $j$th column of the gradient matrix is $y_i x_j$. Hence, the full gradient matrix is\n\n$$\n\\nabla_A f = \\mathbf{y} \\cdot \\mathbf{x}^T.\n$$\n\nThis result is an example of an outer product. The gradient of $\\mathbf{y}^T A \\mathbf{x}$ with respect to the matrix $A$ is given by multiplying the column vector $\\mathbf{y}$ by the row vector $\\mathbf{x}^T$, resulting in a matrix of the same shape as $A$.\n\nLet’s look at a few examples to see this in action." :tutorial/id #uuid "957b6db8-152d-50d1-9685-1b280888ce3d" :tutorial/math-academy-id 12388 :tutorial/title "Component-Wise Differentiation"} :step/id #uuid "40001fda-db52-5314-a824-eba6f4cc9e69" :step/next {:db/id #edb/ref 17592186205014}} {:db/id #edb/ref 17592186205014 :step/content {:db/id #edb/ref 17592186204080 :knowledge-point/id #uuid "35dc17b6-1c82-55ec-9657-20f2850794e5"} :step/id #uuid "ad3cf801-8dd4-5f9a-b7ca-588e439c66cc" :step/next {:db/id #edb/ref 17592186205015}} {:db/id #edb/ref 17592186205015 :step/content {:db/id #edb/ref 17592186205195 :tutorial/content "When working with scalar-valued functions defined on matrices, it's often helpful to compute gradients using component-wise differentiation and the chain rule. This approach breaks down the computation into simpler intermediate steps and allows us to clearly see the dependencies.\n\nConsider a *scalar* function $L(\\mathbf A),$ defined as\n\n$$\nL(\\mathbf{A}) = \\frac{1}{2} \\left( \\mathbf{A}\\mathbf{x} - \\mathbf{b} \\right)^T \\left( \\mathbf{A}\\mathbf{x} - \\mathbf{b} \\right)\n$$\n\nwhere $\\mathbf{A} \\in \\mathbb{R}^{2 \\times 3}$, $\\mathbf{x} \\in \\mathbb{R}^3$, and $\\mathbf{b} \\in \\mathbb{R}^2.$\n\nSuppose we want to compute the gradient $\\nabla_{\\mathbf{A}} L$, which is a matrix of the same shape as $\\mathbf{A}$. The entry in the $i$th row and $j$th column of the gradient matrix is given by \n\n$$\n\\dfrac{\\partial L}{\\partial a_{ij}}.\n$$\n\nTo simplify the differentiation, we define $\\mathbf y \\in\\mathbb R^{2\\times 1}$ as \n![](images/d1/d14a8e7752fdc2f20c9c325c5a0076d79a86ccd2a0c46d6b353ce53c3f1561d7.svg)\n\nThen, we can write $L$ in terms of $\\mathbf y$ as \n\n$$\nL = \\frac{1}{2} \\mathbf{y}^T \\mathbf{y}.\n$$\n\nTo compute $\\dfrac{\\partial L}{\\partial a_{ij}}$, we apply the multivariable chain rule:\n\n$$\n\\frac{\\partial L}{\\partial a_{ij}} = \\sum_{k=1}^2 \\frac{\\partial L}{\\partial y_k} \\cdot \\frac{\\partial y_k}{\\partial a_{ij}}\n$$\n\nNote that the summation is from $k=1$ to $k=2$ because $\\mathbf y$ has two components, and we're differentiating with respect to each of them.\n\nNow, let's analyze the two factors of the product that appear in this summation.\n\n- We know that\n\n$$\n\\begin{aligned}{∇}_{y}L & ={∇}_{y}(\\frac{1}{2}{y}^{T}y) \\\\  & =\\frac{1}{2}\\cdot {∇}_{y}({y}^{T}y) \\\\  & =\\frac{1}{2}\\cdot 2y \\\\  & =y.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\frac{\\partial L}{\\partial y_k} = y_k.\n$$\n\n- Writing $\\mathbf{y} = \\mathbf{A} \\mathbf{x} - \\mathbf{b}$ in component form\n\n$$\ny_i = \\sum_{j=1}^3 a_{ij} x_j - b_i,\n$$\n\nwe have\n![](images/76/761731b884eee7282e01bda6964861fc8f3d4a3a44bfec09fda478170982b56a.svg)\nOnly the $k$th row of $\\mathbf{A}$ affects $y_k$.\n\nPutting our two results together gives\n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}{x}_{j},\\end{aligned}\n$$\n\nbecause all terms vanish except the one where $k=i$.\n\nTherefore, we conclude that\n\n$$\n\\nabla_{\\mathbf{A}} L = \\mathbf{y} \\cdot \\mathbf{x}^T.\n$$\n\nIn the next example, we will use this formula to compute the gradient for specific vectors." :tutorial/id #uuid "2a8a781f-98de-5bf4-8f02-80c10f3211b3" :tutorial/math-academy-id 12479 :tutorial/title "Differentiation Using the Multivariable Chain Rule"} :step/id #uuid "da5331f6-b68e-5fed-80d1-95b4e0971765" :step/next {:db/id #edb/ref 17592186205016}} {:db/id #edb/ref 17592186205016 :step/content {:db/id #edb/ref 17592186204081 :knowledge-point/id #uuid "ef7b2139-06eb-5584-a267-d9fbc9b5d041"} :step/id #uuid "0dbe27ec-63c8-5d16-a0de-f9deb9e9f3e8"}] :activity/title "Matrix Gradients" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186204182} {:activity/first-step {:db/id #edb/ref 17592186542274} :activity/id #uuid "2404189e-9656-51cd-a3b5-6c13f1ff213f" :activity/steps [{:db/id #edb/ref 17592186542233 :step/content {:db/id #edb/ref 17592186204584 :question/id #uuid "6779795b-e35d-5389-887e-4355a853f59a"} :step/id #uuid "117f03df-7ecf-55d7-878d-f554adc908c2" :step/next {:db/id #edb/ref 17592186542257}} {:db/id #edb/ref 17592186542237 :step/content {:db/id #edb/ref 17592186542139 :question/id #uuid "43f1cf78-e476-5744-a4e1-4eb640602151"} :step/id #uuid "15fbb940-fc98-53cc-ba92-f859f422626f"} {:db/id #edb/ref 17592186542254 :step/content {:db/id #edb/ref 17592186542190 :question/id #uuid "ae4e117c-08e3-5ee2-be97-840ec47e6061"} :step/id #uuid "4fd46510-de50-56a6-8167-99996004b4ea" :step/next {:db/id #edb/ref 17592186542233}} {:db/id #edb/ref 17592186542257 :step/content {:db/id #edb/ref 17592186542179 :question/id #uuid "a276eb8e-dc20-5069-8231-5e2d2d2a281a"} :step/id #uuid "66630ed2-72bb-5fad-a04e-d80e51de9e27" :step/next {:db/id #edb/ref 17592186542237}} {:db/id #edb/ref 17592186542274 :step/content {:db/id #edb/ref 17592186204578 :question/id #uuid "be0cbc5f-85e4-5a3d-bf50-d49616a38b87"} :step/id #uuid "b6011297-6460-5ecb-9f16-906f524f351c" :step/next {:db/id #edb/ref 17592186542254}}] :activity/title "Matrix Gradients" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186541418} {:activity/first-step {:db/id #edb/ref 17592186550034} :activity/id #uuid "f063dc42-6d1b-5e1c-9569-9f74dc807d8e" :activity/steps [{:db/id #edb/ref 17592186550025 :step/content {:db/id #edb/ref 17592186549991 :question/id #uuid "b06d01a6-0f9f-5c10-83f5-9d9f497a0fba"} :step/id #uuid "08378717-3017-5e03-97b0-35ada959e212" :step/next {:db/id #edb/ref 17592186550030}} {:db/id #edb/ref 17592186550030 :step/content {:db/id #edb/ref 17592186549924 :question/id #uuid "078844cb-65ac-54f4-bde7-64e4bd44f313"} :step/id #uuid "1ce65caa-d800-5e9b-998a-08f08f3b10e3"} {:db/id #edb/ref 17592186550034 :step/content {:db/id #edb/ref 17592186204583 :question/id #uuid "c38068fb-d53f-5bd3-995e-1c6838e1f711"} :step/id #uuid "244abaf2-b14e-5d3c-8a36-dbd5fac2c489" :step/next {:db/id #edb/ref 17592186550058}} {:db/id #edb/ref 17592186550058 :step/content {:db/id #edb/ref 17592186549972 :question/id #uuid "7c674592-16b0-5e5a-b0ac-ce1e62f430e7"} :step/id #uuid "5abfd5b5-134f-5a5a-8939-900b7bd8ea02" :step/next {:db/id #edb/ref 17592186550063}} {:db/id #edb/ref 17592186550063 :step/content {:db/id #edb/ref 17592186549952 :question/id #uuid "34c44cc9-bf3e-5025-8ef7-d8fd637a6eae"} :step/id #uuid "64cd4bd3-fcea-541b-aa6e-833c6b308386" :step/next {:db/id #edb/ref 17592186550025}}] :activity/title "Matrix Gradients" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186549318}] :db/id #edb/ref 17592186048550 :topic/knowledge-points [{:db/id #edb/ref 17592186204079 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203857 :question/id #uuid "ca1002c8-c615-5f7b-8876-82cf87c8864f" :question/math-academy-id "e-17349" :question/problem "Consider the function $f: \\mathbb{R}^{2 \\times 2} \\rightarrow \\mathbb{R}$ defined by \n\n$$\nf(X) = (\\det(X))^2.\n$$\n\n \n\nWhat is the gradient of $f$ with respect to $X$ at ![](images/70/70a078e9f26d91a1beb588e88c812057b85d31586576c94eaa510dedba7da2f0.svg)" :question/worked-solution "The gradient of a function $f: \\mathbb{R}^{m \\times n} \\rightarrow \\mathbb{R}$ with respect to a matrix $X \\in \\mathbb{R}^{m \\times n}$ is\n![](images/26/26b51d20ec90168f9bf7602ed9e5f05cb4a5fb1421bb52fd0042ff81faa5f8ab.svg)\n\nIn our case, writing out the function $f(X)$ where ![](images/db/dbd3e061ec5b3c6e148c347b0bf829391218f883ba4e6b1271bf8f65fb08d38b.svg), we get\n\n$$\nf(X) = (\\det(X))^2 = (x_{11}x_{22} - x_{12}x_{21})^2.\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} & \\frac{∂}{∂{x}_{12}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} \\\\ \\frac{∂}{∂{x}_{21}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} & \\frac{∂}{∂{x}_{22}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot {x}_{22} & 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot (-{x}_{21}) \\\\ 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot (-{x}_{12}) & 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot {x}_{11}\\end{aligned}] \\\\  & =2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}] \\\\  & =2det(X)[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at ![](images/79/790980ee64747a4ef3becd801431083d66839972cb271207807c43c53cf166fa.svg) we get\n\n$$\n\\begin{aligned}{∇}_{X}f(X) & =2(-\\frac{1}{2}\\cdot 10-(-4)\\cdot \\frac{3}{2})[\\begin{aligned}10 & 4 \\\\ -\\frac{3}{2} & -\\frac{1}{2}\\end{aligned}] \\\\  & =2(-5-(-6))[\\begin{aligned}10 & 4 \\\\ -\\frac{3}{2} & -\\frac{1}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}20 & 8 \\\\ -3 & -1\\end{aligned}].\\end{aligned}\n$$"} :knowledge-point/id #uuid "c676a83b-f3d4-579b-ab54-de2104552e8f" :knowledge-point/questions [{:db/id #edb/ref 17592186204564 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c47d4b1-a923-5d13-9ea2-f25e49d50c60" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186203338} {:answer/id #uuid "23f517c8-02d6-5cbc-bbf1-171ed91219de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186533229} {:answer/id #uuid "3edc160a-8101-5d90-8138-2690348d912d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186533286} {:answer/id #uuid "dd2c45f0-ab57-5f4c-af72-1b497341005f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186533683} {:answer/id #uuid "efa876a3-a667-54e0-abff-4b40c1125d55" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186533727}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186533683} :answer-field/id #uuid "18959201-dc75-5139-b452-5ab59d2a87d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203333}] :question/id #uuid "8781dff9-d5f6-57b2-92f1-799f898568b0" :question/math-academy-id "q-264512" :question/problem "Consider the function $f:{R}^{2\\times 2}\\to R$ defined by \n\n$$\nf(X)=-\\operatorname{ln}⁡(det(X)).\n$$\n\n \nWhat is the gradient of $f$ with respect to $X$ at $X=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]?$" :question/worked-solution "The gradient of a function $f:{R}^{m\\times n}\\to R$ with respect to a matrix $X\\in {R}^{m\\times n}$ is\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} & ⋯ & \\frac{∂f}{∂{x}_{1n}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}} & ⋯ & \\frac{∂f}{∂{x}_{2n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂f}{∂{x}_{m1}} & \\frac{∂f}{∂{x}_{m2}} & ⋯ & \\frac{∂f}{∂{x}_{mn}}\\end{aligned}].\n$$\n\nIn our case, writing out the function $f(X)$ where $X=[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}]\\in {R}^{2\\times 2}$, we get\n\n$$\nf(X)=-\\operatorname{ln}⁡(det(X))=-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21}).\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{12}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) \\\\ \\frac{∂}{∂{x}_{21}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{22}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21}))\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{-{x}_{22}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & \\frac{{x}_{21}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} \\\\ \\frac{{x}_{12}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & \\frac{-{x}_{11}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at $X=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}],$ we get\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}-\\frac{2}{4-1} & \\frac{1}{4-1} \\\\ \\frac{1}{4-1} & -\\frac{2}{4-1}\\end{aligned}]=[\\begin{aligned}-\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186204572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea4ca45-df67-56c6-911d-3d71844ae6f7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 8 \\\\ 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186533285} {:answer/id #uuid "4fe9b706-ba42-57d7-b61f-d9a640eeeedb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 16 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186533333} {:answer/id #uuid "650ab510-72e3-535b-b721-0beb1e22eb23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 8 \\\\ 2 & -4\\end{aligned}]" :db/id #edb/ref 17592186533374} {:answer/id #uuid "c0d59bb6-b177-593a-b402-558045a82d46" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 2 \\\\ 8 & -4\\end{aligned}]" :db/id #edb/ref 17592186533605} {:answer/id #uuid "fabfae26-7434-5570-8009-28ae299dc640" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -8 \\\\ -2 & 4\\end{aligned}]" :db/id #edb/ref 17592186533753}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 8 \\\\ 2 & -4\\end{aligned}]" :db/id #edb/ref 17592186533374} :answer-field/id #uuid "006b5aba-a8d4-5887-b052-f91f00560b87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203370}] :question/id #uuid "52069b73-e5e5-5970-bfc8-fea272282f4e" :question/math-academy-id "q-265775" :question/problem "Consider the function $f:{R}^{2\\times 2}\\to R$ defined by \n\n$$\nf(X)={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{x}_{ij}^{2}\n$$\n\n \nwhere ${x}_{ij}$ are the corresponding matrix's entries. What is the gradient of $f$ with respect to $X$ at $X=[\\begin{aligned}-3 & 4 \\\\ 1 & -2\\end{aligned}]?$" :question/worked-solution "The gradient of a function $f:{R}^{m\\times n}\\to R$ with respect to a matrix $X\\in {R}^{m\\times n}$ is\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} & ⋯ & \\frac{∂f}{∂{x}_{1n}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}} & ⋯ & \\frac{∂f}{∂{x}_{2n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂f}{∂{x}_{m1}} & \\frac{∂f}{∂{x}_{m2}} & ⋯ & \\frac{∂f}{∂{x}_{mn}}\\end{aligned}].\n$$\n\nIn our case, writing out the function $f(X)$ where $X=[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}]\\in {R}^{2\\times 2}$, we get\n\n$$\nf(X)={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{x}_{ij}^{2}=({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}).\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) & \\frac{∂}{∂{x}_{12}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) \\\\ \\frac{∂}{∂{x}_{21}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) & \\frac{∂}{∂{x}_{22}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{11} & 2{x}_{12} \\\\ 2{x}_{21} & 2{x}_{22}\\end{aligned}] \\\\  & =2[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}] \\\\  & =2X.\\end{aligned}\n$$\n\nEvaluating at $X=[\\begin{aligned}-3 & 4 \\\\ 1 & -2\\end{aligned}],$ we get\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}2\\cdot (-3) & 2\\cdot (4) \\\\ 2\\cdot (1) & 2\\cdot (-2)\\end{aligned}]=[\\begin{aligned}-6 & 8 \\\\ 2 & -4\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186533992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65feaefc-9540-5e9e-aba0-1a7effe2a8bd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}56 & -14 \\\\ 42 & 14\\end{aligned}]" :db/id #edb/ref 17592186533378} {:answer/id #uuid "87069efe-45b4-5333-8a10-7ed32590e859" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 6 \\\\ -2 & 8\\end{aligned}]" :db/id #edb/ref 17592186533459} {:answer/id #uuid "90d505d3-8405-52e7-b05e-824d062628e6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & 42 \\\\ -14 & 56\\end{aligned}]" :db/id #edb/ref 17592186533488} {:answer/id #uuid "d975b5e6-4b40-557d-ac26-27b4762c7188" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & -42 \\\\ 14 & 56\\end{aligned}]" :db/id #edb/ref 17592186533671} {:answer/id #uuid "fe0899b4-0eb5-5f96-802e-1c29cc2efdb0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 21 \\\\ -7 & 28\\end{aligned}]" :db/id #edb/ref 17592186533763}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & -42 \\\\ 14 & 56\\end{aligned}]" :db/id #edb/ref 17592186533671} :answer-field/id #uuid "51ec136b-c0f0-5734-828b-fc93c68cab5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533846}] :question/id #uuid "35662c2c-d0a2-5e1c-b319-cae7bd255ca0" :question/math-academy-id "q-265777" :question/problem "Consider the function $f:{R}^{2\\times 2}\\to R$ defined by \n\n$$\nf(X)=(det(X))^{2}.\n$$\n\n \n\nWhat is the gradient of $f$ with respect to $X$ at $X=[\\begin{aligned}4 & -1 \\\\ 3 & 1\\end{aligned}]?$" :question/worked-solution "The gradient of a function $f:{R}^{m\\times n}\\to R$ with respect to a matrix $X\\in {R}^{m\\times n}$ is\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} & ⋯ & \\frac{∂f}{∂{x}_{1n}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}} & ⋯ & \\frac{∂f}{∂{x}_{2n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂f}{∂{x}_{m1}} & \\frac{∂f}{∂{x}_{m2}} & ⋯ & \\frac{∂f}{∂{x}_{mn}}\\end{aligned}].\n$$\n\nIn our case, writing out the function $f(X)$ where $X=[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}]\\in {R}^{2\\times 2}$, we get\n\n$$\nf(X)=(det(X))^{2}=({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2}.\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} & \\frac{∂}{∂{x}_{12}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} \\\\ \\frac{∂}{∂{x}_{21}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2} & \\frac{∂}{∂{x}_{22}}({x}_{11}{x}_{22}-{x}_{12}{x}_{21})^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot {x}_{22} & 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot (-{x}_{21}) \\\\ 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot (-{x}_{12}) & 2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})\\cdot {x}_{11}\\end{aligned}] \\\\  & =2({x}_{11}{x}_{22}-{x}_{12}{x}_{21})[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}] \\\\  & =2det(X)[\\begin{aligned}{x}_{22} & -{x}_{21} \\\\ -{x}_{12} & {x}_{11}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at $X=[\\begin{aligned}4 & -1 \\\\ 3 & 1\\end{aligned}],$ we get\n\n$$\n{∇}_{X}f(X)=2(4\\cdot 1-(-1)\\cdot 3)[\\begin{aligned}1 & -3 \\\\ 1 & 4\\end{aligned}]=[\\begin{aligned}14 & -42 \\\\ 14 & 56\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186533993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "395065b4-ace6-5290-9bf5-9ae34338d260" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 3 \\\\ -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186533272} {:answer/id #uuid "a7154eb4-bcc0-5f39-b2ae-a197b10dfcda" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -1 \\\\ 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186533543} {:answer/id #uuid "d1260309-ef28-5201-b8ae-5cf3e6edba2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -1 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186533649} {:answer/id #uuid "d548f9e6-0754-56f7-b875-8b2dee34bc68" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & -3 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186533659} {:answer/id #uuid "e8c5a65a-fc58-5834-95f8-09e9880a2408" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -1 \\\\ -1 & 3\\end{aligned}]" :db/id #edb/ref 17592186533712}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -1 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186533649} :answer-field/id #uuid "9c4e1c8c-757e-5673-8cd0-b270c0c3c7e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533898}] :question/id #uuid "378ecb1a-5423-57cf-9a92-70fe30005016" :question/math-academy-id "q-265773" :question/problem "Consider the function $f:{R}^{2\\times 2}\\to R$ defined by \n\n$$\nf(X)=-\\operatorname{ln}⁡(det(X)).\n$$\n\n \nWhat is the gradient of $f$ with respect to $X$ at $X=[\\begin{aligned}-1 & -3 \\\\ 1 & 4\\end{aligned}]?$" :question/worked-solution "The gradient of a function $f:{R}^{m\\times n}\\to R$ with respect to a matrix $X\\in {R}^{m\\times n}$ is\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} & ⋯ & \\frac{∂f}{∂{x}_{1n}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}} & ⋯ & \\frac{∂f}{∂{x}_{2n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂f}{∂{x}_{m1}} & \\frac{∂f}{∂{x}_{m2}} & ⋯ & \\frac{∂f}{∂{x}_{mn}}\\end{aligned}].\n$$\n\nIn our case, writing out the function $f(X)$ where $X=[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}]\\in {R}^{2\\times 2}$, we get\n\n$$\nf(X)=-\\operatorname{ln}⁡(det(X))=-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21}).\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{12}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) \\\\ \\frac{∂}{∂{x}_{21}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21})) & \\frac{∂}{∂{x}_{22}}(-\\operatorname{ln}⁡({x}_{11}{x}_{22}-{x}_{12}{x}_{21}))\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{-{x}_{22}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & \\frac{{x}_{21}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} \\\\ \\frac{{x}_{12}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}} & \\frac{-{x}_{11}}{{x}_{11}{x}_{22}-{x}_{12}{x}_{21}}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating at $X=[\\begin{aligned}-1 & -3 \\\\ 1 & 4\\end{aligned}],$ we get\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}-\\frac{4}{-4-(-3)} & \\frac{1}{-4-(-3)} \\\\ \\frac{-3}{-4-(-3)} & -\\frac{(-1)}{-4-(-3)}\\end{aligned}]=[\\begin{aligned}-\\frac{4}{-1} & \\frac{1}{-1} \\\\ \\frac{-3}{-1} & -\\frac{(-1)}{-1}\\end{aligned}]=[\\begin{aligned}4 & -1 \\\\ 3 & -1\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186534003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e4db12b-c1a2-5b3a-90cc-1eec8b8e9e29" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 10 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186533211} {:answer/id #uuid "361becea-d4d4-5a84-ac95-a90decebb407" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 5 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186533266} {:answer/id #uuid "881b05f3-5a11-54ed-9622-0e746ae1581b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 10 \\\\ -6 & 8\\end{aligned}]" :db/id #edb/ref 17592186533464} {:answer/id #uuid "8dd57312-bdfb-5065-a149-96de4be679e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 15 \\\\ -9 & 12\\end{aligned}]" :db/id #edb/ref 17592186533482} {:answer/id #uuid "d21d4e11-51b9-5d89-985a-ece3e742b405" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -10 \\\\ -6 & 8\\end{aligned}]" :db/id #edb/ref 17592186533651}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 10 \\\\ -6 & 8\\end{aligned}]" :db/id #edb/ref 17592186533464} :answer-field/id #uuid "479c37e2-c9fe-54cc-8640-7226558adb45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533838}] :question/id #uuid "4c895033-c45a-5568-ba41-7003b1ce0b16" :question/math-academy-id "q-265980" :question/problem "Consider the function $f:{R}^{2\\times 2}\\to R$ defined by \n\n$$\nf(X)={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{x}_{ij}^{2}\n$$\n\n \nwhere ${x}_{ij}$ are the corresponding matrix's entries. What is the gradient of $f$ with respect to $X$ at $X=[\\begin{aligned}1 & 5 \\\\ -3 & 4\\end{aligned}]?$" :question/worked-solution "The gradient of a function $f:{R}^{m\\times n}\\to R$ with respect to a matrix $X\\in {R}^{m\\times n}$ is\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} & ⋯ & \\frac{∂f}{∂{x}_{1n}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}} & ⋯ & \\frac{∂f}{∂{x}_{2n}} \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\frac{∂f}{∂{x}_{m1}} & \\frac{∂f}{∂{x}_{m2}} & ⋯ & \\frac{∂f}{∂{x}_{mn}}\\end{aligned}].\n$$\n\nIn our case, writing out the function $f(X)$ where $X=[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}]\\in {R}^{2\\times 2}$, we get\n\n$$\nf(X)={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{x}_{ij}^{2}=({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}).\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}\\,\\,\\,{∇}_{X}f(X) & =[\\begin{aligned}\\frac{∂f}{∂{x}_{11}} & \\frac{∂f}{∂{x}_{12}} \\\\ \\frac{∂f}{∂{x}_{21}} & \\frac{∂f}{∂{x}_{22}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂{x}_{11}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) & \\frac{∂}{∂{x}_{12}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) \\\\ \\frac{∂}{∂{x}_{21}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2}) & \\frac{∂}{∂{x}_{22}}({x}_{11}^{2}+{x}_{12}^{2}+{x}_{21}^{2}+{x}_{22}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}2{x}_{11} & 2{x}_{12} \\\\ 2{x}_{21} & 2{x}_{22}\\end{aligned}] \\\\  & =2[\\begin{aligned}{x}_{11} & {x}_{12} \\\\ {x}_{21} & {x}_{22}\\end{aligned}] \\\\  & =2X.\\end{aligned}\n$$\n\nEvaluating at $X=[\\begin{aligned}1 & 5 \\\\ -3 & 4\\end{aligned}],$ we get\n\n$$\n{∇}_{X}f(X)=[\\begin{aligned}2\\cdot (1) & 2\\cdot (5) \\\\ 2\\cdot (-3) & 2\\cdot (4)\\end{aligned}]=[\\begin{aligned}2 & 10 \\\\ -6 & 8\\end{aligned}].\n$$"}] :knowledge-point/title "Computing the Gradient of a Function With Respect to a Matrix"} {:db/id #edb/ref 17592186204080 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203871 :question/id #uuid "5aa67862-6f7a-57ac-9473-d039fc4bfec4" :question/math-academy-id "e-17951" :question/problem "Consider the function $L: \\mathbb{R}^{2 \\times 3} \\rightarrow \\mathbb{R}$ defined by $L(\\mathbf{A}) = \\mathbf{y}^T\\mathbf{A}\\mathbf{x}$ where \n![](images/1d/1ddd8273660c1a84671e442af51d78ecc3df160fc0b807695c12297300118aa8.svg)\nWhat is $\\nabla_{\\mathbf{A}} L$ at \n![](images/c6/c66b8dc8fde116a844d833de35034c534b650a9b7f788eef8366e770f6923380.svg)" :question/worked-solution "The gradient of $L$ with respect to $\\mathbf{A}$ is a matrix of the same shape as $\\mathbf{A}$, with $(i,j)$th entry given by\n\n$$\n\\dfrac{\\partial L}{\\partial a_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $\\mathbf{A}.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL = \\sum\\limits_{i=1}^2 \\sum\\limits_{j=1}^3 a_{ij} y_i x_j,\n$$\n\nwe have\n\n$$\n\\dfrac{\\partial L}{\\partial a_{ij}} = y_i x_j.\n$$\n\nThus, $\\nabla_{\\mathbf{A}} L = \\mathbf{y} \\cdot \\mathbf{x}^T.$\n\nEvaluating at the given values ![](images/d8/d8a406621f1e60112d233f79cdde2e1405681554510ac4ea6af68409b4af4676.svg) and ![](images/df/dfa340dc46ddf622d0a16fdf8335a5183786294d395201e48f9adee4182bd91d.svg) we get\n\n![](images/b6/b6250171f2d99fb806cbb449b18f3a9c0513d8eac898d256d020e0b2cb986f8b.svg)"} :knowledge-point/id #uuid "35dc17b6-1c82-55ec-9657-20f2850794e5" :knowledge-point/questions [{:db/id #edb/ref 17592186204578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7257e47e-0bbc-5f6f-8e0d-fa05a95547d9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186541656} {:answer/id #uuid "736cbadd-3b7b-553e-ac3e-54c9d0aa1309" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 70 & 140 \\\\ 0 & 80 & 160\\end{aligned}]" :db/id #edb/ref 17592186541658} {:answer/id #uuid "90109471-65f3-534e-ab7f-25d38145cf97" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 70 & 80 \\\\ 140 & 160\\end{aligned}]" :db/id #edb/ref 17592186541713} {:answer/id #uuid "9df978fd-8d29-5189-99c3-1b1404d874c1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 10 & 70 \\\\ 20 & 80\\end{aligned}]" :db/id #edb/ref 17592186541751} {:answer/id #uuid "d4aa7742-e290-58bb-8b89-9a097ad03132" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 2 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186541876}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 70 & 140 \\\\ 0 & 80 & 160\\end{aligned}]" :db/id #edb/ref 17592186541658} :answer-field/id #uuid "f8abf9ca-ece0-5a55-b508-ff5cc5e98d71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203401}] :question/id #uuid "be0cbc5f-85e4-5a3d-bf50-d49616a38b87" :question/math-academy-id "q-268341" :question/problem "Consider the function $L:{R}^{2\\times 3}\\to R$ defined by $L(A)={y}^{T}Ax$ where \n\n$$\nx=[\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}],\\,y=[\\begin{aligned}7 \\\\ 8\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=y\\cdot {x}^{T}.$\n\nEvaluating at the given values $x=[\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}]$ and $y=[\\begin{aligned}7 \\\\ 8\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=[\\begin{aligned}7 \\\\ 8\\end{aligned}]\\cdot [\\begin{aligned}0 & 10 & 20\\end{aligned}]=[\\begin{aligned}0 & 70 & 140 \\\\ 0 & 80 & 160\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186204584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312a355a-904b-5eca-ae0f-c9e77ad2f94c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ -9 & -9 \\\\ 36 & 36\\end{aligned}]" :db/id #edb/ref 17592186541523} {:answer/id #uuid "3fa26cf7-587f-542e-bf6a-224a38d8a577" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 3 \\\\ 5 & 1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186541555} {:answer/id #uuid "c54ab21b-6f6b-5453-8f98-703092e388ed" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -18 \\\\ 72\\end{aligned}]" :db/id #edb/ref 17592186541838} {:answer/id #uuid "d64795ea-1505-54f8-ad01-cafe6fb7fa86" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ -3 & -3 \\\\ 12 & 12\\end{aligned}]" :db/id #edb/ref 17592186541880} {:answer/id #uuid "d830e853-f6f7-552e-b9bf-8e3dfedadf7a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -9 & 36 \\\\ 0 & -9 & 36\\end{aligned}]" :db/id #edb/ref 17592186541885}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ -9 & -9 \\\\ 36 & 36\\end{aligned}]" :db/id #edb/ref 17592186541523} :answer-field/id #uuid "bd1be76d-c3b1-5ea5-bbf6-626285d50488" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203432}] :question/id #uuid "6779795b-e35d-5389-887e-4355a853f59a" :question/math-academy-id "q-269388" :question/problem "Consider the function $L:{R}^{3\\times 2}\\to R$ defined by $L(A)=3({y}^{T}Ax)$ where \n\n$$\nx=[\\begin{aligned}3 \\\\ 3\\end{aligned}],\\,y=[\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}-2 & 3 \\\\ 5 & 1 \\\\ -1 & 0\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}3{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=3{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=3(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $x=[\\begin{aligned}3 \\\\ 3\\end{aligned}]$ and $y=[\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=3([\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}3 & 3\\end{aligned}])=3([\\begin{aligned}0 & 0 \\\\ -3 & -3 \\\\ 12 & 12\\end{aligned}])=[\\begin{aligned}0 & 0 \\\\ -9 & -9 \\\\ 36 & 36\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186533986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46954ab0-964a-57ab-8fa8-0e59d5360640" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 10 \\\\ -1 & -5 \\\\ 3 & 15\\end{aligned}]" :db/id #edb/ref 17592186533304} {:answer/id #uuid "4cadc966-a1c1-5a9a-b852-d767b4eda976" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 10 & -1 \\\\ -5 & 3 & 15\\end{aligned}]" :db/id #edb/ref 17592186533322} {:answer/id #uuid "61598bc1-09c8-541d-a2bc-495d7aa9e5da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{aligned}]" :db/id #edb/ref 17592186533363} {:answer/id #uuid "965ed177-569f-5e7f-8162-88c02d3a166d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}36 \\\\ -18 \\\\ 44\\end{aligned}]" :db/id #edb/ref 17592186533504} {:answer/id #uuid "a0550c2c-46e7-5b33-8b4a-ff7f9477e256" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 30 \\\\ 3 & 15 \\\\ 9 & 45\\end{aligned}]" :db/id #edb/ref 17592186533528}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{aligned}]" :db/id #edb/ref 17592186533363} :answer-field/id #uuid "843e0ee2-2793-547f-b5b3-9f47090c1d93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533879}] :question/id #uuid "26793c1a-40f5-5bd2-9877-7d31b77eb2ea" :question/math-academy-id "q-269383" :question/problem "Consider the function $L:{R}^{3\\times 2}\\to R$ defined by $L(A)=3({y}^{T}Ax)$ where \n\n$$\nx=[\\begin{aligned}1 \\\\ 5\\end{aligned}],\\,y=[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 0 \\\\ 0 & -2 \\\\ 4 & 1\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}3{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=3{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=3(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $x=[\\begin{aligned}1 \\\\ 5\\end{aligned}]$ and $y=[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=3([\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}1 & 5\\end{aligned}])=3([\\begin{aligned}2 & 10 \\\\ -1 & -5 \\\\ 3 & 15\\end{aligned}])=[\\begin{aligned}6 & 30 \\\\ -3 & -15 \\\\ 9 & 45\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186534000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beefbc8-bd1d-5f50-94c8-f0bd50eb330a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 \\\\ 4 & 8\\end{aligned}]" :db/id #edb/ref 17592186533162} {:answer/id #uuid "10a35172-bb8c-5131-950b-4bf83eaf50cd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 8\\end{align