db/ref 17592186550671} {:answer/id #uuid "d0ae9d64-3c04-543e-9bad-0f91c19f44f2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186550928} {:answer/id #uuid "db2ac3cb-cacf-5f7f-8f49-0a6d597fce81" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186550963} {:answer/id #uuid "f6d47fd4-271e-59b7-9dfb-e64e565385a2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186551029}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186550928} :answer-field/id #uuid "3af9e33e-f08c-574c-97d5-344ef1178cc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551102}] :question/id #uuid "7effc142-a727-5443-a7a6-2e2db67c4b1f" :question/math-academy-id "q-32008" :question/problem "Find the inverse of the elementary matrix \n$S=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}].$" :question/worked-solution "We write down $S$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[S\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -4 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 4 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{S}^{-1}=[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}].\n$$"}] :knowledge-point/title "Finding the Inverse of an Elementary 2x2 Matrix"} {:db/id #edb/ref 17592186115245 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115074 :question/id #uuid "ed71f469-f0e9-5016-846d-cb70d59ab3ea" :question/math-academy-id "e-4719" :question/problem "Find the product $E_1 E_{2}^{-1},$ where ![](images/c2/c26c31fb0c03ed31508d71c394a0cac97706b8e98f495758ef1bc3cb7b9de37f.svg) and ![](images/27/2728c629af340140b991c75f58104833304f4dc82d6f2f04b29b6ddde363b349.svg)" :question/worked-solution "Notice that $E_1$ and $E_2$ are both elementary matrices.\n\nFirst, we need to find $E_2^{-1}.$ We write down $E_2$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 2 \\\\ 0 & 1 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, \n![](images/11/11f12b427f63eb036d2f19210ab85c0a5b279bfda547031e8ae867d130aafc15.svg)\n\nNow, we can find the product $E_1 E_{2}^{-1}\\mathbin{:}$\n![](images/4c/4c46704dbedb6bb10fd40107493f49481923b4f1e524dc8f3f84d98aa4f66256.svg)"} :knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/questions [{:db/id #edb/ref 17592186115735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfc713a-679b-5cfa-9d6f-08a36b86fb51" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & 4 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436496} {:answer/id #uuid "a74234e5-d97b-566c-bed3-339abfaef5b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 4 \\\\ -11 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436498} {:answer/id #uuid "a8f73949-1a41-5465-a743-a686174de006" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & 4 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186436499} {:answer/id #uuid "c0bb3be0-28be-55c7-a77b-ae02e4febeba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ -3 & -11\\end{bmatrix}" :db/id #edb/ref 17592186436506} {:answer/id #uuid "e25a7759-8c03-50b5-a54a-8024f5ffd9a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & -3 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436513}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & 4 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436496} :answer-field/id #uuid "ed86b220-5180-5369-9230-c6b72b1d1579" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113376}] :question/id #uuid "1814a01e-7b9b-5bac-ab6c-86bbec04e6cd" :question/math-academy-id "q-31932" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & 4 \\\\ 0 & 1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =\\begin{bmatrix}1 & 0 & 1 & 0 \\\\ 3 & 1 & 0 & 1\\end{bmatrix} &  & {R}_{2}:={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 0 \\\\ 0 & 1 & -3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{2}^{-1}=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}.\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=\\begin{bmatrix}1 & 4 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}=\\begin{bmatrix}-11 & 4 \\\\ -3 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186115841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5cf453-a524-596c-a71c-3cc10ff9251a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]" :db