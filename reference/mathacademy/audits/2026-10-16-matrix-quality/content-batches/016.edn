/id #edb/ref 17592186436789}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436754} :answer-field/id #uuid "cb2a33dc-019b-539c-8057-1ac05dffb007" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436811}] :question/id #uuid "f990568f-351a-543d-9726-4bfca20a8616" :question/math-academy-id "q-75087" :question/problem "Suppose we are applying the elementary row operation ${R}_{1}:=-5{R}_{1}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:=-5{R}_{1}$ to $A.$  \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :=-5{R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186552440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d6e35e-81a7-51c8-a7cc-f32f8bec0ceb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186551711} {:answer/id #uuid "8f86283f-18b3-551e-a40d-cf34a8f4063d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{3}{2}\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552016} {:answer/id #uuid "b16f32c5-9c6a-55cb-ad66-50b0738320e6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\frac{3}{2} \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552093} {:answer/id #uuid "c9ef215c-9e2e-51a9-8bc6-e53e4bf54b39" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}-3 & 0 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186552147} {:answer/id #uuid "cc0a04ef-d28b-50c5-a529-054c7b32dde9" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & \\frac{3}{2} \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186552152}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{3}{2}\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552016} :answer-field/id #uuid "8fc02b48-7c0b-5dca-8522-1bed2f8f771b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552338}] :question/id #uuid "59ac31ae-d95c-5ade-b172-6fbd672350bd" :question/math-academy-id "q-42811" :question/problem "Suppose we are applying the elementary row operation ${R}_{2}:=\\frac{3}{2}{R}_{2}\\,$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}:=\\frac{3}{2}{R}_{2}$  to $A.$ \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{3}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{3}{2}\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\n \n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{3}{2}\\end{aligned}]\\cdot A\n$$"} {:db/id #edb/ref 17592186552496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f6ba4f-93fb-56ce-b313-ae6f537116c8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186551677} {:answer/id #uuid "7fa189dd-b632-5f86-b7d8-cf1dd08ab7a2" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186551968} {:answer/id #uuid "8f78e22d-2ddc-578a-9218-2dd0858ce54c" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186552015} {:answer/id #uuid "a1ab605b-a2db-549f-a707-66ed6395532a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552056} {:answer/id #uuid "fbe6fa94-e2a0-5a7d-8401-ed49b15524dc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552249}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186552056} :answer-field/id #uuid "a0e78fb8-ea62-56ea-9a31-70c6851e6dcb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552343}] :question/id #uuid "b6bf65ad-5479-5fb6-8133-3324438581f6" :question/math-academy-id "q-31997" :question/problem "Suppose we are applying the elementary row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix  multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ to $A.$ \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]\\cdot A\n$$"}] :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"} {:db/id #edb/ref 17592186115248 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115077 :question/id #uuid "0f08f8aa-63e3-500a-987e-e9888b9b0479" :question/math-academy-id "e-4722" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A\\mathbin{:}$\n\n$$\nR_1 \\leftrightarrow R_2, \\qquad  R_2:=R_2+3R_1\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is $R_1 \\leftrightarrow R_2.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is $R_2:=R_2+3R_1.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by $E_1$ on the left and get $E_1 A\\mathbin{:}$\n\n![](images/ea/ead4157a19d725334c44a55903b52bd12d7627e73696c2100efee52340347468.svg)\n\nThen, to apply the second elementary row operation to $E_1 A,$ we multiply by $E_2$ on the left and get $E_2 E_1 A\\mathbin{:}$\n\n![](images/ba/ba70270430d6c5606e816c16c606c8f3940742a48c95b0ad8a33f6c935da8cf6.svg)"} :knowledge-point/id #uuid "5c6f890b-fab1-51f1-9ac7-b680553c835a" :knowledge-point/questions [{:db/id #edb/ref 17592186115843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef54140-2672-5265-b691-9d3fb2cd1f4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327064} {:answer/id #uuid "2e06b7d4-773b-593e-9815-139447a16f89" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327347} {:answer/id #uuid "471c510b-7774-5214-a739-2e988dc25336" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327553} {:answer/id #uuid "b4b73e26-2fde-583d-8e80-fea1bc66c31f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186328505} {:answer/id #uuid "c3da354f-f4b4-5dbb-a0bf-56621d302948" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186328646}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327553} :answer-field/id #uuid "c9822533-fbcf-5b20-a3af-01eaee0b139a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329541}] :question/id #uuid "fd3b5a32-f5f9-54aa-b2af-a91ccc349130" :question/math-academy-id "q-42767" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{2}:=-2{R}_{2},\\,{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{2}:=-2{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:=-2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third elementary row operation is ${R}_{2}:={R}_{2}+3{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186115844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89c02ae4-ec2c-510f-ab0f-8fbe0a43e6f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix} \\cdot \\begin{bmatrix}1 & -5 \\\\ 0 & 1\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186114002} {:answer/id #uuid "a65e530e-4db2-5d11-b7d9-c1b9711125fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\cdot \\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186114003} {:answer/id #uuid "fea3ecae-491c-5586-a4e3-9680e9bb7baa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & -5\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186114004} {:answer/id #uuid "542dd187-a405-5cfa-96c6-5e349e462b59" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix} \\cdot \\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186114005} {:answer/id #uuid "77f3f22f-9e5c-5469-aab0-c1a46faac494" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\cdot \\begin{bmatrix}1 & -5 \\\\ 0 & 1\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186114006}] :answer-field/id #uuid "fde278ad-de95-5ef3-8