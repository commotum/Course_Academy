{1}{3}{R}_{2}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the three given elementary row operations. \n\n- The first elementary row operation is ${R}_{1}:=-5{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}:=-5{R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{2}:={R}_{2}+{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third elementary row operation is ${R}_{2}:=\\frac{1}{3}{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$ \n\n$$\n\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$\n\n \n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186299840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579d616-78a8-516c-9fe5-0f8eae33db70" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}\\frac{1}{3} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186297642} {:answer/id #uuid "ada80f79-a7e3-5ad9-99a1-6118d91b141a" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186298309} {:answer/id #uuid "adea5347-c355-585a-adfb-70d6dee66bdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298310} {:answer/id #uuid "b739caa3-4913-5223-b205-23b07f823f66" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298348} {:answer/id #uuid "e44d84ae-c620-5c69-9535-1f49151394ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298534}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298310} :answer-field/id #uuid "026b1493-140a-504e-a2a2-628b3df5debb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298651}] :question/id #uuid "76e5a507-45db-59c1-877b-e0a6e215a18d" :question/math-academy-id "q-32037" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{2},\\,{R}_{2}:=\\frac{1}{3}{R}_{2}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{1}:={R}_{1}+(-3){R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}:={R}_{1}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{2}:=\\frac{1}{3}{R}_{2}$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$ \n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186436814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2034d0-7cda-5f39-9589-90aba5659d9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436758} {:answer/id #uuid "49fe98f4-4ffc-5af2-83a4-d3f36bfa74f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436770} {:answer/id #uuid "4d910c4e-a0ac-50d5-9159-50d27df48002" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436771} {:answer/id #uuid "7a31368e-5bda-5127-82e3-a85cb11c6a79" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436778} {:answer/id #uuid "bc6c5718-69bf-54af-9c04-7a6648adfb74" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436790}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436770} :answer-field/id #uuid "98133f54-d0b4-500e-be6b-d23f4be79f09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436809}] :question/id #uuid "338846a1-5093-5e28-a69f-a5c5dede7770" :question/math-academy-id "q-130863" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{1}↔{R}_{2},\\,{R}_{1}={R}_{1}+6{R}_{2},\\,{R}_{1}=7{R}_{1}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{1}={R}_{1}+6{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}={R}_{1}+6{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third elementary row operation is ${R}_{1}=7{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}=7{R}_{1} \\\\  & ∼\\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$ \n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$\n\n \n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186436817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e96febe-54c3-5e3a-a3b3-7bd0082d0748" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436764} {:answer/id #uuid "9e1ac934-f42e-5421-a48c-557b71cea666" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436784} {:answer/id #uuid "ab7860a0-b9d2-5afc-af0b-2703b7594661" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436787} {:answer/id #uuid "f2338944-0fa0-5908-a315-427b16f9b9fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436799} {:answer/id #uuid "f88a4afc-f340-5d8a-8f8b-7f4abe4ed444" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186436802}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186436799} :answer-field/id #uuid "ef5c36a4-d082-5926-820f-4cd3513e1032" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436812}] :question/id #uuid "535f214d-c021-5eea-9acd-b13d4504df24" :question/math-academy-id "q-31977" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=2{R}_{2}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{2}:={R}_{2}+2{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{2}:=2{R}_{2}$ The corresponding elementary matrix can be found by applying this same elementary row  operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:=2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot A\n$$\n\n \n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186552411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09186fb4-7a2e-503b-b7a3-7e5633093c17" :answer/type {:db/ident :answer.type/math} :answer/value "