 :db/id #edb/ref 17592186365559}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186365559} :answer-field/id #uuid "26fe8616-4c36-5038-b2b4-083d78aa5a5c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365558} {:answer-field/choices [{:answer/id #uuid "265e6370-13a0-5365-a85a-1fa8ffd9b5ec" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186365561}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186365561} :answer-field/id #uuid "3e82b86c-b48d-5d20-b49c-d82eae08510b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365560}] :question/id #uuid "5d723d2c-4f49-5e0e-965f-ea46ba46c534" :question/math-academy-id "q-281975" :question/problem "Let $u=⟨1,-3,2⟩$ and $v=⟨4,2,-1⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 1 & -3 & 2 \\\\ 4 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & 2 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 4 & -1\\end{aligned}|j+|\\begin{aligned}1 & -3 \\\\ 4 & 2\\end{aligned}|k \\\\  & =((-3)(-1)-(2)(2))i-((1)(-1)-(2)(4))j+((1)(2)-(-3)(4))k \\\\  & =(3-4)i-(-1-8)j+(2+12)k \\\\  & =-1i+9j+14k \\\\  & =⟨-1,9,14⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c6a0d0-c117-5e96-b865-2dacd6e41994" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},5,1⟩" :db/id #edb/ref 17592186366193} {:answer/id #uuid "beb3960c-33f6-5ccc-90a2-4bf3a3443bc7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1+\\sqrt{2},5⟩" :db/id #edb/ref 17592186366194} {:answer/id #uuid "a982c283-6343-574c-a0c8-9e368c413e0c" :answ