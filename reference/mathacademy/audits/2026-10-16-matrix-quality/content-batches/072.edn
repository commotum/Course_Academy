\\end{aligned}\n$$\n\nLikewise, computing $BA$, we get\n\n$$\n\\begin{aligned}BA & =\\begin{bmatrix}-\\frac{1}{4} & -\\frac{1}{4} \\\\ \\frac{1}{2} & -\\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}-2 & 1 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & \\frac{1}{2} \\\\ -\\frac{1}{4} & -\\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{4} & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $C\\ne {A}^{-1}$ and statement III is true.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186557740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a595b9f-2009-5cbb-a94f-e043f6b53b8d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557716} {:answer/id #uuid "a8fa3fb1-f140-51b8-b6f4-7871b12200fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557754}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557716} :answer-field/id #uuid "012c00fa-4cb0-5960-a536-d71799c397f9" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557701} {:answer-field/choices [{:answer/id #uuid "7103b14f-02cf-5a7f-805e-a0dd3de7e261" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557735} {:answer/id #uuid "a027df56-7799-5590-ae3e-34bad820b71b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557752}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557735} :answer-fi