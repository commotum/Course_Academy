6k" :db/id #edb/ref 17592186540492}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-28i+31j-16k" :db/id #edb/ref 17592186540492} :answer-field/id #uuid "7b5cb85c-1fb0-58d6-b021-acc3af2b4754" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540469}] :question/id #uuid "2e010a3d-bc78-5472-b0fd-3b9999a59e7f" :question/problem "Let $u=6i+8j+5k$ and $v=-i-4j-6k.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 6 & 8 & 5 \\\\ -1 & -4 & -6\\end{aligned}| \\\\  & =|\\begin{aligned}8 & 5 \\\\ -4 & -6\\end{aligned}|i-|\\begin{aligned}6 & 5 \\\\ -1 & -6\\end{aligned}|j+|\\begin{aligned}6 & 8 \\\\ -1 & -4\\end{aligned}|k \\\\  & =((8)(-6)-(5)(-4))i-((6)(-6)-(5)(-1))j+((6)(-4)-(8)(-1))k \\\\  & =(-48-(-20))i-(-36-(-5))j+(-24-(-8))k \\\\  & =-28i+31j-16k \\\\  & =⟨-28,31,-16⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c322d1d5-fa93-5b4d-95c0-830b54df1e15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{2}" :db/id #edb/ref 17592186540494}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{2}" :db/id #edb/ref 17592186540494} :answer-field/id #uuid "672d067c-a7f8-5d32-b7dd-2a9c164ead57" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540466} {:answer-field/choices [{:answer/id #uuid "837c5d7e-5c7a-55c0-a1dd-2c6a1f5a7c94" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186540472}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186540472} :answer-field/id #uuid "71bcb1f3-c0ec-5af1-9ecb-8c82c317c35c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540468} {:answer-field/choices [{:answer/id #uuid "674927f3-92ff-5d26-a00d-cb0a1f3ad243" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19}{4}" :db/id #edb/ref 17592186540467}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19}{4}" :db/id #edb/ref 17592186540467} :answer-field/id #uuid "8fdcf7e5-dd52-509d-8532-451e7e4957a8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540479}] :question/id #uuid "3c34ce35-aef6-5c54-826e-13e18dd80841" :question/problem "Let $u=⟨3,\\frac{7}{2},-2⟩$ and $v=⟨\\frac{1}{2},-1,5⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 3 & \\frac{7}{2} & -2 \\\\ \\frac{1}{2} & -1 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{7}{2} & -2 \\\\ -1 & 5\\end{aligned}|i-|\\begin{aligned}3 & -2 \\\\ \\frac{1}{2} & 5\\end{aligned}|j+|\\begin{aligned}3 & \\frac{7}{2} \\\\ \\frac{1}{2} & -1\\end{aligned}|k \\\\  & =((\\frac{7}{2})(5)-(-2)(-1))i-((3)(5)-(-2)(\\frac{1}{2}))j+((3)(-1)-(\\frac{7}{2})(\\frac{1}{2}))k \\\\  & =(\\frac{35}{2}-(2))i-(15-(-1))j+(-3-(\\frac{7}{4}))k \\\\  & =\\frac{31}{2}i-16j-\\frac{19}{4}k \\\\  & =⟨\\frac{31}{2},-16,-\\frac{19}{4}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083370b1-ba72-5090-86d4-3a98f815ca42" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,-\\frac{79}{10},\\frac{17}{5}⟩" :db/id #edb/ref 17592186540442} {:answer/id #uuid "3aa1026d-b21a-538c-9efb-fc6dfba4a3e0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{79}{10},-\\frac{17}{5},2⟩" :db/id #edb/ref 17592186540455} {:answer/id #uuid "83d427ec-a05b-57c1-b3a1-26cb9989f5f2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12,-\\frac{121}{10},\\