186540485}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186540485} :answer-field/id #uuid "03642954-db1f-5b56-baba-c60918de52e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540441} {:answer-field/choices [{:answer/id #uuid "154386c8-e60b-57cd-89b8-ad30585cdf0f" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540444}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186540444} :answer-field/id #uuid "b20ad369-865c-5616-8eee-c0227b79e977" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540488} {:answer-field/choices [{:answer/id #uuid "43b45ff0-de68-500f-ae65-ebd7d951b4f0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540459}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540459} :answer-field/id #uuid "fda0061c-c650-5039-a061-eeffb1ce737c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540509}] :question/id #uuid "a0e7674f-c68b-5ba3-8599-974d4b1beac2" :question/problem "Let $u=4i+2j-\\frac{4}{3}k$ and $v=-4i+4j+\\frac{1}{3}k.$ Find $u\\times v.$\n\n$u\\times v=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -\\frac{4}{3} \\\\ -4 & 4 & \\frac{1}{3}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -\\frac{4}{3} \\\\ 4 & \\frac{1}{3}\\end{aligned}|i-|\\begin{aligned}4 & -\\frac{4}{3} \\\\ -4 & \\frac{1}{3}\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ -4 & 4\\end{aligned}|k \\\\  & =((2)(\\frac{1}{3})-(-\\frac{4}{3})(4))i-((4)(\\frac{1}{3})-(-\\frac{4}{3})(-4))j+((4)(4)-(2)(-4))k \\\\  & =(\\frac{2}{3}-(-\\frac{16}{3}))i-(\\frac{4}{3}-(\\frac{16}{3}))j+(16-(-8))k \\\\  & =6i+4j+24k \\\\  & =⟨6,4,24⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623cb650-31d9-54b8-9bee-37213ff85818" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-96,-97,83⟩" :db/id #edb/ref 17592186540463} {:answer/id #uuid "c08bfec9-3d10-5bc3-984f-9e939fddc88e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-13,-16⟩" :db/id #edb/ref 17592186540491} {:answer/id #uuid "d64868dc-1f49-5ce1-b0d7-eed1dcd1e41a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨16,1,13⟩" :db/id #edb/ref 17592186540501} {:answer/id #uuid "f5612d0c-c99c-537d-9979-f84cc01bbe92" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,1,-13⟩" :db/id #edb/ref 17592186540507} {:answer/id #uuid "fdb8aabb-ec39-5e90-af20-eadc617b1f6a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,-1,-13⟩" :db/id #edb/ref 17592186540510}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,-1,-13⟩" :db/id #edb/ref 17592186540510} :answer-field/id #uuid "ea74f3ed-f8b5-5a09-b41e-e7dc89984dd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540505}] :question/id #uuid "a2d00aa1-1933-5301-9a98-c10f6c0863aa" :question/problem "Let $u=⟨-7,8,8⟩$ and $v=⟨6,-5,-7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -7 & 8 & 8 \\\\ 6 & -5 & -7\\end{aligned}| \\\\  & =|\\begin{aligned}8 & 8 \\\\ -5 & -7\\end{aligned}|i-|\\begin{aligned}-7 & 8 \\\\ 6 & -7\\end{aligned}|j+|\\begin{aligned}-7 & 8 \\\\ 6 & -5\\end{aligned}|k \\\\  & =((8)(-7)-(8)(-5))i-((-7)(-7)-(8)(6))j+((-7)(-5)-(8)(6))k \\\\  & =(-56-(-40))i-(49-(48))j+(35-(48))k \\\\  & =-16i-j-13k \\\\  & =⟨-16,-1,-13⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4af1c12e-b138-529d-9912-81429586885e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{4},-\\frac{25}{4},\\frac{7}{2}⟩" :db/id #edb/ref 17592186540461} {:answer/id #uuid "66be531f-acfc-566c-952f-5c82b25ac6f7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},-\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540465} {:answer/id #uuid "a4e38e1f-ca4e-5edd-80e9-760d59c37bd4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540484} {:answer/id #uuid "c555375d-64f4-5eb0-baea-1a6328f3c1dd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{25}{4},-\\frac{7}{2},\\frac{3}{4}⟩" :db/id #edb/ref 17592186540495} {:answer/id #uuid "ecb70fa6-35b2-5b98-9141-cdcd799d17f0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{13}{4},-\\frac{15}{4},\\frac{3}{2}⟩" :db/id #edb/ref 17592186540506}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩" :db/id #edb/ref 17592186540484} :answer-field/id #uuid "98d0eee8-8d34-5f0a-b375-50554cb9ecc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540481}] :question/id #uuid "bf9484b3-9081-5c6e-811b-eb353ca9f662" :question/problem "Let $u=⟨-1,-1,-2⟩$ and $v=⟨-\\frac{5}{2},1,\\frac{5}{4}⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -1 & -1 & -2 \\\\ -\\frac{5}{2} & 1 & \\frac{5}{4}\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -2 \\\\ 1 & \\frac{5}{4}\\end{aligned}|i-|\\begin{aligned}-1 & -2 \\\\ -\\frac{5}{2} & \\frac{5}{4}\\end{aligned}|j+|\\begin{aligned}-1 & -1 \\\\ -\\frac{5}{2} & 1\\end{aligned}|k \\\\  & =((-1)(\\frac{5}{4})-(-2)(1))i-((-1)(\\frac{5}{4})-(-2)(-\\frac{5}{2}))j+((-1)(1)-(-1)(-\\frac{5}{2}))k \\\\  & =(-\\frac{5}{4}-(-2))i-(-\\frac{5}{4}-(5))j+(-1-(\\frac{5}{2}))k \\\\  & =\\frac{3}{4}i+\\frac{25}{4}j-\\frac{7}{2}k \\\\  & =⟨\\frac{3}{4},\\frac{25}{4},-\\frac{7}{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad1641c-1f9e-5a19-a1bd-de9ae95eebcf" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-16,-14,19⟩" :db/id #edb/ref 17592186540443} {:answer/id #uuid "18c7b2ce-0f71-5379-a623-1a6f1d78a86a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨23,-40,22⟩" :db/id #edb/ref 17592186540446} {:answer/id #uuid "3edbebec-ecdd-5817-bd77-9d3637fab5ee" :answer/type {:db/ident :answer.type/math} :answer/value "⟨19,16,-14⟩" :db/id #edb/ref 17592186540457} {:answer/id #uuid "58947e43-4c02-585a-bd90-052680ac2fae" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-19,16,14⟩" :db/id #edb/ref 17592186540462} {:answer/id #uuid "e264bf54-01ba-5db5-b058-20590668b59b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨19,-16,-14⟩" :db/id #edb/ref 17592186540503}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "⟨19,-16,-14⟩" :db/id #edb/ref 17592186540503} :answer-field/id #uuid "1ad656a5-0bd6-55c3-aa8e-589d9ffff31f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540447}] :question/id #uuid "c77adb70-a8ce-5278-ac35-a3c62801b336" :question/problem "Let $u=⟨4,3,2⟩$ and $v=⟨6,1,7⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 4 & 3 & 2 \\\\ 6 & 1 & 7\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ 1 & 7\\end{aligned}|i-|\\begin{aligned}4 & 2 \\\\ 6 & 7\\end{aligned}|j+|\\begin{aligned}4 & 3 \\\\ 6 & 1\\end{aligned}|k \\\\  & =((3)(7)-(2)(1))i-((4)(7)-(2)(6))j+((4)(1)-(3)(6))k \\\\  & =(21-(2))i-(28-(12))j+(4-(18))k \\\\  & =19i-16j-14k \\\\  & =⟨19,-16,-14⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84cdce99-2cbd-5246-99d6-107e6893a0bf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540474}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540474} :answer-field/id #uuid "269331d6-60db-5703-9390-545769dc2659" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540452} {:answer-field/choices [{:answer/id #uuid "818f4d56-b518-5b8a-8fc6-cf7c5020a3ef" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186540470}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186540470} :answer-field/id #uuid "d381ad1d-6f4c-5467-b7b4-b1487f9d214c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540500} {:answer-field/choices [{:answer/id #uuid "8bc0cd49-7383-58ed-aa44-fb8643e0805f" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186540478}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186540478} :answer-field/id #uuid "e2b3a723-99f1-5923-8530-c7f8cca93123" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540504}] :question/id #uuid "c864978d-b324-56a0-a971-f1464ab20fb6" :question/problem "Let $u=⟨-3,2,1⟩$ and $v=⟨4,-4,8⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -3 & 2 & 1 \\\\ 4 & -4 & 8\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ -4 & 8\\end{aligned}|i-|\\begin{aligned}-3 & 1 \\\\ 4 & 8\\end{aligned}|j+|\\begin{aligned}-3 & 2 \\\\ 4 & -4\\end{aligned}|k \\\\  & =((2)(8)-(1)(-4))i-((-3)(8)-(1)(4))j+((-3)(-4)-(2)(4))k \\\\  & =(16-(-4))i-(-24-(4))j+(12-(8))k \\\\  & =20i+28j+4k \\\\  & =⟨20,28,4⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186540499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "240d3498-fa54-5157-88f1-3818e0422e4a" :answer/type {:db/ident :answer.type/math} :answer/value "16i-\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540450} {:answer/id #uuid "27ea1601-7690-5806-b2f8-3fec36a8db4f" :answer/type {:db/ident :answer.type/math} :answer/value "8i+\\frac{107}{10}j-\\frac{11}{5}k" :db/id #edb/ref 17592186540453} {:answer/id #uuid "85523c49-77fc-5c77-be0e-f3d65c058fea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{37}{10}i+\\frac{59}{5}j+16k" :db/id #edb/ref 17592186540475} {:answer/id #uuid "c8659aa4-9b80-5734-ad39-99d9e9608d60" :answer/type {:db/ident :answer.type/math} :answer/value "-16i-\\frac{37}{10}j-\\frac{59}{5}k" :db/id #edb/ref 17592186540498} {:answer/id #uuid "da155be7-0d97-5290-b3c8-388435680f44" :answer/type {:db/ident :answer.type/math} :answer/value "16i+\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540502}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "16i+\\frac{37}{10}j+\\frac{59}{5}k" :db/id #edb/ref 17592186540502} :answer-field/id #uuid "c298c57a-7dab-5682-bf12-994f4328b57a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540493}] :question/id #uuid "c879baa4-8bcb-559c-9780-708721266a3e" :question/problem "Let $u=-\\frac{6}{5}i+2j+k$ and $v=-\\frac{7}{2}i-4j+6k.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -\\frac{6}{5} & 2 & 1 \\\\ -\\frac{7}{2} & -4 & 6\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ -4 & 6\\end{aligned}|i-|\\begin{aligned}-\\frac{6}{5} & 1 \\\\ -\\frac{7}{2} & 6\\end{aligned}|j+|\\begin{aligned}-\\frac{6}{5} & 2 \\\\ -\\frac{7}{2} & -4\\end{aligned}|k \\\\  & =((2)(6)-(1)(-4))i-((-\\frac{6}{5})(6)-(1)(-\\frac{7}{2}))j+((-\\frac{6}{5})(-4)-(2)(-\\frac{7}{2}))k \\\\  & =(12-(-4))i-(-\\frac{36}{5}-(-\\frac{7}{2}))j+(\\frac{24}{5}-(-7))k \\\\  & =16i+\\frac{37}{10}j+\\frac{59}{5}k \\\\  & =⟨16,\\frac{37}{10},\\frac{59}{5}⟩.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Cross Product Using Determinants"} {:db/id #edb/ref 17592186059737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059546 :question/id #uuid "b834e666-de4f-5964-a280-6571ad44b6bd" :question/math-academy-id "e-4343" :question/problem "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle,$ $\\mathbf{b}=\\langle 0,1,x \\rangle,$ and $|\\,\\mathbf{a} \\times \\mathbf{b}\\,| = \\sqrt{19}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & 1 & 2x \\\\ 0 & 1 & x\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2x \\\\ 1 & x\\end{aligned}|i-|\\begin{aligned}3 & 2x \\\\ 0 & x\\end{aligned}|j+|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|k \\\\  & =-xi-3xj+3k \\\\  & =⟨-x,-3x,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-x)^{2}+(-3x)^{2}+{3}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned} & |\\,a\\times b\\,|=\\sqrt{19} \\\\  & \\sqrt{10{x}^{2}+9}=\\sqrt{19} \\\\  & 10{x}^{2}+9=19 \\\\  & 10{x}^{2}=10 \\\\  & {x}^{2}=1\\end{aligned}\n$$\n\nTherefore, the solutions are $x= \\pm 1.$"} :knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/questions [{:db/id #edb/ref 17592186060193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0ce5e32-3c1d-5404-86e6-f7932392e881" :answer/type {:db/ident :answer.type/math} :answer/value "x =-2, 4" :db/id #edb/ref 17592186057619} {:answer/id #uuid "f9c8b204-d29c-5761-8cba-f27e9cbc5d7f" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 4" :db/id #edb/ref 17592186057620} {:answer/id #uuid "fcdba1be-9edd-5d40-b346-3e340548f303" :answer/type {:db/ident :answer.type/math} :answer/value "x =-4, 2" :db/id #edb/ref 17592186057621} {:answer/id #uuid "00c860b5-c434-5c39-8f01-47bc7c9168da" :answer/type {:db/ident :answer.type/math} :answer/value "x = 2, 4" :db/id #edb/ref 17592186057622} {:answer/id #uuid "69db0fa8-841d-593d-a4bf-71ff5a0f99f0" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 2" :db/id #edb/ref 17592186057623}] :answer-field/id #uuid "be852b51-f82d-5e6b-b6fe-b9dfab52ae79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057618}] :question/id #uuid "69d6674a-06bb-5f7c-b489-a0f3ce3b1128" :question/math-academy-id "q-19783" :question/problem "Let $a = ⟨1, 2, 3x⟩$, $b = ⟨4, 3, x⟩$ and $\\mid a \\cdot b|= \\sqrt{705}$. Find $x$.\n\n> A calculator is required to answer this question."} {:db/id #edb/ref 17592186060194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "639b58ff-7cc6-50b3-bbe7-473eed149f8e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{4}" :db/id #edb/ref 17592186285696} {:answer/id #uuid "6d146636-79d5-5f93-988b-ef107b6107b6" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{4}{3}" :db/id #edb/ref 17592186285788} {:answer/id #uuid "96ee0812-717b-516f-a6af-2df4936db43c" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{4}{3}" :db/id #edb/ref 17592186286160} {:answer/id #uuid "9f0ecf42-87a5-51c7-ada6-e8e1accc3524" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{3}{4}" :db/id #edb/ref 17592186286241} {:answer/id #uuid "a78cf6fe-6959-5fd6-96cd-441cf7f5493b" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{4}{3}" :db/id #edb/ref 17592186286315}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{4}{3}" :db/id #edb/ref 17592186286315} :answer-field/id #uuid "aedfe451-3be4-545f-acac-1c1f5c95d11b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287509}] :question/id #uuid "418b906a-1baf-59eb-8935-edc0e9f8b503" :question/math-academy-id "q-19786" :question/problem "Let $a=⟨2x,1,4⟩,$ $b=⟨2,0,3⟩$ and $|\\,a\\times b\\,|=\\sqrt{13}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 1 & 4 \\\\ 2 & 0 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 4 \\\\ 0 & 3\\end{aligned}|i-|\\begin{aligned}2x & 4 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}2x & 1 \\\\ 2 & 0\\end{aligned}|k \\\\  & =(3-0)i-(6x-8)j+(0-2)k \\\\  & =⟨3,-(6x-8),-2⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(-(6x-8))^{2}+(-2)^{2}} \\\\  & =\\sqrt{9+36{x}^{2}-96x+64+4} \\\\  & =\\sqrt{36{x}^{2}-96x+77}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{13} \\\\ \\sqrt{36{x}^{2}-96x+77} & =\\sqrt{13} \\\\ 36{x}^{2}-96x+77 & =13 \\\\ 36{x}^{2}-96x+64 & =0 \\\\ 9{x}^{2}-24x+16 & =0 \\\\ (3x-4)^{2} & =0 \\\\ 3x-4 & =0 \\\\ x & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186238016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384052f7-8479-5451-8826-ebad4be0b9cc" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186236174} {:answer/id #uuid "c5ceb671-4df1-5711-99a6-e539d10040f9" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186237068} {:answer/id #uuid "cbf06b23-9d73-58e3-96a2-bad6a11980c8" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4,2" :db/id #edb/ref 17592186237111} {:answer/id #uuid "d5aad3f9-96d0-5577-81a4-3ff8e34b23b9" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2,4" :db/id #edb/ref 17592186237166} {:answer/id #uuid "fd975286-7f8a-5f9b-80aa-d25b3f4ae72a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186237427}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186237068} :answer-field/id #uuid "3adb5c55-83aa-583d-aebb-812163c6902d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237517}] :question/id #uuid "1839cab9-bd67-5688-9a2a-104436b124ae" :question/math-academy-id "q-103540" :question/problem "Let $a=⟨2x,3,2⟩$, $b=⟨x,1,-1⟩$ and $|\\,a\\times b\\,|=\\sqrt{93}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 3 & 2 \\\\ x & 1 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ 1 & -1\\end{aligned}|i-|\\begin{aligned}2x & 2 \\\\ x & -1\\end{aligned}|j+|\\begin{aligned}2x & 3 \\\\ x & 1\\end{aligned}|k \\\\  & =(-3-2)i-(-2x-2x)j+(2x-3x)k \\\\  & =⟨-5,-4x,x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-5)^{2}+(-4x)^{2}+{x}^{2}} \\\\  & =\\sqrt{25+16{x}^{2}+{x}^{2}} \\\\  & =\\sqrt{17{x}^{2}+25}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{93} \\\\ \\sqrt{17{x}^{2}+25} & =\\sqrt{93} \\\\ 17{x}^{2}+25 & =93 \\\\ 17{x}^{2} & =68 \\\\ {x}^{2} & =4.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$"} {:db/id #edb/ref 17592186238017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c05b61-7dc6-53f0-8eed-7743ecb92787" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{4}" :db/id #edb/ref 17592186235813} {:answer/id #uuid "837899b1-cc2e-59cf-a23a-35f2ed00b6cd" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186236639} {:answer/id #uuid "90b48184-136a-57ff-a6c6-8aa6ad551689" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186236738} {:answer/id #uuid "9673d4c2-53f4-5a56-9462-97e02a7c3a6f" :answer/type {:db/ident :answer.type/math} :answer/value "x=2,4" :db/id #edb/ref 17592186236772} {:answer/id #uuid "b4be8d8f-4a66-536f-b059-008317284b6d" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186236961}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186236639} :answer-field/id #uuid "452b7748-b2b6-53f6-b879-d5ef2699fbff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237527}] :question/id #uuid "a06523df-238f-57e5-936a-f93168e3e76d" :question/math-academy-id "q-103541" :question/problem "Let $a=⟨-3,2,0⟩,$ $b=⟨2,-4,2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{77}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 2 & 0 \\\\ 2 & -4 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ -4 & 2x\\end{aligned}|i-|\\begin{aligned}-3 & 0 \\\\ 2 & 2x\\end{aligned}|j+|\\begin{aligned}-3 & 2 \\\\ 2 & -4\\end{aligned}|k \\\\  & =(4x-0)i-(-6x-0)j+(12-4)k \\\\  & =⟨4x,6x,8⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(6x)^{2}+(8)^{2}} \\\\  & =\\sqrt{16{x}^{2}+36{x}^{2}+64} \\\\  & =\\sqrt{52{x}^{2}+64}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{77} \\\\ \\sqrt{52{x}^{2}+64} & =\\sqrt{77} \\\\ 52{x}^{2}+64 & =77 \\\\ 52{x}^{2} & =13 \\\\ {x}^{2} & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\frac{1}{2}.$"} {:db/id #edb/ref 17592186238018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1042b2b0-48dd-582d-b30e-d64f5e68e655" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186235904} {:answer/id #uuid "531f08ba-c26d-5ffb-b31b-76da888b8b0e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{3}" :db/id #edb/ref 17592186236345} {:answer/id #uuid "95806bed-6677-52d1-86f0-a9c3b398a75a" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{3},3" :db/id #edb/ref 17592186236766} {:answer/id #uuid "dcc5b9af-1b07-5068-bffd-2500e6a28cbd" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,9" :db/id #edb/ref 17592186237209} {:answer/id #uuid "eb84ec79-c885-5346-994b-a3ef1e3618cb" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 9" :db/id #edb/ref 17592186237299}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186235904} :answer-field/id #uuid "6fd051b8-cfd0-500d-b748-e9e245e480d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237585}] :question/id #uuid "98e8a01d-ba49-5e10-81ec-e89893b65589" :question/math-academy-id "q-103542" :question/problem "Let $a=⟨-1,2x,3⟩,$ $b=⟨2,-x,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{355}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -1 & 2x & 3 \\\\ 2 & -x & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2x & 3 \\\\ -x & 1\\end{aligned}|i-|\\begin{aligned}-1 & 3 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 2x \\\\ 2 & -x\\end{aligned}|k \\\\  & =(2x+3x)i-(-1-6)j+(x-4x)k \\\\  & =⟨5x,7,-3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(5x)^{2}+(7)^{2}+(-3x)^{2}} \\\\  & =\\sqrt{25{x}^{2}+49+9{x}^{2}} \\\\  & =\\sqrt{34{x}^{2}+49}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{355} \\\\ \\sqrt{34{x}^{2}+49} & =\\sqrt{355} \\\\ 34{x}^{2}+49 & =355 \\\\ 34{x}^{2} & =306 \\\\ {x}^{2} & =9.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 3.$"} {:db/id #edb/ref 17592186238021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2396dede-1b82-5a2a-aa5a-3223ea475b72" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4,\\,5" :db/id #edb/ref 17592186236045} {:answer/id #uuid "5d433363-5f65-5914-a92b-e08e2d8de45b" :answer/type {:db/ident :answer.type/math} :answer/value "x=-10,\\,-2" :db/id #edb/ref 17592186236404} {:answer/id #uuid "acd9a719-7f3e-5a4e-b249-7cef823b6db8" :answer/type {:db/ident :answer.type/math} :answer/value "x=4,\\,10" :db/id #edb/ref 17592186236917} {:answer/id #uuid "b8694282-defb-545d-a22d-31c29f015388" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5,\\,4" :db/id #edb/ref 17592186236996} {:answer/id #uuid "bc4c7f2d-5e99-56fc-9df8-7f1922ff63db" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186237019}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=-10,\\,-2" :db/id #edb/ref 17592186236404} :answer-field/id #uuid "6c1bd1fc-a71d-5a23-a644-e9a570aa5b28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237580}] :question/id #uuid "fc2ecbe1-ea04-53ab-bfa6-277a8ca05a39" :question/math-academy-id "q-103547" :question/problem "Let $a=⟨4,x,3⟩,$ $b=⟨-2,3,0⟩$ and $|\\,a\\times b\\,|=\\sqrt{181}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & x & 3 \\\\ -2 & 3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}x & 3 \\\\ 3 & 0\\end{aligned}|i-|\\begin{aligned}4 & 3 \\\\ -2 & 0\\end{aligned}|j+|\\begin{aligned}4 & x \\\\ -2 & 3\\end{aligned}|k \\\\  & =(0-9)i-(0+6)j+(12+2x)k \\\\  & =⟨-9,-6,12+2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-9)^{2}+(-6)^{2}+(12+2x)^{2}} \\\\  & =\\sqrt{81+36+144+48x+4{x}^{2}} \\\\  & =\\sqrt{261+48x+4{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{181} \\\\ \\sqrt{261+48x+4{x}^{2}} & =\\sqrt{181} \\\\ 261+48x+4{x}^{2} & =181 \\\\ 4{x}^{2}+48x+80 & =0 \\\\ {x}^{2}+12x+20 & =0 \\\\ (x+10)(x+2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-10,\\,-2.$"} {:db/id #edb/ref 17592186238022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc2a099-bf95-50e1-b9c3-7330e50dafc6" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,10" :db/id #edb/ref 17592186236020} {:answer/id #uuid "2d7bbb8f-90eb-5b64-af7c-61e67a66ae8e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186236104} {:answer/id #uuid "422c528b-268c-59a9-aa08-17ee3b5fb935" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5,\\,2" :db/id #edb/ref 17592186236239} {:answer/id #uuid "457328c4-1a16-5b0d-8e61-d406b9702bba" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 10" :db/id #edb/ref 17592186236264} {:answer/id #uuid "a01206ba-e5ec-539f-b8df-b8f8806d9468" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2,\\,1" :db/id #edb/ref 17592186236817}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=-5,\\,2" :db/id #edb/ref 17592186236239} :answer-field/id #uuid "5b389ae5-8e6c-5abf-8392-283e3441d1c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237562}] :question/id #uuid "9e02b899-797e-55fb-bf98-84a59903fc4d" :question/math-academy-id "q-103549" :question/problem "Let $a=⟨0,3,4⟩,$ $b=⟨-1,-x,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{221}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ -1 & -x & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 4 \\\\ -x & 2\\end{aligned}|i-|\\begin{aligned}0 & 4 \\\\ -1 & 2\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ -1 & -x\\end{aligned}|k \\\\  & =(6+4x)i-(0+4)j+(0+3)k \\\\  & =⟨6+4x,-4,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(6+4x)^{2}+(-4)^{2}+(3)^{2}} \\\\  & =\\sqrt{36+48x+16{x}^{2}+16+9} \\\\  & =\\sqrt{61+48x+16{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{221} \\\\ \\sqrt{61+48x+16{x}^{2}} & =\\sqrt{221} \\\\ 61+48x+16{x}^{2} & =221 \\\\ 16{x}^{2}+48x-160 & =0 \\\\ {x}^{2}+3x-10 & =0 \\\\ (x+5)(x-2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-5,\\,2.$"} {:db/id #edb/ref 17592186238024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "139a429e-ade1-501e-b65f-dac725fd7e68" :answer/type {:db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186235932} {:answer/id #uuid "16719391-8dec-5e82-b401-93ca0e8487a0" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186235956} {:answer/id #uuid "49cb3763-a9d5-5bb5-9b6a-9d363519fada" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,2" :db/id #edb/ref 17592186236290} {:answer/id #uuid "a927a9d7-e41d-58d1-9c3c-54f2ab45e590" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,1" :db/id #edb/ref 17592186236882} {:answer/id #uuid "aa115508-6b4c-591b-b7d1-64700634a6e0" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,2" :db/id #edb/ref 17592186236891}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,1" :db/id #edb/ref 17592186236882} :answer-field/id #uuid "cde4e8a4-64c8-57b9-ac27-5d4fb7853626" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237711}] :question/id #uuid "357e8faf-9623-5ade-84da-303c65f27082" :question/math-academy-id "q-103552" :question/problem "Let $a=⟨0,-2,3⟩,$ $b=⟨-2,1,-2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{53}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & -2 & 3 \\\\ -2 & 1 & -2x\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & -2x\\end{aligned}|i-|\\begin{aligned}0 & 3 \\\\ -2 & -2x\\end{aligned}|j+|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(4x-3)i-(0+6)j+(0-4)k \\\\  & =⟨4x-3,-6,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x-3)^{2}+(-6)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16{x}^{2}-24x+9+36+16} \\\\  & =\\sqrt{16{x}^{2}-24x+61}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{53} \\\\ \\sqrt{16{x}^{2}-24x+61} & =\\sqrt{53} \\\\ 16{x}^{2}-24x+61 & =53 \\\\ 16{x}^{2}-24x+8 & =0 \\\\ 2{x}^{2}-3x+1 & =0 \\\\ (2x-1)(x-1) & =0 \\\\ x & =\\frac{1}{2},\\,1.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{1}{2},\\,1.$"} {:db/id #edb/ref 17592186287959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5faf31-a027-54f6-893d-fa34e1417998" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5,-4" :db/id #edb/ref 17592186285338} {:answer/id #uuid "493b1d43-5539-572e-ab49-36f99c567690" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186285461} {:answer/id #uuid "55ef5465-6e15-524b-ae92-901d3537d994" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186285578} {:answer/id #uuid "e52f12ca-7b96-5ce8-9839-d0542ceca526" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 5" :db/id #edb/ref 17592186286885} {:answer/id #uuid "fdeb9f25-fa5b-5fd4-a92b-3143e29bce7a" :answer/type {:db/ident :answer.type/math} :answer/value "x=4,5" :db/id #edb/ref 17592186287111}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186285578} :answer-field/id #uuid "4f1a7ec0-67e0-5864-a6a8-3f8391794ca7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287324}] :question/id #uuid "421f4045-e8df-5b08-89fb-dae822bc3289" :question/math-academy-id "q-19785" :question/problem "Let $a=⟨x,2,3⟩$, $b=⟨2x,5,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{393}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 2 & 3 \\\\ 2x & 5 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|i-|\\begin{aligned}x & 3 \\\\ 2x & 2\\end{aligned}|j+|\\begin{aligned}x & 2 \\\\ 2x & 5\\end{aligned}|k \\\\  & =(4-15)i-(2x-6x)j+(5x-4x)k \\\\  & =⟨-11,4x,x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-11)^{2}+(4x)^{2}+{x}^{2}} \\\\  & =\\sqrt{121+16{x}^{2}+{x}^{2}} \\\\  & =\\sqrt{17{x}^{2}+121}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{393} \\\\ \\sqrt{17{x}^{2}+121} & =\\sqrt{393} \\\\ 17{x}^{2}+121 & =393 \\\\ 17{x}^{2} & =272 \\\\ {x}^{2} & =16.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 4.$"} {:db/id #edb/ref 17592186292833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b70cc5e3-ce9b-587a-856e-446f9654bd7e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186291425}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186291425} :answer-field/id #uuid "088b5a0c-ad44-5fc4-9428-330d1ccbe936" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291769} {:answer-field/choices [{:answer/id #uuid "5deb2570-5a15-57c0-8f85-5aad6b606da9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186291033}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186291033} :answer-field/id #uuid "18dbf2c9-5d0b-5815-b5f5-495a6394fcc0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291829}] :question/id #uuid "7c72f4aa-ab5b-5b58-b34b-802301025714" :question/math-academy-id "q-275278" :question/problem "Let $a=⟨-2x,3,5⟩,$ $b=⟨2x,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{909}.$ Then, in **ascending order**,  the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -2x & 3 & 5 \\\\ 2x & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 5 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}-2x & 5 \\\\ 2x & 1\\end{aligned}|j+|\\begin{aligned}-2x & 3 \\\\ 2x & 0\\end{aligned}|k \\\\  & =(3-0)i-(-2x-10x)j+(0-6x)k \\\\  & =⟨3,12x,-6x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(12x)^{2}+(-6x)^{2}} \\\\  & =\\sqrt{9+144{x}^{2}+36{x}^{2}} \\\\  & =\\sqrt{180{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{909} \\\\ \\sqrt{180{x}^{2}+9} & =\\sqrt{909} \\\\ 180{x}^{2}+9 & =909 \\\\ 180{x}^{2} & =900 \\\\ {x}^{2} & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\sqrt{5},$ $x=\\sqrt{5}.$"} {:db/id #edb/ref 17592186295037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e708bcc-57d6-5c73-b04e-955486a1bf34" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293557}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293557} :answer-field/id #uuid "48faf064-a2f6-51ea-9045-dffbdc7bd32a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294187}] :question/id #uuid "7575e8a2-e97b-54b4-80f9-81b1c7ceb471" :question/math-academy-id "q-278839" :question/problem "Let $a=⟨x,2,1⟩,$ $b=⟨2,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{20}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 2 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 1 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}x & 2 \\\\ 2 & 0\\end{aligned}|k \\\\  & =(2-0)i-(x-2)j+(0-4)k \\\\  & =⟨2,2-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(2-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{4+4-4x+{x}^{2}+16} \\\\  & =\\sqrt{{x}^{2}-4x+24}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{20} \\\\ \\sqrt{{x}^{2}-4x+24} & =\\sqrt{20} \\\\ {x}^{2}-4x+24 & =20 \\\\ {x}^{2}-4x+4 & =0 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the solution is $x=2.$"} {:db/id #edb/ref 17592186295235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6399e3b8-ff34-55fc-a47f-71dc471f219c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293339}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293339} :answer-field/id #uuid "5fd515cd-c214-5167-b7ba-c4def2042247" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294272} {:answer-field/choices [{:answer/id #uuid "6d675942-4fa7-5d27-8386-58830bed7ca6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293390}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293390} :answer-field/id #uuid "d3f82250-dec1-5957-8cd9-d5e3812caae9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294676}] :question/id #uuid "a3a69df9-3422-55c4-b6e2-d44c3f81e8dc" :question/math-academy-id "q-282260" :question/problem "Let $a=⟨2x,3,1⟩,$ $b=⟨-2x,0,4⟩$ and $|\\,a\\times b\\,|=\\sqrt{280}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 3 & 1 \\\\ -2x & 0 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 0 & 4\\end{aligned}|i-|\\begin{aligned}2x & 1 \\\\ -2x & 4\\end{aligned}|j+|\\begin{aligned}2x & 3 \\\\ -2x & 0\\end{aligned}|k \\\\  & =(12-0)i-(8x+2x)j+(0+6x)k \\\\  & =⟨12,-10x,6x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{12}^{2}+(-10x)^{2}+(6x)^{2}} \\\\  & =\\sqrt{144+100{x}^{2}+36{x}^{2}} \\\\  & =\\sqrt{136{x}^{2}+144}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{280} \\\\ \\sqrt{136{x}^{2}+144} & =\\sqrt{280} \\\\ 136{x}^{2}+144 & =280 \\\\ 136{x}^{2} & =136 \\\\ {x}^{2} & =1\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-1,$ $x=1.$"} {:db/id #edb/ref 17592186295236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c089ac0-6345-5a8c-b62f-0ed057920e41" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293300}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293300} :answer-field/id #uuid "07bd3ca9-b08b-5bba-b233-e5435a9a2640" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293950} {:answer-field/choices [{:answer/id #uuid "593dad82-9cf7-57f0-a8f9-1d4350843ab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293290}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293290} :answer-field/id #uuid "2929fa13-2cfd-51a7-8f49-b45196662e2c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294067}] :question/id #uuid "8e10f888-66d4-5375-8f79-b8da98cf5664" :question/math-academy-id "q-282261" :question/problem "Let $a=⟨x,0,1⟩,$ $b=⟨-x,2,0⟩$ and $|\\,a\\times b\\,|=\\sqrt{29}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 0 & 1 \\\\ -x & 2 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}|i-|\\begin{aligned}x & 1 \\\\ -x & 0\\end{aligned}|j+|\\begin{aligned}x & 0 \\\\ -x & 2\\end{aligned}|k \\\\  & =(0-2)i-(0+x)j+(2x+0)k \\\\  & =⟨-2,-x,2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-2)^{2}+(-x)^{2}+(2x)^{2}} \\\\  & =\\sqrt{4+{x}^{2}+4{x}^{2}} \\\\  & =\\sqrt{5{x}^{2}+4}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{29} \\\\ \\sqrt{5{x}^{2}+4} & =\\sqrt{29} \\\\ 5{x}^{2}+4 & =29 \\\\ 5{x}^{2} & =25 \\\\ {x}^{2} & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\sqrt{5},$ $x=\\sqrt{5}.$"} {:db/id #edb/ref 17592186295237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fe042d9-f712-540a-9a31-4c3f6a49c2a2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293064}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293064} :answer-field/id #uuid "472a2680-c3e4-5a4b-bf63-8a3b7676904d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294182} {:answer-field/choices [{:answer/id #uuid "8df1edb2-60a1-5e25-a033-c22d6600a279" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293481}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293481} :answer-field/id #uuid "ecc407dd-1a3f-56e7-be3e-e7615f20ae61" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294760}] :question/id #uuid "999eb6f6-f5c6-519d-9ac7-4875fbf986b8" :question/math-academy-id "q-282262" :question/problem "Let $a=⟨x,3,0⟩,$ $b=⟨-x,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{49}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 3 & 0 \\\\ -x & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 0 \\\\ -x & 1\\end{aligned}|j+|\\begin{aligned}x & 3 \\\\ -x & 0\\end{aligned}|k \\\\  & =(3-0)i-(x+0)j+(0+3x)k \\\\  & =⟨3,-x,3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(-x)^{2}+(3x)^{2}} \\\\  & =\\sqrt{9+{x}^{2}+9{x}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{49} \\\\ \\sqrt{10{x}^{2}+9} & =\\sqrt{49} \\\\ 10{x}^{2}+9 & =49 \\\\ 10{x}^{2} & =40 \\\\ {x}^{2} & =4\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-2,$ $x=2.$"} {:db/id #edb/ref 17592186295238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d647f4-bc4e-5f76-acc3-d8205ef31c67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293195}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293195} :answer-field/id #uuid "8623129c-f6e8-53ae-bd31-d59d37637d0c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294406}] :question/id #uuid "59e9fba3-4db6-5c48-86ed-2af0a557b731" :question/math-academy-id "q-282269" :question/problem "Let $a=⟨x,1,1⟩,$ $b=⟨1,0,3⟩$ and $|\\,a\\times b\\,|=\\sqrt{10}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 1 & 1 \\\\ 1 & 0 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ 0 & 3\\end{aligned}|i-|\\begin{aligned}x & 1 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}x & 1 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(3-0)i-(3x-1)j+(0-1)k \\\\  & =⟨3,1-3x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(1-3x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+(9{x}^{2}-6x+1)+1} \\\\  & =\\sqrt{9{x}^{2}-6x+11}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{10} \\\\ \\sqrt{9{x}^{2}-6x+11} & =\\sqrt{10} \\\\ 9{x}^{2}-6x+11 & =10 \\\\ (3x-1)^{2} & =0 \\\\ 3x-1 & =0 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{3}.$"} {:db/id #edb/ref 17592186295239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63fe025d-813b-5f9a-9c06-c0556ddb9547" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293343}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293343} :answer-field/id #uuid "c20c34ca-4ea2-51bf-9889-6f3124593e13" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294618}] :question/id #uuid "f7de1193-053f-5234-9520-07973769fe4c" :question/math-academy-id "q-282270" :question/problem "Let $a=⟨x,1,2⟩,$ $b=⟨1,0,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{5}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 1 & 2 \\\\ 1 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}x & 2 \\\\ 1 & 2\\end{aligned}|j+|\\begin{aligned}x & 1 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(2-0)i-(2x-2)j+(0-1)k \\\\  & =⟨2,2-2x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(2-2x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{4+(4{x}^{2}-8x+4)+1} \\\\  & =\\sqrt{4{x}^{2}-8x+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{5} \\\\ \\sqrt{4{x}^{2}-8x+9} & =\\sqrt{5} \\\\ 4{x}^{2}-8x+9 & =5 \\\\ 4{x}^{2}-8x+4 & =0 \\\\ (2x-2)^{2} & =0 \\\\ 2x-2 & =0 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$"} {:db/id #edb/ref 17592186295240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cb1d18-d1e0-565d-bb78-b6a4658bbe13" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186292974}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186292974} :answer-field/id #uuid "03c55d87-7acb-572f-811d-7189f6ef9993" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293940} {:answer-field/choices [{:answer/id #uuid "0b32daaa-10cc-5583-9726-450366961c84" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292978}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292978} :answer-field/id #uuid "508dcba7-f96e-5b1d-99d9-43b1a4ce626c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294216}] :question/id #uuid "fe9d7249-168a-5810-85b9-89bad6dafc21" :question/math-academy-id "q-282276" :question/problem "Let $a=⟨x,4,5⟩,$ $b=⟨1,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{33}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 4 & 5 \\\\ 1 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}4 & 5 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 5 \\\\ 1 & 1\\end{aligned}|j+|\\begin{aligned}x & 4 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(4-0)i-(x-5)j+(0-4)k \\\\  & =⟨4,5-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{4}^{2}+(5-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+(25-10x+{x}^{2})+16} \\\\  & =\\sqrt{{x}^{2}-10x+57}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{33} \\\\ \\sqrt{{x}^{2}-10x+57} & =\\sqrt{33} \\\\ {x}^{2}-10x+57 & =33 \\\\ {x}^{2}-10x+24 & =0 \\\\ (x-4)(x-6) & =0 \\\\ x & =4,\\,x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=4,$ $x=6.$"} {:db/id #edb/ref 17592186295241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44a3a765-13c2-5f3d-89c8-752a0cc1e107" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293214}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293214} :answer-field/id #uuid "c018ffe1-59c2-5c29-85ed-cac2b8dc9161" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294612} {:answer-field/choices [{:answer/id #uuid "7e6e2225-14bc-5817-b2b0-9fa7c511b22e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293441}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293441} :answer-field/id #uuid "d9a690fb-f7f4-52fd-8017-428f88655eec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294695}] :question/id #uuid "d9b76997-cb19-548e-a5c8-ac57874f667e" :question/math-academy-id "q-282278" :question/problem "Let $a=⟨2x,1,4⟩,$ $b=⟨3,0,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{157}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2x & 1 & 4 \\\\ 3 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 4 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}2x & 4 \\\\ 3 & 2\\end{aligned}|j+|\\begin{aligned}2x & 1 \\\\ 3 & 0\\end{aligned}|k \\\\  & =(2-0)i-(4x-12)j+(0-3)k \\\\  & =⟨2,12-4x,-3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(12-4x)^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+(144-96x+16{x}^{2})+9} \\\\  & =\\sqrt{16{x}^{2}-96x+157}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{157} \\\\ \\sqrt{16{x}^{2}-96x+157} & =\\sqrt{157} \\\\ 16{x}^{2}-96x+157 & =157 \\\\ 16{x}^{2}-96x & =0 \\\\ 16x(x-6) & =0 \\\\ x & =0,\\,x=6\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=0,$ $x=6.$"} {:db/id #edb/ref 17592186345295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ba9575-4116-5da1-9d13-75fddafe1880" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186342813} {:answer/id #uuid "56459a3a-433a-5d89-a00c-d2db7f4af24d" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\sqrt{3}" :db/id #edb/ref 17592186342956} {:answer/id #uuid "b56ab6d7-6374-51b8-a73a-573a9c6d25f1" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186343828} {:answer/id #uuid "e0d83a2c-baf4-5473-8f83-d89b478ba56a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186344213} {:answer/id #uuid "ebf2aebc-fe9e-54f8-8ae7-fef78f976954" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\sqrt{2}" :db/id #edb/ref 17592186344305}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\sqrt{3}" :db/id #edb/ref 17592186342956} :answer-field/id #uuid "2a05ee8c-a6f2-5705-ac77-f7c2d74908f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344565}] :question/id #uuid "c996c916-6d56-55b9-8504-9c0842874c89" :question/math-academy-id "q-77427" :question/problem "Let $a=⟨2,x,1⟩,$ $b=⟨1,-x,3⟩$ and $|\\,a\\times b\\,|=10.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & x & 1 \\\\ 1 & -x & 3\\end{aligned}| \\\\  & =|\\begin{aligned}x & 1 \\\\ -x & 3\\end{aligned}|i-|\\begin{aligned}2 & 1 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}2 & x \\\\ 1 & -x\\end{aligned}|k \\\\  & =(3x+x)i-(6-1)j+(-2x-x)k \\\\  & =⟨4x,-5,-3x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(-5)^{2}+(-3x)^{2}} \\\\  & =\\sqrt{16{x}^{2}+25+9{x}^{2}} \\\\  & =\\sqrt{25({x}^{2}+1)}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =10 \\\\ \\sqrt{25({x}^{2}+1)} & =10 \\\\ 25({x}^{2}+1) & =100 \\\\ {x}^{2}+1 & =4 \\\\ {x}^{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\sqrt{3}.$"} {:db/id #edb/ref 17592186345296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00fa6337-ab0d-5160-a611-2ddc8da0cf63" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186342253} {:answer/id #uuid "09269469-cfd9-5d57-8d8b-42fdb071211c" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,4" :db/id #edb/ref 17592186342313} {:answer/id #uuid "23a6c0cd-5de2-535e-b93e-c6aa000f9907" :answer/type {:db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186342534} {:answer/id #uuid "51e0ea9c-50b6-5b70-92d8-61c5f756d8a1" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,2" :db/id #edb/ref 17592186342915} {:answer/id #uuid "f6c26781-a599-5f95-bd31-c91372b3df28" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186344409}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186342534} :answer-field/id #uuid "0083fa75-a1b0-5b25-a910-a26f765c9e50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344494}] :question/id #uuid "d7c9e319-7861-5d4f-b23a-d86c9fbc5eb3" :question/math-academy-id "q-77429" :question/problem "Let $a=⟨2,0,-4⟩,$ $b=⟨-1,1,2x⟩$ and $|\\,a\\times b\\,|=2\\sqrt{5}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & 0 & -4 \\\\ -1 & 1 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -4 \\\\ 1 & 2x\\end{aligned}|i-|\\begin{aligned}2 & -4 \\\\ -1 & 2x\\end{aligned}|j+|\\begin{aligned}2 & 0 \\\\ -1 & 1\\end{aligned}|k \\\\  & =(0+4)i-(4x-4)j+(2-0)k \\\\  & =⟨4,-4x+4,2⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{4}^{2}+(-4x+4)^{2}+{2}^{2}} \\\\  & =\\sqrt{16+16{x}^{2}-32x+16+4} \\\\  & =\\sqrt{16{x}^{2}-32x+36}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =2\\sqrt{5} \\\\ \\sqrt{16{x}^{2}-32x+36} & =2\\sqrt{5} \\\\ 16{x}^{2}-32x+36 & =20 \\\\ 16{x}^{2}-32x+16 & =0 \\\\ 16({x}^{2}-2x+1) & =0 \\\\ {x}^{2}-2x+1 & =0 \\\\ (x-1)^{2} & =0 \\\\ x-1 & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$"} {:db/id #edb/ref 17592186366198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c6f3048-c777-5c58-90fe-219a1e995028" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,2" :db/id #edb/ref 17592186366200} {:answer/id #uuid "6fd8a995-6178-5f31-b28a-0d7684d7534e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 6" :db/id #edb/ref 17592186366201} {:answer/id #uuid "609d7569-0efb-5912-8d7e-ef9c759ef0bb" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186366202} {:answer/id #uuid "1416b5a2-f91d-5f4c-bd8d-6c79bf571891" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,6" :db/id #edb/ref 17592186366203} {:answer/id #uuid "3aafa1d8-531c-5437-99ef-3fa345bb7b50" :answer/type {:db/ident :answer.type/math} :answer/value "x=2,\\,6" :db/id #edb/ref 17592186366204}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=2,\\,6" :db/id #edb/ref 17592186366204} :answer-field/id #uuid "b200d0bf-bed1-5cf6-8f1e-f47e978d20c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366199}] :question/id #uuid "fcbb93c0-afa4-55f5-929f-c8cc83bbc10c" :question/math-academy-id "q-69776" :question/problem "Let $a=⟨4,2,-1⟩$, $b=⟨x,2,-1⟩$ and $|\\,a\\times b\\,|=\\sqrt{20}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ x & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ x & -1\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ x & 2\\end{aligned}|k \\\\  & =(-2+2)i-(-4+x)j+(8-2x)k \\\\  & =⟨0,4-x,8-2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{0}^{2}+(4-x)^{2}+(8-2x)^{2}} \\\\  & =\\sqrt{16-8x+{x}^{2}+64-32x+4{x}^{2}} \\\\  & =\\sqrt{5{x}^{2}-40x+80}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{20} \\\\ \\sqrt{5{x}^{2}-40x+80} & =\\sqrt{20} \\\\ 5{x}^{2}-40x+80 & =20 \\\\ 5{x}^{2}-40x+60 & =0 \\\\ {x}^{2}-8x+12 & =0 \\\\ (x-2)(x-6) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=2,\\,6.$"}] :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :topic/math-academy-id 245 :topic/title "Calculating the Cross Product Using Determinants"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186060662} :activity/id #uuid "57e9a8cd-9225-5fac-965e-807daa0874c9" :activity/steps [{:db/id #edb/ref 17592186060662 :step/content {:db/id #edb/ref 17592186060935 :tutorial/content "Remember that we can represent a system of two linear equations in two variables using matrices. We can do the same thing for a system of three linear equations in three variables, such as the following:\n\n$$\n\\left\\{\\begin{aligned}3x+2y\\text{ }-\\text{ }2z &=7 \\\\ 2x\\text{ }-\\text{ }1y\\text{ }-\\text{ }4z &=2 \\\\ 2x+1y\\text{ }-\\text{ }3z &=3\\end{aligned}\\right.\n$$\n\nFor a $3 \\times 3$ system like the one above, we put the coefficients of the system into a $3 \\times 3$ coefficient matrix:\n\n![](images/40/40541d2ecb10c763056ae72734e723a9d5967ed9accaf0bbde6f2a2f9ec96b65.svg)\n\nEach row has the coefficients of one of the equations in the system, and each column consists of the coefficients of one particular variable.\nWe also have the $3 \\times 1$ column vectors\n\n![](images/e5/e56ed72d2d17f9a4bc59bfe51a96534a72ebe481a312b8e9c6c028ade96d3748.svg)\n\nwhere $\\mathbf{b}$ consists of each constant on the right side of the system and $\\mathbf{x}$ contains the variables.\nWith these matrices, we can write our system as $A\\mathbf{x} = \\mathbf{b},$ or\n\n![](images/f0/f06e5a54e106bcdca8b5cbad677ade3476ba8f6218b4aa79d196f54e0fff3e2c.svg)\n\nWe can write any system of three equations with three variables in this form. Just to check that the above equation is true, let's multiply out the left-hand side to see if it equals the right-hand side:\n\n$$\n\\begin{aligned}Ax & =\\begin{bmatrix}3 & 2 & -2 \\\\ 2 & -1 & -4 \\\\ 2 & 1 & -3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} \\\\  & =\\begin{bmatrix}3x+2y\\text{ }-\\text{ }2z \\\\ 2x\\text{ }-\\text{ }1y\\text{ }-\\text{ }4z \\\\ 2x+1y\\text{ }-\\text{ }3z\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 \\\\ 2 \\\\ 3\\end{bmatrix} \\\\  & =b\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "93427b42-9f68-58e3-a3fd-19c5c8c58d90" :tutorial/math-academy-id 3053 :tutorial/title "Introduction"} :step/id #uuid "944c9195-2d49-5b9d-bc5c-1cd47e01dc13" :step/next {:db/id #edb/ref 17592186060663}} {:db/id #edb/ref 17592186060663 :step/content {:db/id #edb/ref 17592186059757 :knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"} :step/id #uuid "c9335040-4892-53be-90b2-54e91913879f" :step/next {:db/id #edb/ref 17592186060664}} {:db/id #edb/ref 17592186060664 :step/content {:db/id #edb/ref 17592186059758 :knowledge-point/id #uuid "7958ef60-8041-535b-bff8-b35e84c54412"} :step/id #uuid "02ca150a-020c-573f-96d1-90c2f5331c52"}] :activity/title "Representing 3x3 Systems of Equations Using a Matrix Product" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186059888}] :db/id #edb/ref 17592186049151 :topic/knowledge-points [{:db/id #edb/ref 17592186059757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059566 :question/id #uuid "7bfcfcbb-6212-5f9b-90aa-c79fbf7221e9" :question/math-academy-id "e-4518" :question/problem "The system of equations\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}6x+4y &=1 \\\\ x-8y-z &=-2 \\\\ 3x+2y-2z &=1\\end{aligned}\\right.\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n![](images/21/212a3beac5ede3786bad835a693b0a725f331de41d6969dce7f17925dde012d7.svg)\n\nWhat are the values of $a,$ $b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}6x+4y+0z &=1 \\\\ x-8y-z &=-2 \\\\ 3x+2y-2z &=1\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $A\\mathbf{x} = \\mathbf{b},$ where\n\n![](images/22/22034036ec7859b56e9e19124e33fa616eddfc3784e15f8074583e28253a4bae.svg)\n\nis the coefficient matrix,\n\n![](images/b5/b5e0f47e7c4bb15e8923bceb665dcc87944090e3a39f9a335b17ab0b85025cc8.svg)\n\nis the column vector of constants, and\n\n![](images/b6/b643463daef16c2179d6f6320d31353a23b042f3774295eb55e48af0242ec655.svg)\n\nis the column vector of variables.\n\nSo, the equation $A\\mathbf{x} = \\mathbf{b}$ becomes\n\n![](images/bf/bf8fb79fd8998c5c867fc371535e26f2e92bea5fa7262789bd44aea07e24f93c.svg)\n\nTherefore, $a=6,$ $b=2,$ and $c=-2.$"} :knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152" :knowledge-point/questions [{:db/id #edb/ref 17592186060276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099fa1e0-d872-5eb5-81ed-b3b1edaada04" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=-6,\\,c=11" :db/id #edb/ref 17592186321222} {:answer/id #uuid "138e861a-0cc2-58a9-9676-1ec3e92f91ad" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=-6,\\,c=1" :db/id #edb/ref 17592186321303} {:answer/id #uuid "7024eba8-43e2-5236-ad74-99d0c32d9f47" :answer/type {:db/ident :answer.type/math} :answer/value "a=-4,\\,b=-4,\\,c=11" :db/id #edb/ref 17592186322019} {:answer/id #uuid "806f8895-3e66-5150-bdff-c12b2f1ea7b1" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=11,\\,c=-4" :db/id #edb/ref 17592186322157} {:answer/id #uuid "ce2f6adf-c8fe-58ac-9550-1c74ef4b3ac8" :answer/type {:db/ident :answer.type/math} :answer/value "a=11,\\,b=-4,\\,c=1" :db/id #edb/ref 17592186322755}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=-6,\\,c=11" :db/id #edb/ref 17592186321222} :answer-field/id #uuid "dbe13b71-8293-5712-8025-31df3dbc7ef9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323607}] :question/id #uuid "5006a5f1-0a5e-50bb-a47b-7da41b1e709f" :question/math-academy-id "q-36181" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-4y+z &=2 \\\\ x-6y+11z &=3 \\\\ 3x-4y-z &=4\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}3 & -4 & a \\\\ 1 & b & c \\\\ 3 & -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -4 & 1 \\\\ 1 & -6 & 11 \\\\ 3 & -4 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$\n\nTherefore, $a=1,\\,b=-6,\\,c=11.$"} {:db/id #edb/ref 17592186060277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95c60b2a-194d-505f-801d-b642b8d5f5ba" :answer/type {:db/ident :answer.type/math} :answer/value "a = 6, b =-8, c =-2" :db/id #edb/ref 17592186058285} {:answer/id #uuid "0883bc07-91cf-5cb0-94a7-a183fb2b8093" :answer/type {:db/ident :answer.type/math} :answer/value "a = 5, b = 8, c = 0" :db/id #edb/ref 17592186058286} {:answer/id #uuid "16cdaee5-2022-5f46-b3a5-8ab4a158cad4" :answer/type {:db/ident :answer.type/math} :answer/value "a = 5, b = 8, c =-2" :db/id #edb/ref 17592186058287} {:answer/id #uuid "28f939ee-f0c9-599c-834a-2bd50f55c7ae" :answer/type {:db/ident :answer.type/math} :answer/value "a = 6, b = 0, c = 1" :db/id #edb/ref 17592186058288} {:answer/id #uuid "30ddafd0-59d6-557e-b5af-a34b20845676" :answer/type {:db/ident :answer.type/math} :answer/value "a = 5, b =-4, c = 7" :db/id #edb/ref 17592186058289}] :answer-field/id #uuid "15271f0f-aeb5-5bda-944e-c54b67eef4d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058284}] :question/id #uuid "61d02474-f2c0-5a11-b107-93d690d3e573" :question/math-academy-id "q-36184" :question/problem "The system of equations\n${2x + 6y + 5z = 3; x - 4y + 8z = 1; - 2y + 8z = 7$\n\ncan be represented using matrix notation as\n$\\begin{bmatrix}2 & 6 & a \\\\ 1 & -4 & b \\\\ c & -2 & 8\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} = \\begin{bmatrix}3 \\\\ 1 \\\\ 7\\end{bmatrix}$.\n\nWhat are the values of $a, b$ and $c$?"} {:db/id #edb/ref 17592186237776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b883705-4f13-564f-a1ef-126507d3f930" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=2,\\,c=3" :db/id #edb/ref 17592186236693} {:answer/id #uuid "ab2c609e-ade1-504f-b56a-cbe1ca68518e" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=1,\\,c=1" :db/id #edb/ref 17592186236899} {:answer/id #uuid "c3feefde-7b37-5a86-8f6e-b0c208a50961" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=2,\\,c=1" :db/id #edb/ref 17592186237055} {:answer/id #uuid "ef6c207b-ce5d-57b0-82bc-7b3988df6723" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=1,\\,c=-3" :db/id #edb/ref 17592186237330} {:answer/id #uuid "f669d9e4-9bbe-5b98-a671-93ce001f7f05" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=1,\\,c=1" :db/id #edb/ref 17592186237372}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=1,\\,c=1" :db/id #edb/ref 17592186237372} :answer-field/id #uuid "16abb40e-e765-53e3-90ea-7a181a9af49c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237465}] :question/id #uuid "9047fc55-30cd-5bc7-96fe-e8f5b01aa182" :question/math-academy-id "q-10004" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}y+2z &=0 \\\\ x+2y+3z &=2 \\\\ 3x+y+z &=-3\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}0 & a & 2 \\\\ b & 2 & 3 \\\\ 3 & 1 & c\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}0x+y+2z &=0 \\\\ x+2y+3z &=2 \\\\ 3x+y+z &=-3\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}.\n$$\n\nTherefore, $a=1,\\,b=1,\\,c=1.$"} {:db/id #edb/ref 17592186265929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "261340b2-1a0d-59dd-8b7b-76c4f7bfb121" :answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-3,\\,c=1" :db/id #edb/ref 17592186263331} {:answer/id #uuid "3823e286-9476-5d05-a64b-0bd2a3d821f5" :answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-1,\\,c=1" :db/id #edb/ref 17592186263509} {:answer/id #uuid "6457994c-cd91-5a4c-915f-080f701162d6" :answer/type {:db/ident :answer.type/math} :answer/value "a=-1,\\,b=-5,\\,c=9" :db/id #edb/ref 17592186263869} {:answer/id #uuid "aa7ea0e9-94d6-53d4-928a-c09488c89e60" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=-3,\\,c=1" :db/id #edb/ref 17592186264456} {:answer/id #uuid "fa260fff-d100-5b94-a5b3-239f605d176d" :answer/type {:db/ident :answer.type/math} :answer/value "a=2,\\,b=-7,\\,c=-1" :db/id #edb/ref 17592186265190}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "a=4,\\,b=-3,\\,c=1" :db/id #edb/ref 17592186263331} :answer-field/id #uuid "a814f1c0-7e30-52d3-b5a0-1628f163bffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265547}] :question/id #uuid "585d1fdd-e4b6-5cfa-bfaf-54e4bf0c7de2" :question/math-academy-id "q-130535" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}2x-5y+z &=1 \\\\ -x-3y+9z &=-2 \\\\ 4x-7y-z &=5\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}2 & -5 & c \\\\ -1 & b & 9 \\\\ a & -7 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}2 & -5 & 1 \\\\ -1 & -3 & 9 \\\\ 4 & -7 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}2 & -5 & 1 \\\\ 1 & -3 & 9 \\\\ 4 & -7 & -1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}.\n$$\n\nTherefore, $a=4,\\,b=-3,\\,c=1.$"} {:db/id #edb/ref 17592186265930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b6213e-6630-5cbc-a2be-bba26537e9d3" :answer/type {:db/ident :answer.type/math} :answer/value "a=-3,\\,b=1,\\,c=2" :db/id #edb/ref 17592186263842} {:answer/id #uuid "98683e89-44c4-5b63-a6a0-5143070e1a4e" :answer/type {:db/ident :answer.type/math} :answer/value "a=-4,\\,b=8,\\,c=-3" :db/id #edb/ref 17592186264311} {:answer/id #uuid "a16f2ca2-4f2e-5acc-9b55-06d4bbfa6420" :answer/type {:db/ident :answer.type/math} :answer/value "a=0,\\,b=8,\\,c=1" :db/id #edb/ref 17592186264374} {:answer/id #uuid "dc08dfd2-1ae1-53cb-adad-40873d7ac878" :answer/type {:db/ident :answer.type/math} :answer/value "a=1,\\,b=7,\\,c=8" :db/id #edb/ref 17592186264916} {:answer/id #uuid "f9db3e03-47ba-53e0-8851-1e7f8c0aa7b5" :answer/type {:db/ident :answer.type/math} :answer/value "a=-6,\\,b=8,\\,c=5" :db/id #edb/ref 17592186265185}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "a=-6,\\,b=8,\\,c=5" :db/id #edb/ref 17592186265185} :answer-field/id #uuid "21ecd5d5-730f-53a8-b7fd-5892a28e6ac7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265304}] :question/id #uuid "718180b1-bf73-575f-add7-0f6c8d9bba0d" :question/math-academy-id "q-130536" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}-3x+y+7z &=5 \\\\ x-4y+8z &=1 \\\\ -6y+9z &=2\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & b \\\\ 0 & a & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}c \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b,$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}-3x+y+7z &=5 \\\\ x-4y+8z &=1 \\\\ 0x-6y+9z &=2\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}5 \\\\ 1 \\\\ 2\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-3 & 1 & 7 \\\\ 1 & -4 & 8 \\\\ 0 & -6 & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, $a=-6,\\,b=8,\\,c=5.$"} {:db/id #edb/ref 17592186292857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505018d9-5f40-5fe6-a2bd-8371d403497f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186290974}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186290974} :answer-field/id #uuid "31adadd0-5d60-5f06-b25f-16789378a818" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291902} {:answer-field/choices [{:answer/id #uuid "d591b4c2-08ff-5aaa-b44a-f770b77524f0" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186291529}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186291529} :answer-field/id #uuid "4fcd008a-d164-500a-b986-f81a0ace138f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291982} {:answer-field/choices [{:answer/id #uuid "50e80a16-e3c8-55c9-9435-066d6712c90c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186290977}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186290977} :answer-field/id #uuid "9b8794de-38d3-5c1e-a536-6f39850c2a60" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292226} {:answer-field/choices [{:answer/id #uuid "bff71819-0595-5166-8e24-1cbd5f3a41e9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291459}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291459} :answer-field/id #uuid "db86b1f5-873e-5caf-abb7-1046d566f145" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292417}] :question/id #uuid "d46bf19a-ed33-55bb-809b-da0d9d2e99d7" :question/math-academy-id "q-275511" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y+2z &=5 \\\\ 2x+6y+5z &=22 \\\\ x-2y-3z &=-1\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $1$ | {{field-1}} | $2$ |  |  |  | $x$ |  |  |  | $5$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-2}} | $6$ | $5$ |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | $1$ | $-2$ | {{field-4}} |  |  |  | $z$ |  |  |  | $-1$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}x+2y+2z &=5 \\\\ 2x+6y+5z &=22 \\\\ x-2y-3z &=-1\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 & 2 \\\\ 2 & 6 & 5 \\\\ 1 & -2 & -3\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}5 \\\\ 22 \\\\ -1\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & 2 & 2 \\\\ 2 & 6 & 5 \\\\ 1 & -2 & -3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 22 \\\\ -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85806f6e-3f8d-56f5-8841-0e3c0a47083a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298128}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298128} :answer-field/id #uuid "4f730fa1-b5c3-50b2-9976-270a3b0b824a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298906} {:answer-field/choices [{:answer/id #uuid "97ab1973-03cd-5f88-a18f-9217286fd9f6" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298209}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298209} :answer-field/id #uuid "6bda87eb-624b-5dc0-a615-09034a4dd617" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298994} {:answer-field/choices [{:answer/id #uuid "7150ff71-c085-5d5f-84bc-cd85d9ef931f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298040}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298040} :answer-field/id #uuid "8c396013-8c55-5d91-a811-c1d7554b13b5" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299104} {:answer-field/choices [{:answer/id #uuid "91f9c034-96b3-537d-95ac-54136e6ff76c" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298185}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298185} :answer-field/id #uuid "cda9e946-5a85-5e86-9781-1b1870f198bf" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299324}] :question/id #uuid "193f944c-d77c-5446-9a05-12850a3f60de" :question/math-academy-id "q-316961" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-y+z &=0 \\\\ 5x+y-7z &=-2 \\\\ -2x+4y+3z &=4\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $3$ | $-1$ | $1$ |  |  |  | $x$ |  |  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-2}} | $1$ | {{field-3}} |  |  |  | $y$ |  | $=$ |  | $-2$ |  | . |\n|  |  | $-2$ | {{field-4}} | $3$ |  |  |  | $z$ |  |  |  | $4$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n\\left\\{\\begin{aligned}3x-y+z &=0 \\\\ 5x+y-7z &=-2 \\\\ -2x+4y+3z &=4\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & -1 & 1 \\\\ 5 & 1 & -7 \\\\ -2 & 4 & 3\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}0 \\\\ -2 \\\\ 4\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & -1 & 1 \\\\ 5 & 1 & -7 \\\\ -2 & 4 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -2 \\\\ 4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eee0a92-9818-543d-ae05-10acd9e7f8eb" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298254}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/