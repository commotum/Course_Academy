bmatrix}1 \\\\ 8 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & 0 & 1 \\\\ 3 & -1 & 4 \\\\ -4 & 1 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 8 \\\\ -3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a2fb2d2-a047-5a7b-8de1-aaf147b55032" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186297929}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186297929} :answer-field/id #uuid "410a1886-34cc-5722-9768-eca20e5dd7ea" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298861} {:answer-field/choices [{:answer/id #uuid "0160d63e-87bd-5b5e-b053-0997bcbc468e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297557}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297557} :answer-field/id #uuid "51490a83-eb61-5035-98ce-dd397defe17a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298912} {:answer-field/choices [{:answer/id #uuid "709f7f8f-0658-5422-9b5d-08f16d4c9e84" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186298035}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186298035} :answer-field/id #uuid "740d74c4-b71d-5fc5-88e4-eeaec02cadd5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299031} {:answer-field/choices [{:answer/id #uuid "6c66bd92-05cc-5cd7-90e1-c9117e3327bd" :answer/type {:db/ident :answer.type/math} :answer/value