\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $C={A}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186237922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a10723d3-f77a-5b16-956e-675d06c9d2d4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461219} {:answer/id #uuid "f4b5ac11-5a94-5e5a-a683-6eaa4e645176" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461220}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461220} :answer-field/id #uuid "b422ac1d-59ce-5d06-b337-6b4fb303c18d" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462363} {:answer-field/choices [{:answer/id #uuid "af232cd6-6074-5587-a841-b1542a97130d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461221} {:answer/id #uuid "334f6eb6-4b47-5b3c-8bc3-bb880538becd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461222}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461221} :answer-field/id #uuid "511e276a-2d5e-5717-a6b1-f14915606998" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462364} {:answer-field/choices [{:answer/id #uuid "70774628-24bb-5d09-9ef7-435773771f49" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461223} {:answer/id #uuid "4971f816-a7a2-57fa-806c-3e7c66ba4153" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461224}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 