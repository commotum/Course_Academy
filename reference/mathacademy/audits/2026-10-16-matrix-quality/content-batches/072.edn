choices [{:answer/id #uuid "206ed248-3cd2-539e-b50d-49612fa287d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186293070}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186293070} :answer-field/id #uuid "7fa4f1cc-54f8-508d-a192-eae9487f5d08" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294378} {:answer-field/choices [{:answer/id #uuid "3914a06d-7f57-5936-b194-290d53f5ce2c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293170}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293170} :answer-field/id #uuid "e1c84dcb-89ee-5e21-8ea6-ed91a4b53259" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294723} {:answer-field/choices [{:answer/id #uuid "9ef8b931-9b98-5d0c-99d9-ea541bd11cc4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293561}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293561} :answer-field/id #uuid "e719e1d2-40c8-5431-8d76-a930299c3197" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294745}] :question/id #uuid "ebbf8822-5fa0-5a01-b2fc-91f9cedbb9cd" :question/math-academy-id "q-281977" :question/problem "Let $u=⟨\\frac{2}{3},0,1⟩$ and $v=⟨1,2,-3⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ \\frac{2}{3} & 0 & 1 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & -3\\end{aligned}|i-|\\begin{aligned}\\frac{2}{3} & 1 \\\\ 1 & -3\\end{aligned}|j+|\\begin{aligned}\\frac{2}{3} & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =((0)(-3)-(1)(2))i-((\\frac{2}{3})(-3)-(1)(1))j+((\\frac{2}{3})(2)-(0)(1))k \\\\  & =(0-2)i-(-2-1)j+(\\frac{4}{3})k \\\\  & =-2i+3j+(\\frac{4}{3})k \\\\  & =⟨-2,3,\\frac{4}{3}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b44127f-a4f1-59db-a5fa-7d63a0c9645c" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186293043}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186293043} :answer-field/id #uuid "282cf90a-c11f-5994-8580-74e9e92203de" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294059} {:answer-field/choices [{:answer/id #uuid "315eb770-798e-5410-a0c2-d0a4dbf87dba" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186293138}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186293138} :answer-field/id #uuid "2a78322e-0555-55b0-afa5-1bb49e5edaba" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294071} {:answer-field/choices [{:answer/id #uuid "c0d015c3-d7d4-534a-b0aa-919041f75109" :answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186293683}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186293683} :answer-field/id #uuid "b2cd9183-da7e-516c-99ec-326f4a8fd66a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294574}] :question/id #uuid "5dd1f450-2fd9-570b-82aa-62d00ac130e3" :question/math-academy-id "q-282143" :question/problem "Let $a=3i-4j+k$ and $b=-2i+5j+6k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -2 & 5 & 6\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 5 & 6\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -2 & 6\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -2 & 5\\end{aligned}|k \\\\  & =((-4)(6)-(1)(5))i-((3)(6)-(1)(-2))j+((3)(5)-(-4)(-2))k \\\\  & =(-24-5)i-(18+2)j+(15-8)k \\\\  & =-29\\,i-20\\,j+7\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20b4abf1-83f6-5db6-8a1c-71a3d039a704" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293072}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293072} :answer-field/id #uuid "75fb4821-c09b-5cda-9e7f-92035716dba0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294344} {:answer-field/choices [{:answer/id #uuid "4965135f-6793-52b6-afb9-7d2821f4d6dd" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186293234}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186293234} :answer-field/id #uuid "afb66c75-459b-55d9-9985-8158a336e7c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294558} {:answer-field/choices [{:answer/id #uuid "dcb6b898-1fb3-5a08-bbf8-7bff3cc110b5" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293789}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293789} :answer-field/id #uuid "ce8b31bf-d4b9-5a79-8364-b915e624af4d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294658}] :question/id #uuid "334ad845-67a7-568d-adb2-3211cbc38bf2" :question/math-academy-id "q-282144" :question/problem "Let $a=i+2j-5k$ and $b=-3i+4j+k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 2 & -5 \\\\ -3 & 4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -5 \\\\ 4 & 1\\end{aligned}|i-|\\begin{aligned}1 & -5 \\\\ -3 & 1\\end{aligned}|j+|\\begin{aligned}1 & 2 \\\\ -3 & 4\\end{aligned}|k \\\\  & =(2\\cdot 1-(-5)(4))i-(1\\cdot 1-(-5)(-3))j+(1\\cdot 4-2\\cdot (-3))k \\\\  & =(2+20)i-(1-15)j+(4+6)k \\\\  & =22\\,i+14\\,j+10\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e49f891-25ac-5d49-ac4f-5eb0e46e9e68" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186292995}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186292995} :answer-field/id #uuid "871b4091-3d4b-544a-96ce-38e9e8d450d4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294410} {:answer-field/choices [{:answer/id #uuid "e18f36b4-1950-5298-b7cc-09551d6f6e45" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293815}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293815} :answer-field/id #uuid "9cba51cc-0ec3-5651-a8d3-710bbffd7097" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294495} {:answer-field/choices [{:answer/id #uuid "ad107009-b4ba-5e50-a5e1-c7dcd792ffc3" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186293609}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186293609} :answer-field/id #uuid "f659de