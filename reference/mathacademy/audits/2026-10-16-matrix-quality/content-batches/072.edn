}{2} & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $G\\ne {E}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186557746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a0f523-b1e4-57b4-8986-3d408f116ada" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557715} {:answer/id #uuid "4f30ad3a-ebca-54d0-80d8-eb5e24d49530" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557720}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557720} :answer-field/id #uuid "8f860d9c-0f4b-51cc-941b-fa8e0bb36f8f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557743} {:answer-field/choices [{:answer/id #uuid "539f2745-380c-5c87-9c4b-698d2d8a5ae1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557722} {:answer/id #uuid "e59853dc-024a-5613-8bda-a7a5ad6a4077" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557787}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557787} :answer-field/id #uuid "d9e9e3af-3b8c-5fe9-9bf6-926f2aefd6ba" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557781} {:answer-field/choices [{:answer/id #uuid "1373a24c-5358-54bd-954f-2cee9ede5935" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557705} {:answer/id #uuid "d2d87237-4b30-5309-9ba1-cf6d51133951" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557778}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557778} :answer-field/id #uuid