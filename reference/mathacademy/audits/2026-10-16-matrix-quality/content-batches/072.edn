ac{2}{3} \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{3}{4} & \\frac{3}{4} \\\\ -\\frac{1}{2} & -\\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & ∗ \\\\ \\frac{5}{4} & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}-\\frac{2}{3} & \\frac{2}{3} \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{3}{4} & -\\frac{1}{2} \\\\ \\frac{3}{4} & -\\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{3}{4} & -\\frac{1}{2} \\\\ \\frac{3}{4} & -\\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-\\frac{2}{3} & \\frac{2}{3} \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $C={A}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186557796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58cf03af-8176-5bb0-b78f-02e392065bcc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557724} {:answer/id #uuid "ae2bfeeb-8629-57aa-9218-a109b80f97f7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557757}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557757} :answer-field/id #uuid "13d4c9e5-cfb7-5da5-a46f-651c8e8beaf2" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557706} {:answer-field/choices [{:answer/id #uuid "5f11ee68-1cd3-56f2-85d3-5aada7c69161" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557727} {:answer/id #uuid "b9235f58-a9e8-5