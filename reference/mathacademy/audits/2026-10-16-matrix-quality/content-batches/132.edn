 & 4 & 2\\end{aligned}|" :db/id #edb/ref 17592186263164} {:answer/id #uuid "a165b042-7361-54c1-ae6b-729e098360fb" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 3 & -7 & 0 \\\\ 22 & 5 & -1 & -2 \\\\ 0 & -5 & 3 & 0 \\\\ 7 & 3 & 4 & \\frac{5}{2}\\end{aligned}|" :db/id #edb/ref 17592186264373} {:answer/id #uuid "d5f5d612-a58c-57b0-bd69-b2f65c367c29" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -7 & 0 & 0 \\\\ 5 & -1 & 3 & -2 \\\\ -5 & 3 & 8 & 0 \\\\ 3 & 4 & 2 & \\frac{5}{2}\\end{aligned}|" :db/id #edb/ref 17592186264862} {:answer/id #uuid "dbc89729-2f0a-549b-8335-d4789e732f8f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & \\sqrt{5} & 5 & 8 \\\\ 1 & 3 & -7 & 0 \\\\ 22 & 5 & -1 & 3 \\\\ 0 & -5 & 3 & 8\\end{aligned}|" :db/id #edb/ref 17592186264913}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 3 & -7 & 0 \\\\ 22 & 5 & -1 & -2 \\\\ 0 & -5 & 3 & 0 \\\\ 7 & 3 & 4 & \\frac{5}{2}\\end{aligned}|" :db/id #edb/ref 17592186264373} :answer-field/id #uuid "26e079f0-97b0-5db9-8745-45c40ce2bb00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265317}] :question/id #uuid "e92be295-8dc5-5c90-8355-ba0b4a005245" :question/math-academy-id "q-130803" :question/problem "Find the minor of  ${e}_{14}$ in  $E=\\begin{bmatrix}3 & \\sqrt{5} & 5 & 8 & 5 \\\\ 1 & 3 & -7 & 0 & 0 \\\\ 22 & 5 & -1 & 3 & -2 \\\\ 0 & -5 & 3 & 8 & 0 \\\\ 7 & 3 & 4 & 2 & \\frac{5}{2}\\end{bmatrix}.$" :question/worked-solution "To get the minor of ${e}_{14}$, we remove the $1$st row and $4$th column:\n\n$$\nE=\\begin{bmatrix}∗ & ∗ & ∗ & 8 & ∗ \\\\ 1 & 3 & -7 & ∗ & 0 \\\\ 22 & 5 & -1 & ∗ & -2 \\\\ 0 & -5 & 3 & ∗ & 0 \\\\ 7 & 3 & 4 & ∗ & \\frac{5}{2}\\end{bmatrix}\n$$\n\n \n\nSo, the minor is\n\n$$\n{M}_{14}=\\begin{vmatrix}1 & 3 & -7 & 0 \\\\ 22 & 5 & -1 & -2 \\\\ 0 & -5 & 3 & 0 \\\\ 7 & 3 & 4 & \\frac{5}{2}\