h} :answer/value "-|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186263321} {:answer/id #uuid "4548b088-5f95-5a30-8f33-e62bc65d8dbb" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186263608} {:answer/id #uuid "55104f94-b1f0-5eb4-86cb-ae5e2013cd7b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -8 & 2 & -5 \\\\ -1 & -1 & -5 & 6 \\\\ 4 & 5 & 3 & 8 \\\\ -9 & 3 & 7 & -9\\end{aligned}|" :db/id #edb/ref 17592186263732} {:answer/id #uuid "c257f8d5-fe4e-544f-932b-a20d0fe815e5" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -8 & 2 & -5 \\\\ 3 & 5 & 6 & 3 \\\\ -1 & -1 & -5 & 6 \\\\ 4 & 5 & 3 & 8\\end{aligned}|" :db/id #edb/ref 17592186264690}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186263321} :answer-field/id #uuid "48b35c10-3a2f-58ca-9b04-6ae022248cdd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265383}] :question/id #uuid "ce9accaa-afb7-54e5-bcfb-c7e76afa2708" :question/math-academy-id "q-130906" :question/problem "Find the cofactor of ${x}_{52}$ in \n$X=\\begin{bmatrix}1 & -8 & 2 & -5 & -1 \\\\ 3 & 5 & 6 & 3 & 1 \\\\ -1 & -1 & -5 & 6 & -4 \\\\ 4 & 5 & 3 & 8 & 3 \\\\ -9 & 3 & 7 & -9 & 0\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${x}_{52}$, we remove the $5$th row and $2$nd column: \n\n$$\nX=\\begin{bmatrix}1 & ∗ & 2 & -5 & -1 \\\\ 3 & ∗ & 6 & 3 & 1 \\\\ -1 & ∗ & -5 & 6 & -4 \\\\ 4 & ∗ & 3 & 8 & 3 \\\\ ∗ & 3 & ∗ & ∗ & ∗\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{52}=\\begin{vmatrix}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{vmatrix}.\n$$\n\nNow, the cofactor of ${x}_{52}$ is\n\n$$\n\\begin{aligned}{C}_{52} & =(-1)^{5+2}{M}_{52} \\\\  & =-{M}_{52} \\\\  & =-\\begin{vmatrix}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{vmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "338045b0-64d0-5ebf-a057-2cef9ed29ca9" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186263447} {:answer/id #uuid "40a809ef-a58a-5141-897e-5ca0e3d65f04" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}3 & -8 & 1 & 0 \\\\ 3 & 5 & 0 & 1 \\\\ -25 & -1 & 6 & -4 \\\\ 4 & 8 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186263571} {:answer/id #uuid "dfe8006b-142b-5171-b366-b49610d775d9" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186264945} {:answer/id #uuid "e38b6938-7f5f-54d4-beb6-c9c35c7a9e26" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186264978} {:answer/id #uuid "ff7de405-c8be-59e0-bed7-5d7269b3a8e1" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & \\sqrt{13} & 0 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 8 & 3 & 8 & 3 \\\\ 3 & \\sqrt{2} & -9 & 7\\end{aligned}|" :db/id #edb/ref 17592186265246}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & -8 & 2 & 1 \\\\ 3 & 5 & \\sqrt{13} & 0 \\\\ 4 & 8 & 3 & 8 \\\\ 11 & 3 & \\sqrt{2} & -9\\end{aligned}|" :db/id #edb/ref 17592186264945} :answer-field/id #uuid "233238c1-b02d-5669-8149-0