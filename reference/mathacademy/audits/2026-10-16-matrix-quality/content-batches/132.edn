rix}\\begin{bmatrix}4 \\\\ 0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -4 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b393b36-96ae-5198-b258-d83f0ba13f8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 16\\end{bmatrix}" :db/id #edb/ref 17592186479488} {:answer/id #uuid "6b138a94-029d-5e3a-89d5-1e106cfe8cb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186479519} {:answer/id #uuid "7fcbbf75-fb83-507c-9f42-f4c6c4111a86" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -16\\end{bmatrix}" :db/id #edb/ref 17592186479548} {:answer/id #uuid "8cdc437a-1af8-5ccc-b69b-82c9f62dc13a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186479568} {:answer/id #uuid "ed1fbeeb-e829-57bf-b71c-36019b6ef95c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186479709}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186479709} :answer-field/id #uuid "edae35f1-1005-53e8-b986-b66d714ed188" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479817}] :question/id #uuid "0f740568-e21f-5fbd-943a-06810f0bb27d" :question/math-academy-id "q-38880" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=\\begin{bmatrix}-3 & 5 \\\\ 1 & -1\\end{bmatrix}\\,$ and $\\,[x]_{B}=\\begin{bmatrix}7 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =\\begin{bmatrix}-3 & 5 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}7 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-16 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d13a6f3-9009-51cd-9101-1cc9ebe6bb52" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186479425} {:answer/id #uuid "712fd56c-b9b0-5f98-ae65-a16f738b67c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186479527} {:answer/id #uuid "b7275d43-89fa-5c4e-87da-2ba55e190ef7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186479632} {:answer/id #uuid "f316d8aa-f206-5c87-8850-b87ffed7c21d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186479720} {:answer/id #uuid "f9bbd151-4ca2-5dfd-8018-cf7ce67dc55f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186479735}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186479632} :answer-field/id #uuid "9eace5df-6443-5362-a150-ffc1f660fca5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479793}] :question/id #uuid "3570dc7e-1a01-5006-842e-6d17aa9f3a4b" :question/math-academy-id "q-82452" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation. Find $[T(x)]_{B},$ given that\n$\\,$ $[T]_{B}=\\begin{bmatrix}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{bmatrix}\\,$ and $\\,[x]_{B}=\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =\\begin{bmatrix}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44a2df56-59f5-5870-bf5d-d6caef11c361" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-31 \\\\ -20\\end{bmatrix}" :db/id #edb/ref 17592186479460} {:answer/id #uuid "c69262f2-f952-5f6f-8070-1d1df7dbdf8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186479659} {:answer/id #uuid "e52f59aa-11a2-5664-be8a-489ca2166c43" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186479696} {:answer/id #uuid "f436d6b3-4f37-5c98-a4bd-3908a0900a83" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 \\\\ -20\\end{bmatrix}" :db/id #edb/ref 17592186479723} {:answer/id #uuid "fd4d3af1-2f0c-51d6-a1d4-b33f91a4e49c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}20 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186479740}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-13 \\\\ -20\\end{bmatrix}" :db/id #edb/ref 17592186479723} :answer-field/id #uuid "581265b5-b2a1-58d1-87f3-645c26ba1133" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479773}] :question/id #uuid "c2f444bc-6844-54b3-8db1-284a3e7b2b75" :question/math-academy-id "q-38089" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=\\begin{bmatrix}1 & -3 \\\\ 2 & -4\\end{bmatrix}\\,$ and $\\,[x]_{B}=\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =\\begin{bmatrix}1 & -3 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-13 \\\\ -20\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Image of a Vector Given the Matrix of a Linear Transformation Relative to a Basis"} {:db/id #edb/ref 17592186124541 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124350 :question/id #uuid "d46f548c-c15c-5716-9f37-7f9dfa751f35" :question/math-academy-id "e-5515" :question/problem "The basis $\\mathcal{B}$ of $\\mathbb{R}^3$ and the matrix $[\\,\\mathbf{T}\\,]_{\\mathcal{B}}$ of the linear transformation $\\mathbf{T}: \\mathbb{R}^3 \\rightarrow \\mathbb{R}^3$ relative to $\\mathcal{B}$ are given by\n\n![](images/be/beb5fb8757faf2c9e25c46013b90565611943b2796b0f23c6f0dece1e44e9055.svg)\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n![](images/2f/2f5d701e5ded2a62bdc85878a6d7b8e575bec05aabd7d4b132fac7e3bdbc5f3a.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\{ \\mathbf{b}_1,\\mathbf{b}_2,\\mathbf{b}_3 \\}.$ The $\\mathcal{B}$-matrix for $\\mathbf{T}$ is a matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}.$\n\nTo find the coordinates of $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}$, we consider the matrix\n![](images/71/7136e2bb6e6f18a4bdb43a10ea3f14833077197b55bdd5bdc4c31c2aca7be2ab.svg)\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $\\mathcal{B}$-matrix for $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & -3 & 0 & -2 & -10 \\\\ 0 & 0 & 4 & 4 & 0 & 8\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=\\frac{1}{4}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & -3 & 0 & -2 & -10 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & 0 & 3 & -2 & -4 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 1 & -2 \\\\ 0 & 1 & 0 & 3 & -2 & -4 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n![](images/2e/2eba20e60b23942d9074b2e88003bee36267b40381f3fa157b1f74e38bef5198.svg)\n\nFinally, $a=1,$ $b=-2,$ $c=-2$ and \n\n$$\na+b+c = 1+(-2)+(-2) = -3.\n$$"} :knowledge-point/id #uuid "22ca4f81-6fec-5822-b281-5ce1e23d399e" :knowledge-point/questions [{:db/id #edb/ref 17592186125120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb7d3ab9-9286-57d7-9f19-54f80e4caf49" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123321} {:answer/id #uuid "ee0352c5-a085-5552-8d66-730303a021e7" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186123322} {:answer/id #uuid "153b74ce-8536-515f-8ba2-38cb746e7531" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186123323} {:answer/id #uuid "5019ab6e-4851-529b-9683-43c991b3a7a4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186123324} {:answer/id #uuid "6173cc4e-a1f0-5b45-9fa4-85fc26ed2c14" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186123325}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186123324} :answer-field/id #uuid "4c345e84-9511-548f-8788-df9e56fa385d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123320}] :question/id #uuid "661e6a3c-5602-5b6b-835b-bdaef94bf272" :question/math-academy-id "q-38152" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 2 \\\\ -3\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & 2 & -5 \\\\ 2 & b & 7 \\\\ -1 & 0 & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}2 \\\\ 3 \\\\ 6\\end{bmatrix}.\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 0 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0 & -1 & 3 \\\\ 0 & 0 & -3 & 3 & 0 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=-\\frac{1}{3}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0 & -1 & 3 \\\\ 0 & 0 & 1 & -1 & 0 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 1 & 1 & 2 \\\\ 0 & 1 & 0 & 2 & -1 & 7 \\\\ 0 & 0 & 1 & -1 & 0 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 2 & -5 \\\\ 0 & 1 & 0 & 2 & -1 & 7 \\\\ 0 & 0 & 1 & -1 & 0 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-1 & 2 & -5 \\\\ 2 & -1 & 7 \\\\ -1 & 0 & -2\\end{bmatrix}\n$$\n\nFinally, $a=-1,$ $b=-1,$ $c=-2$ and \n\n$$\na+b+c=(-1)+(-1)+(-2)=-4.\n$$"} {:db/id #edb/ref 17592186125143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa4e200d-3059-501b-ab48-6218a57adb56" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186366092} {:answer/id #uuid "07fc866b-fe6c-5b59-a12b-1c07c6f776d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{5}" :db/id #edb/ref 17592186366093} {:answer/id #uuid "d2e63e01-ec4a-57a5-86b7-843609011e6e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366094} {:answer/id #uuid "32c297e8-07e1-5fab-ad4c-57169fea2237" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366095} {:answer/id #uuid "5466569e-0352-5327-9298-ff146556b7cf" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366096}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366096} :answer-field/id #uuid "b1b50d6d-f46c-5fab-8128-2948e6ef2591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366091}] :question/id #uuid "1c06910f-cdf8-5abe-b301-896973ca0101" :question/math-academy-id "q-38919" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & 1 & 5 \\\\ -3 & b & -5 \\\\ -\\frac{3}{5} & -\\frac{1}{5} & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}x+y+z \\\\ x-y \\\\ x-z\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix})=\\begin{bmatrix}5 \\\\ 0 \\\\ -5\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 0 & 3 & 1 & 5 \\\\ 1 & 1 & 0 & 0 & -1 & 0 \\\\ 1 & 0 & 5 & 0 & 0 & -5\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 3 & 1 & 5 \\\\ 0 & 1 & 0 & -3 & -2 & -5 \\\\ 0 & 0 & 5 & -3 & -1 & -10\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=\\frac{1}{5}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 3 & 1 & 5 \\\\ 0 & 1 & 0 & -3 & -2 & -5 \\\\ 0 & 0 & 1 & -\\frac{3}{5} & -\\frac{1}{5} & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}3 & 1 & 5 \\\\ -3 & -2 & -5 \\\\ -\\frac{3}{5} & -\\frac{1}{5} & -2\\end{bmatrix}.\n$$\n\nFinally, $a=3,$ $b=-2,$ $c=-2$ and \n\n$$\na+b+c=3+(-2)+(-2)=-1.\n$$"} {:db/id #edb/ref 17592186272069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7697d1-95a3-51f5-9d2a-ac790ea4ed80" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269511} {:answer/id #uuid "43252345-380c-5e14-8b84-f07bf123fb04" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269875} {:answer/id #uuid "81afc3c2-6d5e-5f2b-a1af-2413ff0cd990" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270390} {:answer/id #uuid "849478b3-48da-55c4-9643-0d9b67a8bc7d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270412} {:answer/id #uuid "e0263d60-7f1c-5a7c-90a5-cdeaebc1a719" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186271237}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269511} :answer-field/id #uuid "bfbf8448-f42d-5a70-82ce-e76207d66d0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271858}] :question/id #uuid "3a7872ef-ff2e-5ddd-9d3f-2a945fc7469d" :question/math-academy-id "q-140370" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & -1 & 2 \\\\ 6 & b & -2 \\\\ -4 & -2 & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=\\begin{bmatrix}-4 \\\\ 0 \\\\ 16\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ -6 \\\\ 2\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}4 \\\\ 2 \\\\ -6\\end{bmatrix}.\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -1 & 0 & -4 & -1 & 4 \\\\ 0 & 2 & 3 & 0 & -6 & 2 \\\\ 0 & 2 & -1 & 16 & 2 & -6\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{2} \\\\ {R}_{2}:=\\frac{1}{2}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -4 & -1 & 4 \\\\ 0 & 1 & \\frac{3}{2} & 0 & -3 & 1 \\\\ 0 & 0 & -4 & 16 & 8 & -8\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=-\\frac{1}{4}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -4 & -1 & 4 \\\\ 0 & 1 & \\frac{3}{2} & 0 & -3 & 1 \\\\ 0 & 0 & 1 & -4 & -2 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}-\\frac{3}{2}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -1 & 0 & -4 & -1 & 4 \\\\ 0 & 1 & 0 & 6 & 0 & -2 \\\\ 0 & 0 & 1 & -4 & -2 & 2\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}+{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 6 & 0 & -2 \\\\ 0 & 0 & 1 & -4 & -2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}2 & -1 & 2 \\\\ 6 & 0 & -2 \\\\ -4 & -2 & 2\\end{bmatrix}\n$$\n\nFinally, $a=2,$ $b=0,$ $c=2$ and \n\n$$\na+b+c=2+0+2=4.\n$$"} {:db/id #edb/ref 17592186351428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c9e4fff-7649-56b7-8c3d-79e7b237abae" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186348837} {:answer/id #uuid "890ef029-0f49-5b98-bc71-bba5ccb814b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186349692} {:answer/id #uuid "be9b5155-fa44-5a3c-a0fe-3af5615e1f43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186350139} {:answer/id #uuid "d9ce8fd4-c220-5663-9f93-deb5265c5225" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186350357} {:answer/id #uuid "e4f5c2c0-e85d-5f52-8030-31304a862def" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186350454}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186350357} :answer-field/id #uuid "d43dd3e3-2064-5e0a-a0e8-d374e18d14c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351074}] :question/id #uuid "0147a685-a844-5e86-a953-72a451e46813" :question/math-academy-id "q-82483" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ -2\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & 1 & 2 \\\\ 1 & 0 & 0 \\\\ -\\frac{1}{2} & b & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}2 \\\\ 0 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 0 & 1 & 1 & 2 \\\\ 0 & 2 & 0 & 2 & 0 & 0 \\\\ 0 & 0 & -2 & 1 & -1 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{2}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 1 & 1 & 2 \\\\ 0 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & -2 & 1 & -1 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 1 & 2 \\\\ 0 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & -2 & 1 & -1 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=-\\frac{1}{2}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 1 & 2 \\\\ 0 & 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & -\\frac{1}{2} & \\frac{1}{2} & -\\frac{3}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 0 & 0 \\\\ -\\frac{1}{2} & \\frac{1}{2} & -\\frac{3}{2}\\end{bmatrix}\n$$\n\nFinally, $a=0,$ $b=\\frac{1}{2},$ $c=-\\frac{3}{2}$ and \n\n$$\na+b+c=0+\\frac{1}{2}+(-\\frac{3}{2})=-1.\n$$"} {:db/id #edb/ref 17592186351429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5772b044-9a34-5819-8d2b-d5ef657005b0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349250} {:answer/id #uuid "68a18963-cf9c-57a5-92d7-a4afc2d5c802" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349408} {:answer/id #uuid "a1346a4d-f281-5715-abaf-a84b2a898201" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186349877} {:answer/id #uuid "a9fea506-b80a-51fb-829b-4dfb29b66748" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349957} {:answer/id #uuid "ac5c6b33-0286-5367-bfbc-535211616d3b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186349973}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349408} :answer-field/id #uuid "681dade9-90cc-55fd-9472-6d4a71b243f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350878}] :question/id #uuid "696efd0b-1adb-568a-a58e-00ad82c71a3f" :question/math-academy-id "q-82493" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}6 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ -6\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}3 & 6 & c \\\\ a & -2 & 0 \\\\ -2 & b & -1\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=\\begin{bmatrix}3 \\\\ -1 \\\\ 12\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}6 \\\\ -2 \\\\ 0\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}3 \\\\ 0 \\\\ 6\\end{bmatrix}.\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & 6 & 0 & 3 & 6 & 3 \\\\ 0 & 1 & 0 & -1 & -2 & 0 \\\\ 0 & 0 & -6 & 12 & 0 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\frac{1}{3}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & -1 & -2 & 0 \\\\ 0 & 0 & -6 & 12 & 0 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 3 & 6 & 1 \\\\ 0 & 1 & 0 & -1 & -2 & 0 \\\\ 0 & 0 & -6 & 12 & 0 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=-\\frac{1}{6}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 3 & 6 & 1 \\\\ 0 & 1 & 0 & -1 & -2 & 0 \\\\ 0 & 0 & 1 & -2 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}3 & 6 & 1 \\\\ -1 & -2 & 0 \\\\ -2 & 0 & -1\\end{bmatrix}\n$$\n\nFinally, $a=-1,$ $b=0,$ $c=1$ and \n\n$$\na+b+c=(-1)+0+1=0.\n$$"} {:db/id #edb/ref 17592186351430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42facbc4-d728-5163-be96-ed4c53b50c55" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186349054} {:answer/id #uuid "6c84468e-7055-5710-b052-92e4def9701f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349448} {:answer/id #uuid "899d905f-709b-551f-b03e-d4454e7a61ce" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349696} {:answer/id #uuid "c09b05e8-965f-5172-8aa8-c55dc1f614ec" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186350155} {:answer/id #uuid "e523dfa5-0714-5fd1-ad20-de7d9495406b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186350458}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186350458} :answer-field/id #uuid "4efe9a76-4807-577e-8573-6f7d2163c588" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350842}] :question/id #uuid "d8167650-5d1e-5aa6-b6ee-d36f491d8d5f" :question/math-academy-id "q-82496" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix}},\\,[\\,T\\,]_{B}=\\begin{bmatrix}2 & -1 & c \\\\ a & 1 & 0 \\\\ -\\frac{3}{2} & b & -2\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}x-y+z \\\\ x+y \\\\ y-z\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix})=\\begin{bmatrix}2 \\\\ 0 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 1 & 0 & 2 & -1 & 1 & -2\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & -3 & 2 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=\\frac{1}{2}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 2 & -1 & 2 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & -\\frac{3}{2} & 1 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}2 & -1 & 2 \\\\ 1 & 1 & 0 \\\\ -\\frac{3}{2} & 1 & -2\\end{bmatrix}.\n$$\n\nFinally, $a=1,$ $b=1,$ $c=2$ and \n\n$$\na+b+c=1+1+2=4.\n$$"} {:db/id #edb/ref 17592186351431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d9ee2b-0d51-5056-a43a-3b79f11f7827" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186348519} {:answer/id #uuid "2335ca49-a144-52ff-be29-4b560506ec3d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186348747} {:answer/id #uuid "509c21f8-433d-57ca-9829-87527cb30032" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186349176} {:answer/id #uuid "86e66244-4279-525d-b0de-1e9884ee5c39" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349676} {:answer/id #uuid "a455c355-957b-5ad0-809f-690e1ed70efd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186349915}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186349915} :answer-field/id #uuid "46e0a81a-de17-5de6-bb12-826caeb55b34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350826}] :question/id #uuid "2304928b-4c80-58a1-b540-01c4b990a7c9" :question/math-academy-id "q-82497" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3 \\\\ 0\\end{bmatrix},\\begin{bmatrix}3 \\\\ 0 \\\\ 4\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}-7 & b & -25 \\\\ a & 1 & -\\frac{1}{3} \\\\ 2 & 0 & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}y-z \\\\ x+y-z \\\\ x+y\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}0 \\\\ 3 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}3 \\\\ 3 \\\\ 3\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}3 \\\\ 0 \\\\ 4\\end{bmatrix})=\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 3 & -1 & 3 & -4 \\\\ 0 & 3 & 0 & 0 & 3 & -1 \\\\ 1 & 0 & 4 & 1 & 3 & 3\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-{R}_{1} \\\\ {R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & -1 & 3 & -4 \\\\ 0 & 1 & 0 & 0 & 1 & -\\frac{1}{3} \\\\ 0 & 0 & 1 & 2 & 0 & 7\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-3{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -7 & 3 & -25 \\\\ 0 & 1 & 0 & 0 & 1 & -\\frac{1}{3} \\\\ 0 & 0 & 1 & 2 & 0 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-7 & 3 & -25 \\\\ 0 & 1 & -\\frac{1}{3} \\\\ 2 & 0 & 7\\end{bmatrix}.\n$$\n\nFinally, $a=0,$ $b=3,$ $c=7$ and \n\n$$\na+b+c=0+3+7=10.\n$$"} {:db/id #edb/ref 17592186351432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b74545b-9b26-59d4-acb9-27c5bfc2d8b8" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186348544} {:answer/id #uuid "14f1e9a2-a435-5237-9e70-1c264c47563c" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186348625} {:answer/id #uuid "d4f63a5b-575f-5a04-87f7-e0118785f97d" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186350314} {:answer/id #uuid "dd2f74ba-36f2-5301-b637-5410df3c51a8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186350381} {:answer/id #uuid "f6bb33fb-b94e-5ee9-914e-afd4f685c109" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186350607}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186350314} :answer-field/id #uuid "fc2d14c7-7aa7-5c46-94b2-8e8a9ab43990" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351150}] :question/id #uuid "15df9e9c-0cc2-5074-a0e8-e219fef5a119" :question/math-academy-id "q-82501" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}8 & -5 & c \\\\ -1 & b & -3 \\\\ a & 2 & -7\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}y+z \\\\ y-x \\\\ y+z-x\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix})=\\begin{bmatrix}-1 \\\\ -1 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}3 \\\\ 0 \\\\ -2\\end{bmatrix})=\\begin{bmatrix}-2 \\\\ -3 \\\\ -5\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 0 & 3 & -1 & 1 & -2 \\\\ 0 & 1 & 0 & -1 & 1 & -3 \\\\ -1 & 0 & -2 & -2 & 1 & -5\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & -1 & 1 & -2 \\\\ 0 & 1 & 0 & -1 & 1 & -3 \\\\ 0 & 0 & 1 & -3 & 2 & -7\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-3{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 8 & -5 & 19 \\\\ 0 & 1 & 0 & -1 & 1 & -3 \\\\ 0 & 0 & 1 & -3 & 2 & -7\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}8 & -5 & 19 \\\\ -1 & 1 & -3 \\\\ -3 & 2 & -7\\end{bmatrix}.\n$$\n\nFinally, $a=-3,$ $b=1,$ $c=19$ and \n\n$$\na+b+c=(-3)+1+19=17.\n$$"} {:db/id #edb/ref 17592186366420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11bf3705-350d-591c-b5e3-774879c04b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186366422} {:answer/id #uuid "85431788-860f-50e2-a965-1c7466c5f914" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366423} {:answer/id #uuid "358a2c45-0561-50d3-8098-e22cfeea88d9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366424} {:answer/id #uuid "21706d9b-1079-5114-9592-b5828ac7cbbc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186366425} {:answer/id #uuid "d74b5df7-d508-53c4-b1f7-8dfcab46c255" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186366426}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366424} :answer-field/id #uuid "db368684-bf29-5c1c-8ce6-a4b27f0856f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366421}] :question/id #uuid "7191c9ef-9aad-5881-a936-bd45ed790f95" :question/math-academy-id "q-82500" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={\\begin{bmatrix}2 \\\\ 0 \\\\ 4\\end{bmatrix},\\begin{bmatrix}0 \\\\ 2 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 8\\end{bmatrix}},\\,[\\,T\\,]_{B}=\\begin{bmatrix}-1 & 0 & -4 \\\\ 1 & 1 & 0 \\\\ a & b & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}x-z \\\\ x+y \\\\ x-y-z\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}2 \\\\ 0 \\\\ 4\\end{bmatrix})=\\begin{bmatrix}-2 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}0 \\\\ 2 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}0 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}0 \\\\ 0 \\\\ 8\\end{bmatrix})=\\begin{bmatrix}-8 \\\\ 0 \\\\ -8\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 0 & 0 & -2 & 0 & -8 \\\\ 0 & 2 & 0 & 2 & 2 & 0 \\\\ 4 & 0 & 8 & -2 & -2 & -8\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:=\\frac{1}{2}{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 & -4 \\\\ 0 & 2 & 0 & 2 & 2 & 0 \\\\ 4 & 0 & 8 & -2 & -2 & -8\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}-4{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 & -4 \\\\ 0 & 2 & 0 & 2 & 2 & 0 \\\\ 0 & 0 & 8 & 2 & -2 & 8\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{2}{R}_{2} \\\\ {R}_{3}:=\\frac{1}{8}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 & -4 \\\\ 0 & 1 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & \\frac{1}{4} & -\\frac{1}{4} & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-1 & 0 & -4 \\\\ 1 & 1 & 0 \\\\ \\frac{1}{4} & -\\frac{1}{4} & 1\\end{bmatrix}.\n$$\n\nFinally, $a=\\frac{1}{4},$ $b=-\\frac{1}{4},$ $c=1$ and \n\n$$\na+b+c=\\frac{1}{4}+(-\\frac{1}{4})+1=1.\n$$"} {:db/id #edb/ref 17592186416396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160cf1c3-ac0f-5878-aa13-d5ddd7963cf2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186416367} {:answer/id #uuid "1d6e6bfd-9b54-517b-b0e0-a62d79b1f20a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186416369} {:answer/id #uuid "5711295d-197b-58b6-9e28-191b003214aa" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186416372} {:answer/id #uuid "582cb2d5-d3fc-5e12-b72f-d8cfda5e904d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186416373} {:answer/id #uuid "83656066-e5fe-596a-a8ca-783daf5d23d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186416377}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186416377} :answer-field/id #uuid "55345e60-62bc-5001-9ca7-f576705f2f04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416392}] :question/id #uuid "2fc0336a-ad5e-573a-ac70-a523b483c681" :question/math-academy-id "q-82488" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 5\\end{bmatrix}},\\,[\\,T\\,]_{B}=\\begin{bmatrix}0 & b & 4 \\\\ a & 3 & 0 \\\\ 0 & 0 & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix},\\,T({b}_{2})=\\begin{bmatrix}-1 \\\\ 9 \\\\ 0\\end{bmatrix},\\,T({b}_{3})=\\begin{bmatrix}4 \\\\ 0 \\\\ 10\\end{bmatrix}.\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & 2 & -1 & 4 \\\\ 0 & 3 & 0 & 3 & 9 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & 2 & -1 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & -7 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=\\frac{1}{5}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & -7 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}0 & -7 & 4 \\\\ 1 & 3 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nFinally, $a=1,$ $b=-7,$ $c=2$ and \n\n$$\na+b+c=1+(-7)+2=-4.\n$$"} {:db/id #edb/ref 17592186416397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce3ee34-0bbc-5bf1-8519-a5c6f5ca4be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186416368} {:answer/id #uuid "2dfe1fac-b11a-54dc-b55d-c32d6ffe73e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186416370} {:answer/id #uuid "8ed59ef4-4b16-5d39-970e-9eb55064e9c0" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186416378} {:answer/id #uuid "afc0693e-b8b8-5f98-a567-53b12025e699" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186416381} {:answer/id #uuid "ed2eead7-3610-52a9-8cf6-5173ec43049c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186416387}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186416370} :answer-field/id #uuid "9715d32b-de54-5e1d-b216-07bf1e7e3fc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416393}] :question/id #uuid "5979cff9-340a-5b78-84fd-5ca3a8c1f370" :question/math-academy-id "q-140374" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ 0 \\\\ 3\\end{bmatrix}\\},\\,[\\,T\\,]_{B}=\\begin{bmatrix}a & -5 & -9 \\\\ 3 & b & 6 \\\\ 1 & \\frac{4}{3} & c\\end{bmatrix}.\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT(\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix})=\\begin{bmatrix}x+y+z \\\\ x+z \\\\ y-z\\end{bmatrix}\n$$" :question/worked-solution "Let's denote the vectors of $B$ as $\\{{b}_{1},{b}_{2},{b}_{3}\\}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T(\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix})=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\ T({b}_{2}) & =T(\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix})=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\ T({b}_{3}) & =T(\\begin{bmatrix}0 \\\\ 0 \\\\ 3\\end{bmatrix})=\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 & 1 & 1 & 3 \\\\ -1 & -1 & 0 & 2 & 2 & 3 \\\\ 1 & 0 & 3 & -2 & -1 & -3\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{1}+{R}_{2} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & 1 & 1 & 3 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & -2 & 3 & -3 & -2 & -6\\end{bmatrix} &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2} \\\\ {R}_{3}:=2{R}_{2}+{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 3 & 3 & 4 & 6\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:=\\frac{1}{3}{R}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 1 & 1 & \\frac{4}{3} & 2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-5 & -5 & -9 \\\\ 3 & 3 & 6 \\\\ 1 & \\frac{4}{3} & 2\\end{bmatrix}.\n$$\n\nFinally, $a=-5,$ $b=3,$ $c=2$ and \n\n$$\na+b+c=-5+3+2=0.\n$$"}] :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to a Basis in a Three-Dimensional Vector Space"} {:db/id #edb/ref 17592186124576 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124383 :question/id #uuid "71ac5a84-d8e8-5de6-8adc-e0172457a772" :question/math-academy-id "e-7249" :question/problem "Let $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2,\\mathbf{b}_3 \\}$ be a basis of $\\mathbb{R}^3.$ The matrix $[\\,\\mathbf{T}\\,]_{\\mathcal{B}}$ of the linear transformation $\\mathbf{T}:\\mathbb{R}^3 \\rightarrow \\mathbb{R}^3$ is given by\n\n![](images/7a/7a3f24ba8c0b519455a745e7ed5c7042bd5c21d516efc4db9629d8084e8b8484.svg)\n\nFind the value of $\\,a+b+c,\\,$ given that \n\n$$\n\\begin{aligned}T({b}_{1}) & ={b}_{1}+{b}_{3}, \\\\ T({b}_{2}) & ={b}_{1}+{b}_{2}, \\\\ T({b}_{3}) & ={b}_{2}+{b}_{3}.\\end{aligned}\n$$" :question/worked-solution "First, we write down the coordinates of the images relative to the basis $\\mathcal{B}\\mathbin{:}$\n\n![](images/d0/d0f702b71b9352d3fa2fff2f446730f5515002811d65f6f3c562b01c7b14d76f.svg)\n\nNow, the $\\mathcal{B}$-matrix for $\\mathbf{T}$ is a matrix  whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}.$ Therefore, we obtain\n\n![](images/b0/b01bef7c1eb325b912ec0ce3e85c2d6fc30711e56a6285b9fa5e3b033913339a.svg)\n\nFinally, $a=1,$ $b=1,$ $c=0$ and \n\n$$\na+b+c = 1+1+0 = 2.\n$$"} :knowledge-point/id #uuid "6641b2cf-00bc-5542-a566-5b8689f2f2a4" :knowledge-point/questions [{:db/id #edb/ref 17592186125121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b79e13d-fb86-553e-9d9f-9729e5a51c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -1 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186392180} {:answer/id #uuid "67cdf55b-6369-5e8c-9704-b2f167924321" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -3 \\\\ -3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392181} {:answer/id #uuid "cf0b1c1e-434d-5e7b-a49f-eaf31704ec8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 3 \\\\ 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186392182} {:answer/id #uuid "2eda8b50-4b3a-5d8a-94e0-450bef44677d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 \\\\ -4 & -1\\end{bmatrix}" :db/id #edb/ref 17592186392183} {:answer/id #uuid "663c79ba-73d5-5bfe-abc0-01aaf38f9cbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186392184}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 3 \\\\ 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186392182} :answer-field/id #uuid "32476c92-2b12-5fa9-ac14-b59377edfba8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392179}] :question/id #uuid "a0d88bf6-49d8-5583-ace1-e2953559b288" :question/math-academy-id "q-38185" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}\\,$ if $\\,T({b}_{1})=3{b}_{2}-4{b}_{1}\\,$ and $\\,T({b}_{2})=3{b}_{1}-{b}_{2}.$" :question/worked-solution "Since we have $\\,T({b}_{1})=3{b}_{2}-4{b}_{1}\\,$ and $\\,T({b}_{2})=3{b}_{1}-{b}_{2}\\,$, we have\n\n$$\n[T({b}_{1})]_{B}=\\begin{bmatrix}-4 \\\\ 3\\end{bmatrix},\\,[T({b}_{2})]_{B}=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}.\n$$\n\nNow, the $B$-matrix for $T$ is a matrix  whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$ Therefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}-4 & 3 \\\\ 3 & -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186125231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b00b972a-7d1a-5f01-8de9-120a080bfc33" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186123987} {:answer/id #uuid "bc050e8a-66d2-5774-8435-4cced30c508d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186123988} {:answer/id #uuid "bd42107b-3366-56c0-8955-04a1c3ffdd03" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186123989} {:answer/id #uuid "c16358cf-d907-5122-baed-2cb352330e3a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123990} {:answer/id #uuid "5b5dd0d9-a01c-56cf-9dcf-f224f2e925ea" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186123991}] :answer-field/id #uuid "a9370d6b-04d7-5395-a745-01f57427da6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123986}] :question/id #uuid "34449868-2f27-5b46-bdea-f04ba0026885" :question/math-academy-id "q-82171" :question/problem "Let $B = {b_{1}, b_{2}, b_{3}}$ be a basis of $R^{3}$. The matrix $[T]_{B}$ of the linear transformation $T: R^{3} → R^{3}$ is given by\n\n$[T]_{B} = \\begin{bmatrix}a & b & c \\\\ 1 & -1 & 1 \\\\ -1 & -1 & 0\\end{bmatrix}$.\n\nFind the value of $a + b + c$, given that\n\n$T(b_{1})|= b_{2} - b_{3},; T(b_{2})|= b_{1} - b_{2} - b_{3},; T(b_{3})|= b_{1} + b_{2}$."} {:db/id #edb/ref 17592186272068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74d98079-dc1a-5457-adc9-21abec1b296e" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186270300} {:answer/id #uuid "882c8647-a950-5413-b56d-4f848b9c7f3f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270447} {:answer/id #uuid "b1608779-a21d-5ba8-8c57-c71d7057d159" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270853} {:answer/id #uuid "bbd33ef6-d2e3-5330-aac8-21b38d7527f0" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186270923} {:answer/id #uuid "c47b3668-0b40-58cc-a107-216a28aeec76" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186271003}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270853} :answer-field/id #uuid "6497adae-aef1-5955-a170-9c1256977b9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271686}] :question/id #uuid "42192cc1-aef5-5b49-8b3b-7bd0d762bada" :question/math-academy-id "q-140369" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}.$ The matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ is given by\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}a & 3 & -1 \\\\ 2 & b & -1 \\\\ 4 & -3 & c\\end{bmatrix}.\n$$\n\nFind the value of $\\,a+b+c,\\,$ given that \n\n$$\n\\begin{aligned}T({b}_{1}) & =3{b}_{1}+2{b}_{2}+4{b}_{3}, \\\\ T({b}_{2}) & =3{b}_{1}-3{b}_{3}, \\\\ T({b}_{3}) & =-{b}_{1}-{b}_{2}+3{b}_{3}.\\end{aligned}\n$$" :question/worked-solution "First, we write down the coordinates of the images relative to the basis $B:$\n\n$$\n[T({b}_{1})]_{B}=\\begin{bmatrix}3 \\\\ 2 \\\\ 4\\end{bmatrix},\\,[T({b}_{2})]_{B}=\\begin{bmatrix}3 \\\\ 0 \\\\ -3\\end{bmatrix},\\,[T({b}_{3})]_{B}=\\begin{bmatrix}-1 \\\\ -1 \\\\ 3\\end{bmatrix}\n$$\n\nNow, the $B$-matrix for $T$ is a matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$ Therefore, we obtain\n\n$$\n[\\,T\\,]_{B}=\\begin{bmatrix}3 & 3 & -1 \\\\ 2 & 0 & -1 \\\\ 4 & -3 & 3\\end{bmatrix}.\n$$\n\nFinally, $a=3,$ $b=0,$ $c=3$ and \n\n$$\na+b+c=3+0+3=6.\n$$"} {:db/id #edb/ref 17592186323973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4093d68c-2765-5b21-82f8-d3ef948dcff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 8 & -5\\end{bmatrix}" :db/id #edb/ref 17592186321658} {:answer/id #uuid "708ba2c0-b4af-5a10-a07d-f0fcc9976792" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 8 \\\\ 3 & -5\\end{bmatrix}" :db/id #edb/r