\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392457} {:answer/id #uuid "74e92b10-2baf-5de6-837b-fb52df6e5b4e" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392458} {:answer/id #uuid "42f03cfa-2d33-5fbd-a8ec-bd25305db522" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 5 & 7 \\\\ 0 & 3 & -9 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392459} {:answer/id #uuid "75e81c03-d073-5698-8f85-3a4e473cfc7a" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-1 & 6 & 0 \\\\ 2 & 5 & 7 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392460} {:answer/id #uuid "4f787ba3-9c9c-55c6-bae9-6bfe9a4c5a1d" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}6 & 4 & 0 \\\\ 5 & 0 & 7 \\\\ 0 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392461}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186392458} :answer-field/id #uuid "a2746e40-3c71-5486-a042-f766ef893f7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392456}] :question/id #uuid "368c9476-6b26-5a56-b85b-a41230a98028" :question/math-academy-id "q-42092" :question/problem "Find the cofactor of ${b}_{32}$ in $B=\\begin{bmatrix}-1 & 6 & 4 & 0 \\\\ 2 & 5 & 0 & 7 \\\\ 0 & 3 & 5 & -9 \\\\ -4 & 0 & 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, to get the minor of ${b}_{32}$, we remove the $3$rd  row and $2$nd column: \n\n$$\nB=\\begin{bmatrix}-1 & ∗ & 4 & 0 \\\\ 2 & ∗ & 0 & 7 \\\\ ∗ & 3 & ∗ & ∗ \\\\ -4 & ∗ & 0 & 1\\end{bmatrix}\n$$\n\nSo, the minor is \n\n$$\n{M}_{32}=\\begin{vmatrix}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}.\n$$\n\nTherefore, the cofactor of ${b}_{32}$ is\n\n$$\n\\begin{aligned}{C}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =-{M}_{32} \\\\  & =-\\begin{vmatrix}-1 & 4 & 0 \\\\ 2 & 0 & 7 \\\\ -4 & 0 & 1\\end{vmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"} {:db/id #edb/ref 17592186119783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119597 :question/id #uuid "3e091496-053c-59fb-90d6-d8fb89ea6004" :question/math-academy-id "e-4449" :question/problem "Calculate the determinant of the matrix\n![](images/8a/8af3a07c6f7c326656a7be442b2bdec7e51e63c80d19213727494fce9c7cb720.png)" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+2\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{13} \\\\  & =2\\cdot |\\begin{aligned}∗ & ∗ & 2 & ∗ \\\\ 5 & 1 & ∗ & 0 \\\\ 1 & 6 & ∗ & -1 \\\\ -6 & 3 & ∗ & 0\\end{aligned}| \\\\  & =2(-1)^{1+3}|\\begin{aligned}5 & 1 & 0 \\\\ 1 & 6 & -1 \\\\ -6 & 3 & 0\\end{aligned}| \\\\  & =2(5|\\begin{aligned}6 & -1 \\\\ 3 & 0\\end{aligned}|-1|\\begin{aligned}1 & -1 \\\\ -6 & 0\\end{aligned}|+0|\\begin{aligned}1 & 6 \\\\ -6 & 3\\end{aligned}|) \\\\  & =2(5(6\\cdot 0+1\\cdot 3)-(1\\cdot 0-(-1)\\cdot (-6))+0(1\\cdot 3-6\\cdot (-6))) \\\\  & =2(15+6+0) \\\\  & =2\\cdot 21 \\\\  & =42\\end{aligned}\n$$"} :knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/questions [{:db/id #edb/ref 17592186120207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0843f07d-7e63-5667-aa53-1128919652ea" :answer/type {:db/ident :answer.type/math} :answer/value "-112" :db/id #edb/ref 17592186299971} {:answer/id #uuid "0cd7cf2f-5a7d-5888-8851-073bfc651c1f" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186299999} {:answer/id #uuid "279ddaf4-4285-58dd-9d16-ab377c009e2e" :answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186300151} {:answer/id #uuid "2c0fdb8f-cde8-5eb3-81e4-70beaa668e51" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186300176} {:answer/id #uuid "3243cc72-8722-5358-b43b-c8b6ceed365e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186300211}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186300151} :answer-field/id #uuid "6b52385f-d14f-5531-974a-819f1b812a30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301564}] :question/id #uuid "4807bb32-2a62-536d-a90f-b629a70d8fa6" :question/math-academy-id "q-32800" :question/problem "Calculate the determinant of the matrix\n$A=\\begin{bmatrix}0 & 8 & 0 & 0 \\\\ -1 & 0 & 0 & 0 \\\\ 3 & 1 & 6 & 2 \\\\ 1 & 0 & -1 & 2\\end{bmatrix}$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+8\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =8{C}_{12} \\\\  & =8\\cdot |\\begin{aligned}∗ & 8 & ∗ & ∗ \\\\ -1 & ∗ & 0 & 0 \\\\ 3 & ∗ & 6 & 2 \\\\ 1 & ∗ & -1 & 2\\end{aligned}| \\\\  & =8(-1)^{1+2}|\\begin{aligned}-1 & 0 & 0 \\\\ 3 & 6 & 2 \\\\ 1 & -1 & 2\\end{aligned}| \\\\  & =-8((-1)\\cdot |\\begin{aligned}6 & 2 \\\\ -1 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 2 \\\\ 1 & 2\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 6 \\\\ 1 & -1\\end{aligned}|) \\\\  & =8(6\\cdot 2-(-1)\\cdot 2)-0+0 \\\\  & =8\\cdot 14 \\\\  & =112\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44a53c04-e529-5980-9871-488b48753234" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186321687} {:answer/id #uuid "705109d1-3af4-5ff3-acf7-5d3d0f081f00" :answer/type {:db/ident :answer.type/math} :answer/value "-218" :db/id #edb/ref 17592186322023} {:answer/id #uuid "70f2e27b-b69d-5a8e-a251-9c44a0969327" :answer/type {:db/ident :answer.type/math} :answer/value "-197" :db/id #edb/ref 17592186322031} {:answer/id #uuid "825d1898-c1c5-515c-8d32-7d9391d79b76" :answer/type {:db/ident :answer.type/math} :answer/value "-255" :db/id #edb/ref 17592186322174} {:answer/id #uuid "fd14dd4b-300e-50c6-82b4-70959e79fea7" :answer/type {:db/ident :answer.type/math} :answer/value "315" :db/id #edb/ref 17592186323143}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-255" :db/id #edb/ref 17592186322174} :answer-field/id #uuid "9edb3717-adce-570c-8b92-ef6311946dc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323478}] :question/id #uuid "5f3bd215-2eb4-5f41-af3f-5119c1a64176" :question/math-academy-id "q-36055" :question/problem "Calculate the determinant of the matrix\n$A=\\begin{bmatrix}-3 & 0 & 0 & 5 \\\\ 0 & 0 & 3 & -2 \\\\ 4 & -1 & 2 & -3 \\\\ -1 & 6 & 0 & 0\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(A) & ={a}_{11}{C}_{11}+{a}_{12}{C}_{12}+{a}_{13}{C}_{13}+{a}_{14}{C}_{14} \\\\  & =(-3)\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+5\\cdot {C}_{14} \\\\  & =-3{C}_{11}+5{C}_{14} \\\\  & =(-3)\\cdot |\\begin{aligned}-3 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 3 & -2 \\\\ ∗ & -1 & 2 & -3 \\\\ ∗ & 6 & 0 & 0\\end{aligned}|+5\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 5 \\\\ 0 & 0 & 3 & ∗ \\\\ 4 & -1 & 2 & ∗ \\\\ -1 & 6 & 0 & ∗\\end{aligned}| \\\\  & =(-3)(-1)^{1+1}|\\begin{aligned}0 & 3 & -2 \\\\ -1 & 2 & -3 \\\\ 6 & 0 & 0\\end{aligned}|+5(-1)^{1+4}|\\begin{aligned}0 & 0 & 3 \\\\ 4 & -1 & 2 \\\\ -1 & 6 & 0\\end{aligned}| \\\\  & =-3|\\begin{aligned}0 & 3 & -2 \\\\ -1 & 2 & -3 \\\\ 6 & 0 & 0\\end{aligned}|-5|\\begin{aligned}0 & 0 & 3 \\\\ 4 & -1 & 2 \\\\ -1 & 6 & 0\\end{aligned}| \\\\  & =-3(0\\cdot |\\begin{aligned}2 & -3 \\\\ 0 & 0\\end{aligned}|-3\\cdot |\\begin{aligned}-1 & -3 \\\\ 6 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|) \\\\  & -5(0\\cdot |\\begin{aligned}-1 & 2 \\\\ 6 & 0\\end{aligned}|-0\\cdot |\\begin{aligned}4 & 2 \\\\ -1 & 0\\end{aligned}|+3\\cdot |\\begin{aligned}4 & -1 \\\\ -1 & 6\\end{aligned}|) \\\\  & =-3\\cdot (-3\\cdot (0+18)+(-2)\\cdot (0-12))-5\\cdot (3\\cdot (24-1)) \\\\  & =90-345 \\\\  & =-255\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254608a3-f4c4-524d-bdd6-4734ea7a9ed3" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186263322} {:answer/id #uuid "6ca6a3f0-0a99-59ca-89a0-00d1f53a84ec" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186263935} {:answer/id #uuid "848415f8-f9ee-573e-9e2c-e1517406f8f7" :answer/type {:db/ident :answer.type/math} :answer/value "-125" :db/id #edb/ref 17592186264137} {:answer/id #uuid "9205aebe-b2d8-5a93-8a96-975a2e76b5c9" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186264250} {:answer/id #uuid "e0fb479c-83a3-5744-99c8-93b5e83e4668" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186264955}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186264955} :answer-field/id #uuid "4716f2cc-0f74-549d-b0ab-845a4315cc85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265379}] :question/id #uuid "984e49ec-1c3a-575d-8328-f0b575ca3b17" :question/math-academy-id "q-131096" :question/problem "Calculate the determinant of the matrix\n$D=\\begin{bmatrix}0 & 0 & 0 & 1 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 1 & 2 & 3 \\\\ 6 & 5 & 3 & 0\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(D) & ={d}_{11}{C}_{11}+{d}_{12}{C}_{12}+{d}_{13}{C}_{13}+{d}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+1\\cdot {C}_{14} \\\\  & =1{C}_{14} \\\\  & =1\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 1 \\\\ 0 & 4 & 0 & ∗ \\\\ 0 & 1 & 2 & ∗ \\\\ 6 & 5 & 3 & ∗\\end{aligned}| \\\\  & =1(-1)^{1+4}|\\begin{aligned}0 & 4 & 0 \\\\ 0 & 1 & 2 \\\\ 6 & 5 & 3\\end{aligned}| \\\\  & =-1(0\\cdot |\\begin{aligned}1 & 2 \\\\ 5 & 3\\end{aligned}|-4\\cdot |\\begin{aligned}0 & 2 \\\\ 6 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 6 & 5\\end{aligned}|) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33a08f51-b677-5b68-ba7a-dac3baa9eb2a" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186263449} {:answer/id #uuid "6b51c736-ffe0-52cf-a537-2dbf8f99b091" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{31}{2}" :db/id #edb/ref 17592186263926} {:answer/id #uuid "86e76cd7-4277-5294-92f3-131eaa99845a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186264166} {:answer/id #uuid "ae7b46e1-3b32-525c-ad19-743406d4fd14" :answer/type {:db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186264501} {:answer/id #uuid "f10b6e0e-0a43-5cd2-aaf1-18a085bf0628" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186265117}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186263449} :answer-field/id #uuid "310e57cf-52eb-56bb-88ee-20cd79122820" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265333}] :question/id #uuid "ec31df61-abd0-5be5-8c6f-e699fba92ddd" :question/math-academy-id "q-131114" :question/problem "Calculate the determinant of the matrix\n$Z=\\begin{bmatrix}\\frac{1}{2} & 0 & 0 & 0 \\\\ 5 & 0 & -2 & 0 \\\\ 1 & 5 & 3 & 2 \\\\ 1 & 2 & 3 & 8\\end{bmatrix}$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =\\frac{1}{2}\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =\\frac{1}{2}{C}_{11} \\\\  & =\\frac{1}{2}\\cdot |\\begin{aligned}\\frac{1}{2} & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & 5 & 3 & 2 \\\\ ∗ & 2 & 3 & 8\\end{aligned}| \\\\  & =\\frac{1}{2}(-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ 5 & 3 & 2 \\\\ 2 & 3 & 8\\end{aligned}| \\\\  & =\\frac{1}{2}(0\\cdot |\\begin{aligned}3 & 2 \\\\ 3 & 8\\end{aligned}|-(-2)\\cdot |\\begin{aligned}5 & 2 \\\\ 2 & 8\\end{aligned}|+0\\cdot |\\begin{aligned}5 & 3 \\\\ 2 & 3\\end{aligned}|) \\\\  & =\\frac{1}{2}(0+2(5\\cdot 8-2\\cdot 2)+0) \\\\  & =\\frac{1}{2}\\cdot 72 \\\\  & =36\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ad7fbd-daaf-5638-b84c-e71398abac22" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263153} {:answer/id #uuid "1bafca79-f3d5-5d3c-94b1-acb828f5d148" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186263260} {:answer/id #uuid "4cf09706-5715-5579-bf1d-d65287fd8c53" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186263666} {:answer/id #uuid "d4648e08-8d5c-5a1c-9f99-ddecfd09c9a7" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186264849} {:answer/id #uuid "f09fabd2-0746-5418-a46d-e35f208be02e" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186265110}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186263260} :answer-field/id #uuid "79a1e1f3-7831-5686-8eed-cf31e6adf808" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265451}] :question/id #uuid "86