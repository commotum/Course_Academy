\begin{aligned}2 & 1 \\\\ 2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|+0\\cdot |\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|) \\\\  & =8\\cdot (-1)+(-3)\\cdot 1 \\\\  & =-8-3 \\\\  & =-11\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bec7eef-98ab-50a1-a827-b84e71a0b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186300251} {:answer/id #uuid "3f84bdbb-e043-5047-a36e-5da69a5c79e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300274} {:answer/id #uuid "48bd8464-99de-5369-8e7b-9fe677ea1700" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186300331} {:answer/id #uuid "a04b15ad-a1bc-5b8c-b98c-a273e45d97d8" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186300771} {:answer/id #uuid "a93e42c1-d25f-5c74-aa8c-ac931bf2b4fd" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186300810}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186300251} :answer-field/id #uuid "bf01f982-1095-5239-a807-cfb6858ba6e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301851}] :question/id #uuid "f43456bf-f295-5e3b-a9b3-15b153a5e800" :question/math-academy-id "q-32727" :question/problem "Calculate the determinant of the matrix\n$S=\\begin{bmatrix}0 & 2 & 0 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ 1 & 2 & -5 & 4 \\\\ 4 & 0 & 2 & 2\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(S) & ={s}_{11}{C}_{11}+{s}_{12}{C}_{12}+{s}_{13}{C}_{13}+{s}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{12} \\\\  & =2\\cdot |\\begin{aligned}∗ & 2 & ∗ & ∗ \\\\ 1 & ∗ & 0 & 0 \\\\ 1 & ∗ & -5 & 4 \\\\ 4 & ∗ & 2 & 2\\end{aligned}| \\\\  & =2(-1)^{1+2}|\\begin{aligned}1 & 0 & 0 \\\\ 1 & -5 & 4 \\\\ 4 & 2 & 2\\end{aligned}| \\\\  & =-2(1\\cdot |\\begin{aligned}-5 & 4 \\\\ 2 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 4 \\\\ 4 & 2\\end{aligned}|+0\\cdot |\\begin{aligned}1 & -5 \\\\ 4 & 2\\end{aligned}|) \\\\  & =-2((-5\\cdot 2-4\\cdot 2)-0+0) \\\\  & =-2\\cdot (-18) \\\\  & =36\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abde6ff-968f-5c10-a57e-e9337ccb9853" :answer/type {:db/ident :answer.type/math} :answer/value "-198" :db/id #edb/ref 17592186299986} {:answer/id #uuid "0c0b0e8c-b5e8-5d1a-8a64-83154e74252f" :answer/type {:db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186299995} {:answer/id #uuid "1824105f-b810-5b30-a0aa-0beb57bd268f" :answer/type {:db/ident :answer.type/math} :answer/value "-108" :db/id #edb/ref 17592186300062} {:answer/id #uuid "6e3832ab-4326-5da4-9681-13c8424ca43e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186300518} {:answer/id #uuid "b97de0dc-d8bc-5f26-9307-169bdbb2d021" :answer/type {:db/ident :answer.type/math} :answer/value "-432" :db/id #edb/ref 17592186300890}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-432" :db/id #edb/ref 17592186300890} :answer-field/id #uuid "54890664-57f3-5254-b119-6383b3902222" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301501}] :question/id #uuid "8643e81c-8c77-5255-a120-2681f124c049" :question/math-academy-id "q-32791" :question/problem "Calculate the determinant of the matrix\n$T=\\begin{bmatrix}-1 & 0 & 4 & 0 \\\\ 9 & 0 & 0 & 0 \\\\ -1 & 6 & 0 & 2 \\\\ 1 & 0 & 3 & -2\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(T) & ={t}_{11}{C}_{11}+{t}_{12}{C}_{12}+{t}_{13}{C}_{13}+{t}_{14}{C}_{14} \\\\  & =(-1)\\cdot {C}_{11}+0\\cdot {C}_{12}+4\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =-{C}_{11}+4{C}_{13} \\\\  & =(-1)\\cdot |\\begin{aligned}-1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 0 & 0 \\\\ ∗ & 6 & 0 & 2 \\\\ ∗ & 0 & 3 & -2\\end{aligned}|+4\\cdot |\\begin{aligned}∗ & ∗ & 4 & ∗ \\\\ 9 & 0 & ∗ & 0 \\\\ -1 & 6 & ∗ & 2 \\\\ 1 & 0 & ∗ & -2\\end{aligned}| \\\\  & =(-1)\\cdot (-1)^{1+1}|\\begin{aligned}0 & 0 & 0 \\\\ 6 & 0 & 2 \\\\ 0 & 3 & -2\\end{aligned}|+4\\cdot (-1)^{1+3}|\\begin{aligned}9 & 0 & 0 \\\\ -1 & 6 & 2 \\\\ 1 & 0 & -2\\end{aligned}| \\\\  & =-(0\\cdot |\\begin{aligned}0 & 2 \\\\ 3 & -2\\end{aligned}|-0\\cdot |\\begin{aligned}6 & 2 \\\\ 0 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}6 & 0 \\\\ 0 & 3\\end{aligned}|)+4(9\\cdot |\\begin{aligned}6 & 2 \\\\ 0 & -2\\end{aligned}|-0\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}-1 & 6 \\\\ 1 & 0\\end{aligned}|) \\\\  & =-0+4\\cdot 9(6\\cdot (-2)-2\\cdot 0) \\\\  & =36\\cdot (-12) \\\\  & =-432\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e995287-b0ce-5d14-adf9-a8c9c41bfbc6" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186321381} {:answer/id #uuid "2135e8a8-7aa1-5be7-a729-d18fff9337df" :answer/type {:db/ident :answer.type/math} :answer/value "-51" :db/id #edb/ref 17592186321397} {:answer/id #uuid "23cebe08-003e-58dd-b604-3b895669fb51" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186321421} {:answer/id #uuid "30a88961-6b47-51d0-bc38-90b444ad5cdb" :answer/type {:db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186321521} {:answer/id #uuid "ec560ecf-e9c3-5994-aee2-a1534c401d48" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186323004}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186321521} :answer-field/id #uuid "9029e3eb-d47c-517f-8e68-1e0ac69f0975" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323449}] :question/id #uuid "5505f107-cfef-57b0-b433-16953d2d1848" :question/math-academy-id "q-36045" :question/problem "Calculate the determinant of the matrix\n$Z=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & -3 & 5 & 4 \\\\ 0 & 4 & 3 & 5\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+(-1)\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}-{C}_{13} \\\\  & =1\\cdot |\\begin{aligned}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & -3 & 5 & 4 \\\\ ∗ & 4 & 3 & 5\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & -1 & ∗ \\\\ 0 & 0 & ∗ & 0 \\\\ 0 & -3 & ∗ & 4 \\\\ 0 & 4 & ∗ & 5\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|+(-1)\\cdot (-1)^{1+3}|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|-|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =(0\\cdot |\\begin{aligned}5 & 4 \\\\ 3 & 5\\end{aligned}|-(-2)\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}-3 & 5 \\\\ 4 & 3\\end{aligned}|)-(0\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|-0\\cdot |\\begin{aligned}0 & 4 \\\\ 0 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}0 & -3 \\\\ 0 & 4\\end{aligned}|) \\\\  & =0+2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0-(0-0+0) \\\\  & =2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}| \\\\  & =2((-3)\\cdot 5-4\\cdot 4) \\\\  & =2\\cdot (-31) \\\\  & =-62\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c5244df-f0a9-5c2e-a73e-51aa0a825ac6" :answer/type {:db/ident :answer.type/math} :answer/value "-178" :db/id #edb/ref 17592186321614} {:answer/id #uuid "4c8e0c45-d2b6-5efa-8628-e01af954659c" :answer/type {:db/ident :answer.type/math} :answer/value "148" :db/id #edb/ref 17592186321750} {:answer/id #uuid "52dec254-4e05-5958-b362-9315402fc410" :answer/type {:db/ident :answer.type/math} :answer/value "-371" :db/id #edb/ref 17592186321800} {:answer/id #uuid "db1797e4-6de8-5d10-b3fb-c58f8e24e85f" :answer/type {:db/ident :answer.type/math} :answer/value "315" :db/id #edb/ref 17592186322864} {:answer/id #uuid "f5e68f5c-b2e0-51fc-9ac1-cb001e6b3caa" :answer/type {:db/ident :answer.type/math} :answer/value "157" :db/id #edb/ref 17592186323074}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "148" :db/id #edb/ref 17592186321750} :answer-field/id #uuid "0f090c82-dafa-5202-866e-f37a38c4880e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323196}] :question/id #uuid "59bec8fd-d214-5893-9146-596b7aabe9e9" :question/math-academy-id "q-36053" :question/problem "Calculate the determinant of the matrix\n$U=\\begin{bmatrix}5 & -2 & 0 & 0 \\\\ 0 & 0 & 1 & 0 \\\\ 3 & 6 & 0 & 1 \\\\ -3 & 2 & 5 & -4\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(U) & ={u}_{11}{C}_{11}+{u}_{12}{C}_{12}+{u}_{13}{C}_{13}+{u}_{14}{C}_{14} \\\\  & =5\\cdot {C}_{11}+(-2)\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =5{C}_{11}-2{C}_{12} \\\\  & =5\\cdot |\\begin{aligned}5 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 1 & 0 \\\\ ∗ & 6 & 0 & 1 \\\\ ∗ & 2 & 5 & -4\\end{aligned}|+(-2)\\cdot |\\begin{aligned}∗ & -2 & ∗ & ∗ \\\\ 0 & ∗ & 1 & 0 \\\\ 3 & ∗ & 0 & 1 \\\\ -3 & ∗ & 5 & -4\\end{aligned}| \\\\  & =5\\cdot (-1)^{1+1}|\\begin{aligned}0 & 1 & 0 \\\\ 6 & 0 & 1 \\\\ 2 & 5 & -4\\end{aligned}|+(-2)\\cdot (-1)^{1+2}|\\begin{aligned}0 & 1 & 0 \\\\ 3 & 0 & 1 \\\\ -3 & 5 & -4\\end{aligned}| \\\\  & =5|\\begin{aligned}0 & 1 & 0 \\\\ 6 & 0 & 1 \\\\ 2 & 5 & -4\\end{aligned}|+2|\\begin{aligned}0 & 1 & 0 \\\\ 3 & 0 & 1 \\\\ -3 & 5 & -4\\end{aligned}| \\\\  & =5(0\\cdot |\\begin{aligned}0 & 1 \\\\ 5 & -4\\end{aligned}|-1\\cdot |\\begin{aligned}6 & 1 \\\\ 2 & -4\\end{aligned}|+0\\cdot |\\begin{aligned}6 & 0 \\\\ 2 & 5\\end{aligned}|)+2(0\\cdot |\\begin{aligned}0 & 1 \\\\ 5 & -4\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 1 \\\\ -3 & -4\\end{aligned}|+0\\cdot |\\begin{aligned}3 & 0 \\\\ -3 & 5\\end{aligned}|) \\\\  & =5(0-(6\\cdot (-4)-1\\cdot 2)+0)+2(0-(3\\cdot (-4)-1\\cdot (-3))+0) \\\\  & =5\\cdot 26+2\\cdot 9 \\\\  & =130+18 \\\\  & =148\\end{aligned}\n$$"} {:db/id #edb/ref 17592186368541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea4df699-7d9c-5d0f-9c99-1f7c51c9eb05" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186368543} {:answer/id #uuid "d5501494-bc71-5997-8259-0e5ae5acb0ba" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186368544} {:answer/id #uuid "6c10f6a2-fd34-5592-aac4-362e161f9a0c" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186368545} {:answer/id #uuid "93b023b1-7456-560d-a37c-931aaca0765c" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186368546} {:answer/id #uuid "db2b9044-1bff-57ee-ae25-64a27083c912" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368547}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186368543} :answer-field/id #uuid "db95a348-0986-5700-b656-e8563530f38a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368542}] :question/id #uuid "46279f1d-0462-5a35-b644-65d4c737b0e0" :question/math-academy-id "q-40212" :question/problem "Calculate the determinant of the matrix\n$H=\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 7 & 0 & 0 & 0 \\\\ -1 & 5 & 0 & 2 \\\\ 1 & 0 & 3 & -2\\end{bmatrix}.$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(H) & ={h}_{11}{C}_{11}+{h}_{12}{C}_{12}+{h}_{13}{C}_{13}+{h}_{14}{C}_{14} \\\\  & =2\\cdot {C}_{11}+0\\cdot {C}_{12}+(-1)\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2\\cdot {C}_{11}+(-1)\\cdot {C}_{13} \\\\  & =2\\cdot |\\begin{aligned}2 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & 0 & 0 \\\\ ∗ & 5 & 0 & 2 \\\\ ∗ & 0 & 3 & -2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & -1 & ∗ \\\\ 7 & 0 & ∗ & 0 \\\\ -1 & 5 & ∗ & 2 \\\\ 1 & 0 & ∗ & -2\\end{aligned}| \\\\  & =2\\cdot (-1)^{1+1}|\\begin{aligned}0 & 0 & 0 \\\\ 5 & 0 & 2 \\\\ 0 & 3 & -2\\end{aligned}|+(-1)\\cdot (-1)^{1+3}|\\begin{aligned}7 & 0 & 0 \\\\ -1 & 5 & 2 \\\\ 1 & 0 & -2\\end{aligned}| \\\\  & =2|\\begin{aligned}0 & 0 & 0 \\\\ 5 & 0 & 2 \\\\ 0 & 3 & -2\\end{aligned}|-|\\begin{aligned}7 & 0 & 0 \\\\ -1 & 5 & 2 \\\\ 1 & 0 & -2\\end{aligned}| \\\\  & =2(0\\cdot |\\begin{aligned}0 & 2 \\\\ 3 & -2\\end{aligned}|-0\\cdot |\\begin{aligned}5 & 2 \\\\ 0 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}5 & 0 \\\\ 0 & 3\\end{aligned}|)-(7\\cdot |\\begin{aligned}5 & 2 \\\\ 0 & -2\\end{aligned}|-0\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & -2\\end{aligned}|+0\\cdot |\\begin{aligned}-1 & 5 \\\\ 1 & 0\\end{aligned}|) \\\\  & =2(0)-(7(-10)) \\\\  & =-(-70) \\\\  & =70\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :topic/math-academy-id 1769 :topic/title "The Determinant of an NxN Matrix"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186130288} :activity/id #uuid "cf0445f2-a611-590c-9874-d90229e6ea42" :activity/steps [{:db/id #edb/ref 17592186130288 :step/content {:db/id #edb/ref 17592186130360 :tutorial/content "An **initial value problem (IVP)** for a homogeneous linear system has the form\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t),\n\\qquad \n\\mathbf{x}(t_0)=\\mathbf{x}_0,\n$$\n\nwhere $A$ is a constant $2 \\times 2$ matrix and $\\mathbf{x}_0\\in\\mathbb{R}^2$ is the given initial state at $t=t_0.$ In other words, in an IVP we seek the solution of $\\mathbf{x}'(t)=A\\mathbf{x}(t)$ that passes through the point $\\mathbf{x}_0$ at $t=t_0.$\n\nTo solve an IVP, we proceed as follows:\n\n- Find the general solution of the system $\\mathbf{x}'(t)=A\\mathbf{x}(t){:}$ \n\n$$\n\\mathbf{x}(t)=c_1\\mathbf{x}_1(t)+c_2\\mathbf{x}_2(t)\n$$\n\n- Substitute $t=t_0$ into the general solution and use the initial condition $\\mathbf{x}(t_0)=\\mathbf{x}_0{:}$\n\n$$\n\\mathbf{x}(t_0)=c_1\\mathbf{x}_1(t_0)+c_2\\mathbf{x}_2(t_0)\n\\qquad\\Rightarrow\\qquad\nc_1\\mathbf{x}_1(t_0)+c_2\\mathbf{x}_2(t_0)=\\mathbf{x}_0\n$$\n\n- Solve the resulting linear system for $c_1$ and $c_2,$ then substitute those values back into $\\mathbf{x}(t).$\n\nThe definition (and the procedure) above generalizes directly to the $n\\times n$ case.\n\nLet's see some concrete examples of solving an IVP." :tutorial/id #uuid "92ec67c9-079c-5825-825b-08cca4b2cf25" :tutorial/math-academy-id 3651 :tutorial/title "Introduction"} :step/id #uuid "c26cbdb9-e4ae-57e4-8ad0-478213ccd227" :step/next {:db/id #edb/ref 17592186130289}} {:db/id #edb/ref 17592186130289 :step/content {:db/id #edb/ref 17592186129311 :knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7"} :step/id #uuid "d0ac3561-63c3-5604-a2d7-f38c8ca2d824" :step/next {:db/id #edb/ref 17592186130290}} {:db/id #edb/ref 17592186130290 :step/content {:db/id #edb/ref 17592186129312 :knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1"} :step/id #uuid "89c5622e-b252-5578-bb6d-ccdb5821b61d" :step/next {:db/id #edb/ref 17592186130291}} {:db/id #edb/ref 17592186130291 :step/content {:db/id #edb/ref 17592186129313 :knowledge-point/id #uuid "833d0ec0-d895-5d66-b2ad-d058858caf9e"} :step/id #uuid "0fe5a7b9-5aff-56d9-8bcf-d38aed54ee82"}] :activity/title "Solving Homogeneous Systems of ODEs With Distinct Eigenvalues and Initial Conditions" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186129399}] :db/id #edb/ref 17592186050098 :topic/knowledge-points [{:db/id #edb/ref 17592186129311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128884 :question/id #uuid "e16376f2-ffb9-580c-a7e7-57f5814f8289" :question/math-academy-id "e-21137" :question/problem "Solve the initial value problem\n![](images/c7/c7bdf20729aac1938756be1b2fa530004a77924e0c00b4d7f0fb8ddae7368ff1.svg)\ngiven that the general solution to our differential equation is\n![](images/d5/d52cacaec3d2c2e516c3b3cfa085e113bb39cd4dc1e6bcc50583ceae566f9c07.svg)\n\nThe solution to the initial value problem is\n\n![](images/7c/7c9f6a4acce39bd7847045fb6faf2868aca76b9b85904dcbe4991202a18be7a9.svg)" :question/worked-solution "To find the values of $c_1$ and $c_2$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =\\begin{bmatrix}7 \\\\ -1\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}{e}^{0}+{c}_{2}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{0} & =\\begin{bmatrix}7 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}3{c}_{1}+2{c}_{2} \\\\ {c}_{1}-{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3{c}_{1}+2{c}_{2} &=7 \\\\ {c}_{1}-{c}_{2} &=-1.\\end{aligned}\\right.\n$$\n\nMultiplying the second equation by $2$ and adding the result to the first equation, we get\n\n$$\n5c_1= 5 \n\\qquad\\Longrightarrow\\qquad\nc_1 = 1.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n1 - c_2 = -1\n\\qquad\\Longrightarrow\\qquad\nc_2 = 2.\n$$\n\n \nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =1\\cdot \\begin{bmatrix}3 \\\\ 1\\end{bmatrix}{e}^{t}+2\\cdot \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{-t} \\\\  & =\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}{e}^{t}+\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}{e}^{-t}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7" :knowledge-point/questions [{:db/id #edb/ref 17592186129578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0490d2f0-fe28-5967-9617-bbb17cd67f0b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186413745}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186413745} :answer-field/id #uuid "4265eaf3-4298-5be3-9a5f-defa76c03f8b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413772} {:answer-field/choices [{:answer/id #uuid "5e2b5b83-31df-56b6-880c-ad3705a2ea13" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413753}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413753} :answer-field/id #uuid "78faa26c-94b2-5ee2-86ab-c3fcb3b05b17" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413777} {:answer-field/choices [{:answer/id #uuid "82fec8d2-3786-50ca-a921-4689b6afec2e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413757}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186413757} :answer-field/id #uuid "cf0e110a-54da-543d-aa0a-cb20cc674499" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413781} {:answer-field/choices [{:answer/id #uuid "e5041c10-08ae-56e7-bc0e-86c30d564ece" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413765}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413765} :answer-field/id #uuid "e7da8384-bec0-52ca-95f9-6b880e18d11d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413783}] :question/id #uuid "c0eaa03d-11bc-5f47-92e3-86afc2afb668" :question/math-academy-id "q-321994" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{0}+{c}_{2}\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}{e}^{0} & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix} \\\\ \\begin{bmatrix}{c}_{1}+2{c}_{2} \\\\ -{c}_{1}+2{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{c}_{1}+2{c}_{2} &=3 \\\\ -{c}_{1}+2{c}_{2} &=-1.\\end{aligned}\\right.\n$$\n\nAdding the equations, we get\n\n$$\n4{c}_{2}=2\\,⟹\\,{c}_{2}=\\frac{1}{2}.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n{c}_{1}+2\\cdot \\frac{1}{2}=3\\,⟹\\,{c}_{1}=2.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot \\begin{bmatrix}1 \\\\ -1\\end{bmatrix}{e}^{t}+\\frac{1}{2}\\cdot \\begin{bmatrix}2 \\\\ 2\\end{bmatrix}{e}^{-t} \\\\  & =\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}{e}^{t}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c6a383d-9e67-5d62-bd5b-52639d0e77ae" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300748}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300748} :answer-field/id #uuid "262e46e8-8324-5bc3-b2f5-0210cf37f87b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301347} {:answer-field/choices [{:answer/id #uuid "d45cc54c-dfed-5dbf-aa6b-581412a2827c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301018}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301018} :answer-field/id #uuid "7a1827e2-dc24-5cfd-81ac-d5684e41efcc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301607} {:answer-field/choices [{:answer/id #uuid "f7a617bd-7bf7-517f-8dec-a50221c9a2c1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301184}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301184} :answer-field/id #uuid "d1599b40-f206-5186-8238-723af6aca7a3" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301900} {:answer-field/choices [{:answer/id #uuid "ef53bd4e-4800-5aaf-9083-099632a545b0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186301147}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186301147} :answer-field/id #uuid "d72e62b9-fea9-57e4-84e0-69f7750d27d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301919}] :question/id #uuid "c0d346a2-b012-5c0d-b429-60020e32ca6b" :question/math-academy-id "q-326002" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =\\begin{bmatrix}5 \\\\ 3\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{0}+{c}_{2}\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}{e}^{0} & =\\begin{bmatrix}5 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}{c}_{1}+3{c}_{2} \\\\ 2{c}_{1}-{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{c}_{1}+3{c}_{2} &=5 \\\\ 2{c}_{1}-{c}_{2} &=3.\\end{aligned}\\right.\n$$\n\nMultiplying the first equation by $-2$ and adding the result to the second equation, we get\n\n$$\n-7{c}_{2}=-7\\,⟹\\,{c}_{2}=1.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n{c}_{1}+3\\cdot 1=5\\,⟹\\,{c}_{1}=2.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}{e}^{t}+1\\cdot \\begin{bmatrix}3 \\\\ -1\\end{bmatrix}{e}^{-t} \\\\  & =\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}{e}^{t}+\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}{e}^{-t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8125d9f9-f4af-56a1-b204-b8a703b08de4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300601}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300601} :answer-field/id #uuid "a669c623-02c7-5ab4-9fc8-8081dc524680" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301761} {:answer-field/choices [{:answer/id #uuid "b9f53f41-be5e-5c1d-804e-34a14bfb5355" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300891}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300891} :answer-field/id #uuid "be70e067-8dc9-572e-b33b-25e08b326ea8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301849} {:answer-field/choices [{:answer/id #uuid "59a8a55a-048b-5c1c-8f00-6091ba0158bc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186300427}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186300427} :answer-field/id #uuid "cf47952d-08cf-55ed-8703-30906d97b198" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301893} {:answer-field/choices [{:answer/id #uuid "5bf7fafa-90e2-591f-b73e-44b5f9a19b53" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300435}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300435} :answer-field/id #uuid "f01f6bac-5cea-513f-8fb5-0b8e35c8fb78" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301992}] :question/id #uuid "b50067c4-fc94-5eda-819f-5e879abcd43d" :question/math-academy-id "q-326291" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=\\begin{bmatrix}7 \\\\ 1\\end{bmatrix}\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =\\begin{bmatrix}7 \\\\ 1\\end{bmatrix} \\\\ {c}_{1}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{0}+{c}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{0} & =\\begin{bmatrix}7 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}2{c}_{1}+{c}_{2} \\\\ -{c}_{1}+{c}_{2}\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2{c}_{1}+{c}_{2} &=7 \\\\ -{c}_{1}+{c}_{2} &=1.\\end{aligned}\\right.\n$$\n\nMultiplying the second equation by $2$ and adding the result to the  first equation, we get\n\n$$\n3{c}_{2}=9\\,⟹\\,{c}_{2}=3.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n-{c}_{1}+3=1\\,⟹\\,{c}_{1}=2.\n$$\n\n \nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot \\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t}+3\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}{e}^{-t} \\\\  & =\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}{e}^{t}+\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}{e}^{-t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8d14c6-940a-5c30-9c64-8d3111b48209" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300173}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300173} :answer-field/id #uuid "27d90ee8-9b7b-5655-bdb9-b35845b8a020" :answer-field/key "field-1" :answe