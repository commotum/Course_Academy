e point $A,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+sv+t\\overset{\\to }{AB} \\\\ r & =⟨6,0,2⟩+s⟨3,1,-2⟩+t⟨-5,1,1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09eff712-270d-559e-b2ed-1b87d24b561f" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-7,6,-3⟩+t⟨-9,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186259965} {:answer/id #uuid "7aaf24c1-4af3-5471-a6e4-7bbde47ce0bb" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260946} {:answer/id #uuid "ac345a14-1f68-5fe2-8828-2ef99a48c407" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261380} {:answer/id #uuid "bc74f471-d5ff-5ade-bba5-ec27b6ff5caf" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨6,3,-7⟩+t⟨-3,9,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261534} {:answer/id #uuid "da3efea4-2fb6-5260-9315-bcfe7be8b9f0" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨3,7,-6⟩+t⟨-4,3,9⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261802}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r=⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260946} :answer-field/id #uuid "859eebf0-098a-5a3c-8e3c-589906da5209" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262354}] :question/id #uuid "016cb0cc-72ee-551e-911e-dc0a1ad297a4" :question/math-academy-id "q-128743" :question/problem "Find a parametric equation of the plane that passes through the points $U(7,-2,3),\\,V(4,4,-4),$ and $W(3,7,6).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{UV}$ and $\\overset{\\to }{UW},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨4,4,-4⟩-⟨7,-2,3⟩ \\\\  & =⟨-3,6,-7⟩ \\\\ \\overset{\\to }{UW} & =⟨3,7,6⟩-⟨7,-2,3⟩ \\\\  & =⟨-4,9,3⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨7,-2,3⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+s\\overset{\\to }{UV}+t\\overset{\\to }{UW} \\\\ r & =⟨7,-2,3⟩+s⟨-3,6,-7⟩+t⟨-4,9,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03170ce6-1b74-5d0c-a740-266903fa4105" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨-6,4,2⟩+t⟨4,-4,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186259902} {:answer/id #uuid "31b47527-c857-57e6-abe0-41faa15df975" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨4,2,6⟩+t⟨-4,-3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260322} {:answer/id #uuid "3648beed-e103-5bec-8bc9-7ee681a02fbd" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260359} {:answer/id #uuid "7a29aab3-eefc-5ee1-beae-88249bb83af5" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,4,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260941} {:answer/id #uuid "a7218829-3284-55b3-b600-8e4433336662" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨-6,2,4⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261332}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260359} :answer-field/id #uuid "0824088c-267c-