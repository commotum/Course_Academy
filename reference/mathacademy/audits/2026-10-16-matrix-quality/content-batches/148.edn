#{[{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186120618} :activity/id #uuid "3366a432-0200-5657-84c5-2f4c70949b50" :activity/steps [{:db/id #edb/ref 17592186120618 :step/content {:db/id #edb/ref 17592186121017 :tutorial/content "Recall that a matrix is square if the number of rows equals the number of columns. There are other types of square matrices with special names.\n\n- An **upper triangular** matrix is a square matrix in which all entries *below* the diagonal are zeros. For example, the following matrices are all upper triangular matrices:\n\n$$\n\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}\n$$\n\nNote that we can have any number (including $0$) on the diagonal and above.\n\n- A **lower triangular** matrix is a square matrix in which all entries *above* the diagonal are zeros. For example, the following matrices are all lower triangular matrices:\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\n$$\n\nAgain, note that we can have any number (including $0$) on the diagonal and below." :tutorial/id #uuid "658a47dc-4d32-5d9d-a04c-82d683e87739" :tutorial/math-academy-id 2983 :tutorial/title "Introduction"} :step/id #uuid "0875c7e7-20f2-5b83-a1f5-9093d3858f8f" :step/next {:db/id #edb/ref 17592186120619}} {:db/id #edb/ref 17592186120619 :step/content {:db/id #edb/ref 17592186119771 :knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff"} :step/id #uuid "f83b8528-ff65-5b6a-bea6-468db866d515" :step/next {:db/id #edb/ref 17592186120620}} {:db/id #edb/ref 17592186120620 :step/content {:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc"} :step/id #uuid "90b3b26e-ba95-5b5e-9a86-150997167d4d" :step/next {:db/id #edb/ref 17592186120640}} {:db/id #edb/ref 17592186120640 :step/content {:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54"} :step/id #uuid "8d9eee18-666a-559e-97a4-dfccb293303c"}] :activity/title "Triangular Matrices" :activity/type {:db/ide