/ref 17592186410894}] :question/id #uuid "5e3aacfb-29e6-50e7-83f4-efffd6632659" :question/math-academy-id "q-70967" :question/problem "Find a parametric equation of the plane that passes through the point $R(\\sqrt{2},3,-1)$ and is parallel to the vectors ${v}_{1}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}$  and ${v}_{2}=\\begin{bmatrix}-5 \\\\ 1.5 \\\\ 2\\end{bmatrix}.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $R$ is $p=\\begin{bmatrix}\\sqrt{2} \\\\ 3 \\\\ -1\\end{bmatrix}$, and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}$  and ${v}_{2}=\\begin{bmatrix}-5 \\\\ 1.5 \\\\ 2\\end{bmatrix}.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=\\begin{bmatrix}\\sqrt{2} \\\\ 3 \\\\ -1\\end{bmatrix}+s\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ 1.5 \\\\ 2\\end{bmatrix},\\,s,t\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186410902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1652fb-1168-5910-b443-bc4d2aaa83b2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-2,3,4⟩+s⟨3,2,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410876} {:answer/id #uuid "6de998f6-75b1-5c9e-b4ad-4610846cd003" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨5,1,3⟩+t⟨6,-4,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410877} {:answer/id #uuid "6f370def-22e8-5622-8821-0b17c7041552" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨5,-1,3⟩+t⟨-2,6,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410878} {:answer/id #uuid "8c776c18-debc-5cbb-81e5-adcde0157d0d" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,-4,1⟩+s⟨-1,-3,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410881} {:answer/id #uuid "a4cfb9d5-2ef9-5254-9cf0-fa366d4db62f" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨3,-1,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410885}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,-1,4⟩+s⟨3,-1,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186410885} :answer-field/id #uuid "06437268-d863-51cb-b3b0-cea274d91aa3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410892}] :question/id #uuid "d22837b0-87ad-552e-9bb4-a7dfb550ed51" :question/math-academy-id "q-128466" :question/problem "Find a parametric equation of the plane that passes through the point $E(2,-1,4)$ and is parallel to the vectors ${v}_{1}=⟨3,-1,5⟩$  and ${v}_{2}=⟨6,-2,4⟩.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $E$ is $p=⟨2,-1,4⟩$ and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=⟨3,-1,5⟩$  and ${v}_{2}=⟨6,-2,4⟩.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=⟨2,-1,4⟩+s⟨3,-1,5⟩+t⟨6,-2,4⟩,\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"} {:db/id #edb/ref 17592186119934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119664 :question/id #uuid "b86eace4-01cb-5601-8e9b-2658e81fc656" :question/math-academy-id "e-5884" :question/problem "Find a normal vector to the plane \n\n$$\n\\mathbf{r}= \\langle -6,3, 2 \\rangle + t \\langle 4, 2, -1 \\rangle + s \\langle 4, -3, 2 \\rangle,\\qquad t,\\,s \\in (-\\infty,\\infty).\n$$" :question/worked-solution "From the parametric equation, we have that $\\mathbf{v} = \\langle 4, 2, -1 \\rangle$ and $\\mathbf{w} = \\langle 4, -3, 2 \\rangle$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $\\mathbf{v}$ and $\\mathbf{w}$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =\\begin{bmatrix}4 \\\\ 2 \\\\ -1\\end{bmatrix}\\times \\begin{bmatrix}4 \\\\ -3 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 4 & 2 & -1 \\\\ 4 & -3 & 2\\end{vmatrix} \\\\  & =i-12j-20k \\\\  & =⟨1,-12,-20⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $\\mathbf{n}=\\langle 1, -12, -20 \\rangle.$"} :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/questions [{:db/id #edb/ref 17592186120277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc5a327-948f-52bc-9425-a1da5c008b85" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-3, \\sqrt{2}⟩" :db/id #edb/ref 17592186117802} {:answer/id #uuid "1ad1ef08-8e25-56d5-81a4-d8415b600831" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-20,-21⟩" :db/id #edb/ref 17592186117803} {:answer/id #uuid "466567c6-7d78-5c8f-bcbc-e93fb9a1922a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 34,-14, 11⟩" :db/id #edb/ref 17592186117804} {:answer/id #uuid "520486a4-098a-554d-aaba-77c2dbbe8a53" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-4, 3⟩" :db/id #edb/ref 17592186117805} {:answer/id #uuid "768cf5fc-fd19-53e6-9c22-78654b2744df" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 43,-11, 14⟩" :db/id #edb/ref 17592186117806}] :answer-field/id #uuid "5be3308d-6e28-5a8a-ae4d-0380fed569a7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117801}] :question/id #uuid "a44a633c-f708-59a5-ba3d-1849b40eba40" :question/math-academy-id "q-33816" :question/problem "Find a nor