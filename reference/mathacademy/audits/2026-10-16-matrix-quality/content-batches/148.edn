{bmatrix}.\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 5 & -2\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ 3 & 6\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 4 & 3\\end{bmatrix}\\begin{bmatrix}-2 & 1 \\\\ -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 1 \\\\ -23 & 10\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "820b9c20-45ba-5de9-bb8b-af39b16c9e09" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -18 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186375600} {:answer/id #uuid "ae8e5c22-2007-5bee-a8c6-367d57800d00" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -12 \\\\ -3 & 14\\end{bmatrix}" :db/id #edb/ref 17592186375601} {:answer/id #uuid "ccb49c47-6d12-5ccf-86ec-19b3a6a0b835" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -6 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186375602} {:answer/id #uuid "885945eb-10d2-5fdc-8538-d0c388289fe3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -3 \\\\ 13 & 11\\end{bmatrix}" :db/id #edb/ref 17592186375603} {:answer/id #uuid "d641aa56-a1eb-541f-be4a-bd4ecd276eac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 10 & 8\\end{bmatrix}" :db/id #edb/ref 17592186375604}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -3 \\\\ 13 & 11\\end{bmatrix}" :db/id #edb/ref 17592186375603} :answer-field/id #uuid "1ff368e9-8ea0-51a4-8f24-f214ce6cf4d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375599}] :question/id #uuid "79a5e7a2-1011-5d57-b87b-c63e9e620d