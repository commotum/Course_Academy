stion/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply.\n\n$A=\\begin{bmatrix}8 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & -4 & 5 \\\\ 0 & 0 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 0 & 6 \\\\ 0 & -1 & 3 \\\\ 5 & 7 & 11\\end{bmatrix},\\,C=\\begin{bmatrix}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{bmatrix}.$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b19292e-d665-566f-8c6f-7d83c4d69c31" :answer/type {:db/ident :answer.type/math} :answer/value "C=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186333545} {:answer/id #uuid "7039880d-285d-542d-8eed-1662170a86ab" :answer/type {:db/ident :answer.type/math} :answer/value "A=\\begin{bmatrix}1 & 0 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186334012} {:answer/id #uuid "7de24423-58a1-5fc2-baf5-dde65d746a91" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186334113} {:answer/id #uuid "ca309238-a2b3-5c28-8c7c-56e6c410616b" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186334750} {:answer/id #uuid "fbe722d3-8558-53eb-8a6e-850293b2db44" :answer/type {:db/ident :answer.type/math} :answer/value "E=\\begin{bmatrix}2 & 4 & 0 \\\\ 4 & 0 & 4 \\\\ 0 & 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186335199}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "C=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186333545} :answer-field/id #uuid "96649b7c-8415-520e-af03-f8b52df45dd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335522}] :question/id #uuid "91c8b870-01b8-5cdd-a0e6-31fdbbd32f0e" :question/math-academy-id "q-68740" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $C$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nC=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 2 & 3\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 1 & -3\\end{bmatrix},\\,D=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix},\\,E=\\begin{bmatrix}2 & 4 & 0 \\\\ 4 & 0 & 4 \\\\ 0 & 4 & 2\\end{bmatrix}.\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186262604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf88710f-b87c-5266-9c5f-535bd49454b9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437734} {:answer/id #uuid "54a08cb6-41ab-5dc1-bc15-470540725af6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437735}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437735} :answer-field/id #uuid "2e9b060c-75fd-538d-8b17-6f8f74704b24" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438896} {:answer-field/choices [{:answer/id #uuid "0da38aeb-d192-5fcc-aea2-560c50d82228" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437736} {:answer/id #uuid "eadcc0f5-f9fb-5083-aa37-83f8b2760849" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437737}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437737} :answer-field/id #uuid "a5131af3-1aac-5801-be71-61200d0fdb9b" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438897} {:answer-field/choices [{:answer/id #uuid "7a7a55f2-8f01-5f1a-af2e-f30eed260d15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437738} {:answer/id #uuid "e0ffc388-0f49-5422-b561-53cde5fd175e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437739}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437738} :answer-field/id #uuid "fc9f1a6e-ca69-519f-bba4-6e7006ac48ac" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438898}] :question/id #uuid "addfb264-5013-5ace-a74a-d9286a8c951b" :question/math-academy-id "q-126351" :question/problem "Which of the following matrices are lower triangular matrices?\n\nSelect all that apply.\n\n$A=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}5 & 0 \\\\ -1 & 2\\end{bmatrix},\\,C=\\begin{bmatrix}1 & -2 \\\\ 0 & 5\\end{bmatrix}.$" :question/worked-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =-2\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37c4a7a7-6201-5e3d-b83c-54214a0f73f1" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260369} {:answer/id #uuid "5cc900a1-3450-5e9d-9935-fbf3414db9ed" :answer/type {:db/ident :answer.type/math} :answer/value "C=\\begin{bmatrix}0 & -1 \\\\ 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186260670} {:answer/id #uuid "89212b5f-4485-5c4a-b4e2-c1ef65585d7b" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186261068} {:answer/id #uuid "bebca5d9-6d1a-5817-b8da-7eabbdef4d81" :answer/type {:db/ident :answer.type/math} :answer/value "A=\\begin{bmatrix}4 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186261559} {:answer/id #uuid "ffcb6a99-0bd4-51ca-8095-57e4548dde55" :answer/type {:db/ident :answer.type/math} :answer/value "E=\\begin{bmatrix}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186262118}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260369} :answer-field/id #uuid "58d1ccae-7378-52fd-94ac-13da15be20dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262276}] :question/id #uuid "e2e910d3-5a56-5ffe-990b-2c75157e1876" :question/math-academy-id "q-126352" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $D$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nD=\\begin{bmatrix}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=\\begin{bmatrix}4 & 0 \\\\ 1 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}0 & -1 \\\\ 5 & 1\\end{bmatrix},\\,E=\\begin{bmatrix}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{bmatrix}.\n$$\n\nSo, they are not upper triangular matrices."}