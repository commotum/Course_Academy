b/ident :answer-field.type/radio} :db/id #edb/ref 17592186403899}] :question/id #uuid "bb2dd55a-4969-5401-b5e0-478786fa3f74" :question/math-academy-id "q-77726" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-3 & \\sqrt{3} \\\\ 1 & \\sqrt{3}\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${S}^{′}$, the image of $S(-4,\\sqrt{3})$ under the action of $T?$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $S:$\n\n$$\nx=\\begin{bmatrix}-4 \\\\ \\sqrt{3}\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}-3 & \\sqrt{3} \\\\ 1 & \\sqrt{3}\\end{bmatrix}\\begin{bmatrix}-4 \\\\ \\sqrt{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${S}^{′}.$ Therefore, ${S}^{′}(15,-1).$"} {:db/id #edb/ref 17592186292879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7f34bc5-5382-5d09-a78d-1d83d3ca89a5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291366}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291366} :answer-field/id #uuid "2bc14e43-474c-5ee1-b018-5ca8c6cee591" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291881} {:answer-field/choices [{:answer/id #uuid "dc35a557-b9c5-5487-98d9-9e638dfc1989" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186291557}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186291557} :answer-field/id #uuid "434310cc-0d44-5504-9b20-ec510130d83b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291955}] :question/id #uuid "c6fc43cc-9bd6-5841-a4ac-6a1e26d9c74d" :question/math-academy-id "q-275707" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}7 & 0 \\\\ 2 & -4\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${C}^{′}$, the image of $C(0,3)$ under the action of $T?$\n\n${C}^{′}($ \n{{field-1}},\n{{field-2}}$)$" :question/worked-solution "To find the image of $C$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $C:$\n\n$$\nx=\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}7 & 0 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -12\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${C}^{′}.$ Therefore, ${C}^{′}(0,-12).$"} {:db/id #edb/ref 17592186295177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a97a109b-a79f-5370-a4d4-2eec3bc5f2ce" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293601}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293601} :answer-field/id #uuid "86b1bdfd-66a8-5d2e-9923-45fc27e7be28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294408} {:answer-field/choices [{:answer/id #uuid "55bd13b9-8936-588e-8f26-c945849863a3" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293280}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293280} :answer-field/id #uuid "d2cf55d4-8e98-54ac-bf3b-05efc7f067c4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294675}] :question/id #uuid "423a710d-2505-558c-badc-6a2f314dce98" :question/math-academy-id "q-281085" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}6 & -2 \\\\ -3 & 1\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${S}^{′}$, the image of $S(2,-1)$ under the action of $T?$\n\n${S}^{′}($ \n{{field-1}},\n{{field-2}}$)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $S:$\n\n$$\nx=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}6 & -2 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${S}^{′}.$ Therefore, ${S}^{′}(14,-7).$"} {:db/id #edb/ref 17592186295178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f02332b-f7b0-5a90-b31e-e4497deecef3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293060}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293060} :answer-field/id #uuid "81cae86e-00f7-5e39-a493-45075afd382e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294388} {:answer-field/choices [{:answer/id #uuid "c3ea1a52-6f26-5d94-9a72-67e3369860f6" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293694}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293694} :answer-field/id #uuid "df8b593e-096b-5b7d-acf1-efb2222d37c9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294709}] :question/id #uuid "c22179b9-c0f6-5d75-8b5d-9beb46bf3a76" :question/math-academy-id "q-281092" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & -2 \\\\ -1 & -3\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${Y}^{′}$, the image of $Y(-2,-3)$ under the action of $T?$\n\n${Y}^{′}($ \n\n$-2$\n\n,\n\n$11$\n\n$)$" :question/worked-solution "To find the image of $Y$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $Y:$\n\n$$\nx=\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}4 & -2 \\\\ -1 & -3\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 11\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${Y}^{′}.$ Therefore, ${Y}^{′}(-2,11).$"} {:db/id #edb/ref 17592186345322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f2ee3a3-cf39-5eb9-82d4-2110081e5a92" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-3)" :db/id #edb/ref 17592186342893} {:answer/id #uuid "5459dcb6-b4cc-5b42-9fd8-ccb3b9a913e9" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186342938} {:answer/id #uuid "9dfdf6c8-f892-5393-9010-38d180624224" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-8)" :db/id #edb/ref 17592186343627} {:answer/id #uuid "b8bf73c7-8168-5d30-b9d7-10baedc7e935" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-3)" :db/id #edb/ref 17592186343860} {:answer/id #uuid "c493d67f-bb36-500d-b1a8-29054467041c" :answer/type {:db/ident :answer.type/math} :answer/value "(15,3)" :db/id #edb/ref 17592186343967}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(15,-3)" :db/id #edb/ref 17592186342893} :answer-field/id #uuid "966218f8-dd42-572f-a8b4-dd829b381562" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344752}] :question/id #uuid "44d3fff6-a66b-5a3f-b651-b86044576cd9" :question/math-academy-id "q-77720" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}5 & 1 \\\\ -1 & -3\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${C}^{′}$, the image of $C(3,0)$ under the action of $T?$" :question/worked-solution "To find the image of $C$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $C:$\n\n$$\nx=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}5 & 1 \\\\ -1 & -3\\end{bmatrix}\\begin{bmatrix}3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${C}^{′}.$ Therefore, ${C}^{′}(15,-3).$"} {:db/id #edb/ref 17592186345323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02991cf9-24c1-55cc-a293-49c889ec2faf" :answer/type {:db/ident :answer.type/math} :answer/value "(1,6)" :db/id #edb/ref 17592186342275} {:answer/id #uuid "1e59a1db-48c6-5485-b2ed-5dadf51bf960" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-2)" :db/id #edb/ref 17592186342491} {:answer/id #uuid "40864c0f-6692-575e-8983-9ab4e26710c5" :answer/type {:db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186342770} {:answer/id #uuid "91c04ea2-5b42-51d9-96e9-a3ec33309ec4" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,6)" :db/id #edb/ref 17592186343514} {:answer/id #uuid "ccae8a34-814a-5667-a11e-2ba0120bdfc8" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186344042}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186342770} :answer-field/id #uuid "773836bd-c59b-5c53-b2c3-d0153b2e0547" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344708}] :question/id #uuid "d1b1bc76-df9f-5ec2-a421-c2681cdf387f" :question/math-academy-id "q-77722" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}3 & 2 \\\\ 4 & 1\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${F}^{′}$, the image of $F(2,-2)$ under the action of $T?$" :question/worked-solution "To find the image of $F$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $F:$\n\n$$\nx=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}3 & 2 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${F}^{′}.$ Therefore, ${F}^{′}(2,6).$"} {:db/id #edb/ref 17592186345324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7edb2e-74f0-5cf0-9dde-74d0c594cf55" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2}-6,-8)" :db/id #edb/ref 17592186342851} {:answer/id #uuid "4cde7ca6-2336-560f-90cc-2f624b2a4727" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\sqrt{2}-10)" :db/id #edb/ref 17592186342872} {:answer/id #uuid "72412802-a583-5939-a60b-75c8867214ad" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-8)" :db/id #edb/ref 17592186343228} {:answer/id #uuid "826d416a-0da5-56b0-96ea-a8126b189abc" :answer/type {:db/ident :answer.type/math} :answer/value "(-8,-8)" :db/id #edb/ref 17592186343357} {:answer/id #uuid "fb398415-d073-5f61-8e07-61e90c0ba4ee" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-12)" :db/id #edb/ref 17592186344447}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(-4,-8)" :db/id #edb/ref 17592186343228} :answer-field/id #uuid "953b8a0a-ad59-529a-9ada-12db58b3d105" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344750}] :question/id #uuid "e0db87fc-3475-5cbe-98ff-ada0db8bf1ab" :question/math-academy-id "q-77725" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}\\sqrt{2} & 3 \\\\ \\sqrt{2} & 5\\end{bmatrix}.\n$$\n\nWhat are the coordinates of the point ${K}^{′}$, the image of $K(\\sqrt{2},-2)$ under the action of $T?$" :question/worked-solution "To find the image of $K$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $K:$\n\n$$\nx=\\begin{bmatrix}\\sqrt{2} \\\\ -2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =\\begin{bmatrix}\\sqrt{2} & 3 \\\\ \\sqrt{2} & 5\\end{bmatrix}\\begin{bmatrix}\\sqrt{2} \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -8\\end{bmatrix}.\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${K}^{′}.$ Therefore, ${K}^{′}(-4,-8).$"}] :knowledge-point/title "Computing the Image of a Point Under a Linear Transformation of a Plane"} {:db/id #edb/ref 17592186152180 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151975 :question/id #uuid "2195a964-074f-5beb-abcd-ba0229e2872b" :question/math-academy-id "e-6705" :question/problem "Consider the line $5x-y-3=0$ and linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n![](images/3b/3b0c64bc040716ca8ba42c78a229d1249ec7f80a3a4a584970863b20126c69db.png)\n\nWhat is the equation of the image of the line under the action of $\\mathbf T?$" :question/worked-solution "First, let's find two points on the given line. Solving for $y,$ we get $y=5x-3,$ and substituting $x=0$ and $x=1,$ we get\n\n$$\n\\begin{aligned}x=0\\, & \\to \\,y=5(0)-3=-3, \\\\ x=1\\, & \\to \\,y=5(1)-3=2.\\end{aligned}\n$$\n\nSo we have two points on the line, $P(0,-3)$ and $Q(1,2).$\n\nTo find the images of $P$ and $Q$ under the action of $\\mathbf T,$ we first create a matrix $X$ containing the coordinates of $P$ and $Q$ in its columns:\n\n![](images/a3/a32e0386507fdc40cc713854dde4ec413c2dfbb4c49a6e758e8690344f08459a.png)\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-3 & 1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -1 \\\\ -6 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are $P'(-3,-6)$ and $Q'(-1,3).$\n\nFinally, we write the equation of the line that passes through $P'$ and $Q'\\mathbin{:}$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-6) & =\\frac{3-(-6)}{-1-(-3)}(x-(-3)) \\\\ y+6 & =\\frac{9}{2}(x+3) \\\\ 2y+12 & =9x+27 \\\\ 9x-2y+15 & =0\\end{aligned}\n$$"} :knowledge-point/id #uuid "15e8730b-c59a-5897-8c83-073b54f517a9" :knowledge-point/questions [{:db/id #edb/ref 17592186152772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d1c6d6-f50a-5e3f-98fd-d298c4ddb5d0" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y+12=0" :db/id #edb/ref 17592186342527} {:answer/id #uuid "52c7145d-678c-565e-80a5-6f24ddad86df" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y-3=0" :db/id #edb/ref 17592186342931} {:answer/id #uuid "84d25803-e711-5701-95a5-329911a92774" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-6=0" :db/id #edb/ref 17592186343375} {:answer/id #uuid "c6b5d10c-de41-59c8-9b05-7690930244e2" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2y+12=0" :db/id #edb/ref 17592186343981} {:answer/id #uuid "f18baa84-ae58-59aa-8e13-bacd6d59f8d3" :answer/type {:db/ident :answer.type/math} :answer/value "x+2y-3=0" :db/id #edb/ref 17592186344363}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x-2y+12=0" :db/id #edb/ref 17592186343981} :answer-field/id #uuid "1e6de43e-b508-5c28-8c68-d7a6f646a0b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344544}] :question/id #uuid "e32e993e-cfb5-51a2-b706-960009cef89a" :question/math-academy-id "q-77653" :question/problem "Consider the line $2x+y-3=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-2 & 0 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $2x+y-3=0$ passes through the points $A(0,3)$ and $B(1,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 3 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 \\\\ 6 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(0,6)$ and ${B}^{′}(-2,3).$\n\nFinally, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-6 & =\\frac{3-6}{-2-0}(x-0) \\\\ y-6 & =\\frac{3}{2}x \\\\ 2y-12 & =3x \\\\ 3x-2y+12 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61957a3d-bfda-588d-8c95-8a10d8459a46" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+5=0" :db/id #edb/ref 17592186343066} {:answer/id #uuid "7101f1f5-af01-5bd2-b2cb-473d3ade2bfe" :answer/type {:db/ident :answer.type/math} :answer/value "5x-y+10=0" :db/id #edb/ref 17592186343208} {:answer/id #uuid "8c1850ca-e710-5013-9a82-3dadba27e402" :answer/type {:db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186343463} {:answer/id #uuid "a17d9e10-721c-57c2-87ab-08d9c1e2288a" :answer/type {:db/ident :answer.type/math} :answer/value "x=15" :db/id #edb/ref 17592186343662} {:answer/id #uuid "e27ec612-42f3-5f46-a253-db1247fd7800" :answer/type {:db/ident :answer.type/math} :answer/value "x-5y+1=0" :db/id #edb/ref 17592186344230}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-y+5=0" :db/id #edb/ref 17592186343066} :answer-field/id #uuid "f2d4cc33-f56c-5689-b0c0-e673307732de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344916}] :question/id #uuid "d73144ad-ba24-5f26-a684-3b73d6271ce0" :question/math-academy-id "q-77680" :question/problem "Consider the line $x=5$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $x=5$ passes through the points $A(5,0)$ and $B(5,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}5 & 5 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}5 & 5 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & -4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(-5,0)$ and ${B}^{′}(-4,1).$\n\nFinally, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-0 & =\\frac{1-0}{-4-(-5)}(x-(-5)) \\\\ y & =x+5 \\\\ x-y+5 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7cf9fb-2748-55a6-8271-1c3791be5f89" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234638}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234638} :answer-field/id #uuid "25e29aac-931d-5222-bbb2-a1d17df3dd34" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235009} {:answer-field/choices [{:answer/id #uuid "957bc082-670c-5705-bcfc-cdbf8408b7ab" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234778}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234778} :answer-field/id #uuid "9aba945f-00f2-537a-b98b-aff5f046cfbc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235157}] :question/id #uuid "6e55f089-7b94-5b7c-ab84-c252ff5d0037" :question/math-academy-id "q-138787" :question/problem "The architect finds the image of the line $l$ under the action of $T$ and places another highway on the plan from this image. The equation of the line on which the new highway lies, in **standard form**, is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$x\\,+\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$y\\,=\\,3.$" :question/worked-solution "In part 1, we found that the matrix representation of $T$ is\n\n$$\nT=\\begin{bmatrix}-3 & 0 \\\\ 2 & -1\\end{bmatrix}.\n$$\n\nFirst, notice that the line $2x+y+1=0$ passes through the points $U(-1,1)$ and $V(0,-1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $U$ and $V$ under the action of $T,$ we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}-1 & 0 \\\\ 1 & -1\\end{bmatrix}\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-3 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ -3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${U}^{′}(3,-3)$ and ${V}^{′}(0,1).$\n\nFinally, we write the equation of the line that passes through ${U}^{′}$ and ${V}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-3) & =\\frac{1-(-3)}{0-3}(x-3) \\\\ y+3 & =-\\frac{4}{3}(x-3) \\\\ 3y+9 & =-4x+12 \\\\ 4x+3y+9 & =12 \\\\ 4x+3y & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efec58a1-5f92-5d94-be02-0b098559bf73" :answer/type {:db/ident :answer.type/math} :answer/value "x-2y" :db/id #edb/ref 17592186291636}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-2y" :db/id #edb/ref 17592186291636} :answer-field/id #uuid "9588b20e-782a-5573-9c91-6ffce77ba5c8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292203}] :question/id #uuid "5e498204-fa98-5bb7-916f-b857c86e36b0" :question/math-academy-id "q-275715" :question/problem "Consider the line $x=-2$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & 4 \\\\ 3 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=14.$" :question/worked-solution "First, notice that the line $x=-2$ passes through the points $G(-2,0)$ and $H(-2,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $G$ and $H$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}-2 & -2 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & 4 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}-2 & -2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 6 \\\\ -6 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${G}^{′}(2,-6)$ and ${H}^{′}(6,-4).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-6) & =\\frac{-4-(-6)}{6-2}(x-2) \\\\ y+6 & =\\frac{1}{2}(x-2)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+6 & =\\frac{1}{2}(x-2) \\\\ 2y+12 & =x-2 \\\\ 12+2 & =x-2y \\\\ x-2y & =14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9402ba3b-21c7-5980-b028-0d2ae3dec972" :answer/type {:db/ident :answer.type/math} :answer/value "2x-17y" :db/id #edb/ref 17592186291273}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x-17y" :db/id #edb/ref 17592186291273} :answer-field/id #uuid "1757a243-7d9f-5f9f-88e4-f2c86fe644a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291820}] :question/id #uuid "4741a969-3b4d-5db1-9617-3b585ef65b54" :question/math-academy-id "q-275719" :question/problem "Consider the line $4x-y-3=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 4 \\\\ -2 & 1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=27.$" :question/worked-solution "First, notice that the line $4x-y-3=0$ passes through the points $U(0,-3)$ and $V(1,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $U$ and $V$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -3 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & 4 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & 5 \\\\ -3 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${U}^{′}(-12,-3)$ and ${V}^{′}(5,-1).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-3) & =\\frac{-1-(-3)}{5-(-12)}(x-(-12)) \\\\ y+3 & =\\frac{2}{17}(x+12)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+3 & =\\frac{2}{17}(x+12) \\\\ 17y+51 & =2x+24 \\\\ 51-24 & =2x-17y \\\\ 2x-17y & =27\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b1f0073-5232-5ab2-8850-19be8c191eb6" :answer/type {:db/ident :answer.type/math} :answer/value "x+y" :db/id #edb/ref 17592186293377}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+y" :db/id #edb/ref 17592186293377} :answer-field/id #uuid "2e0acd77-2dfd-580e-b1b7-f7ad07915075" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294084}] :question/id #uuid "f2ef5880-c743-5e3b-81b9-cc6ecf11b073" :question/math-academy-id "q-281578" :question/problem "Consider the line $x=4$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}3 & -2 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=16.$" :question/worked-solution "First, notice that the line $x=4$ passes through the points $G(4,0)$ and $H(4,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $G$ and $H$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}4 & 4 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}3 & -2 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}4 & 4 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 10 \\\\ 4 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${G}^{′}(12,4)$ and ${H}^{′}(10,6).$\n\nNow, we write the equation of the line that passes through ${G}^{′}$ and ${H}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-4 & =\\frac{6-4}{10-12}(x-12) \\\\ y-4 & =-1(x-12)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-4 & =-x+12 \\\\ x+y & =16\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b0c2cae-fd84-5bff-a3cb-91d31399a070" :answer/type {:db/ident :answer.type/math} :answer/value "x-4y" :db/id #edb/ref 17592186293542}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-4y" :db/id #edb/ref 17592186293542} :answer-field/id #uuid "51f17138-d0c4-53b0-b0b2-dc3652c5334c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294222}] :question/id #uuid "4c349395-df7b-587e-b1ad-c70a17b7ecf2" :question/math-academy-id "q-281580" :question/problem "Consider the line $y=-1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & 0 \\\\ 1 & -2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-8.$" :question/worked-solution "First, notice that the line $y=-1$ passes through the points $P(0,-1)$ and $Q(1,-1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $P$ and $Q$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -1 & -1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}4 & 0 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 4 \\\\ 2 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${P}^{′}(0,2)$ and ${Q}^{′}(4,3).$\n\nNow, we write the equation of the line that passes through ${P}^{′}$ and ${Q}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-2 & =\\frac{3-2}{4-0}(x-0) \\\\ y-2 & =\\frac{1}{4}x\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}4y-8 & =x \\\\ x-4y & =-8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065dc4d4-a48f-5d1c-92e1-b1fdf4a16695" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y" :db/id #edb/ref 17592186292960}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+y" :db/id #edb/ref 17592186292960} :answer-field/id #uuid "feda8f3e-bbc9-5272-ae50-b9c806e78c6e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294823}] :question/id #uuid "3d868d9a-891d-5483-acd7-41d25e644ee4" :question/math-academy-id "q-281581" :question/problem "Consider the line $y=3$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 3 \\\\ -2 & 1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=21.$" :question/worked-solution "First, notice that the line $y=3$ passes through the points $P(0,3)$ and $Q(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $P$ and $Q$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 3 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & 3 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 3 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 10 \\\\ 3 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${P}^{′}(9,3)$ and ${Q}^{′}(10,1).$\n\nNow, we write the equation of the line that passes through ${P}^{′}$ and ${Q}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-3 & =\\frac{1-3}{10-9}(x-9) \\\\ y-3 & =-2(x-9)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-3 & =-2x+18 \\\\ 2x+y & =21\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2008d135-daf7-5ec3-9e1b-630e5eacdb8a" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2y" :db/id #edb/ref 17592186293067}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x+2y" :db/id #edb/ref 17592186293067} :answer-field/id #uuid "15afe838-a3e6-5560-bae6-60db93a24970" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293998}] :question/id #uuid "bd4cc3a5-f3b8-5388-adc4-aea0319b6a56" :question/math-academy-id "q-281582" :question/problem "Consider the line $y=2$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 1 \\\\ -3 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=14.$" :question/worked-solution "First, notice that the line $y=2$ passes through the points $P(0,2)$ and $Q(1,2)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $P$ and $Q$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 2 & 2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 1 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 4 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${P}^{′}(2,4)$ and ${Q}^{′}(4,1).$\n\nNow, we write the equation of the line that passes through ${P}^{′}$ and ${Q}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-4 & =\\frac{1-4}{4-2}(x-2) \\\\ y-4 & =-\\frac{3}{2}(x-2)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-4 & =-\\frac{3}{2}(x-2) \\\\ 2y-8 & =-3x+6 \\\\ 3x+2y & =14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572ba60a-9664-5170-96a3-a8c6b99cb360" :answer/type {:db/ident :answer.type/math} :answer/value "8x+5y" :db/id #edb/ref 17592186293286}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8x+5y" :db/id #edb/ref 17592186293286} :answer-field/id #uuid "40f8e4b9-d891-552d-b480-4c82265bd847" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294155}] :question/id #uuid "9fca37fa-c882-5ba4-928c-7be773c41602" :question/math-academy-id "q-281583" :question/problem "Consider the line $3x+2y-6=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=42.$" :question/worked-solution "First, notice that the line $3x+2y-6=0$ passes through the points $P(0,3)$ and $Q(2,0)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $P$ and $Q$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 2 \\\\ 3 & 0\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 3 \\\\ 1 & -2\\end{bmatrix}\\begin{bmatrix}0 & 2 \\\\ 3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 4 \\\\ -6 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${P}^{′}(9,-6)$ and ${Q}^{′}(4,2).$\n\nNow, we write the equation of the line that passes through ${P}^{′}$ and ${Q}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-6) & =\\frac{2-(-6)}{4-9}(x-9) \\\\ y+6 & =\\frac{8}{-5}(x-9)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+6 & =-\\frac{8}{5}(x-9) \\\\ 5y+30 & =-8x+72 \\\\ 8x+5y & =42\\end{aligned}\n$$\n\n$$\n8x+5y=42\n$$"} {:db/id #edb/ref 17592186295211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c763680-b76e-56bc-853f-fd7cec146a99" :answer/type {:db/ident :answer.type/math} :answer/value "8x-7y" :db/id #edb/ref 17592186293120}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8x-7y" :db/id #edb/ref 17592186293120} :answer-field/id #uuid "59849dcd-7a30-5582-8c3c-ce0968a260df" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294251}] :question/id #uuid "4baa3913-7ffc-55e5-9cc4-571282f5d439" :question/math-academy-id "q-281586" :question/problem "Consider the line $-4x+y+1=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}3 & 1 \\\\ 0 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=6.$" :question/worked-solution "First, notice that the line $-4x+y+1=0$ passes through the points $P(0,-1)$ and $Q(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $P$ and $Q$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -1 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}3 & 1 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 6 \\\\ -2 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${P}^{′}(-1,-2)$ and ${Q}^{′}(6,6).$\n\nNow, we write the equation of the line that passes through ${P}^{′}$ and ${Q}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y+2 & =\\frac{6-(-2)}{6-(-1)}(x+1) \\\\ y+2 & =\\frac{8}{7}(x+1)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}7y+14 & =8x+8 \\\\ 8x-7y & =6\\end{aligned}\n$$\n\n$$\n8x-7y=6\n$$"} {:db/id #edb/ref 17592186345334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11605969-3706-5dda-b841-ac4452fbfba4" :answer/type {:db/ident :answer.type/math} :answer/value "4x+y-5=0" :db/id #edb/ref 17592186342390} {:answer/id #uuid "83aaceab-5f72-53b2-9595-8cc957d33720" :answer/type {:db/ident :answer.type/math} :answer/value "4x-y+5=0" :db/id #edb/ref 17592186343362} {:answer/id #uuid "8f34997b-ab29-5cfd-86ed-8636fd7a8f7f" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-8=0" :db/id #edb/ref 17592186343493} {:answer/id #uuid "c415f86f-6afa-5b78-a8cc-8816edff0ef7" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y-2=0" :db/id #edb/ref 17592186343960} {:answer/id #uuid "e1e3ef59-0055-5433-9983-c3a31bf9c995" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y+5=0" :db/id #edb/ref 17592186344227}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-8=0" :db/id #edb/ref 17592186343493} :answer-field/id #uuid "defc360b-c612-53da-86d1-c1ab58465251" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344883}] :question/id #uuid "4a4e066c-5e1b-524d-ad56-ae1fa09d9242" :question/math-academy-id "q-77794" :question/problem "Consider the line $x=1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & -2 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $x=1$ passes through the points $J(1,0)$ and $K(1,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $J$ and $K$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & -2 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${J}^{′}(2,1)$ and ${K}^{′}(0,4).$\n\nFinally, we write the equation of the line that passes through ${J}^{′}$ and ${K}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-1 & =\\frac{4-1}{0-2}(x-2) \\\\ y-1 & =-\\frac{3}{2}(x-2) \\\\ 2y-2 & =-3x+6 \\\\ 3x+2y-8 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b6ed43-18b0-5e46-a873-e1de06820436" :answer/type {:db/ident :answer.type/math} :answer/value "5x+6y-12=0" :db/id #edb/ref 17592186342812} {:answer/id #uuid "478d3de6-54ae-591c-b152-e39763253c30" :answer/type {:db/ident :answer.type/math} :answer/value "5x-6y-2=0" :db/id #edb/ref 17592186342830} {:answer/id #uuid "7b781f07-e1d1-555f-835b-b774429997ef" :answer/type {:db/ident :answer.type/math} :answer/value "6x-5y+12=0" :db/id #edb/ref 17592186343299} {:answer/id #uuid "95ff06b8-609d-542d-b055-b8fc2feb66e9" :answer/type {:db/ident :answer.type/math} :answer/value "6x+5y+12=0" :db/id #edb/ref 17592186343549} {:answer/id #uuid "eb347a4c-4a6a-533f-89d4-37c6581b8a3a" :answer/type {:db/ident :answer.type/math} :answer/value "5x-6y+12=0" :db/id #edb/ref 17592186344297}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6x+5y+12=0" :db/id #edb/ref 17592186343549} :answer-field/id #uuid "9f5df122-7b22-5a07-b66d-c53c16e11e16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344771}] :question/id #uuid "836e83a5-a45a-5ec2-8875-53cb69e61091" :question/math-academy-id "q-77893" :question/problem "Consider the line $2x-y-4=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & -2 \\\\ 0 & 3\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $2x-y-4=0$ passes through the points $R(0,-4)$ and $S(1,-2)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $R$ and $S$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -4 & -2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & -2 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -4 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 3 \\\\ -12 & -6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${R}^{′}(8,-12)$ and ${S}^{′}(3,-6).$\n\nFinally, we write the equation of the line that passes through ${R}^{′}$ and ${S}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-12) & =\\frac{-6-(-12)}{3-8}(x-8) \\\\ y+12 & =-\\frac{6}{5}(x-8) \\\\ 5y+60 & =-6x+48 \\\\ 6x+5y+12 & =0\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Image of a Line Given by an Equation in Standard Form"} {:db/id #edb/ref 17592186152181 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151976 :question/id #uuid "2192176c-e983-5913-b159-4d2bffd72ae1" :question/math-academy-id "e-6713" :question/problem "Consider the line $y=3x-2$ and linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n![](images/3a/3af646f67ee7157e5157ddd1d4296716e859c7d7c7c18d45037219ed4f75606e.png)\n\nWhat is the equation of the image of the line under the action of $\\mathbf T?$" :question/worked-solution "First, let's find two points on the given line. Substituting $x=0$ and $x=1,$ we get\n\n$$\n\\begin{aligned}x=0\\, & \\to \\,y=3(0)-2=-2, \\\\ x=1\\, & \\to \\,y=3(1)-2=1.\\end{aligned}\n$$\n\nSo we have two points on the line, $P(0,-2)$ and $Q(1,1).$\n\nTo find the images of $P$ and $Q$ under the action of $\\mathbf T,$ we first create a matrix $X$ containing the coordinates of $P$ and $Q$ in its columns:\n\n![](images/ea/eaa950b7f0525109f33153dc28218222e1da17d7643281e9ac17776e87503784.png)\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -1 \\\\ -2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are $P'(0,-2)$ and $Q'(-1,4).$\n\nFinally, we write the equation of the line that passes through $P'$ and $Q'\\mathbin{:}$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-2) & =\\frac{4-(-2)}{-1-0}(x-0) \\\\ y+2 & =-6x \\\\ 6x+y+2 & =0\\end{aligned}\n$$"} :knowledge-point/id #uuid "0c8f0fa1-a86a-577f-bdc9-fc7427faa18d" :knowledge-point/questions [{:db/id #edb/ref 17592186152773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4720550c-73e8-5a7d-a20d-a93330b7f231" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y+10=0" :db/id #edb/ref 17592186342826} {:answer/id #uuid "511117c8-eb8e-5d71-9992-9281faec6571" :answer/type {:db/ident :answer.type/math} :answer/value "x+y-5=0" :db/id #edb/ref 17592186342908} {:answer/id #uuid "9c2535f7-684c-561d-acfb-3da82ca46ef9" :answer/type {:db/ident :answer.type/math} :answer/value "x+y-10=0" :db/id #edb/ref 17592186343614} {:answer/id #uuid "a6406ee7-72cd-577d-907f-7abeef9d4b19" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y-10=0" :db/id #edb/ref 17592186343703} {:answer/id #uuid "c1ad0be6-b7d3-5a93-83c7-622d57c9f4de" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y-5=0" :db/id #edb/ref 17592186343941}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+y-10=0" :db/id #edb/ref 17592186343703} :answer-field/id #uuid "3ed0e649-d943-52dc-b4a5-717301ec84fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344595}] :question/id #uuid "37a13f57-9ab6-5d1d-ae59-976508835fe2" :question/math-academy-id "q-77677" :question/problem "Consider the line $y=2x-5$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & -1 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=2x-5$ passes through the points $A(0,-5)$ and $B(1,-3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -5 & -3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & -1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -5 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(5,0)$ and ${B}^{′}(4,2).$\n\nFinally, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-0 & =\\frac{2-0}{4-5}(x-5) \\\\ y & =-2(x-5) \\\\ y & =-2x+10 \\\\ 2x+y-10 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186152776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f97b1c-312b-573e-b050-d2d597ef53bb" :answer/type {:db/ident :answer.type/math} :answer/value "4x - 5y - 21 = 0" :db/id #edb/ref 17592186151164} {:answer/id #uuid "de5898c5-3dd9-5be3-a946-750c778ffd86" :answer/type {:db/ident :answer.type/math} :answer/value "5x + 4y + 21 = 0" :db/id #edb/ref 17592186151165} {:answer/id #uuid "e6299137-639a-5bbc-8c99-175a9a1096f1" :answer/type {:db/ident :answer.type/math} :answer/value "5x - y - 21 = 0" :db/id #edb/ref 17592186151166} {:answer/id #uuid "41ed9943-4602-5efe-bcfc-03547fd8c78d" :answer/type {:db/ident :answer.type/math} :answer/value "5x + 4y - 12 = 0" :db/id #edb/ref 17592186151167} {:answer/id #uuid "455fd2ae-fc63-5c37-8dc4-e009fe325a53" :answer/type {:db/ident :answer.type/math} :answer/value "5x - 4y - 21 = 0" :db/id #edb/ref 17592186151168}] :answer-field/id #uuid "253524b4-625a-5799-9519-d51314f1183b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151163}] :question/id #uuid "2630ce88-1734-5eb3-8fa8-89be112e3a4a" :question/math-academy-id "q-77768" :question/problem "Consider the line $y = 2x + 3$ and linear transformation $T$ with matrix representation $T$, given by\n\n$T = \\begin{bmatrix}-2 & -1 \\\\ 1 & -3\\end{bmatrix}$.\n\nWhat is the equation of the image of the line under the action of $T$?"} {:db/id #edb/ref 17592186295032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f986182a-bd04-53ae-90f9-fdbd963faa83" :answer/type {:db/ident :answer.type/math} :answer/value "7x+6y" :db/id #edb/ref 17592186293912}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7x+6y" :db/id #edb/ref 17592186293912} :answer-field/id #uuid "2d40fb35-abec-5c6b-95b3-624905074b6e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294081}] :question/id #uuid "57feeefc-2725-5f9f-9505-90a7f564c3c4" :question/math-academy-id "q-278618" :question/problem "Consider the line $y=3x+5$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}0 & -2 \\\\ 4 & 1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-40.$" :question/worked-solution "First, notice that the line $y=3x+5$ passes through the points $A(0,5)$ and $B(1,8)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & -2 \\\\ 4 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}0 & -2 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 5 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 & -16 \\\\ 5 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(-10,5)$ and ${B}^{′}(-16,12).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-5 & =\\frac{12-5}{-16-(-10)}(x-(-10)) \\\\ y-5 & =-\\frac{7}{6}(x+10)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-5 & =-\\frac{7}{6}(x+10) \\\\ 6y-30 & =-7x-70 \\\\ 7x+6y & =-40\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c257a091-5280-5ce1-8eae-4e520fcad5fc" :answer/type {:db/ident :answer.type/math} :answer/value "x-3y" :db/id #edb/ref 17592186293690}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-3y" :db/id #edb/ref 17592186293690} :answer-field/id #uuid "d99291da-aefb-5cba-b683-9de75e9117bf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294694}] :question/id #uuid "c3354465-52d7-54d8-a72d-f1b909cf8091" :question/math-academy-id "q-281113" :question/problem "Consider the line $y=x+1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 2 \\\\ -2 & 3\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-7.$" :question/worked-solution "First, notice that the line $y=x+1$ passes through the points $A(0,1)$ and $B(1,2)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & 2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 5 \\\\ 3 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(2,3)$ and ${B}^{′}(5,4).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-3 & =\\frac{4-3}{5-2}(x-2) \\\\ y-3 & =\\frac{1}{3}(x-2)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{3}(x-2) \\\\ 3y-9 & =x-2 \\\\ x-3y & =-7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38064337-f5b9-597d-b7cc-1f4d072b93ce" :answer/type {:db/ident :answer.type/math} :answer/value "x+5y" :db/id #edb/ref 17592186293166}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+5y" :db/id #edb/ref 17592186293166} :answer-field/id #uuid "8d657f89-ca30-56d0-92b5-967682b9e391" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294438}] :question/id #uuid "f4f36a8b-b618-5a3e-9b6e-89535fcd8027" :question/math-academy-id "q-281121" :question/problem "Consider the line $y=2x+1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-3.$" :question/worked-solution "First, notice that the line $y=2x+1$ passes through the points $A(0,1)$ and $B(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & 2 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 7 \\\\ -1 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(2,-1)$ and ${B}^{′}(7,-2).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y+1 & =\\frac{-2+1}{7-2}(x-2) \\\\ y+1 & =-\\frac{1}{5}(x-2)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+1 & =-\\frac{1}{5}(x-2) \\\\ 5y+5 & =-x+2 \\\\ x+5y & =-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3016e2ce-7638-5701-96c6-a3d2f7ae2c6f" :answer/type {:db/ident :answer.type/math} :answer/value "7x+10y" :db/id #edb/ref 17592186293133}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7x+10y" :db/id #edb/ref 17592186293133} :answer-field/id #uuid "8b94af73-90fe-5f5e-9c20-b8ae3fccb57b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294429}] :question/id #uuid "35e1a6de-f59e-590b-982f-e929e143b020" :question/math-academy-id "q-281130" :question/problem "Consider the line $y=-\\frac{2}{3}x-3$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-81.$" :question/worked-solution "First, notice that the line $y=-\\frac{2}{3}x-3$ passes through the points $A(0,-3)$ and $B(3,-5)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 3 \\\\ -3 & -5\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}0 & 3 \\\\ -3 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 7 \\\\ -6 & -13\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(-3,-6)$ and ${B}^{′}(7,-13).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y+6 & =\\frac{-13+6}{7-(-3)}(x+3) \\\\ y+6 & =-\\frac{7}{10}(x+3)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}10y+60 & =-7x-21 \\\\ 7x+10y & =-81\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb8ff04d-cbe1-5d86-a375-5435d4a47715" :answer/type {:db/ident :answer.type/math} :answer/value "5x-2y" :db/id #edb/ref 17592186293851}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5x-2y" :db/id #edb/ref 17592186293851} :answer-field/id #uuid "70a5902b-0646-5dca-98e8-453d7270e1a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294328}] :question/id #uuid "b0a3617f-2016-58e8-8cbb-ffcc1ac3b148" :question/math-academy-id "q-281140" :question/problem "Consider the line $y=2x-3$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=12.$" :question/worked-solution "First, notice that the line $y=2x-3$ passes through the points $A(0,-3)$ and $B(1,-1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -3 & -1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -6 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(0,-6)$ and ${B}^{′}(2,-1).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y+6 & =\\frac{-1+6}{2-0}(x-0) \\\\ y+6 & =\\frac{5}{2}x\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+6 & =\\frac{5}{2}x \\\\ 2y+12 & =5x \\\\ 5x-2y & =12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54a1f2dc-ab9d-5d07-ab5a-b4d9cbac7389" :answer/type {:db/ident :answer.type/math} :answer/value "4x-7y" :db/id #edb/ref 17592186293278}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x-7y" :db/id #edb/ref 17592186293278} :answer-field/id #uuid "dba100df-16f1-5896-85c8-f2c27bb93717" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294702}] :question/id #uuid "a1100a3d-fd94-5a66-954c-254516d90d05" :question/math-academy-id "q-281236" :question/problem "Consider the line $y=\\frac{1}{3}x+1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & 2 \\\\ 3 & -1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=15.$" :question/worked-solution "First, notice that the line $y=\\frac{1}{3}x+1$ passes through the points $A(0,1)$ and $B(3,2)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 3 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}4 & 2 \\\\ 3 & -1\\end{bmatrix}\\begin{bmatrix}0 & 3 \\\\ 1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 16 \\\\ -1 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(2,-1)$ and ${B}^{′}(16,7).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y+1 & =\\frac{7-(-1)}{16-2}(x-2) \\\\ y+1 & =\\frac{8}{14}(x-2)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y+1 & =\\frac{4}{7}(x-2) \\\\ 7y+7 & =4x-8 \\\\ 4x-7y & =15\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4778bcc5-5b88-58f2-b085-38005ea7200d" :answer/type {:db/ident :answer.type/math} :answer/value "4x-y" :db/id #edb/ref 17592186293226}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x-y" :db/id #edb/ref 17592186293226} :answer-field/id #uuid "4e6f9cda-6582-51a2-9441-31af2f432045" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294205}] :question/id #uuid "9dd45d0e-8e41-509d-8f54-e8b83cfbdfbd" :question/math-academy-id "q-281241" :question/problem "Consider the line $y=2x+1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nIn **standard form**, the equation of the image of the line under the action of $T$ is\n\n{{field-1}}$=-5.$" :question/worked-solution "First, notice that the line $y=2x+1$ passes through the points $A(0,1)$ and $B(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 1 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(-1,1)$ and ${B}^{′}(0,5).$\n\nNow, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}$ in point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-1 & =\\frac{5-1}{0+1}(x+1) \\\\ y-1 & =4(x+1)\\end{aligned}\n$$\n\nFinally, we transform the equation of the line to standard form:\n\n$$\n\\begin{aligned}y-1 & =4x+4 \\\\ 4x-y & =-5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29391770-0702-5a1d-8fe2-5650ed41436a" :answer/type {:db/ident :answer.type/math} :answer/value "12x+y+5=0" :db/id #edb/ref 17592186342585} {:answer/id #uuid "91dd3cad-c4e6-570b-92c7-8aa8196ddc24" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+y-15=0" :db/id #edb/ref 17592186343515} {:answer/id #uuid "94668d56-ed4e-5a53-9a3c-9ce0b4f02036" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y+5=0" :db/id #edb/ref 17592186343534} {:answer/id #uuid "d5ad800b-e987-5854-8203-31879b8e1f2d" :answer/type {:db/ident :answer.type/math} :answer/value "13x+2y+30=0" :db/id #edb/ref 17592186344109} {:answer/id #uuid "f0baaadf-b29e-5ea2-800a-2a7ae6515e6c" :answer/type {:db/ident :answer.type/math} :answer/value "4x-y-5=0" :db/id #edb/ref 17592186344352}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13x+2y+30=0" :db/id #edb/ref 17592186344109} :answer-field/id #uuid "02b72e69-323d-5616-8ed6-1ec52f7f4aa3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344499}] :question/id #uuid "73ad6a2e-aaec-5622-8188-773351aa5d67" :question/math-academy-id "q-77770" :question/problem "Consider the line $y=4x+5$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 0 \\\\ -1 & -3\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=4x+5$ passes through the points $G(0,5)$ and $H(1,9)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $G$ and $H$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 5 & 9\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 0 \\\\ -1 & -3\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 5 & 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -15 & -28\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${G}^{′}(0,-15)$ and ${H}^{′}(2,-28).$\n\nFinally, we write the equation of the line that passes through ${G}^{′}$ and ${H}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-15) & =\\frac{-28-(-15)}{2-0}(x-0) \\\\ y+15 & =-\\frac{13}{2}x \\\\ 2y+30 & =-13x \\\\ 13x+2y+30 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52333589-da55-5061-bfd7-a97bd200c823" :answer/type {:db/ident :answer.type/math} :answer/value "5x+2y+18=0" :db/id #edb/ref 17592186342921} {:answer/id #uuid "6e90b6d9-69e5-5554-aeb7-b52bbf4d765f" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4y+18=0" :db/id #edb/ref 17592186343190} {:answer/id #uuid "97e72a8b-daa6-5c81-9066-28943ac00dd5" :answer/type {:db/ident :answer.type/math} :answer/value "4x-5y+18=0" :db/id #edb/ref 17592186343569} {:answer/id #uuid "a6136234-b906-538b-8baf-1b2b925a6a81" :answer/type {:db/ident :answer.type/math} :answer/value "5x-2y+8=0" :db/id #edb/ref 17592186343700} {:answer/id #uuid "a78b7371-2f14-587c-af8e-36feb275b661" :answer/type {:db/ident :answer.type/math} :answer/value "4x+5y+18=0" :db/id #edb/ref 17592186343713}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5x-4y+18=0" :db/id #edb/ref 17592186343190} :answer-field/id #uuid "a0a0684c-de5f-5e82-bf0f-d5c228e166ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344777}] :question/id #uuid "7302730e-18e0-54c5-b5ff-a5b195f1951e" :question/math-academy-id "q-77771" :question/problem "Consider the line $y=-2x+3$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}0 & -2 \\\\ 3 & -1\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=-2x+3$ passes through the points $U(0,3)$ and $V(1,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $U$ and $V$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 3 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}0 & -2 \\\\ 3 & -1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & -2 \\\\ -3 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${U}^{′}(-6,-3)$ and ${V}^{′}(-2,2).$\n\nFinally, we write the equation of the line that passes through ${U}^{′}$ and ${V}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-3) & =\\frac{2-(-3)}{-2-(-6)}(x-(-6)) \\\\ y+3 & =\\frac{5}{4}(x+6) \\\\ 4y+12 & =5x+30 \\\\ 5x-4y+18 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af632d27-f2d3-532e-a873-66985645a1eb" :answer/type {:db/ident :answer.type/math} :answer/value "8x+3y+12=0" :db/id #edb/ref 17592186343781} {:answer/id #uuid "b8549f29-509c-538c-8acc-449dbc0a19e0" :answer/type {:db/ident :answer.type/math} :answer/value "13x+3y+2=0" :db/id #edb/ref 17592186343856} {:answer/id #uuid "e48522f6-da24-5952-be08-7fd1179d3a97" :answer/type {:db/ident :answer.type/math} :answer/value "13x+8y+2=0" :db/id #edb/ref 17592186344245} {:answer/id #uuid "fc0557df-24ba-5c5e-b907-1fafd9ea7198" :answer/type {:db/ident :answer.type/math} :answer/value "8x+13y+2=0" :db/id #edb/ref 17592186344457} {:answer/id #uuid "fed020c8-90e3-5171-b449-52ac9638b5c1" :answer/type {:db/ident :answer.type/math} :answer/value "8x+3y+2=0" :db/id #edb/ref 17592186344481}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8x+13y+2=0" :db/id #edb/ref 17592186344457} :answer-field/id #uuid "5e5b38d1-e0a4-5e2b-a973-6fb0ffdf034d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344650}] :question/id #uuid "76af15ad-b34c-5918-8e8b-d1a1c3add31c" :question/math-academy-id "q-77776" :question/problem "Consider the line $y=4x-1$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & -3 \\\\ 0 & 2\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=4x-1$ passes through the points $Q(0,-1)$ and $R(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $Q$ and $R$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -1 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & -3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -10 \\\\ -2 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${Q}^{′}(3,-2)$ and ${R}^{′}(-10,6).$\n\nFinally, we write the equation of the line that passes through ${Q}^{′}$ and ${R}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-2) & =\\frac{6-(-2)}{-10-3}(x-3) \\\\ y+2 & =-\\frac{8}{13}(x-3) \\\\ 13y+26 & =-8x+24 \\\\ 8x+13y+2 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28c6dfab-b1b2-5ed5-9b80-898c4f103fb0" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y+24=0" :db/id #edb/ref 17592186342580} {:answer/id #uuid "63e5c5b3-21e9-5b57-a1e8-84db3479e3c7" :answer/type {:db/ident :answer.type/math} :answer/value "3x-y+8=0" :db/id #edb/ref 17592186343087} {:answer/id #uuid "8c0e2cf3-ed8d-5750-a63c-e98866ae984a" :answer/type {:db/ident :answer.type/math} :answer/value "3x-y+24=0" :db/id #edb/ref 17592186343462} {:answer/id #uuid "993a939d-61d2-5d28-a6bd-82befc6824dd" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-8=0" :db/id #edb/ref 17592186343587} {:answer/id #uuid "ba142e96-d1b7-5fa1-9148-7e7581869cfc" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-24=0" :db/id #edb/ref 17592186343872}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x+y-24=0" :db/id #edb/ref 17592186343872} :answer-field/id #uuid "b119e286-714e-528a-ad48-f79addef0069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344802}] :question/id #uuid "a8f23ba3-4993-5f57-bbdc-60d39e520b2a" :question/math-academy-id "q-77779" :question/problem "Consider the line $y=-x-4$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}-1 & -2 \\\\ -3 & 0\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=-x-4$ passes through the points $W(0,-4)$ and $Z(1,-5)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $W$ and $Z$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -4 & -5\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}-1 & -2 \\\\ -3 & 0\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -4 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 9 \\\\ 0 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${W}^{′}(8,0)$ and ${Z}^{′}(9,-3).$\n\nFinally, we write the equation of the line that passes through ${W}^{′}$ and ${Z}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-0 & =\\frac{-3-0}{9-8}(x-8) \\\\ y & =-3(x-8) \\\\ y & =-3x+24 \\\\ 3x+y-24 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b47c28-4298-5607-bd16-beeb88421ceb" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-15=0" :db/id #edb/ref 17592186342525} {:answer/id #uuid "2af84491-e5bf-58a3-b009-b302f9a178ea" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-5=0" :db/id #edb/ref 17592186342596} {:answer/id #uuid "423144e5-5faf-5c52-a4b4-089df55cd17b" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2y+15=0" :db/id #edb/ref 17592186342786} {:answer/id #uuid "9562f273-44bd-551d-a458-dfc700da48f6" :answer/type {:db/ident :answer.type/math} :answer/value "2x-3y+5=0" :db/id #edb/ref 17592186343544} {:answer/id #uuid "b3c54330-308e-5d33-8878-8993a2769160" :answer/type {:db/ident :answer.type/math} :answer/value "2x-3y+15=0" :db/id #edb/ref 17592186343814}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x-3y+15=0" :db/id #edb/ref 17592186343814} :answer-field/id #uuid "efd735e5-d6b9-56bf-b0c1-f4c41c0e63c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344910}] :question/id #uuid "75659c8e-5082-5451-8461-e6ece527f457" :question/math-academy-id "q-77781" :question/problem "Consider the line $y=x+3$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}4 & -1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=x+3$ passes through the points $C(0,3)$ and $L(1,4)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $C$ and $L$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ 3 & 4\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}4 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ 3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 0 \\\\ 3 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${C}^{′}(-3,3)$ and ${L}^{′}(0,5).$\n\nFinally, we write the equation of the line that passes through ${C}^{′}$ and ${L}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-3 & =\\frac{5-3}{0-(-3)}(x-(-3)) \\\\ y-3 & =\\frac{2}{3}(x+3) \\\\ 3y-9 & =2x+6 \\\\ 2x-3y+15 & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c55cb21-a9a5-5e0b-9b02-88bd46dc1cbe" :answer/type {:db/ident :answer.type/math} :answer/value "12x+y-15=0" :db/id #edb/ref 17592186342348} {:answer/id #uuid "1d386345-bfbe-5abf-9137-6fd92599ec6c" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y-8=0" :db/id #edb/ref 17592186342483} {:answer/id #uuid "8de5b232-6b26-574d-829a-8dd03e49c9ff" :answer/type {:db/ident :answer.type/math} :answer/value "23x+y-8=0" :db/id #edb/ref 17592186343480} {:answer/id #uuid "caecf6a5-11db-51cc-99c2-023081ad2c99" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-8=0" :db/id #edb/ref 17592186344023} {:answer/id #uuid "fe1cfc1f-992d-5d39-a046-76c55c07b85a" :answer/type {:db/ident :answer.type/math} :answer/value "13x+y-15=0" :db/id #edb/ref 17592186344473}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "23x+y-8=0" :db/id #edb/ref 17592186343480} :answer-field/id #uuid "19413730-e262-5f29-9410-03ab73c9c5c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344534}] :question/id #uuid "fd367730-b3f2-5bd3-a9d9-eab23544ce5f" :question/math-academy-id "q-77782" :question/problem "Consider the line $y=5x-2$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}1 & 0 \\\\ -3 & -4\\end{bmatrix}.\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=5x-2$ passes through the points $A(0,-2)$ and $B(1,3)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=\\begin{bmatrix}0 & 1 \\\\ -2 & 3\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}1 & 0 \\\\ -3 & -4\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 8 & -15\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(0,8)$ and ${B}^{′}(1,-15).$\n\nFinally, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-8 & =\\frac{-15-8}{1-0}(x-0) \\\\ y-8 & =-23x \\\\ 23x+y-8 & =0\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Image of a Line Given by an Equation in Slope-Intercept Form"}] :topic/math-academy-id 2706 :topic/title "Linear Transformations of Points and Lines in the Plane"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186120663} :activity/id #uuid "f2dd4c26-139a-5928-934f-ad8833466f2b" :activity/steps [{:db/id #edb/ref 17592186120663 :step/content {:db/id #edb/ref 17592186121031 :tutorial/content "There is an algorithm that uses $LU$ factorization to solve systems of equations of the form \n\n$$\nA\\mathbf{x}=\\mathbf{b} .\n$$\n\nFor example, let's solve the following equation:\n\n![](images/77/77bbf7683a8ecfbd6864ce82eede96dcab60480e9f5395ac38eae88218af8fde.svg)\n\nSince the LU factorization of $A$ is\n\n![](images/d7/d704b00f3e25fdd85fcf123baf0340f87b82125ae2ce0718891102c9da9968f2.svg)\nour equation $A\\mathbf{x}=\\mathbf{b}$ can be written as\n\n![](images/14/1481be73064ba910f27931cba3f6a252123090c055ed3d4eb3657fd9b9084c58.svg)\n\ni.e., \n\n$$\nLU\\mathbf{x}= \\mathbf{b}.\n$$\n\nNow, suppose we set $U\\mathbf{x}=\\mathbf{y}.$ Substituting this into the above, we have\n\n$$\nL\\mathbf{y}= \\mathbf{b}.\n$$\n\nIn other words, we can reduce the problem to the following system of matrix equations:\n\n$$\n\\{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nSince $L$ and $U$ are both triangular, each of these equations is easily solvable using back and forward substitution.\n\n- First, we solve $L\\mathbf{y} = \\mathbf{b}.$ Let's assume that ![](images/46/46e89549c82a3571050bf103d9f539cfd82c197c6c0ffef9161ed3c67cdbb4c0.svg) Then, we have\n![](images/af/af1f7463d07d4ddf3f25b8ae1cff3d658f8c0d2a9ab8295c5ea1e0e9c69d2fe6.svg)\nwhich gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=-1 \\\\ -{y}_{1}+{y}_{2}=0.\\end{aligned}\n$$\n\nSolving this equation using *forward* substitution, we get the solution\n![](images/5b/5bb589d79fbb718f91b5df14ae4c7ac0a3767cb625c2079c0b16562b74484491.svg)\n\n- Finally, we solve $U\\mathbf{x}=\\mathbf{y}.$ We have\n![](images/4a/4a54f9bbd8830b3be687a168c8d9548466124669f8e7309ee18e1f05904fd084.svg)\nwhich gives the system of equations\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{x}_{1}-3{x}_{2}=-1 \\\\ -{x}_{2}=-1.\\end{aligned}\\end{aligned}\n$$\n\nSolving this equation using *back* substitution, we get the solution\n![](images/ba/baf88432261a561613c0241b2d768e9cedf4f4eddaecaaf761b774c36c1ed541.svg)" :tutorial/id #uuid "2a20df11-b376-5315-8a2a-b65f70b54723" :tutorial/math-academy-id 3181 :tutorial/title "Introduction"} :step/id #uuid "d790cb21-6bf5-548a-9699-06a28ab34cad" :step/next {:db/id #edb/ref 17592186120800}} {:db/id #edb/ref 17592186120664 :step/content {:db/id #edb/ref 17592186119799 :knowledge-point/id #uuid "7634b3ac-f9e6-514e-87ba-e78590c9fa53"} :step/id #uuid "03156e06-274b-5254-b220-6c7dbdbfbea4"} {:db/id #edb/ref 17592186120665 :step/content {:db/id #edb/ref 17592186119800 :knowledge-point/id #uuid "9fa9fbb8-b2bc-5c93-bb07-bc8c7ef7c115"} :step/id #uuid "c679b1a9-e5cc-58a1-9ab4-6f72bbf434b0" :step/next {:db/id #edb/ref 17592186120664}} {:db/id #edb/ref 17592186120800 :step/content {:db/id #edb/ref 17592186119886 :knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a"} :step/id #uuid "d6f2ea6a-3521-5f86-a8b0-266d2d0bf9ab" :step/next {:db/id #edb/ref 17592186120665}}] :activity/title "Solving Systems of Equations Using LU Factorization" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186120004}] :db/id #edb/ref 17592186049088 :topic/knowledge-points [{:db/id #edb/ref 17592186119799 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119610 :question/id #uuid "9552ad30-9d46-5884-9877-18ca8842c252" :question/math-academy-id "e-4775" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $\\mathbf{b},$ given by\n![](images/f1/f1124e83e3b7614557a1a6de54523cc99f62ba2a52af1da8e4d22e14466ce020.svg)\nIf $\\langle x_1,x_2 \\rangle$ and $\\langle y_1,y_2 \\rangle$ are the solutions to the systems $A\\mathbf{x}=\\mathbf{b}$ and $L\\mathbf{y}=\\mathbf{b}$ respectively, what is the value of $x_1 \\cdot y_2?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](images/a1/a185a6fd91c78ed3e291b3ac8b99f9430290e5d8c1060a7d97317efc230aeb40.svg)\n\nNow, we solve the two systems in turn.\n\n- First, we solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n![](images/1e/1e780d384ca1fd957d742bbd047399c558ab016d187ce4cf71682546673aba35.svg)\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=6 \\\\ -2{y}_{1}+{y}_{2} &=-8.\\end{aligned}\\right.\n$$\n\nThe solution to this system is $y_1=6$ and $y_2=4.$ Therefore, \n![](images/58/58da62903247cf6dfdf33be86293c181ef5184048ca7cd6c921360e5d202f353.svg)\n\n- Next, we solve $U\\mathbf{x}=\\mathbf{y}.$ Writing this equation in matrix form, we get\n![](images/e0/e0563dde4944ecbe2ccb98bc91246fa18c7a808df96ab77f9f8efb5510084677.svg)\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}7{x}_{1}+4{x}_{2} &=6 \\\\ -2{x}_{2} &=4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is $x_2=-2$ and $x_1=2.$ Therefore, \n![](images/a8/a84088cff2a3589652ef7cabf09e3d8429fad7797ea20d44a416f85dcc7f9b65.svg)\n\nFinally, $x_1 \\cdot y_2 = 2 \\cdot 4 = 8.$"} :knowledge-point/id #uuid "7634b3ac-f9e6-514e-87ba-e78590c9fa53" :knowledge-point/questions [{:db/id #edb/ref 17592186120080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b502cec-1775-59f9-809f-3acfaa819cb3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186238705} {:answer/id #uuid "56dfee9c-b30c-5648-9828-3201f728cb12" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238805} {:answer/id #uuid "8a110af8-df14-5052-b118-eca598e4d15c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239259} {:answer/id #uuid "b9d9476f-d8c5-5847-bd4a-30cf5e082d35" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186239672} {:answer/id #uuid "d9c5a8f7-548e-56d7-a1c2-fc6e1e17cc92" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239955}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239259} :answer-field/id #uuid "c4fe466f-bde9-5495-bd5f-97f097a5d1a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240675}] :question/id #uuid "cc6bf17a-cfc4-5f52-984e-78af80897af9" :question/math-academy-id "q-105949" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-3 & -2 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-1 \\\\ -{y}_{1}+{y}_{2} &=3.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=-1$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}-3 & -2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}-2{x}_{2} &=-1 \\\\ {x}_{2} &=2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=2$ and ${x}_{1}=-1.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=(-1)\\cdot (-1)=1.$"} {:db/id #edb/ref 17592186120185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3f3ee05-d3f7-5c86-895e-6f43ced8c9d8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186117272} {:answer/id #uuid "b32f2009-5fa9-5efd-9c02-27b51fa7765a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186117273} {:answer/id #uuid "c641eaab-1e9f-5ea3-933f-f0970ed92011" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186117274} {:answer/id #uuid "1282336c-8913-516e-b8c3-a132999d26d8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186117275} {:answer/id #uuid "468dbb5e-cf6f-5fae-aa9b-73400b3e744e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186117276}] :answer-field/id #uuid "c62ec7bf-e536-5712-8283-9c22b82722f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117271}] :question/id #uuid "e082accc-db4a-55f2-8216-cfc2ab70d8f6" :question/math-academy-id "q-32539" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b$, given by\n$A = \\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}_(⏟)_(L)\\begin{bmatrix}2 & -1 \\\\ 0 & 4\\end{bmatrix}_(⏟)_(U), b = \\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$.\nIf $⟨x_{1}, x_{2}⟩$ and $⟨y_{1}, y_{2}⟩$ are the solutions to the systems $Ax = b$ and $Ly = b$ respectively, what is the value of $x_{1} \\cdot y_{2}$?"} {:db/id #edb/ref 17592186240947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58084007-9e99-53e0-8374-6cda77525c60" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186238813} {:answer/id #uuid "5c5d0f92-a6de-50fe-bce4-d1b418e41055" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186238862} {:answer/id #uuid "9d7e78ff-9545-5e8c-b018-eac85799dfd3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239430} {:answer/id #uuid "c2d60dac-b63a-5acf-80a6-3c96ba1c9f9d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186239768} {:answer/id #uuid "e076131b-4afd-560c-b022-eb4bbc475ed3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186240021}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186240021} :answer-field/id #uuid "3597c1a2-acbd-5c5c-b379-87acd61da771" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240428}] :question/id #uuid "90798e55-963c-5ed8-a201-d8aa9b66ebff" :question/math-academy-id "q-104861" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot {{\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions of the systems $Ax=b$ and $Ly=b$ respectively, what is the value of the product ${x}_{1}\\cdot {y}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=1 \\\\ -2{y}_{1}+{y}_{2} &=2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=1$ and ${y}_{2}=4.$ Therefore, \n\n$$\ny=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}2 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2} &=1 \\\\ {x}_{2} &=4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=4$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-\\frac{3}{2} \\\\ 4\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=-\\frac{3}{2}\\cdot 4=-6.$"} {:db/id #edb/ref 17592186241146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16cfc4d9-e678-5d11-a711-f03b27d03ba7" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186238251} {:answer/id #uuid "48196e4d-5923-5fc3-ba09-551bba37a5f7" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186238683} {:answer/id #uuid "764a88ed-d42b-5e8e-b7e6-0154d79ebcb8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186239076} {:answer/id #uuid "9c69f59a-92c5-5712-8d12-87a782265e35" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186239415} {:answer/id #uuid "a7a8dd22-491e-5bf2-8293-73bb146e224b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239509}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239509} :answer-field/id #uuid "a0090a32-0dee-5d9f-b495-d9dbbf4db605" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240613}] :question/id #uuid "b76bf109-a8c3-51c0-a007-3381911cc6e5" :question/math-academy-id "q-105951" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -1 \\\\ 0 & 4\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}6 \\\\ 20\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{2}\\cdot {y}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}6 \\\\ 20\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=6 \\\\ 4{y}_{1}+{y}_{2} &=20.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=6$ and ${y}_{2}=-4.$ Therefore, \n\n$$\ny=\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}2 & -1 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-{x}_{2} &=6 \\\\ 4{x}_{2} &=-4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-1$ and ${x}_{1}=\\frac{5}{2}.$ Therefore, \n\n$$\nx=\\begin{bmatrix}\\frac{5}{2} \\\\ -1\\end{bmatrix}.\n$$\n\nFinally, ${x}_{2}\\cdot {y}_{2}=(-1)\\cdot (-4)=4.$"} {:db/id #edb/ref 17592186241147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22f6367b-84f5-5b47-a09a-aa8de2644b8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{7}" :db/id #edb/ref 17592186238362} {:answer/id #uuid "813327d9-1832-51ef-84d1-00133e2f63a1" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186239176} {:answer/id #uuid "8e93b878-423d-5080-a191-f592c8e25cbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{130}{7}" :db/id #edb/ref 17592186239293} {:answer/id #uuid "b7069b81-e348-5968-b6ae-a411b5b35221" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186239649} {:answer/id #uuid "cdc34193-52f9-5bb0-a06a-5f9897960a24" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186239856}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186239649} :answer-field/id #uuid "54336a57-2806-5ed6-bb5d-a86bbfed1d7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240485}] :question/id #uuid "68b89d00-e814-5d60-8ff8-bbe1b29f01fc" :question/math-academy-id "q-105953" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}7 & 3 \\\\ 0 & -2\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=5 \\\\ -2{y}_{1}+{y}_{2} &=4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=5$ and ${y}_{2}=14.$ Therefore, \n\n$$\ny=\\begin{bmatrix}5 \\\\ 14\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}7 & 3 \\\\ 0 & -2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}5 \\\\ 14\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}7{x}_{1}+3{x}_{2} &=5 \\\\ -2{x}_{2} &=14.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-7$ and ${x}_{1}=\\frac{26}{7}.$ Therefore, \n\n$$\nx=\\begin{bmatrix}\\frac{26}{7} \\\\ -7\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=\\frac{26}{7}\\cdot 14=52.$"} {:db/id #edb/ref 17592186302218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be1af41-0c7e-535a-9a86-a5c82122dcdb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300250} {:answer/id #uuid "89b9efd6-ce79-56d0-af07-0e42c41ffec0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300659} {:answer/id #uuid "98709d57-b5d1-505c-a13b-2435f487b4d9" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186300728} {:answer/id #uuid "b5fc1198-c5b8-53d4-8b4a-c8b8adf38ad5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300866} {:answer/id #uuid "b65d5146-dbe1-5221-b3af-8171d063039f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300871}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186300728} :answer-field/id #uuid "3ff87f9e-a211-5118-b7af-25e270840e47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301437}] :question/id #uuid "74c73bef-8f9e-5d05-b33f-448bad8fb053" :question/math-academy-id "q-32570" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-4 & -6 \\\\ 0 & -3\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}-4 \\\\ -6\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${y}_{1}+3{x}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}-4 \\\\ -6\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-4 \\\\ 2{y}_{1}+{y}_{2} &=-6.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=-4$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=\\begin{bmatrix}-4 \\\\ 2\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}-4 & -6 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}-4 \\\\ 2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}-4{x}_{1}-6{x}_{2} &=-4 \\\\ -3{x}_{2} &=2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-\\frac{2}{3}$ and ${x}_{1}=2.$ Therefore, \n\n$$\nx=\\begin{bmatrix}2 \\\\ -\\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, ${y}_{1}+3{x}_{2}=-4+3(-\\frac{2}{3})=-6.$"} {:db/id #edb/ref 17592186377114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88563f9a-fe2f-527f-9088-6f315b568cea" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186377116} {:answer/id #uuid "48576f2d-a6b9-5774-9e9a-19ba1f4e38ea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377117} {:answer/id #uuid "e76c0e34-36b8-5764-840d-f88b895244a6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186377118} {:answer/id #uuid "814a9d97-25f8-5a25-a383-4648eb1c6e2c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377119} {:answer/id #uuid "86bb289e-e808-5d04-8cac-8b8aa24b0c86" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186377120}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186377120} :answer-field/id #uuid "ca31d1d6-e79f-5fc7-a4c9-90dff16bd516" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377115}] :question/id #uuid "0f5e9b29-3dd0-5241-83b5-c648ade5707e" :question/math-academy-id "q-32572" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -5 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}^{2}+{y}_{2}^{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ 2{y}_{1}+{y}_{2} &=4.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=3$ and ${y}_{2}=-2.$ Therefore, \n\n$$\ny=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}2 & -5 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-5{x}_{2} &=3 \\\\ 2{x}_{2} &=-2,\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-1$ and ${x}_{1}=-1.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}^{2}+{y}_{2}^{2}=(-1)^{2}+(-2)^{2}=5.$"} {:db/id #edb/ref 17592186390757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032457e9-02bf-5ad6-9987-99a0689c6243" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186390759} {:answer/id #uuid "ad2b9196-139c-5abe-8bf3-f21b13bb615e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186390760} {:answer/id #uuid "d6722917-7648-59db-8da1-966d52f9d9ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186390761} {:answer/id #uuid "9541c84f-6c02-5508-afe7-624da511dbdc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186390762} {:answer/id #uuid "749e40df-d35d-5ad6-9d4a-9737f8552554" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186390763}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186390760} :answer-field/id #uuid "5e79de7e-b384-5ea6-bb81-dfd5832cccb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390758}] :question/id #uuid "b44ae0d1-f2bc-52f5-a02c-1e4fb0c1d4e5" :question/math-academy-id "q-32561" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ -2{y}_{1}+{y}_{2} &=-3.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=3$ and ${y}_{2}=3.$ Therefore, \n\n$$\ny=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=3 \\\\ 2{x}_{2} &=3.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=\\frac{3}{2}$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-\\frac{3}{2} \\\\ \\frac{3}{2}\\end{bmatrix}.\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=-\\frac{3}{2}\\cdot 3=-\\frac{9}{2}.$"} {:db/id #edb/ref 17592186479110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc9a6bd-a591-5999-b245-91b38db136b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186478577} {:answer/id #uuid "6ed5ec33-0fac-5b1f-8846-71b9668a161a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186478724} {:answer/id #uuid "a0981e4f-9bc7-5c90-b871-88aafbf5dc4b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186478820} {:answer/id #uuid "d358ce26-83c5-527a-b35c-94335a5980f8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186478894} {:answer/id #uuid "fcc58994-bee3-54d3-8345-6cff06c3be4f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186478954}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186478954} :answer-field/id #uuid "5d527114-1572-54ac-b766-1707893768e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478995}] :question/id #uuid "9ad4c6c3-50cf-5ba9-ae9f-35f5ce660c90" :question/math-academy-id "q-107497" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 9 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 2 \\\\ 0 & 6\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}1 \\\\ 6\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{2}\\cdot {y}_{1}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 9 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}1 \\\\ 6\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=1 \\\\ 9{y}_{1}+{y}_{2} &=6.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=1$ and ${y}_{2}=-3.$ Therefore, \n\n$$\ny=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}-1 & 2 \\\\ 0 & 6\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+2{x}_{2} &=1 \\\\ 6{x}_{2} &=-3.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-\\frac{1}{2}$ and ${x}_{1}=-2.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-2 \\\\ -\\frac{1}{2}\\end{bmatrix}.\n$$\n\nFinally, ${x}_{2}\\cdot {y}_{1}=(-\\frac{1}{2})\\cdot 1=-\\frac{1}{2}.$"} {:db/id #edb/ref 17592186479113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0224fe-d8c2-5cc1-8f3c-e522430032e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{134}" :db/id #edb/ref 17592186478607} {:answer/id #uuid "49b907b6-2183-5755-bb06-f22146e37570" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{188}" :db/id #edb/ref 17592186478664} {:answer/id #uuid "521a4a18-d5e1-5275-86bd-fd4d0bbb7613" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478676} {:answer/id #uuid "9126f568-e746-57ed-bb73-ef7602c0d19e" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186478792} {:answer/id #uuid "c4a94ece-2daa-5c37-8ecc-a6ffaebd161a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186478875}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478676} :answer-field/id #uuid "d05942a2-78c5-5b8e-b7fc-65092edacbc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479040}] :question/id #uuid "ab64b08c-fec6-5dff-b1cc-ff3d1f5e73c7" :question/math-academy-id "q-32566" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-3 & 1 \\\\ 0 & 1\\end{bmatrix}}_{⏟}}_{U},\\,b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of $\\sqrt{{x}_{1}^{2}+{y}_{2}^{2}}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=b=\\begin{bmatrix}3 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ 3{y}_{1}+{y}_{2} &=-3.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=3$ and ${y}_{2}=-12.$ Therefore, \n\n$$\ny=\\begin{bmatrix}3 \\\\ -12\\end{bmatrix}.\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}-3 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=y=\\begin{bmatrix}3 \\\\ -12\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}+{x}_{2} &=3 \\\\ {x}_{2} &=-12.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${x}_{2}=-12$ and ${x}_{1}=-5.$ Therefore, \n\n$$\nx=\\begin{bmatrix}-5 \\\\ -12\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\sqrt{{x}_{1}^{2}+{y}_{2}^{2}} & =\\sqrt{(-5)^{2}+(-12)^{2}} \\\\  & =\\sqrt{25+144} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186558501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53492803-619c-5738-8780-eb85ef78082a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186558022} {:answer/id #uuid "5b75e368-dcfe-5035-a89a-0de98b0c81f4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186558040} {:answer/id #uuid "641e7890-d858-55b5-b90c-31018a57894b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186558059} {:answer/id #uuid "9acf41c5-2aee-5e2e-9787-52e0c514e5e2" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186558168} {:answer/id #uuid "b4885fca-3afa-5082-a83c-7abaa4f102b9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186558224}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186558022} :answer-field/id #uuid "791205e6-0e35-509a-8763-c44c2a7914e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558418}] :question/id #uuid "2b4d31f2-6228-5e16-8ece-d3de14298eac" :question/math-academy-id "q-32563" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}-4 \\\\ -1\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}-4 \\\\ -1\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=-4 \\\\ -{y}_{1}+{y}_{2}=-1.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=-4$ and ${y}_{2}=-5.$ Therefore, \n\n$$\ny=[\\begin{aligned}-4 \\\\ -5\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}-4 \\\\ -5\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=-4 \\\\ 2{x}_{2}=-5.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=-\\frac{5}{2}$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=[\\begin{aligned}-\\frac{3}{2} \\\\ -\\frac{5}{2}\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=(-\\frac{3}{2})\\cdot (-4)=6.$"} {:db/id #edb/ref 17592186558528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c02160-8ba1-5939-bc73-8002657c6b03" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186557912} {:answer/id #uuid "23f077b2-98bc-5e17-b96a-87b4b7d0879e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186557942} {:answer/id #uuid "6de90c59-9c12-5214-92b7-f0abb8a7ca70" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186558082} {:answer/id #uuid "cadf1f12-7d08-5b35-add1-a8807ac05198" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186558272} {:answer/id #uuid "fade0afc-801b-5fae-b3a9-b016601c272f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186558358}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186558358} :answer-field/id #uuid "e4f155d4-3ea5-53d0-a6f6-8b69b1f92207" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558468}] :question/id #uuid "758b84b6-7328-584d-83ee-1df88702770d" :question/math-academy-id "q-107500" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}8 & -4 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}4 \\\\ 1\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}+{y}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}4 \\\\ 1\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=4 \\\\ -{y}_{1}+{y}_{2}=1.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=4$ and ${y}_{2}=5.$ Therefore, \n\n$$\ny=[\\begin{aligned}4 \\\\ 5\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}8 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}4 \\\\ 5\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}8{x}_{1}-4{x}_{2}=4 \\\\ {x}_{2}=5.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=5$ and ${x}_{1}=3.$ Therefore, \n\n$$\nx=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$\n\nFinally, ${x}_{1}+{y}_{2}=3+5=8.$"} {:db/id #edb/ref 17592186558571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea7e0be-9a1f-5523-b787-ed5f453051d8" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186557964} {:answer/id #uuid "30c57b85-780d-5e2f-88d6-2b0bf8507810" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186557967} {:answer/id #uuid "6b2c83f9-30fa-58a9-ab6d-b815a4faa3cc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186558075} {:answer/id #uuid "978ea838-5cf8-51dc-9cc3-827714cd57ca" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186558160} {:answer/id #uuid "fad0f84d-6ada-5fb9-b0e6-bd2a4abb6d9b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186558357}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186557964} :answer-field/id #uuid "97da889e-de7b-5fe7-9f12-0a62150c1338" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558433}] :question/id #uuid "e26325a0-a17c-5d3b-96e5-ffcb13cdecc2" :question/math-academy-id "q-107491" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 1 \\\\ 0 & 2\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}-3 \\\\ -7\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{2}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}-3 \\\\ -7\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=-3 \\\\ 3{y}_{1}+{y}_{2}=-7.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=-3$ and ${y}_{2}=2.$ Therefore, \n\n$$\ny=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}4 & 1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}4{x}_{1}+{x}_{2}=-3 \\\\ 2{x}_{2}=2.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=1$ and ${x}_{1}=-1.$ Therefore, \n\n$$\nx=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=(-1)\\cdot 2=-2.$"}] :knowledge-point/title "Solving a 2x2 Linear System Using LU Factorization"} {:db/id #edb/ref 17592186119800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119611 :question/id #uuid "24bc4954-462b-5066-83d4-8a4a87efc7b7" :question/math-academy-id "e-4777" :question/problem "Consider the matrix $L$ and the vector $\\mathbf b,$ given by \n![](images/a1/a13a7752a224bdabc27558a6a41e2b24d3c7918af1ca4d9cff802dcb54259238.svg)\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $\\mathbf{y}$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $A\\mathbf{x}=\\mathbf{b}.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](images/60/605f569e0b4a54d2ca68d7b3330a2a0ebb06dcaba2b7efa911f58dbffd796fb0.svg)\n\nWe now solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n\n![](images/d2/d259a6740aa32e0e577756375fd85589b815232314511c74dc434a88d0146a3b.svg)\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=2 \\\\ {y}_{1}+{y}_{2} &=4 \\\\ {y}_{1}-2{y}_{2}+{y}_{3} &=1.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =2, \\\\ {y}_{2} & =4-{y}_{1} \\\\  & =4-(2) \\\\  & =2, \\\\ {y}_{3} & =1-{y}_{1}+2{y}_{2} \\\\  & =1-(2)+2(2) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, \n![](images/c5/c5198aa83d3976d992b200f63941261f952282fedb241db780c20c12c97e3ba9.svg)"} :knowledge-point/id #uuid "9fa9fbb8-b2bc-5c93-bb07-bc8c7ef7c115" :knowledge-point/questions [{:db/id #edb/ref 17592186120075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c23a45b2-8a2a-5db8-9fcb-79fdc6bb7bdf" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}4 \\\\ 3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186116658} {:answer/id #uuid "f09f2d95-9f9d-5f79-b8f0-c22b46cbb5ac" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-4 \\\\ -3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186116659} {:answer/id #uuid "023717a5-4d31-56c1-af73-5b631357c336" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-4 \\\\ -3 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186116660} {:answer/id #uuid "31f23761-1a33-5ea8-9e91-4d86da65aeff" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-4 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186116661} {:answer/id #uuid "755ca120-4e46-5dde-bc9b-cf7e90eeca10" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-4 \\\\ -3 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186116662}] :answer-field/id #uuid "d3a9a1c4-68f7-536b-afef-78467683712e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116657}] :question/id #uuid "e1329ba7-2fc9-582c-9160-66b974cb703f" :question/math-academy-id "q-105804" :question/problem "Consider the matrix $L$ and the vector $b$, given by\n\n$L = \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 6 & -9 & 1\\end{bmatrix}, b = \\begin{bmatrix}-4 \\\\ -3 \\\\ 1\\end{bmatrix}$.\n\nIf $A = LU$ is the LU factorization of some $3 \\cdot 3$ matrix $A$, find the vector $y$ such that\n\n${Ly = b; Ux = y$\n\nis equivalent to $Ax = b$."} {:db/id #edb/ref 17592186120191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3f52413-e697-5b87-a6e8-f81564de2ced" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186117308} {:answer/id #uuid "a94c528b-4c78-5494-8a93-60f8205080f2" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186117309} {:answer/id #uuid "d58ac9cc-18ff-5995-8b5d-9979dda782c2" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ -5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186117310} {:answer/id #uuid "fa87234c-15b1-543f-917b-f4451eb8035d" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ -2 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186117311} {:answer/id #uuid "733f53ad-4ad5-5b46-a2db-149bb5994846" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-1 \\\\ 5 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186117312}] :answer-field/id #uuid "4f33af62-6b7c-5f6c-9970-f861af9e6a81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117307}] :question/id #uuid "97b3b05a-7dac-545a-938e-5619c760b401" :question/math-academy-id "q-32576" :question/problem "Consider the matrix $L$ and the vector $b$, given by\n\n$L = \\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & -1 & 1\\end{bmatrix}, b = \\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}$.\n\nIf $A = LU$ is the LU factorization of some $3 \\cdot 3$ matrix $A$, find the vector $y$ such that\n\n${Ly = b; Ux = y$\n\nis equivalent to $Ax = b$."} {:db/id #edb/ref 17592186241143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16476909-e6dc-5b18-955e-cfd718795ed4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-7 \\\\ -4 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186238244} {:answer/id #uuid "4583c04a-e2ab-52e7-81fb-8167f1190e1f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-7 \\\\ 4 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186238655} {:answer/id #uuid "6fc567a9-e712-50f6-afe2-c4eb98f78983" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-7 \\\\ -4 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186239020} {:answer/id #uuid "c2f9e2ec-06fa-5186-8c2c-78d345e623f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}7 \\\\ 10 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186239770} {:answer/id #uuid "f1587271-3166-56b5-ab38-216dbdf949f7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}7 \\\\ 10 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186240187}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-7 \\\\ -4 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186239020} :answer-field/id #uuid "9292d405-3038-578e-a25a-a947fe32a344" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240586}] :question/id #uuid "aaf9d0f9-4c8f-533a-91f4-6216848a3e03" :question/math-academy-id "q-105928" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-7 \\\\ 3 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}-7 \\\\ 3 \\\\ 3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-7 \\\\ -{y}_{1}+{y}_{2} &=3 \\\\ 3{y}_{2}+{y}_{3} &=3.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-7, \\\\ {y}_{2} & =3+{y}_{1} \\\\  & =3+(-7) \\\\  & =-4, \\\\ {y}_{3} & =3-3{y}_{2} \\\\  & =3-3(-4) \\\\  & =15.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}-7 \\\\ -4 \\\\ 15\\end{bmatrix}.$"} {:db/id #edb/ref 17592186241144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3721f084-e142-5f33-baa4-f1483ad8f031" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 16 \\\\ -23\\end{bmatrix}" :db/id #edb/ref 17592186238533} {:answer/id #uuid "7792733b-cca3-5632-a467-f04ba2ce6d0b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186239087} {:answer/id #uuid "7e797d6d-322e-55f6-9562-6057b788f863" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ -8 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186239155} {:answer/id #uuid "a4a111c4-fc76-59c9-ae42-fc127091245d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 4 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186239483} {:answer/id #uuid "e1791bdd-9f67-5cb2-8e6c-a0895f1b851c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ -8 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186240034}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 16 \\\\ -23\\end{bmatrix}" :db/id #edb/ref 17592186238533} :answer-field/id #uuid "1267ab7e-a947-5495-96a5-cfc2042f7e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240358}] :question/id #uuid "f817b0d9-deca-51e1-aedb-860b4e44d9bf" :question/math-academy-id "q-105930" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -4 & 1 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -4 & 1 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-2 \\\\ 9{y}_{1}+{y}_{2} &=-2 \\\\ -4{y}_{1}+{y}_{2}+{y}_{3} &=1.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-2, \\\\ {y}_{2} & =-2-9{y}_{1} \\\\  & =-2-9(-2) \\\\  & =16, \\\\ {y}_{3} & =1+4{y}_{1}-{y}_{2} \\\\  & =1+4(-2)-(16) \\\\  & =-23.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}-2 \\\\ 16 \\\\ -23\\end{bmatrix}.$"} {:db/id #edb/ref 17592186241145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "253c5bec-a5e7-5fe4-8936-ee84f06ad2cd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-9 \\\\ 70 \\\\ 80\\end{bmatrix}" :db/id #edb/ref 17592186238380} {:answer/id #uuid "3431ca67-1154-5315-a55d-30d8b6ec10fd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -63 \\\\ 81\\end{bmatrix}" :db/id #edb/ref 17592186238506} {:answer/id #uuid "5467b34d-2f1e-5c78-85dd-2b5382f7e7be" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -56 \\\\ 80\\end{bmatrix}" :db/id #edb/ref 17592186238782} {:answer/id #uuid "b152e191-5d18-598f-a23e-0286d0d7f786" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-9 \\\\ 56 \\\\ -80\\end{bmatrix}" :db/id #edb/ref 17592186239602} {:answer/id #uuid "c8674c02-d35b-548c-9f92-7fdac92d42e1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -70 \\\\ 80\\end{bmatrix}" :db/id #edb/ref 17592186239819}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -56 \\\\ 80\\end{bmatrix}" :db/id #edb/ref 17592186238782} :answer-field/id #uuid "697b8f6f-9b78-510a-bdce-c0f202963523" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240524}] :question/id #uuid "90586eea-75b4-50dc-8971-26e34a9a2816" :question/math-academy-id "q-105934" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ 7 \\\\ -1\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ -9 & 0 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}9 \\\\ 7 \\\\ -1\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=9 \\\\ 7{y}_{1}+{y}_{2} &=7 \\\\ -9{y}_{1}+{y}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =9, \\\\ {y}_{2} & =7-7{y}_{1} \\\\  & =7-7(9) \\\\  & =-56, \\\\ {y}_{3} & =-1+9{y}_{1} \\\\  & =-1+9(9) \\\\  & =80.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}9 \\\\ -56 \\\\ 80\\end{bmatrix}.$"} {:db/id #edb/ref 17592186244039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09248362-0210-5bd3-9cba-3c7c0ba0af77" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186241259} {:answer/id #uuid "36d321ce-53d8-56e9-9dbe-82fc9adca483" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186241662} {:answer/id #uuid "50683a47-c6a2-5f5a-bb9e-8475b2b4d6a6" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186241898} {:answer/id #uuid "62e293f9-4c73-554b-a3cb-8ff34f004cd4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186242067} {:answer/id #uuid "f215d89c-a23c-52b9-bf36-dbbb01a12a7b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186243328}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186242067} :answer-field/id #uuid "f398d1c3-32a7-528a-a4fa-123d34b4e86f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243860}] :question/id #uuid "60c2acb2-475e-5d8e-b68c-bf34a8ead470" :question/math-academy-id "q-107174" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -1 & -4 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -1 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -1 & -4 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ -1 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-2 \\\\ {y}_{1}+{y}_{2} &=-1 \\\\ -{y}_{1}-4{y}_{2}+{y}_{3} &=-3.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-2, \\\\ {y}_{2} & =-1-{y}_{1} \\\\  & =-1-(-2) \\\\  & =1, \\\\ {y}_{3} & =-3+4{y}_{2}+{y}_{1} \\\\  & =-3+4(1)+(-2) \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186302308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227f8924-c424-5ace-a60e-ec0f75170bac" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -11 \\\\ 27\\end{bmatrix}" :db/id #edb/ref 17592186300127} {:answer/id #uuid "92f848fa-5e70-5e9d-b0b2-39d1279bf9a6" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}" :db/id #edb/ref 17592186300699} {:answer/id #uuid "b6dd3cfd-0739-55c3-a7db-96724115278a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 1 \\\\ -27\\end{bmatrix}" :db/id #edb/ref 17592186300873} {:answer/id #uuid "c66ecfa0-d3ff-5035-878c-474ec658c5bf" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 0 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186300953} {:answer/id #uuid "ea19420c-93c3-5e7a-bd37-4cf627ed744e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186301121}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}" :db/id #edb/ref 17592186300699} :answer-field/id #uuid "9e3c053a-931d-5e1f-b30f-402efc4920cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301736}] :question/id #uuid "6904caba-1f35-5875-862d-7c3f71474ab1" :question/math-academy-id "q-32671" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 3 & 2 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -1 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 3 & 2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}3 \\\\ -1 \\\\ 4\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ -4{y}_{1}+{y}_{2} &=-1 \\\\ 3{y}_{1}+2{y}_{2}+{y}_{3} &=4.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =3, \\\\ {y}_{2} & =-1+4{y}_{1} \\\\  & =-1+4(3) \\\\  & =11, \\\\ {y}_{3} & =4-3{y}_{1}-2{y}_{2} \\\\  & =4-3(3)-2(11) \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}3 \\\\ 11 \\\\ -27\\end{bmatrix}.$"} {:db/id #edb/ref 17592186375659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f15ae35b-caa0-5046-aede-97653a8e60b2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-5 \\\\ 13 \\\\ -41\\end{bmatrix}" :db/id #edb/ref 17592186375661} {:answer/id #uuid "10c1ca60-0681-50e2-b5ae-c2e8ab738004" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 12 \\\\ -48\\end{bmatrix}" :db/id #edb/ref 17592186375662} {:answer/id #uuid "a42f494b-6dcc-50bf-9247-0e4973fed546" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 13 \\\\ -53\\end{bmatrix}" :db/id #edb/ref 17592186375663} {:answer/id #uuid "6ac99b1d-b6c1-53af-aff9-40ffda63e8fd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-5 \\\\ 17 \\\\ -41\\end{bmatrix}" :db/id #edb/ref 17592186375664} {:answer/id #uuid "e17aa4c8-d7ce-582c-8862-abcf25cd4ea8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 15 \\\\ -35\\end{bmatrix}" :db/id #edb/ref 17592186375665}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}5 \\\\ 12 \\\\ -48\\end{bmatrix}" :db/id #edb/ref 17592186375662} :answer-field/id #uuid "5ef7605f-f350-5544-965c-ff2ab358ba12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375660}] :question/id #uuid "f222a20b-2bd2-5f36-87f7-762e6e1190b5" :question/math-academy-id "q-105790" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 7 & 1 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ 2 \\\\ -1\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 7 & 1 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 2 \\\\ -1\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=5 \\\\ -2{y}_{1}+{y}_{2} &=2 \\\\ 7{y}_{1}+{y}_{2}+{y}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =5, \\\\ {y}_{2} & =2+2{y}_{1} \\\\  & =2+2(5) \\\\  & =12, \\\\ {y}_{3} & =-1-7{y}_{1}-{y}_{2} \\\\  & =-1-7(5)-(12) \\\\  & =-48.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}5 \\\\ 12 \\\\ -48\\end{bmatrix}.$"} {:db/id #edb/ref 17592186377100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122c6d88-8494-5aec-a026-229428468b5e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186377102} {:answer/id #uuid "a24fc545-7e28-5319-b8ea-0050a0425013" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186377103} {:answer/id #uuid "565b9eb2-7221-52ec-8a34-db861601dd2c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186377104} {:answer/id #uuid "66cde035-3c2e-5045-8a57-e62cdfc4c320" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186377105} {:answer/id #uuid "5ec426d5-6612-5ded-909b-99d6a4c1702f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-1 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186377106}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186377105} :answer-field/id #uuid "fa4faae0-0911-57b4-a7e3-89f58f84a03e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377101}] :question/id #uuid "bf45deeb-ab83-510b-8f67-2f8280e43963" :question/math-academy-id "q-32543" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -1 & 1 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -1 & 1 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=1 \\\\ -2{y}_{1}+{y}_{2} &=-2 \\\\ -{y}_{1}+{y}_{2}+{y}_{3} &=2.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =1, \\\\ {y}_{2} & =-2+2{y}_{1} \\\\  & =-2+2(1) \\\\  & =0, \\\\ {y}_{3} & =2+{y}_{1}-{y}_{2} \\\\  & =2+(1)-(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067598d2-ade2-5dd5-8073-c389ff24174b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ -2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186478568} {:answer/id #uuid "1c178bab-1c92-5a25-ae64-df6277ac397a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186478602} {:answer/id #uuid "3aea1048-26e5-56d0-bd6c-955510f59840" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186478642} {:answer/id #uuid "81992826-cc58-58c1-a7a5-01d46348c63f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ -4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186478755} {:answer/id #uuid "a28f92ee-2682-564b-832c-3e2a4ecbc8c1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186478826}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186478826} :answer-field/id #uuid "9d96da9c-3e97-52fd-92c9-c73ab85d4165" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479021}] :question/id #uuid "53971d39-ffaa-5c20-9081-d54743d61b0a" :question/math-academy-id "q-32579" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -1 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}6 \\\\ -2 \\\\ 0\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -1 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}6 \\\\ -2 \\\\ 0\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=6 \\\\ -{y}_{1}+{y}_{2} &=-2 \\\\ {y}_{1}-{y}_{2}+{y}_{3} &=0.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =6, \\\\ {y}_{2} & =-2+{y}_{1} \\\\  & =-2+6 \\\\  & =4, \\\\ {y}_{3} & =-{y}_{1}+{y}_{2} \\\\  & =-(6)+4 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}6 \\\\ 4 \\\\ -2\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e232736-d49a-5bd9-b675-ee5259fec02e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ 3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186478631} {:answer/id #uuid "815e68e7-ca75-58f1-bcfc-ed2da4282e27" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186478754} {:answer/id #uuid "95cf673a-2ed5-5f8f-8bf1-3f41b9554c32" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ -3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186478805} {:answer/id #uuid "a4e2561d-5010-5edc-889a-d78a29403e9e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186478829} {:answer/id #uuid "aadef4be-b14a-56bf-bbcb-88222c60c6ba" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ -5 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186478840}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-4 \\\\ 3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186478631} :answer-field/id #uuid "48192aeb-3b0f-5497-bc1d-dd799e8a5dc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478984}] :question/id #uuid "7099a838-c9d8-54d6-9fec-92d9fefe3598" :question/math-academy-id "q-107184" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & -3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-4 \\\\ -5 \\\\ 9\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & -3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ -5 \\\\ 9\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-4 \\\\ 2{y}_{1}+{y}_{2} &=-5 \\\\ -4{y}_{1}-3{y}_{2}+{y}_{3} &=9.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-4, \\\\ {y}_{2} & =-5-2{y}_{1} \\\\  & =-5-2(-4) \\\\  & =3, \\\\ {y}_{3} & =9+4{y}_{1}+3{y}_{2} \\\\  & =9+4(-4)+3(3) \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}-4 \\\\ 3 \\\\ 2\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e2d06e1-3417-5d35-8cf9-65a546979702" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-3 \\\\ 2 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186478692} {:answer/id #uuid "79133504-cdc8-50d1-aa34-0969c29bcf2b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-3 \\\\ 4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186478738} {:answer/id #uuid "8fd1c199-45e5-5ea6-978f-4358accf0c0c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186478787} {:answer/id #uuid "956543c5-8ef1-5bc5-846f-2b5c75aeb0b1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ 4 \\\\ -13\\end{bmatrix}" :db/id #edb/ref 17592186478804} {:answer/id #uuid "a10292bf-b579-5963-ba7f-90d1ac0490d4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -2 \\\\ -13\\end{bmatrix}" :db/id #edb/ref 17592186478821}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -2 \\\\ -13\\end{bmatrix}" :db/id #edb/ref 17592186478821} :answer-field/id #uuid "e6844dfb-a5ce-580b-b6b3-0beb630d472c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479048}] :question/id #uuid "e717653a-60c8-527b-b3b4-e108ff685e10" :question/math-academy-id "q-105932" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 2 & -2 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 2 & -2 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 1 \\\\ -3\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=3 \\\\ {y}_{1}+{y}_{2} &=1 \\\\ 2{y}_{1}-2{y}_{2}+{y}_{3} &=-3.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =3, \\\\ {y}_{2} & =1-{y}_{1} \\\\  & =1-(3) \\\\  & =-2, \\\\ {y}_{3} & =-3-2{y}_{1}+2{y}_{2} \\\\  & =-3-2(3)+2(-2) \\\\  & =-13.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}3 \\\\ -2 \\\\ -13\\end{bmatrix}.$"} {:db/id #edb/ref 17592186558529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14beea86-f47c-5a8c-9bec-dff707ad6098" :answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ 8 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186557916} {:answer/id #uuid "2e855c15-8cb8-5eb3-ad1a-06b9a164a41f" :answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ 2 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186557963} {:answer/id #uuid "9cb700b3-de35-5eef-a9b9-8f936285f7aa" :answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ 2 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186558175} {:answer/id #uuid "9dd0b1f6-0564-5713-91c8-8b44037f4570" :answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ -5 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186558178} {:answer/id #uuid "a2fda1e6-ea2c-5685-8e6d-c69133ac2877" :answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ -5 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186558189}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=[\\begin{aligned}-1 \\\\ -5 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186558178} :answer-field/id #uuid "72d3d84a-5d38-5708-8891-cf429ce55b84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558415}] :question/id #uuid "772e6d55-2cc0-5849-b50b-b1451b60fe6e" :question/math-academy-id "q-107185" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 8 & -5 & 1\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ -3 \\\\ 8\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 8 & -5 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}-1 \\\\ -3 \\\\ 8\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=-1 \\\\ -2{y}_{1}+{y}_{2}=-3 \\\\ 8{y}_{1}-5{y}_{2}+{y}_{3}=8.\\end{aligned}\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =-1, \\\\ {y}_{2} & =-3+2{y}_{1} \\\\  & =-3+2(-1) \\\\  & =-5, \\\\ {y}_{3} & =8-8{y}_{1}+5{y}_{2} \\\\  & =8-8(-1)+5(-5) \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, \n$y=[\\begin{aligned}-1 \\\\ -5 \\\\ -9\\end{aligned}].$"}] :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 3x3 Matrix"} {:db/id #edb/ref 17592186119886 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119706 :question/id #uuid "cbefba9a-eda2-5a8e-8bb5-59ea4175b835" :question/math-academy-id "e-8926" :question/problem "Consider the matrix $L$ and the vector $\\mathbf b,$ given by \n\n![](images/9d/9d0b186213211813b290f502888f68e0603bc9f77bcd7ea9d6262cb7449c00e7.svg)\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $\\mathbf{y}$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $A\\mathbf{x}=\\mathbf{b}.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $U\\mathbf{x}=\\mathbf{y},$ we obtain\n\n![](images/42/4298fe244fd6c66c7623ad508c97b96464321387506aa1e4be5e2399a5c9a862.svg)\n\nWe now solve $L\\mathbf{y} = \\mathbf{b}.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ 15 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 66\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=5 \\\\ 15{y}_{1}+{y}_{2} &=66.\\end{aligned}\\right.\n$$\n\nThe solution to this system is $y_1=5$ and $y_2=-9.$ \n\nTherefore, ![](images/a8/a86dfd0e07b8c415e526764cf9f7ba8f020609bf7b13cc90536deba868ec4aa6.svg)"} :knowledge-point/id #uuid "5250e0e1-4909-5075-8a8e-aa2f1be0bd9a" :knowledge-point/questions [{:db/id #edb/ref 17592186120074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f714c4-06dc-5adf-9624-096b89392556" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186116652} {:answer/id #uuid "ce5d4dcc-959b-578c-bb38-f329c2c8321d" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-1 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186116653} {:answer/id #uuid "da80ce80-1e18-5cde-93ea-1ec4083c7e4c" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186116654} {:answer/id #uuid "e8031310-e2ba-5481-a202-78a9d61b4690" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}-1 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186116655} {:answer/id #uuid "045d05da-3ff6-5b7f-bf6a-1c5fcded6e8e" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}1 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186116656}] :answer-field/id #uuid "4e954118-807e-5c50-9abe-087ef6c8cd38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116651}] :question/id #uuid "bb9d5886-4537-52d7-8618-171a095defc3" :question/math-academy-id "q-105751" :question/problem "Consider the matrix $L$ and the vector $b$, given by\n\n$L = \\begin{bmatrix}1 & 0 \\\\ 9 & 1\\end{bmatrix}, b = \\begin{bmatrix}1 \\\\ 5\\end{bmatrix}$.\n\nIf $A = LU$ is the LU factorization of some $2 \\cdot 2$ matrix $A$, find the vector $y$ such that\n\n${Ly = b; Ux = y$\nis equivalent to $Ax = b$."} {:db/id #edb/ref 17592186120203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3ad7257-bfc6-5c83-bacb-b1cec1e00e28" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\begin{bmatrix}3 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186117380} {:answer/id #uuid "f12c4041-ef47-51a0-9784-0fa629778867" :answer/type {:db/ident :ans