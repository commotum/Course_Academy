/id #edb/ref 17592186404102} {:answer/id #uuid "c73ad559-0eae-5f15-bdf7-739e613b69ee" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-5,$ and $c=-1$" :db/id #edb/ref 17592186404103} {:answer/id #uuid "d0038efe-a96a-5281-ad36-c4af7f9c03a2" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=5,$ and $c=-1$" :db/id #edb/ref 17592186404104} {:answer/id #uuid "c0406221-3155-5859-8236-e58b9f481700" :answer/type {:db/ident :answer.type/text} :answer/value "$a=5,$ $b=1,$ and $c=1$" :db/id #edb/ref 17592186404105} {:answer/id #uuid "d939f8e6-1f46-548c-8adc-229c62fd7d9e" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-1,$ $b=1,$ and $c=5$" :db/id #edb/ref 17592186404106}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$a=5,$ $b=1,$ and $c=-1$" :db/id #edb/ref 17592186404102} :answer-field/id #uuid "b352245b-eaa4-5fde-aea9-5afac2d00b93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404101}] :question/id #uuid "84388249-87e9-543c-a81f-fd99783cee24" :question/math-academy-id "q-80392" :question/problem "Consider the matrix $B$ for which ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-3$ are eigenvalues, and\n\n$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nB=\\begin{bmatrix}b & -3 \\\\ c & 4\\end{bmatrix}\\begin{bmatrix}a & 0 \\\\ 0 & -3\\end{bmatrix}{\\begin{bmatrix}b & -3 \\\\ c & 4\\end{bmatrix}}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-3,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=5,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-3.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}1 & -3 \\\\ -1 & 4\\end{bmatrix}.\n$$\n\nFinally, we obtain\n\n$$\nB=\\begin{bmatrix}1 & -3 \\\\ -1 & 4\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}{\\begin{bmatrix}1 & -3 \\\\ -1 & 4\\end{bmatrix}}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=5,$ $b=1,$ and $c=-1.$"} {:db/id #edb/ref 17592186455430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc7b182-c3fd-553c-be4d-b9112ef4c73c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}18 & 10 \\\\ -12 & 20\\end{bmatrix}$" :db/id #edb/ref 17592186454935} {:answer/id #uuid "476fd012-4ff3-5b8f-842c-88b817ba1b5a" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$ and   \n$P=\\begin{bmatrix}-5 & 10 \\\\ -3 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186455023} {:answer/id #uuid "cca8e467-abba-5462-8a16-29e9504f7afa" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and \n$P=\\begin{bmatrix}3 & 5 \\\\ 2 & -10\\end{bmatrix}$" :db/id #edb/ref 17592186455255} {:answer/id #uuid "cca96309-2d21-50a8-a577-57f0db5a2285" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}$ and  \n$P=\\begin{bmatrix}-5 & -6 \\\\ 10 & 4\\end{bmatrix}$" :db/id #edb/ref 17592186455256} {:answer/id #uuid "e8a73ef2-ec50-56f0-b4f1-bd31801ac7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$ and  \n$P=\\begin{bmatrix}-5 & 3 \\\\ 10 & -2\\end{bmatrix}$" :db/id #edb/ref 17592186455307}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$ and  \n$P=\\begin{bmatrix}