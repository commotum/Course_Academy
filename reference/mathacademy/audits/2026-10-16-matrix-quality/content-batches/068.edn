ed}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=2 \\\\ -4{y}_{1}+{y}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=2$ and ${y}_{2}=6.$ \n\nTherefore, $y=\\begin{bmatrix}2 \\\\ 6\\end{bmatrix}.$"} {:db/id #edb/ref 17592186377121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b870eb16-5ce0-5162-b16c-6bf0c19730ed" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-6 \\\\ -22\\end{bmatrix}" :db/id #edb/ref 17592186377123} {:answer/id #uuid "4b152198-d118-559b-843f-9b57dc68f704" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-6 \\\\ -20\\end{bmatrix}" :db/id #edb/ref 17592186377124} {:answer/id #uuid "4d9623ed-a1b1-5d4a-be9b-612fbcc65b73" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-7 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186377125} {:answer/id #uuid "6deb7b21-7c85-56f8-9528-e84e9ceab7fb" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-6 \\\\ 20\\end{bmatrix}" :db/id #edb/ref 17592186377126} {:answer/id #uuid "d8a358bd-9d5a-5f2d-9933-0701751aede1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}6 \\\\ 20\\end{bmatrix}" :db/id #edb/ref 17592186377127}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-6 \\\\ -20\\end{bmatrix}" :db/id #edb/ref 17592186377124} :answer-field/id #uuid "fc928ac0-c9c6-5840-b70e-ac2d11b3153c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377122}] :question/id #uuid "38791735-0b4e-5de5-b486-578887de857a" :question/math-academy-id "q-32714" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-6 \\\\ 22\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}-6 \\\\ 22\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-6 \\\\ -7{y}_{1}+{y}_{2} &=22.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=-6$ and ${y}_{2}=-20.$ \n\nTherefore, $y=\\begin{bmatrix}-6 \\\\ -20\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c66c0e-e0d0-5c27-907f-9e31b4c17877" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186478616} {:answer/id #uuid "44df3446-722a-5a1f-9400-f9c2edb4a1ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186478656} {:answer/id #uuid "a1b54213-3d59-59c8-98ef-a8f08dbb4c4e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186478822} {:answer/id #uuid "d1de89e0-2dc2-5990-94a4-6e3067c9a319" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186478892} {:answer/id #uuid "e65b36d6-4ce8-57b8-a24e-fa7877ec664c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186478916}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186478916} :answer-field/id #uuid "61c0b255-63a0-5164-9dd6-3298c1d228e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478996}] :question/id #uuid "084c02e4-7974-5581-92ae-668d0f97c0f4" :question/math-academy-id "q-107170" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=2 \\\\ -3{y}_{1}+{y}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=2$ and ${y}_{2}=4.$ \n\nTherefore, $y=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22731b55-f78a-5a55-92f4-008ff3141486" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186478612} {:answer/id #uuid "7f0c9743-f8c0-561f-ab43-b3ac76dffb0b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186478749} {:answer/id #uuid "9e5361cb-8aa1-5d87-98cb-cd1a2de8325f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186478817} {:answer/id #uuid "a20766a5-d1e0-5ad7-86ef-477529985f26" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186478823} {:answer/id #uuid "f8caf96d-5269-56da-a649-68d0844a6110" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186478948}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186478823} :answer-field/id #uuid "53bb28f7-eb24-5527-b2b9-b9e6a0b7f670" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478993}] :question/id #uuid "501022bc-dca6-55f9-9b78-5c4a339dd1a1" :question/math-academy-id "q-107169" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ 7 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -9\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ 7 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -9\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=-2 \\\\ 7{y}_{1}+{y}_{2} &=-9.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=-2$ and ${y}_{2}=5.$ \n\nTherefore, $y=\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0043e87e-f842-57e6-82bc-b4ea7ec5f162" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}8 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186478563} {:answer/id #uuid "2e8f7d3a-59d4-56b1-9c28-1128e20099aa" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}8 \\\\ -78\\end{bmatrix}" :db/id #edb/ref 17592186478632} {:answer/id #uuid "4856545f-c7b8-5207-946b-42bd4c1c3aa8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}8 \\\\ 64\\end{bmatrix}" :db/id #edb/ref 17592186478660} {:answer/id #uuid "92afe7cc-d13c-59a1-b5db-5b37ab35d121" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-8 \\\\ -50\\end{bmatrix}" :db/id #edb/ref 17592186478798} {:answer/id #uuid "f363ef1a-e780-507a-81d1-0ea4237f7e39" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-8 \\\\ 60\\end{bmatrix}" :db/id #edb/ref 17592186478939}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}8 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186478563} :answer-field/id #uuid "2b6940e4-bb59-563a-a937-e93f48ec1bc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478972}] :question/id #uuid "88def0e2-16e4-59a7-96bb-d850c4ea1c49" :question/math-academy-id "q-105758" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}8 \\\\ -14\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}8 \\\\ -14\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=8 \\\\ -8{y}_{1}+{y}_{2} &=-14.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=8$ and ${y}_{2}=50.$ \n\nTherefore, $y=\\begin{bmatrix}8 \\\\ 50\\end{bmatrix}.$"} {:db/id #edb/ref 17592186479145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c72a1a6-e9cc-5dc7-8129-ca02b99a9f47" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ 11\\end{bmatrix}" :db/id #edb/ref 17592186478603} {:answer/id #uuid "204b0962-b138-56df-b0fd-2796efaabbe5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186478609} {:answer/id #uuid "81b0d9a3-f05e-52aa-baca-6aa189c65731" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-9 \\\\ 49\\end{bmatrix}" :db/id #edb/ref 17592186478756} {:answer/id #uuid "9043cde5-3c71-5771-9a3d-347775e2a488" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -49\\end{bmatrix}" :db/id #edb/ref 17592186478790} {:answer/id #uuid "fa9afe1b-bb2b-5925-8cb5-cfde20011076" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}-9 \\\\ 39\\end{bmatrix}" :db/id #edb/ref 17592186478950}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\begin{bmatrix}9 \\\\ -49\\end{bmatrix}" :db/id #edb/ref 17592186478790} :answer-field/id #uuid "db587132-2223-5d73-bd8b-93dbc82d6d91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479043}] :question/id #uuid "fb1f16a0-3031-5b97-a1fa-27b860c24df9" :question/math-academy-id "q-105753" :question/problem "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=\\begin{bmatrix}1 & 0 \\\\ 11 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ 50\\end{bmatrix}.\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y\\end{aligned}\\right.\n$$\n\nis equivalent to $Ax=b.$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 0 \\\\ 11 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix} & =\\begin{bmatrix}9 \\\\ 50\\end{bmatrix}.\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=9 \\\\ 11{y}_{1}+{y}_{2} &=50.\\end{aligned}\\right.\n$$\n\nThe solution to this system is ${y}_{1}=9$ and ${y}_{2}=-49.$ \n\nTherefore, $y=\\begin{bmatrix}9 \\\\ -49\\end{bmatrix}.$"}] :knowledge-point/title "Finding the Solution of an Intermediate System Using the LU Factorization of a 2x2 Matrix"}] :topic/math-academy-id 1782 :topic/title "Solving Systems of Equations Using LU Factorization"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186125538} :activity/id #uuid "c3fad3be-1ce2-5167-98d1-4498a125e7e9" :activity/steps [{:db/id #edb/ref 17592186125538 :step/content {:db/id #edb/ref 17592186125839 :tutorial/content "A square matrix $A$ is called **diagonalizable** if there exists a diagonal matrix $D$ and an invertible matrix $P$ such that\n\n$$\nA = PDP^{-1}.\n$$\n\nSo, to **diagonalize** a matrix $A,$ we need to find a diagonal matrix $D$ and an invertible matrix $P$ that satisfy the equation above.\n\nFor example, let's diagonalize the matrix $A,$ given by\n\n![](images/9d/9dee6d9184932a79f36305b9fca2bbb5a2a18bc79b49ad97038f780a2f125e49.svg)\n\nTo diagonalize a $2\\times 2$ matrix, we follow a three-step **diagonalization algorithm.**\n\n**Step 1:** Find the eigenvalues of the matrix.\n\nWe solve the characteristic equation $\\vert A - \\lambda I \\vert = 0.$ For the given matrix, the eigenvalues are $\\color{red}\\lambda_1 =2$ and $\\color{blue}\\lambda_2 =3.$\n\n**Step 2:** Find a basis of $\\mathbb{R}^2$ consisting of eigenvectors of the matrix.\n\nFollowing the usual method for computing eigenvectors, we get \n\n![](images/ca/caa7716ce45eef38d92092d27827d30fd539fca27067c1e12f485a719b4f37ae.svg)\n\ncorresponding to the eigenvalues $\\color{red}\\lambda_1 =2$ and $\\color{blue}\\lambda_2 =3,$ respectively.\n\nNote that $\\left\\{ {\\color{red}\\mathbf{v_1}}, {\\color{blue}\\mathbf{v_2}}\\right\\}$ is a basis of $\\mathbb{R}^2$ since eigenvectors corresponding to distinct eigenvalues are linearly independent. This becomes important later.\n\n**Step 3: ** Construct the matrices $D$ and $P.$\n\nNow that we have our eigenvalues and corresponding eigenvectors, we can construct the diagonal matrix $D$ and invertible matrix $P.$\n\nThe matrix $D$ has the eigenvalues of the matrix as its entries on the diagonal. For now, we can write them in any order. So, we let\n\n![](images/3e/3e0df792d822773528cb07cceb39fcb98b7397ae70ab4f114e1450f1d91256d1.svg)\n\nThen, the columns of $P$ are the corresponding eigenvectors. We need to write each eigenvector in the *same* column as its respective eigenvalue in the matrix $D.$ So, we get\n\n![](images/86/869a05b6273dbbb1b53d9f842d8b2c612017517a0b007c1c5f494f55439a11b4.svg)\n\nFinally, we obtain\n\n$$\n\\begin{aligned}A=PD{P}^{-1} & =\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}{\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}}^{-1}.\\end{aligned}\n$$\n\nWe can check our solution by computing the product on the right-hand side:\n\n$$\n\\begin{aligned}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}{\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}}^{-1} & =\\begin{bmatrix}6 & -6 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -6 \\\\ 1 & 5\\end{bmatrix} \\\\  & =A\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "1f56a4e0-1c9c-573c-95a9-92a93682f0a2" :tutorial/math-academy-id 5083 :tutorial/title "Introduction"} :step/id #uuid "0dec286b-a54f-500f-b0be-886c4e33f4ba" :step/next {:db/id #edb/ref 17592186125544}} {:db/id #edb/ref 17592186125539 :step/content {:db/id #edb/ref 17592186125840 :tutorial/content "There is a theorem that states the following:\n\n*If $A$ is a $2 \\times 2$ matrix, then it is diagonalizable if and only if there exists a basis of $\\mathbb{R}^2$ that consists of eigenvectors of $A.$*\n\nWe can break this down into two possible cases:\n\n- If $A$ has two distinct eigenvalues, then it is indeed diagonalizable. This is because two distinct eigenvalues will give rise to two linearly independent eigenvectors (one for each eigenvalue). \n\nSo, for a matrix $A$ with eigenvalues $\\color{red}\\lambda_1$ and $\\color{blue}\\lambda_2$ and corresponding eigenvectors $\\color{red}\\mathbf{v_1}$ and $\\color{blue}\\mathbf{v_2},$ we have\n![](images/e1/e1468bc5ccdff43e33587c7b4b500bc527ab0ac7e74410ea53df1f803a19b520.svg)\n\n- If we get a double root $\\lambda$ of the characteristic equation, the matrix will be diagonalizable *only if* we can find exactly two linearly independent eigenvectors corresponding to $\\lambda,$ which may or may not be possible. Another way of saying this is that the corresponding eigenspace $V_\\lambda$ must be of dimension $2.$" :tutorial/id #uuid "fbab2132-0247-5376-a13b-df70908230d9" :tutorial/math-academy-id 5084 :tutorial/title "Diagonalizable vs. Non-Diagonalizable Matrices"} :step/id #uuid "620e7d54-99b9-517c-83f8-d408a4768c65" :step/next {:db/id #edb/ref 17592186125540}} {:db/id #edb/ref 17592186125540 :step/content {:db/id #edb/ref 17592186124599 :knowledge-point/id #uuid "d3d7cb0b-7d81-55a5-9781-dda7e9cc9fb9"} :step/id #uuid "62cef711-c61d-5145-9dcc-a1e378b6208e" :step/next {:db/id #edb/ref 17592186125541}} {:db/id #edb/ref 17592186125541 :step/content {:db/id #edb/ref 17592186125841 :tutorial/content "If $A$ is a diagonalizable matrix, then we can write\n\n$$\nA=PDP^{-1}.\n$$\n\n \n\nWe can write this equation in an equivalent form, making $D$ the subject.\n\nFirst, we left-multiply both sides of the equation by $P^{-1}\\mathbin{:}$ \n\n$$\n\\begin{aligned}A & =PD{P}^{-1} \\\\ {P}^{-1}\\cdot A & ={P}^{-1}\\cdot PD{P}^{-1} \\\\ {P}^{-1}A & ={I}_{2}D{P}^{-1} \\\\ {P}^{-1}A & =D{P}^{-1}\\end{aligned}\n$$\n\nThen, we right-multiply both sides of the equation by $P{:}$\n\n$$\n\\begin{aligned}{P}^{-1}A\\cdot P & =D{P}^{-1}\\cdot P \\\\ {P}^{-1}AP & =D{I}_{2} \\\\ {P}^{-1}AP & =D\\end{aligned}\n$$\n\nTherefore, \n\n$$\nA=PDP^{-1}\n\\qquad\\Longleftrightarrow\\qquad\nD = P^{-1}A P.\n$$" :tutorial/id #uuid "6e0a81c7-a393-5e5d-b8c1-16d982404f1a" :tutorial/math-academy-id 5085 :tutorial/title "The Connection Between a Matrix and Its Diagonal Form"} :step/id #uuid "0692f7d4-6f83-540e-bf5f-78b4908292bd" :step/next {:db/id #edb/ref 17592186125542}} {:db/id #edb/ref 17592186125542 :step/content {:db/id #edb/ref 17592186124600 :knowledge-point/id #uuid "ca18fa52-5494-53ad-bd02-208aba4ff9e1"} :step/id #uuid "232d082f-7199-5eb9-b914-190d04e57153" :step/next {:db/id #edb/ref 17592186125543}} {:db/id #edb/ref 17592186125543 :step/content {:db/id #edb/ref 17592186124601 :knowledge-point/id #uuid "0ff6446e-7913-5d55-adfd-124649f3f1c0"} :step/id #uuid "09beebc7-7088-5b66-8674-578c829c0cb9" :step/next {:db/id #edb/ref 17592186125545}} {:db/id #edb/ref 17592186125544 :step/content {:db/id #edb/ref 17592186124602 :knowledge-point/id #uuid "5164c6cb-aef0-554b-b361-77245991c0ea"} :step/id #uuid "552c7c49-4812-5279-9818-9d8769362100" :step/next {:db/id #edb/ref 17592186125539}} {:db/id #edb/ref 17592186125545 :step/content {:db/id #edb/ref 17592186125842 :tutorial/content "Given a matrix $A,$ the diagonalization \n\n![](images/76/76843143729d2bc62fc74dc6f03c24eb6a12dfc16a2609a8f2b36499cf39ce90.svg)\n\nis almost unique, but not quite.\n\nWhen we construct the diagonal matrix $D,$ we can put the eigenvalues in any order. So this matrix is unique up to permutations of the order of the eigenvalues. Note that by swapping the eigenvalues in $D,$ we then have to swap the corresponding eigenvectors (columns) in $P{:}$\n\n![](images/de/dec5fece3d89eaa022b4e951e63259b0f87213997397b1f8a91fb8fdabed0f74.svg)\n\nAlso, since any non-zero multiple of an eigenvector is an eigenvector as well, the eigenvector basis of $\\mathbb{R}^2$ can consist of these multiples instead. So the invertible matrix $P$ is unique up to multiples of its columns." :tutorial/id #uuid "eb055132-9c7d-55a5-a2c6-0bcb54877c1c" :tutorial/math-academy-id 5086 :tutorial/title "Uniqueness of the Diagonalization"} :step/id #uuid "a11b9aec-3c2f-5a01-8b7c-600351ec33e2" :step/next {:db/id #edb/ref 17592186125662}} {:db/id #edb/ref 17592186125662 :step/content {:db/id #edb/ref 17592186125896 :tutorial/content "Let ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) be a diagonalizable ![](images/25/2521651122403a440e682fef383af333958f5b0d1334abe8b0771865d4daf100.svg) matrix. Then we can write\n![](images/d8/d8f75220bef8327a8dfc49a6ae22e79c6f1649aefdc8fb43065e0616975a8c5c.svg)\nwhere\n\n- ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) is an invertible matrix whose columns are eigenvectors ![](images/13/13cfebc7f22b3c6cfe7a66492040f9c7682e27e72b0a9adbc033e6a815c68fd9.svg) and ![](images/d0/d0c6e1eed1577bd5d71e38657d494bf53798b9c1f52c54e4a270e200df1cc351.svg) of ![](images/c2/c2c85081d1f89d74b8ebb2761496d211d7052193809b7864e7983437f5d0b80f.svg) and\n\n- ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) is a diagonal matrix whose diagonal entries are the corresponding eigenvalues ![](images/ff/ff5243fdeda78658220d1bcd4ac9b5963157b5e1f8b6a31231c68a6743248b19.svg) and ![](images/4a/4a2dd44cea07e06ccec03fff120c7fdbcebe19ad7a31d8abde1ab95c8a6b53a1.svg)\n\nTo understand this better, we need to distinguish between two coordinate systems.\n\nIn ![](images/fb/fb3130e489fdca80d1a077702861c20532fe613f9942d48fa1ec24055494a383.svg) the **standard basis** is\n![](images/d2/d29d3ee4ae42a8d4ee5304cb0d29c6c811838d7b893a3a831b1b1b8b3af12561.svg)\n\nSo, if a vector is written as\n![](images/bb/bbbc0379f1691a30dec4c34ec6171db1f116bec12a24891169957af68164f8d3.svg)\nthen ![](images/12/12adb8ba7ed45d89c9d9a80eb7c06616c41999e9fac57732bc24d2b55e1f8073.svg) The numbers ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) and ![](images/a7/a77a353782459b753313d80235712695d65dc4a44d8d357aa41add6729f81d8f.svg) are the *standard coordinates* of ![](images/1f/1f3d1a60926323e963d7563529669e5cf8210771c8cbb0379f7a7d90e7c6aeec.svg)\n\nNow let\n![](images/58/58cdfb66e4c93d643fb97273610b3bbf67c8831516d4ccfc5b7790d55a169b28.svg)\n\nSince the columns of ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) are ![](images/13/13cfebc7f22b3c6cfe7a66492040f9c7682e27e72b0a9adbc033e6a815c68fd9.svg) and ![](images/d0/d0c6e1eed1577bd5d71e38657d494bf53798b9c1f52c54e4a270e200df1cc351.svg) written in standard coordinates, the matrix ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) converts coordinates from the basis ![](images/be/be2d796b77bebb31c0c06cef6af82bc9fb606a584a52cc5385cd32c4e143236c.svg) to the standard basis.\n\nSo, for any vector ![](images/b2/b2cb236f7a7f426f303b1391f76900b47f7d2fa1ad9c8110d8584182559017fd.svg)\n![](images/7e/7e5a6a4b9bee9550e68c75a3945ad25d41f1de6dd3b089ce89005428da169f9d.svg)\n\nHere, ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) denotes the standard-coordinate column of the vector, while ![](images/3f/3f7132e53e5a27bee4c84bdddbac07971ec44ce12539c0e0c23bf0006057e199.svg) denotes the coordinate column of the same vector in the eigenvector basis ![](images/8d/8d16f7d70344ddea7a4fe48105e5ea75b984f48fd77f6f6eb89d26ad91b65805.svg)\n\nAlso, in the basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg) the eigenvectors have especially simple coordinate columns:\n![](images/9f/9f5fec87a4253a3a1741c3380e2c6f9331928883ab2083dc02bf0e8efda6a98a.svg)\n\nThis is because\n![](images/30/306d2bb3211dac2883b1eb6abaed54259272a8bcc6a4e562ff5da6fc52dee520.svg)\n\nSo, in the basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg) the matrix ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) acts by scaling the first coordinate by ![](images/ff/ff5243fdeda78658220d1bcd4ac9b5963157b5e1f8b6a31231c68a6743248b19.svg) and the second coordinate by ![](images/4a/4a2dd44cea07e06ccec03fff120c7fdbcebe19ad7a31d8abde1ab95c8a6b53a1.svg)\n\nWe can summarize this process for any vector ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) as a sequence of three steps:\n\n- first, rewrite ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) in the eigenvector basis ![](images/da/dab6f1afbeb705eef0eaf1a338c977e9cf6578010ebf95a6fccd1a4a4610dcd4.svg)\n\n- then, apply the diagonal matrix ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) in that basis,\n\n- finally, convert the result back to standard coordinates.\n\nThe diagram below shows this sequence.\n\n![](images/14/1459b0643f99c186f9710118617f89f34a601526e7154213471404d2feb2aaeb.svg)" :tutorial/id #uuid "61524e43-2735-5e5a-904b-2c4973df94a9" :tutorial/math-academy-id 7958 :tutorial/title "Diagonalization as a Change of Coordinates"} :step/id #uuid "831d0bbd-aa17-5012-9d8b-073e0d2d67a6"}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186124753} {:activity/first-step {:db/id #edb/ref 17592186436966} :activity/id #uuid "6f8bc57b-28dc-577c-84b2-316db148cde5" :activity/steps [{:db/id #edb/ref 17592186436962 :step/content {:db/id #edb/ref 17592186404107 :question/id #uuid "7be4462e-3d0b-5745-b83e-db8e5d74f57e"} :step/id #uuid "260bb0c0-f4cc-5171-8f8e-251abb929092" :step/next {:db/id #edb/ref 17592186436963}} {:db/id #edb/ref 17592186436963 :step/content {:db/id #edb/ref 17592186404114 :question/id #uuid "f53e1d4c-a53d-5c3e-8ae8-0e080a8e331f"} :step/id #uuid "c086434a-2e61-5437-a45d-1dd3277fb4b0"} {:db/id #edb/ref 17592186436964 :step/content {:db/id #edb/ref 17592186348376 :question/id #uuid "e9500f77-53af-537c-9030-31932253fda8"} :step/id #uuid "d7283a38-9ca3-5452-bb36-0cf434eae378" :step/next {:db/id #edb/ref 17592186436962}} {:db/id #edb/ref 17592186436965 :step/content {:db/id #edb/ref 17592186323864 :question/id #uuid "2785be4b-345b-5745-9527-bd2763533b0c"} :step/id #uuid "f50c4f35-60de-5348-bbfd-204a572ac060" :step/next {:db/id #edb/ref 17592186436964}} {:db/id #edb/ref 17592186436966 :step/content {:db/id #edb/ref 17592186125019 :question/id #uuid "47e69096-fce9-5678-91d0-dfdd65324d6f"} :step/id #uuid "fec85443-07a4-5564-aa88-c4b5100cb9d2" :step/next {:db/id #edb/ref 17592186436965}}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186436956} {:activity/first-step {:db/id #edb/ref 17592186484343} :activity/id #uuid "a8c2fb89-d42b-514b-82ae-19ce4b7382f1" :activity/steps [{:db/id #edb/ref 17592186484302 :step/content {:db/id #edb/ref 17592186404086 :question/id #uuid "5e995591-79aa-5800-bd07-e99e51f5d9cb"} :step/id #uuid "0941e58b-0bd2-5235-9587-a3343780969f" :step/next {:db/id #edb/ref 17592186484348}} {:db/id #edb/ref 17592186484321 :step/content {:db/id #edb/ref 17592186272003 :question/id #uuid "f80fc9d4-c782-54c4-af07-b3eb33afd65c"} :step/id #uuid "5513cc34-2b32-5506-9702-6da092a7c566"} {:db/id #edb/ref 17592186484343 :step/content {:db/id #edb/ref 17592186125087 :question/id #uuid "1a91b641-268c-57ee-aae6-245277497fff"} :step/id #uuid "b6191fc0-4b6b-54d3-87b6-db357e39ec0f" :step/next {:db/id #edb/ref 17592186484359}} {:db/id #edb/ref 17592186484348 :step/content {:db/id #edb/ref 17592186404093 :question/id #uuid "0fb53181-29d9-5f89-8598-3c491720e6bd"} :step/id #uuid "be260382-f713-59c8-aa98-36b16550df21" :step/next {:db/id #edb/ref 17592186484321}} {:db/id #edb/ref 17592186484359 :step/content {:db/id #edb/ref 17592186125090 :question/id #uuid "52d32399-93d9-5ce5-a996-5d60c1e0900e"} :step/id #uuid "e96641df-6f79-5c48-8011-c2641ddec815" :step/next {:db/id #edb/ref 17592186484302}}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186483562} {:activity/first-step {:db/id #edb/ref 17592186499618} :activity/id #uuid "6b84de71-8564-517b-bc1e-eaec4c35e318" :activity/steps [{:db/id #edb/ref 17592186499572 :step/content {:db/id #edb/ref 17592186323926 :question/id #uuid "e30ae3bf-a95b-5038-8bdd-b265809e9d12"} :step/id #uuid "0bea5b6f-6c05-5fe2-ad23-ee7c6d0550fe" :step/next {:db/id #edb/ref 17592186499594}} {:db/id #edb/ref 17592186499573 :step/content {:db/id #edb/ref 17592186348381 :question/id #uuid "4fad8010-b1d7-51d3-ae7c-0e9c4f636170"} :step/id #uuid "13e8d76b-e707-545b-91b0-3646c86cd6fd"} {:db/id #edb/ref 17592186499594 :step/content {:db/id #edb/ref 17592186348375 :question/id #uuid "def1c542-80f5-5b03-88dc-ad7a755f7e8b"} :step/id #uuid "66d23587-6ec7-592c-a133-1458d9c3ea42" :step/next {:db/id #edb/ref 17592186499595}} {:db/id #edb/ref 17592186499595 :step/content {:db/id #edb/ref 17592186404100 :question/id #uuid "84388249-87e9-543c-a81f-fd99783cee24"} :step/id #uuid "6bf05bcb-22b4-547e-acbe-f43cad6ac0ce" :step/next {:db/id #edb/ref 17592186499573}} {:db/id #edb/ref 17592186499618 :step/content {:db/id #edb/ref 17592186323881 :question/id #uuid "334a7a7c-883e-54c4-9c3a-6e918b1922ab"} :step/id #uuid "c44bbf6a-6f50-5fd9-883e-0b5cb944bf04" :step/next {:db/id #edb/ref 17592186499572}}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186498723} {:activity/first-step {:db/id #edb/ref 17592186519608} :activity/id #uuid "1ab91b77-5a38-545c-aad3-8c7b75ae2ef4" :activity/steps [{:db/id #edb/ref 17592186519608 :step/content {:db/id #edb/ref 17592186348376 :question/id #uuid "e9500f77-53af-537c-9030-31932253fda8"} :step/id #uuid "003b1825-afe9-583d-9089-86405c5e6a74" :step/next {:db/id #edb/ref 17592186519626}} {:db/id #edb/ref 17592186519615 :step/content {:db/id #edb/ref 17592186348389 :question/id #uuid "93fc1e8e-53c7-5d4c-ad22-c729f51f630d"} :step/id #uuid "1b44f557-01ab-5482-9558-b2e2cf4a9a80" :step/next {:db/id #edb/ref 17592186519670}} {:db/id #edb/ref 17592186519618 :step/content {:db/id #edb/ref 17592186348383 :question/id #uuid "48f981b1-9aeb-5e6b-818c-36bd836ee49e"} :step/id #uuid "1ed0c797-27ac-5a1d-9d59-6db1aaefb34a" :step/next {:db/id #edb/ref 17592186519615}} {:db/id #edb/ref 17592186519626 :step/content {:db/id #edb/ref 17592186455503 :question/id #uuid "dde0c5ba-d69f-5523-84e3-29d85ec2262a"} :step/id #uuid "3bdb7801-f8d6-5f41-a4ac-0d153c4f6c8b" :step/next {:db/id #edb/ref 17592186519618}} {:db/id #edb/ref 17592186519670 :step/content {:db/id #edb/ref 17592186272015 :question/id #uuid "472ad991-cd49-54f3-aa78-cfe11b836a0b"} :step/id #uuid "f7118053-34d6-53bc-9f06-3bdde789e2a3"}] :activity/title "Diagonalizing a 2x2 Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186518977}] :db/id #edb/ref 17592186049113 :topic/knowledge-points [{:db/id #edb/ref 17592186124599 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124411 :question/id #uuid "f7b85641-289b-57b2-9ffc-ff4c5e10025a" :question/math-academy-id "e-8572" :question/problem "Determine if the matrix\n![](images/af/af05cedf7b2015f4f61df71e833390aa845d50126c3203369320ac6feb8b2cc3.svg)\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "Since $A$ is triangular, the eigenvalues are the entries on the main diagonal. \n\nSo, the eigenvalues are $\\lambda_1=\\lambda_2=3.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $A-3I\\mathbin{:}$\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}3 & -5 \\\\ 0 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -5 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} :knowledge-point/id #uuid "d3d7cb0b-7d81-55a5-9781-dda7e9cc9fb9" :knowledge-point/questions [{:db/id #edb/ref 17592186125086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21261329-9daf-5c17-932a-47224646e916" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186321396} {:answer/id #uuid "270c6905-11bb-524c-a6ad-4e56ea646327" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186321456} {:answer/id #uuid "5420e041-102c-5616-893b-d67c8be18b68" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321809} {:answer/id #uuid "6de50996-f239-56bf-a11b-c4a6fcde6584" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186322000} {:answer/id #uuid "f6d0eb6e-e11d-55f8-9d3f-788a4f8ae234" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186323082}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186323082} :answer-field/id #uuid "33ce1c1e-9234-5842-9163-b843c0e50c5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323274}] :question/id #uuid "474a90c6-ac56-574a-b515-a9ddafabb1ff" :question/math-academy-id "q-37599" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}10 & -4 \\\\ 24 & -10\\end{bmatrix}$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}10-\\lambda  & -4 \\\\ 24 & -10-\\lambda \\end{vmatrix} & =0 \\\\ (10-\\lambda )(-10-\\lambda )-24\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-4 & =0 \\\\ (\\lambda +2)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-2.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}2 & 0 \\\\ 0 & -2\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186125088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f16abbc-4149-5193-b853-481b207e4736" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321513} {:answer/id #uuid "3620112a-2018-5825-ade0-85ba6c5a7fea" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186321560} {:answer/id #uuid "712ac67f-ef52-54ae-b45a-fff98a6b3948" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}0 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186322032} {:answer/id #uuid "f7be1adc-75a5-5a9c-8e22-1eb4af7f5171" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186323093} {:answer/id #uuid "fd4e8f98-bc23-554e-bb15-d04d57120001" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186323146}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321513} :answer-field/id #uuid "f6b3b9d3-23db-5592-870c-4284b102d33e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323653}] :question/id #uuid "fc9b7c52-0fe8-51bc-a93c-2e178718ab57" :question/math-academy-id "q-37609" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}4-\\lambda  & 1 \\\\ -1 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )(2-\\lambda )-1\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)(\\lambda -3) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=3.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-3I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186272005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041d9841-9f08-519f-a78e-df5ce0f663c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186269307} {:answer/id #uuid "1f0e42ec-d22c-5f4b-98ae-1c49098bd803" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186269529} {:answer/id #uuid "8c630ebe-0288-5d13-9598-c81879223762" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186270486} {:answer/id #uuid "ad8ff8df-8e33-5284-853b-8a9d4bc96442" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186270813} {:answer/id #uuid "e4ef856f-43ae-59d1-88a2-562a7bf18b77" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186271287}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186271287} :answer-field/id #uuid "87395b4b-a632-5a49-a2c8-1ed2a57ffd8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271747}] :question/id #uuid "6fb633b8-d688-5aba-9f36-3226f86d1384" :question/math-academy-id "q-140040" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}8 & 9 \\\\ -4 & -4\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}8-\\lambda  & 9 \\\\ -4 & -4-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(-4-\\lambda )-9\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-4\\lambda -32+36 & =0 \\\\ {\\lambda }^{2}-4\\lambda +4 & =0 \\\\ (\\lambda -2)(\\lambda -2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=2.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-2I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}8 & 9 \\\\ -4 & -4\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 9 \\\\ -4 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186272006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "283c9b8d-0bc6-5f6d-ab75-b05ebf7c10b0" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186269627} {:answer/id #uuid "863c0960-56c9-5f0d-8a3f-18dcf4f448c4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186270434} {:answer/id #uuid "bf8b57f2-85f2-52f1-8dfd-1261aa79b817" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186270965} {:answer/id #uuid "f1c0b1e8-944c-5cb1-a5b4-4a92c1b2c7d2" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186271391} {:answer/id #uuid "fa9c478f-a619-5b23-b921-3dd46f2480b7" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-6 & 0 \\\\ 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186271460}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186270965} :answer-field/id #uuid "c2ecc330-5bb1-57c3-85e6-604377b79cc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271864}] :question/id #uuid "f32897c4-518a-5afa-9fd8-47a52f4a97c0" :question/math-academy-id "q-140041" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}1 & 1 \\\\ -3 & 5\\end{bmatrix}$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}1-\\lambda  & 1 \\\\ -3 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(5-\\lambda )-(1)(-3) & =0 \\\\ {\\lambda }^{2}-6\\lambda +5+3 & =0 \\\\ {\\lambda }^{2}-6\\lambda +8 & =0 \\\\ (\\lambda -2)(\\lambda -4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186323864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "091ed9c8-701c-5cb1-b4b2-8dafbd6659dd" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321219} {:answer/id #uuid "0d4e4736-139c-5bc4-aa44-e138e20e88fa" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186321251} {:answer/id #uuid "3e039b3f-0f39-5295-b15a-c8fb9166f65d" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}4 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186321634} {:answer/id #uuid "81d4c416-dbd3-50b6-9617-7a656869e7ab" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186322169} {:answer/id #uuid "88434e58-c606-599d-b3d0-8af7287c81ce" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}4 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186322233}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321219} :answer-field/id #uuid "499f430b-3198-504e-8f47-b2cafb6155fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323306}] :question/id #uuid "2785be4b-345b-5745-9527-bd2763533b0c" :question/math-academy-id "q-36929" :question/problem "Determine if the matrix\n$A=\\begin{bmatrix}4 & 8 \\\\ 0 & 4\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "Since $A$ is triangular, the eigenvalues are the entries on the main diagonal. \n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=4.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-4I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}4 & 8 \\\\ 0 & 4\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 8 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186323876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a9639f-c8ec-55ff-aabe-2b5d413ac483" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186321666} {:answer/id #uuid "626f8872-2e91-5375-8a98-c3aad962bfd4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321915} {:answer/id #uuid "6658806d-7ac2-5c8c-8d52-4d336bca145f" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186321941} {:answer/id #uuid "7916f13f-597e-51e5-8b7c-35b7274f016b" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186322099} {:answer/id #uuid "d7abc12b-11e9-5c31-ba29-3f1b3d6db875" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186322831}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321915} :answer-field/id #uuid "dbba43cf-bad2-537a-b332-6f2c8bd9b15a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323606}] :question/id #uuid "22d45558-5d6d-54db-98ed-1c94a3458111" :question/math-academy-id "q-37085" :question/problem "Determine if the matrix\n$A=\\begin{bmatrix}-2 & 5 \\\\ 0 & -2\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "Since $A$ is triangular, the eigenvalues are the entries on the main diagonal. \n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-2.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-(-2)I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-2 & 5 \\\\ 0 & -2\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 5 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186323926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08231533-7a2b-53e3-bb3b-f126a0945f7a" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186321209} {:answer/id #uuid "0b24974a-4a95-5964-a796-dfc9de32a894" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186321240} {:answer/id #uuid "3092878c-f858-5dc5-bfd5-49f9775ffbc2" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}4 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186321519} {:answer/id #uuid "81980f53-11b8-52ef-bde5-882f1c8ff79d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186322168} {:answer/id #uuid "d8e1dfdd-2680-5cf5-8e11-29ac4f3cc003" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186322847}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186321240} :answer-field/id #uuid "94a63c75-dcf0-5bbc-84eb-ef1e705e4ed9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323459}] :question/id #uuid "e30ae3bf-a95b-5038-8bdd-b265809e9d12" :question/math-academy-id "q-37629" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}6 & 5 \\\\ -10 & -9\\end{bmatrix}$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{vmatrix} & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186348381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188ff12c-cc1a-5287-b72f-b735762cd4d9" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186345568} {:answer/id #uuid "8c4889c1-8a99-5c50-8d21-7e1f3fa8f0f6" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186346569} {:answer/id #uuid "97a5840f-59d5-5c8b-8a78-3953a0ad08a0" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186346680} {:answer/id #uuid "a9bae287-d269-54df-b55a-ae11d68c915d" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186346833} {:answer/id #uuid "b8d5cbcb-c866-50ca-b5fd-06a7526077af" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}2 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186346956}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186345568} :answer-field/id #uuid "00112189-18a5-5932-8481-85e29798e6dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347602}] :question/id #uuid "4fad8010-b1d7-51d3-ae7c-0e9c4f636170" :question/math-academy-id "q-80453" :question/problem "Determine if the matrix\n$A=\\begin{bmatrix}-2 & 3 \\\\ 0 & -2\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "Since $A$ is triangular, the eigenvalues are the entries on the main diagonal. \n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-2.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-(-2)I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-2 & 3 \\\\ 0 & -2\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186348382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f2172d-c2c7-5853-abfe-ac6a29fa3ef4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186345429} {:answer/id #uuid "21f5fd15-786d-5624-8625-e09b4053bc07" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186345654} {:answer/id #uuid "532989f7-86c9-54de-ad09-588a5c52da17" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186346060} {:answer/id #uuid "650ab258-c139-5812-9292-5a57c06d5d0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186346229} {:answer/id #uuid "8c06100d-1170-5433-9077-f034ee74c306" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186346564}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186345654} :answer-field/id #uuid "0e374479-6696-5b75-99dc-96f5e4575fae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347634}] :question/id #uuid "082d41d1-cb8b-540c-9c6f-0eb8d16da184" :question/math-academy-id "q-80454" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}-1 & 4 \\\\ -1 & 3\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-1-\\lambda  & 4 \\\\ -1 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (-1-\\lambda )(3-\\lambda )-4\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-2\\lambda +1 & =0 \\\\ (\\lambda -1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=1.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-1I)\\text{x}=0:$\n\n$$\n\\begin{aligned}A-1I & =\\begin{bmatrix}-1 & 4 \\\\ -1 & 3\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 4 \\\\ -1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}-\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186348383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20ff14a7-d4d5-50bc-821b-a293afe61e25" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186345647} {:answer/id #uuid "65179ae5-e8f1-5311-9f64-d3365ae764c6" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -7\\end{bmatrix}" :db/id #edb/ref 17592186346231} {:answer/id #uuid "bca55efc-20ac-5249-a6ef-973336e68518" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186346991} {:answer/id #uuid "c5248413-a636-5fb2-a3f0-58309d0188c3" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}7 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186347058} {:answer/id #uuid "e83ddb93-7529-5d0f-bd36-1ccfb06d3e5c" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-7 & 0 \\\\ 0 & -7\\end{bmatrix}" :db/id #edb/ref 17592186347399}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186345647} :answer-field/id #uuid "e4d0c9e7-8b7e-5689-a456-e913f44eca5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348004}] :question/id #uuid "48f981b1-9aeb-5e6b-818c-36bd836ee49e" :question/math-academy-id "q-80455" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}7 & -12 \\\\ 4 & -7\\end{bmatrix}$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7-\\lambda  & -12 \\\\ 4 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(-7-\\lambda )-4\\cdot (-12) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186379810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf3be306-cf4b-505f-9749-8c4d421cf8bb" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186379812} {:answer/id #uuid "675738a1-186a-5034-b012-faa1a6463030" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186379813} {:answer/id #uuid "b2d147f9-5e98-5cd7-a62a-3b200ed85486" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186379814} {:answer/id #uuid "40744a34-ee79-5f47-96a8-dad2d3f736ed" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}-2 & 0 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186379815} {:answer/id #uuid "b7371e87-7e47-503f-b703-0bb0dbb9110d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186379816}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186379816} :answer-field/id #uuid "95cac241-a6a2-5133-bd5b-0bc96d341951" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379811}] :question/id #uuid "e3ab5a48-4ec0-5b84-8cff-a429fb97fc59" :question/math-academy-id "q-37631" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}-2 & 3 \\\\ -3 & 4\\end{bmatrix}$\nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-2-\\lambda  & 3 \\\\ -3 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (-2-\\lambda )(4-\\lambda )-(3)(-3) & =0 \\\\ {\\lambda }^{2}-2\\lambda +1 & =0 \\\\ (\\lambda -1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=1.$ Since we get one repeated eigenvalue, the matrix might not be diagonalizable. To check this, we row-reduce the matrix $(A-1I)\\text{x}=0:$ \n\n$$\n\\begin{aligned}A-1I & =\\begin{bmatrix}-2 & 3 \\\\ -3 & 4\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 3 \\\\ -3 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 3 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has only $1$ pivot column. This implies that we will have only $2-1=1$ linearly independent eigenvector corresponding to the current eigenvalue. Therefore, $A$ is not diagonalizable."} {:db/id #edb/ref 17592186455441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "310d49af-1694-516d-bd51-3515b36d8de3" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186454979} {:answer/id #uuid "7054bc25-ecf8-5bad-9c21-999a77440142" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186455111} {:answer/id #uuid "89923f74-469b-51f3-b20e-5d752974d11c" :answer/type {:db/ident :answer.type/text} :answer/value "$A$\n is not diagonalizable" :db/id #edb/ref 17592186455152} {:answer/id #uuid "c49667d5-80f0-5ca4-aac6-19c3737abddf" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}3 & 0 \\\\ 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186455241} {:answer/id #uuid "e6400608-0a28-5066-8778-f9b97a7687e6" :answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186455302}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186455302} :answer-field/id #uuid "c4ed917e-4479-55fb-ae93-f553e926f059" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455407}] :question/id #uuid "3a4040a9-af29-5df2-8d92-a7f8acbeb04b" :question/math-academy-id "q-80451" :question/problem "Determine if the matrix \n$A=\\begin{bmatrix}3 & -4 \\\\ 2 & -3\\end{bmatrix}$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3-\\lambda  & -4 \\\\ 2 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (3-\\lambda )(-3-\\lambda )-2\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}\n$$"}] :knowledge-point/title "Identifying Whether a Given 2x2 Matrix Is Diagonalizable"} {:db/id #edb/ref 17592186124600 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124412 :question/id #uuid "854f39a0-99b3-59f3-a9d7-4909850254ad" :question/math-academy-id "e-8573" :question/problem "Consider the following matrices:\n![](images/6e/6e51c22c33c32d52c51657552a3c174d706a316ec10c78a4a953d2fcebc304ff.svg)\nGiven that $D=P^{-1}AP,$ find the value of $\\dfrac{a}{b}.$" :question/worked-solution "From the diagonal matrix ![](images/0e/0e25fe1b46b828e6fac168d1755af7aed9a7c3f657d1a6d6677fd71746b7ce31.svg) we deduce that the eigenvalues of $A$ are $\\lambda_1=5$ and $\\lambda_2=-1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue $\\lambda_2=-1.$ \n\nNow, we simply need to find an eigenvector that corresponds to $\\lambda_2=-1.$ Computing $A-(-1)I,$ we get  \n\n$$\n\\begin{aligned}A-(-1)I & =\\begin{bmatrix}1 & 4 \\\\ 2 & 3\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 2 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTo solve the corresponding system of linear equations, we construct the augmented matrix $M$ and reduce it to its row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 4 & 0 \\\\ 2 & 4 & 0\\end{bmatrix} & {R}_{2}={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 4 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). So, $x_2$ is a free variable. From the first equation, we obtain $x_1= -{2}x_2.$ Therefore, the general solution is\n\n![](images/54/54dad1c9d747fead6f27dd0e9af7cca434c40a83d56c02c854bb610a1cdc6087.svg)\n\nBy setting $x_2=1,$ we get the eigenvector \n\n![](images/d2/d28cf572126716928bc9ded7c2646871540e20b1d93d1efc929599b4c379d38b.svg)\n\nFinally, $\\dfrac{a}{b}=\\dfrac{-2}{1} = -2.$"} :knowledge-point/id #uuid "ca18fa52-5494-53ad-bd02-208aba4ff9e1" :knowledge-point/questions [{:db/id #edb/ref 17592186125019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3641611f-7342-59e6-8eb1-e3d5c19f0c92" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186436957} {:answer/id #uuid "861930b1-88a9-5573-b1ac-9183d339e59f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186436958} {:answer/id #uuid "dfbfaed1-b369-5612-a2fa-36c8475ceb47" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186436959} {:answer/id #uuid "f9984cb1-95b5-56e2-9b37-0c405c4cefee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186436960} {:answer/id #uuid "fad88501-95d6-5d04-967e-1baa7d034ba2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186436961}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186436961} :answer-field/id #uuid "5ca34d82-cd28-5172-85b5-f4d4887562de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122714}] :question/id #uuid "47e69096-fce9-5678-91d0-dfdd65324d6f" :question/math-academy-id "q-36908" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-5 & -2 \\\\ 12 & 5\\end{bmatrix},\\,D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix},\\,P=\\begin{bmatrix}1 & ∗ \\\\ -3 & ∗\\end{bmatrix}\n$$\n\nGiven that $A=PD{P}^{-1},$ find the second column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=-1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=-1.$ Computing $A-(-1)I,$ we get\n\n$$\n\\begin{aligned}A-(-1)I & =\\begin{bmatrix}-5 & -2 \\\\ 12 & 5\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -2 \\\\ 12 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-4 & -2 & 0 \\\\ 12 & 6 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix}.$"} {:db/id #edb/ref 17592186125030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103a0ee6-425a-5938-bce0-fcc173a3e918" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186321275} {:answer/id #uuid "668e70e3-2ea5-54e9-918a-b5c0bf9f0e71" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321947} {:answer/id #uuid "8b37b168-9fc9-5d13-a974-32fb42758935" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186322256} {:answer/id #uuid "d5716a39-49e8-5073-bc6a-fccb2c751ff8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322811} {:answer/id #uuid "f84527ee-2a57-5b8b-b699-d4d40d052100" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186323098}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321947} :answer-field/id #uuid "d86e2831-36d1-54fc-8101-8f79b6a39517" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323596}] :question/id #uuid "6f7410b2-d03a-51b8-bc6b-c6a21e9f2fab" :question/math-academy-id "q-37084" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-1 & 2 \\\\ -6 & 6\\end{bmatrix},\\,D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\\,P=\\begin{bmatrix}2 & a \\\\ 3 & b\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{b}{a}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=3.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=3.$ Computing $A-3I,$ we get\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}-1 & 2 \\\\ -6 & 6\\end{bmatrix}-(3)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 2 \\\\ -6 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-4 & 2 & 0 \\\\ -6 & 3 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & 2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, $\\frac{b}{a}=\\frac{2}{1}=2.$"} {:db/id #edb/ref 17592186272010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd3b6b2-8695-58ae-867a-70b53f4716fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186269960} {:answer/id #uuid "9a773184-8047-519c-8aca-e809911c8384" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186270629} {:answer/id #uuid "a0efa869-66c9-5bbb-b1ee-966b5e13aac7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186270697} {:answer/id #uuid "aa0dc842-0f49-50e2-805c-390eeb6436fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186270784} {:answer/id #uuid "c2f58987-17f6-5783-b0fd-6fa8385a0a24" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186270993}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186270629} :answer-field/id #uuid "1dd329eb-2da0-50d3-b69d-c7c5c346483a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271563}] :question/id #uuid "12acb09d-bf22-5557-b390-5a28b66175ba" :question/math-academy-id "q-140045" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}0 & -2 \\\\ 6 & 7\\end{bmatrix},\\,D=\\begin{bmatrix}3 & 0 \\\\ 0 & 4\\end{bmatrix},\\,P=\\begin{bmatrix}∗ & 1 \\\\ ∗ & -2\\end{bmatrix}\n$$\n\nGiven that $A=PD{P}^{-1},$ find the first column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}3 & 0 \\\\ 0 & 4\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=4.$\n\nSo, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=3.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=3.$ Computing $A-3I,$ we get\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}0 & -2 \\\\ 6 & 7\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -2 \\\\ 6 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & -2 & 0 \\\\ 6 & 4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & -2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{2}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=3,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}-2 & 1 \\\\ 3 & -2\\end{bmatrix}.$"} {:db/id #edb/ref 17592186272015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b5f320c-678c-588f-97ca-59e7f48ab67f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270224} {:answer/id #uuid "e976cf72-85c5-52fb-8497-4a6b96dccdff" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271311} {:answer/id #uuid "e9961cc7-e783-51ec-bc2d-47d357514968" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186271315} {:answer/id #uuid "f4309c69-9db1-5dc4-aa51-0b57a127e2e4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186271410} {:answer/id #uuid "fb64b1dd-5faf-5d58-a38e-7a3c3bf0ddab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186271471}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271311} :answer-field/id #uuid "1a6aca89-aa2e-56f0-bbd1-0f5adf3139d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271556}] :question/id #uuid "472ad991-cd49-54f3-aa78-cfe11b836a0b" :question/math-academy-id "q-140053" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-7 & 15 \\\\ -3 & 7\\end{bmatrix},\\,D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}a & 5 \\\\ b & 3\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of  $\\frac{a}{b}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=2.$\n\nSo, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=-2.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=-2.$ Computing $A-(-2)I,$ we get \n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-7 & 15 \\\\ -3 & 7\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 15 \\\\ -3 & 9\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-5 & 15 & 0 \\\\ -3 & 9 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{3}{5}){R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 15 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=3{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}3{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $\\frac{a}{b}=\\frac{3}{1}=3.$"} {:db/id #edb/ref 17592186323879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f67d4d-da60-5c1d-a0bc-6098c4b59d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186321858} {:answer/id #uuid "644eb4a6-08cb-5b36-974b-0f1ea245e3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186321927} {:answer/id #uuid "e5d358db-0a23-538d-91cd-e66afdc66066" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186322945} {:answer/id #uuid "eb675bd2-5461-512d-a089-4333018043e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186322990} {:answer/id #uuid "f0d06a25-57de-5a3d-b337-80f3da1872c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186323042}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186322945} :answer-field/id #uuid "e9562e9f-71e2-5989-9818-065f99962258" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323628}] :question/id #uuid "c8414ec3-653a-5f7c-8a93-649341523a40" :question/math-academy-id "q-37105" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}2 & 1 \\\\ 2 & 3\\end{bmatrix},\\,D=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}1 & ∗ \\\\ 2 & ∗\\end{bmatrix}\n$$\n\nGiven that $A=PD{P}^{-1},$ find the second column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=1.$ \n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=1.$ Computing $A-(1)I,$ we get\n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}2 & 1 \\\\ 2 & 3\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 0 \\\\ 2 & 2 & 0\\end{bmatrix} & {R}_{2}={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-{x}_{2}.$ Hence, the general solution is \n\n$$\n\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186323881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d029107-e148-55f6-a354-f22baa574250" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321621} {:answer/id #uuid "56d1c400-959f-56c2-965a-3832f8ef8340" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186321833} {:answer/id #uuid "bcf1e1f5-79f6-557b-a763-a51889feac40" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186322613} {:answer/id #uuid "c23b64d9-c049-5e10-af78-713101e3ae50" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186322654} {:answer/id #uuid "db767106-a9b0-5dd4-8b49-d91b65e0543f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322867}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186322654} :answer-field/id #uuid "79947e83-1100-52b3-a7fb-76ec24310ce3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323408}] :question/id #uuid "334a7a7c-883e-54c4-9c3a-6e918b1922ab" :question/math-academy-id "q-37107" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}2 & 3 \\\\ -6 & -7\\end{bmatrix},\\,D=\\begin{bmatrix}-4 & 0 \\\\ 0 & -1\\end{bmatrix},\\,P=\\begin{bmatrix}a & -1 \\\\ b & 1\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of  $\\frac{b}{a}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-4 & 0 \\\\ 0 & -1\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=-1.$\n\nSo, the  first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=-4.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=-4.$ Computing $A-(-4)I,$ we get \n\n$$\n\\begin{aligned}A-(-4)I & =\\begin{bmatrix}2 & 3 \\\\ -6 & -7\\end{bmatrix}-(-4)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 3 \\\\ -6 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & 3 & 0 \\\\ -6 & -3 & 0\\end{bmatrix} & {R}_{2} & :={R}_{1}+{R}_{2} \\\\  & ∼\\begin{bmatrix}6 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, $\\frac{b}{a}=\\frac{2}{-1}=-2.$"} {:db/id #edb/ref 17592186323882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e74244-76d5-5343-aca6-e7bd59feee49" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186321581} {:answer/id #uuid "4cf11105-9dd4-5e81-99c6-0f8f67e497ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186321755} {:answer/id #uuid "75160b3c-6e20-57fe-b349-766ce20c700e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186322060} {:answer/id #uuid "dab06ec1-2cd0-5fdf-b518-39c2bef4dd3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186322858} {:answer/id #uuid "e1f9a34b-5bad-564b-910d-f9c95d4e1493" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186322914}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186321755} :answer-field/id #uuid "de0c8b55-2245-569b-a6f7-434321067ed8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323613}] :question/id #uuid "c4c8798a-e8e3-519c-a948-2cb26050a7a1" :question/math-academy-id "q-37108" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-3 & -1 \\\\ 2 & 0\\end{bmatrix},\\,D=\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix},\\,P=\\begin{bmatrix}∗ & 1 \\\\ ∗ & -1\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$   find the first column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-1 & 0 \\\\ 0 & -2\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=-2.$  \n\nSo, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=-1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=-1.$ Computing $A-(-1)I,$ we get\n\n$$\n\\begin{aligned}A-(-1)I & =\\begin{bmatrix}-3 & -1 \\\\ 2 & 0\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & -1 & 0 \\\\ 2 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{1}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}-1 & 1 \\\\ 2 & -1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186348385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8c9e06-d8ae-5b56-87fa-d193f49862c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186345441} {:answer/id #uuid "0c863166-9cde-57a3-b525-89715e7fd2d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186345451} {:answer/id #uuid "5df2083d-0b34-5602-9a2e-0b5d540399d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186346156} {:answer/id #uuid "67384bda-af12-51f5-bf18-dd464a3c284f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186346252} {:answer/id #uuid "dfbcefbd-0399-5ebb-bb41-0834541c3e3e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347318}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186345441} :answer-field/id #uuid "e1b637f7-e306-5fcc-b86b-b1740751a32c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347999}] :question/id #uuid "4f9c3543-a306-5635-8fa9-149cba24aebf" :question/math-academy-id "q-80457" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-8 & 6 \\\\ -9 & 7\\end{bmatrix},\\,D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}1 & a \\\\ 1 & b\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{a}{b}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 1\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=1.$ Computing $A-I,$ we get\n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}-8 & 6 \\\\ -9 & 7\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & 6 \\\\ -9 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-9 & 6 & 0 \\\\ -9 & 6 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}-9 & 6 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{2}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=3,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}.\n$$\n\nFinally, $\\frac{a}{b}=\\frac{2}{3}.$"} {:db/id #edb/ref 17592186348386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23eb77f1-0e91-52e4-864a-64f967a5f81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186345681} {:answer/id #uuid "411b41a4-cb56-5a2a-8bf6-a80d60ebef3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186345906} {:answer/id #uuid "6f129a85-6061-559c-9942-91cfaebe0413" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186346320} {:answer/id #uuid "e106c51b-5c56-5572-9d78-9db1ec5c888f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186347328} {:answer/id #uuid "ef7a5767-5b9a-586e-aad3-82de158dd8c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186347464}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186345681} :answer-field/id #uuid "53101c00-775a-58ab-9d6f-9cee81265c57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347752}] :question/id #uuid "455fd380-72f1-5a0f-82f0-362abef14cc0" :question/math-academy-id "q-80458" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}10 & -12 \\\\ 8 & -10\\end{bmatrix},\\,D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}-1 & ∗ \\\\ -1 & ∗\\end{bmatrix}\n$$\n\nGiven that $A=PD{P}^{-1},$ find the second column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=2.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=2.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=2.$ Computing $A-2I,$ we get\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}10 & -12 \\\\ 8 & -10\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & -12 \\\\ 8 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}8 & -12 & 0 \\\\ 8 & -12 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\begin{bmatrix}8 & -12 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{3}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=2,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}-1 & 3 \\\\ -1 & 2\\end{bmatrix}.$"} {:db/id #edb/ref 17592186348389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e63821f-3c2e-5f90-999d-3556766249b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186345617} {:answer/id #uuid "41d1a660-210a-538d-a83e-3694472cfec3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186345914} {:answer/id #uuid "941da20b-d6b9-5332-879f-51c1830cdd52" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186346644} {:answer/id #uuid "e63b7ab8-5e9a-5b89-94b9-a182e32d7d2c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186347381} {:answer/id #uuid "fd8851cf-bb44-563a-8b2f-b5f9da98356d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186347582}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186347381} :answer-field/id #uuid "7c777445-6342-54ff-86ad-194f947964f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347826}] :question/id #uuid "93fc1e8e-53c7-5d4c-ad22-c729f51f630d" :question/math-academy-id "q-80464" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}8 & -12 \\\\ 6 & -10\\end{bmatrix},\\,D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}2 & a \\\\ 2 & b\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{a}{b}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 2\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=2.$ \n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=2.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=2.$ Computing $A-2I,$ we get \n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}8 & -12 \\\\ 6 & -10\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -12 \\\\ 6 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -12 \\\\ 6 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}6 & -12 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=2{x}_{2}.$ Hence, the general solution is \n\n$$\n\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $\\frac{a}{b}=\\frac{2}{1}=2.$"} {:db/id #edb/ref 17592186348390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22119e56-c2ad-5a1f-93f1-c04eaa3ac558" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186345655} {:answer/id #uuid "3782c6fe-ebb2-5079-8ffa-810d46fce101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186345827} {:answer/id #uuid "3fc5451d-dbc7-586b-952c-b8e13d6d975e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186345897} {:answer/id #uuid "87b07bf0-75b2-55bd-ad22-0f720c68ed7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186346527} {:answer/id #uuid "c466e656-ab0e-57e9-9344-25a7c9097ab9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186347048}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186345897} :answer-field/id #uuid "20ed30e7-fd60-571b-8fae-197d05a44a20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347660}] :question/id #uuid "cb9e7fcc-e638-502e-8bf0-7fbc40ad862a" :question/math-academy-id "q-80465" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}-5 & 2 \\\\ -12 & 5\\end{bmatrix},\\,D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}-1 & a \\\\ -2 & b\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$ find the value of $\\frac{b}{a}.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}$, we deduce that the eigenvalues of $A$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$\n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=1.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{2}=1.$ Computing $A-I,$ we get \n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}-5 & 2 \\\\ -12 & 5\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 2 \\\\ -12 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-6 & 2 & 0 \\\\ -12 & 4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{3}{x}_{2}.$  Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=3,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}a \\\\ b\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.\n$$\n\nFinally, $\\frac{b}{a}=\\frac{3}{1}=3.$"} {:db/id #edb/ref 17592186399124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b30d639-ee9f-5dd6-a783-78b787a8dd54" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186399126} {:answer/id #uuid "f91f8571-a85e-5261-a33d-4e0eb8050300" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186399127} {:answer/id #uuid "931df98b-abe6-5c33-9026-a64e621c7860" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186399128} {:answer/id #uuid "b46fbb27-12de-55de-8760-7556c63e5e1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186399129} {:answer/id #uuid "3a9bca69-8e29-54e8-841b-6cdbc3697e78" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186399130}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186399127} :answer-field/id #uuid "a57196c6-f2e4-585a-92ce-6d08ae5e8dd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399125}] :question/id #uuid "912d4ab2-e55a-5e9a-8ddf-b1e59d14eb18" :question/math-academy-id "q-80467" :question/problem "Consider the following matrices:\n\n$$\nA=\\begin{bmatrix}7 & -8 \\\\ 4 & -5\\end{bmatrix},\\,D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix},\\,P=\\begin{bmatrix}∗ & 1 \\\\ ∗ & 1\\end{bmatrix}\n$$\n\nGiven that $D={P}^{-1}AP,$   find the first column of the matrix $P.$" :question/worked-solution "From the diagonal matrix $D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}$, we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=-1.$  \n\nSo, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=3.$ \n\nNow, we simply need to find an eigenvector that corresponds to ${\\lambda }_{1}=3.$ Computing $A-3I,$ we get \n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}7 & -8 \\\\ 4 & -5\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -8 \\\\ 4 & -8\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & -8 & 0 \\\\ 4 & -8 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}4 & -8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=2{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}2{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.\n$$\n\nFinally, $P=\\begin{bmatrix}2 & 1 \\\\ 1 & 1\\end{bmatrix}.$"}] :knowledge-point/title "Diagonalizing a 2x2 Matrix Given Part of the Diagonalization"} {:db/id #edb/ref 17592186124601 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124413 :question/id #uuid "cb76e9dc-1195-58d3-8e58-a3421770265a" :question/math-academy-id "e-8574" :question/problem "Given the matrix \n![](images/3d/3da867d461c2b42c21badd67ce59c9ec5f6448597b4d2dcbb7e8b28ffe397768.svg) \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D=P^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm. \n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$$\n\\lambda_1=3, \\quad\\quad\\lambda_2=-2.\n$$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For $\\lambda_1=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}3 & -8 \\\\ 0 & -2\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -8 \\\\ 0 & -5\\end{bmatrix}.\\end{aligned}\n$$\n\nTo solve the corresponding system of linear equations, we construct the augmented matrix $M$ and reduce it to its row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & -8 & 0 \\\\ 0 & -5 & 0\\end{bmatrix} & {R}_{2}={R}_{2}+(-\\frac{5}{8}){R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). So, $x_1$ is a free variable. From the first equation, we obtain $x_2=0.$ Therefore, the general solution is\n![](images/04/04f6efaa2bb141940040a04905e52aacd7aa739e1bd58dd71666a10543ff0f74.svg)\nSetting $x_1=1,$ we get the eigenvector ![](images/dd/dd78cbf2025fdf012dc27429596c84be09825b436c32a5410f50f78cd4943a66.svg)\n\n- For $\\lambda_2=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}3 & -8 \\\\ 0 & -2\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -8 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe above matrix corresponds to a homogeneous system of linear equations. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). So, $x_2$ is a free variable. From the first equation, we obtain $x_1=\\dfrac{8}{5}x_2.$ Therefore, the general solution is\n![](images/5b/5b5b06d4cd243ca0370807b58bc9d0da68f34aa008956016bab3da29377df219.svg)\nSetting  $x_2=5,$ we get the eigenvector  ![](images/3e/3ea698aa474cb6d28b3fb511215fbe5da7d01b6653e884719d99483eac5635a0.svg)\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n![](images/b7/b736228d68ad58b430f707236014be76e0354bf42ff9fcd73c495a077835bad7.svg)"} :knowledge-point/id #uuid "0ff6446e-7913-5d55-adfd-124649f3f1c0" :knowledge-point/questions [{:db/id #edb/ref 17592186125031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f690a5-c6b6-567b-8c02-64e3ea56e2ae" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321563} {:answer/id #uuid "37d1a64e-32e1-5dfc-a03c-e9e720792026" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321573} {:answer/id #uuid "382c1f8e-b7a5-5a68-a5ef-3a36a01c230d" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 0 \\\\ -3 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186321576} {:answer/id #uuid "7fe79fd3-0bc8-50de-87b4-7a5b6efdc4ab" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186322151} {:answer/id #uuid "bb31376f-ca89-5694-bb2d-1ccdc86d4587" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186322599}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186322151} :answer-field/id #uuid "14470c10-fd68-562b-b327-3fe6aab431f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323207}] :question/id #uuid "f2c822bf-c206-5550-8452-95d9e9a3c934" :question/math-academy-id "q-37086" :question/problem "Given the matrix \n$A=\\begin{bmatrix}-1 & -6 \\\\ 0 & 3\\end{bmatrix}$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=-1\\,$ and $\\,{\\lambda }_{2}=3$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=-1,$ we have\n\n$$\n\\begin{aligned}A-(-1)I & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 3\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -6 \\\\ 0 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & -6 & 0 \\\\ 0 & 4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -6 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}-1 & -6 \\\\ 0 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & -6 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{3}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=2,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix},\\,P=\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186125092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c312655f-d112-51f2-aeab-369b01d81925" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}$\nand\n$P = \\begin{bmatrix}-1 & 5 \\\\ -4 & 3\\end{bmatrix}$." :db/id #edb/ref 17592186123153} {:answer/id #uuid "ca487d26-e9f4-55a6-8f3a-669576a0147c" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}$\nand\n$P = \\begin{bmatrix}5 & -1 \\\\ 3 & -4\\end{bmatrix}$" :db/id #edb/ref 17592186123154} {:answer/id #uuid "2ac76635-dc48-59ad-9bd2-681ff8480da4" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}$\nand\n$P = \\begin{bmatrix}-2 & -2 \\\\ 1 & 3\\end{bmatrix}$." :db/id #edb/ref 17592186123155} {:answer/id #uuid "59486a8f-d0a9-5376-9b20-4a312adcf6e8" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ is not diagonalizable" :db/id #edb/ref 17592186123156} {:answer/id #uuid "701d44c3-7e08-50c7-971c-f1dc0d8de04b" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}-3 & 0 \\\\ 0 & 5\\end{bmatrix}$\nand\n$P = \\begin{bmatrix}-2 & 2 \\\\ 1 & 3\\end{bmatrix}$." :db/id #edb/ref 17592186123157}] :answer-field/id #uuid "ead8e09b-2e7f-501f-9a59-76344cc98b2e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123152} {:answer-field/choices [{:answer/id #uuid "65dcb148-59f0-5313-bfaf-df297334b567" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-2 & 2 \\\\ 1 & 3\\end{bmatrix}.$" :db/id #edb/ref 17592186402563} {:answer/id #uuid "01ddf820-2205-5e7a-9d10-71b0eb004cd4" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ is not diagonalizable" :db/id #edb/ref 17592186402564} {:answer/id #uuid "93899d98-3ed8-57ef-bf1d-2dddc426b93a" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}5 & -1 \\\\ 3 & -4\\end{bmatrix}$" :db/id #edb/ref 17592186402565} {:answer/id #uuid "6c51ec3b-7e06-5f6f-b71e-693f1baf9b77" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-2 & -2 \\\\ 1 & 3\\end{bmatrix}.$" :db/id #edb/ref 17592186402566} {:answer/id #uuid "ce670c05-f90c-5e88-b0de-6c8db4a1b1ca" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-1 & 5 \\\\ -4 & 3\\end{bmatrix}.$" :db/id #edb/ref 17592186402567}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-2 & -2 \\\\ 1 & 3\\end{bmatrix}.$" :db/id #edb/ref 17592186402566} :answer-field/id #uuid "73351dd7-a011-5e4a-928b-79ab1f200817" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402562}] :question/id #uuid "4f978364-b49e-551e-8d94-9dbc6a1be095" :question/math-academy-id "q-37634" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=\\begin{bmatrix}9 & 8 \\\\ -6 & -7\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}9-\\lambda  & 8 \\\\ -6 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(-7-\\lambda )-8\\cdot (-6) & =0 \\\\ {\\lambda }^{2}-2\\lambda -15 & =0 \\\\ (\\lambda -5)(\\lambda +3) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-3.$\n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=5,$ we have\n\n$$\n\\begin{aligned}B-5I & =\\begin{bmatrix}9 & 8 \\\\ -6 & -7\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 8 \\\\ -6 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}4 & 8 & 0 \\\\ -6 & -12 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(\\frac{3}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-2{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-3,$ we have\n\n$$\n\\begin{aligned}B-(-3)I & =\\begin{bmatrix}9 & 8 \\\\ -6 & -7\\end{bmatrix}-(-3)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 8 \\\\ -6 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}12 & 8 & 0 \\\\ -6 & -4 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}12 & 8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{2}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=3,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix},\\,P=\\begin{bmatrix}-2 & -2 \\\\ 1 & 3\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186272016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "434859e0-5b7a-524b-8296-6aa41ec7669b" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 4 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186269876} {:answer/id #uuid "a69d7ffb-2348-53e1-80d7-c6077d248e3b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ is not diagonalizable" :db/id #edb/ref 17592186270760} {:answer/id #uuid "d6221acf-c2d5-5c9e-a305-28c990e86077" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}3 & 4 \\\\ 1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186271145} {:answer/id #uuid "ee44e5bf-b05a-55c0-9931-0fe57e147573" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}3 & 1 \\\\ 4 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186271359} {:answer/id #uuid "fd1e6265-66d6-501e-844e-d925219ae749" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}4 & 3 \\\\ 1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186271483}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}3 & 1 \\\\ 4 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186271359} :answer-field/id #uuid "aaf04191-f697-50a2-b21d-5e1af7e197d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271818}] :question/id #uuid "0f3dda67-4437-5ed9-8f86-30b8b0141d47" :question/math-academy-id "q-140054" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=\\begin{bmatrix}7 & -6 \\\\ 8 & -7\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}7-\\lambda  & -6 \\\\ 8 & -7-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(-7-\\lambda )-(-6)\\cdot 8 & =0 \\\\ {\\lambda }^{2}-49+48 & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$\n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=-1,$ we have\n\n$$\n\\begin{aligned}B-(-1)I & =\\begin{bmatrix}7 & -6 \\\\ 8 & -7\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & -6 \\\\ 8 & -6\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}8 & -6 & 0 \\\\ 8 & -6 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}8 & -6 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{3}{4}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{3}{4}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=4,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}B-1I & =\\begin{bmatrix}7 & -6 \\\\ 8 & -7\\end{bmatrix}-1\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -6 \\\\ 8 & -8\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & -6 & 0 \\\\ 8 & -8 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(-\\frac{4}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}6 & -6 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}3 & 1 \\\\ 4 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186272017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fb2c017-ef7c-5ba2-afc6-3d49f787a173" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186269695} {:answer/id #uuid "2fe63540-653a-5f9d-826c-5fd5fdd3da4b" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-5 & 1 \\\\ 4 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186269699} {:answer/id #uuid "683db4a2-0071-5323-aaf1-36dc9f4657ee" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -1 \\\\ 2 & 4\\end{bmatrix}$" :db/id #edb/ref 17592186270195} {:answer/id #uuid "8d822556-fb48-56fe-97f9-e7ca4116ed18" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & -5 \\\\ 0 & 4\\end{bmatrix}$" :db/id #edb/ref 17592186270493} {:answer/id #uuid "d6caa0d3-4ac7-51e7-885a-020b3cb9734d" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 5\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-1 & 1 \\\\ 4 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186271153}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}-5 & 1 \\\\ 4 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186269699} :answer-field/id #uuid "82b09bd5-bdad-576d-9065-d5221902f62e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271738}] :question/id #uuid "87fb53ab-c39f-5a55-a74a-94392695acc9" :question/math-academy-id "q-140055" :question/problem "Given the matrix \n$A=\\begin{bmatrix}2 & 5 \\\\ 0 & -2\\end{bmatrix}$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=-2\\,$ and $\\,{\\lambda }_{2}=2$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}2 & 5 \\\\ 0 & -2\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 5 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{5}{4}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{5}{4}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=4,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=2,$ we have\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}2 & 5 \\\\ 0 & -2\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 5 \\\\ 0 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & 5 & 0 \\\\ 0 & -4 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{4}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & 5 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}-5 & 1 \\\\ 4 & 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186323862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0713052e-de4e-5bf8-afbf-008302f5385c" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321203} {:answer/id #uuid "3221c029-f684-54d9-b3bd-e5cf4c6153e8" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and \n$P=\\begin{bmatrix}2 & -2 \\\\ -1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321528} {:answer/id #uuid "3daa8072-7a21-5582-abcd-0505e4d15ec1" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and \n$P=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321629} {:answer/id #uuid "7a5499f1-f85d-5010-bd19-7ee376b8965f" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and \n$P=\\begin{bmatrix}1 & -1 \\\\ 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186322105} {:answer/id #uuid "c8ab44d6-ca5f-50d5-9803-59def76d6319" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and \n$P=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186322706}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and \n$P=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321629} :answer-field/id #uuid "7c964b22-931a-56cc-b301-7b0924f71019" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323415}] :question/id #uuid "89d5c71a-da80-52ee-a231-7f2e6857a315" :question/math-academy-id "q-36914" :question/problem "Given the matrix \n$A=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=2\\,$ and $\\,{\\lambda }_{2}=3$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=2,$ we have\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -1 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & -1 & 0 \\\\ 0 & 1 & 0\\end{bmatrix} & {R}_{2}={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -1 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=3.$ Then\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -1 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. On the other hand, from the first equation, we obtain ${x}_{1}=-{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows: \n\n$$\nD=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\\,P=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186323923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a40dfb-f5fb-5a03-91a7-67d5b50e2c1b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186321586} {:answer/id #uuid "42a07f5d-91e9-5805-a0c2-cc05cc5065db" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 4\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}0 & 1 \\\\ 1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321675} {:answer/id #uuid "6627dac0-8aa6-5c00-aa71-b20a0ef62004" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321938} {:answer/id #uuid "c840ee09-15a6-500d-a880-9fb9b42776c9" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 4\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186322700} {:answer/id #uuid "df744e3a-e5ca-59e6-a410-6bbb5cdddc93" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186322894}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321938} :answer-field/id #uuid "3378505f-63b2-5e06-9d7e-9f7ac4c9618b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323273}] :question/id #uuid "67c100f5-0b85-5947-a038-3b4c63f6e781" :question/math-academy-id "q-37608" :question/problem "Given the matrix \n$A=\\begin{bmatrix}4 & -3 \\\\ 0 & 1\\end{bmatrix}$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal:  \n\n$\\,$ ${\\lambda }_{1}=4\\,$ and $\\,{\\lambda }_{2}=1$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=4,$ we have\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}4 & -3 \\\\ 0 & 1\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -3 \\\\ 0 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & -3 & 0 \\\\ 0 & -3 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}4 & -3 \\\\ 0 & 1\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is \n\n$$\n\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows: \n\n$$\nD=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix},\\,P=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186348394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a5c262-cc22-5983-a61f-511098951290" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}$ and $P=\\begin{bmatrix}3 & -1 \\\\ -1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186345372} {:answer/id #uuid "9fa8ba48-0f15-5b2c-84b8-a833da307fbc" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -1 \\\\ -2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186346746} {:answer/id #uuid "a9910791-e486-5fd3-bb75-79cd1d4e8819" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}3 & -1 \\\\ -2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186346831} {:answer/id #uuid "ae3d5ea0-19f6-5122-82a9-c2add49ba24b" :answer/type {:db/ident :answer.type/text} :answer/value "$E$ is not diagonalizable" :db/id #edb/ref 17592186346871} {:answer/id #uuid "dfb53f77-ac95-5079-afcd-085b46b877ac" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}$ and $P=\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186347317}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}3 & -1 \\\\ -2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186346831} :answer-field/id #uuid "530dc008-9954-52d4-b786-4fab0747c350" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347751}] :question/id #uuid "050f4d1f-7ad3-50e3-a5b8-1b02cf764a27" :question/math-academy-id "q-80480" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=E,$ where $D$ is a diagonal matrix and $E=\\begin{bmatrix}7 & 9 \\\\ -6 & -8\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm. \n\n**Step 1.** We need to find the eigenvalues of the matrix $E$ using its characteristic equation $det(E-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}7-\\lambda  & 9 \\\\ -6 & -8-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(-8-\\lambda )-9\\cdot (-6) & =0 \\\\ {\\lambda }^{2}+\\lambda -2 & =0 \\\\ (\\lambda -1)(\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $E$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-2.$\n\n**Step 2.** Now, we need to find an eigenvector basis of $E.$\n\n- For ${\\lambda }_{1}=1,$ we have\n\n$$\n\\begin{aligned}E-I & =\\begin{bmatrix}7 & 9 \\\\ -6 & -8\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 9 \\\\ -6 & -9\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}6 & 9 & 0 \\\\ -6 & -9 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}6 & 9 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{3}{2}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-\\frac{3}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=-2,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-2,$ we have\n\n$$\n\\begin{aligned}E-(-2)I & =\\begin{bmatrix}7 & 9 \\\\ -6 & -8\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 9 \\\\ -6 & -6\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}9 & 9 & 0 \\\\ -6 & -6 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(\\frac{2}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}9 & 9 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix},\\,P=\\begin{bmatrix}3 & -1 \\\\ -2 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186348395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11280adc-f2f4-556c-b831-fa0db135b14c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 1 \\\\ -1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186345497} {:answer/id #uuid "1ffa557c-011d-5935-9b8b-5915bca53803" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}-2 & 3 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186345632} {:answer/id #uuid "7c960909-d4c7-5e14-a91b-458618e40e5c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186346438} {:answer/id #uuid "a4362130-7316-50c8-8cb6-e9d65c6826e5" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 0 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186346776} {:answer/id #uuid "e1f20dbd-46e0-518a-8886-732ddab5d7c2" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186347334}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix}$ and\n$P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186347334} :answer-field/id #uuid "28c2da63-7f18-51f5-bf93-3312d17f056a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347670}] :question/id #uuid "cac09b37-360a-5efb-9630-b76644cac8f9" :question/math-academy-id "q-80481" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1-\\lambda  & 2 \\\\ -1 & -2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(-2-\\lambda )-2\\cdot (-1) & =0 \\\\ {\\lambda }^{2}+\\lambda  & =0 \\\\ \\lambda (\\lambda +1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=-1.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=0,$ we have\n\n$$\n\\begin{aligned}B-0I & =\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 0 \\\\ -1 & -2 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-2{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=-1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-1,$ we have\n\n$$\n\\begin{aligned}B-(-1)I & =\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 2 & 0 \\\\ -1 & -1 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=-1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}0 & 0 \\\\ 0 & -1\\end{bmatrix},\\,P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186402523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4a6755d-80bd-5611-a557-59ce2c3c6557" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 4\\end{bmatrix}$ and \n$P=\\begin{bmatrix}4 & -2 \\\\ 3 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186402525} {:answer/id #uuid "e5dd66e7-ae53-5b28-9e79-614c071a936b" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix}$ and \n$P=\\begin{bmatrix}4 & -2 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186402526} {:answer/id #uuid "9dd50123-6242-511d-b159-5c464286ace9" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 6\\end{bmatrix}$ and \n$P=\\begin{bmatrix}-4 & 2 \\\\ 3 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186402527} {:answer/id #uuid "dae85668-9796-5178-b243-6fa5585b42bb" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 6\\end{bmatrix}$  and \n$P=\\begin{bmatrix}4 & 2 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186402528} {:answer/id #uuid "7543e93c-1834-59e6-825e-f87499d53fa3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ is not diagonalizable" :db/id #edb/ref 17592186402529}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-4 & 0 \\\\ 0 & 6\\end{bmatrix}$  and \n$P=\\begin{bmatrix}4 & 2 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186402528} :answer-field/id #uuid "c165be63-7aaf-561e-9d48-4500807ec533" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402524}] :question/id #uuid "73d12e91-b996-5b04-bc26-e6f1ba8817f0" :question/math-academy-id "q-37088" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix and $A=\\begin{bmatrix}-6 & 8 \\\\ -3 & 8\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $A$ using its characteristic equation $det(A-\\lambda I)=0:$ \n\n$$\n\\begin{aligned}\\begin{vmatrix}-6-\\lambda  & 8 \\\\ -3 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-6-\\lambda )(8-\\lambda )-(8)(-3) & =0 \\\\ {\\lambda }^{2}-2\\lambda -24 & =0 \\\\ (\\lambda +4)(\\lambda -6) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $A$ are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=6.$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=-4,$ we have\n\n$$\n\\begin{aligned}A-(-4)I & =\\begin{bmatrix}-6 & 8 \\\\ -3 & 8\\end{bmatrix}-(-4)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 8 \\\\ -3 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-2 & 8 & 0 \\\\ -3 & 12 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=4{x}_{2}.$ Hence, the general solution is \n\n$$\n\\begin{bmatrix}4{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}4 \\\\ 1\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=6,$ we have\n\n$$\n\\begin{aligned}A-6I & =\\begin{bmatrix}-6 & 8 \\\\ -3 & 8\\end{bmatrix}-6\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & 8 \\\\ -3 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n \nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-12 & 8 & 0 \\\\ -3 & 2 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(-\\frac{1}{4}){R}_{1} \\\\  & ∼\\begin{bmatrix}-12 & 8 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{2}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=3,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}-4 & 0 \\\\ 0 & 6\\end{bmatrix},\\,P=\\begin{bmatrix}4 & 2 \\\\ 1 & 3\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186402555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ca5e05-e8c7-5ea9-9479-880bcac9fd7e" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & -5\\end{bmatrix}$ and $P=\\begin{bmatrix}-1 & 0 \\\\ 3 & 4\\end{bmatrix}$" :db/id #edb/ref 17592186402557} {:answer/id #uuid "cec96149-8e09-5331-875a-ab33988cf89c" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ is not diagonalizable" :db/id #edb/ref 17592186402558} {:answer/id #uuid "4b260252-c6f6-5fad-83eb-3522a2d6f4b6" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & -5\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -1 \\\\ 0 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186402559} {:answer/id #uuid "a6fc9f90-30e7-548e-80ae-265b4fc81746" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & 5\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -3 \\\\ 0 & 2\\end{bmatrix}$" :db/id #edb/ref 17592186402560} {:answer/id #uuid "7a602129-401f-59d3-95f1-27f7d2b50e78" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & -5\\end{bmatrix}$ and $P=\\begin{bmatrix}5 & 1 \\\\ 0 & -4\\end{bmatrix}$" :db/id #edb/ref 17592186402561}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}7 & 0 \\\\ 0 & -5\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -1 \\\\ 0 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186402559} :answer-field/id #uuid "48c93eb5-5578-5226-8ad3-ab9b9a9ba7af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402556}] :question/id #uuid "a4b19937-90d1-5717-b7a0-7b53ad9d3dcb" :question/math-academy-id "q-37633" :question/problem "Given the matrix \n$B=\\begin{bmatrix}7 & 4 \\\\ 0 & -5\\end{bmatrix}$,\nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}BP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=7\\,$ and $\\,{\\lambda }_{2}=-5$\n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=7,$ we have \n\n$$\n\\begin{aligned}B-7I & =\\begin{bmatrix}7 & 4 \\\\ 0 & -5\\end{bmatrix}-7\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 4 \\\\ 0 & -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & 4 & 0 \\\\ 0 & -12 & 0\\end{bmatrix} & {R}_{2}={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & 4 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-5,$ we have\n\n$$\n\\begin{aligned}B-(-5)I & =\\begin{bmatrix}7 & 4 \\\\ 0 & -5\\end{bmatrix}+5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 4 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-\\frac{1}{3}{x}_{2}.$ Hence, the general solution is \n\n$$\n\\begin{bmatrix}-\\frac{1}{3}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=3,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}7 & 0 \\\\ 0 & -5\\end{bmatrix},\\,P=\\begin{bmatrix}1 & -1 \\\\ 0 & 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186404107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15560ba1-c0e7-57a3-bd24-dc19e7e9f52a" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404109} {:answer/id #uuid "4a752dce-688f-5fd3-becb-69a53449004c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}$ and $P=\\begin{bmatrix}-1 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404110} {:answer/id #uuid "e3bff80f-44fe-590e-825f-851b2661193c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P=\\begin{bmatrix}-1 & -3 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404111} {:answer/id #uuid "2042fd4c-3a1d-5b77-a6af-7aa6566dcc2c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404112} {:answer/id #uuid "8b20c357-a80f-5d68-9f17-47dfa214c55e" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -2 \\\\ 0 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186404113}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404112} :answer-field/id #uuid "958185d9-bfb3-5c99-9580-566f3546885e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404108}] :question/id #uuid "7be4462e-3d0b-5745-b83e-db8e5d74f57e" :question/math-academy-id "q-80493" :question/problem "Given the matrix \n$A=\\begin{bmatrix}-3 & -2 \\\\ 0 & -2\\end{bmatrix}$, \nfind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  We need to find the eigenvalues of the matrix. Since matrix $A$ is triangular, its eigenvalues are the entries on the main diagonal: \n\n$\\,$ ${\\lambda }_{1}=-3\\,$ and $\\,{\\lambda }_{2}=-2$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$\n\n- For ${\\lambda }_{1}=-3,$ we have\n\n$$\n\\begin{aligned}A-(-3)I & =\\begin{bmatrix}-3 & -2 \\\\ 0 & -2\\end{bmatrix}+3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & -2 & 0 \\\\ 0 & 1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -2 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $2$nd one). Thus, ${x}_{1}$ is a free variable. From the first equation, we obtain ${x}_{2}=0.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ 0\\end{bmatrix},\\,{x}_{1}\\in R.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-3 & -2 \\\\ 0 & -2\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -2 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a homogeneous system of linear equations with the matrix as above. Note, the matrix is already in row echelon form. There is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=-2{x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}-2{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}-3 & 0 \\\\ 0 & -2\\end{bmatrix},\\,P=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186404114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20692b0c-ecf3-5857-b371-5e00dd088456" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}$ and\n$P=\\begin{bmatrix}1 & 1 \\\\ -2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404116} {:answer/id #uuid "8297858c-6a75-5e90-8004-887fd5f4fe6e" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ is not diagonalizable" :db/id #edb/ref 17592186404117} {:answer/id #uuid "21bdb776-d042-5bc3-8def-4d142fb67170" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}$ and\n$P=\\begin{bmatrix}1 & -1 \\\\ -2 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186404118} {:answer/id #uuid "9a56eb51-adbb-529e-b66c-37695fb34a1f" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}$ and\n$P=\\begin{bmatrix}1 & -1 \\\\ 2 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186404119} {:answer/id #uuid "3093f458-0d1e-55d2-af6e-2473cd7616a9" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}$ and\n$P=\\begin{bmatrix}1 & 1 \\\\ 2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404120}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix}$ and\n$P=\\begin{bmatrix}1 & 1 \\\\ 2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186404120} :answer-field/id #uuid "5324a7ce-971d-53cb-b107-19a127a08e1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404115}] :question/id #uuid "f53e1d4c-a53d-5c3e-8ae8-0e080a8e331f" :question/math-academy-id "q-80496" :question/problem "Find matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal matrix and $B=\\begin{bmatrix}-5 & 3 \\\\ -6 & 4\\end{bmatrix}.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.** We need to find the eigenvalues of the matrix $B$ using its characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}-5-\\lambda  & 3 \\\\ -6 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (-5-\\lambda )(4-\\lambda )-3\\cdot (-6) & =0 \\\\ {\\lambda }^{2}+\\lambda -2 & =0 \\\\ (\\lambda -1)(\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $B$ are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-2.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $B.$\n\n- For ${\\lambda }_{1}=1,$ we have\n\n$$\n\\begin{aligned}B-I & =\\begin{bmatrix}-5 & 3 \\\\ -6 & 4\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 3 \\\\ -6 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-6 & 3 & 0 \\\\ -6 & 3 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{2}.$  Hence, the general solution is\n\n$$\n\\begin{bmatrix}\\frac{1}{2}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=2,$ we get the eigenvector ${v}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.$\n\n- For ${\\lambda }_{2}=-2,$ we have\n\n$$\n\\begin{aligned}B-(-2)I & =\\begin{bmatrix}-5 & 3 \\\\ -6 & 4\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 3 \\\\ -6 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to its row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-3 & 3 & 0 \\\\ -6 & 6 & 0\\end{bmatrix} & {R}_{2} & ={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 3 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n\\begin{bmatrix}{x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in R.\n$$\n\nSetting ${x}_{2}=1,$ we get the eigenvector ${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ as follows:\n\n$$\nD=\\begin{bmatrix}1 & 0 \\\\ 0 & -2\\end{bmatrix},\\,P=\\begin{bmatrix}1 & 1 \\\\ 2 & 1\\end{bmatrix}\n$$"}] :knowledge-point/title "Diagonalizing a 2x2 Matrix"} {:db/id #edb/ref 17592186124602 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124414 :question/id #uuid "7959b6aa-7ef0-5ba1-b74b-5e59481d0145" :question/math-academy-id "e-8575" :question/problem "Consider the matrix ![](images/4e/4e737b78109f94302bdc256b4a8bb9585fdb214ccc89bd9439b52fa4973f59ba.svg) You're given that $\\lambda_1=4$ and $\\lambda_2=3$ are the eigenvalues of $A,$ and\n![](images/6b/6b4045bf6fc71339953a55a1e3660384a569861537ee37427be110aa3442a872.svg) ![](images/34/34760505c150775e9b579151b333cf3baa044102e0197b4e9aae3444c0581cd0.svg) are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PDP^{-1} = A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are $\\lambda_1={\\color{blue}4}$ and $\\lambda_2={\\color{red}3},$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n![](images/42/427a788b1c9f78e8ce25f06b54cef549d7be04757f6275cc66f12bd48652e40b.svg)\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to $\\lambda_1={\\color{blue}4},$ and\n\n- the $2$nd column is the eigenvector corresponding to $\\lambda_2={\\color{red}3}.$\n\nTherefore, we get\n\n![](images/bd/bdf233e22e7972a4eb912463bc81727d7e22b160ff823ec51d0be494d24d493c.svg)"} :knowledge-point/id #uuid "5164c6cb-aef0-554b-b361-77245991c0ea" :knowledge-point/questions [{:db/id #edb/ref 17592186125087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3d8a9f-0837-5444-96f4-3343addf731c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321730} {:answer/id #uuid "5eb2d859-49de-56b7-a465-a7874068e2c1" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321894} {:answer/id #uuid "7867aeed-68dd-56a2-a34d-5ec26ea35c5c" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand \n$P=\\begin{bmatrix}-2 & 2 \\\\ 1 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186322093} {:answer/id #uuid "9d96ee6e-162e-5c5e-a698-98e97a131b1e" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand \n$P=\\begin{bmatrix}-2 & 1 \\\\ 2 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186322387} {:answer/id #uuid "dfb16a4c-567b-5f54-9449-b0670f93ce27" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186322897}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & -2 \\\\ 0 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186321894} :answer-field/id #uuid "13cf44af-77c6-56e5-9933-c6fb76ed79fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323206}] :question/id #uuid "1a91b641-268c-57ee-aae6-245277497fff" :question/math-academy-id "q-37600" :question/problem "Consider the matrix $A=\\begin{bmatrix}-3 & -8 \\\\ 0 & 1\\end{bmatrix}.$ You're given that ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=1$ are the eigenvalues of $A$, and\n${v}_{1}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}$, ${v}_{2}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}-3 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=1.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}2 & -2 \\\\ 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186125090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acfb64f-d399-5128-abd9-0fd718785c17" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-3,$ and $c=3$" :db/id #edb/ref 17592186321233} {:answer/id #uuid "32ca874e-c218-5348-8254-ebdd24f6b5a9" :answer/type {:db/ident :answer.type/text} :answer/value "$a=3,$ $b=1,$ and $c=-1$" :db/id #edb/ref 17592186321535} {:answer/id #uuid "3d45e436-1b6c-5c26-990c-2a9bafba337d" :answer/type {:db/ident :answer.type/text} :answer/value "$a=15,$ $b=-1,$ and $c=-2$" :db/id #edb/ref 17592186321624} {:answer/id #uuid "824319fd-3efa-515c-be89-065ca8419d86" :answer/type {:db/ident :answer.type/text} :answer/value "$a=3,$ $b=-1,$ and $c=1$" :db/id #edb/ref 17592186322173} {:answer/id #uuid "f428ad45-b7f1-5420-a618-a7f180e0107e" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-1,$ $b=3,$ and $c=-3$" :db/id #edb/ref 17592186323062}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$a=3,$ $b=-1,$ and $c=1$" :db/id #edb/ref 17592186322173} :answer-field/id #uuid "c580f2eb-b112-550e-99c4-120b3d89a440" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323555}] :question/id #uuid "52d32399-93d9-5ce5-a996-5d60c1e0900e" :question/math-academy-id "q-37610" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15$ are eigenvalues, and\n\n$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=\\begin{bmatrix}1 & b \\\\ 2 & c\\end{bmatrix}\\begin{bmatrix}a & 0 \\\\ 0 & 15\\end{bmatrix}{\\begin{bmatrix}1 & b \\\\ 2 & c\\end{bmatrix}}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}3 & 0 \\\\ 0 & 15\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=15.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nFinally, we obtain\n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 15\\end{bmatrix}{\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}}^{-1}.\n$$\n\n \n\nIn conclusion, we get $a=3,$ $b=-1,$ and $c=1.$"} {:db/id #edb/ref 17592186272003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efeb8db-be18-53ad-9f41-5d9c7901a0a7" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186269528} {:answer/id #uuid "7ec1cf70-97c1-5cb0-8bd5-06b5006830a9" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 3 \\\\ 1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186270376} {:answer/id #uuid "892aa3f2-2bcf-5365-9936-d7600a913769" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186270453} {:answer/id #uuid "b318af36-27af-5e2d-86e0-a473a223bf88" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186270866} {:answer/id #uuid "cfd567a3-4432-56c1-9cad-efedcb5d9c2f" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186271092}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}$\nand\n$P=\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186270453} :answer-field/id #uuid "4f85dded-035f-5cb9-a048-9d2ff9e5113a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271654}] :question/id #uuid "f80fc9d4-c782-54c4-af07-b3eb33afd65c" :question/math-academy-id "q-140038" :question/problem "Consider the matrix $A=\\begin{bmatrix}11 & -8 \\\\ 12 & -9\\end{bmatrix}.$ You're given that ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3$ are the eigenvalues of $A$, and\n${v}_{1}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$, ${v}_{2}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}-1 & 0 \\\\ 0 & 3\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-1,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=3.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}2 & 1 \\\\ 3 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186272004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd27f46-0fd2-5037-bc41-fd2cfcbdcc9e" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=3,$ and $c=-2$" :db/id #edb/ref 17592186269373} {:answer/id #uuid "3898e3de-9814-57b1-8159-d04b73eb79b1" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=-2,$ and $c=3$" :db/id #edb/ref 17592186269782} {:answer/id #uuid "c2df0ba9-0fe7-5930-be83-a7a3ac0d87bb" :answer/type {:db/ident :answer.type/text} :answer/value "$a=2,$ $b=-2,$ and $c=3$" :db/id #edb/ref 17592186270992} {:answer/id #uuid "f1186842-7257-5abe-aa30-b68f9a9b265f" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-2,$ and $c=3$" :db/id #edb/ref 17592186271387} {:answer/id #uuid "f62d17fd-cfe8-5ddc-a914-06afc790f393" :answer/type {:db/ident :answer.type/text} :answer/value "$a=2,$ $b=3,$ and $c=-2$" :db/id #edb/ref 17592186271430}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$a=-2,$ $b=3,$ and $c=-2$" :db/id #edb/ref 17592186269373} :answer-field/id #uuid "91b1c54a-7ee2-538d-9d29-f08a44ec3c35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271770}] :question/id #uuid "fbc0242d-25c0-5562-9348-36ca1c8266af" :question/math-academy-id "q-140039" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=-1$ are eigenvalues, and\n\n$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=\\begin{bmatrix}1 & b \\\\ c & -4\\end{bmatrix}\\begin{bmatrix}a & 0 \\\\ 0 & -1\\end{bmatrix}{\\begin{bmatrix}1 & b \\\\ c & -4\\end{bmatrix}}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=-1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}-2 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-2,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-1.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}1 & 3 \\\\ -2 & -4\\end{bmatrix}.\n$$\n\nFinally, we obtain\n\n$$\nA=\\begin{bmatrix}1 & 3 \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}-2 & 0 \\\\ 0 & -1\\end{bmatrix}{\\begin{bmatrix}1 & 3 \\\\ -2 & -4\\end{bmatrix}}^{-1}.\n$$\n\n \n\nIn conclusion, we get $a=-2,$ $b=3,$ and $c=-2.$"} {:db/id #edb/ref 17592186348375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "218d2232-b6b4-5353-9b44-bc2b615b173f" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-5,$ $b=-1,$ and $c=-1$" :db/id #edb/ref 17592186345651} {:answer/id #uuid "54242d0d-9f70-50fb-a1c7-1d7500836483" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-1,$ $b=-5,$ and $c=-1$" :db/id #edb/ref 17592186346065} {:answer/id #uuid "a5d2abcd-e82b-5bca-8c24-21c2c07d708d" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-1,$ and $c=-5$" :db/id #edb/ref 17592186346799} {:answer/id #uuid "a6178168-bb39-5a85-9081-d612835e2505" :answer/type {:db/ident :answer.type/text} :answer/value "$a=1,$ $b=-5,$ and $c=-1$" :db/id #edb/ref 17592186346802} {:answer/id #uuid "ff40704f-1d0b-5ea5-8bf6-a3b2c43d0da4" :answer/type {:db/ident :answer.type/text} :answer/value "$a=-1,$ $b=-1,$ and $c=-5$" :db/id #edb/ref 17592186347593}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$a=-5,$ $b=-1,$ and $c=-1$" :db/id #edb/ref 17592186345651} :answer-field/id #uuid "e355db22-060d-55f4-890a-5652cc9577f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348001}] :question/id #uuid "def1c542-80f5-5b03-88dc-ad7a755f7e8b" :question/math-academy-id "q-80371" :question/problem "Consider the matrix $K$ for which ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-5$ are eigenvalues, and\n\n$$\n{v}_{1}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix},\\,{v}_{2}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nK=\\begin{bmatrix}b & 1 \\\\ 0 & c\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & a\\end{bmatrix}{\\begin{bmatrix}b & 1 \\\\ 0 & c\\end{bmatrix}}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-5,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=\\begin{bmatrix}2 & 0 \\\\ 0 & -5\\end{bmatrix}.\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=2,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-5.$\n\nTherefore, we get\n\n$$\nP=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nFinally, we obtain\n\n$$\nK=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & -5\\end{bmatrix}{\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=-5,$ $b=-1,$ and $c=-1.$"} {:db/id #edb/ref 17592186348376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b5beb30-0a75-5fc1-9136-9135683b1b51" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}-2 & 0 \\\\ 0 & 2\\end{bmatrix}$ and $P=\\begin{bmatrix}2 & 1 \\\\ -1 & 1\\end{bmatrix}$" :db/id #edb/ref 17592186346129} {:answer/id #uuid "70a5b71d-efb0-58ab-af42-12eed66f2bb6" :answer/type {:db/ident :answer.type/text} :answer/value "$D=\\begin{bmatrix}2 & -2 \\\\ 0 & 0\\end{bmatrix}$ and $P=\\begin{bmatrix}2 & 1 \\\\ -1 & -1\\end{bmatrix}$" :db/id #edb/ref 17592186346339} {:answer/id #uuid "783aadac-abc2-5341-8883-bae757b2fee4" :answer/