gin{bmatrix}-5 & 15 \\\\ 3 & -9\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c24ee771-dbe8-598f-84ff-60f041661edb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113948} {:answer/id #uuid "31f22e55-3257-560c-9b8b-1a370672646f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113949} {:answer/id #uuid "41fb8df9-f182-543a-ad39-bd4d9406f6c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113950} {:answer/id #uuid "4c8e5b8a-9724-51db-b122-6afd0420a1df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186113951} {:answer/id #uuid "63361cf3-7b7e-5c0a-8a4d-0ce1232f5d05" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113952}] :answer-field/id #uuid "9e1c3b65-2a4d-5f95-b0da-0c05529f3648" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113947}] :question/id #uuid "7171223c-0a20-5fbc-a656-b17651c3059d" :question/math-academy-id "q-42257" :question/problem "Calculate $ABC$, where\n$A = \\begin{bmatrix}-1 & 3 \\\\ 2 & 0 \\\\ 1 & 4\\end{bmatrix}, B = \\begin{bmatrix}2 & -1 & -2 \\\\ 5 & -5 & -5\\end{bmatrix}, C = \\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}$."} {:db/id #edb/ref 17592186265880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19780864-9003-505a-b598-f3378103858e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 6 & -1 \\\\ 4 & 2 & 1 \\\\ -1 & 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186263242} {:answer/id #uuid "1d6518a0-5e35-59b6-b899-07522f46b179" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -7 & -21 \\\\ 3 & -3 & -9 \\\\ -8 & 8 & 24\\end{bmatrix}" :db/id #edb/ref 17592186263268} {:answer/id #uuid "5517ab5e-f687-5ce4-852d-48dfec575a26" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-8 & 8 & 24 \\\\ 3 & -3 & -9 \\\\ 7 & -7 & -21\\end{bmatrix}" :db/id #edb/ref 17592186263733} {:answer/id #uuid "55a69114-638a-51d0-954d-1a1fa82cd27a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -8 & 7 \\\\ -3 & 8 & -7 \\\\ -9 & 24 & -21\\end{bmatrix}" :db/id #edb/ref 17592186263735} {:answer/id #uuid "ce129b66-be90-56f8-b1fe-b394c797c064" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{bmatrix}" :db/id #edb/ref 17592186264802}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{bmatrix}" :db/id #edb/ref 17592186264802} :answer-field/id #uuid "42ab1d01-3d95-5a64-a3f9-0807a0efbbe8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265368}] :question/id #uuid "e430effe-7959-580a-be3d-d4b5f50f0d27" :question/math-academy-id "q-130313" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix},\\,C=\\begin{bmatrix}-1 & 1 & 3\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}3 & 6 \\\\ 4 & 2 \\\\ -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ 8 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-3 \\\\ 8 \\\\ -7\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -3 & -9 \\\\ -8 & 8 & 24 \\\\ 7 & -7 & -21\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62b9489d-1bd9-53ad-9584-412222a7fecf" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186291053}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186291053} :answer-field/id #uuid "1a8b6a87-5f6a-54ec-bbe9-05756798dc46" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291835} {:answer-field/choices [{:answer/id #uuid "13580fde-eb60-54eb-9bfd-40f8fda2fbef" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186290711}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186290711} :answer-field/id #uuid "8301dbb7-fe84-5fd3-8cbd-036cdaac29d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292139} {:answer-field/choices [{:answer/id #uuid "c8982662-fdbc-570e-8fc5-e65e0ce3b2a7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186291495}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186291495} :answer-field/id #uuid "959aa908-c6eb-527a-ab57-de9ee34db64d" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292205} {:answer-field/choices [{:answer/id #uuid "7d0d490a-b2d5-5e7a-a5e1-e8afde576656" :answer/typ