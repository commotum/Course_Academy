on/id #uuid "8e3709ff-318c-5598-82d8-cdf2103d7ab9"} :step/id #uuid "d147e2e2-aa64-5057-9352-9369e34a44e5" :step/next {:db/id #edb/ref 17592186551463}} {:db/id #edb/ref 17592186551463 :step/content {:db/id #edb/ref 17592186162621 :question/id #uuid "28be3e2f-b0ff-5855-af78-c4f12425ac89"} :step/id #uuid "e7ce4ba0-2394-5109-8b2f-c042da1d0452" :step/next {:db/id #edb/ref 17592186551409}}] :activity/title "Change of Variables in Quadratic Forms" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186550363}] :db/id #edb/ref 17592186048300 :topic/knowledge-points [{:db/id #edb/ref 17592186161991 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161783 :question/id #uuid "248c9a29-6698-5c8c-b674-0b0dc537edf0" :question/math-academy-id "e-8177" :question/problem "Given that ![](images/d6/d61f758057cada0aebaa7d21c736121295f3f65f4621d065fa0c7ae1ca040af4.svg) express the quadratic form $Q(\\mathbf{x})= x_1^2-x_2^2\\,$ in terms of the components of $\\mathbf{y}.$" :question/worked-solution "First, notice that  \n\n![](images/97/97f99e2e86ecbd0d4b913c2e3a6df61f90092df8aaa31d094b80d3d69a17727c.svg)\n\ngives the following expressions for $x_1$ and $x_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}-{y}_{2} \\\\ {x}_{2} & =2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-{x}_{2}^{2} \\\\  & =({y}_{1}-{y}_{2})^{2}-(2{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}-4{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-2{y}_{1}{y}_{2}-3{y}_{2}^{2}\\end{aligned}\n$$"} :knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93" :knowledge-point/questions [{:db/id #edb/ref 17592186162601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359eac66-9e82-57e3-8124-1ef957fa98b3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-7{y}_{1}{y}_{2}+11{y}_{2}^{2}" :db/id #edb/ref 17592186491561} {:answer/id #uuid "3dae5ac9-23a3-53e9-bbd1-66b1476d8335" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186491574} {:answer/id #uuid "aec30382-a77d-57a4-9c10-ae90d06f1fc6" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186491759} {:answer/id #uuid "dcc581e7-d801-53ea-828c-1580d1c502b8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-3{y}_{2}^{2}" :db/id #edb/ref 17592186491829} {:answer/id #uuid "e335ca01-3749-59ee-88ce-84a03f6e017a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-3{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186491840}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-7{y}_{1}{y}_{2}+11{y}_{2}^{2}" :db/id #edb/ref 17592186491561} :answer-field/id #uuid "0c4e7adc-5107-5de3-ad4d-7554ee71eefa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160898}] :question/id #uuid "21370042-e785-5cb0-bd56-e827bc7cef28" :question/math-academy-id "q-93733" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-3{x}_{1}{x}_{2}+{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\n$$\n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}-2{y}_{2} \\\\ {x}_{2} & ={y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-3{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =({y}_{1}-2{y}_{2})^{2}-3({y}_{1}-2{y}_{2}){y}_{2}+{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-4{y}_{1}{y}_{2}+4{y}_{2}^{2}-3{y}_{1}{y}_{2}+6{y}_{2}^{2}+{y}_{2}^{2} \\\\  & ={y}_{1}^{2}-7{y}_{1}{y}_{2}+11{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186162617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3addaa4-359b-55d7-b53d-349c7ec8f8d3" :answer/type {:db/ident :answer.type/math} :answer/value "12y_{1}^{2} - 3y_{2}^{2}" :db/id #edb/ref 17592186160995} {:answer/id #uuid "cd627197-16a2-510c-ad6e-c4f0a25355f2" :answer/type {:db/ident :answer.type/math} :answer/value "6y_{1}^{2} - 2y_{1}y_{2} + y_{2}^{2}" :db/id #edb/ref 17592186160996} {:answer/id #uuid "ea283a99-018b-5c87-b010-1e903648d640" :answer/type {:db/ident :answer.type/math} :answer/value "8y_{1}^{2} + y_{2}^{2}" :db/id #edb/ref 17592186160997} {:answer/id #uuid "108b09f3-a714-5d16-86f9-23b345ae7597" :answer/type {:db/ident :answer.type/math} :answer/value "4y_{1}^{2} - 3y_{1}y_{2} + 3y_{2}^{2}" :db/id #edb/ref 17592186160998} {:answer/id #uuid "699a6a08-82b5-58d6-a665-0eb1d203d722" :answer/type {:db/ident :answer.type/math} :answer/value "4y_{1}^{2} - 4y_{1}y_{2} + y_{2}^{2}" :db/id #edb/ref 17592186160999}] :answer-field/id #uuid "79e124ee-9490-54fc-8e8a-bd4c29f005ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160994}] :question/id #uuid "ef3262b5-d75f-5f24-9dcf-8c9d25bdee5f" :question/math-academy-id "q-94092" :question/problem "Given that $\\begin{bmatrix}x_{1} \\\\ x_{2}\\end{bmatrix} = \\begin{bmatrix}2 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}y_{1} \\\\ y_{2}\\end{bmatrix}$, express the quadratic form $Q(x) = x_{1}^{2} + 4x_{1}x_{2}$ in terms of the components of $y$."} {:db/id #edb/ref 17592186272174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24896bb6-8f7b-5b0f-912f-1c7bdb2fc59a" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+{y}_{1}{y}_{2}-3{y}_{2}^{2}" :db/id #edb/ref 17592186269589} {:answer/id #uuid "3e9f6fa0-594f-5abc-9e06-efb0679fcee5" :answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}^{2}-{y}_{1}{y}_{2}-6{y}_{2}^{2}" :db/id #edb/ref 17592186269843} {:answer/id #uuid "4c757df0-d829-5e1d-9137-d368852d810f" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}_{1}^{2}-13{y}_{1}{y}_{2}-13{y}_{2}^{2}" :db/id #edb/ref 17592186269957} {:answer/id #uuid "cca375e2-8dae-5e84-b871-b53e4a605c82" :answer/type {:db/ident :answer.type/math} :answer/value "7{y}_{1}^{2}-17{y}_{1}{y}_{2}-12{y}_{2}^{2}" :db/id #edb/ref 17592186271064} {:answer/id #uuid "e2a2efb4-6f8c-5ca2-8134-eafb8e9d218a" :answer/type {:db/ident :answer.type/math} :answer/value "7{y}_{1}^{2}-{y}_{1}{y}_{2}+3{y}_{2}^{2}" :db/id #edb/ref 17592186271260}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7{y}_{1}^{2}-17{y}_{1}{y}_{2}-12{y}_{2}^{2}" :db/id #edb/ref 17592186271064} :answer-field/id #uuid "fdff37f8-ace3-567b-91d3-9036618e13d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271949}] :question/id #uuid "b010d250-6d3a-5b23-96f4-01c7340eadcd" :question/math-academy-id "q-140936" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)=2{x}_{1}^{2}+{x}_{1}{x}_{2}-3{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\n$$\n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1}-{y}_{2} \\\\ {x}_{2} & ={y}_{1}+2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}+{x}_{1}{x}_{2}-3{x}_{2}^{2} \\\\  & =2(2{y}_{1}-{y}_{2})^{2}+(2{y}_{1}-{y}_{2})({y}_{1}+2{y}_{2})-3({y}_{1}+2{y}_{2})^{2} \\\\  & =8{y}_{1}^{2}-8{y}_{1}{y}_{2}+2{y}_{2}^{2}+2{y}_{1}^{2}+3{y}_{1}{y}_{2}-2{y}_{2}^{2}-3{y}_{1}^{2}-12{y}_{1}{y}_{2}-12{y}_{2}^{2} \\\\  & =7{y}_{1}^{2}-17{y}_{1}{y}_{2}-12{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06df7d42-b75b-592f-ada9-646b7f9f0321" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+12{y}_{1}{y}_{2}-9{y}_{2}^{2}" :db/id #edb/ref 17592186269330} {:answer/id #uuid "3408a919-5e82-58fa-ab38-a18b5090b22e" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}" :db/id #edb/ref 17592186269744} {:answer/id #uuid "949322fc-53c4-5ac8-8677-c89d5a3aee64" :answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}^{2}-3{y}_{1}{y}_{2}+9{y}_{2}^{2}" :db/id #edb/ref 17592186270568} {:answer/id #uuid "e00bf831-48d9-5aa4-81aa-22ed52455d32" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-4{y}_{1}{y}_{2}+3{y}_{2}^{2}" :db/id #edb/ref 17592186271235} {:answer/id #uuid "e3d692a5-d466-5816-8d68-4fdf49f36484" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}_{1}^{2}-15{y}_{1}{y}_{2}-27{y}_{2}^{2}" :db/id #edb/ref 17592186271276}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}" :db/id #edb/ref 17592186269744} :answer-field/id #uuid "b0f2c426-5ca2-591f-93ef-89e9a25f9313" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271830}] :question/id #uuid "8e97b98e-48ee-5b17-822d-fa5e4daf00d2" :question/math-academy-id "q-140937" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}-4{x}_{1}{x}_{2}+3{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -1 & 3\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\n$$\n\n  \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1} \\\\ {x}_{2} & =-{y}_{1}+3{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-4{x}_{1}{x}_{2}+3{x}_{2}^{2} \\\\  & =({y}_{1})^{2}-4({y}_{1})(-{y}_{1}+3{y}_{2})+3(-{y}_{1}+3{y}_{2})^{2} \\\\  & ={y}_{1}^{2}+4{y}_{1}^{2}-12{y}_{1}{y}_{2}+3{y}_{1}^{2}-18{y}_{1}{y}_{2}+27{y}_{2}^{2} \\\\  & =8{y}_{1}^{2}-30{y}_{1}{y}_{2}+27{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0721553b-ff2a-510f-8bd9-315b27293eb3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186354724} {:answer/id #uuid "2a6b2bc9-96e9-5a5d-a8a3-17638f361bf9" :answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}{y}_{2}-8{y}_{2}^{2}" :db/id #edb/ref 17592186355018} {:answer/id #uuid "30306894-33d5-5826-bfe3-3cea878350e7" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}{y}_{2}-{y}_{1}^{2}" :db/id #edb/ref 17592186355083} {:answer/id #uuid "79a9a162-4dfd-5acb-900f-43abaae30d79" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+4{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355730} {:answer/id #uuid "f040fb05-77e4-5612-b088-7ad0daf1999b" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}-3{y}_{2}^{2}" :db/id #edb/ref 17592186356766}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4{y}_{1}{y}_{2}-8{y}_{2}^{2}" :db/id #edb/ref 17592186355018} :answer-field/id #uuid "c2adb9c2-ec4f-5c35-a39b-a01e94aab7b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357269}] :question/id #uuid "de62870c-5c78-5d4e-9622-5e5ec12329c3" :question/math-academy-id "q-94123" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)=-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\n$$\n\n  \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1} \\\\ {x}_{2} & ={y}_{1}+2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =-{x}_{1}^{2}+3{x}_{1}{x}_{2}-2{x}_{2}^{2} \\\\  & =-(2{y}_{1})^{2}+3(2{y}_{1})({y}_{1}+2{y}_{2})-2({y}_{1}+2{y}_{2})^{2} \\\\  & =-4{y}_{1}^{2}+6{y}_{1}^{2}+12{y}_{1}{y}_{2}-2{y}_{1}^{2}-8{y}_{1}{y}_{2}-8{y}_{2}^{2} \\\\  & =4{y}_{1}{y}_{2}-8{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1556ee77-a810-5153-a388-ba23b53930a4" :answer/type {:db/ident :answer.type/math} :answer/value "25{y}_{1}^{2}-9{y}_{2}^{2}" :db/id #edb/ref 17592186354854} {:answer/id #uuid "a8ca0917-6dad-5cd7-9d15-eabece4c0311" :answer/type {:db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}-10{y}_{1}{y}_{2}" :db/id #edb/ref 17592186356160} {:answer/id #uuid "aac69a34-b9fe-50ec-8264-65b0d070f036" :answer/type {:db/ident :answer.type/math} :answer/value "25{y}_{1}^{2}+10{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356177} {:answer/id #uuid "b73f995e-c3ec-555e-8fe4-a2d886d2723f" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}{y}_{2}+{y