}_{2}+{y}_{2}^{2} \\\\  & =2{y}_{1}^{2}+2{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9b4ba9-4b62-5e0e-ae19-257113d3c674" :answer/type {:db/ident :answer.type/math} :answer/value "18{y}_{1}^{2}+19{y}_{2}{y}_{1}+3{y}_{2}^{2}" :db/id #edb/ref 17592186491578} {:answer/id #uuid "4f882cc8-155e-5595-b071-23dfc51435c9" :answer/type {:db/ident :answer.type/math} :answer/value "12{y}_{1}^{2}+22{y}_{2}{y}_{1}-5{y}_{2}^{2}" :db/id #edb/ref 17592186491603} {:answer/id #uuid "4fe613c4-6ec9-5d7a-84c5-6f69bf92d908" :answer/type {:db/ident :answer.type/math} :answer/value "18{y}_{1}^{2}+21{y}_{2}{y}_{1}+5{y}_{2}^{2}" :db/id #edb/ref 17592186491605} {:answer/id #uuid "9f40950a-57ff-561b-91d4-22a70f75858b" :answer/type {:db/ident :answer.type/math} :answer/value "12{y}_{1}^{2}+20{y}_{2}{y}_{1}+3{y}_{2}^{2}" :db/id #edb/ref 17592186491734} {:answer/id #uuid "b15b484f-30e2-52c3-804b-34551cd5db72" :answer/type {:db/ident :answer.type/math} :answer/value "18{y}_{1}^{2}+22{y}_{2}{y}_{1}-5{y}_{2}^{2}" :db/id #edb/ref 17592186491764}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "18{y}_{1}^{2}+21{y}_{2}{y}_{1}+5{y}_{2}^{2}" :db/id #edb/ref 17592186491605} :answer-field/id #uuid "d3c9b219-a68c-573e-9caa-60583455fec7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491965}] :question/id #uuid "ccf607c0-6726-51f8-81e9-1147263496f0" :question/math-academy-id "q-94100" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}3 & 2 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)=2{x}_{1}^{2}+{x}_{1}{x}_{2}-{x}_{2}^{2}\\,$ in terms of the components of $y.$" :question/worked-solution "First, notice that\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}3 & 2 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\n$$\n\n \n\ngives the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & =3{y}_{1}+2{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}+{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & =2(3{y}_{1}+2{y}_{2})^{2}+(3{y}_{1}+2{y}_{2})(-{y}_{2})-(-{y}_{2})^{2} \\\\  & =18{y}_{1}^{2}+24{y}_{2}{y}_{1}+8{y}_{2}^{2}-3{y}_{1}{y}_{2}-2{y}_{2}^{2}-{y}_{2}^{2} \\\\  & =18{y}_{1}^{2}+21{y}_{2}{y}_{1}+5{y}_{2}^{2}\\end{aligned}\n$$"}] :knowledge-point/title "Changing Variables in a Quadratic Form Given Old Variables Through New Variables"} {:db/id #edb/ref 17592186161992 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161784 :question/id #uuid "1c199cdf-ca23-53e8-8b5d-1ba43c842d41" :question/math-academy-id "e-8178" :question/problem "Given that ![](images/94/94dba3059135b17acc3db3f62734f4e73996640245b5d4637e2f8cc3798f8f2a.svg) express the quadratic form $Q(\\mathbf{x})= x_1x_2+2x_2^2$ in terms of the components of $\\mathbf{y}.$" :question/worked-solution "First, notice that \n\n![](images/ea/ea5acd39b2fa7ea4f5c1c60feb7482f6c8f6946f7c3c656f54bec474326f205f.svg) \n\ngives the following expressions for $y_1$ and $y_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{y}_{1} & =2{x}_{1}-{x}_{2} \\\\ {y}_{2} & =-{x}_{1}\\end{aligned}\n$$\n\nBy solving the second equation for $x_1$ and substituting it into the first equation, we obtain the following expressions for $x_1$ and $x_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}_{1} & =-{y}_{2} \\\\ {x}_{2} & =-{y}_{1}-2{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}{x}_{2}+2{x}_{2}^{2} \\\\  & =(-{y}_{2})(-{y}_{1}-2{y}_{2})+2(-{y}_{1}-2{y}_{2})^{2} \\\\  & ={y}_{2}{y}_{1}+2{y}_{2}^{2}+2{y}_{1}^{2}+8{y}_{1}{y}_{2}+8{y}_{2}^{2} \\\\  & =2{y}_{1}^{2}+9{y}_{1}{y}_{2}+10{y}_{2}^{2}\\end{aligned}\n$$"} :knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3" :knowledge-point/questions [{:db/id #edb/ref 17592186162602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bd7ec03-edfe-5cbf-9100-12b8bdb0c709" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355618} {:answer/id #uuid "8d438ce4-5f0a-5c5e-9315-d5ef9dd4deac" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-3{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355912} {:answer/id #uuid "8f15bd83-407e-5af6-bdf7-c2bbd68497da" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355927} {:answer/id #uuid "b0b80b83-2a99-5e5e-9139-10034e099578" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+5{y}_{1}{y}_{2}-2{y}_{2}^{2}" :db/id #edb/ref 17592186356221} {:answer/id #uuid "bf1ab829-69f5-5348-881b-7cec2de50e44" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186356336}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186356336} :answer-field/id #uuid "c6f0ff43-58b3-5468-9256-34c2b09001cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357275}] :question/id #uuid "9c51ecf1-6711-57f2-8c41-d6bd2fed54f1" :question/math-academy-id "q-93735" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+3{x}_{1}{x}_{2}+{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 2 \\\\ 0 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1}+2{x}_{2} \\\\ {y}_{2} & =-{x}_{2}\\end{aligned}\n$$\n\nBy solving the second equation for ${x}_{2}$ and substituting it into the first equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1}+2{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+3{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =({y}_{1}+2{y}_{2})^{2}+3({y}_{1}+2{y}_{2})(-{y}_{2})+(-{y}_{2})^{2} \\\\  & ={y}_{1}^{2}+4{y}_{1}{y}_{2}+4{y}_{2}^{2}-3{y}_{1}{y}_{2}-6{y}_{2}^{2}+{y}_{2}^{2} \\\\  & ={y}_{1}^{2}+{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186162621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33dce4c6-a921-5609-a40b-0f4435c0ccee" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}_{1}^{2}-{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355121} {:answer/id #uuid "46f2051a-aab6-587b-87a9-8dfa3788d3ba" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}+{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355293} {:answer/id #uuid "79515c5d-06a7-5dad-bb16-30c2d00d6bc7" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}-2{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186355724} {:answer/id #uuid "dfe4a971-fd4a-50c9-8577-26d6033f2374" :answer/type {:db/ident :answer.type/math} :answer/value "-{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186356623} {:answer/id #uuid "e286ef9f-50be-51f3-a6b4-b463e95fcc16" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{1}^{2}+{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356648}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2{y}_{1}^{2}-{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 1759