ype/math} :answer/value "\\begin{bmatrix}-36 & 9 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186236836}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-36 & 9 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186236836} :answer-field/id #uuid "856687fd-d44c-51f1-bb8a-a53f6f091f9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237618}] :question/id #uuid "2425aa46-57d5-5074-b439-a8c2ccb1ce54" :question/math-academy-id "q-1027" :question/problem "$\\begin{bmatrix}-18 & 9 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}-18 & 9 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} & =\\begin{bmatrix}(-18)\\cdot 2+9\\cdot 0 & (-18)\\cdot 0+9\\cdot 1 \\\\ 0\\cdot 2+3\\cdot 0 & 0\\cdot 0+3\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-36+0 & 0+9 \\\\ 0+0 & 0+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-36 & 9 \\\\ 0 & 3\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066e4c4d-4f1c-5994-a629-0e0e493e74df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 4 \\\\ 6 & 4\\end{bmatrix}" :db/id #edb/ref 17592186259932} {:answer/id #uuid "80066af0-40c3-59b8-ab9e-038d28f5048e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 8 \\\\ 6 & 4\\end{bmatrix}" :db/id #edb/ref 17592186260985} {:answer/id #uuid "81e76629-2d40-5f74-ad22-43fff441c829" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 6 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261006} {:answer/id #uuid "a6711713-9767-5c93-b925-b5a9b093533f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 4 \\\\ 6 & 8\\end{bmatrix}" :db/id #ed