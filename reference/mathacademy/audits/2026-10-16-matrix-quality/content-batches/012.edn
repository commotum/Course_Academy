-519f-8671-c0e41159e92e" :answer/type {:db/ident :answer.type/math} :answer/value "v_{2}" :db/id #edb/ref 17592186108173} {:answer/id #uuid "5a68fa64-dee0-5f4b-9acd-1f863118c2be" :answer/type {:db/ident :answer.type/math} :answer/value "v_{4}" :db/id #edb/ref 17592186108174} {:answer/id #uuid "7794afa1-eb1a-55d3-a3bd-f6ed0847dd78" :answer/type {:db/ident :answer.type/math} :answer/value "v_{1}" :db/id #edb/ref 17592186108175}] :answer-field/id #uuid "da0a791b-d1d3-5398-b608-86445312e177" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186108171} {:answer-field/choices [{:answer/id #uuid "e048950c-e2b6-5b0e-9368-13d80c869786" :answer/type {:db/ident :answer.type/math} :answer/value "v_{3}" :db/id #edb/ref 17592186108177} {:answer/id #uuid "ebe8b13f-7046-5ee6-b385-0406695378e9" :answer/type {:db/ident :answer.type/math} :answer/value "v_{4}" :db/id #edb/ref 17592186108178} {:answer/id #uuid "1fac6c34-2191-53ee-8955-2ec04c6669de" :answer/type {:db/ident :answer.type/math} :answer/value "v_{2}" :db/id #edb/ref 17592186108179} {:answer/id #uuid "45d347d4-8f4d-59f4-b11f-78b9af4f3c7d" :answer/type {:db/ident :answer.type/math} :answer/value "v_{1}" :db/id #edb/ref 17592186108180}] :answer-field/id #uuid "9bfce952-8784-59d0-87cc-dbff502f8e4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186108176}] :question/id #uuid "dfcba1b7-67a3-5d52-92b3-ad793064bdfe" :question/math-academy-id "q-259388" :question/problem "|  |  |  |  |  |  |\n| --- | ---: | ---: | ---: | ---: | ---: |\n|  | $v_{1}$ | $v_{2}$ | $v_{3}$ | $v_{4}$ | $v_{5}$ |\n| $v_{1}$ | $-$ | $20$ | $-$ | $30$ | $-$ |\n| $v_{2}$ | $20$ | $-$ | $14$ | $-$ | $21$ |\n| $v_{3}$ | $-$ | $14$ | $-$ | $8$ | $10$ |\n| $v_{4}$ | $30$ | $-$ | $8$ | $-$ | $-$ |\n| $v_{5}$ | $-$ | $21$ | $10$ | $-$ | $-$ |\n\nConsider the distance matrix of a weighted graph shown above. Using Prim's algorithm starting from the vertex $v_{1}$, find a minimum spanning tree of this graph.\n\n**Step 1.**\n\nMark column\n{{field-1}}\nand cancel out row\n{{field-2}}."}] :knowledge-point/title "Applying Prim's Algorithm to a Distance Matrix"}] :topic/math-academy-id 1416 :topic/title "Applying Prim's Algorithm to a Distance Matrix"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186060646} :activity/id #uuid "23cd302e-47d0-5453-b9bd-9813f996a502" :activity/steps [{:db/id #edb/ref 17592186060646 :step/content {:db/id #edb/ref 17592186060930 :tutorial/content "If we want to multiply one square matrix by another (which has the same dimensions), we multiply each row in the first matrix by each column in the second. \n\nFor example, suppose we want to multiply two matrices \n$A = \\left\\lbrack\n    \\begin{matrix}\n        1 & 6  \\\\\n        4 & 3\n    \\end{matrix}\n    \\right\\rbrack$\nand\n$B = \\left\\lbrack\n    \\begin{matrix}\n        -3 & 0  \\\\\n        2 & -5\n    \\end{matrix}\n    \\right\\rbrack.$\n\nThe matrices $A$ and $B$ are both $2 \\times 2$ matrices, and their product will be another $2 \\times 2$ matrix $C,$ as follows:\n\n$$\n\\eqalign {\n\t\\underbrace{\n    \\left\\lbrack\n    \\begin{matrix}\n        1 & 6  \\\\\n        4 & 3\n    \\end{matrix}\n    \\right\\rbrack}_{A}\n\n\t\\underbrace{\n    \\left\\lbrack\n    \\begin{matrix}\n        -3 & 0  \\\\\n        2 & -5\n    \\end{matrix}\n    \\right\\rbrack}_{B}\n\n\t&= \n\t\\underbrace{\n    \\left\\lbrack\n    \\begin{matrix}\n        \\ast & \\ast   \\\\\n        \\ast & \\ast \n    \\end{matrix}\n    \\right\\rbrack\n\t}_{C}\n}\n$$\n\nNow, we calculate the entries of $C$ (shown as $\\ast$'s in the equation above).\n\nTo find $c_{11},$ the entry at the intersection of the 1st row and 1st column, we calculate the dot product of the 1st row of $A$ and the 1st column of $B\\mathbin{:}$\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\begin{matrix}\n        \\color{blue}{1} & \\color{blue}{6}  \\\\\n        4 & 3\n    \\end{matrix}\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\begin{matrix}\n        \\color{red}{-3} & 0  \\\\\n        \\color{red}{2} & -5\n    \\end{matrix}\n    \\right\\rbrack\n\n\t&= \n    \\left\\lbrack\n    \\begin{matrix}\n        {\\color{blue}{1}} \\cdot ({\\color{red}{-3}}) + {\\color{blue}{6}} \\cdot {\\color{red}{2}} & \\ast   \\\\\n        \\ast & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n\n\t= \\left\\lbrack\n    \\begin{matrix}\n        9 & \\ast   \\\\\n        \\ast & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n}\n$$\n\nTo find $c_{12},$ the entry at the intersection of the 1st row and 2nd column, we calculate the dot product of the 1st row of $A$ and the 2nd column of $B\\mathbin{:}$\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\begin{matrix}\n        \\color{blue}{1} & \\color{blue}{6}  \\\\\n        4 & 3\n    \\end{matrix}\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\begin{matrix}\n        -3 & \\color{red}{0}  \\\\\n        2 & \\color{red}{-5}\n    \\end{matrix}\n    \\right\\rbrack\n\n\t&= \n    \\left\\lbrack\n    \\begin{matrix}\n        9 & {\\color{blue}{1}} \\cdot {\\color{red}{0}} + {\\color{blue}{6}} \\cdot ({\\color{red}{-5}})   \\\\\n        \\ast & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n\n\t= \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        \\ast & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n}\n$$\n\nTo find $c_{21},$ the entry at the intersection of the 2nd row and 1st column, we calculate the dot product of the 2nd row of $A$ and the 1st column of $B\\mathbin{:}$\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\begin{matrix}\n        {1} & {6}  \\\\\n        \\color{blue}{4} & \\color{blue}{3}\n    \\end{matrix}\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\begin{matrix}\n        \\color{red}{-3} & 0  \\\\\n        \\color{red}{2} & -5\n    \\end{matrix}\n    \\right\\rbrack\n\n\t&= \n    \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        {\\color{blue}{4}} \\cdot ({\\color{red}{-3}}) + {\\color{blue}{3}} \\cdot {\\color{red}{2}} & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n\n\t= \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        -6 & \\ast\n    \\end{matrix}\n    \\right\\rbrack\n}\n$$\n\nTo find $c_{22},$ the entry at the intersection of the 2nd row and 2nd column, we calculate the dot product of the 2nd row of $A$ and the 2nd column of $B\\mathbin{:}$\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\begin{matrix}\n        {1} & {6}  \\\\\n        \\color{blue}{4} & \\color{blue}{3}\n    \\end{matrix}\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\begin{matrix}\n        -3 & \\color{red}{0}  \\\\\n        2 & \\color{red}{-5}\n    \\end{matrix}\n    \\right\\rbrack\n\n\t&= \n    \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        -6 & {\\color{blue}{4}} \\cdot {\\color{red}{0}} + {\\color{blue}{3}} \\cdot ({\\color{red}{-5}})\n    \\end{matrix}\n    \\right\\rbrack\n\n\t= \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        -6 & -15\n    \\end{matrix}\n    \\right\\rbrack\n}\n$$\n\nTherefore, our final answer is\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\begin{matrix}\n        {1} & {6}  \\\\\n        4 & 3\n    \\end{matrix}\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\begin{matrix}\n        -3 & 0  \\\\\n        2 & -5\n    \\end{matrix}\n    \\right\\rbrack\n\n\t= \\left\\lbrack\n    \\begin{matrix}\n        9 & -30   \\\\\n        -6 & -15\n    \\end{matrix}\n    \\right\\rbrack.\n}\n$$" :tutorial/id #uuid "f1be57fa-6725-5805-b38d-493945b33af9" :tutorial/math-academy-id 2989 :tutorial/title "Introduction"} :step/id #uuid "1946a4ad-a7ef-5e40-b53e-01ba313b5d21" :step/next {:db/id #edb/ref 17592186060647}} {:db/id #edb/ref 17592186060647 :step/content {:db/id #edb/ref 17592186059746 :knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3"} :step/id #uuid "f338c833-45a2-5451-b0e5-90d0a75602ee" :step/next {:db/id #edb/ref 17592186060727}} {:db/id #edb/ref 17592186060648 :step/content {:db/id #edb/ref 17592186059747 :knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8"} :step/id #uuid "2835449e-b103-5607-811a-92a9c8f47ae2"} {:db/id #edb/ref 17592186060727 :step/content {:db/id #edb/ref 17592186059800 :knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00"} :step/id #uuid "cac046c9-1569-53e0-8937-5363a2cd2d34" :step/next {:db/id #edb/ref 17592186060648}}] :activity/title "Multiplying Square Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186059881}] :db/id #edb/ref 17592186048297 :topic/knowledge-points [{:db/id #edb/ref 17592186059746 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059555 :question/id #uuid "04e1822f-2da1-5b28-8967-7a0026c39319" :question/math-academy-id "e-4401" :question/problem "Find $AB$ and $BA,$ if \n$\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1\\cdot 0+0\\cdot (-1) & 1\\cdot 1+0\\cdot 2 \\\\ -5\\cdot 0+1\\cdot (-1) & -5\\cdot 1+1\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -1 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}BA & =\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1+1\\cdot (-5) & 0\\cdot 0+1\\cdot 1 \\\\ -1\\cdot 1+2\\cdot (-5) & -1\\cdot 0+2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 1 \\\\ -11 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\n**Watch out!** Notice that \n\n$$\nAB \\neq BA.\n$$\n\nMatrix multiplication is not **commutative**, meaning that when we switch the order of multiplication, we often get a different result (like we did in this example)."} :knowledge-point/id #uuid 