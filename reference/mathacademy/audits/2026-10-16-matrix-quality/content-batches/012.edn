{2}{y}_{1}+2{y}_{2}^{2}-{y}_{1}^{2}+4{y}_{1}{y}_{2}-4{y}_{2}^{2} \\\\  & =-{y}_{1}^{2}+3{y}_{1}{y}_{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15af3a2b-005d-589c-8b51-669da6c394e1" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186354860} {:answer/id #uuid "7f254103-da65-5ea6-b832-fc5c91c6296f" :answer/type {:db/ident :answer.type/math} :answer/value "-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355782} {:answer/id #uuid "83decb3b-6b70-5f63-8936-7619a5f23daf" :answer/type {:db/ident :answer.type/math} :answer/value "-3{y}_{1}^{2}-9{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355826} {:answer/id #uuid "98e4be99-59c3-5ae9-82db-7f1009beb920" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}_{1}^{2}+4{y}_{1}{y}_{+}{y}_{2}^{2}" :db/id #edb/ref 17592186356019} {:answer/id #uuid "cbb47751-829f-5aab-b494-00d0a3d96200" :answer/type {:db/ident :answer.type/math} :answer/value "5{y}_{1}^{2}-6{y}_{1}{y}_{2}+{y}_{2}^{2}" :db/id #edb/ref 17592186356441}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}" :db/id #edb/ref 17592186355782} :answer-field/id #uuid "70d14260-2556-52c8-a989-5191e23d9daa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357116}] :question/id #uuid "8e3709ff-318c-5598-82d8-cdf2103d7ab9" :question/math-academy-id "q-94166" :question/problem "Given that \n\n$$\n\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},\n$$\n\n express the quadratic form $Q(x)={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2}$ in terms of the components of $y.$" :question/worked-solution "First, notice that \n\n$$\n\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}\n$$\n\ngives the following expressions for ${y}_{1}$ and ${y}_{2}:$\n\n$$\n\\begin{aligned}{y}_{1} & ={x}_{1} \\\\ {y}_{2} & =-{x}_{1}-{x}_{2}\\end{aligned}\n$$\n\nBy solving the first equation for ${x}_{1}$ and substituting it into the second equation, we obtain the following expressions for ${x}_{1}$ and ${x}_{2}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={y}_{1} \\\\ {x}_{2} & =-{y}_{1}-{y}_{2}\\end{aligned}\n$$\n\nNow, we substitute these into our quadratic form expression:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+5{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & ={y}_{1}^{2}+5{y}_{1}(-{y}_{1}-{y}_{2})-(-{y}_{1}-{y}_{2})^{2} \\\\  & ={y}_{1}^{2}-5{y}_{1}^{2}-5{y}_{1}{y}_{2}-{y}_{1}^{2}-2{y}_{1}{y}_{2}-{y}_{2}^{2} \\\\  & =-5{y}_{1}^{2}-7{y}_{1}{y}_{2}-{y}_{2}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a67e30-680d-511e-bfe1-bea257f28b03" :answer/type {:db/ident :answer.type/math} :answer/value "-12{y}_{2}^{2}-2{y}_{1}{y}_{2}" :db/id #edb/ref 17592186354685} {:answer/id #uuid "0c1edce9-c370-5e40-b12f-1849a61198a9" :answer/type {:db/ident :answer.type/math} :answer/value "-12{y}_{1}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186354775} {:answer/id #uuid "ae0de4f9-f14a-5370-9df7-aef8e3b8fa29" :answer/type {:db/ident :answer.type/math} :answer/value "-11{y}_{2}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186356199} {:answer/id #uuid "b4643982-e229-50af-bf2a-dd5b01412401" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}_{2}^{2}-8{y}_{1}{y}_{2}" :db/id #edb/ref 17592186356248} {:answer/id #uuid "d56fbb6c-5c63-5086-9cc6-6a7d2296760f" :answer/type {:db/ident :answer.type/math} :answer/value "-9{y}_{1}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186356533}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-11{y}_{2}^{2}-4{y}_{1}{y}_{2}" :db/id #edb/ref 17592186356199} :answer-