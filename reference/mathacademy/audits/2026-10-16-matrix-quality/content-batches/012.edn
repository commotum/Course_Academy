 -3\\end{bmatrix},\\,H=\\begin{bmatrix}4 & -5 \\\\ 2 & 7\\end{bmatrix}?\n$$\n\n${f}_{12}=$\n{{field-1}}" :question/worked-solution "Multiplying the $1$st row in $G$ by the $2$nd column in $H$, we get\n\n$$\n\\begin{aligned}{f}_{12} & =\\begin{bmatrix}-2 & 6\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix} \\\\  & =(-2)\\cdot (-5)+6\\cdot 7 \\\\  & =10+42 \\\\  & =52.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0034e544-a080-5809-89cc-218623e3663b" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186290635}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186290635} :answer-field/id #uuid "dd6f340c-7271-54d2-94c0-4ddba97d11b4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292425}] :question/id #uuid "29fe9272-96a8-5a1b-ad6e-fffdc1d62f3a" :question/math-academy-id "q-275396" :question/problem "Let $G=HM.$ What is the value of ${g}_{32}$, if\n\n$$\nH=\\begin{bmatrix}0 & 2 & 3 & 1 \\\\ 1 & -1 & 4 & 2 \\\\ 5 & 0 & -2 & 3 \\\\ 2 & 4 & -1 & -3\\end{bmatrix},\\,M=\\begin{bmatrix}3 & 0 & 2 & 1 \\\\ 4 & 5 & -3 & 2 \\\\ 1 & -2 & 4 & 0 \\\\ -1 & 3 & 0 & 5\\end{bmatrix}?\n$$\n\n${g}_{32}=$\n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $H$ by the $2$nd column in $M$, we get\n\n$$\n\\begin{aligned}{g}_{32} & =\\begin{bmatrix}5 & 0 & -2 & 3\\end{bmatrix}\\begin{bmatrix}0 \\\\ 5 \\\\ -2 \\\\ 3\\end{bmatrix} \\\\  & =5\\cdot 0+0\\cdot 5+(-2)\\cdot (-2)+3\\cdot 3 \\\\  & =0+0+4+9 \\\\  & =13.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd420fc-09da-5575-bb13-8dae3807c82e" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186297867}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186297867} :answer-field/id #uuid "be3e87de-fe88-56bb-80db-9f169d594363" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299279}] :question/id #uuid "0c62cdd0-7f3d-58e7-92ef-fef8407af2cc" :question/math-academy-id "q-318317" :question/problem "Let $F=GH.$ What is the value of ${f}_{21}$, if\n\n$$\nG=\\begin{bmatrix}-1 & 4 \\\\ 5 & -2\\end{bmatrix},\\,H=\\begin{bmatrix}3 & -6 \\\\ 1 & 2\\end{bmatrix}?\n$$\n\n${f}_{21}=$ \n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $G$ by the $1$st column in $H$, we get\n\n$$\n\\begin{aligned}{f}_{21} & =\\begin{bmatrix}5 & -2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix} \\\\  & =5\\cdot 3+(-2)\\cdot 1 \\\\  & =15-2 \\\\  & =13.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7ca4724-bc3e-5a01-96cf-e7f685eccbf5" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298608}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298608} :answer-field/id #uuid "806a02f5-0dff-5244-92bf-b7dbb65e825f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299073}] :question/id #uuid "c7d9a2a2-ee27-5967-8265-e9cb72ae952c" :question/math-academy-id "q-318319" :question/problem "Let $G=HM.$ What is the value of ${g}_{31}$, if\n\n$$\nH=\\begin{bmatrix}2 & -1 & 0 & 3 \\\\ 4 & 2 & -2 & 1 \\\\ -3 & 5 & 1 & 0 \\\\ 1 & -4 & 2 & 2\\end{bmatrix},\\,M=\\begin{bmatrix}1 & 2 & -1 & 0 \\\\ 3 & -2 & 4 & 1 \\\\ 0 & 5 & -3 & 2 \\\\ 2 & 1 & 0 & -2\\end{bmatrix}?\n$$\n\n${g}_{31}=$ \n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $H$ by the $1$st column in $M$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =\\begin{bmatrix}-3 & 5 & 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\  & =(-3)\\cdot 1+5\\cdot 3+1\\cdot 0+0\\cdot 2 \\\\  & =-3+15+0+0 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fe701a-247d-5d86-9db0-38387dc81bc8" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186336272} {:answer/id #uuid "1c04f170-66ce-5cab-ac19-815547c98051" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186336294} {:answer/id #uuid "700df25f-bddf-598d-8139-fa9f31d68d71" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186337025} {:answer/id #uuid "90b02077-646f-592c-b648-7044d4e3acbd" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186337345} {:answer/id #uuid "c0da2936-a49d-5ded-8eb9-ed2fe5657444" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337744}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186336272} :answer-field/id #uuid "d5785910-958c-59d0-876f-2c3067bdb107" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338652}] :question/id #uuid "bc5ecc6b-0e22-5096-9770-11e967093ff4" :question/math-academy-id "q-70194" :question/problem "Let $F=GH.$ What is the value of ${f}_{12}$, if\n\n$$\nG=\\begin{bmatrix}2 & 3 \\\\ 4 & -2\\end{bmatrix},\\,H=\\begin{bmatrix}-1 & 3 \\\\ 6 & 5\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $1$st row in $G$ by the $2$nd column in $H$, we get\n\n$$\n\\begin{aligned}{f}_{12} & =\\begin{bmatrix}2 & 3\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix} \\\\  & =2\\cdot 3+3\\cdot 5 \\\\  & =6+15 \\\\  & =21.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1894a3-3720-561d-9e41-81bedf568f25" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336175} {:answer/id #uuid "9557a07b-21fd-5aa6-bddc-f355baff9b67" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186337397} {:answer/id #uuid "a5609983-13f0-5007-977a-5372f67a3696" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186337534} {:answer/id #uuid "e66e0fea-91b2-5e6e-9686-96ea15f8c2fc" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186338042} {:answer/id #uuid "f1077a5d-af9f-5f6f-b2ac-ddad0f3e14e1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338141}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186337534} :answer-field/id #uuid "59724080-2034-5cdf-8760-dc19dc2c78e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338429}] :question/id #uuid "70847e31-5169-5229-9921-fa472e145099" :question/math-academy-id "q-70197" :question/problem "If $Q=WZ$, where \n$W=\\begin{bmatrix}0 & -4 & 3 & 0 \\\\ -2 & 0 & 1 & -1 \\\\ -11 & 5 & -3 & 3 \\\\ 1 & -5 & 7 & 10\\end{bmatrix}$\nand \n$Z=\\begin{bmatrix}1 & 3 & -5 & 2 \\\\ -1 & 0 & 3 & 5 \\\\ 5 & -1 & 2 & 7 \\\\ 0 & 9 & 8 & 9\\end{bmatrix}$, then ${q}_{24}=$" :question/worked-solution "Multiplying the $2$nd row in $W$ by the $4$th column in $Z$, we get\n\n$$\n\\begin{aligned}{q}_{24} & =\\begin{bmatrix}-2 & 0 & 1 & -1\\end{bmatrix}\\begin{bmatrix}2 \\\\ 5 \\\\ 7 \\\\ 9\\end{bmatrix} \\\\  & =(-2)\\cdot 2+0\\cdot 5+1\\cdot 7+(-1)\\cdot 9 \\\\  & =-4+0+7-9 \\\\  & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0673a468-a30b-5b10-8cc9-2c577a74e33a" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186336082} {:answer/id #uuid "5b27cf23-3310-5afb-be3d-55b470be606f" :answer/type {:db/ident :answer.type/math} :answer/value "-49" :db/id #edb/ref 17592186336859} {:answer/id #uuid "85abc929-a44d-5970-a60e-f953e4e78678" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186337238} {:answer/id #uuid "cea811c0-fcc8-53b4-bc71-d15d3d9d1c59" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186337840} {:answer/id #uuid "ef578305-417a-53f0-9084-420dfbb68dc7" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186338126}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186336082} :answer-field/id #uuid "622b1b4d-5ab8-5841-beff-5e0a9aa275b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338452}] :question/id #uuid "9eaf7027-b9ff-5705-84da-2bd63faabbf6" :question/math-academy-id "q-70198" :question/problem "If $D=MN$, where \n$M=\\begin{bmatrix}3 & 2 & 1 & 0 \\\\ 2 & 0 & 3 & 1 \\\\ 5 & 4 & 7 & 3 \\\\ -1 & 3 & -2 & -4\\end{bmatrix}$\nand \n$N=\\begin{bmatrix}0 & -4 & 3 & 0 \\\\ -2 & 0 & 1 & -1 \\\\ -11 & 5 & -3 & 3 \\\\ 1 & -5 & 7 & 10\\end{bmatrix}$, then ${d}_{34}=$" :question/worked-solution "Multiplying the $3$rd row in $M$ by the $4$th column in $N$, we get\n\n$$\n\\begin{aligned}{d}_{34} & =\\begin{bmatrix}5 & 4 & 7 & 3\\end{bmatrix}\\begin{bmatrix}0 \\\\ -1 \\\\ 3 \\\\ 10\\end{bmatrix} \\\\  & =5\\cdot 0+4\\cdot (-1)+7\\cdot 3+3\\cdot 10 \\\\  & =0-4+21+30 \\\\  & =47.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e87020f-a1a2-5550-b424-ca8a36fb5e47" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186342885} {:answer/id #uuid "4ec62960-9b9f-5dbe-91ab-850722f4e729" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186342887} {:answer/id #uuid "64180b08-3f71-59dd-90e0-90dea28ee95e" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186343089} {:answer/id #uuid "91130e08-082e-5cb7-a2c7-4dd80867866a" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186343507} {:answer/id #uuid "bc7761b5-0a6c-5936-8c5a-de0e4a27cf87" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186343895}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186342887} :answer-field/id #uuid "a00a19b4-db54-5703-b836-7c731faeed36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344776}] :question/id #uuid "6eeac7ee-9286-57c4-a413-7511fe459e52" :question/math-academy-id "q-77461" :question/problem "If $P=QR$, where \n$Q=\\begin{bmatrix}5 & -1 & 3 & -1 \\\\ 2 & 4 & 6 & 2 \\\\ 4 & -2 & 4 & -5 \\\\ 1 & 3 & 6 & -3\\end{bmatrix}$\nand \n$R=\\begin{bmatrix}1 & 3 & -2 & -1 \\\\ 0 & 7 & 6 & 4 \\\\ 2 & 4 & 3 & 2 \\\\ 5 & 2 & 2 & -4\\end{bmatrix}$, then ${p}_{34}=$" :question/worked-solution "Multiplying the $3$rd row in $Q$ by the $4$th column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{34} & =\\begin{bmatrix}4 & -2 & 4 & -5\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 4 \\\\ 2 \\\\ -4\\end{bmatrix} \\\\  & =4\\cdot (-1)+(-2)\\cdot 4+4\\cdot 2+(-5)\\cdot (-4) \\\\  & =-4-8+8+20 \\\\  & =16.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :topic/math-academy-id 147 :topic/title "Multiplying Square Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186162852} :activity/id #uuid "91237c92-d7c1-506c-95d7-177c7680008d" :activity/steps [{:db/id #edb/ref 17592186162852 :step/content {:db/id #edb/ref 17592186163227 :tutorial/content "Suppose we are given the quadratic form \n\n$$\nQ(\\mathbf{x})= x_1^2-8x_1x_2 + x_2^2\n$$\n\n and the matrix ![](images/13/13fad01fd9fcf327f8c45afa8264d92d9de1db135b7a87add4e43b9617574d8d.svg) that defines  the **change of variable**\n\n$$\n\\mathbf{x} =P \\mathbf{y} ,\n$$\n\n \n\nwhere ![](images/c6/c6f0e1bf4282bf2ffedc462005ea30ad8bbe07917bab42eaf7fedf8fd2c49ef7.svg) and ![](images/ad/ad7dec0dac6e2a50d428c7d7dbeda4e71812df2f6ac2d80d6d834ffc82f4a0cb.svg) \n\n How do we express $Q(\\mathbf{x})$ in terms of the components of $\\mathbf{y}?$\n\nFirst, notice that\n\n![](images/ae/aefd4438342fcc5201fd2a3a04e4419f9c5189c4cd103eb63fa1ab6d464edc35.svg) \n\ngives the following expressions for $x_1$ and $x_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}_{1} & =2{y}_{1}-{y}_{2} \\\\ {x}_{2} & =-{y}_{2}\\end{aligned}\n$$\n\nSo, if we substitute these into our quadratic form expression, we get:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-8{x}_{1}{x}_{2}+{x}_{2}^{2} \\\\  & =(2{y}_{1}-{y}_{2})^{2}+8(2{y}_{1}-{y}_{2}){y}_{2}+(-{y}_{2})^{2} \\\\  & =4{y}_{1}^{2}-4{y}_{1}{y}_{2}+{y}_{2}^{2}+16{y}_{1}{y}_{2}-8{y}_{2}^{2}+{y}_{2}^{2} \\\\  & =4{y}_{1}^{2}+12{y}_{1}{y}_{2}-6{y}_{2}^{2}\\end{aligned}\n$$" :tutorial/id #uuid "129771b6-7bea-5c9d-b4c7-05ef8a7493b2" :tutorial/math-academy-id 4885 :tutorial/title "Introduction"} :step/id #uuid "b50d538b-7a37-5a5b-af5f-d7d425017761" :step/next {:db/id #edb/ref 17592186162873}} {:db/id #edb/ref 17592186162873 :step/content {:db/id #edb/ref 17592186161991 :knowledge-point/id #uuid "f203c9bf-7d12-56db-aafe-6639162eae93"} :step/id #uuid "865b4c88-60a2-55e6-b4b2-f027d0718ebe" :step/next {:db/id #edb/ref 17592186162874}} {:db/id #edb/ref 17592186162874 :step/content {:db/id #edb/ref 17592186161992 :knowledge-point/id #uuid "9f2a5391-d8bb-5084-941a-bb787e8729f3"} :step/id #uuid "124e7230-af5a-57e2-95dc-9c539b7d58db" :step/next {:db/id #edb/ref 17592186162875}} {:db/id #edb/ref 17592186162875 :step/content {:db/id #edb/ref 17592186163236 :tutorial/content "Suppose we are given a quadratic form \n\n$$\nQ(\\mathbf{x})= \\mathbf{x}^T \\! A\\mathbf{x}\n$$\n\n \n\nand an invertible matrix $P$ that defines  the change of variable\n\n$$\n\\mathbf{x} =P \\mathbf{y}.\n$$\n\n  \n\nIf this change of variable is applied to the quadratic form $Q(\\mathbf{x}),$ what will be the new matrix of $Q$?\n\nBy making the necessary substitutions, we obtain the following:\n\n$$\n\\begin{aligned}Q(x) & ={x}^{T}\\,Ax \\\\  & =(Py)^{T}\\,A\\,(Py) \\\\  & ={y}^{T}{P}^{T}\\,AP\\,y \\\\  & ={y}^{T}({P}^{T}AP)y\\end{aligned}\n$$\n\nTherefore,  the new matrix of our quadratic form is \n\n$$\nB=  P^T \\! A P.\n$$" :tutorial/id #uuid "61f41743-ca11-557a-b0c1-bba72921428a" :tutorial/math-academy-id 4901 :tutorial/title "The Connection Between Matrices of Quadratic Forms in Different Bases"} :step/id #uuid "5900140f-95ae-5f3f-85f7-2351c6ab39d0" :step/next {:db/id #edb/ref 17592186162876}} {:db/id #edb/ref 17592186162876 :step/content {:db/id #edb/ref 17592186161993 :knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa"} :step/id #uuid "d3a1f8da-11aa-5561-b435-f00a5790a026" :step/next {:db/id #edb/ref 17592186162877}} {:db/id #edb/ref 17592186162877 :step/content {:db/id #edb/ref 17592186163237 :tutorial/content "Two quadratic forms $Q_1$ and $Q_2$ on $\\Bbb R^n$ are said to be **equivalent** if they can be obtained from each other through a change of variable.\n\n*The two quadratic forms with matrices $A$ and $B$ are equivalent if and only if there exists an invertible matrix $P$ such that* \n\n$$\nB = P^T \\! A \\, P.\n$$\n\n**Note:** Equivalent quadratic forms represent the same function from  $\\Bbb R^n$ to $\\Bbb R.$" :tutorial/id #uuid "abe7e02c-7997-5e41-9c51-98c6291198a1" :tutorial/math-academy-id 4902 :tutorial/title "Equivalent Quadratic Forms"} :step/id #uuid "75121285-4880-5444-b03b-36d42d881cfe"}] :activity/title "Change of Variables in Quadratic Forms" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186162218} {:activity/first-step {:db/id #edb/ref 17592186503828} :activity/id #uuid "e8bff054-dda8-555c-88cb-c434ecb5f2f5" :activity/steps [{:db/id #edb/ref 17592186503773 :step/content {:db/id #edb/ref 17592186357686 :question/id #uuid "e3dc7c55-f986-54b3-95d7-1e0702bd8e87"} :step/id #uuid "2