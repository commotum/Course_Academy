 17592186559967 :step/content {:db/id #edb/ref 17592186400763 :question/id #uuid "925e17f0-1f91-564c-b150-3d5633a84c6e"} :step/id #uuid "c3193284-a25f-5adc-93c6-8cfd1305db8b" :step/next {:db/id #edb/ref 17592186559900}}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186559013} {:activity/first-step {:db/id #edb/ref 17592186564591} :activity/id #uuid "8c4631f5-ce38-50ca-8db4-4b2dd080d0df" :activity/steps [{:db/id #edb/ref 17592186564554 :step/content {:db/id #edb/ref 17592186400763 :question/id #uuid "925e17f0-1f91-564c-b150-3d5633a84c6e"} :step/id #uuid "410080ab-5733-5c31-94d9-fda79a0bc8c5" :step/next {:db/id #edb/ref 17592186564598}} {:db/id #edb/ref 17592186564556 :step/content {:db/id #edb/ref 17592186503755 :question/id #uuid "f2c3caea-6032-5d20-9fea-52c78472efb1"} :step/id #uuid "45611da9-d3af-5cc7-b007-af7ba19a6423" :step/next {:db/id #edb/ref 17592186564554}} {:db/id #edb/ref 17592186564565 :step/content {:db/id #edb/ref 17592186269240 :question/id #uuid "ed90c3b2-491c-5a1e-a27e-a0b50d59ad00"} :step/id #uuid "7935da3a-469b-5bce-9e33-166b16dfa9be" :step/next {:db/id #edb/ref 17592186564556}} {:db/id #edb/ref 17592186564591 :step/content {:db/id #edb/ref 17592186162362 :question/id #uuid "ba175b74-8169-5d32-9cc8-7cf8e202ba3f"} :step/id #uuid "ec8da15c-64b8-543b-87b6-4d2e08009505" :step/next {:db/id #edb/ref 17592186564565}} {:db/id #edb/ref 17592186564598 :step/content {:db/id #edb/ref 17592186269246 :question/id #uuid "5f621452-f60c-5e1d-b4df-620aa05fd780"} :step/id #uuid "fdfac010-d775-5eb5-8960-f4712e637036"}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186563963}] :db/id #edb/ref 17592186050205 :topic/knowledge-points [{:db/id #edb/ref 17592186162097 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161910 :question/id #uuid "f4a3741e-a87c-5b57-95b3-5ef47f7ad599" :question/math-academy-id "e-9907" :question/problem "A $2 \\times 3$ matrix $A$ maps the unit sphere $\\big\\{ \\mathbf{x} \\,|\\, \\| \\mathbf{x} \\| =1 \\big\\}$ from $\\mathbb{R}^3$ onto an ellipse in $\\mathbb{R}^2.$ Given that the eigenvalues of $A^T A$ are $7, 2,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere $\\big\\{ \\mathbf{x} \\,|\\, \\| \\mathbf{x} \\| =1 \\big\\}$ from $\\mathbb{R}^3$ onto the ellipse $\\big\\{ A\\mathbf{x} \\,|\\, \\| \\mathbf{x} \\| =1 \\big\\}$ in $\\mathbb{R}^2.$\n\nFirst, let's re-write the squared distance from the origin to the point $A\\mathbf{x}$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere $\\mathbf{x}^T (A^T A) \\mathbf{x}$ is the quadratic form with the matrix $A^T A.$ \n\nThe maximum value of this quadratic form, when $\\| \\mathbf{x} \\| =1,$ is equal to the largest eigenvalue of the matrix $A^T A.$\n\nSince the largest eigenvalue of $A^T A$ is $7,$ we obtain\n\n$$\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\|^2 \\big\\} = 7\n\\qquad\\Longrightarrow\\qquad\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\| \\big\\}  = \\sqrt{7}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{7}.$"} :knowledge-point/id #uuid "d116374b-b693-5d50-8019-fcc5a7766b9b" :knowledge-point/questions [{:db/id #edb/ref 17592186162360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5884f354-e5d3-5445-b252-6177d7fb10d2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266935} {:answer/id #uuid "59a2b792-bce2-5ab3-8129-3ed501c97fa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186266941} {:answer/id #uuid "66a53c17-6cca-59e9-b3a7-10509d1e6f05" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267055} {:answer/id #uuid "7ed785dc-de4a-56df-9005-91dc3382836b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267261} {:answer/id #uuid "c268b638-dc68-5720-86dc-4bdf86ac9c78" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186267877}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186266941} :answer-field/id #uuid "71f2e673-2942-5733-b153-c9e00dd002b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268619}] :question/id #uuid "b2e59ffd-322c-5739-bff6-4abbfbcffef1" :question/math-academy-id "q-139415" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $5,$ $3,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $5,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=5\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{5}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{5}.$"} {:db/id #edb/ref 17592186162364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fdb6b55-695e-5cf8-8f1e-4b21b778d321" :answer/type {:db/ident :answer.type/math} :answer/value "5\\s