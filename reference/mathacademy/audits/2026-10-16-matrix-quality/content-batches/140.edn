gned}]" :db/id #edb/ref 17592186550756} {:answer/id #uuid "d3793b8d-2960-58c7-afcf-120f39097ca4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & -4 & 2 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186550938} {:answer/id #uuid "dfe4a5b1-a271-5ca0-b99e-5d25ada3dd88" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ -4 \\\\ -1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186550980} {:answer/id #uuid "e2b5f77a-6357-5f9d-a83c-5e2d8467f25d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186550987}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186550987} :answer-field/id #uuid "25a7cb9f-7a09-5793-9cb0-c7d79f0245b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551086}] :question/id #uuid "edc742b5-3b4b-536d-82ef-b613c6a8e953" :question/math-academy-id "q-139577" :question/problem "| $x$ | **$-3$** | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $5$ | $10$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the observation vector $y$ in this context?" :question/worked-solution "| $x$ | **$-3$** | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $5$ | $10$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id #edb/ref 17592186557275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0878219e-c2fd-51d0-8c0f-8887e9b9bcc2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 1 & 1 & 1 \\\\ -6 & -3 & 0 & 4 & 6\\end{aligned}]" :db/id #edb/ref 17592186556448} {:answer/id #uuid "5fda055d-c731-555a-bf72-502387bb59a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 1 & -3 \\\\ 1 & 0 \\\\ 1 & 4 \\\\ 1 & 6\\end{aligned}]" :db/id #edb/ref 17592186556646} {:answer/id #uuid "74dde18c-c7c1-59de-833d-07f07f975058" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-15 & -6 \\\\ -10 & -3 \\\\ -5 & 0 \\\\ 0 & 4 \\\\ 5 & 6\\end{aligned}]" :db/id #edb/ref 17592186556695} {:answer/id #uuid "8987fbb9-4e36-5a31-a1b1-46618db9cc66" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -15 \\\\ 1 & -10 \\\\ 1 & -5 \\\\ 1 & 0 \\\\ 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186556757} {:answer/id #uuid "f2120fda-c38d-5064-839f-093917dee005" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 1 & 1 & 1 \\\\ -15 & -10 & -5 & 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186557027}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -15 \\\\ 1 & -10 \\\\ 1 & -5 \\\\ 1 & 0 \\\\ 1 & 5\\end{aligned}]" :db/id #edb/ref 17592186556757} :answer-field/id #uuid "3086de9f-7992-5290-a78e-b92ab10911d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557095}] :question/id #uuid "7fc30a95-4823-5308-bc3d-c38eeb6c9b5d" :question/math-academy-id "q-139576" :question/problem "| $x$ | **$-15$** | **$-10$** | **$-5$** | **$0$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-3$ | $0$ | $4$ | $6$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" :question/worked-solution "| $x$ | **$-15$** | **$-10$** | **$-5$** | **$0$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-3$ | $0$ | $4$ | $6$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -15 \\\\ 1 & -10 \\\\ 1 & -5 \\\\ 1 & 0 \\\\ 1 & 5\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-6 \\\\ -3 \\\\ 0 \\\\ 4 \\\\ 6\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."} {:db/id #edb/ref 17592186557294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee8c8a2-5158-57a0-ad6b-eab622688ddb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 & 1 & 1 & 1 \\\\ -1 & 1 & 3 & 5 & 7\\end{aligned}]" :db/id #edb/ref 17592186556457} {:answer/id #uuid "1b31021f-f26a-5c88-9e24-49dab0b11f94" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 1 & 8 \\\\ 1 & 11 \\\\ 1 & 14 \\\\ 1 & 20\\end{aligned}]" :db/id #edb/ref 17592186556490} {:answer/id #uuid "593ac918-30c0-55f9-9a45-8bca67e90e57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ 1 & 1 \\\\ 1 & 3 \\\\ 1 & 5 \\\\ 1 & 7\\end{aligned}]" :db/id #edb/ref 17592186556633} {:answer/id #uuid "76e17d5a-5046-5304-9556-d61074ae42ff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 & 3 & 5 & 7 \\\\ 4 & 8 & 11 & 14 & 20\\end{aligned}]" :db/id #edb/ref 17592186556700} {:answer/id #uuid "b96491c1-3d2f-5012-a011-55c9cccc0e67" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 5 \\\\ 1 & 7 \\\\ 1 & 3 \\\\ 1 & -1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186556884}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ 1 & 1 \\\\ 1 & 3 \\\\ 1 & 5 \\\\ 1 & 7\\end{aligned}]" :db/id #edb/ref 17592186556633} :answer-field/id #uuid "c3f983e4-f068-54e8-9c9e-8a106c8c9d76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557177}] :question/id #uuid "b1f3a877-5233-5d11-bd7f-f8b8db99c5be" :question/math-academy-id "q-139575" :question/problem "| $x$ | **$-1$** | **$1$** | **$3$** | **$5$** | **$7$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $4$ | $8$ | $11$ | $14$ | $20$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the design matrix $X$ in this context?" :question/worked-solution "| $x$ | **$-1$** | **$1$** | **$3$** | **$5$** | **$7$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $4$ | $8$ | $11$ | $14$ | $20$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -1 \\\\ 1 & 1 \\\\ 1 & 3 \\\\ 1 & 5 \\\\ 1 & 7\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}4 \\\\ 8 \\\\ 11 \\\\ 14 \\\\ 20\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector."}] :knowledge-point/title "Identifying Elements of a Regression Line in Terms of Matrices and Vectors"}] :topic/math-academy-id 2169 :topic/title "Linear Regression With Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186163048} :activity/id #uuid "af1642f1-edfe-5e8b-bb3e-376bc11c5af4" :activity/steps [{:db/id #edb/ref 17592186163048 :step/content {:db/id #edb/ref 17592186163315 :tutorial/content "Let's suppose we are given the matrix\n\n![](images/18/18f57c05cb79918e17401427e3419648791562a5d38116582e0d396e20db1069.svg)\n\nThen, the corresponding linear transformation \n\n$$\n\\mathbf x \\mapsto A \\mathbf x\n$$\n\nmaps the unit circle $\\big\\{ \\mathbf x \\, | \\, \\|\\mathbf x\\|=1 \\big\\}$ in $\\mathbb R^2$ onto an ellipse $\\big\\{ A\\mathbf{x} \\,|\\, \\| \\mathbf{x} \\| =1 \\big\\}$ in $\\mathbb{R}^2,$ as shown below. \n\n![](images/c1/c163f7714d0e2045db37438b7ea66a2dc8ac92cfbe309a0d24c898bbfac8c295.png)\n\n \n\nHow can we find the maximum possible value of $\\|A \\mathbf x\\|?$ Geometrically, this is equivalent to finding the semi-major axis of our ellipse.\n\n![](images/86/866052291b0d7a416988c0c42fa99eec1d1bfd3b1344cf3cf2eb0a09457ae38d.png)\n\nFirst, we note the following:\n\n- The value of $\\mathbf x$ that maximizes $||A\\mathbf x||$ also maximizes $||A\\mathbf x||^2.$\n\n- If $\\mathbf v$ is a column vector, then $||\\mathbf v||^2 = \\mathbf v^T \\mathbf v\\mathbin{:}$\n\nTherefore, we can re-write the squared distance from the origin to the point $A\\mathbf{x}$ on our ellipse as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x\\end{aligned}\n$$\n\n  \n\nNote that $\\mathbf{x}^T (A^T A) \\mathbf{x}$ is a quadratic form with the matrix $A^T A.$ Therefore, the maximum value of this quadratic form for $\\| \\mathbf{x} \\| =1$ equals the largest eigenvalue of the matrix $A^T A.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}]}^{T}[\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 6 \\\\ 6 & 10\\end{aligned}].\\end{aligned}\n$$\n\nNext, we calculate the eigenvalues of the matrix $A^TA\\mathbin{:}$  \n\n$$\n\\begin{aligned}|{A}^{T}A-\\lambda I| & =0 \\\\ |\\begin{aligned}10-\\lambda  & 6 \\\\ 6 & 10-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )^{2}-36 & =0 \\\\ (10-\\lambda )^{2} & =36 \\\\ 10-\\lambda  & =\\pm 6 \\\\ \\lambda  & =4,\\,16\\end{aligned}\n$$\n\nSince the largest eigenvalue of $A^T A$ is $16,$ we obtain\n\n$$\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\|^2 \\big\\} = 16\n\\qquad\\Longrightarrow\\qquad\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\| \\big\\} = \\sqrt{16} = 4.\n$$\n\n \n\nTherefore, the length of the semi-major axis of our ellipse equals $4.$" :tutorial/id #uuid "b6f73158-b78c-5262-bb9d-a957e3f79fa3" :tutorial/math-academy-id 6133 :tutorial/title "Introduction"} :step/id #uuid "62510b93-1090-5902-b6a0-45fc7a644d01" :step/next {:db/id #edb/ref 17592186163049}} {:db/id #edb/ref 17592186163049 :step/content {:db/id #edb/ref 17592186162097 :knowledge-point/id #uuid "d116374b-b693-5d50-8019-fcc5a7766b9b"} :step/id #uuid "01d42207-c2b3-55a2-9d11-6fcda35c9cca" :step/next {:db/id #edb/ref 17592186163052}} {:db/id #edb/ref 17592186163050 :step/content {:db/id #edb/ref 17592186162098 :knowledge-point/id #uuid "9cec3c21-28df-52ba-9b78-86cffb4c7720"} :step/id #uuid "bc576dbc-6ac4-5a02-9348-f4cf6db1eb0c"} {:db/id #edb/ref 17592186163051 :step/content {:db/id #edb/ref 17592186162099 :knowledge-point/id #uuid "fd0e91f0-abbc-52e2-8d8b-94597e4892cd"} :step/id #uuid "94acc5c3-ff1a-5747-b32d-b0db6e46436e" :step/next {:db/id #edb/ref 17592186163050}} {:db/id #edb/ref 17592186163052 :step/content {:db/id #edb/ref 17592186163316 :tutorial/content "Let $A$ be an $m\\times n$ matrix. Then, $A^T A$ is always a symmetric, positive semi-definite matrix. In particular, $A^TA$ can be orthogonally diagonalized, and its eigenvalues are non-negative real numbers.\n\nThe **singular values** of  $A$ are defined as the square roots of the eigenvalues of the matrix $A^T A.$ The $i$th singular value of $A$ is denoted $\\sigma_i\\mathbin{:}$\n\n- $\\sigma_1 = \\sqrt{\\lambda_1}$\n\n- $\\sigma_2 = \\sqrt{\\lambda_2}$\n\n- $\\sigma_3 = \\sqrt{\\lambda_3}$\n\n$\\:\\vdots$\n\n- $\\sigma_n = \\sqrt{\\lambda_n}$\n\nWe usually list the singular values in *decreasing* order. \n\nNow, we know that $A^TA$ is orthogonally diagonalizable. Therefore, if\n\n$$\n\\left\\{\\mathbf v_1, \\mathbf v_2\\,\\ldots, \\mathbf v_n\\right\\}\n$$\n\nis an *orthonormal* basis of $\\mathbb R^n$ consisting of the eigenvectors of ${A^T}{A}$ with the corresponding eigenvalues \n\n$$\n\\lambda_1\\geq \\lambda_2\\geq \\ldots \\geq \\lambda_n,\n$$\n\nthen it can be shown that\n\n- $\\sigma_1 = \\sqrt{\\lambda_1}$ is the length of $A\\mathbf v_1,$\n\n- $\\sigma_2 = \\sqrt{\\lambda_2}$ is the length of $A\\mathbf v_2,$\n\n$\\:\\vdots$\n\n- $\\sigma_n = \\sqrt{\\lambda_n}$ is the length of $A\\mathbf v_n.$\n\nFurthermore:\n\n- $\\sigma_1$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x,$ and is attained on the unit eigenvector $\\mathbf v_1$\n\n- $\\sigma_2$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1,$ and is attained on the unit eigenvector $\\mathbf v_2$\n\n- $\\sigma_3$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1$ *and* $\\mathbf v_2,$ and is attained on the unit eigenvector $\\mathbf v_3$\n\n$\\:\\vdots$\n\n- $\\sigma_n$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1,\\mathbf v_2,\\ldots,\\mathbf v_{n-1},$ and is attained on the unit eigenvector $\\mathbf v_n$\n\nLet's take a look at a concrete example." :tutorial/id #uuid "f470bdb6-fa79-595c-beba-f8242d4426bd" :tutorial/math-academy-id 6134 :tutorial/title "The Singular Values of a Matrix"} :step/id #uuid "ef1b9251-7972-5caa-8ac8-321830fa4c27" :step/next {:db/id #edb/ref 17592186163056}} {:db/id #edb/ref 17592186163056 :step/content {:db/id #edb/ref 17592186163320 :tutorial/content "We've seen that for the matrix $A,$ given by\n\n![](images/9c/9c11e176876a767543250d5b18038cae7b14a36a692a6f14474da6b4312a48b9.svg)\n\nthe eigenvalues of $A^TA$ are $\\lambda_1=16$ and $\\lambda_2=4.$ It's easy to show that the corresponding unit eigenvectors of $A^T A$ are \n\n![](images/7c/7c44b67b766ea8385f4d7780523ee560bd3e215a0cee42db9baf208da471ccdd.svg) \n\nThe singular values of $A$ are\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{16}=4, \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2.\\end{aligned}\n$$\n\nPutting all of this information together gives us the following diagram. \n\n![](images/23/238f4ae60c783dd786476a339f012ef1b4ca82bcac7aa3f3ef4445726938ef3a.png)\n\n \n\nNote that our ellipse's semi-major and semi-minor axes are $\\sigma_1 = 4$ and $\\sigma_2 =2,$ respectively." :tutorial/id #uuid "a319c696-fd06-5e8f-99f1-26ad08271a27" :tutorial/math-academy-id 6139 :tutorial/title "Associating Singular Values With an Ellipse's Principal Axes"} :step/id #uuid "c9015782-c2cb-5d34-8e6d-84a7dd5678d9" :step/next {:db/id #edb/ref 17592186163051}}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186162225} {:activity/first-step {:db/id #edb/ref 17592186503786} :activity/id #uuid "d2500c5e-c96c-5026-89b9-c0eff4d22db5" :activity/steps [{:db/id #edb/ref 17592186503778 :step/content {:db/id #edb/ref 17592186269243 :question/id #uuid "0157c09c-4c34-5a09-a678-edce758d03a9"} :step/id #uuid "410ad0cd-66aa-589e-9d24-b7c90f23a34c" :step/next {:db/id #edb/ref 17592186503797}} {:db/id #edb/ref 17592186503786 :step/content {:db/id #edb/ref 17592186162363 :question/id #uuid "14414eae-18ed-5455-a3d4-1f9724606970"} :step/id #uuid "52f281c4-dfee-54b8-b75f-07ea8b7aff89" :step/next {:db/id #edb/ref 17592186503804}} {:db/id #edb/ref 17592186503797 :step/content {:db/id #edb/ref 17592186388618 :question/id #uuid "82b609f1-ebbe-5986-a6ff-a556a13681d3"} :step/id #uuid "74ddedfd-6201-5f03-9796-484a0235a391"} {:db/id #edb/ref 17592186503801 :step/content {:db/id #edb/ref 17592186503755 :question/id #uuid "f2c3caea-6032-5d20-9fea-52c78472efb1"} :step/id #uuid "80e7be25-cdff-5c16-856f-410a8631d1d8" :step/next {:db/id #edb/ref 17592186503778}} {:db/id #edb/ref 17592186503804 :step/content {:db/id #edb/ref 17592186269240 :question/id #uuid "ed90c3b2-491c-5a1e-a27e-a0b50d59ad00"} :step/id #uuid "85e42921-05f4-5ace-8862-09474ca442a5" :step/next {:db/id #edb/ref 17592186503801}}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186502976} {:activity/first-step {:db/id #edb/ref 17592186524075} :activity/id #uuid "eb21dc6b-2d80-592a-b7a0-6c3fee156a8e" :activity/steps [{:db/id #edb/ref 17592186524058 :step/content {:db/id #edb/ref 17592186412767 :question/id #uuid "d906fadc-a9c3-53a2-ad5f-49a5ac38ab8d"} :step/id #uuid "4b60e7be-0a56-5bba-9861-738aac8f8ee4" :step/next {:db/id #edb/ref 17592186524080}} {:db/id #edb/ref 17592186524075 :step/content {:db/id #edb/ref 17592186162360 