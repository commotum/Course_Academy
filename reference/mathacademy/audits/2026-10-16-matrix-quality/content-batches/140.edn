 & -1 \\\\ 0 & -1 & -1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8baaf290-a445-5025-beda-ab000eb04040" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340380} {:answer/id #uuid "bc09155c-f299-5462-a40e-0507de18bee7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340812} {:answer/id #uuid "c32d6304-857d-5df5-b7cc-0cf97c395f3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340864} {:answer/id #uuid "ce5d9f9d-d7d5-5b69-92ac-d988de00eb7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340963} {:answer/id #uuid "e418aad6-c44f-587d-a670-bd43608a8b63" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341148}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340380} :answer-field/id #uuid "5544a74c-7c97-5350-86be-dba4c5fa9890" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341533}] :question/id #uuid "8e8fc794-8de1-566d-a7d1-0246dc2589a9" :question/math-academy-id "q-73955" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}4 & 1 & -2 & -5 \\\\ 0 & 2 & -2 & -3 \\\\ 0 & 0 & 0 & -5\\end{bmatrix}.\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\left\\{\\begin{aligned}4x+y-2z &=-5 \\\\ 0x+2y-2z &=-3 \\\\ 0x+0y+0z &=-5\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-5,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186342120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2673e6f7-ecd7-5c19-81d2-deb331c597ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-3y \\\\ 4-z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186339464} {:answer/id #uuid "7492d919-7fd0-5479-9009-4e05ae6434ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8+6z \\\\ -4-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340170} {:answer/id #uuid "74b2fedc-15c3-5945-b2e9-bc715dd60744" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340172} {:answer/id #uuid "bdf64113-27ad-5d18-a678-09b7950fb099" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4-3z \\\\ 8+6z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340821} {:answer/id #uuid "f47c741c-d4d4-5753-9bc7-72bfa8f244b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8-2y+6z \\\\ -4-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341282}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340172} :answer-field/id #uuid "0e59d6b2-592f-5a0f-9148-1d9750258deb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341406}] :question/id #uuid "b176b3fe-cf93-51c6-8ce9-e7905742c0c0" :question/math-academy-id "q-73958" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & 2 & -6 & 8 \\\\ -2 & -5 & 0 & 0 \\\\ 0 & 1 & 12 & 18\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 2 & -6 & 8 \\\\ -2 & -5 & 0 & 0 \\\\ 0 & 1 & 12 & 18\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -6 & 8 \\\\ 0 & -1 & -12 & 16 \\\\ 0 & 1 & 12 & 18\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & -6 & 8 \\\\ 0 & -1 & -12 & 16 \\\\ 0 & 0 & 0 & 34\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y-6z &=8 \\\\ 0x-y-12z &=16 \\\\ 0x+0y+0z &=34\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=34,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186342121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a17e67-d12e-5f24-bd45-6190f67c0403" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6+3y-5z \\\\ -4-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186339175} {:answer/id #uuid "44f8bea9-4747-5665-befd-3c8bfa23ac91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12-2y \\\\ 4-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186339740} {:answer/id #uuid "9515ca94-3883-54e1-bdf2-d28a187b056a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6-3y+5z \\\\ -4-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340471} {:answer/id #uuid "a46cd1b4-490a-5f86-8236-a750bea84aad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-2y-6z \\\\ 4z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340622} {:answer/id #uuid "c1a91cf2-3fc6-5258-ac99-6447c287c2f9" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340852}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186340852} :answer-field/id #uuid "e2673df4-1d91-584b-9e78-f6203ebeaaad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341784}] :question/id #uuid "ba6ce214-f348-57ed-8c0e-e75dd14f4628" :question/math-academy-id "q-73959" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & 3 & -5 & 6 \\\\ 3 & 10 & -12 & 14 \\\\ 2 & 3 & -19 & 15\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 3 & -5 & 6 \\\\ 3 & 10 & -12 & 14 \\\\ 2 & 3 & -19 & 15\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -5 & 6 \\\\ 0 & 1 & 3 & -4 \\\\ 2 & 3 & -19 & 15\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -5 & 6 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & -3 & -9 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 & -5 & 6 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & 0 & 0 & -9\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+3y-5z &=6 \\\\ 0x+y+3z &=-4 \\\\ 0x+0y+0z &=-9\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-9,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186342122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "654f4e4b-68e6-5e19-a8a6-7b5f7780eaac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16+12y-6z \\\\ 1-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340025} {:answer/id #uuid "6b34b618-b3bb-583e-b711-31492585e9f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12y-6z \\\\ 1-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340077} {:answer/id #uuid "c3416e61-0a0a-5f9f-ab68-f08f001a0304" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12-2y-6z \\\\ 4-z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340865} {:answer/id #uuid "e288ca76-fc0b-506e-9fe5-8dad8ba5432c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16+6z \\\\ 12-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341134} {:answer/id #uuid "e512aed6-7ac8-5860-956d-1b0619e54cb8" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186341153}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186341153} :answer-field/id #uuid "9f2d14f8-14f9-5480-8110-243c4955270e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341662}] :question/id #uuid "2553c2bd-9198-50b3-b6db-dc189cb3e196" :question/math-academy-id "q-73960" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ \\frac{1}{2} & -2 & 5 & 12 \\\\ 2 & -20 & -4 & 25\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ \\frac{1}{2} & -2 & 5 & 12 \\\\ 2 & -20 & -4 & 25\\end{bmatrix} & {R}_{2} & :={R}_{2}-\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ 0 & 4 & 8 & 4 \\\\ 2 & -20 & -4 & 25\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ 0 & 4 & 8 & 4 \\\\ 0 & 4 & 8 & -7\\end{bmatrix} & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 4 & 8 & -7\\end{bmatrix} & {R}_{3} & :={R}_{3}-4{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -12 & -6 & 16 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 0 & 0 & -11\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-12y-6z &=16 \\\\ 0x+y+2z &=1 \\\\ 0x+0y+0z &=-11\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-11,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186395978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ffe24a8-fe0e-5039-81c0-fb9631f878a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-y-z \\\\ 4-z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395980} {:answer/id #uuid "30c4ec68-4b39-55b5-8e7c-bbe84a2b4057" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3y \\\\ y \\\\ 4y-1\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395981} {:answer/id #uuid "bc323d4c-6ab9-5df2-881f-281eabd5b981" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186395982} {:answer/id #uuid "3bac1b8f-a5a2-5c6f-9f74-53d3dc54a0d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-3y \\\\ y \\\\ 2+y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395983} {:answer/id #uuid "ca74fa9e-2937-5e51-b664-ed9cfa05d409" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2-y-z \\\\ 1+z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395984}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186395982} :answer-field/id #uuid "2f5eaa46-bf95-53b6-ace1-3bd33b1c4991" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395979}] :question/id #uuid "06de5100-449e-5af5-b65a-4e9e27bdf01a" :question/math-academy-id "q-10662" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{bmatrix}.\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & -1 & 3 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & 0 & 0 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=2 \\\\ 0x+y-3z &=1 \\\\ 0x+0y+0z &=-3\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-3,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186403731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f607536-ba89-5718-aed4-73d79d8fefe2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}5 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403733} {:answer/id #uuid "c6da98ac-d2bd-5e17-bf72-7dbf0e0b1406" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403734} {:answer/id #uuid "7102331a-61ac-555b-a308-ed6c3c607afc" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186403735} {:answer/id #uuid "fe9dc8bc-d50e-5f42-a53c-d906ba0fc3e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403736} {:answer/id #uuid "e0aa2a8a-523a-5375-aabf-871e94803607" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403737}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186403735} :answer-field/id #uuid "154dd871-921f-589c-a014-a6f06b889ded" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403732}] :question/id #uuid "546eeb31-583e-555f-a75b-4f974cd8d508" :question/math-academy-id "q-73953" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}3 & 5 & 2 & 1 \\\\ 0 & -2 & 4 & 3 \\\\ 0 & 0 & 0 & 10\\end{bmatrix}.\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\left\\{\\begin{aligned}3x+5y+2z &=1 \\\\ 0x-2y+4z &=3 \\\\ 0x+0y+0z &=10\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=10,$ we can conclude that our system has no solution."} {:db/id #edb/ref 17592186566241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d2924ea-cb37-573b-8ed5-db9237b1f0eb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}5 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186565777} {:answer/id #uuid "4613befc-1125-5164-88f6-2c0f0d69b67f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}8 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186565789} {:answer/id #uuid "66090f14-f9e9-5641-a4c0-de38716a5b27" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}-8 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186565837} {:answer/id #uuid "b436bc9a-d03e-54a0-b89f-ec3b0cd72d41" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}-8 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186565967} {:answer/id #uuid "b98b8374-0faa-5eb1-973d-e09f895dcb8c" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186565982}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186565982} :answer-field/id #uuid "f4d193b8-8450-500c-833c-0c44ba3de5e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566187}] :question/id #uuid "70a3bd24-6afb-575f-802d-3c1798798cee" :question/math-academy-id "q-131507" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}7 & 8 & -7 & 5 \\\\ 0 & -5 & 9 & -8 \\\\ 0 & 0 & 0 & 1\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\{\\begin{aligned}7x+8y-7z=5 \\\\ 0x-5y+9z=-8 \\\\ 0x+0y+0z=1\\end{aligned}\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=1,$ we can conclude that our system has no solution."}] :knowledge-point/title "Identifying a Singular 3x3 System of Equations That Has No Solution"}] :topic/math-academy-id 1374 :topic/title "Solving 3x3 Singular Systems of Equations Using Gaussian Elimination"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186134703} :activity/id #uuid "6c1ae6c7-6771-5b39-80ac-beb1cde38bb4" :activity/steps [{:db/id #edb/ref 17592186134703 :step/content {:db/id #edb/ref 17592186135062 :tutorial/content "Consider the following data set:\n\n| $x$ | **$100$** | **$110$** | **$120$** | **$130$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $12$ | $11$ | $12$ | $15$ |\n\nOur goal is to describe how to use matrices to carry out a linear regression. That is, we want to find an equation of the form\n\n$$\ny = \\beta_0 + \\beta_1 x\n$$\n\nthat best fits the given data points. \n\n![](images/8e/8ec830e3cf6154675487536afc0e09a42226eb83187b90238a0bfdcefeae5b38.png)\n\nLet's write our problem in matrix notation. Substituting the values of $x$ into the regression equation and equating the results to the corresponding observed values of $y,$ we obtain the system\n\n$$\n\\{\\begin{aligned}{\\beta }_{0}+100{\\beta }_{1}=12 \\\\ {\\beta }_{0}+110{\\beta }_{1}=11 \\\\ {\\beta }_{0}+120{\\beta }_{1}=12 \\\\ {\\beta }_{0}+130{\\beta }_{1}=15\\end{aligned}\n$$\n\nwhich can be expressed in matrix notation as\n\n![](images/8b/8bacbea6990395351aecca8befe779358d57d50f8c14f865d73c2107688fa728.svg)\n\nThe matrix $X$ is called the **design matrix,** and $\\mathbf{y}$ is called the **observation vector**. \n\nSince our points do not lie on a straight line, there will be no parameters $\\beta_0$ and $\\beta_1$ such that this equation is true. So instead, we seek parameters $\\beta_0$ and $\\beta_1$ that best approximate the solution.\n\nIn other words, we seek to find a column vector $\\boldsymbol\\beta$ such that\n\n$$\n\\| \\mathbf{y} - X\\boldsymbol{\\beta}\\|\n$$\n\nis as small as possible.\n\nNotice that this is exactly the least-squares problem for the system $X \\boldsymbol{\\beta} = \\mathbf{y}.$ Therefore, the coefficients of the line that best fits the data can be found as the solution to the corresponding least-squares problem! \n\nThis approach to finding parameters for a linear regression model is often called **ordinary least squares (OLS) regression**.\n\nPre-multiplying the equation $X \\boldsymbol{\\beta} = \\mathbf{y}$ by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible, and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting $X$ and $\\mathbf{y}$ into the formula above and simplifying, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta }=[\\begin{aligned}1 \\\\ 0.1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the line of best fit (regression line) is \n\n$$\ny = 1+ 0.1x.\n$$" :tutorial/id #uuid "49c9c3ab-40d7-5e87-934c-1c3fcd16b330" :tutorial/math-academy-id 3652 :tutorial/title "Introduction"} :step/id #uuid "0ac1d0c2-c862-5d00-b1e2-ce846fd9a9e9" :step/next {:db/id #edb/ref 17592186134886}} {:db/id #edb/ref 17592186134704 :step/content {:db/id #edb/ref 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b"} :step/id #uuid "342fc855-0200-53f5-b531-d6f0f6dc12c4" :step/next {:db/id #edb/ref 17592186134705}} {:db/id #edb/ref 17592186134705 :step/content {:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2"} :step/id #uuid "db5ddd01-2672-598e-9121-f4cf661cc836" :step/next {:db/id #edb/ref 17592186134888}} {:db/id #edb/ref 17592186134886 :step/content {:db/id #edb/ref 17592186133905 :knowledge-point/id #uuid "6acfe386-f7e4-54b1-9701-6ff5905b4536"} :step/id #uuid "af2c310b-8cc3-5365-a974-d47b29df8d67" :step/next {:db/id #edb/ref 17592186134704}} {:db/id #edb/ref 17592186134888 :step/content {:db/id #edb/ref 17592186135142 :tutorial/content "Given a dataset of paired numerical observations $(x,y)$ and the corresponding linear regression model $\\widehat{y} =f(x),$ the **residual** for a particular observation $(x, y)$ is defined as\n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-f(x) \\\\  & =y-\\overset{^}{y}.\\end{aligned}\n$$\n\nWe subtract the *estimated* value predicted by the model from the actual *observed* value. The residuals for the data set we considered earlier are shown below.\n\n![](images/51/515aaaeef2f85bb131564b92bdaef9ef514d05c8028ae85382d231565d490665.png)\n\nIn the past, you may have seen that  calculating a regression line typically means finding a line where the sum of the squared residuals \n\n$$\n\\displaystyle\\sum_{i=1}^4 r_i^2\n$$\n\nis as small as possible. \n\nUsing matrix notation, the sum of the squared residuals can be viewed as \n\n$$\n\\sum_{i=1}^4 r_i^2 = \\| \\mathbf{y} - X\\beta\\|^2.\n$$\n\nTherefore, the condition that the sum of the squared residuals is minimized is equivalent to minimizing $\\| \\mathbf{y} - X\\beta\\|^2.$ This, in turn, is equivalent to minimizing $\\| \\mathbf{y} - X\\beta\\|.$ \n\nTherefore, the problem of minimizing the squared residuals is equivalent to solving the least squares problem for $X \\boldsymbol{\\beta} = \\mathbf{y}.$" :tutorial/id #uuid "eeb5c2f5-02c9-5579-97b5-0393df974a32" :tutorial/math-academy-id 6149 :tutorial/title "Least-Squares vs. Minimizing the Sum of the Squared Residuals"} :step/id #uuid "7c7f5aff-10ef-54b2-b0e0-98663daec8b4"}] :activity/title "Linear Regression With Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186134029}] :db/id #edb/ref 17592186050179 :topic/knowledge-points [{:db/id #edb/ref 17592186133804 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133613 :question/id #uuid "251ec7c6-a050-5deb-8f13-d81f5de4b5c9" :question/math-academy-id "e-5610" :question/problem "| $x$ | **$-3$** | **$-1$** | **$0$** | **$4$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $10$ | $8$ | $6$ | $3$ |\n\nFind the line of the form $y=\\beta_0 + \\beta_1 x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n![](images/ba/ba4b73a8acd1ede70da8d25a67159c74420ac2fd11d15c830a460071d881ff42.png)\n*where $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}10 \\\\ 8 \\\\ 6 \\\\ 3\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nPre-multiplying this equation by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting the given values of $({X^T} X )^{-1}$ and $X^T \\mathbf{y}$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{104}\\begin{bmatrix}26 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}27 \\\\ -26\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.75 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y = 6.75 - x.$"} :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/questions [{:db/id #edb/ref 17592186134108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a2edf9f-25b1-5fd5-948c-237e6c5948da" :answer/type {:db/ident :answer.type/math} :answer/value "y=1.7-6x" :db/id #edb/ref 17592186270211} {:answer/id #uuid "897239e6-c3c2-5611-8c33-8bafe39cfda1" :answer/type {:db/ident :answer.type/math} :answer/value "y=6-1.7x" :db/id #edb/ref 17592186270454} {:answer/id #uuid "b26d58d6-c973-5c1f-91c9-981d64dedc48" :answer/type {:db/ident :answer.type/math} :answer/value "y=-6+1.7x" :db/id #edb/ref 17592186270863} {:answer/id #uuid "bd862383-7cfa-5c21-a439-ce2690a7f88e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-1.7+6x" :db/id #edb/ref 17592186270940} {:answer/id #uuid "e8d0e162-e5b3-5659-ba89-d415deaf13c8" :answer/type {:db/ident :answer.type/math} :answer/value "y=-1.7-6x" :db/id #edb/ref 17592186271303}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=6-1.7x" :db/id #edb/ref 17592186270454} :answer-field/id #uuid "860792a7-ff74-5496-9949-a0199174c0c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271744}] :question/id #uuid "72cc6e31-5631-5692-b09e-242241827364" :question/math-academy-id "q-139618" :question/problem "| $x$ | **$0$** | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $6$ | $4$ | $3$ | $1$ | $-1$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}13 \\\\ 9\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}6 \\\\ 4 \\\\ 3 \\\\ 1 \\\\ -1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}13 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -1.7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=6-1.7x.$"} {:db/id #edb/ref 17592186134359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83488259-35c6-5238-8e14-f4fbc3aaacc2" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2 - x" :db/id #edb/ref 17592186132194} {:answer/id #uuid "cbded7e9-6484-5c5a-9d24-6ad83f9464ad" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2 + 2x" :db/id #edb/ref 17592186132195} {:answer/id #uuid "e8b1f653-6987-5990-af94-d291162808b1" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{3}{2}x" :db/id #edb/ref 17592186132196} {:answer/id #uuid "356210d7-8346-5dac-8545-41236360eafc" :answer/type {:db/ident :answer.type/math} :answer/value "y =-1 + 3x" :db/id #edb/ref 17592186132197} {:answer/id #uuid "708f3b71-2442-5f7a-b96b-d07b5aeeb795" :answer/type {:db/ident :answer.type/math} :answer/value "y =-1 + \\frac{1}{2}x" :db/id #edb/ref 17592186132198}] :answer-field/id #uuid "c9ff4c39-c767-52f1-99b5-cfdb37349b3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132193}] :question/id #uuid "c05c3ccb-dd8d-5fc2-bea9-f79ea29658bb" :question/math-academy-id "q-41559" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nFind the line of the form $y = β_{0} + β_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n$(X^{T}X)^{-1} = \\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}, X^{T}y = \\begin{bmatrix}-10 \\\\ 20\\end{bmatrix}$,\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*\n\n> A calculator is required to answer this question."} {:db/id #edb/ref 17592186271956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13253f23-aec5-55ad-b4c7-17df66b79ec0" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2+1.4x" :db/id #edb/ref 17592186269437} {:answer/id #uuid "64399bb9-63ee-5478-9c09-041f12659f43" :answer/type {:db/ident :answer.type/math} :answer/value "y=2-1.4x" :db/id #edb/ref 17592186270160} {:answer/id #uuid "84dd91b7-54c3-5219-9384-e547a61ebd85" :answer/type {:db/ident :answer.type/math} :answer/value "y=1.4+2x" :db/id #edb/ref 17592186270416} {:answer/id #uuid "dd253302-e503-5a9f-b155-23a84fb59209" :answer/type {:db/ident :answer.type/math} :answer/value "y=1.4-2x" :db/id #edb/ref 17592186271209} {:answer/id #uuid "e0588728-a6d8-5925-a9d4-e429f8b21a28" :answer/type {:db/ident :answer.type/math} :answer/value "y=2+1.4x" :db/id #edb/ref 17592186271239}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=2+1.4x" :db/id #edb/ref 17592186271239} :answer-field/id #uuid "c5f24f5e-041b-5ab7-a484-f879d53d40a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271872}] :question/id #uuid "c98cf9f6-90e7-55f2-84a5-a676fae1738c" :question/math-academy-id "q-139617" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-1$ | $1$ | $2$ | $3$ | $5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}10 \\\\ 14\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1.4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=2+1.4x.$"} {:db/id #edb/ref 17592186271957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01745928-e32c-5454-a6e3-84c3244e92c9" :answer/type {:db/ident :answer.type/math} :answer/value "y=3-7.5x" :db/id #edb/ref 17592186269274} {:answer/id #uuid "9c63f558-4731-5a24-8cd6-37962eb32817" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3+7.5x" :db/id #edb/ref 17592186270648} {:answer/id #uuid "c59a290d-64c0-5f04-b6fa-aab7d8de070b" :answer/type {:db/ident :answer.type/math} :answer/value "y=7.5-3x" :db/id #edb/ref 17592186271010} {:answer/id #uuid "d48cfe8a-e7d6-5e73-893c-7cfdac9a5635" :answer/type {:db/ident :answer.type/math} :answer/value "y=7.5+3x" :db/id #edb/ref 17592186271138} {:answer/id #uuid "fb902028-8ca9-5246-a337-ac274bfa3708" :answer/type {:db/ident :answer.type/math} :answer/value "y=3+7.5x" :db/id #edb/ref 17592186271474}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=7.5+3x" :db/id #edb/ref 17592186271138} :answer-field/id #uuid "18c31747-882f-5d87-82c0-e1c176ff9aa1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271552}] :question/id #uuid "d1e4cd33-5cd4-5907-994a-2099e4ec4056" :question/math-academy-id "q-139643" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $8$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}24 \\\\ 3\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 5 \\\\ 8 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation \n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix}\\begin{bmatrix}24 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}7.5 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=7.5+3x.$"} {:db/id #edb/ref 17592186271958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5294a5a1-2190-5b35-b687-f1535ac6d14d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2-6.25x" :db/id #edb/ref 17592186270003} {:answer/id #uuid "986b411d-c0e5-538c-99ed-bafca3160f67" :answer/type {:db/ident :answer.type/math} :answer/value "y=2+6.25x" :db/id #edb/ref 17592186270610} {:answer/id #uuid "b17d16d7-10f4-55f5-aa20-398254a449fa" :answer/type {:db/ident :answer.type/math} :answer/value "y=6.25+2x" :db/id #edb/ref 17592186270855} {:answer/id #uuid "bb68d1ac-0b52-557b-a57d-6d5c7518e4e4" :answer/type {:db/ident :answer.type/m