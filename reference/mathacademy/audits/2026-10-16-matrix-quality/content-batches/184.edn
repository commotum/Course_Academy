 :question/id #uuid "e9ed15ab-e314-5efe-ab81-8f51e9de96ca"} :step/id #uuid "9d7f5e67-89e2-5703-a73e-0cdea17e3e7c" :step/next {:db/id #edb/ref 17592186526152}} {:db/id #edb/ref 17592186526141 :step/content {:db/id #edb/ref 17592186198978 :question/id #uuid "5b4e4425-10cb-5811-9da8-6b08b3f0fd92"} :step/id #uuid "c40cc94f-25ae-53ce-9f12-3dc6d6e1c8c3" :step/next {:db/id #edb/ref 17592186526116}} {:db/id #edb/ref 17592186526149 :step/content {:db/id #edb/ref 17592186284764 :question/id #uuid "e16f6fa7-ae80-51bb-bdf3-1add916dcb13"} :step/id #uuid "e78e4d3a-6a64-53a3-9a97-006207c74a48"} {:db/id #edb/ref 17592186526152 :step/content {:db/id #edb/ref 17592186525984 :question/id #uuid "01fe6b4b-89e7-5f7d-85f4-05ba3856f335"} :step/id #uuid "eef50253-8c08-55c7-bab7-bc37bdee6bfe" :step/next {:db/id #edb/ref 17592186526149}}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186525204}] :db/id #edb/ref 17592186050910 :topic/knowledge-points [{:db/id #edb/ref 17592186198448 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198131 :question/id #uuid "0070a453-0237-571f-84fc-a9f58446e6a9" :question/math-academy-id "e-12954" :question/problem "Let $\\mathbf{Q}$ be an orthogonal linear transformation. If ![](images/88/888a6e0af4cb0ad21e91c823ce01e3b7b44005650d8abb33b7e7cd15f5c8b1d0.svg) and ![](images/15/155d90bc4b1df2a185aed86db995a16762338cda30417ecb5a459b131e171dd8.svg), find\n\nI. $\\Vert \\mathbf{Q}(\\mathbf{x}) \\Vert.$\n\nII. $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}).$" :question/worked-solution "Since $\\mathbf{Q}$ is orthogonal, we have that $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}$ for any vectors $\\mathbf{x}$ and $\\mathbf{y}.$\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $|| \\mathbf{Q}(\\mathbf{x}) || = || \\mathbf{x} ||.$\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $\\mathbf{Q}$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-2)^{2}+{2}^{2}} \\\\  & =3.\\end{aligned}\n$$\n\nAlso, $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}.$ As a result,\n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =(-1)\\cdot 3+(-2)\\cdot 0+2\\cdot 5 \\\\  & =7.\\end{aligned}\n$$"} :knowledge-point/id #uuid "455b3713-34a3-535d-8baf-d279a0341e9f" :knowledge-point/questions [{:db/id #edb/ref 17592186198978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5739013-0ec3-5054-9df2-0416169aee06" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186197739} {:answer/id #uuid "cb80e9c9-9a83-5c04-a3ab-b7735d5f125a" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186197740} {:answer/id #uuid "cc77a078-56f6-5c64-a1d0-37853dbff1ba" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186197741} {:answer/id #uuid "e099e132-6017-54bd-af9b-dabda71bcfb4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186197742} {:answer/id #uuid "2c36f56b-9a3f-5112-a631-00ca6bd5658b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186197743}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186197742} :answer-field/id #uuid "ec57d5bb-fbdf-5711-9938-796ddd4e592a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186197738}] :question/id #uuid "5b4e4425-10cb-5811-9da8-6b08b3f0fd92" :question/math-academy-id "q-40489" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}2 \\\\ 4 \\\\ \\sqrt{5}\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{{2}^{2}+{4}^{2}+{(\\sqrt{5})}^{2}} \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186198979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e1aa1e-de86-5141-a747-49b7df88362b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186324305} {:answer/id #uuid "2bb428da-53ea-533b-ad36-0e999294e68f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186324318} {:answer/id #uuid "2ee62035-a9e5-5f7f-9961-5d46b2a9cb27" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324345} {:answer/id #uuid "3f1e464f-a9e3-5cb7-9c86-438e31176d92" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186324478} {:answer/id #uuid "abecbcfc-c2c9-55b7-a6bd-b251b89a9b98" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325432}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186324478} :answer-field/id #uuid "521acea1-0e27-577c-b181-7478a17ba862" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326360}] :question/id #uuid "063b2ff3-4387-5a0a-88b2-8a1c68641ed4" :question/math-academy-id "q-40516" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}$ and $y=\\begin{bmatrix}-2 \\\\ 1 \\\\ -2\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =1\\cdot (-2)+(-1)\\cdot 1+1\\cdot (-2) \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a2dbbe-8269-5871-944e-208bd7aa03cb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186281693} {:answer/id #uuid "5763789f-ad02-57d2-8abb-2d3ef223624f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186282431} {:answer/id #uuid "5f0011b6-dd86-54dd-93e2-86e2608cd8f1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282487} {:answer/id #uuid "aa73376a-4ff1-5a4a-8b18-a94ebfa6fe03" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{2}" :db/id #edb/ref 17592186283167} {:answer/id #uuid "f0a08606-13ff-5fb7-8e16-1af3bdc83744" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186283789}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282487} :answer-field/id #uuid "4e6e1327-d962-5a5a-86df-5a6da163058c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284063}] :question/id #uuid "eeb4fa8d-201a-5a9d-8ffa-ae311083bf29" :question/math-academy-id "q-177769" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}-1 \\\\ 3 \\\\ \\sqrt{6}\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{3}^{2}+{(\\sqrt{6})}^{2}} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01d44e31-35c4-58cd-b912-19a78a40c053" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186281705} {:answer/id #uuid "28daa53b-997b-5300-a2ed-d7f81362d9e1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186282041} {:answer/id #uuid "8e58c81a-eaee-5926-9fe4-9e537a288325" :answer/type {