y \\\\  & =2\\cdot (-4)+(-1)\\cdot 4+2\\cdot 6 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186406654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e42699-a0f0-5e81-a194-c91514b7e8ae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186406638} {:answer/id #uuid "46c27bd0-b639-51d1-a04d-8098da45991e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186406642} {:answer/id #uuid "b3565871-fc75-5a3f-bb6e-506cbb0458f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186406644} {:answer/id #uuid "bfd57b0f-3965-5b70-833f-7fa36e06ae4f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186406646} {:answer/id #uuid "e14e0ad1-a7b2-5023-b79c-bff39fbd35df" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186406649}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186406644} :answer-field/id #uuid "491c6e1c-81dd-5170-b618-833ce2679d93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406651}] :question/id #uuid "8a69da2c-f673-5e64-a265-9fe904a3c9ad" :question/math-academy-id "q-40514" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}\\sqrt{6} \\\\ 1 \\\\ 3\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{{(\\sqrt{6})}^{2}+{1}^{2}+{3}^{2}} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186406656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d47db5-c434-55d6-9456-167ab8a0b67c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186406641} {:answer/id #uuid "7c3a74ea-6a6d-5da3-b53b-157fcb966ead" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186406643} {:answer/id #uuid "b81c5bc9-bfe5-5ce5-928d-fa684e207472" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186406645} {:answer/id #uuid "c6a8591a-2779-5016-a0d3-d51746099b13" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186406647} {:answer/id #uuid "f3f62bc1-8a13-5efa-ad9a-759018432b14" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186406650}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186406641} :answer-field/id #uuid "ac075b6f-3299-5310-ad52-26f9cf648385" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406653}] :question/id #uuid "cf616da5-d6d0-5837-a9fb-64c2cf137040" :question/math-academy-id "q-40488" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}$ and $y=\\begin{bmatrix}-3 \\\\ 4 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =1\\cdot (-3)+3\\cdot 4+(-2)\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186446169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd4d334-2269-5bfe-a24c-a58aafbef588" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186446156} {:answer/id #uuid "4a46d5a3-3c48-5050-85ff-c52a5b9baaee" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186446157} {:answer/id #uuid "9164dcc8-fbe9-5d34-a2f1-c8be97a45615" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186446159} {:answer/id #uuid "a8c1505c-5ad9-511e-a22d-30a3286bfbdb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186446160} {:answer/id #uuid "e705ebf2-c558-54c0-816f-602c5af2facd" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186446163}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186446163} :answer-field/id #uuid "45554d58-8407-5972-941e-77d5ad8113b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446166}] :question/id #uuid "bffc4e85-37a7-58e6-9707-94d9ac87c744" :question/math-academy-id "q-177893" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=\\begin{bmatrix}3 \\\\ 1 \\\\ 1\\end{bmatrix}$ and $y=\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =3\\cdot 2+1\\cdot 2+1\\cdot 0 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012bb29a-9963-57da-b90b-434c91a90ab2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186484817} {:answer/id #uuid "05ab90c9-0813-586a-9b44-c98ce8be0379" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186484828} {:answer/id #uuid "2e490d2d-7e97-5d30-af73-6a6f000c1b2c" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186484912} {:answer/id #uuid "4436a127-bf8f-5d0f-b926-f265c358b489" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484964} {:answer/id #uuid "a6988062-26b2-5f46-b225-4b080bde730b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186485178}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484964} :answer-field/id #uuid "f8b85cb0-51f8-5559-bd88-b78ed4af2dbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485473}] :question/id #uuid "222e2ed5-e7e4-55fe-9d04-24be2fce81e6" :question/math-academy-id "q-177845" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}-1 \\\\ 2 \\\\ -2\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2956a40f-df61-50de-baf2-ec65d371184b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186484897} {:answer/id #uuid "5c4184a0-c888-5c3d-95db-cb9cd250614e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186485023} {:answer/id #uuid "6a28217e-b165-5a34-87a3-cba6817510dc" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186485047} {:answer/id #uuid "a78b744f-c950-5a6d-b53e-f4a231ad75de" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186485180} {:answer/id #uuid "e7d96f0b-0d91-5c5a-8fc4-2f52f9c60496" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186485305}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186485023} :answer-field/id #uuid "115a1ff1-f34b-5f94-b986-bdd47a5c61a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485373}] :question/id #uuid "227d7c9d-e02b-5883-bb19-91ec1f4f8788" :question/math-academy-id "q-177925" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=\\begin{bmatrix}-5 \\\\ 1 \\\\ -1\\end{bmatrix}$ and $y=\\begin{bmatrix}-2 \\\\ -4 \\\\ 2\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =(-5)\\cdot (-2)+1\\cdot (-4)+(-1)\\cdot 2 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b575c8-36c5-5013-80f6-ee1498a6faf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186493392} {:answer/id #uuid "01915aac-1c2e-585b-999e-bd689a77b856" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493393} {:answer/id #uuid "63c50681-0310-54e1-a7ce-97fde423a4b0" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{7}" :db/id #edb/ref 17592186493541} {:answer/id #uuid "99607e2e-69b1-5c13-81d9-aae71cd65b14" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186493632} {:answer/id #uuid "d11c7d00-ca24-5099-854f-165cee581f0c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{30}" :db/id #edb/ref 17592186493723}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186493392} :answer-field/id #uuid "131118e0-de48-5f9d-ada7-20da3689be40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493807}] :question/id #uuid "dfb0578c-1343-53e2-a376-085feaa6ce26" :question/math-academy-id "q-140566" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix}.$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-2)^{2}+{5}^{2}} \\\\  & =\\sqrt{30}.\\end{aligned}\n$$"}] :knowledge-point/title "Applying the Angle Preserving Property of Orthogonal Linear Transformations"} {:db/id #edb/ref 17592186198449 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198130 :question/id #uuid "a77db107-d157-5063-b44a-1ca0a93be099" :question/math-academy-id "e-12951" :question/problem "![](images/20/20b1f07891dd26e4839258d3c2232368b3aebbf527a2b0f31bcdde2369fc66d4.svg)\n\nConsider the vectors above, and let $\\mathbf{Q}$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. $\\mathbf{u}_1 \\cdot \\mathbf{u}_2 = 0$\n\nII. $\\{\\mathbf{Q}(\\mathbf{u}_1),\\mathbf{Q}(\\mathbf{u}_2)\\}$ is orthogonal\n\nIII. $\\{\\mathbf{Q}(\\mathbf{u}_1),\\mathbf{Q}(\\mathbf{u}_2)\\}$ is orthonormal" :question/worked-solution "Since $\\mathbf{Q}$ is orthogonal, we have that $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}$ for any vectors $\\mathbf{x}$ and $\\mathbf{y}.$\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $|| \\mathbf{Q}(\\mathbf{x}) || = || \\mathbf{x} ||.$\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n![](images/ad/adbd35f04ca988a406493df8f3dbda8769184868d5d85da89deb57ae18fb10b0.svg)\n\n- Statement II is true. Indeed, $\\mathbf{Q}(\\mathbf{u}_1) \\perp \\mathbf{Q}(\\mathbf{u}_2)$ since\n\n$$\n\\mathbf{Q}(\\mathbf{u}_1)\\cdot\\mathbf{Q}(\\mathbf{u}_2) = \\mathbf{u}_1\\cdot\\mathbf{u}_2 = 0.\n$$\n\n- Statement III is true. Indeed, both $\\mathbf{Q}(\\mathbf{u}_1)$ and $\\mathbf{Q}(\\mathbf{u}_2)$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(\\frac{2\\sqrt{2}}{3})^{2}+(\\frac{1}{3})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(-\\frac{1}{3})^{2}+(\\frac{2\\sqrt{2}}{3})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/questions [{:db/id #edb/ref 17592186198749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6dfedbf-e8f5-5c35-ac7a-3280352e020a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459653} {:answer/id #uuid "e9713a4a-6827-5ab4-8250-e0c6662fd257" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459654}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459654} :answer-field/id #uuid "a72b8fb7-3248-5357-886c-14a9921e2b27" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460693} {:answer-field/choices [{:answer/id #uuid "37b51687-e975-5fef-b586-123a8d03457c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459655} {:answer/id #uuid "4719370a-40fe-5819-95db-2750f3e9f8ae" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459656}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459656} :answer-field/id #uuid "8a2ed651-b0b2-5578-8e7f-41bdc35291ec" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460694} {:answer-field/choices [{:answer/id #uuid "cb6b8dbf-9094-5908-9192-5e790c2e9227" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459657} {:answer/id #uuid "429f461b-d81f-54c3-bf90-863669545081" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459658}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459657} :answer-field/id #uuid "5fb97e7e-61b1-52f5-b06e-85a2025b70ce" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460695}] :question/id #uuid "70a4471c-4be9-5243-a617-e32ac5259d39" :question/math-academy-id "q-177075" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}9 \\\\ 6\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n- **I.** ${u}_{1}\\cdot {u}_{2}=0$\n- **II.** ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- **III.** ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix}=18-18=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{9}^{2}+{6}^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186198750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dbc2877-1064-59e1-91d9-6e3ec0e08661" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459659} {:answer/id #uuid "96fa23cc-f15c-5d76-81ac-bc08e6bb7e90" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459660}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459660} :answer-field/id #uuid "17e2d61d-61b6-527d-afb9-3443e06829eb" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460696} {:answer-field/choices [{:answer/id #uuid "298a33f1-a9b2-595a-9ecb-d624448c5ff0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459661} {:answer/id #uuid "a83a64fc-53ec-556f-b18a-e94d5ea6215f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459662}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459662} :answer-field/id #uuid "18b4689d-0aaf-5f9c-af23-436c85c48526" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460697} {:answer-field/choices [{:answer/id #uuid "dd291524-b945-53dc-9025-02857a4bfebe" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459663} {:answer/id #uuid "5ac8bba8-265c-5892-93e3-19c51777ca3c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459664}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459664} :answer-field/id #uuid "30a33278-fdbc-523a-bfa4-2f8a09609b7d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460698}] :question/id #uuid "e6d806a7-8383-51f7-a460-be3b003d424b" :question/math-academy-id "q-177315" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n- **I.** ${u}_{1}\\cdot {u}_{2}=0$\n- **II.** ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- **III.** ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}=-\\frac{1}{2}+\\frac{1}{2}=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is true. Indeed, both $Q({u}_{1})$ and $Q({u}_{2})$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(-\\frac{1}{\\sqrt{2}})^{2}+(\\frac{1}{\\sqrt{2}})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(\\frac{1}{\\sqrt{2}})^{2}+(\\frac{1}{\\sqrt{2}})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186284748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a4ade3a-303a-5eec-9df3-e43d050e7127" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465651} {:answer/id #uuid "bfb5336b-989f-5a31-b653-6429b31a077f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465652}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465651} :answer-field/id #uuid "50d64a07-1676-5fda-bef0-6a4849be81d2" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466669} {:answer-field/choices [{:answer/id #uuid "6722f30e-e2af-5a70-879f-cfff27425f84" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465653} {:answer/id #uuid "dc3d0a9a-fffb-56ce-a7bd-59c663e5f87e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465654}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465653} :answer-field/id #uuid "c9cb2af9-89d8-5f3d-8d83-90156885a877" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466670} {:answer-field/choices [{:answer/id #uuid "9ff5d22d-d9d1-5f3d-acef-b6be4a77c7ab" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465655} {:answer/id #uuid "bb044ed9-c0d7-5063-b76d-362678932554" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465656}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465655} :answer-field/id #uuid "3cba7c41-2ad1-5047-8e7d-0cc187a92400" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466671}] :question/id #uuid "1e67e934-1049-5a47-aaca-94c1d2a3bfc1" :question/math-academy-id "q-177118" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n- **I.** ${u}_{1}\\cdot {u}_{2}=0$\n- **II.** ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal\n- **III.** ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false since\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\n$$\n\n- Statement II is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186284761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc2efb6-9eca-5951-8e7b-36ca586cc91e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465663} {:answer/id #uuid "4c94335e-da4f-5437-a16e-06f74b8263ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465664}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465664} :answer-field/id #uuid "1aa48675-e440-5d05-bce2-e8ba5671377c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466675} {:answer-field/choices [{:answer/id #uuid "ebb7ea2d-fda8-5bb3-8b30-53e628e49462" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465665} {:answer/id #uuid "4a519b06-c877-5f24-b5ab-94c362d829af" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465666}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465666} :answer-field/id #uuid "b36b6346-2bec-52b5-be58-2c49b45e65b8" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466676} {:answer-field/choices [{:answer/id #uuid "67109f8f-67eb-5347-861b-978220010be2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465667} {:answer/id #uuid "3f25123c-227b-583e-a1b9-25f891486d3c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465668}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465668} :answer-field/id #uuid "c2a91194-5a35-55f8-b752-19469120d84b" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466677}] :question/id #uuid "e9ed15ab-e314-5efe-ab81-8f51e9de96ca" :question/math-academy-id "q-178026" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n- **I.** ${u}_{1}\\cdot {u}_{2}=0$\n- **II.** ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- **III.** ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}\\cdot \\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5}\\end{bmatrix}=-\\frac{12}{25}+\\frac{12}{25}=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is true. Indeed, both $Q({u}_{1})$ and $Q({u}_{2})$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(\\frac{4}{5})^{2}+(\\frac{3}{5})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(-\\frac{3}{5})^{2}+(\\frac{4}{5})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186284764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f6862c-27fd-5c39-8eb2-3cbbffed6df8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} {:answer/id #uuid "786a7ab2-a3ec-5b80-8a00-e9e1753b87d4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465670}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465669} :answer-field/id #uuid "55fa8074-b199-52f0-b9ec-a64e6d2e74dd" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466678} {:answer-field/choices [{:answer/id #uuid "14cbd69a-f982-5d8b-a7b5-faa1d54ef043" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465671} {:answer/id #uuid "a3dbd501-b3c0-564f-92ea-a9a572fb9e89" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465672}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465671} :answer-field/id #uuid "77082866-697e-5473-bb08-593811756def" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466679} {:answer-field/choices [{:answer/id #uuid "270b69ea-ae43-51a2-bc71-ac5760e7b855" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465673} {:answer/id #uuid "f89e42f6-9f2a-5d60-9603-c8642f276749" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465674}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465673} :answer-field/id #uuid "07d18537-0a6d-59ae-9629-b8bdfac0f081" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466680}] :question/id #uuid "e16f6fa7-ae80-51bb-bdf3-1add916dcb13" :question/math-academy-id "q-178269" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{2}=0$\n\nII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthogonal\n\nIII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 1\\end{bmatrix}=6+3\\ne 0.\n$$\n\n- Statement II is false. Notice that, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186406655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047c19ef-c76a-57b3-b13e-81cac8438947" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473112} {:answer/id #uuid "0f411e21-0bfc-5e60-be10-aa9385c60d56" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473113}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473113} :answer-field/id #uuid "41b5e6b2-6fa4-5699-91d3-98491ea01274" :answer-field/key "U" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473951} {:answer-field/choices [{:answer/id #uuid "3b5e99f8-6d7b-5605-8eeb-768c689a1a11" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473114} {:answer/id #uuid "d3e8b7c2-03e8-52a8-8c30-1f1597b0a406" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473115}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473114} :answer-field/id #uuid "2909a2f7-876c-5e10-a289-6837f83679fc" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473952} {:answer-field/choices [{:answer/id #uuid "829a1b56-ccd5-5381-aeca-6ba71098f21a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473116} {:answer/id #uuid "adcc7d05-7e81-525a-b650-a03adf317913" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473117} :answer-field/id #uuid "51b28bdf-55b7-5470-b1f6-bd8182431d5f" :answer-field/key "W" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473953}] :question/id #uuid "9892c6c7-24de-57f2-a3e8-0b32de0c1349" :question/math-academy-id "q-40491" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n- **U.** $U={Q(\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ -3\\end{bmatrix})}$\n- **W.** $W={Q(\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}),Q(\\begin{bmatrix}6 \\\\ -1\\end{bmatrix})}$\n- **V.** $V={Q(\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}),Q(\\begin{bmatrix}3 \\\\ 3 \\\\ -3\\end{bmatrix})}$\n\nSelect all that apply." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ ${Q({u}_{1}),Q({u}_{2})},\\,$ ${Q({w}_{1}),Q({w}_{2})},\\,$ and $\\,{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})}.$ \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}9 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix}=18-18=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ -1\\end{bmatrix}=1-1=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}=2+12-5=9\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\nTherefore, the correct answer is \"$U$ and $W$ only\"."} {:db/id #edb/ref 17592186411865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8e2907-6f9f-5945-87a4-4b320b3c5c7e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} {:answer/id #uuid "363acb19-a7c4-58f9-889f-e407b2331d8f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472785}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472784} :answer-field/id #uuid "51607494-5a75-5d4c-92f2-cb8a34490a90" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473787} {:answer-field/choices [{:answer/id #uuid "30463986-efbd-51fd-a6e9-b681bf1c31ba" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} {:answer/id #uuid "7e0850f2-9a46-5214-af3b-d2ee5b9d05f4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472787}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472786} :answer-field/id #uuid "576b8513-a337-57bb-a0b8-42a8d11e9c97" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473788} {:answer-field/choices [{:answer/id #uuid "2da457c8-29f9-53a4-9a7b-82bd8117f5ed" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} {:answer/id #uuid "9252ae02-4d55-5e0b-ab06-d7222907f63c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472789}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472788} :answer-field/id #uuid "b8436333-b398-5406-b728-7406ac2b71f3" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473789}] :question/id #uuid "8d807e12-6960-57f6-b74d-aa3fe66f0f76" :question/math-academy-id "q-178271" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -3\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{3}=0$\n\nII. $\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthogonal\n\nIII. $\\{Q({u}_{1}),Q({u}_{2}),Q({u}_{3})\\}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false since\n\n$$\n{u}_{1}\\cdot {u}_{3}=\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}=3\\ne 0.\n$$\n\n- Statement II is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{3})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{3})={u}_{1}\\cdot {u}_{3}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186415156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d08864-6101-5251-8351-5c0043998d07" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472778} {:answer/id #uuid "1a22dbe5-0d2b-5c0a-9531-8c54bafdc81e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472779}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472779} :answer-field/id #uuid "71e4259d-b2ae-5c52-927d-7cf47899f776" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473784} {:answer-field/choices [{:answer/id #uuid "c84ccb50-f1be-591e-8bac-35014caba949" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472780} {:answer/id #uuid "19621db5-93e2-50ee-9ddb-8440f2d6f313" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472781}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472781} :answer-field/id #uuid "7af95f9f-6948-54ed-b3d3-37b3b7e7a68c" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473785} {:answer-field/choices [{:answer/id #uuid "5b309452-f7e7-54e9-bbdf-9a3025bd85c0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472782} {:answer/id #uuid "f4968354-f03a-5157-9f0d-8be8dbd50643" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472783}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472782} :answer-field/id #uuid "46245871-924f-5edd-8bb1-a6c28bc755b4" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473786}] :question/id #uuid "2a7fbace-2464-5d79-be05-e6f28745c3de" :question/math-academy-id "q-178014" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n- **I.** ${u}_{1}\\cdot {u}_{2}=0$\n- **II.** ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- **III.** ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}3 \\\\ -6\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ 2\\end{bmatrix}=12-12=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{3}^{2}+(-6)^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186446168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85bffa49-25ed-5277-8eb0-2bf0d83a3acf" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186446158} {:answer/id #uuid "acfdb839-bbb9-5d75-a684-8e0ba2f1180c" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186446161} {:answer/id #uuid "e4112fbf-91d8-5bb1-acad-1777ebe798bc" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186446162} {:answer/id #uuid "eb713c79-d5f4-5d03-8da7-db12deacf3d2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186446164} {:answer/id #uuid "f04b535e-e446-5693-b598-2a2ae8017998" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186446165}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186446162} :answer-field/id #uuid "5243b6a3-407c-5377-9662-ad587ee4e1e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446167}] :question/id #uuid "ac6fbe63-89e3-55f0-b383-00653c46559a" :question/math-academy-id "q-178025" :question/problem "$$\n{u}_{1}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix},\\,{u}_{2}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{2}=0$\n\nII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthogonal\n\nIII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}=\\frac{2}{5}-\\frac{2}{5}=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is true. Indeed, both $Q({u}_{1})$ and $Q({u}_{2})$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(\\frac{1}{\\sqrt{5}})^{2}+(-\\frac{2}{\\sqrt{5}})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(\\frac{2}{\\sqrt{5}})^{2}+(\\frac{1}{\\sqrt{5}})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186485518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c21b706-ee61-5347-b1e9-163e20da045d" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186484840} {:answer/id #uuid "511d2e30-3a63-5d27-8065-e177abbd52b3" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186484993} {:answer/id #uuid "64b5d7dc-d5a7-536d-952d-7f23ec21eaea" :answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186485035} {:answer/id #uuid "a8a7e5ba-e12b-5de2-9808-9ac0af0c0ae8" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186485183} {:answer/id #uuid "dcfa56ff-89e4-5c4c-b084-fe9d0a2df44d" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186485281}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186485035} :answer-field/id #uuid "3a79a8e6-4bbb-52fc-b050-7b31066c3423" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485393}] :question/id #uuid "3a3b6415-46fa-5ac6-8f1e-cce0985c5f71" :question/math-academy-id "q-40515" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q(\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}),Q(\\begin{bmatrix}5 \\\\ -1\\end{bmatrix})\\}$\n\nII. $V=\\{Q(\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}),Q(\\begin{bmatrix}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix})\\}$\n\nIII. $W=\\{Q(\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}),Q(\\begin{bmatrix}-3 \\\\ -5\\end{bmatrix})\\}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}5 \\\\ -1\\end{bmatrix}=20-3=17\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not and orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{bmatrix}=3-4+1=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 4 \\\\ 6\\end{bmatrix}=2+8+18=28\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}\\cdot \\begin{bmatrix}-3 \\\\ -5\\end{bmatrix}=-15+15=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"."} {:db/id #edb/ref 17592186485595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ec03f18-13be-55eb-92af-32d5b84aa90d" :answer/type {:db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186485126} {:answer/id #uuid "9902057c-da91-5c74-b86e-dd54d2418d30" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186485146} {:answer/id #uuid "ae328ea7-ac34-5c69-a500-80ec39d884b3" :answer/type {:db/ident :answer.type/text} :answer/value "$U,V,$ and $W$" :db/id #edb/ref 17592186485193} {:answer/id #uuid "b8fa2677-4376-5029-b220-a56e49c627ad" :answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186485216} {:answer/id #uuid "e17db08c-8042-5528-9797-e2d47b07097c" :answer/type {:db/ident :answer.type/text} :answer/value "$V$ only" :db/id #edb/ref 17592186485294}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$W$ only" :db/id #edb/ref 17592186485216} :answer-field/id #uuid "bbd54c08-5bbd-5945-9a88-65da2698583c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485448}] :question/id #uuid "fd59782d-c853-5fe4-812d-f8b2814488a9" :question/math-academy-id "q-140567" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q(\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix})\\}$\n\nII. $V=\\{Q(\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}),Q(\\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}),Q(\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix})\\}$\n\nIII. $W=\\{Q(\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}),Q(\\begin{bmatrix}-5 \\\\ 2\\end{bmatrix})\\}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}=-4+25=21\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}=0+2\\sqrt{5}-2\\sqrt{5}=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=\\begin{bmatrix}-1 \\\\ \\sqrt{5} \\\\ -2\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}=-2+0-2=-4.\\,\\times  \\\\ {v}_{2}\\cdot {v}_{3} & =\\begin{bmatrix}0 \\\\ 2 \\\\ \\sqrt{5}\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}=0+0+\\sqrt{5}=\\sqrt{5}\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}-5 \\\\ 2\\end{bmatrix}=-10+10=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"."} {:db/id #edb/ref 17592186525984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3fe7ca-ea29-5f3f-8066-d8716cb13a68" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186525269} {:answer/id #uuid "32717fe3-a7f3-56f5-9f8f-5f4636b81c3c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186525330} {:answer/id #uuid "4d91a2bf-fdbf-56b8-8e4e-20e5996d747e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186525401} {:answer/id #uuid "80bb61ff-4612-53a2-9ac0-e8606aaa9455" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186525527} {:answer/id #uuid "9ef395c5-e379-5f31-abfb-14bad75b8656" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186525611}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186525269} :answer-field/id #uuid "7be66281-82ba-5671-8686-d76669d37ebe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525907}] :question/id #uuid "01fe6b4b-89e7-5f7d-85f4-05ba3856f335" :question/math-academy-id "q-178268" :question/problem "$$\n{u}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{2}=0$\n\nII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthogonal\n\nIII. $\\{Q({u}_{1}),Q({u}_{2})\\}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}]=2+2\\ne 0.\n$$\n\n- Statement II is false. Notice that, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""}] :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :topic/math-academy-id 4319 :topic/title "Orthogonal Linear Transformations"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186163040} :activity/id #uuid "d215dc31-fcec-5081-8994-43caf3b19295" :activity/steps [{:db/id #edb/ref 17592186163040 :step/content {:db/id #edb/ref 17592186163310 :tutorial/content "The table below describes the number of classes taken per semester and the average final grade in a sample of four college students.\n\n| **Number of Courses** | $4$ | $3$ | $5$ | $4$ |\n| --- | --- | --- | --- | --- |\n| **Average Grade** | $80$ | $85$ | $75$ | $72$ |\n\nWe can collect this data in a matrix so that each column reports the number of courses and the average grade of a single student:\n\n![](images/8a/8a489e90c10dbb65c2f5e005c32677696073cc63203116ed07d445a91d7f2d32.svg)\n\nThe matrix $X$ is called the **observation matrix.**\n\nSuppose we want to determine the mean number of courses and the mean average grade of this sample. The **sample mean vector,** denoted $\\mathbf m,$ is a vector containing these values. The sample mean vector is given by\n\n$$\n\\mathbf{m} = \\dfrac{1}{n} \\sum_{i=1}^n \\mathbf{x}_i,\n$$\n\nwhere $\\mathbf{x}_1, \\mathbf{x}_2, \\ldots, \\mathbf{x}_n$ are the individual observations (columns of $X$).\n\nFrom our matrix above, we have that  \n\n![](images/45/4549af29f9356865dc9f3edb67960da00a4007a71281778d4a273a1a6eb0dbf9.svg)\n\nTherefore, the sample mean vector is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}4 \\\\ 80\\end{aligned}]+[\\begin{aligned}3 \\\\ 85\\end{aligned}]+[\\begin{aligned}5 \\\\ 75\\end{aligned}]+[\\begin{aligned}4 \\\\ 72\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}16 \\\\ 312\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 78\\end{aligned}].\\end{aligned}\n$$\n\nSo, the average number of courses is $4,$ and the average final grade is $78.$" :tutorial/id #uuid "652defa1-c802-5dbd-9ed9-7d863bd020a2" :tutorial/math-academy-id 6079 :tutorial/title "Introduction"} :step/id #uuid "1e325102-149c-5fb3-b355-d46756b13060" :step/next {:db/id #edb/ref 17592186163041}} {:db/id #edb/ref 17592186163041 :step/content {:db/id #edb/ref 17592186162094 :knowledge-point/id #uuid "f930dfb2-a688-5dbe-9233-09dbcd2ba383"} :step/id #uuid "5ccead82-f536-5ecc-ad47-7e72852fc8a0" :step/next {:db/id #edb/ref 17592186163057}} {:db/id #edb/ref 17592186163042 :step/content {:db/id #edb/ref 17592186162095 :knowledge-point/id #uuid "dc84d72a-b9f3-5f99-aa23-31cfe6910d49"} :step/id #uuid "b20cf4dd-9e6f-553b-bdb8-e16bac07f0be"} {:db/id #edb/ref 17592186163043 :step/content {:db/id #edb/ref 17592186163311 :tutorial/content "Let's consider again the mean-deviation matrix for the students' data we found previously:\n\n![](images/1f/1f5440b7ae08ffd19bdae816854c236afe3ca254d5bd23e26f15e34cd9c9feb2.svg)\n\nCalculating the product $B B^T,$ we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}0 & -1 & 1 & 0 \\\\ 2 & 7 & -3 & -6\\end{aligned}][\\begin{aligned}0 & 2 \\\\ -1 & 7 \\\\ 1 & -3 \\\\ 0 & -6\\end{aligned}] & =[\\begin{aligned}2 & -10 \\\\ -10 & 98\\end{aligned}].\\end{aligned}\n$$\n\nLet's analyze what we've obtained:\n\n- The entry in the first row and first column (${\\color{red}2}$) is the sum of the squares of the mean deviations of the number of courses.\n\n- The entry in the second row and second column (${\\color{blue}98}$) is the sum of the squares of the mean deviations of the final grades.\n\n- The off-diagonal entries (${\\color{purple}-10}$) are the sum of the products of the mean deviations.\n\nSince there were $4$ observations in total, if we divide each entry by $4-1=3,$  we will get a matrix $C$ with the *sample variances* in the diagonal and the *sample covariance* in the off-diagonal positions:\n\n![](images/7d/7d0216b462e1bf7dc34d638a7a0de30fcf063ce39d1865b45f85b526ba7bd0a8.svg)\n\nThis matrix is called the **covariance matrix** of the data.\n\nIn general, the sample covariance matrix is given by\n\n$$\nC = \\dfrac{1}{n-1} B B^T,\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations." :tutorial/id #uuid "53d475a6-4449-56eb-8cf7-736ae440e1a1" :tutorial/math-academy-id 6080 :tutorial/title "The Covariance Matrix"} :step/id #uuid "f03f6d4f-4aba-584a-86ea-090a017828ca" :step/next {:db/id #edb/ref 17592186163042}} {:db/id #edb/ref 17592186163044 :step/content {:db/id #edb/ref 17592186162096 :knowledge-point/id #uuid "e91708c9-67e2-5228-84fd-1f4ea60064ac"} :step/id #uuid "a74161b0-4fa2-5cab-a830-1e6a769934fd" :step/next {:db/id #edb/ref 17592186163043}} {:db/id #edb/ref 17592186163057 :step/content {:db/id #edb/ref 17592186163321 :tutorial/content "Earlier, we studied data that reported the number of courses selected and the average grades of a sample of four college students. The observation matrix for this data was\n\n![](images/9b/9bdfe848443d0014461cc51e2decfbed8dc151a72edb34825dd33ac964ed6b2f.svg)\n\nThe individual observations are\n\n![](images/3f/3f935ba5f9adea7f75a63642837a3b993286f9535d5bf1842ce3a2267413c6bc.svg)\n\nWe also found the sample mean vector \n\n![](images/26/261e1d746aafa95ac2f7a6d1ff36a741ff5ae37ba738f75b451a542baed1c5fc.svg)\n\nOne thing we can do with this data is to check how much each observation differs from the mean values. To do that, we compute the difference between each observation and the sample mean vector:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=[\\begin{aligned}4 \\\\ 80\\end{aligned}]-[\\begin{aligned}4 \\\\ 78\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\ {b}_{2} & ={x}_{2}-m=[\\begin{aligned}3 \\\\ 85\\end{aligned}]-[\\begin{aligned}4 \\\\ 78\\end{aligned}]=[\\begin{aligned}-1 \\\\ 7\\end{aligned}] \\\\ {b}_{3} & ={x}_{3}-m=[\\begin{aligned}5 \\\\ 75\\end{aligned}]-[\\begin{aligned}4 \\\\ 78\\end{aligned}]=[\\begin{aligned}1 \\\\ -3\\end{aligned}] \\\\ {b}_{4} & ={x}_{4}-m=[\\begin{aligned}4 \\\\ 72\\end{aligned}]-[\\begin{aligned}4 \\\\ 78\\end{aligned}]=[\\begin{aligned}0 \\\\ -6\\end{aligned}]\\end{aligned}\n$$\n\nWe collect these differences in a new matrix, as follows:\n\n![](images/83/831e698a632d40ab447c75a3b169e29c6ae8ab10c6600d838bd699a38e837931.svg)\n\nThe matrix $B$ is the **mean-deviation form** of $X.$ It's often easier to work with the mean-deviation form, especially if the original data contains large numbers.\n\nNotice that the mean of a mean-deviation form equals the zero vector:\n\n$$\n\\begin{aligned}{m}_{B} & =\\frac{1}{4}([\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 7\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}]+[\\begin{aligned}0 \\\\ -6\\end{aligned}]) \\\\  & =\\frac{1}{4}([\\begin{aligned}0 \\\\ 0\\end{aligned}]) \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "fcfec935-52c3-571d-b471-9a1be7383ff6" :tutorial/math-academy-id 6143 :tutorial/title "Mean-Deviation Form"} :step/id #uuid "8e871f51-8d02-5990-9d6d-f5e78d503fb5" :step/next {:db/id #edb/ref 17592186163044}}] :activity/title "The Sample Covariance Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186162232} {:activity/first-step {:db/id #edb/ref 17592186536938} :activity/id #uuid "e9f30801-05f6-5733-bfd9-7a227c36223a" :activity/steps [{:db/id #edb/ref 17592186536902 :step/content {:db/id #edb/ref 17592186536835 :question/id #uuid "5926666e-0db3-5dee-9762-40fbc13f71e2"} :step/id #uuid "0346e43f-4ec3-54fd-a36a-83c457ba540d" :step/next {:db/id #edb/ref 17592186536914}} {:db/id #edb/ref 17592186536914 :step/content {:db/id #edb/ref 17592186536822 :question/id #uuid "2f2cb4c0-5e13-5762-90d1-d095feb4a65e"} :step/id #uuid "23e83d25-72e7-5ce0-8291-4514123ca24b" :step/next {:db/id #edb/ref 17592186536971}} {:db/id #edb/ref 17592186536938 :step/content {:db/id #edb/ref 17592186536875 :question/id #uuid "b9e3535a-6a10-557b-a90a-dcbee5f059a0"} :step/id #uuid "6d56aefc-11ae-57d8-922f-7a3f39b19dcc" :step/next {:db/id #edb/ref 17592186536966}} {:db/id #edb/ref 17592186536966 :step/content {:db/id #edb/ref 17592186536842 :question/id #uuid "6a4bb009-1382-5d80-b122-5cf6749f1552"} :step/id #uuid "c3d9e78e-168e-5b62-9c51-d4a45ca0bbdb" :step/next {:db/id #edb/ref 17592186536902}} {:db/id #edb/ref 17592186536971 :step/content {:db/id #edb/ref 17592186536884 :question/id #uuid "d39bfe0e-e6e3-509a-9ccb-2651e206d7a8"} :step/id #uuid "d14ef892-c3d1-5aad-87b3-30b8a9ceff03"}] :activity/title "The Sample Covariance Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186536283}] :db/id #edb/ref 17592186050911 :topic/knowledge-points [{:db/id #edb/ref 17592186162094 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161907 :question/id #uuid "5f949e10-0d73-50c8-9f41-73a0d0f78e29" :question/math-academy-id "e-9833" :question/problem "![](images/d1/d1fd70958028ae2c12be1df5808616421da9bb5758999237031a143e48d8e167.svg)\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\n\\mathbf{m} = \\dfrac{1}{n} \\sum_{i=1}^n \\mathbf{x}_i,\n$$\n\nwhere $\\mathbf{x}_1, \\mathbf{x}_2, \\ldots, \\mathbf{x}_n$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n![](images/f9/f97a4bc5d9323be573cc78cca322502d86d4c890d46b7116ffa1fac87e291672.svg)\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}1 \\\\ 2\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}]+[\\begin{aligned}0 \\\\ 3\\end{aligned}]+[\\begin{aligned}2 \\\\ 2\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}4 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$"} :knowledge-point/id #uuid "f930dfb2-a688-5dbe-9233-09dbcd2ba383" :knowledge-point/questions [{:db/id #edb/ref 17592186162352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8631b5a4-613c-5984-b776-b96d9816d362" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{4} \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186159315} {:answer/id #uuid "9ce76c2c-b072-5ff8-b61b-63df502b0937" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{4} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186159316} {:answer/id #uuid "fbab1f71-df83-5c97-ab0b-badce44e3629" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186159317} {:answer/id #uuid "6f8bf88e-1a53-5e3e-b085-dc48160318ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186159318} {:answer/id #uuid "7c4e7e53-0ac8-516e-b4cf-3e9f7d2e8bcf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186159319}] :answer-field/id #uuid "66676c39-9a4e-5b37-9fce-b6e592bb1963" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159314}] :question/id #uuid "7be30bcf-f897-5a1d-bc33-25d2ea903bbc" :question/math-academy-id "q-137266" :question/problem "$X = \\begin{bmatrix}1 & 0 & -2 & 5 \\\\ 2 & 4 & 12 & 2\\end{bmatrix}$\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X$."} {:db/id #edb/ref 17592186162357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e7cba67-e096-5b95-a14a-487e24567f2e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186512323} {:answer/id #uuid "9235d87a-9ca8-57a7-b50d-33d634911d1d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186512446} {:answer/id #uuid "a28ae8b8-c35f-5e4a-a510-e53932d48486" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512477} {:answer/id #uuid "a8166e60-bcc2-5189-bbf7-7402566f0e78" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186512501} {:answer/id #uuid "c7c38621-1b2b-5a28-b363-f6665e35d0c2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186512581}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186512581} :answer-field/id #uuid "1526adc8-e249-5ffb-b69e-061488222c49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159344}] :question/id #uuid "a8e04663-eff2-5470-8316-f5df1f548b39" :question/math-academy-id "q-138589" :question/problem "$$\nX=[\\begin{aligned}7 & 8 & 0 & -3 \\\\ -2 & 10 & -3 & 3\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=[\\begin{aligned}7 \\\\ -2\\end{aligned}],\\,{x}_{2}=[\\begin{aligned}8 \\\\ 10\\end{aligned}],\\,{x}_{3}=[\\begin{aligned}0 \\\\ -3\\end{aligned}],\\,{x}_{4}=[\\begin{aligned}-3 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}7 \\\\ -2\\end{aligned}]+[\\begin{aligned}8 \\\\ 10\\end{aligned}]+[\\begin{aligned}0 \\\\ -3\\end{aligned}]+[\\begin{aligned}-3 \\\\ 3\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}12 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 2\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e2dfad-4ec8-58fa-bd48-2e3147deaab4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512118} {:answer/id #uuid "5f5600c3-c4f7-59ec-bfd6-2e12ca94531d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{4} \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512326} {:answer/id #uuid "7d29c3e3-083f-5d63-97b5-7181ca00dde5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512394} {:answer/id #uuid "ca74f34a-cd90-530c-855e-6c0fa94d0f14" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512587} {:answer/id #uuid "d5ccd631-16bb-571b-9fb5-c68392b29f6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{4} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512606}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{4} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186512606} :answer-field/id #uuid "b64e05d2-d26b-59b5-8c83-b59f82b63c05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512825}] :question/id #uuid "02ad0f7a-4664-5f54-8474-68fa73e23e7a" :question/math-academy-id "q-138593" :question/problem "$$\nX=[\\begin{aligned}0 & 1 & -1 & 3 \\\\ 5 & 7 & 7 & 5\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=[\\begin{aligned}0 \\\\ 5\\end{aligned}],\\,{x}_{2}=[\\begin{aligned}1 \\\\ 7\\end{aligned}],\\,{x}_{3}=[\\begin{aligned}-1 \\\\ 7\\end{aligned}],\\,{x}_{4}=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}0 \\\\ 5\\end{aligned}]+[\\begin{aligned}1 \\\\ 7\\end{aligned}]+[\\begin{aligned}-1 \\\\ 7\\end{aligned}]+[\\begin{aligned}3 \\\\ 5\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}3 \\\\ 24\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{4} \\\\ 6\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "667692f8-8dce-57c3-ba78-dc88ae1b54b8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186512344} {:answer/id #uuid "73d834c0-77cb-58c5-887f-7057191d208e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186512372} {:answer/id #uuid "dcb8ee4f-578f-5988-8184-9d8eb0758222" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186512627} {:answer/id #uuid "e8b31814-d593-58df-9f5e-62a25ecaec45" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186512656} {:answer/id #uuid "ff8f2b42-23dc-5d66-b7ca-5f79b2db9d68" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ \\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186512718}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186512656} :answer-field/id #uuid "e7ed0a48-a7fd-5bb4-9c84-37c6a8b543d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512853}] :question/id #uuid "b27cf292-094d-512e-855d-8e418541cd09" :question/math-academy-id "q-138591" :question/problem "$$\nX=[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 2 & -2 & -3 & 7\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{x}_{2}=[\\begin{aligned}0 \\\\ -2\\end{aligned}],\\,{x}_{3}=[\\begin{aligned}1 \\\\ -3\\end{aligned}],\\,{x}_{4}=[\\begin{aligned}0 \\\\ 7\\end{aligned}].\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}1 \\\\ 2\\end{aligned}]+[\\begin{aligned}0 \\\\ -2\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}]+[\\begin{aligned}0 \\\\ 7\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44f55327-e5e0-5b53-b975-ff63991e5282" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186512243} {:answer/id #uuid "8efda6cd-141f-5350-a1f5-d71b313fd0e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186512435} {:answer/id #uuid "99a0c948-2647-5d5d-89cd-05affd33ccd6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186512460} {:answer/id #uuid "d81ee82a-b0d6-5a90-b4c7-d66a7ac4a6e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186512615} {:answer/id #uuid "dd34b4f4-4513-5aa2-817b-3b15838c2384" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -\\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186512630}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186512243} :answer-field/id #uuid "a0e94315-388e-53ae-b553-50eed95f095c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512810}] :question/id #uuid "c1c74464-e8b7-5891-8564-303d0ba39aac" :question/math-academy-id "q-138590" :question/problem "$$\nX=[\\begin{aligned}-2 & 4 & 7 & -9 \\\\ 4 & 11 & -5 & -14\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=[\\begin{aligned}-2 \\\\ 4\\end{aligned}],\\,{x}_{2}=[\\begin{aligned}4 \\\\ 11\\end{aligned}],\\,{x}_{3}=[\\begin{aligned}7 \\\\ -5\\end{aligned}],\\,{x}_{4}=[\\begin{aligned}-9 \\\\ -14\\end{aligned}].\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}-2 \\\\ 4\\end{aligned}]+[\\begin{aligned}4 \\\\ 11\\end{aligned}]+[\\begin{aligned}7 \\\\ -5\\end{aligned}]+[\\begin{aligned}-9 \\\\ -14\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}0 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -1\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2901be06-c328-542a-aba8-2369a692e944" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512192} {:answer/id #uuid "59529f53-d72b-556d-a082-f77b13cba5e3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186512307} {:answer/id #uuid "67c840b9-f6ec-5b84-8ccb-2377297d6c59" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 14\\end{aligned}]" :db/id #edb/ref 17592186512346} {:answer/id #uuid "ad0392c6-8d09-55ed-8ea4-be4561cb77d3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512506} {:answer/id #uuid "c8fda5d1-ee44-518a-9035-6bf86a63af15" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186512585}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{3}{2} \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186512192} :answer-field/id #uuid "94227b2d-ce1e-5457-b5aa-47970dcde623" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512802}] :question/id #uuid "f38b0380-d78d-5094-b9f0-211071b581d6" :question/math-academy-id "q-138597" :question/problem "$$\nX=[\\begin{aligned}-1 & 0 & -3 & -2 \\\\ 7 & 10 & 8 & 3\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample mean vector of $X.$" :question/worked-solution "Recall that the sample mean vector is given by\n\n$$\nm=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i},\n$$\n\nwhere ${x}_{1},{x}_{2},…,{x}_{n}$ are the individual observations (columns of $X$).\n\nFrom the matrix, we have that  \n\n$$\n{x}_{1}=[\\begin{aligned}-1 \\\\ 7\\end{aligned}],\\,{x}_{2}=[\\begin{aligned}0 \\\\ 10\\end{aligned}],\\,{x}_{3}=[\\begin{aligned}-3 \\\\ 8\\end{aligned}],\\,{x}_{4}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, the sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{4}({x}_{1}+{x}_{2}+{x}_{3}+{x}_{4}) \\\\  & =\\frac{1}{4}([\\begin{aligned}-1 \\\\ 7\\end{aligned}]+[\\begin{aligned}0 \\\\ 10\\end{aligned}]+[\\begin{aligned}-3 \\\\ 8\\end{aligned}]+[\\begin{aligned}-2 \\\\ 3\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}-6 \\\\ 28\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{3}{2} \\\\ 7\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Sample Mean of an Observation Matrix"} {:db/id #edb/ref 17592186162095 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161908 :question/id #uuid "bd9fe016-cd5f-5e65-b388-35725ac0fbf4" :question/math-academy-id "e-9834" :question/problem "![](images/44/44fa46a2d63c5c59dcc95df4132bdfa56400989234b44d2a382eaa2e51d5713b.svg)\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC = \\dfrac{1}{n-1} B B^T,\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}([\\begin{aligned}2 \\\\ -4\\end{aligned}]+[\\begin{aligned}6 \\\\ 1\\end{aligned}]+[\\begin{aligned}4 \\\\ 6\\end{aligned}]) \\\\  & =\\frac{1}{3}[\\begin{aligned}12 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=[\\begin{aligned}2 \\\\ -4\\end{aligned}]-[\\begin{aligned}4 \\\\ 1\\end{aligned}]=[\\begin{aligned}-2 \\\\ -5\\end{aligned}] \\\\ {b}_{2} & ={x}_{2}-m=[\\begin{aligned}6 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ 1\\end{aligned}]=[\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\ {b}_{3} & ={x}_{3}-m=[\\begin{aligned}4 \\\\ 6\\end{aligned}]-[\\begin{aligned}4 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n![](images/91/91d73b98e8b008382c1ef311fa262b1c2f0287d6ec64e3e86bd4734304ada251.svg)\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}[\\begin{aligned}-2 & 2 & 0 \\\\ -5 & 0 & 5\\end{aligned}][\\begin{aligned}-2 & -5 \\\\ 2 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}8 & 10 \\\\ 10 & 50\\end{aligned}].\\end{aligned}\n$$"} :knowledge-point/id #uuid "dc84d72a-b9f3-5f99-aa23-31cfe6910d49" :knowledge-point/questions [{:db/id #edb/ref 17592186162354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bcec93e-d7e4-55fc-819d-e39a0c56c36a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}10 & 4 \\\\ 4 & 6\\end{aligned}]" :db/id #edb/ref 17592186512228} {:answer/id #uuid "66dc2bfe-a8d0-52a2-bc36-bab980d55b1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & -2 \\\\ -2 & 14\\end{aligned}]" :db/id #edb/ref 17592186512345} {:answer/id #uuid "ad38523d-e931-56dc-9284-35ef8fafb131" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & -4 \\\\ -4 & 14\\end{aligned}]" :db/id #edb/ref 17592186512507} {:answer/id #uuid "b62c6af3-3c8a-56d5-b2ac-1774ba25ab19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & 4 \\\\ 4 & -1\\end{aligned}]" :db/id #edb/ref 17592186512532} {:answer/id #uuid "b933cfc5-7683-5ac9-83e0-5bc009cb9e7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}0 & 4 \\\\ 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186512543}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & -4 \\\\ -4 & 14\\end{aligned}]" :db/id #edb/ref 17592186512507} :answer-field/id #uuid "77dc06de-331a-582a-93eb-90b96470671a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159326}] :question/id #uuid "bfee1079-b365-5e37-895d-1b49cb096f78" :question/math-academy-id "q-137297" :question/problem "$$\nB=[\\begin{aligned}1 & -2 & 4 & -3 \\\\ 0 & 3 & -1 & -2\\end{aligned}]\n$$\n\nConsider the observation matrix $B$ in the mean-deviation form above, where the individual observations are given in columns. \nFind the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}C & =\\frac{1}{4-1}[\\begin{aligned}1 & -2 & 4 & -3 \\\\ 0 & 3 & -1 & -2\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 3 \\\\ 4 & -1 \\\\ -3 & -2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}30 & -4 \\\\ -4 & 14\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186162355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23427465-7faa-5ff0-b334-b66b99b1e3d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}74 & -9 \\\\ -9 & 6\\end{aligned}]" :db/id #edb/ref 17592186512175} {:answer/id #uuid "585eb8e8-05fa-5f15-975e-62db16d4ca73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}34 & -9 \\\\ -9 & 12\\end{aligned}]" :db/id #edb/ref 17592186512302} {:answer/id #uuid "5e602860-7b01-5bf5-9eef-058a5b7a3b43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}34 & -9 \\\\ -9 & 25\\end{aligned}]" :db/id #edb/ref 17592186512322} {:answer/id #uuid "a58cfba0-1623-53e1-b489-d1c2c499e821" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}74 & -6 \\\\ -6 & 7\\end{aligned}]" :db/id #edb/ref 17592186512489} {:answer/id #uuid "f5bf6451-c2f0-513e-b209-8d9a57401167" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}74 & -9 \\\\ -9 & 12\\end{aligned}]" :db/id #edb/ref 17592186512693}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}74 & -9 \\\\ -9 & 6\\end{aligned}]" :db/id #edb/ref 17592186512175} :answer-field/id #uuid "d42b2188-6c7d-56df-9ede-76ac26a0c9bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159332}] :question/id #uuid "fd71fe61-2928-5f70-8006-22add51dc115" :question/math-academy-id "q-137298" :question/problem "$$\nX=[\\begin{aligned}1 & -10 & 0 \\\\ 3 & 3 & 0\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}([\\begin{aligned}1 \\\\ 3\\end{aligned}]+[\\begin{aligned}-10 \\\\ 3\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}]) \\\\  & =\\frac{1}{3}[\\begin{aligned}-9 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=[\\begin{aligned}1 \\\\ 3\\end{aligned}]-[\\begin{aligned}-3 \\\\ 2\\end{aligned}]=[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\ {b}_{2} & ={x}_{2}-m=[\\begin{aligned}-10 \\\\ 3\\end{aligned}]-[\\begin{aligned}-3 \\\\ 2\\end{aligned}]=[\\begin{aligned}-7 \\\\ 1\\end{aligned}] \\\\ {b}_{3} & ={x}_{3}-m=[\\begin{aligned}0 \\\\ 0\\end{aligned}]-[\\begin{aligned}-3 \\\\ 2\\end{aligned}]=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=[\\begin{aligned}4 & -7 & 3 \\\\ 1 & 1 & -2\\end{aligned}].\n$$\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}[\\begin{aligned}4 & -7 & 3 \\\\ 1 & 1 & -2\\end{aligned}][\\begin{aligned}4 & 1 \\\\ -7 & 1 \\\\ 3 & -2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}74 & -9 \\\\ -9 & 6\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186410431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32553198-4247-5c51-aaff-735cd1f400b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}2 & 1 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186410240} {:answer/id #uuid "5089ccec-dbdc-5176-876d-be7464e512d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}3 & -1 \\\\ -1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186410258} {:answer/id #uuid "9d1835d4-2d7a-5203-af02-da60f52fa656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}3 & 1 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186410305} {:answer/id #uuid "ab0dabcb-1994-53de-9ca9-1943be5e5cde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186410320} {:answer/id #uuid "af3ec0f0-e34b-503b-876e-317e6bdbb214" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186410323}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186410320} :answer-field/id #uuid "f0fcff68-ef82-5cf2-80e9-66e229051d3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410414}] :question/id #uuid "903f2879-32c5-5f80-9994-a71eea52244c" :question/math-academy-id "q-138637" :question/problem "$$\nX=\\begin{bmatrix}2 & 1 & 3 \\\\ 4 & 6 & 5\\end{bmatrix}\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 6\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}) \\\\  & =\\frac{1}{3}\\begin{bmatrix}6 \\\\ 15\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\ {b}_{2} & ={x}_{2}-m=\\begin{bmatrix}1 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix} \\\\ {b}_{3} & ={x}_{3}-m=\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=\\begin{bmatrix}0 & -1 & 1 \\\\ -1 & 1 & 0\\end{bmatrix}.\n$$\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}\\begin{bmatrix}0 & -1 & 1 \\\\ -1 & 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 \\\\ -1 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}2 & -1 \\\\ -1 & 2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd9255b-f615-5d83-92d9-2bc78b91998e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & 15 \\\\ 15 & 26\\end{aligned}]" :db/id #edb/ref 17592186512130} {:answer/id #uuid "79759a38-a235-5771-92d6-228d11800351" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}37 & -87 \\\\ -87 & 14\\end{aligned}]" :db/id #edb/ref 17592186512387} {:answer/id #uuid "90c22079-4b59-5228-be34-e7bd06a853b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}9 & 0 \\\\ 0 & 15\\end{aligned}]" :db/id #edb/ref 17592186512442} {:answer/id #uuid "bf7bf3b9-12f7-5121-8c02-4ec81b6cd692" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}9 & 27 \\\\ 27 & 34\\end{aligned}]" :db/id #edb/ref 17592186512560} {:answer/id #uuid "f26c8ed4-8447-5837-bfea-0aa85c183599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}11 & 8 \\\\ 8 & 34\\end{aligned}]" :db/id #edb/ref 17592186512686}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}30 & 15 \\\\ 15 & 26\\end{aligned}]" :db/id #edb/ref 17592186512130} :answer-field/id #uuid "a45e3436-de97-54f9-a787-6f9a2b4c2e98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512812}] :question/id #uuid "11c41377-dcf0-57a2-b4f3-049053a2f2ed" :question/math-academy-id "q-138628" :question/problem "$$\nB=[\\begin{aligned}2 & -4 & -1 & 3 \\\\ 1 & -4 & 3 & 0\\end{aligned}]\n$$\n\nConsider the observation matrix $B$ in the mean-deviation form above, where the individual observations are given in columns. \nFind the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}C & =\\frac{1}{4-1}[\\begin{aligned}2 & -4 & -1 & 3 \\\\ 1 & -4 & 3 & 0\\end{aligned}][\\begin{aligned}2 & 1 \\\\ -4 & -4 \\\\ -1 & 3 \\\\ 3 & 0\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}30 & 15 \\\\ 15 & 26\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221e06ea-f68c-51ef-b279-1b5f659de9d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}8 & 0 \\\\ 0 & 18\\end{aligned}]" :db/id #edb/ref 17592186512172} {:answer/id #uuid "4a37a48b-8c5c-5ce1-8b9b-361377f41e19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}0 & -6 \\\\ -6 & 9\\end{aligned}]" :db/id #edb/ref 17592186512256} {:answer/id #uuid "8e900ee1-3dca-5910-b252-b7b9299af900" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}8 & -6 \\\\ -6 & 18\\end{aligned}]" :db/id #edb/ref 17592186512433} {:answer/id #uuid "99853a00-52f1-50b5-8ddd-c3bbcc1f0f0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}4 & -6 \\\\ -6 & 9\\end{aligned}]" :db/id #edb/ref 17592186512459} {:answer/id #uuid "d7ba38e6-e652-5b50-b3d7-ba917e7a89bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}4 & 0 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186512613}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}8 & -6 \\\\ -6 & 18\\end{aligned}]" :db/id #edb/ref 17592186512433} :answer-field/id #uuid "2ee2384a-f8ed-53d5-a42e-da2c4beee47c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512749}] :question/id #uuid "67636a56-1e5b-5200-b7f3-14f05ab714df" :question/math-academy-id "q-138640" :question/problem "$$\nX=[\\begin{aligned}-2 & 0 & 2 \\\\ 5 & 8 & 2\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}([\\begin{aligned}-2 \\\\ 5\\end{aligned}]+[\\begin{aligned}0 \\\\ 8\\end{aligned}]+[\\begin{aligned}2 \\\\ 2\\end{aligned}]) \\\\  & =\\frac{1}{3}[\\begin{aligned}0 \\\\ 15\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=[\\begin{aligned}-2 \\\\ 5\\end{aligned}]-[\\begin{aligned}0 \\\\ 5\\end{aligned}]=[\\begin{aligned}-2 \\\\ 0\\end{aligned}] \\\\ {b}_{2} & ={x}_{2}-m=[\\begin{aligned}0 \\\\ 8\\end{aligned}]-[\\begin{aligned}0 \\\\ 5\\end{aligned}]=[\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\ {b}_{3} & ={x}_{3}-m=[\\begin{aligned}2 \\\\ 2\\end{aligned}]-[\\begin{aligned}0 \\\\ 5\\end{aligned}]=[\\begin{aligned}2 \\\\ -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=[\\begin{aligned}-2 & 0 & 2 \\\\ 0 & 3 & -3\\end{aligned}].\n$$\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}[\\begin{aligned}-2 & 0 & 2 \\\\ 0 & 3 & -3\\end{aligned}][\\begin{aligned}-2 & 0 \\\\ 0 & 3 \\\\ 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}8 & -6 \\\\ -6 & 18\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186512915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b7af902-b842-5b29-a228-d25f383a43ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}9 & 3 \\\\ 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186512227} {:answer/id #uuid "4536e172-f637-5139-9267-23d685944188" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}18 & -3 \\\\ -3 & 2\\end{aligned}]" :db/id #edb/ref 17592186512244} {:answer/id #uuid "58969516-8d79-5408-bf8d-22119bd156fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}18 & 3 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186512305} {:answer/id #uuid "7dacd88f-1a54-51a7-88e9-6306954f67ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}18 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186512395} {:answer/id #uuid "faa4bf33-0b8b-57e1-99cc-e6c1e2c14038" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186512702}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}18 & -3 \\\\ -3 & 2\\end{aligned}]" :db/id #edb/ref 17592186512244} :answer-field/id #uuid "b4dedb56-1543-5c95-9a8b-146642e9b77e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512821}] :question/id #uuid "a2f76723-41c1-52ba-a0e5-e2eb590f9ddf" :question/math-academy-id "q-138641" :question/problem "$$\nX=[\\begin{aligned}7 & 13 & 10 \\\\ 1 & 0 & -1\\end{aligned}]\n$$\n\nConsider the observation matrix $X$ above, where the individual observations are given in columns. Find the sample covariance matrix of the data." :question/worked-solution "Recall that  the sample covariance matrix is given by\n\n$$\nC=\\frac{1}{n-1}B{B}^{T},\n$$\n\nwhere $B$ is the observation matrix in the mean-deviation form, and $n$ is the number of observations.\n\nSo, we first need to compute the mean-deviation form of our observation matrix.\n\nThe sample mean is\n\n$$\n\\begin{aligned}m & =\\frac{1}{3}({x}_{1}+{x}_{2}+{x}_{3}) \\\\  & =\\frac{1}{3}([\\begin{aligned}7 \\\\ 1\\end{aligned}]+[\\begin{aligned}13 \\\\ 0\\end{aligned}]+[\\begin{aligned}10 \\\\ -1\\end{aligned}]) \\\\  & =\\frac{1}{3}[\\begin{aligned}30 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNow, we have the following:\n\n$$\n\\begin{aligned}{b}_{1} & ={x}_{1}-m=[\\begin{aligned}7 \\\\ 1\\end{aligned}]-[\\begin{aligned}10 \\\\ 0\\end{aligned}]=[\\begin{aligned}-3 \\\\ 1\\end{aligned}] \\\\ {b}_{2} & ={x}_{2}-m=[\\begin{aligned}13 \\\\ 0\\end{aligned}]-[\\begin{aligned}10 \\\\ 0\\end{aligned}]=[\\begin{aligned}3 \\\\ 0\\end{aligned}] \\\\ {b}_{3} & ={x}_{3}-m=[\\begin{aligned}10 \\\\ -1\\end{aligned}]-[\\begin{aligned}10 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,  the mean-deviation form is\n\n$$\nB=[\\begin{aligned}-3 & 3 & 0 \\\\ 1 & 0 & -1\\end{aligned}].\n$$\n\nFinally, the sample covariance matrix is \n\n$$\n\\begin{aligned}C & =\\frac{1}{3-1}[\\begin{aligned}-3 & 3 & 0 \\\\ 1 & 0 & -1\\end{aligned}][\\begin{aligned}-3 & 1 \\\\ 3 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}18 & -3 \\\\ -3 & 2\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313c180d-6683-5895-8319-1cc5e1d0047d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}62 & -69 \\\\ -69 & 242\\end{aligned}]" :db/id #edb/ref 17592186536360} {:answer/id #uuid "3528ecab-4caa-5dc2-8341-f72254cce85e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}25 & -25 \\\\ -25 & 47\\end{aligned}]" :db/id #edb/ref 17592186536366} {:answer/id #uuid "4c4801ac-f3c0-54c9-9d9b-068066aba1b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}[\\begin{aligned}52 & 30 \\\\ 30 & 250\\end{aligned}]" :db/id #edb/ref 17592186536409} {:answer/id #uuid "551ede1c-3223-5e2