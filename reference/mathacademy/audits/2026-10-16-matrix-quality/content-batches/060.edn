 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e5d8b9-aa23-509f-9d82-cbc0a58b88aa" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257118} {:answer/id #uuid "523c5ff0-288c-54a6-8984-dab86593561a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257483} {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} {:answer/id #uuid "de5a4cff-b039-5894-8b6c-7aad63c636fc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258717} {:answer/id #uuid "fb952160-6ec2-5819-80f3-0686d4603494" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186258981}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} :answer-field/id #uuid "514ff102-c238-5181-bd9a-4ee63292ed41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259176}] :question/id #uuid "569ad093-da2b-5144-992e-0f84b411665b" :question/math-academy-id "q-124263" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+av-2,\\,y=bu+cv-3\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}4 & -1 \\\\ 9 & 5\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}4u-v \\\\ 9u+5v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u-v-2 \\\\ 9u+5v-3\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+(-1)v-2,\\,y=9u+5v-3\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+9+5=13.\n$$"} {:db/id #edb/ref 17592186259643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "506f9d2d-d08a-56f9-98e6-3535609b1da4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257470} {:answer/id #uuid "76cc7d25-0d63-5fa5-9287-8cd0b7cf87ca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257829} {:answer/id #uuid "bbf5d7a0-0461-5380-8b1d-7aa6631a5d16" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258425} {:answer/id #uuid "c14197eb-d474-53b1-b351-f8738ddeafd2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258471} {:answer/id #uuid "e94689f3-f817-50df-9027-5eb925d967a7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258804} :answer-field/id #uuid "ea132969-c4fb-52c6-aa2f-d42f10a0b35d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259441}] :question/id #uuid "e491209f-8e14-5a51-846e-3087f73ab2f3" :question/math-academy-id "q-124265" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+6v+b,\\,y=cu-4v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 6 \\\\ 3 & -4\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+6v \\\\ 3u-4v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=1u+6v+0,\\,y=3u-4v\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+0+3=4.\n$$"} {:db/id #edb/ref 17592186259644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bc5571-4143-5aae-96cf-6f2be18ea704" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186256958} {:answer/id #uuid "2b6e7a59-7e19-5f06-994d-4e3590c3b8bc" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257171} {:answer/id #uuid "c64c4347-213c-5d26-b1fc-9c4dcd0170a7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258516} {:answer/id #uuid "d59fa816-e9ed-5fd9-bd9c-9869013fe1c6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258655} {:answer/id #uuid "f8f07afd-8b4a-5912-b02f-c853e792c6e4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258967} :answer-field/id #uuid "611144f2-0911-5d73-99aa-6da505f8fa68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259197}] :question/id #uuid "9cc9e110-657b-5c50-af6f-2ba6688d538a" :question/math-academy-id "q-124267" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au-2v+b,\\,y=4u+cv-2\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-6 & -2 \\\\ 4 & 7\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}-6u-2v \\\\ 4u+7v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6u-2v+1 \\\\ 4u+7v-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-6u-2v+1,\\,y=4u+7v-2\n$$\n\nTherefore, we have\n\n$$\na+b+c=-6+1+7=2.\n$$"} {:db/id #edb/ref 17592186435170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e78d75-7cc9-5f8f-a311-f9561d084ef0" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435151} {:answer/id #uuid "5cbd50d4-87c1-52b7-9640-b711a0fd95b4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435153} {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} {:answer/id #uuid "7df97388-6b5d-5314-a0e2-f9db5b72c685" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435156} {:answer/id #uuid "9e8c9a39-bea2-5dc9-ae9f-054f40df79f8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435160}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} :answer-field/id #uuid "9adca1c4-5980-5cfc-b795-52fbb2b1c569" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435168}] :question/id #uuid "924019d9-3882-5c74-a8d2-1e7c35a68ea0" :question/math-academy-id "q-124260" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+a,\\,y=6u+bv+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}4 & 0 \\\\ 6 & 2\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u \\\\ 6u+2v-1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+0,\\,y=6u+2v+(-1)\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+2+(-1)=1.\n$$"}] :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :topic/math-academy-id 3387 :topic/title "Affine Transformations"}]}
