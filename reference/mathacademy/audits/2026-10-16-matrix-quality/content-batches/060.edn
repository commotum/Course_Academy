x}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-5+7+(-2)=0.\n$$"} {:db/id #edb/ref 17592186259657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5242ad89-24a8-59cd-978d-3f922bae4da0" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186257484} {:answer/id #uuid "648b6c21-0d27-5132-aead-92eb0f89efc9" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186257666} {:answer/id #uuid "ab8b2be3-dc38-5c58-b346-813a07b3593a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258278} {:answer/id #uuid "c9a7ff15-8e83-5c21-a366-f5f18ecdbc90" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258538} {:answer/id #uuid "dde2292e-86d8-569d-9201-a0071cbb9521" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258712}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258538} :answer-field/id #uuid "6629122c-5a24-5ed6-8deb-f43d051c11d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259208}] :question/id #uuid "5c629231-167c-5031-b500-0861e24a5b23" :question/math-academy-id "q-124301" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u-v,\\,y=2u-3v+4\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & -1 \\\\ 2 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6u-v \\\\ 2u-3v+4\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6u-v \\\\ 2u-3v+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u-v \\\\ 2u-3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 4\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}6 & -1 \\\\ 2 & -3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=6+(-3)+4=7.\n$$"} {:db/id #edb/ref 17592186435082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec2e130-ad0b-5d90-874b-cafee34e58c7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435066} {:answer/id #uuid "6bf5a0c1-0205-502f-9cbc-8cd0d9139fcc" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186435067} {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} {:answer/id #uuid "d090baef-9223-53ba-b7a5-e64a993a1878" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435074} {:answer/id #uuid "dcc4abca-dbd0-5a8c-8460-f14372be7eed" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186435075}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} :answer-field/id #uuid "3d3eb90b-b341-501f-a49e-f9c67d7e1ee8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435078}] :question/id #uuid "fba38d94-94f1-5e40-9342-c81f8eabc355" :question/math-academy-id "q-124296" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u+4v+2,\\,y=5v-1\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 & a \\\\ 0 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}6u+4v+2 \\\\ 5v-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u+4v \\\\ 5v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}6 & 4 \\\\ 0 & 5\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=4+5+(-1)=8.\n$$"} {:db/id #edb/ref 17592186435169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c225a4-fa6b-5ff4-a3be-9440301a14e4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435157} {:answer/id #uuid "99696a64-81b6-56b3-ae94-3cf2f2bf032d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435159} {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} {:answer/id #uuid "c4beb685-88bd-5864-8597-0ef45eddb0b6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435162} {:answer/id #uuid "d78bfad4-b673-5a93-bb2a-0e0334cd3321" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435164}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} :answer-field/id #uuid "29e8d3c2-d32c-5baa-954b-7b5d1efc7457" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435166}] :question/id #uuid "0f1617b1-29a0-58b4-80d3-cf8ca8d2090f" :question/math-academy-id "q-124288" :question/problem "The matrix form of the affine transformation\n\n$$\nx=2u+5v,\\,y=u-3v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2 & 5 \\\\ a & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ c\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix} \\\\  & =\\begin{bmatrix}2u+5v \\\\ u-3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}2 & 5 \\\\ 1 & -3\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+(-3)+0=-2.\n$$"} {:db/id #edb/ref 17592186435171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5023974e-65e9-50b5-9103-6472584bc9df" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435152} {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} {:answer/id #uuid "88148730-01ef-5f8f-8698-d5c0f9002897" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435158} {:answer/id #uuid "d60c5735-4076-5c3e-b98e-aa72880ddf6c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435163} {:answer/id #uuid "eeb2f54f-b084-5556-a569-1423fbe14b78" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435165}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} :answer-field/id #uuid "8859ffa2-d430-5120-8081-1bbcdaf58a41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435167}] :question/id #uuid "abc616ba-5b7e-5285-91c7-65fdcb2a91f9" :question/math-academy-id "q-124299" :question/problem "The matrix form of the affine transformation\n\n$$\nx=v-7u,\\,y=2v-u\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}a & 1 \\\\ -1 & b\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}c \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix}.\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}v-7u \\\\ 2v-u\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7u+v \\\\ -u+2v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}-7 & 1 \\\\ -1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+2+0=-5.\n$$"}] :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"} {:db/id #edb/ref 17592186172094 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171900 :question/id #uuid "2ddc4e15-3729-5425-953c-1cb95edc201b" :question/math-academy-id "e-9508" :question/problem "The matrix form of the affine transformation\n\n$$\nx = 3u-v + \\bbox[Gainsboro,2pt]{a}, \\qquad y = u + \\bbox[Gainsboro,2pt]{b}v + \\bbox[Gainsboro,2pt]{c}\n$$\n\nis shown below. What is the value of $a+b+c?$\n![](images/43/43bcde1806155410ba97b0b2e5807d4a0f9cee93ef04f2ccfb413552de74178b.png)" :question/worked-solution "An affine transformation $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is a function of the form\n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}3 & -1 \\\\ 1 & -5\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}3u-v \\\\ u-5v\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3u-v+1 \\\\ u-5v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx = 3u - v + \\bbox[Gainsboro,2pt]{1}, \\qquad y = u + (\\bbox[Gainsboro,2pt]{-5})v + \\bbox[Gainsboro,2pt]{0} \\, .\n$$\n\nTherefore, we have\n\n$$\na+b+c = 1+(-5)+0 = -4.\n$$"} :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/questions [{:db/id #edb/ref 17592186172295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003c72ab-a274-52ab-aa2c-2593da45d334" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186256784} {:answer/id #uuid "7e750f7c-8312-5236-a7f3-e877f7f70512" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257905} {:answer/id #uuid "a6ab775c-a099-5165-bdb5-243b28bd32ea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258236} {:answer/id #uuid "dee951d0-1321-54ed-8801-95e0057779e5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258724} {:answer/id #uuid "eb76beb7-5c43-55e3-8818-e328ff068342" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258822}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257905} :answer-field/id #uuid "62c09496-ed8d-5b09-8ce6-b28b1163e1a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259200}] :question/id #uuid "01d5649d-0bb8-52a3-be74-234b60c39fb7" :question/math-academy-id "q-124091" :question/problem "The matrix form of the affine transformation\n\n$$\nx=-u+av+b,\\,y=2u-5v+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 & 4 \\\\ 2 & -5\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-1 & 4 \\\\ 2 & -5\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}-u+4v \\\\ 2u-5v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-u+4v+2 \\\\ 2u-5v+1\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-u+4v+2,\\,y=2u-5v+1\n$$\n\nTherefore, we have\n\n$$\na+b+c=4+2+1=7.\n$$"} {:db/id #edb/ref 17592186172297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051434b8-c984-5c6a-8955-1f0b60930d56" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186256829} {:answer/id #uuid "2752c7eb-4676-56ab-b0cd-1bf9a38e162f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257126} {:answer/id #uuid "59eb0a37-274e-5830-8b80-ff23964f5119" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186257562} {:answer/id #uuid "81280065-bedd-5f73-8e81-255309fdda87" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186257929} {:answer/id #uuid "e993acbd-20a6-5dc9-8643-05cf5a9fa4b4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258811}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258811} :answer-field/id #uuid "c0be749e-1222-5271-990b-b7537ef677e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259367}] :question/id #uuid "9882bc48-ffe2-5a96-827b-d1eb44c92577" :question/math-academy-id "q-124271" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+4v,\\,y=-5u+bv+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-3 & 4 \\\\ -5 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}-3 & 4 \\\\ -5 & 3\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}-3u+4v \\\\ -5u+3v\\end{bmatrix}+\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3u+4v \\\\ -5u+3v\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-3u+4v,\\,y=-5u+3v+0\n$$\n\nTherefore, we have\n\n$$\na+b+c=-3+3+0=0.\n$$"} {:db/id #edb/ref 17592186259639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227340af-71d1-5d08-ace5-1c9258c8fcf4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257065} {:answer/id #uuid "30bb3807-55a5-5cda-b326-fdec9c047352" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257211} {:answer/id #uuid "41438c81-cf63-57d7-afc0-35b56a8a92f4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257363} {:answer/id #uuid "eeb37718-f272-5547-a58a-87b172f20251" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258850} {:answer/id #uuid "ffd38fa9-a703-5a9b-9e62-e43d804d84e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259031}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258850} :answer-field/id #uuid "e68f436c-5c06-5c77-ab1f-cbf71cb2e171" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259435}] :question/id #uuid "248bc276-68c1-5b41-9594-c7af8b2e1b35" :question/math-academy-id "q-124259" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+bv+3,\\,y=-9u+cv+4\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -9 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -9 & 4\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}u \\\\ -9u+4v\\end{bmatrix}+\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}u+3 \\\\ -9u+4v+4\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=1u+0v+3,\\,y=-9u+4v+4\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+0+4=5.\n$$"} {:db/id #edb/ref 17592186259640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e740d3a-5c03-5dd2-816a-487643106091" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186257194} {:answer/id #uuid "33a79aaa-17fe-5ec0-9815-f48d8949b65f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186257239} {:answer/id #uuid "73970941-5456-5fe8-906f-5e233465ae16" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186257796} {:answer/id #uuid "9158f20d-6a83-542a-9c54-77af73ba69ff" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258067} {:answer/id #uuid "ce7c1236-c621-5444-b1e2-cd41e1db1cdd" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186258575}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186258575} :answer-field/id #uuid "671307a9-23d3-54b5-988a-ecf7a2f8a2ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259210}] :question/id #uuid "ded880b4-9f04-5275-85c1-4486642a0a7d" :question/math-academy-id "q-124261" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+bv-2,\\,y=u+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}6 & 8 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}u \\\\ v\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\overset{A}{\\overset{⏞}{\\begin{bmatrix}6 & 8 \\\\ 1 & 0\\end{bmatrix}}}\\cdot \\overset{u}{\\overset{⏞}{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}}+\\overset{b}{\\overset{⏞}{\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix}}} \\\\  & =\\begin{bmatrix}6u+8v \\\\ u\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}6u+8v-2 \\\\ u+5\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=6u+8v-2,\\,y=u+5\n$$\n\nTherefore, we have\n\n$$\na+b+c=6+8+5=19.\n$$"} {:db/id #edb/ref 17592186259641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe1c6ee-1822-5943-a4ab-95e2e8729c1b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257204} {:answer/id #uuid "42afdead-f7ba-55b9-837b-58a7ebcab735" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257371} {:answer/id #uuid "5b54affb-22be-504f-9fc3-75ecc52418c4" :answer/type {:db