/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546082} {:answer-field/choices [{:answer/id #uuid "69bdaeef-02b5-5b7a-a5a0-687c66364d69" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186546087}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186546087} :answer-field/id #uuid "5e2d02d6-09ee-5014-aac8-8438944d2467" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546086} {:answer-field/choices [{:answer/id #uuid "a9124733-c34c-585c-bb51-b04bcc7ca5a2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186546090}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186546090} :answer-field/id #uuid "e5b84dd4-e476-5bc8-9f61-955e858415b2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546092}] :question/id #uuid "03f9a283-ab45-59cd-b539-75cdc65061b6" :question/problem "Find the product $AB,$ if\n$A=\\begin{bmatrix}2\\sqrt{13} & -3 & 6 \\\\ 3 & \\sqrt{3} & -1 \\\\ 7 & -1 & 0\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "Notice that $B$ is the $2$nd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $2$nd *column* of the identity matrix ${I}_{3},$ the result must be the $2$nd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2\\sqrt{13} & -3 & 6 \\\\ 3 & \\sqrt{3} & -1 \\\\ 7 & -1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\sqrt{13}\\cdot 0+(-3)\\cdot 1+6\\cdot 0 \\\\ 3\\cdot 0+\\sqrt{3}\\cdot 1+(-1)\\cdot 0 \\\\ 7\\cdot 0+(-1)\\cdot 1+0\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ \\sqrt{3} \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186546083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346a9c36-9c70-5a26-a683-b26b85be243e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\sqrt{11} \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186546084} {:answer/id #uuid "59c9f45b-de24-5684-9e28-4baa92ba5926" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{6} & 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186546085} {:answer/id #uuid "8a367c8b-e09a-5e10-8f5d-0a988ff5dc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6\\end{bmatrix}" :db/id #edb/ref 17592186546088} {:answer/id #uuid "8e5b5143-6112-5bdb-a30c-e60d12cefc73" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} {:answer/id #uuid "c22141b6-ad0a-5d40-b9aa-254caa95396e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3\\sqrt{10} \\\\ -4 \\\\ 3\\sqrt{6}\\end{bmatrix}" :db/id #edb/ref 17592186546091}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186546089} :answer-field/id #uuid "fa2cb576-db76-5f72-8574-1fafaae20058" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546094}] :question/id #uuid "2d472ae0-7d53-527e-b3ef-7cd75481083e" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3},$ the result must be the $3$rd *column* of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}3\\sqrt{10} & -1 & 4.6 \\\\ -4 & 2\\sqrt{11} & -1.7 \\\\ 3\\sqrt{6} & 6 & 9\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\sqrt{10}\\cdot 0+(-1)\\cdot 0+4.6\\cdot 1 \\\\ (-4)\\cdot 0+2\\sqrt{11}\\cdot 0+(-1.7)\\cdot 1 \\\\ 3\\sqrt{6}\\cdot 0+6\\cdot 0+9\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4.6 \\\\ -1.7 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :topic/math-academy-id 1171 :topic/title "Multiplying a Matrix by the Identity Matrix"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186153053} :activity/id #uuid "7d3eac14-632f-5a58-a023-44f29da9dd83" :activity/steps [{:db/id #edb/ref 17592186153053 :step/content {:db/id #edb/ref 17592186153352 :tutorial/content "Remember that the column space of a matrix is the span of its columns. For example, for the matrix\n\n![](images/6f/6f8184c584bac2ae9f4f0655d6de2f05bae48142caa729cc24faa30eb5e38774.svg)\n\nthe column space is\n\n![](images/83/83a4941812514b331349e96637ba4fc3d9686e85704506855f931efc3ed3d539.svg)\n\nSo, to find a basis of $\\textrm{Col}(A),$ we can apply the usual procedure of converting the matrix $A$ to row echelon form and then picking the pivot columns from the original matrix $A.$" :tutorial/id #uuid "141672d1-fa24-513d-ba34-8cbf5a1d0b84" :tutorial/math-academy-id 3965 :tutorial/title "Introduction"} :step/id #uuid "89804eda-a3ae-5485-b48e-d4ab4a5760e0" :step/next {:db/id #edb/ref 17592186153054}} {:db/id #edb/ref 17592186153054 :step/content {:db/id #edb/ref 17592186152155 :knowledge-point/id #uuid "39d79985-57fa-554a-b697-4bd6dd71cbe2"} :step/id #uuid "675dd937-a474-5a45-ab38-929745f4d3a7" :step/next {:db/id #edb/ref 17592186153055}} {:db/id #edb/ref 17592186153055 :step/content {:db/id #edb/ref 17592186153353 :tutorial/content "In the previous example, we computed a basis of $\\textrm{Col}(A),$ where \n\n![](images/c8/c8e10a79d647ed7867d42eae1eff7d37840f541cfce26e47d84f66da4e9f0c96.svg)\n\nThe basis that we found previously was\n\n![](images/84/84cdf6af82bd0d301ca50b1c7c41bccbd0a3cfb42be17bc84ec2f12e46032161.svg)\n\nTherefore, we can write\n\n![](images/22/22d4eb11af0168d4fabc8b3ebbe1befd24620db11b6a31709472ba91bb1ed794.svg)\n\nThe vector $\\mathbf{a}_3$ was not included in the basis because the $3$rd column of $A$ was not a pivot column. This means that $\\mathbf{a}_3$ can be written as a linear combination of $\\mathbf{a}_1$ and $\\mathbf{a}_2.$\n\nNow, what if we want to find the exact linear combination of $\\mathbf{a}_1$ and $\\mathbf{a}_2$ that yields $\\mathbf{a}_3?$ That is to say, we want to find $x_1, x_2 \\in \\mathbb{R}$ such that \n\n![](images/f3/f3f4e0d48c58be10684eada3fd320001dc056f2d1070707d9443c9533b7b5e35.svg)\n\nThis is equivalent to a system with the augmented matrix\n![](images/cf/cf66dc341420f6c399e1ad7e108986505cb349d3aba1aeaacee636e7b6ec4b94.svg)\n\nIf we reduced this matrix to the *reduced* row echelon form, we get\n\n![](images/84/847a4dd2e37e6e577bd9a38160f03bcb5839fbf617d76ebe0a2b42cdba0ebce1.svg)\n\nFinally, the third column of the *reduced* matrix tells us that $x_1=3$ and $x_2=-2,$ meaning that\n![](images/18/1892b80eb017795a7420b59053b836bea894ff77b7478fc7f884de6b43384cb1.svg)\n\nIn general, if the $n$th column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express $\\mathbf{a}_n$ as a linear combination of all the other columns in the original matrix. \n\n**Watch out!** The matrix must be written in *reduced* row echelon form (with $1$'s for pivots and $0$'s above and below the pivots), not just in a row echelon form." :tutorial/id #uuid "cb82414a-0cb2-5363-9301-c8d79896bc22" :tutorial/math-academy-id 3966 :tutorial/title "Finding a Particular Linear Combination of Vectors"} :step/id #uuid "3bd1dbe7-2b70-5718-9b1c-1634535fb285" :step/next {:db/id #edb/ref 17592186153056}} {:db/id #edb/ref 17592186153056 :step/content {:db/id #edb/ref 17592186152156 :knowledge-point/id #uuid "db27967e-f80c-587b-9b10-28f1a5518f57"} :step/id #uuid "665e0a4a-ccbf-5a7f-9823-1d0163d85f44" :step/next {:db/id #edb/ref 17592186153057}} {:db/id #edb/ref 17592186153057 :step/content {:db/id #edb/ref 17592186152157 :knowledge-point/id #uuid "c3bf9ea3-d57f-53f6-aa3c-eddffe1a8cfa"} :step/id #uuid "4fcbb627-ddcb-5a6f-aa6f-8950fb6d730a"}] :activity/title "Finding a Basis of the Column Space of a Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186152330} {:activity/first-step {:db/id #edb/ref 17592186435360} :activity/id #uuid "c57c3bdd-8d76-577e-8a0a-9775110cfcb1" :activity/steps [{:db/id #edb/ref 17592186435359 :step/content {:db/id #edb/ref 17592186435358 :question/id #uuid "fa6c549b-f344-52f9-9015-63f22befbecb"} :step/id #uuid "0a6387a3-d6c3-514a-adf3-03c92255b693"} {:db/id #edb/ref 17592186435360 :step/content {:db/id #edb/ref 17592186152582 :question/id #uuid "6cb6cc6e-d524-533e-a923-e69196a1f53b"} :step/id #uuid "56aac62a-1ac3-595b-9746-f6129816ec3d" :step/next {:db/id #edb/ref 17592186435361}} {:db/id #edb/ref 17592186435361 :step/content {:db/id #edb/ref 17592186435356 :question/id #uuid "60c7ad14-43d6-5b2c-81c2-60bb8c562302"} :step/id #uuid "83ebb46d-c1c6-5af5-a88b-0a90f6597d01" :step/next {:db/id #edb/ref 17592186435363}} {:db/id #edb/ref 17592186435362 :step/content {:db/id #edb/ref 17592186345143 :question/id #uuid "8e38527f-7273-52c9-bec3-d94fc3af2837"} :step/id #uuid "96ef3e91-81f5-56af-9b4b-af5a3c54255c" :step/next {:db/id #edb/ref 17592186435359}} {:db/id #edb/ref 17592186435363 :step/content {:db/id #edb/ref 17592186435357 :question/id #uuid "8e2ef874-d6ff-53a7-81b2-d096ed751911"} :step/id #uuid "af78af8e-c58a-51c1-8a5d-a8deb9557dbb" :step/next {:db/id #edb/ref 17592186435362}}] :activity/title "Finding a Basis of the Column Space of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186435337} {:activity/first-step {:db/id #edb/ref 17592186484350} :activity/id #uuid "774a94cd-8530-573f-80d6-592f51a33b36" :activity/steps [{:db/id #edb/ref 17592186484303 :step/content {:db/id #edb/ref 17592186484219 :question/id #uuid "4e023a9e-c79a-53ca-9a76-a188bd7ab902"} :step/id #uuid "0b8b441f-1ac7-578f-9670-a1e7fdce2cfe" :step/next {:db/id #edb/ref 17592186484311}} {:db/id #edb/ref 17592186484307 :step/content {:db/id #edb/ref 17592186423621 :question/id #uuid "693e6ed3-909b-52a6-8fa3-e0e6ae013327"} :step/id #uuid "17548c6c-a0db-59ae-8691-b5c2e89ec05c" :step/next {:db/id #edb/ref 17592186484323}} {:db/id #edb/ref 17592186484311 :step/content {:db/id #edb/ref 17592186345151 :question/id #uuid "c466a2ff-d594-54f8-8655-5aeb347fd10d"} :step/id #uuid "2285bbbb-2b94-5bc1-a8a2-c4f8628b9d46" :step/next {:db/id #edb/ref 17592186484307}} {:db/id #edb/ref 17592186484323 :step/content {:db/id #edb/ref 17592186484287 :question/id #uuid "eb27e567-0848-5034-b8d8-32b6b421d46e"} :step/id #uuid "57e1f077-3a25-541d-a79a-09e739748679"} {:db/id #edb/ref 17592186484350 :step/content {:db/id #edb/ref 17592186484246 :question/id #uuid "88299f24-4f45-5ffe-aaf6-eeca4cfa5124"} :step/id #uuid "c7e441a7-a721-5e10-85ac-7c952dabd92c" :step/next {:db/id #edb/ref 17592186484303}}] :activity/title "Finding a Basis of the Column Space of a Matrix" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186483560} {:activity/first-step {:db/id #edb/ref 17592186500435} :activity/id #uuid "e7c02049-f7b0-5a67-8205-05144398a180" :activity/steps [{:db/id #edb/ref 17592186500406 :step/content {:db/id #edb/ref 17592186247232 :question/id #uuid "4d5f352a-5b0e-55b2-a382-bea7929379c7"} :step/id #uuid "5c3d8e97-0b51-5