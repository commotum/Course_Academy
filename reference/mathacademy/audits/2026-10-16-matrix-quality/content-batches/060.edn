 \\\\ -1\\cdot 0+1\\cdot 1+(-4)\\cdot 0 \\\\ 5\\cdot 0+4\\cdot 1+(-2)\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/question-generator {:db/id #edb/ref 17592186546095 :question-generator/id #uuid "f90de4b9-eae0-5d75-89ef-ff61bc2ec28a" :question-generator/script "generate/scratch/17592186100876.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a95370d-414b-5eac-8919-246de33eac09" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 2\\sqrt{5} & -2.5\\end{bmatrix}" :db/id #edb/ref 17592186099604} {:answer/id #uuid "a84bcb4e-521f-5ea1-9075-3e249dbed932" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5 \\\\ -2.5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186099605} {:answer/id #uuid "e006e13f-10ad-5b98-98da-0e4073b443c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\sqrt{5} \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186099606} {:answer/id #uuid "2c32ad2d-131b-5f58-b76f-c00ad96820b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186099607} {:answer/id #uuid "695edc9d-dd29-5f2a-b8fd-06ab5abd1f2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5\\end{bmatrix}" :db/id #edb/ref 17592186099608}] :answer-field/id #uuid "954dd7be-0875-59ee-8cb2-ab4ad7d267c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099603} {:answer-field/choices [{:answer/id #uuid "e77b0e35-b8ea-5618-ab6c-8503315df0e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5 \\\\ -2.5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186392443} {:answer/id #uuid "b90bbe8b-d8e5-5080-