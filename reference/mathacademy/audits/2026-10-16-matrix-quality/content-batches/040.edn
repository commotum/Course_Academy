coordinates matrix ${P}_{B\\to C}$ is\n\n$$\n{P}_{B\\to C}=\\begin{bmatrix}-6 & 7 \\\\ 5 & -6\\end{bmatrix}.\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =\\begin{bmatrix}-6 & 7 \\\\ 5 & -6\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2994b03c-cde3-5534-8899-a7900655ae6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186348810} {:answer/id #uuid "78647311-f028-5c6d-bc7a-7864ac31f47a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186349557} {:answer/id #uuid "b2e9cefa-19ec-550d-8e66-1bd4ea3df959" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186350031} {:answer/id #uuid "d82a4a77-7e82-5f1a-b8f6-8ca0a3e74b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186350339} {:answer/id #uuid "e7dff555-b884-5500-a0a3-953700280bff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186350475}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186350339} :answer-field/id #uuid "60fc60db-2ddc-5233-b904-6a1365a51a3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350868}] :question/id #uuid "b8882db2-d0e5-5b74-84be-782103b781ca" :question/math-academy-id "q-82614" :question/problem "$$\nB={\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}},\\,C={\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\begin{bmatr