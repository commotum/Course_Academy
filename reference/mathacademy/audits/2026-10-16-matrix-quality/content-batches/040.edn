trix}8 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186440470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3371709f-eb7b-58f8-93cb-bb7d689a3fbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186440410} {:answer/id #uuid "3fffbe35-a610-576c-8afc-bc0238c80168" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186440413} {:answer/id #uuid "6e3b207a-4928-510d-a62a-dee0e13ac5c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186440425} {:answer/id #uuid "8a4c2018-80ac-5e49-b28f-484e2ec7a8ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186440430} {:answer/id #uuid "9ec51647-d0a5-5325-a518-840d3a070f89" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186440434}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186440434} :answer-field/id #uuid "b8a2471b-4cb7-5a36-8100-83473b7cc0c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440458}] :question/id #uuid "b6330ac1-ad9e-564b-a472-75f385cd01df" :question/math-academy-id "q-113599" :question/problem "$$\nB=\\{\\begin{bmatrix}4 \\\\ 3\\end{bmatrix},\\begin{bmatrix}6 \\\\ 5\\end{bmatrix}\\},\\,[x]_{S}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=\\begin{bmatrix}4 & 6 \\\\ 3 & 5\\end{bmatrix}.\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={\\begin{bmatrix}4 & 6 \\\\ 3 & 5\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{4\\cdot 5-6\\cdot 3}\\begin{bmatrix}5 & -6 \\\\ -3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{2} & -3 \\\\ -\\frac{3}{2} & 2\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =\\begin{bmatrix}\\frac{5}{2} & -3 \\\\ -\\frac{3}{2} & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5944a2-6f72-5f21-8b24-e64767793229" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186486018} {:answer/id #uuid "9f66dc53-0b31-5237-969a-2397bba21b1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186486050} {:answer/id #uuid "ae2979c6-49e8-5225-824c-1a6f38548151" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186486078} {:answer/id #uuid "b1ffe2c5-8479-52b3-b64d-d795dd8a896a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186486084} {:answer/id #uuid "c6cc0c71-6572-5be7-b79e-f4264330ac2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186486124}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186486018} :answer-field/id #uuid "d71b80ef-6d4c-597c-814a-17f8214907ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486325}] :question/id #uuid "72bf6680-369b-5d8c-9e49-1546d6428898" :question/math-academy-id "q-113598" :question/problem "$$\nB=\\{\\begin{bmatrix}3 \\\\ 1\\end{bmatrix},\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}\\},\\,[x]_{S}=\\begin{bmatrix}8 \\\\ 2\\end{bmatrix}\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=\\begin{bmatrix}3 & 4 \\\\ 1 & 2\\end{bmatrix}.\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={\\begin{bmatrix}3 & 4 \\\\ 1 & 2\\end{bmatrix}}^{-1} \\\\  & =\\frac{1}{3\\cdot 2-4\\cdot 1}\\begin{bmatrix}2 & -4 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ -\\frac{1}{2} & \\frac{3}{2}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ -\\frac{1}{2} & \\frac{3}{2}\\end{bmatrix}\\begin{bmatrix}8 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21856be1-b1fa-5f91-8a39-4aebb5209096" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186553926} {:answer/id #uuid "8a8f88fa-1943-5b66-9a8b-582f194c3e5c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186554163} {:answer/id #uuid "9c971210-23ba-5a3d-9d48-b48f9a6fc7d9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186554213} {:answer/id #uuid "c0c1e9fb-4917-514f-8d69-f634fa62d636" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186554289} {:answer/id #uuid "f5a9c01f-6c85-52fc-b668-f80c2e6a714d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186554402}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186554402} :answer-field/id #uuid "79a8ed53-1004-51ec-854e-1bc8377232da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554482}] :question/id #uuid "af173c80-5734-52f5-887a-4f2d2e37a60e" :question/math-academy-id "q-37159" :question/problem "$$\nB=\\{[\\begin{aligned}2 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ -1\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}0 \\\\ -2\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}2 & 2 \\\\ -2 & -1\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}2 & 2 \\\\ -2 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot (-1)-(-2)\\cdot 2}[\\begin{aligned}-1 & -2 \\\\ 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{2} & -1 \\\\ 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}-\\frac{1}{2} & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in the Standard Basis"} {:db/id #edb/ref 17592186124577 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124384 :question/id #uuid "f04f55d3-40ec-52a8-a762-d8ac7090b8b8" :question/math-academy-id "e-7276" :question/problem "The bases $\\mathcal{B}$ and $\\mathcal{C}$ of $\\mathbb{R}^2$ and the coordinates of the vector $\\mathbf{x}$ relative to the basis $\\mathcal{B}$ are given below. Find $[\\mathbf{x}]_{\\mathcal{C}}.$ \n\n![](images/c6/c61cc387c58af544cf95641a1c2a28e5412d223fb03a7afe5157ee4eba3902bb.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ and $\\mathcal{C}$ as $\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}$ and $\\{ \\mathbf{c}_1,\\mathbf{c}_2 \\},$ respectively.\n\nThe change-of-coordinates matrix from $\\mathcal{B}$ to $\\mathcal{C}$ is a matrix whose columns are the vectors of $\\mathcal{B}$ relative to the basis $\\mathcal{C}.$\n\nSo, we need to find the coordinates of $\\mathbf{b}_1$ and $\\mathbf{b}_2$ relative to the basis $\\mathcal{C}.$ We can do this simultaneously by considering the matrix\n![](images/76/76d9c82037008323681ec9a0745b39740bf1405c767fc9aaee411cdd1fadde1a.svg)\n\nReducing the left-hand side to reduced row-echelon form using Gaussian elimination, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 2 & 1 & 1 \\\\ 6 & 13 & 1 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-6){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 & 1 \\\\ 0 & 1 & -5 & -7\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 11 & 15 \\\\ 0 & 1 & -5 & -7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix $P_{\\small\\mathcal{B}\\to\\mathcal{C}}$ is\n![](images/48/481e6321dd23a8af4c59201685295862cc927731eeec31c122ec62bdf156d179.svg)\n\nFinally, we compute $[\\,\\mathbf{x}\\,]_{\\mathcal{C}}\\mathbin{:}$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =\\begin{bmatrix}11 & 15 \\\\ -5 & -7\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "36f8f02f-acbd-5930-bd0c-8675ac868577" :knowledge-point/questions [{:db/id #edb/ref 17592186124992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c50c8f3-2ffa-52d6-b0c4-ad1154deb379" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186440412} {:answer/id #uuid "4bf44605-44d3-5b61-899c-88515785b624" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186440418} {:answer/id #uuid "8643df82-0d8a-5f3e-a426-bcad789ef7d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186440429} {:answer/id #uuid "bdc16104-5ce0-50c3-bc26-57c6e33de6f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186440437} {:answer/id #uuid "dac0dfe8-7a53-5770-a8e2-9bd4c097c6bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ -8\\end{bmatrix}" :db/id #edb/ref 17592186440447}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186440412} :answer-field/id #uuid "ad3cb3a8-d1d3-5bb4-a5ae-5420e039345f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122552}] :question/id #uuid "ebf7f82a-f5ff-583f-9de1-a9dafa71d6c5" :question/math-academy-id "q-36487" :question/problem "$$\nB=\\{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}\\},\\,C=\\{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}\\},\\,[x]_{C}=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 3 & 1 & 2 \\\\ 2 & 7 & 2 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 1 & 2 \\\\ 0 & 1 & 0 & -4\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 14 \\\\ 0 & 1 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=\\begin{bmatrix}1 & 14 \\\\ 0 & -4\\end{bmatrix}.\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =\\begin{bmatrix}1 & 14 \\\\ 0 & -4\\end{bmatrix}\\begin{bmatrix}3 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-11 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b23109ea-3f33-5a0d-a555-be70df3868c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186122847} {:answer/id #uuid "17dc30e1-8fdb-5751-96a3-a1a12f294eda" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ \\frac{8}{3}\\end{bmatrix}" :db/id #edb/ref 17592186122848} {:answer/id #uuid "28feb14f-ac10-59b4-8feb-3bf6a7176c24" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186122849} {:answer/id #uuid "4b84f259-7270-52da-b6d0-866aeadfda4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ -10\\end{bmatrix}" :db/id #edb/ref 17592186122850} {:answer/id #uuid "7a0255e3-5073-5192-8adb-caea01164eb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-24 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186122851}] :answer-field/id #uuid "d26dee0f-3c05-5af8-ac1a-fadc3eb26fd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122846}] :question/id #uuid "26131c83-cbe6-5935-90bf-02d4ea8b6a48" :question/math-academy-id "q-37224" :question/problem "$B = {\\begin{bmatrix}0 \\\\ -2\\end{bmatrix}, \\begin{bmatrix}1 \\\\ 0\\end{bmatrix}}, C = {\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}, \\begin{bmatrix}1 \\\\ 4\\end{bmatrix}}, [x]_{B} = \\begin{bmatrix}6 \\\\ -9\\end{bmatrix}$.\n\nThe bases $B$ and $C$ of $R^{2}$ and the coordinates of the vector $x$ relative to the basis $B$ are given above. Find $[x]_{C}$."} {:db/id #edb/ref 17592186247393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "030b8289-6abe-59de-b79e-89b0fcae7447" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}13 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186244334} {:answer/id #uuid "26b397c9-8030-557a-b19c-02cb9ed1fe87" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186244656} {:answer/id #uuid "8a0bea36-00c3-5f77-a24a-a23770571091" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186245525} {:answer/id #uuid "c6030af2-4cb9-5caa-b879-74aa638283e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186246073} {:answer/id #uuid "f8421c64-b00d-560d-bfda-4de2a4888eb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186246498}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186246073} :answer-field/id #uuid "f1b441cf-caf3-5abd-9fbd-610499fed931" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246980}] :question/id #uuid "0e290de6-3133-56f5-894e-be4f887bce10" :question/math-academy-id "q-113689" :question/problem "$$\nB={\\begin{bmatrix}1 \\\\ 4\\end{bmatrix},\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}},\\,C={\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}},\\,[x]_{C}=\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}\n$$\n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $C$ are given above. Find $[x]_{B}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as ${{b}_{1},{b}_{2}}$ and ${{c}_{1},{c}_{2}}$, respectively.\n\nThe change-of-coordinates matrix from $C$ to $B$ is a matrix whose columns are the vectors of $C$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${c}_{1}$ and ${c}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=\\begin{bmatrix}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {c}_{1} & {c}_{2} \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & 1 & 2 & 1 \\\\ 4 & 5 & -3 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 & 1 \\\\ 0 & 1 & -11 & -6\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 13 & 7 \\\\ 0 & 1 & -11 & -6\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, the change-of-coordinates matrix ${P}_{C\\to B}$ is\n\n$$\n{P}_{C\\to B}=\\begin{bmatrix}13 & 7 \\\\ -11 & -6\\end{bmatrix}.\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =\\begin{bmatrix}13 & 7 \\\\ -11 & -6\\end{bmatrix}\\begin{bmatrix}2 \\\\ -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d75a68e-8c13-5a08-8a15-00f82421b4b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186244435} {:answer/id #uuid "11dbf2ca-3936-56ef-b744-cbeef6b82724" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -8\\end{bmatrix}" :db/id #edb/ref 17592186244479} {:answer/id #uuid "1df63ca9-e971-572f-a376-2fb9b301ab7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 7\\end{bmatrix}" :db/id #edb/ref 17592186244575} {:answer/id #uuid "a8793683-8433-5ac4-abb2-dff9688c9320" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592