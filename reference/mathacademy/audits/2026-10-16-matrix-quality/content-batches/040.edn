 III are true, while statement II is false."} {:db/id #edb/ref 17592186329646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca8eb228-c1aa-526c-bf90-27f66a9356c3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450642} {:answer/id #uuid "bd87b62f-9da3-5f73-ab7a-d82a98e30bc1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450643}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450642} :answer-field/id #uuid "75caa915-3858-5c01-a5f4-aac230541fcf" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451275} {:answer-field/choices [{:answer/id #uuid "df04892a-3fcd-5b6f-a931-273de40f055b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450644} {:answer/id #uuid "19d2a187-bbe2-537c-ac7f-4d7af02d3c9d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450645}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450645} :answer-field/id #uuid "bbdeb417-add7-50cd-8d61-987eb71ef15f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451276} {:answer-field/choices [{:answer/id #uuid "84322445-b037-524f-b315-0b6ef58f9865" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450646} {:answer/id #uuid "8e92c41b-83e4-555c-ac78-30c970f6f412" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450647}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450647} :answer-field/id #uuid "27f9d256-723e-592c-9c15-bc392aa403f0" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451277}] :question/id #