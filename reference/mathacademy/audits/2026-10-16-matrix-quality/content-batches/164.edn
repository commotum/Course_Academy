2 & 5 & -5 \\\\ -3 & -2 & -5 & -5\\end{bmatrix}" :db/id #edb/ref 17592186388395}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 2 & 5 & -5 \\\\ -2 & -7 & -7 & 0 \\\\ -2 & -2 & -2 & 3 \\\\ -3 & -2 & -5 & -5\\end{bmatrix}" :db/id #edb/ref 17592186388394} :answer-field/id #uuid "a66467bc-9a50-5d8e-837a-eeefeb49dc48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388390}] :question/id #uuid "665587c5-1a3a-55cd-89d1-5eea160afc62" :question/math-academy-id "q-135540" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=\\begin{bmatrix}-7+2\\text{i} \\\\ -2-7\\text{i} \\\\ -2-2\\text{i} \\\\ -3-2\\text{i}\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}5-5\\text{i} \\\\ -7 \\\\ -2+3\\text{i} \\\\ -5-5\\text{i}\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 4 & 0 & 0 \\\\ -4 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 2\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=4\\text{i}$ and ${\\lambda }_{3}=2+\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{bmatrix}\n$$\n\nand\n\n$$\nP=\\begin{bmatrix}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}0 & 4 & 0 & 0 \\\\ -4 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 2\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=\\begin{bmatrix}-7 & 2 & 5 & -5 \\\\ -2 & -7 & -7 & 0 \\\\ -2 & -2 & -2 & 3 \\\\ -3 & -2 & -5 & -5\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186388396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "883b4313-4bb8-5d4f-84c1-e4045f0ebd57" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 4 & -2 & -1 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7 \\\\ -2 & 5 & -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388398} {:answer/id #uuid "53a10f22-d07f-5fae-ae22-b9985262cea7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 4 & -1 & -2 \\\\ -2 & 5 & 0 & -3 \\\\ -7 & -6 & 5 & -2 \\\\ -1 & -2 & -7 & -1\\end{bmatrix}" :db/id #edb/ref 17592186388399} {:answer/id #uuid "8b3b3a54-e03c-56f5-9673-e3e28ea8c926" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -7 & -6 & -2 & 5 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388400} {:answer/id #uuid "de2fd6c5-fa2f-556c-95c0-4f10f5bc9f61" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & -6 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388401} {:answer/id #uuid "7998088e-5efb-5736-8bea-e03e47c352e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & -7 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ 5 & -2 & -3 & 0 \\\\ -2 & -1 & -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388402}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & -6 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388401} :answer-field/id #uuid "5cc20b43-4942-5f45-a74f-b446994961fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388397}] :question/id #uuid "ddf7b3a2-e8eb-5121-9578-ab00316d07bd" :question/math-academy-id "q-135541" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=\\begin{bmatrix}-7-6\\text{i} \\\\ 4+4\\text{i} \\\\ -2+5\\text{i} \\\\ -1-2\\text{i}\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}-2+5\\text{i} \\\\ -2-\\text{i} \\\\ -3 \\\\ -1-7\\text{i}\\end{bmatrix},\\,B=\\begin{bmatrix}-4 & -3 & 0 & 0 \\\\ 3 & -4 & 0 & 0 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & -2 & 0\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=-4-3\\text{i}$ and ${\\lambda }_{3}=2\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{bmatrix}\n$$\n\nand\n\n$$\nP=\\begin{bmatrix}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}-4 & -3 & 0 & 0 \\\\ 3 & -4 & 0 & 0 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & -2 & 0\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=\\begin{bmatrix}-7 & -6 & -2 & 5 \\\\ 4 & 4 & -2 & -1 \\\\ -2 & 5 & -3 & 0 \\\\ -1 & -2 & -1 & -7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186562397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40074340-d749-5f86-b10c-2825baa1aec2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 4 & 1 & 5 \\\\ 3 & -3 & -5 & -3 \\\\ 5 & 1 & 1 & 3 \\\\ -6 & 1 & -4 & -4\\end{aligned}]" :db/id #edb/ref 17592186561738} {:answer/id #uuid "66ac5e6e-8d56-56a0-9cbc-d8a60681de45" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 1 & -4 & -4 \\\\ 5 & 1 & 1 & 3 \\\\ -1 & 4 & 1 & 5 \\\\ 3 & -3 & -5 & -3\\end{aligned}]" :db/id #edb/ref 17592186561835} {:answer/id #uuid "9fd78c44-bda0-58d3-a7b9-8a8aaefd389a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 4 & 1 & 5 \\\\ -6 & 1 & -4 & -4 \\\\ 5 & 1 & 1 & 3 \\\\ 3 & -3 & -5 & -3\\end{aligned}]" :db/id #edb/ref 17592186561975} {:answer/id #uuid "c3355bb9-c2db-5224-ae74-770c5b30a759" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -1 & 1 & 5 \\\\ 1 & -6 & -4 & -4 \\\\ 1 & 5 & 1 & 3 \\\\ -3 & 3 & -5 & -3\\end{aligned}]" :db/id #edb/ref 17592186562073} {:answer/id #uuid "cfd0a51b-0c69-594b-a56c-77159dcf3138" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 1 & -4 & -4 \\\\ 5 & 1 & 3 & 1 \\\\ -1 & 4 & 5 & 1 \\\\ 3 & -3 & -3 & -5\\end{aligned}]" :db/id #edb/ref 17592186562100}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 4 & 1 & 5 \\\\ -6 & 1 & -4 & -4 \\\\ 5 & 1 & 1 & 3 \\\\ 3 & -3 & -5 & -3\\end{aligned}]" :db/id #edb/ref 17592186561975} :answer-field/id #uuid "caf88bf2-1584-5767-b02d-c2d3fa67af5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562351}] :question/id #uuid "0d0837bb-a312-5fc1-a5fe-74a16c2207cb" :question/math-academy-id "q-135539" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=[\\begin{aligned}-1+4\\text{i} \\\\ -6+\\text{i} \\\\ 5+\\text{i} \\\\ 3-3\\text{i}\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}1+5\\text{i} \\\\ -4-4\\text{i} \\\\ 1+3\\text{i} \\\\ -5-3\\text{i}\\end{aligned}],\\,B=[\\begin{aligned}-2 & -2 & 0 & 0 \\\\ 2 & -2 & 0 & 0 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & -4 & 0\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=-2-2\\text{i}$ and ${\\lambda }_{3}=4\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{aligned}]\n$$\n\nand\n\n$$\nP=[\\begin{aligned}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}-2 & -2 & 0 & 0 \\\\ 2 & -2 & 0 & 0 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & -4 & 0\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=[\\begin{aligned}-1 & 4 & 1 & 5 \\\\ -6 & 1 & -4 & -4 \\\\ 5 & 1 & 1 & 3 \\\\ 3 & -3 & -5 & -3\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186562497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8bc467-4f82-5758-99ba-9799d92a2ddf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 5 & 1 & -5 \\\\ -5 & -1 & 4 & 4 \\\\ 5 & 0 & 1 & -4 \\\\ -4 & 3 & 4 & -6\\end{aligned}]" :db/id #edb/ref 17592186561618} {:answer/id #uuid "8669ee5b-2412-57d2-b0aa-06341f0d07e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -1 & 4 & 4 \\\\ -2 & 5 & 1 & -5 \\\\ -4 & 3 & 4 & -6 \\\\ 5 & 0 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186561918} {:answer/id #uuid "b71c6ea4-3aa2-5b7e-8818-b3735f517002" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 5 & 1 & -5 \\\\ -4 & 3 & 4 & -6 \\\\ -5 & -1 & 4 & 4 \\\\ 5 & 0 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186562040} {:answer/id #uuid "eb73eef6-715d-508e-a66b-4d05b04b5bf1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -1 & 4 & 4 \\\\ 5 & 0 & 1 & -4 \\\\ -4 & 3 & 4 & -6 \\\\ -2 & 5 & 1 & -5\\end{aligned}]" :db/id #edb/ref 17592186562173} {:answer/id #uuid "f4688075-facf-538c-bcae-94936c913af5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -5 & 4 & 4 \\\\ 5 & -2 & 1 & -5 \\\\ 3 & -4 & 4 & -6 \\\\ 0 & 5 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186562191}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -1 & 4 & 4 \\\\ -2 & 5 & 1 & -5 \\\\ -4 & 3 & 4 & -6 \\\\ 5 & 0 & 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186561918} :answer-field/id #uuid "d10e5258-d2f4-58bf-af8d-2359214f5726" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562355}] :question/id #uuid "d78d725a-0502-5fe2-897f-ae0775056dbc" :question/math-academy-id "q-135535" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=[\\begin{aligned}-5-\\text{i} \\\\ -2+5\\text{i} \\\\ -4+3\\text{i} \\\\ 5\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}4+4\\text{i} \\\\ 1-5\\text{i} \\\\ 4-6\\text{i} \\\\ 1-4\\text{i}\\end{aligned}],\\,B=[\\begin{aligned}-1 & -2 & 0 & 0 \\\\ 2 & -1 & 0 & 0 \\\\ 0 & 0 & -4 & -1 \\\\ 0 & 0 & 1 & -4\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=-1-2\\text{i}$ and ${\\lambda }_{3}=-4-\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{aligned}]\n$$\n\nand\n\n$$\nP=[\\begin{aligned}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}-1 & -2 & 0 & 0 \\\\ 2 & -1 & 0 & 0 \\\\ 0 & 0 & -4 & -1 \\\\ 0 & 0 & 1 & -4\\end{aligned}],\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=[\\begin{aligned}-5 & -1 & 4 & 4 \\\\ -2 & 5 & 1 & -5 \\\\ -4 & 3 & 4 & -6 \\\\ 5 & 0 & 1 & -4\\end{aligned}].\n$$"}] :knowledge-point/title "Calculating the Invertible Matrix in Block Diagonal Form of an NxN Matrix"} {:db/id #edb/ref 17592186129160 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128978 :question/id #uuid "da515ea7-f4b0-58c5-adab-c826563dd3cf" :question/math-academy-id "e-5906" :question/problem "![](images/d1/d1ccd9a2d6dacbb3651b5dc54121bd6aff3e1846d01c5e4855ea97c932f0f5fe.svg)\n\nConsider the nonsingular matrix $P$ and the block diagonal matrix $B$ shown above, where the $2 \\times 2$ block of $B$ is a rotation-scaling matrix.\nGiven that $A=PBP^{-1},$ what are the complex (not real) eigenvalues and the corresponding eigenvectors of $A?$" :question/worked-solution "Recall that if $A$ is a $3\\times 3$ real matrix that has one real eigenvalue ${\\co