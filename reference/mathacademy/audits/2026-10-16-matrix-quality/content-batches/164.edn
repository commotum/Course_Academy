 }_{2}) \\\\ 0 & -\\text{Im}({\\lambda }_{2}) & \\text{Re}({\\lambda }_{2})\\end{bmatrix},\\,\\,P=\\begin{bmatrix}| & | & | \\\\ {v}_{1} & \\text{Re}({v}_{2}) & \\text{Im}({v}_{2}) \\\\ | & | & |\\end{bmatrix}.\n$$\n\nNotice that swapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\n- From our block diagonal matrix \n\n$$\nB=\\begin{bmatrix}-7 & 0 & 0 \\\\ 0 & -2 & 5 \\\\ 0 & -5 & -2\\end{bmatrix},\n$$\n\nwe deduce the complex eigenvalues are ${\\lambda }_{2,3}=-2\\pm 5\\text{i}$ and the real eigenvalue is ${\\lambda }_{1}=-7.$\n\n- From our matrix \n\n$$\nP=\\begin{bmatrix}1 & -2 & 0 \\\\ 5 & 0 & -2 \\\\ 0 & 1 & -1\\end{bmatrix},\n$$\n\nwe deduce that the complex and real eigenvectors are\n\n$$\n{v}_{2,3}=\\begin{bmatrix}-2 \\\\ ∓2\\text{i} \\\\ 1∓\\text{i}\\end{bmatrix},\\,{v}_{1}=\\begin{bmatrix}1 \\\\ 5 \\\\ 0\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186269061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b5a9d49-25f9-5366-8bc7-c890c3a78895" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5\\pm 7\\text{i}$ and $v=\\begin{bmatrix}-4∓6\\text{i} \\\\ ∓2\\text{i} \\\\ 1\\pm 5\\text{i}\\end{bmatrix}$" :db/id #edb/ref 17592186266527} {:answer/id #uuid "6bf84c1b-3625-51fc-8524-a1d7940f3c1f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-5\\pm \\text{i}$ and $v=\\begin{bmatrix}2\\pm 6\\text{i} \\\\ ∓\\text{i} \\\\ 3∓5\\text{i}\\end{bmatrix}$" :db/id #edb/ref 17592186267098} {:answer/id #uuid "71f304ba-84ea-5528-bcb3-689937cb3050" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =7\\pm 5\\text{i}$ and $v=\\begin{bmatrix}2\\pm 6\\text{i} \\\\ \\pm 2\\text{i} \\\\ 3\\pm 5\\text{i}\\end{bmatrix}$" :db/id #edb/ref 17592186267143} {:answer/id #uuid "9e57d696-3ab4-5b6f-bbfb-0232c8d15f8b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =5\\pm 7\\text{i}$ and $v=\\begin{bmatrix}4\\pm 6\\text{i} \\\\ ∓2\\text{i} \\\\ 