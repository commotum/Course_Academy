text{Im}({\\lambda }_{2}) \\\\ 0 & -\\text{Im}({\\lambda }_{2}) & \\text{Re}({\\lambda }_{2})\\end{bmatrix},\\,\\,P=\\begin{bmatrix}| & | & | \\\\ {v}_{1} & \\text{Re}({v}_{2}) & \\text{Im}({v}_{2}) \\\\ | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 4 & 8 \\\\ 0 & -8 & 4\\end{bmatrix},\n$$\n\nwe deduce that the first column of $P$ will correspond to the real eigenvector ${v}_{1}$ and the second and third columns of $P$ will correspond to the complex eigenvector ${v}_{2}:$\n\n$$\nP=\\begin{bmatrix}4 & 1 & -1 \\\\ 0 & -6 & 3 \\\\ -3 & 0 & -5\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186562516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "035ceaee-b6ca-5bb4-bfb9-11a4ca0e530b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 & 1 \\\\ 4 & 1 & 0 \\\\ 0 & 6 & 5\\end{aligned}]" :db/id #edb/ref 17592186561591} {:answer/id #uuid "2df44d7b-3fe5-59c3-a32d-b054a9cc4efb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ 5 & 6 & 0\\end{aligned}]" :db/id #edb/ref 17592186561704} {:answer/id #uuid "58cb07a3-f5b3-5b99-8901-735dd9a5bbd2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 & 3 \\\\ 1 & 0 & 4 \\\\ 6 & 5 & 0\\end{aligned}]" :db/id #edb/ref 17592186561800} {:answer/id #uuid "627e06b9-a4f1-547f-b90c-619445bcbf56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 1 \\\\ 5 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186561822} {:answer/id #uuid "7480a3aa-70a0-5247-9a31-5c1c0daba1af" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 5 \\\\ 0 & 1 & 4 \\\\ 3 & -6 & 0\\end{aligned}]" :db/id #edb/ref 17592186561871}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ 5 & 6 & 0\\end{aligned}]" :db/id #edb/ref 17592186561704} :answer-field/id #uuid "1d98f8e9-9d6e-5d2c-b15c-295f14d86b6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562239}] :question/id #uuid "fbaefedd-28e7-5c12-a8d5-d4c5ca3fba32" :question/math-academy-id "q-38885" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{2}$ and the block diagonal matrix $B$ shown below, where the $2\\times 2$ block of $B$ represents a rotation-scaling matrix:\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 5\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}2+3\\text{i} \\\\ 1+4\\text{i} \\\\ 6\\end{aligned}],\\,B=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 3 & 5 \\\\ 0 & -5 & 3\\end{aligned}]\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{2}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3+5\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a real $3\\times 3$ matrix that has one real eigenvalue ${\\lambda }_{1}$ with corresponding eigenvector ${v}_{1},$ and two complex eigenvalues ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{3}$ with corresponding eigenvectors ${v}_{2}={\\overset{―}{v}}_{3},$ then $A=PB{P}^{-1},$ where\n\n$$\nB=[\\begin{aligned}{\\lambda }_{1} & 0 & 0 \\\\ 0 & \\text{Re}({\\lambda }_{2}) & \\text{Im}({\\lambda }_{2}) \\\\ 0 & -\\text{Im}({\\lambda }_{2}) & \\text{Re}({\\lambda }_{2})\\end{aligned}],\\,\\,P=[\\begin{aligned}| & | & | \\\\ {v}_{1} & \\text{Re}({v}_{2}) & \\text{Im}({v}_{2}) \\\\ | & | & |\\end{aligned}].\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 3 & 5 \\\\ 0 & -5 & 3\\end{aligned}],\n$$\n\nwe deduce that the first column of $P$ correspond to the real eigenvector ${v}_{1},$ and the second and third columns of $P$ correspond to the complex eigenvector ${v}_{2}.$ Therefore, \n\n$$\nP=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 4 \\\\ 5 & 6 & 0\\end{aligned}]\n$$"}] :knowledge-point/title "Calculating the Invertible Matrix in Block Diagonal Form of a 3x3 Matrix"} {:db/id #edb/ref 17592186129139 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128950 :question/id #uuid "2b2a7fbc-8911-507f-915c-cf9b50653e5f" :question/math-academy-id "e-5535" :question/problem "Consider the vectors $\\mathbf{v}_1$ and $\\mathbf{v}_3$ and the block diagonal matrix $B$ shown below, where both $2 \\times 2$ blocks of $B$ represent rotation-scaling matrices:\n![](images/68/68d39dc9fbe16467e2039054956fafa2818ba7978262472c34aa01eab12330dc.svg)\nThe vectors $\\mathbf{v}_1$ and $\\mathbf{v}_3$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues $\\lambda_1=7 + 4\\textrm{i}$ and $\\lambda_3=-3 + 2\\textrm{i},$ respectively. \nGiven that $A=PBP^{-1},$ find a possible matrix $P.$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\qquad$ ${\\color{red}\\lambda_1}=\\overline{\\color{red}\\lambda}_{\\color{red}2} \\quad$ and $\\quad {\\color{blue}\\lambda_3}=\\overline{\\color{blue}\\lambda}_{\\color{blue}4}$ \n\nwith corresponding eigenvectors \n\n$\\qquad$ ${\\color{red}\\mathbf{v}_1} = \\overline{\\color{red}\\mathbf{v}}_{\\color{red}2} \\quad$ and $\\quad {\\color{blue}\\mathbf{v}_3} = \\overline{\\color{blue}\\mathbf{v}}_{\\color{blue}4},$ \n\nthen $A=PBP^{-1},$ where\n![](images/e2/e217aa741bc60bcbacc8be44916b8c98a5f2433a2473bdb308467a032fcdc5d8.svg)\nand\n![](images/66/66248fe00b7c6c8b246cf434e181cb6eb8377df791d19e2031760414f01a54f1.svg)\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n![](images/b1/b170bd9280cab68d887b417f5eb3b7ff6d61f78094939ab76f9e7c98bb43f4cc.svg)\nwe deduce that the first and second columns of $P$ will correspond to the complex eigenvector ${\\color{red}{\\mathbf{v}_1}},$ and the third and forth columns of $P$ will correspond to the complex eigenvector ${\\color{blue}\\mathbf{v}_3}.$ Therefore,\n![](images/6f/6f5efdb321ab6b4f1e55b75d03262c7b4437fcbe2de7af853ba7cf562877efe5.svg)"} :knowledge-point/id #uuid "e5ccd12c-a814-5ebb-985c-eef8707001f0" :knowledge-point/questions [{:db/id #edb/ref 17592186129466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad142ac4-c7bc-5c39-82ec-71f1c754e77a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 3 & 2 & -6 \\\\ 4 & -1 & 4 & -6 \\\\ 0 & 5 & 4 & -2 \\\\ -6 & -4 & 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186126297} {:answer/id #uuid "05014410-cfbe-58f1-aae5-5f83fc0d0fa8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 & 4 & -2 \\\\ 3 & -7 & 2 & -6 \\\\ -1 & 4 & 4 & -6 \\\\ -4 & -6 & 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186126298} {:answer/id #uuid "2f516914-3814-5c09-bda5-df3c625f275f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 3 & -6 & 2 \\\\ 4 & -1 & -6 & 4 \\\\ 0 & 5 & -2 & 4 \\\\ -6 & -4 & -5 & 0\\end{bmatrix}" :db/id #edb/ref 17592186126299} {:answer/id #uuid "5ce6b8f5-875b-57eb-9be3-5b5ecf50db89" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 3 & 2 & -6 \\\\ 0 & 5 & 4 & -2 \\\\ -6 & -4 & 0 & -5 \\\\ 4 & -1 & 4 & -6\\end{bmatrix}" :db/id #edb/ref 17592186126300} {:answer/id #uuid "65463ed7-a430-5e61-930e-0f8dcc51a7f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 5 & 4 & -2 \\\\ -7 & 3 & 2 & -6 \\\\ 4 & -1 & 4 & -6 \\\\ -6 & -4 & 0 & -5\\end{bmatrix}" :db/id #edb/ref 17592186126301}] :answer-field/id #uuid "ed8d60fb-afe5-5f58-8d96-129e6b92436d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126296}] :question/id #uuid "2ee10611-8d98-5ed6-92a2-545ae1c00469" :question/math-academy-id "q-135542" :question/problem "Consider the vectors $v_{1}$ and $v_{3}$ and the block diagonal matrix $B$ shown below, where both $2 \\cdot 2$ blocks of $B$ represent rotation-scaling matrices:\n$v_{1} = \\begin{bmatrix}5\\textrm{i} \\\\ -7 + 3\\textrm{i} \\\\ 4 - \\textrm{i} \\\\ -6 - 4\\textrm{i}\\end{bmatrix}, v_{3} = \\begin{bmatrix}4 - 2\\textrm{i} \\\\ 2 - 6\\textrm{i} \\\\ 4 - 6\\textrm{i} \\\\ -5\\textrm{i}\\end{bmatrix}, B = \\begin{bmatrix}2 & -2 & 0 & 0 \\\\ 2 & 2 & 0 & 0 \\\\ 0 & 0 & -3 & 5 \\\\ 0 & 0 & -5 & -3\\end{bmatrix}$\nThe vectors $v_{1}$ and $v_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues $λ_{1} = 2 - 2\\textrm{i}$ and $λ_{3} =-3 + 5\\textrm{i}$, respectively.\nGiven that $A = PBP^{-1}$, which of the following could be the matrix $P$?"} {:db/id #edb/ref 17592186129689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e907fba-b633-5ce7-87fd-6d60b0dd0741" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 2 & 3 \\\\ 2 & 1 & -1 & 1 \\\\ 0 & 5 & -1 & 3 \\\\ 2 & -1 & 2 & -5\\end{bmatrix}" :db/id #edb/ref 17592186127616} {:answer/id #uuid "6a2eccf3-8723-5785-af36-ad88fdf32a99" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 & -1 & 1 \\\\ -1 & 1 & 1 & 2 \\\\ -1 & 3 & 5 & 0 \\\\ 2 & -5 & -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186127617} {:answer/id #uuid "6a551bce-9359-5271-ad09-d1c33571f943" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 3 & 2 \\\\ 2 & 1 & 1 & -1 \\\\ 0 & 5 & 3 & -1 \\\\ 2 & -1 & -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186127618} {:answer/id #uuid "7e6e209e-adcd-52a9-b6bf-1d560c049794" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 & 1 & -1 \\\\ 1 & -1 & 2 & 1 \\\\ 3 & -1 & 0 & 5 \\\\ -5 & 2 & 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186127619} {:answer/id #uuid "7e84ed97-2a97-5a97-970a-567f6e6aee91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 & 3 & 2 \\\\ 1 & 2 & 1 & -1 \\\\ 5 & 0 & 3 & -1 \\\\ -1 & 2 & -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186127620}] :answer-field/id #uuid "0dac7611-914b-528d-a967-47601fb6e226" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127615} {:answer-field/choices [{:answer/id #uuid "cabffd63-2296-5f5c-a066-c962f36ffd25" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 & -1 & 1 \\\\ -1 & 1 & 1 & 2 \\\\ -1 & 3 & 5 & 0 \\\\ 2 & -5 & -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186392213} {:answer/id #uuid "f6d889f7-5492-5c24-9a6e-fddd71e907f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 2 & 3 \\\\ 2 & 1 & -1 & 1 \\\\ 0 & 5 & -1 & 3 \\\\ 2 & -1 & 2 & -5\\end{bmatrix}" :db/id #edb/ref 17592186392214} {:answer/id #uuid "901bdce8-d745-579e-aed4-6fe3d74e5506" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 & 3 & 2 \\\\ 1 & 2 & 1 & -1 \\\\ 5 & 0 & 3 & -1 \\\\ -1 & 2 & -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186392215} {:answer/id #uuid "cccd6271-af0d-5f27-8aaa-cfd954bd1005" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 & 1 & -1 \\\\ 1 & -1 & 2 & 1 \\\\ 3 & -1 & 0 & 5 \\\\ -5 & 2 & 2 & -1\\end{bmatrix}" :db/id #edb/ref 17592186392216} {:answer/id #uuid "a9185e3c-728f-5a79-86c0-b4ff4fa7834e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 3 & 2 \\\\ 2 & 1 & 1 & -1 \\\\ 0 & 5 & 3 & -1 \\\\ 2 & -1 & -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186392217}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 3 & 2 \\\\ 2 & 1 & 1 & -1 \\\\ 0 & 5 & 3 & -1 \\\\ 2 & -1 & -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186392217} :answer-field/id #uuid "e76deac7-6e75-57f3-9f90-b969f5d59a36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392212}] :question/id #uuid "ea128924-b87b-5c95-97cb-7bad7050bb1f" :question/math-academy-id "q-38667" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=\\begin{bmatrix}1-\\text{i} \\\\ 2+\\text{i} \\\\ 5\\text{i} \\\\ 2-\\text{i}\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}3+2\\text{i} \\\\ 1-\\text{i} \\\\ 3-\\text{i} \\\\ -5+2\\text{i}\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -1 & 0 & 0 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & -1 & 5\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=2-\\text{i}$ and ${\\lambda }_{3}=\\text{i}+5,$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{bmatrix}\n$$\n\nand\n\n$$\nP=\\begin{bmatrix}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}2 & -1 & 0 & 0 \\\\ 1 & 2 & 0 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & -1 & 5\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=\\begin{bmatrix}1 & -1 & 3 & 2 \\\\ 2 & 1 & 1 & -1 \\\\ 0 & 5 & 3 & -1 \\\\ 2 & -1 & -5 & 2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186269079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e18a6cd-6703-5f0c-a685-9c833241f8ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 & -3 & 2 \\\\ -7 & 4 & -6 & 1 \\\\ -3 & 4 & -2 & -6 \\\\ -6 & 4 & -5 & -1\\end{bmatrix}" :db/id #edb/ref 17592186266697} {:answer/id #uuid "45c0765f-fb53-5c2c-9588-c250e0731b7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 & 2 & -3 \\\\ -7 & 4 & 1 & -6 \\\\ -3 & 4 & -6 & -2 \\\\ -6 & 4 & -1 & -5\\end{bmatrix}" :db/id #edb/ref 17592186266768} {:answer/id #uuid "4d4a088b-38b7-52ab-94ad-44656eb3b687" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 4 & -2 & -6 \\\\ 0 & 2 & -3 & 2 \\\\ -7 & 4 & -6 & 1 \\\\ -6 & 4 & -5 & -1\\end{bmatrix}" :db/id #edb/ref 17592186266829} {:answer/id #uuid "b42f4bfe-0495-5eea-b633-80afa7f3d024" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 4 & -2 & -6 \\\\ -6 & 4 & -5 & -1 \\\\ -7 & 4 & -6 & 1 \\\\ 0 & 2 & -3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186267752} {:answer/id #uuid "d59d1aa2-82b5-56b1-a817-a8564c8d279a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 2 & -3 & 2 \\\\ -3 & 4 & -2 & -6 \\\\ -6 & 4 & -5 & -1 \\\\ -7 & 4 & -6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186268048}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 4 & -2 & -6 \\\\ 0 & 2 & -3 & 2 \\\\ -7 & 4 & -6 & 1 \\\\ -6 & 4 & -5 & -1\\end{bmatrix}" :db/id #edb/ref 17592186266829} :answer-field/id #uuid "2ca5b07c-f113-56d3-9008-b64d104aef74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268483}] :question/id #uuid "234a8423-670f-50ba-805a-7c8cd38a0ad7" :question/math-academy-id "q-135536" :question/problem "Consider the vectors ${v}_{1}$ and ${v}_{3}$ and the block diagonal matrix $B$ shown below, where both $2\\times 2$ blocks of $B$ represent rotation-scaling matrices:\n\n$$\n{v}_{1}=\\begin{bmatrix}-3+4\\text{i} \\\\ 2\\text{i} \\\\ -7+4\\text{i} \\\\ -6+4\\text{i}\\end{bmatrix},\\,{v}_{3}=\\begin{bmatrix}-2-6\\text{i} \\\\ -3+2\\text{i} \\\\ -6+\\text{i} \\\\ -5-\\text{i}\\end{bmatrix},\\,B=\\begin{bmatrix}3 & -7 & 0 & 0 \\\\ 7 & 3 & 0 & 0 \\\\ 0 & 0 & 2 & -4 \\\\ 0 & 0 & 4 & 2\\end{bmatrix}\n$$\n\nThe vectors ${v}_{1}$ and ${v}_{3}$ are the eigenvectors of a matrix $A$ corresponding to the eigenvalues ${\\lambda }_{1}=3-7\\text{i}$ and ${\\lambda }_{3}=2-4\\text{i},$ respectively. \nGiven that $A=PB{P}^{-1},$ which of the following could be the matrix $P?$" :question/worked-solution "Recall that if $A$ is a $4\\times 4$ real matrix that has complex eigenvalues \n\n$\\,$ ${\\lambda }_{1}={\\overset{―}{\\lambda }}_{2}\\,$ and $\\,{\\lambda }_{3}={\\overset{―}{\\lambda }}_{4}$ \n\nwith corresponding eigenvectors \n\n$\\,$ ${v}_{1}={\\overset{―}{v}}_{2}\\,$ and $\\,{v}_{3}={\\overset{―}{v}}_{4},$ \n\nthen $A=PB{P}^{-1},$ where\n\n$$\nB=\\begin{bmatrix}\\text{Re}({\\lambda }_{1}) & \\text{Im}({\\lambda }_{1}) & 0 & 0 \\\\ -\\text{Im}({\\lambda }_{1}) & \\text{Re}({\\lambda }_{1}) & 0 & 0 \\\\ 0 & 0 & \\text{Re}({\\lambda }_{3}) & \\text{Im}({\\lambda }_{3}) \\\\ 0 & 0 & -\\text{Im}({\\lambda }_{3}) & \\text{Re}({\\lambda }_{3})\\end{bmatrix}\n$$\n\nand\n\n$$\nP=\\begin{bmatrix}| & | & | & | \\\\ \\text{Re}({v}_{1}) & \\text{Im}({v}_{1}) & \\text{Re}({v}_{3}) & \\text{Im}({v}_{3}) \\\\ | & | & | & |\\end{bmatrix}.\n$$\n\nSwapping the blocks on the main diagonal of $B$ will result in switching the corresponding columns in $P.$\n\nFrom our block diagonal matrix\n\n$$\nB=\\begin{bmatrix}3 & -7 & 0 & 0 \\\\ 7 & 3 & 0 & 0 \\\\ 0 & 0 & 2 & -4 \\\\ 0 & 0 & 4 & 2\\end{bmatrix},\n$$\n\nwe deduce that the first and second columns of $P$ correspond to the complex eigenvector ${v}_{1},$ and the third and forth columns of $P$ correspond to the complex eigenvector ${v}_{3}.$ Therefore,\n\n$$\nP=\\begin{bmatrix}-3 & 4 & -2 & -6 \\\\ 0 & 2 & -3 & 2 \\\\ -7 & 4 & -6 & 1 \\\\ -6 & 4 & -5 & -1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186269080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f74e1b7-608b-52c3-a126-6431a8a49060" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ -2 & 5 & 4 & -7 \\\\ 4 & 2 & 1 & -2 \\\\ -4 & 3 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186266716} {:answer/id #uuid "4517f571-aeef-5aa8-aa64-17dbc03ef85c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & 2 & 0 \\\\ 3 & -4 & 3 & 1 \\\\ 2 & 4 & 1 & -2 \\\\ 5 & -2 & 4 & -7\\end{bmatrix}" :db/id #edb/ref 17592186266760} {:answer/id #uuid "687dcc62-5d5b-560d-bc4c-c49b6e8a1348" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 & 2 & 0 \\\\ 5 & -2 & 4 & -7 \\\\ 2 & 4 & 1 & -2 \\\\ 3 & -4 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186267072} {:answer/id #uuid "c0c540bb-c4e7-544b-adec-6d73170048d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -2 & -7 & 4 \\\\ 2 & 4 & -2 & 1 \\\\ -3 & 1 & 0 & 2 \\\\ 3 & -4 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186267866} {:answer/id #uuid "ea70bd41-1595-5628-9b4d-52a042c12081" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -2 & 4 & -7 \\\\ -3 & 1 & 2 & 0 \\\\ 3 & -4 & 3 & 1 \\\\ 2 & 4 & 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186268235}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix