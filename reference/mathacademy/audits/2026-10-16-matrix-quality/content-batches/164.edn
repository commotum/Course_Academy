\\ 1 \\\\ -3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{0\\cdot \\sqrt{2}+(-5)\\cdot 1+1\\cdot (-3)}{(\\sqrt{2})^{2}+{1}^{2}+(-3)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}0 \\\\ -5 \\\\ 1\\end{bmatrix}+\\frac{2}{3}\\begin{bmatrix}\\sqrt{2} \\\\ 1 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2\\sqrt{2}}{3} \\\\ -\\frac{13}{3} \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}\\sqrt{2} \\\\ 1 \\\\ -3\\end{bmatrix},\\begin{bmatrix}\\frac{2\\sqrt{2}}{3} \\\\ -\\frac{13}{3} \\\\ -1\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $b=-\\frac{13}{3},$ $c=-1,$ and  \n\n$$\n\\frac{c}{b}=\\frac{-1}{(-\\frac{13}{3})}=\\frac{3}{13}.\n$$"} {:db/id #edb/ref 17592186366125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68d3b6c3-78f1-5dc1-bd02-5e789b94126c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366127} {:answer/id #uuid "85fb58e0-2ba4-5671-87e5-f4ad5d5c3ce9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186366128} {:answer/id #uuid "4fae99ca-8bd2-52bd-a7a7-6fba7c6f223f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186366129} {:answer/id #uuid "b2a6b39d-7fbd-541d-9f3f-312f2e40d9ed" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366130} {:answer/id #uuid "92e46969-6a43-5755-bf11-d28076f4b84b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186366131}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366130} :answer-field/id #uuid "c32112d1-55af-51b9-b26a-46a43c734125" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366126}] :question/id #uuid "46c005f9-5702-59db-bd5c-741e079e67e9" :question/math-academy-id "q-41036" :question/problem "$$\nA=\\begin{bmatrix}2 & 4 \\\\ 0 & 4 \\\\ 2 & 4\\end{bmatrix},\\,B=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{a}{b}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{4\\cdot 2+4\\cdot 0+4\\cdot 2}{{2}^{2}+{0}^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 4 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 0 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix},\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=0,$ $b=4,$ and  \n\n$$\n\\frac{a}{b}=\\frac{0}{4}=0.\n$$"} {:db/id #edb/ref 17592186366379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a1f7f88-f4d6-55ab-96bb-e95b8529508e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186366381} {:answer/id #uuid "761d56bb-9090-5642-9a0c-e14547f22359" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186366382} {:answer/id #uuid "8c80468f-7fc8-5012-914f-f4ac6b573a98" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186366383} {:answer/id #uuid "3b1145a6-cf7a-5bfb-b5d9-39965f8e4d5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186366384} {:answer/id #uuid "e440fb99-3dab-5905-b79d-54b15b6644a8" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186366385}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186366381} :answer-field/id #uuid "a1b294cd-0690-5b2a-8b79-bfdfd5228580" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366380}] :question/id #uuid "fbde2955-a5db-5798-a76a-665975736935" :question/math-academy-id "q-81212" :question/problem "$$\nA=\\begin{bmatrix}-2 & 5 \\\\ 1 & 5 \\\\ 3 & 4\\end{bmatrix},\\,B=\\{\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{a}{b}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}5 \\\\ 5 \\\\ 4\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot (-2)+5\\cdot 1+4\\cdot 3}{(-2)^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}5 \\\\ 5 \\\\ 4\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ \\frac{9}{2} \\\\ \\frac{5}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}6 \\\\ \\frac{9}{2} \\\\ \\frac{5}{2}\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=6,$ $b=\\frac{9}{2},$ and  \n\n$$\n\\frac{a}{b}=\\frac{(6)}{(\\frac{9}{2})}=\\frac{4}{3}.\n$$"} {:db/id #edb/ref 17592186366525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f024086-bc4f-50c7-879f-d67d9826ebee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186366527} {:answer/id #uuid "d74a082c-4c0c-540e-87e1-35c8ac407170" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186366528} {:answer/id #uuid "070992ba-70a6-5d23-b7bf-86ba4b7d94b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186366529} {:answer/id #uuid "fbc5ae26-bf75-52b0-af4a-500d0d179614" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186366530} {:answer/id #uuid "37a5b36d-fa96-5ae6-b6ae-d154f060c774" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186366531}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186366531} :answer-field/id #uuid "48dad23b-c580-5561-a75c-a5c73aafe50d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366526}] :question/id #uuid "6dd16f7a-f327-54ce-81b8-5d78600e9324" :question/math-academy-id "q-86851" :question/problem "$$\nA=\\begin{bmatrix}1 & 2 \\\\ 2 & 1 \\\\ -1 & 2\\end{bmatrix},\\,B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{a}{b}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$ \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+1\\cdot 2+2\\cdot (-1)}{{1}^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 2\\end{bmatrix}-\\frac{1}{3}\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}\\frac{5}{3} \\\\ \\frac{1}{3} \\\\ \\frac{7}{3}\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{5}{3},$ $b=\\frac{1}{3},$ and  \n\n$$\n\\frac{a}{b}=\\frac{(\\frac{5}{3})}{(\\frac{1}{3})}=5.\n$$"} {:db/id #edb/ref 17592186414752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60d1356a-94ea-5209-96d5-9d9418453443" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186414730} {:answer/id #uuid "7ea97cd7-7fc3-5a3d-bc31-abc4a8a14911" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186414734} {:answer/id #uuid "7edf9628-a06c-547d-b79b-2b8c3b2e00b4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186414735} {:answer/id #uuid "a319ab1d-aad5-5d1b-8415-3377cf75bf86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186414739} {:answer/id #uuid "d937650c-2bf8-5168-848d-23a4e1590bfc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186414743}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186414735} :answer-field/id #uuid "546f2176-ce65-54a2-a805-2b4a861a5018" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414747}] :question/id #uuid "9ea317f2-12b0-537c-bfd8-c2c151d6c85b" :question/math-academy-id "q-86849" :question/problem "$$\nA=\\begin{bmatrix}-2 & -3 \\\\ 1 & 2 \\\\ 2 & 5\\end{bmatrix},\\,B=\\{\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an orthogonal basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $\\frac{b}{a}?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 5\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot (-2)+2\\cdot 1+5\\cdot 2}{(-2)^{2}+{1}^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 5\\end{bmatrix}-\\begin{bmatrix}-4 \\\\ 2 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\\}$ is an orthogonal basis for $\\text{Col}(A).$\n\nFinally, $a=1,$ $b=0,$ and  \n\n$$\n\\frac{b}{a}=\\frac{0}{1}=0.\n$$"}] :knowledge-point/title "Finding an Orthogonal Basis For the Column Space of a Matrix"} {:db/id #edb/ref 17592186133795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133604 :question/id #uuid "60dbc829-01fc-5283-8741-68af483d5313" :question/math-academy-id "e-5583" :question/problem "Consider the subspace $V$ and an **orthonormal** basis $\\mathcal B$ of $V,$ given below. Given that $\\mathcal B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$\n'\n![](images/3a/3ae8f3b146aea78019b441917a80b2da118044c207cbf42c4b9fe2b51c3920d2.svg)" :question/worked-solution "First, let's denote\n\n![](images/f0/f04136fae84ebaf8ac272b48ae3d6fda95c26df1a4c3c1c800d261ab8acf0821.svg)\n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n- **Step 1**: We set ![](images/7e/7e7c38a548b58edae501a2f881bb9feb0553eb9ae51a9de96726233a9ce0543b.svg)\n\n- **Step 2**: Next, we find $\\mathbf{v}_2$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for $\\mathbf v_2$ in our case gives\n\n$$\n\\begin{aligned} & ={a}_{2}-\\frac{6\\cdot 2+0\\cdot 2+3\\cdot (-1)}{{2}^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}6 \\\\ 0 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -2 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ![](images/c2/c2e0f7b0e96c4d945bbf80d262b68366db85df52a754410d39602f4ba37fc4d4.svg)\n\n- ![](images/8c/8c16a541393a8060313140e677fc1e9347b7145c505f7ddb5bdae2111f68e216.svg)\n\nTherefore, ![](images/06/06d515f38454768bd2ec372b917828bbb7a99ee07ea5aa4745a10e5ff1ecdfcf.svg) is an orthonormal basis for $V.$\n\nFinally, $a=\\dfrac{2}{3},$ $b=-\\dfrac1  3,$ $c=\\dfrac{2}{3},$ and  \n\n$$\n|a|+|b|+|c| = \\left| \\dfrac{2}{3} \\right| + \\left|-\\dfrac{1}{3}\\right| + \\left| \\dfrac{2}{3} \\right| = \\dfrac 5 3.\n$$"} :knowledge-point/id #uuid "ccdefb8e-1bb5-52e9-812d-d2a5bffff731" :knowledge-point/questions [{:db/id #edb/ref 17592186134310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "666bb4ea-4b60-5d56-8433-a5bddadd4c14" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186324825} {:answer/id #uuid "86458e96-03dd-577f-9d42-779768608ee4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186325111} {:answer/id #uuid "a169b67a-c0c4-5999-b866-b09a3f19d557" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325340} {:answer/id #uuid "a33a73c3-d148-5248-9684-dc147838d546" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186325357} {:answer/id #uuid "eed8102d-4f54-5a30-9a66-7c5e85c93203" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186326079}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186326079} :answer-field/id #uuid "b17534d5-42e8-5c3f-8bb6-0d2e1eedf4c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326540}] :question/id #uuid "84b52cd1-ef6d-51a0-aeac-25f2437c64c6" :question/math-academy-id "q-40739" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{1\\cdot 1+2\\cdot 1+(-3)\\cdot (-1)}{{1}^{2}+{1}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}-2\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}}\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{0}^{2}+(-1)^{2}}}\\begin{bmatrix}-1 \\\\ 0 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix},\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=-\\frac{\\sqrt{2}}{2},$ $b=0,$ $c=\\frac{\\sqrt{2}}{2}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{\\sqrt{2}}{2}|+|\\,0\\,|+|\\frac{\\sqrt{2}}{2}|=\\sqrt{2}.\n$$"} {:db/id #edb/ref 17592186134311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012fe31e-f759-58b8-9e32-2deea745562c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186414720} {:answer/id #uuid "5a5c8c62-d50c-5ae9-8f35-24b24fc3d1ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186414728} {:answer/id #uuid "632c6ed4-e8c2-5396-8c74-4461b4fdfa46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186414731} {:answer/id #uuid "862d3a52-49ed-5b27-bb35-bc67945b8d32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186414736} {:answer/id #uuid "94c4a1bf-b64c-5ddd-8ca9-6c65c5b9727e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186414737}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186414731} :answer-field/id #uuid "4a66add1-170c-5173-8823-07f893271a27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414746}] :question/id #uuid "1ad7f9ba-9786-5d27-9e6a-080a7315cce4" :question/math-academy-id "q-40740" :question/problem "$$\nA=\\begin{bmatrix}-1 & 3 \\\\ -2 & 0 \\\\ 2 & -3\\end{bmatrix},\\,B={{u}_{1},{u}_{2}}={\\begin{bmatrix}-\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-1 \\\\ -2 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 0 \\\\ -3\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ -2 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{3\\cdot (-1)+0\\cdot (-2)+(-3)\\cdot 2}{{1}^{2}+(-2)^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ -2 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+(-2)^{2}+{2}^{2}}}\\begin{bmatrix}-1 \\\\ -2 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{2}^{2}+(-2)^{2}+(-1)^{2}}}\\begin{bmatrix}2 \\\\ -2 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ -\\frac{1}{3}\\end{bmatrix}.$\n\nTherefore, $B={{u}_{1},{u}_{2}}={\\begin{bmatrix}-\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix},\\begin{bmatrix}\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ -\\frac{1}{3}\\end{bmatrix}}$ is an orthonormal basis for $\\text{Col}(A).$\n\nFinally, $a=\\frac{2}{3},$ $b=-\\frac{2}{3},$ $c=-\\frac{1}{3}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{2}{3}|+|-\\frac{2}{3}|+|-\\frac{1}{3}|=\\frac{5}{3}.\n$$"} {:db/id #edb/ref 17592186272129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268ee3f5-ff62-526c-bf07-b0aae6059055" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186269608} {:answer/id #uuid "a4e320c7-d04c-5cac-8eca-b6a622015283" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{6}" :db/id #edb/ref 17592186270744} {:answer/id #uuid "a762e70a-2bf7-5828-83b6-2879ecead2de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186270767} {:answer/id #uuid "e23a2964-03f4-55d3-83a8-a9094a21cbd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186271257} {:answer/id #uuid "e42fb063-1a4d-51c6-9072-fbbe5660f809" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186271281}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186269608} :answer-field/id #uuid "2972b933-504c-5f0a-b4df-b81a8c22a6e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271587}] :question/id #uuid "3a029be5-b6a5-506a-8947-8d15614953ac" :question/math-academy-id "q-140537" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 1+2\\cdot 0+0\\cdot 1}{{1}^{2}+{0}^{2}+{1}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{2}^{2}+{(-1)}^{2}}}\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix},\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6}\\end{bmatrix}\\}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{6}}{6},$ $b=\\frac{\\sqrt{6}}{3},$ $c=-\\frac{\\sqrt{6}}{6}$ and   \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{6}}{6}|+|\\,\\frac{\\sqrt{6}}{3}\\,|+|-\\frac{\\sqrt{6}}{6}|=\\frac{2\\sqrt{6}}{3}.\n$$"} {:db/id #edb/ref 17592186272130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0be9bb-0dd7-5727-a685-7067529f3b9f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186269405} {:answer/id #uuid "0fc8fc9a-3735-5af4-ab4b-7a0b06f36be6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186269410} {:answer/id #uuid "14837d79-0685-5b2f-b7ae-de1bb6acd6e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186269449} {:answer/id #uuid "22a41e2d-2e61-5f3e-9b7c-55de1bb113c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186269569} {:answer/id #uuid "a51a7384-da8d-59ed-9c61-4348968fe7f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186270746}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186269410} :answer-field/id #uuid "fa412d3d-18c8-523e-8f62-f8bca8e7c4b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271942}] :question/id #uuid "2e6d1632-87e6-54dd-a8f9-23d096c3bcc7" :question/math-academy-id "q-140539" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 3 \\\\ -3\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}\\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 3 \\\\ -3\\end{bmatrix}.$  \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}.$  \n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{0\\cdot 2+3\\cdot (-1)+(-3)\\cdot 1}{{2}^{2}+(-1)^{2}+{1}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}0 \\\\ 3 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 2 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}}\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{6}}{3} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{2}^{2}+{2}^{2}+(-2)^{2}}}\\begin{bmatrix}2 \\\\ 2 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{6}\\end{bmatrix},\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3}\\end{bmatrix}\\}$ is an  orthonormal basis of $V.$   \n\nFinally, $a=\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=-\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|+|-\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186326874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18614843-53b5-5af0-b228-36c44c24c90d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186324183} {:answer/id #uuid "1d219cdb-66db-5669-87c6-a207fcc3a1f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186324216} {:answer/id #uuid "4ac27b02-75a3-57e4-bb6d-c8d6b1bc2cf1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186324577} {:answer/id #uuid "5fca2e57-483c-5d7c-8d41-b3a55edeffbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186324771} {:answer/id #uuid "c56558d4-a506-50db-8943-d35da70e291a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186325673}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186324216} :answer-field/id #uuid "a3be7ad6-26c9-556b-b096-8959f855c4f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326513}] :question/id #uuid "2ffd5b6e-c9be-5714-a520-bbfc949845de" :question/math-academy-id "q-40743" :question/problem "$$\nA=\\begin{bmatrix}1 & -3 \\\\ -1 & 3 \\\\ 2 & -3\\end{bmatrix},\\,B={{u}_{1},{u}_{2}}={\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ 3 \\\\ -3\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot 1+3\\cdot (-1)+(-3)\\cdot 2}{{1}^{2}+(-1)^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-3 \\\\ 3 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}2 \\\\ -2 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{1}^{2}+(-1)^{2}+{2}^{2}}}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{1}^{2}}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{bmatrix}.$\n\nTherefore, $B={{v}_{1},{v}_{2}}={\\begin{bmatrix}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3}\\end{bmatrix},\\begin{bmatrix}-\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{bmatrix}}$ is an orthonormal basis for $\\text{Col}(A).$\n\nFinally, $a=-\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186351265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f0253b-1dab-5d9b-aaa4-a0f6e33907b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186348953} {:answer/id #uuid "7da4cb52-1ecd-56c5-b36e-4a4b8b357eb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{41}}{41}" :db/id #edb/ref 17592186349597} {:answer/id #uuid "c58cf034-d19c-5859-ab44-e2c5de7c5c67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{41}}{41}" :db/id #edb/ref 17592186350190} {:answer/id #uuid "d1d4c644-3f20-550e-88cf-339c436ad7b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{41}}{41}" :db/id #edb/ref 17592186350289} {:answer/id #uuid "e1b9fcf1-cbdc-56f8-acf3-51e37fcfb3ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{41}}{41}" :db/id #edb/ref 17592186350432}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{41}}{41}" :db/id #edb/ref 17592186348953} :answer-field/id #uuid "988f703f-a2a5-5ea3-a946-97f106e096b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350968}] :question/id #uuid "7227055f-a157-5b07-9750-9fc3718cf77c" :question/math-academy-id "q-81216" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}4 \\\\ 0 \\\\ 3\\end{bmatrix},\\begin{bmatrix}5 \\\\ -4 \\\\ 10\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}5 \\\\ -4 \\\\ 10\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{5\\cdot 4+(-4)\\cdot 0+10\\cdot 3}{{4}^{2}+{0}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}5 \\\\ -4 \\\\ 10\\end{bmatrix}-2\\begin{bmatrix}4 \\\\ 0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ -4 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{4}^{2}+{0}^{2}+{3}^{2}}}\\begin{bmatrix}4 \\\\ 0 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-3)^{2}+(-4)^{2}+{4}^{2}}}\\begin{bmatrix}-3 \\\\ -4 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{4}{5} \\\\ 0 \\\\ \\frac{3}{5}\\end{bmatrix},\\begin{bmatrix}-\\frac{3\\sqrt{41}}{41} \\\\ -\\frac{4\\sqrt{41}}{41} \\\\ \\frac{4\\sqrt{41}}{41}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=-\\frac{3\\sqrt{41}}{41},$ $b=-\\frac{4\\sqrt{41}}{41},$ $c=\\frac{4\\sqrt{41}}{41}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{3\\sqrt{41}}{41}|+|-\\frac{4\\sqrt{41}}{41}|+|\\frac{4\\sqrt{41}}{41}|=\\frac{11\\sqrt{41}}{41}.\n$$"} {:db/id #edb/ref 17592186354526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "670187cb-2fe0-51db-969e-737152c95412" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186352479} {:answer/id #uuid "98365ad9-dec1-5da4-82dc-2689174ee916" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186352876} {:answer/id #uuid "ae0603d6-42f1-5fae-9851-950afc52e0b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186353041} {:answer/id #uuid "c3473de6-e778-5462-bdaf-e07e512b9f0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}" :db/id #edb/ref 17592186353256} {:answer/id #uuid "d924d0f1-1293-5054-8a88-0fb57be38c3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186353454}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186353041} :answer-field/id #uuid "e9848a7e-0635-5dc1-a29b-1065de8cf27f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354214}] :question/id #uuid "dfa73306-0d2d-5aa8-89e7-e48bb1792f48" :question/math-academy-id "q-86854" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}-3 \\\\ 2 \\\\ -1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 0 \\\\ 5\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}-\\frac{3\\sqrt{14}}{14} \\\\ \\frac{\\sqrt{14}}{7} \\\\ -\\frac{\\sqrt{14}}{14}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-3 \\\\ 2 \\\\ -1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 0 \\\\ 5\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-3 \\\\ 2 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{3\\cdot (-3)+0\\cdot 2+5\\cdot (-1)}{(-3)^{2}+{2}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 5\\end{bmatrix}+\\begin{bmatrix}-3 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 2 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-3)^{2}+{2}^{2}+(-1)^{2}}}\\begin{bmatrix}-3 \\\\ 2 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{-3\\sqrt{14}}{14} \\\\ \\frac{\\sqrt{14}}{7} \\\\ -\\frac{\\sqrt{14}}{14}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{0}^{2}+{2}^{2}+{4}^{2}}}\\begin{bmatrix}0 \\\\ 2 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}0 \\\\ \\frac{\\sqrt{5}}{5} \\\\ \\frac{2\\sqrt{5}}{5}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{-3\\sqrt{14}}{14} \\\\ \\frac{\\sqrt{14}}{7} \\\\ -\\frac{\\sqrt{14}}{14}\\end{bmatrix},\\begin{bmatrix}0 \\\\ \\frac{\\sqrt{5}}{5} \\\\ \\frac{2\\sqrt{5}}{5}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=0,$ $b=\\frac{\\sqrt{5}}{5},$ $c=\\frac{2\\sqrt{5}}{5}$ and  \n\n$$\n|a|+|b|+|c|=|\\,0\\,|+|\\frac{\\sqrt{5}}{5}|+|\\frac{2\\sqrt{5}}{5}|=\\frac{3\\sqrt{5}}{5}.\n$$"} {:db/id #edb/ref 17592186354527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa64e7c-d525-554c-8f34-196d08f28c85" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186351661} {:answer/id #uuid "86879b5d-ac8a-548d-93eb-a42aad4f9dc1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186352738} {:answer/id #uuid "b24c9e26-e070-5f2e-bd0a-a22ad5330a92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186353090} {:answer/id #uuid "c94934f9-5ed7-5a1a-afc2-6dd9055612d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186353321} {:answer/id #uuid "d4c874f6-ec68-5090-b8ce-7a8896d24797" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186353412}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186351661} :answer-field/id #uuid "e0182aa3-5e50-5ae2-8556-c323a3e5b585" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354199}] :question/id #uuid "ab8ba96e-a444-5139-b50d-ae295e519e61" :question/math-academy-id "q-86858" :question/problem "$$\nV=\\text{Span}{\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix}},\\,B={\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{4\\cdot (-1)+(-2)\\cdot 1+1\\cdot (0)}{(-1)^{2}+{1}^{2}+{0}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix}+3\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{0}^{2}}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{1}^{2}+{1}^{2}}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{bmatrix}.$\n\nTherefore, $B={{u}_{1},{u}_{2}}={\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix},\\begin{bmatrix}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{bmatrix}}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{\\sqrt{3}}{3},$ $b=\\frac{\\sqrt{3}}{3},$ $c=\\frac{\\sqrt{3}}{3}$ and  \n\n$$\n|a|+|b|+|c|=|\\,\\frac{\\sqrt{3}}{3}\\,|+|\\frac{\\sqrt{3}}{3}|+|\\frac{\\sqrt{3}}{3}|=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186366118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5e4e6b-279d-5b72-9f4d-3fba0018faa8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186366120} {:answer/id #uuid "6f7c8ab6-a501-5b46-8850-8d6264681e04" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366121} {:answer/id #uuid "a0e053a2-07c5-5245-8eae-a77ccb16799a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186366122} {:answer/id #uuid "e0ad4476-90b2-56e8-ae3c-6cfbde2e981e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366123} {:answer/id #uuid "db5506c3-46ff-5e8a-a19c-64367520311a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186366124}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186366124} :answer-field/id #uuid "88d62aee-8dd5-5aa9-8028-53575d48c630" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366119}] :question/id #uuid "dbf56628-94da-5878-ab0e-12187baa0d83" :question/math-academy-id "q-40745" :question/problem "$$\nA=\\begin{bmatrix}4 & 3 \\\\ 0 & 2 \\\\ 2 & 4\\end{bmatrix},\\,B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{2\\sqrt{5}}{5} \\\\ 0 \\\\ \\frac{\\sqrt{5}}{5}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $\\text{Col}(A)$ and an **orthonormal** basis $B$ of $\\text{Col}(A),$ where $A$ and $B$ are given above. Given that $B$ is derived from $\\text{Col}(A)$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "Recall that $\\text{Col}(A)$ is the span of the columns of $A.$  \n\nFirst, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}3 \\\\ 2 \\\\ 4\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{3\\cdot 4+2\\cdot 0+4\\cdot 2}{{4}^{2}+{0}^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis.\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{4}^{2}+{0}^{2}+{2}^{2}}}\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}\\frac{2\\sqrt{5}}{5} \\\\ 0 \\\\ \\frac{\\sqrt{5}}{5}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}}}\\begin{bmatrix}-1 \\\\ 2 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}\\frac{2\\sqrt{5}}{5} \\\\ 0 \\\\ \\frac{\\sqrt{5}}{5}\\end{bmatrix},\\begin{bmatrix}-\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}\\}$ is an orthonormal basis for $\\text{Col}(A).$\n\nFinally, $a=-\\frac{1}{3},$ $b=\\frac{2}{3},$ $c=\\frac{2}{3}$ and  \n\n$$\n|a|+|b|+|c|=|-\\frac{1}{3}|+|\\frac{2}{3}|+|\\frac{2}{3}|=\\frac{5}{3}.\n$$"} {:db/id #edb/ref 17592186366386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e68ae2-6f20-5f22-9e11-7854555f74fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{11}}{11}" :db/id #edb/ref 17592186366388} {:answer/id #uuid "c1a11db1-bae2-52e7-811d-20ef1fad8346" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{11}" :db/id #edb/ref 17592186366389} {:answer/id #uuid "de669c8e-e811-5a2b-9b66-1c36f490d3b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{11}}{11}" :db/id #edb/ref 17592186366390} {:answer/id #uuid "c1d4b876-b26a-5733-a2f4-643f5becd337" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{11}}{11}" :db/id #edb/ref 17592186366391} {:answer/id #uuid "d1b24c44-7f6c-58d5-9683-7ddab49f66ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{11}}{11}" :db/id #edb/ref 17592186366392}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{11}}{11}" :db/id #edb/ref 17592186366391} :answer-field/id #uuid "80455565-0f85-5273-bf0d-80a5895b80d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366387}] :question/id #uuid "53c1ecb7-2754-5e47-8ad1-b58baa6eef4e" :question/math-academy-id "q-81217" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}-4 \\\\ 1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 2 \\\\ 4\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}-\\frac{2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-4 \\\\ 1 \\\\ 1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 4\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-4 \\\\ 1 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-3)\\cdot (-4)+2\\cdot 1+4\\cdot 1}{(-4)^{2}+{1}^{2}+{1}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}-4 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-4)^{2}+{1}^{2}+{1}^{2}}}\\begin{bmatrix}-4 \\\\ 1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-\\frac{2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{1}^{2}+{1}^{2}+{3}^{2}}}\\begin{bmatrix}1 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{-2\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{2}}{6} \\\\ \\frac{\\sqrt{2}}{6}\\end{bmatrix},\\begin{bmatrix}\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{\\sqrt{11}}{11},$ $b=\\frac{\\sqrt{11}}{11},$ $c=\\frac{3\\sqrt{11}}{11}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{\\sqrt{11}}{11}|+|\\frac{\\sqrt{11}}{11}|+|\\frac{3\\sqrt{11}}{11}|=\\frac{5\\sqrt{11}}{11}.\n$$"} {:db/id #edb/ref 17592186414750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72cc1442-df79-5623-bff4-42eedddafdb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{5}" :db/id #edb/ref 17592186414732} {:answer/id #uuid "77e7d035-74cb-5a21-8a35-1b0d4898e245" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186414733} {:answer/id #uuid "9aa54ac6-f50b-5137-953c-f00902b1d420" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{10}" :db/id #edb/ref 17592186414738} {:answer/id #uuid "be937ae3-0668-5fe5-9548-61b224487acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{5}" :db/id #edb/ref 17592186414741} {:answer/id #uuid "c38c74ea-a21b-5c0e-bb44-84641a158c8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186414742}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{5}" :db/id #edb/ref 17592186414732} :answer-field/id #uuid "969beab5-314b-57a6-99da-182f476a0e29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414749}] :question/id #uuid "0934e8ac-174d-5792-a7fc-4ab5bbca2aae" :question/math-academy-id "q-41971" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot 2+4\\cdot 1+2\\cdot 3}{{2}^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis.\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{{2}^{2}+{1}^{2}+{3}^{2}}}\\begin{bmatrix}2 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}}\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ \\frac{3\\sqrt{10}}{10} \\\\ -\\frac{\\sqrt{10}}{10}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{\\sqrt{14}}{7} \\\\ \\frac{\\sqrt{14}}{14} \\\\ \\frac{3\\sqrt{14}}{14}\\end{bmatrix},\\begin{bmatrix}0 \\\\ \\frac{3\\sqrt{10}}{10} \\\\ -\\frac{\\sqrt{10}}{10}\\end{bmatrix}\\}$ is an orthonormal basis for $V.$\n\nFinally, $a=0,$ $b=\\frac{3\\sqrt{10}}{10},$ $c=-\\frac{\\sqrt{10}}{10}$ and  \n\n$$\n|a|+|b|+|c|=|\\,0\\,|+|\\frac{3\\sqrt{10}}{10}|+|-\\frac{\\sqrt{10}}{10}|=\\frac{2\\sqrt{10}}{5}.\n$$"} {:db/id #edb/ref 17592186481433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f1f7ef1-8ffa-5d79-89f5-0f699ae92a81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{46}}{23}" :db/id #edb/ref 17592186480979} {:answer/id #uuid "85a5f849-bfe1-54f4-a472-2f3b1a9f7def" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{46}" :db/id #edb/ref 17592186480996} {:answer/id #uuid "a891591d-a9eb-53fe-8982-96c9b063fffc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{23}" :db/id #edb/ref 17592186481058} {:answer/id #uuid "b8569b62-9dc0-5a84-afdd-7c7913cb7cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{46}}{46}" :db/id #edb/ref 17592186481091} {:answer/id #uuid "c2214cfa-1da7-5079-9e10-7f06971759ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{46}}{23}" :db/id #edb/ref 17592186481110}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{46}}{23}" :db/id #edb/ref 17592186481058} :answer-field/id #uuid "7d04279b-ec75-5254-bd55-34cd8f8839e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481281}] :question/id #uuid "ed119e3d-d405-5ea0-ae9c-40defc91b776" :question/math-academy-id "q-86852" :question/problem "$$\nV=\\text{Span}\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix},\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}\\},\\,B=\\{\\begin{bmatrix}-\\frac{\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix},\\begin{bmatrix}a \\\\ b \\\\ c\\end{bmatrix}\\}\n$$\n\nConsider the subspace $V$ and an **orthonormal** basis $B$ of $V,$ given above. Given that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $|a|+|b|+|c|?$" :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot (-1)+7\\cdot 1+2\\cdot 3}{(-1)^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{3}^{2}}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{3}^{2}+{6}^{2}+(-1)^{2}}}\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix},\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{3\\sqrt{46}}{46},$ $b=\\frac{3\\sqrt{46}}{23},$ $c=-\\frac{\\sqrt{46}}{46}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{3\\sqrt{46}}{46}|+|\\frac{3\\sqrt{46}}{23}|+|-\\frac{\\sqrt{46}}{46}|=\\frac{5\\sqrt{46}}{23}.\n$$"}] :knowledge-point/title "Finding an Orthonormal Basis of a Vector Space"}] :topic/math-academy-id 2127 :topic/title "The Gram-Schmidt Process for Two Vectors"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186162853} :activity/id #uuid "69449c6a-8620-5e1e-b816-29edb41bbcdc" :activity/steps [{:db/id #edb/ref 17592186162853 :step/content {:db/id #edb/ref 17592186163228 :tutorial/content "A quadratic form is said to be in its **canonical form** if it does not contain any cross-product terms ($x_i x_j$ where $i \\neq j$). \n\nWith that in mind, which of the following quadratic forms are given in their canonical forms?\n\nI. - $P(\\mathbf{x})=x_1^2-2x_2^2$\nII. - $Q(\\mathbf{x})=x_1^2+2x_1x_3+x_2^2$\n\nLet's examine our quadratic forms in turn.\n\n- $P(\\mathbf{x})$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $Q(\\mathbf{x})$ is *not* in canonical form since it contains the cross-product term $2x_1x_3.$\n\nIn terms of matrix representation \n\n$$\n\\mathbf{x}^T \\! A \\mathbf{x},\n$$\n\n we have a canonical form if the corresponding matrix $A$ is diagonal.\n\nFor example, which of the following quadratic forms are given in their canonical forms?\n\nI. - $R(\\mathbf{x})=\\mathbf{x}^T \\! A \\mathbf{x},$ where $\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}$\nII. - $S(\\mathbf{x})=\\mathbf{x}^T \\! A \\mathbf{x},$ where $\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}$\n\nExamining our quadratic forms, we obtain the following.\n\n- $R(\\mathbf{x})$ is in canonical form. Indeed, its corresponding matrix is diagonal.\n\n- $S(\\mathbf{x})$ is *not* in canonical form since its corresponding matrix is not diagonal." :tutorial/id #uuid "eb4d92c4-a9c0-52b7-8ba2-5603a1793519" :tutorial/math-academy-id 4886 :tutorial/title "Introduction"} :step/id #uuid "77fc40e4-1db9-5330-8d0b-b8ab818086ba" :step/next {:db/id #edb/ref 17592186162878}} {:db/id #edb/ref 17592186162878 :step/content {:db/id #edb/ref 17592186161994 :knowledge-point/id #uuid "3dd14a52-8c49-563a-85b2-8d3e4a3f4cff"} :step/id #uuid "6f976c1c-69b2-5d2b-84cb-019e7c3e7973" :step/next {:db/id #edb/ref 17592186162879}} {:db/id #edb/ref 17592186162879 :step/content {:db/id #edb/ref 17592186163238 :tutorial/content "**Lagrange's method** can be used to reduce any quadratic form to a canonical form by completing the squares and applying changes of variables. \n\nTo see how it works, let's reduce \n\n$$\nQ(\\mathbf{x})=x_1^2 +5x_2^2 + 4x_1x_2-2x_1x_3-4x_2x_3\n$$\n\n to its canonical form. \n\nFirst, we group $x_1^2$-term with all cross-product terms that contain $x_1$ and complete the square inside the parentheses:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+5{x}_{2}^{2}+4{x}_{1}{x}_{2}-2{x}_{1}{x}_{3}-4{x}_{2}{x}_{3} \\\\  & =({x}_{1}^{2}+4{x}_{1}{x}_{2}-2{x}_{1}{x}_{3})-4{x}_{2}{x}_{3}+5{x}_{2}^{2} \\\\  & =({x}_{1}^{2}+2{x}_{1}(2{x}_{2}-{x}_{3}))-4{x}_{2}{x}_{3}+5{x}_{2}^{2} \\\\  & =({x}_{1}^{2}+2{x}_{1}(2{x}_{2}-{x}_{3})+(2{x}_{2}-{x}_{3})^{2}-(2{x}_{2}-{x}_{3})^{2})-4{x}_{2}{x}_{3}+5{x}_{2}^{2} \\\\  & =({x}_{1}+2{x}_{2}-{x}_{3})^{2}-(2{x}_{2}-{x}_{3})^{2}-4{x}_{2}{x}_{3}+5{x}_{2}^{2} \\\\  & =({x}_{1}+2{x}_{2}-{x}_{3})^{2}-4{x}_{2}^{2}+4{x}_{2}{x}_{3}-{x}_{3}^{2}-4{x}_{2}{x}_{3}+5{x}_{2}^{2} \\\\  & =({x}_{1}+2{x}_{2}-{x}_{3})^{2}+{x}_{2}^{2}-{x}_{3}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n$$\ny_1^2 + y_2^2 - y_3^2,\n$$\n\nwhere we performed the following substitution:\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}+2{x}_{2}-{x}_{3} \\\\ {y}_{2} &={x}_{2} \\\\ {y}_{3} &={x}_{3}\\end{aligned}\\right.\n$$" :tutorial/id #uuid "75c9cb0d-d266-5e4a-981a-8a2076d5ebd1" :tutorial/math-academy-id 4908 :tutorial/title "Lagrange's Method"} :step/id #uuid "5ab4fdd1-52f5-5834-bed7-ffb51695e154" :step/next {:db/id #edb/ref 17592186162880}} {:db/id #edb/ref 17592186162880 :step/content {:db/id #edb/ref 17592186161995 :knowledge-point/id #uuid "5c4037e5-607d-5cc4-9ce8-f7f1cd2c5aae"} :step/id #uuid "27df8a9b-ced6-593a-9ebc-148b55e5d75f" :step/next {:db/id #edb/ref 17592186162881}} {:db/id #edb/ref 17592186162881 :step/content {:db/id #edb/ref 17592186161996 :knowledge-point/id #uuid "13e5e149-54cd-528e-b50e-1cafecb7b77a"} :step/id #uuid "a5d8b812-d42b-5206-bc35-a5c7f63f33d9" :step/next {:db/id #edb/ref 17592186162944}} {:db/id #edb/ref 17592186162944 :step/content {:db/id #edb/ref 17592186163257 :tutorial/content "Consider the quadratic function\n\n$$\nQ(\\mathbf{x})=x_1^2-2x_2^2+2x_1x_2.\n$$\n\nUsing Lagrange's method, we can find its canonical form\n\n$$\ny_1^2 - 3y_2^2,\n$$\n\nwhere $y_1 = x_1+x_2$ and $y_2 = x_2.$\n\n**Watch out!** This is not the only possible canonical form! For example, substituting \n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1} \\\\ {z}_{2} &=\\sqrt{3}{y}_{2}\\end{aligned}\\right.\n$$\n\nwe obtain\n\n$$\nz_1^2-z_2^2,\n$$\n\nwhich is another canonical form of $Q(\\mathbf{x}).$ In conclusion, the canonical (diagonal) form is *not* unique. \n\nOn the other hand, among all the possibilities, there is one special canonical form. \n\nThe **normal form** of a quadratic function is a canonical form where all coefficients are either $1$ or $-1.$\n\nThe normal form is unique (up to the order of the terms) for each quadratic function." :tutorial/id #uuid "4eb1772f-26ef-593c-a41e-557729021159" :tutorial/math-academy-id 5097 :tutorial/title "Non-Uniqueness of a Canonical Form"} :step/id #uuid "4535658f-d77b-56e0-9fc3-cab26e75c8d2"}] :activity/title "Finding the Canonical Form of a Quadratic Form Using Lagrange's Method" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186162220}] :db/id #edb/ref 17592186050583 :topic/knowledge-points [{:db/id #edb/ref 17592186161994 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161786 :question/id #uuid "4aae1963-085e-5d98-a22e-5d475f709769" :question/math-academy-id "e-8184" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(\\mathbf{x})=x_1^2-2x_2x_3+x_3^2$\n\n- $Q(\\mathbf{x})=\\mathbf{x}^T \\! A \\mathbf{x},$ where ![](images/d0/d041c39fe285ee5fdbd8022b70a8043a4ff07cbeb1dae8c49905248df1b86d01.png)\n\n- $R(\\mathbf{x})=x_3^2-2x_1^2$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms ($x_i x_j$ where $i \\neq j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(\\mathbf{x})$ is *not* in canonical form since it contains the cross-product term $2x_2x_3.$\n\n- $Q(\\mathbf{x})$ is in canonical form. Indeed, its corresponding matrix is diagonal.\n\n- $R(\\mathbf{x})$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\nTherefore, the correct answer is \"$Q(\\mathbf{x})$ and $R(\\mathbf{x})$ only.\""} :knowledge-point/id #uuid "3dd14a52-8c49-563a-85b2-8d3e4a3f4cff" :knowledge-point/questions [{:db/id #edb/ref 17592186162606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdbd4b23-8815-543f-8a07-79284662ce71" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186160929} {:answer/id #uuid "fe7c4c67-7da4-5c56-9806-5a6dfb6d2765" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186160930} {:answer/id #uuid "24cd0afb-aa7f-5f55-96a0-00012f96ae53" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186160931} {:answer/id #uuid "339b42c4-289f-5918-b02a-1e0904167318" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$, $Q(x)$, and $R(x)$" :db/id #edb/ref 17592186160932} {:answer/id #uuid "5f790897-05be-53d4-9954-701c5d26814b" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ and $R(x)$ only" :db/id #edb/ref 17592186160933}] :answer-field/id #uuid "48084b42-5086-53b2-a1c4-140b8cfaca76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160928}] :question/id #uuid "59616eba-f06d-5d17-aa86-febe99434574" :question/math-academy-id "q-93837" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n1. $P(x) = x_{1}^{2} + x_{2}^{2} + 5x_{2}x_{3}$\n2. $Q(x) = x^{T}Ax$, where $A = \\begin{bmatrix}-5 & 0 \\\\ 0 & 0\\end{bmatrix}$\n3. $R(x) = x_{1}^{2} - x_{2}^{2} - x_{3}^{2}$"} {:db/id #edb/ref 17592186162619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ff7837b-32a2-516a-9de7-1c60a084e5f9" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186161007} {:answer/id #uuid "b8211877-06b6-514d-bba3-7a4291473385" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $R(x)$ only" :db/id #edb/ref 17592186161008} {:answer/id #uuid "3d7c7992-1312-57f8-ab83-25e3ec3a49bc" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186161009} {:answer/id #uuid "4c69a11c-26e6-565a-9281-d7623e719cef" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186161010} {:answer/id #uuid "54d3dcb2-a3ea-5b52-8e22-975b75adff02" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186161011}] :answer-field/id #uuid "8e83921d-54d3-5589-bc79-fbe44fb7d996" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161006}] :question/id #uuid "4fbb728c-f60d-5b68-b1de-98e61d91816d" :question/math-academy-id "q-94124" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n1. $P(x) = x_{1}^{2} - x_{2}^{2}$\n2. $Q(x) = x_{1}^{2} + x_{2}^{2} - x_{1}x_{2}$\n3. $R(x) = x^{T}Ax$, where $A = \\begin{bmatrix}2 & 0 \\\\ 1 & 2\\end{bmatrix}$"} {:db/id #edb/ref 17592186272178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d1041c0-1e07-534e-a8af-f987ab6ae8ae" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186270098} {:answer/id #uuid "8db3c23c-13b3-5d21-9cbd-797009185abe" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186270495} {:answer/id #uuid "a7771ed8-024d-504b-8ca2-38f0a6829019" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ and $R(x)$ only" :db/id #edb/ref 17592186270768} {:answer/id #uuid "c7961962-4584-5617-a71b-617381a2ed7c" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186271025} {:answer/id #uuid "dac20bbf-b435-518d-99bf-a8e25f2ac799" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186271185}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186271185} :answer-field/id #uuid "00d78b1e-6a9a-56b0-9113-0b670b1cab2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271506}] :question/id #uuid "2e5be30e-ffe3-5bee-a565-456ed9a428b6" :question/math-academy-id "q-140982" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(x)={x}_{1}^{2}+{x}_{2}^{2}$\n- $Q(x)=({x}_{1}+{x}_{2})^{2}$\n- $R(x)={x}^{T}\\,Ax,$ where $A=\\begin{bmatrix}0 & 1 \\\\ 2 & 0\\end{bmatrix}$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms (${x}_{i}{x}_{j}$ where $i\\ne j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(x)$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $Q(x)$ is *not* in canonical form since \n\n$$\nQ(x)=({x}_{1}+{x}_{2})^{2}={x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}.\n$$\n\n So,  it contains the cross-product term $2{x}_{1}{x}_{2}.$\n\n- $R(x)$ is *not* in canonical form since its corresponding matrix is not diagonal.\n\nTherefore, the correct answer is \"$P(x)$ only.\""} {:db/id #edb/ref 17592186357665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2048c8f8-e0e0-50b6-8709-e9913fce3cab" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186354936} {:answer/id #uuid "48ab8f02-5faf-525a-a626-5578f395e288" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186355308} {:answer/id #uuid "961b1b6c-8f92-57c1-bc6a-7bd6d90fa821" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ and $R(x)$ only" :db/id #edb/ref 17592186355985} {:answer/id #uuid "ab206c61-1dfe-529c-b882-c60863a56865" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186356181} {:answer/id #uuid "fb21d7ae-8d43-556a-add4-aa4a27a9d09d" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186356859}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186355308} :answer-field/id #uuid "5ebc8577-3dd7-5057-9349-962c12022bfe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357077}] :question/id #uuid "0604cc75-877c-5dad-860a-37dc93c82b84" :question/math-academy-id "q-94125" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(x)={x}_{1}^{2}-{x}_{2}^{2}+2{x}_{2}{x}_{3}$\n- $Q(x)={x}_{1}^{2}+{x}_{2}^{2}-{x}_{3}^{2}$\n- $R(x)={x}^{T}\\,Ax,$ where $A=\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms (${x}_{i}{x}_{j}$ where $i\\ne j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(x)$ is *not* in canonical form since it contains the cross-product term $2{x}_{2}{x}_{3}.$\n\n- $Q(x)$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $R(x)$ is *not* in canonical form since its corresponding matrix is *not* diagonal.\n\nTherefore, the correct answer is \"$Q(x)$ only.\""} {:db/id #edb/ref 17592186357666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acb7f32-9c8d-5640-ba9e-2d1c2b3f45b2" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ and $R(x)$ only" :db/id #edb/ref 17592186354899} {:answer/id #uuid "44a0d517-3261-52d4-b1f1-de23c8281887" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186355274} {:answer/id #uuid "76b1a3ed-c940-5560-85b0-83f25ba72fb8" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186355704} {:answer/id #uuid "b9bc872c-fd00-503b-9764-5f560d5c75d4" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186356292} {:answer/id #uuid "d8cb55ac-7ae1-5c0f-bfd0-40849074d54d" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $R(x)$ only" :db/id #edb/ref 17592186356565}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186355704} :answer-field/id #uuid "9968353b-13fe-5fd1-841a-0da44af4ebea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357191}] :question/id #uuid "d7c49159-2751-5ef3-b30b-908a739ce921" :question/math-academy-id "q-94127" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(x)={x}_{1}^{2}+{x}_{2}^{2}$\n- $Q(x)={x}^{T}\\,Ax,$ where $A=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$\n- $R(x)={x}_{1}^{2}-3{x}_{2}^{2}+{x}_{1}{x}_{3}$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms (${x}_{i}{x}_{j}$ where $i\\ne j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(x)$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $Q(x)$ is in canonical form. Indeed, its corresponding matrix is diagonal.\n\n- $R(x)$ is *not* in canonical form since it contains the cross-product term ${x}_{1}{x}_{3}.$\n\nTherefore, the correct answer is \"$P(x)$ and $Q(x)$ only.\""} {:db/id #edb/ref 17592186357667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76ccb8fd-2225-57c8-9e3c-94cd98e6244a" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186355706} {:answer/id #uuid "ad5269b8-ca47-52d9-9134-84d35e51cb78" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186356195} {:answer/id #uuid "bd51ff9c-2b38-5916-adcc-e230ed5253d1" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $R(x)$ only" :db/id #edb/ref 17592186356322} {:answer/id #uuid "d3d65dc1-5425-5b49-880d-0f1c395972e0" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186356514} {:answer/id #uuid "e20ca048-afd0-5883-819e-5839b226ad8c" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186356642}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186356514} :answer-field/id #uuid "1521ce6e-8f28-57f6-bde6-fd2e7a707eb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356954}] :question/id #uuid "152b442e-9393-5a3c-920b-c6b76a5962c4" :question/math-academy-id "q-94132" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(x)=3{x}_{1}^{2}+2{x}_{3}^{2}$\n- $Q(x)={x}^{T}\\,Ax,$ where $A=\\begin{bmatrix}1 & 3 \\\\ 0 & 5\\end{bmatrix}$\n- $R(x)=2{x}_{1}{x}_{2}+{x}_{2}^{2}+3{x}_{3}^{2}$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms (${x}_{i}{x}_{j}$ where $i\\ne j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(x)$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $Q(x)$ is *not* in canonical form since its corresponding matrix is not diagonal.\n\n- $R(x)$ is *not* in canonical form since it contains the cross-product term $2{x}_{1}{x}_{2}.$\n\nTherefore, the correct answer is \"$P(x)$ only.\""} {:db/id #edb/ref 17592186357669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "701182ec-2b30-5b94-9fa9-9482ff84188c" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ and $Q(x)$ only" :db/id #edb/ref 17592186355652} {:answer/id #uuid "adb37a93-0360-5db3-a07d-66538a3825cd" :answer/type {:db/ident :answer.type/text} :answer/value "$P(x)$ only" :db/id #edb/ref 17592186356197} {:answer/id #uuid "b03c9bdb-5c95-5aa2-90c8-670df36d1e86" :answer/type {:db/ident :answer.type/text} :answer/value "$R(x)$ only" :db/id #edb/ref 17592186356216} {:answer/id #uuid "cdc78d26-25c4-5aea-924b-a417dfbb7a0c" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ and $R(x)$ only" :db/id #edb/ref 17592186356465} {:answer/id #uuid "d76aa7b8-adcc-53d1-8cbd-643379171dd8" :answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186356548}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$Q(x)$ only" :db/id #edb/ref 17592186356548} :answer-field/id #uuid "fe778706-d299-5210-a43f-403343b4dbe5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357356}] :question/id #uuid "4c8cbd6e-89fd-5fdf-b91c-022259a55a79" :question/math-academy-id "q-94135" :question/problem "Which of the following quadratic forms are given in their canonical forms?\n\n- $P(x)={x}^{T}\\,Ax,$ where $A=\\begin{bmatrix}4 & 0 \\\\ -3 & 4\\end{bmatrix}$\n- $Q(x)={x}_{3}^{2}-5{x}_{2}^{2}-{x}_{1}^{2}$\n- $R(x)={x}_{1}{x}_{3}-3{x}_{2}^{2}+{x}_{3}^{2}$" :question/worked-solution "A quadratic form in its canonical form shouldn't contain any cross-product terms (${x}_{i}{x}_{j}$ where $i\\ne j$). In terms of its matrix representation, this means that the corresponding matrix is diagonal.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- $P(x)$ is *not* in canonical form since its corresponding matrix is not diagonal.\n\n- $Q(x)$ is in canonical form. Indeed, the form does not contain any cross-product terms (it contains only squares).\n\n- $R(x)$ is *not* in canonical form since it contains the cross-product term ${x}_{1}{x}_{3}.$\n\nTherefore, the correct answer is \"$Q(x)$ only.\""}] :knowledge-point/title "Identifying the Canonical Form of a Quadratic Form"} {:db/id #edb/ref 17592186161995 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161787 :question/id #uuid "e0b3629c-0f62-56ef-9e7e-f811958bf36d" :question/math-academy-id "e-8185" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(\\mathbf{x})=9x_1^2-18x_1x_2+5x_2^2$ to the canonical form given below. \n\n![](images/cc/cc77cb76fcab6bd72211e7e66d5fee5ba87c0ba1465571aa88baf26beb196a22.png)\n\nFrom left to right, what is missing from the blank spaces?" :question/worked-solution "We apply Lagrange's method as follows:\n\nFirst, we group $x_1^2$-term with all cross-product terms that contain $x_1$ and factor out the coefficient of $x_1^2\\mathbin{:}$\n\n$$\n\\begin{aligned}Q(x) & =9{x}_{1}^{2}-18{x}_{1}{x}_{2}+5{x}_{2}^{2} \\\\  & =(9{x}_{1}^{2}-18{x}_{1}{x}_{2})+5{x}_{2}^{2} \\\\  & =9({x}_{1}^{2}-2{x}_{1}{x}_{2})+5{x}_{2}^{2}\\end{aligned}\n$$\n\nNext, we complete the square inside the parentheses:\n\n$$\n\\begin{aligned}9({x}_{1}^{2}-2{x}_{1}{x}_{2})+5{x}_{2}^{2} & =9([{x}_{1}^{2}-2{x}_{1}{x}_{2}+{x}_{2}^{2}]-{x}_{2}^{2})+5{x}_{2}^{2} \\\\  & =9(({x}_{1}-{x}_{2})^{2}-{x}_{2}^{2})+5{x}_{2}^{2}\\end{aligned}\n$$\n\nThen, we simplify the expression:\n\n$$\n\\begin{aligned}9(({x}_{1}-{x}_{2})^{2}-{x}_{2}^{2})+5{x}_{2}^{2} & =9({x}_{1}-{x}_{2})^{2}-9{x}_{2}^{2}+5{x}_{2}^{2} \\\\  & =9({x}_{1}-{x}_{2})^{2}-4{x}_{2}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n![](images/e1/e1048614ed3dda333597bf32339f23a1585308e630233e3d11751c48c597ed52.png)\n\nTherefore, from left to right, the missing parts are as follows:\n\n$\\qquad$ $4 \\quad$ and $\\quad x_1-x_2 .$"} :knowledge-point/id #uuid "5c4037e5-607d-5cc4-9ce8-f7f1cd2c5aae" :knowledge-point/questions [{:db/id #edb/ref 17592186162607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f46c58e-63d2-51eb-97a1-bc02006a4284" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} - x_{2}$" :db/id #edb/ref 17592186160935} {:answer/id #uuid "b738e8c2-02bc-5e2b-93e4-6e8fd638c205" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186160936} {:answer/id #uuid "bb54de60-e5c1-5356-b28e-3110f44ca0a0" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $x_{1} - 2x_{2}$" :db/id #edb/ref 17592186160937} {:answer/id #uuid "44a507af-390e-540c-a968-f14b13f1f83b" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + x_{2}$" :db/id #edb/ref 17592186160938} {:answer/id #uuid "466be8ad-cfa1-52ee-ac6d-362b60d15abb" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186160939}] :answer-field/id #uuid "8ba7d30b-f7e8-562f-a571-a275da00a2bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160934} {:answer-field/choices [{:answer/id #uuid "5678c610-8c61-519a-ac89-a4ee573dbe85" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and ${x}_{1}-2{x}_{2}$" :db/id #edb/ref 17592186404601} {:answer/id #uuid "36171aeb-8b2d-55df-b514-cb0bb92c32d1" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186404602} {:answer/id #uuid "7ecc1296-5d76-5959-b316-cb317bc507ab" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and ${x}_{1}+2{x}_{2}$" :db/id #edb/ref 17592186404603} {:answer/id #uuid "b3a74df8-1742-5032-960e-2ec73e5f4a97" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}+2{x}_{2}$" :db/id #edb/ref 17592186404604} {:answer/id #uuid "31e9810b-6835-5b51-bb36-14e635b7db32" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186404605}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186404605} :answer-field/id #uuid "c651d92a-608f-50d0-a05c-565c2587225b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404600}] :question/id #uuid "ca11e17a-4464-5c54-bbb1-cb2d8dc175df" :question/math-academy-id "q-93838" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(x)=2{x}_{1}^{2}-4{x}_{1}{x}_{2}-{x}_{2}^{2}$ to the canonical form given below. \n\n$$\n2{y}_{1}^{2}-\\boxed{}\\,{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &=\\boxed{} \\\\ {y}_{2} &={x}_{2}\\end{aligned}\\right.\n$$\n\nFrom left to right, what is missing from the blank spaces?" :question/worked-solution "We apply Lagrange's method as follows:\n\nFirst, we group ${x}_{1}^{2}$-term with all cross-product terms that contain ${x}_{1}$ and factor out the coefficient of ${x}_{1}^{2}:$\n\n$$\n\\begin{aligned}Q(x) & =2{x}_{1}^{2}-4{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & =(2{x}_{1}^{2}-4{x}_{1}{x}_{2})-{x}_{2}^{2} \\\\  & =2({x}_{1}^{2}-2{x}_{1}{x}_{2})-{x}_{2}^{2}\\end{aligned}\n$$\n\nNext, we complete the square inside the parentheses:\n\n$$\n\\begin{aligned}2({x}_{1}^{2}-2{x}_{1}{x}_{2})-{x}_{2}^{2} & =2([{x}_{1}^{2}-2{x}_{1}{x}_{2}+{x}_{2}^{2}]-{x}_{2}^{2})-{x}_{2}^{2} \\\\  & =2(({x}_{1}-{x}_{2})^{2}-{x}_{2}^{2})-{x}_{2}^{2}\\end{aligned}\n$$\n\nThen, we simplify the expression:\n\n$$\n\\begin{aligned}2(({x}_{1}-{x}_{2})^{2}-{x}_{2}^{2})-{x}_{2}^{2} & =2({x}_{1}-{x}_{2})^{2}-2{x}_{2}^{2}-{x}_{2}^{2} \\\\  & =2({x}_{1}-{x}_{2})^{2}-3{x}_{2}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n$$\n2{y}_{1}^{2}-3{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}-{x}_{2} \\\\ {y}_{2} &={x}_{2}.\\end{aligned}\\right.\n$$\n\nTherefore, from left to right, the missing parts are as follows:\n\n$\\,$ $3\\,$ and $\\,{x}_{1}-{x}_{2}.$"} {:db/id #edb/ref 17592186162620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b707a638-f8ba-5379-80ae-80d18efc4ac7" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + 3x_{2}$" :db/id #edb/ref 17592186161013} {:answer/id #uuid "d316df5f-eb56-540a-90b2-a38e88608f3a" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and $x_{1} + x_{2}$" :db/id #edb/ref 17592186161014} {:answer/id #uuid "33338ce3-eac4-5358-ac52-9630cd86cd9e" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186161015} {:answer/id #uuid "527b2681-2d12-58c6-a1a8-faebae067e03" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} - 3x_{2}$" :db/id #edb/ref 17592186161016} {:answer/id #uuid "7e4ba19c-3574-561f-9b4c-19b852cb529a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $x_{1} - 2x_{2}$" :db/id #edb/ref 17592186161017}] :answer-field/id #uuid "1bcfe45b-dbad-5a1c-86a5-77078d6e137b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161012} {:answer-field/choices [{:answer/id #uuid "ec3eea05-f6ca-564c-b496-fb024c5f4587" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}-2{x}_{2}$" :db/id #edb/ref 17592186404646} {:answer/id #uuid "997dd8d7-befe-5b37-83f1-9e550c2fe9d2" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}+3{x}_{2}$" :db/id #edb/ref 17592186404647} {:answer/id #uuid "a4ea4660-5689-5633-baf9-2db1ccdf97aa" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186404648} {:answer/id #uuid "f309396b-3b68-5ee5-a15e-967c06c22f24" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}-3{x}_{2}$" :db/id #edb/ref 17592186404649} {:answer/id #uuid "7e199ab4-1f50-59db-85b7-b705dff16542" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}+2{x}_{2}$" :db/id #edb/ref 17592186404650}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$3$ and ${x}_{1}+3{x}_{2}$" :db/id #edb/ref 17592186404647} :answer-field/id #uuid "7feb31a0-5779-59d8-9a9b-c01511679c3d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404645}] :question/id #uuid "ca81ca2d-2a11-5281-bdfb-66b5a7ca3f2d" :question/math-academy-id "q-94142" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(x)=3{x}_{1}^{2}+29{x}_{2}^{2}+18{x}_{1}{x}_{2}$ to the canonical form given below. \n\n$$\n\\boxed{}\\,{y}_{1}^{2}+2{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &=\\boxed{} \\\\ {y}_{2} &={x}_{2}\\end{aligned}\\right.\n$$\n\nFrom left to right, what is missing from the blank spaces?" :question/worked-solution "We apply Lagrange's method as follows:\n\nFirst, we group ${x}_{1}^{2}$-term with all cross-product terms that contain ${x}_{1}$ and factor out the coefficient of ${x}_{1}^{2}:$\n\n$$\n\\begin{aligned}Q(x) & =3{x}_{1}^{2}+29{x}_{2}^{2}+18{x}_{1}{x}_{2} \\\\  & =(3{x}_{1}^{2}+18{x}_{1}{x}_{2})+29{x}_{2}^{2} \\\\  & =3({x}_{1}^{2}+6{x}_{1}{x}_{2})+29{x}_{2}^{2}\\end{aligned}\n$$\n\nNext, we complete the square inside the parentheses:\n\n$$\n\\begin{aligned}3({x}_{1}^{2}+6{x}_{1}{x}_{2})+29{x}_{2}^{2} & =3([{x}_{1}^{2}+6{x}_{1}{x}_{2}+9{x}_{2}^{2}]-9{x}_{2}^{2})+29{x}_{2}^{2} \\\\  & =3(({x}_{1}+3{x}_{2})^{2}-9{x}_{2}^{2})+29{x}_{2}^{2}\\end{aligned}\n$$\n\nThen, we simplify the expression:\n\n$$\n\\begin{aligned}3(({x}_{1}+3{x}_{2})^{2}-9{x}_{2}^{2})+29{x}_{2}^{2} & =3({x}_{1}+3{x}_{2})^{2}-27{x}_{2}^{2}+29{x}_{2}^{2} \\\\  & =3({x}_{1}+3{x}_{2})^{2}+2{x}_{2}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n$$\n3{y}_{1}^{2}+2{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}+3{x}_{2} \\\\ {y}_{2} &={x}_{2}.\\end{aligned}\\right.\n$$\n\nTherefore, from left to right, the missing parts are as follows:\n\n$\\,$ $3\\,$ and $\\,{x}_{1}+3{x}_{2}.$"} {:db/id #edb/ref 17592186357670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d537c6e-fb64-5187-b91e-99e8c9a4302e" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}-2{x}_{2}$" :db/id #edb/ref 17592186355053} {:answer/id #uuid "437d0bf4-d6f3-5fed-b0b3-ae62d5ad2f95" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186355267} {:answer/id #uuid "4c493566-bed1-59f9-9037-5404c8a3a8bd" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186355344} {:answer/id #uuid "9e43d2fd-39ba-5a70-9261-836ab8074984" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186356075} {:answer/id #uuid "a0d92439-5310-5294-88dc-d8e536e47367" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186356092}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$4$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186355344} :answer-field/id #uuid "a499571f-d175-553b-a0b7-c8e2c935dd51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357218}] :question/id #uuid "4f439f0c-3a24-5a5b-8a33-a028f668c7f7" :question/math-academy-id "q-94138" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(x)=4{x}_{1}^{2}+8{x}_{1}{x}_{2}-{x}_{2}^{2}$ to the canonical form given below. \n\n$$\n\\boxed{}\\,{y}_{1}^{2}-5{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &=\\boxed{} \\\\ {y}_{2} &={x}_{2}\\end{aligned}\\right.\n$$\n\nFrom left to right, what is missing from the blank spaces?" :question/worked-solution "We apply Lagrange's method as follows:\n\nFirst, we group ${x}_{1}^{2}$-term with all cross-product terms that contain ${x}_{1}$ and factor out the coefficient of ${x}_{1}^{2}:$\n\n$$\n\\begin{aligned}Q(x) & =4{x}_{1}^{2}+8{x}_{1}{x}_{2}-{x}_{2}^{2} \\\\  & =(4{x}_{1}^{2}+8{x}_{1}{x}_{2})-{x}_{2}^{2} \\\\  & =4({x}_{1}^{2}+2{x}_{1}{x}_{2})-{x}_{2}^{2}\\end{aligned}\n$$\n\nNext, we complete the square inside the parentheses:\n\n$$\n\\begin{aligned}4({x}_{1}^{2}+2{x}_{1}{x}_{2})-{x}_{2}^{2} & =4([{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}]-{x}_{2}^{2})-{x}_{2}^{2} \\\\  & =4(({x}_{1}+{x}_{2})^{2}-{x}_{2}^{2})-{x}_{2}^{2}\\end{aligned}\n$$\n\nThen, we simplify the expression:\n\n$$\n\\begin{aligned}4(({x}_{1}+{x}_{2})^{2}-{x}_{2}^{2})-{x}_{2}^{2} & =4({x}_{1}+{x}_{2})^{2}-4{x}_{2}^{2}-{x}_{2}^{2} \\\\  & =4({x}_{1}+{x}_{2})^{2}-5{x}_{2}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n$$\n4{y}_{1}^{2}-5{y}_{2}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}+{x}_{2} \\\\ {y}_{2} &={x}_{2}.\\end{aligned}\\right.\n$$\n\nTherefore, from left to right, the missing parts are as follows:\n\n$\\,$ $4\\,$ and $\\,{x}_{1}+{x}_{2}.$"} {:db/id #edb/ref 17592186357671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b10bea-7843-5047-bcea-6a25b28052b3" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}+{x}_{2}$" :db/id #edb/ref 17592186354716} {:answer/id #uuid "1b66027c-35b5-58b3-a2eb-5d0d365140d1" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}-2{x}_{2}$" :db/id #edb/ref 17592186354903} {:answer/id #uuid "51eb5861-f417-5251-a4f7-2b629e8c1bc4" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186355396} {:answer/id #uuid "86d23810-67c0-5047-8662-6fed040f9840" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and ${x}_{1}-{x}_{2}$" :db/id #edb/ref 17592186355857} {:answer/id #uuid "8e818f90-e08f-56cc-a783-