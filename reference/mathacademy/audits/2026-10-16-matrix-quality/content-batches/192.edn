& 0 \\\\ 1 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1a8ef61-3fdc-55b0-a2a2-c452b741e335" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186117266} {:answer/id #uuid "0b7ac22d-9e88-51e0-a3c8-f45cd7bec70a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186117267} {:answer/id #uuid "1a6f0369-458f-5bb8-97af-0e5714d053c3" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186117268} {:answer/id #uuid "2b3ab15d-3726-5fe5-a623-4382126f3f9c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186117269} {:answer/id #uuid "381762ef-8497-5ad9-af40-3b8da0b323b4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186117270}] :answer-field/id #uuid "ae1f1d8d-f286-5379-97b6-c8986c01c66a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117265}] :question/id #uuid "600fccf2-8dda-57d5-a6ef-ba0e48910f68" :question/math-academy-id "q-32534" :question/problem "Given that\n$A = \\begin{bmatrix}2 & 2 & 0 \\\\ 3 & 1 & -1 \\\\ 0 & -2 & 3\\end{bmatrix}$ has the LU decomposition $A = LU$, then $l_{21} \\cdot u_{33} =$"} {:db/id #edb/ref 17592186243967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cb4e22-4527-5cdf-a246-1015081dac6c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186241398} {:answer/id #uuid "45ff70ac-0687-5b4f-8a03-e3801fde7dde" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186241811} {:answer/id #uuid "c2e14ccb-77c2-5ea4-bf3e-93ea6b71314d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186242893} {:answer/id #uuid "c7019515-4ac5-5e22-b2ba-750fda287b5c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242938} {:answer/id #uuid "f01bc462-8fff-5df6-8acb-52fca6d667fb" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243312}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243312} :answer-field/id #uuid "3d43a551-8858-5c8b-93c4-57c4ba597de0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243556}] :question/id #uuid "54845a6f-21d5-55bc-a564-7e1e09132e6f" :question/math-academy-id "q-106855" :question/problem "Given that \n$A=\\begin{bmatrix}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{23}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 0 & 2 \\\\ 5 & 1 & -8 \\\\ -4 & 0 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ -4 & 0 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 0 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -5\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=4,{u}_{23}=2,$ and ${l}_{31}\\cdot {u}_{23}=8.$"} {:db/id #edb/ref 17592186243968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0103ed51-38eb-56e1-b5b6-506ac5114dcb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186241194} {:answer/id #uuid "28f58628-e349-51a5-9381-2a6c3f3e63d5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186241538} {:answer/id #uuid "362edb3b-c2c6-5e35-b27f-a4726544a314" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186241655} {:answer/id #uuid "88c00484-3dac-50cd-9b40-2f30d2fe5429" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186242384} {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243101}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243101} :answer-field/id #uuid "97841af7-3445-571b-82d4-01c790eeec83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243720}] :question/id #uuid "715f2529-cb8e-5152-b727-a6588c23a27e" :question/math-academy-id "q-106856" :question/problem "Given that \n$A=\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$"} {:db/id #edb/ref 17592186243969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006f8bad-4488-5247-b030-e69c65d69aa9" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241189} {:answer/id #uuid "5c0029bc-5dd1-5f3b-a321-0734ae89305c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186242011} {:answer/id #uuid "c5338b5d-9d5a-53f8-8757-89e53bce6a9b" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186242918} {:answer/id #uuid "cb3972a3-507c-51c5-a785-eebe4b438e06" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186242969} {:answer/id #uuid "de80bb7f-5c83-554e-90e1-3ead07f6bbb3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186243158}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186242011} :answer-field/id #uuid "27b176de-565d-5931-ae28-b4d1ef631a50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243509}] :question/id #uuid "b30a7824-ca9d-5133-93d0-3fa15525aa26" :question/math-academy-id "q-106858" :question/problem "Given that \n$A=\\begin{bmatrix}3 & -2 & -3 \\\\ -3 & -1 & 3 \\\\ 9 & 0 & -5\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{21}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & -2 & -3 \\\\ -3 & -1 & 3 \\\\ 9 & 0 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 9 & 0 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 6 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 3 & -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & -2 & -3 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-1,$ ${u}_{33}=4,$ and ${l}_{21}\\cdot {u}_{33}=-4.$"} {:db/id #edb/ref 17592186302202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0432df21-0cbf-5310-b63d-d6d35b252ad8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299948} {:answer/id #uuid "0e624142-c08f-57f0-ac81-3c8acbe9f224" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186300009} {:answer/id #uuid "934f2563-3041-51a5-be22-78f3bc46ae92" :answer/type {:db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186300701} {:answer/id #uuid "ac425112-4037-539d-b950-dc90094cf5b2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300823} {:answer/id #uuid "b1c403d6-3218-5d7c-bb7b-d08ac835de9a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300849}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186300009} :answer-field/id #uuid "b0579342-0bba-5c5a-a576-6b032097c4cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301806}] :question/id #uuid "912ad134-e874-55d5-a192-6e414d5ad134" :question/math-academy-id "q-32533" :question/problem "Given that\n$A=\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix}$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-0.5){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.5,{u}_{33}=1,$ and ${l}_{32}\\cdot {u}_{33}=0.5.$"} {:db/id #edb/ref 17592186302328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe83a0-e9d5-50a3-9940-fe6aa5b2fca5" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186300325} {:answer/id #uuid "86d51352-51ec-57c4-9bf2-275890748404" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186300638} {:answer/id #uuid "c5cdd5e8-4939-5ef4-9d9c-85d5d69186c4" :answer/type {:db/ident :answer.type/math} :answer/value "-0.25" :db/id #edb/ref 17592186300947} {:answer/id #uuid "ce4ba015-2615-5951-9a18-719c2ec77b4d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300991} {:answer/id #uuid "f8ed7e67-5