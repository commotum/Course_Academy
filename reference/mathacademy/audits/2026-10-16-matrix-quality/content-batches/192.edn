x}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{2} & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ 0 & 0 & -11\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186504625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e167e3-3c1a-5a94-aedd-937cca7aa527" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504100} {:answer/id #uuid "4776454d-1433-55b0-a3f1-6744fa92a4be" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{3} & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186504161} {:answer/id #uuid "869d1c4e-d590-57e1-8c7b-108e1a80a41c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504267} {:answer/id #uuid "a85269ed-a160-5cdf-ba28-b8d04e6cc4a4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & -\\frac{1}{3} & 1\\end{aligned}]" :db/id #edb/ref 17592186504325} {:answer/id #uuid "e5adc569-5d12-5e17-a6da-903c09507f69" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ \\frac{1}{3} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504428}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504100} :answer-field/id #uuid "dc30e01e-9aef-5e28-9a4c-abb1934ac9fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504585}] :question/id #uuid "445c4dee-b549-5e10-93bb-06205e66703c" :question/math-academy-id "q-106854" :question/problem "Given that \n$A=[\\begin{aligned}-3 & 6 & 0 \\\\ 1 & -3 & 2 \\\\ 3 & -6 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 6 & 0 \\\\ 1 & -3 & 2 \\\\ 3 & -6 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(\\frac{1}{3}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 3 & -6 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1274a3e1-55b9-552d-b003-12310c1f94da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556469} {:answer/id #uuid "420e7c72-67c3-54bb-8ebc-2aa8890493a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{5} & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556577} {:answer/id #uuid "65290f11-7840-570f-a534-0fa4fca0ae31" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556664} {:answer/id #uuid "7f46a36f-9fe5-5805-871e-6936924e326a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556722} {:answer/id #uuid "c548e49e-a7cd-5be9-b97c-4c57df80a6e1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556905}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{5} & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186556664} :answer-field/id #uuid "9220e030-d050-59e1-aeee-1e7f3bb39fe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 1759218