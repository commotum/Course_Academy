t ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix})U \\\\ C & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de611d7-7313-5fdd-89dd-41dc72d2340e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117386} {:answer/id #uuid "fd0596a2-9f9e-5955-835f-e995d8b20534" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & -9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117387} {:answer/id #uuid "0b7adc4b-cb74-5784-bdde-0ef21765e563" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -9 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117388} {:answer/id #uuid "5570b71d-293a-54ed-a33c-c63644634573" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117389} {:answer/id #uuid "7a2a88cc-2bf2-5155-a3a2-7f97c7c59a14" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117390}] :answer-field/id #uuid "e8b8fe9e-844d-56b5-bf1c-f6dfd12aac18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117385}] :question/id #uuid "dc32