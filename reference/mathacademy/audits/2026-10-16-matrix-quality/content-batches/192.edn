\end{bmatrix}}^{-1}U \\\\ B & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{bmatrix})U \\\\ B & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.25,{u}_{33}=-3,$ and ${l}_{32}\\cdot {u}_{33}=-0.75.$"} {:db/id #edb/ref 17592186302329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2c73-b3f3-5f9e-bdca-1b5b280e8ca5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186299976} {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300075} {:answer/id #uuid "19c8433d-ce31-55b1-ace0-59e14900aabb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300076} {:answer/id #uuid "7190b1cb-7787-5bdb-9600-71dbc81662e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300527} {:answer/id #uuid "c9f2b7f6-5083-5e02-a198-e7a6dbb7f6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300969}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300075} :answer-field/id #uuid "1a4a2fa1-bb43-517d-8181-7f72736b0a79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301310}] :question/id #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" :question/math-academy-id "q-32722" :question/problem "Given that\n$K=\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix}$\nhas the LU decomposition $K=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}^{-1}U \\\\ K & =(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix})U \\\\ K & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186378341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5970617-1206-528c-b69e-7ebb6223f979" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186378343} {:answer/id #uuid "095325b3-80c5-5f27-b007-875906e578be" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186378344} {:answer/id #uuid "2f2e97d5-7557-5786-89f6-5375485d588a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186378345} {:answer/id #uuid "e121bdf8-9724-50c6-a949-e5b6858dd7e2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186378346} {:answer/id #uuid "e118261a-a989-5d9b-98b5-cbfd28d8f029" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186378347}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186378347} :answer-field/id #uuid "3cbe7f54-dce3-5d51-bcb9-ab25d743a081" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378342}] :question/id #uuid "4abcf5ba-3b30-5d81-ac44-eb3cdb3a63a6" :question/math-academy-id "q-106853" :question/problem "Given that \n$A=\\begin{bmatrix}2 & 3 & -1 \\\\ 4 & 8 & -1 \\\\ 6 & 9 & -1\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{21}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 3 & -1 \\\\ 4 & 8 & -1 \\\\ 6 & 9 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & 3 & -1 \\\\ 0 & 2 & 1 \\\\ 6 & 9 & -1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & 3 & -1 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & 3 & -1 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=2,{u}_{33}=2,$ and ${l}_{21}\\cdot {u}_{33}=4.$"} {:db/id #edb/ref 17592186399573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf06c8c-fa37-5fb4-9bae-97c3d61f33d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399575} {:answer/id #uuid "21c0bd19-0548-5d99-9e33-6c9f927b3b22" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399576} {:answer/id #uuid "703a2c37-9c3b-5152-85d4-282f6208240c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399577} {:answer/id #uuid "79134b3c-db1d-513d-a8c1-a59e34a636a6" :answer/type {:db/ident :answer.typ