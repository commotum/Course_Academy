rix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 5 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -5 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 4 & -2 \\\\ 0 & 0 & 3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=-5,{u}_{22}=4,$ and ${l}_{31}\\cdot {u}_{22}=-20.$"} {:db/id #edb/ref 17592186478435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148aeac6-9429-5975-8721-cae7f8b07799" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -\\frac{1}{2} & \\frac{3}{2} & 1\\end{bmatrix}" :db/id #edb/ref 17592186477772} {:answer/id #uuid "3005c1d7-1c6a-5f2d-adca-97d0c2b4775a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186477822} {:answer/id #uuid "3d120f50-4d8d-5a4e-b725-2b885385d0bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ \\frac{1}{2} & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186477848} {:answer/id #uuid "c7f77f4d-fe4c-5031-adbe-7f23e6d3b3c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -\\frac{1}{2} & -\\frac{3}{2} & 1\\end{bmatrix}" :db/id #edb/ref 17592186478130} {:answer/id #uuid "fb1df5bb-c79a-547f-9735-ac4096fa61a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186478236}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186477822} :answer-fie