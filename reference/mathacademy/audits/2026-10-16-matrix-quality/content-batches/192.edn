bmatrix}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186478385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7f7f5-fc72-5752-849f-dd392dc67063" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186477756} {:answer/id #uuid "12b75b29-bad6-5c35-80f2-edeb27a01c19" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186477768} {:answer/id #uuid "1c445559-7267-5297-9c5a-68d5a53864a1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186477786} {:answer/id #uuid "902048e6-162f-5f83-b702-3baaf39b7262" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186478022} {:answer/id #uuid "e5d89713-1ab5-55e2-a0fa-594c33b016e5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186478190}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186477756} :answer-field/id #uuid "e7369fce-c748-5601-8fcb-67f8bc1ae355" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478357}] :question/id #uuid "277999dd-79b5-5a59-931f-a7b78502d7ff" :question/math-academy-id "q-75104" :question/problem "Given that \n$A=\\begin{bmatrix}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{1}{2},{u}_{33}=-2,$ and ${l}_{32}\\cdot {u}_{33}=1.$"} {:db/id #edb/ref 17592186478389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "620d1ff8-8a66-524c-9a18-4611eb533903" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186477936} {:answer/id #uuid "a8229c2f-308b-597c-935f-037b198c514e" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186478059} {:answer/id #uuid "b5565a18-21c8-5f36-812d-03ab73d8cc7f" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186478092} {:answer/id #uuid "bf53dc00-7696-5298-9aab-cc5fc495c6b0" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/re