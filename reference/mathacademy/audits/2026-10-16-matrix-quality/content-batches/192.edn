ization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186403815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ef9d2af-2241-5be9-9fa4-a8e93a74b58c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403817} {:answer/id #uuid "40956895-fd15-5548-bb48-c3389b38029e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403818} {:answer/id #uuid "7a0c39e5-8073-5dcf-994d-9e5a575fc526" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403819} {:answer/id #uuid "66df6fbd-34ea-5bc6-80a0-f363e4fe5e21" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403820} {:answer/id #uuid "3d0496f0-a286-58c3-82dc-168d307fbe1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403821}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186403820} :answ