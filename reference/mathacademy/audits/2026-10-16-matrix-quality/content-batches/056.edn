:answer.type/math} :answer/value "2e-3df" :db/id #edb/ref 17592186298510}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2e-3df" :db/id #edb/ref 17592186298510} :answer-field/id #uuid "705a8ea4-eb27-51d7-983f-d4f5acc273af" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299019}] :question/id #uuid "b5ce922b-4b06-539f-9202-8293bbf3e968" :question/math-academy-id "q-319175" :question/problem "For the matrix\n$T=\\begin{bmatrix}1 & e & f \\\\ 5 & 3d & 2 \\\\ 4 & 7 & d\\end{bmatrix},$\nfind the minor ${M}_{31}$ of the element ${t}_{31}.$\n\n${M}_{31}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${t}_{31},$ we remove the third row and first column:\n\n$$\nT=\\begin{bmatrix}∗ & e & f \\\\ ∗ & 3d & 2 \\\\ 4 & ∗ & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${t}_{31}$ is\n\n$$\n\\begin{aligned}{M}_{31} & =det\\begin{bmatrix}e & f \\\\ 3d & 2\\end{bmatrix} \\\\  & =\\begin{vmatrix}e & f \\\\ 3d & 2\\end{vmatrix} \\\\  & =e\\cdot 2-f\\cdot (3d) \\\\  & =2e-3df.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "986dc63a-e742-5041-bb2d-4d5f51536a44" :answer/type {:db/ident :answer.type/math} :answer/value "k-3ij" :db/id #edb/ref 17592186298213}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k-3ij" :db/id #edb/ref 17592186298213} :answer-field/id #uuid "8a0fcd13-ab7c-596a-9b62-151dcc74aee2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299100}] :question/id #uuid "73507977-fd56-5a33-bedf-10842b1fff67" :question/math-academy-id "q-319176" :question/problem "For the matrix\n$V=\\begin{bmatrix}j & 1 & 3i \\\\ 2 & k & 5 \\\\ 4 & j & k\\end{bmatrix},$\nfind the minor ${M}_{21}$ of the element ${v}_{21}.$\n\n${M}_{21}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${v}_{21},$ we remove the second row and first column:\n\n$$\nV=\\begin{bmatrix}∗ & 1 & 3i \\\\ 2 & ∗ & ∗ \\\\ ∗ & j & k\\end{bmatrix}\n$$\n\nSo, the minor of ${v}_{21}$ is\n\n$$\n\\begin{aligned}{M}_{21} & =det\\begin{bmatrix}1 & 3i \\\\ j & k\\end{bmatrix} \\\\  & =\\begin{vmatrix}1 & 3i \\\\ j & k\\end{vmatrix} \\\\  & =1\\cdot k-(3i)\\cdot j \\\\  & =k-3ij.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157c690f-1dd1-51f7-bf6b-acb2edb20b9f" :answer/type {:db/ident :answer.type/math} :answer/value "5pq" :db/id #edb/ref 17592186333181} {:answer/id #uuid "22aca4b7-dd87-57bd-bedc-92bb1d3a6bf0" :answer/type {:db/ident :answer.type/math} :answer/value "-6pq" :db/id #edb/ref 17592186333306} {:answer/id #uuid "3025c91d-8141-5951-81ae-a1980863cabc" :answer/type {:db/ident :answer.type/math} :answer/value "3{q}^{2}p" :db/id #edb/ref 17592186333434} {:answer/id #uuid "63668438-815a-5e67-bd57-5797e67bca40" :answer/type {:db/ident :answer.type/math} :answer/value "{p}^{2}-3q" :db/id #edb/ref 17592186333889} {:answer/id #uuid "781a1c29-7128-5fa0-b474-7c1ed77336c5" :answer/type {:db/ident :answer.type/math} :answer/value "-4{q}^{2}{p}^{2}" :db/id #edb/ref 17592186334068}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5pq" :db/id #edb/ref 17592186333181} :answer-field/id #uuid "53ac27d0-32a6-5d20-b7da-740074902a3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335404}] :question/id #uuid "76f42e6e-510a-5862-a8bc-fb0815ad8720" :question/math-academy-id "q-69739" :question/problem "What is the minor of ${e}_{32}$ in the matrix\n$E=\\begin{bmatrix}2p & p & -q \\\\ -p & {q}^{2} & 3q \\\\ q & 0 & q\\end{bmatrix}?$" :question/worked-solution "First, we remove the third row and the second column:\n\n$$\nE=\\begin{bmatrix}2p & ∗ & -q \\\\ -p & ∗ & 3q \\\\ ∗ & 0 & ∗\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}2p & -q \\\\ -p & 3q\\end{bmatrix} & =\\begin{vmatrix}2p & -q \\\\ -p & 3q\\end{vmatrix} \\\\  & =2p\\cdot 3q-(-q)\\cdot (-p) \\\\  & =6pq-pq \\\\  & =5pq\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29db2e07-4b6d-54f8-ba95-10bee51c961c" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}" :db/id #edb/ref 17592186333378} {:answer/id #uuid "49cfa5a1-6e00-5b05-8d7d-58210b470e27" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186333668} {:answer/id #uuid "d05791d8-db4c-54b4-87ee-40f1ccfb77ee" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}" :db/id #edb/ref 17592186334809} {:answer/id #uuid "de3475d0-f75a-5f97-a2bd-86534ad2f83e" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186334927} {:answer/id #uuid "e33ee508-1b50-57be-80b5-8cb3e0a56b21" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-2{x}^{2}" :db/id #edb/ref 17592186334968}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}" :db/id #edb/ref 17592186334927} :answer-field/id #uuid "854d2d06-6a07-53ba-a693-f3251576dae9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335492}] :question/id #uuid "63ee1edc-0af6-5ae3-b7c6-a4e20a5d93bd" :question/math-academy-id "q-69760" :question/problem "What is the minor of ${t}_{33}$ in the matrix\n$T=\\begin{bmatrix}y-x & x & {y}^{2} \\\\ -x & y+x & 1 \\\\ {x}^{2} & {y}^{2} & {x}^{2}\\end{bmatrix}?$" :question/worked-solution "First, we remove the third row and third column:\n\n$$\nT=\\begin{bmatrix}y-x & x & ∗ \\\\ -x & y+x & ∗ \\\\ ∗ & ∗ & {x}^{2}\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}y-x & x \\\\ -x & y+x\\end{bmatrix} & =\\begin{vmatrix}y-x & x \\\\ -x & y+x\\end{vmatrix} \\\\  & =(y-x)\\cdot (y+x)-x\\cdot (-x) \\\\  & ={y}^{2}-{x}^{2}+{x}^{2} \\\\  & ={y}^{2}-\\cancel{{x}^{2}}+\\cancel{{x}^{2}} \\\\  & ={y}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc3a9ac-bdc8-5318-91e8-e9f4dcdc571d" :answer/type {:db/ident :answer.type/math} :answer/value "p-q" :db/id #edb/ref 17592186342357} {:answer/id #uuid "50a29c81-1ad7-5d8f-a2af-ab521804ef38" :answer/type {:db/ident :answer.type/math} :answer/value "2pq" :db/id #edb/ref 17592186342905} {:answer/id #uuid "6322b5d8-1470-59df-89df-7b2e1672bfba" :answer/type {:db/ident :answer.type/math} :answer/value "pq-1" :db/id #edb/ref 17592186343077} {:answer/id #uuid "8bb0c3f7-c59e-51d6-9385-c37a6e0e9adf" :answer/type {:db/ident :answer.type/math} :answer/value "q-p" :db/id #edb/ref 17592186343457} {:answer/id #uuid "a5270be3-606e-52e8-b6ba-1a9a3ff77f41" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186343696}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2pq" :db/id #edb/ref 17592186342905} :answer-field/id #uuid "844a5f0b-ee55-59e5-a8f8-5008969d5b6d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344727}] :question/id #uuid "acee546b-9ba7-5b7c-a744-bd545219daed" :question/math-academy-id "q-77471" :question/problem "What is the minor of ${k}_{22}$ in the matrix\n$K=\\begin{bmatrix}p & p & -p \\\\ -q & q & q \\\\ q & -2 & q\\end{bmatrix}?$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nK=\\begin{bmatrix}p & ∗ & -p \\\\ ∗ & q & ∗ \\\\ q & ∗ & q\\end{bmatrix}\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}p & -p \\\\ q & q\\end{bmatrix} & =\\begin{vmatrix}p & -p \\\\ q & q\\end{vmatrix} \\\\  & =p\\cdot p-q\\cdot (-p) \\\\  & =pq+pq \\\\  & =2pq\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"} {:db/id #edb/ref 17592186059753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059562 :question/id #uuid "afd06762-0a78-5559-b035-98bd05e6c084" :question/math-academy-id "e-4441" :question/problem "Given that the minor of $a_{23}$ is $5,$ find all the possible values of $k$ in the matrix\n![](images/1d/1d37ba9039f24a96be2d148c9f30c8a10ca30c9745ad8a28df23de5a42f6dcab.png)" :question/worked-solution "First, we remove the second row and third column:\n\n![](images/80/80f9b95139f7b571c7752ee1feec4c9d3df8456223581736ae019344a6f9a080.png)\n\nThe minor of $a_{23}$ is\n\n$$\n\\begin{aligned}det\\begin{bmatrix}k & 3 \\\\ -1 & 2k\\end{bmatrix} & =\\begin{vmatrix}k & 3 \\\\ -1 & 2k\\end{vmatrix} \\\\  & =k\\cdot 2k-3\\cdot (-1) \\\\  & =2{k}^{2}+3.\\end{aligned}\n$$\n\nWe're told that the minor of $a_{23}$ is $5,$ so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+3 & =5 \\\\ 2{k}^{2} & =2 \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=1.$"} :knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51" :knowledge-point/questions [{:db/id #edb/ref 17592186060138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b7c9e1d-4fa1-5ccc-a982-d9a9f83c7dbe" :answer/type {:db/ident :answer.type/text} :answer/value "$k =-6$ and $k = 4$ only" :db/id #edb/ref 17592186057195} {:answer/id #uuid "a62d3a59-bc7f-5731-a403-61ec109c2a65" :answer/type {:db/ident :answer.type/text} :answer/value "$k =-4$ and $k = 6$ only" :db/id #edb/ref 17592186057196} {:answer/id #uuid "d661005e-d59e-5d99-993b-e5b3ed0dddef" :answer/type {:db/ident :answer.type/text} :answer/value "$k =-6$ and $k =-4$ only" :db/id #edb/ref 17592186057197} {:answer/id #uuid "fe119889-5438-5712-ae2c-580738e6d5f1" :answer/type {:db/ident :answer.type/text} :answer/value "$k = 6$ only" :db/id #edb/ref 17592186057198} {:answer/id #uuid "5e2c4e10-afc7-5f50-84ec-bc15f80324be" :answer/type {:db/ident :answer.type/text} :answer/value "$k = 4$ and $k = 6$ only" :db/id #edb/ref 17592186057199}] :answer-field/id #uuid "e330b806-e854-51fb-b3d7-c56a03b695f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057194}] :question/id #uuid "a9d61fcf-11f2-5559-b5a5-0b018c1b7764" :question/math-academy-id "q-18245" :question/problem "Given that the minor of $a_{22}$ is $2k^{2} + 26$, find all the possible values of $k$ in the matrix\n$A = \\begin{bmatrix}-2 & 9 & -10 \\\\ 8 & -5 & 3 \\\\ 2k - 2 & 7 & 1\\end{bmatrix}$."} {:db/id #edb/ref 17592186060141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "922efb98-094c-5cb0-b598-ca53dbd40c79" :answer/type {:db/ident :answer.type/text} :answer/value "$t = 4$ and $t = 5$ only" :db/id #edb/ref 17592186057213} {:answer/id #uuid "cc82bc67-8e72-5ecb-9f14-69a51bf471c4" :answer/type {:db/ident :answer.type/text} :answer/value "$t = 5$ only" :db/id #edb/ref 17592186057214} {:answer/id #uuid "08522422-373c-50b5-8818-1a41c69958ad" :answer/type {:db/ident :answer.type/text} :answer/value "$t =-5$ and $t = 4$ only" :db/id #edb/ref 17592186057215} {:answer/id #uuid "3edcdacf-1a99-5d1f-8af8-bf61ed390ede" :answer/type {:db/ident :answer.type/text} :answer/value "$t =-5$ and $t =-4$ only" :db/id #edb/ref 17592186057216} {:answer/id #uuid "78eb832a-251e-55b3-8f40-495326995efc" :answer/type {:db/ident :answer.type/text} :answer/value "$t =-4$ only" :db/id #edb/ref 17592186057217}] :answer-field/id #uuid "8d8e5be9-e228-55ee-8e70-778d9a594d06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057212} {:answer-field/choices [{:answer/id #uuid "205c22e6-8533-526d-adfc-b7173bb287ef" :answer/type {:db/ident :answer.type/text} :answer/value "$t=-4$ only" :db/id #edb/ref 17592186401717} {:answer/id #uuid "78173574-1dd2-594f-94a9-485be0dead83" :answer/type {:db/ident :answer.type/text} :answer/value "$t=4$ and $t=5$ only" :db/id #edb/ref 17592186401718} {:answer/id #uuid "f493d638-8bce-58ac-912a-5338bcaaef9e" :answer/type {:db/ident :answer.type/text} :answer/value "$t=-5$ and $t=-4$ only" :db/id #edb/ref 17592186401719} {:answer/id #uuid "ea9478e1-7ffc-5682-8c4f-871cb83d3a5d" :answer/type {:db/ident :answer.type/text} :answer/value "$t=-5$ and $t=4$ only" :db/id #edb/ref 17592186401720} {:answer/id #uuid "98c916e5-ba01-54de-ae08-6a77aed9f1d0" :answer/type {:db/ident :answer.type/text} :answer/value "$t=5$ only" :db/id #edb/ref 17592186401721}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$t=4$ and $t=5$ only" :db/id #edb/ref 17592186401718} :answer-field/id #uuid "5695dc0f-925d-5609-ad66-b2dab30bc5b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401716}] :question/id #uuid "0c6851eb-a487-5113-99b9-8f1c04863168" :question/math-academy-id "q-18246" :question/problem "Given that the minor of ${p}_{23}$ is ${t}^{2}+12$, find all the possible values of $t$ in the matrix\n\n$$\nP=\\begin{bmatrix}t & -8 & 3 \\\\ -7 & 4 & 4 \\\\ -1 & 9 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we remove the second row and third column:\n\n$$\nP=\\begin{bmatrix}t & -8 & ∗ \\\\ ∗ & ∗ & 4 \\\\ -1 & 9 & ∗\\end{bmatrix}\n$$\n\nThe minor of ${p}_{23}$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}t & -8 \\\\ -1 & 9\\end{bmatrix} & =\\begin{vmatrix}t & -8 \\\\ -1 & 9\\end{vmatrix} \\\\  & =t\\cdot 9-(-8)\\cdot (-1) \\\\  & =9t-8.\\end{aligned}\n$$\n\nWe're told that the minor of ${p}_{23}$ is ${t}^{2}+12$, so we must have:\n\n$$\n\\begin{aligned}9t-8 & ={t}^{2}+12 \\\\ {t}^{2}-9t+20 & =0 \\\\ (t-5)(t-4) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $t=4$ and $t=5.$"} {:db/id #edb/ref 17592186262870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31de786b-6f14-5df5-9736-93b210a2a0d4" :answer/type {:db/ident :answer.type/math} :answer/value "t=17" :db/id #edb/ref 17592186260324} {:answer/id #uuid "3af2fec4-6af5-542f-acfc-e27bb5d18219" :answer/type {:db/ident :answer.type/math} :answer/value "t=23" :db/id #edb/ref 17592186260402} {:answer/id #uuid "648e2e06-6852-561f-939c-44b21296ce72" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186260742} {:answer/id #uuid "af3ca614-8df9-5b0d-af8f-355fcec4353d" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{5}{6}" :db/id #edb/ref 17592186261422} {:answer/id #uuid "c7e81d15-a59d-55fe-ac89-5df10ce72bc7" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{19}{3}" :db/id #edb/ref 17592186261643}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186260742} :answer-field/id #uuid "eb5b2b9c-666c-5406-8332-78aa1f06317d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262537}] :question/id #uuid "e3ecc337-1b16-55d2-b09a-2ec75b870d61" :question/math-academy-id "q-128082" :question/problem "Given that the minor of ${p}_{11}$ is $4$, find all the possible values of $t$ in the matrix\n\n$$\nP=\\begin{bmatrix}-5t & 18 & 6t \\\\ -3 & 9 & 5 \\\\ 19t & 1 & 3t\\end{bmatrix}.\n$$" :question/worked-solution "First, we remove the first row and first column:\n\n$$\nP=\\begin{bmatrix}5t & ∗ & ∗ \\\\ ∗ & 9 & 5 \\\\ ∗ & 1 & 3t\\end{bmatrix}\n$$\n\nThe minor of ${p}_{11}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}9 & 5 \\\\ 1 & 3t\\end{bmatrix} & =\\begin{vmatrix}9 & 5 \\\\ 1 & 3t\\end{vmatrix} \\\\  & =9\\cdot 3t-5\\cdot 1 \\\\  & =27t-5.\\end{aligned}\n$$\n\nWe're told that the minor of ${p}_{11}$ is $4$, so we must have:\n\n$$\n\\begin{aligned}27t-5 & =4 \\\\ 27t & =9 \\\\ t & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solution is $t=\\frac{1}{3}.$"} {:db/id #edb/ref 17592186262871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0732f8b1-eb05-5ff1-a3f6-793e2f27eb1e" :answer/type {:db/ident :answer.type/math} :answer/value "p=7" :db/id #edb/ref 17592186259944} {:answer/id #uuid "2d20259b-44f1-5ffa-993c-4c58efda61e2" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{6}{5}" :db/id #edb/ref 17592186260281} {:answer/id #uuid "6c259d57-624f-5f9e-87cb-3228d62c929e" :answer/type {:db/ident :answer.type/math} :answer/value "p=-\\frac{5}{2}" :db/id #edb/ref 17592186260821} {:answer/id #uuid "7be2e291-cb7b-5329-96a9-9de18933bba0" :answer/type {:db/ident :answer.type/math} :answer/value "p=-2" :db/id #edb/ref 17592186260954} {:answer/id #uuid "93ca3018-b7e7-5f1a-a255-2c80692e7bdd" :answer/type {:db/ident :answer.type/math} :answer/value "p=9" :db/id #edb/ref 17592186261158}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "p=-\\frac{5}{2}" :db/id #edb/ref 17592186260821} :answer-field/id #uuid "a8aa81c2-8ca4-5bb8-9cc9-7890b991fe52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262424}] :question/id #uuid "9f3049bb-465c-578a-83f2-bf4df23af7ed" :question/math-academy-id "q-128083" :question/problem "Given that the minor of ${d}_{12}$ is $-4$, find all the possible values of $p$ in the matrix\n\n$$\nD=\\begin{bmatrix}{p}^{2} & {p}^{3} & 6 \\\\ -6 & 7 & 5 \\\\ 5 & 2+p & p-1\\end{bmatrix}.\n$$" :question/worked-solution "First, we remove the first row and second column:\n\n$$\nD=\\begin{bmatrix}∗ & {p}^{3} & ∗ \\\\ -6 & ∗ & 5 \\\\ 5 & ∗ & p-1\\end{bmatrix}\n$$\n\nThe minor of ${d}_{12}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}-6 & 5 \\\\ 5 & p-1\\end{bmatrix} & =\\begin{vmatrix}-6 & 5 \\\\ 5 & p-1\\end{vmatrix} \\\\  & =-6\\cdot (p-1)-5\\cdot 5 \\\\  & =-6p-19.\\end{aligned}\n$$\n\nWe're told that the minor of ${d}_{12}$ is $-4$, so we must have:\n\n$$\n\\begin{aligned}-6p-19 & =-4 \\\\ -6p & =15 \\\\ p & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $p=-\\frac{5}{2}.$"} {:db/id #edb/ref 17592186262872 :question/answer-fi