 :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270405} {:answer/id #uuid "e405d544-5373-5a6b-ae5a-7133727a2f31" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186271277}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186271277} :answer-field/id #uuid "49a3e349-c042-5891-b20b-9ce5fdf20642" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271643}] :question/id #uuid "0934aa4b-cfbc-551f-aede-b568683fcc43" :question/math-academy-id "q-141228" :question/problem "Consider a $6\\times 8$ matrix $A.$ If $\\text{dim(Null(}A))=2,$ then $\\text{rank}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =8 \\\\ \\text{rank}(A) & =8-2 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081b154e-54f5-5447-aafd-6ba5ed6eba3e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269342} {:answer/id #uuid "08d06b17-6c99-55d6-a320-2aa710af8a97" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269349} {:answer/id #uuid "603e2443-254e-5b26-960c-6ec88547b717" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270119} {:answer/id #uuid "8c6c3b7f-9b3e-51c8-ac1d-b9cafce8488a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186270487} {:answer/id #uuid "bdf7b53c-4c90-524f-b671-25d45508cc6d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270945}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269349} :answer-field/id #uuid "24a8eaad-fb70-5b83-881d-5c5fb78f339f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271577}] :question/id #uuid "c3ee4195-fbf7-5133-aa9f-68dff638a011" :question/math-academy-id "q-142480" :question/problem "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim(Null(}A))=2,$ then $\\text{rank}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =6 \\\\ \\text{rank}(A) & =6-2 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e335be1-975b-5232-9bd4-5eac32984abe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346161} {:answer/id #uuid "91458386-a13b-547c-a3af-462a321d6225" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346618} {:answer/id #uuid "c25b38bf-d190-5b50-8b41-ecee957bc77c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347033} {:answer/id #uuid "dd5bfa0e-b88d-5bfd-8880-005919b2a2ee" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186347294} {:answer/id #uuid "f4274491-3f9f-5182-a334-44335bf752c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186347515}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346618} :answer-field/id #uuid "13010a70-7fa5-5ef7-a02b-f50f4d30ab65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347640}] :question/id #uuid "ce93ec7a-fcc3-5848-bb9c-a5b8e16bd97c" :question/math-academy-id "q-79353" :question/problem "Consider a $7\\times 9$ matrix $A.$ If $\\text{rank}(A)=7$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=9.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 7+\\text{nullity}(A) & =9 \\\\ \\text{nullity}(A) & =9-7 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2624dee0-0e9d-5954-b17a-630c9c03b623" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489599} {:answer/id #uuid "4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489703} {:answer/id #uuid "76d6b8cf-388a-5474-aaf8-b2cb995a67ab" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489789} {:answer/id #uuid "8879e74f-52fc-547b-ac4e-229ffb4a243b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186489826} {:answer/id #uuid "94b18bfb-620b-57f0-83d6-6c6dd32ac223" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186489849}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489703} :answer-field/id #uuid "de313b80-7984-512b-bdaf-802f9aba6f00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490190}] :question/id #uuid "fa527559-21f3-5088-ac1e-a7d1439bef18" :question/math-academy-id "q-142483" :question/problem "Consider a $8\\times 8$ matrix $A.$ If $\\text{rank}(A)=5$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 5+\\text{nullity}(A) & =8 \\\\ \\text{nullity}(A) & =8-5 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3065f796-1624-588c-ad6c-8dc59c6f240e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489622} {:answer/id #uuid "4da61d62-968c-5325-878b-c10d9e629b68" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489698} {:answer/id #uuid "50c964b1-c602-5d5d-919e-df6c10f9af08" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489708} {:answer/id #uuid "a98b8437-83a6-540a-b465-549d1e82c697" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186489887} {:answer/id #uuid "d659b67d-8b6a-563d-897b-d4779a52e317" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186489990}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489708} :answer-field/id #uuid "7e63c75a-0e87-5ea0-8fd9-4a7908e3c449" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490146}] :question/id #uuid "fb06ba3d-1b9f-5681-af01-0922516167aa" :question/math-academy-id "q-142484" :question/problem "Consider a $8\\times 10$ matrix $A.$ If $\\text{rank}(A)=7$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=10.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 7+\\text{nullity}(A) & =10 \\\\ \\text{nullity}(A) & =10-7 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0489d7c0-9892-5b4f-a265-35a855cae665" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522025} {:answer/id #uuid "19d7b093-ccfa-5074-9a83-a27b17ba1454" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522078} {:answer/id #uuid "40c69629-2803-5ad7-aa97-c2b10a5bb2b3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522158} {:answer/id #uuid "9b640a26-d27a-5063-8ab1-f9eddbf076e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186522337} {:answer/id #uuid "f26141c5-5ae9-5b4b-80af-055e70b6a825" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522536}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186522078} :answer-field/id #uuid "70719b4e-2718-5ba2-8435-476dae5ff60e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522612}] :question/id #uuid "b1b6e064-faca-5061-955a-61c19c8be97d" :question/math-academy-id "q-142481" :question/problem "Consider a $4\\times 4$ matrix $A.$ If $\\text{rank}(A)=3$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "515cb0ad-3bf4-5d0b-b7db-ba6abbf4f45e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186522193} {:answer/id #uuid "87510f02-5814-56e6-9a0a-3bbbf7e6baba" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186522288} {:answer/id #uuid "b3fe8edc-cf8c-59b3-845a-0f711614663c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522389} {:answer/id #uuid "e0746fb2-e7e9-54d9-93d0-235af2e3310d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522494} {:answer/id #uuid "e37b3463-8c25-56aa-885e-ca8b85bf4b8a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186522504}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522389} :answer-field/id #uuid "b0ade6f1-cb8a-5617-b68c-23062a0a94c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522646}] :question/id #uuid "e3fc6c03-9e92-5752-b628-3af41a4a428b" :question/math-academy-id "q-139981" :question/problem "Consider a $9\\times 6$ matrix $A.$ If $\\text{rank}(A)=4$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Rank or Nullity of a Matrix Using the Rank-Nullity Theorem"}] :topic/math-academy-id 3836 :topic/title "The Rank-Nullity Theorem"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186129938} :activity/id #uuid "5f586b25-2c9f-53c9-8c70-a938202d5eda" :activity/steps [{:db/id #edb/ref 17592186129938 :step/content {:db/id #edb/ref 17592186130339 :tutorial/content "Consider the following matrices:\n![](images/10/1074870d255109821b5f36eb517f22531efbd8f5069f05c3de3f111b38befd02.svg)\n\nThe first non-zero entry on each row (from left to right) is called the **leading entry** of that row.\n\n- In the matrix $A,$ the leading entries are $a_{11}=2,$ $a_{22}=3,$ $a_{32}=1,$ and $a_{43}=5.$\n\n- In the matrix $B,$ the leading entries are $b_{11}=1,$ $b_{22}=3,$ $b_{33}=-2,$ and $b_{44}=2.$ The $5$th row has no leading entry.\n\nThe leading entries are highlighted below.\n\n![](images/6b/6b1d99269c847f7c6bc0558da347fb300dba5fa6caf373cd1ed5cc5ebacb1649.svg)" :tutorial/id #uuid "24451a80-db9f-5a0f-a591-41500a69774c" :tutorial/math-academy-id 3148 :tutorial/title "Introduction"} :step/id #uuid "5cf43dee-1fef-5d4c-9775-65a5c7ed9dc1" :step/next {:db/id #edb/ref 17592186130042}} {:db/id #edb/ref 17592186129939 :step/content {:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3"} :step/id #uuid "9da7e60b-1218-59ef-a17a-68019b1df9c5" :step/next {:db/id #edb/ref 17592186129941}} {:db/id #edb/ref 17592186129940 :step/content {:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799"} :step/id #uuid "d00efb7b-6c6d-5f75-a839-fd2c4b29adfc" :step/next {:db/id #edb/ref 17592186129939}} {:db/id #edb/ref 17592186129941 :step/content {:db/id #edb/ref 17592186129115 :knowledge-point/id #uuid "fe0050b2-b5bc-54a6-aeaf-94cd5d7e5dfb"} :step/id #uuid "ed25462b-dcf5-53b8-af91-93afa32dea4c"} {:db/id #edb/ref 17592186130041 :step/content {:db/id #edb/ref 17592186130380 :tutorial/content "Let's consider our matrices $A$ and $B$ once more, with the leading entries highlighted.\n\n![](images/af/af61f32297e248ab9989ba59ea6c9bda2f99efe19d25df525fef916617843a32.svg)\n\nWe say that a matrix is in **row echelon form** if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nHere, $B$ is in row echelon form since both conditions are satisfied. However, $A$ is not in row echelon form since condition II is violated: the leading entry of the third row $(a_{32}={\\color{red}1})$ is placed just below the leading entry of the second row $(a_{22}=3).$\n\nGenerally speaking, row echelon form means that we have *stairs* where each step (represented by a leading entry $\\bbox[lightgray, 3pt]{\\large\\ast}$) has a height of $1.$\n\n![](images/67/67f83c454e59d16ae80cf67a19b19f968182251a2e5d1b405e2c422e0313d5b7.png)\n\nFinally, an *augmented* matrix is in row echelon form if the coefficient matrix (i.e., the part that is to the left of the vertical bar) is in row echelon form." :tutorial/id #uuid "137b0909-9a5e-5edf-8019-24e803307903" :tutorial/math-academy-id 3896 :tutorial/title "Row Echelon Form"} :step/id #uuid "1430eddc-7fc0-5265-81de-85b9a44bbf70" :step/next {:db/id #edb/ref 17592186129940}} {:db/id #edb/ref 17592186130042 :step/content {:db/id #edb/ref 17592186129176 :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb"} :step/id #uuid "f062c6b3-17e0-57cb-a070-e9edcc0af6c8" :step/next {:db/id #edb/ref 17592186130041}}] :activity/title "Row Echelon Form" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186129395}] :db/id #edb/ref 17592186048980 :topic/knowledge-points [{:db/id #edb/ref 17592186129113 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128925 :question/id #uuid "674e7733-7a8e-5804-a867-82c74c583dcc" :question/math-academy-id "e-4687" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}1 & 2 & -1 & 0 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 1 & 1 & 1\\end{array}\n\t\\right]\n$$\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}1 & 2 & -1 & 5 \\\\ 0 & 2 & 0 & -2 \\\\ 0 & 0 & 1 & 7\\end{array}\n\t\\right]\n$$\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}1 & 0 & -1 & 4 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{array}\n\t\\right]\n$$\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}0 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 1 \\\\ 1 & 1 & 1 & 1\\end{array}\n\t\\right].\n$$\n\n" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The first matrix is not in row echelon form since $a_{32} \\neq 0$ (condition II is violated).\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}\\bbox[lightgray, 2pt]{1} & 2 & -1 & 0 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{1} & 0 & 1 \\\\ {\\color{blue}0} & {\\color{red}1} & 1 & 1\\end{array}\n\t\\right]\n$$\n\n- The second matrix is in row echelon form (both conditions are satisfied).\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}\\bbox[lightgray, 2pt]{1} & 2 & -1 & 5 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{2} & 0 & -2 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{1} & 7\\end{array}\n\t\\right]\n$$\n\n- The third matrix is in row echelon form (both conditions are satisfied).\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}\\bbox[lightgray, 2pt]{1} & 0 & -1 & 4 \\\\ {\\color{blue}0} & \\bbox[lightgray, 2pt]{1} & 0 & 1 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & 0\\end{array}\n\t\\right]\n$$\n\n- The fourth matrix is not in row echelon form since, for example, the leading entry $a_{22}$ lies to the left of the leading entry $a_{13}$ (condition II is violated).\n\n$$\n\\left[\n\t\\begin{array}{ccc|c}0 & 0 & \\bbox[lightgray, 2pt]{1} & 1 \\\\ 0 & \\bbox[lightgray, 2pt]{{\\color{red}1}} & {\\color{black}0} & 1 \\\\ \\bbox[lightgray, 2pt]{{\\color{red}1}} & {\\color{red}1} & {\\color{red}1} & 1\\end{array}\n\t\\right]\n$$\n\n"} :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/question-generator {:db/id #edb/ref 17592186525152 :question-generator/id #uuid "748f1ef5-d7bf-516d-b3a1-429b704e4cbb" :question-generator/script "generate/scratch/17592186129113.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186129771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6ac301d-037b-5334-b6d2-fec88197d154" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459951} {:answer/id #uuid "5d1e6f74-c495-5ab5-805c-d983bca1e55c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459952}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459952} :answer-field/id #uuid "5d0e98e1-9e1f-510d-9dad-15a86b32835a" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460842} {:answer-field/choices [{:answer/id #uuid "3b9aa059-0eae-5a76-81c6-21892541d8ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459953} {:answer/id #uuid "0816847a-d539-509b-8356-6a24a780f633" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459954}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459954} :answer-field/id #uuid "5488b353-c1b4-5e30-83ca-a801084429aa" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460843} {:answer-field/choices [{:answer/id #uuid "fd314e1a-8262-5acc-90db-8b8b4a9f82f5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459955} {:answer/id #uuid "69a17d39-0448-5a32-8559-ff5820bddc16" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459956}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459955} :answer-field/id #uuid "eb9e86fc-fb03-5653-aa77-b599aca20dc9" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460844}] :question/id #uuid "658776f4-d49a-5e5d-a10c-50a3db34ad1c" :question/math-academy-id "q-42006" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}2 & 3 & -7 & 1 \\\\ 0 & 4 & 3 & -4 \\\\ 0 & 0 & -2 & 5\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}3 & 1 & -3 & 1 \\\\ 0 & 3 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 0 & 2 & 2 \\\\ 0 & -4 & 0 & 2 \\\\ -1 & 2 & 3 & 2\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\left[\\begin{array}{ccc|c}2 & 3 & -7 & 1 \\\\ 0 & 4 & 3 & -4 \\\\ 0 & 0 & -2 & 5\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}3 & 1 & -3 & 1 \\\\ 0 & 3 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{22}\\ne 0$ (condition II is violated).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 0 & 2 & 2 \\\\ 0 & -4 & 0 & 2 \\\\ -1 & 2 & 3 & 2\\end{array}\\right]\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."} {:db/id #edb/ref 17592186129774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a12a5bf1-b831-57bc-a289-9b874dd28be1" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186128126} {:answer/id #uuid "0e2e8497-890f-5946-abdd-026c91a6a710" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186128127} {:answer/id #uuid "3dd70ee5-9437-5935-856c-7e5b9161b173" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186128128} {:answer/id #uuid "4e86f997-55ba-53d9-bd8d-f236034d4a69" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186128129} {:answer/id #uuid "760682b7-9922-52d7-815c-3ae2e12e96e4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186128130}] :answer-field/id #uuid "84381930-6037-567a-be17-89c5aa7ee6ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128125}] :question/id #uuid "532660a0-b7ef-5857-a687-9a224039f8a6" :question/math-academy-id "q-42026" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n$$\nA = \\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 2 & 2 & 3\\end{array}\\right]\n$$\n\n$$\nB = \\left[\\begin{array}{ccc|c}2 & 3 & -2 & 4 \\\\ 0 & 4 & 0 & -3 \\\\ 0 & 0 & 5 & 6\\end{array}\\right]\n$$\n\n$$\nC = \\left[\\begin{array}{ccc|c}4 & 0 & -3 & 2 \\\\ 0 & 4 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$."} {:db/id #edb/ref 17592186262994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50c7f862-fb53-52f3-a851-3a1c0dd668c1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463742} {:answer/id #uuid "9091f23b-5dc1-5b2b-9de6-80e0b5f2b4c6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463743}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463743} :answer-field/id #uuid "3fe6ae55-4a0c-5261-a839-a0dc70994f94" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464805} {:answer-field/choices [{:answer/id #uuid "0925c8c8-8cf1-5109-b122-e948506d2229" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463744} {:answer/id #uuid "87fde758-761e-5f44-8ba8-4f420469834a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463745}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463745} :answer-field/id #uuid "55a0a25b-6999-500b-b7c6-387f861bd084" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464806} {:answer-field/choices [{:answer/id #uuid "ef038684-e790-5680-b0cf-14a5f0791fb3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463746} {:answer/id #uuid "8b0db024-6fc1-5cf1-b6bd-6a6d4a68ed1f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463747}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463747} :answer-field/id #uuid "c8f73348-51d4-578b-b6eb-9e0e603a1638" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464807}] :question/id #uuid "b5479435-9835-502a-bd24-1f955706f0c7" :question/math-academy-id "q-129228" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}4 & 1 & 2 & 0 \\\\ 0 & -6 & 3 & 9 \\\\ 0 & 0 & -8 & 3 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 7 & 0 & 9 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 8 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 9 & -1 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\left[\\begin{array}{ccc|c}4 & 1 & 2 & 0 \\\\ 0 & -6 & 3 & 9 \\\\ 0 & 0 & -8 & 3 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 7 & 0 & 9 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 8 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 9 & -1 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right]\n$$\n\nTherefore, $A,$ $B,$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186262996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6490d7cb-e49e-5df3-bd24-1fb08e93c1c2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463748} {:answer/id #uuid "73f708ba-0076-5c0b-82e1-e919017f5605" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463749}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463749} :answer-field/id #uuid "2ffde19d-784a-502b-8888-25092d71c5ef" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464808} {:answer-field/choices [{:answer/id #uuid "f4750390-d10c-5792-9210-4b235f6e2ce3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463750} {:answer/id #uuid "12e6cef5-b5fe-562c-99cb-370bb6c94767" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463751}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463751} :answer-field/id #uuid "0a6c5020-e558-5ac4-9259-bee888bb6216" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464809} {:answer-field/choices [{:answer/id #uuid "88129b53-c2d6-50ae-872d-5f80d5c513e3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463752} {:answer/id #uuid "8783247a-7590-53f9-8739-7072f4b6b889" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463753}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463753} :answer-field/id #uuid "90f5dc9c-b2f5-5481-a853-5afc90c32ea7" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464810}] :question/id #uuid "0ce5c5ca-b382-5ac8-8df3-b2e87f07de7f" :question/math-academy-id "q-129232" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}0 & -4 & 1 & 2 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 6 & 7\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}-6 & 3 & 4 & 0 \\\\ 0 & 9 & 6 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & -4 & 6 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{cccc|c}0 & 1 & -4 & 5 & 9 \\\\ 0 & 0 & 3 & -7 & 0 \\\\ 0 & 0 & 2 & 0 & -1 \\\\ 0 & 0 & 0 & 5 & 1\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{33}\\ne 0$ (condition II is violated).\n\n$$\nA=\\left[\\begin{array}{ccc|c}0 & -4 & 1 & 2 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 6 & 7\\end{array}\\right]\n$$\n\n- The matrix $B$ is not in row echelon form since the third row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}-6 & 3 & 4 & 0 \\\\ 0 & 9 & 6 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & -4 & 6 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{33}\\ne 0$ (condition II is violated).\n\n$$\nC=\\left[\\begin{array}{cccc|c}0 & 1 & -4 & 5 & 9 \\\\ 0 & 0 & 3 & -7 & 0 \\\\ 0 & 0 & 2 & 0 & -1 \\\\ 0 & 0 & 0 & 5 & 1\\end{array}\\right]\n$$\n\nTherefore, $A,$ $B,$ and $C$ are **not** in row echelon form."} {:db/id #edb/ref 17592186262997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2be017f-5e49-5ecf-9256-9026e1e49309" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463754} {:answer/id #uuid "64657d11-388e-5eea-8953-1183ad80b2a7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463755}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463755} :answer-field/id #uuid "7df1ad99-8fc0-5931-8c43-c2f5f1f4ae55" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464811} {:answer-field/choices [{:answer/id #uuid "183285c5-ecf3-5b1b-a709-43802b2d5542" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463756} {:answer/id #uuid "d06d9b80-8f1e-5a1e-92a5-1af63957f4d2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463757}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463756} :answer-field/id #uuid "42b05519-bc6b-5846-bb0a-d39f6aaa1a8f" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464812} {:answer-field/choices [{:answer/id #uuid "1b18bdf6-939a-51c6-93bc-947f0d9b20e4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463758} {:answer/id #uuid "a14bc920-ef18-5bb6-a154-ff32ab552a62" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463759}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463758} :answer-field/id #uuid "92ef8c8f-928a-51da-a3d5-e1b9fb740fb3" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464813}] :question/id #uuid "842b19e0-4a35-57fa-95ff-d59ed695ed85" :question/math-academy-id "q-129233" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=\\left[\\begin{array}{cccc|c}0 & 0 & 0 & 0 & -3 \\\\ 0 & 5 & 0 & 9 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{cc|c}9 & 0 & 6 \\\\ 0 & 2 & 5 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}1 & 0 & 3 & 6 \\\\ 0 & 2 & 0 & 1 \\\\ 0 & 0 & 3 & 4\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{cccc|c}0 & 0 & 0 & 0 & -3 \\\\ 0 & 5 & 0 & 9 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{cc|c}9 & 0 & 6 \\\\ 0 & 2 & 5 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccc|c}1 & 0 & 3 & 6 \\\\ 0 & 2 & 0 & 1 \\\\ 0 & 0 & 3 & 4\\end{array}\\right]\n$$\n\nTherefore, only $A$ is **not** in row echelon form."} {:db/id #edb/ref 17592186326923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82ceb6ee-967f-51f6-9562-a946e9616bd0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467488} {:answer/id #uuid "5a978d2b-7bde-5c45-a243-0e4e0a33fde7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467489}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467488} :answer-field/id #uuid "f80dcb05-a2c2-516d-80fe-1ab0eed4e12b" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468465} {:answer-field/choices [{:answer/id #uuid "5b08f801-3599-510d-8753-6582f23b7efe" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467490} {:answer/id #uuid "62d0a2f4-51a8-5771-9041-0b5950520f2f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467491}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467490} :answer-field/id #uuid "9d4a18d9-f146-57c1-98ce-7671782922ed" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468466} {:answer-field/choices [{:answer/id #uuid "a7ed2b63-95a4-56b7-afb2-010d21ef08ec" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467492} {:answer/id #uuid "158e4809-5e64-50a5-af3e-ca976103a4d3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467493}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467493} :answer-field/id #uuid "1bbb80cd-ffa5-5028-b638-d29609a12eae" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468467}] :question/id #uuid "324c0e93-0bc4-5958-ba8a-b87ad1b81b6a" :question/math-academy-id "q-42028" :question/problem "Which of the following augmented matrices have coefficient matrices in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=\\left[\\begin{array}{ccc|c}2 & 0 & 0 & 5 \\\\ 0 & 0 & 2 & 3 \\\\ 0 & -2 & 0 & 4\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 0 & 2 \\\\ 2 & 1 & 1 & 0 \\\\ 0 & 0 & 3 & 11\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}2 & 4 & 6 & 8 \\\\ 0 & 3 & 3 & 6 \\\\ 0 & 0 & 4 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=\\left[\\begin{array}{ccc|c}2 & 0 & 0 & 5 \\\\ 0 & 0 & 2 & 3 \\\\ 0 & -2 & 0 & 4\\end{array}\\right]\n$$\n\n- The matrix $B$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 0 & 2 \\\\ 2 & 1 & 1 & 0 \\\\ 0 & 0 & 3 & 11\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccc|c}2 & 4 & 6 & 8 \\\\ 0 & 3 & 3 & 6 \\\\ 0 & 0 & 4 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\nTherefore, only $C$ is in row echelon form."} {:db/id #edb/ref 17592186341835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7311cb50-f585-5f8b-8c7c-43ea3935ca30" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467950} {:answer/id #uuid "5df8e8f3-9308-5944-af31-4d14c71a9d43" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467951}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467950} :answer-field/id #uuid "00781771-aeb9-5835-884e-fa3c06c40e7e" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468696} {:answer-field/choices [{:answer/id #uuid "b1ee2b9e-ef1d-59cf-bd65-2b7d6a2bf08f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467952} {:answer/id #uuid "d81beee0-f7cd-5ee1-a153-c2609ec12ad8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467953}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467953} :answer-field/id #uuid "625436a2-9099-57c0-a144-3cefd737c380" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468697} {:answer-field/choices [{:answer/id #uuid "a341d39f-fed1-52da-a5bf-5551842652b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467954} {:answer/id #uuid "5061ada4-2851-5b12-9dcc-a52396a7b645" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467955}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467955} :answer-field/id #uuid "4691ceca-21a9-5d3f-be55-1f587cc36770" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468698}] :question/id #uuid "4f7d9000-6b1e-59bb-84e6-86f972afc228" :question/math-academy-id "q-72570" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{array}\\right]\n$$\n\n- The matrix $B$  is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{cccc|c}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{cccc|c}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{array}\\right]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186341837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "871c0b9a-48a3-59d8-9e1f-f4475d4555bf" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467956} {:answer/id #uuid "b4d10848-e1fa-5f39-aa0a-cc7c26df2128" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467957}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467957} :answer-field/id #uuid "61fe29b2-5b2d-5a8d-b1ba-4952d616468e" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468699} {:answer-field/choices [{:answer/id #uuid "4548ec32-611e-56d6-95ac-253399d8a77e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467958} {:answer/id #uuid "23eb05ce-32cd-5f44-bc7f-be463167a91d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467959}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467959} :answer-field/id #uuid "d56f52cb-9c78-584a-9dbb-7b23b1d89ddd" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468700} {:answer-field/choices [{:answer/id #uuid "468e9b34-a780-5fca-a56d-a2a2883f4d47" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467960} {:answer/id #uuid "a0aec6ac-9ba7-5c44-9c4a-8f2c4061212f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467961}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467960} :answer-field/id #uuid "f3a4e593-82f4-562c-a9f7-3bfab9eb0154" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468701}] :question/id #uuid "c409d434-4c7f-59fa-9d55-4c82bc621cc5" :question/math-academy-id "q-72574" :question/problem "Which of the following augmented matrices have coefficient matrices in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=\\left[\\begin{array}{cccc|c}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied). \n\n$$\nA=\\left[\\begin{array}{cccc|c}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{array}\\right]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition  II is violated).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."} {:db/id #edb/ref 17592186341838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60637292-3e09-530b-ac61-fcbbce897d41" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467962} {:answer/id #uuid "e4dad7c2-9a72-5985-95d5-14eb19840971" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467963}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467962} :answer-field/id #uuid "bf03a675-2bed-5618-b8f1-977c4c5732ba" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468702} {:answer-field/choices [{:answer/id #uuid "8421492d-9fc4-581e-9662-4c6ad1d30585" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467964} {:answer/id #uuid "57892105-0d46-58cf-b489-d7654d7df5df" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467965}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467965} :answer-field/id #uuid "ac1b36ea-8d6f-51c9-bc43-9c783cb2e595" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468703} {:answer-field/choices [{:answer/id #uuid "75ae5575-30a3-527c-957b-e31d7bd513e2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467966} {:answer/id #uuid "a5c77217-c4e4-5860-8c50-aec83eb153e4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467967}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467966} :answer-field/id #uuid "0477e48c-0ee5-5ea3-a796-a287db3e0107" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468704}] :question/id #uuid "2d3c090e-cc4f-51d5-a663-f597f7113489" :question/math-academy-id "q-72576" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{cccc|c}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{cccc|c}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition II is violated).\n\n$$\nC=\\left[\\begin{array}{ccc|c}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{array}\\right]\n$$\n\nTherefore, only $B$ is in row echelon form."} {:db/id #edb/ref 17592186400436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c63daf6f-eed4-503b-a8b2-0baf04238897" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472610} {:answer/id #uuid "8c490ab2-ec7b-5dee-94e0-ca23a50fdead" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472611}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472611} :answer-field/id #uuid "27d756e8-4693-5c8d-a097-a9d17ac33b68" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473700} {:answer-field/choices [{:answer/id #uuid "360e1f52-5cdb-5c5e-9a6d-33c968fdb021" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472612} {:answer/id #uuid "cd099e05-d512-5614-a6fc-51d408232f9d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472613}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472613} :answer-field/id #uuid "3642312c-08a2-5f05-bb3f-1054acc8e9f4" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473701} {:answer-field/choices [{:answer/id #uuid "0e87742a-dcd6-5298-bb30-ef2ace74838c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472614} {:answer/id #uuid "6e8e3db4-35ea-53de-88a3-45ed4615b36f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472615}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472614} :answer-field/id #uuid "924222e4-fc3d-551f-a6c3-451ea17542f0" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473702}] :question/id #uuid "3d92198e-4ce7-5520-a0eb-698c6d6eae5d" :question/math-academy-id "q-129231" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=\\left[\\begin{array}{cc|c}2 & 0 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 7 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}5 & 0 & 2 & 3 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{cccc|c}1 & -5 & 0 & 1 & 2 \\\\ 0 & 0 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 1 & -2\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\left[\\begin{array}{cc|c}2 & 0 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 7 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{33}\\ne 0$ (condition II is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}5 & 0 & 2 & 3 \\\\ 0 & 0 & -1 & -3 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{cccc|c}1 & -5 & 0 & 1 & 2 \\\\ 0 & 0 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nTherefore, only $A$ and $B$ are **not** in row echelon form."} {:db/id #edb/ref 17592186405146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeca3672-af73-5de4-ae92-8d2b7267905b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302} {:answer/id #uuid "3762310e-4280-5383-a623-be69110b6dd6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473303}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473302} :answer-field/id #uuid "7b242a5e-e0c2-5c98-9faf-9932a432bab4" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474046} {:answer-field/choices [{:answer/id #uuid "c468a92d-1de4-54b3-98e3-28167311714f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473304} {:answer/id #uuid "cc55be58-e4c5-5d28-bde2-dd07f224de99" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473305} :answer-field/id #uuid "aa9139c6-224d-5848-a9fd-c41516bf7428" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474047} {:answer-field/choices [{:answer/id #uuid "61bba97e-fa99-5844-b1d0-4a1ac0911bd8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306} {:answer/id #uuid "27aa4326-84a9-502a-8ac6-38a05b1d7790" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473307}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473306} :answer-field/id #uuid "17d4295d-6d7f-5bde-a6ed-7e5d41c2a614" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474048}] :question/id #uuid "bbb2727c-01c4-5345-9e38-1d38c7fb43da" :question/math-academy-id "q-72575" :question/problem "Which of the following augmented matrices have coefficient matrices that are **not** in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "A coefficient matrix, obtained by omitting the final column of its augmented matrix, is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The coefficient matrix of $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]\n$$\n\n- The coefficient matrix of $B$ is not in row echelon form since the leading entries of its first two rows are in columns $3$ and $2,$ respectively (condition II is violated).\n\n$$\nB=\\left[\\begin{array}{ccc|c}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{array}\\right]\n$$\n\n- The coefficient matrix of $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccccc|c}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{array}\\right]\n$$\n\nTherefore, only $B$ has a coefficient matrix that is **not** in row echelon form."} {:db/id #edb/ref 17592186413825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff7ff1b-7d10-5900-8b02-8d8762f4648a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472604} {:answer/id #uuid "2a735909-2afd-58c0-8065-6f9b0fda657e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472605}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472604} :answer-field/id #uuid "f09fe1a5-baa2-5973-acbf-a84cc0ff0a30" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473697} {:answer-field/choices [{:answer/id #uuid "9738a799-c696-51e8-87a0-1ab427da9e38" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472606} {:answer/id #uuid "af5402ff-243c-585f-b25c-a8687187c616" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472607}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472607} :answer-field/id #uuid "1021401d-9baa-5256-9d91-aea06ee1499d" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473698} {:answer-field/choices [{:answer/id #uuid "2b14007f-a781-5311-9863-6ad6959abeb4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472608} {:answer/id #uuid "d335439c-9eef-5cb8-852d-d00750680628" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472609}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472609} :answer-field/id #uuid "05c9c089-5c63-5c77-b946-3743f2d68ce2" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473699}] :question/id #uuid "a0f43991-a609-584a-a820-e263b283da38" :question/math-academy-id "q-129230" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=\\left[\\begin{array}{cccc|c}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{array}\\right]\n$$\n\n$$\nB=\\left[\\begin{array}{ccc|c}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right]\n$$\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\nSelect all that apply." :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{33}\\ne 0$ (condition II is violated).\n\n$$\nA=\\left[\\begin{array}{cccc|c}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{array}\\right]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\left[\\begin{array}{ccc|c}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{array}\\right]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\left[\\begin{array}{ccc|c}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186562460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169330b3-a5a9-50cf-8927-8ae4c6d4aeae" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186561650} {:answer/id #uuid "2b54493c-fa9a-5228-8f9b-68c11b7cf221" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186561695} {:answer/id #uuid "a080b17e-4e2d-54da-92c2-40be856e3274" :answer/type {:db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186561979} {:answer/id #uuid "b7366b63-a649-59b0-888b-7907b9b8b096" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186562041} {:answer/id #uuid "cfdddba8-fb32-5bf2-b3b4-f650a90e3cc8" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186562101}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186561650} :answer-field/id #uuid "1d62adbf-0459-5820-8fa0-a7841bbccfe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562238}] :question/id #uuid "8c255e7b-6073-553e-b21f-a2db012d4100" :question/math-academy-id "q-129227" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 0 & 9 & 2 \\\\ 0 & -2 & 0 & 7 \\\\ 0 & 0 & 5 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}8 & 0 & 7 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -9 & 0 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & -5 & 0 & 3 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 9\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n\nII. Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}1 & 0 & 9 & 2 \\\\ 0 & -2 & 0 & 7 \\\\ 0 & 0 & 5 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=[\\begin{aligned}9 & 0 & 7 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -9 & 0 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}0 & -5 & 0 & 3 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 9\\end{aligned}]\n$$\n\nTherefore, only $A$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186562495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b5e72d6-9dbf-5ab5-9365-8eb27dca3a1a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186561657} {:answer/id #uuid "7f0d3815-ede6-58b8-a13e-8588a1a8e0a4" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186561900} {:answer/id #uuid "b92d438c-61eb-560c-9363-f360f2b80ed8" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186562053} {:answer/id #uuid "ba7e9e6d-1cee-5668-ae30-b321eba65a62" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186562060} {:answer/id #uuid "c7faa21f-f350-5702-9a56-819a87b6925f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186562079}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186562053} :answer-field/id #uuid "236a504e-8f19-5df0-8dfa-85261f005266" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562243}] :question/id #uuid "cb5f09b3-31c5-57e5-86f3-885997d34e19" :question/math-academy-id "q-72573" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}2 & 5 & 0 & 5 \\\\ 0 & 3 & -1 & 6 \\\\ 0 & -3 & 2 & 7 \\\\ 0 & 0 & 0 & 5\\end{aligned}],\\,B=[\\begin{aligned}0 & 3 & 5 & 0 & 7 \\\\ 0 & 0 & -3 & 2 & 5 \\\\ 0 & 0 & 0 & 1 & 2\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 0 & 2 \\\\ 0 & 2 & 3 & 4 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition  II is violated). \n\n$$\nA=[\\begin{aligned}2 & 5 & 0 & 5 \\\\ 0 & 3 & -1 & 6 \\\\ 0 & -3 & 2 & 7 \\\\ 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}0 & 3 & 5 & 0 & 7 \\\\ 0 & 0 & -3 & 2 & 5 \\\\ 0 & 0 & 0 & 1 & 2\\end{aligned}].\n$$\n\n- The matrix $C$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=[\\begin{aligned}0 & 0 & 0 & 2 \\\\ 0 & 2 & 3 & 4 \\\\ 0 & 0 & 1 & 1\\end{aligned}]\n$$\n\nTherefore, only $A$ and $C$ are **not** in row echelon form."} {:db/id #edb/ref 17592186562509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c34decf-a1b1-5a88-b544-aa5dd1001a9a" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186561776} {:answer/id #uuid "64856378-00d4-5517-8743-3e522bc9f454" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186561829} {:answer/id #uuid "bd51f8ca-e583-55f1-a43f-48431787966c" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186562065} {:answer/id #uuid "e7ddb617-332b-5471-91ae-427909ab23c5" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186562152} {:answer/id #uuid "ef92d1b4-ef4c-57b6-85f2-6a56f09b1137" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186562179}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186562179} :answer-field/id #uuid "8bae8c39-2956-5222-943a-49de2d2bc282" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562314}] :question/id #uuid "f0c60384-ef9e-589b-b228-2de7e1393ace" :question/math-academy-id "q-42007" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & -1 & 4\\end{aligned}],\\,B=[\\begin{aligned}-2 & 0 & 0 & 5 \\\\ 0 & 0 & 3 & 7 \\\\ 0 & 4 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 0 & 2 \\\\ 5 & 3 & 7 & 0 \\\\ 0 & 0 & 6 & 8\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & -1 & 4\\end{aligned}].\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{32}\\ne 0$ (condition II is violated).\n\n$$\nB=[\\begin{aligned}-2 & 0 & 0 & 5 \\\\ 0 & 0 & 3 & 7 \\\\ 0 & 4 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=[\\begin{aligned}0 & 0 & 0 & 2 \\\\ 5 & 3 & 7 & 0 \\\\ 0 & 0 & 6 & 8\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form."}] :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"} {:db/id #edb/ref 17592186129114 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128926 :question/id #uuid "b6e4983b-c695-5944-9637-6d7547dae849" :question/math-academy-id "e-4688" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA= \\begin{bmatrix}2 & 1 \\\\ 0 & 0 \\\\ 0 & 3\\end{bmatrix}\n$$\n\n$$\nB= \\begin{bmatrix}0 & 2 & 7 & 10 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n$$\nC= \\begin{bmatrix}2 & 0 & 0 & 0 & 4 & 6 \\\\ 0 & 0 & 3 & 3 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 4 & 8\\end{bmatrix}.\n$$\n\n" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA= \\begin{bmatrix}\\bbox[lightgray, 2pt]{2} & 1 \\\\ {\\color{red}0} & {\\color{red}0} \\\\ 0 & \\bbox[lightgray, 2pt]{3}\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB= \\begin{bmatrix}{\\color{blue}0} & \\bbox[lightgray, 2pt]{2} & 7 & 10 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0}\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC= \\begin{bmatrix}\\bbox[lightgray, 2pt]{2} & 0 & 0 & 0 & 4 & 6 \\\\ {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{3} & 3 & 6 & 0 \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & {\\color{blue}0} & \\bbox[lightgray, 2pt]{4} & 8\\end{bmatrix}\n$$\n\n"} :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/question-generator {:db/id #edb/ref 17592186524361 :question-generator/id #uuid "29329e86-4993-5ad8-9aa4-862d9e561631" :question-generator/script "generate/scratch/17592186129114.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186129773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836635cc-25da-5e83-aec4-49f375758900" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459957} {:answer/id #uuid "54eea2b5-b542-5880-be19-6f511782168a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459958}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459957} :answer-field/id #uuid "04197247-7f0f-56bf-a021-b95053e007e5" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460845} {:answer-field/choices [{:answer/id #uuid "29bb0349-8228-5739-b584-2b4184c57825" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459959} {:answer/id #uuid "213dd0db-1f16-57b8-a75a-94405f576b31" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459960}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459960} :answer-field/id #uuid "c199