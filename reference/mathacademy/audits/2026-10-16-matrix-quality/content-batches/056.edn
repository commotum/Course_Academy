#{[{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186060653} :activity/id #uuid "612e71dc-2353-5b59-a212-aebdcbeaaba9" :activity/steps [{:db/id #edb/ref 17592186060653 :step/content {:db/id #edb/ref 17592186060932 :tutorial/content "The **minor** of the entry $a_{ij}$ in a matrix $A$ is the determinant of the remaining entries when the row and column containing $a_{ij}$ are removed.\n\nFor instance, suppose we want to find the minor of $a_{{\\color{red}1}{\\color{blue}2}} = {\\bbox[lightgray, 2pt]{-1}}$ (row ${\\color{red}1}$, column ${\\color{blue}2}$) in the matrix $A$ given by\n\n$$\n\\begin{bmatrix}3 & -1 & 6 \\\\ 5 & 2 & 7 \\\\ 8 & 9 & 4\\end{bmatrix}\n$$\n\nTo find the minor, we exclude all entries in row $1$ and all entries in column $2\\mathbin{:}$\n\n$$\n\\begin{bmatrix}\\cancel{3} & -1 & \\cancel{6} \\\\ 5 & \\cancel{2} & 7 \\\\ 8 & \\cancel{9} & 4\\end{bmatrix}\n$$\n\nThis leaves us with the $2\\times 2$ determinant given by\n\n$$\n\\begin{aligned}5 & 7 \\\\ 8 & 4\\end{aligned}\n$$\n\nWe call it $M_{{\\color{red}{1}}{\\color{blue}{2}}}$ to denote the fact that it was obtained by deleting row $\\color{red}1$ and column $\\color{blue}2$ of the matrix $A.$\n\nFinally, we compute the above determinant:\n\n$$\n\\begin{aligned}\\begin{vmatrix}5 & 7 \\\\ 8 & 4\\end{vmatrix} & =5\\cdot 4-7\\cdot 8 \\\\  & =20-56 \\\\  & =-36\\end{aligned}\n$$" :tutorial/id #uuid "5e944747-8958-504d-9936-8fbe3778db4e" :tutorial/math-academy-id 3016 :tutorial/title "Introduction"} :step/id #uuid "70e864c2-9eed-532a-947d-22758c659e30" :step/next {:db/id #edb/ref 17592186060654}} {:db/id #edb/ref 17592186060654 :step/content {:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975"} :step/id #uuid "0032f69b-69ec-5e86-8460-da5b2a9d7497" :step/next {:db/id #edb/ref 17592186060655}} {:db/id #edb/ref 17592186060655 :step/content {:db/id #edb/ref 17592186059752 :knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"} :step/id #uuid "1801398b-1db9-5915-8dbe-c5cacfd2d213" :step/next {:db/id #edb/ref 17592186060656}} {:db/id #edb/ref 17592186060656 :step/content {:db/id #edb/ref 17592186059753 :knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"} :step/id #uuid "02c536de-a3e1-5498-9be5-96c27615ce8d"}] :activity/title "The Minors of a 3x3 Matrix" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186059913}] :db/id #edb/ref 17592186048965 :topic/knowledge-points [{:db/id #edb/ref 17592186059751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059560 :question/id #uuid "79841c0d-e191-566b-8fe2-63828dcfc23a" :question/math-academy-id "e-4439" :question/problem "Calculate the minor of the entry $b_{21}$ in the matrix\n![](images/8e/8e664813c6467d5bb06a8eb1e1d68778d3142479939624a7a46674f593d786b9.png)" :question/worked-solution "The minor of $b_{21} = 3$ (second row, first column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n![](images/a6/a69955fcba387ef3c65f1c1529c2007d8d70f82d95738af9b995999a21198730.png)\n\nSo, the minor of $b_{21}=3$ is\n\n$$\n\\begin{aligned}det\\begin{bmatrix}1 & 5 \\\\ 7 & 2\\end{bmatrix} & =\\begin{vmatrix}1 & 5 \\\\ 7 & 2\\end{vmatrix} \\\\  & =1\\cdot 2-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33.\\end{aligned}\n$$"} :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/questions [{:db/id #edb/ref 17592186059985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859306a3-7a57-58d1-b2a6-6a2846e9a8e5" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186056269} {:answer/id #uuid "b3592d91-6f11-5b04-b047-2eebf6efdcc4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186056270} {:answer/id #uuid "184c9b4c-08e0-52c0-bc9a-218420facb1a" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186056271} {:answer/id #uuid "6a4281a3-b2d1-583d-ad5c-287e94532ad4" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186056272} {:answer/id #uuid "7321d9b7-3d15-5644-a995-3833498e9379" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186056273}] :answer-field/id #uuid "85bfe885-87d6-5d4b-889a-3c32116b4a4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056268}] :question/id #uuid "6dc1aa6e-b109-507f-8a28-6841e5368ff1" :question/math-academy-id "q-1090" :question/problem "Calculate the minor of the entry $a_{23}$ in the matrix\n$A = \\begin{bmatrix}1 & 2 & 7 \\\\ -6 & 0 & 4 \\\\ 12 & 3 & 5\\end{bmatrix}$."} {:db/id #edb/ref 17592186059987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3483de1a-1f65-5553-adea-5c1f86b3e57c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186241641} {:answer/id #uuid "5eee975d-4bfb-507e-be00-76be487d029e" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186242033} {:answer/id #uuid "6b31fbe0-f8ff-5f08-9a26-caf4d911af3f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186242143} {:answer/id #uuid "a528f703-fb11-59ec-ad99-43d1904c252b" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186242634} {:answer/id #uuid "f3a4905a-bcb6-5d72-aad1-aa967ac93c4e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243339}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186242033} :answer-field/id #uuid "23210561-cf23-5be2-bbb6-5445ea1b8741" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243505}] :question/id #uuid "367551dc-32de-5040-981b-1232c513fd73" :question/math-academy-id "q-1094" :question/problem "Calculate the minor of the entry ${y}_{13}$ in the matrix\n$Y=\\begin{bmatrix}15 & 8 & 9 \\\\ 7 & 1 & 2 \\\\ 0 & -1 & 2\\end{bmatrix}.$" :question/worked-solution "The minor of ${y}_{13}=9$ (first row, third column) is the determinant of the remaining entries when the column and row containing $9$ are removed: \n\n$$\nY=\\begin{bmatrix}∗ & ∗ & 9 \\\\ 7 & 1 & ∗ \\\\ 0 & -1 & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${y}_{13}=9$ is\n\n$$\n\\begin{aligned}det\\begin{bmatrix}7 & 1 \\\\ 0 & -1\\end{bmatrix} & =\\begin{vmatrix}7 & 1 \\\\ 0 & -1\\end{vmatrix} \\\\  & =7\\cdot (-1)-1\\cdot 0 \\\\  & =-7-0 \\\\  & =-7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6190a35b-2fa3-5b2d-ab54-178a6e20811b" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186260714} {:answer/id #uuid "6dc693d2-4db1-5fd6-b9b6-22bb05fbec72" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186260839} {:answer/id #uuid "8978e966-e1fd-50a4-a089-af279c9056ef" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186261075} {:answer/id #uuid "cc15cbe6-64fd-55ce-81d4-047ec5b09252" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186261674} {:answer/id #uuid "f03f53fb-b697-5398-b735-3f599c2dc985" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186261982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186260839} :answer-field/id #uuid "2ff61899-6231-5664-8fc7-0ff170215880" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262208}] :question/id #uuid "9871bcc9-88b5-50b7-98d4-a2ae0f511f1a" :question/math-academy-id "q-127701" :question/problem "Calculate the minor of the entry ${p}_{32}$ in the matrix\n$P=\\begin{bmatrix}8 & 8 & 4 \\\\ -5 & 4 & 6 \\\\ 10 & 3 & 0\\end{bmatrix}.$" :question/worked-solution "The minor of ${p}_{32}=3$ (third row, second column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\nP=\\begin{bmatrix}8 & ∗ & 4 \\\\ -5 & ∗ & 6 \\\\ ∗ & 3 & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${p}_{32}=3$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}8 & 4 \\\\ -5 & 6\\end{bmatrix} & =\\begin{vmatrix}8 & 4 \\\\ -5 & 6\\end{vmatrix} \\\\  & =8\\cdot 6-4\\cdot (-5) \\\\  & =48+20 \\\\  & =68.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a5c220-8bb4-5d90-96d5-a3289aaa3fe5" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186241806} {:answer/id #uuid "723b864a-b21a-5740-935e-36c4d2fd1371" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186242192} {:answer/id #uuid "84760970-9daa-5581-a617-c92ddc0d5e96" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186242339} {:answer/id #uuid "b1078590-db32-5bf5-a0d2-0868f68eb185" :answer/type {:db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186242721} {:answer/id #uuid "e3c626cd-177c-5211-a76a-27d448efdb4d" :answer/type {:db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186243209}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186241806} :answer-field/id #uuid "f7e9dd1b-0004-5244-841f-6b5ebc608972" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243871}] :question/id #uuid "e8368bac-9938-5997-ba50-764e8ba7ddb9" :question/math-academy-id "q-1091" :question/problem "Calculate the minor of the entry ${x}_{21}$ in the matrix\n$X=\\begin{bmatrix}9 & -3 & 0 \\\\ -2 & 8 & 6 \\\\ -1 & 0 & 11\\end{bmatrix}.$" :question/worked-solution "The minor of ${x}_{21}=-2$ (second row, first column) is the determinant of the remaining entries when the column and row containing $-2$ are removed: \n\n$$\nX=\\begin{bmatrix}∗ & -3 & 0 \\\\ -2 & ∗ & ∗ \\\\ ∗ & 0 & 11\\end{bmatrix}\n$$\n\nSo, the minor of ${x}_{21}=-2$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}-3 & 0 \\\\ 0 & 11\\end{bmatrix} & =\\begin{vmatrix}-3 & 0 \\\\ 0 & 11\\end{vmatrix} \\\\  & =-3\\cdot 11-0\\cdot 0 \\\\  & =-33-0 \\\\  & =-33.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9ee733-0369-5383-98cf-d57199634ade" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241275} {:answer/id #uuid "40bf570b-0c28-5b93-a302-1dc3fb653a1d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186241758} {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} {:answer/id #uuid "942ccf7d-5d78-5f28-9073-6d9a3b731eee" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186242480} {:answer/id #uuid "abbf1cc6-5ea9-587f-9f60-4f1101db2fc6" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186242680}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} :answer-field/id #uuid "783ab98e-8260-54c9-b8b7-0c860e9b9a51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243670}] :question/id #uuid "926e7b3c-e48b-52a2-9640-544759dee372" :question/math-academy-id "q-1092" :question/problem "Calculate the minor of the entry ${b}_{22}$ in the matrix\n$B=\\begin{bmatrix}3 & 13 & -6 \\\\ 2 & 7 & 0 \\\\ 5 & 0 & 4\\end{bmatrix}.$" :question/worked-solution "The minor of ${b}_{22}=7$ (second row, second column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nB=\\begin{bmatrix}3 & ∗ & -6 \\\\ ∗ & 7 & ∗ \\\\ 5 & ∗ & 4\\end{bmatrix}\n$$\n\n \n\nSo, the minor of ${b}_{22}=7$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}3 & -6 \\\\ 5 & 4\\end{bmatrix} & =\\begin{vmatrix}3 & -6 \\\\ 5 & 4\\end{vmatrix} \\\\  & =3\\cdot 4-(-6)\\cdot 5 \\\\  & =12-(-30) \\\\  & =42.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636ff5-4f35-59c1-b18c-e16065a8de57" :answer/type {:db/ident :answer.type/math} :answer/value "285" :db/id #edb/ref 17592186260398} {:answer/id #uuid "3b101735-5ca3-53b0-867b-b2b4a99e6954" :answer/type {:db/ident :answer.type/math} :answer/value "-270" :db/id #edb/ref 17592186260404} {:answer/id #uuid "6557654c-adbc-567f-9ed2-0b6241b1c36e" :answer/type {:db/ident :answer.type/math} :answer/value "345" :db/id #edb/ref 17592186260753} {:answer/id #uuid "68a40190-a35e-5d5e-99d7-68943acd8316" :answer/type {:db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186260789} {:answer/id #uuid "afbb5872-6868-51a1-9d55-d3cff7bb9d1b" :answer/type {:db/ident :answer.type/math} :answer/value "225" :db/id #edb/ref 17592186261426}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186260789} :answer-field/id #uuid "a92f08f7-6487-5f3b-bb5d-cbceff0919ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262426}] :question/id #uuid "a621bb9c-ea55-573d-8770-6ecb74ad88cd" :question/math-academy-id "q-127698" :question/problem "Calculate the minor of the entry ${d}_{23}$ in the matrix\n$D=\\begin{bmatrix}10 & 2 & 5 \\\\ -12 & 44 & -33 \\\\ 25 & 30 & 41\\end{bmatrix}.$" :question/worked-solution "The minor of ${d}_{23}=-33$ (second row, third column) is the determinant of the remaining entries when the column and row containing $-33$ are removed: \n\n$$\nD=\\begin{bmatrix}10 & 2 & ∗ \\\\ ∗ & ∗ & -33 \\\\ 25 & 30 & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${d}_{23}=-33$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}10 & 2 \\\\ 25 & 30\\end{bmatrix} & =\\begin{vmatrix}10 & 2 \\\\ 25 & 30\\end{vmatrix} \\\\  & =10\\cdot 30-2\\cdot 25 \\\\  & =300-50 \\\\  & =250.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c83b93c-d5d3-5670-85e5-ce204fbfa09f" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186260274} {:answer/id #uuid "6405f9d6-20e5-5f52-bf77-0b4ff653867b" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260739} {:answer/id #uuid "d954b90a-53e0-55f6-bc1e-2c870d81b850" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261793} {:answer/id #uuid "fccbedfb-654f-537e-b958-32c45bb0f7b6" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186262086} {:answer/id #uuid "fd4caae4-99c0-5299-8de6-d1370daac935" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186262094}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186260274} :answer-field/id #uuid "726cb985-ea64-5546-bcdf-8d29c7507387" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262315}] :question/id #uuid "e6b3d7cf-2cb2-50b5-b1d2-b03ab67b5161" :question/math-academy-id "q-127699" :question/problem "Calculate the minor of the entry ${p}_{31}$ in the matrix\n$P=\\begin{bmatrix}-11 & 7 & -9 \\\\ 2 & -2 & 9 \\\\ 8 & -5 & 72\\end{bmatrix}.$" :question/worked-solution "The minor of ${p}_{31}=8$ (third row, first column) is the determinant of the remaining entries when the column and row containing $8$ are removed: \n\n$$\nP=\\begin{bmatrix}∗ & 7 & -9 \\\\ ∗ & -2 & 9 \\\\ 8 & ∗ & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${p}_{31}=8$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}7 & -9 \\\\ -2 & 9\\end{bmatrix} & =\\begin{vmatrix}7 & -9 \\\\ -2 & 9\\end{vmatrix} \\\\  & =7\\cdot 9-(-9)\\cdot (-2) \\\\  & =63-18 \\\\  & =45.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffa4c354-d770-5b69-86de-52f512cf79a5" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298647}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186298647} :answer-field/id #uuid "d8e329c4-6ce9-593b-8f8e-9b35d86d51ec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299374}] :question/id #uuid "a4d76484-1456-5ead-bf44-7be5d6d9eb41" :question/math-academy-id "q-319096" :question/problem "For the matrix\n$B=\\begin{bmatrix}2 & 5 & -3 \\\\ 1 & -1 & 4 \\\\ 0 & 2 & 6\\end{bmatrix},$\nfind the minor ${M}_{33}$ of the entry ${b}_{33}.$\n\n${M}_{33}=${{field-1}}" :question/worked-solution "The minor of ${b}_{33}=6$ (third row, third column) is the determinant of the remaining entries when the column and row containing $6$ are removed: \n\n$$\nB=\\begin{bmatrix}2 & 5 & ∗ \\\\ 1 & -1 & ∗ \\\\ ∗ & ∗ & 6\\end{bmatrix}\n$$\n\nSo, the minor of ${b}_{33}=6$ is\n\n$$\n\\begin{aligned}{M}_{33} & =\\text{det}\\begin{bmatrix}2 & 5 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}2 & 5 \\\\ 1 & -1\\end{vmatrix} \\\\  & =2\\cdot (-1)-5\\cdot 1 \\\\  & =-2-5 \\\\  & =-7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4da9fd5-a518-5670-b8e4-d1f0891d32c7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298535}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186298535} :answer-field/id #uuid "5c1d0de4-0da3-5a57-aab7-eeb3daea795f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298952}] :question/id #uuid "d1b6b7aa-d6db-544a-a7e4-3d6fdf2e3d25" :question/math-academy-id "q-319106" :question/problem "For the matrix\n$A=\\begin{bmatrix}2 & -4 & 3 \\\\ 5 & 1 & -1 \\\\ 0 & 6 & 2\\end{bmatrix}.$\nfind the minor ${M}_{23}$ of the entry ${a}_{23}.$\n\n${M}_{23}=${{field-1}}" :question/worked-solution "The minor of ${a}_{23}=-1$ (second row, third column) is the determinant of the remaining entries when the column and row containing $-1$ are removed: \n\n$$\nA=\\begin{bmatrix}2 & -4 & ∗ \\\\ ∗ & ∗ & -1 \\\\ 0 & 6 & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${a}_{23}=-1$ is\n\n$$\n\\begin{aligned}{M}_{23} & =\\text{det}\\begin{bmatrix}2 & -4 \\\\ 0 & 6\\end{bmatrix} \\\\  & =\\begin{vmatrix}2 & -4 \\\\ 0 & 6\\end{vmatrix} \\\\  & =2\\cdot 6-(-4)\\cdot 0 \\\\  & =12-0 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf69dbf9-efd4-51f9-9954-c4db6fab1663" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186298455}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186298455} :answer-field/id #uuid "4896e653-b349-502a-b667-684ec60a4f9d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298884}] :question/id #uuid "5fa10b30-a8e5-5b72-a911-9d9131cdfbe9" :question/math-academy-id "q-319108" :question/problem "For the matrix\n$B=\\begin{bmatrix}1 & 2 & -3 \\\\ 4 & 0 & 5 \\\\ 7 & -2 & 6\\end{bmatrix}.$\nfind the minor ${M}_{22}$ of the entry ${b}_{22}.$\n\n${M}_{22}=${{field-1}}" :question/worked-solution "The minor of ${b}_{22}=0$ (second row, second column) is the determinant of the remaining entries when the column and row containing $0$ are removed: \n\n$$\nB=\\begin{bmatrix}1 & ∗ & -3 \\\\ ∗ & 0 & ∗ \\\\ 7 & ∗ & 6\\end{bmatrix}\n$$\n\nSo, the minor of ${b}_{22}=0$ is\n\n$$\n\\begin{aligned}{M}_{22} & =\\text{det}\\begin{bmatrix}1 & -3 \\\\ 7 & 6\\end{bmatrix} \\\\  & =\\begin{vmatrix}1 & -3 \\\\ 7 & 6\\end{vmatrix} \\\\  & =1\\cdot 6-(-3)\\cdot 7 \\\\  & =6-(-21) \\\\  & =6+21 \\\\  & =27.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95507a64-7432-53f4-b5d1-87b72690ce09" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298197}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298197} :answer-field/id #uuid "13ffcf50-a21c-56ee-aaed-3b0fd2491946" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298712}] :question/id #uuid "e7442c9a-a470-54c9-860d-582e8bf8b044" :question/math-academy-id "q-319110" :question/problem "For the matrix\n$Y=\\begin{bmatrix}1 & -2 & 5 \\\\ 3 & 4 & 0 \\\\ 6 & -1 & 2\\end{bmatrix}.$\nfind the minor ${M}_{32}$ of the entry ${y}_{32}.$\n\n${M}_{32}=${{field-1}}" :question/worked-solution "The minor of ${y}_{32}=-1$ (third row, second column) is the determinant of the remaining entries when the column and row containing $-1$ are removed: \n\n$$\nY=\\begin{bmatrix}1 & ∗ & 5 \\\\ 3 & ∗ & 0 \\\\ ∗ & -1 & ∗\\end{bmatrix}\n$$\n\nSo, the minor of ${y}_{32}=-1$ is\n\n$$\n\\begin{aligned}{M}_{32} & =\\text{det}\\begin{bmatrix}1 & 5 \\\\ 3 & 0\\end{bmatrix} \\\\  & =\\begin{vmatrix}1 & 5 \\\\ 3 & 0\\end{vmatrix} \\\\  & =(1)\\cdot 0-3\\cdot 5 \\\\  & =0-15 \\\\  & =-15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "562f1dd1-500e-5034-8df3-58d12f15f220" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186297915}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186297915} :answer-field/id #uuid "3f7a1793-48f8-5e1a-8313-658bcd8a2625" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298856}] :question/id #uuid "e2f57b6a-47bc-534b-a9f4-6e1be4a28e53" :question/math-academy-id "q-319112" :question/problem "For the matrix\n$C=\\begin{bmatrix}5 & 2 & -1 \\\\ 0 & 3 & 4 \\\\ 7 & -2 & 6\\end{bmatrix}.$\nfind the minor ${M}_{12}$ of the entry ${c}_{12}.$\n\n${M}_{12}=${{field-1}}" :question/worked-solution "The minor of ${c}_{12}=2$ (first row, second column) is the determinant of the remaining entries when the column and row containing $2$ are removed: \n\n$$\nC=\\begin{bmatrix}∗ & 2 & ∗ \\\\ 0 & ∗ & 4 \\\\ 7 & ∗ & 6\\end{bmatrix}\n$$\n\nSo, the minor of ${c}_{12}=2$ is\n\n$$\n\\begin{aligned}{M}_{12} & =\\text{det}\\begin{bmatrix}0 & 4 \\\\ 7 & 6\\end{bmatrix} \\\\  & =\\begin{vmatrix}0 & 4 \\\\ 7 & 6\\end{vmatrix} \\\\  & =0\\cdot 6-4\\cdot 7 \\\\  & =0-28 \\\\  & =-28.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0997f234-0a40-5c61-b6fb-311f05487fc6" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186333077} {:answer/id #uuid "19b573c9-c016-5b8b-a05d-52b136d20de2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333226} {:answer/id #uuid "790045ad-4df1-569d-a7f0-cfe72c78618d" :answer/type {:db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186334074} {:answer/id #uuid "a1e86d6c-edd0-552a-9459-55d42c613620" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186334411} {:answer/id #uuid "f1a13405-9afe-5534-978a-93826c7e5899" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186335107}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186333226} :answer-field/id #uuid "2512283c-5d9b-56e8-ae99-b37e2c9f3d52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335307}] :question/id #uuid "7d92e738-19d1-5e24-b2a0-72ff3b0a1f80" :question/math-academy-id "q-69858" :question/problem "Calculate the minor of the entry ${d}_{33}$ in the matrix\n$D=\\begin{bmatrix}3 & -2 & 4 \\\\ 4 & -1 & 54 \\\\ 11 & 6 & 7\\end{bmatrix}.$" :question/worked-solution "The minor of ${d}_{33}=7$ (third row, third column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nD=\\begin{bmatrix}3 & -2 & ∗ \\\\ 4 & -1 & ∗ \\\\ ∗ & ∗ & 7\\end{bmatrix}\n$$\n\nSo, the minor of ${d}_{33}=7$ is\n\n$$\n\\begin{aligned}\\text{det}\\begin{bmatrix}3 & -2 \\\\ 4 & -1\\end{bmatrix} & =\\begin{vmatrix}3 & -2 \\\\ 4 & -1\\end{vmatrix} \\\\  & =3\\cdot (-1)-(-2)\\cdot 4 \\\\  & =-3-(-8) \\\\  & =5.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"} {:db/id #edb/ref 17592186059752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059561 :question/id #uuid "51f60726-3d12-507e-b942-5d316fc28bd0" :question/math-academy-id "e-4440" :question/problem "What is the minor of $c_{22}$ in the matrix\n![](images/14/1449dfd139653f75de7be2e27e86f0c9d2d8a5a17e25ae184b892f489ffbb71e.png)" :question/worked-solution "First, we remove the second row and second column: \n\n![](images/09/09bd73c7e51abcad8efa354317519a2687601b3ccdbfea0ac2b6222f75b3397e.png)\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}7x & -3y \\\\ -y & 5\\end{bmatrix} & =\\begin{vmatrix}7x & -3y \\\\ -y & 5\\end{vmatrix} \\\\  & =7x\\cdot 5-(-3y)\\cdot (-y) \\\\  & =35x-3{y}^{2}\\end{aligned}\n$$"} :knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/questions [{:db/id #edb/ref 17592186059988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8e25ba-a316-557a-8f00-6b15de2a1e60" :answer/type {:db/ident :answer.type/math} :answer/value "-{b}^{2}-2ac" :db/id #edb/ref 17592186244581} {:answer/id #uuid "2d084569-d649-55d7-998a-14ff921b065c" :answer/type {:db/ident :answer.type/math} :answer/value "-3ab" :db/id #edb/ref 17592186244717} {:answer/id #uuid "a5dc7d96-5629-5635-8667-1ca638707420" :answer/type {:db/ident :answer.type/math} :answer/value "6ac-{b}^{c}2" :db/id #edb/ref 17592186245800} {:answer/id #uuid "da05ce6c-a474-57df-82c6-ca0b45e15bda" :answer/type {:db/ident :answer.type/math} :answer/value "2ac-{b}^{2}" :db/id #edb/ref 17592186246252} {:answer/id #uuid "fcf23d43-52ca-5021-a484-d53ff9ba58ab" :answer/type {:db/ident :answer.type/math} :answer/value "{b}^{2}+2ac" :db/id #edb/ref 17592186246525}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-{b}^{2}-2ac" :db/id #edb/ref 17592186244581} :answer-field/id #uuid "2ba0d203-ed53-5985-a36e-5e409e4beb68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246617}] :question/id #uuid "16f02ef4-4851-5023-bd54-49a8bd7d2abc" :question/math-academy-id "q-1098" :question/problem "What is the minor of ${x}_{12}$ in the matrix\n$X=\\begin{bmatrix}6a & -3a & c \\\\ -b & {b}^{2} & -2c \\\\ -a & 0 & b\\end{bmatrix}?$" :question/worked-solution "First, we remove the first row and second column:\n\n$$\nX=\\begin{bmatrix}∗ & -3a & ∗ \\\\ -b & ∗ & -2c \\\\ -a & ∗ & b\\end{bmatrix}\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det\\begin{bmatrix}-b & -2c \\\\ -a & b\\end{bmatrix} & =\\begin{vmatrix}-b & -2c \\\\ -a & b\\end{vmatrix} \\\\  & =-b\\cdot b-(-2c)\\cdot (-a) \\\\  & =-{b}^{2}-2ac\\end{aligned}\n$$"} {:db/id #edb/ref 17592186059989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59284d45-5b23-5723-9f17-eb10e86cf6cc" :answer/type {:db/ident :answer.type/math} :answer/value "-{r}^{3}" :db/id #edb/ref 17592186245101} {:answer/id #uuid "6fc18bca-b41c-5c15-9a91-3e23676b457a" :answer/type {:db/ident :answer.type/math} :answer/value "-r-5rt" :db/id #edb/ref 17592186245309} {:answer/id #uuid "94e2bfd6-6a3f-5ae8-a19d-106b5b2093d1" :answer/type {:db/ident :an