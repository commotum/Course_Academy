i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=(-2+\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ (-2+\\text{i}){x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=1,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}1 \\\\ -2+\\text{i}\\end{bmatrix}.\n$$\n\n \n\nOn the other hand, since ${\\lambda }_{1}=-4\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the  complex conjugate of ${\\lambda }_{1}.$ Therefore, \n\n$$\n{\\lambda }_{2}=\\overset{―}{{\\lambda }_{1}}=4\\text{i}.\n$$\n\nMoreover, the corresponding eigenvector to ${\\lambda }_{2}$ is\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}1 \\\\ -2-\\text{i}\\end{bmatrix}.\n$$\n\nTherefore, we obtain\n\n$$\n\\frac{{b}_{1}{b}_{2}}{{a}_{1}{a}_{2}}=\\frac{(-2+\\text{i})(-2-\\text{i})}{(1)(1)}=5.\n$$"} {:db/id #edb/ref 17592186326748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169288be-596c-585a-9f95-6eb37c6031bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186324171} {:answer/id #uuid "2a691189-fe10-52cd-86ab-f0ee1a94efe3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324307} {:answer/id #uuid "71c83569-cccb-5b61-8d8e-d94756ea5e88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186324911} {:answer/id #uuid "8d4973fb-f2c9-522e-910b-c406d921a2d1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325171} {:answer/id #uuid "c7d925b1-ca95-52ab-b776-8c274a21b49e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{48}{25}" :db/id #edb/ref 17592186325702}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186325171} :answer-field/id #uuid "f50cdabd-af76-5dee-8a8d-495addfbc7e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326659}] :question/id #uuid "c9754e9d-8553-5a51-ab41-0078fbc73385" :question/math-academy-id "q-39189" :question/problem "Given that ${v}_{1}=\\begin{bmatrix}{a}_{1} \\\\ {b}_{1}\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}{a}_{2} \\\\ {b}_{2}\\end{bmatrix}$ are linearly independent eigenvectors of the matrix\n$A=\\begin{bmatrix}-2 & 10 \\\\ -5 & 12\\end{bmatrix},$\nwhat is the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}?$" :question/worked-solution "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}-2-\\lambda  & 10 \\\\ -5 & 12-\\lambda \\end{vmatrix} & =0 \\\\ (-2-\\lambda )(12-\\lambda )-(-5)(10) & =0 \\\\ -24+2\\lambda -12\\lambda +{\\lambda }^{2}+50 & =0 \\\\ {\\lambda }^{2}-10\\lambda +26 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{10\\pm \\sqrt{(-10)^{2}-4(1)(26)}}{2} \\\\  & =\\frac{10\\pm \\sqrt{-4}}{2(1)} \\\\  & =\\frac{10\\pm 2\\text{i}}{2} \\\\  & =5\\pm \\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =5\\pm \\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=5-\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}-2 & 10 \\\\ -5 & 12\\end{bmatrix}-\\begin{bmatrix}5-\\text{i} & 0 \\\\ 0 & 5-\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-7+\\text{i} & 10 \\\\ -5 & 7+\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(-7+\\text{i}){x}_{1}+10{x}_{2} &=0 \\\\ -5{x}_{1}+(7+\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(5-2\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the second equation, we get\n\n$$\n{x}_{1}=\\frac{1}{5}(7+\\text{i}){x}_{2}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}\\frac{1}{5}(7+\\text{i}){x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in C.\n$$\n\nSetting ${x}_{2}=5,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}7+\\text{i} \\\\ 5\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=5+\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}7-\\text{i} \\\\ 5\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(7+\\text{i})(7-\\text{i})}{(5)(5)}=2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b659fd-f6e8-5c26-9768-e4594193e5be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186349109} {:answer/id #uuid "5944c640-277a-5ce2-9c2a-2599e9812d9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186349267} {:answer/id #uuid "647f2c68-5332-5032-8326-41c2d43110f4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349369} {:answer/id #uuid "e146ee76-3720-5b10-bfcd-704e9b605e71" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186350425} {:answer/id #uuid "e97f3c4e-8306-5a70-ac8a-0d77e49615bc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186350493}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186350493} :answer-field/id #uuid "6e60be08-201f-5939-a6e3-e905771b41db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350893}] :question/id #uuid "0f9d51e4-0acf-5ee0-b7ae-a69128fd9881" :question/math-academy-id "q-81037" :question/problem "Given that ${v}_{1}=\\begin{bmatrix}{a}_{1} \\\\ {b}_{1}\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}{a}_{2} \\\\ {b}_{2}\\end{bmatrix}$ are linearly independent eigenvectors of the matrix\n$A=\\begin{bmatrix}5 & 5 \\\\ -5 & -3\\end{bmatrix},$\nwhat is the value of $\\frac{{b}_{1}{b}_{2}}{{a}_{1}{a}_{2}}?$" :question/worked-solution "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 5 \\\\ -5 & -3-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(-3-\\lambda )-(-5)(5) & =0 \\\\ -15-5\\lambda +3\\lambda +{\\lambda }^{2}+25 & =0 \\\\ {\\lambda }^{2}-2\\lambda +10 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(10)}}{2(1)} \\\\  & =\\frac{-(-2)\\pm \\sqrt{-36}}{2} \\\\  & =\\frac{2\\pm 6\\text{i}}{2} \\\\  & =1\\pm 3\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =1\\pm 3\\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=1+3\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}5 & 5 \\\\ -5 & -3\\end{bmatrix}-\\begin{bmatrix}1+3\\text{i} & 0 \\\\ 0 & 1+3\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-3\\text{i} & 5 \\\\ -5 & -4-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(4-3\\text{i}){x}_{1}+5{x}_{2} &=0 \\\\ -5{x}_{1}+(-4-3\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(1+3\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the second equation, we get\n\n$$\n{x}_{1}=\\frac{1}{5}(-4-3\\text{i}){x}_{2}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}\\frac{1}{5}(-4-3\\text{i}){x}_{2} \\\\ {x}_{2}\\end{bmatrix},\\,{x}_{2}\\in C.\n$$\n\nSetting ${x}_{2}=-5,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}4+3\\text{i} \\\\ -5\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=1-3\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}4-3\\text{i} \\\\ -5\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{b}_{1}{b}_{2}}{{a}_{1}{a}_{2}} & =\\frac{(-5)(-5)}{(4+3\\text{i})(4-3\\text{i})}=1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2186bf-8e2a-5919-9a57-038da8a95f1b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186348703} {:answer/id #uuid "26d28bf2-ab2d-51f7-8f6f-0c8c6e7be356" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186348781} {:answer/id #uuid "4c2889e3-22ba-50e5-b821-5781818d3ea5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186349144} {:answer/id #uuid "b92afd2c-cf06-5a2f-8e02-280de77a1dee" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186350088} {:answer/id #uuid "f2754a64-6295-5716-8000-3005cae0cb02" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350571}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186349144} :answer-field/id #uuid "71561c41-3170-56ee-aacf-b2d7928f8574" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350902}] :question/id #uuid "d7d8a5d1-5161-58c0-bd9b-fe0499d92ff6" :question/math-academy-id "q-81190" :question/problem "Let ${v}_{1}=\\begin{bmatrix}{a}_{1} \\\\ {b}_{1}\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}{a}_{2} \\\\ {b}_{2}\\end{bmatrix}$ be linearly independent eigenvectors of the matrix\n$A=\\begin{bmatrix}-1 & 5 \\\\ -2 & 1\\end{bmatrix}.$\nGiven that ${\\lambda }_{1}=3\\text{i}$ is an eigenvalue of $A,$ find the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}.$" :question/worked-solution "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\,{\\lambda }_{1}=3\\text{i}$ and\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}-1 & 5 \\\\ -2 & 1\\end{bmatrix}-\\begin{bmatrix}3\\text{i} & 0 \\\\ 0 & 3\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1-3\\text{i} & 5 \\\\ -2 & 1-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the homogeneous system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(-1-3\\text{i}){x}_{1}+5{x}_{2} &=0 \\\\ -2{x}_{1}+(1-3\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-3\\text{i}I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=\\frac{1}{5}(1+3\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ \\frac{1}{5}(1+3\\text{i}){x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=5,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}5 \\\\ 1+3\\text{i}\\end{bmatrix}.\n$$\n\n \n\nOn the other hand, since ${\\lambda }_{1}=3\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the  complex conjugate of ${\\lambda }_{1}.$ Therefore, \n\n$$\n{\\lambda }_{2}=\\overset{―}{{\\lambda }_{1}}=-3\\text{i}.\n$$\n\nMoreover, the corresponding eigenvector to ${\\lambda }_{2}$ is\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}5 \\\\ 1-3\\text{i}\\end{bmatrix}.\n$$\n\nTherefore, we obtain\n\n$$\n\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}=\\frac{(5)(5)}{(1+3\\text{i})(1-3\\text{i})}=\\frac{5}{2}.\n$$"} {:db/id #edb/ref 17592186351255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007c15b8-5581-5d5e-b9b9-20eee41ea6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186348458} {:answer/id #uuid "082db701-17a8-5bfd-8d51-0f9db11a73c3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186348516} {:answer/id #uuid "1b63928e-c54b-546f-a018-4d155b2013d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186348679} {:answer/id #uuid "83473f2c-636b-50f3-bc7d-a4ffeaa05151" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349648} {:answer/id #uuid "9be4dc92-527b-522b-8645-b3d9e5f62909" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186349834}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186349834} :answer-field/id #uuid "10ba579e-2517-548c-a3d7-b08e597033da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350739}] :question/id #uuid "8452eaa3-7ef9-5d96-b24f-03672a6ae137" :question/math-academy-id "q-81195" :question/problem "Given that ${v}_{1}=\\begin{bmatrix}{a}_{1} \\\\ {b}_{1}\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}{a}_{2} \\\\ {b}_{2}\\end{bmatrix}$ are linearly independent eigenvectors of the matrix\n$A=\\begin{bmatrix}7 & 5 \\\\ -4 & 3\\end{bmatrix},$\nwhat is the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}?$" :question/worked-solution "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}7-\\lambda  & 5 \\\\ -4 & 3-\\lambda \\end{vmatrix} & =0 \\\\ (7-\\lambda )(3-\\lambda )-(-4)(5) & =0 \\\\ 21-7\\lambda -3\\lambda +{\\lambda }^{2}+20 & =0 \\\\ {\\lambda }^{2}-10\\lambda +41 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{10\\pm \\sqrt{(-10)^{2}-4(1)(41)}}{2(1)} \\\\  & =\\frac{10\\pm \\sqrt{-64}}{2} \\\\  & =\\frac{10\\pm 8\\text{i}}{2} \\\\  & =5\\pm 4\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =5\\pm 4\\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=5+4\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}7 & 5 \\\\ -4 & 3\\end{bmatrix}-\\begin{bmatrix}5+4\\text{i} & 0 \\\\ 0 & 5+4\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-4\\text{i} & 5 \\\\ -4 & -2-4\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}(2-4\\text{i}){x}_{1}+5{x}_{2} &=0 \\\\ -4{x}_{1}+(-2-4\\text{i}){x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(5+4\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=(-\\frac{2}{5}+\\frac{4}{5}\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ (-\\frac{2}{5}+\\frac{4}{5}\\text{i}){x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=5,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}5 \\\\ -2+4\\text{i}\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=5-4\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}5 \\\\ -2-4\\text{i}\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(5)(5)}{(-2+4\\text{i})(-2-4\\text{i})}=\\frac{5}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44822bc9-7e2e-562f-8058-69dd90f154f9" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186375434} {:answer/id #uuid "a23d0c6f-90ba-502d-a418-481551cb71d3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186375435} {:answer/id #uuid "2c6d2e82-738d-5ce3-88ff-93e32f533bd2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375436} {:answer/id #uuid "696bc006-25c5-513a-bd9b-a6faa2dd9a36" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186375437} {:answer/id #uuid "0ca94b17-5bb5-59b1-b428-73c7613972ad" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375438}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375438} :answer-field/id #uuid "16922444-299f-55a9-a2be-066c9885244c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375433}] :question/id #uuid "0ee811a8-c053-59bb-b00f-f224606c0564" :question/math-academy-id "q-81193" :question/problem "Given that ${v}_{1}=\\begin{bmatrix}{a}_{1} \\\\ {b}_{1}\\end{bmatrix}$ and ${v}_{2}=\\begin{bmatrix}{a}_{2} \\\\ {b}_{2}\\end{bmatrix}$ are linearly independent eigenvectors of the matrix\n$A=\\begin{bmatrix}1 & 8 \\\\ -2 & 1\\end{bmatrix},$\nwhat is the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}?$" :question/worked-solution "First, we need to find the eigenvalues of $A.$ To do that, we must solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 8 \\\\ -2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )(1-\\lambda )-(-2)(8) & =0 \\\\ 1-2\\lambda +{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2}-2\\lambda +17 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{2\\pm \\sqrt{(-2)^{2}-4(1)(17)}}{2(1)} \\\\  & =\\frac{2\\pm \\sqrt{-64}}{2} \\\\  & =\\frac{2\\pm 8\\text{i}}{2} \\\\  & =1\\pm 4\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =1\\pm 4\\text{i}.$\n\nNow, let's consider the eigenvalue ${\\lambda }_{1}=1+4\\text{i}.$ We have\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =\\begin{bmatrix}1 & 8 \\\\ -2 & 1\\end{bmatrix}-\\begin{bmatrix}1+4\\text{i} & 0 \\\\ 0 & 1+4\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\text{i} & 8 \\\\ -2 & -4\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, we get the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-4\\text{i}{x}_{1}+8{x}_{2} &=0 \\\\ -2{x}_{1}-4\\text{i}{x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nNow, since the matrix $A-(1+4\\text{i})I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=\\frac{1}{2}\\text{i}{x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n\\begin{bmatrix}{x}_{1} \\\\ \\frac{1}{2}\\text{i}{x}_{1}\\end{bmatrix},\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=2,$ we get the eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}2 \\\\ \\text{i}\\end{bmatrix}.\n$$\n\n \n\nThen, to compute the second eigenvector corresponding to ${\\lambda }_{2}=1-4\\text{i}$, we simply compute the complex conjugate of ${\\overset{―}{v}}_{1},$ and get\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=\\begin{bmatrix}2 \\\\ -\\text{i}\\end{bmatrix}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(2)(2)}{(\\text{i})(-\\text{i})}=4.\\end{aligned}\n$$"}] :knowledge-point/title "Finding Two Linearly Independent Complex Eigenvectors of a 2x2 Matrix"}] :topic/math-academy-id 3574 :topic/title "Finding Complex Eigenvectors of Real 2x2 Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186184937} :activity/id #uuid "45b54b13-346d-538c-876e-285764d59813" :activity/steps [{:db/id #edb/ref 17592186184937 :step/content {:db/id #edb/ref 17592186185320 :tutorial/content "When we reduce a matrix to row echelon form, the number of *pivot* columns plus the number of *non-pivot* columns always equals the total number of columns of the matrix. \n\nBy translating this into the language of vector spaces, we get the **rank-nullity theorem**. The rank-nullity theorem relates the rank of a matrix to the dimension of its null space:\n\n*Let $A$ be a matrix (not necessarily square) with $n$ columns. Then,*\n\n$$\n\\textrm{dim(Col}(A)) + \\textrm{dim(Null}(A)) = \\textrm{dim}(\\mathbb{R}^n),\n$$\n\n*or, equivalently,*\n\n$$\n\\textrm{rank}(A) + \\textrm{nullity}(A) = n.\n$$\n\nFor example, suppose that for some matrix $A,$ we have\n\n![](images/30/30f6472f02a4ac47f285fff05e0cdbf56367acdd18231271dc3dccf0040901bd.svg)\n\nWe can use the rank-nullity theorem to calculate $\\textrm{rank}(A).$\n\nIn this case, we must have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, we must have $\\textrm{nullity}(A)=2,$ since \n![](images/b5/b5f38590a71a2f8e1f29a5ba98920a10037737c1ebcbd3fd60f08a3e47555141.svg)\n\nTherefore, using the rank-nullity theorem, we have\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$" :tutorial/id #uuid "0728c510-110b-5bde-93ea-9050a87a6ecc" :tutorial/math-academy-id 3524 :tutorial/title "Introduction"} :step/id #uuid "af600efe-5480-5b61-8280-594a0825dbc1" :step/next {:db/id #edb/ref 17592186185007}} {:db/id #edb/ref 17592186184938 :step/content {:db/id #edb/ref 17592186184171 :knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe"} :step/id #uuid "526a000d-4f1e-513e-83a7-dcec4069077d" :step/next {:db/id #edb/ref 17592186184939}} {:db/id #edb/ref 17592186184939 :step/content {:db/id #edb/ref 17592186184172 :knowledge-point/id #uuid "5e145cb2-806a-579d-8299-8a91a6feaad1"} :step/id #uuid "10431142-f052-51d9-b9c7-38e48410c92d"} {:db/id #edb/ref 17592186185007 :step/content {:db/id #edb/ref 17592186184219 :knowledge-point/id #uuid "fcbc10c0-4e6b-5dac-ad87-f0175e4a53d2"} :step/id #uuid "3c8115af-900b-592a-a3df-6c126d87446c" :step/next {:db/id #edb/ref 17592186184938}}] :activity/title "The Rank-Nullity Theorem" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186184421} {:activity/first-step {:db/id #edb/ref 17592186545897} :activity/id #uuid "4c0943ba-1699-5e8c-8670-aee7d34650f4" :activity/steps [{:db/id #edb/ref 17592186545897 :step/content {:db/id #edb/ref 17592186184755 :question/id #uuid "4d185801-460b-5883-a896-8f1107477aa5"} :step/id #uuid "1eba418a-0a45-5af7-91fd-642512667c9b" :step/next {:db/id #edb/ref 17592186545994}} {:db/id #edb/ref 17592186545936 :step/content {:db/id #edb/ref 17592186545837 :question/id #uuid "94febb74-e81c-5137-a80c-9d7fa83538e0"} :step/id #uuid "648619fe-b878-526f-9493-71c3a98c37c8" :step/next {:db/id #edb/ref 17592186545960}} {:db/id #edb/ref 17592186545960 :step/content {:db/id #edb/ref 17592186545820 :question/id #uuid "5e7c8be1-d271-506d-bfc9-fbf1881a88d8"} :step/id #uuid "a4b43338-82e4-5410-9f98-512abc7e92cc"} {:db/id #edb/ref 17592186545994 :step/content {:db/id #edb/ref 17592186377763 :question/id #uuid "2c7ff497-8845-5d34-a5a1-e0b10d7a1e25"} :step/id #uuid "d4a34369-680e-54a1-9729-80a4a7934062" :step/next {:db/id #edb/ref 17592186546003}} {:db/id #edb/ref 17592186546003 :step/content {:db/id #edb/ref 17592186545857 :question/id #uuid "c10d4c77-93c5-52a9-900d-275fa9299d3e"} :step/id #uuid "e48dd2d3-2546-5691-ad94-982797f6f0e4" :step/next {:db/id #edb/ref 17592186545936}}] :activity/title "The Rank-Nullity Theorem" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186545189}] :db/id #edb/ref 17592186048978 :topic/knowledge-points [{:db/id #edb/ref 17592186184171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184070 :question/id #uuid "10cc01a6-af19-5340-9743-ade4d5e252dc" :question/math-academy-id "e-5425" :question/problem "Let $A$ be a $3\\times 5$ matrix. If $\\mathcal{B}= \\{\\mathbf{b_1}, \\mathbf{b_2}, \\mathbf{b_3}\\}$ is a basis of $\\textrm{Col}(A)$, find $\\textrm{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\textrm{rank}(A) + \\textrm{nullity}(A) = n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $\\mathcal{B}$ is formed by $3$ vectors, $\\textrm{rank}(A) = 3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"} :knowledge-point/id #uuid "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe" :knowledge-point/question-generator {:db/id #edb/ref 17592186530852 :question-generator/id #uuid "1744d06d-756c-5d2a-bb4f-65b0cc325ee8" :question-generator/script "generate/scratch/17592186184171.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186184759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c2c253b-eb4a-53cb-b0ca-7c84c3094ed1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186183164} {:answer/id #uuid "a1905378-ce91-51d4-9b0f-bc5b3501e65