\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$C$ only\"."} {:db/id #edb/ref 17592186345097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1c880af-d051-51c9-ab73-b924750b1cef" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468130} {:answer/id #uuid "4a2d43d5-9944-5ac0-83bd-d8335f6bd1bc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468131}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468131} :answer-field/id #uuid "7ade3324-e3b7-5e64-9d8e-2b78898e0777" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468786} {:answer-field/choices [{:answer/id #uuid "88cb0231-cd74-54c5-868a-bcac5490559d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468132} {:answer/id #uuid "6e9bb1a5-9cd2-546d-a74a-c00e25c84f61" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468133}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468132} :answer-field/id #uuid "efb37286-cf36-5848-813e-8c7e462feb0e" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468787} {:answer-field/choices [{:answer/id #uuid "5844533c-7be3-5a2a-a47d-69d9c92afd02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468134} {:answer/id #uuid "e7d0ed89-0a7f-527a-9397-9540757911e2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468135}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468134} :answer-field/id #uuid "fb6d0674-f6ff-5e1f-b038-2070323a0549" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468788}] :question/id #uuid "d8b28abc-ffbd-5f2b-b51a-6be08eb05498" :question/math-academy-id "q-75508" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:=\\frac{1}{4}{R}_{1}\\,$ and $\\,{R}_{2}:={R}_{2}+3{R}_{1}?$\n\n$$\nA=\\begin{bmatrix}4 & 0 \\\\ -3 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}8 & 0 \\\\ -6 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}4 & 0 \\\\ -4 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 0 \\\\ -3 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ B & =\\begin{bmatrix}8 & 0 \\\\ -6 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ -6 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ C & =\\begin{bmatrix}4 & 0 \\\\ -4 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."} {:db/id #edb/ref 17592186345106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a22d4b7-074a-5d04-912d-7b6108e7167d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468136} {:answer/id #uuid "5d0b2a23-76ab-5200-8d7b-f13b77b40192" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468137}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468136} :answer-field/id #uuid "f4254187-bd09-58f3-a28e-1f6f28a5af6d" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468789} {:answer-field/choices [{:answer/id #uuid "390c4edc-e818-5223-aa83-23ae63a5ce1c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468138} {:answer/id #uuid "11b4e9f4-70a6-5c81-993a-0952578db682" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468139}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468139} :answer-field/id #uuid "1646aa06-2e33-5643-a89f-dcda0cb5e983" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468790} {:answer-field/choices [{:answer/id #uuid "6f052af5-1b8f-5975-b3f7-87826619a2c5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468140} {:answer/id #uuid "678dc931-9de5-5c14-9144-1b98946a7b5c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468141}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468140} :answer-field/id #uuid "4e05ce73-bd6b-5a87-b9b7-7872f18039e7" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468791}] :question/id #uuid "fd25b025-461f-556b-97f3-6071c19d59d7" :question/math-academy-id "q-75595" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=4{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=\\begin{bmatrix}4 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}4 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}2 & 1 \\\\ \\frac{1}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{1}{4} & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}1 & 1 \\\\ \\frac{3}{4} & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{1} & :=4{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."} {:db/id #edb/ref 17592186345107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf810a22-6e4e-5370-935e-7b24712f6a30" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468142} {:answer/id #uuid "848f4c22-cfc4-5377-a40d-094c0e364b85" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468143}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468143} :answer-field/id #uuid "f591a7fc-b05e-5621-acf8-731308abb477" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468792} {:answer-field/choices [{:answer/id #uuid "50b01950-272f-59a6-9096-2b795827c4bf" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468144} {:answer/id #uuid "65204522-9d40-58cf-9306-f1b137036423" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468145}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468144} :answer-field/id #uuid "0bf1582f-2805-5217-a9e3-252ee8df0a4b" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468793} {:answer-field/choices [{:answer/id #uuid "20560ea6-e142-5067-95f1-de2eac284f54" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468146} {:answer/id #uuid "6b6e2ed2-a856-5436-bf79-89e451131f93" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468147}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468146} :answer-field/id #uuid "eac4c188-4d68-52bb-a7c2-ea3ae475e3ad" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468794}] :question/id #uuid "1a52696c-f90c-56a7-94f5-6062f59efbae" :question/math-academy-id "q-75599" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=\\frac{1}{2}{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=\\begin{bmatrix}2 & 1 \\\\ 2 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}-2 & 1 \\\\ 2 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}4 & 1 \\\\ 2 & 0\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ B & =\\begin{bmatrix}-2 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ -2 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ C & =\\begin{bmatrix}4 & 1 \\\\ 2 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."} {:db/id #edb/ref 17592186417378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbe7e325-2fed-5fe6-82f1-fde3a0369519" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473320} {:answer/id #uuid "2707c8dd-4e18-5590-9551-822813770a5c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473321}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473320} :answer-field/id #uuid "68674cd9-a7ae-5bc2-a4d9-c026495c3629" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474055} {:answer-field/choices [{:answer/id #uuid "44e4d87a-9878-5194-abc8-b8e409575c92" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473322} {:answer/id #uuid "8b25371e-e8f0-570c-abbe-a8239bd51334" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473323}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473323} :answer-field/id #uuid "38075992-4d8f-549c-bf5e-547a44778fde" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474056} {:answer-field/choices [{:answer/id #uuid "63df3d5f-9a6d-5ff0-bf8a-a6cdee7d5643" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473324} {:answer/id #uuid "87e93244-9d30-5d8e-bfc9-3dc22fafd49d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473325}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473324} :answer-field/id #uuid "5ed8b7f4-58be-52a4-9b60-74f11f144b74" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186474057}] :question/id #uuid "b47d0cc7-71aa-58ba-a792-0650346f33fc" :question/math-academy-id "q-75505" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:=\\frac{1}{5}{R}_{1}\\,$ and $\\,{R}_{2}:={R}_{2}+(-1){R}_{1}?$\n\n$$\nA=\\begin{bmatrix}10 & 0 \\\\ 2 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}5 & 0 \\\\ 1 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}5 & 0 \\\\ 3 & 1\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}10 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 2 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}5 & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}5 & 0 \\\\ 3 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :topic/math-academy-id 1728 :topic/title "Finding the Inverse of a 2x2 Matrix Using Row Operations"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186199393} :activity/id #uuid "f3742955-3684-5655-938c-85f92fc58b37" :activity/steps [{:db/id #edb/ref 17592186199392 :step/content {:db/id #edb/ref 17592186198442 :knowledge-point/id #uuid "a9d4e49c-202b-564f-839d-64b5d71a3783"} :step/id #uuid "81974eea-7a73-591a-8f79-590de81df808" :step/next {:db/id #edb/ref 17592186199396}} {:db/id #edb/ref 17592186199393 :step/content {:db/id #edb/ref 17592186199515 :tutorial/content "If $A$ is the matrix corresponding to the quadratic form $Q(\\mathbf{x}),$ then:  \n\n- The maximum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the largest eigenvalue $\\lambda_{\\textrm{max}}$ of $A,$ and the maximum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{max}}.$\n\n- The minimum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the smallest eigenvalue $\\lambda_{\\textrm{min}}$ of $A,$ and the minimum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{min}}.$\n\nWe'll prove this result at the end of the lesson.\n\nSuppose we're given that the maximum value of the quadratic form \n\n$$\nQ(\\mathbf{x})=x_1^2-10\\: \\! x_1x_2+x_2^2\n$$\n\n \n\nwhen $\\| \\mathbf{x} \\| = 1$ is $6.$ Let's use this to find a unit vector $\\mathbf{u}_{\\textrm{max}}$ where this maximum value is attained. \n\nSo first, we write down the matrix of our quadratic form:\n\n![](images/a6/a6165f41eb43e8f6e8fd4399f1c428f73481de9d4b5ec41293f3ec0e4f062fc6.svg)\n\nNext, we find the unit eigenvector that corresponds to the eigenvalue $\\lambda_{\\textrm{max}}=6{:}$\n\n$$\n\\begin{aligned}A-6I & =[\\begin{aligned}1 & -5 \\\\ -5 & 1\\end{aligned}]-6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-5 & -5 \\\\ -5 & -5\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-6I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](images/30/30699c4f0abcb099a6f7a76cbd76674757c3f7de313e034d0870d1fce27fdd8c.svg) \n\nFinally, dividing $\\mathbf{v}$ by its norm $\\| \\mathbf{v} \\| = \\sqrt{2},$ we get \n\n![](images/ef/ef14ea5facf5010b99721cf915f44162dfa52e089508fb78c2d02d9aad66f1a4.svg)  \n\nLet's check that this is indeed the vector we were looking for: \n\n$$\n\\begin{aligned}Q({u}_{\\text{max}}) & ={(\\frac{-1}{\\sqrt{2}})}^{2}-10(\\frac{-1}{\\sqrt{2}})(\\frac{1}{\\sqrt{2}})+{(\\frac{1}{\\sqrt{2}})}^{2} \\\\  & =\\frac{1}{2}+\\frac{10}{2}+\\frac{1}{2} \\\\  & =6\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "c50ae6a7-1f29-5274-bd82-d2d8acfef6b7" :tutorial/math-academy-id 7954 :tutorial/title "Introduction"} :step/id #uuid "08dd4ae6-a6ab-54da-a4ca-840835781b76" :step/next {:db/id #edb/ref 17592186199394}} {:db/id #edb/ref 17592186199394 :step/content {:db/id #edb/ref 17592186198443 :knowledge-point/id #uuid "6115493b-482c-5360-8d19-52582228e21d"} :step/id #uuid "47cdbdea-03d3-506b-a42b-a5ac82733039" :step/next {:db/id #edb/ref 17592186199392}} {:db/id #edb/ref 17592186199395 :step/content {:db/id #edb/ref 17592186198444 :knowledge-point/id #uuid "17fd5c3d-d4c6-5f78-b262-fbc6b7209501"} :step/id #uuid "d2f76172-74c1-501b-a19c-68e6454733cb" :step/next {:db/id #edb/ref 17592186199404}} {:db/id #edb/ref 17592186199396 :step/content {:db/id #edb/ref 17592186199516 :tutorial/content "Suppose we're given that the maximum value of the quadratic form \n\n$$\nQ(\\mathbf{x})=x_1^2-2x_1x_2+x_2^2,\n$$\n\n over the ellipse $4x_1^2+x_2^2=4$ equals $5.$ How can we find a vector $\\mathbf{x}$ at which this maximum is attained?\n\nWe can find this vector by applying a suitable change of variable. This change of variable should transform our problem into one where we need to maximize a related quadratic form $Q'$ on the unit circle. Let's see how this is done.\n\nFirst, we write down the matrix of our quadratic form:\n\n![](images/7b/7b1fd813963e16887c57d6c10be1bfe288e3209fd3a02ca6e6236b7261feb7b1.svg)\n\nNotice that we can write the constraint equation as follows:\n\n$$\n{x_1^2}+ \\dfrac{x_2^2}{2^2}=1\n$$\n\nwhich  represents an ellipse with semiaxes $a=1$ (along the $x_1$-axis) and $b=2$ (along the $x_2$-axis). \n\nIf we introduce new variables\n\n$$\ny_1={x_1}, \\qquad y_2 = \\dfrac{x_2}{2},\n$$\n\nthe equation of the ellipse will transform into $y_1^2+y_2^2 = 1,$ or $\\|\\mathbf{y}\\|=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n![](images/80/80f8e821a60b63dde0f314460adfd31faca5d82315243fb2a3ebdec75bc61538.svg) \n\nwe obtain that $\\mathbf{x} = P \\mathbf{y}.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(\\mathbf{x}) = \\mathbf{x}^T \\! A \\mathbf{x} = (P\\mathbf{y})^T A \\, (P\\mathbf{y}) = \\mathbf{y}^T \\! (P^TAP) \\mathbf{y}=Q'(\\mathbf{y}).\n$$\n\nAs a result, since $P^T=P,$ the matrix of our quadratic form in the new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}].\\end{aligned}\n$$\n\n \n\nNow, the goal is to maximize $Q'(\\mathbf{y})$ when $\\| \\mathbf{y} \\|=1,$ which we do using our usual methods.  \n\nSince we are told that the maximum value of the quadratic form is $5,$ we have\n\n$$\n\\max \\{ Q'(\\mathbf{y}) \\: | \\: \\| \\mathbf{y} \\|=1 \\} = \\lambda_{\\max} = 5.\n$$\n\nNext, we find the unit eigenvector that corresponds to the eigenvalue $\\lambda_{\\textrm{max}}=5{:}$\n\n$$\n\\begin{aligned}B-5I & =[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-4 & -2 \\\\ -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-5I)\\mathbf{y}=\\mathbf{0}$ gives the eigenvector ![](images/4b/4b51afece6e21c2fe073a5346557f42f9f03ae3400407d18ed6af3af8f32e310.svg) Dividing $\\mathbf{v}$ by its norm $\\| \\mathbf{v} \\| = \\sqrt{5},$ we get \n\n![](images/ce/ce571338fc1d83f0b0892a356bca56073c096a1f5191a21a4baef56b6d5a399f.svg) \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot \\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}-1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "e750f422-509a-598a-858a-c11360c80eea" :tutorial/math-academy-id 7955 :tutorial/title "Constrained Optimization of Quadratic Forms Over Ellipses"} :step/id #uuid "f3b4db0d-8fec-573f-8597-7e9b0d0a4474" :step/next {:db/id #edb/ref 17592186199395}} {:db/id #edb/ref 17592186199404 :step/content {:db/id #edb/ref 17592186199547 :tutorial/content "To complete the picture, let's prove the main theorem of this lesson:\n\n*The maximum value of a quadratic form $Q(\\mathbf{x})=\\mathbf{x}^T A \\mathbf{x},$ when $\\| \\mathbf{x} \\|=1,$ is equal to the largest eigenvalue of $A{:}$* \n\n$$\n\\max \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\lambda_{\\textrm{max}}\n$$\n\n*The maximum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{max}}.$*\n\n**Note:** We'll show only the first part (about the maximum value) since a similar argument can be used to prove the second part (about the minimum value).\n\nLet $A$ be a real $n \\times n$ symmetric matrix corresponding to a quadratic form $Q(\\mathbf x)\\mathbin.$ As a result, there must be an *orthonormal* matrix $P$ such that \n\n- $D=P^{-1}AP=P^TAP,$ where $D$ is a diagonal matrix.\n\n- The diagonal entries of $D$ are the eigenvalues of $A$. Without loss of generality, we can assume that the eigenvalues are $\\lambda_1 \\geq \\lambda_2 \\geq \\ldots \\geq \\lambda_n,$ where $\\lambda_{\\textrm{max}} = \\lambda_1.$\n\n- The columns $\\mathbf{u}_1,\\mathbf{u}_2, \\ldots, \\mathbf{u}_n$ of $P$ form an orthonormal set of unit eigenvectors of $A.$ So, $\\mathbf{u}_{\\textrm{max}} = \\mathbf{u}_1.$\n\nTake $\\mathbf x=P\\mathbf y.$ Since, $P$ is orthonormal, we have\n\n$$\n\\|\\mathbf x\\| = \\|P \\mathbf y \\| = \\|\\mathbf y\\|\n$$\n\nand\n\n$$\nQ(\\mathbf x) = \\mathbf x^T\\!A\\mathbf x = (P\\mathbf y)^T\\!A(P\\mathbf y) = \\mathbf{y}^T (P^T\\!AP) \\mathbf{y} = \\mathbf{y}^T D \\mathbf{y}\n$$\n\nfor all $\\mathbf{y} \\in \\mathbb{R}^n.$\n\nTherefore, we can conclude the following:\n\n- $\\|\\mathbf x\\| =1 \\Longleftrightarrow \\|\\mathbf y\\| =1$ for all $\\mathbf y$ such that $\\mathbf x=P\\mathbf y$\n\n- Restricted to the unit sphere of $\\Bbb R^n,$ the images of the quadratic forms $Q(\\mathbf x)$  and $Q'(\\mathbf y)= \\mathbf y^T D\\mathbf y$ coincide: \n\n$$\n\\{\\mathbf x^TA\\mathbf x: \\: \\: \\|\\mathbf x\\|=1\\}= \\{\\mathbf y^TD\\mathbf y: \\: \\: \\|\\mathbf y\\|=1\\}  \\subset \\mathbb R\n$$\n\nNow, for any unit vector $\\mathbf{y} \\in \\mathbb{R}^n,$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={Q}^{′}(y) \\\\  & ={\\lambda }_{1}{y}_{1}^{2}+{\\lambda }_{2}{y}_{2}^{2}+⋯+{\\lambda }_{n}{y}_{n}^{2} \\\\  & \\le {\\lambda }_{\\text{max}}\\,{y}_{1}^{2}+{\\lambda }_{\\text{max}}\\,{y}_{2}^{2}+⋯+{\\lambda }_{\\text{max}}\\,{y}_{n}^{2} \\\\  & ={\\lambda }_{\\text{max}}({y}_{1}^{2}+{y}_{2}^{2}+⋯+{y}_{n}^{2}) \\\\  & ={\\lambda }_{\\text{max}}\\,‖y{‖}^{2} \\\\  & ={\\lambda }_{\\text{max}}.\\end{aligned}\n$$\n\nSo, we have that  that \n\n$$\nM = \\max \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\max \\{ Q'(\\mathbf{y}) \\: | \\:  \\| \\mathbf{y} \\| = 1 \\} \\le \\lambda_{\\textrm{max}}.\n$$\n\n \n\nOn the other hand, if we take ![](images/53/53a051ea36059c9222e717c65adc6531bc313c9807d44a39b262433acfdcbc5c.svg) then $Q(P\\mathbf{e}_1) = Q'(\\mathbf{e}_1) = \\lambda_{\\textrm{max}}.$ So, we conclude that $M = \\lambda_{\\textrm{max}}.$\n\nFinally, since $\\mathbf{u}_1 = P\\mathbf{e}_1$ we have that \n$Q(\\mathbf u_1) =  \\mathbf e_1^T D \\mathbf e_1 = \\lambda_{\\textrm{max}}.$ \nTherefore, the maximum value is attained at $\\mathbf u_{\\textrm{max}}.$" :tutorial/id #uuid "364005f5-f0fc-5d17-9d6b-288d52abe715" :tutorial/math-academy-id 8176 :tutorial/title "Proof of the Main Theorem"} :step/id #uuid "3a8e9986-4b85-5793-91b8-d47f73b67205"}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186198510} {:activity/first-step {:db/id #edb/ref 17592186410202} :activity/id #uuid "f2727b60-7a6b-5f3a-a237-6a67bfb8139d" :activity/steps [{:db/id #edb/ref 17592186410199 :step/content {:db/id #edb/ref 17592186410196 :question/id #uuid "5e6637da-fa52-5317-a60a-ab7680b44bc0"} :step/id #uuid "0d7e6a3a-4e90-51f7-9e6d-1f36e15dea08" :step/next {:db/id #edb/ref 17592186410203}} {:db/id #edb/ref 17592186410200 :step/content {:db/id #edb/ref 17592186410197 :question/id #uuid "dea55e7b-1cc0-500b-8640-ae39dddce75c"} :step/id #uuid "3781c4aa-7e7b-5b51-9af4-d354711b0091"} {:db/id #edb/ref 17592186410201 :step/content {:db/id #edb/ref 17592186410195 :question/id #uuid "3f433543-b9f1-5f20-b0ed-749a73af3fa7"} :step/id #uuid "80ab5b9e-fd44-5cd4-b555-7638c14ed974" :step/next {:db/id #edb/ref 17592186410200}} {:db/id #edb/ref 17592186410202 :step/content {:db/id #edb/ref 17592186198560 :question/id #uuid "13f589cb-239b-530f-99ce-e58d907d8d98"} :step/id #uuid "cd806b8f-e6cf-5b59-a4ed-ccc0cfee81a2" :step/next {:db/id #edb/ref 17592186410199}} {:db/id #edb/ref