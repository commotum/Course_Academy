b131-de449ea45e78" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}-3{R}_{3}" :db/id #edb/ref 17592186555377} {:answer/id #uuid "c252ed9f-342e-57d8-9f1c-24b289a4beb4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+3{R}_{1}" :db/id #edb/ref 17592186555469}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=-\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186555074} :answer-field/id #uuid "2d8fe497-6500-5a3d-bec7-a1a5ff5c4b03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555660}] :question/id #uuid "0dc73948-1028-504a-8a43-9f0c9272154c" :question/math-academy-id "q-110462" :question/problem "Consider $E=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{aligned}]$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by multiplying the second row of ${I}_{3}$ by $-\\frac{1}{3}:$\n\n$$\n\\begin{aligned}{I}_{3} & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{2}:=-\\frac{1}{3}{R}_{2}$ to $A.$"} {:db/id #edb/ref 17592186555780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35157c22-24eb-54d5-8dec-17a92404289b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-{R}_{3}" :db/id #edb/ref 17592186555113} {:answer/id #uuid "37b5244d-4177-5d1b-be34-b6526c5f2520" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}-{R}_{1}" :db/id #edb/ref 17592186555119} {:answer/id #uuid "3cc19e07-f2b4-5014-9573-385e4d73605c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{1}" :db/id #edb/ref 17592186555129} {:answer/id #uuid "5ac5ddd1-d0e2-52e0-b7a9-e3aa54032458" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{2}" :db/id #edb/ref 17592186555200} {:answer/id #uuid "bf1a8144-1d11-524d-9aaa-7a57437a74eb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-{R}_{2}" :db/id #edb/ref 17592186555456}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-{R}_{3}" :db/id #edb/ref 17592186555113} :answer-field/id #uuid "399837e0-2092-5934-a6dc-9c62486125f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555667}] :question/id #uuid "2d00f9e4-bc18-5599-a1c2-2f30832c80ab" :question/math-academy-id "q-42537" :question/problem "Consider $E=[\\begin{aligned}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by taking the first row of ${I}_{3}$ and subtracting the third row:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}-{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}-{R}_{3}$ to $A.$"} {:db/id #edb/ref 17592186555791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d56313c-529d-5eca-ad82-a0508fc3fb86" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=7{R}_{3}" :db/id #edb/ref 17592186555051} {:answer/id #uuid "6b2ad059-1df4-54c9-bd82-322256b36f80" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+7{R}_{2}" :db/id #edb/ref 17592186555244} {:answer/id #uuid "c347b5a9-9ae2-58bb-84c8-a9d578f6c1af" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{7}{R}_{1}" :db/id #edb/ref 17592186555472} {:answer/id #uuid "d2c4f9e3-00fb-5fad-b454-4772f485d6df" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+7{R}_{1}" :db/id #edb/ref 17592186555499} {:answer/id #uuid "ed1261c8-d574-56d6-a7fa-90c22ec256e3" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-7{R}_{1}" :db/id #edb/ref 17592186555583}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+7{R}_{1}" :db/id #edb/ref 17592186555499} :answer-field/id #uuid "dde3abf0-6177-5679-8941-b43d0716b340" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555747}] :question/id #uuid "3a8b7714-d243-5a18-865d-0e2cf918670b" :question/math-academy-id "q-110463" :question/problem "Consider $E=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{aligned}]$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by taking the third row of ${I}_{3}$ and adding $7$ times the first row:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 7 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary row operation ${R}_{3}:={R}_{3}+7{R}_{1}$ to $A.$"}] :knowledge-point/title "Finding the Row Operation Equivalent To Left Multiplication by an Elementary Matrix"} {:db/id #edb/ref 17592186133743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133553 :question/id #uuid "f8eb89c4-1cca-5f8c-909c-31e9e0fc8412" :question/math-academy-id "e-4733" :question/problem "Suppose we are applying the elementary row operation $R_2:=R_2-2R_1$ to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation $R_2 := R_2-2R_1$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA\\mathbin{:}$\n\n![](images/a2/a23e35f367c6d8ca4bdbee47bacf9afca23dea031b0a647dda5067746bf45e46.svg)"} :knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba" :knowledge-point/questions [{:db/id #edb/ref 17592186134187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "513943d2-1db7-5bd9-894d-91ed6db1e89b" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186297894} {:answer/id #uuid "59b146cf-7c47-5272-adde-0fe2b03d0023" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186297927} {:answer/id #uuid "6aa36ea0-e3ae-5332-9259-bc9db485b5ec" :answer/type {:db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186298011} {:answer/id #uuid "cde70c7f-2559-522c-bab1-89f8bf6027ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298451} {:answer/id #uuid "d844c09e-5c6d-5030-a943-16e6c8476759" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298480}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298480} :answer-field/id #uuid "ff80a385-216a-5db4-94f4-9a630195c374" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299496}] :question/id #uuid "5850f9b5-76bb-54cc-bfaa-176ac2b82ca9" :question/math-academy-id "q-32128" :question/problem "Suppose that the elementary row operation ${R}_{2}:={R}_{2}-3{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}:={R}_{2}-3{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A\n$$"} {:db/id #edb/ref 17592186134396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae722046-6be9-5e9a-bf56-4206a9c79894" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\cdot A" :db/id #edb/ref 17592186132416} {:answer/id #uuid "10dc647e-4bc7-5382-9e97-bd8139145536" :answer/type {:db/ident :answer.type/math} :answer/value "A \\cdot \\begin{bmatrix}1 & 0 & 0 