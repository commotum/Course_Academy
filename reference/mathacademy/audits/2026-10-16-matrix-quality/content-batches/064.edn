 have:\n\n$$\n\\begin{aligned}|\\begin{aligned}-15 & -11 \\\\ 10 & -15\\end{aligned}| & =-15\\cdot (-15)-(-11)\\cdot 10 \\\\  & =225-(-110) \\\\  & =335\\end{aligned}\n$$"} {:db/id #edb/ref 17592186510617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45482320-ca91-5c71-a92c-e0a8ce03cdb5" :answer/type {:db/ident :answer.type/math} :answer/value "156" :db/id #edb/ref 17592186510594} {:answer/id #uuid "680e2bfe-fb61-5d5e-8dcb-8e656b48c082" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186510601} {:answer/id #uuid "7d3723d1-3bbb-5378-bdf1-8adae692d227" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186510604} {:answer/id #uuid "c6097b50-9415-5938-9802-60334296d427" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186510615} {:answer/id #uuid "f5822848-cd15-5ab7-809a-95aee17f1031" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186510620}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186510620} :answer-field/id #uuid "61a929df-3a8c-52c0-bc0d-8ef7863835ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510599}] :question/id #uuid "c979d384-64a3-52ee-ad97-dd8b3f818ebf" :question/problem "$|\\begin{aligned}-13 & 11 \\\\ 12 & -12\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}-13 & 11 \\\\ 12 & -12\\end{aligned}| & =-13\\cdot (-12)-11\\cdot 12 \\\\  & =156-132 \\\\  & =24\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"} {:db/id #edb/ref 17592186059749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059558 :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A),$ if $\\begin{bmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$"} :knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/question-generator {:db/id #edb/ref 17592186510584 :question-generator/id #uuid "b5a783cc-779a-5962-8d9d-81552c14fbb7" :question-generator/script "generate/scratch/17592186059749.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b466bee3-4694-50ff-b4ff-be40469939a3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056245} {:answer/id #uuid "14252abb-f88d-5c80-a1a7-50e1c5101e76" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6} + 5" :db/id #edb/ref 17592186056246} {:answer/id #uuid "422a8592-44c9-5cd7-a9f8-f218255dd350" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2} - 5" :db/id #edb/ref 17592186056247} {:answer/id #uuid "5403717f-fd25-5fdf-9147-cb1006233b46" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186056248} {:answer/id #uuid "62819f9b-2032-516f-902f-f58dc1fc0aaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6} - 5" :db/id #edb/ref 17592186056249}] :answer-field/id #uuid "49e48a24-3b9b-576a-ba9c-ed6114af8aa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056244}] :question/id #uuid "50adc5c7-3aa8-5ed8-9f4a-a8650f063784" :question/math-academy-id "q-1088"