/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286252} {:answer/id #uuid "f133bf14-3c6d-5286-a6d1-bf00852e4721" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186287001}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286252} :answer-field/id #uuid "baa7a81a-d6ae-5365-9fa0-1142a694af59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287534}] :question/id #uuid "e5cade28-be41-57ee-910f-46e652127d0c" :question/math-academy-id "q-18285" :question/problem "Determine the entry ${a}_{31}^{′}$ in the inverse of a matrix $A=\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}.$" :question/worked-solution "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=|\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}| & =0|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|-0|\\begin{aligned}0 & 0 \\\\ 2 & 1\\end{aligned}|+1|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}| \\\\  & =0-0+(0-2) \\\\  & =-2.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{31}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}| \\\\  & =0-2 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′}=\\frac{1}{\\text{det}(A)}{c}_{13}=\\frac{1}{-2}\\cdot (-2)=1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232327fd-1dfa-5996-8e84-95bb6a9f8cc3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{39}" :db/id #edb/ref 17592186285103} {:answer/id #uuid "c4f41583-27a2-56ac-9a18-17faf2b31721" 