0⟩=0" :db/id #edb/ref 17592186363026} :answer-field/id #uuid "62d8e0de-bd79-5989-ac01-8e91264eb204" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363025}] :question/id #uuid "375a2ad1-dda0-51b8-a824-e404e34a60e1" :question/math-academy-id "q-128382" :question/problem "Given the Cartesian equation $3x+5y+15=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨3,5,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}3x+5y+15 & =0 \\\\ 5y & =-3x-15 \\\\ y & =-\\frac{3}{5}x-3.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=-3.$ Hence, the point $P(0,-3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,-3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8820fb-a6d0-5faf-9981-71cb5d041f29" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,-3,0⟩)\\cdot ⟨7,-1,0⟩=0" :db/id #edb/ref 17592186387875} {:answer/id #uuid "6c78dd0f-845d-5bcb-9b44-79f85c755d47" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,9,0⟩)\\cdot ⟨-7,0,1⟩=0" :db/id #edb/ref 17592186387876} {:answer/id #uuid "d00473ec-47a7-55f6-8a63-b87befe37369" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,6,0⟩)\\cdot ⟨0,7,1⟩=0" :db/id #edb/ref 17592186387877} {:answer/id #uuid "d3744926-06d2-5a5f-a5e2-07abcc77fabc" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩=0" :db/id #edb/ref 17592186387878} {:answer/id #uuid "47647d85-f672-5262-8d4f-f0d7a9258831" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,-6,0⟩)\\cdot ⟨7,0,1⟩=0" :db/id #edb/ref 17592186387879}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩=0" :db/id #edb/ref 17592186387878} :answer-field/id #uuid "eab2fab9-a504-560f-bbc5-2ac638b9790f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387874}] :question/id #uuid "a275fd86-a21a-5ef1-ae5c-9df806e069b0" :question/math-academy-id "q-128400" :question/problem "Given the Cartesian equation $7x+y-3=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨7,1,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}7x+y-3 & =0 \\\\ y & =3-7x.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=3.$ Hence, the point $P(0,3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d75490e5-1509-58bb-9763-c438183b853c" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨1,0,-1⟩=0" :db/id #edb/ref 17592186393017} {:answer/id #uuid "aeda2ffa-42b4-52c6-88ee-ca624f7cbd32" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,0,-2⟩=0" :db/id #edb/ref 17592186393018} {:answer/id #uuid "e668ab95-81b2-5487-a8db-a7ad8d3973d8" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393019} {:answer/id #uuid "9538cda3-e06b-5fe5-b129-c566cce61ce5" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393020} {:answer/id #uuid "937f4290-2d11-5090-a4a2-afbc778336d1" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,-2,-4⟩=0" :db/id #edb/ref 17592186393021}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393020} :answer-field/id #uuid "ca2ac9ba-0e12-54e9-981f-caf50c21ada3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393016}] :question/id #uuid "73c1d5d9-6a23-5438-8d9f-6779511254e9" :question/math-academy-id "q-70818" :question/problem "Given the Cartesian equation $2x+y-2z-4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨2,1,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}2x+y-2z-4 & =0 \\\\ -2z & =-2x-y+4 \\\\ z & =x+\\frac{1}{2}y-2.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=-2.$ Hence, the point $P(0,0,-2)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-2⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f840eb8f-ab9a-5f24-8c61-1495e09eec29" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/id #edb/ref 17592186393024} {:answer/id #uuid "91ee1039-c30b-5d26-b83c-09088d137cb6" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393025} {:answer/id #uuid "23c5e4b7-8bec-5100-9926-e941a39c382d" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/id #edb/ref 17592186393026} {:answer/id #uuid "4d0de0e0-0dc6-5fa0-9f0d-4286598f473e" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨1,7,-1⟩=0" :db/id #edb/ref 17592186393027} {:answer/id #uuid "4781d9fd-c985-5f91-b6b3-1be2153657f7" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393028}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393028} :answer-field/id #uuid "dd843a19-122b-52dc-97b2-1085325976eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393023}] :question/id #uuid "7d906b68-2682-5ae7-a3b1-5cdc64fb4dd3" :question/math-academy-id "q-70824" :question/problem "Given the Cartesian equation $7y-z-13=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,7,-1⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}7y-z-13 & =0 \\\\ z & =7y-13.\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-13.$ Hence, the point $P(0,0,-13)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-13⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186423960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bd6234-56f6-541c-bfc5-f390a8cb5bfa" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨3,-2,1⟩=0" :db/id #edb/ref 17592186423950} {:answer/id #uuid "1d1ce09d-4b43-5ecf-b718-dbc33ca70dc2" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,2,3⟩=0" :db/id #edb/ref 17592186423951} {:answer/id #uuid "2c57426d-3447-5790-bc09-7f27391e4e89" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,3⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423952} {:answer/id #uuid "95f99c20-a235-5660-8d6b-b04b727483d7" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423955} {:answer/id #uuid "b1292071-77e9-579a-8b2f-0a1e4da37f19" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,\\frac{1}{3}⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423957}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩=0" :db/id #edb/ref 17592186423955} :answer-field/id #uuid "0fa9de33-9d04-55cd-94a1-cecb483c4e8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423959}] :question/id #uuid "e005b4ab-002a-57d1-b9b7-3fc85eeb395f" :question/math-academy-id "q-70819" :question/problem "Given the Cartesian equation $x-2y+3z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨1,-2,3⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}x-2y+3z & =0 \\\\ 3z & =-x+2y \\\\ z & =-\\frac{1}{3}x+\\frac{2}{3}y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨1,-2,3⟩ & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"} {:db/id #edb/ref 17592186119835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119646 :question/id #uuid "8a9e1070-0ca0-5f24-ac89-999c9271a91b" :question/math-academy-id "e-4939" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,2,-6)$ and is parallel to the vectors $\\mathbf{v_1}=\\langle -3, 5, 2 \\rangle$ and $\\mathbf{v_2}=\\langle 1, 3, -2 \\rangle.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $\\mathbf{p}=\\langle -3,2,-6 \\rangle.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}-3 \\\\ 5 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ -3 & 5 & 2 \\\\ 1 & 3 & -2\\end{vmatrix} \\\\  & =-16i-4j-14k \\\\  & =⟨-16,-4,-14⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-16,-4,-14⟩ & =⟨-3,2,-6⟩\\cdot ⟨-16,-4,-14⟩ \\\\ r\\cdot ⟨-16,-4,-14⟩ & =124\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-16,-4,-14⟩ & =124 \\\\ -16x-4y-14z & =124 \\\\ -16x-4y-14z-124 & =0 \\\\ 8x+2y+7z+62 & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2" :knowledge-point/questions [{:db/id #edb/ref 17592186120232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8640880e-b298-5a73-9ef6-0ef000e9d1e3" :answer/type {:db/ident :answer.type/math} :answer/value "x + y - 7z - 25 = 0" :db/id #edb/ref 17592186117552} {:answer/id #uuid "bd8e2719-25f6-546a-9d88-de3942584871" :answer/type {:db/ident :answer.type/math} :answer/value "x + y - 7z + 39 = 0" :db/id #edb/ref 17592186117553} {:answer/id #uuid "f48e0d41-4026-5aef-ac9e-0e8eb0518841" :answer/type {:db/ident :answer.type/math} :answer/value "x - 2y - 5z - 25 = 0" :db/id #edb/ref 17592186117554} {:answer/id #uuid "2d9bea5a-cc16-56a2-80f2-6c94ff0ddec7" :answer/type {:db/ident :answer.type/math} :answer/value "19x + 7y + z - 25 = 0" :db/id #edb/ref 17592186117555} {:answer/id #uuid "3bca758f-4564-5643-9cbe-81b2d3d1739c" :answer/type {:db/ident :answer.type/math} :answer/value "19x + 7y + z + 39 = 0" :db/id #edb/ref 17592186117556}] :answer-field/id #uuid "9c6286b3-beb8-5667-aa95-3497a042a508" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117551}] :question/id #uuid "9028efec-76cf-5169-b049-4d3329d5ac27" :question/math-academy-id "q-33145" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3, 2, 4)$ and is parallel to the vectors $v_{1} = ⟨1,-2,-5⟩$ and $v_{2} = ⟨0, 1,-7⟩$."} {:db/id #edb/ref 17592186120283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf34d07-cd99-5983-8a1b-cb31892f721e" :answer/type {:db/ident :answer.type/math} :answer/value "5x-2y+z=0" :db/id #edb/ref 17592186312064} {:answer/id #uuid "543cf762-98f0-583c-b80f-a17527258a20" :answer/type {:db/ident :answer.type/math} :answer/value "x-5y+5z-16=0" :db/id #edb/ref 17592186312656} {:answer/id #uuid "81d82da8-094c-5d53-92cb-5fda4924d683" :answer/type {:db/ident :answer.type/math} :answer/value "x-5y+5z=0" :db/id #edb/ref 17592186313021} {:answer/id #uuid "869b5aba-db3e-5905-b9d5-c7f7146ea7fe" :answer/type {:db/ident :answer.type/math} :answer/value "5x-2y+z+16=0" :db/id #edb/ref 17592186313053} {:answer/id #uuid "d14dfaa9-4c8e-55a3-b867-d30669e90de0" :answer/type {:db/ident :answer.type/math} :answer/value "x+5y+5z+16=0" :db/id #edb/ref 17592186313609}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-5y+5z-16=0" :db/id #edb/ref 17592186312656} :answer-field/id #uuid "9200a78c-c2dd-5fc5-8cd7-e5930b0a22e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314404}] :question/id #uuid "93f0f0ea-5609-5473-8b26-f85225442381" :question/math-academy-id "q-33912" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,0,3)$ and is parallel to the vectors ${v}_{1}=⟨5,2,1⟩$ and ${v}_{2}=⟨0,3,3⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,0,3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}5 \\\\ 2 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 3 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 5 & 2 & 1 \\\\ 0 & 3 & 3\\end{vmatrix} \\\\  & =3i-15j+15k \\\\  & =⟨3,-15,15⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-15,15⟩ & =⟨1,0,3⟩\\cdot ⟨3,-15,15⟩ \\\\ r\\cdot ⟨3,-15,15⟩ & =48\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-15,15⟩ & =48 \\\\ 3x-15y+15z & =48 \\\\ 3x-15y+15z-48 & =0 \\\\ x-5y+5z-16 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141dbd48-41d3-5f2d-ac44-58651f4076fe" :answer/type {:db/ident :answer.type/math} :answer/value "4x-2y+6z+21=0" :db/id #edb/ref 17592186260051} {:answer/id #uuid "2c33e216-d94a-5531-8c09-2b026bb2f73c" :answer/type {:db/ident :answer.type/math} :answer/value "4x-6y-2z+17=0" :db/id #edb/ref 17592186260271} {:answer/id #uuid "d74c1003-0d34-55fd-8cf1-e3b806cfd4be" :answer/type {:db/ident :answer.type/math} :answer/value "4x-2y-6z+10=0" :db/id #edb/ref 17592186261767} {:answer/id #uuid "dbf6af12-e362-5602-b7d5-5d61a520a968" :answer/type {:db/ident :answer.type/math} :answer/value "4x-6y-2z+7=0" :db/id #edb/ref 17592186261821} {:answer/id #uuid "f70483bf-7393-5c2b-b762-0a3626381ecd" :answer/type {:db/ident :answer.type/math} :answer/value "2x-4y-6z+13=0" :db/id #edb/ref 17592186262035}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x-2y-6z+10=0" :db/id #edb/ref 17592186261767} :answer-field/id #uuid "b802df34-fc9c-5dbb-a3bf-830e576b7529" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262458}] :question/id #uuid "25936c54-3b79-59fa-98c2-e2c44069022a" :question/math-academy-id "q-128462" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,3)$, $P(3,-1,4)$ and $Q(-1,0,1).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,3⟩,\\,p=⟨3,-1,4⟩,$ and $q=⟨-1,0,1⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-1,4⟩-⟨1,-2,3⟩ \\\\  & =⟨2,1,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨-1,0,1⟩-⟨1,-2,3⟩ \\\\  & =⟨-2,2,-2⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}-2 \\\\ 2 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & 1 \\\\ -2 & 2 & -2\\end{vmatrix} \\\\  & =-4i+2j+6k \\\\  & =⟨-4,2,6⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-4,2,6⟩ & =⟨3,-1,4⟩\\cdot ⟨-4,2,6⟩ \\\\ r\\cdot ⟨-4,2,6⟩ & =10\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-4,2,6⟩ & =10 \\\\ -4x+2y+6z & =10 \\\\ -4x+2y+6z-10 & =0 \\\\ 4x-2y-6z+10 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322bdd40-a89d-54b3-81d8-8151235b82d4" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186300210}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186300210} :answer-field/id #uuid "1a2cde90-cae5-5b84-89e4-e24f91f327d4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301309} {:answer-field/choices [{:answer/id #uuid "49081e49-39e7-597d-9ecf-6118251f8fb7" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186300334}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186300334} :answer-field/id #uuid "5a2ca30b-bdbd-5eac-ae60-bf6ac951e1d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301524} {:answer-field/choices [{:answer/id #uuid "1245995a-f65b-5c93-81c2-48beb67e35a3" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186300036}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186300036} :answer-field/id #uuid "d95ac3b6-903b-59a8-b8db-2d80e9e15a1a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301926}] :question/id #uuid "d7278c5e-97e4-5ded-971c-857a998455ed" :question/math-academy-id "q-326312" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,2,4)$ and is parallel to the vectors ${v}_{1}=⟨1,-2,-5⟩$ and ${v}_{2}=⟨0,1,-7⟩.$\n\n{{field-1}}\n$x\\,+$\n{{field-2}}\n$y+z\\,+$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-3,2,4⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ -5\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 1 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & -2 & -5 \\\\ 0 & 1 & -7\\end{vmatrix} \\\\  & =19i+7j+k \\\\  & =⟨19,7,1⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨19,7,1⟩ & =⟨-3,2,4⟩\\cdot ⟨19,7,1⟩ \\\\ r\\cdot ⟨19,7,1⟩ & =-39\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨19,7,1⟩ & =-39 \\\\ 19x+7y+z & =-39 \\\\ 19x+7y+z+39 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458b8eb5-3b29-5924-902c-d3cffef6a6de" :answer/type {:db/ident :answer.type/math} :answer/value "15x-8y-3z-67=0" :db/id #edb/ref 17592186302895} {:answer/id #uuid "88dc538f-e6c9-5c6f-808b-34c2e95ebb30" :answer/type {:db/ident :answer.type/math} :answer/value "5x+y-67=0" :db/id #edb/ref 17592186303309} {:answer/id #uuid "bd1bdbf0-be7f-5cf7-818b-98633141df5a" :answer/type {:db/ident :answer.type/math} :answer/value "4x-2y+3z=0" :db/id #edb/ref 17592186303615} {:answer/id #uuid "d7a0a96f-703b-50f9-a5c7-b2bec60c5f8b" :answer/type {:db/ident :answer.type/math} :answer/value "2x-5y+z-70=0" :db/id #edb/ref 17592186303802} {:answer/id #uuid "fba3cc98-79bd-550c-ab66-3b016a6a9822" :answer/type {:db/ident :answer.type/math} :answer/value "15x-8y-3z+70=0" :db/id #edb/ref 17592186304035}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "15x-8y-3z-67=0" :db/id #edb/ref 17592186302895} :answer-field/id #uuid "ff2ba7ba-1383-50ad-b6f1-05fe844c3868" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304763}] :question/id #uuid "0886b819-4519-5617-bf4c-2f8309f1feb4" :question/math-academy-id "q-33142" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(2,-5,1)$, $P(4,-2,3)$ and $Q(5,1,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨2,-5,1⟩,\\,p=⟨4,-2,3⟩,$ and $q=⟨5,1,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨4,-2,3⟩-⟨2,-5,1⟩ \\\\  & =⟨2,3,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨5,1,0⟩-⟨2,-5,1⟩ \\\\  & =⟨3,6,-1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 2 \\\\ 3 & 6 & -1\\end{vmatrix} \\\\  & =-15i+8j+3k \\\\  & =⟨-15,8,3⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-15,8,3⟩ & =⟨4,-2,3⟩\\cdot ⟨-15,8,3⟩ \\\\ r\\cdot ⟨-15,8,3⟩ & =-67\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-15,8,3⟩ & =-67 \\\\ -15x+8y+3z & =-67 \\\\ -15x+8y+3z+67 & =0 \\\\ 15x-8y-3z-67 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f585e309-73b4-523e-a6db-a2a983999732" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310701}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310701} :answer-field/id #uuid "0465da51-c688-5f2e-a3b9-979e1d2fc572" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310804} {:answer-field/choices [{:answer/id #uuid "1b5b7065-1260-5634-833e-cd8d9b69dc30" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186308962}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186308962} :answer-field/id #uuid "495fba70-636b-5cb8-b619-f1add74b1dec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310987} {:answer-field/choices [{:answer/id #uuid "2cf18829-493f-5163-a8ed-b491fd4a9396" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309082}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309082} :answer-field/id #uuid "97cb1a37-6fd2-5af4-8e41-45302b6fb593" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311236}] :question/id #uuid "ade52e16-a03f-5e87-b722-7d62e66ee938" :question/math-academy-id "q-336358" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-4,3,5)$ and is parallel to the vectors ${v}_{1}=⟨2,-3,-6⟩$ and ${v}_{2}=⟨0,2,-8⟩.$\n\n{{field-1}}\n$x\\,+$\n{{field-2}}\n$y\\,+\\,z\\,+$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-4,3,5⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ -3 \\\\ -6\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 2 \\\\ -8\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & -3 & -6 \\\\ 0 & 2 & -8\\end{vmatrix} \\\\  & =36i+16j+4k \\\\  & =⟨36,16,4⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨36,16,4⟩ & =⟨-4,3,5⟩\\cdot ⟨36,16,4⟩ \\\\ r\\cdot ⟨36,16,4⟩ & =-76\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨36,16,4⟩ & =-76 \\\\ 36x+16y+4z & =-76 \\\\ 36x+16y+4z+76 & =0 \\\\ 9x+4y+z+19 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142ba832-6df9-5f16-afd1-b26adde73a52" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308895}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308895} :answer-field/id #uuid "ad4741e0-f097-5cb6-bbf0-add403d4a44b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311294}] :question/id #uuid "90ebde0b-39f7-53e6-b891-41140a14fc75" :question/math-academy-id "q-336381" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,1,-1)$, $P(3,4,2)$ and $Q(-1,2,0).$\n\n$\\,y\\,-\\,z\\,-$\n{{field-1}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,1,-1⟩,\\,p=⟨3,4,2⟩,$ and $q=⟨-1,2,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,4,2⟩-⟨1,1,-1⟩ \\\\  & =⟨2,3,3⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨-1,2,0⟩-⟨1,1,-1⟩ \\\\  & =⟨-2,1,1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 3 \\\\ 3\\end{bmatrix}\\times \\begin{bmatrix}-2 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 & 3 \\\\ -2 & 1 & 1\\end{vmatrix} \\\\  & =0i-8j+8k \\\\  & =⟨0,-8,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,-8,8⟩ & =⟨3,4,2⟩\\cdot ⟨0,-8,8⟩ \\\\ r\\cdot ⟨0,-8,8⟩ & =-16\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,-8,8⟩ & =-16 \\\\ -8y+8z & =-16 \\\\ -8y+8z+16 & =0 \\\\ y-z-2 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb432540-1fcf-5293-9159-3760fb3980d6" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186310619}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186310619} :answer-field/id #uuid "0513cf96-93dc-524f-936b-6ac3cf3a7015" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310806} {:answer-field/choices [{:answer/id #uuid "e82ade4e-f022-5b8b-b609-90b4ef1a62a9" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186310592}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186310592} :answer-field/id #uuid "7000019d-143c-5832-869c-bbfdc4d09dd9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311091} {:answer-field/choices [{:answer/id #uuid "46d3f357-e4f8-5535-8109-12ac27e1bc4a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309290}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309290} :answer-field/id #uuid "c0a0a06e-de98-5dd9-8d9d-588e34cf9940" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311348}] :question/id #uuid "0b056d61-c09c-50b3-b173-38669f95fc26" :question/math-academy-id "q-336384" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(2,-2,1)$, $P(5,0,3)$ and $Q(1,1,-1).$\n\n{{field-1}}\n$x\\,-$\n{{field-2}}\n$y\\,-\\,11z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨2,-2,1⟩,\\,p=⟨5,0,3⟩,$ and $q=⟨1,1,-1⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨5,0,3⟩-⟨2,-2,1⟩ \\\\  & =⟨3,2,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,-1⟩-⟨2,-2,1⟩ \\\\  & =⟨-1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}-1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 3 & 2 & 2 \\\\ -1 & 3 & -2\\end{vmatrix} \\\\  & =-10i+4j+11k \\\\  & =⟨-10,4,11⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-10,4,11⟩ & =⟨5,0,3⟩\\cdot ⟨-10,4,11⟩ \\\\ r\\cdot ⟨-10,4,11⟩ & =-17\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-10,4,11⟩ & =-17 \\\\ -10x+4y+11z & =-17 \\\\ 10x-4y-11z & =17 \\\\ 10x-4y-11z-17 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a14273c4-973b-5e8e-bc83-453225164017" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186310052}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186310052} :answer-field/id #uuid "6874ae7e-e122-5cb2-8f2b-840a85daa817" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311067} {:answer-field/choices [{:answer/id #uuid "602c2e50-169c-5e1d-999d-cc423e1aea3e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309474}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309474} :answer-field/id #uuid "6efcf732-1c4e-54c7-b4b6-d6f298695ac0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311087} {:answer-field/choices [{:answer/id #uuid "8d8ab4ec-8327-5d8c-9b75-20218bf80f1d" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186309867}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186309867} :answer-field/id #uuid "a36b0722-c2b4-5bde-930b-01b7098a01cb" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311268}] :question/id #uuid "b8fc2917-9125-5430-b66d-89b52e1351ff" :question/math-academy-id "q-336450" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-4,3)$ and is parallel to the vectors ${v}_{1}=⟨1,-3,-2⟩$ and ${v}_{2}=⟨0,4,-1⟩.$\n\n{{field-1}}\n$x\\,+\\,y\\,+$\n{{field-2}} \n$z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,-4,3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 4 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & -3 & -2 \\\\ 0 & 4 & -1\\end{vmatrix} \\\\  & =11i+1j+4k \\\\  & =⟨11,1,4⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨11,1,4⟩ & =⟨2,-4,3⟩\\cdot ⟨11,1,4⟩ \\\\ r\\cdot ⟨11,1,4⟩ & =30\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨11,1,4⟩ & =30 \\\\ 11x+y+4z & =30 \\\\ 11x+y+4z-30 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4287f2-23fb-5921-a476-c54d401a558f" :answer/type {:db/ident :answer.type/math} :answer/value "x-y-4=0" :db/id #edb/ref 17592186312058} {:answer/id #uuid "1c55f330-a58c-50e4-baae-061ff856ae82" :answer/type {:db/ident :answer.type/math} :answer/value "5x-y-2z-4=0" :db/id #edb/ref 17592186312185} {:answer/id #uuid "3c31d601-a464-55b8-8619-a4f5cb6a3c35" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3z-4=0" :db/id #edb/ref 17592186312463} {:answer/id #uuid "8fef07d3-7bf2-538a-8dbe-c447310426b0" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+z+4=0" :db/id #edb/ref 17592186313123} {:answer/id #uuid "d6e5e999-43bb-571e-ad28-ea600f0a65f4" :answer/type {:db/ident :answer.type/math} :answer/value "5x-y-2z=0" :db/id #edb/ref 17592186313667}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5x-y-2z-4=0" :db/id #edb/ref 17592186312185} :answer-field/id #uuid "c2fa0fd7-88c8-56df-ac33-842b5a56dd52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314560}] :question/id #uuid "686d05b3-6ae6-58de-961c-a5d4a934cbc6" :question/math-academy-id "q-33913" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-1,1)$, $P(2,0,3)$ and $Q(1,1,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-1,1⟩,\\,p=⟨2,0,3⟩,$ and $q=⟨1,1,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨2,0,3⟩-⟨1,-1,1⟩ \\\\  & =⟨1,1,2⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨1,1,0⟩-⟨1,-1,1⟩ \\\\  & =⟨0,2,-1⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 1 & 1 & 2 \\\\ 0 & 2 & -1\\end{vmatrix} \\\\  & =-5i+j+2k \\\\  & =⟨-5,1,2⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,1,2⟩ & =⟨2,0,3⟩\\cdot ⟨-5,1,2⟩ \\\\ r\\cdot ⟨-5,1,2⟩ & =-4\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,1,2⟩ & =-4 \\\\ -5x+y+2z & =-4 \\\\ -5x+y+2z+4 & =0 \\\\ 5x-y-2z-4 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10191765-520e-51b1-b616-6aed299a1951" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y=0" :db/id #edb/ref 17592186336181} {:answer/id #uuid "7daf1c63-6468-51ad-b441-f7fb571f725e" :answer/type {:db/ident :answer.type/math} :answer/value "2x-3z+4=0" :db/id #edb/ref 17592186337169} {:answer/id #uuid "ba9bfc06-e53d-546a-8e5c-41d1b1999a5a" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2y-4=0" :db/id #edb/ref 17592186337685} {:answer/id #uuid "c52efad2-ab20-5349-b4af-05ecdf7d704d" :answer/type {:db/ident :answer.type/math} :answer/value "z-4=0" :db/id #edb/ref 17592186337785} {:answer/id #uuid "f09bbdc2-0929-5b68-b7a0-f2e4bd00ad0d" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-4=0" :db/id #edb/ref 17592186338137}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-4=0" :db/id #edb/ref 17592186338137} :answer-field/id #uuid "6f92cb71-8832-51de-ba25-618de4d73dc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338468}] :question/id #uuid "ee138f11-2a9e-5208-a49a-f5a947f6c08b" :question/math-academy-id "q-70833" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,0,-3)$ and is parallel to the vectors ${v}_{1}=⟨-3,2,0⟩$ and ${v}_{2}=⟨0,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,0,-3⟩.$\n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 0\\end{bmatrix}\\times \\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ -3 & 2 & 0 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =2i+3j \\\\  & =⟨2,3,0⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,3,0⟩ & =⟨2,0,-3⟩\\cdot ⟨2,3,0⟩ \\\\ r\\cdot ⟨2,3,0⟩ & =4\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,3,0⟩ & =4 \\\\ 2x+3y & =4 \\\\ 2x+3y-4 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f5bbffd-b662-53da-9146-542052fb7f6e" :answer/type {:db/ident :answer.type/math} :answer/value "-x+5y+5z+1=0" :db/id #edb/ref 17592186413719} {:answer/id #uuid "88552711-7258-529e-8575-2c6ac297ae0d" :answer/type {:db/ident :answer.type/math} :answer/value "-5x+5y+5z+10=0" :db/id #edb/ref 17592186413721} {:answer/id #uuid "88a1e7b7-4a66-5740-9c7e-14a39dd3849b" :answer/type {:db/ident :answer.type/math} :answer/value "5x+5y+5z-5=0" :db/id #edb/ref 17592186413722} {:answer/id #uuid "a3f975fc-9692-533a-ba00-bf7e8438a517" :answer/type {:db/ident :answer.type/math} :answer/value "5x-5y+5z-10=0" :db/id #edb/ref 17592186413726} {:answer/id #uuid "b5ddaec5-2f45-5d0e-8c08-e6549f59e357" :answer/type {:db/ident :answer.type/math} :answer/value "-5x+5y+5z+5=0" :db/id #edb/ref 17592186413727}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5x+5y+5z+10=0" :db/id #edb/ref 17592186413721} :answer-field/id #uuid "f3cdc898-7c65-52bc-9785-8f3da0b98b76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413733}] :question/id #uuid "fc9c30e8-905e-5cc3-9596-440fe740820a" :question/math-academy-id "q-128410" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,1)$, $P(3,-1,2)$ and $Q(4,2,0).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,1⟩,\\,p=⟨3,-1,2⟩,$ and $q=⟨4,2,0⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-1,2⟩-⟨1,-2,1⟩ \\\\  & =⟨2,1,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨4,2,0⟩-⟨1,-2,1⟩ \\\\  & =⟨3,4,-1⟩\\end{aligned}\n$$\n\n \n\nNow,  we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}3 \\\\ 4 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & 1 & 1 \\\\ 3 & 4 & -1\\end{vmatrix} \\\\  & =-5i+5j+5k \\\\  & =⟨-5,5,5⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,5,5⟩ & =⟨3,-1,2⟩\\cdot ⟨-5,5,5⟩ \\\\ r\\cdot ⟨-5,5,5⟩ & =-10\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,5,5⟩ & =-10 \\\\ -5x+5y+5z & =-10 \\\\ -5x+5y+5z+10 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "102de1fa-9039-5418-a721-6fc419237fc4" :answer/type {:db/ident :answer.type/math} :answer/value "x+5y+8z+9=0" :db/id #edb/ref 17592186419404} {:answer/id #uuid "90536ec6-2590-5af2-a702-9be2e4b1ecdc" :answer/type {:db/ident :answer.type/math} :answer/value "x+8y+5z+6=0" :db/id #edb/ref 17592186419409} {:answer/id #uuid "c7f81252-3be5-5daa-a718-63070020d187" :answer/type {:db/ident :answer.type/math} :answer/value "x-5y+8z+7=0" :db/id #edb/ref 17592186419413} {:answer/id #uuid "c8ca9437-ca61-5c50-96e0-f167dfcd51fe" :answer/type {:db/ident :answer.type/math} :answer/value "x+5y-8z+11=0" :db/id #edb/ref 17592186419414} {:answer/id #uuid "d6eccb3f-c3a2-58a8-b47e-683c853ab3af" :answer/type {:db/ident :answer.type/math} :answer/value "x+5y+9z+15=0" :db/id #edb/ref 17592186419415}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+5y+8z+9=0" :db/id #edb/ref 17592186419404} :answer-field/id #uuid "34e50549-8287-5dd0-82ee-b77b6017695a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419417}] :question/id #uuid "e08b1f6c-36a3-5d41-8737-49d26e8563c5" :question/math-academy-id "q-128459" :question/problem "Find a Cartesian equation of the plane that passes through the points $A(1,-2,0)$, $P(3,-4,1)$ and $Q(2,1,-2).$" :question/worked-solution "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,0⟩,\\,p=⟨3,-4,1⟩,$ and $q=⟨2,1,-2⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-4,1⟩-⟨1,-2,0⟩ \\\\  & =⟨2,-2,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨2,1,-2⟩-⟨1,-2,0⟩ \\\\  & =⟨1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =\\begin{bmatrix}2 \\\\ -2 \\\\ 1\\end{bmatrix}\\times \\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{vmatrix}i & j & k \\\\ 2 & -2 & 1 \\\\ 1 & 3 & -2\\end{vmatrix} \\\\  & =i+5j+8k \\\\  & =⟨1,5,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,5,8⟩ & =⟨3,-4,1⟩\\cdot ⟨1,5,8⟩ \\\\ r\\cdot ⟨1,5,8⟩ & =-9\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,5,8⟩ & =-9 \\\\ x+5y+8z & =-9 \\\\ x+5y+8z+9 & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of the Plane Parallel To Two Vectors"}] :topic/math-academy-id 1807 :topic/title "The Cartesian Equation of a Plane"}]}
