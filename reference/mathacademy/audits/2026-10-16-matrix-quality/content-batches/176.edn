-2y+z-13=0" :db/id #edb/ref 17592186261957}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x-y+2z-11=0" :db/id #edb/ref 17592186261695} :answer-field/id #uuid "5ed27435-6a6b-5a91-82c1-435b9c8e60ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262286}] :question/id #uuid "1247c7f3-ac99-5899-948f-91e6b23f17f0" :question/math-academy-id "q-127964" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(5,2,-1)$ and is perpendicular to the vector $n=3i-j+2k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨5,2,-1⟩$ and the normal vector of the plane is $n=⟨3,-1,2⟩.$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-1,2⟩ & =⟨5,2,-1⟩\\cdot ⟨3,-1,2⟩ \\\\ r\\cdot ⟨3,-1,2⟩ & =11.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-1,2⟩ & =11 \\\\ 3x-y+2z & =11 \\\\ 3x-y+2z-11 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411ca382-bf09-5d64-b04e-118a15b82b56" :answer/type {:db/ident :answer.type/math} :answer/value "4x+3y-z-11=0" :db/id #edb/ref 17592186260445} {:answer/id #uuid "54d729d8-bf79-548c-abf5-c9240fb50b33" :answer/type {:db/ident :answer.type/math} :answer/value "4x-3y-z+13=0" :db/id #edb/ref 17592186260594} {:answer/id #uuid "6751b20c-2d88-5607-b734-7aa1b9059535" :answer/type {:db/ident :answer.type/math} :answer/value "3x-4y-z+9=0" :db/id #edb/ref 17592186260778} {:answer/id #uuid "cdc5e1ea-63d3-5013-af1d-ebfbe1c3d3ad" :answer/type {:db/ident :answer.type/math} :answer/value "3x+4y-z-7=0" :db/id #edb/ref 17592186261690} {:answer/id #uuid "ce059a59-2378-51c5-9efb-e24a7f0e20ad" :answer/type {:db/ident :answer.type/math} :answer/value "x+3y-4z-17=0" :db/id #edb/ref 17592186261694}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x+4y-z-7=0" :db/id #edb/ref 17592186261690} :answer-field/id #uuid "0f194fa4-7f96-5976-a4a3-abc6280aecc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262150}] :question/id #uuid "d060436d-551e-5fcb-9a99-c81961b307b2" :question/math-academy-id "q-127967" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-2,3,-1)$ and is perpendicular to the vector $n=3i+4j-k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-2,3,-1⟩$ and the normal vector of the plane is $n=⟨3,4,-1⟩.$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,4,-1⟩ & =⟨-2,3,-1⟩\\cdot ⟨3,4,-1⟩ \\\\ r\\cdot ⟨3,4,-1⟩ & =7.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,4,-1⟩ & =7 \\\\ 3x+4y-z & =7 \\\\ 3x+4y-z-7 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d51072c-883a-525a-8646-40e5c82ad4e7" :answer/type {:db/ident :answer.type/math} :answer/value "-x+7y-2z+15=0" :db/id #edb/ref 17592186260127} {:answer/id #uuid "6326b3cd-0214-5827-9d35-baed2ba8695e" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y+z-11=0" :db/id #edb/ref 17592186260728} {:answer/id #uuid "8d5aca35-27e9-5c23-aff5-e71d615f9cfc" :answer/type {:db/ident :answer.type/math} :answer/value "7x-2y-z+19=0" :db/id #edb/ref 17592186261109} {:answer/id #uuid "91ea860c-4845-50a4-a075-2bb871d412bf" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y-z-14=0" :db/id #edb/ref 17592186261144} {:answer/id #uuid "d95aedb2-04eb-5ef6-a10d-ec449203a494" :answer/type {:db/ident :answer.type/math} :answer/value "-x+2y-7z-7=0" :db/id #edb/ref 17592186261794}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y-z-14=0" :db/id #edb/ref 17592186261144} :answer-field/id #uuid "c8e68f4b-4cc2-5e45-b811-88d387aeee6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262481}] :question/id #uuid "b7e0ef36-c57e-59d2-a0fa-0b27cc7256a8" :question/math-academy-id "q-127971" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-2,1,-3)$ and is perpendicular to the vector $n=⟨-2,7,-1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-2,1,-3⟩$ and the normal vector of the plane is $n=⟨-2,7,-1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,7,-1⟩ & =⟨-2,1,-3⟩\\cdot ⟨-2,7,-1⟩ \\\\ r\\cdot ⟨-2,7,-1⟩ & =14.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,7,-1⟩ & =14 \\\\ -2x+7y-z & =14 \\\\ -2x+7y-z-14 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130cc39a-be42-573b-a075-ac851c6972af" :answer/type {:db/ident :answer.type/math} :answer/value "3y-5z-26=0" :db/id #edb/ref 17592186302583} {:answer/id #uuid "16d9f5a1-4e5b-50a7-b3de-bbee67b28acd" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-5z+26=0" :db/id #edb/ref 17592186302604} {:answer/id #uuid "7d2796d6-1a82-5d74-a36f-0f34e5ab333d" :answer/type {:db/ident :answer.type/math} :answer/value "3y-5z+26=0" :db/id #edb/ref 17592186303238} {:answer/id #uuid "a6ad4e61-3414-5129-9cff-739a6125e65b" :answer/type {:db/ident :answer.type/math} :answer/value "3y-5z+24=0" :db/id #edb/ref 17592186303480} {:answer/id #uuid "d55212d8-f2ba-5bb1-a14c-962080164544" :answer/type {:db/ident :answer.type/math} :answer/value "3y+5z+26=0" :db/id #edb/ref 17592186303777}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3y-5z+26=0" :db/id #edb/ref 17592186303238} :answer-field/id #uuid "2ff8b302-c015-5365-8e07-707e1112c9ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304195}] :question/id #uuid "00e129f5-c1b2-5333-8f70-babdfeae2e75" :question/math-academy-id "q-330498" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-2,4)$ and is perpendicular to the vector $n=⟨0,3,-5⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,-2,4⟩$ and the normal vector of the plane is $n=⟨0,3,-5⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,3,-5⟩ & =⟨1,-2,4⟩\\cdot ⟨0,3,-5⟩ \\\\ r\\cdot ⟨0,3,-5⟩ & =-26\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,3,-5⟩ & =-26 \\\\ 3y-5z & =-26 \\\\ 3y-5z+26 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0069db2e-d01f-5ba7-85d5-c68688366845" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2y+z-10=0" :db/id #edb/ref 17592186302448} {:answer/id #uuid "11b6d126-fa6c-56bc-9471-56192788fff0" :answer/type {:db/ident :answer.type/math} :answer/value "x-6y-10=0" :db/id #edb/ref 17592186302572} {:answer/id #uuid "778cf533-1371-59ce-bb1d-6d0eb998dcc6" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2y-10=0" :db/id #edb/ref 17592186303194} {:answer/id #uuid "921363dd-3390-59eb-8778-51139591f588" :answer/type {:db/ident :answer.type/math} :answer/value "6x-y-10z=0" :db/id #edb/ref 17592186303363} {:answer/id #uuid "c92e6fbe-a6b2-5db7-9900-beeb71e27342" :answer/type {:db/ident :answer.type/math} :answer/value "6x+y-10=0" :db/id #edb/ref 17592186303690}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6x-2y-10=0" :db/id #edb/ref 17592186303194} :answer-field/id #uuid "2cd57c0c-5e4f-5559-b558-81cf8cdec69d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304184}] :question/id #uuid "03f5292d-2cbb-5362-966c-d91bc52e2d79" :question/math-academy-id "q-330500" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,1,-5)$ and is perpendicular to the vector $n=⟨6,-2,0⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨2,1,-5⟩$ and the normal vector of the plane is $n=⟨6,-2,0⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨6,-2,0⟩ & =⟨2,1,-5⟩\\cdot ⟨6,-2,0⟩ \\\\ r\\cdot ⟨6,-2,0⟩ & =10\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨6,-2,0⟩ & =10 \\\\ 6x-2y & =10 \\\\ 6x-2y-10 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144a3f0e-e55f-5127-8aba-d54af0f7928f" :answer/type {:db/ident :answer.type/math} :answer/value "x+y-z-18=0" :db/id #edb/ref 17592186302589} {:answer/id #uuid "3fd6d560-4786-54eb-abee-b673f3be01d2" :answer/type {:db/ident :answer.type/math} :answer/value "5x-3z-13=0" :db/id #edb/ref 17592186302857} {:answer/id #uuid "5d279caa-dcf7-5550-96a4-a74ca0a84887" :answer/type {:db/ident :answer.type/math} :answer/value "2x+4y-z-13=0" :db/id #edb/ref 17592186303024} {:answer/id #uuid "90379d74-6d2d-545b-ace3-86b0b2a1b6c1" :answer/type {:db/ident :answer.type/math} :answer/value "5x+y-3z-13=0" :db/id #edb/ref 17592186303357} {:answer/id #uuid "fa35067d-2265-5860-b10f-4d3a826a567a" :answer/type {:db/ident :answer.type/math} :answer/value "2x+4y+z+5=0" :db/id #edb/ref 17592186304025}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+4y-z-13=0" :db/id #edb/ref 17592186303024} :answer-field/id #uuid "de959850-4f0a-51e6-ac9c-e23d617a73d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304682}] :question/id #uuid "972806e5-5276-519b-b09e-86229dab2cf0" :question/math-academy-id "q-33067" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(5,0,-3)$ and is perpendicular to the vector $n=⟨2,4,-1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨5,0,-3⟩$ and the normal vector of the plane is $n=⟨2,4,-1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,4,-1⟩ & =⟨5,0,-3⟩\\cdot ⟨2,4,-1⟩ \\\\ r\\cdot ⟨2,4,-1⟩ & =13.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,4,-1⟩ & =13 \\\\ 2x+4y-z & =13 \\\\ 2x+4y-z-13 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab53ccfc-64b7-524d-968b-6893b62213d3" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-8z-7=0" :db/id #edb/ref 17592186303511} {:answer/id #uuid "dc7eaa38-3a98-5e4b-a287-9986a7293e04" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-8z-17=0" :db/id #edb/ref 17592186303832} {:answer/id #uuid "e6861164-b0cf-5ba0-aa1b-6cd1763beb2c" :answer/type {:db/ident :answer.type/math} :answer/value "-4x+3y-7=0" :db/id #edb/ref 17592186303889} {:answer/id #uuid "ea20f4fb-c33f-5d07-9c45-30c73baa36d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4x+3y+z+7=0" :db/id #edb/ref 17592186303918} {:answer/id #uuid "eaa011ee-143b-5ae4-8126-4b8c02ada24f" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-8z-1=0" :db/id #edb/ref 17592186303920}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-8z-7=0" :db/id #edb/ref 17592186303511} :answer-field/id #uuid "c8d1946d-38c1-56f9-8702-9b5223a6e94e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304623}] :question/id #uuid "6e8a4061-bb52-5786-a928-eac2a59e8597" :question/math-academy-id "q-33164" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-4,3,0)$ and is perpendicular to the vector $n=2i+5j-8k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-4,3,0⟩$ and the normal vector of the plane is $n=⟨2,5,-8⟩.$\n\nUsing the dot product we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,5,-8⟩ & =⟨-4,3,0⟩\\cdot ⟨2,5,-8⟩ \\\\ r\\cdot ⟨2,5,-8⟩ & =7.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,5,-8⟩ & =7 \\\\ 2x+5y-8z & =7 \\\\ 2x+5y-8z-7 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a74889-ac9d-5168-9bd6-c05b2e6eb04a" :answer/type {:db/ident :answer.type/math} :answer/value "2x+z-5=0" :db/id #edb/ref 17592186312163} {:answer/id #uuid "1ead3ef2-4480-5ec3-a602-0edf54b64bf5" :answer/type {:db/ident :answer.type/math} :answer/value "x+3z-5=0" :db/id #edb/ref 17592186312206} {:answer/id #uuid "6c95a8c3-59f1-52ca-bbe5-6e4745dae092" :answer/type {:db/ident :answer.type/math} :answer/value "2x-5y+z=0" :db/id #edb/ref 17592186312827} {:answer/id #uuid "db699c62-fa97-57d3-a15f-72ebf06976d1" :answer/type {:db/ident :answer.type/math} :answer/value "2x+2y+z-5=0" :db/id #edb/ref 17592186313701} {:answer/id #uuid "de95faa1-c022-587f-bbda-e098387dddda" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+3z-5=0" :db/id #edb/ref 17592186313725}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+z-5=0" :db/id #edb/ref 17592186312163} :answer-field/id #uuid "c1911110-c68f-571f-b041-6475b3b845e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314551}] :question/id #uuid "2229970c-380d-5c52-9385-f1cac1675d7c" :question/math-academy-id "q-33926" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,0,3)$ and is perpendicular to the vector $n=⟨2,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨1,0,3⟩$ and the normal vector of the plane is $n=⟨2,0,1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,0,1⟩ & =⟨1,0,3⟩\\cdot ⟨2,0,1⟩ \\\\ r\\cdot ⟨2,0,1⟩ & =5.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,0,1⟩ & =5 \\\\ 2x+z & =5 \\\\ 2x+z-5 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23935fc7-68d8-5aac-8f46-503e8ec88a71" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+3z+6=0" :db/id #edb/ref 17592186336366} {:answer/id #uuid "3ba1cad0-4734-5fa1-b087-ec9799500799" :answer/type {:db/ident :answer.type/math} :answer/value "-x+y-2z+6=0" :db/id #edb/ref 17592186336593} {:answer/id #uuid "93b0ebf0-a8e8-5f44-8eb9-023cde940780" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+3z+5=0" :db/id #edb/ref 17592186337381} {:answer/id #uuid "95222014-68cb-59f3-a573-b24be1101543" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+3z+8=0" :db/id #edb/ref 17592186337393} {:answer/id #uuid "980f75c8-ef08-5f4b-af72-5fc63238fa4f" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+2z-5=0" :db/id #edb/ref 17592186337419}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+y+3z+6=0" :db/id #edb/ref 17592186336366} :answer-field/id #uuid "c5064e0e-2c84-5880-be2a-969020b41c72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338632}] :question/id #uuid "c143f82e-4ed3-5f75-863a-8c48f0e6d896" :question/math-academy-id "q-70805" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-1,1,-2)$ and is perpendicular to the vector $n=i+j+3k.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-1,1,-2⟩$ and the normal vector of the plane is $n=⟨1,1,3⟩.$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,1,3⟩ & =⟨-1,1,-2⟩\\cdot ⟨1,1,3⟩ \\\\ r\\cdot ⟨1,1,3⟩ & =-6.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,1,3⟩ & =-6 \\\\ x+y+3z & =-6 \\\\ x+y+3z+6 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2717e35a-d5d8-5b8d-b82d-51c22326e847" :answer/type {:db/ident :answer.type/math} :answer/value "4x-y+z+2=0" :db/id #edb/ref 17592186413718} {:answer/id #uuid "9f69fd47-a1f5-5770-8c3d-1d9916854264" :answer/type {:db/ident :answer.type/math} :answer/value "4x+z-2=0" :db/id #edb/ref 17592186413723} {:answer/id #uuid "a34b8674-3166-5800-b2b6-3d8e2d749e97" :answer/type {:db/ident :answer.type/math} :answer/value "4x+z+2=0" :db/id #edb/ref 17592186413725} {:answer/id #uuid "bb1a451c-30a6-598a-a1e4-37120fd4f9f8" :answer/type {:db/ident :answer.type/math} :answer/value "x+4y+z+2=0" :db/id #edb/ref 17592186413728} {:answer/id #uuid "cf32c54e-7d9c-57e0-ac44-14a3df665bca" :answer/type {:db/ident :answer.type/math} :answer/value "4x+y+z+2=0" :db/id #edb/ref 17592186413729}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x+z+2=0" :db/id #edb/ref 17592186413725} :answer-field/id #uuid "261a61c5-5d9c-5e73-a9c8-99e605e6c3e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413732}] :question/id #uuid "d60eaae3-858a-5d2f-83b8-ccadfd1429d3" :question/math-academy-id "q-330499" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-1,3,2)$ and is perpendicular to the vector $n=⟨4,0,1⟩.$" :question/worked-solution "First, we note that the position vector of the point $P$ is $p=⟨-1,3,2⟩$ and the normal vector of the plane is $n=⟨4,0,1⟩.$\n\nUsing the dot product we can find an equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,0,1⟩ & =⟨-1,3,2⟩\\cdot ⟨4,0,1⟩ \\\\ r\\cdot ⟨4,0,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨4,0,1⟩ & =-2 \\\\ 4x+z & =-2 \\\\ 4x+z+2 & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of the Plane Perpendicular To a Given Vector"} {:db/id #edb/ref 17592186119833 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119644 :question/id #uuid "d92eb242-104f-55cd-82dc-7620e2f4e636" :question/math-academy-id "e-4937" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-1,4,8)$ and is perpendicular to the line \n$\\dfrac{x+3}{-5}=\\dfrac{y-1}{3}=\\dfrac{z+2}{2}.$" :question/worked-solution "First, we note that the position vector of $P$ is $\\mathbf{p}=\\langle -1,4,8 \\rangle.$ From the canonical equation, we find that the line is parallel to the vector $\\langle -5,3,2 \\rangle.$ So, the normal vector of the plane is \n\n$$\n\\mathbf{n}=\\langle -5,3,2 \\rangle.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-5,3,2⟩ & =⟨-1,4,8⟩\\cdot ⟨-5,3,2⟩ \\\\ r\\cdot ⟨-5,3,2⟩ & =33\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-5,3,2⟩ & =33 \\\\ -5x+3y+2z & =33 \\\\ -5x+3y+2z-33 & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "2173739c-cd59-58ed-a265-8ee88c982ae0" :knowledge-point/questions [{:db/id #edb/ref 17592186120233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0395970e-0d9a-5762-bb5c-e46f2d38b8c0" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y-5z+11=0" :db/id #edb/ref 17592186423949} {:answer/id #uuid "4b65c837-ece2-5b2d-a1d6-63cd8cc028b3" :answer/type {:db/ident :answer.type/math} :answer/value "x+3y-7=0" :db/id #edb/ref 17592186423953} {:answer/id #uuid "5e5c8545-4573-5ed8-bdbb-b47cb8a05b58" :answer/type {:db/ident :answer.type/math} :answer/value "x+3y-1=0" :db/id #edb/ref 17592186423954} {:answer/id #uuid "a9e87eac-968b-5331-95b6-4aa94e8c328b" :answer/type {:db/ident :answer.type/math} :answer/value "2y+z+7=0" :db/id #edb/ref 17592186423956} {:answer/id #uuid "c2a52ec1-f084-5a8c-880c-5ed843166cc3" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y-5z+7=0" :db/id #edb/ref 17592186423958}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x-y-5z+7=0" :db/id #edb/ref 17592186423958} :answer-field/id #uuid "cc839475-9e1b-518e-9233-6715536351ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117557}] :question/id #uuid "e3a2e450-d136-5240-a920-568065ef68bb" :question/math-academy-id "q-33146" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,2,1)$ and is perpendicular to the line \n$\\frac{x-1}{-2}=\\frac{y-3}{1}=\\frac{z}{5}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,2,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-2,1,5⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-2,1,5⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,1,5⟩ & =⟨0,2,1⟩\\cdot ⟨-2,1,5⟩ \\\\ r\\cdot ⟨-2,1,5⟩ & =7\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,1,5⟩ & =7 \\\\ -2x+y+5z & =7 \\\\ -2x+y+5z-7 & =0 \\\\ 2x-y-5z+7 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a569713-1980-5360-a5a7-e64596f5fef8" :answer/type {:db/ident :answer.type/math} :answer/value "8x+3y-z-42=0" :db/id #edb/ref 17592186303007} {:answer/id #uuid "9793b331-23e7-53ab-a79a-90019f4af6a0" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+y+2z-42=0" :db/id #edb/ref 17592186303398} {:answer/id #uuid "dd7b10d6-e284-5047-ac5a-3540420c0f16" :answer/type {:db/ident :answer.type/math} :answer/value "4x+3y-z=0" :db/id #edb/ref 17592186303842} {:answer/id #uuid "f605912d-f296-5e78-b0e3-1cfdef5c5a80" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+y+2z=0" :db/id #edb/ref 17592186304003} {:answer/id #uuid "fbb41d38-6777-5b29-9db2-82a1b459da22" :answer/type {:db/ident :answer.type/math} :answer/value "4x+3y-z-42=0" :db/id #edb/ref 17592186304036}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x+3y-z-42=0" :db/id #edb/ref 17592186304036} :answer-field/id #uuid "0e617e69-db16-53f5-ac12-a24c8d9c3852" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304101}] :question/id #uuid "b0dec6df-1301-5550-8bf9-7363cae85702" :question/math-academy-id "q-33165" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(8,3,-1)$ and is perpendicular to the line \n$\\frac{x+2}{4}=\\frac{y-1}{3}=\\frac{z-2}{-1}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨8,3,-1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨4,3,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨4,3,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,3,-1⟩ & =⟨8,3,-1⟩\\cdot ⟨4,3,-1⟩ \\\\ r\\cdot ⟨4,3,-1⟩ & =42\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨4,3,-1⟩ & =42 \\\\ 4x+3y-z & =42 \\\\ 4x+3y-z-42 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fc24ad-0a55-5ba6-86e2-72a7e2faa119" :answer/type {:db/ident :answer.type/math} :answer/value "-2y+7z+10=0" :db/id #edb/ref 17592186259912} {:answer/id #uuid "66d86e94-8732-54fa-bd6e-cefef51a308b" :answer/type {:db/ident :answer.type/math} :answer/value "-x+7z+5=0" :db/id #edb/ref 17592186260772} {:answer/id #uuid "6c7b8d10-0fc7-5e18-a928-bc79f2161f52" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7y-10=0" :db/id #edb/ref 17592186260827} {:answer/id #uuid "872e0d66-ed64-5fa5-9fa4-d541c030c090" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+7z+20=0" :db/id #edb/ref 17592186261053} {:answer/id #uuid "b9d3d9de-db57-5987-ac48-3ee9c443029a" :answer/type {:db/ident :answer.type/math} :answer/value "-7x+7y+7z-20=0" :db/id #edb/ref 17592186261502}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2x+7z+20=0" :db/id #edb/ref 17592186261053} :answer-field/id #uuid "64f04d84-a350-591e-8cad-0290a83a08b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262294}] :question/id #uuid "5c46eaba-babf-598a-bbbb-00b2297bd0d9" :question/math-academy-id "q-128375" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(3,0,-2)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=7-2t \\\\ y &=7 \\\\ z &=7t\\end{aligned}\\right..$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,0,-2⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨-2,0,7⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-2,0,7⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,0,7⟩ & =⟨3,0,-2⟩\\cdot ⟨-2,0,7⟩ \\\\ r\\cdot ⟨-2,0,7⟩ & =-20.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,0,7⟩ & =-20 \\\\ -2x+7z & =-20 \\\\ -2x+7z+20 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c68694d-6618-534f-92a7-bd2167bf9cfd" :answer/type {:db/ident :answer.type/math} :answer/value "-x-y+z+1=0" :db/id #edb/ref 17592186260664} {:answer/id #uuid "9668328b-dd01-52ef-a2f2-c043826d2c23" :answer/type {:db/ident :answer.type/math} :answer/value "x-y-z+3=0" :db/id #edb/ref 17592186261178} {:answer/id #uuid "98a8daa1-6508-5a17-a74c-7d0641516440" :answer/type {:db/ident :answer.type/math} :answer/value "x+y-z+6=0" :db/id #edb/ref 17592186261198} {:answer/id #uuid "a2d37a90-e0f8-5347-9040-4a09d7753dc3" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+z-6=0" :db/id #edb/ref 17592186261296} {:answer/id #uuid "a9e2401c-4add-51dd-8da3-6fcbf664c2a5" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+z-3=0" :db/id #edb/ref 17592186261362}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+y-z+6=0" :db/id #edb/ref 17592186261198} :answer-field/id #uuid "9a505006-158e-56ec-be3a-13c758fba6b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262401}] :question/id #uuid "c43ec9b4-fb75-54f1-9dd3-fda6dabf447d" :question/math-academy-id "q-128376" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-5,2)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=3+t \\\\ y &=t \\\\ z &=7-t\\end{aligned}\\right..$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-5,2⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨1,1,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨1,1,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,1,-1⟩ & =⟨1,-5,2⟩\\cdot ⟨1,1,-1⟩ \\\\ r\\cdot ⟨1,1,-1⟩ & =-6.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,1,-1⟩ & =-6 \\\\ x+y-z & =-6 \\\\ x+y-z+6 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280d2e89-c3f5-5191-859c-002f7d1d6dca" :answer/type {:db/ident :answer.type/math} :answer/value "3x-5y+z+1=0" :db/id #edb/ref 17592186302715} {:answer/id #uuid "3537ab24-c238-5848-8ae5-5ed96c1361f9" :answer/type {:db/ident :answer.type/math} :answer/value "-3x+4z+1=0" :db/id #edb/ref 17592186302787} {:answer/id #uuid "6d2e1a28-b548-5422-a0a4-3c14076cccdf" :answer/type {:db/ident :answer.type/math} :answer/value "-3x+y+4z-1=0" :db/id #edb/ref 17592186303120} {:answer/id #uuid "9d1c65af-d3a6-51b9-87f0-3dcea485d3fc" :answer/type {:db/ident :answer.type/math} :answer/value "3x-5y+2z+1=0" :db/id #edb/ref 17592186303435} {:answer/id #uuid "f689b81d-7063-5e1e-9aaf-49529b0a36a6" :answer/type {:db/ident :answer.type/math} :answer/value "-5x+3y+2z+1=0" :db/id #edb/ref 17592186304004}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x-5y+2z+1=0" :db/id #edb/ref 17592186303435} :answer-field/id #uuid "b8f97666-3ba0-509b-8f76-1eba3f70428a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304577}] :question/id #uuid "6438ac3c-8420-5b05-be4d-39c722849ed1" :question/math-academy-id "q-33162" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,0,4)$ and is perpendicular to the line \n$r=\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-3,0,4⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨3,-5,2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,-5,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-5,2⟩ & =⟨-3,0,4⟩\\cdot ⟨3,-5,2⟩ \\\\ r\\cdot ⟨3,-5,2⟩ & =-1.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-5,2⟩ & =-1 \\\\ 3x-5y+2z & =-1 \\\\ 3x-5y+2z+1 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ebcc58c-3918-5971-8319-5cd009e22c10" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186308850}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186308850} :answer-field/id #uuid "00949ed5-4f72-5085-865e-8ff2e6b32aa5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310793} {:answer-field/choices [{:answer/id #uuid "8b488120-28cf-5e4a-b809-5c7970270675" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309843}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309843} :answer-field/id #uuid "b1ba0da6-c9b8-5145-b089-e43a8228fd9d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311311} {:answer-field/choices [{:answer/id #uuid "f4ff3f1c-912d-5bd4-aad4-c46e4201501d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310696}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310696} :answer-field/id #uuid "ddac13c1-1e39-5170-8def-6350cdacd6d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311439}] :question/id #uuid "da280df0-7d7a-5d86-8e85-f52e5903aba5" :question/math-academy-id "q-336110" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-2,5)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=4+3t \\\\ y &=1-4t \\\\ z &=-3-2t\\end{aligned}\\right..$\n\n{{field-1}}\n$x\\,-4y\\,-\\,$ \n{{field-2}} $z\\,-$\n{{field-3}}$\\,=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-2,5⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨3,-4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,-4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-4,-2⟩ & =⟨1,-2,5⟩\\cdot ⟨3,-4,-2⟩ \\\\ r\\cdot ⟨3,-4,-2⟩ & =1\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-4,-2⟩ & =1 \\\\ 3x-4y-2z & =1 \\\\ 3x-4y-2z-1 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb4622ed-9eb6-5ab5-b09f-f59678e58176" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310755}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310755} :answer-field/id #uuid "9111dd74-21be-5107-89db-711f1d689b9f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311203} {:answer-field/choices [{:answer/id #uuid "2e83fa3a-3413-5d19-8fa6-0a79d47eec96" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186309102}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186309102} :answer-field/id #uuid "9bf5b2eb-fbfa-5d61-8ec3-aa4076b08859" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311244} {:answer-field/choices [{:answer/id #uuid "ddb1d17c-d1bc-5a82-8d25-eb41948deb28" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310524}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310524} :answer-field/id #uuid "adbc801d-93a1-5b8a-b526-ca60531ec87a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311296}] :question/id #uuid "8add1d49-d5c8-5e59-a059-69a179339ffb" :question/math-academy-id "q-336111" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-3,4,1)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=-1+2t \\\\ y &=5+3t \\\\ z &=7-t\\end{aligned}\\right..$\n\n{{field-1}}$\\,x\\,+\\,$\n{{field-2}}\n$y\\,-\\,z\\,-\\,$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-3,4,1⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨2,3,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨2,3,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,3,-1⟩ & =⟨-3,4,1⟩\\cdot ⟨2,3,-1⟩ \\\\ r\\cdot ⟨2,3,-1⟩ & =5\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,3,-1⟩ & =5 \\\\ 2x+3y-z & =5 \\\\ 2x+3y-z-5 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0edc0a0f-2cbe-5823-9fd4-9455494e4db0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308854}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186308854} :answer-field/id #uuid "ca83f76c-8072-5d0c-88b4-bea69dee4f00" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311379} {:answer-field/choices [{:answer/id #uuid "5102665c-8d9c-5af5-9e98-1b4f15580f39" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309360}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309360} :answer-field/id #uuid "d4d09ea0-2e9b-5d82-98cc-d6d208beec43" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311415} {:answer-field/choices [{:answer/id #uuid "8a059327-7f8d-5c0c-b3ff-4d8452e915d4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309833}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309833} :answer-field/id #uuid "edd4c1b4-3940-59d1-97f2-9b321d1dc3db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311488}] :question/id #uuid "556f46a4-05a0-5daf-9526-dc3855ec8f34" :question/math-academy-id "q-336112" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-1,3)$ and is perpendicular to the line \n$r=\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ -4 \\\\ 2\\end{bmatrix}.$\n\n$x\\,-\\,$\n{{field-1}}\n$y\\,+$\n{{field-2}}\n$z\\,-\\,$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-1,3⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨1,-4,2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨1,-4,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,-4,2⟩ & =⟨2,-1,3⟩\\cdot ⟨1,-4,2⟩ \\\\ r\\cdot ⟨1,-4,2⟩ & =12\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,-4,2⟩ & =12 \\\\ x-4y+2z & =12 \\\\ x-4y+2z-12 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcefed56-4038-52f8-9f7f-eb79fbac52c5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186310279}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186310279} :answer-field/id #uuid "526b627c-ea2e-56a3-b719-9b27238d70b7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311006} {:answer-field/choices [{:answer/id #uuid "b701a41d-caa6-5b6b-b7ea-02cf09f48a40" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310232}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186310232} :answer-field/id #uuid "a799307c-dd75-558e-b577-b483cae79109" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311276} {:answer-field/choices [{:answer/id #uuid "f83624ab-ca02-5f56-b5a5-00c4b2cc4485" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310726}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310726} :answer-field/id #uuid "c51c5119-11d8-58d9-a87c-7d239e283f10" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311362}] :question/id #uuid "45673dfb-d60d-5849-951f-95ea52c6f106" :question/math-academy-id "q-336201" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(-2,3,1)$ and is perpendicular to the line \n$r=\\begin{bmatrix}1 \\\\ -1 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -5 \\\\ 2\\end{bmatrix}.$\n\n$3x\\,-\\,$\n{{field-1}}\n$y\\,+\\,$\n{{field-2}}\n$z\\,+$\n{{field-3}}\n\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨-2,3,1⟩.$  From the vectorial equation, we find that the line is parallel to the vector $⟨3,-5,2⟩.$  So, the normal vector of the plane is \n\n$$\nn=⟨3,-5,2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-5,2⟩ & =⟨-2,3,1⟩\\cdot ⟨3,-5,2⟩ \\\\ r\\cdot ⟨3,-5,2⟩ & =-19\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-5,2⟩ & =-19 \\\\ 3x-5y+2z & =-19 \\\\ 3x-5y+2z+19 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b698b8d-d838-569e-8743-c7334a7dd440" :answer/type {:db/ident :answer.type/math} :answer/value "4y+2z-4=0" :db/id #edb/ref 17592186309583} {:answer/id #uuid "a0f0c8b9-bc37-5bfb-9929-0df4d8029937" :answer/type {:db/ident :answer.type/math} :answer/value "4y+z-3=0" :db/id #edb/ref 17592186310049} {:answer/id #uuid "a57fb5b0-6222-58fe-bfc1-5e5325cd7d81" :answer/type {:db/ident :answer.type/math} :answer/value "4y+z-4=0" :db/id #edb/ref 17592186310083} {:answer/id #uuid "b5a86eb1-28e1-5734-84d2-b468a6108b74" :answer/type {:db/ident :answer.type/math} :answer/value "x+4y+z-4=0" :db/id #edb/ref 17592186310216} {:answer/id #uuid "cfa6a16f-d3a1-5a8e-b635-4f53092ff5f1" :answer/type {:db/ident :answer.type/math} :answer/value "4y-z-4=0" :db/id #edb/ref 17592186310419}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4y+z-4=0" :db/id #edb/ref 17592186310083} :answer-field/id #uuid "c0d80fa9-92b4-56ea-bacd-670e1a568b19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311349}] :question/id #uuid "69ff4417-28a7-50ac-aae7-8483ea57f4a8" :question/math-academy-id "q-336213" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,1,0)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=1 \\\\ y &=-2+4t \\\\ z &=3+t\\end{aligned}\\right..$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,1,0⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨0,4,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨0,4,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,4,1⟩ & =⟨2,1,0⟩\\cdot ⟨0,4,1⟩ \\\\ r\\cdot ⟨0,4,1⟩ & =4\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,4,1⟩ & =4 \\\\ 4y+z & =4 \\\\ 4y+z-4 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17793687-91b7-5e39-8c30-e05f6c7e9d4b" :answer/type {:db/ident :answer.type/math} :answer/value "4x-2z-6=0" :db/id #edb/ref 17592186308932} {:answer/id #uuid "4bd4c4c1-dbf1-5146-b731-536aabaaf317" :answer/type {:db/ident :answer.type/math} :answer/value "4x-y-2z-3=0" :db/id #edb/ref 17592186309326} {:answer/id #uuid "b00c9fd6-291a-54bf-aa04-8f9a4c5b1b89" :answer/type {:db/ident :answer.type/math} :answer/value "4x+y-2z-5=0" :db/id #edb/ref 17592186310169} {:answer/id #uuid "de96c60a-1e6f-5bba-8fc7-038c86c7b674" :answer/type {:db/ident :answer.type/math} :answer/value "4x+y+2z-3=0" :db/id #edb/ref 17592186310536} {:answer/id #uuid "f6ab27ed-0b38-5cf5-9b46-80e61fe105aa" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-2z-3=0" :db/id #edb/ref 17592186310707}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4x-2z-6=0" :db/id #edb/ref 17592186308932} :answer-field/id #uuid "a5573a7b-0f09-50b5-bd07-bcff38daef8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311270}] :question/id #uuid "c9d64ce1-7855-51fd-a302-1dae7b7afa6a" :question/math-academy-id "q-336407" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-3,1)$ and is perpendicular to the line \n$r=\\begin{bmatrix}-1 \\\\ 4 \\\\ 2\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-3,1⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨4,0,-2⟩.$ So, the normal vector of the plane is\n\n$$\nn=⟨4,0,-2⟩,\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,0,-2⟩ & =⟨2,-3,1⟩\\cdot ⟨4,0,-2⟩ \\\\ r\\cdot ⟨4,0,-2⟩ & =6\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute  $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨4,0,-2⟩ & =3 \\\\ 4x-2z & =6 \\\\ 4x-2z-6 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eaadc80-2b16-539b-a368-a16f47e8ad0b" :answer/type {:db/ident :answer.type/math} :answer/value "5x-3z-12=0" :db/id #edb/ref 17592186308848} {:answer/id #uuid "abb27324-f6d9-5bc6-8149-a4879a7a061b" :answer/type {:db/ident :answer.type/math} :answer/value "5y-3x+12=0" :db/id #edb/ref 17592186310136} {:answer/id #uuid "b25e3f58-14d4-5ddb-a833-9135fa659667" :answer/type {:db/ident :answer.type/math} :answer/value "5y-3z-12=0" :db/id #edb/ref 17592186310190} {:answer/id #uuid "cb0b4341-b875-5124-a2f5-e73cd8ad57ca" :answer/type {:db/ident :answer.type/math} :answer/value "x-3z-12=0" :db/id #edb/ref 17592186310374} {:answer/id #uuid "ce61ca74-92fc-59e3-8309-f252d8951690" :answer/type {:db/ident :answer.type/math} :answer/value "5x-3z+12=0" :db/id #edb/ref 17592186310406}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5x-3z-12=0" :db/id #edb/ref 17592186308848} :answer-field/id #uuid "91db78ac-e8b6-5cd5-a2ae-1be0b76a5d9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311207}] :question/id #uuid "9f9042cb-d3d8-5370-a9db-8978ddd34aee" :question/math-academy-id "q-336538" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(3,-2,1)$ and is perpendicular to the line \n\n$$\n\\frac{x-1}{5}=\\frac{z+2}{-3},\\,y=4\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨3,-2,1⟩.$ From the Cartesian equation, we find that the line is parallel to the vector $⟨5,0,-3⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,0,-3⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,0,-3⟩ & =⟨3,-2,1⟩\\cdot ⟨5,0,-3⟩ \\\\ r\\cdot ⟨5,0,-3⟩ & =12\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,0,-3⟩ & =12 \\\\ 5x-3z & =12 \\\\ 5x-3z-12 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c006e5-3f7e-5051-858d-4500712511f5" :answer/type {:db/ident :answer.type/math} :answer/value "x-4y+z+14=0" :db/id #edb/ref 17592186309366} {:answer/id #uuid "60ed1dfd-51f0-598a-b06f-b0ee5a9100fd" :answer/type {:db/ident :answer.type/math} :answer/value "x+4y+14=0" :db/id #edb/ref 17592186309485} {:answer/id #uuid "9f48ce73-6192-528e-8095-135366ecf8b5" :answer/type {:db/ident :answer.type/math} :answer/value "x+4y+z+10=0" :db/id #edb/ref 17592186310034} {:answer/id #uuid "ceb7e276-0387-5607-bbd3-dd25d74ffab5" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y+14=0" :db/id #edb/ref 17592186310409} {:answer/id #uuid "dc96b7ad-2b24-5c90-9fa9-5a875768683a" :answer/type {:db/ident :answer.type/math} :answer/value "x+4y-2z+13=0" :db/id #edb/ref 17592186310517}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x+4y+14=0" :db/id #edb/ref 17592186309485} :answer-field/id #uuid "ae155145-cf8c-585f-a832-9bff4daf4c4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311298}] :question/id #uuid "ebf2e85f-ac82-5cbe-8701-83e9058f130b" :question/math-academy-id "q-336540" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,-4,1)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=-2+t \\\\ y &=1+4t \\\\ z &=5\\end{aligned}\\right..$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-4,1⟩.$  From the parametrical equation, we find that the line is parallel to the vector $⟨1,4,0⟩.$  So, the normal vector of the plane is \n\n$$\nn=⟨1,4,0⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,4,0⟩ & =⟨2,-4,1⟩\\cdot ⟨1,4,0⟩ \\\\ r\\cdot ⟨1,4,0⟩ & =-14\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,4,0⟩ & =-14 \\\\ x+4y & =-14 \\\\ x+4y+14 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e82b227-9a56-5114-8d60-f1db519ee0d8" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+y+z-2=0" :db/id #edb/ref 17592186336168} {:answer/id #uuid "8f404ec9-8911-54fa-8613-a6198b2c338f" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-z-14=0" :db/id #edb/ref 17592186337324} {:answer/id #uuid "a94ce30c-4842-5698-bc28-64b32c7460e1" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-2z-2=0" :db/id #edb/ref 17592186337560} {:answer/id #uuid "b98b2fc3-d714-56e3-8598-185596415529" :answer/type {:db/ident :answer.type/math} :answer/value "2x-z-14=0" :db/id #edb/ref 17592186337676} {:answer/id #uuid "bad68854-37a9-54dc-a14b-ae58354b47a9" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-2z-14=0" :db/id #edb/ref 17592186337689}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3x+2y-2z-14=0" :db/id #edb/ref 17592186337689} :answer-field/id #uuid "23126fc2-1b82-57e0-8166-f43f5a36d945" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338343}] :question/id #uuid "743ee1e7-8110-5025-8c98-4fb7a2685168" :question/math-academy-id "q-70809" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(2,3,-1)$ and is perpendicular to the line \n$r=\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 2 \\\\ -2\\end{bmatrix}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,3,-1⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨3,2,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨3,2,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,2,-2⟩ & =⟨2,3,-1⟩\\cdot ⟨3,2,-2⟩ \\\\ r\\cdot ⟨3,2,-2⟩ & =14.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,2,-2⟩ & =14 \\\\ 3x+2y-2z & =14 \\\\ 3x+2y-2z-14 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186363934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de24ce31-8567-5933-91b9-84ce46195f82" :answer/type {:db/ident :answer.type/math} :answer/value "5y-4z+2=0" :db/id #edb/ref 17592186363936} {:answer/id #uuid "f47bdf6d-aa44-5993-8a4f-e55f9cddaa83" :answer/type {:db/ident :answer.type/math} :answer/value "y-4z+2=0" :db/id #edb/ref 17592186363937} {:answer/id #uuid "a3a0927d-77b7-5bf0-bc22-7b9ddcfd7658" :answer/type {:db/ident :answer.type/math} :answer/value "5y-4z-22=0" :db/id #edb/ref 17592186363938} {:answer/id #uuid "9c6c0173-9824-5097-808b-03437fc112f5" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4z+2=0" :db/id #edb/ref 17592186363939} {:answer/id #uuid "c1a6b20d-9141-5a21-8147-f66bb2f7a01f" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4y-22=0" :db/id #edb/ref 17592186363940}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5y-4z+2=0" :db/id #edb/ref 17592186363936} :answer-field/id #uuid "c325860e-c4c3-52ab-a5ca-c8d3a61bbc17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363935}] :question/id #uuid "2b22ad79-7dea-54b4-b8ec-aee9009a09ff" :question/math-academy-id "q-336218" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,2,3)$ and is perpendicular to the line \n\n$$\n\\frac{y-3}{-5}=\\frac{z}{4},\\,x=1\n$$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,2,3⟩.$ From the Cartesian equation, we find that the line is parallel to the vector $⟨0,-5,4⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨0,-5,4⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨0,-5,4⟩ & =⟨0,2,3⟩\\cdot ⟨0,-5,4⟩ \\\\ r\\cdot ⟨0,-5,4⟩ & =2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨0,-5,4⟩ & =2 \\\\ -5y+4z & =2 \\\\ -5y+4z-2 & =0 \\\\ 5y-4z+2 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186364302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181df3ad-19a0-57f1-abe1-34809fb363ad" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-z-4=0" :db/id #edb/ref 17592186364304} {:answer/id #uuid "f4ea7f46-b7b5-5164-9296-a5705c866cc9" :answer/type {:db/ident :answer.type/math} :answer/value "x+y+z-5=0" :db/id #edb/ref 17592186364305} {:answer/id #uuid "2bb82e7a-c0b7-5eef-ac04-7f9df3f862fb" :answer/type {:db/ident :answer.type/math} :answer/value "x+y-4=0" :db/id #edb/ref 17592186364306} {:answer/id #uuid "9cec7669-a89f-53aa-9859-52e8d03c3787" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-z-5=0" :db/id #edb/ref 17592186364307} {:answer/id #uuid "fdabf384-2f71-5d7f-a659-8e78a851ba26" :answer/type {:db/ident :answer.type/math} :answer/value "3x+y-z-5=0" :db/id #edb/ref 17592186364308}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+3y-z-5=0" :db/id #edb/ref 17592186364307} :answer-field/id #uuid "8e8ea1c7-6edb-564b-ac95-d5d2b72cd2e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364303}] :question/id #uuid "091b9ad4-6dc4-5677-b067-721682dcc589" :question/math-academy-id "q-70811" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,1,0)$ and is perpendicular to the line \n$r=\\begin{bmatrix}3 \\\\ 1 \\\\ -1\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ -3 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,1,0⟩.$ From the vectorial equation, we find that the line is parallel to the vector $⟨-2,-3,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-2,-3,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-2,-3,1⟩ & =⟨1,1,0⟩\\cdot ⟨-2,-3,1⟩ \\\\ r\\cdot ⟨-2,-3,1⟩ & =-5.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,-3,1⟩ & =-5 \\\\ -2x-3y+z & =-5 \\\\ -2x-3y+z+5 & =0 \\\\ 2x+3y-z-5 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186413735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2493b28e-9805-515c-9bb7-52400b1ebad9" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-z+3=0" :db/id #edb/ref 17592186413717} {:answer/id #uuid "5c7649c7-0f92-5513-b462-907271b682a9" :answer/type {:db/ident :answer.type/math} :answer/value "3z+3=0" :db/id #edb/ref 17592186413720} {:answer/id #uuid "a11ad414-7674-5c26-950f-59f6a219f5d2" :answer/type {:db/ident :answer.type/math} :answer/value "2x-z+3=0" :db/id #edb/ref 17592186413724} {:answer/id #uuid "d3c26dd6-942b-51e3-9221-ce5b6eff63d3" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-z-4=0" :db/id #edb/ref 17592186413730} {:answer/id #uuid "d4795ff7-792e-54da-b148-8c4ee1d289d5" :answer/type {:db/ident :answer.type/math} :answer/value "2x+5y+z-4=0" :db/id #edb/ref 17592186413731}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2x+5y-z+3=0" :db/id #edb/ref 17592186413717} :answer-field/id #uuid "f6c20a87-b8c2-530d-b3e1-fb8bd507d26c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413734}] :question/id #uuid "34ca6320-0524-59fc-8f68-7b8524566ac6" :question/math-academy-id "q-70815" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(0,0,3)$ and is perpendicular to the line \n$\\left\\{\\begin{aligned}x &=2+2t \\\\ y &=5t \\\\ z &=1-t\\end{aligned}\\right..$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨0,0,3⟩.$ From the parametrical equation, we find that the line is parallel to the vector $⟨2,5,-1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨2,5,-1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨2,5,-1⟩ & =⟨0,0,3⟩\\cdot ⟨2,5,-1⟩ \\\\ r\\cdot ⟨2,5,-1⟩ & =-3.\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above. Hence,\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,5,-1⟩ & =-3 \\\\ 2x+5y-z & =-3 \\\\ 2x+5y-z+3 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66b70f6a-e851-54e5-aa28-b6a025e9ece5" :answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186419408}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186419408} :answer-field/id #uuid "2f1bb041-bd3b-51ec-95b9-ab27a720aff3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419416} {:answer-field/choices [{:answer/id #uuid "b0061273-aae7-5a50-ba3b-7dbc44ba608c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186419411}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186419411} :answer-field/id #uuid "51f6537d-feab-5ce3-9fc6-f89624d037a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419418} {:answer-field/choices [{:answer/id #uuid "373d6628-e7af-5c99-8ea7-bda3f45e1294" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186419407}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186419407} :answer-field/id #uuid "c79424ce-ee00-57d0-b195-b7db6dde7351" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419420}] :question/id #uuid "53aad395-ec2e-5a47-9cdb-e404625e4482" :question/math-academy-id "q-330576" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$\\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.$\n\n{{field-1}}\n$x\\,+4y\\,-$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c0fd5d-eb30-51ed-9d57-ff0d86d1b905" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+z-2=0" :db/id #edb/ref 17592186419403} {:answer/id #uuid "25dcf144-1a51-5366-9800-5383c00b5a7d" :answer/type {:db/ident :answer.type/math} :answer/value "x-2y-z-2=0" :db/id #edb/ref 17592186419405} {:answer/id #uuid "2b822cf8-78b8-5c6f-ba5e-a61ce1027e3a" :answer/type {:db/ident :answer.type/math} :answer/value "x-2y-z-5=0" :db/id #edb/ref 17592186419406} {:answer/id #uuid "aaf4ea99-1c7e-5b6b-af27-f81db06966e0" :answer/type {:db/ident :answer.type/math} :answer/value "-x-2y-z-5=0" :db/id #edb/ref 17592186419410} {:answer/id #uuid "b32a3885-cdf4-51dc-ad0e-0a3c46647043" :answer/type {:db/ident :answer.type/math} :answer/value "x-y+z-5=0" :db/id #edb/ref 17592186419412}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x-2y-z-2=0" :db/id #edb/ref 17592186419405} :answer-field/id #uuid "b30e511f-0a3e-547f-96f1-0bfc53ad4766" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419419}] :question/id #uuid "70aeaa22-2b90-533e-ab1d-9dbd9f885f48" :question/math-academy-id "q-70807" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(1,-1,1)$ and is perpendicular to the line \n$\\frac{x-2}{-1}=\\frac{y-1}{2}=\\frac{z+1}{1}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨1,-1,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-1,2,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-1,2,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,1⟩ & =⟨1,-1,1⟩\\cdot ⟨-1,2,1⟩ \\\\ r\\cdot ⟨-1,2,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-1,2,1⟩ & =-2 \\\\ -x+2y+z & =-2 \\\\ -x+2y+z+2 & =0 \\\\ x-2y-z-2 & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186423157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e5c1f6-5233-50a9-a0c7-3d8454d96058" :answer/type {:db/ident :answer.type/math} :answer/value "4x+5y+2z-49=0" :db/id #edb/ref 17592186423137} {:answer/id #uuid "44b25bde-c138-5e61-9bfe-10c541da03de" :answer/type {:db/ident :answer.type/math} :answer/value "5x-4y-2z-53=0" :db/id #edb/ref 17592186423138} {:answer/id #uuid "8a9aa20e-7044-5fe9-999a-ca209eb00faf" :answer/type {:db/ident :answer.type/math} :answer/value "5x+4y+2z-36=0" :db/id #edb/ref 17592186423140} {:answer/id #uuid "b722b988-b76f-5900-8ce4-497e838c929c" :answer/type {:db/ident :answer.type/math} :answer/value "4x-5y-2z-17=0" :db/id #edb/ref 17592186423145} {:answer/id #uuid "dd9f7bca-6210-53d4-939e-d73b38d6642a" :answer/type {:db/ident :answer.type/math} :answer/value "5x+4y-2z-57=0" :db/id #edb/ref 17592186423151}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5x+4y-2z-57=0" :db/id #edb/ref 17592186423151} :answer-field/id #uuid "ab781c91-252d-5387-b0ba-ee29d18b5ea0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423154}] :question/id #uuid "2a383fb4-f81d-5536-bfab-907adbefb459" :question/math-academy-id "q-128372" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$\\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Cartesian Equation of the Plane Perpendicular To a Given Line"} {:db/id #edb/ref 17592186119834 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119645 :question/id #uuid "aa7c3400-9bc0-5f3a-84e5-f3cc2bb87f5d" :question/math-academy-id "e-4938" :question/problem "Given the Cartesian equation $2x-y+z+13=0$ of the plane $\\Pi,$ find an equation of $\\Pi$ in the form $(\\mathbf{r}-\\mathbf{p})\\cdot\\mathbf{n}=0.$" :question/worked-solution "First, from the coefficients in equation of the plane, we get that the normal vector of $\\Pi$ is $\\mathbf{n}=\\langle 2,-1,1 \\rangle.$\n\nNow, we solve the Cartesian equation of $\\Pi$ for $z\\mathbin{:}$\n\n$$\n\\begin{aligned}2x-y+z+13 & =0 \\\\ z & =-2x+y-13\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0,$ we get $z=-13.$ So, the point $P(0,0,-13)$ lies on $\\Pi.$ Note that the position vector of $P$ is $\\mathbf{p}=\\langle 0,0,-13 \\rangle.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-13⟩)\\cdot ⟨2,-1,1⟩ & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/questions [{:db/id #edb/ref 17592186120282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c147174b-1e66-5bb1-8e90-13814203679e" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0,-11⟩) \\cdot ⟨1, 3, 1⟩ = 0" :db/id #edb/ref 17592186117832} {:answer/id #uuid "d67d2b5f-fede-5695-9b57-a3bf50396308" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0, 11⟩) \\cdot ⟨ - 3, 1, 1⟩ = 0" :db/id #edb/ref 17592186117833} {:answer/id #uuid "efb55b6a-d8c7-500a-b6f7-0d6c187cceb0" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0,-11⟩) \\cdot ⟨1,-3, 1⟩ = 0" :db/id #edb/ref 17592186117834} {:answer/id #uuid "6665d96e-fec2-578e-a9c9-f2cbc92cbb45" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0,-11⟩) \\cdot ⟨0,-3, 0⟩ = 0" :db/id #edb/ref 17592186117835} {:answer/id #uuid "69727246-18cc-5acd-9b31-f362752065f7" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0, 11⟩) \\cdot ⟨1,-3, 1⟩ = 0" :db/id #edb/ref 17592186117836}] :answer-field/id #uuid "5e55607d-6cce-5bdc-89f8-814be1f46e74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117831}] :question/id #uuid "2f27f995-465d-53e3-bd9f-87302aae4193" :question/math-academy-id "q-33911" :question/problem "Given the Cartesian equation $x - 3y + z + 11 = 0$ of the plane $Π$, find an equation of $Π$ in the form $(r - p) \\cdot n = 0$."} {:db/id #edb/ref 17592186120284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9283ff37-3e4f-5163-ad99-71efe40ad5f9" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0, 1⟩) \\cdot ⟨ - 1,-1, 16⟩ = 0" :db/id #edb/ref 17592186117844} {:answer/id #uuid "ac70ffe8-eae8-556a-97d5-052b005eed8d" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0, 1⟩) \\cdot ⟨1,-1, 4⟩ = 0" :db/id #edb/ref 17592186117845} {:answer/id #uuid "bd828451-41f3-5243-bda4-b6fab3137715" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0,-4⟩) \\cdot ⟨1,-1, 4⟩ = 0" :db/id #edb/ref 17592186117846} {:answer/id #uuid "02b09862-2f48-5ea4-bf9b-bda41a4c4028" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0, 4⟩) \\cdot ⟨1,-1, 4⟩ = 0" :db/id #edb/ref 17592186117847} {:answer/id #uuid "4f5f9c12-c888-5da9-9418-2ad33e18b29e" :answer/type {:db/ident :answer.type/math} :answer/value "(r - ⟨0, 0,-1⟩) \\cdot ⟨1, 0, 4⟩ = 0" :db/id #edb/ref 17592186117848}] :answer-field/id #uuid "2cadd5d9-6b27-5ebe-b532-ee330506bfa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117843} {:answer-field/choices [{:answer/id #uuid "7132a908-b9cb-56e3-80b1-38fb5d14b3a5" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,1⟩)\\cdot ⟨-1,-1,16⟩=0" :db/id #edb/ref 17592186391743} {:answer/id #uuid "02494726-37b0-5e7b-ad3c-0180bececdfc" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-4⟩)\\cdot ⟨1,-1,4⟩=0" :db/id #edb/ref 17592186391744} {:answer/id #uuid "a7ff3e24-bbb2-547d-9f0d-bbf347c313df" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-1⟩)\\cdot ⟨1,0,4⟩=0" :db/id #edb/ref 17592186391745} {:answer/id #uuid "ef59ef21-d4e1-5b2a-82ab-a424aa93aa72" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,4⟩)\\cdot ⟨1,-1,4⟩=0" :db/id #edb/ref 17592186391746} {:answer/id #uuid "875a9589-3b53-5b62-afd7-0ad0dc57bbe2" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,1⟩)\\cdot ⟨1,-1,4⟩=0" :db/id #edb/ref 17592186391747}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-4⟩)\\cdot ⟨1,-1,4⟩=0" :db/id #edb/ref 17592186391744} :answer-field/id #uuid "5f0ed6f5-6be8-59e5-9f66-3f6c05ef700b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391742}] :question/id #uuid "2d949e3c-e35b-5754-bfa5-04230aa782a1" :question/math-academy-id "q-33923" :question/problem "Given the Cartesian equation $x-y+4z+16=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨1,-1,4⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}x-y+4z+16 & =0 \\\\ z & =-\\frac{1}{4}x+\\frac{1}{4}y-4.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=-4.$ Hence, the point $P(0,0,-4)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-4⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-4⟩)\\cdot ⟨1,-1,4⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87268c-9742-5090-b7cb-521a5d8bbe66" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,1⟩)\\cdot ⟨2,4,-4⟩=0" :db/id #edb/ref 17592186260021} {:answer/id #uuid "a390ff13-0937-5eb3-b38b-3df5883b8889" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨-4,4,-2⟩=0" :db/id #edb/ref 17592186261300} {:answer/id #uuid "def43d7d-583f-5acb-a4e0-a37562571a5c" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,-2,4⟩=0" :db/id #edb/ref 17592186261844} {:answer/id #uuid "f4c13bd5-c05b-5f70-93b5-0ba177da222f" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩=0" :db/id #edb/ref 17592186262013} {:answer/id #uuid "ffcc7a65-376c-57d0-ac3e-a501019e18ce" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨4,4,2⟩=0" :db/id #edb/ref 17592186262119}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩=0" :db/id #edb/ref 17592186262013} :answer-field/id #uuid "7b80e560-2ad7-58b7-9b2c-28eb67acbc7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262329}] :question/id #uuid "0f6aca53-4308-58bc-afcc-f2738d69d1e0" :question/math-academy-id "q-128380" :question/problem "Given the Cartesian equation $4x+4y-2z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨4,4,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}4x+4y-2z & =0 \\\\ 2z & =4x+4y \\\\ z & =2x+2y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "651b8de1-bfcf-5968-bd65-75bfaff53a19" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-21⟩)\\cdot ⟨5,0,-1⟩=0" :db/id #edb/ref 17592186260747} {:answer/id #uuid "85a251a4-8626-5a48-8978-5be3141abf43" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-15⟩)\\cdot ⟨-1,5,0⟩=0" :db/id #edb/ref 17592186261035} {:answer/id #uuid "96ee2d72-498d-5cd2-92b2-c9ee6d6979c9" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨0,-1,5⟩=0" :db/id #edb/ref 17592186261182} {:answer/id #uuid "a0d35c29-d1ec-5549-bbc6-6fa5edd439de" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,11⟩)\\cdot ⟨0,5,1⟩=0" :db/id #edb/ref 17592186261274} {:answer/id #uuid "f35bd877-7bda-5cdd-bb0d-81ebd993a270" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,17⟩)\\cdot ⟨0,5,-1⟩=0" :db/id #edb/ref 17592186262002}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,17⟩)\\cdot ⟨0,5,-1⟩=0" :db/id #edb/ref 17592186262002} :answer-field/id #uuid "922d17c5-e5bc-5723-a873-fd95d3df5865" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262381}] :question/id #uuid "fda593ff-14ab-57bf-9851-b4c04717562e" :question/math-academy-id "q-128383" :question/problem "Given the Cartesian equation $5y-z+17=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,5,-1⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5y-z+17 & =0 \\\\ z & =5y+17.\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=17.$ Hence, the point $P(0,0,17)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,17⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,17⟩)\\cdot ⟨0,5,-1⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e8d53b-177d-5796-8cf7-52c015fc02a7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300384}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300384} :answer-field/id #uuid "11b7d2ed-536b-5849-8e7d-54f3dbfbb735" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301284} {:answer-field/choices [{:answer/id #uuid "8de30fa2-0c67-5646-bab5-d1acac95ffaf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300681}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300681} :answer-field/id #uuid "2eae7c05-5e89-5f2f-b6dd-83424a9cf5ce" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301372} {:answer-field/choices [{:answer/id #uuid "27084236-e409-5976-ba9d-d171f96debd1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300148}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300148} :answer-field/id #uuid "6d7b439f-d927-5a9b-940c-4e51f8e79127" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301567}] :question/id #uuid "b8f8613f-ede8-5b23-9e9a-6a90b747b545" :question/math-academy-id "q-326901" :question/problem "Given the Cartesian equation $2x-y+2z+6=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$ \n{{field-1}}\n$⟩)\\cdot ⟨2,$\n{{field-2}}\n, \n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨2,-1,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}2x-y+2z+6 & =0 \\\\ z & =-x+\\frac{y}{2}-3.\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=-3.$ Hence, the point $P(0,0,-3)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-3⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-3⟩)\\cdot ⟨2,-1,2⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e77dac35-f79f-5bc2-9fde-1d8139793b4d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310587}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186310587} :answer-field/id #uuid "6747872f-f63f-52c6-9f61-19718f0a2359" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311064} {:answer-field/choices [{:answer/id #uuid "b3875a94-efdb-5eca-baf2-d84143e12286" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310199}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310199} :answer-field/id #uuid "936c951d-ff8e-5b6e-89ac-24ab5c66011f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311210} {:answer-field/choices [{:answer/id #uuid "370e6e98-3c53-5434-9334-94895858c8d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186309168}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186309168} :answer-field/id #uuid "cce56c2d-29c3-5fd6-b50e-1beeeb3c5b54" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311390}] :question/id #uuid "dc5e8637-ca14-5006-a320-1c33620f30f4" :question/math-academy-id "q-336220" :question/problem "Given the Cartesian equation $3x+y+2z+4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨$ \n{{field-2}}\n$,1\\,,$\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨3,1,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}3x+y+2z+4 & =0 \\\\ 2z & =-3x-y-4 \\\\ z & =-\\frac{3}{2}x-\\frac{1}{2}y-2\\end{aligned}\n$$\n\nIf we put $x=0$ and $y=0$, we get $z=-2.$ Hence, the point $P(0,0,-2)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-2⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-2⟩)\\cdot ⟨3,1,2⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a084ee0-627b-5a25-87e5-c96f7478912e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309063}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309063} :answer-field/id #uuid "7003a65b-3fe7-5632-99c3-efacb8b557f3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311092} {:answer-field/choices [{:answer/id #uuid "447e12cd-