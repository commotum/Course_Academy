d #uuid "2fcba3ec-3924-5c7c-a6a1-31abde659b6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}s^{2}+4t^{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186564802} {:answer/id #uuid "471eebba-45ac-52c2-bb59-5c8ad7552e88" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4st \\\\ s^{2}-4t^{2}\\end{bmatrix}" :db/id #edb/ref 17592186564807} {:answer/id #uuid "63c855f7-0c11-50cb-87cf-dc1bd6ed8ab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-s^{2}-4t^{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186564812} {:answer/id #uuid "a6aaa9f1-3064-5f40-a602-1b018e6219bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}s^{2} \\\\ -2st\\end{bmatrix}" :db/id #edb/ref 17592186564827} {:answer/id #uuid "a8f2e479-015c-5ea1-87bd-82c8d9886d40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4t^{2} \\\\ 2st\\end{bmatrix}" :db/id #edb/ref 17592186564828}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}s^{2}+4t^{2} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186564802} :answer-field/id #uuid "5284937d-e740-5453-9287-cfdb09da10e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564809}] :question/id #uuid "67304dbe-e65f-5876-9cc1-3261493580e8" :question/problem "Find $Mz$ if \n$M=\\begin{bmatrix}s & 2t \\\\ -2t & s\\end{bmatrix}$\nand\n$z=\\begin{bmatrix}s \\\\ 2t\\end{bmatrix}.$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Mz & =\\begin{bmatrix}s & 2t \\\\ -2t & s\\end{bmatrix}\\begin{bmatrix}s \\\\ 2t\\end{bmatrix} \\\\  & =\\begin{bmatrix}s\\cdot s+2t\\cdot 2t \\\\ (-2t)\\cdot s+s\\cdot 2t\\end{bmatrix} \\\\  & =\\begin{bmatrix}s^{2}+4t^{2} \\\\ -2st+2st\\end{bmatrix} \\\\  & =\\begin{bmatrix}s^{2}+4t^{2} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 1759