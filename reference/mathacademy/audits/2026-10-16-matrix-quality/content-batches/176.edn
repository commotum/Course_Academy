\\,2\\,,1⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "983ac607-b7d8-5a59-ba8c-c3d73aead01c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309972}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186309972} :answer-field/id #uuid "8fe851a5-475e-5e00-ae87-a44650a48c05" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311200} {:answer-field/choices [{:answer/id #uuid "39d38379-3377-58a7-b66e-226c76d0f0ff" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186309191}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186309191} :answer-field/id #uuid "c534bce9-2049-5269-add0-acbf6bd23974" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311363} {:answer-field/choices [{:answer/id #uuid "3d82f8bf-6b6a-5e27-bfa7-8709039830a2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309216}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309216} :answer-field/id #uuid "c967a25c-f606-5cfa-b6b7-b9ce29d1b714" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311374}] :question/id #uuid "90a83aba-f17d-5cf5-b908-89b87fad5bea" :question/math-academy-id "q-336229" :question/problem "Given the Cartesian equation $5x+2z-8=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨5,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨5,0,2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}5x+2z-8 & =0 \\\\ z & =-\\frac{5}{2}x+4\\end{aligned}\n$$\n\nIf we put, say, $x=0,$ we get $z=4.$ Hence, the point $P(0,0,4)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,4⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,4⟩)\\cdot ⟨5,0,2⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c41f3d-5996-54ab-934e-b5526604547a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310443}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186310443} :answer-field/id #uuid "4c583d5c-c776-5f72-9c2f-d90ee50557e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310994} {:answer-field/choices [{:answer/id #uuid "f681872c-91f8-5414-8018-47869e55ecc9" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186310706}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186310706} :answer-field/id #uuid "ad0c9c01-8da4-50d1-828f-206ea43f1949" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311293} {:answer-field/choices [{:answer/id #uuid "2dbe44a6-4370-5b71-adaf-8fda69b11328" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186309092}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186309092} :answer-field/id #uuid "bfe3bcc6-012e-591c-b518-45d3e3ee895b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311345}] :question/id #uuid "db62087a-6baa-53ef-9e04-a1fd4ede9961" :question/math-academy-id "q-336239" :question/problem "Given the Cartesian equation $9x-3y+6=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,$\n{{field-1}}$\\,,0$\n\n$⟩)\\cdot ⟨$\n{{field-2}}\n,\n{{field-3}}\n$,0⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨9,-3,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}9x-3y+6 & =0 \\\\ -3y & =-9x-6 \\\\ y & =3x+2\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=2.$ Hence, the point $P(0,2,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,2,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,2,0⟩)\\cdot ⟨9,-3,0⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ac71e4-1f43-51f8-bfa4-a92855f4700b" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309261}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309261} :answer-field/id #uuid "7faaceec-cd8b-568a-858c-271760090279" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311144} {:answer-field/choices [{:answer/id #uuid "580b7964-a0b4-59ea-bd21-b56d80484ba8" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309413}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309413} :answer-field/id #uuid "93f3390e-533a-5d25-83c0-c5daa77f3ccf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311213} {:answer-field/choices [{:answer/id #uuid "0ccc2dae-6d3d-5c97-a2ff-2660720cb731" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186308836}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186308836} :answer-field/id #uuid "95d0ab30-64b1-59c5-b1be-e3cbd8256de2" :answer-field/key "field-1