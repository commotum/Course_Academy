:answer-field/choices [{:answer/id #uuid "bd0b6d3c-19ad-5656-a24c-0eaccad786d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2a+c \\\\ 4b+6d\\end{bmatrix}" :db/id #edb/ref 17592186564829} {:answer/id #uuid "d346e130-2f7a-5f8c-a46b-910ecb262145" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2a+3c \\\\ 4b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564834} {:answer/id #uuid "ddffb2c9-f575-5113-a158-3808a4bbd078" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2a+3c \\\\ 6b+6d\\end{bmatrix}" :db/id #edb/ref 17592186564836} {:answer/id #uuid "e26315f9-3af5-54e9-aaff-9c2e7e4a16cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+3c \\\\ 4b+6d\\end{bmatrix}" :db/id #edb/ref 17592186564837} {:answer/id #uuid "e6dcfe63-a455-5d3a-96c8-c490e0334f2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2a+3c \\\\ 4b+6d\\end{bmatrix}" :db/id #edb/ref 17592186564838}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2a+3c \\\\ 4b+6d\\end{bmatrix}" :db/id #edb/ref 17592186564838} :answer-field/id #uuid "cedaf9b8-8a3b-57cb-9e36-4def813e6c30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564832}] :question/id #uuid "f00d00ce-421f-50d1-bb29-f9b6797cda13" :question/problem "Find $Ax$ if\n$A = \\begin{bmatrix}a & c \\\\ 2b & 2d\\end{bmatrix}$\nand\n$x = \\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$." :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =\\begin{bmatrix}a & c \\\\ 2b & 2d\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\ & =\\begin{bmatrix}a\\cdot 2+c\\cdot 3 \\\\ 2b\\cdot 2+2d\\cdot 3\\end{bmatrix} \\\\ & =\\begin{bmatrix}2a+3c \\\\ 4b+6d\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186564840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "745c8ec3-ae62-5e3b-b6d9-bcf6571faacd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+c \\\\ b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564817} {:answer/id #uuid "827d2af4-2794-5d61-9084-9899833adacc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+2c \\\\ b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564819} {:answer/id #uuid "8c9700cf-cd0a-5600-94a1-78293a426c5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6a+2c \\\\ b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564822} {:answer/id #uuid "c868914e-80f6-580f-a58e-37b2ba156acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+2c \\\\ 2b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564830} {:answer/id #uuid "d0fa1408-3d85-5508-9714-e2aa37808ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+2c \\\\ b+d\\end{bmatrix}" :db/id #edb/ref 17592186564833}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a+2c \\\\ b+2d\\end{bmatrix}" :db/id #edb/ref 17592186564819} :answer-field/id #uuid "5153c977-ef10-5450-bc37-08dfa786973d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564808}] :question/id #uuid "f194822e-641e-5dbc-922a-c09d1ee8c7ac" :question/problem "Find $Ax$ if\n$A = \\begin{bmatrix}3a & c \\\\ b & d\\end{bmatrix}$\nand\n$x = \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$." :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =\\begin{bmatrix}3a & c \\\\ b & d\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix} \\\\ & =\\begin{bmatrix}3a\\cdot 1+c\\cdot 2 \\\\ b\\cdot 1+d\\cdot 2\\end{bmatrix} \\\\ & =\\begin{bmatrix}3a+2c \\\\ b+2d\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :topic/math-academy-id 1195 :topic/title "Multiplying a Matrix by a Column Vector"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186120715} :activity/id #uuid "80511d12-b7f3-5570-8b75-694c2aa3ad46" :activity/steps [{:db/id #edb/ref 17592186120715 :step/content {:db/id #edb/ref 17592186121050 :tutorial/content "If we are given an equation of a plane using the dot product, we can always obtain an equation in terms of $x,$ $y,$ and $z.$ For example, suppose we have the plane that passes through the point $P(-7,5,-2)$ and is perpendicular to the vector $\\mathbf{n}=\\langle 3,-6,5 \\rangle.$\n\nFirst, we note that the position vector of the point $P$ is $\\mathbf{p}=\\langle -7,5,-2 \\rangle,$ and we can write down the equation of the plane using the dot product:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,-6,5⟩ & =⟨-7,5,-2⟩\\cdot ⟨3,-6,5⟩ \\\\ r\\cdot ⟨3,-6,5⟩ & =-61\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation, we substitute $\\mathbf{r}=\\langle x,y,z \\rangle$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨3,-6,5⟩ & =-61 \\\\ 3x-6y+5z & =-61 \\\\ 3x-6y+5z+61 & =0.\\end{aligned}\n$$\n\nThis final equation is called the **Cartesian equation of the plane**.\n\n![](images/77/77f18981dda500889655225eabbec730b7b295e6b16cec1700d56c2e27e0ac91.png)\n\nNote that in the equation \n\n$$\n{\\color{blue}3}x+({\\color{blue}-6})y+{\\color{blue}5}z+61 = 0,\n$$\n\nthe coefficients next to $x,$ $y,$ and $z$ are the coordinates of the normal vector \n\n$$\n\\mathbf{n}=\\langle {\\color{blue}3},{\\color{blue}-6},{\\color{blue}5} \\rangle\n$$\n\n." :tutorial/id #uuid "81332607-6152-5770-b33d-8b80c630fc8d" :tutorial/math-academy-id 3256 :tutorial/title "Introduction"} :step/id #uuid "c247ca81-f4a5-53d1-8429-f69593877343" :step/next {:db/id #edb/ref 17592186120716}} {:db/id #edb/ref 17592186120716 :step/content {:db/id #edb/ref 17592186119832 :knowledge-point/id #uuid "b34272b7-a7ad-5a58-974e-54cca957d06e"} :step/id #uuid "7a8bd938-5945-5ebb-a062-1d4409d4ccd2" :step/next {:db/id #edb/ref 17592186120717}} {:db/id #edb/ref 17592186120717 :step/content {:db/id #edb/ref 17592186119833 :knowledge-point/id #uuid "2173739c-cd59-58ed-a265-8ee88c982ae0"} :step/id #uuid "38691512-c8ac-58b3-b639-597249a111ce" :step/next {:db/id #edb/ref 17592186120718}} {:db/id #edb/ref 17592186120718 :step/content {:db/id #edb/ref 17592186119834 :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3"} :step/id #uuid "4e18819d-30d0-5673-a2f4-2264aa09fbde" :step/next {:db/id #edb/ref 17592186120719}} {:db/id #edb/ref 17592186120719 :step/content {:db/id #edb/ref 17592186119835 :knowledge-point/id #uuid "0efe5b11-2c87-58e9-bf7c-e1eecb07adf2"} :step/id #uuid "311c08f2-aa3d-5ea5-8386-44e9771e47c6"}] :activity/title "The Cartesian Equation of a Plane" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186120018} {:activity/first-step {:db/id #edb/ref 17592186419424} :activity/id #uuid "0a7d7d24-69e8-5aec-803a-f5712a252473" :activity/steps [{:db/id #edb/ref 17592186419424 :step/content {:db/id #edb/ref 17592186419422 :question/id #uuid "70aeaa22-2b90-533e-ab1d-9dbd9f885f48"} :step/id #uuid "4426cd88-0ed0-5a8a-bd40-151d1e9d59dd" :step/next {:db/id #edb/ref 17592186419428}} {:db/id #edb/ref 17592186419425 :step/content {:db/id #edb/ref 17592186419421 :question/id #uuid "53aad395-ec2e-5a47-9cdb-e404625e4482"} :step/id #uuid "62621dfb-b37e-5d44-bdc0-8c2aa74e902d" :step/next {:db/id #edb/ref 17592186419426}} {:db/id #edb/ref 17592186419426 :step/content {:db/id #edb/ref 17592186311671 :question/id #uuid "04886b81-54da-502a-b95c-1502eb418ce2"} :step/id #uuid "6908c1c1-4988-5f64-8e7b-f1732fcb1a7f"} {:db/id #edb/ref 17592186419427 :step/content {:db/id #edb/ref 17592186419423 :question/id #uuid "e08b1f6c-36a3-5d41-8737-49d26e8563c5"} :step/id #uuid "6d308039-35f2-59e5-b262-324c1a8c2bf2" :step/next {:db/id #edb/ref 17592186419425}} {:db/id #edb/ref 17592186419428 :step/content {:db/id #e