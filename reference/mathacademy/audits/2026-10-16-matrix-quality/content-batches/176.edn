/ident :answer-field.type/blank} :db/id #edb/ref 17592186292504}] :question/id #uuid "0acb0306-19c3-5eb9-9570-254f38d04dde" :question/math-academy-id "q-275589" :question/problem "Find $Ha$ if\n$H=\\begin{bmatrix}4 & 2 \\\\ -3 & 6\\end{bmatrix}$\nand\n$a=\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}.$\n\n| $Ha=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}Ha=\\begin{bmatrix}4 & 2 \\\\ -3 & 6\\end{bmatrix}\\begin{bmatrix}7 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}4\\cdot 7+2\\cdot 3 \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}34 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}Ha=\\begin{bmatrix}4 & 2 \\\\ -3 & 6\\end{bmatrix}\\begin{bmatrix}7 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}34 \\\\ -3\\cdot 7+6\\cdot 3\\end{bmatrix}=\\begin{bmatrix}34 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$Ha=\\begin{bmatrix}34 \\\\ -3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6511398-87a7-5a97-9019-de163bcd8589" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186298471}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186298471} :answer-field/id #uuid "4ce02690-633e-5560-854e-b877f4b6e53a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298894} {:answer-field/choices [{:answer/id #uuid "00ceebbc-8a68-5fa8-98d9-171cf8eb58b5" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186297552}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186297552} :answer-field/id #uuid "b74a3435-80b0-56da-9d2d-54a2017fc702" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299255}] :question/id #uuid "f86a8d09-8955-5065-97fa-d72868178f2c" :question/math-academy-id "q-318640" :question/problem "Compute the following:\n\n| $\\begin{bmatrix}0 & 11 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}0 & 11 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}0\\cdot 5+11\\cdot (-1) \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}-11 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}0 & 11 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}-11 \\\\ (-3)\\cdot 5+2\\cdot (-1)\\end{bmatrix}=\\begin{bmatrix}-11 \\\\ -17\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{bmatrix}0 & 11 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}-11 \\\\ -17\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "870297b1-7500-5a20-a6b1-e81b43473cf9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298137}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298137} :answer-field/id #uuid "32699cda-5915-5f3d-b0c7-b5c0647e0284" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298810} {:answer-field/choices [{:answer/id #uuid "7de0f2e8-64ff-5886-8923-da8a8b127afd" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186298098}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186298098} :answer-field/id #uuid "6d7fa884-da30-56a5-8320-6176e7495b0c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299003}] :question/id #uuid "a0f60f35-e715-5fe3-a08e-1735aa11be89" :question/math-academy-id "q-318644" :question/problem "Compute the following:\n\n| $\\begin{bmatrix}-7 & 3 \\\\ 5 & 8\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}-7 & 3 \\\\ 5 & 8\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}(-7)\\cdot 4+3\\cdot (-2) \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}-34 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}-7 & 3 \\\\ 5 & 8\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}-34 \\\\ 5\\cdot 4+8\\cdot (-2)\\end{bmatrix}=\\begin{bmatrix}-34 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{bmatrix}-7 & 3 \\\\ 5 & 8\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}-34 \\\\ 4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186388410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7840ff0a-b146-552d-bf1c-3cccb7cecd26" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 \\\\ 16\\end{bmatrix}" :db/id #edb/ref 17592186388412} {:answer/id #uuid "54e90248-65a5-530d-a396-9916371e3e0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186388413} {:answer/id #uuid "ecfd7b09-17e6-50c6-9a70-669a2e3ae08c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186388414} {: