ices [{:answer/id #uuid "0277c4bf-919b-5267-9625-3ce886304e59" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483573} {:answer/id #uuid "2f2d0592-797e-5802-8ca4-8a2a42612d69" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186483647} {:answer/id #uuid "6c724853-4dc1-5954-a54d-2cd8c40b90e7" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186483777} {:answer/id #uuid "827c6d51-bd40-574d-b735-ef588e897657" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186483832} {:answer/id #uuid "f04249bb-8ff4-5ab0-bd54-1f9f6f447fd3" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186484043}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186483777} :answer-field/id #uuid "23681fe8-270b-5047-9929-75e3e8fd1007" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484099}] :question/id #uuid "3d069a94-d7d6-5988-ba00-dc610c0a1a5e" :question/math-academy-id "q-82194" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & -1 & 0 & 2 \\\\ 1 & 0 & \\sqrt{3} & 1 \\\\ -7 & 1 & -1 & -7 \\\\ 3 & 0 & \\sqrt{3} & 3\\end{aligned}|,\\,|B|=|\\begin{aligned}0 & -2 & 0.5 \\\\ 3 & -3 & \\sqrt{5} \\\\ 0 & 0 & 0\\end{aligned}|,\\,|C|=|\\begin{aligned}7 & 1 & 0 \\\\ 0 & -1 & \\sqrt{3} \\\\ 0 & 0 & -2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has identical columns: \n\n$$\nA=\\begin{bmatrix}2 & -1 & 0 & 2 \\\\ 1 & 0 & \\sqrt{3} & 1 \\\\ -7 & 1 & -1 & -7 \\\\ 3 & 0 & \\sqrt{3} & 3\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ has a zero row: \n\n$$\nB=\\begin{bmatrix}0 & -2 & 0.5 \\\\ 3 & -3 & \\sqrt{5} \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- Since $C$ is a triangular matrix, we obtain \n\n$$\n|C|=7\\cdot (-1)\\cdot (-2)=14\\ne 0.\n$$\n\nTherefore, only $|A|$ and $|B|$ are equal to $0.$"} {:db/id #edb/ref 17592186484278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1567e615-6ab4-5dfa-a4ee-bb5f68553e0c" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186483603} {:answer/id #uuid "a382ca9c-09f6-5fe7-ae8f-109968b53e3e" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483903} {:answer/id #uuid "b4309380-2eb3-5ecd-b864-93456f98633e" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$" :db/id #edb/ref 17592186483925} {:answer/id #uuid "cda12a20-ad57-5314-886c-4677c2cad21f" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$" :db/id #edb/ref 17592186483979} {:answer/id #uuid "ea65d58a-0ecc-516b-bd6b-912a169e765a" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186484030}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186483903} :answer-field/id #uuid "a79e0fe4-97d1-5338-b5f9-fcb08969416e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484165}] :question/id #uuid "cf8a8a57-6cfe-5981-b026-15b496e6e0d3" :question/math-academy-id "q-82193" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}5 & -4 & 0 \\\\ 0 & -1 & \\sqrt{2} \\\\ 0 & 0 & 2\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & 1 & 0 \\\\ -5 & 0 & 0 \\\\ 3 & 1 & 0\\end{aligned}|,\\,|C|=|\\begin{aligned}-3 & 1 & 2 \\\\ -1 & 2 & 3 \\\\ -3 & 1 & 2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- Since $A$ is a triangular matrix, we obtain \n\n$$\n|A|=5\\cdot (-1)\\cdot 2=-10\\ne 0.\n$$\n\n- The matrix $B$ has a zero column: \n\n$$\nB=\\begin{bmatrix}1 & 1 & 0 \\\\ -5 & 0 & 0 \\\\ 3 & 1 & 0\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ has identical rows: \n\n$$\nC=\\begin{bmatrix}-3 & 1 & 2 \\\\ -1 & 2 & 3 \\\\ -3 & 1 & 2\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|B|$ and $|C|$ are equal to $0.$"}] :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"} {:db/id #edb/ref 17592186133912 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133467 :question/id #uuid "dc780837-b763-5ba9-981a-2373afcb524a" :question/math-academy-id "e-10995" :question/problem "Which of the following determinants are equal to $0?$\n\n![](images/f1/f1906279bd2a08c55aad73b8974edcccfdd3b156c5d471d185e2edc61e538528.svg)" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has proportional rows: \n![](images/f7/f7bdc5e767fbd22592a2b9bf8e51517ad6927e7edc495fd7a6ce73b7ae29e4a1.svg)\nAs a result, $|A| = 0.$\n\n- The matrix $B$ is a triangular matrix, so \n\n$$\n|B| = (-1) \\cdot 4 \\cdot (-3) = 12 \\neq 0.\n$$\n\n- The matrix $C$ has a zero row: \n![](images/c1/c1211b127ba1daa7863aef3501287f93fda48791ba3a072b98b777bd54ff31d7.svg)\nAs a result, $|C| = 0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"} :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687" :knowledge-point/questions [{:db/id #edb/ref 17592186134394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4731d43a-1037-5467-97a5-e798a96ef9d4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327555} {:answer/id #uuid "658a8d30-d9af-5e26-83da-9719b1081d76" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327818} {:answer/id #uuid "6d1056e6-0216-54a8-a348-f7fd16cd261c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186327879} {:answer/id #uuid "cb4f71df-9ae0-539d-bc37-b9dfa1a2efd4" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186328715} {:answer/id #uuid "f61627d1-d9a7-5fa0-8601-a797fc2e5d46" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186329093}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186329093} :answer-field/id #uuid "3ecac406-0aef-584c-9d48-0a6c47d439e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329307}] :question/id #uuid "a804e446-7433-50c7-a8ce-2769d7a93237" :question/math-academy-id "q-42459" :question/problem "Find $4det(A)+4det(B)$, where \n\n$$\nA=\\begin{bmatrix}2\\sqrt{2} & 1 \\\\ 1 & \\sqrt{2}\\end{bmatrix},\\,B=\\begin{bmatrix}1 & \\sqrt{2} & 2 \\\\ 2 & 1 & 4 \\\\ 3 & 6 & 6\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- For the matrix $A,$ we have\n\n$$\ndet(A)=2\\sqrt{2}\\cdot \\sqrt{2}-1\\cdot 1=3.\n$$\n\n- Since $B$ has proportional columns, we obtain\n\n$$\nB=\\begin{bmatrix}1 & \\sqrt{2} & 2 \\\\ 2 & 1 & 4 \\\\ 3 & 6 & 6\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $4det(A)+4det(B)=4\\cdot 3+4\\cdot 0=12.$"} {:db/id #edb/ref 17592186134407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba7d7bc9-77ef-583c-8caa-22315aad7aca" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$, $|B|$, and $|C|$" :db/id #edb/ref 17592186392523} {:answer/id #uuid "23f02ed7-eb83-5988-a1ca-ee80eac659ce" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186392524} {:answer/id #uuid "d767aec8-a44c-5175-bbcd-b71f577015fe" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186392525} {:answer/id #uuid "ee7ae539-44fc-5d03-b8b9-5a5b498db62e" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186392526} {:answer/id #uuid "3737a2a5-a57d-571a-a651-f2cad4ee3049" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186392527}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186392525} :answer-field/id #uuid "00ef10bc-f305-5726-8271-949923025e38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392522}] :question/id #uuid "cee2c526-7176-535a-81f7-173bfaefecec" :question/math-academy-id "q-42882" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & -1 & \\sqrt{3} \\\\ \\sqrt[5]{2} & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 0 & 3 & 6 \\\\ 0 & 0 & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 3 & 8 \\\\ 1 & 0 & 4\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=\\begin{bmatrix}2 & -1 & \\sqrt{3} \\\\ \\sqrt[5]{2} & 1 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=1\\cdot 3\\cdot 4=12\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=\\begin{bmatrix}1 & \\sqrt{2} & 4 \\\\ 2 & 3 & 8 \\\\ 1 & 0 & 4\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186272011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1321a890-eb6a-54ac-bf48-1d4c77ff2d9b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269436} {:answer/id #uuid "2417ace3-b1df-55bb-9e6e-f0cf724a7d7c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186269584} {:answer/id #uuid "445c99d0-1565-5d0f-bd0a-b81957ffc9f5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269889} {:answer/id #uuid "b8d5f2c0-248a-5010-b938-a0307212261a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270902} {:answer/id #uuid "fe1fdb0e-edd1-53d9-ac51-6c3cbff27cc4" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186271495}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270902} :answer-field/id #uuid "6af39b6a-785f-556e-9462-97889783ccd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271701}] :question/id #uuid "51a6e7e0-f39c-5b8c-9665-45f89b4bef77" :question/math-academy-id "q-140047" :question/problem "Find $det(A)-2det(B)$, where \n\n$$\nA=\\begin{bmatrix}1 & 0 & 1 & -1 \\\\ 0 & 2 & 1 & 3 \\\\ -2 & 0 & -2 & 2 \\\\ 2 & 1 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 4 & -1 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has proportional rows, we obtain\n\n$$\nA=\\begin{bmatrix}1 & 0 & 1 & -1 \\\\ 0 & 2 & 1 & 3 \\\\ -2 & 0 & -2 & 2 \\\\ 2 & 1 & 0 & 1\\end{bmatrix}\\,⟹\\,det(A)=0.\n$$\n\n- Since $B$ is a triangular matrix, we obtain\n\n$$\n|B|=-1\\cdot 1\\cdot 3=-3\n$$\n\nTherefore, $det(A)-2det(B)=0-2\\cdot (-3)=6.$"} {:db/id #edb/ref 17592186329654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e56afc4-56c1-5f83-9faa-9d89f1cacfcf" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186327480} {:answer/id #uuid "486c47f6-1e3a-5f22-b198-e23076b58334" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186327564} {:answer/id #uuid "bf700c2b-dddf-5cb5-a656-1a9428300887" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328610} {:answer/id #uuid "bfe01f85-8056-5569-bdd1-09bc847c1b00" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328612} {:answer/id #uuid "f43e88ce-f43b-5304-ab40-af8d62355648" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186329069}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186329069} :answer-field/id #uuid "acb9a9fe-ef3d-5f74-887c-394e168e90b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329486}] :question/id #uuid "c45dadfd-a3b7-5456-a194-bb5508805b4c" :question/math-academy-id "q-42467" :question/problem "Find $3det(A)-4det(B)$, where \n\n$$\nA=\\begin{bmatrix}7 & 3 \\\\ 4 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 3\\sqrt{2} & 5 \\\\ 2 & 1 & 4 \\\\ 4 & 6\\sqrt{2} & 10\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- For the matrix $A,$ we have\n\n$$\ndet(A)=7\\cdot 1-3\\cdot 4=-5.\n$$\n\n- Since $B$ has proportional rows, we obtain\n\n$$\nB=\\begin{bmatrix}2 & 3\\sqrt{2} & 5 \\\\ 2 & 1 & 4 \\\\ 4 & 6\\sqrt{2} & 10\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $3det(A)-4det(B)=3\\cdot (-5)-4\\cdot 0=-15.$"} {:db/id #edb/ref 17592186351409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1436ec4c-88ce-5432-b5fc-bcc3977df9e0" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186348619} {:answer/id #uuid "342c9e0d-3bc9-5d1a-8dd8-5ffecbcb9eac" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186348914} {:answer/id #uuid "6b821ea4-e43b-587c-b76b-a99bc45b8052" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186349435} {:answer/id #uuid "81799b75-c13d-51a1-8f2d-733e3a588cf6" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186349640} {:answer/id #uuid "bd651af3-ee69-50d4-93e1-b295f7f633b8" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186350130}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186348619} :answer-field/id #uuid "a5128805-4f2a-5632-93d8-b430aa5f4d2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350986}] :question/id #uuid "dec8cece-e79e-5652-812a-3c79c57417e9" :question/math-academy-id "q-82289" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}4 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 3\\end{aligned}|,\\,|B|=|\\begin{aligned}0 & -2 & 9 \\\\ 0 & 2 & \\sqrt{3} \\\\ 0 & 1 & -8\\end{aligned}|,\\,|C|=|\\begin{aligned}0 & 2 & -4 \\\\ 1 & \\sqrt{5} & -2\\sqrt{5} \\\\ 0 & -1 & 2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ is a diagonal matrix, hence \n\n$$\n|A|=4\\cdot (-2)\\cdot 3=-24\\ne 0.\n$$\n\n- The matrix $B$ has a zero column: \n\n$$\nB=\\begin{bmatrix}0 & -2 & 9 \\\\ 0 & 2 & \\sqrt{3} \\\\ 0 & 1 & -8\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=\\begin{bmatrix}0 & 2 & -4 \\\\ 1 & \\sqrt{5} & -2\\sqrt{5} \\\\ 0 & -1 & 2\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|B|$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186402861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78b84216-c188-5769-a0cf-2f3c4b5d4fe1" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186402863} {:answer/id #uuid "47a2ba38-2156-5dd9-922d-70e7a9112796" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402864} {:answer/id #uuid "bf232768-62b0-5a99-b6ae-c2f1d1ac4e96" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186402865} {:answer/id #uuid "5c171a58-43ca-5ac8-896f-be2e38df60c5" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186402866} {:answer/id #uuid "75bb085b-9153-5df0-9e32-3ce23b5de8fb" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186402867}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186402863} :answer-field/id #uuid "a4619bd4-0fd6-5b0e-85d8-4d713cc4997e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402862}] :question/id #uuid "b44f28c6-ca93-5246-be2b-1a2725d36e07" :question/math-academy-id "q-43057" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}3 & 0 & 0 \\\\ \\sqrt{3} & -6 & 0 \\\\ \\sqrt{5} & 8 & 2\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 2\\sqrt{2} & 8 \\\\ 0 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-1 & \\sqrt{3} & 4 \\\\ 0 & 3 & \\sqrt{3} \\\\ 0 & 0 & 4\\end{aligned}|.\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ is a triangular matrix, hence \n\n$$\n|A|=3\\cdot (-6)\\cdot 2=-36\\ne 0.\n$$\n\n- The matrix $B$ has proportional rows: \n\n$$\nB=\\begin{bmatrix}1 & \\sqrt{2} & 4 \\\\ 2 & 2\\sqrt{2} & 8 \\\\ 0 & -\\sqrt{3} & 4\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ is a triangular matrix, hence \n\n$$\n|C|=(-1)\\cdot 3\\cdot 4=-12\\ne 0\n$$\n\nTherefore, only $|B|$ is equal to $0.$"} {:db/id #edb/ref 17592186402868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "665b8959-619e-56ef-8580-a1cb1e4b9558" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186402870} {:answer/id #uuid "64b8f243-2c7b-510f-ba0f-db94cf33bd62" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402871} {:answer/id #uuid "d613850c-c563-547d-bf3d-1ebbc2fd8f08" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186402872} {:answer/id #uuid "0b3fe8ae-8e1d-511a-9447-a62e0e89b0d5" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186402873} {:answer/id #uuid "c240e8d0-5ba7-5ba9-9558-ad9c553e554b" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186402874}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186402871} :answer-field/id #uuid "2d0cbd0e-5f98-5252-aa48-893e93a173fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402869}] :question/id #uuid "56c75f73-8006-5c39-8150-6ad119a3d555" :question/math-academy-id "q-43058" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}2 & 0 & 0 \\\\ 2 & -5 & 0 \\\\ 1 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}|.\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=\\begin{bmatrix}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=2\\cdot (-5)\\cdot 4=-40\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=\\begin{bmatrix}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186411852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119469cb-de0c-54b8-aeed-aadcc9006b64" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186411691} {:answer/id #uuid "52d15588-08f4-5de2-baf0-27c5fa69cb33" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186411721} {:answer/id #uuid "6657d1d7-2317-536b-a73c-9536580d61e5" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186411731} {:answer/id #uuid "6ba19205-12b7-5ea8-b9b0-c94f0fbef5be" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186411735} {:answer/id #uuid "c92f219d-fedf-5abc-84b3-73dbff86703f" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186411787}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186411691} :answer-field/id #uuid "1fee267d-6a43-5586-8b7a-525bf46d0281" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411822}] :question/id #uuid "0bdbb35e-75fd-595e-96b4-a35903811dc9" :question/math-academy-id "q-82288" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}7 & \\sqrt{2} & 1 \\\\ 1 & -1 & 3 \\\\ 14 & 2\\sqrt{2} & 2\\end{aligned}|,\\,|B|=|\\begin{aligned}0 & 1 & 4 \\\\ -1 & 3 & 2 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|C|=|\\begin{aligned}2 & 0 & 0 \\\\ 3 & -3 & 0 \\\\ 0 & -3 & -1\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has proportional rows: \n\n$$\nA=\\begin{bmatrix}7 & \\sqrt{2} & 1 \\\\ 1 & -1 & 3 \\\\ 14 & 2\\sqrt{2} & 2\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ has a zero row: \n\n$$\nB=\\begin{bmatrix}0 & 1 & 4 \\\\ -1 & 3 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ is a triangular matrix, hence \n\n$$\n|C|=2\\cdot (-3)\\cdot (-1)=6\\ne 0.\n$$\n\nTherefore, only $|A|$ and $|B|$ are equal to $0.$"} {:db/id #edb/ref 17592186415475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045918a8-9cd8-5a07-b550-ae46024d9091" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186415446} {:answer/id #uuid "402ee237-56af-5ed0-b68b-15a4eb93a4c5" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186415451} {:answer/id #uuid "82c9a685-f3be-5652-9e92-444a23e21632" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186415458} {:answer/id #uuid "f5705fa2-288d-561a-9ae0-435e05884593" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|,$ $|B|,$ and $|C|$" :db/id #edb/ref 17592186415466} {:answer/id #uuid "fff98d8e-e1e9-59ce-9f45-62d4096f2b19" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186415469}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|,$ $|B|,$ and $|C|$" :db/id #edb/ref 17592186415466} :answer-field/id #uuid "3898e8c8-305f-5107-8e55-3fa0057b225c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415470}] :question/id #uuid "135c5d03-e391-5a5b-8227-7d54c7203318" :question/math-academy-id "q-140048" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}0 & 0 & 0 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 1 & 0 & 0 \\\\ 3 & 2 & 1 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 1 \\\\ \\sqrt{2} & 2 & \\sqrt{2} \\\\ -1 & \\sqrt{2} & 1\\end{aligned}|,\\,|C|=|\\begin{aligned}1 & 0 & 5 \\\\ -1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- Since $A$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal:\n\n$$\n|A|=0\\cdot 0\\cdot 0\\cdot 0=0\n$$\n\n- The matrix $B$ has proportional rows: \n\n$$\nB=\\begin{bmatrix}1 & \\sqrt{2} & 1 \\\\ \\sqrt{2} & 2 & \\sqrt{2} \\\\ -1 & \\sqrt{2} & 1\\end{bmatrix}\n$$\n\n \nAs a result, $|B|=0.$\n\n- The matrix $C$ has a zero column: \n\n$$\nC=\\begin{bmatrix}1 & 0 & 5 \\\\ -1 & 0 & 3 \\\\ 2 & 0 & 4\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, $|A|,$ $|B|,$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186415477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022ff781-0bb6-5222-8917-bb9fe088d40f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186415445} {:answer/id #uuid "68acb0f6-b335-5e47-b870-8fcc301ed02a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186415455} {:answer/id #uuid "a31adf10-60d1-51b5-9022-8cf1940c42be" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186415461} {:answer/id #uuid "ebaffa84-7e8a-5edc-8432-6adf9e5b2b42" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186415465} {:answer/id #uuid "fae22a7a-c8b8-5a0b-bb2c-5bc815b3b48d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186415467}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186415445} :answer-field/id #uuid "d9ec239f-8a57-5ead-b4ff-042aa539477e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415472}] :question/id #uuid "d4554f29-f5fb-5556-852c-2f9d95422a4d" :question/math-academy-id "q-42464" :question/problem "Find $5det(A)+7det(B)$, where \n\n$$\nA=\\begin{bmatrix}1 & 0 & \\sqrt{3} & 1 \\\\ 0 & 2 & 4 & 2 \\\\ 3 & 0 & 3\\sqrt{3} & 3 \\\\ 2 & 0 & 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}\\sqrt{3} & \\sqrt{2} & 0 & 3 \\\\ 2 & 1 & 0 & 3 \\\\ \\sqrt{3} & 1 & 0 & \\sqrt{2} \\\\ 4 & 3 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has proportional rows, we obtain\n\n$$\nA=\\begin{bmatrix}1 & 0 & \\sqrt{3} & 1 \\\\ 0 & 2 & 4 & 2 \\\\ 3 & 0 & 3\\sqrt{3} & 3 \\\\ 2 & 0 & 0 & 1\\end{bmatrix}\\,⟹\\,det(A)=0.\n$$\n\n- Since $B$ has a zero column, we obtain\n\n$$\nB=\\begin{bmatrix}\\sqrt{3} & \\sqrt{2} & 0 & 3 \\\\ 2 & 1 & 0 & 3 \\\\ \\sqrt{3} & 1 & 0 & \\sqrt{2} \\\\ 4 & 3 & 0 & 2\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $5det(A)+7det(B)=5\\cdot 0+7\\cdot 0=0.$"} {:db/id #edb/ref 17592186415478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1859d7c5-0d55-5273-a004-f8368886466b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186415448} {:answer/id #uuid "4a61a420-d52d-5f1a-b48b-ade03dffdca3" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186415453} {:answer/id #uuid "5fcc61bd-b9ee-5f9e-8558-651f8ea9c858" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186415454} {:answer/id #uuid "851dc3ec-467b-568b-a964-3b5e34b3527e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186415459} {:answer/id #uuid "e2e4e722-717d-508c-a98d-112f70b09d9f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186415463}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186415463} :answer-field/id #uuid "f920ea7f-06a7-52e9-8586-d0e6b44af6b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415474}] :question/id #uuid "e897ce2c-45dd-5cf3-9d25-ca84c0dd6ea8" :question/math-academy-id "q-42881" :question/problem "Find $3det(A)-det(B)$, where \n\n$$\nA=\\begin{bmatrix}2 & 1 & 3 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 3\\end{bmatrix},\\,B=\\begin{bmatrix}\\sqrt{3} & 2 & 4 \\\\ 0.57 & 3 & 6 \\\\ 1 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ is a triangular matrix, we have\n\n$$\ndet(A)=2\\cdot 1\\cdot 3=6.\n$$\n\n- Since $B$ has proportional columns, we obtain\n\n$$\nB=\\begin{bmatrix}\\sqrt{3} & 2 & 4 \\\\ 0.57 & 3 & 6 \\\\ 1 & 1 & 2\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $3det(A)-det(B)=3\\cdot 6-0=18.$"} {:db/id #edb/ref 17592186484193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366bb306-e5b1-5bce-82a8-a14197bda5e2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186483664} {:answer/id #uuid "5c836208-8886-5ac5-a42b-bc5298710b67" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483742} {:answer/id #uuid "66dd1cc6-ae10-55ca-805b-f651571a416c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483766} {:answer/id #uuid "b1e66de3-9711-58eb-a4b6-9c6f7f7d5114" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483922} {:answer/id #uuid "cf227642-8c60-5fac-8a8c-4941679de5a8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186483985}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483922} :answer-field/id #uuid "0ac158dd-e2ea-5d6f-9ec0-895c0248c590" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484087}] :question/id #uuid "00ee9625-b07b-5511-af62-7520bef2fbbd" :question/math-academy-id "q-82287" :question/problem "Find $5det(A)+2det(B)$, where \n\n$$\nA=\\begin{bmatrix}1 & -3 & 4 \\\\ \\sqrt{3} & -1 & 1.5 \\\\ 3 & -9 & 12\\end{bmatrix},\\,B=\\begin{bmatrix}2 & \\sqrt{3} \\\\ \\sqrt{3} & 3\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has proportional rows, we obtain\n\n$$\nA=\\begin{bmatrix}1 & -3 & 4 \\\\ \\sqrt{3} & -1 & 1.5 \\\\ 3 & -9 & 12\\end{bmatrix}\\,⟹\\,det(A)=0.\n$$\n\n- For the matrix $B,$ we have\n\n$$\ndet(B)=2\\cdot 3-\\sqrt{3}\\cdot \\sqrt{3}=3.\n$$\n\nTherefore, $5det(A)+2det(B)=5\\cdot 0+2\\cdot 3=6.$"}] :knowledge-point/title "Calculating the Determinant of a Matrix With Two Proportional Rows/Columns"} {:db/id #edb/ref 17592186133913 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133468 :question/id #uuid "33ca37e5-c598-52a2-861f-2d5bfa6fd571" :question/math-academy-id "e-10996" :question/problem "![](images/b3/b36961dd90e73504bf46d63827d1ea68292c01a7990f8fa3eb00eee62a4b1813.svg)\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0.$\n\nI. $A$ has a zero column\n\nII. $A$ has proportional rows\n\nIII. $A$ has identical columns" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has a zero column: \n![](images/ce/ce6418b20309f4fdf0fdde343eef9fd6fdaa547d40207382c512537c5e509296.svg)\n\n- $A$ has proportional rows: \n![](images/cd/cdfd4bbe379b1e1c68412fa70c67e4ba9e355a329bb8f457ecb17523755f2ea1.svg)\n\n- $A$ does *not* have identical columns.\n\nTherefore, the correct answer is \"I and II only.\""} :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/questions [{:db/id #edb/ref 17592186134393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d65d5f6-e3b7-5ee9-95cf-58c3e498a702" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459975} {:answer/id #uuid "646a048e-f630-5013-95fe-6659b566a35f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459976}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459976} :answer-field/id #uuid "34d3f262-127e-5585-b97c-20a126667044" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460854} {:answer-field/choices [{:answer/id #uuid "8460f2bb-e253-5210-9218-4e96e796beae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459977} {:answer/id #uuid "40f38a8d-b50e-505f-9411-5989253d0642" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459978}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459977} :answer-field/id #uuid "cde9df91-1435-51c4-9805-9c117768203b" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460855} {:answer-field/choices [{:answer/id #uuid "d90e2fb7-b1da-50a5-82da-f4e30f796fcc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459979} {:answer/id #uuid "8df48ba2-f889-595c-9590-a8404cf9b0b5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459980}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459980} :answer-field/id #uuid "f677a744-3bd0-564b-ade4-affd6abcf2a2" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460856}] :question/id #uuid "2d571c31-8e0e-520c-b34f-482cf5518003" :question/math-academy-id "q-42458" :question/problem "$$\nA=\\begin{bmatrix}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has a zero column\n- **II.** $A$ has identical columns\n- **III.** $A$ has identical rows\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has a zero column: \n\n$$\nA=\\begin{bmatrix}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ has identical rows: \n\n$$\nA=\\begin{bmatrix}2 & 0 & 4 \\\\ 1 & 0 & 3 \\\\ 2 & 0 & 4\\end{bmatrix}.\\,✓\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186134414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc3eb36-fa25-5b0c-a9f4-d0d9b6fd431c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448644} {:answer/id #uuid "024de02f-c585-5ff1-ae1f-906a7964b6c3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448645}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448644} :answer-field/id #uuid "f4ba6b54-8b9e-5c38-a842-718279128c22" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449362} {:answer-field/choices [{:answer/id #uuid "a8759331-0ea5-5e82-a056-c79e5438af33" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448646} {:answer/id #uuid "e2f5cff8-7a78-538b-955f-a82c9351731b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448647}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448647} :answer-field/id #uuid "ae83d106-f07c-5d04-9fd2-5832bd202f49" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449363} {:answer-field/choices [{:answer/id #uuid "318ceaba-c9a3-5098-81fd-4d438f7912e2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448648} {:answer/id #uuid "773df97a-4a06-5ac8-b5d2-9731cc8bba08" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448649}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448648} :answer-field/id #uuid "93e5158f-ae92-576e-abfb-6ad450c72c06" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449364}] :question/id #uuid "ef67ff18-5c70-5c00-bdf0-27b79dc90b72" :question/math-academy-id "q-43306" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\nSelect all that apply.\n\n- **I.** $A$ has two identical rows\n\n- **II.** One of the rows/columns of $A$ is proportional to another row/column of $A$\n\n- **III.** $A$ has two identical columns" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and III are false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & 4 \\\\ 2 & 8\\end{bmatrix}.\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 8-4\\cdot 2=0\n$$\n\nbut $A$ has neither two identical rows nor two identical columns.\n\n- Statement II is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186272012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "643b4a3a-7263-51ad-8b17-fdd82678cf99" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} {:answer/id #uuid "e3e66fb8-1a18-56f4-8033-3baba4940db9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464085}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464084} :answer-field/id #uuid "2ceb200f-e369-571b-b619-8f16a603488c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464976} {:answer-field/choices [{:answer/id #uuid "198009c8-d9e6-556e-aa1c-228a37b12311" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464086} {:answer/id #uuid "da19cf9c-0b56-5a20-b004-c70d313f5184" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464087} :answer-field/id #uuid "d98905ac-4493-5551-96b2-6d52f8e3f566" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464977} {:answer-field/choices [{:answer/id #uuid "63ea76cf-d936-573e-a0be-56de7954b8ee" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464088} {:answer/id #uuid "24e2aa19-faca-5a81-a238-e9e984e89ef4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464089} :answer-field/id #uuid "ed42e6d2-1aff-5708-ad8c-b45de0195450" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464978}] :question/id #uuid "f60fdb9d-cf89-59bd-ad65-e9ec096b82df" :question/math-academy-id "q-140049" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|\\ne 0.$ Which of the following statements must be true?\n- **I.** $A$ is a triangular matrix\n- **II.** $A$ does not have identical rows\n- **III.** $A$ does not have proportional columns\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's consider our statements in turn.\n\n- Statement I is false. For example, consider the matrix \n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 1-(-2)\\cdot 2=5\\ne 0\n$$\n\nbut $A$ is not a triangular matrix.\n\n- Statements II and III are true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\nHence, if $|A|\\ne 0$ then $A$ doesn't have proportional nor identical rows/columns.\n\nTherefore, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186272013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dcaf5cb-763f-5cf3-9460-94fc22fd63a3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464090} {:answer/id #uuid "94b51605-0792-5dfb-9caa-c9f83344d279" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464091} :answer-field/id #uuid "977b3534-4011-5dfd-a7b9-79927cd06b86" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464979} {:answer-field/choices [{:answer/id #uuid "fc8b5695-d93e-519e-8d9e-dc6c8a41f9b4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464092} {:answer/id #uuid "6b733140-0c4b-5274-8eb8-dcc1ee96785c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464093}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464092} :answer-field/id #uuid "9e5c0b84-632c-50f3-8754-70310b21a57f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464980} {:answer-field/choices [{:answer/id #uuid "f726adc9-d1dc-521c-8654-53c52267101e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464094} {:answer/id #uuid "94789da1-7829-587f-bfab-9c55f7f2211d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464095}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464094} :answer-field/id #uuid "121070ea-b2d0-524b-8159-ea2fbac7bd33" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464981}] :question/id #uuid "14e63fd3-62b7-575e-b489-4cda5c20ed53" :question/math-academy-id "q-140050" :question/problem "$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has proportional columns\n- **II.** $A$ has identical columns\n- **III.** $A$ has identical rows\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=\\begin{bmatrix}1 & -2 & 3 \\\\ 2 & -4 & 5 \\\\ -1 & 2 & 7\\end{bmatrix}\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ does *not* have identical rows.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186329652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ecd3639-37c9-5252-aa12-89458787a945" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467506} {:answer/id #uuid "4a17d94f-af1d-51db-b4a1-c3f5d3f929bf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467507}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467506} :answer-field/id #uuid "bdf24f07-c421-5ff2-bb73-41cf2a1bb824" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468474} {:answer-field/choices [{:answer/id #uuid "d6ede3e0-89dd-5960-bddd-720db62f0e98" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467508} {:answer/id #uuid "9298449a-ad9c-56e2-ac99-09c0dc4fccc9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467509}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467509} :answer-field/id #uuid "c910b60c-d032-56a5-9324-9976088368c8" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468475} {:answer-field/choices [{:answer/id #uuid "7b966358-ec55-5272-a99d-1379768d11ab" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467510} {:answer/id #uuid "7421f4b3-99e2-5360-a4df-4fcdc8cb3bc8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467511}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467511} :answer-field/id #uuid "5de5adf3-aa9f-52a9-9f7f-305d17cf782d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468476}] :question/id #uuid "fffc6699-6d6e-50bb-8cc3-7d4f0e3f1d17" :question/math-academy-id "q-42460" :question/problem "$$\nA=\\begin{bmatrix}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{bmatrix}\n$$\n\n \nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n- **I.** $A$ has a zero row\n- **II.** $A$ has two proportional columns\n- **III.** $A$ has two identical rows\n\nSelect all that apply." :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ does *not* have a zero row.\n\n- $A$ has two proportional columns:\n\n$$\nA=\\begin{bmatrix}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{bmatrix}\\,✓\n$$\n\n- $A$ has two identical rows: \n\n$$\nA=\\begin{bmatrix}\\sqrt{5} & 1 & 5 & 2 \\\\ 2 & 2 & 2 & 4 \\\\ \\sqrt{5} & 1 & 5 & 2 \\\\ -1 & 4 & -1 & 8\\end{bmatrix}\\,✓\n$$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186329653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a447b8-7f09-5270-aca4-b17f9770d76a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467512} {:answer/id #uuid "20bcc14b-7336-54e8-a261-0dbcc7509b69" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467513}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467513} :answer-field/id #uuid "0b661764-dcf8-5eba-bedc-e2374ffb5a83" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468477} {:answer-field/choices [{:answer/id #uuid "5f27d7c7-943c-56e2-9e1a-eb7154c900ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467514} {:answer/id #uuid "9113697f-b704-5925-b69c-e204a21d502a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467515}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467514} :answer-field/id #uuid "ba64ddd8-bbc6-577f-b73b-e524ed587e49" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468478} {:answer-field/choices [{:answer/id #uuid "68448d61-0ddf-531f-8009-f672e592a9b1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467516} {:answer/id #uuid "84b46424-4893-5f87-bbc8-ae085db91a24" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467517}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467516} :answer-field/id #uuid "b2a724bd-e000-5d5f-b930-fed8c566efc4" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468479}] :question/id #uuid "59d4edee-acd9-59e0-80f8-ec390e2e0ee0" :question/math-academy-id "q-42465" :question/problem "$$\nA=\\begin{bmatrix}4 & 8 & 2 & 6 \\\\ 2 & 4 & 1 & 3 \\\\ 3 & \\sqrt{6} & 9 & 3 \\\\ 3 & 2 & 4 & \\sqrt{5}\\end{bmatrix}\