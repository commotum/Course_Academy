#{[{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186055590} :activity/id #uuid "6a57c066-8362-5ded-8fc6-fe55df2e5373" :activity/steps [{:db/id #edb/ref 17592186055590 :step/content {:db/id #edb/ref 17592186055974 :tutorial/content "We add two matrices by adding the corresponding entries. We can only do this if they have the same number of rows and columns, that is, they have the same dimensions.\n\nFor example, consider the matrices\n\n$$\nA = \\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix},\\qquad B = \\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nWe see that both $A$ and $B$ are $2\\times 2$ matrices, so we can add them. The sum ${A} + {B}\\,$ is given by\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+1 & 3+0 \\\\ 2+0 & 4+(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 3 \\\\ 2 & 3\\end{bmatrix}.\\end{aligned}\n$$\n\nIn general, the sum of two matrices is another matrix with the same dimensions." :tutorial/id #uuid "b6060e4b-f36b-5930-b8ee-1e41648bf0a8" :tutorial/math-academy-id 2971 :tutorial/title "Introduction"} :step/id #uuid "480a4714-b432-5cb5-9cea-2cd6cdd92ec1" :step/next {:db/id #edb/ref 17592186055591}} {:db/id #edb/ref 17592186055591 :step/content {:db/id #edb/ref 17592186054648 :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783"} :step/id #uuid "7b631005-d27a-5d80-91e2-31ce78aecf6e" :step/next {:db/id #edb/ref 17592186055594}} {:db/id #edb/ref 17592186055592 :step/content {:db/id #edb/ref 17592186054649 :knowledge-point/id #uuid "1d3c4ee0-3a49-5eef-a7c0-56d1731cd826"} :step/id #uuid "6ab1f2a9-9a57-5ab5-afd8-2b6a0e402c6a"} {:db/id #edb/ref 17592186055593 :step/content {:db/id #edb/ref 17592186055975 :tutorial/content "We can subtract matrices in the same way that we add matrices: we subtract the corresponding entries. Again, we can only do this if they have the same number of rows and columns, that is, they have the same dimensions.\n\nFor example, consider the matrices\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}\n$$\n\nWe see that both $A$ and $B$ are $2\\times 2$ matrices, so, we can subtract them. The difference ${A} - {B}\\,$ is given by\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}1 & 3 \\\\ 2 & 4\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-1 & 3-0 \\\\ 2-0 & 4-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 3 \\\\ 2 & 5\\end{bmatrix}.\\end{aligned}\n$$\n\nAgain, the difference of two matrices is another matrix with the same dimensions." :tutorial/id #uuid "6c907b34-7db5-5717-84ac-d2425bf6dbc3" :tutorial/math-academy-id 2986 :tutorial/title "Subtracting Matrices"} :step/id #uuid "7c3091d8-48ac-5b83-a4a8-d616aee10102" :step/next {:db/id #edb/ref 17592186055592}} {:db/id #edb/ref 17592186055594 :step/content {:db/id #edb/ref 17592186054650 :knowledge-point/id #uuid "95627f8c-4151-5565-8803-7558bd674acb"} :step/id #uuid "94f97203-0354-535f-a313-c4e2c5c9cd1d" :step/next {:db/id #edb/ref 17592186055593}}] :activity/title "Adding and Subtracting Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186054891}] :db/id #edb/ref 17592186049304 :topic/knowledge-points [{:db/id #edb/ref 17592186054648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054545 :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n$$\n\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/question-generator {:db/id #edb