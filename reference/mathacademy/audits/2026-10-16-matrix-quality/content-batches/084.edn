q-164166" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}8 & -2 \\\\ -2 & 1\\end{bmatrix}?\n$$" :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|8\\cdot 1-(-2)\\cdot (-2)| \\\\  & =|8-4| \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186372300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edb79477-3b8f-53da-86a7-67bad26f521c" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186372302} {:answer/id #uuid "51416546-11e3-5a94-9cc7-ca19ad797d14" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186372303} {:answer/id #uuid "ed9881a4-a687-562c-8d0d-0111cb65edec" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186372304} {:answer/id #uuid "f66c9095-64f9-5845-b577-d803690d6c79" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186372305} {:answer/id #uuid "46e3851c-132f-5d31-9031-2b29ef56311a" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186372306}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186372302} :answer-field/id #uuid "754a8d10-db0e-5f34-9e13-bc86f7107af5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372301}] :question/id #uuid "2fc0c593-42d1-5ccd-94ef-5a3b91248ed0" :question/math-academy-id "q-164167" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}12 & -3 \\\\ -4 & -4\\end{bmatrix}?\n$$" :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|12\\cdot (-4)-(-3)\\cdot (-4)| \\\\  & =|-48-12| \\\\  & =60.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186372543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f24d129-fc62-5693-8425-77de9cb5787e" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186372545}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186372545} :answer-field/id #uuid "046687d7-1553-5e3f-9041-80a23c24073b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372544}] :question/id #uuid "76d159f6-fb9f-53b3-9d01-c808901cc326" :question/math-academy-id "q-316568" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=\\begin{bmatrix}4 & 9 \\\\ 7 & 8\\end{bmatrix}?\n$$\n\nThe area scale factor is\n{{field-1}} ." :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|4\\cdot 8-9\\cdot 7| \\\\  & =|32-63| \\\\  & =|-31| \\\\  & =31.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186373360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29421cf-6a66-5d16-8b11-2d205cd93eb8" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186373362} {:answer/id #uuid "9c740393-d250-5e9c-a64a-ed6a360e847d" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186373363} {:answer/id #uuid "4cb6b96a-5bd9-582a-badb-83e5c426ee8c" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186373364} {:answer/id #uuid "7d0a82e0-3ea8-5580-9e32-59f9c7204582" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186373365} {:answer/id #uuid "574f43a5-29ab-5bad-80f8-f35ea15f9907" :answer/type {:db/ident :an