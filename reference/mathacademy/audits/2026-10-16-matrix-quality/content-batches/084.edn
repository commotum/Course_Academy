 0 & 1 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186258897}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -4 \\\\ -3 & 1 \\\\ 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186256929} :answer-field/id #uuid "fafce873-0140-5632-a7c6-3fdde02703fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259474}] :question/id #uuid "5df39415-9d38-5a3a-9412-09ec30f0c75f" :question/math-academy-id "q-125722" :question/problem "Calculate $P+Q,$ where\n\n$$\nP=\\begin{bmatrix}1 & -1 \\\\ -4 & 0 \\\\ -1 & 2\\end{bmatrix},\\,Q=\\begin{bmatrix}2 & -3 \\\\ 1 & 1 \\\\ 2 & -4\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}P+Q & =\\begin{bmatrix}1 & -1 \\\\ -4 & 0 \\\\ -1 & 2\\end{bmatrix}+\\begin{bmatrix}2 & -3 \\\\ 1 & 1 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+2 & (-1)+(-3) \\\\ (-4)+1 & 0+1 \\\\ (-1)+2 & 2+(-4)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -4 \\\\ -3 & 1 \\\\ 1 & -2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353e43ee-9b25-536d-82d9-fef2ed9dde2a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297764}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186297764} :answer-field/id #uuid "052b8476-aad2-54a6-8d85-172119351edd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298655} {:answer-field/choices [{:answer/id #uuid "b13aee91-1025-50ba-b222-20d948a65558" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298325}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298325} :answer-field/id #uuid "17ba30e7-7448-50ed-945a-5ff1c3dfd0a7" :answer-field/key "field