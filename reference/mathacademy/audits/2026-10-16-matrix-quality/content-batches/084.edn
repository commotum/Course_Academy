9ad4-5f98-aebf-68bc615ab159" :question/math-academy-id "q-319601" :question/problem "Calculate $P+Q,$ where\n$P=\\begin{bmatrix}-4 & 9 & 3 \\\\ 7 & -2 & 11\\end{bmatrix}$ and $Q=\\begin{bmatrix}10 & -5 & -8 \\\\ -1 & 4 & -6\\end{bmatrix}.$\n\n| $P+Q=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-4}} | {{field-5}} | {{field-6}} |  |  |" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}P+Q & =\\begin{bmatrix}-4 & 9 & 3 \\\\ 7 & -2 & 11\\end{bmatrix}+\\begin{bmatrix}10 & -5 & -8 \\\\ -1 & 4 & -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4+10 & 9+(-5) & 3+(-8) \\\\ 7+(-1) & -2+4 & 11+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 4 & -5 \\\\ 6 & 2 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dff56a4-8ecd-5e6f-b7bc-008e53942346" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186333707} {:answer/id #uuid "514a5014-b26c-5e45-86f9-0e5b188dee8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 7 & -3 \\\\ 5 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186333731} {:answer/id #uuid "83f6db9a-f6a3-5e03-b93a-59362726bc3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -1 & 0 \\\\ -7 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186334165} {:answer/id #uuid "d134427d-e590-5ad5-bedc-e37834d2fe62" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 & -1 \\\\ 12 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186334818} {:answer/id #uuid "eb459f7e-2530-5e0d-9370-ebd86c051508" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -1 & 3 \\\\ 4 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186335047}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -1 & 3 \\\\ 4 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186335047} :answer-field/id #uuid "62ad8fbd-930e-5da6-842d-88500b9b90f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335434}] :question/id #uuid "25ed3ad7-d3bb-57c8-bbb6-452528c43de5" :question/math-academy-id "q-69622" :question/problem "$\\begin{bmatrix}1 & -1 & 4 \\\\ 3 & -2 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & -1 \\\\ 1 & 2 & 10\\end{bmatrix}=$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -1 & 4 \\\\ 3 & -2 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & -1 \\\\ 1 & 2 & 10\\end{bmatrix} & =\\begin{bmatrix}1+(-2) & -1+0 & 4+(-1) \\\\ 3+1 & -2+2 & 2+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -1 & 3 \\\\ 4 & 0 & 12\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4328d8dc-7f48-5716-af7b-4657775ae646" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -14 \\\\ -6 & -11 \\\\ -9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186333615} {:answer/id #uuid "97bd0a28-67ab-552a-b276-e6caba9f4933" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -14 \\\\ 6 & -17 \\\\ 9 & 26\\end{bmatrix}" :db/id #edb/ref 17592186334337} {:answer/id #uuid "cfe62cb0-a057-51cc-b27b-54d38d51bba6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -14 \\\\ -6 & -17 \\\\ 9 & -6\\end{bmatrix}" :db/id #edb/ref 17592186334801} {:answer/id #uuid "d07b143b-c297-56a2-bc00-44b02ec1aea9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -14 \\\\ -16 & -12 \\\\ -9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186334811} {:answer/id #uuid "e175424b-79ab-50ef-a528-15ba2871a17b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -14 \\\\ 6 & 11 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186334954}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & -14 \\\\ -6 & -17 \\\\ 9 & -6\\end{bmatrix}" :db/id #edb/ref 17592186334801} :answer-field/id #uuid "469270aa-0078-56d3-b672-289aef9236b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335370}] :question/id #uuid "4cca7d4f-2187-526c-82e6-e7f992b19e6f" :question/math-academy-id "q-69635" :question/problem "$\\begin{bmatrix}-1 & -3 \\\\ -6 & -3 \\\\ -2 & 10\\end{bmatrix}+\\begin{bmatrix}1 & -11 \\\\ 0 & -14 \\\\ 11 & -16\\end{bmatrix}=$" :question/worked-solution "We add the corresponding entries: \n\n$$\n\\begin{aligned}\\begin{bmatrix}-1 & -3 \\\\ -6 & -3 \\\\ -2 & 10\\end{bmatrix}+\\begin{bmatrix}1 & -11 \\\\ 0 & -14 \\\\ 11 & -16\\end{bmatrix} & =\\begin{bmatrix}-1+1 & -3+(-11) \\\\ -6+0 & -3+(-14) \\\\ -2+11 & 10+(-16)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -14 \\\\ -6 & -17 \\\\ 9 & -6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186386182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55932ce-3f50-5b73-858f-cb76f12c3587" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -12 & 1 \\\\ -1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386184} {:answer/id #uuid "15d52a5c-027a-512d-9f40-5eed9dc914ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386185} {:answer/id #uuid "c534b1fe-2ec4-554b-8341-0c38ee03d056" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & 12 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386186} {:answer/id #uuid "49ccf434-d5d9-541f-a931-72a94a342247" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -12 & 1 \\\\ 1 & 1 & -17\\end{bmatrix}" :db/id #edb/ref 17592186386187} {:answer/id #uuid "9143ce0c-958c-5996-b37e-3c51ef20ca74" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & 12 & 1 \\\\ 1 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386188}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186386185} :answer-field/id #uuid "b026c447-2f5b-5963-aace-757189b51481" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386183}] :question/id #uuid "c2549bb3-62b2-5d71-b2ff-f2d99c30a636" :question/math-academy-id "q-106" :question/problem "Calculate $M+N,$ where\n\n$$\nM=\\begin{bmatrix}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{bmatrix},\\,N=\\begin{bmatrix}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{bmatrix}.\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}M+N & =\\begin{bmatrix}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{bmatrix}+\\begin{bmatrix}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+(-15) & -6+(-6) & 14+(-13) \\\\ 2+(-1) & 9+(-8) & -13+14\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Adding Non-Square Matrices"}] :topic/math-academy-id 29 :topic/title "Adding and Subtracting Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186134901} :activity/id #uuid "fc007430-4cc9-562b-9192-4d3c9dccd500" :activity/steps [{:db/id #edb/ref 17592186134901 :step/content {:db/id #edb/ref 17592186135151 :tutorial/content "If an $n\\!\\times \\!n$ matrix $A$ has an entire row or column of zeros, then its determinant is equal to zero.\n\nFor example, consider the matrix $A$ given below:\n\n![](images/6b/6bb8b64f7ed8730e641cdf88fc6fe7add40bc15061095c6b1f57c1b764b28feb.svg)\n\nThe second row consists of all zeros, and the asterisks ($\\ast$) may represent any number.\n\nLet's compute the determinant using the Laplace expansion across the second row:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}∗ & ∗ & ∗ \\\\ 0 & 0 & 0 \\\\ ∗ & ∗ & ∗\\end{aligned}| \\\\  & =(-1)^{2+1}(0)|\\begin{aligned}∗ & ∗ \\\\ ∗ & ∗\\end{aligned}|+(-1)^{2+2}(0)|\\begin{aligned}∗ & ∗ \\\\ ∗ & ∗\\end{aligned}|+(-1)^{2+3}(0)|\\begin{aligned}∗ & ∗ \\\\ ∗ & ∗\\end{aligned}| \\\\  & =0+0+0 \\\\  & =0\\end{aligned}\n$$\n\nNotice that it doesn't matter what numbers are represented by the asterisks ($\\ast$). Each cofactor is multiplied by zero, so the final result must be zero." :tutorial/id #uuid "cee0a552-60f2-5785-a506-63bd053364c7" :tutorial/math-academy-id 6888 :tutorial/title "Introduction"} :step/id #uuid "b68428f5-f5bb-5090-b7f9-4971dc931914" :step/next {:db/id #edb/ref 17592186134902}} {:db/id #edb/ref 17592186134902 :step/content {:db/id #edb/ref 17592186135152 :tutorial/content "Now, suppose a matrix has no zero rows but it has two identical rows:\n\n![](images/74/7477781b618ec384b1638d01707acf545e7d9882ffca5bbc0efde4e224b04308.svg)\n\nWe can subtract the $1$st row from the $3$rd row, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & 3 \\\\ 1 & 2 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & 3 \\\\ 0 & 0 & 0\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nSince this operation does not change the determinant, we get $\\det(A) = \\det(B).$ Furthermore, as $B$ contains a zero row, we obtain\n\n$$\n\\det(A) = \\det(B) = 0.\n$$\n\nNotice that we can use this method with columns too. Therefore, we have the following property:\n\n*If a square matrix has at least two identical rows/columns, its determinant equals zero.*" :tutorial/id #uuid "6813d49e-3908-5735-8196-8e1aad5a14e6" :tutorial/math-academy-id 6889 :tutorial/title "Determinants with Identical Rows or Identical Columns"} :step/id #uuid "e105e6ae-64b8-5812-85e8-b5c3ef7b6c7d" :step/next {:db/id #edb/ref 17592186134903}} {:db/id #edb/ref 17592186134903 :step/content {:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f"} :step/id #uuid "f2a27f52-c605-5d01-84c1-49531f59d922" :step/next {:db/id #edb/ref 17592186134904}} {:db/id #edb/ref 17592186134904 :step/content {:db/id #edb/ref 17592186135153 :tutorial/content "Now, suppose a matrix has no zero rows and no identical rows but it has two proportional rows:\n\n![](images/81/8181d36ff1378310744b0d74f42f2934eb1e41053f45ecfeacf0c813abe994df.svg)\n\nWe can add three times the $1$st row to the $3$rd row, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & 3 \\\\ -3 & -6 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & 3 \\\\ 0 & 0 & 0\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nSince this operation does not change the determinant, we get $\\det(A) = \\det(B).$ Furthermore, as $B$ contains a zero row, we obtain\n\n$$\n\\det(A) = \\det(B) = 0.\n$$\n\nNotice that we can use this method with columns too. Therefore, we have the following property:\n\n*If a square matrix has at least two proportional rows/columns, its determinant equals zero.*" :tutorial/id #uuid "fe83e8c9-948a-596f-a2d9-c2ae2fe4f335" :tutorial/math-academy-id 6890 :tutorial/title "Determinants with Proportional Rows/Columns"} :step/id #uuid "23e26677-bdeb-5a45-a6d3-4a8d02a72732" :step/next {:db/id #edb/ref 17592186134905}} {:db/id #edb/ref 17592186134905 :step/content {:db/id #edb/ref 17592186133912 :knowledge-point/id #uuid "8aef330a-81b3-56c4-9559-67df673e8687"} :step/id #uuid "93111f5e-5fd2-5a5b-81b1-27969a9b5d1d" :step/next {:db/id #edb/ref 17592186134906}} {:db/id #edb/ref 17592186134906 :step/content {:db/id #edb/ref 17592186135154 :tutorial/content "In conclusion, if an $n\\!\\times \\!n$ matrix $A$ satisfies any one of the following conditions, then $\\det(A)=0.$\n\nI. $A$ has a zero row/column\n\nII. $A$ has two identical rows/columns\n\nIII. $A$ has two proportional rows/columns\n\nIV. $A$ has a row/column that is a linear combination of other rows/columns\n\nNotice that condition IV encompasses each of the conditions I, II, and III. If we have a zero row/column, two identical rows/columns, or proportional rows/columns, then the rows/columns form a linearly dependent set of vectors. \nIn turn, this means that one of the rows/columns is a linear combination of other rows/columns.\n\n**Watch out!** While all of the above conditions are *sufficient* to conclude that $\\det(A)=0,$ only condition IV is *necessary* to conclude that $\\det(A)=0.$ \nIn other words, if we have a matrix $A$ with $\\det(A)=0,$ then conditions I, II, and III may or may not be satisfied, while condition IV *must* be satisfied. \n\nSo, we have the following theorem:\n\n*$\\det(A)=0$ if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nFinally, note also that in the case of a $2\\times 2$ matrix *only*, statements III and IV mean the same thing." :tutorial/id #uuid "9d8b0323-170c-5a60-b372-1a258c4848cc" :tutorial/math-academy-id 6891 :tutorial/title "Conditions When a Determinant Equals Zero"} :step/id #uuid "4aec093b-050b-5263-9ef2-c875455b8c07" :step/next {:db/id #edb/ref 17592186134908}} {:db/id #edb/ref 17592186134907 :step/content {:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad"} :step/id #uuid "81571aa7-ce3d-5713-bf67-a49538fee0ef"} {:db/id #edb/ref 17592186134908 :step/content {:db/id #edb/ref 17592186135155 :tutorial/content "Geometrically, the absolute value of an $n \\times n$ determinant can be interpreted as the volume of the $n$-dimensional parallelepiped spanned by the columns of the determinant. \n\nFor example:\n\n- Suppose the columns of a $3\\times 3$ matrix $A$ are ${\\color{black}\\mathbf{a}}, {\\color{black}\\mathbf{b}},$ and ${\\color{black}\\mathbf{c}}.$\n![](images/6e/6e046341b7a1b8f6760797f7db89a7e021a6ace6b5cdf28bd5217998cb450837.svg)\nThe $3$-dimensional parallelepiped spanned by the columns of $A$ is depicted below:\n\n![](images/25/2597b48a010607fca71c551dbce8e9e2bbeda47d0892a582347ae1cdf19f1bf6.png)\n\nThe volume $V$ of this parallelepiped equals the absolute value of the determinant of $A{:}$\n\n$$\nV = \\left|\\det(A)\\right|\n$$\n\n- Now suppose the columns of a $2\\times 2$ matrix $B$ are ${\\color{black}\\mathbf{p}}$ and ${\\color{black}\\mathbf{q}}.$\n![](images/f5/f593c123eb081da0399e74c665325774758b48c5f086a7475b959905e1de2763.svg)\nThe $2$-dimensional parallelepiped (i.e., the parallelogram) spanned by vectors $\\mathbf{p}$ and $\\mathbf{q}$ is shown below:\n\n![](images/4a/4af1971404b188df75bb3d62d47ac95340c5e1791066e5358370d743230baa45.png)\n\nThe two-dimensional volume $V$ (i.e., the area) of this parallelepiped equals the absolute value of the determinant of $B{:}$\n\n$$\nV = \\left|\\det(B)\\right|\n$$\n\n- In general, the absolute value of the determinant of an $n\\times n$ matrix $M$ gives the $n$-dimensional volume of the parallelepiped spanned by the columns of $M.$\n\nIn this lesson, we studied the following property:\n\n*$\\det(A) = 0$ if and only if one of the columns of $A$ is a linear combination of other columns of $A$.*\n\nWhat does this property mean in geometric terms?\n\nThe component $\\det(A) = 0$ implies that the $n$-dimensional parallelepiped formed by the columns of $A$ has zero volume. Conversely, when one of the columns of $A$ is a linear combination of other columns, it indicates that the corresponding parallelepiped possesses at most $n-1$ distinct dimensions. \n\nConsider the following examples:\n\n- In the case of a $3$-dimensional parallelepiped, if the vector $\\mathbf{c}$ is a linear combination of the vectors $\\mathbf{a}$ and $\\mathbf{b}$, then $\\mathbf{c}$ lies within the plane containing $\\mathbf{a}$ and $\\mathbf{b}$. In other words, the vectors $\\mathbf{a}$, $\\mathbf{b}$, and $\\mathbf{c}$ are coplanar. Consequently, we obtain a \"flat\" ($2$-dimensional) figure with a volume of $0$.\n\n- For the parallelogram example, if the vector $\\mathbf{q}$ is a linear combination of the vector $\\mathbf{p}$ (i.e., $\\mathbf{p}$ and $\\mathbf{q}$ are proportional), then $\\mathbf{q}$ resides on the line containing vector $\\mathbf{p}$. In other words, the vectors $\\mathbf{p}$ and $\\mathbf{q}$ are collinear. This results in a $1$-dimensional object with a $2$-dimensional volume (i.e., area) of $0$." :tutorial/id #uuid "1f7191c6-60ca-5c44-befc-8dbad7779b08" :tutorial/math-academy-id 6893 :tutorial/title "Geometric Interpretation of a Zero Determinant"} :step/id #uuid "8c5dbeea-b2e4-5fe9-9d8c-98750164b70c" :step/next {:db/id #edb/ref 17592186134907}}] :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186134042} {:activity/first-step {:db/id #edb/ref 17592186415480} :activity/id #uuid "d3285aa6-5f09-548a-886c-a1acc2f7b8d6" :activity/steps [{:db/id #edb/ref 17592186415480 :step/content {:db/id #edb/ref 17592186415477 :question/id #uuid "d4554f29-f5fb-5556-852c-2f9d95422a4d"} :step/id #uuid "0922e6fb-1dc5-5a88-a985-bdf2643cb465" :step/next {:db/id #edb/ref 17592186415484}} {:db/id #edb/ref 17592186415481 :step/content {:db/id #edb/ref 17592186415479 :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742"} :step/id #uuid "73a434b3-1e72-5102-a3b4-f3e485e5088a" :step/next {:db/id #edb/ref 17592186415482}} {:db/id #edb/ref 17592186415482 :step/content {:db/id #edb/ref 17592186415475 :question/id #uuid "135c5d03-e391-5a5b-8227-7d54c7203318"} :step/id #uuid "7fde0eea-1a95-5e36-bc1d-53171442da99"} {:db/id #edb/ref 17592186415483 :step/content {:db/id #edb/ref 17592186415478 :question/id #uuid "e897ce2c-45dd-5cf3-9d25-ca84c0dd6ea8"} :step/id #uuid "8a73fe86-1dcc-5158-b5d0-cfa5bf0ca01e" :step/next {:db/id #edb/ref 17592186415481}} {:db/id #edb/ref 17592186415484 :step/content {:db/id #edb/ref 17592186415476 :question/id #uuid "8d883981-f066-5218-a1bf-dd76574de46e"} :step/id #uuid "a995ede1-d1f3-53d5-97cb-aed29dce50f7" :step/next {:db/id #edb/ref 17592186415483}}] :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186415444} {:activity/first-step {:db/id #edb/ref 17592186416116} :activity/id #uuid "9cb6054b-7ed5-5992-92b3-318764a5074c" :activity/steps [{:db/id #edb/ref 17592186416114 :step/content {:db/id #edb/ref 17592186415477 :question/id #uuid "d4554f29-f5fb-5556-852c-2f9d95422a4d"} :step/id #uuid "21677cec-5329-5c17-ae68-e4ce9c1eced7" :step/next {:db/id #edb/ref 17592186416118}} {:db/id #edb/ref 17592186416115 :step/content {:db/id #edb/ref 17592186272012 :question/id #uuid "f60fdb9d-cf89-59bd-ad65-e9ec096b82df"} :step/id #uuid "5d4a636e-e59e-599e-aff6-d3384708bbf3"} {:db/id #edb/ref 17592186416116 :step/content {:db/id #edb/ref 17592186329652 :question/id #uuid "fffc6699-6d6e-50bb-8cc3-7d4f0e3f1d17"} :step/id #uuid "72236d0c-8f54-552b-be75-f74f2ec50cbd" :step/next {:db/id #edb/ref 17592186416114}} {:db/id #edb/ref 17592186416117 :step/content {:db/id #edb/ref 17592186415479 :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742"} :step/id #uuid "cd1aa3f6-63e2-5747-ab7a-9aca6a4ae1ae" :step/next {:db/id #edb/ref 17592186416115}} {:db/id #edb/ref 17592186416118 :step/content {:db/id #edb/ref 17592186402861 :question/id #uuid "b44f28c6-ca93-5246-be2b-1a2725d36e07"} :step/id #uuid "dd405466-fc10-5821-904a-fe28c7027da8" :step/next {:db/id #edb/ref 17592186416117}}] :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186416113} {:activity/first-step {:db/id #edb/ref 17592186427638} :activity/id #uuid "831bdc32-0d6c-55b8-aa0e-17d1809789f3" :activity/steps [{:db/id #edb/ref 17592186427637 :step/content {:db/id #edb/ref 17592186415475 :question/id #uuid "135c5d03-e391-5a5b-8227-7d54c7203318"} :step/id #uuid "1a88a749-d24f-53f0-b27d-bb6b30fd5b09"} {:db/id #edb/ref 17592186427638 :step/content {:db/id #edb/ref 17592186329653 :question/id #uuid "59d4edee-acd9-59e0-80f8-ec3