edb/ref 17592186499627 :step/content {:db/id #edb/ref 17592186134394 :question/id #uuid "a804e446-7433-50c7-a8ce-2769d7a93237"} :step/id #uuid "e27b814b-a73a-54cb-83e5-018345109fb2" :step/next {:db/id #edb/ref 17592186499602}}] :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186498725}] :db/id #edb/ref 17592186049312 :topic/knowledge-points [{:db/id #edb/ref 17592186133911 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133466 :question/id #uuid "bb2795c3-6359-50d8-9531-1e9dfae7a2ce" :question/math-academy-id "e-10994" :question/problem "Find $5\\det(A)-\\det(B),$ where \n![](images/3e/3e712748e8fc744fc15cd6d7c1549aaba236b3254d9c65289288133e5daefad4.svg)" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has two identical columns, we obtain\n![](images/0a/0a19cbfc3164a365bb02386d16bac01562a36b39de41a4b2909e4397684f2cac.svg)\n\n- Since $B$ is a diagonal matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\n\\det(B) = 3 \\cdot (-4) \\cdot (-2) = 24\n$$\n\nTherefore, $5\\det(A)-\\det(B) = 5 \\cdot 0 - 24 = -24.$"} :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/questions [{:db/id #edb/ref 17592186134395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c225eb90-e2e0-5316-bf2c-433fb3c69768" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186132410} {:answer/id #uuid "320e4a8c-eedf-5588-98e8-c145e0ace715" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186132411} {:answer/id #uuid "43de3423-2ffd-5930-9ee0-ea5001c9a16b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186132412} {:answer/id #uuid "53f34a5f-dc76-5b22-9b1f-04217732f9e1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186132413} {:answer/id #uuid "796055cc-72c1-5b68-9805-3a39d9b06647" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186132414}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186132410} :answer-field/id #uuid "33879ed2-4ff8-5792-966a-daa49f7bc975" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132409}] :question/id #uuid "dcb38d39-eeab-5f94-bc9b-9cb1d6df2c04" :question/math-academy-id "q-42461" :question/problem "Find $2det(A)+4det(B)$, where \n\n$$\nA=[\\begin{aligned}1 & 0 & \\sqrt{3} & 1 \\\\ 0 & 2 & 4 & 2 \\\\ 0 & 0 & 2 & -4 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}3 & \\sqrt{2} & 2 & 3 \\\\ 1 & 2 & 1 & 3 \\\\ 3 & 1 & 0 & \\sqrt{2} \\\\ 1 & 2 & 1 & 3\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\ndet(A)=1\\cdot 2\\cdot 2\\cdot 1=4\n$$\n\n- Since $B$ has two identical rows, we obtain\n\n$$\nB=[\\begin{aligned}3 & \\sqrt{2} & 2 & 3 \\\\ 1 & 2 & 1 & 3 \\\\ 3 & 1 & 0 & \\sqrt{2} \\\\ 1 & 2 & 1 & 3\\end{aligned}]\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $2det(A)+4det(B)=2\\cdot 4+4\\cdot 0=8.$"} {:db/id #edb/ref 17592186134408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025d4fe7-912b-5dd2-9e59-0f9e27e42564" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186326959} {:answer/id #uuid "0b78b8cf-6e3b-5e97-89b9-e4607f53b9c3" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186327035} {:answer/id #uuid "68941b7c-87c5-5d4d-a0c5-f9192e02ec8b" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186327836} {:answer/id #uuid "9231df0a-ccd7-5f2a-9501-f2efeb7f0ccf" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$, $|B|$, and $|C|$" :db/id #edb/ref 17592186328205} {:answer/id #uuid "dcc18135-f248-5156-83fe-02e74da6694d" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186328862}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186328862} :answer-field/id #uuid "a1401c3e-df25-5867-8647-15f11560a136" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329457}] :question/id #uuid "bf123fc4-eb0a-5072-9e49-491e1d68008c" :question/math-academy-id "q-42959" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & 0 & 1 \\\\ \\sqrt{5} & 0 & 4 \\\\ -1 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}3 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 5\\end{aligned}|,\\,|C|=|\\begin{aligned}4 & \\sqrt{3} & 4 \\\\ 2 & 4 & 2 \\\\ 1 & \\sqrt{5} & 1\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero column: \n\n$$\nA=\\begin{bmatrix}2 & 0 & 1 \\\\ \\sqrt{5} & 0 & 4 \\\\ -1 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- Since $B$ is a diagonal matrix, we obtain \n\n$$\n|B|=3\\cdot (-1)\\cdot 5=-15\\ne 0.\n$$\n\n- The matrix $C$ has identical columns: \n\n$$\nC=\\begin{bmatrix}4 & \\sqrt{3} & 4 \\\\ 2 & 4 & 2 \\\\ 1 & \\sqrt{5} & 1\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186272009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a27c8da-39a9-579c-bd39-690a5d141b57" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270210} {:answer/id #uuid "911eda15-9f0b-566b-bb61-5aa5ded117fe" :answer/type {:db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186270531} {:answer/id #uuid "c79a6761-2af0-5fbd-9a09-bce6d446e1aa" :answer/type {:db/ident :answer.type/math} :answer/value "-144" :db/id #edb/ref 17592186271027} {:answer/id #uuid "dd203548-e885-50f3-a9de-086a9a9d5137" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186271207} {:answer/id #uuid "f39588a0-7f73-5abb-ba4a-6821e980fca7" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186271405}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270210} :answer-field/id #uuid "fb48c17a-a8fe-590f-8b33-3fa9a637aaee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271943}] :question/id #uuid "af7ad35e-ed21-563b-8828-398028521546" :question/math-academy-id "q-140044" :question/problem "Find $det(A)-3det(B)$, where \n\n$$\nA=\\begin{bmatrix}2 & -2 & 2 & 2 \\\\ -1 & 1 & 0 & -1 \\\\ 1 & 1 & 1 & 1 \\\\ 3 & -3 & -3 & 3\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 4 & 0 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 3 & 1 & 0 \\\\ 1 & 2 & -3 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has two identical columns, we obtain\n\n$$\nA=\\begin{bmatrix}2 & -2 & 2 & 2 \\\\ -1 & 1 & 0 & -1 \\\\ 1 & 1 & 1 & 1 \\\\ 3 & -3 & -3 & 3\\end{bmatrix}\\,⟹\\,det(A)=0.\n$$\n\n- Since $B$ has a zero row, we obtain:\n\n$$\nB=\\begin{bmatrix}3 & 4 & 0 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 3 & 1 & 0 \\\\ 1 & 2 & -3 & 1\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $det(A)-3det(B)=0-3\\cdot 0=0.$"} {:db/id #edb/ref 17592186329700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26501f58-881f-5efc-856a-b32d1ee8088d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186327266} {:answer/id #uuid "608ea971-d78c-578d-816e-c8d8d9fbb167" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186327782} {:answer/id #uuid "87c21507-097c-54e9-98e0-37922d796fb7" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt{5}" :db/id #edb/ref 17592186328103} {:answer/id #uuid "d3a9e845-0b2d-596a-962b-345596d1f19f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{5}" :db/id #edb/ref 17592186328792} {:answer/id #uuid "fe2b8a36-70d0-56e2-a760-93acc609a76b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186329167}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186327266} :answer-field/id #uuid "7ec99a44-6d87-5ca7-8efa-c3acfffc845c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329393}] :question/id #uuid "28b8a89e-dee6-5589-be7f-d0c7386a7fd0" :question/math-academy-id "q-42958" :question/problem "Find $2det(A)+3det(B)$, where \n\n$$\nA=\\begin{bmatrix}3 & -1 \\\\ 2 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}0.17 & \\sqrt{5} & 4 \\\\ 2 & -3 & 6 \\\\ 2 & -3 & 6\\end{bmatrix}.\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ is a $2\\times 2$ matrix, its determinant is:\n\n$$\ndet(A)=3\\cdot 1-2\\cdot (-1)=5\n$$\n\n- Since $B$ has two identical rows, we obtain\n\n$$\nB=\\begin{bmatrix}0.17 & \\sqrt{5} & 4 \\\\ 2 & -3 & 6 \\\\ 2 & -3 & 6\\end{bmatrix}\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $2det(A)+3det(B)=2\\cdot 5+3\\cdot 0=10.$"} {:db/id #edb/ref 17592186351408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b42c01-1203-51e4-be8b-21a9f39326a6" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186348628} {:answer/id #uuid "51138293-d6f9-5d84-bddb-383e6734b677" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186349182} {:answer/id #uuid "5c1925ee-5925-5920-8f08-d4f72bb7c204" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186349295} {:answer/id #uuid "74c3f5d0-0ab9-569f-8ee2-928fd0331d7b" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186349519} {:answer/id #uuid "ac651b79-6add-5d70-bffb-99987c7c964c" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186349975}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186349182} :answer-field/id #uuid "e1b6b7be-c0e0-5f4b-b713-96fc09be7392" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351101}] :question/id #uuid "2eb579cc-338e-51a2-b3da-e05dcf5ef478" :question/math-academy-id "q-82286" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}-1 & 0 & 0 \\\\ 0 & \\sqrt{3} & 0 \\\\ 0 & 0 & 1\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & -2 & 2 \\\\ 1 & -2 & 2 \\\\ \\sqrt{3} & 1 & \\sqrt{2}\\end{aligned}|,\\,|C|=|\\begin{aligned}4 & 0 & 0 \\\\ \\sqrt{3} & -1 & 0 \\\\ 0 & -1 & 2\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- Since $A$ is a diagonal matrix, we obtain \n\n$$\n|A|=(-1)\\cdot \\sqrt{3}\\cdot 1=-\\sqrt{3}\\ne 0.\n$$\n\n- The matrix $B$ has two identical rows: \n\n$$\nB=\\begin{bmatrix}1 & -2 & 2 \\\\ 1 & -2 & 2 \\\\ \\sqrt{3} & 1 & \\sqrt{2}\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- Since $C$ is a triangular matrix, we obtain \n\n$$\n|C|=4\\cdot (-1)\\cdot 2=-8\\ne 0.\n$$\n\nTherefore, only $|B|$ is equal to $0.$"} {:db/id #edb/ref 17592186400867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f03dd7eb-af5f-5f22-813b-7f3d5b84651c" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ only" :db/id #edb/ref 17592186400869} {:answer/id #uuid "ab86d5e2-989c-5d49-9b2d-7a183fd53e17" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186400870} {:answer/id #uuid "da8626ef-a38f-59a8-a718-2155b988e445" :answer/type {:db/ident :answer.type/text} :answer/value "$|C|$ only" :db/id #edb/ref 17592186400871} {:answer/id #uuid "c0fe0f31-e9db-50f1-a23b-a66578e23d9f" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186400872} {:answer/id #uuid "1485ab74-1a6a-53e5-9aaf-e407a69b362d" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186400873}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186400870} :answer-field/id #uuid "d252fa00-ae50-5d73-8bce-ecc15224f399" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400868}] :question/id #uuid "3c1bd5a4-43fd-5d63-843c-209b976b49d5" :question/math-academy-id "q-140046" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & 0 & 0 & 0 \\\\ -\\sqrt{3} & 1 & 0 & 0 \\\\ \\sqrt{6} & 0 & 1 & 0 \\\\ 18 & \\sqrt{6} & \\sqrt{3} & 4\\end{aligned}|,\\,|B|=|\\begin{aligned}-2 & 0 & -2 \\\\ 3 & 1 & 3 \\\\ 1 & 0 & 1\\end{aligned}|,\\,|C|=|\\begin{aligned}5 & -2 \\\\ -10 & 4\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The $A$ is a triangular matrix, we obtain\n\n$$\n|A|=2\\cdot 1\\cdot 1\\cdot 4=8\\ne 0.\n$$\n\n- The matrix $B$ has identical columns:\n\n$$\nB=\\begin{bmatrix}-2 & 0 & -2 \\\\ 3 & 1 & 3 \\\\ 1 & 0 & 1\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- Since $C$ is a $2\\times 2$ matrix, its determinant is:\n\n$$\ndet(C)=5\\cdot 4-(-2)\\cdot (-10)=0\n$$\n\nTherefore, only $|B|$ and $|C|$ are equal to $0.$"} {:db/id #edb/ref 17592186420351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "246b7875-4b94-5946-ab56-53b0efdaa23b" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ only" :db/id #edb/ref 17592186420334} {:answer/id #uuid "545d8b36-38e5-559e-a61d-ce2a27111cbd" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|,$ $|B|,$ and $|C|$" :db/id #edb/ref 17592186420339} {:answer/id #uuid "583e2bd2-06b9-53e2-a4b9-5c8a9049a9c1" :answer/type {:db/ident :answer.type/text} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186420340} {:answer/id #uuid "6272e38a-2afb-598f-b018-441d73a31140" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186420341} {:answer/id #uuid "e5b9947c-9286-555b-9fb9-6a06456c5033" :answer/type {:db/ident :answer.type/text} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186420346}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$|A|,$ $|B|,$ and $|C|$" :db/id #edb/ref 17592186420339} :answer-field/id #uuid "916484e9-1c80-5d3a-8194-ccf0b63cf5fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420349}] :question/id #uuid "2642af15-1045-5d0f-97c1-3ce034155f08" :question/math-academy-id "q-82285" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}1 & -1 & 2 & -1 \\\\ 4 & 5 & \\sqrt{3} & 5 \\\\ 0 & 8 & -1 & 8 \\\\ 1 & 0 & 1 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}6 & \\sqrt{7} & 1 \\\\ 2 & 3 & -1 \\\\ 2 & 3 & -1\\end{aligned}|,\\,|C|=|\\begin{aligned}6 & 1 & 0 \\\\ 1 & -\\sqrt{2} & 2 \\\\ 0 & 0 & 0\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn. \n\n- The matrix $A$ has identical columns: \n\n$$\nA=\\begin{bmatrix}1 & -1 & 2 & -1 \\\\ 4 & 5 & \\sqrt{3} & 5 \\\\ 0 & 8 & -1 & 8 \\\\ 1 & 0 & 1 & 0\\end{bmatrix}\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ has identical rows: \n\n$$\nB=\\begin{bmatrix}6 & \\sqrt{7} & 1 \\\\ 2 & 3 & -1 \\\\ 2 & 3 & -1\\end{bmatrix}\n$$\n\nAs a result, $|B|=0.$\n\n- The matrix $C$ has a zero row: \n\n$$\nC=\\begin{bmatrix}6 & 1 & 0 \\\\ 1 & -\\sqrt{2} & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, $|A|,$ $|B|,$ and $|C|$ are equal to $0.$"} 