36}}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186524375} {:activity/first-step {:db/id #edb/ref 17592186551431} :activity/id #uuid "539d761e-4a66-5a50-b7b6-b417f5df20a3" :activity/steps [{:db/id #edb/ref 17592186551375 :step/content {:db/id #edb/ref 17592186348338 :question/id #uuid "972f430d-f05f-5657-9e37-d9ee4828f532"} :step/id #uuid "22a4c316-56c0-5848-adb3-ad83851869be" :step/next {:db/id #edb/ref 17592186551465}} {:db/id #edb/ref 17592186551427 :step/content {:db/id #edb/ref 17592186120297 :question/id #uuid "c2558d4d-1eea-5e1f-b2f5-44cc93092823"} :step/id #uuid "95635de5-b7cc-5b55-b41d-de111b9362f2" :step/next {:db/id #edb/ref 17592186551375}} {:db/id #edb/ref 17592186551431 :step/content {:db/id #edb/ref 17592186365883 :question/id #uuid "7a0536ad-4890-5a1a-ae11-f816e5c8b4de"} :step/id #uuid "a2aa3b79-c6a6-59a0-ad57-3c97a3628133" :step/next {:db/id #edb/ref 17592186551427}} {:db/id #edb/ref 17592186551454 :step/content {:db/id #edb/ref 17592186262956 :question/id #uuid "04f29aba-0bc5-533b-80be-91fd747ce6a1"} :step/id #uuid "d7e7fe84-9da4-5fb8-b4d8-3230d5d24a65"} {:db/id #edb/ref 17592186551465 :step/content {:db/id #edb/ref 17592186262945 :question/id #uuid "70fdcc6d-7515-5a08-8576-979fc8c2e25e"} :step/id #uuid "f12b15ef-1bbe-5947-b51e-ebdfbe5010c6" :step/next {:db/id #edb/ref 17592186551454}}] :activity/title "The Shortest Distance Between a Plane and a Point" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186550347}] :db/id #edb/ref 17592186049322 :topic/knowledge-points [{:db/id #edb/ref 17592186119839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119653 :question/id #uuid "38fce106-2ba8-554c-ace3-a5731d15a635" :question/math-academy-id "e-4949" :question/problem "Find the shortest distance between the point $P(5,2,-2)$ and the plane $\\Pi$ with equation ![](images/f9/f9fe9fa5e18e286ac7e026df2667c7a8ce259cd2c0416efe85d66d2546358dfd.svg)" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(4,8,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}4 \\\\ 8 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 2 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 6 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector ![](images/9e/9e7b8bc888dbf7a764c0d5b9533758277b59e78d476a3cfe7bbfb2fcac7e7363.svg)\n\nFinally, the shortest distance from the point $P$ to the plane $\\Pi$ is the absolute value of the scalar projection of $\\overrightarrow{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 2+6\\cdot 4+4\\cdot (-4)|}{\\sqrt{{2}^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-2+24-16|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|\\,6\\,|}{\\sqrt{36}} \\\\  & =1\\end{aligned}\n$$"} :knowledge-point/id #uuid "6f53201a-0d75-5f17-b869-009c8e0523c7" :knowledge-point/questions [{:db/id #edb/ref 17592186120251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c60338e-01a1-5dee-8591-c336fa874093" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186305574} {:answer/id #uuid "3d434f72-d817-5ecc-ac32-f306d8348871" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186305740} {:answer/id #uuid "4c63108d-37a0-5e05-9e05-a8c63375f3fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186305886} {:answer/id #uuid "c0a55a85-35d3-5215-afa4-5ce34145b01c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186306949} {:answer/id #uuid "e089a8c7-c335-5973-89cf-0c76d86099e8" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186307229}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186305886} :answer-field/id #uuid "dc585d07-d772-5e65-84ec-8fbe4a5c3c81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308212}] :question/id #uuid "7f22d111-9bd0-53c0-9506-a867aa25de4e" :question/math-academy-id "q-33466" :question/problem "Find the shortest distance between the point $P(3,5,-2)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}5 \\\\ 9 \\\\ 0\\end{bmatrix})\\cdot \\begin{bmatrix}-2 \\\\ 2 \\\\ -4\\end{bmatrix}=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(5,9,0).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}5 \\\\ 9 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 5 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 4 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}-2 \\\\ 2 \\\\ -4\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+4\\cdot 2+2\\cdot (-4)|}{\\sqrt{(-2)^{2}+{2}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-4+8-8|}{\\sqrt{4+4+16}} \\\\  & =\\frac{|-4|}{\\sqrt{24}} \\\\  & =\\frac{\\sqrt{6}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012fcbcb-91f5-5d84-baae-8e40c8a9ff5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\sqrt{17}}{17}" :db/id #edb/ref 17592186311968} {:answer/id #uuid "a0dcc435-e152-5c21-b059-a27d1c8e269d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313238} {:answer/id #uuid "ab2e6bfc-b2e4-5dfd-8c9f-756a2adc76d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26\\sqrt{17}}{17}" :db/id #edb/ref 17592186313316} {:answer/id #uuid "ba08b3cf-3a20-581d-8229-4f6595c867b8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186313424} {:answer/id #uuid "e3a09eb1-ae9c-52ff-a61c-def86df91375" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19\\sqrt{17}}{17}" :db/id #edb/ref 17592186313769}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26\\sqrt{17}}{17}" :db/id #edb/ref 17592186313316} :answer-field/id #uuid "bf0e7604-5762-5e3d-ac82-d8ade2c2ebb8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314540}] :question/id #uuid "6fe2eafb-89b6-55ce-bbec-c86f82bc889c" :question/math-academy-id "q-34031" :question/problem "Find the shortest distance between the point $P(-1,2,-3)$ and the plane $Π$ with equation $(r-⟨1,-5,3⟩)\\cdot ⟨1,0,4⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(1,-5,3).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-5,3⟩-⟨-1,2,-3⟩ \\\\  & =⟨2,-7,6⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨1,0,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 1+(-7)\\cdot 0+6\\cdot 4|}{\\sqrt{{1}^{2}+{0}^{2}+{4}^{2}}} \\\\  & =\\frac{|2+0+24|}{\\sqrt{1+16}} \\\\  & =\\frac{|26|}{\\sqrt{17}} \\\\  & =\\frac{26\\sqrt{17}}{17}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1426b4cb-9e24-5715-974e-23f0f7e67c29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186260052} {:answer/id #uuid "1763d239-399f-53cc-b92e-64047a1c4ed4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186260081} {:answer/id #uuid "9fd63602-f48f-540c-9da5-063b52b70a07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{3}" :db/id #edb/ref 17592186261262} {:answer/id #uuid "a5321125-d545-5bcc-8241-1de01c3f3e65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186261311} {:answer/id #uuid "e00434f4-28c6-5bb1-9562-317b3b0e5889" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186261854}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186261854} :answer-field/id #uuid "1693cc24-6bf0-50ec-8455-173786f359dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262164}] :question/id #uuid "8546d107-b6a4-5c4c-927b-70c193b5c70f" :question/math-academy-id "q-129094" :question/problem "Find the shortest distance between the point $P(1,2,-3)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix})\\cdot \\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(1,-2,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -4 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}-2 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|0\\cdot (-2)+(-4)\\cdot 1+4\\cdot 2|}{\\sqrt{(-2)^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{|-4+8|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|4|}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1bcf37-bd86-518e-aede-5addbc97699f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260269} {:answer/id #uuid "59b5fe8c-5178-580c-8f7a-66873832ec9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186260642} {:answer/id #uuid "88058d4a-9c93-58e8-8a93-6bee79401fa7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261061} {:answer/id #uuid "e3a0b17a-e727-58fc-a945-2805ffef7542" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186261877} {:answer/id #uuid "ff90ee60-4b7a-54cd-af1f-b95d8d140b21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186262116}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186262116} :answer-field/id #uuid "84f58d02-2871-5109-a5be-ccd4ac8940b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262352}] :question/id #uuid "aec3d295-8d51-5dda-ba42-3f14845dd36d" :question/math-academy-id "q-129095" :question/problem "Find the shortest distance between the point $P(5,2,2)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix})\\cdot \\begin{bmatrix}4 \\\\ 2 \\\\ 4\\end{bmatrix}=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(2,-1,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}5 \\\\ 2 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}-3 \\\\ -3 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}4 \\\\ 2 \\\\ 4\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-3)\\cdot 4+(-3)\\cdot 2+(-1)\\cdot 4|}{\\sqrt{{4}^{2}+{2}^{2}+{4}^{2}}} \\\\  & =\\frac{|-12-6-4|}{\\sqrt{16+4+16}} \\\\  & =\\frac{|-22|}{\\sqrt{36}} \\\\  & =\\frac{11}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85bfeaad-8fb2-554e-8b2b-d6d9ed270b1c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261036} {:answer/id #uuid "bd225387-6f08-563a-93e5-580bc2de3fea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{6}" :db/id #edb/ref 17592186261545} {:answer/id #uuid "d0f76626-293d-5a1e-8f85-4c41b77781d7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261718} {:answer/id #uuid "f31c25d9-affe-52b8-9d24-8d18f213abac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{6}" :db/id #edb/ref 17592186261999} {:answer/id #uuid "f77957ce-cde7-579a-b04a-0021d67a5621" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186262038}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261718} :answer-field/id #uuid "115d5aec-aeb8-5f5b-ae56-1f5bd75035da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262154}] :question/id #uuid "207cee96-48ff-5895-931d-4abf12241582" :question/math-academy-id "q-129096" :question/problem "Find the shortest distance between the point $P(-3,1,4)$ and the plane $Π$ with equation $(r-⟨3,-2,1⟩)\\cdot ⟨-2,4,-4⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(3,-2,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-2,1⟩-⟨-3,1,4⟩ \\\\  & =⟨6,-3,-3⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-2,4,-4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|6\\cdot (-2)+(-3)\\cdot 4+(-3)\\cdot (-4)|}{\\sqrt{(-2)^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-12|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-12|}{\\sqrt{36}} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6a76b-abc9-5372-a7ee-45b40832c99f" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186259938} {:answer/id #uuid "2f08165d-5a4c-57f5-8879-fd9080d17d98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186260299} {:answer/id #uuid "34a5a6b7-596c-5939-a597-01b584e0736b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186260345} {:answer/id #uuid "4cd14353-9e02-5403-b132-32e7153397aa" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260530} {:answer/id #uuid "adc6892e-d471-56a6-a370-4372feb2fafa" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186261402}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186259938} :answer-field/id #uuid "d6db4bc9-8bdd-55c6-88be-86bab3785cc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262498}] :question/id #uuid "960aa08b-12d7-5431-bffd-ca432327fbf3" :question/math-academy-id "q-129098" :question/problem "Find the shortest distance between the point $P(-4,3,-1)$ and the plane $Π$ with equation $(r-⟨6,-1,5⟩)\\cdot ⟨-1,2,-2⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,-1,5).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,-1,5⟩-⟨-4,3,-1⟩ \\\\  & =⟨10,-4,6⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-1,2,-2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot (-1)+(-4)\\cdot 2+6\\cdot (-2)|}{\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-8-12|}{\\sqrt{1+4+4}} \\\\  & =\\frac{|-30|}{\\sqrt{9}} \\\\  & =\\frac{30}{3} \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a92d928e-1d05-5a2c-8a13-b4b2ac358487" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261355} {:answer/id #uuid "b65672ab-0c5c-5d72-ac1e-dabd447776a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186261476} {:answer/id #uuid "b673a58a-20af-57eb-b855-61aa31129841" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261477} {:answer/id #uuid "c8758111-549c-50e6-987d-aa18fe164d54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186261648} {:answer/id #uuid "ec5a150d-29da-575d-a84b-8bf4069cb081" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261950}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261477} :answer-field/id #uuid "bf6fc720-45dd-52de-b923-8c3e0a788e5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262470}] :question/id #uuid "997f5746-6279-5d4c-b439-ed85502108fc" :question/math-academy-id "q-129100" :question/problem "Find the shortest distance between the point $P(8,-3,5)$ and the plane $Π$ with equation $(r-⟨7,-2,4⟩)\\cdot ⟨-2,-3,6⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(7,-2,4).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨7,-2,4⟩-⟨8,-3,5⟩ \\\\  & =⟨-1,1,-1⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-2,-3,6⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot (-2)+1\\cdot (-3)+(-1)\\cdot 6|}{\\sqrt{(-2)^{2}+(-3)^{2}+{6}^{2}}} \\\\  & =\\frac{|2-3-6|}{\\sqrt{4+9+36}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1367d4c3-b5b1-5690-aab2-44985cf01bb9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186305319} {:answer/id #uuid "24668b28-99b9-5e54-a0c4-bc028c4820c0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{14}" :db/id #edb/ref 17592186305498} {:answer/id #uuid "3c9d610b-76c5-572b-a11e-883ee62d0ce1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186305730} {:answer/id #uuid "74516533-ce85-5ad6-abd6-3d0bfcce4ee9" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186306254} {:answer/id #uuid "c88bd5db-6ebf-5c09-b65a-02699a419dac" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186307017}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{14}" :db/id #edb/ref 17592186305498} :answer-field/id #uuid "e6643fe3-e25b-594a-a4db-390d58331c15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308248}] :question/id #uuid "5cc5509e-3cff-5470-9ead-3ffe928da922" :question/math-academy-id "q-33451" :question/problem "Find the shortest distance between the point $P(2,0,-5)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}6 \\\\ 3 \\\\ 1\\end{bmatrix})\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,3,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}6 \\\\ 3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 0 \\\\ -5\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 3 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot 1+3\\cdot 2+6\\cdot 3|}{\\sqrt{{1}^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|4+6+18|}{\\sqrt{1+4+9}} \\\\  & =\\frac{|28|}{\\sqrt{14}} \\\\  & =2\\sqrt{14}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03bcdf62-51d9-5553-97e4-b8e82ddd7525" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186305185} {:answer/id #uuid "84cc3a62-7903-53f2-b22f-8ca83177efd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186306418} {:answer/id #uuid "a5f03628-3598-5d8b-b88f-17bc239516c7" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186306714} {:answer/id #uuid "cfc097c6-4f70-5235-9fba-6c9df3c307b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186307069} {:answer/id #uuid "f636eb30-c8ec-5afe-995f-4a8cc8485d0e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186307435}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186307069} :answer-field/id #uuid "ff39c2a1-0c41-5780-9d81-0f8662b492a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308337}] :question/id #uuid "a8925614-d403-5814-9cbc-785e6ec5b0c2" :question/math-academy-id "q-33467" :question/problem "Find the shortest distance between the point $P(4,15,-5)$ and the plane $Π$ with equation $(r-\\begin{bmatrix}6 \\\\ 9 \\\\ 2\\end{bmatrix})\\cdot \\begin{bmatrix}-5 \\\\ 1 \\\\ -2\\end{bmatrix}=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,9,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\begin{bmatrix}6 \\\\ 9 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}4 \\\\ 15 \\\\ -5\\end{bmatrix}=\\begin{bmatrix}2 \\\\ -6 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=\\begin{bmatrix}-5 \\\\ 1 \\\\ -2\\end{bmatrix}.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-5)+(-6)\\cdot 1+7\\cdot (-2)|}{\\sqrt{(-5)^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-6-14|}{\\sqrt{25+1+4}} \\\\  & =\\frac{|-30|}{\\sqrt{30}} \\\\  & =\\sqrt{30}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466771cc-d368-518c-a407-118cef3850d5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186443245} {:answer/id #uuid "5cbe681d-c67b-512a-b210-fd917c390fd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{9}" :db/id #edb/ref 17592186443248} {:answer/id #uuid "63d845d3-365f-535b-afff-d5908b0a7da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{9}" :db/id #edb/ref 17592186443249} {:answer/id #uuid "da38d1c3-4b88-53eb-a80c-704d0e6c3e9d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186443258} {:answer/id #uuid "e59f1960-0256-5298-9dd6-cb0ef30a5ab8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186443260}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186443258} :answer-field/id #uuid "1d64e0b6-2371-55aa-b403-0c4879d7c148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443262}] :question/id #uuid "c2de4bc9-44ca-5148-a12b-218413513154" :question/math-academy-id "q-34071" :question/problem "Find the shortest distance between the point $P(1,1,-1)$ and the plane $Π$ with equation $(r-⟨3,0,1⟩)\\cdot ⟨1,-8,4⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(3,0,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,0,1⟩-⟨1,1,-1⟩ \\\\  & =⟨2,-1,2⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨1,-8,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 1+(-1)\\cdot (-8)+2\\cdot 4|}{\\sqrt{{1}^{2}+(-8)^{2}+{4}^{2}}} \\\\  & =\\frac{|2+8+8|}{\\sqrt{1+64+16}} \\\\  & =\\frac{|18|}{\\sqrt{81}} \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186516802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0746c2b1-8397-5ca4-bcc4-2be9ad0a31a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186516126} {:answer/id #uuid "15641019-eb48-5052-a403-60ab3dfb5dc2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186516154} {:answer/id #uuid "2ab0e081-5b86-55e7-981c-cd34744c91c3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186516200} {:answer/id #uuid "c462e695-1e8c-53ef-a160-41238e99ef40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186516528} {:answer/id #uuid "d8ba0ca6-2710-5bc6-975d-35ed2106bb35" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186516568}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186516568} :answer-field/id #uuid "7fc70b3f-42c6-5104-a98d-c3951c9ae2dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516711}] :question/id #uuid "4f033659-c7d6-5be9-97da-6420561e0286" :question/math-academy-id "q-129101" :question/problem "Find the shortest distance between the point $P(7,-2,3)$ and the plane $Π$ with equation $(r-⟨5,-1,6⟩)\\cdot ⟨-6,3,2⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(5,-1,6).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨5,-1,6⟩-⟨7,-2,3⟩ \\\\  & =⟨-2,1,3⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-6,3,2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-2)\\cdot (-6)+1\\cdot 3+3\\cdot 2|}{\\sqrt{(-6)^{2}+{3}^{2}+{2}^{2}}} \\\\  & =\\frac{|12+3+6|}{\\sqrt{36+9+4}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186516850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38452af2-3463-5e38-b50f-517dc777cb12" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186516229} {:answer/id #uuid "5269850f-0a46-56fc-897c-8ca14b3bd2c7" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186516283} {:answer/id #uuid "a3d86851-66fb-594c-bde9-ae083bc8675f" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186516452} {:answer/id #uuid "e6d74405-0178-5fb3-b7ac-3794c3723eac" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186516592} {:answer/id #uuid "f61645ce-a87d-59da-b373-17d56da8e2f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28}{5}" :db/id #edb/ref 17592186516625}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186516229} :answer-field/id #uuid "6ab8132e-9ff7-5697-a331-2b7476559e4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516698}] :question/id #uuid "c7dcf7da-2297-59af-930a-8b2c6aff00d1" :question/math-academy-id "q-129099" :question/problem "Find the shortest distance between the point $P(-4,3,-1)$ and the plane $Π$ with equation $(r-⟨6,-1,4⟩)\\cdot ⟨4,0,-3⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,-1,4).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,-1,4⟩-⟨-4,3,-1⟩ \\\\  & =⟨10,-4,5⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨4,0,-3⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot 4+(-4)\\cdot 0+5\\cdot (-3)|}{\\sqrt{{4}^{2}+{0}^{2}+(-3)^{2}}} \\\\  & =\\frac{|40+0-15|}{\\sqrt{16+9}} \\\\  & =\\frac{|25|}{\\sqrt{25}} \\\\  & =\\frac{25}{5} \\\\  & =5.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Dot Product Form"} {:db/id #edb/ref 17592186119840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119654 :question/id #uuid "74693316-2e5a-5821-87a5-fdc5b8719c82" :question/math-academy-id "e-4950" :question/problem "Given that $Q(1,-2,-1)$ lies on the plane $\\Pi:\\mathbf{r} \\cdot \\langle 2, 0, -2 \\rangle = 4,$ find the shortest distance from $P(0 , -1 , 2)$ to $\\Pi.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-2,-1⟩-⟨0,-1,2⟩ \\\\  & =⟨1,-1,-3⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $\\mathbf{n}= \\langle 2, 0, -2 \\rangle.$\n\nFinally, the shortest distance from the point $P$ to the plane $\\Pi$ is the absolute value of the scalar projection of $\\overrightarrow{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot 2+(-1)\\cdot 0+(-3)\\cdot (-2)|}{\\sqrt{{2}^{2}+{0}^{2}+(-2)^{2}}} \\\\  & =\\frac{|2+0+6|}{\\sqrt{4+0+4}} \\\\  & =\\frac{|\\,8\\,|}{\\sqrt{8}} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$"} :knowledge-point/id #uuid "5a50c5f1-fbda-5c87-afa2-32495c69c18d" :knowledge-point/questions [{:db/id #edb/ref 17592186120295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cdb367a-ee31-52bd-8e49-76ea1a5deb03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{42}}{21}" :db/id #edb/ref 17592186312716} {:answer/id #uuid "81295061-9129-54aa-abdf-5c3501c97825" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186313016} {:answer/id #uuid "b83ec77e-cb86-58e7-b5e7-11f319ededff" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313407} {:answer/id #uuid "c84ad60d-9ec0-5f78-8c5d-b836c1212756" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{42}}{21}" :db/id #edb/ref 17592186313539} {:answer/id #uuid "e03a1af2-0bc1-5341-b0a6-801b7d85e33d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{42}}{21}" :db/id #edb/ref 17592186313740}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313407} :answer-field/id #uuid "aeb3b460-9b49-5397-9192-f15cd9be5b1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314481}] :question/id #uuid "6b172ee6-d9cd-537d-b8f8-03c5ed9b48c1" :question/math-academy-id "q-34062" :question/problem "Given that $Q(4,0,-3)$ lies on the plane $Π:r\\cdot ⟨1,-4,5⟩=-11$, find the shortest distance from $P(-2,1,-1)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,0,-3⟩-⟨-2,1,-1⟩ \\\\  & =⟨6,-1,-2⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨1,-4,5⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|6\\cdot 1+(-1)\\cdot (-4)+(-2)\\cdot 5|}{\\sqrt{{1}^{2}+(-4)^{2}+{5}^{2}}} \\\\  & =\\frac{|6+4-10|}{\\sqrt{1+16+25}} \\\\  & =\\frac{|\\,0\\,|}{\\sqrt{42}} \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the point $P$ lies on the plane $Π.$"} {:db/id #edb/ref 17592186120297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197bde4a-499b-599d-85d4-fececf5a4c86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{2}" :db/id #edb/ref 17592186312157} {:answer/id #uuid "39dd64e5-e64f-52c7-a252-928ef189f344" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186312446} {:answer/id #uuid "852ee814-04e9-5368-9076-4b3fcebb9c13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{26}}{5}" :db/id #edb/ref 17592186313046} {:answer/id #uuid "cac3a008-d07d-5f6d-820b-f9604469598b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{3}" :db/id #edb/ref 17592186313558} {:answer/id #uuid "f017a355-98b1-5291-af6b-152a8f2467c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313899}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186312446} :answer-field/id #uuid "1d1fda63-5573-5ee3-9a63-c10505b09ac7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314085}] :question/id #uuid "c2558d4d-1eea-5e1f-b2f5-44cc93092823" :question/math-academy-id "q-34075" :question/problem "Given that $Q(1,3,5)$ lies on the plane $Π:r\\cdot ⟨-4,1,-3⟩=-16$, find the shortest distance from $P(-3,7,3)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,3,5⟩-⟨-3,7,3⟩ \\\\  & =⟨4,-4,2⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-4,1,-3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-4)+(-4)\\cdot 1+2\\cdot (-3)|}{\\sqrt{(-4)^{2}+{1}^{2}+(-3)^{2}}} \\\\  & =\\frac{|-16-4-6|}{\\sqrt{16+1+9}} \\\\  & =\\frac{|-26|}{\\sqrt{26}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129b0757-3ac6-5753-b6e3-478a8023eb52" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260037} {:answer/id #uuid "4de222b6-19ed-5d3c-a87c-f1b937df4849" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260536} {:answer/id #uuid "65ac176a-0b06-5588-9781-22d9e0435725" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260758} {:answer/id #uuid "816e3b5d-f9fa-5bd9-b29d-3f7e216e3a23" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261004} {:answer/id #uuid "df122527-7c53-5616-83fd-4d0c7dd7847e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261846}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260536} :answer-field/id #uuid "ffc75d90-c023-5fb9-a940-576505f511c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262570}] :question/id #uuid "0498861d-e4e1-5581-aee5-353d6a78f4f9" :question/math-academy-id "q-129102" :question/problem "Given that $Q(4,-2,8)$ lies on the plane $Π:r\\cdot ⟨-3,6,2⟩=-8$, find the shortest distance from $P(3,-4,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-2,8⟩-⟨3,-4,2⟩ \\\\  & =⟨1,2,6⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-3,6,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot (-3)+2\\cdot 6+6\\cdot 2|}{\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}}} \\\\  & =\\frac{|-3+12+12|}{\\sqrt{9+36+4}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8f6350-fb69-5a5b-bb29-e322e7c392a1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260261} {:answer/id #uuid "5f24cf3d-cea3-54d1-9eda-cbee7058c868" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260695} {:answer/id #uuid "78b2e517-ef5a-50b6-a3c1-b0a7028cba72" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260933} {:answer/id #uuid "964b77d2-f08c-5b17-8d73-500caab4ed24" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261176} {:answer/id #uuid "baf43eb1-d821-5887-8947-2e31570cd345" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261518}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260695} :answer-field/id #uuid "bdb5524e-d28d-538f-a91e-26dfa96b9bfb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262469}] :question/id #uuid "6c91ce04-7e86-5b0f-8e36-5b36844cedf2" :question/math-academy-id "q-129103" :question/problem "Given that $Q(3,-4,5)$ lies on the plane $Π:r\\cdot ⟨-2,4,-4⟩=-42$, find the shortest distance from $P(1,-5,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-4,5⟩-⟨1,-5,2⟩ \\\\  & =⟨2,1,3⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-2,4,-4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+1\\cdot 4+3\\cdot (-4)|}{\\sqrt{(-2)^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-4+4-12|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-12|}{\\sqrt{36}} \\\\  & =\\frac{12}{6} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e9e69ab-b00a-5f83-86a8-b4708dff104a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260136} {:answer/id #uuid "253b574b-5f0b-579f-93ef-65a2ff360ea4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260198} {:answer/id #uuid "4a93d3f3-1c72-5baf-8f80-e4e2091cc5c5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260516} {:answer/id #uuid "ba31d7f4-c8e0-58a1-8d13-abb4b39225bd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261509} {:answer/id #uuid "e34fe396-22d3-55fc-ad47-2c6af61b5bb3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261872}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261509} :answer-field/id #uuid "ae129e17-84fe-5fe6-a754-7cfbb90c8057" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262436}] :question/id #uuid "70fdcc6d-7515-5a08-8576-979fc8c2e25e" :question/math-academy-id "q-129119" :question/problem "Given that $Q(1,-3,7)$ lies on the plane $Π:r\\cdot ⟨6,3,-2⟩=-17$, find the shortest distance from $P(2,-6,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-3,7⟩-⟨2,-6,2⟩ \\\\  & =⟨-1,3,5⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨6,3,-2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 6+3\\cdot 3+5\\cdot (-2)|}{\\sqrt{{6}^{2}+{3}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-6+9-10|}{\\sqrt{36+9+4}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1bf0d7-f3ab-56da-9f69-e8fe7acdca78" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260643} {:answer/id #uuid "7aa2f25e-eac8-573f-a22c-70c7051fc5ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260945} {:answer/id #uuid "9e90c74b-9340-5886-925a-6fd3dc9f6d08" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261250} {:answer/id #uuid "b2e32ad6-74af-5732-bdfa-a17a20a619ee" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261455} {:answer/id #uuid "fac998bb-1203-5d71-bc3a-98304a447645" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186262068}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260945} :answer-field/id #uuid "7eac6dd3-6114-5470-be8e-c3ff6f56e4f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262335}] :question/id #uuid "7213d75b-15a3-5beb-aba1-e3068433b4a9" :question/math-academy-id "q-129120" :question/problem "Given that $Q(5,-1,9)$ lies on the plane $Π:r\\cdot ⟨3,-6,-2⟩=3$, find the shortest distance from $P(7,-2,8)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨5,-1,9⟩-⟨7,-2,8⟩ \\\\  & =⟨-2,1,1⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨3,-6,-2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-2)\\cdot 3+1\\cdot (-6)+1\\cdot (-2)|}{\\sqrt{{3}^{2}+(-6)^{2}+(-2)^{2}}} \\\\  & =\\frac{|-6-6-2|}{\\sqrt{9+36+4}} \\\\  & =\\frac{|-14|}{\\sqrt{49}} \\\\  & =\\frac{14}{7} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28531488-d406-5dce-a447-86ac975abce9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186260230} {:answer/id #uuid "5890037b-7fd1-52af-9cc3-ebba115f0341" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260633} {:answer/id #uuid "7579a4aa-cdec-57a0-84a1-ee35a1819aea" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260902} {:answer/id #uuid "974eff07-8cf3-564d-836e-dc03330326bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186261189} {:answer/id #uuid "e1bf214e-db63-5eb3-a868-6f0ddd404af3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261865}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260902} :answer-field/id #uuid "fb6436c9-59ab-53b9-bc89-6b0e7a083987" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262563}] :question/id #uuid "278b0573-f883-573c-a021-fab05a65fba4" :question/math-academy-id "q-129148" :question/problem "Find the shortest distance between the point $P(5,3,7)$ and the plane $Π$ with equation $r\\cdot ⟨-2,-3,6⟩=16.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,-3,6⟩ & =16 \\\\ -2x-3y+6z & =16 \\\\ 2x & =6z-3y-16 \\\\ x & =3z-\\frac{3}{2}y-8.\\end{aligned}\n$$\n\nSetting $y=2$ and $z=1,$ we get \n\n$$\nx=3-\\frac{3}{2}(2)-8=-8.\n$$\n\nSo, the point $Q(-8,2,1)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-8,2,1⟩-⟨5,3,7⟩ \\\\  & =⟨-13,-1,-6⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-2,-3,6⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-13)\\cdot (-2)+(-1)\\cdot (-3)+(-6)\\cdot 6|}{\\sqrt{(-2)^{2}+(-3)^{2}+{6}^{2}}} \\\\  & =\\frac{|26+3-36|}{\\sqrt{4+9+36}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a111ed5-0950-5f80-a305-b88ed9c600f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186305240} {:answer/id #uuid "301af7be-9990-5644-a09f-8591c11e190d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186305606} {:answer/id #uuid "550ff825-0121-5d42-86fc-26ec2448211d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186305974} {:answer/id #uuid "7a035d66-c8ba-598a-9f31-b6f53230f100" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186306314} {:answer/id #uuid "e6cc836a-38c5-57fa-a930-c8ab2303c2c1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186307284}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186305240} :answer-field/id #uuid "0213e27b-7df0-5cad-a899-3c2f13b651db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307523}] :question/id #uuid "1df7d5a8-576c-5e6b-b09e-347611e72e67" :question/math-academy-id "q-33454" :question/problem "Find the shortest distance between the point $P(4,-2,7)$ and the plane $Π$ with equation $r\\cdot ⟨-3,2,3⟩=27.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-3,2,3⟩ & =27 \\\\ -3x+2y+3z & =27 \\\\ 3z & =27+3x-2y \\\\ z & =9+x-\\frac{2}{3}y.\\end{aligned}\n$$\n\nSetting $x=6$ and $y=3,$ we get \n\n$$\nz=9+6-\\frac{2}{3}(3)=13.\n$$\n\nSo, the point $Q(6,3,13)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,3,13⟩-⟨4,-2,7⟩ \\\\  & =⟨2,5,6⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-3,2,3⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-3)+5\\cdot 2+6\\cdot 3|}{\\sqrt{(-3)^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|-6+10+18|}{\\sqrt{9+4+9}} \\\\  & =\\frac{|22|}{\\sqrt{22}} \\\\  & =\\sqrt{22}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23c37932-b8d1-516f-abf3-f1748834a7af" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186312239} {:answer/id #uuid "3f3b0406-2681-5fe8-a9d6-e948d2f27a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{48}{11}" :db/id #edb/ref 17592186312486} {:answer/id #uuid "6b7e35c1-be2d-55da-bd15-0ac93254cb95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{11}" :db/id #edb/ref 17592186312817} {:answer/id #uuid "a1272a18-c467-54d3-9f71-ae126c7eade1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313242} {:answer/id #uuid "e1afee6d-ef0d-5bae-8b1d-2c7e13dcdbb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{26}}{13}" :db/id #edb/ref 17592186313752}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{11}" :db/id #edb/ref 17592186312817} :answer-field/id #uuid "c0d43f73-b51f-5e33-b3f5-c33dee8bb5b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314548}] :question/id #uuid "245878e4-0685-5305-b361-ba9fd660a2d5" :question/math-academy-id "q-34074" :question/problem "Given that $Q(2,4,1)$ lies on the plane $Π:r\\cdot ⟨-6,2,9⟩=5$, find the shortest distance from $P(6,-1,0)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,4,1⟩-⟨6,-1,0⟩ \\\\  & =⟨-4,5,1⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-6,2,9⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-4)\\cdot (-6)+5\\cdot 2+1\\cdot 9|}{\\sqrt{(-6)^{2}+{2}^{2}+{9}^{2}}} \\\\  & =\\frac{|24+10+9|}{\\sqrt{36+4+81}} \\\\  & =\\frac{|43|}{\\sqrt{121}} \\\\  & =\\frac{43}{11}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea53033-050f-51bc-b1f7-d809e2c747fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{5}" :db/id #edb/ref 17592186345473} {:answer/id #uuid "15e2daf7-c934-50bc-ae67-edd8a7622e14" :answer/type {:db/ident :answer.type/math} :answer/value "13\\sqrt{20}" :db/id #edb/ref 17592186345541} {:answer/id #uuid "4b334642-8d19-5d6c-b2b1-468b896c54c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{5}}{5}" :db/id #edb/ref 17592186345997} {:answer/id #uuid "a56010e2-ec46-5521-a5cd-8ec3d456b5a4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186346794} {:answer/id #uuid "c4ca087f-3cf0-544b-a843-4b5a0d5368c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186347053}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{5}}{5}" :db/id #edb/ref 17592186345997} :answer-field/id #uuid "9ea9fa5e-7580-5121-9429-ea3965fd0aec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347881}] :question/id #uuid "799391e6-f2b4-56d4-b2e4-fcfb4ba4b2c4" :question/math-academy-id "q-80049" :question/problem "Given that $Q(1,3,4)$ lies on the plane $Π:r\\cdot ⟨-4,2,0⟩=2$, find the shortest distance from $P(5,-2,3)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,3,4⟩-⟨5,-2,3⟩ \\\\  & =⟨-4,5,1⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-4,2,0⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-4)\\cdot (-4)+5\\cdot 2+1\\cdot 0|}{\\sqrt{(-4)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{|16+10+0|}{\\sqrt{16+4+0}} \\\\  & =\\frac{|26|}{\\sqrt{20}} \\\\  & =\\frac{13\\sqrt{5}}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "529cadbf-44d1-50b2-8c20-a9e272e22eec" :answer/type {:db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186346057} {:answer/id #uuid "5889a9dd-d93f-5d3e-9d82-5347ba316df9" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{5}" :db/id #edb/ref 17592186346111} {:answer/id #uuid "88fb52ad-2071-5801-963f-3a749de660f6" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186346540} {:answer/id #uuid "967e30a0-e60c-522f-a7eb-07ded0736475" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186346667} {:answer/id #uuid "f5938001-9365-567e-a131-44fd2b8da5e5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186347526}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{5}" :db/id #edb/ref 17592186346111} :answer-field/id #uuid "4d59c58c-d76d-581e-8244-df4e793dba6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347735}] :question/id #uuid "d51e9464-bbda-5ef7-95c6-2040c203954f" :question/math-academy-id "q-80115" :question/problem "Find the shortest distance between the point $P(-2,11,1)$ and the plane $Π$ with equation $r\\cdot ⟨2,-5,4⟩=20.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨2,-5,4⟩ & =20 \\\\ 2x-5y+4z & =20 \\\\ 4z & =20-2x+5y \\\\ z & =5-\\frac{1}{2}x+\\frac{5}{4}y.\\end{aligned}\n$$\n\nSetting $x=2$ and $y=4,$ we get \n\n$$\nz=5-\\frac{1}{2}(2)+\\frac{5}{4}(4)=9.\n$$\n\nSo, the point $Q(2,4,9)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,4,9⟩-⟨-2,11,1⟩ \\\\  & =⟨4,-7,8⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨2,-5,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(4)\\cdot 2+(-7)\\cdot (-5)+8\\cdot 4|}{\\sqrt{{2}^{2}+(-5)^{2}+{4}^{2}}} \\\\  & =\\frac{|8+35+32|}{\\sqrt{4+25+16}} \\\\  & =\\frac{|75|}{\\sqrt{45}} \\\\  & =5\\sqrt{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27496ca3-7fad-5a26-b5da-f602f9ca180b" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186345703} {:answer/id #uuid "5f6421f7-33b1-5c65-8910-c35b1c7a0bda" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186346173} {:answer/id #uuid "7dfaae5e-dea8-5bfb-9c02-5fac3d7fa85d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{109}" :db/id #edb/ref 17592186346455} {:answer/id #uuid "91d47231-c5cc-56c3-bf8e-35af3b2e786f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346627} {:answer/id #uuid "aae3eb0c-955f-52e9-abf1-f02ce3d8e415" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186346844}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{109}" :db/id #edb/ref 17592186346455} :answer-field/id #uuid "022c53e2-a752-5b98-a9ef-cff9a3af128a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347611}] :question/id #uuid "b6801290-8008-514c-8914-c43c32373fba" :question/math-academy-id "q-80116" :question/problem "Find the shortest distance between the point $P(8,-6,5)$ and the plane $Π$ with equation $r\\cdot ⟨-8,6,3⟩=24.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-8,6,3⟩ & =24 \\\\ -8x+6y+3z & =24 \\\\ 3z & =24+8x-6y \\\\ z & =8+\\frac{8}{3}x-2y.\\end{aligned}\n$$\n\nSetting $x=3$ and $y=1,$ we get \n\n$$\nz=8+\\frac{8}{3}(3)-2(1)=14.\n$$\n\nSo, the point $Q(3,1,14)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,1,14⟩-⟨8,-6,5⟩ \\\\  & =⟨-5,7,9⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-8,6,3⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-5)\\cdot (-8)+7\\cdot 6+9\\cdot 3|}{\\sqrt{(-8)^{2}+{6}^{2}+{3}^{2}}} \\\\  & =\\frac{|40+42+27|}{\\sqrt{64+36+9}} \\\\  & =\\frac{|109|}{\\sqrt{109}} \\\\  & =\\sqrt{109}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59951a54-81a6-5810-af8e-c4fdad49ec94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{7}" :db/id #edb/ref 17592186365885} {:answer/id #uuid "a90ec159-7db0-5edb-89ff-ff9b5943472c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186365886} {:answer/id #uuid "fb5bdcd7-37da-5f22-aead-d95e3ecf08f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{61}" :db/id #edb/ref 17592186365887} {:answer/id #uuid "c4c49b79-c479-5e32-8877-9be777b5b8ea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186365888} {:answer/id #uuid "1dacb56b-d8ef-5624-9327-cee1233132b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{7}" :db/id #edb/ref 17592186365889}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{7}" :db/id #edb/ref 17592186365885} :answer-field/id #uuid "d7ca0aa0-a220-5bdc-b0d2-65b3a735f48d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365884}] :question/id #uuid "7a0536ad-4890-5a1a-ae11-f816e5c8b4de" :question/math-academy-id "q-34073" :question/problem "Given that $Q(0,5,2)$ lies on the plane $Π:r\\cdot ⟨-6,2,3⟩=16$, find the shortest distance from $P(1,-4,5)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨0,5,2⟩-⟨1,-4,5⟩ \\\\  & =⟨-1,9,-3⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot (-6)+9\\cdot 2+(-3)\\cdot 3|}{\\sqrt{(-6)^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|6+18-9|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|15|}{\\sqrt{49}} \\\\  & =\\frac{15}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbe24cf-fd8c-5f01-815b-71665908e829" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186366353} {:answer/id #uuid "864ae216-298f-5e6d-99b0-5743a693bda7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186366354} {:answer/id #uuid "d4a49331-9463-54aa-b366-f0c946484cc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{29}" :db/id #edb/ref 17592186366355} {:answer/id #uuid "59380b81-7c36-5c7e-97a6-e6c52c1c309b" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186366356} {:answer/id #uuid "45119e6d-8467-53d2-8d4f-1dff9a2160d4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186366357}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186366353} :answer-field/id #uuid "030f319e-0c23-5f25-ab63-9b411cec6724" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366352}] :question/id #uuid "92e09859-2a3a-5255-8ffb-72547639c5f4" :question/math-academy-id "q-80113" :question/problem "Find the shortest distance between the point $P(-3,-4,-8)$ and the plane $Π$ with equation $r\\cdot ⟨-2,4,1⟩=3.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,4,1⟩ & =3 \\\\ -2x+4y+z & =3 \\\\ z & =3+2x-4y.\\end{aligned}\n$$\n\nSetting $x=1$ and $y=1,$ we get \n\n$$\nz=3+2(1)-4(1)=1.\n$$\n\nSo, the point $Q(1,1,1)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,1⟩-⟨-3,-4,-8⟩ \\\\  & =⟨4,5,9⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-2,4,1⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-2)+5\\cdot 4+9\\cdot 1|}{\\sqrt{(-2)^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{|-8+20+9|}{\\sqrt{4+16+1}} \\\\  & =\\frac{|21|}{\\sqrt{21}} \\\\  & =\\sqrt{21}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088db5f4-36d3-5c78-98a0-f200bd4afcc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186443241} {:answer/id #uuid "168db077-1d3d-5cb0-b6aa-9a45c778361c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186443242} {:answer/id #uuid "4a2a87c7-4871-52b2-9751-1dcf545d8473" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{\\sqrt{11}}" :db/id #edb/ref 17592186443246} {:answer/id #uuid "9c4b18bd-d214-5ab3-980a-bcf8c20a44a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{11}}" :db/id #edb/ref 17592186443253} {:answer/id #uuid "a192f294-392f-523d-b854-34cf2ca91ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{11}}" :db/id #edb/ref 17592186443254}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186443241} :answer-field/id #uuid "161dc5e7-caef-534f-b118-60aceff59caf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443261}] :question/id #uuid "072e9e45-d148-5a1a-9029-08725d744a80" :question/math-academy-id "q-129126" :question/problem "Find the shortest distance between the point $P(-3,4,7)$ and the plane $Π$ with equation $r\\cdot ⟨-3,1,1⟩=9.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-3,1,1⟩ & =9 \\\\ -3x+y+z & =9 \\\\ z & =9+3x-y.\\end{aligned}\n$$\n\nSetting $x=1$ and $y=1,$ we get \n\n$$\nz=9+3(1)-(1)=11.\n$$\n\nSo, the point $Q(1,1,11)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,11⟩-⟨-3,4,7⟩ \\\\  & =⟨4,-3,4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-3,1,1⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-3)+(-3)\\cdot 1+4\\cdot 1|}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{|-12-3+4|}{\\sqrt{9+1+1}} \\\\  & =\\frac{|-11|}{\\sqrt{11}} \\\\  & =\\frac{11}{\\sqrt{11}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b8c44f-f4d9-57d8-90d2-99d7decf9188" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186443244} {:answer/id #uuid "8c1d2c94-d43d-5c24-a663-9d1fbcba711f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186443252} {:answer/id #uuid "acf35f72-276b-5ae6-8734-c3d72972ffea" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443256} {:answer/id #uuid "d7d5ba1e-9709-5d81-81a8-a2db338b2a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186443257} {:answer/id #uuid "e134b035-3648-5a34-a02a-44af5b1b5f73" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186443259}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443256} :answer-field/id #uuid "3647b522-cc39-5b80-86fd-13996ce4e48f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443263}] :question/id #uuid "ee5f2c99-4524-5cc2-872a-3bdd6d04d82a" :question/math-academy-id "q-129142" :question/problem "Find the shortest distance between the point $P(-3,2,6)$ and the plane $Π$ with equation $r\\cdot ⟨-2,4,4⟩=8.$" :question/worked-solution "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,4,4⟩ & =8 \\\\ -2x+4y+4z & =8 \\\\ 4z & =8+2x-4y \\\\ z & =2+\\frac{x}{2}-y.\\end{aligned}\n$$\n\nSetting $x=2$ and $y=1,$ we get \n\n$$\nz=2+\\frac{2}{2}-1=2.\n$$\n\nSo, the point $Q(2,1,2)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,1,2⟩-⟨-3,2,6⟩ \\\\  & =⟨5,-1,-4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-2,4,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|5\\cdot (-2)+(-1)\\cdot 4+(-4)\\cdot 4|}{\\sqrt{(-2)^{2}+{4}^{2}+{4}^{2}}} \\\\  & =\\frac{|-10-4-16|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-30|}{\\sqrt{36}} \\\\  & =\\frac{30}{6} \\\\  & =5.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Simplified Dot Product Form"} {:db/id #edb/ref 17592186119841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119655 :question/id #uuid "1538dde4-ab62-502e-8efe-7f37628ab861" :question/math-academy-id "e-4951" :question/problem "Find the shortest distance between the point $P(3 , -10 , 3)$ and the plane $\\Pi$ with equation $2x+y-2z = -1$." :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=4$ and $y=-5$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}2x+y-2z & =-1 \\\\ 2(4)+(-5)+1 & =2z \\\\ 4 & =2z \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(4, -5, 2)$ which lies on the plane.\n\nComputing $\\overrightarrow{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-5,2⟩-⟨3,-10,3⟩ \\\\  & =⟨1,5,-1⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $\\mathbf{n}=\\langle a,b,c \\rangle.$ So, for the plane $\\Pi,$ we have $\\mathbf{n}= \\langle 2, 1, -2 \\rangle.$ \n\nFinally, the shortest distance from the point $P$ to the plane $\\Pi$ is the absolute value of the scalar projection of $\\overrightarrow{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot 2+5\\cdot 1+(-1)\\cdot (-2)|}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|2+5+2|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|\\,9\\,|}{\\sqrt{9}} \\\\  & =3\\end{aligned}\n$$"} :knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f" :knowledge-point/questions [{:db/id #edb/ref 17592186120250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5c914f4-5a8b-548c-a5c2-f94ad127ef12" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186117660} {:answer/id #uuid "e142cff3-c8cc-592a-ad56-bb1b8e198189" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{62}" :db/id #edb/ref 17592186117661} {:answer/id #uuid "00eddfed-b6f0-56e7-ae4c-5028b970d7c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186117662} {:answer/id #uuid "2d32c0ff-487f-539b-9acc-2fcc848f4231" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186117663} {:answer/id #uuid "6601c7bc-b43b-5770-bdcb-2d6468033d70" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186117664}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186117662} :answer-field/id #uuid "20e14158-31b8-583a-aedb-9f5f098f4e19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117659}] :question/id #uuid "6cd2b067-45df-537d-b860-ed07175f92e4" :question/math-academy-id "q-33464" :question/problem "Find the shortest distance between the point $P(5,9,-6)$ and the plane $Π$ with equation $3x+2y+7z=-9.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}3x+2y+7z & =-9 \\\\ 3(2)+2(3)+7z & =-9 \\\\ 7z & =-21 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,3,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,3,-3⟩-⟨5,9,-6⟩ \\\\  & =⟨-3,-6,3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨3,2,7⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-3)\\cdot 3+(-6)\\cdot 2+3\\cdot 7|}{\\sqrt{{3}^{2}+{2}^{2}+{7}^{2}}} \\\\  & =\\frac{|-9-12+21|}{\\sqrt{9+4+49}} \\\\  & =\\frac{|\\,0\\,|}{\\sqrt{62}} \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the point $P$ lies on the plane."} {:db/id #edb/ref 17592186120296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55775c02-c60f-569e-bc95-5290800d3038" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186312659} {:answer/id #uuid "a208a751-a86c-5b93-a702-b2f121f6a671" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186313249} {:answer/id #uuid "a419b65a-1f3a-547e-8fa4-cd3386d179fe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313266} {:answer/id #uuid "b6687ee1-7981-520e-9e30-94e3e3628cb2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313391} {:answer/id #uuid "eb1eade4-c177-5981-9660-8aff7e8e4233" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186313846}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186313249} :answer-field/id #uuid "1a1fd7d5-9460-5431-adaa-421a37cdd1df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314078}] :question/id #uuid "9801fd4f-bb71-566c-b00a-260ab88af6a7" :question/math-academy-id "q-34070" :question/problem "Find the shortest distance between the point $P(2,1,3)$ and the plane $Π$ with equation $3x-6y-6z=-15.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=-1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}3x-6y-6z & =-15 \\\\ 3(1)-6(-1)-6z & =-15 \\\\ -6z & =-24 \\\\ z & =4.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,-1,4)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-1,4⟩-⟨2,1,3⟩ \\\\  & =⟨-1,-2,1⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨3,-6,-6⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 3+(-2)\\cdot (-6)+1\\cdot (-6)|}{\\sqrt{{3}^{2}+(-6)^{2}+(-6)^{2}}} \\\\  & =\\frac{|-3+12-6|}{\\sqrt{9+36+36}} \\\\  & =\\frac{3}{\\sqrt{81}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396b6e30-20dc-505a-a011-b9a1c89898fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186260387} {:answer/id #uuid "a3012ac3-d9a2-5ff4-a1ed-0eb949759b36" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261297} {:answer/id #uuid "c2b0aa32-5925-507f-9087-7ad6312dd4d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{30}{7}" :db/id #edb/ref 17592186261593} {:answer/id #uuid "cddd5a3e-4436-57c5-884b-22c96aa491db" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261693} {:answer/id #uuid "ddeb2cc5-b0c3-5e7a-a0e2-5c557307f90f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261837}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261297} :answer-field/id #uuid "d5c4d58e-7136-568a-902e-1affdf5888ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262494}] :question/id #uuid "04f29aba-0bc5-533b-80be-91fd747ce6a1" :question/math-academy-id "q-129158" :question/problem "Find the shortest distance between the point $P(-1,3,-4)$ and the plane $Π$ with equation $6x+2y+3z=9.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}6x+2y+3z & =9 \\\\ 6(1)+2(0)+3z & =9 \\\\ 3z & =3 \\\\ z & =1.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,0,1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,0,1⟩-⟨-1,3,-4⟩ \\\\  & =⟨2,-3,5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 6+(-3)\\cdot 2+5\\cdot 3|}{\\sqrt{{6}^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|12-6+15|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f3eb9e-4e67-5f5e-a7a5-682bc1ab0f7c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186259899} {:answer/id #uuid "0ded2d69-187b-55ff-8d7c-6cfbf2f5b7b6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260003} {:answer/id #uuid "37ea7f81-d052-5dd2-bd77-19dc348fd962" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186260370} {:answer/id #uuid "55efbace-7c46-5607-a907-7f79b4e8b6ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186260609} {:answer/id #uuid "ac05e0a5-e6c5-5e1a-ac97-30b97cadeb8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186261377}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186260370} :answer-field/id #uuid "71631a07-2cf8-5827-86b2-4a5a7f754b9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262312}] :question/id #uuid "5fbee153-7d57-5b46-a041-8dc669ad88e8" :question/math-academy-id "q-129160" :question/problem "Find the shortest distance between the point $P(-2,1,5)$ and the plane $Π$ with equation $-2x+4y+4z=18.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x+4y+4z & =18 \\\\ -2(-1)+4(2)+4z & =18 \\\\ 4z & =8 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,2,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,2,2⟩-⟨-2,1,5⟩ \\\\  & =⟨1,1,-3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,4,4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot (-2)+1\\cdot 4+(-3)\\cdot 4|}{\\sqrt{(-2)^{2}+{4}^{2}+{4}^{2}}} \\\\  & =\\frac{|-2+4-12|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-10|}{\\sqrt{36}} \\\\  & =\\frac{10}{6} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c4eecf-296e-5516-b53c-79b78ea2b9ca" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260727} {:answer/id #uuid "db5f3fd7-fa3c-5df3-959c-4c7dfb2a5bea" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186261814} {:answer/id #uuid "f2d44888-330f-5d97-813d-d06228ec63cc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261997} {:answer/id #uuid "f962b70f-c02d-55ba-a6e4-84a85c82d4e0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186262053} {:answer/id #uuid "fa9efcc2-19b9-54f0-bfe5-a15e71fd1354" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186262066}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186262053} :answer-field/id #uuid "b38b182d-b8bf-588a-b715-8c9ecc4e2585" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262449}] :question/id #uuid "091a2bf6-b258-57c8-a9fa-cfb6d9f29751" :question/math-academy-id "q-129161" :question/problem "Find the shortest distance between the point $P(-7,2,3)$ and the plane $Π$ with equation $4x+2y-4z=18.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}4x+2y-4z & =18 \\\\ 4(2)+2(1)-4z & =18 \\\\ -4z & =8 \\\\ z & =-2.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,1,-2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,1,-2⟩-⟨-7,2,3⟩ \\\\  & =⟨9,-1,-5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨4,2,-4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|9\\cdot 4+(-1)\\cdot 2+(-5)\\cdot (-4)|}{\\sqrt{{4}^{2}+{2}^{2}+(-4)^{2}}} \\\\  & =\\frac{|36-2+20|}{\\sqrt{16+4+16}} \\\\  & =\\frac{|54|}{\\sqrt{36}} \\\\  & =\\frac{54}{6} \\\\  & =9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98b0f40d-33e9-55be-8f3b-7f8eedd896c4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261199} {:answer/id #uuid "bfb12be0-0f55-5f3e-88c4-ed8956e836d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{6}" :db/id #edb/ref 17592186261569} {:answer/id #uuid "d3b6f646-82da-5b62-aee6-709895af763d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261739} {:answer/id #uuid "f57cbc53-9eea-50bd-9941-2fb64d7aac6a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186262021} {:answer/id #uuid "f5d686d0-5802-573c-8388-4963787721a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186262026}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261199} :answer-field/id #uuid "9fa62847-d308-543b-baa2-afe755afbc10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262411}] :question/id #uuid "875980ed-8584-5326-b58b-3349b4a511e1" :question/math-academy-id "q-129163" :question/problem "Find the shortest distance between the point $P(-2,5,-3)$ and the plane $Π$ with equation $4x-4y+2z=2.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}4x-4y+2z & =2 \\\\ 4(1)-4(1)+2z & =2 \\\\ 2z & =2 \\\\ z & =1.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,1,1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,1⟩-⟨-2,5,-3⟩ \\\\  & =⟨3,-4,4⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨4,-4,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot 4+(-4)\\cdot (-4)+4\\cdot 2|}{\\sqrt{{4}^{2}+(-4)^{2}+{2}^{2}}} \\\\  & =\\frac{|12+16+8|}{\\sqrt{16+16+4}} \\\\  & =\\frac{|36|}{\\sqrt{36}} \\\\  & =\\frac{36}{6} \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c91748b-039e-5eb9-a37e-a538a11b547b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186259994} {:answer/id #uuid "5e9b3c3c-b4f8-526a-9901-0c30d02dc50b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186260689} {:answer/id #uuid "ad8f1a7d-4a09-5032-a136-33ad7657156e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261398} {:answer/id #uuid "e02b39e4-a270-5bce-b071-29e9f45c2040" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186261855} {:answer/id #uuid "e9ac539e-67e6-579d-a5b0-ddb5f34a0f13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186261922}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186261855} :answer-field/id #uuid "d63e23f4-baa1-51c3-b321-bbcaaaa933a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262496}] :question/id #uuid "358dc254-c65c-55e3-933d-25bd9221af6b" :question/math-academy-id "q-129165" :question/problem "Find the shortest distance between the point $P(-1,4,-5)$ and the plane $Π$ with equation $-2x+2y+z=6.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x+2y+z & =6 \\\\ -2(1)+2(1)+z & =6 \\\\ z & =6.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,1,6)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,6⟩-⟨-1,4,-5⟩ \\\\  & =⟨2,-3,11⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,2,1⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+(-3)\\cdot 2+11\\cdot 1|}{\\sqrt{(-2)^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{|-4-6+11|}{\\sqrt{4+4+1}} \\\\  & =\\frac{|1|}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b72bdaf-c17d-5a6f-a26c-13328e45c2b8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260407} {:answer/id #uuid "63966b3b-7d0f-548b-957a-4189afb5ebfe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260734} {:answer/id #uuid "654695db-ae2f-5c0a-8492-ff72aa97f271" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186260751} {:answer/id #uuid "ae41e977-6f41-536e-a881-63dadca54693" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186261412} {:answer/id #uuid "f0ec70a3-7571-53d4-a32a-f4786362a4c3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261986}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260734} :answer-field/id #uuid "bc0d9b85-acc6-5956-920a-859f666ff369" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262466}] :question/id #uuid "8fc468d7-8c5a-51cb-a422-a6e8deebdd30" :question/math-academy-id "q-129166" :question/problem "Find the shortest distance between the point $P(-2,3,-6)$ and the plane $Π$ with equation $-x+2y+2z=8.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-2$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-x+2y+2z & =8 \\\\ -1(-2)+2(1)+2z & =8 \\\\ 2z & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-2,1,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-2,1,2⟩-⟨-2,3,-6⟩ \\\\  & =⟨0,-2,8⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-1,2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|0\\cdot (-1)+(-2)\\cdot 2+8\\cdot 2|}{\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{|0-4+16|}{\\sqrt{1+4+4}} \\\\  & =\\frac{|12|}{\\sqrt{9}} \\\\  & =\\frac{12}{3} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a498397-bc50-529e-8e10-47f12cf12780" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186345849} {:answer/id #uuid "4d4f5078-9c9c-5434-884d-abeff808219e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186346014} {:answer/id #uuid "516edaf6-39a8-55dd-90e0-7aaeeb8c35e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186346050} {:answer/id #uuid "ad405862-61ea-5124-a0de-62ed44cbd68c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346862} {:answer/id #uuid "effbbbd2-a34b-5da0-b614-911f26ef50bf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347467}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186346014} :answer-field/id #uuid "0dfbae8b-192e-5dbd-a7da-8c84cfb07a0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347633}] :question/id #uuid "ee857b14-a370-505a-a029-ad7460463ae5" :question/math-academy-id "q-80117" :question/problem "Find the shortest distance between the point $P(5,4,-4)$ and the plane $Π$ with equation $6x-3y+6z=-18.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}6x-3y+6z & =-18 \\\\ 6(1)-3(2)+6z & =-18 \\\\ 6z & =-18 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,2,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,2,-3⟩-⟨5,4,-4⟩ \\\\  & =⟨-4,-2,1⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨6,-3,6⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-4)\\cdot 6+(-2)\\cdot (-3)+1\\cdot 6|}{\\sqrt{{6}^{2}+(-3)^{2}+{6}^{2}}} \\\\  & =\\frac{|-24+6+6|}{\\sqrt{36+9+36}} \\\\  & =\\frac{|\\,-12\\,|}{\\sqrt{81}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae5898c-91fd-500e-a18d-9a613793916b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186345586} {:answer/id #uuid "3bf469ee-bfa5-54ad-9ee7-3e8686851ee9" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186345859} {:answer/id #uuid "547fec09-9ac4-53fe-bc5f-235373563b18" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346067} {:answer/id #uuid "55089e0f-7f2d-5f0a-af43-9bef0b0757bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186346071} {:answer/id #uuid "75641616-9478-59af-a091-d9b5df69b71f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186346385}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186346071} :answer-field/id #uuid "05a0dcf4-c48c-52c6-ad65-ce1c700d5ba5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347620}] :question/id #uuid "13132844-a558-54b3-bea9-4e5aeb81c059" :question/math-academy-id "q-80118" :question/problem "Find the shortest distance between the point $P(-7,5,2)$ and the plane $Π$ with equation $4x-8y+8z=-36.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}4x-8y+8z & =-36 \\\\ 4(-1)-8(1)+8z & =-36 \\\\ 8z & =-24 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,1,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,1,-3⟩-⟨-7,5,2⟩ \\\\  & =⟨6,-4,-5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨4,-8,8⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|6\\cdot 4+(-4)\\cdot (-8)+(-5)\\cdot 8|}{\\sqrt{{4}^{2}+(-8)^{2}+{8}^{2}}} \\\\  & =\\frac{|24+32-40|}{\\sqrt{16+64+64}} \\\\  & =\\frac{|\\,16\\,|}{\\sqrt{144}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e17bee3-8a02-51a0-902b-648ddcb92270" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186345614} {:answer/id #uuid "6464bcc1-d16d-5cb0-a80f-f6367b03555a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346224} {:answer/id #uuid "6ca6c6af-8e29-55f9-9c01-13b97f9802f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186346296} {:answer/id #uuid "8110d4bd-ba4c-530a-83b0-df26d06e6b9b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186346479} {:answer/id #uuid "e672771e-7214-548d-ad07-ca6303728298" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186347383}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346224} :answer-field/id #uuid "71cb2ec2-928a-58ef-9a9b-a21accd24865" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347808}] :question/id #uuid "8ca7603f-8115-5820-93e3-75e60fbf70c9" :question/math-academy-id "q-80119" :question/problem "Find the shortest distance between the point $P(6,6,2)$ and the plane $Π$ with equation $4x-7y-4z=-26.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}4x-7y-4z & =-26 \\\\ 4(1)-7(2)-4z & =-26 \\\\ -4z & =-16 \\\\ z & =4.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,2,4)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,2,4⟩-⟨6,6,2⟩ \\\\  & =⟨-5,-4,2⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨4,-7,-4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-5)\\cdot 4+(-4)\\cdot (-7)+2\\cdot (-4)|}{\\sqrt{{4}^{2}+(-7)^{2}+(-4)^{2}}} \\\\  & =\\frac{|-20+28-8|}{\\sqrt{16+49+16}} \\\\  & =\\frac{|\\,0\\,|}{\\sqrt{81}} \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the point $P$ lies on the plane."} {:db/id #edb/ref 17592186348336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f6631c-af7b-53a2-83af-ac437e78d90b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186345363} {:answer/id #uuid "619b3823-d10c-5f60-8462-b61b0c00f5f5" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186346199} {:answer/id #uuid "6b2d9bb2-2fd3-5983-804f-4a5cd3d99900" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186346278} {:answer/id #uuid "8ddb3ea6-0413-5720-b61a-ab23c633ab83" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186346583} {:answer/id #uuid "eeb2fcdd-6bc9-502b-bf63-760bd1212667" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186347459}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186345363} :answer-field/id #uuid "9873e119-5653-5fff-9565-620b8e2698f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347873}] :question/id #uuid "32d1647f-476a-5352-bcda-228c154bf2db" :question/math-academy-id "q-80120" :question/problem "Find the shortest distance between the point $P(-11,-8,-4)$ and the plane $Π$ with equation $14x+8y-8z=-6.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=-2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}14x+8y-8z & =-6 \\\\ 14(-1)+8(-2)-8z & =-6 \\\\ -8z & =24 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,-2,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,-2,-3⟩-⟨-11,-8,-4⟩ \\\\  & =⟨10,6,1⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨14,8,-8⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot 14+6\\cdot 8+1\\cdot (-8)|}{\\sqrt{(14)^{2}+{8}^{2}+(-8)^{2}}} \\\\  & =\\frac{|140+48-8|}{\\sqrt{196+64+64}} \\\\  & =\\frac{|\\,180\\,|}{\\sqrt{324}} \\\\  & =10\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10263ca4-b8bb-5a2d-9cb0-a6cb6798e4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186345488} {:answer/id #uuid "3fee28ed-fd4e-5e57-aea2-936eead49d24" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186345901} {:answer/id #uuid "41336bd9-815f-549b-befc-b646e89179a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186345907} {:answer/id #uuid "b507ac70-f33c-5dda-9141-f543ced2a2ce" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186346928} {:answer/id #uuid "f7c2d75f-e4ec-55e7-b876-ff7f73776f7c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347546}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347546} :answer-field/id #uuid "81c6cb45-6adc-5f19-b537-ff2e27ce7534" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347834}] :question/id #uuid "0953b145-a938-579d-a5dc-6946f5364a06" :question/math-academy-id "q-80122" :question/problem "Find the shortest distance between the point $P(-1,11,10)$ and the plane $Π$ with equation $-2x-4y+4z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x-4y+4z & =16 \\\\ -2(2)-4(3)+4z & =16 \\\\ 4z & =32 \\\\ z & =8.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,3,8)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,3,8⟩-⟨-1,11,10⟩ \\\\  & =⟨3,-8,-2⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,-4,4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot (-2)+(-8)\\cdot (-4)+(-2)\\cdot 4|}{\\sqrt{(-2)^{2}+(-4)^{2}+{4}^{2}}} \\\\  & =\\frac{|-6+32-8|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|\\,18\\,|}{\\sqrt{36}} \\\\  & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176d1602-8bf5-5374-a9e6-a11eb56ac6e7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186345558} {:answer/id #uuid "83e40ffd-82c5-58c3-8195-51839d2315b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186346497} {:answer/id #uuid "ad8eab09-cf42-5d1f-8fb8-df0aa5204ee7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186346865} {:answer/id #uuid "b94ca2ef-7b7e-5956-9d9f-d401dbbd3af3" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186346961} {:answer/id #uuid "d59bd84a-2cfd-5ffe-8072-125a2f3ba837" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186347230}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186346497} :answer-field/id #uuid "736791d0-361f-54ac-a1c5-a82daca0b4af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347811}] :question/id #uuid "972f430d-f05f-5657-9e37-d9ee4828f532" :question/math-academy-id "q-80123" :question/problem "Find the shortest distance between the point $P(-4,-1,5)$ and the plane $Π$ with equation $-4x-2y+2z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-4x-2y+2z & =16 \\\\ -4(-1)-2(2)+2z & =16 \\\\ 2z & =16 \\\\ z & =8.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,2,8)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,2,8⟩-⟨-4,-1,5⟩ \\\\  & =⟨3,3,3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-4,-2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot (-4)+3\\cdot (-2)+3\\cdot 2|}{\\sqrt{(-4)^{2}+(-2)^{2}+{2}^{2}}} \\\\  & =\\frac{|-12-6+6|}{\\sqrt{16+4+4}} \\\\  & =\\frac{|\\,-12\\,|}{\\sqrt{24}} \\\\  & =\\sqrt{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d85d58b-d2c6-50e6-b647-b9ac50af4bb1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186443243} {:answer/id #uuid "5ad1e3d5-d1ee-5ca4-bb25-a289369682c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186443247} {:answer/id #uuid "66952a23-b25c-549f-a606-5d6dda11f34c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186443250} {:answer/id #uuid "75964f2d-1d14-5218-b72a-c985ff68e537" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186443251} {:answer/id #uuid "a40f70a0-ef1e-59d6-9c75-8bb1b576296f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443255}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443255} :answer-field/id #uuid "4a75b517-d88b-5fde-8c47-3acf225f13a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443264}] :question/id #uuid "152abe46-196c-57ed-801a-b01b3b6e9019" :question/math-academy-id "q-34033" :question/problem "Find the shortest distance between the point $P(-1,0,2)$ and the plane $Π$ with equation $2x-y+2z=-1.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}2x-y+2z & =-1 \\\\ 2(2)-(3)+2z & =-1 \\\\ 2z & =-2 \\\\ z & =-1.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,3,-1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,3,-1⟩-⟨-1,0,2⟩ \\\\  & =⟨3,3,-3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨2,-1,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot 2+3\\cdot (-1)+(-3)\\cdot 2|}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{|6-3-6|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|\\,-3\\,|}{\\sqrt{9}} \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186476957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1b5af0-a05c-505e-b5bf-10afc44fa4fd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186476267} {:answer/id #uuid "3016c831-e8f4-5651-b74c-6377c71dd95f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186476309} {:answer/id #uuid "4275d3b1-6448-558a-b4a5-a4d62b2ac4d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186476347} {:answer/id #uuid "cebc6772-d1ae-5b50-bd1a-7a34f67a24f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186476663} {:answer/id #uuid "dc5a4b5d-4377-54c9-bfe2-c832ba673c98" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186476700}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186476700} :answer-field/id #uuid "adece7a5-0744-52d2-a422-6e0bf364c79d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476833}] :question/id #uuid "bf386a8a-8501-5e3e-a330-283d65ae0e3a" :question/math-academy-id "q-129154" :question/problem "Find the shortest distance between the point $P(5,3,7)$ and the plane $Π$ with equation $-2x-3y+6z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-2$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x-3y+6z & =16 \\\\ -2(-2)-3(0)+6z & =16 \\\\ 6z & =12 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-2,0,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-2,0,2⟩-⟨5,3,7⟩ \\\\  & =⟨-7,-3,-5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,-3,6⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-7)\\cdot (-2)+(-3)\\cdot (-3)+(-5)\\cdot 6|}{\\sqrt{(-2)^{2}+(-3)^{2}+(6)^{2}}} \\\\  & =\\frac{|14+9-30|}{\\sqrt{4+9+36}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554564 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e48c6e1-979b-5319-ab3b-cf3af3e4ddf7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186553981} {:answer/id #uuid "4738641c-2dc2-53da-9d9a-b5f351c18c04" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186554002} {:answer/id #uuid "6020578e-6c29-5a90-8cfa-60aa1062193f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186554056} {:answer/id #uuid "71da091c-aca1-5ad0-8e35-00a66ee352db" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186554100} {:answer/id #uuid "d2870e0f-6294-5f82-8056-6334f7ab8f37" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186554326}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186554002} :answer-field/id #uuid "b4a98275-e739-51cc-8112-6d634db0f987" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554502}] :question/id #uuid "39c46748-4786-53ad-a218-6f5fdd2db8c5" :question/math-academy-id "q-33453" :question/problem "Find the shortest distance between the point $P(-2,-8,-1)$ and the plane $Π$ with equation $2x+y-2z=-7.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=-3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}2x+y-2z & =-7 \\\\ 2(1)+(-3)+7 & =2z \\\\ 6 & =2z \\\\ z & =3.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,-3,3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-3,3⟩-⟨-2,-8,-1⟩ \\\\  & =⟨3,5,4⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨2,1,-2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot 2+5\\cdot 1+4\\cdot (-2)|}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|6+5-8|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|\\,3\\,|}{\\sqrt{9}} \\\\  & =1\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Cartesian Form"}] :topic/math-academy-id 1810 :topic/title "The Shortest Distance Between a Plane and a Point"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186093066} :activity/id #uuid "cce30c41-c69f-5ef9-a4d5-de8a2295f09d" :activity/steps [{:db/id #edb/ref 17592186093066 :step/content {:db/id #edb/ref 17592186093437 :tutorial/content "Consider the shaded region $D$ shown below.\n\n![](images/ca/cae19e62492782b42b69675ec0babd005407c7db8ce4dc6d77a14da06beedfc1.png)\n\nHow can we calculate the area of the image of $D$ under the action of the linear transformation $\\mathbf{T}$ that is given by its standard matrix $$T=\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}?$$\n\nFor any linear transformation $\\mathbf{T},$ we have the following connection between the area of $D$ and the area of the image $\\mathbf{T}(D)$ under the action of $\\mathbf{T}\\mathbin{:}$\n\n$$\\text{Area}(\\mathbf{T}(D)) = |\\det(T)| \\cdot \\text{Area}(D)$$\n\nThis equation is important. It tells us that $|\\det(T)|$ is the **area scale factor** of the transformation.\n\nFrom the diagram, we have\n\n$$\\text{Area}(D) = 2 \\cdot 3 = 6.$$\n\nComputing the determinant of $T,$ we get\n\n$$\\det(T) = 0 \\cdot 0 - (-2) \\cdot 2 = 4.$$\n\nTherefore, $$\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\ & =|\\,4\\,|\\cdot 6 \\\\ & =24.\\end{aligned}$$" :tutorial/id #uuid "3ab20008-b37c-55e5-8c73-88497d1ff8a3" :tutorial/math-academy-id 3553 :tutorial/title "Introduction"} :step/id #uuid "de8bff1f-89ad-524a-8805-adad9cdf802d" :step/next {:db/id #edb/ref 17592186093143}} {:db/id #edb/ref 17592186093067 :step/content {:db/id #edb/ref 17592186092227 :knowledge-point/id #uuid "4d59733f-3396-5d59-98a9-3f2e0ccfbbc4"} :step/id #uuid "c3d05cf3-f638-56b6-b529-72b9f77d282b" :step/next {:db/id #edb/ref 17592186093068}} {:db/id #edb/ref 17592186093068 :step/content {:db/id #edb/ref 17592186092228 :knowledge-point/id #uuid "a51f9b53-0ce5-518f-8173-abe4d87f2851"} :step/id #uuid "89374d40-4e0f-5b2f-86e1-1eaf788a8409"} {:db/id #edb/ref 17592186093143 :step/content {:db/id #edb/ref 17592186092282 :knowledge-point/id #uuid "80a4eee7-a763-5c28-ae3c-5bce78222c87"} :step/id #uuid "237922a1-2c38-59e7-bbed-85c13909f80f" :step/next {:db/id #edb/ref 17592186093067}}] :activity/title "Area Scale Factors of Linear Transformations" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186092463}] :db/id #edb/ref 17592186049339 :topic/knowledge-points [{:db/id #edb/ref 17592186092227 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092072 :question/id #uuid "3e096041-22f8-5b7e-88d7-eca10203a379" :question/math-academy-id "e-5470" :question/problem "![](images/e8/e8ff769df4089e6ed9a47d56d7317acf41b8aef6a255abc705c0e7ec31a446ea.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $\\mathbf{T}$ with the standard matrix $T,$ given below?\n![](images/c3/c301e8b9a5cdc11007042c8a8d7bcddcfa5b1801bbf82e32c7f3ed08158440db.png)" :question/worked-solution "Recall that for any linear transformation $\\mathbf{T},$ we have the following connection between the area of $D$ and the area of the image $\\mathbf{T}(D)$ under the action of $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\text{Area}(\\mathbf{T}(D)) = |\\det(T)| \\cdot \\text{Area}(D)\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D) = \\frac{1}{2} \\cdot 3 \\cdot 4 = 6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\n\\det(T) = 4 \\cdot 2 -  2 \\cdot (-1) = 10.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,10\\,|\\cdot 6 \\\\  & =60.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4d59733f-3396-5d59-98a9-3f2e0ccfbbc4" :knowledge-point/questions [{:db/id #edb/ref 17592186092526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcd4d2da-f9ae-5dac-a6aa-21f2e58f134b" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186089328} {:answer/id #uuid "fe276fc8-71ce-54a9-bdd0-3c8d16aa2173" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186089329} {:answer/id #uuid "6c8efa2e-fc9d-5f83-b012-3d3489e9669e" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186089330} {:answer/id #uuid "729be913-ef79-558d-8f2d-cb9aa5e5eef7" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186089331} {:answer/id #uuid "72e3d07b-b3f3-5db3-9386-0b3942951f62" :answer/type {:db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186089332}] :answer-field/id #uuid "ae88142e-cecb-579f-a8f7-0fbdc7f2be2e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089327}] :question/id #uuid "4bf4a9e3-8733-57cb-8a7b-f550756d205c" :question/math-academy-id "q-12277" :question/problem "![](images/6c/6c6b6ed04872dbec67e45c473347a67f1dd46c095c70a592523c2391be0cc590.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T$, given below?\n$T = \\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix}$"} {:db/id #edb/ref 17592186092901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f7a022-23ac-53c8-a81d-072f503d8fa1" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186355270} {:answer/id #uuid "4d646465-2c5a-5ca4-b933-806b037217a0" :answer/type {:db/ident :answer.type/math} :answer/value "10\\pi " :db/id #edb/ref 17592186355353} {:answer/id #uuid "519ae3d6-ebd2-56c4-b611-9fffaf2c2e43" :answer/type {:db/ident :answer.type/math} :answer/value "80\\pi " :db/id #edb/ref 17592186355392} {:answer/id #uuid "67a53918-48e6-591c-9e5b-8d73080dc4da" :answer/type {:db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186355583} {:answer/id #uuid "d5647ae4-bc8a-51dc-8452-b54a04fb4241" :answer/type {:db/ident :answer.type/math} :answer/value "40\\pi " :db/id #edb/ref 17592186356532}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "40\\pi " :db/id #edb/ref 17592186356532} :answer-field/id #uuid "e1640760-c633-5dbb-a8f2-26644e16ddb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357318}] :question/id #uuid "45faf24d-552b-523b-9d7b-94bb05598c82" :question/math-academy-id "q-9302" :question/problem "![](images/4f/4f31b9f180b1b766451685428fc289766832fe5d0c7d8902a601ebf060eab0e7.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}-2 & -1 \\\\ 0 & 5\\end{bmatrix}.\n$$" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\pi \\cdot {2}^{2}=4\\pi .\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=(-2)\\cdot 5-(-1)\\cdot 0=-10.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|-10|\\cdot 4\\pi  \\\\  & =40\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d82cf3-65ea-5dba-bf7a-27272f3b4d24" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186234801}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186234801} :answer-field/id #uuid "d978a7cb-e8eb-5315-b004-48bc6c03f7e7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235237}] :question/id #uuid "41926de1-ea87-5292-8ead-08a36cada277" :question/math-academy-id "q-138785" :question/problem "The area of the new housing complex is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \nhectares." :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $R$ (the old housing complex) and the area of the image $T(R)$ (the new housing complex) under the action of $T:$\n\n$$\n\\text{Area}(T(R))=|det(T)|\\cdot \\text{Area}(R)\n$$\n\nWe're given that\n\n$$\n\\text{Area}(R)=16\\,\\text{hectares}.\n$$\n\nComputing the determinant of the matrix $T$ (found in part 1), we get\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-3 & 0 \\\\ 2 & -1\\end{aligned}| \\\\  & =(-3)\\cdot (-1)-(2)\\cdot 0 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(R)) & =|det(T)|\\cdot \\text{Area}(R) \\\\  & =3\\cdot 16 \\\\  & =48.\\end{aligned}\n$$\n\nTherefore, the area of the new housing complex is $48$ hectares."} {:db/id #edb/ref 17592186256717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499dac47-8436-5953-8ee0-05cfcfef1cd0" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186254302} {:answer/id #uuid "96cce4a7-f0e8-5694-8100-43eebcab4066" :answer/type {:db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186254996} {:answer/id #uuid "9dd0ab4d-f773-5ebb-b399-99f5db30cc4a" :answer/type {:db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186255057} {:answer/id #uuid "9fa1acb7-4f14-5098-9c0d-77b5d6c62c9e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186255076} {:answer/id #uuid "dd4d1ac9-93cb-598e-8067-b8360dcce9ff" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186255631}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186254996} :answer-field/id #uuid "fdfe6782-8ca7-592a-8bf5-c0e936a345c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256364}] :question/id #uuid "1ba16060-8bcf-52b0-a3d3-d301abe872e2" :question/math-academy-id "q-12279" :question/problem "![](images/f2/f24ec004411065e89b68793e32c80231c7eff6f9ff31e46bc530f78c9c270064.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}5 & -2 \\\\ -4 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot 7\\cdot 4=14.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=5\\cdot 3-(-2)\\cdot (-4)=7.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,7\\,|\\cdot 14 \\\\  & =98.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "200960c9-a2fa-5dea-ad5e-8bab9dfcdf9a" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186253948} {:answer/id #uuid "3f566b9f-4308-5720-9f6b-67f4c1cb0208" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186254216} {:answer/id #uuid "51bae210-66e3-5301-b73f-421bea3f6878" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186254378} {:answer/id #uuid "9d542e19-f81a-5b33-988c-44407117fe1b" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186255053} {:answer/id #uuid "a432fa1f-2fe8-575c-ba4e-419779e2ca83" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186255115}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186255115} :answer-field/id #uuid "ea64167e-f9cd-57c8-b1a8-32595d297c34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256334}] :question/id #uuid "1f758fdb-93df-5eb6-a710-8c50d46f4c4a" :question/math-academy-id "q-12281" :question/problem "![](images/d9/d9e210f0bfd9ada2dd147068fe0cf06fa85ad049f79bb7e844931b6037867f97.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=\\begin{bmatrix}5 & 2 \\\\ 3 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=2\\cdot 4=8.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=5\\cdot 2-2\\cdot 3=4.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,4\\,|\\cdot 8 \\\\  & =32.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97d9642a-0618-5f33-a26c-24cdf692b697" :answer/type {:db/ident :answer.type/math} :answer/value "142" :db/id #edb/ref 17592186255009} {:answer/id #uuid "b42d4173-8afe-5b6a-b489-4e81a34b73b3" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186255257} {:answer/id #uuid "bae5276e-cc00-52de-b024-969838198b28" :answer/type {:db/ide