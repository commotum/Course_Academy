d}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"} {:db/id #edb/ref 17592186542220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359dac84-023f-5ac4-b1e5-2b024191e8ff" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]{e}^{8t}+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]" :db/id #edb/ref 17592186541532} {:answer/id #uuid "557ae54f-10b2-58ab-9e71-0c628ea5f179" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]{e}^{8t}" :db/id #edb/ref 17592186541593} {:answer/id #uuid "bc4ad265-f473-5a67-8913-d792566b24af" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]" :db/id #edb/ref 17592186541815} {:answer/id #uuid "d11ef4d7-b160-5577-b380-46de80da0930" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]{e}^{-8t}+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]" :db/id #edb/ref 17592186541866} {:answer/id #uuid "f1c0af83-088a-5ec4-9706-445e6d105d2b" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]" :db/id #edb/ref 17592186541932}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}]" :db/id #edb/ref 17592186541932} :answer-field/id #uuid "f94becd7-b475-5661-836a-13b2396bb899" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186542101}] :question/id #uuid "ebc3a86d-4663-502d-a702-2a2557f07e8a" :question/math-academy-id "q-334779" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=8y(t) \\\\ {y}^{′}(t)=-8x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(8t) & \\operatorname{sin}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t) & \\operatorname{cos}⁡(8t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 8 \\\\ -8 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 8 \\\\ -8 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 8 \\\\ -8 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(8t) & \\operatorname{sin}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t) & \\operatorname{cos}⁡(8t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(8t) & \\operatorname{sin}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t) & \\operatorname{cos}⁡(8t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(8t) \\\\ -\\operatorname{sin}⁡(8t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(8t) \\\\ \\operatorname{cos}⁡(8t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"} {:db/id #edb/ref 17592186555759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280d8127-c31a-5e2e-b9dc-665b3585f060" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]{e}^{-9t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]" :db/id #edb/ref 17592186555084} {:answer/id #uuid "44c32af4-4f13-53b5-8974-40ae755cae35" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]{e}^{9t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]" :db/id #edb/ref 17592186555147} {:answer/id #uuid "48431481-3e8e-57a8-83d2-eb0cb39cf23b" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]" :db/id #edb/ref 17592186555154} {:answer/id #uuid "a2c5ce55-c333-5011-848b-c5650ca56801" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]" :db/id #edb/ref 17592186555391} {:answer/id #uuid "a3a1cb7e-8b62-5bfd-ab90-3eb838df358f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]{e}^{-9t}" :db/id #edb/ref 17592186555392}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}]" :db/id #edb/ref 17592186555391} :answer-field/id #uuid "8cd5bc44-1d8a-5b80-a78e-d0c95223991b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555710}] :question/id #uuid "021e3fe3-3d72-56fe-ac1a-be1f9dae2590" :question/math-academy-id "q-335026" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=9y(t) \\\\ {y}^{′}(t)=9x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 9 \\\\ 9 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 9 \\\\ 9 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 9 \\\\ 9 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(9t) & \\operatorname{sinh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t) & \\operatorname{cosh}⁡(9t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(9t) \\\\ \\operatorname{sinh}⁡(9t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(9t) \\\\ \\operatorname{cosh}⁡(9t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"} {:db/id #edb/ref 17592186563755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "246dbb57-80e4-56b7-8e34-27bb9114f64c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]{e}^{-2t}" :db/id #edb/ref 17592186563026} {:answer/id #uuid "45cfe9fb-b684-53e4-ab59-2be2f93d9858" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186563103} {:answer/id #uuid "4bdeeefb-735e-5811-8754-67e744ec5c92" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186563112} {:answer/id #uuid "63a09f8e-7c0b-5249-a0c2-f6b28192c424" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186563174} {:answer/id #uuid "d3e28dd3-0453-550c-862e-c838b2f1aca0" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186563408}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186563174} :answer-field/id #uuid "8ea9a430-3071-50b8-b617-7ec74f7a4ddc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563593}] :question/id #uuid "eaac4ca3-6936-5237-9e98-3d7aa72b5385" :question/math-academy-id "q-335025" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-2y(t) \\\\ {y}^{′}(t)=-2x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"}] :knowledge-point/title "Finding the General Solution of a Homogeneous System Using a Given Matrix Exponential"} {:db/id #edb/ref 17592186229143 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228918 :question/id #uuid "ead811e0-8551-5b15-8b49-711cbe0b8498" :question/math-academy-id "e-21725" :question/problem "![](images/6e/6e456b14ca5110a5cf290cd0053bd52652c8d44e2e9f517f73d2b257c355b8cf.svg)\nFind the solution to the initial value problem above.\n\n*Hint: ![](images/e4/e43485cd9eaca81dd04089924a83a909594e575d76d195850cf11719809acbbd.svg) where ![](images/6a/6ac1e35cee6cfbab9771278c3a68f422e5422ef79e4f516755e35748ea402e08.svg)*" :question/worked-solution "Writing our system in matrix form, we get\n![](images/b4/b434d5c8a601c3d7fae734a5b78437457fab7877fe0ca1ff466197817d9d1c0e.svg)\nwhere ![](images/cc/cc9313ae17390c751e51673c53d788c24308f501fa7107e3098cd370028eb1d2.svg) So, the matrix of the system is ![](images/1d/1d3df45727a13bfbc41ab2689fd1a9a6dbcc28fd4ed071a430a2e745e99aeec8.svg)\n\nGiven the system $\\mathbf{x}'(t) = A \\mathbf{x}(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\n\\mathbf{x}(t) = \\Phi_0(t) \\, \\mathbf{x}(0),\n$$\n\nwhere $\\Phi_0(t) = e^{At}$ is the standard fundamental matrix of the system, and $\\mathbf{x}(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix $\\Phi_0(t)$ of the system is given by\n\n![](images/a9/a998751dcfc2e8acb4e142c5b4a5241ec61fe3bc087dccf9fe87344d73b04ce3.svg)\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(3t) & \\operatorname{sin}⁡(3t) \\\\ -\\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\operatorname{cos}⁡(3t)-\\operatorname{sin}⁡(3t) \\\\ -2\\operatorname{sin}⁡(3t)-\\operatorname{cos}⁡(3t)\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3d611c75-818f-508f-a7a4-49edb32baa41" :knowledge-point/questions [{:db/id #edb/ref 17592186229657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2826f3b3-aa19-5166-9709-c29a10e19d9b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ 3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534348} {:answer/id #uuid "4c00ea3b-3ce4-5e0c-8832-b95dc6c0a81b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534412} {:answer/id #uuid "5075de84-7cd8-5fc4-90bb-1cd990dbc9ed" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534423} {:answer/id #uuid "70233942-007a-5043-b53a-395ec3709d87" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534501} {:answer/id #uuid "c1df0fbb-0a33-5bd3-9288-292dffd71dcd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534698}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/id #edb/ref 17592186534501} :answer-field/id #uuid "ca3c1b24-93bd-5251-bf4f-c0926f7bb2fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228132}] :question/id #uuid "4ca0dd99-a2aa-57ba-b99d-effa4b0eacfb" :question/math-academy-id "q-333981" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2y(t) \\\\ {y}^{′}(t)=2x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}][\\begin{aligned}0 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186229682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77290e62-6148-5a0c-a377-bec8579eec5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2t{e}^{-3t} \\\\ 2{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186309679} {:answer/id #uuid "97fc3697-404e-5fb0-854e-fc0c8ff7d45c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{e}^{-3t} \\\\ 2t{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186309968} {:answer/id #uuid "9a02425e-0f01-5418-94f2-288ad58f1b27" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2t{e}^{3t} \\\\ 2{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186309988} {:answer/id #uuid "a7c51a8a-3c2a-5bdb-a554-d4a1fb8e8ca3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2t{e}^{-3t} \\\\ -2{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186310100} {:answer/id #uuid "d266e8d7-9b0b-5943-9acc-ac02de0e98d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2t{e}^{-3t} \\\\ 2{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186310440}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2t{e}^{-3t} \\\\ 2{e}^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186310440} :answer-field/id #uuid "a01f0c87-7802-5bf3-a753-2547be1ae761" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311255}] :question/id #uuid "62010a37-a91d-55bc-8c8e-6361d12d6c44" :question/math-academy-id "q-335267" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-3x(t)+y(t) \\\\ {y}^{′}(t) &=-3y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{bmatrix},$ where $A=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}.$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}-3 & 1 \\\\ 0 & -3\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2t{e}^{-3t} \\\\ 2{e}^{-3t}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf4d923b-f1e0-5200-b875-952e608fe146" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}(2t)+2\\operatorname{cos}(2t)" :db/id #edb/ref 17592186306935} {:answer/id #uuid "5dde915f-8d58-5806-8670-d44aa8a12efa" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(2t)+2\\cos(2t)" :db/id #edb/ref 17592186445558}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sin(2t)+2\\cos(2t)" :db/id #edb/ref 17592186445558} :answer-field/id #uuid "250c7dc4-5bbf-5745-996d-cb98d0a787e4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307639} {:answer-field/choices [{:answer/id #uuid "f5c2da58-df61-583a-81eb-de777d114871" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}(2t)-\\operatorname{cos}(2t)" :db/id #edb/ref 17592186307429} {:answer/id #uuid "0a087c4f-5999-5d51-b329-5bde4e70b5a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos(2t)+2\\sin(2t)" :db/id #edb/ref 17592186445539}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\cos(2t)+2\\sin(2t)" :db/id #edb/ref 17592186445539} :answer-field/id #uuid "f7fc44b4-bb76-5cfd-8ecc-9c61d46d594b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308308}] :question/id #uuid "b59372b5-46f1-5738-9ccc-9025ae0786e0" :question/math-academy-id "q-333971" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=2y(t) \\\\ {y}^{′}(t) &=-2x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"150px\">\n{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 2 \\\\ -2 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4386227a-d159-5ea7-b586-57eb8ba8b3dc" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sin}(5t)+\\operatorname{cos}(5t)" :db/id #edb/ref 17592186309258} {:answer/id #uuid "ce0f7ff2-63f3-536e-a712-0b2b5f23cf38" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sin(5t)+\\cos(5t)" :db/id #edb/ref 17592186506276}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\sin(5t)+\\cos(5t)" :db/id #edb/ref 17592186506276} :answer-field/id #uuid "53651861-1195-570e-a314-53031aadafea" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311008} {:answer-field/choices [{:answer/id #