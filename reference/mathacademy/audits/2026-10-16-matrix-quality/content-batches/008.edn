) & ={e}^{A(t-1)}\\,x(1) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(4(t-1)) & -\\operatorname{sinh}⁡(4(t-1)) \\\\ -\\operatorname{sinh}⁡(4(t-1)) & \\operatorname{cosh}⁡(4(t-1))\\end{bmatrix}\\begin{bmatrix}0 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\operatorname{sinh}⁡(4(t-1)) \\\\ -2\\operatorname{cosh}⁡(4(t-1))\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186391586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "942a629e-94b8-5c24-bbcc-97e7d789cb40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\operatorname{sinh}⁡(3(t+1)) \\\\ \\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391588} {:answer/id #uuid "9b04c091-3bbb-5dae-9ed9-1a467ab29d95" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{cosh}⁡(3(t+1)) \\\\ -2\\operatorname{sinh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391589} {:answer/id #uuid "07f2c784-653a-5833-9229-3fb331cf19a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{sinh}⁡(3(t+1)) \\\\ -2\\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391590} {:answer/id #uuid "4ea30351-9279-59bc-8f85-f17f0652612d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{cosh}⁡(3(t+1)) \\\\ -2\\operatorname{sinh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391591} {:answer/id #uuid "150d70c1-d912-530b-b05b-4c87bea0ff00" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{sinh}⁡(3(t+1)) \\\\ 2\\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391592}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{sinh}⁡(3(t+1)) \\\\ 2\\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}" :db/id #edb/ref 17592186391592} :answer-field/id #uuid "36126579-e63c-590b-a6f7-f58bde2b64a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391587}] :question/id #uuid "6580aa1b-3c6f-5533-9e32-e7afb350be95" :question/math-academy-id "q-335450" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=-3y(t) \\\\ {y}^{′}(t) &=-3x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(-1) \\\\ y(-1)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(3t) & -\\operatorname{sinh}⁡(3t) \\\\ -\\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & -3 \\\\ -3 & 0\\end{bmatrix}.$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & -3 \\\\ -3 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & -3 \\\\ -3 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-(-1))}\\,x(-1) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(3(t+1)) & -\\operatorname{sinh}⁡(3(t+1)) \\\\ -\\operatorname{sinh}⁡(3(t+1)) & \\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\operatorname{sinh}⁡(3(t+1)) \\\\ 2\\operatorname{cosh}⁡(3(t+1))\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfee9ed8-1867-53c1-a47d-d52b275699cf" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{4(t-3)}" :db/id #edb/ref 17592186445588}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-e^{4(t-3)}" :db/id #edb/ref 17592186445588} :answer-field/id #uuid "c45903a1-fe5a-5b4c-96af-6a0c00ecf707" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445604} {:answer-field/choices [{:answer/id #uuid "7f456005-43ef-5ff5-9026-4d0917c6ca81" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445568}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445568} :answer-field/id #uuid "fa590e88-0053-5685-8a5c-24106590dec4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445607}] :question/id #uuid "e674cbe1-254a-5d93-a9b4-be22a2029aaf" :question/math-academy-id "q-335427" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=4x(t)+y(t) \\\\ {y}^{′}(t) &=4y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(3) \\\\ y(3)\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{bmatrix},$ where $A=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-3)}\\,x(3) \\\\  & =\\begin{bmatrix}{e}^{4(t-3)} & (t-3){e}^{4(t-3)} \\\\ 0 & {e}^{4(t-3)}\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\,-{e}^{4(t-3)}\\, \\\\ \\,0\\,\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186482582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0f7256d-2d29-5c85-9d4b-72a842efcbc5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos(6(t-3))" :db/id #edb/ref 17592186482307}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\cos(6(t-3))" :db/id #edb/ref 17592186482307} :answer-field/id #uuid "199ebf62-577b-5ccf-9a87-eb53b5ca9e94" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482391} {:answer-field/choices [{:answer/id #uuid "c1cf21ed-005b-59e4-9bd4-7e59ab89d886" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(6(t-3))" :db/id #edb/ref 17592186482236}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sin(6(t-3))" :db/id #edb/ref 17592186482236} :answer-field/id #uuid "1cf580ea-9ff4-59fc-a20f-31f6a8ae4bf6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482392}] :question/id #uuid "b5cac624-fcaa-5546-985b-94ad2df95205" :question/math-academy-id "q-335436" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=6y(t) \\\\ {y}^{′}(t) &=-6x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(3) \\\\ y(3)\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(6t) & \\operatorname{sin}⁡(6t) \\\\ -\\operatorname{sin}⁡(6t) & \\operatorname{cos}⁡(6t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 6 \\\\ -6 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"140px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "% Explanation\nWriting our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 6 \\\\ -6 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 6 \\\\ -6 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-3)}\\,x(3) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(6(t-3)) & \\operatorname{sin}⁡(6(t-3)) \\\\ -\\operatorname{sin}⁡(6(t-3)) & \\operatorname{cos}⁡(6(t-3))\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\,-\\operatorname{cos}⁡(6(t-3))\\, \\\\ \\,\\operatorname{sin}⁡(6(t-3))\\,\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68733ae1-b610-5dd9-b95d-12135f00648e" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos(5(t+2))" :db/id #edb/ref 17592186534477}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\cos(5(t+2))" :db/id #edb/ref 17592186534477} :answer-field/id #uuid "4e339ad0-7370-56ee-a106-ae32b1e3a838" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534876} {:answer-field/choices [{:answer/id #uuid "4db09dc0-d4c5-5e09-a70f-eae2e3269be4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(5(t+2))" :db/id #edb/ref 17592186534416}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\sin(5(t+2))" :db/id #edb/ref 17592186534416} :answer-field/id #uuid "b890faf2-939e-5590-92f1-af9dc867356d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534938}] :question/id #uuid "530f8a57-b248-5ddf-8ae9-a8b808f3a729" :question/math-academy-id "q-335435" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-5y(t) \\\\ {y}^{′}(t)=5x(t),\\end{aligned}\\,[\\begin{aligned}x(-2) \\\\ y(-2)\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(5t) & -\\operatorname{sin}⁡(5t) \\\\ \\operatorname{sin}⁡(5t) & \\operatorname{cos}⁡(5t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t+2)}\\,x(-2) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(5(t+2)) & -\\operatorname{sin}⁡(5(t+2)) \\\\ \\operatorname{sin}⁡(5(t+2)) & \\operatorname{cos}⁡(5(t+2))\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\,\\operatorname{cos}⁡(5(t+2))\\, \\\\ \\,\\operatorname{sin}⁡(5(t+2))\\,\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d2dabb0-502b-562b-b584-741bd2219b36" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin(3(t-2))" :db/id #edb/ref 17592186555287}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2\\sin(3(t-2))" :db/id #edb/ref 17592186555287} :answer-field/id #uuid "12370503-03e0-554e-be1b-d6e2ad47764c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186555648} {:answer-field/choices [{:answer/id #uuid "d71b20dd-cdf6-5315-9b31-8b02be6facce" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos(3(t-2))" :db/id #edb/ref 17592186555515}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2\\cos(3(t-2))" :db/id #edb/ref 17592186555515} :answer-field/id #uuid "645a6766-29a4-5adf-89b5-f8cdeb82aee5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186555689}] :question/id #uuid "ea042103-925d-51d6-8c12-93baa97ad8a2" :question/math-academy-id "q-335432" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3y(t) \\\\ {y}^{′}(t)=3x(t),\\end{aligned}\\,[\\begin{aligned}x(2) \\\\ y(2)\\end{aligned}]=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(3t) & -\\operatorname{sin}⁡(3t) \\\\ \\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -3 \\\\ 3 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -3 \\\\ 3 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -3 \\\\ 3 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-2)}\\,x(2) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(3(t-2)) & -\\operatorname{sin}⁡(3(t-2)) \\\\ \\operatorname{sin}⁡(3(t-2)) & \\operatorname{cos}⁡(3(t-2))\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\,2\\operatorname{cos}⁡(3(t-2))\\, \\\\ \\,2\\operatorname{sin}⁡(3(t-2))\\,\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186563702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3e6f6d2-ce35-5cb0-a6c5-f9b0db8f35b2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sin(4(t-1))" :db/id #edb/ref 17592186563409}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\sin(4(t-1))" :db/id #edb/ref 17592186563409} :answer-field/id #uuid "0f7c85fb-7d21-5d48-8f24-4c37d6bc47ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186563524} {:answer-field/choices [{:answer/id #uuid "f8ac02a8-cb92-5cdb-baec-1e8c677c1a9c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cos(4(t-1))" :db/id #edb/ref 17592186563502}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3\\cos(4(t-1))" :db/id #edb/ref 17592186563502} :answer-field/id #uuid "9ff392b1-754b-5f5c-ad8a-af1f4c91dfa9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186563605}] :question/id #uuid "701145a1-1f00-509b-9c1b-60626233c2a4" :question/math-academy-id "q-335434" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4y(t) \\\\ {y}^{′}(t)=-4x(t),\\end{aligned}\\,[\\begin{aligned}x(1) \\\\ y(1)\\end{aligned}]=[\\begin{aligned}0 \\\\ 3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-1)}\\,x(1) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-1)) & \\operatorname{sin}⁡(4(t-1)) \\\\ -\\operatorname{sin}⁡(4(t-1)) & \\operatorname{cos}⁡(4(t-1))\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\,3\\operatorname{sin}⁡(4(t-1))\\, \\\\ \\,3\\operatorname{cos}⁡(4(t-1))\\,\\end{aligned}].\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Homogeneous Initial Value Problem Using a Given Matrix Exponential: Shifted Initial Conditions"} {:db/id #edb/ref 17592186229145 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228911 :question/id #uuid "ace067cd-e1d0-5b3e-bae2-bf58dcac3585" :question/math-academy-id "e-21711" :question/problem "Consider the homogeneous system $\\mathbf{x}'(t)=A\\mathbf{x}(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix $\\Phi_0(t)$ is the unique solution to the initial value problem\n\n$$\n\\Phi_0'(t) = A\\Phi_0(t), \\qquad \\Phi_0(0) = I_n.\n$$\n\nA derivation of the formula for the solution $\\mathbf{x}(t)$ passing through $\\mathbf{x}(t_0)$ is presented below. \n\n$\\textrm{L1}{:}\\;$ Let $\\Phi_0(t)=e^{At}$  \n\n$\\textrm{L2}{:}\\;$ $\\mathbf{x}(t)=\\Phi_0(t)\\,\\mathbf{c}$ for some constant vector $\\mathbf{c}$  \n\n$\\textrm{L3}{:}\\;$ $\\mathbf{x}(t)=e^{At}\\,\\mathbf{c}$ \n\n$\\textrm{L4}{:}\\;$ $\\mathbf{x}(t_0)=e^{A t_0} \\, \\mathbf{c}$  \n\n$\\textrm{L5}{:}\\;$ $(e^{A t_0})^{-1} \\mathbf{x}(t_0)=(e^{At_0})^{-1} e^{A t_0} \\, \\mathbf{c}$  \n\n$\\textrm{L6}{:}\\;$ $\\mathbf{c} = e^{-A t_0} \\mathbf{x}(t_0) \\,$  \n\n$\\textrm{L7}{:}\\;$ $\\mathbf{x}(t) = e^{At} e^{-At_0} \\mathbf{x}(t_0) \\,$  \n\n$\\textrm{L8}{:}\\;$ $\\mathbf{x}(t) = e^{At - At_0} \\mathbf{x}(t_0) \\,$  \n\n$\\textrm{L9}{:}\\;$ $\\mathbf{x}(t) = e^{A(t-t_0)} \\mathbf{x}(t_0) \\,$  \n\nFill in the blanks to justify each step of the following reasoning.\n\n$\\qquad$ Line $\\textrm{L5}$ follows from $\\textrm{L4}$ by ![](images/b2/b2df506469d945a843b7784f38a1b12d6f89016aee1fb12581705b6d9d98baab.svg)\n\n$\\qquad$ The property of the matrix exponential used in $\\textrm{L8}$ is ![](images/7a/7af985a90d901c63f7d03feda679d513fa18ccb36d34c8fb237ac755baf9f801.svg)\n\n$\\qquad$ Line $\\textrm{L9}$ follows from $\\textrm{L8}$ by the fact that  ![](images/c5/c55c24e30a71bf93cdd21c2a5d0f3c68271cd6fb3f2033b84ce8338569eacd4a.svg)" :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\textrm{L4}$ and $\\textrm{L5}.$ Starting from $\\textrm{L4},$\n\n$$\n\\mathbf{x}(t_0)=e^{A t_0} \\, \\mathbf{c},\n$$\n\nwe multiply both sides on the left by $(e^{At_0})^{-1}$ to get\n\n$$\n(e^{A t_0})^{-1}\\mathbf{x}(t_0)=(e^{At_0})^{-1}e^{A t_0}\\,\\mathbf{c},\n$$\n\nwhich is line $\\textrm{L5}.$ Therefore, $\\textrm{L5}$ follows from $\\textrm{L4}$ by ![](images/22/2226897d3c49c80358dc93ec1d1d80bd8b513764e6b39bbf93408215c83144bf.svg)\n\n- Next, we justify the step $\\textrm{L7}$ to $\\textrm{L8}.$ Since $At$ and $-At_0$ commute, we may combine exponentials:\n\n$$\ne^{At}e^{-At_0}=e^{At-At_0}.\n$$\n\nSubstituting this into line $\\textrm{L7}$ produces line $\\textrm{L8}.$ Hence, the property of the matrix exponential used in $\\textrm{L8}$ is ![](images/e4/e4a1c6f6b74ea7491973a3bfa76225f1f6af67a681582a49afa51772c05bfaed.svg)\n\n- Finally, we consider lines $\\textrm{L8}$ and $\\textrm{L9}.$ Starting from $\\textrm{L8},$\n\n$$\n\\mathbf{x}(t)=e^{At-At_0}\\mathbf{x}(t_0),\n$$\n\nwe rewrite the exponent using the algebraic identity $At-At_0=A(t-t_0)$ to get\n\n$$\n\\mathbf{x}(t)=e^{A(t-t_0)}\\mathbf{x}(t_0),\n$$\n\nwhich is line $\\textrm{L9}.$ Thus, $\\textrm{L9}$ follows from $\\textrm{L8}$ by the fact that $\\bbox[4pt, border: solid 1pt lightgray]{At-At_0=A(t-t_0)\\text{ for any }t\\text{ and }t_0}.$"} :knowledge-point/id #uuid "1ff837c0-0ebb-5a9e-acb4-894261e0318c" :knowledge-point/questions [{:db/id #edb/ref 17592186229658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddf47bd1-795c-5a11-b0e3-f0b2b9e331e8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L2}$" :db/id #edb/ref 17592186372649} {:answer/id #uuid "e05d0157-509e-54f8-93bf-caebcef52673" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186372650} {:answer/id #uuid "53c2eeb0-49da-574f-9fed-3cc20c2d56d5" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L3}$ and $\\text{L4}$" :db/id #edb/ref 17592186372651} {:answer/id #uuid "5df25e2f-ebee-57ed-9dbd-3fafe0df4480" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L3}$" :db/id #edb/ref 17592186372652}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186372650} :answer-field/id #uuid "ab481dec-1ae8-51be-b85b-70941d4f372c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372648} {:answer-field/choices [{:answer/id #uuid "8cd12299-483e-5c98-8cfb-5093a259f798" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186372654} {:answer/id #uuid "b990c9db-e47d-504f-b7c8-8d1733bf87d4" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186372655} {:answer/id #uuid "9a41c693-9645-5cfb-8568-d811fb43680c" :answer/type {:db/ident :answer.type/text} :answer/value "using diagonalization of $Φ$" :db/id #edb/ref 17592186372656} {:answer/id #uuid "7a791c9f-84b0-50a6-a430-c32ad39fb614" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating the equation" :db/id #edb/ref 17592186372657}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186372654} :answer-field/id #uuid "43bc5aa5-c908-54a0-806e-2624e338ba95" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372653} {:answer-field/choices [{:answer/id #uuid "57ded996-9ccb-5cb5-9fc2-680c811cefe1" :answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186372659} {:answer/id #uuid "c6e83cb1-0838-5822-8ae9-639267505411" :answer/type {:db/ident :answer.type/text} :answer/value "definition of a solution curve" :db/id #edb/ref 17592186372660} {:answer/id #uuid "e7646179-3ccc-53ad-8251-b2fa9008ceb1" :answer/type {:db/ident :answer.type/text} :answer/value "properties of the determinant" :db/id #edb/ref 17592186372661} {:answer/id #uuid "e3fcb9e7-6ca1-51d4-b6b1-6590bd634d01" :answer/type {:db/ident :answer.type/text} :answer/value "definition of matrix multiplication" :db/id #edb/ref 17592186372662}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186372659} :answer-field/id #uuid "6a65b927-0188-538b-ab8c-226d64585514" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372658}] :question/id #uuid "2c2234c8-1637-5807-8336-81efdf9ec90b" :question/math-academy-id "q-333992" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$ \n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$ \n\n$\\text{L3}:\\,$ $x(0)={Φ}_{0}(0)\\,c$ \n\n$\\text{L4}:\\,$ ${Φ}_{0}(0)={I}_{n}$\n\n$\\text{L5}:\\,$ $x(0)=c$ \n\n$\\text{L6}:\\,$ $x(t)={e}^{At}\\,x(0)$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by the \n{{field-1}}.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by \n{{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L2}$ by substitution from lines {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Since ${Φ}_{0}(t)={e}^{At}$ is a fundamental matrix, every solution of the system can be written as \n\n$$\nx(t)={Φ}_{0}(t)\\,c\\,\\text{for some constant vector }c.\n$$\n\nThus, $\\text{L2}$ follows from $\\text{L1}$ by the $\\text{properties of a fundamental matrix}.$\n\n- Next, we consider lines $\\text{L2}$ and $\\text{L3}.$ Evaluating the identity $x(t)={Φ}_{0}(t)\\,c$ at $t=0$ gives \n\n$$\nx(0)={Φ}_{0}(0)c.\n$$\n\nTherefore, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{evaluating both sides at }t=0.$\n\n- Finally, we consider lines $\\text{L2}$ and $\\text{L6}.$ Substituting ${Φ}_{0}(t)={e}^{At}$ from $\\text{L1}$ and $c=x(0)$ from $\\text{L5}$ into $x(t)={Φ}_{0}(t)\\,c,$ we obtain\n\n$$\nx(t)={e}^{At}\\,x(0).\n$$\n\nThus, $\\text{L6}$ follows from $\\text{L2}$ and substitution from $\\text{L1}\\text{ and }\\text{L5}.$"} {:db/id #edb/ref 17592186229697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c14b0b-6134-5bed-bee6-816912d61365" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{Mt}{e}^{-M{t}_{0}}={e}^{M(t-{t}_{0})}" :db/id #edb/ref 17592186308890} {:answer/id #uuid "7a4b7b03-dd23-5804-b0ab-e36a1cf3ccf6" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186309700} {:answer/id #uuid "9916cee6-3a2c-57ad-bb9b-91e60a976e9b" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{A{t}_{0}}={e}^{At}$ for any matrix $A$" :db/id #edb/ref 17592186309982} {:answer/id #uuid "db7e796b-5ae4-519f-a67a-d1aed48231c1" :answer/type {:db/ident :answer.type/text} :answer/value "$Bt-B{t}_{0}=B(t-{t}_{0})$ for any $t$ and ${t}_{0}$" :db/id #edb/ref 17592186310506}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186309700} :answer-field/id #uuid "543d5358-872d-5528-9c7f-c8cc3db9937c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311010} {:answer-field/choices [{:answer/id #uuid "217f2965-3def-569f-947d-692f1650809e" :answer/type {:db/ident :answer.type/text} :answer/value "by substitution from line $\\text{L2}$" :db/id #edb/ref 17592186309001} {:answer/id #uuid "667b7e3d-b549-5061-a30e-feb651e43fec" :answer/type {:db/ident :answer.type/text} :answer/value "by substituting $t={t}_{0}$" :db/id #edb/ref 17592186309536} {:answer/id #uuid "dbbe8906-11f6-5f0e-8be5-7e60e92604ae" :answer/type {:db/ident :answer.type/text} :answer/value "using the fact that ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186310508}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "by substituting $t={t}_{0}$" :db/id #edb/ref 17592186309536} :answer-field/id #uuid "a1e482e3-780a-5e91-b090-efa6a61b43ee" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311264} {:answer-field/choices [{:answer/id #uuid "470e1341-576f-51bf-8372-83789f8096ac" :answer/type {:db/ident :answer.type/text} :answer/value "the definition of matrix exponential" :db/id #edb/ref 17592186309291} {:answer/id #uuid "9fc59270-51b2-5c62-b938-b48c9f3532b2" :answer/type {:db/ident :answer.type/text} :answer/value "the properties of a fundamental matrix" :db/id #edb/ref 17592186310038} {:answer/id #uuid "d1fb24cf-f960-5624-9b68-8fb29c368dd0" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t={t}_{0}$" :db/id #edb/ref 17592186310437}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "the properties of a fundamental matrix" :db/id #edb/ref 17592186310038} :answer-field/id #uuid "f2f5da27-dc12-5c0e-8352-c31ac3b14b77" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311499}] :question/id #uuid "da9645d1-ab1f-59b5-93f4-27c23f00e120" :question/math-academy-id "q-336639" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(t)={e}^{At}\\,c$ \n\n$\\text{L4}:\\,$ $x({t}_{0})={e}^{A{t}_{0}}\\,c$\n\n$\\text{L5}:\\,$ $({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c$\n\n$\\text{L6}:\\,$ $c={e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L7}:\\,$ $x(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L8}:\\,$ $x(t)={e}^{At-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})\\,$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ is true by {{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from $\\text{L3}$ {{field-2}}.\n\n$\\,$ Line $\\text{L8}$ follows from $\\text{L7}$ by the fact that {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Since ${Φ}_{0}(t)={e}^{At}$ is a fundamental matrix for the system, every solution of the system can be written as \n\n$$\nx(t)={Φ}_{0}(t)\\,c\\,\\text{for some constant vector }c.\n$$\n\nThus, $\\text{L2}$ is true by $\\text{the properties of a fundamental matrix}.$\n\n- Next, we consider lines $\\text{L3}$ and $\\text{L4}.$ Starting from $\\text{L3},$\n\n$$\nx(t)={e}^{At}\\,c,\n$$\n\nwe evaluate both sides at $t={t}_{0}$ to obtain\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nwhich is line $\\text{L4}.$ Therefore, $\\text{L4}$ follows from $\\text{L3}$ $\\text{by substituting }t={t}_{0}.$\n\n- Finally, we consider lines $\\text{L7}$ and $\\text{L8}.$ Since $At$ and $-A{t}_{0}$ commute, we can use the property \n\n$$\n{e}^{At}{e}^{-A{t}_{0}}={e}^{At-A{t}_{0}}.\n$$\n\nSubstituting this into line $\\text{L7},$ we get line $\\text{L8}:$\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}) \\\\  & ={e}^{At-A{t}_{0}}x({t}_{0})\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ follows from $\\text{L7}$ by the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}\\text{ when }X\\text{ and }Y\\text{ commute}.$"} {:db/id #edb/ref 17592186311712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c34b001-8f8c-572c-b23f-54c9b0c5e906" :answer/type {:db/ident :answer.type/text} :answer/value "using the initial condition ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186308966} {:answer/id #uuid "2cf1caf8-52d6-5aa2-81ff-73de1341e51f" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating ${Φ}_{0}(t)$ at $t=1$" :db/id #edb/ref 17592186309083} {:answer/id #uuid "487cf069-3ce8-55d6-8f31-00a5f9dc3430" :answer/type {:db/ident :answer.type/text} :answer/value "computing $det({Φ}_{0}(0))$" :db/id #edb/ref 17592186309301} {:answer/id #uuid "8b861976-a2d2-5456-8f84-3e614119c072" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule to ${Φ}_{0}(0)$" :db/id #edb/ref 17592186309850}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "using the initial condition ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186308966} :answer-field/id #uuid "746ca404-3ff2-5606-b348-9000ebf3fa87" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311108} {:answer-field/choices [{:answer/id #uuid "013fe3e7-48a3-5036-84c8-ff7674a40c54" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L2}$" :db/id #edb/ref 17592186308751} {:answer/id #uuid "05b6b3d7-e359-543e-a6f7-70fbe1665e8b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L3}$" :db/id #edb/ref 17592186308794} {:answer/id #uuid "77824231-14d3-5fd4-a1b5-159f6745b22b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186309685} {:answer/id #uuid "b90dcf6d-1547-5a3f-9184-7b3f3f7726d1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L3}$ and $\\text{L4}$" :db/id #edb/ref 17592186310248}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186309685} :answer-field/id #uuid "875aa7e2-b4fd-5e3f-9e1e-8e2d7af33a25" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311175} {:answer-field/choices [{:answer/id #uuid "351e9093-98d5-59b5-baff-6bad3f2b3811" :answer/type {:db/ident :answer.type/text} :answer/value "definition of matrix multiplication" :db/id #edb/ref 17592186309152} {:answer/id #uuid "50102d24-a6a9-5c87-aa99-704cb37623ad" :answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186309355} {:answer/id #uuid "adde2792-5c0e-5b9b-9cec-0d10e61be9ab" :answer/type {:db/ident :answer.type/text} :answer/value "properties of the determinant" :db/id #edb/ref 17592186310155} {:answer/id #uuid "bbe97a2c-08be-5a21-a27a-cc283819bfcf" :answer/type {:db/ident :answer.type/text} :answer/value "definition of a solution curve" :db/id #edb/ref 17592186310271}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186309355} :answer-field/id #uuid "93fd95bd-02de-51a7-9380-23ea3323f2a5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311215}] :question/id #uuid "9684981a-5306-5edd-b5f3-7d483bf8c5e8" :question/math-academy-id "q-336481" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(0)={Φ}_{0}(0)\\,c$\n\n$\\text{L4}:\\,$ ${Φ}_{0}(0)={I}_{n}$\n\n$\\text{L5}:\\,$ $x(0)=c$\n\n$\\text{L6}:\\,$ $x(t)={e}^{At}\\,x(0)$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by the\n{{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from the definition of ${Φ}_{0}(t)$ as the standard fundamental matrix by\n{{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L2}$ by substitution from lines {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Since ${Φ}_{0}(t)={e}^{At}$ is a fundamental matrix for the system, every solution of the system can be written as \n\n$$\nx(t)={Φ}_{0}(t)\\,c\\,\\text{for some constant vector }c.\n$$\n\nThus, $\\text{L2}$ follows from $\\text{L1}$ by the $\\text{properties of a fundamental matrix}.$\n\n- Next, we consider line $\\text{L4}.$ By definition, the standard fundamental matrix ${Φ}_{0}(t)$ satisfies the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nThe second condition here is exactly line $\\text{L4},$ so $\\text{L4}$ follows from the definition of ${Φ}_{0}(t)$ as the standard fundamental matrix by $\\text{using the initial condition }{Φ}_{0}(0)={I}_{n}.$\n\n- Finally, we consider lines $\\text{L2}$ and $\\text{L6}.$ Substituting ${Φ}_{0}(t)={e}^{At}$ from $\\text{L1}$ and $c=x(0)$ from $\\text{L5}$ into $x(t)={Φ}_{0}(t)\\,c,$ we obtain\n\n$$\nx(t)={e}^{At}\\,x(0).\n$$\n\nThus, $\\text{L6}$ follows from $\\text{L2}$ and substitution from $\\text{L1}\\text{ and }\\text{L5}.$"} {:db/id #edb/ref 17592186311794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17966dd8-73ff-5dae-a604-448905e652ec" :answer/type {:db/ident :answer.type/text} :answer/value "by substituting $t={t}_{0}$" :db/id #edb/ref 17592186308934} {:answer/id #uuid "6427f8ed-49bc-5e1b-ad8d-b32b63aa2584" :answer/type {:db/ident :answer.type/text} :answer/value "by substitution from line $\\text{L2}$" :db/id #edb/ref 17592186309517} {:answer/id #uuid "fc75620b-35c9-591c-aade-7daa879c2824" :answer/type {:db/ident :answer.type/text} :answer/value "using the fact that ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186310766}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "by substituting $t={t}_{0}$" :db/id #edb/ref 17592186308934} :answer-field/id #uuid "0f5ad037-aae6-5cab-bcba-d870b9717a79" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186310836} {:answer-field/choices [{:answer/id #uuid "3586d768-5a6b-55e3-b74b-d7384ddf8b5f" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186309155} {:answer/id #uuid "96845e88-24f3-523a-aa89-8c99b1e81691" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{A{t}_{0}}={e}^{At}$ for any matrix $A$" :db/id #edb/ref 17592186309954} {:answer/id #uuid "9af374b3-6d71-58a8-b886-dbe3e18d9a85" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{At}{e}^{-A{t}_{0}}={e}^{A(t-{t}_{0})}" :db/id #edb/ref 17592186310003}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186309155} :answer-field/id #uuid "5f7d8c45-9baf-5f3c-9730-e684d4f25418" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311044} {:answer-field/choices [{:answer/id #uuid "3b4f6d50-4cc2-5464-88dd-148342d77dce" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}" :db/id #edb/ref 17592186309204} {:answer/id #uuid "757e14df-a5bc-5543-aecf-5b5c92b609a8" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{A{t}_{0}}{e}^{-A{t}_{0}}=I{e}^{-A{t}_{0}}" :db/id #edb/ref 17592186309664} {:answer/id #uuid "b7846f39-941e-5fc0-a5af-9df9b5d9178c" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}={e}^{A{t}_{0}}I" :db/id #edb/ref 17592186310233}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}" :db/id #edb/ref 17592186309204} :answer-field/id #uuid "e445eb61-c230-53f6-a72a-4588c5fa0f2d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311455}] :question/id #uuid "45874040-9e7b-5fb5-9a00-ef344d9b3cd1" :question/math-academy-id "q-337109" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$  \n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$  \n\n$\\text{L3}:\\,$ $x(t)={e}^{At}\\,c$ \n\n$\\text{L4}:\\,$ $x({t}_{0})={e}^{A{t}_{0}}\\,c$  \n\n$\\text{L5}:\\,$ $({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c$  \n\n$\\text{L6}:\\,$ $c={e}^{-A{t}_{0}}x({t}_{0})\\,$  \n\n$\\text{L7}:\\,$ $x(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0})\\,$  \n\n$\\text{L8}:\\,$ $x(t)={e}^{At-A{t}_{0}}x({t}_{0})\\,$  \n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})\\,$  \n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$  Line $\\text{L4}$ follows from $\\text{L3}$ {{field-1}}.\n\n$\\,$ Line $\\text{L6}$ follows from $\\text{L5}$ by the fact that {{field-2}}.\n\n$\\,$ Line $\\text{L8}$ follows from $\\text{L7}$ by the fact that {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L3}$ and $\\text{L4}.$ Starting from $\\text{L3},$\n\n$$\nx(t)={e}^{At}\\,c,\n$$\n\nwe evaluate both sides at $t={t}_{0}$ to obtain\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nwhich is line $\\text{L4}.$ Therefore, $\\text{L4}$ follows from $\\text{L3}$ $\\text{by substituting }t={t}_{0}.$\n\n- Next, we consider lines $\\text{L5}$ and $\\text{L6}.$ Line $\\text{L5}$ gives\n\n$$\n({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c.\n$$\n\nSince $({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}={I}_{n}$, the right-hand side simplifies to $c$, so\n\n$$\nc=({e}^{A{t}_{0}})^{-1}x({t}_{0}).\n$$\n\nSimplify once, then apply $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}$, to obtain\n\n$$\nc={e}^{-A{t}_{0}}x({t}_{0}),\n$$\n\nwhich is line $\\text{L6}.$ Therefore, $\\text{L6}$ follows from $\\text{L5}$ by the fact that $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}.$\n\n- Finally, we consider lines $\\text{L7}$ and $\\text{L8}.$ Since $At$ and $-A{t}_{0}$ commute, we can use the property \n\n$$\n{e}^{At}{e}^{-A{t}_{0}}={e}^{At-A{t}_{0}}.\n$$\n\nSubstituting this into line $\\text{L7},$ we get line $\\text{L8}:$\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}) \\\\  & ={e}^{At-A{t}_{0}}x({t}_{0})\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ follows from $\\text{L7}$ by the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}\\text{ when }X\\text{ and }Y\\text{ commute}.$"} {:db/id #edb/ref 17592186311799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c10678d-ea1c-5753-a002-7d3da1975dcc" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X+Y}={e}^{X}{e}^{Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186309586} {:answer/id #uuid "90ad6ae4-a553-58bc-b272-f98ed3e31adb" :answer/type {:db/ident :answer.type/text} :answer/value "$At-A{t}_{0}=A(t-{t}_{0})$ for any $t$ and ${t}_{0}$" :db/id #edb/ref 17592186309902} {:answer/id #uuid "b58bbb99-cc83-5868-a0c5-26e1b9107a5b" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{At-A{t}_{0}}={e}^{A({t}_{0}-t)}" :db/id #edb/ref 17592186310214}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$At-A{t}_{0}=A(t-{t}_{0})$ for any $t$ and ${t}_{0}$" :db/id #edb/ref 17592186309902} :answer-field/id #uuid "3c8abd8e-2cb4-528f-910f-8084cbb01963" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186310956} {:answer-field/choices [{:answer/id #uuid "85bef546-5a62-56ed-bb85-0fd102752bba" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating $x(t)={e}^{At}c$ at $t=0$ and solving for $c$" :db/id #edb/ref 17592186309790} {:answer/id #uuid "a452bc96-b859-51d2-9256-43d8cd328bad" :answer/type {:db/ident :answer.type/text} :answer/value "substituting $c={e}^{-A{t}_{0}}x({t}_{0})$ into $x(t)={e}^{At}c$" :db/id #edb/ref 17592186310072} {:answer/id #uuid "f328baca-a930-5570-87ca-5a80e6bb6e2e" :answer/type {:db/ident :answer.type/text} :answer/value "left-multiplying $x(t)={e}^{At}c$ by ${e}^{-At}$" :db/id #edb/ref 17592186310681}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "substituting $c={e}^{-A{t}_{0}}x({t}_{0})$ into $x(t)={e}^{At}c$" :db/id #edb/ref 17592186310072} :answer-field/id #uuid "6c2f6706-81ee-5fcc-bb93-4c9b6959d24d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311078} {:answer-field/choices [{:answer/id #uuid "3eab9087-5eee-59f0-af43-5409757d2819" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}" :db/id #edb/ref 17592186309222} {:answer/id #uuid "6f0296a0-5439-5f40-bcc5-ae8cee530ca2" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}={e}^{A{t}_{0}}I" :db/id #edb/ref 17592186309605} {:answer/id #uuid "e1639ec6-affe-59bc-919d-5618f77a8a4d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{A{t}_{0}}{e}^{-A{t}_{0}}=I{e}^{-A{t}_{0}}" :db/id #edb/ref 17592186310551}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}" :db/id #edb/ref 17592186309222} :answer-field/id #uuid "f6229399-e20b-5c05-a9b4-229ca7ba1cb9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311510}] :question/id #uuid "0ff7b45c-b6c0-5a02-9a69-d827819f7539" :question/math-academy-id "q-337115" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(t)={e}^{At}\\,c$ \n\n$\\text{L4}:\\,$ $x({t}_{0})={e}^{A{t}_{0}}\\,c$\n\n$\\text{L5}:\\,$ $({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c$\n\n$\\text{L6}:\\,$ $c={e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L7}:\\,$ $x(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L8}:\\,$ $x(t)={e}^{At-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})\\,$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L6}$ follows from $\\text{L5}$ by the fact that {{field-1}}.\n\n$\\,$ Line $\\text{L7}$ can be obtained by {{field-2}}.\n\n$\\,$ Line $\\text{L9}$ follows from $\\text{L8}$ by the fact that {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L5}$ and $\\text{L6}.$ Line $\\text{L5}$ gives\n\n$$\n({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c.\n$$\n\nSince $({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}={I}_{n}$, the right-hand side simplifies to $c$, so\n\n$$\nc=({e}^{A{t}_{0}})^{-1}x({t}_{0}).\n$$\n\nSimplify once, then apply $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}$, to obtain\n\n$$\nc={e}^{-A{t}_{0}}x({t}_{0}),\n$$\n\nwhich is line $\\text{L6}.$ Therefore, $\\text{L6}$ follows from $\\text{L5}$ by the fact that $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}.$\n\n- Next, we consider line $\\text{L7}.$ Using line $\\text{L3}$ we have\n\n$$\nx(t)={e}^{At}\\,c.\n$$\n\nFrom line $\\text{L6}$, we know that $c={e}^{-A{t}_{0}}x({t}_{0}).$ Substituting this expression for $c$ into the formula for $x(t)$ gives\n\n$$\nx(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}),\n$$\n\nwhich is line $\\text{L7}.$ Thus, line $\\text{L7}$ can be obtained by $\\text{substituting }c={e}^{-A{t}_{0}}x({t}_{0})\\text{ into }x(t)={e}^{At}c.$\n\n- Finally, we consider lines $\\text{L8}$ and $\\text{L9}.$ Starting from $\\text{L8},$\n\n$$\nx(t)={e}^{At-A{t}_{0}}x({t}_{0}),\n$$\n\nwe rewrite the exponent using the algebraic identity $At-A{t}_{0}=A(t-{t}_{0})$ to get\n\n$$\nx(t)={e}^{A(t-{t}_{0})}x({t}_{0}),\n$$\n\nwhich is line $\\text{L9}.$ Thus, $\\text{L9}$ follows from $\\text{L8}$ by the fact that $At-A{t}_{0}=A(t-{t}_{0})\\text{ for any }t\\text{ and }{t}_{0}.$"} {:db/id #edb/ref 17592186372710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d581ab-eac2-55b5-888d-deaf7a002aed" :answer/type {:db/ident :answer.type/text} :answer/value "using properties of $det({Φ}_{0}(0))$" :db/id #edb/ref 17592186372712} {:answer/id #uuid "813ef154-d604-561e-b48e-0b35325f3927" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186372713} {:answer/id #uuid "fdaf11ea-4164-580f-829e-d2abaeceb857" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186372714} {:answer/id #uuid "80ab58cb-932a-566d-b586-c196589d930b" :answer/type {:db/ident :answer.type/text} :answer/value "replacing ${Φ}_{0}(0)$ with ${I}_{n}$ in $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186372715}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "replacing ${Φ}_{0}(0)$ with ${I}_{n}$ in $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186372715} :answer-field/id #uuid "b4499e16-aabb-5cb2-a67c-ad7557ae05f6" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372711} {:answer-field/choices [{:answer/id #uuid "853ace54-49de-53c0-82ed-cfb835e09e51" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186372717} {:answer/id #uuid "906f3949-ca05-5f13-8b47-f3dce789277e" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186372718} {:answer/id #uuid "9c8541f4-adab-5b02-9915-46d4efed7ca7" :answer/type {:db/ident :answer.type/text} :answer/value "using diagonalization of ${Φ}_{0}(t)$" :db/id #edb/ref 17592186372719} {:answer/id #uuid "167e465a-c594-58b2-a782-69d90ccc3a9f" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating the equation" :db/id #edb/ref 17592186372720}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186372717} :answer-field/id #uuid "e0cfc463-a00c-5a02-b25e-b6454e6a70ed" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372716} {:answer-field/choices [{:answer/id #uuid "484d762f-5acf-5df4-8df4-94cc90a1d4fe" :answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186372722} {:answer/id #uuid "b3e78e24-6079-5e65-a2d8-6a25635330b1" :answer/type {:db/ident :answer.type/text} :answer/value "definition of a solution curve" :db/id #edb/ref 17592186372723} {:answer/id #uuid "8ddac18e-8996-5267-a9f1-7a3b6bca18c6" :answer/type {:db/ident :answer.type/text} :answer/value "properties of the determinant" :db/id #edb/ref 17592186372724} {:answer/id #uuid "12142844-889a-5ee2-b9bb-a31bbc51020a" :answer/type {:db/ident :answer.type/text} :answer/value "definition of matrix multiplication" :db/id #edb/ref 17592186372725}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "properties of a fundamental matrix" :db/id #edb/ref 17592186372722} :answer-field/id #uuid "3dea9463-8880-5a50-ac39-82e4de0d8f50" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186372721}] :question/id #uuid "da2b3537-4a89-5afc-8ad7-721d1c3c30a3" :question/math-academy-id "q-336480" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(0)={Φ}_{0}(0)\\,c$\n\n$\\text{L4}:\\,$ ${Φ}_{0}(0)={I}_{n}$\n\n$\\text{L5}:\\,$ $x(0)=c$\n\n$\\text{L6}:\\,$ $x(t)={e}^{At}\\,x(0)$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by the \n{{field-1}}.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by \n{{field-2}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by \n{{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Since ${Φ}_{0}(t)={e}^{At}$ is a fundamental matrix for the system, any solution of the system can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,c.\n$$\n\nThus, $\\text{L2}$ follows from $\\text{L1}$ by the $\\text{properties of a fundamental matrix}.$\n\n- Next, we consider lines $\\text{L2}$ and $\\text{L3}.$ From $\\text{L2}$ we have\n\n$$\nx(t)={Φ}_{0}(t)\\,c.\n$$\n\nEvaluating this identity at $t=0$ gives\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nwhich is precisely line $\\text{L3}.$ Thus, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{evaluating both sides at }t=0.$\n\n- Finally, we consider lines $\\text{L3}$, $\\text{L4},$ and $\\text{L5}.$ From $\\text{L3}$ we know\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nand from $\\text{L4}$ we know ${Φ}_{0}(0)={I}_{n}.$ Replacing ${Φ}_{0}(0)$ with ${I}_{n}$ in the equation $x(0)={Φ}_{0}(0)c$ gives\n\n$$\nx(0)={I}_{n}c=c,\n$$\n\nwhich is line $\\text{L5}.$ Therefore, $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by $\\text{replacing }{Φ}_{0}(0)\\text{ with }{I}_{n}\\text{ in }x(0)={Φ}_{0}(0)c.$"} {:db/id #edb/ref 17592186396936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "614d6ab5-5628-5fbe-818a-c13fdda2c28e" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L2}$" :db/id #edb/ref 17592186396938} {:answer/id #uuid "ce094f55-879b-5b96-bedb-c8a97168bac2" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186396939} {:answer/id #uuid "cccff4fe-20c3-5cb7-9681-92cc25121511" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L3}$ and $\\text{L4}$" :db/id #edb/ref 17592186396940} {:answer/id #uuid "ab84e7ed-d6a8-520d-8b8d-917218916f48" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L3}$" :db/id #edb/ref 17592186396941}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$\\text{L1}$ and $\\text{L5}$" :db/id #edb/ref 17592186396939} :answer-field/id #uuid "62e5d724-e4aa-50ec-8d98-2ca352e011f4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396937} {:answer-field/choices [{:answer/id #uuid "3461c8f3-6347-5cda-a1c7-cd2ab24c6c21" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186396943} {:answer/id #uuid "41161c5d-5b28-5637-adb6-191d50f983ea" :answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186396944} {:answer/id #uuid "411ea3ea-3c55-50ae-abd5-5130b8a1d446" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186396945} {:answer/id #uuid "a18ae187-4ca1-50ee-ba3f-d6af9219c439" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating the equation" :db/id #edb/ref 17592186396946}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186396944} :answer-field/id #uuid "d10c4b52-29cf-597a-97d0-5df761b842ca" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396942} {:answer-field/choices [{:answer/id #uuid "5363f0a4-bc32-5773-a19c-82bd214aee7c" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186396948} {:answer/id #uuid "83b75a12-331a-52aa-8a26-b868726772a6" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186396949} {:answer/id #uuid "9f3f9f52-0d94-5534-85e6-03b3ff052905" :answer/type {:db/ident :answer.type/text} :answer/value "using diagonalization of ${Φ}_{0}(t)$" :db/id #edb/ref 17592186396950} {:answer/id #uuid "c4e0fc6c-fed0-5c5b-bab5-4daeb2418d61" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating the equation" :db/id #edb/ref 17592186396951}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186396948} :answer-field/id #uuid "b441f599-459e-58bd-b0d0-12769ed6a804" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396947}] :question/id #uuid "b476f440-04ac-55c0-bbfe-8012f8f71f27" :question/math-academy-id "q-336477" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$  \n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$  \n\n$\\text{L3}:\\,$ $x(0)={Φ}_{0}(0)\\,c$  \n\n$\\text{L4}:\\,$ ${Φ}_{0}(0)={I}_{n}$\n\n$\\text{L5}:\\,$ $x(0)=c$  \n\n$\\text{L6}:\\,$ $x(t)={e}^{At}\\,x(0)$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by {{field-1}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by  {{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L2}$ by substitution from lines {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L2}$ and $\\text{L3}.$ Starting from $\\text{L2},$ we have the identity\n\n$$\nx(t)={Φ}_{0}(t)\\,c.\n$$\n\nEvaluating this identity at $t=0$ gives\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nwhich is exactly line $\\text{L3}.$ Therefore, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{evaluating both sides at }t=0.$\n\n- Next, we consider lines $\\text{L3}$, $\\text{L4},$ and $\\text{L5}.$ From $\\text{L3}$ we have\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nand from $\\text{L4}$ we know ${Φ}_{0}(0)={I}_{n}.$ Substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$ gives\n\n$$\nx(0)={I}_{n}c=c,\n$$\n\nwhich is exactly line $\\text{L5}.$ Thus, $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by $\\text{substituting }{Φ}_{0}(0)={I}_{n}\\text{ into }x(0)={Φ}_{0}(0)c.$\n\n- Finally, we consider lines $\\text{L1}$, $\\text{L2},$ $\\text{L5},$ and $\\text{L6}.$ From $\\text{L1}$ we have ${Φ}_{0}(t)={e}^{At},$ and from $\\text{L5}$ we know $c=x(0).$ Substituting ${Φ}_{0}(t)={e}^{At}$ from $\\text{L1}$ and $c=x(0)$ from $\\text{L5}$ into $x(t)={Φ}_{0}(t)\\,c$ (line $\\text{L2}$), we obtain\n\n$$\nx(t)={e}^{At}\\,x(0).\n$$\n\nThus, $\\text{L6}$ follows from $\\text{L2}$ and substitution from $\\text{L1}\\text{ and }\\text{L5}.$"} {:db/id #edb/ref 17592186396993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e051ba-0925-5595-906b-3d9455a124a6" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating $x(t)={e}^{At}c$ at $t={t}_{0}$ and solving for $c$" :db/id #edb/ref 17592186396995} {:answer/id #uuid "d66a48e9-3064-577b-a301-18a4163c2103" :answer/type {:db/ident :answer.type/text} :answer/value "left-multiplying $x(t)={e}^{At}c$ by ${e}^{-At}$" :db/id #edb/ref 17592186396996} {:answer/id #uuid "6d7095a3-cb4a-563f-95e4-6050e0d49c1c" :answer/type {:db/ident :answer.type/text} :answer/value "substituting $c={e}^{-A{t}_{0}}x({t}_{0})$ into $x(t)={e}^{At}c$" :db/id #edb/ref 17592186396997}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "substituting $c={e}^{-A{t}_{0}}x({t}_{0})$ into $x(t)={e}^{At}c$" :db/id #edb/ref 17592186396997} :answer-field/id #uuid "4034d58e-9aa0-5353-8a0b-15f70b5c05f7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396994} {:answer-field/choices [{:answer/id #uuid "3edeee75-ae1a-5118-aee9-95210f022f7d" :answer/type {:db/ident :answer.type/text} :answer/value "integrating $x(t)$" :db/id #edb/ref 17592186396999} {:answer/id #uuid "c912b961-6fae-5a81-9c28-18263ad2be59" :answer/type {:db/ident :answer.type/text} :answer/value "using the identity $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}$" :db/id #edb/ref 17592186397000} {:answer/id #uuid "f7ef72cb-85ae-57ec-9183-3da0d974a189" :answer/type {:db/ident :answer.type/text} :answer/value "multiplying both sides on the left by $({e}^{A{t}_{0}})^{-1}$" :db/id #edb/ref 17592186397001}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "multiplying both sides on the left by $({e}^{A{t}_{0}})^{-1}$" :db/id #edb/ref 17592186397001} :answer-field/id #uuid "93f0bbfe-0cb3-5b50-90de-16b15a59b4bb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396998} {:answer-field/choices [{:answer/id #uuid "875b1271-178f-5292-86cb-7fb9f34b060b" :answer/type {:db/ident :answer.type/text} :answer/value "the identity ${e}^{X}{e}^{Y}={e}^{XY}$ for matrices" :db/id #edb/ref 17592186397003} {:answer/id #uuid "ae842823-c28d-5956-a3bf-e70e9276c908" :answer/type {:db/ident :answer.type/text} :answer/value "the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186397004} {:answer/id #uuid "42e3fb46-f61a-5833-95f6-27c46792783b" :answer/type {:db/ident :answer.type/text} :answer/value "the fact that $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}$" :db/id #edb/ref 17592186397005}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186397004} :answer-field/id #uuid "ac58334b-08c3-5e97-99f4-3dd187516d7b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397002}] :question/id #uuid "0d9118b1-b0ff-5db4-a05c-ec3ad938a6f1" :question/math-academy-id "q-337121" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(t)={e}^{At}\\,c$ \n\n$\\text{L4}:\\,$ $x({t}_{0})={e}^{A{t}_{0}}\\,c$\n\n$\\text{L5}:\\,$ $({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c$\n\n$\\text{L6}:\\,$ $c={e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L7}:\\,$ $x(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L8}:\\,$ $x(t)={e}^{At-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})\\,$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L5}$ follows from $\\text{L4}$ by {{field-1}}.\n\n$\\,$ Line $\\text{L7}$ can be obtained by {{field-2}}.\n\n$\\,$ Line $\\text{L8}$ follows from $\\text{L7}$ by {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L4}$ and $\\text{L5}.$ Starting from $\\text{L4},$\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nwe multiply both sides on the left by $({e}^{A{t}_{0}})^{-1}$ to get\n\n$$\n({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c,\n$$\n\nwhich is line $\\text{L5}.$ Therefore, $\\text{L5}$ follows from $\\text{L4}$ by $\\text{multiplying both sides on the left by }({e}^{A{t}_{0}})^{-1}.$\n\n- Next, we consider line $\\text{L7}.$ Using line $\\text{L3}$ we have\n\n$$\nx(t)={e}^{At}\\,c.\n$$\n\nFrom line $\\text{L6}$, we know that $c={e}^{-A{t}_{0}}x({t}_{0}).$ Substituting this expression for $c$ into the formula for $x(t)$ gives\n\n$$\nx(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}),\n$$\n\nwhich is line $\\text{L7}.$ Thus, line $\\text{L7}$ can be obtained by $\\text{substituting }c={e}^{-A{t}_{0}}x({t}_{0})\\text{ into }x(t)={e}^{At}c.$\n\n- Finally, we consider lines $\\text{L7}$ and $\\text{L8}.$ Since $At$ and $-A{t}_{0}$ commute, we can use the property \n\n$$\n{e}^{At}{e}^{-A{t}_{0}}={e}^{At-A{t}_{0}}.\n$$\n\nSubstituting this into line $\\text{L7},$ we get line $\\text{L8}:$\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}) \\\\  & ={e}^{At-A{t}_{0}}x({t}_{0})\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ follows from $\\text{L7}$ by the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}\\text{ when }X\\text{ and }Y\\text{ commute}.$"} {:db/id #edb/ref 17592186445612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43014d39-1648-53c0-98f9-6f05e38e18a4" :answer/type {:db/ident :answer.type/text} :answer/value "using the initial condition ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186445552} {:answer/id #uuid "5d439ffd-235d-5190-afa9-6f42b5a7e416" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating ${Φ}_{0}(t)$ at $t=1$" :db/id #edb/ref 17592186445557} {:answer/id #uuid "7dc33b5b-9408-5fb8-bf5c-83ed155633e9" :answer/type {:db/ident :answer.type/text} :answer/value "computing $det({Φ}_{0}(0))$" :db/id #edb/ref 17592186445566} {:answer/id #uuid "96649198-7452-5be0-ae5e-0a3008e15623" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule to ${Φ}_{0}(0)$" :db/id #edb/ref 17592186445575}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "using the initial condition ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186445552} :answer-field/id #uuid "03707618-f14e-58a8-b61e-58402bebc2e4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186445595} {:answer-field/choices [{:answer/id #uuid "1b04e893-cceb-50bf-a491-02560d0862d0" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186445546} {:answer/id #uuid "9082d977-8d12-5228-84ba-cc66ffcea7a5" :answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186445573} {:answer/id #uuid "c2342d48-70e2-5f9a-b3c0-ddfbb51fdb76" :answer/type {:db/ident :answer.type/text} :answer/value "using properties of the determinant of ${Φ}_{0}(0)$" :db/id #edb/ref 17592186445582} {:answer/id #uuid "f4e2f159-86ae-5268-99e0-e7a4a0d1cdfe" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186445591}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$" :db/id #edb/ref 17592186445573} :answer-field/id #uuid "4c50b68d-36e9-56fe-9509-8e8268c5ac1d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186445599} {:answer-field/choices [{:answer/id #uuid "0647c748-1350-542c-8a31-93d7ececc1bc" :answer/type {:db/ident :answer.type/text} :answer/value "applying the chain rule" :db/id #edb/ref 17592186445538} {:answer/id #uuid "1cf56d58-b6f6-5c5c-989c-1c0fbc7bb246" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating the equation" :db/id #edb/ref 17592186445547} {:answer/id #uuid "7899655e-1ee1-53b3-87a5-419fdc4b4532" :answer/type {:db/ident :answer.type/text} :answer/value "using diagonalization of ${Φ}_{0}(t)$" :db/id #edb/ref 17592186445563} {:answer/id #uuid "9b37cc40-53e5-5370-b34f-ab2f2e92d9ce" :answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186445576}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "evaluating both sides at $t=0$" :db/id #edb/ref 17592186445576} :answer-field/id #uuid "6d4c70b5-34be-574c-b5b7-72ba11d43aed" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186445601}] :question/id #uuid "7ee364d4-3865-58d1-b13b-994e56af1ccf" :question/math-academy-id "q-336478" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$  \n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$  \n\n$\\text{L3}:\\,$ $x(0)={Φ}_{0}(0)\\,c$  \n\n$\\text{L4}:\\,$ ${Φ}_{0}(0)={I}_{n}$\n\n$\\text{L5}:\\,$ $x(0)=c$  \n\n$\\text{L6}:\\,$ $x(t)={e}^{At}\\,x(0)$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from the definition of ${Φ}_{0}(t)$ as the standard fundamental matrix by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by  \n{{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L2}$ and $\\text{L3}.$ Starting from\n\n$$\nx(t)={Φ}_{0}(t)\\,c,\n$$\n\nwe evaluate both sides at $t=0$ to obtain\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nwhich is line $\\text{L3}.$ Therefore, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{evaluating both sides at }t=0.$\n\n- Next, we consider line $\\text{L4}.$ By definition, the standard fundamental matrix ${Φ}_{0}(t)$ satisfies the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nThe second condition here is exactly line $\\text{L4},$ so $\\text{L4}$ follows from the definition of ${Φ}_{0}(t)$ as the standard fundamental matrix by $\\text{using the initial condition }{Φ}_{0}(0)={I}_{n}.$\n\n- Finally, we consider lines $\\text{L3}$, $\\text{L4},$ and $\\text{L5}.$ From $\\text{L3}$ we know\n\n$$\nx(0)={Φ}_{0}(0)c,\n$$\n\nand from $\\text{L4}$ we have ${Φ}_{0}(0)={I}_{n}.$ Substituting ${Φ}_{0}(0)={I}_{n}$ into $x(0)={Φ}_{0}(0)c$ gives\n\n$$\nx(0)={I}_{n}c=c,\n$$\n\nwhich is exactly line $\\text{L5}.$ Thus, $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by $\\text{substituting }{Φ}_{0}(0)={I}_{n}\\text{ into }x(0)={Φ}_{0}(0)c.$"} {:db/id #edb/ref 17592186445614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e50b50b-4373-51d9-9375-66dc09625989" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{At-A{t}_{0}}={e}^{A({t}_{0}-t)}" :db/id #edb/ref 17592186445555} {:answer/id #uuid "6d7f021d-b3da-5a02-86e5-d09f4c81daf5" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{X+Y}={e}^{X}{e}^{Y}$ when $X$ and $Y$ commute" :db/id #edb/ref 17592186445562} {:answer/id #uuid "e2583d7c-7080-546c-bdfe-f2917811399f" :answer/type {:db/ident :answer.type/text} :answer/value "$At-A{t}_{0}=A(t-{t}_{0})$ for any $t$ and ${t}_{0}$" :db/id #edb/ref 17592186445589}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$At-A{t}_{0}=A(t-{t}_{0})$ for any $t$ and ${t}_{0}$" :db/id #edb/ref 17592186445589} :answer-field/id #uuid "4d6550ee-0193-5d90-88b0-0547b0f74454" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186445600} {:answer-field/choices [{:answer/id #uuid "1736138c-0166-5a19-97d1-c2e44c954bbc" :answer/type {:db/ident :answer.type/text} :answer/value "using the initial condition ${Φ}_{0}(0)={I}_{n}$" :db/id #edb/ref 17592186445544} {:answer/id #uuid "392f89bd-3ea4-5013-8e2f-76a63e1ac26e" :answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(t)={e}^{At}$ into $x(t)={Φ}_{0}(t)c$" :db/id #edb/ref 17592186445551} {:answer/id #uuid "51b7dfa5-769d-5b7a-b02a-8fd1f441048e" :answer/type {:db/ident :answer.type/text} :answer/value "left-multiplying $x(t)={Φ}_{0}(t)c$ by ${e}^{-At}$" :db/id #edb/ref 17592186445556}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "substituting ${Φ}_{0}(t)={e}^{At}$ into $x(t)={Φ}_{0}(t)c$" :db/id #edb/ref 17592186445551} :answer-field/id #uuid "7bf6