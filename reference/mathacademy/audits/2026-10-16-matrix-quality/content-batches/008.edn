atrix}\\operatorname{cos}⁡(6t) & -\\operatorname{sin}⁡(6t) \\\\ \\operatorname{sin}⁡(6t) & \\operatorname{cos}⁡(6t)\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\,-2\\operatorname{cos}⁡(6t)-3\\operatorname{sin}⁡(6t)\\, \\\\ \\,-2\\operatorname{sin}⁡(6t)+3\\operatorname{cos}⁡(6t)\\,\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186372703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "911a0b91-8cfc-5c90-8612-d186b86260d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4\\operatorname{sinh}⁡(4t) \\\\ 2\\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372705} {:answer/id #uuid "ca7b866a-6af6-5c53-8767-9d73d4a5a6dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{sinh}⁡(4t) \\\\ 2\\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372706} {:answer/id #uuid "f59f7b97-72d7-544d-92fb-affc25bc255f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\operatorname{sinh}⁡(4t) \\\\ 2\\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372707} {:answer/id #uuid "fba88690-6a3e-517e-b451-20f63869feb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372708} {:answer/id #uuid "a1e0b67b-92e9-576c-93cc-05727469679d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{sinh}⁡(4t) \\\\ -2\\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372709}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\operatorname{sinh}⁡(4t) \\\\ 2\\operatorname{cosh}⁡(4t)\\end{bmatrix}" :db/id #edb/ref 17592186372706} :answer-field/id #uuid "1879bd9d-054e-59da-ab7b-0aabcf601f7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372704}] :question/id #uuid "981edc7d-4bd0-566a-a596-3fb1014b4ef7" :question/math-academy-id "q-335264" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=4y(t) \\\\ {y}^{′}(t) &=4x(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}.$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix}\\begin{bmatrix}0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\operatorname{sinh}⁡(4t) \\\\ 2\\operatorname{cosh}⁡(4t)\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c29a2cd-62e5-5fd1-b667-d19225a99baf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6t{e}^{-4t} \\\\ 6{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445540} {:answer/id #uuid "1257957d-95b6-5055-a729-5afb261e9b26" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6{e}^{4t} \\\\ 6t{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445542} {:answer/id #uuid "31974140-1be7-54e7-846e-6155661b2373" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6t{e}^{4t} \\\\ -6{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445550} {:answer/id #uuid "d83c7199-3871-536a-9c4a-4a138d67aa0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6t{e}^{4t} \\\\ 6{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445585} {:answer/id #uuid "df7f4077-547c-5e6b-bc2c-f1c3a3ef567a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6t{e}^{4t} \\\\ 6{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445586}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6t{e}^{4t} \\\\ 6{e}^{4t}\\end{bmatrix}" :db/id #edb/ref 17592186445585} :answer-field/id #uuid "0dd78d2a-f5d6-5fd4-9c13-2afeb7726bac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445596}] :question/id #uuid "32d4b06d-f6f3-5351-bf77-6d5871dae39c" :question/math-academy-id "q-335272" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=4x(t)+y(t) \\\\ {y}^{′}(t) &=4y(t),\\end{aligned}\\right.\\,\\begin{bmatrix}x(0) \\\\ y(0)\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 6\\end{bmatrix}\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{bmatrix},$ where $A=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}.$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}x(t),\n$$\n\nwhere $x(t)=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}.$ So, the matrix of the system is $A=\\begin{bmatrix}4 & 1 \\\\ 0 & 4\\end{bmatrix}.$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=\\begin{bmatrix}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{bmatrix}.\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =\\begin{bmatrix}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}6t{e}^{4t} \\\\ 6{e}^{4t}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69276adb-677d-540b-9c54-620001dfc0b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5t{e}^{8t} \\\\ -5{e}^{8t}\\end{bmatrix}" :db/id #edb/ref 17592186445561} {:answer/id #uuid "8e12ee1e-b54d-50f2-a7f6-f656ed11b47f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5t{e}^{-8t} \\\\ 5{e}^{8t}\\end{bmatrix}" :db/id #edb/ref 17592186445572} {:answer/id #uuid "921d6f51-37ef-5306-bec1-770d7c73aece" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5t{e}^{8t} \\\\ 5{e}^{8t}\\end{bmatrix}" :db/id #edb/ref 17592186445574} {:answer/id #uuid "c1cb6916-c468-5554-817c-94ec4d9c89f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5t{e}^{8t} \\\\ 5{e}^{8t}\\end{bmatrix}" :db/id #edb/ref 17592186445581} {:answer/id #uuid "ff1812de-948c-526d-be20-f4e594d8b388" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5{e}^{8t} \\\\ 5t{e}^{8t}\\end{bmatrix}" :db/id #edb/ref 17592186445594}] :answer-f