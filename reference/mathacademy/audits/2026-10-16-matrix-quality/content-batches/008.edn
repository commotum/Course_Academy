\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1+2\\text{i} & -3-3\\text{i} \\\\ 12+\\text{i} & -12-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6cd48df-2f97-5712-a9cd-2424a7316741" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24-20\\text{i} \\\\ 10+51\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388669} {:answer/id #uuid "95fc9e31-78de-5a72-ba67-037ef90ef4dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-17-45\\text{i} \\\\ 16-23\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388670} {:answer/id #uuid "8b3a3835-35cc-5fe7-ac87-d525b00ee3bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16-23\\text{i} \\\\ -17-45\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388671} {:answer/id #uuid "beb3530a-0d39-56a5-ac25-c46cb61ecd03" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10+51\\text{i} \\\\ 24-20\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388672} {:answer/id #uuid "7a4b1e6f-57a2-55e5-8684-2d11faa44fa6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16-27\\text{i} \\\\ 23-35\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388673}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16-23\\text{i} \\\\ -17-45\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186388671} :answer-field/id #uuid "0d0b94a0-5040-59ed-89cb-a0fb40b434bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388668}] :question/id #uuid "eed0301f-d83a-548c-89d9-f113ce59919b" :question/math-academy-id "q-140329" :question/problem "If $\\,A=\\begin{bmatrix}-3+5\\text{i} & 4-3\\text{i} \\\\ -4\\text{i} & 5-5\\text{i}\\end{bmatrix}\\,$ and $\\,x=\\begin{bmatrix}-3\\text{i} \\\\ 4-5\\text{i}\\end{bmatrix}\\,$, then $\\,Ax=$" :question/worked-solution "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =\\begin{bmatrix}-3+5\\text{i} & 4-3\\text{i} \\\\ -4\\text{i} & 5-5\\text{i}\\end{bmatrix}\\cdot \\begin{bmatrix}-3\\text{i} \\\\ 4-5\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-3+5\\text{i})(-3\\text{i})+(4-3\\text{i})(4-5\\text{i}) \\\\ (-4\\text{i})(-3\\text{i})+(5-5\\text{i})(4-5\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}(15+9\\text{i})+(1-32\\text{i}) \\\\ (-12)+(-5-45\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}16-23\\text{i} \\\\ -17-45\\text{i}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c5bfcf-f18d-59e1-a9c7-3d228f60eaf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4-\\text{i} & 3+12\\text{i} \\\\ 2+4\\text{i} & 4+\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392261} {:answer/id #uuid "cf089755-1d10-500b-a0a2-551f3bc3019b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4-\\text{i} & 3+12\\text{i} \\\\ 2+4\\text{i} & 4+\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392262} {:answer/id #uuid "a3e63d90-d955-5848-a2e2-a18e3e4f0166" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4+\\text{i} & -3-12\\text{i} \\\\ -2-4\\text{i} & -4-\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392263} {:answer/id #uuid "a9746754-47aa-55a4-a6fd-ff02ba352d82" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4-\\text{i} & 3+12\\text{i} \\\\ 4+2\\text{i} & 1+\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392264} {:answer/id #uuid "e8b99d12-86e4-57b5-bce0-9cfb8912ad79" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\text{i} & 12\\text{i} \\\\ 2+4\\text{i} & 4+\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392265}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4-\\text{i} & 3+12\\text{i} \\\\ 2+4\\text{i} & 4+\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186392262} :answer-field/id #uuid "7064abf3-62e0-5e1b-afc9-1e54dab5330e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392260}] :question/id #uuid "469cfb30-4bd8-5f24-a8af-f1faf991da16" :question/math-academy-id "q-39021" :question/problem "If $\\,A=\\begin{bmatrix}1 & 5-\\text{i} \\\\ \\text{i} & -3\\text{i}\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}1-2\\text{i} & 1+2\\text{i} \\\\ -1 & 2\\text{i}\\end{bmatrix}\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & 5-\\text{i} \\\\ \\text{i} & -3\\text{i}\\end{bmatrix}\\cdot \\begin{bmatrix}1-2\\text{i} & 1+2\\text{i} \\\\ -1 & 2\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(1)(1-2\\text{i})+(5-\\text{i})(-1) & (1)(1+2\\text{i})+(5-\\text{i})(2\\text{i}) \\\\ (\\text{i})(1-2\\text{i})+(-3\\text{i})(-1) & (\\text{i})(1+2\\text{i})+(-3\\text{i})(2\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}(1-2\\text{i})+(-5+\\text{i}) & (1+2\\text{i})+(2+10\\text{i}) \\\\ (2+\\text{i})+(3\\text{i}) & (-2+\\text{i})+(6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4-\\text{i} & 3+12\\text{i} \\\\ 2+4\\text{i} & 4+\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\n."} {:db/id #edb/ref 17592186393598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ddfb309-03f1-5086-b134-9a300a1e4991" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5+9\\text{i} & 9-13\\text{i} \\\\ 10+5\\text{i} & 14-3\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393600} {:answer/id #uuid "fde0ddb4-cac3-5fbb-b0e8-ee77e56d4d13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10+5\\text{i} & 14-3\\text{i} \\\\ -5+9\\text{i} & 9-13\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393601} {:answer/id #uuid "565144e9-65e3-5c8e-b095-b218ef949235" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5+9\\text{i} & 14-3\\text{i} \\\\ 10+5\\text{i} & 9-13\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393602} {:answer/id #uuid "d3ca5b76-d9a3-5bd3-96bd-948909e64409" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14-3\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 10+5\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393603} {:answer/id #uuid "73837f27-75b0-552d-920f-58cabd54c6a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393604}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{bmatrix}" :db/id #edb/ref 17592186393604} :answer-field/id #uuid "416179a7-3219-5ce9-9303-152f6654f152" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393599}] :question/id #uuid "eaa32e2e-c807-5da3-b10a-a7704147713e" :question/math-academy-id "q-76217" :question/problem "If $\\,A=\\begin{bmatrix}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{bmatrix}\\,$ and $\\,B=\\begin{bmatrix}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{bmatrix}\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{bmatrix}\\cdot \\begin{bmatrix}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{bmatrix} \\\\  & =\\begin{bmatrix}(2-3\\text{i})\\cdot 2\\text{i}+\\text{i}\\cdot (1-4\\text{i}) & (2-3\\text{i})\\cdot 5+\\text{i}\\cdot (2+\\text{i}) \\\\ 3\\cdot 2\\text{i}+(-1-\\text{i})(1-4\\text{i}) & 3\\cdot 5+(-1-\\text{i})(2+\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}(4\\text{i}+6)+(\\text{i}+4) & (10-15\\text{i})+(2\\text{i}-1) \\\\ 6\\text{i}+(-5+3\\text{i}) & 15+(-1-3\\text{i})\\end{bmatrix} \\\\  & =\\begin{bmatrix}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying Complex Matrices"} {:db/id #edb/ref 17592186129157 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128975 :question/id #uuid "e8bc731b-bb0b-5a07-89d9-6acc9beebc82" :question/math-academy-id "e-5903" :question/problem "Find $B=\\overline{A},$ where ![](images/25/25ce0cd375da320d1615cf49f659ec33e4646cf6bc66455198bec5fd591b3dd3.png) What is the value of $b_{11} + b_{23}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{\\begin{bmatrix}4\\text{i} & 3-\\text{i} & 1+\\text{i} \\\\ 2-2\\text{i} & 2-\\text{i} & 1+2\\text{i} \\\\ \\text{i} & 3\\text{i} & 2\\text{i}\\end{bmatrix}} \\\\  & =\\begin{bmatrix}\\overset{―}{4\\text{i}} & \\overset{―}{3-\\text{i}} & \\overset{―}{1+\\text{i}} \\\\ \\overset{―}{2-2\\text{i}} & \\overset{―}{2-\\text{i}} & \\overset{―}{1+2\\text{i}} \\\\ \\overset{―}{\\text{i}} & \\overset{―}{3\\text{i}} & \\overset{―}{2\\text{i}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4\\text{i} & 3+\\text{i} & 1-\\text{i} \\\\ 2+2\\text{i} & 2+\\text{i} & 1-2\\text{i} \\\\ -\\text{i} & -3\\text{i} & -2\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $b_{11} + b_{23} = (-4\\textrm{i}) + (1-2\\textrm{i}) = 1-6\\textrm{i}.$"} :knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946" :knowledge-point/questions [{:db/id #edb/ref 17592186129647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd3d183-28bf-5869-9834-59e24af73f93" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324208} {:answer/id #uuid "69a7136a-6102-5ce9-8008-cedab82b75c4" :answer/type {:db/ident :answer.type/math} :answer/value "8+7\\text{i}" :db/id #edb/ref 17592186324855} {:answer/id #uuid "79cf2cab-adbc-5c48-a8fc-47ba651018c9" :answer/type {:db/ident :answer.type/math} :answer/value "7+8\\text{i}" :db/id #edb/ref 17592186324988} {:answer/id #uuid "989a1737-d949-5b1a-b249-fc8739c19117" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325269} {:answer/id #uuid "b3d6c620-1040-5731-a625-00d13c2e34a8" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\text{i}" :db/id #edb/ref 17592186325516}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3+\\text{i}" :db/id #edb/ref 17592186325516} :answer-field/id #uuid "4301f901-1871-5194-a90d-2dbdb1a98d4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326334}] :question/id #uuid "595f33f1-2f99-5611-b72b-51846de49462" :question/math-academy-id "q-38395" :question/problem "Find $B=\\overset{―}{A}$, where $A=\\begin{bmatrix}2+4\\text{i} & 3-2\\text{i} \\\\ 3-3\\text{i} & 1-5\\text{i}\\end{bmatrix}.$ What is the value of ${b}_{11}+{b}_{22}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{\\begin{bmatrix}2+4\\text{i} & 3-2\\text{i} \\\\ 3-3\\text{i} & 1-5\\text{i}\\end{bmatrix}} \\\\  & =\\begin{bmatrix}\\overset{―}{2+4\\text{i}} & \\overset{―}{3-2\\text{i}} \\\\ \\overset{―}{3-3\\text{i}} & \\overset{―}{1-5\\text{i}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-4\\text{i} & 3+2\\text{i} \\\\ 3+3\\text{i} & 1+5\\text{i}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, ${b}_{11}+{b}_{22}=(2-4\\text{i})+(1+5\\text{i})=3+\\text{i}.$"} {:db/id #edb/ref 17592186129706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dcef86f-4a3f-56f2-ab24-3129e37a63cb" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\textrm{i}" :db/id #edb/ref 17592186127718} {:answer/id #uuid "a36379c0-22cb-5d80-ae24-2c36ea592c40" :answer/type {:db/ident :answer.type/math} :answer/value "1 + 3\\textrm{i}" :db/id #edb/ref 17592186127719} {:answer/id #uuid "1488dabf-7dd8-57b0-