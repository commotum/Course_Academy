frac{1}{4} & 1 & 0 \\\\ 0 & -8 & 0 & 1\\end{bmatrix}}^{-1}=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & -\\frac{1}{4} & 1 & 0 \\\\ 0 & 8 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Inverting a Frobenius Matrix"}] :topic/math-academy-id 42 :topic/title "Matrices With Easy-to-Find Inverses"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186120648} :activity/id #uuid "8734274c-15b6-589a-a77f-6fd025ab063a" :activity/steps [{:db/id #edb/ref 17592186120648 :step/content {:db/id #edb/ref 17592186121026 :tutorial/content "Cramer's rule applies to square systems of linear equations with any number of variables. In this lesson, we will practice applying Cramer's rule to solve $3 \\times 3$ systems of equations.\n\nSuppose we have a square system of linear equations\n\n$$\n\\{\\begin{aligned}{a}_{11}x+{a}_{12}y+{a}_{13}z={b}_{1} \\\\ {a}_{21}x+{a}_{22}y+{a}_{23}z={b}_{2} \\\\ {a}_{31}x+{a}_{32}y+{a}_{33}z={b}_{3},\\end{aligned}\n$$\n\nwhere ![](images/39/39c4a39573975acc249a4402799f40ef8d72666d4da03d6c4ed6cc299bc7fc52.svg). \nThen Cramer's rule states that\n\n$$\n\\left< x,y,z \\right> = \\left\\langle  \\dfrac{D_x}{D}, \\dfrac{D_y}{D}, \\dfrac{D_z}{D} \\right\\rangle\n$$\n\nis the unique solution of the system, where\n\n![](images/dc/dcda1374b4582e7978133bbf3cea0375b40095d353573f826a3bac7f212dfc03.svg)" :tutorial/id #uuid "f245bf99-3b45-5a27-9aca-aaee391628ed" :tutorial/math-academy-id 3079 :tutorial/title "Introduction"} :step/id #uuid "620dc976-5ed3-54d8-a37a-7483259c65bb" :step/next {:db/id #edb/ref 17592186120706}} {:db/id #edb/ref 17592186120649 :step/content {:db/id #edb/ref 17592186119789 :knowledge-point/id #uuid "71c540ac-3cb5-5e0e-9b7b-5e2ccf1615c5"} :step/id #uuid "c34a23fc-50c9-5fb1-b89d-0a53b98720ed" :step/next {:db/id #edb/ref 17592186120651}} {:db/id #edb/ref 17592186120651 :step/content {:db/id #edb/ref 17592186119791 :knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35"} :step/id #uuid "bd4aa514-64cb-5bde-8bf4-8e5364299dc3"} {:db/id #edb/ref 17592186120706 :step/content {:db/id #edb/ref 17592186121047 :tutorial/content "To demonstrate using Cramer's rule on a $3 \\times 3$ system, consider the following system of equations:\n\n$$\n\\{\\begin{aligned}4x+2y+z=9 \\\\ 2y+3z=7 \\\\ -8x+y+6z=0\\end{aligned}\n$$\n\nFirst, let's rewrite the system to reveal the coefficients:\n\n$$\n\\{\\begin{aligned}4x+2y+1z=9 \\\\ 0x+2y+3z=7 \\\\ -8x+1y+6z=0\\end{aligned}\n$$\n\nWe start finding the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}4 & 2 & 1 \\\\ 0 & 2 & 3 \\\\ -8 & 1 & 6\\end{aligned}| & =4\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 6\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 3 \\\\ -8 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ -8 & 1\\end{aligned}| \\\\  & =4(12-3)-2(0+24)+(0+16) \\\\  & =36-48+16 \\\\  & =4\\end{aligned}\n$$\n\nNow, let's find $D_x,$ $D_y,$ and $D_z.$\n\n- To find $D_x,$ we take the coefficients matrix, replace the *first* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}9 & 2 & 1 \\\\ 7 & 2 & 3 \\\\ 0 & 1 & 6\\end{aligned}| & =9\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 6\\end{aligned}|-2\\cdot |\\begin{aligned}7 & 3 \\\\ 0 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}7 & 2 \\\\ 0 & 1\\end{aligned}| \\\\  & =9(12-3)-2(42-0)+(7-0) \\\\  & =81-84+7 \\\\  & =4\\end{aligned}\n$$\n\n- To find $D_y,$ we take the coefficients matrix, replace the *second* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}4 & 9 & 1 \\\\ 0 & 7 & 3 \\\\ -8 & 0 & 6\\end{aligned}| & =4\\cdot |\\begin{aligned}7 & 3 \\\\ 0 & 6\\end{aligned}|-9\\cdot |\\begin{aligned}0 & 3 \\\\ -8 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 7 \\\\ -8 & 0\\end{aligned}| \\\\  & =4(42)-9(0+24)+(0+56) \\\\  & =168-216+56 \\\\  & =8\\end{aligned}\n$$\n\n- To find $D_z,$ we take the coefficients matrix, replace the *third* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}4 & 2 & 9 \\\\ 0 & 2 & 7 \\\\ -8 & 1 & 0\\end{aligned}| & =4\\cdot |\\begin{aligned}2 & 7 \\\\ 1 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 7 \\\\ -8 & 0\\end{aligned}|+9\\cdot |\\begin{aligned}0 & 2 \\\\ -8 & 1\\end{aligned}| \\\\  & =4(-7)-2(0+56)+9(0+16) \\\\  & =-28-112+144 \\\\  & =4\\end{aligned}\n$$\n\nFinally, the solution to the system is given by\n\n$$\n\\begin{aligned}⟨x,y,z⟩ & =⟨\\frac{{D}_{x}}{D},\\frac{{D}_{y}}{D},\\frac{{D}_{z}}{D}⟩ \\\\  & =⟨\\frac{4}{4},\\frac{8}{4},\\frac{4}{4}⟩ \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$" :tutorial/id #uuid "9d916943-4be4-554c-a4f5-51aef55e8254" :tutorial/math-academy-id 3241 :tutorial/title "A Demonstration of Cramer's Rule on a 3x3 Linear System"} :step/id #uuid "e9ce92e1-dc54-5375-b685-ec0fb5099a5c" :step/next {:db/id #edb/ref 17592186120745}} {:db/id #edb/ref 17592186120745 :step/content {:db/id #edb/ref 17592186119852 :knowledge-point/id #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a"} :step/id #uuid "d5e91e09-6b2c-5a23-a95e-c5b4f8576a52" :step/next {:db/id #edb/ref 17592186120649}}] :activity/title "Cramer’s Rule for 3x3 Systems" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186119998} {:activity/first-step {:db/id #edb/ref 17592186416307} :activity/id #uuid "71b4c62d-258c-5e6d-b466-361c4a8360c6" :activity/steps [{:db/id #edb/ref 17592186416306 :step/content {:db/id #edb/ref 17592186416305 :question/id #uuid "9a1ee2de-30e9-5dde-87e2-a6069fa7a03b"} :step/id #uuid "1d86e120-ea1d-5a4e-b49e-e1648f92cfdc"} {:db/id #edb/ref 17592186416307 :step/content {:db/id #edb/ref 17592186416302 :question/id #uuid "22790615-5765-50ce-b96c-1d82231be30c"} :step/id #uuid "21ebd4e5-a3bf-5e30-9a8d-944803219307" :step/next {:db/id #edb/ref 17592186416310}} {:db/id #edb/ref 17592186416308 :step/content {:db/id #edb/ref 17592186120459 :question/id #uuid "c8205961-c58e-5aea-a7e2-15eb2dd17972"} :step/id #uuid "3de30988-2509-57c4-b0bc-4b6cac063024" :step/next {:db/id #edb/ref 17592186416309}} {:db/id #edb/ref 17592186416309 :step/content {:db/id #edb/ref 17592186416303 :question/id #uuid "2a3030e8-5052-55cf-b8fe-d458398f5913"} :step/id #uuid "4748b1d1-3271-5818-be4b-23693a0b5577" :step/next {:db/id #edb/ref 17592186416306}} {:db/id #edb/ref 17592186416310 :step/content {:db/id #edb/ref 17592186416304 :question/id #uuid "4a38bcb4-0b4c-5b8b-bb9c-b7e3ce5c912c"} :step/id #uuid "8e8d31d5-c990-5339-ae25-b77f962093ed" :step/next {:db/id #edb/ref 17592186416308}}] :activity/title "Cramer’s Rule for 3x3 Systems" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186416271}] :db/id #edb/ref 17592186049788 :topic/knowledge-points [{:db/id #edb/ref 17592186119789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119600 :question/id #uuid "41a8466d-8bc6-5811-a557-e5a4e840f51c" :question/math-academy-id "e-4577" :question/problem "Let $\\langle x,y,z \\rangle$ be the solution of the system of equations below. Find $z.$\n\n$$\n\\left\\{\\begin{aligned}x-y+3z &=-1 \\\\ 4x-2z &=1 \\\\ 3x+y-z &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}1x-1y+3z &=-1 \\\\ 4x+0y-2z &=1 \\\\ 3x+1y-1z &=-2\\end{aligned}\\right.\n$$\n\nWe start by finding the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & -1 & 3 \\\\ 4 & 0 & -2 \\\\ 3 & 1 & -1\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & -2 \\\\ 1 & -1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}4 & -2 \\\\ 3 & -1\\end{aligned}|+3\\cdot |\\begin{aligned}4 & 0 \\\\ 3 & 1\\end{aligned}| \\\\  & =(0-(-2))+(-4+6)+3(4-0) \\\\  & =2+2+12 \\\\  & =16\\end{aligned}\n$$\n\nNow, to find $D_z,$ we take the coefficients matrix, replace the *third* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}1 & -1 & -1 \\\\ 4 & 0 & 1 \\\\ 3 & 1 & -2\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}|-(-1)\\cdot |\\begin{aligned}4 & 1 \\\\ 3 & -2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}4 & 0 \\\\ 3 & 1\\end{aligned}| \\\\  & =(0-1)+(-8-3)-(4-0) \\\\  & =-1-11-4 \\\\  & =-16\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{-16}{16}=-1.\\end{aligned}\n$$"} :knowledge-point/id #uuid "71c540ac-3cb5-5e0e-9b7b-5e2ccf1615c5" :knowledge-point/questions [{:db/id #edb/ref 17592186120440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "439acbed-ae94-5186-8b18-2a5683b17f92" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186327522} {:answer/id #uuid "4e3d3044-4f96-5fc4-9219-3888cf7c6c74" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186327615} {:answer/id #uuid "5d09d9f1-208c-5b8e-8e1d-8ec12e7f84ed" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327754} {:answer/id #uuid "786b3736-0f53-5024-9f0d-aeb608275a8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186327964} {:answer/id #uuid "da3ac648-6583-5128-9638-812bb3478223" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186328841}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186327522} :answer-field/id #uuid "ea644269-1c6a-5369-9cdc-49e7becab591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329591}] :question/id #uuid "1cf1a77a-780e-5431-8f91-cd363218bcc7" :question/math-academy-id "q-42623" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x+5y-z &=1 \\\\ 2x-3z &=-2 \\\\ -x+y-2z &=6\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $42,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}3x+5y+(-1)z &=1 \\\\ 2x+0y+(-3)z &=-2 \\\\ (-1)x+1y+(-2)z &=6.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & 5 & -1 \\\\ 2 & 0 & -3 \\\\ -1 & 1 & -2\\end{aligned}|=42.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 5 & -1 \\\\ -2 & 0 & -3 \\\\ 6 & 1 & -2\\end{aligned}| & =1\\cdot |\\begin{aligned}0 & -3 \\\\ 1 & -2\\end{aligned}|-5\\cdot |\\begin{aligned}-2 & -3 \\\\ 6 & -2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-2 & 0 \\\\ 6 & 1\\end{aligned}| \\\\  & =(0+3)-5(4+18)-(-2-0) \\\\  & =3-110+2 \\\\  & =-105.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{-105}{42}=-\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a06992-2a94-5a3a-a20b-d5286ce30bcb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186327225} {:answer/id #uuid "377efdb7-7cee-5099-8cae-51cdbbe6616b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186327414} {:answer/id #uuid "b0cc0ddc-8145-5076-87a2-190fd3bfa8f8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328468} {:answer/id #uuid "b292cfcc-376c-5e2a-b21e-6f850b288316" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186328482} {:answer/id #uuid "f4428a00-d7dc-5d9f-a160-16ff281e5899" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186329070}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186329070} :answer-field/id #uuid "2ddb23bf-438b-5a09-a4a7-1fc5c227a7e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329267}] :question/id #uuid "f118e080-b2e1-5b06-9da5-b10b39fd54f2" :question/math-academy-id "q-42671" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}5x-3y+z &=5 \\\\ x+y-2z &=-3 \\\\ -5x+4z &=-1\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $7,$ then $y=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}5x+(-3)y+1z &=5 \\\\ 1x+1y+(-2)z &=-3 \\\\ -5x+0y+4z &=-1\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}5 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -5 & 0 & 4\\end{aligned}|=7\\end{aligned}\n$$\n\nNow, to find ${D}_{y},$ we take the coefficients matrix, replace the second column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}5 & 5 & 1 \\\\ 1 & -3 & -2 \\\\ -5 & -1 & 4\\end{aligned}| & =5\\cdot |\\begin{aligned}-3 & -2 \\\\ -1 & 4\\end{aligned}|-5\\cdot |\\begin{aligned}1 & -2 \\\\ -5 & 4\\end{aligned}|+1\\cdot |\\begin{aligned}1 & -3 \\\\ -5 & -1\\end{aligned}| \\\\  & =5(-12-2)-5(4-10)+(-1-15) \\\\  & =-70+30-16 \\\\  & =-56.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{-56}{7}=-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186271993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a98b764-07a6-59aa-a73d-b403f4f4056b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270215} {:answer/id #uuid "8ba1b547-e0d0-5546-bd1b-227b4cf244dd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270479} {:answer/id #uuid "bb58a0c7-bd42-5833-8353-1562ed6fbc31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270917} {:answer/id #uuid "e4a52826-e9f3-542a-895c-7a5c2f7a1bd8" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271285} {:answer/id #uuid "fdd1e2da-37c8-52c2-b0a9-10da660c56f9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186271492}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270479} :answer-field/id #uuid "4ba91970-93e2-5767-80dc-9563ec92eb14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271649}] :question/id #uuid "9520d4bf-e01d-5858-8222-d49fb68d2820" :question/math-academy-id "q-139987" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+4y+2z &=-2 \\\\ 2x-5y+1z &=-10 \\\\ 2x+y-2z &=-1\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $66,$ then $y=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}2x+4y+2z &=-2 \\\\ 2x+(-5)y+1z &=-10 \\\\ 2x+1y+(-2)z &=-1\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 4 & 2 \\\\ 2 & -5 & 1 \\\\ 2 & 1 & -2\\end{aligned}|=66\\end{aligned}\n$$\n\nNow, to find ${D}_{y},$ we take the coefficients matrix, replace the second column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}2 & -2 & 2 \\\\ 2 & -10 & 1 \\\\ 2 & -1 & -2\\end{aligned}| & =2\\cdot |\\begin{aligned}-10 & 1 \\\\ -1 & -2\\end{aligned}|-(-2)\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & -2\\end{aligned}|+2\\cdot |\\begin{aligned}2 & -10 \\\\ 2 & -1\\end{aligned}| \\\\  & =2(20+1)+2(-4-2)+2(-2+20) \\\\  & =42-12+36 \\\\  & =66.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{66}{66}=1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186271995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a6e5ce-0937-5891-acbd-fe85f7b69928" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269454} {:answer/id #uuid "210764b5-81bd-5952-a203-b8566ae3024c" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186269549} {:answer/id #uuid "2dbb50f3-7690-5e1c-a197-81d54236aeff" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186269680} {:answer/id #uuid "9f609c62-980b-5132-960e-b964150a53e3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270684} {:answer/id #uuid "cbfc859d-6747-5db9-9c26-4254f83b9a64" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186271060}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270684} :answer-field/id #uuid "6c4e3630-6513-56c7-9a3b-beeebecf2727" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271705}] :question/id #uuid "1e8e68a9-7d99-5bc1-967a-dd0267847130" :question/math-academy-id "q-139989" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x-5y-2z &=-7 \\\\ 2x+y-4z &=-10 \\\\ 3x-3y-2z &=-7\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $16,$ then $z=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}3x+(-5)y+(-2z) &=-7 \\\\ 2x+1y+(-4)z &=-10 \\\\ 3x+(-3)y+(-2)z &=-7.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & -5 & -2 \\\\ 2 & 1 & -4 \\\\ 3 & -3 & -2\\end{aligned}|=16.\\end{aligned}\n$$\n\nNow, to find ${D}_{z}$, we replace the third column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}3 & -5 & -7 \\\\ 2 & 1 & -10 \\\\ 3 & -3 & -7\\end{aligned}| & =3\\cdot |\\begin{aligned}1 & -10 \\\\ -3 & -7\\end{aligned}|-(-5)\\cdot |\\begin{aligned}2 & -10 \\\\ 3 & -7\\end{aligned}|+(-7)\\cdot |\\begin{aligned}2 & 1 \\\\ 3 & -3\\end{aligned}| \\\\  & =3(-7-30)+5(-14+30)-7(-6-3) \\\\  & =-111+80+63 \\\\  & =32.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{32}{16}=2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f3c771f-c51e-5841-8533-1a9671c2d6cc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327488} {:answer/id #uuid "596aae9d-1263-5f81-8c32-fcfac678f572" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327717} {:answer/id #uuid "ac1518da-c8dd-5fdb-b4cb-d1e5e1748f89" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328428} {:answer/id #uuid "f915f45d-2c74-53be-8b2d-4264b352acb9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186329119} {:answer/id #uuid "fea619bf-5465-56b2-9f3c-9d1185630620" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186329170}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186329170} :answer-field/id #uuid "21719854-d3df-595d-91dc-6df416673b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329243}] :question/id #uuid "205fc41d-e809-53d1-80b0-a8abf73a7907" :question/math-academy-id "q-43108" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x+2y+z &=1 \\\\ 5x+3y+4z &=2 \\\\ x+y-z &=1\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-1,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}3x+2y+1z &=1 \\\\ 5x+3y+4z &=2 \\\\ 1x+1y+(-1)z &=1.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & 2 & 1 \\\\ 5 & 3 & 4 \\\\ 1 & 1 & -1\\end{aligned}|=-1.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 2 & 1 \\\\ 2 & 3 & 4 \\\\ 1 & 1 & -1\\end{aligned}| & =1\\cdot |\\begin{aligned}3 & 4 \\\\ 1 & -1\\end{aligned}|-2\\cdot |\\begin{aligned}2 & 4 \\\\ 1 & -1\\end{aligned}|+1\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =(-3-4)-2(-2-4)+(2-3) \\\\  & =-7+12-1 \\\\  & =4.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{4}{-1}=-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd9079a-4963-509d-a3da-d27366b782b5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186327329} {:answer/id #uuid "3aea6d24-0a56-5888-a8e3-109a62413c53" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327449} {:answer/id #uuid "546b8616-bf87-5310-b3c0-bc52b7584b91" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186327665} {:answer/id #uuid "6799deba-510a-5089-a465-45c6d5c1d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186327829} {:answer/id #uuid "883968bf-6611-5de3-b61f-c127d0d9a9b8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328108}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328108} :answer-field/id #uuid "80bf0724-8a72-5f69-a92b-8314808998bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329396}] :question/id #uuid "5675fe1a-2882-51dc-95b2-11c432a8cf1f" :question/math-academy-id "q-43124" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+y-z &=1 \\\\ x-2y+2z &=3 \\\\ 3x-2y+z &=2\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $5,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}2x+1y+(-1)z &=1 \\\\ 1x+(-2)y+2z &=3 \\\\ 3x+(-2)y+1z &=2.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 1 & -1 \\\\ 1 & -2 & 2 \\\\ 3 & -2 & 1\\end{aligned}|=5.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 1 & -1 \\\\ 3 & -2 & 2 \\\\ 2 & -2 & 1\\end{aligned}| & =1\\cdot |\\begin{aligned}-2 & 2 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ 2 & -2\\end{aligned}| \\\\  & =(-2-(-4))-(3-4)-(-6-(-4)) \\\\  & =2+1+2 \\\\  & =5.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{5}{5}=1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082ecf9b-b55d-5307-a0f7-1da37a068915" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{18}" :db/id #edb/ref 17592186339195} {:answer/id #uuid "3c29365d-cdf6-5070-899a-cca2e5157b74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186339667} {:answer/id #uuid "b2d0104a-d55e-5c75-9c36-9126b1c15825" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186340753} {:answer/id #uuid "c3d152cb-7253-5ec7-aa3d-0934d3185582" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186340871} {:answer/id #uuid "eb765550-bbc5-52b3-832f-99ced63afe37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186341205}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186340753} :answer-field/id #uuid "7225b32d-25d7-55f8-a633-92be15259f4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341578}] :question/id #uuid "71e182d9-57b6-5440-abac-bce2707f571b" :question/math-academy-id "q-73690" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}x+y+3z &=-2 \\\\ 2x-y &=3 \\\\ -x-2y+z &=6\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-18,$ then $x=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}1x+1y+3z &=-2 \\\\ 2x+(-1)y+0z &=3 \\\\ (-1)x+(-2)y+1z &=6.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & 1 & 3 \\\\ 2 & -1 & 0 \\\\ -1 & -2 & 1\\end{aligned}|=-18.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-2 & 1 & 3 \\\\ 3 & -1 & 0 \\\\ 6 & -2 & 1\\end{aligned}| & =-2\\cdot |\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 0 \\\\ 6 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -1 \\\\ 6 & -2\\end{aligned}| \\\\  & =-2(-1-0)-(3-0)-(-6+6) \\\\  & =2-3-0 \\\\  & =-1.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{-1}{-18}=\\frac{1}{18}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186416303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e0253b-532c-58d8-b091-347993c3f893" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{23}" :db/id #edb/ref 17592186416273} {:answer/id #uuid "061ca3b9-19da-5830-8387-482e73317df9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{21}" :db/id #edb/ref 17592186416274} {:answer/id #uuid "489fa8d1-175b-5fa4-8798-bbe1b2637681" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186416279} {:answer/id #uuid "73c24e43-321d-50e6-b1e7-cdf2748817be" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186416283} {:answer/id #uuid "b917f57a-83ba-5e72-bb47-0cffe8883bc7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{21}" :db/id #edb/ref 17592186416290}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{21}" :db/id #edb/ref 17592186416274} :answer-field/id #uuid "dc965890-90b8-58cc-bc3f-efeb4ad8684c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416301}] :question/id #uuid "2a3030e8-5052-55cf-b8fe-d458398f5913" :question/math-academy-id "q-73691" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x-3y &=1 \\\\ 5x+4y-2z &=0 \\\\ y-z &=3\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-21,$ then $y=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}3x+(-3)y+0z &=1 \\\\ 5x+4y+(-2)z &=0 \\\\ 0x+1y+(-1)z &=3\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & -3 & 0 \\\\ 5 & 4 & -2 \\\\ 0 & 1 & -1\\end{aligned}|=-21\\end{aligned}\n$$\n\nNow, to find ${D}_{y},$ we take the coefficients matrix, replace the second column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}3 & 1 & 0 \\\\ 5 & 0 & -2 \\\\ 0 & 3 & -1\\end{aligned}| & =3\\cdot |\\begin{aligned}0 & -2 \\\\ 3 & -1\\end{aligned}|-1\\cdot |\\begin{aligned}5 & -2 \\\\ 0 & -1\\end{aligned}|+0\\cdot |\\begin{aligned}5 & 0 \\\\ 0 & 3\\end{aligned}| \\\\  & =3(0+6)-(-5-0)+0 \\\\  & =18+5 \\\\  & =23.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{23}{-21}=-\\frac{23}{21}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186416304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fc23eff-2e85-53ab-85d6-24718d451428" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186416281} {:answer/id #uuid "a30ac57b-8a8c-5c62-8fa8-59e9b44f8567" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186416287} {:answer/id #uuid "a379347f-b3fd-507c-a103-9d1da21b2d0c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186416288} {:answer/id #uuid "cb8728d4-e8d5-5f53-8f10-8aeddf36b55b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186416292} {:answer/id #uuid "e1a3b796-b620-52fb-a517-36825c287eea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186416293}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186416287} :answer-field/id #uuid "5f143de8-4808-52ba-8787-6ee60a482eb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416299}] :question/id #uuid "4a38bcb4-0b4c-5b8b-bb9c-b7e3ce5c912c" :question/math-academy-id "q-42673" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}4x+y &=-3 \\\\ x-3y-2z &=4 \\\\ -2x+y+2z &=-5\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-14,$ then $z=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}4x+1y+0z &=-3 \\\\ 1x+(-3)y+(-2)z &=4 \\\\ (-2)x+1y+2z &=-5.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}4 & 1 & 0 \\\\ 1 & -3 & -2 \\\\ -2 & 1 & 2\\end{aligned}|=-14.\\end{aligned}\n$$\n\nNow, to find ${D}_{z}$, we replace the third column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}4 & 1 & -3 \\\\ 1 & -3 & 4 \\\\ -2 & 1 & -5\\end{aligned}| & =4\\cdot |\\begin{aligned}-3 & 4 \\\\ 1 & -5\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 4 \\\\ -2 & -5\\end{aligned}|+(-3)\\cdot |\\begin{aligned}1 & -3 \\\\ -2 & 1\\end{aligned}| \\\\  & =4(15-4)-(-5+8)-3(1-6) \\\\  & =44-3+15 \\\\  & =56.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{56}{-14}=-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131b8e36-82f8-5b9c-9ba5-e64dead4cde3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186553908} {:answer/id #uuid "2bec32dd-29a6-5607-920d-c35b9a232d65" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186553949} {:answer/id #uuid "7bf56a6c-9b35-56b5-83b1-eab01b39b95f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186554118} {:answer/id #uuid "c4ae4810-f1e6-544a-a09e-ed9a32b9bd9a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186554297} {:answer/id #uuid "d88503a5-902e-5a41-ab49-65ce7f2c3952" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186554342}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186553949} :answer-field/id #uuid "b8fd5cb6-f113-5503-be05-ca917de23415" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554505}] :question/id #uuid "42ee0be6-4308-53bc-b367-0e542cac978e" :question/math-academy-id "q-43121" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\{\\begin{aligned}2x+3y+z=1 \\\\ 6x-2y-z=-14 \\\\ 3x+y-z=1\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $27,$ then $z=$" :question/worked-solution "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\{\\begin{aligned}2x+3y+1z=1 \\\\ 6x+(-2)y+(-1)z=-14 \\\\ 3x+1y+(-1)z=1.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 1 \\\\ 6 & -2 & -1 \\\\ 3 & 1 & -1\\end{aligned}|=27.\\end{aligned}\n$$\n\nNow, to find ${D}_{z}$, we replace the third column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 3 & 1 \\\\ 6 & -2 & -14 \\\\ 3 & 1 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}-2 & -14 \\\\ 1 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}6 & -14 \\\\ 3 & 1\\end{aligned}|+1\\cdot |\\begin{aligned}6 & -2 \\\\ 3 & 1\\end{aligned}| \\\\  & =2(-2+14)-3(6+42)+(6+6) \\\\  & =24-144+12 \\\\  & =-108.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}z & =\\frac{{D}_{z}}{D}=\\frac{-108}{27}=-4.\\end{aligned}\n$$"}] :knowledge-point/title "Solving for an Unknown in a 3x3 Linear System Using Cramer's Rule"} {:db/id #edb/ref 17592186119791 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119602 :question/id #uuid "e1eb00d6-77fe-5110-8095-a54e63981c09" :question/math-academy-id "e-4579" :question/problem "Let $\\langle x,y,z \\rangle$ be the solution of the system of equations below. Given that $x = 2,$ find the value of $k.$\n\n$$\n\\left\\{\\begin{aligned}x+2y-z &=-1 \\\\ kx+3y-2z &=1 \\\\ 3x-y+2z &=3\\end{aligned}\\right.\n$$" :question/worked-solution "First, let's find the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & 2 & -1 \\\\ k & 3 & -2 \\\\ 3 & -1 & 2\\end{aligned}| & =1\\cdot |\\begin{aligned}3 & -2 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}k & -2 \\\\ 3 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}k & 3 \\\\ 3 & -1\\end{aligned}| \\\\  & =(6-2)-2(2k+6)-(-k-9) \\\\  & =4-4k-12+k+9 \\\\  & =1-3k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x = \\dfrac{D_x}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-1 & 2 & -1 \\\\ 1 & 3 & -2 \\\\ 3 & -1 & 2\\end{aligned}| & =(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}1 & 3 \\\\ 3 & -1\\end{aligned}| \\\\  & =-(6-2)-2(2+6)-(-1-9) \\\\  & =-4-16+10 \\\\  & =-10.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx = \\dfrac{D_x}{D} = \\dfrac{-10}{1-3k}.\n$$\n\nFrom the problem statement, we know that $x=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-10}{1-3k} & =2 \\\\ -10 & =2-6k \\\\ 6k & =12 \\\\ k & =2\\end{aligned}\n$$"} :knowledge-point/id #uuid "7263e25b-117e-528c-b2ad-2624f325da35" :knowledge-point/questions [{:db/id #edb/ref 17592186120458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cce91bb-3f2d-594d-b001-b74e585728b3" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186327044} {:answer/id #uuid "37c36c30-f71a-5c42-8e1f-9edf8e05698a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186327418} {:answer/id #uuid "44045eca-a7ba-59e9-8fbf-163cca4eb93a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186327529} {:answer/id #uuid "eb8f6fbd-305a-5b73-bdfc-0528e914b0e9" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186328994} {:answer/id #uuid "f06bdfa7-6d66-5967-9f0e-3a7302aa595b" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186329032}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186329032} :answer-field/id #uuid "fa8ff1ea-d3d8-5891-8607-26ac9e965d86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329617}] :question/id #uuid "d9b84023-6745-5aae-a304-bc4f9a263b31" :question/math-academy-id "q-43113" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x-y+2z &=6 \\\\ 3x+2y-z &=k \\\\ 4x+3y-3z &=1\\end{aligned}\\right.\n$$\n\nGiven that $x=1$ and that the determinant of the coefficient matrix is equal to $-9,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & -1 & 2 \\\\ 3 & 2 & -1 \\\\ 4 & 3 & -3\\end{aligned}|=-9\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}6 & -1 & 2 \\\\ k & 2 & -1 \\\\ 1 & 3 & -3\\end{aligned}| & =6\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}k & -1 \\\\ 1 & -3\\end{aligned}|+2\\cdot |\\begin{aligned}k & 2 \\\\ 1 & 3\\end{aligned}| \\\\  & =6(-6+3)+(-3k+1)+2(3k-2) \\\\  & =-18-3k+1+6k-4 \\\\  & =3k-21.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{3k-21}{-9}.\n$$\n\nFrom the problem statement, we know that $x=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-9}{3k-21} & =1 \\\\ -9 & =3k-21 \\\\ 12 & =3k \\\\ k & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27fff04a-2bbe-5b26-ad65-edbd694ba9be" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186416276} {:answer/id #uuid "7fe85483-816c-510e-9fd1-dd20c0b4191b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-10" :db/id #edb/ref 17592186416284} {:answer/id #uuid "b4d8e391-d9ee-52da-94f1-37df36eceaa0" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186416289} {:answer/id #uuid "c108d1a2-60fc-5674-aa0a-d546a2379dfd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186416291} {:answer/id #uuid "ee89842c-a371-5c4d-bdf4-656e2b69eca7" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186416295}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186416289} :answer-field/id #uuid "432aa278-91b8-5c39-89e2-129966c0aa56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416297}] :question/id #uuid "c8205961-c58e-5aea-a7e2-15eb2dd17972" :question/math-academy-id "q-43115" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+y-3z &=7 \\\\ kx-4y+z &=-19 \\\\ x-y-4z &=4.\\end{aligned}\\right.\n$$\n\nGiven that  $z=-2$ and that the determinant of the coefficient matrix is equal to $7k+23,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 1 & -3 \\\\ k & -4 & 1 \\\\ 1 & -1 & -4\\end{aligned}|=7k+23\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 1 & 7 \\\\ k & -4 & -19 \\\\ 1 & -1 & 4\\end{aligned}| & =2\\cdot |\\begin{aligned}-4 & -19 \\\\ -1 & 4\\end{aligned}|-1\\cdot |\\begin{aligned}k & -19 \\\\ 1 & 4\\end{aligned}|+7\\cdot |\\begin{aligned}k & -4 \\\\ 1 & -1\\end{aligned}| \\\\  & =2(-16-19)-(4k+19)+7(-k+4) \\\\  & =-70-4k-19-7k+28 \\\\  & =-61-11k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{-61-11k}{7k+23}.\n$$\n\nFrom the problem statement, we know that $z=-2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-61-11k}{7k+23} & =-2 \\\\ -61-11k & =-14k-46 \\\\ 3k & =15 \\\\ k & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347efb70-e44d-50c1-be1b-19ddcd858876" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186269749} {:answer/id #uuid "3dcf7c57-596b-56d8-bbc4-4ef2fd738db5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186269833} {:answer/id #uuid "7fa92296-a8c7-5064-987e-0dba2a5c3ade" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186270381} {:answer/id #uuid "9fe23528-de1b-5e36-a053-630ae11946e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186270690} {:answer/id #uuid "e42035ba-5a21-54af-b741-93298da3d242" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186271278}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186269833} :answer-field/id #uuid "d5425c9e-f9a3-50d1-b38c-a404e2f613e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271888}] :question/id #uuid "b99085c9-ade3-5f37-a123-f7c001cf1137" :question/math-academy-id "q-140042" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}3x-4y-5z &=1 \\\\ 2x+3y-3z &=k \\\\ -5x+3y+7z &=-2\\end{aligned}\\right.\n$$\n\nGiven that $y=-1$ and that the determinant of the coefficient matrix is equal to $-19,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}3 & -4 & -5 \\\\ 2 & 3 & -3 \\\\ -5 & 3 & 7\\end{aligned}|=-19\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}3 & 1 & -5 \\\\ 2 & k & -3 \\\\ -5 & -2 & 7\\end{aligned}| & =3\\cdot |\\begin{aligned}k & -3 \\\\ -2 & 7\\end{aligned}|-1\\cdot |\\begin{aligned}2 & -3 \\\\ -5 & 7\\end{aligned}|+(-5)\\cdot |\\begin{aligned}2 & k \\\\ -5 & -2\\end{aligned}| \\\\  & =3(7k-6)-(14-15)-5(-4+5k) \\\\  & =21k-18+1+20-25k \\\\  & =-4k+3.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{-4k+3}{-19}.\n$$\n\nFrom the problem statement, we know that $y=-1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-4k+3}{-19} & =-1 \\\\ -4k+3 & =19 \\\\ -4k & =16 \\\\ k & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "178aa29c-c731-5575-b789-a031a7794737" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186269463} {:answer/id #uuid "32d6fe63-36e7-505d-b5ca-f8377d01d86a" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186269733} {:answer/id #uuid "44193ff7-7933-5662-b23c-3e02bf36d32b" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186269885} {:answer/id #uuid "9261b35a-1876-58e0-8b49-edd341555666" :answer/type {:db/ident :answer.type/math} :answer/value "k=11" :db/id #edb/ref 17592186270549} {:answer/id #uuid "9a5e86f2-180e-58a4-a5c7-b73059c1110a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186270628}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186269885} :answer-field/id #uuid "d2a02390-118a-5af6-b56f-a5456ae3d683" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271885}] :question/id #uuid "254e5808-cdaa-58f1-bc6f-06ea580b1b72" :question/math-academy-id "q-140043" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}6x+5y-3z &=2 \\\\ 4x-5y+kz &=1 \\\\ -2x+10y-5z &=-2.\\end{aligned}\\right.\n$$\n\nGiven that  $x=\\frac{1}{2}$ and that the determinant of the coefficient matrix is equal to $160-70k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}6 & 5 & -2 \\\\ 4 & -5 & k \\\\ -2 & 10 & -5\\end{aligned}|=160-70k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}2 & 5 & -3 \\\\ 1 & -5 & k \\\\ -2 & 10 & -5\\end{aligned}| & =2\\cdot |\\begin{aligned}-5 & k \\\\ 10 & -5\\end{aligned}|-5\\cdot |\\begin{aligned}1 & k \\\\ -2 & -5\\end{aligned}|+(-3)\\cdot |\\begin{aligned}1 & -5 \\\\ -2 & 10\\end{aligned}| \\\\  & =2(25-10k)-5(-5+2k)-3(10-10) \\\\  & =50-20k+25-10k+0 \\\\  & =75-30k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{75-30k}{160-70k}.\n$$\n\nFrom the problem statement, we know that $x=\\frac{1}{2}.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{75-30k}{160-70k} & =\\frac{1}{2} \\\\ 2(75-30k) & =160-70k \\\\ 150-60k & =160-70k \\\\ 10k & =10 \\\\ k & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022a76e7-cc28-5e8a-9903-d778566e9158" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186326955} {:answer/id #uuid "387f2b93-b1ae-5dc1-a9ec-6ee1066683f3" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186327427} {:answer/id #uuid "7c99580e-aaf7-5328-9593-a983229f42cc" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186328008} {:answer/id #uuid "8929ca10-243a-5f6c-953f-c4c18ffb6440" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186328113} {:answer/id #uuid "adabd61c-99a5-5598-8973-898bd22e8e4f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186328442}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186327427} :answer-field/id #uuid "9bed489f-142c-5b72-a43d-58ce66584a8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329443}] :question/id #uuid "3eb8876e-4ac9-5db4-b3d5-66592db8b271" :question/math-academy-id "q-42684" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}19x+3y-4z &=-2 \\\\ 6x+ky-4z &=-1 \\\\ -9x-y+2z &=5.\\end{aligned}\\right.\n$$\n\nGiven that  $y=21$ and that the determinant of the coefficient matrix is equal to $2k+20,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}19 & 3 & -4 \\\\ 6 & k & -4 \\\\ -9 & -1 & 2\\end{aligned}|=2k+20\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}19 & -2 & -4 \\\\ 6 & -1 & -4 \\\\ -9 & 5 & 2\\end{aligned}| & =19\\cdot |\\begin{aligned}-1 & -4 \\\\ 5 & 2\\end{aligned}|-(-2)\\cdot |\\begin{aligned}6 & -4 \\\\ -9 & 2\\end{aligned}|+(-4)\\cdot |\\begin{aligned}6 & -1 \\\\ -9 & 5\\end{aligned}| \\\\  & =19(-2+20)+2(12-36)-4(30-9) \\\\  & =342-48-84 \\\\  & =210.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{210}{2k+20}.\n$$\n\nFrom the problem statement, we know that $y=21.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{210}{2k+20} & =21 \\\\ 10 & =2k+20 \\\\ 2k & =-10 \\\\ k & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2241ec88-5356-5893-b69f-c9e4fd87c09c" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186327230} {:answer/id #uuid "5da23a4c-faa7-5c6b-ac22-922696b59bba" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186327759} {:answer/id #uuid "6f623b61-ca7e-5718-ac2b-2a0d442c6767" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186327898} {:answer/id #uuid "79ecd735-7b77-5ecc-a27c-75997ff676f5" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186327979} {:answer/id #uuid "c349a9f6-3ed5-56ea-bf87-5daf2f2c94bb" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186328641}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186327759} :answer-field/id #uuid "c1b47b03-47bb-5bf2-8a6d-aefaac24352a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329523}] :question/id #uuid "53b9ad58-1c7d-58bd-abc1-d7698480a379" :question/math-academy-id "q-43111" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}5x-3y-z &=1 \\\\ x+4y+kz &=-1 \\\\ 2x+3y+4z &=9.\\end{aligned}\\right.\n$$\n\nGiven that  $z=1$ and that the determinant of the coefficient matrix is equal to $97-21k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}5 & -3 & -1 \\\\ 1 & 4 & k \\\\ 2 & 3 & 4\\end{aligned}|=97-21k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}5 & -3 & 1 \\\\ 1 & 4 & -1 \\\\ 2 & 3 & 9\\end{aligned}| & =5\\cdot |\\begin{aligned}4 & -1 \\\\ 3 & 9\\end{aligned}|-(-3)\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 9\\end{aligned}|+1\\cdot |\\begin{aligned}1 & 4 \\\\ 2 & 3\\end{aligned}| \\\\  & =5(36+3)+3(9+2)+(3-8) \\\\  & =195+33-5 \\\\  & =223.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{223}{97-21k}.\n$$\n\nFrom the problem statement, we know that $z=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{223}{97-21k} & =1 \\\\ 223 & =97-21k \\\\ 21k & =-126 \\\\ k & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366d5017-aad8-5843-823f-1d4e4dd33e90" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186339613} {:answer/id #uuid "47b62fe4-6ab7-5e21-8a8a-6a9c9baff521" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186339765} {:answer/id #uuid "48ccadaa-f3f4-533a-9e1c-2513c4be5bc6" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186339777} {:answer/id #uuid "52623fbd-76ac-5d24-b9fc-6fb7db23aa63" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186339887} {:answer/id #uuid "57164657-c647-5ebd-b642-5eef7e828d64" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186339925}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186339613} :answer-field/id #uuid "74506616-90c4-58b4-aff6-e59edfdd3f69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341585}] :question/id #uuid "209a5a36-a432-55a5-bdf5-16c608d27113" :question/math-academy-id "q-73694" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+3y+z &=3 \\\\ x-z &=k \\\\ x-2y+2z &=1\\end{aligned}\\right.\n$$\n\nGiven that $z=2$ and that the determinant of the coefficient matrix is equal to $-15,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 1 \\\\ 1 & 0 & -1 \\\\ 1 & -2 & 2\\end{aligned}|=-15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 3 & 3 \\\\ 1 & 0 & k \\\\ 1 & -2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}0 & k \\\\ -2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & k \\\\ 1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}| \\\\  & =2(0+2k)-3(1-k)+3(-2-0) \\\\  & =4k-3+3k-6 \\\\  & =7k-9.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{7k-9}{-15}.\n$$\n\nFrom the problem statement, we know that $z=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{7k-9}{-15} & =2 \\\\ 7k-9 & =-30 \\\\ 7k & =-21 \\\\ k & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb35856-1ec7-5c49-be2d-613b5999c247" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186339230} {:answer/id #uuid "429b7481-cf7c-5542-94eb-469ef9bc5c9b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186339711} {:answer/id #uuid "58e38b5a-b8c9-5bf8-b5d2-e9e50b751d74" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186339937} {:answer/id #uuid "8bf0a6b8-772c-56ce-9f67-a8b0a1030b89" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186340382} {:answer/id #uuid "efae4617-4d98-5b47-bcb8-8b5baad301dd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186341241}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186339230} :answer-field/id #uuid "55a02894-8a7c-5f56-b37a-283aa26f6bcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341535}] :question/id #uuid "0e7d5f36-83df-59b5-b06e-da52c530f2e8" :question/math-academy-id "q-73697" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}x-y+5z &=-1 \\\\ 2x+3y+2z &=0 \\\\ x+4y &=k\\end{aligned}\\right.\n$$\n\nGiven that $x=-4$ and that the determinant of the coefficient matrix is equal to $15,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & -1 & 5 \\\\ 2 & 3 & 2 \\\\ 1 & 4 & 0\\end{aligned}|=15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-1 & -1 & 5 \\\\ 0 & 3 & 2 \\\\ k & 4 & 0\\end{aligned}| & =-1\\cdot |\\begin{aligned}3 & 2 \\\\ 4 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ k & 0\\end{aligned}|+5\\cdot |\\begin{aligned}0 & 3 \\\\ k & 4\\end{aligned}| \\\\  & =-(0-8)+(0-2k)+5(0-3k) \\\\  & =8-2k-15k \\\\  & =8-17k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{8-17k}{15}.\n$$\n\nFrom the problem statement, we know that $x=-4.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{8-17k}{15} & =-4 \\\\ 8-17k & =-60 \\\\ -17k & =-68 \\\\ k & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182535ed-2c40-52e5-a8ea-da439ad71f39" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186339342} {:answer/id #uuid "563ceb4e-01d8-5269-8c7c-88ade9717ce6" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186339917} {:answer/id #uuid "614904de-89a3-53dc-9397-708ec20a06c2" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186339996} {:answer/id #uuid "91c1ca7c-7293-5998-9217-cd635329657e" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186340435} {:answer/id #uuid "efca7b9b-1e72-54b4-a19e-5558ceb49120" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186341242}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186339342} :answer-field/id #uuid "032e2cd1-cc94-513a-bc74-a43cdbbabe51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341389}] :question/id #uuid "606431ba-b0b3-579d-ac68-261fcff208d1" :question/math-academy-id "q-73698" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+3y+2z &=k \\\\ x+y &=-1 \\\\ y+z &=2\\end{aligned}\\right.\n$$\n\nGiven that $y=-5$ and that the determinant of the coefficient matrix is equal to $1,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 2 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}|=1\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}2 & k & 2 \\\\ 1 & -1 & 0 \\\\ 0 & 2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}|-k\\cdot |\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}| \\\\  & =2(-1-0)-k(1-0)+2(2-0) \\\\  & =-2-k+4 \\\\  & =2-k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{2-k}{1}=2-k.\n$$\n\nFrom the problem statement, we know that $y=-5.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}2-k & =-5 \\\\ k & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186416302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0520e7af-36b0-5ef0-9563-eb7367b7cb27" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186416272} {:answer/id #uuid "3675aea5-a0c8-57f7-93a0-b11b85ed8248" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186416278} {:answer/id #uuid "49e9c67b-3d28-59fc-80d1-1d4cc0713555" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186416280} {:answer/id #uuid "81135cf6-e842-57e1-aef8-392ad77737ec" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186416286} {:answer/id #uuid "e67665d0-ea97-55a9-9c9d-1d7010759bbe" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{3}" :db/id #edb/ref 17592186416294}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186416280} :answer-field/id #uuid "4a46aaec-c335-5f1e-884c-19d1799ece0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416298}] :question/id #uuid "22790615-5765-50ce-b96c-1d82231be30c" :question/math-academy-id "q-42668" :question/problem "Let $⟨x,y,z⟩$ be a unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}4x+y+z &=-4 \\\\ y-2z &=2 \\\\ 3x+2y+kz &=1.\\end{aligned}\\right.\n$$\n\nGiven that  $y=6$ and that the determinant of the coefficient matrix is equal to $7+4k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}4 & 1 & 1 \\\\ 0 & 1 & -2 \\\\ 3 & 2 & k\\end{aligned}|=7+4k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}4 & -4 & 1 \\\\ 0 & 2 & -2 \\\\ 3 & 1 & k\\end{aligned}| & =4\\cdot |\\begin{aligned}2 & -2 \\\\ 1 & k\\end{aligned}|-(-4)\\cdot |\\begin{aligned}0 & -2 \\\\ 3 & k\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ 3 & 1\\end{aligned}| \\\\  & =4(2k+2)+4(0+6)+(0-6) \\\\  & =8k+8+24-6 \\\\  & =26+8k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{26+8k}{7+4k}.\n$$\n\nFrom the problem statement, we know that $y=6.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{26+8k}{7+4k} & =6 \\\\ 26+8k & =42+24k \\\\ 16k & =-16 \\\\ k & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186416305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a43538-527f-5e1c-8777-5a1b965cf68f" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186416275} {:answer/id #uuid "2e5a75d9-2669-5164-ae35-761e45c73242" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186416277} {:answer/id #uuid "630877d4-1651-51d8-aadc-515dcd79b003" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186416282} {:answer/id #uuid "8103e5b5-a679-5861-8dd6-741437678c88" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186416285} {:answer/id #uuid "f73e832f-6af7-5391-9436-80207cb6c290" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186416296}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186416277} :answer-field/id #uuid "7d561005-378c-508e-a82e-2d8043716be1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416300}] :question/id #uuid "9a1ee2de-30e9-5dde-87e2-a6069fa7a03b" :question/math-academy-id "q-73695" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}y+z &=-1 \\\\ x+5y+3z &=k \\\\ 7x-3y-z &=4\\end{aligned}\\right.\n$$\n\nGiven that $z=-3$ and that the determinant of the coefficient matrix is equal to $-16,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}0 & 1 & 1 \\\\ 1 & 5 & 3 \\\\ 7 & -3 & -1\\end{aligned}|=-16\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}0 & 1 & -1 \\\\ 1 & 5 & k \\\\ 7 & -3 & 4\\end{aligned}| & =0\\cdot |\\begin{aligned}5 & k \\\\ -3 & 4\\end{aligned}|-1\\cdot |\\begin{aligned}1 & k \\\\ 7 & 4\\end{aligned}|+(-1)\\cdot |\\begin{aligned}1 & 5 \\\\ 7 & -3\\end{aligned}| \\\\  & =0-(4-7k)-(-3-35) \\\\  & =-4+7k+38 \\\\  & =7k+34.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{7k+34}{-16}.\n$$\n\nFrom the problem statement, we know that $z=-3.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{7k+34}{-16} & =-3 \\\\ 7k+34 & =48 \\\\ 7k & =14 \\\\ k & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b477092-14a5-585d-a218-bfd1bf2d5620" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186553894} {:answer/id #uuid "381978cd-5ab7-51e7-b541-211370f63648" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186553969} {:answer/id #uuid "a549f739-e810-54df-a9ab-4502b087167f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186554233} {:answer/id #uuid "f21927cf-9af8-5e15-9789-74ae85afddc3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{2}{3}" :db/id #edb/ref 17592186554393} {:answer/id #uuid "fec613a5-e3db-55c6-8737-642a2ed8c695" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{3}" :db/id #edb/ref 17592186554424}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186553894} :answer-field/id #uuid "9df02a6a-4e09-5087-b781-68996219ec42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554493}] :question/id #uuid "8259ae37-435b-52c3-a2f0-cf085e62a133" :question/math-academy-id "q-42682" :question/problem "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\{\\begin{aligned}kx+2y-4z=-4 \\\\ x-2y+5z=-6 \\\\ 10x+y+2z=8.\\end{aligned}\n$$\n\nGiven that  $x=-\\frac{20}{3}$ and that the determinant of the coefficient matrix is equal to $12-9k,$ find the value of $k.$" :question/worked-solution "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}k & 2 & -4 \\\\ 1 & -2 & 5 \\\\ 10 & 1 & 2\\end{aligned}|=12-9k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-4 & 2 & -4 \\\\ -6 & -2 & 5 \\\\ 8 & 1 & 2\\end{aligned}| & =(-4)\\cdot |\\begin{aligned}-2 & 5 \\\\ 1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}-6 & 5 \\\\ 8 & 2\\end{aligned}|+(-4)\\cdot |\\begin{aligned}-6 & -2 \\\\ 8 & 1\\end{aligned}| \\\\  & =-4(-4-5)-2(-12-40)-4(-6+16) \\\\  & =36+104-40 \\\\  & =100.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{100}{12-9k}.\n$$\n\nFrom the problem statement, we know that $x=-\\frac{20}{3}.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{100}{12-9k} & =-\\frac{20}{3} \\\\ 15 & =-12+9k \\\\ 9k & =27 \\\\ k & =3.\\end{aligned}\n$$"}] :knowledge-point/title "Solving for a Coefficient in a 3x3 Linear System Using Cramer's Rule"} {:db/id #edb/ref 17592186119852 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119667 :question/id #uuid "33693f3b-713f-5ffc-bd4e-27ad7a1e0c7c" :question/math-academy-id "e-6172" :question/problem "Consider the system of equations\n\n$$\n\\left\\{\\begin{aligned}9x+3y-6z &=8 \\\\ -6x+4y+2z &=3 \\\\ 5x-5y-15z &=10.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $x=\\dfrac{D_x}{D}$, where $D$ is the determinant of the coefficient matrix and $D_x=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}9x+3y+(-6)z &=8 \\\\ (-6)x+4y+2z &=3 \\\\ 5x+(-5)y+(-15)z &=10.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n![](images/00/00a69fe1d48b41e376971f3669ae51668733d36dfda18c0f9cc736d5d071a441.png)\n\nNow, to construct $D_x$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n![](images/14/14e850c9af7c0b2fdd1e36299667b2cbe91c84e8bb90030b729ee23b296ad984.png)"} :knowledge-point/id #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a" :knowledge-point/questions [{:db/id #edb/ref 17592186120441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b9a8c6-b9bd-5899-bd09-098131be7790" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & -3 & 1 \\\\ -6 & 1 & -4 \\\\ 1 & 1 & 1\\end{aligned}|" :db/id #edb/ref 17592186553871} {:answer/id #uuid "8711aafc-d2ac-5f68-a103-0f5c1e832744" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 4 & 1 \\\\ 0 & -6 & -4 \\\\ 3 & -8 & 1\\end{aligned}|" :db/id #edb/ref 17592186554150} {:answer/id #uuid "a6d537ef-517e-5954-9a01-2bc13b06765d" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & -3 & 1 \\\\ 0 & 1 & -4 \\\\ 0 & 1 & 1\\end{aligned}|" :db/id #edb/ref 17592186554237} {:answer/id #uuid "e8f75c46-d176-5685-bdd6-4de61fe2da21" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -3 & 1 \\\\ 0 & 1 & -4 \\\\ 3 & 1 & 1\\end{aligned}|" :db/id #edb/ref 17592186554376} {:answer/id #uuid "fef7040b-92b0-52c5-a4ae-d7caae6a89de" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 0 & 1 \\\\ 0 & 0 & -4 \\\\ 3 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186554425}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 4 & 1 \\\\ 0 & -6 & -4 \\\\ 3 & -8 & 1\\end{aligned}|" :db/id #edb/ref 17592186554150} :answer-field/id #uuid "beff9032-09df-5ed1-b8f3-e06b2ccf3918" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118760}] :question/id #uuid "b69dc5d3-fe00-5843-9b79-6c2a6e202607" :question/math-academy-id "q-42625" :question/problem "Consider the system of equations \n\n$$\n\\{\\begin{aligned}x-3y+z=4 \\\\ y-4z=-6 \\\\ 3x+y+z=-8.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}1x+(-3)y+1z=4 \\\\ 0x+1y+(-4)z=-6 \\\\ 3x+1y+1z=-8.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}1 & -3 & 1 \\\\ 0 & 1 & -4 \\\\ 3 & 1 & 1\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{y}=|\\begin{aligned}1 & 4 & 1 \\\\ 0 & -6 & -4 \\\\ 3 & -8 & 1\\end{aligned}|.\n$$"} {:db/id #edb/ref 17592186120443 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef6bfe6-bd41-5272-8480-eb9cf4833ee5" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & 5 & 1 \\\\ 1 & 1 & -4 \\\\ -2 & 8 & 0\\end{aligned}|" :db/id #edb/ref 17592186327065} {:answer/id #uuid "1d2659c0-577a-5403-9898-9054b6c19c06" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-9 & 5 & 1 \\\\ -1 & 1 & -4 \\\\ 3 & 8 & 0\\end{aligned}|" :db/id #edb/ref 17592186327186} {:answer/id #uuid "220d322f-9abf-5a14-8b7d-e884e41d813d" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & 5 & 0 \\\\ 1 & 1 & 0 \\\\ -2 & 8 & 0\\end{aligned}|." :db/id #edb/ref 17592186327226} {:answer/id #uuid "4ee1d56f-f7fc-5458-bdb8-63657342e296" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & 5 & -9 \\\\ 1 & 1 & -1 \\\\ -2 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186327618} {:answer/id #uuid "69288c3f-0b9c-5c80-a261-ae48ba2a4035" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & -9 & 1 \\\\ 1 & -1 & -4 \\\\ 2 & 3 & 0\\end{aligned}|" :db/id #edb/ref 17592186327840}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-9 & 5 & 1 \\\\ -1 & 1 & -4 \\\\ 3 & 8 & 0\\end{aligned}|" :db/id #edb/ref 17592186327186} :answer-field/id #uuid "3bc3331d-3f17-5f5d-8dbf-b500e543c220" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329301}] :question/id #uuid "0f2938e3-2c86-58a3-8014-2fd96089eb1e" :question/math-academy-id "q-42681" :question/problem "Consider the system of equations\n\n$$\n\\left\\{\\begin{aligned}-3x+5y+z &=-9 \\\\ x+y-4z &=-1 \\\\ -2x+8y &=3.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $x=\\frac{{D}_{x}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{x}=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}-3x+5y+1z &=-9 \\\\ 1x+1y+(-4)z &=-1 \\\\ -2x+8y+0z &=3.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-3 & 5 & 1 \\\\ 1 & 1 & -4 \\\\ -2 & 8 & 0\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{x}=|\\begin{aligned}-9 & 5 & 1 \\\\ -1 & 1 & -4 \\\\ 3 & 8 & 0\\end{aligned}|.\n$$"} {:db/id #edb/ref 17592186271992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143d334e-7355-55d8-a3e8-dbbb2d4f49b6" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & -14 \\\\ -5 & 6 & -9 \\\\ 3 & -2 & -1\\end{aligned}|" :db/id #edb/ref 17592186269446} {:answer/id #uuid "2223857c-5ebe-59d1-92a1-00125dac16b7" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|" :db/id #edb/ref 17592186269561} {:answer/id #uuid "821e5bfe-d328-5b30-ab39-8a58ee20bd89" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 7 \\\\ 3 & -2 & -3\\end{aligned}|" :db/id #edb/ref 17592186270393} {:answer/id #uuid "a645f350-a31f-5a44-a7f9-022c5f316b2a" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 2 \\\\ 3 & -2 & 4\\end{aligned}|" :db/id #edb/ref 17592186270758} {:answer/id #uuid "eff4dbec-cdfc-56f9-b634-a87012dc199b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & -7 \\\\ -5 & 6 & 11 \\\\ 3 & -2 & 5\\end{aligned}|" :db/id #edb/ref 17592186271378}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|" :db/id #edb/ref 17592186269561} :answer-field/id #uuid "30847c6a-c951-5e98-bafe-58fdc8afc738" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271596}] :question/id #uuid "c6ebb206-cdb6-551e-a660-6c517ea901a1" :question/math-academy-id "q-139985" :question/problem "Consider the system of equations \n\n$$\n\\left\\{\\begin{aligned}2x-5y+7z &=14 \\\\ -5x+6y+2z &=9 \\\\ 3x-2y+4z &=1.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}2x+(-5)y+7z &=14 \\\\ -5x+6y+2z &=9 \\\\ 3x+(-2)y+4z &=1.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}2 & -5 & 7 \\\\ -5 & 6 & 2 \\\\ 3 & -2 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & -5 & 14 \\\\ -5 & 6 & 9 \\\\ 3 & -2 & 1\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6aa9b1d6-3d55-5700-a5f0-382301aec392" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 3 & 4 \\\\ -2 & -3 & -6 \\\\ 1 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186340074} {:answer/id #uuid "8caef392-0ee8-578a-9551-a72a0c5adeb3" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 4 & -2 \\\\ -2 & -6 & 0 \\\\ 1 & 1 & 4\\end{aligned}|" :db/id #edb/ref 17592186340390} {:answer/id #uuid "926e3aad-169a-5da7-b219-64eda18074ed" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 0 & -2 \\\\ -2 & 0 & 0 \\\\ 1 & 0 & 4\\end{aligned}|" :db/id #edb/ref 17592186340443} {:answer/id #uuid "cabe1b71-efac-5fbf-b227-7a0d24921924" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & 3 & -2 \\\\ -6 & -3 & 0 \\\\ 1 & 0 & 4\\end{aligned}|" :db/id #edb/ref 17592186340923} {:answer/id #uuid "d92914ff-11d5-53e8-9aac-4ff106f285e1" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 4 & -2 \\\\ 0 & -6 & 0 \\\\ 0 & 1 & 4\\end{aligned}|" :db/id #edb/ref 17592186341055}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 4 & -2 \\\\ -2 & -6 & 0 \\\\ 1 & 1 & 4\\end{aligned}|" :db/id #edb/ref 17592186340390} :answer-field/id #uuid "5366418c-dcae-5075-bc43-11c8e0b01562" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341531}] :question/id #uuid "dceddfaf-57df-5ca9-a79f-af2de59df96b" :question/math-academy-id "q-73686" :question/problem "Consider the system of equations \n\n$$\n\\left\\{\\begin{aligned}3y-2z &=4 \\\\ -2x-3y &=-6 \\\\ x+4z &=1.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}0x+3y+(-2)z &=4 \\\\ (-2)x+(-3)y+0z &=-6 \\\\ 1x+0y+4z &=1.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}0 & 3 & -2 \\\\ -2 & -3 & 0 \\\\ 1 & 0 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{y}=|\\begin{aligned}0 & 4 & -2 \\\\ -2 & -6 & 0 \\\\ 1 & 1 & 4\\end{aligned}|.\n$$"} {:db/id #edb/ref 17592186392515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a916d6b-b166-57c4-bd85-72a06229ccce" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -3 & 1 \\\\ 4 & 0 & -1 \\\\ 1 & -1 & 1\\end{aligned}|" :db/id #edb/ref 17592186392517} {:answer/id #uuid "193f5ec3-c7f2-50cc-b9de-573587c2c691" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & 1 & 1 \\\\ 4 & -3 & -1 \\\\ 1 & -3 & 1\\end{aligned}|" :db/id #edb/ref 17592186392518} {:answer/id #uuid "74f6bfaa-2bf2-5541-9bae-a94bfb6a9a4f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -3 & 1 \\\\ 4 & 0 & -3 \\\\ 1 & -1 & -3\\end{aligned}|" :db/id #edb/ref 17592186392519} {:answer/id #uuid "2e14f484-915c-51b4-9f4c-605ffafbbac5" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 1 & 5 \\\\ -1 & -3 & 4 \\\\ 1 & -3 & 1\\end{aligned}|" :db/id #edb/ref 17592186392520} {:answer/id #uuid "88e34603-60b0-54d6-94c7-05d8de9f39df" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -3 & 1 \\\\ -3 & 0 & -1 \\\\ -3 & -1 & 1\\end{aligned}|" :db/id #edb/ref 17592186392521}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & 1 & 1 \\\\ 4 & -3 & -1 \\\\ 1 & -3 & 1\\end{aligned}|" :db/id #edb/ref 17592186392518} :answer-field/id #uuid "fef5c034-09b2-5334-9188-7b56b9801df3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392516}] :question/id #uuid "8e9092a7-94c4-59d4-8639-d2ed92a81148" :question/math-academy-id "q-42693" :question/problem "Consider the system of equations \n\n$$\n\\left\\{\\begin{aligned}5x-3y+z &=1 \\\\ 4x-z &=-3 \\\\ x-y+z &=-3.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}5x+(-3)y+1z &=1 \\\\ 4x+0y+(-1)z &=-3 \\\\ 1x+(-1)y+1z &=-3.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}5 & -3 & 1 \\\\ 4 & 0 & -1 \\\\ 1 & -1 & 1\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}5 & 1 & 1 \\\\ 4 & -3 & -1 \\\\ 1 & -3 & 1\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "337e147a-5271-5218-8aed-55c3c54ec560" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 0 \\\\ 7 & 0 & 0 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393350} {:answer/id #uuid "704944b0-e49e-562f-bad8-7861be3c2b8c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 0 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186393351} {:answer/id #uuid "abf5d62f-18fd-51f2-b872-c68663df7dbb" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 2 & -1 \\\\ 7 & 12 & -8 \\\\ 3 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186393352} {:answer/id #uuid "58fb2d2f-6812-5874-bc8e-04fae44f77db" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393353} {:answer/id #uuid "8778d945-5a6f-5aae-9d13-3aed9578ba3c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 6 & -1 \\\\ 12 & 0 & -8 \\\\ 0 & 5 & 1\\end{aligned}|" :db/id #edb/ref 17592186393354}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393353} :answer-field/id #uuid "3e727d75-3ac2-5002-b782-a034a3d420e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393349}] :question/id #uuid "dfde2756-df99-506c-8f8b-640eb254c853" :question/math-academy-id "q-73688" :question/problem "Consider the system of equations \n\n$$\n\\left\\{\\begin{aligned}-4x+6y-z &=2 \\\\ 7x-8z &=12 \\\\ 3x+5y+z &=0.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n\\left\\{\\begin{aligned}(-4)x+6y+(-1)z &=2 \\\\ 7x+0y+(-8)z &=12 \\\\ 3x+5y+1z &=0.\\end{aligned}\\right.\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-4 & 6 & -1 \\\\ 7 & 0 & -8 \\\\ 3 & 5 & 1\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{z}=|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|.\n$$"} {:db/id #edb/ref 17592186554545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a2de46-ad88-5316-8e73-b1ff7775cc80" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 4 & 1 \\\\ 3 & -5 & 7 \\\\ 3 & 2 & 5\\end{aligned}|" :db/id #edb/ref 17592186553928} {:answer/id #uuid "3cbe2bb6-b29c-57e7-b971-65b7aab22fe4" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -9 & 1 \\\\ 3 & -2 & 7 \\\\ 3 & -8 & 5\\end{aligned}|" :db/id #edb/ref 17592186553980} {:answer/id #uuid "72034927-2307-593c-b051-e44ef8090945" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -9 & 4 \\\\ 7 & -2 & -5 \\\\ 5 & -8 & 2\\end{aligned}|" :db/id #edb/ref 17592186554101} {:answer/id #uuid "850388e7-886b-5c54-95f5-aa6b5e305a57" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 1 & 4 \\\\ 3 & 7 & -5 \\\\ 3 & 5 & 2\\end{aligned}|" :db/id #edb/ref 17592186554143} {:answer/id #uuid "917db11c-9f99-581d-9128-f4df28c7132c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -9 & 4 \\\\ 3 & -2 & -5 \\\\ 3 & -8 & 2\\end{aligned}|" :db/id #edb/ref 17592186554186}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -9 & 1 \\\\ 3 & -2 & 7 \\\\ 3 & -8 & 5\\end{aligned}|" :db/id #edb/ref 17592186553980} :answer-field/id #uuid "7fed87a8-5cdb-5f1a-a7fe-3143ef0b136a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554483}] :question/id #uuid "189e5e9d-c4bc-5bb9-8c63-9649351614d1" :question/math-academy-id "q-42694" :question/problem "Consider the system of equations \n\n$$\n\\{\\begin{aligned}2x-9y+4z=1 \\\\ 3x-2y-5z=7 \\\\ 3x-8y+2z=5.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}2x+(-9)y+4z=1 \\\\ 3x+(-2)y+(-5)z=7 \\\\ 3x+(-8)y+2z=5.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}2 & -9 & 4 \\\\ 3 & -2 & -5 \\\\ 3 & -8 & 2\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & -9 & 1 \\\\ 3 & -2 & 7 \\\\ 3 & -8 & 5\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0359c967-a736-556a-aa0f-b1dd2a3da13c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 1 & 0 & 4\\end{aligned}|" :db/id #edb/ref 17592186553873} {:answer/id #uuid "0612e921-5057-58c7-8bb3-0c5741bb3803" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & -8 & 8 \\\\ -4 & -6 & -1 \\\\ 1 & 0 & -7\\end{aligned}|" :db/id #edb/ref 17592186553879} {:answer/id #uuid "11916100-9121-5d1e-a1ef-24a6f295f8fc" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}8 & -8 & 5 \\\\ -1 & -6 & 3 \\\\ -7 & 0 & 4\\end{aligned}|" :db/id #edb/ref 17592186553905} {:answer/id #uuid "65de8e7a-c592-535e-8398-2751781df9fa" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 8 & 5 \\\\ -4 & -1 & 3 \\\\ 1 & -7 & 4\\end{aligned}|" :db/id #edb/ref 17592186554069} {:answer/id #uuid "7c92dc9c-1ea6-5198-b638-55d04bb60a37" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 8 & -1 & -7\\end{aligned}|" :db/id #edb/ref 17592186554119}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & -8 & 8 \\\\ -4 & -6 & -1 \\\\ 1 & 0 & -7\\end{aligned}|" :db/id #edb/ref 17592186553879} :answer-field/id #uuid "1dde4f08-b0b2-5881-b757-0ce139acae19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554444}] :question/id #uuid "3cd38166-ab43-501c-8a09-bb660de655be" :question/math-academy-id "q-43120" :question/problem "Consider the system of equations \n\n$$\n\\{\\begin{aligned}-2x-8y+5z=8 \\\\ -4x-6y+3z=-1 \\\\ x-4z=-7.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}(-2)x+(-8)y+5z=8 \\\\ (-4)x+(-6)y+3z=-1 \\\\ 1x+0y+(-4)z=-7.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-2 & -8 & 5 \\\\ -4 & -6 & 3 \\\\ 1 & 0 & -4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}-2 & -8 & 8 \\\\ -4 & -6 & -1 \\\\ 1 & 0 & -7\\end{aligned}|.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186554598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02901c74-dd5e-55a8-a30e-d37d23988f6c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -8 & 2 \\\\ 0 & 6 & -7 \\\\ 1 & -5 & -10\\end{aligned}|" :db/id #edb/ref 17592186553869} {:answer/id #uuid "22f9ed04-9d1d-5af3-b8ea-58280ed15c9f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & 2 & 3 \\\\ 0 & -7 & -3 \\\\ 1 & -10 & 4\\end{aligned}|" :db/id #edb/ref 17592186553930} {:answer/id #uuid "889308d6-5850-58f0-9c91-23f4fd38db14" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 5 & 3 \\\\ -7 & 0 & -3 \\\\ -10 & 1 & 4\\end{aligned}|" :db/id #edb/ref 17592186554154} {:answer/id #uuid "d73ce50d-5dd1-5828-9bcd-7fd2823a2ef5" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & 0 & 3 \\\\ 2 & -7 & -10 \\\\ 1 & -3 & 4\\end{aligned}|" :db/id #edb/ref 17592186554338} {:answer/id #uuid "f6e0ff00-c772-536b-a3bd-7591ea83a72f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -8 & 3 \\\\ 0 & 6 & -3 \\\\ 1 & -5 & 4\\end{aligned}|" :db/id #edb/ref 17592186554404}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & 2 & 3 \\\\ 0 & -7 & -3 \\\\ 1 & -10 & 4\\end{aligned}|" :db/id #edb/ref 17592186553930} :answer-field/id #uuid "5a66b44b-6b9e-5088-92dd-3e1f0889e8b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554465}] :question/id #uuid "8be0f924-0f3e-5631-9e67-77a4667752f3" :question/math-academy-id "q-43109" :question/problem "Consider the system of equations\n\n$$\n\\{\\begin{aligned}5x-8y+3z=2 \\\\ 6y-3z=-7 \\\\ x-5y+4z=-10.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}5x+(-8)y+3z=2 \\\\ 0x+6y+(-3)z=-7 \\\\ 1x+(-5)y+4z=-10.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}5 & -8 & 3 \\\\ 0 & 6 & -3 \\\\ 1 & -5 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}5 & 2 & 3 \\\\ 0 & -7 & -3 \\\\ 1 & -10 & 4\\end{aligned}|.\\end{aligned}\n$$"}] :knowledge-point/title "Identifying Parts of Cramer's Rule"}] :topic/math-academy-id 1776 :topic/title "Cramer’s Rule for 3x3 Systems"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186167900} :activity/id #uuid "eed4b5fc-95ba-5979-9241-b92cdec87053" :activity/steps [{:db/id #edb/ref 17592186167900 :step/content {:db/id #edb/ref 17592186168037 :tutorial/content "In a homogeneous boundary value problem (BVP) that depends on a parameter $\\lambda$, most values of $\\lambda$ lead only to the trivial solution $y\\equiv 0$.  \n\nThe special values of $\\lambda$ that produce *nontrivial* solutions are called **eigenvalues**, and the corresponding nontrivial solutions are called **eigenfunctions**.\n\nFor example, consider the boundary value problem\n\n$$\ny'' - 18\\lambda y' + 81\\lambda^2y  = 0, \\quad y(0) = 0, \\quad 4y(3) + 5y'(3) = 0, \\quad 0 \\leq x \\leq 3, \\quad \\lambda \\in\\mathbb R.\n$$\n\nLet's find the eigenvalues and eigenfunctions of this problem. \n\nThe method for solving the differential equation depends on whether $\\lambda = 0$ or $\\lambda \\neq 0.$ To find the eigenvalues, we must therefore investigate these two possibilities as separate cases.\n\nOn the next slide, we will analyze the case where $\\lambda = 0.$" :tutorial/id #uuid "1378993d-8bac-50d2-b1ea-4f7c3a1f5ec2" :tutorial/math-academy-id 14646 :tutorial/title "Introduction"} :step/id #uuid "887046eb-da38-509e-bc00-d45adf4aa497" :step/next {:db/id #edb/ref 17592186167959}} {:db/id #edb/ref 17592186167901 :step/content {:db/id #edb/ref 17592186166939 :knowledge-point/id #uuid "ba4d320f-517e-5dc6-9c6d-02d1c2488472"} :step/id #uuid "4251a9bf-5cd3-5cfc-ae56-c1aa466b5998" :step/next {:db/id #edb/ref 17592186167903}} {:db/id #edb/ref 17592186167902 :step/content {:db/id #edb/ref 17592186166940 :knowledge-point/id #uuid "472cbb79-e22b-50d2-a997-93130ff66c22"} :step/id #uuid "dc1ec685-f38d-51a2-9240-4f3a1f1346e1"} {:db/id #edb/ref 17592186167903 :step/content {:db/id #edb/ref 17592186168038 :tutorial/content "When the auxiliary equation has purely imaginary roots, the solutions are trigonometric, and the boundary conditions usually force $\\lambda$ to take on a discrete set of values.\nSo, we again look for values of $\\lambda$ that allow a nontrivial solution.\n\nWe will now find the **eigenvalues** and **eigenfunctions** for the boundary value problem:\n\n$$\ny'' + 9\\lambda^2 y = 0, \\qquad y'(0) = 0, \\quad y(4) = 0, \\quad 0 \\leq x \\leq 4, \\quad \\lambda \\geq 0.\n$$\n\nWe consider two cases based on the value of $\\lambda,$ since they correspond to different forms of the general solution.\n\n**Case 1: $\\lambda = 0$**\n\nSetting $\\lambda = 0$ gives the equation $y'' = 0.$\nIntegrating this equation twice gives the general solution:\n\n$$\ny = Ax + B.\n$$\n\nTo apply the boundary conditions, we first find the derivative, $y' = A.$\n\n- Applying $y'(0) = 0$ gives $A = 0.$ The solution becomes $y = B.$\n\n- Applying $y(4) = 0$ then gives $B = 0.$\n\nThis yields the trivial solution $y \\equiv 0.$ Since an eigenfunction must be nontrivial, $\\lambda = 0$ is *not* an eigenvalue.\n\n**Case 2: $\\lambda > 0$**\n\nThe auxiliary equation is $m^2 + 9\\lambda^2 = 0,$ which has roots $m = \\pm 3i\\lambda.$\nThe general solution is therefore\n\n$$\ny = A\\cos (3\\lambda x) + B\\sin (3\\lambda x).\n$$\n\nNow we apply the boundary conditions. First, we find the derivative:\n\n$$\ny' = -3A\\lambda\\sin(3\\lambda x) + 3B\\lambda\\cos(3\\lambda x).\n$$\n\n- Applying the condition $y'(0) = 0$ yields:\n\n$$\n-3A\\lambda\\sin(0) + 3B\\lambda\\cos(0) = 0 \\quad\\implies\\quad 3B\\lambda = 0.\n$$\n\nSince we are in the case where $\\lambda > 0,$ this requires $B = 0.$ The solution simplifies to:\n\n$$\ny = A\\cos (3\\lambda x).\n$$\n\n- Next, applying the condition $y(4) = 0$ yields:\n \n\n$$\nA\\cos (12\\lambda) = 0.\n$$\n\n For a nontrivial solution, we must have $A \\neq 0,$ which means we require\n \n\n$$\n\\cos (12\\lambda) = 0.\n$$\n\n This condition is met when $12\\lambda$ is an odd multiple of $\\pi/2:$\n\n$$\n12\\lambda = \\dfrac{(2n+1)\\pi}{2}, \\quad \\text{for } n = 0, 1, 2, \\dots\n$$\n\nSolving for $\\lambda$ gives the set of **eigenvalues**:\n\n$$\n\\lambda_n = \\dfrac{(2n+1)\\pi}{24}.\n$$\n\nThe corresponding **eigenfunctions** are \n\n$$\ny_n(x) = A_n \\cos(3\\lambda_n x) , \\quad A_n \\in \\mathbb{R}.\n$$" :tutorial/id #uuid "2e52b01a-4f53-5d27-9984-dd731308d87d" :tutorial/math-academy-id 14650 :tutorial/title "Trigonometric Eigenfunctions"} :step/id #uuid "3e7ba88a-596c-53db-b70b-6b89ee975318" :step/next {:db/id #edb/ref 17592186167902}} {:db/id #edb/ref 17592186167958 :step/content {:db/id #edb/ref 17592186168055 :tutorial/content "Next, we consider the case $\\lambda \\neq 0.$\n\nTo find the fundamental solutions of \n\n$$\ny'' - 18\\lambda y' + 81\\lambda^2y  = 0,\n$$\n\nfor $\\lambda \\neq 0,$ we set $y = e^{m x}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-18\\lambda m+81{\\lambda }^{2} & =0 \\\\ (m-9\\lambda )(m-9\\lambda ) & =0.\\end{aligned}\n$$\n\nThis gives a repeated root $m = 9\\lambda.$ The general solution is\n\n$$\ny = Ae^{9\\lambda x} + Bxe^{9\\lambda x}.\n$$\n\nNow we apply the boundary conditions.\n\n- Applying the first boundary condition, $y(0) = 0,$ yields\n\n$$\ny(0) = Ae^{0} + B(0)e^{0} = 0 \\quad \\implies \\quad A = 0.\n$$\n\nSo, the solution simplifies to $y = Bxe^{9\\lambda x}.$ Its derivative is\n\n$$\ny' = Be^{9\\lambda x} + 9B\\lambda xe^{9\\lambda x}.\n$$\n\n- Applying the second boundary condition, $4y(3) + 5y'(3) = 0,$ yields\n\n$$\n\\begin{aligned}4(3B{e}^{27\\lambda })+5(B{e}^{27\\lambda }+27B\\lambda {e}^{27\\lambda }) & =0 \\\\ 12B{e}^{27\\lambda }+5B{e}^{27\\lambda }+135B\\lambda {e}^{27\\lambda } & =0 \\\\ B{e}^{27\\lambda }(17+135\\lambda ) & =0.\\end{aligned}\n$$\n\nFor a nontrivial solution (an eigenfunction), we require $B\\neq 0.$ Since $e^{27\\lambda}$ is never zero, we must have\n\n$$\n17+135\\lambda = 0 \\quad \\implies \\quad \\lambda = -\\dfrac{17}{135}.\n$$\n\nThis is our **eigenvalue**. The corresponding **eigenfunction** is\n\n$$\ny(x) = Bxe^{9(-17/135) x} = Bxe^{-17x/15}.\n$$\n\nNote that any nonzero constant multiple of this function is also an eigenfunction." :tutorial/id #uuid "f4d9fb35-7991-5b49-bfd6-c82ad2ef1c69" :tutorial/math-academy-id 14892 :tutorial/title "Non-Trivial Solution of the Eigenvalue Problem"} :step/id #uuid "81f0071e-ac02-5b8f-ba91-88209136e903" :step/next {:db/id #edb/ref 17592186167901}} {:db/id #edb/ref 17592186167959 :step/content {:db/id #edb/ref 17592186168056 :tutorial/content "We begin by considering  the case $\\lambda = 0.$\n\nSetting $\\lambda = 0$ in the original equation, $y'' - 18\\lambda y' + 81\\lambda^2y  = 0,$ gives a much simpler equation:\n\n$$\ny'' = 0.\n$$\n\nIntegrating this equation twice with respect to $x$ gives the general solution\n\n$$\ny = Ax + B.\n$$\n\nNow we apply the boundary conditions. \n\n- The first condition, $y(0) = 0,$ implies:\n\n$$\ny(0) = A(0) + B = 0 \\quad \\implies \\quad B=0.\n$$\n\nSo the solution must be of the form $y = Ax.$\n\n- For the second condition, we first find the derivative, $y' = A.$ Applying the condition $4y(3) + 5y'(3) = 0$ yields\n\n$$\n\\begin{aligned}4(A\\cdot 3)+5(A) & =0 \\\\ 12A+5A & =0 \\\\ 17A & =0\\,\\,⟹\\,\\,A=0.\\end{aligned}\n$$\n\nSince both $A=0$ and $B=0,$ we are left with the trivial solution $y \\equiv 0.$ By definition, an eigenfunction must be a *nontrivial* solution.\n\nTherefore, $\\lambda = 0$ is *not* an eigenvalue. \n\nNext, we will check the case where $\\lambda \\neq 0.$" :tutorial/id #uuid "b3458843-3f77-548b-b991-69c3d163d75d" :tutorial/math-academy-id 14893 :tutorial/title "Trivial Solution of the Eigenvalue Problem"} :step/id #uuid "d95ffe14-fb14-518a-ac26-6970a9d57acf" :step/next {:db/id #edb/ref 17592186167958}}] :activity/title "Eigenvalues and Eigenfunctions of Homogeneous BVPs" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186166995} {:activity/first-step {:db/id #edb/ref 17592186418250} :activity/id #uuid "eea1e25f-6efb-5cef-9851-420bd75de37e" :activity/steps [{:db/id #edb/ref 17592186418250 :step/content {:db/id #edb/ref 17592186365858 :question/id #uuid "c6e87982-ab6f-5e96-94e7-996ae7f3b605"} :step/id #uuid "10ec5288-96c7-54f4-a406-4dc3fa372454" :step/next {:db/id #edb/ref 17592186418254}} {:db/id #e