 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186238281} {:answer/id #uuid "34a8433c-bb92-59f3-b2ea-5d0fea8b8143" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186238510} {:answer/id #uuid "6a4d360e-40c5-5a55-845e-4a5cdcb9ec80" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186238977} {:answer/id #uuid "6e2b2d2b-da55-5df7-899f-d2b17f24e168" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{2} & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186239004} {:answer/id #uuid "feebc24b-1b56-5bef-bf97-dc99d60e8954" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186240312}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186238281} :answer-field/id #uuid "e2d81e66-4224-5518-ae03-7fa624c4d00b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240728}] :question/id #uuid "a30d0bfd-2f58-5762-aed6-b600ce6f58c0" :question/math-academy-id "q-105392" :question/problem "Find the inverse of the following matrix: \n\n$$\nA=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$" :question/worked-solution "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{\\begin{bmatrix}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{bmatrix}}^{-1}=\\begin{bmatrix}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{bmatrix}\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}}^{-1}=\\begin{bmatrix}\\frac{1}{2} & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186054999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e1af38-633a-57f4-9e71-85d2947b0d28" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186410549} {:answer/id #uuid "6811f6df-390d-51f5-bc0f-d96e7d661c36" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186410553} {:answer/id #uuid "92867a08-d171-5092-9bb8-8df51b376ab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186410554} {:answer/id #uuid "92dcfb35-90d5-5cef-b823-e951de3a78ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186410555} {:answer/id #uuid "edc9528f-0241-5970-b67a-4394965cb7d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & \\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{bmatrix}" :db/id #edb/ref 17592186410558}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186410553} :answer-field/id #uuid "58e6ab5e-8906-5de2-9159-242df4d0797a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410559}] :question/id #uuid "c20e2d6b-ec12-50bd-afe4-b9325272aef2" :question/math-academy-id "q-135354" :question/problem "Find the inverse of the following matrix: \n\n$$\nA=\\begin{bmatrix}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{bmatrix}\n$$" :question/worked-solution "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{\\begin{bmatrix}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{bmatrix}}^{-1}=\\begin{bmatrix}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{bmatrix}\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={\\begin{bmatrix}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{bmatrix}}^{-1}=\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186269028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f843c4d-b02c-542e-b719-908b56fa9463" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} & 0 & 0 \\\\ 0 & -\\frac{1}{4} & 0 \\\\ 0 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186266565} {:answer/id #uuid "31c7ee16-9258-56c6-bc6f-80d67d742487" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} & 0 & 0 \\\\ 0 & \\frac{1}{4} & 0 \\\\ 0 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186266582} {:answer/id #uuid "45a78678-efaa-508f-aad6-fec833d20bfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} & 0 & 0 \\\\ 0 & -4 & 0 \\\\ 0 & 0 & \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref