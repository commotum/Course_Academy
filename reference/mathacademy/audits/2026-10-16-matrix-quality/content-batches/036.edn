 {:db/id #edb/ref 17592186354441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c45aed-2bbc-54d4-b4e4-b6e2dc638cb1" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\sqrt{2}" :db/id #edb/ref 17592186351634} {:answer/id #uuid "0a592ef9-dfb8-51e7-acb8-ad7c547f3518" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186351657} {:answer/id #uuid "362e0eff-6109-552b-9df5-68dc07e9d67c" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186352071} {:answer/id #uuid "531691fc-36c2-5a15-8889-f0e39aa93c1d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186352311} {:answer/id #uuid "66428265-caa7-5dda-bb91-ab3a19ee18ab" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186352467}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-7\\sqrt{2}" :db/id #edb/ref 17592186351634} :answer-field/id #uuid "5572322f-d1bd-5823-956f-c46a53ff8a5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353964}] :question/id #uuid "81e19a7f-1aa2-5387-a0a2-afc232e386a1" :question/math-academy-id "q-85921" :question/problem "Given that $A=\\begin{bmatrix}-2\\sqrt{2} & \\sqrt{2} \\\\ 3 & 2\\end{bmatrix},$ find the product of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's Formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\left\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2} &=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2} &=\\text{det}(A).\\end{aligned}\\right.\n$$\n\nSo, the product of the eigenvalues of $A$ is equal to the determinant of $A.$ Therefore, \n\n$$\n\\begin{aligned}{\\lambda }_{1}\\cdot {\\lambda }_{2} & =det(A) \\\\  & =|\\begin{aligned}-2\\sqrt{2} & \\sqrt{2} \\\\ 3 & 2\\end{aligned}| \\\\  & =(-2\\sqrt{2})\\cdot 2-\\sqrt{2}\\cdot 3 \\\\  & =-4\\sqrt{2}-3\\sqrt{2} \\\\  & =-7\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a38ceb7-78e0-536d-b6f4-5b0d0fb36963" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186352364} {:answer/id #uuid "a0c95411-022b-5df9-be2d-f24fb668a56a" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186352943} {:answer/id #uuid "c2a3ef71-3f78-5e0f-8cd1-ac73a5157b36" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186353251} {:answer/id #uuid "c7f74d25-1c42-5e42-9c74-52425e6e436f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186353305} {:answer/id #uuid "f2ef4f6b-04cb-5b34-8ba0-40661d358f31" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186353690}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186353251} :answer-field/id #uuid "3028fca6-be53-57d1-86aa-5aa3f7020ab2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353898}] :question/id #uuid "9d05c0df-0883-5373-84c3-aa2cb3f54a04" :question/math-academy-id "q-85923" :question/problem "Given that $A=\\begin{bmatrix}5 & 2\\sqrt{5} \\\\ \\sqrt{5} & -3\\end{bmatrix},$ find the product of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's Formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2} &=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2} &=\\text{det}(A).\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the product of the eigenvalues of $A$ is equal to the determinant of $A.$ Therefore, \n\n$$\n\\begin{aligned}{\\lambda }_{1}\\cdot {\\lambda }_{2} & =det(A) \\\\  & =|\\begin{aligned}5 & 2\\sqrt{5} \\\\ \\sqrt{5} & -3\\end{aligned}| \\\\  & =5\\cdot (-3)-\\sqrt{5}\\cdot 2\\sqrt{5} \\\\  & =-15-10 \\\\  & =-25.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d65a687-0988-5518-994a-fcab04da4ebc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186430395} {:answer/id #uuid "4571d412-17c6-50e3-a5ad-250aba5664ee" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186430397} {:answer/id #uuid "8600afc6-a04f-52fd-8a1f-de56606615bb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430400} {:answer/id #uuid "cc2cc7ac-9a1b-526d-80a8-a3d8c973934c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186430404} {:answer/id #uuid "f2683b79-0149-589d-9aee-43b4a2b94124" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430406}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430406} :answer-field/id #uuid "c6843fb7-59e5-5002-ac90-2b5e6f7257b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430410}] :question/id #uuid "4a565f00-30b9-57be-9036-7aadde82bfe8" :question/math-academy-id "q-85922" :question/problem "Given that $A=\\begin{bmatrix}4 & \\sqrt{3} \\\\ 2\\sqrt{3} & -2\\end{bmatrix},$ find the sum of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2} &=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2} &=\\text{det}(A).\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the sum of the eigenvalues of $A$ is equal to the trace of $A.$ \n\nTherefore, \n\n$$\n{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A)=4-2=2.\n$$"} {:db/id #edb/ref 17592186486439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069c8840-8426-5a49-8cd5-194f9542f047" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186485779} {:answer/id #uuid "2e481c8d-1f08-54f2-a266-5bbd2762473f" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186485851} {:answer/id #uuid "93d03cdd-069e-5ebe-b2a7-900eec2dd6d2" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186486030} {:answer/id #uuid "a74c6630-89ff-50d5-a8b8-e49610f1abd9" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186486067} {:answer/id #uuid "b94c247d-0ad1-594f-abae-d08d3203dd0b" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186486099}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186486099} :answer-field/id #uuid "f58af114-b2ae-5846-9a75-5301fb89508f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486341}] :question/id #uuid "c746a2db-cfe0-519b-a0f3-936f85b88bb1" :question/math-academy-id "q-140520" :question/problem "Given that $A=\\begin{bmatrix}5 & 3 \\\\ -4 & 7\\end{bmatrix},$ find the product of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's Formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2} &=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2} &=\\text{det}(A).\\end{aligned}\\right.\\end{aligned}\n$$\n\nSo, the product of the eigenvalues of $A$ is equal to the determinant of $A.$ Therefore, \n\n$$\n\\begin{aligned}{\\lambda }_{1}\\cdot {\\lambda }_{2} & =det(A) \\\\  & =|\\begin{aligned}5 & 3 \\\\ -4 & 7\\end{aligned}| \\\\  & =5\\cdot 7-(-4)\\cdot 3 \\\\  & =35+12 \\\\  & =47.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29518f7d-c336-5d57-8db0-9a4b5ee70722" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186549405} {:answer/id #uuid "4c890fb7-5ad0-51ee-b262-8eccfdca2316" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186549472} {:answer/id #uuid "c15f40ae-67d9-59f5-916f-7f95aad7031a" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186549679} {:answer/id #uuid "dde652cb-50a6-5b2b-a8b3-f6fce0861332" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186549727} {:answer/id #uuid "de4777f6-8208-5517-8ce8-3d1cffc8e9b6" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186549728}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186549472} :answer-field/id #uuid "c74d7ddb-fc22-5cce-9d10-5c29a729de7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186549897}] :question/id #uuid "a0915342-2d27-50ea-9893-ae57d8dcc177" :question/math-academy-id "q-83392" :question/problem "Given that $A=[\\begin{aligned}-23 & -15 \\\\ 9 & 19\\end{aligned}],$ find the sum of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2}=\\text{det}(A).\\end{aligned}\\end{aligned}\n$$\n\nSo, the sum of the eigenvalues of $A$ is equal to the trace of $A.$ \n\nTherefore, \n\n$$\n{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A)=-23+19=-4.\n$$"}] :knowledge-point/title "Calculating the Sum and Product of Eigenvalues of a 2x2 Matrix"}] :topic/math-academy-id 1972 :topic/title "The Cayley-Hamilton Theorem"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186125368} :activity/id #uuid "ca8227e6-ef47-5702-8c4f-321ab31e8355" :activity/steps [{:db/id #edb/ref 17592186125368 :step/content {:db/id #edb/ref 17592186125899 :tutorial/content "Suppose that we have a straight line passing through the point $P(3,-1,7)$ and that's parallel to the direction vector ![](images/54/54405c5c6e2502e5174525c2ee36a99366a79933b47e316a09858f827fda8dae.svg) As we know, we can write the vector equation of the line as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}3 \\\\ -1 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ -3\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$\n\nUsing the vector equation above, we can create a set of **parametric equations** where we express a general point $(x,y,z)$ in terms of  the parameter $t.$\n\nIf we let ![](images/67/67b8360f90540ffb75d39717c375f0ef6e9a8a39cae5832c78957105e0d148b6.svg) be the position vector of the general point $(x,y,z),$ then the above equation can be written as\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}3 \\\\ -1 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -1 \\\\ 7\\end{bmatrix}+t\\begin{bmatrix}0 \\\\ 5 \\\\ -3\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -1+5t \\\\ 7-3t\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n![](images/64/64cf325014eff341673557321ef565e35988b836630f3fbeb52af8024d7aaad7.svg)\n\nThe equations in the above system are called the **parametric equations** of the straight line.\nGeometrically, the equation states that a point belongs to the line if and only if its coordinates have the form\n\n$$\n(3, \\: -1+5t, \\: 7-3t),\n$$\n\nwhere $t \\in (-\\infty, \\infty).$\n\n![](images/e2/e29ce95cdccb47b97578f6431a96e608f7af9f6709410b221ff517b436896608.png)" :tutorial/id #uuid "6ff73cc8-91a0-5a25-9c14-6e87496adac8" :tutorial/math-academy-id 9660 :tutorial/title "Introduction"} :step/id #uuid "de4015ef-1002-54f7-adee-e5eee4e87979" :step/next {:db/id #edb/ref 17592186125369}} {:db/id #edb/ref 17592186125369 :step/content {:db/id #edb/ref 17592186124498 :knowledge-point/id #uuid "f232aed9-1584-5e57-a881-226a6876384a"} :step/id #uuid "1c0d5ba6-1e60-5d4d-b42e-60ba32609db6" :step/next {:db/id #edb/ref 17592186125370}} {:db/id #edb/ref 17592186125370 :step/content {:db/id #edb/ref 17592186124499 :knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de"} :step/id #uuid "b5810a9c-9d11-54cc-9534-f5807fd71ff5" :step/next {:db/id #edb/ref 17592186125371}} {:db/id #edb/ref 17592186125371 :step/content {:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"} :step/id #uuid "83088d79-842b-5477-8d05-56eb6c96e451" :step/next {:db/id #edb/ref 17592186125372}} {:db/id #edb/ref 17592186125372 :step/content {:db/id #edb/ref 17592186124501 :knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"} :step/id #uuid "5a457aae-70d6-5725-8620-6593b8838a70"}] :activity/title "The Parametric Equations of a Line" :activity/type {:db/iden