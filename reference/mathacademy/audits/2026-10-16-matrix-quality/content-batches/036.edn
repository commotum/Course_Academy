\\\ y &=7t \\\\ z &=-7-3t\\end{aligned}\\right.\n$$\n\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to \n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}13-8t \\\\ 7t \\\\ -7-3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}13 \\\\ 0 \\\\ -7\\end{bmatrix}+\\begin{bmatrix}-8t \\\\ 7t \\\\ -3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}13 \\\\ 0 \\\\ -7\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 7 \\\\ -3\\end{bmatrix} \\\\ r & =\\begin{bmatrix}13 \\\\ 0 \\\\ -7\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 7 \\\\ -3\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] :knowledge-point/title "Finding the Vector Equation of a Straight Line Given Parametrically"} {:db/id #edb/ref 17592186124499 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124228 :question/id #uuid "7a6038c2-3f7b-5dfa-a9e2-256b246fcc20" :question/math-academy-id "e-15603" :question/problem "Consider the straight line given by the following parametric equations:\n![](images/7e/7e489d8b5dd4a2b8fde454dc57a91b0f0a28049c96b27ef76e9198f4967cb84d.svg)\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}5-t \\\\ 3 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-t \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ r & =\\begin{bmatrix}5 \\\\ 3 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$\n\nThis implies that the line passes through the point $(5,3,1)$ and is parallel to the vector ![](images/80/80cf9513aeb2ab2f87dda54ca16cdab76ff55024be1f7822fc9d1434b62382de.svg)"} :knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/questions [{:db/id #edb/ref 17592186124779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df5346d-2966-5621-a5f7-4d0c104072b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186412253} {:answer/id #uuid "3399bc79-2b67-5b83-87af-7604a8fccdc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ -7 \\\\ \\frac{1}{5}\\end{bmatrix}" :db/id #edb/ref 17592186412254} {:answer/id #uuid "477dde1b-8255-51b0-8585-d23e885143e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 7 \\\\ -\\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186412255} {:answer/id #uuid "bad600d9-2cbf-50b7-ab3f-443e1558ed42" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -5 \\\\ \\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186412256} {:answer/id #uuid "e0cb3c90-da08-5155-bc03-351fcfe80179" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186412257}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix}" :db/id #edb/ref 17592186412253} :answer-field/id #uuid "82f02e4f-8fa1-5737-a974-c8725a5027aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412258}] :question/id #uuid "6ab6a329-d125-54e3-98aa-c411b7b2d383" :question/math-academy-id "q-127045" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n\\left\\{\\begin{aligned}x &=3t-12 \\\\ y &=-5-7t \\\\ z &=\\frac{3}{4}t+\\frac{1}{5}\\end{aligned}\\right.\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3t-12 \\\\ -5-7t \\\\ \\frac{3}{4}t+\\frac{1}{5}\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-12 \\\\ -5 \\\\ \\frac{1}{5}\\end{bmatrix}+\\begin{bmatrix}3t \\\\ -7t \\\\ \\frac{3}{4}t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-12 \\\\ -5 \\\\ \\frac{1}{5}\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix} \\\\ r & =\\begin{bmatrix}-12 \\\\ -5 \\\\ \\frac{1}{5}\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $(-12,-5,\\frac{1}{5})$ and is parallel to the vector $v=\\begin{bmatrix}3 \\\\ -7 \\\\ \\frac{3}{4}\\end{bmatrix}.$"} {:db/id #edb/ref 17592186124855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbe680bc-3f29-5336-9143-ad5048335b32" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186121711} {:answer/id #uuid "0defcd1c-68a7-5562-9b77-c5330950ec34" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186121712} {:answer/id #uuid "5d0627cf-d8e2-54c2-b2aa-86a26726e14c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186121713} {:answer/id #uuid "60d0b110-e06b-526a-933c-74c198781d2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 4 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186121714} {:answer/id #uuid "618d7e2b-b432-593b-a17b-cc8d94651e63" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 4 \\\\ -1\\end{b