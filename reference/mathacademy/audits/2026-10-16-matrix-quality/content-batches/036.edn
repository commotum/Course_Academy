z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 3 \\\\ 5\\end{bmatrix}+\\begin{bmatrix}t \\\\ -5t \\\\ 6t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2+t \\\\ 3-5t \\\\ 5+6t\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are: \n\n$$\n\\left\\{\\begin{aligned}x &=2+t \\\\ y &=3-5t \\\\ z &=5+6t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186262704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b303939-05de-583e-8174-21d10e301064" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7+3t \\\\ y &=11+2t \\\\ z &=3-7t\\end{aligned}\\right." :db/id #edb/ref 17592186422830} {:answer/id #uuid "8e7b1f0e-6aee-53a0-9934-d5d64d9aadef" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7+3t \\\\ y &=-11+2t \\\\ z &=3-7t\\end{aligned}\\right." :db/id #edb/ref 17592186422846} {:answer/id #uuid "bddffa79-df45-5156-a1ce-3514e6387fb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7-3t \\\\ y &=-11+2t \\\\ z &=3+7t\\end{aligned}\\right." :db/id #edb/ref 17592186422887} {:answer/id #uuid "cabd9719-aff1-5cd5-b54b-f9260764be67" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7+3t \\\\ y &=11-2t \\\\ z &=3+7t\\end{aligned}\\right." :db/id #edb/ref 17592186422896} {:answer/id #uuid "df58bcd8-8519-5abd-864a-5386206d78bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7-3t \\\\ y &=-11-2t \\\\ z &=4+7t\\end{aligned}\\right." :db/id #edb/ref 17592186422909}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=7-3t \\\\ y &=-11+2t \\\\ z &=3+7t\\end{aligned}\\right." :db/id #edb/ref 17592186422887} :answer-field/id #uuid "4c40d077-b693-5acd-b033-066f298637d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262258}] :question/id #uuid "b0a75f14-5c7e-5e9b-9922-914a01571a2f" :question/math-academy-id "q-127065" :question/problem "Find the parametric equations of the straight line that passes through $P(7,-11,3)$ and is parallel to $v=⟨-3,2,7⟩.$" :question/worked-solution "First, the vector equation of the line is \n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}7 \\\\ -11 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -11 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}-3t \\\\ 2t \\\\ 7t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}7-3t \\\\ -11+2t \\\\ 3+7t\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n\\left\\{\\begin{aligned}x &=7-3t \\\\ y &=-11+2t \\\\ z &=3+7t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186290396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad0bcdc-1c9f-5d5b-bde3-6a7a1468a60a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3t \\\\ y &=2t \\\\ z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186288115} {:answer/id #uuid "4032c929-ae1e-5a9a-bfc0-40c65df386a4" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186288471} {:answer/id #uuid "742b5ec2-36e9-5c0c-bd21-d0a940b8463e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2+3t \\\\ y &=3+2t \\\\ z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186288839} {:answer/id #uuid "7bac3ac4-5639-5dc1-8b01-101c1daf600c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3+2t \\\\ y &=2+3t \\\\ z &=1\\end{aligned}\\right." :db/id #edb/ref 17592186288878} {:answer/id #uuid "85fc6fc5-3cca-59dc-a123-298205c9e025" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2t \\\\ y &=3t \\\\ z &=t\\end{aligned}\\right." :db/id #edb/ref 17592186288938}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2+3t \\\\ y &=3+2t \\\\ z &=0\\end{aligned}\\right." :db/id #edb/ref 17592186288839} :answer-field/id #uuid "febd5488-d14e-529f-9d31-38c00e560bd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290252}] :question/id #uuid "0bc84f55-88b7-5287-82db-f7f63be08b55" :question/math-academy-id "q-22296" :question/problem "Find the parametric equations of the straight line that passes through $P(2,3,0)$ and is parallel to $v=⟨3,\\,2,\\,0⟩.$" :question/worked-solution "First, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 3 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}3t \\\\ 2t \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2+3t \\\\ 3+2t \\\\ 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n\\left\\{\\begin{aligned}x &=2+3t \\\\ y &=3+2t \\\\ z &=0\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186290404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a5a3afe-de20-5eff-8acd-278f99180d3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3-t \\\\ y &=-2+t \\\\ z &=2+4t\\end{aligned}\\right." :db/id #edb/ref 17592186288546} {:answer/id #uuid "62953b2c-180e-5684-8312-080f1a4c3859" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=4t \\\\ y &=-3t \\\\ z &=-2t\\end{aligned}\\right." :db/id #edb/ref 17592186288721} {:answer/id #uuid "6a54827d-c7ce-534b-9371-072edb5b00b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-1+4t \\\\ y &=1-3t \\\\ z &=4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186288784} {:answer/id #uuid "c094fd28-4889-5b9c-b86c-cf25683234de" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=4-t \\\\ y &=-3+t \\\\ z &=-2+4t\\end{aligned}\\right." :db/id #edb/ref 17592186289307} {:answer/id #uuid "f6dedf7b-91ad-53cb-9328-647bbe4eb870" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-t \\\\ y &=t \\\\ z &=4t\\end{aligned}\\right." :db/id #edb/ref 17592186289661}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-1+4t \\\\ y &=1-3t \\\\ z &=4-2t\\end{aligned}\\right." :db/id #edb/ref 17592186288784} :answer-field/id #uuid "80150ea8-e109-5771-a019-7ef7f30cdd17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290010}] :question/id #uuid "903d4e8d-5aeb-56dc-9b7a-c2b3d8e18a20" :question/math-academy-id "q-22318" :question/problem "![](images/58/58076d96d149ff4521103fd15c7187bc1a58595ab20f28be92be0f79385aee61.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,1,4)$ and $Q(3,-2,2).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$,  as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}3 \\\\ -2 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 1 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ -3 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 4\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ -3 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}4t \\\\ -3t \\\\ -2t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1+4t \\\\ 1-3t \\\\ 4-2t\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n\\left\\{\\begin{aligned}x &=-1+4t \\\\ y &=1-3t \\\\ z &=4-2t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186302397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018df1e1-1c2a-53c7-aea3-a1c44c966b71" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3-t \\\\ y &=1+3t \\\\ z &=3+2t\\end{aligned}\\right." :db/id #edb/ref 17592186422742} {:answer/id #uuid "483591a0-f429-5fde-9a62-298d56345d72" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-t \\\\ y &=3t \\\\ z &=2t\\end{aligned}\\right." :db/id #edb/ref 17592186422790} {:answer/id #uuid "93eb3392-70bf-579f-9f36-4778325e3649" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=2-t \\\\ y &=4+3t \\\\ z &=5+2t\\end{aligned}\\right." :db/id #edb/ref 17592186422852} {:answer/id #uuid "efdfe867-7324-58f6-9d1c-0ac24a9c3f9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3t \\\\ y &=t \\\\ z &=3t\\end{aligned}\\right." :db/id #edb/ref 17592186422918} {:answer/id #uuid "f81bfe5f-a8ad-53cc-9700-e579155f4409" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-1+3t \\\\ y &=3+t \\\\ z &=2+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422924}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-1+3t \\\\ y &=3+t \\\\ z &=2+3t\\end{aligned}\\right." :db/id #edb/ref 17592186422924} :answer-field/id #uuid "371e7130-c050-59b2-8c27-7a7c79cf3390" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301402}] :question/id #uuid "00c48028-299a-590c-8308-e04090d60774" :question/math-academy-id "q-32817" :question/problem "![](images/1f/1ffc0945ea74b1bd467a0b9935ee28b88be004c18b11492d67ecdfec56e1bb09.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,2)$ and $Q(2,4,5).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}2 \\\\ 4 \\\\ 5\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 3 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 1 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}-1 \\\\ 3 \\\\ 2\\end{bmatrix}+t\\begin{bmatrix}3 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ 3 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}3t \\\\ t \\\\ 3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-1+3t \\\\ 3+t \\\\ 2+3t\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n\\left\\{\\begin{aligned}x &=-1+3t \\\\ y &=3+t \\\\ z &=2+3t\\end{aligned}\\right.\n$$"} {:db/id #edb/ref 17592186302398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0713f28c-733e-574c-aaee-8321c3d849e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-5+3t \\\\ y &=-11+6t \\\\ z &=-4+8t\\end{aligned}\\right." :db/id #edb/ref 17592186299966} {:answer/id #uuid "83ca0eb7-2564-5b64-8003-543c407ce696" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3t \\\\ y &=6t \\\\ z &=8t\\end{aligned}\\right." :db/id #edb/ref 17592186300616} {:answer/id #uuid "b23f1e47-3a80-54fa-9068-fde18e2dd192" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3-5t \\\\ y &=6-11t \\\\ z &=8-4t\\end{aligned}\\right." :db/id #edb/ref 17592186300851} {:answer/id #uuid "bed377fa-7eb5-5263-97c2-e5ab891dbc17" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-5t \\\\ y &=-11t \\\\ z &=-4t\\end{aligned}\\right." :db/id #edb/ref 17592186300915} {:answer/id #uuid "eb12d491-09ec-55b4-99bc-741047058f3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=-2+3t \\\\ y &=-5+6t \\\\ z &=4+8t\\end{aligned}\\right." :db/id #edb/ref 17592186301126}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\left\\{\\begin{aligned}x &=3-5t \\\\ y &=6-11t \\\\ z &=8-4t\\end{aligned}\\right." :db/id #edb/ref 17592186300851} :answer-field/id #uuid "bd817055-f058-595d-86b9-305020339602" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301844}] :question/id #uuid "add06203-1905-5fcf-9c44-6a4bc76cf55f" :question/math-academy-id "q-32818" :question/problem "![](images/99/99504eaa41497c5be9baa7c860c97ab5ba5c858609e47ad347f24ec9b8ffc940.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(3,6,8)$ and $Q(-2,-5,4).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}-2 \\\\ -5 \\\\ 4\\end{bmatrix}-\\begin{bmatrix}3 \\\\ 6 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 \\\\ -11 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}3 \\\\ 6 \\\\ 8\\end{bmatrix}+t\\begin{bmatrix}-5 \\\\ -11 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 6 \\\\ 8\\end{bmatrix}+\\begin{bmatrix}-5t \\\\ -11t \\\\ -4t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}3-5t \\\\ 6-11t \\\\ 8-4t\\end{bmatrix},\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n\\left\\{\\begin{aligned}x &=3-5t \\\\ y &=6-11t \\\\ z &=8-4t\\end{aligned}\\right.\n$$"}] :knowledge-point/title "Finding the Parametric Equations of a Line"} {:db/id #edb/ref 17592186124501 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124230 :question/id #uuid "a9c13555-9d30-5dfc-be5a-13f0597c2ada" :question/math-academy-id "e-15605" :question/problem "Find the parametric equations that describe all the points on the line segment $\\overline{PQ},$ where $P(1,-5,3)$ and $Q(0, 4, -4).$" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}0 \\\\ 4 \\\\ -4\\end{bmatrix}-\\begin{bmatrix}1 \\\\ -5 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 9 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}1 \\\\ -5 \\\\ 3\\end{bmatrix}+t\\begin{bmatrix}-1 \\\\ 9 \\\\ -7\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ -5 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}-t \\\\ 9t \\\\ -7t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1-t \\\\ -5+9t \\\\ 3-7t\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$ \n\nTo get the equations for the line segment, we take only $t \\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overline{PQ}$ are the following:\n![](images/48/4806a3eda16324e3216e0b21d4006daa37dedc7a36741c0bd2919b7eafccb05d.svg)"} :knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/questions [{:db/id #edb/ref 17592186124846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a1ed3b7-02bb-5f9d-9c31-7eddaa80fb8d" :answer/type {:db/ident :answer.type/math} :answer/value "-2+3t" :db/id #edb/ref 17592186288545}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-2+3t" :db/id #edb/ref 17592186288545} :answer-field/id #uuid "35127a82-230c-5025-ac87-eb4dafe53c72" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289844} {:answer-field/choices [{:answer/id #uuid "a2292b4c-0ec4-5867-a7de-bf2a67a209e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289115}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289115} :answer-field/id #uuid "6cd8b28a-ec40-5b78-9910-db2d429ee40b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289969} {:answer-field/choices [{:answer/id #uuid "ee2a1d96-a32c-5a2f-8cd6-6537695d26a3" :answer/type {:db/ident :answer.type/math} :answer/value "1-3t" :db/id #edb/ref 17592186289601}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1-3t" :db/id #edb/ref 17592186289601} :answer-field/id #uuid "b8e6d5ec-636b-572a-8af3-3a4e8d1a2fd5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290135}] :question/id #uuid "a9a10a92-511c-5609-8370-301fff1b284f" :question/math-academy-id "q-236389" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(1,4,-2)$ and $Q(-2,3,1).$\n\n| $x=$ | {{field-1}} | $t\\in [0,$ {{field-2}} $]$ |\n| --- | --- | --- |\n| $y=$ | $4-t$ |  |\n| $z=$ | {{field-3}} |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}-2 \\\\ 3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 \\\\ -1 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}+t\\begin{bmatrix}-3 \\\\ -1 \\\\ 3\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}-3t \\\\ -t \\\\ 3t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}1-3t \\\\ 4-t \\\\ -2+3t\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=1-3t \\\\ y &=4-t \\\\ z &=-2+3t\\end{aligned}\\right.\\,\\,t\\in [0,1]\n$$"} {:db/id #edb/ref 17592186124847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7824f178-edb8-50b7-af7f-1c20209da71b" :answer/type {:db/ident :answer.type/math} :answer/value "-5+t" :db/id #edb/ref 17592186288859}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5+t" :db/id #edb/ref 17592186288859} :answer-field/id #uuid "a7de61a6-0173-5804-b964-ab226d5ed144" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290104} {:answer-field/choices [{:answer/id #uuid "df8d42ea-9e9c-5df8-83f1-01576487bff8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289522}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289522} :answer-field/id #uuid "e5f3e076-f64d-55e8-a2f0-ee84c6fe1919" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290215}] :question/id #uuid "ca21829b-f75e-5a9d-97e2-6ce18378c4e6" :question/math-academy-id "q-236986" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(-5,7,1)$ and $Q(-4,-1,6).$\n\n| $x=$ | {{field-1}} | $t\\in [$ {{field-2}} $,1]$ |\n| --- | --- | --- |\n| $y=$ | $7-8t$ |  |\n| $z=$ | $1+5t$ |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =\\begin{bmatrix}-4 \\\\ -1 \\\\ 6\\end{bmatrix}-\\begin{bmatrix}-5 \\\\ 7 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -8 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}-5 \\\\ 7 \\\\ 1\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ -8 \\\\ 5\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-5 \\\\ 7 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}t \\\\ -8t \\\\ 5t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-5+t \\\\ 7-8t \\\\ 1+5t\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=-5+t \\\\ y &=7-8t \\\\ z &=1+5t\\end{aligned}\\right.\\,\\,t\\in [0,1]\n$$"} {:db/id #edb/ref 17592186290479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51453446-4eac-53d1-886a-97ade44372a7" :answer/type {:db/ident :answer.type/math} :answer/value "5+2t" :db/id #edb/ref 17592186288596}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5+2t" :db/id #edb/ref 17592186288596} :answer-field/id #uuid "2ad89bd4-b08a-5a72-835d-1c90077d0a8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289829} {:answer-field/choices [{:answer/id #uuid "57e6c9d0-0a21-58aa-a326-e7d97383f8a5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288643}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288643} :answer-field/id #uuid "2c68e26c-2a49-5627-a8bb-4b00955f9423" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289832} {:answer-field/choices [{:answer/id #uuid "338c29c7-6dd8-5584-b7d9-c226ef8fb4b7" :answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186288369}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186288369} :answer-field/id #uuid "8b910820-4a10-5203-9e55-4367cfc30c20" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290034}] :question/id #uuid "5b1acf6e-f29c-5db3-8b9e-c15a932f812b" :question/math-academy-id "q-236980" :question/prob