d{bmatrix}\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ 5 \\\\ -2\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 1 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}t \\\\ 5t \\\\ -2t\\end{bmatrix} \\\\ \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}2+t \\\\ 1+5t \\\\ -3-2t\\end{bmatrix}\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n\\left\\{\\begin{aligned}x &=2+t \\\\ y &=1+5t \\\\ z &=-3-2t\\end{aligned}\\right.\\,\\,t\\in [0,1]\n$$"} {:db/id #edb/ref 17592186290481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b42e1a2d-a402-5c3d-a958-6a8b38d21d15" :answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186289222}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186289222} :answer-field/id #uuid "3e4d8e6f-3b1d-566a-9526-6c671c9bab56" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289868} {:answer-field/choices [{:answer/id #uuid "32c75b66-154a-5ff3-bcee-0c0ec9307b2c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288366}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288366} :answer-field/id #uuid "cd56fa8a-5a4c-5ab7-b4de-fa10b9e580f3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290178} {:answer-field/choices [{:answer/id #uuid "1d