an=\"9\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{3}\\phantom{|}\\,\\,}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$7x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n</tbody></table>\n\nTherefore, we can write ${x}^{3}$ as \n\n$$\n\\begin{aligned}{x}^{3} & =q(x)p(x)+(7x-6),\\end{aligned}\n$$\n\nwhere $q(x)=x-1.$  Replacing $x$ with $A,$ we have\n\n$$\n{A}^{3}=q(A)p(A)+(7A-6I).\n$$\n\nNow, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}{A}^{3} & =q(A)p(A)+(7A-6I) \\\\  & =q(A)\\cdot O+(7A-6I) \\\\  & =7A-6I.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c52bd4-76d8-5cfe-8125-60f3edd92a1e" :answer/type {:db/ident :answer.type/math} :answer/value "-A-3I" :db/id #edb/ref 17592186321522} {:answer/id #uuid "5df2621e-e2bc-593f-bda1-8c039e99ab00" :answer/type {:db/ident :answer.type/math} :answer/value "-39A-40I" :db/id #edb/ref 17592186321889} {:answer/id #uuid "61c84397-8ec0-5980-a5c0-eda0d7940472" :answer/type {:db/ident :answer.type/math} :answer/value "-40A-39I" :db/id #edb/ref 17592186321911} {:answer/id #uuid "a0b4971a-0915-56a7-a2c8-8422b8d370e8" :answer/type {:db/ident :answer.type/math} :answer/value "-4A-9I" :db/id #edb/ref 17592186322414} {:answer/id #uuid "bbaf88d3-a76e-5911-9753-d516f9f802ab" :answer/type {:db/ident :answer.type/math} :answer/value "-40A