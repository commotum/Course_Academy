b/ref 17592186292327} {:answer-field/choices [{:answer/id #uuid "8b2155ed-ce39-5c53-adf9-81751cfde80c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291222}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291222} :answer-field/id #uuid "d2d1b550-8057-5ab1-8ce9-955422e151fa" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292375} {:answer-field/choices [{:answer/id #uuid "c4bbf2d7-dbe8-5e52-aa68-ba4aaaae9168" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291478}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291478} :answer-field/id #uuid "e78c2a0b-dccd-57b8-8f64-28ae0aa42ab4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292458}] :question/id #uuid "6ffe9059-1d2e-581a-a3e4-835bb9187e97" :question/math-academy-id "q-275723" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(1,2)$ and $B(-1,0).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$\n\n${A}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{B}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=\\begin{bmatrix}1 & -1 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -2 \\\\ 3 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(2,3)$ and ${B}^{′}(-2,-1).$"} {:db/id #edb/ref 17592186295199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b14dc0-bf2a-5c57-b878-689a835bba23" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293167}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293167} :answer-field/id #uuid "6bffc1fd-43bb-5fe7-b392-9957c19b2617" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294308} {:answer-field/choices [{:answer/id #uuid "1f401c47-f045-567a-a6f8-e67f2532b33e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293062}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293062} :answer-field/id #uuid "af20bde4-7f48-5c2f-8c07-a914622a047d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294556} {:answer-field/choices [{:answer/id #uuid "8c1c4704-2410-5bcb-96da-0636a5956ef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293475}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186293475} :answer-field/id #uuid "f0d87375-fce2-5516-97bd-f76ca22dfba7" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294774} {:answer-field/choices [{:answer/id #uuid "ce5a19f2-946d-539d-91b9-1faf1e7163c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293730}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293730} :answer-field/id #uuid "f4291ae7-c3f3-552f-a5e6-4cf6c36f6cbd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294788}] :question/id #uuid "5ebc7843-5c4b-5817-bcef-0dd42f19ba23" :question/math-academy-id "q-281528" :question/problem "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nA line segment $\\overset{―}{RS}$ has endpoints at $R(0,2)$ and $S(-1,1).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{R}^{′}{S}^{′}}$, the image of $\\overset{―}{RS}$ under the action of $T?$\n\n${R}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{S}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{RS}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{RS}:$\n\n$$\nX=\\begin{bmatrix}0 & -1 \\\\ 2 & 1\\end{bmatrix}.\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =\\begin{bmatrix}2 & 1 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${R}^{′}(2,0)$ and ${S}^{′}(-1,-1).$"} {:db/id #edb/ref 17592186295200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fedb3827-c05d-51ec-b522-c1ef2741da47" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293928}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293928} :answer-field/id #uuid "849b3d64-f960-5a2c-94ad-42f9c1866d17" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294403} {:answer-field/choices [{:answer/id #uuid "d76b0360-7de5-5e71-9307-8b26973a38e4