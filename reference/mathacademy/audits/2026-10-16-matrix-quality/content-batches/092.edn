type/math} :answer/value "b" :db/id #edb/ref 17592186298166} {:answer/id #uuid "9a71b385-f680-520d-8206-53aec1a5fe84" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186298227} {:answer/id #uuid "9e0a824a-5921-5804-8b3b-dd0c558367cd" :answer/type {:db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186298245} {:answer/id #uuid "f290487a-0f85-52a8-86a0-71b58d8df2db" :answer/type {:db/ident :answer.type/math} :answer/value "{I}_{3}" :db/id #edb/ref 17592186298581}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186298227} :answer-field/id #uuid "d7ba2f28-0cf0-5b78-bbdb-244572b42fd2" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186299368}] :question/id #uuid "cce553b5-2cba-5d0f-a25a-d7275ae86d94" :question/math-academy-id "q-317900" :question/problem "Consider a system of $3$ linear equations in $3$ variables, written in matrix form as $A\\,x=b.$ Here, $A$ is the non-singular coefficient matrix of the system, $x$ is the column vector containing the variables, and $b$ is the column vector containing the constants. What are the missing parts of the derivation method shown below to find the unique solution of the system?\n\n$$\nA\\,x={{field-1}}\n$$\n\n$$\n{{field-2}}\\,x={A}^{-1}\\,b\n$$\n\n$$\n{I}_{3}\\,x={A}^{-1}\\,{{field-3}}\n$$\n\n$$\n{{field-4}}={A}^{-1}\\,b\n$$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A\\,x=b$ by ${A}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}A\\,x & =b \\\\ {A}^{-1}A\\,x & ={A}^{-1}\\,b \\\\ {I}_{3}\\,x & ={A}^{-1}\\,b \\\\ x & ={A}^{-1}\\,b\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb59256-faa5-5ad3-b2fe-f7b75d71db0d" :answer/type {:db/ident :answer.type/math} :answer/value "x=d\\,{A}^{-1}B" :db/id #edb/ref 17592186345738} {:answer/id #uuid "7253d35c-a6d5-5c5f-a4b7-58a916c10d15" :answer/type {:db/ident :answer.type/math} :answer/value "x=B\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186346364} {:answer/id #uuid "7bbd7868-583e-5e5a-a7e5-a8de90460397" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}\\,d\\,B" :db/id #edb/ref 17592186346432} {:answer/id #uuid "7e2b6f01-9291-5935-a7bd-8712d8cbedc8" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346458} {:answer/id #uuid "b30dced6-1576-5624-9b88-1dbf56a53795" :answer/type {:db/ident :answer.type/math} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186346912}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346458} :answer-field/id #uuid "d5f5277f-d934-5f2d-955d-eb87da03a792" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347982}] :question/id #uuid "965d5436-f626-561d-a5b2-d748337bc2e9" :question/math-academy-id "q-78563" :question/problem "Consider a matrix equation $A\\,x=B\\,d,$ where $A$ and $B$ are $5\\times 5$ non-singular matrices, while $x$ and $d$ are $5\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A\\,x=B\\,d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A\\,x & =B\\,d \\\\ {A}^{-1}A\\,x & ={A}^{-1}B\\,d \\\\ {I}_{5}\\,x & ={A}^{-1}B\\,d \\\\ x & ={A}^{-1}B\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2e1840-656f-5d09-914f-fa87680d6d78" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186345734} {:answer/id #uuid "999daa5e-953d-570a-88ad-ac903e12a527" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186346691} {:answer/id #uuid "a584625b-05f4-5fd6-9021-75af32f04a1c" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d{B}^{-1}" :db/id #edb/ref 17592186346796} {:answer/id #uuid "a869610b-9a55-5e22-bb22-2877bb3eaa87" :answer/type {:db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186346816} {:answer/id #uuid "b1d44a04-3542-5c1b-bc39-320fe0394f64" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,B" :db/id #edb/ref 17592186346903}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186345734} :answer-field/id #uuid "d1e47356-343d-5854-97f7-2a6e55bf26f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347972}] :question/id #uuid "ca3e3737-a21e-5b56-9a09-c2270bc2ca79" :question/math-academy-id "q-78569" :question/problem "Consider a matrix equation ${B}^{-1}\\,x=A\\,d,$ where $A$ and $B$ are $9\\times 9$ non-singular matrices, while $x$ and $d$ are $9\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${B}^{-1}\\,x=A\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & =A\\,d \\\\ B{B}^{-1}\\,x & =BA\\,d \\\\ {I}_{9}\\,x & =BA\\,d \\\\ x & =BA\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6788781d-31d5-5bd7-b27b-68afaa4d9325" :answer/type {:db/ident :answer.type/math} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186346254} {:answer/id #uuid "9bded5b5-b83d-570e-9629-cd29113e20b5" :answer/type {:db/ident :answer.type/math} :answer/value "x=B\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186346708} {:answer/id #uuid "a4a497d7-ea8a-5a5f-b4fd-1d8c483ff5a2" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346783} {:answer/id #uuid "b6d2cc68-86a2-5604-8401-931a07c9e6b8" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186346945} {:answer/id #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" :answer/type {:db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347} :answer-field/id #uuid "b4e01459-2873-55b9-8f7c-c4fb473002de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347921}] :question/id #uuid "5f0cd9e3-58c9-5ff5-838e-38f22a6e88cb" :question/math-academy-id "q-78570" :question/problem "Consider a matrix equation ${A}^{-1}\\,x=B\\,d,$ where $A$ and $B$ are $7\\times 7$ non-singular matrices, while $x$ and $d$ are $7\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}\\,x=B\\,d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}\\,x & =B\\,d \\\\ A{A}^{-1}\\,x & =AB\\,d \\\\ {I}_{7}\\,x & =AB\\,d \\\\ x & =AB\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cc2958-af82-53db-836a-0fa572caee02" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186345570} {:answer/id #uuid "96cd9892-56a6-58c9-82a4-aa1ff94312ea" :answer/type {:db/ident :answer.type/math} :answer/value "x=A{B}^{-1}\\,d" :db/id #edb/ref 17592186346670} {:answer/id #uuid "d83ac6fa-2517-55d2-90c9-54c1c018a3d2" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186347254} {:answer/id #uuid "e33c6013-702a-50c8-8c1d-baf667c70eb3" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186347349} {:answer/id #uuid "e52e2551-8284-5893-bd99-5833eb739076" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}\\,d\\,A" :db/id #edb/ref 17592186347368}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186347254} :answer-field/id #uuid "8ad454f3-99c8-5b85-9fd9-5eecb8694b8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347847}] :question/id #uuid "32091250-7948-5edf-837b-f686a992a102" :question/math-academy-id "q-78571" :question/problem "Consider a matrix equation $A\\,x={B}^{-1}\\,d,$ where $A$ and $B$ are $2\\times 2$ non-singular matrices, while $x$ and $d$ are $2\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A\\,x={B}^{-1}\\,d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A\\,x & ={B}^{-1}\\,d \\\\ {A}^{-1}A\\,x & ={A}^{-1}{B}^{-1}\\,d \\\\ {I}_{2}\\,x & ={A}^{-1}{B}^{-1}\\,d \\\\ x & ={A}^{-1}{B}^{-1}\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366c6653-367a-59a7-84cb-6ee9c7105259" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393858} {:answer/id #uuid "7cdfd0ed-3fe5-5b86-87d3-32bcacf5d620" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186393859} {:answer/id #uuid "14be786b-6205-5224-9e4e-5339226f55dd" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186393860} {:answer/id #uuid "5efc90ca-87fe-57c3-ba7c-64fc159ed6b6" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393861} {:answer/id #uuid "3969bfd8-042f-5db5-aa6d-bb90db966f17" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}\\,d\\,B" :db/id #edb/ref 17592186393862}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393861} :answer-field/id #uuid "0e367af9-44e1-5186-9afd-a825a6fad5d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393857}] :question/id #uuid "ecb9056c-9932-5a89-8f17-1df1e929dfe8" :question/math-academy-id "q-78445" :question/problem "Consider a matrix equation $AB\\,x=d,$ where $A$ and $B$ are $4\\times 4$ non-singular matrices, while $x$ and $d$ are $4\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $AB\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}AB\\,x & =d \\\\ {A}^{-1}AB\\,x & ={A}^{-1}\\,d \\\\ {I}_{4}B\\,x & ={A}^{-1}\\,d \\\\ B\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x={A}^{-1}\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ {I}_{4}\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ x & ={B}^{-1}{A}^{-1}\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfb9e7b-0f96-52bc-8348-6c0d6f9ba989" :answer/type {:db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186393893} {:answer/id #uuid "d5398128-e22c-5b5f-92b9-e65712906c71" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393894} {:answer/id #uuid "3b931214-8c31-51a5-9560-c552952dcaa4" :answer/type {:db/ident :answer.type/math} :answer/value "x=d\\,AB" :db/id #edb/ref 17592186393895} {:answer/id #uuid "29ab2774-f7be-5352-8b96-05d271f68d3d" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186393896} {:answer/id #uuid "cdf010f2-d5ab-5f4c-934d-e157995906f2" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393897}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393894} :answer-field/id #uuid "ede05a98-17ce-5670-a287-9b512d09f89c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393892}] :question/id #uuid "e9038fac-5f35-5ebb-bf51-e55eda35beaa" :question/math-academy-id "q-78566" :question/problem "Consider a matrix equation ${A}^{-1}{B}^{-1}\\,x=d,$ where $A$ and $B$ are $3\\times 3$ non-singular matrices, while $x$ and $d$ are $3\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}{B}^{-1}\\,x=d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}{B}^{-1}\\,x & =d \\\\ A{A}^{-1}{B}^{-1}\\,x & =A\\,d \\\\ {I}_{3}{B}^{-1}\\,x & =A\\,d \\\\ {B}^{-1}\\,x & =A\\,d.\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of the equation ${B}^{-1}\\,x=A\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & =A\\,d \\\\ B{B}^{-1}\\,x & =BA\\,d \\\\ {I}_{3}\\,x & =BA\\,d \\\\ x & =BA\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f188d035-264a-5a84-960f-7777553b0e05" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,{B}^{-1}" :db/id #edb/ref 17592186393900} {:answer/id #uuid "e9b99b9b-8aea-5b21-b666-f2b5972647d5" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393901} {:answer/id #uuid "03b50807-020a-5cac-b35c-77e42daa0304" :answer/type {:db/ident :answer.type/math} :answer/value "x=A{B}^{-1}\\,d" :db/id #edb/ref 17592186393902} {:answer/id #uuid "eb50426c-3288-5b08-aec6-d84bf2186543" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186393903} {:answer/id #uuid "516626d3-a681-5f04-b08f-b2800b9b0239" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393904}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186393903} :answer-field/id #uuid "949387db-f0bb-576c-92cd-6be88553f987" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393899}] :question/id #uuid "0ec9f7c8-9125-5a99-8012-bc8baca62664" :question/math-academy-id "q-78567" :question/problem "Consider a matrix equation ${A}^{-1}B\\,x=d,$ where $A$ and $B$ are $6\\times 6$ non-singular matrices, while $x$ and $d$ are $6\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}B\\,x=d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}B\\,x & =d \\\\ A{A}^{-1}B\\,x & =A\\,d \\\\ {I}_{6}B\\,x & =A\\,d \\\\ B\\,x & =A\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x=A\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & =A\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}A\\,d \\\\ {I}_{6}\\,x & ={B}^{-1}A\\,d \\\\ x & ={B}^{-1}A\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb6862b-40a4-553e-b127-875a257430ff" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393907} {:answer/id #uuid "c37e5a61-c2eb-538b-99a7-23642c14b38b" :answer/type {:db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186393908} {:answer/id #uuid "8ee481b4-326b-5845-a01e-35c02639b453" :answer/type {:db/ident :answer.type/math} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186393909} {:answer/id #uuid "8395c955-c031-5153-8925-7f64e907dff2" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393910} {:answer/id #uuid "85a30c66-8a0b-5199-9181-20081d9e024c" :answer/type {:db/ident :answer.type/math} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186393911}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186393911} :answer-field/id #uuid "fd860ae1-dad5-535f-9702-2f27d023f02d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393906}] :question/id #uuid "434e4ac4-2d0e-5134-b4d8-984f36cd5b9a" :question/math-academy-id "q-78568" :question/problem "Consider a matrix equation $A{B}^{-1}\\,x=d,$ where $A$ and $B$ are $5\\times 5$ non-singular matrices, while $x$ and $d$ are $5\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A{B}^{-1}\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A{B}^{-1}\\,x & =d \\\\ {A}^{-1}A{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {I}_{5}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of the equation ${B}^{-1}\\,x={A}^{-1}\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ B{B}^{-1}\\,x & =B{A}^{-1}\\,d \\\\ {I}_{5}\\,x & =B{A}^{-1}\\,d \\\\ x & =B{A}^{-1}\\,d.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186403947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403948}] :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}c \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{I}_{n}}}}z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"} {:db/id #edb/ref 17592186403954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f916d57-a48d-5f42-a1e6-2cc8f554dc1a" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $q$" :db/id #edb/ref 17592186403956} {:answer/id #uuid "a2636cd7-9981-5e94-8ce6-ffc7ac605d47" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $t$" :db/id #edb/ref 17592186403957} {:answer/id #uuid "cd887cdb-1f42-5d46-bc3e-089ab176ac9d" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403958} {:answer/id #uuid "e14838e1-6770-514b-a8d3-264fece5dc27" :answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403959} {:answer/id #uuid "45769dbd-ae3d-5976-b913-0ac9c72c7a88" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ and $q$" :db/id #edb/ref 17592186403960}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $q$" :db/id #edb/ref 17592186403956} :answer-field/id #uuid "96efe5ef-8066-599a-a9a3-934df32a5fcd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403955}] :question/id #uuid "ecf8e0a5-c1dd-5243-9116-de59a516e7ec" :question/math-academy-id "q-78561" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,t=q.$ Here, $D$ is the non-singular coefficient matrix of the system, $t$ is the column vector containing the variables, and $q$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\,\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{\\mathbf{q}}}} \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nFrom top to bottom and left to right, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,t=q$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,t & =q \\\\ {D}^{-1}D\\,t & ={D}^{-1}\\,q \\\\ {I}_{n}\\,t & ={D}^{-1}\\,q \\\\ t & ={D}^{-1}\\,q\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and $q.$"} {:db/id #edb/ref 17592186435148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a64a01b-e02d-535d-a027-6746b0121352" :answer/type {:db/ident :answer.type/math} :answer/value "x=A{B}^{-1}\\,d" :db/id #edb/ref 17592186435133} {:answer/id #uuid "7539810a-78b4-56d6-8b1e-ddb5c34343c1" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,B" :db/id #edb/ref 17592186435136} {:answer/id #uuid "8afcf5b9-6023-5abe-9e32-15e5a0353825" :answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186435137} {:answer/id #uuid "b14cf1e4-785f-5b17-867e-45e5d7cc5a9f" :answer/type {:db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186435138} {:answer/id #uuid "e12ef937-d966-5968-a2bc-5cb307c85739" :answer/type {:db/ident :answer.type/math} :answer/value "x=A\\,d\\,{B}^{-1}" :db/id #edb/ref 17592186435141}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186435137} :answer-field/id #uuid "3722cf83-66cd-54b2-a5b1-3a7fa87b1c56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435144}] :question/id #uuid "0c58ffa5-e4d4-5bf5-8b35-8a71f48534ba" :question/math-academy-id "q-78565" :question/problem "Consider a matrix equation $B\\,x=A\\,d,$ where $A$ and $B$ are $2\\times 2$ non-singular matrices, while $x$ and $d$ are $2\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x=A\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & =A\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}A\\,d \\\\ {I}_{2}\\,x & ={B}^{-1}A\\,d \\\\ x & ={B}^{-1}A\\,d.\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :topic/math-academy-id 1023 :topic/title "Solving Systems of Equations Using Inverse Matrices"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186153168} :activity/id #uuid "2d6eb053-cae1-5c17-b076-ba71324db2b8" :activity/steps [{:db/id #edb/ref 17592186153168 :step/content {:db/id #edb/ref 17592186153410 :tutorial/content "Let $A$ be an  $m \\times m$ matrix. Recall that a nonzero vector $\\mathbf{v}_1$ is an eigenvector of $A$ corresponding to the eigenvalue $\\lambda$ if\n\n$$\nA\\mathbf{v}_1 = \\lambda \\mathbf{v}_1.\n$$\n\nWe can write this equation as \n\n$$\n(A - \\lambda I) \\mathbf{v}_1 = \\mathbf{0}.\n$$\n\nTherefore, the matrix $A-\\lambda I$ maps the vector $\\mathbf{v}_1$ to the zero vector $\\mathbf{0}{:}$\n\n$$\n\\mathbf{v}_1 \\xrightarrow{A- \\lambda I} \\mathbf{0}\n$$\n\nNow suppose that there exists a nonzero vector $\\mathbf v_2$ that is mapped to the zero vector in *two* steps by the matrix $A-\\lambda I.$ That is,\n\n$$\n(A-\\lambda I)\\mathbf v_2 = \\mathbf v_1 \\qquad \\textrm{and}\\qquad (A-\\lambda I)\\mathbf v_1 = \\mathbf 0,\n$$\n\nwhere $\\mathbf v_1$ is an eigenvector of $A$ corresponding to the eigenvalue $\\lambda.$\n\nWe can represent this schematically as a chain of mappings, as follows:\n\n$$\n\\mathbf{v}_2 \\xrightarrow{A- \\lambda I} \\mathbf{v}_{1} \\xrightarrow{A- \\lambda I}  \\mathbf{0}\n$$\n\nWe call $\\mathbf v_2$ a **generalized eigenvector of rank** $2$ because it is mapped to the zero vector in two steps. \n\nBy the same idea, an eigenvector of $A$ is a generalized eigenvector of rank $1$ because it is mapped to the zero vector in one step." :tutorial/id #uuid "88994c46-d16a-531c-895a-e2c3fdddfc1f" :tutorial/math-academy-id 5419 :tutorial/title "Introduction"} :step/id #uuid "70c56d2e-edef-5c66-b434-a79d78754fe4" :step/next {:db/id #edb/ref 17592186153172}} {:db/id #edb/ref 17592186153169 :step/content {:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c"} :step/id #uuid "3ba3a9ff-1652-5e2f-a17b-31f53f5fa7ce" :step/next {:db/id #edb/ref 17592186153173}} {:db/id #edb/ref 17592186153170 :step/content {:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913"} :step/id #uuid "4c7afd25-604b-599f-93ac-e074a6562587" :step/next {:db/id #edb/ref 17592186153171}} {:db/id #edb/ref 17592186153171 :step/content {:db/id #edb/ref 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da"} :step/id #uuid "c580f07b-112f-562a-a89e-5d7287e732f7"} {:db/id #edb/ref 17592186153172 :step/content {:db/id #edb/ref 17592186153411 :tutorial/content "Consider the matrix $A$ and the vector $\\mathbf v,$ given by\n![](images/86/866c306428d7726f8078af9f608a839d6f4971a4a3e368e84d023503ea22ba82.svg)\nThe matrix $A$ has only one eigenvalue, namely $\\lambda = 3.$ Let's show that $\\mathbf v$ is a generalized eigenvector of rank $2$ corresponding to this eigenvalue.\n\n- First, we compute $A-3I{:}$\n![](images/b7/b7bcc3d7905efb5425f9ad2e840d574a0c613b3fbdd65742b24608d8f17fcf1b.svg)\n\n- Next, we find the image of $\\mathbf{v}$ under the action of $A-3I{:}$\n![](images/df/df135de6113520b548112c1b8cd9f77d51d99c9b1c5ee3d35f0ab4ce1f6f500e.svg)\n\n- Since we got a nonzero vector in the last step, we now compute the image of $\\mathbf{w}$ under the action of $A-3I{:}$\n![](images/d2/d24081710386fa3719b171bc47f5d10ff12ddecdd0f9fa5da6d5ef4926b9c3e3.svg)\n\nSo, we obtain the following chain of maps:\n\n![](images/90/9041ec615dce97097d94d895e6668e4b97096fd91ad47947fac7f7841c739c9d.svg)\n\nAs we can see,  $A-3I$ maps $\\mathbf{v}$ to $\\mathbf{0}$ in $2$ steps.\n\nTherefore, we conclude that $\\mathbf{v}$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda=3$ of $A.$" :tutorial/id #uuid "398d8883-81a4-5080-8b00-904f74cdef07" :tutorial/math-academy-id 5587 :tutorial/title "An Example of a Generalized Eigenvector of Rank Two for a 2x2 Matrix"} :step/id #uuid "3ec840df-f049-5126-988c-9c7bbb99172d" :step/next {:db/id #edb/ref 17592186153169}} {:db/id #edb/ref 17592186153173 :step/content {:db/id #edb/ref 17592186153412 :tutorial/content "Let $A$ be an  $m \\times m$ matrix. A **generalized eigenvector of rank $n$** corresponding to the eigenvalue $\\lambda$ of  $A$ is a nonzero vector $\\mathbf{v}_n$ such that\n\n$$\n\\mathbf{v}_n \\xrightarrow{A- \\lambda I} \\mathbf{v}_{n-1} \\xrightarrow{A- \\lambda I} \\ldots \\xrightarrow{A- \\lambda I} \\mathbf{v}_1 \\xrightarrow{A- \\lambda I} \\mathbf{0},\n$$\n\nwhere $\\mathbf{v}_{n-1}, \\mathbf{v}_{n-2},\\ldots, \\mathbf{v}_{1} \\neq \\mathbf{0}.$ In other words, $A-\\lambda I$ maps $\\mathbf{v}$ to $\\mathbf{0}$ in $n$ steps." :tutorial/id #uuid "6382bc76-a365-5639-83d8-91bd8605500a" :tutorial/math-academy-id 5588 :tutorial/title "Generalized Eigenvectors of Rank N"} :step/id #uuid "cd7d895d-dd6d-5fb6-acf9-cde71c0edb5f" :step/next {:db/id #edb/ref 17592186153170}}] :activity/title "Generalized Eigenvectors" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186152358} {:activity/first-step {:db/id #edb/ref 17592186413002} :activity/id #uuid "b5cf7ec7-b0e0-5d92-bb87-56ae58980cda" :activity/steps [{:db/id #edb/ref 17592186413001 :step/content {:db/id #edb/ref 17592186413000 :question/id #uuid "eddb46c6-735a-5bdf-b2a2-b57344c5441a"} :step/id #uuid "2bc8515b-cb7e-52c2-b2ca-3e1502bf57b3" :step/next {:db/id #edb/ref 17592186413003}} {:db/id #edb/ref 17592186413002 :step/content {:db/id #edb/ref 17592186412998 :question/id #uuid "28941d92-3462-55d4-9376-780e240021c7"} :step/id #uuid "ad6297d7-7ae6-5be0-a908-e7a0cc46d152" :step/next {:db/id #edb/ref 17592186413001}} {:db/id #edb/ref 17592186413003 :step/content {:db/id #edb/ref 17592186412999 :question/id #uuid "5e5966d3-ce4d-5835-ab91-1f478e587602"} :step/id #uuid "ea9a4e19-af76-5650-86a8-7d1214ec77ba"}] :activity/title "Generalized Eigenvectors" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186412979} {:activity/first-step {:db/id #edb/ref 17592186436621} :activity/id #uuid "a709859d-ebd8-5943-9d11-a9e7d7df3f7b" :activity/steps [{:db/id #edb/ref 17592186436617 :step/content {:db/id #edb/ref 17592186247013 :question/id #uuid "6ee1784f-5074-5474-b955-50f16f51c21c"} :step/id #uuid "33739050-145e-5afa-87ac-beb7499e226a" :step/next {:db/id #edb/ref 17592186436618}} {:db/id #edb/ref 17592186436618 :step/content {:db/id #edb/ref 17592186247016 :question/id #uuid "73154a72-4618-59f1-ab95-d4b82ca2da71"} :step/id #uuid "4ffd44fb-40d1-534f-9793-15a7bf6ec9e8"} {:db/id #edb/ref 17592186436619 :step/content {:db/id #edb/ref 17592186247002 :question/id #uuid "1069f3ce-ee29-5917-b7ea-2041ea76b45b"} :step/id #uuid "5fcf7480-bb6d-551f-bed4-edf70898be3d" :step/next {:db/id #edb/ref 17592186436617}} {:db/id #edb/ref 17592186436620 :step/content {:db/id #edb/ref 17592186412998 :question/id #uuid "28941d92-3462-55d4-9376-780e240021c7"} :step/id #uuid "af00e671-378f-5ae3-95bf-22f18e729b56" :step/next {:db/id #edb/ref 17592186436619}} {:db/id #edb/ref 17592186436621 :step/content {:db/id #edb/ref 17592186152382 :question/id #uuid "e4b429ab-49a9-5137-bfd6-13315591e96f"} :step/id #uuid "f6d6dca3-2180-5d58-90e6-5c5ae7a5a3ef" :step/next {:db/id #edb/ref 17592186436620}}] :activity/title "Generalized Eigenvectors" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186436616} {:activity/first-step {:db/id #edb/ref 17592186482647} :activity/id #uuid "65743f6d-c4f5-542f-9721-c15aa32b036f" :activity/steps [{:db/id #edb/ref 17592186482630 :step/content {:db/id #edb/ref 17592186482531 :question/id #uuid "3c788761-8a3d-5a84-9fc6-a55521c1f3bb"} :step/id #uuid "378512a5-a4a3-5cfe-ac0c-8e6b41f621a9" :step/next {:db/id #edb/ref 17592186482642}} {:db/id #edb/ref 17592186482633 :step/content {:db/id #edb/ref 17592186413000 :question/id #uuid "eddb46c6-735a-5bdf-b2a2-b57344c5441a"} :step/id #uuid "50add218-dc98-586d-b53f-7221b90a299b" :step/next {:db/id #edb/ref 17592186482639}} {:db/id #edb/ref 17592186482639 :step/content {:db/id #edb/ref 17592186247001 :question/id #uuid "a65ad08d-f6cf-551f-aa17-5ecb903998d1"} :step/id #uuid "7ae106f8-dc27-52d1-9ba2-63f8ff076871" :step/next {:db/id #edb/ref 17592186482630}} {:db/id #edb/ref 17592186482642 :step/content {:db/id #edb/ref 17592186247012 :question/id #uuid "899bf4b0-0a2e-5149-9510-dff10d732f90"} :step/id #uuid "85151b46-52f9-5130-a26f-ee239d7c5fc8"} {:db/id #edb/ref 17592186482647 :step/content {:db/id #edb/ref 17592186244291 :question/id #uuid "1c683813-90e6-5581-9ed4-32de3ac9d89f"} :step/id #uuid "be1b9ef5-0697-50a6-856c-790402f18621" :step/next {:db/id #edb/ref 17592186482633}}] :activity/title "Generalized Eigenvectors" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186481770}] :db/id #edb/ref 17592186049408 :topic/knowledge-points [{:db/id #edb/ref 17592186152224 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152034 :question/id #uuid "3d5ffe46-c0ac-5309-a31b-28a6a1d927e5" :question/math-academy-id "e-9054" :question/problem "![](images/5c/5ce1e5bc9489f54f405f96a74e4e02458149be011a952f91603d6cd22e9b0a01.svg)\n\nConsider the matrix $A$ and vector $\\mathbf v$ shown above. Which of the following statements are true?\n\nI. $\\mathbf{v}$ is an eigenvector corresponding to the eigenvalue $\\lambda=4$ of $A$\n\nII. $\\mathbf{v}$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda=4$ of $A$\n\nIII. $\\mathbf{v}$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda=4$ of $A$" :question/worked-solution "A *generalized eigenvector* $\\mathbf{v_2}$ of rank $2$ corresponding to the eigenvalue $\\lambda$ of a matrix $A$ is a nonzero vector such that\n\n$$\n\\mathbf{v}_2 \\xrightarrow{A- \\lambda I} \\mathbf{v}_1 \\xrightarrow{A- \\lambda I} \\mathbf{0},\n$$\n\nwhere $\\mathbf{v}_1 \\neq \\mathbf{0}.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$ \n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-4I{:}$\n![](images/07/07d28376d40c024d22c60085ccac3f600a057e45e624e522c815755aaf8fe8e6.svg)\n\n- Next, we find the image of $\\mathbf{v}$ under the action of $A-4I{:}$\n![](images/6d/6dcb4edb0b165ab337b54783c4f30015379224e1ee156876b459666cc760de81.svg)\n\n- Since we got a nonzero vector in the last step, we now compute the image of $\\mathbf{w}$ under the action of $A-4I{:}$\n![](images/42/42b6edeb0a13e90007c6c6f15a68440c3b7a00727654d6db0ce69f5b2bd65913.svg)\n\nSo, we obtain the following chain of maps:\n\n![](images/7c/7c4372cfe047a9f2ddaf90e15750975da6d562f5287aba2bfe414335dba56b42.svg)\n\nHere, we see that $A-4I$ maps $\\mathbf{v}$ to $\\mathbf{0}$ in $2$ steps.\n\nTherefore:\n\n$\\qquad$ *$\\mathbf{v}$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda=4$ of $A.$*\n\nSo, the correct answer is \"II only.\""} :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/questions [{:db/id #edb/ref 17592186152380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37857c14-e9d8-5ff8-b371-453bdcccb1bb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459365} {:answer/id #uuid "39c98a6d-0b5b-56e4-a2d6-30cb920436ce" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459366}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459365} :answer-field/id #uuid "2880db24-3981-59f1-8156-a1eedd6e86dd" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460549} {:answer-field/choices [{:answer/id #uuid "114bd932-69e9-56f5-8f32-bd3d35462900" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459367} {:answer/id #uuid "acc3af12-c7ea-5216-8ed6-4ca5dab78a07" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459368}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459368} :answer-field/id #uuid "bcd568dc-05a5-58da-b3ec-6002251d7945" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460550} {:answer-field/choices [{:answer/id #uuid "47acaf3b-ff10-55be-bc1b-9101c802c80d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459369} {:answer/id #uuid "c23b93b7-3a6c-58e0-b193-425d41fe60e1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459370}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459369} :answer-field/id #uuid "d643dc1b-cb05-5416-ab2c-d769dada2c8d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460551}] :question/id #uuid "86e7e59c-5f60-5647-9c15-90e1d3a1ac43" :question/math-academy-id "q-109113" :question/problem "$$\nA=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix},\\,v=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$ \n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}4 & 1 \\\\ -1 & 2\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}={{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-3I:$\n\n$$\n(A-3I)w=\\begin{bmatrix}1 & 1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}}_{⏟}}_{v}\\overset{A-3I\\,}{\\to }{{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{⏟}}_{w}\\overset{A-3I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A-3I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186152383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bbca469-a09a-5aae-9061-eaabaf47cb82" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459383} {:answer/id #uuid "f24a4df8-1519-516f-987c-510381d92a7c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459384}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459384} :answer-field/id #uuid "54cfa585-bc9e-5739-a2b3-2cec274bc4a3" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460558} {:answer-field/choices [{:answer/id #uuid "03c36856-0511-53a2-b1e2-b7e4a2d0a856" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459385} {:answer/id #uuid "d3640da3-5e4d-595a-bdba-1a90c3045d43" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459386}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459386} :answer-field/id #uuid "a7056ce4-0dc2-5a6e-9a67-45ab92d795ee" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460559} {:answer-field/choices [{:answer/id #uuid "cc576af0-e18c-56ef-afbf-731c68a1fc36" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459387} {:answer/id #uuid "3a2ff2a7-9088-54bb-8657-c345c13ee7b9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459388}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459387} :answer-field/id #uuid "8be9ee5d-49cc-51bd-876f-c730adca6226" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460560}] :question/id #uuid "13d405ca-1969-5fbd-88a4-d12478e301e3" :question/math-academy-id "q-109500" :question/problem "$$\nA=\\begin{bmatrix}0 & -2 \\\\ 2 & 4\\end{bmatrix},\\,v=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$ \n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=\\begin{bmatrix}0 & -2 \\\\ 2 & 4\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=\\begin{bmatrix}-2 & -2 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n{{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\n \n\nHere, we see that $A-2I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186244298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138bb3b-2240-5c6f-8e4f-f5b183ab1ca7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461557} {:answer/id #uuid "5f4cb01f-fd3b-5e22-8f85-d6d31e4e2aa8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461558}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461558} :answer-field/id #uuid "3325f4bf-863d-54b9-b3e2-675ef37d6a4e" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462532} {:answer-field/choices [{:answer/id #uuid "5ec37e8f-a3b6-58e1-8ac0-ebf42f83c9f1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461559} {:answer/id #uuid "cf1643b0-dcf4-51e2-9dee-978dbc5d77dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461560}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461559} :answer-field/id #uuid "2c9d2262-c721-59fd-8663-dd7f70aa108c" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462533} {:answer-field/choices [{:answer/id #uuid "7f3e9e53-b6e3-52c5-a18d-90e354f3cdd8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461561} {:answer/id #uuid "167030fc-d98f-5d1e-b38a-bf7f33db7ba2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461562}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461562} :answer-field/id #uuid "3a39b7c6-5e57-56c4-b90a-de587ab18cd6" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462534}] :question/id #uuid "6f8f24d7-923f-567b-b949-576aeecc58aa" :question/math-academy-id "q-109506" :question/problem "$$\nA=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix},\\,v=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nIII. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine out statements.\n\nFirst, we compute $A-3I:$\n\n$$\nA-3I=\\begin{bmatrix}3 & 0 \\\\ -2 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-3I:$\n\n$$\n(A-3I)v=\\begin{bmatrix}0 & 0 \\\\ -2 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n{{\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}_{⏟}}_{v}\\overset{\\,A-3I\\,\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\n \n\nHere, we see that $A-3I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =3$ of $A.$*\n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186246999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac09a573-a23e-5936-81e2-8a4dc7b2d72e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461563} {:answer/id #uuid "6798f96f-447f-5faa-919e-de921ef0dc73" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461564}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461563} :answer-field/id #uuid "da7b9358-fa9d-5ba7-99fd-16418a38ed31" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462535} {:answer-field/choices [{:answer/id #uuid "7f221f89-d270-5c37-a24e-41b0d1f210f1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461565} {:answer/id #uuid "0368ad04-181d-5ae0-9f04-bf071ac6075f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461566}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461566} :answer-field/id #uuid "2918a440-120a-5271-b310-15bc39163202" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462536} {:answer-field/choices [{:answer/id #uuid "1eeeb0c6-e947-5a46-853c-7fd461e4302f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461567} {:answer/id #uuid "4a60962c-815b-574f-a2b5-bd3d0be1a5dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461568}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461567} :answer-field/id #uuid "3ce4146e-cec5-5999-9d67-968a8eaa2ccc" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462537}] :question/id #uuid "2c9bad97-e078-5fd9-8cb8-6324032501fd" :question/math-academy-id "q-109508" :question/problem "$$\nA=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-4$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+4I:$\n\n$$\nA+4I=\\begin{bmatrix}-5 & -1 \\\\ 1 & -3\\end{bmatrix}+4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\n$$\n\n- Next, we find the image of $v$ under the action of $A+4I:$\n\n$$\n(A+4I)v=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}={{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+4I:$\n\n$$\n(A+4I)w=\\begin{bmatrix}-1 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{v}\\overset{A+4I\\,}{\\to }{{\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}}_{⏟}}_{w}\\overset{A+4I\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\nHere, we see that $A+4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-4$ of $A.$*\n\nSo, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186247000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea90c8f5-d8b6-530a-bd3a-55a8a95477ae" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461569} {:answer/id #uuid "7f02e0f9-4218-50d0-8f74-b3bbce2ccd63" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461570}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461570} :answer-field/id #uuid "f3f48a61-a618-59bf-8258-975fc6843f3b" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462538} {:answer-field/choices [{:answer/id #uuid "268560d4-b12d-5c37-99f7-f084e893cfe6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461571} {:answer/id #uuid "ce284464-387a-52cf-9b51-1039384e97be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461572}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461571} :answer-field/id #uuid "3c3c14b8-856f-5418-9438-2d823e014acb" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462539} {:answer-field/choices [{:answer/id #uuid "a846bae0-2fb9-5cb8-9fae-ae7d4b22827f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461573} {:answer/id #uuid "7746f0e1-4798-5728-b7c7-4ff377910040" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461574}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461574} :answer-field/id #uuid "c835039c-460a-5ea4-ab26-b6657a44f5dc" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462540}] :question/id #uuid "a35e1aa3-c186-545a-9105-317f752c0d95" :question/math-academy-id "q-109517" :question/problem "$$\nA=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix},\\,v=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n- **I.** $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =10$ of $A$\n- **II.** $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =10$ of $A$\n- **III.** $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =10$ of $A$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-10I:$\n\n$$\nA-10I=\\begin{bmatrix}12 & -1 \\\\ 4 & 8\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\n$$\n\nNext, we find the image of $v$ under the action of $A-10I:$\n\n$$\n(A-10I)v=\\begin{bmatrix}2 & -1 \\\\ 4 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=0\n$$\n\nSo, we obtain the following map:\n\n$$\n{{\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}}_{⏟}}_{v}\\overset{\\,A-10I\\,\\,}{\\to }{{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}}_{⏟}}_{0}\n$$\n\n \n\nHere, we see that $A-10I$ maps $v$ to $0$ in $1$ step.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue  $\\lambda =10$ of $A.$*\n\nSo, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186362675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e150edfa-4d44-5ab4-b043-ba48e414155f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468876} {:answer/id #uuid "4e202e38-3b7c-56bb-b632-db0087893be5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468877}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468876} :answer-field/id #uuid "16b1f541-6829-5760-b5cd-2bf997f751ec" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470050} {:answer-field/choices [{:answer/id #uuid "daff9470-1403-525c-a778-8cd8a3abbaa3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468878} {:answer/id #uuid "411c8d9b-b9e8-5e53-9add-72247643