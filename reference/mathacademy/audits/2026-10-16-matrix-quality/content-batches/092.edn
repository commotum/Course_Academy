\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186235912} {:answer/id #uuid "3ee5a31d-8396-55d4-ba69-eb5f9a08969d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186236215} {:answer/id #uuid "5f8c2cb2-5c6e-548a-9460-b1743122fcb3" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 5 & -3 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186236421} {:answer/id #uuid "f3cce0d6-b2f1-5058-9b93-c71f1c1c9146" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & \\frac{3}{2} \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186237357}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186236215} :answer-field/id #uuid "4ff24b44-1c99-5ce0-ad10-7a7e7a843fcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237545}] :question/id #uuid "0bb40c20-00ba-542a-8a60-c0d7dc599925" :question/math-academy-id "q-10329" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 3 & 7 \\\\ 3 & -2 & 4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & 3 & 7 \\\\ 3 & -2 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 3 & -2 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & -\\frac{13}{2} & -\\frac{13}{2}\\end{array}\\right] & {R}_{2} & :=-\\frac{2}{13}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{3}{2} & \\frac{7}{2} \\\\ 0 & 1 & 1\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0f0b9c-b386-5238-8ba7-72cac3525985" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 14\\end{array}\\right],\n$$\n$\\,x=13$ and $y=14$" :db/id #edb/ref 17592186238272} {:answer/id #uuid "5fe04755-bee3-58c0-9874-4783212b3909" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 13\\end{array}\\right],\n$$\n$\\,x=11$ and $y=13$" :db/id #edb/ref 17592186238893} {:answer/id #uuid "bbd5f871-fd11-5036-8825-e4af120d0483" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{array}\\right],\n$$\n$\\,x=19$ and $y=-11$" :db/id #edb/ref 17592186239691} {:answer/id #uuid "c68e0877-e286-5954-ac40-9abb8a99feab" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -16\\end{array}\\right],\n$$\n$\\,x=17$ and $y=-16$" :db/id #edb/ref 17592186239803} {:answer/id #uuid "e55bdb30-4978-5726-aaa8-df9dad6c0983" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & 11\\end{array}\\right],\n$$\n$\\,x=10$ and $y=11$" :db/id #edb/ref 17592186240071}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{array}\\right],\n$$\n$\\,x=19$ and $y=-11$" :db/id #edb/ref 17592186239691} :answer-field/id #uuid "5111678b-1067-567f-9f71-44fd3e7c98fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240476}] :question/id #uuid "8ad44012-c8dc-51b0-90ac-8e2b89d003b4" :question/math-academy-id "q-1059" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ -1 & -2 & 3\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ -1 & -2 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & -1 & 11\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=8 \\\\ y &=-11,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-11$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-11)=8\\,⇒\\,x=8+11=19.\n$$\n\nTherefore, the solution is $x=19$ and $y=-11.$"} {:db/id #edb/ref 17592186241149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d657c0d-5d97-537c-911b-9fadbaaa3670" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{11}{16}\\end{array}\\right]" :db/id #edb/ref 17592186238587} {:answer/id #uuid "3e408362-b837-5b32-9b36-33ac7e5b4610" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{array}\\right]" :db/id #edb/ref 17592186238598} {:answer/id #uuid "6f45203e-09d8-57c8-83cd-c8f7658a36f5" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{15}{16}\\end{array}\\right]" :db/id #edb/ref 17592186239014} {:answer/id #uuid "b9791b07-a4eb-523d-9cf6-2317db471ade" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{17}{16}\\end{array}\\right]" :db/id #edb/ref 17592186239668} {:answer/id #uuid "f90e1648-976d-5da5-90a9-f26e2ffeb4ed" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{9}{16}\\end{array}\\right]" :db/id #edb/ref 17592186240258}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{array}\\right]" :db/id #edb/ref 17592186238598} :answer-field/id #uuid "4a1bbeec-fbf0-53a7-9f8e-2c368383943e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240459}] :question/id #uuid "157d0b46-caa9-5e52-add3-341aa2ee9d01" :question/math-academy-id "q-1060" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 2 & 1 \\\\ 5 & 6 & 8\\end{array}\\right] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 5 & 6 & 8\\end{array}\\right] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 16 & 13\\end{array}\\right] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & \\frac{13}{16}\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075960e5-1f24-5dcd-866f-1546ef47f4b3" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$ $\\,x=12$ and $y=-2$" :db/id #edb/ref 17592186263066} {:answer/id #uuid "607780b4-b834-5958-8917-d2978805f390" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$ $\\,x=13$ and $y=-1$" :db/id #edb/ref 17592186263833} {:answer/id #uuid "6a8efb01-52f2-5577-a453-fd24974a1b3d" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$ $\\,x=15$ and $y=1$" :db/id #edb/ref 17592186263915} {:answer/id #uuid "700008e8-7709-519e-afb8-f4973ac200f4" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$ $\\,x=5$ and $y=-1$" :db/id #edb/ref 17592186263968} {:answer/id #uuid "af2bc371-13d2-56f5-8ed5-00bde5527c1a" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -1 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$ $\\,x=12$ and $y=2$" :db/id #edb/ref 17592186264512}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$ $\\,x=5$ and $y=-1$" :db/id #edb/ref 17592186263968} :answer-field/id #uuid "ffd7877a-8c6a-5304-9c7d-554d32704288" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265702}] :question/id #uuid "e60da15e-4036-54d4-9450-3bb47096d6f6" :question/math-academy-id "q-130910" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 2 & 10 & 0\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 2 & 10 & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & -4 & 4\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 7 & -2 \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+7y &=-2 \\\\ y &=-1,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+7(-1)=-2\\,⇒\\,x=-2+7=5.\n$$\n\nTherefore, the solution is $x=5$ and $y=-1.$"} {:db/id #edb/ref 17592186287991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ebdb089-b3f4-5c9d-b7a6-72e8d7a0fb70" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 2 & 4 \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=0$ and $y=\\frac{5}{3}$" :db/id #edb/ref 17592186285062} {:answer/id #uuid "478598de-5580-5d87-b084-ce12adf081bd" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -4 \\\\ 0 & 1 & \\frac{1}{3}\\end{array}\\right],\n$$\n$\\,x=-\\frac{5}{3}$ and $y=\\frac{1}{3}$" :db/id #edb/ref 17592186285447} {:answer/id #uuid "6d451244-55cd-5a96-a900-de7d2916ac34" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=-\\frac{8}{3}$ and $y=-3$" :db/id #edb/ref 17592186285793} {:answer/id #uuid "dd96eee0-cec3-575c-9ac6-6f1c4fbaca49" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -\\frac{5}{3}\\end{array}\\right],\n$$\n$\\,x=0$ and $y=-\\frac{5}{3}$" :db/id #edb/ref 17592186286805} {:answer/id #uuid "e5ce9517-b274-5d83-a6ad-5f9bd48e8700" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & \\frac{5}{3}\\end{array}\\right],\n$$\n$\\,x=\\frac{20}{3}$ and $y=\\frac{5}{3}$" :db/id #edb/ref 17592186286892}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -\\frac{5}{3}\\end{array}\\right],\n$$\n$\\,x=0$ and $y=-\\frac{5}{3}$" :db/id #edb/ref 17592186286805} :answer-field/id #uuid "eb1c4de6-304d-5776-887d-6ed5bb7bf942" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287631}] :question/id #uuid "2f7d8f30-0a86-56e1-866a-295695eb3958" :question/math-academy-id "q-20459" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -6 & 10 \\\\ 2 & -3 & 5\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -6 & 10 \\\\ 2 & -3 & 5\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 2 & -3 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & \\frac{10}{3} \\\\ 0 & 1 & -\\frac{5}{3}\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=\\frac{10}{3} \\\\ y &=-\\frac{5}{3},\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-\\frac{5}{3}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-\\frac{5}{3})=\\frac{10}{3}\\,⇒\\,x=\\frac{10}{3}-\\frac{10}{3}=0.\n$$\n\nThus, the solution is $x=0$ and $y=-\\frac{5}{3}.$"} {:db/id #edb/ref 17592186287992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3646d9c7-a4bf-5f07-9367-56ce38c30d65" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 3 & -\\frac{9}{2} \\\\ 0 & 1 & -\\frac{17}{2}\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=-\\frac{17}{2}$" :db/id #edb/ref 17592186285289} {:answer/id #uuid "85e90878-8e02-5e2b-907a-8de27d6e9a76" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right],\n$$\n$\\,x=-3$ and $y=\\frac{1}{2}$" :db/id #edb/ref 17592186286019} {:answer/id #uuid "c96d518f-8d36-5ee9-a22a-7b70c03b78d2" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & \\frac{9}{2} \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right],\n$$\n$\\,x=3$ and $y=-\\frac{1}{2}$" :db/id #edb/ref 17592186286626} {:answer/id #uuid "d8aa53af-6559-5810-bd90-7bdc89bb1238" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -5 \\\\ 0 & 1 & \\frac{17}{2}\\end{array}\\right],\n$$\n$\\,x=\\frac{4}{2}$ and $y=\\frac{15}{2}$" :db/id #edb/ref 17592186286761} {:answer/id #uuid "ebff1f0e-b7a5-5d23-a4e1-84da86e0bfe3" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 0 & 1 & \\frac{9}{2}\\end{array}\\right],\n$$\n$\\,x=\\frac{1}{2}$ and $y=-\\frac{9}{2}$" :db/id #edb/ref 17592186286951}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right],\n$$\n$\\,x=-3$ and $y=\\frac{1}{2}$" :db/id #edb/ref 17592186286019} :answer-field/id #uuid "4915c173-2020-5f73-a32b-91c5f3b7da26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287305}] :question/id #uuid "33887d26-4540-5f7d-8312-2849fc1d5c71" :question/math-academy-id "q-20461" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -6 & -9 \\\\ 1 & -2 & -4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -6 & -9 \\\\ 1 & -2 & -4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 1 & -2 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -\\frac{9}{2} \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-\\frac{9}{2} \\\\ y &=\\frac{1}{2}\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=\\frac{1}{2}$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(\\frac{1}{2})=-\\frac{9}{2}\\,⇒\\,x=-\\frac{9}{2}+\\frac{3}{2}=-3.\n$$\n\nThus, the solution is $x=-3$ and $y=\\frac{1}{2}.$"} {:db/id #edb/ref 17592186386127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d07c9974-5e26-5ea1-90a8-dffd38fc2401" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186386129} {:answer/id #uuid "d212caa5-8f57-5805-96ab-3c0315ae6bed" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186386130} {:answer/id #uuid "a33c81ec-3df4-5242-9e92-e26a5c03aaad" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 0 & 0 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186386131} {:answer/id #uuid "ab3b0c81-7199-5b1d-8356-cda4803a78e3" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186386132} {:answer/id #uuid "b8bedb9d-48b2-5e0f-9d78-13d36b7ee868" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186386133}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186386129} :answer-field/id #uuid "43e6d8d3-b012-5436-a03c-f55f188923ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386128}] :question/id #uuid "97656c8d-f73c-5b5a-a5d7-69f60766b5eb" :question/math-academy-id "q-10512" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 6 & 4 & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 8 & -16\\end{array}\\right] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d065ca-e03a-590b-8565-4aa796b3f85f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186388197} {:answer/id #uuid "d7c367f9-0dd8-5eb2-bb63-b07c18fddbae" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -8 & 6 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186388198} {:answer/id #uuid "d2f53d2d-3d78-590a-995b-7bd29edb89ff" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 8 & -6 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186388199} {:answer/id #uuid "92579536-cb78-5a9d-9313-d30b90e25a2a" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186388200} {:answer/id #uuid "d9f89373-ace8-5a5d-ae8e-4a9ab6d34eda" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 4 & -3 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186388201}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186388200} :answer-field/id #uuid "d7823cff-303e-53ab-9742-7a012bfe87c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388196}] :question/id #uuid "dc5530a8-d7bb-5ee6-b842-11178cec4e06" :question/math-academy-id "q-130909" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -8 & 6 \\\\ 3 & -7 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 3 & -7 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 5 & -5\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 3 \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186528069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fb6216-bbee-542e-a8d5-a6977201321e" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 70\\end{array}\\right],\n$$\n$\\,x=65$ and $y=70$" :db/id #edb/ref 17592186528057} {:answer/id #uuid "598e9543-1c98-5f22-baf7-03cf2a34305a" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -80\\end{array}\\right],\n$$\n$\\,x=85$ and $y=-80$" :db/id #edb/ref 17592186528060} {:answer/id #uuid "b44846cb-18e2-576f-aaf4-25c65f7e1b39" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 55\\end{array}\\right],\n$$\n$\\,x=50$ and $y=55$" :db/id #edb/ref 17592186528064} {:answer/id #uuid "d1a998eb-ea5d-5950-be79-dd365a1bc23e" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & 65\\end{array}\\right],\n$$\n$\\,x=55$ and $y=65$" :db/id #edb/ref 17592186528066} {:answer/id #uuid "dd8acb9e-ff15-5d29-b46d-b7cc36034752" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -55\\end{array}\\right],\n$$\n$\\,x=95$ and $y=-55$" :db/id #edb/ref 17592186528067}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -55\\end{array}\\right],\n$$\n$\\,x=95$ and $y=-55$" :db/id #edb/ref 17592186528067} :answer-field/id #uuid "693ec270-bd7f-578b-8dbd-52fef9534031" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528061}] :question/id #uuid "ef5426f1-16c4-5c28-8647-4c69ba28e7fc" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  -1 & -2 & 15\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  -1 & -2 & 15\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & -1 & 55\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 40 \\\\  0 & 1 & -55\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=40 \\\\ y &=-55,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-55$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-55)=40\\,⇒\\,x=40+55=95.\n$$\n\nTherefore, the solution is $x=95$ and $y=-55.$"} {:db/id #edb/ref 17592186528070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f2c3cc-2998-5f94-8fef-49daa2d8aa32" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{33}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528052} {:answer/id #uuid "359ae760-184f-5e8e-afb8-fb69d2d8b427" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{51}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528054} {:answer/id #uuid "3a43599d-9d6a-589e-9507-2b4d71956b1f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{45}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528056} {:answer/id #uuid "7a0c1478-3a18-565a-894d-e20776156824" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{39}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528063} {:answer/id #uuid "cc34d56e-564c-5c33-b2b5-274dbbe9fda8" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{27}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528065}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{39}{16}\\end{array}\\right]" :db/id #edb/ref 17592186528063} :answer-field/id #uuid "1363e28f-29ab-5d72-bbaa-9a5139f40d16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528051}] :question/id #uuid "f98461ac-7c48-536e-aa56-fcc53a0bd592" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 2 & 3 \\\\  5 & 6 & 24\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 2 & 3 \\\\  5 & 6 & 24\\end{array}\\right] & {R}_{1} & :=-1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  5 & 6 & 24\\end{array}\\right] & {R}_{2} & :={R}_{2}-5\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 16 & 39\\end{array}\\right] & {R}_{2} & :=\\frac{1}{16}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -3 \\\\  0 & 1 & \\frac{39}{16}\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186528071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b90050c-33ae-563c-a7d6-0d5cdae936a6" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 33\\end{array}\\right],\n$$\n$\\,x=30$ and $y=33$" :db/id #edb/ref 17592186528053} {:answer/id #uuid "366baa50-b6b7-5f20-8ac6-5632cd89568f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -33\\end{array}\\right],\n$$\n$\\,x=57$ and $y=-33$" :db/id #edb/ref 17592186528055} {:answer/id #uuid "45ec5cb9-d48d-55bf-bbb5-6e144b5a51ea" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -48\\end{array}\\right],\n$$\n$\\,x=51$ and $y=-48$" :db/id #edb/ref 17592186528058} {:answer/id #uuid "463639d3-abe1-5520-875b-243fb5a78216" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 42\\end{array}\\right],\n$$\n$\\,x=39$ and $y=42$" :db/id #edb/ref 17592186528059} {:answer/id #uuid "77f3dfb2-ca22-53ba-b739-d4b2ca2c5d81" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & 39\\end{array}\\right],\n$$\n$\\,x=33$ and $y=39$" :db/id #edb/ref 17592186528062}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -33\\end{array}\\right],\n$$\n$\\,x=57$ and $y=-33$" :db/id #edb/ref 17592186528055} :answer-field/id #uuid "eea8e668-d861-5205-be1f-19680edf3181" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528068}] :question/id #uuid "fd42a520-23e1-53ae-8938-9a29b94bab42" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  -1 & -2 & 9\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then solve the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  -1 & -2 & 9\\end{array}\\right] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & -1 & 33\\end{array}\\right] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & 24 \\\\  0 & 1 & -33\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x+y &=24 \\\\ y &=-33,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-33$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-33)=24\\,⇒\\,x=24+33=57.\n$$\n\nTherefore, the solution is $x=57$ and $y=-33.$"}] :knowledge-point/title "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"} {:db/id #edb/ref 17592186059776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059585 :question/id #uuid "1eea81be-26d7-57dd-a622-d66300de7f4f" :question/math-academy-id "e-4698" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+5y &=5 \\\\ x-6y &=5.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\n\t\\left[\n\t\\begin{array}{cc|c}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{array}\n\t\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}-1 & 5 & 5 \\\\ 1 & -6 & 5\\end{array}\\right] & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 1 & -6 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 0 & -1 & 10\\end{array}\\right] & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -5 & -5 \\\\ 0 & 1 & -10\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-5y &=-5 \\\\ y &=-10,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-10$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-5(-10)=-5 \n\t\\quad\\Rightarrow\\quad\n\tx=-55.\n$$\n\nTherefore, the solution is $x=-55$ and $y=-10.$ Or, in vector form, $\\langle -55,-10 \\rangle.$"} :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/question-generator {:db/id #edb/ref 17592186528050 :question-generator/id #uuid "8e9a709c-6e5b-5a97-91b4-ba52a160d409" :question-generator/script "generate/scratch/17592186059776.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54d5f843-4ed3-5887-9c95-95e2ab4681b0" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-4$ and $y=1$" :db/id #edb/ref 17592186238787} {:answer/id #uuid "7de11345-85da-5f42-b994-6f906dd8da2a" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & 0 & -8 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-8$ and $y=2$" :db/id #edb/ref 17592186239148} {:answer/id #uuid "f40df186-7531-5bdd-8ab8-d17a11d47079" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-2$ and $y=2$" :db/id #edb/ref 17592186240208} {:answer/id #uuid "f48c21ea-c0d4-54c8-a868-f917ea05e21f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$\n$\\,x=-4$ and $y=1$" :db/id #edb/ref 17592186240213} {:answer/id #uuid "fe7498cd-1b74-5e0a-8a1b-90249b213ceb" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 5\\end{array}\\right],\n$$\n$\\,x=-2$ and $y=2$" :db/id #edb/ref 17592186240309}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-2$ and $y=2$" :db/id #edb/ref 17592186240208} :answer-field/id #uuid "152de6d8-6293-59b3-9855-412f2fd00d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240362}] :question/id #uuid "2b3048cb-22e8-56e6-a26a-e3ac30e078b0" :question/math-academy-id "q-10522" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-8 \\\\ 2x+4y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 2 & 4 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 10 & 20\\end{array}\\right] & {R}_{2} & :=\\frac{1}{10}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -8 \\\\ 0 & 1 & 2\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-8 \\\\ y &=2,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(2)=-8\\,⇒\\,x=-2.\n$$\n\nTherefore, the solution is $x=-2$ and $y=2.$"} {:db/id #edb/ref 17592186060205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60568eaf-b95e-51a1-b2f3-e1407870bb98" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186285671} {:answer/id #uuid "97adb96b-8edb-5c4c-902b-ff554ee7b5eb" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 7 & -5 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186286170} {:answer/id #uuid "bd5510ff-6cd8-5645-ad15-26672ef4b3e5" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186286517} {:answer/id #uuid "d49177c8-42df-5c93-a6ec-200c5ebaea79" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 7 & -5 \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186286718} {:answer/id #uuid "ee16ef73-bdc4-522a-b8d0-0d85c8d8c09a" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186286971}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186286517} :answer-field/id #uuid "b6673548-5c1b-50a3-9ea7-bfa5e7f6c3ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287527}] :question/id #uuid "a63289e5-22c0-55e8-8542-9af2656af30b" :question/math-academy-id "q-20496" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+7y &=-5 \\\\ 7x+11y &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & 7 & -5 \\\\ 7 & 11 & -4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 7 & 11 & -4\\end{array}\\right] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & -\\frac{27}{2} & \\frac{27}{2}\\end{array}\\right] & {R}_{2} & :=-\\frac{2}{27}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{7}{2} & -\\frac{5}{2} \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c1aeaeb-0496-5e49-896e-cdf9bcf2c5eb" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186285038} {:answer/id #uuid "469ce16b-f680-51ef-b9d6-1ea50b534cd5" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186285438} {:answer/id #uuid "99a03cf8-5109-5eb2-a9d0-6200e6c3375b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186286195} {:answer/id #uuid "9d06ffa2-8a67-580a-bd64-a76dd2a8fdaf" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186286223} {:answer/id #uuid "c2a9347a-4d1b-5a30-a05c-454969555819" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186286571}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186286223} :answer-field/id #uuid "4ac19391-6295-52b6-9b43-da9d63bae7a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287309}] :question/id #uuid "706c95c0-19c0-574d-ac1c-7bbb6eee33bb" :question/math-academy-id "q-20497" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x+8y &=22 \\\\ 7x-5y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & 8 & 22 \\\\ 7 & -5 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & 8 & 22 \\\\ 7 & -5 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 7 & -5 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & -\\frac{71}{3} & -\\frac{142}{3}\\end{array}\\right] & {R}_{2} & :=-\\frac{3}{71}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{8}{3} & \\frac{22}{3} \\\\ 0 & 1 & 2\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0840ea52-a06f-5146-a1df-e3ba124526b7" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & -3\\end{array}\\right],\n$$\n$\\,x=12$ and $y=-3$" :db/id #edb/ref 17592186284851} {:answer/id #uuid "832da128-01e8-5583-8f68-dcc408eaf40f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 6\\end{array}\\right],\n$$\n$\\,x=9$ and $y=6$" :db/id #edb/ref 17592186285992} {:answer/id #uuid "9afc9df7-3990-53ba-9bac-8b196b45bd0b" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 3\\end{array}\\right],\n$$\n$\\,x=10$ and $y=3$" :db/id #edb/ref 17592186286208} {:answer/id #uuid "ea5fd352-814a-5de1-9f20-7c5cff5354f8" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 30\\end{array}\\right],\n$$\n$\\,x=1$ and $y=30$" :db/id #edb/ref 17592186286934} {:answer/id #uuid "f09e4410-07cc-50a6-a8e0-bf8048c2a9f2" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 0\\end{array}\\right],\n$$\n$\\,x=11$ and $y=0$" :db/id #edb/ref 17592186286994}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 30\\end{array}\\right],\n$$\n$\\,x=1$ and $y=30$" :db/id #edb/ref 17592186286934} :answer-field/id #uuid "29af1eb2-22bf-5eef-a556-f8889e43ec62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287236}] :question/id #uuid "6bae40ff-f64b-5781-92c2-7de7bf870b94" :question/math-academy-id "q-20500" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+\\frac{1}{3}y &=11 \\\\ 3x+\\frac{1}{5}y &=9.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 3 & \\frac{1}{5} & 9\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 3 & \\frac{1}{5} & 9\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & -\\frac{4}{5} & -24\\end{array}\\right] & {R}_{2} & :=-\\frac{5}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{1}{3} & 11 \\\\ 0 & 1 & 30\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x+\\frac{1}{3}y &=11 \\\\ y &=30,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=30$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+\\frac{1}{3}(30)=11\\,⇒\\,x=11-10=1.\n$$\n\nTherefore, the solution is $x=1$ and $y=30.$"} {:db/id #edb/ref 17592186342013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02876a91-9c2b-5db9-93db-3be93af34e6f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186339149} {:answer/id #uuid "3d91260d-1cf0-5203-ae2b-cc89655211ab" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186339677} {:answer/id #uuid "9429a5f9-6d54-599b-9687-9203301af7b7" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186340461} {:answer/id #uuid "985c88ff-419b-5caa-bb4e-b32f060129cb" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186340499} {:answer/id #uuid "db9d37bb-2114-5625-ae7e-b79370792765" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -4\\end{array}\\right]" :db/id #edb/ref 17592186341077}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186339149} :answer-field/id #uuid "51dee7b7-d9c0-587e-81fa-5af482e1a393" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341526}] :question/id #uuid "0d942c9d-ca2d-5916-825d-4a4ac9478a87" :question/math-academy-id "q-73555" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}4x+12y &=-4 \\\\ 5x+11y &=3.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}4 & 12 & -4 \\\\ 5 & 11 & 3\\end{array}\\right] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 5 & 11 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & -4 & 8\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -1 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd4192aa-080e-5c69-8963-a71bb07eb7d9" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & 2 \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right]" :db/id #edb/ref 17592186388204} {:answer/id #uuid "878deea4-6ebc-5da8-ae3b-6d281a2e7aea" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 5 & -2 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186388205} {:answer/id #uuid "b2059793-db2c-51fa-b66f-2c1fb8c1c72a" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -1 \\\\ 0 & 1 & \\frac{1}{2}\\end{array}\\right]" :db/id #edb/ref 17592186388206} {:answer/id #uuid "559c34a6-de5d-56ab-b154-9e41f7937767" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right]" :db/id #edb/ref 17592186388207} {:answer/id #uuid "57a47077-35ca-5b6d-be59-4b28fd4d27f4" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & -2 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186388208}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right]" :db/id #edb/ref 17592186388207} :answer-field/id #uuid "4a040579-aefe-533a-8c63-ad19cdf5d7e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388203}] :question/id #uuid "eb1cabaf-074e-5667-9a8b-8255e755b894" :question/math-academy-id "q-130912" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x+5y &=-6 \\\\ -6x-6y &=10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & 5 & -6 \\\\ -6 & -6 & 10\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ -6 & -6 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}+6{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 4 & -2\\end{array}\\right] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & \\frac{5}{3} & -2 \\\\ 0 & 1 & -\\frac{1}{2}\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186393301} {:answer/id #uuid "eeb19591-ba15-5e0e-8983-784d1d68d59d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -\\frac{3}{2}\\end{array}\\right]" :db/id #edb/ref 17592186393302} {:answer/id #uuid "e2f102ba-ebea-5b42-ae75-3e35aaa4dcb9" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186393303} {:answer/id #uuid "0716f4f7-16c9-5c13-b702-47eba0dfd09b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{array}\\right]" :db/id #edb/ref 17592186393304} {:answer/id #uuid "d6ec307f-5f81-58e7-8c8e-0f70f0701a1d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186393305}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186393301} :answer-field/id #uuid "f86bf6ae-95b6-5b45-9f58-e55f64d234d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393300}] :question/id #uuid "26bbee69-6c8f-5073-bf18-e5b7229f3605" :question/math-academy-id "q-73538" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x-2y &=4 \\\\ 2x-y &=2.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{array}\\right] & {R}_{2} & :=3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$\n$\\,x=1$ and $y=-1$" :db/id #edb/ref 17592186393308} {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} {:answer/id #uuid "af523f5a-739c-5f31-b5eb-464880f8d7fb" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{array}\\right],\n$$\n$\\,x=-5$ and $y=-4$" :db/id #edb/ref 17592186393310} {:answer/id #uuid "1b343ef7-3ddf-5c6c-94e7-03e5be9701c9" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=7$ and $y=2$" :db/id #edb/ref 17592186393311} {:answer/id #uuid "374d0aef-c48a-512b-ba16-2324cb201e02" :answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{array}\\right],\n$$\n$\\,x=11$ and $y=4$" :db/id #edb/ref 17592186393312}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} :answer-field/id #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393307}] :question/id #uuid "4e51e1e1-f4ea-594e-af90-cfd7caef02c6" :question/math-academy-id "q-73544" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y &=6 \\\\ 4x-7y &=10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=3 \\\\ y &=-2,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"} {:db/id #edb/ref 17592186393313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "784ffc66-edc8-51a6-ac2b-356c0e08dea7" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393315} {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186393316} {:answer/id #uuid "12a340da-e725-5a88-a527-27d71e519f66" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393317} {:answer/id #uuid "335c8f2c-6e1a-56c3-b0b9-94d13c9ad70f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186393318} {:answer/id #uuid "0e6a6bdb-d757-58d4-980e-64a7fa142831" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -2 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393319}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186393316} :answer-field/id #uuid "240d40bc-cf1d-5886-b54c-59f3d0b765cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393314}] :question/id #uuid "08ec22c2-8cd9-5dca-af3f-944499fe851c" :question/math-academy-id "q-73551" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}5x-15y &=10 \\\\ 2x-4y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 2 & 0\\end{array}\\right] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186414018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b00cee-94fc-5ef4-95de-2345a02742de" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186414012} {:answer/id #uuid "35507ba3-dc5e-5f36-bb3c-2cadb07fb8ff" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186414013} {:answer/id #uuid "632206dd-bb16-5704-9288-1e7bf08e0cfc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186414014} {:answer/id #uuid "7bad20ef-df3c-52d4-a10d-b7e2a38262ad" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -4\\end{array}\\right]" :db/id #edb/ref 17592186414015} {:answer/id #uuid "92cfbdd1-6bb8-5b06-89f2-6d7a9c5e7075" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186414016}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186414013} :answer-field/id #uuid "cae93ed5-7aca-5036-ae81-d4a677001210" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414017}] :question/id #uuid "13eff08d-2b22-5094-8876-818462babb6f" :question/math-academy-id "q-73554" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-8y &=10 \\\\ 3x-7y &=5.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 5 & -10\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"}] :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :topic/math-academy-id 151 :topic/title "Solving 2x2 Systems of Equations Using Gaussian Elimination"}]}
