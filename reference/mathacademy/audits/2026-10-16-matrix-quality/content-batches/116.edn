d/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365095}] :question/id #uuid "d5936dcb-2d5c-58af-90e0-045518134fce" :question/math-academy-id "q-141435" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and \n\n$$\n\\text{Ker}(T)={[x,y,z,w]^{T}\\,:\\,x-3z=0,\\,y+w=0}.\n$$" :question/worked-solution "Solving $x-3z=0$ for $x,$ we get $x=3z.$ Solving $y+w=0$ for $w,$ we get $w=-y.$  Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}3z \\\\ y \\\\ z \\\\ -y\\end{bmatrix}=z{{\\begin{bmatrix}3 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}+y{{\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ -1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =4-\\text{nullity}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248a5e8c-2665-5c3b-bc76-2d4de5451af5" :answer/type {:db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186366443} {:answer/id #uuid "a63c65d1-5c18-570e-8960-1b52338c60f9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366444} {:answer/id #uuid "b1865736-9107-58e9-aaa4-24fa5ace9aa7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366445} {:answer/id #uuid "1cd1c025-f90e-5cb1-8335-7715549b6128" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186366446} {:answer/id #uuid "1cd43ae6-1011-54b6-8471-e14df44fd9c0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366447}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366444} :answer-field/id #uuid "b01eaafe-12ed-57fc-a8e9-276511a00549" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366442}] :question/id #uuid "c2cc1677-8220-5afa-89bb-f3b005d1f893" :question/math-academy-id "q-83447" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and $\\text{Im}(T)=\\{[x,y,z,w]^{T}\\,:\\,x=2z,\\,\\,y=w\\}.$" :question/worked-solution "Any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}2z \\\\ w \\\\ z \\\\ w\\end{bmatrix}=z{{\\begin{bmatrix}2 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}+w{{\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =4-\\text{rank}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9fff8ad-a05a-5915-984a-a55cb248304e" :answer/type {:db/ident :answer.type/text} :answer/value "Not enough information" :db/id #edb/ref 17592186366450} {:answer/id #uuid "9e16b7fb-8b11-5507-bf1a-dacb68b75728" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366451} {:answer/id #uuid "24eb9118-0152-5d77-9952-31828eb4f55b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366452} {:answer/id #uuid "0106a335-bd09-573f-bb7f-8c6784a8364b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366453} {:answer/id #uuid "b64af126-8ca2-5e00-b1de-22911404803e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366454}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366452} :answer-field/id #uuid "ef820525-294a-5727-b36d-cfc9c25ae681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366449}] :question/id #uuid "a83f458d-71b3-57e0-b39d-c5f64193f141" :question/math-academy-id "q-84055" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,2y-z=0,\\,x+y=0}.$" :question/worked-solution "Solving $2y-z=0$ for $z,$ we get $z=2y.$ Solving $x+y=0$ for $x,$ we get $x=-y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}-y \\\\ y \\\\ 2y\\end{bmatrix}=y{{\\begin{bmatrix}-1 \\\\ 1 \\\\ 2\\end{bmatrix}}_{⏟}}_{{v}_{1}}\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{rank}(T)=1.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186406840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3fa2ee-eac1-54f7-a4c6-ec5b539510f4" :answer/type {:db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186406810} {:answer/id #uuid "b15a9656-7038-5a55-bf9f-c3d46f455338" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186406823} {:answer/id #uuid "cc277bfe-8316-5960-ad00-41d18d0bb79e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186406826} {:answer/id #uuid "e7eb8255-65e0-55e8-9452-62dfb2f06a3d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186406828} {:answer/id #uuid "e84109bf-1001-5843-8805-1788b156098c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186406829}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186406829} :answer-field/id #uuid "28b8502d-f01b-56da-9de3-fce2aa5353e1"