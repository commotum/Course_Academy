eld/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420841}] :question/id #uuid "37f105cd-9dd0-500b-bb29-7f9f80a1a14c" :question/math-academy-id "q-43071" :question/problem "Find $det({A}^{-1}),$ if $A=\\begin{bmatrix}1 & 2 \\\\ 1 & 6\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}1 & 2 \\\\ 1 & 6\\end{bmatrix} \\\\  & =6-2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186420853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15bb6772-ebfa-5300-9707-f0c44ba3ca38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186420801} {:answer/id #uuid "1657176b-b7bb-5bac-8681-50357708185d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186420802} {:answer/id #uuid "341db512-89dd-5d60-9521-449fcc83f4d2" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186420807} {:answer/id #uuid "7ecdfc0d-790a-509f-8041-8c18f54a719a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186420817} {:answer/id #uuid "bd130b49-aec7-5947-9ffc-20dcb30a8a97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420827}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186420827} :answer-field/id #uuid "a81cf8c4-10bc-54bc-9308-65fe3b30e2ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420844}] :question/id #uuid "9e9ddda3-97aa-551d-9453-cae76713ec59" :question/math-academy-id "q-43070" :question/problem "Find $det({A}^{-1}),$ if $A=\\begin{bmatrix}2 & 1 \\\\ 5 & 5\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2 & 1 \\\\ 5 & 5\\end{bmatrix} \\\\  & =10-5 \\\\  & =5\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=\\frac{1}{5}.\n$$"} {:db/id #edb/ref 17592186435769 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d19261f-2d17-5ce6-a528-357db19c92fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{76}" :db/id #edb/ref 17592186435743} {:answer/id #uuid "44e2e6b4-ad39-5370-b46a-da247adce9ef" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{82}" :db/id #edb/ref 17592186435745} {:answer/id #uuid "4bc3f9d6-53b9-5b49-91f9-095f7560a365" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} {:answer/id #uuid "505a34ac-ba5d-5a72-8645-7ed3b579499e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186435750} {:answer/id #uuid "ce24b16c-5b82-5027-a711-29aa725ec9c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{48}" :db/id #edb/ref 17592186435760}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{84}" :db/id #edb/ref 17592186435748} :answer-field/id #uuid "a2f79099-495d-5b97-91da-18a1c01e2ef1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435764}] :question/id #uuid "8501cdd8-7879-5e81-a6ba-962c1d7f9129" :question/math-academy-id "q-130532" :question/problem "Find $|{A}^{-1}|,$ if $A=\\begin{bmatrix}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $2$nd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}-5 & -3 & 4 \\\\ -2 & 1 & 2 \\\\ 1 & -4 & 6\\end{aligned}| \\\\  & =-2(-1)^{2+1}|\\begin{aligned}-3 & 4 \\\\ -4 & 6\\end{aligned}|+1(-1)^{2+2}|\\begin{aligned}-5 & 4 \\\\ 1 & 6\\end{aligned}|+2(-1)^{2+3}|\\begin{aligned}-5 & -3 \\\\ 1 & -4\\end{aligned}| \\\\  & =2(-18+16)+(-30-4)-2(20+3) \\\\  & =-4-34-46 \\\\  & =-84\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{84}.\n$$"} {:db/id #edb/ref 17592186435770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44f82cc2-edfd-5f43-b0c8-b4fb5bfe4f97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186435746} {:answer/id #uuid "48f7dc16-cbeb-5e5b-b98b-3d2a1113c52c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186435747} {:answer/id #uuid "a7ea38b1-c61b-5047-b0ee-8b524e948890" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186435755} {:answer/id #uuid "ca3a92c4-d4e6-5591-8bf1-5151ac26a42e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186435759} {:answer/id #uuid "d6f0546b-c6ef-592b-ad4b-1acba6597c58" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{17}" :db/id #edb/ref 17592186435761}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186435747} :answer-field/id #uuid "b9759cd8-4862-5dd3-9edc-5966b55e2eb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435765}] :question/id #uuid "eee0d247-b841-57bb-b4de-7b3606da042f" :question/math-academy-id "q-42583" :question/problem "Find $|{A}^{-1}|,$ if $A=\\begin{bmatrix}7 & 6 & -3 \\\\ 1 & 2 & -1 \\\\ 5 & -5 & 2\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $2$nd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}7 & 6 & -3 \\\\ 1 & 2 & -1 \\\\ 5 & -5 & 2\\end{aligned}| \\\\  & =1(-1)^{2+1}|\\begin{aligned}6 & -3 \\\\ -5 & 2\\end{aligned}|+2(-1)^{2+2}|\\begin{aligned}7 & -3 \\\\ 5 & 2\\end{aligned}|-1(-1)^{2+3}|\\begin{aligned}7 & 6 \\\\ 5 & -5\\end{aligned}| \\\\  & =-(12-15)+2(14+15)+(-35-30) \\\\  & =3+58-65 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186484198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04efdac5-3dd6-5c5f-8a26-b2759cf8283c" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186483576} {:answer/id #uuid "59ee36a8-3df4-5abd-9635-4a64fbb2b20e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186483735} {:answer/id #uuid "6881cacb-49d1-5796-ac41-85af50ef8c7a" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186483770} {:answer/id #uuid "8d5ed0e6-bb61-546d-a212-902bf1dcb965" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483861} {:answer/id #uuid "9c10c03d-47ea-5d76-845a-038143841e71" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186483885}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186483861} :answer-field/id #uuid "68dc34c5-a4cf-5701-b2b5-6b8a0f11f690" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484132}] :question/id #uuid "099dc702-c2e9-5790-a5a1-762c52cdef4b" :question/math-academy-id "q-130632" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=24$ and $|{C}^{-1}|=4$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=\\frac{1}{4}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =24\\cdot \\frac{1}{4} \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e651fca-df91-5a95-892f-780cef22a6df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186513611} {:answer/id #uuid "b85887ad-503b-5a31-9a5f-ed5afa3bbe07" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186514018} {:answer/id #uuid "e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186514143} {:answer/id #uuid "f606c8f4-0164-5bb8-968e-6ee4d224953a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186514173} {:answer/id #uuid "f88ff125-ed18-5a84-bda5-936ae6d644fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186514181}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186514143} :answer-field/id #uuid "3235286d-76ea-568e-a9be-0249cc7ffbea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514244}] :question/id #uuid "13976613-adec-5296-be7c-cccd907c4b03" :question/math-academy-id "q-42998" :question/problem "Find $det({A}^{-1})$, if $A=[\\begin{aligned}-2 & 1 \\\\ 4 & 3\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}-2 & 1 \\\\ 4 & 3\\end{aligned}] \\\\  & =-6-4 \\\\  & =-10\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=-\\frac{1}{10}.\n$$"} {:db/id #edb/ref 17592186514468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c8e0eb-b4ed-5750-97d5-7df316c93a28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{22}" :db/id #edb/ref 17592186513595} {:answer/id #uuid "5109da14-c4b1-5d66-8b72-c7c4fe59acde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186513753} {:answer/id #uuid "8e41c8c1-320c-5148-80c5-566550b07342" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186513899} {:answer/id #uuid "bb8b9732-250a-5c1f-8b41-8e1659261954" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{11}" :db/id #edb/ref 17592186514030} {:answer/id #uuid "ccf68bac-d6a7-5572-952f-aca8d66f7daf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186514062}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{22}" :db/id #edb/ref 17592186513595} :answer-field/id #uuid "e2f9929b-cbb7-535e-88cc-fde1a1ddedec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514329}] :question/id #uuid "e03bdc50-8826-55ed-961a-7b04fba13b73" :question/math-academy-id "q-43064" :question/problem "Find $det({A}^{-1}),$ if $A=[\\begin{aligned}5 & 1 \\\\ -2 & 4\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}5 & 1 \\\\ -2 & 4\\end{aligned}] \\\\  & =20+2 \\\\  & =22\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=\\frac{1}{22}.\n$$"}] :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"} {:db/id #edb/ref 17592186119780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119594 :question/id #uuid "d5d020cb-50ee-53f6-9d8b-d384bc9b7999" :question/math-academy-id "e-4433" :question/problem "Given that \n![](images/58/589324d1b345360020e9c2b1096b64a08008a52b05a13fdc7fd39bcb063a8d58.svg)\nfind \n![](images/f4/f4925a93ca952863cac520a853c1bc5d7c815dc8324043d6c0963d20d2b2b1ff.svg)" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a & b & c+1 \\\\ 1 & 2 & 3 \\\\ 1 & 1 & 2\\end{aligned}| & =|\\begin{aligned}a+0 & b+0 & c+1 \\\\ 1 & 2 & 3 \\\\ 1 & 1 & 2\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants and expanding the second determinant across the $1$st row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}a+0 & b+0 & c+1 \\\\ 1 & 2 & 3 \\\\ 1 & 1 & 2\\end{aligned}| & ={{|\\begin{aligned}a & b & c \\\\ 1 & 2 & 3 \\\\ 1 & 1 & 2\\end{aligned}|}_{⏟}}_{-10}+|\\begin{aligned}0 & 0 & 1 \\\\ 1 & 2 & 3 \\\\ 1 & 1 & 2\\end{aligned}| \\\\  & =-10+1(-1)^{1+3}|\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| \\\\  & =-10-1 \\\\  & =-11.\\end{aligned}\n$$"} :knowledge-point/id #uuid "6e4dd07e-475b-5c89-883b-0e4adcf6a723" :knowledge-point/questions [{:db/id #edb/ref 17592186120435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fcef5e-b3e2-5ccd-ad74-3f0f2bf5215e" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186327159} {:answer/id #uuid "8ef0a0f8-a3e1-5867-a44d-53d8501860b3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328178} {:answer/id #uuid "9b76b2b0-7b79-5bed-b323-bb17d564fb79" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186328279} {:answer/id #uuid "c5b548cb-6708-57bd-8aac-098ad056ea48" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186328668} {:answer/id #uuid "e9942f7d-5789-519b-8b26-e8f47afefdff" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186328982}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186327159} :answer-field/id #uuid "e1c7dcea-54be-5b44-9e93-100efe093b8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329575}] :question/id #uuid "b66a6d15-0b61-5b61-a152-b57545d60ac8" :question/math-academy-id "q-42581" :question/problem "Given that \n$|\\begin{aligned}a+3 & -5 \\\\ b & 6\\end{aligned}|=-7$,\nfind \n$|\\begin{aligned}a+2 & -5 \\\\ b+4 & 6\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+2 & -5 \\\\ b+4 & 6\\end{aligned}| & =|\\begin{aligned}(a+3)-1 & -5 \\\\ b+4 & 6\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+3)-1 & -5 \\\\ b+4 & 6\\end{aligned}| & ={{|\\begin{aligned}a+3 & -5 \\\\ b & 6\\end{aligned}|}_{⏟}}_{-7}+|\\begin{aligned}-1 & -5 \\\\ 4 & 6\\end{aligned}| \\\\  & =-7+(-6+20) \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e097d8-e542-5acf-a330-fe6eeb6f27a6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,146" :db/id #edb/ref 17592186326952} {:answer/id #uuid "138116bf-b723-50e7-9f4c-0360ed73a988" :answer/type {:db/ident :answer.type/math} :answer/value "-434" :db/id #edb/ref 17592186327101} {:answer/id #uuid "a0898f35-ae35-5a2c-85c3-2c1973fb0a46" :answer/type {:db/ident :answer.type/math} :answer/value "870" :db/id #edb/ref 17592186328324} {:answer/id #uuid "a7d333b3-316e-527a-9482-d8e7753af3e9" :answer/type {:db/ident :answer.type/math} :answer/value "440" :db/id #edb/ref 17592186328390} {:answer/id #uuid "c8b3cbac-6be7-58e9-bfd2-408356f2bda6" :answer/type {:db/ident :answer.type/math} :answer/value "-424" :db/id #edb/ref 17592186328699}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-434" :db/id #edb/ref 17592186327101} :answer-field/id #uuid "0a480665-7d5c-59ec-8577-d65fbb82b058" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329200}] :question/id #uuid "6ac6b8ae-6cc0-5802-bd63-e9b3982c4a3a" :question/math-academy-id "q-43097" :question/problem "$|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}|=$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 100\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107+0 & 215+0 & 99+1\\end{aligned}| & =|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $3$rd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 107 & 215 & 99\\end{aligned}|+|\\begin{aligned}107 & 215 & 99 \\\\ 6 & 8 & 11 \\\\ 0 & 0 & 1\\end{aligned}| & =0+1(-1)^{3+3}|\\begin{aligned}107 & 215 \\\\ 6 & 8\\end{aligned}| \\\\  & =107\\cdot 8-215\\cdot 6 \\\\  & =-434\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b01122-cef4-57e0-bbe6-9e9ca46a105d" :answer/type {:db/ident :answer.type/math} :answer/value "172" :db/id #edb/ref 17592186263225} {:answer/id #uuid "68462165-dd02-5aef-a990-fa2a80304b30" :answer/type {:db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186263899} {:answer/id #uuid "9d4b1f65-f423-5f95-a77f-398f082a7e84" :answer/type {:db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186264347} {:answer/id #uuid "b3c540ce-78c8-5ba3-8e16-45516155084a" :answer/type {:db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186264543} {:answer/id #uuid "da01d959-45b6-560c-907e-0539a9249ab1" :answer/type {:db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186264900}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186264347} :answer-field/id #uuid "b70c3988-227e-5d92-a2bc-8cd2a832cea5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265566}] :question/id #uuid "aff6f4ac-0990-556a-848c-2e5cb8fef1cd" :question/math-academy-id "q-130634" :question/problem "$|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 78\\end{aligned}|=$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 78\\end{aligned}| & =|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160+0 & 184+0 & 76+2\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160+0 & 184+0 & 76+2\\end{aligned}| & =|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 76\\end{aligned}|+|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 0 & 0 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $3$rd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 76\\end{aligned}|+|\\begin{aligned}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 0 & 0 & 2\\end{aligned}| & =0+2(-1)^{3+3}|\\begin{aligned}160 & 184 \\\\ 3 & 4\\end{aligned}| \\\\  & =2\\cdot (160\\cdot 4-184\\cdot 3) \\\\  & =2\\cdot 88 \\\\  & =176\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "331f3993-b5ac-54a2-ac82-06dd0321b151" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186263442} {:answer/id #uuid "3603ab83-8aae-5dd5-89fa-afe1ef9f62d4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263477} {:answer/id #uuid "57d3925a-c1e7-542d-8f33-1d3909394cd2" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186263757} {:answer/id #uuid "c0ead8f3-49e7-5a32-8b04-bc4291058f3f" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186264675} {:answer/id #uuid "c9e9d9c7-1fa1-50bc-b6dc-efdafdea5ab7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186264765}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263477} :answer-field/id #uuid "6691a242-c5c1-5177-b03a-f829842b5ebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265425}] :question/id #uuid "74270614-19f5-5cbe-a862-b299585b014f" :question/math-academy-id "q-130777" :question/problem "Given that \n$|\\begin{aligned}3 & -2 \\\\ a & b+2\\end{aligned}|=8$,\nfind \n$|\\begin{aligned}3 & -2 \\\\ a+3 & b\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -2 \\\\ a+3 & b\\end{aligned}| & =|\\begin{aligned}3 & -2 \\\\ a+3 & (b+2)-2\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -2 \\\\ a+3 & (b+2)-2\\end{aligned}| & ={{|\\begin{aligned}3 & -2 \\\\ a & b+2\\end{aligned}|}_{⏟}}_{8}+|\\begin{aligned}3 & -2 \\\\ 3 & -2\\end{aligned}| \\\\  & =8+(-6+6) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47596227-58dd-5c85-b31b-dd2085e9d721" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186352226} {:answer/id #uuid "555a8298-192e-50be-8d44-14723e16f11d" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186352323} {:answer/id #uuid "58619be6-c805-5344-9021-173a95976dd3" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186352344} {:answer/id #uuid "bf9db913-3c22-5c37-be9e-ca617e5d0dee" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186353213} {:answer/id #uuid "e7c2b5b7-b8a6-51db-98b0-9f4ba4bb301f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186353585}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186352226} :answer-field/id #uuid "2bd53aab-78d5-531e-a248-9e6ce0d0938b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353889}] :question/id #uuid "31688145-09ed-5774-a522-d76e627c7dee" :question/math-academy-id "q-88296" :question/problem "Given that \n$|\\begin{aligned}a & b & c \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}|=4,$\nfind \n$|\\begin{aligned}a+1 & b & c \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+1 & b & c \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}| & =|\\begin{aligned}a+1 & b+0 & c+0 \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants and expanding the second determinant across the $1$st row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}a+1 & b+0 & c+0 \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}| & ={{|\\begin{aligned}a & b & c \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}|}_{⏟}}_{4}+|\\begin{aligned}1 & 0 & 0 \\\\ 3 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =4+1(-1)^{1+1}|\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}| \\\\  & =4+1 \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59a4042a-f605-574f-a228-ff4ae6d308e5" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186352358} {:answer/id #uuid "73d447eb-1e81-51dc-b291-5725cee52d82" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186352581} {:answer/id #uuid "74558c61-b294-5a8c-be71-44c0d3822c23" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186352586} {:answer/id #uuid "b27eb1ec-b060-5c68-b2a6-225457f0de0e" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186353093} {:answer/id #uuid "b5c62a94-26b3-5bea-ae7b-f2fbef1384ec" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186353125}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186352586} :answer-field/id #uuid "607dd21d-aeb7-5920-91bc-f439f202ce2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353991}] :question/id #uuid "27889ca3-5f85-5eb8-aee5-93c6c3d6c2ad" :question/math-academy-id "q-88298" :question/problem "Given that \n$|\\begin{aligned}a+2 & -2 & 2 \\\\ b+3 & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|=5,$\nfind \n$|\\begin{aligned}a+1 & -2 & 2 \\\\ b & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+1 & -2 & 2 \\\\ b & 4 & 2 \\\\ c & 0 & 1\\end{aligned}| & =|\\begin{aligned}(a+2)-1 & -2 & 2 \\\\ (b+3)-3 & 4 & 2 \\\\ c+0 & 0 & 1\\end{aligned}|\\end{aligned}\n$$\n\n  \n\nNow, using the linearity property of determinants and expanding the second determinant across the $3$rd row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+2)-1 & -2 & 2 \\\\ (b+3)-3 & 4 & 2 \\\\ c+0 & 0 & 1\\end{aligned}| & ={{|\\begin{aligned}(a+2) & -2 & 2 \\\\ (b+3) & 4 & 2 \\\\ c & 0 & 1\\end{aligned}|}_{⏟}}_{5}+|\\begin{aligned}-1 & -2 & 2 \\\\ -3 & 4 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =5+1\\cdot (-1)^{3+3}|\\begin{aligned}-1 & -2 \\\\ -3 & 4\\end{aligned}| \\\\  & =5+(-10) \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "356b3816-6db1-52b5-bb62-b3c3cf31be2b" :answer/type {:db/ident :answer.type/math} :answer/value "282" :db/id #edb/ref 17592186352065} {:answer/id #uuid "4961badc-1952-50cf-a3aa-c27c2154e001" :answer/type {:db/ident :answer.type/math} :answer/value "447" :db/id #edb/ref 17592186352242} {:answer/id #uuid "7e93fedb-8a75-5259-a81d-4a24a5c3ba66" :answer/type {:db/ident :answer.type/math} :answer/value "372" :db/id #edb/ref 17592186352678} {:answer/id #uuid "b7b4f3fb-84a7-5faa-a662-e6383aedf972" :answer/type {:db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186353139} {:answer/id #uuid "d43b6429-3ee0-5e37-bfcf-0795e21063ef" :answer/type {:db/ident :answer.type/math} :answer/value "327" :db/id #edb/ref 17592186353406}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "273" :db/id #edb/ref 17592186353139} :answer-field/id #uuid "d31711c3-cb15-50d5-862f-d3265b1300b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354174}] :question/id #uuid "26f8d807-4854-5fae-88e0-bb503698def0" :question/math-academy-id "q-88301" :question/problem "Find\n$|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|.$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 91 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90+1 & 92+0 & 93+0 \\\\ 90 & 92 & 93\\end{aligned}| & =|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 3 & 6 \\\\ 90 & 92 & 93 \\\\ 90 & 92 & 93\\end{aligned}|+|\\begin{aligned}1 & 3 & 6 \\\\ 1 & 0 & 0 \\\\ 90 & 92 & 93\\end{aligned}| & =0+1(-1)^{2+1}|\\begin{aligned}3 & 6 \\\\ 92 & 93\\end{aligned}| \\\\  & =-(3\\cdot 93-6\\cdot 92) \\\\  & =-(279-552) \\\\  & =273\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2217be1b-0e43-59a5-97bb-6d402bea3ef6" :answer/type {:db/ident :answer.type/math} :answer/value "204" :db/id #edb/ref 17592186351875} {:answer/id #uuid "74fa8be3-ab54-58c6-8925-9df3ccda76de" :answer/type {:db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186352594} {:answer/id #uuid "93ed11fc-9c76-519e-b094-03edef2b5efb" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186352848} {:answer/id #uuid "a2f75795-6763-534e-888d-3664209ea4a4" :answer/type {:db/ident :answer.type/math} :answer/value "202" :db/id #edb/ref 17592186352959} {:answer/id #uuid "c12ae922-eac4-5656-80c2-43cb7caa50fd" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186353236}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186352848} :answer-field/id #uuid "96a4bf2b-6495-570d-a5cc-83942fc77250" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354083}] :question/id #uuid "da76c31c-efa0-5055-96f9-ec1ecc76273f" :question/math-academy-id "q-88304" :question/problem "Find\n$|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}97 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}96+1 & 98+0 & 99+0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $1$st row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}96 & 98 & 99 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}|+|\\begin{aligned}1 & 0 & 0 \\\\ 6 & 4 & 2 \\\\ 96 & 98 & 99\\end{aligned}| & =0+1(-1)^{1+1}|\\begin{aligned}4 & 2 \\\\ 98 & 99\\end{aligned}| \\\\  & =4\\cdot 99-2\\cdot 98 \\\\  & =396-196 \\\\  & =200\\end{aligned}\n$$"} {:db/id #edb/ref 17592186420851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256655f5-3716-5c72-b038-769fa376cf93" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,000" :db/id #edb/ref 17592186420804} {:answer/id #uuid "65294e4c-a8db-5c12-befc-326f1199fa33" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,500" :db/id #edb/ref 17592186420812} {:answer/id #uuid "6c92f4c3-474c-5da4-bd3e-a7ddf9353c60" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,700" :db/id #edb/ref 17592186420813} {:answer/id #uuid "b440a564-08a1-5c84-a502-ec561384a59f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,500" :db/id #edb/ref 17592186420821} {:answer/id #uuid "e3f48478-6c84-5d48-9002-c26925eb220f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186420836}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4\\,000" :db/id #edb/ref 17592186420804} :answer-field/id #uuid "db1d1fba-e4ba-50df-bd35-d24e24ca86ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420845}] :question/id #uuid "80589b9c-bfb0-57bc-8e70-de307d877343" :question/math-academy-id "q-88306" :question/problem "$|\\begin{aligned}300 & 250 & 100 \\\\ 300 & 270 & 100 \\\\ 1 & -1 & 1\\end{aligned}|=$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $2$nd row. So, we can rewrite the given determinant, as follows: \n\n$$\n\\begin{aligned}|\\begin{aligned}300 & 250 & 100 \\\\ 300 & 270 & 100 \\\\ 1 & -1 & 1\\end{aligned}| & =|\\begin{aligned}300 & 250 & 100 \\\\ 300+0 & 250+20 & 100+0 \\\\ 1 & -1 & 1\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}300 & 250 & 100 \\\\ 300+0 & 250+20 & 100+0 \\\\ 1 & -1 & 1\\end{aligned}| & =|\\begin{aligned}300 & 250 & 100 \\\\ 300 & 250 & 100 \\\\ 1 & -1 & 1\\end{aligned}|+|\\begin{aligned}300 & 250 & 100 \\\\ 0 & 20 & 0 \\\\ 1 & -1 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows: \n\n$$\n\\begin{aligned}|\\begin{aligned}300 & 250 & 100 \\\\ 300 & 250 & 100 \\\\ 1 & -1 & 1\\end{aligned}|+|\\begin{aligned}300 & 250 & 100 \\\\ 0 & 20 & 0 \\\\ 1 & -1 & 1\\end{aligned}| & =0+20(-1)^{2+2}|\\begin{aligned}300 & 100 \\\\ 1 & 1\\end{aligned}| \\\\  & =20\\cdot (300\\cdot 1-100\\cdot 1) \\\\  & =20\\cdot 200 \\\\  & =4\\,000\\end{aligned}\n$$"} {:db/id #edb/ref 17592186420852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f66b246-867d-5382-b745-224f4b0b1960" :answer/type {:db/ident :answer.type/math} :answer/value "-276" :db/id #edb/ref 17592186420805} {:answer/id #uuid "6f34b981-25b3-5127-9dcc-d184355dec85" :answer/type {:db/ident :answer.type/math} :answer/value "429" :db/id #edb/ref 17592186420814} {:answer/id #uuid "bbaccfd8-0fee-5b02-b497-78e555afcf98" :answer/type {:db/ident :answer.type/math} :answer/value "294" :db/id #edb/ref 17592186420826} {:answer/id #uuid "dd980cfa-ae7f-54ba-bba4-12f039277176" :answer/type {:db/ident :answer.type/math} :answer/value "-372" :db/id #edb/ref 17592186420835} {:answer/id #uuid "e9605807-1150-5819-807b-86c3f17e6ec2" :answer/type {:db/ident :answer.type/math} :answer/value "-346" :db/id #edb/ref 17592186420838}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-372" :db/id #edb/ref 17592186420835} :answer-field/id #uuid "96ea088a-9b87-51d6-9259-b1c59aec445a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420843}] :question/id #uuid "8c3dc4f1-ad56-595b-a7eb-41a85271c7fe" :question/math-academy-id "q-130693" :question/problem "Find\n$|\\begin{aligned}8 & 4 & 2 \\\\ 114 & 210 & 198 \\\\ 113 & 210 & 198\\end{aligned}|=$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}8 & 4 & 2 \\\\ 114 & 210 & 198 \\\\ 113 & 210 & 198\\end{aligned}| & =|\\begin{aligned}8 & 4 & 2 \\\\ 113+1 & 210+0 & 198+0 \\\\ 113 & 210 & 198\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}8 & 4 & 2 \\\\ 113+1 & 210+0 & 198+0 \\\\ 113 & 210 & 198\\end{aligned}| & =|\\begin{aligned}8 & 4 & 2 \\\\ 113 & 210 & 198 \\\\ 113 & 210 & 198\\end{aligned}|+|\\begin{aligned}8 & 4 & 2 \\\\ 1 & 0 & 0 \\\\ 113 & 210 & 198\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}8 & 4 & 2 \\\\ 113 & 210 & 198 \\\\ 113 & 210 & 198\\end{aligned}|+|\\begin{aligned}8 & 4 & 2 \\\\ 1 & 0 & 0 \\\\ 113 & 210 & 198\\end{aligned}| & =0+1(-1)^{2+1}|\\begin{aligned}4 & 2 \\\\ 210 & 198\\end{aligned}| \\\\  & =-(4\\cdot 198-2\\cdot 210) \\\\  & =-(792-420) \\\\  & =-372\\end{aligned}\n$$"} {:db/id #edb/ref 17592186435767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd88020-b9de-5670-bbb4-d000faac032e" :answer/type {:db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186435744} {:answer/id #uuid "4e375b53-cb2c-56d7-a604-46a74124343b" :answer/type {:db/ident :answer.type/math} :answer/value "214" :db/id #edb/ref 17592186435749} {:answer/id #uuid "82e7b3e3-84d8-5737-a5f1-d3862a09a444" :answer/type {:db/ident :answer.type/math} :answer/value "186" :db/id #edb/ref 17592186435753} {:answer/id #uuid "ac3611ee-496d-5cec-8534-0299f1c2f846" :answer/type {:db/ident :answer.type/math} :answer/value "260" :db/id #edb/ref 17592186435756} {:answer/id #uuid "f62fda4e-f88c-56fa-9e53-1860b2a19543" :answer/type {:db/ident :answer.type/math} :answer/value "244" :db/id #edb/ref 17592186435762}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "260" :db/id #edb/ref 17592186435756} :answer-field/id #uuid "0e7b949d-cbe6-5045-bf34-26b00edf4f82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435763}] :question/id #uuid "3797960f-4f46-583b-afe6-1bb724ee5f4b" :question/math-academy-id "q-130641" :question/problem "Find\n$|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 103 \\\\ 144 & 158 & 102\\end{aligned}|=$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 103 \\\\ 144 & 158 & 102\\end{aligned}| & =|\\begin{aligned}2 & 4 & -7 \\\\ 144+0 & 158+0 & 102+1 \\\\ 144 & 158 & 102\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144+0 & 158+0 & 102+1 \\\\ 144 & 158 & 102\\end{aligned}| & =|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 102 \\\\ 144 & 158 & 102\\end{aligned}|+|\\begin{aligned}2 & 4 & -7 \\\\ 0 & 0 & 1 \\\\ 144 & 158 & 102\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 & -7 \\\\ 144 & 158 & 102 \\\\ 144 & 158 & 102\\end{aligned}|+|\\begin{aligned}2 & 4 & -7 \\\\ 0 & 0 & 1 \\\\ 144 & 158 & 102\\end{aligned}| & =0+1(-1)^{2+3}|\\begin{aligned}2 & 4 \\\\ 144 & 158\\end{aligned}| \\\\  & =-(2\\cdot 158-4\\cdot 144) \\\\  & =-(316-576) \\\\  & =260\\end{aligned}\n$$"} {:db/id #edb/ref 17592186435768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74feda84-0372-5ba8-a03f-6504fdd43cb8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435751} {:answer/id #uuid "81e999d9-b74a-531e-b396-75bcda8940a5" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186435752} {:answer/id #uuid "a5465cc4-707e-5513-9c9b-2c4ccb77d7a1" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186435754} {:answer/id #uuid "aee93a59-f631-5538-b707-3dbdac3a5bb0" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186435757} {:answer/id #uuid "c2c0bd69-0ae8-5c67-b00c-53d8d88f988d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435758}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186435752} :answer-field/id #uuid "ea1881ff-14ad-5797-8c35-e1990ea0829e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435766}] :question/id #uuid "788f9347-638e-5e07-bc97-727179291d72" :question/math-academy-id "q-130780" :question/problem "Given that \n$|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|=3,$\nfind \n$|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & =|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants and expanding the second determinant across the $1$st row, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}a-2 & b+0 & c+0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| & ={{|\\begin{aligned}a & b & c \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}|}_{⏟}}_{3}+|\\begin{aligned}-2 & 0 & 0 \\\\ -3 & 5 & -1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =3-2(-1)^{1+1}|\\begin{aligned}5 & -1 \\\\ 1 & 1\\end{aligned}| \\\\  & =3-2\\cdot (5+1) \\\\  & =-9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd15e66-d81f-505f-ae3a-06ee7efe8da5" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186483817} {:answer/id #uuid "7f02f7ea-bb98-517e-b82f-b806e5e2a73b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,170" :db/id #edb/ref 17592186483828} {:answer/id #uuid "92f177fd-349d-5f7e-80b4-6b9c20c3f3eb" :answer/type {:db/ident :answer.type/math} :answer/value "578" :db/id #edb/ref 17592186483871} {:answer/id #uuid "a70b093d-7492-5a92-b086-4158c45fe368" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,272" :db/id #edb/ref 17592186483908} {:answer/id #uuid "cd8cb6ec-b4fb-5a1e-8a74-79d83ac487eb" :answer/type {:db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186483978}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186483978} :answer-field/id #uuid "87ae0d39-79d3-52b7-9037-2374608a8562" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484148}] :question/id #uuid "3c0dc310-8159-56fb-918f-2199e65fa375" :question/math-academy-id "q-42585" :question/problem "Find\n$|\\begin{aligned}4 & 6 & 9 \\\\ 202 & 203 & 205 \\\\ 202 & 203 & 204\\end{aligned}|.$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 6 & 9 \\\\ 202 & 203 & 205 \\\\ 202 & 203 & 204\\end{aligned}| & =|\\begin{aligned}4 & 6 & 9 \\\\ 202+0 & 203+0 & 204+1 \\\\ 202 & 203 & 204\\end{aligned}|\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 6 & 9 \\\\ 202+0 & 203+0 & 204+1 \\\\ 202 & 203 & 204\\end{aligned}| & =|\\begin{aligned}4 & 6 & 9 \\\\ 202 & 203 & 204 \\\\ 202 & 203 & 204\\end{aligned}|+|\\begin{aligned}4 & 6 & 9 \\\\ 0 & 0 & 1 \\\\ 202 & 203 & 204\\end{aligned}|.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 6 & 9 \\\\ 202 & 203 & 204 \\\\ 202 & 203 & 204\\end{aligned}|+|\\begin{aligned}4 & 6 & 9 \\\\ 0 & 0 & 1 \\\\ 202 & 203 & 204\\end{aligned}| & =0+1(-1)^{2+3}|\\begin{aligned}4 & 6 \\\\ 202 & 203\\end{aligned}| \\\\  & =-(4\\cdot 203-6\\cdot 202) \\\\  & =-(812-1\\,212) \\\\  & =400\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b3c0e7-01c6-5510-aaa7-6103067cdafd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483600} {:answer/id #uuid "57d0f5ec-4050-55b9-86ce-57bffb2142ba" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186483727} {:answer/id #uuid "9d96e0aa-ca98-55b2-a431-8d6b9c26a4cc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483888} {:answer/id #uuid "ad587483-130d-5a95-91ba-0265af6e89b9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186483916} {:answer/id #uuid "e2da65e2-07d0-5e36-abf3-a1b103221c3b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484016}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484016} :answer-field/id #uuid "cab925e1-8606-5f87-ab70-d0c31c22a818" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484177}] :question/id #uuid "eb18f7db-5036-553a-815a-b1774de95355" :question/math-academy-id "q-42580" :question/problem "Given that \n$|\\begin{aligned}2 & 4 \\\\ a & b-1\\end{aligned}|=5$,\nfind \n$|\\begin{aligned}2 & 4 \\\\ a+2 & b\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 \\\\ a+2 & b\\end{aligned}| & =|\\begin{aligned}2 & 4 \\\\ a+2 & (b-1)+1\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 4 \\\\ a+2 & (b-1)+1\\end{aligned}| & ={{|\\begin{aligned}2 & 4 \\\\ a & b-1\\end{aligned}|}_{⏟}}_{5}+|\\begin{aligned}2 & 4 \\\\ 2 & 1\\end{aligned}| \\\\  & =5+(2-8) \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1535aac7-a580-50c9-bb4b-02062ef10430" :answer/type {:db/ident :answer.type/math} :answer/value "-41" :db/id #edb/ref 17592186513587} {:answer/id #uuid "30b9adea-211f-53a0-9e3a-0b6f4d8b955e" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186513661} {:answer/id #uuid "6744b428-41a3-57bb-b1be-72c3c470befb" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186513808} {:answer/id #uuid "a12728ba-7099-5bf8-8866-47c0e9602d58" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186513945} {:answer/id #uuid "a12f5c16-20dd-5336-876b-869d81a32fc6" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186513946}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-41" :db/id #edb/ref 17592186513587} :answer-field/id #uuid "c336fca6-9149-5cbc-a19d-a2bfb6cf6d63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514318}] :question/id #uuid "e3cff1af-b64e-5d5d-98b9-281348f5cad1" :question/math-academy-id "q-130697" :question/problem "Given that \n$|\\begin{aligned}a+5 & 5 \\\\ b & -3\\end{aligned}|=-34$,\nfind \n$|\\begin{aligned}a+4 & 5 \\\\ b+2 & -3\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+4 & 5 \\\\ b+2 & -3\\end{aligned}| & =|\\begin{aligned}(a+5)-1 & 5 \\\\ b+2 & -3\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+5)-1 & 5 \\\\ b+2 & -3\\end{aligned}| & ={{|\\begin{aligned}a+5 & 5 \\\\ b & -3\\end{aligned}|}_{⏟}}_{-34}+|\\begin{aligned}-1 & 5 \\\\ 2 & -3\\end{aligned}| \\\\  & =-34+(3-10) \\\\  & =-41.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Determinant Using the Linearity of the Determinant"}] :topic/math-academy-id 1774 :topic/title "Further Properties of Determinants"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186189078} :activity/id #uuid "e8e2dcd1-d239-5120-a71f-5337f9c0fb01" :activity/steps [{:db/id #edb/ref 17592186189060 :step/content {:db/id #edb/ref 17592186188261 :knowledge-point/id #uuid "9cc062b6-306b-5edc-81db-1a3051cf3f51"} :step/id #uuid "4b289521-18f1-582d-b604-520f11ba29d7" :step/next {:db/id #edb/ref 17592186189088}} {:db/id #edb/ref 17592186189077 :step/content {:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904"} :step/id #uuid "626e026a-01da-503f-a127-2b353dbc209b"} {:db/id #edb/ref 17592186189078 :step/content {:db/id #edb/ref 17592186189365 :tutorial/content "The **rank-nullity theorem in terms of linear transformations** states the following:\n\n*If $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is a linear transformation, then*\n\n$$\n\\textrm{dim(Im}(\\mathbf{T})) + \\textrm{dim(Ker}(\\mathbf{T})) = \\textrm{dim}(\\mathbb{R}^n),\n$$\n\n*or equivalently,*\n\n$$\n\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.\n$$\n\nFor example, suppose that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ is a linear transformation such that\n\n$$\n\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, y+2z=0\\}.\n$$\n\nLet's use the rank-nullity theorem to compute $\\textrm{rank}(\\mathbf{T})$ and $\\text{nullity}(\\mathbf{T}).$ \n\nFirst, solving $y+2z=0$ for $y,$ we get $y = -2z.$ Therefore, any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ -2z \\\\ z\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}+z{{\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2\\}.$ And since $\\mathbf v_1$ and $\\mathbf v_2$ are linearly independent, we have $\\textrm{rank}(\\mathbf{T})=2.$ \n\nFinally, using the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$" :tutorial/id #uuid "9c4215af-a9cf-5a1a-aabc-40c5395f2df4" :tutorial/math-academy-id 4379 :tutorial/title "Introduction"} :step/id #uuid "9e0c933b-d880-5bfa-804a-944d21dae8a3" :step/next {:db/id #edb/ref 17592186189060}} {:db/id #edb/ref 17592186189088 :step/content {:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db"} :step/id #uuid "6735a644-2990-5e5c-b639-afb52f0b4d15" :step/next {:db/id #edb/ref 17592186189077}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186188448} {:activity/first-step {:db/id #edb/ref 17592186406847} :activity/id #uuid "1a6d8485-0053-526d-9b37-3def23fa3c0b" :activity/steps [{:db/id #edb/ref 17592186406844 :step/content {:db/id #edb/ref 17592186406841 :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b"} :step/id #uuid "4b0b57c7-2d59-5d20-9983-005e3257de52" :step/next {:db/id #edb/ref 17592186406845}} {:db/id #edb/ref 17592186406845 :step/content {:db/id #edb/ref 17592186406840 :question/id #uuid "7bb2599b-79c3-5637-9b4b-ca26bce210be"} :step/id #uuid "81a2fa92-8011-53d7-b83d-7c048c758080" :step/next {:db/id #edb/ref 17592186406846}} {:db/id #edb/ref 17592186406846 :step/content {:db/id #edb/ref 17592186406843 :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72"} :step/id #uuid "83597e6d-f7ab-5d6b-86d3-62716c58dc6e"} {:db/id #edb/ref 17592186406847 :step/content {:db/id #edb/ref 17592186188925 :question/id #uuid "1b3a8f74-a4d2-5020-9ea6-4077acac1b2e"} :step/id #uuid "962a6c24-9fbc-5081-8aa6-b1e292aead4b" :step/next {:db/id #edb/ref 17592186406848}} {:db/id #edb/ref 17592186406848 :step/content {:db/id #edb/ref 17592186406842 :question/id #uuid "94b1ad7b-577b-5c7c-8164-0f25bc8b5263"} :step/id #uuid "a96e7cad-642a-5c4d-add9-f21b4c3f7cb6" :step/next {:db/id #edb/ref 17592186406844}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186406809} {:activity/first-step {:db/id #edb/ref 17592186505869} :activity/id #uuid "64479ace-7012-51d4-b2b4-8738e61571ac" :activity/steps [{:db/id #edb/ref 17592186505848 :step/content {:db/id #edb/ref 17592186365087 :question/id #uuid "d46dc660-c500-5191-bb8e-c57af2a79535"} :step/id #uuid "04cb0c84-a155-5f7d-84eb-582ddec2e63e"} {:db/id #edb/ref 17592186505854 :step/content {:db/id #edb/ref 17592186366441 :question/id #uuid "c2cc1677-8220-5afa-89bb-f3b005d1f893"} :step/id #uuid "1c8b644d-c1aa-5054-80bb-2094a58661c1" :step/next {:db/id #edb/ref 17592186505875}} {:db/id #edb/ref 17592186505856 :step/content {:db/id #edb/ref 17592186366427 :question/id #uuid "3f6a64ec-417d-5f3c-a079-819cbc656ca3"} :step/id #uuid "29152df7-9145-56fd-81cf-7990f5f65284" :step/next {:db/id #edb/ref 17592186505854}} {:db/id #edb/ref 17592186505869 :step/content {:db/id #edb/ref 17592186505754 :question/id #uuid "31c1a37a-969b-5cd4-b27b-164fe43832ff"} :step/id #uuid "58501b2a-32e9-5f10-a02d-62409c76c2b9" :step/next {:db/id #edb/ref 17592186505856}} {:db/id #edb/ref 17592186505875 :step/content {:db/id #edb/ref 17592186406840 :question/id #uuid "7bb2599b-79c3-5637-9b4b-ca26bce210be"} :step/id #uuid "7cd92d7a-8193-53d1-bf92-9e1fa1598872" :step/next {:db/id #edb/ref 17592186505848}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186505097}] :db/id #edb/ref 17592186049880 :topic/knowledge-points [{:db/id #edb/ref 17592186188261 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188204 :question/id #uuid "4b196d96-a95f-53d6-a0c5-7233de14a401" :question/math-academy-id "e-5445" :question/problem "Consider a linear transformation $\\mathbf{T}:\\mathbb{R}^3 \\to \\mathbb{R}^3.$ If $\\textrm{nullity}(\\mathbf{T})=1,$ then what is $\\textrm{rank}(\\mathbf{T})?$" :question/worked-solution "According to the rank-nullity theorem, if $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n,$ then\n\n$$\n\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.\n$$\n\nFor the given transformation, we have $n=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+1 & =3 \\\\ \\text{rank}(T) & =3-1 \\\\  & =2.\\end{aligned}\n$$"} :knowledge-point/id #uuid "9cc062b6-306b-5edc-81db-1a3051cf3f51" :knowledge-point/questions [{:db/id #edb/ref 17592186188917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "999552af-4a65-5d35-8a57-be755cf21116" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186187579} {:answer/id #uuid "e252adee-2bfa-5c9e-af31-8db9400b697c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186187580} {:answer/id #uuid "1380778d-b9e4-55b6-b36d-d000c332c817" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186187581} {:answer/id #uuid "30dcaada-03bf-5ca7-b9ad-0ef73d579b91" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186187582} {:answer/id #uuid "7b8031c5-03ff-598c-baee-bca879ed2d72" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186187583}] :answer-field/id #uuid "72a2b6a8-05ac-53e2-b707-38941e1c8764" :answer-field/key