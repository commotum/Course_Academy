ed}\\sqrt{5} & 2\\sqrt{5} \\\\ 0 & \\sqrt{2}\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{\\sqrt{70}}[\\begin{aligned}\\sqrt{5} & 3\\sqrt{5} & 2\\sqrt{5} \\\\ \\sqrt{2} & 3\\sqrt{2} & -5\\sqrt{2}\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}-1 \\\\ -3 \\\\ 0\\end{aligned}]}} \\\\ [\\begin{aligned}\\sqrt{5} & 2\\sqrt{5} \\\\ 0 & \\sqrt{2}\\end{aligned}]x & =[\\begin{aligned}-10\\sqrt{5} \\\\ -10\\sqrt{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2} &=-10\\sqrt{5} \\\\ \\sqrt{2}{x}_{2} &=-10\\sqrt{2}.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-10.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}\\sqrt{5}{x}_{1}+2\\sqrt{5}(-10) & =-10\\sqrt{5} \\\\ \\sqrt{5}{x}_{1} & =10\\sqrt{5} \\\\ {x}_{1} & =10.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $[\\begin{aligned}10 \\\\ -10\\end{aligned}].$"} {:db/id #edb/ref 17592186564531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9e21c3-28d7-5744-b751-8735eef80c3e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186564048} {:answer/id #uuid "45ccbd17-a611-5e51-8f96-c134314902f7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186564085} {:answer/id #uuid "6c912a39-aa9c-5584-bd27-ebb5f9b76c23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186564139} {:answer/id #uuid "8c06bd3e-d522-582e-8e6e-842930f9ae84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186564186} {:answer/id #uuid "ae08b2e2-ed79-5464-95a9-3d40e4f6d24d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186564235}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186564186} :answer-field/id #uuid "99733e29-1d7e-5770-81f4-dc925a89eb32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564425}] :question/id #uuid "e0061631-6269-58a0-a054-4e33a330ba6f" :question/math-academy-id "q-139798" :question/problem "Given the QR decomposition $A=QR,$ find the least-squares solution to $Ax=b,$ where\n\n$$\nQ=\\frac{1}{9}[\\begin{aligned}8 & -1 \\\\ 4 & 4 \\\\ -1 & 8\\end{aligned}],\\,R=\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "The least-squares solution $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}8 & 4 & -1 \\\\ -1 & 4 & 8\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}} \\\\ [\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]x & =[\\begin{aligned}-9 \\\\ 9\\end{aligned}]\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\{\\begin{aligned}9{x}_{1}+8{x}_{2}=-9 \\\\ {x}_{2}=9.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=9.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}9{x}_{1}+8(9) & =-9 \\\\ 9{x}_{1} & =-81 \\\\ {x}_{1} & =-9.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $[\\begin{aligned}-9 \\\\ 9\\end{aligned}].$"}] :knowledge-point/title "Finding the Least-Squares Solution of a Linear System Given a QR Factorization"} {:db/id #edb/ref 17592186133906 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133719 :question/id #uuid "d805b370-4377-5101-8ac7-3d30e11156ba" :question/math-academy-id "e-9917" :question/problem "$$\n\\bbox[5px, border: 1px solid black]{\\phantom{A}} \\, \\mathbf{x} = \\bbox[5px, border: 1px solid black]{\\phantom{A}} \\, \\mathbf{b}\n$$\n\nLet $A=QR$  be a QR decomposition of an $m \\times n$ matrix $A$ with linearly independent columns, and the matrix equation above gives the least-squares solution of $A\\mathbf{x}=\\mathbf{b}.$ From left to right, what are the missing parts of the equation?" :question/worked-solution "The least-squares solution of $A\\mathbf{x}=\\mathbf{b}$ satisfies the normal equation\n\n$$\nA^T A\\mathbf{x} = A^T\\mathbf{b}.\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, it satisfies $Q^T Q = I,$ and we get\n\n$$\nR^T R \\mathbf{x} = R^T \\! Q^T \\mathbf{b}.\n$$\n\nFinally, since $R^T$ is invertible, pre-multiplying by $(R^T)^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ \\bbox[5px,border:1px solid black]{\\,R\\phantom{|}}\\,\\,x & ={Q}^{T}\\,b.\\end{aligned}\n$$\n\nTherefore, the missing parts of the equation are $R$ and $Q^T.$"} :knowledge-point/id #uuid "c7d226d3-f7d3-574f-94f9-a532ec99b0ac" :knowledge-point/questions [{:db/id #edb/ref 17592186134110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a038e167-5d