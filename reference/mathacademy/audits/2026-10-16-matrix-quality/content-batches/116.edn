}_{3}$ orthogonal to $\\text{Span}{{v}_{1},{v}_{2}}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2} \\\\  & =\\begin{bmatrix}6 \\\\ -6 \\\\ -1 \\\\ 2\\end{bmatrix}-\\frac{11}{11}\\begin{bmatrix}1 \\\\ 0 \\\\ -3 \\\\ 1\\end{bmatrix}-\\frac{7}{7}\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -6 \\\\ -1 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 0 \\\\ -3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -7 \\\\ 1 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\frac{a}{c}=\\frac{3}{1}=3.\n$$"} {:db/id #edb/ref 17592186360641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36661804-8aee-5105-9af0-5d2bda82b882" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186358233} {:answer/id #uuid "56a0cace-212b-5c47-b830-7b0c6611b32d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186358504} {:answer/id #uuid "7a62f4e7-40a0-5e03-bef4-70d7ffbd37b4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186358814} {:answer/id #uuid "c5a3b6a9-9881-527d-b171-0bb9547ac205" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359484} {:answer/id #uuid "cadbf9f2-ffb4-5ba9-906f-a6b3e46f386d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186359532}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186359532} :answer-field/id #uuid "461a8ef7-6aa5-5e72-a2c2-555622e5ddff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360106}] :que