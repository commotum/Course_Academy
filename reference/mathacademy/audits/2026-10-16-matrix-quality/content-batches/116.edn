atrix}-3\\sqrt{14} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}\\sqrt{14}{x}_{1}+3\\sqrt{14}{x}_{2} &=-3\\sqrt{14} \\\\ 3\\sqrt{3}{x}_{2} &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=0.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}\\sqrt{14}{x}_{1}+3\\sqrt{14}(0) & =-3\\sqrt{14} \\\\ \\sqrt{14}{x}_{1} & =-3\\sqrt{14} \\\\ {x}_{1} & =-3.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $\\begin{bmatrix}-3 \\\\ 0\\end{bmatrix}.$"} {:db/id #edb/ref 17592186410811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfa9745-27c9-5c69-9259-9f33cdd30cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410781} {:answer/id #uuid "290a80b2-d833-5e18-ba11-922da75fadbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186410784} {:answer/id #uuid "84becdeb-7cb6-51f9-8247-37058f839cfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186410791} {:answer/id #uuid "ab331c8e-8ec8-5a70-b8c2-e3efcd32bf48" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186410795} {:answer/id #uuid "d9a2f5a3-da1b-5892-8fa1-25b99c4d869f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410799}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186410795} :answer-field/id #uuid "44672c62-c008-5400-a940-292eccf518a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410804}] :question/id #uuid "c8892a71-2970-5d65-891c-76f1124825ea" :question/math-