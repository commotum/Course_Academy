f 17592186365081}] :question/id #uuid "93ca63e2-f868-5041-861e-481f25303fb1" :question/math-academy-id "q-141429" :question/problem "Consider a linear transformation $T:{R}^{10}\\to {R}^{10}.$ If $\\text{rank}(T)=6$ then $\\text{nullity}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=10.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ 6+\\text{nullity}(T) & =10 \\\\ \\text{nullity}(T) & =10-6 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b88afccc-c901-584c-bab7-36a7a8652780" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366436} {:answer/id #uuid "10b25d6a-9ed5-5bf7-9e93-6c64a1e15b06" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366437} {:answer/id #uuid "6f5a9aa2-9b0f-586c-8584-64f6be0c0194" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366438} {:answer/id #uuid "7ed19647-3bc2-53b6-82ae-5cd7bac4bab8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186366439} {:answer/id #uuid "0116b39d-d995-5df6-b7ef-66e09ac7e45d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366440}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366440} :answer-field/id #uuid "8fc91339-c96e-5ac5-9d62-afb620adf1d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366435}] :question/id #uuid "96175326-e1dd-5dc8-bec1-50abdddc7a3d" :question/math-academy-id "q-83445" :question/problem "Consider a linear transformation $T:{R}^{4}\\to {R}^{4}.$ If $\\text{rank}(T)=4$ then $\\text{nullity}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ 4+\\text{nullity}(T) & =4 \\\\ \\text{nullity}(T) & =4-4 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f43a18-d791-5a02-801f-df3387b654f5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492228} {:answer/id #uuid "6a246604-aaa7-55b5-bab5-a4f06f9cea5a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186492428} {:answer/id #uuid "b3e0c222-dde9-50f4-9203-5e6c0c0f12c7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492576} {:answer/id #uuid "d2566bb9-7c8f-5410-8d5b-d5a4770b8c9d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492632} {:answer/id #uuid "f9bcdef5-3329-5d37-abe0-e83d65624660" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492698}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492632} :answer-field/id #uuid "a7254d97-c107-5cd3-ac3d-c4b19a9b8902" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492773}] :question/id #uuid "0f1a69d2-da4d-539f-85b3-5e00cfab3ac7" :question/math-academy-id "q-141430" :question/problem "Consider a linear transformation $T:{R}^{5}\\to {R}^{5}.$ If $\\text{rank}(T)=1$ then $\\text{nullity}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ 1+\\text{nullity}(T) & =5 \\\\ \\text{nullity}(T) & =5-1 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186492922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ece1630-5fc9-5fa3-bff5-c3877dbe20e0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186492243} {:answer/id #uuid "31a74265-ac02-58e5-96a3-8af498759acb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492322} {:answer/id #uuid "991369ce-452a-5ef2-95ba-e3a495f00ee7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186492514} {:answer/id #uuid "a5b11d96-fc0e-5fe3-ba6f-917cc5262380" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186492551} {:answer/id #uuid "f5f5c64c-d239-5fc6-a10c-ef12ea321845" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492690}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492322} :answer-field/id #uuid "e6a1b3a9-cf8a-56c9-b44f-3a84bdac3d50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492804}] :question/id #uuid "f0e7b715-b8f5-546c-8370-11eb96261ecd" :question/math-academy-id "q-84054" :question/problem "Consider a linear transformation $T:{R}^{6}\\to {R}^{6}.$ If $\\text{nullity}(T)=0$ then $\\text{rank}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+0 & =6 \\\\ \\text{rank}(T) & =6-0 \\\\  & =6.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Using the Rank-Nullity Theorem"} {:db/id #edb/ref 17592186188273 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188207 :question/id #uuid "0eddf8b0-bdd9-55db-9388-d39bd91c24c1" :question/math-academy-id "e-7251" :question/problem "Let $\\mathbf{T}: \\mathbb{R}^4 \\rightarrow \\mathbb{R}^4$ be a linear transformation whose standard matrix is $T,$ and let $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\}$ be a set of linearly independent vectors in $\\mathbb{R}^4.$ Consider the following statement:\n\n*If  $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3\\}$, then $\\textrm{__________}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\textrm{rank}(T)=3$\n\nII. $\\textrm{nullity}(\\mathbf{T})=3$\n\nIII. $\\mathbf{T}$ is a bijection" :question/worked-solution "Since $\\mathbf{T}$ is a linear transformation from $\\mathbb{R}^4$ into $\\mathbb{R}^4,$ the invertible matrix theorem states the following:\n\n $\\mathbf{T}$ is a bijection (an invertible transformation) ![](images/5d/5d330995eaf0f71f9006f897a75e9e892caecb94eb8c8b48d7ba7f116633b6e3.svg) \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = 4.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3\\}$ and the set $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\}$ is linearly independent, we get that $\\textrm{rank}(T)=\\textrm{rank}(\\mathbf{T})=3.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =4-\\text{rank}(T) \\\\  & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\textrm{rank}(\\mathbf{T}) \\neq 4$ (or since $\\textrm{nullity}(\\mathbf{T}) \\neq 0$), the linear transformation $\\mathbf{T}$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\""} :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/questions [{:db/id #edb/ref 17592186188911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4c3240-efcc-5031-be97-b18f24fa624c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477283} {:answer/id #uuid "80eef841-b3bb-539f-a20d-b7af5fdc129f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477284}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477283} :answer-field/id #uuid "97b22468-5364-5814-ab56-00d3827125a4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477611} {:answer-field/choices [{:answer/id #uuid "2ddb04cf-498a-5aa6-bd12-7e6b3799bde4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477285} {:answer/id #uuid "6462c36b-1577-5e5f-980f-afbd1f21ace1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477286}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477286} :answer-field/id #uuid "f417e3d1-8fa9-576f-97f4-84f0c7ed2417" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477612} {:answer-field/choices [{:answer/id #uuid "e7971526-d720-5bf2-916b-1c3268cfc3a8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477287} {:answer/id #uuid "ca68341f-f266-5714-a2d3-03c3de4d3096" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477288}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477287} :answer-field/id #uuid "cf2f78e9-40f7-51c7-9823-236bb1c047ce" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477613}] :question/id #uuid "e86ac40c-9f96-593f-88c6-aef65bbc3b17" :question/math-academy-id "q-38136" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3}}$, then $\\text{__________}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{rank}(T)=1$\n- **II.** $\\text{nullity}(T)=2$\n- **III.** $T$ is a bijection\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3}}$ and the set ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=3.$\n\n- Statement II is true. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"II only.\""} {:db/id #edb/ref 17592186188925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140e8026-dca4-518e-b2e3-6a5204699c9a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448696} {:answer/id #uuid "91598bc4-014d-5d6b-96f5-a46fe7a19ef6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448697}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448697} :answer-field/id #uuid "b185c70a-936c-56ce-a09e-491c0f5906d5" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449388} {:answer-field/choices [{:answer/id #uuid "5f7fce4d-3fa7-56db-8465-e02eebbb3df7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448698} {:answer/id #uuid "973d8243-55d9-5ba6-9a8d-9dc8eca9d0e6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448699}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448698} :answer-field/id #uuid "6276cdd8-8c2d-5458-9242-9db53bf98878" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449389} {:answer-field/choices [{:answer/id #uuid "8433f050-2198-5d04-bcdc-9660fdcf23e4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448700} {:answer/id #uuid "3c8ade48-b616-5c30-ace3-11755e23e2b0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448701}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448700} :answer-field/id #uuid "9bfb10db-820c-5886-b42e-f40a5038d34d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449390}] :question/id #uuid "1b3a8f74-a4d2-5020-9ea6-4077acac1b2e" :question/math-academy-id "q-47524" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,3x+2y-z=0}$ then $\\text{nullity}(T)=1$\n- **II.** If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T}$ then $T$ is invertible\n- **III.** If ${v}_{1},$ ${v}_{2},$ and ${v}_{3}$ are the columns of $T$ and ${v}_{3}={v}_{1}+2{v}_{2}$, then $\\text{Ker}(T)={0}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Solving $3x+2y-z=0$ for $z,$ we get $z=3x+2y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 3x+2y\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}}_{⏟}}_{{v}_{1}}+y{{\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T},$ then \n\n$$\nT{v}_{1}=T{v}_{2}\\,⟹\\,T({v}_{1}-{v}_{2})=0,\n$$\n\nwhere ${v}_{1}-{v}_{2}$ is a non-zero vector. This means that $\\text{Ker}(T)=\\text{Null}(T)\\ne {0}$ and, according to the invertible matrix theorem, $T$ can't be invertible.\n\n- Statement III is false. If the columns of $T$ are such that ${v}_{3}={v}_{1}+2{v}_{2},$ then the set of vectors ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent and therefore $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Now, according to the matrix invertible theorem, we obtain that $\\text{Ker}(T)\\ne {0}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186366039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffbbdf5b-b5a9-58a5-b789-13db6ff1a8ed" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469014} {:answer/id #uuid "725a5695-1253-5d33-8d18-e5f71e632c92" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469015}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469014} :answer-field/id #uuid "134c0d8a-c3e3-5d31-a016-da1dea915d49" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470119} {:answer-field/choices [{:answer/id #uuid "c68912f2-a32e-5af0-bfd8-53a4e352fc40" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469016} {:answer/id #uuid "90511e22-e82e-54b5-a8be-46168f1b6a40" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469017}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469017} :answer-field/id #uuid "8d16e520-7b60-5e2f-8e42-9334e0996e9c" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470120} {:answer-field/choices [{:answer/id #uuid "4e45344d-c214-5cf1-9c6c-7c83274e9ea5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469018} {:answer/id #uuid "c1ea614b-40b5-59b4-ac19-8dc8a355b72f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469019}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469018} :answer-field/id #uuid "1f93777f-8292-5756-b7f9-4905592e30dc" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470121}] :question/id #uuid "006b1b75-818e-5ba9-8f81-bc35ede44097" :question/math-academy-id "q-38141" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n- **I.** If $\\text{rank}(T)=2,$ then $\\text{Ker}(T)={0}$\n- **II.** If $[-2,0,0]^{T}$ is a solution of $T(x)=0$ then $\\text{nullity}(T)\\ne 0$\n- **III.** If $T(x)=[1,0,0]^{T}$ has no solution then $\\text{rank}(T)=3$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}$ is a solution of $Tx=0$, we have that $\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}\\in \\text{Ker}(T)$ and therefore $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Since $T(x)=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$ has no solution, we have that $\\text{Im}(T)\\ne {R}^{3}.$ Hence, $\\text{rank}(T)\\ne 3.$\n\nTherefore, the correct option is \"II only.\""} {:db/id #edb/ref 17592186366097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4e29d4-8ab4-51b2-bed7-3d933724288f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469038} {:answer/id #uuid "366b643d-0477-56b8-99e8-05665c95ecc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469039}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469038} :answer-field/id #uuid "aa806480-98e3-5de9-ac37-45bb7e60daee" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470131} {:answer-field/choices [{:answer/id #uuid "0dba33dd-efd6-5edd-8cb4-431f80150830" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469040} {:answer/id #uuid "03dbdbf2-dd97-5434-bd34-a6b20449669a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469041}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469040} :answer-field/id #uuid "bad0d392-5687-58fc-8043-83455bbb6881" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470132} {:answer-field/choices [{:answer/id #uuid "2c5c5fde-9d69-5dd0-bd3e-c686ea921e45" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469042} {:answer/id #uuid "c12380e7-7519-5b6e-8745-f0b879e1df9d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469043}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469042} :answer-field/id #uuid "8e9fc1cb-34d2-5ac7-b925-bd6d7335fddb" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470133}] :question/id #uuid "936f721f-93be-5c51-8233-7da49b500101" :question/math-academy-id "q-38979" :question/problem "Let $T:{R}^{n}\\to {R}^{n}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n- **I.** If $\\text{Ker}(T)={⟨x,y,z⟩\\,|\\,x+y=0}$ then $\\text{rank}(T)+1=n$\n- **II.** If there exists a vector $v\\notin \\text{Im}(T),$ then $|T|\\ne 0$\n- **III.** If ${{v}_{1},{v}_{2}}$ is linearly independent and $T({v}_{1})=T({v}_{2})=0$ then $\\text{nullity}(T)=1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{n}$ into ${R}^{n},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Solving $x+y=0$ for $x,$ we get $x=-y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-y \\\\ y \\\\ z\\end{bmatrix}=y{{\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}+z{{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+2 & =n.\\end{aligned}\n$$\n\n- Statement II is false. If $v\\notin \\text{Im}(T)$ then $\\text{Im}(T)\\ne {R}^{n}$, so, according to the invertible matrix theorem, $T$ is not a bijection. Thus, the matrix $T$ is not invertible, and, consequently, $|T|=0.$\n\n- Statement III is false. Since $T({v}_{1})=T({v}_{2})=0$, then ${v}_{1},{v}_{2}\\in \\text{Ker}(T).$ But the vectors are linearly independent, therefore, the dimension of  $\\text{Ker}(T)$ is at least $2.$\n\nTherefore, the correct answer is \"None of the statements are true.\""} {:db/id #edb/ref 17592186366427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6b563a-739c-5aa6-aa3d-91cf2bda7eee" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469302} {:answer/id #uuid "0ae5e117-a505-5a04-81e4-439b74052c17" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303} :answer-field/id #uuid "0829ea20-3a9e-5bac-9aac-a20a5031708f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470263} {:answer-field/choices [{:answer/id #uuid "86ea0788-dc9f-5b43-b4d9-3e6d92f4a3f3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469304} {:answer/id #uuid "16e976b2-1f3b-5daf-bc6f-ee9f3ff92e50" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305} :answer-field/id #uuid "55766021-6ec3-5fd5-927e-a3d5966052e8" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470264} {:answer-field/choices [{:answer/id #uuid "584ceae8-0e69-5969-b025-a8dfde1e4426" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} {:answer/id #uuid "24a75a78-d9f9-590b-98ed-a75a55f1195e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469307}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} :answer-field/id #uuid "44fe36b7-f90a-541a-a159-56cfdbf08c21" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470265}] :question/id #uuid "3f6a64ec-417d-5f3c-a079-819cbc656ca3" :question/math-academy-id "q-83440" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2}}$ be a set of linearly independent vectors in ${R}^{3}.$ Consider the following statement:\n\n*If  $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$, then $\\text{__________}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{nullity}(T)=2$\n- **II.** $\\text{rank}(T)=1$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$ and the set ${{v}_{1},{v}_{2}}$ is linearly independent, we get that $\\text{nullity}(T)=2.$\n\n- Statement II is true. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 3$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I and II only.\""} {:db/id #edb/ref 17592186366455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f285c5-f28d-52d7-8edb-dc3cd9308f5d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451845} {:answer/id #uuid "de316b3c-8465-5f0f-9e1d-c901b94e2cdb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451846}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451846} :answer-field/id #uuid "0bbe03ec-cd1a-5f9e-bdaa-621344b8730a" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452770} {:answer-field/choices [{:answer/id #uuid "5c2821d1-dbdf-57db-8669-559772eabf32" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451847} {:answer/id #uuid "0c7b316c-fd27-57d7-ae6d-1a8dea1ee57f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451848}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451848} :answer-field/id #uuid "ecdec4e8-476e-5e64-bfe1-002886cf49b8" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452771} {:answer-field/choices [{:answer/id #uuid "2e26320c-f5fc-5d22-962b-bc6fcc8e7c1f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451849} {:answer/id #uuid "fd978c93-8391-56ee-b944-a6b07dbbf21d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451850}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451850} :answer-field/id #uuid "38dc4bf6-46bb-5bfd-8850-b313313b3744" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452772}] :question/id #uuid "c81c0d34-9745-5e75-9229-e0ad0c633344" :question/math-academy-id "q-84063" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,x=0}$ then $\\text{nullity}(T)=1$\n- **II.** If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y-2z=0,x+z=0}$ then $\\text{rank}(T)=2$\n- **III.** If ${v}_{1},$ ${v}_{2},$ and ${v}_{3}$ are the columns of $T$ and ${v}_{3}={v}_{1}-{v}_{2}$, then $\\text{Ker}(T)\\ne {0}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ y \\\\ z\\end{bmatrix}=y{{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}+z{{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is true. Solving $y-2z=0$ for $y,$ we get $y=2z.$ Solving $x+z=0$ for $x,$ we get $x=-z.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-z \\\\ 2z \\\\ z\\end{bmatrix}=z{{\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement III is true. If the columns of $T$ are such that ${v}_{3}={v}_{1}-{v}_{2},$ then the set of vectors ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent and therefore $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Now, according to the matrix invertible theorem, we obtain that $\\text{Ker}(T)\\ne {0}.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186406841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8f9232e-9658-51ed-95f2-ac2fd1e78bf9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454078} {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454079} :answer-field/id #uuid "3fee3505-d7fb-511a-a74e-2a2d44598ed9" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454789} {:answer-field/choices [{:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} {:answer/id #uuid "fa80fb0a-3883-56b5-b6eb-070e8e31d145" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454081}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454080} :answer-field/id #uuid "0d6a4961-38f7-5264-b58e-a39849428f01" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454790} {:answer-field/choices [{:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} {:answer/id #uuid "fbeac619-768a-5b27-a0a3-6f578395c470" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454083}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454082} :answer-field/id #uuid "d0f9063c-3f2e-5e1f-893e-6358b44768be" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454791}] :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b" :question/math-academy-id "q-84081" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$\n- **II.** If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$\n- **III.** If $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}$, then $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $y=z=0,$ any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ 0 \\\\ 0\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is false. Since $Tx=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$ has more than one solution, there are ${u}_{1},{u}_{2}\\in {R}^{3}$ such that  ${u}_{1}\\ne {u}_{2}$ and \n\n$$\nT({u}_{1})=T({u}_{2})=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$\n\nThis means, $T$ is not a bijection and according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Notice that $\\text{Ker}(T)=\\text{Span}{\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}}.$ Therefore, $\\text{nullity}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186406843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec4bc02-0df9-5348-9ee4-473b64cacd02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472718} {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472719} :answer-field/id #uuid "edc239d3-5a4c-5fa5-98b1-768823c16b23" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473754} {:answer-field/choices [{:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} {:answer/id #uuid "fcd1213a-a7a4-5890-88d8-8de888db8343" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472721}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472720} :answer-field/id #uuid "0ff1d1ba-36f4-5b99-8a47-88e5119e65f7" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473755} {:answer-field/choices [{:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} {:answer/id #uuid "01638de6-6ede-5e18-812c-b75ad72b29e8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472723}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472722} :answer-field/id #uuid "dec578f4-3243-5145-b140-1c5ad943604d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473756}] :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72" :question/math-academy-id "q-140100" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$, then $\\text{__________}.$ * \n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{rank}(T)=4$\n- **II.** $\\text{nullity}(T)=4$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=4.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-4 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\""} {:db/id #edb/ref 17592186492858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b54b975-97e0-5630-a090-aee094b6f975" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492343} {:answer/id #uuid "8198ad48-3fde-56ad-875f-2629a469e0c0" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492479} {:answer/id #uuid "9dc05555-6a06-512b-99ec-1c0211b082fd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492525} {:answer/id #uuid "a5c9c60f-e173-5835-8474-cd48d43dde3c" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186492552} {:answer/id #uuid "da447d07-58e2-5574-841d-f2cf464005db" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186492647}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492343} :answer-field/id #uuid "9ef148dd-6753-5ef9-9d57-5a47223ec593" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492767}] :question/id #uuid "52e3deff-a33f-5133-be77-3539d124a1dd" :question/math-academy-id "q-38146" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation with standard matrix $T$ whose columns are ${v}_{1},$\n ${v}_{2},$ and  ${v}_{3}.$\n\n*If  $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=1$, then $\\text{__________}.$ *\n\nWhich of the following, if inserted into the blank space, would lead to a true statement?\n\nI. $\\text{nullity}(T)=2$\n\nII. ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0$ has only the trivial solution\n\nIII. $\\text{rank}(T)=2$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\text{dim}(\\text{span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=1$ this means that $\\text{rank}(T)=1.$ According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\nAlso, according to the invertible matrix theorem the linear transformation $T$ cannot be a bijection.\n\n- Statement II is false. Notice that ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0$ is equivalent to $Tx=0.$ Since $T$ is not invertible, the equation has non-trivial solutions.\n\n- Statement III is false. From statement I, $\\text{rank}(T)=1.$\n\nTherefore, the correct option is \"I only.\""} {:db/id #edb/ref 17592186492918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f245e34-a77e-597f-a14d-caed4ce72982" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492438} {:answer/id #uuid "75c34ea7-fced-573f-ac33-5467b58565b2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492454} {:answer/id #uuid "96f2b9de-077d-5cf3-a270-01b08efe97fe" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186492509} {:answer/id #uuid "af2b2ba4-b180-5b0a-b84d-e9a4e5bcda0b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492567} {:answer/id #uuid "e046b8e1-07f1-59f1-8371-d26dc2d3848e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492653}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186492509} :answer-field/id #uuid "e5c9d97c-c13f-5d1d-806f-0620d8934268" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492803}] :question/id #uuid "e76412ff-223a-5baa-b8c0-73f134709b3d" :question/math-academy-id "q-84061" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nI. $\\text{rank}(T)=\\text{nullity}(T)=3$\n\nII. If $v=[1,0,0]^{T}$ is a solution of $T(x)=0$ then $T$ is invertible.\n\nIII. If there is not $u\\in {R}^{3}$ such that $T(u)=[1,0,0]^{T},$ then $\\text{rank}(T)=3.$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-3 \\\\  & =0 \\\\  & \\ne 3.\\end{aligned}\n$$\n\n- Statement II is false. Since $v$ is a solution of $T(x)=0$, we have that $T(v)=0.$ Therefore $v\\in \\text{Ker}(T),$ thus according to the invertible matrix theorem $T$ is not invertible.\n\n- Statement III is false. Since there is not $u\\in {R}^{3}$ such that $T(u)=[1,0,0]^{T},$ we have that $T$ is not  a bijection (an invertible transformation). According to the invertible matrix theorem, $\\text{rank}(T)\\ne 3.$\n\nTherefore, the correct option is \"None of the statements are true.\""} {:db/id #edb/ref 17592186505754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45611dda-2e80-5e17-ad02-20bf7af10032" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186505244} {:answer/id #uuid "80cebb06-f523-5475-be03-9796f40d9119" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186505362} {:answer/id #uuid "972cf002-819d-58f7-b85f-fbe6af417f69" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186505396} {:answer/id #uuid "bf539e0c-e708-5741-a821-693e7816c138" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186505477} {:answer/id #uuid "d2715267-331a-5a1d-8909-dea7f731f442" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186505509}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186505477} :answer-field/id #uuid "f6e1f623-bd44-5493-8260-283c244d07a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505723}] :question/id #uuid "31c1a37a-969b-5cd4-b27b-164fe43832ff" :question/math-academy-id "q-38110" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nI. If $\\text{Im}(T)=\\{[x,y,z]^{T}\\,:\\,y=z\\}$ then $\\text{nullity}(T)=1$\n\nII. If $Tx=[1,-2,3]^{T}$ has no solution, then $\\text{nullity}(T)=0$\n\nIII. If $\\text{Im}(T)=\\text{Span}\\{[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}],[\\begin{aligned}-3 \\\\ 6 \\\\ -9\\end{aligned}]\\}$, then $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $y=z,$ any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. Since $Tx=[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]$ has no solution, this means that $[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]\\notin \\text{Im}(T).$ Therefore, $\\text{Im}(T)\\ne {R}^{3}$ and, according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Notice that $\\text{Im}(T)=\\text{Span}\\{[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}],[\\begin{aligned}-3 \\\\ 6 \\\\ -9\\end{aligned}]\\}=\\text{Span}\\{[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]\\}.$ Therefore, $\\text{rank}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is \"I only.\""}] :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"} {:db/id #edb/ref 17592186188281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188216 :question/id #uuid "91885df0-9f1d-5c18-acf1-70259cf7f4d9" :question/math-academy-id "e-9987" :question/problem "Find $\\text{nullity}(\\mathbf{T})$ given that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ and $\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, x=y=z\\}.$" :question/worked-solution "Any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ x \\\\ x\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1\\}.$ Therefore, $\\textrm{rank}(\\mathbf{T})=1.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$"} :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/questions [{:db/id #edb/ref 17592186188924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61e472bd-ec33-5a3e-8b54-62a2891a9c10" :answer/type {:db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186366147} {:answer/id #uuid "a5dc371b-1396-5e61-a5b7-e3d432e28bc5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366148} {:answer/id #uuid "eca1d3e3-4905-5d15-ac5c-4cc6e7addee7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366149} {:answer/id #uuid "dc4ff1b0-90ec-51f1-9adc-f5e7ecc391d3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366150} {:answer/id #uuid "f218d39c-ce4c-5b79-8c33-1b7543b0b540" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366151}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366150} :answer-field/id #uuid "319ca848-ea15-555c-8b75-4d09284cc695" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366146}] :question/id #uuid "09a30319-539f-5865-a29f-fd523154b963" :question/math-academy-id "q-47468" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and \n\n$$\n\\text{Im}(T)=\\{[x,y,z]^{T}\\,:\\,-x+z=0\\}.\n$$" :question/worked-solution "Solving $-x+z=0$ for $z,$ we get $z=x.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ x\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{v}_{1}}+y{{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186188982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92c91297-c7c0-5bdc-b9d9-a9a52ae806c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186187969} {:answer/id #uuid "99b215f4-c062-59cc-b003-ea6ef57c1e3e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186187970} {:answer/id #uuid "b7165ef5-c1ee-52e1-97ed-92ea885bd55a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186187971} {:answer/id #uuid "0874d691-cb56-565c-9d14-cf75209b28ad" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186187972} {:answer/id #uuid "22fb8de2-7841-5738-b5c1-945f57d8818f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186187973}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186187971} :answer-field/id #uuid "f7e4fdbb-a7f0-534a-a976-d0c43448ef20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186187968}] :question/id #uuid "f05e62e2-1597-5312-8f1a-20a85ca4f47f" :question/math-academy-id "q-84059" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and \n\n$$\n\\text{Ker}(T)=\\{[x,y,z,w]^{T}\\,:\\,x+y+z=0,\\,2x-y-w=0\\}.\n$$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Solving $2x-y-w=0$ for $w,$ we get $w=2x-y.$  Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ 2x-y \\\\ -x-y\\end{bmatrix}=x{{\\begin{bmatrix}1 \\\\ 0 \\\\ 2 \\\\ -1\\end{bmatrix}}_{⏟}}_{{v}_{1}}+y{{\\begin{bmatrix}0 \\\\ 1 \\\\ -1 \\\\ -1\\end{bmatrix}}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =4-\\text{nullity}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a0bbbf-f8e6-5ff8-a774-523eba137101" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186365089} {:answer/id #uuid "5b688d64-abb8-5a38-8edc-bc94b0118770" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186365090} {:answer/id #uuid "2121fe31-752e-5401-983c-6d4ca2203ae3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186365091} {:answer/id #uuid "da4e7866-c227-5c19-a1e3-e2bf043ecaf6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186365092} {:answer/id #uuid "65f39a3a-d0a4-51c0-9f76-7f9af3dbe0d4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365093}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186365091} :answer-field/id #uuid "21b56c28-66a7-5c9c-958b-62a19e6