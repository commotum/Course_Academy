tants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & -6 \\\\ 3 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fc1c30-8ccd-5457-8993-f07f475f8013" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298415}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186298415} :answer-field/id #uuid "2477b178-6307-5735-b558-7b5c6e62c0a0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298760} {:answer-field/choices [{:answer/id #uuid "0ab496cc-788e-5652-89d7-f96603cd8005" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297607}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297607} :answer-field/id #uuid "63b918f7-22b3-5376-aaa2-00533d549ab7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298973} {:answer-field/choices [{:answer/id #uuid "de44a703-88c3-5e8d-8c8b-9b29522c0607" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298503}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298503} :answer-field/id #uuid "ac49caa6-1aec-575c-9de6-24bb4b87c1ed" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299219} {:answer-field/choices [{:answer/id #uuid "0dd7d52a-dd21-5b39-8a68-a746df7cf693" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186297618}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186297618} :answer-field/id #uuid "fcafb9f8-b362-5db3-8bd7-958e6228521a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299488}] :question/id #uuid "11e074c7-4d99-5668-b58b-9eacc1e24ba9" :question/math-academy-id "q-317506" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}-5x &=10 \\\\ 4y &=-12\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $4$ |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | $10$ |  |\n| --- | --- | --- |\n|  | {{field-4}} |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | {{field-2}} |  |  |  |  |\n|  | {{field-3}} | $4$ |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | $10$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $x$ does not appear in the second equation, which means that its coefficient is $0$ too. \n\nSo, we get\n\n$$\n\\left\\{\\begin{aligned}-5x+0y &=10 \\\\ 0x+4y &=-12\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-5 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -12\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022e6234-3d4c-5534-b14b-8dd9bdb81787" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297569}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297569} :answer-field/id #uuid "0f39389f-6cf5-5175-93ea-d9025fc2b1cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298691} {:answer-field/choices [{:answer/id #uuid "4281dc0a-fa1a-57fe-ba5e-0b198d0f04b9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297821}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297821} :answer-field/id #uuid "3dce52a6-e1fb-505d-861e-fa03455f8a83" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298850} {:answer-field/choices [{:answer/id #uuid "0883bef8-8eee-57db-b571-055f27f66e49" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297595}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297595} :answer-field/id #uuid "8025cb60-b66f-58f5-b1d5-18ece79bb38f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299071} {:answer-field/choices [{:answer/id #uuid "81b901a4-7191-5ebd-8fd0-4d4f97fb1ca3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298110}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298110} :answer-field/id #uuid "ce2a2be0-b727-52ee-be2a-d935cb92e54a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299327}] :question/id #uuid "d45db123-306d-57eb-b5b7-bb39126a8f2b" :question/math-academy-id "q-317517" :question/problem "For the following system of equations\n\n$$\n\\left\\{\\begin{aligned}8y &=-8 \\\\ -4x &=7\\end{aligned}\\right.\n$$\n\nits representation using matrices is\n\n| |  | {{field-1}} | $8$ |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} | {{field-3}} |  | |  |  |  | |  | $x$ |  |\n| --- | --- | --- |\n|  | $y$ |  | | $=$ | |  | {{field-4}} |  |\n| --- | --- | --- |\n|  | $7$ |  | |\n| --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-1}} | $8$ |  |  |  |  |\n|  | {{field-2}} | {{field-3}} |  |  |  |  |\n|  | $x$ |  |  |  |  |  |\n|  | $y$ |  |  |  |  |  |\n|  | {{field-4}} |  |  |  |  |  |\n|  | $7$ |  |  |  |  |  |\n\n." :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation.\n\nThe variable $x$ does not appear in the first equation, but this just means its coefficient is $0.$ Similarly, the variable $y$ does not appear in the second equation, which means that its coefficient is $0$ too. So, we get\n\n$$\n\\left\\{\\begin{aligned}0x+8y &=-8 \\\\ -4x+0y &=7\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}0 & 8 \\\\ -4 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-8 \\\\ 7\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}0 & 8 \\\\ -4 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ 7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186338990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13874c69-ce11-5c4a-b0db-84ef83ade9dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}7 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186336218} {:answer/id #uuid "5e1b6947-b6e0-5826-8441-dbb3d0b931fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatri