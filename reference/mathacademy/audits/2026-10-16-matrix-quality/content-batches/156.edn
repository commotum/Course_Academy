db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186391961} {:answer/id #uuid "57d7afe0-ca6f-57d3-a2e3-906ad22f4aea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186391962} {:answer/id #uuid "37bb6378-9f91-5ead-9cda-c102778d5f22" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ -1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186391963} {:answer/id #uuid "9580bf69-88fc-535e-8e59-7eee0bdecc7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 4 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186391964}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186391961} :answer-field/id #uuid "1e7b743d-c43a-510a-a794-32f1c29c8d88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391959}] :question/id #uuid "2594c879-7fd1-5b85-9df5-7ae761ff92cb" :question/math-academy-id "q-36302" :question/problem "If $C=\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}$, then ${C}^{3}=$" :question/worked-solution "First, we compute ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nNotice that ${C}^{2}=C,$ so $C$ is an idempotent matrix.\n\nWe can use this fact to compute ${C}^{3}$ quickly, as follows:\n\n$$\n\\begin{aligned}{C}^{3} & ={C}^{2}\\cdot C \\\\  & =C\\cdot C \\\\  & ={C}^{2} \\\\  & =C\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{C}^{3}=\\begin{bmatrix}0 & 0 & 2 \\\\ 3 & 1 & -6 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186393912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0b2a5a8-67e7-5639-9d41-6b6082af0189" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393914} {:answer/id #uuid "6cf33cc7-55a2-56b0-9243-826fe4617b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -6 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186393915} {:answer/id #uuid "b56078f5-e9a2-54d5-b4dc-d6536dec2e4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393916} {:answer/id #uuid "6198d7ae-e34d-53ed-983e-2b4492d3825c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393917} {:answer/id #uuid "90b66a89-a532-5756-b976-d72f2602a6b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -6 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186393918}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393916} :answer-field/id #uuid "12ef64bb-d65e-5cfd-b87f-976d076e6e82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393913}] :question/id #uuid "f92da47c-e719-5f4d-aa7e-be4e5edae187" :question/math-academy-id "q-78577" :question/problem "If $Z=\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}$, then ${Z}^{5}=$" :question/worked-solution "First, we compute ${Z}^{2}$ as follows:\n\n$$\n\\begin{aligned}{Z}^{2} & =Z\\cdot Z \\\\  & =\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix} \\\\  & =Z\\end{aligned}\n$$\n\nNotice that ${Z}^{2}=Z,$ so $Z$ is an idempotent matrix. \n\nWe can use this fact to compute ${Z}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{Z}^{5} & ={Z}^{2}\\cdot {Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z\\cdot Z \\\\  & ={Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z \\\\  & ={Z}^{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Z}^{5}=\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186421545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8fc809-c7c8-51da-97a9-cd29d45be4a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 9 \\\\ -4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186421534} {:answer/id #uuid "35223ea7-957d-558a-abed-700d6db7d746" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186421535} {:answer/id #uuid "3f394fb3-e71c-5ca8-9f2c-6be2526c01f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -3 \\\\ 2 & 2\\end{bmatrix}" :db/id #edb/ref 17592186421536} {:answer/id #uuid "60dea114-5917-5702-91f4-2d9dcc51d500" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186421537} {:answer/id #uuid "d7328dc6-408b-5e04-a91b-4f561c57f94a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186421542}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186421535} :answer-field/id #uuid "fd431940-6ae8-53c2-934a-5aaba85bb3f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421544}] :question/id #uuid "e78f486a-816c-52d1-9895-59ae0c720ab7" :question/math-academy-id "q-130635" :question/problem "If $B=\\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix}$, then ${B}^{5}=$" :question/worked-solution "First, we compute ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 1 \\\\ -6 & 3\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nNotice that ${B}^{2}=B,$ so $B$ is an idempotent matrix. \n\nWe can use this fact to compute ${B}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{B}^{5} & ={B}^{2}\\cdot {B}^{2}\\cdot B \\\\  & =B\\cdot B\\cdot B \\\\  & ={B}^{2}\\cdot B \\\\  & =B\\cdot B \\\\  & ={B}^{2} \\\\  & =B\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{B}^{5}=\\begin{bmatrix}3 & 3 \\\\ -2 & -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186440932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02156f42-01b9-5208-be76-46dd56d1f051" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ -2 & 0 & -3 \\\\ 4 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186440906} {:answer/id #uuid "6988567e-c6b3-5730-a2d4-b0c476a8c21a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186440912} {:answer/id #uuid "79b811ba-d237-5358-9a7b-e5099ee68347" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440913} {:answer/id #uuid "c40a1344-3c43-5a5d-97e2-770817ab45f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 6 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440921} {:answer/id #uuid "fb87aec8-67bb-5868-9fd5-615026521a6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ 4 & 0 & 6 \\\\ -2 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440925}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440913} :answer-field/id #uuid "e2b3e7c5-52c2-5e4b-bcbf-08cf2d113f06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440928}] :question/id #uuid "de50db69-1f49-5b62-bb8f-7cba652094a4" :question/math-academy-id "q-130663" :question/problem "If $A=\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}$, then ${A}^{4}=$" :question/worked-solution "First, we compute ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix} \\\\  & =A\\end{aligned}\n$$\n\nNotice that ${A}^{2}=A,$ so $A$ is an idempotent matrix. \n\nWe can use this fact to compute ${A}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =A\\cdot A \\\\  & ={A}^{2} \\\\  & =A\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{A}^{4}=\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}.\n$$"}] :knowledge-point/title "Finding a Power of an Idempotent Matrix"}] :topic/math-academy-id 3776 :topic/title "Nilpotent and Idempotent Matrices"}]}
