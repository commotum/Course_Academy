 1 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}7 \\\\ -3\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}2 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}7 \\\\ -3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186338992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092149d4-4746-597d-b469-fd9e124145a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 5 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186336110} {:answer/id #uuid "0a6aba9a-03cf-5963-9982-db4dd212466f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 5 \\\\ 5 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186336129} {:answer/id #uuid "734fe104-fc87-5937-ab79-b8a96359e482" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 5 \\\\ 5 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186337072} {:answer/id #uuid "d0c39530-814f-58b1-87ba-a2ce667a5978" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 5 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}15 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186337859} {:answer/id #uuid "ff0d859f-843c-5762-8a71-9acb0d107736" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -2 & 5\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}15 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186338271}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 5 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}" :db/id #edb/ref 17592186336110} :answer-field/id #uuid "77ca8a8e-7cde-5776-a055-3d15385c87dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338486}] :question/id #uuid "6fb63d0f-068a-51bd-a44a-a1afcc574af8" :question/math-academy-id "q-71804" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}-2x+5y &=-1 \\\\ 5x &=15\\end{aligned}\\right.\n$$" :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. \nThe variable $y$ does not appear in the second equation, but this just means its coefficient is $0.$ So, we get\n\n$$\n\\left\\{\\begin{aligned}-2x+5y &=-1 \\\\ 5x+0y &=15\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}-2 & 5 \\\\ 5 & 0\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}-2 & 5 \\\\ 5 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 15\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186354631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54be5f09-3b58-5930-bdc7-ccdb2f67d6da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 1 \\\\ 4 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186352318} {:answer/id #uuid "6ca99045-dd33-5f43-a7c8-c5f10727365c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 1 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186352525} {:answer/id #uuid "8711bd28-d757-5733-8d8e-74aa8e1eeb4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 1 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186352748} {:answer/id #uuid "87cd6a64-8926-5898-b3a1-08617a82941b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ -8 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186352758} {:answer/id #uuid "dfede72a-5a0f-52ab-9653-3586280ead39" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 6 \\\\ 1 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186353513}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 1 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186352748} :answer-field/id #uuid "27886f52-60bd-58ac-8062-d0a079292caa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353878}] :question/id #uuid "302f133a-6090-5037-99fd-6973d6637f17" :question/math-academy-id "q-8820" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}6x+4y &=1 \\\\ x-8y &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "First, notice that both $x$ and $y$ appear in each equation, all the variables are on the left-hand side, and all the constants are on the right-hand side.\n\n$$\n\\left\\{\\begin{aligned}6x+4y &=1 \\\\ x-8y &=-2\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}6 & 4 \\\\ 1 & -8\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}6 & 4 \\\\ 1 & -8\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}.\n$$"}] :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product"} {:db/id #edb/ref 17592186115232 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115063 :question/id #uuid "359f4b72-60d2-54e2-b7ef-c48f1e3af708" :question/math-academy-id "e-4506" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\left\\{\\begin{aligned}-5y &=-3x \\\\ 6+x &=-2+y\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order:\n\n$$\n\\left\\{\\begin{aligned}3x-5y &=0 \\\\ x-y &=-8.\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $A\\mathbf{x} = \\mathbf{b},$ where\n\n![](images/64/648952bc6e093c08ff29215fce21fe115ab81e9fc3d8b423772123eae31237f3.png)\n\nis the coefficient matrix,\n\n![](images/c1/c1f203be0770c298d9c2c75ccfbfb30354cb314ed75c8b05f6639e5633ca7442.png)\n\nis the column vector of constants, and\n\n![](images/aa/aa4de061ca95088763e7e5fec289dbd2e5bd298e8986ef6660617ea0ba227821.png)\n\nis the column vector of variables.\n\nSo, the equation $A\\mathbf{x} = \\mathbf{b}$ becomes\n\n![](images/75/75aed8c54a2ec274def967802cbd3b67d0fad3358e676b02cf52e1e8d2cbe0d7.png)"} :knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17" :knowledge-point/questions [{:db/id #edb/ref 17592186115732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886f8fb4-19fc-5428-98a2-3522bdf57b90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186113359} {:answer/id #uuid "8eada92f-7290-511c-ac0d-3699fca3e681" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113360} {:answer/id #uuid "d0829c08-ca54-56ee-9dd0-dbacc0ce6e49" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186113361} {:answer/id #uuid "ec2b98e9-54be-57be-a5be-e6bbcb0f4cf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186113362} {:answer/id #uuid "5c7d2242-a652-5592-a077-e9c3a917780a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 1 & 9\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186113363}] :answer-field/id #uuid "db161969-3909-540d-9bda-f153f7134ab2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113358}] :question/id #uuid "0468eabf-1364-5afc-8b00-c2d28bd74d7f" :question/math-academy-id "q-31874" :question/problem "Represent the following system of equations using matrices:\n${y + 3x - 8 = 2; y + 9 = 5$"} {:db/id #edb/ref 17592186115977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb33624c-6be3-586c-9f4c-c074a27c7f0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & -1 \\\\ 2 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186114800} {:answer/id #uuid "09835377-925f-53b0-8db2-15c8f9035baf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7 & 2 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmat