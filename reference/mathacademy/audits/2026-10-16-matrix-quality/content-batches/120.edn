9758ea334af7.png)"} {:db/id #edb/ref 17592186362717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b99cf61-4188-5177-9243-e43b4bd470a1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468894} {:answer/id #uuid "52f8e72f-d7a5-57c3-963c-58d1ae177c03" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468895}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468894} :answer-field/id #uuid "9d934aee-1837-5fd6-b7e9-31803fca2c1a" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470059} {:answer-field/choices [{:answer/id #uuid "61cd6959-f3ae-5281-a702-a6f1fbb4b347" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468896} {:answer/id #uuid "c766b5e4-f8e9-5807-a6a9-6eea349022f0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468897}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468896} :answer-field/id #uuid "e560755c-de37-53f3-abf3-cf0ebd912b36" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470060} {:answer-field/choices [{:answer/id #uuid "9c64afc9-c9f8-5334-bf63-252b9c9011c5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468898} {:answer/id #uuid "540b90b9-15b3-5bc0-9d0c-5195e70e08e2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468899}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468899} :answer-field/id #uuid "feb95007-7157-56ac-b69d-8e8b3627d71d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470061}] :question/id #uuid "90aa20cc-7bd4-5b9c-