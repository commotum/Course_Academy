2fcb-d82d-5111-a699-5798822a8e76" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186398085} {:answer/id #uuid "3cf49b0b-ca8d-5df2-944e-152ab812be35" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186398086} {:answer/id #uuid "75145a95-95a2-5300-a3b1-4c2ffbe7d0e2" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x" :db/id #edb/ref 17592186398087}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x" :db/id #edb/ref 17592186398084} :answer-field/id #uuid "39de4ad4-8ca2-5e4e-a502-b05807674875" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398082}] :question/id #uuid "96dc0ffa-c035-5c4a-b42f-7a4928dfb8df" :question/math-academy-id "q-111789" :question/problem "Let\n$T=\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(2,-1),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{-1-0}{2-0}=-\\frac{1}{2}.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-\\frac{1}{2}x.$"} {:db/id #edb/ref 17592186399309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dd28d78-6826-51c4-bb97-c5994d734c67" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186399311} {:answer/id #uuid "0899c6c5-3e81-55cb-a780-9e9332201c4b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186399312} {:answer/id #uuid "10fc3ece-7797-5f53-8829-a11ecea3780a" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186399313} {:answer/id #uuid "9292a981-b609-5970-917e-547c35bcf2a8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186399314} {:answer/id #uuid "a6982ec5-f770-5406-8115-0f127674fbbb" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x" :db/id #edb/ref 17592186399315}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186399314} :answer-field/id #uuid "29f8391a-382e-52ac-9e3b-9db6b56f6633" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399310}] :question/id #uuid "fdcf8d93-f073-5ef6-b0fa-29dd34699bc5" :question/math-academy-id "q-97071" :question/problem "Let\n$T=\\begin{bmatrix}6 & 9 \\\\ 2 & 3\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(6,2)$ and $(9,3),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-2}{9-6}=\\frac{1}{3}.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=\\frac{1}{3}x.$"} {:db/id #edb/ref 17592186492827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b324769-9430-5f5c-80c0-9c13d075c858" :answer/type {:db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186492307} {:answer/id #uuid "4ca6c8b6-2f80-5c70-9069-f0586e112d1a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186492366} {:answer/id #uuid "88430c53-2ff5-5c57-bc6b-a66b7136b41c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186492487} {:answer/id #uuid "a0602523-5644-52d8-bb00-13c7914d03e9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186492537} {:answer/id #uuid "a8cca849-8dd3-5d33-8394-2e0d4cedf5ad" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186492559}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186492559} :answer-field/id #uuid "fe0672c6-a8a1-54ee-b67e-0f22d1bf3419" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492818}] :question/id #uuid "0ea7759f-f796-5f54-9f1a-8b557e8042a4" :question/math-academy-id "q-111788" :question/problem "Let\n$T=\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(1,3),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-0}{1-0}=3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=3x.$"} {:db/id #edb/ref 17592186492832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c01bddf-505a-542a-9412-fb0c27435749" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186492311} {:answer/id #uuid "40b8ac61-afc4-560b-8da5-9b5b28a20dc4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186492350} {:answer/id #uuid "47eebad0-cd40-5fde-9742-d083f03326fc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186492360} {:answer/id #uuid "9f8e000b-f0fd-595a-9369-252eec48837d" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x" :db/id #edb/ref 17592186492533} {:answer/id #uuid "c46cf5d3-873d-529b-8f60-aafbf3020809" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186492608}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186492311} :answer-field/id #uuid "ca172406-8acb-556c-ac95-a056ce4c8607" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492786}] :question/id #uuid "18ff2792-817e-5c06-978e-de39e8bf5d7d" :question/math-academy-id "q-97072" :question/problem "Let\n$T=\\begin{bmatrix}1 & 4 \\\\ 2 & 8\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(1,2)$ and $(4,8),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{8-2}{4-1}=2.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=2x.$"} {:db/id #edb/ref 17592186564499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dd0d15c-be74-50b4-a48c-b8617532b07b" :answer/type {:db/ident :answer.type/math} :answer/value "y={R}^{2}" :db/id #edb/ref 17592186564007} {:answer/id #uuid "620a4056-288f-5313-ad88-b1b0f5b5687b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186564122} {:answer/id #uuid "63ce0689-59e9-51d3-8840-c15ea78dfa8f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x" :db/id #edb/ref 17592186564125} {:answer/id #uuid "a12b6a7f-7604-5711-86fc-b635e4b043ba" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186564213} {:answer/id #uuid "aee37cb9-5834-51b9-a3fe-6104df070ec9" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3x" :db/id #edb/ref 17592186564238}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "y=-3x" :db/id #edb/ref 17592186564238} :answer-field/id #uuid "bfa28e82-e7a7-5631-a9aa-0b573881c151" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564436}] :question/id #uuid "7d1c2efa-cbed-55e3-967d-daf6bf46e742" :question/math-academy-id "q-97069" :question/problem "Let\n$T=[\\begin{aligned}2 & -1 \\\\ -6 & 3\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(2,-6)$ and $(-1,3),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-(-6)}{-1-2}=-3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-3x.$"}] :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"} {:db/id #edb/ref 17592186176089 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175721 :question/id #uuid "dd98751e-7fbd-5afa-b7ad-725ec479c996" :question/math-academy-id "e-13334" :question/problem "Consider a linear transformation $\\mathbf{T}$ that maps $\\mathbb{R}^2$ onto the line $y=-5x.$ Which of the following statements are true?\n\nI. $\\langle -1, 5 \\rangle \\in \\text{Im}(\\mathbf{T})$\n\nII. $\\textrm{Ker}(\\mathbf{T})=\\{0\\}$\n\nIII. $\\textrm{Im}(\\mathbf{T})=\\Bbb R^2$" :question/worked-solution "Recall that when the image of a linear transformation $\\mathbf{T}$ in $\\mathbb{R}^2$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\textrm{rank}(T) = \\textrm{rank}(\\mathbf{T}) = 1,\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, the point $(-1,5)$ satisfies the equation of the line $y=-5x$ since $5=-5\\cdot (-1).$ Hence, \n\n$$\n\\langle -1, 5 \\rangle \\in \\textrm{Im}(\\mathbf{T}).\n$$\n\n- Statement II is false. Since $\\textrm{nullity}(T)=1,$ we get \n\n$$\n\\textrm{Ker}(\\mathbf{T}) \\neq \\{\\mathbf0\\}.\n$$\n\n- Statement III is false.  Since $\\textrm{rank}(\\mathbf{T})=1,$ we get \n\n$$\n\\textrm{Im}(\\mathbf{T}) \\neq \\Bbb R^2.\n$$\n\nTherefore, the correct answer is \"I only.\""} :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/questions [{:db/id #edb/ref 17592186176273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874ac1f7-0153-507d-91ce-fd04d90ca247" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186173897} {:answer/id #uuid "02f0558b-35a2-5e4d-a4f1-1d0d49844653" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186173898} {:answer/id #uuid "04310fd5-0111-5f80-b616-19512cf451da" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186173899} {:answer/id #uuid "061f9b11-0217-5760-abc1-a8399b5515c7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186173900} {:answer/id #uuid "45945036-7b0c-58a7-8eb0-c915cb38566e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186173901}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186173900} :answer-field/id #uuid "55c9a14f-7b63-589d-a835-3fb38b9d252c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173896}] :question/id #uuid "86bc6bae-46fe-5b21-aa49-70bad1578afa" :question/math-academy-id "q-111791" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nI. $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$\n\nII. $\\text{rank}(T)=0$\n\nIII. $\\text{Ker}(T)=\\{0\\}$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\n- Statement II is false. We have that\n\n$$\n\\text{rank}(T)=2.\n$$\n\n- Statement III is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to\n\n$$\n\\text{Ker}(T)=\\{0\\}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186176476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec8c126b-beb0-5259-95a8-ee03317b9dbc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477289} {:answer/id #uuid "05b4a708-dd67-557a-9e5d-3cec0dfaf56e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477290}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477289} :answer-field/id #uuid "6e9fdd20-93bb-54d2-8f45-dd434f374b95" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477614} {:answer-field/choices [{:answer/id #uuid "2ca155e7-6b82-5264-aff3-a5b9bbf22322" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477291} {:answer/id #uuid "d241b648-c419-53a1-bd11-5a4510ba9eba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477292}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477291} :answer-field/id #uuid "8474779a-6aa5-57d6-8c8a-638b08fec6e2" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477615} {:answer-field/choices [{:answer/id #uuid "85d7e293-6acb-57a3-84e4-89d7e0daf5c3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477293} {:answer/id #uuid "c9be56df-604d-5bf1-b89a-a5381de8206d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477294}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477294} :answer-field/id #uuid "6637f2a2-acef-52c2-99ff-897ed538dbfe" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477616}] :question/id #uuid "4acbb26f-7e4b-53ce-a37d-bd74763516c8" :question/math-academy-id "q-38297" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ to the origin. Which of the following statements are true?\n- **I.** $\\text{rank}(T)=1$,  where $T$ is the standard matrix of $T$\n- **II.** $\\text{Im}(T)$ contains no vectors of ${R}^{2}$\n- **III.** $\\text{Ker}(T)={R}^{2}$\n\nSelect all that apply." :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is the zero-subspace ${0},$ then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=0\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. In our case, we have \n\n$$\n\\text{rank}(T)=0.\n$$\n\n- Statement II is false. The image of $T$ contains the vector zero vector $0=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.$\n\n- Statement III is true. Indeed, the condition $\\text{nullity}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={R}^{2}.\n$$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186360751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dbfc974-64a1-5ba8-a98a-3c44ced3256a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452317} {:answer/id #uuid "4692bc9a-0874-5399-a418-98fb85a5cec3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452318}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452317} :answer-field/id #uuid "29e47d84-f057-5e0a-ae70-ec0d33904e89" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453006} {:answer-field/choices [{:answer/id #uuid "420fa2b5-f5a7-5d27-bc3d-9bbf0b0cd31b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452319} {:answer/id #uuid "27f8b042-1a66-5c50-9a92-c6c664837fbf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452320}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452320} :answer-field/id #uuid "75e76e66-d34f-5c65-9093-a22e5839e130" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453007} {:answer-field/choices [{:answer/id #uuid "a7d6839f-b647-50f5-9788-3ee7b2fa1f1f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452321} {:answer/id #uuid "7b4185c8-8f28-5d02-aeb6-193573874b18" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452322}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452321} :answer-field/id #uuid "883ab182-da38-5ef9-bdd1-6c14d39cea71" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453008}] :question/id #uuid "2667e6b9-8784-550d-a849-0ee298d78d90" :question/math-academy-id "q-97078" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto  ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{Im}(T)={0}$\n- **II.** $\\text{Ker}(T)={0}$\n- **III.** $\\text{nullity}(T)=1$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to\n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\n- Statement II is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186366052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d07d408-4bd4-52a2-b369-1432edfe2c77" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} {:answer/id #uuid "eaeb8c45-a223-54ca-b996-e4cc9a54fe8c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469021}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} :answer-field/id #uuid "246b7ed5-a7fd-53be-80d4-b0d726f0fda5" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470122} {:answer-field/choices [{:answer/id #uuid "4f53549c-840d-53f3-bf45-f0d90bcc6ab3" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469022} {:answer/id #uuid "215f631a-fd6a-5cc0-906f-13e0a5fbd25e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023} :answer-field/id #uuid "8a6bf326-d27f-5130-ad2f-4b066b4f2754" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470123} {:answer-field/choices [{:answer/id #uuid "5bb3b5e2-0da0-57b0-a807-697b0aeddec8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} {:answer/id #uuid "a8fd395f-d3c4-53ed-b990-698626ffd03e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469025}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} :answer-field/id #uuid "435f823d-9228-557b-a231-fc7e35bab06c" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470124}] :question/id #uuid "34581764-4087-5b06-9eff-4679fe703405" :question/math-academy-id "q-38300" :question/problem "If the linear transformation $T$ maps ${R}^{2}$ onto the line $y=-3x$ then, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨1,3⟩$ belongs to the range of $T$\n\n- **II.** $\\text{Ker}(T)\\ne {0}$\n\n- **III.** $\\text{Im}(T)={0}$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement I is false. \nNotice that the point $(1,3)$ does not satisfy the equation of the line $y=-3x$ since $3\\ne -3\\cdot 1.$ Therefore, the vector $⟨1,3⟩\\notin \\text{Im}(T).$\n\n- Statement II is true. Indeed, \nsince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. Hence, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. \nFor example,  the point $(1,-3)$ satisfies the equation  $y=-3x$ since $-3=-3\\cdot 1.$ Therefore, the vector $⟨1,-3⟩\\in \\text{Im}(T).$ Thus, $\\text{Im}(T)\\ne {0}.$"} {:db/id #edb/ref 17592186366059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf5d61a3-731b-5ca2-a21d-a258c3b1767d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469026} {:answer/id #uuid "83d5e69a-fb13-5cb4-8279-35f40cd14786" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469027}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469026} :answer-field/id #uuid "ad7fbb88-7ce0-52f3-bfca-0238dcd3a81c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470125} {:answer-field/choices [{:answer/id #uuid "94b0ff15-d102-5f1d-af4e-e362a8a9b9a9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469028} {:answer/id #uuid "c0529496-06cf-5552-ac7c-13815e3edd61" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469029}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469029} :answer-field/id #uuid "990ff885-053e-5892-a630-17d9382e4120" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470126} {:answer-field/choices [{:answer/id #uuid "e46a229c-3d63-5185-b98f-3bcb74c8a528" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469030} {:answer/id #uuid "c12af7cf-9477-5a53-a812-9a97f8176c74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469031}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469030} :answer-field/id #uuid "4bce9e44-27f0-518d-ad2a-de5a2a028195" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470127}] :question/id #uuid "07bd3910-da00-5269-ba42-c4e894fc0a77" :question/math-academy-id "q-38305" :question/problem "If the linear transformation $T$ maps ${R}^{2}$ onto the line $5y=6x$ then, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨\\frac{6}{5},1⟩\\in \\text{Im}(T)$\n\n- **II.** $\\text{Ker}(T)\\ne {0}$\n\n- **III.** $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement I is false.\nNotice that the point $(\\frac{6}{5},1)$ does not satisfy the equation of the line $5y=6x$ since $5\\cdot 1\\ne \\frac{6}{5}\\cdot 6.$ Therefore, \n$⟨\\frac{6}{5},1⟩\\notin \\text{Im}(T).$\n\n- Statement II is true.\nSince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. So, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false.\nSince  statement II is true we have that $\\text{nullity}(T)=\\text{dim(Ker}(T))\\ne 0.$"} {:db/id #edb/ref 17592186366773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9099ef15-a1bf-5b8d-b674-d360c6aadda0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452311} {:answer/id #uuid "8e1abad4-8933-51f0-817c-845930bc0ec6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452312}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452312} :answer-field/id #uuid "c524b1b4-bbda-5e7e-890d-f074894a05f4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453003} {:answer-field/choices [{:answer/id #uuid "9ddf10a9-2422-536a-afd4-fa994f101802" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452313} {:answer/id #uuid "245d7eb5-f7c7-52bc-aee9-07abe4358c15" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452314}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452314} :answer-field/id #uuid "c2341323-e8a8-593f-ac40-f2d6042f60fe" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453004} {:answer-field/choices [{:answer/id #uuid "0f1a969b-4d20-56b8-a302-390ca21fb96c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452315} {:answer/id #uuid "38ab8235-cad9-5536-9cf5-1a513f15a9d1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452316}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452315} :answer-field/id #uuid "57938303-0bc4-5294-929a-a9e479e34260" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453005}] :question/id #uuid "cbb0c470-3f82-5cd2-8de9-680715504460" :question/math-academy-id "q-97077" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto  ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨-1,0⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)={0}$\n- **III.** $\\text{nullity}(T)=2$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\nHence, $T$ is surjective and so  $⟨-1,0⟩\\in \\text{Im}(T).$\n\n- Statement II is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186366780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12eb12db-c865-5a15-995f-57d1e99856b4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} {:answer/id #uuid "fa2992f7-296f-52e8-8e2f-b1875fa14a31" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452324}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} :answer-field/id #uuid "12ebab7b-febe-5850-8be3-97869ab43f9b" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453009} {:answer-field/choices [{:answer/id #uuid "dff232c6-f90e-549a-bf5d-1544c0d7eb35" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452325} {:answer/id #uuid "cc22eb64-3d36-5f56-935a-3d6d0d508e49" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326} :answer-field/id #uuid "9583cd23-de18-5d81-9215-33038a6df612" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453010} {:answer-field/choices [{:answer/id #uuid "d092dba5-3f4c-5126-93c1-b72bf8d37079" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} {:answer/id #uuid "3d4acc6c-2043-51df-a00b-c80988412bef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452328}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} :answer-field/id #uuid "5957978d-2e1f-5607-8d63-c7b81149356e" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453011}] :question/id #uuid "2335439b-17b4-5a3d-b1ce-91063205bf0d" :question/math-academy-id "q-97079" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto the line $y=2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨2,1⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=2$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1,\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. The point $(2,1)$ does not satisfy the equation of the line $y=2x$ since $1\\ne 2\\cdot 2.$ Hence, \n\n$$\n⟨2,1⟩\\notin \\text{Im}(T).\n$$\n\n- Statement II is true. Since $\\text{nullity}(T)=1,$ we get \n\n$$\n\\text{Ker}(T)\\ne {0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=1.\n$$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186380615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48355326-ad4b-578d-906e-404260be62dd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453288} {:answer/id #uuid "137c30dc-eac8-5144-aa6e-ecac88c88768" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289} :answer-field/id #uuid "029df452-27e1-55c2-95cc-c51c4094c660" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454394} {:answer-field/choices [{:answer/id #uuid "c79a7166-446d-5b5a-a95f-e732499d72f4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} {:answer/id #uuid "1d2b1e1d-e940-5f7a-a610-b38db6adeb6f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453291}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} :answer-field/id #uuid "e492fc36-ff9b-5ce9-b63f-47f732639a39" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454395} {:answer-field/choices [{:answer/id #uuid "3f22ea7c-9234-582e-9fd8-6c4d53049067" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453292} {:answer/id #uuid "5ae5ae4c-d9b5-5c1e-8df4-fc71fc9b7598" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293} :answer-field/id #uuid "21f48fb4-a9ca-5657-b58f-f9b05523a3e0" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454396}] :question/id #uuid "6d9c3015-ea78-542d-9de3-a1c266f8369d" :question/math-academy-id "q-111793" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨1,1⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\nHence, $T$ is surjective and so  $⟨1,1⟩\\in \\text{Im}(T).$\n\n- Statement II is false. The condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement III is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186382648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48d21b03-b4aa-5edf-97d9-e8d82ba76aa6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454250} {:answer/id #uuid "a4df005b-76b4-5349-9381-8a02c4118a9c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454251}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454250} :answer-field/id #uuid "1e0c8fb9-1191-5fbe-89aa-082fed4cfe5c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454875} {:answer-field/choices [{:answer/id #uuid "46db31c3-b479-5b1f-9f99-dea7a4e5f9d5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454252} {:answer/id #uuid "6adfd406-7a7b-520c-b675-6259bd0b2894" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454253}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454252} :answer-field/id #uuid "61692f77-337b-53e8-9104-052d1bee29b9" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454876} {:answer-field/choices [{:answer/id #uuid "5bf8b14e-2ea8-5937-a61f-4fbf1ad7451e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454254} {:answer/id #uuid "3f5d6c2c-7493-5064-bdb2-fd8b5146ef90" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454255}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454255} :answer-field/id #uuid "5cfa9f97-b5ce-506a-a8e7-d728d9426d04" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454877}] :question/id #uuid "5aa9ee11-e88d-5123-8f62-331a18227a4a" :question/math-academy-id "q-97075" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ to the origin. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{nullity}(T)=0$\n- **II.** $\\text{Ker}(T)={0}$\n- **III.** $\\text{rank}(T)=0$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is the zero-subspace ${0},$ then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=0\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. We have that\n\n$$\n\\text{nullity}(T)=2.\n$$\n\n- Statement II is false. The condition $\\text{nullity}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={R}^{2}.\n$$\n\n- Statement III is true. Indeed, we have\n\n$$\n\\text{rank}(T)=0.\n$$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186382655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "666fa542-cf57-5c1b-8235-fd0e152853d6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454256} {:answer/id #uuid "011063c3-9666-5b11-8325-d5a53f0ca7c9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454257}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454257} :answer-field/id #uuid "251c5103-04e9-5f82-9799-dce064a89e0b" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454878} {:answer-field/choices [{:answer/id #uuid "859bf573-b364-5fe7-906a-1889b6b49ad6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454258} {:answer/id #uuid "ef7f0115-a5c9-53d6-a054-0f8b8da7d2d8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454259}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454258} :answer-field/id #uuid "7fba21ba-604e-5a02-b4e4-86f7b393c68e" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454879} {:answer-field/choices [{:answer/id #uuid "737fb959-5d8a-5e06-a11d-18a5e40324a1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454260} {:answer/id #uuid "afff2fb7-4c9e-5490-b6a1-72764933cd02" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454261}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454260} :answer-field/id #uuid "d766cf66-eb67-509f-bfcf-670ca1d9a88f" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454880}] :question/id #uuid "f9ccb581-9372-57d1-992f-f285342045f0" :question/math-academy-id "q-97080" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto the line $y=-2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨-1,2⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)={R}^{2}$\n- **III.** $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1,\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, the point $(-1,2)$ satisfies the equation of the line $y=-2x$ since $2=-2\\cdot (-1).$ Hence, \n\n$$\n⟨-1,2⟩\\in \\text{Im}(T).\n$$\n\n- Statement II is false. Since $\\text{nullity}(T)=1,$ we get \n\n$$\n\\text{Ker}(T)\\ne {R}^{2}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=1.\n$$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186492866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10db60f2-620a-5b8c-8ce4-8400f4bceb9a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186492246} {:answer/id #uuid "7da15e7c-1166-51c6-897a-9f8a3708487a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492470} {:answer/id #uuid "9c68103e-c97a-5610-b9f4-d1051647b15f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492521} {:answer/id #uuid "cd93118a-b15b-5093-91cb-5221765965a6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186492624} {:answer/id #uuid "ef414556-5a7d-50d4-9453-5c30d34e1bcd" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186492680}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492521} :answer-field/id #uuid "1a506a0a-a4f1-5314-a81c-bab95d6f2544" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492713}] :question/id #uuid "63cc3457-67ea-5db0-a46f-35ae7d0b8b95" :question/math-academy-id "q-97076" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ to the origin. Which of the following statements are true?\n\nI. $\\text{rank}(T)=2$\n\nII. $\\text{Ker}(T)={R}^{2}$\n\nIII. $\\text{Im}(T)$ contains no vectors of ${R}^{2}$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is the zero-subspace $\\{0\\},$ then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=0\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. We have that \n\n$$\n\\text{rank}(T)=0\n$$\n\n- Statement II is true. Indeed, the condition $\\text{nullity}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={R}^{2}.\n$$\n\n- Statement III is false. The image of $T$ contains the zero vector $0=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.$\n\nTherefore, the correct answer is \"II only.\""}] :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :topic/math-academy-id 3645 :topic/title "The Image of a Linear Transformation in the Cartesian Plane"}] [{:activity/_scope [{:activity/first-step {:db/id #edb/ref 17592186125397} :activity/id #uuid "b2027039-9734-5db5-aca4-967ce9b8912e" :activity/steps [{:db/id #edb/ref 17592186125397 :step/content {:db/id #edb/ref 17592186125782 :tutorial/content "The **kernel** of a linear transformation is the set of vectors that map to the zero vector. We define it formally as follows:\n\n*For a linear transformation $\\mathbf{T}$, the **kernel** of $\\mathbf{T}$ is the set of all the vectors $\\mathbf{u}$ such that $\\mathbf{T}(\\mathbf{u})=\\mathbf{0}.$ We can write this as*\n\n$$\n\\textrm{Ker}(\\mathbf{T}) = \\left\\{ \\;\\mathbf{u} \\;| \\; \\mathbf{T}(\\mathbf{u}) = \\mathbf{0} \\right\\}.\n$$\n\nThe diagram below shows the kernel of a linear transformation $\\mathbf{T}: V \\rightarrow V$ in a vector space $V$.\n\n![](images/05/05f8c544d55c6bb07e4063150e586f8b4a7c51a352c2ff8ddda8c4cd5047dd93.png)\n\nNotice that, because of linearity, the zero vector is always in the kernel of a linear transformation: \n\n$$\n\\mathbf{T}(\\mathbf{0})=\\mathbf{T}(0\\cdot\\mathbf{v})=0\\cdot\\mathbf{T}(\\mathbf{v})= \\mathbf 0\n$$\n\nfor any vector $\\mathbf{v}$." :tutorial/id #uuid "50e4315c-9517-5360-820c-0b5ac6318f72" :tutorial/math-academy-id 3529 :tutorial/title "Introduction"} :step/id #uuid "ce1c8772-3f18-536d-9a24-286e7fb6cdcd" :step/next {:db/id #edb/ref 17592186125447}} {:db/id #edb/ref 17592186125398 :step/content {:db/id #edb/ref 17592186124516 :knowledge-point/id #uuid "a60cd4e9-d478-52ef-871e-fb08ff3d68a5"} :step/id #uuid "33a79ad4-40f8-519e-9527-22ea73a00c60" :step/next {:db/id #edb/ref 17592186125491}} {:db/id #edb/ref 17592186125399 :step/content {:db/id #edb/ref 17592186124517 :knowledge-point/id #uuid "15d2fde0-af1d-5e87-be58-806b9d444144"} :step/id #uuid "efa48e6d-73c8-530e-950a-58d259466cc6"} {:db/id #edb/ref 17592186125400 :step/content {:db/id #edb/ref 17592186124518 :knowledge-point/id #uuid "5d9208e7-9ee2-5220-9d62-6259432913d9"} :step/id #uuid "ff0148ea-ac0d-5e4b-bb4f-d79994d37847" :step/next {:db/id #edb/ref 17592186125489}} {:db/id #edb/ref 17592186125447 :step/content {:db/id #edb/ref 17592186124546 :knowledge-point/id #uuid "9af17e52-688b-5b75-8902-65be7464d50b"} :step/id #uuid "c3641ddd-fe03-5d00-8409-c7bae029f435" :step/next {:db/id #edb/ref 17592186125400}} {:db/id #edb/ref 17592186125489 :step/content {:db/id #edb/ref 17592186125818 :tutorial/content "We know how to determine whether a given vector is in the kernel of a linear transformation. But how do we find the kernel of a linear transformation?\n\nFirst, remember that if $T$ is the standard matrix of $\\mathbf{T},$ then \n\n$$\n\\textrm{Ker}(\\mathbf{T}) = \\textrm{Null}(T) = \\left\\{ \\;\\mathbf{x} \\;|\\; T\\mathbf{x}=\\mathbf{0} \\right\\}.\n$$\n\nTherefore, to find all the vectors in the kernel of a linear transformation, we just need to find the null space of the corresponding standard matrix. We can do this by solving the matrix equation $T\\mathbf{x}=\\mathbf{0}.$" :tutorial/id #uuid "d40c6e54-14ec-5f9e-a7be-84f54568e9cf" :tutorial/math-academy-id 4275 :tutorial/title "Finding the Kernel of a Linear Transformation"} :step/id #uuid "c2658336-bd8d-573d-850f-e69a58c8a2f4" :step/next {:db/id #edb/ref 17592186125398}} {:db/id #edb/ref 17592186125491 :step/content {:db/id #edb/ref 17592186125820 :tutorial/content "The **nullity** of a linear transformation $\\mathbf{T}$ is the dimension of its kernel. This means that\n\n$$\n\\text{nullity}(\\mathbf{T}) = \\dim(\\textrm{Ker}(\\mathbf{T})) = \\text{nullity}(T).\n$$\n\nTo compute the dimension of the kernel of $\\mathbf{T},$ we just have to reduce the matrix $T$ to row echelon form and count the number of  non-pivot columns." :tutorial/id #uuid "6246b2bd-c065-5a41-af65-109b316ca6e2" :tutorial/math-academy-id 4313 :tutorial/title "The Nullity of a Linear Transformation"} :step/id #uuid "f7d4bb63-d535-509c-9941-b7ed106acb1b" :step/next {:db/id #edb/ref 17592186125399}}] :activity/title "The Kernel of a Linear Transformation" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186124745} {:activity/first-step {:db/id #edb/ref 17592186419585} :activity/id #uuid "830795dd-db9f-5aef-8ed9-a82f03b7bd1a" :activity/steps [{:db/id #edb/ref 17592186419584 :step/content {:db/id #edb/ref 17592186419580 :question/id #uuid "63f7892f-01e8-58a2-8307-26e6eb1dacb9"} :step/id #uuid "3d23af43-be13-585f-9055-f003ed10a6af" :step/next {:db/id #edb/ref 17592186419586}} {:db/id #edb/ref 17592186419585 :step/content {:db/id #edb/ref 17592186419583 :question/id #uuid "f93ed602-5802-58b3-b8ce-1b9e0f1d7153"} :step/id #uuid "acaaf24c-b820-5d27-9cad-c26f7f900e0e" :step/next {:db/id #edb/ref 17592186419587}} {:db/id #edb/ref 17592186419586 :step/content {:db/id #edb/ref 17592186419579 :question/id #uuid "32b7b7cc-73cb-5678-9200-bd4242fb8265"} :step/id #uuid "e5b6668f-23d9-5bd7-ab9f-9383a9c47d8d"} {:db/id #edb/ref 17592186419587 :step/content {:db/id #edb/ref 17592186419582 :question/id #uuid "f1fb1c9c-0f88-5161-9527-cc60a53751f9"} :step/id #uuid "f4e671bf-aca9-5c31-b460-2f7da409a479" :step/next {:db/id #edb/ref 17592186419588}} {:db/id #edb/ref 17592186419588 :step/content {:db/id #edb/ref 17592186419581 :question/id #uuid "aeb22a13-5f92-563c-bd00-38953af464b9"} :step/id #uuid "fa869ace-3a7c-544c-91f1-9f8e4eedf28f" :step/next {:db/id #edb/ref 17592186419584}}] :activity/title "The Kernel of a Linear Transformation" :activity/type {:db/ident :activity.type/review} :db/id #edb/ref 17592186419548}] :db/id #edb/ref 17592186049903 :topic/knowledge-points [{:db/id #edb/ref 17592186124516 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124325 :question/id #uuid "87580982-1d5a-5f68-b9c8-df77b4da0196" :question/math-academy-id "e-5439" :question/problem "Consider the linear transformation ![](images/dc/dc7167e974da1de140ef435bef80635dce264d35149e4b47d11163da494f96e3.svg) Find $\\textrm{Ker}(\\mathbf{T}).$" :question/worked-solution "Finding the kernel of $\\mathbf{T}$ is equivalent to finding the null space of the standard matrix of $\\mathbf{T}.$\n\nFor the given linear transformation, the standard matrix is ![](images/ce/ceecfd6c4dd68aa7527afbee41138c1dbe0609bc9167b5cea48c0aaac1498177.svg)\n\nSetting ![](images/13/13b9be4071882f383a87df41c55302fa01fe6cdccacb93f332f9bb77420df1e6.svg) we then need to solve the equation $T\\mathbf{x}=\\mathbf{0}.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 4 \\\\ 3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 4 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we need to find $x$ in terms of $y.$\n\nFrom the first equation, we get \n\n$$\nx=-2y.\n$$\n\n \n\nTherefore, the kernel of the linear transformation $\\,\\mathbf{T}$ is ![](images/d3/d30f345674a0a66ef197d4d8b418604924be0c8b0f4367901ccc8d75d3901c41.svg)"} :knowledge-point/id #uuid "a60cd4e9-d478-52ef-871e-fb08ff3d68a5" :knowledge-point/questions [{:db/id #edb/ref 17592186125105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82ec6b5e-4b44-5ddb-be8d-8e4dba6e4a7f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186123231} {:answer/id #uuid "88517d48-c01d-5c81-a3fd-d2507ab9470a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-\\frac{1}{3} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186123232} {:answer/id #uuid "8d4ed22d-aae3-51b5-a55c-8d44cff31baa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ \\frac{1}{2}\\end{bmatrix}}" :db/id #edb/ref 17592186123233} {:answer/id #uuid "e8fe513d-d461-5e36-9d84-f35fc65dfdfb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}, \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186123234} {:answer/id #uuid "2bf9a1a1-2995-5308-80cb-450875a820fc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186123235}] :answer-field/id #uuid "461ba595-a026-56ba-bdb8-7c85a799ee3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123230} {:answer-field/choices [{:answer/id #uuid "e8f7378d-ecd4-579f-8178-c7e04cb5c7e3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ \\frac{1}{2}\\end{bmatrix}}" :db/id #edb/ref 17592186366021} {:answer/id #uuid "333fbc96-2458-5543-aebe-066bda076bd8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix},\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186366022} {:answer/id #uuid "6ba63692-fbe4-552f-b157-1b5ed850ffd7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186366023} {:answer/id #uuid "6e407a25-b99b-59b1-82b6-01be4a70f6de" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-\\frac{1}{3} \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186366024} {:answer/id #uuid "97d05ca0-9a9d-55a2-88a6-f28bf35d51b3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-\\frac{1}{3} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186366025}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-\\frac{1}{3} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186366025} :answer-field/id #uuid "c64acee9-6db1-57c2-b784-d524fc3c10d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366020}] :question/id #uuid "51827371-63ab-5b34-a35b-393f2afada52" :question/math-academy-id "q-37826" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-9x-3y \\\\ -12x-4y\\end{bmatrix}.$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}-9 & -3 \\\\ -12 & -4\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-9 & -3 \\\\ -12 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{4}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}-9 & -3 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have one free variable, $y.$ That means we need to find $x$ in terms of $y.$\n\nFrom the first equation, we get \n\n$$\nx=-\\frac{1}{3}y.\n$$\n\n \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=\\begin{bmatrix}-\\frac{1}{3}y \\\\ y\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{3} \\\\ 1\\end{bmatrix}y,\\,y\\in R.\n$$\n\nThis implies that $B={\\begin{bmatrix}-\\frac{1}{3} \\\\ 1\\end{bmatrix}}$ is a basis of $\\text{Ker}(T).$"} {:db/id #edb/ref 17592186125138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3b8b58-09eb-5f30-b7d7-997888574e91" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-y \\\\ y \\\\ 0\\end{bmatrix}\\,:\\,y\\in R}" :db/id #edb/ref 17592186324218} {:answer/id #uuid "63827943-ee61-5eac-9a04-b47b4265c41d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}x \\\\ 1 \\\\ z\\end{bmatrix}\\,:\\,x,z\\in R}" :db/id #edb/ref 17592186324797} {:answer/id #uuid "b07078b4-6225-53ac-a752-02470acd44d0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186325477} {:answer/id #uuid "cff014b0-e8ac-5f5b-b4eb-bd6c9d237d70" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186325781} {:answer/id #uuid "ec49e8df-5943-5503-be64-88294e834104" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}y-2z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R}" :db/id #edb/ref 17592186326049}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186325781} :answer-field/id #uuid "e39e65e9-1edb-5668-9eeb-76f4f232a8dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326633}] :question/id #uuid "70fb9633-c0bc-5291-ae81-e236155dd61d" :question/math-academy-id "q-38719" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-4y+2z \\\\ x-3y+z \\\\ 4x-4y+z\\end{bmatrix}.$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=\\begin{bmatrix}2 & -4 & 2 \\\\ 1 & -3 & 1 \\\\ 4 & -4 & 1\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & -4 & 2 \\\\ 1 & -3 & 1 \\\\ 4 & -4 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{1}↔{R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 \\\\ 2 & -4 & 2 \\\\ 4 & -4 & 1\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-4){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 \\\\ 0 & 2 & 0 \\\\ 0 & 8 & -3\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-4){R}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x,$ $y,$ and $z.$ From the third equation, we obtain $z=0$ and from the second equation, we get $y=0.$ Substituting these into the first equation, we have $x=0.$ \n\nTherefore, the kernel of the linear transformation $\\,T$ is ${\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}}.$"} {:db/id #edb/ref 17592186272014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fcee97f-2a83-56de-a4db-4b119a8f0d0f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186269989} {:answer/id #uuid "6a0cdc24-904a-5e8f-884e-10bc6c35ab52" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186270209} {:answer/id #uuid "b46c2d20-40d3-50ed-a0e3-92b85de6f3fc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ \\frac{1}{2}\\end{bmatrix}}" :db/id #edb/ref 17592186270875} {:answer/id #uuid "d2518b7b-7283-5e9e-8fbc-d7621f37eb4b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-1 \\\\ \\frac{1}{2}\\end{bmatrix}}" :db/id #edb/ref 17592186271119} {:answer/id #uuid "d3f98932-8894-52e2-bd7e-81bbc7c72550" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}}" :db/id #edb/ref 17592186271132}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186270209} :answer-field/id #uuid "81ba6138-e8b7-5beb-bc0e-1d4e85978d88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271737}] :question/id #uuid "17d85582-de4f-5af0-adb3-cf918bd2bf16" :question/math-academy-id "q-140052" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}4x-2y \\\\ -6x+3y\\end{bmatrix}.$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}4 & -2 \\\\ -6 & 3\\end{bmatrix}.$ \n\nSetting $x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}4 & -2 \\\\ -6 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{6}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}4 & -2 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have one free variable, $y.$ That means we need to find $x$ in terms of $y.$\n\nFrom the first equation, we get \n\n$$\nx=\\frac{1}{2}y.\n$$\n\n  \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=\\begin{bmatrix}\\frac{1}{2}y \\\\ y\\end{bmatrix}=y\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix},\\,y\\in R.\n$$\n\nThis implies that $B={\\begin{bmatrix}\\frac{1}{2} \\\\ 1\\end{bmatrix}}$ is a basis of $\\text{Ker}(T).$"} {:db/id #edb/ref 17592186323943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21fa64d5-074d-5702-bcf4-064fabb99721" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ x-2z \\\\ z\\end{bmatrix}\\,:\\,x,z\\in R\\}" :db/id #edb/ref 17592186454955} {:answer/id #uuid "4263713e-2f96-539b-8f35-ecc62bb28c5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ y \\\\ 2x-3y\\end{bmatrix}\\,:\\,x,y\\in R\\}" :db/id #edb/ref 17592186455014} {:answer/id #uuid "4e5c75b7-6345-538e-96b8-2ba5d8c8cf18" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}z \\\\ -2z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186455041} {:answer/id #uuid "5ac4954c-967a-55e2-9e2d-f8a985c1ff0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-\\frac{1}{3}z \\\\ -3z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186455063} {:answer/id #uuid "b4c02bca-de60-5fa3-8668-018b71b4b4ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}" :db/id #edb/ref 17592186455219}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}z \\\\ -2z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186455041} :answer-field/id #uuid "da7e412b-267f-58a3-94eb-d3421d219bcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323602}] :question/id #uuid "7d0e70ad-1c81-5568-a326-e79afb6bb189" :question/math-academy-id "q-37827" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}-9x-3y+3z \\\\ -12x-4y+4z \\\\ 6x+8y+10z\\end{bmatrix}.$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=\\begin{bmatrix}-9 & -3 & 3 \\\\ -12 & -4 & 4 \\\\ 6 & 8 & 10\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-9 & -3 & 3 \\\\ -12 & -4 & 4 \\\\ 6 & 8 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{4}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}-9 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 6 & 8 & 10\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}-9 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 6 & 12\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}-9 & -3 & 3 \\\\ 0 & 6 & 12 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=-2z.$ Substituting this into the first equation, we have \n\n$$\n\\begin{aligned}-9x-3y+3z & =0 \\\\ -9x-3(-2z)+3z & =0 \\\\ -9x+9z & =0 \\\\ x & =z\\end{aligned}\n$$\n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{\\begin{bmatrix}z \\\\ -2z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}.$"} {:db/id #edb/ref 17592186323944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b540025-77b9-5bb7-9f97-3ab466aa8778" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-\\frac{1}{2} \\\\ -3 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186455001} {:answer/id #uuid "615800d5-e525-5e24-820b-a9bb8d529e22" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186455079} {:answer/id #uuid "8584f93d-d159-5c71-b53d-b996bcc93b22" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ -3\\end{bmatrix}\\}" :db/id #edb/ref 17592186455142} {:answer/id #uuid "aaeda1c4-dfae-5e5f-b5d4-3287ce85f1a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455203} {:answer/id #uuid "f4aaf7aa-e9a1-5334-8fb1-319f1a1174f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186455322}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}\\}" :db/id #edb/ref 17592186455322} :answer-field/id #uuid "7c15bcb8-d6d5-5caf-9815-06b85b3af955" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323413}] :question/id #uuid "1546ae0c-0405-54cb-8c7c-cf6c58a51fc2" :question/math-academy-id "q-37828" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}3y-6z-6x \\\\ -4y+x+z \\\\ 2y+8z+8x\\end{bmatrix}.$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}-6 & 3 & -6 \\\\ 1 & -4 & 1 \\\\ 8 & 2 & 8\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-6 & 3 & -6 \\\\ 1 & -4 & 1 \\\\ 8 & 2 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{6}{R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 8 & 2 & 8\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{4}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 0 & 6 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{12}{7}{R}_{2} \\\\  & ∼\\begin{bmatrix}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=0.$ Substituting this into the first equation, we have $x=-z.$ \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=\\begin{bmatrix}-z \\\\ 0 \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}z,\\,z\\in R.\n$$\n\nThis implies that $B=\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}\\}$ is a basis of $\\text{Ker}(T).$"} {:db/id #edb/ref 17592186398814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb465645-5781-56a6-9ef8-8bcad739b465" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186398816} {:answer/id #uuid "6b8c038e-f611-5478-9aa9-a2bfda5d0840" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ \\frac{1}{6}\\end{bmatrix}}" :db/id #edb/ref 17592186398817} {:answer/id #uuid "5fe5ff4c-e5fc-5063-9a2a-2461632dec52" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}\\frac{1}{3} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186398818} {:answer/id #uuid "4ae28e12-3029-507c-ade0-f3e66e2e8d28" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}6 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186398819} {:answer/id #uuid "c978c2b1-ccc1-54be-9587-b2edd6ded6df" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}" :db/id #edb/ref 17592186398820}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186398816} :answer-field/id #uuid "c97e3a1a-a6d7-5da5-9304-dedf20c2e8e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398815}] :question/id #uuid "daa0bc39-0770-52e4-a043-5e620f02bd66" :question/math-academy-id "q-40175" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-6x+y \\\\ 12x-2y\\end{bmatrix}.$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}-6 & 1 \\\\ 12 & -2\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-6 & 1 \\\\ 12 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 1 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have one free variable, $y.$ That means we need to find $x$ in terms of $y.$\n\nFrom the first equation, we get \n\n$$\nx=\\frac{1}{6}y.\n$$\n\n \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=\\begin{bmatrix}\\frac{1}{6}y \\\\ y\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}y,\\,y\\in R.\n$$\n\nThis implies that $B={\\begin{bmatrix}\\frac{1}{6} \\\\ 1\\end{bmatrix}}$ is a basis of $\\text{Ker}(T).$"} {:db/id #edb/ref 17592186419579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aa3f0cb-f552-5997-9604-53d87b356492" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-4z \\\\ y \\\\ 2z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186455062} {:answer/id #uuid "967cf1df-e3fe-5921-8f01-b706d00a2a7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ 4x+2z \\\\ z\\end{bmatrix}\\,:\\,x,y\\in R\\}" :db/id #edb/ref 17592186455175} {:answer/id #uuid "b52464b5-12d3-55df-8a1f-c2ec33198abb" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-2y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}." :db/id #edb/ref 17592186455221} {:answer/id #uuid "c0727ab1-37f4-52c5-b6e4-c5118fe93bbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ y \\\\ 4x+2y\\end{bmatrix}\\,:\\,x,y\\in R\\}" :db/id #edb/ref 17592186455234} {:answer/id #uuid "ce2608f3-a0b5-5f12-8da7-ae3d41d9398a" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455262}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-2y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}." :db/id #edb/ref 17592186455221} :answer-field/id #uuid "07ed2ad4-a2fd-5d04-be73-f4b3ba6ae7db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419574}] :question/id #uuid "32b7b7cc-73cb-5678-9200-bd4242fb8265" :question/math-academy-id "q-140056" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x+4y-2z \\\\ -3x-6y+3z \\\\ 4x+8y-4z\\end{bmatrix}.$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=\\begin{bmatrix}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{bmatrix}.$ \n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{3}{2}){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 4 & 8 & -4\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-2){R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables, $y,$ and $z.$ That means we need to find $x$ in terms of $y$ and $z.$ \n\nFrom the first equation, we get \n\n$$\nx=-2y+z.\n$$\n\n  \n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{\\begin{bmatrix}-2y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}.$"} {:db/id #edb/ref 17592186419583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4739298e-dd01-59ef-8f47-4cfcbbec131c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186419557} {:answer/id #uuid "5aa80b1b-5014-541e-8bd9-63ec94952621" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ -3 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186419561} {:answer/id #uuid "6e8db4f5-b391-5b49-be86-ab71fcf3e51b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186419564} {:answer/id #uuid "6f36da26-8b60-5dc1-a7b6-0a44692d0408" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186419565} {:answer/id #uuid "d37bbbe8-9321-5bfc-8871-f43a0b11a511" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}" :db/id #edb/ref 17592186419570}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}" :db/id #edb/ref 17592186419565} :answer-field/id #uuid "68bd28ba-c540-5d5a-aa98-7f8eddeaa4c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419575}] :question/id #uuid "f93ed602-5802-58b3-b8ce-1b9e0f1d7153" :question/math-academy-id "q-38686" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-y \\\\ 5x-3y \\\\ x+3y\\end{bmatrix}.$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}2 & -1 & 0 \\\\ 5 & -3 & 0 \\\\ 1 & 3 & 0\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & -1 & 0 \\\\ 5 & -3 & 0 \\\\ 1 & 3 & 0\\end{bmatrix} & {R}_{3} & ↔{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 5 & -3 & 0 \\\\ 2 & -1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 2 & -1 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 0 & -7 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{7}{18}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=0.$ Substituting this into the first equation, we have $x=0.$ \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=\\begin{bmatrix}0 \\\\ 0 \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}z,\\,z\\in R.\n$$\n\nThis implies that $B={\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}$ is a basis of $\\text{Ker}(T).$"} {:db/id #edb/ref 17592186455477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158275b9-5947-59e3-903c-3c7f779ef557" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}z \\\\ z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186454941} {:answer/id #uuid "27f1cb64-dccf-5fab-9082-a461c30b09d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-z \\\\ 2z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186454964} {:answer/id #uuid "3d771fac-20a4-5da5-9a63-f77ed82f4b7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455005} {:answer/id #uuid "5e8dcc3d-1404-533c-80fc-0b0be8a90ea4" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}y+z \\\\ y \\\\ z\\end{bmatrix}\\,:\\,y,z\\in R\\}" :db/id #edb/ref 17592186455074} {:answer/id #uuid "699e4414-d093-5419-b6dd-e106e24458a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-y \\\\ y \\\\ -y\\end{bmatrix}\\,:\\,y\\in R\\}" :db/id #edb/ref 17592186455097}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}z \\\\ z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}" :db/id #edb/ref 17592186454941} :answer-field/id #uuid "b172b207-9ce8-57d0-a93f-f4bc1bd2dba7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455401}] :question/id #uuid "8b821123-b07b-51e0-96de-b9776f35dea3" :question/math-academy-id "q-38689" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}x-2y+z \\\\ 6x-3y-3z \\\\ 0\\end{bmatrix}.$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=\\begin{bmatrix}1 & -2 & 1 \\\\ 6 & -3 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}1 & -2 & 1 \\\\ 6 & -3 & -3 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 9 & -9 \\\\ 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=\\frac{1}{9}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=z.$ Substituting these into the first equation, we have \n\n$$\nx=2y-z=2z-z=z.\n$$\n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{\\begin{bmatrix}z \\\\ z \\\\ z\\end{bmatrix}\\,:\\,z\\in R\\}.$"} {:db/id #edb/ref 17592186455510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06604d00-4f85-5765-a7cb-500cb7224391" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ \\frac{1}{2}x\\end{bmatrix}\\,:\\,x\\in R\\}" :db/id #edb/ref 17592186454918} {:answer/id #uuid "ab5a1ea5-3e9e-5ec0-b21a-0db9baf1a4e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455204} {:answer/id #uuid "af648992-ccc2-53a1-bad7-36ea56d6dfd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}-2y \\\\ y\\end{bmatrix}\\,:\\,y\\in R\\}" :db/id #edb/ref 17592186455211} {:answer/id #uuid "ce529969-305d-5eb3-a177-4e8966a9ad83" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}x \\\\ -2x\\end{bmatrix}\\,:\\,x\\in R\\}" :db/id #edb/ref 17592186455263} {:answer/id #uuid "cf33566f-e0e1-5630-b237-43de2ee913aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}3y \\\\ y\\end{bmatrix}\\,:\\,y\\in R\\}" :db/id #edb/ref 17592186455266}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "\\{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186455204} :answer-field/id #uuid "de328ef9-23d7-525d-a753-5f70c0536f52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455418}] :question/id #uuid "f32f1d75-9b11-57ea-bfe4-1528ecbfd581" :question/math-academy-id "q-37837" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}2x+4y \\\\ -x+2y\\end{bmatrix}.$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=\\begin{bmatrix}2 & 4 \\\\ -1 & 2\\end{bmatrix}.$\n\nSetting $x=\\begin{bmatrix}x \\\\ y\\end{bmatrix},$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 4 \\\\ -1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 4 \\\\ 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y.$ From the second equation, we obtain $y=0.$ Substituting this into the first equation, we have $x=0.$ \n\nTherefore, the kernel of the linear transformation $T$ is $\\{\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\}.$"}] :knowledge-point/title "Finding the Kernel of a Linear Transformation"} {:db/id #edb/ref 17592186124517 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124326 :question/id #uuid "f3694e9e-804f-55f0-9fb1-a78caec29224" :question/math-academy-id "e-5440" :question/problem "Given the linear transformation ![](images/57/57112e6087d2f03fe0badc3847a3257495fdb51eb4fe385be7c7a2d743fc0d45.svg) find $\\,\\textrm{nullity}(\\mathbf{T}).$" :question/worked-solution "First, we write down the standard matrix of $\\mathbf{T}\\mathbin{:}$\n\n![](images/94/94a5bcbcf9377b4cc2047b1cbab522eec499bcc5f438f6ee97e2e16e7f837b42.svg)\n\nRecall that $\\textrm{nullity}(\\mathbf{T}) = \\textrm{nullity}(T) = \\textrm{dim}(\\textrm{Null}(T)).$\n\nIn order to find $\\textrm{dim}(\\textrm{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 4 & 0 \\\\ 4 & 10 & -1 \\\\ -6 & -12 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 4 & 0 \\\\ 0 & 2 & -1 \\\\ -6 & -12 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 4 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has no non-pivot columns. Therefore, \n\n$$\n\\textrm{nullity}(\\mathbf{T})=\\textrm{dim}(\\textrm{Null}(T))=0.\n$$"} :knowledge-point/id #uuid "15d2fde0-af1d-5e87-be58-806b9d444144" :knowledge-point/questions [{:db/id #edb/ref 17592186125134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f65655-e223-581d-8dc4-b042c221788f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186123405} {:answer/id #uuid "aa34cf8c-9487-534e-aad0-43437a88e90a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186123406} {:answer/id #uuid "ef1035e8-629b-5695-a946-f5f3a61e35f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186123407} {:answer/id #uuid "656baedf-aa1d-53c9-abbb-f99f0cf0617d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123408} {:answer/id #uuid "793b85d5-bc2d-5eb9-9f4e-8f8ec3eb6ba7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186123409}] :answer-field/id #uuid "226834c9-d159-5b69-994a-786abebe1acb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123404}] :question/id #uuid "fe37b1c2-60b6-5201-95a6-74272c3cad48" :question/math-academy-id "q-38643" :question/problem "Given the linear transformation $T: \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}-3y - 2z \\\\ x - 2z - 4y \\\\ z - 3x + 4y\\end{bmatrix}$, find $nullity(T)$."} {:db/id #edb/ref 17592186125135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0190a5f0-08d1-5ff7-acf6-27f699845af6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186323986} {:answer/id #uuid "0488e443-8a87-5177-b20b-e80392ebeac5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186324016} {:answer/id #uuid "0b45c091-a577-5914-94c5-4a5dd218235b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324073} {:answer/id #uuid "76a0d311-723e-5194-a77d-7279f0bed380" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324958} {:answer/id #uuid "a4d4013e-43b3-51de-8987-70825b4f53e6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325372}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325372} :answer-field/id #uuid "aa9d7ee4-c385-595d-9a58-1578ba301275" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326530}] :question/id #uuid "61ec1738-c727-5f71-a158-a3fc80b2a14e" :question/math-academy-id "q-38676" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}5x-7y \\\\ 14y-10x\\end{bmatrix},$\nfind  $3\\cdot \\text{nullity}(T)+1.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}5 & -7 \\\\ -10 & 14\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}5 & -7 \\\\ -10 & 14\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}5 & -7 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has $1$ non-pivot column (the $2$nd one). \n\nTherefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=1.$\n\nFinally, we obtain\n\n$$\n3\\cdot \\text{nullity}(T)+1=3\\cdot 1+1=4.\n$$"} {:db/id #edb/ref 17592186326813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ee7ff0-51a0-542e-b56e-7d0ffcc4ac02" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186324159} {:answer/id #uuid "2c845075-1841-5e35-b879-e2cf2114eb2e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324330} {:answer/id #uuid "4efa3b2d-fc8a-56c7-a67e-e5cb9aa98d25" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186324620} {:answer/id #uuid "b9708486-17ba-5676-a31e-906aeab8ff29" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325562} {:answer/id #uuid "dc8234f2-4949-51b5-bf10-00f0561bcd04" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186325895}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186325562} :answer-field/id #uuid "da3fe3d0-18d3-52c1-974a-22aadf7eebc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326617}] :question/id #uuid "593660b7-833b-53d7-a852-232a7a46c1ee" :question/math-academy-id "q-40177" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-3x-6y \\\\ 2x-4y\\end{bmatrix},$ find $9\\cdot \\text{nullity}(T)+4.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}-3 & -6 \\\\ 2 & -4\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-3 & -6 \\\\ 2 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{2}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & -6 \\\\ 0 & -8\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has no non-pivot column. \n\nTherefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=0.$\n\nFinally, we obtain\n\n$$\n9\\cdot \\text{nullity}(T)+4=9\\cdot 0+4=4.\n$$"} {:db/id #edb/ref 17592186348440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e1f48e3-07a1-5160-8301-842412cdd455" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346316} {:answer/id #uuid "89d89a20-2aba-5e20-ab2a-099740405b79" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186346548} {:answer/id #uuid "a60b1f4f-b83f-58aa-bf9b-f19cc0471497" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346801} {:answer/id #uuid "e55fcde1-ea08-595a-8f1e-32c518ba76e9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347370} {:answer/id #uuid "fd67d53c-41a1-5be8-94ab-6571739b046c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186347578}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346801} :answer-field/id #uuid "83c0f349-5ca0-538c-aca1-97d47be28ea4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347838}] :question/id #uuid "63bbd457-4720-5df6-b92e-bec18dfe5f4b" :question/math-academy-id "q-80723" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-y+3z \\\\ 8x-3y+10z \\\\ -6x+3y-9z\\end{bmatrix},$ find $\\text{nullity}(T).$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}2 & -1 & 3 \\\\ 8 & -3 & 10 \\\\ -6 & 3 & -9\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & -1 & 3 \\\\ 8 & -3 & 10 \\\\ -6 & 3 & -9\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 1 & -2 \\\\ -6 & 3 & -9\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -1 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has $1$ non-pivot columns (the third one). Therefore, \n\n$$\n\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=1.\n$$"} {:db/id #edb/ref 17592186351303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e0f2a4d-8be3-5c94-a0eb-8fa431f10e1e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349011} {:answer/id #uuid "ac2ad5e9-80f9-59d3-bf0a-5772922b7eca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349972} {:answer/id #uuid "c9a61828-1c65-5971-b508-db09e73a25a7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186350224} {:answer/id #uuid "eadf86d8-8cac-5bc5-8c8a-f406c5cf7f22" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186350499} {:answer/id #uuid "eecfcb3a-e593-5747-8eed-cc88c924c7ae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186350536}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186350224} :answer-field/id #uuid "47d71717-e8b9-5e76-acae-e00cc687fe36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350827}] :question/id #uuid "ae878865-22de-5344-874b-fc28f0188962" :question/math-academy-id "q-81391" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}3x-8y \\\\ 16y-6x\\end{bmatrix},$\nfind  $2\\cdot \\text{nullity}(T)-3.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}3 & -8 \\\\ -6 & 16\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}3 & -8 \\\\ -6 & 16\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & -8 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has $1$ non-pivot column (the $2$nd one). \n\nTherefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=1.$\n\nFinally, we obtain\n\n$$\n2\\cdot \\text{nullity}(T)-3=2\\cdot 1-3=-1.\n$$"} {:db/id #edb/ref 17592186351304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53750d24-755f-51fd-b4b1-3999616bb4bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349208} {:answer/id #uuid "54c76c9c-3dfe-5f84-83f4-73a8745d7382" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186349221} {:answer/id #uuid "5bdfe70d-a6a8-5c14-b42f-ef3b4b5f1d63" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349293} {:answer/id #uuid "8cdc1432-e609-5d49-8860-54ee3461005e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349719} {:answer/id #uuid "996f8b5f-1dc0-553a-9347-7d0ebc42480f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349819}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186349208} :answer-field/id #uuid "143a07e8-1e6a-5468-9248-cfae98764d05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350745}] :question/id #uuid "f3e25176-30ac-5743-87ee-ef074c94ef6c" :question/math-academy-id "q-81392" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-z \\\\ x-y+z \\\\ 3z-6x\\end{bmatrix},$ find $\\text{nullity}(T).$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}2 & 0 & -1 \\\\ 1 & -1 & 1 \\\\ -6 & 0 & 3\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}2 & 0 & -1 \\\\ 1 & -1 & 1 \\\\ -6 & 0 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & -1 & \\frac{3}{2} \\\\ -6 & 0 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & -1 & \\frac{3}{2} \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has $1$ non-pivot column (the $3$rd one). Therefore, \n\n$$\n\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=1.\n$$"} {:db/id #edb/ref 17592186364968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6d2ee1-42d5-5a7f-822c-94ea137fe0a4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186364970} {:answer/id #uuid "4aecd48f-f9da-5257-8263-d68bbc2b3da6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186364971} {:answer/id #uuid "8db28dbb-a466-5172-a6eb-ac3463671499" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364972} {:answer/id #uuid "67f0e235-17a6-5c48-97cf-566fdd5f365e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364973} {:answer/id #uuid "c6d35d2d-b74b-5c8c-bb4e-394ac2ab72c0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186364974}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364972} :answer-field/id #uuid "ce1a7aa9-c34f-5290-9a38-a5a184cf9364" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364969}] :question/id #uuid "5c099173-4895-55c8-a699-8c50ffc5eadb" :question/math-academy-id "q-140066" :question/problem "Given the linear transformation\n $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}3y-x-4z \\\\ 2x+7z-6y \\\\ 16z+4x-12y\\end{bmatrix},$ find $\\text{nullity}(T).$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}-1 & 3 & -4 \\\\ 2 & -6 & 7 \\\\ 4 & -12 & 16\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-1 & 3 & -4 \\\\ 2 & -6 & 7 \\\\ 4 & -12 & 16\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 3 & -4 \\\\ 0 & 0 & -1 \\\\ 4 & -12 & 16\\end{bmatrix} &  & \\begin{aligned}{R}_{3}:={R}_{3}+4{R}_{1}\\end{aligned} \\\\  & ∼\\begin{bmatrix}-1 & 3 & -4 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has $1$ non-pivot columns (the 2nd one).  Therefore, \n\n$$\n\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=1.\n$$"} {:db/id #edb/ref 17592186366078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14eed407-6b25-5868-ba78-53d73bba205f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366080} {:answer/id #uuid "48f9467e-1f3a-5b33-ad4e-9ce3ae6d192c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366081} {:answer/id #uuid "2eca51ec-bc3d-50c3-9c4d-8fc7d0ace6f9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186366082} {:answer/id #uuid "9bc4202d-ea22-57a4-8d4c-07df0c1cd24f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366083} {:answer/id #uuid "1341a9b7-41b2-5380-b684-2557cf69533c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366084}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186366084} :answer-field/id #uuid "0e35217a-c5a8-5016-8924-bddec15e8b61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366079}] :question/id #uuid "0e24e150-5788-5770-a2a9-706c3d3592ca" :question/math-academy-id "q-38645" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}x+2y \\\\ 4y+3x\\end{bmatrix},$ find  $2\\cdot \\text{nullity}(T)-1.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 \\\\ 0 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has no non-pivot column. Therefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=0.$\n\nFinally, we obtain\n\n$$\n2\\cdot \\text{nullity}(T)-1=2\\cdot 0-1=-1.\n$$"} {:db/id #edb/ref 17592186419581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db9202e-b598-5f25-bdc3-0d228cf73e32" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186419551} {:answer/id #uuid "1dbe2ca8-db59-5a94-82d9-cb88aa1ffaad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186419553} {:answer/id #uuid "49892ac2-f3e6-5f71-9f0d-4dbe950589af" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186419558} {:answer/id #uuid "4cb35d88-ee52-5c7a-aa5d-66486183461e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186419559} {:answer/id #uuid "61f70cb9-9bba-514c-809f-dad55c0c90bb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186419563}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186419553} :answer-field/id #uuid "e00646f1-87a0-5a44-9d32-d7268a416e97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419578}] :question/id #uuid "aeb22a13-5f92-563c-bd00-38953af464b9" :question/math-academy-id "q-81393" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}9y-3x+6z \\\\ 3y-x+2z \\\\ 6x-12z-18y\\end{bmatrix},$ find $\\text{nullity}(T).$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}-3 & 9 & 6 \\\\ -1 & 3 & 2 \\\\ 6 & -18 & -12\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}-3 & 9 & 6 \\\\ -1 & 3 & 2 \\\\ 6 & -18 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 9 & 6 \\\\ 0 & 0 & 0 \\\\ 6 & -18 & -12\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-3 & 9 & 6 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe reduced matrix above has $2$ non-pivot columns (the $2$nd and $3$rd ones). Therefore, \n\n$$\n\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=2.\n$$"} {:db/id #edb/ref 17592186455433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08924535-c25f-56c1-8689-8a2f419cd1a3" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186454925} {:answer/id #uuid "2baa0d4c-e9e1-57fc-98fe-318195648fbb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186454968} {:answer/id #uuid "4a01bca2-b941-5afe-8604-e49eb8cbbbba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186455028} {:answer/id #uuid "9074ae70-4f70-5481-8939-b34cd328b0df" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186455164} {:answer/id #uuid "b4a2477e-f888-5314-962e-2dd6fd7d298b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186455218}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186454968} :answer-field/id #uuid "d07d81d8-068b-5704-8701-64426907bcc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455413}] :question/id #uuid "1489ce7f-875c-5e62-837a-1b4169461580" :question/math-academy-id "q-38677" :question/problem "Given the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}0x+0y \\\\ 0x+0y\\end{bmatrix},$ find  $2\\cdot \\text{nullity}(T)-4.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$ Notice that $T$ has $2$ non-pivot columns. \n\nTherefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=2.$\n\nFinally, we obtain\n\n$$\n2\\cdot \\text{nullity}(T)-4=2\\cdot 2-4=0.\n$$"}] :knowledge-point/title "Finding the Nullity of a Linear Transformation"} {:db/id #edb/ref 17592186124518 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124327 :question/id #uuid "fc0725a9-354c-5e01-a924-12c0d2723ba3" :question/math-academy-id "e-5441" :question/problem "Consider the linear transformation ![](images/39/39153d2e76108077485d1676c05530e5b4b2497d3e4efa02251bb03b198bee7e.svg) and the vector ![](images/6e/6e126f01e7689d1be0efddec49224374b09a58e1147351e8adf620d9ef062cac.svg) Find the value of $\\,k\\,$ such that $\\,\\mathbf{u}\\in\\textrm{Ker}(\\mathbf{T}).$" :question/worked-solution "A vector $\\mathbf{u}$ belongs to the kernel of a linear transformation $\\mathbf{T}$ if $\\mathbf{T}(\\mathbf{u})=\\mathbf{0}.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}3\\cdot k+12\\cdot 2-3\\cdot 6 \\\\ -2\\cdot k+4\\cdot 2-2\\cdot 6 \\\\ 6\\cdot k-3\\cdot 2+3\\cdot 6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}3k+6 \\\\ -2k-4 \\\\ 6k+12\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}3k+6 &=0 \\\\ -2k-4 &=0 \\\\ 6k+12 &=0.\\end{aligned}\\right.\n$$\n\nThe solution to all three of these equations is $k=-2.$"} :knowledge-point/id #uuid "5d9208e7-9ee2-5220-9d62-6259432913d9" :knowledge-point/questions [{:db/id #edb/ref 17592186125104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "502cb7bf-d839-54d5-80e3-9ea7df778ed3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321776} {:answer/id #uuid "8159cef6-c1a1-590b-96b6-466ca0ae35d9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186322166} {:answer/id #uuid "a12a2a6a-d3e6-5f9c-85e7-7b997b09b179" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322419} {:answer/id #uuid "a1f135c2-1de9-5952-8c6b-92b9bf7a9ede" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186322422} {:answer/id #uuid "a9cf9c20-5a3a-56ff-ad42-b615924be6b3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322481}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322481} :answer-field/id #uuid "df87c177-5600-5668-aa22-f776774133ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323616}] :question/id #uuid "c08047d4-78e2-5052-a86f-f3f6f58c0260" :question/math-academy-id "q-37825" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}4x-2y \\\\ -10x+5y\\end{bmatrix}$ and the vector $\\,u=\\begin{bmatrix}k \\\\ 6\\end{bmatrix}.$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}4\\cdot k-2\\cdot 6 \\\\ -10\\cdot k+5\\cdot 6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}4k-12 \\\\ -10k+30\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}4k-12 &=0 \\\\ -10k+30 &=0.\\end{aligned}\\right.\n$$\n\nThe solution to both of these equations is $k=3.$"} {:db/id #edb/ref 17592186125107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14df1d0b-3a05-5977-aa9f-fbb7fbfc9c33" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186321317} {:answer/id #uuid "59c74995-9f53-5f01-b5ca-c6e4936cbbbe" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186321856} {:answer/id #uuid "ca33f1aa-60da-5eb7-bb74-1a0d4cf2077c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322715} {:answer/id #uuid "cf3bca9e-c572-5499-bcf3-9212699e18bf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186322765} {:answer/id #uuid "ede30cfc-eeb8-51bb-a5f1-76292c115e09" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186323025}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186322765} :answer-field/id #uuid "0a7f20e5-93d4-548f-bcd2-fdfe013e682a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323188}] :question/id #uuid "c9bef4f8-9900-515d-bbba-da49134e795e" :question/math-academy-id "q-37842" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}-8x+4y \\\\ 6x-3y \\\\ 2x-y\\end{bmatrix}$ and the vector $\\,u=\\begin{bmatrix}3 \\\\ k \\\\ 1\\end{bmatrix}.$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}-8\\cdot 3+4\\cdot k \\\\ 6\\cdot 3-3\\cdot k \\\\ 2\\cdot 3-k\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}-24+4k \\\\ 18-3k \\\\ 6-k\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}-24+4k &=0 \\\\ 18-3k &=0 \\\\ 6-k &=0.\\end{aligned}\\right.\n$$\n\nThe solution to all three of these equations is $k=6.$"} {:db/id #edb/ref 17592186272002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03de760e-0775-523e-aadf-022fefd490ec" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186269305} {:answer/id #uuid "0a8ec85b-2df7-5914-86a0-32ba106603d2" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269362} {:answer/id #uuid "45afe4aa-ec0c-5b9b-a93c-6ae2cb27da3c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186269905} {:answer/id #uuid "5bdc8e1f-3589-590e-9b31-4395522a499c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186270086} {:answer/id #uuid "9c672bc6-01ed-5108-b513-faa9e605db8d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186270649}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186270649} :answer-field/id #uuid "ad2a3fa0-932c-50a4-962d-4667df0d8964" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271823}] :question/id #uuid "0c69985e-2b04-5162-9fa3-e08f616657be" :question/math-academy-id "q-140011" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}2x+4y \\\\ 5x+10y\\end{bmatrix}$ and the vector $\\,u=\\begin{bmatrix}k \\\\ 3\\end{bmatrix}.$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}2\\cdot k+4\\cdot 3 \\\\ 5\\cdot k+10\\cdot 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}2k+12 \\\\ 5k+30\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}2k+12 &=0 \\\\ 5k+30 &=0.\\end{aligned}\\right.\n$$\n\nThe solution to both of these equations is $k=-6.$"} {:db/id #edb/ref 17592186351301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065fe2d2-27bc-5b0d-a756-2e96d9074922" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348504} {:answer/id #uuid "2d10ef55-04cd-5945-9adf-137539253155" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186348842} {:answer/id #uuid "98939c03-5823-5e95-9652-7698824603e9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186349812} {:answer/id #uuid "ab9417f4-4771-5587-8a64-bfea64370050" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186349968} {:answer/id #uuid "dea26071-f0ca-55a2-8485-1f20e0bdf83d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186350393}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186348504} :answer-field/id #uuid "f8c54f7c-daab-59c3-8960-8e6c25c2f170" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351146}] :question/id #uuid "328b0afd-0c82-5cff-b5a3-0cdd36c80b90" :question/math-academy-id "q-81387" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y\\end{bmatrix}⟶\\begin{bmatrix}-3x+6y \\\\ 2x-4y\\end{bmatrix}$ and the vector $\\,u=\\begin{bmatrix}k \\\\ 2\\end{bmatrix}.$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}-3\\cdot k+6\\cdot 2 \\\\ 2\\cdot k-4\\cdot 2\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}-3k+12 \\\\ 2k-8\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}-3k+12 &=0 \\\\ 2k-8 &=0.\\end{aligned}\\right.\n$$\n\nThe solution to both of these equations is $k=4.$"} {:db/id #edb/ref 17592186351302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a1f41f-e3cf-56c9-8066-b4e9daaf6a03" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186348460} {:answer/id #uuid "281736f7-8800-5717-a86c-439108afc25d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186348792} {:answer/id #uuid "627ee9a3-e5a1-50a3-ba69-471994474d7a" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186349348} {:answer/id #uuid "cf7c882b-c76f-5b96-ac92-6c2e2bd97cad" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186350271} {:answer/id #uuid "e0d994fb-5e61-5cee-9bae-d361b53eb8bd" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186350423}] :answer-field/correct {:answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186350423} :answer-field/id #uuid "4a4a4aed-38ff-5c52-ab3b-87fc9fd23cc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350834}] :question/id #uuid "dbeaca94-f4fa-5001-92dc-ec1961826078" :question/math-academy-id "q-81388" :question/problem "Consider the linear transformation $T:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}⟶\\begin{bmatrix}2x-y+z \\\\ -6x+3y-3z \\\\ 4x-2y+2z\\end{bmatrix}$ and the vector $\\,u=\\begin{bmatrix}3 \\\\ 1 \\\\ k\\end{bmatrix}.$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ \\begin{bmatrix}2\\cdot 3-1+k \\\\ -6\\cdot 3+3\\cdot 1-3\\cdot k \\\\ 4\\cdot 3-2\\cdot 1+2\\cdot k\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}5+k \\\\ -15-3k \\\\ 10+2k\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\left\\{\\begin{aligned}5+k &=0 \\\\ -15-3k &=0 \\\\ 10+2k &=0.\\end{aligned}\\right.\n$$\n\nThe solution to all three of these equations is $k=-5.$"} {:db/id #edb/ref 17592186366358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc2731d7-9bf4-59e2-a5fd-0d22940726ec" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366360} {:answer/id #uuid "709deace-e72b-54bb-b36d-e6919d9318f2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366361} {:answer/id #uuid "fb1e702e-0eca-5685-a172-661e4405d7